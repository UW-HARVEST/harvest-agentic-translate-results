 == ucp_Lu ||\n4392\t                 chartype == ucp_Ll ||\n4393\t                 chartype == ucp_Lt) == notmatch)\n4394\t              break;\n4395\t            Feptr+= len;\n4396\t            }\n4397\t          break;\n4398\t\n4399\t          case PT_GC:\n4400\t          for (i = Lmin; i < Lmax; i++)\n4401\t            {\n4402\t            int len = 1;\n4403\t            if (Feptr >= mb->end_subject)\n4404\t              {\n4405\t              SCHECK_PARTIAL();\n4406\t              break;\n4407\t              }\n4408\t            GETCHARLENTEST(fc, Feptr, len);\n4409\t            if ((UCD_CATEGORY(fc) == Lpropvalue) == notmatch) break;\n4410\t            Feptr+= len;\n4411\t            }\n4412\t          break;\n4413\t\n4414\t          case PT_PC:\n4415\t          for (i = Lmin; i < Lmax; i++)\n4416\t            {\n4417\t            int len = 1;\n4418\t            if (Feptr >= mb->end_subject)\n4419\t              {\n4420\t              SCHECK_PARTIAL();\n4421\t              break;\n4422\t              }\n4423\t            GETCHARLENTEST(fc, Feptr, len);\n4424\t            if ((UCD_CHARTYPE(fc) == Lpropvalue) == notmatch) break;\n4425\t            Feptr+= len;\n4426\t            }\n4427\t          break;\n4428\t\n4429\t          case PT_SC:\n4430\t          for (i = Lmin; i < Lmax; i++)\n4431\t            {\n4432\t            int len = 1;\n4433\t            if (Feptr >= mb->end_subject)\n4434\t              {\n4435\t              SCHECK_PARTIAL();\n4436\t              break;\n4437\t              }\n4438\t            GETCHARLENTEST(fc, Feptr, len);\n4439\t            if ((UCD_SCRIPT(fc) == Lpropvalue) == notmatch) break;\n4440\t            Feptr+= len;\n4441\t            }\n4442\t          break;\n4443\t\n4444\t          case PT_SCX:\n4445\t          for (i = Lmin; i < Lmax; i++)\n4446\t            {\n4447\t            BOOL ok;\n4448\t            const ucd_record *prop;\n4449\t            int len = 1;\n4450\t            if (Feptr >= mb->end_subject)\n4451\t              {\n4452\t              SCHECK_PARTIAL();\n4453\t              break;\n4454\t              }\n4455\t            GETCHARLENTEST(fc, Feptr, len);\n4456\t            prop = GET_UCD(fc);\n4457\t            ok = (prop->script == Lpropvalue ||\n4458\t                  MAPBIT(PRIV(ucd_script_sets) + UCD_SCRIPTX_PROP(prop), Lpropvalue) != 0);\n4459\t            if (ok == notmatch) break;\n4460\t            Feptr+= len;\n4461\t            }\n4462\t          break;\n4463\t\n4464\t          case PT_ALNUM:\n4465\t          for (i = Lmin; i < Lmax; i++)\n4466\t            {\n4467\t            int category;\n4468\t            int len = 1;\n4469\t            if (Feptr >= mb->end_subject)\n4470\t              {\n4471\t              SCHECK_PARTIAL();\n4472\t              break;\n4473\t              }\n4474\t            GETCHARLENTEST(fc, Feptr, len);\n4475\t            category = UCD_CATEGORY(fc);\n4476\t            if ((category == ucp_L || category == ucp_N) == notmatch)\n4477\t              break;\n4478\t            Feptr+= len;\n4479\t            }\n4480\t          break;\n4481\t\n4482\t          /* Perl space used to exclude VT, but from Perl 5.18 it is included,\n4483\t          which means that Perl space and POSIX space are now identical. PCRE\n4484\t          was changed at release 8.34. */\n4485\t\n4486\t          case PT_SPACE:    /* Perl space */\n4487\t          case PT_PXSPACE:  /* POSIX space */\n4488\t          for (i = Lmin; i < Lmax; i++)\n4489\t            {\n4490\t            int len = 1;\n4491\t            if (Feptr >= mb->end_subject)\n4492\t              {\n4493\t              SCHECK_PARTIAL();\n4494\t              break;\n4495\t              }\n4496\t            GETCHARLENTEST(fc, Feptr, len);\n4497\t            switch(fc)\n4498\t              {\n4499\t              HSPACE_CASES:\n4500\t              VSPACE_CASES:\n4501\t              if (notmatch) goto ENDLOOP99;  /* Break the loop */\n4502\t              break;\n4503\t\n4504\t              default:\n4505\t              if ((UCD_CATEGORY(fc) == ucp_Z) == notmatch)\n4506\t                goto ENDLOOP99;   /* Break the loop */\n4507\t              break;\n4508\t              }\n4509\t            Feptr+= len;\n4510\t            }\n4511\t          ENDLOOP99:\n4512\t          break;\n4513\t\n4514\t          case PT_WORD:\n4515\t          for (i = Lmin; i < Lmax; i++)\n4516\t            {\n4517\t            int chartype, category;\n4518\t            int len = 1;\n4519\t            if (Feptr >= mb->end_subject)\n4520\t              {\n4521\t              SCHECK_PARTIAL();\n4522\t              break;\n4523\t              }\n4524\t            GETCHARLENTEST(fc, Feptr, len);\n4525\t            chartype = UCD_CHARTYPE(fc);\n4526\t            category = PRIV(ucp_gentype)[chartype];\n4527\t            if ((category == ucp_L ||\n4528\t                 category == ucp_N ||\n4529\t                 chartype == ucp_Mn ||\n4530\t                 chartype == ucp_Pc) == notmatch)\n4531\t              break;\n4532\t            Feptr+= len;\n4533\t            }\n4534\t          break;\n4535\t\n4536\t          case PT_CLIST:\n4537\t          for (i = Lmin; i < Lmax; i++)\n4538\t            {\n4539\t            const uint32_t *cp;\n4540\t            int len = 1;\n4541\t            if (Feptr >= mb->end_subject)\n4542\t              {\n4543\t              SCHECK_PARTIAL();\n4544\t              break;\n4545\t              }\n4546\t            GETCHARLENTEST(fc, Feptr, len);\n4547\t#if PCRE2_CODE_UNIT_WIDTH == 32\n4548\t            if (fc > MAX_UTF_CODE_POINT)\n4549\t              {\n4550\t              if (!notmatch) goto GOT_MAX;\n4551\t              }\n4552\t            else\n4553\t#endif\n4554\t              {\n4555\t              cp = PRIV(ucd_caseless_sets) + Lpropvalue;\n4556\t              for (;;)\n4557\t                {\n4558\t                if (fc < *cp)\n4559\t                  { if (notmatch) break; else goto GOT_MAX; }\n4560\t                if (fc == *cp++)\n4561\t                  { if (notmatch) goto GOT_MAX; else break; }\n4562\t                }\n4563\t              }\n4564\t\n4565\t            Feptr += len;\n4566\t            }\n4567\t          GOT_MAX:\n4568\t          break;\n4569\t\n4570\t          case PT_UCNC:\n4571\t          for (i = Lmin; i < Lmax; i++)\n4572\t            {\n4573\t            int len = 1;\n4574\t            if (Feptr >= mb->end_subject)\n4575\t              {\n4576\t              SCHECK_PARTIAL();\n4577\t              break;\n4578\t              }\n4579\t            GETCHARLENTEST(fc, Feptr, len);\n4580\t            if ((fc == CHAR_DOLLAR_SIGN || fc == CHAR_COMMERCIAL_AT ||\n4581\t                 fc == CHAR_GRAVE_ACCENT || (fc >= 0xa0 && fc <= 0xd7ff) ||\n4582\t                 fc >= 0xe000) == notmatch)\n4583\t              break;\n4584\t            Feptr += len;\n4585\t            }\n4586\t          break;\n4587\t\n4588\t          case PT_BIDICL:\n4589\t          for (i = Lmin; i < Lmax; i++)\n4590\t            {\n4591\t            int len = 1;\n4592\t            if (Feptr >= mb->end_subject)\n4593\t              {\n4594\t              SCHECK_PARTIAL();\n4595\t              break;\n4596\t              }\n4597\t            GETCHARLENTEST(fc, Feptr, len);\n4598\t            if ((UCD_BIDICLASS(fc) == Lpropvalue) == notmatch) break;\n4599\t            Feptr+= len;\n4600\t            }\n4601\t          break;\n4602\t\n4603\t          case PT_BOOL:\n4604\t          for (i = Lmin; i < Lmax; i++)\n4605\t            {\n4606\t            BOOL ok;\n4607\t            const ucd_record *prop;\n4608\t            int len = 1;\n4609\t            if (Feptr >= mb->end_subject)\n4610\t              {\n4611\t              SCHECK_PARTIAL();\n4612\t              break;\n4613\t              }\n4614\t            GETCHARLENTEST(fc, Feptr, len);\n4615\t            prop = GET_UCD(fc);\n4616\t            ok = MAPBIT(PRIV(ucd_boolprop_sets) +\n4617\t              UCD_BPROPS_PROP(prop), Lpropvalue) != 0;\n4618\t            if (ok == notmatch) break;\n4619\t            Feptr+= len;\n4620\t            }\n4621\t          break;\n4622\t\n4623\t          /* LCOV_EXCL_START */\n4624\t          default:\n4625\t          PCRE2_DEBUG_UNREACHABLE();\n4626\t          return PCRE2_ERROR_INTERNAL;\n4627\t          /* LCOV_EXCL_STOP */\n4628\t          }\n4629\t\n4630\t        /* Feptr is now past the end of the maximum run */\n4631\t\n4632\t        if (reptype == REPTYPE_POS) continue;    /* No backtracking */\n4633\t\n4634\t        /* After \\C in UTF mode, Lstart_eptr might be in the middle of a\n4635\t        Unicode character. Use <= Lstart_eptr to ensure backtracking doesn't\n4636\t        go too far. */\n4637\t\n4638\t        for(;;)\n4639\t          {\n4640\t          if (Feptr <= Lstart_eptr) break;\n4641\t          RMATCH(Fecode, RM221);\n4642\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4643\t          Feptr--;\n4644\t          if (utf) BACKCHAR(Feptr);\n4645\t          }\n4646\t        }\n4647\t\n4648\t      /* Match extended Unicode grapheme clusters. We will get here only if the\n4649\t      support is in the binary; otherwise a compile-time error occurs. */\n4650\t\n4651\t      else if (Lctype == OP_EXTUNI)\n4652\t        {\n4653\t        for (i = Lmin; i < Lmax; i++)\n4654\t          {\n4655\t          if (Feptr >= mb->end_subject)\n4656\t            {\n4657\t            SCHECK_PARTIAL();\n4658\t            break;\n4659\t            }\n4660\t          else\n4661\t            {\n4662\t            GETCHARINCTEST(fc, Feptr);\n4663\t            Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject, mb->end_subject,\n4664\t              utf, NULL);\n4665\t            }\n4666\t          CHECK_PARTIAL();\n4667\t          }\n4668\t\n4669\t        /* Feptr is now past the end of the maximum run */\n4670\t\n4671\t        if (reptype == REPTYPE_POS) continue;    /* No backtracking */\n4672\t\n4673\t        /* We use <= Lstart_eptr rather than == Lstart_eptr to detect the start\n4674\t        of the run while backtracking because the use of \\C in UTF mode can\n4675\t        cause BACKCHAR to move back past Lstart_eptr. This is just palliative;\n4676\t        the use of \\C in UTF mode is fraught with danger. */\n4677\t\n4678\t        for(;;)\n4679\t          {\n4680\t          int lgb, rgb;\n4681\t          PCRE2_SPTR fptr;\n4682\t\n4683\t          if (Feptr <= Lstart_eptr) break;   /* At start of char run */\n4684\t          RMATCH(Fecode, RM219);\n4685\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4686\t\n4687\t          /* Backtracking over an extended grapheme cluster involves inspecting\n4688\t          the previous two characters (if present) to see if a break is\n4689\t          permitted between them. */\n4690\t\n4691\t          Feptr--;\n4692\t          if (!utf) fc = *Feptr; else\n4693\t            {\n4694\t            BACKCHAR(Feptr);\n4695\t            GETCHAR(fc, Feptr);\n4696\t            }\n4697\t          rgb = UCD_GRAPHBREAK(fc);\n4698\t\n4699\t          for (;;)\n4700\t            {\n4701\t            if (Feptr <= Lstart_eptr) break;   /* At start of char run */\n4702\t            fptr = Feptr - 1;\n4703\t            if (!utf) fc = *fptr; else\n4704\t              {\n4705\t              BACKCHAR(fptr);\n4706\t              GETCHAR(fc, fptr);\n4707\t              }\n4708\t            lgb = UCD_GRAPHBREAK(fc);\n4709\t            if ((PRIV(ucp_gbtable)[lgb] & (1u << rgb)) == 0) break;\n4710\t            Feptr = fptr;\n4711\t            rgb = lgb;\n4712\t            }\n4713\t          }\n4714\t        }\n4715\t\n4716\t      else\n4717\t#endif   /* SUPPORT_UNICODE */\n4718\t\n4719\t#ifdef SUPPORT_UNICODE\n4720\t      if (utf)\n4721\t        {\n4722\t        switch(Lctype)\n4723\t          {\n4724\t          case OP_ANY:\n4725\t          for (i = Lmin; i < Lmax; i++)\n4726\t            {\n4727\t            if (Feptr >= mb->end_subject)\n4728\t              {\n4729\t              SCHECK_PARTIAL();\n4730\t              break;\n4731\t              }\n4732\t            if (IS_NEWLINE(Feptr)) break;\n4733\t            if (mb->partial != 0 &&    /* Take care with CRLF partial */\n4734\t                Feptr + 1 >= mb->end_subject &&\n4735\t                NLBLOCK->nltype == NLTYPE_FIXED &&\n4736\t                NLBLOCK->nllen == 2 &&\n4737\t                *Feptr == NLBLOCK->nl[0])\n4738\t              {\n4739\t              mb->hitend = TRUE;\n4740\t              if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n4741\t              }\n4742\t            Feptr++;\n4743\t            ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++);\n4744\t            }\n4745\t          break;\n4746\t\n4747\t          case OP_ALLANY:\n4748\t          if (Lmax < UINT32_MAX)\n4749\t            {\n4750\t            for (i = Lmin; i < Lmax; i++)\n4751\t              {\n4752\t              if (Feptr >= mb->end_subject)\n4753\t                {\n4754\t                SCHECK_PARTIAL();\n4755\t                break;\n4756\t                }\n4757\t              Feptr++;\n4758\t              ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++);\n4759\t              }\n4760\t            }\n4761\t          else\n4762\t            {\n4763\t            Feptr = mb->end_subject;   /* Unlimited UTF-8 repeat */\n4764\t            SCHECK_PARTIAL();\n4765\t            }\n4766\t          break;\n4767\t\n4768\t          /* The \"byte\" (i.e. \"code unit\") case is the same as non-UTF */\n4769\t\n4770\t          case OP_ANYBYTE:\n4771\t          fc = Lmax - Lmin;\n4772\t          if (fc > (uint32_t)(mb->end_subject - Feptr))\n4773\t            {\n4774\t            Feptr = mb->end_subject;\n4775\t            SCHECK_PARTIAL();\n4776\t            }\n4777\t          else Feptr += fc;\n4778\t          break;\n4779\t\n4780\t          case OP_ANYNL:\n4781\t          for (i = Lmin; i < Lmax; i++)\n4782\t            {\n4783\t            int len = 1;\n4784\t            if (Feptr >= mb->end_subject)\n4785\t              {\n4786\t              SCHECK_PARTIAL();\n4787\t              break;\n4788\t              }\n4789\t            GETCHARLEN(fc, Feptr, len);\n4790\t            if (fc == CHAR_CR)\n4791\t              {\n4792\t              if (++Feptr >= mb->end_subject) break;\n4793\t              if (*Feptr == CHAR_LF) Feptr++;\n4794\t              }\n4795\t            else\n4796\t              {\n4797\t              if (fc != CHAR_LF &&\n4798\t                  (mb->bsr_convention == PCRE2_BSR_ANYCRLF ||\n4799\t                   (fc != CHAR_VT && fc != CHAR_FF && fc != CHAR_NEL\n4800\t#ifndef EBCDIC\n4801\t                    && fc != 0x2028 && fc != 0x2029\n4802\t#endif  /* Not EBCDIC */\n4803\t                    )))\n4804\t                break;\n4805\t              Feptr += len;\n4806\t              }\n4807\t            }\n4808\t          break;\n4809\t\n4810\t          case OP_NOT_HSPACE:\n4811\t          case OP_HSPACE:\n4812\t          for (i = Lmin; i < Lmax; i++)\n4813\t            {\n4814\t            BOOL gotspace;\n4815\t            int len = 1;\n4816\t            if (Feptr >= mb->end_subject)\n4817\t              {\n4818\t              SCHECK_PARTIAL();\n4819\t              break;\n4820\t              }\n4821\t            GETCHARLEN(fc, Feptr, len);\n4822\t            switch(fc)\n4823\t              {\n4824\t              HSPACE_CASES: gotspace = TRUE; break;\n4825\t              default: gotspace = FALSE; break;\n4826\t              }\n4827\t            if (gotspace == (Lctype == OP_NOT_HSPACE)) break;\n4828\t            Feptr += len;\n4829\t            }\n4830\t          break;\n4831\t\n4832\t          case OP_NOT_VSPACE:\n4833\t          case OP_VSPACE:\n4834\t          for (i = Lmin; i < Lmax; i++)\n4835\t            {\n4836\t            BOOL gotspace;\n4837\t            int len = 1;\n4838\t            if (Feptr >= mb->end_subject)\n4839\t              {\n4840\t              SCHECK_PARTIAL();\n4841\t              break;\n4842\t              }\n4843\t            GETCHARLEN(fc, Feptr, len);\n4844\t            switch(fc)\n4845\t              {\n4846\t              VSPACE_CASES: gotspace = TRUE; break;\n4847\t              default: gotspace = FALSE; break;\n4848\t              }\n4849\t            if (gotspace == (Lctype == OP_NOT_VSPACE)) break;\n4850\t            Feptr += len;\n4851\t            }\n4852\t          break;\n4853\t\n4854\t          case OP_NOT_DIGIT:\n4855\t          for (i = Lmin; i < Lmax; i++)\n4856\t            {\n4857\t            int len = 1;\n4858\t            if (Feptr >= mb->end_subject)\n4859\t              {\n4860\t              SCHECK_PARTIAL();\n4861\t              break;\n4862\t              }\n4863\t            GETCHARLEN(fc, Feptr, len);\n4864\t            if (fc < 256 && (mb->ctypes[fc] & ctype_digit) != 0) break;\n4865\t            Feptr+= len;\n4866\t            }\n4867\t          break;\n4868\t\n4869\t          case OP_DIGIT:\n4870\t          for (i = Lmin; i < Lmax; i++)\n4871\t            {\n4872\t            int len = 1;\n4873\t            if (Feptr >= mb->end_subject)\n4874\t              {\n4875\t              SCHECK_PARTIAL();\n4876\t              break;\n4877\t              }\n4878\t            GETCHARLEN(fc, Feptr, len);\n4879\t            if (fc >= 256 ||(mb->ctypes[fc] & ctype_digit) == 0) break;\n4880\t            Feptr+= len;\n4881\t            }\n4882\t          break;\n4883\t\n4884\t          case OP_NOT_WHITESPACE:\n4885\t          for (i = Lmin; i < Lmax; i++)\n4886\t            {\n4887\t            int len = 1;\n4888\t            if (Feptr >= mb->end_subject)\n4889\t              {\n4890\t              SCHECK_PARTIAL();\n4891\t              break;\n4892\t              }\n4893\t            GETCHARLEN(fc, Feptr, len);\n4894\t            if (fc < 256 && (mb->ctypes[fc] & ctype_space) != 0) break;\n4895\t            Feptr+= len;\n4896\t            }\n4897\t          break;\n4898\t\n4899\t          case OP_WHITESPACE:\n4900\t          for (i = Lmin; i < Lmax; i++)\n4901\t            {\n4902\t            int len = 1;\n4903\t            if (Feptr >= mb->end_subject)\n4904\t              {\n4905\t              SCHECK_PARTIAL();\n4906\t              break;\n4907\t              }\n4908\t            GETCHARLEN(fc, Feptr, len);\n4909\t            if (fc >= 256 ||(mb->ctypes[fc] & ctype_space) == 0) break;\n4910\t            Feptr+= len;\n4911\t            }\n4912\t          break;\n4913\t\n4914\t          case OP_NOT_WORDCHAR:\n4915\t          for (i = Lmin; i < Lmax; i++)\n4916\t            {\n4917\t            int len = 1;\n4918\t            if (Feptr >= mb->end_subject)\n4919\t              {\n4920\t              SCHECK_PARTIAL();\n4921\t              break;\n4922\t              }\n4923\t            GETCHARLEN(fc, Feptr, len);\n4924\t            if (fc < 256 && (mb->ctypes[fc] & ctype_word) != 0) break;\n4925\t            Feptr+= len;\n4926\t            }\n4927\t          break;\n4928\t\n4929\t          case OP_WORDCHAR:\n4930\t          for (i = Lmin; i < Lmax; i++)\n4931\t            {\n4932\t            int len = 1;\n4933\t            if (Feptr >= mb->end_subject)\n4934\t              {\n4935\t              SCHECK_PARTIAL();\n4936\t              break;\n4937\t              }\n4938\t            GETCHARLEN(fc, Feptr, len);\n4939\t            if (fc >= 256 || (mb->ctypes[fc] & ctype_word) == 0) break;\n4940\t            Feptr+= len;\n4941\t            }\n4942\t          break;\n4943\t\n4944\t          /* LCOV_EXCL_START */\n4945\t          default:\n4946\t          PCRE2_DEBUG_UNREACHABLE();\n4947\t          return PCRE2_ERROR_INTERNAL;\n4948\t          /* LCOV_EXCL_STOP */\n4949\t          }\n4950\t\n4951\t        if (reptype == REPTYPE_POS) continue;    /* No backtracking */\n4952\t\n4953\t        /* After \\C in UTF mode, Lstart_eptr might be in the middle of a\n4954\t        Unicode character. Use <= Lstart_eptr to ensure backtracking doesn't go\n4955\t        too far. */\n4956\t\n4957\t        for(;;)\n4958\t          {\n4959\t          if (Feptr <= Lstart_eptr) break;\n4960\t          RMATCH(Fecode, RM220);\n4961\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4962\t          Feptr--;\n4963\t          BACKCHAR(Feptr);\n4964\t          if (Lctype == OP_ANYNL && Feptr > Lstart_eptr &&\n4965\t              *Feptr == CHAR_NL && Feptr[-1] == CHAR_CR)\n4966\t            Feptr--;\n4967\t          }\n4968\t        }\n4969\t      else\n4970\t#endif  /* SUPPORT_UNICODE */\n4971\t\n4972\t      /* Not UTF mode */\n4973\t        {\n4974\t        switch(Lctype)\n4975\t          {\n4976\t          case OP_ANY:\n4977\t          for (i = Lmin; i < Lmax; i++)\n4978\t            {\n4979\t            if (Feptr >= mb->end_subject)\n4980\t              {\n4981\t              SCHECK_PARTIAL();\n4982\t              break;\n4983\t              }\n4984\t            if (IS_NEWLINE(Feptr)) break;\n4985\t            if (mb->partial != 0 &&    /* Take care with CRLF partial */\n4986\t                Feptr + 1 >= mb->end_subject &&\n4987\t                NLBLOCK->nltype == NLTYPE_FIXED &&\n4988\t                NLBLOCK->nllen == 2 &&\n4989\t                *Feptr == NLBLOCK->nl[0])\n4990\t              {\n4991\t              mb->hitend = TRUE;\n4992\t              if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n4993\t              }\n4994\t            Feptr++;\n4995\t            }\n4996\t          break;\n4997\t\n4998\t          case OP_ALLANY:\n4999\t          case OP_ANYBYTE:\n5000\t          fc = Lmax - Lmin;\n5001\t          if (fc > (uint32_t)(mb->end_subject - Feptr))\n5002\t            {\n5003\t            Feptr = mb->end_subject;\n5004\t            SCHECK_PARTIAL();\n5005\t            }\n5006\t          else Feptr += fc;\n5007\t          break;\n5008\t\n5009\t          case OP_ANYNL:\n5010\t          for (i = Lmin; i < Lmax; i++)\n5011\t            {\n5012\t            if (Feptr >= mb->end_subject)\n5013\t              {\n5014\t              SCHECK_PARTIAL();\n5015\t              break;\n5016\t              }\n5017\t            fc = *Feptr;\n5018\t            if (fc == CHAR_CR)\n5019\t              {\n5020\t              if (++Feptr >= mb->end_subject) break;\n5021\t              if (*Feptr == CHAR_LF) Feptr++;\n5022\t              }\n5023\t            else\n5024\t              {\n5025\t              if (fc != CHAR_LF && (mb->bsr_convention == PCRE2_BSR_ANYCRLF ||\n5026\t                 (fc != CHAR_VT && fc != CHAR_FF && fc != CHAR_NEL\n5027\t#if PCRE2_CODE_UNIT_WIDTH != 8\n5028\t                 && fc != 0x2028 && fc != 0x2029\n5029\t#endif\n5030\t                 ))) break;\n5031\t              Feptr++;\n5032\t              }\n5033\t            }\n5034\t          break;\n5035\t\n5036\t          case OP_NOT_HSPACE:\n5037\t          for (i = Lmin; i < Lmax; i++)\n5038\t            {\n5039\t            if (Feptr >= mb->end_subject)\n5040\t              {\n5041\t              SCHECK_PARTIAL();\n5042\t              break;\n5043\t              }\n5044\t            switch(*Feptr)\n5045\t              {\n5046\t              default: Feptr++; break;\n5047\t              HSPACE_BYTE_CASES:\n5048\t#if PCRE2_CODE_UNIT_WIDTH != 8\n5049\t              HSPACE_MULTIBYTE_CASES:\n5050\t#endif\n5051\t              goto ENDLOOP00;\n5052\t              }\n5053\t            }\n5054\t          ENDLOOP00:\n5055\t          break;\n5056\t\n5057\t          case OP_HSPACE:\n5058\t          for (i = Lmin; i < Lmax; i++)\n5059\t            {\n5060\t            if (Feptr >= mb->end_subject)\n5061\t              {\n5062\t              SCHECK_PARTIAL();\n5063\t              break;\n5064\t              }\n5065\t            switch(*Feptr)\n5066\t              {\n5067\t              default: goto ENDLOOP01;\n5068\t              HSPACE_BYTE_CASES:\n5069\t#if PCRE2_CODE_UNIT_WIDTH != 8\n5070\t              HSPACE_MULTIBYTE_CASES:\n5071\t#endif\n5072\t              Feptr++; break;\n5073\t              }\n5074\t            }\n5075\t          ENDLOOP01:\n5076\t          break;\n5077\t\n5078\t          case OP_NOT_VSPACE:\n5079\t          for (i = Lmin; i < Lmax; i++)\n5080\t            {\n5081\t            if (Feptr >= mb->end_subject)\n5082\t              {\n5083\t              SCHECK_PARTIAL();\n5084\t              break;\n5085\t              }\n5086\t            switch(*Feptr)\n5087\t              {\n5088\t              default: Feptr++; break;\n5089\t              VSPACE_BYTE_CASES:\n5090\t#if PCRE2_CODE_UNIT_WIDTH != 8\n5091\t              VSPACE_MULTIBYTE_CASES:\n5092\t#endif\n5093\t              goto ENDLOOP02;\n5094\t              }\n5095\t            }\n5096\t          ENDLOOP02:\n5097\t          break;\n5098\t\n5099\t          case OP_VSPACE:\n5100\t          for (i = Lmin; i < Lmax; i++)\n5101\t            {\n5102\t            if (Feptr >= mb->end_subject)\n5103\t              {\n5104\t              SCHECK_PARTIAL();\n5105\t              break;\n5106\t              }\n5107\t            switch(*Feptr)\n5108\t              {\n5109\t              default: goto ENDLOOP03;\n5110\t              VSPACE_BYTE_CASES:\n5111\t#if PCRE2_CODE_UNIT_WIDTH != 8\n5112\t              VSPACE_MULTIBYTE_CASES:\n5113\t#endif\n5114\t              Feptr++; break;\n5115\t              }\n5116\t            }\n5117\t          ENDLOOP03:\n5118\t          break;\n5119\t\n5120\t          case OP_NOT_DIGIT:\n5121\t          for (i = Lmin; i < Lmax; i++)\n5122\t            {\n5123\t            if (Feptr >= mb->end_subject)\n5124\t              {\n5125\t              SCHECK_PARTIAL();\n5126\t              break;\n5127\t              }\n5128\t            if (MAX_255(*Feptr) && (mb->ctypes[*Feptr] & ctype_digit) != 0)\n5129\t              break;\n5130\t            Feptr++;\n5131\t            }\n5132\t          break;\n5133\t\n5134\t          case OP_DIGIT:\n5135\t          for (i = Lmin; i < Lmax; i++)\n5136\t            {\n5137\t            if (Feptr >= mb->end_subject)\n5138\t              {\n5139\t              SCHECK_PARTIAL();\n5140\t              break;\n5141\t              }\n5142\t            if (!MAX_255(*Feptr) || (mb->ctypes[*Feptr] & ctype_digit) == 0)\n5143\t              break;\n5144\t            Feptr++;\n5145\t            }\n5146\t          break;\n5147\t\n5148\t          case OP_NOT_WHITESPACE:\n5149\t          for (i = Lmin; i < Lmax; i++)\n5150\t            {\n5151\t            if (Feptr >= mb->end_subject)\n5152\t              {\n5153\t              SCHECK_PARTIAL();\n5154\t              break;\n5155\t              }\n5156\t            if (MAX_255(*Feptr) && (mb->ctypes[*Feptr] & ctype_space) != 0)\n5157\t              break;\n5158\t            Feptr++;\n5159\t            }\n5160\t          break;\n5161\t\n5162\t          case OP_WHITESPACE:\n5163\t          for (i = Lmin; i < Lmax; i++)\n5164\t            {\n5165\t            if (Feptr >= mb->end_subject)\n5166\t              {\n5167\t              SCHECK_PARTIAL();\n5168\t              break;\n5169\t              }\n5170\t            if (!MAX_255(*Feptr) || (mb->ctypes[*Feptr] & ctype_space) == 0)\n5171\t              break;\n5172\t            Feptr++;\n5173\t            }\n5174\t          break;\n5175\t\n5176\t          case OP_NOT_WORDCHAR:\n5177\t          for (i = Lmin; i < Lmax; i++)\n5178\t            {\n5179\t            if (Feptr >= mb->end_subject)\n5180\t              {\n5181\t              SCHECK_PARTIAL();\n5182\t              break;\n5183\t              }\n5184\t            if (MAX_255(*Feptr) && (mb->ctypes[*Feptr] & ctype_word) != 0)\n5185\t              break;\n5186\t            Feptr++;\n5187\t            }\n5188\t          break;\n5189\t\n5190\t          case OP_WORDCHAR:\n5191\t          for (i = Lmin; i < Lmax; i++)\n5192\t            {\n5193\t            if (Feptr >= mb->end_subject)\n5194\t              {\n5195\t              SCHECK_PARTIAL();\n5196\t              break;\n5197\t              }\n5198\t            if (!MAX_255(*Feptr) || (mb->ctypes[*Feptr] & ctype_word) == 0)\n5199\t              break;\n5200\t            Feptr++;\n5201\t            }\n5202\t          break;\n5203\t\n5204\t          /* LCOV_EXCL_START */\n5205\t          default:\n5206\t          PCRE2_DEBUG_UNREACHABLE();\n5207\t          return PCRE2_ERROR_INTERNAL;\n5208\t          /* LCOV_EXCL_STOP */\n5209\t          }\n5210\t\n5211\t        if (reptype == REPTYPE_POS) continue;    /* No backtracking */\n5212\t\n5213\t        for (;;)\n5214\t          {\n5215\t          if (Feptr == Lstart_eptr) break;\n5216\t          RMATCH(Fecode, RM34);\n5217\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5218\t          Feptr--;\n5219\t          if (Lctype == OP_ANYNL && Feptr > Lstart_eptr && *Feptr == CHAR_LF &&\n5220\t              Feptr[-1] == CHAR_CR) Feptr--;\n5221\t          }\n5222\t        }\n5223\t      }\n5224\t    break;  /* End of repeat character type processing */\n5225\t\n5226\t#undef Lstart_eptr\n5227\t#undef Lmin\n5228\t#undef Lmax\n5229\t#undef Lctype\n5230\t#undef Lpropvalue\n5231\t\n5232\t\n5233\t    /* ===================================================================== */\n5234\t    /* Match a back reference, possibly repeatedly. Look past the end of the\n5235\t    item to see if there is repeat information following. The OP_REF and\n5236\t    OP_REFI opcodes are used for a reference to a numbered group or to a\n5237\t    non-duplicated named group. For a duplicated named group, OP_DNREF and\n5238\t    OP_DNREFI are used. In this case we must scan the list of groups to which\n5239\t    the name refers, and use the first one that is set. */\n5240\t\n5241\t#define Lstart    F->fields.ref_repeat.start\n5242\t#define Loffset   F->fields.ref_repeat.offset\n5243\t#define Llength   F->fields.ref_repeat.length\n5244\t#define Lmin      F->fields.ref_repeat.min\n5245\t#define Lmax      F->fields.ref_repeat.max\n5246\t#define Lcaseless F->byte1\n5247\t#define Lcaseopts F->byte2\n5248\t\n5249\t    case OP_DNREF:\n5250\t    case OP_DNREFI:\n5251\t    Lcaseless = (uint8_t)(Fop == OP_DNREFI);\n5252\t    Lcaseopts = (uint8_t)((Fop == OP_DNREFI)? Fecode[1 + 2*IMM2_SIZE] : 0);\n5253\t      {\n5254\t      int count = GET2(Fecode, 1+IMM2_SIZE);\n5255\t      PCRE2_SPTR slot = mb->name_table + GET2(Fecode, 1) * mb->name_entry_size;\n5256\t      Fecode += 1 + 2*IMM2_SIZE + (Fop == OP_DNREFI? 1 : 0);\n5257\t\n5258\t      while (count-- > 0)\n5259\t        {\n5260\t        Loffset = (GET2(slot, 0) << 1) - 2;\n5261\t        if (Loffset < Foffset_top && Fovector[Loffset] != PCRE2_UNSET) break;\n5262\t        slot += mb->name_entry_size;\n5263\t        }\n5264\t      }\n5265\t    goto REF_REPEAT;\n5266\t\n5267\t    case OP_REF:\n5268\t    case OP_REFI:\n5269\t    Lcaseless = (Fop == OP_REFI);\n5270\t    Lcaseopts = (Fop == OP_REFI)? Fecode[1 + IMM2_SIZE] : 0;\n5271\t    Loffset = (GET2(Fecode, 1) << 1) - 2;\n5272\t    Fecode += 1 + IMM2_SIZE + (Fop == OP_REFI? 1 : 0);\n5273\t\n5274\t    /* Set up for repetition, or handle the non-repeated case. The maximum and\n5275\t    minimum must be in the heap frame, but as they are short-term values, we\n5276\t    use temporary fields. */\n5277\t\n5278\t    REF_REPEAT:\n5279\t    switch (*Fecode)\n5280\t      {\n5281\t      case OP_CRSTAR:\n5282\t      case OP_CRMINSTAR:\n5283\t      case OP_CRPLUS:\n5284\t      case OP_CRMINPLUS:\n5285\t      case OP_CRQUERY:\n5286\t      case OP_CRMINQUERY:\n5287\t      case OP_CRPOSSTAR:\n5288\t      case OP_CRPOSPLUS:\n5289\t      case OP_CRPOSQUERY:\n5290\t      fc = *Fecode++ - OP_CRSTAR;\n5291\t      Lmin = rep_min[fc];\n5292\t      Lmax = rep_max[fc];\n5293\t      reptype = rep_typ[fc];\n5294\t      break;\n5295\t\n5296\t      case OP_CRRANGE:\n5297\t      case OP_CRMINRANGE:\n5298\t      case OP_CRPOSRANGE:\n5299\t      Lmin = GET2(Fecode, 1);\n5300\t      Lmax = GET2(Fecode, 1 + IMM2_SIZE);\n5301\t      reptype = rep_typ[*Fecode - OP_CRSTAR];\n5302\t      if (Lmax == 0) Lmax = UINT32_MAX;  /* Max 0 => infinity */\n5303\t      Fecode += 1 + 2 * IMM2_SIZE;\n5304\t      break;\n5305\t\n5306\t      default:                  /* No repeat follows */\n5307\t        {\n5308\t        rrc = match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &length);\n5309\t        if (rrc != 0)\n5310\t          {\n5311\t          if (rrc > 0) Feptr = mb->end_subject;   /* Partial match */\n5312\t          CHECK_PARTIAL();\n5313\t          RRETURN(MATCH_NOMATCH);\n5314\t          }\n5315\t        }\n5316\t      Feptr += length;\n5317\t      continue;              /* With the main loop */\n5318\t      }\n5319\t\n5320\t    /* Handle repeated back references. If a set group has length zero, just\n5321\t    continue with the main loop, because it matches however many times. For an\n5322\t    unset reference, if the minimum is zero, we can also just continue. We can\n5323\t    also continue if PCRE2_MATCH_UNSET_BACKREF is set, because this makes unset\n5324\t    group behave as a zero-length group. For any other unset cases, carrying\n5325\t    on will result in NOMATCH. */\n5326\t\n5327\t    if (Loffset < Foffset_top && Fovector[Loffset] != PCRE2_UNSET)\n5328\t      {\n5329\t      if (Fovector[Loffset] == Fovector[Loffset + 1]) continue;\n5330\t      }\n5331\t    else  /* Group is not set */\n5332\t      {\n5333\t      if (Lmin == 0 || (mb->poptions & PCRE2_MATCH_UNSET_BACKREF) != 0)\n5334\t        continue;\n5335\t      }\n5336\t\n5337\t    /* First, ensure the minimum number of matches are present. */\n5338\t\n5339\t    for (i = 1; i <= Lmin; i++)\n5340\t      {\n5341\t      PCRE2_SIZE slength;\n5342\t      rrc = match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5343\t      if (rrc != 0)\n5344\t        {\n5345\t        if (rrc > 0) Feptr = mb->end_subject;   /* Partial match */\n5346\t        CHECK_PARTIAL();\n5347\t        RRETURN(MATCH_NOMATCH);\n5348\t        }\n5349\t      Feptr += slength;\n5350\t      }\n5351\t\n5352\t    /* If min = max, we are done. They are not both allowed to be zero. */\n5353\t\n5354\t    if (Lmin == Lmax) continue;\n5355\t\n5356\t    /* If minimizing, keep trying and advancing the pointer. */\n5357\t\n5358\t    if (reptype == REPTYPE_MIN)\n5359\t      {\n5360\t      for (;;)\n5361\t        {\n5362\t        PCRE2_SIZE slength;\n5363\t        RMATCH(Fecode, RM20);\n5364\t        if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5365\t        if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n5366\t        rrc = match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5367\t        if (rrc != 0)\n5368\t          {\n5369\t          if (rrc > 0) Feptr = mb->end_subject;   /* Partial match */\n5370\t          CHECK_PARTIAL();\n5371\t          RRETURN(MATCH_NOMATCH);\n5372\t          }\n5373\t        Feptr += slength;\n5374\t        }\n5375\t\n5376\t      PCRE2_UNREACHABLE(); /* Control never reaches here */\n5377\t      }\n5378\t\n5379\t    /* If maximizing, find the longest string and work backwards, as long as\n5380\t    the matched lengths for each iteration are the same. */\n5381\t\n5382\t    else\n5383\t      {\n5384\t      BOOL samelengths = TRUE;\n5385\t      Lstart = Feptr;     /* Starting position */\n5386\t      Llength = Fovector[Loffset+1] - Fovector[Loffset];\n5387\t\n5388\t      for (i = Lmin; i < Lmax; i++)\n5389\t        {\n5390\t        PCRE2_SIZE slength;\n5391\t        rrc = match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5392\t        if (rrc != 0)\n5393\t          {\n5394\t          /* Can't use CHECK_PARTIAL because we don't want to update Feptr in\n5395\t          the soft partial matching case. */\n5396\t\n5397\t          if (rrc > 0 && mb->partial != 0 &&\n5398\t              mb->end_subject > mb->start_used_ptr)\n5399\t            {\n5400\t            mb->hitend = TRUE;\n5401\t            if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n5402\t            }\n5403\t          break;\n5404\t          }\n5405\t\n5406\t        if (slength != Llength) samelengths = FALSE;\n5407\t        Feptr += slength;\n5408\t        }\n5409\t\n5410\t      /* No recursion if the repeat type is possessive. */\n5411\t      if (reptype == REPTYPE_POS) break;\n5412\t\n5413\t      /* If the length matched for each repetition is the same as the length of\n5414\t      the captured group, we can easily work backwards. This is the normal\n5415\t      case. However, in caseless UTF-8 mode there are pairs of case-equivalent\n5416\t      characters whose lengths (in terms of code units) differ. However, this\n5417\t      is very rare, so we handle it by re-matching fewer and fewer times. */\n5418\t\n5419\t      if (samelengths)\n5420\t        {\n5421\t        while (Feptr >= Lstart)\n5422\t          {\n5423\t          RMATCH(Fecode, RM21);\n5424\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5425\t          Feptr -= Llength;\n5426\t          }\n5427\t        }\n5428\t\n5429\t      /* The rare case of non-matching lengths. Re-scan the repetition for each\n5430\t      iteration. We know that match_ref() will succeed every time. */\n5431\t\n5432\t      else\n5433\t        {\n5434\t        Lmax = i;\n5435\t        for (;;)\n5436\t          {\n5437\t          RMATCH(Fecode, RM22);\n5438\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5439\t          if (Feptr == Lstart) break; /* Failed after minimal repetition */\n5440\t          Feptr = Lstart;\n5441\t          Lmax--;\n5442\t          for (i = Lmin; i < Lmax; i++)\n5443\t            {\n5444\t            PCRE2_SIZE slength;\n5445\t            (void)match_ref(Loffset, Lcaseless, Lcaseopts, F, mb, &slength);\n5446\t            Feptr += slength;\n5447\t            }\n5448\t          }\n5449\t        }\n5450\t\n5451\t      RRETURN(MATCH_NOMATCH);\n5452\t      }\n5453\t\n5454\t    PCRE2_DEBUG_UNREACHABLE(); /* Control should never reach here */\n5455\t\n5456\t#undef Lstart\n5457\t#undef Loffset\n5458\t#undef Llength\n5459\t#undef Lmin\n5460\t#undef Lmax\n5461\t#undef Lcaseless\n5462\t#undef Lcaseopts\n5463\t\n5464\t\n5465\t/* ========================================================================= */\n5466\t/*           Opcodes for the start of various parenthesized items            */\n5467\t/* ========================================================================= */\n5468\t\n5469\t    /* In all cases, if the result of RMATCH() is MATCH_THEN, check whether the\n5470\t    (*THEN) is within the current branch by comparing the address of OP_THEN\n5471\t    that is passed back with the end of the branch. If (*THEN) is within the\n5472\t    current branch, and the branch is one of two or more alternatives (it\n5473\t    either starts or ends with OP_ALT), we have reached the limit of THEN's\n5474\t    action, so convert the return code to NOMATCH, which will cause normal\n5475\t    backtracking to happen from now on. Otherwise, THEN is passed back to an\n5476\t    outer alternative. This implements Perl's treatment of parenthesized\n5477\t    groups, where a group not containing | does not affect the current\n5478\t    alternative, that is, (X) is NOT the same as (X|(*F)). */\n5479\t\n5480\t\n5481\t    /* ===================================================================== */\n5482\t    /* BRAZERO, BRAMINZERO and SKIPZERO occur just before a non-possessive\n5483\t    bracket group, indicating that it may occur zero times. It may repeat\n5484\t    infinitely, or not at all - i.e. it could be ()* or ()? or even (){0} in\n5485\t    the pattern. Brackets with fixed upper repeat limits are compiled as a\n5486\t    number of copies, with the optional ones preceded by BRAZERO or BRAMINZERO.\n5487\t    Possessive groups with possible zero repeats are preceded by BRAPOSZERO. */\n5488\t\n5489\t    case OP_BRAZERO:\n5490\t      {\n5491\t      PCRE2_SPTR next_ecode;\n5492\t\n5493\t      Fecode++;\n5494\t      RMATCH(Fecode, RM9);\n5495\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5496\t      next_ecode = Fecode;\n5497\t      do next_ecode += GET(next_ecode, 1); while (*next_ecode == OP_ALT);\n5498\t      Fecode = next_ecode + 1 + LINK_SIZE;\n5499\t      }\n5500\t    break;\n5501\t\n5502\t    case OP_BRAMINZERO:\n5503\t      {\n5504\t      PCRE2_SPTR next_ecode;\n5505\t\n5506\t      Fecode++;\n5507\t      next_ecode = Fecode;\n5508\t      do next_ecode += GET(next_ecode, 1); while (*next_ecode == OP_ALT);\n5509\t      RMATCH(next_ecode + 1 + LINK_SIZE, RM10);\n5510\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5511\t      }\n5512\t    break;\n5513\t\n5514\t    case OP_SKIPZERO:\n5515\t      {\n5516\t      PCRE2_SPTR next_ecode = Fecode + 1;\n5517\t      do next_ecode += GET(next_ecode, 1); while (*next_ecode == OP_ALT);\n5518\t      Fecode = next_ecode + 1 + LINK_SIZE;\n5519\t      }\n5520\t    break;\n5521\t\n5522\t\n5523\t    /* ===================================================================== */\n5524\t    /* Handle possessive brackets with an unlimited repeat. The end of these\n5525\t    brackets will always be OP_KETRPOS, which returns MATCH_KETRPOS without\n5526\t    going further in the pattern. */\n5527\t\n5528\t#define Lstart_eptr    F->fields.op_brapos.start_eptr\n5529\t#define Lstart_group   F->fields.op_brapos.start_group\n5530\t#define Lframe_type    F->fields.op_brapos.frame_type\n5531\t#define Lmatched_once  F->byte1\n5532\t#define Lzero_allowed  F->byte2\n5533\t\n5534\t    case OP_BRAPOSZERO:\n5535\t    Lzero_allowed = TRUE;                /* Zero repeat is allowed */\n5536\t    Fecode += 1;\n5537\t    if (*Fecode == OP_CBRAPOS || *Fecode == OP_SCBRAPOS)\n5538\t      goto POSSESSIVE_CAPTURE;\n5539\t    goto POSSESSIVE_NON_CAPTURE;\n5540\t\n5541\t    case OP_BRAPOS:\n5542\t    case OP_SBRAPOS:\n5543\t    Lzero_allowed = FALSE;               /* Zero repeat not allowed */\n5544\t\n5545\t    POSSESSIVE_NON_CAPTURE:\n5546\t    Lframe_type = GF_NOCAPTURE;          /* Remembered frame type */\n5547\t    goto POSSESSIVE_GROUP;\n5548\t\n5549\t    case OP_CBRAPOS:\n5550\t    case OP_SCBRAPOS:\n5551\t    Lzero_allowed = FALSE;               /* Zero repeat not allowed */\n5552\t\n5553\t    POSSESSIVE_CAPTURE:\n5554\t    number = GET2(Fecode, 1+LINK_SIZE);\n5555\t    Lframe_type = GF_CAPTURE | number;   /* Remembered frame type */\n5556\t\n5557\t    POSSESSIVE_GROUP:\n5558\t    Lmatched_once = FALSE;               /* Never matched */\n5559\t    Lstart_group = Fecode;               /* Start of this group */\n5560\t\n5561\t    for (;;)\n5562\t      {\n5563\t      Lstart_eptr = Feptr;               /* Position at group start */\n5564\t      group_frame_type = Lframe_type;\n5565\t      RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM8);\n5566\t      if (rrc == MATCH_KETRPOS)\n5567\t        {\n5568\t        Lmatched_once = TRUE;            /* Matched at least once */\n5569\t        if (Feptr == Lstart_eptr)        /* Empty match; skip to end */\n5570\t          {\n5571\t          do Fecode += GET(Fecode, 1); while (*Fecode == OP_ALT);\n5572\t          break;\n5573\t          }\n5574\t\n5575\t        Fecode = Lstart_group;\n5576\t        continue;\n5577\t        }\n5578\t\n5579\t      /* See comment above about handling THEN. */\n5580\t\n5581\t      if (rrc == MATCH_THEN)\n5582\t        {\n5583\t        PCRE2_SPTR next_ecode = Fecode + GET(Fecode,1);\n5584\t        if (mb->verb_ecode_ptr < next_ecode &&\n5585\t            (*Fecode == OP_ALT || *next_ecode == OP_ALT))\n5586\t          rrc = MATCH_NOMATCH;\n5587\t        }\n5588\t\n5589\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5590\t      Fecode += GET(Fecode, 1);\n5591\t      if (*Fecode != OP_ALT) break;\n5592\t      }\n5593\t\n5594\t    /* Success if matched something or zero repeat allowed */\n5595\t\n5596\t    if (Lmatched_once || Lzero_allowed)\n5597\t      {\n5598\t      Fecode += 1 + LINK_SIZE;\n5599\t      break;\n5600\t      }\n5601\t\n5602\t    RRETURN(MATCH_NOMATCH);\n5603\t\n5604\t#undef Lstart_eptr\n5605\t#undef Lstart_group\n5606\t#undef Lframe_type\n5607\t#undef Lmatched_once\n5608\t#undef Lzero_allowed\n5609\t\n5610\t\n5611\t    /* ===================================================================== */\n5612\t    /* Handle non-capturing brackets that cannot match an empty string. When we\n5613\t    get to the final alternative within the brackets, as long as there are no\n5614\t    THEN's in the pattern, we can optimize by not recording a new backtracking\n5615\t    point. (Ideally we should test for a THEN within this group, but we don't\n5616\t    have that information.) Don't do this if we are at the very top level,\n5617\t    however, because that would make handling assertions and once-only brackets\n5618\t    messier when there is nothing to go back to. */\n5619\t\n5620\t#define Lframe_type    F->fields.op_bra.frame_type\n5621\t\n5622\t    case OP_BRA:\n5623\t    if (mb->hasthen || Frdepth == 0)\n5624\t      {\n5625\t      Lframe_type = 0;\n5626\t      goto GROUPLOOP;\n5627\t      }\n5628\t\n5629\t    for (;;)\n5630\t      {\n5631\t      PCRE2_SPTR current_branch = Fecode;\n5632\t      PCRE2_SPTR next_branch = current_branch + GET(current_branch, 1);\n5633\t\n5634\t      if (*next_branch != OP_ALT) break;\n5635\t\n5636\t      /* This is never the final branch. We do not need to test for MATCH_THEN\n5637\t      here because this code is not used when there is a THEN in the pattern. */\n5638\t\n5639\t      Fecode = next_branch;\n5640\t      PCRE2_ASSERT((*current_branch == OP_BRA || *current_branch == OP_ALT) &&\n5641\t                   PRIV(OP_lengths)[OP_BRA] == 1 + LINK_SIZE &&\n5642\t                   PRIV(OP_lengths)[OP_ALT] == 1 + LINK_SIZE);\n5643\t\n5644\t      RMATCH(current_branch + 1 + LINK_SIZE, RM1);\n5645\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5646\t      }\n5647\t\n5648\t    /* Hit the start of the final branch. Continue at this level. */\n5649\t\n5650\t    PCRE2_ASSERT((*Fecode == OP_BRA || *Fecode == OP_ALT) &&\n5651\t                 PRIV(OP_lengths)[OP_BRA] == 1 + LINK_SIZE &&\n5652\t                 PRIV(OP_lengths)[OP_ALT] == 1 + LINK_SIZE);\n5653\t    Fecode += 1 + LINK_SIZE;\n5654\t    break;\n5655\t\n5656\t\n5657\t    /* ===================================================================== */\n5658\t    /* Handle a capturing bracket, other than those that are possessive with an\n5659\t    unlimited repeat. */\n5660\t\n5661\t    case OP_CBRA:\n5662\t    case OP_SCBRA:\n5663\t    Lframe_type = GF_CAPTURE | GET2(Fecode, 1+LINK_SIZE);\n5664\t    goto GROUPLOOP;\n5665\t\n5666\t\n5667\t    /* ===================================================================== */\n5668\t    /* Atomic groups and non-capturing brackets that can match an empty string\n5669\t    must record a backtracking point and also set up a chained frame. */\n5670\t\n5671\t    case OP_ONCE:\n5672\t    case OP_SCRIPT_RUN:\n5673\t    case OP_SBRA:\n5674\t    Lframe_type = GF_NOCAPTURE;\n5675\t\n5676\t    GROUPLOOP:\n5677\t    for (;;)\n5678\t      {\n5679\t      group_frame_type = Lframe_type;\n5680\t      RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM2);\n5681\t      if (rrc == MATCH_THEN)\n5682\t        {\n5683\t        PCRE2_SPTR next_ecode = Fecode + GET(Fecode,1);\n5684\t        if (mb->verb_ecode_ptr < next_ecode &&\n5685\t            (*Fecode == OP_ALT || *next_ecode == OP_ALT))\n5686\t          rrc = MATCH_NOMATCH;\n5687\t        }\n5688\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n5689\t      Fecode += GET(Fecode, 1);\n5690\t      if (*Fecode != OP_ALT) RRETURN(MATCH_NOMATCH);\n5691\t      }\n5692\t    PCRE2_UNREACHABLE(); /* Control never reaches here */\n5693\t\n5694\t#undef Lframe_type\n5695\t\n5696\t\n5697\t    /* ===================================================================== */\n5698\t    /* Pattern recursion either matches the current regex, or some\n5699\t    subexpression. The offset data is the offset to the starting bracket from\n5700\t    the start of the whole pattern. This is so that it works from duplicated\n5701\t    subpatterns. For a whole-pattern recursion, we have to infer the number\n5702\t    zero. */\n5703\t\n5704\t#define Lstart_branch  F->fields.op_recurse.start_branch\n5705\t#define Lframe_type    F->fields.op_recurse.frame_type\n5706\t\n5707\t    case OP_RECURSE:\n5708\t    bracode = mb->start_code + GET(Fecode, 1);\n5709\t    number = (bracode == mb->start_code)? 0 : GET2(bracode, 1 + LINK_SIZE);\n5710\t\n5711\t    /* If we are already in a pattern recursion, check for repeating the same\n5712\t    one without changing the subject pointer or the last referenced character\n5713\t    in the subject. This should catch convoluted mutual recursions; some\n5714\t    simple cases are caught at compile time. However, there are rare cases when\n5715\t    this check needs to be turned off. In this case, actual recursion loops\n5716\t    will be caught by the match or heap limits. */\n5717\t\n5718\t    if (Fcurrent_recurse != RECURSE_UNSET)\n5719\t      {\n5720\t      offset = Flast_group_offset;\n5721\t      while (offset != PCRE2_UNSET)\n5722\t        {\n5723\t        N = (heapframe *)((char *)match_data->heapframes + offset);\n5724\t        P = (heapframe *)((char *)N - frame_size);\n5725\t        if (N->group_frame_type == (GF_RECURSE | number))\n5726\t          {\n5727\t          if (Feptr == P->eptr && mb->last_used_ptr == P->recurse_last_used &&\n5728\t               (mb->moptions & PCRE2_DISABLE_RECURSELOOP_CHECK) == 0)\n5729\t            return PCRE2_ERROR_RECURSELOOP;\n5730\t          break;\n5731\t          }\n5732\t        offset = P->last_group_offset;\n5733\t        }\n5734\t      }\n5735\t\n5736\t    /* Remember the current last referenced character and then run the\n5737\t    recursion branch by branch. */\n5738\t\n5739\t    F->recurse_last_used = mb->last_used_ptr;\n5740\t    Lstart_branch = bracode;\n5741\t    Lframe_type = GF_RECURSE | number;\n5742\t\n5743\t    for (;;)\n5744\t      {\n5745\t      PCRE2_SPTR next_ecode;\n5746\t\n5747\t      group_frame_type = Lframe_type;\n5748\t      RMATCH(Lstart_branch + PRIV(OP_lengths)[*Lstart_branch], RM11);\n5749\t      next_ecode = Lstart_branch + GET(Lstart_branch,1);\n5750\t\n5751\t      /* Handle backtracking verbs, which are defined in a range that can\n5752\t      easily be tested for. PCRE does not allow THEN, SKIP, PRUNE or