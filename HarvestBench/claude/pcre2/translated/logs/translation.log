f  /* SUPPORT_WIDE_CHARS: end of ECLASS */\n2561\t\n2562\t#undef Lstart_eptr\n2563\t#undef Leclass_data\n2564\t#undef Leclass_len\n2565\t#undef Lmin\n2566\t#undef Lmax\n2567\t\n2568\t\n2569\t    /* ===================================================================== */\n2570\t    /* Match various character types when PCRE2_UCP is not set. These opcodes\n2571\t    are not generated when PCRE2_UCP is set - instead appropriate property\n2572\t    tests are compiled. */\n2573\t\n2574\t    case OP_NOT_DIGIT:\n2575\t    if (Feptr >= mb->end_subject)\n2576\t      {\n2577\t      SCHECK_PARTIAL();\n2578\t      RRETURN(MATCH_NOMATCH);\n2579\t      }\n2580\t    GETCHARINCTEST(fc, Feptr);\n2581\t    if (CHMAX_255(fc) && (mb->ctypes[fc] & ctype_digit) != 0)\n2582\t      RRETURN(MATCH_NOMATCH);\n2583\t    Fecode++;\n2584\t    break;\n2585\t\n2586\t    case OP_DIGIT:\n2587\t    if (Feptr >= mb->end_subject)\n2588\t      {\n2589\t      SCHECK_PARTIAL();\n2590\t      RRETURN(MATCH_NOMATCH);\n2591\t      }\n2592\t    GETCHARINCTEST(fc, Feptr);\n2593\t    if (!CHMAX_255(fc) || (mb->ctypes[fc] & ctype_digit) == 0)\n2594\t      RRETURN(MATCH_NOMATCH);\n2595\t    Fecode++;\n2596\t    break;\n2597\t\n2598\t    case OP_NOT_WHITESPACE:\n2599\t    if (Feptr >= mb->end_subject)\n2600\t      {\n2601\t      SCHECK_PARTIAL();\n2602\t      RRETURN(MATCH_NOMATCH);\n2603\t      }\n2604\t    GETCHARINCTEST(fc, Feptr);\n2605\t    if (CHMAX_255(fc) && (mb->ctypes[fc] & ctype_space) != 0)\n2606\t      RRETURN(MATCH_NOMATCH);\n2607\t    Fecode++;\n2608\t    break;\n2609\t\n2610\t    case OP_WHITESPACE:\n2611\t    if (Feptr >= mb->end_subject)\n2612\t      {\n2613\t      SCHECK_PARTIAL();\n2614\t      RRETURN(MATCH_NOMATCH);\n2615\t      }\n2616\t    GETCHARINCTEST(fc, Feptr);\n2617\t    if (!CHMAX_255(fc) || (mb->ctypes[fc] & ctype_space) == 0)\n2618\t      RRETURN(MATCH_NOMATCH);\n2619\t    Fecode++;\n2620\t    break;\n2621\t\n2622\t    case OP_NOT_WORDCHAR:\n2623\t    if (Feptr >= mb->end_subject)\n2624\t      {\n2625\t      SCHECK_PARTIAL();\n2626\t      RRETURN(MATCH_NOMATCH);\n2627\t      }\n2628\t    GETCHARINCTEST(fc, Feptr);\n2629\t    if (CHMAX_255(fc) && (mb->ctypes[fc] & ctype_word) != 0)\n2630\t      RRETURN(MATCH_NOMATCH);\n2631\t    Fecode++;\n2632\t    break;\n2633\t\n2634\t    case OP_WORDCHAR:\n2635\t    if (Feptr >= mb->end_subject)\n2636\t      {\n2637\t      SCHECK_PARTIAL();\n2638\t      RRETURN(MATCH_NOMATCH);\n2639\t      }\n2640\t    GETCHARINCTEST(fc, Feptr);\n2641\t    if (!CHMAX_255(fc) || (mb->ctypes[fc] & ctype_word) == 0)\n2642\t      RRETURN(MATCH_NOMATCH);\n2643\t    Fecode++;\n2644\t    break;\n2645\t\n2646\t    case OP_ANYNL:\n2647\t    if (Feptr >= mb->end_subject)\n2648\t      {\n2649\t      SCHECK_PARTIAL();\n2650\t      RRETURN(MATCH_NOMATCH);\n2651\t      }\n2652\t    GETCHARINCTEST(fc, Feptr);\n2653\t    switch(fc)\n2654\t      {\n2655\t      default: RRETURN(MATCH_NOMATCH);\n2656\t\n2657\t      case CHAR_CR:\n2658\t      if (Feptr >= mb->end_subject)\n2659\t        {\n2660\t        SCHECK_PARTIAL();\n2661\t        }\n2662\t      else if (*Feptr == CHAR_LF) Feptr++;\n2663\t      break;\n2664\t\n2665\t      case CHAR_LF:\n2666\t      break;\n2667\t\n2668\t      case CHAR_VT:\n2669\t      case CHAR_FF:\n2670\t      case CHAR_NEL:\n2671\t#ifndef EBCDIC\n2672\t      case 0x2028:\n2673\t      case 0x2029:\n2674\t#endif  /* Not EBCDIC */\n2675\t      if (mb->bsr_convention == PCRE2_BSR_ANYCRLF) RRETURN(MATCH_NOMATCH);\n2676\t      break;\n2677\t      }\n2678\t    Fecode++;\n2679\t    break;\n2680\t\n2681\t    case OP_NOT_HSPACE:\n2682\t    if (Feptr >= mb->end_subject)\n2683\t      {\n2684\t      SCHECK_PARTIAL();\n2685\t      RRETURN(MATCH_NOMATCH);\n2686\t      }\n2687\t    GETCHARINCTEST(fc, Feptr);\n2688\t    switch(fc)\n2689\t      {\n2690\t      HSPACE_CASES: RRETURN(MATCH_NOMATCH);  /* Byte and multibyte cases */\n2691\t      default: break;\n2692\t      }\n2693\t    Fecode++;\n2694\t    break;\n2695\t\n2696\t    case OP_HSPACE:\n2697\t    if (Feptr >= mb->end_subject)\n2698\t      {\n2699\t      SCHECK_PARTIAL();\n2700\t      RRETURN(MATCH_NOMATCH);\n2701\t      }\n2702\t    GETCHARINCTEST(fc, Feptr);\n2703\t    switch(fc)\n2704\t      {\n2705\t      HSPACE_CASES: break;  /* Byte and multibyte cases */\n2706\t      default: RRETURN(MATCH_NOMATCH);\n2707\t      }\n2708\t    Fecode++;\n2709\t    break;\n2710\t\n2711\t    case OP_NOT_VSPACE:\n2712\t    if (Feptr >= mb->end_subject)\n2713\t      {\n2714\t      SCHECK_PARTIAL();\n2715\t      RRETURN(MATCH_NOMATCH);\n2716\t      }\n2717\t    GETCHARINCTEST(fc, Feptr);\n2718\t    switch(fc)\n2719\t      {\n2720\t      VSPACE_CASES: RRETURN(MATCH_NOMATCH);\n2721\t      default: break;\n2722\t      }\n2723\t    Fecode++;\n2724\t    break;\n2725\t\n2726\t    case OP_VSPACE:\n2727\t    if (Feptr >= mb->end_subject)\n2728\t      {\n2729\t      SCHECK_PARTIAL();\n2730\t      RRETURN(MATCH_NOMATCH);\n2731\t      }\n2732\t    GETCHARINCTEST(fc, Feptr);\n2733\t    switch(fc)\n2734\t      {\n2735\t      VSPACE_CASES: break;\n2736\t      default: RRETURN(MATCH_NOMATCH);\n2737\t      }\n2738\t    Fecode++;\n2739\t    break;\n2740\t\n2741\t\n2742\t#ifdef SUPPORT_UNICODE\n2743\t\n2744\t    /* ===================================================================== */\n2745\t    /* Check the next character by Unicode property. We will get here only\n2746\t    if the support is in the binary; otherwise a compile-time error occurs. */\n2747\t\n2748\t    case OP_PROP:\n2749\t    case OP_NOTPROP:\n2750\t    if (Feptr >= mb->end_subject)\n2751\t      {\n2752\t      SCHECK_PARTIAL();\n2753\t      RRETURN(MATCH_NOMATCH);\n2754\t      }\n2755\t    GETCHARINCTEST(fc, Feptr);\n2756\t      {\n2757\t      const uint32_t *cp;\n2758\t      uint32_t chartype;\n2759\t      const ucd_record *prop = GET_UCD(fc);\n2760\t      BOOL notmatch = Fop == OP_NOTPROP;\n2761\t\n2762\t      switch(Fecode[1])\n2763\t        {\n2764\t        case PT_LAMP:\n2765\t        chartype = prop->chartype;\n2766\t        if ((chartype == ucp_Lu ||\n2767\t             chartype == ucp_Ll ||\n2768\t             chartype == ucp_Lt) == notmatch)\n2769\t          RRETURN(MATCH_NOMATCH);\n2770\t        break;\n2771\t\n2772\t        case PT_GC:\n2773\t        if ((Fecode[2] == PRIV(ucp_gentype)[prop->chartype]) == notmatch)\n2774\t          RRETURN(MATCH_NOMATCH);\n2775\t        break;\n2776\t\n2777\t        case PT_PC:\n2778\t        if ((Fecode[2] == prop->chartype) == notmatch)\n2779\t          RRETURN(MATCH_NOMATCH);\n2780\t        break;\n2781\t\n2782\t        case PT_SC:\n2783\t        if ((Fecode[2] == prop->script) == notmatch)\n2784\t          RRETURN(MATCH_NOMATCH);\n2785\t        break;\n2786\t\n2787\t        case PT_SCX:\n2788\t          {\n2789\t          BOOL ok = (Fecode[2] == prop->script ||\n2790\t                     MAPBIT(PRIV(ucd_script_sets) + UCD_SCRIPTX_PROP(prop), Fecode[2]) != 0);\n2791\t          if (ok == notmatch) RRETURN(MATCH_NOMATCH);\n2792\t          }\n2793\t        break;\n2794\t\n2795\t        /* These are specials */\n2796\t\n2797\t        case PT_ALNUM:\n2798\t        chartype = prop->chartype;\n2799\t        if ((PRIV(ucp_gentype)[chartype] == ucp_L ||\n2800\t             PRIV(ucp_gentype)[chartype] == ucp_N) == notmatch)\n2801\t          RRETURN(MATCH_NOMATCH);\n2802\t        break;\n2803\t\n2804\t        /* Perl space used to exclude VT, but from Perl 5.18 it is included,\n2805\t        which means that Perl space and POSIX space are now identical. PCRE\n2806\t        was changed at release 8.34. */\n2807\t\n2808\t        case PT_SPACE:    /* Perl space */\n2809\t        case PT_PXSPACE:  /* POSIX space */\n2810\t        switch(fc)\n2811\t          {\n2812\t          HSPACE_CASES:\n2813\t          VSPACE_CASES:\n2814\t          if (notmatch) RRETURN(MATCH_NOMATCH);\n2815\t          break;\n2816\t\n2817\t          default:\n2818\t          if ((PRIV(ucp_gentype)[prop->chartype] == ucp_Z) == notmatch)\n2819\t            RRETURN(MATCH_NOMATCH);\n2820\t          break;\n2821\t          }\n2822\t        break;\n2823\t\n2824\t        case PT_WORD:\n2825\t        chartype = prop->chartype;\n2826\t        if ((PRIV(ucp_gentype)[chartype] == ucp_L ||\n2827\t             PRIV(ucp_gentype)[chartype] == ucp_N ||\n2828\t             chartype == ucp_Mn ||\n2829\t             chartype == ucp_Pc) == notmatch)\n2830\t          RRETURN(MATCH_NOMATCH);\n2831\t        break;\n2832\t\n2833\t        case PT_CLIST:\n2834\t#if PCRE2_CODE_UNIT_WIDTH == 32\n2835\t            if (fc > MAX_UTF_CODE_POINT)\n2836\t              {\n2837\t              if (notmatch) break;;\n2838\t              RRETURN(MATCH_NOMATCH);\n2839\t              }\n2840\t#endif\n2841\t        cp = PRIV(ucd_caseless_sets) + Fecode[2];\n2842\t        for (;;)\n2843\t          {\n2844\t          if (fc < *cp)\n2845\t            { if (notmatch) break; else { RRETURN(MATCH_NOMATCH); } }\n2846\t          if (fc == *cp++)\n2847\t            { if (notmatch) { RRETURN(MATCH_NOMATCH); } else break; }\n2848\t          }\n2849\t        break;\n2850\t\n2851\t        case PT_UCNC:\n2852\t        if ((fc == CHAR_DOLLAR_SIGN || fc == CHAR_COMMERCIAL_AT ||\n2853\t             fc == CHAR_GRAVE_ACCENT || (fc >= 0xa0 && fc <= 0xd7ff) ||\n2854\t             fc >= 0xe000) == notmatch)\n2855\t          RRETURN(MATCH_NOMATCH);\n2856\t        break;\n2857\t\n2858\t        case PT_BIDICL:\n2859\t        if ((UCD_BIDICLASS_PROP(prop) == Fecode[2]) == notmatch)\n2860\t          RRETURN(MATCH_NOMATCH);\n2861\t        break;\n2862\t\n2863\t        case PT_BOOL:\n2864\t          {\n2865\t          BOOL ok = MAPBIT(PRIV(ucd_boolprop_sets) +\n2866\t            UCD_BPROPS_PROP(prop), Fecode[2]) != 0;\n2867\t          if (ok == notmatch) RRETURN(MATCH_NOMATCH);\n2868\t          }\n2869\t        break;\n2870\t\n2871\t        /* This should never occur */\n2872\t\n2873\t        /* LCOV_EXCL_START */\n2874\t        default:\n2875\t        PCRE2_DEBUG_UNREACHABLE();\n2876\t        return PCRE2_ERROR_INTERNAL;\n2877\t        /* LCOV_EXCL_STOP */\n2878\t        }\n2879\t\n2880\t      Fecode += 3;\n2881\t      }\n2882\t    break;\n2883\t\n2884\t\n2885\t    /* ===================================================================== */\n2886\t    /* Match an extended Unicode sequence. We will get here only if the support\n2887\t    is in the binary; otherwise a compile-time error occurs. */\n2888\t\n2889\t    case OP_EXTUNI:\n2890\t    if (Feptr >= mb->end_subject)\n2891\t      {\n2892\t      SCHECK_PARTIAL();\n2893\t      RRETURN(MATCH_NOMATCH);\n2894\t      }\n2895\t    else\n2896\t      {\n2897\t      GETCHARINCTEST(fc, Feptr);\n2898\t      Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject, mb->end_subject, utf,\n2899\t        NULL);\n2900\t      }\n2901\t    CHECK_PARTIAL();\n2902\t    Fecode++;\n2903\t    break;\n2904\t\n2905\t#endif  /* SUPPORT_UNICODE */\n2906\t\n2907\t\n2908\t    /* ===================================================================== */\n2909\t    /* Match a single character type repeatedly. Note that the property type\n2910\t    does not need to be in a stack frame as it is not used within an RMATCH()\n2911\t    loop. */\n2912\t\n2913\t#define Lstart_eptr  F->fields.type_repeat.start_eptr\n2914\t#define Lmin         F->fields.type_repeat.min\n2915\t#define Lmax         F->fields.type_repeat.max\n2916\t#define Lctype       F->fields.type_repeat.ctype\n2917\t#define Lpropvalue   F->fields.type_repeat.propvalue\n2918\t\n2919\t    case OP_TYPEEXACT:\n2920\t    Lmin = Lmax = GET2(Fecode, 1);\n2921\t    Fecode += 1 + IMM2_SIZE;\n2922\t    goto REPEATTYPE;\n2923\t\n2924\t    case OP_TYPEUPTO:\n2925\t    case OP_TYPEMINUPTO:\n2926\t    Lmin = 0;\n2927\t    Lmax = GET2(Fecode, 1);\n2928\t    reptype = (*Fecode == OP_TYPEMINUPTO)? REPTYPE_MIN : REPTYPE_MAX;\n2929\t    Fecode += 1 + IMM2_SIZE;\n2930\t    goto REPEATTYPE;\n2931\t\n2932\t    case OP_TYPEPOSSTAR:\n2933\t    reptype = REPTYPE_POS;\n2934\t    Lmin = 0;\n2935\t    Lmax = UINT32_MAX;\n2936\t    Fecode++;\n2937\t    goto REPEATTYPE;\n2938\t\n2939\t    case OP_TYPEPOSPLUS:\n2940\t    reptype = REPTYPE_POS;\n2941\t    Lmin = 1;\n2942\t    Lmax = UINT32_MAX;\n2943\t    Fecode++;\n2944\t    goto REPEATTYPE;\n2945\t\n2946\t    case OP_TYPEPOSQUERY:\n2947\t    reptype = REPTYPE_POS;\n2948\t    Lmin = 0;\n2949\t    Lmax = 1;\n2950\t    Fecode++;\n2951\t    goto REPEATTYPE;\n2952\t\n2953\t    case OP_TYPEPOSUPTO:\n2954\t    reptype = REPTYPE_POS;\n2955\t    Lmin = 0;\n2956\t    Lmax = GET2(Fecode, 1);\n2957\t    Fecode += 1 + IMM2_SIZE;\n2958\t    goto REPEATTYPE;\n2959\t\n2960\t    case OP_TYPESTAR:\n2961\t    case OP_TYPEMINSTAR:\n2962\t    case OP_TYPEPLUS:\n2963\t    case OP_TYPEMINPLUS:\n2964\t    case OP_TYPEQUERY:\n2965\t    case OP_TYPEMINQUERY:\n2966\t    fc = *Fecode++ - OP_TYPESTAR;\n2967\t    Lmin = rep_min[fc];\n2968\t    Lmax = rep_max[fc];\n2969\t    reptype = rep_typ[fc];\n2970\t\n2971\t    /* Common code for all repeated character type matches. */\n2972\t\n2973\t    REPEATTYPE:\n2974\t    Lctype = *Fecode++;      /* Code for the character type */\n2975\t\n2976\t#ifdef SUPPORT_UNICODE\n2977\t    if (Lctype == OP_PROP || Lctype == OP_NOTPROP)\n2978\t      {\n2979\t      proptype = *Fecode++;\n2980\t      Lpropvalue = *Fecode++;\n2981\t      }\n2982\t    else proptype = -1;\n2983\t#endif\n2984\t\n2985\t    /* First, ensure the minimum number of matches are present. Use inline\n2986\t    code for maximizing the speed, and do the type test once at the start\n2987\t    (i.e. keep it out of the loops). As there are no calls to RMATCH in the\n2988\t    loops, we can use an ordinary variable for \"notmatch\". The code for UTF\n2989\t    mode is separated out for tidiness, except for Unicode property tests. */\n2990\t\n2991\t    if (Lmin > 0)\n2992\t      {\n2993\t#ifdef SUPPORT_UNICODE\n2994\t      if (proptype >= 0)  /* Property tests in all modes */\n2995\t        {\n2996\t        BOOL notmatch = Lctype == OP_NOTPROP;\n2997\t        switch(proptype)\n2998\t          {\n2999\t          case PT_LAMP:\n3000\t          for (i = 1; i <= Lmin; i++)\n3001\t            {\n3002\t            int chartype;\n3003\t            if (Feptr >= mb->end_subject)\n3004\t              {\n3005\t              SCHECK_PARTIAL();\n3006\t              RRETURN(MATCH_NOMATCH);\n3007\t              }\n3008\t            GETCHARINCTEST(fc, Feptr);\n3009\t            chartype = UCD_CHARTYPE(fc);\n3010\t            if ((chartype == ucp_Lu ||\n3011\t                 chartype == ucp_Ll ||\n3012\t                 chartype == ucp_Lt) == notmatch)\n3013\t              RRETURN(MATCH_NOMATCH);\n3014\t            }\n3015\t          break;\n3016\t\n3017\t          case PT_GC:\n3018\t          for (i = 1; i <= Lmin; i++)\n3019\t            {\n3020\t            if (Feptr >= mb->end_subject)\n3021\t              {\n3022\t              SCHECK_PARTIAL();\n3023\t              RRETURN(MATCH_NOMATCH);\n3024\t              }\n3025\t            GETCHARINCTEST(fc, Feptr);\n3026\t            if ((UCD_CATEGORY(fc) == Lpropvalue) == notmatch)\n3027\t              RRETURN(MATCH_NOMATCH);\n3028\t            }\n3029\t          break;\n3030\t\n3031\t          case PT_PC:\n3032\t          for (i = 1; i <= Lmin; i++)\n3033\t            {\n3034\t            if (Feptr >= mb->end_subject)\n3035\t              {\n3036\t              SCHECK_PARTIAL();\n3037\t              RRETURN(MATCH_NOMATCH);\n3038\t              }\n3039\t            GETCHARINCTEST(fc, Feptr);\n3040\t            if ((UCD_CHARTYPE(fc) == Lpropvalue) == notmatch)\n3041\t              RRETURN(MATCH_NOMATCH);\n3042\t            }\n3043\t          break;\n3044\t\n3045\t          case PT_SC:\n3046\t          for (i = 1; i <= Lmin; i++)\n3047\t            {\n3048\t            if (Feptr >= mb->end_subject)\n3049\t              {\n3050\t              SCHECK_PARTIAL();\n3051\t              RRETURN(MATCH_NOMATCH);\n3052\t              }\n3053\t            GETCHARINCTEST(fc, Feptr);\n3054\t            if ((UCD_SCRIPT(fc) == Lpropvalue) == notmatch)\n3055\t              RRETURN(MATCH_NOMATCH);\n3056\t            }\n3057\t          break;\n3058\t\n3059\t          case PT_SCX:\n3060\t          for (i = 1; i <= Lmin; i++)\n3061\t            {\n3062\t            BOOL ok;\n3063\t            const ucd_record *prop;\n3064\t            if (Feptr >= mb->end_subject)\n3065\t              {\n3066\t              SCHECK_PARTIAL();\n3067\t              RRETURN(MATCH_NOMATCH);\n3068\t              }\n3069\t            GETCHARINCTEST(fc, Feptr);\n3070\t            prop = GET_UCD(fc);\n3071\t            ok = (prop->script == Lpropvalue ||\n3072\t                  MAPBIT(PRIV(ucd_script_sets) + UCD_SCRIPTX_PROP(prop), Lpropvalue) != 0);\n3073\t            if (ok == notmatch)\n3074\t              RRETURN(MATCH_NOMATCH);\n3075\t            }\n3076\t          break;\n3077\t\n3078\t          case PT_ALNUM:\n3079\t          for (i = 1; i <= Lmin; i++)\n3080\t            {\n3081\t            int category;\n3082\t            if (Feptr >= mb->end_subject)\n3083\t              {\n3084\t              SCHECK_PARTIAL();\n3085\t              RRETURN(MATCH_NOMATCH);\n3086\t              }\n3087\t            GETCHARINCTEST(fc, Feptr);\n3088\t            category = UCD_CATEGORY(fc);\n3089\t            if ((category == ucp_L || category == ucp_N) == notmatch)\n3090\t              RRETURN(MATCH_NOMATCH);\n3091\t            }\n3092\t          break;\n3093\t\n3094\t          /* Perl space used to exclude VT, but from Perl 5.18 it is included,\n3095\t          which means that Perl space and POSIX space are now identical. PCRE\n3096\t          was changed at release 8.34. */\n3097\t\n3098\t          case PT_SPACE:    /* Perl space */\n3099\t          case PT_PXSPACE:  /* POSIX space */\n3100\t          for (i = 1; i <= Lmin; i++)\n3101\t            {\n3102\t            if (Feptr >= mb->end_subject)\n3103\t              {\n3104\t              SCHECK_PARTIAL();\n3105\t              RRETURN(MATCH_NOMATCH);\n3106\t              }\n3107\t            GETCHARINCTEST(fc, Feptr);\n3108\t            switch(fc)\n3109\t              {\n3110\t              HSPACE_CASES:\n3111\t              VSPACE_CASES:\n3112\t              if (notmatch) RRETURN(MATCH_NOMATCH);\n3113\t              break;\n3114\t\n3115\t              default:\n3116\t              if ((UCD_CATEGORY(fc) == ucp_Z) == notmatch)\n3117\t                RRETURN(MATCH_NOMATCH);\n3118\t              break;\n3119\t              }\n3120\t            }\n3121\t          break;\n3122\t\n3123\t          case PT_WORD:\n3124\t          for (i = 1; i <= Lmin; i++)\n3125\t            {\n3126\t            int chartype, category;\n3127\t            if (Feptr >= mb->end_subject)\n3128\t              {\n3129\t              SCHECK_PARTIAL();\n3130\t              RRETURN(MATCH_NOMATCH);\n3131\t              }\n3132\t            GETCHARINCTEST(fc, Feptr);\n3133\t            chartype = UCD_CHARTYPE(fc);\n3134\t            category = PRIV(ucp_gentype)[chartype];\n3135\t            if ((category == ucp_L || category == ucp_N ||\n3136\t                 chartype == ucp_Mn || chartype == ucp_Pc) == notmatch)\n3137\t              RRETURN(MATCH_NOMATCH);\n3138\t            }\n3139\t          break;\n3140\t\n3141\t          case PT_CLIST:\n3142\t          for (i = 1; i <= Lmin; i++)\n3143\t            {\n3144\t            const uint32_t *cp;\n3145\t            if (Feptr >= mb->end_subject)\n3146\t              {\n3147\t              SCHECK_PARTIAL();\n3148\t              RRETURN(MATCH_NOMATCH);\n3149\t              }\n3150\t            GETCHARINCTEST(fc, Feptr);\n3151\t#if PCRE2_CODE_UNIT_WIDTH == 32\n3152\t            if (fc > MAX_UTF_CODE_POINT)\n3153\t              {\n3154\t              if (notmatch) continue;\n3155\t              RRETURN(MATCH_NOMATCH);\n3156\t              }\n3157\t#endif\n3158\t            cp = PRIV(ucd_caseless_sets) + Lpropvalue;\n3159\t            for (;;)\n3160\t              {\n3161\t              if (fc < *cp)\n3162\t                {\n3163\t                if (notmatch) break;\n3164\t                RRETURN(MATCH_NOMATCH);\n3165\t                }\n3166\t              if (fc == *cp++)\n3167\t                {\n3168\t                if (notmatch) RRETURN(MATCH_NOMATCH);\n3169\t                break;\n3170\t                }\n3171\t              }\n3172\t            }\n3173\t          break;\n3174\t\n3175\t          case PT_UCNC:\n3176\t          for (i = 1; i <= Lmin; i++)\n3177\t            {\n3178\t            if (Feptr >= mb->end_subject)\n3179\t              {\n3180\t              SCHECK_PARTIAL();\n3181\t              RRETURN(MATCH_NOMATCH);\n3182\t              }\n3183\t            GETCHARINCTEST(fc, Feptr);\n3184\t            if ((fc == CHAR_DOLLAR_SIGN || fc == CHAR_COMMERCIAL_AT ||\n3185\t                 fc == CHAR_GRAVE_ACCENT || (fc >= 0xa0 && fc <= 0xd7ff) ||\n3186\t                 fc >= 0xe000) == notmatch)\n3187\t              RRETURN(MATCH_NOMATCH);\n3188\t            }\n3189\t          break;\n3190\t\n3191\t          case PT_BIDICL:\n3192\t          for (i = 1; i <= Lmin; i++)\n3193\t            {\n3194\t            if (Feptr >= mb->end_subject)\n3195\t              {\n3196\t              SCHECK_PARTIAL();\n3197\t              RRETURN(MATCH_NOMATCH);\n3198\t              }\n3199\t            GETCHARINCTEST(fc, Feptr);\n3200\t            if ((UCD_BIDICLASS(fc) == Lpropvalue) == notmatch)\n3201\t              RRETURN(MATCH_NOMATCH);\n3202\t            }\n3203\t          break;\n3204\t\n3205\t          case PT_BOOL:\n3206\t          for (i = 1; i <= Lmin; i++)\n3207\t            {\n3208\t            BOOL ok;\n3209\t            const ucd_record *prop;\n3210\t            if (Feptr >= mb->end_subject)\n3211\t              {\n3212\t              SCHECK_PARTIAL();\n3213\t              RRETURN(MATCH_NOMATCH);\n3214\t              }\n3215\t            GETCHARINCTEST(fc, Feptr);\n3216\t            prop = GET_UCD(fc);\n3217\t            ok = MAPBIT(PRIV(ucd_boolprop_sets) +\n3218\t              UCD_BPROPS_PROP(prop), Lpropvalue) != 0;\n3219\t            if (ok == notmatch)\n3220\t              RRETURN(MATCH_NOMATCH);\n3221\t            }\n3222\t          break;\n3223\t\n3224\t          /* This should not occur */\n3225\t\n3226\t          /* LCOV_EXCL_START */\n3227\t          default:\n3228\t          PCRE2_DEBUG_UNREACHABLE();\n3229\t          return PCRE2_ERROR_INTERNAL;\n3230\t          /* LCOV_EXCL_STOP */\n3231\t          }\n3232\t        }\n3233\t\n3234\t      /* Match extended Unicode sequences. We will get here only if the\n3235\t      support is in the binary; otherwise a compile-time error occurs. */\n3236\t\n3237\t      else if (Lctype == OP_EXTUNI)\n3238\t        {\n3239\t        for (i = 1; i <= Lmin; i++)\n3240\t          {\n3241\t          if (Feptr >= mb->end_subject)\n3242\t            {\n3243\t            SCHECK_PARTIAL();\n3244\t            RRETURN(MATCH_NOMATCH);\n3245\t            }\n3246\t          else\n3247\t            {\n3248\t            GETCHARINCTEST(fc, Feptr);\n3249\t            Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject,\n3250\t              mb->end_subject, utf, NULL);\n3251\t            }\n3252\t          CHECK_PARTIAL();\n3253\t          }\n3254\t        }\n3255\t      else\n3256\t#endif     /* SUPPORT_UNICODE */\n3257\t\n3258\t/* Handle all other cases in UTF mode */\n3259\t\n3260\t#ifdef SUPPORT_UNICODE\n3261\t      if (utf) switch(Lctype)\n3262\t        {\n3263\t        case OP_ANY:\n3264\t        for (i = 1; i <= Lmin; i++)\n3265\t          {\n3266\t          if (Feptr >= mb->end_subject)\n3267\t            {\n3268\t            SCHECK_PARTIAL();\n3269\t            RRETURN(MATCH_NOMATCH);\n3270\t            }\n3271\t          if (IS_NEWLINE(Feptr)) RRETURN(MATCH_NOMATCH);\n3272\t          if (mb->partial != 0 &&\n3273\t              Feptr + 1 >= mb->end_subject &&\n3274\t              NLBLOCK->nltype == NLTYPE_FIXED &&\n3275\t              NLBLOCK->nllen == 2 &&\n3276\t              *Feptr == NLBLOCK->nl[0])\n3277\t            {\n3278\t            mb->hitend = TRUE;\n3279\t            if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n3280\t            }\n3281\t          Feptr++;\n3282\t          ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++);\n3283\t          }\n3284\t        break;\n3285\t\n3286\t        case OP_ALLANY:\n3287\t        for (i = 1; i <= Lmin; i++)\n3288\t          {\n3289\t          if (Feptr >= mb->end_subject)\n3290\t            {\n3291\t            SCHECK_PARTIAL();\n3292\t            RRETURN(MATCH_NOMATCH);\n3293\t            }\n3294\t          Feptr++;\n3295\t          ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++);\n3296\t          }\n3297\t        break;\n3298\t\n3299\t        case OP_ANYBYTE:\n3300\t        if (Feptr > mb->end_subject - Lmin) RRETURN(MATCH_NOMATCH);\n3301\t        Feptr += Lmin;\n3302\t        break;\n3303\t\n3304\t        case OP_ANYNL:\n3305\t        for (i = 1; i <= Lmin; i++)\n3306\t          {\n3307\t          if (Feptr >= mb->end_subject)\n3308\t            {\n3309\t            SCHECK_PARTIAL();\n3310\t            RRETURN(MATCH_NOMATCH);\n3311\t            }\n3312\t          GETCHARINC(fc, Feptr);\n3313\t          switch(fc)\n3314\t            {\n3315\t            default: RRETURN(MATCH_NOMATCH);\n3316\t\n3317\t            case CHAR_CR:\n3318\t            if (Feptr < mb->end_subject && *Feptr == CHAR_LF) Feptr++;\n3319\t            break;\n3320\t\n3321\t            case CHAR_LF:\n3322\t            break;\n3323\t\n3324\t            case CHAR_VT:\n3325\t            case CHAR_FF:\n3326\t            case CHAR_NEL:\n3327\t#ifndef EBCDIC\n3328\t            case 0x2028:\n3329\t            case 0x2029:\n3330\t#endif  /* Not EBCDIC */\n3331\t            if (mb->bsr_convention == PCRE2_BSR_ANYCRLF) RRETURN(MATCH_NOMATCH);\n3332\t            break;\n3333\t            }\n3334\t          }\n3335\t        break;\n3336\t\n3337\t        case OP_NOT_HSPACE:\n3338\t        for (i = 1; i <= Lmin; i++)\n3339\t          {\n3340\t          if (Feptr >= mb->end_subject)\n3341\t            {\n3342\t            SCHECK_PARTIAL();\n3343\t            RRETURN(MATCH_NOMATCH);\n3344\t            }\n3345\t          GETCHARINC(fc, Feptr);\n3346\t          switch(fc)\n3347\t            {\n3348\t            HSPACE_CASES: RRETURN(MATCH_NOMATCH);\n3349\t            default: break;\n3350\t            }\n3351\t          }\n3352\t        break;\n3353\t\n3354\t        case OP_HSPACE:\n3355\t        for (i = 1; i <= Lmin; i++)\n3356\t          {\n3357\t          if (Feptr >= mb->end_subject)\n3358\t            {\n3359\t            SCHECK_PARTIAL();\n3360\t            RRETURN(MATCH_NOMATCH);\n3361\t            }\n3362\t          GETCHARINC(fc, Feptr);\n3363\t          switch(fc)\n3364\t            {\n3365\t            HSPACE_CASES: break;\n3366\t            default: RRETURN(MATCH_NOMATCH);\n3367\t            }\n3368\t          }\n3369\t        break;\n3370\t\n3371\t        case OP_NOT_VSPACE:\n3372\t        for (i = 1; i <= Lmin; i++)\n3373\t          {\n3374\t          if (Feptr >= mb->end_subject)\n3375\t            {\n3376\t            SCHECK_PARTIAL();\n3377\t            RRETURN(MATCH_NOMATCH);\n3378\t            }\n3379\t          GETCHARINC(fc, Feptr);\n3380\t          switch(fc)\n3381\t            {\n3382\t            VSPACE_CASES: RRETURN(MATCH_NOMATCH);\n3383\t            default: break;\n3384\t            }\n3385\t          }\n3386\t        break;\n3387\t\n3388\t        case OP_VSPACE:\n3389\t        for (i = 1; i <= Lmin; i++)\n3390\t          {\n3391\t          if (Feptr >= mb->end_subject)\n3392\t            {\n3393\t            SCHECK_PARTIAL();\n3394\t            RRETURN(MATCH_NOMATCH);\n3395\t            }\n3396\t          GETCHARINC(fc, Feptr);\n3397\t          switch(fc)\n3398\t            {\n3399\t            VSPACE_CASES: break;\n3400\t            default: RRETURN(MATCH_NOMATCH);\n3401\t            }\n3402\t          }\n3403\t        break;\n3404\t\n3405\t        case OP_N