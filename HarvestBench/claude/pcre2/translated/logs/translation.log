480\t          if (cc < 128 && (mb->ctypes[cc] & ctype_word) != 0)\n3481\t            RRETURN(MATCH_NOMATCH);\n3482\t          Feptr++;\n3483\t          ACROSSCHAR(Feptr < mb->end_subject, Feptr, Feptr++);\n3484\t          }\n3485\t        break;\n3486\t\n3487\t        case OP_WORDCHAR:\n3488\t        for (i = 1; i <= Lmin; i++)\n3489\t          {\n3490\t          uint32_t cc;\n3491\t          if (Feptr >= mb->end_subject)\n3492\t            {\n3493\t            SCHECK_PARTIAL();\n3494\t            RRETURN(MATCH_NOMATCH);\n3495\t            }\n3496\t          cc = *Feptr;\n3497\t          if (cc >= 128 || (mb->ctypes[cc] & ctype_word) == 0)\n3498\t            RRETURN(MATCH_NOMATCH);\n3499\t          Feptr++;\n3500\t          /* No need to skip more code units - we know it has only one. */\n3501\t          }\n3502\t        break;\n3503\t\n3504\t        /* LCOV_EXCL_START */\n3505\t        default:\n3506\t        PCRE2_DEBUG_UNREACHABLE();\n3507\t        return PCRE2_ERROR_INTERNAL;\n3508\t        /* LCOV_EXCL_STOP */\n3509\t        }  /* End switch(Lctype) */\n3510\t\n3511\t      else\n3512\t#endif     /* SUPPORT_UNICODE */\n3513\t\n3514\t      /* Code for the non-UTF case for minimum matching of operators other\n3515\t      than OP_PROP and OP_NOTPROP. */\n3516\t\n3517\t      switch(Lctype)\n3518\t        {\n3519\t        case OP_ANY:\n3520\t        for (i = 1; i <= Lmin; i++)\n3521\t          {\n3522\t          if (Feptr >= mb->end_subject)\n3523\t            {\n3524\t            SCHECK_PARTIAL();\n3525\t            RRETURN(MATCH_NOMATCH);\n3526\t            }\n3527\t          if (IS_NEWLINE(Feptr)) RRETURN(MATCH_NOMATCH);\n3528\t          if (mb->partial != 0 &&\n3529\t              Feptr + 1 >= mb->end_subject &&\n3530\t              NLBLOCK->nltype == NLTYPE_FIXED &&\n3531\t              NLBLOCK->nllen == 2 &&\n3532\t              *Feptr == NLBLOCK->nl[0])\n3533\t            {\n3534\t            mb->hitend = TRUE;\n3535\t            if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n3536\t            }\n3537\t          Feptr++;\n3538\t          }\n3539\t        break;\n3540\t\n3541\t        case OP_ALLANY:\n3542\t        if (Feptr > mb->end_subject - Lmin)\n3543\t          {\n3544\t          SCHECK_PARTIAL();\n3545\t          RRETURN(MATCH_NOMATCH);\n3546\t          }\n3547\t        Feptr += Lmin;\n3548\t        break;\n3549\t\n3550\t        /* This OP_ANYBYTE case will never be reached because \\C gets turned\n3551\t        into OP_ALLANY in non-UTF mode. Cut out the code so that coverage\n3552\t        reports don't complain about it's never being used. */\n3553\t\n3554\t/*        case OP_ANYBYTE:\n3555\t*        if (Feptr > mb->end_subject - Lmin)\n3556\t*          {\n3557\t*          SCHECK_PARTIAL();\n3558\t*          RRETURN(MATCH_NOMATCH);\n3559\t*          }\n3560\t*        Feptr += Lmin;\n3561\t*        break;\n3562\t*/\n3563\t        case OP_ANYNL:\n3564\t        for (i = 1; i <= Lmin; i++)\n3565\t          {\n3566\t          if (Feptr >= mb->end_subject)\n3567\t            {\n3568\t            SCHECK_PARTIAL();\n3569\t            RRETURN(MATCH_NOMATCH);\n3570\t            }\n3571\t          switch(*Feptr++)\n3572\t            {\n3573\t            default: RRETURN(MATCH_NOMATCH);\n3574\t\n3575\t            case CHAR_CR:\n3576\t            if (Feptr < mb->end_subject && *Feptr == CHAR_LF) Feptr++;\n3577\t            break;\n3578\t\n3579\t            case CHAR_LF:\n3580\t            break;\n3581\t\n3582\t            case CHAR_VT:\n3583\t            case CHAR_FF:\n3584\t            case CHAR_NEL:\n3585\t#if PCRE2_CODE_UNIT_WIDTH != 8\n3586\t            case 0x2028:\n3587\t            case 0x2029:\n3588\t#endif\n3589\t            if (mb->bsr_convention == PCRE2_BSR_ANYCRLF) RRETURN(MATCH_NOMATCH);\n3590\t            break;\n3591\t            }\n3592\t          }\n3593\t        break;\n3594\t\n3595\t        case OP_NOT_HSPACE:\n3596\t        for (i = 1; i <= Lmin; i++)\n3597\t          {\n3598\t          if (Feptr >= mb->end_subject)\n3599\t            {\n3600\t            SCHECK_PARTIAL();\n3601\t            RRETURN(MATCH_NOMATCH);\n3602\t            }\n3603\t          switch(*Feptr++)\n3604\t            {\n3605\t            default: break;\n3606\t            HSPACE_BYTE_CASES:\n3607\t#if PCRE2_CODE_UNIT_WIDTH != 8\n3608\t            HSPACE_MULTIBYTE_CASES:\n3609\t#endif\n3610\t            RRETURN(MATCH_NOMATCH);\n3611\t            }\n3612\t          }\n3613\t        break;\n3614\t\n3615\t        case OP_HSPACE:\n3616\t        for (i = 1; i <= Lmin; i++)\n3617\t          {\n3618\t          if (Feptr >= mb->end_subject)\n3619\t            {\n3620\t            SCHECK_PARTIAL();\n3621\t            RRETURN(MATCH_NOMATCH);\n3622\t            }\n3623\t          switch(*Feptr++)\n3624\t            {\n3625\t            default: RRETURN(MATCH_NOMATCH);\n3626\t            HSPACE_BYTE_CASES:\n3627\t#if PCRE2_CODE_UNIT_WIDTH != 8\n3628\t            HSPACE_MULTIBYTE_CASES:\n3629\t#endif\n3630\t            break;\n3631\t            }\n3632\t          }\n3633\t        break;\n3634\t\n3635\t        case OP_NOT_VSPACE:\n3636\t        for (i = 1; i <= Lmin; i++)\n3637\t          {\n3638\t          if (Feptr >= mb->end_subject)\n3639\t            {\n3640\t            SCHECK_PARTIAL();\n3641\t            RRETURN(MATCH_NOMATCH);\n3642\t            }\n3643\t          switch(*Feptr++)\n3644\t            {\n3645\t            VSPACE_BYTE_CASES:\n3646\t#if PCRE2_CODE_UNIT_WIDTH != 8\n3647\t            VSPACE_MULTIBYTE_CASES:\n3648\t#endif\n3649\t            RRETURN(MATCH_NOMATCH);\n3650\t            default: break;\n3651\t            }\n3652\t          }\n3653\t        break;\n3654\t\n3655\t        case OP_VSPACE:\n3656\t        for (i = 1; i <= Lmin; i++)\n3657\t          {\n3658\t          if (Feptr >= mb->end_subject)\n3659\t            {\n3660\t            SCHECK_PARTIAL();\n3661\t            RRETURN(MATCH_NOMATCH);\n3662\t            }\n3663\t          switch(*Feptr++)\n3664\t            {\n3665\t            default: RRETURN(MATCH_NOMATCH);\n3666\t            VSPACE_BYTE_CASES:\n3667\t#if PCRE2_CODE_UNIT_WIDTH != 8\n3668\t            VSPACE_MULTIBYTE_CASES:\n3669\t#endif\n3670\t            break;\n3671\t            }\n3672\t          }\n3673\t        break;\n3674\t\n3675\t        case OP_NOT_DIGIT:\n3676\t        for (i = 1; i <= Lmin; i++)\n3677\t          {\n3678\t          if (Feptr >= mb->end_subject)\n3679\t            {\n3680\t            SCHECK_PARTIAL();\n3681\t            RRETURN(MATCH_NOMATCH);\n3682\t            }\n3683\t          if (MAX_255(*Feptr) && (mb->ctypes[*Feptr] & ctype_digit) != 0)\n3684\t            RRETURN(MATCH_NOMATCH);\n3685\t          Feptr++;\n3686\t          }\n3687\t        break;\n3688\t\n3689\t        case OP_DIGIT:\n3690\t        for (i = 1; i <= Lmin; i++)\n3691\t          {\n3692\t          if (Feptr >= mb->end_subject)\n3693\t            {\n3694\t            SCHECK_PARTIAL();\n3695\t            RRETURN(MATCH_NOMATCH);\n3696\t            }\n3697\t          if (!MAX_255(*Feptr) || (mb->ctypes[*Feptr] & ctype_digit) == 0)\n3698\t            RRETURN(MATCH_NOMATCH);\n3699\t          Feptr++;\n3700\t          }\n3701\t        break;\n3702\t\n3703\t        case OP_NOT_WHITESPACE:\n3704\t        for (i = 1; i <= Lmin; i++)\n3705\t          {\n3706\t          if (Feptr >= mb->end_subject)\n3707\t            {\n3708\t            SCHECK_PARTIAL();\n3709\t            RRETURN(MATCH_NOMATCH);\n3710\t            }\n3711\t          if (MAX_255(*Feptr) && (mb->ctypes[*Feptr] & ctype_space) != 0)\n3712\t            RRETURN(MATCH_NOMATCH);\n3713\t          Feptr++;\n3714\t          }\n3715\t        break;\n3716\t\n3717\t        case OP_WHITESPACE:\n3718\t        for (i = 1; i <= Lmin; i++)\n3719\t          {\n3720\t          if (Feptr >= mb->end_subject)\n3721\t            {\n3722\t            SCHECK_PARTIAL();\n3723\t            RRETURN(MATCH_NOMATCH);\n3724\t            }\n3725\t          if (!MAX_255(*Feptr) || (mb->ctypes[*Feptr] & ctype_space) == 0)\n3726\t            RRETURN(MATCH_NOMATCH);\n3727\t          Feptr++;\n3728\t          }\n3729\t        break;\n3730\t\n3731\t        case OP_NOT_WORDCHAR:\n3732\t        for (i = 1; i <= Lmin; i++)\n3733\t          {\n3734\t          if (Feptr >= mb->end_subject)\n3735\t            {\n3736\t            SCHECK_PARTIAL();\n3737\t            RRETURN(MATCH_NOMATCH);\n3738\t            }\n3739\t          if (MAX_255(*Feptr) && (mb->ctypes[*Feptr] & ctype_word) != 0)\n3740\t            RRETURN(MATCH_NOMATCH);\n3741\t          Feptr++;\n3742\t          }\n3743\t        break;\n3744\t\n3745\t        case OP_WORDCHAR:\n3746\t        for (i = 1; i <= Lmin; i++)\n3747\t          {\n3748\t          if (Feptr >= mb->end_subject)\n3749\t            {\n3750\t            SCHECK_PARTIAL();\n3751\t            RRETURN(MATCH_NOMATCH);\n3752\t            }\n3753\t          if (!MAX_255(*Feptr) || (mb->ctypes[*Feptr] & ctype_word) == 0)\n3754\t            RRETURN(MATCH_NOMATCH);\n3755\t          Feptr++;\n3756\t          }\n3757\t        break;\n3758\t\n3759\t        /* LCOV_EXCL_START */\n3760\t        default:\n3761\t        PCRE2_DEBUG_UNREACHABLE();\n3762\t        return PCRE2_ERROR_INTERNAL;\n3763\t        /* LCOV_EXCL_STOP */\n3764\t        }\n3765\t      }\n3766\t\n3767\t    /* If Lmin = Lmax we are done. Continue with the main loop. */\n3768\t\n3769\t    if (Lmin == Lmax) continue;\n3770\t\n3771\t    /* If minimizing, we have to test the rest of the pattern before each\n3772\t    subsequent match. This means we cannot use a local \"notmatch\" variable as\n3773\t    in the other cases. As all 4 temporary 32-bit values in the frame are\n3774\t    already in use, just test the type each time. */\n3775\t\n3776\t    if (reptype == REPTYPE_MIN)\n3777\t      {\n3778\t#ifdef SUPPORT_UNICODE\n3779\t      if (proptype >= 0)\n3780\t        {\n3781\t        switch(proptype)\n3782\t          {\n3783\t          case PT_LAMP:\n3784\t          for (;;)\n3785\t            {\n3786\t            int chartype;\n3787\t            RMATCH(Fecode, RM208);\n3788\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3789\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3790\t            if (Feptr >= mb->end_subject)\n3791\t              {\n3792\t              SCHECK_PARTIAL();\n3793\t              RRETURN(MATCH_NOMATCH);\n3794\t              }\n3795\t            GETCHARINCTEST(fc, Feptr);\n3796\t            chartype = UCD_CHARTYPE(fc);\n3797\t            if ((chartype == ucp_Lu ||\n3798\t                 chartype == ucp_Ll ||\n3799\t                 chartype == ucp_Lt) == (Lctype == OP_NOTPROP))\n3800\t              RRETURN(MATCH_NOMATCH);\n3801\t            }\n3802\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3803\t\n3804\t          case PT_GC:\n3805\t          for (;;)\n3806\t            {\n3807\t            RMATCH(Fecode, RM209);\n3808\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3809\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3810\t            if (Feptr >= mb->end_subject)\n3811\t              {\n3812\t              SCHECK_PARTIAL();\n3813\t              RRETURN(MATCH_NOMATCH);\n3814\t              }\n3815\t            GETCHARINCTEST(fc, Feptr);\n3816\t            if ((UCD_CATEGORY(fc) == Lpropvalue) == (Lctype == OP_NOTPROP))\n3817\t              RRETURN(MATCH_NOMATCH);\n3818\t            }\n3819\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3820\t\n3821\t          case PT_PC:\n3822\t          for (;;)\n3823\t            {\n3824\t            RMATCH(Fecode, RM210);\n3825\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3826\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3827\t            if (Feptr >= mb->end_subject)\n3828\t              {\n3829\t              SCHECK_PARTIAL();\n3830\t              RRETURN(MATCH_NOMATCH);\n3831\t              }\n3832\t            GETCHARINCTEST(fc, Feptr);\n3833\t            if ((UCD_CHARTYPE(fc) == Lpropvalue) == (Lctype == OP_NOTPROP))\n3834\t              RRETURN(MATCH_NOMATCH);\n3835\t            }\n3836\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3837\t\n3838\t          case PT_SC:\n3839\t          for (;;)\n3840\t            {\n3841\t            RMATCH(Fecode, RM211);\n3842\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3843\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3844\t            if (Feptr >= mb->end_subject)\n3845\t              {\n3846\t              SCHECK_PARTIAL();\n3847\t              RRETURN(MATCH_NOMATCH);\n3848\t              }\n3849\t            GETCHARINCTEST(fc, Feptr);\n3850\t            if ((UCD_SCRIPT(fc) == Lpropvalue) == (Lctype == OP_NOTPROP))\n3851\t              RRETURN(MATCH_NOMATCH);\n3852\t            }\n3853\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3854\t\n3855\t          case PT_SCX:\n3856\t          for (;;)\n3857\t            {\n3858\t            BOOL ok;\n3859\t            const ucd_record *prop;\n3860\t            RMATCH(Fecode, RM224);\n3861\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3862\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3863\t            if (Feptr >= mb->end_subject)\n3864\t              {\n3865\t              SCHECK_PARTIAL();\n3866\t              RRETURN(MATCH_NOMATCH);\n3867\t              }\n3868\t            GETCHARINCTEST(fc, Feptr);\n3869\t            prop = GET_UCD(fc);\n3870\t            ok = (prop->script == Lpropvalue\n3871\t                  || MAPBIT(PRIV(ucd_script_sets) + UCD_SCRIPTX_PROP(prop), Lpropvalue) != 0);\n3872\t            if (ok == (Lctype == OP_NOTPROP))\n3873\t              RRETURN(MATCH_NOMATCH);\n3874\t            }\n3875\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3876\t\n3877\t          case PT_ALNUM:\n3878\t          for (;;)\n3879\t            {\n3880\t            int category;\n3881\t            RMATCH(Fecode, RM212);\n3882\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3883\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3884\t            if (Feptr >= mb->end_subject)\n3885\t              {\n3886\t              SCHECK_PARTIAL();\n3887\t              RRETURN(MATCH_NOMATCH);\n3888\t              }\n3889\t            GETCHARINCTEST(fc, Feptr);\n3890\t            category = UCD_CATEGORY(fc);\n3891\t            if ((category == ucp_L || category == ucp_N) == (Lctype == OP_NOTPROP))\n3892\t              RRETURN(MATCH_NOMATCH);\n3893\t            }\n3894\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3895\t\n3896\t          /* Perl space used to exclude VT, but from Perl 5.18 it is included,\n3897\t          which means that Perl space and POSIX space are now identical. PCRE\n3898\t          was changed at release 8.34. */\n3899\t\n3900\t          case PT_SPACE:    /* Perl space */\n3901\t          case PT_PXSPACE:  /* POSIX space */\n3902\t          for (;;)\n3903\t            {\n3904\t            RMATCH(Fecode, RM213);\n3905\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3906\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3907\t            if (Feptr >= mb->end_subject)\n3908\t              {\n3909\t              SCHECK_PARTIAL();\n3910\t              RRETURN(MATCH_NOMATCH);\n3911\t              }\n3912\t            GETCHARINCTEST(fc, Feptr);\n3913\t            switch(fc)\n3914\t              {\n3915\t              HSPACE_CASES:\n3916\t              VSPACE_CASES:\n3917\t              if (Lctype == OP_NOTPROP) RRETURN(MATCH_NOMATCH);\n3918\t              break;\n3919\t\n3920\t              default:\n3921\t              if ((UCD_CATEGORY(fc) == ucp_Z) == (Lctype == OP_NOTPROP))\n3922\t                RRETURN(MATCH_NOMATCH);\n3923\t              break;\n3924\t              }\n3925\t            }\n3926\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3927\t\n3928\t          case PT_WORD:\n3929\t          for (;;)\n3930\t            {\n3931\t            int chartype, category;\n3932\t            RMATCH(Fecode, RM214);\n3933\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3934\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3935\t            if (Feptr >= mb->end_subject)\n3936\t              {\n3937\t              SCHECK_PARTIAL();\n3938\t              RRETURN(MATCH_NOMATCH);\n3939\t              }\n3940\t            GETCHARINCTEST(fc, Feptr);\n3941\t            chartype = UCD_CHARTYPE(fc);\n3942\t            category = PRIV(ucp_gentype)[chartype];\n3943\t            if ((category == ucp_L ||\n3944\t                 category == ucp_N ||\n3945\t                 chartype == ucp_Mn ||\n3946\t                 chartype == ucp_Pc) == (Lctype == OP_NOTPROP))\n3947\t              RRETURN(MATCH_NOMATCH);\n3948\t            }\n3949\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3950\t\n3951\t          case PT_CLIST:\n3952\t          for (;;)\n3953\t            {\n3954\t            const uint32_t *cp;\n3955\t            RMATCH(Fecode, RM215);\n3956\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3957\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3958\t            if (Feptr >= mb->end_subject)\n3959\t              {\n3960\t              SCHECK_PARTIAL();\n3961\t              RRETURN(MATCH_NOMATCH);\n3962\t              }\n3963\t            GETCHARINCTEST(fc, Feptr);\n3964\t#if PCRE2_CODE_UNIT_WIDTH == 32\n3965\t            if (fc > MAX_UTF_CODE_POINT)\n3966\t              {\n3967\t              if (Lctype == OP_NOTPROP) continue;\n3968\t              RRETURN(MATCH_NOMATCH);\n3969\t              }\n3970\t#endif\n3971\t            cp = PRIV(ucd_caseless_sets) + Lpropvalue;\n3972\t            for (;;)\n3973\t              {\n3974\t              if (fc < *cp)\n3975\t                {\n3976\t                if (Lctype == OP_NOTPROP) break;\n3977\t                RRETURN(MATCH_NOMATCH);\n3978\t                }\n3979\t              if (fc == *cp++)\n3980\t                {\n3981\t                if (Lctype == OP_NOTPROP) RRETURN(MATCH_NOMATCH);\n3982\t                break;\n3983\t                }\n3984\t              }\n3985\t            }\n3986\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n3987\t\n3988\t          case PT_UCNC:\n3989\t          for (;;)\n3990\t            {\n3991\t            RMATCH(Fecode, RM216);\n3992\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n3993\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n3994\t            if (Feptr >= mb->end_subject)\n3995\t              {\n3996\t              SCHECK_PARTIAL();\n3997\t              RRETURN(MATCH_NOMATCH);\n3998\t              }\n3999\t            GETCHARINCTEST(fc, Feptr);\n4000\t            if ((fc == CHAR_DOLLAR_SIGN || fc == CHAR_COMMERCIAL_AT ||\n4001\t                 fc == CHAR_GRAVE_ACCENT || (fc >= 0xa0 && fc <= 0xd7ff) ||\n4002\t                 fc >= 0xe000) == (Lctype == OP_NOTPROP))\n4003\t              RRETURN(MATCH_NOMATCH);\n4004\t            }\n4005\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n4006\t\n4007\t          case PT_BIDICL:\n4008\t          for (;;)\n4009\t            {\n4010\t            RMATCH(Fecode, RM223);\n4011\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4012\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n4013\t            if (Feptr >= mb->end_subject)\n4014\t              {\n4015\t              SCHECK_PARTIAL();\n4016\t              RRETURN(MATCH_NOMATCH);\n4017\t              }\n4018\t            GETCHARINCTEST(fc, Feptr);\n4019\t            if ((UCD_BIDICLASS(fc) == Lpropvalue) == (Lctype == OP_NOTPROP))\n4020\t              RRETURN(MATCH_NOMATCH);\n4021\t            }\n4022\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n4023\t\n4024\t          case PT_BOOL:\n4025\t          for (;;)\n4026\t            {\n4027\t            BOOL ok;\n4028\t            const ucd_record *prop;\n4029\t            RMATCH(Fecode, RM222);\n4030\t            if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4031\t            if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n4032\t            if (Feptr >= mb->end_subject)\n4033\t              {\n4034\t              SCHECK_PARTIAL();\n4035\t              RRETURN(MATCH_NOMATCH);\n4036\t              }\n4037\t            GETCHARINCTEST(fc, Feptr);\n4038\t            prop = GET_UCD(fc);\n4039\t            ok = MAPBIT(PRIV(ucd_boolprop_sets) +\n4040\t              UCD_BPROPS_PROP(prop), Lpropvalue) != 0;\n4041\t            if (ok == (Lctype == OP_NOTPROP))\n4042\t              RRETURN(MATCH_NOMATCH);\n4043\t            }\n4044\t          PCRE2_UNREACHABLE(); /* Control never reaches here */\n4045\t\n4046\t          /* This should never occur */\n4047\t\n4048\t          /* LCOV_EXCL_START */\n4049\t          default:\n4050\t          PCRE2_DEBUG_UNREACHABLE();\n4051\t          return PCRE2_ERROR_INTERNAL;\n4052\t          /* LCOV_EXCL_STOP */\n4053\t          }\n4054\t        }\n4055\t\n4056\t      /* Match extended Unicode sequences. We will get here only if the\n4057\t      support is in the binary; otherwise a compile-time error occurs. */\n4058\t\n4059\t      else if (Lctype == OP_EXTUNI)\n4060\t        {\n4061\t        for (;;)\n4062\t          {\n4063\t          RMATCH(Fecode, RM217);\n4064\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4065\t          if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n4066\t          if (Feptr >= mb->end_subject)\n4067\t            {\n4068\t            SCHECK_PARTIAL();\n4069\t            RRETURN(MATCH_NOMATCH);\n4070\t            }\n4071\t          else\n4072\t            {\n4073\t            GETCHARINCTEST(fc, Feptr);\n4074\t            Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject, mb->end_subject,\n4075\t              utf, NULL);\n4076\t            }\n4077\t          CHECK_PARTIAL();\n4078\t          }\n4079\t        }\n4080\t      else\n4081\t#endif     /* SUPPORT_UNICODE */\n4082\t\n4083\t      /* UTF mode for non-property testing character types. */\n4084\t\n4085\t#ifdef SUPPORT_UNICODE\n4086\t      if (utf)\n4087\t        {\n4088\t        for (;;)\n4089\t          {\n4090\t          RMATCH(Fecode, RM218);\n4091\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4092\t          if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n4093\t          if (Feptr >= mb->end_subject)\n4094\t            {\n4095\t            SCHECK_PARTIAL();\n4096\t            RRETURN(MATCH_NOMATCH);\n4097\t            }\n4098\t          if (Lctype == OP_ANY && IS_NEWLINE(Feptr)) RRETURN(MATCH_NOMATCH);\n4099\t          GETCHARINC(fc, Feptr);\n4100\t          switch(Lctype)\n4101\t            {\n4102\t            case OP_ANY:               /* This is the non-NL case */\n4103\t            if (mb->partial != 0 &&    /* Take care with CRLF partial */\n4104\t                Feptr >= mb->end_subject &&\n4105\t                NLBLOCK->nltype == NLTYPE_FIXED &&\n4106\t                NLBLOCK->nllen == 2 &&\n4107\t                fc == NLBLOCK->nl[0])\n4108\t              {\n4109\t              mb->hitend = TRUE;\n4110\t              if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n4111\t              }\n4112\t            break;\n4113\t\n4114\t            case OP_ALLANY:\n4115\t            case OP_ANYBYTE:\n4116\t            break;\n4117\t\n4118\t            case OP_ANYNL:\n4119\t            switch(fc)\n4120\t              {\n4121\t              default: RRETURN(MATCH_NOMATCH);\n4122\t\n4123\t              case CHAR_CR:\n4124\t              if (Feptr < mb->end_subject && *Feptr == CHAR_LF) Feptr++;\n4125\t              break;\n4126\t\n4127\t              case CHAR_LF:\n4128\t              break;\n4129\t\n4130\t              case CHAR_VT:\n4131\t              case CHAR_FF:\n4132\t              case CHAR_NEL:\n4133\t#ifndef EBCDIC\n4134\t              case 0x2028:\n4135\t              case 0x2029:\n4136\t#endif  /* Not EBCDIC */\n4137\t              if (mb->bsr_convention == PCRE2_BSR_ANYCRLF)\n4138\t                RRETURN(MATCH_NOMATCH);\n4139\t              break;\n4140\t              }\n4141\t            break;\n4142\t\n4143\t            case OP_NOT_HSPACE:\n4144\t            switch(fc)\n4145\t              {\n4146\t              HSPACE_CASES: RRETURN(MATCH_NOMATCH);\n4147\t              default: break;\n4148\t              }\n4149\t            break;\n4150\t\n4151\t            case OP_HSPACE:\n4152\t            switch(fc)\n4153\t              {\n4154\t              HSPACE_CASES: break;\n4155\t              default: RRETURN(MATCH_NOMATCH);\n4156\t              }\n4157\t            break;\n4158\t\n4159\t            case OP_NOT_VSPACE:\n4160\t            switch(fc)\n4161\t              {\n4162\t              VSPACE_CASES: RRETURN(MATCH_NOMATCH);\n4163\t              default: break;\n4164\t              }\n4165\t            break;\n4166\t\n4167\t            case OP_VSPACE:\n4168\t            switch(fc)\n4169\t              {\n4170\t              VSPACE_CASES: break;\n4171\t              default: RRETURN(MATCH_NOMATCH);\n4172\t              }\n4173\t            break;\n4174\t\n4175\t            case OP_NOT_DIGIT:\n4176\t            if (fc < 256 && (mb->ctypes[fc] & ctype_digit) != 0)\n4177\t              RRETURN(MATCH_NOMATCH);\n4178\t            break;\n4179\t\n4180\t            case OP_DIGIT:\n4181\t            if (fc >= 256 || (mb->ctypes[fc] & ctype_digit) == 0)\n4182\t              RRETURN(MATCH_NOMATCH);\n4183\t            break;\n4184\t\n4185\t            case OP_NOT_WHITESPACE:\n4186\t            if (fc < 256 && (mb->ctypes[fc] & ctype_space) != 0)\n4187\t              RRETURN(MATCH_NOMATCH);\n4188\t            break;\n4189\t\n4190\t            case OP_WHITESPACE:\n4191\t            if (fc >= 256 || (mb->ctypes[fc] & ctype_space) == 0)\n4192\t              RRETURN(MATCH_NOMATCH);\n4193\t            break;\n4194\t\n4195\t            case OP_NOT_WORDCHAR:\n4196\t            if (fc < 256 && (mb->ctypes[fc] & ctype_word) != 0)\n4197\t              RRETURN(MATCH_NOMATCH);\n4198\t            break;\n4199\t\n4200\t            case OP_WORDCHAR:\n4201\t            if (fc >= 256 || (mb->ctypes[fc] & ctype_word) == 0)\n4202\t              RRETURN(MATCH_NOMATCH);\n4203\t            break;\n4204\t\n4205\t            /* LCOV_EXCL_START */\n4206\t            default:\n4207\t            PCRE2_DEBUG_UNREACHABLE();\n4208\t            return PCRE2_ERROR_INTERNAL;\n4209\t            /* LCOV_EXCL_STOP */\n4210\t            }\n4211\t          }\n4212\t        }\n4213\t      else\n4214\t#endif  /* SUPPORT_UNICODE */\n4215\t\n4216\t      /* Not UTF mode */\n4217\t        {\n4218\t        for (;;)\n4219\t          {\n4220\t          RMATCH(Fecode, RM33);\n4221\t          if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n4222\t          if (Lmin++ >= Lmax) RRETURN(MATCH_NOMATCH);\n4223\t          if (Feptr >= mb->end_subject)\n4224\t            {\n4225\t            SCHECK_PARTIAL();\n4226\t            RRETURN(MATCH_NOMATCH);\n4227\t            }\n4228\t          if (Lctype == OP_ANY && IS_NEWLINE(Feptr))\n4229\t            RRETURN(MATCH_NOMATCH);\n4230\t          fc = *Feptr++;\n4231\t          switch(Lctype)\n4232\t            {\n4233\t            case OP_ANY:               /* This is the non-NL case */\n4234\t            if (mb->partial != 0 &&    /* Take care with CRLF partial */\n4235\t                Feptr >= mb->end_subject &&\n4236\t                NLBLOCK->nltype == NLTYPE_FIXED &&\n4237\t                NLBLOCK->nllen == 2 &&\n4238\t                fc == NLBLOCK->nl[0])\n4239\t              {\n4240\t              mb->hitend = TRUE;\n4241\t              if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n4242\t              }\n4243\t            break;\n4244\t\n4245\t            case OP_ALLANY:\n4246\t            case OP_ANYBYTE:\n4247\t            break;\n4248\t\n4249\t            case OP_ANYNL:\n4250\t            switch(fc)\n4251\t              {\n4252\t              default: RRETURN(MATCH_NOMATCH);\n4253\t\n4254\t              case CHAR_CR:\n4255\t              if (Feptr < mb->end_subject && *Feptr == CHAR_LF) Feptr++;\n4256\t              break;\n4257\t\n4258\t              case CHAR_LF:\n4259\t              break;\n4260\t\n4261\t              case CHAR_VT:\n4262\t              case CHAR_FF:\n4263\t              case CHAR_NEL:\n4264\t#if PCRE2_CODE_UNIT_WIDTH != 8\n4265\t              case 0x2028:\n4266\t              case 0x2029:\n4267\t#endif\n4268\t              if (mb->bsr_convention == PCRE2_BSR_ANYCRLF)\n4269\t                RRETURN(MATCH_NOMATCH);\n4270\t              break;\n4271\t              }\n4272\t            break;\n4273\t\n4274\t            case OP_NOT_HSPACE:\n4275\t            switch(fc)\n4276\t              {\n4277\t              default: break;\n4278\t              HSPACE_BYTE_CASES:\n4279\t#if PCRE2_CODE_UNIT_WIDTH != 8\n4280\t              HSPACE_MULTIBYTE_CASES:\n4281\t#endif\n4282\t              RRETURN(MATCH_NOMATCH);\n4283\t              }\n4284\t            break;\n4285\t\n4286\t            case OP_HSPACE:\n4287\t            switch(fc)\n4288\t              {\n4289\t              default: RRETURN(MATCH_NOMATCH);\n4290\t              HSPACE_BYTE_CASES:\n4291\t#if PCRE2_CODE_UNIT_WIDTH != 8\n4292\t              HSPACE_MULTIBYTE_CASES:\n4293\t#endif\n4294\t              break;\n4295\t              }\n4296\t            break;\n4297\t\n4298\t            case OP_NOT_VSPACE:\n4299\t            switch(fc)\n4300\t              {\n4301\t              default: break;\n4302\t              VSPACE_BYTE_CASES:\n4303\t#if PCRE2_CODE_UNIT_WIDTH != 8\n4304\t              VSPACE_MULTIBYTE_CASES:\n4305\t#endif\n4306\t              RRETURN(MATCH_NOMATCH);\n4307\t              }\n4308\t            break;\n4309\t\n4310\t            case OP_VSPACE:\n4311\t            switch(fc)\n4312\t              {\n4313\t              default: RRETURN(MATCH_NOMATCH);\n4314\t              VSPACE_BYTE_CASES:\n4315\t#if PCRE2_CODE_UNIT_WIDTH != 8\n4316\t              VSPACE_MULTIBYTE_CASES:\n4317\t#endif\n4318\t              break;\n4319\t              }\n4320\t            break;\n4321\t\n4322\t            case OP_NOT_DIGIT:\n4323\t            if (MAX_255(fc) && (mb->ctypes[fc] & ctype_digit) != 0)\n4324\t              RRETURN(MATCH_NOMATCH);\n4325\t            break;\n4326\t\n4327\t            case OP_DIGIT:\n4328\t            if (!MAX_255(fc) || (mb->ctypes[fc] & ctype_digit) == 0)\n4329\t              RRETURN(MATCH_NOMATCH);\n4330\t            break;\n4331\t\n4332\t            case OP_NOT_WHITESPACE:\n4333\t            if (MAX_255(fc) && (mb->ctypes[fc] & ctype_space) != 0)\n4334\t              RRETURN(MATCH_NOMATCH);\n4335\t            break;\n4336\t\n4337\t            case OP_WHITESPACE:\n4338\t            if (!MAX_255(fc) || (mb->ctypes[fc] & ctype_space) == 0)\n4339\t              RRETURN(MATCH_NOMATCH);\n4340\t            break;\n4341\t\n4342\t            case OP_NOT_WORDCHAR:\n4343\t            if (MAX_255(fc) && (mb->ctypes[fc] & ctype_word) != 0)\n4344\t              RRETURN(MATCH_NOMATCH);\n4345\t            break;\n4346\t\n4347\t            case OP_WORDCHAR:\n4348\t            if (!MAX_255(fc) || (mb->ctypes[fc] & ctype_word) == 0)\n4349\t              RRETURN(MATCH_NOMATCH);\n4350\t            break;\n4351\t\n4352\t            /* LCOV_EXCL_START */\n4353\t            default:\n4354\t            PCRE2_DEBUG_UNREACHABLE();\n4355\t            return PCRE2_ERROR_INTERNAL;\n4356\t            /* LCOV_EXCL_STOP */\n4357\t            }\n4358\t          }\n4359\t        }\n4360\t\n4361\t      PCRE2_DEBUG_UNREACHABLE(); /* Control should never reach here */\n4362\t      }\n4363\t\n4364\t    /* If maximizing, it is worth using inline code for speed, doing the type\n4365\t    test once at the start (i.e. keep it out of the loops). Once again,\n4366\t    \"notmatch\" can be an ordinary local variable because the loops do not call\n4367\t    RMATCH. */\n4368\t\n4369\t    else\n4370\t      {\n4371\t      Lstart_eptr = Feptr;  /* Remember where we started */\n4372\t\n4373\t#ifdef SUPPORT_UNICODE\n4374\t      if (proptype >= 0)\n4375\t        {\n4376\t        BOOL notmatch = Lctype == OP_NOTPROP;\n4377\t        switch(proptype)\n4378\t          {\n4379\t          case PT_LAMP:\n4380\t          for (i = Lmin; i < Lmax; i++)\n4381\t            {\n4382\t            int chartype;\n4383\t            int len = 1;\n4384\t            if (Feptr >= mb->end_subject)\n4385\t              {\n4386\t              SCHECK_PARTIAL();\n4387\t              break;\n4388\t              }\n4389\t            GETCHARLENTEST(fc, Feptr, len);\n4390\t            chartype = UCD_CHARTYPE(fc);\n4391\t            if ((chartype == ucp_Lu ||\n4392\t                 chartype == ucp_Ll ||\n4393\t                 chartype == ucp_Lt) == notmatch)\n4394\t              break;\n4395\t            Feptr+= len;\n4396\t            }\n4397\t          break;\n4398\t\n4399\t          case PT_GC:\n4400\t          for (i = Lmin; i < Lmax; i++)\n4401\t            {\n4402\t            int len = 1;\n4403\t            if (Feptr >= mb->end_subject)\n4404\t              {\n4405\t              SCHECK_PARTIAL();\n4406\t              break;\n4407\t              }\n4408\t            GETCHARLENTEST(fc, Feptr, len);\n4409\t            if ((UCD_CATEGORY(fc) == Lpropvalue) == notmatch) break;\n4410\t            Feptr+= len;\n4411\t            }\n4412\t          break;\n4413\t\n4414\t          case PT_PC:\n4415\t          for (i = Lmin; i < Lmax; i++)\n4416\t            {\n4417\t            int len = 1;\n4418\t            if (Feptr >= mb->end_subject)\n4419\t              {\n4420\t              SCHECK_PARTIAL();\n4421\t              break;\n4422\t              }\n4423\t            GETCHARLENTEST(fc, Feptr, len);\n4424\t            if ((UCD_CHARTYPE(fc) == Lpropvalue) == notmatch) break;\n4425\t            Feptr+= len;\n4426\t            }\n4427\t          break;\n4428\t\n4429\t          case PT_SC:\n4430\t          for (i = Lmin; i < Lmax; i++)\n4431\t            {\n4432\t            int len = 1;\n4433\t            if (Feptr >= mb->end_subject)\n4434\t              {\n4435\t              SCHECK_PARTIAL();\n4436\t              break;\n4437\t              }\n4438\t            GETCHARLENTEST(fc, Feptr, len);\n4439\t            if ((UCD_SCRIPT(fc) == Lpropvalue) == notmatch) break;\n4440\t            Feptr+= len;\n4441\t            }\n4442\t          break;\n4443\t\n4444\t          case PT_SCX:\n4445\t          for (i = Lmin; i < Lmax; i++)\n4446\t            {\n4447\t            BOOL ok;\n4448\t            const ucd_record *prop;\n4449\t            int len = 1;\n4450\t            if (Feptr >= mb->end_subject)\n4451\t              {\n4452\t              SCHECK_PARTIAL();\n4453\t              break;\n4454\t              }\n4455\t            GETCHARLENTEST(fc, Feptr, len);\n4456\t            prop = GET_UCD(fc);\n4457\t            ok = (prop->script == Lpropvalue ||\n4458\t                  MAPBIT(PRIV(ucd_script_sets) + UCD_SCRIPTX_PROP(prop), Lpropvalue) != 0);\n4459\t            if (ok == notmatch) break;\n4460\t            Feptr+= len;\n4461\t            }\n4462\t          break;\n4463\t\n4464\t          case PT_ALNUM:\n4465\t          for (i = Lmin; i < Lmax; i++)\n4466\t            {\n4467\t            int category;\n4468\t            int len = 1;\n4469\t            if (Feptr >= mb->end_subject)\n4470\t              {\n4471\t              SCHECK_PARTIAL();\n4472\t              break;\n4473\t              }\n4474\t            GETCHARLENTEST(fc, Feptr, len);\n4475\t            category = UCD_CATEGORY(fc);\n4476\t            if ((category == ucp_L || category == ucp_N) == notmatch)\n4477\t              break;\n4478\t            Feptr+= len;\n4479\t            }\n4480\t          break;\n4481\t\n4482\t          /* Perl space used to exclude VT, but from Perl 5.18 it is included,\n4483\t          which means that Perl space and POSIX space are now identical. PCRE\n4484\t          was changed at release 8.34. */\n4485\t\n4486\t          case PT_SPACE:    /* Perl space */\n4487\t          case PT_PXSPACE:  /* POSIX space */\n4488\t          for (i = Lmin; i < Lmax; i++)\n4489\t            {\n4490\t            int len = 1;\n4491\t            if (Feptr >= mb->end_subject)\n4492\t              {\n4493\t              SCHECK_PARTIAL();\n4494\t              break;\n4495\t              }\n4496\t            GETCHARLENTEST(fc, Feptr, len);\n4497\t            switch(fc)\n4498\t              {\n4499\t              HSPACE_CASES:\n4500\t              VSPACE_CASES:\n4501\t              if (notmatch) goto ENDLOOP99;  /* Break the loop */\n4502\t              break;\n4503\t\n4504\t              default:\n4505\t              if ((UCD_CATEGORY(fc) == ucp_Z) == notmatch)\n4506\t                goto ENDLOOP99;   /* Break the loop */\n4507\t              break;\n4508\t              }\n4509\t            Feptr+= len;\n4510\t            }\n4511\t          ENDLOOP99:\n4512\t          break;\n4513\t\n4514\t          case PT_WORD:\n4515\t          for (i = Lmin; i < Lmax; i++)\n4516\t            {\n4517\t            int chartype, category;\n4518\t            int len = 1;\n4519\t            if (Feptr >= mb->end_subject)\n4520\t              {\n4521\t              SCHECK_PARTIAL();\n4522\t              break;\n4523\t              }\n4524\t            GETCHARLENTEST(fc, Feptr, len);\n4525\t            chartype = UCD_CHARTYPE(fc);\n4526\t            category = PRIV(ucp_gentype)[chartype];\n4527\t            if ((category == ucp_L ||\n4528\t                 category == ucp_N ||\n4529\t                 chartype == ucp_Mn ||\n4530\t                 chartype == ucp_Pc) == notmatch)\n4531\t              break;\n4532\t            Feptr+= len;\n4533\t            }\n4534\t          break;\n4535\t\n4536\t          case PT_CLIST:\n4537\t          for (i = Lmin; i < Lmax; i++)\n4538\t            {\n4539\t            const uint32_t *cp;\n4540\t            int len = 1;\n4541\t            if (Feptr >= mb->end_subject)\n4542\t              {\n4543\t              SCHECK_PARTIAL();\n4544\t              break;\n4545\t              }\n4546\t            GETCHARLENTEST(fc, Feptr, len);\n4547\t#if PCRE2_CODE_UNIT_WIDTH == 32\n4548\t            if (fc > MAX_UTF_CODE_POINT)\n4549\t              {\n4550\t              if (!notmatch) goto GOT_MAX;\n4551\t              }\n4552\t            else\n4553\t#endif\n4554\t              {\n4555\t              cp = PRIV(ucd_caseless_sets) + Lpropvalue;\n4556\t              for (;;)\n4557\t                {\n4558\t                if (fc < *cp)\n4559\t                  { if (notmatch) break; else goto GOT_MAX; }\n4560\t                if (fc == *cp++)\n4561\t                  { if (notmatch) goto GOT_MAX; else break; }\n4562\t                }\n4563\t              }\n4564\t\n4565\t            Feptr += len;\n4566\t            }\n4567\t          GOT_MAX:\n4568\t          break;\n4569\t\n4570\t          case PT_UCNC:\n4571\t          for (i = Lmin; i < Lmax; i++)\n4572\t            {\n4573\t            int len = 1;\n4574\t            if (Feptr >= mb->end_subject)\n4575\t              {\n4576\t              SCHECK_PARTIAL();\n4577\t              break;\n4578\t              }\n4579\t            GETCHARLENTEST(fc, Feptr, len);\n4580\t            if ((fc == CHAR_DOLLAR_SIGN || fc == CHAR_COMMERCIAL_AT ||\n4581\t                 fc == CHAR_GRAVE_ACCENT || (fc >= 0xa0 && fc <= 0xd7ff) ||\n4582\t                 fc >= 0xe000) == notmatch)\n4583\t              break;\n4584\t            Feptr += len;\n4585\t            }\n4586\t          break;\n4587\t\n4588\t          case PT_BIDICL:\n4589\t          for (i = Lmin; i < Lmax; i++)\n4590\t            {\n4591\t            int len = 1;\n4592\t            if (Feptr >= mb->end_subject)\n4593\t              {\n4594\t              SCHECK_PARTIAL();\n4595\t              break;\n4596\t              }\n4597\t            GETCHARLENTEST(fc, Feptr, len);\n4598\t            if ((UCD_BIDICLASS(fc) == Lpropvalue) == notmatch) break;\n4599\t            Feptr+= len;\n4600\t            }\n4601\t          break;\n4602\t\n4603\t          case PT_BOOL:\n4604\t          for (i = Lmin;