55\t    break;\n5856\t\n5857\t\n5858\t    /* ===================================================================== */\n5859\t    /* Handle scan substring operation. */\n5860\t\n5861\t#define Lsaved_end_subject   F->fields.op_assert_scs.saved_end_subject\n5862\t#define Lsaved_eptr          F->fields.op_assert_scs.saved_eptr\n5863\t#define Ltrue_end_extra      F->fields.op_assert_scs.true_end_extra\n5864\t#define Lextra_size          F->fields.op_assert_scs.extra_size\n5865\t#define Lsaved_moptions      F->fields.op_assert_scs.saved_moptions\n5866\t\n5867\t    case OP_ASSERT_SCS:\n5868\t    length = 0;\n5869\t      {\n5870\t      PCRE2_SPTR ecode = Fecode + 1 + LINK_SIZE;\n5871\t      int count;\n5872\t      PCRE2_SPTR slot;\n5873\t\n5874\t      /* Disable compiler warning. */\n5875\t      offset = 0;\n5876\t      (void)offset;\n5877\t\n5878\t      for (;;)\n5879\t        {\n5880\t        if (*ecode == OP_CREF)\n5881\t          {\n5882\t          length += 1+IMM2_SIZE;\n5883\t          offset = (GET2(ecode, 1) << 1) - 2;\n5884\t          ecode += 1+IMM2_SIZE;\n5885\t          if (offset < Foffset_top && Fovector[offset] != PCRE2_UNSET)\n5886\t            goto SCS_OFFSET_FOUND;\n5887\t          continue;\n5888\t          }\n5889\t\n5890\t        if (*ecode != OP_DNCREF) RRETURN(MATCH_NOMATCH);\n5891\t\n5892\t        count = GET2(ecode, 1 + IMM2_SIZE);\n5893\t        slot = mb->name_table + GET2(ecode, 1) * mb->name_entry_size;\n5894\t        length += 1+2*IMM2_SIZE;\n5895\t        ecode += 1+2*IMM2_SIZE;\n5896\t\n5897\t        while (count > 0)\n5898\t          {\n5899\t          offset = (GET2(slot, 0) << 1) - 2;\n5900\t          if (offset < Foffset_top && Fovector[offset] != PCRE2_UNSET)\n5901\t            goto SCS_OFFSET_FOUND;\n5902\t          slot += mb->name_entry_size;\n5903\t          count--;\n5904\t          }\n5905\t        }\n5906\t\n5907\t      SCS_OFFSET_FOUND:\n5908\t\n5909\t      /* Skip remaining options. */\n5910\t      for (;;)\n5911\t        {\n5912\t        if (*ecode == OP_CREF)\n5913\t          {\n5914\t          length += 1+IMM2_SIZE;\n5915\t          ecode += 1+IMM2_SIZE;\n5916\t          }\n5917\t        else if (*ecode == OP_DNCREF)\n5918\t          {\n5919\t          length += 1+2*IMM2_SIZE;\n5920\t          ecode += 1+2*IMM2_SIZE;\n5921\t          }\n5922\t        else break;\n5923\t        }\n5924\t      }\n5925\t\n5926\t    Lsaved_end_subject = mb->end_subject;\n5927\t    Ltrue_end_extra = mb->true_end_subject - mb->end_subject;\n5928\t    Lsaved_eptr = Feptr;\n5929\t    Lsaved_moptions = mb->moptions;\n5930\t\n5931\t    Feptr = mb->start_subject + Fovector[offset];\n5932\t    mb->true_end_subject = mb->end_subject =\n5933\t      mb->start_subject + Fovector[offset + 1];\n5934\t    mb->moptions &= ~PCRE2_NOTEOL;\n5935\t\n5936\t    for (;;)\n5937\t      {\n5938\t      group_frame_type = GF_NOCAPTURE;\n5939\t      RMATCH(Fecode + 1 + LINK_SIZE + length, RM38);\n5940\t      if (rrc == MATCH_ACCEPT)\n5941\t        {\n5942\t        memcpy(Fovector,\n5943\t              (char *)assert_accept_frame + offsetof(heapframe, ovector),\n5944\t              assert_accept_frame->offset_top * sizeof(PCRE2_SIZE));\n5945\t        Foffset_top = assert_accept_frame->offset_top;\n5946\t        Fmark = assert_accept_frame->mark;\n5947\t        mb->end_subject = Lsaved_end_subject;\n5948\t        mb->true_end_subject = mb->end_subject + Ltrue_end_extra;\n5949\t        mb->moptions = Lsaved_moptions;\n5950\t        break;\n5951\t        }\n5952\t\n5953\t      if (rrc != MATCH_NOMATCH && rrc != MATCH_THEN)\n5954\t        {\n5955\t        mb->end_subject = Lsaved_end_subject;\n5956\t        mb->true_end_subject = mb->end_subject + Ltrue_end_extra;\n5957\t        mb->moptions = Lsaved_moptions;\n5958\t        RRETURN(rrc);\n5959\t        }\n5960\t\n5961\t      Fecode += GET(Fecode, 1);\n5962\t      if (*Fecode != OP_ALT)\n5963\t        {\n5964\t        mb->end_subject = Lsaved_end_subject;\n5965\t        mb->true_end_subject = mb->end_subject + Ltrue_end_extra;\n5966\t        mb->moptions = Lsaved_moptions;\n5967\t        RRETURN(MATCH_NOMATCH);\n5968\t        }\n5969\t      length = 0;\n5970\t      }\n5971\t\n5972\t    do Fecode += GET(Fecode, 1); while (*Fecode == OP_ALT);\n5973\t    Fecode += 1 + LINK_SIZE;\n5974\t    Feptr = Lsaved_eptr;\n5975\t    break;\n5976\t\n5977\t#undef Lsaved_end_subject\n5978\t#undef Lsaved_eptr\n5979\t#undef Ltrue_end_extra\n5980\t#undef Lextra_size\n5981\t#undef Lsave_moptions\n5982\t\n5983\t\n5984\t    /* ===================================================================== */\n5985\t    /* The callout item calls an external function, if one is provided, passing\n5986\t    details of the match so far. This is mainly for debugging, though the\n5987\t    function is able to force a failure. */\n5988\t\n5989\t    case OP_CALLOUT:\n5990\t    case OP_CALLOUT_STR:\n5991\t    rrc = do_callout(F, mb, &length);\n5992\t    if (rrc > 0) RRETURN(MATCH_NOMATCH);\n5993\t    if (rrc < 0) RRETURN(rrc);\n5994\t    Fecode += length;\n5995\t    break;\n5996\t\n5997\t\n5998\t    /* ===================================================================== */\n5999\t    /* Conditional group: compilation checked that there are no more than two\n6000\t    branches. If the condition is false, skipping the first branch takes us\n6001\t    past the end of the item if there is only one branch, but that's exactly\n6002\t    what we want. */\n6003\t\n6004\t#define Lstart_branch  F->fields.op_cond.start_branch\n6005\t#define Llength        F->fields.op_cond.length\n6006\t#define Lpositive      F->byte1\n6007\t\n6008\t    case OP_COND:\n6009\t    case OP_SCOND:\n6010\t\n6011\t    /* The variable Llength will be added to Fecode when the condition is\n6012\t    false, to get to the second branch. Setting it to the offset to the ALT or\n6013\t    KET, then incrementing Fecode achieves this effect. However, if the second\n6014\t    branch is non-existent, we must point to the KET so that the end of the\n6015\t    group is correctly processed. We now have Fecode pointing to the condition\n6016\t    or callout. */\n6017\t\n6018\t    Llength = GET(Fecode, 1);    /* Offset to the second branch */\n6019\t    if (Fecode[Llength] != OP_ALT) Llength -= 1 + LINK_SIZE;\n6020\t    Fecode += 1 + LINK_SIZE;     /* From this opcode */\n6021\t\n6022\t    /* Because of the way auto-callout works during compile, a callout item is\n6023\t    inserted between OP_COND and an assertion condition. Such a callout can\n6024\t    also be inserted manually. */\n6025\t\n6026\t    if (*Fecode == OP_CALLOUT || *Fecode == OP_CALLOUT_STR)\n6027\t      {\n6028\t      rrc = do_callout(F, mb, &length);\n6029\t      if (rrc > 0) RRETURN(MATCH_NOMATCH);\n6030\t      if (rrc < 0) RRETURN(rrc);\n6031\t\n6032\t      /* Advance Fecode past the callout, so it now points to the condition. We\n6033\t      must adjust Llength so that the value of Fecode+Llength is unchanged. */\n6034\t\n6035\t      Fecode += length;\n6036\t      Llength -= length;\n6037\t      }\n6038\t\n6039\t    /* Test the various possible conditions */\n6040\t\n6041\t    condition = FALSE;\n6042\t    switch(*Fecode)\n6043\t      {\n6044\t      case OP_RREF:                  /* Group recursion test */\n6045\t      if (Fcurrent_recurse != RECURSE_UNSET)\n6046\t        {\n6047\t        number = GET2(Fecode, 1);\n6048\t        condition = (number == RREF_ANY || number == Fcurrent_recurse);\n6049\t        }\n6050\t      break;\n6051\t\n6052\t      case OP_DNRREF:       /* Duplicate named group recursion test */\n6053\t      if (Fcurrent_recurse != RECURSE_UNSET)\n6054\t        {\n6055\t        int count = GET2(Fecode, 1 + IMM2_SIZE);\n6056\t        PCRE2_SPTR slot = mb->name_table + GET2(Fecode, 1) * mb->name_entry_size;\n6057\t        while (count-- > 0)\n6058\t          {\n6059\t          number = GET2(slot, 0);\n6060\t          condition = number == Fcurrent_recurse;\n6061\t          if (condition) break;\n6062\t          slot += mb->name_entry_size;\n6063\t          }\n6064\t        }\n6065\t      break;\n6066\t\n6067\t      case OP_CREF:                         /* Numbered group used test */\n6068\t      offset = (GET2(Fecode, 1) << 1) - 2;  /* Doubled ref number */\n6069\t      condition = offset < Foffset_top && Fovector[offset] != PCRE2_UNSET;\n6070\t      break;\n6071\t\n6072\t      case OP_DNCREF:      /* Duplicate named group used test */\n6073\t        {\n6074\t        int count = GET2(Fecode, 1 + IMM2_SIZE);\n6075\t        PCRE2_SPTR slot = mb->name_table + GET2(Fecode, 1) * mb->name_entry_size;\n6076\t        while (count-- > 0)\n6077\t          {\n6078\t          offset = (GET2(slot, 0) << 1) - 2;\n6079\t          condition = offset < Foffset_top && Fovector[offset] != PCRE2_UNSET;\n6080\t          if (condition) break;\n6081\t          slot += mb->name_entry_size;\n6082\t          }\n6083\t        }\n6084\t      break;\n6085\t\n6086\t      case OP_FALSE:\n6087\t      case OP_FAIL:   /* The assertion (?!) becomes OP_FAIL */\n6088\t      break;\n6089\t\n6090\t      case OP_TRUE:\n6091\t      condition = TRUE;\n6092\t      break;\n6093\t\n6094\t      /* The condition is an assertion. Run code similar to the assertion code\n6095\t      above. */\n6096\t\n6097\t\n6098\t      default:\n6099\t      Lpositive = (uint8_t)(*Fecode == OP_ASSERT || *Fecode == OP_ASSERTBACK);\n6100\t      Lstart_branch = Fecode;\n6101\t\n6102\t      for (;;)\n6103\t        {\n6104\t        group_frame_type = GF_CONDASSERT;\n6105\t        RMATCH(Lstart_branch + PRIV(OP_lengths)[*Lstart_branch], RM5);\n6106\t\n6107\t        switch(rrc)\n6108\t          {\n6109\t          case MATCH_ACCEPT:  /* Save captures */\n6110\t          memcpy(Fovector,\n6111\t                (char *)assert_accept_frame + offsetof(heapframe, ovector),\n6112\t                assert_accept_frame->offset_top * sizeof(PCRE2_SIZE));\n6113\t          Foffset_top = assert_accept_frame->offset_top;\n6114\t\n6115\t          PCRE2_FALLTHROUGH /* Fall through */\n6116\t          /* In the case of a match, the captures have already been put into\n6117\t          the current frame. */\n6118\t\n6119\t          case MATCH_MATCH:\n6120\t          condition = Lpositive;   /* TRUE for positive assertion */\n6121\t          break;\n6122\t\n6123\t          /* PCRE doesn't allow the effect of (*THEN) to escape beyond an\n6124\t          assertion; it is therefore always treated as NOMATCH. */\n6125\t\n6126\t          case MATCH_NOMATCH:\n6127\t          case MATCH_THEN:\n6128\t          Lstart_branch += GET(Lstart_branch, 1);\n6129\t          if (*Lstart_branch == OP_ALT) continue;  /* Try next branch */\n6130\t          condition = !Lpositive;  /* TRUE for negative assertion */\n6131\t          break;\n6132\t\n6133\t          /* These force no match without checking other branches. */\n6134\t\n6135\t          case MATCH_COMMIT:\n6136\t          case MATCH_SKIP:\n6137\t          case MATCH_PRUNE:\n6138\t          condition = !Lpositive;\n6139\t          break;\n6140\t\n6141\t          default:\n6142\t          RRETURN(rrc);\n6143\t          }\n6144\t        break;  /* Out of the branch loop */\n6145\t        }\n6146\t\n6147\t      /* If the condition is true, find the end of the assertion so that\n6148\t      advancing past it gets us to the start of the first branch. */\n6149\t\n6150\t      if (condition)\n6151\t        {\n6152\t        do Fecode += GET(Fecode, 1); while (*Fecode == OP_ALT);\n6153\t        }\n6154\t      break;  /* End of assertion condition */\n6155\t      }\n6156\t\n6157\t    /* Choose branch according to the condition. */\n6158\t\n6159\t    Fecode += condition? PRIV(OP_lengths)[*Fecode] : Llength;\n6160\t\n6161\t    /* If the opcode is OP_SCOND it means we are at a repeated conditional\n6162\t    group that might match an empty string. We must therefore descend a level\n6163\t    so that the start is remembered for checking. For OP_COND we can just\n6164\t    continue at this level. */\n6165\t\n6166\t    if (Fop == OP_SCOND)\n6167\t      {\n6168\t      group_frame_type = GF_NOCAPTURE;\n6169\t      RMATCH(Fecode, RM35);\n6170\t      RRETURN(rrc);\n6171\t      }\n6172\t    break;\n6173\t\n6174\t#undef Lstart_branch\n6175\t#undef Llength\n6176\t#undef Lpositive\n6177\t\n6178\t\n6179\t/* ========================================================================= */\n6180\t/*                  End of start of parenthesis opcodes                      */\n6181\t/* ========================================================================= */\n6182\t\n6183\t\n6184\t    /* ===================================================================== */\n6185\t    /* Move the subject pointer back by one fixed amount. This occurs at the\n6186\t    start of each branch that has a fixed length in a lookbehind assertion. If\n6187\t    we are too close to the start to move back, fail. When working with UTF-8\n6188\t    we move back a number of characters, not bytes. */\n6189\t\n6190\t    case OP_REVERSE:\n6191\t    number = GET2(Fecode, 1);\n6192\t#ifdef SUPPORT_UNICODE\n6193\t    if (utf)\n6194\t      {\n6195\t      /* We used to do a simpler `while (number-- > 0)` but that triggers\n6196\t      clang's unsigned integer overflow sanitizer. */\n6197\t      while (number > 0)\n6198\t        {\n6199\t        --number;\n6200\t        if (Feptr <= mb->check_subject) RRETURN(MATCH_NOMATCH);\n6201\t        Feptr--;\n6202\t        BACKCHAR(Feptr);\n6203\t        }\n6204\t      }\n6205\t    else\n6206\t#endif\n6207\t\n6208\t    /* No UTF support, or not in UTF mode: count is code unit count */\n6209\t\n6210\t      {\n6211\t      if ((ptrdiff_t)number > Feptr - mb->start_subject) RRETURN(MATCH_NOMATCH);\n6212\t      Feptr -= number;\n6213\t      }\n6214\t\n6215\t    /* Save the earliest consulted character, then skip to next opcode */\n6216\t\n6217\t    if (Feptr < mb->start_used_ptr) mb->start_used_ptr = Feptr;\n6218\t    Fecode += 1 + IMM2_SIZE;\n6219\t    break;\n6220\t\n6221\t\n6222\t    /* ===================================================================== */\n6223\t    /* Move the subject pointer back by a variable amount. This occurs at the\n6224\t    start of each branch of a lookbehind assertion when the branch has a\n6225\t    variable, but limited, length. A loop is needed to try matching the branch\n6226\t    after moving back different numbers of characters. If we are too close to\n6227\t    the start to move back even the minimum amount, fail. When working with\n6228\t    UTF-8 we move back a number of characters, not bytes. */\n6229\t\n6230\t#define Lmin    F->fields.op_vreverse.min\n6231\t#define Lmax    F->fields.op_vreverse.max\n6232\t\n6233\t    case OP_VREVERSE:\n6234\t    Lmin = GET2(Fecode, 1);\n6235\t    Lmax = GET2(Fecode, 1 + IMM2_SIZE);\n6236\t\n6237\t    /* Move back by the maximum branch length and then work forwards. This\n6238\t    ensures that items such as \\d{3,5} get the maximum length, which is\n6239\t    relevant for captures, and makes for Perl compatibility. */\n6240\t\n6241\t#ifdef SUPPORT_UNICODE\n6242\t    if (utf)\n6243\t      {\n6244\t      for (i = 0; i < Lmax; i++)\n6245\t        {\n6246\t        if (Feptr == mb->start_subject)\n6247\t          {\n6248\t          if (i < Lmin) RRETURN(MATCH_NOMATCH);\n6249\t          Lmax = i;\n6250\t          break;\n6251\t          }\n6252\t        Feptr--;\n6253\t        BACKCHAR(Feptr);\n6254\t        }\n6255\t      }\n6256\t    else\n6257\t#endif\n6258\t\n6259\t    /* No UTF support or not in UTF mode */\n6260\t\n6261\t      {\n6262\t      ptrdiff_t diff = Feptr - mb->start_subject;\n6263\t      uint32_t available = (diff > 65535)? 65535 : ((diff > 0)? (int)diff : 0);\n6264\t      if (Lmin > available) RRETURN(MATCH_NOMATCH);\n6265\t      if (Lmax > available) Lmax = available;\n6266\t      Feptr -= Lmax;\n6267\t      }\n6268\t\n6269\t    /* Now try matching, moving forward one character on failure, until we\n6270\t    reach the minimum back length. */\n6271\t\n6272\t    for (;;)\n6273\t      {\n6274\t      RMATCH(Fecode + 1 + 2 * IMM2_SIZE, RM37);\n6275\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6276\t      if (Lmax-- <= Lmin) RRETURN(MATCH_NOMATCH);\n6277\t      Feptr++;\n6278\t#ifdef SUPPORT_UNICODE\n6279\t      if (utf) { FORWARDCHARTEST(Feptr, mb->end_subject); }\n6280\t#endif\n6281\t      }\n6282\t    PCRE2_UNREACHABLE(); /* Control never reaches here */\n6283\t\n6284\t#undef Lmin\n6285\t#undef Lmax\n6286\t\n6287\t\n6288\t    /* ===================================================================== */\n6289\t    /* An alternation is the end of a branch; scan along to find the end of the\n6290\t    bracketed group. */\n6291\t\n6292\t    case OP_ALT:\n6293\t    branch_end = Fecode;\n6294\t    do Fecode += GET(Fecode,1); while (*Fecode == OP_ALT);\n6295\t    break;\n6296\t\n6297\t\n6298\t    /* ===================================================================== */\n6299\t    /* The end of a parenthesized group. For all but OP_BRA and OP_COND, the\n6300\t    starting frame was added to the chained frames in order to remember the\n6301\t    starting subject position for the group. (Not true for OP_BRA when it's a\n6302\t    whole pattern recursion, but that is handled separately below.)*/\n6303\t\n6304\t    case OP_KET:\n6305\t    case OP_KETRMIN:\n6306\t    case OP_KETRMAX:\n6307\t    case OP_KETRPOS:\n6308\t\n6309\t    bracode = Fecode - GET(Fecode, 1);\n6310\t\n6311\t    if (branch_end == NULL) branch_end = Fecode;\n6312\t    branch_start = bracode;\n6313\t    while (branch_start + GET(branch_start, 1) != branch_end)\n6314\t      branch_start += GET(branch_start, 1);\n6315\t    branch_end = NULL;\n6316\t\n6317\t    /* Point N to the frame at the start of the most recent group, and P to its\n6318\t    predecessor. Remember the subject pointer at the start of the group. */\n6319\t\n6320\t    if (*bracode != OP_BRA && *bracode != OP_COND)\n6321\t      {\n6322\t      N = (heapframe *)((char *)match_data->heapframes + Flast_group_offset);\n6323\t      P = (heapframe *)((char *)N - frame_size);\n6324\t      Flast_group_offset = P->last_group_offset;\n6325\t\n6326\t#ifdef DEBUG_SHOW_RMATCH\n6327\t      fprintf(stderr, \"++ KET for frame=%d type=%x prev char offset=%lu\\n\",\n6328\t        N->rdepth, N->group_frame_type,\n6329\t        (char *)P->eptr - (char *)mb->start_subject);\n6330\t#endif\n6331\t\n6332\t      /* If we are at the end of an assertion that is a condition, first check\n6333\t      to see if we are at the end of a variable-length branch in a lookbehind.\n6334\t      If this is the case and we have not landed on the current character,\n6335\t      return no match. Compare code below for non-condition lookbehinds. In\n6336\t      other cases, return a match, discarding any intermediate backtracking\n6337\t      points. Copy back the mark setting and the captures into the frame before\n6338\t      N so that they are set on return. Doing this for all assertions, both\n6339\t      positive and negative, seems to match what Perl does. */\n6340\t\n6341\t      if (N->group_frame_type == GF_CONDASSERT)\n6342\t        {\n6343\t        if ((*bracode == OP_ASSERTBACK || *bracode == OP_ASSERTBACK_NOT) &&\n6344\t            branch_start[1 + LINK_SIZE] == OP_VREVERSE && Feptr != P->eptr)\n6345\t          RRETURN(MATCH_NOMATCH);\n6346\t        memcpy((char *)P + offsetof(heapframe, ovector), Fovector,\n6347\t          Foffset_top * sizeof(PCRE2_SIZE));\n6348\t        P->offset_top = Foffset_top;\n6349\t        P->mark = Fmark;\n6350\t        Fback_frame = (char *)F - (char *)P;\n6351\t        RRETURN(MATCH_MATCH);\n6352\t        }\n6353\t      }\n6354\t    else P = NULL;   /* Indicates starting frame not recorded */\n6355\t\n6356\t    /* The group was not a conditional assertion. */\n6357\t\n6358\t    switch (*bracode)\n6359\t      {\n6360\t      /* Whole pattern recursion is handled as a recursion into group 0, but\n6361\t      the entire pattern is wrapped in OP_BRA/OP_KET rather than a capturing\n6362\t      group - a design mistake: it should perhaps have been capture group 0.\n6363\t      Anyway, that means the end of such recursion must be handled here. It is\n6364\t      detected by checking for an immediately following OP_END when we are\n6365\t      recursing in group 0. If this is not the end of a whole-pattern\n6366\t      recursion, there is nothing to be done. */\n6367\t\n6368\t      case OP_BRA:\n6369\t      if (Fcurrent_recurse != 0 || Fecode[1+LINK_SIZE] != OP_END) break;\n6370\t\n6371\t      /* It is the end of whole-pattern recursion. */\n6372\t\n6373\t      offset = Flast_group_offset;\n6374\t\n6375\t      /* Corrupted heapframes?. Trigger an assert and return an error */\n6376\t      PCRE2_ASSERT(offset != PCRE2_UNSET);\n6377\t      if (offset == PCRE2_UNSET) return PCRE2_ERROR_INTERNAL;\n6378\t\n6379\t      N = (heapframe *)((char *)match_data->heapframes + offset);\n6380\t      P = (heapframe *)((char *)N - frame_size);\n6381\t      Flast_group_offset = P->last_group_offset;\n6382\t\n6383\t      /* Reinstate the previous set of captures and then carry on after the\n6384\t      recursion call. */\n6385\t\n6386\t      Fecode = P->ecode + 1 + LINK_SIZE;\n6387\t\n6388\t      if (*Fecode != OP_CREF)\n6389\t        {\n6390\t        memcpy(F->ovector, P->ovector, Foffset_top * sizeof(PCRE2_SIZE));\n6391\t        Foffset_top = P->offset_top;\n6392\t        }\n6393\t      else\n6394\t        recurse_update_offsets(F, P);\n6395\t\n6396\t      Fcapture_last = P->capture_last;\n6397\t      Fcurrent_recurse = P->current_recurse;\n6398\t      continue;  /* With next opcode */\n6399\t\n6400\t      case OP_COND:     /* No need to do anything for these */\n6401\t      case OP_SCOND:\n6402\t      break;\n6403\t\n6404\t      /* Non-atomic positive assertions are like OP_BRA, except that the\n6405\t      subject pointer must be put back to where it was at the start of the\n6406\t      assertion. For a variable lookbehind, check its end point. */\n6407\t\n6408\t      case OP_ASSERTBACK_NA:\n6409\t      if (branch_start[1 + LINK_SIZE] == OP_VREVERSE && Feptr != P->eptr)\n6410\t        RRETURN(MATCH_NOMATCH);\n6411\t      PCRE2_FALLTHROUGH /* Fall through */\n6412\t\n6413\t      case OP_ASSERT_NA:\n6414\t      if (Feptr > mb->last_used_ptr) mb->last_used_ptr = Feptr;\n6415\t      Feptr = P->eptr;\n6416\t      break;\n6417\t\n6418\t      /* Atomic positive assertions are like OP_ONCE, except that in addition\n6419\t      the subject pointer must be put back to where it was at the start of the\n6420\t      assertion. For a variable lookbehind, check its end point. */\n6421\t\n6422\t      case OP_ASSERTBACK:\n6423\t      if (branch_start[1 + LINK_SIZE] == OP_VREVERSE && Feptr != P->eptr)\n6424\t        RRETURN(MATCH_NOMATCH);\n6425\t      PCRE2_FALLTHROUGH /* Fall through */\n6426\t\n6427\t      case OP_ASSERT:\n6428\t      if (Feptr > mb->last_used_ptr) mb->last_used_ptr = Feptr;\n6429\t      Feptr = P->eptr;\n6430\t      PCRE2_FALLTHROUGH /* Fall through */\n6431\t\n6432\t      /* For an atomic group, discard internal backtracking points. We must\n6433\t      also ensure that any remaining branches within the top-level of the group\n6434\t      are not tried. Do this by adjusting the code pointer within the backtrack\n6435\t      frame so that it points to the final branch. */\n6436\t\n6437\t      case OP_ONCE:\n6438\t      Fback_frame = ((char *)F - (char *)P);\n6439\t      for (;;)\n6440\t        {\n6441\t        uint32_t y = GET(P->ecode,1);\n6442\t        if ((P->ecode)[y] != OP_ALT) break;\n6443\t        P->ecode += y;\n6444\t        }\n6445\t      break;\n6446\t\n6447\t      /* A matching negative assertion returns MATCH, which is turned into\n6448\t      NOMATCH at the assertion level. For a variable lookbehind, check its end\n6449\t      point. */\n6450\t\n6451\t      case OP_ASSERTBACK_NOT:\n6452\t      if (branch_start[1 + LINK_SIZE] == OP_VREVERSE && Feptr != P->eptr)\n6453\t        RRETURN(MATCH_NOMATCH);\n6454\t      PCRE2_FALLTHROUGH /* Fall through */\n6455\t\n6456\t      case OP_ASSERT_NOT:\n6457\t      RRETURN(MATCH_MATCH);\n6458\t\n6459\t      /* A scan substring group must preserve the current end_subject,\n6460\t      and restore it before the backtracking is performed into its sub\n6461\t      pattern. */\n6462\t\n6463\t      case OP_ASSERT_SCS:\n6464\t      F->fields.op_assert_scs.saved_end_subject = mb->end_subject;\n6465\t      mb->end_subject = P->fields.op_assert_scs.saved_end_subject;\n6466\t      mb->true_end_subject = mb->end_subject + P->fields.op_assert_scs.true_end_extra;\n6467\t      Feptr = P->fields.op_assert_scs.saved_eptr;\n6468\t\n6469\t      RMATCH(Fecode + 1 + LINK_SIZE, RM39);\n6470\t\n6471\t      mb->end_subject = F->fields.op_assert_scs.saved_end_subject;\n6472\t      mb->true_end_subject = mb->end_subject;\n6473\t      RRETURN(rrc);\n6474\t      break;\n6475\t\n6476\t      /* At the end of a script run, apply the script-checking rules. This code\n6477\t      will never by exercised if Unicode support it not compiled, because in\n6478\t      that environment script runs cause an error at compile time. */\n6479\t\n6480\t      case OP_SCRIPT_RUN:\n6481\t      if (!PRIV(script_run)(P->eptr, Feptr, utf)) RRETURN(MATCH_NOMATCH);\n6482\t      break;\n6483\t\n6484\t      /* Whole-pattern recursion is coded as a recurse into group 0, and is\n6485\t      handled with OP_BRA above. Other recursion is handled here. */\n6486\t\n6487\t      case OP_CBRA:\n6488\t      case OP_CBRAPOS:\n6489\t      case OP_SCBRA:\n6490\t      case OP_SCBRAPOS:\n6491\t      number = GET2(bracode, 1+LINK_SIZE);\n6492\t\n6493\t      /* Handle a recursively called group. We reinstate the previous set of\n6494\t      captures and then carry on after the recursion call. */\n6495\t\n6496\t      if (Fcurrent_recurse == number)\n6497\t        {\n6498\t        P = (heapframe *)((char *)N - frame_size);\n6499\t        Fecode = P->ecode + 1 + LINK_SIZE;\n6500\t\n6501\t        if (*Fecode != OP_CREF)\n6502\t          {\n6503\t          memcpy(F->ovector, P->ovector, Foffset_top * sizeof(PCRE2_SIZE));\n6504\t          Foffset_top = P->offset_top;\n6505\t          }\n6506\t        else\n6507\t          recurse_update_offsets(F, P);\n6508\t\n6509\t        Fcapture_last = P->capture_last;\n6510\t        Fcurrent_recurse = P->current_recurse;\n6511\t        continue;  /* With next opcode */\n6512\t        }\n6513\t\n6514\t      /* Deal with actual capturing. */\n6515\t\n6516\t      offset = (number << 1) - 2;\n6517\t      Fcapture_last = number;\n6518\t      Fovector[offset] = P->eptr - mb->start_subject;\n6519\t      Fovector[offset+1] = Feptr - mb->start_subject;\n6520\t      if (offset >= Foffset_top) Foffset_top = offset + 2;\n6521\t      break;\n6522\t      }  /* End actions relating to the starting opcode */\n6523\t\n6524\t    /* OP_KETRPOS is a possessive repeating ket. Remember the current position,\n6525\t    and return the MATCH_KETRPOS. This makes it possible to do the repeats one\n6526\t    at a time from the outer level. This must precede the empty string test -\n6527\t    in this case that test is done at the outer level. */\n6528\t\n6529\t    if (*Fecode == OP_KETRPOS)\n6530\t      {\n6531\t      memcpy((char *)P + offsetof(heapframe, eptr),\n6532\t             (char *)F + offsetof(heapframe, eptr),\n6533\t             frame_copy_size);\n6534\t      RRETURN(MATCH_KETRPOS);\n6535\t      }\n6536\t\n6537\t    /* Handle the different kinds of closing brackets. A non-repeating ket\n6538\t    needs no special action, just continuing at this level. This also happens\n6539\t    for the repeating kets if the group matched no characters, in order to\n6540\t    forcibly break infinite loops. Otherwise, the repeating kets try the rest\n6541\t    of the pattern or restart from the preceding bracket, in the appropriate\n6542\t    order. */\n6543\t\n6544\t    if (Fop != OP_KET && (P == NULL || Feptr != P->eptr))\n6545\t      {\n6546\t      if (Fop == OP_KETRMIN)\n6547\t        {\n6548\t        RMATCH(Fecode + 1 + LINK_SIZE, RM6);\n6549\t        if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6550\t        Fecode -= GET(Fecode, 1);\n6551\t        break;   /* End of ket processing */\n6552\t        }\n6553\t\n6554\t      /* Repeat the maximum number of times (KETRMAX) */\n6555\t\n6556\t      RMATCH(bracode, RM7);\n6557\t      if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6558\t      }\n6559\t\n6560\t    /* Carry on at this level for a non-repeating ket, or after matching an\n6561\t    empty string, or after repeating for a maximum number of times. */\n6562\t\n6563\t    Fecode += 1 + LINK_SIZE;\n6564\t    break;\n6565\t\n6566\t\n6567\t    /* ===================================================================== */\n6568\t    /* Start and end of line assertions, not multiline mode. */\n6569\t\n6570\t    case OP_CIRC:   /* Start of line, unless PCRE2_NOTBOL is set. */\n6571\t    if (Feptr != mb->start_subject || (mb->moptions & PCRE2_NOTBOL) != 0)\n6572\t      RRETURN(MATCH_NOMATCH);\n6573\t    Fecode++;\n6574\t    break;\n6575\t\n6576\t    case OP_SOD:    /* Unconditional start of subject */\n6577\t    if (Feptr != mb->start_subject) RRETURN(MATCH_NOMATCH);\n6578\t    Fecode++;\n6579\t    break;\n6580\t\n6581\t    /* When PCRE2_NOTEOL is unset, assert before the subject end, or a\n6582\t    terminating newline unless PCRE2_DOLLAR_ENDONLY is set. */\n6583\t\n6584\t    case OP_DOLL:\n6585\t    if ((mb->moptions & PCRE2_NOTEOL) != 0) RRETURN(MATCH_NOMATCH);\n6586\t    if ((mb->poptions & PCRE2_DOLLAR_ENDONLY) == 0) goto ASSERT_NL_OR_EOS;\n6587\t\n6588\t    PCRE2_FALLTHROUGH /* Fall through */\n6589\t    /* Unconditional end of subject assertion (\\z). */\n6590\t\n6591\t    case OP_EOD:\n6592\t    if (Feptr < mb->true_end_subject) RRETURN(MATCH_NOMATCH);\n6593\t    if (mb->partial != 0)\n6594\t      {\n6595\t      mb->hitend = TRUE;\n6596\t      if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n6597\t      }\n6598\t    Fecode++;\n6599\t    break;\n6600\t\n6601\t    /* End of subject or ending \\n assertion (\\Z) */\n6602\t\n6603\t    case OP_EODN:\n6604\t    ASSERT_NL_OR_EOS:\n6605\t    if (Feptr < mb->true_end_subject &&\n6606\t        (!IS_NEWLINE(Feptr) || Feptr != mb->true_end_subject - mb->nllen))\n6607\t      {\n6608\t      if (mb->partial != 0 &&\n6609\t          Feptr + 1 >= mb->end_subject &&\n6610\t          NLBLOCK->nltype == NLTYPE_FIXED &&\n6611\t          NLBLOCK->nllen == 2 &&\n6612\t          *Feptr == NLBLOCK->nl[0])\n6613\t        {\n6614\t        mb->hitend = TRUE;\n6615\t        if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n6616\t        }\n6617\t      RRETURN(MATCH_NOMATCH);\n6618\t      }\n6619\t\n6620\t    /* Either at end of string or \\n before end. */\n6621\t\n6622\t    if (mb->partial != 0)\n6623\t      {\n6624\t      mb->hitend = TRUE;\n6625\t      if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n6626\t      }\n6627\t    Fecode++;\n6628\t    break;\n6629\t\n6630\t\n6631\t    /* ===================================================================== */\n6632\t    /* Start and end of line assertions, multiline mode. */\n6633\t\n6634\t    /* Start of subject unless notbol, or after any newline except for one at\n6635\t    the very end, unless PCRE2_ALT_CIRCUMFLEX is set. */\n6636\t\n6637\t    case OP_CIRCM:\n6638\t    if ((mb->moptions & PCRE2_NOTBOL) != 0 && Feptr == mb->start_subject)\n6639\t      RRETURN(MATCH_NOMATCH);\n6640\t    if (Feptr != mb->start_subject &&\n6641\t        ((Feptr == mb->end_subject &&\n6642\t           (mb->poptions & PCRE2_ALT_CIRCUMFLEX) == 0) ||\n6643\t         !WAS_NEWLINE(Feptr)))\n6644\t      RRETURN(MATCH_NOMATCH);\n6645\t    Fecode++;\n6646\t    break;\n6647\t\n6648\t    /* Assert before any newline, or before end of subject unless noteol is\n6649\t    set. */\n6650\t\n6651\t    case OP_DOLLM:\n6652\t    if (Feptr < mb->end_subject)\n6653\t      {\n6654\t      if (!IS_NEWLINE(Feptr))\n6655\t        {\n6656\t        if (mb->partial != 0 &&\n6657\t            Feptr + 1 >= mb->end_subject &&\n6658\t            NLBLOCK->nltype == NLTYPE_FIXED &&\n6659\t            NLBLOCK->nllen == 2 &&\n6660\t            *Feptr == NLBLOCK->nl[0])\n6661\t          {\n6662\t          mb->hitend = TRUE;\n6663\t          if (mb->partial > 1) return PCRE2_ERROR_PARTIAL;\n6664\t          }\n6665\t        RRETURN(MATCH_NOMATCH);\n6666\t        }\n6667\t      }\n6668\t    else\n6669\t      {\n6670\t      if ((mb->moptions & PCRE2_NOTEOL) != 0) RRETURN(MATCH_NOMATCH);\n6671\t      SCHECK_PARTIAL();\n6672\t      }\n6673\t    Fecode++;\n6674\t    break;\n6675\t\n6676\t\n6677\t    /* ===================================================================== */\n6678\t    /* Start of match assertion */\n6679\t\n6680\t    case OP_SOM:\n6681\t    if (Feptr != mb->start_subject + mb->start_offset) RRETURN(MATCH_NOMATCH);\n6682\t    Fecode++;\n6683\t    break;\n6684\t\n6685\t\n6686\t    /* ===================================================================== */\n6687\t    /* Reset the start of match point */\n6688\t\n6689\t    case OP_SET_SOM:\n6690\t    Fstart_match = Feptr;\n6691\t    Fecode++;\n6692\t    break;\n6693\t\n6694\t\n6695\t    /* ===================================================================== */\n6696\t    /* Word boundary assertions. Find out if the previous and current\n6697\t    characters are \"word\" characters. It takes a bit more work in UTF mode.\n6698\t    Characters > 255 are assumed to be \"non-word\" characters when PCRE2_UCP is\n6699\t    not set. When it is set, use Unicode properties if available, even when not\n6700\t    in UTF mode. Remember the earliest and latest consulted characters. */\n6701\t\n6702\t    case OP_NOT_WORD_BOUNDARY:\n6703\t    case OP_WORD_BOUNDARY:\n6704\t    case OP_NOT_UCP_WORD_BOUNDARY:\n6705\t    case OP_UCP_WORD_BOUNDARY:\n6706\t    if (Feptr == mb->check_subject) prev_is_word = FALSE; else\n6707\t      {\n6708\t      PCRE2_SPTR lastptr = Feptr - 1;\n6709\t#ifdef SUPPORT_UNICODE\n6710\t      if (utf)\n6711\t        {\n6712\t        BACKCHAR(lastptr);\n6713\t        GETCHAR(fc, lastptr);\n6714\t        }\n6715\t      else\n6716\t#endif  /* SUPPORT_UNICODE */\n6717\t      fc = *lastptr;\n6718\t      if (lastptr < mb->start_used_ptr) mb->start_used_ptr = lastptr;\n6719\t#ifdef SUPPORT_UNICODE\n6720\t      if (Fop == OP_UCP_WORD_BOUNDARY || Fop == OP_NOT_UCP_WORD_BOUNDARY)\n6721\t        {\n6722\t        int chartype = UCD_CHARTYPE(fc);\n6723\t        int category = PRIV(ucp_gentype)[chartype];\n6724\t        prev_is_word = (category == ucp_L || category == ucp_N ||\n6725\t          chartype == ucp_Mn || chartype == ucp_Pc);\n6726\t        }\n6727\t      else\n6728\t#endif  /* SUPPORT_UNICODE */\n6729\t      prev_is_word = CHMAX_255(fc) && (mb->ctypes[fc] & ctype_word) != 0;\n6730\t      }\n6731\t\n6732\t    /* Get status of next character */\n6733\t\n6734\t    if (Feptr >= mb->end_subject)\n6735\t      {\n6736\t      SCHECK_PARTIAL();\n6737\t      cur_is_word = FALSE;\n6738\t      }\n6739\t    else\n6740\t      {\n6741\t      PCRE2_SPTR nextptr = Feptr + 1;\n6742\t#ifdef SUPPORT_UNICODE\n6743\t      if (utf)\n6744\t        {\n6745\t        FORWARDCHARTEST(nextptr, mb->end_subject);\n6746\t        GETCHAR(fc, Feptr);\n6747\t        }\n6748\t      else\n6749\t#endif  /* SUPPORT_UNICODE */\n6750\t      fc = *Feptr;\n6751\t      if (nextptr > mb->last_used_ptr) mb->last_used_ptr = nextptr;\n6752\t#ifdef SUPPORT_UNICODE\n6753\t      if (Fop == OP_UCP_WORD_BOUNDARY || Fop == OP_NOT_UCP_WORD_BOUNDARY)\n6754\t        {\n6755\t        int chartype = UCD_CHARTYPE(fc);\n6756\t        int category = PRIV(ucp_gentype)[chartype];\n6757\t        cur_is_word = (category == ucp_L || category == ucp_N ||\n6758\t          chartype == ucp_Mn || chartype == ucp_Pc);\n6759\t        }\n6760\t      else\n6761\t#endif  /* SUPPORT_UNICODE */\n6762\t      cur_is_word = CHMAX_255(fc) && (mb->ctypes[fc] & ctype_word) != 0;\n6763\t      }\n6764\t\n6765\t    /* Now see if the situation is what we want */\n6766\t\n6767\t    if ((*Fecode++ == OP_WORD_BOUNDARY || Fop == OP_UCP_WORD_BOUNDARY)?\n6768\t         cur_is_word == prev_is_word : cur_is_word != prev_is_word)\n6769\t      RRETURN(MATCH_NOMATCH);\n6770\t    break;\n6771\t\n6772\t\n6773\t    /* ===================================================================== */\n6774\t    /* Backtracking (*VERB)s, with and without arguments. Note that if the\n6775\t    pattern is successfully matched, we do not come back from RMATCH. */\n6776\t\n6777\t    case OP_MARK:\n6778\t    Fmark = mb->nomatch_mark = Fecode + 2;\n6779\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode] + Fecode[1], RM12);\n6780\t\n6781\t    /* A return of MATCH_SKIP_ARG means that matching failed at SKIP with an\n6782\t    argument, and we must check whether that argument matches this MARK's\n6783\t    argument. It is passed back in mb->verb_skip_ptr. If it does match, we\n6784\t    return MATCH_SKIP with mb->verb_skip_ptr now pointing to the subject\n6785\t    position that corresponds to this mark. Otherwise, pass back the return\n6786\t    code unaltered. */\n6787\t\n6788\t    if (rrc == MATCH_SKIP_ARG &&\n6789\t             PRIV(strcmp)(Fecode + 2, mb->verb_skip_ptr) == 0)\n6790\t      {\n6791\t      mb->verb_skip_ptr = Feptr;   /* Pass back current position */\n6792\t      RRETURN(MATCH_SKIP);\n6793\t      }\n6794\t    RRETURN(rrc);\n6795\t\n6796\t    case OP_FAIL:\n6797\t    RRETURN(MATCH_NOMATCH);\n6798\t\n6799\t    /* Record the current recursing group number in mb->verb_current_recurse\n6800\t    when a backtracking return such as MATCH_COMMIT is given. This enables the\n6801\t    recurse processing to catch verbs from within the recursion. */\n6802\t\n6803\t    case OP_COMMIT:\n6804\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM13);\n6805\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6806\t    mb->verb_current_recurse = Fcurrent_recurse;\n6807\t    RRETURN(MATCH_COMMIT);\n6808\t\n6809\t    case OP_COMMIT_ARG:\n6810\t    Fmark = mb->nomatch_mark = Fecode + 2;\n6811\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode] + Fecode[1], RM36);\n6812\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6813\t    mb->verb_current_recurse = Fcurrent_recurse;\n6814\t    RRETURN(MATCH_COMMIT);\n6815\t\n6816\t    case OP_PRUNE:\n6817\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM14);\n6818\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6819\t    mb->verb_current_recurse = Fcurrent_recurse;\n6820\t    RRETURN(MATCH_PRUNE);\n6821\t\n6822\t    case OP_PRUNE_ARG:\n6823\t    Fmark = mb->nomatch_mark = Fecode + 2;\n6824\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode] + Fecode[1], RM15);\n6825\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6826\t    mb->verb_current_recurse = Fcurrent_recurse;\n6827\t    RRETURN(MATCH_PRUNE);\n6828\t\n6829\t    case OP_SKIP:\n6830\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM16);\n6831\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6832\t    mb->verb_skip_ptr = Feptr;   /* Pass back current position */\n6833\t    mb->verb_current_recurse = Fcurrent_recurse;\n6834\t    RRETURN(MATCH_SKIP);\n6835\t\n6836\t    /* Note that, for Perl compatibility, SKIP with an argument does NOT set\n6837\t    nomatch_mark. When a pattern match ends with a SKIP_ARG for which there was\n6838\t    not a matching mark, we have to re-run the match, ignoring the SKIP_ARG\n6839\t    that failed and any that precede it (either they also failed, or were not\n6840\t    triggered). To do this, we maintain a count of executed SKIP_ARGs. If a\n6841\t    SKIP_ARG gets to top level, the match is re-run with mb->ignore_skip_arg\n6842\t    set to the count of the one that failed. */\n6843\t\n6844\t    case OP_SKIP_ARG:\n6845\t    mb->skip_arg_count++;\n6846\t    if (mb->skip_arg_count <= mb->ignore_skip_arg)\n6847\t      {\n6848\t      Fecode += PRIV(OP_lengths)[*Fecode] + Fecode[1];\n6849\t      break;\n6850\t      }\n6851\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode] + Fecode[1], RM17);\n6852\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6853\t\n6854\t    /* Pass back the current skip name and return the special MATCH_SKIP_ARG\n6855\t    return code. This will either be caught by a matching MARK, or get to the\n6856\t    top, where it causes a rematch with mb->ignore_skip_arg set to the value of\n6857\t    mb->skip_arg_count. */\n6858\t\n6859\t    mb->verb_skip_ptr = Fecode + 2;\n6860\t    mb->verb_current_recurse = Fcurrent_recurse;\n6861\t    RRETURN(MATCH_SKIP_ARG);\n6862\t\n6863\t    /* For THEN (and THEN_ARG) we pass back the address of the opcode, so that\n6864\t    the branch in which it occurs can be determined. */\n6865\t\n6866\t    case OP_THEN:\n6867\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode], RM18);\n6868\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6869\t    mb->verb_ecode_ptr = Fecode;\n6870\t    mb->verb_current_recurse = Fcurrent_recurse;\n6871\t    RRETURN(MATCH_THEN);\n6872\t\n6873\t    case OP_THEN_ARG:\n6874\t    Fmark = mb->nomatch_mark = Fecode + 2;\n6875\t    RMATCH(Fecode + PRIV(OP_lengths)[*Fecode] + Fecode[1], RM19);\n6876\t    if (rrc != MATCH_NOMATCH) RRETURN(rrc);\n6877\t    mb->verb_ecode_ptr = Fecode;\n6878\t    mb->verb_current_recurse = Fcurrent_recurse;\n6879\t    RRETURN(MATCH_THEN);\n6880\t\n6881\t\n6882\t    /* ===================================================================== */\n6883\t    /* There's been some horrible disaster. Arrival here can only mean there is\n6884\t    something seriously wrong in the code above or the OP_xxx definitions. */\n6885\t\n6886\t    /* LCOV_EXCL_START */\n6887\t    default:\n6888\t    PCRE2_DEBUG_UNREACHABLE();\n6889\t    return PCRE2_ERROR_INTERNAL;\n6890\t    /* LCOV_EXCL_STOP */\n6891\t    }\n6892\t\n6893\t  /* Do not insert any code in here without much thought; it is assumed\n6894\t  that \"continue\" in the code above comes out to here to repeat the main\n6895\t  loop. */\n6896\t\n6897\t  }  /* End of main loop */\n6898\t\n6899\tPCRE2_DEBUG_UNREACHABLE(); /* Control should never reach here */\n6900\t\n6901\t/* ========================================================================= */\n6902\t/* The RRETURN() macro jumps here. The number that is saved in Freturn_id\n6903\tindicates which label we actually want to return to. The value in Frdepth is\n6904\tthe index number of the frame in the vector. The return value has been placed\n6905\tin rrc. */\n6906\t\n6907\t#define LBL(val) case val: goto L_RM##val;\n6908\t\n6909\tRETURN_SWITCH:\n6910\tif (Feptr > mb->last_used_ptr) mb->last_used_ptr = Feptr;\n6911\tif (Frdepth == 0) return rrc;                     /* Exit from the top level */\n6912\tF = (heapframe *)((char *)F - Fback_frame);       /* Backtrack */\n6913\tmb->cb->callout_flags |= PCRE2_CALLOUT_BACKTRACK; /* Note for callouts */\n6914\t\n6915\t#ifdef DEBUG_SHOW_RMATCH\n6916\tfprintf(stderr, \"++ RETURN %d to RM%d\\n\", rrc, Freturn_id);\n6917\t#endif\n6918\t\n6919\tswitch (Freturn_id)\n6920\t  {\n6921\t  LBL( 1) LBL( 2) LBL( 3) LBL( 4) LBL( 5) LBL( 6) LBL( 7) LBL( 8)\n6922\t  LBL( 9) LBL(10) LBL(11) LBL(12) LBL(13) LBL(14) LBL(15) LBL(16)\n6923\t  LBL(17) LBL(18) LBL(19) LBL(20) LBL(21) LBL(22) LBL(23) LBL(24)\n6924\t  LBL(25) LBL(26) LBL(27) LBL(28) LBL(29) LBL(30) LBL(31) LBL(32)\n6925\t  LBL(33) LBL(34) LBL(35) LBL(36) LBL(37) LBL(38) LBL(39)\n6926\t\n6927\t#ifdef SUPPORT_WIDE_CHARS\n6928\t  LBL(100) LBL(101) LBL(102) LBL(103)\n6929\t#endif\n6930\t\n6931\t#ifdef SUPPORT_UNICODE\n6932\t  LBL(200) LBL(201) LBL(202) LBL(203) LBL(204) LBL(205) LBL(206)\n6933\t  LBL(207) LBL(208) LBL(209) LBL(210) LBL(211) LBL(212) LBL(213)\n6934\t  LBL(214) LBL(215) LBL(216) LBL(217) LBL(218) LBL(219) LBL(220)\n6935\t  LBL(221) LBL(222) LBL(223) LBL(224)\n6936\t#endif\n6937\t\n6938\t  /* LCOV_EXCL_START */\n6939\t  default:\n6940\t  PCRE2_DEBUG_UNREACHABLE();\n6941\t  return PCRE2_ERROR_INTERNAL;\n6942\t  /* LCOV_EXCL_STOP */\n6943\t  }\n6944\t#undef LBL\n6945\t}\n6946\t\n6947\t\n6948\t/*************************************************\n6949\t*           Match a Regular Expression           *\n6950\t*************************************************/\n6951\t\n6952\t/* This function applies a compiled pattern to a subject string and picks out\n6953\tportions of the string if it matches. Two elements in the vector are set for\n6954\teach substring: the offsets to the start and end of the substring.\n6955\t\n6956\tArguments:\n6957\t  code            points to the compiled expression\n6958\t  subject         points to the subject string\n6959\t  length          length of subject string (may contain binary zeros)\n6960\t  start_offset    where to start in the subject string\n6961\t  options         option bits\n6962\t  match_data      points to a match_data block\n6963\t  mcontext        points a PCRE2 context\n6964\t\n6965\tReturns:          > 0 => success; value is the number of ovector pairs filled\n6966\t                  = 0 => success, but ovector is not big enough\n6967\t                  = -1 => failed to match (PCRE2_ERROR_NOMATCH)\n6968\t                  = -2 => partial match (PCRE2_ERROR_PARTIAL)\n6969\t                  < -2 => some kind of unexpected problem\n6970\t*/\n6971\t\n6972\tPCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\n6973\tpcre2_match(const pcre2_code *code, PCRE2_SPTR subject, PCRE2_SIZE length,\n6974\t  PCRE2_SIZE start_offset, uint32_t options, pcre2_match_data *match_data,\n6975\t  pcre2_match_context *mcontext)\n6976\t{\n6977\tint rc;\n6978\tconst uint8_t *start_bits = NULL;\n6979\tconst pcre2_real_code *re = (const pcre2_real_code *)code;\n6980\tuint32_t original_options = options;\n6981\t\n6982\tBOOL anchored;\n6983\tBOOL firstline;\n6984\tBOOL has_first_cu = FALSE;\n6985\tBOOL has_req_cu = FALSE;\n6986\tBOOL startline;\n6987\t\n6988\t#if PCRE2_CODE_UNIT_WIDTH == 8\n6989\tPCRE2_SPTR memchr_found_first_cu;\n6990\tPCRE2_SPTR memchr_found_first_cu2;\n6991\t#endif\n6992\t\n6993\tPCRE2_UCHAR first_cu = 0;\n6994\tPCRE2_UCHAR first_cu2 = 0;\n6995\tPCRE2_UCHAR req_cu = 0;\n6996\tPCRE2_UCHAR req_cu2 = 0;\n6997\t\n6998\tPCRE2_UCHAR null_str[1] = { 0xcd };\n6999\tPCRE2_SPTR original_subject = subject;\n7000\tPCRE2_SPTR bumpalong_limit;\n7001\tPCRE2_SPTR end_subject;\n7002\tPCRE2_SPTR true_end_subject;\n7003\tPCRE2_SPTR start_match;\n7004\tPCRE2_SPTR req_cu_ptr;\n7005\tPCRE2_SPTR start_partial;\n7006\tPCRE2_SPTR match_partial;\n7007\t\n7008\t#ifdef SUPPORT_JIT\n7009\tBOOL use_jit;\n7010\t#endif\n7011\t\n7012\t/* This flag is needed even when Unicode is not supported for convenience\n7013\t(it is used by the IS_NEWLINE macro). */\n7014\t\n7015\tBOOL utf = FALSE;\n7016\t\n7017\t#ifdef SUPPORT_UNICODE\n7018\tBOOL ucp = FALSE;\n7019\tBOOL allow_invalid;\n7020\tuint32_t fragment_options = 0;\n7021\t#ifdef SUPPORT_JIT\n7022\tBOOL jit_checked_utf = FALSE;\n7023\t#endif\n7024\t#endif  /* SUPPORT_UNICODE */\n7025\t\n7026\tPCRE2_SIZE frame_size;\n7027\tPCRE2_SIZE heapframes_size;\n7028\t\n7029\t/* We need to have mb as a pointer to a match block, because the IS_NEWLINE\n7030\tmacro is used below, and it expects NLBLOCK to be defined as a pointer. */\n7031\t\n7032\tpcre2_callout_block cb;\n7033\tmatch_block actual_match_block;\n7034\tmatch_block *mb = &actual_match_block;\n7035\t\n7036\t/* Recognize NULL, length 0 as an empty string. */\n7037\t\n7038\tif (subject == NULL && length == 0) subject = null_str;\n7039\t\n7040\t/* Plausibility checks */\n7041\t\n7042\tif (match_data == NULL) return PCRE2_ERROR_NULL;\n7043\tif (code == NULL || subject == NULL)\n7044\t  return match_data->rc = PCRE2_ERROR_NULL;\n7045\tif ((options & ~PUBLIC_MATCH_OPTIONS) != 0)\n7046\t  return match_data->rc = PCRE2_ERROR_BADOPTION;\n7047\t\n7048\tstart_match = subject + start_offset;\n7049\treq_cu_ptr = start_match - 1;\n7050\tif (length == PCRE2_ZERO_TERMINATED)\n7051\t  {\n7052\t  length = PRIV(strlen)(subject);\n7053\t  }\n7054\ttrue_end_subject = end_subject = subject + length;\n7055\t\n7056\tif (start_offset > length) return match_data->rc = PCRE2_ERROR_BADOFFSET;\n7057\t\n7058\t/* Check that the first field in the block is the magic number. */\n7059\t\n7060\tif (re->magic_number != MAGIC_NUMBER)\n7061\t  return match_data->rc = PCRE2_ERROR_BADMAGIC;\n7062\t\n7063\t/* Check the code unit width. */\n7064\t\n7065\tif ((re->flags & PCRE2_MODE_MASK) != PCRE2_CODE_UNIT_WIDTH/8)\n7066\t  return match_data->rc = PCRE2_ERROR_BADMODE;\n7067\t\n7068\t/* PCRE2_NOTEMPTY and PCRE2_NOTEMPTY_ATSTART are match-time flags in the\n7069\toptions variable for this function. Users of PCRE2 who are not calling the\n7070\tfunction directly would like to have a way of setting these flags, in the same\n7071\tway that they can set pcre2_compile() flags like PCRE2_NO_AUTO_POSSESS with\n7072\tconstructions like (*NO_AUTOPOSSESS). To enable this, (*NOTEMPTY) and\n7073\t(*NOTEMPTY_ATSTART) set bits in the pattern's \"flag\" function which we now\n7074\ttransfer to the options for this function. The bits are guaranteed to be\n7075\tadjacent, but do not have the same values. This bit of Boolean trickery assumes\n7076\tthat the match-time bits are not more significant than the flag bits. If by\n7077\taccident this is not the case, a compile-time division by zero error will\n7078\toccur. */\n7079\t\n7080\t#define FF (PCRE2_NOTEMPTY_SET|PCRE2_NE_ATST_SET)\n7081\t#define OO (PCRE2_NOTEMPTY|PCRE2_NOTEMPTY_ATSTART)\n7082\toptions |= (re->flags & FF) / ((FF & (~FF+1)) / (OO & (~OO+1)));\n7083\t#undef FF\n7084\t#undef OO\n7085\t\n7086\t/* If the pattern was successfully studied with JIT support, we will run the\n7087\tJIT executable instead of the rest of this function. Most options must be set\n7088\tat compile time for the JIT code to be usable. */\n7089\t\n7090\t#ifdef SUPPORT_JIT\n7091\tuse_jit = (re->executable_jit != NULL &&\n7092\t          (options & ~PUBLIC_JIT_MATCH_OPTIONS) == 0);\n7093\t#endif\n7094\t\n7095\t/* Initialize UTF/UCP parameters. */\n7096\t\n7097\t#ifdef SUPPORT_UNICODE\n7098\tutf = (re->overall_options & PCRE2_UTF) != 0;\n7099\tallow_invalid = (re->overall_options & PCRE2_MATCH_INVALID_UTF) != 0;\n7100\tucp = (re->overall_options & PCRE2_UCP) != 0;\n7101\t#endif  /* SUPPORT_UNICODE */\n7102\t\n7103\t/* Convert the partial matching flags into an integer. */\n7104\t\n7105\tmb->partial = ((options & PCRE2_PARTIAL_HARD) != 0)? 2 :\n7106\t              ((options & PCRE2_PARTIAL_SOFT) != 0)? 1 : 0;\n7107\t\n7108\t/* Partial matching and PCRE2_ENDANCHORED are currently not allowed at the same\n7109\ttime. */\n7110\t\n7111\tif (mb->partial != 0 &&\n7112\t   ((re->overall_options | options) & PCRE2_ENDANCHORED) != 0)\n7113\t  return match_data->rc = PCRE2_ERROR_BADOPTION;\n7114\t\n7115\t/* It is an error to set an offset limit without setting the flag at compile\n7116\ttime. */\n7117\t\n7118\tif (mcontext != NULL && mcontext->offset_limit != PCRE2_UNSET &&\n7119\t     (re->overall_options & PCRE2_USE_OFFSET_LIMIT) == 0)\n7120\t  return match_data->rc = PCRE2_ERROR_BADOFFSETLIMIT;\n7121\t\n7122\t/* If the match data block was previously used with PCRE2_COPY_MATCHED_SUBJECT,\n7123\tfree the memory that was obtained. Set the field to NULL for match error\n7124\tcases. */\n7125\t\n7126\tif ((match_data->flags & PCRE2_MD_COPIED_SUBJECT) != 0)\n7127\t  {\n7128\t  match_data->memctl.free((void *)match_data->subject,\n7129\t    match_data->memctl.memory_data);\n7130\t  match_data->flags &= ~PCRE2_MD_COPIED_SUBJECT;\n7131\t  }\n7132\tmatch_data->subject = NULL;\n7133\t\n7134\t/* Zero the error offset in case the first code unit is invalid UTF. */\n7135\t\n7136\tmatch_data->startchar = 0;\n7137\t\n7138\t\n7139\t/* ============================= JIT matching ============================== */\n7140\t\n7141\t/* Prepare for JIT matching. Check a UTF string for validity unless no check is\n7142\trequested or invalid UTF can be handled. We check only the portion of the\n7143\tsubject that might be be inspected during matching - from the offset minus the\n7144\tmaximum lookbehind to the given length. This saves time when a small part of a\n7145\tlarge subject is being matched by the use of a starting offset. Note that the\n7146\tmaximum lookbehind is a number of characters, not code units. */\n7147\t\n7148\t#ifdef SUPPORT_JIT\n7149\tif (use_jit)\n7150\t  {\n7151\t#ifdef SUPPORT_UNICODE\n7152\t  if (utf && (options & PCRE2_NO_UTF_CHECK) == 0 && !allow_invalid)\n7153\t    {\n7154\t\n7155\t    /* For 8-bit and 16-bit UTF, check that the first code unit is a valid\n7156\t    character start. */\n7157\t\n7158\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7159\t    if (start_match < end_subject && NOT_FIRSTCU(*start_match))\n7160\t      {\n7161\t      if (start_offset > 0) return match_data->rc = PCRE2_ERROR_BADUTFOFFSET;\n7162\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7163\t      return match_data->rc = PCRE2_ERROR_UTF8_ERR20;  /* Isolated 0x80 byte */\n7164\t#else\n7165\t      return match_data->rc = PCRE2_ERROR_UTF16_ERR3;  /* Isolated low surrogate */\n7166\t#endif\n7167\t      }\n7168\t#endif  /* WIDTH != 32 */\n7169\t\n7170\t    /* Move back by the maximum lookbehind, just in case it happens at the very\n7171\t    start of matching. */\n7172\t\n7173\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7174\t    for (unsigned int i = re->max_lookbehind; i > 0 && start_match > subject; i--)\n7175\t      {\n7176\t      start_match--;\n7177\t      while (start_match > subject &&\n7178\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7179\t      (*start_match & 0xc0) == 0x80)\n7180\t#else  /* 16-bit */\n7181\t      (*start_match & 0xfc00) == 0xdc00)\n7182\t#endif\n7183\t        start_match--;\n7184\t      }\n7185\t#else  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7186\t\n7187\t    /* In the 32-bit library, one code unit equals one character. However,\n7188\t    we cannot just subtract the lookbehind and then compare pointers, because\n7189\t    a very large lookbehind could create an invalid pointer. */\n7190\t\n7191\t    if (start_offset >= re->max_lookbehind)\n7192\t      start_match -= re->max_lookbehind;\n7193\t    else\n7194\t      start_match = subject;\n7195\t#endif  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7196\t\n7197\t    /* Validate the relevant portion of the subject. Adjust the offset of an\n7198\t    invalid code point to be an absolute offset in the whole string. */\n7199\t\n7200\t    rc = PRIV(valid_utf)(start_match,\n7201\t      length - (start_match - subject), &(match_data->startchar));\n7202\t    if (rc != 0)\n7203\t      {\n7204\t      match_data->startchar += start_match - subject;\n7205\t      return match_data->rc = rc;\n7206\t      }\n7207\t    jit_checked_utf = TRUE;\n7208\t    }\n7209\t#endif  /* SUPPORT_UNICODE */\n7210\t\n7211\t  /* If JIT returns BADOPTION, which means that the selected complete or\n7212\t  partial matching mode was not compiled, fall through to the interpreter. */\n7213\t\n7214\t  rc = pcre2_jit_match(code, subject, length, start_offset, options,\n7215\t    match_data, mcontext);\n7216\t  if (rc != PCRE2_ERROR_JIT_BADOPTION)\n7217\t    {\n7218\t    match_data->options = original_options;\n7219\t    if (rc >= 0 && (options & PCRE2_COPY_MATCHED_SUBJECT) != 0)\n7220\t      {\n7221\t      if (length != 0)\n7222\t        {\n7223\t        match_data->subject = match_data->memctl.malloc(CU2BYTES(length),\n7224\t          match_data->memctl.memory_data);\n7225\t        if (match_data->subject == NULL)\n7226\t          return match_data->rc = PCRE2_ERROR_NOMEMORY;\n7227\t        memcpy((void *)match_data->subject, subject, CU2BYTES(length));\n7228\t        }\n7229\t      else\n7230\t        match_data->subject = NULL;\n7231\t      match_data->flags |= PCRE2_MD_COPIED_SUBJECT;\n7232\t      }\n7233\t    else\n7234\t      {\n7235\t      /* When pcre2_jit_match sets the subject, it doesn't know what the\n7236\t      original passed-in pointer was. */\n7237\t      if (match_data->subject != NULL) match_data->subject = original_subject;\n7238\t      }\n7239\t    return rc;\n7240\t    }\n7241\t  }\n7242\t#endif  /* SUPPORT_JIT */\n7243\t\n7244\t/* ========================= End of JIT matching ========================== */\n7245\t\n7246\t\n7247\t/* Proceed with non-JIT matching. The default is to allow lookbehinds to the\n7248\tstart of the subject. A UTF check when there is a non-zero offset may change\n7249\tthis. */\n7250\t\n7251\tmb->check_subject = subject;\n7252\t\n7253\t/* If a UTF subject string was not checked for validity in the JIT code above,\n7254\tcheck it here, and handle support for invalid UTF strings. The check above\n7255\thappens only when invalid UTF is not supported and PCRE2_NO_CHECK_UTF is unset.\n7256\tIf we get here in those circumstances, it means the subject string is valid,\n7257\tbut for some reason JIT matching was not successful. There is no need to check\n7258\tthe subject again.\n7259\t\n7260\tWe check only the portion of the subject that might be be inspected during\n7261\tmatching - from the offset minus the maximum lookbehind to the given length.\n7262\tThis saves time when a small part of a large subject is being matched by the\n7263\tuse of a starting offset. Note that the maximum lookbehind is a number of\n7264\tcharacters, not code units.\n7265\t\n7266\tNote also that support for invalid UTF forces a check, overriding the setting\n7267\tof PCRE2_NO_CHECK_UTF. */\n7268\t\n7269\t#ifdef SUPPORT_UNICODE\n7270\tif (utf &&\n7271\t#ifdef SUPPORT_JIT\n7272\t    !jit_checked_utf &&\n7273\t#endif\n7274\t    ((options & PCRE2_NO_UTF_CHECK) == 0 || allow_invalid))\n7275\t  {\n7276\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7277\t  BOOL skipped_bad_start = FALSE;\n7278\t#endif\n7279\t\n7280\t  /* For 8-bit and 16-bit UTF, check that the first code unit is a valid\n7281\t  character start. If we are handling invalid UTF, just skip over such code\n7282\t  units. Otherwise, give an appropriate error. */\n7283\t\n7284\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7285\t  if (allow_invalid)\n7286\t    {\n7287\t    while (start_match < end_subject && NOT_FIRSTCU(*start_match))\n7288\t      {\n7289\t      start_match++;\n7290\t      skipped_bad_start = TRUE;\n7291\t      }\n7292\t    }\n7293\t  else if (start_match < end_subject && NOT_FIRSTCU(*start_match))\n7294\t    {\n7295\t    if (start_offset > 0) return match_data->rc = PCRE2_ERROR_BADUTFOFFSET;\n7296\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7297\t    return match_data->rc = PCRE2_ERROR_UTF8_ERR20;  /* Isolated 0x80 byte */\n7298\t#else\n7299\t    return match_data->rc = PCRE2_ERROR_UTF16_ERR3;  /* Isolated low surrogate */\n7300\t#endif\n7301\t    }\n7302\t#endif  /* WIDTH != 32 */\n7303\t\n7304\t  /* The mb->check_subject field points to the start of UTF checking;\n7305\t  lookbehinds can go back no further than this. */\n7306\t\n7307\t  mb->check_subject = start_match;\n7308\t\n7309\t  /* Move back by the maximum lookbehind, just in case it happens at the very\n7310\t  start of matching, but don't do this if we skipped bad 8-bit or 16-bit code\n7311\t  units above. */\n7312\t\n7313\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7314\t  if (!skipped_bad_start)\n7315\t    {\n7316\t    unsigned int i;\n7317\t    for (i = re->max_lookbehind; i > 0 && mb->check_subject > subject; i--)\n7318\t      {\n7319\t      mb->check_subject--;\n7320\t      while (mb->check_subject > subject &&\n7321\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7322\t      (*mb->check_subject & 0xc0) == 0x80)\n7323\t#else  /* 16-bit */\n7324\t      (*mb->check_subject & 0xfc00) == 0xdc00)\n7325\t#endif\n7326\t        mb->check_subject--;\n7327\t      }\n7328\t    }\n7329\t#else  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7330\t\n7331\t  /* In the 32-bit library, one code unit equals one character. However,\n7332\t  we cannot just subtract the lookbehind and then compare pointers, because\n7333\t  a very large lookbehind could create an invalid pointer. */\n7334\t\n7335\t  if (start_offset >= re->max_lookbehind)\n7336\t    mb->check_subject -= re->max_lookbehind;\n7337\t  else\n7338\t    mb->check_subject = subject;\n7339\t#endif  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7340\t\n7341\t  /* Validate the relevant portion of the subject. There's a loop in case we\n7342\t  encounter bad UTF in the characters preceding start_match which we are\n7343\t  scanning because of a lookbehind. */\n7344\t\n7345\t  for (;;)\n7346\t    {\n7347\t    rc = PRIV(valid_utf)(mb->check_subject,\n7348\t      length - (mb->check_subject - subject), &(match_data->startchar));\n7349\t\n7350\t    if (rc == 0) break;   /* Valid UTF string */\n7351\t\n7352\t    /* Invalid UTF string. Adjust the offset to be an absolute offset in the\n7353\t    whole string. If we are handling invalid UTF strings, set end_subject to\n7354\t    stop before the bad code unit, and set the options to \"not end of line\".\n7355\t    Otherwise return the error. */\n7356\t\n7357\t    match_data->startchar += mb->check_subject - subject;\n7358\t    if (!allow_invalid || rc > 0) return match_data->rc = rc;\n7359\t    end_subject = subject + match_data->startchar;\n7360\t\n7361\t    /* If the end precedes start_match, it means there is invalid UTF in the\n7362\t    extra code units we reversed over because of a lookbehind. Advance past the\n7363\t    first bad code unit, and then skip invalid character starting code units in\n7364\t    8-bit and 16-bit modes, and try again with the original end point. */\n7365\t\n7366\t    if (end_subject < start_match)\n7367\t      {\n7368\t      mb->check_subject = end_subject + 1;\n7369\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7370\t      while (mb->check_subject < start_match && NOT_FIRSTCU(*mb->check_subject))\n7371\t        mb->check_subject++;\n7372\t#endif\n7373\t      end_subject = true_end_subject;\n7374\t      }\n7375\t\n7376\t    /* Otherwise, set the not end of line option, and do the match. */\n7377\t\n7378\t    else\n7379\t      {\n7380\t      fragment_options = PCRE2_NOTEOL;\n7381\t      break;\n7382\t      }\n7383\t    }\n7384\t  }\n7385\t#endif  /* SUPPORT_UNICODE */\n7386\t\n7387\t/* A NULL match context means \"use a default context\", but we take the memory\n7388\tcontrol functions from the pattern. */\n7389\t\n7390\tif (mcontext == NULL)\n7391\t  {\n7392\t  mcontext = (pcre2_match_context *)(&PRIV(default_match_context));\n7393\t  mb->memctl = re->memctl;\n7394\t  }\n7395\telse mb->memctl = mcontext->memctl;\n7396\t\n7397\tanchored = ((re->overall_options | options) & PCRE2_ANCHORED) != 0;\n7398\tfirstline = !anchored && (re->overall_options & PCRE2_FIRSTLINE) != 0;\n7399\tstartline = (re->flags & PCRE2_STARTLINE) != 0;\n7400\tbumpalong_limit = (mcontext->offset_limit == PCRE2_UNSET)?\n7401\t  true_end_subject : subject + mcontext->offset_limit;\n7402\t\n7403\t/* Initialize and set up the fixed fields in the callout block, with a pointer\n7404\tin the match block. */\n7405\t\n7406\tmb->cb = &cb;\n7407\tcb.version = 2;\n7408\tcb.subject = subject;\n7409\tcb.subject_length = (PCRE2_SIZE)(end_subject - subject);\n7410\tcb.callout_flags = 0;\n7411\t\n7412\t/* Fill in the remaining fields in the match block, except for moptions, which\n7413\tgets set later. */\n7414\t\n7415\tmb->callout = mcontext->callout;\n7416\tmb->callout_data = mcontext->callout_data;\n7417\t\n7418\tmb->start_subject = subject;\n7419\tmb->start_offset = start_offset;\n7420\tmb->end_subject = end_subject;\n7421\tmb->true_end_subject = true_end_subject;\n7422\tmb->hasthen = (re->flags & PCRE2_HASTHEN) != 0;\n7423\tmb->hasbsk = (re->flags & PCRE2_HASBSK) != 0;\n7424\tmb->allowemptypartial = (re->max_lookbehind > 0) ||\n7425\t    (re->flags & PCRE2_MATCH_EMPTY) != 0;\n7426\tmb->allowlookaroundbsk =\n7427\t  (re->extra_options & PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK) != 0;\n7428\tmb->poptions = re->overall_options;          /* Pattern options */\n7429\tmb->ignore_skip_arg = 0;\n7430\tmb->mark = mb->nomatch_mark = NULL;          /* In case never set */\n7431\t\n7432\t/* The name table is needed for finding all the numbers associated with a\n7433\tgiven name, for condition testing. The code follows the name table. */\n7434\t\n7435\tmb->name_table = (PCRE2_SPTR)((const uint8_t *)re + sizeof(pcre2_real_code));\n7436\tmb->name_count = re->name_count;\n7437\tmb->name_entry_size = re->name_entry_size;\n7438\tmb->start_code = (PCRE2_SPTR)((const uint8_t *)re + re->code_start);\n7439\t\n7440\t/* Process the \\R and newline settings. */\n7441\t\n7442\tmb->bsr_convention = re->bsr_convention;\n7443\tmb->nltype = NLTYPE_FIXED;\n7444\tswitch(re->newline_convention)\n7445\t  {\n7446\t  case PCRE2_NEWLINE_CR:\n7447\t  mb->nllen = 1;\n7448\t  mb->nl[0] = CHAR_CR;\n7449\t  break;\n7450\t\n7451\t  case PCRE2_NEWLINE_LF:\n7452\t  mb->nllen = 1;\n7453\t  mb->nl[0] = CHAR_NL;\n7454\t  break;\n7455\t\n7456\t  case PCRE2_NEWLINE_NUL:\n7457\t  mb->nllen = 1;\n7458\t  mb->nl[0] = CHAR_NUL;\n7459\t  break;\n7460\t\n7461\t  case PCRE2_NEWLINE_CRLF:\n7462\t  mb->nllen = 2;\n7463\t  mb->nl[0] = CHAR_CR;\n7464\t  mb->nl[1] = CHAR_NL;\n7465\t  break;\n7466\t\n7467\t  case PCRE2_NEWLINE_ANY:\n7468\t  mb->nltype = NLTYPE_ANY;\n7469\t  break;\n7470\t\n7471\t  case PCRE2_NEWLINE_ANYCRLF:\n7472\t  mb->nltype = NLTYPE_ANYCRLF;\n7473\t  break;\n7474\t\n7475\t  /* LCOV_EXCL_START */\n7476\t  default:\n7477\t  PCRE2_DEBUG_UNREACHABLE();\n7478\t  return match_data->rc = PCRE2_ERROR_INTERNAL;\n7479\t  /* LCOV_EXCL_STOP */\n7480\t  }\n7481\t\n7482\t/* The backtracking frames have fixed data at the front, and a PCRE2_SIZE\n7483\tvector at the end, whose size depends on the number of capturing parentheses in\n7484\tthe pattern. It is not used at all if there are no capturing parentheses.\n7485\t\n7486\t  frame_size                   is the total size of each frame\n7487\t  match_data->heapframes       is the pointer to the frames vector\n7488\t  match_data->heapframes_size  is the allocated size of the vector\n7489\t\n7490\tWe must pad the frame_size for alignment to ensure subsequent frames are as\n7491\taligned as heapframe. Whilst ovector is word-aligned due to being a PCRE2_SIZE\n7492\tarray, that does not guarantee it is suitably aligned for pointers, as some\n7493\tarchitectures have pointers that are larger than a size_t. */\n7494\t\n7495\tframe_size = (offsetof(heapframe, ovector) +\n7496\t  re->top_bracket * 2 * sizeof(PCRE2_SIZE) + HEAPFRAME_ALIGNMENT - 1) &\n7497\t  ~(HEAPFRAME_ALIGNMENT - 1);\n7498\t\n7499\t/* Limits set in the pattern override the match context only if they are\n7500\tsmaller. */\n7501\t\n7502\tmb->heap_limit = ((mcontext->heap_limit < re->limit_heap)?\n7503\t  mcontext->heap_limit : re->limit_heap);\n7504\t\n7505\tmb->match_limit = (mcontext->match_limit < re->limit_match)?\n7506\t  mcontext->match_limit : re->limit_match;\n7507\t\n7508\tmb->match_limit_depth = (mcontext->depth_limit < re->limit_depth)?\n7509\t  mcontext->depth_limit : re->limit_depth;\n7510\t\n7511\t/* If a pattern has very many capturing parentheses, the frame size may be very\n7512\tlarge. Set the initial frame vector size to ensure that there are at least 10\n7513\tavailable frames, but enforce a minimum of START_FRAMES_SIZE. If this is\n7514\tgreater than the heap limit, get as large a vector as possible. */\n7515\t\n7516\theapframes_size = frame_size * 10;\n7517\tif (heapframes_size < START_FRAMES_SIZE) heapframes_size = START_FRAMES_SIZE;\n7518\tif (heapframes_size / 1024 > mb->heap_limit)\n7519\t  {\n7520\t  PCRE2_SIZE max_size = 1024 * mb->heap_limit;\n7521\t  if (max_size < frame_size) return match_data->rc = PCRE2_ERROR_HEAPLIMIT;\n7522\t  heapframes_size = max_size;\n7523\t  }\n7524\t\n7525\t/* If an existing frame vector in the match_data block is large enough, we can\n7526\tuse it. Otherwise, free any pre-existing vector and get a new one. */\n7527\t\n7528\tif (match_data->heapframes_size < heapframes_size)\n7529\t  {\n7530\t  match_data->memctl.free(match_data->heapframes,\n7531\t    match_data->memctl.memory_data);\n7532\t  match_data->heapframes = match_data->memctl.malloc(heapframes_size,\n7533\t    match_data->memctl.memory_data);\n7534\t  if (match_data->heapframes == NULL)\n7535\t    {\n7536\t    match_data->heapframes_size = 0;\n7537\t    return match_data->rc = PCRE2_ERROR_NOMEMORY;\n7538\t    }\n7539\t  match_data->heapframes_size = heapframes_size;\n7540\t  }\n7541\t\n7542\t/* Write to the ovector within the first frame to mark every capture unset and\n7543\tto avoid uninitialized memory read errors when it is copied to a new frame. */\n7544\t\n7545\tmemset((char *)(match_data->heapframes) + offsetof(heapframe, ovector), 0xff,\n7546\t  frame_size - offsetof(heapframe, ovector));\n7547\t\n7548\t/* Pointers to the individual character tables */\n7549\t\n7550\tmb->lcc = re->tables + lcc_offset;\n7551\tmb->fcc = re->tables + fcc_offset;\n7552\tmb->ctypes = re->tables + ctypes_offset;\n7553\t\n7554\t/* Set up the first code unit to match, if available. If there's no first code\n7555\tunit there may be a bitmap of possible first characters. */\n7556\t\n7557\tif ((re->flags & PCRE2_FIRSTSET) != 0)\n7558\t  {\n7559\t  has_first_cu = TRUE;\n7560\t  first_cu = first_cu2 = (PCRE2_UCHAR)(re->first_codeunit);\n7561\t  if ((re->flags & PCRE2_FIRSTCASELESS) != 0)\n7562\t    {\n7563\t    first_cu2 = TABLE_GET(first_cu, mb->fcc, first_cu);\n7564\t#ifdef SUPPORT_UNICODE\n7565\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7566\t    if (first_cu > 127 && ucp && !utf) first_cu2 = UCD_OTHERCASE(first_cu);\n7567\t#else\n7568\t    if (first_cu > 127 && (utf || ucp)) first_cu2 = UCD_OTHERCASE(first_cu);\n7569\t#endif\n7570\t#endif  /* SUPPORT_UNICODE */\n7571\t    }\n7572\t  }\n7573\telse\n7574\t  if (!startline && (re->flags & PCRE2_FIRSTMAPSET) != 0)\n7575\t    start_bits = re->start_bitmap;\n7576\t\n7577\t/* There may also be a \"last known required character\" set. */\n7578\t\n7579\tif ((re->flags & PCRE2_LASTSET) != 0)\n7580\t  {\n7581\t  has_req_cu = TRUE;\n7582\t  req_cu = req_cu2 = (PCRE2_UCHAR)(re->last_codeunit);\n7583\t  if ((re->flags & PCRE2_LASTCASELESS) != 0)\n7584\t    {\n7585\t    req_cu2 = TABLE_GET(req_cu, mb->fcc, req_cu);\n7586\t#ifdef SUPPORT_UNICODE\n7587\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7588\t    if (req_cu > 127 && ucp && !utf) req_cu2 = UCD_OTHERCASE(req_cu);\n7589\t#else\n7590\t    if (req_cu > 127 && (utf || ucp)) req_cu2 = UCD_OTHERCASE(req_cu);\n7591\t#endif\n7592\t#endif  /* SUPPORT_UNICODE */\n7593\t    }\n7594\t  }\n7595\t\n7596\t\n7597\t/* ==========================================================================*/\n7598\t\n7599\t/* Loop for handling unanchored repeated matching attempts; for anchored regexs\n7600\tthe loop runs just once. */\n7601\t\n7602\t#ifdef SUPPORT_UNICODE\n7603\tFRAGMENT_RESTART:\n7604\t#endif\n7605\t\n7606\tstart_partial = match_partial = NULL;\n7607\tmb->hitend = FALSE;\n7608\t\n7609\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7610\tmemchr_found_first_cu = NULL;\n7611\tmemchr_found_first_cu2 = NULL;\n7612\t#endif\n7613\t\n7614\tfor(;;)\n7615\t  {\n7616\t  PCRE2_SPTR new_start_match;\n7617\t\n7618\t  /* ----------------- Start of match optimizations ---------------- */\n7619\t\n7620\t  /* There are some optimizations that avoid running the match if a known\n7621\t  starting point is not found, or if a known later code unit is not present.\n7622\t  However, there is an option (settable at compile time) that disables these,\n7623\t  for testing and for ensuring that all callouts do actually occur. */\n7624\t\n7625\t  if ((re->optimization_flags & PCRE2_OPTIM_START_OPTIMIZE) != 0)\n7626\t    {\n7627\t    /* If firstline is TRUE, the start of the match is constrained to the first\n7628\t    line of a multiline string. That is, the match must be before or at the\n7629\t    first newline following the start of matching. Temporarily adjust\n7630\t    end_subject so that we stop the scans for a first code unit at a newline.\n7631\t    If the match fails at the newline, later code breaks the loop. */\n7632\t\n7633\t    if (firstline)\n7634\t      {\n7635\t      PCRE2_SPTR t = start_match;\n7636\t#ifdef SUPPORT_UNICODE\n7637\t      if (utf)\n7638\t        {\n7639\t        while (t < end_subject && !IS_NEWLINE(t))\n7640\t          {\n7641\t          t++;\n7642\t          ACROSSCHAR(t < end_subject, t, t++);\n7643\t          }\n7644\t        }\n7645\t      else\n7646\t#endif\n7647\t      while (t < end_subject && !IS_NEWLINE(t)) t++;\n7648\t      end_subject = t;\n7649\t      }\n7650\t\n7651\t    /* Anchored: check the first code unit if one is recorded. This may seem\n7652\t    pointless but it can help in detecting a no match case without scanning for\n7653\t    the required code unit. */\n7654\t\n7655\t    if (anchored)\n7656\t      {\n7657\t      if (has_first_cu || start_bits != NULL)\n7658\t        {\n7659\t        BOOL ok = start_match < end_subject;\n7660\t        if (ok)\n7661\t          {\n7662\t          PCRE2_UCHAR c = *start_match;\n7663\t          ok = has_first_cu && (c == first_cu || c == first_cu2);\n7664\t          if (!ok && start_bits != NULL)\n7665\t            {\n7666\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7667\t            if (c > 255) c = 255;\n7668\t#endif\n7669\t            ok = (start_bits[c/8] & (1u << (c&7))) != 0;\n7670\t            }\n7671\t          }\n7672\t        if (!ok)\n7673\t          {\n7674\t          rc = MATCH_NOMATCH;\n7675\t          break;\n7676\t          }\n7677\t        }\n7678\t      }\n7679\t\n7680\t    /* Not anchored. Advance to a unique first code unit if there is one. */\n7681\t\n7682\t    else\n7683\t      {\n7684\t      if (has_first_cu)\n7685\t        {\n7686\t        if (first_cu != first_cu2)  /* Caseless */\n7687\t          {\n7688\t          /* In 16-bit and 32_bit modes we have to do our own search, so can\n7689\t          look for both cases at once. */\n7690\t\n7691\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7692\t          PCRE2_UCHAR smc;\n7693\t          while (start_match < end_subject &&\n7694\t                (smc = *start_match) != first_cu &&\n7695\t                 smc != first_cu2)\n7696\t            start_match++;\n7697\t#else\n7698\t          /* In 8-bit mode, the use of memchr() gives a big speed up, even\n7699\t          though we have to call it twice in order to find the earliest\n7700\t          occurrence of the code unit in either of its cases. Caching is used\n7701\t          to remember the positions of previously found code units. This can\n7702\t          make a huge difference when the strings are very long and only one\n7703\t          case is actually present. */\n7704\t\n7705\t          PCRE2_SPTR pp1 = NULL;\n7706\t          PCRE2_SPTR pp2 = NULL;\n7707\t          PCRE2_SIZE searchlength = end_subject - start_match;\n7708\t\n7709\t          /* If we haven't got a previously found position for first_cu, or if\n7710\t          the current starting position is later, we need to do a search. If\n7711\t          the code unit is not found, set it to the end. */\n7712\t\n7713\t          if (memchr_found_first_cu == NULL ||\n7714\t              start_match > memchr_found_first_cu)\n7715\t            {\n7716\t            pp1 = memchr(start_match, first_cu, searchlength);\n7717\t            memchr_found_first_cu = (pp1 == NULL)? end_subject : pp1;\n7718\t            }\n7719\t\n7720\t          /* If the start is before a previously found position, use the\n7721\t          previous position, or NULL if a previous search failed. */\n7722\t\n7723\t          else pp1 = (memchr_found_first_cu == end_subject)? NULL :\n7724\t            memchr_found_first_cu;\n7725\t\n7726\t          /* Do the same thing for the other case. */\n7727\t\n7728\t          if (memchr_found_first_cu2 == NULL ||\n7729\t              start_match > memchr_found_first_cu2)\n7730\t            {\n7731\t            pp2 = memchr(start_match, first_cu2, searchlength);\n7732\t            memchr_found_first_cu2 = (pp2 == NULL)? end_subject : pp2;\n7733\t            }\n7734\t\n7735\t          else pp2 = (memchr_found_first_cu2 == end_subject)? NULL :\n7736\t            memchr_found_first_cu2;\n7737\t\n7738\t          /* Set the start to the end of the subject if neither case was found.\n7739\t          Otherwise, use the earlier found point. */\n7740\t\n7741\t          if (pp1 == NULL)\n7742\t            start_match = (pp2 == NULL)? end_subject : pp2;\n7743\t          else\n7744\t            start_match = (pp2 == NULL || pp1 < pp2)? pp1 : pp2;\n7745\t\n7746\t#endif  /* 8-bit handling */\n7747\t          }\n7748\t\n7749\t        /* The caseful case is much simpler. */\n7750\t\n7751\t        else\n7752\t          {\n7753\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7754\t          while (start_match < end_subject && *start_match !=\n7755\t                 first_cu)\n7756\t            start_match++;\n7757\t#else\n7758\t          start_match = memchr(start_match, first_cu, end_subject - start_match);\n7759\t          if (start_match == NULL) start_match = end_subject;\n7760\t#endif\n7761\t          }\n7762\t\n7763\t        /* If we can't find the required first code unit, having reached the\n7764\t        true end of the subject, break the bumpalong loop, to force a match\n7765\t        failure, except when doing partial matching, when we let the next cycle\n7766\t        run at the end of the subject. To see why, consider the pattern\n7767\t        /(?<=abc)def/, which partially matches \"abc\", even though the string\n7768\t        does not contain the starting character \"d\". If we have not reached the\n7769\t        true end of the subject (PCRE2_FIRSTLINE caused end_subject to be\n7770\t        temporarily modified) we also let the cycle run, because the matching\n7771\t        string is legitimately allowed to start with the first code unit of a\n7772\t        newline. */\n7773\t\n7774\t        if (mb->partial == 0 && start_match >= mb->end_subject)\n7775\t          {\n7776\t          rc = MATCH_NOMATCH;\n7777\t          break;\n7778\t          }\n7779\t        }\n7780\t\n7781\t      /* If there's no first code unit, advance to just after a linebreak for a\n7782\t      multiline match if required. */\n7783\t\n7784\t      else if (startline)\n7785\t        {\n7786\t        if (start_match > mb->start_subject + start_offset)\n7787\t          {\n7788\t#ifdef SUPPORT_UNICODE\n7789\t          if (utf)\n7790\t            {\n7791\t            while (start_match < end_subject && !WAS_NEWLINE(start_match))\n7792\t              {\n7793\t              start_match++;\n7794\t              ACROSSCHAR(start_match < end_subject, start_match, start_match++);\n7795\t              }\n7796\t            }\n7797\t          else\n7798\t#endif\n7799\t          while (start_match < end_subject && !WAS_NEWLINE(start_match))\n7800\t            start_match++;\n7801\t\n7802\t          /* If we have just passed a CR and the newline option is ANY or\n7803\t          ANYCRLF, and we are now at a LF, advance the match position by one\n7804\t          more code unit. */\n7805\t\n7806\t          if (start_match[-1] == CHAR_CR &&\n7807\t               (mb->nltype == NLTYPE_ANY || mb->nltype == NLTYPE_ANYCRLF) &&\n7808\t               start_match < end_subject &&\n7809\t               *start_match == CHAR_NL)\n7810\t            start_match++;\n7811\t          }\n7812\t        }\n7813\t\n7814\t      /* If there's no first code unit or a requirement for a multiline line\n7815\t      start, advance to a non-unique first code unit if any have been\n7816\t      identified. The bitmap contains only 256 bits. When code units are 16 or\n7817\t      32 bits wide, all code units greater than 254 set the 255 bit. */\n7818\t\n7819\t      else if (start_bits != NULL)\n7820\t        {\n7821\t        while (start_match < end_subject)\n7822\t          {\n7823\t          uint32_t c = *start_match;\n7824\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7825\t          if (c > 255) c = 255;\n7826\t#endif\n7827\t          if ((start_bits[c/8] & (1u << (c&7))) != 0) break;\n7828\t          start_match++;\n7829\t          }\n7830\t\n7831\t        /* See comment above in first_cu checking about the next few lines. */\n7832\t\n7833\t        if (mb->partial == 0 && start_match >= mb->end_subject)\n7834\t          {\n7835\t          rc = MATCH_NOMATCH;\n7836\t          break;\n7837\t          }\n7838\t        }\n7839\t      }   /* End first code unit handling */\n7840\t\n7841\t    /* Restore fudged end_subject */\n7842\t\n7843\t    end_subject = mb->end_subject;\n7844\t\n7845\t    /* The following two optimizations must be disabled for partial matching. */\n7846\t\n7847\t    if (mb->partial == 0)\n7848\t      {\n7849\t      PCRE2_SPTR p;\n7850\t\n7851\t      /* The minimum matching length is a lower bound; no string of that length\n7852\t      may actually match the pattern. Although the value is, strictly, in\n7853\t      characters, we treat it as code units to avoid spending too much time in\n7854\t      this optimization. */\n7855\t\n7856\t      if (end_subject - start_match < re->minlength)\n7857\t        {\n7858\t        rc = MATCH_NOMATCH;\n7859\t        break;\n7860\t        }\n7861\t\n7862\t      /* If req_cu is set, we know that that code unit must appear in the\n7863\t      subject for the (non-partial) match to succeed. If the first code unit is\n7864\t      set, req_cu must be later in the subject; otherwise the test starts at\n7865\t      the match point. This optimization can save a huge amount of backtracking\n7866\t      in patterns with nested unlimited repeats that aren't going to match.\n7867\t      Writing separate code for caseful/caseless versions makes it go faster,\n7868\t      as does using an autoincrement and backing off on a match. As in the case\n7869\t      of the first code unit, using memchr() in the 8-bit library gives a big\n7870\t      speed up. Unlike the first_cu check above, we do not need to call\n7871\t      memchr() twice in the caseless case because we only need to check for the\n7872\t      presence of the character in either case, not find the first occurrence.\n7873\t\n7874\t      The search can be skipped if the code unit was found later than the\n7875\t      current starting point in a previous iteration of the bumpalong loop.\n7876\t\n7877\t      HOWEVER: when the subject string is very, very long, searching to its end\n7878\t      can take a long time, and give bad performance on quite ordinary\n7879\t      anchored patterns. This showed up when somebody was matching something\n7880\t      like /^\\d+C/ on a 32-megabyte string... so we don't do this when the\n7881\t      string is sufficiently long, but it's worth searching a lot more for\n7882\t      unanchored patterns. */\n7883\t\n7884\t      p = start_match + (has_first_cu? 1:0);\n7885\t      if (has_req_cu && p > req_cu_ptr)\n7886\t        {\n7887\t        PCRE2_SIZE check_length = end_subject - start_match;\n7888\t\n7889\t        if (check_length < REQ_CU_MAX ||\n7890\t              (!anchored && check_length < REQ_CU_MAX * 1000))\n7891\t          {\n7892\t          if (req_cu != req_cu2)  /* Caseless */\n7893\t            {\n7894\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7895\t            while (p < end_subject)\n7896\t              {\n7897\t              uint32_t pp = *p++;\n7898\t              if (pp == req_cu || pp == req_cu2) { p--; break; }\n7899\t              }\n7900\t#else  /* 8-bit code units */\n7901\t            PCRE2_SPTR pp = p;\n7902\t            p = memchr(pp, req_cu, end_subject - pp);\n7903\t            if (p == NULL)\n7904\t              {\n7905\t              p = memchr(pp, req_cu2, end_subject - pp);\n7906\t              if (p == NULL) p = end_subject;\n7907\t              }\n7908\t#endif /* PCRE2_CODE_UNIT_WIDTH != 8 */\n7909\t            }\n7910\t\n7911\t          /* The caseful case */\n7912\t\n7913\t          else\n7914\t            {\n7915\t#if PCRE2_CODE_UNIT_WIDTH != 8\n7916\t            while (p < end_subject)\n7917\t              {\n7918\t              if (*p++ == req_cu) { p--; break; }\n7919\t              }\n7920\t\n7921\t#else  /* 8-bit code units */\n7922\t            p = memchr(p, req_cu, end_subject - p);\n7923\t            if (p == NULL) p = end_subject;\n7924\t#endif\n7925\t            }\n7926\t\n7927\t          /* If we can't find the required code unit, break the bumpalong loop,\n7928\t          forcing a match failure. */\n7929\t\n7930\t          if (p >= end_subject)\n7931\t            {\n7932\t            rc = MATCH_NOMATCH;\n7933\t            break;\n7934\t            }\n7935\t\n7936\t          /* If we have found the required code unit, save the point where we\n7937\t          found it, so that we don't search again next time round the bumpalong\n7938\t          loop if the start hasn't yet passed this code unit. */\n7939\t\n7940\t          req_cu_ptr = p;\n7941\t          }\n7942\t        }\n7943\t      }\n7944\t    }\n7945\t\n7946\t  /* ------------ End of start of match optimizations ------------ */\n7947\t\n7948\t  /* Give no match if we have passed the bumpalong limit. */\n7949\t\n7950\t  if (start_match > bumpalong_limit)\n7951\t    {\n7952\t    rc = MATCH_NOMATCH;\n7953\t    break;\n7954\t    }\n7955\t\n7956\t  /* OK, we can now run the match. If \"hitend\" is set afterwards, remember the\n7957\t  first starting point for which a partial match was found. */\n7958\t\n7959\t  cb.start_match = (PCRE2_SIZE)(start_match - subject);\n7960\t  cb.callout_flags |= PCRE2_CALLOUT_STARTMATCH;\n7961\t\n7962\t  mb->start_used_ptr = start_match;\n7963\t  mb->last_used_ptr = start_match;\n7964\t#ifdef SUPPORT_UNICODE\n7965\t  mb->moptions = options | fragment_options;\n7966\t#else\n7967\t  mb->moptions = options;\n7968\t#endif\n7969\t  mb->match_call_count = 0;\n7970\t  mb->end_offset_top = 0;\n7971\t  mb->skip_arg_count = 0;\n7972\t\n7973\t#ifdef DEBUG_SHOW_OPS\n7974\t  fprintf(stderr, \"++ Calling match()\\n\");\n7975\t#endif\n7976\t\n7977\t  rc = match(start_match, mb->start_code, re->top_bracket, frame_size,\n7978\t    match_data, mb);\n7979\t\n7980\t#ifdef DEBUG_SHOW_OPS\n7981\t  fprintf(stderr, \"++ match() returned %d\\n\\n\", rc);\n7982\t#endif\n7983\t\n7984\t  if (mb->hitend && start_partial == NULL)\n7985\t    {\n7986\t    start_partial = mb->start_used_ptr;\n7987\t    match_partial = start_match;\n7988\t    }\n7989\t\n7990\t  switch(rc)\n7991\t    {\n7992\t    /* If MATCH_SKIP_ARG reaches this level it means that a MARK that matched\n7993\t    the SKIP's arg was not found. In this circumstance, Perl ignores the SKIP\n7994\t    entirely. The only way we can do that is to re-do the match at the same\n7995\t    point, with a flag to force SKIP with an argument to be ignored. Just\n7996\t    treating this case as NOMATCH does not work because it does not check other\n7997\t    alternatives in patterns such as A(*SKIP:A)B|AC when the subject is AC. */\n7998\t\n7999\t    case MATCH_SKIP_ARG:\n8000\t    new_start_match = start_match;\n8001\t    mb->ignore_skip_arg = mb->skip_arg_count;\n8002\t    break;\n8003\t\n8004\t    /* SKIP passes back the next starting point explicitly, but if it is no\n8005\t    greater than the match we have just done, treat it as NOMATCH. */\n8006\t\n8007\t    case MATCH_SKIP:\n8008\t    if (mb->verb_skip_ptr > start_match)\n8009\t      {\n8010\t      new_start_match = mb->verb_skip_ptr;\n8011\t      break;\n8012\t      }\n8013\t    PCRE2_FALLTHROUGH /* Fall through */\n8014\t\n8015\t    /* NOMATCH and PRUNE advance by one character. THEN at this level acts\n8016\t    exactly like PRUNE. Unset ignore SKIP-with-argument. */\n8017\t\n8018\t    case MATCH_NOMATCH:\n8019\t    case MATCH_PRUNE:\n8020\t    case MATCH_THEN:\n8021\t    mb->ignore_skip_arg = 0;\n8022\t    new_start_match = start_match + 1;\n8023\t#ifdef SUPPORT_UNICODE\n8024\t    if (utf)\n8025\t      ACROSSCHAR(new_start_match < end_subject, new_start_match,\n8026\t        new_start_match++);\n8027\t#endif\n8028\t    break;\n8029\t\n8030\t    /* COMMIT disables the bumpalong, but otherwise behaves as NOMATCH. */\n8031\t\n8032\t    case MATCH_COMMIT:\n8033\t    rc = MATCH_NOMATCH;\n8034\t    goto ENDLOOP;\n8035\t\n8036\t    /* Any other return is either a match, or some kind of error. */\n8037\t\n8038\t    default:\n8039\t    goto ENDLOOP;\n8040\t    }\n8041\t\n8042\t  /* Control reaches here for the various t