{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JWYNQwPPk7wgsPRT5NtA4j","type":"tool_result","content":"1841\t  OP_CBRA,           /* 139 Start of capturing bracket */\n1842\t  OP_CBRAPOS,        /* 140 Ditto, with unlimited, possessive repeat */\n1843\t  OP_COND,           /* 141 Conditional group */\n1844\t\n1845\t  /* These five must follow the previous five, in the same order. There's a\n1846\t  check for >= SBRA to distinguish the two sets. */\n1847\t\n1848\t  OP_SBRA,           /* 142 Start of non-capturing bracket, check empty  */\n1849\t  OP_SBRAPOS,        /* 143 Ditto, with unlimited, possessive repeat */\n1850\t  OP_SCBRA,          /* 144 Start of capturing bracket, check empty */\n1851\t  OP_SCBRAPOS,       /* 145 Ditto, with unlimited, possessive repeat */\n1852\t  OP_SCOND,          /* 146 Conditional group, check empty */\n1853\t\n1854\t  /* The next two pairs must (respectively) be kept together. */\n1855\t\n1856\t  OP_CREF,           /* 147 Used to hold a capture number as condition */\n1857\t  OP_DNCREF,         /* 148 Used to point to duplicate names as a condition */\n1858\t  OP_RREF,           /* 149 Used to hold a recursion number as condition */\n1859\t  OP_DNRREF,         /* 150 Used to point to duplicate names as a condition */\n1860\t  OP_FALSE,          /* 151 Always false (used by DEFINE and VERSION) */\n1861\t  OP_TRUE,           /* 152 Always true (used by VERSION) */\n1862\t\n1863\t  OP_BRAZERO,        /* 153 These two must remain together and in this */\n1864\t  OP_BRAMINZERO,     /* 154 order. */\n1865\t  OP_BRAPOSZERO,     /* 155 */\n1866\t\n1867\t  /* These are backtracking control verbs */\n1868\t\n1869\t  OP_MARK,           /* 156 always has an argument */\n1870\t  OP_PRUNE,          /* 157 */\n1871\t  OP_PRUNE_ARG,      /* 158 same, but with argument */\n1872\t  OP_SKIP,           /* 159 */\n1873\t  OP_SKIP_ARG,       /* 160 same, but with argument */\n1874\t  OP_THEN,           /* 161 */\n1875\t  OP_THEN_ARG,       /* 162 same, but with argument */\n1876\t  OP_COMMIT,         /* 163 */\n1877\t  OP_COMMIT_ARG,     /* 164 same, but with argument */\n1878\t\n1879\t  /* These are forced failure and success verbs. FAIL and ACCEPT do accept an\n1880\t  argument, but these cases can be compiled as, for example, (*MARK:X)(*FAIL)\n1881\t  without the need for a special opcode. */\n1882\t\n1883\t  OP_FAIL,           /* 165 */\n1884\t  OP_ACCEPT,         /* 166 */\n1885\t  OP_ASSERT_ACCEPT,  /* 167 Used inside assertions */\n1886\t  OP_CLOSE,          /* 168 Used before OP_ACCEPT to close open captures */\n1887\t\n1888\t  /* This is used to skip a subpattern with a {0} quantifier */\n1889\t\n1890\t  OP_SKIPZERO,       /* 169 */\n1891\t\n1892\t  /* This is used to identify a DEFINE group during compilation so that it can\n1893\t  be checked for having only one branch. It is changed to OP_FALSE before\n1894\t  compilation finishes. */\n1895\t\n1896\t  OP_DEFINE,         /* 170 */\n1897\t\n1898\t  /* These opcodes replace their normal counterparts in UCP mode when\n1899\t  PCRE2_EXTRA_ASCII_BSW is not set. */\n1900\t\n1901\t  OP_NOT_UCP_WORD_BOUNDARY, /* 171 */\n1902\t  OP_UCP_WORD_BOUNDARY,     /* 172 */\n1903\t\n1904\t  /* This is not an opcode, but is used to check that tables indexed by opcode\n1905\t  are the correct length, in order to catch updating errors - there have been\n1906\t  some in the past. */\n1907\t\n1908\t  OP_TABLE_LENGTH\n1909\t\n1910\t};\n1911\t\n1912\t/* *** NOTE NOTE NOTE *** Whenever the list above is updated, the two macro\n1913\tdefinitions that follow must also be updated to match. There are also tables\n1914\tcalled \"opcode_possessify\" in pcre2_compile.c and \"coptable\" and \"poptable\" in\n1915\tpcre2_dfa_match.c that must be updated. */\n1916\t\n1917\t\n1918\t/* This macro defines textual names for all the opcodes. These are used only\n1919\tfor debugging, and some of them are only partial names. The macro is referenced\n1920\tonly in pcre2_printint_inc.h, which fills out the full names in many cases (and in\n1921\tsome cases doesn't actually use these names at all). */\n1922\t\n1923\t#define OP_NAME_LIST \\\n1924\t  \"End\", \"\\\\A\", \"\\\\G\", \"\\\\K\", \"\\\\B\", \"\\\\b\", \"\\\\D\", \"\\\\d\",         \\\n1925\t  \"\\\\S\", \"\\\\s\", \"\\\\W\", \"\\\\w\", \"Any\", \"AllAny\", \"Anybyte\",         \\\n1926\t  \"notprop\", \"prop\", \"\\\\R\", \"\\\\H\", \"\\\\h\", \"\\\\V\", \"\\\\v\",           \\\n1927\t  \"extuni\",  \"\\\\Z\", \"\\\\z\",                                        \\\n1928\t  \"$\", \"$\", \"^\", \"^\", \"char\", \"chari\", \"not\", \"noti\",             \\\n1929\t  \"*\", \"*?\", \"+\", \"+?\", \"?\", \"??\",                                \\\n1930\t  \"{\", \"{\", \"{\",                                                  \\\n1931\t  \"*+\",\"++\", \"?+\", \"{\",                                           \\\n1932\t  \"*\", \"*?\", \"+\", \"+?\", \"?\", \"??\",                                \\\n1933\t  \"{\", \"{\", \"{\",                                                  \\\n1934\t  \"*+\",\"++\", \"?+\", \"{\",                                           \\\n1935\t  \"*\", \"*?\", \"+\", \"+?\", \"?\", \"??\",                                \\\n1936\t  \"{\", \"{\", \"{\",                                                  \\\n1937\t  \"*+\",\"++\", \"?+\", \"{\",                                           \\\n1938\t  \"*\", \"*?\", \"+\", \"+?\", \"?\", \"??\",                                \\\n1939\t  \"{\", \"{\", \"{\",                                                  \\\n1940\t  \"*+\",\"++\", \"?+\", \"{\",                                           \\\n1941\t  \"*\", \"*?\", \"+\", \"+?\", \"?\", \"??\", \"{\", \"{\", \"{\",                 \\\n1942\t  \"*+\",\"++\", \"?+\", \"{\",                                           \\\n1943\t  \"*\", \"*?\", \"+\", \"+?\", \"?\", \"??\", \"{\", \"{\",                      \\\n1944\t  \"*+\",\"++\", \"?+\", \"{\",                                           \\\n1945\t  \"class\", \"nclass\", \"xclass\", \"eclass\",                          \\\n1946\t  \"Ref\", \"Refi\", \"DnRef\", \"DnRefi\",                               \\\n1947\t  \"Recurse\", \"Callout\", \"CalloutStr\",                             \\\n1948\t  \"Alt\", \"Ket\", \"KetRmax\", \"KetRmin\", \"KetRpos\",                  \\\n1949\t  \"Reverse\", \"VReverse\", \"Assert\", \"Assert not\",                  \\\n1950\t  \"Assert back\", \"Assert back not\",                               \\\n1951\t  \"Non-atomic assert\", \"Non-atomic assert back\",                  \\\n1952\t  \"Scan substring\",                                               \\\n1953\t  \"Once\",                                                         \\\n1954\t  \"Script run\",                                                   \\\n1955\t  \"Bra\", \"BraPos\", \"CBra\", \"CBraPos\",                             \\\n1956\t  \"Cond\",                                                         \\\n1957\t  \"SBra\", \"SBraPos\", \"SCBra\", \"SCBraPos\",                         \\\n1958\t  \"SCond\",                                                        \\\n1959\t  \"Capture ref\", \"Capture dnref\", \"Cond rec\", \"Cond dnrec\",       \\\n1960\t  \"Cond false\", \"Cond true\",                                      \\\n1961\t  \"Brazero\", \"Braminzero\", \"Braposzero\",                          \\\n1962\t  \"*MARK\", \"*PRUNE\", \"*PRUNE\", \"*SKIP\", \"*SKIP\",                  \\\n1963\t  \"*THEN\", \"*THEN\", \"*COMMIT\", \"*COMMIT\", \"*FAIL\",                \\\n1964\t  \"*ACCEPT\", \"*ASSERT_ACCEPT\",                                    \\\n1965\t  \"Close\", \"Skip zero\", \"Define\", \"\\\\B (ucp)\", \"\\\\b (ucp)\"\n1966\t\n1967\t\n1968\t/* This macro defines the length of fixed length operations in the compiled\n1969\tregex. The lengths are used when searching for specific things, and also in the\n1970\tdebugging printing of a compiled regex. We use a macro so that it can be\n1971\tdefined close to the definitions of the opcodes themselves.\n1972\t\n1973\tAs things have been extended, some of these are no longer fixed lenths, but are\n1974\tminima instead. For example, the length of a single-character repeat may vary\n1975\tin UTF-8 mode. The code that uses this table must know about such things. */\n1976\t\n1977\t#define OP_LENGTHS \\\n1978\t  1,                             /* End                                    */ \\\n1979\t  1, 1, 1, 1, 1,                 /* \\A, \\G, \\K, \\B, \\b                     */ \\\n1980\t  1, 1, 1, 1, 1, 1,              /* \\D, \\d, \\S, \\s, \\W, \\w                 */ \\\n1981\t  1, 1, 1,                       /* Any, AllAny, Anybyte                   */ \\\n1982\t  3, 3,                          /* \\P, \\p                                 */ \\\n1983\t  1, 1, 1, 1, 1,                 /* \\R, \\H, \\h, \\V, \\v                     */ \\\n1984\t  1,                             /* \\X                                     */ \\\n1985\t  1, 1, 1, 1, 1, 1,              /* \\Z, \\z, $, $M ^, ^M                    */ \\\n1986\t  2,                             /* Char  - the minimum length             */ \\\n1987\t  2,                             /* Chari  - the minimum length            */ \\\n1988\t  2,                             /* not                                    */ \\\n1989\t  2,                             /* noti                                   */ \\\n1990\t  /* Positive single-char repeats                             ** These are */ \\\n1991\t  2, 2, 2, 2, 2, 2,              /* *, *?, +, +?, ?, ??       ** minima in */ \\\n1992\t  2+IMM2_SIZE, 2+IMM2_SIZE,      /* upto, minupto             ** mode      */ \\\n1993\t  2+IMM2_SIZE,                   /* exact                                  */ \\\n1994\t  2, 2, 2, 2+IMM2_SIZE,          /* *+, ++, ?+, upto+                      */ \\\n1995\t  2, 2, 2, 2, 2, 2,              /* *I, *?I, +I, +?I, ?I, ??I ** UTF-8     */ \\\n1996\t  2+IMM2_SIZE, 2+IMM2_SIZE,      /* upto I, minupto I                      */ \\\n1997\t  2+IMM2_SIZE,                   /* exact I                                */ \\\n1998\t  2, 2, 2, 2+IMM2_SIZE,          /* *+I, ++I, ?+I, upto+I                  */ \\\n1999\t  /* Negative single-char repeats - only for chars < 256                   */ \\\n2000\t  2, 2, 2, 2, 2, 2,              /* NOT *, *?, +, +?, ?, ??                */ \\\n2001\t  2+IMM2_SIZE, 2+IMM2_SIZE,      /* NOT upto, minupto                      */ \\\n2002\t  2+IMM2_SIZE,                   /* NOT exact                              */ \\\n2003\t  2, 2, 2, 2+IMM2_SIZE,          /* Possessive NOT *, +, ?, upto           */ \\\n2004\t  2, 2, 2, 2, 2, 2,              /* NOT *I, *?I, +I, +?I, ?I, ??I          */ \\\n2005\t  2+IMM2_SIZE, 2+IMM2_SIZE,      /* NOT upto I, minupto I                  */ \\\n2006\t  2+IMM2_SIZE,                   /* NOT exact I                            */ \\\n2007\t  2, 2, 2, 2+IMM2_SIZE,          /* Possessive NOT *I, +I, ?I, upto I      */ \\\n2008\t  /* Positive type repeats                                                 */ \\\n2009\t  2, 2, 2, 2, 2, 2,              /* Type *, *?, +, +?, ?, ??               */ \\\n2010\t  2+IMM2_SIZE, 2+IMM2_SIZE,      /* Type upto, minupto                     */ \\\n2011\t  2+IMM2_SIZE,                   /* Type exact                             */ \\\n2012\t  2, 2, 2, 2+IMM2_SIZE,          /* Possessive *+, ++, ?+, upto+           */ \\\n2013\t  /* Character class & ref repeats                                         */ \\\n2014\t  1, 1, 1, 1, 1, 1,              /* *, *?, +, +?, ?, ??                    */ \\\n2015\t  1+2*IMM2_SIZE, 1+2*IMM2_SIZE,  /* CRRANGE, CRMINRANGE                    */ \\\n2016\t  1, 1, 1, 1+2*IMM2_SIZE,        /* Possessive *+, ++, ?+, CRPOSRANGE      */ \\\n2017\t  1+(32/sizeof(PCRE2_UCHAR)),    /* CLASS                                  */ \\\n2018\t  1+(32/sizeof(PCRE2_UCHAR)),    /* NCLASS                                 */ \\\n2019\t  0,                             /* XCLASS - variable length               */ \\\n2020\t  0,                             /* ECLASS - variable length               */ \\\n2021\t  1+IMM2_SIZE,                   /* REF                                    */ \\\n2022\t  1+IMM2_SIZE+1,                 /* REFI                                   */ \\\n2023\t  1+2*IMM2_SIZE,                 /* DNREF                                  */ \\\n2024\t  1+2*IMM2_SIZE+1,               /* DNREFI                                 */ \\\n2025\t  1+LINK_SIZE,                   /* RECURSE                                */ \\\n2026\t  1+2*LINK_SIZE+1,               /* CALLOUT                                */ \\\n2027\t  0,                             /* CALLOUT_STR - variable length          */ \\\n2028\t  1+LINK_SIZE,                   /* Alt                                    */ \\\n2029\t  1+LINK_SIZE,                   /* Ket                                    */ \\\n2030\t  1+LINK_SIZE,                   /* KetRmax                                */ \\\n2031\t  1+LINK_SIZE,                   /* KetRmin                                */ \\\n2032\t  1+LINK_SIZE,                   /* KetRpos                                */ \\\n2033\t  1+IMM2_SIZE,                   /* Reverse                                */ \\\n2034\t  1+2*IMM2_SIZE,                 /* VReverse                               */ \\\n2035\t  1+LINK_SIZE,                   /* Assert                                 */ \\\n2036\t  1+LINK_SIZE,                   /* Assert not                             */ \\\n2037\t  1+LINK_SIZE,                   /* Assert behind                          */ \\\n2038\t  1+LINK_SIZE,                   /* Assert behind not                      */ \\\n2039\t  1+LINK_SIZE,                   /* NA Assert                              */ \\\n2040\t  1+LINK_SIZE,                   /* NA Assert behind                       */ \\\n2041\t  1+LINK_SIZE,                   /* Scan substring                         */ \\\n2042\t  1+LINK_SIZE,                   /* ONCE                                   */ \\\n2043\t  1+LINK_SIZE,                   /* SCRIPT_RUN                             */ \\\n2044\t  1+LINK_SIZE,                   /* BRA                                    */ \\\n2045\t  1+LINK_SIZE,                   /* BRAPOS                                 */ \\\n2046\t  1+LINK_SIZE+IMM2_SIZE,         /* CBRA                                   */ \\\n2047\t  1+LINK_SIZE+IMM2_SIZE,         /* CBRAPOS                                */ \\\n2048\t  1+LINK_SIZE,                   /* COND                                   */ \\\n2049\t  1+LINK_SIZE,                   /* SBRA                                   */ \\\n2050\t  1+LINK_SIZE,                   /* SBRAPOS                                */ \\\n2051\t  1+LINK_SIZE+IMM2_SIZE,         /* SCBRA                                  */ \\\n2052\t  1+LINK_SIZE+IMM2_SIZE,         /* SCBRAPOS                               */ \\\n2053\t  1+LINK_SIZE,                   /* SCOND                                  */ \\\n2054\t  1+IMM2_SIZE, 1+2*IMM2_SIZE,    /* CREF, DNCREF                           */ \\\n2055\t  1+IMM2_SIZE, 1+2*IMM2_SIZE,    /* RREF, DNRREF                           */ \\\n2056\t  1, 1,                          /* FALSE, TRUE                            */ \\\n2057\t  1, 1, 1,                       /* BRAZERO, BRAMINZERO, BRAPOSZERO        */ \\\n2058\t  3, 1, 3,                       /* MARK, PRUNE, PRUNE_ARG                 */ \\\n2059\t  1, 3,                          /* SKIP, SKIP_ARG                         */ \\\n2060\t  1, 3,                          /* THEN, THEN_ARG                         */ \\\n2061\t  1, 3,                          /* COMMIT, COMMIT_ARG                     */ \\\n2062\t  1, 1, 1,                       /* FAIL, ACCEPT, ASSERT_ACCEPT            */ \\\n2063\t  1+IMM2_SIZE, 1,                /* CLOSE, SKIPZERO                        */ \\\n2064\t  1,                             /* DEFINE                                 */ \\\n2065\t  1, 1                           /* \\B and \\b in UCP mode                  */\n2066\t\n2067\t/* A magic value for OP_RREF to indicate the \"any recursion\" condition. */\n2068\t\n2069\t#define RREF_ANY  0xffff\n2070\t\n2071\t/* Constants used by OP_REFI and OP_DNREFI to control matching behaviour. */\n2072\t\n2073\t#define REFI_FLAG_CASELESS_RESTRICT  0x1\n2074\t#define REFI_FLAG_TURKISH_CASING     0x2\n2075\t\n2076\t\n2077\t/* ---------- Private structures that are mode-independent. ---------- */\n2078\t\n2079\t/* Structure to hold data for custom memory management. */\n2080\t\n2081\ttypedef struct pcre2_memctl {\n2082\t  void *    (*malloc)(size_t, void *);\n2083\t  void      (*free)(void *, void *);\n2084\t  void      *memory_data;\n2085\t} pcre2_memctl;\n2086\t\n2087\t/* Structure for building a chain of open capturing subpatterns during\n2088\tcompiling, so that instructions to close them can be compiled when (*ACCEPT) is\n2089\tencountered. */\n2090\t\n2091\ttypedef struct open_capitem {\n2092\t  struct open_capitem *next;    /* Chain link */\n2093\t  uint16_t number;              /* Capture number */\n2094\t  uint16_t assert_depth;        /* Assertion depth when opened */\n2095\t} open_capitem;\n2096\t\n2097\t/* Layout of the UCP type table that translates property names into types and\n2098\tcodes. Each entry used to point directly to a name, but to reduce the number of\n2099\trelocations in shared libraries, it now has an offset into a single string\n2100\tinstead. */\n2101\t\n2102\ttypedef struct {\n2103\t  uint16_t name_offset;\n2104\t  uint16_t type;\n2105\t  uint16_t value;\n2106\t} ucp_type_table;\n2107\t\n2108\t/* Unicode character database (UCD) record format */\n2109\t\n2110\ttypedef struct {\n2111\t  uint8_t script;     /* ucp_Arabic, etc. */\n2112\t  uint8_t chartype;   /* ucp_Cc, etc. (general categories) */\n2113\t  uint8_t gbprop;     /* ucp_gbControl, etc. (grapheme break property) */\n2114\t  uint8_t caseset;    /* offset to multichar other cases or zero */\n2115\t  int32_t other_case; /* offset to other case, or zero if none */\n2116\t  uint16_t scriptx_bidiclass; /* script extension (11 bit) and bidi class (5 bit) values */\n2117\t  uint16_t bprops;    /* binary properties offset */\n2118\t} ucd_record;\n2119\t\n2120\t/* UCD access macros */\n2121\t\n2122\t#define UCD_BLOCK_SIZE 128\n2123\t#define REAL_GET_UCD(ch) (PRIV(ucd_records) + \\\n2124\t        PRIV(ucd_stage2)[PRIV(ucd_stage1)[(int)(ch) / UCD_BLOCK_SIZE] * \\\n2125\t        UCD_BLOCK_SIZE + (int)(ch) % UCD_BLOCK_SIZE])\n2126\t\n2127\t#if PCRE2_CODE_UNIT_WIDTH == 32\n2128\t#define GET_UCD(ch) ((ch > MAX_UTF_CODE_POINT)? \\\n2129\t  PRIV(dummy_ucd_record) : REAL_GET_UCD(ch))\n2130\t#else\n2131\t#define GET_UCD(ch) REAL_GET_UCD(ch)\n2132\t#endif\n2133\t\n2134\t#define UCD_SCRIPTX_MASK 0x3ff\n2135\t#define UCD_BIDICLASS_SHIFT 11\n2136\t#define UCD_BPROPS_MASK 0xfff\n2137\t\n2138\t#define UCD_SCRIPTX_PROP(prop) ((prop)->scriptx_bidiclass & UCD_SCRIPTX_MASK)\n2139\t#define UCD_BIDICLASS_PROP(prop) ((prop)->scriptx_bidiclass >> UCD_BIDICLASS_SHIFT)\n2140\t#define UCD_BPROPS_PROP(prop) ((prop)->bprops & UCD_BPROPS_MASK)\n2141\t\n2142\t#define UCD_CHARTYPE(ch)    GET_UCD(ch)->chartype\n2143\t#define UCD_SCRIPT(ch)      GET_UCD(ch)->script\n2144\t#define UCD_CATEGORY(ch)    PRIV(ucp_gentype)[UCD_CHARTYPE(ch)]\n2145\t#define UCD_GRAPHBREAK(ch)  GET_UCD(ch)->gbprop\n2146\t#define UCD_CASESET(ch)     GET_UCD(ch)->caseset\n2147\t#define UCD_OTHERCASE(ch)   ((uint32_t)((int)ch + (int)(GET_UCD(ch)->other_case)))\n2148\t#define UCD_SCRIPTX(ch)     UCD_SCRIPTX_PROP(GET_UCD(ch))\n2149\t#define UCD_BPROPS(ch)      UCD_BPROPS_PROP(GET_UCD(ch))\n2150\t#define UCD_BIDICLASS(ch)   UCD_BIDICLASS_PROP(GET_UCD(ch))\n2151\t#define UCD_ANY_I(ch) \\\n2152\t  /* match any of the four characters 'i', 'I', U+0130, U+0131 */ \\\n2153\t  (((uint32_t)(ch) | 0x20u) == 0x69u || ((uint32_t)(ch) | 1u) == 0x0131u)\n2154\t#define UCD_DOTTED_I(ch) \\\n2155\t  ((uint32_t)(ch) == 0x69u || (uint32_t)(ch) == 0x0130u)\n2156\t#define UCD_FOLD_I_TURKISH(ch) \\\n2157\t  ((uint32_t)(ch) == 0x0130u ?   0x69u : \\\n2158\t   (uint32_t)(ch) ==   0x49u ? 0x0131u : (uint32_t)(ch))\n2159\t\n2160\t/* The \"scriptx\" and bprops fields contain offsets into vectors of 32-bit words\n2161\tthat form a bitmap representing a list of scripts or boolean properties. These\n2162\tmacros test or set a bit in the map by number. */\n2163\t\n2164\t#define MAPBIT(map,n) ((map)[(n)/32]&(1u<<((n)%32)))\n2165\t#define MAPSET(map,n) ((map)[(n)/32]|=(1u<<((n)%32)))\n2166\t\n2167\t/* Header for serialized pcre2 codes. */\n2168\t\n2169\ttypedef struct pcre2_serialized_data {\n2170\t  uint32_t magic;\n2171\t  uint32_t version;\n2172\t  uint32_t config;\n2173\t  int32_t  number_of_codes;\n2174\t} pcre2_serialized_data;\n2175\t\n2176\t\n2177\t\n2178\t/* ----------------- Items that need PCRE2_CODE_UNIT_WIDTH ----------------- */\n2179\t\n2180\t/* When this file is included by pcre2test, PCRE2_CODE_UNIT_WIDTH is defined as\n2181\t0, so the following items are omitted. */\n2182\t\n2183\t#if defined PCRE2_CODE_UNIT_WIDTH && PCRE2_CODE_UNIT_WIDTH != 0\n2184\t\n2185\t/* EBCDIC is supported only for the 8-bit library. */\n2186\t\n2187\t#if defined EBCDIC && PCRE2_CODE_UNIT_WIDTH != 8\n2188\t#error EBCDIC is not supported for the 16-bit or 32-bit libraries\n2189\t#endif\n2190\t\n2191\t/* This is the largest non-UTF code point. */\n2192\t\n2193\t#define MAX_NON_UTF_CHAR (0xffffffffU >> (32 - PCRE2_CODE_UNIT_WIDTH))\n2194\t\n2195\t/* Internal shared data tables and variables. These are used by more than one\n2196\tof the exported public functions. They have to be \"external\" in the C sense,\n2197\tbut are not part of the PCRE2 public API. Although the data for some of them is\n2198\tidentical in all libraries, they must have different names so that multiple\n2199\tlibraries can be simultaneously linked to a single application. Howev