int_32,\n47\t    min_length: png_uint_32,\n48\t    pos_before: png_uint_32,\n49\t    pos_after: png_uint_32,\n50\t    multiple: png_uint_32,\n51\t) -> read_chunk_entry {\n52\t    read_chunk_entry { handler, max_length, min_length, pos_before, pos_after, multiple }\n53\t}\n54\t\n55\tpub(crate) static read_chunks: [read_chunk_entry; PNG_INDEX_unknown as usize] = [\n56\t    /*  0 IHDR */ RCE(Some(png_handle_IHDR),   13,     13,     hIHDR, 0,     0),\n57\t    /*  1 PLTE */ RCE(Some(png_handle_PLTE),   NoCheck, 0,     0,     hIHDR, 1),\n58\t    /*  2 IDAT */ RCE(None,                    NoCheck, 0,     aIDAT, hIHDR, 1),\n59\t    /*  3 IEND */ RCE(Some(png_handle_IEND),   NoCheck, 0,     0,     aIDAT, 0),\n60\t    /*  4 acTL */ RCE(None,                    8,       8,     hIDAT, hIHDR, 0),\n61\t    /*  5 bKGD */ RCE(Some(png_handle_bKGD),   6,       1,     hIDAT, hIHDR, 0),\n62\t    /*  6 cHRM */ RCE(Some(png_handle_cHRM),   32,      32,    hCOL,  hIHDR, 0),\n63\t    /*  7 cICP */ RCE(Some(png_handle_cICP),   4,       4,     hCOL,  hIHDR, 0),\n64\t    /*  8 cLLI */ RCE(Some(png_handle_cLLI),   8,       8,     hCOL,  hIHDR, 0),\n65\t    /*  9 eXIf */ RCE(Some(png_handle_eXIf),   Limit,   4,     0,     hIHDR, 0),\n66\t    /* 10 fcTL */ RCE(None,                    25,      26,    0,     hIHDR, 1),\n67\t    /* 11 fdAT */ RCE(None,                    Limit,   4,     hIDAT, hIHDR, 1),\n68\t    /* 12 gAMA */ RCE(Some(png_handle_gAMA),   4,       4,     hCOL,  hIHDR, 0),\n69\t    /* 13 hIST */ RCE(Some(png_handle_hIST),   1024,    0,     hPLTE, hIHDR, 0),\n70\t    /* 14 iCCP */ RCE(Some(png_handle_iCCP),   NoCheck, LKMin, hCOL,  hIHDR, 0),\n71\t    /* 15 iTXt */ RCE(Some(png_handle_iTXt),   NoCheck, 6,     0,     hIHDR, 1),\n72\t    /* 16 mDCV */ RCE(Some(png_handle_mDCV),   24,      24,    hCOL,  hIHDR, 0),\n73\t    /* 17 oFFs */ RCE(Some(png_handle_oFFs),   9,       9,     hIDAT, hIHDR, 0),\n74\t    /* 18 pCAL */ RCE(Some(png_handle_pCAL),   NoCheck, 14,    hIDAT, hIHDR, 0),\n