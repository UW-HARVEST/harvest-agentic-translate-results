n212\t    /* Check for flag values.  The main reason for having the old Mac value as a\n213\t     * flag is that it is pretty near impossible to work out what the correct\n214\t     * value is from Apple documentation - a working Mac system is needed to\n215\t     * discover the value!\n216\t     */\n217\t    if output_gamma == PNG_DEFAULT_sRGB || output_gamma == PNG_FP_1 / PNG_DEFAULT_sRGB {\n218\t        if is_screen != 0 {\n219\t            output_gamma = PNG_GAMMA_sRGB;\n220\t        } else {\n221\t            output_gamma = PNG_GAMMA_sRGB_INVERSE;\n222\t        }\n223\t    } else if output_gamma == PNG_GAMMA_MAC_18 || output_gamma == PNG_FP_1 / PNG_GAMMA_MAC_18 {\n224\t        if is_screen != 0 {\n225\t            output_gamma = PNG_GAMMA_MAC_OLD;\n226\t        } else {\n227\t            output_gamma = PNG_GAMMA_MAC_INVERSE;\n228\t        }\n229\t    }\n230\t\n231\t    output_gamma\n232\t}\n233\t\n234\t/* convert_gamma_value */\n235\tunsafe fn convert_gamma_value(png_ptr: png_structrp, mut output_gamma: f64) -> png_fixed_point {\n236\t    /* The following silently ignores cases where fixed point (times 100,000)\n237\t     * gamma values are passed to the floating point API.  This is safe and it\n238\t     * means the fixed point constants work just fine with the floating point\n239\t     * API.  The alternative would just lead to undetected errors and spurious\n240\t     * bug reports.  Negative values fail inside the _fixed API unless they\n241\t     * correspond to the flag values.\n242\t     */\n243\t    if output_gamma > 0. && output_gamma < 128. {\n244\t        output_gamma *= PNG_FP_1 as f64;\n245\t    }\n246\t\n247\t    /* This preserves -1 and -2 exactly: */\n248\t    output_gamma = floor(output_gamma + 0.5);\n249\t\n250\t    if output_gamma > PNG_FP_MAX as f64 || output_gamma < PNG_FP_MIN as f64 {\n251\t        png_fixed_error(png_ptr, b\"gamma value\\0\".as_ptr() as png_const_charp);\n252\t    }\n253\t\n254\t    output_gamma as png_fixed_point\n255\t}\n256\t\n257\t/* unsupported_gamma */\n258\tunsafe fn unsupported_gamma(png_ptr: png_structrp, gamma: png_fixed_point, warn: c_int) -> c_int {\n259\t    /* Validate a gamma value to ensure it is in a reasonable range.  The value\n260\t     * is expected to be 1 or greater, but this range test allows for some\n261\t     * viewing correction values.  The intent is to weed out the API users\n262\t     * who might use the inverse of the gamma value accidentally!\n263\t     *\n264\t     * 1.6.47: apply the test in png_set_gamma as well but only warn and return\n265\t     * false if it fires.\n266\t     *\n267\t     * TODO: 1.8: make this an app_error in png_set_gamma as well.\n268\t     */\n269\t    if gamma < PNG_LIB_GAMMA_MIN || gamma > PNG_LIB_GAMMA_MAX {\n270\t        /* #define msg \"gamma out of supported range\" */\n271\t        if warn != 0 {\n272\t            png_app_warning(\n273\t                png_ptr,\n274\t                b\"gamma out of supported range\\0\".as_ptr() as png_const_charp,\n275\t            );\n276\t        } else {\n277\t            png_app_error(\n278\t                png_ptr,\n279\t                b\"gamma out of supported range\\0\".as_ptr() as png_const_charp,\n280\t            );\n281\t        }\n282\t        return 1;\n283\t    }\n284\t\n285\t    0\n286\t}\n287\t\n288\t/* png_set_alpha_mode_fixed */\n289\t#[unsafe(no_mangle)]\n290\tpub unsafe extern \"C\" fn png_set_alpha_mode_fixed(\n291\t    png_ptr: png_structrp,\n292\t    mode: c_int,\n293\t    mut output_gamma: png_fixed_point,\n294\t) {\n295\t    let mut file_gamma: png_fixed_point;\n296\t    let mut compose: c_int = 0;\n297\t\n298\t    if png_rtran_ok(png_ptr, 0) == 0 {\n299\t        return;\n300\t    }\n301\t\n302\t    output_gamma = translate_gamma_flags(output_gamma, 1 /*screen*/);\n303\t    if unsupported_gamma(png_ptr, output_gamma, 0 /*error*/) != 0 {\n304\t        return;\n305\t    }\n306\t\n307\t    /* The default file gamma is the inverse of the output gamma; the output