s: after rowbytes=%lu ch=%d bd=%d ct=%d\\n\",tag,(unsigned long)png_get_rowbytes(p,ip),\n      png_get_channels(p,ip),png_get_bit_depth(p,ip),png_get_color_type(p,ip));\n   {\n     size_t rb = png_get_rowbytes(p,ip);\n     png_bytep *rows = malloc(sizeof(png_bytep)*h);\n     int pass, passes;\n     for(y=0;y<h;y++) rows[y]=calloc(1,rb+16);\n     if (seq==0) {\n       passes = png_set_interlace_handling(p);\n       for(pass=0;pass<passes;pass++) for(y=0;y<h;y++) png_read_row(p,rows[y],NULL);\n     } else if (seq==1) {\n       png_read_image(p,rows);\n     } else {\n       passes = png_set_interlace_handling(p);\n       for(pass=0;pass<passes;pass++) for(y=0;y<h;y++) png_read_row(p,NULL,rows[y]);\n     }\n     for(y=0;y<h;y++){acc=crcbuf(rows[y],rb)^(acc*5);total+=rb;}\n     for(y=0;y<h;y++)free(rows[y]);\n     free(rows);\n   }\n   png_read_end(p,ip);\n   printf(\"%s: total=%lu acc=%08lx rgbgray=%d\\n\",tag,(unsigned long)total,acc,png_get_rgb_to_gray_status(p));\n   png_destroy_read_struct(&p,&ip,NULL);\n}\n\n/* progressive */\nstatic png_uint_32 prog_acc, prog_rows;\nstatic void PNGCBAPI info_cb(png_structp p, png_infop ip){\n  printf(\"  prog info: %ux%u bd=%d ct=%d rowbytes=%lu\\n\",(unsigned)png_get_image_width(p,ip),\n     (unsigned)png_get_image_height(p,ip),png_get_bit_depth(p,ip),png_get_color_type(p,ip),\n     (unsigned long)png_get_rowbytes(p,ip));\n  png_start_read_image(p);\n}\nstatic void PNGCBAPI row_cb(png_structp p, png_bytep row, png_uint_32 rn, int pass){\n  (void)p; prog_rows++;\n  if(row) prog_acc = (prog_acc*7) ^ (png_uint_32)crcbuf(row, 8) ^ (rn*3+pass);\n}\nstatic void PNGCBAPI end_cb(png_structp p, png_infop ip){(void)p;(void)ip;printf(\"  prog end\\n\");}\n\nstatic void prog_read(const char*tag, membuf *src, size_t chunk)\n{\n   png_structp p; png_infop ip; size_t pos=0;\n   p=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n   ip=png_create_info_struct(p);\n   prog_acc=0;prog_rows=0;\n   if(setjmp(png_jmpbuf(p))){printf(\"%