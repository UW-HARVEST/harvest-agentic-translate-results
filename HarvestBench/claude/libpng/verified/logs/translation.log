n212\t    /* Check for flag values.  The main reason for having the old Mac value as a\n213\t     * flag is that it is pretty near impossible to work out what the correct\n214\t     * value is from Apple documentation - a working Mac system is needed to\n215\t     * discover the value!\n216\t     */\n217\t    if output_gamma == PNG_DEFAULT_sRGB || output_gamma == PNG_FP_1 / PNG_DEFAULT_sRGB {\n218\t        if is_screen != 0 {\n219\t            output_gamma = PNG_GAMMA_sRGB;\n220\t        } else {\n221\t            output_gamma = PNG_GAMMA_sRGB_INVERSE;\n222\t        }\n223\t    } else if output_gamma == PNG_GAMMA_MAC_18 || output_gamma == PNG_FP_1 / PNG_GAMMA_MAC_18 {\n224\t        if is_screen != 0 {\n225\t            output_gamma = PNG_GAMMA_MAC_OLD;\n226\t        } else {\n227\t            output_gamma = PNG_GAMMA_MAC_INVERSE;\n228\t        }\n229\t    }\n230\t\n231\t    output_gamma\n232\t}\n233\t\n234\t/* convert_gamma_value */\n235\tunsafe fn convert_gamma_value(png_ptr: png_structrp, mut output_gamma: f64) -> png_fixed_point {\n236\t    /* The following silently ignores cases where fixed point (times 100,000)\n237\t     * gamma values are passed to the floating point API.  This is safe and it\n238\t     * means the fixed point constants work just fine with the floating point\n239\t     * API.  The alternative would just lead to undetected errors and spurious\n240\t     * bug reports.  Negative values fail inside the _fixed API unless they\n241\t     * correspond to the flag values.\n242\t     */\n243\t    if output_gamma > 0. && output_gamma < 128. {\n244\t        output_gamma *= PNG_FP_1 as f64;\n245\t    }\n246\t\n247\t    /* This preserves -1 and -2 exactly: */\n248\t    output_gamma = floor(output_gamma + 0.5);\n249\t\n250\t    if output_gamma > PNG_FP_MAX as f64 || output_gamma < PNG_FP_MIN as f64 {\n251\t        png_fixed_error(png_ptr, b\"gamma value\\0\".as_ptr() as png_const_charp);\n252\t    }\n253\t\n254\t    output_gamma as png_fixed_point\n255\t}\n256\t\n257\t/* unsupported_gamma */\n258\tunsafe fn unsupported_gamma(png_ptr: png_structrp, gamma: png_fixed_point, warn: c_int) -> c_int {\n259\t    /* Validate a gamma value to ensure it is in a reasonable range.  The value\n260\t     * is expected to be 1 or greater, but this range test allows for some\n261\t     * viewing correction values.  The intent is to weed out the API users\n262\t     * who might use the inverse of the gamma value accidentally!\n263\t     *\n264\t     * 1.6.47: apply the test in png_set_gamma as well but only warn and return\n265\t     * false if it fires.\n266\t     *\n267\t     * TODO: 1.8: make this an app_error in png_set_gamma as well.\n268\t     */\n269\t    if gamma < PNG_LIB_GAMMA_MIN || gamma > PNG_LIB_GAMMA_MAX {\n270\t        /* #define msg \"gamma out of supported range\" */\n271\t        if warn != 0 {\n272\t            png_app_warning(\n273\t                png_ptr,\n274\t                b\"gamma out of supported range\\0\".as_ptr() as png_const_charp,\n275\t            );\n276\t        } else {\n277\t            png_app_error(\n278\t                png_ptr,\n279\t                b\"gamma out of supported range\\0\".as_ptr() as png_const_charp,\n280\t            );\n281\t        }\n282\t        return 1;\n283\t    }\n284\t\n285\t    0\n286\t}\n287\t\n288\t/* png_set_alpha_mode_fixed */\n289\t#[unsafe(no_mangle)]\n290\tpub unsafe extern \"C\" fn png_set_alpha_mode_fixed(\n291\t    png_ptr: png_structrp,\n292\t    mode: c_int,\n293\t    mut output_gamma: png_fixed_point,\n294\t) {\n295\t    let mut file_gamma: png_fixed_point;\n296\t    let mut compose: c_int = 0;\n297\t\n298\t    if png_rtran_ok(png_ptr, 0) == 0 {\n299\t        return;\n300\t    }\n301\t\n302\t    output_gamma = translate_gamma_flags(output_gamma, 1 /*screen*/);\n303\t    if unsupported_gamma(png_ptr, output_gamma, 0 /*error*/) != 0 {\n304\t        return;\n305\t    }\n306\t\n307\t    /* The default file gamma is the inverse of the output gamma; the output\n308\t     * gamma may be changed below so get the file value first.  The default_gamma\n309\t     * is set here and from the simplified API (which uses a different algorithm)\n310\t     * so don't overwrite a set value:\n311\t     */\n312\t    file_gamma = (*png_ptr).default_gamma;\n313\t    if file_gamma == 0 {\n314\t        file_gamma = png_reciprocal(output_gamma);\n315\t        (*png_ptr).default_gamma = file_gamma;\n316\t    }\n317\t\n318\t    /* There are really 8 possibilities here, composed of any combination\n319\t     * of:\n320\t     *\n321\t     *    premultiply the color channels\n322\t     *    do not encode non-opaque pixels\n323\t     *    encode the alpha as well as the color channels\n324\t     *\n325\t     * The differences disappear if the input/output ('screen') gamma is 1.0,\n326\t     * because then the encoding is a no-op and there is only the choice of\n327\t     * premultiplying the color channels or not.\n328\t     *\n329\t     * png_set_alpha_mode and png_set_background interact because both use\n330\t     * png_compose to do the work.  Calling both is only useful when\n331\t     * png_set_alpha_mode is used to set the default mode - PNG_ALPHA_PNG - along\n332\t     * with a default gamma value.  Otherwise PNG_COMPOSE must not be set.\n333\t     */\n334\t    match mode {\n335\t        /* default: png standard */\n336\t        PNG_ALPHA_PNG => {\n337\t            /* No compose, but it may be set by png_set_background! */\n338\t            (*png_ptr).transformations &= !PNG_ENCODE_ALPHA;\n339\t            (*png_ptr).flags &= !PNG_FLAG_OPTIMIZE_ALPHA;\n340\t        }\n341\t\n342\t        /* color channels premultiplied */\n343\t        PNG_ALPHA_ASSOCIATED => {\n344\t            compose = 1;\n345\t            (*png_ptr).transformations &= !PNG_ENCODE_ALPHA;\n346\t            (*png_ptr).flags &= !PNG_FLAG_OPTIMIZE_ALPHA;\n347\t            /* The output is linear: */\n348\t            output_gamma = PNG_FP_1;\n349\t        }\n350\t\n351\t        /* associated, non-opaque pixels linear */\n352\t        PNG_ALPHA_OPTIMIZED => {\n353\t            compose = 1;\n354\t            (*png_ptr).transformations &= !PNG_ENCODE_ALPHA;\n355\t            (*png_ptr).flags |= PNG_FLAG_OPTIMIZE_ALPHA;\n356\t            /* output_gamma records the encoding of opaque pixels! */\n357\t        }\n358\t\n359\t        /* associated, non-linear, alpha encoded */\n360\t        PNG_ALPHA_BROKEN => {\n361\t            compose = 1;\n362\t            (*png_ptr).transformations |= PNG_ENCODE_ALPHA;\n363\t            (*png_ptr).flags &= !PNG_FLAG_OPTIMIZE_ALPHA;\n364\t        }\n365\t\n366\t        _ => {\n367\t            png_error(png_ptr, b\"invalid alpha mode\\0\".as_ptr() as png_const_charp);\n368\t        }\n369\t    }\n370\t\n371\t    /* Set the screen gamma values: */\n372\t    (*png_ptr).screen_gamma = output_gamma;\n373\t\n374\t    /* Finally, if pre-multiplying, set the background fields to achieve the\n375\t     * desired result.\n376\t     */\n377\t    if compose != 0 {\n378\t        /* And obtain alpha pre-multiplication by composing on black: */\n379\t        memset(\n380\t            core::ptr::addr_of_mut!((*png_ptr).background) as *mut c_void,\n381\t            0,\n382\t            core::mem::size_of::<png_color_16>(),\n383\t        );\n384\t        (*png_ptr).background_gamma = file_gamma; /* just in case */\n385\t        (*png_ptr).background_gamma_type = PNG_BACKGROUND_GAMMA_FILE as png_byte;\n386\t        (*png_ptr).transformations &= !PNG_BACKGROUND_EXPAND;\n387\t\n388\t        if ((*png_ptr).transformations & PNG_COMPOSE) != 0 {\n389\t            png_error(\n390\t                png_ptr,\n391\t                b\"conflicting calls to set alpha mode and background\\0\".as_ptr()\n392\t                    as png_const_charp,\n393\t            );\n394\t        }\n395\t\n396\t        (*png_ptr).transformations |= PNG_COMPOSE;\n397\t    }\n398\t}\n399\t\n400\t/* png_set_alpha_mode */\n401\t#[unsafe(no_mangle)]\n402\t