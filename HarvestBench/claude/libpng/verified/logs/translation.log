{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RfAjNxoRvjLdXiv1oATtjA","type":"tool_result","content":"1\t/* pngread.c lines 1528..1959 */\n2\t\n3\t/* Utility functions to make particular color-maps */\n4\tunsafe fn set_file_encoding(display: *mut png_image_read_control) {\n5\t    let png_ptr: png_structrp = (*(*(*display).image).opaque).png_ptr;\n6\t    let g: png_fixed_point = png_resolve_file_gamma(png_ptr);\n7\t\n8\t    /* PNGv3: the result may be 0 however the 'default_gamma' should have been\n9\t     * set before this is called so zero is an error:\n10\t     */\n11\t    if g == 0 {\n12\t        png_error(\n13\t            png_ptr,\n14\t            b\"internal: default gamma not set\\0\".as_ptr() as png_const_charp,\n15\t        );\n16\t    }\n17\t\n18\t    if png_gamma_significant(g) != 0 {\n19\t        if png_gamma_not_sRGB(g) != 0 {\n20\t            (*display).file_encoding = P_FILE;\n21\t            (*display).gamma_to_linear = png_reciprocal(g);\n22\t        } else {\n23\t            (*display).file_encoding = P_sRGB;\n24\t        }\n25\t    } else {\n26\t        (*display).file_encoding = P_LINEAR8;\n27\t    }\n28\t}\n29\t\n30\tunsafe fn decode_gamma(\n31\t    display: *mut png_image_read_control,\n32\t    mut value: png_uint_32,\n33\t    mut encoding: c_int,\n34\t) -> png_uint_32 {\n35\t    if encoding == P_FILE {\n36\t        /* double check */\n37\t        encoding = (*display).file_encoding;\n38\t    }\n39\t\n40\t    if encoding == P_NOTSET {\n41\t        /* must be the file encoding */\n42\t        set_file_encoding(display);\n43\t        encoding = (*display).file_encoding;\n44\t    }\n45\t\n46\t    match encoding {\n47\t        P_FILE => {\n48\t            value = png_gamma_16bit_correct(value.wrapping_mul(257), (*display).gamma_to_linear)\n49\t                as png_uint_32;\n50\t        }\n51\t\n52\t        P_sRGB => {\n53\t            value = png_sRGB_table[value as usize] as png_uint_32;\n54\t        }\n55\t\n56