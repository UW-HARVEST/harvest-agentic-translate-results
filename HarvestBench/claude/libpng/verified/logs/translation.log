n/use data */\n54\t        PNG_CRC_WARN_USE => {\n55\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n56\t            (*png_ptr).flags |= PNG_FLAG_CRC_ANCILLARY_USE;\n57\t        }\n58\t\n59\t        /* Quiet/use data */\n60\t        PNG_CRC_QUIET_USE => {\n61\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n62\t            (*png_ptr).flags |= PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN;\n63\t        }\n64\t\n65\t        /* Error/quit */\n66\t        PNG_CRC_ERROR_QUIT => {\n67\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n68\t            (*png_ptr).flags |= PNG_FLAG_CRC_ANCILLARY_NOWARN;\n69\t        }\n70\t\n71\t        /* PNG_CRC_WARN_DISCARD (Warn/discard data), PNG_CRC_DEFAULT and default: */\n72\t        _ => {\n73\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n74\t        }\n75\t    }\n76\t}\n77\t\n78\t/* Is it OK to set a transformation now?  Only if png_start_read_image or\n79\t * png_read_update_info have not been called.  It is not necessary for the IHDR\n80\t * to have been read in all cases; the need_IHDR parameter allows for this\n81\t * check too.\n82\t */\n83\t/* png_rtran_ok */\n84\tunsafe fn png_rtran_ok(png_ptr: png_structrp, need_IHDR: c_int) -> c_int {\n85\t    if png_ptr != core::ptr::null_mut() {\n86\t        if ((*png_ptr).flags & PNG_FLAG_ROW_INIT) != 0 {\n87\t            png_app_error(\n88\t                png_ptr,\n89\t                b\"invalid after png_start_read_image or png_read_update_info\\0\".as_ptr()\n90\t                    as png_const_charp,\n91\t            );\n92\t        } else if need_IHDR != 0 && ((*png_ptr).mode & PNG_HAVE_IHDR) == 0 {\n93\t            png_app_error(\n94\t                png_ptr,\n95\t                b\"invalid before the PNG header has been read\\0\".as_ptr() as png_const_charp,\n96\t            );\n97\t        } else {\n98\t            /* Turn on failure to initialize correctly for all transforms. */\n99\t            (*png_p