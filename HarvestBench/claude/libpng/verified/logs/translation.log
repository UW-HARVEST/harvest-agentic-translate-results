{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0168AUTDNDW5pqFG5MdUfCa5","type":"tool_result","content":"1\t/* png.c lines 1137..1501 */\n2\t\n3\t/* Added at libpng-1.5.5 to support read and write of true CIEXYZ values for\n4\t * cHRM, as opposed to using chromaticities.  These internal APIs return\n5\t * non-zero on a parameter error.  The X, Y and Z values are required to be\n6\t * positive and less than 1.0.\n7\t */\n8\t/* png_xy_from_XYZ */\n9\t#[unsafe(no_mangle)]\n10\tpub unsafe extern \"C\" fn png_xy_from_XYZ(xy: *mut png_xy, XYZ: *const png_XYZ) -> c_int {\n11\t    /* NOTE: returns 0 on success, 1 means error. */\n12\t    let mut d: png_int_32;\n13\t    let dred: png_int_32;\n14\t    let dgreen: png_int_32;\n15\t    let dblue: png_int_32;\n16\t    let dwhite: png_int_32;\n17\t    let whiteX: png_int_32;\n18\t    let whiteY: png_int_32;\n19\t\n20\t    /* 'd' in each of the blocks below is just X+Y+Z for each component,\n21\t     * x, y and z are X,Y,Z/(X+Y+Z).\n22\t     */\n23\t    d = (*XYZ).red_X;\n24\t    if png_safe_add(\n25\t        core::ptr::addr_of_mut!(d),\n26\t        (*XYZ).red_Y,\n27\t        (*XYZ).red_Z,\n28\t    ) != 0\n29\t    {\n30\t        return 1;\n31\t    }\n32\t    dred = d;\n33\t    if png_muldiv(\n34\t        core::ptr::addr_of_mut!((*xy).redx),\n35\t        (*XYZ).red_X,\n36\t        PNG_FP_1,\n37\t        dred,\n38\t    ) == 0\n39\t    {\n40\t        return 1;\n41\t    }\n42\t    if png_muldiv(\n43\t        core::ptr::addr_of_mut!((*xy).redy),\n44\t        (*XYZ).red_Y,\n45\t        PNG_FP_1,\n46\t        dred,\n47\t    ) == 0\n48\t    {\n49\t        return 1;\n50\t    }\n51\t\n52\t    d = (*XYZ).green_X;\n53\t    if png_safe_add(\n54\t        core::ptr::addr_of_mut!(d),\n55\t        (*XYZ).green_Y,\n56\t        (*XYZ).green_Z,\n57\t    ) != 0\n58\t    {\n59\t        return 1;\n60\t    }\n61\t    dgreen = d;\n62\t    if png_muldiv(\n63\t        core::ptr::addr_of_mut!((*xy).greenx),\n64\t        (*XYZ).green_X,\n65\t        PNG_FP_1,\n66\t        dgreen,\n67\t    ) == 0\n68\t    {\n69\t        return 1;\n70\t    }\n71\t    if png_muldiv(\n72\t        core::ptr::addr_of_mut!((*xy).greeny),\n73\t        (*XYZ).green_Y,\n74\t        PNG_FP_1,\n75\t        dgreen,\n76\t    ) == 0\n77\t    {\n78\t        return 1;\n79\t    }\n80\t\n81\t    d = (*XYZ).blue_X;\n82\t    if png_safe_add(\n83\t        core::ptr::addr_of_mut!(d),\n84\t        (*XYZ).blue_Y,\n85\t        (*XYZ).blue_Z,\n86\t    ) != 0\n87\t    {\n88\t        return 1;\n89\t    }\n90\t    dblue = d;\n91\t    if png_muldiv(\n92\t        core::ptr::addr_of_mut!((*xy).bluex),\n93\t        (*XYZ).blue_X,\n94\t        PNG_FP_1,\n95\t        dblue,\n96\t    ) == 0\n97\t    {\n98\t        return 1;\n99\t    }\n100\t    if png_muldiv(\n101\t        core::ptr::addr_of_mut!((*xy).bluey),\n102\t        (*XYZ).blue_Y,\n103\t        PNG_FP_1,\n104\t        dblue,\n105\t    ) == 0\n106\t    {\n107\t        return 1;\n108\t    }\n109\t\n110\t    /* The reference white is simply the sum of the end-point (X,Y,Z) vectors so\n111\t     * the following calculates (X+Y+Z) of the reference white (media white,\n112\t     * encoding white) itself:\n113\t     */\n114\t    d = dblue;\n115\t    if png_safe_add(core::ptr::addr_of_mut!(d), dred, dgreen) != 0 {\n116\t        return 1;\n117\t    }\n118\t    dwhite = d;\n119\t\n120\t    /* Find the white X,Y values from the sum of the red, green and blue X,Y\n121\t     * values.\n122\t     */\n123\t    d = (*XYZ).red_X;\n124\t    if png_safe_add(\n125\t        core::ptr::addr_of_mut!(d),\n126\t        (*XYZ).green_X,\n127\t        (*XYZ).blue_X,\n128\t    ) != 0\n129\t    {\n130\t        return 1;\n131\t    }\n132\t    whiteX = d;\n133\t\n134\t    d = (*XYZ).red_Y;\n135\t    if png_safe_add(\n136\t        core::ptr::addr_of_mut!(d),\n137\t        (*XYZ).green_Y,\n138\t        (*XYZ).blue_Y,\n139\t    ) != 0\n140\t    {\n141\t        return 1;\n142\t    }\n143\t    whiteY = d;\n144\t\n145\t    if png_muldiv(\n146\t        core::ptr::addr_of_mut!((*xy).whitex),\n147\t        whiteX,\n148\t        PNG_FP_1,\n149\t        dwhite,\n150\t    ) == 0\n151\t    {\n152\t        return 1;\n153\t    }\n154\t    if png_muldiv(\n155\t        core::ptr::addr_of_mut!((*xy).whitey),\n156\t        whiteY,\n157\t        PNG_FP_1,\n158\t        dwhite,\n159\t    ) == 0\n160\t    {\n161\t        return 1;\n162\t    }\n163\t\n164\t    0\n165\t}\n166\t\n167\t/* png_XYZ_from_xy */\n168\t#[unsafe(no_mangle)]\n169\tpub unsafe extern \"C\" fn png_XYZ_from_xy(XYZ: *mut png_XYZ, xy: *const png_xy) -> c_int {\n170\t    /* NOTE: returns 0 on success, 1 means error. */\n171\t    let mut red_inverse: png_fixed_point = 0;\n172\t    let mut green_inverse: png_fixed_point = 0;\n173\t    let blue_scale: png_fixed_point;\n174\t    let mut left: png_fixed_point = 0;\n175\t    let mut right: png_fixed_point = 0;\n176\t    let denominator: png_fixed_point;\n177\t\n178\t    /* Check xy and, implicitly, z.  Note that wide gamut color spaces typically\n179\t     * have end points with 0 tristimulus values (these are impossible end\n180\t     * points, but they are used to cover the possible colors).  We check\n181\t     * xy->whitey against 5, not 0, to avoid a possible integer overflow.\n182\t     *\n183\t     * The limits here will *not* accept ACES AP0, where bluey is -7700\n184\t     * (-0.0770) because the PNG spec itself requires the xy values to be\n185\t     * unsigned.  whitey is also required to be 5 or more to avoid overflow.\n186\t     *\n187\t     * Instead the upper limits have been relaxed to accommodate ACES AP1 where\n188\t     * redz ends up as -600 (-0.006).  ProPhotoRGB was already \"in range.\"\n189\t     * The new limit accommodates the AP0 and AP1 ranges for z but not AP0 redy.\n190\t     */\n191\t    let fpLimit: png_fixed_point = PNG_FP_1 + (PNG_FP_1 / 10);\n192\t    if (*xy).redx < 0 || (*xy).redx > fpLimit {\n193\t        return 1;\n194\t    }\n195\t    if (*xy).redy < 0 || (*xy).redy > fpLimit - (*xy).redx {\n196\t        return 1;\n197\t    }\n198\t    if (*xy).greenx < 0 || (*xy).greenx > fpLimit {\n199\t        return 1;\n200\t    }\n201\t    if (*xy).greeny < 0 || (*xy).greeny > fpLimit - (*xy).greenx {\n202\t        return 1;\n203\t    }\n204\t    if (*xy).bluex < 0 || (*xy).bluex > fpLimit {\n205\t        return 1;\n206\t    }\n207\t    if (*xy).bluey < 0 || (*xy).bluey > fpLimit - (*xy).bluex {\n208\t        return 1;\n209\t    }\n210\t    if (*xy).whitex < 0 || (*xy).whitex > fpLimit {\n211\t        return 1;\n212\t    }\n213\t    if (*xy).whitey < 5 || (*xy).whitey > fpLimit - (*xy).whitex {\n214\t        return 1;\n215\t    }\n216\t\n217\t    /* The reverse calculation is more difficult because the original tristimulus\n218\t     * value had 9 independent values (red,green,blue)x(X,Y,Z) however only 8\n219\t     * derived values were recorded in the cHRM chunk;\n220\t     * (red,green,blue,white)x(x,y).  This loses one degree of freedom and\n221\t     * therefore an arbitrary ninth value has to be introduced to undo the\n222\t     * original transformations.\n223\t     *\n224\t     * Think of the original end-points as points in (X,Y,Z) space.  The\n225\t     * chromaticity values (c) have the property:\n226\t     *\n227\t     *           C\n228\t     *   c = ---------\n229\t     *       X + Y + Z\n230\t     *\n231\t     * For each c (x,y,z) from the corresponding original C (X,Y,Z).  Thus the\n232\t     * three chromaticity values (x,y,z) for each end-point obey the\n233\t     * relationship:\n234\t     *\n235\t     *   x + y + z = 1\n236\t     *\n237\t     * This describes the plane in (X,Y,Z) space that intersects each axis at the\n238\t     * value 1.0; call this the chromaticity plane.  Thus the chromaticity\n239\t     * calculation has scaled each end-point so that it is on the x+y+z=1 plane\n240\t     * and chromaticity is the intersection of the vector from the origin to the\n241\t     * (X,Y,Z) value with the chromaticity plane.\n242\t     *\n243\t     * To fully invert the chromaticity calculation we would need the three\n244\t     * end-point scale factors, (red-scale, green-scale, blue-scale), but these\n245\t     * were not recorded.  Instead we calculated the reference white (X,Y,Z) and\n246\t     * recorded the chromaticity of this.  The reference white (X,Y,Z) would have\n247\t     * given all three of the scale factors since:\n248\t     *\n249\t     *    color-C = color-c * color-scale\n250\t     *    white-C = red-C + green-C + blue-C\n251\t     *            = red-c*red-scale + green-c*green-scale + blue-c*blue-scale\n252\t     *\n253\t     * But cHRM records only white-x and white-y, so we have lost the white scale\n254\t     * factor:\n255\t     *\n256\t     *    white-C = white-c*white-scale\n257\t     *\n258\t     * To handle this the inverse transformation makes an arbitrary assumption\n259\t     * about white-scale:\n260\t     *\n261\t     *    Assume: white-Y = 1.0\n262\t     *    Hence:  white-scale = 1/white-y\n263\t     *    Or:     red-Y + green-Y + blue-Y = 1.0\n264\t     *\n265\t     * Notice the last statement of the assumption gives an equation in three of\n266\t     * the nine values we want to calculate.  8 more equations come from the\n267\t     * above routine as summarised at the top above (the chromaticity\n268\t     * calculation):\n269\t     *\n270\t     *    Given: color-x = color-X / (color-X + color-Y + color-Z)\n271\t     *    Hence: (color-x - 1)*color-X + color.x*color-Y + color.x*color-Z = 0\n272\t     *\n273\t     * This is 9 simultaneous equations in the 9 variables \"color-C\" and can be\n274\t     * solved by Cramer's rule.  Cramer's rule requires calculating 10 9x9 matrix\n275\t     * determinants, however this is not as bad as it seems because only 28 of\n276\t     * the total of 90 terms in the various matrices are non-zero.  Nevertheless\n277\t     * Cramer's rule is notoriously numerically unstable because the determinant\n278\t     * calculation involves the difference of large, but similar, numbers.  It is\n279\t     * difficult to be sure that the calculation is stable for real world values\n280\t     * and it is certain that it becomes unstable where the end points are close\n281\t     * together.\n282\t     *\n283\t     * So this code uses the perhaps slightly less optimal but more\n284\t     * understandable and totally obvious approach of calculating color-scale.\n285\t     *\n286\t     * This algorithm depends on the precision in white-scale and that is\n287\t     * (1/white-y), so we can immediately see that as white-y approaches 0 the\n288\t     * accuracy inherent in the cHRM chunk drops off substantially.\n289\t     *\n290\t     * libpng arithmetic: a simple inversion of the above equations\n291\t     * ------------------------------------------------------------\n292\t     *\n293\t     *    white_scale = 1/white-y\n294\t     *    white-X = white-x * white-scale\n295\t     *    white-Y = 1.0\n296\t     *    white-Z = (1 - white-x - white-y) * white_scale\n297\t     *\n298\t     *    white-C = red-C + green-C + blue-C\n299\t     *            = red-c*red-scale + green-c*green-scale + blue-c*blue-scale\n300\t     *\n301\t     * This gives us three equations in (red-scale,green-scale,blue-scale) where\n302\t     * all the coefficients are now known:\n303\t     *\n304\t     *    red-x*red-scale + green-x*green-scale + blue-x*blue-scale\n305\t     *       = white-x/white-y\n306\t     *    red-y*red-scale + green-y*green-scale + blue-y*blue-scale = 1\n307\t     *    red-z*red-scale + green-z*green-scale + blue-z*blue-scale\n308\t     *       = (1 - white-x - white-y)/white-y\n309\t     *\n310\t     * In the last equation color-z is (1 - color-x - color-y) so we can add all\n311\t     * three equations together to get an alternative third:\n312\t     *\n313\t     *    red-scale + green-scale + blue-scale = 1/white-y = white-scale\n314\t     *\n315\t     * So now we have a Cramer's rule solution where the determinants are just\n316\t     * 3x3 - far more tractable.  Unfortunately 3x3 determinants still involve\n317\t     * multiplication of three coefficients so we can't guarantee to avoid\n318\t     * overflow in the libpng fixed point representation.  Using Cramer's rule in\n319\t     * floating point is probably a good choice here, but it's not an option for\n320\t     * fixed point.  Instead proceed to simplify the first two equations by\n321\t     * eliminating what is likely to be the largest value, blue-scale:\n322\t     *\n323\t     *    blue-scale = white-scale - red-scale - green-scale\n324\t     *\n325\t     * Hence:\n326\t     *\n327\t     *    (red-x - blue-x)*red-scale + (green-x - blue-x)*green-scale =\n328\t     *                (white-x - blue-x)*white-scale\n329\t     *\n330\t     *    (red-y - blue-y)*red-scale + (green-y - blue-y)*green-scale =\n331\t     *                1 - blue-y*white-scale\n332\t     *\n333\t     * And now we can trivially solve for (red-scale,green-scale):\n334\t     *\n335\t     *    green-scale =\n336\t     *                (white-x - blue-x)*white-scale - (red-x - blue-x)*red-scale\n337\t     *                -----------------------------------------------------------\n338\t     *                                  green-x - blue-x\n339\t     *\n340\t     *    red-scale =\n341\t     *                1 - blue-y*white-scale - (green-y - blue-y) * green-scale\n342\t     *                ---------------------------------------------------------\n343\t     *                                  red-y - blue-y\n344\t     *\n345\t     * Hence:\n346\t     *\n347\t     *    red-scale =\n348\t     *          ( (green-x - blue-x) * (white-y - blue-y) -\n349\t     *            (green-y - blue-y) * (white-x - blue-x) ) / white-y\n350\t     * -------------------------------------------------------------------------\n351\t     *  (green-x - blue-x)*(red-y - blue-y)-(green-y - blue-y)*(red-x - blue-x)\n352\t     *\n353\t     *    green-scale =\n354\t     *          ( (red-y - blue-y) * (white-x - blue-x) -\n355\t     *            (red-x - blue-x) * (white-y - blue-y) ) / white-y\n356\t     * -------------------------------------------------------------------------\n357\t     *  (green-x - blue-x)*(red-y - blue-y)-(green-y - blue-y)*(red-x - blue-x)\n358\t     *\n359\t     * Accuracy:\n360\t     * The input values have 5 decimal digits of accuracy.\n361\t     *\n362\t     * In the previous implementation the values were all in the range 0 < value\n363\t     * < 1, so simple products are in the same range but may need up to 10\n364\t     * decimal digits to preserve the original precision and avoid underflow.\n365\t     * Because we are using a 32-bit signed representation we cannot match this;\n366\t     * the best is a little over 9 decimal digits, less than 10.\n367\t     *\n368\t     * This range has now been extended to allow values up to 1.1, or 110,000 in\n369\t     * fixed point.\n370\t     *\n371\t     * The approach used here is to preserve the maximum precision within the\n372\t     * signed representation.  Because the red-scale calculation above uses the\n373\t     * difference between two products of values that must be in the range\n374\t     * -1.1..+1.1 it is sufficient to divide the product by 8;\n375\t     * ceil(121,000/32767*2).  The factor is irrelevant in the calculation\n376\t     * because it is applied to both numerator and denominator.\n377\t     *\n378\t     * Note that the values of the differences of the products of the\n379\t     * chromaticities in the above equations tend to be small, for example for\n380\t     * the sRGB chromaticities they are:\n381\t     *\n382\t     * red numerator:    -0.04751\n383\t     * green numerator:  -0.08788\n384\t     * denominator:      -0.2241 (without white-y multiplication)\n385\t     *\n386\t     *  The resultant Y coefficients from the chromaticities of some widely used\n387\t     *  color space definitions are (to 15 decimal places):\n388\t     *\n389\t     *  sRGB\n390\t     *    0.212639005871510 0.715168678767756 0.072192315360734\n391\t     *  Kodak ProPhoto\n392\t     *    0.288071128229293 0.711843217810102 0.000085653960605\n393\t     *  Adobe RGB\n394\t     *    0.297344975250536 0.627363566255466 0.075291458493998\n395\t     *  Adobe Wide Gamut RGB\n396\t     *    0.258728243040113 0.724682314948566 0.016589442011321\n397\t     */\n398\t    {\n399\t        let mut error: c_int = 0;\n400\t\n401\t        /* By the argument above overflow should be impossible here, however the\n402\t         * code now simply returns a failure code.  The xy subtracts in the\n403\t         * arguments to png_muldiv are *not* checked for overflow because the\n404\t         * checks at the start guarantee they are in the range 0..110000 and\n405\t         * png_fixed_point is a 32-bit signed number.\n406\t         */\n407\t        if png_muldiv(\n408\t            core::ptr::addr_of_mut!(left),\n409\t            (*xy).greenx - (*xy).bluex,\n410\t            (*xy).redy - (*xy).bluey,\n411\t            8,\n412\t        ) == 0\n413\t        {\n414\t            return 1;\n415\t        }\n416\t        if png_muldiv(\n417\t            core::ptr::addr_of_mut!(right),\n418\t            (*xy).greeny - (*xy).bluey,\n419\t            (*xy).redx - (*xy).bluex,\n420\t            8,\n421\t        ) == 0\n422\t        {\n423\t            return 1;\n424\t        }\n425\t        denominator = png_fp_sub(left, right, core::ptr::addr_of_mut!(error));\n426\t        if error != 0 {\n427\t            return 1;\n428\t        }\n429\t\n430\t        /* Now find the red numerator. */\n431\t        if png_muldiv(\n432\t            core::ptr::addr_of_mut!(left),\n433\t            (*xy).greenx - (*xy).bluex,\n434\t            (*xy).whitey - (*xy).bluey,\n435\t            8,\n436\t        ) == 0\n437\t        {\n438\t            return 1;\n439\t        }\n440\t        if png_muldiv(\n441\t            core::ptr::addr_