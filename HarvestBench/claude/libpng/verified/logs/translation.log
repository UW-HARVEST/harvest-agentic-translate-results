n/use data */\n54\t        PNG_CRC_WARN_USE => {\n55\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n56\t            (*png_ptr).flags |= PNG_FLAG_CRC_ANCILLARY_USE;\n57\t        }\n58\t\n59\t        /* Quiet/use data */\n60\t        PNG_CRC_QUIET_USE => {\n61\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n62\t            (*png_ptr).flags |= PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN;\n63\t        }\n64\t\n65\t        /* Error/quit */\n66\t        PNG_CRC_ERROR_QUIT => {\n67\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n68\t            (*png_ptr).flags |= PNG_FLAG_CRC_ANCILLARY_NOWARN;\n69\t        }\n70\t\n71\t        /* PNG_CRC_WARN_DISCARD (Warn/discard data), PNG_CRC_DEFAULT and default: */\n72\t        _ => {\n73\t            (*png_ptr).flags &= !PNG_FLAG_CRC_ANCILLARY_MASK;\n74\t        }\n75\t    }\n76\t}\n77\t\n78\t/* Is it OK to set a transformation now?  Only if png_start_read_image or\n79\t * png_read_update_info have not been called.  It is not necessary for the IHDR\n80\t * to have been read in all cases; the need_IHDR parameter allows for this\n81\t * check too.\n82\t */\n83\t/* png_rtran_ok */\n84\tunsafe fn png_rtran_ok(png_ptr: png_structrp, need_IHDR: c_int) -> c_int {\n85\t    if png_ptr != core::ptr::null_mut() {\n86\t        if ((*png_ptr).flags & PNG_FLAG_ROW_INIT) != 0 {\n87\t            png_app_error(\n88\t                png_ptr,\n89\t                b\"invalid after png_start_read_image or png_read_update_info\\0\".as_ptr()\n90\t                    as png_const_charp,\n91\t            );\n92\t        } else if need_IHDR != 0 && ((*png_ptr).mode & PNG_HAVE_IHDR) == 0 {\n93\t            png_app_error(\n94\t                png_ptr,\n95\t                b\"invalid before the PNG header has been read\\0\".as_ptr() as png_const_charp,\n96\t            );\n97\t        } else {\n98\t            /* Turn on failure to initialize correctly for all transforms. */\n99\t            (*png_ptr).flags |= PNG_FLAG_DETECT_UNINITIALIZED;\n100\t\n101\t            return 1; /* Ok */\n102\t        }\n103\t    }\n104\t\n105\t    0 /* no png_error possible! */\n106\t}\n107\t\n108\t/* Handle alpha and tRNS via a background color */\n109\t/* png_set_background_fixed */\n110\t#[unsafe(no_mangle)]\n111\tpub unsafe extern \"C\" fn png_set_background_fixed(\n112\t    png_ptr: png_structrp,\n113\t    background_color: png_const_color_16p,\n114\t    background_gamma_code: c_int,\n115\t    need_expand: c_int,\n116\t    background_gamma: png_fixed_point,\n117\t) {\n118\t    if png_rtran_ok(png_ptr, 0) == 0 || background_color == core::ptr::null() {\n119\t        return;\n120\t    }\n121\t\n122\t    if background_gamma_code == PNG_BACKGROUND_GAMMA_UNKNOWN {\n123\t        png_warning(\n124\t            png_ptr,\n125\t            b\"Application must supply a known background gamma\\0\".as_ptr() as png_const_charp,\n126\t        );\n127\t        return;\n128\t    }\n129\t\n130\t    (*png_ptr).transformations |= PNG_COMPOSE | PNG_STRIP_ALPHA;\n131\t    (*png_ptr).transformations &= !PNG_ENCODE_ALPHA;\n132\t    (*png_ptr).flags &= !PNG_FLAG_OPTIMIZE_ALPHA;\n133\t\n134\t    (*png_ptr).background = *background_color;\n135\t    (*png_ptr).background_gamma = background_gamma;\n136\t    (*png_ptr).background_gamma_type = background_gamma_code as png_byte;\n137\t    if need_expand != 0 {\n138\t        (*png_ptr).transformations |= PNG_BACKGROUND_EXPAND;\n139\t    } else {\n140\t        (*png_ptr).transformations &= !PNG_BACKGROUND_EXPAND;\n141\t    }\n142\t}\n143\t\n144\t/* png_set_background */\n145\t#[unsafe(no_mangle)]\n146\tpub unsafe extern \"C\" fn png_set_background(\n147\t    png_ptr: png_structrp,\n148\t    background_color: png_const_color_16p,\n149\t    background_gamma_code: c_int,\n150\t    need_expand: c_int,\n151\t    background_gamma: f64,\n152\t) {\n153\t    png_set_background_fixed(\n154\t        png_ptr,\n155\t        background_color,\n156\t        background_gam