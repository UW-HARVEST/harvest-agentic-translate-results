code needs to be revised to avoid the complexity and\n1546\t    * interdependencies.  The color type of the background should be recorded in\n1547\t    * png_set_background, along with the bit depth, then the code has a record\n1548\t    * of exactly what color space the background is currently in.\n1549\t    */\n1550\t   if ((png_ptr->transformations & PNG_BACKGROUND_EXPAND) != 0)\n1551\t   {\n1552\t      /* PNG_BACKGROUND_EXPAND: the background is in the file color space, so if\n1553\t       * the file was grayscale the background value is gray.\n1554\t       */\n1555\t      if ((png_ptr->color_type & PNG_COLOR_MASK_COLOR) == 0)\n1556\t         png_ptr->mode |= PNG_BACKGROUND_IS_GRAY;\n1557\t   }\n1558\t\n1559\t   else if ((png_ptr->transformations & PNG_COMPOSE) != 0)\n1560\t   {\n1561\t      /* PNG_COMPOSE: png_set_background was called with need_expand false,\n1562\t       * so the color is in the color space of the output or png_set_alpha_mode\n1563\t       * was called and the color is black.  Ignore RGB_TO_GRAY because that\n1564\t       * happens before GRAY_TO_RGB.\n1565\t       */\n1566\t      if ((png_ptr->transformations & PNG_GRAY_TO_RGB) != 0)\n1567\t      {\n1568\t         if (png_ptr->background.red == png_ptr->background.green &&\n1569\t             png_ptr->background.red == png_ptr->background.blue)\n1570\t         {\n1571\t            png_ptr->mode |= PNG_BACKGROUND_IS_GRAY;\n1572\t            png_ptr->background.gray = png_ptr->background.red;\n1573\t         }\n1574\t      }\n1575\t   }\n1576\t#endif /* READ_EXPAND && READ_BACKGROUND */\n1577\t#endif /* READ_GRAY_TO_RGB */\n1578\t\n1579\t   /* For indexed PNG data (PNG_COLOR_TYPE_PALETTE) many of the transformations\n1580\t    * can be performed directly on the palette, and some (such as rgb to gray)\n1581\t    * can be optimized inside the palette.  This is particularly true of the\n1582\t    * composite (background and alpha) stuff, which can be pretty much all done\n1583\t    * in the palette even if the result is expanded to RGB or gray afterward.\n1584\t    *\n1585\t    * NOTE: this is Not Yet Implemented, the code behaves as in 1.5.1 and\n1586\t    * earlier and the palette stuff is actually handled on the first row.  This\n1587\t    * leads to the reported bug that the palette returned by png_get_PLTE is not\n1588\t    * updated.\n1589\t    */\n1590\t   if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n1591\t      png_init_palette_transformations(png_ptr);\n1592\t\n1593\t   else\n1594\t      png_init_rgb_transformations(png_ptr);\n1595\t\n1596\t#if defined(PNG_READ_BACKGROUND_SUPPORTED) && \\\n1597\t   defined(PNG_READ_EXPAND_16_SUPPORTED)\n1598\t   if ((png_ptr->transformations & PNG_EXPAND_16) != 0 &&\n1599\t       (png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1600\t       (png_ptr->transformations & PNG_BACKGROUND_EXPAND) == 0 &&\n1601\t       png_ptr->bit_depth != 16)\n1602\t   {\n1603\t      /* TODO: fix this.  Because the expand_16 operation is after the compose\n1604\t       * handling the background color must be 8, not 16, bits deep, but the\n1605\t       * application will supply a 16-bit value so reduce it here.\n1606\t       *\n1607\t       * The PNG_BACKGROUND_EXPAND code above does not expand to 16 bits at\n1608\t       * present, so that case is ok (until do_expand_16 is moved.)\n1609\t       *\n1610\t       * NOTE: this discards the low 16 bits of the user supplied background\n1611\t       * color, but until expand_16 works properly there is no choice!\n1612\t       */\n1613\t#     define CHOP(x) (x)=((png_uint_16)PNG_DIV257(x))\n1614\t      CHOP(png_ptr->background.red);\n1615\t      CHOP(png_ptr->background.green);\n1616\t      CHOP(png_ptr->background.blue);\n1617\t      CHOP(png_ptr->background.gray);\n1618\t#     undef CHOP\n1619\t   }\n1620\t#endif /* READ_BACKGROUND && READ_EXPAND_16 */\n1621\t\n1622\t#if defined(PNG_READ_BACKGROUND_SUPPORTED) && \\\n1623\t   (defined(PNG_READ_SCALE_16_TO_8_SUPPORTED) || \\\n1624\t   defined(PNG_READ_STRIP_16_TO_8_SUPPORTED))\n1625\t   if ((png_ptr->transformations & (PNG_16_TO_8|PNG_SCALE_16_TO_8)) != 0 &&\n1626\t       (png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1627\t       (png_ptr->transformations & PNG_BACKGROUND_EXPAND) == 0 &&\n1628\t       png_ptr->bit_depth == 16)\n1629\t   {\n1630\t      /* On the other hand, if a 16-bit file is to be reduced to 8-bits per\n1631\t       * component this will also happen after PNG_COMPOSE and so the background\n1632\t       * color must be pre-expanded here.\n1633\t       *\n1634\t       * TODO: fix this too.\n1635\t       */\n1636\t      png_ptr->background.red = (png_uint_16)(png_ptr->background.red * 257);\n1637\t      png_ptr->background.green =\n1638\t         (png_uint_16)(png_ptr->background.green * 257);\n1639\t      png_ptr->background.blue = (png_uint_16)(png_ptr->background.blue * 257);\n1640\t      png_ptr->background.gray = (png_uint_16)(png_ptr->background.gray * 257);\n1641\t   }\n1642\t#endif\n1643\t\n1644\t   /* NOTE: below 'PNG_READ_ALPHA_MODE_SUPPORTED' is presumed to also enable the\n1645\t    * background support (see the comments in scripts/pnglibconf.dfa), this\n1646\t    * allows pre-multiplication of the alpha channel to be implemented as\n1647\t    * compositing on black.  This is probably sub-optimal and has been done in\n1648\t    * 1.5.4 betas simply to enable external critique and testing (i.e. to\n1649\t    * implement the new API quickly, without lots of internal changes.)\n1650\t    */\n1651\t\n1652\t#ifdef PNG_READ_GAMMA_SUPPORTED\n1653\t#  ifdef PNG_READ_BACKGROUND_SUPPORTED\n1654\t      /* Includes ALPHA_MODE */\n1655\t      png_ptr->background_1 = png_ptr->background;\n1656\t#  endif\n1657\t\n1658\t   /* This needs to change - in the palette image case a whole set of tables are\n1659\t    * built when it would be quicker to just calculate the correct value for\n1660\t    * each palette entry directly.  Also, the test is too tricky - why check\n1661\t    * PNG_RGB_TO_GRAY if PNG_GAMMA is not set?  The answer seems to be that\n1662\t    * PNG_GAMMA is cancelled even if the gamma is known?  The test excludes the\n1663\t    * PNG_COMPOSE case, so apparently if there is no *overall* gamma correction\n1664\t    * the gamma tables will not be built even if composition is required on a\n1665\t    * gamma encoded value.\n1666\t    *\n1667\t    * In 1.5.4 this is addressed below by an additional check on the individual\n1668\t    * file gamma - if it is not 1.0 both RGB_TO_GRAY and COMPOSE need the\n1669\t    * tables.\n1670\t    */\n1671\t   if ((png_ptr->transformations & PNG_GAMMA) != 0 ||\n1672\t       ((png_ptr->transformations & PNG_RGB_TO_GRAY) != 0 &&\n1673\t        (png_gamma_significant(png_ptr->file_gamma) != 0 ||\n1674\t         png_gamma_significant(png_ptr->screen_gamma) != 0)) ||\n1675\t        ((png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1676\t         (png_gamma_significant(png_ptr->file_gamma) != 0 ||\n1677\t          png_gamma_significant(png_ptr->screen_gamma) != 0\n1678\t#  ifdef PNG_READ_BACKGROUND_SUPPORTED\n1679\t         || (png_ptr->background_gamma_type == PNG_BACKGROUND_GAMMA_UNIQUE &&\n1680\t           png_gamma_significant(png_ptr->background_gamma) != 0)\n1681\t#  endif\n1682\t        )) || ((png_ptr->transformations & PNG_ENCODE_ALPHA) != 0 &&\n1683\t       png_gamma_significant(png_ptr->screen_gamma) != 0))\n1684\t   {\n1685\t      png_build_gamma_table(png_ptr, png_ptr->bit_depth);\n1686\t\n1687\t#ifdef PNG_READ_BACKGROUND_SUPPORTED\n1688\t      if ((png_ptr->transformations & PNG_COMPOSE) != 0)\n1689\t      {\n1690\t         /* Issue a warning about this combination: because RGB_TO_GRAY is\n1691\t          * optimized to do the gamma transform if present yet do_background has\n1692\t          * to do the same thing if both options are set a\n1693\t          * double-gamma-correction happens.  This is true in all versions of\n1694\t          * libpng to date.\n1695\t          */\n1696\t         if ((png_ptr->transformations & PNG_RGB_TO_GRAY) != 0)\n1697\t            png_warning(png_ptr,\n1698\t                \"libpng does not support gamma+background+rgb_to_gray\");\n1699\t\n1700\t         if ((png_ptr->color_type == PNG_COLOR_TYPE_PALETTE) != 0)\n1701\t         {\n1702\t            /* We don't get to here unless there is a tRNS chunk with non-opaque\n1703\t             * entries - see the checking code at the start of this function.\n1704\t             */\n1705\t            png_color back, back_1;\n1706\t            png_colorp palette = png_ptr->palette;\n1707\t            int num_palette = png_ptr->num_palette;\n1708\t            int i;\n1709\t            if (png_ptr->background_gamma_type == PNG_BACKGROUND_GAMMA_FILE)\n1710\t            {\n1711\t\n1712\t               back.red = png_ptr->gamma_table[png_ptr->background.red];\n1713\t               back.green = png_ptr->gamma_table[png_ptr->background.green];\n1714\t               back.blue = png_ptr->gamma_table[png_ptr->background.blue];\n1715\t\n1716\t               back_1.red = png_ptr->gamma_to_1[png_ptr->background.red];\n1717\t               back_1.green = png_ptr->gamma_to_1[png_ptr->background.green];\n1718\t               back_1.blue = png_ptr->gamma_to_1[png_ptr->background.blue];\n1719\t            }\n1720\t            else\n1721\t            {\n1722\t               png_fixed_point g, gs;\n1723\t\n1724\t               switch (png_ptr->background_gamma_type)\n1725\t               {\n1726\t                  case PNG_BACKGROUND_GAMMA_SCREEN:\n1727\t                     g = (png_ptr->screen_gamma);\n1728\t                     gs = PNG_FP_1;\n1729\t                     break;\n1730\t\n1731\t                  case PNG_BACKGROUND_GAMMA_FILE:\n1732\t                     g = png_reciprocal(png_ptr->file_gamma);\n1733\t                     gs = png_reciprocal2(png_ptr->file_gamma,\n1734\t                         png_ptr->screen_gamma);\n1735\t                     break;\n1736\t\n1737\t                  case PNG_BACKGROUND_GAMMA_UNIQUE:\n1738\t                     g = png_reciprocal(png_ptr->background_gamma);\n1739\t                     gs = png_reciprocal2(png_ptr->background_gamma,\n1740\t                         png_ptr->screen_gamma);\n1741\t                     break;\n1742\t                  default:\n1743\t                     g = PNG_FP_1;    /* back_1 */\n1744\t                     gs = PNG_FP_1;   /* back */\n1745\t                     break;\n1746\t               }\n1747\t\n1748\t               if (png_gamma_significant(gs) != 0)\n1749\t               {\n1750\t                  back.red = png_gamma_8bit_correct(png_ptr->background.red,\n1751\t                      gs);\n1752\t                  back.green = png_gamma_8bit_correct(png_ptr->background.green,\n1753\t                      gs);\n1754\t                  back.blue = png_gamma_8bit_correct(png_ptr->background.blue,\n1755\t                      gs);\n1756\t               }\n1757\t\n1758\t               else\n1759\t               {\n1760\t                  back.red   = (png_byte)png_ptr->background.red;\n1761\t                  back.green = (png_byte)png_ptr->background.green;\n1762\t                  back.blue  = (png_byte)png_ptr->background.blue;\n1763\t               }\n1764\t\n1765\t               if (png_gamma_significant(g) != 0)\n1766\t               {\n1767\t                  back_1.red = png_gamma_8bit_correct(png_ptr->background.red,\n1768\t                      g);\n1769\t                  back_1.green = png_gamma_8bit_correct(\n1770\t                      png_ptr->background.green, g);\n1771\t                  back_1.blue = png_gamma_8bit_correct(png_ptr->background.blue,\n1772\t                      g);\n1773\t               }\n1774\t\n1775\t               else\n1776\t               {\n1777\t                  back_1.red   = (png_byte)png_ptr->background.red;\n1778\t                  back_1.green = (png_byte)png_ptr->background.green;\n1779\t                  back_1.blue  = (png_byte)png_ptr->background.blue;\n1780\t               }\n1781\t            }\n1782\t\n1783\t            for (i = 0; i < num_palette; i++)\n1784\t            {\n1785\t               if (i < (int)png_ptr->num_trans &&\n1786\t                   png_ptr->trans_alpha[i] != 0xff)\n1787\t               {\n1788\t                  if (png_ptr->trans_alpha[i] == 0)\n1789\t                  {\n1790\t                     palette[i] = back;\n1791\t                  }\n1792\t                  else /* if (png_ptr->trans_alpha[i] != 0xff) */\n1793\t                  {\n1794\t                     if ((png_ptr->flags & PNG_FLAG_OPTIMIZE_ALPHA) != 0)\n1795\t                     {\n1796\t                        /* Premultiply only:\n1797\t                         * component = round((component * alpha) / 255)\n1798\t                         */\n1799\t                        png_uint_32 component;\n1800\t\n1801\t                        component = png_ptr->gamma_to_1[palette[i].red];\n1802\t                        component =\n1803\t                            (component * png_ptr->trans_alpha[i] + 128) / 255;\n1804\t                        palette[i].red = png_ptr->gamma_from_1[component];\n1805\t\n1806\t                        component = png_ptr->gamma_to_1[palette[i].green];\n1807\t                        component =\n1808\t                            (component * png_ptr->trans_alpha[i] + 128) / 255;\n1809\t                        palette[i].green = png_ptr->gamma_from_1[component];\n1810\t\n1811\t                        component = png_ptr->gamma_to_1[palette[i].blue];\n1812\t                        component =\n1813\t                            (component * png_ptr->trans_alpha[i] + 128) / 255;\n1814\t                        palette[i].blue = png_ptr->gamma_from_1[component];\n1815\t                     }\n1816\t                     else\n1817\t                     {\n1818\t                        /* Composite with background color:\n1819\t                         * component =\n1820\t                         *    alpha * component + (1 - alpha) * background\n1821\t                         */\n1822\t                        png_byte v, w;\n1823\t\n1824\t                        v = png_ptr->gamma_to_1[palette[i].red];\n1825\t                        png_composite(w, v,\n1826\t                            png_ptr->trans_alpha[i], back_1.red);\n1827\t                        palette[i].red = png_ptr->gamma_from_1[w];\n1828\t\n1829\t                        v = png_ptr->gamma_to_1[palette[i].green];\n1830\t                        png_composite(w, v,\n1831\t                            png_ptr->trans_alpha[i], back_1.green);\n1832\t                        palette[i].green = png_ptr->gamma_from_1[w];\n1833\t\n1834\t                        v = png_ptr->gamma_to_1[palette[i].blue];\n1835\t                        png_composite(w, v,\n1836\t                            png_ptr->trans_alpha[i], back_1.blue);\n1837\t                        palette[i].blue = png_ptr->gamma_from_1[w];\n1838\t                     }\n1839\t                  }\n1840\t               }\n1841\t               else\n1842\t               {\n1843\t                  palette[i].red = png_ptr->gamma_table[palette[i].red];\n1844\t                  palette[i].green = png_ptr->gamma_table[palette[i].green];\n1845\t                  palette[i].blue = png_ptr->gamma_table[palette[i].blue];\n1846\t               }\n1847\t            }\n1848\t\n1849\t            /* Prevent the transformations being done again.\n1850\t             *\n1851\t             * NOTE: this is highly dubious; it removes the transformations in\n1852\t             * place.  This seems inconsistent with the general treatment of the\n1853\t             * transformations elsewhere.\n1854\t             */\n1855\t            png_ptr->transformations &= ~(PNG_COMPOSE | PNG_GAMMA);\n1856\t            png_ptr->flags &= ~PNG_FLAG_OPTIMIZE_ALPHA;\n1857\t         } /* color_type == PNG_COLOR_TYPE_PALETTE */\n1858\t\n1859\t         /* if (png_ptr->background_gamma_type!=PNG_BACKGROUND_GAMMA_UNKNOWN) */\n1860\t         else /* color_type != PNG_COLOR_TYPE_PALETTE */\n1861\t         {\n1862\t            int gs_sig, g_sig;\n1863\t            png_fixed_point g = PNG_FP_1;  /* Correction to linear */\n1864\t            png_fixed_point gs = PNG_FP_1; /* Correction to screen */\n1865\t\n1866\t            switch (png_ptr->background_gamma_type)\n1867\t            {\n1868\t               case PNG_BACKGROUND_GAMMA_SCREEN:\n1869\t                  g = png_ptr->screen_gamma;\n1870\t                  /* gs = PNG_FP_1; */\n1871\t                  break;\n1872\t\n1873\t               case PNG_BACKGROUND_GAMMA_FILE:\n1874\t                  g = png_reciprocal(png_ptr->file_gamma);\n1875\t                  gs = png_reciprocal2(png_ptr->file_gamma,\n1876\t                      png_ptr->screen_gamma);\n1877\t                  break;\n1878\t\n1879\t               case PNG_BACKGROUND_GAMMA_UNIQUE:\n1880\t                  g = png_reciprocal(png_ptr->background_gamma);\n1881\t                  gs = png_reciprocal2(png_ptr->background_gamma,\n1882\t                      png_ptr->screen_gamma);\n1883\t                  break;\n1884\t\n1885\t               default:\n1886\t                  png_error(png_ptr, \"invalid background gamma type\");\n1887\t            }\n1888\t\n1889\t            g_sig = png_gamma_significant(g);\n1890\t            gs_sig = png_gamma_significant(gs);\n1891\t\n1892\t            if (g_sig != 0)\n1893\t               png_ptr->background_1.gray = png_gamma_correct(png_ptr,\n1894\t                   png_ptr->background.gray, g);\n1895\t\n1896\t            if (gs_sig != 0)\n1897\t               png_ptr->background.gray = png_gamma_correct(png_ptr,\n1898\t                   png_ptr->background.gray, gs);\n1899\t\n1900\t            if ((png_ptr->background.red != png_ptr->background.green) ||\n1901\t                (png_ptr->background.red != png_ptr->background.blue) ||\n1902\t                (png_ptr->background.red != png_ptr->background.gray))\n1903\t            {\n1904\t               /* RGB or RGBA with color background */\n1905\t               if (g_sig != 0)\n1906\t               {\n1907\t                  png_ptr->background_1.red = png_gamma_correct(png_ptr,\n1908\t                      png_ptr->background.red, g);\n1909\t\n1910\t                  png_ptr->background_1.green = png_gamma_correct(png_ptr,\n1911\t                      png_ptr->background.green, g);\n1912\t\n1913\t                  png_ptr->background_1.blue = png_gamma_correct(png_ptr,\n1914\t                      png_ptr->background.blue, g);\n1915\t               }\n1916\t\n1917\t               if (gs_sig != 0)\n1918\t               {\n1919\t                  png_ptr->background.red = png_gamma_correct(png_ptr,\n1920\t                      png_ptr->background.red, gs);\n1921\t\n1922\t                  png_ptr->background.green = png_gamma_correct(png_ptr,\n1923\t                      png_ptr->background.green, gs);\n1924\t\n1925\t                  png_ptr->background.blue = png_gamma_correct(png_ptr,\n1926\t                      png_ptr->background.blue, gs);\n1927\t               }\n1928\t            }\n1929\t\n1930\t            else\n1931\t            {\n1932\t               /* GRAY, GRAY ALPHA, RGB, or RGBA with gray background */\n1933\t               png_ptr->background_1.red = png_ptr->background_1.green\n1934\t                   = png_ptr->background_1.blue = png_ptr->background_1.gray;\n1935\t\n1936\t               png_ptr->background.red = png_ptr->background.green\n1937\t                   = png_ptr->background.blue = png_ptr->background.gray;\n1938\t            }\n1939\t\n1940\t            /* The background is now in screen gamma: */\n1941\t            png_ptr->background_gamma_type = PNG_BACKGROUND_GAMMA_SCREEN;\n1942\t         } /* color_type != PNG_COLOR_TYPE_PALETTE */\n1943\t      }/* png_ptr->transformations & PNG_BACKGROUND */\n1944\t\n1945\t      else\n1946\t      /* Transformation does not include PNG_BACKGROUND */\n1947\t#endif /* READ_BACKGROUND */\n1948\t      if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE\n1949\t#ifdef PNG_READ_RGB_TO_GRAY_SUPPORTED\n1950\t         /* RGB_TO_GRAY needs to have non-gamma-corrected values! */\n1951\t         && ((png_ptr->transformations & PNG_EXPAND) == 0 ||\n1952\t         (png_ptr->transformations & PNG_RGB_TO_GRAY) == 0)\n1953\t#endif\n1954\t         )\n1955\t      {\n1956\t         png_colorp palette = png_ptr->palette;\n1957\t         int num_palette = png_ptr->num_palette;\n1958\t         int i;\n1959\t\n1960\t         /* NOTE: there are other transformations that should probably be in\n1961\t          * here too.\n1962\t          */\n1963\t         for (i = 0; i < num_palette; i++)\n1964\t         {\n1965\t            palette[i].red = png_ptr->gamma_table[palette[i].red];\n1966\t            palette[i].green = png_ptr->gamma_table[palette[i].green];\n1967\t            palette[i].blue = png_ptr->gamma_table[palette[i].blue];\n1968\t         }\n1969\t\n1970\t         /* Done the gamma correction. */\n1971\t         png_ptr->transformations &= ~PNG_GAMMA;\n1972\t      } /* color_type == PALETTE && !PNG_BACKGROUND transformation */\n1973\t   }\n1974\t#ifdef PNG_READ_BACKGROUND_SUPPORTED\n1975\t   else\n1976\t#endif\n1977\t#endif /* READ_GAMMA */\n1978\t\n1979\t#ifdef PNG_READ_BACKGROUND_SUPPORTED\n1980\t   /* No GAMMA transformation (see the hanging else 4 lines above) */\n1981\t   if ((png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1982\t       (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE))\n1983\t   {\n1984\t      int i;\n1985\t      int istop = (int)png_ptr->num_trans;\n1986\t      png_color back;\n1987\t      png_colorp palette = png_ptr->palette;\n1988\t\n1989\t      back.red   = (png_byte)png_ptr->background.red;\n1990\t      back.green = (png_byte)png_ptr->background.green;\n1991\t      back.blue  = (png_byte)png_ptr->background.blue;\n1992\t\n1993\t      for (i = 0; i < istop; 