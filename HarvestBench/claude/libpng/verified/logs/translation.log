{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0123xCtcpLqSWLTSxZheKkZV","type":"tool_result","content":"/* muldiv functions */\n/* This API takes signed arguments and rounds the result to the nearest\n * integer (or, for a fixed point number - the standard argument - to\n * the nearest .00001).  Overflow and divide by zero are signalled in\n * the result, a boolean - true on success, false on overflow.\n */\n/* png_muldiv */\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn png_muldiv(\n    res: png_fixed_point_p,\n    a: png_fixed_point,\n    times: png_int_32,\n    divisor: png_int_32,\n) -> c_int {\n    /* Return a * times / divisor, rounded. */\n    if divisor != 0 {\n        if a == 0 || times == 0 {\n            *res = 0;\n            return 1;\n        } else {\n            let mut r: f64 = a as f64;\n            r *= times as f64;\n            r /= divisor as f64;\n            r = floor(r + 0.5);\n\n            /* A png_fixed_point is a 32-bit integer. */\n=== png_info fields ===\n984:pub struct png_info_def {\n985-    pub width: png_uint_32,\n986-    pub height: png_uint_32,\n987-    pub valid: png_uint_32,\n988-    pub rowbytes: usize,\n989-    pub palette: png_colorp,\n990-    pub num_palette: png_uint_16,\n991-    pub num_trans: png_uint_16,\n992-    pub bit_depth: png_byte,\n993-    pub color_type: png_byte,\n994-    pub compression_type: png_byte,\n995-    pub filter_type: png_byte,\n996-    pub interlace_type: png_byte,\n997-\n998-    pub channels: png_byte,\n999-    pub pixel_depth: png_byte,\n1000-    pub spare_byte: png_byte,\n1001-\n1002-    pub signature: [png_byte; 8],\n1003-\n1004-    pub cicp_colour_primaries: png_byte,\n1005-    pub cicp_transfer_function: png_byte,\n1006-    pub cicp_matrix_coefficients: png_byte,\n1007-    pub cicp_video_full_range_flag: png_byte,\n1008-\n1009-    pub iccp_name: png_charp,\n1010-    pub iccp_profile: png_bytep,\n1011-    pub iccp_proflen: png_uint_32,\n1012-\n1013-    pub max