{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014pNC6bjPQJoU44j6GQ7B4B","type":"tool_result","content":"1\t/* png.c lines 1..690 */\n2\t\n3\t/* Tells libpng that we have already handled the first \"num_bytes\" bytes\n4\t * of the PNG file signature.  If the PNG data is embedded into another\n5\t * stream we can set num_bytes = 8 so that libpng will not attempt to read\n6\t * or write any of the magic bytes before it starts on the IHDR.\n7\t */\n8\t\n9\t/* png_set_sig_bytes */\n10\t#[unsafe(no_mangle)]\n11\tpub unsafe extern \"C\" fn png_set_sig_bytes(png_ptr: png_structrp, num_bytes: c_int) {\n12\t    let mut nb: c_uint = num_bytes as c_uint;\n13\t\n14\t    if png_ptr == core::ptr::null_mut() {\n15\t        return;\n16\t    }\n17\t\n18\t    if num_bytes < 0 {\n19\t        nb = 0;\n20\t    }\n21\t\n22\t    if nb > 8 {\n23\t        png_error(\n24\t            png_ptr,\n25\t            b\"Too many bytes for PNG signature\\0\".as_ptr() as png_const_charp,\n26\t        );\n27\t    }\n28\t\n29\t    (*png_ptr).sig_bytes = nb as png_byte;\n30\t}\n31\t\n32\t/* `static const png_byte png_signature[8]` from png_sig_cmp */\n33\tstatic png_signature: [png_byte; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n34\t\n35\t/* Checks whether the supplied bytes match the PNG signature.  We allow\n36\t * checking less than the full 8-byte signature so that those apps that\n37\t * already read the first few bytes of a file to determine the file type\n38\t * can simply check the remaining bytes for extra assurance.  Returns\n39\t * an integer less than, equal to, or greater than zero if sig is found,\n40\t * respectively, to be less than, to match, or be greater than the correct\n41\t * PNG signature (this is the same behavior as strcmp, memcmp, etc).\n42\t */\n43\t/* png_sig_cmp */\n44\t#[unsafe(no_mangle)]\n45\tpub unsafe extern \"C\" fn png_sig_cmp(\n46\t    sig: png_const_bytep,\n47\t    start: usize,\n48\t    mut num_to_check: usize,\n49\t) -> c_int {\n50\t    if num_to_check > 8 {\n51\t        num_to_check = 8;\n52\t    } else if num_to_check < 1 {\n53\t        return -1;\n54\t    }\n55\t\n56\t    if start > 7 {\n57\t        return -1;\n58\t    }\n59\t\n60\t    if start + num_to_check > 8 {\n61\t        num_to_check = 8 - start;\n62\t    }\n63\t\n64\t    memcmp(\n65\t        sig.add(start) as *const c_void,\n66\t        png_signature.as_ptr().add(start) as *const c_void,\n67\t        num_to_check,\n68\t    )\n69\t}\n70\t\n71\t/* Function to allocate memory for zlib */\n72\t/* png_zalloc */\n73\t#[unsafe(no_mangle)]\n74\tpub unsafe extern \"C\" fn png_zalloc(png_ptr: voidpf, items: uInt, size: uInt) -> voidpf {\n75\t    let mut num_bytes: png_alloc_size_t = size as png_alloc_size_t;\n76\t\n77\t    if png_ptr == core::ptr::null_mut() {\n78\t        return core::ptr::null_mut();\n79\t    }\n80\t\n81\t    /* This check against overflow is vestigial, dating back from\n82\t     * the old times when png_zalloc used to be an exported function.\n83\t     * We're still keeping it here for now, as an extra-cautious\n84\t     * prevention against programming errors inside zlib, although it\n85\t     * should rather be a debug-time assertion instead.\n86\t     */\n87\t    if size != 0\n88\t        && (items as png_alloc_size_t)\n89\t            >= ((!(0 as png_alloc_size_t)) / (size as png_alloc_size_t))\n90\t    {\n91\t        png_warning(\n92\t            png_ptr as png_structrp,\n93\t            b\"Potential overflow in png_zalloc()\\0\".as_ptr() as png_const_charp,\n94\t        );\n95\t        return core::ptr::null_mut();\n96\t    }\n97\t\n98\t    num_bytes = num_bytes.wrapping_mul(items as png_alloc_size_t);\n99\t    png_malloc_warn(png_ptr as png_structrp, num_bytes)\n100\t}\n101\t\n102\t/* Function to free memory for zlib */\n103\t/* png_zfree */\n104\t#[unsafe(no_mangle)]\n105\tpub unsafe extern \"C\" fn png_zfree(png_ptr: voidpf, ptr: voidpf) {\n106\t    png_free(png_ptr as png_const_structrp, ptr);\n107\t}\n108\t\n109\t/* Reset the CRC variable to 32 bits of 1's.  Care must be taken\n110\t * in case CRC is > 32 bits to leave the top bits 0.\n111\t */\n112\t/* png_reset_crc */\n113\t#[unsafe(no_mangle)]\n114\tpub unsafe extern \"C\" fn png_reset_crc(png_ptr: png_structrp) {\n115\t    /* The cast is safe because the crc is a 32-bit value. */\n116\t    (*png_ptr).crc = crc32(0, core::ptr::null(), 0) as png_uint_32;\n117\t}\n118\t\n119\t/* Calculate the CRC over a section of data.  We can only pass as\n120\t * much data to this routine as the largest single buffer size.  We\n121\t * also check that this data will actually be used before going to the\n122\t * trouble of calculating it.\n123\t */\n124\t/* png_calculate_crc */\n125\t#[unsafe(no_mangle)]\n126\tpub unsafe extern \"C\" fn png_calculate_crc(\n127\t    png_ptr: png_structrp,\n128\t    mut ptr: png_const_bytep,\n129\t    mut length: usize,\n130\t) {\n131\t    let mut need_crc: c_int = 1;\n132\t\n133\t    if PNG_CHUNK_ANCILLARY((*png_ptr).chunk_name) != 0 {\n134\t        if ((*png_ptr).flags & PNG_FLAG_CRC_ANCILLARY_MASK)\n135\t            == (PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN)\n136\t        {\n137\t            need_crc = 0;\n138\t        }\n139\t    }\n140\t    /* critical */\n141\t    else {\n142\t        if ((*png_ptr).flags & PNG_FLAG_CRC_CRITICAL_IGNORE) != 0 {\n143\t            need_crc = 0;\n144\t        }\n145\t    }\n146\t\n147\t    /* 'uLong' is defined in zlib.h as unsigned long; this means that on some\n148\t     * systems it is a 64-bit value.  crc32, however, returns 32 bits so the\n149\t     * following cast is safe.  'uInt' may be no more than 16 bits, so it is\n150\t     * necessary to perform a loop here.\n151\t     */\n152\t    if need_crc != 0 && length > 0 {\n153\t        let mut crc: uLong = (*png_ptr).crc as uLong; /* Should never issue a warning */\n154\t\n155\t        loop {\n156\t            let mut safe_length: uInt = length as uInt;\n157\t            if safe_length == 0 {\n158\t                safe_length = (-1i32) as uInt; /* evil, but safe */\n159\t            }\n160\t\n161\t            crc = crc32(crc, ptr as *const Bytef, safe_length);\n162\t\n163\t            /* The following should never issue compiler warnings; if they do the\n164\t             * target system has characteristics that will probably violate other\n165\t             * assumptions within the libpng code.\n166\t             */\n167\t            ptr = ptr.add(safe_length as usize);\n168\t            length -= safe_length as usize;\n169\t\n170\t            if !(length > 0) {\n171\t                break;\n172\t            }\n173\t        }\n174\t\n175\t        /* And the following is always safe because the crc is only 32 bits. */\n176\t        (*png_ptr).crc = crc as png_uint_32;\n177\t    }\n178\t}\n179\t\n180\t/* Check a user supplied version number, called from both read and write\n181\t * functions that create a png_struct.\n182\t */\n183\t/* png_user_version_check */\n184\t#[unsafe(no_mangle)]\n185\tpub unsafe extern \"C\" fn png_user_version_check(\n186\t    png_ptr: png_structrp,\n187\t    user_png_ver: png_const_charp,\n188\t) -> c_int {\n189\t    /* Libpng versions 1.0.0 and later are binary compatible if the version\n190\t     * string matches through the second '.'; we must recompile any\n191\t     * applications that use any older library version.\n192\t     */\n193\t\n194\t    if user_png_ver != core::ptr::null() {\n195\t        let mut i: c_int = -1;\n196\t        let mut found_dots: c_int = 0;\n197\t\n198\t        loop {\n199\t            i += 1;\n200\t            if *user_png_ver.offset(i as isize)\n201\t                != *PNG_LIBPNG_VER_STRING.as_ptr().offset(i as isize) as c_char\n202\t            {\n203\t                (*png_ptr).flags |= PNG_FLAG_LIBRARY_MISMATCH;\n204\t            }\n205\t            if *user_png_ver.offset(i as isize) == b'.' as c_char {\n206\t                found_dots += 1;\n207\t            }\n208\t\n209\t            if !(found_dots < 2\n210\t                && *user_png_ver.offset(i as isize) != 0\n211\t                && *PNG_LIBPNG_VER_STRING.as_ptr().offset(i as isize) as c_char != 0)\n212\t            {\n213\t                break;\n214\t            }\n215\t        }\n216\t    } else {\n217\t        (*png_ptr).flags |= PNG_FLAG_LIBRARY_MISMATCH;\n218\t    }\n219\t\n220\t    if ((*png_ptr).flags & PNG_FLAG_LIBRARY_MISMATCH) != 0 {\n221\t        let mut pos: usize = 0;\n222\t        let mut m: [c_char; 128] = [0; 128];\n223\t\n224\t        pos = png_safecat(\n225\t            m.as_mut_ptr(),\n226\t            128,\n227\t            pos,\n228\t            b\"Application built with libpng-\\0\".as_ptr() as png_const_charp,\n229\t        );\n230\t        pos = png_safecat(m.as_mut_ptr(), 128, pos, user_png_ver);\n231\t        pos = png_safecat(\n232\t            m.as_mut_ptr(),\n233\t            128,\n234\t            pos,\n235\t            b\" but running with \\0\".as_ptr() as png_const_charp,\n236\t        );\n237\t        pos = png_safecat(\n238\t            m.as_mut_ptr(),\n239\t            128,\n240\t            pos,\n241\t            PNG_LIBPNG_VER_STRING.as_ptr() as png_const_charp,\n242\t        );\n243\t\n244\t        png_warning(png_ptr, m.as_ptr() as png_const_charp);\n245\t\n246\t        return 0;\n247\t    }\n248\t\n249\t    /* Success return. */\n250\t    1\n251\t}\n252\t\n253\t/* The C code assigns `longjmp` directly to `create_struct.longjmp_fn`; a shim\n254\t * is needed because the Rust declaration of `longjmp` diverges (`-> !`).\n255\t */\n256\tunsafe extern \"C\" fn png_create_longjmp_shim(env: *mut jmp_buf, val: c_int) {\n257\t    longjmp(env, val)\n258\t}\n259\t\n260\t/* Generic function to create a png_struct for either read or write - this\n261\t * contains the common initialization.\n262\t */\n263\t/* png_create_png_struct */\n264\t#[unsafe(no_mangle)]\n265\tpub unsafe extern \"C\" fn png_create_png_struct(\n266\t    user_png_ver: png_const_charp,\n267\t    error_ptr: png_voidp,\n268\t    error_fn: png_error_ptr,\n269\t    warn_fn: png_error_ptr,\n270\t    mem_ptr: png_voidp,\n271\t    malloc_fn: png_malloc_ptr,\n272\t    free_fn: png_free_ptr,\n273\t) -> png_structp {\n274\t    /* This temporary stack-allocated structure is used to provide a place to\n275\t     * build enough context to allow the user provided memory allocator (if any)\n276\t     * to be called.\n277\t     */\n278\t    let mut create_struct: png_struct = core::mem::zeroed();\n279\t    let mut create_jmp_buf: jmp_buf = [0; 25];\n280\t\n281\t    create_struct.user_width_max = PNG_USER_WIDTH_MAX;\n282\t    create_struct.user_height_max = PNG_USER_HEIGHT_MAX;\n283\t\n284\t    create_struct.user_chunk_cache_max = PNG_USER_CHUNK_CACHE_MAX;\n285\t\n286\t    /* default to compile-time limit */\n287\t    create_struct.user_chunk_malloc_max = PNG_USER_CHUNK_MALLOC_MAX;\n288\t\n289\t    /* The following two API calls simply set fields in png_struct, so it is safe\n290\t     * to do them now even though error handling is not yet set up.\n291\t     */\n292\t    png_set_mem_fn(&mut create_struct, mem_ptr, malloc_fn, free_fn);\n293\t\n294\t    /* (*error_fn) can return control to the caller after the error_ptr is set,\n295\t     * this will result in a memory leak unless the error_fn does something\n296\t     * extremely sophisticated.  The design lacks merit but is implicit in the\n297\t     * API.\n298\t     */\n299\t    png_set_error_fn(&mut create_struct, error_ptr, error_fn, warn_fn);\n300\t\n301\t    if setjmp(&mut create_jmp_buf) == 0 {\n302\t        /* Temporarily fake out the longjmp information until we have\n303\t         * successfully completed this function.  This only works if we have\n304\t         * setjmp() support compiled in, but it is safe - this stuff should\n305\t         * never happen.\n306\t         */\n307\t        create_struct.jmp_buf_ptr = &mut create_jmp_buf;\n308\t        create_struct.jmp_buf_size = 0; /*stack allocation*/\n309\t        create_struct.longjmp_fn = Some(png_create_longjmp_shim);\n310\t\n311\t        /* Call the general version checker (shared with read and write code):\n312\t         */\n313\t        if png_user_version_check(&mut create_struct, user_png_ver) != 0 {\n314\t            let png_ptr: png_structrp = png_malloc_warn(\n315\t                &mut create_struct,\n316\t                core::mem::size_of::<png_struct>() as png_alloc_size_t,\n317\t            ) as png_structrp;\n318\t\n319\t            if png_ptr != core::ptr::null_mut() {\n320\t                /* png_ptr->zstream holds a back-pointer to the png_struct, so\n321\t                 * this can only be done now:\n322\t                 */\n323\t                create_struct.zstream.zalloc = Some(png_zalloc);\n324\t                create_struct.zstream.zfree = Some(png_zfree);\n325\t                create_struct.zstream.opaque = png_ptr as voidpf;\n326\t\n327\t                /* Eliminate the local error handling: */\n328\t                create_struct.jmp_buf_ptr = core::ptr::null_mut();\n329\t                create_struct.jmp_buf_size = 0;\n330\t                create_struct.longjmp_fn = None;\n331\t\n332\t                core::ptr::write(png_ptr, create_struct);\n333\t\n334\t                /* This is the successful return point */\n335\t                return png_ptr;\n336\t            }\n337\t        }\n338\t    }\n339\t\n340\t    /* A longjmp because of a bug in the application storage allocator or a\n341\t     * simple failure to allocate the png_struct.\n342\t     */\n343\t    core::ptr::null_mut()\n344\t}\n345\t\n346\t/* Allocate the memory for an info_struct for the application. */\n347\t/* png_create_info_struct */\n348\t#[unsafe(no_mangle)]\n349\tpub unsafe extern \"C\" fn png_create_info_struct(png_ptr: png_const_structrp) -> png_infop {\n350\t    let info_ptr: png_inforp;\n351\t\n352\t    if png_ptr == core::ptr::null_mut() {\n353\t        return core::ptr::null_mut();\n354\t    }\n355\t\n356\t    /* Use the internal API that does not (or at least should not) error out, so\n357\t     * that this call always returns ok.  The application typically sets up the\n358\t     * error handling *after* creating the info_struct because this is the way it\n359\t     * has always been done in 'example.c'.\n360\t     */\n361\t    info_ptr = png_malloc_base(\n362\t        png_ptr,\n363\t        core::mem::size_of::<png_info>() as png_alloc_size_t,\n364\t    ) as png_inforp;\n365\t\n366\t    if info_ptr != core::ptr::null_mut() {\n367\t        memset(\n368\t            info_ptr as *mut c_void,\n369\t            0,\n370\t            core::mem::size_of::<png_info>(),\n371\t        );\n372\t    }\n373\t\n374\t    info_ptr\n375\t}\n376\t\n377\t/* This function frees the memory associated with a single info struct.\n378\t * Normally, one would use either png_destroy_read_struct() or\n379\t * png_destroy_write_struct() to free an info struct, but this may be\n380\t * useful for some applications.  From libpng 1.6.0 this function is also used\n381\t * internally to implement the png_info release part of the 'struct' destroy\n382\t * APIs.  This ensures that all possible approaches free the same data (all of\n383\t * it).\n384\t */\n385\t/* png_destroy_info_struct */\n386\t#[unsafe(no_mangle)]\n387\tpub unsafe extern \"C\" fn png_destroy_info_struct(\n388\t    png_ptr: png_const_structrp,\n389\t    info_ptr_ptr: png_infopp,\n390\t) {\n391\t    let mut info_ptr: png_inforp = core::ptr::null_mut();\n392\t\n393\t    if png_ptr == core::ptr::null_mut() {\n394\t        return;\n395\t    }\n396\t\n397\t    if info_ptr_ptr != core::ptr::null_mut() {\n398\t        info_ptr = *info_ptr_ptr;\n399\t    }\n400\t\n401\t    if info_ptr != core::ptr::null_mut() {\n402\t        /* Do this first in case of an error below; if the app implements its own\n403\t         * memory management this can lead to png_free calling png_error, which\n404\t         * will abort this routine and return control to the app error handler.\n405\t         * An infinite loop may result if it then tries to free the same info\n406\t         * ptr.\n407\t         */\n408\t        *info_ptr_ptr = core::ptr::null_mut();\n409\t\n410\t        png_free_data(png_ptr, info_ptr, PNG_FREE_ALL, -1);\n411\t        memset(\n412\t            info_ptr as *mut c_void,\n413\t            0,\n414\t            core::mem::size_of::<png_info>(),\n415\t        );\n416\t        png_free(png_ptr, info_ptr as png_voidp);\n417\t    }\n418\t}\n419\t\n420\t/* Initialize the info structure.  This is now an internal function (0.89)\n421\t * and applications using it are urged to use png_create_info_struct()\n422\t * instead.  Use deprecated in 1.6.0, internal use removed (used internally it\n423\t * is just a memset).\n424\t *\n425\t * NOTE: it is almost inconceivable that this API is used because it bypasses\n426\t * the user-memory mechanism and the user error handling/warning mechanisms in\n427\t * those cases where it does anything other than a memset.\n428\t */\n429\t/* png_info_init_3 */\n430\t#[unsafe(no_mangle)]\n431\tpub unsafe extern \"C\" fn png_info_init_3(ptr_ptr: png_infopp, png_info_struct_size: usize) {\n432\t    let mut info_ptr: png_inforp = *ptr_ptr;\n433\t\n434\t    if info_ptr == core::ptr::null_mut() {\n435\t        return;\n436\t    }\n437\t\n438\t    if core::mem::size_of::<png_info>() > png_info_struct_size {\n439\t        *ptr_ptr = core::ptr::null_mut();\n440\t        /* The following line is why this API should not be used: */\n441\t        free(info_ptr as *mut c_void);\n442\t        info_ptr = png_malloc_base(\n443\t            core::ptr::null_mut(),\n444\t            core::mem::size_of::<png_info>() as png_alloc_size_t,\n445\t        ) as png_inforp;\n446\t        if info_ptr == core::ptr::null_mut() {\n447\t            return;\n448\t        }\n449\t        *ptr_ptr = info_ptr;\n450\t    }\n451\t\n452\t    /* Set everything to 0 */\n453\t    memset(\n454\t        info_ptr as *mut c_void,\n455\t        0,\n456\t        core::mem::size_of::<png_info>(),\n457\t    );\n458\t}\n459\t\n460\t/* png_data_freer */\n461\t#[unsafe(no_mangle)]\n462\tpub unsafe extern \"C\" fn png_data_freer(\n463\t    png_ptr: png_const_structrp,\n464\t    info_ptr: png_inforp,\n465\t    freer: c_int,\n466\t    mask: png_uint_32,\n467\t) {\n468\t    if png_ptr == core::ptr::null_mut() || info_ptr == core::ptr::null_mut() {\n469\t        return;\n470\t    }\n471\t\n472\t    if freer == PNG_DESTROY_WILL_FREE_DATA {\n473\t        (*info_ptr).free_me |= mask;\n474\t    } else if freer == PNG_USER_WILL_FREE_DATA {\n475\t        (*info_ptr).free_me &= !mask;\n476\t    } else {\n477\t        png_error(\n478\t            png_ptr,\n479\t            b\"Unknown freer parameter in png_data_freer\\0\".as_ptr() as png_const_charp,\n480\t        );\n481\t    }\n482\t}\n483\t\n484\t/* png_free_data */\n485\t#[unsafe(no_mangle)]\n486\tpub unsafe extern \"C\" fn png_free_data(\n487\t    png_ptr: png_const_structrp,\n488\t    info_ptr: png_inforp,\n489\t    mut mask: png_uint_32,\n490\t    num: c_int,\n491\t) {\n492\t    if png_ptr == core::ptr::null_mut() || info_ptr == core::ptr::null_mut() {\n493\t        return;\n494\t    }\n495\t\n496\t    /* Free text item num or (if num == -1) all text items */\n497\t    if (*info_ptr).text != core::ptr::null_mut()\n498\t        && ((mask & PNG_FREE_TEXT) & (*info_ptr).free_me) != 0\n499\t    {\n500\t        if num != -1 {\n501\t            png_free(png_ptr, (*(*info_ptr).text.offset(num as isize)).key as png_voidp);\n502\t            (*(*info_ptr).text.offset(num as isize)).key = core::ptr::null_mut();\n503\t        } else {\n504\t            let mut i: c_int = 0;\n505\t\n506\t            while i < (*info_ptr).num_text {\n507\t                png_free(png_ptr, (*(*info_ptr).text.offset(i as isize)).key as png_voidp);\n508\t                i += 1;\n509\t            }\n510\t\n511\t            png_free(png_ptr, (*info_ptr).text as png_voidp);\n512\t            (*info_ptr).text = core::ptr::null_mut();\n513\t            (*info_ptr).num_text = 0;\n514\t            (*info_ptr).max_text = 0;\n515\t        }\n516\t    }\n517\t\n518\t    /* Free any tRNS entry */\n519\t    if ((mask & PNG_FREE_TRNS) & (*info_ptr).free_me) != 0 {\n520\t        (*info_ptr).valid &= !PNG_INFO_tRNS;\n521\t        png_free(png_ptr, (*info_ptr).trans_alpha as png_voidp);\n522\t        (*info_ptr).trans_alpha = core::ptr::null_mut();\n523\t        (*info_ptr).num_trans = 0;\n524\t    }\n525\t\n526\t    /* Free any sCAL entry */\n527\t    if ((mask & PNG_FREE_SCAL) & (*info_ptr).free_me) != 0 {\n528\t        png_free(png_ptr, (*info_ptr).scal_s_width as png_voidp);\n529\t        png_free(png_ptr, (*info_ptr).scal_s_height as png_voidp);\n530\t        (*info_ptr).scal_s_width = core::ptr::null_mut();\n531\t        (*info_ptr).scal_s_height = core::ptr::null_mut();\n532\t        (*info_ptr).valid &= !PNG_INFO_sCAL;\n533\t    }\n534\t\n535\t    /* Free any pCAL entry */\n536\t    if ((mask & PNG_FREE_PCAL) & (*info_ptr).free_me) != 0 {\n537\t        png_free(png_ptr, (*info_ptr).pcal_purpose as png_voidp);\n538\t        png_free(png_ptr, (*info_ptr).pcal_units as png_voidp);\n539\t        (*info_ptr).pcal_purpose = core::ptr::null_mut();\n540\t        (*info_ptr).pcal_units = core::ptr::null_mut();\n541\t\n542\t        if (*info_ptr).pcal_params != core::ptr::null_mut() {\n543\t            let mut i: c_int = 0;\n544\t\n545\t            while i < (*info_ptr).pcal_nparams as c_int {\n546\t                png_free(png_ptr, *(*info_ptr).pcal_params.offset(i as isize) as png_voidp);\n547\t                i += 1;\n548\t            }\n549\t\n550\t            png_free(png_ptr, (*info_ptr).pcal_params as png_voidp);\n551\t            (*info_ptr).pcal_params = core::ptr::null_mut();\n552\t        }\n553\t        (*info_ptr).valid &= !PNG_INFO_pCAL;\n554\t    }\n555\t\n556\t    /* Free any profile entry */\n557\t    if ((mask & PNG_FREE_ICCP) & (*info_ptr).free_me) 