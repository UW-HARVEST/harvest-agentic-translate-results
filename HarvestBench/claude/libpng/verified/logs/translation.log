b(addend0: png_int_32, addend1: png_int_32, error: *mut c_int) -> png_int_32 {\n503\t    /* As above but calculate addend0-addend1. */\n504\t    if addend1 > 0 {\n505\t        if -0x7fffffff + addend1 <= addend0 {\n506\t            return addend0 - addend1;\n507\t        }\n508\t    } else if addend1 < 0 {\n509\t        if 0x7fffffff + addend1 >= addend0 {\n510\t            return addend0 - addend1;\n511\t        }\n512\t    } else {\n513\t        return addend0;\n514\t    }\n515\t\n516\t    *error = 1;\n517\t    PNG_FP_1 / 2\n518\t}\n519\t\n520\t/* png_safe_add */\n521\tunsafe fn png_safe_add(\n522\t    addend0_and_result: *mut png_int_32,\n523\t    addend1: png_int_32,\n524\t    addend2: png_int_32,\n525\t) -> c_int {\n526\t    /* Safely add three integers.  Returns 0 on success, 1 on overflow.  Does not\n527\t     * set the result on overflow.\n528\t     */\n529\t    let mut error: c_int = 0;\n530\t    let result: c_int = png_fp_add(\n531\t        *addend0_and_result,\n532\t        png_fp_add(addend1, addend2, core::ptr::addr_of_mut!(error)),\n533\t        core::ptr::addr_of_mut!(error),\n534\t    );\n535\t    if error == 0 {\n536\t        *addend0_and_result = result;\n537\t    }\n538\t    error\n539\t}\n540\t"}]},"parent_tool_use_id":"toolu_bdrk_016LvdZrTkmwgeg99jmJXCPG","session_id":"d9f98909-8564-4f94-b720-603696df3aad","uuid":"fe2d4d39-5abb-4582-9f43-b232a90c4d1b","timestamp":"2026-08-22T20:08:46.799Z","subagent_type":"general-purpose","task_description":"Translate png.c 1137-1501"}
