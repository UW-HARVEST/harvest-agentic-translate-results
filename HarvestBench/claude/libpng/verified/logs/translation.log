f *m,int w,int h,int ct,int bd,int il,int with_trns,int with_gama,int with_bkgd)\n{\n   png_structp p; png_infop ip; png_bytep *rows; int y;\n   int channels = (ct==PNG_COLOR_TYPE_RGB)?3:(ct==PNG_COLOR_TYPE_RGB_ALPHA)?4:\n                  (ct==PNG_COLOR_TYPE_GRAY_ALPHA)?2:1;\n   size_t rb = ((size_t)w*channels*bd+7)/8;\n   mb_init(m);\n   p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n   ip=png_create_info_struct(p);\n   if(setjmp(png_jmpbuf(p))){printf(\"make LONGJMP\\n\");return;}\n   png_set_write_fn(p,m,wfn,ffn);\n   png_set_IHDR(p,ip,w,h,bd,ct,il,PNG_COMPRESSION_TYPE_DEFAULT,PNG_FILTER_TYPE_DEFAULT);\n   if(ct&PNG_COLOR_MASK_PALETTE){\n     png_color pal[256];png_byte tr[256];int n=1<<bd,i;\n     for(i=0;i<n;i++){pal[i].red=(png_byte)(i*3+1);pal[i].green=(png_byte)(i*5+2);pal[i].blue=(png_byte)(i*7+3);tr[i]=(png_byte)(i*11);}\n     png_set_PLTE(p,ip,pal,n);\n     if(with_trns) png_set_tRNS(p,ip,tr,n,NULL);\n   } else if(with_trns && !(ct&PNG_COLOR_MASK_ALPHA)){\n     png_color_16 tc; memset(&tc,0,sizeof tc);\n     tc.gray=(png_uint_16)(3&((1<<bd)-1)); tc.red=1;tc.green=2;tc.blue=3;\n     png_set_tRNS(p,ip,NULL,0,&tc);\n   }\n   if(with_gama) png_set_gAMA(p,ip,0.5);\n   if(with_bkgd){png_color_16 b;memset(&b,0,sizeof b);b.index=2;b.gray=(png_uint_16)((1<<bd)/2);b.red=10;b.green=20;b.blue=30;png_set_bKGD(p,ip,&b);}\n   png_write_info(p,ip);\n   rows=malloc(sizeof(png_bytep)*h);\n   rs=4242;\n   for(y=0;y<h;y++){size_t i;rows[y]=malloc(rb?rb:1);for(i=0;i<rb;i++)rows[y][i]=(unsigned char)((y*7+i*3+(rnd()&15))&0xff);}\n   png_write_image(p,rows);\n   png_write_end(p,ip);\n   for(y=0;y<h;y++)free(rows[y]);\n   free(rows);\n   png_destroy_write_struct(&p,&ip);\n}\n\n/* read with a bitmask of transforms */\nstatic void read_xf(const char*tag, membuf *src, unsigned xf, int seq)\n{\n   memrd r; png_structp p; png_infop ip; png_uint_32 w,h,y; int bd,ct,il,cm,fm;\n   unsigned long acc=0; size_t total=0;\n   r.buf=src->buf;r.len=src->len;r.pos=0;\n   