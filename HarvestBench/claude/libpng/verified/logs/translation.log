{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PYXEmpWejBhpNNn6v8y4X1","type":"tool_result","content":"1\t/* png.c lines 1..690 */\n2\t\n3\t/* Tells libpng that we have already handled the first \"num_bytes\" bytes\n4\t * of the PNG file signature.  If the PNG data is embedded into another\n5\t * stream we can set num_bytes = 8 so that libpng will not attempt to read\n6\t * or write any of the magic bytes before it starts on the IHDR.\n7\t */\n8\t\n9\t/* png_set_sig_bytes */\n10\t#[unsafe(no_mangle)]\n11\tpub unsafe extern \"C\" fn png_set_sig_bytes(png_ptr: png_structrp, num_bytes: c_int) {\n12\t    let mut nb: c_uint = num_bytes as c_uint;\n13\t\n14\t    if png_ptr == core::ptr::null_mut() {\n15\t        return;\n16\t    }\n17\t\n18\t    if num_bytes < 0 {\n19\t        nb = 0;\n20\t    }\n21\t\n22\t    if nb > 8 {\n23\t        png_error(\n24\t            png_ptr,\n25\t            b\"Too many bytes for PNG signature\\0\".as_ptr() as png_const_charp,\n26\t        );\n27\t    }\n28\t\n29\t    (*png_ptr).sig_bytes = nb as png_byte;\n30\t}\n31\t\n32\t/* `static const png_byte png_signature[8]` from png_sig_cmp */\n33\tstatic png_signature: [png_byte; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n34\t\n35\t/* Checks whether the supplied bytes match the PNG signature.  We allow\n36\t * checking less than the full 8-byte signature so that those apps that\n37\t * already read the first few bytes of a file to determine the file type\n38\t * can simply check the remaining bytes for extra assurance.  Returns\n39\t * an integer less than, equal to, or greater than zero if sig is found,\n40\t * respectively, to be less than, to match, or be greater than the correct\n41\t * PNG signature (this is the same behavior as strcmp, memcmp, etc).\n42\t */\n43\t/* png_sig_cmp */\n44\t#[unsafe(no_mangle)]\n45\tpub unsafe extern \"C\" fn png_sig_cmp(\n46\t    sig: png_const_bytep,\n47\t    start: usize,\n48\t    mut num_to_check: usize,\n49\t) -> c_int {\n50\t    if num_to_check > 8 {\n51\t        num_to_check = 8;\n52\t    } else if num_to_check < 1 {\n53\t        return -1;\n54\t    }\n55\t\n56\t    if start > 7 {\n57\t        return -1;\n58\t    }\n59\t\n60\t    if start + num_to_check > 8 {\n61\t        num_to_check = 8 - start;\n62\t    }\n63\t\n64\t    memcmp(\n65\t        sig.add(start) as *const c_void,\n66\t        png_signature.as_ptr().add(start) as *const c_void,\n67\t        num_to_check,\n68\t    )\n69\t}\n70\t\n71\t/* Function to allocate memory for zlib */\n72\t/* png_zalloc */\n73\t#[unsafe(no_mangle)]\n74\tpub unsafe extern \"C\" fn png_zalloc(png_ptr: voidpf, items: uInt, size: uInt) -> voidpf {\n75\t    let mut num_bytes: png_alloc_size_t = size as png_alloc_size_t;\n76\t\n77\t    if png_ptr == core::ptr::null_mut() {\n78\t        return core::ptr::null_mut();\n79\t    }\n80\t\n81\t    /* This check against overflow is vestigial, dating back from\n82\t     * the old times when png_zalloc used to be an exported function.\n83\t     * We're still keeping it here for now, as an extra-cautious\n84\t     * prevention against programming errors inside zlib, although it\n85\t     * should rather be a debug-time assertion instead.\n86\t     */\n87\t    if size != 0\n88\t        && (items as png_alloc_size_t)\n89\t            >= ((!(0 as png_alloc_size_t)) / (size as png_alloc_size_t))\n90\t    {\n91\t        png_warning(\n92\t            png_ptr as png_structrp,\n93\t            b\"Potential overflow in png_zalloc()\\0\".as_ptr() as png_const_charp,\n94\t        );\n95\t        return core::ptr::null_mut();\n96\t    }\n97\t\n98\t    num_bytes = num_bytes.wrapping_mul(items as png_alloc_size_t);\n99\t    png_malloc_warn(png_ptr as png_structrp, num_bytes)\n100\t}\n101\t\n102\t/* Function to free memory for zlib */\n103\t/* png_zfree */\n104\t#[unsafe(no_mangle)]\n105\tpub unsafe extern \"C\" fn png_zfree(png_ptr: voidpf, ptr: voidpf) {\n106\t    png_free(png_ptr as png_const_structrp, ptr);\n107\t}\n108\t\n109\t/* Reset the CRC variable to 32 bits of 1's.  Care must be taken\n110\t * in case CRC is > 32 bits to leave the top bits 0.\n111\t */\n112\t/* png_reset_crc */\n113\t#[unsafe(no_mangle)]\n114\tpub unsafe extern \"C\" fn png_reset_crc(png_ptr: png_structrp) {\n115\t    /* The cast is safe because the crc is a 32-bit value. */\n116\t    (*png_ptr).crc = crc32(0, core::ptr::null(), 0) as png_uint_32;\n117\t}\n118\t\n119\t/* Calculate the CRC over a section of data.  We can only pass as\n120\t * much data to this routine as the largest single buffer size.  We\n121\t * also check that this data will actually be used before going to the\n122\t * trouble of calculating it.\n123\t */\n124\t/* png_calculate_crc */\n125\t#[unsafe(no_mangle)]\n126\tpub unsafe extern \"C\" fn png_calculate_crc(\n127\t    png_ptr: png_structrp,\n128\t    mut ptr: png_const_bytep,\n129\t    mut length: usize,\n130\t) {\n131\t    let mut need_crc: c_int = 1;\n132\t\n133\t    if PNG_CHUNK_ANCILLARY((*png_ptr).chunk_name) != 0 {\n134\t        if ((*png_ptr).flags & PNG_FLAG_CRC_ANCILLARY_MASK)\n135\t            == (PNG_FLAG_CRC_ANCILLARY_USE | PNG_FLAG_CRC_ANCILLARY_NOWARN)\n136\t        {\n137\t            need_crc = 0;\n138\t        }\n139\t    }\n140\t    /* critical */\n141\t    else {\n142\t        if ((*png_ptr).flags & PNG_FLAG_CRC_CRITICAL_IGNORE) != 0 {\n143\t            need_crc = 0;\n144\t        }\n145\t    }\n146\t\n147\t    /* 'uLong' is defined in zlib.h as unsigned long; this means that on some\n148\t     * systems it is a 64-bit value.  crc32, however, returns 32 bits so the\n149\t     * following cast is safe.  'uInt' may be no more than 16 bits, so it is\n150\t     * necessary to perform a loop here.\n151\t     */\n152\t    if need_crc != 0 && length > 0 {\n153\t        let mut crc: uLong = (*png_ptr).crc as uLong; /* Should never issue a warning */\n154\t\n155\t        loop {\n156\t            let mut safe_length: uInt = length as uInt;\n157\t            if safe_length == 0 {\n158