prefix: *const c_char, msg: *const c_char) {\n    fputs(prefix, stderr);\n    fputs(msg, stderr);\n    fputs(b\"\\n\\0\".as_ptr() as *const c_char, stderr);\n}\n\n/* ------------------------------------------------------------------ */\n/* <stdlib.h> / <string.h>                                             */\n/* ------------------------------------------------------------------ */\n\nextern \"C\" {\n    pub fn malloc(size: usize) -> *mut c_void;\n    pub fn free(p: *mut c_void);\n    pub fn abort() -> !;\n    pub fn strlen(s: *const c_char) -> usize;\n}\n\n/* ------------------------------------------------------------------ */\n/* <setjmp.h>                                                          */\n/* ------------------------------------------------------------------ */\n\n/// `jmp_buf` on x86-64 glibc: 200 bytes, 8 byte alignment.\npub type jmp_buf = [u64; 25];\n\nextern \"C\" {\n    #[link_name = \"setjmp\"]\n    pub fn setjmp(env: *mut jmp_buf) -> c_int;\n    #[link_name = \"longjmp\"]\n    pub fn longjmp(env: *mut jmp_buf, val: c_int) -> !;\n}\n\n/* ------------------------------------------------------------------ */\n/* <time.h>                                                            */\n/* ------------------------------------------------------------------ */\n\npub type time_t = i64;\n\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct tm {\n    pub tm_sec: c_int,\n    pub tm_min: c_int,\n    pub tm_hour: c_int,\n    pub tm_mday: c_int,\n    pub tm_mon: c_int,\n    pub tm_year: c_int,\n    pub tm_wday: c_int,\n    pub tm_yday: c_int,\n    pub tm_isdst: c_int,\n    pub tm_gmtoff: c_long,\n    pub tm_zone: *const c_char,\n}\n\nextern \"C\" {\n    pub fn gmtime(t: *const time_t) -> *mut tm;\n}\n\n/* ------------------------------------------------------------------ */\n/* <math.h>                                                            */\n/* ------------------------------------------------------------------ */\n\nextern \"C\" {\n    pub fn pow(x: f64, y