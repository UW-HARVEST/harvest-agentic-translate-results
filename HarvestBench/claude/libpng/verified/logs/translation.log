345UL; return (unsigned)((rs>>16)&0x7fff); }\n\n/* ------------- high level png_write_png / png_read_png ------------- */\nstatic void hl_test(int ct,int bd,int il,int wxf,int rxf)\n{\n   membuf m; png_structp p; png_infop ip; png_bytep *rows; int y,h=6,w=10;\n   int channels=(ct==PNG_COLOR_TYPE_RGB)?3:(ct==PNG_COLOR_TYPE_RGB_ALPHA)?4:(ct==PNG_COLOR_TYPE_GRAY_ALPHA)?2:1;\n   size_t rb=((size_t)w*channels*bd+7)/8;\n   mb_init(&m);\n   p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n   ip=png_create_info_struct(p);\n   if(setjmp(png_jmpbuf(p))){printf(\"HL w LONGJMP ct%d bd%d\\n\",ct,bd);return;}\n   png_set_write_fn(p,&m,wfn,ffn);\n   png_set_IHDR(p,ip,w,h,bd,ct,il,0,0);\n   if(ct&PNG_COLOR_MASK_PALETTE){png_color pal[256];int n=1<<bd,i;\n     for(i=0;i<n;i++){pal[i].red=(png_byte)(i*3);pal[i].green=(png_byte)(i*5);pal[i].blue=(png_byte)(i*7);}\n     png_set_PLTE(p,ip,pal,n);}\n   rows=malloc(sizeof(png_bytep)*h); rs=31337;\n   for(y=0;y<h;y++){size_t i;rows[y]=malloc(rb?rb:1);for(i=0;i<rb;i++)rows[y][i]=(unsigned char)(rnd()&0xff);}\n   png_set_rows(p,ip,rows);\n   png_write_png(p,ip,wxf,NULL);\n   printf(\"HL ct%d bd%d il%d wxf%04x len=%lu crc=%08lx\\n\",ct,bd,il,wxf,(unsigned long)m.len,crcbuf(m.buf,m.len));\n   for(y=0;y<h;y++)free(rows[y]);\n   free(rows);\n   png_destroy_write_struct(&p,&ip);\n   {\n     memrd r; png_structp rp; png_infop rip; png_bytepp irows; png_uint_32 rh,yy;\n     unsigned long acc=0;\n     r.buf=m.buf;r.len=m.len;r.pos=0;\n     rp=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n     rip=png_create_info_struct(rp);\n     if(setjmp(png_jmpbuf(rp))){printf(\"HL r LONGJMP\\n\");}\n     else{\n       png_set_read_fn(rp,&r,rfn);\n       png_read_png(rp,rip,rxf,NULL);\n       irows=png_get_rows(rp,rip); rh=png_get_image_height(rp,rip);\n       for(yy=0;yy<rh;yy++) acc=crcbuf(irows[yy],png_get_rowbytes(rp,rip))^(acc*11);\n       printf(\"HL read rxf%04x rowbytes=%lu ct=%d bd=%d acc=%08lx\\n\",rxf,\n         (unsigned long)png_get_rowbytes(rp,rip),png_get_color_type(rp,rip),png_get_bit_depth(rp,rip),acc);\n     }\n     png_destroy_read_struct(&rp,&rip,NULL);\n   }\n   free(m.buf);\n}\n\n/* ------------- sCAL / pCAL round trip with many values ------------- */\nstatic void scal_test(void)\n{\n   double vals[]={0.0,1.0,1.5,0.1,1e-5,1e5,123456.789,1e-10,1e10,3.14159265358979,\n                  0.000123456,99999.99999,1e-300,1e300,0.5,2.0/3.0,1.0/7.0,1e-4,9.999999e6};\n   int i;\n   for(i=0;i<19;i++){\n     membuf m; png_structp p; png_infop ip; png_bytep row;\n     mb_init(&m);\n     p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n     ip=png_create_info_struct(p);\n     if(setjmp(png_jmpbuf(p))){printf(\"sCAL[%d] LONGJMP\\n\",i);free(m.buf);continue;}\n     png_set_write_fn(p,&m,wfn,ffn);\n     png_set_IHDR(p,ip,2,2,8,PNG_COLOR_TYPE_GRAY,0,0,0);\n     png_set_sCAL(p,ip,PNG_SCALE_METER,vals[i]>0?vals[i]:1.0,vals[i]>0?vals[i]*2:2.0);\n     png_set_pCAL(p,ip,\"purpose\",-100,100,PNG_EQUATION_LINEAR,2,\"units\",\n                  (png_charpp)(char*[]){\"1.5\",\"-2.5e3\"});\n     png_write_info(p,ip);\n     row=calloc(1,2);\n     png_write_row(p,row); png_write_row(p,row);\n     png_write_end(p,ip);\n     printf(\"sCAL[%d] %.17g len=%lu crc=%08lx\\n\",i,vals[i],(unsigned long)m.len,crcbuf(m.buf,m.len));\n     free(row);\n     png_destroy_write_struct(&p,&ip);\n     {\n       memrd r; png_structp rp; png_infop rip; int unit; png_charp sw,sh; double dw,dh;\n       png_fixed_point fw,fh;\n       r.buf=m.buf;r.len=m.len;r.pos=0;\n       rp=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n       rip=png_create_info_struct(rp);\n       if(setjmp(png_jmpbuf(rp))){printf(\"sCAL[%d] r LONGJMP\\n\",i);}\n       else{\n         png_set_read_fn(rp,&r,rfn);\n         png_read_info(rp,rip);\n         if(png_get_sCAL_s(rp,rip,&unit,&sw,&sh)) printf(\"  sCAL_s unit=%d w=%s h=%s\\n\",unit,sw,sh);\n         if(png_get_sCAL(rp,rip,&unit,&dw,&dh)) printf(\"  sCAL   unit=%d w=%.17g h=%.17g\\n\",unit,dw,dh);\n         if(png_get_sCAL_fixed(rp,rip,&unit,&fw,&fh)) printf(\"  sCALf  unit=%d w=%d h=%d\\n\",unit,fw,fh);\n         { png_charp pu,un; png_int_32 X0,X1; int ty,np; png_charpp pr;\n           if(png_get_pCAL(rp,rip,&pu,&X0,&X1,&ty,&np,&un,&pr)){\n             int k; printf(\"  pCAL %s %d %d %d %d %s\",pu,X0,X1,ty,np,un);\n             for(k=0;k<np;k++)printf(\" [%s]\",pr[k]); printf(\"\\n\"); } }\n       }\n       png_destroy_read_struct(&rp,&rip,NULL);\n     }\n     free(m.buf);\n   }\n   /* fixed point sCAL */\n   { int i; png_fixed_point fv[]={1,100000,1,-1,2147483647,12345,99999};\n     for(i=0;i<7;i++){\n       membuf m; png_structp p; png_infop ip;\n       mb_init(&m);\n       p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n       ip=png_create_info_struct(p);\n       if(setjmp(png_jmpbuf(p))){printf(\"sCALfix[%d] LONGJMP\\n\",i);free(m.buf);continue;}\n       png_set_write_fn(p,&m,wfn,ffn);\n       png_set_IHDR(p,ip,1,1,8,PNG_COLOR_TYPE_GRAY,0,0,0);\n       png_set_sCAL_fixed(p,ip,PNG_SCALE_RADIAN,fv[i],fv[i]);\n       png_write_info(p,ip);\n       { png_byte r0[1]={0}; png_write_row(p,r0); }\n       png_write_end(p,ip);\n       printf(\"sCALfix[%d] %d len=%lu crc=%08lx\\n\",i,fv[i],(unsigned long)m.len,crcbuf(m.buf,m.len));\n       png_destroy_write_struct(&p,&ip); free(m.buf);\n     } }\n}\n\n/* ------------- misc utilities ------------- */\nstatic void util_test(void)\n{\n   unsigned char buf[8]; int i;\n   static const unsigned char sig[8]={137,80,78,71,13,10,26,10};\n   for(i=0;i<=9;i++) printf(\"sig_cmp %d = %d\\n\", i, png_sig_cmp(sig,0,i));\n   for(i=0;i<=8;i++) printf(\"sig_cmp start %d = %d\\n\", i, png_sig_cmp(sig,i,1));\n   { unsigned long v[]={0,1,0x7fffffff,0x80000000,0xffffffff,0x12345678};\n     for(i=0;i<6;i++){\n       png_save_uint_32(buf,(png_uint_32)v[i]);\n       printf(\"u32 %08lx -> %02x%02x%02x%02x -> get=%08lx int=%d\\n\",v[i],buf[0],buf[1],buf[2],buf[3],\n         (unsigned long)png_get_uint_32(buf), png_get_int_32(buf));\n       png_save_int_32(buf,(png_int_32)v[i]);\n       printf(\"i32 %08lx -> %02x%02x%02x%02x get_int=%d\\n\",v[i],buf[0],buf[1],buf[2],buf[3],png_get_int_32(buf));\n     } }\n   { unsigned v[]={0,1,255,256,32767,32768,65535};\n     for(i=0;i<7;i++){png_save_uint_16(buf,v[i]);printf(\"u16 %u -> %02x%02x -> %u\\n\",v[i],buf[0],buf[1],png_get_uint_16(buf));} }\n   { png_color pal[256]; int bd[]={1,2,4,8}; int k;\n     for(k=0;k<4;k++){ int n=1<<bd[k]; png_build_grayscale_palette(bd[k],pal);\n       printf(\"graypal bd%d:\",bd[k]); for(i=0;i<n;i++) printf(\" %d\",pal[i].red); printf(\"\\n\"); } }\n   { png_time t; struct tm tmv; char out[29]; int k;\n     time_t times[]={0,1,1000000000,2000000000,1234567890};\n     for(k=0;k<5;k++){\n       png_convert_from_time_t(&t,times[k]);\n       printf(\"time %ld -> %u-%u-%u %u:%u:%u\\n\",(long)times[k],t.year,t.month,t.day,t.hour,t.minute,t.second);\n       if(png_convert_to_rfc1123_buffer(out,&t)) printf(\"  rfc1123=[%s]\\n\",out); else printf(\"  rfc1123 fail\\n\");\n     }\n     memset(&tmv,0,sizeof tmv);\n     tmv.tm_year=124;tmv.tm_mon=2;tmv.tm_mday=14;tmv.tm_hour=15;tmv.tm_min=9;tmv.tm_sec=26;\n     png_convert_from_struct_tm(&t,&tmv);\n     printf(\"tm -> %u-%u-%u %u:%u:%u\\n\",t.year,t.month,t.day,t.hour,t.minute,t.second);\n     /* invalid times */\n     { png_time bad[]={{10000,1,1,0,0,0},{2000,0,1,0,0,0},{2000,13,1,0,0,0},\n                       {2000,1,0,0,0,0},{2000,1,32,0,0,0},{2000,1,1,24,0,0},\n                       {2000,1,1,0,60,0},{2000,1,1,0,0,61}};\n       for(k=0;k<8;k++) printf(\"badtime %d -> %d\\n\",k,png_convert_to_rfc1123_buffer(out,&bad[k])); }\n   }\n   { png_structp p=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n     int o;\n     for(o=0;o<18;o+=2)\n       printf(\"option %d: on=%d off=%d get=%d\\n\",o,png_set_option(p,o,PNG_OPTION_ON),\n              png_set_option(p,o,PNG_OPTION_OFF),png_set_option(p,o,2));\n     printf(\"mng=%lu\\n\",(unsigned long)png_permit_mng_features(p,PNG_ALL_MNG_FEATURES));\n     png_set_user_limits(p,100,200);\n     printf(\"limits %lu %lu\\n\",(unsigned long)png_get_user_width_max(p),(unsigned long)png_get_user_height_max(p));\n     png_set_chunk_cache_max(p,7); png_set_chunk_malloc_max(p,777);\n     printf(\"cache=%lu malloc=%lu\\n\",(unsigned long)png_get_chunk_cache_max(p),(unsigned long)png_get_chunk_malloc_max(p));\n     printf(\"compression_buffer=%lu\\n\",(unsigned long)png_get_compression_buffer_size(p));\n     png_set_compression_buffer_size(p,4096);\n     printf(\"compression_buffer=%lu\\n\",(unsigned long)png_get_compression_buffer_size(p));\n     printf(\"io_state=%lu chunk_type=%lu\\n\",(unsigned long)png_get_io_state(p),(unsigned long)png_get_io_chunk_type(p));\n     { unsigned char cn[5]=\"prVt\"; printf(\"handle_as_unknown=%d\\n\",png_handle_as_unknown(p,cn)); }\n     png_destroy_read_struct(&p,NULL,NULL);\n   }\n   { /* memory functions */\n     png_structp p=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n     void *a=png_malloc(p,100), *b=png_calloc(p,100), *c=png_malloc_warn(p,100);\n     unsigned char *bb=b; int k; unsigned long s=0;\n     for(k=0;k<100;k++) s+=bb[k];\n     printf(\"calloc sum=%lu ptrs=%d\\n\",s,(a!=NULL)+(b!=NULL)+(c!=NULL));\n     png_free(p,a);png_free(p,b);png_free(p,c);\n     png_destroy_read_struct(&p,NULL,NULL);\n   }\n}\n\n/* ------------- CRC actions on corrupt chunks ------------- */\nstatic void crc_test(void)\n{\n   membuf m; png_structp p; png_infop ip; png_bytep row; int crit,anc,i;\n   mb_init(&m);\n   p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n   ip=png_create_info_struct(p);\n   if(setjmp(png_jmpbuf(p))){printf(\"crc w LONGJMP\\n\");return;}\n   png_set_write_fn(p,&m,wfn,ffn);\n   png_set_IHDR(p,ip,8,4,8,PNG_COLOR_TYPE_RGB,0,0,0);\n   png_set_gAMA(p,ip,1.0);\n   png_write_info(p,ip);\n   row=calloc(1,24);\n   for(i=0;i<4;i++){int k;for(k=0;k<24;k++)row[k]=(unsigned char)(i*24+k);png_write_row(p,row);}\n   png_write_end(p,ip);\n   png_destroy_write_struct(&p,&ip);\n   free(row);\n   /* corrupt every CRC we can find: just flip the last byte of each chunk */\n   for(crit=0;crit<6;crit++) for(anc=0;anc<6;anc++){\n     size_t pos=8; membuf c; c.buf=malloc(m.len); c.len=m.len; memcpy(c.buf,m.buf,m.len);\n     while(pos+8<=c.len){\n       png_uint_32 ln=png_get_uint_32(c.buf+pos);\n       if(pos+12+ln>c.len) break;\n       c.buf[pos+8+ln+3]^=0xff;\n       pos+=12+ln;\n     }\n     { memrd r; png_structp rp; png_infop rip; png_uint_32 y; unsigned long acc=0;\n       r.buf=c.buf;r.len=c.len;r.pos=0;\n       rp=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n       rip=png_create_info_struct(rp);\n       printf(\"-- crc crit%d anc%d\\n\",crit,anc);\n       if(setjmp(png_jmpbuf(rp))){printf(\"crc r LONGJMP\\n\");}\n       else{\n         png_set_read_fn(rp,&r,rfn);\n         png_set_crc_action(rp,crit,anc);\n         png_read_info(rp,rip);\n         { png_bytep rw=malloc(png_get_rowbytes(rp,rip)+8);\n           for(y=0;y<png_get_image_height(rp,rip);y++){png_read_row(rp,rw,NULL);acc=crcbuf(rw,png_get_rowbytes(rp,rip))^(acc*3);}\n           free(rw); }\n         png_read_end(rp,rip);\n         printf(\"crc acc=%08lx\\n\",acc);\n       }\n       png_destroy_read_struct(&rp,&rip,NULL);\n     }\n     free(c.buf);\n   }\n   free(m.buf);\n}\n\n/* ------------- stdio + flush ------------- */\nstatic void stdio_test(void)\n{\n   const char *fn=\"/tmp/.hpng_test.png\";\n   FILE *f; png_structp p; png_infop ip; png_bytep row; int i;\n   f=fopen(fn,\"wb\");\n   p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n   ip=png_create_info_struct(p);\n   if(setjmp(png_jmpbuf(p))){printf(\"stdio LONGJMP\\n\");return;}\n   png_init_io(p,f);\n   png_set_flush(p,2);\n   png_set_IHDR(p,ip,6,6,8,PNG_COLOR_TYPE_RGB_ALPHA,0,0,0);\n   png_write_info(p,ip);\n   row=calloc(1,24);\n   for(i=0;i<6;i++){int k;for(k=0;k<24;k++)row[k]=(unsigned char)(i*7+k);png_write_row(p,row);}\n   png_write_flush(p);\n   png_write_end(p,ip);\n   png_destroy_write_struct(&p,&ip);\n   free(row); fclose(f);\n   { FILE *g=fopen(fn,\"rb\"); unsigned char *b; long n;\n     fseek(g,0,SEEK_END); n=ftell(g); fseek(g,0,SEEK_SET);\n     b=malloc(n); fread(b,1,n,g); fclose(g);\n     printf(\"stdio wrote %ld crc=%08lx\\n\",n,crcbuf(b,n)); free(b); }\n   { png_structp rp; png_infop rip; FILE *g=fopen(fn,\"rb\"); png_uint_32 y; unsigned long acc=0;\n     rp=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n     rip=png_create_info_struct(rp);\n     if(setjmp(png_jmpbuf(rp))){printf(\"stdio r LONGJMP\\n\");}\n     else{\n       png_init_io(rp,g); png_read_info(rp,rip);\n       { png_bytep rw=malloc(png_get_rowbytes(rp,rip));\n         for(y=0;y<png_get_image_height(rp,rip);y++){png_read_row(rp,rw,NULL);acc=crcbuf(rw,png_get_rowbytes(rp,rip))^(acc*3);}\n         free(rw); }\n       png_read_end(rp,rip);\n       printf(\"stdio read acc=%08lx\\n\",acc);\n     }\n     png_destroy_read_struct(&rp,&rip,NULL); fclose(g);\n   }\n   /* simplified stdio */\n   { png_image wi; unsigned char pix[6*6*4]; int k;\n     memset(&wi,0,sizeof wi); wi.version=PNG_IMAGE_VERSION;\n     wi.width=6;wi.height=6;wi.format=PNG_FORMAT_RGBA;\n     for(k=0;k<(int)sizeof pix;k++)pix[k]=(unsigned char)(k*3);\n     printf(\"simpwrite file=%d\\n\",png_image_write_to_file(&wi,fn,0,pix,0,NULL));\n     { png_image ri; unsigned char *ob; size_t on;\n       memset(&ri,0,sizeof ri); ri.version=PNG_IMAGE_VERSION;\n       if(png_image_begin_read_from_file(&ri,fn)){\n         ri.format=PNG_FORMAT_RGBA; on=PNG_IMAGE_SIZE(ri); ob=calloc(1,on);\n         printf(\"simpread file=%d crc=%08lx\\n\",png_image_finish_read(&ri,NULL,ob,0,NULL),crcbuf(ob,on));\n         free(ob);\n       } else printf(\"simpread begin fail %s\\n\",ri.message);\n     }\n     printf(\"simpread missing=%d\\n\", (memset(&wi,0,sizeof wi), wi.version=PNG_IMAGE_VERSION,\n            png_image_begin_read_from_file(&wi,\"/tmp/.hpng_does_not_exist.png\")));\n     printf(\"  msg=%s\\n\", wi.message);\n   }\n   remove(fn);\n   printf(\"flushes=%d\\n\",flushes);\n}\n\n/* ------------- MNG features / intrapixel ------------- */\nstatic void mng_test(void)\n{\n   int fl;\n   for(fl=0;fl<2;fl++){\n     membuf m; png_structp p; png_infop ip; png_bytep row; int i;\n     mb_init(&m);\n     p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n     ip=png_create_info_struct(p);\n     if(setjmp(png_jmpbuf(p))){printf(\"mng LONGJMP\\n\");free(m.buf);continue;}\n     png_set_write_fn(p,&m,wfn,ffn);\n     png_permit_mng_features(p,PNG_ALL_MNG_FEATURES);\n     png_set_IHDR(p,ip,8,4,8,PNG_COLOR_TYPE_RGB,0,0,\n        fl?PNG_INTRAPIXEL_DIFFERENCING:PNG_FILTER_TYPE_BASE);\n     png_write_info(p,ip);\n     row=calloc(1,24);\n     for(i=0;i<4;i++){int k;for(k=0;k<24;k++)row[k]=(unsigned char)(i*13+k*5);png_write_row(p,row);}\n     png_write_end(p,ip);\n     printf(\"mng fl%d len=%lu crc=%08lx\\n\",fl,(unsigned long)m.len,crcbuf(m.buf,m.len));\n     free(row); png_destroy_write_struct(&p,&ip);\n     { memrd r; png_structp rp; png_infop rip; png_uint_32 y; unsigned long acc=0;\n       r.buf=m.buf;r.len=m.len;r.pos=0;\n       rp=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n       rip=png_create_info_struct(rp);\n       if(setjmp(png_jmpbuf(rp))){printf(\"mng r LONGJMP\\n\");}\n       else{ png_set_read_fn(rp,&r,rfn); png_permit_mng_features(rp,PNG_ALL_MNG_FEATURES);\n         png_read_info(rp,rip);\n         { png_bytep rw=malloc(png_get_rowbytes(rp,rip));\n           for(y=0;y<4;y++){png_read_row(rp,rw,NULL);acc=crcbuf(rw,png_get_rowbytes(rp,rip))^(acc*3);}\n           free(rw);}\n         png_read_end(rp,rip); printf(\"mng read acc=%08lx\\n\",acc); }\n       png_destroy_read_struct(&rp,&rip,NULL); }\n     free(m.buf);\n   }\n}\n\n/* ------------- process_data_pause / skip ------------- */\nstatic png_uint_32 pr_rows;\nstatic void PNGCBAPI i2(png_structp p, png_infop ip){(void)ip;png_start_read_image(p);}\nstatic void PNGCBAPI r2(png_structp p, png_bytep row, png_uint_32 rn, int pass){(void)p;(void)row;(void)rn;(void)pass;pr_rows++;}\nstatic void PNGCBAPI e2(png_structp p, png_infop ip){(void)p;(void)ip;}\nstatic void pause_test(void)\n{\n   membuf m; png_structp p; png_infop ip; png_bytep row; int i;\n   mb_init(&m);\n   p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n   ip=png_create_info_struct(p);\n   if(setjmp(png_jmpbuf(p))){printf(\"pause w LONGJMP\\n\");return;}\n   png_set_write_fn(p,&m,wfn,ffn);\n   png_set_IHDR(p,ip,20,10,8,PNG_COLOR_TYPE_RGB,PNG_INTERLACE_ADAM7,0,0);\n   png_set_text(p,ip,(png_textp)&(png_text){PNG_TEXT_COMPRESSION_NONE,(png_charp)\"K\",(png_charp)\"V\",0,0,NULL,NULL},1);\n   png_write_info(p,ip);\n   row=calloc(1,60);\n   for(i=0;i<10;i++){int k;for(k=0;k<60;k++)row[k]=(unsigned char)(i*11+k*3);png_write_row(p,row);}\n   png_write_end(p,ip);\n   png_destroy_write_struct(&p,&ip); free(row);\n   { int sv; for(sv=0;sv<2;sv++){\n       png_structp rp=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n       png_infop rip=png_create_info_struct(rp);\n       size_t pos=0; int guard=0;\n       pr_rows=0;\n       if(setjmp(png_jmpbuf(rp))){printf(\"pause r LONGJMP\\n\");}\n       else{\n         png_set_progressive_read_fn(rp,NULL,i2,r2,e2);\n         while(pos<m.len && guard++<10000){\n           size_t n = m.len-pos<11?m.len-pos:11;\n           png_process_data(rp,rip,m.buf+pos,n);\n           pos+=n;\n           { size_t remain=png_process_data_pause(rp,sv);\n             pos-=remain;\n             if(remain) printf(\"  paused remain=%lu skip=%lu\\n\",(unsigned long)remain,\n                (unsigned long)png_process_data_skip(rp));\n           }\n         }\n         printf(\"pause sv%d rows=%u guard=%d\\n\",sv,(unsigned)pr_rows,guard);\n       }\n       png_destroy_read_struct(&rp,&rip,NULL);\n     } }\n   free(m.buf);