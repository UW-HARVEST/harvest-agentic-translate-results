{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HtykddjgwEG4pGp5hzwHey","type":"tool_result","content":"1\t/* pngwutil.c lines 1..308 */\n2\t\n3\t/* Place a 32-bit number into a buffer in PNG byte order.  We work\n4\t * with unsigned numbers for convenience, although one supported\n5\t * ancillary chunk uses signed (two's complement) numbers.\n6\t */\n7\t/* png_save_uint_32 */\n8\t#[unsafe(no_mangle)]\n9\tpub unsafe extern \"C\" fn png_save_uint_32(buf: png_bytep, i: png_uint_32) {\n10\t    *buf.add(0) = ((i >> 24) & 0xffu32) as png_byte;\n11\t    *buf.add(1) = ((i >> 16) & 0xffu32) as png_byte;\n12\t    *buf.add(2) = ((i >> 8) & 0xffu32) as png_byte;\n13\t    *buf.add(3) = (i & 0xffu32) as png_byte;\n14\t}\n15\t\n16\t/* Place a 16-bit number into a buffer in PNG byte order.\n17\t * The parameter is declared unsigned int, not png_uint_16,\n18\t * just to avoid potential problems on pre-ANSI C compilers.\n19\t */\n20\t/* png_save_uint_16 */\n21\t#[unsafe(no_mangle)]\n22\tpub unsafe extern \"C\" fn png_save_uint_16(buf: png_bytep, i: c_uint) {\n23\t    *buf.add(0) = ((i >> 8) & 0xffu32) as png_byte;\n24\t    *buf.add(1) = (i & 0xffu32) as png_byte;\n25\t}\n26\t\n27\t/* Simple function to write the signature.  If we have already written\n28\t * the magic bytes of the signature, or more likely, the PNG stream is\n29\t * being embedded into another stream and doesn't need its own signature,\n30\t * we should call png_set_sig_bytes() to tell libpng how many of the\n31\t * bytes have already been written.\n32\t */\n33\t/* png_write_sig */\n34\t#[unsafe(no_mangle)]\n35\tpub unsafe extern \"C\" fn png_write_sig(png_ptr: png_structrp) {\n36\t    let mut png_signature: [png_byte; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n37\t\n38\t    /* Inform the I/O callback that the signature is being written */\n39\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_SIGNATURE;\n40\t\n41\t    /* Write the rest of the 8 byte signature */\n42\t    png_write_data(\n43\t        png_ptr,\n44\t        png_signature.as_mut_ptr().add((*png_ptr).sig_bytes as usize),\n45\t        (8 - (*png_ptr).sig_bytes as c_int) as usize,\n46\t    );\n47\t\n48\t    if ((*png_ptr).sig_bytes as c_int) < 3 {\n49\t        (*png_ptr).mode |= PNG_HAVE_PNG_SIGNATURE;\n50\t    }\n51\t}\n52\t\n53\t/* Write the start of a PNG chunk.  The type is the chunk type.\n54\t * The total_length is the sum of the lengths of all the data you will be\n55\t * passing in png_write_chunk_data().\n56\t */\n57\t/* png_write_chunk_header (static) */\n58\tunsafe fn png_write_chunk_header(\n59\t    png_ptr: png_structrp,\n60\t    chunk_name: png_uint_32,\n61\t    length: png_uint_32,\n62\t) {\n63\t    let mut buf: [png_byte; 8] = [0; 8];\n64\t\n65\t    if png_ptr == core::ptr::null_mut() {\n66\t        return;\n67\t    }\n68\t\n69\t    /* Inform the I/O callback that the chunk header is being written.\n70\t     * PNG_IO_CHUNK_HDR requires a single I/O call.\n71\t     */\n72\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_CHUNK_HDR;\n73\t\n74\t    /* Write the length and the chunk name */\n75\t    png_save_uint_32(buf.as_mut_ptr(), length);\n76\t    png_save_uint_32(buf.as_mut_ptr().add(4), chunk_name);\n77\t    png_write_data(png_ptr, buf.as_ptr(), 8);\n78\t\n79\t    /* Put the chunk name into png_ptr->chunk_name */\n80\t    (*png_ptr).chunk_name = chunk_name;\n81\t\n82\t    /* Reset the crc and run it over the chunk name */\n83\t    png_reset_crc(png_ptr);\n84\t\n85\t    png_calculate_crc(png_ptr, buf.as_ptr().add(4), 4);\n86\t\n87\t    /* Inform the I/O callback that chunk data will (possibly) be written.\n88\t     * PNG_IO_CHUNK_DATA does NOT require a specific number of I/O calls.\n89\t     */\n90\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_CHUNK_DATA;\n91\t}\n92\t\n93\t/* png_write_chunk_start */\n94\t#[unsafe(no_mangle)]\n95\tpub unsafe extern \"C\" fn png_write_chunk_start(\n96\t    png_ptr: png_structrp,\n97\t    chunk_string: png_const_bytep,\n98\t    length: png_uint_32,\n99\t) {\n100\t    png_write_chunk_header(png_ptr, PNG_CHUNK_FROM_STRING(chunk_string), length);\n101\t}\n102\t\n103\t/* Write the data of a PNG chunk started with png_write_chunk_header().\n104\t * Note that multiple calls to this function are allowed, and that the\n105\t * sum of the lengths from these calls *must* add up to the total_length\n106\t * given to png_write_chunk_header().\n107\t */\n108\t/* png_write_chunk_data */\n109\t#[unsafe(no_mangle)]\n110\tpub unsafe extern \"C\" fn png_write_chunk_data(\n111\t    png_ptr: png_structrp,\n112\t    data: png_const_bytep,\n113\t    length: usize,\n114\t) {\n115\t    /* Write the data, and run the CRC over it */\n116\t    if png_ptr == core::ptr::null_mut() {\n117\t        return;\n118\t    }\n119\t\n120\t    if data != core::ptr::null() && length > 0 {\n121\t        png_write_data(png_ptr, data, length);\n122\t\n123\t        /* Update the CRC after writing the data,\n124\t         * in case the user I/O routine alters it.\n125\t         */\n126\t        png_calculate_crc(png_ptr, data, length);\n127\t    }\n128\t}\n129\t\n130\t/* Finish a chunk started with png_write_chunk_header(). */\n131\t/* png_write_chunk_end */\n132\t#[unsafe(no_mangle)]\n133\tpub unsafe extern \"C\" fn png_write_chunk_end(png_ptr: png_structrp) {\n134\t    let mut buf: [png_byte; 4] = [0; 4];\n135\t\n136\t    if png_ptr == core::ptr::null_mut() {\n137\t        return;\n138\t    }\n139\t\n140\t    /* Inform the I/O callback that the chunk CRC is being written.\n141\t     * PNG_IO_CHUNK_CRC requires a single I/O function call.\n142\t     */\n143\t    (*png_ptr).io_state = PNG_IO_WRITING | PNG_IO_CHUNK_CRC;\n144\t\n145\t    /* Write the crc in a single operation */\n146\t    png_save_uint_32(buf.as_mut_ptr(), (*png_ptr).crc);\n147\t\n148\t    png_write_data(png_ptr, buf.as_ptr(), 4);\n149\t}\n150\t\n151\t/* Write a PNG chunk all at once.  The type is an array of ASCII characters\n152\t * representing the chunk name.  The array must be at least 4 bytes in\n153\t * length, and does not need to be null terminated.  To be safe, pass the\n154\t * pre-defined chunk names here, and if you need a new one, define it\n155\t * where the others are defined.  The length is the length of the data.\n156\t * All the data must be present.  If that is not possible, use the\n157\t * png_write_chunk_start(), png_write_chunk_data(), and png_write_chunk_end()\n158\t * functions instead.\n159\t */\n160\t/* png_write_complete_chunk (static) */\n161\tunsafe fn png_write_complete_chunk(\n162\t    png_ptr: png_structrp,\n163\t    chunk_name: png_uint_32,\n164\t    data: png_const_bytep,\n165\t    length: usize,\n166\t) {\n167\t    if png_ptr == core::ptr::null_mut() {\n168\t        return;\n169\t    }\n170\t\n171\t    /* On 64-bit architectures 'length' may not fit in a png_uint_32. */\n172\t    if length > PNG_UINT_31_MAX as usize {\n173\t        png_error(\n174\t            png_ptr,\n175\t            b\"length exceeds PNG maximum\\0\".as_ptr() as png_const_charp,\n176\t        );\n177\t    }\n178\t\n179\t    png_write_chunk_header(png_ptr, chunk_name, length as png_uint_32);\n180\t    png_write_chunk_data(png_ptr, data, length);\n181\t    png_write_chunk_end(png_ptr);\n182\t}\n183\t\n184\t/* This is the API that calls the internal function above. */\n185\t/* png_write_chunk */\n186\t#[unsafe(no_mangle)]\n187\tpub unsafe extern \"C\" fn png_write_chunk(\n188\t    png_ptr: png_structrp,\n189\t    chunk_string: png_const_bytep,\n190\t    data: png_const_bytep,\n191\t    length: usize,\n192\t) {\n193\t    png_write_complete_chunk(\n194\t        png_ptr,\n195\t        PNG_CHUNK_FROM_STRING(chunk_string),\n196\t        data,\n197\t        length,\n198\t    );\n199\t}\n200\t\n201\t/* This is used below to find the size of an image to pass to png_deflate_claim,\n202\t * so it only needs to be accurate if the size is less than 16384 bytes (the\n203\t * point at which a lower LZ window size can be used.)\n204\t */\n205\t/* png_image_size (static) */\n206\tunsafe fn png_image_size(png_ptr: png_structrp) -> png_alloc_size_t {\n207\t    /* Only return sizes up to the maximum of a png_uint_32; do this by limiting\n208\t     * the width and height used to 15 bits.\n209\t     */\n210\t    let h: png_uint_32 = (*png_ptr).height;\n211\t\n212\t    if (*png_ptr).rowbytes < 32768 && h < 32768 {\n213\t        if (*png_ptr).interlaced != 0 {\n214\t            /* Interlacing makes the image larger because of the replication of\n215\t             * both the filter byte and the padding to a byte boundary.\n216\t             */\n217\t            let w: png_uint_32 = (*png_ptr).width;\n218\t            let pd: c_uint = (*png_ptr).pixel_depth as c_uint;\n219\t            let mut cb_base: png_alloc_size_t;\n220\t            let mut pass: c_int;\n221\t\n222\t            cb_base = 0;\n223\t            pass = 0;\n224\t            while pass <= 6 {\n225\t                let pw: png_uint_32 = PNG_PASS_COLS(w, pass);\n226\t\n227\t                if pw > 0 {\n228\t                    cb_base = cb_base.wrapping_add(\n229\t                        (PNG_ROWBYTES(pd as usize, pw as usize).wrapping_add(1))\n230\t                            .wrapping_mul(PNG_PASS_ROWS(h, pass) as usize),\n231\t                    );\n232\t                }\n233\t\n234\t                pass += 1;\n235\t            }\n236\t\n237\t            return cb_base;\n238\t        } else {\n239\t            return ((*png_ptr).rowbytes.wrapping_add(1)).wrapping_mul(h as usize);\n240\t        }\n241\t    } else {\n242\t        return 0xffffffffu32 as png_alloc_size_t;\n243\t    }\n244\t}\n245\t\n246\t/* This is the code to hack the first two bytes of the deflate stream (the\n247\t * deflate header) to correct the windowBits value to match the actual data\n248\t * size.  Note that the second argument is the *uncompressed* size but the\n249\t * first argument is the *compressed* data (and it must be deflate\n250\t * compressed.)\n251\t */\n252\t/*