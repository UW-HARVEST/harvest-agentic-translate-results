set_of!(png_compression_buffer, output) + (*pp).zbuffer_size as usize\n762\t}\n763\t\n764\t/* ================================================================== */\n765\t/* png_struct                                                          */\n766\t/* ================================================================== */\n767\t\n768\tpub type png_struct = png_struct_def;\n769\tpub type png_structp = *mut png_struct;\n770\tpub type png_structrp = *mut png_struct;\n771\t/// libpng's `const png_struct *`; represented as a mutable pointer because\n772\t/// `const` has no effect on the C ABI and libpng itself casts the `const`\n773\t/// away in a number of places.\n774\tpub type png_const_structp = *mut png_struct;\n775\tpub type png_const_structrp = *mut png_struct;\n776\tpub type png_structpp = *mut png_structp;\n777\t\n778\tpub type png_info = png_info_def;\n779\tpub type png_infop = *mut png_info;\n780\tpub type png_inforp = *mut png_info;\n781\tpub type png_const_infop = *mut png_info;\n782\tpub type png_const_inforp = *mut png_info;\n783\tpub type png_infopp = *mut png_infop;\n784\t\n785\t#[repr(C)]\n786\tpub struct png_struct_def {\n787\t    pub jmp_buf_local: jmp_buf,\n788\t    pub longjmp_fn: png_longjmp_ptr,\n789\t    pub jmp_buf_ptr: *mut jmp_buf,\n790\t    pub jmp_buf_size: usize,\n791\t\n792\t    pub error_fn: png_error_ptr,\n793\t    pub warning_fn: png_error_ptr,\n794\t    pub error_ptr: png_voidp,\n795\t    pub write_data_fn: png_rw_ptr,\n796\t    pub read_data_fn: png_rw_ptr,\n797\t    pub io_ptr: png_voidp,\n798\t\n799\t    pub read_user_transform_fn: png_user_transform_ptr,\n800\t    pub write_user_transform_fn: png_user_transform_ptr,\n801\t\n802\t    pub user_transform_ptr: png_voidp,\n803\t    pub user_transform_depth: png_byte,\n804\t    pub user_transform_channels: png_byte,\n805\t\n806\t    pub mode: png_uint_32,\n807\t    pub flags: png_uint_32,\n808\t    pub transformations: png_uint_32,\n809\t\n810\t    pub zowner: png_uint_32,\n811\t    pub z