  n\n61\t}\n62\t\n63\t#[inline]\n64\tpub unsafe fn strcmp(a: *const c_char, b: *const c_char) -> c_int {\n65\t    let mut i = 0usize;\n66\t    loop {\n67\t        let x = *a.add(i) as u8;\n68\t        let y = *b.add(i) as u8;\n69\t        if x != y {\n70\t            return if x < y { -1 } else { 1 };\n71\t        }\n72\t        if x == 0 {\n73\t            return 0;\n74\t        }\n75\t        i += 1;\n76\t    }\n77\t}\n78\t\n79\t#[inline]\n80\tpub unsafe fn strncmp(a: *const c_char, b: *const c_char, n: usize) -> c_int {\n81\t    let mut i = 0usize;\n82\t    while i < n {\n83\t        let x = *a.add(i) as u8;\n84\t        let y = *b.add(i) as u8;\n85\t        if x != y {\n86\t            return if x < y { -1 } else { 1 };\n87\t        }\n88\t        if x == 0 {\n89\t            return 0;\n90\t        }\n91\t        i += 1;\n92\t    }\n93\t    0\n94\t}\n95\t\n96\t/// `abs()` for `int`.\n97\t#[inline]\n98\tpub fn abs(v: c_int) -> c_int {\n99\t    v.wrapping_abs()\n100\t}\n101\t\n102\t/* ================================================================== */\n103\t/* png.h read/write integer macros                                     */\n104\t/* ================================================================== */\n105\t\n106\t/// `PNG_get_uint_32` — the read macro used inside the library.\n107\t#[inline]\n108\tpub unsafe fn PNG_get_uint_32(buf: png_const_bytep) -> png_uint_32 {\n109\t    ((*buf as png_uint_32) << 24)\n110\t        .wrapping_add((*buf.add(1) as png_uint_32) << 16)\n111\t        .wrapping_add((*buf.add(2) as png_uint_32) << 8)\n112\t        .wrapping_add(*buf.add(3) as png_uint_32)\n113\t}\n114\t\n115\t/// `PNG_get_uint_16`\n116\t#[inline]\n117\tpub unsafe fn PNG_get_uint_16(buf: png_const_bytep) -> png_uint_16 {\n118\t    (((*buf as c_uint) << 8) + (*buf.add(1) as c_uint)) as png_uint_16\n119\t}\n120\t\n121\t/// `PNG_get_int_32`\n122\t#[inline]\n123\tpub unsafe fn PNG_get_int_32(buf: png_const_bytep) -> png_int_32 {\n124\t    if (*buf & 0x80) != 0 {\n125\t        -(((((PNG_get_uint_32(buf) ^ 0xffffffffu32).wrapping_add(1)) & 0x7fffffff) as png_int_32))\n126\t    } else {\n127\t        PNG_get_uint_32(buf) as png_int_32\n128\t    }\n129\t}\n130\t\n131\t/* ================================================================== */\n132\t/* pngpriv.h utility macros                                            */\n133\t/* ================================================================== */\n134\t\n135\t/// `PNG_ROWBYTES(pixel_bits, width)`\n136\t#[inline]\n137\tpub fn PNG_ROWBYTES(pixel_bits: usize, width: usize) -> usize {\n138\t    if pixel_bits >= 8 {\n139\t        width.wrapping_mul(pixel_bits >> 3)\n140\t    } else {\n141\t        (width.wrapping_mul(pixel_bits).wrapping_add(7)) >> 3\n142\t    }\n143\t}\n144\t\n145\t/// `PNG_TRAILBITS(pixel_bits, width)`\n146\t#[inline]\n147\tpub fn PNG_TRAILBITS(pixel_bits: png_uint_32, width: png_uint_32) -> png_uint_32 {\n148\t    (pixel_bits.wrapping_mul(width % 8)) % 8\n149\t}\n150\t\n151\t/// `PNG_PADBITS(pixel_bits, width)`\n152\t#[inline]\n153\tpub fn PNG_PADBITS(pixel_bits: png_uint_32, width: png_uint_32) -> png_uint_32 {\n154\t    (8 - PNG_TRAILBITS(pixel_bits, width)) % 8\n155\t}\n156\t\n157\t/// `PNG_DIV65535(v24)`\n158\t#[inline]\n159\tpub fn PNG_DIV65535(v24: png_uint_32) -> png_uint_32 {\n160\t    (v24.wrapping_add(32895)) >> 16\n161\t}\n162\t\n163\t/// `PNG_DIV257(v16)`\n164\t#[inline]\n165\tpub fn PNG_DIV257(v16: png_uint_32) -> png_uint_32 {\n166\t    PNG_DIV65535(v16.wrapping_mul(255))\n167\t}\n168\t\n169\t/// `PNG_OUT_OF_RANGE(value, ideal, delta)`\n170\t#[inline]\n171\tpub fn PNG_OUT_OF_RANGE(value: png_fixed_point, ideal: png_fixed_point, delta: png_fixed_point) -> bool {\n172\t    value < ideal - delta || value > ideal + delta\n173\t}\n174\t\n175\t/// `PNG_COLOR_DIST(c1, c2)`\n176\t#[inline]\n177\tpub fn PNG_COLOR_DIST(c1: png_color, c2: png_color) -> c_int {\n178\t    abs(c1.red as c_int - c2.red as c_int)\n179\t        + abs(c1.green as c_int - c2.green as c_int)\n180\t        + abs(c1.blue as c_int - c2.blue as c_int)\n181\t}\n182\t\n183\t/// `png_float(png_ptr, fixed, s)`\n184\t#[inline]\n185\tpub fn png_float(_png_ptr: png_const_structrp, fixed: png_fixed_point, _s: png_const_charp) -> f64 {\n186\t    0.00001 * (fixed as f64)\n187\t}\n188\t\n189\tpub const PNG_GAMMA_THRESHOLD: f64 = (PNG_GAMMA_THRESHOLD_FIXED as f64) * 0.00001;\n190\t\n191\t/* Chunk name helpers ----------------------------------------------- */\n192\t\n193\t#[inline]\n194\tpub fn PNG_32to8(cn: png_uint_32, s: c_int) -> png_uint_32 {\n195\t    (cn >> s) & 0xff\n196\t}\n197\t\n198\t#[inline]\n199\tpub fn PNG_CHUNK_ANCILLARY(c: png_uint_32) -> png_uint_32 {\n200\t    1 & (c >> 29)\n201\t}\n202\t#[inline]\n203\tpub fn PNG_CHUNK_CRITICAL(c: png_uint_32) -> bool {\n204\t    PNG_CHUNK_ANCILLARY(c) == 0\n205\t}\n206\t#[inline]\n207\tpub fn PNG_CHUNK_PRIVATE(c: png_uint_32) -> png_uint_32 {\n208\t    1 & (c >> 21)\n209\t}\n210\t#[inline]\n211\tpub fn PNG_CHUNK_RESERVED(c: png_uint_32) -> png_uint_32 {\n212\t    1 & (c >> 13)\n213\t}\n214\t#[inline]\n215\tpub fn PNG_CHUNK_SAFE_TO_COPY(c: png_uint_32) -> png_uint_32 {\n216\t    1 & (c >> 5)\n217\t}\n218\t\n219\t#[inline]\n220\tpub fn PNG_CN_VALID_UPPER(b: png_uint_32) -> bool {\n221\t    b >= 65 && b <= 90\n222\t}\n223\t#[inline]\n224\tpub fn PNG_CN_VALID_ASCII(b: png_uint_32) -> bool {\n225\t    PNG_CN_VALID_UPPER(b & !32u32)\n226\t}\n227\t#[inline]\n228\tpub fn PNG_CHUNK_NAME_VALID(cn: png_uint_32) -> bool {\n229\t    PNG_CN_VALID_ASCII(PNG_32to8(cn, 24))\n230\t        && PNG_CN_VALID_ASCII(PNG_32to8(cn, 16))\n231\t        && PNG_CN_VALID_UPPER(PNG_32to8(cn, 8))\n232\t        && PNG_CN_VALID_ASCII(PNG_32to8(cn, 0))\n233\t}\n234\t\n235\t/// `PNG_CHUNK_FROM_STRING(s)`\n236\t#[inline]\n237\tpub unsafe fn PNG_CHUNK_FROM_STRING(s: png_const_bytep) -> png_uint_32 {\n238\t    PNG_U32(\n239\t        0xff & *s as png_uint_32,\n240\t        0xff & *s.add(1) as png_uint_32,\n241\t        0xff & *s.add(2) as png_uint_32,\n242\t        0xff & *s.add(3) as png_uint_32,\n243\t    )\n244\t}\n245\t\n246\t/// `PNG_STRING_FROM_CHUNK(s, c)`\n247\t#[inline]\n248\tpub unsafe fn PNG_STRING_FROM_CHUNK(s: png_bytep, c: png_uint_32) {\n249\t    *s = ((c >> 24) & 0xff) as png_byte;\n250\t    *s.add(1) = ((c >> 16) & 0xff) as png_byte;\n251\t    *s.add(2) = ((c >> 8) & 0xff) as png_byte;\n252\t    *s.add(3) = (c & 0xff) as png_byte;\n253\t}\n254\t\n255\t/// `PNG_CSTRING_FROM_CHUNK(s, c)`\n256\t#[inline]\n257\tpub unsafe fn PNG_CSTRING_FROM_CHUNK(s: png_bytep, c: png_uint_32) {\n258\t    PNG_STRING_FROM_CHUNK(s, c);\n259\t    *s.add(4) = 0;\n260\t}\n261\t\n262\t/* png_struct::chunks bookkeeping ----------------------------------- */\n263\t\n264\t#[inline]\n265\tpub fn png_chunk_flag_from_index(i: c_int) -> png_uint_32 {\n266\t    0x80000000u32 >> (31 - i)\n267\t}\n268\t\n269\t#[inline]\n270\tpub unsafe fn png_file_has_chunk(png_ptr: png_const_structrp, i: c_int) -> bool {\n271\t    ((*png_ptr).chunks & png_chunk_flag_from_index(i)) != 0\n272\t}\n273\t\n274\t#[inline]\n275\tpub unsafe fn png_file_add_chunk(png_ptr: png_structrp, i: c_int) {\n276\t    (*png_ptr).chunks |= png_chunk_flag_from_index(i);\n277\t}\n278\t\n279\t/// `png_chunk_max(png_ptr)` — PNG_SET_USER_LIMITS_SUPPORTED is enabled.\n280\t#[inline]\n281\tpub unsafe fn png_chunk_max(png_ptr: png_const_structrp) -> png_alloc_size_t {\n282\t    (*png_ptr).user_chunk_malloc_max\n283\t}\n284\t\n285\t/* Interlace helpers ------------------------------------------------ */\n286\t\n287\t#[inline]\n288\tpub fn PNG_PASS_START_ROW(pass: c_int) -> c_int {\n289\t    ((1 & !pass) << (3 - (pass >> 1))) & 7\n290\t}\n291\t#[inline]\n292\tpub fn PNG_PASS_START_COL(pass: c_int) -> c_int {\n293\t    ((1 & pass) << (3 - ((pass + 1) >> 1))) & 7\n294\t}\n295\t#[inline]\n296\tpub fn PNG_PASS_ROW_OFFSET(pass: c_int) -> c_int {\n297\t    if pass > 2 {\n298\t        8 >> ((pass - 1) >> 1)\n299\t    } else {\n300\t        8\n301\t    }\n302\t}\n303\t#[inline]\n304\tpub fn PNG_PASS_COL_OFFSET(pass: c_int) -> c_int {\n305\t    1 << ((7 - pass) >> 1)\n306\t}\n307\t#[inline]\n308\tpub fn PNG_PASS_ROW_SHIFT(pass: c_int) -> c_int {\n309\t    if pass > 2 {\n310\t        (8 - pass) >> 1\n311\t    } else {\n312\t        3\n313\t    }\n314\t}\n315\t#[inline]\n316\tpub fn PNG_PASS_COL_SHIFT(pass: c_int) -> c_int {\n317\t    if pass > 1 {\n318\t        (7 - pass) >> 1\n319\t    } else {\n320\t        3\n321\t    }\n322\t}\n323\t#[inline]\n324\tpub fn PNG_PASS_ROWS(height: png_uint_32, pass: c_int) -> png_uint_32 {\n325\t    (height.wrapping_add(\n326\t        ((1u32 << PNG_PASS_ROW_SHIFT(pass)) - 1).wrapping_sub(PNG_PASS_START_ROW(pass) as png_uint_32),\n327\t    )) >> PNG_PASS_ROW_SHIFT(pass)\n328\t}\n329\t#[inline]\n330\tpub fn PNG_PASS_COLS(width: png_uint_32, pass: c_int) -> png_uint_32 {\n331\t    (width.wrapping_add(\n332\t        ((1u32 << PNG_PASS_COL_SHIFT(pass)) - 1).wrapping_sub(PNG_PASS_START_COL(pass) as png_uint_32),\n333\t    )) >> PNG_PASS_COL_SHIFT(pass)\n334\t}\n335\t#[inline]\n336\tpub fn PNG_ROW_FROM_PASS_ROW(y_in: png_uint_32, pass: c_int) -> png_uint_32 {\n337\t    (y_in << PNG_PASS_ROW_SHIFT(pass)).wrapping_add(PNG_PASS_START_ROW(pass) as png_uint_32)\n338\t}\n339\t#[inline]\n340\tpub fn PNG_COL_FROM_PASS_COL(x_in: png_uint_32, pass: c_int) -> png_uint_32 {\n341\t    (x_in << PNG_PASS_COL_SHIFT(pass)).wrapping_add(PNG_PASS_START_COL(pass) as png_uint_32)\n342\t}\n343\t#[inline]\n344\tpub fn PNG_PASS_MASK(pass: c_int, off: c_int) -> png_uint_32 {\n345\t    ((0x110145AFu32 >> (((7 - off) - pass) << 2)) & 0xF)\n346\t        | ((0x01145AF0u32 >> (((7 - off) - pass) << 2)) & 0xF0)\n347\t}\n348\t#[inline]\n349\tpub fn PNG_ROW_IN_INTERLACE_PASS(y: png_uint_32, pass: c_int) -> png_uint_32 {\n350\t    (PNG_PASS_MASK(pass, 0) >> (y & 7)) & 1\n351\t}\n352\t#[inline]\n353\tpub fn PNG_COL_IN_INTERLACE_PASS(x: png_uint_32, pass: c_int) -> png_uint_32 {\n354\t    (PNG_PASS_MASK(pass, 1) >> (x & 7)) & 1\n355\t}\n356\t\n357\t/* Alpha composition (PNG_READ_COMPOSITE_NODIV_SUPPORTED) ----------- */\n358\t\n359\t/// `png_composite(composite, fg, alpha, bg)`\n360\t#[inline]\n361\tpub fn png_composite(fg: png_uint_16, alpha: png_uint_16, bg: png_uint_16) -> png_byte {\n362\t    let temp: png_uint_16 = fg\n363\t        .wrapping_add(bg.wrapping_mul(255u16.wrapping_sub(alpha)))\n364\t        .wrapping_add(128);\n365\t    (((temp.wrapping_add(temp >> 8)) >> 8) & 0xff) as png_byte\n366\t}\n367\t\n368\t/// `png_composite_16(composite, fg, alpha, bg)`\n369\t#[inline]\n370\tpub fn png_composite_16(fg: png_uint_32, alpha: png_uint_32, bg: png_uint_32) -> png_uint_16 {\n371\t    let temp: png_uint_32 = fg\n372\t        .wrapping_add(bg.wrapping_mul(65535u32.wrapping_sub(alpha)))\n373\t        .wrapping_add(32768);\n374\t    (0xffff & ((temp.wrapping_add(temp >> 16)) >> 16)) as png_uint_16\n375\t}\n376\t\n377\t/* fp state predicates --------------------------------------------- */\n378\t\n379\t#[inline]\n380\tpub fn PNG_FP_IS_ZERO(state: c_int) -> bool {\n381\t    (state & PNG_FP_Z_MASK) == PNG_FP_SAW_DIGIT\n382\t}\n383\t#[inline]\n384\tpub fn PNG_FP_IS_POSITIVE(state: c_int) -> bool {\n385\t    (state & PNG_FP_NZ_MASK) == PNG_FP_Z_MASK\n386\t}\n387\t#[inline]\n388\tpub fn PNG_FP_IS_NEGATIVE(state: c_int) -> bool {\n389\t    (state & PNG_FP_NZ_MASK) == PNG_FP_NZ_MASK\n390\t}\n391\t\n392\t/* ================================================================== */\n393\t/* Simplified API size macros                                          */\n394\t/* ================================================================== */\n395\t\n396\t#[inline]\n397\tpub fn PNG_IMAGE_SAMPLE_CHANNELS(fmt: png_uint_32) -> png_uint_32 {\n398\t    (fmt & (PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA)) + 1\n399\t}\n400\t#[inline]\n401\tpub fn PNG_IMAGE_SAMPLE_COMPONENT_SIZE(fmt: png_uint_32) -> png_uint_32 {\n402\t    ((fmt & PNG_FORMAT_FLAG_LINEAR) >> 2) + 1\n403\t}\n404\t#[inline]\n405\tpub fn PNG_IMAGE_SAMPLE_SIZE(fmt: png_uint_32) -> png_uint_32 {\n406\t    PNG_IMAGE_SAMPLE_CHANNELS(fmt) * PNG_IMAGE_SAMPLE_COMPONENT_SIZE(fmt)\n407\t}\n408\t#[inline]\n409\tpub fn PNG_IMAGE_MAXIMUM_COLORMAP_COMPONENTS(fmt: png_uint_32) -> png_uint_32 {\n410\t    PNG_IMAGE_SAMPLE_CHANNELS(fmt) * 256\n411\t}\n412\t#[inline]\n413\tpub fn PNG_IMAGE_PIXEL_CHANNELS(fmt: png_uint_32) -> png_uint_32 {\n414\t    if (fmt & PNG_FORMAT_FLAG_COLORMAP) != 0 {\n415\t        1\n416\t    } else {\n417\t        PNG_IMAGE_SAMPLE_CHANNELS(fmt)\n418\t    }\n419\t}\n420\t#[inline]\n421\tpub fn PNG_IMAGE_PIXEL_COMPONENT_SIZE(fmt: png_uint_32) -> png_uint_32 {\n422\t    if (fmt & PNG_FORMAT_FLAG_COLORMAP) != 0 {\n423\t        1\n424\t    } else {\n425\t        PNG_IMAGE_SAMPLE_COMPONENT_SIZE(fmt)\n426\t    }\n427\t}\n428\t#[inline]\n429\tpub fn PNG_IMAGE_PIXEL_SIZE(fmt: png_uint_32) -> png_uint_32 {\n430\t    if (fmt & PNG_FORMAT_FLAG_COLORMAP) != 0 {\n431\t        1\n432\t    } else {\n433\t        PNG_IMAGE_SAMPLE_SIZE(fmt)\n434\t    }\n435\t}\n436\t#[inline]\n437\tpub unsafe fn PNG_IMAGE_ROW_STRIDE(image: *const png_image) -> png_uint_32 {\n438\t    PNG_IMAGE_PIXEL_CHANNELS((*image).format).wrapping_mul((*image).width)\n439\t}\n440\t#[inline]\n441\tpub unsafe fn PNG_IMAGE_BUFFER_SIZE(image: *const png_image, row_stride: png_uint_32) -> png_uint_32 {\n442\t    PNG_IMAGE_PIXEL_COMPONENT_SIZE((*image).format)\n443\t        .wrapping_mul((*image).height)\n444\t        .wrapping_mul(row_stride)\n445\t}\n446\t#[inline]\n447\tpub unsafe fn PNG_IMAGE_SIZE(image: *const png_image) -> png_uint_32 {\n448\t    PNG_IMAGE_BUFFER_SIZE(image, PNG_IMAGE_ROW_STRIDE(image))\n449\t}\n450\t#[inline]\n451\tpub unsafe fn PNG_IMAGE_COLORMAP_SIZE(image: *const png_image) -> png_uint_32 {\n452\t    PNG_IMAGE_SAMPLE_SIZE((*image).format).wrapping_mul((*image).colormap_entries)\n453\t}\n454\t#[inline]\n455\tpub unsafe fn PNG_IMAGE_DATA_SIZE(image: *const png_image) -> png_uint_32 {\n456\t    PNG_IMAGE_SIZE(image).wrapping_add((*image).height)\n457\t}\n458\t#[i