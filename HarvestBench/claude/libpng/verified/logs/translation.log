n201\t            let mut c: c_int;\n202\t\n203\t            *out_ptr.offset(aindex as isize) = alpha;\n204\t\n205\t            /* Calculate a reciprocal.  The correct calculation is simply\n206\t             * component/alpha*65535 << 15. (I.e. 15 bits of precision); this\n207\t             * allows correct rounding by adding .5 before the shift.  'reciprocal'\n208\t             * is only initialized when required.\n209\t             */\n210\t            if alpha > 0 && alpha < 65535 {\n211\t                reciprocal = (((0xffff as png_uint_32) << 15) + ((alpha as png_uint_32) >> 1))\n212\t                    / (alpha as png_uint_32);\n213\t            }\n214\t\n215\t            c = channels as c_int;\n216\t            loop\n217\t            /* always at least one channel */\n218\t            {\n219\t                let mut component: png_uint_16 = *in_ptr;\n220\t                in_ptr = in_ptr.add(1);\n221\t\n222\t                /* The following gives 65535 for an alpha of 0, which is fine,\n223\t                 * otherwise if 0/0 is represented as some other value there is more\n224\t                 * likely to be a discontinuity which will probably damage\n225\t                 * compression when moving from a fully transparent area to a\n226\t                 * nearly transparent one.  (The assumption here is that opaque\n227\t                 * areas tend not to be 0 intensity.)\n228\t                 */\n229\t                if component >= alpha {\n230\t                    component = 65535;\n231\t                }\n232\t                /* component<alpha, so component/alpha is less than one and\n233\t                 * component*reciprocal is less than 2^31.\n234\t                 */\n235\t                else if component > 0 && alpha < 65535 {\n236\t                    let mut calc: png_uint_32 = (component as png_uint_32).wrapping_mul(reciprocal);\n237\t                    calc = calc.wrapping_add(16384); /* round to nearest */\n238\t                    component = (calc >> 15) as png_uint_16;\n239\t                }\n240\t\n241\t                *out_ptr = component;\n242\t                out_ptr = out_ptr.add(1);\n243\t\n244\t                c -= 1;\n245\t                if !(c > 0) {\n246\t                    break;\n247\t                }\n248\t            }\n249\t\n250\t            /* Skip to next component (skip the intervening alpha channel) */\n251\t            in_ptr = in_ptr.add(1);\n252\t            out_ptr = out_ptr.add(1);\n253\t        }\n254\t\n255\t        png_write_row(png_ptr, (*display).local_row as png_const_bytep);\n256\t        input_row = input_row.offset((*display).row_step / 2);\n257\t\n258\t        y -= 1;\n259\t    }\n260\t\n261\t    1\n262\t}\n263\t\n264\t/* Given 16-bit input (1 to 4 channels) write 8-bit output.  If an alpha channel\n265\t * is present it must be removed from the components, the components are then\n266\t * written in sRGB encoding.  No components are added or removed.\n267\t *\n268\t * Calculate an alpha reciprocal to reverse pre-multiplication.  As above the\n269\t * calculation can be done to 15 bits of accuracy; however, the output needs to\n270\t * be scaled in the range 0..255*65535, so include that scaling here.\n271\t */\n272\t/* UNP_RECIPROCAL(alpha) */\n273\t#[inline]\n274\tfn UNP_RECIPROCAL(alpha: png_uint_32) -> png_uint_32 {\n275\t    ((((0xffff as png_uint_32) * 0xff) << 7) + (alpha >> 1)) / alpha\n276\t}\n277\t\n278\t/* png_unpremultiply */\n279\tunsafe fn png_unpremultiply(\n280\t    mut component: png_uint_32,\n281\t    alpha: png_uint_32,\n282\t    reciprocal: png_uint_32, /*from the above macro*/\n283\t) -> png_byte {\n284\t    /* The following gives 1.0 for an alpha of 0, which is fine, otherwise if 0/0\n285\t     * is represented as some other value there is more likely to be a\n286\t     * discontinuity which will probably damage compression when moving from a\n287\t     * fully transparent area to a nearly transparent one.  (The assumption here\n288\t     * is that opaque areas tend not to be 0 intensity.)\n289\t     *\n290\t     * There is a rounding problem here; if alpha is less than 128 it will end up\n291\t     * as 0 when scaled to 8 bits.  To avoid introducing spurious colors into the\n292\t     * output change for this too.\n293\t     */\n294\t    if component >= alpha || alpha < 128 {\n295\t        return 255;\n296\t    }\n297\t    /* component<alpha, so component/alpha is less than one and\n298\t     * component*reciprocal is less than 2^31.\n299\t     */\n300\t    else if component > 0 {\n301\t        /* The test is that alpha/257 (rounded) is less than 255, the first value\n302\t         * that becomes 255 is 65407.\n303\t         * NOTE: this must agree with the PNG_DIV257 macro (which must, therefore,\n304\t         * be exact!)  [Could also test reciprocal != 0]\n305\t         */\n306\t        if alpha < 65407 {\n307\t            component = component.wrapping_mul(reciprocal);\n308\t            component = component.wrapping_add(64); /* round to nearest */\n309\t            component >>= 7;\n310\t        } else {\n311\t            component = component.wrapping_mul(255);\n312\t        }\n313\t\n314\t        /* Convert the component to sRGB. */\n315\t        return PNG_sRGB_FROM_LINEAR(component) as png_byte;\n316\t    } else {\n317\t        return 0;\n318\t    }\n319\t}\n320\t\n321\t/* png_write_image_8bit */\n322\tunsafe extern \"C\" fn png_write_image_8bit(argument: png_voidp) -> c_int {\n323\t    let display: *mut png_image_write_control = argument as *mut png_image_write_control;\n324\t    let image: png_imagep = (*display).image;\n325\t    let png_ptr: png_structrp = (*(*image).opaque).png_ptr;\n326\t\n327\t    let mut input_row: png_const_uint_16p = (*display).first_row as png_const_uint_16p;\n328\t    let mut output_row: png_bytep = (*display).local_row as png_bytep;\n329\t    let mut y: png_uint_32 = (*image).height;\n330\t    let channels: c_uint = if ((*image).format & PNG_FORMAT_FLAG_COLOR) != 0 {\n331\t        3\n332\t    } else {\n333\t        1\n334\t    };\n335\t\n336\t    if ((*image).format & PNG_FORMAT_FLAG_ALPHA) != 0 {\n337\t        let row_end: png_bytep;\n338\t        let aindex: c_int;\n339\t\n340\t        if ((*image).format & PNG_FORMAT_FLAG_AFIRST) != 0 {\n341\t            aindex = -1;\n342\t            input_row = input_row.add(1); /* To point to the first component */\n343\t            output_row = output_row.add(1);\n344\t        } else {\n345\t            aindex = channels as c_int;\n346\t        }\n347\t\n348\t        /* Use row_end in place of a loop counter: */\n349\t        row_end = output_row.add((*image).width.wrapping_mul(channels.wrapping_add(1)) as usize);\n350\t\n351\t        while y > 0 {\n352\t            let mut in_ptr: png_const_uint_16p = input_row;\n353\t            let mut out_ptr: png_bytep = output_row;\n354\t\n355\t            while out_ptr < row_end {\n356\t                let alpha: png_uint_16 = *in_ptr.offset(aindex as isize);\n357\t                let alphabyte: png_byte = PNG_DIV257(alpha as png_uint_32) as png_byte;\n358\t                let mut reciprocal: png_uint_32 = 0;\n359\t                let mut c: c_int;\n360\t\n361\t                /* Scale and write the alpha channel. */\n362\t                *out_ptr.offset(aindex as isize) = alphabyte;\n363\t\n364\t                if alphabyte > 0 && alphabyte < 255 {\n365\t                    reciprocal = UNP_RECIPROCAL(alpha as png_uint_32);\n366\t                }\n367\t\n368\t                c = channels as c_int;\n369\t                loop\n370\t                /* always at least one channel */\n371\t                {\n372\t                    let v: png_uint_16 = *in_ptr;\n373\t                    in_ptr = in_ptr.add(1);\n374\t                    *out_ptr =\n375\t                        png_unpremultiply(v as png_uint_32, alpha as png_uint_32, reciprocal);\n376\t                    out_ptr = out_ptr.add(1);\n377\t\n378\t                    c