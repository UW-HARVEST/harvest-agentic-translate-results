ttom-up)\n3177\t          * layouts.\n3178\t          */\n3179\t         memcpy(output_row, local_row, row_bytes);\n3180\t         output_row += row_step;\n3181\t      }\n3182\t   }\n3183\t\n3184\t   return 1;\n3185\t}\n3186\t\n3187\t/* Just the row reading part of png_image_read. */\n3188\tstatic int\n3189\tpng_image_read_composite(png_voidp argument)\n3190\t{\n3191\t   png_image_read_control *display = png_voidcast(png_image_read_control*,\n3192\t       argument);\n3193\t   png_imagep image = display->image;\n3194\t   png_structrp png_ptr = image->opaque->png_ptr;\n3195\t   int passes;\n3196\t\n3197\t   switch (png_ptr->interlaced)\n3198\t   {\n3199\t      case PNG_INTERLACE_NONE:\n3200\t         passes = 1;\n3201\t         break;\n3202\t\n3203\t      case PNG_INTERLACE_ADAM7:\n3204\t         passes = PNG_INTERLACE_ADAM7_PASSES;\n3205\t         break;\n3206\t\n3207\t      default:\n3208\t         png_error(png_ptr, \"unknown interlace type\");\n3209\t   }\n3210\t\n3211\t   {\n3212\t      png_uint_32 height = image->height;\n3213\t      png_uint_32 width = image->width;\n3214\t      ptrdiff_t row_step = display->row_step;\n3215\t      unsigned int channels =\n3216\t          (image->format & PNG_FORMAT_FLAG_COLOR) != 0 ? 3 : 1;\n3217\t      int optimize_alpha = (png_ptr->flags & PNG_FLAG_OPTIMIZE_ALPHA) != 0;\n3218\t      int pass;\n3219\t\n3220\t      for (pass = 0; pass < passes; ++pass)\n3221\t      {\n3222\t         unsigned int startx, stepx, stepy;\n3223\t         png_uint_32 y;\n3224\t\n3225\t         if (png_ptr->interlaced == PNG_INTERLACE_ADAM7)\n3226\t         {\n3227\t            /* The row may be empty for a short image: */\n3228\t            if (PNG_PASS_COLS(width, pass) == 0)\n3229\t               continue;\n3230\t\n3231\t            startx = PNG_PASS_START_COL(pass) * channels;\n3232\t            stepx = PNG_PASS_COL_OFFSET(pass) * channels;\n3233\t            y = PNG_PASS_START_ROW(pass);\n3234\t            stepy = PNG_PASS_ROW_OFFSET(pass);\n3235\t         }\n3236\t\n3237\t         else\n3238\t         {\n3239\t            y = 0;\n3240\t            startx = 0;\n3241\t            stepx = channels;\n3242\t            stepy = 1;\n3243\t         }\n3244\t\n3245\t         for (; y<height; y += stepy)\n3246\t         {\n3247\t            png_bytep inrow = png_voidcast(png_bytep, display->local_row);\n3248\t            png_bytep outrow;\n3249\t            png_const_bytep row_end;\n3250\t\n3251\t            /* Read the row, which is packed: */\n3252\t            png_read_row(png_ptr, inrow, NULL);\n3253\t\n3254\t            outrow = png_voidcast(png_bytep, display->first_row);\n3255\t            outrow += y * row_step;\n3256\t            row_end = outrow + width * channels;\n3257\t\n3258\t            /* Now do the composition on each pixel in this row. */\n3259\t            outrow += startx;\n3260\t            for (; outrow < row_end; outrow += stepx)\n3261\t            {\n3262\t               png_byte alpha = inrow[channels];\n3263\t\n3264\t               if (alpha > 0) /* else no change to the output */\n3265\t               {\n3266\t                  unsigned int c;\n3267\t\n3268\t                  for (c=0; c<channels; ++c)\n3269\t                  {\n3270\t                     png_uint_32 component = inrow[c];\n3271\t\n3272\t                     if (alpha < 255) /* else just use component */\n3273\t                     {\n3274\t                        if (optimize_alpha != 0)\n3275\t                        {\n3276\t                           /* This is PNG_OPTIMIZED_ALPHA, the component value\n3277\t                            * is a linear 8-bit value.  Combine this with the\n3278\t                            * current outrow[c] value which is sRGB encoded.\n3279\t                            * Arithmetic here is 16-bits to preserve the output\n3280\t                            * values correctly.\n3281\t                            */\n3282\t                           component *= 257*255; /* =65535 */\n3283\t