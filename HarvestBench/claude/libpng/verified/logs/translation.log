{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014SS9g9cQMEsH9jKGQ7B6sN","type":"tool_result","content":"1\t//! The libpng preprocessor macros, translated into `#[inline]` functions,\n2\t//! plus a handful of C library helpers.\n3\t\n4\t#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals, dead_code)]\n5\t\n6\tuse crate::ffi::*;\n7\tuse crate::pngtypes::*;\n8\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n9\t\n10\t/* ================================================================== */\n11\t/* <string.h> replacements                                             */\n12\t/* ================================================================== */\n13\t\n14\t#[inline]\n15\tpub unsafe fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void {\n16\t    if n != 0 {\n17\t        core::ptr::copy_nonoverlapping(src as *const u8, dst as *mut u8, n);\n18\t    }\n19\t    dst\n20\t}\n21\t\n22\t#[inline]\n23\tpub unsafe fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void {\n24\t    if n != 0 {\n25\t        core::ptr::copy(src as *const u8, dst as *mut u8, n);\n26\t    }\n27\t    dst\n28\t}\n29\t\n30\t#[inline]\n31\tpub unsafe fn memset(dst: *mut c_void, v: c_int, n: usize) -> *mut c_void {\n32\t    if n != 0 {\n33\t        core::ptr::write_bytes(dst as *mut u8, v as u8, n);\n34\t    }\n35\t    dst\n36\t}\n37\t\n38\t#[inline]\n39\tpub unsafe fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int {\n40\t    let a = a as *const u8;\n41\t    let b = b as *const u8;\n42\t    let mut i = 0usize;\n43\t    while i < n {\n44\t        let x = *a.add(i);\n45\t        let y = *b.add(i);\n46\t        if x != y {\n47\t            return if x < y { -1 } else { 1 };\n48\t        }\n49\t        i += 1;\n50\t    }\n51\t    0\n52\t}\n53\t\n54\t#[inline]\n55\tpub unsafe fn strlen(s: *const c_char) -> usize {\n56\t    let mut n = 0usize;\n57\t    while *s.add(n) != 0 {\n58\t        n += 1;\n59\t    }\n60\t    n\n61\t}\n62\t\n63\t#[inline]\n64\tpub unsafe fn strcmp(a: *const c_char, b: *const c_char) -> c_int {\n65\t    let mut i = 0usize;\n66\t    loop {\n67\t        let x = *a.add(i) as u8;\n68\t        let y = *b.add(i) as u8;\n69\t        if x != y {\n70\t            return if x < y { -1 } else { 1 };\n71\t        }\n72\t        if x == 0 {\n73\t            return 0;\n74\t        }\n75\t        i += 1;\n76\t    }\n77\t}\n78\t\n79\t#[inline]\n80\tpub unsafe fn strncmp(a: *const c_char, b: *const c_char, n: usize) -> c_int {\n81\t    let mut i = 0usize;\n82\t    while i < n {\n83\t        let x = *a.add(i) as u8;\n84\t        let y = *b.add(i) as u8;\n85\t        if x != y {\n86\t            return if x < y { -1 } else { 1 };\n87\t        }\n88\t        if x == 0 {\n89\t            return 0;\n90\t        }\n91\t        i += 1;\n92\t    }\n93\t    0\n94\t}\n95\t\n96\t/// `abs()` for `int`.\n97\t#[inline]\n98\tpub fn abs(v: c_int) -> c_int {\n99\t    v.wrapping_abs()\n100\t}\n101\t\n102\t/* ================================================================== */\n103\t/* png.h read/write integer macros                                     */\n104\t/* ================================================================== */\n105\t\n106\t/// `PNG_get_uint_32` — the read macro used inside the library.\n107\t#[inline]\n108\tpub unsafe fn PNG_get_uint_32(buf: png_const_bytep) -> png_uint_32 {\n109\t    ((*buf as png_uint_32) << 24)\n110\t        .wrapping_add((*buf.add(1) as png_uint_32) << 16)\n111\t        .wrapping_add((*buf.add(2) as png_uint_32) << 8)\n112\t        .wrapping_add(*buf.add(3) as png_uint_32)\n113\t}\n114\t\n115\t/// `PNG_get_uint_16`\n116\t#[inline]\n117\tpub unsafe fn PNG_get_uint_16(buf: png_const_bytep) -> png_uint_16 {\n118\t    (((*buf as c_uint) << 8) + (*buf.add(1) as c_uint)) as png_uint_16\n119\t}\n120\t\n121\t/// `PNG_get_int_32`\n122\t#[inline]\n123\tpub unsafe fn PNG_get_int_32(buf: png_const_bytep) -> png_int_32 {\n124\t    if (*buf & 0x80) != 0 {\n1