mage_is_not_sRGB(png_ptr) != 0 {\n205\t            (*image).flags |= PNG_IMAGE_FLAG_COLORSPACE_NOT_sRGB;\n206\t        }\n207\t    }\n208\t\n209\t    /* We need the maximum number of entries regardless of the format the\n210\t     * application sets here.\n211\t     */\n212\t    {\n213\t        let mut cmap_entries: png_uint_32;\n214\t\n215\t        match (*png_ptr).color_type as c_int {\n216\t            PNG_COLOR_TYPE_GRAY => {\n217\t                cmap_entries = 1u32 << (*png_ptr).bit_depth as c_int;\n218\t            }\n219\t\n220\t            PNG_COLOR_TYPE_PALETTE => {\n221\t                cmap_entries = (*png_ptr).num_palette as png_uint_32;\n222\t            }\n223\t\n224\t            _ => {\n225\t                cmap_entries = 256;\n226\t            }\n227\t        }\n228\t\n229\t        if cmap_entries > 256 {\n230\t            cmap_entries = 256;\n231\t        }\n232\t\n233\t        (*image).colormap_entries = cmap_entries;\n234\t    }\n235\t\n236\t    1\n237\t}\n238\t\n239\t#[unsafe(no_mangle)]"}]},"parent_tool_use_id":"toolu_bdrk_01FyTzrDe4x4XVG8BeybtA9n","session_id":"d9f98909-8564-4f94-b720-603696df3aad","uuid":"d968ac72-2f72-4932-8bbf-733be7d073b9","timestamp":"2026-08-22T23:22:59.910Z","subagent_type":"general-purpose","task_description":"Translate pngread.c 1528-1959"}
