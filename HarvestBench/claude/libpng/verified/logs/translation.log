\nstatic void PNGCBAPI warnfn(png_structp p, png_const_charp msg){(void)p;printf(\"  WARN: %s\\n\", msg);}\nstatic unsigned long rs=1;\nstatic unsigned rnd(void){ rs = rs*1103515245UL+12345UL; return (unsigned)((rs>>16)&0x7fff); }\n\n#define FORK_BEGIN { pid_t _p=fork(); if(_p==0){\n#define FORK_END   fflush(stdout); _exit(0);} else { int _s=0; waitpid(_p,&_s,0); \\\n   if(!WIFEXITED(_s)) printf(\"  child signal=%d\\n\", WIFSIGNALED(_s)?WTERMSIG(_s):-1); } }\n\n/* Build a syntactically valid ICC profile of the requested size. */\nstatic png_bytep make_icc(png_uint_32 *lenp, int ntags, int variant)\n{\n   png_uint_32 tagtab = 132 + 12*(png_uint_32)ntags;\n   png_uint_32 datalen = 64;\n   png_uint_32 len = tagtab + datalen;\n   png_bytep b = calloc(1,len);\n   int i;\n   png_save_uint_32(b, len);\n   memcpy(b+4, \"ADBE\", 4);              /* preferred CMM */\n   png_save_uint_32(b+8, variant==1?0x02000000:0x04300000);  /* version */\n   memcpy(b+12, variant==2?\"link\":\"mntr\", 4);\n   memcpy(b+16, variant==3?\"GRAY\":\"RGB \", 4);\n   memcpy(b+20, variant==4?\"Lab \":\"XYZ \", 4);\n   memcpy(b+36, variant==5?\"badx\":\"acsp\", 4);\n   memcpy(b+40, \"APPL\", 4);\n   png_save_uint_32(b+64, 0);           /* rendering intent */\n   /* illuminant D50 */\n   png_save_uint_32(b+68, 0x0000f6d6);\n   png_save_uint_32(b+72, 0x00010000);\n   png_save_uint_32(b+76, 0x0000d32d);\n   png_save_uint_32(b+128, (png_uint_32)ntags);\n   for(i=0;i<ntags;i++){\n      png_save_uint_32(b+132+12*i+0, 0x63707274+i);  /* signature */\n      png_save_uint_32(b+132+12*i+4, tagtab + (png_uint_32)(i*8));\n      png_save_uint_32(b+132+12*i+8, 8);\n   }\n   if (variant==6) png_save_uint_32(b+132+4, len);      /* offset past end */\n   if (variant==7) png_save_uint_32(b+132+8, 0xffffff); /* huge size */\n   if (variant==8) png_save_uint_32(b+132+4, 3);        /* misaligned offset */\n   *lenp = len;\n   return b;\n}\n\nstatic void icc_test(void)\n{\n   int variant, ntags, skip;\n   for(variant=0;variant<9;variant++) for(ntags=0;ntags<3;ntags++) for(skip=0;skip<2;skip++){\n     FORK_BEGIN\n     membuf m; png_structp p; png_infop ip; png_bytep row; png_uint_32 plen;\n     png_bytep prof = make_icc(&plen, ntags?ntags*2:0, variant);\n     mb_init(&m);\n     p=png_create_write_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n     ip=png_create_info_struct(p);\n     printf(\"-- icc v%d t%d s%d len=%lu\\n\",variant,ntags,skip,(unsigned long)plen);\n     if(setjmp(png_jmpbuf(p))){printf(\"icc w LONGJMP\\n\");}\n     else{\n       png_set_write_fn(p,&m,wfn,ffn);\n       png_set_IHDR(p,ip,4,2,8,PNG_COLOR_TYPE_RGB,0,0,0);\n       png_set_iCCP(p,ip,\"prof\",PNG_COMPRESSION_TYPE_BASE,prof,plen);\n       png_write_info(p,ip);\n       row=calloc(1,12); png_write_row(p,row); png_write_row(p,row); free(row);\n       png_write_end(p,ip);\n       printf(\"icc write len=%lu crc=%08lx\\n\",(unsigned long)m.len,crcbuf(m.buf,m.len));\n       { memrd r; png_structp rp; png_infop rip;\n         r.buf=m.buf;r.len=m.len;r.pos=0;\n         rp=png_create_read_struct(PNG_LIBPNG_VER_STRING,NULL,errfn,warnfn);\n         rip=png_create_info_struct(rp);\n         if(setjmp(png_jmpbuf(rp))){printf(\"icc r LONGJMP\\n\");}\n         else{\n           png_set_read_fn(rp,&r,rfn);\n           if(skip) png_set_option(rp,PNG_SKIP_sRGB_CHECK_PROFILE,PNG_OPTION_ON);\n           png_read_info(rp,rip);\n           { png_charp nm; int ct; png_bytep pf; png_uint_32 pl;\n             if(png_get_iCCP(rp,rip,&nm,&ct,&pf,&pl))\n               printf(\"icc read name=%s ct=%d len=%lu crc=%08lx\\n\",nm,ct,(unsigned long)pl,crcbuf(pf,pl));\n             else printf(\"icc read none\\n\"); }\n           png_read_end(rp,rip);\n         }\n         png_destroy_read_struct(&rp,&rip,NULL); }\n     }\n     png_destroy_write_struct(&p,&ip);\n     free(prof); free(m.buf);\n     FORK_END\n   }\n}\n\nstatic void colorspace_test(void)\n{\n   int intent;\n   for(intent=-1;intent<5;intent++){\n     FORK_BEGIN\n     membuf m; p