n if it is not\n226\t         * required.\n227\t         */\n228\t        png_set_write_fn(png_ptr, core::ptr::null_mut(), None, None);\n229\t    }\n230\t\n231\t    return png_ptr;\n232\t}\n233\t\n234\t/* Write a few rows of image data.  If the image is interlaced,\n235\t * either you will have to write the 7 sub images, or, if you\n236\t * have called png_set_interlace_handling(), you will have to\n237\t * \"write\" the image seven times.\n238\t */\n239\t/* png_write_rows */\n240\t#[unsafe(no_mangle)]\n241\tpub unsafe extern \"C\" fn png_write_rows(\n242\t    png_ptr: png_structrp,\n243\t    row: png_bytepp,\n244\t    num_rows: png_uint_32,\n245\t) {\n246\t    let mut i: png_uint_32; /* row counter */\n247\t    let mut rp: png_bytepp; /* row pointer */\n248\t\n249\t    if png_ptr == core::ptr::null_mut() {\n250\t        return;\n251\t    }\n252\t\n253\t    /* Loop through the rows */\n254\t    i = 0;\n255\t    rp = row;\n256\t    while i < num_rows {\n257\t        png_write_row(png_ptr, *rp);\n258\t        i += 1;\n259\t        rp = rp.offset(1);\n260\t    }\n261\t}\n262\t\n263\t/* Write the image.  You only need to call this function once, even\n264\t * if you are writing an interlaced image.\n265\t */\n266\t/* png_write_image */\n267\t#[unsafe(no_mangle)]\n268\tpub unsafe extern \"C\" fn png_write_image(png_ptr: png_structrp, image: png_bytepp) {\n269\t    let mut i: png_uint_32; /* row index */\n270\t    let mut pass: c_int;\n271\t    let num_pass: c_int; /* pass variables */\n272\t    let mut rp: png_bytepp; /* points to current row */\n273\t\n274\t    if png_ptr == core::ptr::null_mut() {\n275\t        return;\n276\t    }\n277\t\n278\t    /* Initialize interlace handling.  If image is not interlaced,\n279\t     * this will set pass to 1\n280\t     */\n281\t    num_pass = png_set_interlace_handling(png_ptr);\n282\t\n283\t    /* Loop through passes */\n284\t    pass = 0;\n285\t    while pass < num_pass {\n286\t        /* Loop through image */\n287\t        i = 0