{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012f6xAG5mXyFDNwD7mAx6Jn","type":"tool_result","content":"1\t//! Bindings to the C runtime facilities that libpng uses directly, plus the\n2\t//! zlib API (libpng does not implement DEFLATE itself; the reference build\n3\t//! links the system zlib and so do we, which guarantees byte-identical\n4\t//! compressed output).\n5\t\n6\t#![allow(non_camel_case_types)]\n7\t\n8\tuse core::ffi::{c_char, c_int, c_long, c_uint, c_ulong, c_void};\n9\t\n10\t/* ------------------------------------------------------------------ */\n11\t/* <stdio.h>                                                           */\n12\t/* ------------------------------------------------------------------ */\n13\t\n14\t#[repr(C)]\n15\tpub struct FILE {\n16\t    _opaque: [u8; 0],\n17\t}\n18\t\n19\textern \"C\" {\n20\t    pub fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n21\t    pub fn fclose(f: *mut FILE) -> c_int;\n22\t    pub fn fread(ptr: *mut c_void, size: usize, n: usize, f: *mut FILE) -> usize;\n23\t    pub fn fwrite(ptr: *const c_void, size: usize, n: usize, f: *mut FILE) -> usize;\n24\t    pub fn fflush(f: *mut FILE) -> c_int;\n25\t    pub fn ferror(f: *mut FILE) -> c_int;\n26\t    pub fn fputs(s: *const c_char, f: *mut FILE) -> c_int;\n27\t    pub static mut stderr: *mut FILE;\n28\t}\n29\t\n30\t/// `fprintf(stderr, \"<prefix>%s\", msg); fprintf(stderr, \"\\n\");`\n31\tpub unsafe fn png_stderr_message(prefix: *const c_char, msg: *const c_char) {\n32\t    fputs(prefix, stderr);\n33\t    fputs(msg, stderr);\n34\t    fputs(b\"\\n\\0\".as_ptr() as *const c_char, stderr);\n35\t}\n36\t\n37\t/* ------------------------------------------------------------------ */\n38\t/* <stdlib.h> / <string.h>                                             */\n39\t/* ------------------------------------------------------------------ */\n40\t\n41\textern \"C\" {\n42\t    pub fn malloc(size: usize) -> *mut c_void;\n43\t    pub fn free(p: *mut c_void);\n44\t    pub fn abort() -> !;\n45\t}\n46\t\n47\t/* ------------------------------------------------------------------ */\n48\t/* <setjmp.h>                                                          */\n49\t/* ------------------------------------------------------------------ */\n50\t\n51\t/// `jmp_buf` on x86-64 glibc: 200 bytes, 8 byte alignment.\n52\tpub type jmp_buf = [u64; 25];\n53\t\n54\textern \"C\" {\n55\t    #[link_name = \"setjmp\"]\n56\t    pub fn setjmp(env: *mut jmp_buf) -> c_int;\n57\t    #[link_name = \"longjmp\"]\n58\t    pub fn longjmp(env: *mut jmp_buf, val: c_int) -> !;\n59\t}\n60\t\n61\t/* ------------------------------------------------------------------ */\n62\t/* <time.h>                                                            */\n63\t/* ------------------------------------------------------------------ */\n64\t\n65\tpub type time_t = i64;\n66\t\n67\t#[repr(C)]\n68\t#[derive(Clone, Copy)]\n69\tpub struct tm {\n70\t    pub tm_sec: c_int,\n71\t    pub tm_min: c_int,\n72\t    pub tm_hour: c_int,\n73\t    pub tm_mday: c_int,\n74\t    pub tm_mon: c_int,\n75\t    pub tm_year: c_int,\n76\t    pub tm_wday: c_int,\n77\t    pub tm_yday: c_int,\n78\t    pub tm_isdst: c_int,\n79\t    pub tm_gmtoff: c_long,\n80\t    pub tm_zone: *const c_char,\n81\t}\n82\t\n83\textern \"C\" {\n84\t    pub fn gmtime(t: *const time_t) -> *mut tm;\n85\t}\n86\t\n87\t/* ------------------------------------------------------------------ */\n88\t/* <math.h>                                                            */\n89\t/* ------------------------------------------------------------------ */\n90\t\n91\textern \"C\" {\n92\t    pub fn pow(x: f64, y: f64) -> f64;\n93\t    pub fn floor(x: f64) -> f64;\n94\t    pub fn ceil(x: f64) -> f64;\n95\t    pub fn fabs(x: f64) -> f64;\n96\t    pub fn log(x: f64) -> f64;\n97\t    pub fn exp(x: f64) -> f64;\n98\t    pub fn modf(x: f64, i: *mut f64) -> f64;\n99\t    pub fn frexp(x: f64, e: *mut c_int) -> f64;\n100\t}\n101\t\n102\tpub const DBL_DIG: c_int = 15;\n103\tpub const DBL_MIN: f64 = 2.2250738585072014e-308;\n104\tpub const DBL_MAX: f64 = 1.7976931348623157e308;\n105\t\n106\t/* ------------------------------------------------------------------ */\n107\t/* zlib                                                                */\n108\t/* ------------------------------------------------------------------ */\n109\t\n110\tpub type uInt = c_uint;\n111\tpub type uLong = c_ulong;\n112\tpub type Bytef = u8;\n113\tpub type voidpf = *mut c_void;\n114\tpub type alloc_func = Option<unsafe extern \"C\" fn(voidpf, uInt, uInt) -> voidpf>;\n115\tpub type free_func = Option<unsafe extern \"C\" fn(voidpf, voidpf)>;\n116\t\n117\t#[repr(C)]\n118\t#[derive(Clone, Copy)]\n119\tpub struct z_stream {\n120\t    pub next_in: *const Bytef,\n121\t    pub avail_in: uInt,\n122\t    pub total_in: uLong,\n123\t    pub next_out: *mut Bytef,\n124\t    pub avail_out: uInt,\n125\t    pub total_out: uLong,\n126\t    pub msg: *const c_char,\n127\t    pub state: *mut c_void,\n128\t    pub zalloc: alloc_func,\n129\t    pub zfree: free_func,\n130\t    pub opaque: voidpf,\n131\t    pub data_type: c_int,\n132\t    pub adler: uLong,\n133\t    pub reserved: uLong,\n134\t}\n135\t\n136\tpub type z_streamp = *mut z_stream;\n137\t\n138\tpub const Z_NO_FLUSH: c_int = 0;\n139\tpub const Z_PARTIAL_FLUSH: c_int = 1;\n140\tpub const Z_SYNC_FLUSH: c_int = 2;\n141\tpub const Z_FULL_FLUSH: c_int = 3;\n142\tpub const Z_FINISH: c_int = 4;\n143\tpub const Z_BLOCK: c_int = 5;\n144\tpub const Z_TREES: c_int = 6;\n145\t\n146\tpub const Z_OK: c_int = 0;\n147\tpub const Z_STREAM_END: c_int = 1;\n148\tpub const Z_NEED_DICT: c_int = 2;\n149\tpub const Z_ERRNO: c_int = -1;\n150\tpub const Z_STREAM_ERROR: c_int = -2;\n151\tpub const Z_DATA_ERROR: c_int = -3;\n152\tpub const Z_MEM_ERROR: c_int = -4;\n153\tpub const Z_BUF_ERROR: c_int = -5;\n154\tpub const Z_VERSION_ERROR: c_int = -6;\n155\t\n156\tpub const Z_NO_COMPRESSION: c_int = 0;\n157\tpub const Z_BEST_SPEED: c_int = 1;\n158\tpub const Z_BEST_COMPRESSION: c_int = 9;\n159\tpub const Z_DEFAULT_COMPRESSION: c_int = -1;\n160\t\n161\tpub const Z_FILTERED: c_int = 1;\n162\tpub const Z_HUFFMAN_ONLY: c_int = 2;\n163\tpub const Z_RLE: c_int = 3;\n164\tpub const Z_FIXED: c_int = 4;\n165\tpub const Z_DEFAULT_STRATEGY: c_int = 0;\n166\t\n167\tpub const Z_BINARY: c_int = 0;\n168\tpub const Z_TEXT: c_int = 1;\n169\tpub const Z_UNKNOWN: c_int = 2;\n170\t\n171\tpub const Z_DEFLATED: c_int = 8;\n172\t\n173\tpub const ZLIB_VERNUM: c_int = 0x12b0;\n174\t\n175\tpub const ZLIB_VERSION: &[u8] = b\"1.2.11\\0\";\n176\t\n177\tpub const MAX_WBITS: c_int = 15;\n178\tpub const MAX_MEM_LEVEL: c_int = 9;\n179\t\n180\t/// `(uInt)-1`\n181\tpub const ZLIB_IO_MAX: uInt = u32::MAX;\n182\t\n183\t#[link(name = \"z\")]\n184\textern \"C\" {\n185\t    pub fn deflateInit2_(\n186\t        strm: z_streamp,\n187\t        level: c_int,\n188\t        method: c_int,\n189\t        windowBits: c_int,\n190\t        memLevel: c_int,\n191\t        strategy: c_int,\n192\t        version: *const c_char,\n193\t        stream_size: c_int,\n194\t    ) -> c_int;\n195\t    pub fn deflate(strm: z_streamp, flush: c_int) -> c_int;\n196\t    pub fn deflateEnd(strm: z_streamp) -> c_int;\n197\t    pub fn deflateReset(strm: z_streamp) -> c_int;\n198\t    pub fn deflateBound(strm: z_streamp, sourceLen: uLong) -> uLong;\n199\t\n200\t    pub fn inflateInit2_(\n201\t        strm: z_streamp,\n202\t        windowBits: c_int,\n203\t        version: *const c_char,\n204\t        stream_size: c_int,\n205\t    ) -> c_int;\n206\t    pub fn inflate(strm: z_streamp, flush: c_int) -> c_int;\n207\t    pub fn inflateEnd(strm: z_streamp) -> c_int;\n208\t    pub fn inflateReset(strm: z_streamp) -> c_int;\n209\t    pub fn inflateReset2(strm: z_streamp, windowBits: c_int) -> c_int;\n210\t    pub fn inflateValidate(strm: z_streamp, check: c_int) -> c_int;\n211\t\n212\t    pub fn crc32(crc: uLong, buf: *const Bytef, len: uInt) -> uLong;\n213\t    pub fn zlibVersion() -> *const c_char;\n214\t    pub fn zError(err: c_int) -> *const c_char;\n215\t}\n216\t\n217\t/// `deflateInit2(strm, level, method, windowBits, memLevel, strategy)`\n218\t#[inline]\n219\tpub unsafe fn deflateInit2(\n220\t    strm: z_streamp,\n221\t    level: c_int,\n222\t    method: c_int,\n223\t    window_bits: c_int,\n224\t    mem_level: c_int,\n225\t    strategy: c_int,\n226\t) -> c_int {\n227\t    deflateInit2_(\n228\t        strm,\n229\t        level,\n230\t        method,\n231\t        window_bits,\n232\t        mem_level,\n233\t        strategy,\n234\t        ZLIB_VERSION.as_ptr() as *const c_char,\n235\t        core::mem::size_of::<z_stream>() as c_int,\n236\t    )\n237\t}\n238\t\n239\t/// `inflateInit2(strm, windowBits)`\n240\t#[inline]\n241\tpub unsafe fn inflateInit2(strm: z_streamp, window_bits: c_int) -> c_int {\n242\t    inflateInit2_(\n243\t        strm,\n244\t        window_bits,\n245\t        ZLIB_VERSION.as_ptr() as *const c_char,\n246\t        core::mem::size_of::<z_stream>() as c_int,\n247\t    )\n248\t}\n249\t"}]},"parent_tool_use_id":"toolu_bdrk_013gtJt8UKYH4mKiZtEsPNHk","session_id":"d9f98909-8564-4f94-b720-603696df3aad","uuid":"cd391db8-0992-4e99-ac7f-8ae4b71cdc18","timestamp":"2026-08-22T20:23:12.619Z","subagent_type":"general-purpose","task_description":"Translate png.c 2930-3355"}
