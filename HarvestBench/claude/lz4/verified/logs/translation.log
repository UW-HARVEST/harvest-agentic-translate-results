);\n  size_t (*cFrame)(void*,size_t,const void*,size_t,const PR*)=S(\"LZ4F_compressFrame\");\n  size_t (*createCctx)(void**,unsigned)=S(\"LZ4F_createCompressionContext\");\n  void* (*createCctxAdv)(CMEM,unsigned)=S(\"LZ4F_createCompressionContext_advanced\");\n  size_t (*freeCctx)(void*)=S(\"LZ4F_freeCompressionContext\");\n  size_t (*cBegin)(void*,void*,size_t,const PR*)=S(\"LZ4F_compressBegin\");\n  size_t (*cBeginDict)(void*,void*,size_t,const void*,size_t,const PR*)=S(\"LZ4F_compressBegin_usingDict\");\n  size_t (*cBeginDictOnce)(void*,void*,size_t,const void*,size_t,const PR*)=S(\"LZ4F_compressBegin_usingDictOnce\");\n  size_t (*cBeginCDict)(void*,void*,size_t,const void*,const PR*)=S(\"LZ4F_compressBegin_usingCDict\");\n  size_t (*cBeginInternal)(void*,void*,size_t,const void*,size_t,const void*,const PR*)=S(\"LZ4F_compressBegin_internal\");\n  size_t (*cUpdate)(void*,void*,size_t,const void*,size_t,const COPT*)=S(\"LZ4F_compressUpdate\");\n  size_t (*uUpdate)(void*,void*,size_t,const void*,size_t,const COPT*)=S(\"LZ4F_uncompressedUpdate\");\n  size_t (*cFlush)(void*,void*,size_t,const COPT*)=S(\"LZ4F_flush\");\n  size_t (*cEnd)(void*,void*,size_t,const COPT*)=S(\"LZ4F_compressEnd\");\n  size_t (*createDctx)(void**,unsigned)=S(\"LZ4F_createDecompressionContext\");\n  void* (*createDctxAdv)(CMEM,unsigned)=S(\"LZ4F_createDecompressionContext_advanced\");\n  size_t (*freeDctx)(void*)=S(\"LZ4F_freeDecompressionContext\");\n  void (*resetDctx)(void*)=S(\"LZ4F_resetDecompressionContext\");\n  size_t (*hSize)(const void*,size_t)=S(\"LZ4F_headerSize\");\n  size_t (*getFI)(void*,FI*,const void*,size_t*)=S(\"LZ4F_getFrameInfo\");\n  size_t (*fdec)(void*,void*,size_t*,const void*,size_t*,const DOPT*)=S(\"LZ4F_decompress\");\n  size_t (*fdecud)(void*,void*,size_t*,const void*,size_t*,const void*,size_t,const DOPT*)=S(\"LZ4F_decompress_usingDict\");\n  void* (*createCDict)(const void*,size_t)=S(\"LZ4F_createCDict\");\n  void* (*createCDictAdv)(CMEM,const void*,size_t)=S(\"