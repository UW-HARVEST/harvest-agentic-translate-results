*,char*,int,int,int,const char*,int)=S(\"LZ4_decompress_safe_partial_usingDict\");\n  int (*dfe)(const char*,char*,int,int,const void*,size_t)=S(\"LZ4_decompress_safe_forceExtDict\");\n  int (*dpfe)(const char*,char*,int,int,int,const void*,size_t)=S(\"LZ4_decompress_safe_partial_forceExtDict\");\n  int (*dprefix)(const char*,char*,int,int)=S(\"LZ4_decompress_safe_withPrefix64k\");\n\n  /* ============ corrupt / malformed block decoding ============ */\n  for(int kind=0;kind<8;kind++){\n    static const int ns[]={20,100,1000,20000,70000};\n    for(unsigned si=0;si<sizeof(ns)/sizeof(ns[0]);si++){\n      int n=ns[si]; gen(kind,SRC,(size_t)n);\n      int c=cdef((const char*)SRC,(char*)DST,n,cbound(n));\n      if(c<=0) continue;\n      /* flip bytes at many positions */\n      for(int pos=0; pos<c; pos += (c/23>0?c/23:1)){\n        for(int bit=0; bit<8; bit+=3){\n          unsigned char save=DST[pos]; DST[pos]^= (unsigned char)(1u<<bit);\n          int d=dsafe((const char*)DST,(char*)DEC,c,n);\n          sprintf(lbl,\"corrupt k%d n%d p%d b%d\",kind,n,pos,bit); emiti(lbl,d);\n          if(d>0){ sprintf(lbl,\"corrupt.d k%d n%d p%d b%d\",kind,n,pos,bit); emit(lbl,DEC,d); }\n          int d2=dpart((const char*)DST,(char*)DEC,c,n/2,n);\n          sprintf(lbl,\"corruptp k%d n%d p%d b%d\",kind,n,pos,bit); emiti(lbl,d2);\n          if(d2>0){ sprintf(lbl,\"corruptp.d k%d n%d p%d b%d\",kind,n,pos,bit); emit(lbl,DEC,d2); }\n          int d3=dsafe((const char*)DST,(char*)DEC,c,n*2);\n          sprintf(lbl,\"corruptbig k%d n%d p%d b%d\",kind,n,pos,bit); emiti(lbl,d3);\n          /* usingDict variants */\n          gen((kind+2)%8,DICT,40000);\n          int d4=dusing((const char*)DST,(char*)DEC,c,n,(const char*)DICT,40000);\n          sprintf(lbl,\"corruptdict k%d n%d p%d b%d\",kind,n,pos,bit); emiti(lbl,d4);\n          int d5=dpartusing((const char*)DST,(char*)DEC,c,n/3,n,(const char*)DICT,40000);\n          sprintf(lbl,\"corruptdictp k%d n%d p%d b%d\",kind,n,pos,bit); emiti(lbl,d5);\n          int d6=dfe((const char*)DST,(char*)DEC,c,n,DICT,40000);\n          sprintf(lbl,\"corruptfe k%d n%d p%d b%d\",kind,n,pos,bit); emiti(lbl,d6);\n          int d7=dpfe((const char*)DST,(char*)DEC,c,n/2,n,DICT,40000);\n          sprintf(lbl,\"corruptpfe k%d n%d p%d b%d\",kind,n,pos,bit); emiti(lbl,d7);\n          DST[pos]=save;\n        }\n      }\n      /* truncated compressed sizes */\n      for(int cs=0; cs<=c; cs += (c/17>0?c/17:1)){\n        int d=dsafe((const char*)DST,(char*)DEC,cs,n);\n        sprintf(lbl,\"trunc k%d n%d cs%d\",kind,n,cs); emiti(lbl,d);\n        int d2=dpart((const char*)DST,(char*)DEC,cs,n,n);\n        sprintf(lbl,\"truncp k%d n%d cs%d\",kind,n,cs); emiti(lbl,d2);\n        if(d2>0){ sprintf(lbl,\"truncp.d k%d n%d cs%d\",kind,n,cs); emit(lbl,DEC,d2); }\n      }\n    }\n  }\n  /* pure random \"compressed\" data */\n  for(int t=0;t<400;t++){\n    rngstate = 777u+t;\n    int c = 4 + (int)(rnd()%400);\n    for(int i=0;i<c;i++) DST[i]=(unsigned char)rnd();\n    for(int cap=0; cap<=2048; cap = cap? cap*4 : 1){\n      int d=dsafe((const char*)DST,(char*)DEC,c,cap);\n      sprintf(lbl,\"rnd t%d c%d cap%d\",t,c,cap); emiti(lbl,d);\n      if(d>0){ sprintf(lbl,\"rnd.d t%d c%d cap%d\",t,c,cap); emit(lbl,DEC,d); }\n      int d2=dpart((const char*)DST,(char*)DEC,c,cap/2,cap);\n      sprintf(lbl,\"rndp t%d c%d cap%d\",t,c,cap); emiti(lbl,d2);\n      if(d2>0){ sprintf(lbl,\"rndp.d t%d c%d cap%d\",t,c,cap); emit(lbl,DEC,d2); }\n      gen(2,DICT,30000);\n      int d3=dusing((const char*)DST,(char*)DEC,c,cap,(const char*)DICT,30000);\n      sprintf(lbl,\"rndd t%d c%d cap%d\",t,c,cap); emiti(lbl,d3);\n      int d4=dprefix((const char*)DST,(char*)DEC+65536,c,cap);\n      sprintf(lbl,\"rndpfx t%d c%d cap%d\",t,c,cap); emiti(lbl,d4);\n    }\n  }\n\n  /* ============ ring buffer streaming decode ============ */\n  {\n    void* (*createStream)(void)=S(\"LZ4_createStream\");\n    int (*freeStream)(void*)=S(\"LZ4_freeStream\");\n    int (*ccont)(void*,const char*,char*,int,int,int)=S(\"LZ4_compress_fast_continue\");\n    void* (*createSD)(void)=S(\"LZ4_createStreamDecode\");\n    int (*freeSD)(void*)=S(\"LZ4_freeStreamDecode\");\n    int (*dcont)(void*,const char*,char*,int,int)=S(\"LZ4_decompress_safe_continue\");\n    int (*dfcont)(void*,const char*,char*,int)=S(\"LZ4_decompress_fast_continue\");\n    int (*ringsz)(int)=S(\"LZ4_decoderRingBufferSize\");\n    for(int kind=0;kind<8;kind++){\n      for(int blk=1024; blk<=32768; blk*=4){\n        int rbs = ringsz(blk);\n        if(rbs<=0 || (size_t)rbs>sizeof(RING)) continue;\n        int total=200000; gen(kind,SRC,(size_t)total);\n        /* compress side: source ring */\n        static unsigned char SRING[400000];\n        void* cs=createStream(); void* sd=createSD();\n        int spos=0, dpos=0, off=0;\n        long long okall=1;\n        while(off<total){\n          int csz = (off+blk<=total)?blk:(total-off);\n          if(spos+csz > rbs){ spos=0; }\n          memcpy(SRING+spos, SRC+off, (size_t)csz);\n          int r=ccont(cs,(const char*)SRING+spos,(char*)DST,csz,cbound(csz),1);\n          sprintf(lbl,\"ring.c k%d b%d off%d r%d\",kind,blk,off,r); emit(lbl,DST,r>0?r:0);\n          if(r<=0){okall=0;break;}\n          if(dpos+blk > rbs){ dpos=0; }\n          int d=dcont(sd,(const char*)DST,(char*)RING+dpos,r,blk);\n          sprintf(lbl,\"ring.d k%d b%d off%d d%d\",kind,blk,off,d); emiti(lbl,d);\n          if(d!=csz){okall=0;}\n          if(d>0 && memcmp(RING+dpos, SRC+off, (size_t)d)!=0) okall=0;\n          if(d>0) dpos+=d;\n          spos+=csz; off+=csz;\n        }\n        sprintf(lbl,\"ring.ok k%d b%d\",kind,blk); emiti(lbl,okall);\n        freeSD(sd); freeStream(cs);\n        /* fast continue over a ring */\n        void* cs2=createStream(); void* sd2=createSD();\n        spos=0;dpos=0;off=0; okall=1;\n        while(off<total){\n          int csz=(off+blk<=total)?blk:(total-off);\n          if(spos+csz>rbs) spos=0;\n          memcpy(SRING+spos,SRC+off,(size_t)csz);\n          int r=ccont(cs2,(const char*)SRING+spos,(char*)DST,csz,cbound(csz),1);\n          if(r<=0){okall=0;break;}\n          if(dpos+blk>rbs) dpos=0;\n          int d=dfcont(sd2,(const char*)DST,(char*)RING+dpos,csz);\n          sprintf(lbl,\"ringf.d k%d b%d off%d d%d\",kind,blk,off,d); emiti(lbl,d);\n          if(d<=0){okall=0;break;}\n          if(memcmp(RING+dpos,SRC+off,(size_t)csz)!=0) okall=0;\n          dpos+=csz; spos+=csz; off+=csz;\n        }\n        sprintf(lbl,\"ringf.ok k%d b%d\",kind,blk); emiti(lbl,okall);\n        freeSD(sd2); freeStream(cs2);\n      }\n    }\n  }\n\n  /* ============ overlapping input/dictionary space ============ */\n  {\n    void* (*createStream)(void)=S(\"LZ4_createStream\");\n    int (*freeStream)(void*)=S(\"LZ4_freeStream\");\n    int (*loadDict)(void*,const char*,int)=S(\"LZ4_loadDict\");\n    int (*ccont)(void*,const char*,char*,int,int,int)=S(\"LZ4_compress_fast_continue\");\n    void* (*createHC)(void)=S(\"LZ4_createStreamHC\");\n    int (*freeHC)(void*)=S(\"LZ4_freeStreamHC\");\n    int (*loadDictHC)(void*,const char*,int)=S(\"LZ4_loadDictHC\");\n    int (*hccont)(void*,const char*,char*,int,int)=S(\"LZ4_compress_HC_continue\");\n    void (*setlvl)(void*,int)=S(\"LZ4_setCompressionLevel\");\n    gen(2,SRC,MAXN);\n    for(int shift=-70000; shift<=70000; shift+=17000){\n      for(int dsz=1000; dsz<=70000; dsz*=7){\n        unsigned char* dictp = SRC + 100000;\n        unsigned char* srcp = dictp + shift;\n        if(srcp < SRC || srcp+20000 > SRC+MAXN) continue;\n        void* st=createStream(); loadDict(st,(const char*)dictp,dsz);\n        int c=ccont(st,(const char*)srcp,(char*)DST,20000,cbound(20000),1);\n        sprintf(lbl,\"ovl sh%d d%d r%d\",shift,dsz,c); emit(lbl,DST,c>0?c:0);\n        freeStream(st);\n        for(int lvl=2;lvl<=12;lvl+=5){\n          void* h=createHC(); setlvl(h,lvl); loadDictHC(h,(const char*)dictp,dsz);\n          int c2=hccont(h,(const char*)srcp,(char*)DST,20000,cbound(20000));\n          sprintf(lbl,\"ovlhc sh%d d%d l%d r%d\",shift,dsz,lvl,c2); emit(lbl,DST,c2>0?c2:0);\n          freeHC(h);\n        }\n      }\n    }\n  }\n\n  /* ============ HC level 2/3 (lz4mid) with dict + attach ============ */\n  {\n    void* (*createHC)(void)=S(\"LZ4_createStreamHC\");\n    int (*freeHC)(void*)=S(\"LZ4_freeStreamHC\");\n    int (*loadDictHC)(void*,const char*,int)=S(\"LZ4_loadDictHC\");\n    void (*attachHC)(void*,const void*)=S(\"LZ4_attach_HC_dictionary\");\n    int (*hccont)(void*,const char*,char*,int,int)=S(\"LZ4_compress_HC_continue\");\n    int (*hccontds)(void*,const char*,char*,int*,int)=S(\"LZ4_compress_HC_continue_destSize\");\n    void (*setlvl)(void*,int)=S(\"LZ4_setCompressionLevel\");\n    int (*savehc)(void*,char*,int)=S(\"LZ4_saveDictHC\");\n    for(int kind=0;kind<8;kind++){\n      for(int dlvl=2; dlvl<=12; dlvl+=2){\n        for(int wlvl=2; wlvl<=12; wlvl+=2){\n          int dsz=65000; gen((kind+4)%8,DICT,(size_t)dsz);\n          int n=60000; gen(kind,SRC,(size_t)n);\n          void* dct=createHC(); setlvl(dct,dlvl); loadDictHC(dct,(const char*)DICT,dsz);\n          void* w=createHC(); setlvl(w,wlvl); attachHC(w,dct);\n          int c=hccont(w,(const char*)SRC,(char*)DST,n,cbound(n));\n          sprintf(lbl,\"mid.att k%d dl%d wl%d r%d\",kind,dlvl,wlvl,c); emit(lbl,DST,c>0?c:0);\n          void* w2=createHC(); setlvl(w2,wlvl); attachHC(w2,dct);\n          int c2=hccont(w2,(const char*)SRC,(char*)DST,3000,cbound(3000));\n          sprintf(lbl,\"mid.att.sm k%d dl%d wl%d r%d\",kind,dlvl,wlvl,c2); emit(lbl,DST,c2>0?c2:0);\n          void* w3=createHC(); setlvl(w3,wlvl); attachHC(w3,dct);\n          int sz=n; int c3=hccontds(w3,(const char*)SRC,(char*)DST,&sz,n/4);\n          sprintf(lbl,\"mid.att.ds k%d dl%d wl%d r%d s%d\",kind,dlvl,wlvl,c3,sz); emit(lbl,DST,c3>0?c3:0);\n          /* multi-block continue with mid */\n          void* w4=createHC(); setlvl(w4,wlvl); loadDictHC(w4,(const char*)DICT,dsz);\n          int coff=0;\n          for(int o=0;o<n;o+=7000){ int cs=(o+7000<=n)?7000:(n-o);\n            int r=hccont(w4,(const char*)SRC+o,(char*)DST+coff,cs,cbound(cs));\n            sprintf(lbl,\"mid.ml k%d dl%d wl%d o%d r%d\",kind,dlvl,wlvl,o,r); emit(lbl,DST+coff,r>0?r:0);\n            if(r<=0)break; coff+=r; }\n          { unsigned char sb[70000]; int sr=savehc(w4,(char*)sb,65536);\n            sprintf(lbl,\"mid.sv k%d dl%d wl%d\",kind,dlvl,wlvl); emiti(lbl,sr);\n            if(sr>0){sprintf(lbl,\"mid.svd k%d dl%d wl%d\",kind,dlvl,wlvl); emit(lbl,sb,sr);} }\n          freeHC(w);freeHC(w2);freeHC(w3);freeHC(w4);freeHC(dct);\n        }\n      }\n    }\n  }\n\n  /* ============ LZ4F custom allocators ============ */\n  {\n    unsigned (*isError)(size_t)=S(\"LZ4F_isError\");\n    void* (*createCctxAdv)(CMEM,unsigned)=S(\"LZ4F_createCompressionContext_advanced\");\n    void* (*createDctxAdv)(CMEM,unsigned)=S(\"LZ4F_createDecompressionContext_advanced\");\n    void* (*createCDictAdv)(CMEM,const void*,size_t)=S(\"LZ4F_createCDict_advanced\");\n    void (*freeCDict)(void*)=S(\"LZ4F_freeCDict\");\n    size_t (*freeCctx)(void*)=S(\"LZ4F_freeCompressionContext\");\n    size_t (*freeDctx)(void*)=S(\"LZ4F_freeDecompressionContext\");\n    size_t (*cFrameCDict)(void*,void*,size_t,const void*,size_t,const void*,const PR*)=S(\"LZ4F_compressFrame_usingCDict\");\n    size_t (*fdec)(void*,void*,size_t*,const void*,size_t*,const DOPT*)=S(\"LZ4F_decompress\");\n    size_t (*cBegin)(void*,void*,size_t,const PR*)=S(\"LZ4F_compressBegin\");\n    size_t (*cUpdate)(void*,void*,size_t,const void*,size_t,const COPT*)=S(\"LZ4F_compressUpdate\");\n    size_t (*cEnd)(void*,void*,size_t,const COPT*)=S(\"LZ4F_compressEnd\");\n\n    for(int variant=0; variant<4; variant++){\n      CMEM cm; memset(&cm,0,sizeof(cm));\n      if(variant&1){ cm.a=myAlloc; cm.f=myFree; }\n      if(variant&2){ cm.c=myCalloc; cm.f=myFree; if(!(variant&1)) cm.a=myAlloc; }\n      cm.o=(void*)0x1234;\n      allocCount=freeCount=callocCount=0;\n      int n=120000; gen(3,SRC,(size_t)n); gen(5,DICT,65000);\n      void* cctx=createCctxAdv(cm,100);\n      emiti(\"cm.cctx\",(long long)(cctx!=NULL));\n      void* cd=createCDictAdv(cm,DICT,65000);\n      emiti(\"cm.cdict\",(long long)(cd!=NULL));\n      PR p; memset(&p,0,sizeof(p)); p.frameInfo.blockSizeID=5; p.frameInfo.contentChecksumFlag=1;\n      p.compressionLevel=9;\n      size_t r=cFrameCDict(cctx,DST,sizeof(DST),SRC,(size_t)n,cd,&p);\n      sprintf(lbl,\"cm.frame v%d r%zu e%u\",variant,r,isError(r)); emit(lbl,DST,isError(r)?0:(long)r);\n      void* dctx=createDctxAdv(cm,100);\n      size_t dsz=sizeof(DEC), ssz=r;\n      size_t hh=fdec(dctx,DEC,&dsz,DST,&ssz,NULL);\n      fprintf(OUT,\"cm.dec v%d=%zu e%u dsz=%zu ok=%d\\n\",variant,hh,isError(hh),dsz,(int)(dsz==(size_t)n&&memcmp(DEC,SRC,(size_t)n)==0));\n      /* streaming with custom mem, HC and fast */\n      for(int lvl=0;lvl<=12;lvl+=6){\n        void* c2=createCctxAdv(cm,100);\n        PR p2; memset(&p2,0,sizeof(p2)); p2.compressionLevel=lvl; p2.frameInfo.blockSizeID=4;\n        size_t off=cBegin(c2,DST,sizeof(DST),&p2);\n        if(!isError(off)){ size_t w=cUpdate(c2,DST+off,sizeof(DST)-off,SRC,(size_t)n,NULL);\n          if(!isError(w)){ off+=w; size_t e=cEnd(c2,DST+off,sizeof(DST)-off,NULL); if(!isError(e)) off+=e;\n            sprintf(lbl,\"cm.stream v%d l%d\",variant,lvl); emit(lbl,DST,(long)off); } }\n        freeCctx(c2);\n      }\n      freeDctx(dctx); freeCDict(cd); freeCctx(cctx);\n      fprintf(OUT,\"cm.counts v%d alloc>0=%d calloc>0=%d free>0=%d\\n\",variant,(int)(allocCount>0),(int)(callocCount>0),(int)(freeCount>0));\n    }\n  }\n\n  /* ============ LZ4F level 2 (mid) frames ============ */\n  {\n    unsigned (*isError)(size_t)=S(\"LZ4F_isError\");\n    size_t (*cFrame)(void*,size_t,const void*,size_t,const PR*)=S(\"LZ4F_compressFrame\");\n    size_t (*createDctx)(void**,unsigned)=S(\"LZ4F_createDecompressionContext\");\n    size_t (*freeDctx)(void*)=S(\"LZ4F_freeDecompressionContext\");\n    size_t (*fdec)(void*,void*,size_t*,const void*,size_t*,const DOPT*)=S(\"LZ4F_decompress\");\n    size_t (*cfBound)(size_t,const PR*)=S(\"LZ4F_compressFrameBound\");\n    for(int kind=0;kind<8;kind++){\n      static const int ns[]={0,1,100,65536,150000};\n      for(unsigned si=0;si<sizeof(ns)/sizeof(ns[0]);si++){\n        int n=ns[si]; gen(kind,SRC,(size_t)n);\n        for(int lvl=2;lvl<=3;lvl++) for(int bm=0;bm<2;bm++) for(int bs=4;bs<=6;bs++){\n          PR p; memset(&p,0,sizeof(p)); p.compressionLevel=lvl; p.frameInfo.blockMode=bm;\n          p.frameInfo.blockSizeID=bs; p.frameInfo.contentChecksumFlag=1; p.frameInfo.blockChecksumFlag=1;\n          size_t r=cFrame(DST,cfBound((size_t)n,&p),SRC,(size_t)n,&p);\n          sprintf(lbl,\"F2 k%d n%d l%d bm%d bs%d r%zu e%u\",kind,n,lvl,bm,bs,r,isError(r));\n          emit(lbl,DST,isError(r)?0:(long)r);\n          if(!isError(r)){ void* d=NULL; createDctx(&d,100); size_t dsz=sizeof(DEC),ssz=r;\n            size_t hh=fdec(d,DEC,&dsz,DST,&ssz,NULL);\n            fprintf(OUT,\"F2.dec=%zu e%u ok=%d\\n\",hh,isError(hh),(int)(dsz==(size_t)n&&memcmp(DEC,SRC,(size_t)n)==0));\n            freeDctx(d); }\n        }\n      }\n    }\n  }\n\n  fclose(OUT); dlclose(H); return 0;\n}\nEOF\ncd $TMPDIR/t && gcc -O1 -o h4 harness4.c -ldl 2>&1 | grep -E \"error\" | head -20; echo compiled","description":"Write and compile harness part 4"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":477955,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":477955,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"feb0e4b7-e1e6-4ecc-bec4-a0d1cc57672e","uuid":"5cc5ad2f-3b89-4165-a62e-cbf6b563d4e8","timestamp":"2026-08-22T21:37:00.555Z"}
