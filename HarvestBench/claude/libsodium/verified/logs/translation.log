{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CA8hyPPZiav6uk26JTVHYr","type":"tool_result","content":"1\t/*\n2\t * Argon2 source code package\n3\t *\n4\t * Written by Daniel Dinu and Dmitry Khovratovich, 2015\n5\t *\n6\t * This work is licensed under a Creative Commons CC0 1.0 License/Waiver.\n7\t *\n8\t * You should have received a copy of the CC0 Public Domain Dedication along\n9\t * with this software. If not, see\n10\t * <http://creativecommons.org/publicdomain/zero/1.0/>.\n11\t */\n12\t#ifndef argon2_H\n13\t#define argon2_H\n14\t\n15\t#include <limits.h>\n16\t#include <stddef.h>\n17\t#include <stdint.h>\n18\t\n19\t#include \"private/quirks.h\"\n20\t\n21\t/*\n22\t * Argon2 input parameter restrictions\n23\t */\n24\t\n25\t/* Minimum and maximum number of lanes (degree of parallelism) */\n26\t#define ARGON2_MIN_LANES UINT32_C(1)\n27\t#define ARGON2_MAX_LANES UINT32_C(0xFFFFFF)\n28\t\n29\t/* Minimum and maximum number of threads */\n30\t#define ARGON2_MIN_THREADS UINT32_C(1)\n31\t#define ARGON2_MAX_THREADS UINT32_C(0xFFFFFF)\n32\t\n33\t/* Number of synchronization points between lanes per pass */\n34\t#define ARGON2_SYNC_POINTS UINT32_C(4)\n35\t\n36\t/* Minimum and maximum digest size in bytes */\n37\t#define ARGON2_MIN_OUTLEN UINT32_C(16)\n38\t#define ARGON2_MAX_OUTLEN UINT32_C(0xFFFFFFFF)\n39\t\n40\t/* Minimum and maximum number of memory blocks (each of BLOCK_SIZE bytes) */\n41\t#define ARGON2_MIN_MEMORY (2 * ARGON2_SYNC_POINTS) /* 2 blocks per slice */\n42\t\n43\t#define ARGON2_MIN(a, b) ((a) < (b) ? (a) : (b))\n44\t/* Max memory size is half the addressing space, topping at 2^32 blocks (4 TB)\n45\t */\n46\t#define ARGON2_MAX_MEMORY_BITS \\\n47\t    ARGON2_MIN(UINT32_C(32), (sizeof(void *) * CHAR_BIT - 10 - 1))\n48\t#define ARGON2_MAX_MEMORY \\\n49\t    ARGON2_MIN(UINT32_C(0xFFFFFFFF), UINT64_C(1) << ARGON2_MAX_MEMORY_BITS)\n50\t\n51\t/* Minimum and maximum number of passes */\n52\t#define ARGON2_MIN_TIME UINT32_C(1)\n53\t#define ARGON2_MAX_TIME UINT32_C(0xFFFFFFFF)\n54\t\n55\t/* Minimum and maximum password length in bytes */\n56\t#define ARGON2_MIN_PWD_LENGTH UINT32_C(0)\n57\t#define ARGON2_MAX_PWD_LENGTH UINT32_C(0xFFFFFFFF)\n58\t\n59\t/* Minimum and maximum associated data length in bytes */\n60\t#define ARGON2_MIN_AD_LENGTH UINT32_C(0)\n61\t#define ARGON2_MAX_AD_LENGTH UINT32_C(0xFFFFFFFF)\n62\t\n63\t/* Minimum and maximum salt length in bytes */\n64\t#define ARGON2_MIN_SALT_LENGTH UINT32_C(8)\n65\t#define ARGON2_MAX_SALT_LENGTH UINT32_C(0xFFFFFFFF)\n66\t\n67\t/* Minimum and maximum key length in bytes */\n68\t#define ARGON2_MIN_SECRET UINT32_C(0)\n69\t#define ARGON2_MAX_SECRET UINT32_C(0xFFFFFFFF)\n70\t\n71\t#define ARGON2_FLAG_CLEAR_PASSWORD (UINT32_C(1) << 0)\n72\t#define ARGON2_FLAG_CLEAR_SECRET (UINT32_C(1) << 1)\n73\t#define ARGON2_DEFAULT_FLAGS (UINT32_C(0))\n74\t\n75\t/* Error codes */\n76\ttypedef enum Argon2_ErrorCodes {\n77\t    ARGON2_OK = 0,\n78\t\n79\t    ARGON2_OUTPUT_PTR_NULL = -1,\n80\t\n81\t    ARGON2_OUTPUT_TOO_SHORT = -2,\n82\t    ARGON2_OUTPUT_TOO_LONG  = -3,\n83\t\n84\t    ARGON2_PWD_TOO_SHORT = -4,\n85\t    ARGON2_PWD_TOO_LONG  = -5,\n86\t\n87\t    ARGON2_SALT_TOO_SHORT = -6,\n88\t    ARGON2_SALT_TOO_LONG  = -7,\n89\t\n90\t    ARGON2_AD_TOO_SHORT = -8,\n91\t    ARGON2_AD_TOO_LONG  = -9,\n92\t\n93\t    ARGON2_SECRET_TOO_SHORT = -10,\n94\t    ARGON2_SECRET_TOO_LONG  = -11,\n95\t\n96\t    ARGON2_TIME_TOO_SMALL = -12,\n97\t    ARGON2_TIME_TOO_LARGE = -13,\n98\t\n99\t    ARGON2_MEMORY_TOO_LITTLE = -14,\n100\t    ARGON2_MEMORY_TOO_MUCH   = -15,\n101\t\n102\t    ARGON2_LANES_TOO_FEW  = -16,\n103\t    ARGON2_LANES_TOO_MANY = -17,\n104\t\n105\t    ARGON2_PWD_PTR_MISMATCH    = -18, /* NULL ptr with non-zero length */\n106\t    ARGON2_SALT_PTR_MISMATCH   = -19, /* NULL ptr with non-zero length */\n107\t    ARGON2_SECRET_PTR_MISMATCH = -20, /* NULL ptr with non-zero length */\n108\t    ARGON2_AD_PTR_MISMATCH     = -21, /* NULL ptr with non-zero length */\n109\t\n110\t    ARGON2_MEMORY_ALLOCATION_ERROR = -22,\n111\t\n112\t    ARGON2_FREE_MEMORY_CBK_NULL     = -23,\n113\t    ARGON2_ALLOCATE_MEMORY_CBK_NULL = -24,\n114\t\n115\t    ARGON2_INCORRECT_PARAMETER = -25,\n116\t    ARGON2_INCORRECT_TYPE      = -26,\n117\t\n118\t    ARGON2_OUT_PTR_MISMATCH = -27,\n119\t\n120\t    ARGON2_THREADS_TOO_FEW  = -28,\n121\t    ARGON2_THREADS_TOO_MANY = -29,\n122\t\n123\t    ARGON2_MISSING_ARGS = -30,\n124\t\n125\t    ARGON2_ENCODING_FAIL = -31,\n126\t\n127\t    ARGON2_DECODING_FAIL = -32,\n128\t\n129\t    ARGON2_THREAD_FAIL = -33,\n130\t\n131\t    ARGON2_DECODING_LENGTH_FAIL = -34,\n132\t\n133\t    ARGON2_VERIFY_MISMATCH = -35\n134\t} argon2_error_codes;\n135\t\n136\t/* Argon2 external data structures */\n137\t\n138\t/*\n139\t * Context: structure to hold Argon2 inputs:\n140\t * output array and its length,\n141\t * password and its length,\n142\t * salt and its length,\n143\t * secret and its length,\n144\t * associated data and its length,\n145\t * number of passes, amount of used memory (in KBytes, can be rounded up a bit)\n146\t * number of parallel threads that will be run.\n147\t * All the parameters above affect the output hash value.\n148\t * Additionally, two function pointers can be provided to allocate and\n149\t * deallocate the memory (if NULL, memory will be allocated internally).\n150\t * Also, three flags indicate whether to erase password, secret as soon as they\n151\t * are pre-hashed (and thus not needed anymore), and the entire memory\n152\t *****\n153\t * Simplest situation: you have output array out[8], password is stored in\n154\t * pwd[32], salt is stored in salt[16], you do not have keys nor associated\n155\t * data.\n156\t * You need to spend 1 GB of RAM and you run 5 passes of Argon2 with 4 parallel\n157\t * lanes.\n158\t * You want to erase the password, but you're OK with last pass not being\n159\t * erased.\n160\t * You want to use the default memory allocator.\n161\t * Then you initialize:\n162\t * Argon2_Context(out,8,pwd,32,salt,16,NULL,0,NULL,0,5,1<<20,4,4,NULL,NULL,true,false,false,false).\n163\t */\n164\ttypedef struct Argon2_Context {\n165\t    uint8_t *out;    /* output array */\n166\t    uint32_t outlen; /* digest length */\n167\t\n168\t    uint8_t *pwd;    /* password array */\n169\t    uint32_t pwdlen; /* password length */\n170\t\n171\t    uint8_t *salt;    /* salt array */\n172\t    uint32_t saltlen; /* salt length */\n173\t\n174\t    uint8_t *secret;    /* key array */\n175\t    uint32_t secretlen; /* key length */\n176\t\n177\t    uint8_t *ad;    /* associated data array */\n178\t    uint32_t adlen; /* associated data length */\n179\t\n180\t    uint32_t t_cost;  /* number of passes */\n181\t    uint32_t m_cost;  /* amount of memory requested (KB) */\n182\t    uint32_t lanes;   /* number of lanes */\n183\t    uint32_t threads; /* maximum number of threads */\n184\t\n185\t    uint32_t flags; /* array of bool options */\n186\t} argon2_context;\n187\t\n188\t/* Argon2 primitive type */\n189\ttypedef enum Argon2_type { Argon2_i = 1, Argon2_id = 2 } argon2_type;\n190\t\n191\t/*\n192\t * Function that performs memory-hard hashing with certain degree of parallelism\n193\t * @param  context  Pointer to the Argon2 internal structure\n194\t * @return Error code if something is wrong, ARGON2_OK otherwise\n195\t */\n196\tint argon2_ctx(argon2_context *context, argon2_type type);\n197\t\n198\t/**\n199\t * Hashes a password with Argon2i, producing an encoded hash\n200\t * @param t_cost Number of iterations\n201\t * @param m_cost Sets memory usage to m_cost kibibytes\n202\t * @param parallelism Number of threads and compute lanes\n203\t * @param pwd Pointer to password\n204\t * @param pwdlen Password size in bytes\n205\t * @param salt Pointer to salt\n206\t * @param saltlen Salt size in bytes\n207\t * @param hashlen Desired length of the hash in bytes\n208\t * @param encoded Buffer where to write the encoded hash\n209\t * @param encodedlen Size of the buffer (thus max size of the encoded hash)\n210\t * @pre   Different parallelism levels will give different results\n211\t * @pre   Returns ARGON2_OK if successful\n212\t */\n213\tint argon2i_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n214\t                         const uint32_t parallelism, const void *pwd,\n215\t                         const size_t pwdlen, const void *salt,\n216\t                         const size_t saltlen, const size_t hashlen,\n217\t                         char *encoded, const size_t encodedlen);\n218\t\n219\t/**\n220\t * Hashes a password with Argon2id, producing an encoded hash\n221\t * @param t_cost Number of iterations\n222\t * @param m_cost Sets memory usage to m_cost kibibytes\n223\t * @param parallelism Number of threads and compute lanes\n224\t * @param pwd Pointer to password\n225\t * @param pwdlen Password size in bytes\n226\t * @param salt Pointer to salt\n227\t * @param saltlen Salt size in bytes\n228\t * @param hashlen Desired length of the hash in bytes\n229\t * @param encoded Buffer where to write the encoded hash\n230\t * @param encodedlen Size of the buffer (thus max size of the encoded hash)\n231\t * @pre   Different parallelism levels will give different results\n232\t * @pre   Returns ARGON2_OK if successful\n233\t */\n234\tint argon2id_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n235\t                          const uint32_t parallelism, const void *pwd,\n236\t                          const size_t pwdlen, const void *salt,\n237\t                          const size_t saltlen, const size_t hashlen,\n238\t                          char *encoded, const size_t encodedlen);\n239\t\n240\t/**\n241\t * Hashes a password with Argon2i, producing a raw hash\n242\t * @param t_cost Number of iterations\n243\t * @param m_cost Sets memory usage to m_cost kibibytes\n244\t * @param parallelism Number of threads and compute lanes\n245\t * @param pwd Pointer to password\n246\t * @param pwdlen Password size in bytes\n247\t * @param salt Pointer to salt\n248\t * @param saltlen Salt size in bytes\n249\t * @param hash Buffer where to write the raw hash\n250\t * @param hashlen Desired length of the hash in bytes\n251\t * @pre   Different parallelism levels will give different results\n252\t * @pre   Returns ARGON2_OK if successful\n253\t */\n254\tint argon2i_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n255\t                     const uint32_t parallelism, const void *pwd,\n256\t                     const size_t pwdlen, const void *salt,\n257\t                     const size_t saltlen, void *hash, const size_t hashlen);\n258\t\n259\t/**\n260\t * Hashes a password with Argon2id, producing a raw hash\n261\t * @param t_cost Number of iterations\n262\t * @param m_cost Sets memory usage to m_cost kibibytes\n263\t * @param parallelism Number of threads and compute lanes\n264\t * @param pwd Pointer to password\n265\t * @param pwdlen Password size in bytes\n266\t * @param salt Pointer to salt\n267\t * @param saltlen Salt size in bytes\n268\t * @param hash Buffer where to write the raw hash\n269\t * @param hashlen Desired length of the hash in bytes\n270\t * @pre   Different parallelism levels will give different results\n271\t * @pre   Returns ARGON2_OK if successful\n272\t */\n273\tint argon2id_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n274\t                      const uint32_t parallelism, const void *pwd,\n275\t                      const size_t pwdlen, const void *salt,\n276\t                      const size_t saltlen, void *hash, const size_t hashlen);\n277\t\n278\t/* generic function underlying the above ones */\n279\tint argon2_hash(const uint32_t t_cost, const uint32_t m_cost,\n280\t                const uint32_t parallelism, const void *pwd,\n281\t                const size_t pwdlen, const void *salt, const size_t saltlen,\n282\t                void *hash, const size_t hashlen, char *encoded,\n283\t                const size_t encodedlen, argon2_type type);\n284\t\n285\t/**\n286\t * Verifies a password against an encoded string\n287\t * Encoded string is restricted as in argon2_validate_inputs()\n288\t * @param encoded String encoding parameters, salt, hash\n289\t * @param pwd Pointer to password\n290\t * @pre   Returns ARGON2_OK if successful\n291\t */\n292\tint argon2i_verify(const char *encoded, const void *pwd, const size_t pwdlen);\n293\t\n294\t/**\n295\t * Verifies a password against an encoded string\n296\t * Encoded string is restricted as in argon2_validate_inputs()\n297\t * @param encoded String encoding parameters, salt, hash\n298\t * @param pwd Pointer to password\n299\t * @pre   Returns ARGON2_OK if successful\n300\t */\n301\tint argon2id_verify(const char *encoded, const void *pwd, const size_t pwdlen);\n302\t\n303\t/* generic function underlying the above ones */\n304\tint argon2_verify(const char *encoded, const void *pwd, const size_t pwdlen,\n305\t                  argon2_type type);\n306\t#endif\n307\t"}]},"parent_tool_use_id":"toolu_bdrk_01MBGqqFdKR4iToyXJ9bSebs","session_id":"548cc808-00d2-470c-b99f-a8d3e7e02fd0","uuid":"d106067d-774a-48d9-b2f9-5cc4a9c643f1","timestamp":"2026-08-22T20:13:12.350Z","subagent_type":"general-purpose","task_description":"Translate Argon2 pwhash"}
