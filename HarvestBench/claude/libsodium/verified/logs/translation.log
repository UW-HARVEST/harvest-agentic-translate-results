,\n39\t        /* p-1 (order 2) */\n40\t        { 0xec, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n41\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n42\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f },\n43\t        /* p (=0, order 4) */\n44\t        { 0xed, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n45\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n46\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f },\n47\t        /* p+1 (=1, order 1) */\n48\t        { 0xee, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n49\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n50\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f }\n51\t    };\n52\t    unsigned char c[7] = { 0 };\n53\t    unsigned int  k;\n54\t    size_t        i, j;\n55\t\n56\t    COMPILER_ASSERT(7 == sizeof blocklist / sizeof blocklist[0]);\n57\t    for (j = 0; j < 31; j++) {\n58\t        for (i = 0; i < sizeof blocklist / sizeof blocklist[0]; i++) {\n59\t            c[i] |= s[j] ^ blocklist[i][j];\n60\t        }\n61\t    }\n62\t    for (i = 0; i < sizeof blocklist / sizeof blocklist[0]; i++) {\n63\t        c[i] |= (s[j] & 0x7f) ^ blocklist[i][j];\n64\t    }\n65\t    k = 0;\n66\t    for (i = 0; i < sizeof blocklist / sizeof blocklist[0]; i++) {\n67\t        k |= (c[i] - 1);\n68\t    }\n69\t    return (int) ((k >> 8) & 1);\n70\t}\n71\t\n72\t#ifdef HAVE_TI_MODE\n73\t/*\n74\t h = f - g\n75\t Unlike fe25519_sub(), this doesn't normalize g first, so the limbs of g\n76\t must not exceed 2^52 - 38. In the ladder below, g is always the direct\n77\t output of fe25519_mul() or fe25519_sq(), whose limbs fit in 52 bits.\n78\t */\n79\tstatic inline void\n80\tfe25519_sub_lazy(fe25519 h, const fe25519 f, const fe25519 g)\n81\t{\n82\t    h[0] = (f[0] + 0xfffffffffffdaULL) - g[0];\n83\t    h[1] = (f[1] + 0xffffffffffffeULL) - g[1];\n8