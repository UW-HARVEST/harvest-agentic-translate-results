n\nstruct misuse_arg {\n    struct aegis *a;\n    int           which;\n};\n\nstatic void\nmisuse_body(void *p)\n{\n    struct misuse_arg *ma = (struct misuse_arg *) p;\n    unsigned char      k[64], npub[64], mac[64], c[64];\n    ull                huge = (1ULL << 61);\n    int                r;\n\n    memset(k, 0, sizeof k);\n    memset(npub, 0, sizeof npub);\n    if (ma->which == 0) {\n        /* mlen > MESSAGEBYTES_MAX -> sodium_misuse() */\n        r = ma->a->encrypt_detached(c, mac, NULL, NULL, huge, NULL, 0, NULL, npub, k);\n    } else {\n        /* adlen > MESSAGEBYTES_MAX -> sodium_misuse() */\n        r = ma->a->encrypt_detached(c, mac, NULL, NULL, 0, NULL, huge, NULL, npub, k);\n    }\n    _exit(r == 0 ? 10 : 11);\n}\n\nstatic void\ntest_misuse(const char *name, struct aegis *C, struct aegis *R)\n{\n    struct misuse_arg ac, ar;\n    int               w;\n    char              ctx[128];\n\n    for (w = 0; w < 2; w++) {\n        int rc, rr;\n        ac.a     = C;\n        ac.which = w;\n        ar.a     = R;\n        ar.which = w;\n        snprintf(ctx, sizeof ctx, \"%s misuse which=%d\", name, w);\n        rc = run_child(misuse_body, &ac);\n        rr = run_child(misuse_body, &ar);\n        CK(rc == rr, \"misuse exit status\", ctx);\n        CK(rc == 128 + 6, \"misuse raises SIGABRT\", ctx);\n        if (rc != rr) {\n            fprintf(stderr, \"  (C=%d R=%d)\\n\", rc, rr);\n        }\n    }\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\ntest_gcm(struct gcm *C, struct gcm *R)\n{\n    unsigned char k[32], npub[12], m[64], ad[64], mac[16], c[128];\n    unsigned char stC[1024] __attribute__((aligned(16)));\n    unsigned char stR[1024] __attribute__((aligned(16)));\n    ull           lc, lr;\n    int           rc, rr;\n    int           ec, er;\n    const char   *ctx = \"aes256gcm\";\n\n    CK(C->keybytes() == R->keybytes() && R->keybytes() == 32, \"gcm keybytes\", ctx);\n    CK(C->nsecbytes() == R->nsecbytes() && R->nsecbytes() == 0, \"gcm nsecbytes\", ctx);\n    CK(C->npubbytes() == R->npubbytes() && R->npubbytes() == 12, \"gcm npubbytes\", ctx);\n    CK(C->abytes() == R->abytes() && R->abytes() == 16, \"gcm abytes\", ctx);\n    CK(C->messagebytes_max() == R->messagebytes_max(), \"gcm messagebytes_max\", ctx);\n    CK(C->statebytes() == R->statebytes(), \"gcm statebytes\", ctx);\n    CK(C->is_available() == R->is_available(), \"gcm is_available\", ctx);\n    CK(R->is_available() == 0, \"gcm is_available == 0\", ctx);\n    fprintf(stderr, \"  gcm statebytes C=%zu R=%zu  messagebytes_max C=%zu R=%zu\\n\",\n            C->statebytes(), R->statebytes(), C->messagebytes_max(), R->messagebytes_max());\n\n    memset(k, 1, sizeof k);\n    memset(npub, 2, sizeof npub);\n    memset(m, 3, sizeof m);\n    memset(ad, 4, sizeof ad);\n    memset(mac, 5, sizeof mac);\n    memset(stC, 0, sizeof stC);\n    memset(stR, 0, sizeof stR);\n\n    /* keygen writes 32 random bytes */\n    memset(k, 0xAA, sizeof k);\n    R->keygen(k);\n    {\n        int allsame = 1;\n        size_t i;\n        for (i = 0; i < 32; i++) {\n            if (k[i] != 0xAA) {\n                allsame = 0;\n            }\n        }\n        CK(!allsame, \"gcm keygen writes key\", ctx);\n    }\n\n#define GCMCALL(label, callC, callR)                     \\\n    do {                                                 \\\n        lc = 999;                                        \\\n        lr = 999;                                        \\\n        errno = 0;                                       \\\n        rc = (callC);                                    \\\n        ec = errno;                                      \\\n        errno = 0;                                       \\\n        rr = (callR);                                    \\\n        er = errno;                                      \\\n        CK(rc == rr, label \" ret\", ctx);                 \\\n        CK(ec == er, label \" errno\", ctx);               \\\n        CK(rc == -1, label \" == -1\", ctx);               \\\n        if (rc != rr || ec != er) {                      \\\n            fprintf(stderr, \"  %s: C ret=%d errno=%d | R ret=%d errno=%d\\n\", label, rc, ec, rr, \\\n                    er);                                 \\\n        }                                                \\\n    } while (0)\n\n    GCMCALL(\"encrypt\",\n            C->encrypt(c, &lc, m, 16, ad, 16, NULL, npub, k),\n            R->encrypt(c, &lr, m, 16, ad, 16, NULL, npub, k));\n    GCMCALL(\"encrypt_detached\",\n            C->encrypt_detached(c, mac, &lc, m, 16, ad, 16, NULL, npub, k),\n            R->encrypt_detached(c, mac, &lr, m, 16, ad, 16, NULL, npub, k));\n    GCMCALL(\"decrypt\",\n            C->decrypt(m, &lc, NULL, c, 32, ad, 16, npub, k),\n            R->decrypt(m, &lr, NULL, c, 32, ad, 16, npub, k));\n    GCMCALL(\"decrypt_detached\",\n            C->decrypt_detached(m, NULL, c, 16, mac, ad, 16, npub, k),\n            R->decrypt_detached(m, NULL, c, 16, mac, ad, 16, npub, k));\n    GCMCALL(\"beforenm\", C->beforenm(stC, k), R->beforenm(stR, k));\n    GCMCALL(\"encrypt_afternm\",\n            C->encrypt_afternm(c, &lc, m, 16, ad, 16, NULL, npub, stC),\n            R->encrypt_afternm(c, &lr, m, 16, ad, 16, NULL, npub, stR));\n    GCMCALL(\"encrypt_detached_afternm\",\n            C->encrypt_detached_afternm(c, mac, &lc, m, 16, ad, 16, NULL, npub, stC),\n            R->encrypt_detached_afternm(c, mac, &lr, m, 16, ad, 16, NULL, npub, stR));\n    GCMCALL(\"decrypt_afternm\",\n            C->decrypt_afternm(m, &lc, NULL, c, 32, ad, 16, npub, stC),\n            R->decrypt_afternm(m, &lr, NULL, c, 32, ad, 16, npub, stR));\n    GCMCALL(\"decrypt_detached_afternm\",\n            C->decrypt_detached_afternm(m, NULL, c, 16, mac, ad, 16, npub, stC),\n            R->decrypt_detached_afternm(m, NULL, c, 16, mac, ad, 16, npub, stR));\n\n    /* also with zero lengths / NULL optional args */\n    GCMCALL(\"encrypt zero\",\n            C->encrypt(c, NULL, NULL, 0, NULL, 0, NULL, npub, k),\n            R->encrypt(c, NULL, NULL, 0, NULL, 0, NULL, npub, k));\n    GCMCALL(\"decrypt zero\",\n            C->decrypt(NULL, NULL, NULL, c, 0, NULL, 0, npub, k),\n            R->decrypt(NULL, NULL, NULL, c, 0, NULL, 0, npub, k));\n#undef GCMCALL\n}\n\nint\nmain(int argc, char **argv)\n{\n    void        *hc, *hr;\n    struct aegis c128, r128, c256, r256;\n    struct gcm   cg, rg;\n\n    if (argc < 3) {\n        fprintf(stderr, \"usage: %s <c.so> <rust.so>\\n\", argv[0]);\n        return 2;\n    }\n    hc = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);\n    if (hc == NULL) {\n        fprintf(stderr, \"dlopen C: %s\\n\", dlerror());\n        return 2;\n    }\n    hr = dlopen(argv[2], RTLD_LAZY | RTLD_LOCAL);\n    if (hr == NULL) {\n        fprintf(stderr, \"dlopen Rust: %s\\n\", dlerror());\n        return 2;\n    }\n\n    load_aegis(&c128, hc, \"crypto_aead_aegis128l\");\n    load_aegis(&r128, hr, \"crypto_aead_aegis128l\");\n    load_aegis(&c256, hc, \"crypto_aead_aegis256\");\n    load_aegis(&r256, hr, \"crypto_aead_aegis256\");\n    load_gcm(&cg, hc);\n    load_gcm(&rg, hr);\n\n    /* the exported implementation structs must exist in both */\n    CK(dlsym(hc, \"aegis128l_soft_implementation\") != NULL &&\n           dlsym(hr, \"aegis128l_soft_implementation\") != NULL,\n       \"aegis128l_soft_implementation symbol\", \"data\");\n    CK(dlsym(hc, \"aegis256_soft_implementation\") != NULL &&\n           dlsym(hr, \"aegis256_soft_implementation\") != NULL,\n       \"aegis256_soft_implementation symbol\", \"data\");\n\n    test_aegis(\"aegis128l\", &c128, &r128);\n    test_aegis(\"aegis256\", &c256, &r256);\n    test_gcm(&cg, &rg);\n    test_misuse(\"aegis128l\", &c128, &r128);\n    test_misuse(\"aegis256\", &c256, &r256);\n\n    printf(\"checks=%d failures=%d\\n\", checks, failures);\n    return failures != 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_crea