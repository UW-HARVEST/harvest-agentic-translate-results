e.sub(r'\\(int64_t\\)\\s*', '', e)\n    e = re.sub(r'\\(uint64_t\\)\\s*', '', e)\n    assert 'int64' not in e and 'uint64' not in e, e\n    # decimal literals -> i64 typed where they start an expression is unnecessary;\n    # Rust infers i64 from context.\n    return e.strip()\n\ndef xlate(name, body, arrname, outlen, sig):\n    st = stmts(body)\n    out = []\n    declared = set()\n    for s in st:\n        s = s[:-1].strip()   # drop ';'\n        m = re.fullmatch(r'int64_t (\\w+)\\s*=\\s*(.*)', s)\n        if m:\n            v, e = m.group(1), xlate_expr(m.group(2), arrname)\n            assert v not in declared\n            declared.add(v)\n            out.append('    let mut %s: i64 = %s;' % (v, e))\n            continue\n        m = re.fullmatch(r'int64_t (\\w+)', s)\n        if m:\n            v = m.group(1)\n            assert v not in declared, v\n            declared.add(v)\n            out.append('    let mut %s: i64 = 0;' % v)\n            continue\n        m = re.fullmatch(r'(\\w+) (=|\\+=|-=) (.*)', s)\n        if m:\n            v, op, e = m.group(1), m.group(2), xlate_expr(m.group(3), arrname)\n            assert v in declared, (name, v, s)\n            out.append('    %s %s %s;' % (v, op, e))\n            continue\n        m = re.fullmatch(r'%s\\[(\\d+)\\]\\s*=\\s*(.*)' % re.escape(arrname), s)\n        if m:\n            idx, e = m.group(1), m.group(2)\n            # byte-store: compute in u64 to mirror C's promotion, keep low 8 bits\n            e = xlate_expr(e, arrname)\n            # turn `sN * (1i64 << K)` into `((sN as u64) << K)`\n            e2 = re.sub(r'\\(?(\\w+) \\* \\(1i64 << (\\d+)\\)\\)?', r'((\\1 as u64) << \\2)', e)\n            e2 = re.sub(r'\\(?(\\w+) >> (\\d+)\\)?', r'((\\1 as u64) >> \\2)', e2)\n            out.append('    %s[%s] = (%s) as u8;' % (arrname, idx, e2))\n            continue\n        raise SystemExit('UNHANDLED in %s: %r' % (name, s))\n    return out\n\ntargets = [\n    ('sc25519_mul', 1202, 's', 32,\n     'pub fn sc