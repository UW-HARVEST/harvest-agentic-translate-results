ox_noncebytes\");\n    S(zerobytes, \"crypto_box_zerobytes\");\n    S(boxzerobytes, \"crypto_box_boxzerobytes\");\n    S(macbytes, \"crypto_box_macbytes\");\n    S(messagebytes_max, \"crypto_box_messagebytes_max\");\n    S(sealbytes, \"crypto_box_sealbytes\");\n    S(primitive, \"crypto_box_primitive\");\n    S(seed_keypair, \"crypto_box_seed_keypair\");\n    S(keypair, \"crypto_box_keypair\");\n    S(beforenm, \"crypto_box_beforenm\");\n    S(afternm, \"crypto_box_afternm\");\n    S(open_afternm, \"crypto_box_open_afternm\");\n    S(box_, \"crypto_box\");\n    S(box_open, \"crypto_box_open\");\n    S(easy, \"crypto_box_easy\");\n    S(open_easy, \"crypto_box_open_easy\");\n    S(easy_afternm, \"crypto_box_easy_afternm\");\n    S(open_easy_afternm, \"crypto_box_open_easy_afternm\");\n    S(detached, \"crypto_box_detached\");\n    S(open_detached, \"crypto_box_open_detached\");\n    S(detached_afternm, \"crypto_box_detached_afternm\");\n    S(open_detached_afternm, \"crypto_box_open_detached_afternm\");\n    S(seal, \"crypto_box_seal\");\n    S(seal_open, \"crypto_box_seal_open\");\n\n    S(x_seedbytes, \"crypto_box_curve25519xsalsa20poly1305_seedbytes\");\n    S(x_publickeybytes, \"crypto_box_curve25519xsalsa20poly1305_publickeybytes\");\n    S(x_secretkeybytes, \"crypto_box_curve25519xsalsa20poly1305_secretkeybytes\");\n    S(x_beforenmbytes, \"crypto_box_curve25519xsalsa20poly1305_beforenmbytes\");\n    S(x_noncebytes, \"crypto_box_curve25519xsalsa20poly1305_noncebytes\");\n    S(x_zerobytes, \"crypto_box_curve25519xsalsa20poly1305_zerobytes\");\n    S(x_boxzerobytes, \"crypto_box_curve25519xsalsa20poly1305_boxzerobytes\");\n    S(x_macbytes, \"crypto_box_curve25519xsalsa20poly1305_macbytes\");\n    S(x_messagebytes_max, \"crypto_box_curve25519xsalsa20poly1305_messagebytes_max\");\n    S(x_seed_keypair, \"crypto_box_curve25519xsalsa20poly1305_seed_keypair\");\n    S(x_keypair, \"crypto_box_curve25519xsalsa20poly1305_keypair\");\n    S(x_beforenm, \"crypto_box_curv