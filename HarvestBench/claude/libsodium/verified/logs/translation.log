crypto_ipcrypt_pfx_decrypt\");\n\n    f_keygen     = (void (*)(unsigned char *)) sym(\"crypto_ipcrypt_keygen\");\n    f_nd_keygen  = (void (*)(unsigned char *)) sym(\"crypto_ipcrypt_nd_keygen\");\n    f_ndx_keygen = (void (*)(unsigned char *)) sym(\"crypto_ipcrypt_ndx_keygen\");\n    f_pfx_keygen = (void (*)(unsigned char *)) sym(\"crypto_ipcrypt_pfx_keygen\");\n    f_pick       = (int (*)(void)) sym(\"_crypto_ipcrypt_pick_best_implementation\");\n\n    printf(\"sizes %zu %zu %zu %zu %zu %zu %zu %zu %zu %zu %zu %zu\\n\", s_bytes(), s_keybytes(),\n           s_nd_keybytes(), s_nd_tweakbytes(), s_nd_inputbytes(), s_nd_outputbytes(),\n           s_ndx_keybytes(), s_ndx_tweakbytes(), s_ndx_inputbytes(), s_ndx_outputbytes(),\n           s_pfx_keybytes(), s_pfx_bytes());\n\n    printf(\"pick %d\\n\", f_pick());\n    printf(\"pick %d\\n\", f_pick());\n\n    /* keygen: only check that it writes all the requested bytes (random data,\n     * so the transcript cannot be compared byte for byte) */\n    {\n        uint8_t buf[33];\n        int     nz = 0, i;\n        memset(buf, 0, sizeof buf);\n        f_keygen(buf);\n        for (i = 0; i < 16; i++)\n            nz += (buf[i] != 0);\n        memset(buf, 0, sizeof buf);\n        f_nd_keygen(buf);\n        for (i = 0; i < 16; i++)\n            nz += (buf[i] != 0);\n        memset(buf, 0, sizeof buf);\n        f_ndx_keygen(buf);\n        for (i = 0; i < 32; i++)\n            nz += (buf[i] != 0);\n        memset(buf, 0, sizeof buf);\n        f_pfx_keygen(buf);\n        for (i = 0; i < 32; i++)\n            nz += (buf[i] != 0);\n        printf(\"keygen-nonzero-bytes-plausible %d\\n\", nz > 80);\n    }\n\n    st = 0x0123456789abcdefULL;\n\n    for (it = 0; it < 600; it++) {\n        int mode = it % 6;\n\n        rndbuf(k16, 16);\n        rndbuf(k32, 32);\n        rndbuf(ip, 16);\n        rndbuf(t8, 8);\n        rndbuf(t16, 16);\n\n        switch (mode) {\n        case 1: /* IPv4-mapped address */\n            memset(ip, 0, 12);\n   