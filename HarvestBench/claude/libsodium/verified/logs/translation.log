include <stdlib.h>'\n      echo '#include <stdio.h>'\n      while read -r s; do\n        echo \"long $s(void){ fprintf(stderr,\\\"STUB CALLED: $s\\\\n\\\"); abort(); }\"\n      done < \"$STUBDIR/gaps.txt\"\n    } > \"$STUBDIR/stub.c\"\n    gcc -shared -fPIC -o \"$STUBDIR/libstub.so\" \"$STUBDIR/stub.c\" 2>/dev/null\n    PRELOAD=\"$STUBDIR/libstub.so\"\nelse\n    PRELOAD=\"\"\nfi\n\ngcc -O1 -w -o difftest difftest.c -ldl || exit 1\nif [ -n \"$PRELOAD\" ]; then\n    LD_PRELOAD=\"$PRELOAD\" ./difftest \"$CBUILD/libsodium.so\" \"$REPO/target/release/libsodium.so\"\nelse\n    ./difftest \"$CBUILD/libsodium.so\" \"$REPO/target/release/libsodium.so\"\nfi\n","structuredPatch":[],"originalFile":null,"userModified":false}}
