_stream_xor(\n    c: *mut u8,\n    m: *const u8,\n    mlen: u64,\n    n: *const u8,\n    k: *const u8,\n) -> c_int {\n    unsafe { crypto_stream_xsalsa20_xor(c, m, mlen, n, k) }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn crypto_stream_keygen(k: *mut u8) {\n    randombytes_buf(k as *mut c_void, crypto_stream_KEYBYTES);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1571,"cache_read_input_tokens":55433,"cache_creation":{"ephemeral_5m_input_tokens":1571,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01Ci7AaQgzxpmnxbYyXxW29i","session_id":"548cc808-00d2-470c-b99f-a8d3e7e02fd0","uuid":"51b45325-68de-4571-8c18-d65ca037c005","timestamp":"2026-08-22T19:58:06.732Z","subagent_type":"general-purpose","task_description":"Translate salsa20 stream ciphers"}
