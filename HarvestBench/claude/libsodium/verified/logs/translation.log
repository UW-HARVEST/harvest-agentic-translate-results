n\", dlerror());\n        return 2;\n    }\n    load(&C, hc);\n    load(&R, hr);\n\n    /* ---- constants ---- */\n#define CK(expr, name)                                                  \\\n    do {                                                                \\\n        checks++;                                                       \\\n        if ((expr) == 0) {                                              \\\n            fails++;                                                    \\\n            printf(\"MISMATCH const %s\\n\", name);                        \\\n        }                                                               \\\n    } while (0)\n    CK(C.bytes() == R.bytes() && R.bytes() == 32, \"bytes\");\n    CK(C.sbytes() == R.sbytes() && R.sbytes() == 32, \"scalarbytes\");\n    CK(C.cv_bytes() == R.cv_bytes() && R.cv_bytes() == 32, \"cv_bytes\");\n    CK(C.cv_sbytes() == R.cv_sbytes() && R.cv_sbytes() == 32, \"cv_sbytes\");\n    CK(C.ed_bytes() == R.ed_bytes() && R.ed_bytes() == 32, \"ed_bytes\");\n    CK(C.ed_sbytes() == R.ed_sbytes() && R.ed_sbytes() == 32, \"ed_sbytes\");\n    CK(C.rs_bytes() == R.rs_bytes() && R.rs_bytes() == 32, \"rs_bytes\");\n    CK(C.rs_sbytes() == R.rs_sbytes() && R.rs_sbytes() == 32, \"rs_sbytes\");\n    CK(strcmp(C.prim(), R.prim()) == 0 && strcmp(R.prim(), \"curve25519\") == 0,\n       \"primitive\");\n    CK(C.pick() == R.pick() && R.pick() == 0, \"pick_best_implementation\");\n    CK(C.impl_struct != NULL && R.impl_struct != NULL, \"impl symbol present\");\n    /* the implementation struct holds two non-NULL function pointers */\n    CK(((void **) R.impl_struct)[0] != NULL && ((void **) R.impl_struct)[1] != NULL,\n       \"impl struct contents\");\n    /* call through the Rust struct directly */\n    {\n        unsigned char q1[32], q2[32];\n        fn_mult m = (fn_mult) ((void **) R.impl_struct)[0];\n        fn_base b = (fn_base) ((void **) R.impl_struct)[1];\n        memset(n, 0x11, 32);\n        memset(p, 0, 32);\n 