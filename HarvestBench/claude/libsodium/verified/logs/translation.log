4];                    /* 32 */\n53\t    uint8_t salt[BLAKE2B_SALTBYTES];         /* 48 */\n54\t    uint8_t personal[BLAKE2B_PERSONALBYTES]; /* 64 */\n55\t} blake2b_param;\n56\t\n57\ttypedef struct blake2b_state {\n58\t    uint64_t h[8];\n59\t    uint64_t t[2];\n60\t    uint64_t f[2];\n61\t    uint8_t  buf[2 * 128];\n62\t    size_t   buflen;\n63\t    uint8_t  last_node;\n64\t} blake2b_state;\n65\t\n66\t#ifdef __IBMC__\n67\t# pragma pack(pop)\n68\t#elif defined(__SUNPRO_C) || defined(__SUNPRO_CC)\n69\t# pragma pack()\n70\t#else\n71\t# pragma pack(pop)\n72\t#endif\n73\t\n74\t/* Streaming API */\n75\tint blake2b_init(blake2b_state *S, const uint8_t outlen);\n76\tint blake2b_init_salt_personal(blake2b_state *S, const uint8_t outlen,\n77\t                               const void *salt, const void *personal);\n78\tint blake2b_init_key(blake2b_state *S, const uint8_t outlen, const void *key,\n79\t                     const uint8_t keylen);\n80\tint blake2b_init_key_salt_personal(blake2b_state *S, const uint8_t outlen,\n81\t                                   const void *key, const uint8_t keylen,\n82\t                                   const void *salt, const void *personal);\n83\tint blake2b_init_param(blake2b_state *S, const blake2b_param *P);\n84\tint blake2b_update(blake2b_state *S, const uint8_t *in, uint64_t inlen);\n85\tint blake2b_final(blake2b_state *S, uint8_t *out, uint8_t outlen);\n86\t\n87\t/* Simple API */\n88\tint blake2b(uint8_t *out, const void *in, const void *key, const uint8_t outlen,\n89\t            const uint64_t inlen, uint8_t keylen);\n90\tint blake2b_salt_personal(uint8_t *out, const void *in, const void *key,\n91\t                          const uint8_t outlen, const uint64_t inlen,\n92\t                          uint8_t keylen, const void *salt,\n93\t                          const void *personal);\n94\t\n95\ttypedef int (*blake2b_compress_fn)(blake2b_state *S,\n96\t                                   const uint8_t  block[BLAKE2B_BLOCKBYTES]);\n9