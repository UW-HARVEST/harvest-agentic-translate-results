{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_dn5zojzezkfnvukjhqxmr5ib7lftis7bvfgvh67feijqds6m2c4q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01DeMveMNVACfAnnMLnu4CXd","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-translate-9qBOQP/tmp/scrypt_cmp.c","content":"/* Throwaway differential harness: C libsodium vs Rust libsodium (scrypt). */\n#define _GNU_SOURCE\n#include <dlfcn.h>\n#include <errno.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nstatic int checks = 0;\nstatic int fails  = 0;\n\nstatic void\nhexpr(const char *tag, const void *p, size_t n)\n{\n    const unsigned char *b = (const unsigned char *) p;\n    size_t               i;\n    fprintf(stderr, \"    %s:\", tag);\n    for (i = 0; i < n; i++) {\n        fprintf(stderr, \"%02x\", b[i]);\n    }\n    fprintf(stderr, \"\\n\");\n}\n\n#define OK(cond, ...)                                     \\\n    do {                                                  \\\n        checks++;                                         \\\n        if (!(cond)) {                                    \\\n            fails++;                                      \\\n            fprintf(stderr, \"FAIL: \");                    \\\n            fprintf(stderr, __VA_ARGS__);                 \\\n            fprintf(stderr, \"\\n\");                        \\\n        }                                                 \\\n    } while (0)\n\n/* ------------------------------------------------------------------ */\n\ntypedef struct {\n    void  *base;\n    void  *aligned;\n    size_t size;\n} region_t;\n\ntypedef struct randombytes_implementation {\n    const char *(*implementation_name)(void);\n    uint32_t (*random)(void);\n    void (*stir)(void);\n    uint32_t (*uniform)(const uint32_t upper_bound);\n    void (*buf)(void *const buf, const size_t size);\n    int (*close)(void);\n} randombytes_implementation;\n\nstatic uint8_t rb_ctr;\n\nstatic const char *\nrb_name(void)\n{\n    return \"harness-det\";\n}\n\nstatic void\nrb_buf(void *const buf, const size_t size)\n{\n    uint8_t *p = (uint8_t *) buf;\n    size_t   i;\n    for (i = 0; i < size; i++) {\n        p[i] = rb_ctr++;\n    }\n}\n\nstatic uint32_t\nrb_random(void)\n{\n    uint32_t r;\n    rb_buf(&r, sizeof r);\n    return r;\n}\n\nstatic randombytes_implementation rb_impl = { rb_name, rb_random, NULL, NULL,\n                                              rb_buf, NULL };\n\n/* ------------------------------------------------------------------ */\n\nstruct lib {\n    const char *tag;\n    void       *h;\n\n    int (*ll)(const uint8_t *, size_t, const uint8_t *, size_t, uint64_t,\n              uint32_t, uint32_t, uint8_t *, size_t);\n    int (*pw)(unsigned char *, unsigned long long, const char *,\n              unsigned long long, const unsigned char *, unsigned long long,\n              size_t);\n    int (*str)(char *, const char *, unsigned long long, unsigned long long,\n               size_t);\n    int (*str_verify)(const char *, const char *, unsigned long long);\n    int (*needs_rehash)(const char *, unsigned long long, size_t);\n\n    size_t (*bytes_min)(void);\n    size_t (*bytes_max)(void);\n    size_t (*passwd_min)(void);\n    size_t (*passwd_max)(void);\n    size_t (*saltbytes)(void);\n    size_t (*strbytes)(void);\n    const char *(*strprefix)(void);\n    unsigned long long (*opslimit_min)(void);\n    unsigned long long (*opslimit_max)(void);\n    size_t (*memlimit_min)(void);\n    size_t (*memlimit_max)(void);\n    unsigned long long (*opslimit_interactive)(void);\n    size_t (*memlimit_interactive)(void);\n    unsigned long long (*opslimit_sensitive)(void);\n    size_t (*memlimit_sensitive)(void);\n\n    void (*pbkdf2)(const uint8_t *, size_t, const uint8_t *, size_t, uint64_t,\n                   uint8_t *, size_t);\n    uint8_t *(*gensalt)(uint32_t, uint32_t, uint32_t, const uint8_t *, size_t,\n                        uint8_t *, size_t);\n    const uint8_t *(*parse_setting)(const uint8_t *, uint32_t *, uint32_t *,\n                                    uint32_t *);\n    uint8_t *(*escrypt_r)(region_t *, const uint8_t *, size_t, const uint8_t *,\n                          uint8_t *, size_t);\n    int (*kdf_nosse)(region_t *, const uint8_t *, size_t, const uint8_t *,\n                     size_t, uint64_t, uint32_t, uint32_t, uint8_t *, size_t);\n    int (*init_local)(region_t *);\n    int (*free_local)(region_t *);\n    void *(*alloc_region)(region_t *, size_t);\n    int (*free_region)(region_t *);\n    int (*set_impl)(const randombytes_implementation *);\n};\n\nstatic void *\nsym(struct lib *l, const char *name)\n{\n    void *p = dlsym(l->h, name);\n    if (p == NULL) {\n        fprintf(stderr, \"MISSING SYMBOL in %s: %s (%s)\\n\", l->tag, name,\n                dlerror());\n        exit(2);\n    }\n    return p;\n}\n\nstatic void\nload(struct lib *l, const char *tag, const char *path)\n{\n    l->tag = tag;\n    l->h   = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n    if (l->h == NULL) {\n        fprintf(stderr, \"dlopen(%s) failed: %s\\n\", path, dlerror());\n        exit(2);\n    }\n#define S(f, n) *(void **) (&l->f) = sym(l, n)\n    S(ll, \"crypto_pwhash_scryptsalsa208sha256_ll\");\n    S(pw, \"crypto_pwhash_scryptsalsa208sha256\");\n    S(str, \"crypto_pwhash_scryptsalsa208sha256_str\");\n    S(str_verify, \"crypto_pwhash_scryptsalsa208sha256_str_verify\");\n    S(needs_rehash, \"crypto_pwhash_scryptsalsa208sha256_str_needs_rehash\");\n    S(bytes_min, \"crypto_pwhash_scryptsalsa208sha256_bytes_min\");\n    S(bytes_max, \"crypto_pwhash_scryptsalsa208sha256_bytes_max\");\n    S(passwd_min, \"crypto_pwhash_scryptsalsa208sha256_passwd_min\");\n    S(passwd_max, \"crypto_pwhash_scryptsalsa208sha256_passwd_max\");\n    S(saltbytes, \"crypto_pwhash_scryptsalsa208sha256_saltbytes\");\n    S(strbytes, \"crypto_pwhash_scryptsalsa208sha256_strbytes\");\n    S(strprefix, \"crypto_pwhash_scryptsalsa208sha256_strprefix\");\n    S(opslimit_min, \"crypto_pwhash_scryptsalsa208sha256_opslimit_min\");\n    S(opslimit_max, \"crypto_pwhash_scryptsalsa208sha256_opslimit_max\");\n    S(memlimit_min, \"crypto_pwhash_scryptsalsa208sha256_memlimit_min\");\n    S(memlimit_max, \"crypto_pwhash_scryptsalsa208sha256_memlimit_max\");\n    S(opslimit_interactive,\n      \"crypto_pwhash_scryptsalsa208sha256_opslimit_interactive\");\n    S(memlimit_interactive,\n      \"crypto_pwhash_scryptsalsa208sha256_memlimit_interactive\");\n    S(opslimit_sensitive,\n      \"crypto_pwhash_scryptsalsa208sha256_opslimit_sensitive\");\n    S(memlimit_sensitive,\n      \"crypto_pwhash_scryptsalsa208sha256_memlimit_sensitive\");\n    S(pbkdf2, \"_sodium_escrypt_PBKDF2_SHA256\");\n    S(gensalt, \"_sodium_escrypt_gensalt_r\");\n    S(parse_setting, \"_sodium_escrypt_parse_setting\");\n    S(escrypt_r, \"_sodium_escrypt_r\");\n    S(kdf_nosse, \"_sodium_escrypt_kdf_nosse\");\n    S(init_local, \"_sodium_escrypt_init_local\");\n    S(free_local, \"_sodium_escrypt_free_local\");\n    S(alloc_region, \"_sodium_escrypt_alloc_region\");\n    S(free_region, \"_sodium_escrypt_free_region\");\n    S(set_impl, \"randombytes_set_implementation\");\n#undef S\n}\n\nstatic struct lib C, R;\n\n/* ------------------------------------------------------------------ */\n\nstatic void\ntest_constants(void)\n{\n    OK(C.bytes_min() == R.bytes_min(), \"bytes_min %zu != %zu\", C.bytes_min(),\n       R.bytes_min());\n    OK(C.bytes_max() == R.bytes_max(), \"bytes_max %zu != %zu\", C.bytes_max(),\n       R.bytes_max());\n    OK(C.passwd_min() == R.passwd_min(), \"passwd_min\");\n    OK(C.passwd_max() == R.passwd_max(), \"passwd_max %zu != %zu\",\n       C.passwd_max(), R.passwd_max());\n    OK(C.saltbytes() == R.saltbytes(), \"saltbytes\");\n    OK(C.strbytes() == R.strbytes(), \"strbytes\");\n    OK(strcmp(C.strprefix(), R.strprefix()) == 0, \"strprefix '%s' != '%s'\",\n       C.strprefix(), R.strprefix());\n    OK(C.opslimit_min() == R.opslimit_min(), \"opslimit_min\");\n    OK(C.opslimit_max() == R.opslimit_max(), \"opslimit_max %llu != %llu\",\n       C.opslimit_max(), R.opslimit_max());\n    OK(C.memlimit_min() == R.memlimit_min(), \"memlimit_min\");\n    OK(C.memlimit_max() == R.memlimit_max(), \"memlimit_max %zu != %zu\",\n       C.memlimit_max(), R.memlimit_max());\n    OK(C.opslimit_interactive() == R.opslimit_interactive(), \"ops_inter\");\n    OK(C.memlimit_interactive() == R.memlimit_interactive(), \"mem_inter\");\n    OK(C.opslimit_sensitive() == R.opslimit_sensitive(), \"ops_sens\");\n    OK(C.memlimit_sensitive() == R.memlimit_sensitive(), \"mem_sens\");\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\none_ll(const uint8_t *pw, size_t pwlen, const uint8_t *salt, size_t saltlen,\n       uint64_t N, uint32_t r, uint32_t p, size_t buflen)\n{\n    uint8_t *b1 = malloc(buflen ? buflen : 1);\n    uint8_t *b2 = malloc(buflen ? buflen : 1);\n    int      r1, r2, e1, e2;\n\n    memset(b1, 0xa5, buflen ? buflen : 1);\n    memset(b2, 0xa5, buflen ? buflen : 1);\n    errno = 0;\n    r1    = C.ll(pw, pwlen, salt, saltlen, N, r, p, b1, buflen);\n    e1    = errno;\n    errno = 0;\n    r2    = R.ll(pw, pwlen, salt, saltlen, N, r, p, b2, buflen);\n    e2    = errno;\n    OK(r1 == r2, \"ll ret N=%llu r=%u p=%u len=%zu: %d != %d\",\n       (unsigned long long) N, r, p, buflen, r1, r2);\n    OK(e1 == e2, \"ll errno N=%llu r=%u p=%u len=%zu: %d != %d\",\n       (unsigned long long) N, r, p, buflen, e1, e2);\n    if (memcmp(b1, b2, buflen ? buflen : 1) != 0) {\n        fails++;\n        fprintf(stderr, \"FAIL: ll out N=%llu r=%u p=%u len=%zu\\n\",\n                (unsigned long long) N, r, p, buflen);\n        hexpr(\"C\", b1, buflen ? buflen : 1);\n        hexpr(\"R\", b2, buflen ? buflen : 1);\n    }\n    checks++;\n    free(b1);\n    free(b2);\n}\n\nstatic void\ntest_ll(void)\n{\n    static const uint8_t pw[]   = \"Correct Horse Battery Staple\";\n    static const uint8_t salt[] = \"0123456789abcdef0123456789abcdef\";\n    uint64_t             Ns[]   = { 16, 1024 };\n    uint32_t             rs[]   = { 1, 8 };\n    uint32_t             ps[]   = { 1, 2 };\n    size_t               ls[]   = { 0, 1, 16, 31, 32, 33, 64, 100 };\n    size_t               i, j, k, m;\n\n    for (i = 0; i < 2; i++) {\n        for (j = 0; j < 2; j++) {\n            for (k = 0; k < 2; k++) {\n                for (m = 0; m < sizeof ls / sizeof ls[0]; m++) {\n                    one_ll(pw, sizeof pw - 1, salt, 32, Ns[i], rs[j], ps[k],\n                           ls[m]);\n                }\n            }\n        }\n    }\n    /* empty password / empty salt */\n    one_ll((const uint8_t *) \"\", 0, (const uint8_t *) \"\", 0, 16, 1, 1, 64);\n    one_ll(pw, sizeof pw - 1, salt, 0, 16, 1, 1, 64);\n    one_ll(pw, 0, salt, 32, 1024, 8, 1, 64);\n\n    /* error paths */\n    one_ll(pw, 4, salt, 4, 0, 8, 1, 32);            /* N == 0  -> EINVAL */\n    one_ll(pw, 4, salt, 4, 1, 8, 1, 32);            /* N == 1  -> EINVAL */\n    one_ll(pw, 4, salt, 4, 3, 8, 1, 32);            /* !pow2   -> EINVAL */\n    one_ll(pw, 4, salt, 4, 6, 8, 1, 32);            /* !pow2   -> EINVAL */\n    one_ll(pw, 4, salt, 4, 1ULL << 33, 8, 1, 32);   /* > U32MAX -> EFBIG */\n    one_ll(pw, 4, salt, 4, 16, 0, 1, 32);           /* r == 0  -> EINVAL */\n    one_ll(pw, 4, salt, 4, 16, 8, 0, 32);           /* p == 0  -> EINVAL */\n    one_ll(pw, 4, salt, 4, 16, 1u << 15, 1u << 15, 32); /* r*p>=2^30 EFBIG */\n    one_ll(pw, 4, salt, 4, 16, 0x40000000u, 1, 32);\n    one_ll(pw, 4, salt, 4, 1ULL << 31, 0x1000000u, 1, 32); /* ENOMEM */\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\nrfc7914(const char *pw, const char *salt, uint64_t N, uint32_t r, uint32_t p,\n        const char *expect_hex)\n{\n    uint8_t out[64];\n    uint8_t exp[64];\n    size_t  i;\n    int     rc;\n\n    for (i = 0; i < 64; i++) {\n        unsigned int v;\n        sscanf(expect_hex + 2 * i, \"%2x\", &v);\n        exp[i] = (uint8_t) v;\n    }\n    memset(out, 0, sizeof out);\n    rc = R.ll((const uint8_t *) pw, strlen(pw), (const uint8_t *) salt,\n              strlen(salt), N, r, p, out, sizeof out);\n    OK(rc == 0, \"rfc7914 rust ret %d (N=%llu)\", rc, (unsigned long long) N);\n    if (memcmp(out, exp, 64) != 0) {\n        fails++;\n        fprintf(stderr, \"FAIL: rfc7914 vector N=%llu r=%u p=%u\\n\",\n                (unsigned long long) N, r, p);\n        hexpr(\"got\", out, 64);\n        hexpr(\"exp\", exp, 64);\n    }\n    checks++;\n}\n\nstatic void\ntest_rfc7914(void)\n{\n    rfc7914(\"\", \"\", 16, 1, 1,\n            \"77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442\"\n            \"fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906\");\n    rfc7914(\"password\", \"NaCl\", 1024, 8, 16,\n            \"fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b371622\"\n            \"eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc0640\");\n    /* note: last vector fixed up below (63 bytes above is a typo guard) */\n}\n\nstatic void\ntest_rfc7914b(void)\n{\n    rfc7914(\"password\", \"NaCl\", 1024, 8, 16,\n            \"fdbabe1c9d3472007856e7190d01e9fe7c6ad7cbc8237830e77376634b371622\"\n            \"eaf30d92e22a3886ff109279d9830dac727afb94a83ee6d8360cbdfa2cc06400\");\n    rfc7914(\"pleaseletmein\", \"SodiumChloride\", 16384, 8, 1,\n            \"7023bdcb3afd7348461c06cd81fd38ebfda8fbba904f8e3ea9b543f6545da1f2\"\n            \"d5432955613f0fcf62d49705242a9af9e61e85dc0d651e40dfcf017b45575887\");\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\none_pw(size_t outlen, const char *pw, unsigned long long opslimit,\n       size_t memlimit)\n{\n    static const unsigned char salt[32] = \"salt-salt-salt-salt-salt-salt-1\";\n    unsigned char             *o1       = malloc(outlen ? outlen : 1);\n    unsigned char             *o2       = malloc(outlen ? outlen : 1);\n    int                        r1, r2, e1, e2;\n\n    memset(o1, 0x5a, outlen ? outlen : 1);\n    memset(o2, 0x5a, outlen ? outlen : 1);\n    errno = 0;\n    r1    = C.pw(o1, outlen, pw, strlen(pw), salt, opslimit, memlimit);\n    e1    = errno;\n    errno = 0;\n    r2    = R.pw(o2, outlen, pw, strlen(pw), salt, opslimit, memlimit);\n    e2    = errno;\n    OK(r1 == r2, \"pw ret outlen=%zu ops=%llu mem=%zu: %d != %d\", outlen,\n       opslimit, memlimit, r1, r2);\n    OK(e1 == e2, \"pw errno outlen=%zu ops=%llu mem=%zu: %d != %d\", outlen,\n       opslimit, memlimit, e1, e2);\n    if (memcmp(o1, o2, outlen ? outlen : 1) != 0) {\n        fails++;\n        fprintf(stderr, \"FAIL: pw out outlen=%zu ops=%llu mem=%zu\\n\", outlen,\n                opslimit, memlimit);\n        hexpr(\"C\", o1, outlen ? outlen : 1);\n        hexpr(\"R\", o2, outlen ? outlen : 1);\n    }\n    checks++;\n    free(o1);\n    free(o2);\n}\n\nstatic void\ntest_pw(void)\n{\n    one_pw(16, \"pw\", 0, 0);\n    one_pw(16, \"pw\", 1, 0);\n    one_pw(32, \"\", 32768, 0);\n    one_pw(32, \"hello\", 32768, 1);\n    one_pw(32, \"hello\", 32768, 32);\n    one_pw(32, \"hello\", 32768, 1024);\n    one_pw(32, \"hello\", 32768, 100000);\n    one_pw(64, \"hello\", 32768, 16777216);\n    one_pw(100, \"hello\", 65536, 1048576);\n    one_pw(32, \"hello\", 524288, 16777216);\n    one_pw(15, \"hello\", 32768, 1024);   /* outlen < BYTES_MIN -> EINVAL */\n    one_pw(0, \"hello\", 32768, 1024);    /* outlen 0           -> EINVAL */\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\ntest_str(void)\n{\n    char cbuf[102], rbuf[102];\n    int  r1, r2;\n    struct {\n        unsigned long long ops;\n        size_t             mem;\n    } cases[] = { { 32768, 1024 },\n                  { 32768, 16777216 },\n                  { 0, 0 },\n                  { 65536, 1048576 },\n                  { 524288, 16777216 } };\n    size_t i;\n\n    for (i = 0; i < sizeof cases / sizeof cases[0]; i++) {\n        memset(cbuf, 0x11, sizeof cbuf);\n        memset(rbuf, 0x22, sizeof rbuf);\n        rb_ctr = 0x37;\n        r1     = C.str(cbuf, \"monkey\", 6, cases[i].ops, cases[i].mem);\n        rb_ctr = 0x37;\n        r2     = R.str(rbuf, \"monkey\", 6, cases[i].ops, cases[i].mem);\n        OK(r1 == r2, \"str ret ops=%llu mem=%zu: %d != %d\", cases[i].ops,\n           cases[i].mem, r1, r2);\n        if (memcmp(cbuf, rbuf, sizeof cbuf) != 0) {\n            fails++;\n            fprintf(stderr, \"FAIL: str out ops=%llu mem=%zu\\n\", cases[i].ops,\n                    cases[i].mem);\n            fprintf(stderr, \"    C='%.101s'\\n    R='%.101s'\\n\", cbuf, rbuf);\n        }\n        checks++;\n\n        /* cross verification */\n        OK(C.str_verify(cbuf, \"monkey\", 6) == 0, \"C verify C hash\");\n        OK(R.str_verify(cbuf, \"monkey\", 6) == 0, \"R verify C hash\");\n        OK(C.str_verify(rbuf, \"monkey\", 6) == 0, \"C verify R hash\");\n        OK(R.str_verify(rbuf, \"monkey\", 6) == 0, \"R verify R hash\");\n        OK(C.str_verify(cbuf, \"monkex\", 6) == R.str_verify(cbuf, \"monkex\", 6),\n           \"verify wrong pw mismatch\");\n        OK(R.str_verify(cbuf, \"monkex\", 6) == -1, \"R verify wrong pw != -1\");\n\n        /* needs_rehash on both, over a grid */\n        {\n            unsigned long long opss[] = { 0, 1, 32768, 65536, 524288, 1000000 };\n            size_t             mems[] = { 0, 1, 32, 1024, 1048576, 16777216 };\n            size_t             a, b;\n            for (a = 0; a < 6; a++) {\n                for (b = 0; b < 6; b++) {\n                    int x1, x2, y1, y2;\n                    errno = 0;\n                    x1    = C.needs_rehash(cbuf, opss[a], mems[b]);\n                    y1    = errno;\n                    errno = 0;\n                    x2    = R.needs_rehash(cbuf, opss[a], mems[b]);\n                    y2    = errno;\n                    OK(x1 == x2 && y1 == y2,\n                       \"needs_rehash ops=%llu mem=%zu: (%d,%d) != (%d,%d)\",\n                       opss[a], mems[b], x1, y1, x2, y2);\n                }\n            }\n        }\n    }\n\n    /* corrupted / short strings */\n    {\n        char bad[102];\n        const char *shorts[] = { \"\", \"$7$\", \"$7$A\", \"not-a-hash\",\n                                 \"$8$C6..../....SodiumChloride\" };\n        size_t k;\n        for (k = 0; k < sizeof shorts / sizeof shorts[0]; k++) {\n            memset(bad, 0, sizeof bad);\n            strcpy(bad, shorts[k]);\n            OK(C.str_verify(bad, \"monkey\", 6) == R.str_verify(bad, \"monkey\", 6),\n               \"str_verify bad[%zu]\", k);\n            errno = 0;\n            {\n                int x1 = C.needs_rehash(bad, 32768, 1024);\n                int e1 = errno;\n                int x2, e2;\n                errno = 0;\n                x2    = R.needs_rehash(bad, 32768, 1024);\n                e2    = errno;\n                OK(x1 == x2 && e1 == e2, \"needs_rehash bad[%zu] (%d,%d)/(%d,%d)\",\n                   k, x1, e1, x2, e2);\n            }\n        }\n        /* full-length but wrong content */\n        rb_ctr = 1;\n        C.str(bad, \"pw\", 2, 32768, 1024);\n        bad[20] ^= 0x01;\n        OK(C.str_verify(bad, \"pw\", 2) == R.str_verify(bad, \"pw\", 2),\n           \"str_verify tampered\");\n        bad[3] = '\\xff'; /* invalid N_log2 char */\n        OK(C.str_verify(bad, \"pw\", 2) == R.str_verify(bad, \"pw\", 2),\n           \"str_verify invalid N_log2\");\n        OK(C.needs_rehash(bad, 32768, 1024) == R.needs_rehash(bad, 32768, 1024),\n           \"needs_rehash invalid N_log2\");\n    }\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\none_pbkdf2(const uint8_t *pw, size_t pwlen, const uint8_t *salt, size_t saltlen,\n           uint64_t c, size_t dkLen)\n{\n    uint8_t *b1 = malloc(dkLen ? dkLen : 1);\n    uint8_t *b2 = malloc(dkLen ? dkLen : 1);\n\n    memset(b1, 0x11, dkLen ? dkLen : 1);\n    memset(b2, 0x11, dkLen ? dkLen : 1);\n    C.pbkdf2(pw, pwlen, salt, saltlen, c, b1, dkLen);\n    R.pbkdf2(pw, pwlen, salt, saltlen, c, b2, dkLen);\n    if (memcmp(b1, b2, dkLen ? dkLen : 1) != 0) {\n        fails++;\n        fprintf(stderr, \"FAIL: pbkdf2 pwlen=%zu saltlen=%zu c=%llu dk=%zu\\n\",\n                pwlen, saltlen, (unsigned long long) c, dkLen);\n        hexpr(\"C\", b1, dkLen ? dkLen : 1);\n        hexpr(\"R\", b2, dkLen ? dkLen : 1);\n    }\n    checks++;\n    free(b1);\n    free(b2);\n}\n\nstatic void\ntest_pbkdf2(void)\n{\n    static const uint8_t pw[]   = \"passwd-for-pbkdf2\";\n    static const uint8_t salt[] = \"some salt value here\";\n    uint64_t             cs[]   = { 1, 2, 3, 10, 100 };\n    size_t               ds[]   = { 0, 1, 7, 31, 32, 33, 63, 64, 65, 128, 200 };\n    size_t               i, j;\n\n    for (i = 0; i < sizeof cs / sizeof cs[0]; i++) {\n        for (j = 0; j < sizeof ds / sizeof ds[0]; j++) {\n            one_pbkdf2(pw, sizeof pw - 1, salt, sizeof salt - 1, cs[i], ds[j]);\n        }\n    }\n    one_pbkdf2((const uint8_t *) \"\", 0, (const uint8_t *) \"\", 0, 1, 64);\n    /* long key (> 64 bytes -> hmac hashes the key) */\n    {\n        uint8_t longpw[200];\n        size_t  i2;\n        for (i2 = 0; i2 < sizeof longpw; i2++) {\n            longpw[i2] = (uint8_t) (i2 * 7 + 3);\n        }\n        one_pbkdf2(longpw, sizeof longpw, salt, sizeof salt - 1, 5, 100);\n        one_pbkdf2(longpw, 64, salt, sizeof salt - 1, 1, 32);\n        one_pbkdf2(longpw, 65, salt, sizeof salt - 1, 1, 32);\n    }\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\none_gensalt(uint32_t N_log2, uint32_t r, uint32_t p, const uint8_t *src,\n            size_t srclen, size_t buflen)\n{\n    uint8_t  b1[256], b2[256];\n    uint8_t *p1, *p2;\n\n    if (buflen > sizeof b1) {\n        return;\n    }\n    memset(b1, 0xcc, sizeof b1);\n    memset(b2, 0xcc, sizeof b2);\n    p1 = C.gensalt(N_log2, r, p, src, srclen, b1, buflen);\n    p2 = R.gensalt(N_log2, r, p, src, srclen, b2, buflen);\n    OK((p1 == NULL) == (p2 == NULL),\n       \"gensalt null-ness N=%u r=%u p=%u srclen=%zu buflen=%zu\", N_log2, r, p,\n       srclen, buflen);\n    OK((p1 == NULL || p1 == b1) && (p2 == NULL || p2 == b2),\n       \"gensalt returns buf\");\n    if (memcmp(b1, b2, sizeof b1) != 0) {\n        fails++;\n        fprintf(stderr,\n                \"FAIL: gensalt buf N=%u r=%u p=%u srclen=%zu buflen=%zu\\n\",\n                N_log2, r, p, srclen, buflen);\n        hexpr(\"C\", b1, sizeof b1);\n        hexpr(\"R\", b2, sizeof b2);\n    }\n    checks++;\n}\n\nstatic void\ntest_gensalt(void)\n{\n    static const uint8_t src[64] = \"abcdefghijklmnopqrstuvwxyz0123456789ABCDEF\";\n    uint32_t             Ns[]    = { 0, 1, 10, 14, 62, 63, 64, 100, 0xffffffffu };\n    uint32_t             rs[]    = { 0, 1, 8, 1024, 0x3fffffffu, 0x40000000u };\n    uint32_t             ps[]    = { 0, 1, 2, 512, 0x3fffffffu };\n    size_t               sls[]   = { 0, 1, 3, 16, 32, 48 };\n    size_t               bls[]   = { 0, 1, 13, 14, 57, 58, 59, 100, 200 };\n    size_t               a, b, c2, d, e;\n\n    for (a = 0; a < sizeof Ns / sizeof Ns[0]; a++) {\n        for (b = 0; b < sizeof rs / sizeof rs[0]; b++) {\n            for (c2 = 0; c2 < sizeof ps / sizeof ps[0]; c2++) {\n                one_gensalt(Ns[a], rs[b], ps[c2], src, 32, 58);\n            }\n        }\n    }\n    for (d = 0; d < sizeof sls / sizeof sls[0]; d++) {\n        for (e = 0; e < sizeof bls / sizeof bls[0]; e++) {\n            one_gensalt(10, 8, 1, src, sls[d], bls[e]);\n        }\n    }\n    one_gensalt(10, 8, 1, src, 32, (size_t) -1);\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\none_parse(const char *setting)\n{\n    uint32_t       n1 = 0xdeadbeef, r1 = 0xdeadbeef, p1 = 0xdeadbeef;\n    uint32_t       n2 = 0xdeadbeef, r2 = 0xdeadbeef, p2 = 0xdeadbeef;\n    const uint8_t *e1, *e2;\n\n    e1 = C.parse_setting((const uint8_t *) setting, &n1, &r1, &p1);\n    e2 = R.parse_setting((const uint8_t *) setting, &n2, &r2, &p2);\n    OK((e1 == NULL) == (e2 == NULL), \"parse null-ness '%s'\", setting);\n    if (e1 != NULL && e2 != NULL) {\n        OK(e1 - (const uint8_t *) setting == e2 - (const uint8_t *) setting,\n           \"parse offset '%s': %ld != %ld\", setting,\n           (long) (e1 - (const uint8_t *) setting),\n           (long) (e2 - (const uint8_t *) setting));\n    }\n    OK(n1 == n2 && r1 == r2 && p1 == p2,\n       \"parse outs '%s': (%u,%u,%u) != (%u,%u,%u)\", setting, n1, r1, p1, n2, r2,\n       p2);\n}\n\nstatic void\ntest_parse(void)\n{\n    one_parse(\"$7$C6..../....abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHI\");\n    one_parse(\"$7$A6..../....abcdefghijklmnopqrstuvwxyz\");\n    one_parse(\"$7$\");\n    one_parse(\"$7$A\");\n    one_parse(\"$7$A6..../...\");\n    one_parse(\"$8$C6..../....abc\");\n    one_parse(\"$7X\");\n    one_parse(\"\");\n    one_parse(\"$7$\\xff\\xff\\xff\");\n    one_parse(\"$7$.........................\");\n    one_parse(\"$7$/////////////////////////\");\n    one_parse(\"$7$zzzzzzzzzzzzzzzzzzzzzzzzz\");\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\none_escrypt_r(const char *setting, const char *pw, size_t buflen)\n{\n    uint8_t  b1[256], b2[256];\n    region_t l1, l2;\n    uint8_t *p1, *p2;\n\n    if (buflen > sizeof b1) {\n        return;\n    }\n    memset(b1, 0x77, sizeof b1);\n    memset(b2, 0x77, sizeof b2);\n    memset(&l1, 0xff, sizeof l1);\n    memset(&l2, 0xff, sizeof l2);\n    OK(C.init_local(&l1) == 0, \"init_local C\");\n    OK(R.init_local(&l2) == 0, \"init_local R\");\n    OK(l1.base == l2.base && l1.aligned == l2.aligned && l1.size == l2.size,\n       \"init_local zeroed region\");\n\n    rb_ctr = 0x91;\n    p1     = C.escrypt_r(&l1, (const uint8_t *) pw, strlen(pw),\n                         (const uint8_t *) setting, b1, buflen);\n    rb_ctr = 0x91;\n    p2     = R.escrypt_r(&l2, (const uint8_t *) pw, strlen(pw),\n                         (const uint8_t *) setting, b2, buflen);\n    OK((p1 == NULL) == (p2 == NULL), \"escrypt_r null-ness '%s' buflen=%zu\",\n       setting, buflen);\n    if (memcmp(b1, b2, sizeof b1) != 0) {\n        fails++;\n        fprintf(stderr, \"FAIL: escrypt_r buf '%s' buflen=%zu\\n\", setting,\n                buflen);\n        hexpr(\"C\", b1, sizeof b1);\n        hexpr(\"R\", b2, sizeof b2);\n    }\n    checks++;\n    OK(C.free_local(&l1) == 0, \"free_local C\");\n    OK(R.free_local(&l2) == 0, \"free_local R\");\n    OK(l1.base == NULL && l1.aligned == NULL && l1.size == 0, \"free_local C zeroed\");\n    OK(l2.base == NULL && l2.aligned == NULL && l2.size == 0, \"free_local R zeroed\");\n}\n\nstatic void\ntest_escrypt_r(void)\n{\n    /* setting produced by gensalt(N_log2=4, r=1, p=1, 32-byte salt) */\n    uint8_t  setting[64];\n    uint8_t  src[32];\n    size_t   i;\n    uint8_t *s;\n\n    for (i = 0; i < 32; i++) {\n        src[i] = (uint8_t) (i * 5 + 1);\n    }\n    memset(setting, 0, sizeof setting);\n    s = C.gensalt(4, 1, 1, src, 32, setting, 58);\n    OK(s != NULL, \"gensalt for escrypt_r\");\n\n    one_escrypt_r((const char *) setting, \"hunter2\", 102);\n    one_escrypt_r((const char *) setting, \"\", 102);\n    one_escrypt_r((const char *) setting, \"hunter2\", 101); /* need > buflen */\n    one_escrypt_r((const char *) setting, \"hunter2\", 0);\n    one_escrypt_r((const char *) setting, \"hunter2\", 150);\n\n    memset(setting, 0, sizeof setting);\n    s = C.gensalt(10, 8, 1, src, 32, setting, 58);\n    OK(s != NULL, \"gensalt for escrypt_r 2\");\n    one_escrypt_r((const char *) setting, \"hunter2\", 102);\n\n    /* invalid settings */\n    one_escrypt_r(\"$8$abc\", \"x\", 102);\n    one_escrypt_r(\"$7$\", \"x\", 102);\n    /* N_log2 = 63 -> kdf rejects (N > UINT32_MAX) */\n    memset(setting, 0, sizeof setting);\n    s = C.gensalt(63, 1, 1, src, 32, setting, 58);\n    OK(s != NULL, \"gensalt N_log2=63\");\n    one_escrypt_r((const char *) setting, \"x\", 102);\n    /* salt containing a '$' -> strrchr path */\n    one_escrypt_r(\"$7$C6..../....abcdef$ghij\", \"x\", 102);\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\none_kdf(const uint8_t *pw, size_t pwlen, const uint8_t *salt, size_t saltlen,\n        uint64_t N, uint32_t r, uint32_t p, size_t buflen)\n{\n    uint8_t *b1 = malloc(buflen ? buflen : 1);\n    uint8_t *b2 = malloc(buflen ? buflen : 1);\n    region_t l1, l2;\n    int      r1, r2, e1, e2;\n\n    memset(b1, 0x33, buflen ? buflen : 1);\n    memset(b2, 0x33, buflen ? buflen : 1);\n    C.init_local(&l1);\n    R.init_local(&l2);\n    errno = 0;\n    r1    = C.kdf_nosse(&l1, pw, pwlen, salt, saltlen, N, r, p, b1, buflen);\n    e1    = errno;\n    errno = 0;\n    r2    = R.kdf_nosse(&l2, pw, pwlen, salt, saltlen, N, r, p, b2, buflen);\n    e2    = errno;\n    OK(r1 == r2, \"kdf ret N=%llu r=%u p=%u: %d != %d\", (unsigned long long) N,\n       r, p, r1, r2);\n    OK(e1 == e2, \"kdf errno N=%llu r=%u p=%u: %d != %d\", (unsigned long long) N,\n       r, p, e1, e2);\n    OK((l1.size == 0) == (l2.size == 0) && l1.size == l2.size,\n       \"kdf region size %zu != %zu\", l1.size, l2.size);\n    if (memcmp(b1, b2, buflen ? buflen : 1) != 0) {\n        fails++;\n        fprintf(stderr, \"FAIL: kdf out N=%llu r=%u p=%u buflen=%zu\\n\",\n                (unsigned long long) N, r, p, buflen);\n        hexpr(\"C\", b1, buflen ? buflen : 1);\n        hexpr(\"R\", b2, buflen ? buflen : 1);\n    }\n    checks++;\n    C.free_local(&l1);\n    R.free_local(&l2);\n    free(b1);\n    free(b2);\n}\n\nstatic void\ntest_kdf(void)\n{\n    static const uint8_t pw[]   = \"kdf password\";\n    static const uint8_t salt[] = \"kdf salt 0123456789\";\n    uint64_t             Ns[]   = { 2, 4, 16, 256, 1024 };\n    uint32_t             rs[]   = { 1, 2, 8 };\n    uint32_t             ps[]   = { 1, 2, 3 };\n    size_t               a, b, c2;\n\n    for (a = 0; a < sizeof Ns / sizeof Ns[0]; a++) {\n        for (b = 0; b < sizeof rs / sizeof rs[0]; b++) {\n            for (c2 = 0; c2 < sizeof ps / sizeof ps[0]; c2++) {\n                one_kdf(pw, sizeof pw - 1, salt, sizeof salt - 1, Ns[a], rs[b],\n                        ps[c2], 64);\n            }\n        }\n    }\n    one_kdf(pw, sizeof pw - 1, salt, sizeof salt - 1, 16, 1, 1, 0);\n    one_kdf(pw, sizeof pw - 1, salt, sizeof salt - 1, 16, 1, 1, 1);\n    one_kdf(pw, sizeof pw - 1, salt, sizeof salt - 1, 16, 1, 1, 200);\n    /* errors */\n    one_kdf(pw, 4, salt, 4, 0, 1, 1, 32);\n    one_kdf(pw, 4, salt, 4, 1, 1, 1, 32);\n    one_kdf(pw, 4, salt, 4, 5, 1, 1, 32);\n    one_kdf(pw, 4, salt, 4, 1ULL << 32, 1, 1, 32);\n    one_kdf(pw, 4, salt, 4, 16, 0, 1, 32);\n    one_kdf(pw, 4, salt, 4, 16, 1, 0, 32);\n    one_kdf(pw, 4, salt, 4, 16, 0x8000u, 0x8000u, 32);\n    one_kdf(pw, 4, salt, 4, 1ULL << 31, 0x2000000u, 1, 32);\n\n    /* region reuse: second call with smaller need must not realloc */\n    {\n        region_t l1, l2;\n        uint8_t  b1[64], b2[64];\n        size_t   s1, s2;\n        C.init_local(&l1);\n        R.init_local(&l2);\n        C.kdf_nosse(&l1, pw, 4, salt, 4, 1024, 8, 1, b1, 64);\n        R.kdf_nosse(&l2, pw, 4, salt, 4, 1024, 8, 1, b2, 64);\n        s1 = l1.size;\n        s2 = l2.size;\n        OK(s1 == s2, \"region size after big call %zu != %zu\", s1, s2);\n        C.kdf_nosse(&l1, pw, 4, salt, 4, 16, 1, 1, b1, 64);\n        R.kdf_nosse(&l2, pw, 4, salt, 4, 16, 1, 1, b2, 64);\n        OK(l1.size == s1 && l2.size == s2, \"region kept on reuse\");\n        OK(memcmp(b1, b2, 64) == 0, \"region reuse output\");\n        C.free_local(&l1);\n        R.free_local(&l2);\n    }\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void\ntest_region(void)\n{\n    region_t l1, l2;\n    void    *a1, *a2;\n    size_t   sizes[] = { 0, 1, 63, 64, 65, 4096, 1000000 };\n    size_t   i;\n\n    for (i = 0; i < sizeof sizes / sizeof sizes[0]; i++) {\n        memset(&l1, 0xab, sizeof l1);\n        memset(&l2, 0xab, sizeof l2);\n        a1 = C.alloc_region(&l1, sizes[i]);\n        a2 = R.alloc_region(&l2, sizes[i]);\n        OK((a1 == NULL) == (a2 == NULL), \"alloc_region null-ness size=%zu\",\n           sizes[i]);\n        OK(a1 == l1.aligned && a2 == l2.aligned, \"alloc_region returns aligned\");\n        OK(l1.size == l2.size, \"alloc_region size %zu != %zu\", l1.size,\n           l2.size);\n        OK(((uintptr_t) a1 & 63) == 0 && ((uintptr_t) a2 & 63) == 0,\n           \"alloc_region 64-byte alignment size=%zu\", sizes[i]);\n        OK((uintptr_t) a1 - (uintptr_t) l1.base <= 63\n               && (uintptr_t) a2 - (uintptr_t) l2.base <= 63,\n           \"alloc_region aligned within base+63\");\n        OK(C.free_region(&l1) == 0 && R.free_region(&l2) == 0, \"free_region\");\n        OK(l1.base == NULL && l1.aligned == NULL && l1.size == 0\n               && l2.base == NULL && l2.aligned == NULL && l2.size == 0,\n           \"free_region zeroes region\");\n    }\n    /* overflow: size + 63 wraps */\n    memset(&l1, 0xab, sizeof l1);\n    memset(&l2, 0xab, sizeof l2);\n    errno = 0;\n    a1    = C.alloc_region(&l1, (size_t) -1);\n    i     = (size_t) errno;\n    errno = 0;\n    a2    = R.alloc_region(&l2, (size_t) -1);\n    OK(a1 == NULL && a2 == NULL, \"alloc_region SIZE_MAX -> NULL\");\n    OK((int) i == errno, \"alloc_region SIZE_MAX errno %d != %d\", (int) i, errno);\n    OK(l1.size == l2.size && l1.base == l2.base, \"alloc_region SIZE_MAX region\");\n    OK(C.free_region(&l1) == 0 && R.free_region(&l2) == 0,\n       \"free_region after failed alloc\");\n    /* double free_region is a no-op */\n    OK(C.free_region(&l1) == 0 && R.free_region(&l2) == 0,\n       \"free_region idempotent\");\n}\n\n/* ------------------------------------------------------------------ */\n\nint\nmain(int argc, char **