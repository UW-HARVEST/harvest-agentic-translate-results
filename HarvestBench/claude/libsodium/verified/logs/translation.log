    }\n305\t    }\n306\t\n307\t    /* Validate lanes */\n308\t    if (ARGON2_MIN_LANES > context->lanes) {\n309\t        return ARGON2_LANES_TOO_FEW;\n310\t    }\n311\t\n312\t    if (ARGON2_MAX_LANES < context->lanes) {\n313\t        return ARGON2_LANES_TOO_MANY;\n314\t    }\n315\t\n316\t    /* Validate memory cost */\n317\t    if (ARGON2_MIN_MEMORY > context->m_cost) {\n318\t        return ARGON2_MEMORY_TOO_LITTLE;\n319\t    }\n320\t\n321\t    if (ARGON2_MAX_MEMORY < context->m_cost) {\n322\t        return ARGON2_MEMORY_TOO_MUCH;\n323\t    }\n324\t\n325\t    if (context->m_cost < 8 * context->lanes) {\n326\t        return ARGON2_MEMORY_TOO_LITTLE;\n327\t    }\n328\t\n329\t    /* Validate time cost */\n330\t    if (ARGON2_MIN_TIME > context->t_cost) {\n331\t        return ARGON2_TIME_TOO_SMALL;\n332\t    }\n333\t\n334\t    if (ARGON2_MAX_TIME < context->t_cost) {\n335\t        return ARGON2_TIME_TOO_LARGE;\n336\t    }\n337\t\n338\t    /* Validate threads */\n339\t    if (ARGON2_MIN_THREADS > context->threads) {\n340\t        return ARGON2_THREADS_TOO_FEW;\n341\t    }\n342\t\n343\t    if (ARGON2_MAX_THREADS < context->threads) {\n344\t        return ARGON2_THREADS_TOO_MANY;\n345\t    }\n346\t    /* LCOV_EXCL_STOP */\n347\t\n348\t    return ARGON2_OK;\n349\t}\n350\t\n351\tstatic void\n352\targon2_fill_first_blocks(uint8_t *blockhash, const argon2_instance_t *instance)\n353\t{\n354\t    uint32_t l;\n355\t    /* Make the first and second block in each lane as G(H0||i||0) or\n356\t       G(H0||i||1) */\n357\t    uint8_t blockhash_bytes[ARGON2_BLOCK_SIZE];\n358\t    for (l = 0; l < instance->lanes; ++l) {\n359\t        STORE32_LE(blockhash + ARGON2_PREHASH_DIGEST_LENGTH, 0);\n360\t        STORE32_LE(blockhash + ARGON2_PREHASH_DIGEST_LENGTH + 4, l);\n361\t        blake2b_long(blockhash_bytes, ARGON2_BLOCK_SIZE, blockhash,\n362\t                     ARGON2_PREHASH_SEED_LENGTH);\n363\t        load_block(&instance->region->memory[l * instance->lane_length + 0],\n364\t        