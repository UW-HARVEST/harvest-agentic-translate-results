rr = R->decrypt_detached(mr, NULL, cc, mlen, macc, adlen ? ad : NULL, adlen,\n                                             n2, k);\n                    CK(rc == rr && rc == -1, \"wrong nonce ret\", ctx);\n                    CK(memcmp(mc, mr, mlen + 1) == 0, \"wrong nonce zeroization\", ctx);\n                }\n\n                /* ---- detached decrypt with m == NULL ---- */\n                rc = C->decrypt_detached(NULL, NULL, cc, mlen, macc, adlen ? ad : NULL, adlen,\n                                         npub, k);\n                rr = R->decrypt_detached(NULL, NULL, cc, mlen, macc, adlen ? ad : NULL, adlen,\n                                         npub, k);\n                CK(rc == rr && rc == 0, \"decrypt_detached(m=NULL) ret\", ctx);\n\n                /* ---- in-place encryption (c == m) ---- */\n                {\n                    unsigned char ip1[MAXLEN + 64], ip2[MAXLEN + 64];\n                    ull           z1 = 0, z2 = 0;\n                    memcpy(ip1, m, mlen);\n                    memcpy(ip2, m, mlen);\n                    ip1[mlen + ab] = 0x11;\n                    ip2[mlen + ab] = 0x22;\n                    rc = C->encrypt(ip1, &z1, ip1, mlen, adlen ? ad : NULL, adlen, NULL, npub, k);\n                    rr = R->encrypt(ip2, &z2, ip2, mlen, adlen ? ad : NULL, adlen, NULL, npub, k);\n                    CK(rc == rr && z1 == z2, \"in-place encrypt ret\", ctx);\n                    CK(memcmp(ip1, ip2, mlen + ab) == 0, \"in-place encrypt ct\", ctx);\n                }\n\n                /* ---- clen > MESSAGEBYTES_MAX -> -1 (no memory touched) ---- */\n                {\n                    ull huge = (1ULL << 61); /* MESSAGEBYTES_MAX == 2^61 - 1 */\n                    rc = C->decrypt_detached(NULL, NULL, cc, huge, macc, NULL, 0, npub, k);\n                    rr = R->decrypt_detached(NULL, NULL, cc, huge, macc, NULL, 0, npub, k);\n                    CK(rc == rr && rc == -1, \"decrypt_detached huge clen\", ctx);\n                    rc