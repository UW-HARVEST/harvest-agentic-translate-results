ngle]).\n3. Non-`static` C global variables -> `#[unsafe(no_mangle)] pub static mut NAME: T = ...;`\n4. CROSS-FILE CALLS: for a function defined in a C file that is NOT one of your\n   assigned files, declare it locally with `unsafe extern \"C\" { fn ...; }`.\n   Do NOT use `crate::...` paths for functions owned by other files.\n   EXCEPTION: call these by path:\n      crate::common::{load32_le, store32_le, load64_le, store64_le, load32_be,\n                      store32_be, load64_be, store64_be, rotl32, rotl64, rotr32,\n                      rotr64, xor_buf, memcpy, memmove, memset,\n                      malloc, calloc, free, memcmp, strchr, strlen, strcmp, memchr,\n                      set_errno, get_errno, EINVAL, ERANGE, ENOMEM, ENOSYS, SIZE_MAX}\n      crate::sodium::core::sodium_misuse            (diverging: -> !)\n      crate::sodium::utils::{sodium_memzero, sodium_memcmp, sodium_compare,\n                             sodium_is_zero, sodium_increment, sodium_add, sodium_sub,\n                             sodium_malloc, sodium_free, sodium_allocarray}\n      crate::randombytes::{randombytes_buf, randombytes_random, randombytes_uniform}\n      crate::crypto_verify::{crypto_verify_16, crypto_verify_32, crypto_verify_64}\n5. State structs shared with callers: `#[repr(C)]`, layout identical to C\n   (`CRYPTO_ALIGN(n)` -> `#[repr(C, align(n))]`). Every `*_statebytes()` must\n   return exactly the C `sizeof`.\n6. BYTE-IDENTICAL SEMANTICS: preserve evaluation order, order of error checks,\n   integer wrap-around (wrapping_add/sub/mul), truncating casts, signed/unsigned\n   promotion, and any BUG in the C. Never \"fix\" the C. Never add/remove a check.\n7. No new dependencies (offline). Only core/std and the crate's own modules.\n8. Only create/modify the files in YOUR ASSIGNMENT. Never touch c_src/,\n   Cargo.toml, src/lib.rs, or files assigned to others.\n9. Build check: `cargo build --release --offline 2>&1 | grep -E \"^error\" -A 12 | head -150`\n   Other agents write other files concurrently: IGNORE errors whose file path is\n   not one of YOUR files. Iterate until none of YOUR files have errors.\n10. Prefer safe Rust internally as long as semantics match.\n\n=========================  YOUR ASSIGNMENT  =========================\n\nTranslate Keccak-f[1600], SHA-3 and all four XOFs:\n\n  crypto_core/keccak1600/keccak1600.c             -> src/crypto_core/keccak1600/mod.rs\n        (this file must start with `pub mod r#ref;` and then the translation)\n  crypto_core/keccak1600/ref/keccak1600_ref.c     -> src/crypto_core/keccak1600/ref.rs\n  crypto_core/keccak1600/ref/keccak1600_ref.h     (read)\n  crypto_core/keccak1600/implementations.h if present (read whatever headers exist)\n  crypto_hash/sha3/hash_sha3.c                   -> src/crypto_hash/sha3.rs\n  crypto_xof/shake128/xof_shake128.c             -> src/crypto_xof/shake128.rs\n  crypto_xof/shake128/ref/shake128_ref.c         -> src/crypto_xof/shake128.rs (same file)\n  crypto_xof/shake256/xof_shake256.c             -> src/crypto_xof/shake256.rs\n  crypto_xof/shake256/ref/shake256_ref.c         -> src/crypto_xof/shake256.rs (same file)\n  crypto_xof/turboshake128/xof_turboshake128.c   -> src/crypto_xof/turboshake128.rs\n  crypto_xof/turboshake128/ref/turboshake128_ref.c -> src/crypto_xof/turboshake128.rs\n  crypto_xof/turboshake256/xof_turboshake256.c   -> src/crypto_xof/turboshake256.rs\n  crypto_xof/turboshake256/ref/turboshake256_ref.c -> src/crypto_xof/turboshake256.rs\n\nHeaders to read: include/sodium/crypto_core_keccak1600.h, crypto_hash_sha3.h,\ncrypto_xof_shake128.h, crypto_xof_shake256.h, crypto_xof_turboshake128.h,\ncrypto_xof_turboshake256.h, include/sodium/private/common.h\n\n`src/crypto_xof/mod.rs` already contains the four `pub mod` lines — leave it alone.\n\nEXACT exported symbols you must produce (58 total):\n\nsrc/crypto_core/keccak1600/mod.rs (6):\n  crypto_core_keccak1600_extract_bytes crypto_core_keccak1600_init\n  crypto_core_keccak1600_permute_12 crypto_core_keccak1600_permute_24\n  crypto_core_keccak1600_statebytes crypto_core_keccak1600_xor_bytes\n\nsrc/crypto_core/keccak1600/ref.rs (5):\n  _sodium_keccak1600_ref_extract_bytes _sodium_keccak1600_ref_init\n  _sodium_keccak1600_ref_permute_12 _sodium_keccak1600_ref_permute_24\n  _sodium_keccak1600_ref_xor_bytes\n\nsrc/crypto_hash/sha3.rs (12):\n  crypto_hash_sha3256 crypto_hash_sha3256_bytes crypto_hash_sha3256_final\n  crypto_hash_sha3256_init crypto_hash_sha3256_statebytes crypto_hash_sha3256_update\n  crypto_hash_sha3512 crypto_hash_sha3512_bytes crypto_hash_sha3512_final\n  crypto_hash_sha3512_init crypto_hash_sha3512_statebytes crypto_hash_sha3512_update\n\nsrc/crypto_xof/shake128.rs (13):\n  crypto_xof_shake128 crypto_xof_shake128_blockbytes crypto_xof_shake128_domain_standard\n  crypto_xof_shake128_init crypto_xof_shake128_init_with_domain\n  crypto_xof_shake128_squeeze crypto_xof_shake128_statebytes crypto_xof_shake128_update\n  _sodium_shake128_ref _sodium_shake128_ref_init _sodium_shake128_ref_init_with_domain\n  _sodium_shake128_ref_squeeze _sodium_shake128_ref_update\n\nsrc/crypto_xof/shake256.rs (13): same pattern with shake256 / _sodium_shake256_ref*\n\nsrc/crypto_xof/turboshake128.rs (13): same pattern with turboshake128 /\n  _sodium_turboshake128_ref*\n\nsrc/crypto_xof/turboshake256.rs (13): same pattern with turboshake256 /\n  _sodium_turboshake256_ref*\n\nNote: keccak1600.c dispatches to an implementation table; with all\nsodium_runtime_has_* == 0 the `ref` backend is selected. Reproduce the C\ndispatch structure (including any `static const ... *implementation` pointer)\nfaithfully. Same for the xof_*.c dispatchers.\n\nWhen done report: files written + line counts + the output of\n`nm -D --defined-only target/release/libsodium.so | grep -cE 'keccak|sha3|shake'`.","uuid":"6f82d2ad-9761-4f14-91ae-057b4c301d94","session_id":"548cc808-00d2-470c-b99f-a8d3e7e02fd0"}
