\n65\t    uint128_t t = ((uint128_t) S->t[1] << 64) | S->t[0];\n66\t    t += inc;\n67\t    S->t[0] = (uint64_t)(t >> 0);\n68\t    S->t[1] = (uint64_t)(t >> 64);\n69\t#else\n70\t    S->t[0] += inc;\n71\t    S->t[1] += (S->t[0] < inc);\n72\t#endif\n73\t    return 0;\n74\t}\n75\t\n76\t/* Parameter-related functions */\n77\tstatic inline int\n78\tblake2b_param_set_salt(blake2b_param *P, const uint8_t salt[BLAKE2B_SALTBYTES])\n79\t{\n80\t    memcpy(P->salt, salt, BLAKE2B_SALTBYTES);\n81\t    return 0;\n82\t}\n83\t\n84\tstatic inline int\n85\tblake2b_param_set_personal(blake2b_param *P,\n86\t                           const uint8_t  personal[BLAKE2B_PERSONALBYTES])\n87\t{\n88\t    memcpy(P->personal, personal, BLAKE2B_PERSONALBYTES);\n89\t    return 0;\n90\t}\n91\t\n92\tstatic inline int\n93\tblake2b_init0(blake2b_state *S)\n94\t{\n95\t    int i;\n96\t\n97\t    for (i  = 0; i < 8; i++) {\n98\t        S->h[i] = blake2b_IV[i];\n99\t    }\n100\t    /* zero everything between .t and .last_node */\n101\t    memset((void *) &S->t, 0,\n102\t           offsetof(blake2b_state, last_node) + sizeof(S->last_node)\n103\t           - offsetof(blake2b_state, t));\n104\t    return 0;\n105\t}\n106\t\n107\t/* init xors IV with input parameter block */\n108\tint\n109\tblake2b_init_param(blake2b_state *S, const blake2b_param *P)\n110\t{\n111\t    size_t         i;\n112\t    const uint8_t *p;\n113\t\n114\t    COMPILER_ASSERT(sizeof *P == 64);\n115\t    blake2b_init0(S);\n116\t    p = (const uint8_t *) (P);\n117\t\n118\t    /* IV XOR ParamBlock */\n119\t    for (i = 0; i < 8; i++) {\n120\t        S->h[i] ^= LOAD64_LE(p + sizeof(S->h[i]) * i);\n121\t    }\n122\t    return 0;\n123\t}\n124\t\n125\tint\n126\tblake2b_init(blake2b_state *S, const uint8_t outlen)\n127\t{\n128\t    blake2b_param P[1];\n129\t\n130\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n131\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n132\t    }\n133\t    P->digest_length = outlen;\n134\t    P->key_length    = 0;\n135\t    P->fanout        = 1;\n136\t    P->depth         = 1;\n137\t    STORE32_LE(P->leaf_length, 0);\n138\t    STORE64_LE(P->node_offset, 0);\n139\t    P->node_depth   = 0;\n140\t    P->inner_length = 0;\n141\t    memset(P->reserved, 0, sizeof(P->reserved));\n142\t    memset(P->salt, 0, sizeof(P->salt));\n143\t    memset(P->personal, 0, sizeof(P->personal));\n144\t    return blake2b_init_param(S, P);\n145\t}\n146\t\n147\tint\n148\tblake2b_init_salt_personal(blake2b_state *S, const uint8_t outlen,\n149\t                           const void *salt, const void *personal)\n150\t{\n151\t    blake2b_param P[1];\n152\t\n153\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n154\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n155\t    }\n156\t    P->digest_length = outlen;\n157\t    P->key_length    = 0;\n158\t    P->fanout        = 1;\n159\t    P->depth         = 1;\n160\t    STORE32_LE(P->leaf_length, 0);\n161\t    STORE64_LE(P->node_offset, 0);\n162\t    P->node_depth   = 0;\n163\t    P->inner_length = 0;\n164\t    memset(P->reserved, 0, sizeof(P->reserved));\n165\t    if (salt != NULL) {\n166\t        blake2b_param_set_salt(P, (const uint8_t *) salt);\n167\t    } else {\n168\t        memset(P->salt, 0, sizeof(P->salt));\n169\t    }\n170\t    if (personal != NULL) {\n171\t        blake2b_param_set_personal(P, (const uint8_t *) personal);\n172\t    } else {\n173\t        memset(P->personal, 0, sizeof(P->personal));\n174\t    }\n175\t    return blake2b_init_param(S, P);\n176\t}\n177\t\n178\tint\n179\tblake2b_init_key(blake2b_state *S, const uint8_t outlen, const void *key,\n180\t                 const uint8_t keylen)\n181\t{\n182\t    blake2b_param P[1];\n183\t\n184\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n185\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n186\t    }\n187\t    if (!key || !keylen || keylen > BLAKE2B_KEYBYTES) {\n188\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n189\t    }\n190\t    P->digest_length = outlen;\n191\t    P->key_length    = keylen;\n192\t    P->fanout        = 1;\n193\t    P->depth         = 1;\n194\t    STORE32_LE(P->leaf_length, 0);\n195\t    STORE64_LE(P->node_offset, 0);\n196\t    P->node_depth   = 0;\n197\t    P->inner_length = 0;\n198\t    memset(P->reserved, 0, sizeof(P->reserved));\n199\t    memset(P->salt, 0, sizeof(P->salt));\n200\t    memset(P->personal, 0, sizeof(P->personal));\n201\t\n202\t    if (blake2b_init_param(S, P) < 0) {\n203\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n204\t    }\n205\t    {\n206\t        uint8_t block[BLAKE2B_BLOCKBYTES];\n207\t        memset(block, 0, BLAKE2B_BLOCKBYTES);\n208\t        memcpy(block, key, keylen); /* key and keylen cannot be 0 */\n209\t        blake2b_update(S, block, BLAKE2B_BLOCKBYTES);\n210\t        sodium_memzero(block, BLAKE2B_BLOCKBYTES); /* Burn the key from stack */\n211\t    }\n212\t    return 0;\n213\t}\n214\t\n215\tint\n216\tblake2b_init_key_salt_personal(blake2b_state *S, const uint8_t outlen,\n217\t                               const void *key, const uint8_t keylen,\n218\t                               const void *salt, const void *personal)\n219\t{\n220\t    blake2b_param P[1];\n221\t\n222\t    if ((!outlen) || (outlen > BLAKE2B_OUTBYTES)) {\n223\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n224\t    }\n225\t    if (!key || !keylen || keylen > BLAKE2B_KEYBYTES) {\n226\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n227\t    }\n228\t    P->digest_length = outlen;\n229\t    P->key_length    = keylen;\n230\t    P->fanout        = 1;\n231\t    P->depth         = 1;\n232\t    STORE32_LE(P->leaf_length, 0);\n233\t    STORE64_LE(P->node_offset, 0);\n234\t    P->node_depth   = 0;\n235\t    P->inner_length = 0;\n236\t    memset(P->reserved, 0, sizeof(P->reserved));\n237\t    if (salt != NULL) {\n238\t        blake2b_param_set_salt(P, (const uint8_t *) salt);\n239\t    } else {\n240\t        memset(P->salt, 0, sizeof(P->salt));\n241\t    }\n242\t    if (personal != NULL) {\n243\t        blake2b_param_set_personal(P, (con