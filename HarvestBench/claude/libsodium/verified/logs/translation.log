typedef void (*fn_ss_rekey)(void *);\n\nstruct lib {\n    void *h;\n    const char *name;\n    /* secretbox */\n    fn_sz keybytes, noncebytes, zerobytes, boxzerobytes, macbytes, messagebytes_max;\n    fn_str primitive;\n    fn_box secretbox, secretbox_open;\n    fn_keygen keygen;\n    fn_box easy, open_easy;\n    fn_det detached;\n    fn_opendet open_detached;\n    /* xsalsa20poly1305 */\n    fn_sz x_keybytes, x_noncebytes, x_zerobytes, x_boxzerobytes, x_macbytes, x_messagebytes_max;\n    fn_box xs, xs_open;\n    fn_keygen xs_keygen;\n    /* xchacha20poly1305 */\n    fn_sz xc_keybytes, xc_noncebytes, xc_macbytes, xc_messagebytes_max;\n    fn_box xc_easy, xc_open_easy;\n    fn_det xc_detached;\n    fn_opendet xc_open_detached;\n    /* secretstream */\n    fn_sz ss_abytes, ss_headerbytes, ss_keybytes, ss_messagebytes_max, ss_statebytes;\n    fn_uc ss_tag_message, ss_tag_push, ss_tag_rekey, ss_tag_final;\n    fn_keygen ss_keygen;\n    fn_ss_init ss_init_push;\n    fn_ss_initpull ss_init_pull;\n    fn_ss_push ss_push;\n    fn_ss_pull ss_pull;\n    fn_ss_rekey ss_rekey;\n};\n\nstatic void *sym(void *h, const char *n)\n{\n    void *p = dlsym(h, n);\n    if (p == NULL) {\n        fprintf(stderr, \"FATAL: missing symbol %s: %s\\n\", n, dlerror());\n        exit(2);\n    }\n    return p;\n}\n\n#define S(field, name) l->field = (void *) sym(l->h, name)\n\nstatic void load(struct lib *l, const char *path, const char *name)\n{\n    l->name = name;\n    l->h = dlopen(path, RTLD_NOW | RTLD_LOCAL);\n    if (l->h == NULL) {\n        l->h = dlopen(path, RTLD_LAZY | RTLD_LOCAL);\n    }\n    if (l->h == NULL) {\n        fprintf(stderr, \"FATAL: dlopen(%s): %s\\n\", path, dlerror());\n        exit(2);\n    }\n    S(keybytes, \"crypto_secretbox_keybytes\");\n    S(noncebytes, \"crypto_secretbox_noncebytes\");\n    S(zerobytes, \"crypto_secretbox_zerobytes\");\n    S(boxzerobytes, \"crypto_secretbox_boxzerobytes\");\n    S(macbytes, \"crypto_secretbox_macbytes\");\n    S(messagebytes_max, \"crypto_secretbox_messagebytes_max\");\n    S(primitive, \"crypto_secretbox_primitive\");\n    S(secretbox, \"crypto_secretbox\");\n    S(secretbox_open, \"crypto_secretbox_open\");\n    S(keygen, \"crypto_secretbox_keygen\");\n    S(easy, \"crypto_secretbox_easy\");\n    S(open_easy, \"crypto_secretbox_open_easy\");\n    S(detached, \"crypto_secretbox_detached\");\n    S(open_detached, \"crypto_secretbox_open_detached\");\n\n    S(x_keybytes, \"crypto_secretbox_xsalsa20poly1305_keybytes\");\n    S(x_noncebytes, \"crypto_secretbox_xsalsa20poly1305_noncebytes\");\n    S(x_zerobytes, \"crypto_secretbox_xsalsa20poly1305_zerobytes\");\n    S(x_boxzerobytes, \"crypto_secretbox_xsalsa20poly1305_boxzerobytes\");\n    S(x_macbytes, \"crypto_secretbox_xsalsa20poly1305_macbytes\");\n    S(x_messagebytes_max, \"crypto_secretbox_xsalsa20poly1305_messagebytes_max\");\n    S(xs, \"crypto_secretbox_xsalsa20poly1305\");\n    S(xs_open, \"crypto_secretbox_xsalsa20poly1305_open\");\n    S(xs_keygen, \"crypto_secretbox_xsalsa20poly1305_keygen\");\n\n    S(xc_keybytes, \"crypto_secretbox_xchacha20poly1305_keybytes\");\n    S(xc_noncebytes, \"crypto_secretbox_xchacha20poly1305_noncebytes\");\n    S(xc_macbytes, \"crypto_secretbox_xchacha20poly1305_macbytes\");\n    S(xc_messagebytes_max, \"crypto_secretbox_xchacha20poly1305_messagebytes_max\");\n    S(xc_easy, \"crypto_secretbox_xchacha20poly1305_easy\");\n    S(xc_open_easy, \"crypto_secretbox_xchacha20poly1305_open_easy\");\n    S(xc_detached, \"crypto_secretbox_xchacha20poly1305_detached\");\n    S(xc_open_detached, \"crypto_secretbox_xchacha20poly1305_open_detached\");\n\n    S(ss_abytes, \"crypto_secretstream_xchacha20poly1305_abytes\");\n    S(ss_headerbytes, \"crypto_secretstream_xchacha20poly1305_headerbytes\");\n    S(ss_keybytes, \"crypto_secretstream_xchacha20poly1305_keybytes\");\n    S(ss_messagebytes_max, \"crypto_secretstream_xchacha20poly1305_messagebytes_max\");\n    S(ss_statebytes, \"crypto_secretstream_xchacha20poly1305_statebytes\");\n    S(ss_tag_message, \"crypto_secretstream_xchacha20poly1305_tag_message\");\n    S(ss_tag_push, \"crypto_secretstream_xchacha20poly1305_tag_push\");\n    S(ss_tag_rekey, \"crypto_secretstream_xchacha20poly1305_tag_rekey\");\n    S(ss_tag_final, \"crypto_secretstream_xchacha20poly1305_tag_final\");\n    S(ss_keygen, \"crypto_secretstream_xchacha20poly1305_keygen\");\n    S(ss_init_push, \"crypto_secretstream_xchacha20poly1305_init_push\");\n    S(ss_init_pull, \"crypto_secretstream_xchacha20poly1305_init_pull\");\n    S(ss_push, \"crypto_secretstream_xchacha20poly1305_push\");\n    S(ss_pull, \"crypto_secretstream_xchacha20poly1305_pull\");\n    S(ss_rekey, \"crypto_secretstream_xchacha20poly1305_rekey\");\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic uint64_t rngstate = 0x123456789abcdefULL;\nstatic unsigned char rnd8(void)\n{\n    rngstate ^= rngstate << 13;\n    rngstate ^= rngstate >> 7;\n    rngstate ^= rngstate << 17;\n    return (unsigned char) (rngstate >> 33);\n}\nstatic void rndbuf(unsigned char *b, size_t n)\n{\n    size_t i;\n    for (i = 0; i < n; i++) {\n        b[i] = rnd8();\n    }\n}\n\nstatic void cmp_sz(const char *what, size_t a, size_t b)\n{\n    checks++;\n    if (a != b) {\n        printf(\"MISMATCH %s: c=%zu rust=%zu\\n\", what, a, b);\n        failures++;\n    }\n}\nstatic void cmp_int(const char *what, int a, int b)\n{\n    checks++;\n    if (a != b) {\n        printf(\"MISMATCH %s (rc): c=%d rust=%d\\n\", what, a, b);\n        failures++;\n    }\n}\nstatic void cmp_buf(const char *what, size_t len,\n                    const unsigned char *a, const unsigned char *b)\n{\n    checks++;\n    if (len != 0 && memcmp(a, b, len) != 0) {\n        size_t i;\n        printf(\"MISMATCH %s (buf, len=%zu) at\", what, len);\n        for (i = 0; i < len; i++) {\n            if (a[i] != b[i]) { printf(\" [%zu] c=%02x rust=%02x\", i, a[i], b[i]); break; }\n        }\n        printf(\"\\n\");\n        failures++;\n    }\n}\nstatic void cmp_u64(const char *what, unsigned long long a, unsigned long long b)\n{\n    checks++;\n    if (a != b) {\n        printf(\"MISMATCH %s: c=%llu rust=%llu\\n\", what, a, b);\n        failures++;\n    }\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic const size_t mlens[] = { 0, 1, 15, 16, 31, 32, 33, 63, 64, 65, 127, 128, 191, 600 };\n#define NMLENS (sizeof mlens / sizeof mlens[0])\n\nstatic void test_constants(struct lib *C, struct lib *R)\n{\n    cmp_sz(\"secretbox_keybytes\", C->keybytes(), R->keybytes());\n    cmp_sz(\"secretbox_noncebytes\", C->noncebytes(), R->noncebytes());\n    cmp_sz(\"secretbox_zerobytes\", C->zerobytes(), R->zerobytes());\n    cmp_sz(\"secretbox_boxzerobytes\", C->boxzerobytes(), R->boxzerobytes());\n    cmp_sz(\"secretbox_macbytes\", C->macbytes(), R->macbytes());\n    cmp_sz(\"secretbox_messagebytes_max\", C->messagebytes_max(), R->messagebytes_max());\n    checks++;\n    if (strcmp(C->primitive(), R->primitive()) != 0) {\n        printf(\"MISMATCH secretbox_primitive: c=%s rust=%s\\n\", C->primitive(), R->primitive());\n        failures++;\n    }\n    cmp_sz(\"xs_keybytes\", C->x_keybytes(), R->x_keybytes());\n    cmp_sz(\"xs_noncebytes\", C->x_noncebytes(), R->x_noncebytes());\n    cmp_sz(\"xs_zerobytes\", C->x_zerobytes(), R->x_zerobytes());\n    cmp_sz(\"xs_boxzerobytes\", C->x_boxzerobytes(), R->x_boxzerobytes());\n    cmp_sz(\"xs_macbytes\", C->x_macbytes(), R->x_macbytes());\n    cmp_sz(\"xs_messagebytes_max\", C->x_messagebytes_max(), R->x_messagebytes_max());\n    cmp_sz(\"xc_keybytes\", C->xc_keybytes(), R->xc_keybytes());\n    cmp_sz(\"xc_noncebytes\", C->xc_noncebytes(), R->xc_noncebytes());\n    cmp_sz(\"xc_macbytes\", C->xc_macbytes(), R->xc_macbytes());\n    cmp_sz(\"xc_messagebytes_max\", C->xc_messagebytes_max(), R->xc_messagebytes_max());\n    cmp_sz(\"ss_abytes\", C->ss_abytes(), R->ss_abytes());\n    cmp_sz(\"ss_headerbytes\", C->ss_headerbytes(), R->ss_headerbytes());\n    cmp_sz(\"ss_keybytes\", C->ss_keybytes(), R->ss_keybytes());\n    cmp_sz(\"ss_messagebytes_max\", C->ss_messagebytes_max(), R->ss_messagebytes_max());\n    cmp_sz(\"ss_statebytes\", C->ss_statebytes(), R->ss_statebytes());\n    cmp_sz(\"ss_tag_message\", C->ss_tag_message(), R->ss_tag_message());\n    cmp_sz(\"ss_tag_push\", C->ss_tag_push(), R->ss_tag_push());\n    cmp_sz(\"ss_tag_rekey\", C->ss_tag_rekey(), R->ss_tag_rekey());\n    cmp_sz(\"ss_tag_final\", C->ss_tag_final(), R->ss_tag_final());\n\n    /* keygen: just make sure it writes something (non-deterministic) */\n    {\n        unsigned char k1[32], k2[32];\n        memset(k1, 0, 32); memset(k2, 0, 32);\n        C->keygen(k1); R->keygen(k2);\n        checks++;\n        if (memcmp(k1, k2, 32) == 0) { printf(\"SUSPICIOUS: keygen produced equal keys\\n\"); }\n        memset(k1, 0, 32); C->xs_keygen(k1);\n        memset(k2, 0, 32); R->xs_keygen(k2);\n        memset(k1, 0, 32); C->ss_keygen(k1);\n        memset(k2, 0, 32); R->ss_keygen(k2);\n    }\n}\n\nstatic void test_secretbox_easy(struct lib *C, struct lib *R)\n{\n    static unsigned char cc[BUFSZ], cr[BUFSZ], mc[BUFSZ], mr[BUFSZ];\n    unsigned char m[BUFSZ], n[24], k[32], macc[16], macr[16];\n    size_t li, iter;\n    char lbl[128];\n\n    for (iter = 0; iter < 8; iter++) {\n        for (li = 0; li < NMLENS; li++) {\n            size_t mlen = mlens[li];\n            int rc1, rc2;\n            rndbuf(m, mlen); rndbuf(n, 24); rndbuf(k, 32);\n\n            /* easy */\n            memset(cc, 0xaa, BUFSZ); memset(cr, 0xaa, BUFSZ);\n            rc1 = C->easy(cc, m, mlen, n, k);\n            rc2 = R->easy(cr, m, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_easy mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n\n            /* open_easy */\n            memset(mc, 0xbb, BUFSZ); memset(mr, 0xbb, BUFSZ);\n            rc1 = C->open_easy(mc, cc, mlen + 16, n, k);\n            rc2 = R->open_easy(mr, cr, mlen + 16, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_open_easy mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, mc, mr);\n            checks++;\n            if (rc1 != 0 || (mlen && memcmp(mc, m, mlen) != 0)) {\n                printf(\"ROUNDTRIP FAIL secretbox_easy mlen=%zu\\n\", mlen); failures++;\n            }\n\n            /* tampered */\n            if (mlen + 16 > 0) {\n                size_t pos = (size_t) (rnd8()) % (mlen + 16);\n                cc[pos] ^= 0x40; cr[pos] ^= 0x40;\n                memset(mc, 0xcc, BUFSZ); memset(mr, 0xcc, BUFSZ);\n                rc1 = C->open_easy(mc, cc, mlen + 16, n, k);\n                rc2 = R->open_easy(mr, cr, mlen + 16, n, k);\n                snprintf(lbl, sizeof lbl, \"secretbox_open_easy tampered mlen=%zu\", mlen);\n                cmp_int(lbl, rc1, rc2);\n                cmp_buf(lbl, BUFSZ, mc, mr);\n                cc[pos] ^= 0x40; cr[pos] ^= 0x40;\n            }\n\n            /* short ciphertext */\n            {\n                size_t sl;\n                for (sl = 0; sl < 16; sl++) {\n                    rc1 = C->open_easy(mc, cc, sl, n, k);\n                    rc2 = R->open_easy(mr, cr, sl, n, k);\n                    snprintf(lbl, sizeof lbl, \"secretbox_open_easy short=%zu\", sl);\n                    cmp_int(lbl, rc1, rc2);\n                }\n            }\n\n            /* detached */\n            memset(cc, 0xaa, BUFSZ); memset(cr, 0xaa, BUFSZ);\n            memset(macc, 0, 16); memset(macr, 0, 16);\n            rc1 = C->detached(cc, macc, m, mlen, n, k);\n            rc2 = R->detached(cr, macr, m, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_detached mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            cmp_buf(\"secretbox_detached mac\", 16, macc, macr);\n\n            memset(mc, 0xbb, BUFSZ); memset(mr, 0xbb, BUFSZ);\n            rc1 = C->open_detached(mc, cc, macc, mlen, n, k);\n            rc2 = R->open_detached(mr, cr, macr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_open_detached mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, mc, mr);\n\n            /* open_detached with m == NULL */\n            rc1 = C->open_detached(NULL, cc, macc, mlen, n, k);\n            rc2 = R->open_detached(NULL, cr, macr, mlen, n, k);\n            cmp_int(\"secretbox_open_detached m=NULL\", rc1, rc2);\n            macc[3] ^= 1; macr[3] ^= 1;\n            rc1 = C->open_detached(NULL, cc, macc, mlen, n, k);\n            rc2 = R->open_detached(NULL, cr, macr, mlen, n, k);\n            cmp_int(\"secretbox_open_detached m=NULL bad mac\", rc1, rc2);\n            macc[3] ^= 1; macr[3] ^= 1;\n\n            /* in-place easy: c == m - MACBYTES  => detached gets c==m */\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            memcpy(cc + 16, m, mlen); memcpy(cr + 16, m, mlen);\n            rc1 = C->easy(cc, cc + 16, mlen, n, k);\n            rc2 = R->easy(cr, cr + 16, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_easy inplace mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            rc1 = C->open_easy(cc + 16, cc, mlen + 16, n, k);\n            rc2 = R->open_easy(cr + 16, cr, mlen + 16, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_open_easy inplace mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n\n            /* overlapping detached: c = buf+1, m = buf (c > m, c-m < mlen) */\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            memcpy(cc, m, mlen); memcpy(cr, m, mlen);\n            rc1 = C->detached(cc + 1, macc, cc, mlen, n, k);\n            rc2 = R->detached(cr + 1, macr, cr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_detached overlap+1 mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            cmp_buf(\"overlap+1 mac\", 16, macc, macr);\n\n            /* overlapping detached: c = buf, m = buf+1 (m > c, m-c < mlen) */\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            memcpy(cc + 1, m, mlen); memcpy(cr + 1, m, mlen);\n            rc1 = C->detached(cc, macc, cc + 1, mlen, n, k);\n            rc2 = R->detached(cr, macr, cr + 1, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_detached overlap-1 mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            cmp_buf(\"overlap-1 mac\", 16, macc, macr);\n\n            /* overlapping open_detached: m = buf+1, c = buf */\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            rndbuf(cc, mlen); memcpy(cr, cc, mlen);\n            rndbuf(macc, 16); memcpy(macr, macc, 16);\n            rc1 = C->open_detached(cc + 1, cc, macc, mlen, n, k);\n            rc2 = R->open_detached(cr + 1, cr, macr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_open_detached overlap (bad mac) mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n\n            /* valid overlapping open_detached */\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            C->detached(cc + 1, macc, m, mlen, n, k);\n            memcpy(cr, cc, BUFSZ); memcpy(macr, macc, 16);\n            rc1 = C->open_detached(cc, cc + 1, macc, mlen, n, k);\n            rc2 = R->open_detached(cr, cr + 1, macr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"secretbox_open_detached overlap ok mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            checks++;\n            if (rc1 != 0 || (mlen && memcmp(cc, m, mlen) != 0)) {\n                printf(\"ROUNDTRIP FAIL overlap open_detached mlen=%zu\\n\", mlen); failures++;\n            }\n        }\n    }\n}\n\nstatic void test_secretbox_xchacha(struct lib *C, struct lib *R)\n{\n    static unsigned char cc[BUFSZ], cr[BUFSZ], mc[BUFSZ], mr[BUFSZ];\n    unsigned char m[BUFSZ], n[24], k[32], macc[16], macr[16];\n    size_t li, iter;\n    char lbl[160];\n\n    for (iter = 0; iter < 8; iter++) {\n        for (li = 0; li < NMLENS; li++) {\n            size_t mlen = mlens[li];\n            int rc1, rc2;\n            rndbuf(m, mlen); rndbuf(n, 24); rndbuf(k, 32);\n\n            memset(cc, 0xaa, BUFSZ); memset(cr, 0xaa, BUFSZ);\n            rc1 = C->xc_easy(cc, m, mlen, n, k);\n            rc2 = R->xc_easy(cr, m, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_easy mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n\n            memset(mc, 0xbb, BUFSZ); memset(mr, 0xbb, BUFSZ);\n            rc1 = C->xc_open_easy(mc, cc, mlen + 16, n, k);\n            rc2 = R->xc_open_easy(mr, cr, mlen + 16, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_open_easy mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, mc, mr);\n            checks++;\n            if (rc1 != 0 || (mlen && memcmp(mc, m, mlen) != 0)) {\n                printf(\"ROUNDTRIP FAIL xc_easy mlen=%zu\\n\", mlen); failures++;\n            }\n\n            {\n                size_t pos = (size_t) (rnd8()) % (mlen + 16);\n                cc[pos] ^= 0x11; cr[pos] ^= 0x11;\n                memset(mc, 0xcc, BUFSZ); memset(mr, 0xcc, BUFSZ);\n                rc1 = C->xc_open_easy(mc, cc, mlen + 16, n, k);\n                rc2 = R->xc_open_easy(mr, cr, mlen + 16, n, k);\n                snprintf(lbl, sizeof lbl, \"xc_open_easy tampered mlen=%zu\", mlen);\n                cmp_int(lbl, rc1, rc2);\n                cmp_buf(lbl, BUFSZ, mc, mr);\n                cc[pos] ^= 0x11; cr[pos] ^= 0x11;\n            }\n            {\n                size_t sl;\n                for (sl = 0; sl < 16; sl++) {\n                    rc1 = C->xc_open_easy(mc, cc, sl, n, k);\n                    rc2 = R->xc_open_easy(mr, cr, sl, n, k);\n                    snprintf(lbl, sizeof lbl, \"xc_open_easy short=%zu\", sl);\n                    cmp_int(lbl, rc1, rc2);\n                }\n            }\n\n            memset(cc, 0xaa, BUFSZ); memset(cr, 0xaa, BUFSZ);\n            rc1 = C->xc_detached(cc, macc, m, mlen, n, k);\n            rc2 = R->xc_detached(cr, macr, m, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_detached mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            cmp_buf(\"xc_detached mac\", 16, macc, macr);\n\n            memset(mc, 0xbb, BUFSZ); memset(mr, 0xbb, BUFSZ);\n            rc1 = C->xc_open_detached(mc, cc, macc, mlen, n, k);\n            rc2 = R->xc_open_detached(mr, cr, macr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_open_detached mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, mc, mr);\n\n            rc1 = C->xc_open_detached(NULL, cc, macc, mlen, n, k);\n            rc2 = R->xc_open_detached(NULL, cr, macr, mlen, n, k);\n            cmp_int(\"xc_open_detached m=NULL\", rc1, rc2);\n\n            /* in-place */\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            memcpy(cc + 16, m, mlen); memcpy(cr + 16, m, mlen);\n            rc1 = C->xc_easy(cc, cc + 16, mlen, n, k);\n            rc2 = R->xc_easy(cr, cr + 16, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_easy inplace mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            rc1 = C->xc_open_easy(cc + 16, cc, mlen + 16, n, k);\n            rc2 = R->xc_open_easy(cr + 16, cr, mlen + 16, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_open_easy inplace mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n\n            /* overlaps */\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            memcpy(cc, m, mlen); memcpy(cr, m, mlen);\n            rc1 = C->xc_detached(cc + 1, macc, cc, mlen, n, k);\n            rc2 = R->xc_detached(cr + 1, macr, cr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_detached overlap+1 mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            cmp_buf(\"xc overlap+1 mac\", 16, macc, macr);\n\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            memcpy(cc + 1, m, mlen); memcpy(cr + 1, m, mlen);\n            rc1 = C->xc_detached(cc, macc, cc + 1, mlen, n, k);\n            rc2 = R->xc_detached(cr, macr, cr + 1, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_detached overlap-1 mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            cmp_buf(\"xc overlap-1 mac\", 16, macc, macr);\n\n            memset(cc, 0, BUFSZ); memset(cr, 0, BUFSZ);\n            C->xc_detached(cc + 1, macc, m, mlen, n, k);\n            memcpy(cr, cc, BUFSZ); memcpy(macr, macc, 16);\n            rc1 = C->xc_open_detached(cc, cc + 1, macc, mlen, n, k);\n            rc2 = R->xc_open_detached(cr, cr + 1, macr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xc_open_detached overlap ok mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n        }\n    }\n}\n\nstatic void test_nacl_api(struct lib *C, struct lib *R)\n{\n    static unsigned char cc[BUFSZ], cr[BUFSZ], mc[BUFSZ], mr[BUFSZ];\n    unsigned char pm[BUFSZ], n[24], k[32];\n    size_t li, iter;\n    char lbl[128];\n\n    for (iter = 0; iter < 8; iter++) {\n        for (li = 0; li < NMLENS; li++) {\n            size_t mlen = mlens[li] + 32; /* ZEROBYTES padded */\n            int rc1, rc2;\n\n            rndbuf(n, 24); rndbuf(k, 32);\n            memset(pm, 0, 32);\n            rndbuf(pm + 32, mlen - 32);\n\n            memset(cc, 0xaa, BUFSZ); memset(cr, 0xaa, BUFSZ);\n            rc1 = C->secretbox(cc, pm, mlen, n, k);\n            rc2 = R->secretbox(cr, pm, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"crypto_secretbox mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n\n            memset(mc, 0xbb, BUFSZ); memset(mr, 0xbb, BUFSZ);\n            rc1 = C->secretbox_open(mc, cc, mlen, n, k);\n            rc2 = R->secretbox_open(mr, cr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"crypto_secretbox_open mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, mc, mr);\n            checks++;\n            if (rc1 != 0 || memcmp(mc, pm, mlen) != 0) {\n                printf(\"ROUNDTRIP FAIL crypto_secretbox mlen=%zu\\n\", mlen); failures++;\n            }\n\n            /* xsalsa20poly1305 directly */\n            memset(cc, 0xaa, BUFSZ); memset(cr, 0xaa, BUFSZ);\n            rc1 = C->xs(cc, pm, mlen, n, k);\n            rc2 = R->xs(cr, pm, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xsalsa20poly1305 mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            memset(mc, 0xbb, BUFSZ); memset(mr, 0xbb, BUFSZ);\n            rc1 = C->xs_open(mc, cc, mlen, n, k);\n            rc2 = R->xs_open(mr, cr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"xsalsa20poly1305_open mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, mc, mr);\n\n            /* tampered */\n            {\n                size_t pos = 16 + (size_t) (rnd8()) % (mlen - 16);\n                cc[pos] ^= 0x80; cr[pos] ^= 0x80;\n                memset(mc, 0xcc, BUFSZ); memset(mr, 0xcc, BUFSZ);\n                rc1 = C->secretbox_open(mc, cc, mlen, n, k);\n                rc2 = R->secretbox_open(mr, cr, mlen, n, k);\n                snprintf(lbl, sizeof lbl, \"crypto_secretbox_open tampered mlen=%zu\", mlen);\n                cmp_int(lbl, rc1, rc2);\n                cmp_buf(lbl, BUFSZ, mc, mr);\n                cc[pos] ^= 0x80; cr[pos] ^= 0x80;\n            }\n            /* in-place */\n            memcpy(cc, pm, mlen); memcpy(cr, pm, mlen);\n            rc1 = C->secretbox(cc, cc, mlen, n, k);\n            rc2 = R->secretbox(cr, cr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"crypto_secretbox inplace mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n            rc1 = C->secretbox_open(cc, cc, mlen, n, k);\n            rc2 = R->secretbox_open(cr, cr, mlen, n, k);\n            snprintf(lbl, sizeof lbl, \"crypto_secretbox_open inplace mlen=%zu\", mlen);\n            cmp_int(lbl, rc1, rc2);\n            cmp_buf(lbl, BUFSZ, cc, cr);\n        }\n    }\n    /* clen/mlen < 32 -> -1 */\n    {\n        size_t l;\n        for (l = 0; l < 32; l++) {\n            cmp_int(\"crypto_secretbox short\", C->secretbox(cc, pm, l, n, k),\n                    R->secretbox(cr, pm, l, n, k));\n            cmp_int(\"crypto_secretbox_open short\", C->secretbox_open(mc, cc, l, n, k),\n                    R->secretbox_open(mr, cr, l, n, k));\n        }\n    }\n}\n\n/* ------------------------------------------------------------------ */\n\nstatic void test_secretstream(struct lib *C, struct lib *R)\n{\n    size_t stlen = C->ss_statebytes();\n    unsigned char *stc = malloc(stlen + 64), *str = malloc(stlen + 64);\n    static unsigned char oc[BUFSZ], orr[BUFSZ], dc[BUFSZ], dr[BUFSZ];\n    unsigned char header[24], k[32], m[BUFSZ], ad[300];\n    unsigned char tags[4];\n    size_t li, iter, ti, adli;\n    static const size_t adlens[] = { 0, 1, 7, 15, 16, 17, 31, 32, 100, 257 };\n    char lbl[160];\n\n    tags[0] = C->ss_tag_message();\n    tags[1] = C->ss_tag_push();\n    tags[2] = C->ss_tag_rekey();\n    tags[3] = C->ss_tag_final();\n\n    /* init_push determinism cannot be compared (random header), but check\n     * that a header from init_push feeds init_pull identically. */\n    {\n        int rc1, rc2;\n        rndbuf(k, 32);\n        memset(stc, 0x5a, stlen + 64); memset(str, 0x5a, stlen + 64);\n        rc1 = C->ss_init_push(stc, header, k);\n        cmp_int(\"ss_init_push rc\", rc1, 0);\n        rc2 = R->ss_init_push(str, header, k);\n        cmp_int(\"ss_init_push rc rust\", rc2, 0);\n        checks++;\n        if (memcmp(stc + stlen, str + stlen, 64) != 0) {\n            printf(\"MISMATCH ss_init_push wrote past statebytes\\n\"); failures++;\n        }\n    }\n\n    for (iter = 0; iter < 6; iter++) {\n        rndbuf(k, 32); rndbuf(header, 24);\n        for (ti = 0; ti < 4; ti++) {\n            for (li = 0; li < NMLENS; li++) {\n                for (adli = 0; adli < sizeof adlens / sizeof adlens[0]; adli++) {\n                    size_t mlen = mlens[li];\n                    size_t adlen = adlens[adli];\n                    unsigned long long olc = 0, olr = 0;\n                    unsigned long long dlc = 0, dlr = 0;\n                    unsigned char tc = 0, tr = 0;\n                    int rc1, rc2;\n                    int seq;\n\n                    rndbuf(m, mlen); rndbuf(ad, adlen);\n\n                    memset(stc, 0, stlen + 64); memset(str, 0, stlen + 64);\n                    memset(stc + stlen, 0x77, 64); memset(str + stlen, 0x77, 64);\n                    cmp_int(\"ss_init_pull\", C->ss_init_pull(stc, header, k),\n                            R->ss_init_pull(str, header, k));\n                    cmp_buf(\"ss_init_pull state\", stlen + 64, stc, str);\n\n                    /* three pushes in a row on the same states */\n                    for (seq = 0; seq < 3; seq++) {\n                        memset(oc, 0xaa, BUFSZ); memset(orr, 0xaa, BUFSZ);\n                        rc1 = C->ss_push(stc, oc, &olc, m, mlen,\n                                         adlen ? ad : NULL, adlen, tags[ti]);\n                        rc2 = R->ss_push(str, orr, &olr, m, mlen,\n                                         adlen ? ad : NULL, adlen, tags[ti]);\n                        snprintf(lbl, sizeof lbl,\n                                 \"ss_push mlen=%zu adlen=%zu tag=%u seq=%d\",\n                                 mlen, adlen, tags[ti], seq);\n                        cmp_int(lbl, rc1, rc2);\n                        cmp_u64(lbl, olc, olr);\n                        cmp_buf(lbl, BUFSZ, oc, orr);\n                        cmp_buf(\"ss_push state\", stlen + 64, stc, str);\n                    }\n\n                    /* pull side */\n                    memset(stc, 0, stlen + 64); memset(str, 0, stlen + 64);\n                    memset(stc + stlen, 0x77, 64); memset(str + stlen, 0x77, 64);\n                    C->ss_init_pull(stc, header, k);\n                    R->ss_init_pull(str, header, k);\n                    /* recompute the three ciphertexts with C, decrypt with both */\n                    {\n                        unsigned char *sp = malloc(stlen);\n                        static unsigned char cts[3][BUFSZ];\n                        unsigned long long ctl[3];\n                        memcpy(sp, stc, stlen);\n                        for (seq = 0; seq < 3; seq++) {\n                            C->ss_push(sp, cts[seq], &ctl[seq], m, mlen,\n                                       adlen ? ad : NULL, adlen, tags[ti]);\n                        }\n                        free(sp);\n                        for (seq = 0; seq < 3; seq++) {\n                            memset(dc, 0xbb, BUFSZ); memset(dr, 0xbb, BUFSZ);\n                            rc1 = C->ss_pull(stc, dc, &dlc, &tc, cts[seq], ctl[seq],\n                                             adlen ? ad : NULL, adlen);\n                            rc2 = R->ss_pull(str, dr, &dlr, &tr, cts[seq], ctl[seq],\n                                             adlen ? ad : NULL, adlen);\n                            snprintf(lbl, sizeof lbl,\n                                     \"ss_pull mlen=%zu adlen=%zu tag=%u seq=%d\",\n                                     mlen, adlen, tags[ti], seq);\n                            cmp_int(lbl, rc1, rc2);\n                            cmp_u64(lbl, dlc, dlr);\n                            cmp_sz(\"ss_pull tag\", tc, tr);\n                            cmp_buf(lbl, BUFSZ, dc, dr);\n                            cmp_buf(\"ss_pull state\", stlen + 64, stc, str);\n                            checks++;\n                            if (rc1 != 0 || tc != tags[ti] ||\n                                (mlen && memcmp(dc, m, mlen) != 0)) {\n                                printf(\"ROUNDTRIP FAIL ss %s\\n\", lbl); failures++;\n                            }\n                        }\n                        /* tampered / truncated */\n                        memset(stc, 0, stlen); memset(str, 0, stlen);\n                        C->ss_init_pull(stc, header, k);\n                        R->ss_init_pull(str, header, k);\n                        cts[0][(size_t) rnd8() % ctl[0]] ^= 0x20;\n                        memset(dc, 0xbb, BUFSZ); memset(dr, 0xbb, BUFSZ);\n                        rc1 = C->ss_pull(stc, dc, &dlc, &tc, cts[0], ctl[0],\n                                         adlen ? ad : NULL, adlen);\n                        rc2 = R->ss_pull(str, dr, &dlr, &tr, cts[0], ctl[0],\n                                         adlen ? ad : NULL, adlen);\n                        cmp_int(\"ss_pull tampered\", rc1, rc2);\n                        cmp_u64(\"ss_pull tampered mlen\", dlc, dlr);\n                        cmp_sz(\"ss_pull tampered tag\", tc, tr);\n                        cmp_buf(\"ss_pull tampered buf\", BUFSZ, dc, dr);\n                        cmp_buf(\"ss_pull tampered state\", stlen, stc, str);\n                        {\n                            size_t sl;\n                            for (sl = 0; sl < 17; sl++) {\n                                rc1 = C->ss_pull(stc, dc, &dlc, &tc, cts[0], sl,\n                                                 adlen ? ad : NULL, adlen);\n                                rc2 = R->ss_pull(str, dr, &dlr, &tr, cts[0], sl,\n                                                 adlen ? ad : NULL, adlen);\n                                cmp_int(\"ss_pull short\", rc1, rc2);\n                                cmp_u64(\"ss_pull short mlen\", dlc, dlr);\n                                cmp_sz(\"ss_pull short tag\", tc, tr);\n                            }\n                        }\n                        /* wrong ad */\n                        if (adlen) {\n                            ad[0] ^= 0xff;\n                            memset(stc, 0, stlen); memset(str, 0, stlen);\n                            C->ss_init_pull(stc, header, k);\n                            R->ss_init_pull(str, header, k);\n                            rc1 = C->ss_pull(stc, dc, &dlc, &tc, cts[1], ctl[1], ad, adlen);\n                            rc2 = R->ss_pull(str, dr, &dlr, &tr, cts[1], ctl[1], ad, adlen);\n                            cmp_int(\"ss_pull wrong ad\", rc1, rc2);\n                            cmp_buf(\"ss_pull wrong ad state\", stlen, stc, str);\n                            ad[0] ^= 0xff;\n                        }\n                        /* NULL outlen / tag pointers */\n                        memset(stc, 0, stlen); memset(str, 0, stlen);\n                        C->ss_init_pull(stc, header, k);\n                        R->ss_init_pull(str, header, k);\n                        memset(oc, 0, BUFSZ); memset(orr, 0, BUFSZ);\n                        rc1 = C->ss_push(stc, oc, NULL, m, mlen,\n                                         adlen ? ad : NULL, adlen, tags[ti]);\n                        rc2 = R->ss_push(str, orr, NULL, m, mlen,\n                                         adlen ? ad : NULL, adlen, tags[ti]);\n                        cmp_int(\"ss_push NULL outlen\", rc1, rc2);\n                        cmp_buf(\"ss_push NULL outlen buf\", BUFSZ, oc, orr);\n                        cmp_buf(\"ss_push NULL outlen state\", stlen, stc, str);\n                        memset(stc, 0, stlen); memset(str, 0, stlen);\n                        C->ss_init_pull(stc, header, k);\n                        R->ss_init_pull(str, header, k);\n                        memset(dc, 0, BUFSZ); memset(dr, 0, BUFSZ);\n                        rc1 = C->ss_pull(stc, dc, NULL, NULL, oc, mlen + 17,\n                                         adlen ? ad : NULL, adlen);\n                        rc2 = R->ss_pull(str, dr, NULL, NULL, orr, mlen + 17,\n                                         adlen ? ad : NULL, adlen);\n                        cmp_int(\"ss_pull NULL ptrs\", rc1, rc2);\n                        cmp_buf(\"ss_pull NULL ptrs buf\", BUFSZ, dc, dr);\n                        cmp_buf(\"ss_pull NULL ptrs state\", stlen, stc, str);\n                    }\n\n                    /* explicit rekey */\n                    memset(stc, 0, stlen); memset(str, 0, stlen);\n                    C->ss_init_pull(stc, header, k);\n                    R->ss_init_pull(str, header, k);\n                    C->ss_push(stc, oc, &olc, m, mlen, adlen ? ad : NULL, adlen, tags[ti]);\n                    R->ss_push(str, orr, &olr, m, mlen, adlen ? ad : NULL, adlen, tags[ti]);\n                    C->ss_rekey(stc);\n                    R->ss_rekey(str);\n                    cmp_buf(\"ss_rekey state\", stlen, stc, str);\n                    memset(oc, 0xaa, BUFSZ); memset(orr, 0xaa, BUFSZ);\n                    rc1 = C->ss_push(stc, oc, &olc, m, mlen,\n                                     adlen ? ad : NULL, adlen, tags[ti]);\n                    rc2 = R->ss_push(str, orr, &olr, m, mlen,\n                                     adlen ? ad : NULL, adlen, tags[ti]);\n                    cmp_int(\"ss_push after rekey\", rc1, rc2);\n                    cmp_u64(\"ss_push after rekey len\", olc, olr);\n                    cmp_buf(\"ss_push after rekey buf\", BUFSZ, oc, orr);\n                    cmp_buf(\"ss_push after rekey state\", stlen, stc, str);\n\n                    /* counter wrap-around triggered rekey */\n                    memset(stc, 0, stlen); memset(str, 0, stlen);\n                    C->ss_init_pull(stc, header, k);\n                    R->ss_init_pull(str, header, k);\n                    memset(stc + 32, 0xff, 4);   /* counter = 0xffffffff */\n                    memset(str + 32, 0xff, 4);\n                    memset(oc, 0xaa, BUFSZ); memset(orr, 0xaa, BUFSZ);\n                    rc1 = C->ss_push(stc, oc, &olc, m, mlen,\n                                     adlen ? ad : NULL, adlen, tags[ti]);\n                    rc2 = R->ss_push(str, orr, &olr, m, mlen,\n                                     adlen ? ad : NULL, adlen, tags[ti]);\n                    cmp_int(\"ss_push wrap\", rc1, rc2);\n                    cmp_buf(\"ss_push wrap buf\", BUFSZ, oc, orr);\n                    cmp_buf(\"ss_push wrap state\", stlen, stc, str);\n                }\n            }\n        }\n    }\n    free(stc); free(str);\n}\n\nint main(int argc, char **argv)\n{\n    struct lib C, R;\n\n    if (argc < 3) {\n        fprintf(stderr, \"usage: %s <c.so> <rust.so>\\n\", argv[0]);\n        return 2;\n    }\n    load(&C, argv[1], \"c\");\n    load(&R, argv[2], \"rust\");\n\n    test_constants(&C, &R);\n    test_secretbox_easy(&C, &R);\n    test_secretbox_xchacha(&C, &R);\n    test_nacl_api(&C, &R);\n    test_secretstream(&C, &R);\n\n    printf(\"\\n%ld comparisons, %d failures\\n\", checks, failures);\n    return failures != 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":620,"cache_read_input_tokens":107228,"cache_creation":{"ephemeral_5m_input_tokens":620,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01HkdM5yMJhgNu4gyeMCG7AU","session_id":"548cc808-00d2-470c-b99f-a8d3e7e02fd0","uuid":"264a7b6d-48cd-4135-8459-d8c2a2a62a3e","timestamp":"2026-08-22T20:25:19.200Z","subagent_type":"general-purpose","task_description":"Translate secretbox and secretstream"}
