imit_sensitive(), R.pwhash_memlimit_sensitive());\n    chk_str(\"strprefix\", C.pwhash_strprefix(), R.pwhash_strprefix());\n    chk_str(\"primitive\", C.pwhash_primitive(), R.pwhash_primitive());\n    chk_str(\"argon2i_strprefix\", C.argon2i_strprefix(), R.argon2i_strprefix());\n    chk_str(\"argon2id_strprefix\", C.argon2id_strprefix(), R.argon2id_strprefix());\n    chk_int(\"argon2i_saltbytes\", C.argon2i_saltbytes(), R.argon2i_saltbytes());\n    chk_int(\"argon2id_saltbytes\", C.argon2id_saltbytes(), R.argon2id_saltbytes());\n    chk_int(\"argon2i_opslimit_min\", C.argon2i_opslimit_min(), R.argon2i_opslimit_min());\n    chk_int(\"argon2id_opslimit_min\", C.argon2id_opslimit_min(), R.argon2id_opslimit_min());\n    chk_int(\"argon2i_memlimit_max\", C.argon2i_memlimit_max(), R.argon2i_memlimit_max());\n    chk_int(\"argon2id_memlimit_max\", C.argon2id_memlimit_max(), R.argon2id_memlimit_max());\n    chk_int(\"argon2i_alg\", C.argon2i_alg(), R.argon2i_alg());\n    chk_int(\"argon2id_alg\", C.argon2id_alg(), R.argon2id_alg());\n    chk_int(\"pick_best\", C.s_pick_best(), R.s_pick_best());\n\n    /* ---- crypto_pwhash: both algs, several params ---- */\n    {\n        static const unsigned long long outlens[] = { 16, 17, 32, 33, 64, 65, 100, 129 };\n        static const unsigned long long ops[] = { 1, 3, 4 };\n        static const size_t mems[] = { 8192, 16384, 32768, 65536 };\n        static const int algs[] = { 1, 2, 0, 3, -1 };\n        unsigned char salt[16], o1[256], o2[256];\n        char pw[64];\n        size_t si, oi, pi, mi, ai;\n        for (si = 0; si < 3; si++) {\n            for (int k = 0; k < 16; k++) salt[k] = (unsigned char) (si * 37 + k * 11 + 1);\n            for (pi = 0; pi < 3; pi++) {\n                size_t pwlen = pi == 0 ? 0 : (pi == 1 ? 1 : 33);\n                for (size_t k = 0; k < pwlen; k++) pw[k] = (char) ('a' + (k + si) % 26);\n                for (oi = 0; oi < sizeof outlens / sizeof outlens[0]; oi++) {\n                    for (mi = 0; mi < sizeof mems / sizeof mems[0]; mi++) {\n                        for (pi ? 0 : 0, ai = 0; ai < sizeof algs / sizeof algs[0]; ai++) {\n                            unsigned long long opslimit = ops[(si + oi + mi) % 3];\n                            int r1, r2, e1, e2;\n                            memset(o1, 0xAA, sizeof o1); memset(o2, 0xBB, sizeof o2);\n                            errno = 0;\n                            r1 = C.pwhash(o1, outlens[oi], pw, pwlen, salt, opslimit, mems[mi], algs[ai]);\n                            e1 = errno;\n                            errno = 0;\n                            r2 = R.pwhash(o2, outlens[oi], pw, pwlen, salt, opslimit, mems[mi], algs[ai]);\n                            e2 = errno;\n                            chk_int(\"pwhash ret\", r1, r2);\n                            if (r1 != r2) {\n                                printf(\"   params outlen=%llu ops=%llu mem=%zu alg=%d pwlen=%zu\\n\",\n                                       outlens[oi], opslimit, mems[mi], algs[ai], pwlen);\n                            }\n                            chk_int(\"pwhash errno\", e1, e2);\n                            chk_mem(\"pwhash out\", o1, o2, sizeof o1);\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    /* ---- crypto_pwhash_argon2i / argon2id direct ---- */\n    {\n        unsigned char salt[16], o1[64], o2[64];\n        for (int k = 0; k < 16; k++) salt[k] = (unsigned char) (200 - k * 3);\n        const char *pw = \"Correct Horse Battery Staple\";\n        int r1, r2, e1, e2;\n        for (int alg = 0; alg < 4; alg++) {\n            for (int f = 0; f < 2; f++) {\n                memset(o1, 1, sizeof o1); memset(o2, 2, sizeof o2);\n                errno = 0;\n                r1 = f ? C.argon2id(o1, 32, pw, strlen(pw), salt, 3, 16384, alg)\n                       : C.argon2i(o1, 32, pw, strlen(pw), salt, 3, 16384, alg);\n                e1 = errno; errno = 0;\n                r2 = f ? R.argon2id(o2, 32, pw, strlen(pw), salt, 3, 16384, alg)\n                       : R.argon2i(o2, 32, pw, strlen(pw), salt, 3, 16384, alg);\n                e2 = errno;\n                chk_int(\"argon2i/id ret\", r1, r2);\n                chk_int(\"argon2i/id errno\", e1, e2);\n                chk_mem(\"argon2i/id out\", o1, o2, sizeof o1);\n            }\n        }\n        /* error paths */\n        struct { unsigned long long outlen, ops; size_t mem; } bad[] = {\n            { 15, 3, 16384 }, { 0, 3, 16384 }, { 32, 0, 16384 }, { 32, 2, 16384 },\n            { 32, 3, 1024 }, { 32, 3, 8191 }, { 32, 3, 0 },\n            { 32, 0x100000000ULL, 16384 }, { 32, 3, (size_t) 4398046510081ULL },\n        };\n        for (size_t i = 0; i < sizeof bad / sizeof bad[0]; i++) {\n            for (int f = 0; f < 2; f++) {\n                memset(o1, 1, sizeof o1); memset(o2, 2, sizeof o2);\n                errno = 0;\n                r1 = f ? C.argon2id(o1, bad[i].outlen, pw, strlen(pw), salt, bad[i].ops, bad[i].mem, f ? 2 : 1)\n                       : C.argon2i(o1, bad[i].outlen, pw, strlen(pw), salt, bad[i].ops, bad[i].mem, 1);\n                e1 = errno; errno = 0;\n                r2 = f ? R.argon2id(o2, bad[i].outlen, pw, strlen(pw), salt, bad[i].ops, bad[i].mem, f ? 2 : 1)\n                       : R.argon2i(o2, bad[i].outlen, pw, strlen(pw), salt, bad[i].ops, bad[i].mem, 1);\n                e2 = errno;\n                chk_int(\"argon2 bad ret\", r1, r2);\n                chk_int(\"argon2 bad errno\", e1, e2);\n                chk_mem(\"argon2 bad out\", o1, o2, sizeof o1);\n            }\n        }\n    }\n\n    /* ---- _sodium_argon2_hash: deterministic raw + encoded ---- */\n    {\n        unsigned char h1[200], h2[200];\n        char e1s[512], e2s[512];\n        unsigned char salt[64];\n        for (int k = 0; k < 64; k++) salt[k] = (unsigned char) (k * 7 + 3);\n        static const size_t saltlens[] = { 8, 16, 17, 33, 64 };\n        static const size_t hashlens[] = { 16, 20, 32, 63, 64, 65, 100, 129, 200 };\n        static const uint32_t tcosts[] = { 1, 2, 3 };\n        static const uint32_t mcosts[] = { 8, 16, 32, 64 };\n        static const uint32_t pars[] = { 1, 2, 3 };\n        const char *pw = \"hunter2\";\n        for (size_t sl = 0; sl < 5; sl++)\n            for (size_t hl = 0; hl < 9; hl++)\n                for (size_t t = 0; t < 3; t++)\n                    for (size_t m = 0; m < 4; m++)\n                        for (size_t p = 0; p < 3; p++) {\n                            int r1, r2;\n                            memset(h1, 0, sizeof h1); memset(h2, 0, sizeof h2);\n                            memset(e1s, 0, sizeof e1s); memset(e2s, 0, sizeof e2s);\n                            r1 = C.s_argon2_hash(tcosts[t], mcosts[m], pars[p], pw, strlen(pw),\n                                                 salt, saltlens[sl], h1, hashlens[hl], e1s,\n                                                 sizeof e1s, (m + t + p) % 2 ? 1 : 2);\n                            r2 = R.s_argon2_hash(tcosts[t], mcosts[m], pars[p], pw, strlen(pw),\n                                                 salt, saltlens[sl], h2, hashlens[hl], e2s,\n                                                 sizeof e2s, (m + t + p) % 2 ? 1 : 2);\n                            chk_int(\"argon2_hash ret\", r1, r2);\n                            if (r1 == 0) {\n                                chk_mem(\"argon2_hash raw\", h1, h2, hashlens[hl]);\n                                chk_str(\"argon2_hash encoded\", e1s, e2s);\n                            }\n                        }\n        /* encoded-only / raw-only entry points */\n        for (size_t hl = 0; hl < 9; hl++) {\n            int r1, r2;\n            memset(e1s, 0, sizeof e1s); memset(e2s, 0, sizeof e2s);\n            r1 = C.s_argon2i_hash_encoded(3, 16, 1, pw, strlen(pw), salt, 16, hashlens[hl], e1s, sizeof e1s);\n            r2 = R.s_argon2i_hash_encoded(3, 16, 1, pw, strlen(pw), salt, 16, hashlens[hl], e2s, sizeof e2s);\n            chk_int(\"argon2i_hash_encoded ret\", r1, r2);\n            chk_str(\"argon2i_hash_encoded\", e1s, e2s);\n            memset(e1s, 0, sizeof e1s); memset(e2s, 0, sizeof e2s);\n            r1 = C.s_argon2id_hash_encoded(3, 16, 1, pw, strlen(pw), salt, 16, hashlens[hl], e1s, sizeof e1s);\n            r2 = R.s_argon2id_hash_encoded(3, 16, 1, pw, strlen(pw), salt, 16, hashlens[hl], e2s, sizeof e2s);\n            chk_int(\"argon2id_hash_encoded ret\", r1, r2);\n            chk_str(\"argon2id_hash_encoded\", e1s, e2s);\n            memset(h1, 0, sizeof h1); memset(h2, 0, sizeof h2);\n            r1 = C.s_argon2i_hash_raw(3, 16, 1, pw, strlen(pw), salt, 16, h1, hashlens[hl]);\n            r2 = R.s_argon2i_hash_raw(3, 16, 1, pw, strlen(pw), salt, 16, h2, hashlens[hl]);\n            chk_int(\"argon2i_hash_raw ret\", r1, r2);\n            if (r1 == 0) chk_mem(\"argon2i_hash_raw\", h1, h2, hashlens[hl]);\n            memset(h1, 0, sizeof h1); memset(h2, 0, sizeof h2);\n            r1 = C.s_argon2id_hash_raw(3, 16, 1, pw, strlen(pw), salt, 16, h1, hashlens[hl]);\n            r2 = R.s_argon2id_hash_raw(3, 16, 1, pw, strlen(pw), salt, 16, h2, hashlens[hl]);\n            chk_int(\"argon2id_hash_raw ret\", r1, r2);\n            if (r1 == 0) chk_mem(\"argon2id_hash_raw\", h1, h2, hashlens[hl]);\n        }\n        /* small encoded buffers -> ENCODING_FAIL paths */\n        for (size_t el = 0; el < 90; el += 3) {\n            int r1, r2;\n            memset(e1s, 0, sizeof e1s); memset(e2s, 0, sizeof e2s);\n            r1 = C.s_argon2i_hash_encoded(3, 16, 1, pw, strlen(pw), salt, 16, 32, e1s, el);\n            r2 = R.s_argon2i_hash_encoded(3, 16, 1, pw, strlen(pw), salt, 16, 32, e2s, el);\n            chk_int(\"argon2i_hash_encoded small ret\", r1, r2);\n            chk_mem(\"argon2i_hash_encoded small buf\", e1s, e2s, sizeof e1s);\n        }\n        /* invalid params to argon2_hash */\n        struct { uint32_t t, m, p; size_t sl, hl; int type; } bad[] = {\n            { 0, 16, 1, 16, 32, 2 }, { 1, 0, 1, 16, 32, 2 }, { 1, 4, 1, 16, 32, 2 },\n            { 1, 16, 0, 16, 32, 2 }, { 1, 16, 1, 7, 32, 2 }, { 1, 16, 1, 16, 15, 2 },\n            { 1, 16, 1, 16, 32, 0 }, { 1, 16, 1, 16, 32, 3 }, { 1, 8, 2, 16, 32, 1 },\n            { 1, 16, 1, 0, 32, 1 },\n        };\n        for (size_t i = 0; i < sizeof bad / sizeof bad[0]; i++) {\n            int r1, r2;\n            memset(e1s, 0, sizeof e1s); memset(e2s, 0, sizeof e2s);\n            r1 = C.s_argon2_hash(bad[i].t, bad[i].m, bad[i].p, pw, strlen(pw), salt, bad[i].sl,\n                                 NULL, bad[i].hl, e1s, sizeof e1s, bad[i].type);\n            r2 = R.s_argon2_hash(bad[i].t, bad[i].m, bad[i].p, pw, strlen(pw), salt, bad[i].sl,\n                                 NULL, bad[i].hl, e2s, sizeof e2s, bad[i].type);\n            chk_int(\"argon2_hash bad ret\", r1, r2);\n            chk_str(\"argon2_hash bad encoded\", e1s, e2s);\n        }\n    }\n\n    /* ---- verify: good / bad password / malformed ---- */\n    {\n        char enc_i[256], enc_id[256];\n        unsigned char salt[16];\n        const char *pw = \"s3cr3t\";\n        for (int k = 0; k < 16; k++) salt[k] = (unsigned char) (k + 100);\n        if (C.s_argon2i_hash_encoded(3, 32, 1, pw, strlen(pw), salt, 16, 32, enc_i, sizeof enc_i))\n            { printf(\"setup fail\\n\"); return 2; }\n        if (C.s_argon2id_hash_encoded(3, 32, 1, pw, strlen(pw), salt, 16, 32, enc_id, sizeof enc_id))\n            { printf(\"setup fail\\n\"); return 2; }\n        const char *strs[] = {\n            enc_i, enc_id, \"\", \"$\", \"$argon2i$\", \"$argon2id$\",\n            \"$argon2i$v=19$m=32,t=3,p=1$\",\n            \"$argon2i$v=18$m=32,t=3,p=1$ZGhkaGRoZGhkaGRoZGhkaA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n            \"$argon2i$v=19$m=32,t=3,p=1$ZGhkaGRoZGhkaGRoZGhkaA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\",\n            \"$argon2id$v=19$m=32,t=3,p=1$ZGhkaGRoZGhkaGRoZGhkaA$AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA