        return -1;\n    57\t    }\n    58\t    fe25519_1(one_minus_y);\n    59\t    /* assumes A.Z=1 */\n    60\t    fe25519_sub(one_minus_y, one_minus_y, A.Y);\n    61\t    fe25519_1(x);\n    62\t    fe25519_add(x, x, A.Y);\n    63\t    fe25519_invert(one_minus_y, one_minus_y);\n    64\t    fe25519_mul(x, x, one_minus_y);\n    65\t    fe25519_tobytes(curve25519_pk, x);\n    66\t\n    67\t    return 0;\n    68\t}\n    69\t\n    70\tint\n    71\tcrypto_sign_ed25519_sk_to_curve25519(unsigned char *curve25519_sk,\n    72\t                                     const unsigned char *ed25519_sk)\n    73\t{\n    74\t    unsigned char h[crypto_hash_sha512_BYTES];\n    75\t\n    76\t    crypto_hash_sha512(h, ed25519_sk, 32);\n    77\t    h[0] &= 248;\n    78\t    h[31] &= 127;\n    79\t    h[31] |= 64;\n    80\t    memcpy(curve25519_sk, h, crypto_scalarmult_curve25519_BYTES);\n    81\t    sodium_memzero(h, sizeof h);\n    82\t\n    83\t    return 0;\n    84\t}\n===== c_src/libsodium/crypto_sign/ed25519/ref10/sign.c =====\n     1\t\n     2\t#include <string.h>\n     3\t\n     4\t#include \"crypto_hash_sha512.h\"\n     5\t#include \"crypto_sign_ed25519.h\"\n     6\t#include \"sign_ed25519_ref10.h\"\n     7\t#include \"private/ed25519_ref10.h\"\n     8\t#include \"randombytes.h\"\n     9\t#include \"utils.h\"\n    10\t\n    11\tvoid\n    12\t_crypto_sign_ed25519_ref10_hinit(crypto_hash_sha512_state *hs, int prehashed)\n    13\t{\n    14\t    static const unsigned char DOM2PREFIX[32 + 2] = {\n    15\t        'S', 'i', 'g', 'E', 'd', '2', '5', '5', '1', '9', ' ',\n    16\t        'n', 'o', ' ',\n    17\t        'E', 'd', '2', '5', '5', '1', '9', ' ',\n    18\t        'c', 'o', 'l', 'l', 'i', 's', 'i', 'o', 'n', 's', 1, 0\n    19\t    };\n    20\t\n    21\t    crypto_hash_sha512_init(hs);\n    22\t    if (prehashed) {\n    23\t        crypto_hash_sha512_update(hs, DOM2PREFIX, sizeof DOM2PREFIX);\n    24\t    }\n    25\t}\n    26\t\n    27\tstatic inline void\n    28\t_crypto_sign_ed