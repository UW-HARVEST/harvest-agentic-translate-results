;\n    SYM(L, argon2i_alg, \"crypto_pwhash_argon2i_alg_argon2i13\");\n    SYM(L, argon2id_alg, \"crypto_pwhash_argon2id_alg_argon2id13\");\n    SYM(L, s_argon2_hash, \"_sodium_argon2_hash\");\n    SYM(L, s_argon2_verify, \"_sodium_argon2_verify\");\n    SYM(L, s_argon2i_hash_raw, \"_sodium_argon2i_hash_raw\");\n    SYM(L, s_argon2i_hash_encoded, \"_sodium_argon2i_hash_encoded\");\n    SYM(L, s_argon2id_hash_raw, \"_sodium_argon2id_hash_raw\");\n    SYM(L, s_argon2id_hash_encoded, \"_sodium_argon2id_hash_encoded\");\n    SYM(L, s_argon2i_verify, \"_sodium_argon2i_verify\");\n    SYM(L, s_argon2id_verify, \"_sodium_argon2id_verify\");\n    SYM(L, s_blake2b_long, \"_sodium_blake2b_long\");\n    SYM(L, s_argon2_ctx, \"_sodium_argon2_ctx\");\n    SYM(L, s_argon2_validate_inputs, \"_sodium_argon2_validate_inputs\");\n    SYM(L, s_argon2_encode_string, \"_sodium_argon2_encode_string\");\n    SYM(L, s_argon2_decode_string, \"_sodium_argon2_decode_string\");\n    SYM(L, s_pick_best, \"_crypto_pwhash_argon2_pick_best_implementation\");\n}\n\nstatic lib_t C, R;\n\nstatic void fail(const char *what)\n{\n    if (failures < 40) printf(\"MISMATCH: %s\\n\", what);\n    failures++;\n}\nstatic void chk_int(const char *what, long long a, long long b)\n{\n    checks++;\n    if (a != b) { char buf[512]; snprintf(buf, sizeof buf, \"%s (c=%lld rust=%lld)\", what, a, b); fail(buf); }\n}\nstatic void chk_mem(const char *what, const void *a, const void *b, size_t n)\n{\n    checks++;\n    if (memcmp(a, b, n) != 0) {\n        char buf[512]; snprintf(buf, sizeof buf, \"%s (memcmp %zu bytes)\", what, n); fail(buf);\n    }\n}\nstatic void chk_str(const char *what, const char *a, const char *b)\n{\n    checks++;\n    if (strcmp(a, b) != 0) {\n        char buf[1024]; snprintf(buf, sizeof buf, \"%s\\n  c   =[%s]\\n  rust=[%s]\", what, a, b); fail(buf);\n    }\n}\n\n/* argon2_context, 96 bytes on x86-64 */\ntypedef struct {\n    uint8_t *out; uint32_t outlen;\n    uint8_t *pwd; uint32_t pwdlen;\n   