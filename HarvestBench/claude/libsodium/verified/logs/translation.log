 in Argon2i\n/// to generate reference block positions\npub const ARGON2_ADDRESSES_IN_BLOCK: u32 = 128;\n\n/// Pre-hashing digest length and its extension\npub const ARGON2_PREHASH_DIGEST_LENGTH: usize = 64;\npub const ARGON2_PREHASH_SEED_LENGTH: usize = 72;\n\n// ---------------------------------------------------------------------------\n// argon2-core.h -- internal data types\n// ---------------------------------------------------------------------------\n\n/// `typedef struct block_ { uint64_t v[ARGON2_QWORDS_IN_BLOCK]; } block;`\n/// (`sizeof == 1024`)\n#[repr(C)]\npub struct block {\n    pub v: [u64; ARGON2_QWORDS_IN_BLOCK],\n}\n\nimpl block {\n    #[inline(always)]\n    pub const fn new() -> Self {\n        block {\n            v: [0u64; ARGON2_QWORDS_IN_BLOCK],\n        }\n    }\n}\n\n/// ```c\n/// typedef struct block_region_ {\n///     void * base;\n///     block *memory;\n///     size_t size;\n/// } block_region;\n/// ```\n/// (`sizeof == 24`; offsets 0, 8, 16)\n#[repr(C)]\npub struct block_region {\n    pub base: *mut c_void,\n    pub memory: *mut block,\n    pub size: usize,\n}\n\n/// ```c\n/// typedef struct Argon2_instance_t {\n///     block_region *region;\n///     uint64_t     *pseudo_rands;\n///     uint32_t      passes;\n///     uint32_t      current_pass;\n///     uint32_t      memory_blocks;\n///     uint32_t      segment_length;\n///     uint32_t      lane_length;\n///     uint32_t      lanes;\n///     uint32_t      threads;\n///     argon2_type   type;\n///     int           print_internals;\n/// } argon2_instance_t;\n/// ```\n/// (`sizeof == 56`; offsets 0, 8, 16, 20, 24, 28, 32, 36, 40, 44, 48)\n#[repr(C)]\npub struct argon2_instance_t {\n    pub region: *mut block_region,\n    pub pseudo_rands: *mut u64,\n    pub passes: u32,\n    pub current_pass: u32,\n    pub memory_blocks: u32,\n    pub segment_length: u32,\n    pub lane_length: u32,\n    pub lanes: u32,\n    pub threads: u32,\n    /// `argon2_type type;`\n    pub type_: argon2_type,\n    pub print_internals: c_int,\n}\n\nimpl argon2_instance_t {\n    #[inline(always)]\n    pub const fn zeroed() -> Self {\n        argon2_instance_t {\n            region: core::ptr::null_mut(),\n            pseudo_rands: core::ptr::null_mut(),\n            passes: 0,\n            current_pass: 0,\n            memory_blocks: 0,\n            segment_length: 0,\n            lane_length: 0,\n            lanes: 0,\n            threads: 0,\n            type_: 0,\n            print_internals: 0,\n        }\n    }\n}\n\n/// ```c\n/// typedef struct Argon2_position_t {\n///     uint32_t pass;\n///     uint32_t lane;\n///     uint8_t  slice;\n///     uint32_t index;\n/// } argon2_position_t;\n/// ```\n/// (`sizeof == 16`; offsets 0, 4, 8, 12)\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct argon2_position_t {\n    pub pass: u32,\n    pub lane: u32,\n    pub slice: u8,\n    pub index: u32,\n}\n\nimpl argon2_position_t {\n    #[inline(always)]\n    pub const fn zeroed() -> Self {\n        argon2_position_t {\n            pass: 0,\n            lane: 0,\n            slice: 0,\n            index: 0,\n        }\n    }\n}\n\n/// ```c\n/// typedef struct Argon2_thread_data {\n///     argon2_instance_t *instance_ptr;\n///     argon2_position_t  pos;\n/// } argon2_thread_data;\n/// ```\n#[repr(C)]\npub struct argon2_thread_data {\n    pub instance_ptr: *mut argon2_instance_t,\n    pub pos: argon2_position_t,\n}\n\n// ---------------------------------------------------------------------------\n// argon2-core.h -- functions that work with the block\n// ---------------------------------------------------------------------------\n\n/// `static inline void init_block_value(block *b, uint8_t in)`\n#[inline(always)]\npub unsafe fn init_block_value(b: *mut block, in_: u8) {\n    unsafe { memset((*b).v.as_mut_ptr() as *mut u8, in_, 8 * ARGON2_QWORDS_IN_BLOCK) };\n}\n\n/// `static inline void copy_block(block *dst, const block *src)`\n#[inline(always)]\npub unsafe fn copy_block(dst: *mut block, src: *const block) {\n    unsafe {\n        crate::common::memcpy(\n            (*dst).v.as_mut_ptr() as *mut u8,\n            (*src).v.as_ptr() as *const u8,\n            8 * ARGON2_QWORDS_IN_BLOCK,\n        )\n    };\n}\n\n/// `static inline void xor_block(block *dst, const block *src)`\n#[inline(always)]\npub unsafe fn xor_block(dst: *mut block, src: *const block) {\n    let mut i: usize = 0;\n    while i < ARGON2_QWORDS_IN_BLOCK {\n        unsafe { (*dst).v[i] ^= (*src).v[i] };\n        i += 1;\n    }\n}\n\n// ---------------------------------------------------------------------------\n// argon2-core.h -- `static uint32_t index_alpha(...)`\n//\n// `static` in the header: every translation unit that includes it gets its own\n// private copy. Only the fill-block implementations use it.\n// ---------------------------------------------------------------------------\n\npub unsafe fn index_alpha(\n    instance: *const argon2_instance_t,\n    position: *const argon2_position_t,\n    pseudo_rand: u32,\n    same_lane: c_int,\n) -> u32 {\n    let reference_area_size: u32;\n    let mut relative_position: u64;\n    let mut absolute_position: u64;\n    let mut start_position: u32;\n\n    if unsafe { (*position).pass } == 0 {\n        /* First pass */\n        if unsafe { (*position).slice } == 0 {\n            /* First slice */\n            reference_area_size = unsafe { (*position).index }.wrapping_sub(1);\n        /* all but the previous */\n        } else {\n            if same_lane != 0 {\n                /* The same lane => add current segment */\n                reference_area_size = (unsafe { (*position).slice } as u32)\n                    .wrapping_mul(unsafe { (*instance).segment_length })\n                    .wrapping_add(unsafe { (*position).index })\n                    .wrapping_sub(1);\n            } else {\n                reference_area_size = (unsafe { (*position).slice } as u32)\n                    .wrapping_mul(unsafe { (*instance).segment_length })\n                    .wrapping_add(if unsafe { (*position).index } == 0 {\n                        (-1i32) as u32\n                    } else {\n                        0\n                    });\n            }\n        }\n    } else {\n        /* Second pass */\n        if same_lane != 0 {\n            reference_area_size = unsafe { (*instance).lane_length }\n                .wrapping_sub(unsafe { (*instance).segment_length })\n                .wrapping_add(unsafe { (*position).index })\n                .wrapping_sub(1);\n        } else {\n            reference_area_size = unsafe { (*instance).lane_length }\n                .wrapping_sub(unsafe { (*instance).segment_length })\n                .wrapping_add(if unsafe { (*position).index } == 0 {\n                    (-1i32) as u32\n                } else {\n                    0\n                });\n        }\n    }\n\n    /* 1.2.4. Mapping pseudo_rand to 0..<reference_area_size-1> and produce\n     * relative position */\n    relative_position = pseudo_rand as u64;\n    relative_position = relative_position.wrapping_mul(relative_position) >> 32;\n    /* `reference_area_size - 1` is computed in `uint32_t` and only then\n       widened to `uint64_t`. */\n    relative_position = (reference_area_size.wrapping_sub(1) as u64).wrapping_sub(\n        (reference_area_size as u64).wrapping_mul(relative_position) >> 32,\n    );\n\n    /* 1.2.5 Computing starting position */\n    start_position = 0;\n\n    if unsafe { (*position).pass } != 0 {\n        start_position = if (unsafe { (*position).slice } as u32) == ARGON2_SYNC_POINTS - 1 {\n            0\n        } else {\n            (unsafe { (*position).slice } as u32 + 1)\n                .wrapping_mul(unsafe { (*instance).segment_length })\n        };\n    }\n\n    /* 1.2.6. Computing absolute position */\n    absolute_position = (start_position as u64)\n        .wrapping_add(relative_position)\n        .wrapping_sub(unsafe { (*instance).lane_length } as u64);\n    absolute_position = absolute_position\n        .wrapping_add((unsafe { (*instance).lane_length } as u64) & (absolute_position >> 32));\n\n    absolute_position as u32\n}\n\n// ---------------------------------------------------------------------------\n// argon2-core.c\n// ---------------------------------------------------------------------------\n\n/// `crypto_generichash_blake2b_state` from\n/// `include/sodium/crypto_generichash_blake2b.h`: an opaque 384-byte buffer\n/// with `CRYPTO_ALIGN(64)`.\n#[repr(C, align(64))]\nstruct crypto_generichash_blake2b_state {\n    opaque: [u8; 384],\n}\n\nunsafe extern \"C\" {\n    fn crypto_generichash_blake2b_init(\n        state: *mut crypto_generichash_blake2b_state,\n        key: *const u8,\n        keylen: usize,\n        outlen: usize,\n    ) -> c_int;\n    fn crypto_generichash_blake2b_update(\n        state: *mut crypto_generichash_blake2b_state,\n        in_: *const u8,\n        inlen: u64,\n    ) -> c_int;\n    fn crypto_generichash_blake2b_final(\n        state: *mut crypto_generichash_blake2b_state,\n        out: *mut u8,\n        outlen: usize,\n    ) -> c_int;\n}\n\n/// `typedef void (*fill_segment_fn)(const argon2_instance_t *instance,\n///                                 argon2_position_t position);`\npub type fill_segment_fn = unsafe extern \"C\" fn(*const argon2_instance_t, argon2_position_t);\n\n/// `static fill_segment_fn fill_segment = argon2_fill_segment_ref;`\nstatic mut fill_segment: fill_segment_fn =\n    crate::crypto_pwhash::argon2::fill_block_ref::_sodium_argon2_fill_segment_ref;\n\n/// `static void load_block(block *dst, const void *input)`\nunsafe fn load_block(dst: *mut block, input: *const c_void) {\n    let mut i: usize = 0;\n    while i < ARGON2_QWORDS_IN_BLOCK {\n        unsafe { (*dst).v[i] = load64_le((input as *const u8).add(i * 8)) };\n        i += 1;\n    }\n}\n\n/// `static void store_block(void *output, const block *src)`\nunsafe fn store_block(output: *mut c_void, src: *const block) {\n    let