A and B */\nstatic void pipeline(L_t *A, L_t *B, uint32_t t, uint32_t m, uint32_t lanes, int type,\n                     const char *pw, const unsigned char *salt, size_t saltlen,\n                     unsigned char *out, uint32_t outlen)\n{\n    ctx_t c; inst_t inst; uint32_t mb, sl, pass;\n    memset(&c, 0, sizeof c); memset(&inst, 0, sizeof inst);\n    c.out = out; c.outlen = outlen;\n    c.pwd = (uint8_t *) pw; c.pwdlen = (uint32_t) strlen(pw);\n    c.salt = (uint8_t *) salt; c.saltlen = (uint32_t) saltlen;\n    c.t_cost = t; c.m_cost = m; c.lanes = lanes; c.threads = lanes;\n    mb = m; if (mb < 8 * lanes) mb = 8 * lanes;\n    sl = mb / (lanes * 4); mb = sl * lanes * 4;\n    inst.region = NULL; inst.passes = t; inst.current_pass = ~0U;\n    inst.memory_blocks = mb; inst.segment_length = sl; inst.lane_length = sl * 4;\n    inst.lanes = lanes; inst.threads = lanes; inst.type = type;\n    if (A->init(&inst, &c) != 0) { printf(\"init failed\\n\"); exit(2); }\n    for (pass = 0; pass < inst.passes; pass++) B->fill(&inst, pass);\n    B->fin(&c, &inst);\n}\n\nint main(void)\n{\n    L_t C, R; char pC[512], pR[512];\n    snprintf(pC, sizeof pC, \"%s/cbuild/libsodium.so\", getenv(\"TMPDIR\"));\n    snprintf(pR, sizeof pR, \"%s/target/release/libsodium.so\", getenv(\"REPO\"));\n    ld(&C, pC); ld(&R, pR);\n    unsigned char salt[16], ref[64], o[64];\n    int fails = 0, checks = 0;\n    for (int k = 0; k < 16; k++) salt[k] = (unsigned char) (k * 5 + 2);\n    struct { uint32_t t, m, lanes; int type; uint32_t outlen; } cs[] = {\n        { 1, 8, 1, 2, 32 }, { 2, 16, 1, 1, 32 }, { 3, 64, 3, 2, 64 }, { 1, 32, 2, 1, 16 },\n        { 4, 24, 3, 2, 48 },\n    };\n    for (size_t i = 0; i < sizeof cs / sizeof cs[0]; i++) {\n        memset(ref, 0, sizeof ref);\n        if (C.hash_raw(cs[i].t, cs[i].m, cs[i].lanes, \"hunter2\", 7, salt, 16, ref, cs[i].outlen))\n            { printf(\"ref fail\\n\"); return 2; }\n        L_t *libs[2] = { &C, &R };\n        for (int a = 0; a < 2; a++) f