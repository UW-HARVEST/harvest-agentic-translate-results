(k(1) << 8) | (k(2) << 16) | (k(3) << 24);\n174\t    w[1] = k(4) | (k(5) << 8) | (k(6) << 16) | (k(7) << 24);\n175\t    w[2] = k(8) | (k(9) << 8) | (k(10) << 16) | (k(11) << 24);\n176\t    w[3] = k(12) | (k(13) << 8) | (k(14) << 16) | (k(15) << 24);\n177\t    w[4] = k(16) | (k(17) << 8) | (k(18) << 16) | (k(19) << 24);\n178\t    w[5] = k(20) | (k(21) << 8) | (k(22) << 16) | (k(23) << 24);\n179\t    w[6] = k(24) | (k(25) << 8) | (k(26) << 16) | (k(27) << 24);\n180\t    w[7] = k(28) | (k(29) << 8) | (k(30) << 16) | (k(31) << 24);\n181\t\n182\t    for i in 8..60usize {\n183\t        let mut temp = w[i - 1];\n184\t        if i % 8 == 0 {\n185\t            temp = sub_word(rot_word(temp)) ^ (RCON[i / 8] as u32);\n186\t        } else if i % 8 == 4 {\n187\t            temp = sub_word(temp);\n188\t        }\n189\t        w[i] = w[i - 8] ^ temp;\n190\t    }\n191\t\n192\t    for i in 0..15usize {\n193\t        unsafe {\n194\t            (*rkeys.add(i)).w0 = w[i * 4 + 0];\n195\t            (*rkeys.add(i)).w1 = w[i * 4 + 1];\n196\t            (*rkeys.add(i)).w2 = w[i * 4 + 2];\n197\t            (*rkeys.add(i)).w3 = w[i * 4 + 3];\n198\t        }\n199\t    }\n200\t}\n201\t\n202\t/// `static inline uint8_t xtime(uint8_t a)`\n203\t#[inline(always)]\n204\tfn xtime(a: u8) -> u8 {\n205\t    (((a as u32) << 1) ^ ((((a as u32) >> 7) & 1) * 0x1b)) as u8\n206\t}\n207\t\n208\t/// `static inline uint8_t gf_mul_09(uint8_t a)`\n209\t#[inline(always)]\n210\tfn gf_mul_09(a: u8) -> u8 {\n211\t    xtime(xtime(xtime(a))) ^ a\n212\t}\n213\t\n214\t/// `static inline uint8_t gf_mul_0b(uint8_t a)`\n215\t#[inline(always)]\n216\tfn gf_mul_0b(a: u8) -> u8 {\n217\t    xtime(xtime(xtime(a)) ^ a) ^ a\n218\t}\n219\t\n220\t/// `static inline uint8_t gf_mul_0d(uint8_t a)`\n221\t#[inline(always)]\n222\tfn gf_mul_0d(a: u8) -> u8 {\n223\t    xtime(xtime(xtime(a) ^ a)) ^ a\n224\t}\n225\t\n226\t/// `static inline uint8_t gf_mul_0e(uint8_t a)`\n227\t#[inline(always)]\n228\tfn gf_mul_0e(a: u8) -> u8 {\n229\t    xtime(xtime(xtime(a) ^ a) ^ a)\n230\t}\n231\t\n232\t/// `static uint32_t inv_mix_column(uint32_t col)`\n233\tfn inv_mix_column(col: u32) -> u32 {\n234\t    let b0 = col as u8;\n235\t    let b1 = (col >> 8) as u8;\n236\t    let b2 = (col >> 16) as u8;\n237\t    let b3 = (col >> 24) as u8;\n238\t\n239\t    let r0 = gf_mul_0e(b0) ^ gf_mul_0b(b1) ^ gf_mul_0d(b2) ^ gf_mul_09(b3);\n240\t    let r1 = gf_mul_09(b0) ^ gf_mul_0e(b1) ^ gf_mul_0b(b2) ^ gf_mul_0d(b3);\n241\t    let r2 = gf_mul_0d(b0) ^ gf_mul_09(b1) ^ gf_mul_0e(b2) ^ gf_mul_0b(b3);\n242\t    let r3 = gf_mul_0b(b0) ^ gf_mul_0d(b1) ^ gf_mul_09(b2) ^ gf_mul_0e(b3);\n243\t\n244\t    (r0 as u32) | ((r1 as u32) << 8) | ((r2 as u32) << 16) | ((r3 as u32) << 24)\n245\t}\n246\t\n247\t/// Body of `softaes_inv_mix_columns()`, callable from Rust without going\n248\t/// through the `extern \"C\"` entry point.\n249\t#[inline(always)]\n250\tpub fn softaes_inv_mix_columns(block: SoftAesBlock) -> SoftAesBlock {\n251\t    SoftAesBlock {\n252\t        w0: inv_mix_column(block.w0),\n253\t        w1: inv_mix_column(block.w1),\n254\t        w2: inv_mix_column(block.w2),\n255\t        w3: inv_mix_column(block.w3),\n256\t    }\n257\t}\n258\t\n259\t/// `SoftAesBlock softaes_inv_mix_columns(const SoftAesBlock block)`\n260\t#[unsafe(no_mangle)]\n261\tpub unsafe extern \"C\" fn _sodium_softaes_inv_mix_columns(block: SoftAesBlock) -> SoftAesBlock {\n262\t    softaes_inv_mix_columns(block)\n263\t}\n264\t\n265\t/// `void softaes_invert_key_schedule128(SoftAesBlock rkeys[11])`\n266\t#[unsafe(no_mangle)]\n267\tpub unsafe extern \"C\" fn _sodium_softaes_invert_key_schedule128(rkeys: *mut SoftAesBlock) {\n268\t    for i in 1..10usize {\n269\t        unsafe { *rkeys.add(i) = softaes_inv_mix_columns(*rkeys.add(i)) };\n270\t    }\n271\t}\n272\t\n273\t/// `void softaes_invert_key_schedule256(SoftAesBlock rkeys[15])`\n274\t#[unsafe(no_mangle)]\n275\tpub unsafe extern \"C\" fn _sodium_softaes_invert_key_schedule256(rkeys: *mut SoftAesBlock) {\n276\t    for i in 1..14usize {\n277\t        unsafe { *rkeys.add(i) = softaes_inv_mix_columns(*rkeys.add(i)) };\n278\t    }\n279\t}\n280\t\n281\t/// `#define SOFTAES_STRIDE 16`\n282\tconst SOFTAES_STRIDE: usize = 16;\n283\t\n284\t/*\n285\t * Without FAVOR_PERFORMANCE the round is computed with SRM-1R, a bitsliced\n286\t * representation that holds the block as eight 32-bit bit planes (the real\n287\t * 16 lanes are duplicated into the high halfword so a row rotation is a\n288\t * plain 32-bit rotate). ShiftRows is folded into the input packing, SubBytes\n289\t * is a gate-only Boolean S-box circuit, and MixColumns is a fixed sequence of\n290\t * rotations and XORs. No step indexes memory with secret data, so the round\n291\t * is constant-time on every platform.\n292\t */\n293\t\n294\t/// `static inline uint32_t srm1r_dup16(uint32_t x)`\n295\t#[inline(always)]\n296\tfn srm1r_dup16(x: u32) -> u32 {\n297\t    let x = x & 0xffff;\n298\t    x | (x << 16)\n299\t}\n300\t\n301\t/// `static inline uint32_t srm1r_ror16(uint32_t x, unsigned int n)`\n302\t///\n303\t/// SRM-1R duplicates the low halfword, so a 16-lane rotate is a 32-bit rotate.\n304\t#[inline(always)]\n305\tfn srm1r_ror16(x: u32, n: u32) -> u32 {\n306\t    (x >> n) | (x << (32 - n))\n307\t}\n308\t\n309\t/// `static inline uint32_t srm1r_ror32(uint32_t x, unsigned int n)`\n310\t#[inline(always)]\n311\tfn srm1r_ror32(x: u32, n: u32) -> u32 {\n312\t    (x >> n) | (x << (32 - n))\n313\t}\n314\t\n315\t/// `static inline uint32_t srm1r_load_row_words(const SoftAesBlock block, unsigned int shift)`\n316\t#[inline(always)]\n317\tfn srm1r_load_row_words(block: SoftAesBlock, shift: u32) -> u32 {\n318\t    ((block.w0 >> shift) & 0xffu32)\n319\t        | (((block.w1 >> shift) & 0xffu32) << 8)\n320\t        | (((block.w2 >> shift) & 0xffu32) << 16)\n321\t        | (((block.w3 >> shift) & 0xffu32) << 24)\n322\t}\n323\t\n324\t/// `static inline uint32_t srm1r_store_column_word(uint32_t row0, uint32_t row1, uint32_t row2,\n325\t///                                                uint32_t row3, unsigned int shift)`\n326\t#[inline(always)]\n327\tfn srm1r_store_column_word(row0: u32, row1: u32, row2: u32, row3: u32, shift: u32) -> u32 {\n328\t    ((row0 >> shift) & 0xffu32)\n329\t        | (((row1 >> shift) & 0xffu32) << 8)\n330\t        | (((row2 >> shift) & 0xffu32) << 16)\n331\t        | (((row3 >> shift) & 0xffu32) << 24)\n332\t}\n333\t\n334\t/// `static inline uint32_t srm1r_gather_row_bit(uint32_t row_word, unsigned int bit)`\n335\t#[inline(always)]\n336\tfn srm1r_gather_row_bit(row_word: u32, bit: u32) -> u32 {\n337\t    (((row_word >> bit) & 0x0101_0101u32).wrapping_mul(0x0102_0408u32)) >> 24\n338\t}\n339\t\n340\t/// `static inline uint32_t srm1r_pack_rows_bit(uint32_t row0, uint32_t row1, uint32_t row2,\n341\t///                                            uint32_t row3, unsigned int bit)`\n342\t#[inline(always)]\n343\tfn srm1r_pack_rows_bit(row0: u32, row1: u32, row2: u32, row3: u32, bit: u32) -> u32 {\n344\t    srm1r_dup16(\n345\t        srm1r_gather_row_bit(row0, bit)\n346\t            | (srm1r_gather_row_bit(row1, bit) << 4)\n347\t            | (srm1r_gather_row_bit(row2, bit) << 8)\n348\t            | (srm1r_gather_row_bit(row3, bit) << 12),\n349\t    )\n350\t}\n351\t\n352\t/// `static inline uint32_t srm1r_spread_row_bits(uint32_t nibble, unsigned int bit)`\n353\t#[inline(always)]\n354\tfn srm1r_spread_row_bits(nibble: u32, bit: u32) -> u32 {\n355\t    let nibble = nibble & 0x0fu32;\n356\t    ((nibble.wrapping_mul(0x0020_4081u32)) & 0x0101_0101u32) << bit\n357\t}\n358\t\n359\t/// `static inline uint32_t srm1r_unpack_row_word(const uint32_t planes[8], unsigned int row)`\n360\t#[inline(always)]\n361\tfn srm1r_unpack_row_word(planes: &[u32; 8], row: u32) -> u32 {\n362\t    let lane_shift = 4u32 * row;\n363\t\n364\t    srm1r_spread_row_bits(planes[0] >> lane_shift, 7)\n365\t        | srm1r_spread_row_bits(planes[1] >> lane_shift, 6)\n366\t        | srm1r_spread_row_bits(planes[2] >> lane_shift, 5)\n367\t        | srm1r_spread_row_bits(planes[3] >> lane_shift, 4)\n368\t        | srm1r_spread_row_bits(planes[4] >> lane_shift, 3)\n369\t        | srm1r_spread_row_bits(planes[5] >> lane_shift, 2)\n370\t        | srm1r_spread_row_bits(planes[6] >> lane_shift, 1)\n371\t        | srm1r_spread_row_bits(planes[7] >> lane_shift, 0)\n372\t}\n373\t\n374\t/// `static inline void srm1r_pack_planes(uint32_t planes[8], uint32_t row0, uint32_t row1,\n375\t///                                      uint32_t row2, uint32_t row3)`\n376\t#[inline(always)]\n377\tfn srm1r_pack_planes(planes: &mut [u32; 8], row0: u32, row1: u32, row2: u32, row3: u32) {\n378\t    planes[0] = srm1r_pack_rows_bit(row0, row1, row2, row3, 7);\n379\t    planes[1] = srm1r_pack_rows_bit(row0, row1, row2, row3, 6);\n380\t    planes[2] = srm1r_pack_rows_bit(row0, row1, row2, row3, 5);\n381\t    planes[3] = srm1r_pack_rows_bit(row0, row1, row2, row3, 4);\n382\t    planes[4] = srm1r_pack_rows_bit(row0, row1, row2, row3, 3);\n383\t    planes[5] = srm1r_pack_rows_bit(row0, row1, row2, row3, 2);\n384\t    planes[6] = srm1r_pack_rows_bit(row0, row1, row2, row3, 1);\n385\t    planes[7] = srm1r_pack_rows_bit(row0, row1, row2, row3, 0);\n386\t}\n387\t\n388\t/// `static void srm1r_subbytes(uint32_t planes[8])`\n389\tfn srm1r_subbytes(planes: &mut [u32; 8]) {\n390\t    let s0 = planes[1] ^ planes[4];\n391\t    let s1 = planes[5] ^ planes[7];\n392\t    let s2 = planes[3] ^ s0;\n393\t    let s3 = planes[0] ^ planes[2];\n394\t    let q0 = s1 ^ s2;\n395\t    let s4 = planes[0] ^ planes[6];\n396\t    let s5 = planes[2] ^ planes[6];\n397\t    let s6 = planes[3] ^ s1;\n398\t    let s7 = planes[5] ^ s3;\n399\t    let q1 = s1 ^ s5;\n400\t    let q2 = planes[2] ^ q0;\n401\t    let q3 = s4 ^ s2;\n402\t    let q4 = s3 ^ q0;\n403\t    let s8 = planes[4] ^ s3;\n404\t    let q5 = s6 ^ s8;\n405\t    let q6 = planes[2] ^ planes[3];\n406\t    let q7 = planes[6] ^ s2;\n407\t    let s9 = planes[6] ^ s0;\n408\t    let q8 = s3 ^ s9;\n409\t    let q9 = s4 ^ s6;\n410\t    let q10 = s0 ^ s5;\n411\t    let q12 = planes[7] ^ s2;\n412\t    let q13 = planes[1] ^ s7;\n413\t    let q14 = planes[7] ^ s3;\n414\t    let q15 = s2 ^ s7;\n415\t    let q16 = planes[1] ^ s1;\n416\t    let q17 = planes[1] ^ planes[7];\n417\t    let q11 = planes[5];\n418\t\n419\t    let t20 = q6 & q12;\n420\t    let t21 = q3 & q14;\n421\t    let t22 = q1 & q16;\n422\t    let t23 = q2 & q17;\n423\t    let x0 = ((q3 | q14) ^ (q0 & q7)) ^ (t20 ^ t22);\n424\t    let x1 = ((q4 | q13) ^ (q10 & q11)) ^ (t21 ^ t20);\n425\t    let x2 = ((q2 | q17) ^ (q5 & q9)) ^ (t21 ^ t22);\n426\t    let x3 = ((q8 | q15) ^ t23) ^ (t21 ^ (q4 & q13));\n427\t\n428\t    let a = x1 & !x3;\n429\t    let b = x0 & !x3;\n430\t    let c = x3 & !x1;\n431\t    let d = x2 & !x1;\n432\t    let e = x0 ^ a;\n433\t    let y0 = x3 ^ (x2 & !e);\n434\t    let f = x1 ^ b;\n435\t    let y1 = c ^ (x2 & f);\n436\t    let g = x2 ^ c;\n437\t    let y2 = x1 ^ (x0 & !g);\n438\t    let h = x3 ^ d;\n439\t    let y3 = a ^ (x0 & h);\n440\t    let y02 = y2 ^ y0;\n441\t    let y13 = y3 ^ y1;\n442\t    let y23 = y3 ^ y2;\n443\t    let y01 = y1 ^ y0;\n444\t    let y00 = y02 ^ y13;\n445\t\n446\t    let a0 = y01 & q11;\n447\t    let a1 = y0 & q12;\n448\t    let a2 = y1 & q0;\n449\t    let a3 = y23 & q17;\n450\t    let a4 = y2 & q5;\n451\t    let a5 = y3 & q15;\n452\t    let a6 = y13 & q14;\n453\t    let a7 = y00 & q16;\n454\t    let a8 = y02 & q13;\n455\t    let a9 = y01 & q7;\n456\t    let a10 = y0 & q10;\n457\t    let a11 = y1 & q6;\n458\t    let a12 = y23 & q2;\n459\t    let a13 = y2 & q9;\n460\t    let a14 = y3 & q8;\n461\t    let a15 = y13 & q3;\n462\t    let a16 = y00 & q1;\n463\t    let a17 = y02 & q4;\n464\t\n465\t    let r0 = a1 ^ a5;\n466\t    let r1 = a9 ^ a15;\n467\t    let r2 = a4 ^ r0;\n468\t    let r3 = a2 ^ a10;\n469\t    let r4 = a11 ^ a17;\n470\t    let r5 = a8 ^ r1;\n471\t    let r6 = a0 ^ a16;\n472\t    let r7 = a7 ^ a13;\n473\t    let r8 = a11 ^ a14;\n474\t    let r9 = r3 ^ r4;\n475\t    let r10 = r5 ^ r6;\n476\t    let r11 = r2 ^ r9;\n477\t    let r12 = a3 ^ r0;\n478\t    let r13 = r7 ^ r8;\n479\t    let r14 = r12 ^ r13;\n480\t    planes[0] = r10 ^ r14;\n481\t    let r15 = a6 ^ a10;\n482\t    let r16 = r15 ^ r2;\n483\t    planes[1] = !(r10 ^ r16);\n484\t    planes[2] = !(a2 ^ r2);\n485\t    let r17 = a12 ^ a13;\n486\t    let r18 = a15 ^ r17;\n487\t    planes[3] = r18 ^ r11;\n488\t    let r19 = a1 ^ a14;\n489\t    let r20 = a17 ^ r3;\n490\t    let r21 = r7 ^ r19;\n491\t    let r22 = r5 ^ r20;\n492\t    planes[4] = r21 ^ r22;\n493\t    let r23 = a9 ^ a12;\n494\t    planes[5] = r8 ^ r23;\n495\t    planes[6] = !(r1 ^ r4);\n496\t    planes[7] = !(a16 ^ r11);\n497\t}\n498\t\n499\t/// `static void srm1r_mix_columns(uint32_t planes[8])`\n500\tfn srm1r_mix_columns(planes: &mut [u32; 8]) {\n501\t    let adj0 = srm1r_ror16(planes[0], 4);\n502\t    let adj1 = srm1r_ror16(planes[1], 4);\n503\t    let adj2 = srm1r_ror16(planes[2], 4);\n504\t    let adj3 = srm1r_ror16(planes[3], 4);\n505\t    let adj4 = srm1r_ror16(planes[4], 4);\n506\t    let adj5 = srm1r_ror16(planes[5], 4);\n507\t    let adj6 = srm1r_ror16(planes[6], 4);\n508\t    let adj7 = srm1r_ror16(planes[7], 4);\n509\t    let pair0 = planes[0] ^ adj0;\n510\t    let pair1 = planes[1] ^ adj1;\n511\t    let pair2 = planes[2] ^ adj2;\n512\t    let pair3 = planes[3] ^ adj3;\n513\t    let pair4 = planes[4] ^ adj4;\n514\t    let pair5 = planes[5] ^ adj5;\n515\t    let pair6 = planes[6] ^ adj6;\n516\t    let pair7 = planes[7] ^ adj7;\n517\t    let opp0 = srm1r_ror16(pair0, 8);\n518\t    let opp1 = srm1r_ror16(pair1, 8);\n519\t    let opp2 = srm1r_ror16(pair2, 8);\n520\t    let opp3 = srm1r_ror16(pair3, 8);\n521\t    let opp4 = srm1r_ror16(pair4, 8);\n522\t    let opp5 = srm1r_ror16(pair5, 8);\n523\t    let opp6 = srm1r_ror16(pair6, 8);\n524\t    let opp7 = srm1r_ror16(pair7, 8);\n525\t\n526\t    planes[0] = pair1 ^ adj0 ^ opp0;\n527\t    planes[1] = pair2 ^ adj1 ^ opp1;\n528\t    planes[2] = pair3 ^ adj2 ^ opp2;\n529\t    planes[3] = pair4 ^ adj3 ^ opp3 ^ pair0;\n530\t    planes[4] = pair5 ^ adj4 ^ opp4 ^ pair0;\n531\t    planes[5] = pair6 ^ adj5 ^ opp5;\n532\t    planes[6] = pair7 ^ adj6 ^ opp6 ^ pair0;\n533\t    planes[7] = pair0 ^ adj7 ^ opp7;\n534\t}\n535\t\n536\t/// `SoftAesBlock softaes_block_encrypt(const SoftAesBlock block, const SoftAesBlock rk)`\n537\t#[unsafe(no_mangle)]\n538\tpub unsafe extern \"C\" fn _sodium_softaes_block_encrypt(\n539\t    block: SoftAesBlock,\n540\t    rk: SoftAesBlock,\n541\t) -> SoftAesBlock {\n542\t    let mut out = SoftAesBlock::default();\n543\t    let mut planes = [0u32; 8];\n544\t\n545\t    let row0 = srm1r_load_row_words(block, 0);\n546\t    let row1 = srm1r_ror32(srm1r_load_row_words(block, 8), 8);\n547\t    let row2 = srm1r_ror32(srm1r_load_row_words(block, 16), 16);\n548\t    let row3 = srm1r_ror32(srm1r_load_row_words(block, 24), 24);\n549\t    srm1r_pack_planes(&mut planes, row0, row1, row2, row3);\n550\t\n551\t    srm1r_subbytes(&mut planes);\n552\t    srm1r_mix_columns(&mut planes);\n553\t\n554\t    let row0 = srm1r_unpack_row_word(&planes, 0);\n555\t    let row1 = srm1r_unpack_row_word(&planes, 1);\n556\t    let row2 = srm1r_unpack_row_word(&planes, 2);\n557\t    let row3 = srm1r_unpack_row_word(&planes, 3);\n558\t    out.w0 = srm1r_store_column_word(row0, row1, row2, row3, 0) ^ rk.w0;\n559\t    out.w1 = srm1r_store_column_word(row0, row1, row2, row3, 8) ^ rk.w1;\n560\t    out.w2 = srm1r_store_column_word(row0, row1, row2, row3, 16) ^ rk.w2;\n561\t    out.w3 = srm1r_store_column_word(row0, row1, row2, row3, 24) ^ rk.w3;\n562\t\n563\t    out\n564\t}\n565\t\n566\t/// `static const uint8_t INV_SBOX[256]`\n567\tstatic INV_SBOX: [u8; 256] = [\n568\t    0x52, 0x09, 0x6a, 0xd5, 0x30, 0x36, 0xa5, 0x38, 0xbf, 0x40, 0xa3, 0x9e, 0x81, 0xf3, 0xd7, 0xfb,\n569\t    0x7c, 0xe3, 0x39, 0x82, 0x9b, 0x2f, 0xff, 0x87, 0x34, 0x8e, 0x43, 0x44, 0xc4, 0xde, 0xe9, 0xcb,\n570\t    0x54, 0x7b, 0x94, 0x32, 0xa6, 0xc2, 0x23, 0x3d, 0xee, 0x4c, 0x95, 0x0b, 0x42, 0xfa, 0xc3, 0x4e,\n571\t    0x08, 0x2e, 0xa1, 0x66, 0x28, 0xd9, 0x24, 0xb2, 0x76, 0x5b, 0xa2, 0x49, 0x6d, 0x8b, 0xd1, 0x25,\n572\t    0x72, 0xf8, 0xf6, 0x64, 0x86, 0x68, 0x98, 0x16, 0xd4, 0xa4, 0x5c, 0xcc, 0x5d, 0x65, 0xb6, 0x92,\n573\t    0x6c, 0x70, 0x48, 0x50, 0xfd, 0xed, 0xb9, 0xda, 0x5e, 0x15, 0x46, 0x57, 0xa7, 0x8d, 0x9d, 0x84,\n574\t    0x90, 0xd8, 0xab, 0x00, 0x8c, 0xbc, 0xd3, 0x0a, 0xf7, 0xe4, 0x58, 0x05, 0xb8, 0xb3, 0x45, 0x06,\n575\t    0xd0, 0x2c, 0x1e, 0x8f, 0xca, 0x3f, 0x0f, 0x02, 0xc1, 0xaf, 0xbd, 0x03, 0x01, 0x13, 0x8a, 0x6b,\n576\t    0x3a, 0x91, 0x11, 0x41, 0x4f, 0x67, 0xdc, 0xea, 0x97, 0xf2, 0xcf, 0xce, 0xf0, 0xb4, 0xe6, 0x73,\n577\t    0x96, 0xac, 0x74, 0x22, 0xe7, 0xad, 0x35, 0x85, 0xe2, 0xf9, 0x37, 0xe8, 0x1c, 0x75, 0xdf, 0x6e,\n578\t    0x47, 0xf1, 0x1a, 0x71, 0x1d, 0x29, 0xc5, 0x89, 0x6f, 0xb7, 0x62, 0x0e, 0xaa, 0x18, 0xbe, 0x1b,\n579\t    0xfc, 0x56, 0x3e, 0x4b, 0xc6, 0xd2, 0x79, 0x20, 0x9a, 0xdb, 0xc0, 0xfe, 0x78, 0xcd, 0x5a, 0xf4,\n580\t    0x1f, 0xdd, 0xa8, 0x33, 0x88, 0x07, 0xc7, 0x31, 0xb1, 0x12, 0x10, 0x59, 0x27, 0x80, 0xec, 0x5f,\n581\t    0x60, 0x51, 0x7f, 0xa9, 0x19, 0xb5, 0x4a, 0x0d, 0x2d, 0xe5, 0x7a, 0x9f, 0x93, 0xc9, 0x9c, 0xef,\n582\t    0xa0, 0xe0, 0x3b, 0x4d, 0xae, 0x2a, 0xf5, 0xb0, 0xc8, 0xeb, 0xbb, 0x3c, 0x83, 0x53, 0x99, 0x61,\n583\t    0x17, 0x2b, 0x04, 0x7e, 0xba, 0x77, 0xd6, 0x26, 0xe1, 0x69, 0x14, 0x63, 0x55, 0x21, 0x0c, 0x7d,\n584\t];\n585\t\n586\t/// `SoftAesBlock softaes_block_decrypt(const SoftAesBlock block, const SoftAesBlock rk)`\n587\t#[unsafe(no_mangle)]\n588\tpub unsafe extern \"C\" fn _sodium_softaes_block_decrypt(\n589\t    block: SoftAesBlock,\n590\t    rk: SoftAesBlock,\n591\t) -> SoftAesBlock {\n592\t    let mut out = SoftAesBlock::default();\n593\t    let (mut s0, mut s1, mut s2, mut s3);\n594\t    let (t0, t1, t2, t3);\n595\t\n596\t    s0 = block.w0;\n597\t    s1 = block.w1;\n598\t    s2 = block.w2;\n599\t    s3 = block.w3;\n600\t\n601\t    t0 = (s0 & 0x0000_00ff) | (s3 & 0x0000_ff00) | (s2 & 0x00ff_0000) | (s1 & 0xff00_0000);\n602\t    t1 = (s1 & 0x0000_00ff) | (s0 & 0x0000_ff00) | (s3 & 0x00ff_0000) | (s2 & 0xff00_0000);\n603\t    t2 = (s2 & 0x0000_00ff) | (s1 & 0x0000_ff00) | (s0 & 0x00ff_0000) | (s3 & 0xff00_0000);\n604\t    t3 = (s3 & 0x0000_00ff) | (s2 & 0x0000_ff00) | (s1 & 0x00ff_0000) | (s0 & 0xff00_0000);\n605\t\n606\t    s0 = (INV_SBOX[(t0 & 0xff) as usize] as u32)\n607\t        | ((INV_SBOX[((t0 >> 8) & 0xff) as usize] as u32) << 8)\n608\t        | ((INV_SBOX[((t0 >> 16) & 0xff) as usize] as u32) << 16)\n609\t        | ((INV_SBOX[((t0 >> 24) & 0xff) as usize] as u32) << 24);\n610\t    s1 = (INV_SBOX[(t1 & 0xff) as usize] as u32)\n611\t        | ((INV_SBOX[((t1 >> 8) & 0xff) as usize] as u32) << 8)\n612\t        | ((INV_SBOX[((t1 >> 16) & 0xff) as usize] as u32) << 16)\n613\t        | ((INV_SBOX[((t1 >> 24) & 0xff) as usize] as u32) << 24);\n614\t    s2 = (INV_SBOX[(t2 & 0xff) as usize] as u32)\n615\t        | ((INV_SBOX[((t2 >> 8) & 0xff) as usize] as u32) << 8)\n616\t        | ((INV_SBOX[((t2 >> 16) & 0xff) as usize] as u32) << 16)\n617\t        | ((INV_SBOX[((t2 >> 24) & 0xff) as usize] as u32) << 24);\n618\t    s3 = (INV_SBOX[(t3 & 0xff) as usize] as u32)\n619\t        | ((INV_SBOX[((t3 >> 8) & 0xff) as usize] as u32) << 8)\n620\t        | ((INV_SBOX[((t3 >> 16) & 0xff) as usize] as u32) << 16)\n621\t        | ((INV_SBOX[((t3 >> 24) & 0xff) as usize] as u32) << 24);\n622\t\n623\t    out.w0 = inv_mix_column(s0) ^ rk.w0;\n624\t    out.w1 = inv_mix_column(s1) ^ rk.w1;\n625\t    out.w2 = inv_mix_column(s2) ^ rk.w2;\n626\t    out.w3 = inv_mix_column(s3) ^ rk.w3;\n627\t\n628\t    out\n629\t}\n630\t\n631\t/// `SoftAesBlock softaes_block_encryptlast(const SoftAesBlock block, const SoftAesBlock rk)`\n632\t///\n633\t/// The stride-scanned S-box copy of the C source is reproduced verbatim; the\n634\t/// `HAVE_INLINE_ASM` barriers between the scan and the lookups are absent\n635\t/// because that macro is undefined in the reference build.\n636\t#[unsafe(no_mangle)]\n637\tpub unsafe extern \"C\" fn _sodium_softaes_block_encryptlast(\n638\t    block: SoftAesBlock,\n639\t    rk: SoftAesBlock,\n640\t) -> SoftAesBlock {\n641\t    let mut out = SoftAesBlock::default();\n642\t    let mut ix = [[0u8; 4]; 4];\n643\t    let mut t = [[0u8; 256 / SOFTAES_STRIDE]; 4];\n644\t    let s0 = block.w0;\n645\t    let s1 = block.w1;\n646\t    let s2 = block.w2;\n647\t    let s3 = block.w3;\n648\t\n649\t    ix[0][0] = s0 as u8;\n650\t    ix[0][1] = (s1 >> 8) as u8;\n651\t    ix[0][2] = (s2 >> 16) as u8;\n652\t    ix[0][3] = (s3 >> 24) as u8;\n653\t\n654\t    ix[1][0] = s1 as u8;\n655\t    ix[1][1] = (s2 >> 8) as u8;\n656\t    ix[1][2] = (s3 >> 16) as u8;\n657\t    ix[1][3] = (s0 >> 24) as u8;\n658\t\n659\t    ix[2][0] = s2 as u8;\n660\t    ix[2][1] = (s3 >> 8) as u8;\n661\t    ix[2][2] = (s0 >> 16) as u8;\n662\t    ix[2][3] = (s1 >> 24) as u8;\n663\t\n664\t    ix[3][0] = s3 as u8;\n665\t    ix[3][1] = (s0 >> 8) as u8;\n666\t    ix[3][2] = (s1 >> 16) as u8;\n667\t    ix[3][3] = (s2 >> 24) as u8;\n668\t\n669\t    for i in 0..(256 / SOFTAES_STRIDE) {\n670\t        for j in 0..4usize {\n671\t            t[j][i] = SBOX[(i * SOFTAES_STRIDE) | ((ix[0][j] as usize) % SOFTAES_STRIDE)];\n672\t        }\n673\t    }\n674\t\n675\t    out.w0 = ((t[0][(ix[0][0] as usize) / SOFTAES_STRIDE] as u32) << 0)\n676\t        | ((t[1][(ix[0][1] as usize) / SOFTAES_STRIDE] as u32) << 8)\n677\t        | ((t[2][(ix[0][2] as usize) / SOFTAES_STRIDE] as u32) << 16)\n678\t        | ((t[3][(ix[0][3] as usize) / SOFTAES_STRIDE] as u32) << 24);\n679\t\n680\t    for i in 0..(256 / SOFTAES_STRIDE) {\n681\t        for j in 0..4usize {\n682\t            t[j][i] = SBOX[(i * SOFTAES_STRIDE) | ((ix[1][j] as usize) % SOFTAES_STRIDE)];\n683\t        }\n684\t    }\n685\t\n686\t    out.w1 = ((t[0][(ix[1][0] as usize) / SOFTAES_STRIDE] as u32) << 0)\n687\t        | ((t[1][(ix[1][1] as usize) / SOFTAES_STRIDE] as u32) << 8)\n688\t        | ((t[2][(ix[1][2] as usize) / SOFT