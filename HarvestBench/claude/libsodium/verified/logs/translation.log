   unsafe { ST = 12345u32 };\n    for i in 8..NV {\n        for j in 0..32 {\n            v[i][j] = ((nx() >> 16) & 0xff) as u8;\n        }\n    }\n    v\n}\n\nfn main() {\n    let vecs = mkvecs();\n    let mut s = [0u8; 32];\n    let mut fa = Fe25519::ZERO;\n    let mut fb = Fe25519::ZERO;\n    let mut h = Fe25519::ZERO;\n    let mut g = Fe25519::ZERO;\n    let mut t = Fe25519::ZERO;\n    let mut u = Fe25519::ZERO;\n    let mut w = Fe25519::ZERO;\n\n    for i in 0..NV {\n        let a = &vecs[i];\n        let b = &vecs[(i + 1) % NV];\n\n        println!(\"== vector {}\", i);\n        fe25519_frombytes(&mut fa, a);\n        fe25519_frombytes(&mut fb, b);\n        pfe(\"fa\", &fa);\n        pfe(\"fb\", &fb);\n        fe25519_tobytes(&mut s, &fa);\n        pby(\"tobytes_fa\", &s);\n        fe25519_tobytes(&mut s, &fb);\n        pby(\"tobytes_fb\", &s);\n\n        fe25519_0(&mut h); pfe(\"zero\", &h);\n        fe25519_1(&mut h); pfe(\"one\", &h);\n        fe25519_copy(&mut h, fa); pfe(\"copy\", &h);\n\n        fe25519_add(&mut h, fa, fb); pfe(\"add\", &h);\n        fe25519_sub(&mut h, fa, fb); pfe(\"sub\", &h);\n        fe25519_neg(&mut h, fa); pfe(\"neg\", &h);\n        fe25519_mul(&mut h, fa, fb); pfe(\"mul\", &h);\n        fe25519_sq(&mut h, fa); pfe(\"sq\", &h);\n        fe25519_sq2(&mut h, fa); pfe(\"sq2\", &h);\n        fe25519_mul32(&mut h, fa, 121666); pfe(\"mul32_121666\", &h);\n        fe25519_mul32(&mut h, fa, 1); pfe(\"mul32_1\", &h);\n        fe25519_mul32(&mut h, fa, 0xffffffffu32); pfe(\"mul32_max\", &h);\n        fe25519_mul32(&mut h, fa, (i as u32).wrapping_mul(7919u32)); pfe(\"mul32_i\", &h);\n\n        /* aliasing forms */\n        fe25519_copy(&mut h, fa); { let c = h; fe25519_mul(&mut h, c, c); } pfe(\"mul_alias\", &h);\n        fe25519_copy(&mut h, fa); { let c = h; fe25519_sq(&mut h, c); } pfe(\"sq_alias\", &h);\n        fe25519_copy(&mut h, fa); { let c = h; fe25519_sub(&mut h, c, fb); } pfe(\"sub_alias\", &h);\n        fe25519_copy(&mut h, fa);