%-40s (%d symbols)\\n\", path, nsyms);\n}\n\n/* deterministic PRNG (xorshift64*) */\nstatic uint64_t rs = 88172645463325252ULL;\nstatic uint8_t  rb(void)\n{\n    rs ^= rs >> 12; rs ^= rs << 25; rs ^= rs >> 27;\n    return (uint8_t) ((rs * 2685821657736338717ULL) >> 33);\n}\nstatic void rfill(uc *p, size_t n) { while (n--) *p++ = rb(); }\n\n#define MAXM 700\n#define PAD  64\n\nstatic struct lib R, T; /* Reference C, Translated Rust */\n\nstatic void cmp_sizes(void)\n{\n    checks++;\n    if (R.seedbytes() != T.seedbytes()) fail(\"seedbytes\", 0, 0);\n    CK(R.publickeybytes() == T.publickeybytes(), \"publickeybytes\", 0, 0);\n    CK(R.secretkeybytes() == T.secretkeybytes(), \"secretkeybytes\", 0, 0);\n    CK(R.beforenmbytes() == T.beforenmbytes(), \"beforenmbytes\", 0, 0);\n    CK(R.noncebytes() == T.noncebytes(), \"noncebytes\", 0, 0);\n    CK(R.zerobytes() == T.zerobytes(), \"zerobytes\", 0, 0);\n    CK(R.boxzerobytes() == T.boxzerobytes(), \"boxzerobytes\", 0, 0);\n    CK(R.macbytes() == T.macbytes(), \"macbytes\", 0, 0);\n    CK(R.messagebytes_max() == T.messagebytes_max(), \"messagebytes_max\", 0, 0);\n    CK(R.sealbytes() == T.sealbytes(), \"sealbytes\", 0, 0);\n    CK(strcmp(R.primitive(), T.primitive()) == 0, \"primitive\", 0, 0);\n    printf(\"  primitive = \\\"%s\\\" / \\\"%s\\\"; messagebytes_max = %zu / %zu\\n\",\n           R.primitive(), T.primitive(), R.messagebytes_max(), T.messagebytes_max());\n\n    CK(R.x_seedbytes() == T.x_seedbytes(), \"x_seedbytes\", 0, 0);\n    CK(R.x_publickeybytes() == T.x_publickeybytes(), \"x_publickeybytes\", 0, 0);\n    CK(R.x_secretkeybytes() == T.x_secretkeybytes(), \"x_secretkeybytes\", 0, 0);\n    CK(R.x_beforenmbytes() == T.x_beforenmbytes(), \"x_beforenmbytes\", 0, 0);\n    CK(R.x_noncebytes() == T.x_noncebytes(), \"x_noncebytes\", 0, 0);\n    CK(R.x_zerobytes() == T.x_zerobytes(), \"x_zerobytes\", 0, 0);\n    CK(R.x_boxzerobytes() == T.x_boxzerobytes(), \"x_boxzerobytes\", 0, 0);\n    CK(R.x_macbytes() == T.x_macbytes(), \"x_macbytes\", 0, 0);\n    CK(R.x_messagebytes_max() == T.x_messagebytes_max(), \"x_messagebytes_max\", 0, 0);\n\n    CK(R.c_seedbytes() == T.c_seedbytes(), \"c_seedbytes\", 0, 0);\n    CK(R.c_publickeybytes() == T.c_publickeybytes(), \"c_publickeybytes\", 0, 0);\n    CK(R.c_secretkeybytes() == T.c_secretkeybytes(), \"c_secretkeybytes\", 0, 0);\n    CK(R.c_beforenmbytes() == T.c_beforenmbytes(), \"c_beforenmbytes\", 0, 0);\n    CK(R.c_noncebytes() == T.c_noncebytes(), \"c_noncebytes\", 0, 0);\n    CK(R.c_macbytes() == T.c_macbytes(), \"c_macbytes\", 0, 0);\n    CK(R.c_messagebytes_max() == T.c_messagebytes_max(), \"c_messagebytes_max\", 0, 0);\n    CK(R.c_sealbytes() == T.c_sealbytes(), \"c_sealbytes\", 0, 0);\n}\n\nstatic const size_t mlens[] = { 0, 1, 15, 16, 31, 32, 63, 64, 600 };\n#define NLEN (sizeof mlens / sizeof mlens[0])\n\nint main(int argc, char **argv)\n{\n    if (argc != 3) { printf(\"usage: %s ref.so rust.so\\n\", argv[0]); return 1; }\n    load(&R, argv[1]);\n    load(&T, argv[2]);\n    cmp_sizes();\n\n    for (int it = 0; it < 120; it++) {\n        uc seedA[32], seedB[32], seedC[32];\n        uc pkA[32], skA[32], pkB[32], skB[32];\n        uc pkA2[32], skA2[32], pkB2[32], skB2[32];\n        uc n[24], kR[32], kT[32];\n        int r1, r2;\n\n        rfill(seedA, 32); rfill(seedB, 32); rfill(seedC, 32); rfill(n, 24);\n\n        /* --- seed_keypair (generic + both primitives) --- */\n        r1 = R.seed_keypair(pkA, skA, seedA);\n        r2 = T.seed_keypair(pkA2, skA2, seedA);\n        CK(r1 == r2 && !memcmp(pkA, pkA2, 32) && !memcmp(skA, skA2, 32),\n           \"seed_keypair A\", it, 0);\n        r1 = R.seed_keypair(pkB, skB, seedB);\n        r2 = T.seed_keypair(pkB2, skB2, seedB);\n        CK(r1 == r2 && !memcmp(pkB, pkB2, 32) && !memcmp(skB, skB2, 32),\n           \"seed_keypair B\", it, 0);\n\n        { uc p1[32], s1[32], p2[32], s2[32];\n          r1 = R.x_seed_keypair(p1, s1, seedC);\n          r2 = T.x_seed_keypair(p2, s2, seedC);\n          CK(r1 == r2 && !memcmp(p1, p2, 32) && !memcmp(s1, s2, 32),\n             \"x_seed_keypair\", it, 0);\n          r1 = R.c_seed_keypair(p1, s1, seedC);\n          r2 = T.c_seed_keypair(p2, s2, seedC);\n          CK(r1 == r2 && !memcmp(p1, p2, 32) && !memcmp(s1, s2, 32),\n             \"c_seed_keypair\", it, 0);\n        }\n\n        /* --- keypair (random): sanity + cross-open later --- */\n        { uc p1[32], s1[32], p2[32], s2[32];\n          r1 = R.keypair(p1, s1); r2 = T.keypair(p2, s2);\n          CK(r1 == 0 && r2 == 0, \"keypair ret\", it, 0);\n          r1 = R.x_keypair(p1, s1); r2 = T.x_keypair(p2, s2);\n          CK(r1 == 0 && r2 == 0, \"x_keypair ret\", it, 0);\n          r1 = R.c_keypair(p1, s1); r2 = T.c_keypair(p2, s2);\n          CK(r1 == 0 && r2 == 0, \"c_keypair ret\", it, 0);\n        }\n\n        /* --- beforenm --- */\n        memset(kR, 0xAA, 32); memset(kT, 0x55, 32);\n        r1 = R.beforenm(kR, pkB, skA);\n        r2 = T.beforenm(kT, pkB, skA);\n        CK(r1 == r2 && !memcmp(kR, kT, 32), \"beforenm\", it, 0);\n\n        { uc k1[32], k2[32];\n          r1 = R.x_beforenm(k1, pkB, skA); r2 = T.x_beforenm(k2, pkB, skA);\n          CK(r1 == r2 && !memcmp(k1, k2, 32), \"x_beforenm\", it, 0);\n          r1 = R.c_beforenm(k1, pkB, skA); r2 = T.c_beforenm(k2, pkB, skA);\n          CK(r1 == r2 && !memcmp(k1, k2, 32), \"c_beforenm\", it, 0);\n        }\n        /* beforenm with all-zero pk -> must fail identically */\n        { uc zpk[32] = { 0 }, k1[32], k2[32];\n          r1 = R.beforenm(k1, zpk, skA); r2 = T.beforenm(k2, zpk, skA);\n          CK(r1 == r2 && r1 == -1, \"beforenm zero pk\", it, 0);\n          r1 = R.x_beforenm(k1, zpk, skA); r2 = T.x_beforenm(k2, zpk, skA);\n          CK(r1 == r2 && r1 == -1, \"x_beforenm zero pk\", it, 0);\n          r1 = R.c_beforenm(k1, zpk, skA); r2 = T.c_beforenm(k2, zpk, skA);\n          CK(r1 == r2 && r1 == -1, \"c_beforenm zero pk\", it, 0);\n        }\n\n        for (size_t li = 0; li < NLEN; li++) {\n            size_t mlen = mlens[li];\n            uc m[MAXM], c1[MAXM + PAD], c2[MAXM + PAD], o1[MAXM + PAD], o2[MAXM + PAD];\n            uc mac1[16], mac2[16];\n\n            rfill(m, mlen);\n\n            /* ---------------- easy / open_easy ---------------- */\n            memset(c1, 0x11, sizeof c1); memset(c2, 0x22, sizeof c2);\n            r1 = R.easy(c1, m, mlen, n, pkB, skA);\n            r2 = T.easy(c2, m, mlen, n, pkB, skA);\n            CK(r1 == r2 && r1 == 0 && !memcmp(c1, c2, mlen + 16), \"easy\", it, mlen);\n\n            memset(o1, 0x33, sizeof o1); memset(o2, 0x44, sizeof o2);\n            r1 = R.open_easy(o1, c1, mlen + 16, n, pkA, skB);\n            r2 = T.open_easy(o2, c2, mlen + 16, n, pkA, skB);\n            CK(r1 == r2 && r1 == 0 && !memcmp(o1, o2, mlen) && !memcmp(o1, m, mlen),\n               \"open_easy\", it, mlen);\n\n            /* easy_afternm / open_easy_afternm */\n            memset(c1, 0, sizeof c1); memset(c2, 0, sizeof c2);\n            r1 = R.easy_afternm(c1, m, mlen, n, kR);\n            r2 = T.easy_afternm(c2, m, mlen, n, kT);\n            CK(r1 == r2 && !memcmp(c1, c2, mlen + 16), \"easy_afternm\", it, mlen);\n            memset(o1, 0, sizeof o1); memset(o2, 0, sizeof o2);\n            r1 = R.open_easy_afternm(o1, c1, mlen + 16, n, kR);\n            r2 = T.open_easy_afternm(o2, c2, mlen + 16, n, kT);\n            CK(r1 == r2 && r1 == 0 && !memcmp(o1, o2, mlen), \"open_easy_afternm\", it, mlen);\n\n            /* short clen error paths */\n            for (size_t sl = 0; sl < 16; sl++) {\n                r1 = R.open_easy(o1, c1, sl, n, pkA, skB);\n                r2 = T.open_easy(o2, c2, sl, n, pkA, skB);\n                CK(r1 == r2 && r1 == -1, \"open_easy short\", it, sl);\n                r1 = R.open_easy_afternm(o1, c1, sl, n, kR);\n                r2 = T.open_easy_afternm(o2, c2, sl, n, kT);\n                CK(r1 == r2 && r1 == -1, \"open_easy_afternm short\", it, sl);\n            }\n\n            /* tampered ciphertext */\n            { uc t1[MAXM + PAD], t2[MAXM + PAD];\n              size_t pos = (size_t) rb() % (mlen + 16);\n              memcpy(t1, c1, mlen + 16); memcpy(t2, c2, mlen + 16);\n              t1[pos] ^= 0x80; t2[pos] ^= 0x80;\n              memset(o1, 0x5A, sizeof o1); memset(o2, 0x5A, sizeof o2);\n              r1 = R.open_easy(o1, t1, mlen + 16, n, pkA, skB);\n              r2 = T.open_easy(o2, t2, mlen + 16, n, pkA, skB);\n              CK(r1 == r2 && !memcmp(o1, o2, sizeof o1), \"open_easy tampered\", it, mlen);\n              /* wrong nonce */\n              { uc bn[24]; memcpy(bn, n, 24); bn[0] ^= 1;\n                memset(o1, 0x5A, sizeof o1); memset(o2, 0x5A, sizeof o2);\n                r1 = R.open_easy(o1, c1, mlen + 16, bn, pkA, skB);\n                r2 = T.open_easy(o2, c2, mlen + 16, bn, pkA, skB);\n                CK(r1 == r2 && !memcmp(o1, o2, sizeof o1), \"open_easy badnonce\", it, mlen);\n              }\n            }\n\n            /* ---------------- detached ---------------- */\n            memset(c1, 0, sizeof c1); memset(c2, 0, sizeof c2);\n            memset(mac1, 0, 16); memset(mac2, 0, 16);\n            r1 = R.detached(c1, mac1, m, mlen, n, pkB, skA);\n            r2 = T.detached(c2, mac2, m, mlen, n, pkB, skA);\n            CK(r1 == r2 && r1 == 0 && !memcmp(c1, c2, mlen) && !memcmp(mac1, mac2, 16),\n               \"detached\", it, mlen);\n            memset(o1, 0, sizeof o1); memset(o2, 0, sizeof o2);\n            r1 = R.open_detached(o1, c1, mac1, mlen, n, pkA, skB);\n            r2 = T.open_detached(o2, c2, mac2, mlen, n, pkA, skB);\n            CK(r1 == r2 && r1 == 0 && !memcmp(o1, o2, mlen) && !memcmp(o1, m, mlen),\n               \"open_detached\", it, mlen);\n            { uc bad1[16], bad2[16];\n              memcpy(bad1, mac1, 16); memcpy(bad2, mac2, 16);\n              bad1[3] ^= 0x40; bad2[3] ^= 0x40;\n              memset(o1, 0x77, sizeof o1); memset(o2, 0x77, sizeof o2);\n              r1 = R.open_detached(o1, c1, bad1, mlen, n, pkA, skB);\n              r2 = T.open_detached(o2, c2, bad2, mlen, n, pkA, skB);\n              CK(r1 == r2 && r1 == -1 && !memcmp(o1, o2, sizeof o1),\n                 \"open_detached badmac\", it, mlen);\n            }\n            memset(c1, 0, sizeof c1); memset(c2, 0, sizeof c2);\n            r1 = R.detached_afternm(c1, mac1, m, mlen, n, kR);\n            r2 = T.detached_afternm(c2, mac2, m, mlen, n, kT);\n            CK(r1 == r2 && !memcmp(c1, c2, mlen) && !memcmp(mac1, mac2, 16),\n               \"detached_afternm\", it, mlen);\n            memset(o1, 0, sizeof o1); memset(o2, 0, sizeof o2);\n            r1 = R.open_detached_afternm(o1, c1, mac1, mlen, n, kR);\n            r2 = T.open_detached_afternm(o2, c2, mac2, mlen, n, kT);\n            CK(r1 == r2 && r1 == 0 && !memcmp(o1, o2, mlen), \"open_detached_afternm\", it, mlen);\n\n            /* detached with zero pk -> -1 */\n            { uc zpk[32] = { 0 };\n              r1 = R.detached(c1, mac1, m, mlen, n, zpk, skA);\n              r2 = T.detached(c2, mac2, m, mlen, n, zpk, skA);\n              CK(r1 == r2 && r1 == -1, \"detached zero pk\", it, mlen);\n              r1 = R.easy(c1, m, mlen, n, zpk, skA);\n              r2 = T.easy(c2, m, mlen, n, zpk, skA);\n              CK(r1 == r2 && r1 == -1, \"easy zero pk\", it, mlen);\n              r1 = R.open_easy(o1, c1, mlen + 16, n, zpk, skA);\n              r2 = T.open_easy(o2, c2, mlen + 16, n, zpk, skA);\n              CK(r1 == r2 && r1 == -1, \"open_easy zero pk\", it, mlen);\n              r1 = R.open_detached(o1, c1, mac1, mlen, n, zpk, skA);\n              r2 = T.open_detached(o2, c2, mac2, mlen, n, zpk, skA);\n              CK(r1 == r2 && r1 == -1, \"open_detached zero pk\", it, mlen);\n            }\n\n            /* ---------------- NaCl padded API ---------------- */\n            {\n                size_t pm = mlen + 32;                 /* ZEROBYTES padding */\n                uc mp[MAXM + PAD], cp1[MAXM + PAD], cp2[MAXM + PAD];\n                uc op1[MAXM + PAD], op2[MAXM + PAD];\n                memset(mp, 0, 32); memcpy(mp + 32, m, mlen);\n                memset(cp1, 0xEE, sizeof cp1); memset(cp2, 0xDD, sizeof cp2);\n                r1 = R.box_(cp1, mp, pm, n, pkB, skA);\n                r2 = T.box_(cp2, mp, pm, n, pkB, skA);\n                CK(r1 == r2 && r1 == 0 && !memcmp(cp1, cp2, pm), \"crypto_box\", it, mlen);\n                memset(op1, 0xEE, sizeof op1); memset(op2, 0xDD, sizeof op2);\n                r1 = R.box_open(op1, cp1, pm, n, pkA, skB);\n                r2 = T.box_open(op2, cp2, pm, n, pkA, skB);\n                CK(r1 == r2 && r1 == 0 && !memcmp(op1, op2, pm)\n                   && !memcmp(op1 + 32, m, mlen), \"crypto_box_open\", it, mlen);\n\n                memset(cp1, 0, sizeof cp1); memset(cp2, 0, sizeof cp2);\n                r1 = R.afternm(cp1, mp, pm, n, kR);\n                r2 = T.afternm(cp2, mp, pm, n, kT);\n                CK(r1 == r2 && !memcmp(cp1, cp2, pm), \"afternm\", it, mlen);\n                memset(op1, 0, sizeof op1); memset(op2, 0, sizeof op2);\n                r1 = R.open_afternm(op1, cp1, pm, n, kR);\n                r2 = T.open_afternm(op2, cp2, pm, n, kT);\n                CK(r1 == r2 && r1 == 0 && !memcmp(op1, op2, pm), \"open_afternm\", it, mlen);\n\n                /* explicit xsalsa primitive, same padded API */\n                memset(cp1, 0, sizeof cp1); memset(cp2, 0, sizeof cp2);\n                r1 = R.x_box(cp1, mp, pm, n, pkB, skA);\n                r2 = T.x_box(cp2, mp, pm, n, pkB, skA);\n                CK(r1 == r2 && !memcmp(cp1, cp2, pm), \"x_box\", it, mlen);\n                memset(op1, 0, sizeof op1); memset(op2, 0, sizeof op2);\n                r1 = R.x_box_open(op1, cp1, pm, n, pkA, skB);\n                r2 = T.x_box_open(op2, cp2, pm, n, pkA, skB);\n                CK(r1 == r2 && r1 == 0 && !memcmp(op1, op2, pm), \"x_box_open\", it, mlen);\n                memset(cp1, 0, sizeof cp1); memset(cp2, 0, sizeof cp2);\n                r1 = R.x