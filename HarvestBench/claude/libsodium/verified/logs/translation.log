eygen, crypto_kdf_hkdf_sha256_keygen);\n    LOAD(f_sz, crypto_kdf_hkdf_sha512_bytes_max); LOAD(f_sz, crypto_kdf_hkdf_sha512_bytes_min);\n    LOAD(f_sz, crypto_kdf_hkdf_sha512_keybytes);  LOAD(f_sz, crypto_kdf_hkdf_sha512_statebytes);\n    LOAD(f_extract, crypto_kdf_hkdf_sha512_extract);\n    LOAD(f_einit, crypto_kdf_hkdf_sha512_extract_init);\n    LOAD(f_eupd, crypto_kdf_hkdf_sha512_extract_update);\n    LOAD(f_efin, crypto_kdf_hkdf_sha512_extract_final);\n    LOAD(f_expand, crypto_kdf_hkdf_sha512_expand);\n    LOAD(f_keygen, crypto_kdf_hkdf_sha512_keygen);\n    LOAD(f_sz, crypto_kx_publickeybytes); LOAD(f_sz, crypto_kx_secretkeybytes);\n    LOAD(f_sz, crypto_kx_seedbytes);      LOAD(f_sz, crypto_kx_sessionkeybytes);\n    LOAD(f_str, crypto_kx_primitive);\n    LOAD(f_seedkp, crypto_kx_seed_keypair);\n    LOAD(f_kp, crypto_kx_keypair);\n    LOAD(f_sess, crypto_kx_client_session_keys);\n    LOAD(f_sess, crypto_kx_server_session_keys);\n    crypto_scalarmult_base_c = (f_smbase) sym(hc, \"crypto_scalarmult_base\");\n}\n\n#define CMPSZ(name) do { size_t a = name##_c(), b = name##_r(); \\\n    char m[128]; snprintf(m, sizeof m, \"C=%zu R=%zu\", a, b); chk(a == b, #name, m); } while (0)\n#define CMPSTR(name) do { const char *a = name##_c(), *b = name##_r(); \\\n    char m[160]; snprintf(m, sizeof m, \"C=%s R=%s\", a, b); chk(strcmp(a, b) == 0, #name, m); } while (0)\n\n/* ---------------- constants ---------------- */\nstatic void test_consts(void)\n{\n    CMPSZ(crypto_kdf_bytes_max); CMPSZ(crypto_kdf_bytes_min);\n    CMPSZ(crypto_kdf_contextbytes); CMPSZ(crypto_kdf_keybytes);\n    CMPSTR(crypto_kdf_primitive);\n    CMPSZ(crypto_kdf_blake2b_bytes_max); CMPSZ(crypto_kdf_blake2b_bytes_min);\n    CMPSZ(crypto_kdf_blake2b_contextbytes); CMPSZ(crypto_kdf_blake2b_keybytes);\n    CMPSZ(crypto_kdf_hkdf_sha256_bytes_max); CMPSZ(crypto_kdf_hkdf_sha256_bytes_min);\n    CMPSZ(crypto_kdf_hkdf_sha256_keybytes);  CMPSZ(crypto_kdf_hkdf_sha256_statebytes);\n    CMPSZ(crypto_kdf_hkdf_sha512_bytes_max); CMPSZ(crypto_kdf_hkdf_sha512_bytes_min);\n    CMPSZ(crypto_kdf_hkdf_sha512_keybytes);  CMPSZ(crypto_kdf_hkdf_sha512_statebytes);\n    CMPSZ(crypto_kx_publickeybytes); CMPSZ(crypto_kx_secretkeybytes);\n    CMPSZ(crypto_kx_seedbytes);      CMPSZ(crypto_kx_sessionkeybytes);\n    CMPSTR(crypto_kx_primitive);\n    /* exact expected values from the headers */\n    chk(crypto_kdf_bytes_min_r() == 16 && crypto_kdf_bytes_max_r() == 64 &&\n        crypto_kdf_contextbytes_r() == 8 && crypto_kdf_keybytes_r() == 32, \"kdf const values\", NULL);\n    chk(crypto_kdf_hkdf_sha256_statebytes_r() == 208, \"hkdf256 statebytes==208\", NULL);\n    chk(crypto_kdf_hkdf_sha512_statebytes_r() == 416, \"hkdf512 statebytes==416\", NULL);\n    chk(crypto_kdf_hkdf_sha256_bytes_max_r() == 0xff * 32u, \"hkdf256 max\", NULL);\n    chk(crypto_kdf_hkdf_sha512_bytes_max_r() == 0xff * 64u, \"hkdf512 max\", NULL);\n}\n\n/* ---------------- kdf derive_from_key ---------------- */\nstatic void test_derive(void)\n{\n    static const size_t lens[] = { 0, 1, 15, 16, 17, 31, 32, 33, 47, 63, 64, 65, 80, 128, 1024 };\n    unsigned char key[32], ctxb[9];\n    unsigned char oc[256], orr[256];\n    uint64_t ids[6];\n    int trial;\n\n    for (trial = 0; trial < 60; trial++) {\n        rndbuf(key, sizeof key);\n        rndbuf(ctxb, 8); ctxb[8] = 0;\n        ids[0] = 0; ids[1] = 1; ids[2] = UINT64_MAX; ids[3] = rnd64();\n        ids[4] = 0x00000000FFFFFFFFULL; ids[5] = 0x0102030405060708ULL;\n        for (unsigned k = 0; k < 6; k++) {\n            for (unsigned li = 0; li < sizeof lens / sizeof lens[0]; li++) {\n                size_t sl = lens[li];\n                int rc, rr, ec, er;\n                memset(oc, 0xAA, sizeof oc); memset(orr, 0xAA, sizeof orr);\n                errno = 0; rc = crypto_kdf_blake2b_derive_from_key_c(oc, sl, ids[k], (const char *) ctxb, key); ec = errno;\n                errno = 0; rr = crypto_kdf_blake2b_derive_from_key_r(orr, sl, ids[k], (const char *) ctxb, key); er = errno;\n                chk(rc == rr, \"blake2b_derive rc\", NULL);\n                chk(ec == er, \"blake2b_derive errno\", NULL);\n                cmpbuf(oc, orr, sizeof oc, \"blake2b_derive out\");\n\n                memset(oc, 0x55, sizeof oc); memset(orr, 0x55, sizeof orr);\n                errno = 0; rc = crypto_kdf_derive_from_key_c(oc, sl, ids[k], (const char *) ctxb, key); ec = errno;\n                errno = 0; rr = crypto_kdf_derive_from_key_r(orr, sl, ids[k], (const char *) ctxb, key); er = errno;\n                chk(rc == rr, \"kdf_derive rc\", NULL);\n                chk(ec == er, \"kdf_derive errno\", NULL);\n                cmpbuf(oc, orr, sizeof oc, \"kdf_derive out\");\n            }\n        }\n    }\n    /* ctx containing embedded NUL / non-ascii bytes */\n    for (trial = 0; trial < 20; trial++) {\n        unsigned char c2[8];\n        rndbuf(key, sizeof key); rndbuf(c2, 8);\n        c2[trial % 8] = 0;\n        memset(oc, 0, 64); memset(orr, 0, 64);\n        chk(crypto_kdf_derive_from_key_c(oc, 64, rnd64(), (const char *) c2, key) ==\n            crypto_kdf_derive_from_key_r(orr, 64, rs, (const char *) c2, key), \"ctx nul rc\", NULL);\n    }\n}\n\n/* ---------------- hkdf ---------------- */\nstatic void test_hkdf(int is512)\n{\n    const size_t KB = is512 ? 64 : 32;\n    size_t SB = is512 ? crypto_kdf_hkdf_sha512_statebytes_c() : crypto_kdf_hkdf_sha256_statebytes_c();\n    f_extract exc = is512 ? crypto_kdf_hkdf_sha512_extract_c : crypto_kdf_hkdf_sha256_extract_c;\n    f_extract exr = is512 ? crypto_kdf_hkdf_sha512_extract_r : crypto_kdf_hkdf_sha256_extract_r;\n    f_einit  inc = is512 ? crypto_kdf_hkdf_sha512_extract_init_c : crypto_kdf_hkdf_sha256_extract_init_c;\n    f_einit  inr = is512 ? crypto_kdf_hkdf_sha512_extract_init_r : crypto_kdf_hkdf_sha256_extract_init_r;\n    f_eupd   upc = is512 ? crypto_kdf_hkdf_sha512_extract_update_c : crypto_kdf_hkdf_sha256_extract_update_c;\n    f_eupd   upr = is512 ? crypto_kdf_hkdf_sha512_extract_update_r : crypto_kdf_hkdf_sha256_extract_update_r;\n    f_efin   fic = is512 ? crypto_kdf_hkdf_sha512_extract_final_c : crypto_kdf_hkdf_sha256_extract_final_c;\n    f_efin   fir = is512 ? crypto_kdf_hkdf_sha512_extract_final_r : crypto_kdf_hkdf_sha256_extract_final_r;\n    f_expand epc = is512 ? crypto_kdf_hkdf_sha512_expand_c : crypto_kdf_hkdf_sha256_expand_c;\n    f_expand epr = is512 ? crypto_kdf_hkdf_sha512_expand_r : crypto_kdf_hkdf_sha256_expand_r;\n    size_t BMAX = is512 ? 0xff * 64u : 0xff * 32u;\n    const char *tag = is512 ? \"hkdf512\" : \"hkdf256\";\n    char what[64];\n\n    unsigned char salt[300], ikm[600], prkc[64], prkr[64];\n    unsigned char *sc = malloc(SB), *sr = malloc(SB);\n\n    /* one-shot extract, many salt/ikm lengths (incl. 0 and > block size) */\n    static const size_t sl[] = { 0, 1, 16, 31, 32, 33, 63, 64, 65, 127, 128, 129, 200, 300 };\n    static const size_t il[] = { 0, 1, 7, 32, 64, 65, 128, 129, 250, 500, 600 };\n    for (unsigned a = 0; a < sizeof sl / sizeof sl[0]; a++) {\n        for (unsigned b = 0; b < sizeof il / sizeof il[0]; b++) {\n            int rc, rr;\n            rndbuf(salt, sizeof salt); rndbuf(ikm, sizeof ikm);\n            memset(prkc, 0, 64); memset(prkr, 0, 64);\n            rc = exc(prkc, sl[a] ? salt : NULL, sl[a], ikm, il[b]);\n            rr = exr(prkr, sl[a] ? salt : NULL, sl[a], ikm, il[b]);\n            snprintf(what, sizeof what, \"%s extract rc\", tag); chk(rc == rr, what, NULL);\n            snprintf(what, sizeof what, \"%s extract prk\", tag); cmpbuf(prkc, prkr, KB, what);\n\n            /* streaming with multiple update chunks; compare full state bytes too */\n            memset(sc, 0xCD, SB); memset(sr, 0xCD, SB);\n            rc = inc(sc, sl[a] ? salt : NULL, sl[a]);\n            rr = inr(sr, sl[a] ? salt : NULL, sl[a]);\n            snprintf(what, sizeof what, \"%s init rc\", tag); chk(rc == rr, what, NULL);\n            snprintf(what, sizeof what, \"%s state after init\", tag); cmpbuf(sc, sr, SB, what);\n            size_t off = 0, chunk = 1;\n            while (off < il[b]) {\n                size_t n = il[b] - off; if (n > chunk) n = chunk;\n                rc = upc(sc, ikm + off, n);\n                rr = upr(sr, ikm + off, n);\n                snprintf(what, sizeof what, \"%s update rc\", tag); chk(rc == rr, what, NULL);\n                snprintf(what, sizeof what, \"%s state after update\", tag); cmpbuf(sc, sr, SB, what);\n                off += n; chunk = chunk * 2 + 3;\n            }\n            unsigned char p2c[64], p2r[64];\n            memset(p2c, 0, 64); memset(p2r, 0, 64);\n            rc = fic(sc, p2c); rr = fir(sr, p2r);\n            snprintf(what, sizeof what, \"%s final rc\", tag); chk(rc == rr, what, NULL);\n            snprintf(what, sizeof what, \"%s streamed prk\", tag); cmpbuf(p2c, p2r, KB, what);\n            snprintf(what, sizeof what, \"%s streamed==oneshot\", tag); cmpbuf(p2c, prkc, KB, what);\n            snprintf(what, sizeof what, \"%s state zeroed after final\", tag); cmpbuf(sc, sr, SB, what);\n        }\n    }\n\n    /* expand */\n    unsigned char prk[64], ctxb[300];\n    unsigned char *oc = malloc(BMAX + 64), *orr = malloc(BMAX + 64);\n    static const size_t clen[] = { 0, 1, 8, 31, 32, 33, 64, 128, 300 };\n    for (unsigned ci = 0; ci < sizeof clen / sizeof clen[0]; ci++) {\n        rndbuf(prk, 64); rndbuf(ctxb, sizeof ctxb);\n        for (size_t ol = 0; ol <= 260; ol++) {\n            int rc, rr, ec, er;\n            memset(oc, 0x11, BMAX + 64); memset(orr, 0x11, BMAX + 64);\n            errno = 0; rc = epc(oc, ol, (const char *) ctxb, clen[ci], prk); ec = errno;\n            errno = 0; rr = epr(orr, ol, (const char *) ctxb, clen[ci], prk); er = errno;\n            snprintf(what, sizeof what, \"%s expand rc\", tag); chk(rc == rr, what, NULL);\n            snprintf(what, sizeof what, \"%s expand errno\", tag); chk(ec == er, what, NULL);\n            snprintf(what, sizeof what, \"%s expand out\", tag); cmpbuf(oc, orr, BMAX + 64, what);\n        }\n        /* boundary lengths */\n        size_t bl[] = { BMAX - KB - 1, BMAX - KB, BMAX - 1, BMAX, BMAX + 1, BMAX + 1000, SIZE_MAX };\n        for (unsigned bi = 0; bi < sizeof bl / sizeof bl[0]; bi++) {\n            int rc, rr, ec, er;\n            size_t ol = bl[bi];\n            size_t alloc = ol > BMAX ? BMAX + 64 : ol + 64;\n            memset(oc, 0x22, alloc); memset(orr, 0x22, alloc);\n            errno = 0; rc = epc(oc, ol, (const char *) ctxb, clen[ci], prk); ec = errno;\n            errno = 0; rr = epr(orr, ol, (const char *) ctxb, clen[ci], prk); er = errno;\n            snprintf(what, sizeof what, \"%s expand bnd rc(ol=%zu)\", tag, ol); chk(rc == rr, what, NULL);\n            snprintf(what, sizeof what, \"%s expand bnd errno\", tag); chk(ec == er, what, NULL);\n            if (ol <= BMAX) {\n                snprintf(what, sizeof what, \"%s expand bnd out\", tag);\n                cmpbuf(oc, orr, alloc, what);\n            } else {\n                snprintf(what, sizeof what, \"%s expand bnd EINVAL\", tag);\n                chk(rc == -1 && ec == EINVAL, what, NULL);\n            }\n        }\n    }\n    /* keygen: only check that exactly KB bytes are written */\n    unsigned char kg[128];\n    for (int t = 0; t < 20; t++) {\n        memset(kg, 0x77, sizeof kg);\n        if (is512) crypto_kdf_hkdf_sha512_keygen_r(kg); else crypto_kdf_hkdf_sha256_keygen_r(kg);\n        int untouched = 1;\n        for (size_t i = KB; i < sizeof kg; i++) if (kg[i] != 0x77) untouched = 0;\n        int changed = 0;\n        for (size_t i = 0; i < KB; i++) if (kg[i] != 0x77) changed = 1;\n        snprintf(what, sizeof what, \"%s keygen bounds\", tag); chk(untouched && changed, what, NULL);\n    }\n    free(sc); free(sr); free(oc); free(orr);\n}\n\n/* ---------------- kx ---------------- */\nstatic void test_kx(void)\n{\n    unsigned char seed[32], pkc[32], skc[32], pkr[32], skr[32];\n    unsigned char cpk[32], csk[32], spk[32], ssk[32];\n    unsigned char rxc[32], txc[32], rxr[32], txr[32];\n    int trial;\n\n    for (trial = 0; trial < 200; trial++) {\n        rndbuf(seed, 32);\n        memset(pkc, 0, 32); memset(skc, 0, 32); memset(pkr, 0, 32); memset(skr, 0, 32);\n        int rc = crypto_kx_seed_keypair_c(pkc, skc, seed);\n        int rr = crypto_kx_seed_keypair_r(pkr, skr, seed);\n        chk(rc == rr, \"kx_seed_keypair rc\", NULL);\n        cmpbuf(pkc, pkr, 32, \"kx_seed_keypair pk\");\n        cmpbuf(skc, skr, 32, \"kx_seed_keypair sk\");\n\n        /* build two keypairs deterministically from seeds and exchange */\n        rndbuf(seed, 32); crypto_kx_seed_keypair_c(cpk, csk, seed);\n        rndbuf(seed, 32); crypto_kx_seed_keypair_c(spk, ssk, seed);\n\n        memset(rxc, 1, 32); memset(txc, 2, 32); memset(rxr, 1, 32); memset(txr, 2, 32);\n        rc = crypto_kx_client_session_keys_c(rxc, txc, cpk, csk, spk);\n        rr = crypto_kx_client_session_keys_r(rxr, txr, cpk, csk, spk);\n        chk(rc == rr, \"kx_client rc\", NULL);\n        cmpbuf(rxc, rxr, 32, \"kx_client rx\"); cmpbuf(txc, txr, 32, \"kx_client tx\");\n\n        unsigned char srxc[32], stxc[32], srxr[32], stxr[32];\n        memset(srxc, 3, 32); memset(stxc, 4, 32); memset(srxr, 3, 32); memset(stxr, 4, 32);\n        rc = crypto_kx_server_session_keys_c(srxc, stxc, spk, ssk, cpk);\n        rr = crypto_kx_server_session_keys_r(srxr, stxr, spk, ssk, cpk);\n        chk(rc == rr, \"kx_server rc\", NULL);\n        cmpbuf(srxc, srxr, 32, \"kx_server rx\"); cmpbuf(stxc, stxr, 32, \"kx_server tx\");\n        /* sanity: client tx == server rx, client rx == server tx */\n        cmpbuf(txr, srxr, 32, \"kx tx==server rx\");\n        cmpbuf(rxr, stxr, 32, \"kx rx==server tx\");\n\n        /* rx == NULL */\n        memset(txc, 9, 32); memset(txr, 9, 32);\n        rc = crypto_kx_client_session_keys_c(NULL, txc, cpk, csk, spk);\n        rr = crypto_kx_client_session_keys_r(NULL, txr, cpk, csk, spk);\n        chk(rc == rr, \"kx_client rx=NULL rc\", NULL);\n        cmpbuf(txc, txr, 32, \"kx_client rx=NULL tx\");\n        /* tx == NULL */\n        memset(rxc, 8, 32); memset(rxr, 8, 32);\n        rc = crypto_kx_client_session_keys_c(rxc, NULL, cpk, csk, spk);\n        rr = crypto_kx_client_session_keys_r(rxr, NULL, cpk, csk, spk);\n        chk(rc == rr, \"kx_client tx=NULL rc\", NULL);\n        cmpbuf(rxc, rxr, 32, \"kx_client tx=NULL rx\");\n        /* aliased rx == tx */\n        memset(rxc, 7, 32); memset(rxr, 7, 32);\n        rc = crypto_kx_client_session_keys_c(rxc, rxc, cpk, csk, spk);\n        rr = crypto_kx_client_session_keys_r(rxr, rxr, cpk, csk, spk);\n        chk(rc == rr, \"kx_client alias rc\", NULL);\n        cmpbuf(rxc, rxr, 32, \"kx_client alias buf\");\n\n        memset(txc, 9, 32); memset(txr, 9, 32);\n        rc = crypto_kx_server_session_keys_c(NULL, txc, spk, ssk, cpk);\n        rr = crypto_kx_server_session_keys_r(NULL, txr, spk, ssk, cpk);\n        chk(rc == rr, \"kx_server rx=NULL rc\", NULL);\n        cmpbuf(txc, txr, 32, \"kx_server rx=NULL tx\");\n        memset(rxc, 8, 32); memset(rxr, 8, 32);\n        rc = crypto_kx_server_session_keys_c(rxc, NULL, spk, ssk, cpk);\n        rr = crypto_kx_server_session_keys_r(rxr, NULL, spk, ssk, cpk);\n        chk(rc == rr, \"kx_server tx=NULL rc\", NULL);\n        cmpbuf(rxc, rxr, 32, \"kx_server tx=NULL rx\");\n        memset(rxc, 7, 32); memset(rxr, 7, 32);\n        rc = crypto_kx_server_session_keys_c(rxc, rxc, spk, ssk, cpk);\n        rr = crypto_kx_server_session_keys_r(rxr, rxr, spk, ssk, cpk);\n        chk(rc == rr, \"kx_server alias rc\", NULL);\n        cmpbuf(rxc, rxr, 32, \"kx_server alias buf\");\n    }\n\n    /* error path: low-order / all-zero peer public keys => crypto_scalarmult fails */\n    static const unsigned char bad[8][32] = {\n        {0},\n        {1},\n        {0xe0,0xeb,0x7a,0x7c,0x3b,0x41,0xb8,0xae,0x16,0x56,0xe3,0xfa,0xf1,0x9f,0xc4,0x6a,\n         0xda,0x09,0x8d,0xeb,0x9c,0x32,0xb1,0xfd,0x86,0x62,0x05,0x16,0x5f,0x49,0xb8,0x00},\n        {0