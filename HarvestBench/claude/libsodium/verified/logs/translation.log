{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Y7DENW3qSQiAZExxbeZnyp","type":"tool_result","content":"1\t/*\n2\t * Argon2 source code package\n3\t *\n4\t * Written by Daniel Dinu and Dmitry Khovratovich, 2015\n5\t *\n6\t * This work is licensed under a Creative Commons CC0 1.0 License/Waiver.\n7\t *\n8\t * You should have received a copy of the CC0 Public Domain Dedication along\n9\t * with\n10\t * this software. If not, see\n11\t * <http://creativecommons.org/publicdomain/zero/1.0/>.\n12\t */\n13\t\n14\t#ifndef argon2_core_H\n15\t#define argon2_core_H\n16\t\n17\t#include <string.h>\n18\t\n19\t#include \"argon2.h\"\n20\t#include \"private/quirks.h\"\n21\t\n22\t/*************************Argon2 internal\n23\t * constants**************************************************/\n24\t\n25\tenum argon2_ctx_constants {\n26\t    /* Version of the algorithm */\n27\t    ARGON2_VERSION_NUMBER = 0x13,\n28\t\n29\t    /* Memory block size in bytes */\n30\t    ARGON2_BLOCK_SIZE      = 1024,\n31\t    ARGON2_QWORDS_IN_BLOCK = ARGON2_BLOCK_SIZE / 8,\n32\t    ARGON2_OWORDS_IN_BLOCK = ARGON2_BLOCK_SIZE / 16,\n33\t    ARGON2_HWORDS_IN_BLOCK = ARGON2_BLOCK_SIZE / 32,\n34\t    ARGON2_512BIT_WORDS_IN_BLOCK = ARGON2_BLOCK_SIZE / 64,\n35\t\n36\t    /* Number of pseudo-random values generated by one call to Blake in Argon2i\n37\t       to\n38\t       generate reference block positions */\n39\t    ARGON2_ADDRESSES_IN_BLOCK = 128,\n40\t\n41\t    /* Pre-hashing digest length and its extension*/\n42\t    ARGON2_PREHASH_DIGEST_LENGTH = 64,\n43\t    ARGON2_PREHASH_SEED_LENGTH   = 72\n44\t};\n45\t\n46\t/*************************Argon2 internal data\n47\t * types**************************************************/\n48\t\n49\t/*\n50\t * Structure for the (1KB) memory block implemented as 128 64-bit words.\n51\t * Memory blocks can be copied, XORed. Internal words can be accessed by [] (no\n52\t * bounds checking).\n53\t */\n54\ttypedef struct block_ {\n55\t    uint64_t v[ARGON2_QWORDS_IN_BLOCK];\n56\t} block;\n57\t\n58\ttypedef struct block_region_ {\n59\t    void * base;\n60\t    block *memory;\n61\t    size_t size;\n62\t} block_region;\n63\t\n64\t/*****************Functions that work with the block******************/\n65\t\n66\t/* Initialize each byte of the block with @in */\n67\tstatic inline void\n68\tinit_block_value(block *b, uint8_t in)\n69\t{\n70\t    memset(b->v, in, sizeof(b->v));\n71\t}\n72\t\n73\t/* Copy block @src to block @dst */\n74\tstatic inline void\n75\tcopy_block(block *dst, const block *src)\n76\t{\n77\t    memcpy(dst->v, src->v, sizeof(uint64_t) * ARGON2_QWORDS_IN_BLOCK);\n78\t}\n79\t\n80\t/* XOR @src onto @dst bytewise */\n81\tstatic inline void\n82\txor_block(block *dst, const block *src)\n83\t{\n84\t    int i;\n85\t    for (i = 0; i < ARGON2_QWORDS_IN_BLOCK; ++i) {\n86\t        dst->v[i] ^= src->v[i];\n87\t    }\n88\t}\n89\t\n90\t/*\n91\t * Argon2 instance: memory pointer, number of passes, amount of memory, type,\n92\t * and derived values.\n93\t * Used to evaluate the number and location of blocks to construct in each\n94\t * thread\n95\t */\n96\ttypedef struct Argon2_instance_t {\n97\t    block_region *region;        /* Memory region pointer */\n98\t    uint64_t     *pseudo_rands;\n99\t    uint32_t      passes;        /* Number of passes */\n100\t    uint32_t      current_pass;\n101\t    uint32_t      memory_blocks; /* Number of blocks in memory */\n102\t    uint32_t      segment_length;\n103\t    uint32_t      lane_length;\n104\t    uint32_t      lanes;\n105\t    uint32_t      threads;\n106\t    argon2_type   type;\n107\t    int           print_internals; /* whether to print the memory blocks */\n108\t} argon2_instance_t;\n109\t\n110\t/*\n111\t * Argon2 position: where we construct the block right now. Used to distribute\n112\t * work between threads.\n113\t */\n114\ttypedef struct Argon2_position_t {\n115\t    uint32_t pass;\n116\t    uint32_t lane;\n117\t    uint8_t  slice;\n118\t    uint32_t index;\n119\t} argon2_position_t;\n120\t\n121\t/*Struct that holds the inputs for thread handling FillSegment*/\n122\ttypedef struct Argon2_thread_data {\n123\t    argon2_instance_t *instance_ptr;\n124\t    argon2_position_t  pos;\n125\t} argon2_thread_data;\n126\t\n127\t/*************************Argon2 core\n128\t * functions**************************************************/\n129\t\n130\t/*\n131\t * Computes absolute position of reference block in the lane following a skewed\n132\t * distribution and using a pseudo-random value as input\n133\t * @param instance Pointer to the current instance\n134\t * @param position Pointer to the current position\n135\t * @param pseudo_rand 32-bit pseudo-random value used to determine the position\n136\t * @param same_lane Indicates if the block will be taken from the current lane.\n137\t * If so we can reference the current segment\n138\t * @pre All pointers must be valid\n139\t */\n140\tstatic uint32_t index_alpha(const argon2_instance_t *instance,\n141\t                            const argon2_position_t *position, uint32_t pseudo_rand,\n142\t                            int same_lane)\n143\t{\n144\t    /*\n145\t     * Pass 0:\n146\t     *      This lane : all already finished segments plus already constructed\n147\t     * blocks in this segment\n148\t     *      Other lanes : all already finished segments\n149\t     * Pass 1+:\n150\t     *      This lane : (SYNC_POINTS - 1) last segments plus already constructed\n151\t     * blocks in this segment\n152\t     *      Other lanes : (SYNC_POINTS - 1) last segments\n153\t     */\n154\t    uint32_t reference_area_size;\n155\t    uint64_t relative_position, absolute_position;\n156\t    uint32_t start_position;\n157\t\n158\t    if (position->pass == 0) {\n159\t        /* First pass */\n160\t        if (position->slice == 0) {\n161\t            /* First slice */\n162\t            reference_area_size =\n163\t                position->index - 1; /* all but the previous */\n164\t        } else {\n