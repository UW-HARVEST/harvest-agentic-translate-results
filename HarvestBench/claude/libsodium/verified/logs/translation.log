ze_t), f, \"sodium_unpad\");\n                size_t pl = 0;\n                memset(R->out, 0xAA, 64);\n                memcpy(R->out, bin, (size_t) ul < sizeof bin ? (size_t) ul : sizeof bin);\n                if (p(&pl, R->out, ul, bs, 64) != 0) { R->ret = -99; break; }\n                size_t upl = 0;\n                R->ret  = f(&upl, R->out, pl, bs);\n                R->extra = upl;\n            });\n        }\n    }\n    {\n        uc x[32], y[32];\n        fillr(x, 32); memcpy(y, x, 32);\n        CASE(\"sodium_compare eq\", 0, { GETF(int (*)(const uc *, const uc *, size_t), f, \"sodium_compare\"); R->ret = f(x, y, 32); });\n        y[0] = (uc) (x[0] + 1);\n        CASE(\"sodium_compare lt\", 0, { GETF(int (*)(const uc *, const uc *, size_t), f, \"sodium_compare\"); R->ret = f(x, y, 32); });\n        CASE(\"sodium_compare gt\", 0, { GETF(int (*)(const uc *, const uc *, size_t), f, \"sodium_compare\"); R->ret = f(y, x, 32); });\n        CASE(\"sodium_memcmp\", 0, { GETF(int (*)(const void *, const void *, size_t), f, \"sodium_memcmp\"); R->ret = f(x, y, 32); });\n        CASE(\"sodium_is_zero nz\", 0, { GETF(int (*)(const uc *, size_t), f, \"sodium_is_zero\"); R->ret = f(x, 32); });\n        uc z[32] = { 0 };\n        CASE(\"sodium_is_zero z\", 0, { GETF(int (*)(const uc *, size_t), f, \"sodium_is_zero\"); R->ret = f(z, 32); });\n    }\n    for (int nlen = 1; nlen <= 32; nlen += 7) {\n        char nm[64];\n        snprintf(nm, sizeof nm, \"sodium_increment %d\", nlen);\n        CASE(nm, 32, {\n            GETF(void (*)(uc *, size_t), f, \"sodium_increment\");\n            memset(R->out, 0xff, 32);\n            memcpy(R->out, bin, (size_t) nlen);\n            f(R->out, nlen);\n        });\n        snprintf(nm, sizeof nm, \"sodium_add %d\", nlen);\n        CASE(nm, 32, {\n            GETF(void (*)(uc *, const uc *, size_t), f, \"sodium_add\");\n            memset(R->out, 0, 32);\n            memcpy(R->out, bin, (size_t) nlen);\n            f(R->out, bin + 1, nlen);\n        });\n        snprintf(nm, sizeof nm, \"sodium_sub %d\", nlen);\n        CASE(nm, 32, {\n            GETF(void (*)(uc *, const uc *, size_t), f, \"sodium_sub\");\n            memset(R->out, 0, 32);\n            memcpy(R->out, bin, (size_t) nlen);\n            f(R->out, bin + 1, nlen);\n        });\n    }\n    CASE(\"sodium_increment carry\", 32, {\n        GETF(void (*)(uc *, size_t), f, \"sodium_increment\");\n        memset(R->out, 0xff, 32);\n        f(R->out, 24);\n    });\n}\n\n/* =================== crypto_core =================== */\n{\n    uc in[16], k[32], c[16];\n    fillr(in, 16); fillr(k, 32); fillr(c, 16);\n    static const char *const cores[] = { \"crypto_core_salsa20\",\"crypto_core_salsa2012\",\"crypto_core_salsa208\", NULL };\n    for (int j = 0; cores[j]; j++) {\n        char nm[64];\n        snprintf(nm, sizeof nm, \"%s\", cores[j]);\n        CASE(nm, 64, { GETF(int (*)(uc *, const uc *, const uc *, const uc *), f, cores[j]); R->ret = f(R->out, in, k, c); });\n        snprintf(nm, sizeof nm, \"%s null-c\", cores[j]);\n        CASE(nm, 64, { GETF(int (*)(uc *, const uc *, const uc *, const uc *), f, cores[j]); R->ret = f(R->out, in, k, NULL); });\n    }\n    CASE(\"crypto_core_hsalsa20\", 32, { GETF(int (*)(uc *, const uc *, const uc *, const uc *), f, \"crypto_core_hsalsa20\"); R->ret = f(R->out, in, k, c); });\n    CASE(\"crypto_core_hsalsa20 null-c\", 32, { GETF(int (*)(uc *, const uc *, const uc *, const uc *), f, \"crypto_core_hsalsa20\"); R->ret = f(R->out, in, k, NULL); });\n    CASE(\"crypto_core_hchacha20\", 32, { GETF(int (*)(uc *, const uc *, const uc *, const uc *), f, \"crypto_core_hchacha20\"); R->ret = f(R->out, in, k, c); });\n    CASE(\"crypto_core_hchacha20 null-c\", 32, { GETF(int (*)(uc *, const uc *, const uc *, const uc *), f, \"crypto_core_hchacha20\"); R->ret = f(R->out, in, k, NULL); });\n}\n\n/* =================== crypto_stream =================== */\n{\n    uc key[32], n8[8], n24[24], n12[12], msg[600];\n    fillr(key, 32); fillr(n8, 8); fillr(n24, 24); fillr(n12, 12); fillr(msg, sizeof msg);\n    struct { const char *nm; int nlen; } s2[] = {\n        { \"crypto_stream_salsa20\", 8 }, { \"crypto_stream_salsa2012\", 8 },\n        { \"crypto_stream_salsa208\", 8 }, { \"crypto_stream_xsalsa20\", 24 },\n        { \"crypto_stream_chacha20\", 8 }, { \"crypto_stream_chacha20_ietf\", 12 },\n        { \"crypto_stream_xchacha20\", 24 }, { \"crypto_stream\", 24 },\n    };\n    for (unsigned j = 0; j < sizeof s2 / sizeof s2[0]; j++) {\n        const uc *nn = s2[j].nlen == 8 ? n8 : (s2[j].nlen == 12 ? n12 : n24);\n        for (int len = 0; len <= 600; len = len ? len * 3 + 1 : 1) {\n            char nm[96];\n            snprintf(nm, sizeof nm, \"%s len%d\", s2[j].nm, len);\n            CASE(nm, (size_t) len, {\n                GETF(int (*)(uc *, ull, const uc *, const uc *), f, s2[j].nm);\n                R->ret = f(R->out, (ull) len, nn, key);\n            });\n            char nm2[96];\n            snprintf(nm2, sizeof nm2, \"%s_xor len%d\", s2[j].nm, len);\n            char sym[96];\n            snprintf(sym, sizeof sym, \"%s_xor\", s2[j].nm);\n            CASE(nm2, (size_t) len, {\n                GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, sym);\n                R->ret = f(R->out, msg, (ull) len, nn, key);\n            });\n        }\n    }\n    struct { const char *sym; int nlen; ull ic; } xic[] = {\n        { \"crypto_stream_salsa20_xor_ic\", 8, 3 },\n        { \"crypto_stream_xsalsa20_xor_ic\", 24, 5 },\n        { \"crypto_stream_chacha20_xor_ic\", 8, 7 },\n        { \"crypto_stream_xchacha20_xor_ic\", 24, 9 },\n    };\n    for (unsigned j = 0; j < sizeof xic / sizeof xic[0]; j++) {\n        const uc *nn = xic[j].nlen == 8 ? n8 : n24;\n        char nm[96];\n        snprintf(nm, sizeof nm, \"%s\", xic[j].sym);\n        CASE(nm, 300, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *, ull, const uc *), f, xic[j].sym);\n            R->ret = f(R->out, msg, 300, nn, xic[j].ic, key);\n        });\n    }\n    CASE(\"crypto_stream_chacha20_ietf_xor_ic\", 300, {\n        GETF(int (*)(uc *, const uc *, ull, const uc *, uint32_t, const uc *), f, \"crypto_stream_chacha20_ietf_xor_ic\");\n        R->ret = f(R->out, msg, 300, n12, 11, key);\n    });\n    CASE(\"crypto_stream_chacha20_ietf_ext\", 300, {\n        GETF(int (*)(uc *, ull, const uc *, const uc *), f, \"crypto_stream_chacha20_ietf_ext\");\n        R->ret = f(R->out, 300, n12, key);\n    });\n    CASE(\"crypto_stream_chacha20_ietf_ext_xor_ic\", 300, {\n        GETF(int (*)(uc *, const uc *, ull, const uc *, uint32_t, const uc *), f, \"crypto_stream_chacha20_ietf_ext_xor_ic\");\n        R->ret = f(R->out, msg, 300, n12, 2, key);\n    });\n    static const char *const kg[] = {\n        \"crypto_stream_keygen\",\"crypto_stream_salsa20_keygen\",\"crypto_stream_salsa2012_keygen\",\n        \"crypto_stream_salsa208_keygen\",\"crypto_stream_xsalsa20_keygen\",\n        \"crypto_stream_chacha20_keygen\",\"crypto_stream_chacha20_ietf_keygen\",\n        \"crypto_stream_xchacha20_keygen\",\"crypto_auth_keygen\",\"crypto_auth_hmacsha256_keygen\",\n        \"crypto_auth_hmacsha512_keygen\",\"crypto_auth_hmacsha512256_keygen\",\n        \"crypto_generichash_keygen\",\"crypto_generichash_blake2b_keygen\",\n        \"crypto_onetimeauth_keygen\",\"crypto_onetimeauth_poly1305_keygen\",\n        \"crypto_shorthash_keygen\",\"crypto_secretbox_keygen\",\n        \"crypto_secretbox_xsalsa20poly1305_keygen\",\n        \"crypto_secretstream_xchacha20poly1305_keygen\",\n        \"crypto_aead_chacha20poly1305_keygen\",\"crypto_aead_chacha20poly1305_ietf_keygen\",\n        \"crypto_aead_xchacha20poly1305_ietf_keygen\",\"crypto_aead_aegis128l_keygen\",\n        \"crypto_aead_aegis256_keygen\",\"crypto_aead_aes256gcm_keygen\",\n        \"crypto_kdf_keygen\",\"crypto_ipcrypt_keygen\",\"crypto_ipcrypt_nd_keygen\",\n        \"crypto_ipcrypt_ndx_keygen\",\"crypto_ipcrypt_pfx_keygen\",\n        \"crypto_kdf_hkdf_sha256_keygen\",\"crypto_kdf_hkdf_sha512_keygen\",\n        NULL\n    };\n    for (int j = 0; kg[j]; j++) {\n        CASE(kg[j], 64, {\n            GETF(void (*)(uc *), f, kg[j]);\n            memset(R->out, 0, 64);\n            f(R->out);\n        });\n    }\n}\n\n/* =================== hashes =================== */\n{\n    uc msg[600];\n    fillr(msg, sizeof msg);\n    struct { const char *nm; size_t out; } hs[] = {\n        { \"crypto_hash\", 64 }, { \"crypto_hash_sha256\", 32 }, { \"crypto_hash_sha512\", 64 },\n        { \"crypto_hash_sha3256\", 32 }, { \"crypto_hash_sha3512\", 64 },\n    };\n    for (unsigned j = 0; j < sizeof hs / sizeof hs[0]; j++) {\n        for (int len = 0; len <= 600; len = len ? len * 5 + 3 : 1) {\n            char nm[96];\n            snprintf(nm, sizeof nm, \"%s len%d\", hs[j].nm, len);\n            CASE(nm, hs[j].out, {\n                GETF(int (*)(uc *, const uc *, ull), f, hs[j].nm);\n                R->ret = f(R->out, msg, (ull) len);\n            });\n        }\n    }\n    /* streaming */\n    struct { const char *pfx; size_t out; } st[] = {\n        { \"crypto_hash_sha256\", 32 }, { \"crypto_hash_sha512\", 64 },\n        { \"crypto_hash_sha3256\", 32 }, { \"crypto_hash_sha3512\", 64 },\n    };\n    for (unsigned j = 0; j < sizeof st / sizeof st[0]; j++) {\n        char nm[96];\n        snprintf(nm, sizeof nm, \"%s streaming\", st[j].pfx);\n        CASE(nm, st[j].out, {\n            char s1[96], s2[96], s3[96], s4[96];\n            snprintf(s1, sizeof s1, \"%s_init\", st[j].pfx);\n            snprintf(s2, sizeof s2, \"%s_update\", st[j].pfx);\n            snprintf(s3, sizeof s3, \"%s_final\", st[j].pfx);\n            snprintf(s4, sizeof s4, \"%s_statebytes\", st[j].pfx);\n            GETF(size_t (*)(void), sb, s4);\n            GETF(int (*)(void *), fi, s1);\n            GETF(int (*)(void *, const uc *, ull), fu, s2);\n            GETF(int (*)(void *, uc *), ff, s3);\n            void *state = calloc(1, sb() + 64);\n            R->ret = fi(state);\n            size_t off = 0, chunk = 1;\n            while (off < sizeof msg) {\n                size_t c = chunk;\n                if (off + c > sizeof msg) c = sizeof msg - off;\n                R->ret |= fu(state, msg + off, c);\n                off += c;\n                chunk = chunk * 2 + 1;\n            }\n            R->ret |= ff(state, R->out);\n            R->extra = sb();\n            free(state);\n        });\n    }\n}\n\n/* =================== XOFs =================== */\n{\n    uc msg[300], key[32];\n    fillr(msg, sizeof msg); fillr(key, 32);\n    static const char *const xf[] = {\n        \"crypto_xof_shake128\",\"crypto_xof_shake256\",\n        \"crypto_xof_turboshake128\",\"crypto_xof_turboshake256\", NULL\n    };\n    for (int j = 0; xf[j]; j++) {\n        char nm[128], sym[128];\n        for (int ol = 1; ol <= 400; ol = ol * 7 + 1) {\n            snprintf(nm, sizeof nm, \"%s out%d\", xf[j], ol);\n            CASE(nm, (size_t) ol, {\n                GETF(int (*)(uc *, size_t, const uc *, size_t), f, xf[j]);\n                R->ret = f(R->out, (size_t) ol, msg, sizeof msg);\n            });\n        }\n        snprintf(nm, sizeof nm, \"%s streaming\", xf[j]);\n        CASE(nm, 200, {\n            char s1[160], s2[160], s3[160], s4[160];\n            snprintf(s1, sizeof s1, \"%s_init\", xf[j]);\n            snprintf(s2, sizeof s2, \"%s_update\", xf[j]);\n            snprintf(s3, sizeof s3, \"%s_squeeze\", xf[j]);\n            snprintf(s4, sizeof s4, \"%s_statebytes\", xf[j]);\n            GETF(size_t (*)(void), sb, s4);\n            GETF(int (*)(void *), fi, s1);\n            GETF(int (*)(void *, const uc *, size_t), fu, s2);\n            GETF(int (*)(void *, uc *, size_t), fq, s3);\n            void *state = calloc(1, sb() + 64);\n            R->ret = fi(state);\n            size_t off = 0, chunk = 1;\n            while (off < sizeof msg) {\n                size_t c = chunk;\n                if (off + c > sizeof msg) c = sizeof msg - off;\n                R->ret |= fu(state, msg + off, c);\n                off += c;\n                chunk = chunk * 3 + 1;\n            }\n            size_t so = 0; chunk = 1;\n            while (so < 200) {\n                size_t c = chunk;\n                if (so + c > 200) c = 200 - so;\n                R->ret |= fq(state, R->out + so, c);\n                so += c;\n                chunk = chunk * 5 + 1;\n            }\n            R->extra = sb();\n            free(state);\n        });\n        snprintf(nm, sizeof nm, \"%s init_with_domain\", xf[j]);\n        snprintf(sym, sizeof sym, \"%s_init_with_domain\", xf[j]);\n        CASE(nm, 100, {\n            char s2[160], s3[160], s4[160];\n            snprintf(s2, sizeof s2, \"%s_update\", xf[j]);\n            snprintf(s3, sizeof s3, \"%s_squeeze\", xf[j]);\n            snprintf(s4, sizeof s4, \"%s_statebytes\", xf[j]);\n            GETF(size_t (*)(void), sb, s4);\n            GETF(int (*)(void *, uc), fi, sym);\n            GETF(int (*)(void *, const uc *, size_t), fu, s2);\n            GETF(int (*)(void *, uc *, size_t), fq, s3);\n            void *state = calloc(1, sb() + 64);\n            R->ret = fi(state, 0x0b);\n            R->ret |= fu(state, msg, sizeof msg);\n            R->ret |= fq(state, R->out, 100);\n            free(state);\n        });\n    }\n}\n\n/* =================== generichash =================== */\n{\n    uc msg[600], key[64], salt[16], pers[16];\n    fillr(msg, sizeof msg); fillr(key, 64); fillr(salt, 16); fillr(pers, 16);\n    for (int ol = 16; ol <= 64; ol += 16) {\n        for (int kl = 0; kl <= 64; kl += 32) {\n            char nm[96];\n            snprintf(nm, sizeof nm, \"crypto_generichash out%d key%d\", ol, kl);\n            CASE(nm, (size_t) ol, {\n                GETF(int (*)(uc *, size_t, const uc *, ull, const uc *, size_t), f, \"crypto_generichash\");\n                R->ret = f(R->out, (size_t) ol, msg, sizeof msg, kl ? key : NULL, (size_t) kl);\n            });\n            snprintf(nm, sizeof nm, \"crypto_generichash_blake2b out%d key%d\", ol, kl);\n            CASE(nm, (size_t) ol, {\n                GETF(int (*)(uc *, size_t, const uc *, ull, const uc *, size_t), f, \"crypto_generichash_blake2b\");\n                R->ret = f(R->out, (size_t) ol, msg, sizeof msg, kl ? key : NULL, (size_t) kl);\n            });\n            snprintf(nm, sizeof nm, \"crypto_generichash_blake2b_salt_personal out%d key%d\", ol, kl);\n            CASE(nm, (size_t) ol, {\n                GETF(int (*)(uc *, size_t, const uc *, ull, const uc *, size_t, const uc *, const uc *), f, \"crypto_generichash_blake2b_salt_personal\");\n                R->ret = f(R->out, (size_t) ol, msg, sizeof msg, kl ? key : NULL, (size_t) kl, salt, pers);\n            });\n        }\n    }\n    CASE(\"crypto_generichash streaming\", 32, {\n        GETF(size_t (*)(void), sb, \"crypto_generichash_statebytes\");\n        GETF(int (*)(void *, const uc *, size_t, size_t), fi, \"crypto_generichash_init\");\n        GETF(int (*)(void *, const uc *, ull), fu, \"crypto_generichash_update\");\n        GETF(int (*)(void *, uc *, size_t), ff, \"crypto_generichash_final\");\n        void *st = calloc(1, sb() + 64);\n        R->ret = fi(st, key, 32, 32);\n        size_t off = 0, chunk = 1;\n        while (off < sizeof msg) {\n            size_t c = chunk;\n            if (off + c > sizeof msg) c = sizeof msg - off;\n            R->ret |= fu(st, msg + off, c);\n            off += c;\n            chunk = chunk * 2 + 1;\n        }\n        R->ret |= ff(st, R->out, 32);\n        R->extra = sb();\n        free(st);\n    });\n    CASE(\"crypto_generichash_blake2b_init_salt_personal\", 32, {\n        GETF(size_t (*)(void), sb, \"crypto_generichash_blake2b_statebytes\");\n        GETF(int (*)(void *, const uc *, size_t, size_t, const uc *, const uc *), fi, \"crypto_generichash_blake2b_init_salt_personal\");\n        GETF(int (*)(void *, const uc *, ull), fu, \"crypto_generichash_blake2b_update\");\n        GETF(int (*)(void *, uc *, size_t), ff, \"crypto_generichash_blake2b_final\");\n        void *st = calloc(1, sb() + 64);\n        R->ret = fi(st, key, 32, 32, salt, pers);\n        R->ret |= fu(st, msg, sizeof msg);\n        R->ret |= ff(st, R->out, 32);\n        free(st);\n    });\n}\n\n/* =================== onetimeauth / shorthash / auth =================== */\n{\n    uc msg[600], key[64];\n    fillr(msg, sizeof msg); fillr(key, 64);\n    for (int len = 0; len <= 600; len = len ? len * 5 + 3 : 1) {\n        char nm[96];\n        snprintf(nm, sizeof nm, \"crypto_onetimeauth len%d\", len);\n        CASE(nm, 16, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *), f, \"crypto_onetimeauth\");\n            R->ret = f(R->out, msg, (ull) len, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_onetimeauth_poly1305 len%d\", len);\n        CASE(nm, 16, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *), f, \"crypto_onetimeauth_poly1305\");\n            R->ret = f(R->out, msg, (ull) len, key);\n        });\n    }\n    CASE(\"crypto_onetimeauth verify\", 16, {\n        GETF(int (*)(uc *, const uc *, ull, const uc *), f, \"crypto_onetimeauth\");\n        GETF(int (*)(const uc *, const uc *, ull, const uc *), v, \"crypto_onetimeauth_verify\");\n        f(R->out, msg, 137, key);\n        R->ret = v(R->out, msg, 137, key);\n        uc bad[16]; memcpy(bad, R->out, 16); bad[0] ^= 1;\n        R->extra = (unsigned long long) (v(bad, msg, 137, key) + 100);\n    });\n    CASE(\"crypto_onetimeauth streaming\", 16, {\n        GETF(size_t (*)(void), sb, \"crypto_onetimeauth_statebytes\");\n        GETF(int (*)(void *, const uc *), fi, \"crypto_onetimeauth_init\");\n        GETF(int (*)(void *, const uc *, ull), fu, \"crypto_onetimeauth_update\");\n        GETF(int (*)(void *, uc *), ff, \"crypto_onetimeauth_final\");\n        void *st = calloc(1, sb() + 64);\n        R->ret = fi(st, key);\n        size_t off = 0, chunk = 1;\n        while (off < sizeof msg) {\n            size_t c = chunk;\n            if (off + c > sizeof msg) c = sizeof msg - off;\n            R->ret |= fu(st, msg + off, c);\n            off += c;\n            chunk = chunk * 2 + 1;\n        }\n        R->ret |= ff(st, R->out);\n        R->extra = sb();\n        free(st);\n    });\n    static const char *const sh[] = { \"crypto_shorthash\",\"crypto_shorthash_siphash24\", NULL };\n    for (int j = 0; sh[j]; j++) {\n        for (int len = 0; len <= 300; len = len ? len * 5 + 3 : 1) {\n            char nm[96];\n            snprintf(nm, sizeof nm, \"%s len%d\", sh[j], len);\n            CASE(nm, 8, {\n                GETF(int (*)(uc *, const uc *, ull, const uc *), f, sh[j]);\n                R->ret = f(R->out, msg, (ull) len, key);\n            });\n        }\n    }\n    for (int len = 0; len <= 300; len = len ? len * 5 + 3 : 1) {\n        char nm[96];\n        snprintf(nm, sizeof nm, \"crypto_shorthash_siphashx24 len%d\", len);\n        CASE(nm, 16, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *), f, \"crypto_shorthash_siphashx24\");\n            R->ret = f(R->out, msg, (ull) len, key);\n        });\n    }\n    struct { const char *nm; size_t out; size_t klen; } au[] = {\n        { \"crypto_auth\", 32, 32 }, { \"crypto_auth_hmacsha256\", 32, 32 },\n        { \"crypto_auth_hmacsha512\", 64, 32 }, { \"crypto_auth_hmacsha512256\", 32, 32 },\n    };\n    for (unsigned j = 0; j < sizeof au / sizeof au[0]; j++) {\n        for (int len = 0; len <= 600; len = len ? len * 7 + 3 : 1) {\n            char nm[96];\n            snprintf(nm, sizeof nm, \"%s len%d\", au[j].nm, len);\n            CASE(nm, au[j].out, {\n                GETF(int (*)(uc *, const uc *, ull, const uc *), f, au[j].nm);\n                R->ret = f(R->out, msg, (ull) len, key);\n            });\n        }\n        char nm[96], s1[128], s2[128], s3[128], s4[128], sv[128];\n        snprintf(nm, sizeof nm, \"%s verify\", au[j].nm);\n        snprintf(sv, sizeof sv, \"%s_verify\", au[j].nm);\n        CASE(nm, au[j].out, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *), f, au[j].nm);\n            GETF(int (*)(const uc *, const uc *, ull, const uc *), v, sv);\n            f(R->out, msg, 137, key);\n            R->ret = v(R->out, msg, 137, key);\n            uc bad[64]; memcpy(bad, R->out, au[j].out); bad[0] ^= 1;\n            R->extra = (unsigned long long) (v(bad, msg, 137, key) + 100);\n        });\n        if (j == 0) continue;\n        snprintf(nm, sizeof nm, \"%s streaming\", au[j].nm);\n        snprintf(s1, sizeof s1, \"%s_init\", au[j].nm);\n        snprintf(s2, sizeof s2, \"%s_update\", au[j].nm);\n        snprintf(s3, sizeof s3, \"%s_final\", au[j].nm);\n        snprintf(s4, sizeof s4, \"%s_statebytes\", au[j].nm);\n        CASE(nm, au[j].out, {\n            GETF(size_t (*)(void), sb, s4);\n            GETF(int (*)(void *, const uc *, size_t), fi, s1);\n            GETF(int (*)(void *, const uc *, ull), fu, s2);\n            GETF(int (*)(void *, uc *), ff, s3);\n            void *st = calloc(1, sb() + 64);\n            R->ret = fi(st, key, 41);\n            size_t off = 0, chunk = 1;\n            while (off < sizeof msg) {\n                size_t c = chunk;\n                if (off + c > sizeof msg) c = sizeof msg - off;\n                R->ret |= fu(st, msg + off, c);\n                off += c;\n                chunk = chunk * 2 + 1;\n            }\n            R->ret |= ff(st, R->out);\n            R->extra = sb();\n            free(st);\n        });\n    }\n}\n\n/* =================== AEAD =================== */\n{\n    uc key[32], npub[32], msg[600], ad[37];\n    fillr(key, 32); fillr(npub, 32); fillr(msg, sizeof msg); fillr(ad, sizeof ad);\n    struct { const char *pfx; int npub; int abytes; } ae[] = {\n        { \"crypto_aead_chacha20poly1305\", 8, 16 },\n        { \"crypto_aead_chacha20poly1305_ietf\", 12, 16 },\n        { \"crypto_aead_xchacha20poly1305_ietf\", 24, 16 },\n        { \"crypto_aead_aegis128l\", 16, 32 },\n        { \"crypto_aead_aegis256\", 32, 32 },\n    };\n    for (unsigned j = 0; j < sizeof ae / sizeof ae[0]; j++) {\n        int kb = 32;\n        if (strstr(ae[j].pfx, \"aegis128l\")) kb = 16;\n        for (int len = 0; len <= 600; len = len ? len * 7 + 5 : 1) {\n            char nm[160], sym[160];\n            snprintf(nm, sizeof nm, \"%s_encrypt len%d\", ae[j].pfx, len);\n            snprintf(sym, sizeof sym, \"%s_encrypt\", ae[j].pfx);\n            CASE(nm, (size_t) len + ae[j].abytes, {\n                GETF(int (*)(uc *, ull *, const uc *, ull, const uc *, ull, const uc *, const uc *, const uc *), f, sym);\n                ull clen = 0;\n                R->ret = f(R->out, &clen, msg, (ull) len, ad, sizeof ad, NULL, npub, key);\n                R->extra = clen;\n            });\n            snprintf(nm, sizeof nm, \"%s_decrypt len%d\", ae[j].pfx, len);\n            CASE(nm, (size_t) len, {\n                char se[160], sd[160];\n                snprintf(se, sizeof se, \"%s_encrypt\", ae[j].pfx);\n                snprintf(sd, sizeof sd, \"%s_decrypt\", ae[j].pfx);\n                GETF(int (*)(uc *, ull *, const uc *, ull, const uc *, ull, const uc *, const uc *, const uc *), e, se);\n                GETF(int (*)(uc *, ull *, uc *, const uc *, ull, const uc *, ull, const uc *, const uc *), f, sd);\n                uc ct[700]; ull clen = 0;\n                e(ct, &clen, msg, (ull) len, ad, sizeof ad, NULL, npub, key);\n                ull mlen = 0;\n                R->ret = f(R->out, &mlen, NULL, ct, clen, ad, sizeof ad, npub, key);\n                R->extra = mlen;\n            });\n            snprintf(nm, sizeof nm, \"%s_decrypt tamper len%d\", ae[j].pfx, len);\n            CASE(nm, (size_t) len, {\n                char se[160], sd[160];\n                snprintf(se, sizeof se, \"%s_encrypt\", ae[j].pfx);\n                snprintf(sd, sizeof sd, \"%s_decrypt\", ae[j].pfx);\n                GETF(int (*)(uc *, ull *, const uc *, ull, const uc *, ull, const uc *, const uc *, const uc *), e, se);\n                GETF(int (*)(uc *, ull *, uc *, const uc *, ull, const uc *, ull, const uc *, const uc *), f, sd);\n                uc ct[700]; ull clen = 0;\n                e(ct, &clen, msg, (ull) len, ad, sizeof ad, NULL, npub, key);\n                ct[0] ^= 0x80;\n                ull mlen = 0;\n                R->ret = f(R->out, &mlen, NULL, ct, clen, ad, sizeof ad, npub, key);\n                R->extra = mlen;\n            });\n            snprintf(nm, sizeof nm, \"%s_encrypt_detached len%d\", ae[j].pfx, len);\n            snprintf(sym, sizeof sym, \"%s_encrypt_detached\", ae[j].pfx);\n            CASE(nm, (size_t) len + ae[j].abytes, {\n                GETF(int (*)(uc *, uc *, ull *, const uc *, ull, const uc *, ull, const uc *, const uc *, const uc *), f, sym);\n                ull maclen = 0;\n                R->ret = f(R->out, R->out + len, &maclen, msg, (ull) len, ad, sizeof ad, NULL, npub, key);\n                R->extra = maclen;\n            });\n        }\n        (void) kb;\n    }\n    /* aes256gcm is unavailable in a portable build: check the error paths */\n    CASE(\"crypto_aead_aes256gcm_is_available\", 0, {\n        GETF(int (*)(void), f, \"crypto_aead_aes256gcm_is_available\");\n        R->ret = f();\n    });\n}\n\n/* =================== secretbox =================== */\n{\n    uc key[32], n24[24], msg[600], padded[700];\n    fillr(key, 32); fillr(n24, 24); fillr(msg, sizeof msg);\n    for (int len = 0; len <= 600; len = len ? len * 7 + 5 : 1) {\n        char nm[128];\n        snprintf(nm, sizeof nm, \"crypto_secretbox_easy len%d\", len);\n        CASE(nm, (size_t) len + 16, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox_easy\");\n            R->ret = f(R->out, msg, (ull) len, n24, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_secretbox_open_easy len%d\", len);\n        CASE(nm, (size_t) len, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), e, \"crypto_secretbox_easy\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox_open_easy\");\n            uc ct[700];\n            e(ct, msg, (ull) len, n24, key);\n            R->ret = f(R->out, ct, (ull) len + 16, n24, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_secretbox_detached len%d\", len);\n        CASE(nm, (size_t) len + 16, {\n            GETF(int (*)(uc *, uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox_detached\");\n            R->ret = f(R->out, R->out + len, msg, (ull) len, n24, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_secretbox_xchacha20poly1305_easy len%d\", len);\n        CASE(nm, (size_t) len + 16, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox_xchacha20poly1305_easy\");\n            R->ret = f(R->out, msg, (ull) len, n24, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_secretbox_xchacha20poly1305_detached len%d\", len);\n        CASE(nm, (size_t) len + 16, {\n            GETF(int (*)(uc *, uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox_xchacha20poly1305_detached\");\n            R->ret = f(R->out, R->out + len, msg, (ull) len, n24, key);\n        });\n        /* NaCl-style API needs 32 zero bytes of padding */\n        memset(padded, 0, 32);\n        memcpy(padded + 32, msg, (size_t) len);\n        snprintf(nm, sizeof nm, \"crypto_secretbox len%d\", len);\n        CASE(nm, (size_t) len + 32, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox\");\n            R->ret = f(R->out, padded, (ull) len + 32, n24, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_secretbox_xsalsa20poly1305 len%d\", len);\n        CASE(nm, (size_t) len + 32, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox_xsalsa20poly1305\");\n            R->ret = f(R->out, padded, (ull) len + 32, n24, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_secretbox_open len%d\", len);\n        CASE(nm, (size_t) len + 32, {\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), e, \"crypto_secretbox\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_secretbox_open\");\n            uc ct[740];\n            e(ct, padded, (ull) len + 32, n24, key);\n            R->ret = f(R->out, ct, (ull) len + 32, n24, key);\n        });\n    }\n}\n\n/* =================== secretstream =================== */\nCASE(\"crypto_secretstream_xchacha20poly1305 roundtrip\", 2048, {\n    uc key[32], m1[100], m2[200], m3[50];\n    GETF(size_t (*)(void), sb, \"crypto_secretstream_xchacha20poly1305_statebytes\");\n    GETF(void (*)(uc *), kgen, \"crypto_secretstream_xchacha20poly1305_keygen\");\n    GETF(int (*)(void *, uc *, const uc *), ipush, \"crypto_secretstream_xchacha20poly1305_init_push\");\n    GETF(int (*)(void *, uc *, ull *, const uc *, ull, const uc *, ull, uc), push, \"crypto_secretstream_xchacha20poly1305_push\");\n    GETF(int (*)(void *, const uc *, const uc *), ipull, \"crypto_secretstream_xchacha20poly1305_init_pull\");\n    GETF(int (*)(void *, uc *, ull *, uc *, const uc *, ull, const uc *, ull), pull, \"crypto_secretstream_xchacha20poly1305_pull\");\n    GETF(void (*)(void *), rekey, \"crypto_secretstream_xchacha20poly1305_rekey\");\n    memset(key, 0x42, 32);\n    kgen(key);\n    void *st = calloc(1, sb() + 64);\n    uc header[64] = { 0 };\n    size_t o = 0;\n    R->ret = ipush(st, header, key);\n    memcpy(R->out + o, header, 24); o += 24;\n    memset(m1, 1, sizeof m1); memset(m2, 2, sizeof m2); memset(m3, 3, sizeof m3);\n    ull clen = 0;\n    R->ret |= push(st, R->out + o, &clen, m1, sizeof m1, NULL, 0, 0);\n    o += clen;\n    rekey(st);\n    R->ret |= push(st, R->out + o, &clen, m2, sizeof m2, m1, 10, 1);\n    o += clen;\n    R->ret |= push(st, R->out + o, &clen, m3, sizeof m3, NULL, 0, 3);\n    o += clen;\n    /* now pull it back */\n    void *st2 = calloc(1, sb() + 64);\n    R->ret |= ipull(st2, header, key);\n    uc tag = 0; ull mlen = 0;\n    size_t p = 24;\n    R->ret |= pull(st2, R->out + o, &mlen, &tag, R->out + p, sizeof m1 + 17, NULL, 0);\n    o += mlen; R->out[o++] = tag; p += sizeof m1 + 17;\n    rekey(st2);\n    R->ret |= pull(st2, R->out + o, &mlen, &tag, R->out + p, sizeof m2 + 17, m1, 10);\n    o += mlen; R->out[o++] = tag; p += sizeof m2 + 17;\n    R->ret |= pull(st2, R->out + o, &mlen, &tag, R->out + p, sizeof m3 + 17, NULL, 0);\n    o += mlen; R->out[o++] = tag;\n    R->extra = o * 1000 + sb();\n    free(st); free(st2);\n});\n\n/* =================== scalarmult / core_ed25519 / ristretto =================== */\n{\n    uc n32[32], p32[32], h64[64], n64[64];\n    fillr(n32, 32); fillr(p32, 32); fillr(h64, 64); fillr(n64, 64);\n    n32[0] &= 248; n32[31] &= 127; n32[31] |= 64;\n    CASE(\"crypto_scalarmult_base\", 32, {\n        GETF(int (*)(uc *, const uc *), f, \"crypto_scalarmult_base\");\n        R->ret = f(R->out, n32);\n    });\n    CASE(\"crypto_scalarmult_curve25519_base\", 32, {\n        GETF(int (*)(uc *, const uc *), f, \"crypto_scalarmult_curve25519_base\");\n        R->ret = f(R->out, n32);\n    });\n    CASE(\"crypto_scalarmult\", 32, {\n        GETF(int (*)(uc *, const uc *), b, \"crypto_scalarmult_base\");\n        GETF(int (*)(uc *, const uc *, const uc *), f, \"crypto_scalarmult\");\n        uc pk[32];\n        b(pk, p32);\n        R->ret = f(R->out, n32, pk);\n    });\n    CASE(\"crypto_scalarmult_curve25519 zero\", 32, {\n        GETF(int (*)(uc *, const uc *, const uc *), f, \"crypto_scalarmult_curve25519\");\n        uc z[32] = { 0 };\n        R->ret = f(R->out, n32, z);\n    });\n    CASE(\"crypto_scalarmult_ed25519_base\", 32, {\n        GETF(int (*)(uc *, const uc *), f, \"crypto_scalarmult_ed25519_base\");\n        R->ret = f(R->out, n32);\n    });\n    CASE(\"crypto_scalarmult_ed25519_base_noclamp\", 32, {\n        GETF(int (*)(uc *, const uc *), f, \"crypto_scalarmult_ed25519_base_noclamp\");\n        R->ret = f(R->out, n32);\n    });\n    CASE(\"crypto_scalarmult_ed25519\", 32, {\n        GETF(int (*)(uc *, const uc *), b, \"crypto_scalarmult_ed25519_base\");\n        GETF(int (*)(uc *, const uc *, const uc *), f, \"crypto_scalarmult_ed25519\");\n        uc pk[32];\n        b(pk, p32);\n        R->ret = f(R->out, n32, pk);\n    });\n    CASE(\"crypto_scalarmult_ed25519_noclamp\", 32, {\n        GETF(int (*)(uc *, const uc *), b, \"crypto_scalarmult_ed25519_base\");\n        GETF(int (*)(uc *, const uc *, const uc *), f, \"crypto_scalarmult_ed25519_noclamp\");\n        uc pk[32];\n        b(pk, p32);\n        R->ret = f(R->out, n32, pk);\n    });\n    CASE(\"crypto_core_ed25519_from_uniform\", 32, {\n        GETF(int (*)(uc *, const uc *), f, \"crypto_core_ed25519_from_uniform\");\n        R->ret = f(R->out, p32);\n    });\n    CASE(\"crypto_core_ed25519_from_hash\", 32, {\n        GETF(int (*)(uc *, const uc *), f, \"crypto_core_ed25519_from_hash\");\n        R->ret = f(R->out, h64);\n    });\n    CASE(\"crypto_core_ed25519_add/sub\", 64, {\n        GETF(int (*)(uc *, const uc *), u, \"crypto_core_ed25519_from_uniform\");\n        GETF(int (*)(uc *, const uc *, const uc *), a, \"crypto_core_ed25519_add\");\n        GETF(int (*)(uc *, const uc *, const uc *), s, \"crypto_core_ed25519_sub\");\n        uc P[32], Q[32];\n        u(P, p32); u(Q, n32);\n        R->ret = a(R->out, P, Q);\n        R->ret |= s(R->out + 32, P, Q);\n    });\n    CASE(\"crypto_core_ed25519_is_valid_point\", 0, {\n        GETF(int (*)(uc *, const uc *), u, \"crypto_core_ed25519_from_uniform\");\n        GETF(int (*)(const uc *), f, \"crypto_core_ed25519_is_valid_point\");\n        uc P[32];\n        u(P, p32);\n        R->ret = f(P) * 10 + f(n32);\n    });\n    CASE(\"crypto_core_ed25519_scalar_random\", 32, {\n        GETF(void (*)(uc *), f, \"crypto_core_ed25519_scalar_random\");\n        f(R->out);\n    });\n    CASE(\"crypto_core_ed25519_scalar_ops\", 160, {\n        GETF(void (*)(uc *, const uc *), red, \"crypto_core_ed25519_scalar_reduce\");\n        GETF(void (*)(uc *, const uc *, const uc *), add, \"crypto_core_ed25519_scalar_add\");\n        GETF(void (*)(uc *, const uc *, const uc *), sub, \"crypto_core_ed25519_scalar_sub\");\n        GETF(void (*)(uc *, const uc *, const uc *), mul, \"crypto_core_ed25519_scalar_mul\");\n        GETF(void (*)(uc *, const uc *), neg, \"crypto_core_ed25519_scalar_negate\");\n        GETF(void (*)(uc *, const uc *), cpl, \"crypto_core_ed25519_scalar_complement\");\n        GETF(int (*)(uc *, const uc *), inv, \"crypto_core_ed25519_scalar_invert\");\n        GETF(int (*)(const uc *), isc, \"crypto_core_ed25519_scalar_is_canonical\");\n        red(R->out, n64);\n        add(R->out + 32, R->out, n32);\n        sub(R->out + 64, R->out, n32);\n        mul(R->out + 96, R->out, n32);\n        neg(R->out + 128, R->out);\n        uc t[32];\n        cpl(t, R->out);\n        R->ret = inv(t, R->out) * 10 + isc(R->out);\n        R->extra = (unsigned long long) isc(n32);\n    });\n    CASE(\"crypto_core_ed25519_scalar_from_string\", 32, {\n        GETF(int (*)(uc *, const char *, const uc *, size_t, const uc *, size_t), f, \"crypto_core_ed25519_scalar_from_string\");\n        R->ret = f(R->out, \"ctx\", h64, 64, (const uc *) \"zzz\", 3);\n    });\n    CASE(\"crypto_core_ed25519_from_string\", 32, {\n        GETF(int (*)(uc *, const char *, const uc *, size_t, const uc *, size_t), f, \"crypto_core_ed25519_from_string\");\n        R->ret = f(R->out, \"ctx\", h64, 64, (const uc *) \"zzz\", 3);\n    });\n    CASE(\"crypto_core_ristretto255_from_hash\", 32, {\n        GETF(int (*)(uc *, const uc *), f, \"crypto_core_ristretto255_from_hash\");\n        R->ret = f(R->out, h64);\n    });\n    CASE(\"crypto_core_ristretto255_add/sub\", 64, {\n        GETF(int (*)(uc *, const uc *), u, \"crypto_core_ristretto255_from_hash\");\n        GETF(int (*)(uc *, const uc *, const uc *), a, \"crypto_core_ristretto255_add\");\n        GETF(int (*)(uc *, const uc *, const uc *), s, \"crypto_core_ristretto255_sub\");\n        uc P[32], Q[32];\n        u(P, h64); u(Q, n64);\n        R->ret = a(R->out, P, Q);\n        R->ret |= s(R->out + 32, P, Q);\n    });\n    CASE(\"crypto_core_ristretto255_is_valid_point\", 0, {\n        GETF(int (*)(uc *, const uc *), u, \"crypto_core_ristretto255_from_hash\");\n        GETF(int (*)(const uc *), f, \"crypto_core_ristretto255_is_valid_point\");\n        uc P[32];\n        u(P, h64);\n        R->ret = f(P) * 10 + f(n32);\n    });\n    CASE(\"crypto_core_ristretto255_scalar_ops\", 160, {\n        GETF(void (*)(uc *, const uc *), red, \"crypto_core_ristretto255_scalar_reduce\");\n        GETF(void (*)(uc *, const uc *, const uc *), add, \"crypto_core_ristretto255_scalar_add\");\n        GETF(void (*)(uc *, const uc *, const uc *), sub, \"crypto_core_ristretto255_scalar_sub\");\n        GETF(void (*)(uc *, const uc *, const uc *), mul, \"crypto_core_ristretto255_scalar_mul\");\n        GETF(void (*)(uc *, const uc *), neg, \"crypto_core_ristretto255_scalar_negate\");\n        GETF(void (*)(uc *, const uc *), cpl, \"crypto_core_ristretto255_scalar_complement\");\n        GETF(int (*)(uc *, const uc *), inv, \"crypto_core_ristretto255_scalar_invert\");\n        GETF(int (*)(const uc *), isc, \"crypto_core_ristretto255_scalar_is_canonical\");\n        red(R->out, n64);\n        add(R->out + 32, R->out, n32);\n        sub(R->out + 64, R->out, n32);\n        mul(R->out + 96, R->out, n32);\n        neg(R->out + 128, R->out);\n        uc t[32];\n        cpl(t, R->out);\n        R->ret = inv(t, R->out) * 10 + isc(R->out);\n    });\n    CASE(\"crypto_core_ristretto255_scalar_from_string\", 32, {\n        GETF(int (*)(uc *, const char *, const uc *, size_t, const uc *, size_t), f, \"crypto_core_ristretto255_scalar_from_string\");\n        R->ret = f(R->out, \"ctx\", h64, 64, (const uc *) \"zzz\", 3);\n    });\n    CASE(\"crypto_core_ristretto255_from_string\", 32, {\n        GETF(int (*)(uc *, const char *, const uc *, size_t, const uc *, size_t), f, \"crypto_core_ristretto255_from_string\");\n        R->ret = f(R->out, \"ctx\", h64, 64, (const uc *) \"zzz\", 3);\n    });\n    CASE(\"crypto_scalarmult_ristretto255\", 64, {\n        GETF(int (*)(uc *, const uc *), b, \"crypto_scalarmult_ristretto255_base\");\n        GETF(int (*)(uc *, const uc *, const uc *), f, \"crypto_scalarmult_ristretto255\");\n        R->ret = b(R->out, n32);\n        R->ret |= f(R->out + 32, p32, R->out);\n    });\n    CASE(\"crypto_core_ed25519_random\", 32, {\n        GETF(void (*)(uc *), f, \"crypto_core_ed25519_random\");\n        f(R->out);\n    });\n    CASE(\"crypto_core_ristretto255_random\", 32, {\n        GETF(void (*)(uc *), f, \"crypto_core_ristretto255_random\");\n        f(R->out);\n    });\n    CASE(\"crypto_core_ristretto255_scalar_random\", 32, {\n        GETF(void (*)(uc *), f, \"crypto_core_ristretto255_scalar_random\");\n        f(R->out);\n    });\n}\n\n/* =================== box =================== */\n{\n    uc seed[32], msg[300], n24[24];\n    fillr(seed, 32); fillr(msg, sizeof msg); fillr(n24, 24);\n    static const char *const pfx[] = {\n        \"crypto_box\", \"crypto_box_curve25519xchacha20poly1305\", NULL\n    };\n    for (int j = 0; pfx[j]; j++) {\n        char nm[160], s[160];\n        snprintf(nm, sizeof nm, \"%s_seed_keypair\", pfx[j]);\n        snprintf(s, sizeof s, \"%s_seed_keypair\", pfx[j]);\n        CASE(nm, 64, {\n            GETF(int (*)(uc *, uc *, const uc *), f, s);\n            R->ret = f(R->out, R->out + 32, seed);\n        });\n        snprintf(nm, sizeof nm, \"%s_keypair\", pfx[j]);\n        snprintf(s, sizeof s, \"%s_keypair\", pfx[j]);\n        CASE(nm, 64, {\n            GETF(int (*)(uc *, uc *), f, s);\n            R->ret = f(R->out, R->out + 32);\n        });\n        snprintf(nm, sizeof nm, \"%s_beforenm\", pfx[j]);\n        CASE(nm, 32, {\n            char sk[160], sb2[160];\n            snprintf(sk, sizeof sk, \"%s_seed_keypair\", pfx[j]);\n            snprintf(sb2, sizeof sb2, \"%s_beforenm\", pfx[j]);\n            GETF(int (*)(uc *, uc *, const uc *), kp, sk);\n            GETF(int (*)(uc *, const uc *, const uc *), f, sb2);\n            uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32];\n            memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n            kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n            R->ret = f(R->out, pk2, sk1);\n        });\n        for (int len = 0; len <= 300; len = len ? len * 9 + 5 : 1) {\n            snprintf(nm, sizeof nm, \"%s_easy len%d\", pfx[j], len);\n            CASE(nm, (size_t) len + 16, {\n                char sk[160], se[160];\n                snprintf(sk, sizeof sk, \"%s_seed_keypair\", pfx[j]);\n                snprintf(se, sizeof se, \"%s_easy\", pfx[j]);\n                GETF(int (*)(uc *, uc *, const uc *), kp, sk);\n                GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *, const uc *), f, se);\n                uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32];\n                memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n                kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n                R->ret = f(R->out, msg, (ull) len, n24, pk2, sk1);\n            });\n            snprintf(nm, sizeof nm, \"%s_open_easy len%d\", pfx[j], len);\n            CASE(nm, (size_t) len, {\n                char sk[160], se[160], so[160];\n                snprintf(sk, sizeof sk, \"%s_seed_keypair\", pfx[j]);\n                snprintf(se, sizeof se, \"%s_easy\", pfx[j]);\n                snprintf(so, sizeof so, \"%s_open_easy\", pfx[j]);\n                GETF(int (*)(uc *, uc *, const uc *), kp, sk);\n                GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *, const uc *), e, se);\n                GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *, const uc *), f, so);\n                uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32], ct[400];\n                memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n                kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n                e(ct, msg, (ull) len, n24, pk2, sk1);\n                R->ret = f(R->out, ct, (ull) len + 16, n24, pk1, sk2);\n            });\n            snprintf(nm, sizeof nm, \"%s_detached len%d\", pfx[j], len);\n            CASE(nm, (size_t) len + 16, {\n                char sk[160], se[160];\n                snprintf(sk, sizeof sk, \"%s_seed_keypair\", pfx[j]);\n                snprintf(se, sizeof se, \"%s_detached\", pfx[j]);\n                GETF(int (*)(uc *, uc *, const uc *), kp, sk);\n                GETF(int (*)(uc *, uc *, const uc *, ull, const uc *, const uc *, const uc *), f, se);\n                uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32];\n                memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n                kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n                R->ret = f(R->out, R->out + len, msg, (ull) len, n24, pk2, sk1);\n            });\n            snprintf(nm, sizeof nm, \"%s_seal len%d\", pfx[j], len);\n            CASE(nm, (size_t) len + 48, {\n                char sk[160], se[160];\n                snprintf(sk, sizeof sk, \"%s_seed_keypair\", pfx[j]);\n                snprintf(se, sizeof se, \"%s_seal\", pfx[j]);\n                GETF(int (*)(uc *, uc *, const uc *), kp, sk);\n                GETF(int (*)(uc *, const uc *, ull, const uc *), f, se);\n                uc pk1[32], sk1[32];\n                kp(pk1, sk1, seed);\n                R->ret = f(R->out, msg, (ull) len, pk1);\n            });\n            snprintf(nm, sizeof nm, \"%s_seal_open len%d\", pfx[j], len);\n            CASE(nm, (size_t) len, {\n                char sk[160], se[160], so[160];\n                snprintf(sk, sizeof sk, \"%s_seed_keypair\", pfx[j]);\n                snprintf(se, sizeof se, \"%s_seal\", pfx[j]);\n                snprintf(so, sizeof so, \"%s_seal_open\", pfx[j]);\n                GETF(int (*)(uc *, uc *, const uc *), kp, sk);\n                GETF(int (*)(uc *, const uc *, ull, const uc *), e, se);\n                GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, so);\n                uc pk1[32], sk1[32], ct[400];\n                kp(pk1, sk1, seed);\n                e(ct, msg, (ull) len, pk1);\n                R->ret = f(R->out, ct, (ull) len + 48, pk1, sk1);\n            });\n        }\n    }\n    /* NaCl-style crypto_box / crypto_box_open (32-byte zero padding) */\n    {\n        uc padded[400];\n        memset(padded, 0, 32);\n        memcpy(padded + 32, msg, 100);\n        CASE(\"crypto_box nacl\", 132, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_box_seed_keypair\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *, const uc *), f, \"crypto_box\");\n            uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32];\n            memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n            kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n            R->ret = f(R->out, padded, 132, n24, pk2, sk1);\n        });\n        CASE(\"crypto_box_open nacl\", 132, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_box_seed_keypair\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *, const uc *), e, \"crypto_box\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *, const uc *), f, \"crypto_box_open\");\n            uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32], ct[400];\n            memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n            kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n            e(ct, padded, 132, n24, pk2, sk1);\n            R->ret = f(R->out, ct, 132, n24, pk1, sk2);\n        });\n        CASE(\"crypto_box_afternm\", 132, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_box_seed_keypair\");\n            GETF(int (*)(uc *, const uc *, const uc *), bn, \"crypto_box_beforenm\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_box_afternm\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), o, \"crypto_box_open_afternm\");\n            uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32], k[32], ct[400];\n            memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n            kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n            bn(k, pk2, sk1);\n            R->ret = f(ct, padded, 132, n24, k);\n            R->ret |= o(R->out, ct, 132, n24, k);\n        });\n        CASE(\"crypto_box_easy_afternm\", 116, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_box_seed_keypair\");\n            GETF(int (*)(uc *, const uc *, const uc *), bn, \"crypto_box_beforenm\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *), f, \"crypto_box_easy_afternm\");\n            uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32], k[32];\n            memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n            kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n            bn(k, pk2, sk1);\n            R->ret = f(R->out, msg, 100, n24, k);\n        });\n        CASE(\"crypto_box_curve25519xsalsa20poly1305\", 132, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_box_curve25519xsalsa20poly1305_seed_keypair\");\n            GETF(int (*)(uc *, const uc *, ull, const uc *, const uc *, const uc *), f, \"crypto_box_curve25519xsalsa20poly1305\");\n            uc pk1[32], sk1[32], pk2[32], sk2[32], seed2[32];\n            memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n            kp(pk1, sk1, seed); kp(pk2, sk2, seed2);\n            R->ret = f(R->out, padded, 132, n24, pk2, sk1);\n        });\n    }\n}\n\n/* =================== sign =================== */\n{\n    uc seed[32], msg[600];\n    fillr(seed, 32); fillr(msg, sizeof msg);\n    CASE(\"crypto_sign_seed_keypair\", 96, {\n        GETF(int (*)(uc *, uc *, const uc *), f, \"crypto_sign_seed_keypair\");\n        R->ret = f(R->out, R->out + 32, seed);\n    });\n    CASE(\"crypto_sign_keypair\", 96, {\n        GETF(int (*)(uc *, uc *), f, \"crypto_sign_keypair\");\n        R->ret = f(R->out, R->out + 32);\n    });\n    CASE(\"crypto_sign_ed25519_seed_keypair\", 96, {\n        GETF(int (*)(uc *, uc *, const uc *), f, \"crypto_sign_ed25519_seed_keypair\");\n        R->ret = f(R->out, R->out + 32, seed);\n    });\n    for (int len = 0; len <= 600; len = len ? len * 9 + 7 : 1) {\n        char nm[96];\n        snprintf(nm, sizeof nm, \"crypto_sign_detached len%d\", len);\n        CASE(nm, 64, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_sign_seed_keypair\");\n            GETF(int (*)(uc *, ull *, const uc *, ull, const uc *), f, \"crypto_sign_detached\");\n            uc pk[32], sk[64];\n            kp(pk, sk, seed);\n            ull sl = 0;\n            R->ret = f(R->out, &sl, msg, (ull) len, sk);\n            R->extra = sl;\n        });\n        snprintf(nm, sizeof nm, \"crypto_sign_verify_detached len%d\", len);\n        CASE(nm, 64, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_sign_seed_keypair\");\n            GETF(int (*)(uc *, ull *, const uc *, ull, const uc *), s, \"crypto_sign_detached\");\n            GETF(int (*)(const uc *, const uc *, ull, const uc *), f, \"crypto_sign_verify_detached\");\n            uc pk[32], sk[64];\n            kp(pk, sk, seed);\n            ull sl = 0;\n            s(R->out, &sl, msg, (ull) len, sk);\n            R->ret = f(R->out, msg, (ull) len, pk);\n            uc bad[64];\n            memcpy(bad, R->out, 64); bad[0] ^= 1;\n            R->extra = (unsigned long long) (f(bad, msg, (ull) len, pk) + 100);\n        });\n        snprintf(nm, sizeof nm, \"crypto_sign len%d\", len);\n        CASE(nm, (size_t) len + 64, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_sign_seed_keypair\");\n            GETF(int (*)(uc *, ull *, const uc *, ull, const uc *), f, \"crypto_sign\");\n            uc pk[32], sk[64];\n            kp(pk, sk, seed);\n            ull sl = 0;\n            R->ret = f(R->out, &sl, msg, (ull) len, sk);\n            R->extra = sl;\n        });\n        snprintf(nm, sizeof nm, \"crypto_sign_open len%d\", len);\n        CASE(nm, (size_t) len, {\n            GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_sign_seed_keypair\");\n            GETF(int (*)(uc *, ull *, const uc *, ull, const uc *), s, \"crypto_sign\");\n            GETF(int (*)(uc *, ull *, const uc *, ull, const uc *), f, \"crypto_sign_open\");\n            uc pk[32], sk[64], sm[700];\n            kp(pk, sk, seed);\n            ull sl = 0;\n            s(sm, &sl, msg, (ull) len, sk);\n            ull ml = 0;\n            R->ret = f(R->out, &ml, sm, sl, pk);\n            R->extra = ml;\n        });\n    }\n    CASE(\"crypto_sign_ed25519_sk_to_pk/seed/curve25519\", 96, {\n        GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_sign_ed25519_seed_keypair\");\n        GETF(int (*)(uc *, const uc *), tp, \"crypto_sign_ed25519_sk_to_pk\");\n        GETF(int (*)(uc *, const uc *), ts, \"crypto_sign_ed25519_sk_to_seed\");\n        GETF(int (*)(uc *, const uc *), tc, \"crypto_sign_ed25519_sk_to_curve25519\");\n        GETF(int (*)(uc *, const uc *), pc, \"crypto_sign_ed25519_pk_to_curve25519\");\n        uc pk[32], sk[64];\n        kp(pk, sk, seed);\n        R->ret  = tp(R->out, sk);\n        R->ret |= ts(R->out + 32, sk);\n        R->ret |= tc(R->out + 64, sk);\n        uc c[32];\n        R->ret |= pc(c, pk);\n        R->extra = c[0] + 256ULL * c[31];\n    });\n    CASE(\"crypto_sign_ph\", 64, {\n        GETF(size_t (*)(void), sb, \"crypto_sign_statebytes\");\n        GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_sign_seed_keypair\");\n        GETF(int (*)(void *), fi, \"crypto_sign_init\");\n        GETF(int (*)(void *, const uc *, ull), fu, \"crypto_sign_update\");\n        GETF(int (*)(void *, uc *, ull *, const uc *), fc, \"crypto_sign_final_create\");\n        GETF(int (*)(void *, const uc *, const uc *), fv, \"crypto_sign_final_verify\");\n        uc pk[32], sk[64];\n        kp(pk, sk, seed);\n        void *st = calloc(1, sb() + 64);\n        R->ret = fi(st);\n        R->ret |= fu(st, msg, 137);\n        R->ret |= fu(st, msg + 137, 200);\n        ull sl = 0;\n        R->ret |= fc(st, R->out, &sl, sk);\n        void *st2 = calloc(1, sb() + 64);\n        fi(st2);\n        fu(st2, msg, 337);\n        R->extra = (unsigned long long) (fv(st2, R->out, pk) + 100) * 1000 + sb();\n        free(st); free(st2);\n    });\n}\n\n/* =================== kdf =================== */\n{\n    uc key[64], ctx[8];\n    fillr(key, 64); fillr(ctx, 8);\n    for (int ol = 16; ol <= 64; ol += 16) {\n        char nm[96];\n        snprintf(nm, sizeof nm, \"crypto_kdf_derive_from_key out%d\", ol);\n        CASE(nm, (size_t) ol, {\n            GETF(int (*)(uc *, size_t, uint64_t, const char *, const uc *), f, \"crypto_kdf_derive_from_key\");\n            R->ret = f(R->out, (size_t) ol, 42, (const char *) ctx, key);\n        });\n        snprintf(nm, sizeof nm, \"crypto_kdf_blake2b_derive_from_key out%d\", ol);\n        CASE(nm, (size_t) ol, {\n            GETF(int (*)(uc *, size_t, uint64_t, const char *, const uc *), f, \"crypto_kdf_blake2b_derive_from_key\");\n            R->ret = f(R->out, (size_t) ol, 42, (const char *) ctx, key);\n        });\n    }\n    static const char *const hk[] = { \"crypto_kdf_hkdf_sha256\", \"crypto_kdf_hkdf_sha512\", NULL };\n    for (int j = 0; hk[j]; j++) {\n        char nm[128], s[128];\n        snprintf(nm, sizeof nm, \"%s_extract+expand\", hk[j]);\n        CASE(nm, 200, {\n            char se[128], sx[128];\n            snprintf(se, sizeof se, \"%s_extract\", hk[j]);\n            snprintf(sx, sizeof sx, \"%s_expand\", hk[j]);\n            GETF(int (*)(uc *, const uc *, size_t, const uc *, size_t), e, se);\n            GETF(int (*)(uc *, size_t, const char *, size_t, const uc *), x, sx);\n            uc prk[64];\n            R->ret = e(prk, key, 16, key + 16, 32);\n            memcpy(R->out, prk, 64);\n            R->ret |= x(R->out + 64, 100, \"info\", 4, prk);\n        });\n        snprintf(nm, sizeof nm, \"%s_extract streaming\", hk[j]);\n        snprintf(s, sizeof s, \"%s_extract_init\", hk[j]);\n        CASE(nm, 128, {\n            char s2[128], s3[128], s4[128];\n            snprintf(s2, sizeof s2, \"%s_extract_update\", hk[j]);\n            snprintf(s3, sizeof s3, \"%s_extract_final\", hk[j]);\n            snprintf(s4, sizeof s4, \"%s_statebytes\", hk[j]);\n            GETF(size_t (*)(void), sb, s4);\n            GETF(int (*)(void *, const uc *, size_t), fi, s);\n            GETF(int (*)(void *, const uc *, size_t), fu, s2);\n            GETF(int (*)(void *, uc *), ff, s3);\n            void *st = calloc(1, sb() + 64);\n            R->ret = fi(st, key, 16);\n            R->ret |= fu(st, key + 16, 20);\n            R->ret |= fu(st, key + 36, 28);\n            R->ret |= ff(st, R->out);\n            R->extra = sb();\n            free(st);\n        });\n    }\n}\n\n/* =================== kem =================== */\n{\n    uc seed[64];\n    fillr(seed, 64);\n    struct { const char *pfx; size_t seedb, pkb, skb, ctb, ssb; } km[] = {\n        { \"crypto_kem_mlkem768\", 64, 1184, 2400, 1088, 32 },\n        { \"crypto_kem_xwing\", 32, 1216, 32, 1120, 32 },\n        { \"crypto_kem\", 32, 1216, 32, 1120, 32 },\n    };\n    for (unsigned j = 0; j < sizeof km / sizeof km[0]; j++) {\n        char nm[160], s[160];\n        snprintf(nm, sizeof nm, \"%s_seed_keypair\", km[j].pfx);\n        snprintf(s, sizeof s, \"%s_seed_keypair\", km[j].pfx);\n        CASE(nm, 0, {\n            char sq[160];\n            snprintf(sq, sizeof sq, \"%s_publickeybytes\", km[j].pfx);\n            GETF(size_t (*)(void), pkb, sq);\n            snprintf(sq, sizeof sq, \"%s_secretkeybytes\", km[j].pfx);\n            GETF(size_t (*)(void), skb, sq);\n            snprintf(sq, sizeof sq, \"%s_seedbytes\", km[j].pfx);\n            GETF(size_t (*)(void), sdb, sq);\n            GETF(int (*)(uc *, uc *, const uc *), f, s);\n            uc *pk = malloc(pkb() + 16), *sk = malloc(skb() + 16);\n            R->ret = f(pk, sk, seed);\n            /* hash the keys into out via a simple checksum so sizes fit */\n            unsigned long long acc = 1469598103934665603ULL;\n            for (size_t i = 0; i < pkb(); i++) { acc ^= pk[i]; acc *= 1099511628211ULL; }\n            for (size_t i = 0; i < skb(); i++) { acc ^= sk[i]; acc *= 1099511628211ULL; }\n            R->extra = acc;\n            (void) sdb;\n            free(pk); free(sk);\n        });\n        snprintf(nm, sizeof nm, \"%s_enc/dec\", km[j].pfx);\n        CASE(nm, 64, {\n            char sq[160], se[160], sd[160], sk2[160];\n            snprintf(sq, sizeof sq, \"%s_publickeybytes\", km[j].pfx);\n            GETF(size_t (*)(void), pkb, sq);\n            snprintf(sq, sizeof sq, \"%s_secretkeybytes\", km[j].pfx);\n            GETF(size_t (*)(void), skb, sq);\n            snprintf(sq, sizeof sq, \"%s_ciphertextbytes\", km[j].pfx);\n            GETF(size_t (*)(void), ctb, sq);\n            snprintf(sk2, sizeof sk2, \"%s_seed_keypair\", km[j].pfx);\n            snprintf(se, sizeof se, \"%s_enc\", km[j].pfx);\n            snprintf(sd, sizeof sd, \"%s_dec\", km[j].pfx);\n            GETF(int (*)(uc *, uc *, const uc *), kp, sk2);\n            GETF(int (*)(uc *, uc *, const uc *), e, se);\n            GETF(int (*)(uc *, const uc *, const uc *), d, sd);\n            uc *pk = malloc(pkb() + 16), *sk = malloc(skb() + 16), *ct = malloc(ctb() + 16);\n            kp(pk, sk, seed);\n            R->ret = e(ct, R->out, pk);\n            R->ret |= d(R->out + 32, ct, sk);\n            free(pk); free(sk); free(ct);\n        });\n        snprintf(nm, sizeof nm, \"%s_enc_deterministic\", km[j].pfx);\n        CASE(nm, 32, {\n            char sq[160], se[160], sk2[160];\n            snprintf(sq, sizeof sq, \"%s_publickeybytes\", km[j].pfx);\n            GETF(size_t (*)(void), pkb, sq);\n            snprintf(sq, sizeof sq, \"%s_secretkeybytes\", km[j].pfx);\n            GETF(size_t (*)(void), skb, sq);\n            snprintf(sq, sizeof sq, \"%s_ciphertextbytes\", km[j].pfx);\n            GETF(size_t (*)(void), ctb, sq);\n            snprintf(sk2, sizeof sk2, \"%s_seed_keypair\", km[j].pfx);\n            snprintf(se, sizeof se, \"%s_enc_deterministic\", km[j].pfx);\n            GETF(int (*)(uc *, uc *, const uc *), kp, sk2);\n            GETF(int (*)(uc *, uc *, const uc *, const uc *), e, se);\n            uc *pk = malloc(pkb() + 16), *sk = malloc(skb() + 16), *ct = malloc(ctb() + 16);\n            kp(pk, sk, seed);\n            R->ret = e(ct, R->out, pk, seed + 16);\n            unsigned long long acc = 1469598103934665603ULL;\n            for (size_t i = 0; i < ctb(); i++) { acc ^= ct[i]; acc *= 1099511628211ULL; }\n            R->extra = acc;\n            free(pk); free(sk); free(ct);\n        });\n    }\n}\n\n/* =================== kx =================== */\n{\n    uc seed[32];\n    fillr(seed, 32);\n    CASE(\"crypto_kx_seed_keypair\", 64, {\n        GETF(int (*)(uc *, uc *, const uc *), f, \"crypto_kx_seed_keypair\");\n        R->ret = f(R->out, R->out + 32, seed);\n    });\n    CASE(\"crypto_kx_keypair\", 64, {\n        GETF(int (*)(uc *, uc *), f, \"crypto_kx_keypair\");\n        R->ret = f(R->out, R->out + 32);\n    });\n    CASE(\"crypto_kx_session_keys\", 128, {\n        GETF(int (*)(uc *, uc *, const uc *), kp, \"crypto_kx_seed_keypair\");\n        GETF(int (*)(uc *, uc *, const uc *, const uc *, const uc *), cl, \"crypto_kx_client_session_keys\");\n        GETF(int (*)(uc *, uc *, const uc *, const uc *, const uc *), sv, \"crypto_kx_server_session_keys\");\n        uc cpk[32], csk[32], spk[32], ssk[32], seed2[32];\n        memcpy(seed2, seed, 32); seed2[0] ^= 0xff;\n        kp(cpk, csk, seed); kp(spk, ssk, seed2);\n        R->ret  = cl(R->out, R->out + 32, cpk, csk, spk);\n        R->ret |= sv(R->out + 64, R->out + 96, spk, ssk, cpk);\n    });\n}\n\n/* =================== ipcrypt =================== */\n{\n    uc key[64], ip[16], tweak[16];\n    fillr(key, 64); fillr(ip, 16); fillr(tweak, 16);\n    CASE(\"crypto_ipcrypt_encrypt/decrypt\", 32, {\n        GETF(int (*)(uc *, const uc *, const uc *), e, \"crypto_ipcrypt_encrypt\");\n        GETF(int (*)(uc *, const uc *, const uc *), d, \"crypto_ipcrypt_decrypt\");\n        R->ret  = e(R->out, ip, key);\n        R->ret |= d(R->out + 16, R->out, key);\n    });\n    CASE(\"crypto_ipcrypt_nd\", 48, {\n        GETF(int (*)(uc *, const uc *, const uc *, const uc *), e, \"crypto_ipcrypt_nd_encrypt\");\n        GETF(int (*)(uc *, const uc *, const uc *), d, \"crypto_ipcrypt_nd_decrypt\");\n        R->ret  = e(R->out, ip, key, tweak);\n        R->ret |= d(R->out + 24, R->out, key);\n    });\n    CASE(\"crypto_ipcrypt_ndx\", 64, {\n        GETF(int (*)(uc *, const uc *, const uc *, const uc *), e, \"crypto_ipcrypt_ndx_encrypt\");\n        GETF(int (*)(uc *, const uc *, const uc *), d, \"crypto_ipcrypt_ndx_decrypt\");\n        R->ret  = e(R->out, ip, key, tweak);\n        R->ret |= d(R->out + 32, R->out, key);\n    });\n    CASE(\"crypto_ipcrypt_pfx\", 32, {\n        GETF(int (*)(uc *, const uc *, const uc *), e, \"crypto_ipcrypt_pfx_encrypt\");\n        GETF(int (*)(uc *, const uc *, const uc *), d, \"crypto_ipcrypt_pfx_decrypt\");\n        R->ret  = e(R->out, ip, key);\n        R->ret |= d(R->out + 16, R->out, key);\n    });\n}\n\n/* =================== pwhash =================== */\n{\n    const char *pw = \"Correct Horse Battery Staple\";\n    uc salt[32];\n    fillr(salt, 32);\n    for (int alg = 1; alg <= 2; alg++) {\n        char nm[96];\n        snprintf(nm, sizeof nm, \"crypto_pwhash alg%d\", alg);\n        CASE(nm, 64, {\n            GETF(int (*)(uc *, ull, const char *, ull, const uc *, ull, size_t, int), f, \"crypto_pwhash\");\n            R->ret = f(R->out, 64, pw, strlen(pw), salt, 3, 16384, alg);\n        });\n    }\n    CASE(\"crypto_pwhash_argon2i\", 64, {\n        GETF(int (*)(uc *, ull, const char *, ull, const uc *, ull, size_t, int), f, \"crypto_pwhash\");\n        R->ret = f(R->out, 64, pw, strlen(pw), salt, 4, 32768, 1);\n    });\n    CASE(\"crypto_pwhash_str_verify argon2id\", 128, {\n        GETF(int (*)(char *, const char *, ull, ull, size_t), f, \"crypto_pwhash_str\");\n        GETF(int (*)(const char *, const char *, ull), v, \"crypto_pwhash_str_verify\");\n        GETF(int (*)(const char *, ull, size_t), nr, \"crypto_pwhash_str_needs_rehash\");\n        R->ret = f((char *) R->out, pw, strlen(pw), 3, 16384);\n        R->extra = (unsigned long long) (v((char *) R->out, pw, strlen(pw)) + 10) * 1000\n                 + (unsigned long long) (nr((char *) R->out, 3, 16384) + 10);\n    });\n    CASE(\"crypto_pwhash_str_alg argon2i\", 128, {\n        GETF(int (*)(char *, const char *, ull, ull, size_t, int), f, \"crypto_pwhash_str_alg\");\n        GETF(int (*)(const char *, const char *, ull), v, \"crypto_pwhash_str_verify\");\n        R->ret = f((char *) R->out, pw, strlen(pw), 3, 16384, 1);\n        R->extra = (unsigned long long) (v((char *) R->out, pw, strlen(pw)) + 10);\n    });\n    CASE(\"crypto_pwhash_argon2i_str\", 128, {\n        GETF(int (*)(char *, const char *, ull, ull, size_t), f, \"crypto_pwhash_argon2i_str\");\n        GETF(int (*)(const char *, const char *, ull), v, \"crypto_pwhash_argon2i_str_verify\");\n        R->ret = f((char *) R->out, pw, strlen(pw), 3, 16384);\n        R->extra = (unsigned long long) (v((char *) R->out, pw, strlen(pw)) + 10);\n    });\n    CASE(\"crypto_pwhash_argon2id_str\", 128, {\n        GETF(int (*)(char *, const char *, ull, ull, size_t), f, \"crypto_pwhash_argon2id_str\");\n        GETF(int (*)(const char *, const char *, ull), v, \"crypto_pwhash_argon2id_str_verify\");\n        R->ret = f((char *) R->out, pw, strlen(pw), 3, 16384);\n        R->extra = (unsigned long long) (v((char *) R->out, pw, strlen(pw)) + 10);\n    });\n   