{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01D6Sq2EYhqpTh95Zk1oJT5S","type":"tool_result","content":"1\t//! Shared differential-testing harness.\n2\t//!\n3\t//! Loads BOTH the C `.so` and the Rust `.so` via `libloading` and exposes\n4\t//! helpers to fetch matching symbols from each. Tests then call the same\n5\t//! symbol on both libraries and compare results byte-for-byte.\n6\t//!\n7\t//! We NEVER call Rust functions directly — every call goes through the\n8\t//! exported `#[no_mangle]` symbol loaded from the cdylib, exactly as an\n9\t//! external C consumer would.\n10\t\n11\tuse libloading::{Library, Symbol};\n12\tuse std::path::PathBuf;\n13\tuse std::sync::OnceLock;\n14\t\n15\tpub struct Libs {\n16\t    pub c: Library,\n17\t    pub rust: Library,\n18\t}\n19\t\n20\tfn crate_root() -> PathBuf {\n21\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n22\t}\n23\t\n24\tfn c_so_path() -> PathBuf {\n25\t    crate_root().join(\"c_src/build/libsodium.so\")\n26\t}\n27\t\n28\tfn rust_so_path() -> PathBuf {\n29\t    // The cdylib produced by this crate.\n30\t    let mut p = crate_root().join(\"target\");\n31\t    // Prefer release, fall back to debug.\n32\t    let rel = p.join(\"release/liblibsodium.so\");\n33\t    if rel.exists() {\n34\t        return rel;\n35\t    }\n36\t    p.push(\"debug/liblibsodium.so\");\n37\t    p\n38\t}\n39\t\n40\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n41\t\n42\tpub fn libs() -> &'static Libs {\n43\t    LIBS.get_or_init(|| {\n44\t        let c = unsafe { Library::new(c_so_path()).expect(\"load C .so\") };\n45\t        let rust = unsafe { Library::new(rust_so_path()).expect(\"load Rust .so\") };\n46\t        // Both libraries need sodium_init() called once.\n47\t        unsafe {\n48\t            let ci: Symbol<unsafe extern \"C\" fn() -> i32> =\n49\t                c.get(b\"sodium_init\").expect(\"C sodium_init\");\n50\t            let ri: Symbol<unsafe extern \"C\" fn() -> i32> =\n51\t                rust.get(b\"sodium_init\").expect(\"Rust sodium_init\");\n52\t            ci();\n53\t            ri();\n54\t        }\n55\t        Libs { c, rust }\n56\t    })\n57\t}\n58\t\n59\t/// Fetch a symbol of type `T` from both libraries.\n60\t#[macro_export]\n61\tmacro_rules! sympair {\n62\t    ($libs:expr, $name:expr, $t:ty) => {{\n63\t        let cs: libloading::Symbol<$t> =\n64\t            unsafe { $libs.c.get($name).expect(concat!(\"C symbol \", stringify!($name))) };\n65\t        let rs: libloading::Symbol<$t> =\n66\t            unsafe { $libs.rust.get($name).expect(concat!(\"Rust symbol \", stringify!($name))) };\n67\t        (cs, rs)\n68\t    }};\n69\t}\n70\t\n71\t/// A small deterministic PRNG (xorshift64*) for reproducible fuzzing.\n72\tpub struct Rng(pub u64);\n73\t\n74\timpl Rng {\n75\t    pub fn new(seed: u64) -> Self {\n76\t        Rng(seed ^ 0x9E3779B97F4A7C15)\n77\t    }\n78\t    pub fn next_u64(&mut self) -> u64 {\n79\t        let mut x = self.0;\n80\t        x ^= x >> 12;\n81\t        x ^= x << 25;\n82\t        x ^= x >> 27;\n83\t        self.0 = x;\n84\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n85\t    }\n86\t    pub fn fill(&mut self, buf: &mut [u8]) {\n87\t        for b in buf.iter_mut() {\n88\t            *b = (self.next_u64() & 0xff) as u8;\n89\t        }\n90\t    }\n91\t    pub fn range(&mut self, n: usize) -> usize {\n92\t        if n == 0 {\n93\t            0\n94\t        } else {\n95\t            (self.next_u64() % n as u64) as usize\n96\t        }\n97\t    }\n98\t    pub fn vec(&mut self, len: usize) -> Vec<u8> {\n99\t        let mut v = vec![0u8; len];\n100\t        self.fill(&mut v);\n101\t        v\n102\t    }\n103\t}\n104\t"}]},"parent_tool_use_id":"toolu_bdrk_01KDzZPJ6YYqRdPncbvqV2sj","session_id":"273db57d-0194-450c-88e2-05a6550af9c0","uuid":"f336f07f-b514-476a-99ad-1b55d08f8248","timestamp":"2026-08-05T06:12:35.722Z","subagent_type":"general-purpose","task_description":"Diff tests: hashing family"}
