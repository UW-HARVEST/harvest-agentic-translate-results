> shift) & 0xffu) << 16) | (((row3 >> shift) & 0xffu) << 24);\n562\t}\n563\t\n564\tstatic inline uint32_t\n565\tsrm1r_gather_row_bit(uint32_t row_word, unsigned int bit)\n566\t{\n567\t    return (((row_word >> bit) & 0x01010101u) * 0x01020408u) >> 24;\n568\t}\n569\t\n570\tstatic inline uint32_t\n571\tsrm1r_pack_rows_bit(uint32_t row0, uint32_t row1, uint32_t row2, uint32_t row3, unsigned int bit)\n572\t{\n573\t    return srm1r_dup16(srm1r_gather_row_bit(row0, bit) | (srm1r_gather_row_bit(row1, bit) << 4) |\n574\t                       (srm1r_gather_row_bit(row2, bit) << 8) |\n575\t                       (srm1r_gather_row_bit(row3, bit) << 12));\n576\t}\n577\t\n578\tstatic inline uint32_t\n579\tsrm1r_spread_row_bits(uint32_t nibble, unsigned int bit)\n580\t{\n581\t    nibble &= 0x0fu;\n582\t    return ((nibble * 0x00204081u) & 0x01010101u) << bit;\n583\t}\n584\t\n585\tstatic inline uint32_t\n586\tsrm1r_unpack_row_word(const uint32_t planes[8], unsigned int row)\n587\t{\n588\t    const unsigned int lane_shift = 4u * row;\n589\t\n590\t    return srm1r_spread_row_bits(planes[0] >> lane_shift, 7) |\n591\t           srm1r_spread_row_bits(planes[1] >> lane_shift, 6) |\n592\t           srm1r_spread_row_bits(planes[2] >> lane_shift, 5) |\n593\t           srm1r_spread_row_bits(planes[3] >> lane_shift, 4) |\n594\t           srm1r_spread_row_bits(planes[4] >> lane_shift, 3) |\n595\t           srm1r_spread_row_bits(planes[5] >> lane_shift, 2) |\n596\t           srm1r_spread_row_bits(planes[6] >> lane_shift, 1) |\n597\t           srm1r_spread_row_bits(planes[7] >> lane_shift, 0);\n598\t}\n599\t\n600\tstatic inline void\n601\tsrm1r_pack_planes(uint32_t planes[8], uint32_t row0, uint32_t row1, uint32_t row2, uint32_t row3)\n602\t{\n603\t    planes[0] = srm1r_pack_rows_bit(row0, row1, row2, row3, 7);\n604\t    planes[1] = srm1r_pack_rows_bit(row0, row1, row2, row3, 6);\n605\t    planes[2] = srm1r_pack_rows_bit(row0, row1, row2, row3, 5);\n606\t    planes[3] = srm1r_pack_rows_bit(row