     c >>= 8;\n313\t    }\n314\t}\n315\t\n316\tvoid\n317\tsodium_add(unsigned char *a, const unsigned char *b, const size_t len)\n318\t{\n319\t    size_t        i;\n320\t    uint_fast16_t c = 0U;\n321\t\n322\t#ifdef HAVE_AMD64_ASM\n323\t    uint64_t t64, t64_2, t64_3;\n324\t    uint32_t t32;\n325\t\n326\t    if (len == 12U) {\n327\t        __asm__ __volatile__(\n328\t            \"movq (%[in]), %[t64] \\n\"\n329\t            \"movl 8(%[in]), %[t32] \\n\"\n330\t            \"addq %[t64], (%[out]) \\n\"\n331\t            \"adcl %[t32], 8(%[out]) \\n\"\n332\t            : [t64] \"=&r\"(t64), [t32] \"=&r\"(t32)\n333\t            : [in] \"S\"(b), [out] \"D\"(a)\n334\t            : \"memory\", \"flags\", \"cc\");\n335\t        return;\n336\t    } else if (len == 24U) {\n337\t        __asm__ __volatile__(\n338\t            \"movq (%[in]), %[t64] \\n\"\n339\t            \"movq 8(%[in]), %[t64_2] \\n\"\n340\t            \"movq 16(%[in]), %[t64_3] \\n\"\n341\t            \"addq %[t64], (%[out]) \\n\"\n342\t            \"adcq %[t64_2], 8(%[out]) \\n\"\n343\t            \"adcq %[t64_3], 16(%[out]) \\n\"\n344\t            : [t64] \"=&r\"(t64), [t64_2] \"=&r\"(t64_2), [t64_3] \"=&r\"(t64_3)\n345\t            : [in] \"S\"(b), [out] \"D\"(a)\n346\t            : \"memory\", \"flags\", \"cc\");\n347\t        return;\n348\t    } else if (len == 8U) {\n349\t        __asm__ __volatile__(\n350\t            \"movq (%[in]), %[t64] \\n\"\n351\t            \"addq %[t64], (%[out]) \\n\"\n352\t            : [t64] \"=&r\"(t64)\n353\t            : [in] \"S\"(b), [out] \"D\"(a)\n354\t            : \"memory\", \"flags\", \"cc\");\n355\t        return;\n356\t    }\n357\t#endif\n358\t    for (i = 0U; i < len; i++) {\n359\t        c += (uint_fast16_t) a[i] + (uint_fast16_t) b[i];\n360\t        a[i] = (unsigned char) c;\n361\t        c >>= 8;\n362\t    }\n363\t}\n364\t\n365\tvoid\n366\tsodium_sub(unsigned char *a, const unsigned char *b, const size_t len)\n367\t{\n368\t    uint_fast16_t c = 0U;\n369\t    size_t        i;\n370\t\n371\t#ifdef HAVE_AMD64_ASM\n372\t    uint64_t t64_1, t64_2, t64_3, t64_4;\n373\t    uint64_t t64_5, t64_6, t64_7, t64_8;\n374\t\n375\t    if (len == 64U) {\n376\t        __asm__ __volatile__(\n377\t            \"movq   (%[in]), %[t64_1] \\n\"\n378\t            \"movq  8(%[in]), %[t64_2] \\n\"\n379\t            \"movq 16(%[in]), %[t64_3] \\n\"\n380\t            \"movq 24(%[in]), %[t64_4] \\n\"\n381\t            \"movq 32(%[in]), %[t64_5] \\n\"\n382\t            \"movq 40(%[in]), %[t64_6] \\n\"\n383\t            \"movq 48(%[in]), %[t64_7] \\n\"\n384\t            \"movq 56(%[in]), %[t64_8] \\n\"\n385\t            \"subq %[t64_1],   (%[out]) \\n\"\n386\t            \"sbbq %[t64_2],  8(%[out]) \\n\"\n387\t            \"sbbq %[t64_3], 16(%[out]) \\n\"\n388\t            \"sbbq %[t64_4], 24(%[out]) \\n\"\n389\t            \"sbbq %[t64_5], 32(%[out]) \\n\"\n390\t            \"sbbq %[t64_6], 40(%[out]) \\n\"\n391\t            \"sbbq %[t64_7], 48(%[out]) \\n\"\n392\t            \"sbbq %[t64_8], 56(%[out]) \\n\"\n393\t            : [t64_1] \"=&r\"(t64_1), [t64_2] \"=&r\"(t64_2), [t64_3] \"=&r\"(t64_3), [t64_4] \"=&r\"(t64_4),\n394\t              [t64_5] \"=&r\"(t64_5), [t64_6] \"=&r\"(t64_6), [t64_7] \"=&r\"(t64_7), [t64_8] \"=&r\"(t64_8)\n395\t            : [in] \"S\"(b), [out] \"D\"(a)\n396\t            : \"memory\", \"flags\", \"cc\");\n397\t        return;\n398\t    }\n399\t#endif\n400\t    for (i = 0U; i < len; i++) {\n401\t        c = (uint_fast16_t) a[i] - (uint_fast16_t) b[i] - c;\n402\t        a[i] = (unsigned char) c;\n403\t        c = (c >> 8) & 1U;\n404\t    }\n405\t}\n406\t\n407\tint\n408\t_sodium_alloc_init(void)\n409\t{\n410\t#ifdef HAVE_ALIGNED_MALLOC\n411\t# if defined(_SC_PAGESIZE) && defined(HAVE_SYSCONF)\n412\t    long page_size_ = sysconf(_SC_PAGESIZE);\n413\t    if (page_size_ > 0L) {\n414\t        page_size = (size_t) page_size_;\n415\t    }\n416\t# elif defined(WINAPI_DESKTOP)\n417\t    SYSTEM_INFO si;\n418\t    GetSystemInfo(&si);\n419\t    page_size = (size_t) si.dwPageSize;\n420\t# elif !defined(PAGE_SIZE)\n421\t#  warning Unknown page size\n422\t# endif\n423\t    if (page_size < CANARY_SIZE || page_size < sizeof(size_t)) {\n424\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n425\t    }\n426\t#endif\n427\t    randombytes_buf(canary, CANARY_SIZE);\n428\t\n429\t    return 0;\n430\t}\n431\t\n432\tint\n433\tsodium_mlock(void *const addr, const size_t len)\n434\t{\n435\t#if defined(MADV_DONTDUMP) && defined(HAVE_MADVISE)\n436\t    (void) madvise(addr, len, MADV_DONTDUMP);\n437\t#endif\n438\t#ifdef HAVE_MLOCK\n439\t    return mlock(addr, len);\n440\t#elif defined(WINAPI_DESKTOP)\n441\t    return -(VirtualLock(addr, len) == 0);\n442\t#else\n443\t    errno = ENOSYS;\n444\t    return -1;\n445\t#endif\n446\t}\n447\t\n448\tint\n449\tsodium_munlock(void *const addr, const size_t len)\n450\t{\n451\t    sodium_memzero(addr, len);\n452\t#if defined(MADV_DODUMP) && defined(HAVE_MADVISE)\n453\t    (void) madvise(addr, len, MADV_DODUMP);\n454\t#endif\n455\t#ifdef HAVE_MLOCK\n456\t    return munlock(addr, len);\n457\t#elif defined(WINAPI_DESKTOP)\n458\t    return -(VirtualUnlock(addr, len) == 0);\n459\t#else\n460\t    errno = ENOSYS;\n461\t    return -1;\n462\t#endif\n463\t}\n464\t\n465\tstatic int\n466\t_mprotect_noaccess(void *ptr, size_t size)\n467\t{\n468\t#ifdef HAVE_MPROTECT\n469\t    return mprotect(ptr, size, PROT_NONE);\n470\t#elif defined(WINAPI_DESKTOP)\n471\t    DWORD old;\n472\t    return -(VirtualProtect(ptr, size, PAGE_NOACCESS, &old) == 0);\n473\t#else\n474\t    errno = ENOSYS;\n475\t    return -1;\n476\t#endif\n477\t}\n478\t\n479\tstatic int\n480\t_mprotect_readonly(void *ptr, size_t size)\n481\t{\n482\t#ifdef HAVE_MPROTECT\n483\t    return mprotect(ptr, size, PROT_READ);\n484\t#elif defined(WINAPI_DESKTOP)\n485\t    DWORD old;\n486\t    return -(VirtualProtect(ptr, size, PAGE_READONLY, &old) == 0);\n487\t#else\n488\t    errno = ENOSYS;\n489\t    return -1;\n490\t#endif\n491\t}\n492\t\n493\tstatic int\n494\t_mprotect_readwrite(void *ptr, size_t size)\n495\t{\n496\t#ifdef HAVE_MPROTECT\n497\t    return mprotect(ptr, size, PROT_READ | PROT_WRITE);\n498\t#elif defined(WINAPI_DESKTOP)\n499\t    DWORD old;\n500\t    return -(VirtualProtect(ptr, size, PAGE_READWRITE, &old) == 0);\n501\t#else\n502\t    errno = ENOSYS;\n503\t    return -1;\n504\t#endif\n505\t}\n506\t\n507\t#ifdef HAVE_ALIGNED_MALLOC\n508\t\n509\t/* LCOV_EXCL_START */\n510\t__attribute__((noreturn)) static void\n511\t_out_of_bounds(void)\n512\t{\n513\t# if defined(HAVE_RAISE) && !defined(__wasm__)\n514\t#  ifdef SIGPROT\n515\t    raise(SIGPROT);\n516\t#  elif defined(SIGSEGV)\n517\t    raise(SIGSEGV);\n518\t#  elif defined(SIGKILL)\n519\t    raise(SIGKILL);\n520\t#  endif\n521\t# endif\n522\t    abort(); /* not something we want any higher-level API to catch */\n523\t}\n524\t/* LCOV_EXCL_STOP */\n525\t\n526\tstatic inline size_t\n527\t_page_round(const size_t size)\n528\t{\n529\t    const size_t page_mask = page_size - 1U;\n530\t\n531\t    return (size + page_mask) & ~page_mask;\n532\t}\n533\t\n534\tstatic __attribute__((malloc)) unsigned char *\n535\t_alloc_aligned(const size_t size)\n536\t{\n537\t    void *ptr;\n538\t\n539\t# if defined(MAP_ANON) && defined(HAVE_MMAP)\n540\t    if ((ptr = mmap(NULL, size, PROT_READ | PROT_WRITE,\n541\t                    MAP_ANON | MAP_PRIVATE | MAP_NOCORE, -1, 0)) ==\n542\t        MAP_FAILED) {\n543\t        ptr = NULL; /* LCOV_EXCL_LINE */\n544\t    }               /* LCOV_EXCL_LINE */\n545\t# elif defined(HAVE_POSIX_MEMALIGN)\n546\t    if (posix_memalign(&ptr, page_size, size) != 0) {\n547\t        ptr = NULL; /* LCOV_EXCL_LINE */\n548\t    }               /* LCOV_EXCL_LINE */\n549\t# elif defined(WINAPI_DESKTOP)\n550\t    ptr = VirtualAlloc(NULL, size, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);\n551\t# else\n552\t#  error Bug\n553\t# endif\n554\t    return (unsigned char *) ptr;\n555\t}\n556\t\n557\tstatic void\n558\t_free_aligned(unsigned char *con