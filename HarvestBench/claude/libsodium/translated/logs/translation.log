{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016DNuY7xi2sWLpztpiWyJxH","type":"tool_result","content":"1\t#include <stdint.h>\n2\t#include <string.h>\n3\t\n4\t#include \"crypto_core_keccak1600.h\"\n5\t#include \"crypto_xof_turboshake128.h\"\n6\t#include \"private/common.h\"\n7\t#include \"turboshake128_ref.h\"\n8\t\n9\tint\n10\tturboshake128_ref_init_with_domain(turboshake128_state_internal *state, unsigned char domain)\n11\t{\n12\t    crypto_core_keccak1600_init(&state->state);\n13\t    state->offset = 0;\n14\t    state->phase  = TURBOSHAKE128_PHASE_ABSORBING;\n15\t    state->domain = domain;\n16\t\n17\t    return 0;\n18\t}\n19\t\n20\tint\n21\tturboshake128_ref_init(turboshake128_state_internal *state)\n22\t{\n23\t    return turboshake128_ref_init_with_domain(state, crypto_xof_turboshake128_DOMAIN_STANDARD);\n24\t}\n25\t\n26\tint\n27\tturboshake128_ref_update(turboshake128_state_internal *state, const unsigned char *in, size_t inlen)\n28\t{\n29\t    size_t consumed = 0;\n30\t    size_t chunk_size;\n31\t    int    ret = 0;\n32\t\n33\t    if (state->phase != TURBOSHAKE128_PHASE_ABSORBING) {\n34\t        crypto_core_keccak1600_permute_12(&state->state);\n35\t        state->phase  = TURBOSHAKE128_PHASE_ABSORBING;\n36\t        state->offset = 0;\n37\t        ret = -1;\n38\t    }\n39\t\n40\t    if (state->offset == TURBOSHAKE128_RATE && inlen > 0U) {\n41\t        crypto_core_keccak1600_permute_12(&state->state);\n42\t        state->offset = 0;\n43\t    }\n44\t    if (state->offset != 0U && inlen > 0U) {\n45\t        chunk_size = TURBOSHAKE128_RATE - state->offset;\n46\t        if (chunk_size > inlen) {\n47\t            chunk_size = inlen;\n48\t        }\n49\t        crypto_core_keccak1600_xor_bytes(&state->state, in, state->offset, chunk_size);\n50\t        state->offset += chunk_size;\n51\t        consumed = chunk_size;\n52\t        if (state->offset == TURBOSHAKE128_RATE && consumed < inlen) {\n53\t            crypto_core_keccak1600_permute_12(&state->state);\n54\t            state->offset = 0;\n55\t        }\n56\t    }\n57\t    while (inlen - consumed >= TURBOSHAKE128_RATE) {\n58\t        crypto_core_keccak1600_xor_bytes(&state->state, &in[consumed], 0U, TURBOSHAKE128_RATE);\n59\t        consumed += TURBOSHAKE128_RATE;\n60\t        state->offset = TURBOSHAKE128_RATE;\n61\t        if (consumed < inlen) {\n62\t            crypto_core_keccak1600_permute_12(&state->state);\n63\t            state->offset = 0;\n64\t        }\n65\t    }\n66\t    if (consumed < inlen) {\n67\t        chunk_size = inlen - consumed;\n68\t        crypto_core_keccak1600_xor_bytes(&state->state, &in[consumed], 0U, chunk_size);\n69\t        state->offset = chunk_size;\n70\t    }\n71\t\n72\t    return ret;\n73\t}\n74\t\n75\tstatic void\n76\tturboshake128_finalize(turboshake128_state_internal *state)\n77\t{\n78\t    unsigned char pad;\n79\t\n80\t    /* If the rate is exactly full, process that block before padding */\n81\t    if (state->offset == TURBOSHAKE128_RATE) {\n82\t        crypto_core_keccak1600_permute_12(&state->state);\n83\t        state->offset = 0;\n84\t    }\n85\t\n86\t    /* Apply padding: domain byte at current position, 0x80 at last byte */\n87\t    if (state->offset == TURBOSHAKE128_RATE - 1) {\n88\t        /* Special case: padding fits in one byte */\n89\t        pad = (unsigned char) (state->domain ^ 0x80);\n90\t        crypto_core_keccak1600_xor_bytes(&state->state, &pad, state->offset, 1);\n91\t    } else {\n92\t        /* Normal case: domain and 0x80 at different positions */\n93\t        crypto_core_keccak1600_xor_bytes(&state->state, &state->domain, state->offset, 1);\n94\t        pad = 0x80;\n95\t        crypto_core_keccak1600_xor_bytes(&state->state, &pad, TURBOSHAKE128_RATE - 1, 1);\n96\t    }\n97\t\n98\t    /* Final permutation (12 rounds for TurboSHAKE) */\n99\t    crypto_core_keccak1600_permute_12(&state->state);\n100\t\n101\t    state->offset = 0;\n102\t    state->phase  = TURBOSHAKE128_PHASE_SQUEE