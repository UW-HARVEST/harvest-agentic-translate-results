 1.01*2^25,1.01*2^24,1.01*2^25,1.01*2^24,etc.\n339\t */\n340\t\n341\t/*\n342\t Notes on implementation strategy:\n343\t *\n344\t Using schoolbook multiplication.\n345\t Karatsuba would save a little in some cost models.\n346\t *\n347\t Most multiplications by 2 and 19 are 32-bit precomputations;\n348\t cheaper than 64-bit postcomputations.\n349\t *\n350\t There is one remaining multiplication by 19 in the carry chain;\n351\t one *19 precomputation can be merged into this,\n352\t but the resulting data flow is considerably less clean.\n353\t *\n354\t There are 12 carries below.\n355\t 10 of them are 2-way parallelizable and vectorizable.\n356\t Can get away with 11 carries, but then data flow is much deeper.\n357\t *\n358\t With tighter constraints on inputs can squeeze carries into int32.\n359\t */\n360\t\n361\tstatic void\n362\tfe25519_mul(fe25519 h, const fe25519 f, const fe25519 g)\n363\t{\n364\t    int32_t f0 = f[0];\n365\t    int32_t f1 = f[1];\n366\t    int32_t f2 = f[2];\n367\t    int32_t f3 = f[3];\n368\t    int32_t f4 = f[4];\n369\t    int32_t f5 = f[5];\n370\t    int32_t f6 = f[6];\n371\t    int32_t f7 = f[7];\n372\t    int32_t f8 = f[8];\n373\t    int32_t f9 = f[9];\n374\t\n375\t    int32_t g0 = g[0];\n376\t    int32_t g1 = g[1];\n377\t    int32_t g2 = g[2];\n378\t    int32_t g3 = g[3];\n379\t    int32_t g4 = g[4];\n380\t    int32_t g5 = g[5];\n381\t    int32_t g6 = g[6];\n382\t    int32_t g7 = g[7];\n383\t    int32_t g8 = g[8];\n384\t    int32_t g9 = g[9];\n385\t\n386\t    int32_t g1_19 = 19 * g1; /* 1.959375*2^29 */\n387\t    int32_t g2_19 = 19 * g2; /* 1.959375*2^30; still ok */\n388\t    int32_t g3_19 = 19 * g3;\n389\t    int32_t g4_19 = 19 * g4;\n390\t    int32_t g5_19 = 19 * g5;\n391\t    int32_t g6_19 = 19 * g6;\n392\t    int32_t g7_19 = 19 * g7;\n393\t    int32_t g8_19 = 19 * g8;\n394\t    int32_t g9_19 = 19 * g9;\n395\t    int32_t f1_2  = 2 * f1;\n396\t    int32_t f3_2  = 2 * f3;\n397\t    int32_t f5_2  = 2 * f5;\n398\t    int32_t f7_2  = 2 * f7;