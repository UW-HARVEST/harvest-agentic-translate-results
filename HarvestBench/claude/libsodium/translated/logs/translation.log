r9  = r3 ^ r4;\n701\t    const uint32_t r10 = r5 ^ r6;\n702\t    const uint32_t r11 = r2 ^ r9;\n703\t    const uint32_t r12 = a3 ^ r0;\n704\t    const uint32_t r13 = r7 ^ r8;\n705\t    const uint32_t r14 = r12 ^ r13;\n706\t    planes[0]          = r10 ^ r14;\n707\t    const uint32_t r15 = a6 ^ a10;\n708\t    const uint32_t r16 = r15 ^ r2;\n709\t    planes[1]          = ~(r10 ^ r16);\n710\t    planes[2]          = ~(a2 ^ r2);\n711\t    const uint32_t r17 = a12 ^ a13;\n712\t    const uint32_t r18 = a15 ^ r17;\n713\t    planes[3]          = r18 ^ r11;\n714\t    const uint32_t r19 = a1 ^ a14;\n715\t    const uint32_t r20 = a17 ^ r3;\n716\t    const uint32_t r21 = r7 ^ r19;\n717\t    const uint32_t r22 = r5 ^ r20;\n718\t    planes[4]          = r21 ^ r22;\n719\t    const uint32_t r23 = a9 ^ a12;\n720\t    planes[5]          = r8 ^ r23;\n721\t    planes[6]          = ~(r1 ^ r4);\n722\t    planes[7]          = ~(a16 ^ r11);\n723\t}\n724\t\n725\tstatic void\n726\tsrm1r_mix_columns(uint32_t planes[8])\n727\t{\n728\t    const uint32_t adj0  = srm1r_ror16(planes[0], 4);\n729\t    const uint32_t adj1  = srm1r_ror16(planes[1], 4);\n730\t    const uint32_t adj2  = srm1r_ror16(planes[2], 4);\n731\t    const uint32_t adj3  = srm1r_ror16(planes[3], 4);\n732\t    const uint32_t adj4  = srm1r_ror16(planes[4], 4);\n733\t    const uint32_t adj5  = srm1r_ror16(planes[5], 4);\n734\t    const uint32_t adj6  = srm1r_ror16(planes[6], 4);\n735\t    const uint32_t adj7  = srm1r_ror16(planes[7], 4);\n736\t    const uint32_t pair0 = planes[0] ^ adj0;\n737\t    const uint32_t pair1 = planes[1] ^ adj1;\n738\t    const uint32_t pair2 = planes[2] ^ adj2;\n739\t    const uint32_t pair3 = planes[3] ^ adj3;\n740\t    const uint32_t pair4 = planes[4] ^ adj4;\n741\t    const uint32_t pair5 = planes[5] ^ adj5;\n742\t    const uint32_t pair6 = planes[6] ^ adj6;\n743\t    const uint32_t pair7 = planes[7] ^ adj7;\n744\t    const uint32_t opp0  = srm1r_ror16(pair0, 8);\n745\t    const uint32_t opp1  = srm1r_r