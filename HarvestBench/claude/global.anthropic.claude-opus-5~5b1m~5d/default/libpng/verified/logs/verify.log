t         return;\n2085\t      }\n2086\t   }\n2087\t#endif\n2088\t\n2089\t   /* If we get here, we've just written the last row, so we need\n2090\t      to flush the compressor */\n2091\t   png_compress_IDAT(png_ptr, NULL, 0, Z_FINISH);\n2092\t}\n2093\t\n2094\t#ifdef PNG_WRITE_INTERLACING_SUPPORTED\n2095\t/* Pick out the correct pixels for the interlace pass.\n2096\t * The basic idea here is to go through the row with a source\n2097\t * pointer and a destination pointer (sp and dp), and copy the\n2098\t * correct pixels for the pass.  As the row gets compacted,\n2099\t * sp will always be >= dp, so we should never overwrite anything.\n2100\t * See the default: case for the easiest code to understand.\n2101\t */\n2102\tvoid /* PRIVATE */\n2103\tpng_do_write_interlace(png_row_infop row_info, png_bytep row, int pass)\n2104\t{\n2105\t   png_debug(1, \"in png_do_write_interlace\");\n2106\t\n2107\t   /* We don't have to do anything on the last pass (6) */\n2108\t   if (pass < 6)\n2109\t   {\n2110\t      /* Each pixel depth is handled separately */\n2111\t      switch (row_info->pixel_depth)\n2112\t      {\n2113\t         case 1:\n2114\t         {\n2115\t            png_bytep sp;\n2116\t            png_bytep dp;\n2117\t            unsigned int shift;\n2118\t            int d;\n2119\t            int value;\n2120\t            png_uint_32 i;\n2121\t            png_uint_32 row_width = row_info->width;\n2122\t\n2123\t            dp = row;\n2124\t            d = 0;\n2125\t            shift = 7;\n2126\t\n2127\t            for (i = png_pass_start[pass]; i < row_width;\n2128\t               i += png_pass_inc[pass])\n2129\t            {\n2130\t               sp = row + (size_t)(i >> 3);\n2131\t               value = (int)(*sp >> (7 - (int)(i & 0x07))) & 0x01;\n2132\t               d |= (value << shift);\n2133\t\n2134\t               if (shift == 0)\n2135\t               {\n2136\t                  shift = 7;\n2137\t                  *dp++ = (png_byte)d;\n2138\t                  d = 0