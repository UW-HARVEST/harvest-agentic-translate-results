{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0116LnjtAoCXSXda7DoZpQka","type":"tool_result","content":"1\t//! Public libpng types, mirrored from `c_src/include/png.h` (and the handful of\n2\t//! private ones that appear in exported prototypes, from `pngpriv.h`).\n3\t//!\n4\t//! The tests are *external consumers*: they never link the Rust crate, they\n5\t//! `dlopen` both shared objects.  Therefore the types are redeclared here.\n6\t#![allow(non_camel_case_types, non_snake_case, non_upper_case_globals, dead_code)]\n7\t\n8\tpub use core::ffi::{c_char, c_double, c_int, c_long, c_uint, c_ulong, c_void};\n9\t\n10\tpub type png_byte = u8;\n11\tpub type png_int_16 = i16;\n12\tpub type png_uint_16 = u16;\n13\tpub type png_int_32 = i32;\n14\tpub type png_uint_32 = u32;\n15\tpub type png_size_t = usize;\n16\tpub type png_alloc_size_t = usize;\n17\tpub type png_fixed_point = i32;\n18\t\n19\tpub type png_voidp = *mut c_void;\n20\tpub type png_const_voidp = *const c_void;\n21\tpub type png_bytep = *mut png_byte;\n22\tpub type png_const_bytep = *const png_byte;\n23\tpub type png_uint_32p = *mut png_uint_32;\n24\tpub type png_const_uint_32p = *const png_uint_32;\n25\tpub type png_int_32p = *mut png_int_32;\n26\tpub type png_uint_16p = *mut png_uint_16;\n27\tpub type png_const_uint_16p = *const png_uint_16;\n28\tpub type png_charp = *mut c_char;\n29\tpub type png_const_charp = *const c_char;\n30\tpub type png_fixed_point_p = *mut png_fixed_point;\n31\tpub type png_const_fixed_point_p = *const png_fixed_point;\n32\tpub type png_doublep = *mut c_double;\n33\tpub type png_const_doublep = *const c_double;\n34\tpub type png_bytepp = *mut png_bytep;\n35\tpub type png_uint_16pp = *mut png_uint_16p;\n36\tpub type png_charpp = *mut png_charp;\n37\tpub type png_const_charpp = *mut png_const_charp;\n38\tpub type png_FILE_p = *mut c_void;\n39\t\n40\tpub type uInt = c_uint;\n41\tpub type uLong = c_ulong;\n42\tpub type voidpf = *mut c_void;\n43\tpub type time_t = i64;\n44\t\n45\t#[repr(C)]\n46\tpub struct tm {\n47\t    pub tm_sec: c_int,\n48\t    pub tm_min: c_int,\n49\t    pub tm_hour: c_int,\n50\t    pub tm_mday: c_int,\n51\t    pub tm_mon: c_int,\n52\t    pub tm_year: c_int,\n53\t    pub tm_wday: c_int,\n54\t    pub tm_yday: c_int,\n55\t    pub tm_isdst: c_int,\n56\t    pub tm_gmtoff: c_long,\n57\t    pub tm_zone: *const c_char,\n58\t}\n59\t\n60\t#[repr(C)]\n61\t#[derive(Copy, Clone, Default, PartialEq, Eq, Debug)]\n62\tpub struct png_color {\n63\t    pub red: png_byte,\n64\t    pub green: png_byte,\n65\t    pub blue: png_byte,\n66\t}\n67\tpub type png_colorp = *mut png_color;\n68\tpub type png_const_colorp = *const png_color;\n69\t\n70\t#[repr(C)]\n71\t#[derive(Copy, Clone, Default, PartialEq, Eq, Debug)]\n72\tpub struct png_color_16 {\n73\t    pub index: png_byte,\n74\t    pub red: png_uint_16,\n75\t    pub green: png_uint_16,\n76\t    pub blue: png_uint_16,\n77\t    pub gray: png_uint_16,\n78\t}\n79\tpub type png_color_16p = *mut png_color_16;\n80\tpub type png_const_color_16p = *const png_color_16;\n81\t\n82\t#[repr(C)]\n83\t#[derive(Copy, Clone, Default, PartialEq, Eq, Debug)]\n84\tpub struct png_color_8 {\n85\t    pub red: png_byte,\n86\t    pub green: png_byte,\n87\t    pub blue: png_byte,\n88\t    pub gray: png_byte,\n89\t    pub alpha: png_byte,\n90\t}\n91\tpub type png_color_8p = *mut png_color_8;\n92\tpub type png_const_color_8p = *const png_color_8;\n93\t\n94\t#[repr(C)]\n95\t#[derive(Copy, Clone, Default, PartialEq, Eq, Debug)]\n96\tpub struct png_sPLT_entry {\n97\t    pub red: png_uint_16,\n98\t    pub green: png_uint_16,\n99\t    pub blue: png_uint_16,\n100\t    pub alpha: png_uint_16,\n101\t    pub frequency: png_uint_16,\n102\t}\n103\tpub type png_sPLT_entryp = *mut png_sPLT_entry;\n104\tpub type png_const_sPLT_entryp = *const png_sPLT_entry;\n105\t\n106\t#[repr(C)]\n107\t#[derive(Copy, Clone, Debug)]\n108\tpub struct png_sPLT_t {\n109\t    pub name: png_charp,\n110\t    pub depth: png_byte,\n111\t    pu