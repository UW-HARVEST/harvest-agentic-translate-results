{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01V4jA9rGnHpb9HyhC8ZdY1u","type":"tool_result","content":"1\t//! Differential-test harness.\n2\t//!\n3\t//! Both the reference C `libpng.so` and the translated Rust `liblibpng.so` are\n4\t//! `dlopen`ed and driven through *identical* function-pointer types, so every\n5\t//! call in every test goes through the real exported ABI of both libraries.\n6\t//! Nothing is ever called directly on the Rust crate.\n7\t#![allow(non_camel_case_types, non_snake_case, dead_code, unused_imports)]\n8\t\n9\tpub mod api;\n10\tpub mod types;\n11\t\n12\tpub use api::Api;\n13\tpub use types::*;\n14\t\n15\tuse std::cell::RefCell;\n16\tuse std::ffi::{CStr, CString};\n17\tuse std::panic::{catch_unwind, AssertUnwindSafe};\n18\tuse std::sync::OnceLock;\n19\t\n20\t// ---------------------------------------------------------------------------\n21\t// Library handles\n22\t// ---------------------------------------------------------------------------\n23\t\n24\tfn root() -> std::path::PathBuf {\n25\t    // CARGO_MANIFEST_DIR == <work>/translation\n26\t    std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n27\t        .parent()\n28\t        .unwrap()\n29\t        .to_path_buf()\n30\t}\n31\t\n32\tstatic C_LIB: OnceLock<Api> = OnceLock::new();\n33\tstatic RS_LIB: OnceLock<Api> = OnceLock::new();\n34\t\n35\t/// The reference `CMakeLists.txt` links only zlib, so the C `libpng.so` has an\n36\t/// unresolved `floor`/`pow` from libm.  Make libm globally visible first.\n37\tfn preload(names: &[&str]) {\n38\t    use libloading::os::unix::{Library as UnixLib, RTLD_GLOBAL, RTLD_NOW};\n39\t    for n in names {\n40\t        if let Ok(l) = unsafe { UnixLib::open(Some(*n), RTLD_NOW | RTLD_GLOBAL) } {\n41\t            std::mem::forget(l);\n42\t            return;\n43\t        }\n44\t    }\n45\t    panic!(\"cannot preload any of {:?}\", names);\n46\t}\n47\t\n48\tpub fn c_api() -> &'static Api {\n49\t    C_LIB.get_or_init(|| {\n50\t        preload(&[\"libm.so.6\", \"libm.so\"]);\n51\t        preload(&[\"libz.so.1\", \"libz.so\"]);\n52\t        let p = root().join(\"c_src/build/libpng.so\");\n53\t        assert!(p.exists(), \"reference C library not built: {}\", p.display());\n54\t        Api::load(p.to_str().unwrap(), \"C\")\n55\t    })\n56\t}\n57\t\n58\tpub fn rs_api() -> &'static Api {\n59\t    RS_LIB.get_or_init(|| {\n60\t        let mut p = root().join(\"translation/target/release/liblibpng.so\");\n61\t        if !p.exists() {\n62\t            p = root().join(\"translation/target/debug/liblibpng.so\");\n63\t        }\n64\t        assert!(p.exists(), \"rust cdylib not built: {}\", p.display());\n65\t        Api::load(p.to_str().unwrap(), \"RS\")\n66\t    })\n67\t}\n68\t\n69\t/// Both implementations, in a fixed order, for `for (name, api) in both()`.\n70\tpub fn both() -> [&'static Api; 2] {\n71\t    [c_api(), rs_api()]\n72\t}\n73\t\n74\t// ---------------------------------------------------------------------------\n75\t// Diagnostics capture\n76\t//\n77\t// `png_error` never returns in C: the error callback is expected to\n78\t// `longjmp`.  We cannot `setjmp` from Rust, so instead the callback unwinds\n79\t// with a Rust panic.  All of libpng's exported entry points are declared\n80\t// `extern \"C-unwind\"` (in both libraries: the C one is compiled by gcc which\n81\t// emits unwind tables by default), so the panic propagates back to the\n82\t// `catch_unwind` in `Session::run`.\n83\t// ---------------------------------------------------------------------------\n84\t\n85\t#[derive(Default, Debug, Clone, PartialEq, Eq)]\n86\tpub struct Diag {\n87\t    pub warnings: Vec<String>,\n88\t    pub errors: Vec<String>,\n89\t}\n90\t\n91\tthread_local! {\n92\t    static DIAG: RefCell<Diag> = RefCell::new(Diag::default());\n93\t    static HOOK_SET: RefCell<bool> = const { RefCell::new(false) };\n94\t}\n95\t\n96\tstruct PngLongjmp;\n97\t\n98\tfn install_quiet_hook() {\n99\t    HOOK_SET.with(|h| {\n100\t        if !*h.borrow() {\n101\t            *h.borrow_mut() = true;\n102\t        }\n103\t    });\n104\t    static ONCE: OnceLock<()> = OnceLock::new();\n105\t    ONCE.get_or_init(|| {\n106\t        let prev = std::panic::take_hook();\n107\t        std::panic::set_hook(Box::new(move |info| {\n108\t            // Suppress the noise from the expected png_error unwinds only.\n109\t            if info.payload().downcast_ref::<PngLongjmp>().is_some() {\n110\t                return;\n111\t            }\n112\t            prev(info);\n113\t        }));\n114\t    });\n115\t}\n116\t\n117\tpub unsafe extern \"C-unwind\" fn cb_error(_png: png_structp, msg: png_const_charp) {\n118\t    let m = if msg.is_null() {\n119\t        String::from(\"<null>\")\n120\t    } else {\n121\t        CStr::from_ptr(msg).to_string_lossy().into_owned()\n122\t    };\n123\t    DIAG.with(|d| d.borrow_mut().errors.push(m));\n124\t    std::panic::panic_any(PngLongjmp);\n125\t}\n126\t\n127\tpub unsafe extern \"C-unwind\" fn cb_warning(_png: png_structp, msg: png_const_charp) {\n128\t    let m = if msg.is_null() {\n129\t        String::from(\"<null>\")\n130\t    } else {\n131\t        CStr::from_ptr(msg).to_string_lossy().into_owned()\n132\t    };\n133\t    DIAG.with(|d| d.borrow_mut().warnings.push(m));\n134\t}\n135\t\n136\tpub fn diag_reset() {\n137\t    DIAG.with(|d| *d.borrow_mut() = Diag::default());\n138\t}\n139\t\n140\tpub fn diag_take() -> Diag {\n141\t    DIAG.with(|d| std::mem::take(&mut *d.borrow_mut()))\n142\t}\n143\t\n144\t/// Run `f`, catching the panic raised by [`cb_error`].  Returns `None` when\n145\t/// libpng raised an error.\n146\tpub fn guard<T>(f: impl FnOnce() -> T) -> Option<T> {\n147\t    install_quiet_hook();\n148\t    match catch_unwind(AssertUnwindSafe(f)) {\n149\t        Ok(v) => Some(v),\n150\t        Err(e) => {\n151\t            if e.downcast_ref::<PngLongjmp>().is_some() {\n152\t                None\n153\t            } else {\n154\t                std::panic::resume_unwind(e)\n155\t            }\n156\t        }\n157\t    }\n158\t}\n159\t\n160\t// ---------------------------------------------------------------------------\n161\t// Memory IO\n162\t// ---------------------------------------------------------------------------\n163\t\n164\t#[repr(C)]\n165\tpub struct WriteSink {\n166\t    pub buf: Vec<u8>,\n167\t    pub flushes: u32,\n168\t}\n169\t\n170\tpub unsafe extern \"C-unwind\" fn cb_write(png: png_structp, data: png_bytep, len: usize) {\n171\t    let api = current_api();\n172\t    let p = (api.png_get_io_ptr)(png) as *mut WriteSink;\n173\t    assert!(!p.is_null(), \"no io ptr in write callback\");\n174\t    if len > 0 {\n175\t        (*p).buf\n176\t            .extend_from_slice(std::slice::from_raw_parts(data, len));\n177\t    }\n178\t}\n179\t\n180\tpub unsafe extern \"C-unwind\" fn cb_flush(png: png_structp) {\n181\t    let api = current_api();\n182\t    let p = (api.png_get_io_ptr)(png) as *mut WriteSink;\n183\t    if !p.is_null() {\n184\t        (*p).flushes += 1;\n185\t    }\n186\t}\n187\t\n188\t#[repr(C)]\n189\tpub struct ReadSource {\n190\t    pub data: Vec<u8>,\n191\t    pub pos: usize,\n192\t}\n193\t\n194\tpub unsafe extern \"C-unwind\" fn cb_read(png: png_structp, data: png_bytep, len: usize) {\n195\t    let api = current_api();\n196\t    let p = (api.png_get_io_ptr)(png) as *mut ReadSource;\n197\t    assert!(!p.is_null(), \"no io ptr in read callback\");\n198\t    let src = &mut *p;\n199\t    if src.pos + len > src.data.len() {\n200\t        // Mirror png_default_read_data's behaviour on a short read.\n201\t        let m = CString::new(\"Read Error\").unwrap();\n202\t        (api.png_error)(png, m.as_ptr());\n203\t    }\n204\t    if len > 0 {\n205\t        std::ptr::copy_nonoverlapping(src.data.as_ptr().add(src.pos), data, len);\n206\t    }\n207\t    src.pos += len;\n208\t}\n209\t\n210\t// The IO/error callbacks need to know *which* library they were called from in\n211\t// order to call back into it (png_get_io_ptr / png_error).  Tests only ever\n212\t// drive one library at a time, so a thread-local \"current\" pointer suffices.\n213\tthread_local! {\n214\t    static CUR: RefCell<*const Api> = const { RefCell::new(std::ptr::null()) };\n215\t}\n216\t\n217\tpub fn set_current_api(a: &'static Api) {\n218\t    CUR.with(|c| *c.borrow_mut() = a as *const Api);\n219\t}\n220\t\n221\tpub fn current_api() -> &'static Api {\n222\t    CUR.with(|c| {\n223\t        let p = *c.borrow();\n224\t        assert!(!p.is_null(), \"current api not set\");\n225\t        unsafe { &*p }\n226\t    })\n227\t}\n228\t\n229\t// ---------------------------------------------------------------------------\n230\t// Session helpers\n231\t// ---------------------------------------------------------------------------\n232\t\n233\t/// A read session: png_struct + info_struct + a memory source.\n234\tpub struct ReadSess {\n235\t    pub api: &'static Api,\n236\t    pub png: png_structp,\n237\t    pub info: png_infop,\n238\t    pub end: png_infop,\n239\t    pub src: Box<ReadSource>,\n240\t}\n241\t\n242\timpl ReadSess {\n243\t    pub unsafe fn new(api: &'static Api, data: &[u8]) -> ReadSess {\n244\t        set_current_api(api);\n245\t        let v = ver();\n246\t        let png = (api.png_create_read_struct)(\n247\t            v.as_ptr(),\n248\t            std::ptr::null_mut(),\n249\t            Some(cb_error),\n250\t            Some(cb_warning),\n251\t        );\n252\t        assert!(!png.is_null(), \"{}: create_read_struct\", api.name);\n253\t        let info = (api.png_create_info_struct)(png);\n254\t        assert!(!info.is_null());\n255\t        let end = (api.png_create_info_struct)(png);\n256\t        assert!(!end.is_null());\n257\t        let mut src = Box::new(ReadSource {\n258\t            data: data.to_vec(),\n259\t            pos: 0,\n260\t        });\n261\t        (api.png_set_read_fn)(\n262\t            png,\n263\t            &mut *src as *mut ReadSource as png_voidp,\n264\t            Some(cb_read),\n265\t        );\n266\t        ReadSess {\n267\t            api,\n268\t            png,\n269\t            info,\n270\t            end,\n271\t            src,\n272\t        }\n273\t    }\n274\t}\n275\t\n276\timpl Drop for ReadSess {\n277\t    fn drop(&mut self) {\n278\t        unsafe {\n279\t            set_current_api(self.api);\n280\t            let mut p = self.png;\n281\t            let mut i = self.info;\n282\t            let mut e = self.end;\n283\t            if !p.is_null() {\n284\t                (self.api.png_destroy_read_struct)(&mut p, &mut i, &mut e);\n285\t            }\n286\t        }\n287\t    }\n288\t}\n289\t\n290\t/// A write session: png_struct + info_struct + a memory sink.\n291\tpub struct WriteSess {\n292\t    pub api: &'static Api,\n293\t    pub png: png_structp,\n294\t    pub info: png_infop,\n295\t    pub sink: Box<WriteSink>,\n296\t}\n297\t\n298\timpl WriteSess {\n299\t    pub unsafe fn new(api: &'static Api) -> WriteSess {\n300\t        set_current_api(api);\n301\t        let v = ver();\n302\t        let png = (api.png_create_write_struct)(\n303\t            v.as_ptr(),\n304\t            std::ptr::null_mut(),\n305\t            Some(cb_error),\n306\t            Some(cb_warning),\n307\t        );\n308\t        assert!(!png.is_null(), \"{}: create_write_struct\", api.name);\n309\t        let info = (api.png_create_info_struct)(png);\n310\t        assert!(!info.is_null());\n311\t        let mut sink = Box::new(WriteSink {\n312\t            buf: Vec::new(),\n313\t            flushes: 0,\n314\t        });\n315\t        (api.png_set_write_fn)(\n316\t            png,\n317\t            &mut *sink as *mut WriteSink as png_voidp,\n318\t            Some(cb_write),\n319\t            Some(cb_flush),\n320\t        );\n321\t        WriteSess {\n322\t            api,\n323\t            png,\n324\t            info,\n325\t            sink,\n326\t        }\n327\t    }\n328\t}\n329\t\n330\timpl Drop for WriteSess {\n331\t    fn drop(&mut self) {\n332\t        unsafe {\n333\t            set_current_api(self.api);\n334\t            let mut p = self.png;\n335\t            let mut i = self.info;\n336\t            if !p.is_null() {\n337\t                (self.api.png_destroy_write_struct)(&mut p, &mut i);\n338\t            }\n339\t        }\n340\t    }\n341\t}\n342\t\n343\t/// PNG_ROWBYTES\n344\tpub fn rowbytes(pixel_depth: u32, width: u32) -> usize {\n345\t    if pixel_depth >= 8 {\n346\t        (width as usize) * ((pixel_depth as usize) >> 3)\n347\t    } else {\n348\t        (((width as usize) * (pixel_depth as usize)) + 7) >> 3\n349\t    }\n350\t}\n351\t\n352\tpub const PNG_PASS_INC: [u32; 7] = [8, 8, 4, 4, 2, 2, 1];\n353\tpub const PNG_PASS_ROW_INC: [u32; 7] = [8, 8, 8, 4, 4, 2, 2];\n354\tpub const PNG_PASS_START_ROW: [u32; 7] = [0, 0, 4, 0, 2, 0, 1];\n355\tpub const PNG_PASS_START_COL: [u32; 7] = [0, 4, 0, 2, 0, 1, 0];\n356\t\n357\tpub fn channels_of(color_type: c_int) -> u32 {\n358\t    match color_type {\n359\t        0 => 1,\n360\t        2 => 3,\n361\t        3 => 1,\n362\t        4 => 2,\n363\t        6 => 4,\n364\t        _ => 1,\n365\t    }\n366\t}\n367\t\n368\t/// The (color_type, bit_depth) pairs the PNG spec (and png_check_IHDR) allows.\n369\tpub fn legal_ihdr() -> Vec<(c_int, c_int)> {\n370\t    let mut v = Vec::new();\n371\t    for &d in &[1, 2, 4, 8, 16] {\n372\t        v.push((PNG_COLOR_TYPE_GRAY, d));\n373\t    }\n374\t    for &d in &[1, 2, 4, 8] {\n375\t        v.push((PNG_COLOR_TYPE_PALETTE, d));\n376\t    }\n377\t    for &d in &[8, 16] {\n378\t        v.push((PNG_COLOR_TYPE_RGB, d));\n379\t        v.push((PNG_COLOR_TYPE_GRAY_ALPHA, d));\n380\t        v.push((PNG_COLOR_TYPE_RGB_ALPHA, d));\n381\t    }\n382\t    v\n383\t}\n384\t\n385\t// ---------------------------------------------------------------------------\n386\t// Small conveniences\n387\t// ---------------------------------------------------------------------------\n388\t\n389\tpub fn cs(s: &str) -> CString {\n390\t    CString::new(s).unwrap()\n391\t}\n392\t\n393\tpub unsafe fn rs_str(p: png_const_charp) -> Option<String> {\n394\t    if p.is_null() {\n395\t        None\n396\t    } else {\n397\t        Some(CStr::from_ptr(p).to_string_lossy().into_owned())\n398\t    }\n399\t}\n400\t\n401\tpub fn ver() -> CString {\n402\t    cs(PNG_LIBPNG_VER_STRING)\n403\t}\n404\t\n405\t/// Deterministic xorshift PRNG so every test is reproducible.\n406\tpub struct Rng(pub u64);\n407\t\n408\timpl Rng {\n409\t    pub fn new(seed: u64) -> Rng {\n410\t        Rng(seed | 1)\n411\t    }\n412\t    pub fn next_u64(&mut self) -> u64 {\n413\t        let mut x = self.0;\n414\t        x ^= x << 13;\n415\t        x ^= x >> 7;\n416\t        x ^= x << 17;\n417\t        self.0 = x;\n418\t        x\n419\t    }\n420\t    pub fn u32(&mut self) -> u32 {\n421\t        (self.next_u64() >> 32) as u32\n422\t    }\n423\t    pub fn u8(&mut self) -> u8 {\n424\t        (self.next_u64() >> 40) as u8\n425\t    }\n426\t    pub fn below(&mut self, n: u32) -> u32 {\n427\t        if n == 0 {\n428\t            0\n429\t        } else {\n430\t            self.u32() % n\n431\t        }\n432\t    }\n433\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n434\t        // inclusive\n435\t        lo + (self.next_u64() % ((hi - lo + 1) as u64)) as i64\n436\t    }\n437\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n438\t        (0..n).map(|_| self.u8()).collect()\n439\t    }\n440\t    pub fn bool(&mut self) -> bool {\n441\t        self.next_u64() & 0x10 != 0\n442\t    }\n443\t}\n444\t\n445\tpub fn hex(b: &[u8]) -> String {\n446\t    b.iter().map(|x| format!(\"{:02x}\", x)).collect()\n447\t}\n448\t\n449\t/// Compare two byte buffers and report the first difference.\n450\tpub fn assert_bytes_eq(what: &str, c: &[u8], r: &[u8]) {\n451\t    if c == r {\n452\t        return;\n453\t    }\n454\t    let n = c.len().min(r.len());\n455\t    let mut first = n;\n456\t    for i in 0..n {\n457\t        if c[i] != r[i] {\n458\t            first = i;\n459\t            break;\n460\t        }\n461\t    }\n462\t    let lo = first.saturating_sub(8);\n463\t    let hi = (first + 24).min(n);\n464\t    panic!(\n465\t        \"{}: byte mismatch (C len {}, RS len {}) at offset {}\\n  C : {}\\n  RS: {}\",\n466\t        what,\n467\t        c.len(),\n468\t        r.len(),\n469\t        first,\n470\t        hex(&c[lo..hi.max(lo)]),\n471\t        hex(&r[lo..hi.max(lo)]),\n472\t    );\n473\t}\n474\t"}]},"parent_tool_use_id":"toolu_bdrk_01Q6dhGaVGZZaCU4yoFW14FN","session_id":"e3091878-9949-4689-ad83-c0c41e6641a2","uuid":"6b593d52-ce02-483d-9fc8-530bab223428","timestamp":"2026-08-31T13:45:47.656Z","subagent_type":"general-purpose","task_description":"Error tests: write + rutil paths"}
