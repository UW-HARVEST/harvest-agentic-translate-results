correction = png_gamma_threshold(file_gamma, screen_gamma);\n1406\t\n1407\t      else\n1408\t         /* Assume the output matches the input; a long time default behavior\n1409\t          * of libpng, although the standard has nothing to say about this.\n1410\t          */\n1411\t         screen_gamma = png_reciprocal(file_gamma);\n1412\t   }\n1413\t\n1414\t   else /* both unset, prevent corrections: */\n1415\t      file_gamma = screen_gamma = PNG_FP_1;\n1416\t\n1417\t   png_ptr->file_gamma = file_gamma;\n1418\t   png_ptr->screen_gamma = screen_gamma;\n1419\t   return gamma_correction;\n1420\t\n1421\t}\n1422\t#endif /* READ_GAMMA */\n1423\t\n1424\tvoid /* PRIVATE */\n1425\tpng_init_read_transformations(png_structrp png_ptr)\n1426\t{\n1427\t   png_debug(1, \"in png_init_read_transformations\");\n1428\t\n1429\t   /* This internal function is called from png_read_start_row in pngrutil.c\n1430\t    * and it is called before the 'rowbytes' calculation is done, so the code\n1431\t    * in here can change or update the transformations flags.\n1432\t    *\n1433\t    * First do updates that do not depend on the details of the PNG image data\n1434\t    * being processed.\n1435\t    */\n1436\t\n1437\t#ifdef PNG_READ_GAMMA_SUPPORTED\n1438\t   /* Prior to 1.5.4 these tests were performed from png_set_gamma, 1.5.4 adds\n1439\t    * png_set_alpha_mode and this is another source for a default file gamma so\n1440\t    * the test needs to be performed later - here.  In addition prior to 1.5.4\n1441\t    * the tests were repeated for the PALETTE color type here - this is no\n1442\t    * longer necessary (and doesn't seem to have been necessary before.)\n1443\t    *\n1444\t    * PNGv3: the new mandatory precedence/priority rules for colour space chunks\n1445\t    * are handled here (by calling the above function).\n1446\t    *\n1447\t    * Turn the gamma transformation on or off as appropriate.  Notice that\n1448\t    * PNG_GAMMA just refers to the file->screen correction.  Alpha composition\n1449\t    * may independently cause gamma correction because it needs linear data\n1450\t    * (e.g. if the file has a gAMA chunk but the screen gamma hasn't been\n1451\t    * specified.)  In any case this flag may get turned off in the code\n1452\t    * immediately below if the transform can be handled outside the row loop.\n1453\t    */\n1454\t   if (png_init_gamma_values(png_ptr) != 0)\n1455\t      png_ptr->transformations |= PNG_GAMMA;\n1456\t\n1457\t   else\n1458\t      png_ptr->transformations &= ~PNG_GAMMA;\n1459\t#endif\n1460\t\n1461\t   /* Certain transformations have the effect of preventing other\n1462\t    * transformations that happen afterward in png_do_read_transformations;\n1463\t    * resolve the interdependencies here.  From the code of\n1464\t    * png_do_read_transformations the order is:\n1465\t    *\n1466\t    *  1) PNG_EXPAND (including PNG_EXPAND_tRNS)\n1467\t    *  2) PNG_STRIP_ALPHA (if no compose)\n1468\t    *  3) PNG_RGB_TO_GRAY\n1469\t    *  4) PNG_GRAY_TO_RGB iff !PNG_BACKGROUND_IS_GRAY\n1470\t    *  5) PNG_COMPOSE\n1471\t    *  6) PNG_GAMMA\n1472\t    *  7) PNG_STRIP_ALPHA (if compose)\n1473\t    *  8) PNG_ENCODE_ALPHA\n1474\t    *  9) PNG_SCALE_16_TO_8\n1475\t    * 10) PNG_16_TO_8\n1476\t    * 11) PNG_QUANTIZE (converts to palette)\n1477\t    * 12) PNG_EXPAND_16\n1478\t    * 13) PNG_GRAY_TO_RGB iff PNG_BACKGROUND_IS_GRAY\n1479\t    * 14) PNG_INVERT_MONO\n1480\t    * 15) PNG_INVERT_ALPHA\n1481\t    * 16) PNG_SHIFT\n1482\t    * 17) PNG_PACK\n1483\t    * 18) PNG_BGR\n1484\t    * 19) PNG_PACKSWAP\n1485\t    * 20) PNG_FILLER (includes PNG_ADD_ALPHA)\n1486\t    * 21) PNG_SWAP_ALPHA\n1487\t    * 22) PNG_SWAP_BYTES\n1488\t    * 23) PNG_USER_TRANSFORM [must be last]\n1489\t    */\n1490\t#ifdef PNG_READ_STRIP_ALPHA_SUPPORTED\n1491\t   if ((png_ptr->transformations & PNG_STRIP_ALPHA) != 0 &&\n1492\t       (png_ptr->transformations & PNG_COMPOSE) == 0)\n1493\t   {\n1494\t      /* Stripping the alpha channel happens immediately after the 'expand'\n1495\t       * transformations, before all other transformation, so it cancels out\n1496\t       * the alpha handling.  It has the side effect negating the effect of\n1497\t       * PNG_EXPAND_tRNS too:\n1498\t       */\n1499\t      png_ptr->transformations &= ~(PNG_BACKGROUND_EXPAND | PNG_ENCODE_ALPHA |\n1500\t         PNG_EXPAND_tRNS);\n1501\t      png_ptr->flags &= ~PNG_FLAG_OPTIMIZE_ALPHA;\n1502\t\n1503\t      /* Kill the tRNS chunk itself too.  Prior to 1.5.4 this did not happen\n1504\t       * so transparency information would remain just so long as it wasn't\n1505\t       * expanded.  This produces unexpected API changes if the set of things\n1506\t       * that do PNG_EXPAND_tRNS changes (perfectly possible given the\n1507\t       * documentation - which says ask for what you want, accept what you\n1508\t       * get.)  This makes the behavior consistent from 1.5.4:\n1509\t       */\n1510\t      png_ptr->num_trans = 0;\n1511\t   }\n1512\t#endif /* STRIP_ALPHA supported, no COMPOSE */\n1513\t\n1514\t#ifdef PNG_READ_ALPHA_MODE_SUPPORTED\n1515\t   /* If the screen gamma is about 1.0 then the OPTIMIZE_ALPHA and ENCODE_ALPHA\n1516\t    * settings will have no effect.\n1517\t    */\n1518\t   if (png_gamma_significant(png_ptr->screen_gamma) == 0)\n1519\t   {\n1520\t      png_ptr->transformations &= ~PNG_ENCODE_ALPHA;\n1521\t      png_ptr->flags &= ~PNG_FLAG_OPTIMIZE_ALPHA;\n1522\t   }\n1523\t#endif\n1524\t\n1525\t#ifdef PNG_READ_RGB_TO_GRAY_SUPPORTED\n1526\t   /* Make sure the coefficients for the rgb to gray conversion are set\n1527\t    * appropriately.\n1528\t    */\n1529\t   if ((png_ptr->transformations & PNG_RGB_TO_GRAY) != 0)\n1530\t      png_set_rgb_coefficients(png_ptr);\n1531\t#endif\n1532\t\n1533\t#ifdef PNG_READ_GRAY_TO_RGB_SUPPORTED\n1534\t#if defined(PNG_READ_EXPAND_SUPPORTED) && defined(PNG_READ_BACKGROUND_SUPPORTED)\n1535\t   /* Detect gray background and attempt to enable optimization for\n1536\t    * gray --> RGB case.\n1537\t    *\n1538\t    * Note:  if PNG_BACKGROUND_EXPAND is set and color_type is either RGB or\n1539\t    * RGB_ALPHA (in which case need_expand is superfluous anyway), the\n1540\t    * background color might actually be gray yet not be flagged as such.\n1541\t    * This is not a problem for the current code, which uses\n1542\t    * PNG_BACKGROUND_IS_GRAY only to decide when to do the\n1543\t    * png_do_gray_to_rgb() transformation.\n1544\t    *\n1545\t    * TODO: this code needs to be revised to avoid the complexity and\n1546\t    * interdependencies.  The color type of the background should be recorded in\n1547\t    * png_set_background, along with the bit depth, then the code has a record\n1548\t    * of exactly what color space the background is currently in.\n1549\t    */\n1550\t   if ((png_ptr->transformations & PNG_BACKGROUND_EXPAND) != 0)\n1551\t   {\n1552\t      /* PNG_BACKGROUND_EXPAND: the background is in the file color space, so if\n1553\t       * the file was grayscale the background value is gray.\n1554\t       */\n1555\t      if ((png_ptr->color_type & PNG_COLOR_MASK_COLOR) == 0)\n1556\t         png_ptr->mode |= PNG_BACKGROUND_IS_GRAY;\n1557\t   }\n1558\t\n1559\t   else if ((png_ptr->transformations & PNG_COMPOSE) != 0)\n1560\t   {\n1561\t      /* PNG_COMPOSE: png_set_background was called with need_expand false,\n1562\t       * so the color is in the color space of the output or png_set_alpha_mode\n1563\t       * was called and the color is black.  Ignore RGB_TO_GRAY because that\n1564\t       * happens before GRAY_TO_RGB.\n1565\t       */\n1566\t      if ((png_ptr->transformations & PNG_GRAY_TO_RGB) != 0)\n1567\t      {\n1568\t         if (png_ptr->background.red == png_ptr->background.green &&\n1569\t             png_ptr->background.red == png_ptr->background.blue)\n1570\t         {\n1571\t            png_ptr->mode |= PNG_BACKGROUND_IS_GRAY;\n1572\t            png_ptr->background.gray = png_ptr->background.red;\n1573\t         }\n1574\t      }\n1575\t   }\n1576\t#endif /* READ_EXPAND && READ_BACKGROUND */\n1577\t#endif /* READ_GRAY_TO_RGB */\n1578\t\n1579\t   /* For indexed PNG data (PNG_COLOR_TYPE_PALETTE) many of the transformations\n1580\t    * can be performed directly on the palette, and some (such as rgb to gray)\n1581\t    * can be optimized inside the palette.  This is particularly true of the\n1582\t    * composite (background and alpha) stuff, which can be pretty much all done\n1583\t    * in the palette even if the result is expanded to RGB or gray afterward.\n1584\t    *\n1585\t    * NOTE: this is Not Yet Implemented, the code behaves as in 1.5.1 and\n1586\t    * earlier and the palette stuff is actually handled on the first row.  This\n1587\t    * leads to the reported bug that the palette returned by png_get_PLTE is not\n1588\t    * updated.\n1589\t    */\n1590\t   if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n1591\t      png_init_palette_transformations(png_ptr);\n1592\t\n1593\t   else\n1594\t      png_init_rgb_transformations(png_ptr);\n1595\t\n1596\t#if defined(PNG_READ_BACKGROUND_SUPPORTED) && \\\n1597\t   defined(PNG_READ_EXPAND_16_SUPPORTED)\n1598\t   if ((png_ptr->transformations & PNG_EXPAND_16) != 0 &&\n1599\t       (png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1600\t       (png_ptr->transformations & PNG_BACKGROUND_EXPAND) == 0 &&\n1601\t       png_ptr->bit_depth != 16)\n1602\t   {\n1603\t      /* TODO: fix this.  Because the expand_16 operation is after the compose\n1604\t       * handling the background color must be 8, not 16, bits deep, but the\n1605\t       * application will supply a 16-bit value so reduce it here.\n1606\t       *\n1607\t       * The PNG_BACKGROUND_EXPAND code above does not expand to 16 bits at\n1608\t       * present, so that case is ok (until do_expand_16 is moved.)\n1609\t       *\n1610\t       * NOTE: this discards the low 16 bits of the user supplied background\n1611\t       * color, but until expand_16 works properly there is no choice!\n1612\t       */\n1613\t#     define CHOP(x) (x)=((png_uint_16)PNG_DIV257(x))\n1614\t      CHOP(png_ptr->background.red);\n1615\t      CHOP(png_ptr->background.green);\n1616\t      CHOP(png_ptr->background.blue);\n1617\t      CHOP(png_ptr->background.gray);\n1618\t#     undef CHOP\n1619\t   }\n1620\t#endif /* READ_BACKGROUND && READ_EXPAND_16 */\n1621\t\n1622\t#if defined(PNG_READ_BACKGROUND_SUPPORTED) && \\\n1623\t   (defined(PNG_READ_SCALE_16_TO_8_SUPPORTED) || \\\n1624\t   defined(PNG_READ_STRIP_16_TO_8_SUPPORTED))\n1625\t   if ((png_ptr->transformations & (PNG_16_TO_8|PNG_SCALE_16_TO_8)) != 0 &&\n1626\t       (png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1627\t       (png_ptr->transformations & PNG_BACKGROUND_EXPAND) == 0 &&\n1628\t       png_ptr->bit_depth == 16)\n1629\t   {\n1630\t      /* On the other hand, if a 16-bit file is to be reduced to 8-bits per\n1631\t       * component this will also happen after PNG_COMPOSE and so the background\n1632\t       * color must be pre-expanded here.\n1633\t       *\n1634\t       * TODO: fix this too.\n1635\t       */\n1636\t      png_ptr->background.red = (png_uint_16)(png_ptr->background.red * 257);\n1637\t      png_ptr->background.green =\n1638\t         (png_uint_16)(png_ptr->background.green * 257);\n1639\t      png_ptr->background.blue = (png_uint_16)(png_ptr->background.blue * 257);\n1640\t      png_ptr->background.gray = (png_uint_16)(png_ptr->background.gray * 257);\n1641\t   }\n1642\t#endif\n1643\t\n1644\t   /* NOTE: below 'PNG_READ_ALPHA_MODE_SUPPORTED' is presumed to also enable the\n1645\t    * background support (see the comments in scripts/pnglibconf.dfa), this\n1646\t    * allows pre-multiplication of the alpha channel to be implemented as\n1647\t    * compositing on black.  This is probably sub-optimal and has been done in\n1648\t    * 1.5.4 betas simply to enable external critique and testing (i.e. to\n1649\t    * implement the new API quickly, without lots of internal changes.)\n1650\t    */\n1651\t\n1652\t#ifdef PNG_READ_GAMMA_SUPPORTED\n1653\t#  ifdef PNG_READ_BACKGROUND_SUPPORTED\n1654\t      /* Includes ALPHA_MODE */\n1655\t      png_ptr->background_1 = png_ptr->background;\n1656\t#  endif\n1657\t\n1658\t   /* This needs to change - in the palette image case a whole set of tables are\n1659\t    * built when it would be quicker to just calculate the correct value for\n1660\t    * each palette entry directly.  Also, the test is too tricky - why check\n1661\t    * PNG_RGB_TO_GRAY if PNG_GAMMA is not set?  The answer seems to be that\n1662\t    * PNG_GAMMA is cancelled even if the gamma is known?  The test excludes the\n1663\t    * PNG_COMPOSE case, so apparently if there is no *overall* gamma correction\n1664\t    * the gamma tables will not be built even if composition is required on a\n1665\t    * gamma encoded value.\n1666\t    *\n1667\t    * In 1.5.4 this is addressed below by an additional check on the individual\n1668\t    * file gamma - if it is not 1.0 both RGB_TO_GRAY and COMPOSE need the\n1669\t    * tables.\n1670\t    */\n1671\t   if ((png_ptr->transformations & PNG_GAMMA) != 0 ||\n1672\t       ((png_ptr->transformations & PNG_RGB_TO_GRAY) != 0 &&\n1673\t        (png_gamma_significant(png_ptr->file_gamma) != 0 ||\n1674\t         png_gamma_significant(png_ptr->screen_gamma) != 0)) ||\n1675\t        ((png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1676\t         (png_gamma_significant(png_ptr->file_gamma) != 0 ||\n1677\t          png_gamma_significant(png_ptr->screen_gamma) != 0\n1678\t#  ifdef PNG_READ_BACKGROUND_SUPPORTED\n1679\t         || (png_ptr->background_gamma_type == PNG_BACKGROUND_GAMMA_UNIQUE &&\n1680\t           png_gamma_significant(png_ptr->background_gamma) != 0)\n1681\t#  endif\n1682\t        )) || ((png_ptr->transformations & PNG_ENCODE_ALPHA) != 0 &&\n1683\t       png_gamma_significant(png_ptr->screen_gamma) != 0))\n1684\t   {\n1685\t      png_build_gamma_table(png_ptr, png_ptr->bit_depth);\n1686\t\n1687\t#ifdef PNG_READ_BACKGROUND_SUPPORTED\n1688\t      if ((png_ptr->transformations & PNG_COMPOSE) != 0)\n1689\t      {\n1690\t         /* Issue a warning about this combination: because RGB_TO_GRAY is\n1691\t          * optimized to do the gamma transform if present yet do_background has\n1692\t          * to do the same thing if both options are set a\n1693\t          * double-gamma-correction happens.  This is true in all versions of\n1694\t          * libpng to date.\n1695\t          */\n1696\t         if ((png_ptr->transformations & PNG_RGB_TO_GRAY) != 0)\n1697\t            png_warning(png_ptr,\n1698\t                \"libpng does not support gamma+background+rgb_to_gray\");\n1699\t\n1700\t         if ((png_ptr->color_type == PNG_COLOR_TYPE_PALETTE) != 0)\n1701\t         {\n1702\t            /* We don't get to here unless there is a tRNS chunk with non-opaque\n1703\t             * entries - see the checking code at the start of this function.\n1704\t             */\n1705\t            png_color back, back_1;\n1706\t            png_colorp palette = png_ptr->palette;\n1707\t            int num_palette = png_ptr->num_palette;\n1708\t            int i;\n1709\t            if (png_ptr->background_gamma_type == PNG_BACKGROUND_GAMMA_FILE)\n1710\t            {\n1711\t\n1712\t               back.red = png_ptr->gamma_table[png_ptr->background.red];\n1713\t               back.green = png_ptr->gamma_table[png_ptr->background.green];\n1714\t               back.blue = png_ptr->gamma_table[png_ptr->background.blue];\n1715\t\n1716\t               back_1.red = png_ptr->gamma_to_1[png_ptr->background.red];\n1717\t               back_1.green = png_ptr->gamma_to_1[png_ptr->background.green];\n1718\t               back_1.blue = png_ptr->gamma_to_1[png_ptr->background.blue];\n1719\t            }\n1720\t            else\n1721\t            {\n1722\t               png_fixed_point g, gs;\n1723\t\n1724\t               switch (png_ptr->background_gamma_type)\n1725\t               {\n1726\t                  case PNG_BACKGROUND_GAMMA_SCREEN:\n1727\t                     g = (png_ptr->screen_gamma);\n1728\t                     gs = PNG_FP_1;\n1729\t                     break;\n1730\t\n1731\t                  case PNG_BACKGROUND_GAMMA_FILE:\n1732\t                     g = png_reciprocal(png_ptr->file_gamma);\n1733\t                     gs = png_reciprocal2(png_ptr->file_gamma,\n1734\t                         png_ptr->screen_gamma);\n1735\t                     break;\n1736\t\n1737\t                  case PNG_BACKGROUND_GAMMA_UNIQUE:\n1738\t                     g = png_reciprocal(png_ptr->background_gamma);\n1739\t                     gs = png_reciprocal2(png_ptr->background_gamma,\n1740\t                         png_ptr->screen_gamma);\n1741\t                     break;\n1742\t                  default:\n1743\t                     g = PNG_FP_1;    /* back_1 */\n1744\t                     gs = PNG_FP_1;   /* back */\n1745\t                     break;\n1746\t               }\n1747\t\n1748\t               if (png_gamma_significant(gs) != 0)\n1749\t               {\n1750\t                  back.red = png_gamma_8bit_correct(png_ptr->background.red,\n1751\t                      gs);\n1752\t                  back.green = png_gamma_8bit_correct(png_ptr->background.green,\n1753\t                      gs);\n1754\t                  back.blue = png_gamma_8bit_correct(png_ptr->background.blue,\n1755\t                      gs);\n1756\t               }\n1757\t\n1758\t               else\n1759\t               {\n1760\t                  back.red   = (png_byte)png_ptr->background.red;\n1761\t                  back.green = (png_byte)png_ptr->background.green;\n1762\t                  back.blue  = (png_byte)png_ptr->background.blue;\n1763\t               }\n1764\t\n1765\t               if (png_gamma_significant(g) != 0)\n1766\t               {\n1767\t                  back_1.red = png_gamma_8bit_correct(png_ptr->background.red,\n1768\t                      g);\n1769\t                  back_1.green = png_gamma_8bit_correct(\n1770\t                      png_ptr->background.green, g);\n1771\t                  back_1.blue = png_gamma_8bit_correct(png_ptr->background.blue,\n1772\t                      g);\n1773\t               }\n1774\t\n1775\t               else\n1776\t               {\n1777\t                  back_1.red   = (png_byte)png_ptr->background.red;\n1778\t                  back_1.green = (png_byte)png_ptr->background.green;\n1779\t                  back_1.blue  = (png_byte)png_ptr->background.blue;\n1780\t               }\n1781\t            }\n1782\t\n1783\t            for (i = 0; i < num_palette; i++)\n1784\t            {\n1785\t               if (i < (int)png_ptr->num_trans &&\n1786\t                   png_ptr->trans_alpha[i] != 0xff)\n1787\t               {\n1788\t                  if (png_ptr->trans_alpha[i] == 0)\n1789\t                  {\n1790\t                     palette[i] = back;\n1791\t                  }\n1792\t                  else /* if (png_ptr->trans_alpha[i] != 0xff) */\n1793\t                  {\n1794\t                     if ((png_ptr->flags & PNG_FLAG_OPTIMIZE_ALPHA) != 0)\n1795\t                     {\n1796\t                        /* Premultiply only:\n1797\t                         * component = round((component * alpha) / 255)\n1798\t                         */\n1799\t                        png_uint_32 component;\n1800\t\n1801\t                        component = png_ptr->gamma_to_1[palette[i].red];\n1802\t                        component =\n1803\t                            (component * png_ptr->trans_alpha[i] + 128) / 255;\n1804\t                        palette[i].red = png_ptr->gamma_from_1[component];\n1805\t\n1806\t                        component = png_ptr->gamma_to_1[palette[i].green];\n1807\t                        component =\n1808\t                            (component * png_ptr->trans_alpha[i] + 128) / 255;\n1809\t                        palette[i].green = png_ptr->gamma_from_1[component];\n1810\t\n1811\t                        component = png_ptr->gamma_to_1[palette[i].blue];\n1812\t                        component =\n1813\t                            (component * png_ptr->trans_alpha[i] + 128) / 255;\n1814\t                        palette[i].blue = png_ptr->gamma_from_1[component];\n1815\t                     }\n1816\t                     else\n1817\t                     {\n1818\t                        /* Composite with background color:\n1819\t                         * component =\n1820\t                         *    alpha * component + (1 - alpha) * background\n1821\t                         */\n1822\t                        png_byte v, w;\n1823\t\n1824\t                        v = png_ptr->gamma_to_1[palette[i].red];\n1825\t                        png_composite(w, v,\n1826\t                            png_ptr->trans_alpha[i], back_1.red);\n1827\t                        palette[i].red = png_ptr->gamma_from_1[w];\n1828\t\n1829\t                        v = png_ptr->gamma_to_1[palette[i].green];\n1830\t                        png_composite(w, v,\n1831\t                            png_ptr->trans_alpha[i], back_1.green);\n1832\t                        palette[i].green = png_ptr->gamma_from_1[w];\n1833\t\n1834\t                        v = png_ptr->gamma_to_1[palette[i].blue];\n1835\t                        png_composite(w, v,\n1836\t                            png_ptr->trans_alpha[i], back_1.blue);\n1837\t                        palette[i].blue = png_ptr->gamma_from_1[w];\n1838\t                     }\n1839\t                  }\n1840\t               }\n1841\t               else\n1842\t               {\n1843\t                  palette[i].red = png_ptr->gamma_table[palette[i].red];\n1844\t                  palette[i].green = png_ptr->gamma_table[palette[i].green];\n1845\t                  palette[i].blue = png_ptr->gamma_table[palette[i].blue];\n1846\t               }\n1847\t            }\n1848\t\n1849\t            /* Prevent the transformations being done again.\n1850\t             *\n1851\t             * NOTE: this is highly dubious; it removes the transformations in\n1852\t             * place.  This seems inconsistent with the general treatment of the\n1853\t             * transformations elsewhere.\n1854\t             */\n1855\t            png_ptr->transformations &= ~(PNG_COMPOSE | PNG_GAMMA);\n1856\t            png_ptr->flags &= ~PNG_FLAG_OPTIMIZE_ALPHA;\n1857\t         } /* color_type == PNG_COLOR_TYPE_PALETTE */\n1858\t\n1859\t         /* if (png_ptr->background_gamma_type!=PNG_BACKGROUND_GAMMA_UNKNOWN) */\n1860\t         else /* color_type != PNG_COLOR_TYPE_PALETTE */\n1861\t         {\n1862\t            int gs_sig, g_sig;\n1863\t            png_fixed_point g = PNG_FP_1;  /* Correction to linear */\n1864\t            png_fixed_point gs = PNG_FP_1; /* Correction to screen */\n1865\t\n1866\t            switch (png_ptr->background_gamma_type)\n1867\t            {\n1868\t               case PNG_BACKGROUND_GAMMA_SCREEN:\n1869\t                  g = png_ptr->screen_gamma;\n1870\t                  /* gs = PNG_FP_1; */\n1871\t                  break;\n1872\t\n1873\t               case PNG_BACKGROUND_GAMMA_FILE:\n1874\t                  g = png_reciprocal(png_ptr->file_gamma);\n1875\t                  gs = png_reciprocal2(png_ptr->file_gamma,\n1876\t                      png_ptr->screen_gamma);\n1877\t                  break;\n1878\t\n1879\t               case PNG_BACKGROUND_GAMMA_UNIQUE:\n1880\t                  g = png_reciprocal(png_ptr->background_gamma);\n1881\t                  gs = png_reciprocal2(png_ptr->background_gamma,\n1882\t                      png_ptr->screen_gamma);\n1883\t                  break;\n1884\t\n1885\t               default:\n1886\t                  png_error(png_ptr, \"invalid background gamma type\");\n1887\t            }\n1888\t\n1889\t            g_sig = png_gamma_significant(g);\n1890\t            gs_sig = png_gamma_significant(gs);\n1891\t\n1892\t            if (g_sig != 0)\n1893\t               png_ptr->background_1.gray = png_gamma_correct(png_ptr,\n1894\t                   png_ptr->background.gray, g);\n1895\t\n1896\t            if (gs_sig != 0)\n1897\t               png_ptr->background.gray = png_gamma_correct(png_ptr,\n1898\t                   png_ptr->background.gray, gs);\n1899\t\n1900\t            if ((png_ptr->background.red != png_ptr->background.green) ||\n1901\t                (png_ptr->background.red != png_ptr->background.blue) ||\n1902\t                (png_ptr->background.red != png_ptr->background.gray))\n1903\t            {\n1904\t               /* RGB or RGBA with color background */\n1905\t               if (g_sig != 0)\n1906\t               {\n1907\t                  png_ptr->background_1.red = png_gamma_correct(png_ptr,\n1908\t                      png_ptr->background.red, g);\n1909\t\n1910\t                  png_ptr->background_1.green = png_gamma_correct(png_ptr,\n1911\t                      png_ptr->background.green, g);\n1912\t\n1913\t                  png_ptr->background_1.blue = png_gamma_correct(png_ptr,\n1914\t                      png_ptr->background.blue, g);\n1915\t               }\n1916\t\n1917\t               if (gs_sig != 0)\n1918\t               {\n1919\t                  png_ptr->background.red = png_gamma_correct(png_ptr,\n1920\t                      png_ptr->background.red, gs);\n1921\t\n1922\t                  png_ptr->background.green = png_gamma_correct(png_ptr,\n1923\t                      png_ptr->background.green, gs);\n1924\t\n1925\t                  png_ptr->background.blue = png_gamma_correct(png_ptr,\n1926\t                      png_ptr->background.blue, gs);\n1927\t               }\n1928\t            }\n1929\t\n1930\t            else\n1931\t            {\n1932\t               /* GRAY, GRAY ALPHA, RGB, or RGBA with gray background */\n1933\t               png_ptr->background_1.red = png_ptr->background_1.green\n1934\t                   = png_ptr->background_1.blue = png_ptr->background_1.gray;\n1935\t\n1936\t               png_ptr->background.red = png_ptr->background.green\n1937\t                   = png_ptr->background.blue = png_ptr->background.gray;\n1938\t            }\n1939\t\n1940\t            /* The background is now in screen gamma: */\n1941\t            png_ptr->background_gamma_type = PNG_BACKGROUND_GAMMA_SCREEN;\n1942\t         } /* color_type != PNG_COLOR_TYPE_PALETTE */\n1943\t      }/* png_ptr->transformations & PNG_BACKGROUND */\n1944\t\n1945\t      else\n1946\t      /* Transformation does not include PNG_BACKGROUND */\n1947\t#endif /* READ_BACKGROUND */\n1948\t      if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE\n1949\t#ifdef PNG_READ_RGB_TO_GRAY_SUPPORTED\n1950\t         /* RGB_TO_GRAY needs to have non-gamma-corrected values! */\n1951\t         && ((png_ptr->transformations & PNG_EXPAND) == 0 ||\n1952\t         (png_ptr->transformations & PNG_RGB_TO_GRAY) == 0)\n1953\t#endif\n1954\t         )\n1955\t      {\n1956\t         png_colorp palette = png_ptr->palette;\n1957\t         int num_palette = png_ptr->num_palette;\n1958\t         int i;\n1959\t\n1960\t         /* NOTE: there are other transformations that should probably be in\n1961\t          * here too.\n1962\t          */\n1963\t         for (i = 0; i < num_palette; i++)\n1964\t         {\n1965\t            palette[i].red = png_ptr->gamma_table[palette[i].red];\n1966\t            palette[i].green = png_ptr->gamma_table[palette[i].green];\n1967\t            palette[i].blue = png_ptr->gamma_table[palette[i].blue];\n1968\t         }\n1969\t\n1970\t         /* Done the gamma correction. */\n1971\t         png_ptr->transformations &= ~PNG_GAMMA;\n1972\t      } /* color_type == PALETTE && !PNG_BACKGROUND transformation */\n1973\t   }\n1974\t#ifdef PNG_READ_BACKGROUND_SUPPORTED\n1975\t   else\n1976\t#endif\n1977\t#endif /* READ_GAMMA */\n1978\t\n1979\t#ifdef PNG_READ_BACKGROUND_SUPPORTED\n1980\t   /* No GAMMA transformation (see the hanging else 4 lines above) */\n1981\t   if ((png_ptr->transformations & PNG_COMPOSE) != 0 &&\n1982\t       (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE))\n1983\t   {\n1984\t      int i;\n1985\t      int istop = (int)png_ptr->num_trans;\n1986\t      png_color back;\n1987\t      png_colorp palette = png_ptr->palette;\n1988\t\n1989\t      back.red   = (png_byte)png_ptr->background.red;\n1990\t      back.green = (png_byte)png_ptr->background.green;\n1991\t      back.blue  = (png_byte)png_ptr->background.blue;\n1992\t\n1993\t      for (i = 0; i < istop; i++)\n1994\t      {\n1995\t         if (png_ptr->trans_alpha[i] == 0)\n1996\t         {\n1997\t            palette[i] = back;\n1998\t         }\n1999\t\n2000\t         else if (png_ptr->trans_alpha[i] != 0xff)\n2001\t         {\n2002\t            /* The png_composite() macro is defined in png.h */\n2003\t            png_composite(palette[i].red, palette[i].red,\n2004\t                png_ptr->trans_alpha[i], back.red);\n2005\t\n2006\t            png_composite(palette[i].green, palette[i].green,\n2007\t                png_ptr->trans_alpha[i], back.green);\n2008\t\n2009\t            png_composite(palette[i].blue, palette[i].blue,\n2010\t                png_ptr->trans_alpha[i], back.blue);\n2011\t         }\n2012\t      }\n2013\t\n2014\t      png_ptr->transformations &= ~PNG_COMPOSE;\n2015\t   }\n2016\t#endif /* READ_BACKGROUND */\n2017\t\n2018\t#ifdef PNG_READ_SHIFT_SUPPORTED\n2019\t   if ((png_ptr->transformations & PNG_SHIFT) != 0 &&\n2020\t       (png_ptr->transformations & PNG_EXPAND) == 0 &&\n2021\t       (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE))\n2022\t   {\n2023\t      int i;\n2024\t      int istop = png_ptr->num_palette;\n2025\t      int shift = 8 - png_ptr->sig_bit.red;\n2026\t\n2027\t      png_ptr->transformations &= ~PNG_SHIFT;\n2028\t\n2029\t      /* significant bits can be in the range 1 to 7 for a meaningful result, if\n2030\t       * the number of significant bits is 0 then no shift is done (this is an\n2031\t       * error condition which is silently ignored.)\n2032\t       */\n2033\t      if (shift > 0 && shift < 8)\n2034\t         for (i=0; i<istop; ++i)\n2035\t         {\n2036\t            int component = png_ptr->palette[i].red;\n2037\t\n2038\t            component >>= shift;\n2039\t            png_ptr->palette[i].red = (png_byte)component;\n2040\t         }\n2041\t\n2042\t      shift = 8 - png_ptr->sig_bit.green;\n2043\t      if (shift > 0 && shift < 8)\n2044\t         for (i=0; i<istop; ++i)\n2045\t         {\n2046\t            int component = png_ptr->palette[i].green;\n2047\t\n2048\t            component >>= shift;\n2049\t            png_ptr->palette[i].green = (png_byte)component;\n2050\t         }\n2051\t\n2052\t      shift = 8 - png_ptr->sig_bit.blue;\n2053\t      if (shift > 0 && shift < 8)\n2054\t         for (i=0; i<istop; ++i)\n2055\t         {\n2056\t            int component = png_ptr->palette[i].blue;\n2057\t\n2058\t            component >>= shift;\n2059\t            png_ptr->palette[i].blue = (png_byte)component;\n2060\t         }\n2061\t   }\n2062\t#endif /* READ_SHIFT */\n2063\t}\n2064\t\n2065\t/* Modify the info structure to reflect the transformations.  The\n2066\t * info should be updated so a PNG file could be written with it,\n2067\t * assuming the transformations result in valid PNG data.\n2068\t */\n2069\tvoid /* PRIVATE */\n2070\tpng_read_transform_info(png_structrp png_ptr, png_inforp info_ptr)\n2071\t{\n2072\t   png_debug(1, \"in png_read_transform_info\");\n2073\t\n2074\t   if (info_ptr->color_type == PNG_COLOR_TYPE_PALETTE &&\n2075\t       info_ptr->palette != NULL && png_ptr->palette != NULL)\n2076\t   {\n2077\t      /* Sync info_ptr->palette with png_ptr->palette, which may\n2078\t       * have been modified by png_init_read_transformations\n2079\t       * (e.g. for gamma correction or background compositing).\n2080\t       */\n2081\t      memcpy(info_ptr->palette, png_ptr->palette,\n2082\t          PNG_MAX_PALETTE_LENGTH * (sizeof (png_color)));\n2083\t   }\n2084\t\n2085\t#ifdef PNG_READ_EXPAND_SUPPORTED\n2086\t   if ((png_ptr->transformations & PNG_EXPAND) != 0)\n2087\t   {\n2088\t      if (info_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n2089\t      {\n2090\t         /* This check must match what actually happens in\n2091\t          * png_do_expand_palette; if it ever checks the tRNS chunk to see if\n2092\t          * it is all opaque we must do the same (at present it does not.)\n2093\t          */\n2094\t         if (png_ptr->num_trans > 0)\n2095\t            info_ptr->color_type = PNG_COLOR_TYPE_RGB_ALPHA;\n2096\t\n2097\t         else\n2098\t            info_ptr->color_type = PNG_COLOR_TYPE_RGB;\n2099\t\n2100\t         info_ptr->bit_depth = 8;\n2101\t         info_ptr->num_trans = 0;\n2102\t\n2103\t         if (png_ptr->palette == NULL)\n2104\t            png_error (png_ptr, \"Palette is NULL in indexed image\");\n2105\t      }\n2106\t      else\n2107\t      {\n2108\t         if (png_ptr->num_trans != 0)\n2109\t         {\n2110\t            if ((png_ptr->transformations & PNG_EXPAND_tRNS) != 0)\n2111\t               info_ptr->color_type |= PNG_COLOR_MASK_ALPHA;\n2112\t         }\n2113\t         if (info_ptr->bit_depth < 8)\n2114\t            info_ptr->bit_depth = 8;\n2115\t\n2116\t         info_ptr->num_trans = 0;\n2117\t      }\n2118\t   }\n2119\t#endif\n2120\t\n2121\t#if defined(PNG_READ_BACKGROUND_SUPPORTED) ||\\\n2122\t   defined(PNG_READ_ALPHA_MODE_SUPPORTED)\n2123\t   /* The following is almost certainly wrong unless the background value is in\n2124\t    * the screen space!\n2125\t    */\n2126\t   if ((png_ptr->transformations & PNG_COMPOSE) != 0)\n2127\t      info_ptr->background = png_ptr->background;\n2128\t#endif\n2129\t\n2130\t#ifdef PNG_READ_GAMMA_SUPPORTED\n2131\t   /* The following used to be conditional on PNG_GAMMA (prior to 1.5.4),\n2132\t    * however it seems that the code in png_init_read_transformations, which has\n2133\t    * been called before this from png_read_update_info->png_read_start_row\n2134\t    * sometimes does the gamma transform and cancels the flag.\n2135\t    *\n2136\t    * TODO: this is confusing.  It only changes the result of png_get_gAMA and,\n2137\t    * yes, it does return the value that the transformed data effectively has\n2138\t    * but does any app really understand this?\n2139\t    */\n2140\t   info_ptr->gamma = png_ptr->file_gamma;\n2141\t#endif\n2142\t\n2143\t   if (info_ptr->bit_depth == 16)\n2144\t   {\n2145\t#  ifdef PNG_READ_16BIT_SUPPORTED\n2146\t#     ifdef PNG_READ_SCALE_16_TO_8_SUPPORTED\n2147\t         if ((png_ptr->transformations & PNG_SCALE_16_TO_8) != 0)\n2148\t            info_ptr->bit_depth = 8;\n2149\t#     endif\n2150\t\n2151\t#     ifdef PNG_READ_STRIP_16_TO_8_SUPPORTED\n2152\t         if ((png_ptr->transformations & PNG_16_TO_8) != 0)\n2153\t            info_ptr->bit_depth = 8;\n2154\t#     endif\n2155\t\n2156\t#  else\n2157\t      /* No 16-bit support: force chopping 16-bit input down to 8, in this case\n2158\t       * the app program can chose if both APIs are available by setting the\n2159\t       * correct scaling to use.\n2160\t       */\n2161\t#     ifdef PNG_READ_STRIP_16_TO_8_SUPPORTED\n2162\t         /* For compatibility with previous versions use the strip method by\n2163\t          * default.  This code works because if PNG_SCALE_16_TO_8 is already\n2164\t          * set the code below will do that in preference to the chop.\n2165\t          */\n2166\t         png_ptr->transformations |= PNG_16_TO_8;\n2167\t         info_ptr->bit_depth = 8;\n2168\t#     else\n2169\t\n2170\t#        ifdef PNG_READ_SCALE_16_TO_8_SUPPORTED\n2171\t            png_ptr->transformations |= PNG_SCALE_16_TO_8;\n2172\t            info_ptr->bit_depth = 8;\n2173\t#        else\n2174\t\n2175\t            CONFIGURATION ERROR: you must enable at least one 16 to 8 method\n2176\t#        endif\n2177\t#    endif\n2178\t#endif /* !READ_16BIT */\n2179\t   }\n2180\t\n2181\t#ifdef PNG_READ_GRAY_TO_RGB_SUPPORTED\n2182\t   if ((png_ptr->transformations & PNG_GRAY_TO_RGB) != 0)\n2183\t      info_ptr-