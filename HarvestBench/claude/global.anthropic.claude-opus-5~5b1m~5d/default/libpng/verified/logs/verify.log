4KB\");\n4601\t#endif\n4602\t\n4603\t   if (row_bytes + 48 > png_ptr->old_big_row_buf_size)\n4604\t   {\n4605\t      png_free(png_ptr, png_ptr->big_row_buf);\n4606\t      png_free(png_ptr, png_ptr->big_prev_row);\n4607\t      png_ptr->big_row_buf = png_ptr->big_prev_row = NULL;\n4608\t\n4609\t      if (png_ptr->interlaced != 0)\n4610\t         png_ptr->big_row_buf = (png_bytep)png_calloc(png_ptr,\n4611\t             row_bytes + 48);\n4612\t\n4613\t      else\n4614\t         png_ptr->big_row_buf = (png_bytep)png_malloc(png_ptr, row_bytes + 48);\n4615\t\n4616\t      png_ptr->big_prev_row = (png_bytep)png_malloc(png_ptr, row_bytes + 48);\n4617\t\n4618\t#ifdef PNG_ALIGNED_MEMORY_SUPPORTED\n4619\t      /* Use 16-byte aligned memory for row_buf with at least 16 bytes\n4620\t       * of padding before and after row_buf; treat prev_row similarly.\n4621\t       * NOTE: the alignment is to the start of the pixels, one beyond the start\n4622\t       * of the buffer, because of the filter byte.  Prior to libpng 1.5.6 this\n4623\t       * was incorrect; the filter byte was aligned, which had the exact\n4624\t       * opposite effect of that intended.\n4625\t       */\n4626\t      {\n4627\t         png_bytep temp = png_ptr->big_row_buf + 32;\n4628\t         size_t extra = (size_t)temp & 0x0f;\n4629\t         png_ptr->row_buf = temp - extra - 1/*filter byte*/;\n4630\t\n4631\t         temp = png_ptr->big_prev_row + 32;\n4632\t         extra = (size_t)temp & 0x0f;\n4633\t         png_ptr->prev_row = temp - extra - 1/*filter byte*/;\n4634\t      }\n4635\t#else\n4636\t      /* Use 31 bytes of padding before and 17 bytes after row_buf. */\n4637\t      png_ptr->row_buf = png_ptr->big_row_buf + 31;\n4638\t      png_ptr->prev_row = png_ptr->big_prev_row + 31;\n4639\t#endif\n4640\t      png_ptr->old_big_row_buf_size = row_bytes + 48;\n4641\t   }\n4642\t\n4643\t#ifdef PNG_MAX_MALLOC_64K\n4644\t   if (png_ptr->rowbytes > 65535)\n4645\t      png_error(png_ptr, \"This image requires a row grea