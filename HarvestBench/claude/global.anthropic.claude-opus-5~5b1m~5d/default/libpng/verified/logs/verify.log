{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016YSKZS15K57uJDBG1G8Sg3","type":"tool_result","content":"1\t//! Phase C — ERRORS.md rows for `png.c`, `pngerror.c`, `pngmem.c`, `pngrio.c`\n2\t//! and `pngwio.c`.  Every row constructs its exact invalid input and asserts\n3\t//! both libraries reject it identically (same sentinel / same message).\n4\tmod common;\n5\tuse common::*;\n6\tuse std::ffi::CString;\n7\t\n8\t/// Result of one probe: return value (as i64), whether it errored, diagnostics.\n9\t#[derive(Debug, PartialEq)]\n10\tstruct P(i64, bool, Diag);\n11\t\n12\tfn probe<F: FnOnce(&'static Api) -> i64>(api: &'static Api, f: F) -> P {\n13\t    set_current_api(api);\n14\t    diag_reset();\n15\t    let r = guard(|| f(api));\n16\t    P(r.unwrap_or(i64::MIN), r.is_some(), diag_take())\n17\t}\n18\t\n19\tmacro_rules! same {\n20\t    ($label:expr, $f:expr) => {{\n21\t        if std::env::var_os(\"PNGTRACE\").is_some() {\n22\t            eprintln!(\"TRACE {}\", $label);\n23\t        }\n24\t        let c = probe(c_api(), $f);\n25\t        let r = probe(rs_api(), $f);\n26\t        assert_eq!(c, r, \"{}\", $label);\n27\t        c\n28\t    }};\n29\t}\n30\t\n31\t// ---------------------------------------------------------------------------\n32\t// png.c — signature handling\n33\t// ---------------------------------------------------------------------------\n34\t\n35\t#[test]\n36\tfn set_sig_bytes_rejections() {\n37\t    // rows: png_ptr == NULL; num_bytes < 0 (clamped to 0); nb > 8 -> png_error\n38\t    for n in [-100i32, -1, 0, 1, 7, 8, 9, 100, i32::MAX, i32::MIN] {\n39\t        same!(format!(\"png_set_sig_bytes({}) on NULL\", n), |api| {\n40\t            unsafe { (api.png_set_sig_bytes)(std::ptr::null_mut(), n) };\n41\t            0\n42\t        });\n43\t        same!(format!(\"png_set_sig_bytes({})\", n), |api| {\n44\t            let s = unsafe { ReadSess::new(api, &[]) };\n45\t            unsafe { (api.png_set_sig_bytes)(s.png, n) };\n46\t            // observable through png_get_signature/png_read_info later; the\n47\t            // interesting part is the error/warning parity\n48\t            0\n49\t        });\n50\t    }\n51\t}\n52\t\n53\t#[test]\n54\tfn sig_cmp_rejections() {\n55\t    let good: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n56\t    for start in [0usize, 1, 7, 8, 9, 100, usize::MAX] {\n57\t        for num in [0usize, 1, 8, 9, 100] {\n58\t            // start > 7 -> -1 ; num < 1 -> -1 ; both clamped otherwise\n59\t            same!(format!(\"png_sig_cmp(start={},num={})\", start, num), |api| {\n60\t                unsafe { (api.png_sig_cmp)(good.as_ptr(), start, num) as i64 }\n61\t            });\n62\t        }\n63\t    }\n64\t}\n65\t\n66\t// ---------------------------------------------------------------------------\n67\t// png.c — png_create_*_struct version checking\n68\t// ---------------------------------------------------------------------------\n69\t\n70\t#[test]\n71\tfn create_struct_version_mismatch() {\n72\t    let vers = [\n73\t        \"1.6.59.git\", // correct\n74\t        \"\",\n75\t        \"1\",\n76\t        \"1.6\",\n77\t        \"1.5.0\",\n78\t        \"1.7.0\",\n79\t        \"2.6.59.git\",\n80\t        \"1.6.59\",\n81\t        \"xxxxxxxxxx\",\n82\t        \"1.6.59.gi\",\n83\t    ];\n84\t    for v in vers {\n85\t        let cv = cs(v);\n86\t        for read in [true, false] {\n87\t            let label = format!(\"create({}, read={})\", v, read);\n88\t            let c = probe(c_api(), |api| {\n89\t                let p = unsafe {\n90\t                    if read {\n91\t                        (api.png_create_read_struct)(\n92\t                            cv.as_ptr(),\n93\t                            std::ptr::null_mut(),\n94\t                            Some(cb_error),\n95\t                            Some(cb_warning),\n96\t                        )\n97\t                    } else {\n98\t                        (api.png_create_write_struct)(\n99\t                            cv.as_ptr(),\n100\t                            std::ptr::null_mut(),\n101\t                            Some(cb_error),\n102\t                            Some(cb_warning),\n103\t                        )\n104\t                    }\n105\t                };\n106\t                let ok = !p.is_null();\n107\t                if ok {\n108\t                    let mut q = p;\n109\t                    unsafe {\n110\t                        if read {\n111\t                            (api.png_destroy_read_struct)(\n112\t                                &mut q,\n113\t                                std::ptr::null_mut(),\n114\t                                std::ptr::null_mut(),\n115\t                            );\n116\t                        } else {\n117\t                            (api.png_destroy_write_struct)(&mut q, std::ptr::null_mut());\n118\t                        }\n119\t                    }\n120\t                }\n121\t                ok as i64\n122\t            });\n123\t            let r = probe(rs_api(), |api| {\n124\t                let p = unsafe {\n125\t                    if read {\n126\t                        (api.png_create_read_struct)(\n127\t                            cv.as_ptr(),\n128\t                            std::ptr::null_mut(),\n129\t                            Some(cb_error),\n130\t                            Some(cb_warning),\n131\t                        )\n132\t                    } else {\n133\t                        (api.png_create_write_struct)(\n134\t                            cv.as_ptr(),\n135\t                            std::ptr::null_mut(),\n136\t                            Some(cb_error),\n137\t                            Some(cb_warning),\n138\t                        )\n139\t                    }\n140\t                };\n141\t                let ok = !p.is_null();\n142\t                if ok {\n143\t                    let mut q = p;\n144\t                    unsafe {\n145\t                        if read {\n146\t                            (api.png_destroy_read_struct)(\n147\t                                &mut q,\n148\t                                std::ptr::null_mut(),\n149\t                                std::ptr::null_mut(),\n150\t                            );\n151\t                        } else {\n152\t                            (api.png_destroy_write_struct)(&mut q, std::ptr::null_mut());\n153\t                        }\n154\t                    }\n155\t                }\n156\t                ok as i64\n157\t            });\n158\t            assert_eq!(c, r, \"{}\", label);\n159\t        }\n160\t    }\n161\t    // NULL version string\n162\t    for read in [true, false] {\n163\t        same!(format!(\"create(NULL, read={})\", read), |api| {\n164\t            let p = unsafe {\n165\t                if read {\n166\t                    (api.png_create_read_struct)(\n167\t                        std::ptr::null(),\n168\t                        std::ptr::null_mut(),\n169\t                        Some(cb_error),\n170\t                        Some(cb_warning),\n171\t                    )\n172\t                } else {\n173\t                    (api.png_create_write_struct)(\n174\t                        std::ptr::null(),\n175\t                        std::ptr::null_mut(),\n176\t                        Some(cb_error),\n177\t                        Some(cb_warning),\n178\t                    )\n179\t                }\n180\t            };\n181\t            let ok = !p.is_null();\n182\t            if ok {\n183\t                let mut q = p;\n184\t                unsafe {\n185\t                    if read {\n186\t                        (api.png_destroy_read_struct)(\n187\t                            &mut q,\n188\t                            std::ptr::null_mut(),\n189\t                            std::ptr::null_mut(),\n190\t                        );\n191\t                    } else {\n192\t                        (api.png_destroy_write_struct)(&mut q, std::ptr::null_mut());\n193\t                    }\n194\t                }\n195\t            }\n196\t            ok as i64\n197\t        });\n198\t    }\n199\t}\n200\t\n201\t#[test]\n202\tfn user_version_check() {\n203\t    for v in [\"1.6.59.git\", \"\", \"1.5.0\", \"1.7.0\", \"1.6.0\", \"9.9.9\"] {\n204\t        let cv = cs(v);\n205\t        same!(format!(\"png_user_version_check({})\", v), |api| {\n206\t            let s = unsafe { ReadSess::new(api, &[]) };\n207\t            unsafe { (api.png_user_version_check)(s.png, cv.as_ptr()) as i64 }\n208\t        });\n209\t    }\n210\t    same!(\"png_user_version_check(NULL)\", |api| {\n211\t        let s = unsafe { ReadSess::new(api, &[]) };\n212\t        unsafe { (api.png_user_version_check)(s.png, std::ptr::null()) as i64 }\n213\t    });\n214\t}\n215\t\n216\t// ---------------------------------------------------------------------------\n217\t// png.c — png_create_info_struct / png_info_init_3 / png_destroy_info_struct\n218\t// ---------------------------------------------------------------------------\n219\t\n220\t#[test]\n221\tfn info_struct_lifecycle_rejections() {\n222\t    same!(\"png_create_info_struct(NULL)\", |api| {\n223\t        let p = unsafe { (api.png_create_info_struct)(std::ptr::null()) };\n224\t        !p.is_null() as i64\n225\t    });\n226\t    same!(\"png_destroy_info_struct(NULL,NULL)\", |api| {\n227\t        unsafe { (api.png_destroy_info_struct)(std::ptr::null(), std::ptr::null_mut()) };\n228\t        0\n229\t    });\n230\t    same!(\"png_destroy_info_struct(ptr to NULL)\", |api| {\n231\t        let s = unsafe { ReadSess::new(api, &[]) };\n232\t        let mut n: png_infop = std::ptr::null_mut();\n233\t        unsafe { (api.png_destroy_info_struct)(s.png, &mut n) };\n234\t        0\n235\t    });\n236\t    // png_info_init_3: NULL info, and a size >= sizeof(png_info) (no realloc)\n237\t    same!(\"png_info_init_3(NULL)\", |api| {\n238\t        let mut n: png_infop = std::ptr::null_mut();\n239\t        unsafe { (api.png_info_init_3)(&mut n, 1_000_000) };\n240\t        n.is_null() as i64\n241\t    });\n242\t    same!(\"png_info_init_3(big size)\", |api| {\n243\t        let s = unsafe { ReadSess::new(api, &[]) };\n244\t        let mut i = unsafe { (api.png_create_info_struct)(s.png) };\n245\t        unsafe { (api.png_info_init_3)(&mut i, 1_000_000) };\n246\t        let ok = !i.is_null();\n247\t        if ok {\n248\t            unsafe { (api.png_destroy_info_struct)(s.png, &mut i) };\n249\t        }\n250\t        ok as i64\n251\t    });\n252\t    // A size *smaller* than sizeof(png_info) makes the C free() the struct and\n253\t    // re-allocate it; both libraries must still hand back a non-NULL pointer.\n254\t    for sz in [0usize, 1, 8, 64] {\n255\t        same!(format!(\"png_info_init_3(small size {})\", sz), |api| {\n256\t            let s = unsafe { ReadSess::new(api, &[]) };\n257\t            let mut i = unsafe { (api.png_create_info_struct)(s.png) };\n258\t            unsafe { (api.png_info_init_3)(&mut i, sz) };\n259\t            let ok = !i.is_null();\n260\t            if ok {\n261\t                unsafe { (api.png_destroy_info_struct)(s.png, &mut i) };\n262\t            }\n263\t            ok as i64\n264\t        });\n265\t    }\n266\t}\n267\t\n268\t// ---------------------------------------------------------------------------\n269\t// png.c — png_data_freer\n270\t// ---------------------------------------------------------------------------\n271\t\n272\t#[test]\n273\tfn data_freer_rejections() {\n274\t    for freer in [\n275\t        PNG_DESTROY_WILL_FREE_DATA,\n276\t        PNG_SET_WILL_FREE_DATA,\n277\t        PNG_USER_WILL_FREE_DATA,\n278\t        -1,\n279\t        0,\n280\t        4,\n281\t        99,\n282\t    ] {\n283\t        for mask in [0u32, PNG_FREE_ALL as u32, PNG_FREE_TEXT as u32, 0xffff_ffff] {\n284\t            same!(\n285\t                format!(\"png_data_freer(freer={},mask={:#x})\", freer, mask),\n286\t                |api| {\n287\t                    let s = unsafe { ReadSess::new(api, &[]) };\n288\t                    unsafe { (api.png_data_freer)(s.png, s.info, freer, mask) };\n289\t                    0\n290\t                }\n291\t            );\n292\t        }\n293\t    }\n294\t    same!(\"png_data_freer(NULL,NULL)\", |api| {\n295\t        unsafe {\n296\t            (api.png_data_freer)(std::ptr::null(), std::ptr::null_mut(), 1, 0xffff_ffff)\n297\t        };\n298\t        0\n299\t    });\n300\t    // png_free_data NULL guards + every mask\n301\t    for mask in [\n302\t        PNG_FREE_HIST,\n303\t        PNG_FREE_ICCP,\n304\t        PNG_FREE_SPLT,\n305\t        PNG_FREE_ROWS,\n306\t        PNG_FREE_PCAL,\n307\t        PNG_FREE_SCAL,\n308\t        PNG_FREE_UNKN,\n309\t        PNG_FREE_PLTE,\n310\t        PNG_FREE_TRNS,\n311\t        PNG_FREE_TEXT,\n312\t        PNG_FREE_EXIF,\n313\t        PNG_FREE_ALL,\n314\t        0,\n315\t        -1,\n316\t    ] {\n317\t        for num in [-1i32, 0, 1, 100] {\n318\t            same!(format!(\"png_free_data(mask={:#x},num={})\", mask, num), |api| {\n319\t                let s = unsafe { ReadSess::new(api, &[]) };\n320\t                unsafe { (api.png_free_data)(s.png, s.info, mask as u32, num) };\n321\t                0\n322\t            });\n323\t        }\n324\t    }\n325\t    same!(\"png_free_data(NULL info)\", |api| {\n326\t        let s = unsafe { ReadSess::new(api, &[]) };\n327\t        unsafe { (api.png_free_data)(s.png, std::ptr::null_mut(), 0xffff_ffff, -1) };\n328\t        0\n329\t    });\n330\t}\n331\t\n332\t// ---------------------------------------------------------------------------\n333\t// png.c — png_check_IHDR (through png_set_IHDR, which validates)\n334\t// ---------------------------------------------------------------------------\n335\t\n336\t#[test]\n337\tfn set_ihdr_rejections() {\n338\t    let widths = [0u32, 1, 0x7fff_ffff, 0x8000_0000, 0xffff_ffff, 1_000_001];\n339\t    let heights = [0u32, 1, 0x7fff_ffff, 0x8000_0000, 0xffff_ffff];\n340\t    let depths = [-1i32, 0, 1, 2, 3, 4, 5, 8, 16, 17, 32, 64];\n341\t    let ctypes = [-1i32, 0, 1, 2, 3, 4, 5, 6, 7, 8, 100];\n342\t    for &w in &widths {\n343\t        for &h in &heights {\n344\t            for &bd in &depths {\n345\t                for &ct in &ctypes {\n346\t                    same!(\n347\t                        format!(\"png_set_IHDR({},{},{},{})\", w, h, bd, ct),\n348\t                        |api| {\n349\t                            let s = unsafe { WriteSess::new(api) };\n350\t                            unsafe {\n351\t                                (api.png_set_IHDR)(\n352\t                                    s.png, s.info, w, h, bd, ct, 0, 0, 0,\n353\t                                )\n354\t                            };\n355\t                            0\n356\t                        }\n357\t                    );\n358\t                }\n359\t            }\n360\t        }\n361\t    }\n362\t    // interlace / compression / filter method rejections\n363\t    for il in [-1i32, 0, 1, 2, 100] {\n364\t        for comp in [-1i32, 0, 1, 100] {\n365\t            for filt in [-1i32, 0, 1, 64, 65, 100] {\n366\t                same!(\n367\t                    format!(\"png_set_IHDR methods il={} c={} f={}\", il, comp, filt),\n368\t                    |api| {\n369\t                        let s = unsafe { WriteSess::new(api) };\n370\t                        unsafe {\n371\t                            (api.png_set_IHDR)(s.png, s.info, 4, 4, 8, 2, il, comp, filt)\n372\t                        };\n373\t                        0\n374\t                    }\n375\t                );\n376\t                // ... and with MNG features permitted, which legalises\n377\t                // filter method 64 (PNG_INTRAPIXEL_DIFFERENCING)\n378\t                same!(\n379\t                    format!(\"png_set_IHDR mng il={} c={} f={}\", il, comp, filt),\n380\t                    |api| {\n381\t                        let s = unsafe { WriteSess::new(api) };\n382\t                        unsafe {\n383\t                            (api.png_permit_mng_features)(s.png, PNG_ALL_MNG_FEATURES);\n384\t                            (api.png_set_IHDR)(s.png, s.info, 4, 4, 8, 2, il, comp, filt)\n385\t                        };\n386\t                        0\n387\t                    }\n388\t                );\n389\t            }\n390\t        }\n391\t    }\n392\t    // png_check_IHDR called directly\n393\t    for &w in &[0u32, 1, 0x8000_0000] {\n394\t        for &bd in &[0i32, 3, 8] {\n395\t            for &ct in &[0i32, 1, 6] {\n396\t                same!(format!(\"png_check_IHDR({},{},{})\", w, bd, ct), |api| {\n397\t                    let s = unsafe { WriteSess::new(api) };\n398\t                    unsafe { (api.png_check_IHDR)(s.png, w, 4, bd, ct, 0, 0, 0) };\n399\t                    0\n400\t                });\n401\t            }\n402\t        }\n403\t    }\n404\t}\n405\t\n406\t// ---------------------------------------------------------------------------\n407\t// png.c — png_set_option\n408\t// ---------------------------------------------------------------------------\n409\t\n410\t#[test]\n411\tfn set_option_rejections() {\n412\t    for opt in [-2i32, -1, 0, 1, 2, 3, 4, 8, 11, 12, 13, 100] {\n413\t        for val in [-1i32, 0, 1, 2, 3, 4, 100] {\n414\t            same!(format!(\"png_set_option({},{})\", opt, val), |api| {\n415\t                let s = unsafe { ReadSess::new(api, &[]) };\n416\t                unsafe { (api.png_set_option)(s.png, opt, val) as i64 }\n417\t            });\n418\t        }\n419\t    }\n420\t    same!(\"png_set_option(NULL)\", |api| {\n421\t        unsafe { (api.png_set_option)(std::ptr::null_mut(), 2, 3) as i64 }\n422\t    });\n423\t}\n424\t\n425\t// ---------------------------------------------------------------------------\n426\t// png.c — png_fixed / png_fixed_ITU overflow\n427\t// ---------------------------------------------------------------------------\n428\t\n429\t#[test]\n430\tfn fixed_conversion_overflow() {\n431\t    let name = cs(\"test value\");\n432\t    let vals = [\n433\t        0.0f64,\n434\t        1.0,\n435\t        -1.0,\n436\t        21474.0,\n437\t        21475.0,\n438\t        -21475.0,\n439\t        1e10,\n440\t        -1e10,\n441\t        f64::MAX,\n442\t        f64::MIN,\n443\t        1e-10,\n444\t        0.5,\n445\t        1.0 / 3.0,\n446\t    ];\n447\t    for &v in &vals {\n448\t        same!(format!(\"png_fixed({})\", v), |api| {\n449\t            let s = unsafe { ReadSess::new(api, &[]) };\n450\t            unsafe { (api.png_fixed)(s.png, v, name.as_ptr()) as i64 }\n451\t        });\n452\t        same!(format!(\"png_fixed_ITU({})\", v), |api| {\n453\t            let s = unsafe { ReadSess::new(api, &[]) };\n454\t            unsafe { (api.png_fixed_ITU)(s.png, v, name.as_ptr()) as i64 }\n455\t        });\n456\t    }\n457\t}\n458\t\n459\t// ---------------------------------------------------------------------------\n460\t// png.c — png_ascii_from_fp / png_ascii_from_fixed \"buffer too small\"\n461\t// ---------------------------------------------------------------------------\n462\t\n463\t#[test]\n464\tfn ascii_conversion_buffer_too_small() {\n465\t    for size in [0usize, 1, 2, 3, 4, 5, 6, 7, 8, 12, 15, 16, 24] {\n466\t        for &v in &[0.0f64, 1.0, -1.0, 1e-10, 1e10, 123456.789, 0.5] {\n467\t            for prec in [1u32, 5, 15] {\n468\t                same!(\n469\t                    format!(\"png_ascii_from_fp(size={},v={},p={})\", size, v, prec),\n470\t                    |api| {\n471\t                        let s = unsafe { ReadSess::new(api, &[]) };\n472\t                        let mut b = vec![0u8; size + 32];\n473\t                        unsafe {\n474\t                            (api.png_ascii_from_fp)(\n475\t                                s.png,\n476\t                                b.as_mut_ptr() as png_charp,\n477\t                                size,\n478\t                                v,\n479\t                                prec,\n480\t                            )\n481\t                        };\n482\t                        b[..size.min(b.len())].iter().map(|&x| x as i64).sum()\n483\t                    }\n484\t                );\n485\t            }\n486\t        }\n487\t        for &v in &[0i32, 1, -1, 100000, i32::MAX, i32::MIN] {\n488\t            same!(\n489\t                format!(\"png_ascii_from_fixed(size={},v={})\", size, v),\n490\t                |api| {\n491\t                    let s = unsafe { ReadSess::new(api, &[]) };\n492\t                    let mut b = vec![0u8; size + 32];\n493\t                    unsafe {\n494\t                        (api.png_ascii_from_fixed)(\n495\t                            s.png,\n496\t                            b.as_mut_ptr() as png_charp,\n497\t                            size,\n498\t                            v,\n499\t                        )\n500\t                    };\n501\t                    b[..size.min(b.len())].iter().map(|&x| x as i64).sum()\n502\t                }\n503\t            );\n504\t        }\n505\t    }\n506\t}\n507\t\n508\t// ---------------------------------------------------------------------------\n509\t// png.c — png_get_uint_31 range check\n510\t// ---------------------------------------------------------------------------\n511\t\n512\t#[test]\n513\tfn get_uint_31_rejects_out_of_range() {\n514\t    for v in [\n515\t        0u32,\n516\t        1,\n517\t        PNG_UINT_31_MAX,\n518\t        PNG_UINT_31_MAX + 1,\n519\t        0x8000_0001,\n520\t        0xffff_ffff,\n521\t    ] {\n522\t        let b = v.to_be_bytes();\n523\t        same!(format!(\"png_get_uint_31({:#x})\", v), |api| {\n524\t            let s = unsafe { ReadSess::new(api, &[]) };\n525\t            unsafe { (api.png_get_uint_31)(s.png, b.as_ptr()) as i64 }\n526\t        });\n527\t    }\n528\t}\n529\t\n530\t// ---------------------------------------------------------------------------\n531\t// pngerror.c — the whole diagnostic dispatch\n532\t// ---------------------------------------------------------------------------\n533\t\n534\t#[test]\n535\tfn error_dispatch() {\n536\t    // messages exercising png_format_buffer: long, with '#' number markers,\n537\t    // and non-printable bytes (which get hex-escaped in the chunk name)\n538\t    let msgs: Vec<CString> = vec![\n539\t        cs(\"\"),\n540\t        cs(\"plain\"),\n541\t        cs(&\"x\".repeat(63)),\n542\t        cs(&\"x\".repeat(64)),\n543\t        cs(&\"y\".repeat(200)),\n544\t        cs(\"#12345 numbered\"),\n545\t        cs(\"#nn\"),\n546\t        CString::new(vec![0x41u8, 0x01, 0x7f, 0x80, 0xff, 0x42]).unwrap(),\n547\t    ];\n548\t    for m in &msgs {\n549\t        for read in [true, false] {\n550\t            for benign_warn in [0i32, 1] {\n551\t                same!(\n552\t                    format!(\"png_warning({:?},read={},bw={})\", m, read, benign_warn),\n553\t                    |api| {\n554\t                        unsafe {\n555\t                            let (png, _keep_r, _keep_w);\n556\t                            if read {\n557\t                                let s = ReadSess::new(api, &[]);\n558\t                                png = s.png;\n559\t                                _keep_r = Some(s);\n560\t                                _keep_w = None;\n561\t                            } else {\n562\t                                let s = WriteSess::new(api);\n563\t                                png = s.png;\n564\t                                _keep_r = None;\n565\t                                _keep_w = Some(s);\n566\t                            }\n567\t                            (api.png_set_benign_errors)(png, benign_warn);\n568\t                            (api.png_warning)(png, m.as_ptr());\n569\t                            (api.png_app_warning)(png, m.as_ptr());\n570\t                            (api.png_chunk_warning)(png, m.as_ptr());\n571\t                            (api.png_chunk_report)(png, m.as_ptr(), 0);\n572\t                            (api.png_chunk_report)(png, m.as_ptr(), 1);\n573\t                            (api.png_chunk_report)(png, m.as_ptr(), 2);\n574\t                            (api.png_chunk_report)(png, m.as_ptr(), 3);\n575\t                            (api.png_chunk_report)(png, m.as_ptr(), -1);\n576\t                        }\n577\t                        0\n578\t                    }\n579\t                );\n580\t                // The error variants unwind, so each needs its own probe.\n581\t                for which in 0..5 {\n582\t                    same!(\n583\t                        format!(\n584\t                            \"error variant {} ({:?},read={},bw={})\",\n585\t                            which, m, read, benign_warn\n586\t                        ),\n587\t                        |api| {\n588\t                            unsafe {\n589\t                                let (png, _kr, _kw);\n590\t                                if read {\n591\t                                    let s = ReadSess::new(api, &[]);\n592\t                                    png = s.png;\n593\t                                    _kr = Some(s);\n594\t                                    _kw = None;\n595\t                                } else {\n596\t                                    let s = WriteSess::new(api);\n597\t                                    png = s.png;\n598\t                                    _kr = None;\n599\t                                    _kw = Some(s);\n600\t                                }\n601\t                                (api.png_set_benign_errors)(png, benign_warn);\n602\t                                match which {\n603\t                                    0 => (api.png_error)(png, m.as_ptr()),\n604\t                                    1 => (api.png_chunk_error)(png, m.as_ptr()),\n605\t                                    2 => {\n606\t                                        (api.png_app_error)(png, m.as_ptr());\n607\t                                        return 1;\n608\t                                    }\n609\t                                    3 => {\n610\t                                        (api.png_benign_error)(png, m.as_ptr());\n611\t                                        return 2;\n612\t                                    }\n613\t                                    _ => {\n614\t                                        (api.png_chunk_benign_error)(png, m.as_ptr());\n615\t                                        return 3;\n616\t                                    }\n617\t                                }\n618\t                            }\n619\t                        }\n620\t                    );\n621\t                }\n622\t            }\n623\t        }\n624\t    }\n625\t    // NULL message\n626\t    for which in 0..3 {\n627\t        same!(format!(\"NULL message variant {}\", which), |api| {\n628\t            unsafe {\n629\t                let s = ReadSess::new(api, &[]);\n630\t                match which {\n631\t                    0 => {\n632\t                        (api.png_warning)(s.png, std::ptr::null());\n633\t                        0\n634\t                    }\n635\t                    1 => {\n636\t                        (api.png_app_warning)(s.png, std::ptr::null());\n637\t                        0\n638\t                    }\n639\t                    _ => (api.png_error)(s.png, std::ptr::null()),\n640\t                }\n641\t            }\n642\t        });\n643\t    }\n644\t}\n645\t\n646\t#[test]\n647\tfn warning_parameter_formatting() {\n648\t    // png_warning_parameter / _signed / _unsigned / png_formatted_warning\n649\t    for number in [-1i32, 0, 1, 2, 8, 9, 100] {\n650\t        for fmt in [\n651\t            PNG_NUMBER_FORMAT_u,\n652\t            PNG_NUMBER_FORMAT_02u,\n653\t            PNG_NUMBER_FORMAT_x,\n654\t            PNG_NUMBER_FORMAT_02x,\n655\t            PNG_NUMBER_FORMAT_fixed,\n656\t            0,\n657\t            99,\n658\t        ] {\n659\t            for val in [0i64, 1, 12345, -1, i32::MAX as i64, i32::MIN as i64] {\n660\t                same!(\n661\t                    format!(\"warning_parameter({},{},{})\", number, fmt, val),\n662\t                    |api| {\n663\t                        unsafe {\n664\t                            let s = ReadSess::new(api, &[]);\n665\t                            let mut p =\n666\t                                [[0i8; PNG_WARNING_PARAMETER_SIZE]; PNG_WARNING_PARAMETER_COUNT];\n667\t                            let pp = p.as_mut_ptr() as *mut [c_char; PNG_WARNING_PARAMETER_SIZE];\n668\t                            let sv = cs(\"string value\");\n669\t                            (api.png_warning_parameter)(pp, number, sv.as_ptr());\n670\t                            (api.png_warning_parameter_signed)(pp, number, fmt, val as i32);\n671\t                            (api.png_warning_parameter_unsigned)(\n672\t                                pp,\n673\t                                number,\n674\t                                fmt,\n675\t                                val as usize,\n676\t                            );\n677\t                            let msg = cs(\"param @1 and @2 and @9 and @ and @0\");\n678\t                            (api.png_formatted_warning)(s.png, pp, msg.as_ptr());\n679\t                            p.iter()\n680\t                                .flat_map(|r| r.iter())\n681\t                                .map(|&c| c as i64)\n682\t                                .sum::<i64>()\n683\t                        }\n684\t                    }\n685\t                );\n686\t            }\n687\t        }\n688\t    }\n689\t}\n690\t\n691\t#[test]\n692\tfn longjmp_fn_rejections() {\n693\t    unsafe extern \"C-unwind\" fn my_longjmp(_e: *mut jmp_buf, _v: c_int) -> ! {\n694\t        std::process::abort()\n695\t    }\n696\t    // NULL png_ptr -> NULL\n697\t    same!(\"png_set_longjmp_fn(NULL)\", |api| {\n698\t        let p = unsafe {\n699\t            (api.png_set_longjmp_fn)(std::ptr::null_mut(), Some(my_longjmp), 200)\n700\t        };\n701\t        p.is_null() as i64\n702\t    });\n703\t    // First call with the built-in size; then the SAME size again (ok) and a\n704\t    // DIFFERENT size (-> \"Application jmp_buf size changed\" + NULL).\n705\t    for (s1, s2) in [\n706\t        (200usize, 200usize),\n707\t        (200, 8),\n708\t        (8, 200),\n709\t        (0, 0),\n710\t        (0, 1),\n711\t        (1_000_000, 1_000_000),\n712\t        (1_000_000, 999_999),\n713\t    ] {\n714\t        same!(format!(\"png_set_longjmp_fn({} then {})\", s1, s2), |api| {\n715\t            unsafe {\n716\t                let s = ReadSess::new(api, &[]);\n717\t                let a = (api.png_set_longjmp_fn)(s.png, Some(my_longjmp), s1);\n718\t                let b = (api.png_set_longjmp_fn)(s.png, Some(my_longjmp), s2);\n719\t                (api.png_free_jmpbuf)(s.png);\n720\t                ((!a.is_null()) as i64) * 2 + ((!b.is_null()) as i64)\n721\t            }\n722\t        });\n723\t    }\n724\t    same!(\"png_free_jmpbuf(NULL)\", |api| {\n725\t        unsafe { (api.png_free_jmpbuf)(std::ptr::null_mut()) };\n726\t        0\n727\t    });\n728\t}\n729\t\n730\t// ---------------------------------------------------------------------------\n731\t// pngmem.c\n732\t// ---------------------------------------------------------------------------\n733\t\n734\t#[test]\n735\tfn allocator_rejections() {\n736\t    let sizes = [\n737\t        0usize,\n738\t        1,\n739\t        16,\n740\t        65536,\n741\t        65537,\n742\t        usize::MAX,\n743\t        usize::MAX - 1,\n744\t        usize::MAX / 2,\n745\t        1 << 40,\n746\t    ];\n747\t    for &sz in &sizes {\n748\t        same!(format!(\"png_malloc_base(NULL,{})\", sz), |api| {\n749\t            let p = unsafe { (api.png_malloc_base)(std::ptr::null(), sz) };\n750\t            let ok = !p.is_null();\n751\t            if ok {\n752\t                unsafe { (api.png_free_default)(std::ptr::null(), p) };\n753\t            }\n754\t            ok as i64\n755\t        });\n756\t        same!(format!(\"png_malloc_warn({})\", sz), |api| {\n757\t            unsafe {\n758\t                let s = ReadSess::new(api, &[]);\n759\t                let p = (api.png_malloc_warn)(s.png, sz);\n760\t                let ok = !p.is_null();\n761\t                if ok {\n762\t                    (api.png_free)(s.png, p);\n763\t                }\n764\t                ok as i64\n765\t            }\n766\t        });\n767\t        // png_malloc / png_calloc png_error on failure\n768\t        same!(format!(\"png_malloc({})\", sz), |api| {\n769\t            unsafe {\n770\t                let s = ReadSess::new(api, &[]);\n771\t                let p = (api.png_malloc)(s.png, sz);\n772\t                let ok = !p.is_null();\n773\t                if ok {\n774\t                    (api.png_free)(s.png, p);\n775\t                }\n776\t                ok as i64\n777\t            }\n778\t        });\n779\t        if sz <= (1 << 20) {\n780\t            same!(format!(\"png_calloc({})\", sz), |api| {\n781\t                unsafe {\n782\t                    let s = ReadSess::new(api, &[]);\n783\t                    let p = (api.png_calloc)(s.png, sz);\n784\t                    let ok = !p.is_null();\n785\t                    if ok {\n786\t                        (api.png_free)(s.png, p);\n787\t                    }\n788\t                    ok as i64\n789\t                }\n790\t            });\n791\t        }\n792\t    }\n793\t    // NULL / no-op frees\n794\t    same!(\"png_free(NULL ptr)\", |api| {\n795\t        unsafe {\n796\t            let s = ReadSess::new(api, &[]);\n797\t            (api.png_free)(s.png, std::ptr::null_mut());\n798\t        }\n799\t        0\n800\t    });\n801\t    same!(\"png_free(NULL png_ptr)\", |api| {\n802\t        unsafe { (api.png_free)(std::ptr::null(), std::ptr::null_mut()) };\n803\t        0\n804\t    });\n805\t    same!(\"png_free_default(NULL)\", |api| {\n806\t        unsafe { (api.png_free_default)(std::ptr::null(), std::ptr::null_mut()) };\n807\t        0\n808\t    });\n809\t    same!(\"png_malloc_default(NULL png_ptr, 0)\", |api| {\n810\t        unsafe {\n811\t            let s = ReadSess::new(api, &[]);\n812\t            let p = (api.png_malloc_default)(s.png, 0);\n813\t            let ok = !p.is_null();\n814\t            if ok {\n815\t                (api.png_free_default)(s.png, p);\n816\t            }\n817\t            ok as i64\n818\t        }\n819\t    });\n820\t}\n821\t\n822\t#[test]\n823\tfn array_allocator_rejections() {\n824\t    // png_malloc_array(png_ptr, nelements, element_size)\n825\t    let cases: [(i32, usize); 12] = [\n826\t        (0, 0),\n827\t        (-1, 4),\n828\t        (1, 0),\n829\t        (1, 1),\n830\t        (10, 4),\n831\t        (i32::MAX, 1),\n832\t        (i32::MAX, 2),\n833\t        (65536, 65536),\n834\t        (1, usize::MAX),\n835\t        (2, usize::MAX / 2),\n836\t        (1000, 1000),\n837\t        (-100, 8),\n838\t    ];\n839\t    for &(n, es) in &cases {\n840\t        same!(format!(\"png_malloc_array({},{})\", n, es), |api| {\n841\t            unsafe {\n842\t                let s = ReadSess::new(api, &[]);\n843\t                let p = (api.png_malloc_array)(s.png, n, es);\n844\t                let ok = !p.is_null();\n845\t                if ok {\n846\t                    (api.png_free)(s.png, p);\n847\t                }\n848\t                ok as i64\n849\t            }\n850\t        });\n851\t        // png_realloc_array(png_ptr, old_array, old_elements, add_elements, element_size)\n852\t        for &(old_n, add_n) in &[(0i32, 0i32), (0, 1), (1, 0), (1, -1), (-1, 1), (2, i32::MAX)] {\n853\t            same!(\n854\t                format!(\"png_realloc_array({},{},{},{})\", n, old_n, add_n, es),\n855\t                |api| {\n856\t                    unsafe {\n857\t                        let s = ReadSess::new(api, &[]);\n858\t                        let p = (api.png_realloc_array)(\n859\t                            s.png,\n860\t                            std::ptr::null(),\n861\t                            old_n,\n862\t                            add_n,\n863\t                            es,\n864\t                        );\n865\t                        let ok = !p.is_null();\n866\t                        if ok {\n867\t                            (api.png_free)(s.png, p);\n868\t                        }\n869\t                        ok as i64\n870\t                    }\n871\t                }\n872\t            );\n873\t        }\n874\t    }\n875\t}\n876\t\n877\t#[test]\n878\tfn zalloc_zfree_rejections() {\n879\t    // png_zalloc overflow: items * size > png_alloc_size_t\n880\t    let cases: [(u32, u32); 8] = [\n881\t        (0, 0),\n882\t        (1, 1),\n883\t        (1, 0),\n884\t        (0, 1),\n885\t        (0xffff_ffff, 0xffff_ffff),\n886\t        (0x1_0000, 0x1_0000),\n887\t        (2, 0x8000_0000),\n888\t        (0x8000_0000, 2),\n889\t    ];\n890\t    for &(items, size) in &cases {\n891\t        same!(format!(\"png_zalloc({},{})\", items, size), |api| {\n892\t            unsafe {\n893\t                let s = ReadSess::new(api, &[]);\n894\t                let p = (api.png_zalloc)(s.png as voidpf, items, size);\n895\t                let ok = !p.is_null();\n896\t                if ok {\n897\t                    (api.png_zfree)(s.png as voidpf, p);\n898\t                }\n899\t                ok as i64\n900\t            }\n901\t        });\n902\t        same!(format!(\"png_zalloc(NULL,{},{})\", items, size), |api| {\n903\t            let p = unsafe {\n904\t                (api.png_zalloc)(std::ptr::null_mut(), items, size)\n905\t            };\n906\t            p.is_null() as i64\n907\t        });\n908\t    }\n909\t    same!(\"png_zfree(NULL,NULL)\", |api| {\n910\t        unsafe { (api.png_zfree)(std::ptr::null_mut(), std::ptr::null_mut()) };\n911\t        0\n912\t    });\n913\t}\n914\t\n915\t// ---------------------------------------------------------------------------\n916\t// pngrio.c / pngwio.c\n917\t// ---------------------------------------------------------------------------\n918\t\n919\t#[test]\n920\tfn io_function_rejections() {\n921\t    // NOTE: the \"Call to NULL read function\" / \"Call to NULL write function\"\n922\t    // errors are UNREACHABLE in this build configuration: PNG_STDIO_SUPPORTED\n923\t    // is on, so png_create_read_struct_2 (pngread.c:76) and\n924\t    // png_create_write_struct_2 (pngwrite.c:614) immediately install\n925\t    // png_default_read_data / png_default_write_data, and png_set_read_fn /\n926\t    // png_set_write_fn re-install them when passed NULL (pngrio.c:99,\n927\t    // pngwio.c:99).  With io_ptr == NULL those defaults fread()/fwrite() a NULL\n928\t    // FILE*, which is C undefined behaviour rather than an error return, so\n929\t    // there is no observable rejection to compare.\n930\t    // The \"Can't set both read_data_fn and write_data_fn in the same\n931\t    // structure\" warning, in both orders.\n932\t    same!(\"read_fn then write_fn\", |api| {\n933\t        unsafe {\n934\t            let s = ReadSess::new(api, &[]);\n935\t            (api.png_set_write_fn)(\n936\t                s.png,\n937\t                std::ptr::null_mut(),\n938\t                Some(cb_write),\n939\t                Some(cb_flush),\n940\t            );\n941\t            0\n942\t        }\n943\t    });\n944\t    same!(\"write_fn then read_fn\", |api| {\n945\t        unsafe {\n946\t            let s = WriteSess::new(api);\n947\t            (api.png_set_read_fn)(s.png, std::ptr::null_mut(), Some(cb_read));\n948\t            0\n949\t        }\n950\t    });\n951\t    // NULL png_ptr early returns\n952\t    same!(\"png_set_read_fn(NULL)\", |api| {\n953\t        unsafe {\n954\t            (api.png_set_read_fn)(std::ptr::null_mut(), std::ptr::null_mut(), Some(cb_read))\n955\t        };\n956\t        0\n957\t    });\n958\t    same!(\"png_set_write_fn(NULL)\", |api| {\n959\t        unsafe {\n960\t            (api.png_set_write_fn)(\n961\t                std::ptr::null_mut(),\n962\t                std::ptr::null_mut(),\n963\t                Some(cb_write),\n964\t                Some(cb_flush),\n965\t            )\n966\t        };\n967\t        0\n968\t    });\n969\t    same!(\"png_init_io(NULL png_ptr)\", |api| {\n970\t        unsafe { (api.png_init_io)(std::ptr::null_mut(), std::ptr::null_mut()) };\n971\t        0\n972\t    });\n973\t    same!(\"png_init_io(NULL FILE)\", |api| {\n974\t        unsafe {\n975\t            let s = ReadSess::new(api, &[]);\n976\t            (api.png_init_io)(s.png, std::ptr::null_mut());\n977\t        }\n978\t        0\n979\t    });\n980\t    same!(\"png_get_io_ptr(NULL)\", |api| {\n981\t        let p = unsafe { (api.png_get_io_ptr)(std::ptr::null_mut()) };\n982\t        p.is_null() as i64\n983\t    });\n984\t    same!(\"png_set_flush(NULL)\", |api| {\n985\t        unsafe { (api.png_set_flush)(std::ptr::null_mut(), 5) };\n986\t        0\n987\t    });\n988\t    for n in [-1i32, 0, 1, 1000] {\n989\t        same!(format!(\"png_set_flush({})\", n), |api| {\n990\t            unsafe {\n991\t                let s = WriteSess::new(api);\n992\t                (api.png_set_flush)(s.png, n);\n993\t            }\n994\t            0\n995\t        });\n996\t    }\n997\t    // NOTE: png_flush() has NO NULL guard in the C (pngwio.c) -- it reads\n998\t    // png_ptr->output_flush_fn unconditionally, so NULL png_ptr is C UB.\n999\t    // png_default_flush()/png_default_read_data()/png_default_write_data() are\n1000\t    // likewise UB unless io_ptr is a real FILE*.\n1001\t    same!(\"png_flush on fresh write struct\", |api| {\n1002\t        unsafe {\n1003\t            let s = WriteSess::new(api);\n1004\t            (api.png_flush)(s.png);\n1005\t        }\n1006\t        0\n1007\t    });\n1008\t    // png_write_flush before any row has been written\n1009\t    same!(\"png_write_flush on fresh write struct\", |api| {\n1010\t        unsafe {\n1011\t            let s = WriteSess::new(api);\n1012\t            (api.png_write_flush)(s.png);\n1013\t        }\n1014\t        0\n1015\t    });\n1016\t    same!(\"png_write_flush(NULL)\", |api| {\n1017\t        unsafe { (api.png_write_flush)(std::ptr::null_mut()) };\n1018\t        0\n1019\t    });\n1020\t    // \"Read Error\" from a truncated stream\n1021\t    for n in [0usize, 1, 4, 7, 8, 9, 20] {\n1022\t        same!(format!(\"truncated stream, {} bytes\", n), |api| {\n1023\t            unsafe {\n1024\t                let sig: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n1025\t                let mut data = sig.to_vec();\n1026\t                data.extend_from_slice(&[0u8; 32]);\n1027\t                data.truncate(n);\n1028\t                let s = ReadSess::new(api, &data);\n1029\t                (api.png_read_info)(s.png, s.info);\n1030\t                0\n1031\t            }\n1032\t        });\n1033\t    }\n1034\t    // png_get_io_state / png_get_io_chunk_type on a live read\n1035\t    same!(\"io state during read\", |api| {\n1036\t        unsafe {\n1037\t            let s = ReadSess::new(api, &[]);\n1038\t            let a = (api.png_get_io_state)(s.png) as i64;\n1039\t            let b = (api.png_get_io_chunk_type)(s.png) as i64;\n1040\t            a * 1_000_000 + b\n1041\t        }\n1042\t    });\n1043\t}\n1044\t\n1045\t#[test]\n1046\tfn read_sig_and_signature_rejections() {\n1047\t    let good: [u8; 8] = [137, 80, 78, 71, 13, 10, 26, 10];\n1048\t    for corrupt_at in 0..9usize {\n1049\t        same!(format!(\"bad signature byte {}\", corrupt_at), |api| {\n1050\t            unsafe {\n1051\t                let mut data = good.to_vec();\n1052\t                if corrupt_at < 8 {\n1053\t                    data[corrupt_at] ^= 0xff;\n1054\t                }\n1055\t                data.extend_from_slice(&[0u8; 40]);\n1056\t                let s = ReadSess::new(api, &data);\n1057\t                (api.png_read_info)(s.png, s.info);\n1058\t                0\n1059\t            }\n1060\t        });\n1061\t    }\n1062\t    same!(\"png_get_signature(NULL)\", |api| {\n1063\t        let p = unsafe { (api.png_get_signature)(std::ptr::null(), std::ptr::null()) };\n1064\t        p.is_null() as i64\n1065\t    });\n1066\t}\n1067\t\n1068\t#[test]\n1069\tfn crc_and_zstream_error_paths() {\n1070\t    same!(\"png_reset_crc + png_calculate_crc\", |api| {\n1071\t        unsafe {\n1072\t            let s = ReadSess::new(api, &[]);\n1073\t            (api.png_reset_crc)(s.png);\n1074\t            let b = [1u8, 2, 3, 4, 5, 6, 7, 8];\n1075\t            (api.png_calculate_crc)(s.png, b.as_ptr(), 8);\n1076\t            (api.png_calculate_crc)(s.png, b.as_ptr(), 0);\n1077\t            (api.png_calculate_crc)(s.png, std::ptr::null(), 0);\n1078\t        }\n1079\t        0\n1080\t    });\n1081\t    // png_zstream_error for every zlib return code\n1082\t    for ret in [\n1083\t        0i32, 1, 2, -1, -2, -3, -4, -5, -6, 3, -100, 100, i32::MIN, i32::MAX,\n1084\t    ] {\n1085\t        same!(format!(\"png_zstream_error({})\", ret), |api| {\n1086\t            unsafe {\n1087\t                let s = ReadSess::new(api, &[]);\n1088\t                (api.png_zstream_error)(s.png, ret);\n1089\t            }\n1090\t            0\n1091\t        });\n1092\t    }\n1093\t    // png_reset_zstream on a struct with no zstream yet\n1094\t    same!(\"png_reset_zstream fresh\", |api| {\n1095\t        unsafe {\n1096\t            let s = ReadSess::new(api, &[]);\n1097\t            (api.png_reset_zstream)(s.png) as i64\n1098\t        }\n1099\t    });\n1100\t    same!(\"png_reset_zstream(NULL)\", |api| {\n1101\t        unsafe { (api.png_reset_zstream)(std::ptr::null_mut()) as i64 }\n1102\t    });\n1103\t}\n1104\t"}]},"parent_tool_use_id":"toolu_bdrk_01K4AzBRHbaoF5qTYNXeCbTr","session_id":"e3091878-9949-4689-ad83-c0c41e6641a2","uuid":"f8906c58-7f62-48a7-b0c9-9d8dc610ba94","timestamp":"2026-08-31T13:44:41.250Z","subag