3\t    pub redx: png_fixed_point,\n174\t    pub redy: png_fixed_point,\n175\t    pub greenx: png_fixed_point,\n176\t    pub greeny: png_fixed_point,\n177\t    pub bluex: png_fixed_point,\n178\t    pub bluey: png_fixed_point,\n179\t    pub whitex: png_fixed_point,\n180\t    pub whitey: png_fixed_point,\n181\t}\n182\t\n183\t#[repr(C)]\n184\t#[derive(Copy, Clone, Default, PartialEq, Eq, Debug)]\n185\tpub struct png_XYZ {\n186\t    pub red_X: png_fixed_point,\n187\t    pub red_Y: png_fixed_point,\n188\t    pub red_Z: png_fixed_point,\n189\t    pub green_X: png_fixed_point,\n190\t    pub green_Y: png_fixed_point,\n191\t    pub green_Z: png_fixed_point,\n192\t    pub blue_X: png_fixed_point,\n193\t    pub blue_Y: png_fixed_point,\n194\t    pub blue_Z: png_fixed_point,\n195\t}\n196\t\n197\t/* Opaque structures -- only ever handled through pointers. */\n198\t#[repr(C)]\n199\tpub struct png_struct {\n200\t    _private: [u8; 0],\n201\t}\n202\t#[repr(C)]\n203\tpub struct png_info {\n204\t    _private: [u8; 0],\n205\t}\n206\t#[repr(C)]\n207\tpub struct png_control {\n208\t    _private: [u8; 0],\n209\t}\n210\t#[repr(C)]\n211\tpub struct png_compression_buffer {\n212\t    _private: [u8; 0],\n213\t}\n214\tpub type png_compression_bufferp = *mut png_compression_buffer;\n215\tpub type png_controlp = *mut png_control;\n216\t\n217\tpub type png_structp = *mut png_struct;\n218\tpub type png_const_structp = *const png_struct;\n219\tpub type png_structrp = *mut png_struct;\n220\tpub type png_const_structrp = *const png_struct;\n221\tpub type png_structpp = *mut png_structp;\n222\tpub type png_infop = *mut png_info;\n223\tpub type png_const_infop = *const png_info;\n224\tpub type png_inforp = *mut png_info;\n225\tpub type png_const_inforp = *const png_info;\n226\tpub type png_infopp = *mut png_infop;\n227\t\n228\t#[repr(C)]\n229\t#[derive(Copy, Clone)]\n230\tpub struct png_image {\n231\t    pub opaque: png_controlp,\n232\t    pub version: png_uint_32,\n233\t    pub width: png_uint_32,\n234\t    pub height: png_uint_32,\n235\t    pub format: png_uint_32,\n236\t    pub flags: png_uint_32,\n237\t    pub colormap_entries: png_uint_32,\n238\t    pub warning_or_error: png_uint_32,\n239\t    pub message: [c_char; 64],\n240\t}\n241\tpub type png_imagep = *mut png_image;\n242\t\n243\timpl Default for png_image {\n244\t    fn default() -> Self {\n245\t        png_image {\n246\t            opaque: core::ptr::null_mut(),\n247\t            version: PNG_IMAGE_VERSION,\n248\t            width: 0,\n249\t            height: 0,\n250\t            format: 0,\n251\t            flags: 0,\n252\t            colormap_entries: 0,\n253\t            warning_or_error: 0,\n254\t            message: [0; 64],\n255\t        }\n256\t    }\n257\t}\n258\t\n259\t#[repr(C)]\n260\t#[derive(Copy, Clone)]\n261\tpub struct jmp_buf(pub [u64; 25]);\n262\timpl Default for jmp_buf {\n263\t    fn default() -> Self {\n264\t        jmp_buf([0; 25])\n265\t    }\n266\t}\n267\t\n268\tpub type png_error_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_const_charp)>;\n269\tpub type png_rw_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_bytep, usize)>;\n270\tpub type png_flush_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp)>;\n271\tpub type png_read_status_ptr =\n272\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_uint_32, c_int)>;\n273\tpub type png_write_status_ptr =\n274\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_uint_32, c_int)>;\n275\tpub type png_progressive_info_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_infop)>;\n276\tpub type png_progressive_end_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_infop)>;\n277\tpub type png_progressive_row_ptr =\n278\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_bytep, png_uint_32, c_int)>;\n279\tpub type png_user_transform_ptr =\n280\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_row_infop, png_bytep)>;\n281\tpub type png_user_chunk_ptr =\n282\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_unknown_chunkp) -> c_int>;\n283\tpub type png_malloc_ptr =\n284\t    Option<unsafe extern \"C-unwind\" fn(png_structp, png_alloc_size_t) -> png_voidp>;\n285\tpub type png_free_ptr = Option<unsafe extern \"C-unwind\" fn(png_structp, png_voidp)>;\n286\tpub type png_longjmp_ptr = Option<unsafe extern \"C-unwind\" fn(*mut jmp_buf, c_int) -> !>;\n287\t\n288\t// ---------------------------------------------------------------------------\n289\t// Constants from png.h / pngpriv.h that the tests need.\n290\t// ---------------------------------------------------------------------------\n291\t\n292\tpub const PNG_LIBPNG_VER_STRING: &str = \"1.6.59.git\";\n293\tpub const PNG_IMAGE_VERSION: png_uint_32 = 1;\n294\t\n295\tpub const PNG_UINT_31_MAX: png_uint_32 = 0x7fff_ffff;\n296\tpub const PNG_UINT_32_MAX: png_uint_32 = 0xffff_ffff;\n297\t\n298\tpub const PNG_FP_1: png_fixed_point = 100_000;\n299\tpub const PNG_FP_HALF: png_fixed_point = 50_000;\n300\tpub const PNG_FP_MAX: png_fixed_point = 0x7fff_ffff;\n301\tpub const PNG_FP_MIN: png_fixed_point = -PNG_FP_MAX;\n302\t\n303\tpub const PNG_COLOR_MASK_PALETTE: c_int = 1;\n304\tpub const PNG_COLOR_MASK_COLOR: c_int = 2;\n305\tpub const PNG_COLOR_MASK_ALPHA: c_int = 4;\n306\t\n307\tpub const PNG_COLOR_TYPE_GRAY: c_int = 0;\n308\tpub const PNG_COLOR_TYPE_PALETTE: c_int = 3;\n309\tpub const PNG_COLOR_TYPE_RGB: c_int = 2;\n310\tpub const PNG_COLOR_TYPE_RGB_ALPHA: c_int = 6;\n311\tpub const PNG_COLOR_TYPE_GRAY_ALPHA: c_int = 4;\n312\t\n313\tpub const PNG_COMPRESSION_TYPE_BASE: c_int = 0;\n314\tpub const PNG_FILTER_TYPE_BASE: c_int = 0;\n315\tpub const PNG_INTRAPIXEL_DIFFERENCING: c_int = 64;\n316\tpub const PNG_INTERLACE_NONE: c_int = 0;\n317\tpub const PNG_INTERLACE_ADAM7: c_int = 1;\n318\t\n319\tpub const PNG_TEXT_COMPRESSION_NONE_WR: c_int = -3;\n320\tpub const PNG_TEXT_COMPRESSION_zTXt_WR: c_int = -2;\n321\tpub const PNG_TEXT_COMPRESSION_NONE: c_int = -1;\n322\tpub const PNG_TEXT_COMPRE