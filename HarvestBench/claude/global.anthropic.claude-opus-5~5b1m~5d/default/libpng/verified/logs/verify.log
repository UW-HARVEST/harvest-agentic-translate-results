uct after png_read_info; error_action = 1\n//              (PNG_ERROR_ACTION_NONE); red = green = 1e30 (also 1e300,\n//              f64::MAX, -1e30 ... any pair where both values are outside\n//              +-21474.83647)\n//   C result : png_error, message \"fixed point overflow in rgb to gray green\n//              coefficient\"\n//   RS result: png_error, message \"fixed point overflow in rgb to gray red\n//              coefficient\"\n//\n// Both libraries reject the call fatally with the identical return value; only\n// the *message* differs, because the C wrapper (pngrtran.c:1119-1125) passes\n// the two conversions as arguments of one call:\n//\n//     png_set_rgb_to_gray_fixed(png_ptr, error_action,\n//         png_fixed(png_ptr, red,   \"rgb to gray red coefficient\"),\n//         png_fixed(png_ptr, green, \"rgb to gray green coefficient\"));\n//\n// The order in which the two `png_fixed` calls are evaluated is unspecified in\n// C; gcc evaluates the argument list right-to-left, so the *green* conversion\n// runs first and its png_fixed_error is the one that fires.  The Rust\n// translation evaluates its arguments left-to-right, so it reports red.\n// Per the harness rules the C is ground truth and the Rust is NOT changed\n// here; the assertion is kept and this test is #[ignore]d.\n#[test]\n#[ignore]\nfn rgb_to_gray_float_overflow() {\n    let full = unsafe { made(PNG_COLOR_TYPE_RGB, 8, 5, 3, PNG_INTERLACE_NONE, true) };\n    for &(r, g) in &[\n        (1e30f64, 1e30f64),\n        (1e300, 1e300),\n        (-1e30, -1e30),\n        (f64::MAX, f64::MAX),\n        (1e30, 0.5),\n        (0.5, 1e30),\n        (21475.0, 21475.0),\n    ] {\n        same!(\n            format!(\"rgb_to_gray(f) overflow r={} g={}\", r, g),\n            |api: &'static Api| unsafe {\n                let s = ReadSess::new(api, &full);\n                (api.png_read_info)(s.png, s.info);\n                (api.png_set_rgb_to_gray)(s.png, PNG_ERROR_ACTION_NONE, r, g);\n                snap(api, s.png, s.info) as i64\n            }\n        );\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":612,"cache_read_input_tokens":241644,"cache_creation":{"ephemeral_5m_input_tokens":612,"ephemeral_1h_input_tokens":0},"output_tokens":16,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01BzwnoYDSYW86hqb9b58PMk","session_id":"e3091878-9949-4689-ad83-c0c41e6641a2","uuid":"d02b9072-92f2-42b1-87aa-b46938267957","timestamp":"2026-08-31T14:16:22.724Z","subagent_type":"general-purpose","task_description":"Error tests: read paths"}
