png_ptr, png_uint_32 bpp,\n2445\t    size_t row_bytes, size_t lmins)\n2446\t{\n2447\t   png_bytep rp, dp, pp, cp, lp;\n2448\t   size_t i;\n2449\t   size_t sum = 0;\n2450\t   unsigned int v;\n2451\t\n2452\t   png_ptr->try_row[0] = PNG_FILTER_VALUE_PAETH;\n2453\t\n2454\t   for (i = 0, rp = png_ptr->row_buf + 1, dp = png_ptr->try_row + 1,\n2455\t       pp = png_ptr->prev_row + 1; i < bpp; i++)\n2456\t   {\n2457\t      v = *dp++ = (png_byte)(((int)*rp++ - (int)*pp++) & 0xff);\n2458\t\n2459\t#ifdef PNG_USE_ABS\n2460\t      sum += 128 - abs((int)v - 128);\n2461\t#else\n2462\t      sum += (v < 128) ? v : 256 - v;\n2463\t#endif\n2464\t   }\n2465\t\n2466\t   for (lp = png_ptr->row_buf + 1, cp = png_ptr->prev_row + 1; i < row_bytes;\n2467\t        i++)\n2468\t   {\n2469\t      int a, b, c, pa, pb, pc, p;\n2470\t\n2471\t      b = *pp++;\n2472\t      c = *cp++;\n2473\t      a = *lp++;\n2474\t\n2475\t      p = b - c;\n2476\t      pc = a - c;\n2477\t\n2478\t#ifdef PNG_USE_ABS\n2479\t      pa = abs(p);\n2480\t      pb = abs(pc);\n2481\t      pc = abs(p + pc);\n2482\t#else\n2483\t      pa = p < 0 ? -p : p;\n2484\t      pb = pc < 0 ? -pc : pc;\n2485\t      pc = (p + pc) < 0 ? -(p + pc) : p + pc;\n2486\t#endif\n2487\t\n2488\t      p = (pa <= pb && pa <=pc) ? a : (pb <= pc) ? b : c;\n2489\t\n2490\t      v = *dp++ = (png_byte)(((int)*rp++ - p) & 0xff);\n2491\t\n2492\t#ifdef PNG_USE_ABS\n2493\t      sum += 128 - abs((int)v - 128);\n2494\t#else\n2495\t      sum += (v < 128) ? v : 256 - v;\n2496\t#endif\n2497\t\n2498\t      if (sum > lmins)  /* We are already worse, don't continue. */\n2499\t        break;\n2500\t   }\n2501\t\n2502\t   return sum;\n2503\t}\n2504\tstatic void /* PRIVATE */\n2505\tpng_setup_paeth_row_only(png_structrp png_ptr, png_uint_32 bpp,\n2506\t    size_t row_bytes)\n2507\t{\n2508\t   png_bytep rp, dp, pp, cp, lp;\n2509\t   size_t i;\n2510\t\n2511\t   png_ptr->try_row[0] = PNG_FILTER_VALUE_PAETH;\n2512\t\n2513\t   for (i = 0, rp = png_ptr->row_buf + 1, dp = png_ptr->try_row + 1,\n2514\t       pp = png_ptr->prev_row + 1; i < bpp; i++)\n2515\t   {\n2516\t      *dp++ = (png_byte)(((int)*rp++ - (int)*pp++) & 0xff);\n2517\t   }\n2518\t\n2519\t   for (lp = png_ptr->row_buf + 1, cp = png_ptr->prev_row + 1; i < row_bytes;\n2520\t        i++)\n2521\t   {\n2522\t      int a, b, c, pa, pb, pc, p;\n2523\t\n2524\t      b = *pp++;\n2525\t      c = *cp++;\n2526\t      a = *lp++;\n2527\t\n2528\t      p = b - c;\n2529\t      pc = a - c;\n2530\t\n2531\t#ifdef PNG_USE_ABS\n2532\t      pa = abs(p);\n2533\t      pb = abs(pc);\n2534\t      pc = abs(p + pc);\n2535\t#else\n2536\t      pa = p < 0 ? -p : p;\n2537\t      pb = pc < 0 ? -pc : pc;\n2538\t      pc = (p + pc) < 0 ? -(p + pc) : p + pc;\n2539\t#endif\n2540\t\n2541\t      p = (pa <= pb && pa <=pc) ? a : (pb <= pc) ? b : c;\n2542\t\n2543\t      *dp++ = (png_byte)(((int)*rp++ - p) & 0xff);\n2544\t   }\n2545\t}\n2546\t#endif /* WRITE_FILTER */\n2547\t\n2548\tvoid /* PRIVATE */\n2549\tpng_write_find_filter(png_structrp png_ptr, png_row_infop row_info)\n2550\t{\n2551\t#ifndef PNG_WRITE_FILTER_SUPPORTED\n2552\t   png_write_filtered_row(png_ptr, png_ptr->row_buf, row_info->rowbytes+1);\n2553\t#else\n2554\t   unsigned int filter_to_do = png_ptr->do_filter;\n2555\t   png_bytep row_buf;\n2556\t   png_bytep best_row;\n2557\t   png_uint_32 bpp;\n2558\t   size_t mins;\n2559\t   size_t row_bytes = row_info->rowbytes;\n2560\t\n2561\t   png_debug(1, \"in png_write_find_filter\");\n2562\t\n2563\t   /* Find out how many bytes offset each pixel is */\n2564\t   bpp = (row_info->pixel_depth + 7) >> 3;\n2565\t\n2566\t   row_buf = png_ptr->row_buf;\n2567\t   mins = PNG_SIZE_MAX - 256/* so we can detect potential overflow of the\n2568\t                               running sum */;\n2569\t\n2570\t   /* The prediction method we use is to find which method provides the\n2571\t    * smallest value when summing the absolute values of the distances\n2572\t    * from zero, using anything >= 128 as negative numbers.  This is known\n2573\t    * as the \"minimum sum of absolute differences\" heuristic.  Other\n2574\t    * heuristics are the \"weighted minimum sum of absolute differences\"\n2575\t    * (experimental and can in theory improve compression), and the \"zlib\n2576\t    * predictive\" method (not implemented yet), which does test compressions\n2577\t    * of lines using different filter methods, and then chooses the\n2578\t    * (series of) filter(s) that give minimum compressed data size (VERY\n2579\t    * computationally expensive).\n2580\t    *\n2581\t    * GRR 980525:  consider also\n2582\t    *\n2583\t    *   (1) minimum sum of absolute differences from running average (i.e.,\n2584\t    *       keep running sum of non-absolute differences & count of bytes)\n2585\t    *       [track dispersion, too?  restart average if dispersion too large?]\n2586\t    *\n2587\t    *  (1b) minimum sum of absolute differences from sliding average, probably\n2588\t    *       with window size <= deflate window (usually 32K)\n2589\t    *\n2590\t    *   (2) minimum sum of squared differences from zero or running average\n2591\t    *       (i.e., ~ root-mean-square approach)\n2592\t    */\n2593\t\n2594\t\n2595\t   /* We don't need to test the 'no filter' case if this is the only filter\n2596\t    * that has been chosen, as it doesn't actually do anything to the data.\n2597\t    */\n2598\t   best_row = png_ptr->row_buf;\n2599\t\n2600\t   if (PNG_SIZE_MAX/128 <= row_bytes)\n2601\t   {\n2602\t      /* Overflow can occur in the calculation, just select the lowest set\n2603\t       * filter.\n2604\t       */\n2605\t      filter_to_do &= 0U-filter_to_do;\n2606\t   }\n2607\t   else if ((filter_to_do & PNG_FILTER_NONE) != 0 &&\n2608\t         filter_to_do != PNG_FILTER_NONE)\n2609\t   {\n2610\t      /* Overflow not possible and multiple filters in the list, including the\n2611\t       * 'none' filter.\n2612\t       */\n2613\t      png_bytep rp;\n2614\t      size_t sum = 0;\n2615\t      size_t i;\n2616\t      unsigned int v;\n2617\t\n2618\t      {\n2619\t         for (i = 0, rp = row_buf + 1; i < row_bytes; i++, rp++)\n2620\t         {\n2621\t            v = *rp;\n2622\t#ifdef PNG_USE_ABS\n2623\t            sum += 128 - abs((int)v - 128);\n2624\t#else\n2625\t            sum += (v < 128) ? v : 256 - v;\n2626\t#endif\n2627\t         }\n2628\t      }\n2629\t\n2630\t      mins = sum;\n2631\t   }\n2632\t\n2633\t   /* Sub filter */\n2634\t   if (filter_to_do == PNG_FILTER_SUB)\n2635\t   /* It's the only filter so no testing is needed */\n2636\t   {\n2637\t      png_setup_sub_row_only(png_ptr, bpp, row_bytes);\n2638\t      best_row = png_ptr->try_row;\n2639\t   }\n2640\t\n2641\t   else if ((filter_to_do & PNG_FILTER_SUB) != 0)\n2642\t   {\n2643\t      size_t sum;\n2644\t      size_t lmins = mins;\n2645\t\n2646\t      sum = png_setup_sub_row(png_ptr, bpp, row_bytes, lmins);\n2647\t\n2648\t      if (sum < mins)\n2649\t      {\n2650\t         mins = sum;\n2651\t         best_row = png_ptr->try_row;\n2652\t         if (png_ptr->tst_row != NULL)\n2653\t         {\n2654\t            png_ptr->try_row = png_ptr->tst_row;\n2655\t            png_ptr->tst_row = best_row;\n2656\t         }\n2657\t      }\n2658\t   }\n2659\t\n2660\t   /* Up filter */\n2661\t   if (filter_to_do == PNG_FILTER_UP)\n2662\t   {\n2663\t      png_setup_up_row_only(png_ptr, row_bytes);\n2664\t      best_row = png_ptr->try_row;\n2665\t   }\n2666\t\n2667\t   else if ((filter_to_do & PNG_FILTER_UP) != 0)\n2668\t   {\n2669\t      size_t sum;\n2670\t      size_t lmins = mins;\n2671\t\n2672\t      sum = png_setup_up_row(png_ptr, row_bytes, lmins);\n2673\t\n2674\t      if (sum < mins)\n2675\t      {\n2676\t         mins = sum;\n2677\t         best_row = png_ptr->try_row;\n2678\t         if (png_ptr->tst_row != NULL)\n2679\t         {\n2680\t            png_ptr->try_row = png_ptr->tst_row;\n2681\t            png_ptr->tst_row = best_row;\n2682\t         }\n2683\t      }\n2684\t   }\n2685\t\n2686\t   /* Avg filter */\n2687\t   if (filter_to_do == PNG_FILTER_AVG)\n2688\t   {\n2689\t      png_setup_avg_row_only(png_ptr, bpp, row_bytes);\n2690\t      best_row = png_ptr->try_row;\n2691\t   }\n2692\t\n2693\t   else if ((filter_to_do & PNG_FILTER_AVG) != 0)\n2694\t   {\n2695\t      size_t sum;\n2696\t      size_t lmins = mins;\n2697\t\n2698\t      sum= png_setup_avg_row(png_ptr, bpp, row_bytes, lmins);\n2699\t\n2700\t      if (sum < mins)\n2701\t      {\n2702\t         mins = sum;\n2703\t         best_row = png_ptr->try_row;\n2704\t         if (png_ptr->tst_row != NULL)\n2705\t         {\n2706\t            png_ptr->try_row = png_ptr->tst_row;\n2707\t            png_ptr->tst_row = best_row;\n2708\t         }\n2709\t      }\n2710\t   }\n2711\t\n2712\t   /* Paeth filter */\n2713\t   if (filter_to_do == PNG_FILTER_PAETH)\n2714\t   {\n2715\t      png_setup_paeth_row_only(png_ptr, bpp, row_bytes);\n2716\t      best_row = png_ptr->try_row;\n2717\t   }\n2718\t\n2719\t   else if ((filter_to_do & PNG_FILTER_PAETH) != 0)\n2720\t   {\n2721\t      size_t sum;\n2722\t      size_t lmins = mins;\n2723\t\n2724\t      sum = png_setup_paeth_row(png_ptr, bpp, row_bytes, lmins);\n2725\t\n2726\t      if (sum < mins)\n2727\t      {\n2728\t         best_row = png_ptr->try_row;\n2729\t         if (png_ptr->tst_row != NULL)\n2730\t         {\n2731\t            png_ptr->try_row = png_ptr->tst_row;\n2732\t            png_ptr->tst_row = best_row;\n2733\t         }\n2734\t      }\n2735\t   }\n2736\t\n2737\t   /* Do the actual writing of the filtered row data from the chosen filter. */\n2738\t   png_write_filtered_row(png_ptr, best_row, row_info->rowbytes+1);\n2739\t\n2740\t#endif /* WRITE_FILTER */\n2741\t}\n2742\t\n2743\t\n2744\t/* Do the actual writing of a previously filtered row. */\n2745\tstatic void\n2746\tpng_write_filtered_row(png_structrp png_ptr, png_bytep filtered_row,\n2747\t    size_t full_row_length/*includes filter byte*/)\n2748\t{\n2749\t   png_debug(1, \"in png_write_filtered_row\");\n2750\t\n2751\t   png_debug1(2, \"filter = %d\", filtered_row[0]);\n2752\t\n2753\t   png_compress_IDAT(png_ptr, filtered_row, full_row_length, Z_NO_FLUSH);\n2754\t\n2755\t#ifdef PNG_WRITE_FILTER_SUPPORTED\n2756\t   /* Swap the current and previous rows */\n2757\t   if (png_ptr->prev_row != NULL)\n2758\t   {\n2759\t      png_bytep tptr;\n2760\t\n2761\t      tptr = png_ptr->prev_row;\n2762\t      png_ptr->prev_row = png_ptr->row_buf;\n2763\t      png_ptr->row_buf = tptr;\n2764\t   }\n2765\t#endif /* WRITE_FILTER */\n2766\t\n2767\t   /* Finish row - updates counters and flushes zlib if last row */\n2768\t   png_write_finish_row(png_ptr);\n2769\t\n2770\t#ifdef PNG_WRITE_FLUSH_SUPPORTED\n2771\t   png_ptr->flush_rows++;\n2772\t\n2773\t   if (png_ptr->flush_dist > 0 &&\n2774\t       png_ptr->flush_rows >= png_ptr->flush_dist)\n2775\t   {\n2776\t      png_write_flush(png_ptr);\n2777\t   }\n2778\t#endif /* WRITE_FLUSH */\n2779\t}\n2780\t#endif /* WRITE */\n2781\t"}]},"parent_tool_use_id":"toolu_bdrk_01GD1ZzWADnHpQWVxV5zsaUn","session_id":"e3091878-9949-4689-ad83-c0c41e6641a2","uuid":"388be39f-f2ea-481e-9001-693706eb6a8c","timestamp":"2026-08-31T13:16:47.075Z","subagent_type":"Explore","task_description":"Map write pipeline branches"}
