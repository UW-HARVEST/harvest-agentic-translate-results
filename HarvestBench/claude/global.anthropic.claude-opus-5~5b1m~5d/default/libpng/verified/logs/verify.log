06\t         }\n1207\t      }\n1208\t   }\n1209\t\n1210\t   /* If no alpha we can optimize. */\n1211\t   if (input_has_alpha == 0)\n1212\t   {\n1213\t      /* Any alpha means background and associative alpha processing is\n1214\t       * required, however if the alpha is 0 or 1 throughout OPTIMIZE_ALPHA\n1215\t       * and ENCODE_ALPHA are irrelevant.\n1216\t       */\n1217\t      png_ptr->transformations &= ~PNG_ENCODE_ALPHA;\n1218\t      png_ptr->flags &= ~PNG_FLAG_OPTIMIZE_ALPHA;\n1219\t\n1220\t      if (input_has_transparency == 0)\n1221\t         png_ptr->transformations &= ~(PNG_COMPOSE | PNG_BACKGROUND_EXPAND);\n1222\t   }\n1223\t\n1224\t#if defined(PNG_READ_EXPAND_SUPPORTED) && defined(PNG_READ_BACKGROUND_SUPPORTED)\n1225\t   /* png_set_background handling - deals with the complexity of whether the\n1226\t    * background color is in the file format or the screen format in the case\n1227\t    * where an 'expand' will happen.\n1228\t    */\n1229\t\n1230\t   /* The following code cannot be entered in the alpha pre-multiplication case\n1231\t    * because PNG_BACKGROUND_EXPAND is cancelled below.\n1232\t    */\n1233\t   if ((png_ptr->transformations & PNG_BACKGROUND_EXPAND) != 0 &&\n1234\t       (png_ptr->transformations & PNG_EXPAND) != 0)\n1235\t   {\n1236\t      {\n1237\t         png_ptr->background.red   =\n1238\t             png_ptr->palette[png_ptr->background.index].red;\n1239\t         png_ptr->background.green =\n1240\t             png_ptr->palette[png_ptr->background.index].green;\n1241\t         png_ptr->background.blue  =\n1242\t             png_ptr->palette[png_ptr->background.index].blue;\n1243\t\n1244\t#ifdef PNG_READ_INVERT_ALPHA_SUPPORTED\n1245\t         if ((png_ptr->transformations & PNG_INVERT_ALPHA) != 0)\n1246\t         {\n1247\t            if ((png_ptr->transformations & PNG_EXPAND_tRNS) == 0)\n1248\t            {\n1249\t               /* Invert the alpha channel (in tRNS) unless the pixels are\n1250\t                * going to be expande