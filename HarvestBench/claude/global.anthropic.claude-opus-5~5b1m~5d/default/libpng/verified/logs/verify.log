png_ptr, \"malformed sPLT chunk\");\n1613\t      return handled_error;\n1614\t   }\n1615\t\n1616\t   new_palette.depth = *entry_start++;\n1617\t   entry_size = (new_palette.depth == 8 ? 6 : 10);\n1618\t   /* This must fit in a png_uint_32 because it is derived from the original\n1619\t    * chunk data length.\n1620\t    */\n1621\t   data_length = length - (png_uint_32)(entry_start - buffer);\n1622\t\n1623\t   /* Integrity-check the data length */\n1624\t   if ((data_length % (unsigned int)entry_size) != 0)\n1625\t   {\n1626\t      png_warning(png_ptr, \"sPLT chunk has bad length\");\n1627\t      return handled_error;\n1628\t   }\n1629\t\n1630\t   dl = (png_uint_32)(data_length / (unsigned int)entry_size);\n1631\t   max_dl = PNG_SIZE_MAX / (sizeof (png_sPLT_entry));\n1632\t\n1633\t   if (dl > max_dl)\n1634\t   {\n1635\t      png_warning(png_ptr, \"sPLT chunk too long\");\n1636\t      return handled_error;\n1637\t   }\n1638\t\n1639\t   new_palette.nentries = (png_int_32)(data_length / (unsigned int)entry_size);\n1640\t\n1641\t   new_palette.entries = (png_sPLT_entryp)png_malloc_warn(png_ptr,\n1642\t       (png_alloc_size_t) new_palette.nentries * (sizeof (png_sPLT_entry)));\n1643\t\n1644\t   if (new_palette.entries == NULL)\n1645\t   {\n1646\t      png_warning(png_ptr, \"sPLT chunk requires too much memory\");\n1647\t      return handled_error;\n1648\t   }\n1649\t\n1650\t   for (i = 0; i < new_palette.nentries; i++)\n1651\t   {\n1652\t      pp = new_palette.entries + i;\n1653\t\n1654\t      if (new_palette.depth == 8)\n1655\t      {\n1656\t         pp->red = *entry_start++;\n1657\t         pp->green = *entry_start++;\n1658\t         pp->blue = *entry_start++;\n1659\t         pp->alpha = *entry_start++;\n1660\t      }\n1661\t\n1662\t      else\n1663\t      {\n1664\t         pp->red   = png_get_uint_16(entry_start); entry_start += 2;\n1665\t         pp->green = png_get_uint_16(entry_start); entry_start += 2;\n1666\t         pp->blue  = png_get_uint_16(entry_start); entry_start += 2;\n1667\t         pp->alpha = png_get_uint_16(entry_start); entry_start += 2;\n1668\t      }\n1669\t\n1670\t      pp->frequency = png_get_uint_16(entry_start); entry_start += 2;\n1671\t   }\n1672\t\n1673\t   /* Discard all chunk data except the name and stash that */\n1674\t   new_palette.name = (png_charp)buffer;\n1675\t\n1676\t   png_set_sPLT(png_ptr, info_ptr, &new_palette, 1);\n1677\t\n1678\t   png_free(png_ptr, new_palette.entries);\n1679\t   return handled_ok;\n1680\t}\n1681\t#else\n1682\t#  define png_handle_sPLT NULL\n1683\t#endif /* READ_sPLT */\n1684\t\n1685\t#ifdef PNG_READ_tRNS_SUPPORTED\n1686\tstatic png_handle_result_code /* PRIVATE */\n1687\tpng_handle_tRNS(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1688\t{\n1689\t   png_byte readbuf[PNG_MAX_PALETTE_LENGTH];\n1690\t\n1691\t   png_debug(1, \"in png_handle_tRNS\");\n1692\t\n1693\t   if (png_ptr->color_type == PNG_COLOR_TYPE_GRAY)\n1694\t   {\n1695\t      png_byte buf[2];\n1696\t\n1697\t      if (length != 2)\n1698\t      {\n1699\t         png_crc_finish(png_ptr, length);\n1700\t         png_chunk_benign_error(png_ptr, \"invalid\");\n1701\t         return handled_error;\n1702\t      }\n1703\t\n1704\t      png_crc_read(png_ptr, buf, 2);\n1705\t      png_ptr->num_trans = 1;\n1706\t      png_ptr->trans_color.gray = png_get_uint_16(buf);\n1707\t   }\n1708\t\n1709\t   else if (png_ptr->color_type == PNG_COLOR_TYPE_RGB)\n1710\t   {\n1711\t      png_byte buf[6];\n1712\t\n1713\t      if (length != 6)\n1714\t      {\n1715\t         png_crc_finish(png_ptr, length);\n1716\t         png_chunk_benign_error(png_ptr, \"invalid\");\n1717\t         return handled_error;\n1718\t      }\n1719\t\n1720\t      png_crc_read(png_ptr, buf, length);\n1721\t      png_ptr->num_trans = 1;\n1722\t      png_ptr->trans_color.red = png_get_uint_16(buf);\n1723\t      png_ptr->trans_color.green = png_get_uint_16(buf + 2);\n1724\t      png_ptr->trans_color.blue = png_get_uint_16(buf + 4);\n1725\t   }\n1726\t\n1727\t   else if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n1728\t   {\n1729\t      if ((png_ptr->mode & PNG_HAVE_PLTE) == 0)\n1730\t      {\n1731\t         png_crc_finish(png_ptr, length);\n1732\t         png_chunk_benign_error(png_ptr, \"out of place\");\n1733\t         return handled_error;\n1734\t      }\n1735\t\n1736\t      if (length > (unsigned int) png_ptr->num_palette ||\n1737\t         length > (unsigned int) PNG_MAX_PALETTE_LENGTH ||\n1738\t         length == 0)\n1739\t      {\n1740\t         png_crc_finish(png_ptr, length);\n1741\t         png_chunk_benign_error(png_ptr, \"invalid\");\n1742\t         return handled_error;\n1743\t      }\n1744\t\n1745\t      png_crc_read(png_ptr, readbuf, length);\n1746\t      png_ptr->num_trans = (png_uint_16)length;\n1747\t   }\n1748\t\n1749\t   else\n1750\t   {\n1751\t      png_crc_finish(png_ptr, length);\n1752\t      png_chunk_benign_error(png_ptr, \"invalid with alpha channel\");\n1753\t      return handled_error;\n1754\t   }\n1755\t\n1756\t   if (png_crc_finish(png_ptr, 0) != 0)\n1757\t   {\n1758\t      png_ptr->num_trans = 0;\n1759\t      return handled_error;\n1760\t   }\n1761\t\n1762\t   png_set_tRNS(png_ptr, info_ptr, readbuf, png_ptr->num_trans,\n1763\t       &(png_ptr->trans_color));\n1764\t   return handled_ok;\n1765\t}\n1766\t#else\n1767\t#  define png_handle_tRNS NULL\n1768\t#endif\n1769\t\n1770\t#ifdef PNG_READ_bKGD_SUPPORTED\n1771\tstatic png_handle_result_code /* PRIVATE */\n1772\tpng_handle_bKGD(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1773\t{\n1774\t   unsigned int truelen;\n1775\t   png_byte buf[6];\n1776\t   png_color_16 background;\n1777\t\n1778\t   png_debug(1, \"in png_handle_bKGD\");\n1779\t\n1780\t   if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n1781\t   {\n1782\t      if ((png_ptr->mode & PNG_HAVE_PLTE) == 0)\n1783\t      {\n1784\t         png_crc_finish(png_ptr, length);\n1785\t         png_chunk_benign_error(png_ptr, \"out of place\");\n1786\t         return handled_error;\n1787\t      }\n1788\t\n1789\t      truelen = 1;\n1790\t   }\n1791\t\n1792\t   else if ((png_ptr->color_type & PNG_COLOR_MASK_COLOR) != 0)\n1793\t      truelen = 6;\n1794\t\n1795\t   else\n1796\t      truelen = 2;\n1797\t\n1798\t   if (length != truelen)\n1799\t   {\n1800\t      png_crc_finish(png_ptr, length);\n1801\t      png_chunk_benign_error(png_ptr, \"invalid\");\n1802\t      return handled_error;\n1803\t   }\n1804\t\n1805\t   png_crc_read(png_ptr, buf, truelen);\n1806\t\n1807\t   if (png_crc_finish(png_ptr, 0) != 0)\n1808\t      return handled_error;\n1809\t\n1810\t   /* We convert the index value into RGB components so that we can allow\n1811\t    * arbitrary RGB values for background when we have transparency, and\n1812\t    * so it is easy to determine the RGB values of the background color\n1813\t    * from the info_ptr struct.\n1814\t    */\n1815\t   if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n1816\t   {\n1817\t      background.index = buf[0];\n1818\t\n1819\t      if (info_ptr != NULL && info_ptr->num_palette != 0)\n1820\t      {\n1821\t         if (buf[0] >= info_ptr->num_palette)\n1822\t         {\n1823\t            png_chunk_benign_error(png_ptr, \"invalid index\");\n1824\t            return handled_error;\n1825\t         }\n1826\t\n1827\t         background.red = (png_uint_16)png_ptr->palette[buf[0]].red;\n1828\t         background.green = (png_uint_16)png_ptr->palette[buf[0]].green;\n1829\t         background.blue = (png_uint_16)png_ptr->palette[buf[0]].blue;\n1830\t      }\n1831\t\n1832\t      else\n1833\t         background.red = background.green = background.blue = 0;\n1834\t\n1835\t      background.gray = 0;\n1836\t   }\n1837\t\n1838\t   else if ((png_ptr->color_type & PNG_COLOR_MASK_COLOR) == 0) /* GRAY */\n1839\t   {\n1840\t      if (png_ptr->bit_depth <= 8)\n1841\t      {\n1842\t         if (buf[0] != 0 || buf[1] >= (unsigned int)(1 << png_ptr->bit_depth))\n1843\t         {\n1844\t            png_chunk_benign_error(png_ptr, \"invalid gray level\");\n1845\t            return handled_error;\n1846\t         }\n1847\t      }\n1848\t\n1849\t      background.index = 0;\n1850\t      background.red =\n1851\t      background.green =\n1852\t      background.blue =\n1853\t      background.gray = png_get_uint_16(buf);\n1854\t   }\n1855\t\n1856\t   else\n1857\t   {\n1858\t      if (png_ptr->bit_depth <= 8)\n1859\t      {\n1860\t         if (buf[0] != 0 || buf[2] != 0 || buf[4] != 0)\n1861\t         {\n1862\t            png_chunk_benign_error(png_ptr, \"invalid color\");\n1863\t            return handled_error;\n1864\t         }\n1865\t      }\n1866\t\n1867\t      background.index = 0;\n1868\t      background.red = png_get_uint_16(buf);\n1869\t      background.green = png_get_uint_16(buf + 2);\n1870\t      background.blue = png_get_uint_16(buf + 4);\n1871\t      background.gray = 0;\n1872\t   }\n1873\t\n1874\t   png_set_bKGD(png_ptr, info_ptr, &background);\n1875\t   return handled_ok;\n1876\t}\n1877\t#else\n1878\t#  define png_handle_bKGD NULL\n1879\t#endif\n1880\t\n1881\t#ifdef PNG_READ_cICP_SUPPORTED\n1882\tstatic png_handle_result_code /* PRIVATE */\n1883\tpng_handle_cICP(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1884\t{\n1885\t   png_byte buf[4];\n1886\t\n1887\t   png_debug(1, \"in png_handle_cICP\");\n1888\t\n1889\t   png_crc_read(png_ptr, buf, 4);\n1890\t\n1891\t   if (png_crc_finish(png_ptr, 0) != 0)\n1892\t      return handled_error;\n1893\t\n1894\t   png_set_cICP(png_ptr, info_ptr, buf[0], buf[1],  buf[2], buf[3]);\n1895\t\n1896\t   /* We only use 'chromaticities' for RGB to gray */\n1897\t#  ifdef PNG_READ_RGB_TO_GRAY_SUPPORTED\n1898\t      if (!png_has_chunk(png_ptr, mDCV))\n1899\t      {\n1900\t         /* TODO: png_ptr->chromaticities = chromaticities; */\n1901\t      }\n1902\t#  endif /* READ_RGB_TO_GRAY */\n1903\t\n1904\t#ifdef PNG_READ_GAMMA_SUPPORTED\n1905\t      /* PNGv3: chunk precedence for gamma is cICP, [iCCP], sRGB, gAMA.  cICP is\n1906\t       * at the head so simply set the gamma if it can be determined.  If not\n1907\t       * chunk_gamma remains unchanged; sRGB and gAMA handling check it for\n1908\t       * being zero.\n1909\t       */\n1910\t      /* TODO: set png_struct::chunk_gamma when possible */\n1911\t#endif /*READ_GAMMA*/\n1912\t\n1913\t   return handled_ok;\n1914\t   PNG_UNUSED(length)\n1915\t}\n1916\t#else\n1917\t#  define png_handle_cICP NULL\n1918\t#endif\n1919\t\n1920\t#ifdef PNG_READ_cLLI_SUPPORTED\n1921\tstatic png_handle_result_code /* PRIVATE */\n1922\tpng_handle_cLLI(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1923\t{\n1924\t   png_byte buf[8];\n1925\t\n1926\t   png_debug(1, \"in png_handle_cLLI\");\n1927\t\n1928\t   png_crc_read(png_ptr, buf, 8);\n1929\t\n1930\t   if (png_crc_finish(png_ptr, 0) != 0)\n1931\t      return handled_error;\n1932\t\n1933\t   /* The error checking happens here, this puts it in just one place: */\n1934\t   png_set_cLLI_fixed(png_ptr, info_ptr, png_get_uint_32(buf),\n1935\t         png_get_uint_32(buf+4));\n1936\t   return handled_ok;\n1937\t   PNG_UNUSED(length)\n1938\t}\n1939\t#else\n1940\t#  define png_handle_cLLI NULL\n1941\t#endif\n1942\t\n1943\t#ifdef PNG_READ_mDCV_SUPPORTED\n1944\tstatic png_handle_result_code /* PRIVATE */\n1945\tpng_handle_mDCV(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1946\t{\n1947\t   png_xy chromaticities;\n1948\t   png_byte buf[24];\n1949\t\n1950\t   png_debug(1, \"in png_handle_mDCV\");\n1951\t\n1952\t   png_crc_read(png_ptr, buf, 24);\n1953\t\n1954\t   if (png_crc_finish(png_ptr, 0) != 0)\n1955\t      return handled_error;\n1956\t\n1957\t   /* The error checking happens here, this puts it in just one place.  The\n1958\t    * odd /50000 scaling factor makes it more difficult but the (x.y) values are\n1959\t    * only two bytes so a <<1 is safe.\n1960\t    *\n1961\t    * WARNING: the PNG specification defines the cHRM chunk to **start** with\n1962\t    * the white point (x,y).  The W3C P