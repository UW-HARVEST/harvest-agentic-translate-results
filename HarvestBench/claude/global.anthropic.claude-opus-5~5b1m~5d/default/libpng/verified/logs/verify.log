 3) /* RGB */\n1898\t            {\n1899\t               palette[i].blue = (png_byte)PNG_sRGB_FROM_LINEAR(255 *\n1900\t                   entry[(2 ^ bgr)]);\n1901\t               palette[i].green = (png_byte)PNG_sRGB_FROM_LINEAR(255 *\n1902\t                   entry[1]);\n1903\t               palette[i].red = (png_byte)PNG_sRGB_FROM_LINEAR(255 *\n1904\t                   entry[bgr]);\n1905\t            }\n1906\t\n1907\t            else /* Gray */\n1908\t               palette[i].blue = palette[i].red = palette[i].green =\n1909\t                  (png_byte)PNG_sRGB_FROM_LINEAR(255 * *entry);\n1910\t         }\n1911\t\n1912\t         else /* alpha */\n1913\t         {\n1914\t            png_uint_16 alpha = entry[afirst ? 0 : channels-1];\n1915\t            png_byte alphabyte = (png_byte)PNG_DIV257(alpha);\n1916\t            png_uint_32 reciprocal = 0;\n1917\t\n1918\t            /* Calculate a reciprocal, as in the png_write_image_8bit code above\n1919\t             * this is designed to produce a value scaled to 255*65535 when\n1920\t             * divided by 128 (i.e. asr 7).\n1921\t             */\n1922\t            if (alphabyte > 0 && alphabyte < 255)\n1923\t               reciprocal = (((0xffff*0xff)<<7)+(alpha>>1))/alpha;\n1924\t\n1925\t            tRNS[i] = alphabyte;\n1926\t            if (alphabyte < 255)\n1927\t               num_trans = i+1;\n1928\t\n1929\t            if (channels >= 3) /* RGB */\n1930\t            {\n1931\t               palette[i].blue = png_unpremultiply(entry[afirst + (2 ^ bgr)],\n1932\t                   alpha, reciprocal);\n1933\t               palette[i].green = png_unpremultiply(entry[afirst + 1], alpha,\n1934\t                   reciprocal);\n1935\t               palette[i].red = png_unpremultiply(entry[afirst + bgr], alpha,\n1936\t                   reciprocal);\n1937\t            }\n1938\t\n1939\t            else /* gray */\n1940\t               palette[i].blue = palette[i].red = palette[i].green =\n1941\t                   png_unpremultiply(entry[afirst], alpha, reciprocal);\n1942\t         }\n1943\t      }\n1944\t\n1945\t      else /* Color-map has sRGB values */\n1946\t      {\n1947\t         png_const_bytep entry = png_voidcast(png_const_bytep, cmap);\n1948\t\n1949\t         entry += (unsigned int)i * channels;\n1950\t\n1951\t         switch (channels)\n1952\t         {\n1953\t            case 4:\n1954\t               tRNS[i] = entry[afirst ? 0 : 3];\n1955\t               if (tRNS[i] < 255)\n1956\t                  num_trans = i+1;\n1957\t               /* FALLTHROUGH */\n1958\t            case 3:\n1959\t               palette[i].blue = entry[afirst + (2 ^ bgr)];\n1960\t               palette[i].green = entry[afirst + 1];\n1961\t               palette[i].red = entry[afirst + bgr];\n1962\t               break;\n1963\t\n1964\t            case 2:\n1965\t               tRNS[i] = entry[1 ^ afirst];\n1966\t               if (tRNS[i] < 255)\n1967\t                  num_trans = i+1;\n1968\t               /* FALLTHROUGH */\n1969\t            case 1:\n1970\t               palette[i].blue = palette[i].red = palette[i].green =\n1971\t                  entry[afirst];\n1972\t               break;\n1973\t\n1974\t            default:\n1975\t               break;\n1976\t         }\n1977\t      }\n1978\t   }\n1979\t\n1980\t#   ifdef afirst\n1981\t#     undef afirst\n1982\t#   endif\n1983\t#   ifdef bgr\n1984\t#     undef bgr\n1985\t#   endif\n1986\t\n1987\t   png_set_PLTE(image->opaque->png_ptr, image->opaque->info_ptr, palette,\n1988\t       entries);\n1989\t\n1990\t   if (num_trans > 0)\n1991\t      png_set_tRNS(image->opaque->png_ptr, image->opaque->info_ptr, tRNS,\n1992\t          num_trans, NULL);\n1993\t\n1994\t   image->colormap_entries = (png_uint_32)entries;\n1995\t}\n1996\t\n1997\tstatic int\n1998\tpng_image_write_main(png_voidp argument)\n1999\t{\n2000\t   png_image_write_control *display = png_voidcast(png_image_write_control*,\n2001\t       argument);\n2002\t   png_imagep image = display->image;\n2003\t   png_structrp png_ptr = image->opaque->png_ptr;\n2004\t   png_inforp info_ptr = image->opaque->info_ptr;\n2005\t   png_uint_32 format = image->format;\n2006\t\n2007\t   /* The following four ints are actually booleans */\n2008\t   int colormap = (format & PNG_FORMAT_FLAG_COLORMAP);\n2009\t   int linear = !colormap && (format & PNG_FORMAT_FLAG_LINEAR); /* input */\n2010\t   int alpha = !colormap && (format & PNG_FORMAT_FLAG_ALPHA);\n2011\t   int write_16bit = linear && (display->convert_to_8bit == 0);\n2012\t\n2013\t#   ifdef PNG_BENIGN_ERRORS_SUPPORTED\n2014\t      /* Make sure we error out on any bad situation */\n2015\t      png_set_benign_errors(png_ptr, 0/*error*/);\n2016\t#   endif\n2017\t\n2018\t   /* Default the 'row_stride' parameter if required, also check the row stride\n2019\t    * and total image size to ensure that they are within the system limits.\n2020\t    */\n2021\t   {\n2022\t      unsigned int channels = PNG_IMAGE_PIXEL_CHANNELS(image->format);\n2023\t\n2024\t      if (image->width <= 0x7fffffffU/channels) /* no overflow */\n2025\t      {\n2026\t         png_uint_32 check;\n2027\t         png_uint_32 png_row_stride = image->width * channels;\n2028\t\n2029\t         if (display->row_stride == 0)\n2030\t            display->row_stride = (png_int_32)/*SAFE*/png_row_stride;\n2031\t\n2032\t         if (display->row_stride < 0)\n2033\t            check = -(png_uint_32)display->row_stride;\n2034\t\n2035\t         else\n2036\t            check = (png_uint_32)display->row_stride;\n2037\t\n2038\t         if (check >= png_row_stride)\n2039\t         {\n2040\t            /* Now check for overflow of the image buffer calculation; this\n2041\t             * limits the whole image size to 32 bits for API compatibility with\n2042\t             * the current, 32-bit, PNG_IMAGE_BUFFER_SIZE macro.\n2043\t             */\n2044\t            if (image->height > 0xffffffffU/png_row_stride)\n2045\t               png_error(image->opaque->png_ptr, \"memory image too large\");\n2046\t         }\n2047\t\n2048\t         else\n2049\t            png_error(image->opaque->png_ptr, \"supplied row stride too small\");\n2050\t      }\n2051\t\n2052\t      else\n2053\t         png_error(image->opaque->png_ptr, \"image row stride too large\");\n2054\t   }\n2055\t\n2056\t   /* Set the required transforms then write the rows in the correct order. */\n2057\t   if ((format & PNG_FORMAT_FLAG_COLORMAP) != 0)\n2058\t   {\n2059\t      if (display->colormap != NULL && image->colormap_entries > 0)\n2060\t      {\n2061\t         png_uint_32 entries = image->colormap_entries;\n2062\t\n2063\t         png_set_IHDR(png_ptr, info_ptr, image->width, image->height,\n2064\t             entries > 16 ? 8 : (entries > 4 ? 4 : (entries > 2 ? 2 : 1)),\n2065\t             PNG_COLOR_TYPE_PALETTE, PNG_INTERLACE_NONE,\n2066\t             PNG_COMPRESSION_TYPE_BASE, PNG_FILTER_TYPE_BASE);\n2067\t\n2068\t         png_image_set_PLTE(display);\n2069\t      }\n2070\t\n2071\t      else\n2072\t         png_error(image->opaque->png_ptr,\n2073\t             \"no color-map for color-mapped image\");\n2074\t   }\n2075\t\n2076\t   else\n2077\t      png_set_IHDR(png_ptr, info_ptr, image->width, image->height,\n2078\t          write_16bit ? 16 : 8,\n2079\t          ((format & PNG_FORMAT_FLAG_COLOR) ? PNG_COLOR_MASK_COLOR : 0) +\n2080\t          ((format & PNG_FORMAT_FLAG_ALPHA) ? PNG_COLOR_MASK_ALPHA : 0),\n2081\t          PNG_INTERLACE_NONE, PNG_COMPRESSION_TYPE_BASE, PNG_FILTER_TYPE_BASE);\n2082\t\n2083\t   /* Counter-intuitively the data transformations must be called *after*\n2084\t    * png_write_info, not before as in the read code, but the 'set' functions\n2085\t    * must still be called before.  Just set the color space information, never\n2086\t    * write an interlaced image.\n2087\t    */\n2088\t\n2089\t   if (write_16bit != 0)\n2090\t   {\n2091\t      /* The gamma here is 1.0 (linear) and the cHRM chunk matches sRGB. */\n2092\t      png_set_gAMA_fixed(png_ptr, info_ptr, PNG_GAMMA_LINEAR);\n2093\t\n2094\t      if ((image->flags & PNG_IMAGE_FLAG_COLORSPACE_NOT_sRGB) == 0)\n2095\t         png_set_cHRM_fixed(png_ptr, info_ptr,\n2096\t             /* color      x       y */\n2097\t             /* white */ 31270, 32900,\n2098\t             /* red   */ 64000, 33000,\n2099\t             /* green */ 30000, 60000,\n2100\t             /* blue  */ 15000,  6000\n2101\t         );\n2102\t   }\n2103\t\n2104\t   else if ((image->flags & PNG_IMAGE_FLAG_COLORSPACE_NOT_sRGB) == 0)\n2105\t      png_set_sRGB(png_ptr, info_ptr, PNG_sRGB_INTENT_PERCEPTUAL);\n2106\t\n2107\t   /* Else writing an 8-bit file and the *colors* aren't sRGB, but the 8-bit\n2108\t    * space must still be gamma encoded.\n2109\t    */\n2110\t   else\n2111\t      png_set_gAMA_fixed(png_ptr, info_ptr, PNG_GAMMA_sRGB_INVERSE);\n2112\t\n2113\t   /* Write the file header. */\n2114\t   png_write_info(png_ptr, info_ptr);\n2115\t\n2116\t   /* Now set up the data transformations (*after* the header is written),\n2117\t    * remove the handled transformations from the 'format' flags for checking.\n2118\t    *\n2119\t    * First check for a little endian system if writing 16-bit files.\n2120\t    */\n2121\t   if (write_16bit != 0)\n2122\t   {\n2123\t      png_uint_16 le = 0x0001;\n2124\t\n2125\t      if ((*(png_const_bytep) & le) != 0)\n2126\t         png_set_swap(png_ptr);\n2127\t   }\n2128\t\n2129\t#   ifdef PNG_SIMPLIFIED_WRITE_BGR_SUPPORTED\n2130\t      if ((format & PNG_FORMAT_FLAG_BGR) != 0)\n2131\t      {\n2132\t         if (colormap == 0 && (format & PNG_FORMAT_FLAG_COLOR) != 0)\n2133\t            png_set_bgr(png_ptr);\n2134\t         format &= ~PNG_FORMAT_FLAG_BGR;\n2135\t      }\n2136\t#   endif\n2137\t\n2138\t#   ifdef PNG_SIMPLIFIED_WRITE_AFIRST_SUPPORTED\n2139\t      if ((format & PNG_FORMAT_FLAG_AFIRST) != 0)\n2140\t      {\n2141\t         if (colormap == 0 && (format & PNG_FORMAT_FLAG_ALPHA) != 0)\n2142\t            png_set_swap_alpha(png_ptr);\n2143\t         format