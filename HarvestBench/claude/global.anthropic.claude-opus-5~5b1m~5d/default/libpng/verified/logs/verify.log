r(), h.as_ptr());\n                let r = (api.png_get_sCAL_s)(\n                    s.png,\n                    s.info,\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                );\n                eprintln!(\"  returned {}\", r);\n            }\n            4 => {\n                eprintln!(\"png_get_sCAL_fixed with all out-params NULL, sCAL valid\");\n                let w = cs(\"1\");\n                let h = cs(\"2\");\n                (api.png_set_sCAL_s)(s.png, s.info, 1, w.as_ptr(), h.as_ptr());\n                let r = (api.png_get_sCAL_fixed)(\n                    s.png,\n                    s.info,\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                    std::ptr::null_mut(),\n                );\n                eprintln!(\"  returned {}\", r);\n            }\n            5 => {\n                eprintln!(\"png_do_check_palette_indexes on a fresh struct (row_buf == NULL)\");\n                let mut ri = png_row_info {\n                    width: 8,\n                    rowbytes: 8,\n                    color_type: PNG_COLOR_TYPE_PALETTE as png_byte,\n                    bit_depth: 8,\n                    channels: 1,\n                    pixel_depth: 8,\n                };\n                (api.png_set_check_for_invalid_index)(s.png, 1);\n                (api.png_do_check_palette_indexes)(s.png, &mut ri);\n                eprintln!(\"  survived, max={}\", (api.png_get_palette_max)(s.png, s.info));\n            }\n            6 => {\n                eprintln!(\"png_get_sCAL (double) with all out-params NULL, sCAL valid\");\n                let w = cs(\"1\");\n                let h = cs(\"2\");\n                (api.png_set_sCAL_s)(s.png, s.info, 1, w.as_ptr(), h.as_ptr());\n                let r = (api.png_get_sCAL)(\n                    s.png,\n                    s.info,\n                    std::ptr::null_mut(),\n  