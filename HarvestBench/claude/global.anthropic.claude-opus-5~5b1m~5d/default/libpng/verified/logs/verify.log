4739\t         }\n4740\t      }\n4741\t      row_info->color_type = PNG_COLOR_TYPE_RGB_ALPHA;\n4742\t      row_info->channels = 4;\n4743\t      row_info->pixel_depth = (png_byte)(row_info->bit_depth << 2);\n4744\t      row_info->rowbytes = PNG_ROWBYTES(row_info->pixel_depth, row_width);\n4745\t   }\n4746\t}\n4747\t#endif\n4748\t\n4749\t#ifdef PNG_READ_EXPAND_16_SUPPORTED\n4750\t/* If the bit depth is 8 and the color type is not a palette type expand the\n4751\t * whole row to 16 bits.  Has no effect otherwise.\n4752\t */\n4753\tstatic void\n4754\tpng_do_expand_16(png_row_infop row_info, png_bytep row)\n4755\t{\n4756\t   if (row_info->bit_depth == 8 &&\n4757\t      row_info->color_type != PNG_COLOR_TYPE_PALETTE)\n4758\t   {\n4759\t      /* The row have a sequence of bytes containing [0..255] and we need\n4760\t       * to turn it into another row containing [0..65535], to do this we\n4761\t       * calculate:\n4762\t       *\n4763\t       *  (input / 255) * 65535\n4764\t       *\n4765\t       *  Which happens to be exactly input * 257 and this can be achieved\n4766\t       *  simply by byte replication in place (copying backwards).\n4767\t       */\n4768\t      png_byte *sp = row + row_info->rowbytes; /* source, last byte + 1 */\n4769\t      png_byte *dp = sp + row_info->rowbytes;  /* destination, end + 1 */\n4770\t      while (dp > sp)\n4771\t      {\n4772\t         dp[-2] = dp[-1] = *--sp; dp -= 2;\n4773\t      }\n4774\t\n4775\t      row_info->rowbytes *= 2;\n4776\t      row_info->bit_depth = 16;\n4777\t      row_info->pixel_depth = (png_byte)(row_info->channels * 16);\n4778\t   }\n4779\t}\n4780\t#endif\n4781\t\n4782\t#ifdef PNG_READ_QUANTIZE_SUPPORTED\n4783\tstatic void\n4784\tpng_do_quantize(png_row_infop row_info, png_bytep row,\n4785\t    png_const_bytep palette_lookup, png_const_bytep quantize_lookup)\n4786\t{\n4787\t   png_bytep sp, dp;\n4788\t   png_uint_32 i;\n4789\t   png_uint_32 row_width=row_info->width;\n4790\t\n4791\t   png_debug(1, \"in png_do_quantize\");\n4792\t\n4793\t   if (row_info->bit_depth == 8)\n4794\t   {\n4795\t      if (row_info->color_type == PNG_COLOR_TYPE_RGB && palette_lookup)\n4796\t      {\n4797\t         int r, g, b, p;\n4798\t         sp = row;\n4799\t         dp = row;\n4800\t         for (i = 0; i < row_width; i++)\n4801\t         {\n4802\t            r = *sp++;\n4803\t            g = *sp++;\n4804\t            b = *sp++;\n4805\t\n4806\t            /* This looks real messy, but the compiler will reduce\n4807\t             * it down to a reasonable formula.  For example, with\n4808\t             * 5 bits per color, we get:\n4809\t             * p = (((r >> 3) & 0x1f) << 10) |\n4810\t             *    (((g >> 3) & 0x1f) << 5) |\n4811\t             *    ((b >> 3) & 0x1f);\n4812\t             */\n4813\t            p = (((r >> (8 - PNG_QUANTIZE_RED_BITS)) &\n4814\t                ((1 << PNG_QUANTIZE_RED_BITS) - 1)) <<\n4815\t                (PNG_QUANTIZE_GREEN_BITS + PNG_QUANTIZE_BLUE_BITS)) |\n4816\t                (((g >> (8 - PNG_QUANTIZE_GREEN_BITS)) &\n4817\t                ((1 << PNG_QUANTIZE_GREEN_BITS) - 1)) <<\n4818\t                (PNG_QUANTIZE_BLUE_BITS)) |\n4819\t                ((b >> (8 - PNG_QUANTIZE_BLUE_BITS)) &\n4820\t                ((1 << PNG_QUANTIZE_BLUE_BITS) - 1));\n4821\t\n4822\t            *dp++ = palette_lookup[p];\n4823\t         }\n4824\t\n4825\t         row_info->color_type = PNG_COLOR_TYPE_PALETTE;\n4826\t         row_info->channels = 1;\n4827\t         row_info->pixel_depth = row_info->bit_depth;\n4828\t         row_info->rowbytes = PNG_ROWBYTES(row_info->pixel_depth, row_width);\n4829\t      }\n4830\t\n4831\t      else if (row_info->color_type == PNG_COLOR_TYPE_RGB_ALPHA &&\n4832\t         palette_lookup != NULL)\n4833\t      {\n4834\t         int r, g, b, p;\n4835\t         sp = row;\n4836\t         dp = row;\n4837\t         for (i = 0; i < row_width; i++)\n4838\t         {\n4839\t            r = *sp++;\n4840\t            g = *sp++;\n4841\t            b = *sp++;\n4842\t            sp++;\n4843\t\n4844\t            p = (((r >> (8 - PNG_QUANTIZE_RED_BITS)) &\n4845\t                ((1 << PNG_QUANTIZE_RED_BITS) - 1)) <<\n4846\t                (PNG_QUANTIZE_GREEN_BITS + PNG_QUANTIZE_BLUE_BITS)) |\n4847\t                (((g >> (8 - PNG_QUANTIZE_GREEN_BITS)) &\n4848\t                ((1 << PNG_QUANTIZE_GREEN_BITS) - 1)) <<\n4849\t                (PNG_QUANTIZE_BLUE_BITS)) |\n4850\t                ((b >> (8 - PNG_QUANTIZE_BLUE_BITS)) &\n4851\t                ((1 << PNG_QUANTIZE_BLUE_BITS) - 1));\n4852\t\n4853\t            *dp++ = palette_lookup[p];\n4854\t         }\n4855\t\n4856\t         row_info->color_type = PNG_COLOR_TYPE_PALETTE;\n4857\t         row_info->channels = 1;\n4858\t         row_info->pixel_depth = row_info->bit_depth;\n4859\t         row_info->rowbytes = PNG_ROWBYTES(row_info->pixel_depth, row_width);\n4860\t      }\n4861\t\n4862\t      else if (row_info->color_type == PNG_COLOR_TYPE_PALETTE &&\n4863\t         quantize_lookup)\n4864\t      {\n4865\t         sp = row;\n4866\t\n4867\t         for (i = 0; i < row_width; i++, sp++)\n4868\t         {\n4869\t            *sp = quantize_lookup[*sp];\n4870\t         }\n4871\t      }\n4872\t   }\n4873\t}\n4874\t#endif /* READ_QUANTIZE */\n4875\t\n4876\t/* Transform the row.  The order of transformations is significant,\n4877\t * and is very touchy.  If you add a transformation, take care to\n4878\t * decide how it fits in with the other transformations here.\n4879\t */\n4880\tvoid /* PRIVATE */\n4881\tpng_do_read_transformations(png_structrp png_ptr, png_row_infop row_info)\n4882\t{\n4883\t   png_debug(1, \"in png_do_read_transformations\");\n4884\t\n4885\t   if (png_ptr->row_buf == NULL)\n4886\t   {\n4887\t      /* Prior to 1.5.4 this output row/pass where the NULL pointer is, but this\n4888\t       * error is incredibly rare and incredibly easy to debug without this\n4889\t       * information.\n4890\t       */\n4891\t      png_error(png_ptr, \"NULL row buffer\");\n4892\t   }\n4893\t\n4894\t   /* The following is debugging; prior to 1.5.4 the code was never compiled in;\n4895\t    * in 1.5.4 PNG_FLAG_DETECT_UNINITIALIZED was added and the macro\n4896\t    * PNG_WARN_UNINITIALIZED_ROW removed.  In 1.6 the new flag is set only for\n4897\t    * all transformations, however in practice the ROW_INIT always gets done on\n4898\t    * demand, if necessary.\n4899\t    */\n4900\t   if ((png_ptr->flags & PNG_FLAG_DETECT_UNINITIALIZED) != 0 &&\n4901\t       (png_ptr->flags & PNG_FLAG_ROW_INIT) == 0)\n4902\t   {\n4903\t      /* Application has failed to call either png_read_start_image() or\n4904\t       * png_read_update_info() after setting transforms that expand pixels.\n4905\t       * This check added to libpng-1.2.19 (but not enabled until 1.5.4).\n4906\t       */\n4907\t      png_error(png_ptr, \"Uninitialized row\");\n4908\t   }\n4909\t\n4910\t#ifdef PNG_READ_EXPAND_SUPPORTED\n4911\t   if ((png_ptr->transformations & PNG_EXPAND) != 0)\n4912\t   {\n4913\t      if (row_info->color_type == PNG_COLOR_TYPE_PALETTE)\n4914\t      {\n4915\t#ifdef PNG_ARM_NEON_INTRINSICS_AVAILABLE\n4916\t         if ((png_ptr->num_trans > 0) && (png_ptr->bit_depth == 8))\n4917\t         {\n4918\t            if (png_ptr->riffled_palette == NULL)\n4919\t            {\n4920\t               /* Initialize the accelerated palette expansion. */\n4921\t               png_ptr->riffled_palette =\n4922\t                   (png_bytep)png_malloc(png_ptr, 256 * 4);\n4923\t               png_riffle_palette_neon(png_ptr);\n4924\t            }\n4925\t         }\n4926\t#endif\n4927\t         png_do_expand_palette(png_ptr, row_info, png_ptr->row_buf + 1,\n4928\t             png_ptr->palette, png_ptr->trans_alpha, png_ptr->num_trans);\n4929\t      }\n4930\t\n4931\t      else\n4932\t      {\n4933\t         if (png_ptr->num_trans != 0 &&\n4934\t             (png_ptr->transformations & PNG_EXPAND_tRNS) != 0)\n4935\t            png_do_expand(row_info, png_ptr->row_buf + 1,\n4936\t                &(png_ptr->trans_color));\n4937\t\n4938\t         else\n4939\t            png_do_expand(row_info, png_ptr->row_buf + 1, NULL);\n4940\t      }\n4941\t   }\n4942\t#endif\n4943\t\n4944\t#ifdef PNG_READ_STRIP_ALPHA_SUPPORTED\n4945\t   if ((png_ptr->transformations & PNG_STRIP_ALPHA) != 0 &&\n4946\t       (png_ptr->transformations & PNG_COMPOSE) == 0 &&\n4947\t       (row_info->color_type == PNG_COLOR_TYPE_RGB_ALPHA ||\n4948\t       row_info->color_type == PNG_COLOR_TYPE_GRAY_ALPHA))\n4949\t      png_do_strip_channel(row_info, png_ptr->row_buf + 1,\n4950\t          0 /* at_start == false, because SWAP_ALPHA happens later */);\n4951\t#endif\n4952\t\n4953\t#ifdef PNG_READ_RGB_TO_GRAY_SUPPORTED\n4954\t   if ((png_ptr->transformations & PNG_RGB_TO_GRAY) != 0)\n4955\t   {\n4956\t      int rgb_error =\n4957\t          png_do_rgb_to_gray(png_ptr, row_info,\n4958\t              png_ptr->row_buf + 1);\n4959\t\n4960\t      if (rgb_error != 0)\n4961\t      {\n4962\t         png_ptr->rgb_to_gray_status=1;\n4963\t         if ((png_ptr->transformations & PNG_RGB_TO_GRAY) ==\n4964\t             PNG_RGB_TO_GRAY_WARN)\n4965\t            png_warning(png_ptr, \"png_do_rgb_to_gray found nongray pixel\");\n4966\t\n4967\t         if ((png_ptr->transformations & PNG_RGB_TO_GRAY) ==\n4968\t             PNG_RGB_TO_GRAY_ERR)\n4969\t            png_error(png_ptr, \"png_do_rgb_to_gray found nongray pixel\");\n4970\t      }\n4971\t   }\n4972\t#endif\n4973\t\n4974\t/* From Andreas Dilger e-mail to png-implement, 26 March 1998:\n4975\t *\n4976\t *   In most cases, the \"simple transparency\" should be done prior to doing\n4977\t *   gray-to-RGB, or you will have to test 3x as many bytes to check if a\n4978\t *   pixel is transparent.  You would also need to make sure that the\n4979\t *   transparency information is upgraded to RGB.\n4980\t *\n4981\t *   To summarize, the current flow is:\n4982\t *   - Gray + simple transparency -> compare 1 or 2 gray bytes and composite\n4983\t *                                   with background \"in place\" if transparent,\n4984\t *                                   convert to RGB if necessary\n4985\t *   - Gray + alpha -> composite with gray background and remove alpha bytes,\n4986\t *                                   convert to RGB if necessary\n4987\t *\n4988\t *   To support RGB backgrounds for gray images we need:\n4989\t *   - Gray + simple transparency -> convert to RGB + simple transparency,\n4990\t *                                   compare 3 or 6 bytes and composite with\n4991\t *                                   background \"in place\" if transparent\n4992\t *                                   (3x compare/pixel compared to doing\n4993\t *                                   composite with gray bkgrnd)\n4994\t *   - Gray + alpha -> convert to RGB + alpha, composite with background and\n4995\t *                                   remove alpha bytes (3x float\n4996\t *                                   operations/pixel compared with composite\n4997\t *                                   on gray background)\n4998\t *\n4999\t *  Greg's change will do this.  The reason it wasn't done before is for\n5000\t *  performance, as this increases the per-pixel operations.  If we would check\n5001\t *  in advance if the background was gray or RGB, and position the gray-to-RGB\n5002\t *  transform appropriately, then it would save a lot of work/time.\n5003\t */\n5004\t\n5005\t#ifdef PNG_READ_GRAY_TO_RGB_SUPPORTED\n5006\t   /* If gray -> RGB, do so now only if background is non-gray; else do later\n5007\t    * for performance reasons\n5008\t    */\n5009\t   if ((png_ptr->transformations & PNG_GRAY_TO_RGB) != 0 &&\n5010\t       (png_ptr->mode & PNG_BACKGROUND_IS_GRAY) == 0)\n5011\t      png_do_gray_to_rgb(row_info, png_ptr->row_buf + 1);\n5012\t#endif\n5013\t\n5014\t#if defined(PNG_READ_BACKGROUND_SUPPORTED) ||\\\n5015\t   defined(PNG_READ_ALPHA_MODE_SUPPORTED)\n5016\t   if ((png_ptr->transformations & PNG_COMPOSE) != 0)\n5017\t      png_do_compose(row_info, png_ptr->row_buf + 1, png_ptr);\n5018\t#endif\n5019\t\n5020\t#ifdef PNG_READ_GAMMA_SUPPORTED\n5021\t   if ((png_ptr->transformations & PNG_GAMMA) != 0 &&\n5022\t#ifdef PNG_READ_RGB_TO_GRAY_SUPPORTED\n5023\t      /* Because RGB_TO_GRAY does the gamma transform. */\n5024\t      (png_ptr->transformations & PNG_RGB_TO_GRAY) == 0 &&\n5025\t#endif\n5026\t#if defined(PNG_READ_BACKGROUND_SUPPORTED) ||\\\n5027\t   defined(PNG_READ_ALPHA_MODE_SUPPORTED)\n5028\t      /* Because PNG_COMPOSE does the gamma transform if there is something to\n5029\t       * do (if there is an alpha channel or transparency.)\n5030\t       */\n5031\t       !((png_ptr->transformations & PNG_COMPOSE) != 0 &&\n5032\t       ((png_ptr->num_trans != 0) ||\n5033\t       (png_ptr->color_type & PNG_COLOR_MASK_ALPHA) != 0)) &&\n5034\t#endif\n5035\t      /* Because png_init_read_transformations transforms the palette, unless\n5036\t       * RGB_TO_GRAY will do the transform.\n5037\t       */\n5038\t       (png_ptr->color_type != PNG_COLOR_TYPE_PALETTE))\n5039\t      png_do_gamma(row_info, png_ptr->row_buf + 1, png_ptr);\n5040\t#endif\n5041\t\n5042\t#ifdef PNG_READ_STRIP_ALPHA_SUPPORTED\n5043\t   if ((png_ptr->transformations & PNG_STRIP_ALPHA) != 0 &&\n5044\t       (png_ptr->transformations & PNG_COMPOSE) != 0 &&\n5045\t       (row_info->color_type == PNG_COLOR_TYPE_RGB_ALPHA ||\n5046\t       row_info->color_type == PNG_COLOR_TYPE_GRAY_ALPHA))\n5047\t      png_do_strip_channel(row_info, png_ptr->row_buf + 1,\n5048\t          0 /* at_start == false, because SWAP_ALPHA happens later */);\n5049\t#endif\n5050\t\n5051\t#ifdef PNG_READ_ALPHA_MODE_SUPPORTED\n5052\t   if ((png_ptr->transformations & PNG_ENCODE_ALPHA) != 0 &&\n5053\t       (row_info->color_type & PNG_COLOR_MASK_ALPHA) != 0)\n5054\t      png_do_encode_alpha(row_info, png_ptr->row_buf + 1, png_ptr);\n5055\t#endif\n5056\t\n5057\t#ifdef PNG_READ_SCALE_16_TO_8_SUPPORTED\n5058\t   if ((png_ptr->transformations & PNG_SCALE_16_TO_8) != 0)\n5059\t      png_do_scale_16_to_8(row_info, png_ptr->row_buf + 1);\n5060\t#endif\n5061\t\n5062\t#ifdef PNG_READ_STRIP_16_TO_8_SUPPORTED\n5063\t   /* There is no harm in doing both of these because only one has any effect,\n5064\t    * by putting the 'scale' option first if the app asks for scale (either by\n5065\t    * calling the API or in a TRANSFORM flag) this is what happens.\n5066\t    */\n5067\t   if ((png_ptr->transformations & PNG_16_TO_8) != 0)\n5068\t      png_do_chop(row_info, png_ptr->row_buf + 1);\n5069\t#endif\n5070\t\n5071\t#ifdef PNG_READ_QUANTIZE_SUPPORTED\n5072\t   if ((png_ptr->transformations & PNG_QUANTIZE) != 0)\n5073\t      png_do_quantize(row_info, png_ptr->row_buf + 1,\n5074\t          png_ptr->palette_lookup, png_ptr->quantize_index);\n5075\t#endif /* READ_QUANTIZE */\n5076\t\n5077\t#ifdef PNG_READ_EXPAND_16_SUPPORTED\n5078\t   /* Do the expansion now, after all the arithmetic has been done.  Notice\n5079\t    * that previous transformations can handle the PNG_EXPAND_16 flag if this\n5080\t    * is efficient (particularly true in the case of gamma correction, where\n5081\t    * better accuracy results faster!)\n5082\t    */\n5083\t   if ((png_ptr->transformations & PNG_EXPAND_16) != 0)\n5084\t      png_do_expand_16(row_info, png_ptr->row_buf + 1);\n5085\t#endif\n5086\t\n5087\t#ifdef PNG_READ_GRAY_TO_RGB_SUPPORTED\n5088\t   /* NOTE: moved here in 1.5.4 (from much later in this list.) */\n5089\t   if ((png_ptr->transformations & PNG_GRAY_TO_RGB) != 0 &&\n5090\t       (png_ptr->mode & PNG_BACKGROUND_IS_GRAY) != 0)\n5091\t      png_do_gray_to_rgb(row_info, png_ptr->row_buf + 1);\n5092\t#endif\n5093\t\n5094\t#ifdef PNG_READ_INVERT_SUPPORTED\n5095\t   if ((png_ptr->transformations & PNG_INVERT_MONO) != 0)\n5096\t      png_do_invert(row_info, png_ptr->row_buf + 1);\n5097\t#endif\n5098\t\n5099\t#ifdef PNG_READ_INVERT_ALPHA_SUPPORTED\n5100\t   if ((png_ptr->transformations & PNG_INVERT_ALPHA) != 0)\n5101\t      png_do_read_invert_alpha(row_info, png_ptr->row_buf + 1);\n5102\t#endif\n5103\t\n5104\t#ifdef PNG_READ_SHIFT_SUPPORTED\n5105\t   if ((png_ptr->transformations & PNG_SHIFT) != 0)\n5106\t      png_do_unshift(row_info, png_ptr->row_buf + 1,\n5107\t          &(png_ptr->shift));\n5108\t#endif\n5109\t\n5110\t#ifdef PNG_READ_PACK_SUPPORTED\n5111\t   if ((png_ptr->transformations & PNG_PACK) != 0)\n5112\t      png_do_unpack(row_info, png_ptr->row_buf + 1);\n5113\t#endif\n5114\t\n5115\t#ifdef PNG_READ_CHECK_FOR_INVALID_INDEX_SUPPORTED\n5116\t   /* Added at libpng-1.5.10 */\n5117\t   if (row_info->color_type == PNG_COLOR_TYPE_PALETTE &&\n5118\t       png_ptr->num_palette_max >= 0)\n5119\t      png_do_check_palette_indexes(png_ptr, row_info);\n5120\t#endif\n5121\t\n5122\t#ifdef PNG_READ_BGR_SUPPORTED\n5123\t   if ((png_ptr->transformations & PNG_BGR) != 0)\n5124\t      png_do_bgr(row_info, png_ptr->row_buf + 1);\n5125\t#endif\n5126\t\n5127\t#ifdef PNG_READ_PACKSWAP_SUPPORTED\n5128\t   if ((png_ptr->transformations & PNG_PACKSWAP) != 0)\n5129\t      png_do_packswap(row_info, png_ptr->row_buf + 1);\n5130\t#endif\n5131\t\n5132\t#ifdef PNG_READ_FILLER_SUPPORTED\n5133\t   if ((png_ptr->transformations & PNG_FILLER) != 0)\n5134\t      png_do_read_filler(row_info, png_ptr->row_buf + 1,\n5135\t          (png_uint_32)png_ptr->filler, png_ptr->flags);\n5136\t#endif\n5137\t\n5138\t#ifdef PNG_READ_SWAP_ALPHA_SUPPORTED\n5139\t   if ((png_ptr->transformations & PNG_SWAP_ALPHA) != 0)\n5140\t      png_do_read_swap_alpha(row_info, png_ptr->row_buf + 1);\n5141\t#endif\n5142\t\n5143\t#ifdef PNG_READ_16BIT_SUPPORTED\n5144\t#ifdef PNG_READ_SWAP_SUPPORTED\n5145\t   if ((png_ptr->transformations & PNG_SWAP_BYTES) != 0)\n5146\t      png_do_swap(row_info, png_ptr->row_buf + 1);\n5147\t#endif\n5148\t#endif\n5149\t\n5150\t#ifdef PNG_READ_USER_TRANSFORM_SUPPORTED\n5151\t   if ((png_ptr->transformations & PNG_USER_TRANSFORM) != 0)\n5152\t   {\n5153\t      if (png_ptr->read_user_transform_fn != NULL)\n5154\t         (*(png_ptr->read_user_transform_fn)) /* User read transform function */\n5155\t             (png_ptr,     /* png_ptr */\n5156\t             row_info,     /* row_info: */\n5157\t                /*  png_uint_32 width;       width of row */\n5158\t                /*  size_t rowbytes;         number of bytes in row */\n5159\t                /*  png_byte color_type;     color type of pixels */\n5160\t                /*  png_byte bit_depth;      bit depth of samples */\n5161\t                /*  png_byte channels;       number of channels (1-4) */\n5162\t                /*  png_byte pixel_depth;    bits per pixel (depth*channels) */\n5163\t             png_ptr->row_buf + 1);    /* start of pixel data for row */\n5164\t#ifdef PNG_USER_TRANSFORM_PTR_SUPPORTED\n5165\t      if (png_ptr->user_transform_depth != 0)\n5166\t         row_info->bit_depth = png_ptr->user_transform_depth;\n5167\t\n5168\t      if (png_ptr->user_transform_channels != 0)\n5169\t         row_info->channels = png_ptr->user_transform_channels;\n5170\t#endif\n5171\t      row_info->pixel_depth = (png_byte)(row_info->bit_depth *\n5172\t          row_info->channels);\n5173\t\n5174\t      row_info->rowbytes = PNG_ROWBYTES(row_info->pixel_depth, row_info->width);\n5175\t   }\n5176\t#endif\n5177\t}\n5178\t\n5179\t#endif /* READ_TRANSFORMS */\n5180\t#endif /* READ */"}]},"parent_tool_use_id":"toolu_bdrk_013rZ7DnCJmPpBHECeNw5mRy","session_id":"e3091878-9949-4689-ad83-c0c41e6641a2","uuid":"28dcc093-0887-4560-9ee4-b1ff6be582bc","timestamp":"2026-08-31T13:15:43.613Z","subagent_type":"general-purpose","task_description":"ERRORS.md part 3"}
