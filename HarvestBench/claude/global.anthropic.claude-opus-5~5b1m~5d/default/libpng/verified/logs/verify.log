{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YAGD3UD6sRGwNTpag91dMJ","type":"tool_result","content":"1\t//! Phase B — CONFIGS.md section A: the low-level sequential WRITE pipeline\n2\t//! (`png_create_write_struct` .. `png_write_end`) driven end to end, with the\n3\t//! produced PNG byte stream compared byte-for-byte between the two `.so`s.\n4\tmod common;\n5\tuse common::*;\n6\tuse std::ffi::CString;\n7\t\n8\t#[derive(Clone, Debug)]\n9\tpub enum W {\n10\t    Bgr,\n11\t    Swap,\n12\t    SwapAlpha,\n13\t    InvertAlpha,\n14\t    InvertMono,\n15\t    Packing,\n16\t    PackSwap,\n17\t    Shift(png_color_8),\n18\t    Filler(u32, c_int),\n19\t    Filter(c_int),\n20\t    FilterHeuristics(c_int, Vec<f64>, Vec<f64>),\n21\t    FilterHeuristicsFixed(c_int, Vec<i32>, Vec<i32>),\n22\t    Level(c_int),\n23\t    MemLevel(c_int),\n24\t    Strategy(c_int),\n25\t    WindowBits(c_int),\n26\t    Method(c_int),\n27\t    BufferSize(usize),\n28\t    TextLevel(c_int),\n29\t    TextMemLevel(c_int),\n30\t    TextStrategy(c_int),\n31\t    TextWindowBits(c_int),\n32\t    TextMethod(c_int),\n33\t    FlushEvery(c_int),\n34\t    SigBit(png_color_8),\n35\t    Gamma(f64),\n36\t    GammaFixed(i32),\n37\t    Srgb(c_int),\n38\t    SrgbGamaChrm(c_int),\n39\t    Chrm([f64; 8]),\n40\t    ChrmFixed([i32; 8]),\n41\t    ChrmXyz([f64; 9]),\n42\t    ChrmXyzFixed([i32; 9]),\n43\t    Iccp(String, Vec<u8>),\n44\t    Trns(Vec<u8>, png_color_16, c_int),\n45\t    Bkgd(png_color_16),\n46\t    Hist(Vec<u16>),\n47\t    Phys(u32, u32, c_int),\n48\t    Offs(i32, i32, c_int),\n49\t    Scal(c_int, f64, f64),\n50\t    ScalFixed(c_int, i32, i32),\n51\t    ScalS(c_int, String, String),\n52\t    PCal(String, i32, i32, c_int, Vec<String>, String),\n53\t    Time(png_time),\n54\t    Text(Vec<(c_int, String, String, Option<(String, String)>)>),\n55\t    Splt(String, u8, Vec<png_sPLT_entry>),\n56\t    Exif(Vec<u8>),\n57\t    Cicp(u8, u8, u8, u8),\n58\t    Clli(u32, u32),\n59\t    ClliFixed(u32, u32),\n60\t    Mdcv([f64; 8], f64, f64),\n61\t    MdcvFixed([i32; 8], u32, u32),\n62\t    Unknown(Vec<png_unknown_chunk>, Vec<Vec<u8>>, c_int),\n63\t    MngFeatures(u32),\n64\t    CheckInvalidIndex(c_int),\n65\t    Benign(c_int),\n66\t    Option(c_int, c_int),\n67\t}\n68\t\n69\tpub struct Img {\n70\t    pub width: u32,\n71\t    pub height: u32,\n72\t    pub bit_depth: c_int,\n73\t    pub color_type: c_int,\n74\t    pub interlace: c_int,\n75\t    pub palette: Vec<png_color>,\n76\t    pub rows: Vec<Vec<u8>>,\n77\t}\n78\t\n79\timpl Img {\n80\t    fn gen(rng: &mut Rng, color_type: c_int, bit_depth: c_int, w: u32, h: u32, interlace: c_int) -> Img {\n81\t        let pd = channels_of(color_type) * bit_depth as u32;\n82\t        // Rows are over-allocated: some write transforms (png_set_filler /\n83\t        // png_set_packing) make libpng consume MORE application bytes per row\n84\t        // than PNG_ROWBYTES of the stored format.  Over-allocating keeps the\n85\t        // bytes libpng reads deterministic and identical for both libraries.\n86\t        let rb = rowbytes(pd, w)\n87\t            .max(rowbytes(4 * bit_depth as u32, w))\n88\t            .max(w as usize * 4)\n89\t            + 16;\n90\t        let rows = (0..h).map(|_| rng.bytes(rb)).collect();\n91\t        let npal = if color_type == PNG_COLOR_TYPE_PALETTE {\n92\t            1usize << bit_depth\n93\t        } else {\n94\t            0\n95\t        };\n96\t        let palette = (0..npal)\n97\t            .map(|_| png_color {\n98\t                red: rng.u8(),\n99\t                green: rng.u8(),\n100\t                blue: rng.u8(),\n101\t            })\n102\t            .collect();\n103\t        Img {\n104\t            width: w,\n105\t            height: h,\n106\t            bit_depth,\n107\t            color_type,\n108\t            interlace,\n109\t            palette,\n110\t            rows,\n111\t        }\n112\t    }\n113\t}\n114\t\n115\t/// How the rows are handed to libpng.\n116\t#[derive(Clone, Copy, Debug, PartialEq)]\n117\tpub enum RowMode {\n118\t    /// png_write_row, one row at a time (interlace handled by libpng passes)\n119\t    Row,\n120\t    /// png_write_rows with all rows at once\n121\t    Rows,\n122\t    /// png_write_image with a row-pointer array\n123\t    Image,\n124\t    /// png_write_png one-shot with the given transform mask\n125\t    OneShot(c_int),\n126\t}\n127\t\n128\tpub struct Out {\n129\t    pub bytes: Vec<u8>,\n130\t    pub diag: Diag,\n131\t    pub ok: bool,\n132\t    pub flushes: u32,\n133\t}\n134\t\n135\timpl PartialEq for Out {\n136\t    fn eq(&self, o: &Out) -> bool {\n137\t        self.bytes == o.bytes && self.diag == o.diag && self.ok == o.ok && self.flushes == o.flushes\n138\t    }\n139\t}\n140\t\n141\t/// Keeps the CStrings/vectors used by the setters alive for the whole call.\n142\t#[derive(Default)]\n143\tstruct Keep {\n144\t    cstrings: Vec<CString>,\n145\t    bytes: Vec<Vec<u8>>,\n146\t    texts: Vec<png_text>,\n147\t    splts: Vec<png_sPLT_t>,\n148\t    entries: Vec<Vec<png_sPLT_entry>>,\n149\t    chunks: Vec<png_unknown_chunk>,\n150\t    charps: Vec<Vec<png_charp>>,\n151\t    u16s: Vec<Vec<u16>>,\n152\t}\n153\t\n154\tunsafe fn apply(api: &'static Api, png: png_structp, info: png_infop, opts: &[W], keep: &mut Keep) {\n155\t    for o in opts {\n156\t        match o {\n157\t            W::Bgr => (api.png_set_bgr)(png),\n158\t            W::Swap => (api.png_set_swap)(png),\n159\t            W::SwapAlpha => (api.png_set_swap_alpha)(png),\n160\t            W::InvertAlpha => (api.png_set_invert_alpha)(png),\n161\t            W::InvertMono => (api.png_set_invert_mono)(png),\n162\t            W::Packing => (api.png_set_packing)(png),\n163\t            W::PackSwap => (api.png_set_packswap)(png),\n164\t            W::Shift(s) => (api.png_set_shift)(png, s),\n165\t            W::Filler(v, loc) => (api.png_set_filler)(png, *v, *loc),\n166\t            W::Filter(f) => (api.png_set_filter)(png, PNG_FILTER_TYPE_BASE, *f),\n167\t            W::FilterHeuristics(m, w, c) => {\n168\t                (api.png_set_filter_heuristics)(\n169\t                    png,\n170\t                    *m,\n171\t                    w.len() as c_int,\n172\t                    w.as_ptr() as png_const_doublep,\n173\t                    c.as_ptr() as png_const_doublep,\n174\t                );\n175\t            }\n176\t            W::FilterHeuristicsFixed(m, w, c) => {\n177\t                (api.png_set_filter_heuristics_fixed)(\n178\t                    png,\n179\t                    *m,\n180\t                    w.len() as c_int,\n181\t                    w.as_ptr(),\n182\t                    c.as_ptr(),\n183\t                );\n184\t            }\n185\t            W::Level(v) => (api.png_set_compression_level)(png, *v),\n186\t            W::MemLevel(v) => (api.png_set_compression_mem_level)(png, *v),\n187\t            W::Strategy(v) => (api.png_set_compression_strategy)(png, *v),\n188\t            W::WindowBits(v) => (api.png_set_compression_window_bits)(png, *v),\n189\t            W::Method(v) => (api.png_set_compression_method)(png, *v),\n190\t            W::BufferSize(v) => (api.png_set_compression_buffer_size)(png, *v),\n191\t            W::TextLevel(v) => (api.png_set_text_compression_level)(png, *v),\n192\t            W::TextMemLevel(v) => (api.png_set_text_compression_mem_level)(png, *v),\n193\t            W::TextStrategy(v) => (api.png_set_text_compression_strategy)(png, *v),\n194\t            W::TextWindowBits(v) => (api.png_set_text_compression_window_bits)(png, *v),\n195\t            W::TextMethod(v) => (api.png_set_text_compression_method)(png, *v),\n196\t            W::FlushEvery(n) => (api.png_set_flush)(png, *n),\n197\t            W::SigBit(s) => (api.png_set_sBIT)(png, info, s),\n198\t            W::Gamma(g) => (api.png_set_gAMA)(png, info, *g),\n199\t            W::GammaFixed(g) => (api.png_set_gAMA_fixed)(png, info, *g),\n200\t            W::Srgb(i) => (api.png_set_sRGB)(png, info, *i),\n201\t            W::SrgbGamaChrm(i) => (api.png_set_sRGB_gAMA_and_cHRM)(png, info, *i),\n202\t            W::Chrm(v) => (api.png_set_cHRM)(\n203\t                png, info, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7],\n204\t            ),\n205\t            W::ChrmFixed(v) => (api.png_set_cHRM_fixed)(\n206\t                png, info, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7],\n207\t            ),\n208\t            W::ChrmXyz(v) => (api.png_set_cHRM_XYZ)(\n209\t                png, info, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8],\n210\t            ),\n211\t            W::ChrmXyzFixed(v) => (api.png_set_cHRM_XYZ_fixed)(\n212\t                png, info, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8],\n213\t            ),\n214\t            W::Iccp(name, prof) => {\n215\t                let n = cs(name);\n216\t                keep.bytes.push(prof.clone());\n217\t                let p = keep.bytes.last().unwrap().as_ptr();\n218\t                let len = prof.len() as png_uint_32;\n219\t                keep.cstrings.push(n);\n220\t                (api.png_set_iCCP)(\n221\t                    png,\n222\t                    info,\n223\t                    keep.cstrings.last().unwrap().as_ptr(),\n224\t                    0,\n225\t                    p,\n226\t                    len,\n227\t                );\n228\t            }\n229\t            W::Trns(alpha, col, num) => {\n230\t                keep.bytes.push(alpha.clone());\n231\t                let a = if alpha.is_empty() {\n232\t                    std::ptr::null_mut()\n233\t                } else {\n234\t                    keep.bytes.last().unwrap().as_ptr() as png_bytep\n235\t                };\n236\t                (api.png_set_tRNS)(png, info, a, *num, col as *const _ as png_color_16p);\n237\t            }\n238\t            W::Bkgd(b) => (api.png_set_bKGD)(png, info, b as *const _ as png_const_color_16p),\n239\t            W::Hist(h) => {\n240\t                keep.u16s.push(h.clone());\n241\t                (api.png_set_hIST)(png, info, keep.u16s.last().unwrap().as_ptr());\n242\t            }\n243\t            W::Phys(x, y, u) => (api.png_set_pHYs)(png, info, *x, *y, *u),\n244\t            W::Offs(x, y, u) => (api.png_set_oFFs)(png, info, *x, *y, *u),\n245\t            W::Scal(u, w, h) => (api.png_set_sCAL)(png, info, *u, *w, *h),\n246\t            W::ScalFixed(u, w, h) => (api.png_set_sCAL_fixed)(png, info, *u, *w, *h),\n247\t            W::ScalS(u, w, h) => {\n248\t                keep.cstrings.push(cs(w));\n249\t                let wp = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n250\t                keep.cstrings.push(cs(h));\n251\t                let hp = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n252\t                (api.png_set_sCAL_s)(png, info, *u, wp, hp);\n253\t            }\n254\t            W::PCal(purpose, x0, x1, typ, params, units) => {\n255\t                keep.cstrings.push(cs(purpose));\n256\t                let pp = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n257\t                keep.cstrings.push(cs(units));\n258\t                let up = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n259\t                let mut ptrs: Vec<png_charp> = Vec::new();\n260\t                for p in params {\n261\t                    keep.cstrings.push(cs(p));\n262\t                    ptrs.push(keep.cstrings.last().unwrap().as_ptr() as png_charp);\n263\t                }\n264\t                keep.charps.push(ptrs);\n265\t                let pa = keep.charps.last().unwrap();\n266\t                (api.png_set_pCAL)(\n267\t                    png,\n268\t                    info,\n269\t                    pp,\n270\t                    *x0,\n271\t                    *x1,\n272\t                    *typ,\n273\t                    pa.len() as c_int,\n274\t                    up,\n275\t                    if pa.is_empty() {\n276\t                        std::ptr::null_mut()\n277\t                    } else {\n278\t                        pa.as_ptr() as png_charpp\n279\t                    },\n280\t                );\n281\t            }\n282\t            W::Time(t) => (api.png_set_tIME)(png, info, t as *const _ as png_const_timep),\n283\t            W::Text(items) => {\n284\t                let base = keep.texts.len();\n285\t                for (comp, key, text, lang) in items {\n286\t                    keep.cstrings.push(cs(key));\n287\t                    let k = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n288\t                    keep.cstrings.push(cs(text));\n289\t                    let t = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n290\t                    let (l, lk) = match lang {\n291\t                        Some((l, lk)) => {\n292\t                            keep.cstrings.push(cs(l));\n293\t                            let a = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n294\t                            keep.cstrings.push(cs(lk));\n295\t                            let b = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n296\t                            (a, b)\n297\t                        }\n298\t                        None => (std::ptr::null_mut(), std::ptr::null_mut()),\n299\t                    };\n300\t                    keep.texts.push(png_text {\n301\t                        compression: *comp,\n302\t                        key: k,\n303\t                        text: t,\n304\t                        text_length: text.len(),\n305\t                        itxt_length: 0,\n306\t                        lang: l,\n307\t                        lang_key: lk,\n308\t                    });\n309\t                }\n310\t                let n = keep.texts.len() - base;\n311\t                (api.png_set_text)(png, info, keep.texts.as_ptr().add(base), n as c_int);\n312\t            }\n313\t            W::Splt(name, depth, entries) => {\n314\t                keep.cstrings.push(cs(name));\n315\t                let n = keep.cstrings.last().unwrap().as_ptr() as png_charp;\n316\t                keep.entries.push(entries.clone());\n317\t                let e = keep.entries.last().unwrap();\n318\t                keep.splts.push(png_sPLT_t {\n319\t                    name: n,\n320\t                    depth: *depth,\n321\t                    entries: e.as_ptr() as png_sPLT_entryp,\n322\t                    nentries: e.len() as png_int_32,\n323\t                });\n324\t                (api.png_set_sPLT)(png, info, keep.splts.last().unwrap(), 1);\n325\t            }\n326\t            W::Exif(e) => {\n327\t                keep.bytes.push(e.clone());\n328\t                (api.png_set_eXIf_1)(\n329\t                    png,\n330\t                    info,\n331\t                    e.len() as png_uint_32,\n332\t                    keep.bytes.last().unwrap().as_ptr() as png_bytep,\n333\t                );\n334\t            }\n335\t            W::Cicp(a, b, c_, d) => (api.png_set_cICP)(png, info, *a, *b, *c_, *d),\n336\t            W::Clli(a, b) => (api.png_set_cLLI)(png, info, *a as f64 / 10000.0, *b as f64 / 10000.0),\n337\t            W::ClliFixed(a, b) => (api.png_set_cLLI_fixed)(png, info, *a, *b),\n338\t            W::Mdcv(xy, a, b) => (api.png_set_mDCV)(\n339\t                png, info, xy[0], xy[1], xy[2], xy[3], xy[4], xy[5], xy[6], xy[7], *a, *b,\n340\t            ),\n341\t            W::MdcvFixed(xy, a, b) => (api.png_set_mDCV_fixed)(\n342\t                png, info, xy[0], xy[1], xy[2], xy[3], xy[4], xy[5], xy[6], xy[7], *a, *b,\n343\t            ),\n344\t            W::Unknown(chunks, datas, loc) => {\n345\t                let base = keep.chunks.len();\n346\t                for (i, ch) in chunks.iter().enumerate() {\n347\t                    keep.bytes.push(datas[i].clone());\n348\t                    let d = keep.bytes.last().unwrap().as_ptr() as *mut png_byte;\n349\t                    keep.chunks.push(png_unknown_chunk {\n350\t                        name: ch.name,\n351\t                        data: d,\n352\t                        size: datas[i].len(),\n353\t                        location: ch.location,\n354\t                    });\n355\t                }\n356\t                let n = keep.chunks.len() - base;\n357\t                (api.png_set_unknown_chunks)(\n358\t                    png,\n359\t                    info,\n360\t                    keep.chunks.as_ptr().add(base),\n361\t                    n as c_int,\n362\t                );\n363\t                for i in 0..n {\n364\t                    (api.png_set_unknown_chunk_location)(png, info, i as c_int, *loc);\n365\t                }\n366\t            }\n367\t            W::MngFeatures(f) => {\n368\t                (api.png_permit_mng_features)(png, *f);\n369\t            }\n370\t            W::CheckInvalidIndex(v) => (api.png_set_check_for_invalid_index)(png, *v),\n371\t            W::Benign(v) => (api.png_set_benign_errors)(png, *v),\n372\t            W::Option(o, v) => {\n373\t                (api.png_set_option)(png, *o, *v);\n374\t            }\n375\t        }\n376\t    }\n377\t}\n378\t\n379\t/// Which options must be applied *before* png_write_info (they set info fields\n380\t/// serialised into the header) and which after (pure row transforms).\n381\tfn is_pre_info(o: &W) -> bool {\n382\t    !matches!(\n383\t        o,\n384\t        W::Bgr\n385\t            | W::Swap\n386\t            | W::SwapAlpha\n387\t            | W::InvertAlpha\n388\t            | W::InvertMono\n389\t            | W::Packing\n390\t            | W::PackSwap\n391\t            | W::Shift(_)\n392\t            | W::Filler(..)\n393\t    )\n394\t}\n395\t\n396\tpub unsafe fn write_png(api: &'static Api, img: &Img, opts: &[W], mode: RowMode) -> Out {\n397\t    set_current_api(api);\n398\t    diag_reset();\n399\t    let mut sess = WriteSess::new(api);\n400\t    let png = sess.png;\n401\t    let info = sess.info;\n402\t    let mut keep = Keep::default();\n403\t    let ok = guard(|| {\n404\t        (api.png_set_IHDR)(\n405\t            png,\n406\t            info,\n407\t            img.width,\n408\t            img.height,\n409\t            img.bit_depth,\n410\t            img.color_type,\n411\t            img.interlace,\n412\t            PNG_COMPRESSION_TYPE_BASE,\n413\t            PNG_FILTER_TYPE_BASE,\n414\t        );\n415\t        if !img.palette.is_empty() {\n416\t            (api.png_set_PLTE)(\n417\t                png,\n418\t                info,\n419\t                img.palette.as_ptr(),\n420\t                img.palette.len() as c_int,\n421\t            );\n422\t        }\n423\t        let pre: Vec<W> = opts.iter().filter(|o| is_pre_info(o)).cloned().collect();\n424\t        let post: Vec<W> = opts.iter().filter(|o| !is_pre_info(o)).cloned().collect();\n425\t        apply(api, png, info, &pre, &mut keep);\n426\t\n427\t        match mode {\n428\t            RowMode::OneShot(t) => {\n429\t                let mut rowps: Vec<png_bytep> =\n430\t                    img.rows.iter().map(|r| r.as_ptr() as png_bytep).collect();\n431\t                (api.png_set_rows)(png, info, rowps.as_mut_ptr());\n432\t                apply(api, png, info, &post, &mut keep);\n433\t                (api.png_write_png)(png, info, t, std::ptr::null_mut());\n434\t            }\n435\t            _ => {\n436\t                (api.png_write_info)(png, info);\n437\t                apply(api, png, info, &post, &mut keep);\n438\t                let npasses = if img.interlace == PNG_INTERLACE_ADAM7 {\n439\t                    (api.png_set_interlace_handling)(png)\n440\t                } else {\n441\t                    1\n442\t                };\n443\t                match mode {\n444\t                    RowMode::Row => {\n445\t                        for _ in 0..npasses {\n446\t                            for r in &img.rows {\n447\t                                (api.png_write_row)(png, r.as_ptr());\n448\t                            }\n449\t                        }\n450\t                    }\n451\t                    RowMode::Rows => {\n452\t                        let mut rowps: Vec<png_bytep> =\n453\t                            img.rows.iter().map(|r| r.as_ptr() as png_bytep).collect();\n454\t                        for _ in 0..npasses {\n455\t                            (api.png_write_rows)(\n456\t                                png,\n457\t                                rowps.as_mut_ptr(),\n458\t                                img.rows.len() as png_uint_32,\n459\t                            );\n460\t                        }\n461\t                    }\n462\t                    RowMode::Image => {\n463\t                        let mut rowps: Vec<png_bytep> =\n464\t                            img.rows.iter().map(|r| r.as_ptr() as png_bytep).collect();\n465\t                        (api.png_write_image)(png, rowps.as_mut_ptr());\n466\t                    }\n467\t                    RowMode::OneShot(_) => unreachable!(),\n468\t                }\n469\t                (api.png_write_end)(png, info);\n470\t            }\n471\t        }\n472\t    })\n473\t    .is_some();\n474\t    let diag = diag_take();\n475\t    let bytes = std::mem::take(&mut sess.sink.buf);\n476\t    let flushes = sess.sink.flushes;\n477\t    drop(keep);\n478\t    Out {\n479\t        bytes,\n480\t        diag,\n481\t        ok,\n482\t        flushes,\n483\t    }\n484\t}\n485\t\n486\tfn diff(label: &str, img: &Img, opts: &[W], mode: RowMode) {\n487\t    unsafe {\n488\t        let co = write_png(c_api(), img, opts, mode);\n489\t        let ro = write_png(rs_api(), img, opts, mode);\n490\t        assert_eq!(\n491\t            co.ok, ro.ok,\n492\t            \"{}: error parity (C ok={} RS ok={})\\n C diag {:?}\\n RS diag {:?}\",\n493\t            label, co.ok, ro.ok, co.diag, ro.diag\n494\t        );\n495\t        assert_eq!(co.diag, ro.diag, \"{}: diagnostics\", label);\n496\t        assert_eq!(co.flushes, ro.flushes, \"{}: flush count\", label);\n497\t        assert_bytes_eq(label, &co.bytes, &ro.bytes);\n498\t    }\n499\t}\n500\t\n501\t// ---------------------------------------------------------------------------\n502\t\n503\t#[test]\n504\tfn all_color_types_and_depths() {\n505\t    let mut rng = Rng::new(0xa1b2_c3d4_e5f6_0701);\n506\t    for (ct, bd) in legal_ihdr() {\n507\t        for interlace in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n508\t            for &(w, h) in &[(1u32, 1u32), (1, 7), (7, 1), (5, 5), (17, 3), (32, 9)] {\n509\t                let img = Img::gen(&mut rng, ct, bd, w, h, interlace);\n510\t                for mode in [RowMode::Row, RowMode::Rows, RowMode::Image] {\n511\t                    if interlace == PNG_INTERLACE_ADAM7 && mode == RowMode::Image {\n512\t                        // png_write_image handles the passes itself\n513\t                    }\n514\t                    diff(\n515\t                        &format!(\n516\t                            \"ct={} bd={} il={} {}x{} {:?}\",\n517\t                            ct, bd, interlace, w, h, mode\n518\t                        ),\n519\t                        &img,\n520\t                        &[],\n521\t                        mode,\n522\t                    );\n523\t                }\n524\t            }\n525\t        }\n526\t    }\n527\t}\n528\t\n529\t#[test]\n530\tfn filter_selection() {\n531\t    let mut rng = Rng::new(0xb2c3_d4e5_f607_1801);\n532\t    let filters = [\n533\t        PNG_NO_FILTERS,\n534\t        PNG_FILTER_NONE,\n535\t        PNG_FILTER_SUB,\n536\t        PNG_FILTER_UP,\n537\t        PNG_FILTER_AVG,\n538\t        PNG_FILTER_PAETH,\n539\t        PNG_FAST_FILTERS,\n540\t        PNG_ALL_FILTERS,\n541\t        PNG_FILTER_SUB | PNG_FILTER_PAETH,\n542\t        PNG_FILTER_NONE | PNG_FILTER_AVG,\n543\t    ];\n544\t    for (ct, bd) in legal_ihdr() {\n545\t        for &f in &filters {\n546\t            for interlace in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n547\t                let img = Img::gen(&mut rng, ct, bd, 23, 11, interlace);\n548\t                diff(\n549\t                    &format!(\"filter ct={} bd={} f={:#x} il={}\", ct, bd, f, interlace),\n550\t                    &img,\n551\t                    &[W::Filter(f)],\n552\t                    RowMode::Image,\n553\t                );\n554\t            }\n555\t        }\n556\t    }\n557\t}\n558\t\n559\t#[test]\n560\tfn weighted_filter_heuristics() {\n561\t    let mut rng = Rng::new(0xc3d4_e5f6_0718_2901);\n562\t    for (ct, bd) in [\n563\t        (PNG_COLOR_TYPE_RGB, 8),\n564\t        (PNG_COLOR_TYPE_GRAY, 8),\n565\t        (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n566\t        (PNG_COLOR_TYPE_PALETTE, 4),\n567\t    ] {\n568\t        for method in [\n569\t            PNG_FILTER_HEURISTIC_DEFAULT,\n570\t            PNG_FILTER_HEURISTIC_UNWEIGHTED,\n571\t            PNG_FILTER_HEURISTIC_WEIGHTED,\n572\t        ] {\n573\t            for nw in [0usize, 1, 3] {\n574\t                let w: Vec<f64> = (0..nw).map(|i| 1.0 + i as f64 * 0.5).collect();\n575\t                let c: Vec<f64> = (0..5).map(|i| 1.0 + i as f64 * 0.25).collect();\n576\t                let img = Img::gen(&mut rng, ct, bd, 29, 13, PNG_INTERLACE_NONE);\n577\t                diff(\n578\t                    &format!(\"heur ct={} bd={} m={} nw={}\", ct, bd, method, nw),\n579\t                    &img,\n580\t                    &[\n581\t                        W::Filter(PNG_ALL_FILTERS),\n582\t                        W::FilterHeuristics(method, w.clone(), c.clone()),\n583\t                    ],\n584\t                    RowMode::Image,\n585\t                );\n586\t                let wf: Vec<i32> = w.iter().map(|x| (x * 100000.0) as i32).collect();\n587\t                let cf: Vec<i32> = c.iter().map(|x| (x * 100000.0) as i32).collect();\n588\t                diff(\n589\t                    &format!(\"heurfx ct={} bd={} m={} nw={}\", ct, bd, method, nw),\n590\t                    &img,\n591\t                    &[\n592\t                        W::Filter(PNG_ALL_FILTERS),\n593\t                        W::FilterHeuristicsFixed(method, wf, cf),\n594\t                    ],\n595\t                    RowMode::Image,\n596\t                );\n597\t            }\n598\t        }\n599\t    }\n600\t}\n601\t\n602\t#[test]\n603\tfn compression_settings() {\n604\t    let mut rng = Rng::new(0xd4e5_f607_1829_3a01);\n605\t    let img = Img::gen(&mut rng, PNG_COLOR_TYPE_RGB, 8, 40, 20, PNG_INTERLACE_NONE);\n606\t    for lvl in [-1i32, 0, 1, 5, 9] {\n607\t        diff(&format!(\"level {}\", lvl), &img, &[W::Level(lvl)], RowMode::Image);\n608\t    }\n609\t    for ml in [1i32, 8, 9] {\n610\t        diff(&format!(\"memlevel {}\", ml), &img, &[W::MemLevel(ml)], RowMode::Image);\n611\t    }\n612\t    for st in [0i32, 1, 2, 3, 4] {\n613\t        diff(&format!(\"strategy {}\", st), &img, &[W::Strategy(st)], RowMode::Image);\n614\t    }\n615\t    for wb in [8i32, 9, 12, 15] {\n616\t        diff(&format!(\"windowbits {}\", wb), &img, &[W::WindowBits(wb)], RowMode::Image);\n617\t    }\n618\t    diff(\"method 8\", &img, &[W::Method(8)], RowMode::Image);\n619\t    for bs in [1usize, 2, 3, 64, 1024, 8192, 100_000] {\n620\t        diff(&format!(\"bufsize {}\", bs), &img, &[W::BufferSize(bs)], RowMode::Image);\n621\t    }\n622\t    // combinations\n623\t    let mut rng2 = Rng::new(0x1122_3344_5566_7781);\n624\t    for _ in 0..40 {\n625\t        let opts = vec![\n626\t            W::Level(rng2.range(-1, 9) as i32),\n627\t            W::MemLevel(rng2.range(1, 9) as i32),\n628\t            W::Strategy(rng2.range(0, 4) as i32),\n629\t            W::WindowBits(rng2.range(8, 15) as i32),\n630\t            W::BufferSize(1 + rng2.below(4096) as usize),\n631\t            W::Filter(PNG_ALL_FILTERS),\n632\t        ];\n633\t        diff(&format!(\"combo {:?}\", opts), &img, &opts, RowMode::Image);\n634\t    }\n635\t}\n636\t\n637\t#[test]\n638\tfn write_transforms() {\n639\t    let mut rng = Rng::new(0xe5f6_0718_293a_4b01);\n640\t    let cases: Vec<(c_int, c_int, Vec<W>)> = vec![\n641\t        (PNG_COLOR_TYPE_RGB, 8, vec![W::