{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S9N2kdLdVWk2nhAM8yfB7H","type":"tool_result","content":"1\t//! Phase B — CONFIGS.md section B: the low-level sequential READ pipeline\n2\t//! (`png_create_read_struct` .. `png_read_end`) with every read transform,\n3\t//! driven end to end and compared row-for-row between the two `.so`s.\n4\tmod common;\n5\tuse common::*;\n6\t\n7\t// ---------------------------------------------------------------------------\n8\t// Building the input PNGs: produced by the (already verified) write path of\n9\t// the *C* library, so both readers get byte-identical input.\n10\t// ---------------------------------------------------------------------------\n11\t\n12\tpub struct Src {\n13\t    pub bytes: Vec<u8>,\n14\t    pub width: u32,\n15\t    pub height: u32,\n16\t    pub bit_depth: c_int,\n17\t    pub color_type: c_int,\n18\t    pub interlace: c_int,\n19\t}\n20\t\n21\tunsafe fn build(\n22\t    rng: &mut Rng,\n23\t    color_type: c_int,\n24\t    bit_depth: c_int,\n25\t    w: u32,\n26\t    h: u32,\n27\t    interlace: c_int,\n28\t    extras: &[Extra],\n29\t) -> Src {\n30\t    let api = c_api();\n31\t    set_current_api(api);\n32\t    diag_reset();\n33\t    let mut sess = WriteSess::new(api);\n34\t    let png = sess.png;\n35\t    let info = sess.info;\n36\t    let pd = channels_of(color_type) * bit_depth as u32;\n37\t    let rb = rowbytes(pd, w);\n38\t    let rows: Vec<Vec<u8>> = (0..h).map(|_| rng.bytes(rb)).collect();\n39\t    let npal = if color_type == PNG_COLOR_TYPE_PALETTE {\n40\t        1usize << bit_depth\n41\t    } else {\n42\t        0\n43\t    };\n44\t    let palette: Vec<png_color> = (0..npal)\n45\t        .map(|_| png_color {\n46\t            red: rng.u8(),\n47\t            green: rng.u8(),\n48\t            blue: rng.u8(),\n49\t        })\n50\t        .collect();\n51\t    let mut trns_alpha: Vec<u8> = Vec::new();\n52\t    let mut keep_c: Vec<std::ffi::CString> = Vec::new();\n53\t    let mut keep_t: Vec<png_text> = Vec::new();\n54\t    let ok = guard(|| {\n55\t        (api.png_set_IHDR)(\n56\t            png,\n57\t            info,\n58\t            w,\n59\t            h,\n60\t            bit_depth,\n61\t            color_type,\n62\t            interlace,\n63\t            PNG_COMPRESSION_TYPE_BASE,\n64\t            PNG_FILTER_TYPE_BASE,\n65\t        );\n66\t        if !palette.is_empty() {\n67\t            (api.png_set_PLTE)(png, info, palette.as_ptr(), palette.len() as c_int);\n68\t        }\n69\t        for e in extras {\n70\t            match e {\n71\t                Extra::Gama(g) => (api.png_set_gAMA_fixed)(png, info, *g),\n72\t                Extra::Srgb(i) => (api.png_set_sRGB)(png, info, *i),\n73\t                Extra::Trns => {\n74\t                    if color_type == PNG_COLOR_TYPE_PALETTE {\n75\t                        trns_alpha = (0..palette.len()).map(|i| (i as u8) ^ 0x5a).collect();\n76\t                        (api.png_set_tRNS)(\n77\t                            png,\n78\t                            info,\n79\t                            trns_alpha.as_mut_ptr(),\n80\t                            trns_alpha.len() as c_int,\n81\t                            std::ptr::null_mut(),\n82\t                        );\n83\t                    } else if color_type == PNG_COLOR_TYPE_GRAY\n84\t                        || color_type == PNG_COLOR_TYPE_RGB\n85\t                    {\n86\t                        let mx = if bit_depth == 16 {\n87\t                            0xffffu16\n88\t                        } else {\n89\t                            ((1u32 << bit_depth) - 1) as u16\n90\t                        };\n91\t                        let col = png_color_16 {\n92\t                            index: 0,\n93\t                            red: mx / 3,\n94\t                            green: mx / 5,\n95\t                            blue: mx / 7,\n96\t                            gray: mx / 2,\n97\t                        };\n98\t                        (api.png_set_tRNS)(\n99\t                            png,\n100\t                            info,\n101\t                            std::ptr::null_mut(),\n102\t                            0,\n103\t                            &col as *const _ as png_color_16p,\n104\t                        );\n105\t                    }\n106\t                }\n107\t                Extra::Bkgd => {\n108\t                    let mx = if color_type == PNG_COLOR_TYPE_PALETTE {\n109\t                        (palette.len() - 1) as u16\n110\t                    } else if bit_depth == 16 {\n111\t                        0xffff\n112\t                    } else {\n113\t                        ((1u32 << bit_depth) - 1) as u16\n114\t                    };\n115\t                    let col = png_color_16 {\n116\t                        index: (mx & 0xff) as u8,\n117\t                        red: mx / 2,\n118\t                        green: mx / 3,\n119\t                        blue: mx / 4,\n120\t                        gray: mx / 5,\n121\t                    };\n122\t                    (api.png_set_bKGD)(png, info, &col as *const _ as png_const_color_16p);\n123\t                }\n124\t                Extra::SigBit => {\n125\t                    let b = if bit_depth == 16 { 12 } else { bit_depth as u8 };\n126\t                    let s = png_color_8 {\n127\t                        red: b,\n128\t                        green: b,\n129\t                        blue: b,\n130\t                        gray: b,\n131\t                        alpha: b,\n132\t                    };\n133\t                    (api.png_set_sBIT)(png, info, &s);\n134\t                }\n135\t                Extra::Text => {\n136\t                    keep_c.push(cs(\"Comment\"));\n137\t                    let k = keep_c.last().unwrap().as_ptr() as png_charp;\n138\t                    keep_c.push(cs(\"hello progressive world\"));\n139\t                    let t = keep_c.last().unwrap().as_ptr() as png_charp;\n140\t                    keep_t.push(png_text {\n141\t                        compression: PNG_TEXT_COMPRESSION_NONE,\n142\t                        key: k,\n143\t                        text: t,\n144\t                        text_length: 23,\n145\t                        itxt_length: 0,\n146\t                        lang: std::ptr::null_mut(),\n147\t                        lang_key: std::ptr::null_mut(),\n148\t                    });\n149\t                    (api.png_set_text)(png, info, keep_t.last().unwrap(), 1);\n150\t                }\n151\t                Extra::Hist => {\n152\t                    if color_type == PNG_COLOR_TYPE_PALETTE {\n153\t                        let h: Vec<u16> = (0..palette.len()).map(|i| (i * 7) as u16).collect();\n154\t                        (api.png_set_hIST)(png, info, h.as_ptr());\n155\t                    }\n156\t                }\n157\t            }\n158\t        }\n159\t        (api.png_write_info)(png, info);\n160\t        let mut rowps: Vec<png_bytep> = rows.iter().map(|r| r.as_ptr() as png_bytep).collect();\n161\t        (api.png_write_image)(png, rowps.as_mut_ptr());\n162\t        (api.png_write_end)(png, info);\n163\t    })\n164\t    .is_some();\n165\t    let _ = diag_take();\n166\t    assert!(ok, \"reference PNG construction failed\");\n167\t    Src {\n168\t        bytes: std::mem::take(&mut sess.sink.buf),\n169\t        width: w,\n170\t        height: h,\n171\t        bit_depth,\n172\t        color_type,\n173\t        interlace,\n174\t    }\n175\t}\n176\t\n177\t#[derive(Clone, Copy, Debug)]\n178\tpub enum Extra {\n179\t    Gama(i32),\n180\t    Srgb(c_int),\n181\t    Trns,\n182\t    Bkgd,\n183\t    SigBit,\n184\t    Text,\n185\t    Hist,\n186\t}\n187\t\n188\t// ---------------------------------------------------------------------------\n189\t// Read transforms\n190\t// ---------------------------------------------------------------------------\n191\t\n192\t#[derive(Clone, Debug)]\n193\tpub enum R {\n194\t    Expand,\n195\t    Expand16,\n196\t    PaletteToRgb,\n197\t    ExpandGray124To8,\n198\t    TrnsToAlpha,\n199\t    GrayToRgb,\n200\t    Strip16,\n201\t    Scale16,\n202\t    StripAlpha,\n203\t    AddAlpha(u32, c_int),\n204\t    Filler(u32, c_int),\n205\t    Background(png_color_16, c_int, c_int, f64),\n206\t    BackgroundFixed(png_color_16, c_int, c_int, i32),\n207\t    Gamma(f64, f64),\n208\t    GammaFixed(i32, i32),\n209\t    AlphaMode(c_int, f64),\n210\t    AlphaModeFixed(c_int, i32),\n211\t    RgbToGray(c_int, f64, f64),\n212\t    RgbToGrayFixed(c_int, i32, i32),\n213\t    RgbCoefficients,\n214\t    Quantize(Vec<png_color>, c_int, Vec<u16>, c_int),\n215\t    Shift(png_color_8),\n216\t    Packing,\n217\t    PackSwap,\n218\t    Swap,\n219\t    SwapAlpha,\n220\t    InvertAlpha,\n221\t    InvertMono,\n222\t    Bgr,\n223\t    CrcAction(c_int, c_int),\n224\t    UserLimits(u32, u32),\n225\t    ChunkCacheMax(u32),\n226\t    ChunkMallocMax(usize),\n227\t    Option(c_int, c_int),\n228\t    MngFeatures(u32),\n229\t    Benign(c_int),\n230\t    CheckInvalidIndex(c_int),\n231\t    KeepUnknown(c_int),\n232\t}\n233\t\n234\t/// `png_set_quantize` REWRITES the caller's palette in place, so each library\n235\t/// must get its own copy; the rewritten copy is returned so it can be compared.\n236\tunsafe fn apply_r(\n237\t    api: &'static Api,\n238\t    png: png_structp,\n239\t    info: png_infop,\n240\t    ts: &[R],\n241\t    out_pal: &mut Vec<png_color>,\n242\t) {\n243\t    let mut owned: Vec<Vec<png_color>> = Vec::new();\n244\t    for t in ts {\n245\t        match t {\n246\t            R::Expand => (api.png_set_expand)(png),\n247\t            R::Expand16 => (api.png_set_expand_16)(png),\n248\t            R::PaletteToRgb => (api.png_set_palette_to_rgb)(png),\n249\t            R::ExpandGray124To8 => (api.png_set_expand_gray_1_2_4_to_8)(png),\n250\t            R::TrnsToAlpha => (api.png_set_tRNS_to_alpha)(png),\n251\t            R::GrayToRgb => (api.png_set_gray_to_rgb)(png),\n252\t            R::Strip16 => (api.png_set_strip_16)(png),\n253\t            R::Scale16 => (api.png_set_scale_16)(png),\n254\t            R::StripAlpha => (api.png_set_strip_alpha)(png),\n255\t            R::AddAlpha(v, loc) => (api.png_set_add_alpha)(png, *v, *loc),\n256\t            R::Filler(v, loc) => (api.png_set_filler)(png, *v, *loc),\n257\t            R::Background(c, code, need, g) => {\n258\t                (api.png_set_background)(png, c as *const _ as png_const_color_16p, *code, *need, *g)\n259\t            }\n260\t            R::BackgroundFixed(c, code, need, g) => (api.png_set_background_fixed)(\n261\t                png,\n262\t                c as *const _ as png_const_color_16p,\n263\t                *code,\n264\t                *need,\n265\t                *g,\n266\t            ),\n267\t            R::Gamma(s, f) => (api.png_set_gamma)(png, *s, *f),\n268\t            R::GammaFixed(s, f) => (api.png_set_gamma_fixed)(png, *s, *f),\n269\t            R::AlphaMode(m, g) => (api.png_set_alpha_mode)(png, *m, *g),\n270\t            R::AlphaModeFixed(m, g) => (api.png_set_alpha_mode_fixed)(png, *m, *g),\n271\t            R::RgbToGray(a, r, g) => (api.png_set_rgb_to_gray)(png, *a, *r, *g),\n272\t            R::RgbToGrayFixed(a, r, g) => (api.png_set_rgb_to_gray_fixed)(png, *a, *r, *g),\n273\t            // png_set_rgb_coefficients(png_ptr) -- installs the default\n274\t            // (or colorspace-derived) rgb_to_gray coefficients (png.c:1886).\n275\t            R::RgbCoefficients => (api.png_set_rgb_coefficients)(png),\n276\t            R::Quantize(pal, npal, hist, max) => {\n277\t                owned.push(pal.clone());\n278\t                let p = owned.last_mut().unwrap();\n279\t                (api.png_set_quantize)(\n280\t                    png,\n281\t                    p.as_mut_ptr(),\n282\t                    *npal,\n283\t                    *max,\n284\t                    if hist.is_empty() {\n285\t                        std::ptr::null()\n286\t                    } else {\n287\t                        hist.as_ptr()\n288\t                    },\n289\t                    1,\n290\t                );\n291\t            }\n292\t            R::Shift(s) => (api.png_set_shift)(png, s),\n293\t            R::Packing => (api.png_set_packing)(png),\n294\t            R::PackSwap => (api.png_set_packswap)(png),\n295\t            R::Swap => (api.png_set_swap)(png),\n296\t            R::SwapAlpha => (api.png_set_swap_alpha)(png),\n297\t            R::InvertAlpha => (api.png_set_invert_alpha)(png),\n298\t            R::InvertMono => (api.png_set_invert_mono)(png),\n299\t            R::Bgr => (api.png_set_bgr)(png),\n300\t            R::CrcAction(a, b) => (api.png_set_crc_action)(png, *a, *b),\n301\t            R::UserLimits(w, h) => (api.png_set_user_limits)(png, *w, *h),\n302\t            R::ChunkCacheMax(v) => (api.png_set_chunk_cache_max)(png, *v),\n303\t            R::ChunkMallocMax(v) => (api.png_set_chunk_malloc_max)(png, *v),\n304\t            R::Option(o, v) => {\n305\t                (api.png_set_option)(png, *o, *v);\n306\t            }\n307\t            R::MngFeatures(f) => {\n308\t                (api.png_permit_mng_features)(png, *f);\n309\t            }\n310\t            R::Benign(v) => (api.png_set_benign_errors)(png, *v),\n311\t            R::CheckInvalidIndex(v) => (api.png_set_check_for_invalid_index)(png, *v),\n312\t            R::KeepUnknown(k) => {\n313\t                (api.png_set_keep_unknown_chunks)(png, *k, std::ptr::null(), 0)\n314\t            }\n315\t        }\n316\t    }\n317\t    for v in owned {\n318\t        out_pal.extend_from_slice(&v);\n319\t    }\n320\t}\n321\t\n322\t/// Everything observable after a full read.\n323\t#[derive(Debug, PartialEq)]\n324\tpub struct ReadOut {\n325\t    pub ok: bool,\n326\t    pub diag: Diag,\n327\t    pub width: u32,\n328\t    pub height: u32,\n329\t    pub bit_depth: c_int,\n330\t    pub color_type: c_int,\n331\t    pub interlace: c_int,\n332\t    pub channels: u8,\n333\t    pub rowbytes: usize,\n334\t    pub valid: u32,\n335\t    pub rows: Vec<Vec<u8>>,\n336\t    pub rgb_to_gray_status: u8,\n337\t    pub palette_max: c_int,\n338\t    pub current_pass: u8,\n339\t    pub current_row: u32,\n340\t    pub quantize_palette: Vec<png_color>,\n341\t}\n342\t\n343\t#[derive(Clone, Copy, Debug, PartialEq)]\n344\tpub enum ReadMode {\n345\t    /// png_read_row per row (with a display row too)\n346\t    Row { display: bool },\n347\t    /// png_read_rows for the whole image\n348\t    Rows,\n349\t    /// png_read_image with a row-pointer array\n350\t    Image,\n351\t    /// png_read_png one-shot\n352\t    OneShot(c_int),\n353\t}\n354\t\n355\tpub unsafe fn read_png(api: &'static Api, src: &Src, ts: &[R], mode: ReadMode) -> ReadOut {\n356\t    set_current_api(api);\n357\t    diag_reset();\n358\t    let sess = ReadSess::new(api, &src.bytes);\n359\t    let png = sess.png;\n360\t    let info = sess.info;\n361\t    let mut rows: Vec<Vec<u8>> = Vec::new();\n362\t    let mut w = 0u32;\n363\t    let mut h = 0u32;\n364\t    let mut bd = 0i32;\n365\t    let mut ct = 0i32;\n366\t    let mut il = 0i32;\n367\t    let mut ch = 0u8;\n368\t    let mut rbz = 0usize;\n369\t    let mut valid = 0u32;\n370\t    let mut r2g = 0u8;\n371\t    let mut pmax = -1i32;\n372\t    let mut cpass = 0u8;\n373\t    let mut crow = 0u32;\n374\t    let mut qpal: Vec<png_color> = Vec::new();\n375\t    let ok = guard(|| {\n376\t        match mode {\n377\t            ReadMode::OneShot(t) => {\n378\t                apply_r(api, png, info, ts, &mut qpal);\n379\t                (api.png_read_png)(png, info, t, std::ptr::null_mut());\n380\t                let rp = (api.png_get_rows)(png, info);\n381\t                w = (api.png_get_image_width)(png, info);\n382\t                h = (api.png_get_image_height)(png, info);\n383\t                rbz = (api.png_get_rowbytes)(png, info);\n384\t                if !rp.is_null() {\n385\t                    for y in 0..h {\n386\t                        let p = *rp.add(y as usize);\n387\t                        rows.push(std::slice::from_raw_parts(p, rbz).to_vec());\n388\t                    }\n389\t                }\n390\t            }\n391\t            _ => {\n392\t                (api.png_read_info)(png, info);\n393\t                apply_r(api, png, info, ts, &mut qpal);\n394\t                (api.png_read_update_info)(png, info);\n395\t                w = (api.png_get_image_width)(png, info);\n396\t                h = (api.png_get_image_height)(png, info);\n397\t                rbz = (api.png_get_rowbytes)(png, info);\n398\t                let npasses = if src.interlace == PNG_INTERLACE_ADAM7 {\n399\t                    (api.png_set_interlace_handling)(png)\n400\t                } else {\n401\t                    1\n402\t                };\n403\t                match mode {\n404\t                    ReadMode::Row { display } => {\n405\t                        let mut buf: Vec<Vec<u8>> = (0..h).map(|_| vec![0u8; rbz + 8]).collect();\n406\t                        let mut disp: Vec<Vec<u8>> = (0..h).map(|_| vec![0u8; rbz + 8]).collect();\n407\t                        for _ in 0..npasses {\n408\t                            for y in 0..h as usize {\n409\t                                if display {\n410\t                                    (api.png_read_row)(\n411\t                                        png,\n412\t                                        buf[y].as_mut_ptr(),\n413\t                                        disp[y].as_mut_ptr(),\n414\t                                    );\n415\t                                } else {\n416\t                                    (api.png_read_row)(\n417\t                                        png,\n418\t                                        buf[y].as_mut_ptr(),\n419\t                                        std::ptr::null_mut(),\n420\t                                    );\n421\t                                }\n422\t                            }\n423\t                        }\n424\t                        for y in 0..h as usize {\n425\t                            rows.push(buf[y].clone());\n426\t                            if display {\n427\t                                rows.push(disp[y].clone());\n428\t                            }\n429\t                        }\n430\t                    }\n431\t                    ReadMode::Rows => {\n432\t                        let mut buf: Vec<Vec<u8>> = (0..h).map(|_| vec![0u8; rbz + 8]).collect();\n433\t                        let mut ptrs: Vec<png_bytep> =\n434\t                            buf.iter_mut().map(|r| r.as_mut_ptr()).collect();\n435\t                        for _ in 0..npasses {\n436\t                            (api.png_read_rows)(\n437\t                                png,\n438\t                                ptrs.as_mut_ptr(),\n439\t                                std::ptr::null_mut(),\n440\t                                h,\n441\t                            );\n442\t                        }\n443\t                        rows = buf;\n444\t                    }\n445\t                    ReadMode::Image => {\n446\t                        let mut buf: Vec<Vec<u8>> = (0..h).map(|_| vec![0u8; rbz + 8]).collect();\n447\t                        let mut ptrs: Vec<png_bytep> =\n448\t                            buf.iter_mut().map(|r| r.as_mut_ptr()).collect();\n449\t                        (api.png_read_image)(png, ptrs.as_mut_ptr());\n450\t                        rows = buf;\n451\t                    }\n452\t                    ReadMode::OneShot(_) => unreachable!(),\n453\t                }\n454\t                (api.png_read_end)(png, sess.end);\n455\t            }\n456\t        }\n457\t        bd = (api.png_get_bit_depth)(png, info) as c_int;\n458\t        ct = (api.png_get_color_type)(png, info) as c_int;\n459\t        il = (api.png_get_interlace_type)(png, info) as c_int;\n460\t        ch = (api.png_get_channels)(png, info);\n461\t        valid = (api.png_get_valid)(png, info, 0xffff_ffff);\n462\t        r2g = (api.png_get_rgb_to_gray_status)(png);\n463\t        pmax = (api.png_get_palette_max)(png, info);\n464\t        cpass = (api.png_get_current_pass_number)(png);\n465\t        crow = (api.png_get_current_row_number)(png);\n466\t    })\n467\t    .is_some();\n468\t    ReadOut {\n469\t        ok,\n470\t        diag: diag_take(),\n471\t        width: w,\n472\t        height: h,\n473\t        bit_depth: bd,\n474\t        color_type: ct,\n475\t        interlace: il,\n476\t        channels: ch,\n477\t        rowbytes: rbz,\n478\t        valid,\n479\t        rows,\n480\t        rgb_to_gray_status: r2g,\n481\t        palette_max: pmax,\n482\t        current_pass: cpass,\n483\t        current_row: crow,\n484\t        quantize_palette: qpal,\n485\t    }\n486\t}\n487\t\n488\t/// Zero the padding bits of the last byte of a sub-byte-depth row.\n489\t///\n490\t/// `png_combine_row` deliberately PRESERVES the destination row's bits beyond\n491\t/// the last pixel (`end_byte & end_mask`).  For `png_read_png` the destination\n492\t/// rows are allocated by libpng with `png_malloc` and are therefore\n493\t/// uninitialised, so those bits are indeterminate in BOTH libraries and must\n494\t/// not be compared.  Every other read mode uses zeroed buffers, where the bits\n495\t/// are well defined and ARE compared.\n496\tfn strip_padding(rows: &mut [Vec<u8>], pixel_depth: u32, width: u32, packswap: bool) {\n497\t    if pixel_depth == 0 || pixel_depth >= 8 {\n498\t        return;\n499\t    }\n500\t    let bits = pixel_depth as u64 * width as u64;\n501\t    let m = (bits & 7) as u32;\n502\t    if m == 0 {\n503\t        return;\n504\t    }\n505\t    let last = (bits / 8) as usize; // index of the partial byte\n506\t    let keep: u8 = if packswap {\n507\t        // little-endian byte: the *high* bits are padding\n508\t        0xffu8 >> (8 - m)\n509\t    } else {\n510\t        !(0xffu8 >> m)\n511\t    };\n512\t    for r in rows.iter_mut() {\n513\t        if last < r.len() {\n514\t            r[last] &= keep;\n515\t        }\n516\t    }\n517\t}\n518\t\n519\tfn rdiff(label: &str, src: &Src, ts: &[R], mode: ReadMode) {\n520\t    unsafe {\n521\t        let mut co = read_png(c_api(), src, ts, mode);\n522\t        let mut ro = read_png(rs_api(), src, ts, mode);\n523\t        if let ReadMode::OneShot(t) = mode {\n524\t            let pd = co.channels as u32 * co.bit_depth as u32;\n525\t            let ps = (t & PNG_TRANSFORM_PACKSWAP) != 0;\n526\t            strip_padding(&mut co.rows, pd, co.width, ps);\n527\t            let pd2 = ro.channels as u32 * ro.bit_depth as u32;\n528\t            strip_padding(&mut ro.rows, pd2, ro.width, ps);\n529\t        }\n530\t        assert_eq!(\n531\t            co.ok, ro.ok,\n532\t            \"{}: error parity (C={} RS={})\\n C diag {:?}\\n RS diag {:?}\",\n533\t            label, co.ok, ro.ok, co.diag, ro.diag\n534\t        );\n535\t        assert_eq!(co.diag, ro.diag, \"{}: diagnostics\", label);\n536\t        assert_eq!(\n537\t            (\n538\t                co.width,\n539\t                co.height,\n540\t                co.bit_depth,\n541\t                co.color_type,\n542\t                co.interlace,\n543\t                co.channels,\n544\t                co.rowbytes,\n545\t                co.valid,\n546\t                co.rgb_to_gray_status,\n547\t                co.palette_max,\n548\t                co.current_pass,\n549\t                co.current_row\n550\t            ),\n551\t            (\n552\t                ro.width,\n553\t                ro.height,\n554\t                ro.bit_depth,\n555\t                ro.color_type,\n556\t                ro.interlace,\n557\t                ro.channels,\n558\t                ro.rowbytes,\n559\t                ro.valid,\n560\t                ro.rgb_to_gray_status,\n561\t                ro.palette_max,\n562\t                ro.current_pass,\n563\t                ro.current_row\n564\t            ),\n565\t            \"{}: info fields\",\n566\t            label\n567\t        );\n568\t        assert_eq!(\n569\t            co.quantize_palette, ro.quantize_palette,\n570\t            \"{}: palette rewritten by png_set_quantize\",\n571\t            label\n572\t        );\n573\t        assert_eq!(co.rows.len(), ro.rows.len(), \"{}: row count\", label);\n574\t        for (i, (a, b)) in co.rows.iter().zip(ro.rows.iter()).enumerate() {\n575\t            assert_bytes_eq(&format!(\"{} row {}\", label, i), a, b);\n576\t        }\n577\t    }\n578\t}\n579\t\n580\tconst SIZES: [(u32, u32); 5] = [(1, 1), (1, 9), (9, 1), (13, 7), (32, 5)];\n581\t\n582\t#[test]\n583\tfn plain_read_all_formats_all_modes() {\n584\t    let mut rng = Rng::new(0x2244_6688_aacc_ee01);\n585\t    for (ct, bd) in legal_ihdr() {\n586\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n587\t            for &(w, h) in &SIZES {\n588\t                unsafe {\n589\t                    let src = build(&mut rng, ct, bd, w, h, il, &[]);\n590\t                    for mode in [\n591\t                        ReadMode::Row { display: false },\n592\t                        ReadMode::Row { display: true },\n593\t                        ReadMode::Rows,\n594\t                        ReadMode::Image,\n595\t                    ] {\n596\t                        rdiff(\n597\t                            &format!(\"plain ct={} bd={} il={} {}x{} {:?}\", ct, bd, il, w, h, mode),\n598\t                            &src,\n599\t                            &[],\n600\t                            mode,\n601\t                        );\n602\t                    }\n603\t                }\n604\t            }\n605\t        }\n606\t    }\n607\t}\n608\t\n609\t#[test]\n610\tfn read_png_one_shot_transforms() {\n611\t    let mut rng = Rng::new(0x3355_7799_bbdd_ff01);\n612\t    let masks = [\n613\t        PNG_TRANSFORM_IDENTITY,\n614\t        PNG_TRANSFORM_STRIP_16,\n615\t        PNG_TRANSFORM_STRIP_ALPHA,\n616\t        PNG_TRANSFORM_PACKING,\n617\t        PNG_TRANSFORM_PACKSWAP,\n618\t        PNG_TRANSFORM_EXPAND,\n619\t        PNG_TRANSFORM_INVERT_MONO,\n620\t        PNG_TRANSFORM_SHIFT,\n621\t        PNG_TRANSFORM_BGR,\n622\t        PNG_TRANSFORM_SWAP_ALPHA,\n623\t        PNG_TRANSFORM_SWAP_ENDIAN,\n624\t        PNG_TRANSFORM_INVERT_ALPHA,\n625\t        PNG_TRANSFORM_GRAY_TO_RGB,\n626\t        PNG_TRANSFORM_EXPAND_16,\n627\t        PNG_TRANSFORM_SCALE_16,\n628\t        PNG_TRANSFORM_EXPAND | PNG_TRANSFORM_GRAY_TO_RGB,\n629\t        PNG_TRANSFORM_EXPAND | PNG_TRANSFORM_STRIP_ALPHA,\n630\t        PNG_TRANSFORM_STRIP_16 | PNG_TRANSFORM_BGR | PNG_TRANSFORM_INVERT_ALPHA,\n631\t    ];\n632\t    for (ct, bd) in legal_ihdr() {\n633\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n634\t            unsafe {\n635\t                let src = build(\n636\t                    &mut rng,\n637\t                    ct,\n638\t                    bd,\n639\t                    11,\n640\t                    5,\n641\t                    il,\n642\t                    &[Extra::SigBit, Extra::Trns, Extra::Bkgd],\n643\t                );\n644\t                for &m in &masks {\n645\t                    rdiff(\n646\t                        &format!(\"read_png ct={} bd={} il={} m={:#x}\", ct, bd, il, m),\n647\t                        &src,\n648\t                        &[],\n649\t                        ReadMode::OneShot(m),\n650\t                    );\n651\t                }\n652\t            }\n653\t        }\n654\t    }\n655\t}\n656\t\n657\t#[test]\n658\tfn expansion_transforms() {\n659\t    let mut rng = Rng::new(0x4466_88aa_ccee_0011);\n660\t    let sets: Vec<Vec<R>> = vec![\n661\t        vec![R::Expand],\n662\t        vec![R::Expand, R::Expand16],\n663\t        vec![R::PaletteToRgb],\n664\t        vec![R::ExpandGray124To8],\n665\t        vec![R::TrnsToAlpha],\n666\t        vec![R::GrayToRgb],\n667\t        vec![R::Expand, R::GrayToRgb],\n668\t        vec![R::Expand16],\n669\t        vec![R::Strip16],\n670\t        vec![R::Scale16],\n671\t        vec![R::Strip16, R::Expand],\n672\t        vec![R::Scale16, R::Expand],\n673\t        vec![R::StripAlpha],\n674\t        vec![R::AddAlpha(0xffff, PNG_FILLER_AFTER)],\n675\t        vec![R::AddAlpha(0x1234, PNG_FILLER_BEFORE)],\n676\t        vec![R::Filler(0x55aa, PNG_FILLER_AFTER)],\n677\t        vec![R::Filler(0x55aa, PNG_FILLER_BEFORE)],\n678\t        vec![R::Expand, R::TrnsToAlpha, R::GrayToRgb, R::Expand16],\n679\t        vec![R::PaletteToRgb, R::TrnsToAlpha, R::StripAlpha],\n680\t    ];\n681\t    for (ct, bd) in legal_ihdr() {\n682\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n683\t            unsafe {\n684\t                let src = build(&mut rng, ct, bd, 13, 4, il, &[Extra::Trns, Extra::SigBit]);\n685\t                for ts in &sets {\n686\t                    for mode in [ReadMode::Image, ReadMode::Row { display: true }] {\n687\t                        rdiff(\n688\t                            &format!(\n689\t                                \"expand ct={} bd={} il={} {:?} {:?}\",\n690\t                                ct, bd, il, ts, mode\n691\t                            ),\n692\t                            &src,\n693\t                            ts,\n694\t                            mode,\n695\t                        );\n696\t                    }\n697\t                }\n698\t            }\n699\t        }\n700\t    }\n701\t}\n702\t\n703\t#[test]\n704\tfn gamma_background_alpha_mode() {\n705\t    let mut rng = Rng::new(0x5577_99bb_ddff_1122);\n706\t    for (ct, bd) in legal_ihdr() {\n707\t        unsafe {\n708\t            let src = build(\n709\t                &mut rng,\n710\t                ct,\n711\t                bd,\n712\t                17,\n713\t                3,\n714\t                PNG_INTERLACE_NONE,\n715\t                &[Extra::Gama(45455), Extra::Trns, Extra::Bkgd],\n716\t            );\n717\t            // IMPORTANT: the background components must be IN RANGE.\n718\t            //\n719\t            //  * need_expand == 0 -> the value is already in the *output*\n720\t            //    format, i.e. <= 255 for 8-bit output.  libpng indexes\n721\t            //    `gamma_table[background.red]` (a 256-entry table) directly,\n722\t            //    so a 16-bit value here is an out-of-bounds read in the C\n723\t            //    (pngrtran.c:1712) -- C undefined behaviour, not testable.\n724\t            //  * need_expand != 0 -> the value is in the *file* format: a\n725\t            //    palette index for colour type 3 (must be < num_palette,\n726\t            //    otherwise `palette[background.index]` is out of bounds), or a\n727\t            //    sample in 0 ..= (1<<bit_depth)-1 otherwise.\n728\t            let bg_noexpand = png_color_16 {\n729\t                index: 1,\n730\t                red: 0x3f,\n731\t                green: 0x7f,\n732\t                blue: 0xbf,\n733\t                gray: 0x55,\n734\t            };\n735\t            let filemax: u16 = if bd == 16 {\n736\t                0xffff\n737\t            } else {\n738\t                ((1u32 << bd) - 1) as u16\n739\t            };\n740\t            let bg_expand = if ct == PNG_COLOR_TYPE_PALETTE {\n741\t                png_color_16 {\n742\t                    index: (filemax as u8).min(1),\n743\t                    red: 0,\n744\t                    green: 0,\n745\t                    blue: 0,\n746\t                    gray: 0,\n747\t                }\n748\t            } else {\n749\t                png_color_16 {\n750\t                    index: 0,\n751\t                    red: filemax / 3,\n752\t                    green: filemax / 5,\n753\t                    blue: filemax / 7,\n754\t                    gray: filemax / 2,\n755\t                }\n756\t            };\n757\t            let mut sets: Vec<Vec<R>> = vec![\n758\t                vec![R::GammaFixed(45455, 100000)],\n759\t                vec![R::GammaFixed(100000, 45455)],\n760\t                vec![R::Gamma(2.2, 0.45455)],\n761\t                vec![R::GammaFixed(220000, 45455), R::Expand],\n762\t                vec![R::GammaFixed(0, 100000)],\n763\t                vec![R::GammaFixed(100000, 100000)],\n764\t            ];\n765\t            for code in [\n766\t                PNG_BACKGROUND_GAMMA_SCREEN,\n767\t                PNG_BACKGROUND_GAMMA_FILE,\n768\t                PNG_BACKGROUND_GAMMA_UNIQUE,\n769\t                PNG_BACKGROUND_GAMMA_UNKNOWN,\n770\t            ] {\n771\t                for &(need, bg) in &[(0i32, bg_noexpand), (1i32, bg_expand)] {\n772\t                    sets.push(vec![\n773\t                        R::Expand,\n774\t                        R::Background(bg, code, need, 1.0),\n775\t                        R::GammaFixed(45455, 100000),\n776\t                    ]);\n777\t                    sets.push(vec![R::Expand, R::BackgroundFixed(bg, code, need, 100000)]);\n778\t                    sets.push(vec![\n779\t                        R::Expand,\n780\t                        R::BackgroundFixed(bg, code, need, 45455),\n781\t                        R::GammaFixed(45455, 220000),\n782\t                    ]);\n783\t                    sets.push(vec![\n784\t                        R::Expand,\n785\t                        R::Expand16,\n786\t                        R::BackgroundFixed(bg, code, need, 100000),\n787\t                    ]);\n788\t                }\n789\t            }\n790\t            for m in [\n791\t                PNG_ALPHA_PNG,\n792\t                PNG_ALPHA_STANDARD,\n793\t                PNG_ALPHA_OPTIMIZED,\n794\t                PNG_ALPHA_BROKEN,\n795\t            ] {\n796\t                sets.push(vec![R::AlphaMode(m, 2.2)]);\n797\t                sets.push(vec![R::AlphaModeFixed(m, 220000)]);\n798\t                sets.push(vec![R::AlphaModeFixed(m, PNG_DEFAULT_sRGB)]);\n799\t                sets.push(vec![R::AlphaModeFixed(m, PNG_GAMMA_MAC_18)]);\n800\t                sets.push(vec![R::Expand, R::AlphaModeFixed(m, 220000)]);\n801\t            }\n802\t            for ts in &sets {\n803\t                rdiff(\n804\t                    &format!(\"gamma ct={} bd={} {:?}\", ct, bd, ts),\n805\t                    &src,\n806\t                    ts,\n807\t                    ReadMode::Image,\n808\t                );\n809\t            }\n810\t        }\n811\t    }\n812\t}\n813\t\n814\t#[test]\n815\tfn rgb_to_gray_and_coefficients() {\n816\t    let mut rng = Rng::new(0x6688_aacc_ee00_2233);\n817\t    let mut sets: Vec<Vec<R>> = Vec::new();\n818\t    for action in [-1i32, 0, 1, 2, 3] {\n819\t        sets.push(vec![R::RgbToGray(action, -1.0, -1.0)]);\n820\t        sets.push(vec![R::RgbToGrayFixed(action, -1, -1)]);\n821\t        sets.push(vec![R::RgbToGrayFixed(action, 21260, 71520)]);\n822\t        sets.push(vec![R::RgbToGray(action, 0.3, 0.6)]);\n823\t        sets.push(vec![\n824\t            R::RgbCoefficients,\n825\t            R::RgbToGrayFixed(action, -1, -1),\n826\t        ]);\n827\t        sets.push(vec![R::Expand, R::RgbToGrayFixed(action, -1, -1)]);\n828\t    }\n829\t    for (ct, bd) in legal_ihdr() {\n830\t        unsafe {\n831\t            let src = build(\n832\t                &mut rng,\n833\t                ct,\n834\t                bd,\n835\t                15,\n836\t                4,\n837\t                PNG_INTERLACE_NONE,\n838\t                &[Extra::Gama(45455)],\n839\t            );\n840\t            for ts in &sets {\n841\t                rdiff(\n842\t                    &format!(\"r2g ct={} bd={} {:?}\", ct, bd, ts),\n843\t                    &src,\n844\t                    ts,\n845\t                    ReadMode::Image,\n846\t                );\n847\t            }\n848\t        }\n849\t    }\n850\t}\n851\t\n852\t#[test]\n853\tfn quantize() {\n854\t    let mut rng = Rng::new(0x7799_bbdd_ff11_3344);\n855\t    let pal: Vec<png_color> = (0..64)\n856\t        .map(|i| png_color {\n857\t            red: (i * 4) as u8,\n858\t            green: (255 - i * 3) as u8,\n859\t            blue: (i * 7 % 256) as u8,\n860\t        })\n861\t        .collect();\n862\t    let hist: Vec<u16> = (0..64).map(|i| (i * 11 % 1000) as u16).collect();\n863\t    for (ct, bd) in legal_ihdr() {\n864\t        for maxc in [1i32, 2, 16, 64, 256] {\n865\t            unsafe {\n866\t                let src = build(&mut rng, ct, bd, 21, 5, PNG_INTERLACE_NONE, &[Extra::Hist]);\n867\t                for withhist in [false, true] {\n868\t                    let ts = vec![R::Quantize(\n869\t                        pal.clone(),\n870\t                        pal.len() as c_int,\n871\t                        if withhist { hist.clone() } else { Vec::new() },\n872\t                        maxc,\n873\t                    )];\n874\t                    rdiff(\n875\t                        &format!(\"quantize ct={} bd={} max={} hist={}\", ct, bd, maxc, withhist),\n876\t                        &src,\n877\t                        &ts,\n878\t                        ReadMode::Image,\n879\t                    );\n880\t                }\n881\t            }\n882\t        }\n883\t    }\n884\t}\n885\t\n886\t#[test]\n887\tfn bit_level_transforms() {\n888\t    let mut rng = Rng::new(0x88aa_ccee_0022_4455);\n889\t    let sets: Vec<Vec<R>> = vec![\n890\t        vec![R::Packing],\n891\t        vec![R::PackSwap],\n892\t        vec![R::Packing, R::PackSwap],\n893\t        vec![R::Swap],\n894\t        vec![R::SwapAlpha],\n895\t        vec![R::InvertAlpha],\n896\t        vec![R::InvertMono],\n897\t        vec![R::Bgr],\n898\t        vec![R::Bgr, R::Swap],\n899\t        vec![R::Shift(png_color_8 {\n900\t            red: 4,\n901\t            green: 4,\n902\t            blue: 4,\n903\t            gray: 4,\n904\t            alpha: 4,\n905\t        })],\n906\t        vec![R::Packing, R::InvertMono, R::PackSwap],\n907\t        vec![R::Expand, R::Bgr, R::InvertAlpha, R::Swap],\n908\t    ];\n909\t    for (ct, bd) in legal_ihdr() {\n910\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n911\t            unsafe {\n912\t                let src = build(&mut rng, ct, bd, 19, 3, il, &[Extra::SigBit]);\n913\t                for ts in &sets {\n914\t                    rdiff(\n915\t                        &format!(\"bits ct={} bd={} il={} {:?}\", ct, bd, il, ts),\n916\t                        &src,\n917\t                        ts,\n918\t                        ReadMode::Image,\n919\t                    );\n920\t                }\n921\t            }\n922\t        }\n923\t    }\n924\t}\n925\t\n926\t#[test]\n927\tfn read_options_and_limits() {\n928\t    let mut rng = Rng::new(0x99bb_ddff_1133_5566);\n929\t    let mut sets: Vec<Vec<R>> = Vec::new();\n930\t    for crit in [\n931\t        PNG_CRC_DEFAULT,\n932\t        PNG_CRC_ERROR_QUIT,\n933\t        PNG_CRC_WARN_USE,\n934\t        PNG_CRC_QUIET_USE,\n935\t        PNG_CRC_NO_CHANGE,\n936\t        PNG_CRC_WARN_DISCARD,\n937\t    ] {\n938\t        for ancil in [\n939\t            PNG_CRC_DEFAULT,\n940\t            PNG_CRC_ERROR_QUIT,\n941\t            PNG_CRC_WARN_DISCARD,\n942\t            PNG_CRC_WARN_USE,\n943\t            PNG_CRC_QUIET_USE,\n944\t            PNG_CRC_NO_CHANGE,\n945\t        ] {\n946\t            sets.push(vec![R::CrcAction(crit, ancil)]);\n947\t        }\n948\t    }\n949\t    for o in [\n950\t        PNG_MAXIMUM_INFLATE_WINDOW,\n951\t        PNG_SKIP_sRGB_CHECK_PROFILE,\n952\t        PNG_IGNORE_ADLER32,\n953\t        0,\n954\t        10,\n955\t    ] {\n956\t        for v in [PNG_OPTION_OFF, PNG_OPTION_ON] {\n957\t            sets.push(vec![R::Option(o, v)]);\n958\t        }\n959\t    }\n960\t    sets.push(vec![R::UserLimits(1_000_000, 1_000_000)]);\n961\t    sets.push(vec![R::UserLimits(1, 1)]);\n962\t    sets.push(vec![R::ChunkCacheMax(0)]);\n963\t    sets.push(vec![R::ChunkCacheMax(1)]);\n964\t    sets.push(vec![R::ChunkMallocMax(0)]);\n965\t    sets.push(vec![R::ChunkMallocMax(1)]);\n966\t    sets.push(vec![R::ChunkMallocMax(1 << 20)]);\n967\t    sets.push(vec![R::MngFeatures(PNG_ALL_MNG_FEATURES)]);\n968\t    sets.push(vec![R::MngFeatures(0)]);\n969\t    sets.push(vec![R::Benign(0)]);\n970\t    sets.push(vec![R::Benign(1)]);\n971\t    sets.push(vec![R::CheckInvalidIndex(0)]);\n972\t    sets.push(vec![R::CheckInvalidIndex(1)]);\n973\t    for k in [\n974\t        PNG_HANDLE_CHUNK_AS_DEFAULT,\n975\t        PNG_HANDLE_CHUNK_NEVER,\n976\t        PNG_HANDLE_CHUNK_IF_SAFE,\n977\t        PNG_HANDLE_CHUNK_ALWAYS,\n978\t    ] {\n979\t        sets.push(vec![R::KeepUnknown(k)]);\n980\t    }\n981\t    for (ct, bd) in [\n982\t        (PNG_COLOR_TYPE_GRAY, 8),\n983\t        (PNG_COLOR_TYPE_PALETTE, 4),\n984\t        (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n985\t    ] {\n986\t        unsafe {\n987\t            let src = build(\n988\t                &mut rng,\n989\t                ct,\n990\t                bd,\n991\t                12,\n992\t                6,\n993\t                PNG_INTERLACE_NONE,\n994\t                &[Extra::Gama(45455), Extra::Text, Extra::Srgb(0), Extra::Bkgd],\n995\t            );\n996\t            for ts in &sets {\n997\t                rdiff(\n998\t                    &format!(\"opt ct={} bd={} {:?}\", ct, bd, ts),\n999\t                    &src,\n1000\t                    ts,\n1001\t                    ReadMode::Image,\n1002\t                );\n1003\t            }\n1004\t        }\n1005\t    }\n1006\t}\n1007\t\n1008\t#[test]\n1009\tfn start_read_image_and_update_info_orderings() {\n1010\t    let mut rng = Rng::new(0xaacc_ee00_2244_6677)\n1011\t        ;\n1012\t    for (ct, bd) in legal_ihdr() {\n1013\t        for il in [PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n1014\t            unsafe {\n1015\t                let src = build(&mut rng, ct, bd, 9, 5, il, &[]);\n1016\t                // png_start_read_image instead of png_read_update_info\n1017\t                let mut outs = Vec::new();\n1018\t                for api in both() {\n1019\t                    set_current_api(api);\n1020\t                    diag_reset();\n1021\t                    let sess = ReadSess::new(api, &src.bytes);\n1022\t                    let png = sess.png;\n1023\t                    let info = sess.info;\n1024\t                    let mut rows: Vec<Vec<u8>> = Vec::new();\n1025\t                    let mut rbz = 0usize;\n1026\t                    let ok = guard(|| {\n1027\t                        (api.png_read_info)(png, info);\n1028\t                        (api.png_set_expand)(png);\n1029\t                        (api.png_start_read_image)(png);\n1030\t                        // NB: png_start_read_image does NOT update\n1031\t                        // info_ptr->rowbytes (only png_read_update_info does),\n1032\t                        // so allocate for the largest possible transformed\n1033\t                        // pixel depth (RGBA @ 16 bits = 64) instead.\n1034\t                        rbz = (api.png_get_rowbytes)(png, info);\n1035\t                        let w = (api.png_get_image_width)(png, info);\n1036\t                        let alloc = rowbytes(64, w) + 16;\n1037\t                        let h = (api.png_get_image_height)(png, info);\n1038\t                        let np = if il == PNG_INTERLACE_ADAM7 {\n1039\t                            (api.png_set_interlace_handling)(png)\n1040\t                        } else {\n1041\t                            1\n1042\t                        };\n1043\t                        let mut buf: Vec<Vec<u8>> = (0..h).map(|_| vec![0u8; alloc]).collect();\n1044\t                        for _ in 0..np {\n1045\t                            for y in 0..h as usize {\n1046\t                                (api.png_read_row)(\n1047\t                                    png,\n1048\t                                    buf[y].as_mut_ptr(),\n1049\t                                    std::ptr::null_mut(),\n1050\t                                );\n1051\t                            }\n1052\t                        }\n1053\t                        rows = buf;\n1054\t                        (api.png_read_end)(png, sess.end);\n1055\t                    })\n1056\t                    .is_some();\n1057\t                    outs.push((ok, diag_take(), rbz, rows));\n1058\t                }\n1059\t                assert_eq!(\n1060\t                    outs[0].0, outs[1].0,\n1061\t                    \"start_read_image parity ct={} bd={} il={}\",\n1062\t                    ct, bd, il\n1063\t                );\n1064\t                assert_eq!(outs[0].1, outs[1].1, \"start_read_image diag\");\n1065\t                assert_eq!(outs[0].2, outs[1].2, \"start_read_image rowbytes\");\n1066\t                assert_eq!(outs[0].3, outs[1].3, \"start_read_image rows\");\n1067\t            }\n1068\t        }\n1069\t    }\n1070\t}\n1071\t\n1072\t#[test]\n1073\tfn read_with_signature_already_consumed() {\n1074\t    let mut rng = Rng::new(0xbbdd_ff11_3355_7788);\n1075\t    for (ct, bd) in [(PNG_COLOR_TYPE_RGB, 8), (PNG_COLOR_TYPE_GRAY, 1)] {\n1076\t        unsafe {\n1077\t            let src = build(&mut rng, ct, bd, 7, 3, PNG_INTERLACE_NONE, &[]);\n1078\t            for skip in [0usize, 1, 4, 8] {\n1079\t                let mut outs = Vec::new();\n1080\t                for api in both() {\n1081\t                    set_current_api(api);\n1082\t                    diag_reset();\n1083\t                    let sess = ReadSess::new(api, &src.bytes[skip..]);\n1084\t                    let png = sess.png;\n1085\t                    let info = sess.info;\n1086\t                    let mut rows: Vec<Vec<u8>> = Vec::new();\n1087\t                    let ok = guard(|| {\n1088\t                        (api.png_set_sig_bytes)(png, skip as c_int);\n1089\t                        (api.png_read_info)(png, info);\n1090\t                        let rbz = (api.png_get_rowbytes)(png, info);\n1091\t                        let h = (api.png_get_image_height)(png, info);\n1092\t                        let mut buf: Vec<Vec<u8>> = (0..h).map(|_| vec![0u8; rbz + 8]).collect();\n1093\t                        let mut ptrs: Vec<png_bytep> =\n1094\t                    