{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017oJ1by2fguuAHPGhpCKtau","type":"tool_result","content":"1\t/*\n2\t * Argon2 source code package\n3\t *\n4\t * Written by Daniel Dinu and Dmitry Khovratovich, 2015\n5\t *\n6\t * This work is licensed under a Creative Commons CC0 1.0 License/Waiver.\n7\t *\n8\t * You should have received a copy of the CC0 Public Domain Dedication along\n9\t * with\n10\t * this software. If not, see\n11\t * <http://creativecommons.org/publicdomain/zero/1.0/>.\n12\t */\n13\t\n14\t#include <limits.h>\n15\t#include <stddef.h>\n16\t#include <stdint.h>\n17\t#include <stdlib.h>\n18\t#include <string.h>\n19\t\n20\t#include \"randombytes.h\"\n21\t#include \"utils.h\"\n22\t\n23\t#include \"argon2-core.h\"\n24\t#include \"argon2-encoding.h\"\n25\t#include \"argon2.h\"\n26\t\n27\tint\n28\targon2_ctx(argon2_context *context, argon2_type type)\n29\t{\n30\t    /* 1. Validate all inputs */\n31\t    int               result = argon2_validate_inputs(context);\n32\t    uint32_t          memory_blocks, segment_length;\n33\t    uint32_t          pass;\n34\t    argon2_instance_t instance;\n35\t\n36\t    if (ARGON2_OK != result) {\n37\t        return result; /* LCOV_EXCL_LINE */\n38\t    }\n39\t\n40\t    if (type != Argon2_id && type != Argon2_i) {\n41\t        return ARGON2_INCORRECT_TYPE; /* LCOV_EXCL_LINE */\n42\t    }\n43\t\n44\t    /* 2. Align memory size */\n45\t    /* Minimum memory_blocks = 8L blocks, where L is the number of lanes */\n46\t    memory_blocks = context->m_cost;\n47\t\n48\t    if (memory_blocks < 2 * ARGON2_SYNC_POINTS * context->lanes) {\n49\t        memory_blocks = 2 * ARGON2_SYNC_POINTS * context->lanes; /* LCOV_EXCL_LINE */\n50\t    }\n51\t\n52\t    segment_length = memory_blocks / (context->lanes * ARGON2_SYNC_POINTS);\n53\t    /* Ensure that all segments have equal length */\n54\t    memory_blocks = segment_length * (context->lanes * ARGON2_SYNC_POINTS);\n55\t\n56\t    instance.region         = NULL;\n57\t    instance.passes         = context->t_cost;\n58\t    instance.current_pass   = ~ 0U;\n59\t    instance.memory_blocks  = memory_blocks;\n60\t    instance.segment_length = segment_length;\n61\t    instance.lane_length    = segment_length * ARGON2_SYNC_POINTS;\n62\t    instance.lanes          = context->lanes;\n63\t    instance.threads        = context->threads;\n64\t    instance.type           = type;\n65\t\n66\t    /* 3. Initialization: Hashing inputs, allocating memory, filling first\n67\t     * blocks\n68\t     */\n69\t    result = argon2_initialize(&instance, context);\n70\t\n71\t    if (ARGON2_OK != result) {\n72\t        return result; /* LCOV_EXCL_LINE */\n73\t    }\n74\t\n75\t    /* 4. Filling memory */\n76\t    for (pass = 0; pass < instance.passes; pass++) {\n77\t        argon2_fill_memory_blocks(&instance, pass);\n78\t    }\n79\t\n80\t    /* 5. Finalization */\n81\t    argon2_finalize(context, &instance);\n82\t\n83\t    return ARGON2_OK;\n84\t}\n85\t\n86\tint\n87\targon2_hash(const uint32_t t_cost, const uint32_t m_cost,\n88\t            const uint32_t parallelism, const void *pwd, const size_t pwdlen,\n89\t            const void *salt, const size_t saltlen, void *hash,\n90\t            const size_t hashlen, char *encoded, const size_t encodedlen,\n91\t            argon2_type type)\n92\t{\n93\t    argon2_context context;\n94\t    int            result;\n95\t    uint8_t       *out;\n96\t\n97\t    if (hash != NULL) {\n98\t        randombytes_buf(hash, hashlen);\n99\t    }\n100\t\n101\t    if (pwdlen > ARGON2_MAX_PWD_LENGTH) {\n102\t        return ARGON2_PWD_TOO_LONG; /* LCOV_EXCL_LINE */\n103\t    }\n104\t\n105\t    if (hashlen > ARGON2_MAX_OUTLEN) {\n106\t        return ARGON2_OUTPUT_TOO_LONG; /* LCOV_EXCL_LINE */\n107\t    }\n108\t\n109\t    if (saltlen > ARGON2_MAX_SALT_LENGTH) {\n110\t        return ARGON2_SALT_TOO_LONG; /* LCOV_EXCL_LINE */\n111\t    }\n112\t\n113\t    out = (uint8_t *) malloc(hashlen);\n114\t    if (!out) {\n115\t        return ARGON2_MEMORY_ALLOCATION_ERROR; /* LCOV_EXCL_LINE */\n116\t    }\n117\t\n118\t    context.out       = (uint8_t *) out;\n119\t    context.outlen    = (uint32_t) hashlen;\n120\t    context.pwd       = (uint8_t *) pwd;\n121\t    context.pwdlen    = (uint32_t) pwdlen;\n122\t    context.salt      = (uint8_t *) salt;\n123\t    context.saltlen   = (uint32_t) saltlen;\n124\t    context.secret    = NULL;\n125\t    context.secretlen = 0;\n126\t    context.ad        = NULL;\n127\t    context.adlen     = 0;\n128\t    context.t_cost    = t_cost;\n129\t    context.m_cost    = m_cost;\n130\t    context.lanes     = parallelism;\n131\t    context.threads   = parallelism;\n132\t    context.flags     = ARGON2_DEFAULT_FLAGS;\n133\t\n134\t    result = argon2_ctx(&context, type);\n135\t\n136\t    /* LCOV_EXCL_START */\n137\t    if (result != ARGON2_OK) {\n138\t        sodium_memzero(out, hashlen);\n139\t        free(out);\n140\t        return result;\n141\t    }\n142\t    /* LCOV_EXCL_STOP */\n143\t\n144\t    /* if encoding requested, write it */\n145\t    if (encoded && encodedlen) {\n146\t        if (argon2_encode_string(encoded, encodedlen,\n147\t                                 &context, type) != ARGON2_OK) {\n148\t            /* LCOV_EXCL_START */\n149\t            sodium_memzero(out, hashlen);\n150\t            sodium_memzero(encoded, encodedlen);\n151\t            free(out);\n152\t            return ARGON2_ENCODING_FAIL;\n153\t            /* LCOV_EXCL_STOP */\n154\t        }\n155\t    }\n156\t\n157\t    /* if raw hash requested, write it */\n158\t    if (hash) {\n159\t        memcpy(hash, out, hashlen);\n160\t    }\n161\t\n162\t    sodium_memzero(out, hashlen);\n163\t    free(out);\n164\t\n165\t    return ARGON2_OK;\n166\t}\n167\t\n168\tint\n169\targon2i_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n170\t                     const uint32_t parallelism, const void *pwd,\n171\t                     const size_t pwdlen, const void *salt,\n172\t                     const size_t saltlen, const size_t hashlen, char *encoded,\n173\t                     const size_t encodedlen)\n174\t{\n175\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n176\t                       NULL, hashlen, encoded, encodedlen, Argon2_i);\n177\t}\n178\t\n179\tint\n180\targon2i_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n181\t                 const uint32_t parallelism, const void *pwd,\n182\t                 const size_t pwdlen, const void *salt, const size_t saltlen,\n183\t                 void *hash, const size_t hashlen)\n184\t{\n185\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n186\t                       hash, hashlen, NULL, 0, Argon2_i);\n187\t}\n188\t\n189\tint\n190\targon2id_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n191\t                      const uint32_t parallelism, const void *pwd,\n192\t                      const size_t pwdlen, const void *salt,\n193\t                      const size_t saltlen, const size_t hashlen, char *encoded,\n194\t                      const size_t encodedlen)\n195\t{\n196\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n197\t                       NULL, hashlen, encoded, encodedlen, Argon2_id);\n198\t}\n199\t\n200\tint\n201\targon2id_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n202\t                  const uint32_t parallelism, const void *pwd,\n203\t                  const size_t pwdlen, const void *salt, const size_t saltlen,\n204\t                  void *hash, const size_t hashlen)\n205\t{\n206\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n207\t                       hash, hashlen, NULL, 0, Argon2_id);\n208\t}\n209\t\n210\tint\n211\targon2_verify(const char *encoded, const void *pwd, const size_t pwdlen,\n212\t              argon2_type type)\n213\t{\n214\t    argon2_context ctx;\n215\t    uint8_t       *out;\n216\t    int            decode_result;\n217\t    int            ret;\n218\t    size_t         encoded_len;\n219\t\n220\t    memset(&ctx, 0, sizeof ctx);\n221\t\n222\t    ctx.pwd       = NULL;\n223\t    ctx.pwdlen    = 0;\n224\t    ctx.secret    = NULL;\n225\t    ctx.secretlen = 0;\n226\t\n227\t    /* max values, to be updated in argon2_decode_string */\n228\t    encoded_len = strlen(encoded);\n229\t    if (encoded_len > UINT32_MAX) {\n230\t        return ARGON2_DECODING_LENGTH_FAIL; /* LCOV_EXCL_LINE */\n231\t    }\n232\t    ctx.adlen   = (uint32_t) encoded_len;\n233\t    ctx.saltlen = (uint32_t) encoded_len;\n234\t    ctx.outlen  = (uint32_t) encoded_len;\n235\t\n236\t    ctx.ad   = (uint8_t *) malloc(ctx.adlen);\n237\t    ctx.salt = (uint8_t *) malloc(ctx.saltlen);\n238\t    ctx.out  = (uint8_t *) malloc(ctx.outlen);\n239\t    /* LCOV_EXCL_START */\n240\t    if (!ctx.out || !ctx.salt || !ctx.ad) {\n241\t        free(ctx.ad);\n242\t        free(ctx.salt);\n243\t        free(ctx.out);\n244\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n245\t    }\n246\t    /* LCOV_EXCL_STOP */\n247\t    out = (uint8_t *) malloc(ctx.outlen);\n248\t    if (!out) {\n249\t        /* LCOV_EXCL_START */\n250\t        free(ctx.ad);\n251\t        free(ctx.salt);\n252\t        free(ctx.out);\n253\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n254\t        /* LCOV_EXCL_STOP */\n255\t    }\n256\t\n257\t    decode_result = argon2_decode_string(&ctx, encoded, type);\n258\t    if (decode_result != ARGON2_OK) {\n259\t        free(ctx.ad);\n260\t        free(ctx.salt);\n261\t        free(ctx.out);\n262\t        free(out);\n263\t        return decode_result;\n264\t    }\n265\t\n266\t    ret = argon2_hash(ctx.t_cost, ctx.m_cost, ctx.threads, pwd, pwdlen,\n267\t                      ctx.salt, ctx.saltlen, out, ctx.outlen, NULL, 0, type);\n268\t\n269\t    free(ctx.ad);\n270\t    free(ctx.salt);\n271\t\n272\t    if (ret == ARGON2_OK && sodium_memcmp(out, ctx.out, ctx.outlen) != 0) {\n273\t        ret = ARGON2_VERIFY_MISMATCH;\n274\t    }\n275\t    free(out);\n276\t    free(ctx.out);\n277\t\n278\t    return ret;\n279\t}\n280\t\n281\tint\n282\targon2i_verify(const char *encoded, const void *pwd, const size_t pwdlen)\n283\t{\n284\t    return argon2_verify(encoded, pwd, pwdlen, Argon2_i);\n285\t}\n286\t\n287\tint\n288\targon2id_verify(const char *encoded, const void *pwd, const size_t pwdlen)\n289\t{\n290\t    return argon2_verify(encoded, pwd, pwdlen, Argon2_id);\n291\t}\n292\t"}]},"parent_tool_use_id":"toolu_bdrk_013PupbdJbvdcm1hFvbZnzS8","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"b10d617f-f1fb-43b1-9fdb-bff8dcfd8832","timestamp":"2026-08-31T03:48:26.805Z","subagent_type":"general-purpose","task_description":"Phase B/C tests area 8"}
