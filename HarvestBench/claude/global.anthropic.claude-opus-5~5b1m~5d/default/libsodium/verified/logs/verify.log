{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EGgs5cUCFLJff28kjc4Lzo","type":"tool_result","content":"1\t//! Area 2, part 2 — `crypto_core/salsa`, `hsalsa20`, `hchacha20`, `keccak1600`.\n2\t//!\n3\t//! Covers `configs_2.md` rows 2.11 - 2.41.  None of these functions has a\n4\t//! rejection branch (see the \"total-function note\" in `errors_2.md`), so the\n5\t//! error surface here is only \"no out-of-range behaviour / no OOB write\".\n6\tmod common;\n7\tuse common::*;\n8\tuse std::ffi::{c_int, c_void};\n9\t\n10\ttype Core4 = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> c_int;\n11\ttype Getter = unsafe extern \"C\" fn() -> usize;\n12\t\n13\t// ---------------------------------------------------------------- shared bits\n14\t\n15\tfn getters(pairs: &[(&str, usize)]) {\n16\t    for (name, want) in pairs {\n17\t        assert!(has(name), \"{name} must be exported by both libraries\");\n18\t        let (c, r) = both::<Getter>(name);\n19\t        let (vc, vr) = unsafe { (c(), r()) };\n20\t        assert_eq!(vc, vr, \"{name}: C {vc} vs Rust {vr}\");\n21\t        assert_eq!(vc, *want, \"{name}: C returned {vc}, header says {want}\");\n22\t    }\n23\t}\n24\t\n25\t/// Drive a `crypto_core_*` primitive on both libraries and compare the output\n26\t/// (with out-of-bounds guard bytes) for one `(in, k, c)` triple.\n27\t#[track_caller]\n28\tfn core_case(\n29\t    c: &Core4,\n30\t    r: &Core4,\n31\t    outlen: usize,\n32\t    input: &[u8],\n33\t    key: &[u8],\n34\t    konst: Option<&[u8]>,\n35\t    label: &str,\n36\t) -> Vec<u8> {\n37\t    let kp = konst.map(|x| x.as_ptr()).unwrap_or(std::ptr::null());\n38\t    let mut oc = padded(outlen);\n39\t    let mut or = padded(outlen);\n40\t    let rc = unsafe { c(oc.as_mut_ptr(), input.as_ptr(), key.as_ptr(), kp) };\n41\t    let rr = unsafe { r(or.as_mut_ptr(), input.as_ptr(), key.as_ptr(), kp) };\n42\t    eqi(&format!(\"{label} ret\"), rc, rr);\n43\t    assert_eq!(rc, 0, \"{label}: C must always return 0\");\n44\t    eqb(&format!(\"{label} out\"), &oc[..outlen], &or[..outlen]);\n45\t    check_pad(&format!(\"{label}(C)\"), &oc, outlen);\n46\t    check_pad(&format!(\"{label}(Rust)\"), &or, outlen);\n47\t    oc[..outlen].to_vec()\n48\t}\n49\t\n50\t/// A generic sweep over the `(in, k, c)` shape used by all four core functions.\n51\tfn core_family(name: &str, outlen: usize, inlen: usize, keylen: usize, clen: usize, seed: u64) {\n52\t    assert!(has(name), \"{name} must be exported by both libraries\");\n53\t    let (c, r) = both::<Core4>(name);\n54\t    let mut rng = Rng::new(seed);\n55\t\n56\t    // c == NULL (built-in sigma) and c != NULL (custom constant), all-zero,\n57\t    // all-0xff and random inputs.\n58\t    let specials: [Vec<u8>; 3] = [vec![0u8; 64], vec![0xffu8; 64], vec![0x80u8; 64]];\n59\t    for sk in &specials {\n60\t        for si in &specials {\n61\t            for kc in [None, Some(vec![0u8; clen]), Some(vec![0xffu8; clen])] {\n62\t                core_case(&c, &r, outlen, &si[..inlen], &sk[..keylen], kc.as_deref(), name);\n63\t            }\n64\t        }\n65\t    }\n66\t    for _ in 0..1500 {\n67\t        let input = rng.bytes(inlen);\n68\t        let key = rng.bytes(keylen);\n69\t        // c == NULL\n70\t        core_case(&c, &r, outlen, &input, &key, None, name);\n71\t        // c != NULL, random constant\n72\t        let k = rng.bytes(clen);\n73\t        core_case(&c, &r, outlen, &input, &key, Some(&k), name);\n74\t    }\n75\t    // single-bit sweeps: flip every bit of the key, of `in`, and of `c`\n76\t    let base_in = rng.bytes(inlen);\n77\t    let base_key = rng.bytes(keylen);\n78\t    let base_c = rng.bytes(clen);\n79\t    for i in 0..keylen * 8 {\n80\t        let mut k = base_key.clone();\n81\t        k[i / 8] ^= 1 << (i % 8);\n82\t        core_case(&c, &r, outlen, &base_in, &k, None, name);\n83\t        core_case(&c, &r, outlen, &base_in, &k, Some(&base_c), name);\n84\t    }\n85\t    for i in 0..inlen * 8 {\n86\t        let mut v = base_in.clone();\n87\t        v[i / 8] ^= 1 << (i % 8);\n88\t        core_case(&c, &r, outlen, &v, &base_key, None, name);\n89\t    }\n90\t    for i in 0..clen * 8 {\n91\t        let mut v = base_c.clone();\n92\t        v[i / 8] ^= 1 << (i % 8);\n93\t        core_case(&c, &r, outlen, &base_in, &base_key, Some(&v), name);\n94\t    }\n95\t}\n96\t\n97\t// -------------------------------------------------------------------- salsa20\n98\t\n99\t/// Rows 2.11 - 2.13 (`salsa20`), 2.14/2.15 (`salsa2012`), 2.16/2.17 (`salsa208`).\n100\t#[test]\n101\tfn salsa20_all_configs() {\n102\t    core_family(\"crypto_core_salsa20\", 64, 16, 32, 16, 0x2_0011);\n103\t}\n104\t\n105\t#[test]\n106\tfn salsa2012_all_configs() {\n107\t    core_family(\"crypto_core_salsa2012\", 64, 16, 32, 16, 0x2_0014);\n108\t}\n109\t\n110\t#[test]\n111\tfn salsa208_all_configs() {\n112\t    core_family(\"crypto_core_salsa208\", 64, 16, 32, 16, 0x2_0016);\n113\t}\n114\t\n115\t/// Row 2.13 / 2.22 / 2.26 — the canonical all-zero vectors, checked explicitly.\n116\t#[test]\n117\tfn salsa_family_zero_vectors() {\n118\t    for name in [\n119\t        \"crypto_core_salsa20\",\n120\t        \"crypto_core_salsa2012\",\n121\t        \"crypto_core_salsa208\",\n122\t    ] {\n123\t        let (c, r) = both::<Core4>(name);\n124\t        let z16 = [0u8; 16];\n125\t        let z32 = [0u8; 32];\n126\t        core_case(&c, &r, 64, &z16, &z32, None, name);\n127\t        core_case(&c, &r, 64, &z16, &z32, Some(&z16), name);\n128\t    }\n129\t}\n130\t\n131\t/// Row 2.18 — the only difference between the three families is the round\n132\t/// count, so identical inputs must give three *different* outputs.\n133\t#[test]\n134\tfn salsa_round_counts_differ() {\n135\t    let (c20, r20) = both::<Core4>(\"crypto_core_salsa20\");\n136\t    let (c12, r12) = both::<Core4>(\"crypto_core_salsa2012\");\n137\t    let (c8, r8) = both::<Core4>(\"crypto_core_salsa208\");\n138\t    let mut rng = Rng::new(0x2_0018);\n139\t    for _ in 0..300 {\n140\t        let input = rng.bytes(16);\n141\t        let key = rng.bytes(32);\n142\t        let konst = rng.bytes(16);\n143\t        for kc in [None, Some(&konst[..])] {\n144\t            let o20 = core_case(&c20, &r20, 64, &input, &key, kc, \"salsa20\");\n145\t            let o12 = core_case(&c12, &r12, 64, &input, &key, kc, \"salsa2012\");\n146\t            let o8 = core_case(&c8, &r8, 64, &input, &key, kc, \"salsa208\");\n147\t            assert_ne!(o20, o12, \"salsa20 and salsa2012 must differ\");\n148\t            assert_ne!(o20, o8, \"salsa20 and salsa208 must differ\");\n149\t            assert_ne!(o12, o8, \"salsa2012 and salsa208 must differ\");\n150\t        }\n151\t    }\n152\t}\n153\t\n154\t/// Row 2.19 — the twelve salsa constant getters.\n155\t#[test]\n156\tfn salsa_getters() {\n157\t    getters(&[\n158\t        (\"crypto_core_salsa20_outputbytes\", 64),\n159\t        (\"crypto_core_salsa20_inputbytes\", 16),\n160\t        (\"crypto_core_salsa20_keybytes\", 32),\n161\t        (\"crypto_core_salsa20_constbytes\", 16),\n162\t        (\"crypto_core_salsa2012_outputbytes\", 64),\n163\t        (\"crypto_core_salsa2012_inputbytes\", 16),\n164\t        (\"crypto_core_salsa2012_keybytes\", 32),\n165\t        (\"crypto_core_salsa2012_constbytes\", 16),\n166\t        (\"crypto_core_salsa208_outputbytes\", 64),\n167\t        (\"crypto_core_salsa208_inputbytes\", 16),\n168\t        (\"crypto_core_salsa208_keybytes\", 32),\n169\t        (\"crypto_core_salsa208_constbytes\", 16),\n170\t    ]);\n171\t}\n172\t\n173\t// ------------------------------------------------------------------- hsalsa20\n174\t\n175\t/// Rows 2.20 - 2.22.\n176\t#[test]\n177\tfn hsalsa20_all_configs() {\n178\t    core_family(\"crypto_core_hsalsa20\", 32, 16, 32, 16, 0x2_0020);\n179\t}\n180\t\n181\t/// Row 2.23.\n182\t#[test]\n183\tfn hsalsa20_getters() {\n184\t    getters(&[\n185\t        (\"crypto_core_hsalsa20_outputbytes\", 32),\n186\t        (\"crypto_core_hsalsa20_inputbytes\", 16),\n187\t        (\"crypto_core_hsalsa20_keybytes\", 32),\n188\t        (\"crypto_core_hsalsa20_constbytes\", 16),\n189\t    ]);\n190\t}\n191\t\n192\t// ------------------------------------------------------------------ hchacha20\n193\t\n194\t/// Rows 2.24 - 2.26.\n195\t#[test]\n196\tfn hchacha20_all_configs() {\n197\t    core_family(\"crypto_core_hchacha20\", 32, 16, 32, 16, 0x2_0024);\n198\t}\n199\t\n200\t/// Row 2.27.\n201\t#[test]\n202\tfn hchacha20_getters() {\n203\t    getters(&[\n204\t        (\"crypto_core_hchacha20_outputbytes\", 32),\n205\t        (\"crypto_core_hchacha20_inputbytes\", 16),\n206\t        (\"crypto_core_hchacha20_keybytes\", 32),\n207\t        (\"crypto_core_hchacha20_constbytes\", 16),\n208\t    ]);\n209\t}\n210\t\n211\t/// hsalsa20 and hchacha20 both produce 32 bytes from the same shapes but are\n212\t/// different permutations, so they must never agree.\n213\t#[test]\n214\tfn hsalsa20_and_hchacha20_differ() {\n215\t    let (cs, rs) = both::<Core4>(\"crypto_core_hsalsa20\");\n216\t    let (cc, rc) = both::<Core4>(\"crypto_core_hchacha20\");\n217\t    let mut rng = Rng::new(0x2_0026);\n218\t    for _ in 0..300 {\n219\t        let input = rng.bytes(16);\n220\t        let key = rng.bytes(32);\n221\t        let a = core_case(&cs, &rs, 32, &input, &key, None, \"hsalsa20\");\n222\t        let b = core_case(&cc, &rc, 32, &input, &key, None, \"hchacha20\");\n223\t        assert_ne!(a, b);\n224\t    }\n225\t}\n226\t\n227\t// ----------------------------------------------------------------- keccak1600\n228\t\n229\tconst KECCAK_STATEBYTES: usize = 200;\n230\tconst KECCAK_STRUCTBYTES: usize = 224;\n231\t\n232\t#[repr(C, align(16))]\n233\tstruct KState([u8; KECCAK_STRUCTBYTES + PAD]);\n234\t\n235\timpl KState {\n236\t    fn new() -> Box<KState> {\n237\t        let mut s = Box::new(KState([0u8; KECCAK_STRUCTBYTES + PAD]));\n238\t        for (i, b) in s.0[KECCAK_STRUCTBYTES..].iter_mut().enumerate() {\n239\t            *b = 0xA5u8.wrapping_add(i as u8);\n240\t        }\n241\t        s\n242\t    }\n243\t    fn ptr(&mut self) -> *mut c_void {\n244\t        self.0.as_mut_ptr() as *mut c_void\n245\t    }\n246\t    fn body(&self) -> &[u8] {\n247\t        &self.0[..KECCAK_STRUCTBYTES]\n248\t    }\n249\t}\n250\t\n251\ttype KInit = unsafe extern \"C\" fn(*mut c_void);\n252\ttype KPermute = unsafe extern \"C\" fn(*mut c_void);\n253\ttype KXor = unsafe extern \"C\" fn(*mut c_void, *const u8, usize, usize);\n254\ttype KExtract = unsafe extern \"C\" fn(*const c_void, *mut u8, usize, usize);\n255\t\n256\tstruct Keccak {\n257\t    init: (libloading::Symbol<'static, KInit>, libloading::Symbol<'static, KInit>),\n258\t    p24: (libloading::Symbol<'static, KPermute>, libloading::Symbol<'static, KPermute>),\n259\t    p12: (libloading::Symbol<'static, KPermute>, libloading::Symbol<'static, KPermute>),\n260\t    xor: (libloading::Symbol<'static, KXor>, libloading::Symbol<'static, KXor>),\n261\t    ext: (libloading::Symbol<'static, KExtract>, libloading::Symbol<'static, KExtract>),\n262\t}\n263\t\n264\timpl Keccak {\n265\t    /// `private` selects the internal `_sodium_keccak1600_ref_*` entry points\n266\t    /// instead of the public `crypto_core_keccak1600_*` wrappers.\n267\t    fn new(private: bool) -> Self {\n268\t        let p = |s: &str, q: &str| -> String {\n269\t            if private { format!(\"_sodium_keccak1600_ref_{s}\") } else { format!(\"crypto_core_keccak1600_{q}\") }\n270\t        };\n271\t        Keccak {\n272\t            init: both(&p(\"init\", \"init\")),\n273\t            p24: both(&p(\"permute_24\", \"permute_24\")),\n274\t            p12: both(&p(\"permute_12\", \"permute_12\")),\n275\t            xor: both(&p(\"xor_bytes\", \"xor_bytes\")),\n276\t            ext: both(&p(\"extract_bytes\", \"extract_bytes\")),\n277\t        }\n278\t    }\n279\t}\n280\t\n281\t/// One differential keccak scenario: a program of operations replayed against\n282\t/// both libraries, comparing the whole 224-byte state after each step.\n283\t#[derive(Clone, Debug)]\n284\tenum Op {\n285\t    Init,\n286\t    Permute24,\n287\t    Permute12,\n288\t    Xor(usize, usize, u64), // offset, length, data seed\n289\t    Extract(usize, usize),  // offset, length\n290\t}\n291\t\n292\tfn run_keccak_program(k: &Keccak, ops: &[Op], label: &str) {\n293\t    let mut sc = KState::new();\n294\t    let mut sr = KState::new();\n295\t    for (step, op) in ops.iter().enumerate() {\n296\t        let tag = format!(\"{label} step{step} {op:?}\");\n297\t        match *op {\n298\t            Op::Init => unsafe {\n299\t                (k.init.0)(sc.ptr());\n300\t                (k.init.1)(sr.ptr());\n301\t            },\n302\t            Op::Permute24 => unsafe {\n303\t                (k.p24.0)(sc.ptr());\n304\t                (k.p24.1)(sr.ptr());\n305\t            },\n306\t            Op::Permute12 => unsafe {\n307\t                (k.p12.0)(sc.ptr());\n308\t                (k.p12.1)(sr.ptr());\n309\t            },\n310\t            Op::Xor(off, len, seed) => {\n311\t                let data = Rng::new(seed).bytes(len.max(1));\n312\t                unsafe {\n313\t                    (k.xor.0)(sc.ptr(), data.as_ptr(), off, len);\n314\t                    (k.xor.1)(sr.ptr(), data.as_ptr(), off, len);\n315\t                }\n316\t            }\n317\t            Op::Extract(off, len) => {\n318\t                let mut oc = padded(len);\n319\t                let mut or = padded(len);\n320\t                unsafe {\n321\t                    (k.ext.0)(sc.ptr() as *const c_void, oc.as_mut_ptr(), off, len);\n322\t                    (k.ext.1)(sr.ptr() as *const c_void, or.as_mut_ptr(), off, len);\n323\t                }\n324\t                eqb(&format!(\"{tag} extracted\"), &oc[..len], &or[..len]);\n325\t                check_pad(&format!(\"{tag} extract(C)\"), &oc, len);\n326\t                check_pad(&format!(\"{tag} extract(Rust)\"), &or, len);\n327\t                // extract must agree with the state we already compared\n328\t                assert_eq!(&oc[..len], &sc.body()[off..off + len], \"{tag}: C extract != state\");\n329\t            }\n330\t        }\n331\t        eqb(&format!(\"{tag} state\"), sc.body(), sr.body());\n332\t        check_pad(&format!(\"{tag} guard(C)\"), &sc.0, KECCAK_STRUCTBYTES);\n333\t        check_pad(&format!(\"{tag} guard(Rust)\"), &sr.0, KECCAK_STRUCTBYTES);\n334\t    }\n335\t}\n336\t\n337\t/// Row 2.28 — `crypto_core_keccak1600_statebytes()`.\n338\t#[test]\n339\tfn keccak1600_statebytes() {\n340\t    getters(&[(\"crypto_core_keccak1600_statebytes\", KECCAK_STRUCTBYTES)]);\n341\t    // `init` must only clear the first 200 bytes; the remaining 24 padding\n342\t    // bytes of the 224-byte struct are left alone by both implementations.\n343\t    let k = Keccak::new(false);\n344\t    let mut sc = KState::new();\n345\t    let mut sr = KState::new();\n346\t    for i in 0..KECCAK_STRUCTBYTES {\n347\t        sc.0[i] = 0x3c;\n348\t        sr.0[i] = 0x3c;\n349\t    }\n350\t    unsafe {\n351\t        (k.init.0)(sc.ptr());\n352\t        (k.init.1)(sr.ptr());\n353\t    }\n354\t    eqb(\"keccak1600_init partial clear\", sc.body(), sr.body());\n355\t    assert!(sc.body()[..KECCAK_STATEBYTES].iter().all(|&b| b == 0));\n356\t    assert!(sc.body()[KECCAK_STATEBYTES..].iter().all(|&b| b == 0x3c));\n357\t}\n358\t\n359\t/// Rows 2.29 - 2.33 — permutations from the zero state and from non-trivial\n360\t/// states, applied repeatedly.\n361\t#[test]\n362\tfn keccak1600_permutations() {\n363\t    for private in [false, true] {\n364\t        let k = Keccak::new(private);\n365\t        let tag = if private { \"ref\" } else { \"public\" };\n366\t\n367\t        // 2.29 / 2.30: all-zero state -> permute_24 / permute_12\n368\t        run_keccak_program(&k, &[Op::Init, Op::Permute24, Op::Extract(0, KECCAK_STATEBYTES)], &format!(\"{tag} zero+p24\"));\n369\t        run_keccak_program(&k, &[Op::Init, Op::Permute12, Op::Extract(0, KECCAK_STATEBYTES)], &format!(\"{tag} zero+p12\"));\n370\t\n371\t        // 2.31: permute_24 applied repeatedly, state carried across\n372\t        let mut ops = vec![Op::Init];\n373\t        for _ in 0..8 {\n374\t            ops.push(Op::Permute24);\n375\t            ops.push(Op::Extract(0, KECCAK_STATEBYTES));\n376\t        }\n377\t        run_keccak_program(&k, &ops, &format!(\"{tag} p24 x8\"));\n378\t        let mut ops = vec![Op::Init];\n379\t        for _ in 0..8 {\n380\t            ops.push(Op::Permute12);\n381\t            ops.push(Op::Extract(0, KECCAK_STATEBYTES));\n382\t        }\n383\t        run_keccak_program(&k, &ops, &format!(\"{tag} p12 x8\"));\n384\t\n385\t        // 2.32 / 2.33: init -> xor a rate-sized block -> permute\n386\t        for rate in [72usize, 104, 136, 144, 168, KECCAK_STATEBYTES] {\n387\t            run_keccak_program(\n388\t                &k,\n389\t                &[Op::Init, Op::Xor(0, rate, 0xabc0 + rate as u64), Op::Permute24, Op::Extract(0, KECCAK_STATEBYTES)],\n390\t                &format!(\"{tag} rate{rate}+p24\"),\n391\t            );\n392\t            run_keccak_program(\n393\t                &k,\n394\t                &[Op::Init, Op::Xor(0, rate, 0xdef0 + rate as u64), Op::Permute12, Op::Extract(0, KECCAK_STATEBYTES)],\n395\t                &format!(\"{tag} rate{rate}+p12\"),\n396\t            );\n397\t        }\n398\t    }\n399\t}\n400\t\n401\t/// The 12-round permutation must use a different round-constant window than\n402\t/// the 24-round one (row 2.30), so their outputs cannot coincide.\n403\t#[test]\n404\tfn keccak1600_p12_differs_from_p24() {\n405\t    let k = Keccak::new(false);\n406\t    let mut a = KState::new();\n407\t    let mut b = KState::new();\n408\t    unsafe {\n409\t        (k.init.0)(a.ptr());\n410\t        (k.init.0)(b.ptr());\n411\t        (k.p24.0)(a.ptr());\n412\t        (k.p12.0)(b.ptr());\n413\t    }\n414\t    assert_ne!(a.body(), b.body(), \"permute_24 and permute_12 must differ\");\n415\t}\n416\t\n417\t/// Rows 2.34 - 2.38 — every `xor_bytes` loop combination.\n418\t#[test]\n419\tfn keccak1600_xor_bytes_shapes() {\n420\t    for private in [false, true] {\n421\t        let k = Keccak::new(private);\n422\t        let tag = if private { \"ref\" } else { \"public\" };\n423\t        let mut cases: Vec<Op> = Vec::new();\n424\t\n425\t        // 2.34: offset 0, length a multiple of 8 (only the 8-byte loop runs)\n426\t        for len in [0usize, 8, 16, 72, 104, 136, 144, 168, 192, KECCAK_STATEBYTES] {\n427\t            cases.push(Op::Xor(0, len, 0x100 + len as u64));\n428\t        }\n429\t        // 2.35: unaligned offset with a <8 tail (all three loops run)\n430\t        for off in 1..8usize {\n431\t            for len in [1usize, 7, 8, 9, 15, 16, 23, 100, 137] {\n432\t                if off + len <= KECCAK_STATEBYTES {\n433\t                    cases.push(Op::Xor(off, len, 0x200 + (off * 1000 + len) as u64));\n434\t                }\n435\t            }\n436\t        }\n437\t        // 2.36: offset 0, 0 < length < 8 (only the trailing loop runs)\n438\t        for len in 1..8usize {\n439\t            cases.push(Op::Xor(0, len, 0x300 + len as u64));\n440\t        }\n441\t        // 2.37: length == 0 for every offset (complete no-op)\n442\t        for off in 0..=KECCAK_STATEBYTES {\n443\t            cases.push(Op::Xor(off, 0, 0x400));\n444\t        }\n445\t        // 2.38: offset + length == 200 exactly\n446\t        for off in 0..=KECCAK_STATEBYTES {\n447\t            cases.push(Op::Xor(off, KECCAK_STATEBYTES - off, 0x500 + off as u64));\n448\t        }\n449\t        // each case on a fresh zero state, and again on a permuted state\n450\t        for op in &cases {\n451\t            run_keccak_program(&k, &[Op::Init, op.clone(), Op::Extract(0, KECCAK_STATEBYTES)], &format!(\"{tag} xor-fresh\"));\n452\t        }\n453\t        // and all of them chained onto one evolving state\n454\t        let mut ops = vec![Op::Init, Op::Xor(0, 136, 9), Op::Permute24];\n455\t        ops.extend(cases.iter().cloned());\n456\t        ops.push(Op::Extract(0, KECCAK_STATEBYTES));\n457\t        run_keccak_program(&k, &ops, &format!(\"{tag} xor-chained\"));\n458\t    }\n459\t}\n460\t\n461\t/// Rows 2.39 - 2.41 — every `extract_bytes` shape.\n462\t#[test]\n463\tfn keccak1600_extract_bytes_shapes() {\n464\t    for private in [false, true] {\n465\t        let k = Keccak::new(private);\n466\t        let tag = if private { \"ref\" } else { \"public\" };\n467\t        let mut ops = vec![Op::Init, Op::Xor(0, 168, 0x777), Op::Permute24];\n468\t        // 2.39: full state\n469\t        ops.push(Op::Extract(0, KECCAK_STATEBYTES));\n470\t        // 2.41: zero-length extract at every offset\n471\t        for off in 0..=KECCAK_STATEBYTES {\n472\t            ops.push(Op::Extract(off, 0));\n473\t        }\n474\t        // 2.40: partial extracts at every offset\n475\t        for off in 0..KECCAK_STATEBYTES {\n476\t            for len in [1usize, 5, 8, 32, 33] {\n477\t                if off + len <= KECCAK_STATEBYTES {\n478\t                    ops.push(Op::Extract(off, len));\n479\t                }\n480\t            }\n481\t            ops.push(Op::Extract(off, KECCAK_STATEBYTES - off));\n482\t        }\n483\t        run_keccak_program(&k, &ops, &format!(\"{tag} extract\"));\n484\t    }\n485\t}\n486\t\n487\t/// A long randomized program mixing all five operations.\n488\t#[test]\n489\tfn keccak1600_random_programs() {\n490\t    for private in [false, true] {\n491\t        let k = Keccak::new(private);\n492\t        let mut rng = Rng::new(0x2_0034 + private as u64);\n493\t        for prog in 0..40 {\n494\t            let mut ops = vec![Op::Init];\n495\t            for _ in 0..40 {\n496\t                ops.push(match rng.below(5) {\n497\t                    0 => Op::Permute24,\n498\t                    1 => Op::Permute12,\n499\t                    2 | 3 => {\n500\t                        let off = rng.below(KECCAK_STATEBYTES + 1);\n501\t                        let len = rng.below(KECCAK_STATEBYTES - off + 1);\n502\t                        Op::Xor(off, len, rng.next_u64() | 1)\n503\t                    }\n504\t                    _ => {\n505\t                        let off = rng.below(KECCAK_STATEBYTES + 1);\n506\t                        let len = rng.below(KECCAK_STATEBYTES - off + 1);\n507\t                        Op::Extract(off, len)\n508\t                    }\n509\t                });\n510\t            }\n511\t            ops.push(Op::Extract(0, KECCAK_STATEBYTES));\n512\t            run_keccak_program(&k, &ops, &format!(\"prog{prog} private={private}\"));\n513\t        }\n514\t    }\n515\t}\n516\t\n517\t/// The public `crypto_core_keccak1600_*` wrappers must be exactly the\n518\t/// `keccak1600_ref_*` implementations (the build defines no `__ARM_FEATURE_SHA3`).\n519\t#[test]\n520\tfn keccak1600_public_equals_ref() {\n521\t    let pubk = Keccak::new(false);\n522\t    let refk = Keccak::new(true);\n523\t    let mut rng = Rng::new(0x2_0041);\n524\t    for _ in 0..20 {\n525\t        let mut a = KState::new();\n526\t        let mut b = KState::new();\n527\t        unsafe {\n528\t            (pubk.init.0)(a.ptr());\n529\t            (refk.init.0)(b.ptr());\n530\t        }\n531\t        for _ in 0..10 {\n532\t            let off = rng.below(KECCAK_STATEBYTES + 1);\n533\t            let len = rng.below(KECCAK_STATEBYTES - off + 1);\n534\t            let data = rng.bytes(len.max(1));\n535\t            unsafe {\n536\t                (pubk.xor.0)(a.ptr(), data.as_ptr(), off, len);\n537\t                (refk.xor.0)(b.ptr(), data.as_ptr(), off, len);\n538\t                if rng.below(2) == 0 {\n539\t                    (pubk.p24.0)(a.ptr());\n540\t                    (refk.p24.0)(b.ptr());\n541\t                } else {\n542\t                    (pubk.p12.0)(a.ptr());\n543\t                    (refk.p12.0)(b.ptr());\n544\t                }\n545\t            }\n546\t        }\n547\t        assert_eq!(a.body(), b.body(), \"public keccak1600 != keccak1600_ref\");\n548\t    }\n549\t}\n550\t