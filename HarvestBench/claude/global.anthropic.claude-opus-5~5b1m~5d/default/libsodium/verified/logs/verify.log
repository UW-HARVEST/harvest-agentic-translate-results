    personal as *const c_void,\n605\t    )\n606\t}\n607\t\n608\t/// `crypto_generichash_blake2b_init`.\n609\t#[no_mangle]\n610\tpub unsafe extern \"C\" fn crypto_generichash_blake2b_init(\n611\t    state: *mut crypto_generichash_blake2b_state,\n612\t    key: *const u8,\n613\t    keylen: usize,\n614\t    outlen: usize,\n615\t) -> c_int {\n616\t    if outlen == 0 || outlen > BLAKE2B_OUTBYTES || keylen > BLAKE2B_KEYBYTES {\n617\t        return -1;\n618\t    }\n619\t    let s = state.cast::<blake2b_state>();\n620\t    if key.is_null() || keylen == 0 {\n621\t        if _sodium_blake2b_init(s, outlen as u8) != 0 {\n622\t            return -1;\n623\t        }\n624\t    } else if _sodium_blake2b_init_key(s, outlen as u8, key as *const c_void, keylen as u8) != 0 {\n625\t        return -1;\n626\t    }\n627\t    0\n628\t}\n629\t\n630\t/// `crypto_generichash_blake2b_init_salt_personal`.\n631\t#[no_mangle]\n632\tpub unsafe extern \"C\" fn crypto_generichash_blake2b_init_salt_personal(\n633\t    state: *mut crypto_generichash_blake2b_state,\n634\t    key: *const u8,\n635\t    keylen: usize,\n636\t    outlen: usize,\n637\t    salt: *const u8,\n638\t    personal: *const u8,\n639\t) -> c_int {\n640\t    if outlen == 0 || outlen > BLAKE2B_OUTBYTES || keylen > BLAKE2B_KEYBYTES {\n641\t        return -1;\n642\t    }\n643\t    let s = state.cast::<blake2b_state>();\n644\t    if key.is_null() || keylen == 0 {\n645\t        if _sodium_blake2b_init_salt_personal(\n646\t            s,\n647\t            outlen as u8,\n648\t            salt as *const c_void,\n649\t            personal as *const c_void,\n650\t        ) != 0\n651\t        {\n652\t            return -1;\n653\t        }\n654\t    } else if _sodium_blake2b_init_key_salt_personal(\n655\t        s,\n656\t        outlen as u8,\n657\t        key as *const c_void,\n658\t        keylen as u8,\n659\t        salt as *const c_void,\n660\t        personal as *const c_void,\n661\t    ) != 0\n662\t    {\n663\t        return -1;\n664\t    }\n665\t    0\n666\t}\n667\t\n668\t/// `crypto_generichash_blake2b_update`.\n669\t#[no_mangle]\n670\tpub unsafe extern \"C\" fn crypto_generichash_blake2b_update(\n671\t    state: *mut crypto_generichash_blake2b_state,\n672\t    in_: *const u8,\n673\t    inlen: u64,\n674\t) -> c_int {\n675\t    _sodium_blake2b_update(state.cast::<blake2b_state>(), in_, inlen)\n676\t}\n677\t\n678\t/// `crypto_generichash_blake2b_final`.\n679\t#[no_mangle]"}]},"parent_tool_use_id":"toolu_bdrk_019esovLKbek6PhVhz8MDC6r","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"f0fe030f-c7ed-4ded-bed9-c08f47d4f144","timestamp":"2026-08-31T03:58:42.832Z","subagent_type":"general-purpose","task_description":"Area 3 tests: generichash+shorthash"}
