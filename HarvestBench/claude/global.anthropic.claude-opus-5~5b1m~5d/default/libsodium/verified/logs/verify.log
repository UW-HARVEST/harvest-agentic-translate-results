{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016tJHUuvcC24VFvHN7FNYKR","type":"tool_result","content":"1\t//! Area 5 — `crypto_stream`, salsa20 family.\n2\t//!\n3\t//! Covers `configs_5.md` rows 5.11–5.46 (salsa20, salsa2012, salsa208,\n4\t//! xsalsa20) plus the salsa-side error rows of `errors_5.md`\n5\t//! (5.17, 5.18, 5.19, 5.23, 5.25, 5.26, 5.28).\n6\t//!\n7\t//! Sources of truth:\n8\t//!   c_src/libsodium/crypto_stream/salsa20/stream_salsa20.c + ref/salsa20_ref.c\n9\t//!   c_src/libsodium/crypto_stream/salsa2012/{stream_salsa2012.c,ref/stream_salsa2012_ref.c}\n10\t//!   c_src/libsodium/crypto_stream/salsa208/{stream_salsa208.c,ref/stream_salsa208_ref.c}\n11\t//!   c_src/libsodium/crypto_stream/xsalsa20/stream_xsalsa20.c\n12\t\n13\tmod common;\n14\tuse common::*;\n15\tuse std::ffi::{c_int, c_void};\n16\t\n17\t// ------------------------------------------------------------------ signatures\n18\t\n19\ttype Stream = unsafe extern \"C\" fn(*mut u8, u64, *const u8, *const u8) -> c_int;\n20\ttype Xor = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, *const u8) -> c_int;\n21\ttype XorIc64 = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u64, *const u8) -> c_int;\n22\ttype SizeFn = unsafe extern \"C\" fn() -> usize;\n23\ttype Keygen = unsafe extern \"C\" fn(*mut u8);\n24\ttype Core = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> c_int;\n25\t\n26\t// ------------------------------------------------------------------- constants\n27\t\n28\t/// The length sweep **L** from `configs_5.md`.\n29\tconst L: [usize; 16] = [\n30\t    0, 1, 63, 64, 65, 127, 128, 129, 191, 192, 193, 255, 256, 257, 511, 512,\n31\t];\n32\t/// A few multi-KiB lengths.\n33\tconst BIG: [usize; 5] = [1024, 1025, 4096, 8191, 8192];\n34\t\n35\tconst SODIUM_SIZE_MAX: u64 = u64::MAX;\n36\t\n37\t/// NaCl / libsodium `secretbox` test-vector key.\n38\tconst TV_KEY: [u8; 32] = [\n39\t    0x1b, 0x27, 0x55, 0x64, 0x73, 0xe9, 0x85, 0xd4, 0x62, 0xcd, 0x51, 0x19, 0x7a, 0x9a, 0x46, 0xc7,\n40\t    0x60, 0x09, 0x54, 0x9e, 0xac, 0x64, 0x74, 0xf2, 0x06, 0xc4, 0xee, 0x08, 0x44, 0xf6, 0x83, 0x89,\n41\t];\n42\t/// NaCl / libsodium `secretbox` test-vector 24-byte nonce.\n43\tconst TV_NONCE24: [u8; 24] = [\n44\t    0x69, 0x69, 0x6e, 0xe9, 0x55, 0xb6, 0x2b, 0x73, 0xcd, 0x62, 0xbd, 0xa8, 0x75, 0xfc, 0x73, 0xd6,\n45\t    0x82, 0x19, 0xe0, 0x03, 0x6b, 0x7a, 0x0b, 0x37,\n46\t];\n47\t\n48\t/// `(key, nonce)` shapes: all-zero, all-0xff, ascending pattern, test vector,\n49\t/// then `extra` pseudorandom pairs.\n50\tfn shapes(nb: usize, rng: &mut Rng, extra: usize) -> Vec<(Vec<u8>, Vec<u8>)> {\n51\t    let mut v: Vec<(Vec<u8>, Vec<u8>)> = Vec::new();\n52\t    v.push((vec![0u8; 32], vec![0u8; nb]));\n53\t    v.push((vec![0xffu8; 32], vec![0xffu8; nb]));\n54\t    let mut k = vec![0u8; 32];\n55\t    for (i, b) in k.iter_mut().enumerate() {\n56\t        *b = i as u8 + 1;\n57\t    }\n58\t    let mut n = vec![0u8; nb];\n59\t    for (i, b) in n.iter_mut().enumerate() {\n60\t        *b = i as u8 + 1;\n61\t    }\n62\t    v.push((k, n));\n63\t    v.push((TV_KEY.to_vec(), TV_NONCE24[..nb].to_vec()));\n64\t    for _ in 0..extra {\n65\t        v.push((rng.bytes(32), rng.bytes(nb)));\n66\t    }\n67\t    v\n68\t}\n69\t\n70\t// ---------------------------------------------------------------- generic driver\n71\t\n72\t/// Exercises the keystream form and the `_xor` form of `base`:\n73\t///   * C vs Rust byte equality and return-code equality (row 5.86)\n74\t///   * `_xor` against an all-zero plaintext equals the keystream form\n75\t///   * `_xor` out-of-place matches `m ^ keystream`\n76\t///   * `_xor` is an involution\n77\t///   * in-place (`c == m`) equals out-of-place\n78\t///   * no writes past `len` (rows 5.87, guard bytes via `padded`/`check_pad`)\n79\tfn drive_keystream_and_xor(base: &str, nb: usize, seed: u64, lens: &[usize], extra: usize) {\n80\t    let (cs, rs) = both::<Stream>(base);\n81\t    let xor_name = format!(\"{base}_xor\");\n82\t    let (cx, rx) = both::<Xor>(&xor_name);\n83\t    let mut rng = Rng::new(seed);\n84\t\n85\t    for &len in lens {\n86\t        for (si, (k, n)) in shapes(nb, &mut rng, extra).into_iter().enumerate() {\n87\t            let tag = format!(\"{base}(len={len},shape={si})\");\n88\t\n89\t            // --- keystream form, out-of-place, poisoned tail\n90\t            let mut a = padded(len);\n91\t            let mut b = padded(len);\n92\t            let (rc, rr) = unsafe {\n93\t                (\n94\t                    cs(a.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n95\t                    rs(b.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n96\t                )\n97\t            };\n98\t            eqi(&tag, rc, rr);\n99\t            assert_eq!(rc, 0, \"{tag}: C keystream form must return 0\");\n100\t            eqb(&tag, &a, &b);\n101\t            check_pad(&tag, &a, len);\n102\t            check_pad(&tag, &b, len);\n103\t            let ks = a[..len].to_vec();\n104\t\n105\t            // --- _xor with an all-zero plaintext == keystream form\n106\t            let zero = vec![0u8; len];\n107\t            let mut a2 = padded(len);\n108\t            let mut b2 = padded(len);\n109\t            let (rc, rr) = unsafe {\n110\t                (\n111\t                    cx(a2.as_mut_ptr(), zero.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n112\t                    rx(b2.as_mut_ptr(), zero.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n113\t                )\n114\t            };\n115\t            eqi(&format!(\"{tag} xor(zero)\"), rc, rr);\n116\t            assert_eq!(rc, 0);\n117\t            eqb(&format!(\"{tag} xor(zero)\"), &a2, &b2);\n118\t            check_pad(&format!(\"{tag} xor(zero)\"), &a2, len);\n119\t            assert_eq!(\n120\t                &a2[..len],\n121\t                &ks[..],\n122\t                \"{tag}: xor(zero) must equal the keystream form\"\n123\t            );\n124\t\n125\t            // --- _xor out-of-place with a pseudorandom message\n126\t            let m = rng.bytes(len);\n127\t            let mut a3 = padded(len);\n128\t            let mut b3 = padded(len);\n129\t            let (rc, rr) = unsafe {\n130\t                (\n131\t                    cx(a3.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n132\t                    rx(b3.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n133\t                )\n134\t            };\n135\t            eqi(&format!(\"{tag} xor\"), rc, rr);\n136\t            eqb(&format!(\"{tag} xor\"), &a3, &b3);\n137\t            check_pad(&format!(\"{tag} xor\"), &a3, len);\n138\t            for i in 0..len {\n139\t                assert_eq!(a3[i], m[i] ^ ks[i], \"{tag}: xor != m ^ keystream at {i}\");\n140\t            }\n141\t\n142\t            // --- involution\n143\t            let mut a4 = padded(len);\n144\t            let mut b4 = padded(len);\n145\t            unsafe {\n146\t                cx(a4.as_mut_ptr(), a3.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n147\t                rx(b4.as_mut_ptr(), b3.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n148\t            }\n149\t            eqb(&format!(\"{tag} xor^2\"), &a4, &b4);\n150\t            assert_eq!(&a4[..len], &m[..], \"{tag}: xor is not an involution\");\n151\t\n152\t            // --- in-place (c == m)\n153\t            let mut ip_c = padded(len);\n154\t            ip_c[..len].copy_from_slice(&m);\n155\t            let mut ip_r = ip_c.clone();\n156\t            unsafe {\n157\t                let pc = ip_c.as_mut_ptr();\n158\t                let pr = ip_r.as_mut_ptr();\n159\t                cx(pc, pc, len as u64, n.as_ptr(), k.as_ptr());\n160\t                rx(pr, pr, len as u64, n.as_ptr(), k.as_ptr());\n161\t            }\n162\t            eqb(&format!(\"{tag} xor in-place\"), &ip_c, &ip_r);\n163\t            check_pad(&format!(\"{tag} xor in-place\"), &ip_c, len);\n164\t            assert_eq!(\n165\t                &ip_c[..len],\n166\t                &a3[..len],\n167\t                \"{tag}: in-place xor differs from out-of-place\"\n168\t            );\n169\t        }\n170\t    }\n171\t}\n172\t\n173\t/// Exercises `{base}_xor_ic` (64-bit `ic`).\n174\tfn drive_xor_ic64(\n175\t    base: &str,\n176\t    nb: usize,\n177\t    seed: u64,\n178\t    lens: &[usize],\n179\t    ics: &[u64],\n180\t    tail_check: bool,\n181\t    extra: usize,\n182\t) {\n183\t    let ic_name = format!(\"{base}_xor_ic\");\n184\t    let (cxi, rxi) = both::<XorIc64>(&ic_name);\n185\t    let (cx, rx) = both::<Xor>(&format!(\"{base}_xor\"));\n186\t    let mut rng = Rng::new(seed);\n187\t\n188\t    for &ic in ics {\n189\t        for &len in lens {\n190\t            for (si, (k, n)) in shapes(nb, &mut rng, extra).into_iter().enumerate() {\n191\t                let tag = format!(\"{ic_name}(len={len},ic={ic:#x},shape={si})\");\n192\t                let m = rng.bytes(len);\n193\t\n194\t                let mut a = padded(len);\n195\t                let mut b = padded(len);\n196\t                let (rc, rr) = unsafe {\n197\t                    (\n198\t                        cxi(a.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr()),\n199\t                        rxi(b.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr()),\n200\t                    )\n201\t                };\n202\t                eqi(&tag, rc, rr);\n203\t                assert_eq!(rc, 0, \"{tag}: must return 0\");\n204\t                eqb(&tag, &a, &b);\n205\t                check_pad(&tag, &a, len);\n206\t                check_pad(&tag, &b, len);\n207\t\n208\t                // in-place\n209\t                let mut ip_c = padded(len);\n210\t                ip_c[..len].copy_from_slice(&m);\n211\t                let mut ip_r = ip_c.clone();\n212\t                unsafe {\n213\t                    let pc = ip_c.as_mut_ptr();\n214\t                    let pr = ip_r.as_mut_ptr();\n215\t                    cxi(pc, pc, len as u64, n.as_ptr(), ic, k.as_ptr());\n216\t                    rxi(pr, pr, len as u64, n.as_ptr(), ic, k.as_ptr());\n217\t                }\n218\t                eqb(&format!(\"{tag} in-place\"), &ip_c, &ip_r);\n219\t                check_pad(&format!(\"{tag} in-place\"), &ip_c, len);\n220\t                assert_eq!(&ip_c[..len], &a[..len], \"{tag}: in-place != out-of-place\");\n221\t\n222\t                // involution\n223\t                let mut inv_c = padded(len);\n224\t                let mut inv_r = padded(len);\n225\t                unsafe {\n226\t                    cxi(inv_c.as_mut_ptr(), a.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n227\t                    rxi(inv_r.as_mut_ptr(), b.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n228\t                }\n229\t                eqb(&format!(\"{tag} inv\"), &inv_c, &inv_r);\n230\t                assert_eq!(&inv_c[..len], &m[..], \"{tag}: xor_ic is not an involution\");\n231\t\n232\t                // ic == 0 must byte-equal the plain _xor form\n233\t                if ic == 0 {\n234\t                    let mut z_c = padded(len);\n235\t                    let mut z_r = padded(len);\n236\t                    unsafe {\n237\t                        cx(z_c.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n238\t                        rx(z_r.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n239\t                    }\n240\t                    eqb(&format!(\"{tag} vs _xor\"), &z_c, &z_r);\n241\t                    assert_eq!(&z_c[..len], &a[..len], \"{tag}: ic=0 must equal _xor\");\n242\t                }\n243\t\n244\t                // xor_ic(ic=k) must equal the tail of a long _xor starting at block k\n245\t                if tail_check && ic <= 8 && len > 0 {\n246\t                    let off = 64 * ic as usize;\n247\t                    let total = off + len;\n248\t                    let mut full = rng.bytes(total);\n249\t                    full[off..].copy_from_slice(&m);\n250\t                    let mut fc = vec![0u8; total];\n251\t                    let mut fr = vec![0u8; total];\n252\t                    unsafe {\n253\t                        cx(fc.as_mut_ptr(), full.as_ptr(), total as u64, n.as_ptr(), k.as_ptr());\n254\t                        rx(fr.as_mut_ptr(), full.as_ptr(), total as u64, n.as_ptr(), k.as_ptr());\n255\t                    }\n256\t                    eqb(&format!(\"{tag} tail\"), &fc, &fr);\n257\t                    assert_eq!(\n258\t                        &fc[off..],\n259\t                        &a[..len],\n260\t                        \"{tag}: xor_ic(ic) != tail of _xor at block ic\"\n261\t                    );\n262\t                }\n263\t            }\n264\t        }\n265\t    }\n266\t}\n267\t\n268\t/// Row 5.88: output for length `n1` must be a prefix of output for `n2 > n1`.\n269\tfn prefix_consistency(base: &str, nb: usize, seed: u64) {\n270\t    let (cs, rs) = both::<Stream>(base);\n271\t    let mut rng = Rng::new(seed);\n272\t    for (si, (k, n)) in shapes(nb, &mut rng, 3).into_iter().enumerate() {\n273\t        let mut prev: Vec<u8> = Vec::new();\n274\t        for &len in L.iter() {\n275\t            let mut a = padded(len);\n276\t            let mut b = padded(len);\n277\t            unsafe {\n278\t                cs(a.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n279\t                rs(b.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n280\t            }\n281\t            eqb(&format!(\"{base} prefix(len={len},shape={si})\"), &a, &b);\n282\t            assert_eq!(\n283\t                &a[..prev.len()],\n284\t                &prev[..],\n285\t                \"{base}: length {len} output is not an extension of the shorter one\"\n286\t            );\n287\t            prev = a[..len].to_vec();\n288\t        }\n289\t    }\n290\t}\n291\t\n292\t// ============================================================ accessors (5.11,\n293\t// 5.25, 5.32, 5.38 and error rows 5.25)\n294\t\n295\tfn accessor(name: &str, expect: usize) {\n296\t    let (c, r) = both::<SizeFn>(name);\n297\t    let (vc, vr) = unsafe { (c(), r()) };\n298\t    assert_eq!(vc, vr, \"{name}: C {vc} vs Rust {vr}\");\n299\t    assert_eq!(vc, expect, \"{name}: expected {expect}, C returned {vc}\");\n300\t}\n301\t\n302\t#[test]\n303\tfn salsa_family_accessors() {\n304\t    // 5.11\n305\t    accessor(\"crypto_stream_salsa20_keybytes\", 32);\n306\t    accessor(\"crypto_stream_salsa20_noncebytes\", 8);\n307\t    accessor(\"crypto_stream_salsa20_messagebytes_max\", SODIUM_SIZE_MAX as usize);\n308\t    // 5.25\n309\t    accessor(\"crypto_stream_salsa2012_keybytes\", 32);\n310\t    accessor(\"crypto_stream_salsa2012_noncebytes\", 8);\n311\t    accessor(\"crypto_stream_salsa2012_messagebytes_max\", SODIUM_SIZE_MAX as usize);\n312\t    // 5.32 (deprecated but present)\n313\t    accessor(\"crypto_stream_salsa208_keybytes\", 32);\n314\t    accessor(\"crypto_stream_salsa208_noncebytes\", 8);\n315\t    accessor(\"crypto_stream_salsa208_messagebytes_max\", SODIUM_SIZE_MAX as usize);\n316\t    // 5.38\n317\t    accessor(\"crypto_stream_xsalsa20_keybytes\", 32);\n318\t    accessor(\"crypto_stream_xsalsa20_noncebytes\", 24);\n319\t    accessor(\"crypto_stream_xsalsa20_messagebytes_max\", SODIUM_SIZE_MAX as usize);\n320\t}\n321\t\n322\t// =================================================================== salsa20\n323\t\n324\t#[test]\n325\tfn salsa20_keystream_and_xor_sweep() {\n326\t    // 5.12, 5.13, 5.14, 5.15, 5.16\n327\t    drive_keystream_and_xor(\"crypto_stream_salsa20\", 8, 0x5_0012, &L, 4);\n328\t    drive_keystream_and_xor(\"crypto_stream_salsa20\", 8, 0x5_0013, &BIG, 1);\n329\t}\n330\t\n331\t#[test]\n332\tfn salsa20_full_length_sweep() {\n333\t    let lens: Vec<usize> = (0..=600).collect();\n334\t    drive_keystream_and_xor(\"crypto_stream_salsa20\", 8, 0x5_0014, &lens, 0);\n335\t}\n336\t\n337\t#[test]\n338\tfn salsa20_xor_ic_small() {\n339\t    // 5.17 (ic = 0), 5.18 (ic = 1), 5.19 (ic in {2,3,7})\n340\t    drive_xor_ic64(\n341\t        \"crypto_stream_salsa20\",\n342\t        8,\n343\t        0x5_0017,\n344\t        &L,\n345\t        &[0, 1, 2, 3, 7],\n346\t        true,\n347\t        3,\n348\t    );\n349\t}\n350\t\n351\t#[test]\n352\tfn salsa20_xor_ic_counter_boundaries() {\n353\t    // 5.20: ic = 0xFFFFFFFF, carry from in[11] into in[12]\n354\t    // 5.21: ic = 0xFFFFFFFFFFFFFFFF, 64-bit block counter rolls over mid-message\n355\t    // 5.22: ic = 0xFFFFFFFFFFFFFFFE, two wraps across a 3-block message\n356\t    drive_xor_ic64(\n357\t        \"crypto_stream_salsa20\",\n358\t        8,\n359\t        0x5_0020,\n360\t        &[64, 65, 128, 129, 192],\n361\t        &[0xFFFF_FFFF, 0x1_0000_0000, 0xFFFF_FFFF_FFFF_FFFF],\n362\t        false,\n363\t        3,\n364\t    );\n365\t    drive_xor_ic64(\n366\t        \"crypto_stream_salsa20\",\n367\t        8,\n368\t        0x5_0022,\n369\t        &[129, 192, 193],\n370\t        &[0xFFFF_FFFF_FFFF_FFFE],\n371\t        false,\n372\t        3,\n373\t    );\n374\t    // Self-consistency: with ic = 2^64-1 the second block must use counter 0\n375\t    // (the carry out of in[15] is dropped) — error row 5.17.\n376\t    let (cxi, rxi) = both::<XorIc64>(\"crypto_stream_salsa20_xor_ic\");\n377\t    let mut rng = Rng::new(0x5_0021);\n378\t    for (si, (k, n)) in shapes(8, &mut rng, 3).into_iter().enumerate() {\n379\t        let m = vec![0u8; 128];\n380\t        let mut wrap_c = vec![0u8; 128];\n381\t        let mut wrap_r = vec![0u8; 128];\n382\t        let mut zero_c = vec![0u8; 64];\n383\t        let mut zero_r = vec![0u8; 64];\n384\t        unsafe {\n385\t            let rc = cxi(\n386\t                wrap_c.as_mut_ptr(),\n387\t                m.as_ptr(),\n388\t                128,\n389\t                n.as_ptr(),\n390\t                u64::MAX,\n391\t                k.as_ptr(),\n392\t            );\n393\t            let rr = rxi(\n394\t                wrap_r.as_mut_ptr(),\n395\t                m.as_ptr(),\n396\t                128,\n397\t                n.as_ptr(),\n398\t                u64::MAX,\n399\t                k.as_ptr(),\n400\t            );\n401\t            eqi(\"salsa20 wrap rv\", rc, rr);\n402\t            assert_eq!(rc, 0, \"64-bit counter wrap must be silent (error row 5.17)\");\n403\t            cxi(zero_c.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0, k.as_ptr());\n404\t            rxi(zero_r.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0, k.as_ptr());\n405\t        }\n406\t        eqb(&format!(\"salsa20 wrap(shape={si})\"), &wrap_c, &wrap_r);\n407\t        eqb(&format!(\"salsa20 ic0(shape={si})\"), &zero_c, &zero_r);\n408\t        assert_eq!(\n409\t            &wrap_c[64..],\n410\t            &zero_c[..],\n411\t            \"salsa20: block after the 2^64-1 counter must be the counter-0 block\"\n412\t        );\n413\t    }\n414\t}\n415\t\n416\t#[test]\n417\tfn salsa20_xor_ic_zero_length() {\n418\t    // 5.23: mlen == 0 with ic in {0, 1, 2^64-1}; output buffer untouched.\n419\t    let (cxi, rxi) = both::<XorIc64>(\"crypto_stream_salsa20_xor_ic\");\n420\t    let k = [7u8; 32];\n421\t    let n = [9u8; 8];\n422\t    for ic in [0u64, 1, u64::MAX] {\n423\t        let mut a = padded(0);\n424\t        let mut b = padded(0);\n425\t        let ref_a = a.clone();\n426\t        let (rc, rr) = unsafe {\n427\t            (\n428\t                cxi(a.as_mut_ptr(), core::ptr::null(), 0, n.as_ptr(), ic, k.as_ptr()),\n429\t                rxi(b.as_mut_ptr(), core::ptr::null(), 0, n.as_ptr(), ic, k.as_ptr()),\n430\t            )\n431\t        };\n432\t        eqi(&format!(\"salsa20_xor_ic(mlen=0,ic={ic:#x})\"), rc, rr);\n433\t        assert_eq!(rc, 0);\n434\t        eqb(&format!(\"salsa20_xor_ic(mlen=0,ic={ic:#x})\"), &a, &b);\n435\t        assert_eq!(a, ref_a, \"mlen=0 must not touch the output buffer\");\n436\t    }\n437\t}\n438\t\n439\t// ================================================================= salsa2012\n440\t\n441\t#[test]\n442\tfn salsa2012_keystream_and_xor_sweep() {\n443\t    // 5.26, 5.27, 5.28, 5.29\n444\t    drive_keystream_and_xor(\"crypto_stream_salsa2012\", 8, 0x5_0026, &L, 4);\n445\t    drive_keystream_and_xor(\"crypto_stream_salsa2012\", 8, 0x5_0027, &BIG, 1);\n446\t}\n447\t\n448\t#[test]\n449\tfn salsa2012_full_length_sweep() {\n450\t    let lens: Vec<usize> = (0..=600).collect();\n451\t    drive_keystream_and_xor(\"crypto_stream_salsa2012\", 8, 0x5_0029, &lens, 0);\n452\t}\n453\t\n454\t// ================================================================== salsa208\n455\t\n456\t#[test]\n457\tfn salsa208_keystream_and_xor_sweep() {\n458\t    // 5.33, 5.34, 5.35\n459\t    drive_keystream_and_xor(\"crypto_stream_salsa208\", 8, 0x5_0033, &L, 4);\n460\t    drive_keystream_and_xor(\"crypto_stream_salsa208\", 8, 0x5_0034, &BIG, 1);\n461\t}\n462\t\n463\t#[test]\n464\tfn salsa208_full_length_sweep() {\n465\t    let lens: Vec<usize> = (0..=600).collect();\n466\t    drive_keystream_and_xor(\"crypto_stream_salsa208\", 8, 0x5_0035, &lens, 0);\n467\t}\n468\t\n469\t#[test]\n470\tfn salsa_variants_are_distinct_and_count_blocks() {\n471\t    // 5.30 / 5.36: no _xor_ic entry point → the counter always starts at 0 and\n472\t    // 512 bytes exercises 8 counter increments; the three round counts must\n473\t    // produce different keystreams for the same (n, k).\n474\t    let (c20, r20) = both::<Stream>(\"crypto_stream_salsa20\");\n475\t    let (c12, r12) = both::<Stream>(\"crypto_stream_salsa2012\");\n476\t    let (c08, r08) = both::<Stream>(\"crypto_stream_salsa208\");\n477\t    let mut rng = Rng::new(0x5_0030);\n478\t    for (si, (k, n)) in shapes(8, &mut rng, 4).into_iter().enumerate() {\n479\t        let mut a20 = vec![0u8; 512];\n480\t        let mut b20 = vec![0u8; 512];\n481\t        let mut a12 = vec![0u8; 512];\n482\t        let mut b12 = vec![0u8; 512];\n483\t        let mut a08 = vec![0u8; 512];\n484\t        let mut b08 = vec![0u8; 512];\n485\t        unsafe {\n486\t            c20(a20.as_mut_ptr(), 512, n.as_ptr(), k.as_ptr());\n487\t            r20(b20.as_mut_ptr(), 512, n.as_ptr(), k.as_ptr());\n488\t            c12(a12.as_mut_ptr(), 512, n.as_ptr(), k.as_ptr());\n489\t            r12(b12.as_mut_ptr(), 512, n.as_ptr(), k.as_ptr());\n490\t            c08(a08.as_mut_ptr(), 512, n.as_ptr(), k.as_ptr());\n491\t            r08(b08.as_mut_ptr(), 512, n.as_ptr(), k.as_ptr());\n492\t        }\n493\t        eqb(&format!(\"salsa20 512(shape={si})\"), &a20, &b20);\n494\t        eqb(&format!(\"salsa2012 512(shape={si})\"), &a12, &b12);\n495\t        eqb(&format!(\"salsa208 512(shape={si})\"), &a08, &b08);\n496\t        assert_ne!(a20, a12, \"salsa20 and salsa2012 keystreams must differ\");\n497\t        assert_ne!(a20, a08, \"salsa20 and salsa208 keystreams must differ\");\n498\t        assert_ne!(a12, a08, \"salsa2012 and salsa208 keystreams must differ\");\n499\t        // 8 distinct blocks: no block may repeat (the counter really advances).\n500\t        for i in 0..8usize {\n501\t            for j in (i + 1)..8usize {\n502\t                assert_ne!(\n503\t                    &a20[i * 64..(i + 1) * 64],\n504\t                    &a20[j * 64..(j + 1) * 64],\n505\t                    \"salsa20 block {i} == block {j}\"\n506\t                );\n507\t                assert_ne!(\n508\t                    &a12[i * 64..(i + 1) * 64],\n509\t                    &a12[j * 64..(j + 1) * 64],\n510\t                    \"salsa2012 block {i} == block {j}\"\n511\t                );\n512\t                assert_ne!(\n513\t                    &a08[i * 64..(i + 1) * 64],\n514\t                    &a08[j * 64..(j + 1) * 64],\n515\t                    \"salsa208 block {i} == block {j}\"\n516\t                );\n517\t            }\n518\t        }\n519\t    }\n520\t}\n521\t\n522\t// ================================================================== xsalsa20\n523\t\n524\t#[test]\n525\tfn xsalsa20_keystream_and_xor_sweep() {\n526\t    // 5.39, 5.40, 5.41\n527\t    drive_keystream_and_xor(\"crypto_stream_xsalsa20\", 24, 0x5_0039, &L, 4);\n528\t    drive_keystream_and_xor(\"crypto_stream_xsalsa20\", 24, 0x5_0040, &BIG, 1);\n529\t}\n530\t\n531\t#[test]\n532\tfn xsalsa20_full_length_sweep() {\n533\t    let lens: Vec<usize> = (0..=600).collect();\n534\t    drive_keystream_and_xor(\"crypto_stream_xsalsa20\", 24, 0x5_0041, &lens, 0);\n535\t}\n536\t\n537\t#[test]\n538\tfn xsalsa20_xor_ic_small() {\n539\t    // 5.42 (ic = 0), 5.43 (ic = 1 and small)\n540\t    drive_xor_ic64(\n541\t        \"crypto_stream_xsalsa20\",\n542\t        24,\n543\t        0x5_0042,\n544\t        &L,\n545\t        &[0, 1, 2, 3, 7],\n546\t        true,\n547\t        3,\n548\t    );\n549\t}\n550\t\n551\t#[test]\n552\tfn xsalsa20_xor_ic_counter_boundaries() {\n553\t    // 5.44: ic = 0xFFFFFFFF (32-bit boundary) and 2^64-1 (rollover mid-message)\n554\t    drive_xor_ic64(\n555\t        \"crypto_stream_xsalsa20\",\n556\t        24,\n557\t        0x5_0044,\n558\t        &[64, 65, 128, 129, 192],\n559\t        &[0xFFFF_FFFF, 0xFFFF_FFFF_FFFF_FFFF],\n560\t        false,\n561\t        3,\n562\t    );\n563\t    // Error row 5.17 for xsalsa20: silent 64-bit wraparound.\n564\t    let (cxi, rxi) = both::<XorIc64>(\"crypto_stream_xsalsa20_xor_ic\");\n565\t    let mut rng = Rng::new(0x5_0045);\n566\t    for (si, (k, n)) in shapes(24, &mut rng, 3).into_iter().enumerate() {\n567\t        let m = vec![0u8; 128];\n568\t        let mut wrap_c = vec![0u8; 128];\n569\t        let mut wrap_r = vec![0u8; 128];\n570\t        let mut zero_c = vec![0u8; 64];\n571\t        let mut zero_r = vec![0u8; 64];\n572\t        unsafe {\n573\t            let rc = cxi(wrap_c.as_mut_ptr(), m.as_ptr(), 128, n.as_ptr(), u64::MAX, k.as_ptr());\n574\t            let rr = rxi(wrap_r.as_mut_ptr(), m.as_ptr(), 128, n.as_ptr(), u64::MAX, k.as_ptr());\n575\t            eqi(\"xsalsa20 wrap rv\", rc, rr);\n576\t            assert_eq!(rc, 0);\n577\t            cxi(zero_c.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0, k.as_ptr());\n578\t            rxi(zero_r.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0, k.as_ptr());\n579\t        }\n580\t        eqb(&format!(\"xsalsa20 wrap(shape={si})\"), &wrap_c, &wrap_r);\n581\t        eqb(&format!(\"xsalsa20 ic0(shape={si})\"), &zero_c, &zero_r);\n582\t        assert_eq!(&wrap_c[64..], &zero_c[..]);\n583\t    }\n584\t}\n585\t\n586\t#[test]\n587\tfn xsalsa20_equals_hsalsa20_plus_salsa20() {\n588\t    // 5.45\n589\t    let (chs, rhs) = both::<Core>(\"crypto_core_hsalsa20\");\n590\t    let (cxs, rxs) = both::<Stream>(\"crypto_stream_xsalsa20\");\n591\t    let (cs, rs) = both::<Stream>(\"crypto_stream_salsa20\");\n592\t    let (cxsi, rxsi) = both::<XorIc64>(\"crypto_stream_xsalsa20_xor_ic\");\n593\t    let (csi, rsi) = both::<XorIc64>(\"crypto_stream_salsa20_xor_ic\");\n594\t    let mut rng = Rng::new(0x5_0046);\n595\t    for (si, (k, n)) in shapes(24, &mut rng, 5).into_iter().enumerate() {\n596\t        let mut sk_c = [0u8; 32];\n597\t        let mut sk_r = [0u8; 32];\n598\t        unsafe {\n599\t            chs(sk_c.as_mut_ptr(), n.as_ptr(), k.as_ptr(), core::ptr::null());\n600\t            rhs(sk_r.as_mut_ptr(), n.as_ptr(), k.as_ptr(), core::ptr::null());\n601\t        }\n602\t        eqb(&format!(\"hsalsa20 subkey(shape={si})\"), &sk_c, &sk_r);\n603\t        for &len in [0usize, 64, 65, 512].iter() {\n604\t            let mut x_c = vec![0u8; len];\n605\t            let mut x_r = vec![0u8; len];\n606\t            let mut s_c = vec![0u8; len];\n607\t            let mut s_r = vec![0u8; len];\n608\t            unsafe {\n609\t                cxs(x_c.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n610\t                rxs(x_r.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n611\t                cs(s_c.as_mut_ptr(), len as u64, n.as_ptr().add(16), sk_c.as_ptr());\n612\t                rs(s_r.as_mut_ptr(), len as u64, n.as_ptr().add(16), sk_r.as_ptr());\n613\t            }\n614\t            eqb(&format!(\"xsalsa20({len},shape={si})\"), &x_c, &x_r);\n615\t            eqb(&format!(\"salsa20 subkey({len},shape={si})\"), &s_c, &s_r);\n616\t            assert_eq!(x_c, s_c, \"xsalsa20 != salsa20(n+16, hsalsa20(n,k))\");\n617\t\n618\t            for ic in [0u64, 1, 5, 0xFFFF_FFFF] {\n619\t                let m = {\n620\t                    let mut r2 = Rng::new(len as u64 ^ ic);\n621\t                    r2.bytes(len)\n622\t                };\n623\t                let mut xi_c = vec![0u8; len];\n624\t                let mut xi_r = vec![0u8; len];\n625\t                let mut si_c = vec![0u8; len];\n626\t                let mut si_r = vec![0u8; len];\n627\t                unsafe {\n628\t                    cxsi(xi_c.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n629\t                    rxsi(xi_r.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n630\t                    csi(\n631\t                        si_c.as_mut_ptr(),\n632\t                        m.as_ptr(),\n633\t                        len as u64,\n634\t                        n.as_ptr().add(16),\n635\t                        ic,\n636\t                        sk_c.as_ptr(),\n637\t                    );\n638\t                    rsi(\n639\t                        si_r.as_mut_ptr(),\n640\t                        m.as_ptr(),\n641\t                        len as u64,\n642\t                        n.as_ptr().add(16),\n643\t                        ic,\n644\t                        sk_r.as_ptr(),\n645\t                    );\n646\t                }\n647\t                eqb(&format!(\"xsalsa20_xor_ic({len},{ic:#x},shape={si})\"), &xi_c, &xi_r);\n648\t                eqb(&format!(\"salsa20_xor_ic({len},{ic:#x},shape={si})\"), &si_c, &si_r);\n649\t                assert_eq!(xi_c, si_c, \"xsalsa20_xor_ic != salsa20_xor_ic on the subkey\");\n650\t            }\n651\t        }\n652\t    }\n653\t}\n654\t\n655\t// ============================================================ prefix / exactness\n656\t\n657\t#[test]\n658\tfn salsa_family_prefix_consistency() {\n659\t    // 5.87 / 5.88\n660\t    prefix_consistency(\"crypto_stream_salsa20\", 8, 0x5_0088);\n661\t    prefix_consistency(\"crypto_stream_salsa2012\", 8, 0x5_0089);\n662\t    prefix_consistency(\"crypto_stream_salsa208\", 8, 0x5_008a);\n663\t    prefix_consistency(\"crypto_stream_xsalsa20\", 24, 0x5_008b);\n664\t}\n665\t\n666\t// ==================================================================== keygen\n667\t\n668\tfn keygen_check(name: &str) {\n669\t    let (c, r) = both::<Keygen>(name);\n670\t    let mut a = padded(32);\n671\t    let mut b = padded(32);\n672\t    rng_reset();\n673\t    unsafe {\n674\t        c(a.as_mut_ptr());\n675\t        r(b.as_mut_ptr());\n676\t    }\n677\t    eqb(name, &a, &b);\n678\t    check_pad(name, &a, 32);\n679\t    check_pad(name, &b, 32);\n680\t    assert!(a[..32].iter().any(|&x| x != 0), \"{name}: all-zero key\");\n681\t\n682\t    // Non-constant across calls with a different RNG stream position.\n683\t    let mut a2 = padded(32);\n684\t    let mut b2 = padded(32);\n685\t    rng_reseed(0x1234_5678_9abc_def1);\n686\t    unsafe {\n687\t        c(a2.as_mut_ptr());\n688\t        r(b2.as_mut_ptr());\n689\t    }\n690\t    eqb(&format!(\"{name} #2\"), &a2, &b2);\n691\t    check_pad(&format!(\"{name} #2\"), &a2, 32);\n692\t    assert_ne!(&a[..32], &a2[..32], \"{name}: keygen output is constant\");\n693\t    rng_reset();\n694\t}\n695\t\n696\t#[test]\n697\tfn salsa_family_keygen() {\n698\t    keygen_check(\"crypto_stream_salsa20_keygen\"); // 5.24\n699\t    keygen_check(\"crypto_stream_salsa2012_keygen\"); // 5.31\n700\t    keygen_check(\"crypto_stream_salsa208_keygen\"); // 5.37\n701\t    keygen_check(\"crypto_stream_xsalsa20_keygen\"); // 5.46\n702\t}\n703\t\n704\t// ======================================================== error rows (salsa)\n705\t\n706\textern \"C\" {\n707\t    fn mmap(\n708\t        addr: *mut c_void,\n709\t        len: usize,\n710\t        prot: c_int,\n711\t        flags: c_int,\n712\t        fd: c_int,\n713\t        off: i64,\n714\t    ) -> *mut c_void;\n715\t    fn mprotect(addr: *mut c_void, len: usize, prot: c_int) -> c_int;\n716\t}\n717\tconst PROT_NONE: c_int = 0;\n718\tconst PROT_READ: c_int = 1;\n719\tconst PROT_WRITE: c_int = 2;\n720\tconst MAP_PRIVATE: c_int = 0x02;\n721\tconst MAP_ANONYMOUS: c_int = 0x20;\n722\tconst MAP_NORESERVE: c_int = 0x4000;\n723\tconst GUARD_USABLE: usize = 1 << 20;\n724\t\n725\t/// A 1 MiB writable region immediately followed by a 1 MiB `PROT_NONE` guard.\n726\t///\n727\t/// Any implementation that keeps writing past the first MiB dies with SIGSEGV\n728\t/// *deterministically*, which lets us distinguish \"the length check fired\"\n729\t/// (SIGABRT from `sodium_misuse`) from \"the length check did not fire\".\n730\tfn guarded_region() -> *mut u8 {\n731\t    unsafe {\n732\t        let p = mmap(\n733\t            core::ptr::null_mut(),\n734\t            2 * GUARD_USABLE,\n735\t            PROT_NONE,\n736\t            MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE,\n737\t            -1,\n738\t            0,\n739\t        );\n740\t        assert!(p as isize != -1, \"mmap failed\");\n741\t        assert_eq!(\n742\t            mprotect(p, GUARD_USABLE, PROT_READ | PROT_WRITE),\n743\t            0,\n744\t            \"mprotect failed\"\n745\t        );\n746\t        p as *mut u8\n747\t    }\n748\t}\n749\t\n750\t#[test]\n751\tfn salsa_family_has_no_length_validation() {\n752\t    // Error rows 5.18 / 5.19: the salsa family performs no length validation at\n753\t    // all, so an absurd length does NOT abort — it just runs off the end of the\n754\t    // buffer.  With the guard mapping both libraries must die the same way\n755\t    // (SIGSEGV, not SIGABRT).  This is `checked-via-guard-only`: allocating a\n756\t    // > MESSAGEBYTES_MAX buffer is impossible.\n757\t    let p = guarded_region();\n758\t    let k = [0x5au8; 32];\n759\t    let n24 = [0x3cu8; 24];\n760\t    let huge: u64 = 274_877_906_945; // 2^38 + 1, way past the 1 MiB mapping\n761\t    for (name, nb) in [\n762\t        (\"crypto_stream_salsa20\", 8usize),\n763\t        (\"crypto_stream_salsa2012\", 8),\n764\t        (\"crypto_stream_salsa208\", 8),\n765\t        (\"crypto_stream_xsalsa20\", 24),\n766\t    ] {\n767\t        let (c, r) = both::<Stream>(name);\n768\t        let np = n24[..nb].as_ptr();\n769\t        eq_abort(\n770\t            &format!(\"{name}(clen=2^38+1) no validation\"),\n771\t            || unsafe {\n772\t                c(p, huge, np, k.as_ptr());\n773\t            },\n774\t            || unsafe {\n775\t                r(p, huge, np, k.as_ptr());\n776\t            },\n777\t        );\n778\t    }\n779\t    for (name, nb) in [\n780\t        (\"crypto_stream_salsa20_xor\", 8usize),\n781\t        (\"crypto_stream_salsa2012_xor\", 8),\n782\t        (\"crypto_stream_salsa208_xor\", 8),\n783\t        (\"crypto_stream_xsalsa20_xor\", 24),\n784\t    ] {\n785\t        let (c, r) = both::<Xor>(name);\n786\t        let np = n24[..nb].as_ptr();\n787\t        eq_abort(\n788\t            &format!(\"{name}(mlen=2^38+1) no validation\"),\n789\t            || unsafe {\n790\t                c(p, p, huge, np, k.as_ptr());\n791\t            },\n792\t            || unsafe {\n793\t                r(p, p, huge, np, k.as_ptr());\n794\t            },\n795\t        );\n796\t    }\n797\t    for name in [\n798\t        \"crypto_stream_salsa20_xor_ic\",\n799\t        \"crypto_stream_xsalsa20_xor_ic\",\n800\t    ] {\n801\t        let nb = if name.contains(\"xsalsa\") { 24 } else { 8 };\n802\t        let (c, r) = both::<XorIc64>(name);\n803\t        let np = n24[..nb].as_ptr();\n804\t        eq_abort(\n805\t            &format!(\"{name}(mlen=2^38+1) no validation\"),\n806\t            || unsafe {\n807\t                c(p, p, huge, np, u64::MAX, k.as_ptr());\n808\t            },\n809\t            || unsafe {\n810\t                r(p, p, huge, np, u64::MAX, k.as_ptr());\n811\t            },\n812\t        );\n813\t    }\n814\t}\n815\t\n816\t#[test]\n817\tfn salsa_family_zero_length_with_null_pointers() {\n818\t    // Error row 5.23 (benign sub-case): mlen == 0 short-circuits before any\n819\t    // dereference, so (NULL, 0) happens to be safe in every implementation.\n820\t    let k = [1u8; 32];\n821\t    let n = [2u8; 24];\n822\t    for (name, nb) in [\n823\t        (\"crypto_stream_salsa20\", 8usize),\n824\t        (\"crypto_stream_salsa2012\", 8),\n825\t        (\"crypto_stream_salsa208\", 8),\n826\t        (\"crypto_stream_xsalsa20\", 24),\n827\t    ] {\n828\t        let (c, r) = both::<Stream>(name);\n829\t        let (rc, rr) = unsafe {\n830\t            (\n831\t                c(core::ptr::null_mut(), 0, n[..nb].as_ptr(), k.as_ptr()),\n832\t                r(core::ptr::null_mut(), 0, n[..nb].as_ptr(), k.as_ptr()),\n833\t            )\n834\t        };\n835\t        eqi(&format!(\"{name}(NULL,0)\"), rc, rr);\n836\t        assert_eq!(rc, 0);\n837\t    }\n838\t    for (name, nb) in [\n839\t        (\"crypto_stream_salsa20_xor\", 8usize),\n840\t        (\"crypto_stream_salsa2012_xor\", 8),\n841\t        (\"crypto_stream_salsa208_xor\", 8),\n842\t        (\"crypto_stream_xsalsa20_xor\", 24),\n843\t    ] {\n844\t        let (c, r) = both::<Xor>(name);\n845\t        let (rc, rr) = unsafe {\n846\t            (\n847\t                c(\n848\t                    core::ptr::null_mut(),\n849\t                    core::ptr::null(),\n850\t                    0,\n851\t                    n[..nb].as_ptr(),\n852\t                    k.as_ptr(),\n853\t                ),\n854\t                r(\n855\t                    core::ptr::null_mut(),\n856\t                    core::ptr::null(),\n857\t                    0,\n858\t                    n[..nb].as_ptr(),\n859\t                    k.as_ptr(),\n860\t                ),\n861\t            )\n862\t        };\n863\t        eqi(&format!(\"{name}(NULL,0)\"), rc, rr);\n864\t        assert_eq!(rc, 0);\n865\t    }\n866\t}\n867\t\n868\t// ================================================= implementation selection\n869\t\n870\t#[test]\n871\tfn salsa20_pick_best_implementation_is_stable() {\n872\t    // 5.89 / error row 5.27\n873\t    type Pick = unsafe extern \"C\" fn() -> c_int;\n874\t    let (cp, rp) = both::<Pick>(\"_crypto_stream_salsa20_pick_best_implementation\");\n875\t    let (cs, rs) = both::<Stream>(\"crypto_stream_salsa20\");\n876\t    let k = [0x11u8; 32];\n877\t    let n = [0x22u8; 8];\n878\t    let mut before_c = vec![0u8; 256];\n879\t    let mut before_r = vec![0u8; 256];\n880\t    unsafe {\n881\t        cs(before_c.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n882\t        rs(before_r.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n883\t    }\n884\t    eqb(\"salsa20 before pick\", &before_c, &before_r);\n885\t    for _ in 0..3 {\n886\t        let (rc, rr) = unsafe { (cp(), rp()) };\n887\t        eqi(\"_crypto_stream_salsa20_pick_best_implementation\", rc, rr);\n888\t        assert_eq!(rc, 0);\n889\t        let mut after_c = vec![0u8; 256];\n890\t        let mut after_r = vec![0u8; 256];\n891\t        unsafe {\n892\t            cs(after_c.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n893\t            rs(after_r.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n894\t        }\n895\t        eqb(\"salsa20 after pick\", &after_c, &after_r);\n896\t        assert_eq!(after_c, before_c, \"pick_best changed the output\");\n897\t    }\n898\t}\n899\t"}]},"parent_tool_use_id":"toolu_bdrk_01Mg9c7SwjKFkZZ5pEGe5Fn1","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"2651b8cb-c837-4ea9-b9f7-dc34cf5c8580","timestamp":"2026-08-31T04:08:52.712Z","subagent_type":"general-purpose","task_description":"Finish area 5 bookkeeping+gaps"}
