{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Xn6Mgv9UdbuekhUHkFYLyE","type":"tool_result","content":"1\t//! Area 4a — `crypto_auth` (generic) and the three HMAC primitives:\n2\t//! `crypto_auth_hmacsha256`, `crypto_auth_hmacsha512`,\n3\t//! `crypto_auth_hmacsha512256`.\n4\t//!\n5\t//! Covers `configs_4.md` rows 4.1–4.141 and `errors_4.md` rows 4.1–4.10,\n6\t//! 4.13–4.15, 4.18–4.21, 4.23, 4.24.\n7\tmod common;\n8\tuse common::*;\n9\tuse std::ffi::{c_char, c_int};\n10\t\n11\ttype Auth = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8) -> c_int;\n12\ttype Verify = unsafe extern \"C\" fn(*const u8, *const u8, u64, *const u8) -> c_int;\n13\ttype Init = unsafe extern \"C\" fn(*mut u8, *const u8, usize) -> c_int;\n14\ttype Update = unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> c_int;\n15\ttype Fin = unsafe extern \"C\" fn(*mut u8, *mut u8) -> c_int;\n16\ttype Keygen = unsafe extern \"C\" fn(*mut u8);\n17\ttype SizeFn = unsafe extern \"C\" fn() -> usize;\n18\ttype StrFn = unsafe extern \"C\" fn() -> *const c_char;\n19\t\n20\t/// Message lengths from the config table (SHA-256 and SHA-512 pad/block\n21\t/// boundaries plus their neighbours).\n22\tconst LENS: [usize; 12] = [0, 1, 55, 56, 63, 64, 65, 111, 112, 127, 128, 129];\n23\t\n24\t// ------------------------------------------------------------------ primitives\n25\t\n26\t#[derive(Copy, Clone)]\n27\tstruct Hmac {\n28\t    prefix: &'static str,\n29\t    tag: usize,\n30\t    block: usize,\n31\t    keybytes: usize,\n32\t}\n33\t\n34\tconst SHA256: Hmac = Hmac { prefix: \"crypto_auth_hmacsha256\", tag: 32, block: 64, keybytes: 32 };\n35\tconst SHA512: Hmac = Hmac { prefix: \"crypto_auth_hmacsha512\", tag: 64, block: 128, keybytes: 32 };\n36\tconst SHA512256: Hmac =\n37\t    Hmac { prefix: \"crypto_auth_hmacsha512256\", tag: 32, block: 128, keybytes: 32 };\n38\t\n39\tfn sym(prefix: &str, suffix: &str) -> String {\n40\t    format!(\"{prefix}{suffix}\")\n41\t}\n42\t\n43\tfn size_of_both(name: &str) -> usize {\n44\t    let (c, r) = both::<SizeFn>(name);\n45\t    let (cv, rv) = unsafe { (c(), r()) };\n46\t    assert_eq!(cv, rv, \"{name}: size mismatch (C {cv}, Rust {rv})\");\n47\t    cv\n48\t}\n49\t\n50\tfn statebytes(h: &Hmac) -> usize {\n51\t    size_of_both(&sym(h.prefix, \"_statebytes\"))\n52\t}\n53\t\n54\t/// One-shot `*_auth(out, in, inlen, k)` on both libraries; asserts equal return\n55\t/// code, equal tag and no out-of-bounds write.  Returns the tag.\n56\t#[track_caller]\n57\tfn oneshot(h: &Hmac, msg: &[u8], key: &[u8], label: &str) -> Vec<u8> {\n58\t    assert_eq!(key.len(), h.keybytes, \"one-shot requires a KEYBYTES key\");\n59\t    let (c, r) = both::<Auth>(h.prefix);\n60\t    let mut co = padded(h.tag);\n61\t    let mut ro = padded(h.tag);\n62\t    let (rc, rr) = unsafe {\n63\t        (\n64\t            c(co.as_mut_ptr(), msg.as_ptr(), msg.len() as u64, key.as_ptr()),\n65\t            r(ro.as_mut_ptr(), msg.as_ptr(), msg.len() as u64, key.as_ptr()),\n66\t        )\n67\t    };\n68\t    eqi(&format!(\"{label}: {} rc\", h.prefix), rc, rr);\n69\t    assert_eq!(rc, 0, \"{label}: {} must return 0 (errors_4 4.23)\", h.prefix);\n70\t    eqb(&format!(\"{label}: {} tag\", h.prefix), &co[..h.tag], &ro[..h.tag]);\n71\t    check_pad(&format!(\"{label}: {} out\", h.prefix), &co, h.tag);\n72\t    check_pad(&format!(\"{label}: {} out\", h.prefix), &ro, h.tag);\n73\t    co.truncate(h.tag);\n74\t    co\n75\t}\n76\t\n77\t/// `*_verify` on both libraries; asserts equal return code and returns it.\n78\t#[track_caller]\n79\tfn verify(h: &Hmac, tag: &[u8], msg: &[u8], key: &[u8], label: &str) -> c_int {\n80\t    let (c, r) = both::<Verify>(&sym(h.prefix, \"_verify\"));\n81\t    let (rc, rr) = unsafe {\n82\t        (\n83\t            c(tag.as_ptr(), msg.as_ptr(), msg.len() as u64, key.as_ptr()),\n84\t            r(tag.as_ptr(), msg.as_ptr(), msg.len() as u64, key.as_ptr()),\n85\t        )\n86\t    };\n87\t    eqi(&format!(\"{label}: {}_verify rc\", h.prefix), rc, rr);\n88\t    rc\n89\t}\n90\t\n91\t/// Streaming `init` / `update`* / `final`, comparing the **full** state buffer\n92\t/// after `init` and after every `update` (and after `final`).\n93\t///\n94\t/// `key` is `None` for the `key == NULL` configurations.\n95\t#[track_caller]\n96\tfn stream(h: &Hmac, key: Option<&[u8]>, keylen: usize, chunks: &[&[u8]], label: &str) -> Vec<u8> {\n97\t    let sb = statebytes(h);\n98\t    let (ci, ri) = both::<Init>(&sym(h.prefix, \"_init\"));\n99\t    let (cu, ru) = both::<Update>(&sym(h.prefix, \"_update\"));\n100\t    let (cf, rf) = both::<Fin>(&sym(h.prefix, \"_final\"));\n101\t\n102\t    // `padded()` zeroes the state region, so the *uninitialised* tail of the\n103\t    // internal SHA buffers is identical on both sides and the full-state\n104\t    // comparison below is meaningful.\n105\t    let mut cs = padded(sb);\n106\t    let mut rs = padded(sb);\n107\t    let kp = match key {\n108\t        Some(k) => k.as_ptr(),\n109\t        None => std::ptr::null(),\n110\t    };\n111\t    let (rc, rr) = unsafe { (ci(cs.as_mut_ptr(), kp, keylen), ri(rs.as_mut_ptr(), kp, keylen)) };\n112\t    eqi(&format!(\"{label}: init rc\"), rc, rr);\n113\t    assert_eq!(rc, 0, \"{label}: init must return 0\");\n114\t    eqb(&format!(\"{label}: STATE after init\"), &cs[..sb], &rs[..sb]);\n115\t    check_pad(&format!(\"{label}: C state\"), &cs, sb);\n116\t    check_pad(&format!(\"{label}: R state\"), &rs, sb);\n117\t\n118\t    for (i, ch) in chunks.iter().enumerate() {\n119\t        let (rc, rr) = unsafe {\n120\t            (\n121\t                cu(cs.as_mut_ptr(), ch.as_ptr(), ch.len() as u64),\n122\t                ru(rs.as_mut_ptr(), ch.as_ptr(), ch.len() as u64),\n123\t            )\n124\t        };\n125\t        eqi(&format!(\"{label}: update[{i}] rc\"), rc, rr);\n126\t        assert_eq!(rc, 0, \"{label}: update must return 0\");\n127\t        eqb(\n128\t            &format!(\"{label}: STATE after update[{i}] (len {})\", ch.len()),\n129\t            &cs[..sb],\n130\t            &rs[..sb],\n131\t        );\n132\t        check_pad(&format!(\"{label}: C state\"), &cs, sb);\n133\t        check_pad(&format!(\"{label}: R state\"), &rs, sb);\n134\t    }\n135\t\n136\t    let mut co = padded(h.tag);\n137\t    let mut ro = padded(h.tag);\n138\t    let (rc, rr) = unsafe { (cf(cs.as_mut_ptr(), co.as_mut_ptr()), rf(rs.as_mut_ptr(), ro.as_mut_ptr())) };\n139\t    eqi(&format!(\"{label}: final rc\"), rc, rr);\n140\t    assert_eq!(rc, 0, \"{label}: final must return 0\");\n141\t    eqb(&format!(\"{label}: tag\"), &co[..h.tag], &ro[..h.tag]);\n142\t    eqb(&format!(\"{label}: STATE after final\"), &cs[..sb], &rs[..sb]);\n143\t    check_pad(&format!(\"{label}: C out\"), &co, h.tag);\n144\t    check_pad(&format!(\"{label}: R out\"), &ro, h.tag);\n145\t    co.truncate(h.tag);\n146\t    co\n147\t}\n148\t\n149\tfn chunks_of<'a>(msg: &'a [u8], cuts: &[usize]) -> Vec<&'a [u8]> {\n150\t    let mut v = Vec::new();\n151\t    let mut prev = 0usize;\n152\t    for &c in cuts {\n153\t        assert!(c >= prev && c <= msg.len());\n154\t        v.push(&msg[prev..c]);\n155\t        prev = c;\n156\t    }\n157\t    v.push(&msg[prev..]);\n158\t    v\n159\t}\n160\t\n161\tfn random_cuts(rng: &mut Rng, len: usize, n: usize) -> Vec<usize> {\n162\t    let mut c: Vec<usize> = (0..n).map(|_| rng.below(len + 1)).collect();\n163\t    c.sort_unstable();\n164\t    c\n165\t}\n166\t\n167\tfn exports(which: &str, name: &str) -> bool {\n168\t    let l = if which == \"c\" { c_lib() } else { rust_lib() };\n169\t    let mut b: Vec<u8> = name.as_bytes().to_vec();\n170\t    b.push(0);\n171\t    unsafe { l.get::<*const std::ffi::c_void>(&b).is_ok() }\n172\t}\n173\t\n174\t// ======================================================================\n175\t// 4.4, 4.5, 4.6, 4.53, 4.100, 4.140 — accessors and API shape\n176\t// ======================================================================\n177\t\n178\t#[test]\n179\tfn accessors_and_api_shape() {\n180\t    // 4.5 / 4.4 — generic accessors.\n181\t    assert_eq!(size_of_both(\"crypto_auth_bytes\"), 32);\n182\t    assert_eq!(size_of_both(\"crypto_auth_keybytes\"), 32);\n183\t    let (cp, rp) = both::<StrFn>(\"crypto_auth_primitive\");\n184\t    unsafe {\n185\t        let cs = std::ffi::CStr::from_ptr(cp());\n186\t        let rs = std::ffi::CStr::from_ptr(rp());\n187\t        assert_eq!(cs.to_bytes(), b\"hmacsha512256\");\n188\t        assert_eq!(cs, rs, \"crypto_auth_primitive mismatch\");\n189\t    }\n190\t\n191\t    // 4.53 — hmacsha256: 32 / 32 / two crypto_hash_sha256_state (104 each).\n192\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha256_bytes\"), 32);\n193\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha256_keybytes\"), 32);\n194\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha256_statebytes\"), 208);\n195\t\n196\t    // 4.100 — hmacsha512: 64 / 32 / two crypto_hash_sha512_state (208 each).\n197\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha512_bytes\"), 64);\n198\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha512_keybytes\"), 32);\n199\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha512_statebytes\"), 416);\n200\t\n201\t    // 4.140 — hmacsha512256 statebytes == hmacsha512 statebytes (typedef).\n202\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha512256_bytes\"), 32);\n203\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha512256_keybytes\"), 32);\n204\t    assert_eq!(size_of_both(\"crypto_auth_hmacsha512256_statebytes\"), 416);\n205\t    assert_eq!(\n206\t        size_of_both(\"crypto_auth_hmacsha512256_statebytes\"),\n207\t        size_of_both(\"crypto_auth_hmacsha512_statebytes\")\n208\t    );\n209\t\n210\t    // 4.6 — the generic crypto_auth API exposes no streaming surface at all;\n211\t    // the Rust port must not invent one.\n212\t    for name in [\n213\t        \"crypto_auth_statebytes\",\n214\t        \"crypto_auth_init\",\n215\t        \"crypto_auth_update\",\n216\t        \"crypto_auth_final\",\n217\t        \"crypto_auth_state\",\n218\t    ] {\n219\t        assert!(!exports(\"c\", name), \"C unexpectedly exports {name}\");\n220\t        assert!(\n221\t            !exports(\"r\", name),\n222\t            \"Rust invented a generic streaming symbol `{name}` that the C API does not have\"\n223\t        );\n224\t    }\n225\t}\n226\t\n227\t// ======================================================================\n228\t// hmacsha256\n229\t// ======================================================================\n230\t\n231\t// 4.7–4.18 (one-shot, every length) + 4.48 (good tag verifies)\n232\t#[test]\n233\tfn sha256_oneshot_lengths() {\n234\t    let mut rng = Rng::new(0x4_0256);\n235\t    for &len in LENS.iter() {\n236\t        for rep in 0..6 {\n237\t            let key = rng.bytes(32);\n238\t            let msg = rng.bytes(len);\n239\t            let tag = oneshot(&SHA256, &msg, &key, &format!(\"sha256 len={len} rep={rep}\"));\n240\t            // 4.48 — the freshly produced tag must verify.\n241\t            assert_eq!(\n242\t                verify(&SHA256, &tag, &msg, &key, &format!(\"sha256 good len={len}\")),\n243\t                0\n244\t            );\n245\t        }\n246\t    }\n247\t}\n248\t\n249\t// 4.19–4.30 — streaming with a single update must be bit-identical to one-shot.\n250\t#[test]\n251\tfn sha256_streaming_single_update() {\n252\t    let mut rng = Rng::new(0x4_0257);\n253\t    for &len in LENS.iter() {\n254\t        for rep in 0..4 {\n255\t            let key = rng.bytes(32);\n256\t            let msg = rng.bytes(len);\n257\t            let a = oneshot(&SHA256, &msg, &key, &format!(\"sha256 os len={len}\"));\n258\t            let b = stream(\n259\t                &SHA256,\n260\t                Some(&key),\n261\t                32,\n262\t                &[&msg[..]],\n263\t                &format!(\"sha256 stream1 len={len} rep={rep}\"),\n264\t            );\n265\t            eqb(&format!(\"sha256 stream==oneshot len={len}\"), &a, &b);\n266\t        }\n267\t    }\n268\t}\n269\t\n270\t// 4.31–4.37 — the documented multi-update splits, plus many randomized ones.\n271\t#[test]\n272\tfn sha256_multi_update_splits() {\n273\t    let mut rng = Rng::new(0x4_0258);\n274\t    let key = rng.bytes(32);\n275\t\n276\t    // fixed splits from the table\n277\t    let fixed: [(usize, &[usize]); 8] = [\n278\t        (64, &[0]),        // 4.31 (0, 64)\n279\t        (64, &[1]),        // 4.32 (1, 63)\n280\t        (64, &[63]),       // 4.33 (63, 1)\n281\t        (65, &[64]),       // 4.34 (64, 1)\n282\t        (64, &[32]),       // 4.35 (32, 32)\n283\t        (112, &[40, 80]),  // 4.37 (40, 40, 32)\n284\t        (112, &[56]),      // 4.37 (56, 56)\n285\t        (129, &[0, 0, 0]), // repeated zero-length no-ops\n286\t    ];\n287\t    for (len, cuts) in fixed.iter() {\n288\t        let msg = rng.bytes(*len);\n289\t        let a = oneshot(&SHA256, &msg, &key, \"sha256 split ref\");\n290\t        let b = stream(\n291\t            &SHA256,\n292\t            Some(&key),\n293\t            32,\n294\t            &chunks_of(&msg, cuts),\n295\t            &format!(\"sha256 split len={len} cuts={cuts:?}\"),\n296\t        );\n297\t        eqb(&format!(\"sha256 split len={len} cuts={cuts:?}\"), &a, &b);\n298\t    }\n299\t\n300\t    // 4.36 — 129 one-byte updates\n301\t    {\n302\t        let msg = rng.bytes(129);\n303\t        let single: Vec<&[u8]> = msg.iter().map(std::slice::from_ref).collect();\n304\t        let a = oneshot(&SHA256, &msg, &key, \"sha256 129x1 ref\");\n305\t        let b = stream(&SHA256, Some(&key), 32, &single, \"sha256 129x1\");\n306\t        eqb(\"sha256 129 one-byte updates\", &a, &b);\n307\t    }\n308\t\n309\t    // randomized splits straddling every boundary\n310\t    for len in 0..=200usize {\n311\t        for n in [1usize, 2, 3, 5] {\n312\t            let msg = rng.bytes(len);\n313\t            let cuts = random_cuts(&mut rng, len, n);\n314\t            let a = oneshot(&SHA256, &msg, &key, \"sha256 rnd ref\");\n315\t            let b = stream(\n316\t                &SHA256,\n317\t                Some(&key),\n318\t                32,\n319\t                &chunks_of(&msg, &cuts),\n320\t                &format!(\"sha256 rnd len={len} cuts={cuts:?}\"),\n321\t            );\n322\t            eqb(&format!(\"sha256 rnd len={len} cuts={cuts:?}\"), &a, &b);\n323\t        }\n324\t    }\n325\t}\n326\t\n327\t// 4.38, 4.39 (== errors_4 4.18), 4.40–4.47 (== errors_4 4.20)\n328\t#[test]\n329\tfn sha256_key_lengths() {\n330\t    let mut rng = Rng::new(0x4_0259);\n331\t    let msg = rng.bytes(77);\n332\t\n333\t    // 4.38 / 4.39 — keylen == 0 with non-NULL and with NULL key agree, and both\n334\t    // return 0 (errors_4 4.18: the `key == NULL` arm does *not* misuse when\n335\t    // keylen == 0).\n336\t    let dummy = rng.bytes(16);\n337\t    let a = stream(&SHA256, Some(&dummy), 0, &[&msg[..]], \"sha256 keylen=0 non-null\");\n338\t    let b = stream(&SHA256, None, 0, &[&msg[..]], \"sha256 keylen=0 NULL\");\n339\t    eqb(\"sha256 keylen=0: NULL key == non-NULL key\", &a, &b);\n340\t\n341\t    for &kl in &[0usize, 1, 2, 15, 31, 32, 33, 63, 64, 65, 96, 127, 128, 129, 200, 256, 1000] {\n342\t        for rep in 0..3 {\n343\t            let key = rng.bytes(kl);\n344\t            let t = stream(\n345\t                &SHA256,\n346\t                Some(&key),\n347\t                kl,\n348\t                &[&msg[..]],\n349\t                &format!(\"sha256 keylen={kl} rep={rep}\"),\n350\t            );\n351\t            // multi-chunk must agree too\n352\t            let cuts = random_cuts(&mut rng, msg.len(), 3);\n353\t            let t2 = stream(\n354\t                &SHA256,\n355\t                Some(&key),\n356\t                kl,\n357\t                &chunks_of(&msg, &cuts),\n358\t                &format!(\"sha256 keylen={kl} split\"),\n359\t            );\n360\t            eqb(\"sha256 keylen split\", &t, &t2);\n361\t\n362\t            // 4.42 — keylen == KEYBYTES is exactly what the one-shot uses.\n363\t            if kl == 32 {\n364\t                let os = oneshot(&SHA256, &msg, &key, \"sha256 keylen32 oneshot\");\n365\t                eqb(\"sha256 keylen=32 == one-shot\", &t, &os);\n366\t            }\n367\t            // 4.45–4.47 / errors_4 4.20 — keylen > 64 hashes the key to\n368\t            // SHA-256(key) and forces keylen = 32.  keylen == 64 must NOT hash.\n369\t            if kl > 64 {\n370\t                let (ch, rh) = both::<\n371\t                    unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> c_int,\n372\t                >(\"crypto_hash_sha256\");\n373\t                let mut khc = [0u8; 32];\n374\t                let mut khr = [0u8; 32];\n375\t                unsafe {\n376\t                    assert_eq!(ch(khc.as_mut_ptr(), key.as_ptr(), kl as u64), 0);\n377\t                    assert_eq!(rh(khr.as_mut_ptr(), key.as_ptr(), kl as u64), 0);\n378\t                }\n379\t                eqb(\"crypto_hash_sha256 of long key\", &khc, &khr);\n380\t                let t3 = stream(\n381\t                    &SHA256,\n382\t                    Some(&khc),\n383\t                    32,\n384\t                    &[&msg[..]],\n385\t                    &format!(\"sha256 hashed-key keylen={kl}\"),\n386\t                );\n387\t                eqb(&format!(\"sha256 keylen={kl} == SHA256(key)\"), &t, &t3);\n388\t            }\n389\t        }\n390\t    }\n391\t\n392\t    // 4.44 boundary proof: keylen == 64 does not hash, i.e. it differs from the\n393\t    // tag obtained with SHA-256(key) as a 32-byte key (with overwhelming\n394\t    // probability) — the important part is that C and Rust agree, which\n395\t    // `stream()` already asserted; here we additionally pin the boundary.\n396\t    let k64 = rng.bytes(64);\n397\t    let t64 = stream(&SHA256, Some(&k64), 64, &[&msg[..]], \"sha256 keylen=64\");\n398\t    let mut kh = [0u8; 32];\n399\t    let (ch, _rh) =\n400\t        both::<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> c_int>(\"crypto_hash_sha256\");\n401\t    unsafe {\n402\t        assert_eq!(ch(kh.as_mut_ptr(), k64.as_ptr(), 64), 0);\n403\t    }\n404\t    let th = stream(&SHA256, Some(&kh), 32, &[&msg[..]], \"sha256 keylen=64 hashed\");\n405\t    assert_ne!(t64, th, \"keylen == 64 must NOT be hashed (boundary is `>` not `>=`)\");\n406\t}\n407\t\n408\t// 4.49, 4.50, 4.51 / errors_4 4.1, 4.2\n409\t#[test]\n410\tfn sha256_verify_corruption() {\n411\t    let mut rng = Rng::new(0x4_025a);\n412\t    for &len in LENS.iter() {\n413\t        let key = rng.bytes(32);\n414\t        let msg = rng.bytes(len);\n415\t        let tag = oneshot(&SHA256, &msg, &key, \"sha256 verify base\");\n416\t        assert_eq!(verify(&SHA256, &tag, &msg, &key, \"sha256 good\"), 0);\n417\t\n418\t        // every byte position, every bit\n419\t        for i in 0..32usize {\n420\t            for bit in 0..8u32 {\n421\t                let mut bad = tag.clone();\n422\t                bad[i] ^= 1u8 << bit;\n423\t                assert_eq!(\n424\t                    verify(&SHA256, &bad, &msg, &key, &format!(\"sha256 bad[{i}:{bit}]\")),\n425\t                    -1,\n426\t                    \"sha256 flipped bit {bit} of byte {i} must reject\"\n427\t                );\n428\t            }\n429\t        }\n430\t        // 4.51 — all-zero, random, wrong message, wrong key\n431\t        assert_eq!(verify(&SHA256, &[0u8; 32], &msg, &key, \"sha256 zero tag\"), -1);\n432\t        for _ in 0..8 {\n433\t            let rnd = rng.bytes(32);\n434\t            if rnd == tag {\n435\t                continue;\n436\t            }\n437\t            assert_eq!(verify(&SHA256, &rnd, &msg, &key, \"sha256 random tag\"), -1);\n438\t        }\n439\t        let mut other = msg.clone();\n440\t        other.push(0);\n441\t        assert_eq!(verify(&SHA256, &tag, &other, &key, \"sha256 wrong msg\"), -1);\n442\t        let mut k2 = key.clone();\n443\t        k2[0] ^= 1;\n444\t        assert_eq!(verify(&SHA256, &tag, &msg, &k2, \"sha256 wrong key\"), -1);\n445\t    }\n446\t}\n447\t\n448\t// 4.52 — keygen\n449\t#[test]\n450\tfn sha256_keygen() {\n451\t    let (c, r) = both::<Keygen>(\"crypto_auth_hmacsha256_keygen\");\n452\t    let mut prev: Option<Vec<u8>> = None;\n453\t    for i in 0..8 {\n454\t        rng_reseed(0x9000 + i as u64);\n455\t        let mut ck = padded(32);\n456\t        let mut rk = padded(32);\n457\t        unsafe {\n458\t            c(ck.as_mut_ptr());\n459\t            r(rk.as_mut_ptr());\n460\t        }\n461\t        eqb(\"hmacsha256_keygen\", &ck[..32], &rk[..32]);\n462\t        check_pad(\"hmacsha256_keygen C\", &ck, 32);\n463\t        check_pad(\"hmacsha256_keygen R\", &rk, 32);\n464\t        if let Some(p) = &prev {\n465\t            assert_ne!(p, &ck[..32].to_vec(), \"successive keygen outputs must differ\");\n466\t        }\n467\t        prev = Some(ck[..32].to_vec());\n468\t        // usable as a key (4.42)\n469\t        let msg = vec![7u8; 40];\n470\t        oneshot(&SHA256, &msg, &ck[..32], \"sha256 keygen key\");\n471\t    }\n472\t}\n473\t\n474\t// ======================================================================\n475\t// hmacsha512\n476\t// ======================================================================\n477\t\n478\t// 4.54–4.65 + 4.95\n479\t#[test]\n480\tfn sha512_oneshot_lengths() {\n481\t    let mut rng = Rng::new(0x4_0512);\n482\t    for &len in LENS.iter() {\n483\t        for rep in 0..6 {\n484\t            let key = rng.bytes(32);\n485\t            let msg = rng.bytes(len);\n486\t            let tag = oneshot(&SHA512, &msg, &key, &format!(\"sha512 len={len} rep={rep}\"));\n487\t            assert_eq!(verify(&SHA512, &tag, &msg, &key, \"sha512 good\"), 0);\n488\t        }\n489\t    }\n490\t}\n491\t\n492\t// 4.66–4.77\n493\t#[test]\n494\tfn sha512_streaming_single_update() {\n495\t    let mut rng = Rng::new(0x4_0513);\n496\t    for &len in LENS.iter() {\n497\t        for rep in 0..4 {\n498\t            let key = rng.bytes(32);\n499\t            let msg = rng.bytes(len);\n500\t            let a = oneshot(&SHA512, &msg, &key, \"sha512 os\");\n501\t            let b = stream(\n502\t                &SHA512,\n503\t                Some(&key),\n504\t                32,\n505\t                &[&msg[..]],\n506\t                &format!(\"sha512 stream1 len={len} rep={rep}\"),\n507\t            );\n508\t            eqb(&format!(\"sha512 stream==oneshot len={len}\"), &a, &b);\n509\t        }\n510\t    }\n511\t}\n512\t\n513\t// 4.78–4.84\n514\t#[test]\n515\tfn sha512_multi_update_splits() {\n516\t    let mut rng = Rng::new(0x4_0514);\n517\t    let key = rng.bytes(32);\n518\t    let fixed: [(usize, &[usize]); 7] = [\n519\t        (128, &[0]),      // 4.78\n520\t        (128, &[1]),      // 4.79\n521\t        (128, &[127]),    // 4.80\n522\t        (129, &[128]),    // 4.81\n523\t        (128, &[64]),     // 4.82\n524\t        (112, &[40, 80]), // 4.84\n525\t        (129, &[0, 0]),   // zero-length no-ops\n526\t    ];\n527\t    for (len, cuts) in fixed.iter() {\n528\t        let msg = rng.bytes(*len);\n529\t        let a = oneshot(&SHA512, &msg, &key, \"sha512 split ref\");\n530\t        let b = stream(\n531\t            &SHA512,\n532\t            Some(&key),\n533\t            32,\n534\t            &chunks_of(&msg, cuts),\n535\t            &format!(\"sha512 split len={len} cuts={cuts:?}\"),\n536\t        );\n537\t        eqb(&format!(\"sha512 split len={len} cuts={cuts:?}\"), &a, &b);\n538\t    }\n539\t    // 4.83 — 129 one-byte updates\n540\t    let msg = rng.bytes(129);\n541\t    let single: Vec<&[u8]> = msg.iter().map(std::slice::from_ref).collect();\n542\t    let a = oneshot(&SHA512, &msg, &key, \"sha512 129x1 ref\");\n543\t    let b = stream(&SHA512, Some(&key), 32, &single, \"sha512 129x1\");\n544\t    eqb(\"sha512 129 one-byte updates\", &a, &b);\n545\t\n546\t    for len in 0..=200usize {\n547\t        for n in [1usize, 2, 4] {\n548\t            let msg = rng.bytes(len);\n549\t            let cuts = random_cuts(&mut rng, len, n);\n550\t            let a = oneshot(&SHA512, &msg, &key, \"sha512 rnd ref\");\n551\t            let b = stream(\n552\t                &SHA512,\n553\t                Some(&key),\n554\t                32,\n555\t                &chunks_of(&msg, &cuts),\n556\t                &format!(\"sha512 rnd len={len} cuts={cuts:?}\"),\n557\t            );\n558\t            eqb(&format!(\"sha512 rnd len={len} cuts={cuts:?}\"), &a, &b);\n559\t        }\n560\t    }\n561\t}\n562\t\n563\t// 4.85–4.94 / errors_4 4.19, 4.21\n564\t#[test]\n565\tfn sha512_key_lengths() {\n566\t    let mut rng = Rng::new(0x4_0515);\n567\t    let msg = rng.bytes(101);\n568\t\n569\t    let dummy = rng.bytes(16);\n570\t    let a = stream(&SHA512, Some(&dummy), 0, &[&msg[..]], \"sha512 keylen=0 non-null\");\n571\t    let b = stream(&SHA512, None, 0, &[&msg[..]], \"sha512 keylen=0 NULL\");\n572\t    eqb(\"sha512 keylen=0: NULL key == non-NULL key\", &a, &b);\n573\t\n574\t    for &kl in &[0usize, 1, 2, 31, 32, 33, 63, 64, 65, 127, 128, 129, 200, 256, 257, 1000] {\n575\t        for rep in 0..3 {\n576\t            let key = rng.bytes(kl);\n577\t            let t = stream(\n578\t                &SHA512,\n579\t                Some(&key),\n580\t                kl,\n581\t                &[&msg[..]],\n582\t                &format!(\"sha512 keylen={kl} rep={rep}\"),\n583\t            );\n584\t            let cuts = random_cuts(&mut rng, msg.len(), 3);\n585\t            let t2 = stream(\n586\t                &SHA512,\n587\t                Some(&key),\n588\t                kl,\n589\t                &chunks_of(&msg, &cuts),\n590\t                &format!(\"sha512 keylen={kl} split\"),\n591\t            );\n592\t            eqb(\"sha512 keylen split\", &t, &t2);\n593\t            if kl == 32 {\n594\t                let os = oneshot(&SHA512, &msg, &key, \"sha512 keylen32 oneshot\");\n595\t                eqb(\"sha512 keylen=32 == one-shot\", &t, &os);\n596\t            }\n597\t            if kl > 128 {\n598\t                let (ch, rh) = both::<\n599\t                    unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> c_int,\n600\t                >(\"crypto_hash_sha512\");\n601\t                let mut khc = [0u8; 64];\n602\t                let mut khr = [0u8; 64];\n603\t                unsafe {\n604\t                    assert_eq!(ch(khc.as_mut_ptr(), key.as_ptr(), kl as u64), 0);\n605\t                    assert_eq!(rh(khr.as_mut_ptr(), key.as_ptr(), kl as u64), 0);\n606\t                }\n607\t                eqb(\"crypto_hash_sha512 of long key\", &khc, &khr);\n608\t                let t3 = stream(\n609\t                    &SHA512,\n610\t                    Some(&khc),\n611\t                    64,\n612\t                    &[&msg[..]],\n613\t                    &format!(\"sha512 hashed-key keylen={kl}\"),\n614\t                );\n615\t                eqb(&format!(\"sha512 keylen={kl} == SHA512(key)\"), &t, &t3);\n616\t            }\n617\t        }\n618\t    }\n619\t\n620\t    // 4.91 boundary: keylen == 128 must not hash.\n621\t    let k128 = rng.bytes(128);\n622\t    let t128 = stream(&SHA512, Some(&k128), 128, &[&msg[..]], \"sha512 keylen=128\");\n623\t    let mut kh = [0u8; 64];\n624\t    let (ch, _r) =\n625\t        both::<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> c_int>(\"crypto_hash_sha512\");\n626\t    unsafe {\n627\t        assert_eq!(ch(kh.as_mut_ptr(), k128.as_ptr(), 128), 0);\n628\t    }\n629\t    let th = stream(&SHA512, Some(&kh), 64, &[&msg[..]], \"sha512 keylen=128 hashed\");\n630\t    assert_ne!(t128, th, \"keylen == 128 must NOT be hashed\");\n631\t}\n632\t\n633\t// 4.96, 4.97, 4.98 / errors_4 4.4, 4.5\n634\t#[test]\n635\tfn sha512_verify_corruption() {\n636\t    let mut rng = Rng::new(0x4_0516);\n637\t    for &len in LENS.iter() {\n638\t        let key = rng.bytes(32);\n639\t        let msg = rng.bytes(len);\n640\t        let tag = oneshot(&SHA512, &msg, &key, \"sha512 verify base\");\n641\t        assert_eq!(verify(&SHA512, &tag, &msg, &key, \"sha512 good\"), 0);\n642\t        for i in 0..64usize {\n643\t            for bit in 0..8u32 {\n644\t                let mut bad = tag.clone();\n645\t                bad[i] ^= 1u8 << bit;\n646\t                assert_eq!(\n647\t                    verify(&SHA512, &bad, &msg, &key, &format!(\"sha512 bad[{i}:{bit}]\")),\n648\t                    -1\n649\t                );\n650\t            }\n651\t        }\n652\t        assert_eq!(verify(&SHA512, &[0u8; 64], &msg, &key, \"sha512 zero tag\"), -1);\n653\t        for _ in 0..6 {\n654\t            let rnd = rng.bytes(64);\n655\t            assert_eq!(verify(&SHA512, &rnd, &msg, &key, \"sha512 random tag\"), -1);\n656\t        }\n657\t        let mut other = msg.clone();\n658\t        other.push(0xff);\n659\t        assert_eq!(verify(&SHA512, &tag, &other, &key, \"sha512 wrong msg\"), -1);\n660\t        let mut k2 = key.clone();\n661\t        k2[31] ^= 0x80;\n662\t        assert_eq!(verify(&SHA512, &tag, &msg, &k2, \"sha512 wrong key\"), -1);\n663\t    }\n664\t}\n665\t\n666\t// 4.99\n667\t#[test]\n668\tfn sha512_keygen() {\n669\t    let (c, r) = both::<Keygen>(\"crypto_auth_hmacsha512_keygen\");\n670\t    let mut prev: Option<Vec<u8>> = None;\n671\t    for i in 0..8 {\n672\t        rng_reseed(0xA000 + i as u64);\n673\t        let mut ck = padded(32);\n674\t        let mut rk = padded(32);\n675\t        unsafe {\n676\t            c(ck.as_mut_ptr());\n677\t            r(rk.as_mut_ptr());\n678\t        }\n679\t        eqb(\"hmacsha512_keygen\", &ck[..32], &rk[..32]);\n680\t        check_pad(\"hmacsha512_keygen C\", &ck, 32);\n681\t        check_pad(\"hmacsha512_keygen R\", &rk, 32);\n682\t        if let Some(p) = &prev {\n683\t            assert_ne!(p, &ck[..32].to_vec());\n684\t        }\n685\t        prev = Some(ck[..32].to_vec());\n686\t    }\n687\t}\n688\t\n689\t// ======================================================================\n690\t// hmacsha512256\n691\t// ======================================================================\n692\t\n693\t// 4.101–4.112 + 4.135\n694\t#[test]\n695\tfn sha512256_oneshot_lengths() {\n696\t    let mut rng = Rng::new(0x4_5225);\n697\t    for &len in LENS.iter() {\n698\t        for rep in 0..6 {\n699\t            let key = rng.bytes(32);\n700\t            let msg = rng.bytes(len);\n701\t            let tag = oneshot(&SHA512256, &msg, &key, &format!(\"512256 len={len} rep={rep}\"));\n702\t            assert_eq!(verify(&SHA512256, &tag, &msg, &key, \"512256 good\"), 0);\n703\t        }\n704\t    }\n705\t}\n706\t\n707\t// 4.113–4.124\n708\t#[test]\n709\tfn sha512256_streaming_single_update() {\n710\t    let mut rng = Rng::new(0x4_5226);\n711\t    for &len in LENS.iter() {\n712\t        for rep in 0..4 {\n713\t            let key = rng.bytes(32);\n714\t            let msg = rng.bytes(len);\n715\t            let a = oneshot(&SHA512256, &msg, &key, \"512256 os\");\n716\t            let b = stream(\n717\t                &SHA512256,\n718\t                Some(&key),\n719\t                32,\n720\t                &[&msg[..]],\n721\t                &format!(\"512256 stream1 len={len} rep={rep}\"),\n722\t            );\n723\t            eqb(&format!(\"512256 stream==oneshot len={len}\"), &a, &b);\n724\t        }\n725\t    }\n726\t}\n727\t\n728\t// 4.125–4.128\n729\t#[test]\n730\tfn sha512256_multi_update_splits() {\n731\t    let mut rng = Rng::new(0x4_5227);\n732\t    let key = rng.bytes(32);\n733\t    let fixed: [(usize, &[usize]); 6] = [\n734\t        (129, &[0]),   // 4.125 (0, n)\n735\t        (129, &[1]),   // 4.125 (1, n-1)\n736\t        (128, &[127]), // 4.126 (127, 1)\n737\t        (129, &[128]), // 4.126 (128, 1)\n738\t        (128, &[64]),  // 4.127 (64, 64)\n739\t        (129, &[0, 129, 129]),\n740\t    ];\n741\t    for (len, cuts) in fixed.iter() {\n742\t        let msg = rng.bytes(*len);\n743\t        let a = oneshot(&SHA512256, &msg, &key, \"512256 split ref\");\n744\t        let b = stream(\n745\t            &SHA512256,\n746\t            Some(&key),\n747\t            32,\n748\t            &chunks_of(&msg, cuts),\n749\t            &format!(\"512256 split len={len} cuts={cuts:?}\"),\n750\t        );\n751\t        eqb(&format!(\"512256 split len={len} cuts={cuts:?}\"), &a, &b);\n752\t    }\n753\t    // 4.128 — 129 one-byte updates\n754\t    let msg = rng.bytes(129);\n755\t    let single: Vec<&[u8]> = msg.iter().map(std::slice::from_ref).collect();\n756\t    let a = oneshot(&SHA512256, &msg, &key, \"512256 129x1 ref\");\n757\t    let b = stream(&SHA512256, Some(&key), 32, &single, \"512256 129x1\");\n758\t    eqb(\"512256 129 one-byte updates\", &a, &b);\n759\t\n760\t    for len in 0..=160usize {\n761\t        for n in [1usize, 2, 4] {\n762\t            let msg = rng.bytes(len);\n763\t            let cuts = random_cuts(&mut rng, len, n);\n764\t            let a = oneshot(&SHA512256, &msg, &key, \"512256 rnd ref\");\n765\t            let b = stream(\n766\t                &SHA512256,\n767\t                Some(&key),\n768\t                32,\n769\t                &chunks_of(&msg, &cuts),\n770\t                &format!(\"512256 rnd len={len} cuts={cuts:?}\"),\n771\t            );\n772\t            eqb(&format!(\"512256 rnd len={len} cuts={cuts:?}\"), &a, &b);\n773\t        }\n774\t    }\n775\t}\n776\t\n777\t// 4.129–4.132\n778\t#[test]\n779\tfn sha512256_key_lengths() {\n780\t    let mut rng = Rng::new(0x4_5228);\n781\t    let msg = rng.bytes(93);\n782\t\n783\t    // 4.132 — keylen 0 with key == NULL is permitted.\n784\t    let dummy = rng.bytes(8);\n785\t    let a = stream(&SHA512256, Some(&dummy), 0, &[&msg[..]], \"512256 keylen=0 non-null\");\n786\t    let b = stream(&SHA512256, None, 0, &[&msg[..]], \"512256 keylen=0 NULL\");\n787\t    eqb(\"512256 keylen=0: NULL == non-NULL\", &a, &b);\n788\t\n789\t    // 4.129 {0,1,32,64,127}, 4.130 {128}, 4.131 {129,256,1000}\n790\t    for &kl in &[0usize, 1, 32, 64, 127, 128, 129, 256, 1000] {\n791\t        let key = rng.bytes(kl);\n792\t        let t = stream(&SHA512256, Some(&key), kl, &[&msg[..]], &format!(\"512256 keylen={kl}\"));\n793\t        // must be the 32-byte prefix of the hmacsha512 tag with the same key\n794\t        let t512 = stream(&SHA512, Some(&key), kl, &[&msg[..]], &format!(\"sha512 keylen={kl}\"));\n795\t        eqb(&format!(\"512256 keylen={kl} truncation\"), &t, &t512[..32]);\n796\t        if kl > 128 {\n797\t            let (ch, _r) =\n798\t                both::<unsafe extern \"C\" fn(*mut u8, *const u8, u64) -> c_int>(\"crypto_hash_sha512\");\n799\t            let mut kh = [0u8; 64];\n800\t            unsafe {\n801\t                assert_eq!(ch(kh.as_mut_ptr(), key.as_ptr(), kl as u64), 0);\n802\t            }\n803\t            let t3 = stream(&SHA512256, Some(&kh), 64, &[&msg[..]], \"512256 hashed key\");\n804\t            eqb(&format!(\"512256 keylen={kl} == SHA512(key)\"), &t, &t3);\n805\t        }\n806\t    }\n807\t}\n808\t\n809\t// 4.133 — truncation semantics vs. hmacsha512\n810\t#[test]\n811\tfn sha512256_truncation_vs_sha512() {\n812\t    let mut rng = Rng::new(0x4_5229);\n813\t    for &len in LENS.iter() {\n814\t        for _ in 0..4 {\n815\t            let key = rng.bytes(32);\n816\t            let msg = rng.bytes(len);\n817\t            let t256 = oneshot(&SHA512256, &msg, &key, \"512256 trunc\");\n818\t            let t512 = oneshot(&SHA512, &msg, &key, \"sha512 trunc\");\n819\t            eqb(\n820\t                &format!(\"512256 tag == first 32 bytes of sha512 tag (len={len})\"),\n821\t                &t256,\n822\t                &t512[..32],\n823\t            );\n824\t            // 4.138 — bytes 32..63 of the untruncated tag must be rejected.\n825\t            assert_eq!(\n826\t                verify(&SHA512256, &t512[32..64], &msg, &key, \"512256 truncation confusion\"),\n827\t                -1\n828\t            );\n829\t        }\n830\t    }\n831\t}\n832\t\n833\t// 4.134 — cross-API state interop (hmacsha512256_state is a typedef of\n834\t// hmacsha512_state), verified through the *_statebytes()-sized raw buffer.\n835\t#[test]\n836\tfn sha512256_state_interop_with_sha512() {\n837\t    let mut rng = Rng::new(0x4_522a);\n838\t    let sb = size_of_both(\"crypto_auth_hmacsha512256_statebytes\");\n839\t    assert_eq!(sb, size_of_both(\"crypto_auth_hmacsha512_statebytes\"));\n840\t\n841\t    let (c256i, r256i) = both::<Init>(\"crypto_auth_hmacsha512256_init\");\n842\t    let (c512u, r512u) = both::<Update>(\"crypto_auth_hmacsha512_update\");\n843\t    let (c512f, r512f) = both::<Fin>(\"crypto_auth_hmacsha512_final\");\n844\t    let (c256f, r256f) = both::<Fin>(\"crypto_auth_hmacsha512256_final\");\n845\t    let (c512i, r512i) = both::<Init>(\"crypto_auth_hmacsha512_init\");\n846\t    let (c256u, r256u) = both::<Update>(\"crypto_auth_hmacsha512256_update\");\n847\t\n848\t    for &len in LENS.iter() {\n849\t        let key = rng.bytes(32);\n850\t        let msg = rng.bytes(len);\n851\t\n852\t        // (a) 512256_init + 512_update + 512_final -> 64-byte tag\n853\t        let mut cs = padded(sb);\n854\t        let mut rs = padded(sb);\n855\t        unsafe {\n856\t            eqi(\"interop a init\", c256i(cs.as_mut_ptr(), key.as_ptr(), 32), r256i(rs.as_mut_ptr(), key.as_ptr(), 32));\n857\t        }\n858\t        eqb(\"interop a STATE after init\", &cs[..sb], &rs[..sb]);\n859\t        unsafe {\n860\t            eqi(\n861\t                \"interop a update\",\n862\t                c512u(cs.as_mut_ptr(), msg.as_ptr(), len as u64),\n863\t                r512u(rs.as_mut_ptr(), msg.as_ptr(), len as u64),\n864\t            );\n865\t        }\n866\t        eqb(\"interop a STATE after update\", &cs[..sb], &rs[..sb]);\n867\t        let mut co = padded(64);\n868\t        let mut ro = padded(64);\n869\t        unsafe {\n870\t            eqi(\"interop a final\", c512f(cs.as_mut_ptr(), co.as_mut_ptr()), r512f(rs.as_mut_ptr(), ro.as_mut_ptr()));\n871\t        }\n872\t        eqb(\"interop a tag\", &co[..64], &ro[..64]);\n873\t        check_pad(\"interop a C out\", &co, 64);\n874\t        check_pad(\"interop a R out\", &ro, 64);\n875\t\n876\t        // (b) 512_init + 512256_update + 512256_final -> 32-byte tag\n877\t        let mut cs2 = padded(sb);\n878\t        let mut rs2 = padded(sb);\n879\t        unsafe {\n880\t            eqi(\"interop b init\", c512i(cs2.as_mut_ptr(), key.as_ptr(), 32), r512i(rs2.as_mut_ptr(), key.as_ptr(), 32));\n881\t        }\n882\t        eqb(\"interop b STATE after init\", &cs2[..sb], &rs2[..sb]);\n883\t        unsafe {\n884\t            eqi(\n885\t                \"interop b update\",\n886\t                c256u(cs2.as_mut_ptr(), msg.as_ptr(), len as u64),\n887\t                r256u(rs2.as_mut_ptr(), msg.as_ptr(), len as u64),\n888\t            );\n889\t        }\n890\t        eqb(\"interop b STATE after update\", &cs2[..sb], &rs2[..sb]);\n891\t        let mut co2 = padded(32);\n892\t        let mut ro2 = padded(32);\n893\t        unsafe {\n894\t            eqi(\"interop b final\", c256f(cs2.as_mut_ptr(), co2.as_mut_ptr()), r256f(rs2.as_mut_ptr(), ro2.as_mut_ptr()));\n895\t        }\n896\t        eqb(\"interop b tag\", &co2[..32], &ro2[..32]);\n897\t        check_pad(\"interop b C out\", &co2, 32);\n898\t        check_pad(\"interop b R out\", &ro2, 32);\n899\t\n900\t        // the 64-byte tag's prefix is the 32-byte tag\n901\t        eqb(\"interop: 64-byte prefix == 32-byte tag\", &co[..32], &co2[..32]);\n902\t        let os = oneshot(&SHA512, &msg, &key, \"interop reference\");\n903\t        eqb(\"interop: matches one-shot hmacsha512\", &co[..64], &os);\n904\t    }\n905\t}\n906\t\n907\t// 4.136, 4.137, 4.138 / errors_4 4.7, 4.8\n908\t#[test]\n909\tfn sha512256_verify_corruption() {\n910\t    let mut rng = Rng::new(0x4_522b);\n911\t    for &len in LENS.iter() {\n912\t        let key = rng.bytes(32);\n913\t        let msg = rng.bytes(len);\n914\t        let tag = oneshot(&SHA512256, &msg, &key, \"512256 verify base\");\n915\t        assert_eq!(verify(&SHA512256, &tag, &msg, &key, \"512256 good\"), 0);\n916\t        for i in 0..32usize {\n917\t            for bit in 0..8u32 {\n918\t                let mut bad = tag.clone();\n919\t                bad[i] ^= 1u8 << bit;\n920\t                assert_eq!(\n921\t                    verify(&SHA512256, &bad, &msg, &key, &format!(\"512256 bad[{i}:{bit}]\")),\n922\t                    -1\n923\t                );\n924\t            }\n925\t        }\n926\t        assert_eq!(verify(&SHA512256, &[0u8; 32], &msg, &key, \"512256 zero tag\"), -1);\n927\t        for _ in 0..6 {\n928\t            let rnd = rng.bytes(32);\n929\t            assert_eq!(verify(&SHA512256, &rnd, &msg, &key, \"512256 random tag\"), -1);\n930\t        }\n931\t        let mut other = msg.clone();\n932\t        other.push(1);\n933\t        assert_eq!(verify(&SHA512256, &tag, &other, &key, \"512256 wrong msg\"), -1);\n934\t        let mut k2 = key.clone();\n935\t        k2[7] ^= 0x10;\n936\t        assert_eq!(verify(&SHA512256, &tag, &msg, &k2, \"512256 wrong key\"), -1);\n937\t    }\n938\t}\n939\t\n940\t// 4.139\n941\t#[test]\n942\tfn sha512256_keygen() {\n943\t    let (c, r) = both::<Keygen>(\"crypto_auth_hmacsha512256_keygen\");\n944\t    let mut prev: Option<Vec<u8>> = None;\n945\t    for i in 0..8 {\n946\t        rng_reseed(0xB000 + i as u64);\n947\t        let mut ck = padded(32);\n948\t        let mut rk = padded(32);\n949\t        unsafe {\n950\t            c(ck.as_mut_ptr());\n951\t            r(rk.as_mut_ptr());\n952\t        }\n953\t        eqb(\"hmacsha512256_keygen\", &ck[..32], &rk[..32]);\n954\t        check_pad(\"hmacsha512256_keygen C\", &ck, 32);\n955\t        check_pad(\"hmacsha512256_keygen R\", &rk, 32);\n956\t        if let Some(p) = &prev {\n957\t            assert_ne!(p, &ck[..32].to_vec());\n958\t        }\n959\t        prev = Some(ck[..32].to_vec());\n960\t    }\n961\t}\n962\t\n963\t// ======================================================================\n964\t// generic crypto_auth wrapper — 4.1, 4.2, 4.3, 4.141 / errors_4 4.10\n965\t// ======================================================================\n966\t\n967\t#[test]\n968\tfn generic_crypto_auth_equals_hmacsha512256() {\n969\t    let mut rng = Rng::new(0x4_0001);\n970\t    let (cg, rg) = both::<Auth>(\"crypto_auth\");\n971\t    let (cgv, rgv) = both::<Verify>(\"crypto_auth_verify\");\n972\t\n973\t    for &len in LENS.iter() {\n974\t        for _ in 0..5 {\n975\t            let key = rng.bytes(32);\n976\t            let msg = rng.bytes(len);\n977\t            let mut co = padded(32);\n978\t            let mut ro = padded(32);\n979\t            let (rc, rr) = unsafe {\n980\t                (\n981\t                    cg(co.as_mut_ptr(), msg.as_ptr(), len as u64, key.as_ptr()),\n982\t                    rg(ro.as_mut_ptr(), msg.as_ptr(), len as u64, key.as_ptr()),\n983\t                )\n984\t            };\n985\t            eqi(\"crypto_auth rc\", rc, rr);\n986\t            assert_eq!(rc, 0);\n987\t            eqb(\"crypto_auth tag\", &co[..32], &ro[..32]);\n988\t            check_pad(\"crypto_auth C out\", &co, 32);\n989\t            check_pad(\"crypto_auth R out\", &ro, 32);\n990\t\n991\t            // 4.1 / 4.141 — identical to the delegate\n992\t            let del = oneshot(&SHA512256, &msg, &key, \"crypto_auth delegate\");\n993\t            eqb(\"crypto_auth == hmacsha512256\", &co[..32], &del);\n994\t\n995\t            // 4.2 — good tag verifies, one flipped bit rejects, and the result\n996\t            // always equals crypto_auth_hmacsha512256_verify.\n997\t            let (gc, gr) = unsafe {\n998\t                (\n999\t                    cgv(co.as_ptr(), msg.as_ptr(), len as u64, key.as_ptr()),\n1000\t                    rgv(co.as_ptr(), msg.as_ptr(), len as u64, key.as_ptr()),\n1001\t                )\n1002\t            };\n1003\t            eqi(\"crypto_auth_verify good rc\", gc, gr);\n1004\t            assert_eq!(gc, 0);\n1005\t            assert_eq!(gc, verify(&SHA512256, &del, &msg, &key, \"delegate verify good\"));\n1006\t\n1007\t            for i in 0..32usize {\n1008\t                for bit in [0u32, 3, 7] {\n1009\t                    let mut bad = del.clone();\n1010\t                    bad[i] ^= 1u8 << bit;\n1011\t                    let (bc, br) = unsafe {\n1012\t                        (\n1013\t                            cgv(bad.as_ptr(), msg.as_ptr(), len as u64, key.as_ptr()),\n1014\t                            rgv(bad.as_ptr(), msg.as_ptr(), len as u64, key.as_ptr()),\n1015\t                        )\n1016\t                    };\n1017\t                    eqi(\"crypto_auth_verify bad rc\", bc, br);\n1018\t                    assert_eq!(bc, -1);\n1019\t                    assert_eq!(\n1020\t                        bc,\n1021\t                        verify(&SHA512256, &bad, &msg, &key, \"delegate verify bad\"),\n1022\t                        \"crypto_auth_verify must agree with the delegate\"\n1023\t                    );\n1024\t                }\n1025\t            }\n1026\t        }\n1027\t    }\n1028\t}\n1029\t\n1030\t// 4.3\n1031\t#[test]\n1032\tfn generic_crypto_auth_keygen() {\n1033\t    let (c, r) = both::<Keygen>(\"crypto_auth_keygen\");\n1034\t    let mut prev: Option<Vec<u8>> = None;\n1035\t    for i in 0..8 {\n1036\t        rng_reseed(0xC000 + i as u64);\n1037\t        let mut ck = padded(32);\n1038\t        let mut rk = padded(32);\n1039\t        unsafe {\n1040\t            c(ck.as_mut_ptr());\n1041\t            r(rk.as_mut_ptr());\n1042\t        }\n1043\t        eqb(\"crypto_auth_keygen\", &ck[..32], &rk[..32]);\n1044\t        check_pad(\"crypto_auth_keygen C\", &ck, 32);\n1045\t        check_pad(\"crypto_auth_keygen R\", &rk, 32);\n1046\t        if let Some(p) = &prev {\n1047\t            assert_ne!(p, &ck[..32].to_vec(), \"successive keygen outputs must differ\");\n1048\t        }\n1049\t        prev = Some(ck[..32].to_vec());\n1050\t    }\n1051\t}\n1052\t\n1053\t// ======================================================================\n1054\t// errors_4 4.13, 4.14, 4.15 — sodium_misuse() on key == NULL with keylen > 0\n1055\t// ======================================================================\n1056\t\n1057\t#[test]\n1058\tfn init_null_key_nonzero_keylen_misuses() {\n1059\t    let sb256 = statebytes(&SHA256);\n1060\t    let sb512 = statebytes(&SHA512);\n1061\t    let (ci256, ri256) = both::<Init>(\"crypto_auth_hmacsha256_init\");\n1062\t    let (ci512, ri512) = both::<Init>(\"crypto_auth_hmacsha512_init\");\n1063\t    let (ci2565, ri2565) = both::<Init>(\"crypto_auth_hmacsha512256_init\");\n1064\t    let c256: Init = *ci256;\n1065\t    let r256: Init = *ri256;\n1066\t    let c512: Init = *ci512;\n1067\t    let r512: Init = *ri512;\n1068\t    let c5122: Init = *ci2565;\n1069\t    let r5122: Init = *ri2565;\n1070\t\n1071\t    // 4.13 — hmacsha256: 0 < keylen <= 64\n1072\t    for kl in [1usize, 2, 32, 63, 64] {\n1073\t        eq_abort(\n1074\t            &format!(\"hmacsha256_init(NULL, {kl})\"),\n1075\t            || {\n1076\t                let mut s = vec![0u8; sb256];\n1077\t                unsafe { c256(s.as_mut_ptr(), std::ptr::null(), kl) };\n1078\t            },\n1079\t            || {\n1080\t                let mut s = vec![0u8; sb256];\n1081\t                unsafe { r256(s.as_mut_ptr(), std::ptr::null(), kl) };\n1082\t            },\n1083\t        );\n1084\t    }\n1085\t    // 4.14 — hmacsha512: 0 < keylen <= 128\n1086\t    for kl in [1usize, 2, 64, 127, 128] {\n1087\t        eq_abort(\n1088\t            &format!(\"hmacsha512_init(NULL, {kl})\"),\n1089\t            || {\n1090\t                let mut s = vec![0u8; sb512];\n1091\t                unsafe { c512(s.as_mut_ptr(), std::ptr::null(), kl) };\n1092\t            },\n1093\t            || {\n1094\t                let mut s = vec![0u8; sb512];\n1095\t                unsafe { r512(s.as_mut_ptr(), std::ptr::null(), kl) };\n1096\t            },\n1097\t        );\n1098\t    }\n1099\t    // 4.15 — hmacsha512256: pure delegate, same condition\n1100\t    for kl in [1usize, 128] {\n1101\t        eq_abort(\n1102\t            &format!(\"hmacsha512256_init(NULL, {kl})\"),\n1103\t            || {\n1104\t                let mut s = vec![0u8; sb512];\n1105\t                unsafe { c5122(s.as_mut_ptr(), std::ptr::null(), kl) };\n1106\t            },\n1107\t            || {\n1108\t                let mut s = vec![0u8; sb512];\n1109\t                unsafe { r5122(s.as_mut_ptr(), std::ptr::null(), kl) };\n1110\t            },\n1111\t        );\n1112\t    }\n1113\t}\n1114\t\n1115\t// ======================================================================\n1116\t// broad randomized fuzz across all three primitives\n1117\t// ======================================================================\n1118\t\n1119\t#[test]\n1120\tfn hmac_randomized_fuzz() {\n1121\t    let mut rng = Rng::new(0x4_beef);\n1122\t    for prim in [&SHA256, &SHA512, &SHA512256] {\n1123\t        for iter in 0..250 {\n1124\t            let len = if iter % 7 == 0 { rng.range(0, 1200) } else { rng.range(0, 300) };\n1125\t            let kl = match iter % 5 {\n1126\t                0 => 32,\n1127\t                1 => rng.range(0, prim.block),\n1128\t                2 => prim.block,\n1129\t                3 => rng.range(prim.block + 1, prim.block * 3),\n1130\t                _ => rng.range(0, 40),\n1131\t            };\n1132\t            let key = rng.bytes(kl);\n1133\t            let msg = rng.bytes(len);\n1134\t            let n = rng.range(1, 6);\n1135\t            let cuts = random_cuts(&mut rng, len, n);\n1136\t            let label = format!(\"{} fuzz iter={iter} len={len} kl={kl}\", prim.prefix);\n1137\t            let a = stream(prim, Some(&key), kl, &chunks_of(&msg, &cuts), &label);\n1138\t            let b = stream(prim, Some(&key), kl, &[&msg[..]], &format!(\"{label} single\"));\n1139\t            eqb(&format!(\"{label}: split == single\"), &a, &b);\n1140\t            if kl == 32 {\n1141\t                let os = oneshot(prim, &msg, &key, &label);\n1142\t                eqb(&format!(\"{label}: stream == one-shot\"), &a, &os);\n1143\t                assert_eq!(verify(prim, &os, &msg, &key, &label), 0);\n1144\t                let mut bad = os.clone();\n1145\t                let bi = rng.below(prim.tag);\n1146\t                bad[bi] ^= 1u8 << rng.below(8);\n1147\t                assert_eq!(verify(prim, &bad, &msg, &key, &label), -1);\n1148\t            }\n1149\t        }\n1150\t    }\n1151\t}\n1152\t"}]},"parent_tool_use_id":"toolu_bdrk_01A8Z33Vq9d29RKVTuGuAUQG","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"611954b2-4ae3-481f-a96e-1c133b2b54ce","timestamp":"2026-08-31T03:55:41.079Z","subagent_type":"general-purpose","task_description":"Resume area 4: onetimeauth"}
