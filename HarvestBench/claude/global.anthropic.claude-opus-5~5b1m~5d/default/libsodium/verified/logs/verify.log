{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Vt59AMgn8xP3VEHQ8x8mUA","type":"tool_result","content":"1\t//! Translation of:\n2\t//!   - `crypto_stream/chacha20/stream_chacha20.c` + `crypto_stream/chacha20/ref/chacha20_ref.c`\n3\t//!   - `crypto_stream/xchacha20/stream_xchacha20.c`\n4\t//!   - `include/sodium/private/chacha20_ietf_ext.h`\n5\t//!\n6\t//! The reference build has no SIMD implementations, so `pick_best_implementation`\n7\t//! always selects the `ref` implementation.\n8\t\n9\tuse crate::common::{load32_le, rotl32, store32_le, SODIUM_SIZE_MAX};\n10\tuse crate::csys::memset;\n11\tuse core::ffi::c_int;\n12\t\n13\textern \"C\" {\n14\t    fn crypto_core_hchacha20(out: *mut u8, in_: *const u8, k: *const u8, c: *const u8) -> c_int;\n15\t    fn sodium_memzero(pnt: *mut u8, len: usize);\n16\t    fn randombytes_buf(buf: *mut u8, size: usize);\n17\t    fn sodium_misuse() -> !;\n18\t}\n19\t\n20\t/// `crypto_stream_chacha20_ietf_MESSAGEBYTES_MAX` = min(SODIUM_SIZE_MAX, 64 * 2^32)\n21\tconst IETF_MESSAGEBYTES_MAX: u64 = {\n22\t    let a = SODIUM_SIZE_MAX;\n23\t    let b: u64 = 64u64 * (1u64 << 32);\n24\t    if a < b {\n25\t        a\n26\t    } else {\n27\t        b\n28\t    }\n29\t};\n30\t\n31\t// =====================================================================\n32\t// crypto_stream/chacha20/stream_chacha20.h\n33\t// =====================================================================\n34\t\n35\t#[repr(C)]\n36\tpub struct crypto_stream_chacha20_implementation {\n37\t    pub stream: unsafe extern \"C\" fn(*mut u8, u64, *const u8, *const u8) -> c_int,\n38\t    pub stream_ietf_ext: unsafe extern \"C\" fn(*mut u8, u64, *const u8, *const u8) -> c_int,\n39\t    pub stream_xor_ic:\n40\t        unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u64, *const u8) -> c_int,\n41\t    pub stream_ietf_ext_xor_ic:\n42\t        unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u32, *const u8) -> c_int,\n43\t}\n44\t\n45\t// =====================================================================\n46\t// crypto_stream/chacha20/ref/chacha20_ref.c\n47\t// =====================================================================\n48\t\n49\tmacro_rules! quarterround {\n50\t    ($a:expr, $b:expr, $c:expr, $d:expr) => {\n51\t        $a = $a.wrapping_add($b);\n52\t        $d = rotl32($d ^ $a, 16);\n53\t        $c = $c.wrapping_add($d);\n54\t        $b = rotl32($b ^ $c, 12);\n55\t        $a = $a.wrapping_add($b);\n56\t        $d = rotl32($d ^ $a, 8);\n57\t        $c = $c.wrapping_add($d);\n58\t        $b = rotl32($b ^ $c, 7);\n59\t    };\n60\t}\n61\t\n62\t#[repr(C)]\n63\tstruct ChachaCtx {\n64\t    input: [u32; 16],\n65\t}\n66\t\n67\tunsafe fn chacha_keysetup(ctx: &mut ChachaCtx, k: *const u8) {\n68\t    ctx.input[0] = 0x6170_7865;\n69\t    ctx.input[1] = 0x3320_646e;\n70\t    ctx.input[2] = 0x7962_2d32;\n71\t    ctx.input[3] = 0x6b20_6574;\n72\t    ctx.input[4] = load32_le(k.add(0));\n73\t    ctx.input[5] = load32_le(k.add(4));\n74\t    ctx.input[6] = load32_le(k.add(8));\n75\t    ctx.input[7] = load32_le(k.add(12));\n76\t    ctx.input[8] = load32_le(k.add(16));\n77\t    ctx.input[9] = load32_le(k.add(20));\n78\t    ctx.input[10] = load32_le(k.add(24));\n79\t    ctx.input[11] = load32_le(k.add(28));\n80\t}\n81\t\n82\tunsafe fn chacha_ivsetup(ctx: &mut ChachaCtx, iv: *const u8, counter: *const u8) {\n83\t    ctx.input[12] = if counter.is_null() {\n84\t        0\n85\t    } else {\n86\t        load32_le(counter.add(0))\n87\t    };\n88\t    ctx.input[13] = if counter.is_null() {\n89\t        0\n90\t    } else {\n91\t        load32_le(counter.add(4))\n92\t    };\n93\t    ctx.input[14] = load32_le(iv.add(0));\n94\t    ctx.input[15] = load32_le(iv.add(4));\n95\t}\n96\t\n97\tunsafe fn chacha_ietf_ivsetup(ctx: &mut ChachaCtx, iv: *const u8, counter: *const u8) {\n98\t    ctx.input[12] = if counter.is_null() {\n99\t        0\n100\t    } else {\n101\t        load32_le(counter)\n102\t    };\n103\t    ctx.input[13] = 