se if ((base = malloc(memory_size + 63)) != NULL) {\n119\t        uint8_t *aligned = ((uint8_t *) base) + 63;\n120\t        aligned -= (uintptr_t) aligned & 63;\n121\t        memory = (block *) aligned;\n122\t    }\n123\t#endif\n124\t    if (base == NULL) {\n125\t        /* LCOV_EXCL_START */\n126\t        free(*region);\n127\t        *region = NULL;\n128\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n129\t        /* LCOV_EXCL_STOP */\n130\t    }\n131\t    (*region)->base   = base;\n132\t    (*region)->memory = memory;\n133\t    (*region)->size   = memory_size;\n134\t\n135\t    return ARGON2_OK;\n136\t}\n137\t\n138\t/*********Memory functions*/\n139\t\n140\t/* Deallocates memory\n141\t * @param memory pointer to the blocks\n142\t */\n143\tstatic void free_memory(block_region *region);\n144\t\n145\tstatic void\n146\tfree_memory(block_region *region)\n147\t{\n148\t    if (region != NULL && region->base != NULL) {\n149\t#if defined(MAP_ANON) && defined(HAVE_MMAP)\n150\t        if (munmap(region->base, region->size)) {\n151\t            return; /* LCOV_EXCL_LINE */\n152\t        }\n153\t#else\n154\t        free(region->base);\n155\t#endif\n156\t    }\n157\t    free(region);\n158\t}\n159\t\n160\tstatic void\n161\targon2_free_instance(argon2_instance_t *instance, int flags)\n162\t{\n163\t    /* Deallocate the memory */\n164\t    free(instance->pseudo_rands);\n165\t    instance->pseudo_rands = NULL;\n166\t    free_memory(instance->region);\n167\t    instance->region = NULL;\n168\t}\n169\t\n170\tvoid\n171\targon2_finalize(const argon2_context *context, argon2_instance_t *instance)\n172\t{\n173\t    if (context != NULL && instance != NULL) {\n174\t        block    blockhash;\n175\t        uint32_t l;\n176\t\n177\t        copy_block(&blockhash,\n178\t                   instance->region->memory + instance->lane_length - 1);\n179\t\n180\t        /* XOR the last blocks */\n181\t        for (l = 1; l < instance->lanes; ++l) {\n182\t            uint32_t last_block_in_lane =\n183\t                l * instance->lane_length + (instance->lane_length - 1);\n184\t            xor_block(&blockhash,\n185\t                      instance->region->memory + last_block_in_lane);\n186\t        }\n187\t\n188\t        /* Hash the result */\n189\t        {\n190\t            uint8_t blockhash_bytes[ARGON2_BLOCK_SIZE];\n191\t            store_block(blockhash_bytes, &blockhash);\n192\t            blake2b_long(context->out, context->outlen, blockhash_bytes,\n193\t                         ARGON2_BLOCK_SIZE);\n194\t            sodium_memzero(blockhash.v,\n195\t                           ARGON2_BLOCK_SIZE); /* clear blockhash */\n196\t            sodium_memzero(blockhash_bytes,\n197\t                           ARGON2_BLOCK_SIZE); /* clear blockhash_bytes */\n198\t        }\n199\t\n200\t        argon2_free_instance(instance, context->flags);\n201\t    }\n202\t}\n203\t\n204\tvoid\n205\targon2_fill_memory_blocks(argon2_instance_t *instance, uint32_t pass)\n206\t{\n207\t    argon2_position_t position;\n208\t    uint32_t l;\n209\t    uint32_t s;\n210\t\n211\t    if (instance == NULL || instance->lanes == 0) {\n212\t        return; /* LCOV_EXCL_LINE */\n213\t    }\n214\t\n215\t    position.pass = pass;\n216\t    for (s = 0; s < ARGON2_SYNC_POINTS; ++s) {\n217\t        position.slice = (uint8_t) s;\n218\t        for (l = 0; l < instance->lanes; ++l) {\n219\t            position.lane  = l;\n220\t            position.index = 0;\n221\t            fill_segment(instance, position);\n222\t        }\n223\t    }\n224\t}\n225\t\n226\tint\n227\targon2_validate_inputs(const argon2_context *context)\n228\t{\n229\t    /* LCOV_EXCL_START */\n230\t    if (NULL == context) {\n231\t        return ARGON2_INCORRECT_PARAMETER;\n232\t    }\n233\t\n234\t    if (NULL == context->out) {\n235\t        return ARGON2_OUTPUT_PTR_NULL;\n236\t    }\n237\t\n238\t    /* Validate output length */\n239\t    if (ARGON2_MIN_OUTLEN > context->outlen) {\n240\t        return ARGON2_OUTPUT_TOO_SHORT;\n241\t    }\n242\t\n243\t    if (ARGON2_MAX_OUTLEN < context->outlen) {\n244\t        return ARGON2_OUTPUT_TOO_LONG;\n245\t    }\n246\t\n247\t    /* Validate password (required param) */\n248\t    if (NULL == context->pwd) {\n249\t        if (0 != context->pwdlen) {\n250\t            return ARGON2_PWD_PTR_MISMATCH;\n251\t        }\n252\t    }\n253\t\n254\t    if (ARGON2_MIN_PWD_LENGTH > context->pwdlen) {\n255\t        return ARGON2_PWD_TOO_SHORT;\n256\t    }\n257\t\n258\t    if (ARGON2_MAX_PWD_LENGTH < context->pwdlen) {\n259\t        return ARGON2_PWD_TOO_LONG;\n260\t    }\n261\t\n262\t    /* Validate salt (required param) */\n263\t    if (NULL == context->salt) {\n264\t        if (0 != context->saltlen) {\n265\t            return ARGON2_SALT_PTR_MISMATCH;\n266\t        }\n267\t    }\n268\t\n269\t    if (ARGON2_MIN_SALT_LENGTH > context->saltlen) {\n270\t        return ARGON2_SALT_TOO_SHORT;\n271\t    }\n272\t\n273\t    if (ARGON2_MAX_SALT_LENGTH < context->saltlen) {\n274\t        return ARGON2_SALT_TOO_LONG;\n275\t    }\n276\t\n277\t    /* Validate secret (optional param) */\n278\t    if (NULL == context->secret) {\n279\t        if (0 != context->secretlen) {\n280\t            return ARGON2_SECRET_PTR_MISMATCH;\n281\t        }\n282\t    } else {\n283\t        if (ARGON2_MIN_SECRET > context->secretlen) {\n284\t            return ARGON2_SECRET_TOO_SHORT;\n285\t        }\n286\t\n287\t        if (ARGON2_MAX_SECRET < context->secretlen) {\n288\t            return ARGON2_SECRET_TOO_LONG;\n289\t        }\n290\t    }\n291\t\n292\t    /* Validate associated data (optional param) */\n293\t    if (NULL == context->ad) {\n294\t        if (0 != context->adlen) {\n295\t            return ARGON2_AD_PTR_MISMATCH;\n296\t        }\n297\t    } else {\n298\t        if (ARGON2_MIN_AD_LENGTH > context->adlen) {\n299\t            return ARGON2_AD_TOO_SHORT;\n300\t        }\n301\t\n302\t        if (ARGON2_MAX_AD_LENGTH < context->adlen) {\n303\t            return ARGON2_AD_TOO_LONG;\n304\t        }\n305\t    }\n306\t\n307\t    /* Validate lanes */\n308\t    if (ARGON2_MIN_LANES > context->lanes) {\n309\t        return ARGON2_LANES_TOO_FEW;\n310\t    }\n311\t\n312\t    if (ARGON2_MAX_LANES < context->lanes) {\n313\t        return ARGON2_LANES_TOO_MANY;\n314\t    }\n315\t\n316\t    /* Validate memory cost */\n317\t    if (ARGON2_MIN_MEMORY > context->m_cost) {\n318\t        return ARGON2_MEMORY_TOO_LITTLE;\n319\t    }\n320\t\n321\t    if (ARGON2_MAX_MEMORY < context->m_cost) {\n322\t        return ARGON2_MEMORY_TOO_MUCH;\n323\t    }\n324\t\n325\t    if (context->m_cost < 8 * context->lanes) {\n326\t        return ARGON2_MEMORY_TOO_LITTLE;\n327\t    }\n328\t\n329\t    /* Validate time cost */\n330\t    if (ARGON2_MIN_TIME > context->t_cost) {\n331\t        return ARGON2_TIME_TOO_SMALL;\n332\t    }\n333\t\n334\t    if (ARGON2_MAX_TIME < context->t_cost) {\n335\t        return ARGON2_TIME_TOO_LARGE;\n336\t    }\n337\t\n338\t    /* Validate threads */\n339\t    if (ARGON2_MIN_THREADS > context->threads) {\n340\t        return ARGON2_THREADS_TOO_FEW;\n341\t    }\n342\t\n343\t    if (ARGON2_MAX_THREADS < context->threads) {\n344\t        return ARGON2_THREADS_TOO_MANY;\n345\t    }\n346\t    /* LCOV_EXCL_STOP */\n347\t\n348\t    return ARGON2_OK;\n349\t}\n350\t\n351\tstatic void\n352\targon2_fill_first_blocks(uint8_t *blockhash, const argon2_instance_t *instance)\n353\t{\n354\t    uint32_t l;\n355\t    /* Make the first and second block in each lane as G(H0||i||0) or\n356\t       G(H0||i||1) */\n357\t    uint8_t blockhash_bytes[ARGON2_BLOCK_SIZE];\n358\t    for (l = 0; l < instance->lanes; ++l) {\n359\t        STORE32_LE(blockhash + ARGON2_PREHASH_DIGEST_LENGTH, 0);\n360\t        STORE32_LE(blockhash + ARGON2_PREHASH_DIGEST_LENGTH + 4, l);\n361\t        blake2b_long(blockhash_bytes, ARGON2_BLOCK_SIZE, blockhash,\n362\t                     ARGON2_PREHASH_SEED_LENGTH);\n363\t        load_block(&instance->region->memory[l * instance->lane_length + 0],\n364\t                   blockhash_bytes);\n365\t\n366\t        STORE32_LE(blockhash + ARGON2_PREHASH_DIGEST_LENGTH, 1);\n367\t        blake2b_long(blockhash_bytes, ARGON2_BLOCK_SIZE, blockhash,\n368\t                     ARGON2_PREHASH_SEED_LENGTH);\n369\t        load_block(&instance->region->memory[l * instance->lane_length + 1],\n370\t                   blockhash_bytes);\n371\t    }\n372\t    sodium_memzero(blockhash_bytes, ARGON2_BLOCK_SIZE);\n373\t}\n374\t\n375\tstatic void\n376\targon2_initial_hash(uint8_t *blockhash, argon2_context *context,\n377\t                    argon2_type type)\n378\t{\n379\t    crypto_generichash_blake2b_state BlakeHash;\n380\t    uint8_t                          value[4U /* sizeof(uint32_t) */];\n381\t\n382\t    if (NULL == context || NULL == blockhash) {\n383\t        return; /* LCOV_EXCL_LINE */\n384\t    }\n385\t\n386\t    crypto_generichash_blake2b_init(&BlakeHash, NULL, 0U,\n387\t                                    ARGON2_PREHASH_DIGEST_LENGTH);\n388\t\n389\t    STORE32_LE(value, context->lanes);\n390\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n391\t\n392\t    STORE32_LE(value, context->outlen);\n393\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n394\t\n395\t    STORE32_LE(value, context->m_cost);\n396\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n397\t\n398\t    STORE32_LE(value, context->t_cost);\n399\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n400\t\n401\t    STORE32_LE(value, ARGON2_VERSION_NUMBER);\n402\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n403\t\n404\t    STORE32_LE(value, (uint32_t) type);\n405\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n406\t\n407\t    STORE32_LE(value, context->pwdlen);\n408\t    crypto_generichash_blake2b_update(&BlakeHash, value, sizeof(value));\n409\t\n410\t    if (context->pwd != NULL) {\n411\t        crypto_generichash_blake2b_u