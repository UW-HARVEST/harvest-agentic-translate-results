{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011SLBiuKF94UoEFPMU2ir6a","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the reference C `libsodium.so` and the translated Rust\n4\t//! `liblibsodium.so` with `libloading` and exposes them as two opaque\n5\t//! libraries.  Every call in every test goes through `dlsym`, so the Rust\n6\t//! `#[no_mangle]` export wrappers are exercised exactly as an external C\n7\t//! consumer would exercise them.\n8\t#![allow(dead_code)]\n9\t\n10\tuse libloading::{Library, Symbol};\n11\tuse std::ffi::{c_char, c_int, c_void};\n12\tuse std::path::PathBuf;\n13\tuse std::sync::OnceLock;\n14\t\n15\t// ---------------------------------------------------------------- library load\n16\t\n17\tfn crate_dir() -> PathBuf {\n18\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n19\t}\n20\t\n21\tfn c_so_path() -> PathBuf {\n22\t    if let Ok(p) = std::env::var(\"SODIUM_C_SO\") {\n23\t        return PathBuf::from(p);\n24\t    }\n25\t    crate_dir()\n26\t        .parent()\n27\t        .unwrap()\n28\t        .join(\"c_src/build/libsodium.so\")\n29\t}\n30\t\n31\tfn rust_so_path() -> PathBuf {\n32\t    if let Ok(p) = std::env::var(\"SODIUM_RUST_SO\") {\n33\t        return PathBuf::from(p);\n34\t    }\n35\t    // The integration-test binary lives in target/<profile>/deps/, so the\n36\t    // cdylib built for the same profile is one directory up.\n37\t    if let Ok(exe) = std::env::current_exe() {\n38\t        if let Some(deps) = exe.parent() {\n39\t            if let Some(profile) = deps.parent() {\n40\t                let cand = profile.join(\"liblibsodium.so\");\n41\t                if cand.exists() {\n42\t                    return cand;\n43\t                }\n44\t            }\n45\t        }\n46\t    }\n47\t    for p in [\"target/release/liblibsodium.so\", \"target/debug/liblibsodium.so\"] {\n48\t        let cand = crate_dir().join(p);\n49\t        if cand.exists() {\n50\t            return cand;\n51\t        }\n52\t    }\n53\t    panic!(\"cannot locate the Rust liblibsodium.so; run `cargo build` first\");\n54\t}\n55\t\n56\tstruct Libs {\n57\t    c: Library,\n58\t    r: Library,\n59\t}\n60\t\n61\t// The libraries are loaded once and never unloaded; every symbol handed out\n62\t// therefore has a `'static` lifetime.\n63\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n64\t\n65\tfn libs() -> &'static Libs {\n66\t    LIBS.get_or_init(|| {\n67\t        let c = unsafe { Library::new(c_so_path()) }\n68\t            .unwrap_or_else(|e| panic!(\"loading {:?}: {e}\", c_so_path()));\n69\t        let r = unsafe { Library::new(rust_so_path()) }\n70\t            .unwrap_or_else(|e| panic!(\"loading {:?}: {e}\", rust_so_path()));\n71\t        let l = Libs { c, r };\n72\t        unsafe { install_deterministic_rng(&l) };\n73\t        // sodium_init() after the RNG is installed, exactly like a real\n74\t        // consumer that swaps the RNG at startup.\n75\t        unsafe {\n76\t            let ci: Symbol<unsafe extern \"C\" fn() -> c_int> = l.c.get(b\"sodium_init\\0\").unwrap();\n77\t            let ri: Symbol<unsafe extern \"C\" fn() -> c_int> = l.r.get(b\"sodium_init\\0\").unwrap();\n78\t            assert_eq!(ci(), 0, \"C sodium_init failed\");\n79\t            assert_eq!(ri(), 0, \"Rust sodium_init failed\");\n80\t        }\n81\t        l\n82\t    })\n83\t}\n84\t\n85\tpub fn c_lib() -> &'static Library {\n86\t    &libs().c\n87\t}\n88\tpub fn rust_lib() -> &'static Library {\n89\t    &libs().r\n90\t}\n91\t\n92\t/// Look a symbol up in both libraries and return the (C, Rust) pair.\n93\t///\n94\t/// Panics with a clear message when the Rust `.so` does not export the symbol,\n95\t/// which is itself a translation-completeness failure.\n96\tpub fn both<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n97\t    let l = libs();\n98\t    let mut b: Vec<u8> = name.as_bytes().to_vec();\n99\t    b.push(0);\n100\t    unsafe {\n101\t        let c: Symbol<'static, T> = l\n102\t            .c\n103\t            .get(&b)\n104\t            .unwrap_or_else(|e| panic!(\"C .so is missing `{name}`: {e}\"));\n105\t        let r: Symbol<'static, T> = l\n106\t            .r\n107\t            .get(&b)\n108\t            .unwrap_or_else(|e| panic!(\"Rust .so is missing `{name}`: {e}\"));\n109\t        (c, r)\n110\t    }\n111\t}\n112\t\n113\t/// `true` when both libraries export `name`.\n114\tpub fn has(name: &str) -> bool {\n115\t    let l = libs();\n116\t    let mut b: Vec<u8> = name.as_bytes().to_vec();\n117\t    b.push(0);\n118\t    unsafe {\n119\t        l.c.get::<*const c_void>(&b).is_ok() && l.r.get::<*const c_void>(&b).is_ok()\n120\t    }\n121\t}\n122\t\n123\t// ------------------------------------------------------- deterministic RNG\n124\t\n125\t#[repr(C)]\n126\tpub struct RandombytesImplementation {\n127\t    pub implementation_name: Option<unsafe extern \"C\" fn() -> *const c_char>,\n128\t    pub random: Option<unsafe extern \"C\" fn() -> u32>,\n129\t    pub stir: Option<unsafe extern \"C\" fn()>,\n130\t    pub uniform: Option<unsafe extern \"C\" fn(u32) -> u32>,\n131\t    pub buf: Option<unsafe extern \"C\" fn(*mut c_void, usize)>,\n132\t    pub close: Option<unsafe extern \"C\" fn() -> c_int>,\n133\t}\n134\t\n135\tconst RNG_SEED: u64 = 0x2545_F491_4F6C_DD1D;\n136\t\n137\t// One independent stream per loaded library, so that the n-th random byte\n138\t// consumed by C equals the n-th random byte consumed by Rust.\n139\tstatic RNG_STATE: [std::sync::atomic::AtomicU64; 2] = [\n140\t    std::sync::atomic::AtomicU64::new(RNG_SEED),\n141\t    std::sync::atomic::AtomicU64::new(RNG_SEED),\n142\t];\n143\t\n144\tfn rng_next(i: usize) -> u64 {\n145\t    use std::sync::atomic::Ordering::Relaxed;\n146\t    let mut x = RNG_STATE[i].load(Relaxed);\n147\t    x ^= x << 13;\n148\t    x ^= x >> 7;\n149\t    x ^= x << 17;\n150\t    RNG_STATE[i].store(x, Relaxed);\n151\t    x\n152\t}\n153\t\n154\t/// Rewind both RNG streams so that the next C call and the next Rust call see\n155\t/// identical randomness.  Call this before any pair of operations that consume\n156\t/// randomness (`*_keypair`, `*_seal`, `randombytes_*`, ...).\n157\tpub fn rng_reset() {\n158\t    use std::sync::atomic::Ordering::Relaxed;\n159\t    RNG_STATE[0].store(RNG_SEED, Relaxed);\n160\t    RNG_STATE[1].store(RNG_SEED, Relaxed);\n161\t}\n162\t\n163\t/// Rewind both RNG streams to an arbitrary (non-zero) seed.\n164\tpub fn rng_reseed(seed: u64) {\n165\t    use std::sync::atomic::Ordering::Relaxed;\n166\t    let s = if seed == 0 { RNG_SEED } else { seed };\n167\t    RNG_STATE[0].store(s, Relaxed);\n168\t    RNG_STATE[1].store(s, Relaxed);\n169\t}\n170\t\n171\tmacro_rules! rng_impl {\n172\t    ($idx:expr, $name:ident, $rand:ident, $buf:ident, $stir:ident, $close:ident) => {\n173\t        unsafe extern \"C\" fn $name() -> *const c_char {\n174\t            b\"difftest\\0\".as_ptr() as *const c_char\n175\t        }\n176\t        unsafe extern \"C\" fn $rand() -> u32 {\n177\t            rng_next($idx) as u32\n178\t        }\n179\t        unsafe extern \"C\" fn $buf(buf: *mut c_void, size: usize) {\n180\t            let mut p = buf as *mut u8;\n181\t            let mut n = size;\n182\t            while n >= 8 {\n183\t                let v = rng_next($idx).to_le_bytes();\n184\t                std::ptr::copy_nonoverlapping(v.as_ptr(), p, 8);\n185\t                p = p.add(8);\n186\t                n -= 8;\n187\t            }\n188\t            if n > 0 {\n189\t                let v = rng_next($idx).to_le_bytes();\n190\t                std::ptr::copy_nonoverlapping(v.as_ptr(), p, n);\n191\t            }\n192\t        }\n193\t        unsafe extern \"C\" fn $stir() {}\n194\t        unsafe extern \"C\" fn $close() -> c_int {\n195\t            0\n196\t        }\n197\t    };\n198\t}\n199\t\n200\trng_impl!(0, c_name, c_random, c_buf, c_stir, c_close);\n201\trng_impl!(1, r_name, r_random, r_buf, r_stir, r_close);\n202\t\n203\tunsafe fn install_deterministic_rng(l: &Libs) {\n204\t    // `uniform` is left NULL on purpose so that the library's own\n205\t    // randombytes_uniform() rejection-sampling loop is what gets tested.\n206\t    let c_impl: &'static RandombytesImplementation = Box::leak(Box::new(RandombytesImplementation {\n207\t        implementation_name: Some(c_name),\n208\t        random: Some(c_random),\n209\t        stir: Some(c_stir),\n210\t        uniform: None,\n211\t        buf: Some(c_buf),\n212\t        close: Some(c_close),\n213\t    }));\n214\t    let r_impl: &'static RandombytesImplementation = Box::leak(Box::new(RandombytesImplementation {\n215\t        implementation_name: Some(r_name),\n216\t        random: Some(r_random),\n217\t        stir: Some(r_stir),\n218\t        uniform: None,\n219\t        buf: Some(r_buf),\n220\t        close: Some(r_close),\n221\t    }));\n222\t    type SetImpl = unsafe extern \"C\" fn(*const RandombytesImplementation) -> c_int;\n223\t    let cs: Symbol<SetImpl> = l.c.get(b\"randombytes_set_implementation\\0\").unwrap();\n224\t    let rs: Symbol<SetImpl> = l.r.get(b\"randombytes_set_implementation\\0\").unwrap();\n225\t    assert_eq!(cs(c_impl as *const _), 0);\n226\t    assert_eq!(rs(r_impl as *const _), 0);\n227\t}\n228\t\n229\t// ----------------------------------------------------------- test-input PRNG\n230\t\n231\t/// Deterministic, reproducible generator for test inputs (splitmix64).\n232\tpub struct Rng(u64);\n233\t\n234\timpl Rng {\n235\t    pub fn new(seed: u64) -> Self {\n236\t        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)\n237\t    }\n238\t    pub fn next_u64(&mut self) -> u64 {\n239\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n240\t        let mut z = self.0;\n241\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n242\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n243\t        z ^ (z >> 31)\n244\t    }\n245\t    pub fn next_u32(&mut self) -> u32 {\n246\t        (self.next_u64() >> 32) as u32\n247\t    }\n248\t    pub fn byte(&mut self) -> u8 {\n249\t        (self.next_u64() >> 56) as u8\n250\t    }\n251\t    /// Uniform in `[0, n)`; returns 0 when `n == 0`.\n252\t    pub fn below(&mut self, n: usize) -> usize {\n253\t        if n == 0 {\n254\t            0\n255\t        } else {\n256\t            (self.next_u64() % n as u64) as usize\n257\t        }\n258\t    }\n259\t    /// Uniform in `[lo, hi]`.\n260\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n261\t        assert!(lo <= hi);\n262\t        lo + self.below(hi - lo + 1)\n263\t    }\n264\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n265\t        let mut v = vec![0u8; n];\n266\t        self.fill(&mut v);\n267\t        v\n268\t    }\n269\t    pub fn fill(&mut self, out: &mut [u8]) {\n270\t        let mut i = 0;\n271\t        while i < out.len() {\n272\t            let w = self.next_u64().to_le_bytes();\n273\t            let k = std::cmp::min(8, out.len() - i);\n274\t            out[i..i + k].copy_from_slice(&w[..k]);\n275\t            i += k;\n276\t        }\n277\t    }\n278\t}\n279\t\n280\t// ------------------------------------------------------------------- helpers\n281\t\n282\t/// Byte-for-byte comparison with a readable failure message.\n283\t#[track_caller]\n284\tpub fn eqb(what: &str, c: &[u8], r: &[u8]) {\n285\t    if c != r {\n286\t        let n = std::cmp::min(c.len(), r.len());\n287\t        let mut first = n;\n288\t        for i in 0..n {\n289\t            if c[i] != r[i] {\n290\t                first = i;\n291\t                break;\n292\t            }\n293\t        }\n294\t        panic!(\n295\t            \"{what}: byte mismatch (C len {}, Rust len {}, first diff at {first})\\n  C   : {}\\n  Rust: {}\",\n296\t            c.len(),\n297\t            r.len(),\n298\t            hex(c),\n299\t            hex(r)\n300\t        );\n301\t    }\n302\t}\n303\t\n304\t#[track_caller]\n305\tpub fn eqi(what: &str, c: c_int, r: c_int) {\n306\t    assert_eq!(c, r, \"{what}: return code mismatch (C {c}, Rust {r})\");\n307\t}\n308\t\n309\tpub fn hex(b: &[u8]) -> String {\n310\t    const MAX: usize = 160;\n311\t    let mut s = String::new();\n312\t    for (i, x) in b.iter().enumerate() {\n313\t        if i == MAX {\n314\t            s.push_str(\"...\");\n315\t            break;\n316\t        }\n317\t        s.push_str(&format!(\"{x:02x}\"));\n318\t    }\n319\t    s\n320\t}\n321\t\n322\t// ------------------------------------------------------------------- errno\n323\t\n324\textern \"C\" {\n325\t    fn __errno_location() -> *mut c_int;\n326\t    fn fork() -> c_int;\n327\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n328\t    fn _exit(code: c_int) -> !;\n329\t    fn setrlimit(resource: c_int, rlim: *const RLimit) -> c_int;\n330\t}\n331\t\n332\t#[repr(C)]\n333\tstruct RLimit {\n334\t    cur: u64,\n335\t    max: u64,\n336\t}\n337\tconst RLIMIT_CORE: c_int = 4;\n338\t\n339\tpub fn errno() -> c_int {\n340\t    unsafe { *__errno_location() }\n341\t}\n342\tpub fn set_errno(v: c_int) {\n343\t    unsafe { *__errno_location() = v }\n344\t}\n345\t\n346\tpub const EINVAL: c_int = 22;\n347\tpub const ERANGE: c_int = 34;\n348\tpub const ENOMEM: c_int = 12;\n349\tpub const EPERM: c_int = 1;\n350\t\n351\t/// Run `f` in a forked child and return the raw `waitpid` status.\n352\t///\n353\t/// Used for the `sodium_misuse()` / `abort()` paths, which cannot be observed\n354\t/// in-process.  The child `_exit(0)`s if `f` returns normally, so a normal exit\n355\t/// and a fatal signal are clearly distinguishable.\n356\tpub fn in_child<F: FnOnce()>(f: F) -> c_int {\n357\t    unsafe {\n358\t        let pid = fork();\n359\t        assert!(pid >= 0, \"fork failed\");\n360\t        if pid == 0 {\n361\t            // No core dumps: the abort() paths are expected, and dumping cores\n362\t            // makes the error-path tests hundreds of times slower.\n363\t            setrlimit(RLIMIT_CORE, &RLimit { cur: 0, max: 0 });\n364\t            f();\n365\t            _exit(0);\n366\t        }\n367\t        let mut st: c_int = 0;\n368\t        assert!(waitpid(pid, &mut st, 0) == pid);\n369\t        st\n370\t    }\n371\t}\n372\t\n373\t/// Human-readable classification of a `waitpid` status: `\"exit:N\"` or `\"sig:N\"`.\n374\tpub fn status_str(st: c_int) -> String {\n375\t    if st & 0x7f == 0 {\n376\t        format!(\"exit:{}\", (st >> 8) & 0xff)\n377\t    } else {\n378\t        format!(\"sig:{}\", st & 0x7f)\n379\t    }\n380\t}\n381\t\n382\t/// Differentially compare the *process outcome* of a pair of calls that may\n383\t/// abort (`sodium_misuse`).\n384\t#[track_caller]\n385\tpub fn eq_abort<FC: FnOnce(), FR: FnOnce()>(what: &str, c: FC, r: FR) {\n386\t    let sc = in_child(c);\n387\t    let sr = in_child(r);\n388\t    assert_eq!(\n389\t        status_str(sc),\n390\t        status_str(sr),\n391\t        \"{what}: process outcome mismatch\"\n392\t    );\n393\t}\n394\t\n395\t/// A guard byte pattern used to prove neither implementation writes out of\n396\t/// bounds; allocate `len + PAD` and check the tail afterwards.\n397\tpub const PAD: usize = 32;\n398\t\n399\tpub fn padded(len: usize) -> Vec<u8> {\n400\t    let mut v = vec![0u8; len + PAD];\n401\t    for (i, b) in v[len..].iter_mut().enumerate() {\n402\t        *b = 0xA5u8.wrapping_add(i as u8);\n403\t    }\n404\t    v\n405\t}\n406\t\n407\t#[track_caller]\n408\tpub fn check_pad(what: &str, v: &[u8], len: usize) {\n409\t    for (i, b) in v[len..].iter().enumerate() {\n410\t        assert_eq!(\n411\t            *b,\n412\t            0xA5u8.wrapping_add(i as u8),\n413\t            \"{what}: out-of-bounds write at +{i} past {len}\"\n414\t        );\n415\t    }\n416\t}\n417\t"}]},"parent_tool_use_id":"toolu_bdrk_01CMAzU9io9phBPgrmB7tXVQ","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"acdd4804-1fb1-45eb-9f02-063d390586b9","timestamp":"2026-08-31T03:48:27.453Z","subagent_type":"general-purpose","task_description":"Phase B/C tests area 3 retry"}
