{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013KEpG3Nopeb2FvLuxboK8U","type":"tool_result","content":"1\t//! Area 5 — `crypto_stream`, chacha20 family.\n2\t//!\n3\t//! Covers `configs_5.md` rows 5.47–5.83 (chacha20 \"original\", chacha20_ietf,\n4\t//! the private-but-exported `_ietf_ext*` entry points, and xchacha20) plus the\n5\t//! chacha-side error rows of `errors_5.md` (5.1–5.16, 5.20–5.22, 5.28, 5.29).\n6\t//!\n7\t//! Sources of truth:\n8\t//!   c_src/libsodium/crypto_stream/chacha20/stream_chacha20.c\n9\t//!   c_src/libsodium/crypto_stream/chacha20/ref/chacha20_ref.c\n10\t//!   c_src/libsodium/crypto_stream/xchacha20/stream_xchacha20.c\n11\t//!   c_src/libsodium/include/sodium/private/chacha20_ietf_ext.h\n12\t\n13\tmod common;\n14\tuse common::*;\n15\tuse std::ffi::{c_int, c_void};\n16\t\n17\t// ------------------------------------------------------------------ signatures\n18\t\n19\ttype Stream = unsafe extern \"C\" fn(*mut u8, u64, *const u8, *const u8) -> c_int;\n20\ttype Xor = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, *const u8) -> c_int;\n21\ttype XorIc64 = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u64, *const u8) -> c_int;\n22\ttype XorIc32 = unsafe extern \"C\" fn(*mut u8, *const u8, u64, *const u8, u32, *const u8) -> c_int;\n23\ttype SizeFn = unsafe extern \"C\" fn() -> usize;\n24\ttype Keygen = unsafe extern \"C\" fn(*mut u8);\n25\ttype Core = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8, *const u8) -> c_int;\n26\t\n27\t// ------------------------------------------------------------------- constants\n28\t\n29\t/// The length sweep **L** from `configs_5.md`.\n30\tconst L: [usize; 16] = [\n31\t    0, 1, 63, 64, 65, 127, 128, 129, 191, 192, 193, 255, 256, 257, 511, 512,\n32\t];\n33\tconst BIG: [usize; 5] = [1024, 1025, 4096, 8191, 8192];\n34\t\n35\tconst SODIUM_SIZE_MAX: u64 = u64::MAX;\n36\t/// `crypto_stream_chacha20_ietf_MESSAGEBYTES_MAX` = 64 * 2^32 = 2^38.\n37\tconst IETF_MAX: u64 = 274_877_906_944;\n38\t\n39\t/// RFC 7539 §2.4.2 key (00..1f) and 12-byte nonce.\n40\tconst RFC_KEY: [u8; 32] = [\n41\t    0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,\n42\t    0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f,\n43\t];\n44\tconst RFC_NONCE: [u8; 24] = [\n45\t    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x4a, 0x00, 0x00, 0x00, 0x00, 0x0e, 0x1d, 0x2c, 0x3b,\n46\t    0x4a, 0x59, 0x68, 0x77, 0x86, 0x95, 0xa4, 0xb3,\n47\t];\n48\t\n49\t/// `(key, nonce)` shapes: all-zero, all-0xff, ascending pattern, RFC vector,\n50\t/// then `extra` pseudorandom pairs.\n51\tfn shapes(nb: usize, rng: &mut Rng, extra: usize) -> Vec<(Vec<u8>, Vec<u8>)> {\n52\t    let mut v: Vec<(Vec<u8>, Vec<u8>)> = Vec::new();\n53\t    v.push((vec![0u8; 32], vec![0u8; nb]));\n54\t    v.push((vec![0xffu8; 32], vec![0xffu8; nb]));\n55\t    let mut k = vec![0u8; 32];\n56\t    for (i, b) in k.iter_mut().enumerate() {\n57\t        *b = i as u8 + 1;\n58\t    }\n59\t    let mut n = vec![0u8; nb];\n60\t    for (i, b) in n.iter_mut().enumerate() {\n61\t        *b = i as u8 + 1;\n62\t    }\n63\t    v.push((k, n));\n64\t    v.push((RFC_KEY.to_vec(), RFC_NONCE[..nb].to_vec()));\n65\t    for _ in 0..extra {\n66\t        v.push((rng.bytes(32), rng.bytes(nb)));\n67\t    }\n68\t    v\n69\t}\n70\t\n71\t// ---------------------------------------------------------------- generic driver\n72\t\n73\t/// Keystream form + `_xor` form: C/Rust equality, `_xor(zero) == keystream`,\n74\t/// `_xor` involution, in-place == out-of-place, no writes past `len`.\n75\tfn drive_keystream_and_xor(base: &str, nb: usize, seed: u64, lens: &[usize], extra: usize) {\n76\t    let (cs, rs) = both::<Stream>(base);\n77\t    let xor_name = format!(\"{base}_xor\");\n78\t    let (cx, rx) = both::<Xor>(&xor_name);\n79\t    let mut rng = Rng::new(seed);\n80\t\n81\t    for &len in lens {\n82\t        for (si, (k, n)) in shapes(nb, &mut rng, extra).into_iter().enumerate() {\n83\t            let tag = format!(\"{base}(len={len},shape={si})\");\n84\t\n85\t            let mut a = padded(len);\n86\t            let mut b = padded(len);\n87\t            let (rc, rr) = unsafe {\n88\t                (\n89\t                    cs(a.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n90\t                    rs(b.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n91\t                )\n92\t            };\n93\t            eqi(&tag, rc, rr);\n94\t            assert_eq!(rc, 0, \"{tag}: keystream form must return 0\");\n95\t            eqb(&tag, &a, &b);\n96\t            check_pad(&tag, &a, len);\n97\t            check_pad(&tag, &b, len);\n98\t            let ks = a[..len].to_vec();\n99\t\n100\t            let zero = vec![0u8; len];\n101\t            let mut a2 = padded(len);\n102\t            let mut b2 = padded(len);\n103\t            let (rc, rr) = unsafe {\n104\t                (\n105\t                    cx(a2.as_mut_ptr(), zero.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n106\t                    rx(b2.as_mut_ptr(), zero.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n107\t                )\n108\t            };\n109\t            eqi(&format!(\"{tag} xor(zero)\"), rc, rr);\n110\t            assert_eq!(rc, 0);\n111\t            eqb(&format!(\"{tag} xor(zero)\"), &a2, &b2);\n112\t            check_pad(&format!(\"{tag} xor(zero)\"), &a2, len);\n113\t            assert_eq!(&a2[..len], &ks[..], \"{tag}: xor(zero) != keystream form\");\n114\t\n115\t            let m = rng.bytes(len);\n116\t            let mut a3 = padded(len);\n117\t            let mut b3 = padded(len);\n118\t            let (rc, rr) = unsafe {\n119\t                (\n120\t                    cx(a3.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n121\t                    rx(b3.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n122\t                )\n123\t            };\n124\t            eqi(&format!(\"{tag} xor\"), rc, rr);\n125\t            eqb(&format!(\"{tag} xor\"), &a3, &b3);\n126\t            check_pad(&format!(\"{tag} xor\"), &a3, len);\n127\t            for i in 0..len {\n128\t                assert_eq!(a3[i], m[i] ^ ks[i], \"{tag}: xor != m ^ keystream at {i}\");\n129\t            }\n130\t\n131\t            let mut a4 = padded(len);\n132\t            let mut b4 = padded(len);\n133\t            unsafe {\n134\t                cx(a4.as_mut_ptr(), a3.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n135\t                rx(b4.as_mut_ptr(), b3.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n136\t            }\n137\t            eqb(&format!(\"{tag} xor^2\"), &a4, &b4);\n138\t            assert_eq!(&a4[..len], &m[..], \"{tag}: xor is not an involution\");\n139\t\n140\t            let mut ip_c = padded(len);\n141\t            ip_c[..len].copy_from_slice(&m);\n142\t            let mut ip_r = ip_c.clone();\n143\t            unsafe {\n144\t                let pc = ip_c.as_mut_ptr();\n145\t                let pr = ip_r.as_mut_ptr();\n146\t                cx(pc, pc, len as u64, n.as_ptr(), k.as_ptr());\n147\t                rx(pr, pr, len as u64, n.as_ptr(), k.as_ptr());\n148\t            }\n149\t            eqb(&format!(\"{tag} xor in-place\"), &ip_c, &ip_r);\n150\t            check_pad(&format!(\"{tag} xor in-place\"), &ip_c, len);\n151\t            assert_eq!(&ip_c[..len], &a3[..len], \"{tag}: in-place != out-of-place\");\n152\t        }\n153\t    }\n154\t}\n155\t\n156\t/// `{base}_xor_ic` with a 64-bit `ic` (chacha20 \"original\", xchacha20).\n157\tfn drive_xor_ic64(\n158\t    base: &str,\n159\t    nb: usize,\n160\t    seed: u64,\n161\t    lens: &[usize],\n162\t    ics: &[u64],\n163\t    tail_check: bool,\n164\t    extra: usize,\n165\t) {\n166\t    let ic_name = format!(\"{base}_xor_ic\");\n167\t    let (cxi, rxi) = both::<XorIc64>(&ic_name);\n168\t    let (cx, rx) = both::<Xor>(&format!(\"{base}_xor\"));\n169\t    let mut rng = Rng::new(seed);\n170\t\n171\t    for &ic in ics {\n172\t        for &len in lens {\n173\t            for (si, (k, n)) in shapes(nb, &mut rng, extra).into_iter().enumerate() {\n174\t                let tag = format!(\"{ic_name}(len={len},ic={ic:#x},shape={si})\");\n175\t                let m = rng.bytes(len);\n176\t\n177\t                let mut a = padded(len);\n178\t                let mut b = padded(len);\n179\t                let (rc, rr) = unsafe {\n180\t                    (\n181\t                        cxi(a.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr()),\n182\t                        rxi(b.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr()),\n183\t                    )\n184\t                };\n185\t                eqi(&tag, rc, rr);\n186\t                assert_eq!(rc, 0, \"{tag}: must return 0\");\n187\t                eqb(&tag, &a, &b);\n188\t                check_pad(&tag, &a, len);\n189\t                check_pad(&tag, &b, len);\n190\t\n191\t                let mut ip_c = padded(len);\n192\t                ip_c[..len].copy_from_slice(&m);\n193\t                let mut ip_r = ip_c.clone();\n194\t                unsafe {\n195\t                    let pc = ip_c.as_mut_ptr();\n196\t                    let pr = ip_r.as_mut_ptr();\n197\t                    cxi(pc, pc, len as u64, n.as_ptr(), ic, k.as_ptr());\n198\t                    rxi(pr, pr, len as u64, n.as_ptr(), ic, k.as_ptr());\n199\t                }\n200\t                eqb(&format!(\"{tag} in-place\"), &ip_c, &ip_r);\n201\t                check_pad(&format!(\"{tag} in-place\"), &ip_c, len);\n202\t                assert_eq!(&ip_c[..len], &a[..len], \"{tag}: in-place != out-of-place\");\n203\t\n204\t                let mut inv_c = padded(len);\n205\t                let mut inv_r = padded(len);\n206\t                unsafe {\n207\t                    cxi(inv_c.as_mut_ptr(), a.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n208\t                    rxi(inv_r.as_mut_ptr(), b.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n209\t                }\n210\t                eqb(&format!(\"{tag} inv\"), &inv_c, &inv_r);\n211\t                assert_eq!(&inv_c[..len], &m[..], \"{tag}: not an involution\");\n212\t\n213\t                if ic == 0 {\n214\t                    let mut z_c = padded(len);\n215\t                    let mut z_r = padded(len);\n216\t                    unsafe {\n217\t                        cx(z_c.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n218\t                        rx(z_r.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n219\t                    }\n220\t                    eqb(&format!(\"{tag} vs _xor\"), &z_c, &z_r);\n221\t                    assert_eq!(&z_c[..len], &a[..len], \"{tag}: ic=0 must equal _xor\");\n222\t                }\n223\t\n224\t                if tail_check && ic <= 8 && len > 0 {\n225\t                    let off = 64 * ic as usize;\n226\t                    let total = off + len;\n227\t                    let mut full = rng.bytes(total);\n228\t                    full[off..].copy_from_slice(&m);\n229\t                    let mut fc = vec![0u8; total];\n230\t                    let mut fr = vec![0u8; total];\n231\t                    unsafe {\n232\t                        cx(fc.as_mut_ptr(), full.as_ptr(), total as u64, n.as_ptr(), k.as_ptr());\n233\t                        rx(fr.as_mut_ptr(), full.as_ptr(), total as u64, n.as_ptr(), k.as_ptr());\n234\t                    }\n235\t                    eqb(&format!(\"{tag} tail\"), &fc, &fr);\n236\t                    assert_eq!(\n237\t                        &fc[off..],\n238\t                        &a[..len],\n239\t                        \"{tag}: xor_ic(ic) != tail of _xor at block ic\"\n240\t                    );\n241\t                }\n242\t            }\n243\t        }\n244\t    }\n245\t}\n246\t\n247\t/// `{base}_xor_ic` with a 32-bit `ic` (chacha20_ietf, chacha20_ietf_ext).\n248\t///\n249\t/// `xor_ref` is the name of the `_xor` entry point to cross-check `ic == 0`\n250\t/// against (`None` for `_ietf_ext_xor_ic`, whose `_xor` sibling is `static`).\n251\tfn drive_xor_ic32(\n252\t    base: &str,\n253\t    nb: usize,\n254\t    seed: u64,\n255\t    lens: &[usize],\n256\t    ics: &[u32],\n257\t    xor_ref: Option<&str>,\n258\t    tail_check: bool,\n259\t    extra: usize,\n260\t) {\n261\t    let ic_name = format!(\"{base}_xor_ic\");\n262\t    let (cxi, rxi) = both::<XorIc32>(&ic_name);\n263\t    let xr = xor_ref.map(|s| both::<Xor>(s));\n264\t    let mut rng = Rng::new(seed);\n265\t\n266\t    for &ic in ics {\n267\t        for &len in lens {\n268\t            for (si, (k, n)) in shapes(nb, &mut rng, extra).into_iter().enumerate() {\n269\t                let tag = format!(\"{ic_name}(len={len},ic={ic:#x},shape={si})\");\n270\t                let m = rng.bytes(len);\n271\t\n272\t                let mut a = padded(len);\n273\t                let mut b = padded(len);\n274\t                let (rc, rr) = unsafe {\n275\t                    (\n276\t                        cxi(a.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr()),\n277\t                        rxi(b.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr()),\n278\t                    )\n279\t                };\n280\t                eqi(&tag, rc, rr);\n281\t                assert_eq!(rc, 0, \"{tag}: must return 0\");\n282\t                eqb(&tag, &a, &b);\n283\t                check_pad(&tag, &a, len);\n284\t                check_pad(&tag, &b, len);\n285\t\n286\t                let mut ip_c = padded(len);\n287\t                ip_c[..len].copy_from_slice(&m);\n288\t                let mut ip_r = ip_c.clone();\n289\t                unsafe {\n290\t                    let pc = ip_c.as_mut_ptr();\n291\t                    let pr = ip_r.as_mut_ptr();\n292\t                    cxi(pc, pc, len as u64, n.as_ptr(), ic, k.as_ptr());\n293\t                    rxi(pr, pr, len as u64, n.as_ptr(), ic, k.as_ptr());\n294\t                }\n295\t                eqb(&format!(\"{tag} in-place\"), &ip_c, &ip_r);\n296\t                check_pad(&format!(\"{tag} in-place\"), &ip_c, len);\n297\t                assert_eq!(&ip_c[..len], &a[..len], \"{tag}: in-place != out-of-place\");\n298\t\n299\t                let mut inv_c = padded(len);\n300\t                let mut inv_r = padded(len);\n301\t                unsafe {\n302\t                    cxi(inv_c.as_mut_ptr(), a.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n303\t                    rxi(inv_r.as_mut_ptr(), b.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n304\t                }\n305\t                eqb(&format!(\"{tag} inv\"), &inv_c, &inv_r);\n306\t                assert_eq!(&inv_c[..len], &m[..], \"{tag}: not an involution\");\n307\t\n308\t                if ic == 0 {\n309\t                    if let Some((cx, rx)) = xr.as_ref() {\n310\t                        let mut z_c = padded(len);\n311\t                        let mut z_r = padded(len);\n312\t                        unsafe {\n313\t                            cx(z_c.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n314\t                            rx(z_r.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n315\t                        }\n316\t                        eqb(&format!(\"{tag} vs _xor\"), &z_c, &z_r);\n317\t                        assert_eq!(&z_c[..len], &a[..len], \"{tag}: ic=0 must equal _xor\");\n318\t                    }\n319\t                }\n320\t\n321\t                if tail_check && ic <= 8 && len > 0 {\n322\t                    let off = 64 * ic as usize;\n323\t                    let total = off + len;\n324\t                    let mut full = rng.bytes(total);\n325\t                    full[off..].copy_from_slice(&m);\n326\t                    let mut fc = vec![0u8; total];\n327\t                    let mut fr = vec![0u8; total];\n328\t                    unsafe {\n329\t                        cxi(fc.as_mut_ptr(), full.as_ptr(), total as u64, n.as_ptr(), 0, k.as_ptr());\n330\t                        rxi(fr.as_mut_ptr(), full.as_ptr(), total as u64, n.as_ptr(), 0, k.as_ptr());\n331\t                    }\n332\t                    eqb(&format!(\"{tag} tail\"), &fc, &fr);\n333\t                    assert_eq!(\n334\t                        &fc[off..],\n335\t                        &a[..len],\n336\t                        \"{tag}: xor_ic(ic) != tail of xor_ic(0) at block ic\"\n337\t                    );\n338\t                }\n339\t            }\n340\t        }\n341\t    }\n342\t}\n343\t\n344\tfn prefix_consistency(base: &str, nb: usize, seed: u64) {\n345\t    let (cs, rs) = both::<Stream>(base);\n346\t    let mut rng = Rng::new(seed);\n347\t    for (si, (k, n)) in shapes(nb, &mut rng, 3).into_iter().enumerate() {\n348\t        let mut prev: Vec<u8> = Vec::new();\n349\t        for &len in L.iter() {\n350\t            let mut a = padded(len);\n351\t            let mut b = padded(len);\n352\t            unsafe {\n353\t                cs(a.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n354\t                rs(b.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n355\t            }\n356\t            eqb(&format!(\"{base} prefix(len={len},shape={si})\"), &a, &b);\n357\t            assert_eq!(\n358\t                &a[..prev.len()],\n359\t                &prev[..],\n360\t                \"{base}: length {len} output is not an extension of the shorter one\"\n361\t            );\n362\t            prev = a[..len].to_vec();\n363\t        }\n364\t    }\n365\t}\n366\t\n367\t// ================================================================= accessors\n368\t\n369\tfn accessor(name: &str, expect: usize) {\n370\t    let (c, r) = both::<SizeFn>(name);\n371\t    let (vc, vr) = unsafe { (c(), r()) };\n372\t    assert_eq!(vc, vr, \"{name}: C {vc} vs Rust {vr}\");\n373\t    assert_eq!(vc, expect, \"{name}: expected {expect}, C returned {vc}\");\n374\t}\n375\t\n376\t#[test]\n377\tfn chacha20_family_accessors() {\n378\t    // 5.47\n379\t    accessor(\"crypto_stream_chacha20_keybytes\", 32);\n380\t    accessor(\"crypto_stream_chacha20_noncebytes\", 8);\n381\t    accessor(\"crypto_stream_chacha20_messagebytes_max\", SODIUM_SIZE_MAX as usize);\n382\t    // 5.59 — note the distinct IETF message limit\n383\t    accessor(\"crypto_stream_chacha20_ietf_keybytes\", 32);\n384\t    accessor(\"crypto_stream_chacha20_ietf_noncebytes\", 12);\n385\t    accessor(\"crypto_stream_chacha20_ietf_messagebytes_max\", IETF_MAX as usize);\n386\t    assert_eq!(IETF_MAX, 64u64 * (1u64 << 32));\n387\t    // 5.75\n388\t    accessor(\"crypto_stream_xchacha20_keybytes\", 32);\n389\t    accessor(\"crypto_stream_xchacha20_noncebytes\", 24);\n390\t    accessor(\"crypto_stream_xchacha20_messagebytes_max\", SODIUM_SIZE_MAX as usize);\n391\t}\n392\t\n393\t#[test]\n394\tfn chacha20_ietf_legacy_aliases() {\n395\t    // 5.74: `crypto_stream_chacha20_IETF_*` are header-only #defines that expand\n396\t    // to their lowercase counterparts, so there is no separate symbol to load —\n397\t    // the accessors are the only observable surface and must agree.\n398\t    let (ck, rk) = both::<SizeFn>(\"crypto_stream_chacha20_ietf_keybytes\");\n399\t    let (cn, rn) = both::<SizeFn>(\"crypto_stream_chacha20_ietf_noncebytes\");\n400\t    let (cm, rm) = both::<SizeFn>(\"crypto_stream_chacha20_ietf_messagebytes_max\");\n401\t    unsafe {\n402\t        assert_eq!(ck(), 32);\n403\t        assert_eq!(rk(), 32);\n404\t        assert_eq!(cn(), 12);\n405\t        assert_eq!(rn(), 12);\n406\t        assert_eq!(cm(), IETF_MAX as usize);\n407\t        assert_eq!(rm(), IETF_MAX as usize);\n408\t    }\n409\t    assert!(\n410\t        !has(\"crypto_stream_chacha20_IETF_KEYBYTES\"),\n411\t        \"the legacy alias must remain a macro, not a symbol\"\n412\t    );\n413\t}\n414\t\n415\t// ====================================================== chacha20 (original)\n416\t\n417\t#[test]\n418\tfn chacha20_keystream_and_xor_sweep() {\n419\t    // 5.48, 5.49, 5.50, 5.51\n420\t    drive_keystream_and_xor(\"crypto_stream_chacha20\", 8, 0x5_0048, &L, 4);\n421\t    drive_keystream_and_xor(\"crypto_stream_chacha20\", 8, 0x5_0049, &BIG, 1);\n422\t}\n423\t\n424\t#[test]\n425\tfn chacha20_full_length_sweep() {\n426\t    let lens: Vec<usize> = (0..=600).collect();\n427\t    drive_keystream_and_xor(\"crypto_stream_chacha20\", 8, 0x5_0050, &lens, 0);\n428\t}\n429\t\n430\t#[test]\n431\tfn chacha20_xor_ic_small() {\n432\t    // 5.52 (ic = 0), 5.53 (ic = 1), 5.54 (ic in {2,3,7})\n433\t    drive_xor_ic64(\n434\t        \"crypto_stream_chacha20\",\n435\t        8,\n436\t        0x5_0052,\n437\t        &L,\n438\t        &[0, 1, 2, 3, 7],\n439\t        true,\n440\t        3,\n441\t    );\n442\t}\n443\t\n444\t#[test]\n445\tfn chacha20_xor_ic_counter_boundaries() {\n446\t    // 5.55: ic = 0xFFFFFFFF — j12 wraps and carries into j13 (counter high word)\n447\t    // 5.56: ic = 2^64-1 — the full 64-bit counter rolls over mid-message\n448\t    drive_xor_ic64(\n449\t        \"crypto_stream_chacha20\",\n450\t        8,\n451\t        0x5_0055,\n452\t        &[64, 65, 128, 129, 192],\n453\t        &[0xFFFF_FFFF, 0x1_0000_0000, 0xFFFF_FFFF_FFFF_FFFF, 0xFFFF_FFFF_FFFF_FFFE],\n454\t        false,\n455\t        3,\n456\t    );\n457\t\n458\t    let (cxi, rxi) = both::<XorIc64>(\"crypto_stream_chacha20_xor_ic\");\n459\t    let mut rng = Rng::new(0x5_0056);\n460\t    for (si, (k, n)) in shapes(8, &mut rng, 3).into_iter().enumerate() {\n461\t        let m = vec![0u8; 192];\n462\t\n463\t        // Error row 5.14: ic = 0xFFFFFFFF crossing a 2^32 boundary is a *correct*\n464\t        // 64-bit increment for the original nonce layout, so block 1 must equal\n465\t        // the block at counter 2^32.\n466\t        let mut a = vec![0u8; 128];\n467\t        let mut b = vec![0u8; 128];\n468\t        let mut nxt_c = vec![0u8; 64];\n469\t        let mut nxt_r = vec![0u8; 64];\n470\t        unsafe {\n471\t            let rc = cxi(a.as_mut_ptr(), m.as_ptr(), 128, n.as_ptr(), 0xFFFF_FFFF, k.as_ptr());\n472\t            let rr = rxi(b.as_mut_ptr(), m.as_ptr(), 128, n.as_ptr(), 0xFFFF_FFFF, k.as_ptr());\n473\t            eqi(\"chacha20 32->64 carry rv\", rc, rr);\n474\t            assert_eq!(rc, 0, \"the 32->64 carry must not be an error (row 5.14)\");\n475\t            cxi(nxt_c.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0x1_0000_0000, k.as_ptr());\n476\t            rxi(nxt_r.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0x1_0000_0000, k.as_ptr());\n477\t        }\n478\t        eqb(&format!(\"chacha20 carry(shape={si})\"), &a, &b);\n479\t        eqb(&format!(\"chacha20 ic=2^32(shape={si})\"), &nxt_c, &nxt_r);\n480\t        assert_eq!(&a[64..], &nxt_c[..], \"32->64 carry produced the wrong block\");\n481\t\n482\t        // Error row 5.13: ic = 2^64-1 wraps silently to counter 0.\n483\t        let mut w_c = vec![0u8; 128];\n484\t        let mut w_r = vec![0u8; 128];\n485\t        let mut z_c = vec![0u8; 64];\n486\t        let mut z_r = vec![0u8; 64];\n487\t        unsafe {\n488\t            let rc = cxi(w_c.as_mut_ptr(), m.as_ptr(), 128, n.as_ptr(), u64::MAX, k.as_ptr());\n489\t            let rr = rxi(w_r.as_mut_ptr(), m.as_ptr(), 128, n.as_ptr(), u64::MAX, k.as_ptr());\n490\t            eqi(\"chacha20 wrap rv\", rc, rr);\n491\t            assert_eq!(rc, 0, \"the 64-bit wraparound must be silent (row 5.13)\");\n492\t            cxi(z_c.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0, k.as_ptr());\n493\t            rxi(z_r.as_mut_ptr(), m.as_ptr(), 64, n.as_ptr(), 0, k.as_ptr());\n494\t        }\n495\t        eqb(&format!(\"chacha20 wrap(shape={si})\"), &w_c, &w_r);\n496\t        eqb(&format!(\"chacha20 ic0(shape={si})\"), &z_c, &z_r);\n497\t        assert_eq!(\n498\t            &w_c[64..],\n499\t            &z_c[..],\n500\t            \"chacha20: the block after counter 2^64-1 must be the counter-0 block\"\n501\t        );\n502\t    }\n503\t}\n504\t\n505\t#[test]\n506\tfn chacha20_xor_ic_zero_length() {\n507\t    // 5.57\n508\t    let (cxi, rxi) = both::<XorIc64>(\"crypto_stream_chacha20_xor_ic\");\n509\t    let k = [7u8; 32];\n510\t    let n = [9u8; 8];\n511\t    for ic in [0u64, 1, u64::MAX] {\n512\t        let mut a = padded(0);\n513\t        let mut b = padded(0);\n514\t        let ref_a = a.clone();\n515\t        let (rc, rr) = unsafe {\n516\t            (\n517\t                cxi(a.as_mut_ptr(), core::ptr::null(), 0, n.as_ptr(), ic, k.as_ptr()),\n518\t                rxi(b.as_mut_ptr(), core::ptr::null(), 0, n.as_ptr(), ic, k.as_ptr()),\n519\t            )\n520\t        };\n521\t        eqi(&format!(\"chacha20_xor_ic(mlen=0,ic={ic:#x})\"), rc, rr);\n522\t        assert_eq!(rc, 0);\n523\t        eqb(&format!(\"chacha20_xor_ic(mlen=0,ic={ic:#x})\"), &a, &b);\n524\t        assert_eq!(a, ref_a, \"mlen=0 must not touch the output buffer\");\n525\t    }\n526\t}\n527\t\n528\t// ========================================================== chacha20_ietf\n529\t\n530\t#[test]\n531\tfn chacha20_ietf_keystream_and_xor_sweep() {\n532\t    // 5.60, 5.61, 5.62\n533\t    drive_keystream_and_xor(\"crypto_stream_chacha20_ietf\", 12, 0x5_0060, &L, 4);\n534\t    drive_keystream_and_xor(\"crypto_stream_chacha20_ietf\", 12, 0x5_0061, &BIG, 1);\n535\t}\n536\t\n537\t#[test]\n538\tfn chacha20_ietf_full_length_sweep() {\n539\t    let lens: Vec<usize> = (0..=600).collect();\n540\t    drive_keystream_and_xor(\"crypto_stream_chacha20_ietf\", 12, 0x5_0062, &lens, 0);\n541\t}\n542\t\n543\t#[test]\n544\tfn chacha20_ietf_xor_ic_small() {\n545\t    // 5.63 (ic = 0), 5.64 (ic = 1, the RFC 7539 §2.4.2 counter), 5.65 (2, 3, 7)\n546\t    drive_xor_ic32(\n547\t        \"crypto_stream_chacha20_ietf\",\n548\t        12,\n549\t        0x5_0063,\n550\t        &L,\n551\t        &[0, 1, 2, 3, 7],\n552\t        Some(\"crypto_stream_chacha20_ietf_xor\"),\n553\t        true,\n554\t        3,\n555\t    );\n556\t}\n557\t\n558\t#[test]\n559\tfn chacha20_ietf_xor_ic_exact_accepted_boundary() {\n560\t    // 5.66: ic = 2^32 - ceil(mlen/64) is the largest accepted value; the counter\n561\t    // reaches 0xFFFFFFFF on the final block and never wraps.\n562\t    let cases: [(usize, u32); 7] = [\n563\t        (1, 0xFFFF_FFFF),\n564\t        (63, 0xFFFF_FFFF),\n565\t        (64, 0xFFFF_FFFF),\n566\t        (65, 0xFFFF_FFFE),\n567\t        (128, 0xFFFF_FFFE),\n568\t        (129, 0xFFFF_FFFD),\n569\t        (512, 0xFFFF_FFF8),\n570\t    ];\n571\t    let (cxi, rxi) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n572\t    let (cei, rei) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_ext_xor_ic\");\n573\t    let mut rng = Rng::new(0x5_0066);\n574\t    for (mlen, ic) in cases {\n575\t        // Sanity: the C guard is `ic > 2^32 - ceil(mlen/64)`.\n576\t        let limit = 4_294_967_296u64 - ((mlen as u64 + 63) / 64);\n577\t        assert!(ic as u64 <= limit, \"case ({mlen},{ic:#x}) is not accepted\");\n578\t        assert_eq!(\n579\t            ic as u64 + ((mlen as u64 + 63) / 64),\n580\t            4_294_967_296u64,\n581\t            \"case ({mlen},{ic:#x}) is not exactly on the boundary\"\n582\t        );\n583\t        for (si, (k, n)) in shapes(12, &mut rng, 3).into_iter().enumerate() {\n584\t            let m = rng.bytes(mlen);\n585\t            let tag = format!(\"ietf_xor_ic boundary(mlen={mlen},ic={ic:#x},shape={si})\");\n586\t            let mut a = padded(mlen);\n587\t            let mut b = padded(mlen);\n588\t            let (rc, rr) = unsafe {\n589\t                (\n590\t                    cxi(a.as_mut_ptr(), m.as_ptr(), mlen as u64, n.as_ptr(), ic, k.as_ptr()),\n591\t                    rxi(b.as_mut_ptr(), m.as_ptr(), mlen as u64, n.as_ptr(), ic, k.as_ptr()),\n592\t                )\n593\t            };\n594\t            eqi(&tag, rc, rr);\n595\t            assert_eq!(rc, 0, \"{tag}: the exact boundary must be accepted\");\n596\t            eqb(&tag, &a, &b);\n597\t            check_pad(&tag, &a, mlen);\n598\t            // Row 5.70: `_ext_xor_ic` must agree wherever the guard permits.\n599\t            let mut e_c = padded(mlen);\n600\t            let mut e_r = padded(mlen);\n601\t            unsafe {\n602\t                cei(e_c.as_mut_ptr(), m.as_ptr(), mlen as u64, n.as_ptr(), ic, k.as_ptr());\n603\t                rei(e_r.as_mut_ptr(), m.as_ptr(), mlen as u64, n.as_ptr(), ic, k.as_ptr());\n604\t            }\n605\t            eqb(&format!(\"{tag} ext\"), &e_c, &e_r);\n606\t            assert_eq!(&e_c[..mlen], &a[..mlen], \"{tag}: _ext_xor_ic disagrees\");\n607\t        }\n608\t    }\n609\t}\n610\t\n611\t#[test]\n612\tfn chacha20_ietf_xor_ic_one_past_boundary_aborts() {\n613\t    // 5.67 / error row 5.8: `ic = 2^32 + 1 - ceil(mlen/64)` must hit\n614\t    // sodium_misuse() -> abort().\n615\t    let cases: [(usize, u32); 4] = [\n616\t        (65, 0xFFFF_FFFF),\n617\t        (128, 0xFFFF_FFFF),\n618\t        (129, 0xFFFF_FFFE),\n619\t        (512, 0xFFFF_FFF9),\n620\t    ];\n621\t    let k = [0x33u8; 32];\n622\t    let n = [0x44u8; 12];\n623\t    for (mlen, ic) in cases {\n624\t        let limit = 4_294_967_296u64 - ((mlen as u64 + 63) / 64);\n625\t        assert!(ic as u64 > limit, \"case ({mlen},{ic:#x}) is not past the limit\");\n626\t        let m = vec![0u8; mlen];\n627\t        let mut out = vec![0u8; mlen];\n628\t        let (mp, op) = (m.as_ptr(), out.as_mut_ptr());\n629\t        let kp = k.as_ptr();\n630\t        let np = n.as_ptr();\n631\t        let (c, r) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n632\t        eq_abort(\n633\t            &format!(\"ietf_xor_ic past boundary(mlen={mlen},ic={ic:#x})\"),\n634\t            || unsafe {\n635\t                c(op, mp, mlen as u64, np, ic, kp);\n636\t            },\n637\t            || unsafe {\n638\t                r(op, mp, mlen as u64, np, ic, kp);\n639\t            },\n640\t        );\n641\t        // The abort happened in the child, so the parent's buffer is untouched.\n642\t        assert!(out.iter().all(|&x| x == 0));\n643\t    }\n644\t}\n645\t\n646\t#[test]\n647\tfn chacha20_ietf_xor_ic_zero_length() {\n648\t    // 5.68: mlen = 0 → the guard limit is 2^32 and never fires, then the early\n649\t    // `return 0` leaves the output untouched.\n650\t    let (cxi, rxi) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n651\t    let k = [0x5eu8; 32];\n652\t    let n = [0x6fu8; 12];\n653\t    for ic in [0u32, 1, 0xFFFF_FFFF] {\n654\t        let mut a = padded(0);\n655\t        let mut b = padded(0);\n656\t        let ref_a = a.clone();\n657\t        let (rc, rr) = unsafe {\n658\t            (\n659\t                cxi(a.as_mut_ptr(), core::ptr::null(), 0, n.as_ptr(), ic, k.as_ptr()),\n660\t                rxi(b.as_mut_ptr(), core::ptr::null(), 0, n.as_ptr(), ic, k.as_ptr()),\n661\t            )\n662\t        };\n663\t        eqi(&format!(\"ietf_xor_ic(mlen=0,ic={ic:#x})\"), rc, rr);\n664\t        assert_eq!(rc, 0);\n665\t        eqb(&format!(\"ietf_xor_ic(mlen=0,ic={ic:#x})\"), &a, &b);\n666\t        assert_eq!(a, ref_a);\n667\t    }\n668\t}\n669\t\n670\t// ================================================== chacha20_ietf_ext (private)\n671\t\n672\t#[test]\n673\tfn chacha20_ietf_ext_matches_ietf() {\n674\t    // 5.69\n675\t    let (ce, re) = both::<Stream>(\"crypto_stream_chacha20_ietf_ext\");\n676\t    let (ci, ri) = both::<Stream>(\"crypto_stream_chacha20_ietf\");\n677\t    let mut rng = Rng::new(0x5_0069);\n678\t    let mut lens: Vec<usize> = L.to_vec();\n679\t    lens.extend_from_slice(&BIG);\n680\t    for &len in lens.iter() {\n681\t        for (si, (k, n)) in shapes(12, &mut rng, 4).into_iter().enumerate() {\n682\t            let tag = format!(\"ietf_ext(len={len},shape={si})\");\n683\t            let mut e_c = padded(len);\n684\t            let mut e_r = padded(len);\n685\t            let mut i_c = padded(len);\n686\t            let mut i_r = padded(len);\n687\t            let (rc, rr) = unsafe {\n688\t                (\n689\t                    ce(e_c.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n690\t                    re(e_r.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr()),\n691\t                )\n692\t            };\n693\t            eqi(&tag, rc, rr);\n694\t            assert_eq!(rc, 0);\n695\t            eqb(&tag, &e_c, &e_r);\n696\t            check_pad(&tag, &e_c, len);\n697\t            unsafe {\n698\t                ci(i_c.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n699\t                ri(i_r.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n700\t            }\n701\t            eqb(&format!(\"{tag} ietf\"), &i_c, &i_r);\n702\t            assert_eq!(e_c, i_c, \"{tag}: _ietf_ext != _ietf below 2^38\");\n703\t        }\n704\t    }\n705\t}\n706\t\n707\t#[test]\n708\tfn chacha20_ietf_ext_xor_ic_small() {\n709\t    // 5.70\n710\t    drive_xor_ic32(\n711\t        \"crypto_stream_chacha20_ietf_ext\",\n712\t        12,\n713\t        0x5_0070,\n714\t        &L,\n715\t        &[0, 1, 2, 3, 7],\n716\t        None,\n717\t        true,\n718\t        3,\n719\t    );\n720\t    // and it must byte-equal `_ietf_xor_ic` wherever the latter's guard permits\n721\t    let (cei, rei) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_ext_xor_ic\");\n722\t    let (cxi, rxi) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n723\t    let mut rng = Rng::new(0x5_0071);\n724\t    for ic in [0u32, 1, 2, 3, 7] {\n725\t        for &len in L.iter() {\n726\t            for (si, (k, n)) in shapes(12, &mut rng, 2).into_iter().enumerate() {\n727\t                let m = rng.bytes(len);\n728\t                let mut e_c = padded(len);\n729\t                let mut e_r = padded(len);\n730\t                let mut x_c = padded(len);\n731\t                let mut x_r = padded(len);\n732\t                unsafe {\n733\t                    cei(e_c.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n734\t                    rei(e_r.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n735\t                    cxi(x_c.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n736\t                    rxi(x_r.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n737\t                }\n738\t                let tag = format!(\"ext_vs_ietf(len={len},ic={ic},shape={si})\");\n739\t                eqb(&format!(\"{tag} ext\"), &e_c, &e_r);\n740\t                eqb(&format!(\"{tag} ietf\"), &x_c, &x_r);\n741\t                assert_eq!(e_c, x_c, \"{tag}\");\n742\t            }\n743\t        }\n744\t    }\n745\t}\n746\t\n747\t#[test]\n748\tfn chacha20_ietf_ext_xor_ic_counter_overflows_into_the_iv() {\n749\t    // 5.71 / error row 5.16: `_ietf_ext_xor_ic` has no counter guard, so\n750\t    // ic = 0xFFFFFFFF with mlen > 64 wraps j12 to 0 and carries into j13, which\n751\t    // under `chacha_ietf_ivsetup` is nonce word 0.  The tail must therefore equal\n752\t    // a counter-0 run with the first nonce word incremented.\n753\t    let (cei, rei) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_ext_xor_ic\");\n754\t    let mut rng = Rng::new(0x5_0072);\n755\t    for &mlen in [65usize, 128, 129, 192].iter() {\n756\t        for (si, (k, n)) in shapes(12, &mut rng, 4).into_iter().enumerate() {\n757\t            let tag = format!(\"ext_overflow(mlen={mlen},shape={si})\");\n758\t            let m = vec![0u8; mlen]; // zero plaintext → output is the keystream\n759\t            let mut a = padded(mlen);\n760\t            let mut b = padded(mlen);\n761\t            let (rc, rr) = unsafe {\n762\t                (\n763\t                    cei(\n764\t                        a.as_mut_ptr(),\n765\t                        m.as_ptr(),\n766\t                        mlen as u64,\n767\t                        n.as_ptr(),\n768\t                        0xFFFF_FFFF,\n769\t                        k.as_ptr(),\n770\t                    ),\n771\t                    rei(\n772\t                        b.as_mut_ptr(),\n773\t                        m.as_ptr(),\n774\t                        mlen as u64,\n775\t                        n.as_ptr(),\n776\t                        0xFFFF_FFFF,\n777\t                        k.as_ptr(),\n778\t                    ),\n779\t                )\n780\t            };\n781\t            eqi(&tag, rc, rr);\n782\t            assert_eq!(rc, 0, \"{tag}: the overflow must be silent (no misuse)\");\n783\t            eqb(&tag, &a, &b);\n784\t            check_pad(&tag, &a, mlen);\n785\t\n786\t            // nonce with word 0 incremented (little-endian)\n787\t            let mut n2 = n.clone();\n788\t            let w0 = u32::from_le_bytes([n[0], n[1], n[2], n[3]]).wrapping_add(1);\n789\t            n2[..4].copy_from_slice(&w0.to_le_bytes());\n790\t            let tail = mlen - 64;\n791\t            let m2 = vec![0u8; tail];\n792\t            let mut t_c = padded(tail);\n793\t            let mut t_r = padded(tail);\n794\t            unsafe {\n795\t                cei(t_c.as_mut_ptr(), m2.as_ptr(), tail as u64, n2.as_ptr(), 0, k.as_ptr());\n796\t                rei(t_r.as_mut_ptr(), m2.as_ptr(), tail as u64, n2.as_ptr(), 0, k.as_ptr());\n797\t            }\n798\t            eqb(&format!(\"{tag} tail\"), &t_c, &t_r);\n799\t            assert_eq!(\n800\t                &a[64..mlen],\n801\t                &t_c[..tail],\n802\t                \"{tag}: the overflow did not carry into nonce word 0\"\n803\t            );\n804\t        }\n805\t    }\n806\t}\n807\t\n808\t// ========================================================== cross-variant\n809\t\n810\t#[test]\n811\tfn ietf_and_original_layouts_are_distinct() {\n812\t    // 5.73\n813\t    let (ci, ri) = both::<Stream>(\"crypto_stream_chacha20_ietf\");\n814\t    let (co, ro) = both::<Stream>(\"crypto_stream_chacha20\");\n815\t    let mut rng = Rng::new(0x5_0073);\n816\t    for si in 0..8 {\n817\t        let k = rng.bytes(32);\n818\t        let n8 = rng.bytes(8);\n819\t        let mut n12 = n8.clone();\n820\t        n12.extend_from_slice(&[0u8; 4]);\n821\t        for &len in [64usize, 128].iter() {\n822\t            let mut i_c = vec![0u8; len];\n823\t            let mut i_r = vec![0u8; len];\n824\t            let mut o_c = vec![0u8; len];\n825\t            let mut o_r = vec![0u8; len];\n826\t            unsafe {\n827\t                ci(i_c.as_mut_ptr(), len as u64, n12.as_ptr(), k.as_ptr());\n828\t                ri(i_r.as_mut_ptr(), len as u64, n12.as_ptr(), k.as_ptr());\n829\t                co(o_c.as_mut_ptr(), len as u64, n8.as_ptr(), k.as_ptr());\n830\t                ro(o_r.as_mut_ptr(), len as u64, n8.as_ptr(), k.as_ptr());\n831\t            }\n832\t            eqb(&format!(\"ietf({len},{si})\"), &i_c, &i_r);\n833\t            eqb(&format!(\"orig({len},{si})\"), &o_c, &o_r);\n834\t            assert_ne!(\n835\t                i_c, o_c,\n836\t                \"the ietf and original counter/nonce layouts must differ\"\n837\t            );\n838\t        }\n839\t    }\n840\t}\n841\t\n842\t// ================================================================ xchacha20\n843\t\n844\t#[test]\n845\tfn xchacha20_keystream_and_xor_sweep() {\n846\t    // 5.76, 5.77, 5.78\n847\t    drive_keystream_and_xor(\"crypto_stream_xchacha20\", 24, 0x5_0076, &L, 4);\n848\t    drive_keystream_and_xor(\"crypto_stream_xchacha20\", 24, 0x5_0077, &BIG, 1);\n849\t}\n850\t\n851\t#[test]\n852\tfn xchacha20_full_length_sweep() {\n853\t    let lens: Vec<usize> = (0..=600).collect();\n854\t    drive_keystream_and_xor(\"crypto_stream_xchacha20\", 24, 0x5_0078, &lens, 0);\n855\t}\n856\t\n857\t#[test]\n858\tfn xchacha20_xor_ic_small() {\n859\t    // 5.79 (ic = 0), 5.80 (ic = 1 and small)\n860\t    drive_xor_ic64(\n861\t        \"crypto_stream_xchacha20\",\n862\t        24,\n863\t        0x5_0079,\n864\t        &L,\n865\t        &[0, 1, 2, 3, 7],\n866\t        true,\n867\t        3,\n868\t    );\n869\t}\n870\t\n871\t#[test]\n872\tfn xchacha20_xor_ic_no_ietf_guard() {\n873\t    // 5.81 / error row 5.12: `ic` is uint64_t and reaches the *original*\n874\t    // chacha20 path, so the IETF 32-bit constraints do not apply and no misuse\n875\t    // may occur.\n876\t    drive_xor_ic64(\n877\t        \"crypto_stream_xchacha20\",\n878\t        24,\n879\t        0x5_0081,\n880\t        &[64, 65, 128, 129, 192],\n881\t        &[0xFFFF_FFFF, 0x1_0000_0000, 0xFFFF_FFFF_FFFF_FFFF],\n882\t        false,\n883\t        3,\n884\t    );\n885\t}\n886\t\n887\t#[test]\n888\tfn xchacha20_equals_hchacha20_plus_chacha20() {\n889\t    // 5.82\n890\t    let (chc, rhc) = both::<Core>(\"crypto_core_hchacha20\");\n891\t    let (cxc, rxc) = both::<Stream>(\"crypto_stream_xchacha20\");\n892\t    let (cc, rc_) = both::<Stream>(\"crypto_stream_chacha20\");\n893\t    let (cxci, rxci) = both::<XorIc64>(\"crypto_stream_xchacha20_xor_ic\");\n894\t    let (cci, rci) = both::<XorIc64>(\"crypto_stream_chacha20_xor_ic\");\n895\t    let mut rng = Rng::new(0x5_0082);\n896\t    for (si, (k, n)) in shapes(24, &mut rng, 5).into_iter().enumerate() {\n897\t        let mut k2_c = [0u8; 32];\n898\t        let mut k2_r = [0u8; 32];\n899\t        unsafe {\n900\t            chc(k2_c.as_mut_ptr(), n.as_ptr(), k.as_ptr(), core::ptr::null());\n901\t            rhc(k2_r.as_mut_ptr(), n.as_ptr(), k.as_ptr(), core::ptr::null());\n902\t        }\n903\t        eqb(&format!(\"hchacha20 subkey(shape={si})\"), &k2_c, &k2_r);\n904\t        for &len in [0usize, 64, 65, 512].iter() {\n905\t            let mut x_c = vec![0u8; len];\n906\t            let mut x_r = vec![0u8; len];\n907\t            let mut c_c = vec![0u8; len];\n908\t            let mut c_r = vec![0u8; len];\n909\t            unsafe {\n910\t                cxc(x_c.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n911\t                rxc(x_r.as_mut_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n912\t                cc(c_c.as_mut_ptr(), len as u64, n.as_ptr().add(16), k2_c.as_ptr());\n913\t                rc_(c_r.as_mut_ptr(), len as u64, n.as_ptr().add(16), k2_r.as_ptr());\n914\t            }\n915\t            eqb(&format!(\"xchacha20({len},shape={si})\"), &x_c, &x_r);\n916\t            eqb(&format!(\"chacha20 subkey({len},shape={si})\"), &c_c, &c_r);\n917\t            assert_eq!(x_c, c_c, \"xchacha20 != chacha20(n+16, hchacha20(n,k))\");\n918\t\n919\t            for ic in [0u64, 1, 5, 0xFFFF_FFFF, u64::MAX] {\n920\t                let m = {\n921\t                    let mut r2 = Rng::new(len as u64 ^ ic);\n922\t                    r2.bytes(len)\n923\t                };\n924\t                let mut xi_c = vec![0u8; len];\n925\t                let mut xi_r = vec![0u8; len];\n926\t                let mut ci_c = vec![0u8; len];\n927\t                let mut ci_r = vec![0u8; len];\n928\t                unsafe {\n929\t                    cxci(xi_c.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n930\t                    rxci(xi_r.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), ic, k.as_ptr());\n931\t                    cci(\n932\t                        ci_c.as_mut_ptr(),\n933\t                        m.as_ptr(),\n934\t                        len as u64,\n935\t                        n.as_ptr().add(16),\n936\t                        ic,\n937\t                        k2_c.as_ptr(),\n938\t                    );\n939\t                    rci(\n940\t                        ci_r.as_mut_ptr(),\n941\t                        m.as_ptr(),\n942\t                        len as u64,\n943\t                        n.as_ptr().add(16),\n944\t                        ic,\n945\t                        k2_r.as_ptr(),\n946\t                    );\n947\t                }\n948\t                eqb(&format!(\"xchacha20_xor_ic({len},{ic:#x},{si})\"), &xi_c, &xi_r);\n949\t                eqb(&format!(\"chacha20_xor_ic({len},{ic:#x},{si})\"), &ci_c, &ci_r);\n950\t                assert_eq!(xi_c, ci_c, \"xchacha20_xor_ic != chacha20_xor_ic on the subkey\");\n951\t            }\n952\t        }\n953\t    }\n954\t}\n955\t\n956\t// ============================================================ prefix / keygen\n957\t\n958\t#[test]\n959\tfn chacha20_family_prefix_consistency() {\n960\t    // 5.87 / 5.88\n961\t    prefix_consistency(\"crypto_stream_chacha20\", 8, 0x5_0087);\n962\t    prefix_consistency(\"crypto_stream_chacha20_ietf\", 12, 0x5_0088);\n963\t    prefix_consistency(\"crypto_stream_chacha20_ietf_ext\", 12, 0x5_0089);\n964\t    prefix_consistency(\"crypto_stream_xchacha20\", 24, 0x5_008a);\n965\t}\n966\t\n967\tfn keygen_check(name: &str) {\n968\t    let (c, r) = both::<Keygen>(name);\n969\t    let mut a = padded(32);\n970\t    let mut b = padded(32);\n971\t    rng_reset();\n972\t    unsafe {\n973\t        c(a.as_mut_ptr());\n974\t        r(b.as_mut_ptr());\n975\t    }\n976\t    eqb(name, &a, &b);\n977\t    check_pad(name, &a, 32);\n978\t    check_pad(name, &b, 32);\n979\t    assert!(a[..32].iter().any(|&x| x != 0), \"{name}: all-zero key\");\n980\t\n981\t    let mut a2 = padded(32);\n982\t    let mut b2 = padded(32);\n983\t    rng_reseed(0x0f1e_2d3c_4b5a_6978);\n984\t    unsafe {\n985\t        c(a2.as_mut_ptr());\n986\t        r(b2.as_mut_ptr());\n987\t    }\n988\t    eqb(&format!(\"{name} #2\"), &a2, &b2);\n989\t    check_pad(&format!(\"{name} #2\"), &a2, 32);\n990\t    assert_ne!(&a[..32], &a2[..32], \"{name}: keygen output is constant\");\n991\t    rng_reset();\n992\t}\n993\t\n994\t#[test]\n995\tfn chacha20_family_keygen() {\n996\t    keygen_check(\"crypto_stream_chacha20_keygen\"); // 5.58\n997\t    keygen_check(\"crypto_stream_chacha20_ietf_keygen\"); // 5.72\n998\t    keygen_check(\"crypto_stream_xchacha20_keygen\"); // 5.83\n999\t}\n1000\t\n1001\t// ================================================ implementation selection\n1002\t\n1003\t#[test]\n1004\tfn chacha20_pick_best_implementation_is_stable() {\n1005\t    // 5.89 / error row 5.27\n1006\t    type Pick = unsafe extern \"C\" fn() -> c_int;\n1007\t    let (cp, rp) = both::<Pick>(\"_crypto_stream_chacha20_pick_best_implementation\");\n1008\t    let (cs, rs) = both::<Stream>(\"crypto_stream_chacha20\");\n1009\t    let k = [0x11u8; 32];\n1010\t    let n = [0x22u8; 8];\n1011\t    let mut before_c = vec![0u8; 256];\n1012\t    let mut before_r = vec![0u8; 256];\n1013\t    unsafe {\n1014\t        cs(before_c.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n1015\t        rs(before_r.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n1016\t    }\n1017\t    eqb(\"chacha20 before pick\", &before_c, &before_r);\n1018\t    for _ in 0..3 {\n1019\t        let (rc, rr) = unsafe { (cp(), rp()) };\n1020\t        eqi(\"_crypto_stream_chacha20_pick_best_implementation\", rc, rr);\n1021\t        assert_eq!(rc, 0);\n1022\t        let mut after_c = vec![0u8; 256];\n1023\t        let mut after_r = vec![0u8; 256];\n1024\t        unsafe {\n1025\t            cs(after_c.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n1026\t            rs(after_r.as_mut_ptr(), 256, n.as_ptr(), k.as_ptr());\n1027\t        }\n1028\t        eqb(\"chacha20 after pick\", &after_c, &after_r);\n1029\t        assert_eq!(after_c, before_c, \"pick_best changed the output\");\n1030\t    }\n1031\t}\n1032\t\n1033\t// ============================================ length-limit error rows (guarded)\n1034\t\n1035\textern \"C\" {\n1036\t    fn mmap(\n1037\t        addr: *mut c_void,\n1038\t        len: usize,\n1039\t        prot: c_int,\n1040\t        flags: c_int,\n1041\t        fd: c_int,\n1042\t        off: i64,\n1043\t    ) -> *mut c_void;\n1044\t    fn mprotect(addr: *mut c_void, len: usize, prot: c_int) -> c_int;\n1045\t}\n1046\tconst PROT_NONE: c_int = 0;\n1047\tconst PROT_READ: c_int = 1;\n1048\tconst PROT_WRITE: c_int = 2;\n1049\tconst MAP_PRIVATE: c_int = 0x02;\n1050\tconst MAP_ANONYMOUS: c_int = 0x20;\n1051\tconst MAP_NORESERVE: c_int = 0x4000;\n1052\tconst GUARD_USABLE: usize = 1 << 20;\n1053\t\n1054\t/// A 1 MiB writable region immediately followed by a 1 MiB `PROT_NONE` guard.\n1055\t///\n1056\t/// Buffers of `> 2^38` bytes cannot be allocated, so the length-limit rows are\n1057\t/// exercised by handing in this bounded mapping together with an out-of-range\n1058\t/// length.  The `sodium_misuse()` check always happens *before* the first\n1059\t/// dereference (verified against the C source), so:\n1060\t///   * \"the check fired\"     → SIGABRT (`sig:6`)\n1061\t///   * \"the check did not fire\" → the implementation walks off the end of the\n1062\t///     mapping and dies with SIGSEGV (`sig:11`)\n1063\t/// and `eq_abort` pins C and Rust to the same outcome either way.\n1064\tfn guarded_region() -> *mut u8 {\n1065\t    unsafe {\n1066\t        let p = mmap(\n1067\t            core::ptr::null_mut(),\n1068\t            2 * GUARD_USABLE,\n1069\t            PROT_NONE,\n1070\t            MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE,\n1071\t            -1,\n1072\t            0,\n1073\t        );\n1074\t        assert!(p as isize != -1, \"mmap failed\");\n1075\t        assert_eq!(\n1076\t            mprotect(p, GUARD_USABLE, PROT_READ | PROT_WRITE),\n1077\t            0,\n1078\t            \"mprotect failed\"\n1079\t        );\n1080\t        p as *mut u8\n1081\t    }\n1082\t}\n1083\t\n1084\t/// Runs `f` on both libraries under `in_child` and returns the two statuses.\n1085\tfn outcomes<FC: FnOnce(), FR: FnOnce()>(what: &str, c: FC, r: FR) -> String {\n1086\t    let sc = status_str(in_child(c));\n1087\t    let sr = status_str(in_child(r));\n1088\t    assert_eq!(sc, sr, \"{what}: process outcome mismatch (C {sc}, Rust {sr})\");\n1089\t    sc\n1090\t}\n1091\t\n1092\tconst SIGABRT_STATUS: &str = \"sig:6\";\n1093\tconst SIGSEGV_STATUS: &str = \"sig:11\";\n1094\t\n1095\t#[test]\n1096\tfn chacha20_ietf_messagebytes_max_is_enforced() {\n1097\t    // Error rows 5.7 and 5.10 (both *reachable*): `_ietf` / `_ietf_xor` reject\n1098\t    // clen/mlen > 2^38 with sodium_misuse(); exactly 2^38 is accepted.\n1099\t    let p = guarded_region();\n1100\t    let k = [0x21u8; 32];\n1101\t    let n = [0x43u8; 12];\n1102\t    let (kp, np) = (k.as_ptr(), n.as_ptr());\n1103\t\n1104\t    let (ci, ri) = both::<Stream>(\"crypto_stream_chacha20_ietf\");\n1105\t    let s = outcomes(\n1106\t        \"crypto_stream_chacha20_ietf(clen=2^38+1)\",\n1107\t        || unsafe {\n1108\t            ci(p, IETF_MAX + 1, np, kp);\n1109\t        },\n1110\t        || unsafe {\n1111\t            ri(p, IETF_MAX + 1, np, kp);\n1112\t        },\n1113\t    );\n1114\t    assert_eq!(s, SIGABRT_STATUS, \"row 5.7: clen > 2^38 must abort\");\n1115\t\n1116\t    let (ci, ri) = both::<Stream>(\"crypto_stream_chacha20_ietf\");\n1117\t    let s = outcomes(\n1118\t        \"crypto_stream_chacha20_ietf(clen=2^38)\",\n1119\t        || unsafe {\n1120\t            ci(p, IETF_MAX, np, kp);\n1121\t        },\n1122\t        || unsafe {\n1123\t            ri(p, IETF_MAX, np, kp);\n1124\t        },\n1125\t    );\n1126\t    assert_eq!(s, SIGSEGV_STATUS, \"row 5.7: clen == 2^38 must be accepted\");\n1127\t\n1128\t    let (cx, rx) = both::<Xor>(\"crypto_stream_chacha20_ietf_xor\");\n1129\t    let s = outcomes(\n1130\t        \"crypto_stream_chacha20_ietf_xor(mlen=2^38+1)\",\n1131\t        || unsafe {\n1132\t            cx(p, p, IETF_MAX + 1, np, kp);\n1133\t        },\n1134\t        || unsafe {\n1135\t            rx(p, p, IETF_MAX + 1, np, kp);\n1136\t        },\n1137\t    );\n1138\t    assert_eq!(s, SIGABRT_STATUS, \"row 5.10: mlen > 2^38 must abort\");\n1139\t\n1140\t    let (cx, rx) = both::<Xor>(\"crypto_stream_chacha20_ietf_xor\");\n1141\t    let s = outcomes(\n1142\t        \"crypto_stream_chacha20_ietf_xor(mlen=2^38)\",\n1143\t        || unsafe {\n1144\t            cx(p, p, IETF_MAX, np, kp);\n1145\t        },\n1146\t        || unsafe {\n1147\t            rx(p, p, IETF_MAX, np, kp);\n1148\t        },\n1149\t    );\n1150\t    assert_eq!(s, SIGSEGV_STATUS, \"row 5.10: mlen == 2^38 must be accepted\");\n1151\t}\n1152\t\n1153\t#[test]\n1154\tfn chacha20_ietf_xor_ic_counter_guard_at_the_message_limit() {\n1155\t    // Error row 5.8, the `mlen == 2^38` corner: the limit becomes 0, so any\n1156\t    // ic >= 1 aborts while ic == 0 is accepted.\n1157\t    let p = guarded_region();\n1158\t    let k = [0x21u8; 32];\n1159\t    let n = [0x43u8; 12];\n1160\t    let (kp, np) = (k.as_ptr(), n.as_ptr());\n1161\t\n1162\t    let (c1, r1) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n1163\t    let s = outcomes(\n1164\t        \"ietf_xor_ic(mlen=2^38, ic=1)\",\n1165\t        || unsafe {\n1166\t            c1(p, p, IETF_MAX, np, 1, kp);\n1167\t        },\n1168\t        || unsafe {\n1169\t            r1(p, p, IETF_MAX, np, 1, kp);\n1170\t        },\n1171\t    );\n1172\t    assert_eq!(s, SIGABRT_STATUS, \"row 5.8: limit is 0 at mlen == 2^38\");\n1173\t\n1174\t    let (c0, r0) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n1175\t    let s = outcomes(\n1176\t        \"ietf_xor_ic(mlen=2^38, ic=0)\",\n1177\t        || unsafe {\n1178\t            c0(p, p, IETF_MAX, np, 0, kp);\n1179\t        },\n1180\t        || unsafe {\n1181\t            r0(p, p, IETF_MAX, np, 0, kp);\n1182\t        },\n1183\t    );\n1184\t    assert_eq!(s, SIGSEGV_STATUS, \"row 5.8: ic == 0 is accepted at mlen == 2^38\");\n1185\t}\n1186\t\n1187\t#[test]\n1188\tfn chacha20_ietf_xor_ic_guard_underflow_hole() {\n1189\t    // Error row 5.9: for mlen > 2^38 the RHS `2^32 - ceil(mlen/64)` underflows in\n1190\t    // unsigned long long, so the guard silently passes.  `_ietf_xor` at the very\n1191\t    // same length *does* abort — the asymmetry is the hole and must be preserved.\n1192\t    let p = guarded_region();\n1193\t    let k = [0x21u8; 32];\n1194\t    let n = [0x43u8; 12];\n1195\t    let (kp, np) = (k.as_ptr(), n.as_ptr());\n1196\t\n1197\t    for mlen in [IETF_MAX + 1, IETF_MAX + 64, IETF_MAX * 2] {\n1198\t        let (c, r) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_xor_ic\");\n1199\t        let s = outcomes(\n1200\t            &format!(\"ietf_xor_ic(mlen={mlen}, ic=0xFFFFFFFF) guard hole\"),\n1201\t            || unsafe {\n1202\t                c(p, p, mlen, np, 0xFFFF_FFFF, kp);\n1203\t            },\n1204\t            || unsafe {\n1205\t                r(p, p, mlen, np, 0xFFFF_FFFF, kp);\n1206\t            },\n1207\t        );\n1208\t        assert_eq!(\n1209\t            s, SIGSEGV_STATUS,\n1210\t            \"row 5.9: the underflowed guard must NOT abort at mlen={mlen}\"\n1211\t        );\n1212\t\n1213\t        let (cx, rx) = both::<Xor>(\"crypto_stream_chacha20_ietf_xor\");\n1214\t        let s2 = outcomes(\n1215\t            &format!(\"ietf_xor(mlen={mlen})\"),\n1216\t            || unsafe {\n1217\t                cx(p, p, mlen, np, kp);\n1218\t            },\n1219\t            || unsafe {\n1220\t                rx(p, p, mlen, np, kp);\n1221\t            },\n1222\t        );\n1223\t        assert_eq!(s2, SIGABRT_STATUS);\n1224\t        assert_ne!(\n1225\t            s, s2,\n1226\t            \"row 5.9: _ietf_xor_ic must be more permissive than _ietf_xor\"\n1227\t        );\n1228\t    }\n1229\t}\n1230\t\n1231\t#[test]\n1232\tfn chacha20_ietf_ext_ignores_the_ietf_limit() {\n1233\t    // Error rows 5.4 / 5.5 / 5.15: the `_ext` entry points deliberately check the\n1234\t    // *non*-ietf maximum (UINT64_MAX, a dead branch on LP64), so they accept\n1235\t    // clen/mlen far beyond 2^38 and let the 32-bit counter overflow into the IV.\n1236\t    let p = guarded_region();\n1237\t    let k = [0x21u8; 32];\n1238\t    let n = [0x43u8; 12];\n1239\t    let (kp, np) = (k.as_ptr(), n.as_ptr());\n1240\t\n1241\t    let (ce, re) = both::<Stream>(\"crypto_stream_chacha20_ietf_ext\");\n1242\t    let s = outcomes(\n1243\t        \"crypto_stream_chacha20_ietf_ext(clen=2^38+1)\",\n1244\t        || unsafe {\n1245\t            ce(p, IETF_MAX + 1, np, kp);\n1246\t        },\n1247\t        || unsafe {\n1248\t            re(p, IETF_MAX + 1, np, kp);\n1249\t        },\n1250\t    );\n1251\t    assert_eq!(s, SIGSEGV_STATUS, \"row 5.4: _ietf_ext must not enforce 2^38\");\n1252\t\n1253\t    let (cei, rei) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_ext_xor_ic\");\n1254\t    let s = outcomes(\n1255\t        \"crypto_stream_chacha20_ietf_ext_xor_ic(mlen=2^38+1, ic=0xFFFFFFFF)\",\n1256\t        || unsafe {\n1257\t            cei(p, p, IETF_MAX + 1, np, 0xFFFF_FFFF, kp);\n1258\t        },\n1259\t        || unsafe {\n1260\t            rei(p, p, IETF_MAX + 1, np, 0xFFFF_FFFF, kp);\n1261\t        },\n1262\t    );\n1263\t    assert_eq!(s, SIGSEGV_STATUS, \"row 5.5: _ietf_ext_xor_ic has no effective check\");\n1264\t}\n1265\t\n1266\t#[test]\n1267\tfn chacha20_original_and_xchacha20_accept_the_maximum_length() {\n1268\t    // Error rows 5.1, 5.2, 5.3, 5.6, 5.11, 5.12: the `> UINT64_MAX` comparisons\n1269\t    // are dead branches on LP64.  Feeding the largest representable length shows\n1270\t    // that no misuse fires — the call just runs off the end of the mapping.\n1271\t    let p = guarded_region();\n1272\t    let k = [0x21u8; 32];\n1273\t    let n = [0x43u8; 24];\n1274\t    let (kp, np8, np24) = (k.as_ptr(), n.as_ptr(), n.as_ptr());\n1275\t\n1276\t    // keystream forms: use 2^38+1 rather than UINT64_MAX so that the internal\n1277\t    // memset() stays a plain forward walk off the end of the mapping.\n1278\t    for name in [\"crypto_stream_chacha20\", \"crypto_stream_xchacha20\"] {\n1279\t        let (c, r) = both::<Stream>(name);\n1280\t        let np = if name.contains(\"xchacha\") { np24 } else { np8 };\n1281\t        let s = outcomes(\n1282\t            &format!(\"{name}(clen=2^38+1)\"),\n1283\t            || unsafe {\n1284\t                c(p, IETF_MAX + 1, np, kp);\n1285\t            },\n1286\t            || unsafe {\n1287\t                r(p, IETF_MAX + 1, np, kp);\n1288\t            },\n1289\t        );\n1290\t        assert_eq!(s, SIGSEGV_STATUS, \"{name}: no length check may fire\");\n1291\t    }\n1292\t\n1293\t    for name in [\n1294\t        \"crypto_stream_chacha20_xor\",\n1295\t        \"crypto_stream_xchacha20_xor\",\n1296\t    ] {\n1297\t        let np = if name.contains(\"xchacha\") { np24 } else { np8 };\n1298\t        for mlen in [IETF_MAX + 1, u64::MAX] {\n1299\t            let (c, r) = both::<Xor>(name);\n1300\t            let s = outcomes(\n1301\t                &format!(\"{name}(mlen={mlen})\"),\n1302\t                || unsafe {\n1303\t                    c(p, p, mlen, np, kp);\n1304\t                },\n1305\t                || unsafe {\n1306\t                    r(p, p, mlen, np, kp);\n1307\t                },\n1308\t            );\n1309\t            assert_eq!(s, SIGSEGV_STATUS, \"{name}: no length check may fire\");\n1310\t        }\n1311\t    }\n1312\t\n1313\t    for name in [\n1314\t        \"crypto_stream_chacha20_xor_ic\",\n1315\t        \"crypto_stream_xchacha20_xor_ic\",\n1316\t    ] {\n1317\t        let (c, r) = both::<XorIc64>(name);\n1318\t        let np = if name.contains(\"xchacha\") { np24 } else { np8 };\n1319\t        let s = outcomes(\n1320\t            &format!(\"{name}(mlen=UINT64_MAX)\"),\n1321\t            || unsafe {\n1322\t                c(p, p, u64::MAX, np, u64::MAX, kp);\n1323\t            },\n1324\t            || unsafe {\n1325\t                r(p, p, u64::MAX, np, u64::MAX, kp);\n1326\t            },\n1327\t        );\n1328\t        assert_eq!(s, SIGSEGV_STATUS, \"{name}: no length check may fire\");\n1329\t    }\n1330\t}\n1331\t\n1332\t#[test]\n1333\tfn chacha20_family_zero_length_with_null_pointers() {\n1334\t    // Error rows 5.23 / 5.28 (benign sub-case): every implementation\n1335\t    // short-circuits on a zero length before dereferencing `m` or `c`.\n1336\t    let k = [1u8; 32];\n1337\t    let n = [2u8; 24];\n1338\t    for (name, nb) in [\n1339\t        (\"crypto_stream_chacha20\", 8usize),\n1340\t        (\"crypto_stream_chacha20_ietf\", 12),\n1341\t        (\"crypto_stream_chacha20_ietf_ext\", 12),\n1342\t        (\"crypto_stream_xchacha20\", 24),\n1343\t    ] {\n1344\t        let (c, r) = both::<Stream>(name);\n1345\t        let (rc, rr) = unsafe {\n1346\t            (\n1347\t                c(core::ptr::null_mut(), 0, n[..nb].as_ptr(), k.as_ptr()),\n1348\t                r(core::ptr::null_mut(), 0, n[..nb].as_ptr(), k.as_ptr()),\n1349\t            )\n1350\t        };\n1351\t        eqi(&format!(\"{name}(NULL,0)\"), rc, rr);\n1352\t        assert_eq!(rc, 0);\n1353\t    }\n1354\t    for (name, nb) in [\n1355\t        (\"crypto_stream_chacha20_xor\", 8usize),\n1356\t        (\"crypto_stream_chacha20_ietf_xor\", 12),\n1357\t        (\"crypto_stream_xchacha20_xor\", 24),\n1358\t    ] {\n1359\t        let (c, r) = both::<Xor>(name);\n1360\t        let (rc, rr) = unsafe {\n1361\t            (\n1362\t                c(core::ptr::null_mut(), core::ptr::null(), 0, n[..nb].as_ptr(), k.as_ptr()),\n1363\t                r(core::ptr::null_mut(), core::ptr::null(), 0, n[..nb].as_ptr(), k.as_ptr()),\n1364\t            )\n1365\t        };\n1366\t        eqi(&format!(\"{name}(NULL,0)\"), rc, rr);\n1367\t        assert_eq!(rc, 0);\n1368\t    }\n1369\t    let (c, r) = both::<XorIc32>(\"crypto_stream_chacha20_ietf_ext_xor_ic\");\n1370\t    let (rc, rr) = unsafe {\n1371\t        (\n1372\t            c(\n1373\t                core::ptr::null_mut(),\n1374\t                core::ptr::null(),\n1375\t                0,\n1376\t                n[..12].as_ptr(),\n1377\t                0xFFFF_FFFF,\n1378\t                k.as_ptr(),\n1379\t            ),\n1380\t            r(\n1381\t                core::ptr::null_mut(),\n1382\t                core::ptr::null(),\n1383\t                0,\n1384\t                n[..12].as_ptr(),\n1385\t                0xFFFF_FFFF,\n1386\t                k.as_ptr(),\n1387\t            ),\n1388\t        )\n1389\t    };\n1390\t    eqi(\"ietf_ext_xor_ic(NULL,0)\", rc, rr);\n1391\t    assert_eq!(rc, 0);\n1392\t}\n1393\t\n1394\t#[test]\n1395\tfn chacha20_partial_block_path_never_overwrites() {\n1396\t    // Error row 5.29: the `bytes < 64` tail is staged through a zero-filled\n1397\t    // `tmp[64]` and only `bytes` bytes are copied back; `bytes == 64` exactly\n1398\t    // takes the direct path.  Poisoned tails pin both behaviours.\n1399\t    let (cx, rx) = both::<Xor>(\"crypto_stream_chacha20_xor\");\n1400\t    let mut rng = Rng::new(0x5_0029);\n1401\t    for len in 0..=200usize {\n1402\t        let k = rng.bytes(32);\n1403\t        let n = rng.bytes(8);\n1404\t        let m = rng.bytes(len);\n1405\t        let mut a = padded(len);\n1406\t        let mut b = padded(len);\n1407\t        unsafe {\n1408\t            cx(a.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n1409\t            rx(b.as_mut_ptr(), m.as_ptr(), len as u64, n.as_ptr(), k.as_ptr());\n1410\t        }\n1411\t        eqb(&format!(\"chacha20_xor tail(len={len})\"), &a, &b);\n1412\t        check_pad(&format!(\"chacha20_xor tail(len={len})\"), &a, len);\n1413\t        check_pad(&format!(\"chacha20_xor tail(len={len})\"), &b, len);\n1414\t    }\n1415\t}\n1416\t"}]},"parent_tool_use_id":"toolu_bdrk_01Mg9c7SwjKFkZZ5pEGe5Fn1","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"e28473f2-b001-4113-9ed6-c89c1fad6abd","timestamp":"2026-08-31T04:08:53.323Z","subagent_type":"general-purpose","task_description":"Finish area 5 bookkeeping+gaps"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HMueLADTYuij2PqnRRcwSt","type":"tool_result","content":"1\t//! Area 2, part 4 — `crypto_core/ed25519/core_ristretto255.c` and the\n2\t//! `ristretto255_*` internals of `ref10/ed25519_ref10.c`.\n3\t//!\n4\t//! Covers `configs_2.md` rows 2.104 - 2.127 (ristretto half) and `errors_2.md`\n5\t//! rows 2.12 - 2.17 and 2.44 - 2.52.\n6\tmod common;\n7\tuse common::*;\n8\tuse std::ffi::c_int;\n9\t\n10\t// ------------------------------------------------------------------ constants\n11\t\n12\t/// `L = 2^252 + 27742317777372353535851937790883648493`, little-endian.\n13\tconst L: [u8; 32] = [\n14\t    0xed, 0xd3, 0xf5, 0x5c, 0x1a, 0x63, 0x12, 0x58, 0xd6, 0x9c, 0xf7, 0xa2, 0xde, 0xf9, 0xde, 0x14,\n15\t    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10,\n16\t];\n17\t\n18\tfn l_minus_one() -> [u8; 32] {\n19\t    let mut v = L;\n20\t    v[0] = 0xec;\n21\t    v\n22\t}\n23\tfn zero32() -> [u8; 32] {\n24\t    [0u8; 32]\n25\t}\n26\tfn one32() -> [u8; 32] {\n27\t    let mut v = [0u8; 32];\n28\t    v[0] = 1;\n29\t    v\n30\t}\n31\t\n32\t/// The ristretto255 identity is the all-zero encoding.\n33\tconst RIST_IDENTITY: [u8; 32] = [0u8; 32];\n34\t\n35\t/// The ristretto255 base point encoding (RFC 9496).\n36\tconst RIST_BASEPOINT: [u8; 32] = [\n37\t    0xe2, 0xf2, 0xae, 0x0a, 0x6a, 0xbc, 0x4e, 0x71, 0xa8, 0x84, 0xa9, 0x61, 0xc5, 0x00, 0x51, 0x5f,\n38\t    0x58, 0xe3, 0x0b, 0x6a, 0xa5, 0x82, 0xdd, 0x8d, 0xb6, 0xa6, 0x59, 0x45, 0xe0, 0x8d, 0x2d, 0x76,\n39\t];\n40\t\n41\t/// `p - 1 = 2^255 - 20`: canonical, even, but makes `1 - s^2 == 0`, so\n42\t/// `ristretto255_frombytes` rejects it through the `iszero(h->Y)` arm\n43\t/// (`errors_2.md` row 2.16).\n44\tfn p_minus_one() -> [u8; 32] {\n45\t    let mut v = [0xffu8; 32];\n46\t    v[0] = 0xec;\n47\t    v[31] = 0x7f;\n48\t    v\n49\t}\n50\t\n51\t// --------------------------------------------------------------- FFI typedefs\n52\t\n53\ttype Getter = unsafe extern \"C\" fn() -> usize;\n54\ttype Fn1 = unsafe extern \"C\" fn(*mut u8);\n55\ttype Fn2 = unsafe extern \"C\" fn(*mut u8, *const u8);\n56\ttype Fn2i = unsafe extern \"C\" fn(*mut u8, *const u8) -> c_int;\n57\ttype Fn3 = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8);\n58\ttype Fn3i = unsafe extern \"C\" fn(*mut u8, *const u8, *const u8) -> c_int;\n59\ttype Pred = unsafe extern \"C\" fn(*const u8) -> c_int;\n60\ttype FromString =\n61\t    unsafe extern \"C\" fn(*mut u8, *const u8, usize, *const u8, usize, c_int) -> c_int;\n62\t\n63\t#[repr(C)]\n64\t#[derive(Copy, Clone)]\n65\tstruct P3([i32; 40]);\n66\timpl P3 {\n67\t    fn new() -> P3 {\n68\t        P3([0x5A5A5A5A; 40])\n69\t    }\n70\t    fn bytes(&self) -> Vec<u8> {\n71\t        self.0.iter().flat_map(|w| w.to_le_bytes()).collect()\n72\t    }\n73\t}\n74\ttype RistFromBytes = unsafe extern \"C\" fn(*mut P3, *const u8) -> c_int;\n75\ttype RistToBytes = unsafe extern \"C\" fn(*mut u8, *const P3);\n76\ttype GePred = unsafe extern \"C\" fn(*const P3) -> c_int;\n77\t\n78\t// ------------------------------------------------------------------- helpers\n79\t\n80\t/// Every 32-byte encoding shape that matters for `ristretto255_frombytes`.\n81\tfn rist_encodings(seed: u64) -> Vec<[u8; 32]> {\n82\t    let mut v: Vec<[u8; 32]> = vec![RIST_IDENTITY, RIST_BASEPOINT, p_minus_one()];\n83\t    // s[0] odd  -> rejected (errors_2 row 2.12, `s[0] & 1`)\n84\t    {\n85\t        let mut a = RIST_BASEPOINT;\n86\t        a[0] |= 1;\n87\t        v.push(a);\n88\t        v.push(one32());\n89\t    }\n90\t    // bit 255 set -> rejected (`e` term)\n91\t    {\n92\t        let mut a = RIST_BASEPOINT;\n93\t        a[31] |= 0x80;\n94\t        v.push(a);\n95\t        let mut b = RIST_IDENTITY;\n96\t        b[31] = 0x80;\n97\t        v.push(b);\n98\t    }\n99\t    // s >= 2^255-19 -> rejected (`c & d`)\n100\t    for first in [0xecu8, 0xed, 0xee, 0xf0, 0xfe] {\n101\t        let mut a = [0xffu8; 32];\n102\t        a[0] = first;\n103\t        a[31] = 0x7f;\n104\t        v.push(a);\n105\t        let mut b = a;\n106\t        b[31] = 0xff;\n107\t        v.push(b);\n108\t    }\n109\t    v.push([0xffu8; 32]);\n110\t    // small even values\n111\t    for x in 0u8..64 {\n112\t        let mut a = [0u8; 32];\n113\t        a[0] = x * 2;\n114\t        v.push(a);\n115\t    }\n116\t    let mut rng = Rng::new(seed);\n117\t    for _ in 0..400 {\n118\t        v.push(rng.bytes(32).try_into().unwrap());\n119\t    }\n120\t    // random strings forced through the canonicity gate, so field work runs\n121\t    for _ in 0..1200 {\n122\t        let mut a: [u8; 32] = rng.bytes(32).try_into().unwrap();\n123\t        a[0] &= 0xfe;\n124\t        a[31] &= 0x7f;\n125\t        v.push(a);\n126\t    }\n127\t    v\n128\t}\n129\t\n130\t/// A pool of genuinely valid ristretto255 encodings, produced by `from_hash`.\n131\tfn valid_points(n: usize, seed: u64) -> Vec<[u8; 32]> {\n132\t    let (fh, _) = both::<Fn2i>(\"crypto_core_ristretto255_from_hash\");\n133\t    let mut rng = Rng::new(seed);\n134\t    let mut v: Vec<[u8; 32]> = vec![RIST_IDENTITY, RIST_BASEPOINT];\n135\t    for _ in 0..n {\n136\t        let h = rng.bytes(64);\n137\t        let mut o = [0u8; 32];\n138\t        assert_eq!(unsafe { fh(o.as_mut_ptr(), h.as_ptr()) }, 0);\n139\t        v.push(o);\n140\t    }\n141\t    v\n142\t}\n143\t\n144\tfn scalar_pool(seed: u64) -> Vec<[u8; 32]> {\n145\t    let mut v: Vec<[u8; 32]> = vec![zero32(), one32(), L, l_minus_one(), [0xffu8; 32]];\n146\t    let mut rng = Rng::new(seed);\n147\t    for _ in 0..150 {\n148\t        let mut a: [u8; 32] = rng.bytes(32).try_into().unwrap();\n149\t        a[31] &= 0x0f;\n150\t        v.push(a);\n151\t    }\n152\t    for _ in 0..150 {\n153\t        v.push(rng.bytes(32).try_into().unwrap());\n154\t    }\n155\t    v\n156\t}\n157\t\n158\t// -------------------------------------------------------------------- getters\n159\t\n160\t/// Row 2.127 (ristretto half).\n161\t#[test]\n162\tfn ristretto255_getters() {\n163\t    for (name, want) in [\n164\t        (\"crypto_core_ristretto255_bytes\", 32usize),\n165\t        (\"crypto_core_ristretto255_hashbytes\", 64),\n166\t        (\"crypto_core_ristretto255_scalarbytes\", 32),\n167\t        (\"crypto_core_ristretto255_nonreducedscalarbytes\", 64),\n168\t    ] {\n169\t        assert!(has(name), \"{name} must be exported by both libraries\");\n170\t        let (c, r) = both::<Getter>(name);\n171\t        let (vc, vr) = unsafe { (c(), r()) };\n172\t        assert_eq!(vc, vr, \"{name}: C {vc} vs Rust {vr}\");\n173\t        assert_eq!(vc, want, \"{name}: C returned {vc}, header says {want}\");\n174\t    }\n175\t}\n176\t\n177\t// -------------------------------------------------------- frombytes / is_valid\n178\t\n179\t/// Rows 2.104 - 2.106 and error rows 2.12 - 2.17 / 2.44.\n180\t#[test]\n181\tfn ristretto255_is_valid_point() {\n182\t    let (c, r) = both::<Pred>(\"crypto_core_ristretto255_is_valid_point\");\n183\t    assert!(has(\"_sodium_ristretto255_frombytes\"));\n184\t    let (cfb, rfb) = both::<RistFromBytes>(\"_sodium_ristretto255_frombytes\");\n185\t    let (ctb, rtb) = both::<RistToBytes>(\"_sodium_ristretto255_p3_tobytes\");\n186\t    let (onc, _) = both::<GePred>(\"_sodium_ge25519_is_on_curve\");\n187\t\n188\t    // 2.104 / 2.105: the identity and the base point are valid\n189\t    assert_eq!(unsafe { c(RIST_IDENTITY.as_ptr()) }, 1, \"the all-zero identity must be valid\");\n190\t    assert_eq!(unsafe { r(RIST_IDENTITY.as_ptr()) }, 1);\n191\t    assert_eq!(unsafe { c(RIST_BASEPOINT.as_ptr()) }, 1, \"the base point must be valid\");\n192\t    assert_eq!(unsafe { r(RIST_BASEPOINT.as_ptr()) }, 1);\n193\t\n194\t    // error row 2.12: the three independent canonicity rejections\n195\t    for (label, s) in [\n196\t        (\"s[0] odd\", {\n197\t            let mut a = RIST_BASEPOINT;\n198\t            a[0] |= 1;\n199\t            a\n200\t        }),\n201\t        (\"bit 255 set\", {\n202\t            let mut a = RIST_BASEPOINT;\n203\t            a[31] |= 0x80;\n204\t            a\n205\t        }),\n206\t        (\"s >= p\", {\n207\t            let mut a = [0xffu8; 32];\n208\t            a[0] = 0xee;\n209\t            a[31] = 0x7f;\n210\t            a\n211\t        }),\n212\t        (\"all-0xff\", [0xffu8; 32]),\n213\t    ] {\n214\t        let (a, b) = unsafe { (c(s.as_ptr()), r(s.as_ptr())) };\n215\t        eqi(&format!(\"is_valid_point [{label}]\"), a, b);\n216\t        assert_eq!(a, 0, \"is_valid_point [{label}] must reject\");\n217\t    }\n218\t    // error row 2.16: p - 1 is canonical but decodes to Y == 0\n219\t    {\n220\t        let s = p_minus_one();\n221\t        let (a, b) = unsafe { (c(s.as_ptr()), r(s.as_ptr())) };\n222\t        eqi(\"is_valid_point [p-1]\", a, b);\n223\t        assert_eq!(a, 0, \"p-1 must be rejected (Y == 0)\");\n224\t    }\n225\t\n226\t    // the full sweep, cross-checked against the private decoder\n227\t    let mut n_ok = 0usize;\n228\t    let mut n_bad = 0usize;\n229\t    for s in rist_encodings(0x2_0104) {\n230\t        let (a, b) = unsafe { (c(s.as_ptr()), r(s.as_ptr())) };\n231\t        eqi(&format!(\"ristretto255_is_valid_point({})\", hex(&s)), a, b);\n232\t        let mut pc = P3::new();\n233\t        let mut pr = P3::new();\n234\t        let (rc, rr2) = unsafe { (cfb(&mut pc, s.as_ptr()), rfb(&mut pr, s.as_ptr())) };\n235\t        eqi(&format!(\"ristretto255_frombytes({})\", hex(&s)), rc, rr2);\n236\t        assert_eq!(a, if rc == 0 { 1 } else { 0 }, \"wrapper disagrees with frombytes\");\n237\t        assert!(rc == 0 || rc == -1, \"ristretto255_frombytes must return 0 or -1\");\n238\t        if rc == 0 {\n239\t            n_ok += 1;\n240\t            eqb(\"ristretto255_frombytes p3\", &pc.bytes(), &pr.bytes());\n241\t            assert_eq!(unsafe { onc(&pc) }, 1, \"decoded ristretto point is not on the curve\");\n242\t            // 2.114: re-encoding must reproduce the input exactly\n243\t            let mut ec = padded(32);\n244\t            let mut er = padded(32);\n245\t            unsafe {\n246\t                ctb(ec.as_mut_ptr(), &pc);\n247\t                rtb(er.as_mut_ptr(), &pr);\n248\t            }\n249\t            eqb(\"ristretto255_p3_tobytes\", &ec[..32], &er[..32]);\n250\t            check_pad(\"ristretto255_p3_tobytes(C)\", &ec, 32);\n251\t            check_pad(\"ristretto255_p3_tobytes(Rust)\", &er, 32);\n252\t            assert_eq!(&ec[..32], &s[..], \"ristretto255 encode/decode is not a bijection\");\n253\t        } else {\n254\t            n_bad += 1;\n255\t        }\n256\t    }\n257\t    assert!(n_ok > 50 && n_bad > 50, \"coverage: {n_ok} accepted, {n_bad} rejected\");\n258\t\n259\t    // 2.106: `_random` and `_from_hash` output is always valid\n260\t    let (crand, rrand) = both::<Fn1>(\"crypto_core_ristretto255_random\");\n261\t    for i in 0..200u64 {\n262\t        let seed = 0x0bad_c0de_0000_0001u64 ^ (i.wrapping_mul(0x9E37_79B9) | 1);\n263\t        rng_reseed(seed);\n264\t        let mut oc = padded(32);\n265\t        unsafe { crand(oc.as_mut_ptr()) };\n266\t        rng_reseed(seed);\n267\t        let mut or = padded(32);\n268\t        unsafe { rrand(or.as_mut_ptr()) };\n269\t        eqb(\"crypto_core_ristretto255_random\", &oc[..32], &or[..32]);\n270\t        check_pad(\"ristretto255_random(C)\", &oc, 32);\n271\t        check_pad(\"ristretto255_random(Rust)\", &or, 32);\n272\t        assert_eq!(unsafe { c(oc.as_ptr()) }, 1, \"random() produced an invalid point\");\n273\t    }\n274\t    rng_reset();\n275\t    for p in valid_points(200, 0x2_0106) {\n276\t        assert_eq!(unsafe { c(p.as_ptr()) }, 1);\n277\t        assert_eq!(unsafe { r(p.as_ptr()) }, 1);\n278\t    }\n279\t}\n280\t\n281\t// ----------------------------------------------------------------- from_hash\n282\t\n283\t/// Rows 2.111 - 2.113 and 2.115.\n284\t#[test]\n285\tfn ristretto255_from_hash() {\n286\t    let (c, r) = both::<Fn2i>(\"crypto_core_ristretto255_from_hash\");\n287\t    let (cp, rp) = both::<Fn2>(\"_sodium_ristretto255_from_hash\");\n288\t    let (valid, _) = both::<Pred>(\"crypto_core_ristretto255_is_valid_point\");\n289\t\n290\t    let mut inputs: Vec<[u8; 64]> = vec![[0u8; 64], [0xffu8; 64]];\n291\t    // bit 255 of each half is ignored by fe25519_frombytes\n292\t    for a in [0x00u8, 0x80] {\n293\t        for b in [0x00u8, 0x80] {\n294\t            let mut v = [0x5cu8; 64];\n295\t            v[31] = a;\n296\t            v[63] = b;\n297\t            inputs.push(v);\n298\t        }\n299\t    }\n300\t    for i in 0..64 * 8 {\n301\t        let mut v = [0u8; 64];\n302\t        v[i / 8] = 1u8 << (i % 8);\n303\t        inputs.push(v);\n304\t    }\n305\t    let mut rng = Rng::new(0x2_0111);\n306\t    for _ in 0..1500 {\n307\t        inputs.push(rng.bytes(64).try_into().unwrap());\n308\t    }\n309\t\n310\t    let mut seen: std::collections::HashSet<Vec<u8>> = std::collections::HashSet::new();\n311\t    for h in &inputs {\n312\t        let mut oc = padded(32);\n313\t        let mut or = padded(32);\n314\t        set_errno(0);\n315\t        let rc = unsafe { c(oc.as_mut_ptr(), h.as_ptr()) };\n316\t        let ec = errno();\n317\t        set_errno(0);\n318\t        let rr2 = unsafe { r(or.as_mut_ptr(), h.as_ptr()) };\n319\t        let er = errno();\n320\t        eqi(\"ristretto255_from_hash ret\", rc, rr2);\n321\t        assert_eq!(rc, 0, \"crypto_core_ristretto255_from_hash always returns 0\");\n322\t        assert_eq!(ec, er);\n323\t        eqb(&format!(\"ristretto255_from_hash({})\", hex(&h[..8])), &oc[..32], &or[..32]);\n324\t        check_pad(\"from_hash(C)\", &oc, 32);\n325\t        check_pad(\"from_hash(Rust)\", &or, 32);\n326\t        assert_eq!(unsafe { valid(oc.as_ptr()) }, 1, \"from_hash output must be valid\");\n327\t        seen.insert(oc[..32].to_vec());\n328\t\n329\t        // the public wrapper is `ristretto255_from_hash` verbatim\n330\t        let mut pc = padded(32);\n331\t        let mut pr = padded(32);\n332\t        unsafe {\n333\t            cp(pc.as_mut_ptr(), h.as_ptr());\n334\t            rp(pr.as_mut_ptr(), h.as_ptr());\n335\t        }\n336\t        eqb(\"_sodium_ristretto255_from_hash\", &pc[..32], &pr[..32]);\n337\t        assert_eq!(&pc[..32], &oc[..32]);\n338\t\n339\t        // flipping the ignored high bit of either half must not change anything\n340\t        let mut h2 = *h;\n341\t        h2[31] ^= 0x80;\n342\t        h2[63] ^= 0x80;\n343\t        let mut qc = [0u8; 32];\n344\t        unsafe { c(qc.as_mut_ptr(), h2.as_ptr()) };\n345\t        assert_eq!(&qc[..], &oc[..32], \"bit 255 of each half must be ignored\");\n346\t    }\n347\t    // 2.112: the all-zero input maps to the identity (t = 0 in both halves)\n348\t    {\n349\t        let mut o = [0u8; 32];\n350\t        assert_eq!(unsafe { c(o.as_mut_ptr(), [0u8; 64].as_ptr()) }, 0);\n351\t        assert_eq!(unsafe { valid(o.as_ptr()) }, 1);\n352\t    }\n353\t    assert!(seen.len() > 500, \"from_hash outputs are suspiciously repetitive\");\n354\t}\n355\t\n356\t// ------------------------------------------------------------------ add / sub\n357\t\n358\t/// Rows 2.107 - 2.110 and error rows 2.45 - 2.48.\n359\t#[test]\n360\tfn ristretto255_add_and_sub() {\n361\t    let (ca, ra) = both::<Fn3i>(\"crypto_core_ristretto255_add\");\n362\t    let (cs, rs) = both::<Fn3i>(\"crypto_core_ristretto255_sub\");\n363\t    let (valid, _) = both::<Pred>(\"crypto_core_ristretto255_is_valid_point\");\n364\t\n365\t    let run = |c: &Fn3i, r: &Fn3i, p: &[u8; 32], q: &[u8; 32], label: &str| -> (c_int, Vec<u8>) {\n366\t        let mut oc = padded(32);\n367\t        let mut or = padded(32);\n368\t        set_errno(0);\n369\t        let rc = unsafe { c(oc.as_mut_ptr(), p.as_ptr(), q.as_ptr()) };\n370\t        let ec = errno();\n371\t        set_errno(0);\n372\t        let rr2 = unsafe { r(or.as_mut_ptr(), p.as_ptr(), q.as_ptr()) };\n373\t        let er = errno();\n374\t        eqi(&format!(\"{label} ret ({}, {})\", hex(p), hex(q)), rc, rr2);\n375\t        assert_eq!(ec, er, \"{label} errno\");\n376\t        if rc == 0 {\n377\t            eqb(&format!(\"{label} out\"), &oc[..32], &or[..32]);\n378\t        }\n379\t        check_pad(&format!(\"{label}(C)\"), &oc, 32);\n380\t        check_pad(&format!(\"{label}(Rust)\"), &or, 32);\n381\t        (rc, oc[..32].to_vec())\n382\t    };\n383\t\n384\t    let good = valid_points(40, 0x2_0107);\n385\t    let mut bad: Vec<[u8; 32]> = vec![\n386\t        {\n387\t            let mut a = RIST_BASEPOINT;\n388\t            a[0] |= 1;\n389\t            a\n390\t        },\n391\t        {\n392\t            let mut a = RIST_BASEPOINT;\n393\t            a[31] |= 0x80;\n394\t            a\n395\t        },\n396\t        [0xffu8; 32],\n397\t        p_minus_one(),\n398\t    ];\n399\t    let mut rng = Rng::new(0x2_0108);\n400\t    while bad.len() < 12 {\n401\t        let s: [u8; 32] = rng.bytes(32).try_into().unwrap();\n402\t        if unsafe { valid(s.as_ptr()) } == 0 {\n403\t            bad.push(s);\n404\t        }\n405\t    }\n406\t\n407\t    // 2.108 / 2.110: identity is neutral\n408\t    for p in &good {\n409\t        let (rc, o) = run(&ca, &ra, p, &RIST_IDENTITY, \"rist_add(P, 0)\");\n410\t        assert_eq!(rc, 0);\n411\t        assert_eq!(&o[..], &p[..], \"P + identity != P\");\n412\t        let (rc, o) = run(&cs, &rs, p, &RIST_IDENTITY, \"rist_sub(P, 0)\");\n413\t        assert_eq!(rc, 0);\n414\t        assert_eq!(&o[..], &p[..], \"P - identity != P\");\n415\t        // 2.109: P - P == identity\n416\t        let (rc, o) = run(&cs, &rs, p, p, \"rist_sub(P, P)\");\n417\t        assert_eq!(rc, 0);\n418\t        assert_eq!(&o[..], &RIST_IDENTITY[..], \"P - P != identity\");\n419\t    }\n420\t\n421\t    // 2.107 / 2.109 plus every rejection combination (errors 2.45 - 2.48)\n422\t    let mut pool: Vec<[u8; 32]> = good.clone();\n423\t    pool.extend(bad.iter().cloned());\n424\t    let mut n_ok = 0usize;\n425\t    let mut n_fail = 0usize;\n426\t    for p in &pool {\n427\t        for q in &pool {\n428\t            let pv = unsafe { valid(p.as_ptr()) } == 1;\n429\t            let qv = unsafe { valid(q.as_ptr()) } == 1;\n430\t            let want = if pv && qv { 0 } else { -1 };\n431\t            let (rca, oa) = run(&ca, &ra, p, q, \"rist_add\");\n432\t            let (rcs, os) = run(&cs, &rs, p, q, \"rist_sub\");\n433\t            assert_eq!(rca, want, \"rist_add({}, {}) sentinel\", hex(p), hex(q));\n434\t            assert_eq!(rcs, want, \"rist_sub({}, {}) sentinel\", hex(p), hex(q));\n435\t            if want == 0 {\n436\t                n_ok += 1;\n437\t                assert_eq!(unsafe { valid(oa.as_ptr()) }, 1);\n438\t                assert_eq!(unsafe { valid(os.as_ptr()) }, 1);\n439\t                // commutativity of add, and (p+q)-q == p\n440\t                let (_, ob) = run(&ca, &ra, q, p, \"rist_add(swapped)\");\n441\t                assert_eq!(oa, ob, \"ristretto255_add is not commutative\");\n442\t                let arr: [u8; 32] = oa.clone().try_into().unwrap();\n443\t                let (rc, back) = run(&cs, &rs, &arr, q, \"rist_sub(roundtrip)\");\n444\t                assert_eq!(rc, 0);\n445\t                assert_eq!(&back[..], &p[..], \"(p+q)-q != p\");\n446\t            } else {\n447\t                n_fail += 1;\n448\t            }\n449\t        }\n450\t    }\n451\t    assert!(n_ok > 100 && n_fail > 100, \"coverage: {n_ok} / {n_fail}\");\n452\t}\n453\t\n454\t// ---------------------------------------------------------------- from_string\n455\t\n456\tfn h2c_strings(rng: &mut Rng) -> Vec<Vec<u8>> {\n457\t    let mut v: Vec<Vec<u8>> = vec![\n458\t        vec![],\n459\t        b\"a\".to_vec(),\n460\t        b\"QUUX-V01-CS02-with-ristretto255_XMD:SHA-512_R255MAP_RO_\".to_vec(),\n461\t        vec![0u8; 32],\n462\t        vec![0xffu8; 63],\n463\t        vec![0x41u8; 64],\n464\t        vec![0x42u8; 65],\n465\t        vec![0x43u8; 128],\n466\t        vec![0x44u8; 129],\n467\t        vec![0x47u8; 255],\n468\t        vec![0x48u8; 256],\n469\t        vec![0x49u8; 300],\n470\t        vec![0x4au8; 1000],\n471\t    ];\n472\t    for n in [1usize, 3, 31, 33, 48, 96] {\n473\t        v.push(rng.bytes(n));\n474\t    }\n475\t    v\n476\t}\n477\t\n478\t/// Rows 2.116 - 2.118 and error rows 2.49 / 2.50.\n479\t#[test]\n480\tfn ristretto255_from_string() {\n481\t    let (c, r) = both::<FromString>(\"crypto_core_ristretto255_from_string\");\n482\t    let (valid, _) = both::<Pred>(\"crypto_core_ristretto255_is_valid_point\");\n483\t    let mut rng = Rng::new(0x2_0116);\n484\t    let strings = h2c_strings(&mut rng);\n485\t\n486\t    let call = |ctx: Option<&[u8]>, msg: &[u8], alg: c_int| -> (c_int, Vec<u8>) {\n487\t        let (cp, cl) = match ctx {\n488\t            None => (std::ptr::null(), 0usize),\n489\t            Some(s) => (s.as_ptr(), s.len()),\n490\t        };\n491\t        let mut oc = padded(32);\n492\t        let mut or = padded(32);\n493\t        set_errno(0);\n494\t        let rc = unsafe { c(oc.as_mut_ptr(), cp, cl, msg.as_ptr(), msg.len(), alg) };\n495\t        let ec = errno();\n496\t        set_errno(0);\n497\t        let rr2 = unsafe { r(or.as_mut_ptr(), cp, cl, msg.as_ptr(), msg.len(), alg) };\n498\t        let er = errno();\n499\t        eqi(&format!(\"ristretto255_from_string ret (alg {alg}, ctx_len {cl})\"), rc, rr2);\n500\t        assert_eq!(ec, er, \"ristretto255_from_string errno (alg {alg})\");\n501\t        if rc == 0 {\n502\t            eqb(\"ristretto255_from_string out\", &oc[..32], &or[..32]);\n503\t        }\n504\t        check_pad(\"ristretto255_from_string(C)\", &oc, 32);\n505\t        check_pad(\"ristretto255_from_string(Rust)\", &or, 32);\n506\t        (rc, oc[..32].to_vec())\n507\t    };\n508\t\n509\t    for alg in [1i32, 2] {\n510\t        for ctx in &strings {\n511\t            for msg in &strings {\n512\t                let (rc, out) = call(Some(ctx), msg, alg);\n513\t                assert_eq!(rc, 0);\n514\t                assert_eq!(unsafe { valid(out.as_ptr()) }, 1);\n515\t            }\n516\t        }\n517\t        for msg in &strings {\n518\t            let (rc, a) = call(None, msg, alg);\n519\t            assert_eq!(rc, 0);\n520\t            let (_, b) = call(Some(&[]), msg, alg);\n521\t            assert_eq!(a, b, \"ctx=NULL must behave like ctx_len=0\");\n522\t        }\n523\t    }\n524\t    for msg in &strings {\n525\t        let (_, a) = call(Some(b\"ctx\"), msg, 1);\n526\t        let (_, b) = call(Some(b\"ctx\"), msg, 2);\n527\t        assert_ne!(a, b, \"H2CSHA256 and H2CSHA512 must differ\");\n528\t    }\n529\t\n530\t    // error rows 2.49 / 2.50\n531\t    for alg in [0i32, 3, -1, 255, 256, i32::MIN, i32::MAX] {\n532\t        let (rc, _) = call(Some(b\"ctx\"), b\"msg\", alg);\n533\t        assert_eq!(rc, -1, \"from_string(alg={alg}) must fail\");\n534\t        set_errno(0);\n535\t        let mut o = [0u8; 32];\n536\t        assert_eq!(\n537\t            unsafe { c(o.as_mut_ptr(), b\"ctx\".as_ptr(), 3, b\"msg\".as_ptr(), 3, alg) },\n538\t            -1\n539\t        );\n540\t        assert_eq!(errno(), EINVAL, \"from_string(alg={alg}) must set EINVAL\");\n541\t    }\n542\t}\n543\t\n544\t// ------------------------------------------------------------ scalar wrappers\n545\t\n546\t/// Rows 2.119 - 2.126 and error rows 2.51 / 2.52 — every ristretto255 scalar\n547\t/// entry point, cross-checked against its ed25519 counterpart.\n548\t#[test]\n549\tfn ristretto255_scalar_wrappers() {\n550\t    let pool = scalar_pool(0x2_0120);\n551\t\n552\t    // ---- unary void wrappers: negate, complement\n553\t    for (rist, ed) in [\n554\t        (\"crypto_core_ristretto255_scalar_negate\", \"crypto_core_ed25519_scalar_negate\"),\n555\t        (\n556\t            \"crypto_core_ristretto255_scalar_complement\",\n557\t            \"crypto_core_ed25519_scalar_complement\",\n558\t        ),\n559\t    ] {\n560\t        let (c, r) = both::<Fn2>(rist);\n561\t        let (ce, _) = both::<Fn2>(ed);\n562\t        for s in &pool {\n563\t            let mut oc = padded(32);\n564\t            let mut or = padded(32);\n565\t            let mut oe = [0u8; 32];\n566\t            unsafe {\n567\t                c(oc.as_mut_ptr(), s.as_ptr());\n568\t                r(or.as_mut_ptr(), s.as_ptr());\n569\t                ce(oe.as_mut_ptr(), s.as_ptr());\n570\t            }\n571\t            eqb(&format!(\"{rist}({})\", hex(s)), &oc[..32], &or[..32]);\n572\t            check_pad(&format!(\"{rist}(C)\"), &oc, 32);\n573\t            check_pad(&format!(\"{rist}(Rust)\"), &or, 32);\n574\t            assert_eq!(&oc[..32], &oe[..], \"{rist} must delegate to {ed}\");\n575\t        }\n576\t    }\n577\t\n578\t    // ---- scalar_reduce (row 2.124), 64-byte input\n579\t    {\n580\t        let (c, r) = both::<Fn2>(\"crypto_core_ristretto255_scalar_reduce\");\n581\t        let (ce, _) = both::<Fn2>(\"crypto_core_ed25519_scalar_reduce\");\n582\t        let mut inputs: Vec<[u8; 64]> = vec![[0u8; 64], [0xffu8; 64]];\n583\t        {\n584\t            let mut a = [0u8; 64];\n585\t            a[..32].copy_from_slice(&L);\n586\t            inputs.push(a);\n587\t            let mut b = [0u8; 64];\n588\t            b[..32].copy_from_slice(&l_minus_one());\n589\t            inputs.push(b);\n590\t        }\n591\t        let mut rng = Rng::new(0x2_0124);\n592\t        for _ in 0..400 {\n593\t            inputs.push(rng.bytes(64).try_into().unwrap());\n594\t        }\n595\t        for t in &inputs {\n596\t            let mut oc = padded(32);\n597\t            let mut or = padded(32);\n598\t            let mut oe = [0u8; 32];\n599\t            unsafe {\n600\t                c(oc.as_mut_ptr(), t.as_ptr());\n601\t                r(or.as_mut_ptr(), t.as_ptr());\n602\t                ce(oe.as_mut_ptr(), t.as_ptr());\n603\t            }\n604\t            eqb(\"ristretto255_scalar_reduce\", &oc[..32], &or[..32]);\n605\t            check_pad(\"scalar_reduce(C)\", &oc, 32);\n606\t            check_pad(\"scalar_reduce(Rust)\", &or, 32);\n607\t            assert_eq!(&oc[..32], &oe[..], \"must delegate to the ed25519 version\");\n608\t        }\n609\t        // == L -> 0\n610\t        let mut t = [0u8; 64];\n611\t        t[..32].copy_from_slice(&L);\n612\t        let mut o = [0u8; 32];\n613\t        unsafe { c(o.as_mut_ptr(), t.as_ptr()) };\n614\t        assert_eq!(o, [0u8; 32]);\n615\t    }\n616\t\n617\t    // ---- binary void wrappers: add, sub, mul (rows 2.122 / 2.123)\n618\t    for (rist, ed) in [\n619\t        (\"crypto_core_ristretto255_scalar_add\", \"crypto_core_ed25519_scalar_add\"),\n620\t        (\"crypto_core_ristretto255_scalar_sub\", \"crypto_core_ed25519_scalar_sub\"),\n621\t        (\"crypto_core_ristretto255_scalar_mul\", \"crypto_core_ed25519_scalar_mul\"),\n622\t    ] {\n623\t        let (c, r) = both::<Fn3>(rist);\n624\t        let (ce, _) = both::<Fn3>(ed);\n625\t        let mut rng = Rng::new(0x2_0122);\n626\t        let mut pairs: Vec<([u8; 32], [u8; 32])> = vec![\n627\t            (zero32(), zero32()),\n628\t            (one32(), zero32()),\n629\t            (zero32(), one32()),\n630\t            (l_minus_one(), l_minus_one()),\n631\t            ([0xffu8; 32], [0xffu8; 32]),\n632\t            (L, L),\n633\t        ];\n634\t        for _ in 0..2000 {\n635\t            pairs.push((pool[rng.below(pool.len())], pool[rng.below(pool.len())]));\n636\t        }\n637\t        for (x, y) in &pairs {\n638\t            let mut oc = padded(32);\n639\t            let mut or = padded(32);\n640\t            let mut oe = [0u8; 32];\n641\t            unsafe {\n642\t                c(oc.as_mut_ptr(), x.as_ptr(), y.as_ptr());\n643\t                r(or.as_mut_ptr(), x.as_ptr(), y.as_ptr());\n644\t                ce(oe.as_mut_ptr(), x.as_ptr(), y.as_ptr());\n645\t            }\n646\t            eqb(&format!(\"{rist}({}, {})\", hex(x), hex(y)), &oc[..32], &or[..32]);\n647\t            check_pad(&format!(\"{rist}(C)\"), &oc, 32);\n648\t            check_pad(&format!(\"{rist}(Rust)\"), &or, 32);\n649\t            assert_eq!(&oc[..32], &oe[..], \"{rist} must agree with {ed}\");\n650\t        }\n651\t    }\n652\t\n653\t    // ---- scalar_invert (row 2.120, error row 2.51)\n654\t    {\n655\t        let (c, r) = both::<Fn2i>(\"crypto_core_ristretto255_scalar_invert\");\n656\t        let (ce, _) = both::<Fn2i>(\"crypto_core_ed25519_scalar_invert\");\n657\t        let (mul, _) = both::<Fn3>(\"crypto_core_ristretto255_scalar_mul\");\n658\t        let (canon, _) = both::<Pred>(\"crypto_core_ristretto255_scalar_is_canonical\");\n659\t        for s in &pool {\n660\t            let mut oc = padded(32);\n661\t            let mut or = padded(32);\n662\t            let mut oe = [0u8; 32];\n663\t            set_errno(0);\n664\t            let rc = unsafe { c(oc.as_mut_ptr(), s.as_ptr()) };\n665\t            let ec = errno();\n666\t            set_errno(0);\n667\t            let rr2 = unsafe { r(or.as_mut_ptr(), s.as_ptr()) };\n668\t            let er = errno();\n669\t            let re = unsafe { ce(oe.as_mut_ptr(), s.as_ptr()) };\n670\t            eqi(&format!(\"ristretto255_scalar_invert({})\", hex(s)), rc, rr2);\n671\t            assert_eq!(ec, er);\n672\t            assert_eq!(rc, re, \"must delegate to the ed25519 version\");\n673\t            let want = if *s == [0u8; 32] { -1 } else { 0 };\n674\t            assert_eq!(rc, want, \"scalar_invert({}) sentinel\", hex(s));\n675\t            eqb(\"ristretto255_scalar_invert out\", &oc[..32], &or[..32]);\n676\t            check_pad(\"scalar_invert(C)\", &oc, 32);\n677\t            check_pad(\"scalar_invert(Rust)\", &or, 32);\n678\t            assert_eq!(&oc[..32], &oe[..]);\n679\t            if rc == 0 && unsafe { canon(s.as_ptr()) } == 1 {\n680\t                let mut prod = [0u8; 32];\n681\t                unsafe { mul(prod.as_mut_ptr(), s.as_ptr(), oc.as_ptr()) };\n682\t                assert_eq!(prod, one32(), \"s * invert(s) != 1\");\n683\t            }\n684\t        }\n685\t        // error row 2.51 explicitly\n686\t        let mut o = padded(32);\n687\t        assert_eq!(unsafe { c(o.as_mut_ptr(), zero32().as_ptr()) }, -1);\n688\t        assert_eq!(&o[..32], &[0u8; 32][..]);\n689\t    }\n690\t\n691\t    // ---- scalar_is_canonical (row 2.125, error row 2.52)\n692\t    {\n693\t        let (c, r) = both::<Pred>(\"crypto_core_ristretto255_scalar_is_canonical\");\n694\t        let (cp, _) = both::<Pred>(\"_sodium_sc25519_is_canonical\");\n695\t        for (label, s, want) in [\n696\t            (\"0\", zero32(), 1),\n697\t            (\"1\", one32(), 1),\n698\t            (\"L-1\", l_minus_one(), 1),\n699\t            (\"L\", L, 0),\n700\t            (\"all-0xff\", [0xffu8; 32], 0),\n701\t        ] {\n702\t            let (a, b) = unsafe { (c(s.as_ptr()), r(s.as_ptr())) };\n703\t            eqi(&format!(\"ristretto255_scalar_is_canonical({label})\"), a, b);\n704\t            assert_eq!(a, want, \"is_canonical({label}): C gave {a}, expected {want}\");\n705\t        }\n706\t        for s in &pool {\n707\t            let (a, b) = unsafe { (c(s.as_ptr()), r(s.as_ptr())) };\n708\t            eqi(\"ristretto255_scalar_is_canonical\", a, b);\n709\t            assert_eq!(a, unsafe { cp(s.as_ptr()) }, \"must call sc25519_is_canonical directly\");\n710\t        }\n711\t    }\n712\t\n713\t    // ---- scalar_random (row 2.119)\n714\t    {\n715\t        let (c, r) = both::<Fn1>(\"crypto_core_ristretto255_scalar_random\");\n716\t        let (canon, _) = both::<Pred>(\"crypto_core_ristretto255_scalar_is_canonical\");\n717\t        for i in 0..200u64 {\n718\t            let seed = 0x5eed_0000_0000_0001u64 ^ (i.wrapping_mul(0x9E37_79B9) | 1);\n719\t            rng_reseed(seed);\n720\t            let mut oc = padded(32);\n721\t            unsafe { c(oc.as_mut_ptr()) };\n722\t            rng_reseed(seed);\n723\t            let mut or = padded(32);\n724\t            unsafe { r(or.as_mut_ptr()) };\n725\t            eqb(\"ristretto255_scalar_random\", &oc[..32], &or[..32]);\n726\t            check_pad(\"scalar_random(C)\", &oc, 32);\n727\t            check_pad(\"scalar_random(Rust)\", &or, 32);\n728\t            assert!(oc[31] <= 0x1f, \"r[31] must be <= 0x1f\");\n729\t            assert_eq!(unsafe { canon(oc.as_ptr()) }, 1);\n730\t            assert_ne!(&oc[..32], &[0u8; 32][..]);\n731\t        }\n732\t        rng_reset();\n733\t    }\n734\t\n735\t    // ---- scalar_from_string (row 2.126)\n736\t    {\n737\t        let (c, r) = both::<FromString>(\"crypto_core_ristretto255_scalar_from_string\");\n738\t        let (ce, _) = both::<FromString>(\"crypto_core_ed25519_scalar_from_string\");\n739\t        let (canon, _) = both::<Pred>(\"crypto_core_ristretto255_scalar_is_canonical\");\n740\t        let mut rng = Rng::new(0x2_0126);\n741\t        let strings = h2c_strings(&mut rng);\n742\t        for alg in [1i32, 2] {\n743\t            for ctx in &strings {\n744\t                for msg in &strings {\n745\t                    let mut oc = padded(32);\n746\t                    let mut or = padded(32);\n747\t                    let mut oe = [0u8; 32];\n748\t                    set_errno(0);\n749\t                    let rc = unsafe {\n750\t                        c(\n751\t                            oc.as_mut_ptr(),\n752\t                            ctx.as_ptr(),\n753\t                            ctx.len(),\n754\t                            msg.as_ptr(),\n755\t                            msg.len(),\n756\t                            alg,\n757\t                        )\n758\t                    };\n759\t                    let ec = errno();\n760\t                    set_errno(0);\n761\t                    let rr2 = unsafe {\n762\t                        r(\n763\t                            or.as_mut_ptr(),\n764\t                            ctx.as_ptr(),\n765\t                            ctx.len(),\n766\t                            msg.as_ptr(),\n767\t                            msg.len(),\n768\t                            alg,\n769\t                        )\n770\t                    };\n771\t                    let er = errno();\n772\t                    unsafe {\n773\t                        ce(oe.as_mut_ptr(), ctx.as_ptr(), ctx.len(), msg.as_ptr(), msg.len(), alg)\n774\t                    };\n775\t                    eqi(\"ristretto255_scalar_from_string ret\", rc, rr2);\n776\t                    assert_eq!(ec, er);\n777\t                    assert_eq!(rc, 0);\n778\t                    eqb(\"ristretto255_scalar_from_string out\", &oc[..32], &or[..32]);\n779\t                    check_pad(\"scalar_from_string(C)\", &oc, 32);\n780\t                    check_pad(\"scalar_from_string(Rust)\", &or, 32);\n781\t                    assert_eq!(&oc[..32], &oe[..], \"must delegate to the ed25519 version\");\n782\t                    assert_eq!(unsafe { canon(oc.as_ptr()) }, 1);\n783\t                }\n784\t            }\n785\t            // ctx == NULL\n786\t            let mut o = [0u8; 32];\n787\t            assert_eq!(\n788\t                unsafe { c(o.as_mut_ptr(), std::ptr::null(), 0, b\"m\".as_ptr(), 1, alg) },\n789\t                0\n790\t            );\n791\t        }\n792\t        // bad hash_alg\n793\t        for alg in [0i32, 3, -1, i32::MIN, i32::MAX] {\n794\t            let mut oc = [0u8; 32];\n795\t            let mut or = [0u8; 32];\n796\t            set_errno(0);\n797\t            let rc = unsafe { c(oc.as_mut_ptr(), b\"c\".as_ptr(), 1, b\"m\".as_ptr(), 1, alg) };\n798\t            let ec = errno();\n799\t            set_errno(0);\n800\t            let rr2 = unsafe { r(or.as_mut_ptr(), b\"c\".as_ptr(), 1, b\"m\".as_ptr(), 1, alg) };\n801\t            let er = errno();\n802\t            eqi(&format!(\"ristretto255_scalar_from_string(alg={alg})\"), rc, rr2);\n803\t            assert_eq!(rc, -1);\n804\t            assert_eq!(ec, EINVAL);\n805\t            assert_eq!(er, EINVAL);\n806\t        }\n807\t    }\n808\t}\n809\t"}]},"parent_tool_use_id":"toolu_bdrk_01Y8KmEUWZuyfELGp9tb2pNF","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"eed42a