odedlen, T_I,\n                );\n            },\n        );\n    }\n    // 60 is the tightest accepting size.\n    let mut a = padded(60);\n    let mut b = padded(60);\n    rng_reset();\n    let x = unsafe {\n        c(\n            1, 8, 1, b\"password\".as_ptr() as *const c_void, 8,\n            b\"saltsalt\".as_ptr() as *const c_void, 8, null_mut(), 16,\n            a.as_mut_ptr() as *mut c_char, 60, T_I,\n        )\n    };\n    rng_reset();\n    let y = unsafe {\n        r(\n            1, 8, 1, b\"password\".as_ptr() as *const c_void, 8,\n            b\"saltsalt\".as_ptr() as *const c_void, 8, null_mut(), 16,\n            b.as_mut_ptr() as *mut c_char, 60, T_I,\n        )\n    };\n    eqi(\"8.148 encodedlen=60\", x, y);\n    assert_eq!(x, ARGON2_OK, \"8.148: encodedlen 60 must be accepted\");\n    eqb(\"8.148 encodedlen=60 string\", &a[..60], &b[..60]);\n    assert_eq!(as_str(&a[..60]).len(), 59);\n}\n'''\nopen(p,'w').write(s)\nPY\ntimeout 600 cargo test --offline --test a8_argon2_core -- --test-threads=1 2>&1 | grep -E '^test |^running|panicked|mismatch|expected|error:' | tail -30"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":646,"cache_read_input_tokens":357738,"cache_creation":{"ephemeral_5m_input_tokens":646,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_013PupbdJbvdcm1hFvbZnzS8","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"91b41858-4f37-4e49-af81-052032301914","timestamp":"2026-08-31T04:26:00.227Z","subagent_type":"general-purpose","task_description":"Phase B/C tests area 8"}
