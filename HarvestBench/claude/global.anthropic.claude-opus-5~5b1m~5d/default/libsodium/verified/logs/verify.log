{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013T8ncWQCGYXMzPAzE2E1tU","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the reference C `libsodium.so` and the translated Rust\n4\t//! `liblibsodium.so` with `libloading` and exposes them as two opaque\n5\t//! libraries.  Every call in every test goes through `dlsym`, so the Rust\n6\t//! `#[no_mangle]` export wrappers are exercised exactly as an external C\n7\t//! consumer would exercise them.\n8\t#![allow(dead_code)]\n9\t\n10\tuse libloading::{Library, Symbol};\n11\tuse std::ffi::{c_char, c_int, c_void};\n12\tuse std::path::PathBuf;\n13\tuse std::sync::OnceLock;\n14\t\n15\t// ---------------------------------------------------------------- library load\n16\t\n17\tfn crate_dir() -> PathBuf {\n18\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n19\t}\n20\t\n21\tfn c_so_path() -> PathBuf {\n22\t    if let Ok(p) = std::env::var(\"SODIUM_C_SO\") {\n23\t        return PathBuf::from(p);\n24\t    }\n25\t    crate_dir()\n26\t        .parent()\n27\t        .unwrap()\n28\t        .join(\"c_src/build/libsodium.so\")\n29\t}\n30\t\n31\tfn rust_so_path() -> PathBuf {\n32\t    if let Ok(p) = std::env::var(\"SODIUM_RUST_SO\") {\n33\t        return PathBuf::from(p);\n34\t    }\n35\t    // The integration-test binary lives in target/<profile>/deps/, so the\n36\t    // cdylib built for the same profile is one directory up.\n37\t    if let Ok(exe) = std::env::current_exe() {\n38\t        if let Some(deps) = exe.parent() {\n39\t            if let Some(profile) = deps.parent() {\n40\t                let cand = profile.join(\"liblibsodium.so\");\n41\t                if cand.exists() {\n42\t                    return cand;\n43\t                }\n44\t            }\n45\t        }\n46\t    }\n47\t    for p in [\"target/release/liblibsodium.so\", \"target/debug/liblibsodium.so\"] {\n48\t        let cand = crate_dir().join(p);\n49\t        if cand.exists() {\n50\t            return cand;\n51\t        }\n52\t    }\n53\t    panic!(\"cannot locate the Rust liblibsodium.so; run `cargo build` first\");\n54\t}\n55\t\n56\t/// `cargo test --test <name>` does NOT rebuild the `cdylib`, because the test\n57\t/// binaries reach it only through `dlsym` and so have no Cargo-level dependency\n58\t/// on it.  Without this check a stale `.so` can silently \"pass\" a suite that a\n59\t/// fresh one would fail.  Refuse to run instead.\n60\tfn assert_so_is_fresh(so: &std::path::Path) {\n61\t    let so_mtime = match std::fs::metadata(so).and_then(|m| m.modified()) {\n62\t        Ok(t) => t,\n63\t        Err(_) => return,\n64\t    };\n65\t    let src = crate_dir().join(\"src\");\n66\t    let mut newest: Option<(std::path::PathBuf, std::time::SystemTime)> = None;\n67\t    let mut stack = vec![src];\n68\t    while let Some(d) = stack.pop() {\n69\t        let rd = match std::fs::read_dir(&d) {\n70\t            Ok(rd) => rd,\n71\t            Err(_) => continue,\n72\t        };\n73\t        for e in rd.flatten() {\n74\t            let p = e.path();\n75\t            if p.is_dir() {\n76\t                stack.push(p);\n77\t            } else if p.extension().map(|x| x == \"rs\").unwrap_or(false) {\n78\t                if let Ok(t) = e.metadata().and_then(|m| m.modified()) {\n79\t                    if newest.as_ref().map(|(_, n)| t > *n).unwrap_or(true) {\n80\t                        newest = Some((p, t));\n81\t                    }\n82\t                }\n83\t            }\n84\t        }\n85\t    }\n86\t    if let Some((p, t)) = newest {\n87\t        if t > so_mtime {\n88\t            panic!(\n89\t                \"STALE cdylib: {} is newer than {}.\\n\\\n90\t                 `cargo test --test <name>` does not rebuild the cdylib; run\\n\\\n91\t                 `cargo build --offline` first (or set SODIUM_RUST_SO).\",\n92\t                p.display(),\n93\t                so.display()\n94\t            );\n95\t        }\n96\t    }\n97\t}\n98\t\n99\tstruct Libs {\n100\t    c: Library,\n101\t    r: Library,\n102\t}\n103\t\n104\t// The libraries are loaded once and never unloaded; every symbol handed out\n105\t// therefore has a `'static` lifetime.\n106\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n107\t\n108\tfn libs() -> &'static Libs {\n109\t    LIBS.get_or_init(|| {\n110\t        let c = unsafe { Library::new(c_so_path()) }\n111\t            .unwrap_or_else(|e| panic!(\"loading {:?}: {e}\", c_so_path()));\n112\t        let rp = rust_so_path();\n113\t        assert_so_is_fresh(&rp);\n114\t        let r = unsafe { Library::new(&rp) }.unwrap_or_else(|e| panic!(\"loading {rp:?}: {e}\"));\n115\t        let l = Libs { c, r };\n116\t        unsafe { install_deterministic_rng(&l) };\n117\t        // sodium_init() after the RNG is installed, exactly like a real\n118\t        // consumer that swaps the RNG at startup.\n119\t        unsafe {\n120\t            let ci: Symbol<unsafe extern \"C\" fn() -> c_int> = l.c.get(b\"sodium_init\\0\").unwrap();\n121\t            let ri: Symbol<unsafe extern \"C\" fn() -> c_int> = l.r.get(b\"sodium_init\\0\").unwrap();\n122\t            assert_eq!(ci(), 0, \"C sodium_init failed\");\n123\t            assert_eq!(ri(), 0, \"Rust sodium_init failed\");\n124\t        }\n125\t        l\n126\t    })\n127\t}\n128\t\n129\tpub fn c_lib() -> &'static Library {\n130\t    &libs().c\n131\t}\n132\tpub fn rust_lib() -> &'static Library {\n133\t    &libs().r\n134\t}\n135\t\n136\t/// Look a symbol up in both libraries and return the (C, Rust) pair.\n137\t///\n138\t/// Panics with a clear message when the Rust `.so` does not export the symbol,\n139\t/// which is itself a translation-completeness failure.\n140\tpub fn both<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n141\t    let l = libs();\n142\t    let mut b: Vec<u8> = name.as_bytes().to_vec();\n143\t    b.push(0);\n144\t    unsafe {\n145\t        let c: Symbol<'static, T> = l\n146\t            .c\n147\t            .get(&b)\n148\t            .unwrap_or_else(|e| panic!(\"C .so is missing `{name}`: {e}\"));\n149\t        let r: Symbol<'static, T> = l\n150\t            .r\n151\t            .get(&b)\n152\t            .unwrap_or_else(|e| panic!(\"Rust .so is missing `{name}`: {e}\"));\n153\t        (c, r)\n154\t    }\n155\t}\n156\t\n157\t/// `true` when both libraries export `name`.\n158\tpub fn has(name: &str) -> bool {\n159\t    let l = libs();\n160\t    let mut b: Vec<u8> = name.as_bytes().to_vec();\n161\t    b.push(0);\n162\t    unsafe {\n163\t        l.c.get::<*const c_void>(&b).is_ok() && l.r.get::<*const c_void>(&b).is_ok()\n164\t    }\n165\t}\n166\t\n167\t// ------------------------------------------------------- deterministic RNG\n168\t\n169\t#[repr(C)]\n170\tpub struct RandombytesImplementation {\n171\t    pub implementation_name: Option<unsafe extern \"C\" fn() -> *const c_char>,\n172\t    pub random: Option<unsafe extern \"C\" fn() -> u32>,\n173\t    pub stir: Option<unsafe extern \"C\" fn()>,\n174\t    pub uniform: Option<unsafe extern \"C\" fn(u32) -> u32>,\n175\t    pub buf: Option<unsafe extern \"C\" fn(*mut c_void, usize)>,\n176\t    pub close: Option<unsafe extern \"C\" fn() -> c_int>,\n177\t}\n178\t\n179\tconst RNG_SEED: u64 = 0x2545_F491_4F6C_DD1D;\n180\t\n181\t// One independent stream per loaded library, so that the n-th random byte\n182\t// consumed by C equals the n-th random byte consumed by Rust.\n183\t//\n184\t// The state is THREAD-LOCAL: libtest runs the tests of one binary on several\n185\t// threads at once, and a process-global stream would let two tests interleave\n186\t// their draws, desynchronising the C stream from the Rust stream and producing\n187\t// spurious \"divergences\". Per-thread streams give every test its own lockstep\n188\t// pair regardless of `--test-threads`, and a fresh thread starts from RNG_SEED\n189\t// so a test that forgets `rng_reset()` is still reproducible.\n190\tthread_local! {\n191\t    static RNG_STATE: std::cell::Cell<[u64; 2]> = const { std::cell::Cell::new([RNG_SEED, RNG_SEED]) };\n192\t}\n193\t\n194\tfn rng_next(i: usize) -> u64 {\n195\t    RNG_STATE.with(|c| {\n196\t        let mut s = c.get();\n197\t        let mut x = s[i];\n198\t        x ^= x << 13;\n199\t        x ^= x >> 7;\n200\t        x ^= x << 17;\n201\t        s[i] = x;\n202\t        c.set(s);\n203\t        x\n204\t    })\n205\t}\n206\t\n207\t/// Rewind both RNG streams (for the calling thread) so that the next C call and\n208\t/// the next Rust call see identical randomness.  Call this before any pair of\n209\t/// operations that consume randomness (`*_keypair`, `*_seal`, `randombytes_*`).\n210\tpub fn rng_reset() {\n211\t    RNG_STATE.with(|c| c.set([RNG_SEED, RNG_SEED]));\n212\t}\n213\t\n214\t/// Rewind both RNG streams (for the calling thread) to an arbitrary non-zero seed.\n215\tpub fn rng_reseed(seed: u64) {\n216\t    let s = if seed == 0 { RNG_SEED } else { seed };\n217\t    RNG_STATE.with(|c| c.set([s, s]));\n218\t}\n219\t\n220\tmacro_rules! rng_impl {\n221\t    ($idx:expr, $name:ident, $rand:ident, $buf:ident, $stir:ident, $close:ident) => {\n222\t        unsafe extern \"C\" fn $name() -> *const c_char {\n223\t            b\"difftest\\0\".as_ptr() as *const c_char\n224\t        }\n225\t        unsafe extern \"C\" fn $rand() -> u32 {\n226\t            rng_next($idx) as u32\n227\t        }\n228\t        unsafe extern \"C\" fn $buf(buf: *mut c_void, size: usize) {\n229\t            let mut p = buf as *mut u8;\n230\t            let mut n = size;\n231\t            while n >= 8 {\n232\t                let v = rng_next($idx).to_le_bytes();\n233\t                std::ptr::copy_nonoverlapping(v.as_ptr(), p, 8);\n234\t                p = p.add(8);\n235\t                n -= 8;\n236\t            }\n237\t            if n > 0 {\n238\t                let v = rng_next($idx).to_le_bytes();\n239\t                std::ptr::copy_nonoverlapping(v.as_ptr(), p, n);\n240\t            }\n241\t        }\n242\t        unsafe extern \"C\" fn $stir() {}\n243\t        unsafe extern \"C\" fn $close() -> c_int {\n244\t            0\n245\t        }\n246\t    };\n247\t}\n248\t\n249\trng_impl!(0, c_name, c_random, c_buf, c_stir, c_close);\n250\trng_impl!(1, r_name, r_random, r_buf, r_stir, r_close);\n251\t\n252\tunsafe fn install_deterministic_rng(l: &Libs) {\n253\t    // `uniform` is left NULL on purpose so that the library's own\n254\t    // randombytes_uniform() rejection-sampling loop is what gets tested.\n255\t    let c_impl: &'static RandombytesImplementation = Box::leak(Box::new(RandombytesImplementation {\n256\t        implementation_name: Some(c_name),\n257\t        random: Some(c_random),\n258\t        stir: Some(c_stir),\n259\t        uniform: None,\n260\t        buf: Some(c_buf),\n261\t        close: Some(c_close),\n262\t    }));\n263\t    let r_impl: &'static RandombytesImplementation = Box::leak(Box::new(RandombytesImplementation {\n264\t        implementation_name: Some(r_name),\n265\t        random: Some(r_random),\n266\t        stir: Some(r_stir),\n267\t        uniform: None,\n268\t        buf: Some(r_buf),\n269\t        close: Some(r_close),\n270\t    }));\n271\t    type SetImpl = unsafe extern \"C\" fn(*const RandombytesImplementation) -> c_int;\n272\t    let cs: Symbol<SetImpl> = l.c.get(b\"randombytes_set_implementation\\0\").unwrap();\n273\t    let rs: Symbol<SetImpl> = l.r.get(b\"randombytes_set_implementation\\0\").unwrap();\n274\t    assert_eq!(cs(c_impl as *const _), 0);\n275\t    assert_eq!(rs(r_impl as *const _), 0);\n276\t}\n277\t\n278\t// ----------------------------------------------------------- test-input PRNG\n279\t\n280\t/// Deterministic, reproducible generator for test inputs (splitmix64).\n281\tpub struct Rng(u64);\n282\t\n283\timpl Rng {\n284\t    pub fn new(seed: u64) -> Self {\n285\t        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)\n286\t    }\n287\t    pub fn next_u64(&mut self) -> u64 {\n288\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n289\t        let mut z = self.0;\n290\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n291\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n292\t        z ^ (z >> 31)\n293\t    }\n294\t    pub fn next_u32(&mut self) -> u32 {\n295\t        (self.next_u64() >> 32) as u32\n296\t    }\n297\t    pub fn byte(&mut self) -> u8 {\n298\t        (self.next_u64() >> 56) as u8\n299\t    }\n300\t    /// Uniform in `[0, n)`; returns 0 when `n == 0`.\n301\t    pub fn below(&mut self, n: usize) -> usize {\n302\t        if n == 0 {\n303\t            0\n304\t        } else {\n305\t            (self.next_u64() % n as u64) as usize\n306\t        }\n307\t    }\n308\t    /// Uniform in `[lo, hi]`.\n309\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n310\t        assert!(lo <= hi);\n311\t        lo + self.below(hi - lo + 1)\n312\t    }\n313\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n314\t        let mut v = vec![0u8; n];\n315\t        self.fill(&mut v);\n316\t        v\n317\t    }\n318\t    pub fn fill(&mut self, out: &mut [u8]) {\n319\t        let mut i = 0;\n320\t        while i < out.len() {\n321\t            let w = self.next_u64().to_le_bytes();\n322\t            let k = std::cmp::min(8, out.len() - i);\n323\t            out[i..i + k].copy_from_slice(&w[..k]);\n324\t            i += k;\n325\t        }\n326\t    }\n327\t}\n328\t\n329\t// ------------------------------------------------------------------- helpers\n330\t\n331\t/// Byte-for-byte comparison with a readable failure message.\n332\t#[track_caller]\n333\tpub fn eqb(what: &str, c: &[u8], r: &[u8]) {\n334\t    if c != r {\n335\t        let n = std::cmp::min(c.len(), r.len());\n336\t        let mut first = n;\n337\t        for i in 0..n {\n338\t            if c[i] != r[i] {\n339\t                first = i;\n340\t                break;\n341\t            }\n342\t        }\n343\t        panic!(\n344\t            \"{what}: byte mismatch (C len {}, Rust len {}, first diff at {first})\\n  C   : {}\\n  Rust: {}\",\n345\t            c.len(),\n346\t            r.len(),\n347\t            hex(c),\n348\t            hex(r)\n349\t        );\n350\t    }\n351\t}\n352\t\n353\t#[track_caller]\n354\tpub fn eqi(what: &str, c: c_int, r: c_int) {\n355\t    assert_eq!(c, r, \"{what}: return code mismatch (C {c}, Rust {r})\");\n356\t}\n357\t\n358\tpub fn hex(b: &[u8]) -> String {\n359\t    const MAX: usize = 160;\n360\t    let mut s = String::new();\n361\t    for (i, x) in b.iter().enumerate() {\n362\t        if i == MAX {\n363\t            s.push_str(\"...\");\n364\t            break;\n365\t        }\n366\t        s.push_str(&format!(\"{x:02x}\"));\n367\t    }\n368\t    s\n369\t}\n370\t\n371\t// ------------------------------------------------------------------- errno\n372\t\n373\textern \"C\" {\n374\t    fn __errno_location() -> *mut c_int;\n375\t    fn fork() -> c_int;\n376\t    fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;\n377\t    fn _exit(code: c_int) -> !;\n378\t    fn setrlimit(resource: c_int, rlim: *const RLimit) -> c_int;\n379\t}\n380\t\n381\t#[repr(C)]\n382\tstruct RLimit {\n383\t    cur: u64,\n384\t    max: u64,\n385\t}\n386\tconst RLIMIT_CORE: c_int = 4;\n387\t\n388\tpub fn errno() -> c_int {\n389\t    unsafe { *__errno_location() }\n390\t}\n391\tpub fn set_errno(v: c_int) {\n392\t    unsafe { *__errno_location() = v }\n393\t}\n394\t\n395\tpub const EINVAL: c_int = 22;\n396\tpub const ERANGE: c_int = 34;\n397\tpub const ENOMEM: c_int = 12;\n398\tpub const EPERM: c_int = 1;\n399\t\n400\t/// Run `f` in a forked child and return the raw `waitpid` status.\n401\t///\n402\t/// Used for the `sodium_misuse()` / `abort()` paths, which cannot be observed\n403\t/// in-process.  The child `_exit(0)`s if `f` returns normally, so a normal exit\n404\t/// and a fatal signal are clearly distinguishable.\n405\tpub fn in_child<F: FnOnce()>(f: F) -> c_int {\n406\t    unsafe {\n407\t        let pid = fork();\n408\t        assert!(pid >= 0, \"fork failed\");\n409\t        if pid == 0 {\n410\t            // No core dumps: the abort() paths are expected, and dumping cores\n411\t            // makes the error-path tests hundreds of times slower.\n412\t            setrlimit(RLIMIT_CORE, &RLimit { cur: 0, max: 0 });\n413\t            f();\n414\t            _exit(0);\n415\t        }\n416\t        let mut st: c_int = 0;\n417\t        assert!(waitpid(pid, &mut st, 0) == pid);\n418\t        st\n419\t    }\n420\t}\n421\t\n422\t/// Human-readable classification of a `waitpid` status: `\"exit:N\"` or `\"sig:N\"`.\n423\tpub fn status_str(st: c_int) -> String {\n424\t    if st & 0x7f == 0 {\n425\t        format!(\"exit:{}\", (st >> 8) & 0xff)\n426\t    } else {\n427\t        format!(\"sig:{}\", st & 0x7f)\n428\t    }\n429\t}\n430\t\n431\t/// Differentially compare the *process outcome* of a pair of calls that may\n432\t/// abort (`sodium_misuse`).\n433\t#[track_caller]\n434\tpub fn eq_abort<FC: FnOnce(), FR: FnOnce()>(what: &str, c: FC, r: FR) {\n435\t    let sc = in_child(c);\n436\t    let sr = in_child(r);\n437\t    assert_eq!(\n438\t        status_str(sc),\n439\t        status_str(sr),\n440\t        \"{what}: process outcome mismatch\"\n441\t    );\n442\t}\n443\t\n444\t/// A guard byte pattern used to prove neither implementation writes out of\n445\t/// bounds; allocate `len + PAD` and check the tail afterwards.\n446\tpub const PAD: usize = 32;\n447\t\n448\tpub fn padded(len: usize) -> Vec<u8> {\n449\t    let mut v = vec![0u8; len + PAD];\n450\t    for (i, b) in v[len..].iter_mut().enumerate() {\n451\t        *b = 0xA5u8.wrapping_add(i as u8);\n452\t    }\n453\t    v\n454\t}\n455\t\n456\t#[track_caller]\n457\tpub fn check_pad(what: &str, v: &[u8], len: usize) {\n458\t    for (i, b) in v[len..].iter().enumerate() {\n459\t        assert_eq!(\n460\t            *b,\n461\t            0xA5u8.wrapping_add(i as u8),\n462\t            \"{what}: out-of-bounds write at +{i} past {len}\"\n463\t        );\n464\t    }\n465\t}\n466\t"}]},"parent_tool_