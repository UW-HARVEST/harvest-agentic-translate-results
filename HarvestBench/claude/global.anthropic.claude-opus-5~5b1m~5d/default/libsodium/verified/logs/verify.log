NOCORE | MAP_POPULATE,\n51\t                                 -1, 0)) == MAP_FAILED) {\n52\t        base = NULL; /* LCOV_EXCL_LINE */\n53\t    }                /* LCOV_EXCL_LINE */\n54\t    aligned  = base;\n55\t#elif defined(HAVE_POSIX_MEMALIGN)\n56\t    if ((errno = posix_memalign((void **) &base, 64, size)) != 0) {\n57\t        base = NULL;\n58\t    }\n59\t    aligned = base;\n60\t#else\n61\t    base = aligned = NULL;\n62\t    if (size + 63 < size) {\n63\t        errno = ENOMEM;\n64\t    } else if ((base = (uint8_t *) malloc(size + 63)) != NULL) {\n65\t        aligned = base + 63;\n66\t        aligned -= (uintptr_t) aligned & 63;\n67\t    }\n68\t#endif\n69\t    region->base    = base;\n70\t    region->aligned = aligned;\n71\t    region->size    = base ? size : 0;\n72\t\n73\t    return aligned;\n74\t}\n75\t\n76\tstatic inline void\n77\tinit_region(escrypt_region_t *region)\n78\t{\n79\t    region->base = region->aligned = NULL;\n80\t    region->size                   = 0;\n81\t}\n82\t\n83\tint\n84\tescrypt_free_region(escrypt_region_t *region)\n85\t{\n86\t    if (region->base) {\n87\t#if defined(MAP_ANON) && defined(HAVE_MMAP)\n88\t        if (munmap(region->base, region->size)) {\n89\t            return -1; /* LCOV_EXCL_LINE */\n90\t        }\n91\t#else\n92\t        free(region->base);\n93\t#endif\n94\t    }\n95\t    init_region(region);\n96\t\n97\t    return 0;\n98\t}\n99\t\n100\tint\n101\tescrypt_init_local(escrypt_local_t *local)\n102\t{\n103\t    init_region(local);\n104\t\n105\t    return 0;\n106\t}\n107\t\n108\tint\n109\tescrypt_free_local(escrypt_local_t *local)\n110\t{\n111\t    return escrypt_free_region(local);\n112\t}\n113\t"}]},"parent_tool_use_id":"toolu_bdrk_013PupbdJbvdcm1hFvbZnzS8","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"24b01a47-1658-4d58-9200-dfcf85ea2157","timestamp":"2026-08-31T03:48:58.897Z","subagent_type":"general-purpose","task_description":"Phase B/C tests area 8"}
