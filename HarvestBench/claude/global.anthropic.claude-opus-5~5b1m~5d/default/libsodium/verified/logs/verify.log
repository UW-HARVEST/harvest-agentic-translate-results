AK_THETA_RHO_PI_CHI_IOTA_PRE(round_idx, A, E) \\\n    Da = Cu ^ ROTL64(Ce, 1);                              \\\n    De = Ca ^ ROTL64(Ci, 1);                              \\\n    Di = Ce ^ ROTL64(Co, 1);                              \\\n    Do = Ci ^ ROTL64(Cu, 1);                              \\\n    Du = Co ^ ROTL64(Ca, 1);                              \\\n                                                          \\\n    A##ba ^= Da;                                          \\\n    Bba = A##ba;                                          \\\n    A##ge ^= De;                                          \\\n    Bbe = ROTL64(A##ge, 44);                              \\\n    A##ki ^= Di;                                          \\\n    Bbi = ROTL64(A##ki, 43);                              \\\n    A##mo ^= Do;                                          \\\n    Bbo = ROTL64(A##mo, 21);                              \\\n    A##su ^= Du;                                          \\\n    Bbu   = ROTL64(A##su, 14);                            \\\n    E##ba = Bba ^ ((~Bbe) & Bbi);                         \\\n    E##ba ^= keccak_round_constants[round_idx];           \\\n    Ca    = E##ba;                                        \\\n    E##be = Bbe ^ ((~Bbi) & Bbo);                         \\\n    Ce    = E##be;                                        \\\n    E##bi = Bbi ^ ((~Bbo) & Bbu);                         \\\n    Ci    = E##bi;                                        \\\n    E##bo = Bbo ^ ((~Bbu) & Bba);                         \\\n    Co    = E##bo;                                        \\\n    E##bu = Bbu ^ ((~Bba) & Bbe);                         \\\n    Cu    = E##bu;                                        \\\n                                                          \\\n    A##bo ^= Do;                                          \\\n    Bga = ROTL64(A##bo, 28);                              \\\n    A##gu ^= Du;                                          \\\n    Bge = ROTL64(A##gu, 20);                              \\\n    A##ka ^= Da;                                          \\\n    Bgi = ROTL64(A##ka, 3);                               \\\n    A##me ^= De;                                          \\\n    Bgo = ROTL64(A##me, 45);                              \\","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_019SnHB3DsDmZYZ2StTGaQ75","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"7489960f-84a2-4bd3-b6ce-f4d4cd20d73f","timestamp":"2026-08-31T03:45:04.745Z","subagent_type":"general-purpose","task_description":"Phase B/C tests area 2"}
