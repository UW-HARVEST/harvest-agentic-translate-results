{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01M13UEo8UEiuuLevMbYN6a9","type":"tool_result","content":"1\t//! Area 1 — `sodium/codecs.c`: hex, base64, IP text codecs.\n2\tmod common;\n3\tuse common::*;\n4\tuse std::ffi::{c_char, c_int};\n5\t\n6\ttype Bin2Hex = unsafe extern \"C\" fn(*mut c_char, usize, *const u8, usize) -> *mut c_char;\n7\ttype Hex2Bin = unsafe extern \"C\" fn(\n8\t    *mut u8,\n9\t    usize,\n10\t    *const c_char,\n11\t    usize,\n12\t    *const c_char,\n13\t    *mut usize,\n14\t    *mut *const c_char,\n15\t) -> c_int;\n16\ttype EncLen = unsafe extern \"C\" fn(usize, c_int) -> usize;\n17\ttype Bin2B64 = unsafe extern \"C\" fn(*mut c_char, usize, *const u8, usize, c_int) -> *mut c_char;\n18\ttype B642Bin = unsafe extern \"C\" fn(\n19\t    *mut u8,\n20\t    usize,\n21\t    *const c_char,\n22\t    usize,\n23\t    *const c_char,\n24\t    *mut usize,\n25\t    *mut *const c_char,\n26\t    c_int,\n27\t) -> c_int;\n28\ttype Ip2Bin = unsafe extern \"C\" fn(*mut u8, *const c_char, usize) -> c_int;\n29\ttype Bin2Ip = unsafe extern \"C\" fn(*mut c_char, usize, *const u8) -> *mut c_char;\n30\t\n31\tconst VARIANTS: [c_int; 4] = [1, 3, 5, 7];\n32\t\n33\t// ---------------------------------------------------------------- bin2hex\n34\t\n35\t#[test]\n36\tfn bin2hex_valid_all_shapes() {\n37\t    let (c, r) = both::<Bin2Hex>(\"sodium_bin2hex\");\n38\t    let mut rng = Rng::new(0x11);\n39\t    for bin_len in 0..=64usize {\n40\t        for _ in 0..8 {\n41\t            let bin = rng.bytes(bin_len);\n42\t            // hex_maxlen must be > bin_len*2\n43\t            for extra in [1usize, 2, 7] {\n44\t                let maxlen = bin_len * 2 + extra;\n45\t                let mut ob = padded(maxlen);\n46\t                let mut or = padded(maxlen);\n47\t                unsafe {\n48\t                    let pc = c(ob.as_mut_ptr() as *mut c_char, maxlen, bin.as_ptr(), bin_len);\n49\t                    let pr = r(or.as_mut_ptr() as *mut c_char, maxlen, bin.as_ptr(), bin_len);\n50\t                    assert_eq!(pc as usize, ob.as_ptr() as usize);\n51\t                    assert_eq!(pr as usize, or.as_ptr() as usize);\n52\t                }\n53\t                // Only the first bin_len*2+1 bytes are defined by the C code.\n54\t                eqb(\"bin2hex\", &ob[..bin_len * 2 + 1], &or[..bin_len * 2 + 1]);\n55\t                check_pad(\"bin2hex(C)\", &ob, maxlen);\n56\t                check_pad(\"bin2hex(Rust)\", &or, maxlen);\n57\t            }\n58\t        }\n59\t    }\n60\t}\n61\t\n62\t#[test]\n63\tfn bin2hex_misuse_hex_maxlen_too_small() {\n64\t    // hex_maxlen <= bin_len * 2  =>  sodium_misuse() -> abort\n65\t    let (c, r) = both::<Bin2Hex>(\"sodium_bin2hex\");\n66\t    for (bin_len, maxlen) in [(0usize, 0usize), (1, 0), (1, 1), (1, 2), (16, 32), (16, 5)] {\n67\t        let bin = vec![0xABu8; bin_len.max(1)];\n68\t        let cc = c.clone();\n69\t        let rr = r.clone();\n70\t        let b1 = bin.clone();\n71\t        let b2 = bin.clone();\n72\t        eq_abort(\n73\t            &format!(\"bin2hex(bin_len={bin_len}, hex_maxlen={maxlen})\"),\n74\t            move || unsafe {\n75\t                let mut o = vec![0u8; maxlen + 8];\n76\t                cc(o.as_mut_ptr() as *mut c_char, maxlen, b1.as_ptr(), bin_len);\n77\t            },\n78\t            move || unsafe {\n79\t                let mut o = vec![0u8; maxlen + 8];\n80\t                rr(o.as_mut_ptr() as *mut c_char, maxlen, b2.as_ptr(), bin_len);\n81\t            },\n82\t        );\n83\t    }\n84\t}\n85\t\n86\t// ---------------------------------------------------------------- hex2bin\n87\t\n88\tfn hex2bin_case(\n89\t    c: &Hex2Bin,\n90\t    r: &Hex2Bin,\n91\t    hex: &[u8],\n92\t    bin_maxlen: usize,\n93\t    ignore: Option<&[u8]>,\n94\t    want_bin_len: bool,\n95\t    want_hex_end: bool,\n96\t    label: &str,\n97\t) {\n98\t    let ign_c: Option<Vec<u8>> = ignore.map(|s| {\n99\t        let mut v = s.to_vec();\n100\t        v.pu