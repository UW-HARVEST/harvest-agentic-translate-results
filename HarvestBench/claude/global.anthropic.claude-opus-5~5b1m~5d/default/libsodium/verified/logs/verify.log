\t    if ((uint64_t)(r) * (uint64_t)(p) >= ((uint64_t) 1 << 30)) {\n254\t        errno = EFBIG;\n255\t        return -1;\n256\t    }\n257\t    if (N > UINT32_MAX) {\n258\t        errno = EFBIG;\n259\t        return -1;\n260\t    }\n261\t    if (((N & (N - 1)) != 0) || (N < 2)) {\n262\t        errno = EINVAL;\n263\t        return -1;\n264\t    }\n265\t    if (r == 0 || p == 0) {\n266\t        errno = EINVAL;\n267\t        return -1;\n268\t    }\n269\t    if ((r > SIZE_MAX / 128 / p) ||\n270\t#if SIZE_MAX / 256 <= UINT32_MAX\n271\t        (r > SIZE_MAX / 256) ||\n272\t#endif\n273\t        (N > SIZE_MAX / 128 / r)) {\n274\t        errno = ENOMEM;\n275\t        return -1;\n276\t    }\n277\t\n278\t    /* Allocate memory. */\n279\t    B_size = (size_t) 128 * r * p;\n280\t    V_size = (size_t) 128 * r * (size_t) N;\n281\t    need   = B_size + V_size;\n282\t    if (need < V_size) {\n283\t        errno = ENOMEM;\n284\t        return -1;\n285\t    }\n286\t    XY_size = (size_t) 256 * r + 64;\n287\t    need += XY_size;\n288\t    if (need < XY_size) {\n289\t        errno = ENOMEM;\n290\t        return -1;\n291\t    }\n292\t    if (local->size < need) {\n293\t        if (escrypt_free_region(local)) {\n294\t            return -1;\n295\t        }\n296\t        if (!escrypt_alloc_region(local, need)) {\n297\t            return -1;\n298\t        }\n299\t    }\n300\t    B  = (uint8_t *) local->aligned;\n301\t    V  = (uint32_t *) ((uint8_t *) B + B_size);\n302\t    XY = (uint32_t *) ((uint8_t *) V + V_size);\n303\t\n304\t    /* 1: (B_0 ... B_{p-1}) <-- PBKDF2(P, S, 1, p * MFLen) */\n305\t    escrypt_PBKDF2_SHA256(passwd, passwdlen, salt, saltlen, 1, B, B_size);\n306\t\n307\t    /* 2: for i = 0 to p - 1 do */\n308\t    for (i = 0; i < p; i++) {\n309\t        /* 3: B_i <-- MF(B_i, N) */\n310\t        smix(&B[(size_t) 128 * i * r], r, N, V, XY);\n311\t    }\n312\t\n313\t    /* 5: DK <-- PBKDF2(P, B, 1, dkLen) */\n314\t    escrypt_PBKDF2_SHA256(passwd, passwdlen, B, B_size, 1, buf, buflen);\n315\t\n316\t    /* Success! */\n317\t    return 0;\n318\t}\n319\t"}]},"parent_tool_use_id":"toolu_bdrk_013PupbdJbvdcm1hFvbZnzS8","session_id":"b566403e-4c11-4a9b-ad3a-d43b1f08afd2","uuid":"9dfa8668-2838-431b-ab50-aecb206618c1","timestamp":"2026-08-31T03:49:03.976Z","subagent_type":"general-purpose","task_description":"Phase B/C tests area 8"}
