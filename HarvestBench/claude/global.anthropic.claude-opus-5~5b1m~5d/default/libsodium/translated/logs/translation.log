xported and the build status."}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":337,"cache_read_input_tokens":122038,"cache_creation":{"ephemeral_5m_input_tokens":337,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3f891fde-b339-4353-9d37-1cfde3da52f8","uuid":"778a80aa-19f4-4f1b-9f60-19958e7fb890","timestamp":"2026-08-31T03:05:06.855Z"}
