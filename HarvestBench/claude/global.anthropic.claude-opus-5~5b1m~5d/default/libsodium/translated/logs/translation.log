,\n39\t        /* p-1 (order 2) */\n40\t        { 0xec, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n41\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n42\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f },\n43\t        /* p (=0, order 4) */\n44\t        { 0xed, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n45\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n46\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f },\n47\t        /* p+1 (=1, order 1) */\n48\t        { 0xee, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n49\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,\n50\t          0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f }\n51\t    };\n52\t    unsigned char c[7] = { 0 };\n53\t    unsigned int  k;\n54\t    size_t        i, j;\n55\t\n56\t    COMPILER_ASSERT(7 == sizeof blocklist / sizeof blocklist[0]);\n57\t    for (j = 0; j < 31; j++) {\n58\t        for (i = 0; i < sizeof blocklist / sizeof blocklist[0]; i++) {\n59\t            c[i] |= s[j] ^ blocklist[i][j];\n60\t        }\n61\t    }\n62\t    for (i = 0; i < sizeof blocklist / sizeof blocklist[0]; i++) {\n63\t        c[i] |= (s[j] & 0x7f) ^ blocklist[i][j];\n64\t    }\n65\t    k = 0;\n66\t    for (i = 0; i < sizeof blocklist / sizeof blocklist[0]; i++) {\n67\t        k |= (c[i] - 1);\n68\t    }\n69\t    return (int) ((k >> 8) & 1);\n70\t}\n71\t\n72\t#ifdef HAVE_TI_MODE\n73\t/*\n74\t h = f - g\n75\t Unlike fe25519_sub(), this doesn't normalize g first, so the limbs of g\n76\t must not exceed 2^52 - 38. In the ladder below, g is always the direct\n77\t output of fe25519_mul() or fe25519_sq(), whose limbs fit in 52 bits.\n78\t */\n79\tstatic inline void\n80\tfe25519_sub_lazy(fe25519 h, const fe25519 f, const fe25519 g)\n81\t{\n82\t    h[0] = (f[0] + 0xfffffffffffdaULL) - g[0];\n83\t    h[1] = (f[1] + 0xffffffffffffeULL) - g[1];\n84\t    h[2] = (f[2] + 0xffffffffffffeULL) - g[2];\n85\t    h[3] = (f[3] + 0xffffffffffffeULL) - g[3];\n86\t    h[4] = (f[4] + 0xffffffffffffeULL) - g[4];\n87\t}\n88\t#else\n89\t/* limbs are signed and fe25519_sub() is a plain per-limb subtraction */\n90\t# define fe25519_sub_lazy fe25519_sub\n91\t#endif\n92\t\n93\tstatic int\n94\tcrypto_scalarmult_curve25519_ref10(unsigned char *q,\n95\t                                   const unsigned char *n,\n96\t                                   const unsigned char *p)\n97\t{\n98\t    unsigned char  t[32];\n99\t    unsigned int   i;\n100\t    fe25519        x1, x2, x3, z2, z3;\n101\t    fe25519        a, b, aa, bb, e, da, cb;\n102\t    int            pos;\n103\t    unsigned int   swap;\n104\t    unsigned int   bit;\n105\t\n106\t    if (has_small_order(p)) {\n107\t        return -1;\n108\t    }\n109\t    for (i = 0; i < 32; i++) {\n110\t        t[i] = n[i];\n111\t    }\n112\t    t[0] &= 248;\n113\t    t[31] &= 127;\n114\t    t[31] |= 64;\n115\t    fe25519_frombytes(x1, p);\n116\t    fe25519_1(x2);\n117\t    fe25519_0(z2);\n118\t    fe25519_copy(x3, x1);\n119\t    fe25519_1(z3);\n120\t\n121\t    swap = 0;\n122\t    for (pos = 254; pos >= 0; --pos) {\n123\t        bit = t[pos / 8] >> (pos & 7);\n124\t        bit &= 1;\n125\t        swap ^= bit;\n126\t        fe25519_cswap(x2, x3, swap);\n127\t        fe25519_cswap(z2, z3, swap);\n128\t        swap = bit;\n129\t        fe25519_add(a, x2, z2);\n130\t        fe25519_sub_lazy(b, x2, z2);\n131\t        fe25519_sq(aa, a);\n132\t        fe25519_sq(bb, b);\n133\t        fe25519_mul(x2, aa, bb);\n134\t        fe25519_sub_lazy(e, aa, bb);\n135\t        fe25519_sub_lazy(da, x3, z3);\n136\t        fe25519_mul(da, da, a);\n137\t        fe25519_add(cb, x3, z3);\n138\t        fe25519_mul(cb, cb, b);\n139\t        fe25519_add(x3, da, cb);\n140\t        fe25519_sq(x3, x3);\n141\t        fe25519_sub_lazy(z3, da, cb);\n142\t        fe25519_sq(z3, z3);\n143\t        fe25519_mul(z3, z3, x1);\n144\t        fe25519_mul32(z2, e, 121666);\n145\t        fe25519_add(z2, z2, bb);\n146\t        fe25519_mul(z2, z2, e);\n147\t    }\n148\t    fe25519_cswap(x2, x3, swap);\n149\t    fe25519_cswap(z2, z3, swap);\n150\t\n151\t    fe25519_invert(z2, z2);\n152\t    fe25519_mul(x2, x2, z2);\n153\t    fe25519_tobytes(q, x2);\n154\t\n155\t    sodium_memzero(t, sizeof t);\n156\t\n157\t    return 0;\n158\t}\n159\t\n160\tstatic void\n161\tedwards_to_montgomery(fe25519 montgomeryX, const fe25519 edwardsY, const fe25519 edwardsZ)\n162\t{\n163\t    fe25519 tempX;\n164\t    fe25519 tempZ;\n165\t\n166\t    fe25519_add(tempX, edwardsZ, edwardsY);\n167\t    fe25519_sub(tempZ, edwardsZ, edwardsY);\n168\t    fe25519_invert(tempZ, tempZ);\n169\t    fe25519_mul(montgomeryX, tempX, tempZ);\n170\t}\n171\t\n172\tstatic int\n173\tcrypto_scalarmult_curve25519_ref10_base(unsigned char *q,\n174\t                                        const unsigned char *n)\n175\t{\n176\t    unsigned char *t = q;\n177\t    ge25519_p3     A;\n178\t    fe25519        pk;\n179\t    unsigned int   i;\n180\t\n181\t    for (i = 0; i < 32; i++) {\n182\t        t[i] = n[i];\n183\t    }\n184\t    t[0] &= 248;\n185\t    t[31] &= 127;\n186\t    t[31] |= 64;\n187\t    ge25519_scalarmult_base(&A, t);\n188\t    edwards_to_montgomery(pk, A.Y, A.Z);\n189\t    fe25519_tobytes(q, pk);\n190\t\n191\t    return 0;\n192\t}\n193\t\n194\tstruct crypto_scalarmult_curve25519_implementation\n195\t    crypto_scalarmult_curve25519_ref10_implementation = {\n196\t        SODIUM_C99(.mult =) crypto_scalarmult_curve25519_ref10,\n197\t        SODIUM_C99(.mult_base =) crypto_scalarmult_curve25519_ref10_base\n198\t    };\n199\t"}]},"parent_tool_use_id":"toolu_bdrk_01Munvuhz8UfSSH5hsMuLebK","session_id":"3f891fde-b339-4353-9d37-1cfde3da52f8","uuid":"6ffe506f-5347-4258-bb39-a1a2365e837a","timestamp":"2026-08-31T03:13:57.693Z","subagent_type":"general-purpose","task_description":"Translate x25519 ref10 scalarmult"}
