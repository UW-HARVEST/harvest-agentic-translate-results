{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DV3Kgy8g43v3BPkuXB7f5F","type":"tool_result","content":"//! Rust translation of libsodium 1.0.23 (`c_src/libsodium`).\n//!\n//! The reference C build defines no `HAVE_*` feature macros, so every\n//! `#ifdef HAVE_*` selects the portable fallback. This translation mirrors\n//! that configuration exactly.\n#![allow(\n    dead_code,\n    non_camel_case_types,\n    non_snake_case,\n    non_upper_case_globals,\n    unused_assignments,\n    unused_mut,\n    unused_unsafe,\n    unused_variables,\n    unused_parens,\n    clippy::all\n)]\n#![no_builtins]\n\n// ---- shared infrastructure ----\npub mod common;\npub mod csys;\npub mod types;\n\n// ---- sodium/ ----\npub mod sodium_codecs;\npub mod sodium_core;\npub mod sodium_runtime;\npub mod sodium_utils;\npub mod sodium_version;\n\n// ---- randombytes/ ----\npub mod randombytes;\npub mod randombytes_internal;\npub mod randombytes_sysrandom;\n\n// ---- crypto_verify/ ----\npub mod verify;\n\n// ---- crypto_core/ ----\npub mod core_ed25519;\npub mod core_hchacha20;\npub mod core_hsalsa20;\npub mod core_salsa;\npub mod ed25519_ref10_fe;\npub mod ed25519_ref10_ge;\npub mod ed25519_ref10_ristretto;\npub mod ed25519_ref10_sc;\npub mod ed25519_ref10_sc_mul;\npub mod ed25519_ref10_sc_muladd;\npub mod ed25519_ref10_sc_reduce;\npub mod ed25519_ref10_tables;\npub mod keccak1600;\npub mod softaes;\n\n// ---- crypto_hash/ ----\npub mod crypto_hash;\npub mod hash_sha256;\npub mod hash_sha3;\npub mod hash_sha512;\n\n// ---- crypto_xof/ ----\npub mod xof;\n\n// ---- crypto_auth/ ----\npub mod auth_hmac;\n\n// ---- crypto_generichash/ ----\npub mod blake2b;\n\n// ---- crypto_onetimeauth/ ----\npub mod poly1305;\n\n// ---- crypto_stream/ ----\npub mod crypto_stream;\npub mod stream_chacha20;\npub mod stream_salsa20;\n\n// ---- crypto_shorthash/ ----\npub mod shorthash;\n\n// ---- crypto_aead/ ----\npub mod aead_aegis128l;\npub mod aead_aegis256;\npub mod aead_aes2