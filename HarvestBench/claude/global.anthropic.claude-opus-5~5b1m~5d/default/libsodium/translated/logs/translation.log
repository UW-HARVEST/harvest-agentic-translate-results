201\t    let f5 = f[5];\n202\t    let f6 = f[6];\n203\t    let f7 = f[7];\n204\t    let f8 = f[8];\n205\t    let f9 = f[9];\n206\t\n207\t    let mut x0 = f0 ^ g[0];\n208\t    let mut x1 = f1 ^ g[1];\n209\t    let mut x2 = f2 ^ g[2];\n210\t    let mut x3 = f3 ^ g[3];\n211\t    let mut x4 = f4 ^ g[4];\n212\t    let mut x5 = f5 ^ g[5];\n213\t    let mut x6 = f6 ^ g[6];\n214\t    let mut x7 = f7 ^ g[7];\n215\t    let mut x8 = f8 ^ g[8];\n216\t    let mut x9 = f9 ^ g[9];\n217\t\n218\t    x0 &= mask as i32;\n219\t    x1 &= mask as i32;\n220\t    x2 &= mask as i32;\n221\t    x3 &= mask as i32;\n222\t    x4 &= mask as i32;\n223\t    x5 &= mask as i32;\n224\t    x6 &= mask as i32;\n225\t    x7 &= mask as i32;\n226\t    x8 &= mask as i32;\n227\t    x9 &= mask as i32;\n228\t\n229\t    f[0] = f0 ^ x0;\n230\t    f[1] = f1 ^ x1;\n231\t    f[2] = f2 ^ x2;\n232\t    f[3] = f3 ^ x3;\n233\t    f[4] = f4 ^ x4;\n234\t    f[5] = f5 ^ x5;\n235\t    f[6] = f6 ^ x6;\n236\t    f[7] = f7 ^ x7;\n237\t    f[8] = f8 ^ x8;\n238\t    f[9] = f9 ^ x9;\n239\t}\n240\t\n241\t/// `fe25519_cswap`\n242\t#[inline]\n243\tpub fn fe25519_cswap(f: &mut fe25519, g: &mut fe25519, b: u32) {\n244\t    let mask: u32 = (b as i64).wrapping_neg() as u32;\n245\t\n246\t    let f0 = f[0];\n247\t    let f1 = f[1];\n248\t    let f2 = f[2];\n249\t    let f3 = f[3];\n250\t    let f4 = f[4];\n251\t    let f5 = f[5];\n252\t    let f6 = f[6];\n253\t    let f7 = f[7];\n254\t    let f8 = f[8];\n255\t    let f9 = f[9];\n256\t\n257\t    let g0 = g[0];\n258\t    let g1 = g[1];\n259\t    let g2 = g[2];\n260\t    let g3 = g[3];\n261\t    let g4 = g[4];\n262\t    let g5 = g[5];\n263\t    let g6 = g[6];\n264\t    let g7 = g[7];\n265\t    let g8 = g[8];\n266\t    let g9 = g[9];\n267\t\n268\t    let mut x0 = f0 ^ g0;\n269\t    let mut x1 = f1 ^ g1;\n270\t    let mut x2 = f2 ^ g2;\n271\t    let mut x3 = f3 ^ g3;\n272\t    let mut x4 = f4 ^ g4;\n273\t    let mut x5 = f5 ^ g5;\n274\t    let mut x6 = f6 ^ g6;\n275\t    let mut x7 = f7 ^ g7;\