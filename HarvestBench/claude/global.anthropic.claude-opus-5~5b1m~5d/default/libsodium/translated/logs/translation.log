5519_mul(&mut x, &h.X, &recip);\n539\t    fe25519_mul(&mut y, &h.Y, &recip);\n540\t    fe25519_tobytes(s, &y);\n541\t    *s.add(31) ^= (fe25519_isnegative(&x) << 7) as u8;\n542\t}\n543\t\n544\t// ---------------------------------------------------------------------------\n545\t// r = a*A + b*B (double scalar multiplication, vartime)\n546\t// ---------------------------------------------------------------------------\n547\t\n548\t/// `void ge25519_double_scalarmult_vartime(ge25519_p2 *r, const unsigned char *a, const ge25519_p3 *A, const unsigned char *b)`\n549\tpub unsafe fn ge25519_double_scalarmult_vartime(\n550\t    r: &mut ge25519_p2,\n551\t    a: *const u8,\n552\t    aa: &ge25519_p3,\n553\t    b: *const u8,\n554\t) {\n555\t    let mut aslide: [i8; 256] = [0; 256];\n556\t    let mut bslide: [i8; 256] = [0; 256];\n557\t    let mut ai: [ge25519_cached; 8] = [ge25519_cached::zero(); 8]; /* A,3A,5A,7A,9A,11A,13A,15A */\n558\t    let mut t: ge25519_p1p1 = ge25519_p1p1::zero();\n559\t    let mut u: ge25519_p3 = ge25519_p3::zero();\n560\t    let mut a2: ge25519_p3 = ge25519_p3::zero();\n561\t\n562\t    let mut a_bytes = [0u8; 32];\n563\t    let mut b_bytes = [0u8; 32];\n564\t    for i in 0..32 {\n565\t        a_bytes[i] = *a.add(i);\n566\t        b_bytes[i] = *b.add(i);\n567\t    }\n568\t\n569\t    slide_vartime(&mut aslide, &a_bytes);\n570\t    slide_vartime(&mut bslide, &b_bytes);\n571\t\n572\t    ge25519_p3_to_cached(&mut ai[0], aa);\n573\t\n574\t    ge25519_p3_dbl(&mut t, aa);\n575\t    ge25519_p1p1_to_p3(&mut a2, &t);\n576\t\n577\t    ge25519_add_cached(&mut t, &a2, &ai[0]);\n578\t    ge25519_p1p1_to_p3(&mut u, &t);\n579\t    ge25519_p3_to_cached(&mut ai[1], &u);\n580\t\n581\t    ge25519_add_cached(&mut t, &a2, &ai[1]);\n582\t    ge25519_p1p1_to_p3(&mut u, &t);\n583\t    ge25519_p3_to_cached(&mut ai[2], &u);\n584\t\n585\t    ge25519_add_cached(&mut t, &a2, &ai[2]);\n586\t    ge25519_p1p1_to_p3(&mut u, &t);\n587\t    ge25519_p3_to_cached(&mut ai[3], &u);\n588\t\n589\t    ge25519_add_cached(&mut t, &a2, &ai[3]);\n590\t    ge25519_p1p1_to_p3(&mut u, &t);\n591\t    ge25519_p3_to_cached(&mut ai[4], &u);\n592\t\n593\t    ge25519_add_cached(&mut t, &a2, &ai[4]);\n594\t    ge25519_p1p1_to_p3(&mut u, &t);\n595\t    ge25519_p3_to_cached(&mut ai[5], &u);\n596\t\n597\t    ge25519_add_cached(&mut t, &a2, &ai[5]);\n598\t    ge25519_p1p1_to_p3(&mut u, &t);\n599\t    ge25519_p3_to_cached(&mut ai[6], &u);\n600\t\n601\t    ge25519_add_cached(&mut t, &a2, &ai[6]);\n602\t    ge25519_p1p1_to_p3(&mut u, &t);\n603\t    ge25519_p3_to_cached(&mut ai[7], &u);\n604\t\n605\t    ge25519_p2_0(r);\n606\t\n607\t    let mut i: i32 = 255;\n608\t    while i >= 0 {\n609\t        if aslide[i as usize] != 0 || bslide[i as usize] != 0 {\n610\t            break;\n611\t        }\n612\t        i -= 1;\n613\t    }\n614\t\n615\t    while i >= 0 {\n616\t        let iu = i as usize;\n617\t        ge25519_p2_dbl(&mut t, r);\n618\t\n619\t        if aslide[iu] > 0 {\n620\t            ge25519_p1p1_to_p3(&mut u, &t);\n621\t            ge25519_add_cached(&mut t, &u, &ai[(aslide[iu] / 2) as usize]);\n622\t        } else if aslide[iu] < 0 {\n623\t            ge25519_p1p1_to_p3(&mut u, &t);\n624\t            ge25519_sub_cached(&mut t, &u, &ai[((-aslide[iu]) / 2) as usize]);\n625\t        }\n626\t\n627\t        if bslide[iu] > 0 {\n628\t            ge25519_p1p1_to_p3(&mut u, &t);\n629\t            ge25519_add_precomp(&mut t, &u, &base2[(bslide[iu] / 2) as usize]);\n630\t        } else if bslide[iu] < 0 {\n631\t            ge25519_p1p1_to_p3(&mut u, &t);\n632\t            ge25519_sub_precomp(&mut t, &u, &base2[((-bslide[iu]) / 2) as usize]);\n633\t        }\n634\t\n635\t        ge25519_p1p1_to_p2(r, &t);\n636\t        i -= 1;\n637\t    }\n638\t}\n639\t\n640\t// ---------------------------------------------------------------------------\n641\t// h = a * p\n642\t// ---------------------------------------------------------------------------\n643\t\n644\t/// `void ge25519_scalarmult(ge25519_p3 *h, const unsigned char *a, const ge25519_p3 *p)`\n645\tpub unsafe fn ge25519_scalarmult(h: &mut ge25519_p3, a: *const u8, p: &ge25519_p3) {\n646\t    let mut e: [i8; 64] = [0; 64];\n647\t    let mut carry: i8;\n648\t    let mut r: ge25519_p1p1 = ge25519_p1p1::zero();\n649\t    let mut s: ge25519_p2 = ge25519_p2::zero();\n650\t    let mut t2: ge25519_p1p1 = ge25519_p1p1::zero();\n651\t    let mut t3: ge25519_p1p1 = ge25519_p1p1::zero();\n652\t    let mut t4: ge25519_p1p1 = ge25519_p1p1::zero();\n653\t    let mut t5: ge25519_p1p1 = ge25519_p1p1::zero();\n654\t    let mut t6: ge25519_p1p1 = ge25519_p1p1::zero();\n655\t    let mut t7: ge25519_p1p1 = ge25519_p1p1::zero();\n656\t    let mut t8: ge25519_p1p1 = ge25519_p1p1::zero();\n657\t    let mut p2: ge25519_p3 = ge25519_p3::zero();\n658\t    let mut p3: ge25519_p3 = ge25519_p3::zero();\n659\t    let mut p4: ge25519_p3 = ge25519_p3::zero();\n660\t    let mut p5: ge25519_p3 = ge25519_p3::zero();\n661\t    let mut p6: ge25519_p3 = ge25519_p3::zero();\n662\t    let mut p7: ge25519_p3 = ge25519_p3::zero();\n663\t    let mut p8: ge25519_p3 = ge25519_p3::zero();\n664\t    let mut pi: [ge25519_cached; 8] = [ge25519_cached::zero(); 8];\n665\t    let mut t: ge25519_cached = ge25519_cached::zero();\n666\t\n667\t    ge25519_p3_to_cached(&mut pi[1 - 1], p); /* p */\n668\t\n669\t    ge25519_p3_dbl(&mut t2, p);\n670\t    ge25519_p1p1_to_p3(&mut p2, &t2);\n671\t    ge25519_p3_to_cached(&mut pi[2 - 1], &p2); /* 2p = 2*p */\n672\t\n673\t    ge25519_add_cached(&mut t3, p, &pi[2 - 1]);\n674\t    ge25519_p1p1_to_p3(&mut p3, &t3);\n675\t    ge25519_p3_to_cached(&mut pi[3 - 1], &p3); /* 3p = 2p+p */\n676\t\n677\t    ge25519_p3_dbl(&mut t4, &p2);\n678\t    ge25519_p1p1_to_p3(&mut p4, &t4);\n679\t    ge25519_p3_to_cached(&mut pi[4 - 1], &p4); /* 4p = 2*2p */\n680\t\n681\t    ge25519_add_cached(&mut t5, p, &pi[4 - 1]);\n682\t    ge25519_p1p1_to_p3(&mut p5, &t5);\n683\t    ge25519_p3_to_cached(&mut pi[5 - 1], &p5); /* 5p = 4p+p */\n684\t\n685\t    ge25519_p3_dbl(&mut t6, &p3);\n686\t    ge25519_p1p1_to_p3(&mut p6, &t6);\n687\t    ge25519_p3_to_cached(&mut pi[6 - 1], &p6); /* 6p = 2*3p */\n688\t\n689\t    ge25519_add_cached(&mut t7, p, &pi[6 - 1]);\n690\t    ge25519_p1p1_to_p3(&mut p7, &t7);\n691\t    ge25519_p3_to_cached(&mut pi[7 - 1], &p7); /* 7p = 6p+p */\n692\t\n693\t    ge25519_p3_dbl(&mut t8, &p4);\n694\t    ge25519_p1p1_to_p3(&mut p8, &t8);\n695\t    ge25519_p3_to_cached(&mut pi[8 - 1], &p8); /* 8p = 2*4p */\n696\t\n697\t    for i in 0..32usize {\n698\t        let ai = *a.add(i);\n699\t        e[2 * i] = ((ai >> 0) & 15) as i8;\n700\t        e[2 * i + 1] = ((ai >> 4) & 15) as i8;\n701\t    }\n702\t    /* each e[i] is between 0 and 15 */\n703\t    /* e[63] is between 0 and 7 */\n704\t\n705\t    carry = 0;\n706\t    for i in 0..63usize {\n707\t        e[i] = e[i].wrapping_add(carry);\n708\t        carry = (e[i] as i32).wrapping_add(8) as i8;\n709\t        carry >>= 4;\n710\t        e[i] = (e[i] as i32).wrapping_sub((carry as i32).wrapping_mul(1i32 << 4)) as i8;\n711\t    }\n712\t    e[63] = e[63].wrapping_add(carry);\n713\t    /* each e[i] is between -8 and 8 */\n714\t\n715\t    ge25519_p3_0(h);\n716\t\n717\t    let mut i: i32 = 63;\n718\t    while i != 0 {\n719\t        let iu = i as usize;\n720\t        ge25519_cmov8_cached(&mut t, &pi, e[iu]);\n721\t        ge25519_add_cached(&mut r, h, &t);\n722\t\n723\t        ge25519_p1p1_to_p2(&mut s, &r);\n724\t        ge25519_p2_dbl(&mut r, &s);\n725\t        ge25519_p1p1_to_p2(&mut s, &r);\n726\t        ge25519_p2_dbl(&mut r, &s);\n727\t        ge25519_p1p1_to_p2(&mut s, &r);\n728\t        ge25519_p2_dbl(&mut r, &s);\n729\t        ge25519_p1p1_to_p2(&mut s, &r);\n730\t        ge25519_p2_dbl(&mut r, &s);\n731\t\n732\t        ge25519_p1p1_to_p3(h, &r); /* *16 */\n733\t        i -= 1;\n734\t    }\n735\t    ge25519_cmov8_cached(&mut t, &pi, e[i as usize]);\n736\t    ge25519_add_cached(&mut r, h, &t);\n737\t\n738\t    ge25519_p1p1_to_p3(h, &r);\n739\t}\n740\t\n741\t// ---------------------------------------------------------------------------\n742\t// h = a * B (base-point scalar multiplication, with precomputation)\n743\t// ---------------------------------------------------------------------------\n744\t\n745\t/// `void ge25519_scalarmult_base(ge25519_p3 *h, const unsigned char *a)`\n746\tpub unsafe fn ge25519_scalarmult_base(h: &mut ge25519_p3, a: *const u8) {\n747\t    let mut e: [i8; 64] = [0; 64];\n748\t    let mut carry: i8;\n749\t    let mut r: ge25519_p1p1 = ge25519_p1p1::zero();\n750\t    let mut s: ge25519_p2 = ge25519_p2::zero();\n751\t    let mut t: ge25519_precomp = ge25519_precomp::zero();\n752\t\n753\t    for i in 0..32usize {\n754\t        let ai = *a.add(i);\n755\t        e[2 * i] = ((ai >> 0) & 15) as i8;\n756\t        e[2 * i + 1] = ((ai >> 4) & 15) as i8;\n757\t    }\n758\t    /* each e[i] is between 0 and 15 */\n759\t    /* e[63] is between 0 and 7 */\n760\t\n761\t    carry = 0;\n762\t    for i in 0..63usize {\n763\t        e[i] = e[i].wrapping_add(carry);\n764\t        carry = (e[i] as i32).wrapping_add(8) as i8;\n765\t        carry >>= 4;\n766\t        e[i] = (e[i] as i32).wrapping_sub((carry as i32).wrapping_mul(1i32 << 4)) as i8;\n767\t    }\n768\t    e[63] = e[63].wrapping_add(carry);\n769\t    /* each e[i] is between -8 and 8 */\n770\t\n771\t    ge25519_p3_0(h);\n772\t\n773\t    let mut i: usize = 1;\n774\t    while i < 64 {\n775\t        ge25519_cmov8_base(&mut t, i / 2, e[i]);\n776\t        ge25519_add_precomp(&mut r, h, &t);\n777\t        ge25519_p1p1_to_p3(h, &r);\n778\t        i += 2;\n779\t    }\n780\t\n781\t    ge25519_p3_dbl(&mut r, h);\n782\t    ge25519_p1p1_to_p2(&mut s, &r);\n783\t    ge25519_p2_dbl(&mut r, &s);\n784\t    ge25519_p1p1_to_p2(&mut s, &r);\n785\t    ge25519_p2_dbl(&mut r, &s);\n786\t    ge25519_p1p1_to_p2(&mut s, &r);\n787\t    ge25519_p2_dbl(&mut r, &s);\n788\t    ge25519_p1p1_to_p3(h, &r);\n789\t\n790\t    let mut i: usize = 0;\n791\t    while i < 64 {\n792\t        ge25519_cmov8_base(&mut t, i / 2, e[i]);\n793\t        ge25519_add_precomp(&mut r, h, &t);\n794\t        ge25519_p1p1_to_p3(h, &r);\n795\t        i += 2;\n796\t    }\n797\t}\n798\t\n799\t// ---------------------------------------------------------------------------\n800\t// ge25519_p3 group law helpers (used by ge25519_mul_l / subgroup checks)\n801\t// ---------------------------------------------------------------------------\n802\t\n803\t/// `static void ge25519_p3p3_dbl(ge25519_p3 *r, const ge25519_p3 *p)` (r = 2p)\n804\tpub fn ge25519_p3p3_dbl(r: &mut ge25519_p3, p: &ge25519_p3) {\n805\t    let mut p1p1: ge25519_p1p1 = ge25519_p1p1::zero();\n806\t\n807\t    ge25519_p3_dbl(&mut p1p1, p);\n808\t    ge25519_p1p1_to_p3(r, &p1p1);\n809\t}\n810\t\n811\t/// `static void ge25519_p3_neg(ge25519_p3 *r, const ge25519_p3 *p)` (r = -p)\n812\tpub fn ge25519_p3_neg(r: &mut ge25519_p3, p: &ge25519_p3) {\n813\t    fe25519_neg(&mut r.X, &p.X);\n814\t    fe25519_copy(&mut r.Y, &p.Y);\n815\t    fe25519_copy(&mut r.Z, &p.Z);\n816\t    fe25519_neg(&mut r.T, &p.T);\n817\t}\n818\t\n819\t/// `void ge25519_p3_add(ge25519_p3 *r, const ge25519_p3 *p, const ge25519_p3 *q)` (r = p+q)\n820\tpub fn ge25519_p3_add(r: &mut ge25519_p3, p: &ge25519_p3, q: &ge25519_p3) {\n821\t    let mut q_cached: ge25519_cached = ge25519_cached::zero();\n822\t    let mut p1p1: ge25519_p1p1 = ge25519_p1p1::zero();\n823\t\n824\t    ge25519_p3_to_cached(&mut q_cached, q);\n825\t    ge25519_add_cached(&mut p1p1, p, &q_cached);\n826\t    ge25519_p1p1_to_p3(r, &p1p1);\n827\t}\n828\t\n829\t/// `void ge25519_p3_sub(ge25519_p3 *r, const ge25519_p3 *p, const ge25519_p3 *q)` (r = p-q)\n830\tpub fn ge25519_p3_sub(r: &mut ge25519_p3, p: &ge25519_p3, q: &ge25519_p3) {\n831\t    let mut q_neg: ge25519_p3 = ge25519_p3::zero();\n832\t\n833\t    ge25519_p3_neg(&mut q_neg, q);\n834\t    ge25519_p3_add(r, p, &q_neg);\n835\t}\n836\t\n837\t/// `static void ge25519_p3_dbladd(ge25519_p3 *r, const int n, const ge25519_p3 *q)` (r = r*(2^n)+q)\n838\tpub fn ge25519_p3_dbladd(r: &mut ge25519_p3, n: c_int, q: &ge25519_p3) {\n839\t    let mut p2: ge25519_p2 = ge25519_p2::zero();\n840\t    let mut p1p1: ge25519_p1p1 = ge25519_p1p1::zero();\n841\t\n842\t    ge25519_p3_to_p2(&mut p2, r);\n843\t    let mut i: c_int = 0;\n844\t    while i < n {\n845\t        ge25519_p2_dbl(&mut p1p1, &p2);\n846\t        ge25519_p1p1_to_p2(&mut p2, &p1p1);\n847\t        i += 1;\n848\t    }\n849\t    ge25519_p1p1_to_p3(r, &p1p1);\n850\t    let rcopy = *r;\n851\t    ge25519_p3_add(r, &rcopy, q);\n852\t}\n853\t\n854\t/// multiply by the order of the main subgroup\n855\t/// l = 2^252+27742317777372353535851937790883648493\n856\t/// `static void ge25519_mul_l(ge25519_p3 *r, const ge25519_p3 *p)`\n857\tpub fn ge25519_mul_l(r: &mut ge25519_p3, p: &ge25519_p3) {\n858\t    let mut _10: ge25519_p3 = ge25519_p3::zero();\n859\t    let mut _11: ge25519_p3 = ge25519_p3::zero();\n860\t    let mut _100: ge25519_p3 = ge25519_p3::zero();\n861\t    let mut _110: ge25519_p3 = ge25519_p3::zero();\n862\t    let mut _1000: ge25519_p3 = ge25519_p3::zero();\n863\t    let mut _1011: ge25519_p3 = ge25519_p3::zero();\n864\t    let mut _10000: ge25519_p3 = ge25519_p3::zero();\n865\t    let mut _100000: ge25519_p3 = ge25519_p3::zero();\n866\t    let mut _100110: ge25519_p3 = ge25519_p3::zero();\n867\t    let mut _1000000: ge25519_p3 = ge25519_p3::zero();\n868\t    let mut _1010000: ge25519_p3 = ge25519_p3::zero();\n869\t    let mut _1010011: ge25519_p3 = ge25519_p3::zero();\n870\t    let mut _1100011: ge25519_p3 = ge25519_p3::zero();\n871\t    let mut _1100111: ge25519_p3 = ge25519_p3::zero();\n872\t    let mut _1101011: ge25519_p3 = ge25519_p3::zero();\n873\t    let mut _10010011: ge25519_p3 = ge25519_p3::zero();\n874\t    let mut _10010111: ge25519_p3 = ge25519_p3::zero();\n875\t    let mut _10111101: ge25519_p3 = ge25519_p3::zero();\n876\t    let mut _11010011: ge25519_p3 = ge25519_p3::zero();\n877\t    let mut _11100111: ge25519_p3 = ge25519_p3