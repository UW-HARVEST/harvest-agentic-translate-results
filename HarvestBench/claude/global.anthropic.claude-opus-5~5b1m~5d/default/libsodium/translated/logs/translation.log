{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Lc7Js4tb6s39jN6vHtdvMg","type":"tool_result","content":"1\t//! Group arithmetic (`ge25519_*`) for ed25519 ref10.\n2\t//!\n3\t//! Translated from\n4\t//! `c_src/libsodium/crypto_core/ed25519/ref10/ed25519_ref10.c`, lines 263..1200\n5\t//! (from `ge25519_add_cached` through `ge25519_has_small_order`).\n6\t//!\n7\t//! `HAVE_TI_MODE` is not defined in the reference build, so `fe25519` is\n8\t//! `int32_t[10]` (`crate::types::fe25519`), matching the `fe_25_5`\n9\t//! representation used by `crate::ed25519_ref10_fe`.\n10\t//!\n11\t//! Field-element helper functions take `&`/`&mut fe25519`. Where the original\n12\t//! C code aliases an output field with one of its own input fields (e.g.\n13\t//! `fe25519_mul(r->Y, r->Y, q->YminusX)`), we copy the aliased field to a\n14\t//! local temporary first and pass that, which is semantically identical since\n15\t//! the C helper functions read all inputs into locals before writing the\n16\t//! output.\n17\t\n18\t#![allow(non_snake_case)]\n19\t\n20\tuse crate::ed25519_ref10_fe::*;\n21\tuse crate::ed25519_ref10_tables::{base, base2, ed25519_d, ed25519_d2, fe25519_sqrtm1};\n22\tuse crate::types::{fe25519, ge25519_cached, ge25519_p1p1, ge25519_p2, ge25519_p3, ge25519_precomp};\n23\tuse core::ffi::c_int;\n24\t\n25\t/// `static volatile unsigned char optblocker_u8;`\n26\t///\n27\t/// In the C source this is a volatile static used purely as a compiler\n28\t/// optimization blocker (it is never written anywhere in the file, so its\n29\t/// value is always 0). We reproduce it as a plain (never-mutated) static so\n30\t/// the arithmetic in `equal`/`negative`/`ge25519_frombytes` matches exactly,\n31\t/// without needing `unsafe` to read it.\n32\tstatic OPTBLOCKER_U8: u8 = 0;\n33\t\n34\t// ---------------------------------------------------------------------------\n35\t// r = p + q\n36\t// ---------------------------------------------------------------------------\n37\t\n38\t/// `static void ge25519_add_cached(ge25519_p1p1 *r, const ge25519_p3 *p, const ge25519_cached *q)`\n39\tpub fn ge25519_add_cached(r: &mut ge25519_p1p1, p: &ge25519_p3, q: &ge25519_cached) {\n40\t    let mut t0: fe25519 = [0i32; 10];\n41\t\n42\t    fe25519_add(&mut r.X, &p.Y, &p.X);\n43\t    fe25519_sub(&mut r.Y, &p.Y, &p.X);\n44\t    fe25519_mul(&mut r.Z, &r.X, &q.YplusX);\n45\t    {\n46\t        let ry = r.Y;\n47\t        fe25519_mul(&mut r.Y, &ry, &q.YminusX);\n48\t    }\n49\t    fe25519_mul(&mut r.T, &q.T2d, &p.T);\n50\t    fe25519_mul(&mut r.X, &p.Z, &q.Z);\n51\t    fe25519_add(&mut t0, &r.X, &r.X);\n52\t    fe25519_sub(&mut r.X, &r.Z, &r.Y);\n53\t    {\n54\t        let ry = r.Y;\n55\t        fe25519_add(&mut r.Y, &r.Z, &ry);\n56\t    }\n57\t    fe25519_add(&mut r.Z, &t0, &r.T);\n58\t    {\n59\t        let rt = r.T;\n60\t        fe25519_sub(&mut r.T, &t0, &rt);\n61\t    }\n62\t}\n63\t\n64\t/// `static void slide_vartime(signed char *r, const unsigned char *a)`\n65\tpub fn slide_vartime(r: &mut [i8; 256], a: &[u8; 32]) {\n66\t    for i in 0..256 {\n67\t        r[i] = (1 & (a[i >> 3] >> (i & 7))) as i8;\n68\t    }\n69\t    for i in 0..256 {\n70\t        if r[i] == 0 {\n71\t            continue;\n72\t        }\n73\t        let mut b = 1i32;\n74\t        while b <= 6 && i + (b as usize) < 256 {\n75\t            let bu = b as usize;\n76\t            if r[i + bu] == 0 {\n77\t                b += 1;\n78\t                continue;\n79\t            }\n80\t            let ribs: i32 = (r[i + bu] as i32).wrapping_shl(b as u32);\n81\t            let mut cmp: i32 = (r[i] as i32).wrapping_add(ribs);\n82\t            if cmp <= 15 {\n83\t                r[i] = cmp as i8;\n84\t                r[i + bu] = 0;\n85\t            } else {\n86\t                cmp = (r[i] as i32).wrapping_sub(ribs);\n87\t                if cmp < -15 {\n88\t                    break;\n89\t                }\n90\t                r[i] = cmp as i8;\n91\t                let mut k = i + bu;\n92\t                while k < 256 {\n93\t                    if r[k] == 0 {\n94\t                        r[k] = 1;\n95\t                        break;\n96\t                    }\n97\t                    r[k] = 0;\n98\t                    k += 1;\n99\t                }\n100\t            }\n101\t            b += 1;\n102\t        }\n103\t    }\n104\t}\n105\t\n106\t// ---------------------------------------------------------------------------\n107\t// ge25519_frombytes / ge25519_frombytes_negate_vartime\n108\t// ---------------------------------------------------------------------------\n109\t\n110\t/// `int ge25519_frombytes(ge25519_p3 *h, const unsigned char *s)`\n111\tpub unsafe fn ge25519_frombytes(h: &mut ge25519_p3, s: *const u8) -> c_int {\n112\t    let mut u: fe25519 = [0i32; 10];\n113\t    let mut v: fe25519 = [0i32; 10];\n114\t    let mut vxx: fe25519 = [0i32; 10];\n115\t    let mut m_root_check: fe25519 = [0i32; 10];\n116\t    let mut p_root_check: fe25519 = [0i32; 10];\n117\t    let mut negx: fe25519 = [0i32; 10];\n118\t    let mut x_sqrtm1: fe25519 = [0i32; 10];\n119\t\n120\t    fe25519_frombytes(&mut h.Y, s);\n121\t    fe25519_1(&mut h.Z);\n122\t    fe25519_sq(&mut u, &h.Y);\n123\t    fe25519_mul(&mut v, &u, &ed25519_d);\n124\t    {\n125\t        let uu = u;\n126\t        fe25519_sub(&mut u, &uu, &h.Z); /* u = y^2-1 */\n127\t    }\n128\t    {\n129\t        let vv = v;\n130\t        fe25519_add(&mut v, &vv, &h.Z); /* v = dy^2+1 */\n131\t    }\n132\t\n133\t    fe25519_mul(&mut h.X, &u, &v);\n134\t    {\n135\t        let hx = h.X;\n136\t        fe25519_pow22523(&mut h.X, &hx);\n137\t    }\n138\t    {\n139\t        let hx = h.X;\n140\t        fe25519_mul(&mut h.X, &u, &hx); /* u((uv)^((q-5)/8)) */\n141\t    }\n142\t\n143\t    fe25519_sq(&mut vxx, &h.X);\n144\t    {\n145\t        let vxx0 = vxx;\n146\t        fe25519_mul(&mut vxx, &vxx0, &v);\n147\t    }\n148\t    fe25519_sub(&mut m_root_check, &vxx, &u); /* vx^2-u */\n149\t    fe25519_add(&mut p_root_check, &vxx, &u); /* vx^2+u */\n150\t    let has_m_root: c_int = fe25519_iszero(&m_root_check);\n151\t    let has_p_root: c_int = fe25519_iszero(&p_root_check);\n152\t    fe25519_mul(&mut x_sqrtm1, &h.X, &fe25519_sqrtm1); /* x*sqrt(-1) */\n153\t    fe25519_cmov(&mut h.X, &x_sqrtm1, (1 - has_m_root) as u32);\n154\t\n155\t    fe25519_neg(&mut negx, &h.X);\n156\t    let cond: u32 = (fe25519_isnegative(&h.X) ^ (((*s.add(31) >> 5) as c_int) ^ (OPTBLOCKER_U8 as c_int)) >> 2) as u32;\n157\t    fe25519_cmov(&mut h.X, &negx, cond);\n158\t    fe25519_mul(&mut h.T, &h.X, &h.Y);\n159\t\n160\t    (has_m_root | has_p_root) - 1\n161\t}\n162\t\n163\t/// `int ge25519_frombytes_negate_vartime(ge25519_p3 *h, const unsigned char *s)`\n164\tpub unsafe fn ge25519_frombytes_negate_vartime(h: &mut ge25519_p3, s: *const u8) -> c_int {\n165\t    let mut u: fe25519 = [0i32; 10];\n166\t    let mut v: fe25519 = [0i32; 10];\n167\t    let mut v3: fe25519 = [0i32; 10];\n168\t    let mut vxx: fe25519 = [0i32; 10];\n169\t    let mut m_root_check: fe25519 = [0i32; 10];\n170\t    let mut p_root_check: fe25519 = [0i32; 10];\n171\t\n172\t    fe25519_frombytes(&mut h.Y, s);\n173\t    fe25519_1(&mut h.Z);\n174\t    fe25519_sq(&mut u, &h.Y);\n175\t    fe25519_mul(&mut v, &u, &ed25519_d);\n176\t    {\n177\t        let uu = u;\n178\t        fe25519_sub(&mut u, &uu, &h.Z); /* u = y^2-1 */\n179\t    }\n180\t    {\n181\t        let vv = v;\n182\t        fe25519_add(&mut v, &vv, &h.Z); /* v = dy^2+1 */\n183\t    }\n184\t\n185\t    fe25519_sq(&mut v3, &v);\n186\t    {\n187\t        let v3v = v3;\n188\t        fe25519_mul(&mut v3, &v3v, &v); /* v3 = v^3 */\n189\t    }\n190\t    fe25519_sq(&mut h.X, &v3);\n191\t    {\n192\t        let hx = h.X;\n193\t        fe25519_mul(&mut h.X, &hx, &v);\n194\t    }\n195\t    {\n196\t        let hx = h.X;\n197\t        fe25519_mul(&mut h.X, &hx, &u); /* x = uv^7 */\n198\t    }\n199\t\n200\t    {\n201\t        let hx = h.X;\n202\t        fe25519_pow22523(&mut h.X, &hx); /* x = (uv^7)^((q-5)/8) */\n203\t    }\n204\t    {\n205\t        let hx = h.X;\n206\t        fe25519_mul(&mut h.X, &hx, &v3);\n207\t    }\n208\t    {\n209\t        let hx = h.X;\n210\t        fe25519_mul(&mut h.X, &hx, &u); /* x = uv^3(uv^7)^((q-5)/8) */\n211\t    }\n212\t\n213\t    fe25519_sq(&mut vxx, &h.X);\n214\t    {\n215\t        let vxx0 = vxx;\n216\t        fe25519_mul(&mut vxx, &vxx0, &v);\n217\t    }\n218\t    fe25519_sub(&mut m_root_check, &vxx, &u); /* vx^2-u */\n219\t    if fe25519_iszero(&m_root_check) == 0 {\n220\t        fe25519_add(&mut p_root_check, &vxx, &u); /* vx^2+u */\n221\t        if fe25519_iszero(&p_root_check) == 0 {\n222\t            return -1;\n223\t        }\n224\t        let hx = h.X;\n225\t        fe25519_mul(&mut h.X, &hx, &fe25519_sqrtm1);\n226\t    }\n227\t\n228\t    if fe25519_isnegative(&h.X) == ((*s.add(31) >> 7) as c_int) {\n229\t        /* vartime function - compiler optimization is fine */\n230\t        let hx = h.X;\n231\t        fe25519_neg(&mut h.X, &hx);\n232\t    }\n233\t    fe25519_mul(&mut h.T, &h.X, &h.Y);\n234\t\n235\t    0\n236\t}\n237\t\n238\t// ---------------------------------------------------------------------------\n239\t// r = p + q / r = p - q (precomp)\n240\t// ---------------------------------------------------------------------------\n241\t\n242\t/// `static void ge25519_add_precomp(ge25519_p1p1 *r, const ge25519_p3 *p, const ge25519_precomp *q)`\n243\tpub fn ge25519_add_precomp(r: &mut ge25519_p1p1, p: &ge25519_p3, q: &ge25519_precomp) {\n244\t    let mut t0: fe25519 = [0i32; 10];\n245\t\n246\t    fe25519_add(&mut r.X, &p.Y, &p.X);\n247\t    fe25519_sub(&mut r.Y, &p.Y, &p.X);\n248\t    fe25519_mul(&mut r.Z, &r.X, &q.yplusx);\n249\t    {\n250\t        let ry = r.Y;\n251\t        fe25519_mul(&mut r.Y, &ry, &q.yminusx);\n252\t    }\n253\t    fe25519_mul(&mut r.T, &q.xy2d, &p.T);\n254\t    fe25519_add(&mut t0, &p.Z, &p.Z);\n255\t    fe25519_sub(&mut r.X, &r.Z, &r.Y);\n256\t    {\n257\t        let ry = r.Y;\n258\t        fe25519_add(&mut r.Y, &r.Z, &ry);\n259\t    }\n260\t    fe25519_add(&mut r.Z, &t0, &r.T);\n261\t    {\n262\t        let rt = r.T;\n263\t        fe25519_sub(&mut r.T, &t0, &rt);\n264\t    }\n265\t}\n266\t\n267\t/// `static void ge25519_sub_precomp(ge25519_p1p1 *r, const ge25519_p3 *p, const ge25519_precomp *q)`\n268\tpub fn ge25519_sub_precomp(r: &mut ge25519_p1p1, p: &ge25519_p3, q: &ge25519_precomp) {\n269\t    let mut t0: fe25519 = [0i32; 10];\n270\t\n271\t    fe25519_add(&mut r.X, &p.Y, &p.X);\n272\t    fe25519_sub(&mut r.Y, &p.Y, &p.X);\n273\t    fe25519_mul(&mut r.Z, &r.X, &q.yminusx);\n274\t    {\n275\t        let ry = r.Y;\n276\t        fe25519_mul(&mut r.Y, &ry, &q.yplusx);\n277\t    }\n278\t    fe25519_mul(&mut r.T, &q.xy2d, &p.T);\n279\t    fe25519_add(&mut t0, &p.Z, &p.Z);\n280\t    fe25519_sub(&mut r.X, &r.Z, &r.Y);\n281\t    {\n282\t        let ry = r.Y;\n283\t        fe25519_add(&mut r.Y, &r.Z, &ry);\n284\t    }\n285\t    fe25519_sub(&mut r.Z, &t0, &r.T);\n286\t    {\n287\t        let rt = r.T;\n288\t        fe25519_add(&mut r.T, &t0, &rt);\n289\t    }\n290\t}\n291\t\n292\t// ---------------------------------------------------------------------------\n293\t// r = p (conversions)\n294\t// ---------------------------------------------------------------------------\n295\t\n296\t/// `void ge25519_p1p1_to_p2(ge25519_p2 *r, const ge25519_p1p1 *p)`\n297\tpub fn ge25519_p1p1_to_p2(r: &mut ge25519_p2, p: &ge25519_p1p1) {\n298\t    fe25519_mul(&mut r.X, &p.X, &p.T);\n299\t    fe25519_mul(&mut r.Y, &p.Y, &p.Z);\n300\t    fe25519_mul(&mut r.Z, &p.Z, &p.T);\n301\t}\n302\t\n303\t/// `void ge25519_p1p1_to_p3(ge25519_p3 *r, const ge25519_p1p1 *p)`\n304\tpub fn ge25519_p1p1_to_p3(r: &mut ge25519_p3, p: &ge25519_p1p1) {\n305\t    fe25519_mul(&mut r.X, &p.X, &p.T);\n306\t    fe25519_mul(&mut r.Y, &p.Y, &p.Z);\n307\t    fe25519_mul(&mut r.Z, &p.Z, &p.T);\n308\t    fe25519_mul(&mut r.T, &p.X, &p.Y);\n309\t}\n310\t\n311\t/// `void ge25519_p2_to_p3(ge25519_p3 *r, const ge25519_p2 *p)`\n312\tpub fn ge25519_p2_to_p3(r: &mut ge25519_p3, p: &ge25519_p2) {\n313\t    fe25519_copy(&mut r.X, &p.X);\n314\t    fe25519_copy(&mut r.Y, &p.Y);\n315\t    fe25519_copy(&mut r.Z, &p.Z);\n316\t    fe25519_mul(&mut r.T, &p.X, &p.Y);\n317\t}\n318\t\n319\t/// `static void ge25519_p2_0(ge25519_p2 *h)`\n320\tpub fn ge25519_p2_0(h: &mut ge25519_p2) {\n321\t    fe25519_0(&mut h.X);\n322\t    fe25519_1(&mut h.Y);\n323\t    fe25519_1(&mut h.Z);\n324\t}\n325\t\n326\t/// `static void ge25519_p2_dbl(ge25519_p1p1 *r, const ge25519_p2 *p)` (r = 2*p)\n327\tpub fn ge25519_p2_dbl(r: &mut ge25519_p1p1, p: &ge25519_p2) {\n328\t    let mut t0: fe25519 = [0i32; 10];\n329\t\n330\t    fe25519_sq(&mut r.X, &p.X);\n331\t    fe25519_sq(&mut r.Z, &p.Y);\n332\t    fe25519_sq2(&mut r.T, &p.Z);\n333\t    fe25519_add(&mut r.Y, &p.X, &p.Y);\n334\t    fe25519_sq(&mut t0, &r.Y);\n335\t    fe25519_add(&mut r.Y, &r.Z, &r.X);\n336\t    fe25519_sub(&mut r.Z, &r.Z, &r.X);\n337\t    fe25519_sub(&mut r.X, &t0, &r.Y);\n338\t    fe25519_sub(&mut r.T, &r.T, &r.Z);\n339\t}\n340\t\n341\t/// `static void ge25519_p3_0(ge25519_p3 *h)`\n342\tpub fn ge25519_p3_0(h: &mut ge25519_p3) {\n343\t    fe25519_0(&mut h.X);\n344\t    fe25519_1(&mut h.Y);\n345\t    fe25519_1(&mut h.Z);\n346\t    fe25519_0(&mut h.T);\n347\t}\n348\t\n349\t/// `static void ge25519_cached_0(ge25519_cached *h)`\n350\tpub fn ge25519_cached_0(h: &mut ge25519_cached) {\n351\t    fe25519_1(&mut h.YplusX);\n352\t    fe25519_1(&mut h.YminusX);\n353\t    fe25519_1(&mut h.Z);\n354\t    fe25519_0(&mut h.T2d);\n355\t}\n356\t\n357\t/// `static void ge25519_p3_to_cached(ge25519_cached *r, const ge25519_p3 *p)`\n358\tpub fn ge25519_p3_to_cached(r: &mut ge25519_cached, p: &ge25519_p3) {\n359\t    fe25519_add(&mut r.YplusX, &p.Y, &p.X);\n360\t    fe25519_sub(&mut r.YminusX, &p.Y, &p.X);\n361\t    fe25519_copy(&mut r.Z, &p.Z);\n362\t    fe25519_mul(&mut r.T2d, &p.T, &ed25519_d2);\n363\t}\n364\t\n365\t/// `static void ge25519_p3_to_precomp(ge25519_precomp *pi, const ge25519_p3 *p)`\n366\tpub fn ge25519_p3_to_precomp(pi: &mut ge25519_precomp, p: &ge25519_p3) {\n367\t    let mut recip: fe25519 = [0i32; 10];\n368\t    let mut x: fe25519 = [0i32; 10];\n369\t    let mut y: fe25519 = [0i32; 10];\n370\t    let mut xy: fe25519 = [0i32; 10];\n371\t\n372\t    fe25519_invert(&mut recip, &p.Z);\n373\t    fe25519_mul(&mut x, &p.X, &recip);\n374\t    fe25519_mul(&mut y, &p.Y, &recip);\n375\t    fe25519_add(&mut pi.yplusx, &y, &x);\n376\t    fe25519_sub(&mut pi.yminusx, &y, &x);\n377\t    fe25519_mul(&mut xy, &x, &y);\n378\t    fe25519_mul(&mut pi.xy2d, &xy, &ed25519_d2);\n379\t}\n380\t\n381\t/// `static void ge25519_p3_to_p2(ge25519_p2 *r, const ge25519_p3 *p)`\n382\tpub fn ge25519_p3_to_p2(r: &mut ge25519_p2, p: &ge25519_p3) {\n383\t    fe25519_copy(&mut r.X, &p.X);\n384\t    fe25519_copy(&mut r.Y, &p.Y);\n385\t    fe25519_copy(&mut r.Z, &p.Z);\n386\t}\n387\t\n388\t/// `void ge25519_p3_tobytes(unsigned char *s, const ge25519_p3 *h)`\n389\tpub unsafe fn ge25519_p3_tobytes(s: *mut u8, h: &ge25519_p3) {\n390\t    let mut recip: fe25519 = [0i32; 10];\n391\t    let mut x: fe25519 = [0i32; 10];\n392\t    let mut y: fe25519 = [0i32; 10];\n393\t\n394\t    fe25519_invert(&mut recip, &h.Z);\n395\t    fe25519_mul(&mut x, &h.X, &recip);\n396\t    fe25519_mul(&mut y, &h.Y, &recip);\n397\t    fe25519_tobytes(s, &y);\n398\t    *s.add(31) ^= (fe25519_isnegative(&x) << 7) as u8;\n399\t}\n400\t\n401\t/// `static void ge25519_p3_dbl(ge25519_p1p1 *r, const ge25519_p3 *p)` (r = 2*p)\n402\tpub fn ge25519_p3_dbl(r: &mut ge25519_p1p1, p: &ge25519_p3) {\n403\t    let mut q: ge25519_p2 = ge25519_p2::zero();\n404\t    ge25519_p3_to_p2(&mut q, p);\n405\t    ge25519_p2_dbl(r, &q);\n406\t}\n407\t\n408\t/// `static void ge25519_precomp_0(ge25519_precomp *h)`\n409\tpub fn ge25519_precomp_0(h: &mut ge25519_precomp) {\n410\t    fe25519_1(&mut h.yplusx);\n411\t    fe25519_1(&mut h.yminusx);\n412\t    fe25519_0(&mut h.xy2d);\n413\t}\n414\t\n415\t// ---------------------------------------------------------------------------\n416\t// constant-time helpers\n417\t// ---------------------------------------------------------------------------\n418\t\n419\t/// `static unsigned char equal(signed char b, signed char c)`\n420\t///\n421\t/// (non-x86_64/aarch64 inline-asm fallback path, since no `HAVE_INLINE_ASM`\n422\t/// is defined for this build configuration.)\n423\tpub fn equal(b: i8, c: i8) -> u8 {\n424\t    let x: u8 = (b as u8) ^ (c as u8); /* 0: yes; 1..255: no */\n425\t    let mut y: u32 = x as u32; /* 0: yes; 1..255: no */\n426\t\n427\t    y = y.wrapping_sub(1);\n428\t    (((y >> 29) as u8 ^ OPTBLOCKER_U8) >> 2) as u8 /* 1: yes; 0: no */\n429\t}\n430\t\n431\t/// `static unsigned char negative(signed char b)`\n432\tpub fn negative(b: i8) -> u8 {\n433\t    let x: u8 = b as u8; /* 0..127: no 128..255: yes */\n434\t    ((x >> 5) ^ OPTBLOCKER_U8) >> 2 /* 1: yes; 0: no */\n435\t}\n436\t\n437\t/// `static void ge25519_cmov(ge25519_precomp *t, const ge25519_precomp *u, unsigned char b)`\n438\tpub fn ge25519_cmov(t: &mut ge25519_precomp, u: &ge25519_precomp, b: u8) {\n439\t    fe25519_cmov(&mut t.yplusx, &u.yplusx, b as u32);\n440\t    fe25519_cmov(&mut t.yminusx, &u.yminusx, b as u32);\n441\t    fe25519_cmov(&mut t.xy2d, &u.xy2d, b as u32);\n442\t}\n443\t\n444\t/// `static void ge25519_cmov_cached(ge25519_cached *t, const ge25519_cached *u, unsigned char b)`\n445\tpub fn ge25519_cmov_cached(t: &mut ge25519_cached, u: &ge25519_cached, b: u8) {\n446\t    fe25519_cmov(&mut t.YplusX, &u.YplusX, b as u32);\n447\t    fe25519_cmov(&mut t.YminusX, &u.YminusX, b as u32);\n448\t    fe25519_cmov(&mut t.Z, &u.Z, b as u32);\n449\t    fe25519_cmov(&mut t.T2d, &u.T2d, b as u32);\n450\t}\n451\t\n452\t/// `static void ge25519_cmov8(ge25519_precomp *t, const ge25519_precomp precomp[8], const signed char b)`\n453\tpub fn ge25519_cmov8(t: &mut ge25519_precomp, precomp: &[ge25519_precomp; 8], b: i8) {\n454\t    let mut minust: ge25519_precomp = ge25519_precomp::ze