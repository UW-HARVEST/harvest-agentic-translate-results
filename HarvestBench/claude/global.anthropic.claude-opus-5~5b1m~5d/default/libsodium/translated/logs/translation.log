e25519_1(&mut h.yminusx);\n418\t    fe25519_0(&mut h.xy2d);\n419\t}\n420\t\n421\t// ---------------------------------------------------------------------------\n422\t// constant-time helpers\n423\t// ---------------------------------------------------------------------------\n424\t\n425\t/// `static unsigned char equal(signed char b, signed char c)`\n426\t///\n427\t/// (non-x86_64/aarch64 inline-asm fallback path, since no `HAVE_INLINE_ASM`\n428\t/// is defined for this build configuration.)\n429\tpub fn equal(b: i8, c: i8) -> u8 {\n430\t    let x: u8 = (b as u8) ^ (c as u8); /* 0: yes; 1..255: no */\n431\t    let mut y: u32 = x as u32; /* 0: yes; 1..255: no */\n432\t\n433\t    y = y.wrapping_sub(1);\n434\t    (((y >> 29) as u8 ^ OPTBLOCKER_U8) >> 2) as u8 /* 1: yes; 0: no */\n435\t}\n436\t\n437\t/// `static unsigned char negative(signed char b)`\n438\tpub fn negative(b: i8) -> u8 {\n439\t    let x: u8 = b as u8; /* 0..127: no 128..255: yes */\n440\t    ((x >> 5) ^ OPTBLOCKER_U8) >> 2 /* 1: yes; 0: no */\n441\t}\n442\t\n443\t/// `static void ge25519_cmov(ge25519_precomp *t, const ge25519_precomp *u, unsigned char b)`\n444\tpub fn ge25519_cmov(t: &mut ge25519_precomp, u: &ge25519_precomp, b: u8) {\n445\t    fe25519_cmov(&mut t.yplusx, &u.yplusx, b as u32);\n446\t    fe25519_cmov(&mut t.yminusx, &u.yminusx, b as u32);\n447\t    fe25519_cmov(&mut t.xy2d, &u.xy2d, b as u32);\n448\t}\n449\t\n450\t/// `static void ge25519_cmov_cached(ge25519_cached *t, const ge25519_cached *u, unsigned char b)`\n451\tpub fn ge25519_cmov_cached(t: &mut ge25519_cached, u: &ge25519_cached, b: u8) {\n452\t    fe25519_cmov(&mut t.YplusX, &u.YplusX, b as u32);\n453\t    fe25519_cmov(&mut t.YminusX, &u.YminusX, b as u32);\n454\t    fe25519_cmov(&mut t.Z, &u.Z, b as u32);\n455\t    fe25519_cmov(&mut t.T2d, &u.T2d, b as u32);\n456\t}\n457\t\n458\t/// `static void ge25519_cmov8(ge25519_precomp *t, const ge25519_precomp precomp[8], const signed char b)`\n459\tpub fn ge25519_cmov8(t: &mut ge25519_pre