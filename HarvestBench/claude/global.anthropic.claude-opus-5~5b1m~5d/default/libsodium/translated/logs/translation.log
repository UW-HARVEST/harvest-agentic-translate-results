{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011GpjJKN1k3NBn7Vuucp6vg","type":"tool_result","content":"1\t//! Translation of `include/sodium/private/common.h`.\n2\t//!\n3\t//! Note: the reference build defines neither `NATIVE_LITTLE_ENDIAN` nor\n4\t//! `NATIVE_BIG_ENDIAN`, so the portable byte-wise paths are used. On a\n5\t//! little-endian host these produce identical results either way.\n6\t#![allow(dead_code)]\n7\t\n8\t#[inline(always)]\n9\tpub fn rotl32(x: u32, b: i32) -> u32 {\n10\t    (x << b) | (x >> (32 - b))\n11\t}\n12\t\n13\t#[inline(always)]\n14\tpub fn rotl64(x: u64, b: i32) -> u64 {\n15\t    (x << b) | (x >> (64 - b))\n16\t}\n17\t\n18\t#[inline(always)]\n19\tpub fn rotr32(x: u32, b: i32) -> u32 {\n20\t    (x >> b) | (x << (32 - b))\n21\t}\n22\t\n23\t#[inline(always)]\n24\tpub fn rotr64(x: u64, b: i32) -> u64 {\n25\t    (x >> b) | (x << (64 - b))\n26\t}\n27\t\n28\t#[inline(always)]\n29\tpub unsafe fn load64_le(src: *const u8) -> u64 {\n30\t    let mut w = *src.add(0) as u64;\n31\t    w |= (*src.add(1) as u64) << 8;\n32\t    w |= (*src.add(2) as u64) << 16;\n33\t    w |= (*src.add(3) as u64) << 24;\n34\t    w |= (*src.add(4) as u64) << 32;\n35\t    w |= (*src.add(5) as u64) << 40;\n36\t    w |= (*src.add(6) as u64) << 48;\n37\t    w |= (*src.add(7) as u64) << 56;\n38\t    w\n39\t}\n40\t\n41\t#[inline(always)]\n42\tpub unsafe fn store64_le(dst: *mut u8, mut w: u64) {\n43\t    *dst.add(0) = w as u8;\n44\t    w >>= 8;\n45\t    *dst.add(1) = w as u8;\n46\t    w >>= 8;\n47\t    *dst.add(2) = w as u8;\n48\t    w >>= 8;\n49\t    *dst.add(3) = w as u8;\n50\t    w >>= 8;\n51\t    *dst.add(4) = w as u8;\n52\t    w >>= 8;\n53\t    *dst.add(5) = w as u8;\n54\t    w >>= 8;\n55\t    *dst.add(6) = w as u8;\n56\t    w >>= 8;\n57\t    *dst.add(7) = w as u8;\n58\t}\n59\t\n60\t#[inline(always)]\n61\tpub unsafe fn load32_le(src: *const u8) -> u32 {\n62\t    let mut w = *src.add(0) as u32;\n63\t    w |= (*src.add(1) as u32) << 8;\n64\t    w |=