24\t/// `void fe25519_tobytes(unsigned char *s, const fe25519 h)`\n1325\t#[inline]\n1326\tpub unsafe fn fe25519_tobytes(s: *mut u8, h: &fe25519) {\n1327\t    let mut t: fe25519 = [0i32; 10];\n1328\t    fe25519_reduce(&mut t, h);\n1329\t\n1330\t    *s = (t[0] >> 0) as u8;\n1331\t    *s.add(1) = (t[0] >> 8) as u8;\n1332\t    *s.add(2) = (t[0] >> 16) as u8;\n1333\t    *s.add(3) = ((t[0] >> 24) | (t[1].wrapping_mul(1i32 << 2))) as u8;\n1334\t    *s.add(4) = (t[1] >> 6) as u8;\n1335\t    *s.add(5) = (t[1] >> 14) as u8;\n1336\t    *s.add(6) = ((t[1] >> 22) | (t[2].wrapping_mul(1i32 << 3))) as u8;\n1337\t    *s.add(7) = (t[2] >> 5) as u8;\n1338\t    *s.add(8) = (t[2] >> 13) as u8;\n1339\t    *s.add(9) = ((t[2] >> 21) | (t[3].wrapping_mul(1i32 << 5))) as u8;\n1340\t    *s.add(10) = (t[3] >> 3) as u8;\n1341\t    *s.add(11) = (t[3] >> 11) as u8;\n1342\t    *s.add(12) = ((t[3] >> 19) | (t[4].wrapping_mul(1i32 << 6))) as u8;\n1343\t    *s.add(13) = (t[4] >> 2) as u8;\n1344\t    *s.add(14) = (t[4] >> 10) as u8;\n1345\t    *s.add(15) = (t[4] >> 18) as u8;\n1346\t    *s.add(16) = (t[5] >> 0) as u8;\n1347\t    *s.add(17) = (t[5] >> 8) as u8;\n1348\t    *s.add(18) = (t[5] >> 16) as u8;\n1349\t    *s.add(19) = ((t[5] >> 24) | (t[6].wrapping_mul(1i32 << 1))) as u8;\n1350\t    *s.add(20) = (t[6] >> 7) as u8;\n1351\t    *s.add(21) = (t[6] >> 15) as u8;\n1352\t    *s.add(22) = ((t[6] >> 23) | (t[7].wrapping_mul(1i32 << 3))) as u8;\n1353\t    *s.add(23) = (t[7] >> 5) as u8;\n1354\t    *s.add(24) = (t[7] >> 13) as u8;\n1355\t    *s.add(25) = ((t[7] >> 21) | (t[8].wrapping_mul(1i32 << 4))) as u8;\n1356\t    *s.add(26) = (t[8] >> 4) as u8;\n1357\t    *s.add(27) = (t[8] >> 12) as u8;\n1358\t    *s.add(28) = ((t[8] >> 20) | (t[9].wrapping_mul(1i32 << 6))) as u8;\n1359\t    *s.add(29) = (t[9] >> 2) as u8;\n1360\t    *s.add(30) = (t[9] >> 10) as u8;\n1361\t    *s.add(31) = (t[9] >> 18) as u8;\n1362\t}\n1363\t\n1364\t// ---------------------------------------------------------------------------\n