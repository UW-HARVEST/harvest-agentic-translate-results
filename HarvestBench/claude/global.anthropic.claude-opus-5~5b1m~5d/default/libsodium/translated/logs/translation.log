\n163\t    ARGON2_ADDRESSES_IN_BLOCK = 128,\n164\t\n165\t\n166\t    ARGON2_PREHASH_DIGEST_LENGTH = 64,\n167\t    ARGON2_PREHASH_SEED_LENGTH = 72\n168\t};\n169\ttypedef struct block_ {\n170\t    uint64_t v[ARGON2_QWORDS_IN_BLOCK];\n171\t} block;\n172\t\n173\ttypedef struct block_region_ {\n174\t    void * base;\n175\t    block *memory;\n176\t    size_t size;\n177\t} block_region;\n178\t\n179\t\n180\t\n181\t\n182\tstatic inline void\n183\tinit_block_value(block *b, uint8_t in)\n184\t{\n185\t    memset(b->v, in, sizeof(b->v));\n186\t}\n187\t\n188\t\n189\tstatic inline void\n190\tcopy_block(block *dst, const block *src)\n191\t{\n192\t    memcpy(dst->v, src->v, sizeof(uint64_t) * ARGON2_QWORDS_IN_BLOCK);\n193\t}\n194\t\n195\t\n196\tstatic inline void\n197\txor_block(block *dst, const block *src)\n198\t{\n199\t    int i;\n200\t    for (i = 0; i < ARGON2_QWORDS_IN_BLOCK; ++i) {\n201\t        dst->v[i] ^= src->v[i];\n202\t    }\n203\t}\n204\t\n205\t\n206\t\n207\t\n208\t\n209\t\n210\t\n211\ttypedef struct Argon2_instance_t {\n212\t    block_region *region;\n213\t    uint64_t *pseudo_rands;\n214\t    uint32_t passes;\n215\t    uint32_t current_pass;\n216\t    uint32_t memory_blocks;\n217\t    uint32_t segment_length;\n218\t    uint32_t lane_length;\n219\t    uint32_t lanes;\n220\t    uint32_t threads;\n221\t    argon2_type type;\n222\t    int print_internals;\n223\t} argon2_instance_t;\n224\t\n225\t\n226\t\n227\t\n228\t\n229\ttypedef struct Argon2_position_t {\n230\t    uint32_t pass;\n231\t    uint32_t lane;\n232\t    uint8_t slice;\n233\t    uint32_t index;\n234\t} argon2_position_t;\n235\t\n236\t\n237\ttypedef struct Argon2_thread_data {\n238\t    argon2_instance_t *instance_ptr;\n239\t    argon2_position_t pos;\n240\t} argon2_thread_data;\n241\tstatic uint32_t index_alpha(const argon2_instance_t *instance,\n242\t                            const argon2_position_t *position, uint32_t pseudo_rand,\n243\t                            int same_lane)\n244\t{\n245\t    uint32_t reference_area_size;\n246\t    uint64_t relative_position, absolute_position;\n247\t    uint32_t start_position;\n248\t\n249\t    if (position->pass == 0) {\n250\t\n251\t        if (position->slice == 0) {\n252\t\n253\t            reference_area_size =\n254\t                position->index - 1;\n255\t        } else {\n256\t            if (same_lane) {\n257\t\n258\t                reference_area_size =\n259\t                    position->slice * instance->segment_length +\n260\t                    position->index - 1;\n261\t            } else {\n262\t                reference_area_size =\n263\t                    position->slice * instance->segment_length +\n264\t                    ((position->index == 0) ? (-1) : 0);\n265\t            }\n266\t        }\n267\t    } else {\n268\t\n269\t        if (same_lane) {\n270\t            reference_area_size = instance->lane_length -\n271\t                                  instance->segment_length + position->index -\n272\t                                  1;\n273\t        } else {\n274\t            reference_area_size = instance->lane_length -\n275\t                                  instance->segment_length +\n276\t                                  ((position->index == 0) ? (-1) : 0);\n277\t        }\n278\t    }\n279\t\n280\t\n281\t\n282\t    relative_position = pseudo_rand;\n283\t    relative_position = relative_position * relative_position >> 32;\n284\t    relative_position = reference_area_size - 1 -\n285\t                        (reference_area_size * relative_position >> 32);\n286\t\n287\t\n288\t    start_position = 0;\n289\t\n290\t    if (position->pass != 0) {\n291\t        start_position = (position->slice == 4U - 1)\n292\t                             ? 0\n293\t                             : (position->slice + 1) * instance->segment_length;\n294\t    }\n295\t\n296\t\n297\t    absolute_position = start_position + relative_position - instance->lane_length;\n298\t    absolute_position += instance->lane_length & (absolute_p