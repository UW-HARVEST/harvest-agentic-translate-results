12\tpub fn ge25519_p2_to_p3(r: &mut ge25519_p3, p: &ge25519_p2) {\n313\t    fe25519_copy(&mut r.X, &p.X);\n314\t    fe25519_copy(&mut r.Y, &p.Y);\n315\t    fe25519_copy(&mut r.Z, &p.Z);\n316\t    fe25519_mul(&mut r.T, &p.X, &p.Y);\n317\t}\n318\t\n319\t/// `static void ge25519_p2_0(ge25519_p2 *h)`\n320\tpub fn ge25519_p2_0(h: &mut ge25519_p2) {\n321\t    fe25519_0(&mut h.X);\n322\t    fe25519_1(&mut h.Y);\n323\t    fe25519_1(&mut h.Z);\n324\t}\n325\t\n326\t/// `static void ge25519_p2_dbl(ge25519_p1p1 *r, const ge25519_p2 *p)` (r = 2*p)\n327\tpub fn ge25519_p2_dbl(r: &mut ge25519_p1p1, p: &ge25519_p2) {\n328\t    let mut t0: fe25519 = [0i32; 10];\n329\t\n330\t    fe25519_sq(&mut r.X, &p.X);\n331\t    fe25519_sq(&mut r.Z, &p.Y);\n332\t    fe25519_sq2(&mut r.T, &p.Z);\n333\t    fe25519_add(&mut r.Y, &p.X, &p.Y);\n334\t    fe25519_sq(&mut t0, &r.Y);\n335\t    fe25519_add(&mut r.Y, &r.Z, &r.X);\n336\t    {\n337\t        let rz = r.Z;\n338\t        fe25519_sub(&mut r.Z, &rz, &r.X);\n339\t    }\n340\t    fe25519_sub(&mut r.X, &t0, &r.Y);\n341\t    {\n342\t        let rt = r.T;\n343\t        fe25519_sub(&mut r.T, &rt, &r.Z);\n344\t    }\n345\t}\n346\t\n347\t/// `static void ge25519_p3_0(ge25519_p3 *h)`\n348\tpub fn ge25519_p3_0(h: &mut ge25519_p3) {\n349\t    fe25519_0(&mut h.X);\n350\t    fe25519_1(&mut h.Y);\n351\t    fe25519_1(&mut h.Z);\n352\t    fe25519_0(&mut h.T);\n353\t}\n354\t\n355\t/// `static void ge25519_cached_0(ge25519_cached *h)`\n356\tpub fn ge25519_cached_0(h: &mut ge25519_cached) {\n357\t    fe25519_1(&mut h.YplusX);\n358\t    fe25519_1(&mut h.YminusX);\n359\t    fe25519_1(&mut h.Z);\n360\t    fe25519_0(&mut h.T2d);\n361\t}\n362\t\n363\t/// `static void ge25519_p3_to_cached(ge25519_cached *r, const ge25519_p3 *p)`\n364\tpub fn ge25519_p3_to_cached(r: &mut ge25519_cached, p: &ge25519_p3) {\n365\t    fe25519_add(&mut r.YplusX, &p.Y, &p.X);\n366\t    fe25519_sub(&mut r.YminusX, &p.Y, &p.X);\n367\t    fe25519_copy(&mut r.Z, &p.Z);\n368\t    fe25519_mul(&mut r.T