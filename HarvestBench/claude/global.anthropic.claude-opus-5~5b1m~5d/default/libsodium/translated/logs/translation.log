{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HnfbxTWtfy6SKrLXcHf8Ya","type":"tool_result","content":"1\t//! Translation of `crypto_verify/verify.c`.\n2\t//!\n3\t//! The reference build defines neither `HAVE_EMMINTRIN_H`/`__SSE2__` nor\n4\t//! `HAVE_INLINE_ASM`, so this always takes the portable `crypto_verify_n`\n5\t//! path (no SSE2, no inline asm barrier).\n6\t\n7\tuse core::ffi::c_int;\n8\t\n9\tconst CRYPTO_VERIFY_16_BYTES: c_int = 16;\n10\tconst CRYPTO_VERIFY_32_BYTES: c_int = 32;\n11\tconst CRYPTO_VERIFY_64_BYTES: c_int = 64;\n12\t\n13\t#[no_mangle]\n14\tpub unsafe extern \"C\" fn crypto_verify_16_bytes() -> usize {\n15\t    CRYPTO_VERIFY_16_BYTES as usize\n16\t}\n17\t\n18\t#[no_mangle]\n19\tpub unsafe extern \"C\" fn crypto_verify_32_bytes() -> usize {\n20\t    CRYPTO_VERIFY_32_BYTES as usize\n21\t}\n22\t\n23\t#[no_mangle]\n24\tpub unsafe extern \"C\" fn crypto_verify_64_bytes() -> usize {\n25\t    CRYPTO_VERIFY_64_BYTES as usize\n26\t}\n27\t\n28\t/// `static volatile uint16_t optblocker_u16;` in the C source.\n29\tstatic mut OPTBLOCKER_U16: u16 = 0;\n30\t\n31\t#[inline]\n32\tunsafe fn crypto_verify_n(x_: *const u8, y_: *const u8, n: c_int) -> c_int {\n33\t    let x = x_;\n34\t    let y = y_;\n35\t    let mut d: u16 = 0;\n36\t    let mut i: c_int = 0;\n37\t\n38\t    while i < n {\n39\t        d |= (*x.add(i as usize) ^ *y.add(i as usize)) as u16;\n40\t        i += 1;\n41\t    }\n42\t\n43\t    d = d.wrapping_sub(1);\n44\t    let blocker = core::ptr::read_volatile(&raw const OPTBLOCKER_U16);\n45\t    d = ((d >> 13) ^ blocker) >> 2;\n46\t\n47\t    (d as c_int) - 1\n48\t}\n49\t\n50\t#[no_mangle]\n51\tpub unsafe extern \"C\" fn crypto_verify_16(x: *const u8, y: *const u8) -> c_int {\n52\t    crypto_verify_n(x, y, CRYPTO_VERIFY_16_BYTES)\n53\t}\n54\t\n55\t#[no_mangle]\n56\tpub unsafe extern \"C\" fn crypto_verify_32(x: *const u8, y: *const u8) -> c_int {\n57\t    crypto_verify_n(x, y, CRYPTO_VERIFY_32_BYTES)\n58\t}\n59\t\n60\t#[no_