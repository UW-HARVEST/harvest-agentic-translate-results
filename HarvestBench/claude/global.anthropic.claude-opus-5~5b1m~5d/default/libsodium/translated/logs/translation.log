0\t\n61\tSODIUM_EXPORT\n62\tchar *sodium_bin2hex(char *const hex, const size_t hex_maxlen, const unsigned char *const bin,\n63\t                     const size_t bin_len) __attribute__((nonnull(1)));\n64\t\n65\tSODIUM_EXPORT\n66\tint sodium_hex2bin(unsigned char *const bin, const size_t bin_maxlen, const char *const hex,\n67\t                   const size_t hex_len, const char *const ignore, size_t *const bin_len,\n68\t                   const char **const hex_end) __attribute__((nonnull(1)));\n69\t\n70\t#define sodium_base64_VARIANT_ORIGINAL            1\n71\t#define sodium_base64_VARIANT_ORIGINAL_NO_PADDING 3\n72\t#define sodium_base64_VARIANT_URLSAFE             5\n73\t#define sodium_base64_VARIANT_URLSAFE_NO_PADDING  7\n74\t\n75\t/*\n76\t * Computes the required length to encode BIN_LEN bytes as a base64 string\n77\t * using the given variant. The computed length includes a trailing \\0.\n78\t */\n79\t#define sodium_base64_ENCODED_LEN(BIN_LEN, VARIANT)                            \\\n80\t  ((BIN_LEN) / 3U > (SIZE_MAX - 5) / 4U                                        \\\n81\t       ? (size_t)SIZE_MAX                                                      \\\n82\t       : (((BIN_LEN) / 3U) * 4U +                                              \\\n83\t          ((((BIN_LEN) - ((BIN_LEN) / 3U) * 3U) |                              \\\n84\t            (((BIN_LEN) - ((BIN_LEN) / 3U) * 3U) >> 1)) &                      \\\n85\t           1U) *                                                               \\\n86\t              (4U - ((0U - (((VARIANT) & 2U) >> 1)) &                          \\\n87\t                     (3U - ((BIN_LEN) - ((BIN_LEN) / 3U) * 3U)))) +            \\\n88\t          1U))\n89\t\n90\tSODIUM_EXPORT\n91\tsize_t sodium_base64_encoded_len(const size_t bin_len, const int variant);\n92\t\n93\tSODIUM_EXPORT\n94\tchar *sodium_bin2base64(char *const b64, const size_t b64_maxlen, const unsigned char *const bin,\n95\t                        const size_t bin_len,