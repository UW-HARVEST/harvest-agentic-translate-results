single_step() {\n    let cases: &[(&str, u32)] = &[\n        (\"a\", 0),\n        (\"a*\", 0),\n        (\"\", 0),\n        (\"b*\", 0),\n        (\".\", 0),\n        (\"^\", PCRE2_MULTILINE),\n        (\"$\", PCRE2_MULTILINE),\n        (r\"\\b\", 0),\n        (\"abcd\", 0),\n        (\"(?=a)\", 0),\n        (r\"a\\K\", 0),\n        (r\"\\Ka\", 0),\n        (r\"(?=a\\K)\", 0),\n        (r\"(?:a\\K)*\", 0),\n        (\"x\", 0),\n        (r\"\\R\", 0),\n        (r\".*\", 0),\n    ];\n    let subs: &[&str] = &[\n        \"\", \"a\", \"aa\", \"ab\", \"b\", \"abc\", \"a\\r\\nb\", \"\\r\\n\", \"aéb\", \"é\", \"a\\nb\", \"aaa\",\n    ];\n    for (ci, (pat, copts)) in cases.iter().enumerate() {\n        for (si, s) in subs.iter().enumerate() {\n            for start in [0usize, 1] {\n                if start > s.len() {\n                    continue;\n                }\n                for mopts in [0u32, PCRE2_NOTEMPTY, PCRE2_NOTEMPTY_ATSTART, PCRE2_PARTIAL_SOFT] {\n                    diff(\n                        &format!(\"nm1 c[{ci}]={pat:?} s[{si}]={s:?} st={start} m={mopts:#x}\"),\n                        |api| {\n                            let mut l = Log::new();\n                            unsafe {\n                                let code = compile_logged(\n                                    api,\n                                    pat.as_bytes(),\n                                    pat.len(),\n                                    *copts,\n                                    std::ptr::null_mut(),\n                                    &mut l,\n                                );\n                                if code.is_null() {\n                                    return l;\n                                }\n                                let md = (api.match_data_create_from_pattern)(\n                                    code,\n                                    std::ptr::null_mut(),\n                                );\n                                clea