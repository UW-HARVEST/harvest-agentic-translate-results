4\t            }\n235\t\n236\t            /* The new allocator must be preserved. */\n237\t\n238\t            core::ptr::copy_nonoverlapping(\n239\t                src_bytes.add(core::mem::size_of::<pcre2_memctl>()),\n240\t                (dst_re as *mut u8).add(core::mem::size_of::<pcre2_memctl>()),\n241\t                blocksize - core::mem::size_of::<pcre2_memctl>(),\n242\t            );\n243\t            if (*dst_re).magic_number != MAGIC_NUMBER\n244\t                || (*dst_re).name_entry_size as u32 > MAX_NAME_SIZE + IMM2_SIZE as u32 + 1\n245\t                || (*dst_re).name_count as u32 > MAX_NAME_COUNT\n246\t            {\n247\t                error = PCRE2_ERROR_BADSERIALIZEDDATA;\n248\t                break 'cleanup; /* goto cleanup */\n249\t            }\n250\t\n251\t            /* At the moment only one table is supported. */\n252\t\n253\t            (*dst_re).tables = tables;\n254\t            (*dst_re).executable_jit = core::ptr::null_mut();\n255\t            (*dst_re).flags |= PCRE2_DEREF_TABLES;\n256\t\n257\t            *codes.add(i as usize) = dst_re;\n258\t            dst_re = core::ptr::null_mut();\n259\t            src_bytes = src_bytes.add(blocksize);\n260\t            i += 1;\n261\t        }\n262\t\n263\t        return number_of_codes;\n264\t    }\n265\t\n266\t    /* cleanup: */\n267\t    if !dst_re.is_null() {\n268\t        ((*memctl).free.unwrap())(dst_re as *mut c_void, (*memctl).memory_data);\n269\t    }\n270\t    ((*memctl).free.unwrap())(tables as *mut c_void, (*memctl).memory_data);\n271\t    j = 0;\n272\t    while j < i {\n273\t        ((*memctl).free.unwrap())(\n274\t            *codes.add(j as usize) as *mut c_void,\n275\t            (*memctl).memory_data,\n276\t        );\n277\t        *codes.add(j as usize) = core::ptr::null_mut();\n278\t        j += 1;\n279\t    }\n280\t    error\n281\t}\n282\t\n283\t/*************************************************\n284\t*    Get the number of serialized patterns       *\n285\t*************************************************/\n286\t\n287\t#[unsafe(no_mangle)]\n288\tpub unsafe extern \"C\" fn pcre2_serialize_get_number_of_codes_8(bytes: *const u8) -> i32 {\n289\t    let data: *const pcre2_serialized_data = bytes as *const pcre2_serialized_data;\n290\t\n291\t    if data.is_null() {\n292\t        return PCRE2_ERROR_NULL;\n293\t    }\n294\t    if core::ptr::read_unaligned(core::ptr::addr_of!((*data).magic)) != SERIALIZED_DATA_MAGIC {\n295\t        return PCRE2_ERROR_BADMAGIC;\n296\t    }\n297\t    if core::ptr::read_unaligned(core::ptr::addr_of!((*data).version)) != SERIALIZED_DATA_VERSION {\n298\t        return PCRE2_ERROR_BADMODE;\n299\t    }\n300\t    if core::ptr::read_unaligned(core::ptr::addr_of!((*data).config)) != SERIALIZED_DATA_CONFIG {\n301\t        return PCRE2_ERROR_BADMODE;\n302\t    }\n303\t\n304\t    core::ptr::read_unaligned(core::ptr::addr_of!((*data).number_of_codes))\n305\t}\n306\t\n307\t/*************************************************\n308\t*            Free the allocated stream           *\n309\t*************************************************/\n310\t\n311\t#[unsafe(no_mangle)]\n312\tpub unsafe extern \"C\" fn pcre2_serialize_free_8(data: *mut u8) {\n313\t    let bytes: *mut u8 = data;\n314\t    if !bytes.is_null() {\n315\t        let memctl: *mut pcre2_memctl =\n316\t            bytes.sub(core::mem::size_of::<pcre2_memctl>()) as *mut pcre2_memctl;\n317\t        ((*memctl).free.unwrap())(memctl as *mut c_void, (*memctl).memory_data);\n318\t    }\n319\t}\n320\t\n321\t/* End of pcre2_serialize.c */\n322\t"}]},"parent_tool_use_id":"toolu_bdrk_01ByS28QCmYZoQhAvy9JHMa1","session_id":"afdd377b-a8e3-4242-b7f7-f8439c40180f","uuid":"06bfe069-c0be-4b93-9c61-123085746992","timestamp":"2026-08-31T07:14:15.689Z","subagent_type":"general-purpose","task_description":"Substring + serialize + jit tests"}
