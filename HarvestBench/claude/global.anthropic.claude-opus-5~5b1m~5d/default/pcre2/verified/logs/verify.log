{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JDKPnXV54Ah7KPqoJxJesS","type":"tool_result","content":"1\t//! Shared pattern / subject corpora and a randomized *valid*-pattern generator.\n2\t//!\n3\t//! Used by every Phase-B test file so that the same broad set of pattern shapes\n4\t//! is exercised under every option combination.\n5\t#![allow(dead_code)]\n6\t\n7\tuse super::Rng;\n8\t\n9\t/// Hand-written patterns covering every construct the compiler special-cases.\n10\t/// Derived from the `switch` arms in `pcre2_compile.c` / `pcre2_compile_class.c`\n11\t/// / `pcre2_compile_cgroup.c` and the opcode list in `pcre2_internal.h`.\n12\tpub const PATTERNS: &[&str] = &[\n13\t    // literals & empty\n14\t    \"\",\n15\t    \"a\",\n16\t    \"abc\",\n17\t    \"a\\0b\",\n18\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n19\t    // dot / anchors\n20\t    \".\",\n21\t    \"..\",\n22\t    \"^a\",\n23\t    \"a$\",\n24\t    \"^a$\",\n25\t    \"^\",\n26\t    \"$\",\n27\t    r\"\\A\",\n28\t    r\"\\Z\",\n29\t    r\"\\z\",\n30\t    r\"\\G\",\n31\t    r\"\\b\",\n32\t    r\"\\B\",\n33\t    r\"\\K\",\n34\t    r\"a\\Kb\",\n35\t    // simple classes\n36\t    \"[a]\",\n37\t    \"[abc]\",\n38\t    \"[^abc]\",\n39\t    \"[a-z]\",\n40\t    \"[^a-z]\",\n41\t    \"[a-zA-Z0-9_]\",\n42\t    \"[]]\",\n43\t    \"[^]]\",\n44\t    \"[-a]\",\n45\t    \"[a-]\",\n46\t    r\"[\\]]\",\n47\t    r\"[\\\\]\",\n48\t    r\"[\\d]\",\n49\t    r\"[\\D]\",\n50\t    r\"[\\w\\W]\",\n51\t    r\"[\\s\\S]\",\n52\t    r\"[\\h\\H]\",\n53\t    r\"[\\v\\V]\",\n54\t    \"[[:alpha:]]\",\n55\t    \"[[:^alpha:]]\",\n56\t    \"[[:digit:][:space:]]\",\n57\t    \"[[:alnum:][:punct:]]\",\n58\t    \"[[:ascii:]]\",\n59\t    \"[[:blank:]]\",\n60\t    \"[[:cntrl:]]\",\n61\t    \"[[:graph:]]\",\n62\t    \"[[:lower:]]\",\n63\t    \"[[:print:]]\",\n64\t    \"[[:upper:]]\",\n65\t    \"[[:word:]]\",\n66\t    \"[[:xdigit:]]\",\n67\t    // escapes\n68\t    r\"\\d\",\n69\t    r\"\\D\",\n70\t    r\"\\w\",\n71\t    r\"\\W\",\n72\t    r\"\\s\",\n73\t    r\"\\S\",\n74\t    r\"\\h\",\n75\t    r\"\\H\",\n76\t    r\"\\v\",\n77\t    r\"\\V\",\n78\t    r\"\\R\",\n79\t    r\"\\X\",\n80\t    r\"\\C\",\n81\t    r\"\\N\",\n82\t    r\"\\n\",\n83\t    r\"\\r\",\n84\t    r\"\\t\",\n85\t    r\"\\f\",\n86\t    r\"\\a\",\n87\t    r\"\\e\",\n88\t    r\"\\0\",\n89\t    r\"\\07\",\n90\t    r\"\\101\",\n91\t    r\"\\x41\",\n92\t    r\"\\x{41}\",\n93\t    r\"\\x{1F600}\",\n94\t    r\"\\o{101}\",\n95\t    r\"\\cA\",\n96\t    r\"\\Q a+b \\E\",\n97\t    r\"a\\Qb*c\\Ed\",\n98\t    r\"\\Qabc\",\n99\t    // quantifiers\n100\t    \"a*\",\n101\t    \"a+\",\n102\t    \"a?\",\n103\t    \"a{2}\",\n104\t    \"a{2,}\",\n105\t    \"a{2,4}\",\n106\t    \"a{0,3}\",\n107\t    \"a{0}\",\n108\t    \"a{1}\",\n109\t    \"a*?\",\n110\t    \"a+?\",\n111\t    \"a??\",\n112\t    \"a{2,4}?\",\n113\t    \"a*+\",\n114\t    \"a++\",\n115\t    \"a?+\",\n116\t    \"a{2,4}+\",\n117\t    \".*\",\n118\t    \".+\",\n119\t    \".*?\",\n120\t    \"[a-z]*\",\n121\t    \"[a-z]+?\",\n122\t    \"[a-z]{3,5}\",\n123\t    r\"\\d{1,3}\",\n124\t    r\"(?:ab)*\",\n125\t    r\"(ab)+\",\n126\t    r\"(a|b)*\",\n127\t    // alternation\n128\t    \"a|b\",\n129\t    \"a|b|c\",\n130\t    \"|a\",\n131\t    \"a|\",\n132\t    \"(a|b|)\",\n133\t    \"^a|b$\",\n134\t    // groups\n135\t    \"(a)\",\n136\t    \"(a)(b)\",\n137\t    \"((a))\",\n138\t    \"(?:a)\",\n139\t    \"(?i)a\",\n140\t    \"(?i:a)\",\n141\t    \"(?-i:a)\",\n142\t    \"(?s)a.b\",\n143\t    \"(?m)^a$\",\n144\t    \"(?x) a  b \",\n145\t    \"(?xx) a  b \",\n146\t    \"(?U)a*\",\n147\t    \"(?J)(?<n>a)(?<n>b)\",\n148\t    \"(?n)(a)\",\n149\t    \"(?>a+)b\",\n150\t    \"(?<n>a)\",\n151\t    \"(?'n'a)\",\n152\t    \"(?P<n>a)\",\n153\t    \"(?<n>a)(?&n)\",\n154\t    \"(?P>n)\",\n155\t    // backreferences\n156\t    r\"(a)\\1\",\n157\t    r\"(a)(b)\\2\\1\",\n158\t    r\"(?<n>a)\\k<n>\",\n159\t    r\"(?<n>a)\\k'n'\",\n160\t    r\"(?<n>a)\\k{n}\",\n161\t    r\"(?<n>a)(?P=n)\",\n162\t    r\"(a)\\g1\",\n163\t    r\"(a)\\g{1}\",\n164\t    r\"(a)\\g{-1}\",\n165\t    r\"(a)(b)\\g{-2}\",\n166\t    // recursion / subroutines\n167\t    r\"(a(?R)?b)\",\n168\t    r\"(a)(?1)\",\n169\t    r\"(?1)(a)\",\n170\t    r\"(?<n>a)(?&n)\",\n171\t    r\"\\((?>[^()]|(?R))*\\)\",\n172\t    r\"(?(DEFINE)(?<x>a))(?&x)\",\n173\t    // lookaround\n174\t    \"(?=a)\",\n175\t    \"(?!a)\",\n176\t    \"(?<=a)b\",\n177\t    \"(?<!a)b\",\n178\t    \"a(?=b)\",\n179\t    \"a(?!b)\",\n180\t    \"(?<=ab)c\",\n181\t    \"(?<=a|bc)d\",\n182\t    \"(*positive_lookahead:a)\",\n183\t    \"(*pla:a)\",\n184\t    \"(*negative_lookahead:a)\",\n185\t    \"(*nla:a)\",\n186\t    \"(*positive_lookbehind:a)b\",\n187\t    \"(*plb:a)b\",\n188\t    \"(*negative_lookbehind:a)b\",\n189\t    \"(*nlb:a)b\",\n190\t    \"(*atomic:a+)b\",\n191\t    \"(*asr:a)\",\n192\t    \"(*script_run:abc)\",\n193\t    \"(*sr:abc)\",\n194\t    // non-atomic lookaround\n195\t    \"(*napla:a)\",\n196\t    \"(*naplb:a)b\",\n197\t    // conditionals\n198\t    \"(a)?(?(1)b|c)\",\n199\t    \"(a)?(?(1)b)\",\n200\t    \"(?(?=a)b|c)\",\n201\t    \"(?(?!a)b|c)\",\n202\t    \"(?<n>a)?(?(<n>)b|c)\",\n203\t    \"(?(R)a|b)\",\n204\t    \"(?(R1)a|b)\",\n205\t    \"(?(DEFINE)(?<x>a))b\",\n206\t    \"(?(VERSION>=10.0)a|b)\",\n207\t    \"(?(VERSION=10.48)a|b)\",\n208\t    // verbs\n209\t    \"(*FAIL)\",\n210\t    \"(*F)\",\n211\t    \"a(*ACCEPT)b\",\n212\t    \"(*COMMIT)a\",\n213\t    \"(*PRUNE)a\",\n214\t    \"(*PRUNE:x)a\",\n215\t    \"(*SKIP)a\",\n216\t    \"(*SKIP:x)a\",\n217\t    \"(*THEN)a\",\n218\t    \"(*THEN:x)a\",\n219\t    \"(*MARK:x)a\",\n220\t    \"(*:x)a\",\n221\t    \"a(*MARK:m1)b|c(*MARK:m2)d\",\n222\t    // options embedded at the start\n223\t    \"(*UTF)a\",\n224\t    \"(*UCP)a\",\n225\t    \"(*CR)a.b\",\n226\t    \"(*LF)a.b\",\n227\t    \"(*CRLF)a.b\",\n228\t    \"(*ANY)a.b\",\n229\t    \"(*ANYCRLF)a.b\",\n230\t    \"(*NUL)a.b\",\n231\t    \"(*BSR_UNICODE)a\\\\Rb\",\n232\t    \"(*BSR_ANYCRLF)a\\\\Rb\",\n233\t    \"(*LIMIT_MATCH