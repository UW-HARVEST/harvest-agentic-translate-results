     pat.as_bytes(),\n473\t                opts,\n474\t                extra,\n475\t                0,\n476\t                0,\n477\t            );\n478\t        }\n479\t    }\n480\t}\n481\t\n482\t/// Random *bytes* as a pattern: mostly invalid, which exercises the whole\n483\t/// error surface of the parser and must produce identical error codes/offsets.\n484\t#[test]\n485\tfn compile_random_bytes() {\n486\t    let mut rng = Rng::new(0xC0FFEE_02);\n487\t    let alphabet: &[u8] = b\"ab()[]{}|*+?.^$\\\\-,:!<>=&~#'\\\"`0123456789PpQqEeCcRrNnKkGgXxUuLlWwSsDdHhVvBbAaZzTtMmFfIiJjOoYy \\t\\n\";\n488\t    for iter in 0..8000 {\n489\t        let n = rng.below(14);\n490\t        let pat: Vec<u8> = (0..n).map(|_| *rng.pick(alphabet)).collect();\n491\t        for opts in [\n492\t            0u32,\n493\t            PCRE2_UTF,\n494\t            PCRE2_UCP,\n495\t            PCRE2_CASELESS | PCRE2_MULTILINE,\n496\t            PCRE2_EXTENDED,\n497\t            PCRE2_ALT_EXTENDED_CLASS,\n498\t            PCRE2_ALT_BSUX,\n499\t            PCRE2_ALLOW_EMPTY_CLASS,\n500\t            PCRE2_LITERAL,\n501\t        ] {\n502\t            diff_compile(\n503\t                &format!(\"randbytes iter={iter} pat={pat:?} opts={opts:#x}\"),\n504\t                &pat,\n505\t                opts,\n506\t                0,\n507\t                0,\n508\t                0,\n509\t            );\n510\t        }\n511\t    }\n512\t}\n513\t\n514\t// -------------------------------------------------- row 89: callout_enumerate\n515\t\n516\tstatic mut ENUM_LOG: Vec<u8> = Vec::new();\n517\t\n518\tunsafe extern \"C\" fn enum_cb(b: *mut CalloutEnumerateBlock, data: *mut c_void) -> c_int {\n519\t    let b = &*b;\n520\t    let v = &mut *(data as *mut Vec<u8>);\n521\t    v.extend_from_slice(&b.version.to_le_bytes());\n522\t    v.extend_from_slice(&b.pattern_position.to_le_bytes());\n523\t    v.extend_from_slice(&b.next_item_length.to_le_bytes());\n524\t    v.extend_from_slice(&b.callout_number.to_le_bytes());\n525\t    v.extend_from_slice(&b.callout_string_offset.to_le_bytes());\n526\t    v.extend_from_slice(&b.callout_string_length.to_le_bytes());\n527\t    if b.callout_string.is_null() {\n528\t        v.push(0);\n529\t    } else {\n530\t        v.push(1);\n531\t        v.extend_from_slice(std::slice::from_raw_parts(\n532\t            b.callout_string,\n533\t            b.callout_string_length,\n534\t        ));\n535\t    }\n536\t    0\n537\t}\n538\t\n539\tunsafe extern \"C\" fn enum_cb_stop(_b: *mut CalloutEnumerateBlock, _d: *mut c_void) -> c_int {\n540\t    -99\n541\t}\n542\t\n543\t#[test]\n544\tfn callout_enumerate_all() {\n545\t    for (i, p) in PATTERNS.iter().enumerate() {\n546\t        for opts in [0u32, PCRE2_AUTO_CALLOUT, PCRE2_AUTO_CALLOUT | PCRE2_UTF] {\n547\t            diff(&format!(\"calloutenum pat[{i}] opts={opts:#x}\"), |api| {\n548\t                let mut l = Log::new();\n549\t                unsafe {\n550\t                    let code =\n551\t                        compile_logged(api, p.as_bytes(), p.len(), opts, std::ptr::null_mut(), &mut l);\n552\t                    if code.is_null() {\n553\t                        return l;\n554\t                    }\n555\t                    let mut buf: Vec<u8> = Vec::new();\n556\t                    let rc = (api.callout_enumerate)(\n557\t                        code,\n558\t                        Some(enum_cb),\n559\t                        &mut buf as *mut Vec<u8> as *mut c_void,\n560\t                    );\n561\t                    l.i(rc as i64).b(&buf);\n562\t                    // A callback that aborts must propagate its return value.\n563\t                    let rc2 = (api.callout_enumerate)(\n564\t                        code,\n565\t                        Some(enum_cb_stop),\n566\t                        std::ptr::null_mut(),\n567\t                    );\n568\t                    l.i(rc2 as i64);\n569\t                    (api.code_free)(code);\n570\t                }\n571\t                l\n572\t            });\n573\t        }\n574\t    }\n575\t}\n576\t\n577\t// -------------------------------------------------- ERRORS rows 176-185\n578\t\n579\t#[test]\n580\tfn pattern_info_error_paths() {\n581\t    diff(\"pattern_info_errors\", |api| {\n582\t        let mut l = Log::new();\n583\t        unsafe {\n584\t            // code == NULL\n585\t            let mut v: u32 = 0;\n586\t            for what in 0..=27u32 {\n587\t                let rc = (api.pattern_info)(\n588\t                    std::ptr::null_mut(),\n589\t                    what,\n590\t                    &mut v as *mut u32 as *mut c_void,\n591\t                );\n592\t                l.i(rc as i64);\n593\t            }\n594\t            // bad magic: corrupt a copy of a real compiled code\n595\t            let code = compile_logged(api, b\"abc\", 3, 0, std::ptr::null_mut(), &mut l);\n596\t            assert!(!code.is_null());\n597\t            let cp = (api.code_copy)(code);\n598\t            // magic_number is the first field of pcre2_real_code\n599\t            let magic = cp as *mut u32;\n600\t            let saved = *magic;\n601\t            *magic = 0xDEAD_BEEF;\n602\t            for what in [INFO_SIZE, INFO_CAPTURECOUNT, INFO_NAMETABLE, 9999] {\n603\t                let rc = (api.pattern_info)(cp, what, &mut v as *mut u32 as *mut c_void);\n604\t                l.tag(\"badmagic\").i(rc as i64);\n605\t            }\n606\t            *magic = saved;\n607\t            // bad mode: clear the code-unit-width bit in `flags`\n608\t            // (offset of flags: magic_number u32, compiled_code_size Sz,\n609\t            //  blocksize Sz, ... — locate it by scanning for the width bit is\n610\t            //  fragile, so instead verify BADMODE via serialize with a wrong\n611\t            //  config, which is covered in the serialize tests.)\n612\t            (api.code_free)(cp);\n613\t\n614\t            // Unset limits => PCRE2_ERROR_UNSET\n615\t            for what in [INFO_DEPTHLIMIT, INFO_HEAPLIMI