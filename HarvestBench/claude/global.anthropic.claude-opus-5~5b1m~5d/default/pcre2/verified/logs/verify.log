,0,PCRE2_EXTRA_TURKISH_CASING),\n      (\"212a\", b\"[[:alpha:]&&x]\",0,0),\n      (\"212b\", b\"[a&&b]\",0,0),\n      (\"212c\", b\"[a--b]\",0,0),\n      (\"213\", b\"[[:alpha:]&&]\",PCRE2_ALT_EXTENDED_CLASS,0),\n      (\"214a\", b\"[()]\",PCRE2_ALT_EXTENDED_CLASS,0),\n      (\"214b\", b\"[(&&a)]\",PCRE2_ALT_EXTENDED_CLASS,0),\n      (\"215\", b\"[(a\",PCRE2_ALT_EXTENDED_CLASS,0),\n      (\"216\", b\"[a b]\",PCRE2_ALT_EXTENDED_CLASS,0),\n      (\"217a\", b\"(?<a>)(?(<b>)x)\",0,0),\n      (\"217b\", b\"(?('b')x)\",0,0),\n      (\"217c\", b\"(?(<a>)x)\",0,0),\n      (\"218a\", b\"(?{\",0,0),\n      (\"218b\", b\"*\",0,0),\n      (\"218c\", b\"(*)\",0,0),\n      (\"219a\", b\"a{1\",0,0),\n      (\"219b\", b\"(?C1x)\",0,0),\n      (\"219c\", br\"\\g{1\",0,0),\n      (\"219d\", b\"(?12\",0,0),\n      (\"98\", br\"\\0\",0,0x4000),\n      (\"101/ERR1\", br\"\\\",0,0),\n      (\"perl_ec1\", b\"[[:alpha:]&&[:digit:]]\",0,0),\n      (\"perl_ec2\", b\"[a&&b]\",PCRE2_ALT_EXTENDED_CLASS,0),\n    ];\n    let long_callout: Vec<u8> = format!(\"(?C{{{}}})a\", \"x\".repeat(70000)).into_bytes();\n    let deep: Vec<u8> = { let mut s=String::new(); for _ in 0..300 {s.push_str(\"(?|\");} s.push('a'); for _ in 0..300 {s.push(')');} s.into_bytes() };\n    let complex: Vec<u8> = { format!(\"(?<={})x\", \"(?:a|bb|ccc){1,255}\".repeat(40)).into_bytes() };\n    for (n,p,o,e) in cands {\n        let pat: &[u8] = match n { \"172\"=>&long_callout, \"184\"=>&deep, \"186\"=>&complex, _=>p };\n        let (ec,eo)=probe(pat,o,e);\n        eprintln!(\"{n}: code={ec} off={eo}\");\n    }\n}\nEOF\ncd $W/translation && timeout 600 cargo test --offline -q --test tzz_cov -- --nocapture 2>&1 | grep -E \"^[0-9a-zA-Z/]+: code\" | head -60","description":"Probe triggers for remaining error codes","timeout":900000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2343,"cache_read_input_tokens":308016,"cache_creation":{"ephemeral_5m_input_token