t    \"[é-ü]\",\n304\t    \"[\\u{4e00}-\\u{9fff}]\",\n305\t    \"\\u{85}\",\n306\t    \"\\u{2028}\",\n307\t];\n308\t\n309\t/// Patterns valid only with `PCRE2_ALT_EXTENDED_CLASS`.\n310\tpub const ECLASS_PATTERNS: &[&str] = &[\n311\t    \"[[a][b]]\",\n312\t    \"[[a-z]&&[^aeiou]]\",\n313\t    \"[[a-z]--[aeiou]]\",\n314\t    \"[[a-m]||[n-z]]\",\n315\t    \"[[a-z]~~[aeiou]]\",\n316\t    \"[[[a-z]&&[b-y]]--[m]]\",\n317\t    \"[\\\\p{L}&&[a-z]]\",\n318\t    \"[[a] [b] [c]]\",\n319\t    \"[^[a]&&[b-z]]\",\n320\t];\n321\t\n322\t/// Patterns valid only with `PCRE2_ALLOW_EMPTY_CLASS`.\n323\tpub const EMPTY_CLASS_PATTERNS: &[&str] = &[\"[]\", \"[^]\", \"[]a\", \"a[]b\", \"[^]*\"];\n324\t\n325\t/// Subjects, chosen to hit boundary shapes and both ASCII and UTF-8.\n326\tpub const SUBJECTS: &[&str] = &[\n327\t    \"\",\n328\t    \"a\",\n329\t    \"b\",\n330\t    \"ab\",\n331\t    \"abc\",\n332\t    \"abcabc\",\n333\t    \"aaa\",\n334\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n335\t    \"A\",\n336\t    \"ABC\",\n337\t    \"0\",\n338\t    \"123\",\n339\t    \"a1b2c3\",\n340\t    \" \",\n341\t    \"\\t\",\n342\t    \"\\n\",\n343\t    \"\\r\",\n344\t    \"\\r\\n\",\n345\t    \"\\n\\r\",\n346\t    \"a\\nb\",\n347\t    \"a\\r\\nb\",\n348\t    \"a\\rb\",\n349\t    \"a\\u{85}b\",\n350\t    \"a\\u{2028}b\",\n351\t    \"a\\u{2029}b\",\n352\t    \"a\\u{b}b\",\n353\t    \"a\\u{c}b\",\n354\t    \"\\0\",\n355\t    \"a\\0b\",\n356\t    \"_\",\n357\t    \"a_b\",\n358\t    \"a-b\",\n359\t    \".\",\n360\t    \"a.b\",\n361\t    \"()\",\n362\t    \"(a)\",\n363\t    \"((a))\",\n364\t    \"a@b.com\",\n365\t    \"2024-01-31\",\n366\t    \"555-1234\",\n367\t    \"https://example.com/x\",\n368\t    \"hello world hello\",\n369\t    \"the the\",\n370\t    \"é\",\n371\t    \"éé\",\n372\t    \"日本語テキスト\",\n373\t    \"😀😀\",\n374\t    \"aéb\",\n375\t    \"\\u{10000}\",\n376\t    \"\\u{10FFFF}\",\n377\t    \"aeiou\",\n378\t    \"xyz\",\n379\t    \"abcdefghijklmnopqrstuvwxyz\",\n380\t    \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\",\n381\t    \"0123456789\",\n382\t    \"!@#$%^&*()\",\n383\t    \"  leading and trailing  \",\n384\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaab\",\n385\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaac\",\n386\t];\n387\t\n388\t/// Byte-level subjects, including sequences that are not valid UTF-8.\n389\tpub fn byte_subjects() -> Vec<Vec<u8>> {\n390\t    let mut v: Vec<Vec<u8>> = SUBJECTS.iter().map(|s| s.as_bytes().to_vec()).collect();\n391\t    v.extend([\n392\t        vec![0x80],\n393\t        vec![0xFF],\n394\t        vec![0xC2],\n395\t        vec![0xC2, 0x41],\n396\t        vec![0xE0, 0xA0],\n397\t        vec![0xF0, 0x9F, 0x98],\n398\t        vec![0xED, 0xA0, 0x80],\n399\t        vec![0xF4, 0x90, 0x80, 0x80],\n400\t        vec![b'a', 0x80, b'b'],\n401\t        vec![b'a', 0xC2, b'b'],\n402\t        vec![0xFE, 0xFF],\n403\t    ]);\n404\t    v\n405\t}\n406\t\n407\t/// Randomized generator of syntactically valid patterns. Builds an expression\n408\t/// tree so that groups always balance, then renders it.\n409\tpub struct PatternGen {\n410\t    depth: u32,\n411\t    groups: u32,\n412\t    names: Vec<String>,\n413\t}\n414\t\n415\timpl PatternGen {\n416\t    pub fn new() -> PatternGen {\n417\t        PatternGen {\n418\t            depth: 0,\n419\t            groups: 0,\n420\t            names: Vec::new(),\n421\t        }\n422\t    }\n423\t\n424\t    pub fn gen(rng: &mut Rng) -> String {\n425\t        let mut g = PatternGen::new();\n426\t        let mut s = String::new();\n427\t        g.alt(rng, &mut s);\n428\t        s\n429\t    }\n430\t\n431\t    fn alt(&mut self, rng: &mut Rng, out: &mut String) {\n432\t        let n = 1 + rng.below(3);\n433\t        for i in 0..n {\n434\t            if i > 0 {\n435\t                out.push('|');\n436\t            }\n437\t            self.seq(rng, out);\n438\t        }\n439\t    }\n440\t\n441\t    fn seq(&mut self, rng: &mut Rng, out: &mut String) {\n442\t        let n = 1 + rng.below(4);\n443\t        for _ in 0..n {\n444\t            self.term(rng, out);\n445\t        }\n446\t    }\n447\t\n448\t    fn term(&mut self, rng: &mut Rng, out: &mut String) {\n449\t        self.atom(rng, out);\n450\t        // maybe quantify\n451\t        if rng.below(3) == 0 {\n452\t            let q = *rng.pick(&[\"*\", \"+\", \"?\", \"{0,2}\", \"{1,3}\", \"{2}\", \"{1,}\"]);\n453\t            out.push_str(q);\n454\t            match rng.below(4) {\n455\t                0 => out.push('?'),\n456\t                1 => out.push('+'),\n457\t                _ => {}\n458\t            }\n459\t        }\n460\t    }\n461\t\n462\t    fn atom(&mut self, rng: &mut Rng, out: &mut String) {\n463\t        let deep = self.depth >= 4;\n464\t        let choice = if deep { rng.below(4) } else { rng.below(14) };\n465\t        match choice {\n466\t            0 => out.push(*rng.pick(&['a', 'b', 'c', 'x', 'y', 'z', '0', '1', '_', ' '])),\n467\t            1 => out.push_str(*rng.pick(&[\n468\t                r\"\\d\", r\"\\D\", r\"\\w\", r\"\\W\", r\"\\s\", r\"\\S\", r\"\\h\", r\"\\v\", r\"\\R\", r\"\\X\", r\"\\N\",\n469\t            ])),\n470\t            2 => out.push('.'),\n471\t            3 => {\n472\t                let cls = *rng.pick(&[\n473\t                    \"[abc]\",\n474\t                    \"[^abc]\",\n475\t                    \"[a-z]\",\n476\t                    \"[0-9a-fA-F]\",\n477\t                    r\"[\\d\\s]\",\n478\t                    \"[[:alpha:]]\",\n479\t                    \"[[:^digit:]]\",\n480\t                    r\"[\\p{L}]\",\n481\t                    r\"[^\\p{Nd}]\",\n482\t                    \"[-a-z]\",\n483\t                    r\"[\\x41-\\x5A]\",\n484\t                ]);\n485\t                out.push_str(cls);\n486\t            }\n487\t            4 => {\n488\t                out.push_str(*rng.pick(&[r\"\\b\", r\"\\B\", r\"\\A\", r\"\\Z\", r\"\\z\", \"^\", \"$\"]));\n489\t            }\n490\t            5 => {\n491\t                out.push_str(*rng.pick(&[r\"\\p{L}\", r\"\\P{L}\", r\"\\p{Nd}\", r\"\\p{Greek}\", r\"\\pL\"]));\n492\t            }\n493\t            6 => {\n494\t                // capturing group\n495\t                self.depth += 1;\n496\t                self.groups += 1;\n497\t                out.push('(');\n498\t                self.alt(rng, out);\n499\t                out.push(')');\n500\t                self.depth -= 1;\n501\t            }\n502\t            7 => {\n503\t                // non-capturing / atomic / option group\n504\t                self.depth += 1;\n505\t                let open = *rng.pick(&[\"(?:\", \"(?>\", \"(?i:\", \"(?-i:\", \"(?s:\", \"(?m:\", \"(?x:\"]);\n506\t                out.push_str(open);\n507\t                self.alt(rng, out);\n508\t                out.push(')');\n509\t                self.depth -= 1;\n510\t            }\n511\t            8 => {\n512\t                // named group\n513\t                self.depth += 1;\n514\t                self.groups += 1;\n515\t                let name = format!(\"g{}\", self.names.len());\n516\t                self.names.push(name.clone());\n517\t                out.push_str(\"(?<\");\n518\t                out.push_str(&name);\n519\t                out.push('>');\n520\t                self.alt(rng, out);\n521\t                out.push(')');\n522\t                self.depth -= 1;\n523\t            }\n524\t            9 => {\n525\t                // lookaround (fixed-length body for lookbehind)\n526\t                self.depth += 1;\n527\t                match rng.below(4) {\n528\t                    0 => {\n529\t                        out.push_str(\"(?=\");\n530\t                        self.alt(rng, out);\n531\t                        out.push(')');\n532\t                    }\n533\t                    1 => {\n534\t                        out.push_str(\"(?!\");\n535\t                        self.alt(rng, out);\n536\t                        out.push(')');\n537\t                    }\n538\t                    2 => {\n539\t                        out.push_str(\"(?<=\");\n540\t                        out.push_str(*rng.pick(&[\"a\", \"ab\", \"abc\", \"[a-z]\", r\"\\d\\d\"]));\n541\t                        out.push(')');\n542\t                    }\n543\t                    _ => {\n544\t                        out.push_str(\"(?<!\");\n545\t                        out.push_str(*rng.pick(&[\"a\", \"ab\", \"abc\", \"[a-z]\", r\"\\d\\d\"]));\n546\t                        out.push(')');\n547\t                    }\n548\t                }\n549\t                self.depth -= 1;\n550\t            }\n551\t            10 => {\n552\t                // back reference to an existing group, if any\n553\t                if self.groups > 0 {\n554\t                    let g = 1 + rng.below(self.groups as usize);\n555\t                    out.push_str(&format!(r\"\\{}\", g));\n556\t                } else {\n557\t                    out.push('a');\n558\t                }\n559\t            }\n560\t            11 => {\n561\t                // reference to an existing name, if any\n562\t                if !self.names.is_empty() {\n563\t                    let n = rng.below(self.names.len());\n564\t                    out.push_str(&format!(r\"\\k<{}>\", self.names[n]));\n565\t                } else {\n566\t                    out.push('b');\n567\t                }\n568\t            }\n569\t            12 => {\n570\t                // verbs and marks\n571\t                out.push_str(*rng.pick(&[\n572\t                    \"(*FAIL)\",\n573\t                    \"(*ACCEPT)\",\n574\t                    \"(*COMMIT)\",\n575\t                    \"(*PRUNE)\",\n576\t                    \"(*SKIP)\",\n577\t                    \"(*THEN)\",\n578\t                    \"(*MARK:m)\",\n579\t                ]));\n580\t            }\n581\t            _ => {\n582\t                // literal escape / hex / octal\n583\t                out.push_str(*rng.pick(&[\n584\t                    r\"\\x41\", r\"\\x{42}\", r\"\\101\", r\"\\o{103}\", r\"\\cA\", r\"\\t\", r\"\\n\", r\"\\Qa+b\\E\",\n585\t                    r\"\\-\", r\"\\.\", r\"\\*\",\n586\t                ]));\n587\t            }\n588\t        }\n589\t    }\n590\t}\n591\t\n592\t/// Random byte subject with a configurable shape.\n593\tpub fn gen_subject(rng: &mut Rng, utf: bool) -> Vec<u8> {\n594\t    let n = rng.below(24);\n595\t    if utf {\n596\t        let chars = [\n597\t            'a', 'b', 'c', 'x', 'y', 'z', '0', '1', ' ', '_', '\\n', '\\r', '\\t', 'é', 'ü', '日',\n598\t            '本', '😀', '\\u{85}', '\\u{2028}', '\\u{2029}', 'A', 'B', 'Z', '-', '.', '@',\n599\t        ];\n600\t        let s: String = (0..n).map(|_| *rng.pick(&chars)).collect();\n601\t        s.into_bytes()\n602\t    } else {\n603\t        (0..n)\n604\t            .map(|_| *rng.pick(&[b'a', b'b', b'c', b'x', b'0', b'1', b' ', b'\\n', b'\\r', b'\\t', 0u8, 0x80, 0xFF, b'A', b'-', b'.']))\n605\t            .collect()\n606\t    }\n607\t}\n608\t"}]},"parent_tool_use_id":"toolu_bdrk_01Fdgn9GmWxCZxoRDUiJCLtM","session_id":"afdd377b-a8e3-4242-b7f7-f8439c40180f","uuid":"c3c8c13e-27d5-4514-8625-ec80fb1b78be","timestamp":"2026-08-31T07:13:14.732Z","subagent_type":"general-purpose","task_description":"Convert + config + context tests"}
