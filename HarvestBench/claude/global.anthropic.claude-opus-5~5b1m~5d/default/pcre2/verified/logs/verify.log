t)).collect();\n        let pat = pats[rng.below(pats.len())];\n        let subj = subjects[rng.below(subjects.len())];\n        let bits = masks[rng.below(masks.len())];\n        diff(\n            &format!(\"replbytes iter={iter} pat={pat:?} subj={subj:?} repl={repl:?} b={bits:#x}\"),\n            |api| {\n                let mut l = Log::new();\n                unsafe {\n                    let code = compile_logged(\n                        api,\n                        pat.as_bytes(),\n                        pat.len(),\n                        0,\n                        std::ptr::null_mut(),\n                        &mut l,\n                    );\n                    if code.is_null() {\n                        return l;\n                    }\n                    call_sub(\n                        api,\n                        code,\n                        subj.as_ptr(),\n                        subj.len(),\n                        0,\n                        bits,\n                        std::ptr::null_mut(),\n                        std::ptr::null_mut(),\n                        repl.as_ptr(),\n                        repl.len(),\n                        128,\n                        &mut l,\n                    );\n                    (api.code_free)(code);\n                }\n                l\n            },\n        );\n    }\n}\n\n// ============================================================ ERRORS 148\n\n/// Row 148: every single option bit, and wholesale out-of-range option words,"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1251,"cache_read_input_tokens":204264,"cache_creation":{"ephemeral_5m_input_tokens":1251,"ephemeral_1h_input_tokens":0},"output_tokens":21,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01E4ym4QF9EYejzpLckvHyKE","session_id":"afdd377b-a8e3-4242-b7f7-f8439c40180f","uuid":"e68406d7-158a-48fa-b1b3-36de9d225193","t