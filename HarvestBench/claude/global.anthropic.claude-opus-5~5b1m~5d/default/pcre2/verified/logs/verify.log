{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019G62xbaMb9b5pc1ZNrganw","type":"tool_result","content":"1\t//! Phase B — `pcre2_compile` across the option cross-product, plus\n2\t//! `pcre2_pattern_info`, `pcre2_code_copy*` and `pcre2_callout_enumerate`.\n3\t//!\n4\t//! CONFIGS.md rows 47-89 · ERRORS.md rows 176-185.\n5\t#![allow(non_snake_case)]\n6\t\n7\tmod common;\n8\tuse common::corpus::*;\n9\tuse common::*;\n10\tuse std::ffi::c_void;\n11\tuse std::os::raw::c_int;\n12\t\n13\t/// Compiles `pat` with `options`/`extra`/`newline`/`bsr` and logs *everything*\n14\t/// observable: error code + offset, every `PCRE2_INFO_*`, and the full\n15\t/// serialized bytecode.\n16\tfn compile_probe(\n17\t    api: &Api,\n18\t    pat: &[u8],\n19\t    patlen: Sz,\n20\t    options: u32,\n21\t    extra: u32,\n22\t    newline: u32,\n23\t    bsr: u32,\n24\t    l: &mut Log,\n25\t) {\n26\t    unsafe {\n27\t        let cc = (api.compile_context_create)(std::ptr::null_mut());\n28\t        assert!(!cc.is_null());\n29\t        if extra != 0 {\n30\t            l.i((api.set_compile_extra_options)(cc, extra) as i64);\n31\t        }\n32\t        if newline != 0 {\n33\t            l.i((api.set_newline)(cc, newline) as i64);\n34\t        }\n35\t        if bsr != 0 {\n36\t            l.i((api.set_bsr)(cc, bsr) as i64);\n37\t        }\n38\t        let code = compile_logged(api, pat, patlen, options, cc, l);\n39\t        if !code.is_null() {\n40\t            log_all_info(api, code, l);\n41\t            log_serialized(api, code, l);\n42\t            // code_copy and code_copy_with_tables must produce equivalent codes\n43\t            let cp = (api.code_copy)(code);\n44\t            l.tag(\"copy\").i(cp.is_null() as i64);\n45\t            if !cp.is_null() {\n46\t                log_all_info(api, cp, l);\n47\t                (api.code_free)(cp);\n48\t            }\n49\t            let cpt = (api.code_copy_with_tables)(code);\n50\t            l.tag(\"copyt\").i(cpt.is_null() as i64);\n51\t            if !cpt.is_null() {\n52\t                log_all_info(api, cpt, l);\n53\t                (api.code_free)(cpt);\n54\t            }\n55\t            (api.code_free)(code);\n56\t        }\n57\t        (api.compile_context_free)(cc);\n58\t    }\n59\t}\n60\t\n61\tfn diff_compile(label: &str, pat: &[u8], options: u32, extra: u32, newline: u32, bsr: u32) {\n62\t    diff(label, |api| {\n63\t        let mut l = Log::new();\n64\t        compile_probe(api, pat, pat.len(), options, extra, newline, bsr, &mut l);\n65\t        l\n66\t    });\n67\t}\n68\t\n69\t// -------------------------------------------------- row 47/48: baseline shapes\n70\t\n71\t#[test]\n72\tfn compile_all_patterns_no_options() {\n73\t    for (i, p) in PATTERNS.iter().enumerate() {\n74\t        diff_compile(&format!(\"plain[{i}]={p:?}\"), p.as_bytes(), 0, 0, 0, 0);\n75\t    }\n76\t}\n77\t\n78\t#[test]\n79\tfn compile_zero_terminated_vs_explicit_length() {\n80\t    for (i, p) in PATTERNS.iter().enumerate() {\n81\t        // Zero-terminated form: identical result unless the pattern has a NUL.\n82\t        let mut z = p.as_bytes().to_vec();\n83\t        z.push(0);\n84\t        diff(&format!(\"zt[{i}]\"), |api| {\n85\t            let mut l = Log::new();\n86\t            compile_probe(api, &z, PCRE2_ZERO_TERMINATED, 0, 0, 0, 0, &mut l);\n87\t            // explicit length that is shorter than the string\n88\t            for cut in [0usize, 1, p.len() / 2] {\n89\t                if cut <= p.len() {\n90\t                    compile_probe(api, &z, cut, 0, 0, 0, 0, &mut l);\n91\t                }\n92\t            }\n93\t            l\n94\t        });\n95\t    }\n96\t    // NULL pattern with zero and non-zero length (ERRORS rows 4/5).\n97\t    diff(\"null_pattern\", |api| {\n98\t        let mut l = Log::new();\n99\t        unsafe {\n100\t            for len in [0usize, 1, 5, PCRE2_ZERO_TERMINATED] {\n101\t                let mut ec: c_int = 0x7FFF;\n102\t                let mut eo: Sz = 0xDEAD;\n103\t                let code = (api.compile)(\n104\t                    std::ptr::null(),\n105\t                    len,\n106\t                    0,\n107\t                    &mut ec,\n108\t                    &mut eo,\n109\t                    std::ptr::null_mut(),\n110\t                );\n111\t                l.i(code.is_null() as i64).i(ec as i64).u(eo as u64);\n112\t                if !code.is_null() {\n113\t                    log_all_info(api, code, &mut l);\n114\t                    (api.code_free)(code);\n115\t                }\n116\t            }\n117\t        }\n118\t        l\n119\t    });\n120\t}\n121\t\n122\t// -------------------------------------------------- rows 49-80: single options\n123\t\n124\t/// Every compile option bit, applied on its own to every pattern.\n125\t#[test]\n126\tfn compile_each_option_bit() {\n127\t    let opts: &[(&str, u32)] = &[\n128\t        (\"ANCHORED\", PCRE2_ANCHORED),\n129\t        (\"NO_UTF_CHECK\", PCRE2_NO_UTF_CHECK),\n130\t        (\"ENDANCHORED\", PCRE2_ENDANCHORED),\n131\t        (\"ALLOW_EMPTY_CLASS\", PCRE2_ALLOW_EMPTY_CLASS),\n132\t        (\"ALT_BSUX\", PCRE2_ALT_BSUX),\n133\t        (\"AUTO_CALLOUT\", PCRE2_AUTO_CALLOUT),\n134\t        (\"CASELESS\", PCRE2_CASELESS),\n135\t        (\"DOLLAR_ENDONLY\", PCRE2_DOLLAR_ENDONLY),\n136\t        (\"DOTALL\", PCRE2_DOTALL),\n137\t        (\"DUPNAMES\", PCRE2_DUPNAMES),\n138\t        (\"EXTENDED\", PCRE2_EXTENDED),\n139\t        (\"FIRSTLINE\", PCRE2_FIRSTLINE),\n140\t        (\"MATCH_UNSET_BACKREF\", PCRE2_MATCH_UNSET_BACKREF),\n141\t        (\"MULTILINE\", PCRE2_MULTILINE),\n142\t        (\"NEVER_UCP\", PCRE2_NEVER_UCP),\n143\t        (\"NEVER_UTF\", PCRE2_NEVER_UTF),\n144\t        (\"NO_AUTO_CAPTURE\", PCRE2_NO_AUTO_CAPTURE),\n145\t        (\"NO_AUTO_POSSESS\", PCRE2_NO_AUTO_POSSESS),\n146\t        (\"NO_DOTSTAR_ANCHOR\", PCRE2_NO_DOTSTAR_ANCHOR),\n147\t        (\"NO_START_OPTIMIZE\", PCRE2_NO_START_OPTIMIZE),\n148\t        (\"UCP\", PCRE2_UCP),\n149\t        (\"UNGREEDY\", PCRE2_UNGREEDY),\n150\t        (\"UTF\", PCRE2_UTF),\n151\t        (\"NEVER_BACKSLASH_C\", PCRE2_NEVER_BACKSLASH_C),\n152\t        (\"ALT_CIRCUMFLEX\", PCRE2_ALT_CIRCUMFLEX),\n153\t        (\"ALT_VERBNAMES\", PCRE2_ALT_VERBNAMES),\n154\t        (\"USE_OFFSET_LIMIT\", PCRE2_USE_OFFSET_LIMIT),\n155\t        (\"EXTENDED_MORE\", PCRE2_EXTENDED_MORE),\n156\t        (\"LITERAL\", PCRE2_LITERAL),\n157\t        (\"MATCH_INVALID_UTF\", PCRE2_MATCH_INVALID_UTF),\n158\t        (\"ALT_EXTENDED_CLASS\", PCRE2_ALT_EXTENDED_CLASS),\n159\t    ];\n160\t    for (name, bit) in opts {\n161\t        for (i, p) in PATTERNS.iter().enumerate() {\n162\t            diff_compile(&format!(\"opt={name} pat[{i}]={p:?}\"), p.as_bytes(), *bit, 0, 0, 0);\n163\t        }\n164\t    }\n165\t}\n166\t\n167\t/// Every `PCRE2_EXTRA_*` option bit on its own (rows 39, 59, 72-80).\n168\t#[test]\n169\tfn compile_each_extra_option_bit() {\n170\t    let extras: &[(&str, u32)] = &[\n171\t        (\"ALLOW_SURROGATE_ESCAPES\", PCRE2_EXTRA_ALLOW_SURROGATE_ESCAPES),\n172\t        (\"BAD_ESCAPE_IS_LITERAL\", PCRE2_EXTRA_BAD_ESCAPE_IS_LITERAL),\n173\t        (\"MATCH_WORD\", PCRE2_EXTRA_MATCH_WORD),\n174\t        (\"MATCH_LINE\", PCRE2_EXTRA_MATCH_LINE),\n175\t        (\"ESCAPED_CR_IS_LF\", PCRE2_EXTRA_ESCAPED_CR_IS_LF),\n176\t        (\"ALT_BSUX\", PCRE2_EXTRA_ALT_BSUX),\n177\t        (\"ALLOW_LOOKAROUND_BSK\", PCRE2_EXTRA_ALLOW_LOOKAROUND_BSK),\n178\t        (\"CASELESS_RESTRICT\", PCRE2_EXTRA_CASELESS_RESTRICT),\n179\t        (\"ASCII_BSD\", PCRE2_EXTRA_ASCII_BSD),\n180\t        (\"ASCII_BSS\", PCRE2_EXTRA_ASCII_BSS),\n181\t        (\"ASCII_BSW\", PCRE2_EXTRA_ASCII_BSW),\n182\t        (\"ASCII_POSIX\", PCRE2_EXTRA_ASCII_POSIX),\n183\t        (\"ASCII_DIGIT\", PCRE2_EXTRA_ASCII_DIGIT),\n184\t        (\"PYTHON_OCTAL\", PCRE2_EXTRA_PYTHON_OCTAL),\n185\t        (\"NEVER_CALLOUT\", PCRE2_EXTRA_NEVER_CALLOUT),\n186\t        (\"TURKISH_CASING\", PCRE2_EXTRA_TURKISH_CASING),\n187\t    ];\n188\t    for (name, bit) in extras {\n189\t        for base in [0u32, PCRE2_UTF, PCRE2_UTF | PCRE2_UCP, PCRE2_CASELESS] {\n190\t            for (i, p) in PATTERNS.iter().enumerate() {\n191\t                diff_compile(\n192\t                    &format!(\"extra={name} base={base:#x} pat[{i}]={p:?}\"),\n193\t                    p.as_bytes(),\n194\t                    base,\n195\t                    *bit,\n196\t                    0,\n197\t                    0,\n198\t                );\n199\t            }\n200\t        }\n201\t    }\n202\t}\n203\t\n204\t/// Newline conventions × BSR conventions (rows 34, 50, 63).\n205\t#[test]\n206\tfn compile_newline_and_bsr_conventions() {\n207\t    for nl in 1..=6u32 {\n208\t        for bsr in 1..=2u32 {\n209\t            for base in [0u32, PCRE2_MULTILINE, PCRE2_FIRSTLINE, PCRE2_DOTALL] {\n210\t                for (i, p) in PATTERNS.iter().enumerate() {\n211\t                    diff_compile(\n212\t                        &format!(\"nl={nl} bsr={bsr} base={base:#x} pat[{i}]\"),\n213\t                        p.as_bytes(),\n214\t                        base,\n215\t                        0,\n216\t                        nl,\n217\t                        bsr,\n218\t                    );\n219\t                }\n220\t            }\n221\t        }\n222\t    }\n223\t}\n224\t\n225\t/// Extended-class patterns need `PCRE2_ALT_EXTENDED_CLASS` (row 68).\n226\t#[test]\n227\tfn compile_extended_classes() {\n228\t    for (i, p) in ECLASS_PATTERNS.iter().enumerate() {\n229\t        for opt in [\n230\t            0u32,\n231\t            PCRE2_ALT_EXTENDED_CLASS,\n232\t            PCRE2_ALT_EXTENDED_CLASS | PCRE2_UTF,\n233\t            PCRE2_ALT_EXTENDED_CLASS | PCRE2_UCP,\n234\t            PCRE2_ALT_EXTENDED_CLASS | PCRE2_CASELESS,\n235\t            PCRE2_ALT_EXTENDED_CLASS | PCRE2_EXTENDED,\n236\t        ] {\n237\t            diff_compile(&format!(\"eclass[{i}] opt={opt:#x}\"), p.as_bytes(), opt, 0, 0, 0);\n238\t        }\n239\t    }\n240\t}\n241\t\n242\t/// Empty classes need `PCRE2_ALLOW_EMPTY_CLASS` (row 67).\n243\t#[test]\n244\tfn compile_empty_classes() {\n245\t    for (i, p) in EMPTY_CLASS_PATTERNS.iter().enumerate() {\n246\t        for opt in [0u32, PCRE2_ALLOW_EMPTY_CLASS, PCRE2_ALLOW_EMPTY_CLASS | PCRE2_UTF] {\n247\t            diff_compile(&format!(\"emptycls[{i}] opt={opt:#x}\"), p.as_bytes(), opt, 0, 0, 0);\n248\t        }\n249\t    }\n250\t}\n251\t\n252\t// -------------------------------------------------- rows 35-40: limits\n253\t\n254\t#[test]\n255\tfn compile_limits() {\n256\t    let pats: Vec<Vec<u8>> = vec![\n257\t        b\"abc\".to_vec(),\n258\t        b\"(((((((((((a)))))))))))\".to_vec(),\n259\t        b\"(?<=a{1,20}b)c\".to_vec(),\n260\t        b\"a{1,100}\".to_vec(),\n261\t        // 300-deep nesting to cross the default parens_nest_limit of 250\n262\t        {\n263\t            let mut v = Vec::new();\n264\t            for _ in 0..300 {\n265\t                v.push(b'(');\n266\t            }\n267\t            v.push(b'a');\n268\t            for _ in 0..300 {\n269\t                v.push(b')');\n270\t            }\n271\t            v\n272\t        },\n273\t    ];\n274\t    for (i, p) in pats.iter().enumerate() {\n275\t        diff(&format!(\"limits[{i}]\"), |api| {\n276\t            let mut l = Log::new();\n277\t            unsafe {\n278\t                for maxpatlen in [0usize, 1, 2, p.len(), p.len() + 1, usize::MAX] {\n279\t                    for maxcompiled in [0usize, 1, 16, 1024, usize::MAX] {\n280\t                        for parens in [0u32, 1, 5, 250, 1000] {\n281\t                            for varlb in [0u32, 1, 20, 255] {\n282\t                                let cc = (api.compile_context_create)(std::ptr::null_mut());\n283\t                                l.i((api.set_max_pattern_length)(cc, maxpatlen) as i64);\n284\t                                l.i((api.set_max_pattern_compiled_length)(cc, maxcompiled) as i64);\n285\t                                l.i((api.set_parens_nest_limit)(cc, parens) as i64);\n286\t                                l.i((api.set_max_varlookbehind)(cc, varlb) as i64);\n287\t                                let code = compile_logged(api, p, p.len(), 0, cc, &mut l);\n288\t                                if !code.is_null() {\n289\t                                    let mut v: Sz = 0;\n290\t                                    (api.pattern_info)(\n291\t                                        code,\n292\t                                        INFO_SIZE,\n293\t                                        &mut v as *mut Sz as *mut c_void,\n294\t                                    );\n295\t                                    l.u(v as u64);\n296\t                                    (api.code_free)(code);\n297\t                                }\n298\t                                (api.compile_context_free)(cc);\n299\t                            }\n300\t                        }\n301\t                    }\n302\t                }\n303\t            }\n304\t            l\n305\t        });\n306\t    }\n307\t}\n308\t\n309\t// -------------------------------------------------- row 40: set_optimize\n310\t\n311\t#[test]\n312\tfn compile_optimize_directives() {\n313\t    let directives = [\n314\t        PCRE2_OPTIMIZATION_NONE,\n315\t        PCRE2_OPTIMIZATION_FULL,\n316\t        PCRE2_AUTO_POSSESS,\n317\t        PCRE2_AUTO_POSSESS_OFF,\n318\t        PCRE2_DOTSTAR_ANCHOR,\n319\t        PCRE2_DOTSTAR_ANCHOR_OFF,\n320\t        PCRE2_START_OPTIMIZE,\n321\t        PCRE2_START_OPTIMIZE_OFF,\n322\t    ];\n323\t    for (i, p) in PATTERNS.iter().enumerate() {\n324\t        diff(&format!(\"optimize pat[{i}]\"), |api| {\n325\t            let mut l = Log::new();\n326\t            unsafe {\n327\t                for d in directives {\n328\t                    let cc = (api.compile_context_create)(std::ptr::null_mut());\n329\t                    l.i((api.set_optimize)(cc, d) as i64);\n330\t                    let code = compile_logged(api, p.as_bytes(), p.len(), 0, cc, &mut l);\n331\t                    if !code.is_null() {\n332\t                        log_all_info(api, code, &mut l);\n333\t                        log_serialized(api, code, &mut l);\n334\t                        (api.code_free)(code);\n335\t                    }\n336\t                    (api.compile_context_free)(cc);\n337\t                }\n338\t                // Sequences of directives (the flags word accumulates).\n339\t                let cc = (api.compile_context_create)(std::ptr::null_mut());\n340\t                for d in directives {\n341\t                    l.i((api.set_optimize)(cc, d) as i64);\n342\t                }\n343\t                let code = compile_logged(api, p.as_bytes(), p.len(), 0, cc, &mut l);\n344\t                if !code.is_null() {\n345\t                    log_all_info(api, code, &mut l);\n346\t                    (api.code_free)(code);\n347\t                }\n348\t                (api.compile_context_free)(cc);\n349\t            }\n350\t            l\n351\t        });\n352\t    }\n353\t}\n354\t\n355\t// -------------------------------------------------- row 7: custom tables\n356\t\n357\t#[test]\n358\tfn compile_with_generated_character_tables() {\n359\t    for (i, p) in PATTERNS.iter().enumerate() {\n360\t        diff(&format!(\"tables pat[{i}]\"), |api| {\n361\t            let mut l = Log::new();\n362\t            unsafe {\n363\t                let tables = (api.maketables)(std::ptr::null_mut());\n364\t                let cc = (api.compile_context_create)(std::ptr::null_mut());\n365\t                l.i((api.set_character_tables)(cc, tables) as i64);\n366\t                let code = compile_logged(api, p.as_bytes(), p.len(), PCRE2_CASELESS, cc, &mut l);\n367\t                if !code.is_null() {\n368\t                    log_all_info(api, code, &mut l);\n369\t                    log_serialized(api, code, &mut l);\n370\t                    (api.code_free)(code);\n371\t                }\n372\t                // and explicitly NULL tables (falls back to defaults)\n373\t                l.i((api.set_character_tables)(cc, std::ptr::null()) as i64);\n374\t                let code2 = compile_logged(api, p.as_bytes(), p.len(), PCRE2_CASELESS, cc, &mut l);\n375\t                if !code2.is_null() {\n376\t                    log_all_info(api, code2, &mut l);\n377\t                    (api.code_free)(code2);\n378\t                }\n379\t                (api.compile_context_free)(cc);\n380\t                (api.maketables_free)(std::ptr::null_mut(), tables);\n381\t            }\n382\t            l\n383\t        });\n384\t    }\n385\t}\n386\t\n387\t// -------------------------------------------------- row 45: recursion guard\n388\t\n389\tstatic mut GUARD_CALLS: u32 = 0;\n390\t\n391\tunsafe extern \"C\" fn guard_ok(_depth: u32, _d: *mut c_void) -> c_int {\n392\t    GUARD_CALLS += 1;\n393\t    0\n394\t}\n395\tunsafe extern \"C\" fn guard_fail_deep(depth: u32, _d: *mut c_void) -> c_int {\n396\t    GUARD_CALLS += 1;\n397\t    if depth > 3 {\n398\t        1\n399\t    } else {\n400\t        0\n401\t    }\n402\t}\n403\tunsafe extern \"C\" fn guard_always_fail(_depth: u32, _d: *mut c_void) -> c_int {\n404\t    GUARD_CALLS += 1;\n405\t    1\n406\t}\n407\t\n408\t#[test]\n409\tfn compile_recursion_guard() {\n410\t    let pats: [&str; 6] = [\n411\t        \"a\",\n412\t        \"(a)\",\n413\t        \"((a))\",\n414\t        \"((((a))))\",\n415\t        \"((((((((a))))))))\",\n416\t        \"(a(b(c(d(e)))))\",\n417\t    ];\n418\t    for (i, p) in pats.iter().enumerate() {\n419\t        diff(&format!(\"guard pat[{i}]\"), |api| {\n420\t            let mut l = Log::new();\n421\t            unsafe {\n422\t                for (k, g) in [\n423\t                    None,\n424\t                    Some(guard_ok as unsafe extern \"C\" fn(u32, *mut c_void) -> c_int),\n425\t                    Some(guard_fail_deep as unsafe extern \"C\" fn(u32, *mut c_void) -> c_int),\n426\t                    Some(guard_always_fail as unsafe extern \"C\" fn(u32, *mut c_void) -> c_int),\n427\t                ]\n428\t                .iter()\n429\t                .enumerate()\n430\t                {\n431\t                    GUARD_CALLS = 0;\n432\t                    let cc = (api.compile_context_create)(std::ptr::null_mut());\n433\t                    l.i((api.set_compile_recursion_guard)(cc, *g, std::ptr::null_mut()) as i64);\n434\t                    let code = compile_logged(api, p.as_bytes(), p.len(), 0, cc, &mut l);\n435\t                    l.u(k as u64).u(GUARD_CALLS as u64);\n436\t                    if !code.is_null() {\n437\t                        log_all_info(api, code, &mut l);\n438\t                        (api.code_free)(code);\n439\t                    }\n440\t                    (api.compile_context_free)(cc);\n441\t                }\n442\t            }\n443\t            l\n444\t        });\n445\t    }\n446\t}\n447\t\n448\t// -------------------------------------------------- row 82: randomized patterns\n449\t\n450\t#[test]\n451\tfn compile_random_patterns() {\n452\t    let mut rng = Rng::new(0xC0FFEE_01);\n453\t    let combos: [(u32, u32); 12] = [\n454\t        (0, 0),\n455\t        (PCRE2_CASELESS, 0),\n456\t        (PCRE2_UTF, 0),\n457\t        (PCRE2_UTF | PCRE2_UCP, 0),\n458\t        (PCRE2_MULTILINE | PCRE2_DOTALL, 0),\n459\t        (PCRE2_EXTENDED, 0),\n460\t        (PCRE2_UNGREEDY, 0),\n461\t        (PCRE2_NO_AUTO_CAPTURE, 0),\n462\t        (PCRE2_AUTO_CALLOUT, 0),\n463\t        (PCRE2_NO_AUTO_POSSESS | PCRE2_NO_START_OPTIMIZE, 0),\n464\t        (PCRE2_UTF | PCRE2_CASELESS, PCRE2_EXTRA_CASELESS_RESTRICT),\n465\t        (PCRE2_UCP, PCRE2_EXTRA_ASCII_BSD | PCRE2_EXTRA_ASCII_BSW),\n466\t    ];\n467\t    for iter in 0..1200 {\n468\t        let pat = PatternGen::gen(&mut rng);\n469\t        for (opts, extra) in combos {\n470\t            diff_compile(\n471\t                &format!(\"randpat iter={iter} pat={pat:?} opts={opts:#x} extra={extra:#x}\"),\n472\t                pat.as_bytes(),\n473\t                opts,\n474\t                extra,\n475\t                0,\n476\t                0,\n477\t            );\n478\t        }\n479\t    }\n480\t}\n481\t\n482\t/// Random *bytes* as a pattern: mostly invalid, which exercises the whole\n483\t/// error surface of the parser and must produce identical error codes/offsets.\n484\t#[test]\n485\tfn compile_random_bytes() {\n486\t    let mut rng = Rng::new(0xC0FFEE_02);\n487\t    let alphabet: &[u8] = b\"ab()[]{}|*+?.^$\\\\-,:!<>=&~#'\\\"`0123456789PpQqEeCcRrNnKkGgXxUuLlWwSsDdHhVvBbAaZzTtMmFfIiJjOoYy \\t\\n\";\n488\t    for iter in 0..8000 {\n489\t        let n = rng.below(14);\n490\t        let pat: Vec<u8> = (0..n).map(|_| *rng.pick(alphabet)).collect();\n491\t        for opts in [\n492\t            0u32,\n493\t            PCRE2_UTF,\n494\t            PCRE2_UCP,\n495\t            PCRE2_CASELESS | PCRE2_MULTILINE,\n496\t            PCRE2_EXTENDED,\n497\t            PCRE2_ALT_EXTENDED_CLASS,\n498\t            PCRE2_ALT_BSUX,\n499\t            PCRE2_ALLOW_EMPTY_CLASS,\n500\t            PCRE2_LITERAL,\n501\t        ] {\n502\t            diff_compile(\n503\t                &format!(\"randbytes iter={iter} pat={pat:?} opts={opts:#x}\"),\n504\t                &pat,\n505\t                opts,\n506\t                0,\n507\t                0,\n508\t                0,\n509\t            );\n510\t        }\n511\t    }\n512\t}\n513\t\n514\t// -------------------------------------------------- row 89: callout_enumerate\n515\t\n516\tstatic mut ENUM_LOG: Vec<u8> = Vec::new();\n517\t\n518\tunsafe extern \"C\" fn enum_cb(b: *mut CalloutEnumerateBlock, data: *mut c_void) -> c_int {\n519\t    let b = &*b;\n520\t    let v = &mut *(data as *mut Vec<u8>);\n521\t    v.extend_from_slice(&b.version.to_le_bytes());\n522\t    v.extend_from_slice(&b.pattern_position.to_le_bytes());\n523\t    v.extend_from_slice(&b.next_item_length.to_le_bytes());\n524\t    v.extend_from_slice(&b.callout_number.to_le_bytes());\n525\t    v.extend_from_slice(&b.callout_string_offset.to_le_bytes());\n526\t    v.extend_from_slice(&b.callout_string_length.to_le_bytes());\n527\t    if b.callout_string.is_null() {\n528\t        v.push(0);\n529\t    } else {\n530\t        v.push(1);\n531\t        v.extend_from_slice(std::slice::from_raw_parts(\n532\t            b.callout_string,\n533\t            b.callout_string_length,\n534\t        ));\n535\t    }\n536\t    0\n537\t}\n538\t\n539\tunsafe extern \"C\" fn enum_cb_stop(_b: *mut CalloutEnumerateBlock, _d: *mut c_void) -> c_int {\n540\t    -99\n541\t}\n542\t\n543\t#[test]\n544\tfn callout_enumerate_all() {\n545\t    for (i, p) in PATTERNS.iter().enumerate() {\n546\t        for opts in [0u32, PCRE2_AUTO_CALLOUT, PCRE2_AUTO_CALLOUT | PCRE2_UTF] {\n547\t            diff(&format!(\"calloutenum pat[{i}] opts={opts:#x}\"), |api| {\n548\t                let mut l = Log::new();\n549\t                unsafe {\n550\t                    let code =\n551\t                        compile_logged(api, p.as_bytes(), p.len(), opts, std::ptr::null_mut(), &mut l);\n552\t                    if code.is_null() {\n553\t                        return l;\n554\t                    }\n555\t                    let mut buf: Vec<u8> = Vec::new();\n556\t                    let rc = (api.callout_enumerate)(\n557\t                        code,\n558\t                        Some(enum_cb),\n559\t                        &mut buf as *mut Vec<u8> as *mut c_void,\n560\t                    );\n561\t                    l.i(rc as i64).b(&buf);\n562\t                    // A callback that aborts must propagate its return value.\n563\t                    let rc2 = (api.callout_enumerate)(\n564\t                        code,\n565\t                        Some(enum_cb_stop),\n566\t                        std::ptr::null_mut(),\n567\t                    );\n568\t                    l.i(rc2 as i64);\n569\t                    (api.code_free)(code);\n570\t                }\n571\t                l\n572\t            });\n573\t        }\n574\t    }\n575\t}\n576\t\n577\t// -------------------------------------------------- ERRORS rows 176-185\n578\t\n579\t#[test]\n580\tfn pattern_info_error_paths() {\n581\t    diff(\"pattern_info_errors\", |api| {\n582\t        let mut l = Log::new();\n583\t        unsafe {\n584\t            // code == NULL\n585\t            let mut v: u32 = 0;\n586\t            for what in 0..=27u32 {\n587\t                let rc = (api.pattern_info)(\n588\t                    std::ptr::null_mut(),\n589\t                    what,\n590\t                    &mut v as *mut u32 as *mut c_void,\n591\t                );\n592\t                l.i(rc as i64);\n593\t            }\n594\t            // bad magic: corrupt a copy of a real compiled code\n595\t            let code = compile_logged(api, b\"abc\", 3, 0, std::ptr::null_mut(), &mut l);\n596\t            assert!(!code.is_null());\n597\t            let cp = (api.code_copy)(code);\n598\t            // magic_number is the first field of pcre2_real_code\n599\t            let magic = cp as *mut u32;\n600\t            let saved = *magic;\n601\t            *magic = 0xDEAD_BEEF;\n602\t            for what in [INFO_SIZE, INFO_CAPTURECOUNT, INFO_NAMETABLE, 9999] {\n603\t                let rc = (api.pattern_info)(cp, what, &mut v as *mut u32 as *mut c_void);\n604\t                l.tag(\"badmagic\").i(rc as i64);\n605\t            }\n606\t            *magic = saved;\n607\t            // bad mode: clear the code-unit-width bit in `flags`\n608\t            // (offset of flags: magic_number u32, compiled_code_size Sz,\n609\t            //  blocksize Sz, ... — locate it by scanning for the width bit is\n610\t            //  fragile, so instead verify BADMODE via serialize with a wrong\n611\t            //  config, which is covered in the serialize tests.)\n612\t            (api.code_free)(cp);\n613\t\n614\t            // Unset limits => PCRE2_ERROR_UNSET\n615\t            for what in [INFO_DEPTHLIMIT, INFO_HEAPLIMIT, INFO_MATCHLIMIT] {\n616\t                let rc = (api.pattern_info)(code, what, &mut v as *mut u32 as *mut c_void);\n617\t                l.tag(\"unset\").i(rc as i64);\n618\t            }\n619\t            // where == NULL size-query form\n620\t            for what in 0..=27u32 {\n621\t                let rc = (api.pattern_info)(code, what, std::ptr::null_mut());\n622\t                l.tag(\"nullwhere\").i(rc as i64);\n623\t            }\n624\t            (api.code_free)(code);\n625\t\n626\t            // callout_enumerate with NULL code\n627\t            let rc = (api.callout_enumerate)(\n628\t                std::ptr::null_mut(),\n629\t                Some(enum_cb),\n630\t                std::ptr::null_mut(),\n631\t            );\n632\t            l.tag(\"ce_null\").i(rc as i64);\n633\t        }\n634\t        l\n635\t    });\n636\t}\n637\t\n638\t/// Limits set by inline `(*LIMIT_*)` directives must be reported identically.\n639\t#[test]\n640\tfn pattern_info_inline_limits() {\n641\t    let pats = [\n642\t        \"(*LIMIT_MATCH=1000)a\",\n643\t        \"(*LIMIT_DEPTH=50)a\",\n644\t        \"(*LIMIT_HEAP=64)a\",\n645\t        \"(*LIMIT_MATCH=1)(*LIMIT_DEPTH=2)(*LIMIT_HEAP=3)a\",\n646\t        \"(*LIMIT_MATCH=0)a\",\n647\t        \"(*LIMIT_MATCH=4294967295)a\",\n648\t        \"(*LIMIT_MATCH=99999999999999999999)a\",\n649\t    ];\n650\t    for (i, p) in pats.iter().enumerate() {\n651\t        diff(&format!(\"inline_limits[{i}]\"), |api| {\n652\t            let mut l = Log::new();\n653\t            unsafe {\n654\t                let code =\n655\t                    compile_logged(api, p.as_bytes(), p.len(), 0, std::ptr::null_mut(), &mut l);\n656\t                if !code.is_null() {\n657\t                    log_all_info(api, code, &mut l);\n658\t                    (api.code_free)(code);\n659\t                }\n660\t            }\n661\t            l\n662\t        });\n663\t    }\n664\t}\n665\t"}]},"parent_tool_use_id":"toolu_bdrk_01E4ym4QF9EYejzpLckvHyKE","ses