compile_logged(api, b\"abc\", 3, 0, cc, &mut l);\n        let mixed: [Code;2] = [code, ct];\n        note(\"enc mixedtables\", (api.serialize_encode)(mixed.as_ptr(), 2, &mut bytes, &mut size, std::ptr::null_mut()));\n        (api.code_free)(ct); (api.compile_context_free)(cc); (api.maketables_free)(std::ptr::null_mut(), tables);\n\n        let st = raw_encode(api, code).unwrap();\n        let mut sink: [Code;8] = [std::ptr::null_mut(); 8];\n        note(\"dec null bytes\", (api.serialize_decode)(sink.as_mut_ptr(), 1, std::ptr::null(), std::ptr::null_mut()));\n        note(\"dec n=0\", (api.serialize_decode)(sink.as_mut_ptr(), 0, st.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_u32(OFF_NCODES_H, 0);\n        note(\"dec hdr ncodes=0\", (api.serialize_decode)(sink.as_mut_ptr(), 1, s2.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_u32(OFF_MAGIC_H, 0);\n        note(\"dec badmagic\", (api.serialize_decode)(sink.as_mut_ptr(), 1, s2.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_u32(OFF_VERSION_H, 0);\n        note(\"dec badversion\", (api.serialize_decode)(sink.as_mut_ptr(), 1, s2.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_u32(OFF_CONFIG_H, 0);\n        note(\"dec badconfig\", (api.serialize_decode)(sink.as_mut_ptr(), 1, s2.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_usize(BODY+OFF_BLOCKSIZE, 0);\n        note(\"dec badblocksize\", (api.serialize_decode)(sink.as_mut_ptr(), 1, s2.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_u32(BODY+OFF_MAGIC, 0);\n        note(\"dec body badmagic\", (api.serialize_decode)(sink.as_mut_ptr(), 1, s2.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_u16(BODY+OFF_NAME_COUNT, 0xFFFF);\n        note(\"dec namecount\", (api.serialize_decode)(sink.as_mut_ptr(), 1, s2.as_ptr(), std::ptr::null_mut()));\n        let mut s2 = st.dup(); s2.put_u16(BODY+OFF_NAME_ENTRY