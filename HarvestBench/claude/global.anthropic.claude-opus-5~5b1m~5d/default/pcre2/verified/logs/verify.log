{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017ScQP9b8VsJxcZgvPyay8U","type":"tool_result","content":"1\t//! Shared pattern / subject corpora and a randomized *valid*-pattern generator.\n2\t//!\n3\t//! Used by every Phase-B test file so that the same broad set of pattern shapes\n4\t//! is exercised under every option combination.\n5\t#![allow(dead_code)]\n6\t\n7\tuse super::Rng;\n8\t\n9\t/// Hand-written patterns covering every construct the compiler special-cases.\n10\t/// Derived from the `switch` arms in `pcre2_compile.c` / `pcre2_compile_class.c`\n11\t/// / `pcre2_compile_cgroup.c` and the opcode list in `pcre2_internal.h`.\n12\tpub const PATTERNS: &[&str] = &[\n13\t    // literals & empty\n14\t    \"\",\n15\t    \"a\",\n16\t    \"abc\",\n17\t    \"a\\0b\",\n18\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n19\t    // dot / anchors\n20\t    \".\",\n21\t    \"..\",\n22\t    \"^a\",\n23\t    \"a$\",\n24\t    \"^a$\",\n25\t    \"^\",\n26\t    \"$\",\n27\t    r\"\\A\",\n28\t    r\"\\Z\",\n29\t    r\"\\z\",\n30\t    r\"\\G\",\n31\t    r\"\\b\",\n32\t    r\"\\B\",\n33\t    r\"\\K\",\n34\t    r\"a\\Kb\",\n35\t    // simple classes\n36\t    \"[a]\",\n37\t    \"[abc]\",\n38\t    \"[^abc]\",\n39\t    \"[a-z]\",\n40\t    \"[^a-z]\",\n41\t    \"[a-zA-Z0-9_]\",\n42\t    \"[]]\",\n43\t    \"[^]]\",\n44\t    \"[-a]\",\n45\t    \"[a-]\",\n46\t    r\"[\\]]\",\n47\t    r\"[\\\\]\",\n48\t    r\"[\\d]\",\n49\t    r\"[\\D]\",\n50\t    r\"[\\w\\W]\",\n51\t    r\"[\\s\\S]\",\n52\t    r\"[\\h\\H]\",\n53\t    r\"[\\v\\V]\",\n54\t    \"[[:alpha:]]\",\n55\t    \"[[:^alpha:]]\",\n56\t    \"[[:digit:][:space:]]\",\n57\t    \"[[:alnum:][:punct:]]\",\n58\t    \"[[:ascii:]]\",\n59\t    \"[[:blank:]]\",\n60\t    \"[[:cntrl:]]\",\n61\t    \"[[:graph:]]\",\n62\t    \"[[:lower:]]\",\n63\t    \"[[:print:]]\",\n64\t    \"[[:upper:]]\",\n65\t    \"[[:word:]]\",\n66\t    \"[[:xdigit:]]\",\n67\t    // escapes\n68\t    r\"\\d\",\n69\t    r\"\\D\",\n70\t    r\"\\w\",\n71\t    r\"\\W\",\n72\t    r\"\\s\",\n73\t    r\"\\S\",\n74\t    r\"\\h\",\n75\t    r\"\\H\",\n76\t    r\"\\v\",\n77\t    r\"\\V\",\n78\t    r\"\\R\",\n79\t    r\"\\X\",\n80\t    r\"\\C\",\n81\t    r\"\\N\",\n82\t    r\"\\n\",\n83\t    r\"\\r\",\n84\t    r\"\\t\",\n85\t    r\"\\f\",\n86\t    r\"\\a\",\n87\t    r\"\\e\",\n88\t    r\"\\0\",\n89\t    r\"\\07\",\n90\t    r\"\\101\",\n91\t    r\"\\x41\",\n92\t    r\"\\x{41}\",\n93\t    r\"\\x{1F600}\",\n94\t    r\"\\o{101}\",\n95\t    r\"\\cA\",\n96\t    r\"\\Q a+b \\E\",\n97\t    r\"a\\Qb*c\\Ed\",\n98\t    r\"\\Qabc\",\n99\t    // quantifiers\n100\t    \"a*\",\n101\t    \"a+\",\n102\t    \"a?\",\n103\t    \"a{2}\",\n104\t    \"a{2,}\",\n105\t    \"a{2,4}\",\n106\t    \"a{0,3}\",\n107\t    \"a{0}\",\n108\t    \"a{1}\",\n109\t    \"a*?\",\n110\t    \"a+?\",\n111\t    \"a??\",\n112\t    \"a{2,4}?\",\n113\t    \"a*+\",\n114\t    \"a++\",\n115\t    \"a?+\",\n116\t    \"a{2,4}+\",\n117\t    \".*\",\n118\t    \".+\",\n119\t    \".*?\",\n120\t    \"[a-z]*\",\n121\t    \"[a-z]+?\",\n122\t    \"[a-z]{3,5}\",\n123\t    r\"\\d{1,3}\",\n124\t    r\"(?:ab)*\",\n125\t    r\"(ab)+\",\n126\t    r\"(a|b)*\",\n127\t    // alternation\n128\t    \"a|b\",\n129\t    \"a|b|c\",\n130\t    \"|a\",\n131\t    \"a|\",\n132\t    \"(a|b|)\",\n133\t    \"^a|b$\",\n134\t    // groups\n135\t    \"(a)\",\n136\t    \"(a)(b)\",\n137\t    \"((a))\",\n138\t    \"(?:a)\",\n139\t    \"(?i)a\",\n140\t    \"(?i:a)\",\n141\t    \"(?-i:a)\",\n142\t    \"(?s)a.b\",\n143\t    \"(?m)^a$\",\n144\t    \"(?x) a  b \",\n145\t    \"(?xx) a  b \",\n146\t    \"(?U)a*\",\n147\t    \"(?J)(?<n>a)(?<n>b)\",\n148\t    \"(?n)(a)\",\n149\t    \"(?>a+)b\",\n150\t    \"(?<n>a)\",\n151\t    \"(?'n'a)\",\n152\t    \"(?P<n>a)\",\n153\t    \"(?<n>a)(?&n)\",\n154\t    \"(?P>n)\",\n155\t    // backreferences\n156\t    r\"(a)\\1\",\n157\t    r\"(a)(b)\\2\\1\",\n158\t    r\"(?<n>a)\\k<n>\",\n159\t    r\"(?<n>a)\\k'n'\",\n160\t    r\"(?<n>a)\\k{n}\",\n161\t    r\"(?<n>a)(?P=n)\",\n162\t    r\"(a)\\g1\",\n163\t    r\"(a)\\g{1}\",\n164\t    r\"(a)\\g{-1}\",\n165\t    r\"(a)(b)\\g{-2}\",\n166\t    // recursion / subroutines\n167\t    r\"(a(?R)?b)\",\n168\t    r\"(a)(?1)\",\n169\t    r\"(?1)(a)\",\n170\t    r\"(?<n>a)(?&n)\",\n171\t    r\"\\((?>[^()]|(?R))*\\)\",\n172\t    r\"(?(DEFINE)(?<x>a))(?&x)\",\n173\t    // lookaround\n174\t    \"(?=a)\",\n175\t    \"(?!a)\",\n176\t    \"(?<=a)b\",\n177\t    \"(?<!a)b\",\n178\t    \"a(?=b)\",\n179\t    \"a(?!b)\",\n180\t    \"(?<=ab)c\",\n181\t    \"(?<=a|bc)d\",\n182\t    \"(*positive_lookahead:a)\",\n183\t    \"(*pla:a)\",\n184\t    \"(*negative_lookahead:a)\",\n185\t    \"(*nla:a)\",\n186\t    \"(*positive_lookbehind:a)b\",\n187\t    \"(*plb:a)b\",\n188\t    \"(*negative_lookbehind:a)b\",\n189\t    \"(*nlb:a)b\",\n190\t    \"(*atomic:a+)b\",\n191\t    \"(*asr:a)\",\n192\t    \"(*script_run:abc)\",\n193\t    \"(*sr:abc)\",\n194\t    // non-atomic lookaround\n195\t    \"(*napla:a)\",\n196\t    \"(*naplb:a)b\",\n197\t    // conditionals\n198\t    \"(a)?(?(1)b|c)\",\n199\t    \"(a)?(?(1)b)\",\n200\t    \"(?(?=a)b|c)\",\n201\t    \"(?(?!a)b|c)\",\n202\t    \"(?<n>a)?(?(<n>)b|c)\",\n203\t    \"(?(R)a|b)\",\n204\t    \"(?(R1)a|b)\",\n205\t    \"(?(DEFINE)(?<x>a))b\",\n206\t    \"(?(VERSION>=10.0)a|b)\",\n207\t    \"(?(VERSION=10.48)a|b)\",\n208\t    // verbs\n209\t    \"(*FAIL)\",\n210\t    \"(*F)\",\n211\t    \"a(*ACCEPT)b\",\n212\t    \"(*COMMIT)a\",\n213\t    \"(*PRUNE)a\",\n214\t    \"(*PRUNE:x)a\",\n215\t    \"(*SKIP)a\",\n216\t    \"(*SKIP:x)a\",\n217\t    \"(*THEN)a\",\n218\t    \"(*THEN:x)a\",\n219\t    \"(*MARK:x)a\",\n220\t    \"(*:x)a\",\n221\t    \"a(*MARK:m1)b|c(*MARK:m2)d\",\n222\t    // options embedded at the start\n223\t    \"(*UTF)a\",\n224\t    \"(*UCP)a\",\n225\t    \"(*CR)a.b\",\n226\t    \"(*LF)a.b\",\n227\t    \"(*CRLF)a.b\",\n228\t    \"(*ANY)a.b\",\n229\t    \"(*ANYCRLF)a.b\",\n230\t    \"(*NUL)a.b\",\n231\t    \"(*BSR_UNICODE)a\\\\Rb\",\n232\t    \"(*BSR_ANYCRLF)a\\\\Rb\",\n233\t    \"(*LIMIT_MATCH=100)a\",\n234\t    \"(*LIMIT_DEPTH=100)a\",\n235\t    \"(*LIMIT_HEAP=1000)a\",\n236\t    \"(*NO_AUTO_POSSESS)a+b\",\n237\t    \"(*NO_START_OPT)ab\",\n238\t    \"(*NO_DOTSTAR_ANCHOR).*a\",\n239\t    \"(*NO_JIT)a\",\n240\t    \"(*NOTEMPTY)a*\",\n241\t    \"(*NOTEMPTY_ATSTART)a*\",\n242\t    // comments and callouts\n243\t    \"a(?#comment)b\",\n244\t    \"(?C)a\",\n245\t    \"(?C1)a\",\n246\t    \"(?C255)a\",\n247\t    \"(?C{text})a\",\n248\t    \"(?C`text`)a\",\n249\t    \"(?C'text')a\",\n250\t    \"(?C\\\"text\\\")a\",\n251\t    \"(?C^text^)a\",\n252\t    \"(?C%text%)a\",\n253\t    \"(?C#text#)a\",\n254\t    \"(?C$text$)a\",\n255\t    // unicode properties\n256\t    r\"\\p{L}\",\n257\t    r\"\\P{L}\",\n258\t    r\"\\p{Lu}\",\n259\t    r\"\\p{Ll}\",\n260\t    r\"\\p{Nd}\",\n261\t    r\"\\p{Greek}\",\n262\t    r\"\\p{Latin}\",\n263\t    r\"\\p{Cyrillic}\",\n264\t    r\"\\p{Han}\",\n265\t    r\"\\p{Arabic}\",\n266\t    r\"\\p{Any}\",\n267\t    r\"\\p{Xan}\",\n268\t    r\"\\p{Xps}\",\n269\t    r\"\\p{Xsp}\",\n270\t    r\"\\p{Xuc}\",\n271\t    r\"\\p{Xwd}\",\n272\t    r\"\\p{Alphabetic}\",\n273\t    r\"\\p{White_Space}\",\n274\t    r\"\\p{Bidi_Control}\",\n275\t    r\"\\p{scx:Greek}\",\n276\t    r\"\\p{sc=Latin}\",\n277\t    r\"\\p{gc=Lu}\",\n278\t    r\"\\pL\",\n279\t    r\"\\PL\",\n280\t    r\"[\\p{L}\\p{N}]\",\n281\t    r\"[^\\p{L}]\",\n282\t    // combining\n283\t    \"a.*b\",\n284\t    \".*.*\",\n285\t    \"(a+)+b\",\n286\t    \"(a|aa)+b\",\n287\t    \"^(a+)*$\",\n288\t    r\"\\d+\\.\\d+\",\n289\t    r\"^[\\w.]+@[\\w.]+$\",\n290\t    r\"(?i)^(?:https?|ftp)://\\S+$\",\n291\t    r\"(\\w+)\\s+\\1\",\n292\t    \"[0-9]{3}-[0-9]{4}\",\n293\t    r\"(?<year>\\d{4})-(?<mon>\\d{2})-(?<day>\\d{2})\",\n294\t    \"a(?:b(?:c(?:d(?:e)?)?)?)?\",\n295\t    \"((((((((((a))))))))))\",\n296\t    \"(?:(?:(?:(?:(?:a)))))\",\n297\t    \"[a-c][d-f][g-i]\",\n298\t    \"x{0,10}y{0,10}z{0,10}\",\n299\t    // wide / multibyte literals\n300\t    \"é\",\n301\t    \"日本語\",\n302\t    \"😀\",\n303\t    \"[é-ü]\",\n304\t    \"[\\u{4e00}-\\u{9fff}]\",\n305\t    \"\\u{85}\",\n306\t    \"\\u{2028}\",\n307\t];\n308\t\n309\t/// Patterns valid only with `PCRE2_ALT_EXTENDED_CLASS`.\n310\tpub const ECLASS_PATTERNS: &[&str] = &[\n311\t    \"[[a][b]]\",\n312\t    \"[[a-z]&&[^aeiou]]\",\n313\t    \"[[a-z]--[aeiou]]\",\n314\t    \"[[a-m]||[n-z]]\",\n315\t    \"[[a-z]~~[aeiou]]\",\n316\t    \"[[[a-z]&&[b-y]]--[m]]\",\n317\t    \"[\\\\p{L}&&[a-z]]\",\n318\t    \"[[a] [b] [c]]\",\n319\t    \"[^[a]&&[b-z]]\",\n320\t];\n321\t\n322\t/// Patterns valid only with `PCRE2_ALLOW_EMPTY_CLASS`.\n323\tpub const EMPTY_CLASS_PATTERNS: &[&str] = &[\"[]\", \"[^]\", \"[]a\", \"a[]b\", \"[^]*\"];\n324\t\n325\t/// Subjects, chosen to hit boundary shapes and both ASCII and UTF-8.\n326\tpub const SUBJECTS: &[&str] = &[\n327\t    \"\",\n328\t    \"a\",\n329\t    \"b\",\n330\t    \"ab\",\n331\t    \"abc\",\n332\t    \"abcabc\",\n333\t    \"aaa\",\n334\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n335\t    \"A\",\n336\t    \"ABC\",\n337\t    \"0\",\n338\t    \"123\",\n339\t    \"a1b2c3\",\n340\t    \" \",\n341\t    \"\\t\",\n342\t    \"\\n\",\n343\t    \"\\r\",\n344\t    \"\\r\\n\",\n345\t    \"\\n\\r\",\n346\t    \"a\\nb\",\n347\t    \"a\\r\\nb\",\n348\t    \"a\\rb\",\n349\t    \"a\\u{85}b\",\n350\t    \"a\\u{2028}b\",\n351\t    \"a\\u{2029}b\",\n352\t    \"a\\u{b}b\",\n353\t    \"a\\u{c}b\",\n354\t    \"\\0\",\n355\t    \"a\\0b\",\n356\t    \"_\",\n357\t    \"a_b\",\n358\t    \"a-b\",\n359\t    \".\",\n360\t    \"a.b\",\n361\t    \"()\",\n362\t    \"(a)\",\n363\t    \"((a))\",\n364\t    \"a@b.com\",\n365\t    \"2024-01-31\",\n366\t    \"555-1234\",\n367\t    \"https://example.com/x\",\n368\t    \"hello world hello\",\n369\t    \"the the\",\n370\t    \"é\",\n371\t    \"éé\",\n372\t    \"日本語テキスト\",\n373\t    \"😀😀\",\n374\t    \"aéb\",\n375\t    \"\\u{10000}\",\n376\t    \"\\u{10FFFF}\",\n377\t    \"aeiou\",\n378\t    \"xyz\",\n379\t    \"abcdefghijklmnopqrstuvwxyz\",\n380\t    \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\",\n381\t    \"0123456789\",\n382\t    \"!@#$%^&*()\",\n383\t    \"  leading and trailing  \",\n384\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaab\",\n385\t    \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaac\",\n386\t];\n387\t\n388\t/// Byte-level subjects, including sequences that are not valid UTF-8.\n389\tpub fn byte_subjects() -> Vec<Vec<u8>> {\n390\t    let mut v: Vec<Vec<u8>> = SUBJECTS.iter().map(|s| s.as_bytes().to_vec()).collect();\n391\t    v.extend([\n392\t        vec![0x80],\n393\t        vec![0xFF],\n394\t        vec![0xC2],\n395\t        vec![0xC2, 0x41],\n396\t        vec![0xE0, 0xA0],\n397\t        vec![0xF0, 0x9F, 0x98],\n398\t        vec![0xED, 0xA0, 0x80],\n399\t        vec![0xF4, 0x90, 0x80, 0x80],\n400\t        vec![b'a', 0x80, b'b'],\n401\t        vec![b'a', 0xC2, b'b'],\n402\t        vec![0xFE, 0xFF],\n403\t    ]);\n404\t    v\n405\t}\n406\t\n407\t/// Randomized generator of syntactically valid patterns. Builds an expression\n408\t/// tree so that groups always balance, then renders it.\n409\tpub struct PatternGen {\n410\t    depth: u32,\n411\t    groups: u32,\n412\t    names: Vec<String>,\n413\t}\n414\t\n415\timpl PatternGen {\n416\t    pub fn new() -> PatternGen {\n417\t        PatternGen {\n418\t            depth: 0,\n419\t            groups: 0,\n420\t            names: Vec::new(),\n421\t        }\n422\t    }\n423\t\n424\t    pub fn gen(rng: &mut Rng) -> String {\n425\t        let mut g = PatternGen::new();\n426\t        let mut s = String::new();\n427\t        g.alt(rng, &mut s);\n428\t        s\n429\t    }\n430\t\n431\t    fn alt(&mut self, rng: &mut Rng, out: &mut String) {\n432\t        let n = 1 + rng.below(3);\n433\t        for i in 0..n {\n434\t            if i > 0 {\n435\t                out.push('|');\n436\t            }\n437\t            self.seq(rng, out);\n438\t        }\n439\t    }\n440\t\n441\t    fn seq(&mut self, rng: &mut Rng, out: &mut String) {\n442\t        let n = 1 + rng.below(4);\n443\t        for _ in 0..n {\n444\t            self.term(rng, out);\n445\t        }\n446\t    }\n447\t\n448\t    fn term(&mut self, rng: &mut Rng, out: &mut String) {\n449\t        self.atom(rng, out);\n450\t        // maybe quantify\n451\t        if rng.below(3) == 0 {\n452\t            let q = *rng.pick(&[\"*\", \"+\", \"?\", \"{0,2}\", \"{1,3}\", \"{2}\", \"{1,}\"]);\n453\t            out.push_str(q);\n454\t            match rng.below(4) {\n455\t                0 => out.push('?'),\n456\t                1 => out.push('+'),\n457\t                _ => {}\n458\t            }\n459\t        }\n460\t    }\n461\t\n462\t    fn atom(&mut self, rng: &mut Rng, out: &mut String) {\n463\t        let deep = self.depth >= 4;\n464\t        let choice = if deep { rng.below(4) } else { rng.below(14) };\n465\t        match choice {\n466\t            0 => out.push(*rng.pick(&['a', 'b', 'c', 'x', 'y', 'z', '0', '1', '_', ' '])),\n467\t            1 => out.push_str(*rng.pick(&[\n468\t                r\"\\d\", r\"\\D\", r\"\\w\", r\"\\W\", r\"\\s\", r\"\\S\", r\"\\h\", r\"\\v\", r\"\\R\", r\"\\X\", r\"\\N\",\n469\t            ])),\n470\t            2 => out.push('.'),\n471\t            3 => {\n472\t                let cls = *rng.pick(&[\n473\t                    \"[abc]\",\n474\t                    \"[^abc]\",\n475\t                    \"[a-z]\",\n476\t                    \"[0-9a-fA-F]\",\n477\t                    r\"[\\d\\s]\",\n478\t                    \"[[:alpha:]]\",\n479\t                    \"[[:^digit:]]\",\n480\t                    r\"[\\p{L}]\",\n481\t                    r\"[^\\p{Nd}]\",\n482\t                    \"[-a-z]\",\n483\t                    r\"[\\x41-\\x5A]\",\n484\t                ]);\n485\t                out.push_str(cls);\n486\t            }\n487\t            4 => {\n488\t                out.push_str(*rng.pick(&[r\"\\b\", r\"\\B\", r\"\\A\", r\"\\Z\", r\"\\z\", \"^\", \"$\"]));\n489\t            }\n490\t            5 => {\n491\t                out.push_str(*rng.pick(&[r\"\\p{L}\", r\"\\P{L}\", r\"\\p{Nd}\", r\"\\p{Greek}\", r\"\\pL\"]));\n492\t            }\n493\t            6 => {\n494\t                // capturing group\n495\t                self.depth += 1;\n496\t                self.groups += 1;\n497\t                out.push('(');\n498\t                self.alt(rng, out);\n499\t                out.push(')');\n500\t                self.depth -= 1;\n501\t            }\n502\t            7 => {\n503\t                // non-capturing / atomic / option group\n504\t                self.depth += 1;\n505\t                let open = *rng.pick(&[\"(?:\", \"(?>\", \"(?i:\", \"(?-i:\", \"(?s:\", \"(?m:\", \"(?x:\"]);\n506\t                out.push_str(open);\n507\t                self.alt(rng, out);\n508\t                out.push(')');\n509\t                self.depth -= 1;\n510\t            }\n511\t            8 => {\n512\t                // named group\n513\t                self.depth += 1;\n514\t                self.groups += 1;\n515\t                let name = format!(\"g{}\", self.names.len());\n516\t                self.names.push(name.clone());\n517\t                out.push_str(\"(?<\");\n518\t                out.push_str(&name);\n519\t                out.push('>');\n520\t                self.alt(rng, out);\n521\t                out.push(')');\n522\t                self.depth -= 1;\n523\t            }\n524\t            9 => {\n525\t                // lookaround (fixed-length body for lookbehind)\n526\t                self.depth += 1;\n527\t                match rng.below(4) {\n528\t                    0 => {\n529\t                        out.push_str(\"(?=\");\n530\t                        self.alt(rng, out);\n531\t                        out.push(')');\n532\t                    }\n533\t                    1 => {\n534\t                        out.push_str(\"(?!\");\n535\t                        self.alt(rng, out);\n536\t                        out.push(')');\n537\t                    }\n538\t                    2 => {\n539\t                        out.push_str(\"(?<=\");\n540\t                        out.push_str(*rng.pick(&[\"a\", \"ab\", \"abc\", \"[a-z]\", r\"\\d\\d\"]));\n541\t                        out.push(')');\n542\t                    }\n543\t                    _ => {\n544\t                        out.push_str(\"(?<!\");\n545\t                        out.push_str(*rng.pick(&[\"a\", \"ab\", \"abc\", \"[a-z]\", r\"\\d\\d\"]));\n546\t                        out.push(')');\n547\t                    }\n548\t                }\n549\t                self.depth -= 1;\n550\t            }\n551\t            10 => {\n552\t                // back reference to an existing group, if any\n553\t                if self.groups > 0 {\n554\t                    let g = 1 + rng.below(self.groups as usize);\n555\t                    out.push_str(&format!(r\"\\{}\", g));\n556\t                } else {\n557\t                    out.push('a');\n558\t                }\n559\t            }\n560\t            11 => {\n561\t                // reference to an existing name, if any\n562\t                if !self.names.is_empty() {\n563\t                    let n = rng.below(self.names.len());\n564\t                    out.push_str(&format!(r\"\\k<{}>\", self.names[n]));\n565\t                } else {\n566\t                    out.push('b');\n567\t                }\n568\t            }\n569\t            12 => {\n570\t                // verbs and marks\n571\t                out.push_str(*rng.pick(&[\n572\t                    \"(*FAIL)\",\n573\t                    \"(*ACCEPT)\",\n574\t                    \"(*COMMIT)\",\n575\t                    \"(*PRUNE)\",\n576\t                    \"(*SKIP)\",\n577\t                    \"(*THEN)\",\n578\t                    \"(*MARK:m)\",\n579\t                ]));\n580\t            }\n581\t            _ => {\n582\t                // literal escape / hex / octal\n583\t                out.push_str(*rng.pick(&[\n584\t                    r\"\\x41\", r\"\\x{42}\", r\"\\101\", r\"\\o{103}\", r\"\\cA\", r\"\\t\", r\"\\n\", r\"\\Qa+b\\E\",\n585\t                    r\"\\-\", r\"\\.\", r\"\\*\",\n586\t                ]));\n587\t            }\n588\t        }\n589\t    }\n590\t}\n591\t\n592\t/// Random byte subject with a configurable shape.\n593\tpub fn gen_subject(rng: &mut Rng, utf: bool) -> Vec<u8> {\n594\t    let n = rng.below(24);\n595\t    if utf {\n596\t        let chars = [\n597\t            'a', 'b', 'c', 'x', 'y', 'z', '0', '1', ' ', '_', '\\n', '\\r', '\\t', 'é', 'ü', '日',\n598\t            '本', '😀', '\\u{85}', '\\u{2028}', '\\u{2029}', 'A', 'B', 'Z', '-', '.', '@',\n599\t        ];\n600\t        let s: String = (0..n).map(|_| *rng.pick(&chars)).collect();\n601\t        s.into_bytes()\n602\t    } else {\n603\t        (0..n)\n604\t            .map(|_| *rng.pick(&[b'a', b'b', b'c', b'x', b'0', b'1', b' ', b'\\n', b'\\r', b'\\t', 0u8, 0x80, 0xFF, b'A', b'-', b'.']))\n605\t            .collect()\n606\t    }\n607\t}\n608\t"}]},"parent_tool_use_id":"toolu_bdrk_01ByS28QCmYZoQhAvy9JHMa1","session_id":"afdd377b-a8e3-4242-b7f7-f8439c40180f","uuid":"8cd83fb6-d2d0-4b15-8b0c-498ab98757d2","timestamp":"2026-08-31T07:13:42.818Z","subagent_type":"general-purpose","task_description":"Substring + serialize + jit tests"}
