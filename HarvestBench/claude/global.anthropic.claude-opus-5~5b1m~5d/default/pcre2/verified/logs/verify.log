44\t\n45\t    let memctl: *const pcre2_memctl = if !gcontext.is_null() {\n46\t        core::ptr::addr_of!((*gcontext).memctl)\n47\t    } else {\n48\t        core::ptr::addr_of!(_pcre2_default_compile_context_8.memctl)\n49\t    };\n50\t\n51\t    if codes.is_null() || serialized_bytes.is_null() || serialized_size.is_null() {\n52\t        return PCRE2_ERROR_NULL;\n53\t    }\n54\t\n55\t    if number_of_codes <= 0 {\n56\t        return PCRE2_ERROR_BADDATA;\n57\t    }\n58\t\n59\t    /* Compute total size. */\n60\t    total_size = core::mem::size_of::<pcre2_serialized_data>() + TABLES_LENGTH;\n61\t    tables = core::ptr::null();\n62\t\n63\t    i = 0;\n64\t    while i < number_of_codes {\n65\t        if (*codes.add(i as usize)).is_null() {\n66\t            return PCRE2_ERROR_NULL;\n67\t        }\n68\t        re = *codes.add(i as usize);\n69\t        if (*re).magic_number != MAGIC_NUMBER {\n70\t            return PCRE2_ERROR_BADMAGIC;\n71\t        }\n72\t        if tables.is_null() {\n73\t            tables = (*re).tables;\n74\t        } else if tables != (*re).tables {\n75\t            return PCRE2_ERROR_MIXEDTABLES;\n76\t        }\n77\t        total_size += (*re).blocksize;\n78\t        i += 1;\n79\t    }\n80\t\n81\t    /* Initialize the byte stream. */\n82\t    bytes = ((*memctl).malloc.unwrap())(\n83\t        total_size + core::mem::size_of::<pcre2_memctl>(),\n84\t        (*memctl).memory_data,\n85\t    ) as *mut u8;\n86\t    if bytes.is_null() {\n87\t        return PCRE2_ERROR_NOMEMORY;\n88\t    }\n89\t\n90\t    /* The controller is stored as a hidden parameter. */\n91\t    core::ptr::copy_nonoverlapping(\n92\t        memctl as *const u8,\n93\t        bytes,\n94\t        core::mem::size_of::<pcre2_memctl>(),\n95\t    );\n96\t    bytes = bytes.add(core::mem::size_of::<pcre2_memctl>());\n97\t\n98\t    data = bytes as *mut pcre2_serialized_data;\n99\t    (*data).magic = SERIALIZED_DATA_MAGIC;\n100\t    (*data).version = SERIALIZED_DATA_VERSION;\n101\t    (*data).config = S