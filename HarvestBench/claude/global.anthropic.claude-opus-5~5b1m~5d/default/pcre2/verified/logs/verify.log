es[0]!=res[1] { mism+=1; if mism<5 { eprintln!(\"MISMATCH pat={:?} opts={opts:#x} extra={extra:#x} C={} R={}\", String::from_utf8_lossy(&pat), res[0], res[1]); } }\n        seen.insert(res[0]);\n    }\n    let v: Vec<i32> = seen.iter().copied().filter(|&x| x!=100).collect();\n    eprintln!(\"RANDOM CORPUS codes ({}): {:?}\", v.len(), v);\n    eprintln!(\"mismatches: {mism}\");\n    assert_eq!(mism, 0);\n}\nEOF\ncd $W/translation && timeout 600 cargo test --offline -q --test tzz_cov -- --nocapture 2>&1 | grep -E \"RANDOM|mismatch|MISMATCH|test result\" | head","description":"Measure error-code coverage from random corpus","timeout":900000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":579,"cache_read_input_tokens":299760,"cache_creation":{"ephemeral_5m_input_tokens":579,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"afdd377b-a8e3-4242-b7f7-f8439c40180f","uuid":"c36c7af9-f972-4680-9ae7-2d6989762357","timestamp":"2026-08-31T07:29:06.048Z"}
