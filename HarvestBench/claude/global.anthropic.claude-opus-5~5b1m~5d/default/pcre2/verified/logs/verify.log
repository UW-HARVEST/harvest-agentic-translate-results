le)]\n150\tpub unsafe extern \"C\" fn pcre2_serialize_decode_8(codes: *mut *mut pcre2_real_code, mut number_of_codes: i32, bytes: *const u8, gcontext: *mut pcre2_real_general_context) -> i32 {\n151\t    let data: *const pcre2_serialized_data = bytes as *const pcre2_serialized_data;\n152\t    let memctl: *const pcre2_memctl = if !gcontext.is_null() {\n153\t        core::ptr::addr_of!((*gcontext).memctl)\n154\t    } else {\n155\t        core::ptr::addr_of!(_pcre2_default_compile_context_8.memctl)\n156\t    };\n157\t\n158\t    let mut src_bytes: *const u8;\n159\t    let mut dst_re: *mut pcre2_real_code = core::ptr::null_mut();\n160\t    let tables: *mut u8;\n161\t    let mut i: i32;\n162\t    let mut j: i32;\n163\t    let mut error: i32 = 0;\n164\t\n165\t    /* Sanity checks. */\n166\t\n167\t    if data.is_null() || codes.is_null() {\n168\t        return PCRE2_ERROR_NULL;\n169\t    }\n170\t    if number_of_codes <= 0 {\n171\t        return PCRE2_ERROR_BADDATA;\n172\t    }\n173\t    if core::ptr::read_unaligned(core::ptr::addr_of!((*data).number_of_codes)) <= 0 {\n174\t        return PCRE2_ERROR_BADSERIALIZEDDATA;\n175\t    }\n176\t    if core::ptr::read_unaligned(core::ptr::addr_of!((*data).magic)) != SERIALIZED_DATA_MAGIC {\n177\t        return PCRE2_ERROR_BADMAGIC;\n178\t    }\n179\t    if core::ptr::read_unaligned(core::ptr::addr_of!((*data).version)) != SERIALIZED_DATA_VERSION {\n180\t        return PCRE2_ERROR_BADMODE;\n181\t    }\n182\t    if core::ptr::read_unaligned(core::ptr::addr_of!((*data).config)) != SERIALIZED_DATA_CONFIG {\n183\t        return PCRE2_ERROR_BADMODE;\n184\t    }\n185\t\n186\t    if number_of_codes > core::ptr::read_unaligned(core::ptr::addr_of!((*data).number_of_codes)) {\n187\t        number_of_codes = core::ptr::read_unaligned(core::ptr::addr_of!((*data).number_of_codes));\n188\t    }\n189\t\n190\t    src_bytes = bytes.add(core::mem::size_of::<pcre2_serialized_data>());\n191\t\n192\t    /* Decode tables. The reference count for the tables