" fn(Code, u32) -> c_int;\n393\ttype FnJitMatch =\n394\t    unsafe extern \"C\" fn(Code, *const u8, Sz, Sz, u32, MatchData, MContext) -> c_int;\n395\ttype FnJitFreeUnused = unsafe extern \"C\" fn(GContext);\n396\ttype FnJitStackCreate = unsafe extern \"C\" fn(usize, usize, GContext) -> JitStack;\n397\ttype FnJitStackAssign = unsafe extern \"C\" fn(\n398\t    MContext,\n399\t    Option<unsafe extern \"C\" fn(*mut c_void) -> JitStack>,\n400\t    *mut c_void,\n401\t);\n402\ttype FnJitStackFree = unsafe extern \"C\" fn(JitStack);\n403\t\n404\t// internal helpers\n405\ttype FnStrlen = unsafe extern \"C\" fn(*const u8) -> Sz;\n406\ttype FnStrcmp = unsafe extern \"C\" fn(*const u8, *const u8) -> c_int;\n407\ttype FnStrcmpC8 = unsafe extern \"C\" fn(*const u8, *const c_char) -> c_int;\n408\ttype FnStrncmp = unsafe extern \"C\" fn(*const u8, *const u8, usize) -> c_int;\n409\ttype FnStrncmpC8 = unsafe extern \"C\" fn(*const u8, *const c_char, usize) -> c_int;\n410\ttype FnStrcpyC8 = unsafe extern \"C\" fn(*mut u8, *const c_char) -> Sz;\n411\ttype FnOrd2utf = unsafe extern \"C\" fn(u32, *mut u8) -> c_uint;\n412\ttype FnValidUtf = unsafe extern \"C\" fn(*const u8, Sz, *mut Sz) -> c_int;\n413\ttype FnCkdSmul = unsafe extern \"C\" fn(*mut Sz, c_int, c_int) -> c_int;\n414\ttype FnIsNewline = unsafe extern \"C\" fn(*const u8, u32, *const u8, *mut u32, c_int) -> c_int;\n415\ttype FnWasNewline = unsafe extern \"C\" fn(*const u8, u32, *const u8, *mut u32, c_int) -> c_int;\n416\ttype FnScriptRun = unsafe extern \"C\" fn(*const u8, *const u8, c_int) -> c_int;\n417\ttype FnExtuni = unsafe extern \"C\" fn(u32, *const u8, *const u8, *const u8, c_int, *mut c_int) -> *const u8;\n418\ttype FnFindBracket = unsafe extern \"C\" fn(*const u8, c_int, c_int) -> *const u8;\n419\ttype FnXclass = unsafe extern \"C\" fn(u32, *const u8, *const u8, c_int) -> c_int;\n420\ttype FnEclass = unsafe extern \"C\" fn(u32, *const u8, *const u8, *const u8, c_int) -> c_int;\n421\ttype FnJitGetSize = unsafe extern \"C\" fn(*mut c_void) -> usize;\n422\ttype FnJitGetTarget = unsafe extern \"C\" fn() -> *const c_char;\n423\ttype FnStudy = unsafe extern \"C\" fn(Code) -> c_int;\n424\t\n425\t// ---------------------------------------------------------------- Api\n426\t\n427\tpub struct Api {\n428\t    pub name: &'static str,\n429\t    _lib: &'static libloading::Library,\n430\t\n431\t    pub config: FnConfig,\n432\t    pub compile: FnCompile,\n433\t    pub code_free: FnCodeFree,\n434\t    pub code_copy: FnCodeCopy,\n435\t    pub code_copy_with_tables: FnCodeCopy,\n436\t    pub pattern_info: FnPatternInfo,\n437\t    pub callout_enumerate: FnCalloutEnumerate,\n438\t    pub match_data_create: FnMatchDataCreate,\n439\t    pub match_data_create_from_pattern: FnMatchDataCreateFromPattern,\n440\t    pub match_data_free: FnMatchDataFree,\n441\t    pub do_match: FnMatch,\n442\t    pub dfa_match: FnDfaMatch,\n443\t    pub get_mark: FnGetMark,\n444\t    pub get_match_data_size: FnGetSz,\n445\t    pub get_match_data_heapframes_size: FnGetSz,\n446\t    pub get_ovector_count: FnGetU32,\n447\t    pub get_ovector_pointer: FnGetOvecPtr,\n448\t    pub get_startchar: FnGetSz,\n449\t    pub next_match: FnNextMatch,\n450\t    pub substitute: FnSubstitute,\n451\t    pub substring_copy_byname: FnSubstringCopyByname,\n452\t    pub substring_copy_bynumber: FnSubstringCopyBynumber,\n453\t    pub substring_free: FnSubstringFree,\n454\t    pub substring_get_byname: FnSubstringGetByname,\n455\t    pub substring_get_bynumber: FnSubstringGetBynumber,\n456\t    pub substring_length_byname: FnSubstringLengthByname,\n457\t    pub substring_length_bynumber: FnSubstringLengthBynumber,\n458\t    pub substring_nametable_scan: FnSubstringNametableScan,\n459\t    pub substring_number_from_name: FnSubstringNumberFromName,\n460\t    pub substring_list_free: FnSubstringListFree,\n461\t    pub substring_list_get: FnSubstringListGet,\n462\t    pub serialize_encode: FnSerializeEncode,\n463\t    pub serialize_decode: FnSerialize