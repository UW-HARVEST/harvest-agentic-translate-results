{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NFmVisverpdxzkZe8w724k","type":"tool_result","content":"1\t//! Translated from pcre2_jit_compile.c (no JIT support).\n2\t//!\n3\t//! `SUPPORT_JIT` is not defined, so essentially the whole of pcre2_jit_compile.c is\n4\t//! compiled out. What remains is `pcre2_jit_compile()` (with its JIT-only blocks\n5\t//! removed) plus the non-JIT stubs from `pcre2_jit_match_inc.h` and\n6\t//! `pcre2_jit_misc_inc.h`, both of which are `#include`d unconditionally at the end\n7\t//! of pcre2_jit_compile.c.\n8\t#![allow(unused_imports, unused_variables, unused_mut, unused_parens, dead_code)]\n9\t#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals)]\n10\t\n11\tuse crate::consts::*;\n12\tuse crate::types::*;\n13\tuse crate::macros::*;\n14\tuse core::ffi::{c_char, c_void};\n15\t\n16\t/*************************************************\n17\t*        JIT compile a Regular Expression        *\n18\t*************************************************/\n19\t\n20\t/* This function used JIT to convert a previously-compiled pattern into machine\n21\tcode.\n22\t\n23\tArguments:\n24\t  code          a compiled pattern\n25\t  options       JIT option bits\n26\t\n27\tReturns:        0: success or (*NOJIT) was used\n28\t               <0: an error code\n29\t*/\n30\t\n31\tconst PUBLIC_JIT_COMPILE_OPTIONS: u32 =\n32\t    PCRE2_JIT_COMPLETE | PCRE2_JIT_PARTIAL_SOFT | PCRE2_JIT_PARTIAL_HARD | PCRE2_JIT_INVALID_UTF;\n33\t\n34\t#[unsafe(no_mangle)]\n35\tpub unsafe extern \"C\" fn pcre2_jit_compile_8(code: *mut pcre2_real_code, options: u32) -> i32 {\n36\tlet re: *mut pcre2_real_code = code;\n37\t\n38\tif options & PCRE2_JIT_TEST_ALLOC != 0\n39\t  {\n40\t  if options != PCRE2_JIT_TEST_ALLOC\n41\t    { return PCRE2_ERROR_JIT_BADOPTION; }\n42\t\n43\t  /* !SUPPORT_JIT */\n44\t  return PCRE2_ERROR_JIT_UNSUPPORTED;\n45\t  }\n46\t\n47\tif code.is_null()\n48\t  { return PCRE2_ERROR_NULL; }\n49\t\n50\tif (options & !PUBLIC_JIT_COMPILE_OPTIONS) != 0\n51\t  { return PCRE2_ERROR_JIT_BADOPTION; }\n52\t\n53\t/* Support for invalid UTF was first introduced in JIT, with the option\n54\tPCRE2_JIT_INVALID_UTF. Later, support was added to the interpreter, and the\n55\tcompile-time option PCRE2_MATCH_INVALID_UTF was created. This is now the\n56\tpreferred feature, with the earlier option deprecated. However, for backward\n57\tcompatibility, if the earlier option is set, it forces the new option so that\n58\tif JIT matching falls back to the interpreter, there is still support for\n59\tinvalid UTF. */\n60\t\n61\tif (options & PCRE2_JIT_INVALID_UTF) != 0\n62\t  {\n63\t  if ((*re).overall_options & PCRE2_MATCH_INVALID_UTF) == 0\n64\t    {\n65\t    (*re).overall_options |= PCRE2_MATCH_INVALID_UTF;\n66\t    }\n67\t  }\n68\t\n69\t/* The above tests are run with and without JIT support. This means that\n70\tPCRE2_JIT_INVALID_UTF propagates back into the regex options (ensuring\n71\tinterpreter support) even in the absence of JIT. But now, if there is no JIT\n72\tsupport, give an error return. */\n73\t\n74\treturn PCRE2_ERROR_JIT_BADOPTION;\n75\t}\n76\t\n77\t\n78\t/*************************************************\n79\t*              Do a JIT pattern match            *\n80\t*************************************************/\n81\t\n82\t/* From pcre2_jit_match_inc.h, !SUPPORT_JIT branch. */\n83\t\n84\t#[unsafe(no_mangle)]\n85\tpub unsafe extern \"C\" fn pcre2_jit_match_8(code: *const pcre2_real_code, subject: PCRE2_SPTR, length: PCRE2_SIZE, start_offset: PCRE2_SIZE, options: u32, match_data: *mut pcre2_real_match_data, mcontext: *mut pcre2_real_match_context) -> i32 {\n86\t(*match_data).rc = PCRE2_ERROR_JIT_BADOPTION;\n87\treturn (*match_data).rc;\n88\t}\n89\t\n90\t\n91\t/*************************************************\n92\t*            Free unused JIT memory              *\n93\t*************************************************/\n94\t\n95\t/* From pcre2_jit_misc_inc.h, !SUPPORT_JIT branch: does nothing. */\n96\t\n97\t#[unsafe(no_mangle)]\n98\tpub unsafe extern \"C\" fn pcre2_jit_free_unused_memory_8(gcontext: *mut pcre2_real_general_context) {\n99\t/* (void)gcontext; */\n100\t}\n101\t\n102\t\n103\t/*************************************************\n104\t*            Allocate a JIT stack                *\n105\t*************************************************/\n106\t\n107\t/* From pcre2_jit_misc_inc.h, !SUPPORT_JIT branch: always returns NULL. */\n108\t\n109\t#[unsafe(no_mangle)]\n110\tpub unsafe extern \"C\" fn pcre2_jit_stack_create_8(startsize: usize, maxsize: usize, gcontext: *mut pcre2_real_general_context) -> *mut pcre2_real_jit_stack {\n111\treturn core::ptr::null_mut();\n112\t}\n113\t\n114\t\n115\t/*************************************************\n116\t*         Assign a JIT stack to a pattern        *\n117\t*************************************************/\n118\t\n119\t/* From pcre2_jit_misc_inc.h, !SUPPORT_JIT branch: does nothing. */\n120\t\n121\t#[unsafe(no_mangle)]\n122\tpub unsafe extern \"C\" fn pcre2_jit_stack_assign_8(mcontext: *mut pcre2_real_match_context, callback: JitCallbackFn, callback_data: *mut c_void) {\n123\t/* (void)mcontext; (void)callback; (void)callback_data; */\n124\t}\n125\t\n126\t\n127\t/*************************************************\n128\t*               Free a JIT stack                 *\n129\t*************************************************/\n130\t\n131\t/* From pcre2_jit_misc_inc.h, !SUPPORT_JIT branch: does nothing. */\n132\t\n133\t#[unsafe(no_mangle)]\n134\tpub unsafe extern \"C\" fn pcre2_jit_stack_free_8(jit_stack: *mut pcre2_real_jit_stack) {\n135\t/* (void)jit_stack; */\n136\t}\n137\t\n138\t\n139\t/*************************************************\n140\t*           Free JIT compiled code               *\n141\t*************************************************/\n142\t\n143\t/* PRIV(jit_free) - from pcre2_jit_misc_inc.h, !SUPPORT_JIT branch: does nothing. */\n144\t\n145\t#[unsafe(no_mangle)]\n146\tpub unsafe extern \"C\" fn _pcre2_jit_free_8(executable_jit: *mut c_void, memctl: *mut pcre2_memctl) {\n147\t/* (void)executable_jit; (void)memctl; */\n148\t}\n149\t\n150\t\n151\t/*************************************************\n152\t*           Free JIT read-only data              *\n153\t*************************************************/\n154\t\n155\t/* PRIV(jit_free_rodata) - from pcre2_jit_misc_inc.h, !SUPPORT_JIT branch: does\n156\tnothing. (The second parameter is the allocator data.) */\n157\t\n158\t#[unsafe(no_mangle)]\n159\tpub unsafe extern \"C\" fn _pcre2_jit_free_rodata_8(current: *mut c_void, next: *mut c_void) {\n160\t/* (void)current; (void)allocator_data; */\n161\t}\n162\t\n163\t\n164\t/*************************************************\n165\t*              Get size of JIT code              *\n166\t*************************************************/\n167\t\n168\t/* PRIV(jit_get_size) - from pcre2_jit_misc_inc.h, !SUPPORT_JIT branch. */\n169\t\n170\t#[unsafe(no_mangle)]\n171\tpub unsafe extern \"C\" fn _pcre2_jit_get_size_8(executable_jit: *mut c_void) -> usize {\n172\t/* (void)executable_jit; */\n173\treturn 0;\n174\t}\n175\t\n176\t\n177\t/*************************************************\n178\t*               Get target CPU type              *\n179\t*************************************************/\n180\t\n181\t/* PRIV(jit_get_target) - from pcre2_jit_misc_inc.h, !SUPPORT_JIT branch. */\n182\t\n183\t#[unsafe(no_mangle)]\n184\tpub unsafe extern \"C\" fn _pcre2_jit_get_target_8() -> *const c_char {\n185\treturn b\"JIT is not supported\\0\".as_ptr() as *const c_char;\n186\t}\n187\t\n188\t/* End of pcre2_jit_compile.c */\n189\t"}]},"parent_tool_use_id":"toolu_bdrk_01ByS28QCmYZoQhAvy9JHMa1","session_id":"afdd377b-a8e3-4242-b7f7-f8439c40180f","uuid":"c376ec76-838c-4f5b-a382-10bd474bdb99","timestamp":"2026-08-31T07:14:22.841Z","subagent_type":"general-purpose","task_description":"Substring + serialize + jit tests"}
