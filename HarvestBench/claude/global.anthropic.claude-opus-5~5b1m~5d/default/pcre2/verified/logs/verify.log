ta, *mut Sz, *mut u32) -> c_int;\n315\ttype FnSubstitute = unsafe extern \"C\" fn(\n316\t    Code,\n317\t    *const u8,\n318\t    Sz,\n319\t    Sz,\n320\t    u32,\n321\t    MatchData,\n322\t    MContext,\n323\t    *const u8,\n324\t    Sz,\n325\t    *mut u8,\n326\t    *mut Sz,\n327\t) -> c_int;\n328\ttype FnSubstringCopyByname =\n329\t    unsafe extern \"C\" fn(MatchData, *const u8, *mut u8, *mut Sz) -> c_int;\n330\ttype FnSubstringCopyBynumber = unsafe extern \"C\" fn(MatchData, u32, *mut u8, *mut Sz) -> c_int;\n331\ttype FnSubstringFree = unsafe extern \"C\" fn(*mut u8);\n332\ttype FnSubstringGetByname =\n333\t    unsafe extern \"C\" fn(MatchData, *const u8, *mut *mut u8, *mut Sz) -> c_int;\n334\ttype FnSubstringGetBynumber =\n335\t    unsafe extern \"C\" fn(MatchData, u32, *mut *mut u8, *mut Sz) -> c_int;\n336\ttype FnSubstringLengthByname = unsafe extern \"C\" fn(MatchData, *const u8, *mut Sz) -> c_int;\n337\ttype FnSubstringLengthBynumber = unsafe extern \"C\" fn(MatchData, u32, *mut Sz) -> c_int;\n338\ttype FnSubstringNametableScan =\n339\t    unsafe extern \"C\" fn(Code, *const u8, *mut *const u8, *mut *const u8) -> c_int;\n340\ttype FnSubstringNumberFromName = unsafe extern \"C\" fn(Code, *const u8) -> c_int;\n341\ttype FnSubstringListFree = unsafe extern \"C\" fn(*mut *mut u8);\n342\ttype FnSubstringListGet =\n343\t    unsafe extern \"C\" fn(MatchData, *mut *mut *mut u8, *mut *mut Sz) -> c_int;\n344\ttype FnSerializeEncode =\n345\t    unsafe extern \"C\" fn(*const Code, i32, *mut *mut u8, *mut Sz, GContext) -> i32;\n346\ttype FnSerializeDecode = unsafe extern \"C\" fn(*mut Code, i32, *const u8, GContext) -> i32;\n347\ttype FnSerializeGetNumber = unsafe extern \"C\" fn(*const u8) -> i32;\n348\ttype FnSerializeFree = unsafe extern \"C\" fn(*mut u8);\n349\ttype FnPatternConvert =\n350\t    unsafe extern \"C\" fn(*const u8, Sz, u32, *mut *mut u8, *mut Sz, CvContext) -> c_int;\n351\ttype FnConvertedPatternFree = unsafe extern \"C\" fn(*mut u8);\n352\ttype FnGetErrorMessage = unsafe extern \"C\" fn(c_int, *mut u8, Sz) -> c_int;\n353\ttype FnMaketables = unsafe extern \"C\" fn(GContext) -> *const u8;\n354\ttype FnMaketablesFree = unsafe extern \"C\" fn(GContext, *const u8);\n355\ttype FnGCtxCreate = unsafe extern \"C\" fn(\n356\t    Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>,\n357\t    Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>,\n358\t    *mut c_void,\n359\t) -> GContext;\n360\ttype FnCtxCreate = unsafe extern \"C\" fn(GContext) -> *mut c_void;\n361\ttype FnCtxCopy = unsafe extern \"C\" fn(*mut c_void) -> *mut c_void;\n362\ttype FnCtxFree = unsafe extern \"C\" fn(*mut c_void);\n363\ttype FnSetU32 = unsafe extern \"C\" fn(*mut c_void, u32) -> c_int;\n364\ttype FnSetSz = unsafe extern \"C\" fn(*mut c_void, Sz) -> c_int;\n365\ttype FnSetTables = unsafe extern \"C\" fn(CContext, *const u8) -> c_int;\n366\ttype FnSetCallout = unsafe extern \"C\" fn(\n367\t    MContext,\n368\t    Option<unsafe extern \"C\" fn(*mut CalloutBlock, *mut c_void) -> c_int>,\n369\t    *mut c_void,\n370\t) -> c_int;\n371\ttype FnSetSubstCallout = unsafe extern \"C\" fn(\n372\t    MContext,\n373\t    Option<unsafe extern \"C\" fn(*mut SubstituteCalloutBlock, *mut c_void) -> c_int>,\n374\t    *mut c_void,\n375\t) -> c_int;\n376\ttype FnSetSubstCaseCallout = unsafe extern \"C\" fn(\n377\t    MContext,\n378\t    Option<unsafe extern \"C\" fn(*const u8, Sz, *mut u8, Sz, c_int, *mut c_void) -> Sz>,\n379\t    *mut c_void,\n380\t) -> c_int;\n381\ttype FnSetRecursionGuard = unsafe extern \"C\" fn(\n382\t    CContext,\n383\t    Option<unsafe extern \"C\" fn(u32, *mut c_void) -> c_int>,\n384\t    *mut c_void,\n385\t) -> c_int;\n386\ttype FnSetRecursionMemMgmt = unsafe extern \"C\" fn(\n387\t    MContext,\n388\t    Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>,\n389\t    Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>,\n390\t    *mut c_void,\n391\t) -> c_int;\n392\ttype FnJitCompile = unsafe extern \"C\" fn(Code, u32) -> c_int;\n393\ttype FnJitMatch =\n394\t    unsafe extern \"C\" fn(Code, *const u8, Sz, Sz, u32, MatchData, MContext) -> c_int;\n395\ttype FnJitFreeUnused = unsafe extern \"C\" fn(GContext);\n396\ttype FnJitStackCreate = unsafe extern \"C\" fn(usize, usize, GContext) -> JitStack;\n397\ttype FnJitStackAssign = unsafe extern \"C\" fn(\n398\t    MContext,\n399\t    Option<unsafe extern \"C\" fn(*mut c_void) -> JitStack>,\n400\t    *mut c_void,\n401\t);\n402\ttype FnJitStackFree = unsafe extern \"C\" fn(JitStack);\n403\t\n404\t// internal helpers\n405\ttype FnStrlen = unsafe extern \"C\" fn(*const u8) -> Sz;\n406\ttype FnStrcmp = unsafe extern \"C\" fn(*const u8, *const u8) -> c_int;\n407\ttype FnStrcmpC8 = unsafe extern \"C\" fn(*const u8, *const c_char) -> c_int;\n408\ttype FnStrncmp = unsafe extern \"C\" fn(*const u8, *const u8, usize) -> c_int;\n409\ttype FnStrncmpC8 = unsafe extern \"C\" fn(*const u8, *const c_char, usize) -> c_int;\n410\ttype FnStrcpyC8 = unsafe extern \"C\" fn(*mut u8, *const c_char) -> Sz;\n411\ttype FnOrd2utf = unsafe extern \"C\" fn(u32, *mut u8) -> c_uint;\n412\ttype FnValidUtf = unsafe extern \"C\" fn(*const u8, Sz, *mut Sz) -> c_int;\n413\ttype FnCkdSmul = unsafe extern \"C\" fn(*mut Sz, c_int, c_int) -> c_int;\n414\ttype FnIsNewline = unsafe extern \"C\" fn(*const u8, u32, *const u8, *mut u32, c_int) -> c_int;\n415\ttype FnWasNewline = unsafe extern \"C\" fn(*const u8, u32, *const u8, *mut u32, c_int) -> c_int;\n416\ttype FnScriptRun = unsafe extern \"C\" fn(*const u8, *const u8, c_int) -> c_int;\n417\ttype FnExtuni = unsafe extern \"C\" fn(u32, *const u8, *const u8, *const u8, c_int, *mut c_int) -> *const u8;\n418\ttype FnFindBracket = unsafe extern \"C\" fn(*const u8, c_int, c_int) -> *const u8;\n419\ttype FnXclass = unsafe extern \"C\" fn(u32, *const u8, *const u8, c_int) -> c_int;\n420\ttype FnEclass = unsafe extern \"C\" fn(u32, *const u8, *const u8, *const u8, c_int) -> c_int;\n421\ttype FnJitGetSize = unsafe extern \"C\" fn(*mut c_void) -> usize;\n422\ttype FnJitGetTarget = unsafe extern \"C\" fn() -> *const c_char;\n423\ttype FnStudy = unsafe extern \"C\" fn(Code) -> c_int;\n424\t\n425\t// ---------------------------------------------------------------- Api\n426\t\n427\tpub struct Api {\n428\t    pub name: &'static str,\n429\t    _lib: &'static libloading::Library,\n430\t\n431\t    pub config: FnConfig,\n432\t    pub compile: FnCompile,\n433\t    pub code_free: FnCodeFree,\n434\t    pub code_copy: FnCodeCopy,\n435\t    pub code_copy_with_tables: FnCodeCopy,\n436\t    pub pattern_info: FnPatternInfo,\n437\t    pub callout_enumerate: FnCalloutEnumerate,\n438\t    pub match_data_create: FnMatchDataCreate,\n439\t    pub match_data_create_from_pattern: FnMatchDataCreateFromPattern,\n440\t    pub match_data_free: FnMatchDataFree,\n441\t    pub do_match: FnMatch,\n442\t    pub dfa_match: FnDfaMatch,\n443\t    pub get_mark: FnGetMark,\n444\t    pub get_match_data_size: FnGetSz,\n445\t    pub get_match_data_heapframes_size: FnGetSz,\n446\t    pub get_ovector_count: FnGetU32,\n447\t    pub get_ovector_pointer: FnGetOvecPtr,\n448\t    pub get_startchar: FnGetSz,\n449\t    pub next_match: FnNextMatch,\n450\t    pub substitute: FnSubstitute,\n451\t    pub substring_copy_byname: FnSubstringCopyByname,\n452\t    pub substring_copy_bynumber: FnSubstringCopyBynumber,\n453\t    pub substring_free: FnSubstringFree,\n454\t    pub substring_get_byname: FnSubstringGetByname,\n455\t    pub substring_get_bynumber: FnSubstringGetBynumber,\n456\t    pub substring_length_byname: FnSubstringLengthByname,\n457\t    pub substring_length_bynumber: FnSubstringLengthBynumber,\n458\t    pub substring_nametable_scan: FnSubstringNametableScan,\n459\t    pub substring_number_from_name: FnSubstringNumberFromName,\n460\t    pub substring_list_free: FnSubstringListFree,\n461\t    pub substring_list_get: FnSubstringListGet,\n462\t    pub serialize_encode: FnSerializeEncode,\n463\t    pub serialize_decode: FnSerializeDecode,\n464\t    pub serialize_get_number_of_codes: FnSerializeGetNumber,\n465\t    pub serialize_free: FnSerializeFree,\n466\t    pub pattern_convert: FnPatternConvert,\n467\t    pub converted_pattern_free: FnConvertedPatternFree,\n468\t    pub get_error_message: FnGetErrorMessage,\n469\t    pub maketables: FnMaketables,\n470\t    pub maketables_free: FnMaketablesFree,\n471\t\n472\t    pub general_context_create: FnGCtxCreate,\n473\t    pub general_context_copy: FnCtxCopy,\n474\t    pub general_context_free: FnCtxFree,\n475\t    pub compile_context_create: FnCtxCreate,\n476\t    pub compile_context_copy: FnCtxCopy,\n477\t    pub compile_context_free: FnCtxFree,\n478\t    pub match_context_create: FnCtxCreate,\n479\t    pub match_context_copy: FnCtxCopy,\n480\t    pub match_context_free: FnCtxFree,\n481\t    pub convert_context_create: FnCtxCreate,\n482\t    pub convert_context_copy: FnCtxCopy,\n483\t    pub convert_context_free: FnCtxFree,\n484\t\n485\t    pub set_bsr: FnSetU32,\n486\t    pub set_character_tables: FnSetTables,\n487\t    pub set_compile_extra_options: FnSetU32,\n488\t    pub set_max_pattern_length: FnSetSz,\n489\t    pub set_max_pattern_compiled_length: FnSetSz,\n490\t    pub set_max_varlookbehind: FnSetU32,\n491\t    pub set_newline: FnSetU32,\n492\t    pub set_parens_nest_limit: FnSetU32,\n493\t    pub set_compile_recursion_guard: FnSetRecursionGuard,\n494\t    pub set_optimize: FnSetU32,\n495\t    pub set_callout: FnSetCallout,\n496\t    pub set_substitute_callout: FnSetSubstCallout,\n497\t    pub set_substitute_case_callout: FnSetSubstCaseCallout,\n498\t    pub set_depth_limit: FnSetU32,\n499\t    pub set_heap_limit: FnSetU32,\n500\t    pub set_match_limit: FnSetU32,\n501\t    pub set_offset_limit: FnSetSz,\n502\t    pub set_recursion_limit: FnSetU32,\n503\t    pub set_recursion_memory_management: FnSetRecursionMemMgmt,\n504\t    pub set_glob_escape: FnSetU32,\n505\t    pub set_glob_separator: FnSetU32,\n506\t\n507\t    pub jit_compile: FnJitCompile,\n508\t    pub jit_match: FnJitMatch,\n509\t    pub jit_free_unused_memory: FnJitFreeUnused,\n510\t    pub jit_stack_create: FnJitStackCreate,\n511\t    pub jit_stack_assign: FnJitStackAssign,\n512\t    pub jit_stack_free: FnJitStackFree,\n513\t\n514\t    pub p_strlen: FnStrlen,\n515\t    pub p_strcmp: FnStrcmp,\n516\t    pub p_strcmp_c8: FnStrcmpC8,\n517\t    pub p_strncmp: FnStrncmp,\n518\t    pub p_strncmp_c8: FnStrncmpC8,\n519\t    pub p_strcpy_c8: FnStrcpyC8,\n520\t    pub p_ord2utf: FnOrd2utf,\n521\t    pub p_valid_utf: FnValidUtf,\n522\t    pub p_ckd_smul: FnCkdSmul,\n523\t    pub p_is_newline: FnIsNewline,\n524\t    pub p_was_newline: FnWasNewline,\n525\t    pub p_script_run: FnScriptRun,\n526\t    pub p_extuni: FnExtuni,\n527\t    pub p_find_bracket: FnFindBracket,\n528\t    pub p_xclass: FnXclass,\n529\t    pub p_eclass: FnEclass,\n530\t    pub p_jit_get_size: FnJitGetSize,\n531\t    pub p_jit_get_target: FnJitGetTarget,\n532\t    pub p_study: FnStudy,\n533\t}\n534\t\n535\tmacro_rules! sym {\n536\t    ($lib:expr, $name:literal) => {{\n537\t        let s: libloading::Symbol<_> = unsafe { $lib.get(concat!($name, \"\\0\").as_bytes()) }\n538\t            .unwrap_or_else(|e| panic!(\"missing symbol {}: {}\", $name, e));\n539\t        unsafe { *s }\n540\t    }};\n541\t}\n542\t\n543\timpl Api {\n544\t    pub fn load(path: &PathBuf, name: &'static str) -> Api {\n545\t        let lib: &'static libloading::Library = Box::leak(Box::new(\n546\t            unsafe { libloading::Library::new(path) }\n547\t                .unwrap_or_else(|e| panic!(\"cannot load {:?}: {}\", path, e)),\n548\t        ));\n549\t        Api {\n550\t            name,\n551\t            _lib: lib,\n552\t            config: sym!(lib, \"pcre2_config_8\"),\n553\t            compile: sym!(lib, \"pcre2_compile_8\"),\n554\t            code_free: sym!(lib, \"pcre2_code_free_8\"),\n555\t            code_copy: sym!(lib, \"pcre2_code_copy_8\"),\n556\t            code_copy_with_tables: sym!(lib, \"pcre2_code_copy_with_tables_8\"),\n557\t            pattern_info: sym!(lib, \"pcre2_pattern_info_8\"),\n558\t            callout_enumerate: sym!(lib, \"pcre2_callout_enumerate_8\"),\n559\t            match_data_create: sym!(lib, \"pcre2_match_data_create_8\"),\n560\t            match_data_create_from_pattern: sym!(lib, \"pcre2_match_data_create_from_pattern_8\"),\n561\t            match_data_free: sym!(lib, \"pcre2_match_data_free_8\"),\n562\t            do_match: sym!(lib, \"pcre2_match_8\"),\n563\t            dfa_match: sym!(lib, \"pcre2_dfa_match_8\"),\n564\t            get_mark: sym!(lib, \"pcre2_get_mark_8\"),\n565\t            get_match_data_size: sym!(lib, \"pcre2_get_match_data_size_8\"),\n566\t            get_match_data_heapframes_size: sym!(lib, \"pcre2_get_match_data_heapframes_size_8\"),\n567\t            get_ovector_count: sym!(lib, \"pcre2_get_ovector_count_8\"),\n568\t            get_ovector_pointer: sym!(lib, \"pcre2_get_ovector_pointer_8\"),\n569\t            get_startchar: sym!(lib, \"pcre2_get_startchar_8\"),\n570\t            next_match: sym!(lib, \"pcre2_next_match_8\"),\n571\t            substitute: sym!(lib, \"pcre2_substitute_8\"),\n572\t            substring_copy_byname: sym!(lib, \"pcre2_substring_copy_byname_8\"),\n573\t            substring_copy_bynumber: sym!(lib, \"pcre2_substring_copy_bynumber_8\"),\n574\t            substring_free: sym!(lib, \"pcre2_substring_free_8\"),\n575\t            substring_get_byname: sym!(lib, \"pcre2_substring_get_byname_8\"),\n576\t            substring_get_bynumber: sym!(lib, \"pcre2_substring_get_bynumber_8\"),\n577\t            substring_length_byname: sym!(lib, \"pcre2_substring_length_byname_8\"),\n578\t            substring_length_bynumber: sym!(lib, \"pcre2_substring_length_bynumber_8\"),\n579\t            substring_nametable_scan: sym!(lib, \"pcre2_substring_nametable_scan_8\"),\n580\t            substring_number_from_name: sym!(lib, \"pcre2_substring_number_from_name_8\"),\n581\t            substring_list_free: sym!(lib, \"pcre2_substring_list_free_8\"),\n582\t            substring_list_get: sym!(lib, \"pcre2_substring_list_get_8\"),\n583\t            serialize_encode: sym!(lib, \"pcre2_serialize_encode_8\"),\n584\t            serialize_decode: sym!(lib, \"pcre2_serialize_decode_8\"),\n585\t            serialize_get_number_of_codes: sym!(lib, \"pcre2_serialize_get_number_of_codes_8\"),\n586\t            serialize_free: sym!(lib, \"pcre2_serialize_free_8\"),\n587\t            pattern_convert: sym!(lib, \"pcre2_pattern_convert_8\"),\n588\t            converted_pattern_free: sym!(lib, \"pcre2_converted_pattern_free_8\"),\n589\t            get_error_message: sym!(lib, \"pcre2_get_error_message_8\"),\n590\t            maketables: sym!(lib, \"pcre2_maketables_8\"),\n591\t            maketables_free: sym!(lib, \"pcre2_maketables_free_8\"),\n592\t\n593\t            general_context_create: sym!(lib, \"pcre2_general_context_create_8\"),\n594\t            general_context_copy: sym!(lib, \"pcre2_general_context_copy_8\"),\n595\t            general_context_free: sym!(lib, \"pcre2_general_context_free_8\"),\n596\t            compile_context_create: sym!(lib, \"pcre2_compile_context_create_8\"),\n597\t            compile_context_copy: sym!(lib, \"pcre2_compile_context_copy_8\"),\n598\t            compile_context_free: sym!(lib, \"pcre2_compile_context_free_8\"),\n599\t            match_context_create: sym!(lib, \"pcre2_match_context_create_8\"),\n600\t            match_context_copy: sym!(lib, \"pcre2_match_context_copy_8\"),\n601\t            match_context_free: sym!(lib, \"pcre2_match_context_free_8\"),\n602\t            convert_context_create: sym!(lib, \"pcre2_convert_context_create_8\"),\n603\t            convert_context_copy: sym!(lib, \"pcre2_convert_context_copy_8\"),\n604\t            convert_context_free: sym!(lib, \"pcre2_convert_context_free_8\"),\n605\t\n606\t            set_bsr: sym!(lib, \"pcre2_set_bsr_8\"),\n607\t            set_character_tables: sym!(lib, \"pcre2_set_character_tables_8\"),\n608\t            set_compile_extra_options: sym!(lib, \"pcre2_set_compile_extra_options_8\"),\n609\t            set_max_pattern_length: sym!(lib, \"pcre2_set_max_pattern_length_8\"),\n610\t            set_max_pattern_compiled_length: sym!(lib, \"pcre2_set_max_pattern_compiled_length_8\"),\n611\t            set_max_varlookbehind: sym!(lib, \"pcre2_set_max_varlookbehind_8\"),\n612\t            set_newline: sym!(lib, \"pcre2_set_newline_8\"),\n613\t            set_parens_nest_limit: sym!(lib, \"pcre2_set_parens_nest_limit_8\"),\n614\t            set_compile_recursion_guard: sym!(lib, \"pcre2_set_compile_recursion_guard_8\"),\n615\t            set_optimize: sym!(lib, \"pcre2_set_optimize_8\"),\n616\t            set_callout: sym!(lib, \"pcre2_set_callout_8\"),\n617\t            set_substitute_callout: sym!(lib, \"pcre2_set_substitute_callout_8\"),\n618\t            set_substitute_case_callout: sym!(lib, \"pcre2_set_substitute_case_callout_8\"),\n619\t            set_depth_limit: sym!(lib, \"pcre2_set_depth_limit_8\"),\n620\t            set_heap_limit: sym!(lib, \"pcre2_set_heap_limit_8\"),\n621\t            set_match_limit: sym!(lib, \"pcre2_set_match_limit_8\"),\n622\t            set_offset_limit: sym!(lib, \"pcre2_set_offset_limit_8\"),\n623\t            set_recursion_limit: sym!(lib, \"pcre2_set_recursion_limit_8\"),\n624\t            set_recursion_memory_management: sym!(\n625\t                lib,\n626\t                \"pcre2_set_recursion_memory_management_8\"\n627\t            ),\n628\t            set_glob_escape: sym!(lib, \"pcre2_set_glob_escape_8\"),\n629\t            set_glob_separator: sym!(lib, \"pcre2_set_glob_separator_8\"),\n630\t\n631\t            jit_compile: sym!(lib, \"pcre2_jit_compile_8\"),\n632\t            jit_match: sym!(lib, \"pcre2_jit_match_8\"),\n633\t            jit_free_unused_memory: sym!(lib, \"pcre2_jit_free_unused_memory_8\"),\n634\t            jit_stack_create: sym!(lib, \"pcre2_jit_stack_create_8\"),\n635\t            jit_stack_assign: sym!(lib, \"pcre2_jit_stack_assign_8\"),\n636\t            jit_stack_free: sym!(lib, \"pcre2_jit_stack_free_8\"),\n637\t\n638\t            p_strlen: sym!(lib, \"_pcre2_strlen_8\"),\n639\t            p_strcmp: sym!(lib, \"_pcre2_strcmp_8\"),\n640\t            p_strcmp_c8: sym!(lib, \"_pcre2_strcmp_c8_8\"),\n641\t            p_strncmp: sym!(lib, \"_pcre2_strncmp_8\"),\n642\t            p_strncmp_c8: sym!(lib, \"_pcre2_strncmp_c8_8\"),\n643\t            p_strcpy_c8: sym!(lib, \"_pcre2_strcpy_c8_8\"),\n644\t            p_ord2utf: sym!(lib, \"_pcre2_ord2utf_8\"),\n645\t            p_valid_utf: sym!(lib, \"_pcre2_valid_utf_8\"),\n646\t            p_ckd_smul: sym!(lib, \"_pcre2_ckd_smul_8\"),\n647\t            p_is_newline: sym!(lib, \"_pcre2_is_newline_8\"),\n648\t            p_was_newline: sym!(lib, \"_pcre2_was_newline_8\"),\n649\t            p_script_run: sym!(lib, \"_pcre2_script_run_8\"),\n650\t            p_extuni: sym!(lib, \"_pcre2_extuni_8\"),\n651\t            p_find_bracket: sym!(lib, \"_pcre2_find_bracket_8\"),\n652\t            p_xclass: sym!(lib, \"_pcre2_xclass_8\"),\n653\t            p_eclass: sym!(lib, \"_pcre2_eclass_8\"),\n654\t            p_jit_get_size: sym!(lib, \"_pcre2_jit_get_size_8\"),\n655\t            p_jit_get_target: sym!(lib, \"_pcre2_jit_get_target_8\"),\n656\t            p_study: sym!(lib, \"_pcre2_study_8\"),\n657\t        }\n658\t    }\n659\t\n660\t    /// Raw access to an exported data symbol.\n661\t    pub fn data(&self, name: &str) -> *const u8 {\n662\t        let mut b = name.as_bytes().to_vec();\n663\t        b.push(0);\n664\t        let s: libloading::Symbol<*const u8> = unsafe { self._lib.get(&b) }\n665\t            .unwrap_or_else(|e| panic!(\"missing data symbol {}: {}\", name, e));\n666\t        unsafe { s.into_raw().into_raw() as *const u8 }\n667\t    }\n668\t}\n669\t\n670\t// ---------------------------------------------------------------- loading\n671\t\n672\tfn crate_root() -> PathBuf {\n673\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n674\t}\n675\t\n676\tpub fn c_so_path() -> PathBuf {\n677\t    if let Ok(p) = std::env::var(\"C_PCRE2_SO\") {\n678\t        return PathBuf::from(p);\n679\t    }\n680\t    crate_root()\n681\t        .parent()\n682\t        .unwrap()\n683\t        .join(\"c_src/build/libpcre2.so\")\n684\t}\n685\t\n686\tpub fn rust_so_path() -> PathBuf {\n687\t    if let Ok(p) = std::env::var(\"RUST_PCRE2_SO\") {\n688\t        return PathBuf::from(p);\n689\t    }\n690\t    let rel = crate_root().join(\"target/release/libpcre2.so\");\n691\t    if rel.exists() {\n692\t        return rel;\n693\t    }\n694\t    crate_root().join(\"target/debug/libpcre2.so\")\n695\t}\n696\t\n697\tstatic ONCE: std::sync::OnceLock<(Api, Api)> = std::sync::OnceLock::new();\n698\t\n699\t/// Returns `(c_api, rust_api)`.\n700\tpub fn apis() -> &'static (Api, Api) {\n701\t    ONCE.get_or_init(|| {\n702\t        let c = Api::load(&c_so_path(), \"C\");\n703\t        let r = Api::load(&rust_so_path(), \"RUST\");\n704\t        (c, r)\n705\t    })\n706\t}\n707\t\n708\t// ---------------------------------------------------------------- rng\n709\t\n710\t/// Deterministic xorshift64* PRNG so every run is reproducible.\n711\tpub struct Rng(u64);\n712\t\n713\timpl Rng {\n714\t    pub fn new(seed: u64) -> Rng {\n715\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n716\t    }\n717\t    pub fn next_u64(&mut self) -> u64 {\n718\t        let mut x = self.0;\n719\t        x ^= x >> 12;\n720\t        x ^= x << 25;\n721\t        x ^= x >> 27;\n722\t        self.0 = x;\n723\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n724\t    }\n725\t    pub fn next_u32(&mut self) -> u32 {\n726\t        (self.next_u64() >> 32) as u32\n727\t    }\n728\t    /// Uniform in `0..n`.\n729\t    pub fn below(&mut self, n: usize) -> usize {\n730\t        if n == 0 {\n731\t            0\n732\t        } else {\n733\t            (self.next_u64() % (n as u64)) as usize\n734\t        }\n735\t    }\n736\t    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n737\t        &xs[self.below(xs.len())]\n738\t    }\n739\t    pub fn bool(&mut self) -> bool {\n740\t        self.next_u64() & 1 == 1\n741\t    }\n742\t}\n743\t\n744\t// ---------------------------------------------------------------- helpers\n745\t\n746\t/// Observation log: a byte string describing everything an API call produced.\n747\t/// Comparing two logs byte-for-byte is the differential assertion.\n748\t#[derive(Default, PartialEq, Eq, Clone)]\n749\tpub struct Log(pub Vec<u8>);\n750\t\n751\timpl Log {\n752\t    pub fn new() -> Log {\n753\t        Log(Vec::new())\n754\t    }\n755\t    pub fn i(&mut self, v: i64) -> &mut Self {\n756\t        self.0.extend_from_slice(&v.to_le_bytes());\n757\t        self.0.push(b'|');\n758\t        self\n759\t    }\n760\t    pub fn u(&mut self, v: u64) -> &mut Self {\n761\t        self.0.extend_from_slice(&v.to_le_bytes());\n762\t        self.0.push(b'|');\n763\t        self\n764\t    }\n765\t    pub fn b(&mut self, v: &[u8]) -> &mut Self {\n766\t        self.0.extend_from_slice(&(v.len() as u64).to_le_bytes());\n767\t        self.0.extend_from_slice(v);\n768\t        self.0.push(b'|');\n769\t        self\n770\t    }\n771\t    pub fn tag(&mut self, s: &str) -> &mut Self {\n772\t        self.0.extend_from_slice(s.as_bytes());\n773\t        self.0.push(b'#');\n774\t        self\n775\t    }\n776\t}\n777\t\n778\timpl std::fmt::Debug for Log {\n779\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n780\t        // Show a readable-ish rendering: printable bytes plus hex escapes.\n781\t        write!(f, \"Log[{} bytes] \", self.0.len())?;\n782\t        for &c in self.0.iter().take(4096) {\n783\t            if c.is_ascii_graphic() || c == b' ' {\n784\t                write!(f, \"{}\", c as char)?;\n785\t            } else {\n786\t                write!(f, \"\\\\x{:02x}\", c)?;\n787\t            }\n788\t        }\n789\t        Ok(())\n790\t    }\n791\t}\n792\t\n793\t/// Asserts that running `f` against C and against Rust yields identical logs.\n794\t#[track_caller]\n795\tpub fn diff<F: Fn(&Api) -> Log>(label: &str, f: F) {\n796\t    let (c, r) = apis();\n797\t    let lc = f(c);\n798\t    let lr = f(r);\n799\t    if lc != lr {\n800\t        // Find the first differing byte to make the report useful.\n801\t        let n = lc.0.len().min(lr.0.len());\n802\t        let mut at = n;\n803\t        for i in 0..n {\n804\t            if lc.0[i] != lr.0[i] {\n805\t                at = i;\n806\t                break;\n807\t            }\n808\t        }\n809\t        let lo = at.saturating_sub(48);\n810\t        let hi_c = (at + 48).min(lc.0.len());\n811\t        let hi_r = (at + 48).min(lr.0.len());\n812\t        panic!(\n813\t            \"DIVERGENCE in {label}\\n  first difference at byte {at}\\\n814\t             \\n  C   len={} …{:?}\\n  RUST len={} …{:?}\",\n815\t            lc.0.len(),\n816\t            &lc.0[lo..hi_c],\n817\t            lr.0.len(),\n818\t            &lr.0[lo..hi_r],\n819\t        );\n820\t    }\n821\t}\n822\t\n823\t/// Compares two raw exported data blobs byte for byte.\n824\t#[track_caller]\n825\tpub fn diff_data(name: &str, len: usize) {\n826\t    let (c, r) = apis();\n827\t    let pc = c.data(name);\n828\t    let pr = r.data(name);\n829\t    assert!(!pc.is_null(), \"C data symbol {name} null\");\n830\t    assert!(!pr.is_null(), \"RUST data symbol {name} null\");\n831\t    let sc = unsafe { std::slice::from_raw_parts(pc, len) };\n832\t    let sr = unsafe { std::slice::from_raw_parts(pr, len) };\n833\t    if sc != sr {\n834\t        let at = (0..len).find(|&i| sc[i] != sr[i]).unwrap();\n835\t        panic!(\n836\t            \"DATA DIVERGENCE in {name} at byte {at}: C={:#x} RUST={:#x}\\n C:  {:?}\\n RUST:{:?}\",\n837\t            sc[at],\n838\t            sr[at],\n839\t            &sc[at.saturating_sub(8)..(at + 8).min(len)],\n840\t            &sr[at.saturating_sub(8)..(at + 8).min(len)],\n841\t        );\n842\t    }\n843\t}\n844\t\n845\t// ------------------------------------------------------- high-level logging\n846\t\n847\t/// Logs *every* `PCRE2_INFO_*` request for a compiled code, including the\n848\t/// variable-size outputs (name table, first-code-unit bitmap).\n849\tpub unsafe fn log_all_info(api: &Api, code: Code, l: &mut Log) {\n850\t    l.tag(\"info\");\n851\t    // Fixed-size uint32 requests.\n852\t    for what in [\n853\t        INFO_ALLOPTIONS,\n854\t        INFO_ARGOPTIONS,\n855\t        INFO_BACKREFMAX,\n856\t        INFO_BSR,\n857\t        INFO_CAPTURECOUNT,\n858\t        INFO_FIRSTCODEUNIT,\n859\t        INFO_FIRSTCODETYPE,\n860\t        INFO_HASCRORLF,\n861\t        INFO_JCHANGED,\n862\t        INFO_LASTCODEUNIT,\n863\t        INFO_LASTCODETYPE,\n864\t        INFO_MATCHEMPTY,\n865\t        INFO_MATCHLIMIT,\n866\t        INFO_MAXLOOKBEHIND,\n867\t        INFO_MINLENGTH,\n868\t        INFO_NAMECOUNT,\n869\t        INFO_NAMEENTRYSIZE,\n870\t        INFO_NEWLINE,\n871\t        INFO_DEPTHLIMIT,\n872\t        INFO_HASBACKSLASHC,\n873\t        INFO_HEAPLIMIT,\n874\t        INFO_EXTRAOPTIONS,\n875\t    ] {\n876\t        let mut v: u32 = 0xDEAD_BEEF;\n877\t        let rc = (api.pattern_info)(code, what, &mut v as *mut u32 as *mut c_void);\n878\t        l.u(what as u64).i(rc as i64).u(v as u64);\n879\t    }\n880\t    // PCRE2_SIZE requests (pcre2_pattern_info.c lines 97-99).\n881\t    for what in [INFO_SIZE, INFO_JITSIZE, INFO_FRAMESIZE] {\n882\t        let mut v: Sz = 0xDEAD;\n883\t        let rc = (api.pattern_info)(code, what, &mut v as *mut Sz as *mut c_void);\n884\t        l.u(what as u64).i(rc as i64).u(v as u64);\n885\t    }\n886\t    // First-code-unit bitmap (32 bytes) or NULL.\n887\t    let mut bm: *const u8 = std::ptr::null();\n888\t    let rc = (api.pattern_info)(code, INFO_FIRSTBITMAP, &mut bm as *mut _ as *mut c_void);\n889\t    l.tag(\"bitmap\").i(rc as i64).i(bm.is_null() as i64);\n890\t    if !bm.is_null() {\n891\t        l.b(std::slice::from_raw_parts(bm, 32));\n892\t    }\n893\t    // Name table.\n894\t    let mut nc: u32 = 0;\n895\t    let mut nes: u32 = 0;\n896\t    let mut nt: *const u8 = std::ptr::null();\n897\t    (api.pattern_info)(code, INFO_NAMECOUNT, &mut nc as *mut _ as *mut c_void);\n898\t    (api.pattern_info)(code, INFO_NAMEENTRYSIZE, &mut nes as *mut _ as *mut c_void);\n899\t    let rc = (api.pattern_info)(code, INFO_NAMETABLE, &mut nt as *mut _ as *mut c_void);\n900\t    l.tag(\"nametable\").i(rc as i64).u(nc as u64).u(nes as u64);\n901\t    if !nt.is_null() && nc > 0 && nes > 0 {\n902\t        l.b(std::slice::from_raw_parts(\n903\t            nt,\n904\t            (nc as usize) * (nes as usize),\n905\t        ));\n906\t    }\n907\t    // Unknown request values, including out-of-range enum values across FFI.\n908\t    for what in [27u32, 100, 9999, u32::MAX, u32::MAX - 1] {\n909\t        let mut v: Sz = 0;\n910\t        let rc = (api.pattern_info)(code, what, &mut v as *mut Sz as *mut c_void);\n911\t        l.u(what as u64).i(rc as i64);\n912\t    }\n913\t    // Size-query form (where == NULL).\n914\t    for what in [INFO_SIZE, INFO_NAMETABLE, INFO_FIRSTBITMAP, INFO_CAPTURECOUNT] {\n915\t        let rc = (api.pattern_info)(code, what, std::ptr::null_mut());\n916\t        l.u(what as u64).i(rc as i64);\n917\t    }\n918\t}\n919\t\n920\t/// Logs the serialized form of a compiled code — this is the whole compiled\n921\t/// bytecode, so a byte-for-byte match here means the compilers agree exactly.\n922\tpub unsafe fn log_serialized(api: &Api, code: Code, l: &mut Log) {\n923\t    let codes = [code];\n924\t    let mut bytes: *mut u8 = std::ptr::null_mut();\n925\t    let mut size: Sz = 0;\n926\t    let rc = (api.serialize_encode)(\n927\t        codes.as_ptr(),\n928\t        1,\n929\t        &mut bytes,\n930\t        &mut size,\n931\t        std::ptr::null_mut(),\n932\t    );\n933\t    l.tag(\"ser\").i(rc as i64).u(size as u64);\n934\t    if rc == 1 && !bytes.is_null() {\n935\t        // The 32-byte header contains a magic/version/config plus the total\n936\t        // size; everything after it is the bytecode itself.\n937\t        l.b(std::slice::from_raw_parts(bytes, size));\n938\t        (api.serialize_free)(bytes);\n939\t    }\n940\t}\n941\t\n942\t/// Logs the complete outcome of a match: rc, ovector count and contents,\n943\t/// start char, mark, and the match-data sizes.\n944\tpub unsafe fn log_match_result(api: &Api, md: MatchData, rc: c_int, l: &mut Log) {\n945\t    l.tag(\"m\").i(rc as i64);\n946\t    if md.is_null() {\n947\t        return;\n948\t    }\n949\t    let n = (api.get_ovector_count)(md);\n950\t    l.u(n as u64);\n951\t    let ov = (api.get_ovector_pointer)(md);\n952\t    if !ov.is_null() {\n953\t        for i in 0..(2 * n as usize) {\n954\t            l.u(*ov.add(i) as u64);\n955\t        }\n956\t    }\n957\t    l.u((api.get_startchar)(md) as u64);\n958\t    let mk = (api.get_mark)(md);\n959\t    l.i(mk.is_null() as i64);\n960\t    if !mk.is_null() {\n961\t        l.b(&cstr(mk));\n962\t    }\n963\t    l.u((api.get_match_data_size)(md) as u64);\n964\t}\n965\t\n966\t/// Compiles a pattern, logging the error code and offset on failure.\n967\t/// Returns the code (possibly null).\n968\tpub unsafe fn compile_logged(\n969\t    api: &Api,\n970\t    pat: &[u8],\n971\t    patlen: Sz,\n972\t    options: u32,\n973\t    ccontext: CContext,\n974\t    l: &mut Log,\n975\t) -> Code {\n976\t    let mut errcode: c_int = 0x7FFF;\n977\t    let mut erroffset: Sz = 0xDEAD;\n978\t    let p = if pat.is_empty() {\n979\t        // Non-null pointer into an empty slice is fine; use a static byte.\n980\t        b\"\\0\".as_ptr()\n981\t    } else {\n982\t        pat.as_ptr()\n983\t    };\n984\t    let code = (api.compile)(p, patlen, options, &mut errcode, &mut erroffset, ccontext);\n985\t    l.tag(\"c\")\n986\t        .i(code.is_null() as i64)\n987\t        .i(errcode as i64)\n988\t        .u(erroffset as u64);\n989\t    code\n990\t}\n991\t\n992\t/// Reads a NUL-terminated C string from a pointer (bounded to avoid runaway).\n993\tpub unsafe fn cstr(p: *const u8) -> Vec<u8> {\n994\t    if p.is_null() {\n995\t        return Vec::new();\n996\t    }\n997\t    let mut v = Vec::new();\n998\t    let mut i = 0usize;\n999\t    while i < 1 << 20 {\n1000\t        let b = *p.add(i);\n1001\t        if b == 0 {\n1002\t            break;\n1003\t        }\n1004\t        v.push(b);\n1005\t        i += 1;\n1006\t    }\n1007\t    v\n1008\t}\n1009\t"}]},"parent_tool_use_id":"toolu_bdrk_01E4ym4QF9EYejzpLckvHyKE","session_id":"afdd377b-a8e3-4242-b7f7-f8439c40180f","uuid":"fbf7b714-368b-42e6-bb8a-86a92e71545e","timestamp":"2026-08-31T07:12:45.443Z","subagent_type":"general-purpose","task_description":"Substitute differential tests"}
