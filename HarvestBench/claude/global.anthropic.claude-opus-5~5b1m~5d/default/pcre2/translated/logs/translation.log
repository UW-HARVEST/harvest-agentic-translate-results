MENT OF\n33\tSUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS\n34\tINTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN\n35\tCONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)\n36\tARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE\n37\tPOSSIBILITY OF SUCH DAMAGE.\n38\t-----------------------------------------------------------------------------\n39\t*/\n40\t\n41\t\n42\t/* This file contains a function that converts a Unicode character code point\n43\tinto a UTF string. The behaviour is different for each code unit width. */\n44\t\n45\t\n46\t#include \"pcre2_internal.h\"\n47\t\n48\t\n49\t\n50\t/* If SUPPORT_UNICODE is not defined, this function will never be called.\n51\tSupply a dummy function because some compilers do not like empty source\n52\tmodules. */\n53\t\n54\t#ifndef SUPPORT_UNICODE\n55\tunsigned int\n56\tPRIV(ord2utf)(uint32_t cvalue, PCRE2_UCHAR *buffer)\n57\t{\n58\t(void)(cvalue);\n59\t(void)(buffer);\n60\treturn 0;\n61\t}\n62\t#else  /* SUPPORT_UNICODE */\n63\t\n64\t\n65\t/*************************************************\n66\t*          Convert code point to UTF             *\n67\t*************************************************/\n68\t\n69\t/*\n70\tArguments:\n71\t  cvalue     the character value\n72\t  buffer     pointer to buffer for result\n73\t\n74\tReturns:     number of code units placed in the buffer\n75\t*/\n76\t\n77\tunsigned int\n78\tPRIV(ord2utf)(uint32_t cvalue, PCRE2_UCHAR *buffer)\n79\t{\n80\t/* Convert to UTF-8 */\n81\t\n82\t#if PCRE2_CODE_UNIT_WIDTH == 8\n83\tunsigned int i;\n84\t\n85\tfor (i = 0; i < PRIV(utf8_table1_size); i++)\n86\t  if ((int)cvalue <= PRIV(utf8_table1)[i]) break;\n87\tbuffer += i;\n88\tfor (unsigned int j = i; j != 0; j--)\n89\t {\n90\t *buffer-- = 0x80 | (cvalue & 0x3f);\n91\t cvalue >>= 6;\n92\t }\n93\t*buffer = (PCRE2_UCHAR)(PRIV(utf8_table2)[i] | (int)cvalue);\n94\treturn i + 1;\n95\t\n96\t/* Convert to UTF-16 */\n97\t\n98\t#elif PCRE2_CODE_UNIT_WIDTH == 16\n99\tif (cvalue <= 0xffff)\n100\t  {\n101\t  *buffer = (PCRE2_UCHAR)cvalue;\n102\t  return 1;\n103\t  }\n104\tcvalue -= 0x10000;\n105\t*buffer++ = 0xd800 | (cvalue >> 10);\n106\t*buffer = 0xdc00 | (cvalue & 0x3ff);\n107\treturn 2;\n108\t\n109\t/* Convert to UTF-32 */\n110\t\n111\t#else\n112\t*buffer = (PCRE2_UCHAR)cvalue;\n113\treturn 1;\n114\t#endif\n115\t}\n116\t#endif  /* SUPPORT_UNICODE */\n117\t\n118\t/* End of pcre2_ord2utf.c */\n119\t"}]},"parent_tool_use_id":"toolu_bdrk_01VRgqKt1uFZB19m4DrzckjC","session_id":"6b19aa16-17c8-42f3-a300-59c20a915dbc","uuid":"8f28b356-4710-4e01-a477-deef590e8a0c","timestamp":"2026-08-31T06:07:59.425Z","subagent_type":"claude","task_description":"Translate newline and ord2utf"}
