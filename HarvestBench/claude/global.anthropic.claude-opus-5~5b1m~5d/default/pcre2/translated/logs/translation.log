macro_export]\n304\tmacro_rules! GETCHARLENTEST {\n305\t    ($c:expr, $eptr:expr, $len:expr, $utf:expr) => {{\n306\t        $c = *$eptr as u32;\n307\t        if $utf != 0 && $c >= 0xc0u32 {\n308\t            GETUTF8LEN!($c, $eptr, $len);\n309\t        }\n310\t    }};\n311\t}\n312\t\n313\t/// BACKCHAR(eptr): move back to the start of a UTF-8 character.\n314\t#[macro_export]\n315\tmacro_rules! BACKCHAR {\n316\t    ($eptr:expr) => {\n317\t        while (*$eptr & 0xc0u8) == 0x80u8 {\n318\t            $eptr = $eptr.offset(-1);\n319\t        }\n320\t    };\n321\t}\n322\t\n323\t/// FORWARDCHAR(eptr)\n324\t#[macro_export]\n325\tmacro_rules! FORWARDCHAR {\n326\t    ($eptr:expr) => {\n327\t        while (*$eptr & 0xc0u8) == 0x80u8 {\n328\t            $eptr = $eptr.add(1);\n329\t        }\n330\t    };\n331\t}\n332\t\n333\t/// FORWARDCHARTEST(eptr, end)\n334\t#[macro_export]\n335\tmacro_rules! FORWARDCHARTEST {\n336\t    ($eptr:expr, $end:expr) => {\n337\t        while $eptr < $end && (*$eptr & 0xc0u8) == 0x80u8 {\n338\t            $eptr = $eptr.add(1);\n339\t        }\n340\t    };\n341\t}\n342\t\n343\t/// ACROSSCHAR(condition, eptr, action)\n344\t#[macro_export]\n345\tmacro_rules! ACROSSCHAR {\n346\t    ($condition:expr, $eptr:expr, $action:stmt) => {\n347\t        while ($condition) && (*$eptr & 0xc0u8) == 0x80u8 {\n348\t            $action\n349\t        }\n350\t    };\n351\t}\n352\t\n353\t/// PUTCHAR(c, p, utf): deposit a character, returning the number of code units.\n354\t#[macro_export]\n355\tmacro_rules! PUTCHAR {\n356\t    ($c:expr, $p:expr, $utf:expr) => {\n357\t        if $utf != 0 && ($c as u32) > crate::consts::MAX_UTF_SINGLE_CU {\n358\t            crate::ord2utf::_pcre2_ord2utf_8($c as u32, $p)\n359\t        } else {\n360\t            *$p = $c as u8;\n361\t            1u32\n362\t        }\n363\t    };\n364\t}\n365\t\n366\t/* ---------------- UCD access ---------------- */\n367\t\n368\t/// GET_UCD(ch) -> *const ucd_record\n369\t#[macro_export]\n370\tmacro_rules! GET