073\t                                                    | META_LOOKBEHIND_NA => {\n1074\t                                                        PUTPP!(parsed_pattern, meta);\n1075\t                                                        ptr = ptr.wrapping_sub(1);\n1076\t                                                        istate = S_POST_LOOKBEHIND; /* goto POST_LOOKBEHIND */\n1077\t                                                        continue 'isw;\n1078\t                                                    }\n1079\t\n1080\t                                                    /* The script run facilities are\n1081\t                                                    handled here. Always record a\n1082\t                                                    META_SCRIPT_RUN item. Then, for the\n1083\t                                                    atomic version, insert META_ATOMIC\n1084\t                                                    and remember that we need two\n1085\t                                                    META_KETs at the end. */\n1086\t\n1087\t                                                    META_SCRIPT_RUN\n1088\t                                                    | META_ATOMIC_SCRIPT_RUN => {\n1089\t                                                        PUTPP!(\n1090\t                                                            parsed_pattern,\n1091\t                                                            META_SCRIPT_RUN\n1092\t                                                        );\n1093\t                                                        nest_depth += 1;\n1094\t                                                        ptr = ptr.add(1);\n1095\t                                                        if meta == META_ATOMIC_SCRIPT_RUN {\n1096\t                                                            PUTPP!(\n1097\t                                                                parsed_pattern,\n1098\t                      