variables */\n689\t\n690\theapframe *F;           /* Current frame pointer */\n691\theapframe *N = NULL;    /* Temporary frame pointers */\n692\theapframe *P = NULL;\n693\t\n694\theapframe *frames_top;  /* End of frames vector */\n695\theapframe *assert_accept_frame = NULL;  /* For passing back a frame with captures */\n696\tPCRE2_SIZE frame_copy_size;   /* Amount to copy when creating a new frame */\n697\t\n698\t/* Local variables that do not need to be preserved over calls to RMATCH(). */\n699\t\n700\tPCRE2_SPTR branch_end = NULL;\n701\tPCRE2_SPTR branch_start;\n702\tPCRE2_SPTR bracode;     /* Temp pointer to start of group */\n703\tPCRE2_SIZE offset;      /* Used for group offsets */\n704\tPCRE2_SIZE length;      /* Used for various length calculations */\n705\t\n706\tint rrc;                /* Return from functions & backtracking \"recursions\" */\n707\t#ifdef SUPPORT_UNICODE\n708\tint proptype;           /* Type of character property */\n709\t#endif\n710\t\n711\tuint32_t i;             /* Used for local loops */\n712\tuint32_t fc;            /* Character values */\n713\tuint32_t number;        /* Used for group and other numbers */\n714\tuint32_t reptype = 0;   /* Type of repetition (0 to avoid compiler warning) */\n715\tuint32_t group_frame_type;  /* Specifies type for new group frames */\n716\t\n717\tBOOL condition;         /* Used in conditional groups */\n718\tBOOL cur_is_word;       /* Used in \"word\" tests */\n719\tBOOL prev_is_word;      /* Used in \"word\" tests */\n720\t\n721\t/* UTF and UCP flags */\n722\t\n723\t#ifdef SUPPORT_UNICODE\n724\tBOOL utf = (mb->poptions & PCRE2_UTF) != 0;\n725\tBOOL ucp = (mb->poptions & PCRE2_UCP) != 0;\n726\t#else\n727\tBOOL utf = FALSE;  /* Required for convenience even when no Unicode support */\n728\t#endif\n729\t\n730\t/* This is the length of the last part of a backtracking frame that must be\n731\tcopied when a new frame is created. */\n732\t\n733\tframe_copy_size = frame_size - offsetof(heapframe, eptr);\n734\t\n735\t/* Set up the first frame and the end of the frames vector. */\n736\t\n737\tF = match_data->heapframes;\n738\tframes_top = (heapframe *)((char *)F + match_data->heapframes_size);\n739\t\n740\tFrdepth = 0;                        /* \"Recursion\" depth */\n741\tFcapture_last = 0;                  /* Number of most recent capture */\n742\tFcurrent_recurse = RECURSE_UNSET;   /* Not pattern recursing. */\n743\tFstart_match = Feptr = start_eptr;  /* Current data pointer and start match */\n744\tFmark = NULL;                       /* Most recent mark */\n745\tFoffset_top = 0;                    /* End of captures within the frame */\n746\tFlast_group_offset = PCRE2_UNSET;   /* Saved frame of most recent group */\n747\tgroup_frame_type = 0;               /* Not a start of group frame */\n748\tgoto NEW_FRAME;                     /* Start processing with this frame */\n749\t\n750\t/* Come back here when we want to create a new frame for remembering a\n751\tbacktracking point. */\n752\t\n753\tMATCH_RECURSE:\n754\t\n755\t/* Set up a new backtracking frame. If the vector is full, get a new one,\n756\tdoubling the size, but constrained by the heap limit (which is in KiB). */\n757\t\n758\tN = (heapframe *)((char *)F + frame_size);\n759\tif ((heapframe *)((char *)N + frame_size) >= frames_top)\n760\t  {\n761\t  heapframe *new;\n762\t  PCRE2_SIZE newsize;\n763\t  PCRE2_SIZE usedsize = (char *)N - (char *)(match_data->heapframes);\n764\t\n765\t  if (match_data->heapframes_size >= PCRE2_SIZE_MAX / 2)\n766\t    {\n767\t    if (match_data->heapframes_size == PCRE2_SIZE_MAX - 1)\n768\t      return PCRE2_ERROR_NOMEMORY;\n769\t    newsize = PCRE2_SIZE_MAX - 1;\n770\t    }\n771\t  else\n772\t    newsize = match_data->heapframes_size * 2;\n773\t\n774\t  if (newsize / 1024 >= mb->heap_limit)\n775\t    {\n776\t    PCRE2_SIZE old_size = match_data->heapframes_size / 1024;\n777\t    if (mb->heap_limit <= old_size)\n778\t      return PCRE2_ERROR_HEAPLIMIT;\n779\t    else\n780\t      {\n781\t      PCRE2_SIZE max_delta = 1024 * (mb->heap_limit - old_size);\n782\t      int over_bytes = match_data->heapframes_size % 1024;\n783\t      if (over_bytes) max_delta -= (1024 - over_bytes);\n784\t      newsize = match_data->heapframes_size + max_delta;\n785\t      }\n786\t    }\n787\t\n788\t  /* With a heap limit set, the permitted additional size may not be enough for\n789\t  another frame, so do a final check. */\n790\t\n791\t  if (newsize - usedsize < frame_size) return PCRE2_ERROR_HEAPLIMIT;\n792\t  new = match_data->memctl.malloc(newsize, match_data->memctl.memory_data);\n793\t  if (new == NULL) return PCRE2_ERROR_NOMEMORY;\n794\t  memcpy(new, match_data->heapframes, usedsize);\n795\t\n796\t  N = (heapframe *)((char *)new + usedsize);\n797\t  F = (heapframe *)((char *)N - frame_size);\n798\t\n799\t  match_data->memctl.free(match_data->heapframes, match_data->memctl.memory_data);\n800\t  match_data->heapframes = new;\n801\t  match_data->heapframes_size = newsize;\n802\t  frames_top = (heapframe *)((char *)new + newsize);\n803\t  }\n804\t\n805\t#ifdef DEBUG_SHOW_RMATCH\n806\tfprintf(stderr, \"++ RMATCH %d frame=%d\", Freturn_id, Frdepth + 1);\n807\tif (group_frame_type != 0)\n808\t  {\n809\t  fprintf(stderr, \" type=%x \", group_frame_type);\n810\t  switch (GF_IDMASK(group_frame_type))\n811\t    {\n812\t    case GF_CAPTURE:\n813\t    fprintf(stderr, \"capture=%d\", GF_DATAMASK(group_frame_type));\n814\t    break;\n815\t\n816\t    case GF_NOCAPTURE:\n817\t    fprintf(stderr, \"nocapture op=%d\", Fop);\n818\t    break;\n819\t\n820\t    case GF_CONDASSERT:\n821\t    fprintf(stderr, \"condassert op=%d\", Fop);\n822\t    break;\n823\t\n824\t    case GF_RECURSE:\n825\t    fprintf(stderr, \"recurse=%d\", GF_DATAMASK(group_frame_type));\n826\t    break;\n827\t\n828\t    default:\n829\t    fprintf(stderr, \"*** unknown ***\");\n830\t    break;\n831\t    }\n832\t  }\n833\tfprintf(stderr, \"\\n\");\n834\t#endif\n835\t\n836\t/* Copy those fields that must be copied into the new frame, increase the\n837\t\"recursion\" depth (i.e. the new frame's index) and then make the new frame\n838\tcurrent. */\n839\t\n840\tmemcpy((char *)N + offsetof(heapframe, eptr),\n841\t       (char *)F + offsetof(heapframe, eptr),\n842\t       frame_copy_size);\n843\t\n844\tN->rdepth = Frdepth + 1;\n845\tF = N;\n846\t\n847\t/* Carry on processing with a new frame. */\n848\t\n849\tNEW_FRAME:\n850\tFgroup_frame_type = group_frame_type;\n851\tFecode = start_ecode;      /* Starting code pointer */\n852\tFback_frame = frame_size;  /* Default is go back one frame */\n853\t\n854\t/* If this is a special type of group frame, remember its offset for quick\n855\taccess at the end of the group. If this is a recursion, set a new current\n856\trecursion value. */\n857\t\n858\tif (group_frame_type != 0)\n859\t  {\n860\t  Flast_group_offset = (char *)F - (char *)match_data->heapframes;\n861\t  if (GF_IDMASK(group_frame_type) == GF_RECURSE)\n862\t    Fcurrent_recurse = GF_DATAMASK(group_frame_type);\n863\t  group_frame_type = 0;\n864\t  }\n865\t\n866\t\n867\t/* ========================================================================= */\n868\t/* This is the main processing loop. First check that we haven't recorded too\n869\tmany backtracks (search tree is too large), or that we haven't exceeded the\n870\trecursive depth limit (used too many backtracking frames). If not, process the\n871\topcodes. */\n872\t\n873\tif (mb->match_call_count++ >= mb->match_limit) return PCRE2_ERROR_MATCHLIMIT;\n874\tif (Frdepth >= mb->match_limit_depth) return PCRE2_ERROR_DEPTHLIMIT;\n875\t\n876\t#ifdef DEBUG_SHOW_OPS\n877\tfprintf(stderr, \"\\n++ New frame: type=0x%x subject offset %ld\\n\",\n878\t  GF_IDMASK(Fgroup_frame_type), Feptr - mb->start_subject);\n879\t#endif\n880\t\n881\tfor (;;)\n882\t  {\n883\t#ifdef DEBUG_SHOW_OPS\n884\tfprintf(stderr, \"++ %2ld op=%3d %s\\n\", Fecode - mb->start_code, *Fecode,\n885\t  OP_names[*Fecode]);\n886\t#endif\n887\t\n888\t  Fop = (uint8_t)(*Fecode);  /* C