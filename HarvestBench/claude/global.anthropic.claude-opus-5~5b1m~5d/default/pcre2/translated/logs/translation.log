t RM39: u32 = 39;\n125\tpub const RM100: u32 = 100;\n126\tpub const RM101: u32 = 101;\n127\tpub const RM102: u32 = 102;\n128\tpub const RM103: u32 = 103;\n129\tpub const RM200: u32 = 200;\n130\tpub const RM201: u32 = 201;\n131\tpub const RM202: u32 = 202;\n132\tpub const RM203: u32 = 203;\n133\tpub const RM204: u32 = 204;\n134\tpub const RM205: u32 = 205;\n135\tpub const RM206: u32 = 206;\n136\tpub const RM207: u32 = 207;\n137\tpub const RM208: u32 = 208;\n138\tpub const RM209: u32 = 209;\n139\tpub const RM210: u32 = 210;\n140\tpub const RM211: u32 = 211;\n141\tpub const RM212: u32 = 212;\n142\tpub const RM213: u32 = 213;\n143\tpub const RM214: u32 = 214;\n144\tpub const RM215: u32 = 215;\n145\tpub const RM216: u32 = 216;\n146\tpub const RM217: u32 = 217;\n147\tpub const RM218: u32 = 218;\n148\tpub const RM219: u32 = 219;\n149\tpub const RM220: u32 = 220;\n150\tpub const RM221: u32 = 221;\n151\tpub const RM222: u32 = 222;\n152\tpub const RM223: u32 = 223;\n153\tpub const RM224: u32 = 224;\n154\t\n155\t/* The structural labels of match(). */\n156\tpub const S_MATCH_RECURSE: u32 = 900;\n157\tpub const S_NEW_FRAME: u32 = 901;\n158\tpub const S_MAINLOOP: u32 = 902;\n159\tpub const S_RETURN_SWITCH: u32 = 903;\n160\t\n161\t/* Ordinary labels inside the big switch, which are jumped to from more than one\n162\tplace (C line numbers in comments). */\n163\tpub const L_REPEATCHAR: u32 = 910; /* 1392 */\n164\tpub const L_REPEATNOTCHAR: u32 = 911; /* 1733 */\n165\tpub const L_REPEATTYPE: u32 = 912; /* 2973 */\n166\tpub const L_REF_REPEAT: u32 = 913; /* 5278 */\n167\tpub const L_POSSESSIVE_NON_CAPTURE: u32 = 914; /* 5545 */\n168\tpub const L_POSSESSIVE_CAPTURE: u32 = 915; /* 5553 */\n169\tpub const L_POSSESSIVE_GROUP: u32 = 916; /* 5557 */\n170\tpub const L_GROUPLOOP: u32 = 917; /* 5676 */\n171\tpub const L_ASSERT_NOT_FAILED: u32 = 918; /* 5853 */\n172\tpub const L_ASSERT_NL_OR_EOS: u32 = 919; /* 6604 */\n173\tpub const L_SCS_OFFSET_FOUND: u32 = 920; /* 5907 */\n174\t\n175\t// <<