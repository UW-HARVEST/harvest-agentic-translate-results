                     as BOOL;\n1208\t\n1209\t                                                /* It appears that Perl allows any\n1210\t                                                characters whatsoever, other than a\n1211\t                                                closing parenthesis, to appear in\n1212\t                                                arguments (\"names\"). We set inverbname\n1213\t                                                TRUE here, and let the main loop take\n1214\t                                                care of this. */\n1215\t\n1216\t                                                if {\n1217\t                                                    let t = *ptr as u32;\n1218\t                                                    ptr = ptr.add(1);\n1219\t                                                    t == CHAR_COLON\n1220\t                                                } {\n1221\t                                                    /* Skip past : or ) */\n1222\t\n1223\t                                                    /* Some optional arguments can be\n1224\t                                                    treated as a preceding (*MARK) */\n1225\t\n1226\t                                                    if verbs[i as usize].has_arg < 0 {\n1227\t                                                        add_after_mark =\n1228\t                                                            verbs[i as usize].meta;\n1229\t                                                        PUTPP!(parsed_pattern, META_MARK);\n1230\t                                                    }\n1231\t                                                    /* The remaining verbs with arguments\n1232\t                                                    (except *MARK) need a different\n1233\t                                                    opcode. */\n1234\t                                                    else {\n1235\t                                 