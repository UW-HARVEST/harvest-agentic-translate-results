range check.\n#[macro_export]\nmacro_rules! TABLE_GET {\n    ($c:expr, $table:expr, $default:expr) => {\n        *$table.add($c as usize)\n    };\n}\n\n/// MAX_255(c) is TRUE in 8-bit mode.\n#[macro_export]\nmacro_rules! MAX_255 {\n    ($c:expr) => {\n        1\n    };\n}\n\n/// CHMAX_255(c): c <= 255 (8-bit mode with Unicode support).\nerror.rs:263:        return PCRE2_ERROR_NOMEMORY;\nerror.rs:299:            rc = PCRE2_ERROR_NOMEMORY;\nconsts.rs:251:pub const PCRE2_ERROR_DFA_BADRESTART: i32 = -38;\nconsts.rs:256:pub const PCRE2_ERROR_DFA_WSSIZE: i32 = -43;\nconsts.rs:261:pub const PCRE2_ERROR_NOMEMORY: i32 = -48;\nconsts.rs:270:pub const PCRE2_ERROR_BADOFFSETLIMIT: i32 = -56;\nconsts.rs:277:pub const PCRE2_ERROR_HEAPLIMIT: i32 = -63;\nconsts.rs:280:pub const PCRE2_ERROR_DFA_UINVALID_UTF: i32 = -66;\nconsts.rs:421:pub const LINK_SIZE: usize = 2;\nconsts.rs:429:pub const IMM2_SIZE: usize = 2;","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01MgHw9z6wwWDPFxbZh9QvCu","session_id":"6b19aa16-17c8-42f3-a300-59c20a915dbc","uuid":"27f3a9e0-4071-442e-8159-26867b368c35","timestamp":"2026-08-31T06:18:10.378Z","subagent_type":"claude","task_description":"Translate dfa_match public part"}
