tconst S_POSITIVE_NONATOMIC_LOOK_AHEAD: u32 = 11;\n214\tconst S_NEGATIVE_LOOK_AHEAD: u32 = 12;\n215\tconst S_POST_LOOKBEHIND: u32 = 13;\n216\tconst S_POST_ASSERTION: u32 = 14;\n217\tconst S_DEFINE_NAME: u32 = 15;\n218\t\n219\t/* States for the class-content loop (labels CLASS_LITERAL and\n220\tCLASS_CONTINUE). */\n221\t\n222\tconst CL_TOP: u32 = 0;\n223\tconst CL_LITERAL: u32 = 1;\n224\tconst CL_CONTINUE: u32 = 2;\n225\t\n226\t/*************************************************\n227\t*      Parse regex and identify named groups     *\n228\t*************************************************/\n229\t\n230\t/* This function is called first of all. It scans the pattern and does two\n231\tthings: (1) It identifies capturing groups and makes a table of named capturing\n232\tgroups so that information about them is fully available to both the compiling\n233\tscans. (2) It writes a parsed version of the pattern with comments omitted and\n234\tescapes processed into the parsed_pattern vector.\n235\t\n236\tArguments:\n237\t  ptr             points to the start of the pattern\n238\t  options         compiling dynamic options (may change during the scan)\n239\t  has_lookbehind  points to a boolean, set TRUE if a lookbehind is found\n240\t  cb              pointer to the compile data block\n241\t\n242\tReturns:   zero on success or a non-zero error code, with the\n243\t             error offset placed in the cb field\n244\t*/\n245\t\n246\tpub(crate) unsafe fn parse_regex(\n247\t    mut ptr: PCRE2_SPTR,\n248\t    mut options: u32,\n249\t    mut xoptions: u32,\n250\t    has_lookbehind: *mut BOOL,\n251\t    cb: *mut compile_block,\n252\t) -> i32 {\n253\t    let mut c: u32 = 0;\n254\t    let mut delimiter: u32;\n255\t    let mut namelen: u32 = 0;\n256\t    let mut class_range_state: u32 = 0;\n257\t    let mut class_op_state: u32 = 0;\n258\t    let mut class_mode_state: u32 = 0;\n259\t    let mut class_start: *mut u32 = core::ptr::null_mut();\n260\t    let mut verblengthptr: *mut u32 = core::ptr::null_mut(); /* Value avoids compiler warning */\n261\t    let mut verbstartptr: *mut u32 = core::ptr::null_mut();\n262\t    let mut previous_callout: *mut u32 = core::ptr::null_mut();\n263\t    let mut parsed_pattern: *mut u32 = (*cb).parsed_pattern;\n264\t    let parsed_pattern_end: *mut u32 = (*cb).parsed_pattern_end;\n265\t    let mut this_parsed_item: *mut u32 = core::ptr::null_mut();\n266\t    let mut prev_parsed_item: *mut u32 = core::ptr::null_mut();\n267\t    let mut meta_quantifier: u32 = 0;\n268\t    let mut add_after_mark: u32 = 0;\n269\t    let mut nest_depth: u16 = 0;\n270\t    let mut class_depth_m1: i16 = -1; /* The m1 means minus 1. */\n271\t    let mut class_maxdepth_m1: i16 = -1;\n272\t    let mut hash: u16 = 0;\n273\t    let mut after_manual_callout: i32 = 0;\n274\t    let mut expect_cond_assert: i32 = 0;\n275\t    let mut errorcode: i32 = 0;\n276\t    let mut escape: i32 = 0;\n277\t    let mut i: i32 = 0;\n278\t    let mut inescq: BOOL = FALSE;\n279\t    let mut inverbname: BOOL = FALSE;\n280\t    let utf: BOOL = ((options & PCRE2_UTF) != 0) as BOOL;\n281\t    let auto_callout: BOOL = ((options & PCRE2_AUTO_CALLOUT) != 0) as BOOL;\n282\t    let mut is_dupname: BOOL = FALSE;\n283\t    let mut negate_class: BOOL = FALSE;\n284\t    let mut okquantifier: BOOL = FALSE;\n285\t    let mut thisptr: PCRE2_SPTR = core::ptr::null();\n286\t    let mut name: PCRE2_SPTR = core::ptr::null();\n287\t    let ptrend: PCRE2_SPTR = (*cb).end_pattern;\n288\t    let mut verbnamestart: PCRE2_SPTR = core::ptr::null(); /* Value avoids compiler warning */\n289\t    let mut class_range_forbid_ptr: PCRE2_SPTR = core::ptr::null();\n290\t    let mut ng: *mut named_group = core::ptr::null_mut();\n291\t    let mut top_nest: *mut nest_save = core::ptr::null_mut();\n292\t    let mut end_nests: *mut nest_save = core::ptr::null_mut();\n293\t\n294\t    /* Emulation of the trailing FAILED_BACK / FAILED_FORWARD labels: 0 means\n295\t    \"come to FAILED directly\", 1 means FAILED_BACK, 2 means FAILED_FORWARD. */\n296\t    let mut fail_mode: i32 = 0;\n297\t\n298\t    /* PCRE2_ASSERT(parsed_pattern != NULL); */\n299\t\n300\t    'failed: {\n301\t        'unclosed_parenthesis: {\n302\t            'parsed_end: {\n303\t                /* Insert leading items for word and line matching (features provided\n304\t                for the benefit of pcre2grep). */\n305\t\n306\t                if (xoptions & PCRE2_EXTRA_MATCH_LINE) != 0 {\n307\t                    PUTPP!(parsed_pattern, META_CIRCUMFLEX);\n308\t                    PUTPP!(parsed_pattern, META_NOCAPTURE);\n309\t                } else if (xoptions & PCRE2_EXTRA_MATCH_WORD) != 0 {\n310\t                    PUTPP!(parsed_pattern, META_ESCAPE + ESC_b);\n311\t                    PUTPP!(parsed_pattern, META_NOCAPTURE);\n312\t                }\n313\t\n314\t                /* If the pattern is actually a literal string, process it separately\n315\t                to avoid cluttering up the main loop. */\n316\t\n317\t                if (options & PCRE2_LITERAL) != 0 {\n318\t                    while ptr < ptrend {\n319\t                        /* LCOV_EXCL_START */\n320\t                        if parsed_pattern >= parsed_pattern_end {\n321\t                            errorcode = ERR63; /* Internal error (parsed pattern overflow) */\n322\t                            break 'failed; /* goto FAILED */\n323\t                        }\n324\t                        /* LCOV_EXCL_STOP */\n325\t\n326\t                        thisptr = ptr;\n327\t                        GETCHARINCTEST!(c, ptr, utf);\n328\t                        if auto_callout != 0 {\n329\t                            parsed_pattern = manage_callouts(\n330\t                                thisptr,\n331\t                                &mut previous_callout,\n332\t                                auto_callout,\n333\t                                parsed_pattern,\n334\t                                cb,\n335\t                            );\n336\t                        }\n337\t                        PARSED_LITERAL!(c, parsed_pattern, okquantifier);\n338\t                    }\n339\t                    break 'parsed_end; /* goto PARSED_END */\n340\t                }\n341\t\n342\t                /* Process a real regex which may contain meta-characters. */\n343\t\n344\t                top_nest = core::ptr::null_mut();\n345\t                end_nests =\n346\t                    (*cb).start_workspace.add((*cb).workspace_size) as *mut nest_save;\n347\t\n348\t                /* The size of the nest_save structure might not be a factor of the\n349\t                size of the workspace. Therefore we must round down end_nests so as to\n350\t                correctly avoid creating a nest_save that spans the end of the\n351\t                workspace. */\n352\t\n353\t                end_nests = (end_nests as *mut c_char).sub(\n354\t                    ((*cb).workspace_size * core::mem::size_of::<PCRE2_UCHAR>())\n355\t                        % core::mem::size_of::<nest_save>(),\n356\t                ) as *mut nest_save;\n357\t\n358\t                /* PCRE2_EXTENDED_MORE implies PCRE2_EXTENDED */\n359\t\n360\t                if (options & PCRE2_EXTENDED_MORE) != 0 {\n361\t                    options |= PCRE2_EXTENDED;\n362\t                }\n363\t\n364\t                /* Now scan the pattern */\n365\t\n366\t                'mainloop: while ptr < ptrend {\n367\t                    let mut prev_expect_cond_assert: i32;\n368\t                    let mut min_repeat: u32 = 0;\n369\t                    let mut max_repeat: u32 = 0;\n370\t                    let mut set: u32 = 0;\n371\t                    let mut unset: u32 = 0;\n372\t                    /* `optset`/`xoptset` are `uint32_t *` in C, pointing at either\n373\t                    `set`/`unset` (resp. `xset`/`xunset`). */\n374\t                    let mut optset: *mut u32 = core::ptr::null_mut();\n375\t                    let mut xset: u32 = 0;\n376\t                    let mut xunset: u32 = 0;\n377\t                    let mut xoptset: *mut u32 = core::ptr::null_mut();\n378\t                    let mut terminator: u32 = 0;\n379\t                    let mut prev_meta_quantifier: u32 = 0;\n380\t                    let mut prev_okquantifier: BOOL = FALSE;\n381\t                    let mut tempptr: PCRE2_SPTR = core::ptr::null();\n382\t                    let mut offset: PCRE2_SIZE = 0;\n383\t\n384\t                    if nest_depth as u32 > (*(*cb).cx).parens_nest_limit {\n385\t                        errorcode = ERR19;\n386\t                        break 'failed; /* goto FAILED - Parentheses too deeply nested */\n387\t                    }\n388\t\n389\t                    /* Check that we haven't emitted too much into parsed_pattern. */\n390\t\n391\t                    /* LCOV_EXCL_START */\n392\t                    if parsed_pattern >= parsed_pattern_end {\n393\t                        errorcode = ERR63; /* Internal error (parsed pattern overflow) */\n394\t                        break 'failed; /* goto FAILED */\n395\t                    }\n396\t                    /* LCOV_EXCL_STOP */\n397\t\n398\t                    /* If the last time round this loop something was added,\n399\t                    parsed_pattern will no longer be equal to this_parsed_item.\n400\t                    Remember where the previous item started and reset for the next\n401\t                    item. */\n402\t\n403\t                    if this_parsed_item != parsed_pattern {\n404\t                        prev_parsed_item = this_parsed_item;\n405\t                        this_parsed_item = parsed_pattern;\n406\t                    }\n407\t\n408\t                    /* Get next input character, save its position for callout\n409\t                    handling. */\n410\t\n411\t                    thisptr = ptr;\n412\t                    GETCHARINCTEST!(c, ptr, utf);\n413\t\n414\t                    /* Copy quoted literals until \\E, allowing for the possibility of\n415\t                    automatic callouts, except when processing a (*VERB) \"name\". */\n416\t\n417\t                    if inescq != 0 {\n418\t                        if c == CHAR_BACKSLASH && ptr < ptrend && *ptr as u32 == CHAR_E {\n419\t                            inescq = FALSE;\n420\t                            ptr = ptr.add(1); /* Skip E */\n421\t                        } else {\n422\t                            if inverbname != 0 {\n423\t                                /* Don't use PARSED_LITERAL() because it sets\n424\t                                okquantifier. */\n425\t                                PUTPP!(parsed_pattern, c);\n426\t                            } else {\n427\t                                if {\n428\t                                    let t = after_manual_callout;\n429\t                                    after_manual_callout -= 1;\n430\t                                    t <= 0\n431\t                                } {\n432\t                                    parsed_pattern = manage_callouts(\n433\t                                        thisptr,\n434\t                                        &mut previous_callout,\n435\t                                        auto_callout,\n436\t                                        parsed_pattern,\n437\t                                        cb,\n438\t                                    );\n439\t                                }\n440\t                                PARSED_LITERAL!(c, parsed_pattern, okquantifier);\n441\t                            }\n442\t                            meta_quantifier = 0;\n443\t                        }\n444\t                        continue 'mainloop; /* Next character */\n445\t                    }\n446\t\n447\t                    /* If we are processing the \"name\" part of a (*VERB:NAME) item,\n448\t                    all characters up to the closing parenthesis are literals except\n449\t                    when PCRE2_ALT_VERBNAMES is set. */\n450\t\n451\t                    if inverbname != 0\n452\t                        && (\n453\t                            /* EITHER: not both options set */\n454\t                            ((options & (PCRE2_EXTENDED | PCRE2_ALT_VERBNAMES))\n455\t                                != (PCRE2_EXTENDED | PCRE2_ALT_VERBNAMES))\n456\t                                /* OR: character > 255 AND not Unicode Pattern White Space */\n457\t                                || (c > 255 && (c | 1) != 0x200f && (c | 1) != 0x2029)\n458\t                                /* OR: not a # comment or isspace() white space */\n459\t                                || (c < 256\n460\t                                    && c != CHAR_NUMBER_SIGN\n461\t                                    && (*(*cb).ctypes.add(c as usize) & ctype_space) == 0\n462\t                                    /* and not CHAR_NEL when Unicode is supported */\n463\t                                    && c != CHAR_NEL)\n464\t                        )\n465\t                    {\n466\t                        let mut verbnamelength: PCRE2_SIZE;\n467\t\n468\t                        match c {\n469\t                            CHAR_RIGHT_PARENTHESIS => {\n470\t                                inverbname = FALSE;\n471\t                                /* This is the length in characters */\n472\t                                verbnamelength =\n473\t                                    (parsed_pattern.offset_from(verblengthptr) - 1) as PCRE2_SIZE;\n474\t                                /* But the limit on the length is in code units */\n475\t                                if ptr.offset_from(verbnamestart) - 1 > MAX_MARK as i32 as isize {\n476\t                                    ptr = ptr.wrapping_sub(1);\n477\t                                    errorcode = ERR76;\n478\t                                    break 'failed; /* goto FAILED */\n479\t                                }\n480\t                                *verblengthptr = verbnamelength as u32;\n481\t\n482\t                                /* If this name was on a verb such as (*ACCEPT) which\n483\t                                does not continue, a (*MARK) was generated for the\n484\t                                name. We now add the original verb as the next item. */\n485\t\n486\t                                if add_after_mark != 0 {\n487\t                                    PUTPP!(parsed_pattern, add_after_mark);\n488\t                                    add_after_mark = 0;\n489\t                                }\n490\t                            }\n491\t\n492\t                            CHAR_BACKSLASH => {\n493\t                                if (options & PCRE2_ALT_VERBNAMES) != 0 {\n494\t                                    escape = _pcre2_check_escape_8(\n495\t                                        &mut ptr,\n496\t                                        ptrend,\n497\t                                        &mut c,\n498\t                                        &mut errorcode,\n499\t                                        options,\n500\t                                        xoptions,\n501\t                                        (*cb).bracount,\n502\t                                        FALSE,\n503\t                                        cb,\n504\t                                    );\n505\t                                    if errorcode != 0 {\n506\t                                        break 'failed; /* goto FAILED */\n507\t                                    }\n508\t                                } else {\n509\t                                    escape = 0; /* Treat all as literal */\n510\t                                }\n511\t\n512\t                                match escape as u32 {\n513\t                                    0 => {\n514\t                                        /* Don't use PARSED_LITERAL() because it sets\n515\t                                        okquantifier. */\n516\t                                        PUTPP!(parsed_pattern, c);\n517\t                                    }\n518\t\n519\t                                    ESC_ub => {\n520\t                                        PUTPP!(parsed_pattern, CHAR_u);\n521\t                                        PARSED_LITERAL!(\n522\t                                            CHAR_LEFT_CURLY_BRACKET,\n523\t                                            parsed_pattern,\n524\t                                            okquantifier\n525\t                                        );\n526\t                                    }\n527\t\n528\t                                    ESC_Q => {\n529\t                                        inescq = TRUE;\n530\t                                    }\n531\t\n532\t                                    ESC_E => { /* Ignore */ }\n533\t\n534\t                                    _ => {\n535\t                                        errorcode = ERR40; /* Invalid in verb name */\n536\t                                        break 'failed; /* goto FAILED */\n537\t                                    }\n538\t                                }\n539\t                            }\n540\t\n541\t                            _ => {\n542\t                                /* Don't use PARSED_LITERAL() because it sets\n543\t                                okquantifier. */\n544\t                                PUTPP!(parsed_pattern, c);\n545\t                            }\n546\t                        }\n547\t                        continue 'mainloop; /* Next character in pattern */\n548\t                    }\n549\t\n550\t                    /* Not a verb name character. At this point we must process\n551\t                    everything that must not change the quantification state. */\n552\t\n553\t                    if c == CHAR_BACKSLASH && ptr < ptrend {\n554\t                        if *ptr as u32 == CHAR_Q || *ptr as u32 == CHAR_E {\n555\t                            /* A literal inside a \\Q...\\E is not allowed if we are\n556\t                            expecting a conditional assertion, but an empty \\Q\\E\n557\t                            sequence is OK. */\n558\t                            if expect_cond_assert > 0\n559\t                                && *ptr as u32 == CHAR_Q\n560\t                                && !(ptrend.offset_from(ptr) >= 3\n561\t                                    && *ptr.add(1) as u32 == CHAR_BACKSLASH\n562\t                                    && *ptr.add(2) as u32 == CHAR_E)\n563\t                            {\n564\t                                ptr = ptr.wrapping_sub(1);\n565\t                                errorcode = ERR28;\n566\t                                break 'failed; /* goto FAILED */\n567\t                            }\n568\t                            inescq = (*ptr as u32 == CHAR_Q) as BOOL;\n569\t                            ptr = ptr.add(1);\n570\t                            continue 'mainloop;\n571\t                        }\n572\t                    }\n573\t\n574\t                    /* Skip over whitespace and # comments in extended mode. */\n575\t\n576\t                    if (options & PCRE2_EXTENDED) != 0 {\n577\t                        if c < 256 && (*(*cb).ctypes.add(c as usize) & ctype_space) != 0 {\n578\t                            continue 'mainloop;\n579\t                        }\n580\t                        if c == CHAR_NEL || (c | 1) == 0x200f || (c | 1) == 0x2029 {\n581\t                            continue 'mainloop;\n582\t                        }\n583\t                        if c == CHAR_NUMBER_SIGN {\n584\t                            while ptr < ptrend {\n585\t                                if IS_NEWLINE!(ptr, cb, utf) != 0 {\n586\t                                    /* For non-fixed-length newline cases, IS_NEWLINE\n587\t                                    sets cb->nllen. */\n588\t                                    ptr = ptr.add((*cb).nllen as usize);\n589\t                                    break;\n590\t                                }\n591\t                                ptr = ptr.add(1);\n592\t                                if utf != 0 {\n593\t                                    FORWARDCHARTEST!(ptr, ptrend);\n594\t                                }\n595\t                            }\n596\t                            continue 'mainloop; /* Next character in pattern */\n597\t                        }\n598\t                    }\n599\t\n600\t                    /* Skip over bracketed comments */\n601\t\n602\t                    if c == CHAR_LEFT_PARENTHESIS\n603\t                        && ptrend.offset_from(ptr) >= 2\n604\t                        && *ptr.add(0) as u32 == CHAR_QUESTION_MARK\n605\t                        && *ptr.add(1) as u32 == CHAR_NUMBER_SIGN\n606\t                    {\n607\t                        loop {\n608\t                            ptr = ptr.add(1);\n609\t                            if !(ptr < ptrend && *ptr as u32 != CHAR_RIGHT_PARENTHESIS) {\n610\t                                break;\n611\t                            }\n612\t                        }\n613\t                        if ptr >= ptrend {\n614\t                            errorcode = ERR18; /* A special error for missing ) in a comment */\n615\t                            break 'failed; /* goto FAILED - to make it easier to debug. */\n616\t                        }\n617\t                        ptr = ptr.add(1);\n618\t                        continue 'mainloop; /* Next character in pattern */\n619\t                    }\n620\t\n621\t                    /* If the next item is not a quantifier, fill in length of any\n622\t                    previous callout and create an auto callout if required. */\n623\t\n624\t                    if c != CHAR_ASTERISK\n625\t                        && c != CHAR_PLUS\n626\t                        && c != CHAR_QUESTION_MARK\n627\t                        && (c != CHAR_LEFT_CURLY_BRACKET\n628\t                            || {\n629\t                                tempptr = ptr;\n630\t                                read_repeat_counts(\n631\t                                    &mut tempptr,\n632\t                                    ptrend,\n633\t                                    core::ptr::null_mut(),\n634\t                                    core::ptr::null_mut(),\n635\t                                    &mut errorcode,\n636\t                                ) == 0\n637\t                            })\n638\t                    {\n639\t                        if {\n640\t                            let t = after_manual_callout;\n641\t                            after_manual_callout -= 1;\n642\t                            t <= 0\n643\t                        } {\n644\t                            parsed_pattern = manage_callouts(\n645\t                                thisptr,\n646\t                                &mut previous_callout,\n647\t                                auto_callout,\n648\t                                parsed_pattern,\n649\t                                cb,\n650\t                            );\n651\t                            this_parsed_item = parsed_pattern; /* New start for current item */\n652\t                        }\n653\t                    }\n654\t\n655\t                    /* If expect_cond_assert is 2, we have just passed (?( and are\n656\t                    expecting an assertion, possibly preceded by a callout. */\n657\t\n658\t                    if expect_cond_assert > 0 {\n659\t                        let mut ok: BOOL = (c == CHAR_LEFT_PARENTHESIS\n660\t                            && ptrend.offset_from(ptr) >= 3\n661\t                            && (*ptr.add(0) as u32 == CHAR_QUESTION_MARK\n662\t                                || *ptr.add(0) as u32 == CHAR_ASTERISK))\n663\t                            as BOOL;\n664\t                        if ok != 0 {\n665\t                            if *ptr.add(0) as u32 == CHAR_ASTERISK {\n666\t                                /* New alpha assertion format, possibly */\n667\t                                ok = (MAX_255!(*ptr.add(1)) != 0\n668\t                                    && (*(*cb).ctypes.add(*ptr.add(1) as usize)\n669\t                                        & ctype_lcletter)\n670\t                                        != 0) as BOOL;\n671\t                            } else {\n672\t                                match *ptr.add(1) as u32 {\n673\t                                    /* Traditional symbolic format */\n674\t                                    CHAR_C => {\n675\t                                        ok = (expect_cond_assert == 2) as BOOL;\n676\t                                    }\n677\t\n678\t                                    CHAR_EQUALS_SIGN | CHAR_EXCLAMATION_MARK => {}\n679\t\n680\t                                    CHAR_LESS_THAN_SIGN => {\n681\t                                        ok = (*ptr.add(2) as u32 == CHAR_EQUALS_SIGN\n682\t                                            || *ptr.add(2) as u32 == CHAR_EXCLAMATION_MARK)\n683\t                                            as BOOL;\n684\t                                    }\n685\t\n686\t                                    _ => {\n687\t                                        ok = FALSE;\n688\t                                    }\n689\t                                }\n690\t                            }\n691\t                        }\n692\t\n693\t                        if ok == 0 {\n694\t                            errorcode = ERR28;\n695\t                            if expect_cond_assert == 2 {\n696\t                                break 'failed; /* goto FAILED */\n697\t                            }\n698\t                            fail_mode = 1;\n699\t                            break 'failed; /* goto FAILED_BACK */\n700\t                        }\n701\t                    }\n702\t\n703\t                    /* Remember whether we are expecting a conditional assertion, and\n704\t                    set the default for this item. */\n705\t\n706\t                    prev_expect_cond_assert = expect_cond_assert;\n707\t                    expect_cond_assert = 0;\n708\t\n709\t                    /* Remember quantification status for the previous significant\n710\t                    item, then set default for this item. */\n711\t\n712\t                    prev_okquantifier = okquantifier;\n713\t                    prev_meta_quantifier = meta_quantifier;\n714\t                    okquantifier = FALSE;\n715\t                    meta_quantifier = 0;\n716\t\n717\t                    /* If the previous significant item was a quantifier, adjust the\n718\t                    parsed code if there is a following modifier. */\n719\t\n720\t                    if prev_meta_quantifier != 0\n721\t                        && (c == CHAR_QUESTION_MARK || c == CHAR_PLUS)\n722\t                    {\n723\t                        *parsed_pattern.offset(if prev_meta_quantifier == META_MINMAX {\n724\t                            -3\n725\t                        } else {\n726\t                            -1\n727\t                        }) = prev_meta_quantifier\n728\t                            + (if c == CHAR_QUESTION_MARK {\n729\t                                0x00020000u32\n730\t                            } else {\n731\t                                0x00010000u32\n732\t                            });\n733\t                        continue 'mainloop; /* Next character in pattern */\n734\t                    }\n735\t\n736\t                    /* Process the next item in the main part of a pattern. */\n737\t\n738\t                    let mut istate: u32 = S_SWITCH;\n739\t                    'isw: loop {\n740\t                        match istate {\n741\t                            /* ---- switch(c) ---- */\n742\t                            S_SWITCH => {\n743\t                                match c {\n744\t                                    /* ---- Escape sequence ---- */\n745\t                                    CHAR_BACKSLASH => {\n746\t                                        tempptr = ptr;\n747\t                                        escape = _pcre2_check_escape_8(\n748\t                                            &mut ptr,\n749\t                                            ptrend,\n750\t                                            &mut c,\n751\t                                            &mut errorcode,\n752\t                                            options,\n753\t                                            xoptions,\n754\t                                            (*cb).bracount,\n755\t                                            FALSE,\n756\t                                            cb,\n757\t                                        );\n758\t                                        if errorcode != 0 {\n759\t                                            /* falls into the ESCAPE_FAILED label */\n760\t                                            istate = S_ESCAPE_FAILED;\n761\t                                            continue 'isw;\n762\t                                        }\n763\t                                        istate = S_ESCAPE_TAIL;\n764\t                                        continue 'isw;\n765\t                                    }\n766\t\n767\t                                    /* ---- Single-character special items ---- */\n768\t                                    CHAR_CIRCUMFLEX_ACCENT => {\n769\t                                        PUTPP!(parsed_pattern, META_CIRCUMFLEX);\n770\t                                    }\n771\t\n772\t                                    CHAR_DOLLAR_SIGN => {\n773\t                                        PUTPP!(parsed_pattern, META_DOLLAR);\n774\t                                    }\n775\t\n776\t                                    CHAR_DOT => {\n777\t                                        PUTPP!(parsed_pattern, META_DOT);\n778\t            