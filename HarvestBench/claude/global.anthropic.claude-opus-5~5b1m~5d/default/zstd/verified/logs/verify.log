{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FrcCNhm62rP7EQJgJQxLe5","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH shared libraries via `libloading` and exposes them side by side so\n4\t//! every test calls the C and the Rust implementation through the *same* FFI\n5\t//! surface an external consumer would use. The Rust crate is never linked\n6\t//! directly — only its `cdylib` exports are exercised.\n7\t//!\n8\t//! Build prerequisites (see `run_tests.sh`):\n9\t//!   * `c_src/build/libzstd.so`            (cmake)\n10\t//!   * `translation/target/release/libzstd.so` (cargo build --release)\n11\t\n12\t#![allow(dead_code)]\n13\t#![allow(non_upper_case_globals)]\n14\t#![allow(non_snake_case)]\n15\t#![allow(non_camel_case_types)]\n16\t\n17\tuse libloading::{Library, Symbol};\n18\tuse std::path::PathBuf;\n19\tuse std::sync::OnceLock;\n20\t\n21\t// ---------------------------------------------------------------- library pair\n22\t\n23\tpub struct Impls {\n24\t    pub c: Library,\n25\t    pub rs: Library,\n26\t}\n27\t\n28\tfn workspace_root() -> PathBuf {\n29\t    // CARGO_MANIFEST_DIR == <root>/translation\n30\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n31\t        .parent()\n32\t        .expect(\"translation/ has a parent\")\n33\t        .to_path_buf()\n34\t}\n35\t\n36\tfn load() -> Impls {\n37\t    let root = workspace_root();\n38\t    let c_path = root.join(\"c_src/build/libzstd.so\");\n39\t    let rs_path = root.join(\"translation/target/release/libzstd.so\");\n40\t\n41\t    for p in [&c_path, &rs_path] {\n42\t        assert!(\n43\t            p.exists(),\n44\t            \"missing shared library {}\\nrun ./run_tests.sh (it builds both) first\",\n45\t            p.display()\n46\t        );\n47\t    }\n48\t\n49\t    unsafe {\n50\t        Impls {\n51\t            c: Library::new(&c_path).unwrap_or_else(|e| panic!(\"dlopen {}: {e}\", c_path.display())),\n52\t            rs: Library::new(&rs_path)\n53\t                .unwrap_or_else(|e| panic!(\"dlopen {}: {e}\", rs_path.display())),\n54\t        }\n55\t    }\n56\t}\n57\t\n58\t/// Process-wide singleton so the two libraries are `dlopen`ed exactly once.\n59\tpub fn impls() -> &'static Impls {\n60\t    static I: OnceLock<Impls> = OnceLock::new();\n61\t    I.get_or_init(load)\n62\t}\n63\t\n64\timpl Impls {\n65\t    /// Fetch the same symbol from both libraries.\n66\t    ///\n67\t    /// Panics with a clear message if either library is missing it, which makes\n68\t    /// symbol-parity gaps show up as test failures rather than silent skips.\n69\t    pub fn pair<T>(&self, name: &str) -> (Symbol<'_, T>, Symbol<'_, T>) {\n70\t        let cname = std::ffi::CString::new(name).unwrap();\n71\t        unsafe {\n72\t            let c: Symbol<T> = self\n73\t                .c\n74\t                .get(cname.as_bytes_with_nul())\n75\t                .unwrap_or_else(|e| panic!(\"C .so is missing symbol `{name}`: {e}\"));\n76\t            let r: Symbol<T> = self\n77\t                .rs\n78\t                .get(cname.as_bytes_with_nul())\n79\t                .unwrap_or_else(|e| panic!(\"Rust .so is missing symbol `{name}`: {e}\"));\n80\t            (c, r)\n81\t        }\n82\t    }\n83\t\n84\t    pub fn has(&self, name: &str) -> bool {\n85\t        let cname = std::ffi::CString::new(name).unwrap();\n86\t        unsafe {\n87\t            self.c\n88\t                .get::<*const ()>(cname.as_bytes_with_nul())\n89\t                .is_ok()\n90\t                && self\n91\t                    .rs\n92\t                    .get::<*const ()>(cname.as_bytes_with_nul())\n93\t                    .is_ok()\n94\t        }\n95\t    }\n96\t}\n97\t\n98\t/// Convenience: bind one `extern \"C\"` fn signature from both libs.\n99\t///\n100\t/// ```ignore\n101\t/// let (c, r) = sym!(i.pair::<unsafe extern \"C\" fn() -> u32>(\"ZSTD_versionNumber\"));\n102\t/// ```\n103\t#[macro_export]\n104\tmacro_rules! sym {\n105\t    ($e:expr) => {\n106\t        $e\n107\t    };\n108\t}\n109\t\n110\t// ------------------------------------------------------------------- rng (PRNG)\n111\t\n112\t/// Deterministic xoshiro-style PRNG so every randomized row is reproducible\n113\t/// from its seed. Deliberately not `rand` — keeps dev-dependencies to\n114\t/// `libloading` only.\n115\tpub struct Rng(u64);\n116\t\n117\timpl Rng {\n118\t    pub fn new(seed: u64) -> Self {\n119\t        // splitmix64 warm-up so low seeds still give well-mixed state\n120\t        Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1)\n121\t    }\n122\t\n123\t    pub fn next_u64(&mut self) -> u64 {\n124\t        let mut z = self.0;\n125\t        z ^= z >> 12;\n126\t        z ^= z << 25;\n127\t        z ^= z >> 27;\n128\t        self.0 = z;\n129\t        z.wrapping_mul(0x2545_F491_4F6C_DD1D)\n130\t    }\n131\t\n132\t    pub fn next_u32(&mut self) -> u32 {\n133\t        (self.next_u64() >> 32) as u32\n134\t    }\n135\t\n136\t    pub fn below(&mut self, n: usize) -> usize {\n137\t        if n == 0 {\n138\t            0\n139\t        } else {\n140\t            (self.next_u64() % n as u64) as usize\n141\t        }\n142\t    }\n143\t\n144\t    pub fn range(&mut self, lo: usize, hi_incl: usize) -> usize {\n145\t        if hi_incl <= lo {\n146\t            lo\n147\t        } else {\n148\t            lo + self.below(hi_incl - lo + 1)\n149\t        }\n150\t    }\n151\t\n152\t    pub fn byte(&mut self) -> u8 {\n153\t        (self.next_u64() >> 24) as u8\n154\t    }\n155\t\n156\t    pub fn bool(&mut self) -> bool {\n157\t        self.next_u64() & (1 << 33) != 0\n158\t    }\n159\t}\n160\t\n161\t// --------------------------------------------------------------- input shapes\n162\t\n163\t/// The distinct input *shapes* `CONFIGS.md` enumerates. Each one drives the\n164\t/// compressor down a different family of code paths (RLE blocks, raw blocks,\n165\t/// huffman-coded literals, repeat-offset matches, ...).\n166\t#[derive(Copy, Clone, Debug, PartialEq, Eq)]\n167\tpub enum Shape {\n168\t    /// Every byte identical -> RLE blocks.\n169\t    Constant,\n170\t    /// Cryptographically-unfriendly random -> incompressible, raw blocks.\n171\t    Random,\n172\t    /// Small alphabet, skewed -> huffman-compressible literals.\n173\t    SkewedText,\n174\t    /// Long repeated pattern -> long matches, repeat offsets.\n175\t    Repetitive,\n176\t    /// Structured records -> regular offsets.\n177\t    Tabular,\n178\t    /// Mostly zeros with sparse noise.\n179\t    Sparse,\n180\t    /// Two alternating halves, tests window/offset behaviour.\n181\t    TwoPhase,\n182\t    /// Incrementing counter bytes.\n183\t    Counter,\n184\t}\n185\t\n186\tpub const ALL_SHAPES: [Shape; 8] = [\n187\t    Shape::Constant,\n188\t    Shape::Random,\n189\t    Shape::SkewedText,\n190\t    Shape::Repetitive,\n191\t    Shape::Tabular,\n192\t    Shape::Sparse,\n193\t    Shape::TwoPhase,\n194\t    Shape::Counter,\n195\t];\n196\t\n197\tpub fn gen_shape(shape: Shape, len: usize, rng: &mut Rng) -> Vec<u8> {\n198\t    let mut v = Vec::with_capacity(len);\n199\t    match shape {\n200\t        Shape::Constant => {\n201\t            let b = rng.byte();\n202\t            v.resize(len, b);\n203\t        }\n204\t        Shape::Random => {\n205\t            while v.len() < len {\n206\t                v.extend_from_slice(&rng.next_u64().to_le_bytes());\n207\t            }\n208\t            v.truncate(len);\n209\t        }\n210\t        Shape::SkewedText => {\n211\t            const AL: &[u8] = b\"aaaaabbbbcccdde fgh\\n\";\n212\t            for _ in 0..len {\n213\t                let i = rng.below(AL.len());\n214\t                v.push(AL[i]);\n215\t            }\n216\t        }\n217\t        Shape::Repetitive => {\n218\t            let plen = rng.range(1, 64);\n219\t            let mut pat = Vec::with_capacity(plen);\n220\t            for _ in 0..plen {\n221\t                pat.push(rng.byte());\n222\t            }\n223\t            while v.len() < len {\n224\t                let take = core::cmp::min(pat.len(), len - v.len());\n225\t                v.extend_from_slice(&pat[..take]);\n226\t            }\n227\t        }\n228\t        Shape::Tabular => {\n229\t            let mut n: u32 = rng.next_u32();\n230\t            while v.len() < len {\n231\t                let rec = format!(\"{:08x},{:05},row\\n\", n, n % 100_000);\n232\t                let take = core::cmp::min(rec.len(), len - v.len());\n233\t                v.extend_from_slice(&rec.as_bytes()[..take]);\n234\t                n = n.wrapping_add(1);\n235\t            }\n236\t        }\n237\t        Shape::Sparse => {\n238\t            v.resize(len, 0);\n239\t            let hits = len / 64 + 1;\n240\t            for _ in 0..hits {\n241\t                if len > 0 {\n242\t                    let i = rng.below(len);\n243\t                    v[i] = rng.byte();\n244\t                }\n245\t            }\n246\t        }\n247\t        Shape::TwoPhase => {\n248\t            let half = len / 2;\n249\t            for _ in 0..half {\n250\t                v.push(b'A' + (rng.below(4) as u8));\n251\t            }\n252\t            while v.len() < len {\n253\t                v.extend_from_slice(&rng.next_u32().to_le_bytes());\n254\t            }\n255\t            v.truncate(len);\n256\t        }\n257\t        Shape::Counter => {\n258\t            for i in 0..len {\n259\t                v.push((i & 0xff) as u8);\n260\t            }\n261\t        }\n262\t    }\n263\t    debug_assert_eq!(v.len(), len);\n264\t    v\n265\t}\n266\t\n267\t/// Interesting length boundaries: empty, one, sub-word, block edges, multi-block.\n268\tpub const EDGE_LENS: [usize; 18] = [\n269\t    0,\n270\t    1,\n271\t    2,\n272\t    3,\n273\t    7,\n274\t    8,\n275\t    9,\n276\t    15,\n277\t    16,\n278\t    31,\n279\t    64,\n280\t    127,\n281\t    128,\n282\t    1023,\n283\t    1024,\n284\t    65535,\n285\t    131_072,      // ZSTD_BLOCKSIZE_MAX\n286\t    131_073,      // one past a full block\n287\t];\n288\t\n289\t// ------------------------------------------------------------------ diff utils\n290\t\n291\t/// Byte-for-byte comparison with a readable first-divergence report.\n292\tpub fn assert_bytes_eq(ctx: &str, c: &[u8], r: &[u8]) {\n293\t    if c == r {\n294\t        return;\n295\t    }\n296\t    if c.len() != r.len() {\n297\t        panic!(\n298\t            \"{ctx}: length mismatch C={} Rust={}\\n C[..32]={:02x?}\\n R[..32]={:02x?}\",\n299\t            c.len(),\n300\t            r.len(),\n301\t            &c[..c.len().min(32)],\n302\t            &r[..r.len().min(32)]\n303\t        );\n304\t    }\n305\t    let at = c.iter().zip(r).position(|(a, b)| a != b).unwrap();\n306\t    let lo = at.saturating_sub(8);\n307\t    let hi = (at + 8).min(c.len());\n308\t    panic!(\n309\t        \"{ctx}: first byte divergence at {at} (len {})\\n C[{lo}..{hi}]={:02x?}\\n R[{lo}..{hi}]={:02x?}\",\n310\t        c.len(),\n311\t        &c[lo..hi],\n312\t        &r[lo..hi]\n313\t    );\n314\t}\n315\t\n316\tpub fn assert_eq_dbg<T: PartialEq + std::fmt::Debug>(ctx: &str, c: T, r: T) {\n317\t    assert!(c == r, \"{ctx}: C={c:?} Rust={r:?}\");\n318\t}\n319\t\n320\t// --------------------------------------------------------- zstd ABI constants\n321\t\n322\tpub const ZSTD_BLOCKSIZE_MAX: usize = 128 * 1024;\n323\tpub const ZSTD_CONTENTSIZE_UNKNOWN: u64 = u64::MAX - 0;\n324\tpub const ZSTD_CONTENTSIZE_ERROR: u64 = u64::MAX - 1;\n325\t\n326\t// ZSTD_ErrorCode (zstd_errors.h)\n327\tpub const ZSTD_error_no_error: i32 = 0;\n328\tpub const ZSTD_error_GENERIC: i32 = 1;\n329\tpub const ZSTD_error_prefix_unknown: i32 = 10;\n330\tpub const ZSTD_error_version_unsupported: i32 = 12;\n331\tpub const ZSTD_error_frameParameter_unsupported: i32 = 14;\n332\tpub const ZSTD_error_frameParameter_windowTooLarge: i32 = 16;\n333\tpub const ZSTD_error_corruption_detected: i32 = 20;\n334\tpub const ZSTD_error_checksum_wrong: i32 = 22;\n335\tpub const ZSTD_error_literals_headerWrong: i32 = 24;\n336\tpub const ZSTD_error_dictionary_corrupted: i32 = 30;\n337\tpub const ZSTD_error_dictionary_wrong: i32 = 32;\n338\tpub const ZSTD_error_dictionaryCreation_failed: i32 = 34;\n339\tpub const ZSTD_error_parameter_unsupported: i32 = 40;\n340\tpub const ZSTD_error_parameter_combination_unsupported: i32 = 41;\n341\tpub const ZSTD_error_parameter_outOfBound: i32 = 42;\n342\tpub const ZSTD_error_tableLog_tooLarge: i32 = 44;\n343\tpub const ZSTD_error_maxSymbolValue_tooLarge: i32 = 46;\n344\tpub const ZSTD_error_maxSymbolValue_tooSmall: i32 = 48;\n345\tpub const ZSTD_error_cannotProduce_uncompressedBlock: i32 = 49;\n346\tpub const ZSTD_error_stabilityCondition_notRespected: i32 = 50;\n347\tpub const ZSTD_error_stage_wrong: i32 = 60;\n348\tpub const ZSTD_error_init_missing: i32 = 62;\n349\tpub const ZSTD_error_memory_allocation: i32 = 64;\n350\tpub const ZSTD_error_workSpace_tooSmall: i32 = 66;\n351\tpub const ZSTD_error_dstSize_tooSmall: i32 = 70;\n352\tpub const ZSTD_error_srcSize_wrong: i32 = 72;\n353\tpub const ZSTD_error_dstBuffer_null: i32 = 74;\n354\tpub const ZSTD_error_noForwardProgress: i32 = 80;\n355\tpub const ZSTD_error_frameIndex_tooLarge: i32 = 100;\n356\tpub const ZSTD_error_seekableIO: i32 = 102;\n357\tpub const ZSTD_error_dstBuffer_wrong: i32 = 104;\n358\tpub const ZSTD_error_srcBuffer_wrong: i32 = 105;\n359\tpub const ZSTD_error_sequenceProducer_failed: i32 = 106;\n360\tpub const ZSTD_error_externalSequences_invalid: i32 = 107;\n361\t\n362\t// ZSTD_cParameter (zstd.h) — values are ABI, verified against the header.\n363\tpub const ZSTD_c_compressionLevel: i32 = 100;\n364\tpub const ZSTD_c_windowLog: i32 = 101;\n365\tpub const ZSTD_c_hashLog: i32 = 102;\n366\tpub const ZSTD_c_chainLog: i32 = 103;\n367\tpub const ZSTD_c_searchLog: i32 = 104;\n368\tpub const ZSTD_c_minMatch: i32 = 105;\n369\tpub const ZSTD_c_targetLength: i32 = 106;\n370\tpub const ZSTD_c_strategy: i32 = 107;\n371\tpub const ZSTD_c_targetCBlockSize: i32 = 130;\n372\tpub const ZSTD_c_enableLongDistanceMatching: i32 = 160;\n373\tpub const ZSTD_c_ldmHashLog: i32 = 161;\n374\tpub const ZSTD_c_ldmMinMatch: i32 = 162;\n375\tpub const ZSTD_c_ldmBucketSizeLog: i32 = 163;\n376\tpub const ZSTD_c_ldmHashRateLog: i32 = 164;\n377\tpub const ZSTD_c_contentSizeFlag: i32 = 200;\n378\tpub const ZSTD_c_checksumFlag: i32 = 201;\n379\tpub const ZSTD_c_dictIDFlag: i32 = 202;\n380\tpub const ZSTD_c_nbWorkers: i32 = 400;\n381\tpub const ZSTD_c_jobSize: i32 = 401;\n382\tpub const ZSTD_c_overlapLog: i32 = 402;\n383\t\n384\t// experimental cParams — values taken verbatim from the ZSTD_cParameter enum\n385\t// in c_src/src/include/zstd.h (ZSTD_c_experimentalParamN aliases).\n386\tpub const ZSTD_c_rsyncable: i32 = 500; // experimentalParam1\n387\tpub const ZSTD_c_format: i32 = 10; // experimentalParam2\n388\tpub const ZSTD_c_forceMaxWindow: i32 = 1000; // experimentalParam3\n389\tpub const ZSTD_c_forceAttachDict: i32 = 1001; // experimentalParam4\n390\tpub const ZSTD_c_literalCompressionMode: i32 = 1002; // experimentalParam5\n391\tpub const ZSTD_c_experimentalParam6: i32 = 1003; // (retired)\n392\tpub const ZSTD_c_srcSizeHint: i32 = 1004; // experimentalParam7\n393\tpub const ZSTD_c_enableDedicatedDictSearch: i32 = 1005; // experimentalParam8\n394\tpub const ZSTD_c_stableInBuffer: i32 = 1006; // experimentalParam9\n395\tpub const ZSTD_c_stableOutBuffer: i32 = 1007; // experimentalParam10\n396\tpub const ZSTD_c_blockDelimiters: i32 = 1008; // experimentalParam11\n397\tpub const ZSTD_c_validateSequences: i32 = 1009; // experimentalParam12\n398\tpub const ZSTD_c_splitAfterSequences: i32 = 1010; // experimentalParam13\n399\tpub const ZSTD_c_useRowMatchFinder: i32 = 1011; // experimentalParam14\n400\tpub const ZSTD_c_deterministicRefPrefix: i32 = 1012; // experimentalParam15\n401\tpub const ZSTD_c_prefetchCDictTables: i32 = 1013; // experimentalParam16\n402\tpub const ZSTD_c_enableSeqProducerFallback: i32 = 1014; // experimentalParam17\n403\tpub const ZSTD_c_maxBlockSize: i32 = 1015; // experimentalParam18\n404\tpub const ZSTD_c_repcodeResolution: i32 = 1016; // experimentalParam19\n405\tpub const ZSTD_c_searchForExternalRepcodes: i32 = 1016; // alias of the above\n406\tpub const ZSTD_c_blockSplitterLevel: i32 = 1017; // experimentalParam20\n407\t\n408\t// ZSTD_dParameter\n409\tpub const ZSTD_d_windowLogMax: i32 = 100;\n410\tpub const ZSTD_d_format: i32 = 1000; // experimentalParam1\n411\tpub const ZSTD_d_stableOutBuffer: i32 = 1001; // experimentalParam2\n412\tpub const ZSTD_d_forceIgnoreChecksum: i32 = 1002; // experimentalParam3\n413\tpub const ZSTD_d_refMultipleDDicts: i32 = 1003; // experimentalParam4\n414\tpub const ZSTD_d_disableHuffmanAssembly: i32 = 1004; // experimentalParam5\n415\tpub const ZSTD_d_maxBlockSize: i32 = 1005; // experimentalParam6\n416\t\n417\t// ZSTD_strategy\n418\tpub const ZSTD_fast: i32 = 1;\n419\tpub const ZSTD_dfast: i32 = 2;\n420\tpub const ZSTD_greedy: i32 = 3;\n421\tpub const ZSTD_lazy: i32 = 4;\n422\tpub const ZSTD_lazy2: i32 = 5;\n423\tpub const ZSTD_btlazy2: i32 = 6;\n424\tpub const ZSTD_btopt: i32 = 7;\n425\tpub const ZSTD_btultra: i32 = 8;\n426\tpub const ZSTD_btultra2: i32 = 9;\n427\tpub const ALL_STRATEGIES: [i32; 9] = [1, 2, 3, 4, 5, 6, 7, 8, 9];\n428\t\n429\t// ZSTD_format_e / ZSTD_ResetDirective / EndDirective\n430\tpub const ZSTD_f_zstd1: i32 = 0;\n431\tpub const ZSTD_f_zstd1_magicless: i32 = 1;\n432\tpub const ZSTD_reset_session_only: i32 = 1;\n433\tpub const ZSTD_reset_parameters: i32 = 2;\n434\tpub const ZSTD_reset_session_and_parameters: i32 = 3;\n435\tpub const ZSTD_e_continue: i32 = 0;\n436\tpub const ZSTD_e_flush: i32 = 1;\n437\tpub const ZSTD_e_end: i32 = 2;\n438\t\n439\t// ZSTD_literalCompressionMode_e / dictAttachPref / paramSwitch / SequenceFormat\n440\tpub const ZSTD_lcm_auto: i32 = 0;\n441\tpub const ZSTD_lcm_huffman: i32 = 1;\n442\tpub const ZSTD_lcm_uncompressed: i32 = 2;\n443\tpub const ZSTD_dictDefaultAttach: i32 = 0;\n444\tpub const ZSTD_dictForceAttach: i32 = 1;\n445\tpub const ZSTD_dictForceCopy: i32 = 2;\n446\tpub const ZSTD_dictForceLoad: i32 = 3;\n447\tpub const ZSTD_ps_auto: i32 = 0;\n448\tpub const ZSTD_ps_enable: i32 = 1;\n449\tpub const ZSTD_ps_disable: i32 = 2;\n450\tpub const ZSTD_sf_noBlockDelimiters: i32 = 0;\n451\tpub const ZSTD_sf_explicitBlockDelimiters: i32 = 1;\n452\t\n453\t// dictionary load method / content type\n454\tpub const ZSTD_dlm_byCopy: i32 = 0;\n455\tpub const ZSTD_dlm_byRef: i32 = 1;\n456\tpub const ZSTD_dct_auto: i32 = 0;\n457\tpub const ZSTD_dct_rawContent: i32 = 1;\n458\tpub const ZSTD_dct_fullDict: i32 = 2;\n459\t\n460\tpub const ZSTD_MAGICNUMBER: u32 = 0xFD2F_B528;\n461\tpub const ZSTD_MAGIC_DICTIONARY: u32 = 0xEC30_A437;\n462\tpub const ZSTD_MAGIC_SKIPPABLE_START: u32 = 0x184D_2A50;\n463\t\n464\t// ---------------------------------------------------------------- ZSTD structs\n465\t\n466\t/// `ZSTD_bounds` — { ZSTD_ErrorCode error; int lowerBound; int upperBound; }\n467\t#[repr(C)]\n468\t#[derive(Copy, Clone, Debug, PartialEq, Eq, Default)]\n469\tpub struct ZSTD_bounds {\n470\t    pub error: usize,\n471\t    pub lower_bound: i32,\n472\t    pub upper_bound: i32,\n473\t}\n474\t\n475\t/// `ZSTD_inBuffer` — { const void* src; size_t size; size_t pos; }\n476\t#[repr(C)]\n477\t#[derive(Copy, Clone, Debug)]\n478\tpub struct ZSTD_inBuffer {\n479\t    pub src: *const u8,\n480\t    pub size: usize,\n481\t    pub pos: usize,\n482\t}\n483\t\n484\t/// `ZSTD_outBuffer` — { void* dst; size_t size; size_t pos; }\n485\t#[repr(C)]\n486\t#[derive(Copy, Clone, Debug)]\n487\tpub struct ZSTD_outBuffer {\n488\t    pub dst: *mut u8,\n489\t    pub size: usize,\n490\t    pub pos: usize,\n491\t}\n492\t\n493\t/// `ZSTD_Sequence` — { U32 offset; U32 litLength; U32 matchLength; U32 rep; }\n494\t#[repr(C)]\n495\t#[derive(Copy, Clone, Debug, PartialEq, Eq, Default)]\n496\tpub struct ZSTD_Sequence {\n497\t    pub offset: u32,\n498\t    pub lit_length: u32,\n499\t    pub match_length: u32,\n500\t    pub rep: u32,\n501\t}\n502\t\n503\t/// `ZSTD_frameHeader` 