;\n            c_dfree(h);\n            ok\n        })\n        .collect();\n    assert!(full.len() >= 2, \"need >= 2 loadable full dictionaries with a dictID\");\n    // distinct dictIDs are what makes the mismatch detectable\n    for a in &full {\n        for b in &full {\n            if std::ptr::eq(*a, *b) {\n                continue;\n            }\n            unsafe {\n                assert!(\n                    c_fd(a.ptr(), a.len()) != c_fd(b.ptr(), b.len()),\n                    \"corpus dictionaries {} and {} collide on dictID\",\n                    a.name,\n                    b.name\n                );\n            }\n        }\n    }\n\n    for good in &full {\n        for &lvl in &[1i32, 9, 19] {\n            let src = gen_logish(&mut rng, rng.range(400, 20_000));\n            let cap = unsafe { c_bound(src.len()) } + 64;\n            let mut frame = vec![0u8; cap];\n            let n = unsafe {\n                c_cud(\n                    cc,\n                    frame.as_mut_ptr(),\n                    cap,\n                    src.as_ptr(),\n                    src.len(),\n                    good.ptr(),\n                    good.len(),\n                    lvl,\n                )\n            };\n            assert!(!is_err(n), \"compress with {} failed: {n:#x}\", good.name);"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":482,"cache_read_input_tokens":206498,"cache_creation":{"ephemeral_5m_input_tokens":482,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01NuCadTUzSeL1CpB2iQG2tD","session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"de0549cd-d2dc-4dcc-85e0-49ec706640be","timestamp":"2026-08-31T11:00:00.660Z","subagent_type":"general-purpose","task_description":"Dictionary + sequences tests"}
