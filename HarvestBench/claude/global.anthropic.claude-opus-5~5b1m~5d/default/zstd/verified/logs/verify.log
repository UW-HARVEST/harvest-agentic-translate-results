ests build OK\"","description":"Create coverage script","timeout":600000}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":388,"cache_read_input_tokens":332459,"cache_creation":{"ephemeral_5m_input_tokens":388,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"bb4e11ab-ee34-4b81-920b-fbeb1019b54c","timestamp":"2026-08-31T11:20:22.666Z"}
