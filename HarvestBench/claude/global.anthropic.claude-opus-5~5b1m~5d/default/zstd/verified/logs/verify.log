(zstd.h, experimental section).\n504\t#[repr(C)]\n505\t#[derive(Copy, Clone, Debug, PartialEq, Eq, Default)]\n506\tpub struct ZSTD_frameHeader {\n507\t    pub frame_content_size: u64,\n508\t    pub window_size: u64,\n509\t    pub block_size_max: u32,\n510\t    pub frame_type: u32,   // ZSTD_frameType_e\n511\t    pub header_size: u32,\n512\t    pub dict_id: u32,\n513\t    pub checksum_flag: u32,\n514\t    pub _reserved1: u32,\n515\t    pub _reserved2: u32,\n516\t}\n517\t"}]},"parent_tool_use_id":"toolu_bdrk_01RUHBTGsvDTu3wkCWYcgZdT","session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"bd871963-87d7-482c-bcbf-19c33a321d9a","timestamp":"2026-08-31T10:44:09.133Z","subagent_type":"general-purpose","task_description":"DictBuilder differential tests"}
