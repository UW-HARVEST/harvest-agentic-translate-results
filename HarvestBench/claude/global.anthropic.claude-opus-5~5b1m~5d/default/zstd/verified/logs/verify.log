^ZSTD_compressBlock_\\|^ZSTDMT_\\|^ZSTD_ldm_' tmp/uncovered.txt) | \\`SeqStore_t*\\`, \\`ZSTD_entropyCTables_t*\\`, \\`ZSTD_CCtx_params*\\`, \\`rawSeq*\\`, \\`ZSTD_hufCTables_t*\\`, \\`ZSTD_entropyDTables_t*\\`, \\`ZSTD_seqSymbol*\\` | full-pipeline compress/decompress equality over all shapes, sizes, levels, strategies and options |\"\necho\necho '### Full list'\necho\necho '```'\ncat tmp/uncovered.txt\necho '```'\necho\necho \"## 4. Full symbol table\"\necho\necho \"\\`exercised\\` = called directly through both \\`.so\\`s by a passing differential test.\"\necho\necho \"| # | symbol | in C .so | in Rust .so | exercised directly |\"\necho \"|---|--------|----------|-------------|--------------------|\"\ni=0\nwhile read -r s; do\n  i=$((i+1))\n  inr=\"YES\"; grep -qxF \"$s\" tmp/r_syms.txt || inr=\"**MISSING**\"\n  ex=\"yes\"; grep -qxF \"$s\" tmp/coverage.txt || ex=\"indirect\"\n  echo \"| $i | \\`$s\\` | YES | $inr | $ex |\"\ndone < tmp/c_syms.txt\n} > translation/SYMBOLS.md\necho \"SYMBOLS.md: $(wc -l < translation/SYMBOLS.md) lines, MISSING count = $(grep -c 'MISSING' translation/SYMBOLS.md)\"","description":"Regenerate SYMBOLS.md with coverage accounting"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1914,"cache_read_input_tokens":460971,"cache_creation":{"ephemeral_5m_input_tokens":1914,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"81e745b6-1319-41a1-9d2e-7746d1f6efd9","timestamp":"2026-08-31T11:51:30.000Z"}
