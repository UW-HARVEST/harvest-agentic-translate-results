ff.pos  = 0;\n62\t    outBuff.size = *dstCapacityPtr;\n63\t    inBuff.src  = src;\n64\t    inBuff.pos  = 0;\n65\t    inBuff.size = *srcSizePtr;\n66\t    result = ZSTD_decompressStream(zbd, &outBuff, &inBuff);\n67\t    *dstCapacityPtr = outBuff.pos;\n68\t    *srcSizePtr = inBuff.pos;\n69\t    return result;\n70\t}\n71\t\n72\t\n73\t/* *************************************\n74\t*  Tool functions\n75\t***************************************/\n76\tsize_t ZBUFF_recommendedDInSize(void)  { return ZSTD_DStreamInSize(); }\n77\tsize_t ZBUFF_recommendedDOutSize(void) { return ZSTD_DStreamOutSize(); }\n78\t"}]},"parent_tool_use_id":"toolu_bdrk_01XS1K3BDjwATQcA7xKzok9z","session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"0e9f7e1b-d71b-4c57-a054-b5fc7025c175","timestamp":"2026-08-31T10:37:39.759Z","subagent_type":"Explore","task_description":"Legacy + ZBUFF API surface"}
