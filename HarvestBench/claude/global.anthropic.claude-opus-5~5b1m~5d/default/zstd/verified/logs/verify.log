{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DJTYpn9GHaLXKn6J11632a","type":"tool_result","content":"1\t//! Phase B foundation: version/error/bound helpers and the one-shot\n2\t//! compress+decompress round trip across every input shape and length edge.\n3\t//!\n4\t//! Everything here goes through `dlopen`'d exports of BOTH libraries.\n5\t\n6\tmod common;\n7\tuse common::*;\n8\t\n9\ttype Fn_u32 = unsafe extern \"C\" fn() -> u32;\n10\ttype Fn_cstr = unsafe extern \"C\" fn() -> *const std::os::raw::c_char;\n11\ttype Fn_sz_sz = unsafe extern \"C\" fn(usize) -> usize;\n12\ttype Fn_isError = unsafe extern \"C\" fn(usize) -> u32;\n13\ttype Fn_getErrorName = unsafe extern \"C\" fn(usize) -> *const std::os::raw::c_char;\n14\ttype Fn_getErrorCode = unsafe extern \"C\" fn(usize) -> i32;\n15\ttype Fn_i_v = unsafe extern \"C\" fn() -> i32;\n16\t\n17\ttype Fn_compress =\n18\t    unsafe extern \"C\" fn(*mut u8, usize, *const u8, usize, i32) -> usize;\n19\ttype Fn_decompress = unsafe extern \"C\" fn(*mut u8, usize, *const u8, usize) -> usize;\n20\ttype Fn_getFCS = unsafe extern \"C\" fn(*const u8, usize) -> u64;\n21\t\n22\tfn cstr(p: *const std::os::raw::c_char) -> String {\n23\t    if p.is_null() {\n24\t        return \"<null>\".into();\n25\t    }\n26\t    unsafe { std::ffi::CStr::from_ptr(p) }\n27\t        .to_string_lossy()\n28\t        .into_owned()\n29\t}\n30\t\n31\t#[test]\n32\tfn version_and_identity() {\n33\t    let i = impls();\n34\t\n35\t    let (c, r) = i.pair::<Fn_u32>(\"ZSTD_versionNumber\");\n36\t    unsafe { assert_eq_dbg(\"ZSTD_versionNumber\", c(), r()) };\n37\t\n38\t    let (c, r) = i.pair::<Fn_cstr>(\"ZSTD_versionString\");\n39\t    unsafe { assert_eq_dbg(\"ZSTD_versionString\", cstr(c()), cstr(r())) };\n40\t\n41\t    for name in [\"ZSTD_minCLevel\", \"ZSTD_maxCLevel\", \"ZSTD_defaultCLevel\"] {\n42\t        let (c, r) = i.pair::<Fn_i_v>(name);\n43\t        unsafe { assert_eq_dbg(name, c(), r()) };\n44\t    }\n45\t}\n46\t\n47\t/// `ZSTD_compressBound` / `ZSTD_decompressBound` must agree exactly, including\n48\t/// at the overflow guard (ZSTD_MAX_INPUT_SIZE).\n49\t#[test]\n50\tfn compress_bound_matches() {\n51\t    let i = impls();\n52\t    let (c, r) = i.pair::<Fn_sz_sz>(\"ZSTD_compressBound\");\n53\t\n54\t    let mut sizes: Vec<usize> = EDGE_LENS.to_vec();\n55\t    sizes.extend([\n56\t        1 << 20,\n57\t        1 << 24,\n58\t        (1 << 30) + 1,\n59\t        usize::MAX / 8,\n60\t        usize::MAX / 2,\n61\t        usize::MAX - 1,\n62\t        usize::MAX,\n63\t    ]);\n64\t    let mut rng = Rng::new(0xB0110);\n65\t    for _ in 0..200 {\n66\t        sizes.push(rng.next_u64() as usize);\n67\t    }\n68\t\n69\t    for s in sizes {\n70\t        unsafe { assert_eq_dbg(&format!(\"ZSTD_compressBound({s})\"), c(s), r(s)) };\n71\t    }\n72\t}\n73\t\n74\t/// The whole error-reporting surface: every `size_t` in a wide sweep is asked\n75\t/// whether it is an error, what its name is and what its code is. This pins the\n76\t/// error-code mapping used by every Phase C assertion.\n77\t#[test]\n78\tfn error_surface_matches() {\n79\t    let i = impls();\n80\t    let (c_is, r_is) = i.pair::<Fn_isError>(\"ZSTD_isError\");\n81\t    let (c_nm, r_nm) = i.pair::<Fn_getErrorName>(\"ZSTD_getErrorName\");\n82\t    let (c_cd, r_cd) = i.pair::<Fn_getErrorCode>(\"ZSTD_getErrorCode\");\n83\t    let (c_sn, r_sn) = i.pair::<unsafe extern \"C\" fn(i32) -> *const std::os::raw::c_char>(\n84\t        \"ZSTD_getErrorString\",\n85\t    );\n86\t\n87\t    // every plausible negated error code, plus valid-looking sizes\n88\t    let mut probes: Vec<usize> = Vec::new();\n89\t    for e in 0..=200usize {\n90\t        probes.push(0usize.wrapping_sub(e)); // -0 .. -200\n91\t    }\n92\t    probes.extend([0, 1, 2, 100, 1 << 20, usize::MAX / 2]);\n93\t\n94\t    for p in probes {\n95\t        let tag = format!(\"code {p:#x}\");\n96\t        unsafe {\n97\t            assert_eq_dbg(&format!(\"ZSTD_isError({tag})\"), c_is(p), r_is(p));\n98\t            assert_eq_dbg(&format!(\"ZSTD_getErrorName({tag})\"), cstr(c_nm(p)), cstr(r_nm(p)));\n99\t            assert_eq_dbg(&format!(\"ZSTD_getErrorCode({tag})\"), c_cd(p), r_cd(p));\n100\t        }\n101\t    }\n102\t\n103\t    // ZSTD_getErrorString over the enum range *and* out-of-range enum values —\n104\t    // C enums accept any int, so these are real inputs.\n105\t    for e in -5i32..=130 {\n106\t        unsafe {\n107\t            assert_eq_dbg(\n108\t                &format!(\"ZSTD_getErrorString({e})\"),\n109\t                cstr(c_sn(e)),\n110\t                cstr(r_sn(e)),\n111\t            );\n112\t        }\n113\t    }\n114\t}\n115\t\n116\t/// The core happy path: one-shot compress at every level over every shape and\n117\t/// every length edge, asserting the *compressed bytes* are identical (not just\n118\t/// that both round-trip) and that each library can decode the other's frame.\n119\t#[test]\n120\tfn oneshot_roundtrip_all_shapes_levels() {\n121\t    let i = impls();\n122\t    let (c_comp, r_comp) = i.pair::<Fn_compress>(\"ZSTD_compress\");\n123\t    let (c_dec, r_dec) = i.pair::<Fn_decompress>(\"ZSTD_decompress\");\n124\t    let (c_fcs, r_fcs) = i.pair::<Fn_getFCS>(\"ZSTD_getFrameContentSize\");\n125\t    let (c_bound, _) = i.pair::<Fn_sz_sz>(\"ZSTD_compressBound\");\n126\t\n127\t    let mut rng = Rng::new(0xC0FFEE);\n128\t    // a representative level sweep incl. negative/fast levels, 0 (=default) and max\n129\t    let levels = [-131_072, -1000, -50, -5, -1, 0, 1, 2, 3, 5, 9, 12, 17, 19, 22];\n130\t\n131\t    for &shape in &ALL_SHAPES {\n132\t        for &len in &[0usize, 1, 7, 64, 1000, 5000, 70_000, 131_072, 131_073, 300_000] {\n133\t            let src = gen_shape(shape, len, &mut rng);\n134\t            for &lvl in &levels {\n135\t                let cap = unsafe { c_bound(len) };\n136\t                let mut cbuf = vec![0xAAu8; cap];\n137\t                let mut rbuf = vec![0x55u8; cap];\n138\t\n139\t                let cn = unsafe { c_comp(cbuf.as_mut_ptr(), cap, src.as_ptr(), len, lvl) };\n140\t                let rn = unsafe { r_comp(rbuf.as_mut_ptr(), cap, src.as_ptr(), len, lvl) };\n141\t\n142\t                let tag = format!(\"compress shape={shape:?} len={len} lvl={lvl}\");\n143\t                assert_eq_dbg(&tag, cn, rn);\n144\t                assert!(unsafe { !c_is_err(i, cn) }, \"{tag}: C errored {cn:#x}\");\n145\t                assert_bytes_eq(&tag, &cbuf[..cn], &rbuf[..rn]);\n146\t\n147\t                // frame content size agreement\n148\t                unsafe {\n149\t                    assert_eq_dbg(\n150\t                        &format!(\"{tag} / getFrameContentSize\"),\n151\t                        c_fcs(cbuf.as_ptr(), cn),\n152\t                        r_fcs(rbuf.as_ptr(), rn),\n153\t                    );\n154\t                }\n155\t\n156\t                // cross-decode: C frame -> Rust decoder and vice versa\n157\t                let mut d1 = vec![0u8; len + 1];\n158\t                let mut d2 = vec![0u8; len + 1];\n159\t                let n1 = unsafe { r_dec(d1.as_mut_ptr(), len + 1, cbuf.as_ptr(), cn) };\n160\t                let n2 = unsafe { c_dec(d2.as_mut_ptr(), len + 1, rbuf.as_ptr(), rn) };\n161\t                assert_eq_dbg(&format!(\"{tag} / rust decodes C frame\"), n1, len);\n162\t                assert_eq_dbg(&format!(\"{tag} / C decodes rust frame\"), n2, len);\n163\t                assert_bytes_eq(&format!(\"{tag} / plaintext\"), &src, &d1[..n1]);\n164\t                assert_bytes_eq(&format!(\"{tag} / plaintext\"), &src, &d2[..n2]);\n165\t            }\n166\t        }\n167\t    }\n168\t}\n169\t\n170\tunsafe fn c_is_err(i: &Impls, code: usize) -> bool {\n171\t    let (c, _) = i.pair::<Fn_isError>(\"ZSTD_isError\");\n172\t    c(code) != 0\n173\t}\n174\t\n175\t/// Decompression of randomized *valid* frames must agree, and both libraries\n176\t/// must report the same result for every truncation of a valid frame — this\n177\t/// exercises the incomplete-input paths of the frame/block decoder.\n178\t#[test]\n179\tfn decompress_truncated_frames_agree() {\n180\t    let i = impls();\n181\t    let (c_comp, _) = i.pair::<Fn_compress>(\"ZSTD_compress\");\n182\t    let (c_dec, r_dec) = i.pair::<Fn_decompress>(\"ZSTD_decompress\");\n183\t    let (c_bound, _) = i.pair::<Fn_sz_sz>(\"ZSTD_compressBound\");\n184\t\n185\t    let mut rng = Rng::new(0x7A0D);\n186\t    for &shape in &ALL_SHAPES {\n187\t        let len = rng.range(200, 4000);\n188\t        let src = gen_shape(shape, len, &mut rng);\n189\t        let cap = unsafe { c_bound(len) };\n190\t        let mut frame = vec![0u8; cap];\n191\t        let n = unsafe { c_comp(frame.as_mut_ptr(), cap, src.as_ptr(), len, 3) };\n192\t\n193\t        for cut in 0..=n {\n194\t            let mut d1 = vec![0u8; len + 16];\n195\t            let mut d2 = vec![0u8; len + 16];\n196\t            let a = unsafe { c_dec(d1.as_mut_ptr(), d1.len(), frame.as_ptr(), cut) };\n197\t            let b = unsafe { r_dec(d2.as_mut_ptr(), d2.len(), frame.as_ptr(), cut) };\n198\t            assert_eq_dbg(\n199\t                &format!(\"truncated decompress shape={shape:?} cut={cut}/{n}\"),\n200\t                a,\n201\t                b,\n202\t            );\n203\t            if a == len {\n204\t                assert_bytes_eq(\"truncated-but-complete payload\", &d1[..a], &d2[..b]);\n205\t            }\n206\t        }\n207\t    }\n208\t}\n209\t\n210\t/// Bit-flip corruption sweep: both libraries must reject (or accept) each\n211\t/// corrupted frame identically, with the same error code.\n212\t#[test]\n213\tfn decompress_corrupted_frames_agree() {\n214\t    let i = impls();\n215\t    let (c_comp, _) = i.pair::<Fn_compress>(\"ZSTD_compress\");\n216\t    let (c_dec, r_dec) = i.pair::<Fn_decompress>(\"ZSTD_decompress\");\n217\t    let (c_bound, _) = i.pair::<Fn_sz_sz>(\"ZSTD_compressBound\");\n218\t    let (c_cd, r_cd) = i.pair::<Fn_getErrorCode>(\"ZSTD_getErrorCode\");\n219\t\n220\t    let mut rng = Rng::new(0xDEAD_BEEF);\n221\t    for &shape in &ALL_SHAPES {\n222\t        for &lvl in &[1i32, 3, 9, 19] {\n223\t            let len = rng.range(500, 3000);\n224\t            let src = gen_shape(shape, len, &mut rng);\n225\t            let cap = unsafe { c_bound(len) };\n226\t            let mut base = vec![0u8; cap];\n227\t            let n = unsafe { c_comp(base.as_mut_ptr(), cap, src.as_ptr(), len, lvl) };\n228\t\n229\t            for _ in 0..120 {\n230\t                let mut f = base[..n].to_vec();\n231\t                let pos = rng.below(n);\n232\t                f[pos] ^= 1u8 << rng.below(8);\n233\t\n234\t                let mut d1 = vec![0u8; len + 64];\n235\t                let mut d2 = vec![0u8; len + 64];\n236\t                let a = unsafe { c_dec(d1.as_mut_ptr(), d1.len(), f.as_ptr(), f.len()) };\n237\t                let b = unsafe { r_dec(d2.as_mut_ptr(), d2.len(), f.as_ptr(), f.len()) };\n238\t                let tag = format!(\"corrupt shape={shape:?} lvl={lvl} pos={pos}\");\n239\t                assert_eq_dbg(&tag, a, b);\n240\t                unsafe { assert_eq_dbg(&format!(\"{tag} errcode\"), c_cd(a), r_cd(b)) };\n241\t                if a <= len {\n242\t                    assert_bytes_eq(&format!(\"{tag} payload\"), &d1[..a], &d2[..b]);\n243\t                }\n244\t            }\n245\t        }\n246\t    }\n247\t}\n248\t"}]},"parent_tool_use_id":"toolu_bdrk_01NuCadTUzSeL1CpB2iQG2tD","session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"91a70032-dbdb-4932-91f2-7e0feeecfcd7","timestamp":"2026-08-31T10:45:07.750Z","subagent_type":"general-purpose","task_description":"Dictionary + sequences tests"}
