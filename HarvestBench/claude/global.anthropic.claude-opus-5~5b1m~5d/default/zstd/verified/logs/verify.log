t */\n217\t\n218\t/** HUF_selectDecoder() :\n219\t *  Tells which decoder is likely to decode faster,\n220\t *  based on a set of pre-computed metrics.\n221\t * @return : 0==HUF_decompress4X1, 1==HUF_decompress4X2 .\n222\t *  Assumption : 0 < dstSize <= 128 KB */\n223\tU32 HUF_selectDecoder (size_t dstSize, size_t cSrcSize);\n224\t\n225\t/**\n226\t *  The minimum workspace size for the `workSpace` used in\n227\t *  HUF_readDTableX1_wksp() and HUF_readDTableX2_wksp().\n228\t *\n229\t *  The space used depends on HUF_TABLELOG_MAX, ranging from ~1500 bytes when\n230\t *  HUF_TABLE_LOG_MAX=12 to ~1850 bytes when HUF_TABLE_LOG_MAX=15.\n231\t *  Buffer overflow errors may potentially occur if code modifications result in\n232\t *  a required workspace size greater than that specified in the following\n233\t *  macro.\n234\t */\n235\t#define HUF_DECOMPRESS_WORKSPACE_SIZE ((2 << 10) + (1 << 9))\n236\t#define HUF_DECOMPRESS_WORKSPACE_SIZE_U32 (HUF_DECOMPRESS_WORKSPACE_SIZE / sizeof(U32))\n237\t\n238\t\n239\t/* ====================== */\n240\t/* single stream variants */\n241\t/* ====================== */\n242\t\n243\tsize_t HUF_compress1X_usingCTable(void* dst, size_t dstSize, const void* src, size_t srcSize, const HUF_CElt* CTable, int flags);\n244\t/** HUF_compress1X_repeat() :\n245\t *  Same as HUF_compress1X_wksp(), but considers using hufTable if *repeat != HUF_repeat_none.\n246\t *  If it uses hufTable it does not modify hufTable or repeat.\n247\t *  If it doesn't, it sets *repeat = HUF_repeat_none, and it sets hufTable to the table used.\n248\t *  If preferRepeat then the old table will always be used if valid.\n249\t *  If suspectUncompressible then some sampling checks will be run to potentially skip huffman coding */\n250\tsize_t HUF_compress1X_repeat(void* dst, size_t dstSize,\n251\t                       const void* src, size_t srcSize,\n252\t                       unsigned maxSymbolValue, unsigned tableLog,\n253\t                       void* workSpace, size_t wkspSize,   /**< `workSpace` must be aligned on 4-bytes boundaries, `wkspSize` must be >= HUF_WORKSPACE_SIZE */\n254\t                       HUF_CElt* hufTable, HUF_repeat* repeat, int flags);\n255\t\n256\tsize_t HUF_decompress1X_DCtx_wksp(HUF_DTable* dctx, void* dst, size_t dstSize, const void* cSrc, size_t cSrcSize, void* workSpace, size_t wkspSize, int flags);\n257\t#ifndef HUF_FORCE_DECOMPRESS_X1\n258\tsize_t HUF_decompress1X2_DCtx_wksp(HUF_DTable* dctx, void* dst, size_t dstSize, const void* cSrc, size_t cSrcSize, void* workSpace, size_t wkspSize, int flags);   /**< double-symbols decoder */\n259\t#endif\n260\t\n261\t/* BMI2 variants.\n262\t * If the CPU has BMI2 support, pass bmi2=1, otherwise pass bmi2=0.\n263\t */\n264\tsize_t HUF_decompress1X_usingDTable(void* dst, size_t maxDstSize, const void* cSrc, size_t cSrcSize, const HUF_DTable* DTable, int flags);\n265\t#ifndef HUF_FORCE_DECOMPRESS_X2\n266\tsize_t HUF_decompress1X1_DCtx_wksp(HUF_DTable* dctx, void* dst, size_t dstSize, const void* cSrc, size_t cSrcSize, void* workSpace, size_t wkspSize, int flags);\n267\t#endif\n268\tsize_t HUF_decompress4X_usingDTable(void* dst, size_t maxDstSize, const void* cSrc, size_t cSrcSize, const HUF_DTable* DTable, int flags);\n269\tsize_t HUF_decompress4X_hufOnly_wksp(HUF_DTable* dctx, void* dst, size_t dstSize, const void* cSrc, size_t cSrcSize, void* workSpace, size_t wkspSize, int flags);\n270\t#ifndef HUF_FORCE_DECOMPRESS_X2\n271\tsize_t HUF_readDTableX1_wksp(HUF_DTable* DTable, const void* src, size_t srcSize, void* workSpace, size_t wkspSize, int flags);\n272\t#endif\n273\t#ifndef HUF_FORCE_DECOMPRESS_X1\n274\tsize_t HUF_readDTableX2_wksp(HUF_DTable* DTable, const void* src, size_t srcSize, void* workSpace, size_t wkspSize, int flags);\n275\t#endif\n276\t\n277\t#endif   /* HUF_H_298734234 */\n278\t"}]},"parent_tool_use_id":"toolu_bdrk_013YEk2NXf3gHQYam4RdiuMd","session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"a33133c4-37f3-44c7-8a1d-7b6a579f8a30","timestamp"