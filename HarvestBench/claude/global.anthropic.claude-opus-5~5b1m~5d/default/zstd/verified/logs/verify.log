st really have regenerated data, not just\n        // rejected every chunk.\n        assert!(\n            total_steps > 200,\n            \"v{v}: streaming ran only {total_steps} steps\"\n        );\n        assert!(\n            productive_steps >= 5,\n            \"v{v}: only {productive_steps} decompressContinue steps produced output\"\n        );\n    }\n}\"\"\"\nassert old in s\ns = s.replace(old, new)\n\nopen(p,'w').write(s)\nprint(\"t08 patched\")\nPY\ntimeout 900 cargo test --release --offline --test t08_legacy legacy_streaming -- --test-threads=1 2>&1 | tail -20","description":"Add depth guard to t08 streaming test"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":536,"cache_read_input_tokens":291241,"cache_creation":{"ephemeral_5m_input_tokens":536,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_0192suTGPFT4vW4VxJLgCxsp","session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"bac151ee-79b9-45f6-a8ec-88c680f39672","timestamp":"2026-08-31T11:13:08.052Z","subagent_type":"general-purpose","task_description":"Legacy + ZBUFF differential tests"}
