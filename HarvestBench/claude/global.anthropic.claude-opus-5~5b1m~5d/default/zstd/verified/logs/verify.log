{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CEXKZoo7x1ym3KJ11VTY8P","type":"tool_result","content":"1\t//! Phase B/C: the advanced parameter surface.\n2\t//!\n3\t//! * `ZSTD_cParam_getBounds` / `ZSTD_dParam_getBounds` for EVERY parameter id,\n4\t//!   including ids with no valid variant (out-of-range enum values across FFI).\n5\t//! * `ZSTD_CCtx_setParameter` / `ZSTD_CCtxParams_setParameter` accept/reject\n6\t//!   parity at, inside and one step past each documented bound.\n7\t//! * `ZSTD_compress2` output equality for randomized valid parameter sets, so\n8\t//!   the *effect* of each accepted parameter is verified, not just its return.\n9\t\n10\tmod common;\n11\tuse common::*;\n12\t\n13\ttype CCtx = *mut std::ffi::c_void;\n14\ttype CCtxParams = *mut std::ffi::c_void;\n15\ttype DCtx = *mut std::ffi::c_void;\n16\t\n17\ttype Fn_createCCtx = unsafe extern \"C\" fn() -> CCtx;\n18\ttype Fn_freeCCtx = unsafe extern \"C\" fn(CCtx) -> usize;\n19\ttype Fn_createDCtx = unsafe extern \"C\" fn() -> DCtx;\n20\ttype Fn_freeDCtx = unsafe extern \"C\" fn(DCtx) -> usize;\n21\ttype Fn_cParamBounds = unsafe extern \"C\" fn(i32) -> ZSTD_bounds;\n22\ttype Fn_setParam = unsafe extern \"C\" fn(CCtx, i32, i32) -> usize;\n23\ttype Fn_getParam = unsafe extern \"C\" fn(CCtx, i32, *mut i32) -> usize;\n24\ttype Fn_setPledged = unsafe extern \"C\" fn(CCtx, u64) -> usize;\n25\ttype Fn_reset = unsafe extern \"C\" fn(CCtx, i32) -> usize;\n26\ttype Fn_compress2 = unsafe extern \"C\" fn(CCtx, *mut u8, usize, *const u8, usize) -> usize;\n27\ttype Fn_decompressDCtx =\n28\t    unsafe extern \"C\" fn(DCtx, *mut u8, usize, *const u8, usize) -> usize;\n29\ttype Fn_dSetParam = unsafe extern \"C\" fn(DCtx, i32, i32) -> usize;\n30\ttype Fn_bound = unsafe extern \"C\" fn(usize) -> usize;\n31\t\n32\ttype Fn_createParams = unsafe extern \"C\" fn() -> CCtxParams;\n33\ttype Fn_freeParams = unsafe extern \"C\" fn(CCtxParams) -> usize;\n34\ttype Fn_paramsSet = unsafe extern \"C\" fn(CCtxParams, i32, i32) -> usize;\n35\ttype Fn_paramsGet = unsafe extern \"C\" fn(CCtxParams, i32, *mut i32) -> usize;\n36\ttype Fn_paramsInit = unsafe extern \"C\" fn(CCtxParams, i32) -> usize;\n37\ttype Fn_paramsReset = unsafe extern \"C\" fn(CCtxParams) -> usize;\n38\ttype Fn_setParamsUsingCCtxParams = unsafe extern \"C\" fn(CCtx, CCtxParams) -> usize;\n39\t\n40\t/// Every parameter id the public header names, plus deliberately invalid ids.\n41\tfn all_cparam_ids() -> Vec<i32> {\n42\t    let mut v = vec![\n43\t        ZSTD_c_compressionLevel,\n44\t        ZSTD_c_windowLog,\n45\t        ZSTD_c_hashLog,\n46\t        ZSTD_c_chainLog,\n47\t        ZSTD_c_searchLog,\n48\t        ZSTD_c_minMatch,\n49\t        ZSTD_c_targetLength,\n50\t        ZSTD_c_strategy,\n51\t        ZSTD_c_targetCBlockSize,\n52\t        ZSTD_c_enableLongDistanceMatching,\n53\t        ZSTD_c_ldmHashLog,\n54\t        ZSTD_c_ldmMinMatch,\n55\t        ZSTD_c_ldmBucketSizeLog,\n56\t        ZSTD_c_ldmHashRateLog,\n57\t        ZSTD_c_contentSizeFlag,\n58\t        ZSTD_c_checksumFlag,\n59\t        ZSTD_c_dictIDFlag,\n60\t        ZSTD_c_nbWorkers,\n61\t        ZSTD_c_jobSize,\n62\t        ZSTD_c_overlapLog,\n63\t        ZSTD_c_rsyncable,\n64\t        ZSTD_c_format,\n65\t        ZSTD_c_forceMaxWindow,\n66\t        ZSTD_c_forceAttachDict,\n67\t        ZSTD_c_literalCompressionMode,\n68\t        ZSTD_c_experimentalParam6,\n69\t        ZSTD_c_srcSizeHint,\n70\t        ZSTD_c_enableDedicatedDictSearch,\n71\t        ZSTD_c_stableInBuffer,\n72\t        ZSTD_c_stableOutBuffer,\n73\t        ZSTD_c_blockDelimiters,\n74\t        ZSTD_c_validateSequences,\n75\t        ZSTD_c_splitAfterSequences,\n76\t        ZSTD_c_useRowMatchFinder,\n77\t        ZSTD_c_deterministicRefPrefix,\n78\t        ZSTD_c_prefetchCDictTables,\n79\t        ZSTD_c_enableSeqProducerFallback,\n80\t        ZSTD_c_maxBlockSize,\n81\t        ZSTD_c_repcodeResolution,\n82\t        ZSTD_c_blockSplitterLevel,\n83\t    ];\n84\t    // out-of-range / no-valid-variant enum values that C must still handle\n85\t    v.extend([\n86\t        i32::MIN, -1, 0, 1, 2, 9, 11, 99, 108, 129, 131, 159, 165, 199, 203, 399, 403, 499,\n87\t        501, 999, 1018, 1019, 5000, i32::MAX,\n88\t    ]);\n89\t    v\n90\t}\n91\t\n92\tfn all_dparam_ids() -> Vec<i32> {\n93\t    let mut v = vec![\n94\t        ZSTD_d_windowLogMax,\n95\t        ZSTD_d_format,\n96\t        ZSTD_d_stableOutBuffer,\n97\t        ZSTD_d_forceIgnoreChecksum,\n98\t        ZSTD_d_refMultipleDDicts,\n99\t        ZSTD_d_disableHuffmanAssembly,\n100\t        ZSTD_d_maxBlockSize,\n101\t    ];\n102\t    v.extend([i32::MIN, -1, 0, 1, 99, 101, 999, 1006, 1007, 12345, i32::MAX]);\n103\t    v\n104\t}\n105\t\n106\t/// Phase C + Phase B: bounds for every id must match exactly, including the\n107\t/// `error` field for ids that are not valid parameters at all.\n108\t#[test]\n109\tfn cparam_dparam_bounds_match_including_invalid_ids() {\n110\t    let i = impls();\n111\t    let (c_cb, r_cb) = i.pair::<Fn_cParamBounds>(\"ZSTD_cParam_getBounds\");\n112\t    let (c_db, r_db) = i.pair::<Fn_cParamBounds>(\"ZSTD_dParam_getBounds\");\n113\t\n114\t    for id in all_cparam_ids() {\n115\t        let (a, b) = unsafe { (c_cb(id), r_cb(id)) };\n116\t        assert_eq_dbg(&format!(\"ZSTD_cParam_getBounds({id})\"), a, b);\n117\t    }\n118\t    for id in all_dparam_ids() {\n119\t        let (a, b) = unsafe { (c_db(id), r_db(id)) };\n120\t        assert_eq_dbg(&format!(\"ZSTD_dParam_getBounds({id})\"), a, b);\n121\t    }\n122\t}\n123\t\n124\t/// For every parameter, probe values at the bound, inside it, and one step past\n125\t/// it in both directions. Accept/reject and the resulting *stored* value (via\n126\t/// getParameter) must match. This is the bulk of the ERRORS.md parameter rows.\n127\t#[test]\n128\tfn setparameter_accept_reject_and_readback_match() {\n129\t    let i = impls();\n130\t    let (c_new, r_new) = i.pair::<Fn_createCCtx>(\"ZSTD_createCCtx\");\n131\t    let (c_free, r_free) = i.pair::<Fn_freeCCtx>(\"ZSTD_freeCCtx\");\n132\t    let (c_set, r_set) = i.pair::<Fn_setParam>(\"ZSTD_CCtx_setParameter\");\n133\t    let (c_get, r_get) = i.pair::<Fn_getParam>(\"ZSTD_CCtx_getParameter\");\n134\t    let (c_cb, _) = i.pair::<Fn_cParamBounds>(\"ZSTD_cParam_getBounds\");\n135\t    let (c_rst, r_rst) = i.pair::<Fn_reset>(\"ZSTD_CCtx_reset\");\n136\t\n137\t    let cc = unsafe { c_new() };\n138\t    let rc = unsafe { r_new() };\n139\t    assert!(!cc.is_null() && !rc.is_null());\n140\t\n141\t    for id in all_cparam_ids() {\n142\t        let b = unsafe { c_cb(id) };\n143\t        // probe set: bounds +- 1, extremes, and a few interior points\n144\t        let mut probes: Vec<i32> = vec![\n145\t            i32::MIN,\n146\t            i32::MIN + 1,\n147\t            -1,\n148\t            0,\n149\t            1,\n150\t            i32::MAX - 1,\n151\t            i32::MAX,\n152\t        ];\n153\t        if b.error == 0 {\n154\t            for base in [b.lower_bound, b.upper_bound] {\n155\t                for d in [-2i32, -1, 0, 1, 2] {\n156\t                    probes.push(base.saturating_add(d));\n157\t                }\n158\t            }\n159\t            let mid = (b.lower_bound as i64 + b.upper_bound as i64) / 2;\n160\t            probes.push(mid as i32);\n161\t        }\n162\t\n163\t        for v in probes {\n164\t            // fresh parameter state each probe so results are independent\n165\t            unsafe {\n166\t                c_rst(cc, ZSTD_reset_session_and_parameters);\n167\t                r_rst(rc, ZSTD_reset_session_and_parameters);\n168\t            }\n169\t            let (a, bb) = unsafe { (c_set(cc, id, v), r_set(rc, id, v)) };\n170\t            let tag = format!(\"ZSTD_CCtx_setParameter(id={id}, value={v})\");\n171\t            assert_eq_dbg(&tag, a, bb);\n172\t\n173\t            // read back — must agree whether or not the set succeeded\n174\t            let mut ov1 = -12345i32;\n175\t            let mut ov2 = -12345i32;\n176\t            let (g1, g2) = unsafe { (c_get(cc, id, &mut ov1), r_get(rc, id, &mut ov2)) };\n177\t            assert_eq_dbg(&format!(\"{tag} / getParameter rc\"), g1, g2);\n178\t            assert_eq_dbg(&format!(\"{tag} / getParameter value\"), ov1, ov2);\n179\t        }\n180\t    }\n181\t\n182\t    unsafe {\n183\t        c_free(cc);\n184\t        r_free(rc);\n185\t    }\n186\t}\n187\t\n188\t/// Same sweep against the standalone `ZSTD_CCtx_params` object, which has its\n189\t/// own validation path in the C (`ZSTD_CCtxParams_setParameter`).\n190\t#[test]\n191\tfn cctxparams_accept_reject_and_readback_match() {\n192\t    let i = impls();\n193\t    let (c_new, r_new) = i.pair::<Fn_createParams>(\"ZSTD_createCCtxParams\");\n194\t    let (c_free, r_free) = i.pair::<Fn_freeParams>(\"ZSTD_freeCCtxParams\");\n195\t    let (c_set, r_set) = i.pair::<Fn_paramsSet>(\"ZSTD_CCtxParams_setParameter\");\n196\t    let (c_get, r_get) = i.pair::<Fn_paramsGet>(\"ZSTD_CCtxParams_getParameter\");\n197\t    let (c_init, r_init) = i.pair::<Fn_paramsInit>(\"ZSTD_CCtxParams_init\");\n198\t    let (c_rst, r_rst) = i.pair::<Fn_paramsReset>(\"ZSTD_CCtxParams_reset\");\n199\t    let (c_cb, _) = i.pair::<Fn_cParamBounds>(\"ZSTD_cParam_getBounds\");\n200\t\n201\t    let cp = unsafe { c_new() };\n202\t    let rp = unsafe { r_new() };\n203\t    assert!(!cp.is_null() && !rp.is_null());\n204\t\n205\t    // ZSTD_CCtxParams_init over a level sweep (incl. invalid levels)\n206\t    for lvl in [-1000i32, -1, 0, 1, 3, 19, 22, 23, 100] {\n207\t        let (a, b) = unsafe { (c_init(cp, lvl), r_init(rp, lvl)) };\n208\t        assert_eq_dbg(&format!(\"ZSTD_CCtxParams_init({lvl})\"), a, b);\n209\t    }\n210\t\n211\t    for id in all_cparam_ids() {\n212\t        let b = unsafe { c_cb(id) };\n213\t        let mut probes: Vec<i32> = vec![i32::MIN, -1, 0, 1, i32::MAX];\n214\t        if b.error == 0 {\n215\t            for base in [b.lower_bound, b.upper_bound] {\n216\t                for d in [-1i32, 0, 1] {\n217\t                    probes.push(base.saturating_add(d));\n218\t                }\n219\t            }\n220\t        }\n221\t        for v in probes {\n222\t            unsafe {\n223\t                c_rst(cp);\n224\t                r_rst(rp);\n225\t            }\n226\t            let (a, bb) = unsafe { (c_set(cp, id, v), r_set(rp, id, v)) };\n227\t            let tag = format!(\"ZSTD_CCtxParams_setParameter(id={id}, value={v})\");\n228\t            assert_eq_dbg(&tag, a, bb);\n229\t\n230\t            let mut o1 = -999i32;\n231\t            let mut o2 = -999i32;\n232\t            let (g1, g2) = unsafe { (c_get(cp, id, &mut o1), r_get(rp, id, &mut o2)) };\n233\t            assert_eq_dbg(&format!(\"{tag} / get rc\"), g1, g2);\n234\t            assert_eq_dbg(&format!(\"{tag} / get value\"), o1, o2);\n235\t        }\n236\t    }\n237\t\n238\t    unsafe {\n239\t        c_free(cp);\n240\t        r_free(rp);\n241\t    }\n242\t}\n243\t\n244\t/// A named, reproducible parameter configuration applied through the low-level\n245\t/// `ZSTD_CCtx_setParameter` path, then run end-to-end with `ZSTD_compress2`.\n246\tstruct Cfg {\n247\t    name: &'static str,\n248\t    params: Vec<(i32, i32)>,\n249\t}\n250\t\n251\tfn configurations() -> Vec<Cfg> {\n252\t    let mut v: Vec<Cfg> = Vec::new();\n253\t\n254\t    // one row per strategy — each selects a different match finder source file\n255\t    for &s in &ALL_STRATEGIES {\n256\t        v.push(Cfg {\n257\t            name: \"strategy\",\n258\t            params: vec![(ZSTD_c_strategy, s), (ZSTD_c_compressionLevel, 5)],\n259\t        });\n260\t    }\n261\t    // checksum / contentSize / dictID flag cross product\n262\t    for &ck in &[0, 1] {\n263\t        for &cs in &[0, 1] {\n264\t            for &di in &[0, 1] {\n265\t                v.push(Cfg {\n266\t                    name: \"frame-flags\",\n267\t                    params: vec![\n268\t                        (ZSTD_c_checksumFlag, ck),\n269\t                        (ZSTD_c_contentSizeFlag, cs),\n270\t                        (ZSTD_c_dictIDFlag, di),\n271\t                    ],\n272\t                });\n273\t            }\n274\t        }\n275\t    }\n276\t    // magicless format x checksum\n277\t    for &f in &[ZSTD_f_zstd1, ZSTD_f_zstd1_magicless] {\n278\t        for &ck in &[0, 1] {\n279\t            v.push(Cfg {\n280\t                name: \"format\",\n281\t                params: vec![(ZSTD_c_format, f), (ZSTD_c_checksumFlag, ck)],\n282\t            });\n283\t        }\n284\t    }\n285\t    // long distance matching, with explicit ldm tuning\n286\t    for &ldm in &[0, 1] {\n287\t        v.push(Cfg {\n288\t            name: \"ldm\",\n289\t            params: vec![\n290\t                (ZSTD_c_enableLongDistanceMatching, ldm),\n291\t                (ZSTD_c_windowLog, 20),\n292\t            ],\n293\t        });\n294\t    }\n295\t    v.push(Cfg {\n296\t        name: \"ldm-tuned\",\n297\t        params: vec![\n298\t            (ZSTD_c_enableLongDistanceMatching, 1),\n299\t            (ZSTD_c_ldmHashLog, 17),\n300\t            (ZSTD_c_ldmMinMatch, 32),\n301\t            (ZSTD_c_ldmBucketSizeLog, 3),\n302\t            (ZSTD_c_ldmHashRateLog, 4),\n303\t            (ZSTD_c_windowLog, 21),\n304\t        ],\n305\t    });\n306\t    // literal compression modes\n307\t    for &m in &[ZSTD_lcm_auto, ZSTD_lcm_huffman, ZSTD_lcm_uncompressed] {\n308\t        v.push(Cfg {\n309\t            name: \"literalCompressionMode\",\n310\t            params: vec![(ZSTD_c_literalCompressionMode, m)],\n311\t        });\n312\t    }\n313\t    // row match finder toggle (auto/enable/disable) x strategy in its valid range\n314\t    for &ps in &[ZSTD_ps_auto, ZSTD_ps_enable, ZSTD_ps_disable] {\n315\t        for &s in &[ZSTD_greedy, ZSTD_lazy, ZSTD_lazy2] {\n316\t            v.push(Cfg {\n317\t                name: \"useRowMatchFinder\",\n318\t                params: vec![(ZSTD_c_useRowMatchFinder, ps), (ZSTD_c_strategy, s)],\n319\t            });\n320\t        }\n321\t    }\n322\t    // block splitter / splitAfterSequences / blockSplitterLevel\n323\t    for &ps in &[ZSTD_ps_auto, ZSTD_ps_enable, ZSTD_ps_disable] {\n324\t        v.push(Cfg {\n325\t            name: \"splitAfterSequences\",\n326\t            params: vec![(ZSTD_c_splitAfterSequences, ps), (ZSTD_c_compressionLevel, 9)],\n327\t        });\n328\t    }\n329\t    for lvl in 0..=6 {\n330\t        v.push(Cfg {\n331\t            name: \"blockSplitterLevel\",\n332\t            params: vec![(ZSTD_c_blockSplitterLevel, lvl)],\n333\t        });\n334\t    }\n335\t    // targetCBlockSize / maxBlockSize\n336\t    for &t in &[0, 1340, 2048, 65536, 131_072] {\n337\t        v.push(Cfg {\n338\t            name: \"targetCBlockSize\",\n339\t            params: vec![(ZSTD_c_targetCBlockSize, t)],\n340\t        });\n341\t    }\n342\t    for &m in &[0, 1024, 8192, 65536, 131_072] {\n343\t        v.push(Cfg {\n344\t            name: \"maxBlockSize\",\n345\t            params: vec![(ZSTD_c_maxBlockSize, m)],\n346\t        });\n347\t    }\n348\t    // explicit window/hash/chain/search/minMatch/targetLength tuning\n349\t    v.push(Cfg {\n350\t        name: \"manual-tuning-fast\",\n351\t        params: vec![\n352\t            (ZSTD_c_strategy, ZSTD_fast),\n353\t            (ZSTD_c_windowLog, 17),\n354\t            (ZSTD_c_hashLog, 16),\n355\t            (ZSTD_c_searchLog, 1),\n356\t            (ZSTD_c_minMatch, 5),\n357\t            (ZSTD_c_targetLength, 0),\n358\t        ],\n359\t    });\n360\t    v.push(Cfg {\n361\t        name: \"manual-tuning-btultra2\",\n362\t        params: vec![\n363\t            (ZSTD_c_strategy, ZSTD_btultra2),\n364\t            (ZSTD_c_windowLog, 18),\n365\t            (ZSTD_c_hashLog, 17),\n366\t            (ZSTD_c_chainLog, 17),\n367\t            (ZSTD_c_searchLog, 6),\n368\t            (ZSTD_c_minMatch, 3),\n369\t            (ZSTD_c_targetLength, 999),\n370\t        ],\n371\t    });\n372\t    v.push(Cfg {\n373\t        name: \"minMatch-sweep-3\",\n374\t        params: vec![(ZSTD_c_strategy, ZSTD_lazy2), (ZSTD_c_minMatch, 3)],\n375\t    });\n376\t    v.push(Cfg {\n377\t        name: \"minMatch-sweep-7\",\n378\t        params: vec![(ZSTD_c_strategy, ZSTD_fast), (ZSTD_c_minMatch, 7)],\n379\t    });\n380\t    // srcSizeHint / forceMaxWindow / deterministicRefPrefix / repcodeResolution\n381\t    for &h in &[0, 1, 1000, 1 << 20] {\n382\t        v.push(Cfg {\n383\t            name: \"srcSizeHint\",\n384\t            params: vec![(ZSTD_c_srcSizeHint, h)],\n385\t        });\n386\t    }\n387\t    for &f in &[0, 1] {\n388\t        v.push(Cfg {\n389\t            name: \"forceMaxWindow\",\n390\t            params: vec![(ZSTD_c_forceMaxWindow, f)],\n391\t        });\n392\t    }\n393\t    for &d in &[0, 1] {\n394\t        v.push(Cfg {\n395\t            name: \"deterministicRefPrefix\",\n396\t            params: vec![(ZSTD_c_deterministicRefPrefix, d)],\n397\t        });\n398\t    }\n399\t    for &rr in &[ZSTD_ps_auto, ZSTD_ps_enable, ZSTD_ps_disable] {\n400\t        v.push(Cfg {\n401\t            name: \"repcodeResolution\",\n402\t            params: vec![(ZSTD_c_repcodeResolution, rr)],\n403\t        });\n404\t    }\n405\t    for &r in &[0, 1] {\n406\t        v.push(Cfg {\n407\t            name: \"rsyncable\",\n408\t            params: vec![(ZSTD_c_rsyncable, r), (ZSTD_c_windowLog, 20)],\n409\t        });\n410\t    }\n411\t    // negative / fast levels and the extremes\n412\t    for &lvl in &[-131_072, -5000, -100, -10, -3, -1, 0, 1, 19, 22] {\n413\t        v.push(Cfg {\n414\t            name: \"level\",\n415\t            params: vec![(ZSTD_c_compressionLevel, lvl)],\n416\t        });\n417\t    }\n418\t    // window log extremes (valid range)\n419\t    for &wl in &[10, 11, 15, 20, 27] {\n420\t        v.push(Cfg {\n421\t            name: \"windowLog\",\n422\t            params: vec![(ZSTD_c_windowLog, wl)],\n423\t        });\n424\t    }\n425\t    v\n426\t}\n427\t\n428\t/// Phase B core: for each configuration, drive `ZSTD_compress2` through the\n429\t/// low-level cctx API on many randomized inputs and require byte-identical\n430\t/// frames, then require the frame to decode back to the input in both libs.\n431\t#[test]\n432\tfn compress2_configurations_match() {\n433\t    let i = impls();\n434\t    let (c_new, r_new) = i.pair::<Fn_createCCtx>(\"ZSTD_createCCtx\");\n435\t    let (c_free, r_free) = i.pair::<Fn_freeCCtx>(\"ZSTD_freeCCtx\");\n436\t    let (c_set, r_set) = i.pair::<Fn_setParam>(\"ZSTD_CCtx_setParameter\");\n437\t    let (c_rst, r_rst) = i.pair::<Fn_reset>(\"ZSTD_CCtx_reset\");\n438\t    let (c_c2, r_c2) = i.pair::<Fn_compress2>(\"ZSTD_compress2\");\n439\t    let (c_bound, _) = i.pair::<Fn_bound>(\"ZSTD_compressBound\");\n440\t    let (c_isE, _) = i.pair::<unsafe extern \"C\" fn(usize) -> u32>(\"ZSTD_isError\");\n441\t\n442\t    let (cd_new, rd_new) = i.pair::<Fn_createDCtx>(\"ZSTD_createDCtx\");\n443\t    let (cd_free, rd_free) = i.pair::<Fn_freeDCtx>(\"ZSTD_freeDCtx\");\n444\t    let (cd_dec, rd_dec) = i.pair::<Fn_decompressDCtx>(\"ZSTD_decompressDCtx\");\n445\t    let (cd_set, rd_set) = i.pair::<Fn_dSetParam>(\"ZSTD_DCtx_setParameter\");\n446\t\n447\t    let cc = unsafe { c_new() };\n448\t    let rc = unsafe { r_new() };\n449\t    let cd = unsafe { cd_new() };\n450\t    let rd = unsafe { rd_new() };\n451\t\n452\t    let mut rng = Rng::new(0x5EED_1234);\n453\t\n454\t    for cfg in configurations() {\n455\t        // several randomized inputs per configuration row\n456\t        for trial in 0..6 {\n457\t            let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n458\t            let len = match trial {\n459\t                0 => 0,\n460\t                1 => 1,\n461\t                2 => rng.range(2, 300),\n462\t                3 => rng.range(300, 20_000),\n463\t                4 => rng.range(120_000, 140_000),\n464\t                _ => rng.range(200_000, 400_000),\n465\t            };\n466\t            let src = gen_shape(shape, len, &mut rng);\n467\t\n468\t            unsafe {\n469\t                c_rst(cc, ZSTD_reset_session_and_parameters);\n470\t                r_rst(rc, ZSTD_reset_session_and_parameters);\n471\t            }\n472\t\n473\t            let mut magicless = false;\n474\t            let mut skip = false;\n475\t            for &(id, val) in &cfg.params {\n476\t                let (a, b) = unsafe { (c_set(cc, id, val), r_set(rc, id, val)) };\n477\t                assert_eq_dbg(\n478\t                    &format!(\"[{}] setParameter({id},{val})\", cfg.name),\n479\t                    a,\n480\t                    b,\n481\t                );\n482\t                if unsafe { c_isE(a) } != 0 {\n483\t                    // both rejected identically; nothing to compress for this row\n484\t                    skip = true;\n485\t                }\n486\t                if id == ZSTD_c_format && val == ZSTD_f_zstd1_magicless {\n487\t                    magicless = true;\n488\t                }\n489\t            }\n490\t            if skip {\n491\t                continue;\n492\t            }\n493\t\n494\t            let cap = unsafe { c_bound(len) } + 64;\n495\t            let mut cb = vec![0xA5u8; cap];\n496\t            let mut rb = vec![0x5Au8; cap];\n497\t            let cn = unsafe { c_c2(cc, cb.as_mut_ptr(), cap, src.as_ptr(), len) };\n498\t            let rn = unsafe { r_c2(rc, rb.as_mut_ptr(), cap, src.as_ptr(), len) };\n499\t\n500\t            let tag = format!(\n501\t                \"[{}] params={:?} shape={shape:?} len={len}\",\n502\t                cfg.name, cfg.params\n503\t            );\n504\t            assert_eq_dbg(&tag, cn, rn);\n505\t            if unsafe { c_isE(cn) } != 0 {\n506\t                continue; // identical rejection, verified above\n507\t            }\n508\t            assert_bytes_eq(&tag, &cb[..cn], &rb[..rn]);\n509\t\n510\t            // round trip through both decoders (magicless frames need the dctx flag)\n511\t            let mut d1 = vec![0u8; len + 64];\n512\t            let mut d2 = vec![0u8; len + 64];\n513\t            unsafe {\n514\t                cd_set(cd, ZSTD_d_format, if magicless { 1 } else { 0 });\n515\t                rd_set(rd, ZSTD_d_format, if magicless { 1 } else { 0 });\n516\t                let a = cd_dec(cd, d1.as_mut_ptr(), d1.len(), cb.as_ptr(), cn);\n517\t                let b = rd_dec(rd, d2.as_mut_ptr(), d2.len(), rb.as_ptr(), rn);\n518\t                assert_eq_dbg(&format!(\"{tag} / decode rc\"), a, b);\n519\t                assert_eq_dbg(&format!(\"{tag} / decode len\"), a, len);\n520\t                assert_bytes_eq(&format!(\"{tag} / payload\"), &src, &d1[..a]);\n521\t                assert_bytes_eq(&format!(\"{tag} / payload\"), &src, &d2[..b]);\n522\t            }\n523\t        }\n524\t    }\n525\t\n526\t    unsafe {\n527\t        c_free(cc);\n528\t        r_free(rc);\n529\t        cd_free(cd);\n530\t        rd_free(rd);\n531\t    }\n532\t}\n533\t\n534\t/// `ZSTD_CCtx_setParametersUsingCCtxParams` — the params-object path into a cctx\n535\t/// must produce the same frames as setting the parameters directly.\n536\t#[test]\n537\tfn set_parameters_using_cctxparams_matches() {\n538\t    let i = impls();\n539\t    let (c_new, r_new) = i.pair::<Fn_createCCtx>(\"ZSTD_createCCtx\");\n540\t    let (c_free, r_free) = i.pair::<Fn_freeCCtx>(\"ZSTD_freeCCtx\");\n541\t    let (c_pnew, r_pnew) = i.pair::<Fn_createParams>(\"ZSTD_createCCtxParams\");\n542\t    let (c_pfree, r_pfree) = i.pair::<Fn_freeParams>(\"ZSTD_freeCCtxParams\");\n543\t    let (c_pset, r_pset) = i.pair::<Fn_paramsSet>(\"ZSTD_CCtxParams_setParameter\");\n544\t    let (c_apply, r_apply) =\n545\t        i.pair::<Fn_setParamsUsingCCtxParams>(\"ZSTD_CCtx_setParametersUsingCCtxParams\");\n546\t    let (c_rst, r_rst) = i.pair::<Fn_reset>(\"ZSTD_CCtx_reset\");\n547\t    let (c_c2, r_c2) = i.pair::<Fn_compress2>(\"ZSTD_compress2\");\n548\t    let (c_bound, _) = i.pair::<Fn_bound>(\"ZSTD_compressBound\");\n549\t\n550\t    let cc = unsafe { c_new() };\n551\t    let rc = unsafe { r_new() };\n552\t    let cp = unsafe { c_pnew() };\n553\t    let rp = unsafe { r_pnew() };\n554\t\n555\t    let mut rng = Rng::new(0xABCD_0001);\n556\t    for cfg in configurations() {\n557\t        for _ in 0..3 {\n558\t            let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n559\t            let len = rng.range(0, 40_000);\n560\t            let src = gen_shape(shape, len, &mut rng);\n561\t\n562\t            unsafe {\n563\t                c_rst(cc, ZSTD_reset_session_and_parameters);\n564\t                r_rst(rc, ZSTD_reset_session_and_parameters);\n565\t            }\n566\t            let mut bad = false;\n567\t            for &(id, val) in &cfg.params {\n568\t                let (a, b) = unsafe { (c_pset(cp, id, val), r_pset(rp, id, val)) };\n569\t                assert_eq_dbg(&format!(\"params set({id},{val})\"), a, b);\n570\t                if a > usize::MAX - 200 {\n571\t                    bad = true;\n572\t                }\n573\t            }\n574\t            let (a, b) = unsafe { (c_apply(cc, cp), r_apply(rc, rp)) };\n575\t            assert_eq_dbg(\"ZSTD_CCtx_setParametersUsingCCtxParams\", a, b);\n576\t            if bad || a > usize::MAX - 200 {\n577\t                continue;\n578\t            }\n579\t\n580\t            let cap = unsafe { c_bound(len) } + 64;\n581\t            let mut cb = vec![0u8; cap];\n582\t            let mut rb = vec![0u8; cap];\n583\t            let cn = unsafe { c_c2(cc, cb.as_mut_ptr(), cap, src.as_ptr(), len) };\n584\t            let rn = unsafe { r_c2(rc, rb.as_mut_ptr(), cap, src.as_ptr(), len) };\n585\t            let tag = format!(\"[{}] usingCCtxParams len={len} shape={shape:?}\", cfg.name);\n586\t            assert_eq_dbg(&tag, cn, rn);\n587\t            if cn <= usize::MAX - 200 {\n588\t                assert_bytes_eq(&tag, &cb[..cn], &rb[..rn]);\n589\t            }\n590\t        }\n591\t    }\n592\t\n593\t    unsafe {\n594\t        c_pfree(cp);\n595\t        r_pfree(rp);\n596\t        c_free(cc);\n597\t        r_free(rc);\n598\t    }\n599\t}\n600\t\n601\t/// `ZSTD_CCtx_setPledgedSrcSize` interacts with the frame header (content size\n602\t/// field) and is validated against the actual input length. Cover matching,\n603\t/// mismatching and unknown pledges — plus out-of-range reset directives.\n604\t#[test]\n605\tfn pledged_src_size_and_reset_directives() {\n606\t    let i = impls();\n607\t    let (c_new, r_new) = i.pair::<Fn_createCCtx>(\"ZSTD_createCCtx\");\n608\t    let (c_free, r_free) = i.pair::<Fn_freeCCtx>(\"ZSTD_freeCCtx\");\n609\t    let (c_pl, r_pl) = i.pair::<Fn_setPledged>(\"ZSTD_CCtx_setPledgedSrcSize\");\n610\t    let (c_rst, r_rst) = i.pair::<Fn_reset>(\"ZSTD_CCtx_reset\");\n611\t    let (c_c2, r_c2) = i.pair::<Fn_compress2>(\"ZSTD_compress2\");\n612\t    let (c_bound, _) = i.pair::<Fn_bound>(\"ZSTD_compressBound\");\n613\t\n614\t    let cc = unsafe { c_new() };\n615\t    let rc = unsafe { r_new() };\n616\t    let mut rng = Rng::new(0x9911);\n617\t\n618\t    // every reset directive, including out-of-range enum values\n619\t    for d in [-3i32, -1, 0, 1, 2, 3, 4, 7, i32::MAX, i32::MIN] {\n620\t        let (a, b) = unsafe { (c_rst(cc, d), r_rst(rc, d)) };\n621\t        assert_eq_dbg(&format!(\"ZSTD_CCtx_reset(directive={d})\"), a, b);\n622\t    }\n623\t\n624\t    for len in [0usize, 1, 100, 5000, 200_000] {\n625\t        let src = gen_shape(Shape::SkewedText, len, &mut rng);\n626\t        for pledge in [\n627\t            0u64,\n628\t            1,\n629\t            len as u64,\n630\t            len as u64 + 1,\n631\t            len.saturating_sub(1) as u64,\n632\t            1 << 40,\n633\t            ZSTD_CONTENTSIZE_UNKNOWN,\n634\t        ] {\n635\t            unsafe {\n636\t                c_rst(cc, ZSTD_reset_session_and_parameters);\n637\t                r_rst(rc, ZSTD_reset_session_and_parameters);\n638\t            }\n639\t            let (a, b) = unsafe { (c_pl(cc, pledge), r_pl(rc, pledge)) };\n640\t            assert_eq_dbg(&format!(\"setPledgedSrcSize({pledge})\"), a, b);\n641\t\n642\t            let cap = unsafe { c_bound(len) } + 64;\n643\t            let mut cb = vec![0u8; cap];\n644\t            let mut rb = vec![0u8; cap];\n645\t            let cn = unsafe { c_c2(cc, cb.as_mut_ptr(), cap, src.as_ptr(), len) };\n646\t            let rn = unsafe { r_c2(rc, rb.as_mut_ptr(), cap, src.as_ptr(), len) };\n647\t            let tag = format!(\"compress2 pledge={pledge} len={len}\");\n648\t            assert_eq_dbg(&tag, cn, rn);\n649\t            if cn <= usize::MAX - 200 {\n650\t                assert_bytes_eq(&tag, &cb[..cn], &rb[..rn]);\n651\t            }\n652\t        }\n653\t    }\n654\t\n655\t    unsafe {\n656\t        c_free(cc);\n657\t        r_free(rc);\n658\t    }\n659\t}\n660\t\n661\t/// Undersized destination buffers must produce the same `dstSize_tooSmall`\n662\t/// behaviour at every capacity from 0 up to the exact frame size.\n663\t#[test]\n664\tfn compress2_dst_too_small_matches() {\n665\t    let i = impls();\n666\t    let (c_new, r_new) = i.pair::<Fn_createCCtx>(\"ZSTD_createCCtx\");\n667\t    let (c_free, r_free) = i.pair::<Fn_freeCCtx>(\"ZSTD_freeCCtx\");\n668\t    let (c_rst, r_rst) = i.pair::<Fn_reset>(\"ZSTD_CCtx_reset\");\n669\t    let (c_c2, r_c2) = i.pair::<Fn_compress2>(\"ZSTD_compress2\");\n670\t    let (c_bound, _) = i.pair::<Fn_bound>(\"ZSTD_compressBound\");\n671\t    let (c_cd, r_cd) = i.pair::<unsafe extern \"C\" fn(usize) -> i32>(\"ZSTD_getErrorCode\");\n672\t\n673\t    let cc = unsafe { c_new() };\n674\t    let rc = unsafe { r_new() };\n675\t    let mut rng = Rng::new(0x4242);\n676\t\n677\t    for &shape in &[Shape::Random, Shape::Constant, Shape::SkewedText] {\n678\t        let len = 3000;\n679\t        let src = gen_shape(shape, len, &mut rng);\n680\t        let full = {\n681\t            unsafe {\n682\t                c_rst(cc, ZSTD_reset_session_and_parameters);\n683\t            }\n684\t            let cap = unsafe { c_bound(len) };\n685\t            let mut b = vec![0u8; cap];\n686\t            unsafe { c_c2(cc, b.as_mut_ptr(), cap, src.as_ptr(), len) }\n687\t        };\n688\t\n689\t        for cap in 0..=full {\n690\t            unsafe {\n691\t                c_rst(cc, ZSTD_reset_session_and_parameters);\n692\t                r_rst(rc, ZSTD_reset_session_and_parameters);\n693\t            }\n694\t            let mut cb = vec![0u8; cap.max(1)];\n695\t            let mut rb = vec![0u8; cap.max(1)];\n696\t            let a = unsafe { c_c2(cc, cb.as_mut_ptr(), cap, src.as_ptr(), len) };\n697\t            let b = unsafe { r_c2(rc, rb.as_mut_ptr(), cap, src.as_ptr(), len) };\n698\t            let tag = format!(\"compress2 shape={shape:?} dstCapacity={cap} (full={full})\");\n699\t            assert_eq_dbg(&tag, a, b);\n700\t            unsafe { assert_eq_dbg(&format!(\"{tag} errcode\"), c_cd(a), r_cd(b)) };\n701\t        }\n702\t    }\n703\t\n704\t    unsafe {\n705\t        c_free(cc);\n706\t        r_free(rc);\n707\t    }\n708\t}\n709\t"}]},"parent_tool_use_id":"toolu_bdrk_01RUHBTGsvDTu3wkCWYcgZdT","session_id":"73cb0b47-bb13-46d2-9cdb-cbadffb29d99","uuid":"fe4ce86a-d564-4762-a3b9-7f03952e7bcc","timestamp":"2026-08-31T10:44:09.627Z","subagent_type":"general-purpose","task_description":"DictBuilder differential tests"}
