unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n350\t    do_object_update_recursive:\n351\t        unsafe extern \"C\" fn(*mut json_t, *mut json_t, *mut hashtable_t) -> c_int,\n352\t    json_object_iter: unsafe extern \"C\" fn(*mut json_t) -> *mut c_void,\n353\t    json_object_iter_at: unsafe extern \"C\" fn(*mut json_t, *const c_char) -> *mut c_void,\n354\t    json_object_key_to_iter: unsafe extern \"C\" fn(*const c_char) -> *mut c_void,\n355\t    json_object_iter_next: unsafe extern \"C\" fn(*mut json_t, *mut c_void) -> *mut c_void,\n356\t    json_object_iter_key: unsafe extern \"C\" fn(*mut c_void) -> *const c_char,\n357\t    json_object_iter_key_len: unsafe extern \"C\" fn(*mut c_void) -> size_t,\n358\t    json_object_iter_value: unsafe extern \"C\" fn(*mut c_void) -> *mut json_t,\n359\t    json_object_iter_set_new: unsafe extern \"C\" fn(*mut json_t, *mut c_void, *mut json_t) -> c_int,\n360\t\n361\t    // ---- value.c: array ----\n362\t    json_array_size: unsafe extern \"C\" fn(*const json_t) -> size_t,\n363\t    json_array_get: unsafe extern \"C\" fn(*const json_t, size_t) -> *mut json_t,\n364\t    json_array_set_new: unsafe extern \"C\" fn(*mut json_t, size_t, *mut json_t) -> c_int,\n365\t    json_array_append_new: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n366\t    json_array_insert_new: unsafe extern \"C\" fn(*mut json_t, size_t, *mut json_t) -> c_int,\n367\t    json_array_remove: unsafe extern \"C\" fn(*mut json_t, size_t) -> c_int,\n368\t    json_array_clear: unsafe extern \"C\" fn(*mut json_t) -> c_int,\n369\t    json_array_extend: unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int,\n370\t\n371\t    // ---- value.c: scalars ----\n372\t    json_string_value: unsafe extern \"C\" fn(*const json_t) -> *const c_char,\n373\t    json_string_length: unsafe extern \"C\" fn(*const json_t) -> size_t,\n374\t    json_integer_value: unsafe extern \"C\" fn(*const json_t) -> json_int_t,\n375\t    json_real_value: unsafe extern \"C\" fn(*const json_t) -> c_double,\n376\t    json_number_value: unsafe extern \"C\" fn(*const json_t) -> c_double,\n377\t    json_string_set: unsafe extern \"C\" fn(*mut json_t, *const c_char) -> c_int,\n378\t    json_string_setn: unsafe extern \"C\" fn(*mut json_t, *const c_char, size_t) -> c_int,\n379\t    json_string_set_nocheck: unsafe extern \"C\" fn(*mut json_t, *const c_char) -> c_int,\n380\t    json_string_setn_nocheck: unsafe extern \"C\" fn(*mut json_t, *const c_char, size_t) -> c_int,\n381\t    json_integer_set: unsafe extern \"C\" fn(*mut json_t, json_int_t) -> c_int,\n382\t    json_real_set: unsafe extern \"C\" fn(*mut json_t, c_double) -> c_int,\n383\t\n384\t    // ---- value.c: equality / copying / loop check ----\n385\t    json_equal: unsafe extern \"C\" fn(*const json_t, *const json_t) -> c_int,\n386\t    json_copy: unsafe extern \"C\" fn(*mut json_t) -> *mut json_t,\n387\t    json_deep_copy: unsafe extern \"C\" fn(*const json_t) -> *mut json_t,\n388\t    do_deep_copy: unsafe extern \"C\" fn(*const json_t, *mut hashtable_t) -> *mut json_t,\n389\t    jsonp_loop_check: unsafe extern \"C\" fn(\n390\t        *mut hashtable_t, *const json_t, *mut c_char, size_t, *mut size_t) -> c_int,\n391\t\n392\t    // ---- strconv.c ----\n393\t    jsonp_strtod: unsafe extern \"C\" fn(*mut strbuffer_t, *mut c_double) -> c_int,\n394\t    jsonp_dtostr: unsafe extern \"C\" fn(*mut c_char, size_t, c_double, c_int) -> c_int,\n395\t\n396\t    // ---- dump.c ----\n397\t    json_dumps: unsafe extern \"C\" fn(*const json_t, size_t) -> *mut c_char,\n398\t    json_dumpb: unsafe extern \"C\" fn(*const json_t, *mut c_char, size_t, size_t) -> size_t,\n399\t    json_dumpf: unsafe extern \"C\" fn(*const json_t, *mut FILE, size_t) -> c_int,\n400\t    json_dumpfd: unsafe extern \"C\" fn(*const json_t, c_int, size_t) -> c_int,\n401\t    json_dump_file: unsafe extern \"C\" fn(*const json_t, *const c_char, size_t) -> c_int,\n402\t    json_dump_callback:\n403\t        unsafe extern \"C\" fn(*const json_t, json_dump_callback_t, *mut c_void, size_t) -> c_int,\n404\t\n405\t    // ---- load.c ----\n406\t    json_loads: unsafe extern \"C\" fn(*const c_char, size_t, *mut json_error_t) -> *mut json_t,\n407\t    json_loadb:\n408\t        unsafe extern \"C\" fn(*const c_char, size_t, size_t, *mut json_error_t) -> *mut json_t,\n409\t    json_loadf: unsafe extern \"C\" fn(*mut FILE, size_t, *mut json_error_t) -> *mut json_t,\n410\t    json_loadfd: unsafe extern \"C\" fn(c_int, size_t, *mut json_error_t) -> *mut json_t,\n411\t    json_load_file: unsafe extern \"C\" fn(*const c_char, size_t, *mut json_error_t) -> *mut json_t,\n412\t    json_load_callback: unsafe extern \"C\" fn(\n413\t        json_load_callback_t, *mut c_void, size_t, *mut json_error_t) -> *mut json_t,\n414\t\n415\t    // ---- pack_unpack.c ----\n416\t    json_pack: unsafe extern \"C\" fn(*const c_char, ...) -> *mut json_t,\n417\t    json_pack_ex: unsafe extern \"C\" fn(*mut json_error_t, size_t, *const c_char, ...) -> *mut json_t,\n418\t    json_vpack_ex:\n419\t        unsafe extern \"C\" fn(*mut json_error_t, size_t, *const c_char, *mut c_void) -> *mut json_t,\n420\t    json_unpack: unsafe extern \"C\" fn(*mut json_t, *const c_char, ...) -> c_int,\n421\t    json_unpack_ex:\n422\t        unsafe extern \"C\" fn(*mut json_t, *mut json_error_t, size_t, *const c_char, ...) -> c_int,\n423\t    json_vunpack_ex: unsafe extern \"C\" fn(\n424\t        *mut json_t, *mut json_error_t, size_t, *const c_char, *mut c_void) -> c_int,\n425\t    json_sprintf: unsafe extern \"C\" fn(*const c_char, ...) -> *mut json_t,\n426\t    json_vsprintf: unsafe extern \"C\" fn(*const c_char, *mut c_void) -> *mut json_t,\n427\t\n428\t    // ---- dtoa.c ----\n429\t    dtoa: unsafe extern \"C\" fn(\n430\t        c_double, c_int, c_int, *mut c_int, *mut c_int, *mut *mut c_char) -> *mut c_char,\n431\t    dtoa_r: unsafe extern \"C\" fn(\n432\t        c_double, c_int, c_int, *mut c_int, *mut c_int, *mut *mut c_char,\n433\t        *mut c_char, size_t) -> *mut c_char,\n434\t    freedtoa: unsafe extern \"C\" fn(*mut c_char),\n435\t    // `gethex` returns VOID in this dtoa variant (it stores the parsed value\n436\t    // through `rvp` and advances `*sp`); it does not return a status code.\n437\t    gethex: unsafe extern \"C\" fn(*mut *const c_char, *mut c_void, c_int, c_int),\n438\t    strtod__unused: unsafe extern \"C\" fn(*const c_char, *mut *mut c_char) -> c_double,\n439\t}\n440\t\n441\timpl Api {\n442\t    fn lib(&self) -> &'static Library {\n443\t        if self.which == \"C\" {\n444\t            c_library()\n445\t        } else {\n446\t            rust_library()\n447\t        }\n448\t    }\n449\t\n450\t    /// `dtoa_divmax` is exported as *data* (`nm` reports `D`), not a function.\n451\t    pub fn dtoa_divmax(&self) -> c_int {\n452\t        unsafe { **self.lib().get::<*mut c_int>(b\"dtoa_divmax\\0\").unwrap() }\n453\t    }\n454\t\n455\t    /// `hashtable_seed` is exported as *data* — `volatile uint32_t`\n456\t    /// (`nm` reports `B`). Reading it is how tests confirm that\n457\t    /// `json_object_seed` actually installed the seed, and that both libraries\n458\t    /// ended up with the SAME seed (without which no object dump could be\n459\t    /// compared byte-for-byte).\n460\t    pub fn hashtable_seed(&self) -> u32 {\n461\t        unsafe { **self.lib().get::<*mut u32>(b\"hashtable_seed\\0\").unwrap() }\n462\t    }\n463\t}\n464\t\n465\t// ---------------------------------------------------------------------------\n466\t// Library loading\n467\t// ---------------------------------------------------------------------------\n468\t\n469\tfn repo_root() -> std::path::PathBuf {\n470\t    // CARGO_MANIFEST_DIR == <root>/translation\n471\t    std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\"))\n472\t        .parent()\n473\t        .expect(\"translation/ has a parent\")\n474\t        .to_path_buf()\n475\t}\n476\t\n477\tfn c_library() -> &'static Library {\n478\t    static L: OnceLock<Library> = OnceLock::new();\n479\t    L.get_or_init(|| {\n480\t        let p = repo_root().join(\"c_src/build/libjansson.so\");\n481\t        assert!(\n482\t            p.exists(),\n483\t            \"C shared library not found at {}. Build it with:\\n  \\\n484\t             cd c_src && mkdir -p build && cd build && \\\n485\t             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n486\t            p.display()\n487\t        );\n488\t        unsafe { Library::new(&p) }.expect(\"failed to dlopen the C libjansson.so\")\n489\t    })\n490\t}\n491\t\n492\tfn rust_library() -> &'static Library {\n493\t    static L: OnceLock<Library> = OnceLock::new();\n494\t    L.get_or_init(|| {\n495\t        let p = repo_root().join(\"translation/target/release/libjansson.so\");\n496\t        assert!(\n497\t            p.exists(),\n498\t            \"Rust shared library not found at {}. Build it with:\\n  \\\n499\t             cd translation && cargo build --release\",\n500\t            p.display()\n501\t        );\n502\t        assert_not_stale(&p);\n503\t        unsafe { Library::new(&p) }.expect(\"failed to dlopen the Rust libjansson.so\")\n504\t    })\n505\t}\n506\t\n507\t/// Refuse to run against a stale `.so`.\n508\t///\n509\t/// This guard matters more than it looks: `cargo test --test <name>` does NOT\n510\t/// rebuild the `cdylib`, because the integration test does not *link* it — it\n511\t/// `dlopen`s it at run time, so cargo sees no dependency. Without this check a\n512\t/// source fix could appear to pass (or a regression appear to be absent) while\n513\t/// the tests were actually exercising an older library.\n514\tfn assert_not_stale(so: &std::path::Path) {\n515\t    let so_time = match so.metadata().and_then(|m| m.modified()) {\n516\t        Ok(t) => t,\n517\t        Err(_) => return,\n518\t    };\n519\t    let src = repo_root().join(\"translation/src\");\n520\t    let mut newest: Option<(std::time::SystemTime, std::path::PathBuf)> = None;\n521\t    if let Ok(entries) = std::fs::read_dir(&src) {\n522\t        for e in entries.flatten() {\n523\t            if e.path().extension().and_then(|s| s.to_str()) != Some(\"rs\") {\n524\t                continue;\n525\t            }\n526\t            if let Ok(t) = e.metadata().and_then(|m| m.modified()) {\n527\t                if newest.as_ref().map_or(true, |(bt, _)| t > *bt) {\n528\t                    newest = Some((t, e.path()));\n529\t                }\n530\t            }\n531\t        }\n532\t    }\n533\t    if let Some((t, path)) = newest {\n534\t        assert!(\n535\t            t <= so_time,\n536\t            \"STALE Rust .so — {} is newer than {}.\\n\\\n537\t             `cargo test --test <name>` does not rebuild the cdylib. Run:\\n  \\\n538\t             cd translation && cargo build --release\\n\\\n539\t             (or use ../run_tests.sh, which rebuilds both libraries first).\",\n540\t            path.display(),\n541\t            so.display()\n542\t        );\n543\t    }\n544\t}\n545\t\n546\t// ---------------------------------------------------------------------------\n547\t// va_list trampolines (see tests/vashim.c)\n548\t// ---------------------------------------------------------------------------\n549\t\n550\t/// The four `va_list`-taking entry points cannot be called from stable Rust\n551\t/// directly, so a small C shim turns a variadic call into a real `va_list` and\n552\t/// forwards it to whichever implementation's function pointer we hand it.\n553\tpub struct VaShim {\n554\t    pub vpack_ex: unsafe extern \"C\" fn(*mut c_void, *mut json_error_t, size_t, *const c_char, ...)\n555\t        -> *mut json_t,\n556\t    pub vunpack_ex: unsafe extern \"C\" fn(\n557\t        *mut c_void,\n558\t        *mut json_t,\n559\t        *mut json_error_t,\n560\t        size_t,\n561\t        *const c_char,\n562\t        ...\n563\t    ) -> c_int,\n564\t    pub vsprintf: unsafe extern \"C\" fn(*mut c_void, *const c_char, ...) -> *mut json_t,\n565\t    pub error_vset: unsafe extern \"C\" fn(\n566\t        *mut c_void,\n567\t        *mut json_error_t,\n568\t        c_int,\n569\t        c_int,\n570\t        size_t,\n571\t        c_int,\n572\t        *const c_char,\n573\t        ...\n574\t    ),\n575\t}\n576\t\n577\tpub fn vashim() -> &'static VaShim {\n578\t    static L: OnceLock<Library> = OnceLock::new();\n579\t    static S: OnceLock<VaShim> = OnceLock::new();\n580\t    let lib = L.get_or_init(|| {\n581\t        let p = repo_root().join(\".work/libvashim.so\");\n582\t        assert!(\n583\t            p.exists(),\n584\t            \"va_list shim not built. Build it with:\\n  \\\n585\t             cc -shared -fPIC -O1 -o .work/libvashim.so translation/tests/vashim.c\"\n586\t        );\n587\t        unsafe { Library::new(&p) }.expect(\"failed to dlopen libvashim.so\")\n588\t    });\n589\t    S.get_or_init(|| unsafe {\n590\t        VaShim {\n591\t            vpack_ex: *lib.get(b\"shim_vpack_ex\\0\").unwrap(),\n592\t            vunpack_ex: *lib.get(b\"shim_vunpack_ex\\0\").unwrap(),\n593\t            vsprintf: *lib.get(b\"shim_vsprintf\\0\").unwrap(),\n594\t            error_vset: *lib.get(b\"shim_error_vset\\0\").unwrap(),\n595\t        }\n596\t    })\n597\t}\n598\t\n599\t/// The `json_vpack_ex` function pointer of a given library, as a `void *` to\n600\t/// hand to the shim.\n601\tpub fn sym_addr(which: &str, name: &[u8]) -> *mut c_void {\n602\t    let lib = if which == \"C\" { c_library() } else { rust_library() };\n603\t    let mut owned = name.to_vec();\n604\t    owned.push(0);\n605\t    unsafe { *lib.get::<*mut c_void>(&owned).unwrap() }\n606\t}\n607\t\n608\t/// The C implementation's API (the ground truth).\n609\tpub fn capi() -> &'static Api {\n610\t    static A: OnceLock<Api> = OnceLock::new();\n611\t    A.get_or_init(|| Api::load(c_library(), \"C\"))\n612\t}\n613\t\n614\t/// The Rust implementation's API (under test).\n615\tpub fn rapi() -> &'static Api {\n616\t    static A: OnceLock<Api> = OnceLock::new();\n617\t    A.get_or_init(|| Api::load(rust_library(), \"Rust\"))\n618\t}\n619\t\n620\t/// Both APIs, with a deterministic hash seed already installed in each so that\n621\t/// hashtable bucket order — and therefore object iteration order — is\n622\t/// reproducible and directly comparable between the two libraries.\n623\t///\n624\t/// jansson seeds its hash function from `/dev/urandom`/time-of-day on first\n625\t/// use, so without this every run (and each library within a run) would order\n626\t/// object keys differently and no dump could be compared byte-for-byte.\n627\tpub fn both() -> (&'static Api, &'static Api) {\n628\t    static SEEDED: OnceLock<()> = OnceLock::new();\n629\t    SEEDED.get_or_init(|| unsafe {\n630\t        (capi().json_object_seed)(FIXED_SEED);\n631\t        (rapi().json_object_seed)(FIXED_SEED);\n632\t    });\n633\t    (capi(), rapi())\n634\t}\n635\t\n636\t/// Fixed, non-zero seed. Non-zero matters: `json_object_seed(0)` asks jansson\n637\t/// to generate a *random* seed instead of using the value given.\n638\tpub const FIXED_SEED: size_t = 0x5eed_1234;\n639\t\n640\t// ---------------------------------------------------------------------------\n641\t// Small helpers\n642\t// ---------------------------------------------------------------------------\n643\t\n644\tpub fn cs(s: &str) -> CString {\n645\t    CString::new(s).expect(\"test string contains an interior NUL; use cs_bytes\")\n646\t}\n647\t\n648\t/// A NUL-terminated buffer that may contain interior NUL bytes.\n649\tpub fn cs_bytes(b: &[u8]) -> Vec<c_char> {\n650\t    let mut v: Vec<c_char> = b.iter().map(|&x| x as c_char).collect();\n651\t    v.push(0);\n652\t    v\n653\t}\n654\t\n655\tpub fn cstr_lossy(p: *const c_char) -> String {\n656\t    if p.is_null() {\n657\t        return \"<NULL>\".to_string();\n658\t    }\n659\t    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()\n660\t}\n661\t\n662\t/// Read a NUL-terminated C string as raw bytes (no UTF-8 assumption). `None`\n663\t/// for a NULL pointer, so \"returned NULL\" and \"returned empty\" stay distinct.\n664\tpub fn cbytes(p: *const c_char) -> Option<Vec<u8>> {\n665\t    if p.is_null() {\n666\t        None\n667\t    } else {\n668\t        Some(unsafe { CStr::from_ptr(p) }.to_bytes().to_vec())\n669\t    }\n670\t}\n671\t\n672\t/// `json_incref` — a `static inline` in jansson.h, so it is not exported and\n673\t/// has to be reproduced here exactly.\n674\tpub unsafe fn incref(json: *mut json_t) -> *mut json_t {\n675\t    if !json.is_null() && (*json).refcount != usize::MAX {\n676\t        (*json).refcount += 1;\n677\t    }\n678\t    json\n679\t}\n680\t\n681\t/// `json_decref` — likewise `static inline` in jansson.h. Calls the *matching*\n682\t/// library's `json_delete`, which is why it takes the api.\n683\tpub unsafe fn decref(api: &Api, json: *mut json_t) {\n684\t    if !json.is_null() && (*json).refcount != usize::MAX {\n685\t        (*json).refcount -= 1;\n686\t        if (*json).refcount == 0 {\n687\t            (api.json_delete)(json);\n688\t        }\n689\t    }\n690\t}\n691\t\n692\tpub unsafe fn typeof_(json: *const json_t) -> c_int {\n693\t    (*json).type_\n694\t}\n695\t\n696\t/// Free a `char *` that jansson allocated, using that library's allocator.\n697\tpub unsafe fn jfree(api: &Api, p: *mut c_void) {\n698\t    if !p.is_null() {\n699\t        (api.jsonp_free)(p);\n700\t    }\n701\t}\n702\t\n703\t// ---------------------------------------------------------------------------\n704\t// Serialisation of process-global library state\n705\t// ---------------------------------------------------------------------------\n706\t\n707\t/// Guard for library state that is PROCESS-GLOBAL and, in the C, not\n708\t/// thread-safe. Cargo runs the `#[test]` functions of one binary on several\n709\t/// threads, so any test touching such state must hold this lock for its whole\n710\t/// body.\n711\t///\n712\t/// Two distinct pieces of state need it:\n713\t///\n714\t/// 1. **dtoa's `Balloc`/`Bfree` freelist.** `dtoa.c` is compiled WITHOUT\n715\t///    `MULTIPLE_THREADS` defined (see the `#ifdef MULTIPLE_THREADS` block that\n716\t///    makes `MTa`/`MTb`/`MTd` expand to nothing), so `freelist[]` is a plain\n717\t///    global with no locking. Concurrent `dtoa`/`dtoa_r`/`freedtoa` calls\n718\t///    corrupt it and abort with `free(): invalid pointer`. This is a property\n719\t///    of the C library, not of the translation.\n720\t///\n721\t/// 2. **The allocator function pointers** (`do_malloc`/`do_realloc`/`do_free`\n722\t///    in memory.c). `json_set_alloc_funcs*` mutates globals, so a test that\n723\t///    installs a failing allocator would break any test allocating concurrently.\n724\t///\n725\t/// Call it as the first statement of such a test and bind the guard so it lives\n726\t/// for the whole function:\n727\t///\n728\t/// ```ignore\n729\t/// let _g = global_state_lock();\n730\t/// ```\n731\tpub fn global_state_lock() -> std::sync::MutexGuard<'static, ()> {\n732\t    static LOCK: OnceLock<std::sync::Mutex<()>> = OnceLock::new();\n733\t    // Recover from a poisoned lock: a panicking test has already reported its\n734\t    // own failure, and blocking every later test behind it would only hide\n735\t    // additional divergences.\n736\t    match LOCK.get_or_init(|| std::sync::Mutex::new(())).lock() {\n737\t        Ok(g) => g,\n738\t        Err(p) => p.into_inner(),\n739\t    }\n740\t}\n741\t\n742\t// ---------------------------------------------------------------------------\n743\t// Deterministic PRNG (no external rand dependency)\n744\t// ---------------------------------------------------------------------------\n745\t\n746\t/// SplitMix64 — small, fast, and identical across runs for a given seed, so\n747\t/// every property-style test is reproducible.\n748\tpub struct Rng(pub u64);\n749\t\n750\timpl Rng {\n751\t    pub fn new(seed: u64) -> Rng {\n752\t        Rng(seed ^ 0x9E37_79B9_7F4A_7C15)\n753\t    }\n754\t\n755\t    pub fn next_u64(&mut self) -> u64 {\n756\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n757\t        let mut z = self.0;\n758\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n759\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n760\t        z ^ (z >> 31)\n761\t    }\n762\t\n763\t    pub fn next_u32(&mut self) -> u32 {\n764\t        (self.next_u64() >> 32) as u32\n765\t    }\n766\t\n767\t    /// Uniform in `[0, n)`.\n768\t    pub fn below(&mut self, n: usize) -> usize {\n769\t        if n == 0 {\n770\t            0\n771\t        } else {\n772\t            (self.next_u64() % n as u64) as usize\n773\t        }\n774\t    }\n775\t\n776\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n777\t        if hi <= lo {\n778\t            return lo;\n779\t        }\n780\t        lo + (self.next_u64() % (hi - lo) as u64) as i64\n781\t    }\n782\t\n783\t    pub fn bool(&mut self) -> bool {\n784\t        self.next_u64() & 1 == 1\n785\t    }\n786\t\n787\t    pub fn choice<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n788\t        &xs[self.below(xs.len())]\n789\t    }\n790\t\n791\t    /// A `json_int_t` drawn from a distribution that emphasises the boundary\n792\t    /// values the C code special-cases, not just \"some number in the middle\".\n793\t    pub fn json_int(&mut self) -> json_int_t {\n794\t        match self.below(10) {\n795\t            0 => 0,\n796\t            1 => 1,\n797\t            2 => -1,\n798\t            3 => i32::MAX as i64,\n799\t            4 => i32::MIN as i64,\n800\t            5 => i64::MAX,\n801\t            6 => i64::MIN,\n802\t            7 => self.range(-1000, 1000),\n803\t            8 => self.next_u32() as i64,\n804\t            _ => self.next_u64() as i64,\n805\t        }\n806\t    }\n807\t\n808\t    /// A `double` biased towards the values dtoa/strtod treat specially.\n809\t    pub fn real(&mut self) -> f64 {\n810\t        match self.below(14) {\n811\t            0 => 0.0,\n812\t            1 => -0.0,\n813\t            2 => 1.0,\n814\t            3 => -1.0,\n815\t            4 => 0.1,\n816\t            5 => 1.0 / 3.0,\n817\t            6 => f64::MIN_POSITIVE,\n818\t            7 => f64::MAX,\n819\t            8 => 5e-324,               // smallest subnormal\n820\t            9 => 1e308,\n821\t            10 => 1e-308,\n822\t            11 => 2.2250738585072011e-308, // the classic strtod bug value\n823\t            12 => (self.next_u32() as f64) / 7.0,\n824\t            _ => {\n825\t                // A random finite bit pattern — the widest possible coverage.\n826\t                loop {\n827\t                    let b = self.next_u64();\n828\t                    let d = f64::from_bits(b);\n829\t                    if d.is_finite() {\n830\t                        return d;\n831\t                    }\n832\t                }\n833\t            }\n834\t        }\n835\t    }\n836\t\n837\t    /// A random string biased towards bytes that the encoder/parser branch on.\n838\t    pub fn ascii_string(&mut self, maxlen: usize) -> String {\n839\t        const POOL: &[u8] = b\"abcXYZ019 _-.:/\\\\\\\"'\\t\\n\\r{}[],~`!@#$%^&*()+=|<>?;\";\n840\t        let n = self.below(maxlen + 1);\n841\t        (0..n).map(|_| *self.choice(POOL) as char).collect()\n842\t    }\n843\t\n844\t    /// A random *valid* UTF-8 string spanning 1-, 2-, 3- and 4-byte sequences\n845\t    /// plus the control characters the dumper has to escape.\n846\t    pub fn utf8_string(&mut self, maxlen: usize) -> String {\n847\t        let n = self.below(maxlen + 1);\n848\t        let mut s = String::new();\n849\t        for _ in 0..n {\n850\t            let c = match self.below(8) {\n851\t                0 => self.below(0x20) as u32,           // control chars\n852\t                1 | 2 => 0x20 + self.below(0x5f) as u32, // printable ASCII\n853\t                3 => 0x80 + self.below(0x780) as u32,   // 2-byte\n854\t                4 => 0x800 + self.below(0xf000) as u32, // 3-byte\n855\t                5 => 0x10000 + self.below(0xf_0000) as u32, // 4-byte\n856\t                6 => *self.choice(&[0x22u32, 0x5c, 0x2f, 0x08, 0x0c, 0x0a, 0x0d, 0x09]),\n857\t                _ => *self.choice(&[0x7f_u32, 0x80, 0x7ff, 0x800, 0xffff, 0x10000, 0x10ffff]),\n858\t            };\n859\t            if let Some(ch) = char::from_u32(c) {\n860\t                s.push(ch);\n861\t            }\n862\t        }\n863\t        s\n864\t    }\n865\t}\n866\t\n867\t// ---------------------------------------------------------------------------\n868\t// Assertion helper\n869\t// ---------------------------------------------------------------------------\n870\t\n871\t/// Assert two values match, printing the configuration that produced them.\n872\t#[macro_export]\n873\tmacro_rules! diff_eq {\n874\t    ($c:expr, $r:expr, $($ctx:tt)*) => {{\n875\t        let cv = $c;\n876\t        let rv = $r;\n877\t        if cv != rv {\n878\t            panic!(\n879\t                \"C/Rust divergence [{}]\\n  C    = {:?}\\n  Rust = {:?}\",\n880\t                format!($($ctx)*), cv, rv\n881\t            );\n882\t        }\n883\t    }};\n884\t}\n885\t"}]},"parent_tool_use_id":"toolu_bdrk_013vS8kQHFk8DCEET4qNhUpR","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"18390d5e-f770-4438-a6ee-9e9f386c63d7","timestamp":"2026-08-31T04:26:57.808Z","subagent_type":"general-purpose","task_description":"Phase C error tests for dump.c"}
