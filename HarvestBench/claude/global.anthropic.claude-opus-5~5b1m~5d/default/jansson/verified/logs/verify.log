{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011BkdXjSBhuwBkQgp5AdjRT","type":"tool_result","content":"1\t/*\n2\t * Copyright (c) 2009-2016 Petri Lehtinen <petri@digip.org>\n3\t *\n4\t * This library is free software; you can redistribute it and/or modify\n5\t * it under the terms of the MIT license. See LICENSE for details.\n6\t */\n7\t\n8\t#ifndef HASHTABLE_H\n9\t#define HASHTABLE_H\n10\t\n11\t#include \"jansson.h\"\n12\t#include <stdlib.h>\n13\t\n14\tstruct hashtable_list {\n15\t    struct hashtable_list *prev;\n16\t    struct hashtable_list *next;\n17\t};\n18\t\n19\t/* \"pair\" may be a bit confusing a name, but think of it as a\n20\t   key-value pair. In this case, it just encodes some extra data,\n21\t   too */\n22\tstruct hashtable_pair {\n23\t    struct hashtable_list list;\n24\t    struct hashtable_list ordered_list;\n25\t    size_t hash;\n26\t    json_t *value;\n27\t    size_t key_len;\n28\t    char key[1];\n29\t};\n30\t\n31\tstruct hashtable_bucket {\n32\t    struct hashtable_list *first;\n33\t    struct hashtable_list *last;\n34\t};\n35\t\n36\ttypedef struct hashtable {\n37\t    size_t size;\n38\t    struct hashtable_bucket *buckets;\n39\t    size_t order; /* hashtable has pow(2, order) buckets */\n40\t    struct hashtable_list list;\n41\t    struct hashtable_list ordered_list;\n42\t} hashtable_t;\n43\t\n44\t#define hashtable_key_to_iter(key_)                                                      \\\n45\t    (&(container_of(key_, struct hashtable_pair, key)->ordered_list))\n46\t\n47\t/**\n48\t * hashtable_init - Initialize a hashtable object\n49\t *\n50\t * @hashtable: The (statically allocated) hashtable object\n51\t *\n52\t * Initializes a statically allocated hashtable object. The object\n53\t * should be cleared with hashtable_close when it's no longer used.\n54\t *\n55\t * Returns 0 on success, -1 on error (out of memory).\n56\t */\n57\tint hashtable_init(hashtable_t *hashtable) JANSSON_ATTRS((warn_unused_result));\n58\t\n59\t/**\n60\t * hashtable_close - Release all resources used by a hashtable object\n61\t *\n62\t * @hashtable: The hashtable\n63\t *\n64\t * Destroys a statically allocated hashtable object.\n65\t */\n66\tvoid hashtable_close(hashtable_t *hashtable);\n67\t\n68\t/**\n69\t * hashtable_set - Add/modify value in hashtable\n70\t *\n71\t * @hashtable: The hashtable object\n72\t * @key: The key\n73\t * @key_len: The length of key\n74\t * @value: The value\n75\t *\n76\t * If a value with the given key already exists, its value is replaced\n77\t * with the new value. Value is \"stolen\" in the sense that hashtable\n78\t * doesn't increment its refcount but decreases the refcount when the\n79\t * value is no longer needed.\n80\t *\n81\t * Returns 0 on success, -1 on failure (out of memory).\n82\t */\n83\tint hashtable_set(hashtable_t *hashtable, const char *key, size_t key_len, json_t *value);\n84\t\n85\t/**\n86\t * hashtable_get - Get a value associated with a key\n87\t *\n88\t * @hashtable: The hashtable object\n89\t * @key: The key\n90\t * @key_len: The length of key\n91\t *\n92\t * Returns value if it is found, or NULL otherwise.\n93\t */\n94\tvoid *hashtable_get(hashtable_t *hashtable, const char *key, size_t key_len);\n95\t\n96\t/**\n97\t * hashtable_del - Remove a value from the hashtable\n98\t *\n99\t * @hashtable: The hashtable object\n100\t * @key: The key\n101\t * @key_len: The length of key\n102\t *\n103\t * Returns 0 on success, or -1 if the key was not found.\n104\t */\n105\tint hashtable_del(hashtable_t *hashtable, const char *key, size_t key_len);\n106\t\n107\t/**\n108\t * hashtable_clear - Clear hashtable\n109\t *\n110\t * @hashtable: The hashtable object\n111\t *\n112\t * Removes all items from the hashtable.\n113\t */\n114\tvoid hashtable_clear(hashtable_t *hashtable);\n115\t\n116\t/**\n117\t * hashtable_iter - Iterate over hashtable\n118\t *\n119\t * @hashtable: The hashtable object\n120\t *\n121\t * Returns an opaque iterator to the first element in the hashtable.\n122\t * The iterator should be passed to hashtable_iter_* functions.\n123\t * The hashtable items are not iterated over in any particular order.\n124\t *\n125\t * There's no need to free the iterator in any way. The iterator is\n126\t * valid as long as the item that is referenced by the iterator is not\n127\t * deleted. Other values may be added or deleted. In particular,\n128\t * hashtable_iter_next() may be called on an iterator, and after that\n129\t * the key/value pair pointed by the old iterator may be deleted.\n130\t */\n131\tvoid *hashtable_iter(hashtable_t *hashtable);\n132\t\n133\t/**\n134\t * hashtable_iter_at - Return an iterator at a specific key\n135\t *\n136\t * @hashtable: The hashtable object\n137\t * @key: The key that the iterator should point to\n138\t * @key_len: The length of key\n139\t *\n140\t * Like hashtable_iter() but returns an iterator pointing to a\n141\t * specific key.\n142\t */\n143\tvoid *hashtable_iter_at(hashtable_t *hashtable, const char *key, size_t key_len);\n144\t\n145\t/**\n146\t * hashtable_iter_next - Advance an iterator\n147\t *\n148\t * @hashtable: The hashtable object\n149\t * @iter: The iterator\n150\t *\n151\t * Returns a new iterator pointing to the next element in the\n152\t * hashtable or NULL if the whole hastable has been iterated over.\n153\t */\n154\tvoid *hashtable_iter_next(hashtable_t *hashtable, void *iter);\n155\t\n156\t/**\n157\t * hashtable_iter_key - Retrieve the key pointed by an iterator\n158\t *\n159\t * @iter: The iterator\n160\t */\n161\tvoid *hashtable_iter_key(void *iter);\n162\t\n163\t/**\n164\t * hashtable_iter_key_len - Retrieve the key length pointed by an iterator\n165\t *\n166\t * @iter: The iterator\n167\t */\n168\tsize_t hashtable_iter_key_len(void *iter);\n169\t\n170\t/**\n171\t * hashtable_iter_value - Retrieve the value pointed by an iterator\n172\t *\n173\t * @iter: The iterator\n174\t */\n175\tvoid *hashtable_iter_value(void *iter);\n176\t\n177\t/**\n178\t * hashtable_iter_set - Set the value pointed by an iterator\n179\t *\n180\t * @iter: The iterator\n181\t * @value: The value to set\n182\t */\n183\tvoid hashtable_iter_set(void *iter, json_t *value);\n184\t\n185\t#endif\n186\t"}]},"parent_tool_use_id":"toolu_bdrk_01G6qq686ckBYHo1U8w8uRtV","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"5d55cd2e-9840-4ded-ba77-0e822721716e","timestamp":"2026-08-31T03:50:52.505Z","subagent_type":"general-purpose","task_description":"CONFIGS part 3: low-level modules"}
