{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LDnge9ririnpqqaoZkQmwz","type":"tool_result","content":"1\t//! Differential tests for src/value.c — the value model itself.\n2\t//!\n3\t//! Coverage target: CONFIGS.md rows 164-226.\n4\t//!\n5\t//! Every comparison uses a *full* observable snapshot of the value (see `Snap`):\n6\t//! type tag, `refcount`, container sizes, the internal capacity/order fields,\n7\t//! scalar payloads (integers exactly, reals as bit patterns so `-0.0` stays\n8\t//! distinct), both canonical dumps (`JSON_SORT_KEYS|JSON_ENCODE_ANY` and the\n9\t//! insertion-order `JSON_ENCODE_ANY`) and the complete ordered child list\n10\t//! (object: key bytes + key_len + per-child dump; array: element list).\n11\t//!\n12\t//! The object iteration order is the fingerprint of the hashtable behaviour, so\n13\t//! it is compared explicitly everywhere rather than only via the sorted dump.\n14\t\n15\tmod common;\n16\tuse common::*;\n17\tuse std::ffi::{c_char, c_int, c_void};\n18\t\n19\t// ---------------------------------------------------------------------------\n20\t// Raw private layouts (jansson_private.h) so tests can observe the capacity /\n21\t// hashtable order fields that are part of the documented growth rules.\n22\t// ---------------------------------------------------------------------------\n23\t\n24\t#[repr(C)]\n25\tstruct json_array_raw {\n26\t    json: json_t,\n27\t    size: size_t,\n28\t    entries: size_t,\n29\t    table: *mut *mut json_t,\n30\t}\n31\t\n32\t#[repr(C)]\n33\tstruct json_object_raw {\n34\t    json: json_t,\n35\t    hashtable: hashtable_t,\n36\t}\n37\t\n38\tunsafe fn arr_cap(j: *const json_t) -> size_t {\n39\t    if j.is_null() || typeof_(j) != JSON_ARRAY {\n40\t        return 0;\n41\t    }\n42\t    (*(j as *const json_array_raw)).size\n43\t}\n44\t\n45\tunsafe fn obj_order(j: *const json_t) -> size_t {\n46\t    if j.is_null() || typeof_(j) != JSON_OBJECT {\n47\t        return 0;\n48\t    }\n49\t    (*(j as *const json_object_raw)).hashtable.order\n50\t}\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// Byte strings that print readably in divergence messages.\n54\t// ---------------------------------------------------------------------------\n55\t\n56\t#[derive(PartialEq, Eq, Clone)]\n57\tstruct B(Vec<u8>);\n58\t\n59\timpl std::fmt::Debug for B {\n60\t    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {\n61\t        write!(f, \"b\\\"\")?;\n62\t        for &x in &self.0 {\n63\t            match x {\n64\t                b'\"' => write!(f, \"\\\\\\\"\")?,\n65\t                b'\\\\' => write!(f, \"\\\\\\\\\")?,\n66\t                0x20..=0x7e => write!(f, \"{}\", x as char)?,\n67\t                _ => write!(f, \"\\\\x{x:02x}\")?,\n68\t            }\n69\t        }\n70\t        write!(f, \"\\\"\")\n71\t    }\n72\t}\n73\t\n74\tconst CANON: size_t = JSON_SORT_KEYS | JSON_ENCODE_ANY;\n75\tconst RAWD: size_t = JSON_ENCODE_ANY;\n76\t\n77\t/// `json_dumps` as raw bytes, freed with the matching allocator. `None` means\n78\t/// the dump failed (NULL), which is itself an observable to compare.\n79\tunsafe fn dump(api: &Api, j: *const json_t, flags: size_t) -> Option<B> {\n80\t    if j.is_null() {\n81\t        return None;\n82\t    }\n83\t    let p = (api.json_dumps)(j, flags);\n84\t    let b = cbytes(p).map(B);\n85\t    jfree(api, p as *mut c_void);\n86\t    b\n87\t}\n88\t\n89\t/// Both canonical forms: sorted keys (structural) and raw insertion order.\n90\tunsafe fn canon(api: &Api, j: *const json_t) -> (Option<B>, Option<B>) {\n91\t    (dump(api, j, CANON), dump(api, j, RAWD))\n92\t}\n93\t\n94\t/// One child of a container. The dumps are the structural fingerprint, but they\n95\t/// are NULL whenever the subtree holds invalid UTF-8, so the scalar payloads are\n96\t/// recorded separately and compared byte-exactly as well.\n97\t#[derive(Debug, PartialEq, Clone)]\n98\tstruct Kid {\n99\t    key: Option<B>,\n100\t    key_len: size_t,\n101\t    ty: c_int,\n102\t    refcount: size_t,\n103\t    osize: size_t,\n104\t    asize: size_t,\n105\t    slen: size_t,\n106\t    sbytes: Option<B>,\n107\t    ival: i64,\n108\t    rbits: u64,\n109\t    sorted: Option<B>,\n110\t    raw: Option<B>,\n111\t}\n112\t\n113\tunsafe fn kid(api: &Api, key: Option<B>, klen: size_t, v: *mut json_t) -> Kid {\n114\t    if v.is_null() {\n115\t        return Kid {\n116\t            key,\n117\t            key_len: klen,\n118\t            ty: -1,\n119\t            refcount: 0,\n120\t            osize: 0,\n121\t            asize: 0,\n122\t            slen: 0,\n123\t            sbytes: None,\n124\t            ival: 0,\n125\t            rbits: 0,\n126\t            sorted: None,\n127\t            raw: None,\n128\t        };\n129\t    }\n130\t    let (s, w) = canon(api, v);\n131\t    let slen = (api.json_string_length)(v);\n132\t    let sp = (api.json_string_value)(v);\n133\t    Kid {\n134\t        key,\n135\t        key_len: klen,\n136\t        ty: typeof_(v),\n137\t        refcount: (*v).refcount,\n138\t        osize: (api.json_object_size)(v),\n139\t        asize: (api.json_array_size)(v),\n140\t        slen,\n141\t        sbytes: if sp.is_null() {\n142\t            None\n143\t        } else {\n144\t            Some(B((0..slen).map(|i| *(sp as *const u8).add(i)).collect()))\n145\t        },\n146\t        ival: (api.json_integer_value)(v),\n147\t        rbits: (api.json_real_value)(v).to_bits(),\n148\t        sorted: s,\n149\t        raw: w,\n150\t    }\n151\t}\n152\t\n153\t/// Everything observable about a value, one level deep (children summarised by\n154\t/// their own dumps, so cyclic graphs cannot blow the stack — `json_dumps`\n155\t/// itself rejects cycles and returns NULL in both libraries).\n156\t#[derive(Debug, PartialEq, Clone)]\n157\tstruct Snap {\n158\t    ty: c_int,\n159\t    refcount: size_t,\n160\t    osize: size_t,\n161\t    asize: size_t,\n162\t    order: size_t,\n163\t    cap: size_t,\n164\t    slen: size_t,\n165\t    sbytes: Option<B>,\n166\t    ival: i64,\n167\t    rbits: u64,\n168\t    nbits: u64,\n169\t    sorted: Option<B>,\n170\t    raw: Option<B>,\n171\t    kids: Vec<Kid>,\n172\t}\n173\t\n174\tunsafe fn snap(api: &Api, j: *mut json_t) -> Snap {\n175\t    let ty = if j.is_null() { -1 } else { typeof_(j) };\n176\t    let refcount = if j.is_null() { 0 } else { (*j).refcount };\n177\t    let slen = (api.json_string_length)(j);\n178\t    let sp = (api.json_string_value)(j);\n179\t    let sbytes = if sp.is_null() {\n180\t        None\n181\t    } else {\n182\t        Some(B((0..slen).map(|i| *(sp as *const u8).add(i)).collect()))\n183\t    };\n184\t    let (sorted, raw) = canon(api, j);\n185\t\n186\t    let mut kids: Vec<Kid> = Vec::new();\n187\t    if ty == JSON_OBJECT {\n188\t        let mut it = (api.json_object_iter)(j);\n189\t        while !it.is_null() {\n190\t            let kp = (api.json_object_iter_key)(it);\n191\t            let kl = (api.json_object_iter_key_len)(it);\n192\t            let key = if kp.is_null() {\n193\t                None\n194\t            } else {\n195\t                Some(B((0..kl).map(|i| *(kp as *const u8).add(i)).collect()))\n196\t            };\n197\t            let v = (api.json_object_iter_value)(it);\n198\t            kids.push(kid(api, key, kl, v));\n199\t            it = (api.json_object_iter_next)(j, it);\n200\t        }\n201\t    } else if ty == JSON_ARRAY {\n202\t        let n = (api.json_array_size)(j);\n203\t        for i in 0..n {\n204\t            kids.push(kid(api, None, i, (api.json_array_get)(j, i)));\n205\t        }\n206\t    }\n207\t\n208\t    Snap {\n209\t        ty,\n210\t        refcount,\n211\t        osize: (api.json_object_size)(j),\n212\t        asize: (api.json_array_size)(j),\n213\t        order: obj_order(j),\n214\t        cap: arr_cap(j),\n215\t        slen,\n216\t        sbytes,\n217\t        ival: (api.json_integer_value)(j),\n218\t        rbits: (api.json_real_value)(j).to_bits(),\n219\t        nbits: (api.json_number_value)(j).to_bits(),\n220\t        sorted,\n221\t        raw,\n222\t        kids,\n223\t    }\n224\t}\n225\t\n226\t/// Compare two values produced by the two libraries.\n227\tunsafe fn cmp(c: &Api, r: &Api, cj: *mut json_t, rj: *mut json_t, ctx: &str) {\n228\t    diff_eq!(cj.is_null(), rj.is_null(), \"{}: NULL-ness of result\", ctx);\n229\t    diff_eq!(snap(c, cj), snap(r, rj), \"{}\", ctx);\n230\t}\n231\t\n232\t/// Compare, then release both values.\n233\tunsafe fn cmp_free(c: &Api, r: &Api, cj: *mut json_t, rj: *mut json_t, ctx: &str) {\n234\t    cmp(c, r, cj, rj, ctx);\n235\t    decref(c, cj);\n236\t    decref(r, rj);\n237\t}\n238\t\n239\t/// Count pointer identities shared between two trees, ignoring the three\n240\t/// singletons (which are *always* shared, by design).\n241\tunsafe fn count_shared(api: &Api, a: *mut json_t, b: *mut json_t) -> usize {\n242\t    if a.is_null() || b.is_null() {\n243\t        return 0;\n244\t    }\n245\t    let t = typeof_(a);\n246\t    let mut n = 0usize;\n247\t    if a == b && t != JSON_TRUE && t != JSON_FALSE && t != JSON_NULL {\n248\t        n += 1;\n249\t    }\n250\t    if t == JSON_OBJECT && typeof_(b) == JSON_OBJECT {\n251\t        let mut it = (api.json_object_iter)(a);\n252\t        while !it.is_null() {\n253\t            let kp = (api.json_object_iter_key)(it);\n254\t            let kl = (api.json_object_iter_key_len)(it);\n255\t            let av = (api.json_object_iter_value)(it);\n256\t            let bv = (api.json_object_getn)(b, kp, kl);\n257\t            n += count_shared(api, av, bv);\n258\t            it = (api.json_object_iter_next)(a, it);\n259\t        }\n260\t    } else if t == JSON_ARRAY && typeof_(b) == JSON_ARRAY {\n261\t        let m = (api.json_array_size)(a).min((api.json_array_size)(b));\n262\t        for i in 0..m {\n263\t            n += count_shared(api, (api.json_array_get)(a, i), (api.json_array_get)(b, i));\n264\t        }\n265\t    }\n266\t    n\n267\t}\n268\t\n269\t// ---------------------------------------------------------------------------\n270\t// Value \"recipes\": build byte-identical trees in both libraries.\n271\t// ---------------------------------------------------------------------------\n272\t\n273\t#[derive(Clone, Debug)]\n274\tenum V {\n275\t    Obj(Vec<(Vec<u8>, V)>),\n276\t    Arr(Vec<V>),\n277\t    Str(Vec<u8>),\n278\t    Int(i64),\n279\t    Real(f64),\n280\t    True,\n281\t    False,\n282\t    Null,\n283\t}\n284\t\n285\tunsafe fn build(api: &Api, v: &V) -> *mut json_t {\n286\t    match v {\n287\t        V::Obj(kids) => {\n288\t            let o = (api.json_object)();\n289\t            for (k, sub) in kids {\n290\t                let child = build(api, sub);\n291\t                (api.json_object_setn_new_nocheck)(o, k.as_ptr() as *const c_char, k.len(), child);\n292\t            }\n293\t            o\n294\t        }\n295\t        V::Arr(kids) => {\n296\t            let a = (api.json_array)();\n297\t            for sub in kids {\n298\t                (api.json_array_append_new)(a, build(api, sub));\n299\t            }\n300\t            a\n301\t        }\n302\t        V::Str(b) => (api.json_stringn_nocheck)(b.as_ptr() as *const c_char, b.len()),\n303\t        V::Int(n) => (api.json_integer)(*n),\n304\t        V::Real(x) => (api.json_real)(*x),\n305\t        V::True => (api.json_true)(),\n306\t        V::False => (api.json_false)(),\n307\t        V::Null => (api.json_null)(),\n308\t    }\n309\t}\n310\t\n311\t/// A random scalar recipe (always dumpable: keys/strings are valid UTF-8).\n312\tfn rand_scalar(rng: &mut Rng) -> V {\n313\t    match rng.below(6) {\n314\t        0 => V::Str(rng.utf8_string(12).into_bytes()),\n315\t        1 => V::Int(rng.json_int()),\n316\t        2 => V::Real(rng.real()),\n317\t        3 => V::True,\n318\t        4 => V::False,\n319\t        _ => V::Null,\n320\t    }\n321\t}\n322\t\n323\tfn rand_key(rng: &mut Rng) -> Vec<u8> {\n324\t    match rng.below(4) {\n325\t        0 => format!(\"k{}\", rng.below(10)).into_bytes(),\n326\t        1 => rng.utf8_string(6).into_bytes(),\n327\t        2 => Vec::new(),\n328\t        _ => rng.ascii_string(5).into_bytes(),\n329\t    }\n330\t}\n331\t\n332\tfn rand_value(rng: &mut Rng, depth: usize) -> V {\n333\t    if depth == 0 || rng.below(3) == 0 {\n334\t        return rand_scalar(rng);\n335\t    }\n336\t    if rng.bool() {\n337\t        let n = rng.below(6);\n338\t        V::Obj((0..n).map(|_| (rand_key(rng), rand_value(rng, depth - 1))).collect())\n339\t    } else {\n340\t        let n = rng.below(6);\n341\t        V::Arr((0..n).map(|_| rand_value(rng, depth - 1)).collect())\n342\t    }\n343\t}\n344\t\n345\t/// All eight types, in type-tag order.\n346\tfn all_eight() -> Vec<(&'static str, V)> {\n347\t    vec![\n348\t        (\"object\", V::Obj(vec![(b\"in\".to_vec(), V::Int(1))])),\n349\t        (\"array\", V::Arr(vec![V::Int(1), V::Str(b\"x\".to_vec())])),\n350\t        (\"string\", V::Str(b\"str\".to_vec())),\n351\t        (\"integer\", V::Int(-42)),\n352\t        (\"real\", V::Real(1.5)),\n353\t        (\"true\", V::True),\n354\t        (\"false\", V::False),\n355\t        (\"null\", V::Null),\n356\t    ]\n357\t}\n358\t\n359\t// A caller-allocated hashtable_t, for the direct `jsonp_loop_check` /\n360\t// `do_*_recursive` entry points.\n361\tstruct Ht<'a> {\n362\t    api: &'a Api,\n363\t    t: Box<hashtable_t>,\n364\t}\n365\t\n366\timpl<'a> Ht<'a> {\n367\t    unsafe fn new(api: &'a Api) -> Ht<'a> {\n368\t        let mut t = Box::new(hashtable_t::zeroed());\n369\t        assert_eq!((api.hashtable_init)(&mut *t), 0);\n370\t        Ht { api, t }\n371\t    }\n372\t    fn p(&mut self) -> *mut hashtable_t {\n373\t        &mut *self.t\n374\t    }\n375\t}\n376\t\n377\timpl Drop for Ht<'_> {\n378\t    fn drop(&mut self) {\n379\t        unsafe { (self.api.hashtable_close)(&mut *self.t) }\n380\t    }\n381\t}\n382\t\n383\t// ===========================================================================\n384\t// Row 164 / 165 / 166 — construction and initial state\n385\t// ===========================================================================\n386\t\n387\t#[test]\n388\tfn row164_json_object_fresh_state() {\n389\t    let _g = global_state_lock();\n390\t    let (c, r) = both();\n391\t    unsafe {\n392\t        for i in 0..8 {\n393\t            let cj = (c.json_object)();\n394\t            let rj = (r.json_object)();\n395\t            assert!(!cj.is_null() && !rj.is_null());\n396\t            // C ground truth: type tag, refcount 1, size 0, order 3 (8 buckets).\n397\t            assert_eq!(typeof_(cj), JSON_OBJECT, \"C: fresh object type\");\n398\t            assert_eq!((*cj).refcount, 1, \"C: fresh object refcount\");\n399\t            assert_eq!((c.json_object_size)(cj), 0, \"C: fresh object size\");\n400\t            assert_eq!(obj_order(cj), 3, \"C: INITIAL_HASHTABLE_ORDER\");"}]},"parent_tool_use_id":"toolu_bdrk_01GnKT4a7Vpx2yRpQPbdMyaQ","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"ef9f107c-dbf7-484e-a266-65354dcea575","timestamp":"2026-08-31T04:45:03.323Z","subagent_type":"general-purpose","task_description":"Phase C error tests for value.c"}
