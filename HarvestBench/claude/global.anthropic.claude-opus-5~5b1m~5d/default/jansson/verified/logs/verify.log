7\t        return NULL;\n68\t\n69\t    if (!hashtable_seed) {\n70\t        /* Autoseed */\n71\t        json_object_seed(0);\n72\t    }\n73\t\n74\t    json_init(&object->json, JSON_OBJECT);\n75\t\n76\t    if (hashtable_init(&object->hashtable)) {\n77\t        jsonp_free(object);\n78\t        return NULL;\n79\t    }\n80\t\n81\t    return &object->json;\n82\t}\n83\t\n84\tstatic void json_delete_object(json_object_t *object) {\n85\t    hashtable_close(&object->hashtable);\n86\t    jsonp_free(object);\n87\t}\n88\t\n89\tsize_t json_object_size(const json_t *json) {\n90\t    json_object_t *object;\n91\t\n92\t    if (!json_is_object(json))\n93\t        return 0;\n94\t\n95\t    object = json_to_object(json);\n96\t    return object->hashtable.size;\n97\t}\n98\t\n99\tjson_t *json_object_get(const json_t *json, const char *key) {\n100\t    if (!key)\n101\t        return NULL;\n102\t\n103\t    return json_object_getn(json, key, strlen(key));\n104\t}\n105\t\n106\tjson_t *json_object_getn(const json_t *json, const char *key, size_t key_len) {\n107\t    json_object_t *object;\n108\t\n109\t    if (!key || !json_is_object(json))\n110\t        return NULL;\n111\t\n112\t    object = json_to_object(json);\n113\t    return hashtable_get(&object->hashtable, key, key_len);\n114\t}\n115\t\n116\tint json_object_set_new_nocheck(json_t *json, const char *key, json_t *value) {\n117\t    if (!key) {\n118\t        json_decref(value);\n119\t        return -1;\n120\t    }\n121\t    return json_object_setn_new_nocheck(json, key, strlen(key), value);\n122\t}\n123\t\n124\tint json_object_setn_new_nocheck(json_t *json, const char *key, size_t key_len,\n125\t                                 json_t *value) {\n126\t    json_object_t *object;\n127\t\n128\t    if (!value)\n129\t        return -1;\n130\t\n131\t    if (!key || !json_is_object(json) || json == value) {\n132\t        json_decref(value);\n133\t        return -1;\n134\t    }\n135\t    object = json_to_object(json);\n136\t\n137\t    if (hashtable_set(&object->hashtable, key, key_len, value)) {\n138\t        json_decref(value);\n139\t        return -1;\n140\t    }\n141\t\n142\t    return 0;\n143\t}\n144\t\n145\tint json_object_set_new(json_t *json, const char *key, json_t *value) {\n146\t    if (!key) {\n147\t        json_decref(value);\n148\t        return -1;\n149\t    }\n150\t\n151\t    return json_object_setn_new(json, key, strlen(key), value);\n152\t}\n153\t\n154\tint json_object_setn_new(json_t *json, const char *key, size_t key_len, json_t *value) {\n155\t    if (!key || !utf8_check_string(key, key_len)) {\n156\t        json_decref(value);\n157\t        return -1;\n158\t    }\n159\t\n160\t    return json_object_setn_new_nocheck(json, key, key_len, value);\n161\t}\n162\t\n163\tint json_object_del(json_t *json, const char *key) {\n164\t    if (!key)\n165\t        return -1;\n166\t\n167\t    return json_object_deln(json, key, strlen(key));\n168\t}\n169\t\n170\tint json_object_deln(json_t *json, const char *key, size_t key_len) {\n171\t    json_object_t *object;\n172\t\n173\t    if (!key || !json_is_object(json))\n174\t        return -1;\n175\t\n176\t    object = json_to_object(json);\n177\t    return hashtable_del(&object->hashtable, key, key_len);\n178\t}\n179\t\n180\tint json_object_clear(json_t *json) {\n181\t    json_object_t *object;\n182\t\n183\t    if (!json_is_object(json))\n184\t        return -1;\n185\t\n186\t    object = json_to_object(json);\n187\t    hashtable_clear(&object->hashtable);\n188\t\n189\t    return 0;\n190\t}\n191\t\n192\tint json_object_update(json_t *object, json_t *other) {\n193\t    const char *key;\n194\t    size_t key_len;\n195\t    json_t *value;\n196\t\n197\t    if (!json_is_object(object) || !json_is_object(other))\n198\t        return -1;\n199\t\n200\t    json_object_keylen_foreach(other, key, key_len, value) {\n201\t        if (json_object_setn_nocheck(object, key, key_len, value))\n202\t            return -1;\n203\t    }\n204\t\n205\t    return 0;\n206\t}\n207\t\n208\tint json_object_update_existing(json_t *object, json_t *other) {\n209\t    const char *key;\n210\t    size_t key_len;\n211\t    json_t *value;\n212\t\n213\t    if (!json_is_object(object) || !json_is_object(other))\n214\t        return -1;\n215\t\n216\t    json_object_keylen_foreach(other, key, key_len, value) {\n217\t        if (json_object_getn(object, key, key_len))\n218\t            json_object_setn_nocheck(object, key, key_len, value);\n219\t    }\n220\t\n221\t    return 0;\n222\t}\n223\t\n224\tint json_object_update_missing(json_t *object, json_t *other) {\n225\t    const char *key;\n226\t    size_t key_len;\n227\t    json_t *value;\n228\t\n229\t    if (!json_is_object(object) || !json_is_object(other))\n230\t        return -1;\n231\t\n232\t    json_object_keylen_foreach(other, key, key_len, value) {\n233\t        if (!json_object_getn(object, key, key_len))\n234\t            json_object_setn_nocheck(object, key, key_len, value);\n235\t    }\n236\t\n237\t    return 0;\n238\t}\n239\t\n240\tint do_object_update_recursive(json_t *object, json_t *other, hashtable_t *parents) {\n241\t    const char *key;\n242\t    size_t key_len;\n243\t    json_t *value;\n244\t    char loop_key[LOOP_KEY_LEN];\n245\t    int res = 0;\n246\t    size_t loop_key_len;\n247\t\n248\t    if (!json_is_object(object) || !json_is_object(other))\n249\t        return -1;\n250\t\n251\t    if (jsonp_loop_check(parents, other, loop_key, sizeof(loop_key), &loop_key_len))\n252\t        return -1;\n253\t\n254\t    json_object_keylen_foreach(other, key, key_len, value) {\n255\t        json_t *v = json_object_getn(object, key, key_len);\n256\t\n257\t        if (json_is_object(v) && json_is_object(value)) {\n258\t            if (do_object_update_recursive(v, value, parents)) {\n259\t                res = -1;\n260\t                break;\n261\t            }\n262\t        } else {\n263\t            if (json_object_setn_nocheck(object, key, key_len, value)) {\n264\t                res = -1;\n265\t                break;\n266\t            }\n267\t        }\n268\t    }\n269\t\n270\t    hashtable_del(parents, loop_key, loop_key_len);\n271\t\n272\t    return res;\n273\t}\n274\t\n275\tint json_object_update_recursive(json_t *object, json_t *other) {\n276\t    int res;\n277\t    hashtable_t parents_set;\n278\t\n279\t    if (hashtable_init(&parents_set))\n280\t        return -1;\n281\t    res = do_object_update_recursive(object, other, &parents_set);\n282\t    hashtable_close(&parents_set);\n283\t\n284\t    return res;\n285\t}\n286\t\n287\tvoid *json_object_iter(json_t *json) {\n288\t    json_object_t *object;\n289\t\n290\t    if (!json_is_object(json))\n291\t        return NULL;\n292\t\n293\t    object = json_to_object(json);\n294\t    return hashtable_iter(&object->hashtable);\n295\t}\n296\t\n297\tvoid *json_object_iter_at(json_t *json, const char *key) {\n298\t    json_object_t *object;\n299\t\n300\t    if (!key || !json_is_object(json))\n301\t        return NULL;\n302\t\n303\t    object = json_to_object(json);\n304\t    return hashtable_iter_at(&object->hashtable, key, strlen(key));\n305\t}\n306\t\n307\tvoid *json_object_iter_next(json_t *json, void *iter) {\n308\t    json_object_t *object;\n309\t\n310\t    if (!json_is_object(json) || iter == NULL)\n311\t        return NULL;\n312\t\n313\t    object = json_to_object(json);\n314\t    return hashtable_iter_next(&object->hashtable, iter);\n315\t}\n316\t\n317\tconst char *json_object_iter_key(void *iter) {\n318\t    if (!iter)\n319\t        return NULL;\n320\t\n321\t    return hashtable_iter_key(iter);\n322\t}\n323\t\n324\tsize_t json_object_iter_key_len(void *iter) {\n325\t    if (!iter)\n326\t        return 0;\n327\t\n328\t    return hashtable_iter_key_len(iter);\n329\t}\n330\t\n331\tjson_t *json_object_iter_value(void *iter) {\n332\t    if (!iter)\n333\t        return NULL;\n334\t\n335\t    return (json_t *)hashtable_iter_value(iter);\n336\t}\n337\t\n338\tint json_object_iter_set_new(json_t *json, void *iter, json_t *value) {\n339\t    if (!json_is_object(json) || !iter || !value) {\n340\t        json_decref(value);\n341\t        return -1;\n342\t    }\n343\t\n344\t    hashtable_iter_set(iter, value);\n345\t    return 0;\n346\t}\n347\t\n348\tvoid *json_object_key_to_iter(const char *key) {\n349\t    if (!key)\n350\t        return NULL;\n351\t\n352\t    return hashtable_key_to_iter(key);\n353\t}\n354\t\n355\tstatic int json_object_equal(const json_t *object1, const json_t *object2) {\n356\t    const char *key;\n357\t    size_t key_len;\n358\t    const json_t *value1, *value2;\n359\t\n360\t    if (json_object_size(object1) != json_object_size(object2))\n361\t        return 0;\n362\t\n363\t    json_object_keylen_foreach((json_t *)object1, key, key_len, value1) {\n364\t        value2 = json_object_getn(object2, key, key_len);\n365\t\n366\t        if (!json_equal(value1, value2))\n367\t            return 0;\n368\t    }\n369\t\n370\t    return 1;\n371\t}\n372\t\n373\tstatic json_t *json_object_copy(json_t *object) {\n374\t    json_t *result;\n375\t\n376\t    const char *key;\n377\t    size_t key_len;\n378\t    json_t *value;\n379\t\n380\t    result = json_object();\n381\t    if (!result)\n382\t        return NULL;\n383\t\n384\t    json_object_keylen_foreach(object, key, key_len, value)\n385\t        json_object_setn_nocheck(result, key, key_len, value);\n386\t\n387\t    return result;\n388\t}\n389\t\n390\tstatic json_t *json_object_deep_copy(const json_t *object, hashtable_t *parents) {\n391\t    json_t *result;\n392\t    void *iter;\n393\t    char loop_key[LOOP_KEY_LEN];\n394\t    size_t loop_key_len;\n395\t\n396\t    if (jsonp_loop_check(parents, object, loop_key, sizeof(loop_key), &loop_key_len))\n397\t        return NULL;\n398\t\n399\t    result = json_object();\n400\t    if (!result)\n401\t        goto out;\n402\t\n403\t    /* Cannot use json_object_foreach because object has to be cast\n404\t       non-const */\n405\t    iter = json_object_iter((json_t *)object);\n406\t    while (iter) {\n407\t        const char *key;\n408\t        size_t key_len;\n409\t        const json_t *value;\n410\t        key = json_object_iter_key(iter);\n411\t        key_len = json_object_iter_key_len(iter);\n412\t        value = json_object_iter_value(iter);\n413\t\n414\t        if (json_object_setn_new_nocheck(result, key, key_len,\n415\t                                         do_deep_copy(value, parents))) {\n416\t            json_decref(result);\n417\t            result = NULL;\n418\t            break;\n419\t        }\n420\t        iter = json_object_iter_next((json_t *)object, iter);\n421\t    }\n422\t\n423\tout:\n424\t    hashtable_del(parents, loop_key, loop_key_len);\n425\t\n426\t    return result;\n427\t}\n428\t\n429\t/*** array ***/\n430\t\n431\tjson_t *json_array(void) {\n432\t    json_array_t *array = jsonp_malloc(sizeof(json_array_t));\n433\t    if (!array)\n434\t        return NULL;\n435\t    json_init(&array->json, JSON_ARRAY);\n436\t\n437\t    array->entries = 0;\n438\t    array->size = 8;\n439\t\n440\t    array->table = jsonp_malloc(array->size * sizeof(json_t *));\n441\t    if (!array->table) {\n442\t        jsonp_free(array);\n443\t        return NULL;\n444\t    }\n445\t\n446\t    return &array->json;\n447\t}\n448\t\n449\tstatic void json_delete_array(json_array_t *array) {\n450\t    size_t i;\n451\t\n452\t    for (i = 0; i < array->entries; i++)\n453\t        json_decref(array->table[i]);\n454\t\n455\t    jsonp_free(array->table);\n456\t    jsonp_free(array);\n457\t}\n458\t\n459\tsize_t json_array_size(const json_t *json) {\n460\t    if (!json_is_array(json))\n461\t        return 0;\n462\t\n463\t    return json_to_array(json)->entries;\n464\t}\n465\t\n466\tjson_t *json_array_get(const json_t *json, size_t index) {\n467\t    json_array_t *array;\n468\t    if (!json_is_array(json))\n469\t        return NULL;\n470\t    array = json_to_array(json);\n471\t\n472\t    if (index >= array->entries)\n473\t        return NULL;\n474\t\n475\t    return array->table[index];\n476\t}\n477\t\n478\tint json_array_set_new(json_t *json, size_t index, json_t *value) {\n479\t    json_array_t *array;\n480\t\n481\t    if (!value)\n482\t        return -1;\n483\t\n484\t    if (!json_is_array(json) || json == value) {\n485\t        json_decref(value);\n486\t        return -1;\n487\t    }\n488\t    array = json_to_array(json);\n489\t\n490\t    if (index >= array->entries) {\n491\t        json_decref(value);\n492\t        return -1;\n493\t    }\n494\t\n495\t    json_decref(array->table[index]);\n496\t    array->table[index] = value;\n497\t\n498\t    return 0;\n499\t}\n500\t\n501\tstatic void array_move(json_array_t *array, size_t dest, size_t src, size_t count) {\n502\t    memmove(&array->table[dest], &array->table[src], count * sizeof(json_t *));\n503\t}\n504\t\n505\tstatic void array_copy(json_t **dest, size_t dpos, json_t **src, size_t spos,\n506\t                       size_t count) {\n507\t    memcpy(&dest[dpos], &src[spos], count * sizeof(json_t *));\n508\t}\n509\t\n510\tstatic json_t **json_array_grow(json_array_t *array, size_t amount) {\n511\t    size_t new_size;\n512\t    json_t **old_table, **new_table;\n513\t\n514\t    if (array->entries + amount <= array->size)\n515\t        return array->table;\n516\t\n517\t    old_table = array->table;\n518\t\n519\t    new_size = max(array->size + amount, array->size * 2);\n520\t    new_table = jsonp_realloc(old_table, array->size * sizeof(json_t *),\n521\t                              new_size * sizeof(json_t *));\n522\t    if (!new_table)\n523\t        return NULL;\n524\t\n525\t    array->size = new_size;\n526\t    array->table = new_table;\n527\t\n528\t    return array->table;\n529\t}\n530\t\n531\tint json_array_append_new(json_t *json, json_t *value) {\n532\t    json_array_t *array;\n533\t\n534\t    if (!value)\n535\t        return -1;\n536\t\n537\t    if (!json_is_array(json) || json == value) {\n538\t        json_decref(value);\n539\t        return -1;\n540\t    }\n541\t    array = json_to_array(json);\n542\t\n543\t    if (!json_array_grow(array, 1)) {\n544\t        json_decref(value);\n545\t        return -1;\n546\t    }\n547\t\n548\t    array->table[array->entries] = value;\n549\t    array->entries++;\n550\t\n551\t    return 0;\n552\t}\n553\t\n554\tint json_array_insert_new(json_t *json, size_t index, json_t *value) {\n555\t    json_array_t *array;\n556\t\n557\t    if (!value)\n558\t        return -1;\n559\t\n560\t    if (!json_is_array(json) || json == value) {\n561\t        json_decref(value);\n562\t        return -1;\n563\t    }\n564\t    array = json_to_array(json);\n565\t\n566\t    if (index > array->entries) {\n567\t        json_decref(value);\n568\t        return -1;\n569\t    }\n570\t\n571\t    if (!json_array_grow(array, 1)) {\n572\t        json_decref(value);\n573\t        return -1;\n574\t    }\n575\t    if (index != array->entries)\n576\t        array_move(array, index + 1, index, array->entries - index);\n577\t\n578\t    array->table[index] = value;\n579\t    array->entries++;\n580\t\n581\t    return 0;\n582\t}\n583\t\n584\tint json_array_remove(json_t *json, size_t index) {\n585\t    json_array_t *array;\n586\t\n587\t    if (!json_is_array(json))\n588\t        return -1;\n589\t    array = json_to_array(json);\n590\t\n591\t    if (index >= array->entries)\n592\t        return -1;\n593\t\n594\t    json_decref(array->table[index]);\n595\t\n596\t    /* If we're removing the last element, nothing has to be moved */\n597\t    if (index < array->entries - 1)\n598\t        array_move(array, index, index + 1, array->entries - index - 1);\n599\t\n600\t    array->entries--;\n601\t\n602\t    return 0;\n603\t}\n604\t\n605\tint json_array_clear(json_t *json) {\n606\t    json_array_t *array;\n607\t    size_t i;\n608\t\n609\t    if (!json_is_array(json))\n610\t        return -1;\n611\t    array = json_to_array(json);\n612\t\n613\t    for (i = 0; i < array->entries; i++)\n614\t        json_decref(array->table[i]);\n615\t\n616\t    array->entries = 0;\n617\t    return 0;\n618\t}\n619\t\n620\tint json_array_extend(json_t *json, json_t *other_json) {\n621\t    json_array_t *array, *other;\n622\t    size_t i;\n623\t\n624\t    if (!json_is_array(json) || !json_is_array(other_json))\n625\t        return -1;\n626\t    array = json_to_array(json);\n627\t    other = json_to_array(other_json);\n628\t\n629\t    if (!json_array_grow(array, other->entries))\n630\t        return -1;\n631\t\n632\t    for (i = 0; i < other->entries; i++)\n633\t        json_incref(other->table[i]);\n634\t\n635\t    array_copy(array->table, array->entries, other->table, 0, other->entries);\n636\t\n637\t    array->entries += other->entries;\n638\t    return 0;\n639\t}\n640\t\n641\tstatic int json_array_equal(const json_t *array1, const json_t *array2) {\n642\t    size_t i, size;\n643\t\n644\t    size = json_array_size(array1);\n645\t    if (size != json_array_size(array2))\n646\t        return 0;\n647\t\n648\t    for (i = 0; i < size; i++) {\n649\t        json_t *value1, *value2;\n650\t\n651\t        value1 = json_array_get(array1, i);\n652\t        value2 = json_array_get(array2, i);\n653\t\n654\t        if (!json_equal(value1, value2))\n655\t            return 0;\n656\t    }\n657\t\n658\t    return 1;\n659\t}\n660\t\n661\tstatic json_t *json_array_copy(json_t *array) {\n662\t    json_t *result;\n663\t    size_t i;\n664\t\n665\t    result = json_array();\n666\t    if (!result)\n667\t        return NULL;\n668\t\n669\t    for (i = 0; i < json_array_size(array); i++)\n670\t        json_array_append(result, json_array_get(array, i));\n671\t\n672\t    return result;\n673\t}\n674\t\n675\tstatic json_t *json_array_deep_copy(const json_t *array, hashtable_t *parents) {\n676\t    json_t *result;\n677\t    size_t i;\n678\t    char loop_key[LOOP_KEY_LEN];\n679\t    size_t loop_key_len;\n680\t\n681\t    if (jsonp_loop_check(parents, array, loop_key, sizeof(loop_key), &loop_key_len))\n682\t        return NULL;\n683\t\n684\t    result = json_array();\n685\t    if (!result)\n686\t        goto out;\n687\t\n688\t    for (i = 0; i < json_array_size(array); i++) {\n689\t        if (json_array_append_new(result,\n690\t                                  do_deep_copy(json_array_get(array, i), parents))) {\n691\t            json_decref(result);\n692\t            result = NULL;\n693\t            break;\n694\t        }\n695\t    }\n696\t\n697\tout:\n698\t    hashtable_del(parents, loop_key, loop_key_len);\n699\t\n700\t    return result;\n701\t}\n702\t\n703\t/*** string ***/\n704\t\n705\tstatic json_t *string_create(const char *value, size_t len, int own) {\n706\t    char *v;\n707\t    json_string_t *string;\n708\t\n709\t    if (!value)\n710\t        return NULL;\n711\t\n712\t    if (own)\n713\t        v = (char *)value;\n714\t    else {\n715\t        v = jsonp_strndup(value, len);\n716\t        if (!v)\n717\t            return NULL;\n718\t    }\n719\t\n720\t    string = jsonp_malloc(sizeof(json_string_t));\n721\t    if (!string) {\n722\t        jsonp_free(v);\n723\t        return NULL;\n724\t    }\n725\t    json_init(&string->json, JSON_STRING);\n726\t    string->value = v;\n727\t    string->length = len;\n728\t\n729\t    return &string->json;\n730\t}\n731\t\n732\tjson_t *json_string_nocheck(const char *value) {\n733\t    if (!value)\n734\t        return NULL;\n735\t\n736\t    return string_create(value, strlen(value), 0);\n737\t}\n738\t\n739\tjson_t *json_stringn_nocheck(const char *value, size_t len) {\n740\t    return string_create(value, len, 0);\n741\t}\n742\t\n743\t/* this is private; \"steal\" is not a public API concept */\n744\tjson_t *jsonp_stringn_nocheck_own(const char *value, size_t len) {\n745\t    return string_create(value, len, 1);\n746\t}\n747\t\n748\tjson_t *json_string(const char *value) {\n749\t    if (!value)\n750\t        return NULL;\n751\t\n752\t    return json_stringn(value, strlen(value));\n753\t}\n754\t\n755\tjson_t *json_stringn(const char *value, size_t len) {\n756\t    if (!value || !utf8_check_s