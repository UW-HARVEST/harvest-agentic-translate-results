n843\t        return NULL;\n844\t\n845\t    next_token(&s);\n846\t    if (token(&s)) {\n847\t        json_decref(value);\n848\t        set_error(&s, \"<format>\", json_error_invalid_format,\n849\t                  \"Garbage after format string\");\n850\t        return NULL;\n851\t    }\n852\t\n853\t    return value;\n854\t}\n855\t\n856\tjson_t *json_pack_ex(json_error_t *error, size_t flags, const char *fmt, ...) {\n857\t    json_t *value;\n858\t    va_list ap;\n859\t\n860\t    va_start(ap, fmt);\n861\t    value = json_vpack_ex(error, flags, fmt, ap);\n862\t    va_end(ap);\n863\t\n864\t    return value;\n865\t}\n866\t\n867\tjson_t *json_pack(const char *fmt, ...) {\n868\t    json_t *value;\n869\t    va_list ap;\n870\t\n871\t    va_start(ap, fmt);\n872\t    value = json_vpack_ex(NULL, 0, fmt, ap);\n873\t    va_end(ap);\n874\t\n875\t    return value;\n876\t}\n877\t\n878\tint json_vunpack_ex(json_t *root, json_error_t *error, size_t flags, const char *fmt,\n879\t                    va_list ap) {\n880\t    scanner_t s;\n881\t    va_list ap_copy;\n882\t\n883\t    if (!root) {\n884\t        jsonp_error_init(error, \"<root>\");\n885\t        jsonp_error_set(error, -1, -1, 0, json_error_null_value, \"NULL root value\");\n886\t        return -1;\n887\t    }\n888\t\n889\t    if (!fmt || !*fmt) {\n890\t        jsonp_error_init(error, \"<format>\");\n891\t        jsonp_error_set(error, -1, -1, 0, json_error_invalid_argument,\n892\t                        \"NULL or empty format string\");\n893\t        return -1;\n894\t    }\n895\t    jsonp_error_init(error, NULL);\n896\t\n897\t    scanner_init(&s, error, flags, fmt);\n898\t    next_token(&s);\n899\t\n900\t    va_copy(ap_copy, ap);\n901\t    if (unpack(&s, root, &ap_copy)) {\n902\t        va_end(ap_copy);\n903\t        return -1;\n904\t    }\n905\t    va_end(ap_copy);\n906\t\n907\t    next_token(&s);\n908\t    if (token(&s)) {\n909\t        set_error(&s, \"<format>\", json_error_invalid_format,\n910\t                  \"Garbage after format string\");\n911\t        return -1;\n912\t    }\n913\t\n914\t    return 0;\n915\t}\n916\t\n917\tint json_unpack_ex(json_t *root, json_error_t *error, size_t flags, const char *fmt,\n918\t                   ...) {\n919\t    int ret;\n920\t    va_list ap;\n921\t\n922\t    va_start(ap, fmt);\n923\t    ret = json_vunpack_ex(root, error, flags, fmt, ap);\n924\t    va_end(ap);\n925\t\n926\t    return ret;\n927\t}\n928\t\n929\tint json_unpack(json_t *root, const char *fmt, ...) {\n930\t    int ret;\n931\t    va_list ap;\n932\t\n933\t    va_start(ap, fmt);\n934\t    ret = json_vunpack_ex(root, NULL, 0, fmt, ap);\n935\t    va_end(ap);\n936\t\n937\t    return ret;\n938\t}\n939\t"}]},"parent_tool_use_id":"toolu_bdrk_01VG6vBbkZAs1dk53yKz68VS","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"4af75a4a-9caa-42e2-8894-fa9464209f5d","timestamp":"2026-08-31T04:02:43.564Z","subagent_type":"general-purpose","task_description":"Phase B tests for pack_unpack.c"}
