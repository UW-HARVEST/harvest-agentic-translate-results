{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014cuNDuSPZfXsNaxjD4Pecq","type":"tool_result","content":"1\t//! Differential tests for src/hashtable.c and src/hashtable_seed.c.\n2\t//!\n3\t//! The hashtable is the single most order-sensitive part of the library: it\n4\t//! decides object iteration order, which in turn decides the byte layout of\n5\t//! every `json_dumps` of an object. That order depends on\n6\t//!   * `hashlittle()` (lookup3.h) producing the same 32-bit hash, and\n7\t//!   * the bucket/insert/rehash bookkeeping producing the same linked lists.\n8\t//! So these tests compare full iteration sequences, not just membership.\n9\t\n10\tmod common;\n11\tuse common::*;\n12\tuse std::ffi::{c_char, c_void};\n13\t\n14\t/// A caller-allocated `hashtable_t`, initialised through the library under\n15\t/// test and closed on drop.\n16\tstruct Ht<'a> {\n17\t    api: &'a Api,\n18\t    t: Box<hashtable_t>,\n19\t}\n20\t\n21\timpl<'a> Ht<'a> {\n22\t    unsafe fn new(api: &'a Api) -> (Ht<'a>, std::ffi::c_int) {\n23\t        let mut t = Box::new(hashtable_t::zeroed());\n24\t        let ret = (api.hashtable_init)(&mut *t);\n25\t        (Ht { api, t }, ret)\n26\t    }\n27\t\n28\t    fn p(&mut self) -> *mut hashtable_t {\n29\t        &mut *self.t\n30\t    }\n31\t\n32\t    unsafe fn set(&mut self, key: &[u8], value: *mut json_t) -> std::ffi::c_int {\n33\t        let api = self.api;\n34\t        (api.hashtable_set)(self.p(), key.as_ptr() as *const c_char, key.len(), value)\n35\t    }\n36\t\n37\t    unsafe fn get(&mut self, key: &[u8]) -> *mut c_void {\n38\t        let api = self.api;\n39\t        (api.hashtable_get)(self.p(), key.as_ptr() as *const c_char, key.len())\n40\t    }\n41\t\n42\t    unsafe fn del(&mut self, key: &[u8]) -> std::ffi::c_int {\n43\t        let api = self.api;\n44\t        (api.hashtable_del)(self.p(), key.as_ptr() as *const c_char, key.len())\n45\t    }\n46\t\n47\t    /// The full ordered iteration: (key bytes, key_len, integer value).\n48\t    /// Values are always `json_integer`s in these tests so the value can be\n49\t    /// compared as a plain number.\n50\t    unsafe fn iterate(&mut self) -> Vec<(Vec<u8>, size_t, i64)> {\n51\t        let api = self.api;\n52\t        let mut out = Vec::new();\n53\t        let mut it = (api.hashtable_iter)(self.p());\n54\t        while !it.is_null() {\n55\t            let kp = (api.hashtable_iter_key)(it) as *const c_char;\n56\t            let klen = (api.hashtable_iter_key_len)(it);\n57\t            let key: Vec<u8> = (0..klen).map(|i| *(kp as *const u8).add(i)).collect();\n58\t            let v = (api.hashtable_iter_value)(it) as *mut json_t;\n59\t            let n = if v.is_null() { i64::MIN } else { (api.json_integer_value)(v) };\n60\t            out.push((key, klen, n));\n61\t            it = (api.hashtable_iter_next)(self.p(), it);\n62\t        }\n63\t        out\n64\t    }\n65\t\n66\t    /// `size` and `order` are part of the observable state: `order` proves the\n67\t    /// rehash happened at the same moment in both implementations.\n68\t    fn state(&self) -> (size_t, size_t) {\n69\t        (self.t.size, self.t.order)\n70\t    }\n71\t}\n72\t\n73\timpl Drop for Ht<'_> {\n74\t    fn drop(&mut self) {\n75\t        unsafe {\n76\t            let api = self.api;\n77\t            (api.hashtable_close)(&mut *self.t);\n78\t        }\n79\t    }\n80\t}\n81\t\n82\t#[test]\n83\tfn seed_is_installed_identically_in_both_libraries() {\n84\t    // Everything else in this file depends on this: json_object_seed() is\n85\t    // one-shot (it only acts while hashtable_seed == 0), and `both()` calls it\n86\t    // with FIXED_SEED before anything else touches a hashtable.\n87\t    let (c, r) = both();\n88\t    assert_eq!(\n89\t        c.hashtable_seed(),\n90\t        FIXED_SEED as u32,\n91\t        \"C: json_object_seed did not install the fixed seed\"\n92\t    );\n93\t    diff_eq!(c.hashtable_seed(), r.hashtable_seed(), \"hashtable_seed value\");\n94\t}\n95\t\n96\t#[test]\n97\tfn json_object_seed_is_one_shot() {\n98\t    // A second call with a different value must be ignored, because the C only\n99\t    // seeds `if (hashtable_seed == 0)`.\n100\t    let (c, r) = both();\n101\t    unsafe {\n102\t        (c.json_object_seed)(0xAAAA_BBBB);\n103\t        (r.json_object_seed)(0xAAAA_BBBB);\n104\t    }\n105\t    diff_eq!(c.hashtable_seed(), r.hashtable_seed(), \"seed after second call\");\n106\t    assert_eq!(c.hashtable_seed(), FIXED_SEED as u32, \"C: seed must not change\");\n107\t}\n108\t\n109\t#[test]\n110\tfn hashtable_init_fresh_state() {\n111\t    let (c, r) = both();\n112\t    unsafe {\n113\t        let (ch, cret) = Ht::new(c);\n114\t        let (rh, rret) = Ht::new(r);\n115\t        diff_eq!(cret, rret, \"hashtable_init return\");\n116\t        // INITIAL_HASHTABLE_ORDER is 3 => 8 buckets.\n117\t        diff_eq!(ch.state(), rh.state(), \"state after init\");\n118\t        assert_eq!(ch.state(), (0, 3), \"C: fresh table is size 0, order 3\");\n119\t    }\n120\t}\n121\t\n122\t#[test]\n123\tfn hashtable_iter_on_empty_table_is_null() {\n124\t    let (c, r) = both();\n125\t    unsafe {\n126\t        let (mut ch, _) = Ht::new(c);\n127\t        let (mut rh, _) = Ht::new(r);\n128\t        diff_eq!(\n129\t            (c.hashtable_iter)(ch.p()).is_null(),\n130\t            (r.hashtable_iter)(rh.p()).is_null(),\n131\t            \"hashtable_iter on empty table\"\n132\t        );\n133\t        diff_eq!(ch.iterate(), rh.iterate(), \"iteration of empty table\");\n134\t    }\n135\t}\n136\t\n137\t#[test]\n138\tfn hashtable_get_and_del_on_absent_key() {\n139\t    let (c, r) = both();\n140\t    unsafe {\n141\t        let (mut ch, _) = Ht::new(c);\n142\t        let (mut rh, _) = Ht::new(r);\n143\t        ch.set(b\"present\", (c.json_integer)(1));\n144\t        rh.set(b\"present\", (r.json_integer)(1));\n145\t\n146\t        for key in [&b\"\"[..], b\"absent\", b\"presen\", b\"presentt\", b\"PRESENT\"] {\n147\t            diff_eq!(\n148\t                ch.get(key).is_null(),\n149\t                rh.get(key).is_null(),\n150\t                \"hashtable_get({:?}) on absent key\",\n151\t                String::from_utf8_lossy(key)\n152\t            );\n153\t            // del must report -1 for a key that is not there.\n154\t            diff_eq!(\n155\t                ch.del(key),\n156\t                rh.del(key),\n157\t                \"hashtable_del({:?}) on absent key\",\n158\t                String::from_utf8_lossy(key)\n159\t            );\n160\t        }\n161\t        diff_eq!(ch.state(), rh.state(), \"state unchanged by failed ops\");\n162\t    }\n163\t}\n164\t\n165\t#[test]\n166\tfn hashtable_growth_across_rehash_thresholds() {\n167\t    // The grow test is `size >= hashsize(order)`, i.e. it rehashes when the\n168\t    // load factor reaches 1: at 8, then 16, then 32, then 64 entries. Insert\n169\t    // well past several thresholds and compare the FULL iteration order after\n170\t    // every single insertion, so the exact moment and result of each rehash is\n171\t    // checked.\n172\t    let (c, r) = both();\n173\t    unsafe {\n174\t        let (mut ch, _) = Ht::new(c);\n175\t        let (mut rh, _) = Ht::new(r);\n176\t        for i in 0..300usize {\n177\t            let key = format!(\"key{i:04}\");\n178\t            diff_eq!(\n179\t                ch.set(key.as_bytes(), (c.json_integer)(i as i64)),\n180\t                rh.set(key.as_bytes(), (r.json_integer)(i as i64)),\n181\t                \"hashtable_set #{i} return\"\n182\t            );\n183\t            diff_eq!(ch.state(), rh.state(), \"size/order after insert #{i}\");\n184\t            diff_eq!(ch.iterate(), rh.iterate(), \"iteration order after insert #{i}\");\n185\t        }\n186\t    }\n187\t}\n188\t\n189\t#[test]\n190\tfn hashtable_replace_existing_key_keeps_position() {\n191\t    // Replacing a value takes the `if (pair)` branch: the value is swapped in\n192\t    // place and the pair keeps its position in the ordered list (and `size`\n193\t    // must not change).\n194\t    let (c, r) = both();\n195\t    unsafe {\n196\t        let (mut ch, _) = Ht::new(c);\n197\t        let (mut rh, _) = Ht::new(r);\n198\t        for i in 0..20 {\n199\t            let k = format!(\"k{i}\");\n200\t            ch.set(k.as_bytes(), (c.json_integer)(i));\n201\t            rh.set(k.as_bytes(), (r.json_integer)(i));\n202\t        }\n203\t        for i in (0..20).rev() {\n204\t            let k = format!(\"k{i}\");\n205\t            diff_eq!(\n206\t                ch.set(k.as_bytes(), (c.json_integer)(1000 + i)),\n207\t                rh.set(k.as_bytes(), (r.json_integer)(1000 + i)),\n208\t                \"replace k{i} return\"\n209\t            );\n210\t            diff_eq!(ch.state(), rh.state(), \"size must not grow on replace of k{i}\");\n211\t            diff_eq!(ch.iterate(), rh.iterate(), \"order preserved on replace of k{i}\");\n212\t        }\n213\t    }\n214\t}\n215\t\n216\t#[test]\n217\tfn hashtable_delete_first_middle_last_and_only() {\n218\t    // hashtable_do_del has four distinct bucket-fixup branches:\n219\t    //   only element in bucket / first in bucket / last in bucket / middle.\n220\t    // Deleting at many different positions over many table sizes reaches them.\n221\t    let (c, r) = both();\n222\t    unsafe {\n223\t        for n in [1usize, 2, 3, 8, 9, 17, 40] {\n224\t            for del_idx in 0..n {\n225\t                let (mut ch, _) = Ht::new(c);\n226\t                let (mut rh, _) = Ht::new(r);\n227\t                for i in 0..n {\n228\t                    let k = format!(\"k{i:03}\");\n229\t                    ch.set(k.as_bytes(), (c.json_integer)(i as i64));\n230\t                    rh.set(k.as_bytes(), (r.json_integer)(i as i64));\n231\t                }\n232\t                let k = format!(\"k{del_idx:03}\");\n233\t                diff_eq!(\n234\t                    ch.del(k.as_bytes()),\n235\t                    rh.del(k.as_bytes()),\n236\t                    \"del {k} from table of {n} return\"\n237\t                );\n238\t                diff_eq!(ch.state(), rh.state(), \"state after del {k} from {n}\");\n239\t                diff_eq!(\n240\t                    ch.iterate(),\n241\t                    rh.iterate(),\n242\t                    \"iteration after del {k} from table of {n}\"\n243\t                );\n244\t            }\n245\t        }\n246\t    }\n247\t}\n248\t\n249\t#[test]\n250\tfn hashtable_delete_every_element_in_every_order() {\n251\t    // Drains the table completely, comparing after each removal — this reaches\n252\t    // the \"bucket becomes empty\" fixup repeatedly and confirms the ordered list\n253\t    // is unlinked identically.\n254\t    let (c, r) = both();\n255\t    let mut rng = Rng::new(0x47_0001);\n256\t    unsafe {\n257\t        for trial in 0..40 {\n258\t            let n = 1 + rng.below(30);\n259\t            let (mut ch, _) = Ht::new(c);\n260\t            let (mut rh, _) = Ht::new(r);\n261\t            let mut keys: Vec<String> = (0..n).map(|i| format!(\"key-{i}\")).collect();\n262\t            for (i, k) in keys.iter().enumerate() {\n263\t                ch.set(k.as_bytes(), (c.json_integer)(i as i64));\n264\t                rh.set(k.as_bytes(), (r.json_integer)(i as i64));\n265\t            }\n266\t            // Shuffle the deletion order deterministically.\n267\t            for i in (1..keys.len()).rev() {\n268\t                let j = rng.below(i + 1);\n269\t                keys.swap(i, j);\n270\t            }\n271\t            for k in &keys {\n272\t                diff_eq!(\n273\t                    ch.del(k.as_bytes()),\n274\t                    rh.del(k.as_bytes()),\n275\t                    \"trial {trial}: del {k}\"\n276\t                );\n277\t                diff_eq!(ch.state(), rh.state(), \"trial {trial}: state after del {k}\");\n278\t                diff_eq!(ch.iterate(), rh.iterate(), \"trial {trial}: order after del {k}\");\n279\t            }\n280\t        }\n281\t    }\n282\t}\n283\t\n284\t#[test]\n285\tfn hashtable_clear_then_reuse() {\n286\t    let (c, r) = both();\n287\t    unsafe {\n288\t        let (mut ch, _) = Ht::new(c);\n289\t        let (mut rh, _) = Ht::new(r);\n290\t        // Grow past a rehash first so clear() has to reset a bigger bucket array.\n291\t        for i in 0..40 {\n292\t            let k = format!(\"a{i}\");\n293\t            ch.set(k.as_bytes(), (c.json_integer)(i));\n294\t            rh.set(k.as_bytes(), (r.json_integer)(i));\n295\t        }\n296\t        (c.hashtable_clear)(ch.p());\n297\t        (r.hashtable_clear)(rh.p());\n298\t        // clear() resets size to 0 but deliberately KEEPS the grown order.\n299\t        diff_eq!(ch.state(), rh.state(), \"state after clear\");\n300\t        diff_eq!(ch.iterate(), rh.iterate(), \"iteration after clear\");\n301\t\n302\t        // The table must be fully usable again afterwards.\n303\t        for i in 0..25 {\n304\t            let k = format!(\"b{i}\");\n305\t            diff_eq!(\n306\t                ch.set(k.as_bytes(), (c.json_integer)(100 + i)),\n307\t                rh.set(k.as_bytes(), (r.json_integer)(100 + i)),\n308\t                \"reuse after clear, insert {i}\"\n309\t            );\n310\t            diff_eq!(ch.state(), rh.state(), \"state on reuse insert {i}\");\n311\t            diff_eq!(ch.iterate(), rh.iterate(), \"order on reuse insert {i}\");\n312\t        }\n313\t        // Clearing an already-empty table is also valid.\n314\t        (c.hashtable_clear)(ch.p());\n315\t        (r.hashtable_clear)(rh.p());\n316\t        (c.hashtable_clear)(ch.p());\n317\t        (r.hashtable_clear)(rh.p());\n318\t        diff_eq!(ch.state(), rh.state(), \"state after double clear\");\n319\t    }\n320\t}\n321\t\n322\t#[test]\n323\tfn hashtable_iter_at_finds_the_right_pair() {\n324\t    let (c, r) = both();\n325\t    unsafe {\n326\t        let (mut ch, _) = Ht::new(c);\n327\t        let (mut rh, _) = Ht::new(r);\n328\t        let n = 50;\n329\t        for i in 0..n {\n330\t            let k = format!(\"k{i:03}\");\n331\t            ch.set(k.as_bytes(), (c.json_integer)(i));\n332\t            rh.set(k.as_bytes(), (r.json_integer)(i));\n333\t        }\n334\t        for i in 0..n {\n335\t            let k = format!(\"k{i:03}\");\n336\t            let cit = (c.hashtable_iter_at)(ch.p(), k.as_ptr() as *const c_char, k.len());\n337\t            let rit = (r.hashtable_iter_at)(rh.p(), k.as_ptr() as *const c_char, k.len());\n338\t            diff_eq!(cit.is_null(), rit.is_null(), \"iter_at({k}) null-ness\");\n339\t            assert!(!cit.is_null());\n340\t            // Compare the pair the iterator points at, plus the whole tail of\n341\t            // the iteration from that point on.\n342\t            let ckl = (c.hashtable_iter_key_len)(cit);\n343\t            let rkl = (r.hashtable_iter_key_len)(rit);\n344\t            diff_eq!(ckl, rkl, \"iter_at({k}) key_len\");\n345\t            let ckp = (c.hashtable_iter_key)(cit) as *const u8;\n346\t            let rkp = (r.hashtable_iter_key)(rit) as *const u8;\n347\t            let ck: Vec<u8> = (0..ckl).map(|j| *ckp.add(j)).collect();\n348\t            let rk: Vec<u8> = (0..rkl).map(|j| *rkp.add(j)).collect();\n349\t            diff_eq!(ck, rk, \"iter_at({k}) key bytes\");\n350\t            diff_eq!(\n351\t                (c.json_integer_value)((c.hashtable_iter_value)(cit) as *mut json_t),\n352\t                (r.json_integer_value)((r.hashtable_iter_value)(rit) as *mut json_t),\n353\t                \"iter_at({k}) value\"\n354\t            );\n355\t\n356\t            // Walk the rest of the sequence from here.\n357\t            let mut cseq = Vec::new();\n358\t            let mut rseq = Vec::new();\n359\t            let mut ci = cit;\n360\t            let mut ri = rit;\n361\t            while !ci.is_null() {\n362\t                cseq.push((c.hashtable_iter_key_len)(ci));\n363\t                ci = (c.hashtable_iter_next)(ch.p(), ci);\n364\t            }\n365\t            while !ri.is_null() {\n366\t                rseq.push((r.hashtable_iter_key_len)(ri));\n367\t                ri = (r.hashtable_iter_next)(rh.p(), ri);\n368\t            }\n369\t            diff_eq!(cseq, rseq, \"tail of iteration from iter_at({k})\");\n370\t        }\n371\t        // iter_at on an absent key returns NULL.\n372\t        let missing = b\"nope\";\n373\t        diff_eq!(\n374\t            (c.hashtable_iter_at)(ch.p(), missing.as_ptr() as *const c_char, 4).is_null(),\n375\t            (r.hashtable_iter_at)(rh.p(), missing.as_ptr() as *const c_char, 4).is_null(),\n376\t            \"iter_at on absent key\"\n377\t        );\n378\t    }\n379\t}\n380\t\n381\t#[test]\n382\tfn hashtable_iter_set_replaces_value_in_place() {\n383\t    let (c, r) = both();\n384\t    unsafe {\n385\t        let (mut ch, _) = Ht::new(c);\n386\t        let (mut rh, _) = Ht::new(r);\n387\t        for i in 0..15 {\n388\t            let k = format!(\"k{i}\");\n389\t            ch.set(k.as_bytes(), (c.json_integer)(i));\n390\t            rh.set(k.as_bytes(), (r.json_integer)(i));\n391\t        }\n392\t        let mut cit = (c.hashtable_iter)(ch.p());\n393\t        let mut rit = (r.hashtable_iter)(rh.p());\n394\t        let mut n = 0;\n395\t        while !cit.is_null() {\n396\t            (c.hashtable_iter_set)(cit, (c.json_integer)(9000 + n));\n397\t            (r.hashtable_iter_set)(rit, (r.json_integer)(9000 + n));\n398\t            n += 1;\n399\t            cit = (c.hashtable_iter_next)(ch.p(), cit);\n400\t            rit = (r.hashtable_iter_next)(rh.p(), rit);\n401\t        }\n402\t        diff_eq!(rit.is_null(), cit.is_null(), \"both iterations ended together\");\n403\t        diff_eq!(ch.state(), rh.state(), \"state after iter_set sweep\");\n404\t        diff_eq!(ch.iterate(), rh.iterate(), \"values after iter_set sweep\");\n405\t    }\n406\t}\n407\t\n408\t#[test]\n409\tfn hashtable_iter_next_then_delete_current() {\n410\t    // The documented safe-delete idiom: grab `next` first, then delete the\n411\t    // element the current iterator points at.\n412\t    let (c, r) = both();\n413\t    unsafe {\n414\t        let (mut ch, _) = Ht::new(c);\n415\t        let (mut rh, _) = Ht::new(r);\n416\t        for i in 0..30 {\n417\t            let k = format!(\"k{i:02}\");\n418\t            ch.set(k.as_bytes(), (c.json_integer)(i));\n419\t            rh.set(k.as_bytes(), (r.json_integer)(i));\n420\t        }\n421\t        let mut cit = (c.hashtable_iter)(ch.p());\n422\t        let mut rit = (r.hashtable_iter)(rh.p());\n423\t        let mut step = 0;\n424\t        while !cit.is_null() {\n425\t            let cnext = (c.hashtable_iter_next)(ch.p(), cit);\n426\t            let rnext = (r.hashtable_iter_next)(rh.p(), rit);\n427\t\n428\t            let ckl = (c.hashtable_iter_key_len)(cit);\n429\t            let ckp = (c.hashtable_iter_key)(cit) as *const u8;\n430\t            let ckey: Vec<u8> = (0..ckl).map(|j| *ckp.add(j)).collect();\n431\t            let rkl = (r.hashtable_iter_key_len)(rit);\n432\t            let rkp = (r.hashtable_iter_key)(rit) as *const u8;\n433\t            let rkey: Vec<u8> = (0..rkl).map(|j| *rkp.add(j)).collect();\n434\t            diff_eq!(ckey.clone(), rkey.clone(), \"step {step}: current key\");\n435\t\n436\t            // Delete every other element so the iteration also has to survive\n437\t            // walking over survivors.\n438\t            if step % 2 == 0 {\n439\t                diff_eq!(ch.del(&ckey), rh.del(&rkey), \"step {step}: delete current\");\n440\t            }\n441\t            diff_eq!(ch.state(), rh.state(), \"step {step}: state\");\n442\t\n443\t            cit = cnext;\n444\t            rit = rnext;\n445\t            step += 1;\n446\t        }\n447\t        diff_eq!(cit.is_null(), rit.is_null(), \"iterations ended together\");\n448\t        diff_eq!(ch.iterate(), rh.iterate(), \"final iteration order\");\n449\t    }\n450\t}\n451\t\n452\t#[test]\n453\tfn hashtable_keys_with_embedded_nul_are_distinct() {\n454\t    // Keys are compared with memcmp over key_len, so \"ab\\0cd\" (len 5) and \"ab\"\n455\t    // (len 2) are different keys, and so are \"ab\\0cd\" and \"ab\\0ef\".\n456\t    let (c, r) = both();\n457\t    unsafe {\n458\t        let (mut ch, _) = Ht::new(c);\n459\t        let (mut rh, _) = Ht::new(r);\n460\t        let keys: Vec<&[u8]> = vec![\n461\t            b\"ab\",\n462\t            b\"ab\\0cd\",\n463\t            b\"ab\\0ef\",\n464\t            b\"\\0\",\n465\t            b\"\\0\\0\",\n466\t            b\"\",\n467\t            b\"a\\0\",\n468\t            b\"\\0a\",\n469\t        ];\n470\t        for (i, k) in keys.iter().enumerate() {\n471\t            diff_eq!(\n472\t                ch.set(k, (c.json_integer)(i as i64)),\n473\t                rh.set(k, (r.json_integer)(i as i64)),\n474\t                \"set NUL-key #{i}\"\n475\t            );\n476\t            diff_eq!(ch.state(), rh.state(), \"state after NUL-key #{i}\");\n477\t        }\n478\t        // All eight must coexist.\n479\t        diff_eq!(ch.state(), rh.state(), \"all NUL keys distinct\");\n480\t        assert_eq!(ch.state().0, keys.len(), \"C: all NUL-containing keys are distinct\");\n481\t        diff_eq!(ch.iterate(), rh.iterate(), \"iteration over NUL-containing keys\");\n482\t\n483\t        for k in &keys {\n484\t            let cv = ch.get(k);\n485\t            let rv = rh.get(k);\n486\t            diff_eq!(cv.is_null(), rv.is_null(), \"get NUL-key {k:?}\");\n487\t            diff_eq!(\n488\t                (c.json_integer_value)(cv as *mut json_t),\n489\t                (r.json_integer_value)(rv as *mut json_t),\n490\t                \"value for NUL-key {k:?}\"\n491\t            );\n492\t        }\n493\t    }\n494\t}\n495\t\n496\t#[test]\n497\tfn hashtable_empty_and_very_long_keys() {\n498\t    let (c, r) = both();\n499\t    unsafe {\n500\t        let (mut ch, _) = Ht::new(c);\n501\t        let (mut rh, _) = Ht::new(r);\n502\t        let long_a = vec![b'x'; 100_000];\n503\t        let mut long_b = vec![b'x'; 100_000];\n504\t        *long_b.last_mut().unwrap() = b'y'; // differs only in the final byte\n505\t        let keys: Vec<&[u8]> = vec![b\"\", &long_a, &long_b];\n506\t        for (i, k) in keys.iter().enumerate() {\n507\t            diff_eq!(\n508\t                ch.set(k, (c.json_integer)(i as i64)),\n509\t                rh.set(k, (r.json_integer)(i as i64)),\n510\t                \"set long key #{i}\"\n511\t            );\n512\t        }\n513\t        diff_eq!(ch.state(), rh.state(), \"state with long keys\");\n514\t        for (i, k) in keys.iter().enumerate() {\n515\t            diff_eq!(\n516\t                (c.json_integer_value)(ch.get(k) as *mut json_t),\n517\t                (r.json_integer_value)(rh.get(k) as *mut json_t),\n518\t                \"get long key #{i}\"\n519\t            );\n520\t        }\n521\t        diff_eq!(ch.iterate(), rh.iterate(), \"iteration with long keys\");\n522\t    }\n523\t}\n524\t\n525\t#[test]\n526\tfn hashtable_binary_keys_full_byte_range() {\n527\t    // Exercises hashlittle() over keys containing every byte value and every\n528\t    // length modulo 4 (its main loop consumes 12 bytes at a time with a\n529\t    // switch-based tail, so length % 12 matters).\n530\t    let (c, r) = both();\n531\t    let mut rng = Rng::new(0x47_0002);\n532\t    unsafe {\n533\t        let (mut ch, _) = Ht::new(c);\n534\t        let (mut rh, _) = Ht::new(r);\n535\t        let mut keys: Vec<Vec<u8>> = Vec::new();\n536\t        // Every length from 0..40 with pseudo-random bytes, so every tail case\n537\t        // of hashlittle's switch is hit.\n538\t        for len in 0..40usize {\n539\t            let k: Vec<u8> = (0..len).map(|_| rng.next_u32() as u8).collect();\n540\t            keys.push(k);\n541\t        }\n542\t        // Plus single-byte keys covering all 256 byte values.\n543\t        for b in 0..=255u8 {\n544\t            keys.push(vec![b]);\n545\t        }\n546\t        for (i, k) in keys.iter().enumerate() {\n547\t            diff_eq!(\n548\t                ch.set(k, (c.json_integer)(i as i64)),\n549\t                rh.set(k, (r.json_integer)(i as i64)),\n550\t                \"set binary key #{i} (len {})\",\n551\t                k.len()\n552\t            );\n553\t            diff_eq!(ch.state(), rh.state(), \"state after binary key #{i}\");\n554\t        }\n555\t        // The iteration order here is a direct fingerprint of hashlittle()\n556\t        // plus the bucket bookkeeping.\n557\t        diff_eq!(ch.iterate(), rh.iterate(), \"iteration over binary keys\");\n558\t        for (i, k) in keys.iter().enumerate() {\n559\t            diff_eq!(\n560\t                (c.json_integer_value)(ch.get(k) as *mut json_t),\n561\t                (r.json_integer_value)(rh.get(k) as *mut json_t),\n562\t                \"get binary key #{i}\"\n563\t            );\n564\t        }\n565\t    }\n566\t}\n567\t\n568\t#[test]\n569\tfn hashtable_randomised_operation_sequences() {\n570\t    // Property-style: the same random mix of set/get/del/clear/iterate applied\n571\t    // to both tables, with the complete state compared after every step.\n572\t    let (c, r) = both();\n573\t    let mut rng = Rng::new(0x47_0003);\n574\t    unsafe {\n575\t        for trial in 0..60 {\n576\t            let (mut ch, _) = Ht::new(c);\n577\t            let (mut rh, _) = Ht::new(r);\n578\t            // A small key space so collisions, replacements and failed\n579\t            // deletions all happen frequently.\n580\t            let space = 1 + rng.below(40);\n581\t            for step in 0..200 {\n582\t                let k = format!(\"k{}\", rng.below(space));\n583\t                match rng.below(12) {\n584\t                    0..=6 => {\n585\t                        let v = rng.json_int();\n586\t                        diff_eq!(\n587\t                            ch.set(k.as_bytes(), (c.json_integer)(v)),\n588\t                            rh.set(k.as_bytes(), (r.json_integer)(v)),\n589\t                            \"trial {trial} step {step}: set {k}\"\n590\t                        );\n591\t                    }\n592\t                    7 | 8 => {\n593\t                        let cv = ch.get(k.as_bytes());\n594\t                        let rv = rh.get(k.as_bytes());\n595\t                        diff_eq!(\n596\t                            cv.is_null(),\n597\t                            rv.is_null(),\n598\t                            \"trial {trial} step {step}: get {k} null-ness\"\n599\t                        );\n600\t                        if !cv.is_null() {\n601\t                            diff_eq!(\n602\t                                (c.json_integer_value)(cv as *mut json_t),\n603\t                                (r.json_integer_value)(rv as *mut json_t),\n604\t                                \"trial {trial} step {step}: get {k} value\"\n605\t                            );\n606\t                        }\n607\t                    }\n608\t                    9 | 10 => {\n609\t                        diff_eq!(\n610\t                            ch.del(k.as_bytes()),\n611\t                            rh.del(k.as_bytes()),\n612\t                            \"trial {trial} step {step}: del {k}\"\n613\t                        );\n614\t                    }\n615\t                    _ => {\n616\t                        (c.hashtable_clear)(ch.p());\n617\t                        (r.hashtable_clear)(rh.p());\n618\t                    }\n619\t                }\n620\t                diff_eq!(ch.state(), rh.state(), \"trial {trial} step {step}: state\");\n621\t                diff_eq!(\n622\t                    ch.iterate(),\n623\t                    rh.iterate(),\n624\t                    \"trial {trial} step {step}: iteration order\"\n625\t                );\n626\t            }\n627\t        }\n628\t    }\n629\t}\n630\t\n631\t#[test]\n632\tfn hashtable_values_of_every_json_type() {\n633\t    // The table stores borrowed `json_t *` of any type and decrefs them on\n634\t    // delete/replace/close; make sure every type survives that path.\n635\t    let (c, r) = both();\n636\t    unsafe {\n637\t        let (mut ch, _) = Ht::new(c);\n638\t        let (mut rh, _) = Ht::new(r);\n639\t        let makers: Vec<(&str, fn(&Api) -> *mut json_t)> = vec![\n640\t            (\"object\", |a| unsafe { (a.json_object)() }),\n641\t            (\"array\", |a| unsafe { (a.json_array)() }),\n642\t            (\"string\", |a| unsafe { (a.json_string)(b\"hi\\0\".as_ptr() as *const c_char) }),\n643\t            (\"integer\", |a| unsafe { (a.json_integer)(42) }),\n644\t            (\"real\", |a| unsafe { (a.json_real)(1.5) }),\n645\t            (\"true\", |a| unsafe { (a.json_true)() }),\n646\t            (\"false\", |a| unsafe { (a.json_false)() }),\n647\t            (\"null\", |a| unsafe { (a.json_null)() }),\n648\t        ];\n649\t        for (name, mk) in &makers {\n650\t            diff_eq!(\n651\t                ch.set(name.as_bytes(), mk(c)),\n652\t                rh.set(name.as_bytes(), mk(r)),\n653\t                \"set {name} value\"\n654\t            );\n655\t        }\n656\t        diff_eq!(ch.state(), rh.state(), \"state with all value types\");\n657\t        for (name, _) in &makers {\n658\t            let cv = ch.get(name.as_bytes()) as *mut json_t;\n659\t            let rv = rh.get(name.as_bytes()) as *mut json_t;\n660\t            diff_eq!(cv.is_null(), rv.is_null(), \"get {name} null-ness\");\n661\t            diff_eq!(typeof_(cv), typeof_(rv), \"type of stored {name}\");\n662\t        }\n663\t        // Replace each with a different type, exercising the decref-on-replace\n664\t        // path for singletons (refcount == (size_t)-1) as well as heap values.\n665\t        for (name, _) in &makers {\n666\t            diff_eq!(\n667\t                ch.set(name.as_bytes(), (c.json_integer)(7)),\n668\t                rh.set(name.as_bytes(), (r.json_integer)(7)),\n669\t                \"replace {name} with integer\"\n670\t            );\n671\t        }\n672\t        diff_eq!(ch.iterate(), rh.iterate(), \"after replacing all with integers\");\n673\t    }\n674\t}\n675\t"}]},"parent_tool_use_id":"toolu_bdrk_01Q17JdGMpf71YmhvBG8Hx7e","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"63a0a38a-039a-44cc-94e1-7ea8fa3ff205","timestamp":"2026-08-31T03:55:56.832Z","subagent_type":"general-purpose","task_description":"Phase B tests for value.c"}
