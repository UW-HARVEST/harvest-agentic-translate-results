ome(get);\n176\t    (*stream).data = data;\n177\t    (*stream).buffer[0] = 0;\n178\t    (*stream).buffer_pos = 0;\n179\t\n180\t    (*stream).state = STREAM_STATE_OK;\n181\t    (*stream).line = 1;\n182\t    (*stream).column = 0;\n183\t    (*stream).position = 0;\n184\t}\n185\t\n186\tunsafe fn stream_get(stream: *mut stream_t, error: *mut json_error_t) -> c_int {\n187\t    let mut c: c_int;\n188\t\n189\t    if (*stream).state != STREAM_STATE_OK {\n190\t        return (*stream).state;\n191\t    }\n192\t\n193\t    if (*stream).buffer[(*stream).buffer_pos] == 0 {\n194\t        c = ((*stream).get.unwrap())((*stream).data);\n195\t        if c == ffi::EOF {\n196\t            (*stream).state = STREAM_STATE_EOF;\n197\t            return STREAM_STATE_EOF;\n198\t        }\n199\t\n200\t        (*stream).buffer[0] = c as c_char;\n201\t        (*stream).buffer_pos = 0;\n202\t\n203\t        if (0x80..=0xFF).contains(&c) {\n204\t            /* multi-byte UTF-8 sequence */\n205\t            let count = utf8_check_first(c as c_char);\n206\t            if count == 0 {\n207\t                /* goto out */\n208\t                (*stream).state = STREAM_STATE_ERROR;\n209\t                error_set_with(\n210\t                    error,\n211\t                    stream_to_lex(stream),\n212\t                    json_error_invalid_utf8,\n213\t                    |buf, n| {\n214\t                        ffi::snprintf(\n215\t                            buf,\n216\t                            n,\n217\t                            b\"unable to decode byte 0x%x\\0\".as_ptr() as *const c_char,\n218\t                            c,\n219\t                        );\n220\t                    },\n221\t                );\n222\t                return STREAM_STATE_ERROR;\n223\t            }\n224\t\n225\t            for i in 1..count {\n226\t                (*stream).buffer[i] = ((*stream).get.unwrap())((*stream).data) as c_char;\n227\t            }\n228\t\n229\t            if utf8_check_full((*stream).buffer.as_ptr(), count, core::ptr::null_mut()) == 0 {\n230\t                /* goto out */\n231\t                (*stream).state = STREAM_STATE_ERROR;\n232\t                error_set_with(\n233\t                    error,\n234\t                    stream_to_lex(stream),\n235\t                    json_error_invalid_utf8,\n236\t                    |buf, n| {\n237\t                        ffi::snprintf(\n238\t                            buf,\n239\t                            n,\n240\t                            b\"unable to decode byte 0x%x\\0\".as_ptr() as *const c_char,\n241\t                            c,\n242\t                        );\n243\t                    },\n244\t                );\n245\t                return STREAM_STATE_ERROR;\n246\t            }\n247\t\n248\t            (*stream).buffer[count] = 0;\n249\t        } else {\n250\t            (*stream).buffer[1] = 0;\n251\t        }\n252\t    }\n253\t\n254\t    c = (*stream).buffer[(*stream).buffer_pos] as c_int;\n255\t    (*stream).buffer_pos += 1;\n256\t\n257\t    (*stream).position += 1;\n258\t    if c == b'\\n' as c_int {\n259\t        (*stream).line += 1;\n260\t        (*stream).last_column = (*stream).column;\n261\t        (*stream).column = 0;\n262\t    } else if utf8_check_first(c as c_char) != 0 {\n263\t        /* track the Unicode character column, so increment only if this is the\n264\t        first character of a UTF-8 sequence */\n265\t        (*stream).column += 1;\n266\t    }\n267\t\n268\t    c\n269\t}\n270\t\n271\tunsafe fn stream_unget(stream: *mut stream_t, c: c_int) {\n272\t    if c == STREAM_STATE_EOF || c == STREAM_STATE_ERROR {\n273\t        return;\n274\t    }\n275\t\n276\t    (*stream).position -= 1;\n277\t    if c == b'\\n' as c_int {\n278\t        (*stream).line -= 1;\n279\t        (*stream).column = (*stream).last_column;\n280\t    } else if utf8_check_first(c as c_char) != 0 {\n281\t        (*stream).column -= 1;\n282\t    }\n283\t\n284\t    (*stream).buffer_pos -= 1;\n285\t}\n286\t\n287\tunsafe fn lex_get(lex: *mut lex_t, error: *mut json_error_t) -> c_int {\n288\t    stream_get(core::ptr::addr_of_mut!((*lex).stream), error)\n289\t}\n290\t\n291\tunsafe fn lex_save(lex: *mut lex_t, c: c_int) {\n292\t    strbuffer_append_byte(core::ptr::addr_of_mut!((*lex).saved_text), c as c_char);\n293\t}\n294\t\n295\tunsafe fn lex_get_save(lex: *mut lex_t, error: *mut json_error_t) -> c_int {\n296\t    let c = stream_get(core::ptr::addr_of_mut!((*lex).stream), error);\n297\t    if c != STREAM_STATE_EOF && c != STREAM_STATE_ERROR {\n298\t        lex_save(lex, c);\n299\t    }\n300\t    c\n301\t}\n302\t\n303\tunsafe fn lex_unget(lex: *mut lex_t, c: c_int) {\n304\t    stream_unget(core::ptr::addr_of_mut!((*lex).stream), c);\n305\t}\n306\t\n307\tunsafe fn lex_unget_unsave(lex: *mut lex_t, c: c_int) {\n308\t    if c != STREAM_STATE_EOF && c != STREAM_STATE_ERROR {\n309\t        stream_unget(core::ptr::addr_of_mut!((*lex).stream), c);\n310\t        strbuffer_pop(core::ptr::addr_of_mut!((*lex).saved_text));\n311\t    }\n312\t}\n313\t\n314\tunsafe fn lex_save_cached(lex: *mut lex_t) {\n315\t    while (*lex).stream.buffer[(*lex).stream.buffer_pos] != 0 {\n316\t        lex_save(lex, (*lex).stream.buffer[(*lex).stream.buffer_pos] as c_int);\n317\t        (*lex).stream.buffer_pos += 1;\n318\t        (*lex).stream.position += 1;\n319\t    }\n320\t}\n321\t\n322\tunsafe fn lex_free_string(lex: *mut lex_t) {\n323\t    jsonp_free((*lex).value_string.val as *mut c_void);\n324\t    (*lex).value_string.val = core::ptr::null_mut();\n325\t    (*lex).value_string.len = 0;\n326\t}\n327\t\n328\t/* assumes that str points to 'u' plus at least 4 valid hex digits */\n329\tunsafe fn decode_unicode_escape(str_: *const c_char) -> i32 {\n330\t    let mut value: i32 = 0;\n331\t\n332\t    for i in 1..=4 {\n333\t        let c = *str_.offset(i) as c_int;\n334\t        value <<= 4;\n335\t        if l_isdigit(c) {\n336\t            value += c - b'0' as c_int;\n337\t        } else if l_islower(c) {\