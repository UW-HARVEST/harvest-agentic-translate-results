{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DQK9wtEdqnm8KHw3q8ouZE","type":"tool_result","content":"1\t//! Differential tests for `src/load.c` — CONFIGS.md rows 89..163\n2\t//! (\"B. Decoding — load.c\").\n3\t//!\n4\t//! Every case runs the *same* input bytes and the *same* flags through both\n5\t//! libraries and compares three independent observables:\n6\t//!\n7\t//!   1. whether the call returned NULL,\n8\t//!   2. the **complete byte image** of the caller's `json_error_t`\n9\t//!      (`json_error_t::raw()`), which pins line / column / position / source /\n10\t//!      message text / error code all at once — and, because the struct starts\n11\t//!      out `poisoned()`, also pins *which bytes the library wrote at all*,\n12\t//!   3. when the parse succeeded, a canonical re-dump of the resulting tree\n13\t//!      with `JSON_SORT_KEYS | JSON_ENCODE_ANY`, compared byte-for-byte.\n14\t//!\n15\t//! Randomised generators produce valid and malformed JSON text; each flag\n16\t//! combination gets hundreds of inputs rather than one hand-picked value.\n17\t\n18\tmod common;\n19\tuse common::*;\n20\tuse std::ffi::{c_char, c_int, c_void};\n21\tuse std::os::unix::io::AsRawFd;\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// libc bits the load entry points need (a real FILE*, a real fd)\n25\t// ---------------------------------------------------------------------------\n26\t\n27\textern \"C\" {\n28\t    fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n29\t    fn fclose(f: *mut FILE) -> c_int;\n30\t}\n31\t\n32\t/// The canonical re-dump used to compare two parsed trees. `JSON_SORT_KEYS`\n33\t/// removes any dependency on hash order (which is already pinned by `both()`,\n34\t/// but sorting makes a divergence in *content* obvious rather than a\n35\t/// divergence in *order*); `JSON_ENCODE_ANY` is required so bare scalars\n36\t/// parsed with `JSON_DECODE_ANY` can be dumped at all.\n37\tconst CANON: size_t = JSON_SORT_KEYS | JSON_ENCODE_ANY;\n38\t\n39\t// ---------------------------------------------------------------------------\n40\t// Observable snapshot of one decode call\n41\t// ---------------------------------------------------------------------------\n42\t\n43\t#[derive(Clone)]\n44\tstruct Snap {\n45\t    null: bool,\n46\t    err: (c_int, c_int, c_int, String, String, c_int),\n47\t    err_raw: Vec<u8>,\n48\t    dump_str: Option<String>,\n49\t    dump: Option<Vec<u8>>,\n50\t}\n51\t\n52\t/// Snapshot a decode result. Does **not** decref `j`; the caller owns it.\n53\tunsafe fn snap(api: &Api, j: *mut json_t, err: &json_error_t) -> Snap {\n54\t    let (dump, dump_str) = if j.is_null() {\n55\t        (None, None)\n56\t    } else {\n57\t        let p = (api.json_dumps)(j, CANON);\n58\t        let b = cbytes(p);\n59\t        jfree(api, p as *mut c_void);\n60\t        let s = b.as_ref().map(|v| String::from_utf8_lossy(v).into_owned());\n61\t        (b, s)\n62\t    };\n63\t    Snap {\n64\t        null: j.is_null(),\n65\t        err: err.snapshot(),\n66\t        err_raw: err.raw(),\n67\t        dump_str,\n68\t        dump,\n69\t    }\n70\t}\n71\t\n72\timpl Snap {\n73\t    fn compare(&self, other: &Snap, ctx: &str) {\n74\t        diff_eq!(self.null, other.null, \"returned-NULL differs — {ctx}\");\n75\t        diff_eq!(\n76\t            self.err.clone(),\n77\t            other.err.clone(),\n78\t            \"json_error_t (line,col,pos,source,text,code) differs — {ctx}\"\n79\t        );\n80\t        diff_eq!(\n81\t            self.err_raw.clone(),\n82\t            other.err_raw.clone(),\n83\t            \"json_error_t raw byte image differs — {ctx}\"\n84\t        );\n85\t        diff_eq!(\n86\t            self.dump_str.clone(),\n87\t            other.dump_str.clone(),\n88\t            \"canonical re-dump differs — {ctx}\"\n89\t        );\n90\t        diff_eq!(\n91\t            self.dump.clone(),\n92\t            other.dump.clone(),\n93\t            \"canonical re-dump bytes differ — {ctx}\"\n94\t        );\n95\t    }\n96\t\n97\t    fn code(&self) -> c_int {\n98\t        self.err.5\n99\t    }\n100\t    fn text(&self) -> &str {\n101\t        &self.err.4\n102\t    }\n103\t}\n104\t\n105\t/// Printable, unambiguous rendering of arbitrary input bytes.\n106\tfn show(b: &[u8]) -> String {\n107\t    let mut s = String::new();\n108\t    for &x in b.iter().take(300) {\n109\t        match x {\n110\t            b'\\\\' => s.push_str(\"\\\\\\\\\"),\n111\t            0x20..=0x7e => s.push(x as char),\n112\t            b'\\n' => s.push_str(\"\\\\n\"),\n113\t            b'\\t' => s.push_str(\"\\\\t\"),\n114\t            b'\\r' => s.push_str(\"\\\\r\"),\n115\t            _ => s.push_str(&format!(\"\\\\x{x:02x}\")),\n116\t        }\n117\t    }\n118\t    if b.len() > 300 {\n119\t        s.push_str(&format!(\"...<{} bytes total>\", b.len()));\n120\t    }\n121\t    s\n122\t}\n123\t\n124\t// ---------------------------------------------------------------------------\n125\t// The six decoding entry points, each as a differential comparison\n126\t// ---------------------------------------------------------------------------\n127\t\n128\t/// `json_loads` on both libraries. Returns the C-side snapshot so a caller can\n129\t/// additionally assert the ground-truth behaviour the CONFIGS row demands.\n130\tunsafe fn cmp_loads(c: &Api, r: &Api, text: &[u8], flags: size_t, ctx: &str) -> Snap {\n131\t    let buf = cs_bytes(text);\n132\t    let mut ce = json_error_t::poisoned();\n133\t    let mut re = json_error_t::poisoned();\n134\t    let cj = (c.json_loads)(buf.as_ptr(), flags, &mut ce);\n135\t    let rj = (r.json_loads)(buf.as_ptr(), flags, &mut re);\n136\t    let cs_ = snap(c, cj, &ce);\n137\t    let rs_ = snap(r, rj, &re);\n138\t    let full = format!(\n139\t        \"json_loads(flags={flags:#x}) input={:?} [{ctx}]\",\n140\t        show(text)\n141\t    );\n142\t    cs_.compare(&rs_, &full);\n143\t    decref(c, cj);\n144\t    decref(r, rj);\n145\t    cs_\n146\t}\n147\t\n148\tunsafe fn cmp_loadb(\n149\t    c: &Api,\n150\t    r: &Api,\n151\t    text: &[u8],\n152\t    buflen: size_t,\n153\t    flags: size_t,\n154\t    ctx: &str,\n155\t) -> Snap {\n156\t    // Deliberately NOT NUL-terminated beyond the buffer: json_loadb must honour\n157\t    // buflen only.\n158\t    let mut ce = json_error_t::poisoned();\n159\t    let mut re = json_error_t::poisoned();\n160\t    let p = if text.is_empty() {\n161\t        b\"\".as_ptr() as *const c_char\n162\t    } else {\n163\t        text.as_ptr() as *const c_char\n164\t    };\n165\t    let cj = (c.json_loadb)(p, buflen, flags, &mut ce);\n166\t    let rj = (r.json_loadb)(p, buflen, flags, &mut re);\n167\t    let cs_ = snap(c, cj, &ce);\n168\t    let rs_ = snap(r, rj, &re);\n169\t    let full = format!(\n170\t        \"json_loadb(buflen={buflen}, flags={flags:#x}) input={:?} [{ctx}]\",\n171\t        show(text)\n172\t    );\n173\t    cs_.compare(&rs_, &full);\n174\t    decref(c, cj);\n175\t    decref(r, rj);\n176\t    cs_\n177\t}\n178\t\n179\tfn tmp_path(tag: &str) -> std::path::PathBuf {\n180\t    let dir = std::env::var(\"TMPDIR\").unwrap_or_else(|_| \"/tmp\".to_string());\n181\t    std::path::Path::new(&dir).join(format!(\"a07_load_{tag}_{}.json\", std::process::id()))\n182\t}\n183\t\n184\t/// `json_loadf` through a real `FILE*` obtained from `fopen`. The file is\n185\t/// reopened for each library so both see the same stream position.\n186\tunsafe fn cmp_loadf(c: &Api, r: &Api, text: &[u8], flags: size_t, path: &std::path::Path, ctx: &str) {\n187\t    std::fs::write(path, text).expect(\"write temp file\");\n188\t    let cpath = cs(path.to_str().unwrap());\n189\t    let mode = cs(\"rb\");\n190\t\n191\t    let mut ce = json_error_t::poisoned();\n192\t    let mut re = json_error_t::poisoned();\n193\t\n194\t    let cf = fopen(cpath.as_ptr(), mode.as_ptr());\n195\t    assert!(!cf.is_null(), \"fopen failed for {}\", path.display());\n196\t    let cj = (c.json_loadf)(cf, flags, &mut ce);\n197\t    fclose(cf);\n198\t\n199\t    let rf = fopen(cpath.as_ptr(), mode.as_ptr());\n200\t    assert!(!rf.is_null());\n201\t    let rj = (r.json_loadf)(rf, flags, &mut re);\n202\t    fclose(rf);\n203\t\n204\t    let cs_ = snap(c, cj, &ce);\n205\t    let rs_ = snap(r, rj, &re);\n206\t    cs_.compare(\n207\t        &rs_,\n208\t        &format!(\"json_loadf(flags={flags:#x}) input={:?} [{ctx}]\", show(text)),\n209\t    );\n210\t    decref(c, cj);\n211\t    decref(r, rj);\n212\t}\n213\t\n214\t/// `json_loadfd` through a real file descriptor.\n215\tunsafe fn cmp_loadfd(\n216\t    c: &Api,\n217\t    r: &Api,\n218\t    text: &[u8],\n219\t    flags: size_t,\n220\t    path: &std::path::Path,\n221\t    ctx: &str,\n222\t) {\n223\t    std::fs::write(path, text).expect(\"write temp file\");\n224\t\n225\t    let mut ce = json_error_t::poisoned();\n226\t    let mut re = json_error_t::poisoned();\n227\t\n228\t    let f1 = std::fs::File::open(path).expect(\"open fd\");\n229\t    let cj = (c.json_loadfd)(f1.as_raw_fd(), flags, &mut ce);\n230\t    drop(f1);\n231\t\n232\t    let f2 = std::fs::File::open(path).expect(\"open fd\");\n233\t    let rj = (r.json_loadfd)(f2.as_raw_fd(), flags, &mut re);\n234\t    drop(f2);\n235\t\n236\t    let cs_ = snap(c, cj, &ce);\n237\t    let rs_ = snap(r, rj, &re);\n238\t    cs_.compare(\n239\t        &rs_,\n240\t        &format!(\"json_loadfd(flags={flags:#x}) input={:?} [{ctx}]\", show(text)),\n241\t    );\n242\t    decref(c, cj);\n243\t    decref(r, rj);\n244\t}\n245\t\n246\t/// `json_load_file`.\n247\tunsafe fn cmp_load_file(\n248\t    c: &Api,\n249\t    r: &Api,\n250\t    text: &[u8],\n251\t    flags: size_t,\n252\t    path: &std::path::Path,\n253\t    ctx: &str,\n254\t) {\n255\t    std::fs::write(path, text).expect(\"write temp file\");\n256\t    let cpath = cs(path.to_str().unwrap());\n257\t    let mut ce = json_error_t::poisoned();\n258\t    let mut re = json_error_t::poisoned();\n259\t    let cj = (c.json_load_file)(cpath.as_ptr(), flags, &mut ce);\n260\t    let rj = (r.json_load_file)(cpath.as_ptr(), flags, &mut re);\n261\t    let cs_ = snap(c, cj, &ce);\n262\t    let rs_ = snap(r, rj, &re);\n263\t    cs_.compare(\n264\t        &rs_,\n265\t        &format!(\n266\t            \"json_load_file(flags={flags:#x}) input={:?} [{ctx}]\",\n267\t            show(text)\n268\t        ),\n269\t    );\n270\t    decref(c, cj);\n271\t    decref(r, rj);\n272\t}\n273\t\n274\t// ---- json_load_callback -----------------------------------------------------\n275\t\n276\tconst CB_ZERO: c_int = 0; // returns 0 immediately (empty input)\n277\tconst CB_ONE_BYTE: c_int = 1; // one byte per call\n278\tconst CB_BIG: c_int = 2; // as much as the buffer allows\n279\tconst CB_SHORT: c_int = 3; // stops short after `stop_after` bytes\n280\tconst CB_ERROR: c_int = 4; // returns (size_t)-1\n281\t\n282\t#[repr(C)]\n283\tstruct CbState {\n284\t    data: *const u8,\n285\t    len: usize,\n286\t    pos: usize,\n287\t    stop_after: usize,\n288\t    mode: c_int,\n289\t    calls: usize,\n290\t}\n291\t\n292\tunsafe extern \"C\" fn loader_cb(buf: *mut c_void, buflen: size_t, arg: *mut c_void) -> size_t {\n293\t    let st = arg as *mut CbState;\n294\t    (*st).calls += 1;\n295\t    match (*st).mode {\n296\t        CB_ZERO => 0,\n297\t        CB_ERROR => usize::MAX,\n298\t        CB_ONE_BYTE => {\n299\t            if (*st).pos >= (*st).len {\n300\t                return 0;\n301\t            }\n302\t            *(buf as *mut u8) = *(*st).data.add((*st).pos);\n303\t            (*st).pos += 1;\n304\t            1\n305\t        }\n306\t        CB_BIG => {\n307\t            let n = core::cmp::min(buflen, (*st).len - (*st).pos);\n308\t            if n == 0 {\n309\t                return 0;\n310\t            }\n311\t            core::ptr::copy_nonoverlapping((*st).data.add((*st).pos), buf as *mut u8, n);\n312\t            (*st).pos += n;\n313\t            n\n314\t        }\n315\t        CB_SHORT => {\n316\t            let limit = core::cmp::min((*st).stop_after, (*st).len);\n317\t            if (*st).pos >= limit {\n318\t                return 0;\n319\t            }\n320\t            let n = core::cmp::min(buflen, limit - (*st).pos);\n321\t            core::ptr::copy_nonoverlapping((*st).data.add((*st).pos), buf as *mut u8, n);\n322\t            (*st).pos += n;\n323\t            n\n324\t        }\n325\t        _ => 0,\n326\t    }\n327\t}\n328\t\n329\tunsafe fn cmp_load_callback(\n330\t    c: &Api,\n331\t    r: &Api,\n332\t    text: &[u8],\n333\t    mode: c_int,\n334\t    stop_after: usize,\n335\t    flags: size_t,\n336\t    ctx: &str,\n337\t) {\n338\t    let mk = || CbState {\n339\t        data: if text.is_empty() {\n340\t            b\"\".as_ptr()\n341\t        } else {\n342\t            text.as_ptr()\n343\t        },\n344\t        len: text.len(),\n345\t        pos: 0,\n346\t        stop_after,\n347\t        mode,\n348\t        calls: 0,\n349\t    };\n350\t    let mut cst = mk();\n351\t    let mut rst = mk();\n352\t    let mut ce = json_error_t::poisoned();\n353\t    let mut re = json_error_t::poisoned();\n354\t    let cj = (c.json_load_callback)(\n355\t        Some(loader_cb),\n356\t        &mut cst as *mut CbState as *mut c_void,\n357\t        flags,\n358\t        &mut ce,\n359\t    );\n360\t    let rj = (r.json_load_callback)(\n361\t        Some(loader_cb),\n362\t        &mut rst as *mut CbState as *mut c_void,\n363\t        flags,\n364\t        &mut re,\n365\t    );\n366\t    let cs_ = snap(c, cj, &ce);\n367\t    let rs_ = snap(r, rj, &re);\n368\t    let full = format!(\n369\t        \"json_load_callback(mode={mode}, stop_after={stop_after}, flags={flags:#x}) \\\n370\t         input={:?} [{ctx}]\",\n371\t        show(text)\n372\t    );\n373\t    cs_.compare(&rs_, &full);\n374\t    // The callback protocol itself must be driven identically: same number of\n375\t    // callback invocations and same number of bytes consumed.\n376\t    diff_eq!(cst.calls, rst.calls, \"callback invocation count — {full}\");\n377\t    diff_eq!(cst.pos, rst.pos, \"callback bytes consumed — {full}\");\n378\t    decref(c, cj);\n379\t    decref(r, rj);\n380\t}\n381\t\n382\t// ---------------------------------------------------------------------------\n383\t// Generators\n384\t// ---------------------------------------------------------------------------\n385\t\n386\tfn ws(rng: &mut Rng, out: &mut Vec<u8>) {\n387\t    // All four characters the lex_scan skip loop accepts, in random runs;\n388\t    // '\\n' additionally exercises line/last_column bookkeeping.\n389\t    let n = match rng.below(6) {\n390\t        0 => 1,"}]},"parent_tool_use_id":"toolu_bdrk_01RXgwoiuECjpqeirpk1kSob","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"959cb304-a5aa-4ae4-ab4f-159a0423f5e8","timestamp":"2026-08-31T04:25:38.371Z","subagent_type":"general-purpose","task_description":"Phase C error tests for load.c"}
