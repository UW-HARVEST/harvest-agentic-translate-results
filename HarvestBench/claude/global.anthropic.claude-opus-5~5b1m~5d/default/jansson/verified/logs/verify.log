{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017qm4ZQr7XK8QAZ7LddNbTg","type":"tool_result","content":"1\t//! Variadic entry points.\n2\t//!\n3\t//! The C library exposes a handful of variadic functions that simply build a\n4\t//! `va_list` and delegate to a `v*` counterpart. Rust cannot define C variadic\n5\t//! functions on stable, so each one is provided as a naked function containing\n6\t//! the standard x86-64 System V variadic prologue followed by a tail call into\n7\t//! the `v*` implementation.\n8\t//!\n9\t//! Frame layout (after `push rbp; mov rbp, rsp; sub rsp, 208`):\n10\t//!\n11\t//! ```text\n12\t//!   [rbp-208] .. [rbp-185]   va_list (gp_offset, fp_offset, overflow, reg_save)\n13\t//!   [rbp-176] .. [rbp-129]   general purpose register save area (rdi..r9)\n14\t//!   [rbp-128] .. [rbp-1]     xmm0..xmm7 register save area\n15\t//!   [rbp+16]                 first stack (overflow) argument\n16\t//! ```\n17\t\n18\tuse core::arch::naked_asm;\n19\t\n20\t/// The register spill part of the variadic prologue, shared by every shim.\n21\tmacro_rules! prologue {\n22\t    ($gp_offset:literal) => {\n23\t        concat!(\n24\t            \"push rbp\\n\",\n25\t            \"mov rbp, rsp\\n\",\n26\t            \"sub rsp, 208\\n\",\n27\t            \"mov qword ptr [rbp-176], rdi\\n\",\n28\t            \"mov qword ptr [rbp-168], rsi\\n\",\n29\t            \"mov qword ptr [rbp-160], rdx\\n\",\n30\t            \"mov qword ptr [rbp-152], rcx\\n\",\n31\t            \"mov qword ptr [rbp-144], r8\\n\",\n32\t            \"mov qword ptr [rbp-136], r9\\n\",\n33\t            \"test al, al\\n\",\n34\t            \"je 2f\\n\",\n35\t            \"movaps xmmword ptr [rbp-128], xmm0\\n\",\n36\t            \"movaps xmmword ptr [rbp-112], xmm1\\n\",\n37\t            \"movaps xmmword ptr [rbp-96], xmm2\\n\",\n38\t            \"movaps xmmword ptr [rbp-80], xmm3\\n\",\n39\t            \"movaps xmmword ptr [rbp-64], xmm4\\n\",\n40\t            \"movaps xmmword ptr [rbp-48], xmm5\\n\",\n41\t            \"movaps xmmword ptr [rbp-32], xmm6\\n\",\n42\t            \"movaps xmmword ptr [rbp-16], xmm7\\n\",\n43\t            \"2:\\n\",\n44\t            \"mov dword ptr [rbp-208], \",\n45\t            stringify!($gp_offset),\n46\t            \"\\n\",\n47\t            \"mov dword ptr [rbp-204], 48\\n\",\n48\t            \"lea rax, [rbp+16]\\n\",\n49\t            \"mov qword ptr [rbp-200], rax\\n\",\n50\t            \"lea rax, [rbp-176]\\n\",\n51\t            \"mov qword ptr [rbp-192], rax\\n\",\n52\t        )\n53\t    };\n54\t}\n55\t\n56\tmacro_rules! epilogue {\n57\t    () => {\n58\t        concat!(\"mov rsp, rbp\\n\", \"pop rbp\\n\", \"ret\\n\")\n59\t    };\n60\t}\n61\t\n62\t/* json_pack(fmt, ...) -> json_vpack_ex(NULL, 0, fmt, ap) */\n63\t#[unsafe(naked)]\n64\t#[unsafe(no_mangle)]\n65\tpub unsafe extern \"C\" fn json_pack() -> *mut crate::jansson::json_t {\n66\t    naked_asm!(\n67\t        prologue!(8),\n68\t        \"lea rcx, [rbp-208]\",\n69\t        \"mov rdx, rdi\",\n70\t        \"xor esi, esi\",\n71\t        \"xor edi, edi\",\n72\t        \"call {target}\",\n73\t        epilogue!(),\n74\t        target = sym crate::pack_unpack::json_vpack_ex,\n75\t    )\n76\t}\n77\t\n78\t/* json_pack_ex(error, flags, fmt, ...) -> json_vpack_ex(error, flags, fmt, ap) */\n79\t#[unsafe(naked)]\n80\t#[unsafe(no_mangle)]\n81\tpub unsafe extern \"C\" fn json_pack_ex() -> *mut crate::jansson::json_t {\n82\t    naked_asm!(\n83\t        prologue!(24),\n84\t        \"lea rcx, [rbp-208]\",\n85\t        \"call {target}\",\n86\t        epilogue!(),\n87\t        target = sym crate::pack_unpack::json_vpack_ex,\n88\t    )\n89\t}\n90\t\n91\t/* json_unpack(root, fmt, ...) -> json_vunpack_ex(root, NULL, 0, fmt, ap) */\n92\t#[unsafe(naked)]\n93\t#[unsafe(no_mangle)]\n94\tpub unsafe extern \"C\" fn json_unpack() -> core::ffi::c_int {\n95\t    naked_asm!(\n96\t        prologue!(16),\n97\t        \"lea r8, [rbp-208]\",\n98\t        \"mov rcx, rsi\",\n99\t        \"xor esi, esi\",\n100\t        \"xor edx, edx\",\n101\t        \"call {target}\",\n102\t        epilogue!(),\n103\t        target = sym crate::pack_unpack::json_vunpack_ex,\n104\t    )\n105\t}\n106\t\n107\t/* json_unpack_ex(root, error, flags, fmt, ...)\n108\t   -> json_vunpack_ex(root, error, flags, fmt, ap) */\n109\t#[unsafe(naked)]\n110\t#[unsafe(no_mangle)]\n111\tpub unsafe extern \"C\" fn json_unpack_ex() -> core::ffi::c_int {\n112\t    naked_asm!(\n113\t        prologue!(32),\n114\t        \"lea r8, [rbp-208]\",\n115\t        \"call {target}\",\n116\t        epilogue!(),\n117\t        target = sym crate::pack_unpack::json_vunpack_ex,\n118\t    )\n119\t}\n120\t\n121\t/* json_sprintf(fmt, ...) -> json_vsprintf(fmt, ap) */\n122\t#[unsafe(naked)]\n123\t#[unsafe(no_mangle)]\n124\tpub unsafe extern \"C\" fn json_sprintf() -> *mut crate::jansson::json_t {\n125\t    naked_asm!(\n126\t        prologue!(8),\n127\t        \"lea rsi, [rbp-208]\",\n128\t        \"call {target}\",\n129\t        epilogue!(),\n130\t        target = sym crate::value::json_vsprintf,\n131\t    )\n132\t}\n133\t\n134\t/* jsonp_error_set(error, line, column, position, code, msg, ...)\n135\t   -> jsonp_error_vset(error, line, column, position, code, msg, ap)\n136\t\n137\t   The va_list becomes the seventh integer argument, so it is passed on the\n138\t   stack. */\n139\t#[unsafe(naked)]\n140\t#[unsafe(no_mangle)]\n141\tpub unsafe extern \"C\" fn jsonp_error_set() {\n142\t    naked_asm!(\n143\t        prologue!(48),\n144\t        \"lea rax, [rbp-208]\",\n145\t        \"sub rsp, 8\",\n146\t        \"push rax\",\n147\t        \"call {target}\",\n148\t        epilogue!(),\n149\t        target = sym crate::error::jsonp_error_vset,\n150\t    )\n151\t}\n152\t"}]},"parent_tool_use_id":"toolu_bdrk_013ioknR3uh5BBsa6ebVj2DJ","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"38ca2ddd-a3d8-417d-a3e5-65a53f0871d1","timestamp":"2026-08-31T04:56:37.877Z","subagent_type":"general-purpose","task_descriptio