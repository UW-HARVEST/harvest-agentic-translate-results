{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MWU3sPNFBCShUzyrdRf4JM","type":"tool_result","content":"1\t//! Types and inline helpers from `jansson.h` / `jansson_private.h`.\n2\t\n3\tuse core::ffi::{c_char, c_int, c_void};\n4\t\n5\tuse crate::hashtable::hashtable_t;\n6\t\n7\t/* json_type */\n8\tpub const JSON_OBJECT: c_int = 0;\n9\tpub const JSON_ARRAY: c_int = 1;\n10\tpub const JSON_STRING: c_int = 2;\n11\tpub const JSON_INTEGER: c_int = 3;\n12\tpub const JSON_REAL: c_int = 4;\n13\tpub const JSON_TRUE: c_int = 5;\n14\tpub const JSON_FALSE: c_int = 6;\n15\tpub const JSON_NULL: c_int = 7;\n16\t\n17\tpub type json_int_t = i64;\n18\t\n19\t#[repr(C)]\n20\tpub struct json_t {\n21\t    pub type_: c_int,\n22\t    pub refcount: usize,\n23\t}\n24\t\n25\tpub const JSON_ERROR_TEXT_LENGTH: usize = 160;\n26\tpub const JSON_ERROR_SOURCE_LENGTH: usize = 80;\n27\t\n28\t#[repr(C)]\n29\tpub struct json_error_t {\n30\t    pub line: c_int,\n31\t    pub column: c_int,\n32\t    pub position: c_int,\n33\t    pub source: [c_char; JSON_ERROR_SOURCE_LENGTH],\n34\t    pub text: [c_char; JSON_ERROR_TEXT_LENGTH],\n35\t}\n36\t\n37\t/* enum json_error_code */\n38\tpub const json_error_unknown: c_int = 0;\n39\tpub const json_error_out_of_memory: c_int = 1;\n40\tpub const json_error_stack_overflow: c_int = 2;\n41\tpub const json_error_cannot_open_file: c_int = 3;\n42\tpub const json_error_invalid_argument: c_int = 4;\n43\tpub const json_error_invalid_utf8: c_int = 5;\n44\tpub const json_error_premature_end_of_input: c_int = 6;\n45\tpub const json_error_end_of_input_expected: c_int = 7;\n46\tpub const json_error_invalid_syntax: c_int = 8;\n47\tpub const json_error_invalid_format: c_int = 9;\n48\tpub const json_error_wrong_type: c_int = 10;\n49\tpub const json_error_null_character: c_int = 11;\n50\tpub const json_error_null_value: c_int = 12;\n51\tpub const json_error_null_byte_in_key: c_int = 13;\n52\tpub const json_error_duplicate_key: c_int = 14;\n53\tpub const json_error_numeric_overflow: c_int = 15;\n54\tpub const json_error_item_not_found: c_int = 16;\n55\tpub const json_error_index_out_of_range: c_int = 17;\n56\t\n57\t/* decoding flags */\n58\tpub const JSON_REJECT_DUPLICATES: usize = 0x1;\n59\tpub const JSON_DISABLE_EOF_CHECK: usize = 0x2;\n60\tpub const JSON_DECODE_ANY: usize = 0x4;\n61\tpub const JSON_DECODE_INT_AS_REAL: usize = 0x8;\n62\tpub const JSON_ALLOW_NUL: usize = 0x10;\n63\t\n64\t/* pack/unpack flags */\n65\tpub const JSON_VALIDATE_ONLY: usize = 0x1;\n66\tpub const JSON_STRICT: usize = 0x2;\n67\t\n68\t/* encoding flags */\n69\tpub const JSON_MAX_INDENT: usize = 0x1F;\n70\tpub const JSON_COMPACT: usize = 0x20;\n71\tpub const JSON_ENSURE_ASCII: usize = 0x40;\n72\tpub const JSON_SORT_KEYS: usize = 0x80;\n73\tpub const JSON_PRESERVE_ORDER: usize = 0x100;\n74\tpub const JSON_ENCODE_ANY: usize = 0x200;\n75\tpub const JSON_ESCAPE_SLASH: usize = 0x400;\n76\tpub const JSON_EMBED: usize = 0x10000;\n77\t\n78\tpub const JSON_PARSER_MAX_DEPTH: usize = 2048;\n79\t\n80\tpub type json_load_callback_t =\n81\t    Option<unsafe extern \"C\" fn(buffer: *mut c_void, buflen: usize, data: *mut c_void) -> usize>;\n82\tpub type json_dump_callback_t =\n83\t    Option<unsafe extern \"C\" fn(buffer: *const c_char, size: usize, data: *mut c_void) -> c_int>;\n84\t\n85\tpub type json_malloc_t = Option<unsafe extern \"C\" fn(usize) -> *mut c_void>;\n86\tpub type json_realloc_t = Option<unsafe extern \"C\" fn(*mut c_void, usize) -> *mut c_void>;\n87\tpub type json_free_t = Option<unsafe extern \"C\" fn(*mut c_void)>;\n88\t\n89\t/* ---- private aggregate types ---- */\n90\t\n91\t#[repr(C)]\n92\tpub struct json_object_t {\n93\t    pub json: json_t,\n94\t    pub hashtable: hashtable_t,\n95\t}\n96\t\n97\t#[repr(C)]\n98\tpub struct json_array_t {\n99\t    pub json: json_t,\n100\t    pub size: usize,\n101\t    pub entries: usize,\n102\t    pub table: *mut *mut json_t,\n103\t}\n104\t\n105\t#[repr(C)]\n106\tpub struct json_string_t {\n107\t    pub json: json_t,\n108\t    pub value: *mut c_char,\n109\t    pub length: usize,\n110\t}\n111\t\n112\t#[repr(C)]\n113\tpub struct json_real_t {\n114\t    pub json: json_t,\n115\t    pub value: f64,\n116\t}\n117\t\n118\t#[repr(C)]\n119\tpub struct json_integer_t {\n120\t    pub json: json_t,\n121\t    pub value: json_int_t,\n122\t}\n123\t\n124\t/// Space for \"0x\", double the sizeof a pointer for the hex and a terminator.\n125\tpub const LOOP_KEY_LEN: usize = 2 + (core::mem::size_of::<*mut json_t>() * 2) + 1;\n126\t\n127\t/* ---- inline helpers ---- */\n128\t\n129\t#[inline]\n130\tpub unsafe fn json_typeof(json: *const json_t) -> c_int {\n131\t    (*json).type_\n132\t}\n133\t\n134\t#[inline]\n135\tpub unsafe fn json_is_object(json: *const json_t) -> bool {\n136\t    !json.is_null() && json_typeof(json) == JSON_OBJECT\n137\t}\n138\t\n139\t#[inline]\n140\tpub unsafe fn json_is_array(json: *const json_t) -> bool {\n141\t    !json.is_null() && json_typeof(json) == JSON_ARRAY\n142\t}\n143\t\n144\t#[inline]\n145\tpub unsafe fn json_is_string(json: *const json_t) -> bool {\n146\t    !json.is_null() && json_typeof(json) == JSON_STRING\n147\t}\n148\t\n149\t#[inline]\n150\tpub unsafe fn json_is_integer(json: *const json_t) -> bool {\n151\t    !json.is_null() && json_typeof(json) == JSON_INTEGER\n152\t}\n153\t\n154\t#[inline]\n155\tpub unsafe fn json_is_real(json: *const json_t) -> bool {\n156\t    !json.is_null() && json_typeof(json) == JSON_REAL\n157\t}\n158\t\n159\t#[inline]\n160\tpub unsafe fn json_is_number(json: *const json_t) -> bool {\n161\t    json_is_integer(json) || json_is_real(json)\n162\t}\n163\t\n164\t#[inline]\n165\tpub unsafe fn json_is_true(json: *const json_t) -> bool {\n166\t    !json.is_null() && json_typeof(json) == JSON_TRUE\n167\t}\n168\t\n169\t#[inline]\n170\tpub unsafe fn json_is_false(json: *const json_t) -> bool {\n171\t    !json.is_null() && json_typeof(json) == JSON_FALSE\n172\t}\n173\t\n174\t#[inline]\n175\tpub unsafe fn json_is_boolean(json: *const json_t) -> bool {\n176\t    json_is_true(json) || json_is_false(json)\n177\t}\n178\t\n179\t#[inline]\n180\tpub unsafe fn json_is_null(json: *const json_t) -> bool {\n181\t    !json.is_null() && json_typeof(json) == JSON_NULL\n182\t}\n183\t\n184\t#[inline]\n185\tpub unsafe fn json_incref(json: *mut json_t) -> *mut json_t {\n186\t    if !json.is_null() && (*json).refcount != usize::MAX {\n187\t        let p = core::ptr::addr_of_mut!((*json).refcount);\n188\t        p.write_volatile(p.read_volatile().wrapping_add(1));\n189\t    }\n190\t    json\n191\t}\n192\t\n193\t#[inline]\n194\tpub unsafe fn json_decref(json: *mut json_t) {\n195\t    if !json.is_null() && (*json).refcount != usize::MAX {\n196\t        let p = core::ptr::addr_of_mut!((*json).refcount);\n197\t        let n = p.read_volatile().wrapping_sub(1);\n198\t        p.write_volatile(n);\n199\t        if n == 0 {\n200\t            crate::value::json_delete(json);\n201\t        }\n202\t    }\n203\t}\n204\t\n205\t/// `container_of()` for a member at byte offset `off`.\n206\t#[inline]\n207\tpub unsafe fn container_of_raw<T>(ptr: *const c_void, off: usize) -> *mut T {\n208\t    (ptr as *const u8).sub(off) as *mut T\n209\t}\n210\t"}]},"parent_tool_use_id":"toolu_bdrk_01GnKT4a7Vpx2yRpQPbdMyaQ","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"c2e3d535-a81e-4742-a130-ff6482db2279","timestamp":"2026-08-31T04:45:25.070Z","subagent_type":"general-purpose","task_description":"Phase C error tests for value.c"}
