{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NRFnEdv2CZHWuwgxiTpnHA","type":"tool_result","content":"1\t//! Translation of `src/hashtable_seed.c`.\n2\t//!\n3\t//! Generate sizeof(uint32_t) bytes of as random data as possible to seed the\n4\t//! hash function.\n5\t\n6\tuse core::ffi::{c_char, c_void};\n7\tuse core::sync::atomic::{AtomicBool, AtomicU32, Ordering};\n8\t\n9\tuse crate::ffi;\n10\t\n11\t/// Exported (and deliberately mutable) hash seed, mirroring\n12\t/// `volatile uint32_t hashtable_seed`.\n13\t#[unsafe(no_mangle)]\n14\tpub static mut hashtable_seed: u32 = 0;\n15\t\n16\tstatic SEED_INITIALIZED: AtomicBool = AtomicBool::new(false);\n17\t\n18\t#[inline]\n19\tpub unsafe fn seed_value() -> u32 {\n20\t    core::ptr::addr_of!(hashtable_seed).read_volatile()\n21\t}\n22\t\n23\tunsafe fn buf_to_uint32(data: *const c_char) -> u32 {\n24\t    let mut result: u32 = 0;\n25\t\n26\t    for i in 0..core::mem::size_of::<u32>() {\n27\t        result = (result << 8) | (*data.add(i) as u8) as u32;\n28\t    }\n29\t\n30\t    result\n31\t}\n32\t\n33\t/* /dev/urandom */\n34\tunsafe fn seed_from_urandom(seed: *mut u32) -> i32 {\n35\t    /* Use unbuffered I/O if we have open(), close() and read(). */\n36\t    let mut data = [0i8; 4];\n37\t\n38\t    let urandom = ffi::open(b\"/dev/urandom\\0\".as_ptr() as *const c_char, ffi::O_RDONLY);\n39\t    if urandom == -1 {\n40\t        return 1;\n41\t    }\n42\t\n43\t    let ok = ffi::read(urandom, data.as_mut_ptr() as *mut c_void, 4) == 4;\n44\t    ffi::close(urandom);\n45\t\n46\t    if !ok {\n47\t        return 1;\n48\t    }\n49\t\n50\t    *seed = buf_to_uint32(data.as_ptr() as *const c_char);\n51\t    0\n52\t}\n53\t\n54\t/* gettimeofday() and getpid() */\n55\tunsafe fn seed_from_timestamp_and_pid(seed: *mut u32) -> i32 {\n56\t    /* XOR of seconds and microseconds */\n57\t    let mut tv = ffi::timeval {\n58\t        tv_sec: 0,\n59\t        tv_usec: 0,\n60\t    };\n61\t    ffi::gettimeofday(&mut tv, core::ptr::null_mut());\n62\t    *seed = (tv.tv_sec as u32) ^ (tv.tv_usec as u32);\n63\t\n64\t    /* XOR with PID for more randomness */\n65\t    *seed ^= ffi::getpid() as u32;\n66\t\n67\t    0\n68\t}\n69\t\n70\tunsafe fn generate_seed() -> u32 {\n71\t    let mut seed: u32 = 0;\n72\t    let mut done = 0;\n73\t\n74\t    if seed_from_urandom(&mut seed) == 0 {\n75\t        done = 1;\n76\t    }\n77\t\n78\t    if done == 0 {\n79\t        /* Fall back to timestamp and PID if no better randomness is\n80\t        available */\n81\t        seed_from_timestamp_and_pid(&mut seed);\n82\t    }\n83\t\n84\t    /* Make sure the seed is never zero */\n85\t    if seed == 0 {\n86\t        seed = 1;\n87\t    }\n88\t\n89\t    seed\n90\t}\n91\t\n92\t#[unsafe(no_mangle)]\n93\tpub unsafe extern \"C\" fn json_object_seed(seed: usize) {\n94\t    let mut new_seed = seed as u32;\n95\t\n96\t    if seed_value() == 0 {\n97\t        let atomic = AtomicU32::from_ptr(core::ptr::addr_of_mut!(hashtable_seed));\n98\t        if !SEED_INITIALIZED.swap(true, Ordering::Relaxed) {\n99\t            /* Do the seeding ourselves */\n100\t            if new_seed == 0 {\n101\t                new_seed = generate_seed();\n102\t            }\n103\t\n104\t            atomic.store(new_seed, Ordering::Release);\n105\t        } else {\n106\t            /* Wait for another thread to do the seeding */\n107\t            loop {\n108\t                ffi::sched_yield();\n109\t                if atomic.load(Ordering::Acquire) != 0 {\n110\t                    break;\n111\t                }\n112\t            }\n113\t        }\n114\t    }\n115\t}\n116\t"}]},"parent_tool_use_id":"toolu_bdrk_01GnKT4a7Vpx2yRpQPbdMyaQ","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"a60c2944-b207-41fa-adc3-13bc4b318a65","timestamp":"2026-08-31T04:45:34.318Z","subagent_type":"general-purpose","task_description":"Phase C error tests for value.c"}
