{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_a3q6bi7xn6ezkm7ryabtkb3arffxfg3d2gfdj5iyi7fj3q5pulvq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01LuhfJop684PyUY3jemqQhg","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-6oQ0Bh/translation/tests/a00_smoke.rs","content":"//! Harness smoke test: proves both shared objects load, every one of the 130\n//! exported symbols resolves in BOTH of them, and a trivial round trip agrees.\n\nmod common;\nuse common::*;\n\n#[test]\nfn both_libraries_expose_every_symbol() {\n    // Api::load panics with the offending symbol name if anything is missing,\n    // so simply constructing both APIs is the parity check.\n    let (c, r) = both();\n    assert_eq!(c.which, \"C\");\n    assert_eq!(r.which, \"Rust\");\n}\n\n#[test]\nfn version_matches() {\n    let (c, r) = both();\n    unsafe {\n        diff_eq!(\n            cbytes((c.jansson_version_str)()),\n            cbytes((r.jansson_version_str)()),\n            \"jansson_version_str\"\n        );\n        for (ma, mi, mu) in [\n            (0, 0, 0),\n            (2, 15, 0),\n            (2, 15, 1),\n            (2, 14, 9),\n            (3, 0, 0),\n            (1, 99, 99),\n            (-1, -1, -1),\n            (i32::MAX, i32::MAX, i32::MAX),\n            (i32::MIN, i32::MIN, i32::MIN),\n        ] {\n            diff_eq!(\n                (c.jansson_version_cmp)(ma, mi, mu).signum(),\n                (r.jansson_version_cmp)(ma, mi, mu).signum(),\n                \"jansson_version_cmp({ma},{mi},{mu})\"\n            );\n        }\n    }\n}\n\n#[test]\nfn dtoa_divmax_data_symbol_matches() {\n    let (c, r) = both();\n    diff_eq!(c.dtoa_divmax(), r.dtoa_divmax(), \"dtoa_divmax\");\n}\n\n#[test]\nfn trivial_round_trip() {\n    let (c, r) = both();\n    let input = cs(r#\"{\"a\":[1,2,3],\"b\":\"x\",\"c\":true,\"d\":null,\"e\":1.5}\"#);\n    unsafe {\n        let mut ce = json_error_t::new();\n        let mut re = json_error_t::new();\n        let cj = (c.json_loads)(input.as_ptr(), 0, &mut ce);\n        let rj = (r.json_loads)(input.as_ptr(), 0, &mut re);\n        assert!(!cj.is_null(), \"C failed to parse: {}\", ce.text_str());\n        assert!(!rj.is_null(), \"Rust failed to parse: {}\", re.text_str());\n\n        let cd = (c.json_dumps)(cj, JSON_SORT_KEYS);\n        let rd = (r.json_dumps)(rj, JSON_SORT_KEYS);\n        diff_eq!(cbytes(cd), cbytes(rd), \"json_dumps round trip\");\n\n        jfree(c, cd as *mut _);\n        jfree(r, rd as *mut _);\n        decref(c, cj);\n        decref(r, rj);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":641,"cache_read_input_tokens":65533,"cache_creation":{"ephemeral_5m_input_tokens":641,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"db8fc527-0c95-4af4-b545-48d54a4357f7","timestamp":"2026-08-31T03:43:20.762Z"}
