cj = (c.json_sprintf)(fmt.as_ptr(), sarg.as_ptr(), darg, farg);\n            let rj = (r.json_sprintf)(fmt.as_ptr(), sarg.as_ptr(), darg, farg);\n            cmp_string_json(c, r, cj, rj,\n                            &format!(\"iter {i}: {fmt_text:?} {sarg_text:?} {darg} {farg:e}\"));\n            decref(c, cj);\n            decref(r, rj);\n        }\n    }\n}\nEOF\ntimeout 900 cargo test --release --test a08_pack_unpack -- --test-threads=1 2>&1 | grep -E \"^test spr|^test vspr|SIGSEGV|panicked|divergence|test result|^error|left:|right:|^  C|^  Rust\" | tail -20","is_backgrounded":false,"task_type":"local_bash","uuid":"74aa2203-9df9-499e-9f56-4437b18695a3","session_id":"e1728859-25d0-4463-adf4-96231e8435a5"}
