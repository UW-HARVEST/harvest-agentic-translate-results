64_json_object_fresh_state() {\n406:#[test]\n407:fn row165_seed_is_deterministic_and_one_shot() {\n448:#[test]\n449:fn row166_json_array_fresh_state() {\n465:// ===========================================================================\n467:// ===========================================================================\n470:fn bad_utf8() -> Vec<(&'static str, Vec<u8>)> {\n485:#[test]\n486:fn row167_json_string_valid_inputs() {\n535:#[test]\n536:fn row168_json_string_rejects_invalid_utf8() {\n570:#[test]\n571:fn row169_json_stringn_length_variants() {\n614:#[test]\n615:fn row170_string_nocheck_accepts_everything() {\n682:#[test]\n683:fn row171_jsonp_stringn_nocheck_own_takes_ownership() {\n741:// ===========================================================================\n743:// ===========================================================================\n745:#[test]\n746:fn row172_json_integer_values() {\n773:#[test]\n774:fn row173_json_real_finite_values() {\n804:#[test]\n805:fn row174_json_real_rejects_nan_and_inf() {\n831:#[test]\n832:fn row175_singletons_are_static_and_never_freed() {\n876:#[test]\n877:fn row176_json_delete_every_type() {\n929:#[test]\n930:fn row177_json_delete_null_is_a_noop() {\n943:// ===========================================================================\n945:// ===========================================================================\n949:unsafe fn objs_with_n(c: &Api, r: &Api, n: usize) -> (*mut json_t, *mut json_t) {\n961:unsafe fn non_objects(api: &Api) -> Vec<(&'static str, *mut json_t)> {\n974:unsafe fn non_arrays(api: &Api) -> Vec<(&'static str, *mut json_t)> {\n987:#[test]\n988:fn row178_json_object_size() {\n1019:#[test]\n1020:fn row179_json_object_get() {\n1090:#[test]\n1091:fn row180_json_object_getn_key_len_variants() {\n1175:#[test]\n1176:fn row181_json_object_set_new() {\n1214:#[test]\n1215:fn row182_json_object_setn_new_key_len_variants() {\n1254:#[test]\n1255:fn row183_set_new_nocheck_error_branches() {\n1370:#[test]\n1371:fn row184_setn_new_nocheck_all_eight_types() {\n1406:#[test]\n1407:fn row185_object_growth_across_rehash_boundaries() {\n1441:#[test]\n1442:fn row186_json_object_del_and_deln() {\n1546:#[test]\n1547:fn row187_json_object_clear() {\n1604:// ===========================================================================\n1606:// ===========================================================================\n1609:fn update_fns(\n1620:#[test]\n1621:fn row188_json_object_update() {\n1766:#[test]\n1767:fn row189_update_existing_and_missing() {\n1852:#[test]\n1853:fn row190_update_recursive_nested() {\n1968:unsafe fn obj_cycle(api: &Api) -> (*mut json_t, *mut json_t) {\n1978:unsafe fn break_cycle(api: &Api, a: *mut json_t, b: *mut json_t) {\n1985:#[test]\n1986:fn row191_update_recursive_rejects_cycles() {\n2091:#[test]\n2092:fn row192_do_object_update_recursive_shared_subtree() {\n2172:#[test]\n2173:fn row193_update_recursive_non_objects() {\n2221:// ===========================================================================\n2223:// ===========================================================================\n2225:#[test]\n2226:fn row194_jsonp_loop_check() {\n2344:// ===========================================================================\n2346:// ===========================================================================\n2348:#[test]\n2349:fn row195_object_iteration() {\n2463:#[test]\n2464:fn row196_json_object_key_to_iter_round_trip() {\n2511:#[test]\n2512:fn row197_iter_key_key_len_value_edge_keys() {\n2604:#[test]\n2605:fn row198_json_object_iter_set_new() {\n2659:// ===========================================================================\n2661:// ===========================================================================\n2663:unsafe fn arrays_with_n(c: &Api, r: &Api, n: usize) -> (*mut json_t, *mut json_t) {\n2673:#[test]\n2674:fn row199_json_array_size_and_get() {\n2732:#[test]\n2733:fn row200_json_array_set_new() {\n2794:#[test]\n2795:fn row201_json_array_append