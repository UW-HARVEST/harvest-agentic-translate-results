{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QronG325VWCWUK4Q5r3i7S","type":"tool_result","content":"1\t//! Translation of `src/dump.c`.\n2\t\n3\tuse core::ffi::{c_char, c_int, c_uint, c_void};\n4\t\n5\tuse crate::ffi::{self, FILE};\n6\tuse crate::hashtable::{hashtable_close, hashtable_del, hashtable_init, hashtable_t};\n7\tuse crate::jansson::*;\n8\tuse crate::memory::{jsonp_free, jsonp_malloc, jsonp_realloc};\n9\tuse crate::strbuffer::{\n10\t    strbuffer_append_bytes, strbuffer_close, strbuffer_init, strbuffer_steal_value, strbuffer_t,\n11\t};\n12\tuse crate::strconv::jsonp_dtostr;\n13\tuse crate::utf::utf8_iterate;\n14\tuse crate::value::*;\n15\t\n16\tconst MAX_INTEGER_STR_LENGTH: usize = 25;\n17\tconst MAX_REAL_STR_LENGTH: usize = 25;\n18\t\n19\t#[inline]\n20\tfn flags_to_indent(f: usize) -> usize {\n21\t    f & 0x1F\n22\t}\n23\t\n24\t#[inline]\n25\tfn flags_to_precision(f: usize) -> c_int {\n26\t    ((f >> 11) & 0x1F) as c_int\n27\t}\n28\t\n29\t#[repr(C)]\n30\tstruct buffer {\n31\t    size: usize,\n32\t    used: usize,\n33\t    data: *mut c_char,\n34\t}\n35\t\n36\tunsafe extern \"C\" fn dump_to_strbuffer(\n37\t    buffer: *const c_char,\n38\t    size: usize,\n39\t    data: *mut c_void,\n40\t) -> c_int {\n41\t    strbuffer_append_bytes(data as *mut strbuffer_t, buffer, size)\n42\t}\n43\t\n44\tunsafe extern \"C\" fn dump_to_buffer(\n45\t    buffer_: *const c_char,\n46\t    size: usize,\n47\t    data: *mut c_void,\n48\t) -> c_int {\n49\t    let buf = data as *mut buffer;\n50\t\n51\t    if (*buf).used + size <= (*buf).size {\n52\t        ffi::memcpy(\n53\t            (*buf).data.add((*buf).used) as *mut c_void,\n54\t            buffer_ as *const c_void,\n55\t            size,\n56\t        );\n57\t    }\n58\t\n59\t    (*buf).used += size;\n60\t    0\n61\t}\n62\t\n63\tunsafe extern \"C\" fn dump_to_file(\n64\t    buffer: *const c_char,\n65\t    size: usize,\n66\t    data: *mut c_void,\n67\t) -> c_int {\n68\t    let dest = data as *mut FILE;\n69\t    if ffi::fwrite(buffer as *const c_void, size, 1, dest) != 1 {\n70\t        return -1;\n71\t    }\n72\t    0\n73\t}\n74\t\n75\tunsafe extern \"C\" fn dump_to_fd(buffer: *const c_char, size: usize, data: *mut c_void) -> c_int {\n76\t    let dest = data as *mut c_int;\n77\t    if ffi::write(*dest, buffer as *const c_void, size) == size as isize {\n78\t        return 0;\n79\t    }\n80\t    -1\n81\t}\n82\t\n83\t/* 32 spaces (the maximum indentation size) */\n84\tstatic WHITESPACE: &[u8; 33] = b\"                                \\0\";\n85\t\n86\tunsafe fn dump_indent(\n87\t    flags: usize,\n88\t    depth: c_int,\n89\t    space: c_int,\n90\t    dump: json_dump_callback_t,\n91\t    data: *mut c_void,\n92\t) -> c_int {\n93\t    let dump = dump.unwrap();\n94\t    if flags_to_indent(flags) > 0 {\n95\t        let ws_count = flags_to_indent(flags) as c_uint;\n96\t        let mut n_spaces = (depth as c_uint).wrapping_mul(ws_count);\n97\t\n98\t        if dump(b\"\\n\\0\".as_ptr() as *const c_char, 1, data) != 0 {\n99\t            return -1;\n100\t        }\n101\t\n102\t        while n_spaces > 0 {\n103\t            let cur_n = if (n_spaces as usize) < WHITESPACE.len() - 1 {\n104\t                n_spaces as usize\n105\t            } else {\n106\t                WHITESPACE.len() - 1\n107\t            };\n108\t\n109\t            if dump(WHITESPACE.as_ptr() as *const c_char, cur_n, data) != 0 {\n110\t                return -1;\n111\t            }\n112\t\n113\t            n_spaces -= cur_n as c_uint;\n114\t        }\n115\t    } else if space != 0 && (flags & JSON_COMPACT) == 0 {\n116\t        return dump(b\" \\0\".as_ptr() as *const c_char, 1, data);\n117\t    }\n118\t    0\n119\t}\n120\t\n121\tunsafe fn dump_string(\n122\t    str_: *const c_char,\n123\t    len: usize,\n124\t    dump: json_dump_callback_t,\n125\t    data: *mut c_void,\n126\t    flags: usize,\n127\t) -> c_int {\n128\t    let dumpf = dump.unwrap();\n129\t    let mut str_ = str_;\n130\t    let mut codepoint: i32 = 0;\n131\t\n132\t    if dumpf(b\"\\\"\\0\".as_ptr() as *const c_char, 1, data) != 0 {\n133\t        return -1;\n134\t    }\n135\t\n136\t    let mut pos = str_;\n137\t    let mut end = str_;\n138\t    let lim = str_.add(len);\n139\t    loop {\n140\t        let text: *const c_char;\n141\t        let mut seq = [0 as c_char; 13];\n142\t        let mut length: usize;\n143\t\n144\t        while end < lim {\n145\t            end = utf8_iterate(pos, lim as usize - pos as usize, &mut codepoint);\n146\t            if end.is_null() {\n147\t                return -1;\n148\t            }\n149\t\n150\t            /* mandatory escape or control char */\n151\t            if codepoint == '\\\\' as i32 || codepoint == '\"' as i32 || codepoint < 0x20 {\n152\t                break;\n153\t            }\n154\t\n155\t            /* slash */\n156\t            if (flags & JSON_ESCAPE_SLASH) != 0 && codepoint == '/' as i32 {\n157\t                break;\n158\t            }\n159\t\n160\t            /* non-ASCII */\n161\t            if (flags & JSON_ENSURE_ASCII) != 0 && codepoint > 0x7F {\n162\t                break;\n163\t            }\n164\t\n165\t            pos = end;\n166\t        }\n167\t\n168\t        if pos != str_ && dumpf(str_, pos as usize - str_ as usize, data) != 0 {\n169\t            return -1;\n170\t        }\n171\t\n172\t        if end == pos {\n173\t            break;\n174\t        }\n175\t\n176\t        /* handle \\, /, \", and control codes */\n177\t        length = 2;\n178\t        match codepoint {\n179\t            0x5C => text = b\"\\\\\\\\\\0\".as_ptr() as *const c_char,\n180\t            0x22 => text = b\"\\\\\\\"\\0\".as_ptr() as *const c_char,\n181\t            0x08 => text = b\"\\\\b\\0\".as_ptr() as *const c_char,\n182\t            0x0C => text = b\"\\\\f\\0\".as_ptr() as *const c_char,\n183\t            0x0A => text = b\"\\\\n\\0\".as_ptr() as *const c_char,\n184\t            0x0D => text = b\"\\\\r\\0\".as_ptr() as *const c_char,\n185\t            0x09 => text = b\"\\\\t\\0\".as_ptr() as *const c_char,\n186\t            0x2F => text = b\"\\\\/\\0\".as_ptr() as *const c_char,\n187\t            _ => {\n188\t                /* codepoint is in BMP */\n189\t                if codepoint < 0x10000 {\n190\t                    ffi::snprintf(\n191\t                        seq.as_mut_ptr(),\n192\t                        seq.len(),\n193\t                        b\"\\\\u%04X\\0\".as_ptr() as *const c_char,\n194\t                        codepoint as c_uint,\n195\t                    );\n196\t                    length = 6;\n197\t                } else {\n198\t                    /* not in BMP -> construct a UTF-16 surrogate pair */\n199\t                    let cp = codepoint - 0x10000;\n200\t                    let first = 0xD800 | ((cp & 0xffc00) >> 10);\n201\t                    let last = 0xDC00 | (cp & 0x003ff);\n202\t\n203\t                    ffi::snprintf(\n204\t                        seq.as_mut_ptr(),\n205\t                        seq.len(),\n206\t                        b\"\\\\u%04X\\\\u%04X\\0\".as_ptr() as *const c_char,\n207\t                        first as c_uint,\n208\t                        last as c_uint,\n209\t                    );\n210\t                    length = 12;\n211\t                }\n212\t\n213\t                text = seq.as_ptr();\n214\t            }\n215\t        }\n216\t\n217\t        if dumpf(text, length, data) != 0 {\n218\t            return -1;\n219\t        }\n220\t\n221\t        str_ = end;\n222\t        pos = end;\n223\t    }\n224\t\n225\t    dumpf(b\"\\\"\\0\".as_ptr() as *const c_char, 1, data)\n226\t}\n227\t\n228\t#[repr(C)]\n229\tstruct key_len {\n230\t    key: *const c_char,\n231\t    len: c_int,\n232\t}\n233\t\n234\tunsafe extern \"C\" fn compare_keys(key1: *const c_void, key2: *const c_void) -> c_int {\n235\t    let k1 = key1 as *const key_len;\n236\t    let k2 = key2 as *const key_len;\n237\t    let min_size = if (*k1).len < (*k2).len {\n238\t        (*k1).len\n239\t    } else {\n240\t        (*k2).len\n241\t    } as usize;\n242\t    let res = ffi::memcmp(\n243\t        (*k1).key as *const c_void,\n244\t        (*k2).key as *const c_void,\n245\t        min_size,\n246\t    );\n247\t\n248\t    if res != 0 {\n249\t        return res;\n250\t    }\n251\t\n252\t    (*k1).len - (*k2).len\n253\t}\n254\t\n255\tunsafe fn do_dump(\n256\t    json: *const json_t,\n257\t    mut flags: usize,\n258\t    depth: c_int,\n259\t    parents: *mut hashtable_t,\n260\t    dump: json_dump_callback_t,\n261\t    data: *mut c_void,\n262\t) -> c_int {\n263\t    let dumpf = dump.unwrap();\n264\t    let embed = flags & JSON_EMBED;\n265\t\n266\t    flags &= !JSON_EMBED;\n267\t\n268\t    if json.is_null() {\n269\t        return -1;\n270\t    }\n271\t\n272\t    match json_typeof(json) {\n273\t        JSON_NULL => dumpf(b\"null\\0\".as_ptr() as *const c_char, 4, data),\n274\t\n275\t        JSON_TRUE => dumpf(b\"true\\0\".as_ptr() as *const c_char, 4, data),\n276\t\n277\t        JSON_FALSE => dumpf(b\"false\\0\".as_ptr() as *const c_char, 5, data),\n278\t\n279\t        JSON_INTEGER => {\n280\t            let mut buffer = [0 as c_char; MAX_INTEGER_STR_LENGTH];\n281\t\n282\t            let size = ffi::snprintf(\n283\t                buffer.as_mut_ptr(),\n284\t                MAX_INTEGER_STR_LENGTH,\n285\t                b\"%lld\\0\".as_ptr() as *const c_char,\n286\t                json_integer_value(json),\n287\t            );\n288\t            if size < 0 || size as usize >= MAX_INTEGER_STR_LENGTH {\n289\t                return -1;\n290\t            }\n291\t\n292\t            dumpf(buffer.as_ptr(), size as usize, data)\n293\t        }\n294\t\n295\t        JSON_REAL => {\n296\t            let mut buffer = [0 as c_char; MAX_REAL_STR_LENGTH];\n297\t            let value = json_real_value(json);\n298\t\n299\t            let size = jsonp_dtostr(\n300\t                buffer.as_mut_ptr(),\n301\t                MAX_REAL_STR_LENGTH,\n302\t                value,\n303\t                flags_to_precision(flags),\n304\t            );\n305\t            if size < 0 {\n306\t                return -1;\n307\t            }\n308\t\n309\t            dumpf(buffer.as_ptr(), size as usize, data)\n310\t        }\n311\t\n312\t        JSON_STRING => dump_string(\n313\t            json_string_value(json),\n314\t            json_string_length(json),\n315\t            dump,\n316\t            data,\n317\t            flags,\n318\t        ),\n319\t\n320\t        JSON_ARRAY => {\n321\t            /* Space for \"0x\", double the sizeof a pointer for the hex and a\n322\t             * terminator. */\n323\t            let mut key = [0 as c_char; 2 + (core::mem::size_of::<*const json_t>() * 2) + 1];\n324\t            let mut key_len: usize = 0;\n325\t\n326\t            /* detect circular references */\n327\t            if jsonp_loop_check(parents, json, key.as_mut_ptr(), key.len(), &mut key_len) != 0 {\n328\t                return -1;\n329\t            }\n330\t\n331\t            let n = json_array_size(json);\n332\t\n333\t            if embed == 0 && dumpf(b\"[\\0\".as_ptr() as *const c_char, 1, data) != 0 {\n334\t                return -1;\n335\t            }\n336\t            if n == 0 {\n337\t                hashtable_del(parents, key.as_ptr(), key_len);\n338\t                return if embed != 0 {\n339\t                    0\n340\t                } else {\n341\t                    dumpf(b\"]\\0\".as_ptr() as *const c_char, 1, data)\n342\t                };\n343\t            }\n344\t            if dump_indent(flags, depth + 1, 0, dump, data) != 0 {\n345\t                return -1;\n346\t            }\n347\t\n348\t            let mut i: usize = 0;\n349\t            while i < n - 1 {\n350\t                if do_dump(\n351\t                    json_array_get(json, i),\n352\t                    flags,\n353\t                    depth + 1,\n354\t                    parents,\n355\t                    dump,\n356\t                    data,\n357\t                ) != 0\n358\t                {\n359\t                    return -1;\n360\t                }\n361\t\n362\t                if dumpf(b\",\\0\".as_ptr() as *const c_char, 1, data) != 0\n363\t                    || dump_indent(flags, depth + 1, 1, dump, data) != 0\n364\t                {\n365\t                    return -1;\n366\t                }\n367\t                i += 1;\n368\t            }\n369\t\n370\t            if do_dump(\n371\t                json_array_get(json, i),\n372\t                flags,\n373\t                depth + 1,\n374\t                parents,\n375\t                dump,\n376\t                data,\n377\t            ) != 0\n378\t            {\n379\t                return -1;\n380\t            }\n381\t            if dump_indent(flags, depth, 0, dump, data) != 0 {\n382\t                return -1;\n383\t            }\n384\t\n385\t            hashtable_del(parents, key.as_ptr(), key_len);\n386\t            if embed != 0 {\n387\t                0\n388\t            } else {\n389\t                dumpf(b\"]\\0\".as_ptr() as *const c_char, 1, data)\n390\t            }\n391\t        }\n392\t\n393\t        JSON_OBJECT => {\n394\t            let separator: *const c_char;\n395\t            let separator_length: usize;\n396\t            let mut loop_key = [0 as c_char; LOOP_KEY_LEN];\n397\t            let mut loop_key_len: usize = 0;\n398\t\n399\t            if (flags & JSON_COMPACT) != 0 {\n400\t                separator = b\":\\0\".as_ptr() as *const c_char;\n401\t                separator_length = 1;\n402\t            } else {\n403\t                separator = b\": \\0\".as_ptr() as *const c_char;\n404\t                separator_length = 2;\n405\t            }\n406\t\n407\t            /* detect circular references */\n408\t            if jsonp_loop_check(\n409\t                parents,\n410\t                json,\n411\t                loop_key.as_mut_ptr(),\n412\t                LOOP_KEY_LEN,\n413\t                &mut loop_key_len,\n414\t            ) != 0\n415\t   