    ) as *mut c_char;\n564\t        if !new_result.is_null() {\n565\t            // when realloc fails we just use the original pointer\n566\t            result = new_result;\n567\t        }\n568\t    }\n569\t\n570\t    strbuffer_close(&mut strbuff);\n571\t    result\n572\t}\n573\t\n574\t#[unsafe(no_mangle)]\n575\tpub unsafe extern \"C\" fn json_dumpb(\n576\t    json: *const json_t,\n577\t    buffer_: *mut c_char,\n578\t    size: usize,\n579\t    flags: usize,\n580\t) -> usize {\n581\t    let mut buf = buffer {\n582\t        size,\n583\t        used: 0,\n584\t        data: buffer_,\n585\t    };\n586\t\n587\t    if json_dump_callback(\n588\t        json,\n589\t        Some(dump_to_buffer),\n590\t        &mut buf as *mut buffer as *mut c_void,\n591\t        flags,\n592\t    ) != 0\n593\t    {\n594\t        return 0;\n595\t    }\n596\t\n597\t    buf.used\n598\t}\n599\t\n600\t#[unsafe(no_mangle)]\n601\tpub unsafe extern \"C\" fn json_dumpf(\n602\t    json: *const json_t,\n603\t    output: *mut FILE,\n604\t    flags: usize,\n605\t) -> c_int {\n606\t    json_dump_callback(json, Some(dump_to_file), output as *mut c_void, flags)\n607\t}\n608\t\n609\t#[unsafe(no_mangle)]\n610\tpub unsafe extern \"C\" fn json_dumpfd(json: *const json_t, output: c_int, flags: usize) -> c_int {\n611\t    let mut out = output;\n612\t    json_dump_callback(\n613\t        json,\n614\t        Some(dump_to_fd),\n615\t        &mut out as *mut c_int as *mut c_void,\n616\t        flags,\n617\t    )\n618\t}\n619\t\n620\t#[unsafe(no_mangle)]\n621\tpub unsafe extern \"C\" fn json_dump_file(\n622\t    json: *const json_t,\n623\t    path: *const c_char,\n624\t    flags: usize,\n625\t) -> c_int {\n626\t    let output = ffi::fopen(path, b\"w\\0\".as_ptr() as *const c_char);\n627\t    if output.is_null() {\n628\t        return -1;\n629\t    }\n630\t\n631\t    let result = json_dumpf(json, output, flags);\n632\t\n633\t    if ffi::fclose(output) != 0 {\n634\t        return -1;\n635\t    }\n636\t\n637\t    result