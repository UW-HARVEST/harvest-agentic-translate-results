{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012qBXgzhyK896KNYqqR4sqw","type":"tool_result","content":"2120\t}\n2121\t\n2122\t// ===========================================================================\n2123\t// Rows 154-157 — nesting depth\n2124\t// ===========================================================================\n2125\t\n2126\t/// The deep-nesting cases recurse `JSON_PARSER_MAX_DEPTH` frames inside both\n2127\t/// libraries, so they run on a thread with a generous stack.\n2128\tfn on_big_stack<F: FnOnce() + Send + 'static>(f: F) {\n2129\t    std::thread::Builder::new()\n2130\t        .stack_size(256 * 1024 * 1024)\n2131\t        .spawn(f)\n2132\t        .expect(\"spawn deep-nesting thread\")\n2133\t        .join()\n2134\t        .expect(\"deep-nesting thread panicked\");\n2135\t}\n2136\t\n2137\tfn nest_array(n: usize, inner: &[u8]) -> Vec<u8> {\n2138\t    let mut v = Vec::with_capacity(2 * n + inner.len());\n2139\t    for _ in 0..n {\n2140\t        v.push(b'[');\n2141\t    }\n2142\t    v.extend_from_slice(inner);\n2143\t    for _ in 0..n {\n2144\t        v.push(b']');\n2145\t    }\n2146\t    v\n2147\t}\n2148\t\n2149\tfn nest_object(n: usize, inner: &[u8]) -> Vec<u8> {\n2150\t    let mut v = Vec::new();\n2151\t    for _ in 0..n {\n2152\t        v.extend_from_slice(b\"{\\\"a\\\":\");\n2153\t    }\n2154\t    v.extend_from_slice(inner);\n2155\t    for _ in 0..n {\n2156\t        v.push(b'}');\n2157\t    }\n2158\t    v\n2159\t}\n2160\t\n2161\tfn nest_mixed(n: usize, inner: &[u8]) -> Vec<u8> {\n2162\t    let mut open = Vec::new();\n2163\t    let mut close = Vec::new();\n2164\t    for i in 0..n {\n2165\t        if i % 2 == 0 {\n2166\t            open.push(b'[');\n2167\t            close.insert(0, b']');\n2168\t        } else {\n2169\t            open.extend_from_slice(b\"{\\\"a\\\":\");\n2170\t            close.insert(0, b'}');\n2171\t        }\n2172\t    }\n2173\t    let mut v = open;\n2174\t    v.extend_from_slice(inner);\n2175\t    v.extend_from_slice(&close);\n2176\t    v\n2177\t}\n2178\t\n2179\t#[test]\n2180\tfn rows_154_157_nesting_depth() {\n2181\t    let _g = global_state_lock();\n2182\t    on_big_stack(|| {\n2183\t        let (c, r) = both();\n2184\t        unsafe {\n2185\t            // row 154: shallow depths all succeed.\n2186\t            let s = cmp_loads(c, r, b\"[1]\", 0, \"row 154 depth 1\");\n2187\t            assert!(!s.null);\n2188\t            let s = cmp_loads(c, r, b\"[[[[[1]]]]]\", 0, \"row 154 depth 5\");\n2189\t            assert!(!s.null);\n2190\t            for n in [1usize, 2, 3, 5, 10, 50, 100] {\n2191\t                for (name, doc) in [\n2192\t                    (\"array\", nest_array(n, b\"\")),\n2193\t                    (\"object\", nest_object(n, b\"1\")),\n2194\t                    (\"mixed\", nest_mixed(n, b\"1\")),\n2195\t                ] {\n2196\t                    let s = cmp_loads(c, r, &doc, 0, &format!(\"row 154 {name} depth {n}\"));\n2197\t                    assert!(!s.null, \"C: depth {n} {name} must parse\");\n2198\t                }\n2199\t            }\n2200\t\n2201\t            // row 155: exactly JSON_PARSER_MAX_DEPTH.\n2202\t            let doc = nest_array(JSON_PARSER_MAX_DEPTH, b\"\");\n2203\t            let s = cmp_loads(c, r, &doc, 0, \"row 155 exactly MAX_DEPTH\");\n2204\t            assert!(\n2205\t                !s.null,\n2206\t                \"C: {} nested arrays must parse (depth == MAX)\",\n2207\t                JSON_PARSER_MAX_DEPTH\n2208\t            );\n2209\t            let want: String = \"[\".repeat(JSON_PARSER_MAX_DEPTH)\n2210\t                + &\"]\".repeat(JSON_PARSER_MAX_DEPTH);\n2211\t            assert_eq!(\n2212\t                s.dump_str.as_deref(),\n2213\t                Some(want.as_str()),\n2214\t                \"C: innermost value must be an empty array\"\n2215\t            );\n2216\t\n2217\t            // row 156: one past the cap, for all three nesting shapes.\n2218\t            for (name, doc) in [\n2219\t                (\"array\", nest_array(JSON_PARSER_MAX_DEPTH + 1, b\"\")),\n2220\t                (\"object\", nest_object(JSON_PARSER_MAX_DEPTH + 1, b\"1\")),\n2221\t                (\"mixed\", nest_mixed(JSON_PARSER_MAX_DEPTH + 1, b\"1\")),\n2222\t            ] {\n2223\t                let s = cmp_loads(c, r, &doc, 0, &format!(\"row 156 {name} MAX+1\"));\n2224\t                assert!(s.null, \"C: {name} depth MAX+1 must fail\");\n2225\t                assert_eq!(s.code(), JSON_ERROR_STACK_OVERFLOW);\n2226\t                assert!(\n2227\t                    s.text().contains(\"maximum parsing depth reached\"),\n2228\t                    \"C: got {:?}\",\n2229\t                    s.text()\n2230\t                );\n2231\t            }\n2232\t            // Also the object/mixed exactly-at-cap variants must succeed.\n2233\t            for (name, doc) in [\n2234\t                (\"object\", nest_object(JSON_PARSER_MAX_DEPTH, b\"1\")),\n2235\t                (\"mixed\", nest_mixed(JSON_PARSER_MAX_DEPTH, b\"1\")),\n2236\t            ] {\n2237\t                // depth(inner scalar) = MAX + 1 -> must FAIL.\n2238\t                let s = cmp_loads(c, r, &doc, 0, &format!(\"row 157 {name} MAX brackets + scalar\"));\n2239\t                assert!(\n2240\t                    s.null,\n2241\t                    \"C: {name}: MAX containers plus a scalar is depth MAX+1\"\n2242\t                );\n2243\t                assert_eq!(s.code(), JSON_ERROR_STACK_OVERFLOW);\n2244\t            }\n2245\t\n2246\t            // row 157: the off-by-one on a bare scalar innermost value.\n2247\t            let doc = nest_array(JSON_PARSER_MAX_DEPTH, b\"1\");\n2248\t            let s = cmp_loads(c, r, &doc, JSON_DECODE_ANY, \"row 157 MAX brackets + scalar\");\n2249\t            assert!(s.null, \"C: MAX brackets + scalar == depth MAX+1 must fail\");\n2250\t            assert_eq!(s.code(), JSON_ERROR_STACK_OVERFLOW);\n2251\t\n2252\t            let doc = nest_array(JSON_PARSER_MAX_DEPTH - 1, b\"1\");\n2253\t            let s = cmp_loads(\n2254\t                c,\n2255\t                r,\n2256\t                &doc,\n2257\t                JSON_DECODE_ANY,\n2258\t                \"row 157 MAX-1 brackets + scalar\",\n2259\t            );\n2260\t            assert!(!s.null, \"C: MAX-1 brackets + scalar == depth MAX must parse\");\n2261\t\n2262\t            // A bare scalar with DECODE_ANY is depth 1.\n2263\t            let s = cmp_loads(c, r, b\"42\", JSON_DECODE_ANY, \"row 157 bare scalar depth 1\");\n2264\t            assert!(!s.null);\n2265\t\n2266\t            // Randomised depths straddling the cap.\n2267\t            let mut rng = Rng::new(0x0154_0157);\n2268\t            for i in 0..220 {\n2269\t                let n = match rng.below(4) {\n2270\t                    0 => 1 + rng.below(20),\n2271\t                    1 => JSON_PARSER_MAX_DEPTH - 3 + rng.below(7),\n2272\t                    2 => JSON_PARSER_MAX_DEPTH - 1 + rng.below(3),\n2273\t                    _ => 1 + rng.below(JSON_PARSER_MAX_DEPTH + 4),\n2274\t                };\n2275\t                let inner: &[u8] = if rng.bool() { b\"\" } else { b\"1\" };\n2276\t                let doc = match rng.below(3) {\n2277\t                    0 => nest_array(n, inner),\n2278\t                    1 => nest_object(n, if inner.is_empty() { b\"1\" } else { inner }),\n2279\t                    _ => nest_mixed(n, if inner.is_empty() { b\"1\" } else { inner }),\n2280\t                };\n2281\t                let f = if rng.bool() { 0 } else { JSON_DECODE_ANY };\n2282\t                cmp_loads(c, r, &doc, f, &format!(\"rows 154-157 random #{i} depth {n}\"));\n2283\t            }\n2284\t        }\n2285\t    });\n2286\t}\n2287\t\n2288\t// ===========================================================================\n2289\t// Rows 158-163 — parser and lexer error branches\n2290\t// ===========================================================================\n2291\t\n2292\t#[test]\n2293\tfn rows_158_163_error_branches() {\n2294\t    let _g = global_state_lock();\n2295\t    let (c, r) = both();\n2296\t    unsafe {\n2297\t        // row 158: parse_object error branches with their exact messages.\n2298\t        let cases: &[(&[u8], &str)] = &[\n2299\t            (b\"{1:2}\", \"string or '}' expected\"),\n2300\t            (b\"{,}\", \"string or '}' expected\"),\n2301\t            (b\"{true:1}\", \"string or '}' expected\"),\n2302\t            (b\"{\\\"a\\\" 1}\", \"':' expected\"),\n2303\t            (b\"{\\\"a\\\",1}\", \"':' expected\"),\n2304\t            (b\"{\\\"a\\\":1,}\", \"string or '}' expected\"),\n2305\t            (b\"{\\\"a\\\":1 \\\"b\\\":2}\", \"'}' expected\"),\n2306\t        ];\n2307\t        for (t, msg) in cases {\n2308\t            let s = cmp_loads(c, r, t, 0, \"row 158 parse_object\");\n2309\t            assert!(s.null, \"C: {:?} must fail\", show(t));\n2310\t            assert!(\n2311\t                s.text().contains(msg),\n2312\t                \"C: {:?} expected message {msg:?}, got {:?}\",\n2313\t                show(t),\n2314\t                s.text()\n2315\t            );\n2316\t        }\n2317\t        // `{\"a\":1` hits \"'}' expected\" and is remapped to premature end.\n2318\t        let s = cmp_loads(c, r, b\"{\\\"a\\\":1\", 0, \"row 158 EOF in object\");\n2319\t        assert!(s.null);"}]},"parent_tool_use_id":"toolu_bdrk_01RXgwoiuECjpqeirpk1kSob","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"a77e9a6d-a0ec-4ee5-bdd0-86df1631cd93","timestamp":"2026-08-31T04:26:47.871Z","subagent_type":"general-purpose","task_description":"Phase C error tests for load.c"}
