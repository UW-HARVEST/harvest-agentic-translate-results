below(14) {\n732\t            0 => 0.0,\n733\t            1 => -0.0,\n734\t            2 => 1.0,\n735\t            3 => -1.0,\n736\t            4 => 0.1,\n737\t            5 => 1.0 / 3.0,\n738\t            6 => f64::MIN_POSITIVE,\n739\t            7 => f64::MAX,\n740\t            8 => 5e-324,               // smallest subnormal\n741\t            9 => 1e308,\n742\t            10 => 1e-308,\n743\t            11 => 2.2250738585072011e-308, // the classic strtod bug value\n744\t            12 => (self.next_u32() as f64) / 7.0,\n745\t            _ => {\n746\t                // A random finite bit pattern — the widest possible coverage.\n747\t                loop {\n748\t                    let b = self.next_u64();\n749\t                    let d = f64::from_bits(b);\n750\t                    if d.is_finite() {\n751\t                        return d;\n752\t                    }\n753\t                }\n754\t            }\n755\t        }\n756\t    }\n757\t\n758\t    /// A random string biased towards bytes that the encoder/parser branch on.\n759\t    pub fn ascii_string(&mut self, maxlen: usize) -> String {\n760\t        const POOL: &[u8] = b\"abcXYZ019 _-.:/\\\\\\\"'\\t\\n\\r{}[],~`!@#$%^&*()+=|<>?;\";\n761\t        let n = self.below(maxlen + 1);\n762\t        (0..n).map(|_| *self.choice(POOL) as char).collect()\n763\t    }\n764\t\n765\t    /// A random *valid* UTF-8 string spanning 1-, 2-, 3- and 4-byte sequences\n766\t    /// plus the control characters the dumper has to escape.\n767\t    pub fn utf8_string(&mut self, maxlen: usize) -> String {\n768\t        let n = self.below(maxlen + 1);\n769\t        let mut s = String::new();\n770\t        for _ in 0..n {\n771\t            let c = match self.below(8) {\n772\t                0 => self.below(0x20) as u32,           // control chars\n773\t                1 | 2 => 0x20 + self.below(0x5f) as u32, // printable ASCII\n774\t                3 => 0x80 + self.below(0x780) as u32,   // 2-byte\n775\t                4 => 0x800 + self.below(0xf000) as u32, // 3-byte\n776\t                5 => 0x10000 + self.below(0xf_0000) as u32, // 4-byte\n777\t                6 => *self.choice(&[0x22u32, 0x5c, 0x2f, 0x08, 0x0c, 0x0a, 0x0d, 0x09]),\n778\t                _ => *self.choice(&[0x7f_u32, 0x80, 0x7ff, 0x800, 0xffff, 0x10000, 0x10ffff]),\n779\t            };\n780\t            if let Some(ch) = char::from_u32(c) {\n781\t                s.push(ch);\n782\t            }\n783\t        }\n784\t        s\n785\t    }\n786\t}\n787\t\n788\t// ---------------------------------------------------------------------------\n789\t// Assertion helper\n790\t// ---------------------------------------------------------------------------\n791\t\n792\t/// Assert two values match, printing the configuration that produced them.\n793\t#[macro_export]\n794\tmacro_rules! diff_eq {\n795\t    ($c:expr, $r:expr, $($ctx:tt)*) => {{\n796\t        let cv = $c;\n797\t        let rv = $r;\n798\t        if cv != rv {\n799\t            panic!(\n800\t                \"C/Rust divergence [{}]\\n  C    = {:?}\\n  Rust = {:?}\",\n801\t                format!($($ctx)*), cv, rv\n802\t            );\n803\t        }\n804\t    }};\n805\t}\n806\t"}]},"parent_tool_use_id":"toolu_bdrk_01VG6vBbkZAs1dk53yKz68VS","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"2e3cb2fe-64b1-49e9-a3ea-0ea756c869c2","timestamp":"2026-08-31T04:03:07.700Z","subagent_type":"general-purpose","task_description":"Phase B tests for pack_unpack.c"}
