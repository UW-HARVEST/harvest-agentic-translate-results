{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Dz7MqSUcMEpEaexRWUbnS1","type":"tool_result","content":"1\t//! Phase C — error-path differential tests for the low-level modules.\n2\t//!\n3\t//! Covers the ERRORS.md rows for strbuffer.c, memory.c, error.c, hashtable.c,\n4\t//! strconv.c and the exported dtoa.c entry points, PLUS the generic FFI\n5\t//! boundary conditions every C API has: NULL pointers, zero and oversized\n6\t//! lengths, values one step past a documented range, and out-of-range enum\n7\t//! values (a C enum accepts any int, so a value with no valid variant is a real\n8\t//! input both implementations must handle identically).\n9\t//!\n10\t//! The utf8_* rejection rows (ERRORS.md 126-144) are already proven\n11\t//! EXHAUSTIVELY in a01_utf.rs — every one of the 256 byte values, every\n12\t//! codepoint up to 0x110100, and every 2-byte sequence — so they are not\n13\t//! repeated here.\n14\t\n15\tmod common;\n16\tuse common::*;\n17\tuse std::ffi::{c_char, c_int, c_void};\n18\t\n19\textern \"C\" {\n20\t    fn __errno_location() -> *mut c_int;\n21\t}\n22\tunsafe fn errno_get() -> c_int {\n23\t    *__errno_location()\n24\t}\n25\tunsafe fn errno_set(v: c_int) {\n26\t    *__errno_location() = v;\n27\t}\n28\tconst ERANGE: c_int = 34;\n29\t\n30\t// ===========================================================================\n31\t// strbuffer.c overflow guards (ERRORS.md 288-294)\n32\t// ===========================================================================\n33\t\n34\t#[test]\n35\tfn strbuffer_append_bytes_size_overflow_guards() {\n36\t    let _g = global_state_lock();\n37\t    // The C guards are:\n38\t    //   size > SIZE_MAX - 1\n39\t    //   length > SIZE_MAX - 1 - size\n40\t    //   size > SIZE_MAX / 2   (doubling would overflow)\n41\t    // all of which must return -1 and leave the buffer untouched. These are\n42\t    // reachable with a huge `size` argument WITHOUT the data pointer ever being\n43\t    // read, because the guard runs before the memcpy.\n44\t    let (c, r) = both();\n45\t    unsafe {\n46\t        for &size in &[\n47\t            usize::MAX,\n48\t            usize::MAX - 1,\n49\t            usize::MAX / 2,\n50\t            usize::MAX / 2 + 1,\n51\t            usize::MAX - 16,\n52\t        ] {\n53\t            let mut csb = strbuffer_t::zeroed();\n54\t            let mut rsb = strbuffer_t::zeroed();\n55\t            assert_eq!((c.strbuffer_init)(&mut csb), 0);\n56\t            assert_eq!((r.strbuffer_init)(&mut rsb), 0);\n57\t\n58\t            let data = cs(\"x\");\n59\t            let cret = (c.strbuffer_append_bytes)(&mut csb, data.as_ptr(), size);\n60\t            let rret = (r.strbuffer_append_bytes)(&mut rsb, data.as_ptr(), size);\n61\t            diff_eq!(cret, rret, \"strbuffer_append_bytes(size={size:#x}) return\");\n62\t            assert_eq!(cret, -1, \"C: append of size {size:#x} must be rejected\");\n63\t            // The buffer must be completely unchanged by a rejected append.\n64\t            diff_eq!(\n65\t                (csb.length, csb.size, cbytes((c.strbuffer_value)(&csb))),\n66\t                (rsb.length, rsb.size, cbytes((r.strbuffer_value)(&rsb))),\n67\t                \"strbuffer state after rejected append(size={size:#x})\"\n68\t            );\n69\t\n70\t            (c.strbuffer_close)(&mut csb);\n71\t            (r.strbuffer_close)(&mut rsb);\n72\t        }\n73\t    }\n74\t}\n75\t\n76\t#[test]\n77\tfn strbuffer_append_bytes_length_plus_size_overflow() {\n78\t    let _g = global_state_lock();\n79\t    // `length > SIZE_MAX - 1 - size`: reach it by first growing `length` a\n80\t    // little, then asking for a size that makes the sum overflow.\n81\t    let (c, r) = both();\n82\t    unsafe {\n83\t        let mut csb = strbuffer_t::zeroed();\n84\t        let mut rsb = strbuffer_t::zeroed();\n85\t        (c.strbuffer_init)(&mut csb);\n86\t        (r.strbuffer_init)(&mut rsb);\n87\t        let filler = vec![b'a' as c_char; 100];\n88\t        (c.strbuffer_append_bytes)(&mut csb, filler.as_ptr(), 100);\n89\t        (r.strbuffer_append_bytes)(&mut rsb, filler.as_ptr(), 100);\n90\t\n91\t        let data = cs(\"x\");\n92\t        for &size in &[usize::MAX - 100, usize::MAX - 101, usize::MAX - 50] {\n93\t            let cret = (c.strbuffer_append_bytes)(&mut csb, data.as_ptr(), size);\n94\t            let rret = (r.strbuffer_append_bytes)(&mut rsb, data.as_ptr(), size);\n95\t            diff_eq!(cret, rret, \"length+size overflow at size={size:#x}\");\n96\t            diff_eq!(\n97\t                (csb.length, csb.size),\n98\t                (rsb.length, rsb.size),\n99\t                \"state after length+size overflow at size={size:#x}\"\n100\t            );\n101\t        }\n102\t        (c.strbuffer_close)(&mut csb);\n103\t        (r.strbuffer_close)(&mut rsb);\n104\t    }\n105\t}\n106\t\n107\t#[test]\n108\tfn strbuffer_value_after_steal_is_null() {\n109\t    let _g = global_state_lock();\n110\t    // ERRORS.md 294: strbuffer_value on a stolen (or failed-init) buffer.\n111\t    let (c, r) = both();\n112\t    unsafe {\n113\t        let mut csb = strbuffer_t::zeroed();\n114\t        let mut rsb = strbuffer_t::zeroed();\n115\t        (c.strbuffer_init)(&mut csb);\n116\t        (r.strbuffer_init)(&mut rsb);\n117\t        let cv = (c.strbuffer_steal_value)(&mut csb);\n118\t        let rv = (r.strbuffer_steal_value)(&mut rsb);\n119\t        diff_eq!(\n120\t            (c.strbuffer_value)(&csb).is_null(),\n121\t            (r.strbuffer_value)(&rsb).is_null(),\n122\t            \"strbuffer_value after steal must be NULL\"\n123\t        );\n124\t        jfree(c, cv as *mut c_void);\n125\t        jfree(r, rv as *mut c_void);\n126\t    }\n127\t}\n128\t\n129\t// ===========================================================================\n130\t// jsonp_strtod (ERRORS.md 312-313)\n131\t// ===========================================================================\n132\t\n133\t/// Build a strbuffer holding exactly `text` and call `jsonp_strtod`.\n134\tunsafe fn strtod_case(api: &Api, text: &str) -> (c_int, u64, c_int) {\n135\t    let mut sb = strbuffer_t::zeroed();\n136\t    assert_eq!((api.strbuffer_init)(&mut sb), 0);\n137\t    let b = text.as_bytes();\n138\t    assert_eq!(\n139\t        (api.strbuffer_append_bytes)(&mut sb, b.as_ptr() as *const c_char, b.len()),\n140\t        0\n141\t    );\n142\t    // Poison the out-param so \"not written\" is observable (the C leaves *out\n143\t    // untouched on the overflow path).\n144\t    let mut out: f64 = f64::from_bits(0x0BAD_0BAD_0BAD_0BAD);\n145\t    errno_set(0);\n146\t    let ret = (api.jsonp_strtod)(&mut sb, &mut out);\n147\t    let e = errno_get();\n148\t    (api.strbuffer_close)(&mut sb);\n149\t    (ret, out.to_bits(), e)\n150\t}\n151\t\n152\t#[test]\n153\tfn jsonp_strtod_overflow_returns_minus_one_and_leaves_out_untouched() {\n154\t    let _g = global_state_lock();\n155\t    // ERRORS.md 312: (value == ±HUGE_VAL) && errno == ERANGE => -1, *out\n156\t    // untouched. The \"untouched\" part is the interesting half.\n157\t    let (c, r) = both();\n158\t    unsafe {\n159\t        for t in [\n160\t            \"1e999\", \"-1e999\", \"1e400\", \"-1e400\", \"1e308000\", \"2e308\",\n161\t            \"\",\n162\t        ] {\n163\t            let (cret, cbits, ce) = strtod_case(c, t);\n164\t            let (rret, rbits, re) = strtod_case(r, t);\n165\t            diff_eq!(cret, rret, \"jsonp_strtod({t:?}) return\");\n166\t            diff_eq!(cbits, rbits, \"jsonp_strtod({t:?}) *out bits\");\n167\t            diff_eq!(ce == ERANGE, re == ERANGE, \"jsonp_strtod({t:?}) errno==ERANGE\");\n168\t            assert_eq!(cret, -1, \"C: {t:?} must report overflow\");\n169\t            assert_eq!(\n170\t                cbits, 0x0BAD_0BAD_0BAD_0BAD,\n171\t                \"C: *out must be left untouched on overflow for {t:?}\"\n172\t            );\n173\t        }\n174\t    }\n175\t}\n176\t\n177\t#[test]\n178\tfn jsonp_strtod_underflow_is_not_an_error() {\n179\t    let _g = global_state_lock();\n180\t    // ERRORS.md 313: underflow sets ERANGE but the value is ~0, so the\n181\t    // `value == ±HUGE_VAL` test fails and the C returns SUCCESS with *out = 0.\n182\t    // A port that keyed off errno alone would wrongly return -1 here.\n183\t    let (c, r) = both();\n184\t    unsafe {\n185\t        for t in [\"1e-999\", \"-1e-999\", \"1e-400\", \"-1e-400\", \"1e-320\", \"4e-324\", \"1e-1000\"] {\n186\t            let (cret, cbits, _) = strtod_case(c, t);\n187\t            let (rret, rbits, _) = strtod_case(r, t);\n188\t            diff_eq!(cret, rret, \"jsonp_strtod({t:?}) return\");\n189\t            diff_eq!(cbits, rbits, \"jsonp_strtod({t:?}) *out bits\");\n190\t            assert_eq!(cret, 0, \"C: underflow of {t:?} must NOT be an error\");\n191\t        }\n192\t    }\n193\t}\n194\t\n195\t// ===========================================================================\n196\t// jsonp_dtostr failures (ERRORS.md 315-317)\n197\t// ===========================================================================\n198\t\n199\t#[test]\n200\tfn jsonp_dtostr_returns_minus_one_when_buffer_too_small() {\n201\t    let _g = global_state_lock();\n202\t    // ERRORS.md 315/316/317. The exact values in the table were observed\n203\t    // against the real C library, so they are asserted explicitly as well as\n204\t    // compared.\n205\t    let (c, r) = both();\n206\t    unsafe {\n207\t        let cases: &[(usize, f64, c_int)] = &[\n208\t            (25, 0.1, 22),\n209\t            (25, 0.1, 23),\n210\t            (25, 0.1, 24),\n211\t            (25, 0.1, 25),\n212\t            (25, 0.1, 26),\n213\t            (25, 0.1, 31),\n214\t            (25, 1e300, 21),\n215\t            (25, 1e-300, 21),\n216\t            (1, 1.0, 0),\n217\t            (0, 1.0, 0),\n218\t            (2, 1.0, 0),\n219\t            (3, 1.0, 0),\n220\t            (4, 1.0, 0),\n221\t        ];\n222\t        for &(size, value, prec) in cases {\n223\t            let mut cbuf = [0xAAu8; 64];\n224\t            let mut rbuf = [0xAAu8; 64];\n225\t            let cret = (c.jsonp_dtostr)(cbuf.as_mut_ptr() as *mut c_char, size, value, prec);\n226\t            let rret = (r.jsonp_dtostr)(rbuf.as_mut_ptr() as *mut c_char, size, value, prec);\n227\t            diff_eq!(\n228\t                cret,\n229\t                rret,\n230\t                \"jsonp_dtostr(size={size}, value={value:e}, prec={prec}) return\"\n231\t            );\n232\t            diff_eq!(\n233\t                cbuf,\n234\t                rbuf,\n235\t                \"jsonp_dtostr(size={size}, value={value:e}, prec={prec}) buffer\"\n236\t            );\n237\t        }\n238\t    }\n239\t}\n240\t\n241\t// ===========================================================================\n242\t// dtoa_r short-buffer failures (ERRORS.md 318-322)\n243\t// ===========================================================================\n244\t\n245\t#[test]\n246\tfn dtoa_r_short_buffer_returns_null() {\n247\t    let _g = global_state_lock();\n248\t    // ERRORS.md 318-321: each special class of value has a minimum blen; below\n249\t    // it dtoa_r returns NULL but still writes *decpt / *sign.\n250\t    let (c, r) = both();\n251\t    unsafe {\n252\t        let cases: &[(f64, c_int, c_int, usize, &str)] = &[\n253\t            (0.1, 0, 0, 4, \"normal, mode 0, blen 4\"),\n254\t            (0.1, 2, 25, 25, \"normal, mode 2 ndigits 25, blen 25\"),\n255\t            (0.0, 0, 0, 1, \"+0.0 with blen 1\"),\n256\t            (-0.0, 0, 0, 1, \"-0.0 with blen 1\"),\n257\t            (0.0, 0, 0, 0, \"+0.0 with blen 0\"),\n258\t            (f64::NAN, 0, 0, 3, \"NaN with blen 3\"),\n259\t            (f64::NAN, 0, 0, 0, \"NaN with blen 0\"),\n260\t            (f64::INFINITY, 0, 0, 8, \"+inf with blen 8\"),\n261\t            (f64::NEG_INFINITY, 0, 0, 8, \"-inf with blen 8\"),\n262\t            (f64::INFINITY, 0, 0, 0, \"+inf with blen 0\"),\n263\t        ];\n264\t        for &(v, mode, ndigits, blen, label) in cases {\n265\t            let mut cbuf = [0xAAu8; 64];\n266\t            let mut rbuf = [0xAAu8; 64];\n267\t            let (mut cd, mut cs2) = (-12345, -12345);\n268\t            let (mut rd, mut rs2) = (-12345, -12345);\n269\t            let mut crve: *mut c_char = std::ptr::null_mut();\n270\t            let mut rrve: *mut c_char = std::ptr::null_mut();\n271\t            let cp = (c.dtoa_r)(\n272\t                v, mode, ndigits, &mut cd, &mut cs2, &mut crve,\n273\t                cbuf.as_mut_ptr() as *mut c_char, blen,\n274\t            );\n275\t            let rp = (r.dtoa_r)(\n276\t                v, mode, ndigits, &mut rd, &mut rs2, &mut rrve,\n277\t                rbuf.as_mut_ptr() as *mut c_char, blen,\n278\t            );\n279\t            diff_eq!(cp.is_null(), rp.is_null(), \"dtoa_r null-ness [{label}]\");\n280\t            // *decpt and *sign are written even on the NULL path.\n281\t            diff_eq!(cd, rd, \"dtoa_r *decpt [{label}]\");\n282\t            diff_eq!(cs2, rs2, \"dtoa_r *sign [{label}]\");\n283\t            diff_eq!(cbuf, rbuf, \"dtoa_r buffer [{label}]\");\n284\t        }\n285\t    }\n286\t}\n287\t\n288\t#[test]\n289\tfn dtoa_r_out_of_range_mode_is_clamped_not_an_error() {\n290\t    let _g = global_state_lock();\n291\t    // ERRORS.md 322: mode < 0 or > 9 is NOT an error — it is silently folded.\n292\t    // This is exactly the out-of-range-enum class of input that happy-path\n293\t    // tests miss.\n294\t    let (c, r) = both();\n295\t    unsafe {\n296\t        for mode in [-5, -1, 10, 99, 1000, i32::MIN + 1, i32::MAX] {\n297\t            for &v in &[1.5f64, 0.0, -0.0, 0.1, 1e308, 5e-324, f64::MAX] {\n298\t                let mut cbuf = [0xAAu8; 64];\n299\t                let mut rbuf = [0xAAu8; 64];\n300\t                let (mut cd, mut cs2) = (-12345, -12345);\n301\t                let (mut rd, mut rs2) = (-12345, -12345);\n302\t                let mut crve: *mut c_char = std::ptr::null_mut();\n303\t                let mut rrve: *mut c_char = std::ptr::null_mut();\n304\t                let cp = (c.dtoa_r)(\n305\t                    v, mode, 0, &mut cd, &mut cs2, &mut crve,\n306\t                    cbuf.as_mut_ptr() as *mut c_char, 40,\n307\t                );\n308\t                let rp = (r.dtoa_r)(\n309\t                    v, mode, 0, &mut rd, &mut rs2, &mut rrve,\n310\t                    rbuf.as_mut_ptr() as *mut c_char, 40,\n311\t                );\n312\t                let ctx = format!(\"mode={mode} value={v:e}\");\n313\t                diff_eq!(cbytes(cp), cbytes(rp), \"dtoa_r digits [{ctx}]\");\n314\t                diff_eq!(cd, rd, \"dtoa_r *decpt [{ctx}]\");\n315\t                diff_eq!(cs2, rs2, \"dtoa_r *sign [{ctx}]\");\n316\t                diff_eq!(cbuf, rbuf, \"dtoa_r buffer [{ctx}]\");\n317\t            }\n318\t        }\n319\t    }\n320\t}\n321\t\n322\t// ===========================================================================\n323\t// gethex overflow / underflow / no-digit paths (ERRORS.md 326-334)\n324\t// ===========================================================================\n325\t\n326\t/// gethex writes through `rvp`, advances `*sp`, and sets `errno` on the\n327\t/// overflow/underflow paths. All four observables are compared.\n328\tunsafe fn gethex_case(\n329\t    api: &Api,\n330\t    text: &str,\n331\t    rounding: c_int,\n332\t    sign: c_int,\n333\t) -> (u64, usize, c_int) {\n334\t    let s = cs(text);\n335\t    let mut p: *const c_char = s.as_ptr();\n336\t    let mut u: f64 = f64::from_bits(0x0BAD_0BAD_0BAD_0BAD);\n337\t    errno_set(0);\n338\t    (api.gethex)(&mut p, &mut u as *mut f64 as *mut c_void, rounding, sign);\n339\t    let e = errno_get();\n340\t    (u.to_bits(), p as usize - s.as_ptr() as usize, e)\n341\t}\n342\t\n343\t#[test]\n344\tfn gethex_overflow_underflow_and_no_digit_paths() {\n345\t    let _g = global_state_lock();\n346\t    // Rows 326-334. Every input keeps the mandatory 2-char \"0x\" prefix that\n347\t    // gethex assumes (it does `s0 = *sp + 2` with no length check).\n348\t    let (c, r) = both();\n349\t    let cases: &[(&str, &str)] = &[\n350\t        (\"0x1p+99999\", \"row 326: e > emax -> +inf, ERANGE\"),\n351\t        (\"0x1p+999999999999\", \"row 327: exponent digits overflow, positive\"),\n352\t        (\"0x1p-999999999999\", \"row 329: big && esign -> 0.0, ERANGE\"),\n353\t        (\"0x1p-99999\", \"row 330: e < emin -> retz, ERANGE\"),\n354\t        (\"0x1p-1075\", \"row 331: underflow to smallest denormal / zero\"),\n355\t        (\"0x1p-1074\", \"smallest denormal, no error\"),\n356\t        (\"0x1p-1073\", \"just above the smallest denormal\"),\n357\t        (\"0x0\", \"row 332: zret, no significant digits, errno untouched\"),\n358\t        (\"0x.0\", \"row 332: zret via fraction\"),\n359\t        (\"0x0.0\", \"row 332: zret both sides\"),\n360\t        (\"0x0p0\", \"zret with an exponent\"),\n361\t        (\"0xg\", \"row 333: no hex digit at all -> *sp rewound\"),\n362\t        (\"0x\", \"row 333: nothing after the prefix\"),\n363\t        (\"0x.\", \"row 333: only a decimal point\"),\n364\t        (\"0xz1\", \"row 333: invalid first digit\"),\n365\t        (\"0x1.fffffffffffff8p1023\", \"row 334: rounding carry pushes e past Emax\"),\n366\t        (\"0x1.fffffffffffffp1023\", \"largest finite double\"),\n367\t        (\"0x2p1023\", \"row 326: just past the top\"),\n368\t        (\"0x1p1024\", \"row 326: one binade too big\"),\n369\t        (\"0x1p1023\", \"largest power of two\"),\n370\t    ];\n371\t    unsafe {\n372\t        for &(text, label) in cases {\n373\t            for rounding in 0..=3 {\n374\t                for sign in [0, 1] {\n375\t                    let (cbits, cadv, ce) = gethex_case(c, text, rounding, sign);\n376\t                    let (rbits, radv, re) = gethex_case(r, text, rounding, sign);\n377\t                    let ctx =\n378\t                        format!(\"{label} :: gethex({text:?}, rounding={rounding}, sign={sign})\");\n379\t                    diff_eq!(cbits, rbits, \"{ctx} value bits\");\n380\t                    diff_eq!(cadv, radv, \"{ctx} advance\");\n381\t                    // errno is process-global and shared by both .so files, so\n382\t                    // comparing it directly is meaningful.\n383\t                    diff_eq!(ce, re, \"{ctx} errno\");\n384\t                }\n385\t            }\n386\t        }\n387\t    }\n388\t}\n389\t\n390\t// ===========================================================================\n391\t// memory.c error paths (ERRORS.md 303-310)\n392\t// ===========================================================================\n393\t\n394\t/// A malloc hook that always fails, to drive the OOM branches that are\n395\t/// otherwise unreachable. Installed per-library so each side fails identically.\n396\tunsafe extern \"C\" fn always_fail_malloc(_n: size_t) -> *mut c_void {\n397\t    std::ptr::null_mut()\n398\t}\n399\tunsafe extern \"C\" fn noop_free(_p: *mut c_void) {}\n400\tunsafe extern \"C\" fn always_fail_realloc(_p: *mut c_void, _n: size_t) -> *mut c_void {\n401\t    std::ptr::null_mut()\n402\t}\n403\t\n404\t#[test]\n405\tfn oom_paths_via_failing_allocator() {\n406\t    let _g = global_state_lock();\n407\t    // Installing a failing allocator makes the OOM rows in ERRORS.md\n408\t    // (json_object 101/102, json_array 103/104, json_integer 90, json_real 95,\n409\t    // json_stringn_nocheck 72/73, strbuffer_init 288, hashtable_init 295,\n410\t    // jsonp_strndup 308, json_loads/json_dumps OOM) actually reachable rather\n411\t    // than merely documented.\n412\t    let (c, r) = both();\n413\t    unsafe {\n414\t        // Save the defaults so the rest of the suite is unaffected.\n415\t        let (mut cm, mut crl, mut cf) = (None, None, None);\n416\t        let (mut rm, mut rrl, mut rf) = (None, None, None);\n417\t        (c.json_get_alloc_funcs2)(&mut cm, &mut crl, &mut cf);\n418\t        (r.json_get_alloc_funcs2)(&mut rm, &mut rrl, &mut rf);\n419\t\n420\t        (c.json_set_alloc_funcs2)(\n421\t            Some(always_fail_malloc),\n422\t            Some(always_fail_realloc),\n423\t            Some(noop_free),\n424\t        );\n425\t        (r.json_set_alloc_funcs2)(\n426\t            Some(always_fail_malloc),\n427\t            Some(always_fail_realloc),\n428\t            Some(noop_free),\n429\t        );\n430\t\n431\t        // --- constructors must all return NULL, not crash\n432\t        diff_eq!((c.json_object)().is_null(), (r.json_object)().is_null(), \"json_object OOM\");\n433\t        diff_eq!((c.json_array)().is_null(), (r.json_array)().is_null(), \"json_array OOM\");\n434\t        diff_eq!(\n435\t            (c.json_integer)(42).is_null(),\n436\t            (r.json_integer)(42).is_null(),\n437\t            \"json_integer OOM\"\n438\t        );\n439\t        diff_eq!((c.json_real)(1.5).is_null(), (r.json_real)(1.5).is_null(), \"json_real OOM\");\n440\t        let s = cs(\"hello\");\n441\t        diff_eq!(\n442\t            (c.json_string)(s.as_ptr()).is_null(),\n443\t            (r.json_string)(s.as_ptr()).is_null(),\n444\t            \"json_string OOM\"\n445\t        );\n446\t        diff_eq!(\n447\t            (c.json_stringn)(s.as_ptr(), 5).is_null(),\n448\t            (r.json_stringn)(s.as_ptr(), 5).is_null(),\n449\t            \"json_stringn OOM\"\n450\t        );\n451\t        diff_eq!(\n452\t            (c.json_string_nocheck)(s.as_ptr()).is_null(),\n453\t            (r.json_string_nocheck)(s.as_ptr()).is_null(),\n454\t            \"json_string_nocheck OOM\"\n455\t        );\n456\t        diff_eq!(\n457\t            (c.json_stringn_nocheck)(s.as_ptr(), 5).is_null(),\n458\t            (r.json_stringn_nocheck)(s.as_ptr(), 5).is_null(),\n459\t            \"json_stringn_nocheck OOM\"\n460\t        );\n461\t\n462\t        // Singletons are static and must still work under OOM.\n463\t        diff_eq!((c.json_true)().is_null(), (r.json_true)().is_null(), \"json_true under OOM\");\n464\t        diff_eq!(\n465\t            (c.json_false)().is_null(),\n466\t            (r.json_false)().is_null(),\n467\t            \"json_false under OOM\"\n468\t        );\n469\t        diff_eq!((c.json_null)().is_null(), (r.json_null)().is_null(), \"json_null under OOM\");\n470\t\n471\t        // --- jsonp_* wrappers\n472\t        diff_eq!(\n473\t            (c.jsonp_malloc)(16).is_null(),\n474\t            (r.jsonp_malloc)(16).is_null(),\n475\t            \"jsonp_malloc OOM\"\n476\t        );\n477\t        diff_eq!(\n478\t            (c.jsonp_strndup)(s.as_ptr(), 5).is_null(),\n479\t            (r.jsonp_strndup)(s.as_ptr(), 5).is_null(),\n480\t            \"jsonp_strndup OOM (row 308)\"\n481\t        );\n482\t\n483\t        // --- strbuffer_init OOM (row 288): -1 and value left NULL\n484\t        let mut csb = strbuffer_t::zeroed();\n485\t        let mut rsb = strbuffer_t::zeroed();\n486\t        let cret = (c.strbuffer_init)(&mut csb);\n487\t        let rret = (r.strbuffer_init)(&mut rsb);\n488\t        diff_eq!(cret, rret, \"strbuffer_init OOM return (row 288)\");\n489\t        diff_eq!(\n490\t            csb.value.is_null(),\n491\t            rsb.value.is_null(),\n492\t            \"strbuffer_init OOM leaves value NULL\"\n493\t        );\n494\t        assert_eq!(cret, -1, \"C: strbuffer_init must fail under OOM\");\n495\t\n496\t        // --- hashtable_init OOM (row 295)\n497\t        let mut cht = hashtable_t::zeroed();\n498\t        let mut rht = hashtable_t::zeroed();\n499\t        let cret = (c.hashtable_init)(&mut cht);\n500\t        let rret = (r.hashtable_init)(&mut rht);\n501\t        diff_eq!(cret, rret, \"hashtable_init OOM return (row 295)\");\n502\t        assert_eq!(cret, -1, \"C: hashtable_init must fail under OOM\");\n503\t\n504\t        // --- parse and dump under OOM\n505\t        let input = cs(r#\"{\"a\":[1,2,3]}\"#);\n506\t        let mut ce = json_error_t::new();\n507\t        let mut re = json_error_t::new();\n508\t        let cj = (c.json_loads)(input.as_ptr(), 0, &mut ce);\n509\t        let rj = (r.json_loads)(input.as_ptr(), 0, &mut re);\n510\t        diff_eq!(cj.is_null(), rj.is_null(), \"json_loads under OOM\");\n511\t        // Note: ERRORS.md row 197 records that the lex_init OOM path leaves the\n512\t        // error struct only partially initialised, so `text` is compared but the\n513\t        // code byte is not asserted to a specific value — only that both agree.\n514\t        diff_eq!(ce.text_str(), re.text_str(), \"json_loads OOM error text\");\n515\t\n516\t        // --- pack under OOM\n517\t        let fmt = cs(\"{s:i}\");\n518\t        let key = cs(\"k\");\n519\t        let mut ce2 = json_error_t::new();\n520\t        let mut re2 = json_error_t::new();\n521\t        let cp = (c.json_pack_ex)(&mut ce2, 0, fmt.as_ptr(), key.as_ptr(), 1 as c_int);\n522\t        let rp = (r.json_pack_ex)(&mut re2, 0, fmt.as_ptr(), key.as_ptr(), 1 as c_int);\n523\t        diff_eq!(cp.is_null(), rp.is_null(), \"json_pack_ex under OOM\");\n524\t        diff_eq!(ce2.raw(), re2.raw(), \"json_pack_ex OOM error image\");\n525\t\n526\t        // --- json_sprintf OOM (row 89)\n527\t        let sf = cs(\"%d\");\n528\t        diff_eq!(\n529\t            (c.json_sprintf)(sf.as_ptr(), 5 as c_int).is_null(),\n530\t            (r.json_sprintf)(sf.as_ptr(), 5 as c_int).is_null(),\n531\t            \"json_sprintf under OOM (row 89)\"\n532\t        );\n533\t\n534\t        // --- restore the real allocators\n535\t        (c.json_set_alloc_funcs2)(cm, crl, cf);\n536\t        (r.json_set_alloc_funcs2)(rm, rrl, rf);\n537\t\n538\t        // Sanity: allocation works again, so later tests are unaffected.\n539\t        let o = (c.json_object)();\n540\t        assert!(!o.is_null(), \"C allocator not restored\");\n541\t        decref(c, o);\n542\t        let o = (r.json_object)();\n543\t        assert!(!o.is_null(), \"Rust allocator not restored\");\n544\t        decref(r, o);\n545\t    }\n546\t}\n547\t\n548\t#[test]\n549\tfn oom_during_container_growth() {\n550\t    let _g = global_state_lock();\n551\t    // Rows 12, 58, 296: a container that already exists, whose GROWTH then\n552\t    // fails. Build first with the real allocator, then switch to the failing\n553\t    // one so only the growth allocation fails.\n554\t    let (c, r) = both();\n555\t    unsafe {\n556\t        let (mut cm, mut crl, mut cf) = (None, None, None);\n557\t        let (mut rm, mut rrl, mut rf) = (None, None, None);\n558\t        (c.json_get_alloc_funcs2)(&mut cm, &mut crl, &mut cf);\n559\t        (r.json_get_alloc_funcs2)(&mut rm, &mut rrl, &mut rf);\n560\t\n561\t        let carr = (c.json_array)();\n562\t        let rarr = (r.json_array)();\n563\t        let cobj = (c.json_object)();\n564\t        let robj = (r.json_object)();\n565\t        // Fill both to just under the growth thresholds (array capacity 8,\n566\t        // hashtable 8 buckets) using pre-made values.\n567\t        let mut cvals = Vec::new();\n568\t        let mut rvals = Vec::new();\n569\t        for i in 0..8 {\n570\t            cvals.push((c.json_integer)(i));\n571\t            rvals.push((r.json_integer)(i));\n572\t        }\n573\t        for i in 0..8 {\n574\t            (c.json_array_append_new)(carr, cvals[i]);\n575\t            (r.json_array_append_new)(rarr, rvals[i]);\n576\t        }\n577\t        // Pre-make the values that the failing append/set will consume, so the\n578\t        // failure is in the GROWTH, not in creating the value.\n579\t        let cextra = (c.json_integer)(999);\n580\t        let rextra = (r.json_integer)(999);\n581\t        let cextra2 = (c.json_integer)(888);\n582\t        let rextra2 = (r.json_integer)(888);\n583\t        for i in 0..8 {\n584\t            let k = format!(\"k{i}\");\n585\t            let kc = cs(&k);\n586\t            (c.json_object_set_new)(cobj, kc.as_ptr(), (c.json_integer)(i));\n587\t            (r.json_object_set_new)(robj, kc.as_ptr(), (r.json_integer)(i));\n588\t        }\n589\t\n590\t        (c.json_set_alloc_funcs2)(\n591\t            Some(always_fail_malloc),\n592\t            Some(always_fail_realloc),\n593\t            Some(noop_free),\n594\t        );\n595\t        (r.json_set_alloc_funcs2)(\n596\t            Some(always_fail_malloc),\n597\t            Some(always_fail_realloc),\n598\t            Some(noop_free),\n599\t        );\n600\t\n601\t        // Row 58: json_array_grow fails => -1 and the value is decref'd.\n602\t        diff_eq!(\n603\t            (c.json_array_append_new)(carr, cextra),\n604\t            (r.json_array_append_new)(rarr, rextra),\n605\t            \"json_array_append_new with failing grow (row 58)\"\n606\t        );\n607\t        diff_eq!(\n608\t            (c.json_array_size)(carr),\n609\t            (r.json_array_size)(rarr),\n610\t            \"array size after failed grow\"\n611\t        );\n612\t\n613\t        // Rows 12/296: hashtable rehash fails => -1 and the value is decref'd.\n614\t        let k9 = cs(\"k8\");\n615\t        diff_eq!(\n616\t            (c.json_object_set_new)(cobj, k9.as_ptr(), cextra2),\n617\t            (r.json_object_set_new)(robj, k9.as_ptr(), rextra2),\n618\t            \"json_object_set_new with failing rehash (rows 12/296)\"\n619\t        );\n620\t        diff_eq!(\n621\t            (c.json_object_size)(cobj),\n622\t            (r.json_object_size)(robj),\n623\t            \"object size after failed rehash\"\n624\t        );\n625\t\n626\t        (c.json_set_alloc_funcs2)(cm, crl, cf);\n627\t        (r.json_set_alloc_funcs2)(rm, rrl, rf);\n628\t\n629\t        decref(c, carr);\n630\t        decref(r, rarr);\n631\t        decref(c, cobj);\n632\t        decref(r, robj);\n633\t    }\n634\t}\n635\t\n636\t#[test]\n637\tfn get_alloc_funcs_with_null_out_params() {\n638\t    let _g = global_state_lock();\n639\t    // Rows 309/310: every combination of NULL out-params must be tolerated and\n640\t    // must leave the omitted slots untouched.\n641\t    let (c, r) = both();\n642\t    unsafe {\n643\t        // All 4 combinations for the 2-arg getter.\n644\t        for &(want_m, want_f) in &[(false, false), (true, false), (false, true), (true, true)] {\n645\t            let mut cm: json_malloc_t = None;\n646\t            let mut cf: json_free_t = None;\n647\t            let mut rm: json_malloc_t = None;\n648\t            let mut rf: json_free_t = None;\n649\t            (c.json_get_alloc_funcs)(\n650\t                if want_m { &mut cm } else { std::ptr::null_mut() },\n651\t                if want_f { &mut cf } else { std::ptr::null_mut() },\n652\t            );\n653\t            (r.json_get_alloc_funcs)(\n654\t                if want_m { &mut rm } else { std::ptr::null_mut() },\n655\t                if want_f { &mut rf } else { std::ptr::null_mut() },\n656\t            );\n657\t            diff_eq!(\n658\t                (cm.is_some(), cf.is_some()),\n659\t                (rm.is_some(), rf.is_some()),\n660\t                \"get_alloc_funcs(m={want_m}, f={want_f}) which slots were written\"\n661\t            );\n662\t        }\n663\t        // All 8 combinations for the 3-arg getter.\n664\t        for mask in 0..8u32 {\n665\t            let (wm, wr, wf) = (mask & 1 != 0, mask & 2 != 0, mask & 4 != 0);\n666\t            let mut cm: json_malloc_t = None;\n667\t            let mut crl: json_realloc_t = None;\n668\t            let mut cf: json_free_t = None;\n669\t            let mut rm: json_malloc_t = None;\n670\t            let mut rrl: json_realloc_t = None;\n671\t            let mut rf: json_free_t = None;\n672\t            (c.json_get_alloc_funcs2)(\n673\t                if wm { &mut cm } else { std::ptr::null_mut() },\n674\t                if wr { &mut crl } else { std::ptr::null_mut() },\n675\t                if wf { &mut cf } else { std::ptr::null_mut() },\n676\t            );\n677\t            (r.json_get_alloc_funcs2)(\n678\t                if wm { &mut rm } else { std::ptr::null_mut() },\n679\t                if wr { &mut rrl } else { std::ptr::null_mut() },\n680\t                if wf { &mut rf } else { std::ptr::null_mut() },\n681\t            );\n682\t            diff_eq!(\n683\t                (cm.is_some(), crl.is_some(), cf.is_some()),\n684\t                (rm.is_some(), rrl.is_some(), rf.is_some()),\n685\t                \"get_alloc_funcs2(mask={mask:03b}) which slots were written\"\n686\t            );\n687\t        }\n688\t    }\n689\t}\n690\t\n691\t// ===========================================================================\n692\t// hashtable.c rejections (ERRORS.md 299-302)\n693\t// ===========================================================================\n694\t\n695\t#[test]\n696\tfn hashtable_lookup_rejections() {\n697\t    let _g = global_state_lock();\n698\t    let (c, r) = both();\n699\t    unsafe {\n700\t        let mut cht = Box::new(hashtable_t::zeroed());\n701\t        let mut rht = Box::new(hashtable_t::zeroed());\n702\t        assert_eq!((c.hashtable_init)(&mut *cht), 0);\n703\t        assert_eq!((r.hashtable_init)(&mut *rht), 0);\n704\t\n705\t        // Row 301: iter on an empty ordered list is NULL.\n706\t        diff_eq!(\n707\t            (c.hashtable_iter)(&mut *cht).is_null(),\n708\t            (r.hashtable_iter)(&mut *rht).is_null(),\n709\t            \"hashtable_iter on empty table (row 301)\"\n710\t        );\n711\t\n712\t        // Rows 299/300/302 on an empty table and on a populated one.\n713\t        for key in [&b\"\"[..], b\"missing\", b\"\\0\", b\"a\\0b\"] {\n714\t            diff_eq!(\n715\t                (c.hashtable_get)(&mut *cht, key.as_ptr() as *const c_char, key.len()).is_null(),\n716\t                (r.hashtable_get)(&mut *rht, key.as_ptr() as *const c_char, key.len()).is_null(),\n717\t                \"hashtable_get({key:?}) missing (row 299)\"\n718\t            );\n719\t            diff_eq!(\n720\t                (c.hashtable_del)(&mut *cht, key.as_ptr() as *const c_char, key.len()),\n721\t                (r.hashtable_del)(&mut *rht, key.as_ptr() as *const c_char, key.len()),\n722\t                \"hashtable_del({key:?}) missing (row 300)\"\n723\t            );\n724\t            diff_eq!(\n725\t                (c.hashtable_iter_at)(&mut *cht, key.as_ptr() as *const c_char, key.len())\n726\t                    .is_null(),\n727\t                (r.hashtable_iter_at)(&mut *rht, key.as_ptr() as *const c_char, key.len())\n728\t                    .is_null(),\n729\t                \"hashtable_iter_at({key:?}) missing (row 302)\"\n730\t            );\n731\t        }\n732\t\n733\t        // Row 301 second half: iter_next at the last pair returns NULL.\n734\t        let k = cs(\"only\");\n735\t        (c.hashtable_set)(&mut *cht, k.as_ptr(), 4, (c.json_integer)(1));\n736\t        (r.hashtable_set)(&mut *rht, k.as_ptr(), 4, (r.json_integer)(1));\n737\t        let cit = (c.hashtable_iter)(&mut *cht);\n738\t        let rit = (r.hashtable_iter)(&mut *rht);\n739\t        diff_eq!(cit.is_null(), rit.is_null(), \"iter on 1-element table\");\n740\t        diff_eq!(\n741\t            (c.hashtable_iter_next)(&mut *cht, cit).is_null(),\n742\t            (r.hashtable_iter_next)(&mut *rht, rit).is_null(),\n743\t            \"iter_next past the last pair (row 301)\"\n744\t        );\n745\t\n746\t        (c.hashtable_close)(&mut *cht);\n747\t        (r.hashtable_close)(&mut *rht);\n748\t    }\n749\t}\n750\t\n751\t// ===========================================================================\n752\t// error.c rejections (ERRORS.md 281-287)\n753\t// ===========================================================================\n754\t\n755\t#[test]\n756\tfn error_api_null_and_truncation_rejections() {\n757\t    let _g = global_state_lock();\n758\t    let (c, r) = both();\n759\t    unsafe {\n760\t        // Row 281 / 283 / 285: NULL error pointer is a no-op everywhere.\n761\t        (c.jsonp_error_init)(std::ptr::null_mut(), cs(\"s\").as_ptr());\n762\t        (r.jsonp_error_init)(std::ptr::null_mut(), cs(\"s\").as_ptr());\n763\t        (c.jsonp_error_set_source)(std::ptr::null_mut(), cs(\"s\").as_ptr());\n764\t        (r.jsonp_error_set_source)(std::ptr::null_mut(), cs(\"s\").as_ptr());\n765\t        (c.jsonp_error_set)(std::ptr::null_mut(), 1, 1, 1, 0, cs(\"m\").as_ptr());\n766\t        (r.jsonp_error_set)(std::ptr::null_mut(), 1, 1, 1, 0, cs(\"m\").as_ptr());\n767\t\n768\t        // Row 282: NULL source => source[0] = '\\0'\n769\t        let mut ce = json_error_t::poisoned();\n770\t        let mut re = json_error_t::poisoned();\n771\t        (c.jsonp_error_init)(&mut ce, std::ptr::null());\n772\t        (r.jsonp_error_init)(&mut re, std::ptr::null());\n773\t        diff_eq!(ce.raw(), re.raw(), \"jsonp_error_init(NULL source) (row 282)\");\n774\t        assert_eq!(ce.source[0], 0, \"C: NULL source must give an empty source string\");\n775\t\n776\t        // Row 283: NULL source to set_source is a no-op (struct untouched).\n777\t        let mut ce = json_error_t::poisoned();\n778\t        let mut re = json_error_t::poisoned();\n779\t        let before = ce.raw();\n780\t        (c.jsonp_error_set_source)(&mut ce, std::ptr::null());\n781\t        (r.jsonp_error_set_source)(&mut re, std::ptr::null());\n782\t        diff_eq!(ce.raw(), re.raw(), \"set_source(NULL) (row 283)\");\n783\t        assert_eq!(ce.raw(), before, \"C: set_source(NULL) must not write\");\n784\t\n785\t        // Row 284: source >= 80 chars is truncated with a \"...\" prefix.\n786\t        for len in [79usize, 80, 81, 100, 199, 500] {\n787\t            let src: String = \"x\".repeat(len);\n788\t            let cstr = cs(&src);\n789\t            let mut ce = json_error_t::poisoned();\n790\t            let mut re = json_error_t::poisoned();\n791\t            (c.jsonp_error_set_source)(&mut ce, cstr.as_ptr());\n792\t            (r.jsonp_error_set_source)(&mut re, cstr.as_ptr());\n793\t            diff_eq!(\n794\t                ce.source.iter().map(|&x| x as u8).collect::<Vec<u8>>(),\n795\t                re.source.iter().map(|&x| x as u8).collect::<Vec<u8>>(),\n796\t                \"set_source truncation at len={len} (row 284)\"\n797\t            );\n798\t            if len >= JSON_ERROR_SOURCE_LENGTH {\n799\t                assert_eq!(\n800\t                    &ce.source[..3].iter().map(|&x| x as u8).collect::<Vec<u8>>(),\n801\t                    b\"...\",\n802\t                    \"C: long source must be prefixed with '...' (len={len})\"\n803\t                );\n804\t            }\n805\t        }\n806\t\n807\t        // Row 286: the FIRST error wins; a second set is silently dropped.\n808\t        let mut ce = json_error_t::new();\n809\t        let mut re = json_error_t::new();\n810\t        (c.jsonp_error_init)(&mut ce, cs(\"src\").as_ptr());\n811\t        (r.jsonp_error_init)(&mut re, cs(\"src\").as_ptr());\n812\t        (c.jsonp_error_set)(&mut ce, 1, 2, 3, JSON_ERROR_WRONG_TYPE, cs(\"first\").as_ptr());\n813\t        (r.jsonp_error_set)(&mut re, 1, 2, 3, JSON_ERROR_WRONG_TYPE, cs(\"first\").as_ptr());\n814\t        for i in 0..5 {\n815\t            (c.jsonp_error_set)(&mut ce, 9, 9, 9, JSON_ERROR_INVALID_SYNTAX, cs(\"later\").as_ptr());\n816\t            (r.jsonp_error_set)(&mut re, 9, 9, 9, JSON_ERROR_INVALID_SYNTAX, cs(\"later\").as_ptr());\n817\t            diff_eq!(ce.raw(), re.raw(), \"sticky error after overwrite #{i} (row 286)\");\n818\t        }\n819\t        assert_eq!(ce.text_str(), \"first\", \"C: the first error must survive\");\n820\t        assert_eq!(ce.code(), JSON_ERROR_WRONG_TYPE, \"C: the first code must survive\");\n821\t\n822\t        // Row 287: message longer than TEXT_LENGTH-2 is truncated, and the code\n823\t        // byte at text[159] is preserved.\n824\t        for len in [157usize, 158, 159, 160, 399, 1000] {\n825\t            let msg: String = \"y\".repeat(len);\n826\t            let m = cs(&msg);\n827\t            let mut ce = json_error_t::new();\n828\t            let mut re = json_error_t::new();\n829\t            (c.jsonp_error_init)(&mut ce, std::ptr::null());\n830\t            (r.jsonp_error_init)(&mut re, std::ptr::null());\n831\t            (c.jsonp_error_set)(&mut ce, 1, 1, 1, JSON_ERROR_INVALID_UTF8, cs(\"%s\").as_ptr(), m.as_ptr());\n832\t            (r.jsonp_error_set)(&mut re, 1, 1, 1, JSON_ERROR_INVALID_UTF8, cs(\"%s\").as_ptr(), m.as_ptr());\n833\t            diff_eq!(ce.raw(), re.raw(), \"long message truncation len={len} (row 287)\");\n834\t            assert_eq!(\n835\t                ce.code(),\n836\t                JSON_ERROR_INVALID_UTF8,\n837\t                \"C: the code byte must survive truncation (len={len})\"\n838\t            );\n839\t        }\n840\t    }\n841\t}\n842\t\n843\t#[test]\n844\tfn error_code_out_of_range_enum_values() {\n845\t    let _g = global_state_lock();\n846\t    // `enum json_error_code` is stored in a single char (text[159]). A C enum\n847\t    // accepts ANY int, so values with no valid variant — including values that\n848\t    // do not fit in a char — are real inputs across the FFI boundary and both\n849\t    // implementations must mangle them identically.\n850\t    let (c, r) = both();\n851\t    unsafe {\n852\t        for code in [\n853\t            -1i32, -128, -129, 0, 17, 18, 19, 127, 128, 200, 255, 256, 257, 1000, 65535,\n854\t            65536, i32::MAX, i32::MIN + 1,\n855\t        ] {\n856\t            let mut ce = json_error_t::new();\n857\t            let mut re = json_error_t::new();\n858\t            (c.jsonp_error_init)(&mut ce, std::ptr::null());\n859\t            (r.jsonp_error_init)(&mut re, std::ptr::null());\n860\t            (c.jsonp_error_set)(&mut ce, 0, 0, 0, code, cs(\"x\").as_ptr());\n861\t            (r.jsonp_error_set)(&mut re, 0, 0, 0, code, cs(\"x\").as_ptr());\n862\t            diff_eq!(ce.raw(), re.raw(), \"out-of-range error code {code}\");\n863\t            diff_eq!(ce.code(), re.code(), \"out-of-range error code {code} read back\");\n864\t        }\n865\t    }\n866\t}\n867\t\n868\t// ===========================================================================\n869\t// version.c (ERRORS.md 338)\n870\t// ===========================================================================\n871\t\n872\t#[test]\n873\tfn jansson_version_cmp_exhaustive_small_range() {\n874\t    let _g = global_state_lock();\n875\t    // Not an error path as such, but the full comparison surface: each\n876\t    // component above, equal to and below the built-in version, and the\n877\t    // extreme int values a caller can pass.\n878\t    let (c, r) = both();\n879\t    unsafe {\n880\t        for ma in [-1, 0, 1, 2, 3, 100, i32::MIN + 1, i32::MAX] {\n881\t            for mi in [-1, 0, 14, 15, 16, 100] {\n882\t                for mu in [-1, 0, 1, 2, 100] {\n883\t                    diff_eq!(\n884\t                        (c.jansson_version_cmp)(ma, mi, mu),\n885\t                        (r.jansson_version_cmp)(ma, mi, mu),\n886\t                        \"jansson_version_cmp({ma},{mi},{mu})\"\n887\t                    );\n888\t                }\n889\t            }\n890\t        }\n891\t        diff_eq!(\n892\t            cbytes((c.jansson_version_str)()),\n893\t            cbytes((r.jansson_version_str)()),\n894\t            \"jansson_version_str\"\n895\t        );\n896\t    }\n897\t}\n898\t"}]},"parent_tool_use_id":"toolu_bdrk_01GnKT4a7Vpx2yRpQPbdMyaQ","session_id":"e1728859-25d0-4463-adf4-96231e8435a5","uuid":"70db85fc-b82c-448d-ba3b-5ace162ad1ac","timestamp":"2026-08-31T04:44:32.889Z","subagent_type":"general-purpose","task_description":"Phase C error tests for value.c"}
