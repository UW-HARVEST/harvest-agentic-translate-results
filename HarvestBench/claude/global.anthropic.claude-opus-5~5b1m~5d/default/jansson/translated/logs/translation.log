xtern \"C\" fn json_set_alloc_funcs2(\n    malloc_fn: json_malloc_t,\n    realloc_fn: json_realloc_t,\n    free_fn: json_free_t,\n) {\n    DO_MALLOC = malloc_fn;\n    DO_REALLOC = realloc_fn;\n    DO_FREE = free_fn;\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn json_get_alloc_funcs(\n    malloc_fn: *mut json_malloc_t,\n    free_fn: *mut json_free_t,\n) {\n    if !malloc_fn.is_null() {\n        *malloc_fn = DO_MALLOC;\n    }\n    if !free_fn.is_null() {\n        *free_fn = DO_FREE;\n    }\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn json_get_alloc_funcs2(\n    malloc_fn: *mut json_malloc_t,\n    realloc_fn: *mut json_realloc_t,\n    free_fn: *mut json_free_t,\n) {\n    if !malloc_fn.is_null() {\n        *malloc_fn = DO_MALLOC;\n    }\n    if !realloc_fn.is_null() {\n        *realloc_fn = DO_REALLOC;\n    }\n    if !free_fn.is_null() {\n        *free_fn = DO_FREE;\n    }\n}\n","structuredPatch":[{"oldStart":5,"oldLines":22,"newStart":5,"newLines":13,"lines":[" use crate::ffi;"," use crate::jansson::{json_free_t, json_malloc_t, json_realloc_t};"," ","-static mut DO_MALLOC: json_malloc_t = Some(rust_malloc);","-static mut DO_REALLOC: json_realloc_t = Some(rust_realloc);","-static mut DO_FREE: json_free_t = Some(rust_free);","+/* Default to the libc allocator, exactly like the C sources do. The function","+   pointers must compare equal to `malloc`/`realloc`/`free` so that","+   json_get_alloc_funcs() reports the same values as the C library. */","+static mut DO_MALLOC: json_malloc_t = Some(ffi::malloc);","+static mut DO_REALLOC: json_realloc_t = Some(ffi::realloc);","+static mut DO_FREE: json_free_t = Some(ffi::free);"," ","-unsafe extern \"C\" fn rust_malloc(size: usize) -> *mut c_void {","-    ffi::malloc(size)","-}","-","-unsafe extern \"C\" fn rust_realloc(ptr: *mut c_void, size: usize) -> *mut c_void {","-    ffi::realloc(ptr, size)","-}","-","-unsafe extern \"C\" fn rust_free(ptr: *mut c_void) {","-    ffi::free(ptr)","-}","-"," #[unsafe(no_mang