{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LAjFGFUHmCpJpnMd3wFSxN","type":"tool_result","content":"1\t//! Phase B (valid paths) and Phase C (error paths) differential tests driven by\n2\t//! line-oriented JS corpora in `tests/corpus/`.\n3\t//!\n4\t//! Each snippet is compiled and run through BOTH `.so`s via `js_ploadstring` +\n5\t//! `js_pcall`, and the full outcome (load rc, call rc, `js_type`, `js_typeof`,\n6\t//! stack depth, and the stringified result-or-error) is compared byte for byte.\n7\t//! Because the error value is stringified, the exact error *class and message*\n8\t//! must match, not merely \"both failed\".\n9\tmod common;\n10\tuse common::*;\n11\tuse std::ffi::c_int;\n12\t\n13\t/// Parse a corpus file: one snippet per line; `#`-prefixed lines and blank\n14\t/// lines are comments. `\\n` inside a line becomes a real newline so multi-line\n15\t/// snippets are expressible.\n16\tfn corpus(text: &str) -> Vec<String> {\n17\t    text.lines()\n18\t        .map(|l| l.trim_end())\n19\t        .filter(|l| !l.is_empty() && !l.trim_start().starts_with('#'))\n20\t        .map(|l| l.replace(\"\\\\n\", \"\\n\").replace(\"\\\\t\", \"\\t\"))\n21\t        .collect()\n22\t}\n23\t\n24\tfn run_corpus(name: &str, text: &str, min_expected: usize) {\n25\t    let snippets = corpus(text);\n26\t    assert!(\n27\t        snippets.len() >= min_expected,\n28\t        \"corpus {name} looks truncated: {} snippets (expected >= {min_expected})\",\n29\t        snippets.len()\n30\t    );\n31\t    let mut b = Batch::new();\n32\t    for flags in [0 as c_int, JS_STRICT] {\n33\t        for s in &snippets {\n34\t            b.script(flags, s);\n35\t        }\n36\t    }\n37\t    b.finish(&format!(\"corpus {name} ({} snippets x 2 modes)\", snippets.len()));\n38\t}\n39\t\n40\t// ---------------------------------------------------------------------------\n41\t// Phase B: valid paths\n42\t// ---------------------------------------------------------------------------\n43\t\n44\t#[test]\n45\tfn corpus_language() {\n46\t    run_corpus(\"language\", include_str!(\"corpus/language.txt\"), 150);\n47\t}\n48\t\n49\t#[test]\n50\tfn corpus_builtins_object_function() {\n51\t    run_corpus(\n52\t        \"builtins_object_function\",\n53\t        include_str!(\"corpus/builtins_object_function.txt\"),\n54\t        100,\n55\t    );\n56\t}\n57\t\n58\t#[test]\n59\tfn corpus_builtins_array() {\n60\t    run_corpus(\"builtins_array\", include_str!(\"corpus/builtins_array.txt\"), 100);\n61\t}\n62\t\n63\t#[test]\n64\tfn corpus_builtins_string() {\n65\t    run_corpus(\"builtins_string\", include_str!(\"corpus/builtins_string.txt\"), 100);\n66\t}\n67\t\n68\t#[test]\n69\tfn corpus_builtins_number_math() {\n70\t    run_corpus(\n71\t        \"builtins_number_math\",\n72\t        include_str!(\"corpus/builtins_number_math.txt\"),\n73\t        100,\n74\t    );\n75\t}\n76\t\n77\t#[test]\n78\tfn corpus_builtins_regexp() {\n79\t    run_corpus(\"builtins_regexp\", include_str!(\"corpus/builtins_regexp.txt\"), 80);\n80\t}\n81\t\n82\t#[test]\n83\tfn corpus_builtins_json() {\n84\t    run_corpus(\"builtins_json\", include_str!(\"corpus/builtins_json.txt\"), 60);\n85\t}\n86\t\n87\t#[test]\n88\tfn corpus_builtins_date() {\n89\t    run_corpus(\"builtins_date\", include_str!(\"corpus/builtins_date.txt\"), 80);\n90\t}\n91\t\n92\t#[test]\n93\tfn corpus_strict_mode() {\n94\t    // CONFIGS section B: every distinct strict-mode-dependent branch. Each\n95\t    // snippet is run in BOTH modes, so the mode-dependent difference itself is\n96\t    // part of what gets compared.\n97\t    run_corpus(\"strict_mode\", include_str!(\"corpus/strict_mode.txt\"), 50);\n98\t}\n99\t\n100\t// ---------------------------------------------------------------------------\n101\t// Phase C: error paths\n102\t// ---------------------------------------------------------------------------\n103\t\n104\t#[test]\n105\tfn corpus_errors_lexer() {\n106\t    run_corpus(\"errors_lexer\", include_str!(\"corpus/errors_lexer.txt\"), 40);\n107\t}\n108\t\n109\t#[test]\n110\tfn corpus_errors_parser_compiler() {\n111\t    run_corpus(\n112\t        \"errors_parser_compiler\",\n113\t        include_str!(\"corpus/errors_parser_compiler.txt\"),\n114\t        50,\n115\t    );\n116\t}\n117\t\n118\t#[test]\n119\tfn corpus_errors_runtime() {\n120\t    run_corpus(\"errors_runtime\", include_str!(\"corpus/errors_runtime.txt\"), 60);\n121\t}\n122\t\n123\t#[test]\n124\tfn corpus_errors_builtins() {\n125\t    run_corpus(\"errors_builtins\", include_str!(\"corpus/errors_builtins.txt\"), 80);\n126\t}\n127\t\n128\t/// Every error snippet must ACTUALLY produce an error in the C build (otherwise\n129\t/// the row is not really testing an error path). This guards the corpora against\n130\t/// bit-rot / wrong expectations.\n131\t#[test]\n132\tfn error_corpora_actually_error_in_c() {\n133\t    let c = Impl::c();\n134\t    let mut not_erroring = Vec::new();\n135\t    let mut total = 0;\n136\t    for (name, text) in [\n137\t        (\"errors_lexer\", include_str!(\"corpus/errors_lexer.txt\")),\n138\t        (\"errors_parser_compiler\", include_str!(\"corpus/errors_parser_compiler.txt\")),\n139\t        (\"errors_runtime\", include_str!(\"corpus/errors_runtime.txt\")),\n140\t        (\"errors_builtins\", include_str!(\"corpus/errors_builtins.txt\")),\n141\t    ] {\n142\t        for s in corpus(text) {\n143\t            total += 1;\n144\t            // An error snippet must fail in at least one of the two modes.\n145\t            let a = c.eval_script(0, s.as_bytes());\n146\t            let b = c.eval_script(JS_STRICT, s.as_bytes());\n147\t            let errored = a.load_rc != 0 || a.call_rc != 0 || b.load_rc != 0 || b.call_rc != 0;\n148\t            if !errored {\n149\t                not_erroring.push(format!(\"  [{name}] {s:?} -> {}\", a.pretty()));\n150\t            }\n151\t        }\n152\t    }\n153\t    assert!(total > 200, \"error corpora look too small: {total} snippets\");\n154\t    assert!(\n155\t        not_erroring.is_empty(),\n156\t        \"{} of {total} \\\"error\\\" snippets do not error in the C build \\\n157\t         (fix the corpus, not the Rust):\\n{}\",\n158\t        not_erroring.len(),\n159\t        not_erroring.join(\"\\n\")\n160\t    );\n161\t    eprintln!(\"all {total} error snippets genuinely error in the C build\");\n162\t}\n163\t\n164\t"}]},"parent_tool_use_id":"toolu_bdrk_01FGCuobWRGCNdPH3UTL2gkS","session_id":"365846c7-7961-47ff-8218-f2422469d650","uuid":"078ff2f6-ba3f-442a-9898-425f9f70dc3a","timestamp":"2026-08-31T07:05:29.259Z","subagent_type":"general-purpose","task_description":"Write error-path JS corpora"}
