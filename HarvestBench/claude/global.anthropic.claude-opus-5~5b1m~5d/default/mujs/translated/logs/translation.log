n424\t            ndigits -= 1;\n425\t            *p = *s;\n426\t            p = p.add(1);\n427\t            s = s.add(1);\n428\t            point -= 1;\n429\t            if point == 0 && ndigits > 0 {\n430\t                *p = '.' as c_char;\n431\t                p = p.add(1);\n432\t            }\n433\t        }\n434\t        while point > 0 {\n435\t            point -= 1;\n436\t            *p = '0' as c_char;\n437\t            p = p.add(1);\n438\t        }\n439\t        *p = 0;\n440\t    }\n441\t\n442\t    buf\n443\t}\n444\t\n445\t/* ToString() on a value */\n446\t#[unsafe(no_mangle)]\n447\tpub unsafe extern \"C\" fn jsV_tostring(J: *mut js_State, v: *mut js_Value) -> *const c_char {\n448\t    let mut buf: [c_char; 32] = [0; 32];\n449\t    match vtype(v) {\n450\t        JS_TUNDEFINED => cs!(\"undefined\"),\n451\t        JS_TNULL => cs!(\"null\"),\n452\t        JS_TBOOLEAN => {\n453\t            if (*v).u.boolean != 0 {\n454\t                cs!(\"true\")\n455\t            } else {\n456\t                cs!(\"false\")\n457\t            }\n458\t        }\n459\t        JS_TLITSTR => (*v).u.litstr,\n460\t        JS_TMEMSTR => strp((*v).u.memstr),\n461\t        JS_TNUMBER => {\n462\t            let mut p = jsV_numbertostring(J, buf.as_mut_ptr(), (*v).u.number);\n463\t            if p == buf.as_ptr() as *const c_char {\n464\t                let mut n = strlen(p) as c_int;\n465\t                if n <= OFF_VALUE_TYPE {\n466\t                    let mut s = shrstrp(v);\n467\t                    while n != 0 {\n468\t                        n -= 1;\n469\t                        *s = *p;\n470\t                        s = s.add(1);\n471\t                        p = p.add(1);\n472\t                    }\n473\t                    *s = 0;\n474\t                    setvtype(v, JS_TSHRSTR);\n475\t                    return shrstrp(v);\n476\t                } else {\n477\t                    (*v).u.memstr = jsV_newmemstring(J, p, n);\n478\t                    setvtype(v, JS_TMEMST