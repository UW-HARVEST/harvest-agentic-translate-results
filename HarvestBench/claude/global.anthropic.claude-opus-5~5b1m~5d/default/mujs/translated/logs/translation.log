fn tan(x: f64) -> f64;\n91\t    pub fn asin(x: f64) -> f64;\n92\t    pub fn acos(x: f64) -> f64;\n93\t    pub fn atan(x: f64) -> f64;\n94\t    pub fn atan2(y: f64, x: f64) -> f64;\n95\t    pub fn fabs(x: f64) -> f64;\n96\t}\n97\t\n98\t#[inline]\n99\tpub fn isnan(x: f64) -> bool {\n100\t    x.is_nan()\n101\t}\n102\t#[inline]\n103\tpub fn isinf(x: f64) -> bool {\n104\t    x.is_infinite()\n105\t}\n106\t#[inline]\n107\tpub fn isfinite(x: f64) -> bool {\n108\t    x.is_finite()\n109\t}\n110\t#[inline]\n111\tpub fn signbit(x: f64) -> bool {\n112\t    x.is_sign_negative()\n113\t}\n114\t\n115\tpub const INFINITY: f64 = f64::INFINITY;\n116\tpub const NAN: f64 = f64::NAN;\n117\tpub const INT_MAX: c_int = c_int::MAX;\n118\tpub const INT_MIN: c_int = c_int::MIN;\n119\tpub const DBL_MAX: f64 = f64::MAX;\n120\tpub const DBL_MIN: f64 = f64::MIN_POSITIVE;\n121\tpub const DBL_EPSILON: f64 = f64::EPSILON;\n122\t\n123\t/// `cs!(\"text\")` yields a NUL terminated `*const c_char` pointing to static memory.\n124\t#[macro_export]\n125\tmacro_rules! cs {\n126\t    ($s:expr) => {\n127\t        concat!($s, \"\\0\").as_ptr() as *const $crate::jsi::c_char\n128\t    };\n129\t}\n130\t\n131\t/* ------------------------------------------------------------- limits ---- */\n132\t\n133\tpub const JS_STACKSIZE: c_int = 4096;\n134\tpub const JS_ENVLIMIT: usize = 1024;\n135\tpub const JS_TRYLIMIT: c_int = 64;\n136\tpub const JS_ARRAYLIMIT: c_int = 1 << 26;\n137\tpub const JS_GCFACTOR: f64 = 5.0;\n138\tpub const JS_ASTLIMIT: c_int = 400;\n139\tpub const JS_STRLIMIT: usize = 1 << 28;\n140\t\n141\tpub const JS_VERSION_MAJOR: c_int = 1;\n142\tpub const JS_VERSION_MINOR: c_int = 3;\n143\tpub const JS_VERSION_PATCH: c_int = 8;\n144\t\n145\t/* state constructor flags */\n146\tpub const JS_STRICT: c_int = 1;\n147\t/* regexp flags */\n148\tpub const JS_REGEXP_G: c_int = 1;\n149\tpub const JS_REGEXP_I: c_int = 2;\n150\tpub const JS_REGEXP_M: c_int = 4;\n151\t/* property attributes */\n152\tpub const JS_READONLY: c