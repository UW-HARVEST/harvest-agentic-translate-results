\n212\t#[derive(Clone, Copy)]\n213\tpub struct Resub {\n214\t    pub nsub: c_int,\n215\t    pub sub: [Resub_pair; REG_MAXSUB],\n216\t}\n217\t\n218\tconst _: () = assert!(core::mem::size_of::<Resub>() == 264);\n219\t\n220\t/* -------------------------------------------------------- public types ---- */\n221\t\n222\tpub type js_Alloc = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void, c_int) -> *mut c_void>;\n223\tpub type js_Panic = Option<unsafe extern \"C\" fn(*mut js_State)>;\n224\tpub type js_CFunction = Option<unsafe extern \"C\" fn(*mut js_State)>;\n225\tpub type js_Finalize = Option<unsafe extern \"C\" fn(*mut js_State, *mut c_void)>;\n226\tpub type js_HasProperty =\n227\t    Option<unsafe extern \"C\" fn(*mut js_State, *mut c_void, *const c_char) -> c_int>;\n228\tpub type js_Put = Option<unsafe extern \"C\" fn(*mut js_State, *mut c_void, *const c_char) -> c_int>;\n229\tpub type js_Delete =\n230\t    Option<unsafe extern \"C\" fn(*mut js_State, *mut c_void, *const c_char) -> c_int>;\n231\tpub type js_Report = Option<unsafe extern \"C\" fn(*mut js_State, *const c_char)>;\n232\t\n233\tpub type js_Instruction = c_ushort;\n234\tpub type Rune = c_int;\n235\t\n236\t/* ------------------------------------------------------------- values ---- */\n237\t\n238\t#[repr(C)]\n239\t#[derive(Clone, Copy)]\n240\tpub struct js_Value_t {\n241\t    pub pad: [c_char; 15],\n242\t    pub type_: c_char,\n243\t}\n244\t\n245\t#[repr(C)]\n246\t#[derive(Clone, Copy)]\n247\tpub union js_Value_u {\n248\t    pub shrstr: [c_char; 16],\n249\t    pub boolean: c_int,\n250\t    pub number: f64,\n251\t    pub litstr: *const c_char,\n252\t    pub memstr: *mut js_String,\n253\t    pub object: *mut js_Object,\n254\t}\n255\t\n256\t#[repr(C)]\n257\t#[derive(Clone, Copy)]\n258\tpub union js_Value {\n259\t    pub t: js_Value_t,\n260\t    pub u: js_Value_u,\n261\t}\n262\t\n263\timpl js_Value {\n264\t    pub const fn zero() -> js_Value {\n265\t        js_Value {\n266\t            u: js_Value_u { shrstr: [0; 16] },\n267\t        }\n268\t    }\n269\t    pub const fn undefined() -> js_Value {\n270\t        js_Value {\n271\t            t: js_Value_t {\n272\t                pad: [0; 15],\n273\t                type_: JS_TUNDEFINED as c_char,\n274\t            },\n275\t        }\n276\t    }\n277\t}\n278\t\n279\t#[repr(C)]\n280\tpub struct js_String {\n281\t    pub gcnext: *mut js_String,\n282\t    pub gcmark: c_char,\n283\t    pub p: [c_char; 1],\n284\t}\n285\t\n286\t#[repr(C)]\n287\t#[derive(Clone, Copy)]\n288\tpub struct js_Regexp {\n289\t    pub prog: *mut c_void,\n290\t    pub source: *mut c_char,\n291\t    pub flags: c_ushort,\n292\t    pub last: c_ushort,\n293\t}\n294\t\n295\t#[repr(C)]\n296\t#[derive(Clone, Copy)]\n297\tpub struct js_Object_s {\n298\t    pub length: c_int,\n299\t    pub string: *mut c_char,\n300\t    pub shrstr: [c_char; 16],\n301\t}\n302\t\n303\t#[repr(C)]\n304\t#[derive(Clone, Copy)]\n305\tpub struct js_Object_a {\n306\t    pub length: c_int,\n307\t    pub simple: c_int,\n308\t    pub flat_length: c_int,\n309\t    pub flat_capacity: c_int,\n310\t    pub array: *mut js_Value,\n311\t}\n312\t\n313\t#[repr(C)]\n314\t#[derive(Clone, Copy)]\n315\tpub struct js_Object_f {\n316\t    pub function: *mut js_Function,\n317\t    pub scope: *mut js_Environment,\n318\t}\n319\t\n320\t#[repr(C)]\n321\t#[derive(Clone, Copy)]\n322\tpub struct js_Object_c {\n323\t    pub name: *const c_char,\n324\t    pub function: js_CFunction,\n325\t    pub constructor: js_CFunction,\n326\t    pub length: c_int,\n327\t    pub data: *mut c_void,\n328\t    pub finalize: js_Finalize,\n329\t}\n330\t\n331\t#[repr(C)]\n332\t#[derive(Clone, Copy)]\n333\tpub struct js_Object_iter {\n334\t    pub target: *mut js_Object,\n335\t    pub i: c_int,\n336\t    pub n: c_int,\n337\t    pub head: *mut js_Iterator,\n338\t    pub current: *mut js_Iterator,\n339\t}\n340\t\n341\t#[repr(C)]\n342\t#[derive(Clone, Copy)]\n343\tpub struct js_Object_user {\n344\t    pub tag: *const c_char,\n345\t    pub data: *mut c_void,\n346\t    pub has: js_HasProperty,\n347\t    pub put: js_Put,\n348\t    pub delete: js_Delete,\n349\t    pub finalize: js_Finalize,\n350\t}\n351\t\n352\t#[repr(C)]\n353\t#[derive(Clone, Copy)]\n354\tpub union js_Object_u {\n355\t    pub boolean: c_int,\n356\t    pub number: f64,\n357\t    pub s: js_Object_s,\n358\t    pub a: js_Object_a,\n359\t    pub f: js_Object_f,\n360\t    pub c: js_Object_c,\n361\t    pub r: js_Regexp,\n362\t    pub iter: js_Object_iter,\n363\t    pub user: js_Object_user,\n364\t}\n365\t\n366\t#[repr(C)]\n367\tpub struct js_Object {\n368\t    pub type_: c_int,\n369\t    pub extensible: c_int,\n370\t    pub properties: *mut js_Property,\n371\t    pub count: c_int,\n372\t    pub prototype: *mut js_Object,\n373\t    pub u: js_Object_u,\n374\t    pub gcnext: *mut js_Object,\n375\t    pub gcroot: *mut js_Object,\n376\t    pub gcmark: c_int,\n377\t}\n378\t\n379\t#[repr(C)]\n380\tpub struct js_Property {\n381\t    pub left: *mut js_Property,\n382\t    pub right: *mut js_Property,\n383\t    pub level: c_int,\n384\t    pub atts: c_int,\n385\t    pub value: js_Value,\n386\t    pub getter: *mut js_Object,\n387\t    pub setter: *mut js_Object,\n388\t    pub name: [c_char; 1],\n389\t}\n390\t\n391\t#[repr(C)]\n392\tpub struct js_Iterator {\n393\t    pub next: *mut js_Iterator,\n394\t    pub name: [c_char; 1],\n395\t}\n396\t\n397\t#[repr(C)]\n398\tpub struct js_Environment {\n399\t    pub outer: *mut js_Environment,\n400\t    pub variables: *mut js_Object,\n401\t    pub gcnext: *mut js_Environment,\n402\t    pub gcmark: c_int,\n403\t}\n404\t\n405\t#[repr(C)]\n406\t#[derive(Clone, Copy)]\n407\tpub struct js_StackTrace {\n408\t    pub name: *const c_char,\n409\t    pub file: *const c_char,\n410\t    pub line: c_int,\n411\t    pub stack: c_int,\n412\t}\n413\t\n414\t#[repr(C)]\n415\tpub struct js_Jumpbuf {\n416\t    pub buf: [u64; 25], /* jmp_buf: 200 bytes on x86-64 glibc */\n417\t    pub E: *mut js_Environment,\n418\t    pub envtop: c_int,\n419\t    pub tracetop: c_int,\n420\t    pub top: c_int,\n421\t    pub bot: c_int,\n422\t    pub strict: c_int,\n423\t    pub pc: *mut js_Instruction,\n424\t}\n425\t\n426\t#[repr(C)]\n427\tpub struct js_Buffer {\n428\t    pub n: c_int,\n429\t    pub m: c_int,\n430\t    pub s: [c_char; 64],\n431\t}\n432\t\n433\t#[repr(C)]\n434\tpub struct js_Function {\n435\t    pub name: *const c_char,\n436\t    pub script: c_int,\n437\t    pub lightweight: c_int,\n438\t    pub strict: c_int,\n439\t    pub arguments: c_int,\n440\t    pub numparams: c_int,\n441\t\n442\t    pub code: *mut js_Instruction,\n443\t    pub codecap: c_int,\n444\t    pub codelen: c_int,\n445\t\n446\t    pub funtab: *mut *mut js_Function,\n447\t    pub funcap: c_int,\n448\t    pub funlen: c_int,\n449\t\n450\t    pub vartab: *mut *const c_char,\n451\t    pub varcap: c_int,\n452\t    pub varlen: c_int,\n453\t\n454\t    pub filename: *const c_char,\n455\t    pub line: c_int,\n456\t    pub lastline: c_int,\n457\t\n458\t    pub gcnext: *mut js_Function,\n459\t    pub gcmark: c_int,\n460\t}\n461\t\n462\t#[repr(C)]\n463\tpub struct js_JumpList {\n464\t    pub type_: c_int,\n465\t    pub inst: c_int,\n466\t    pub next: *mut js_JumpList,\n467\t}\n468\t\n469\t#[repr(C)]\n470\tpub struct js_Ast {\n471\t    pub type_: c_int,\n472\t    pub line: c_int,\n473\t    pub parent: *mut js_Ast,\n474\t    pub a: *mut js_Ast,\n475\t    pub b: *mut js_Ast,\n476\t    pub c: *mut js_Ast,\n477\t    pub d: *mut js_Ast,\n478\t    pub number: f64,\n479\t    pub string: *const c_char,\n480\t    pub jumps: *mut js_JumpList,\n481\t    pub casejump: c_int,\n482\t    pub gcnext: *mut js_Ast,\n483\t}\n484\t\n485\t#[repr(C)]\n486\tpub struct js_StringNode {\n487\t    pub left: *mut js_StringNode,\n488\t    pub right: *mut js_StringNode,\n489\t    pub level: c_int,\n490\t    pub string: [c_char; 1],\n491\t}\n492\t\n493\t#[repr(C)]\n494\tpub struct js_State_lexbuf {\n495\t    pub text: *mut c_char,\n496\t    pub len: c_int,\n497\t    pub cap: c_int,\n498\t}\n499\t\n500\t#[repr(C)]\n501\tpub struct js_State {\n502\t    pub actx: *mut c_void,\n503\t    pub uctx: *mut c_void,\n504\t    pub alloc: js_Alloc,\n505\t    pub report: js_Report,\n506\t    pub panic: js_Panic,\n507\t\n508\t    pub strings: *mut js_StringNode,\n509\t\n510\t    pub default_strict: c_int,\n511\t    pub strict: c_int,\n512\t\n513\t    /* parser input source */\n514\t    pub filename: *const c_char,\n515\t    pub source: *const c_char,\n516\t    pub line: c_int,\n517\t\n518\t    /* lexer state */\n519\t    pub lexbuf: js_State_lexbuf,\n520\t    pub lexline: c_int,\n521\t    pub lexchar: c_int,\n522\t    pub lasttoken: c_int,\n523\t    pub newline: c_int,\n524\t\n525\t    /* parser state */\n526\t    pub astdepth: c_int,\n527\t    pub lookahead: c_int,\n528\t    pub text: *const c_char,\n529\t    pub number: f64,\n530\t    pub gcast: *mut js_Ast,\n531\t\n532\t    /* runtime environment */\n533\t    pub Object_prototype: *mut js_Object,\n534\t    pub Array_prototype: *mut js_Object,\n535\t    pub Function_prototype: *mut js_Object,\n536\t    pub Boolean_prototype: *mut js_Object,\n537\t    pub Number_prototype: *mut js_Object,\n538\t    pub String_prototype: *mut js_Object,\n539\t    pub RegExp_prototype: *mut js_Object,\n540\t    pub Date_prototype: *mut js_Object,\n541\t\n542\t    pub Error_prototype: *mut js_Object,\n543\t    pub EvalError_prototype: *mut js_Object,\n544\t    pub RangeError_prototype: *mut js_Object,\n545\t    pub ReferenceError_prototype: *mut js_Object,\n546\t    pub SyntaxError_prototype: *mut js_Object,\n547\t    pub TypeError_prototype: *mut js_Object,\n548\t    pub URIError_prototype: *mut js_Object,\n549\t\n550\t    pub seed: c_uint,\n551\t\n552\t    pub scratch: [c_char; 12],\n553\t\n554\t    pub nextref: c_int,\n555\t    pub R: *mut js_Object,\n556\t    pub G: *mut js_Object,\n557\t    pub E: *mut js_Environment,\n558\t    pub GE: *mut js_Environment,\n559\t\n560\t    /* execution stack */\n561\t    pub top: c_int,\n562\t    pub bot: c_int,\n563\t    pub stack: *mut js_Value,\n564\t\n565\t    /* garbage collector list */\n566\t    pub gcmark: c_int,\n567\t    pub gccounter: c_uint,\n568\t    pub gcthresh: c_uint,\n569\t    pub gcenv: *mut js_Environment,\n570\t    pub gcfun: *mut js_Function,\n571\t    pub gcobj: *mut js_Object,\n572\t    pub gcstr: *mut js_String,\n573\t\n574\t    pub gcroot: *mut js_Object,\n575\t\n576\t    pub runlimit: c_int,\n577\t    pub memlimit: c_int,\n578\t\n579\t    pub envtop: c_int,\n580\t    pub envstack: [*mut js_Environment; JS_ENVLIMIT],\n581\t\n582\t    pub tracetop: c_int,\n583\t    pub trace: [js_StackTrace; JS_ENVLIMIT],\n584\t\n585\t    pub trytop: c_int,\n586\t    pub trybuf: [js_Jumpbuf; JS_TRYLIMIT as usize],\n587\t}\n588\t\n589\t/* Layout assertions: must match the C library exactly. */\n590\tconst _: () = assert!(core::mem::size_of::<js_Value>() == 16);\n591\tconst _: () = assert!(core::mem::size_of::<js_Object>() == 104);\n592\tconst _: () = assert!(core::mem::size_of::<js_Property>() == 64);\n593\tconst _: () = assert!(core::mem::size_of::<js_String>() == 16);\n594\tconst _: () = assert!(core::mem::size_of::<js_Iterator>() == 16);\n595\tconst _: () = assert!(core::mem::size_of::<js_Environment>() == 32);\n596\tconst _: () = assert!(core::mem::size_of::<js_Jumpbuf>() == 240);\n597\tconst _: () = assert!(core::mem::size_of::<js_Buffer>() == 72);\n598\tconst _: () = assert!(core::mem::size_of::<js_Function>() == 112);\n599\tconst _: () = assert!(core::mem::size_of::<js_Regexp>() == 24);\n600\tconst _: () = assert!(core::mem::size_of::<js_Ast>() == 88);\n601\tconst _: () = assert!(core::mem::size_of::<js_StackTrace>() == 24);\n602\tconst _: () = assert!(core::mem::size_of::<js_StringNode>() == 24);\n603\tconst _: () = assert!(core::mem::size_of::<js_State>() == 48552);\n604\t\n605\t/* --------------------------------------------------------- offsetofs ---- */\n606\t\n607\tpub const OFF_VALUE_TYPE: c_int = 15; /* soffsetof(js_Value, t.type) */\n608\tpub const OFF_STRING_P: usize = 9; /* soffsetof(js_String, p) */\n609\tpub const OFF_BUFFER_S: c_int = 8; /* soffsetof(js_Buffer, s) */\n610\tpub const OFF_PROPERTY_NAME: usize = 56;\n611\tpub const OFF_ITERATOR_NAME: usize = 8;\n612\tpub const OFF_STRINGNODE_STRING: usize = 20;\n613\t\n614\t/* ---------------------------------------------------- value accessors ---- */\n615\t\n616\t#[inline(always)]\n617\tpub unsafe fn vtype(v: *const js_Value) -> c_int {\n618\t    (*v).t.type_ as c_int\n619\t}\n620\t\n621\t#[inline(always)]\n622\tpub unsafe fn setvtype(v: *mut js_Value, t: c_int) {\n623\t    (*v).t.type_ = t as c_char;\n624\t}\n625\t\n626\t/// JSV_ISSTRING(v)\n627\t#[inline(always)]\n628\tpub unsafe fn jsv_isstring(v: *const js_Value) -> bool {\n629\t    let t = vtype(v);\n630\t    t == JS_TSHRSTR || t == JS_TMEMSTR || t == JS_TLITSTR\n631\t}\n632\t\n633\t/// JSV_TOSTRING(v)\n634\t#[inline(always)]\n635\tpub unsafe fn jsv_tostring_raw(v: *const js_Value) -> *const c_char {\n636\t    match vtype(v) {\n637\t        JS_TSHRSTR => addr_of!((*v).u.shrstr) as *const c_char,\n638\t        JS_TLITSTR => (*v).u.litstr,\n639\t        JS_TMEMSTR => addr_of!((*(*v).u.memstr).p) as *const c_char,\n640\t        _ => cs!(\"\"),\n641\t    }\n642\t}\n643\t\n644\t/// address of the `p` array of a js_String\n645\t#[inline(always)]\n646\tpub unsafe fn strp(s: *mut js_String) -> *mut c_char {\n647\t    addr_of_mut!((*s).p) as *mut c_char\n648\t}\n649\t\n650\t/// address of the `shrstr` array of a js_Value\n651\t#[inline(always)]\n652\tpub unsafe fn shrstrp(v: *mut js_Value) -> *mut c_char {\n653\t    addr_of_mut!((*v).u.shrstr) as *mut c_char\n654\t}\n655\t\n656\t/// address of the `name` array of a js_Property\n657\t#[inline(always)]\n658\tpub unsafe fn propname(p: *mut js_Property) -> *mut c_char {\n659\t    addr_of_mut!((*p).name) as *mut c_char\n660\t}\n661\t\n662\t/// address of the `name` array of a js_Iterator\n663\t#[inline(always)]\n664\tpub unsafe fn itername(p: *mut js_Iterator) -> *mut c_char {\n665\t    addr_of_mut!((*p).name) as *mut c_char\n666\t}\n667\t\n668\t/// address of the `string` array of a js_StringNode\n669\t#[inline(always)]\n670\tpub unsafe fn nodestring(p: *mut js_StringNode) -> *mut c_char {\n671\t    addr_of_mut!((*p).string) as *mut c_char\n672\t}\n673\t\n674\t/* -------------------------------------------------------- error macros ---- */\n675\t\n676\t/// Format a message like C's `vsnprintf(buf, 256, fmt, ...)` and raise it.\n677\t///\n678\t/// Usage: `js_throw_error!(js_typeerror_str, J, \"'%s' is read-only\", name)`\n679\t#[macro_export]\n680\tmacro_rules! js_throw_error {\n681\t    ($f:path, $J:expr, $fmt:expr) => {{\n682\t        let mut __buf: [$crate::jsi::c_char; 256] = [0; 256];\n683\t        $crate::jsi::snprintf(__buf.as_mut_ptr(), 256, $crate::cs!($fmt));\n684\t        $f($J, __buf.as_ptr())\n685\t    }};\n686\t    ($f:path, $J:expr, $fmt:expr $(, $a:expr)+) => {{\n687\t        let mut __buf: [$crate::jsi::c_char; 256] = [0; 256];\n688\t        $crate::jsi::snprintf(__buf.as_mut_ptr(), 256, $crate::cs!($fmt) $(, $a)+);\n689\t        $f($J, __buf.as_ptr())\n690\t    }};\n691\t}\n692\t\n693\t#[macro_export]\n694\tmacro_rules! js_error {\n695\t    ($J:expr, $fmt:expr $(, $a:expr)*) => {\n696\t        $crate::js_throw_error!($crate::jserror::js_error_str, $J, $fmt $(, $a)*)\n697\t    };\n698\t}\n699\t#[macro_export]\n700\tmacro_rules! js_evalerror {\n701\t    ($J:expr, $fmt:expr $(, $a:expr)*) => {\n702\t        $crate::js_throw_error!($crate::jserror::js_evalerror_str, $J, $fmt $(, $a)*)\n703\t    };\n704\t}\n705\t#[macro_export]\n706\tmacro_rules! js_rangeerror {\n707\t    ($J:expr, $fmt:expr $(, $a:expr)*) => {\n708\t        $crate::js_throw_error!($crate::jserror::js_rangeerror_str, $J, $fmt $(, $a)*)\n709\t    };\n710\t}\n711\t#[macro_export]\n712\tmacro_rules! js_referenceerror {\n713\t    ($J:expr, $fmt:expr $(, $a:expr)*) => {\n714\t        $crate::js_throw_error!($crate::jserror::js_referenceerror_str, $J, $fmt $(, $a)*)\n715\t    };\n716\t}\n717\t#[macro_export]\n718\tmacro_rules! js_syntaxerror {\n719\t    ($J:expr, $fmt:expr $(, $a:expr)*) => {\n720\t        $crate::js_throw_error!($crate::jserror::js_syntaxerror_str, $J, $fmt $(, $a)*)\n721\t    };\n722\t}\n723\t#[macro_export]\n724\tmacro_rules! js_typeerror {\n725\t    ($J:expr, $fmt:expr $(, $a:expr)*) => {\n726\t        $crate::js_throw_error!($crate::jserror::js_typeerror_str, $J, $fmt $(, $a)*)\n727\t    };\n728\t}\n729\t#[macro_export]\n730\tmacro_rules! js_urierror {\n731\t    ($J:expr, $fmt:expr $(, $a:expr)*) => {\n732\t        $crate::js_throw_error!($crate::jserror::js_urierror_str, $J, $fmt $(, $a)*)\n733\t    };\n734\t}\n735\t\n736\t/// Volatile read of a local variable (mirrors C's `volatile` qualifier which\n737\t/// the original code uses to keep values alive across `longjmp`).\n738\t#[macro_export]\n739\tmacro_rules! vol {\n740\t    ($x:expr) => {\n741\t        core::ptr::read_volatile(core::ptr::addr_of!($x))\n742\t    };\n743\t}\n744\t\n745\t/// Volatile write of a local variable.\n746\t#[macro_export]\n747\tmacro_rules! setvol {\n748\t    ($x:expr, $v:expr) => {\n749\t        core::ptr::write_volatile(core::ptr::addr_of_mut!($x), $v)\n750\t    };\n751\t}\n752\t\n753\t/// `js_try(J)` -- returns nonzero when an exception jumped back here.\n754\t///\n755\t/// MUST be invoked directly in the frame that should be resumed.\n756\t#[macro_export]\n757\tmacro_rules! js_try {\n758\t    ($J:expr) => {\n759\t        $crate::jsi::_setjmp($crate::jsrun::js_savetry($J) as *mut $crate::jsi::c_void)\n760\t    };\n761\t}\n762\t\n763\t#[macro_export]\n764\tmacro_rules! js_trypc {\n765\t    ($J:expr, $pc:expr) => {\n766\t        $crate::jsi::_setjmp($crate::jsrun::js_savetrypc($J, $pc) as *mut $crate::jsi::c_void)\n767\t    };\n768\t}\n769\t"}]},"parent_tool_use_id":"toolu_bdrk_01XbpkxHfcj4iadtRkMwagE8","session_id":"b5f4468e-76fc-4f11-a872-3a6ebded8ecd","uuid":"00c17114-2eff-42a7-b3d2-6