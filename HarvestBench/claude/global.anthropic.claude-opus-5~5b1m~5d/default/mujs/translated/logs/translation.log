     JS_TBOOLEAN => o = jsV_newboolean(J, (*v).u.boolean),\n535\t        JS_TNUMBER => o = jsV_newnumber(J, (*v).u.number),\n536\t        /* default and JS_TUNDEFINED */\n537\t        _ => js_typeerror!(J, \"cannot convert undefined to object\"),\n538\t    }\n539\t    setvtype(v, JS_TOBJECT);\n540\t    (*v).u.object = o;\n541\t    o\n542\t}\n543\t\n544\t#[unsafe(no_mangle)]\n545\tpub unsafe extern \"C\" fn js_newobjectx(J: *mut js_State) {\n546\t    let mut prototype: *mut js_Object = null_mut();\n547\t    if js_isobject(J, -1) != 0 {\n548\t        prototype = js_toobject(J, -1);\n549\t    }\n550\t    js_pop(J, 1);\n551\t    js_pushobject(J, jsV_newobject(J, JS_COBJECT, prototype));\n552\t}\n553\t\n554\t#[unsafe(no_mangle)]\n555\tpub unsafe extern \"C\" fn js_newobject(J: *mut js_State) {\n556\t    js_pushobject(J, jsV_newobject(J, JS_COBJECT, (*J).Object_prototype));\n557\t}\n558\t\n559\t#[unsafe(no_mangle)]\n560\tpub unsafe extern \"C\" fn js_newarguments(J: *mut js_State) {\n561\t    js_pushobject(J, jsV_newobject(J, JS_CARGUMENTS, (*J).Object_prototype));\n562\t}\n563\t\n564\t#[unsafe(no_mangle)]\n565\tpub unsafe extern \"C\" fn js_newarray(J: *mut js_State) {\n566\t    let obj = jsV_newobject(J, JS_CARRAY, (*J).Array_prototype);\n567\t    (*obj).u.a.simple = 1;\n568\t    js_pushobject(J, obj);\n569\t}\n570\t\n571\t#[unsafe(no_mangle)]\n572\tpub unsafe extern \"C\" fn js_newboolean(J: *mut js_State, v: c_int) {\n573\t    js_pushobject(J, jsV_newboolean(J, v));\n574\t}\n575\t\n576\t#[unsafe(no_mangle)]\n577\tpub unsafe extern \"C\" fn js_newnumber(J: *mut js_State, v: f64) {\n578\t    js_pushobject(J, jsV_newnumber(J, v));\n579\t}\n580\t\n581\t#[unsafe(no_mangle)]\n582\tpub unsafe extern \"C\" fn js_newstring(J: *mut js_State, v: *const c_char) {\n583\t    js_pushobject(J, jsV_newstring(J, v));\n584\t}\n585\t\n586\t#[unsafe(no_mangle)]\n587\tpub unsafe extern \"C\" fn js_newfunction(\n588\t    J: *mut js_State,\n589\t    fun: *mut js_Function,\n590\t    scope: *mut js_Environment,\n591\t) {\n592\t    let obj = jsV_newobject(J, JS_CFUNCTION, (*J).Function_prototype);\n593\t    (*obj).u.f.function = fun;\n594\t    (*obj).u.f.scope = scope;\n595\t    js_pushobject(J, obj);\n596\t    {\n597\t        js_pushnumber(J, (*fun).numparams as f64);\n598\t        js_defproperty(\n599\t            J,\n600\t            -2,\n601\t            cs!(\"length\"),\n602\t            JS_READONLY | JS_DONTENUM | JS_DONTCONF,\n603\t        );\n604\t        js_newobject(J);\n605\t        {\n606\t            js_copy(J, -2);\n607\t            js_defproperty(J, -2, cs!(\"constructor\"), JS_DONTENUM);\n608\t        }\n609\t        js_defproperty(J, -2, cs!(\"prototype\"), JS_DONTENUM | JS_DONTCONF);\n610\t    }\n611\t}\n612\t\n613\t#[unsafe(no_mangle)]\n614\tpub unsafe extern \"C\" fn js_newscript(\n615\t    J: *mut js_State,\n616\t    fun: *mut js_Function,\n617\t    scope: *mut js_Environment,\n618\t) {\n619\t    let obj = jsV_newobject(J, JS_CSCRIPT, null_mut());\n620\t    (*obj).u.f.function = fun;\n621\t    (*obj).u.f.scope = scope;\n622\t    js_pushobject(J, obj);\n623\t}\n624\t\n625\t#[unsafe(no_mangle)]\n626\tpub unsafe extern \"C\" fn js_newcfunctionx(\n627\t    J: *mut js_State,\n628\t    cfun: js_CFunction,\n629\t    name: *const c_char,\n630\t    length: c_int,\n631\t    data: *mut c_void,\n632\t    finalize: js_Finalize,\n633\t) {\n634\t    let obj: *mut js_Object;\n635\t    let mut vdata = data;\n636\t    let mut vfinalize = finalize;\n637\t\n638\t    if js_try!(J) != 0 {\n639\t        let f = vol!(vfinalize);\n640\t        if let Some(f) = f {\n641\t            f(J, vol!(vdata));\n642\t        }\n643\t        js_throw(J);\n644\t    }\n645\t\n646\t    obj = jsV_newobject(J, JS_CCFUNCTION, (*J).Function_prototype);\n647\t    (*obj).u.c.name = name;\n648\t    (*obj).u.c.function = cfun;\n649\t    (*obj).u.c.constructor = None;\n650\t    (*obj).u.c.length = length;\n651\t    (*obj).u.c.data = data;\n652\t    (*obj).u.c.finalize = finalize;\n653\t\n654\t    js_endtry(J);\n655\t\n656\t    js_pushobject(J, obj);\n657\t    {\n658\t        js_pushnumber(J, length as f64);\n659\t        js_defproperty(\n660\t            J,\n661\t            -2,\n662\t            cs!(\"length\"),\n663\t            JS_READONLY | JS_DONTENUM | JS_DONTCONF,\n664\t        );\n665\t        js_newobject(J);\n666\t        {\n667\t            js_copy(J, -2);\n668\t            js_defproperty(J, -2, cs!(\"constructor\"), JS_DONTENUM);\n669\t        }\n670\t        js_defproperty(J, -2, cs!(\"prototype\"), JS_DONTENUM | JS_DONTCONF);\n671\t    }\n672\t}\n673\t\n674\t#[unsafe(no_mangle)]\n675\tpub unsafe extern \"C\" fn js_newcfunction(\n676\t    J: *mut js_State,\n677\t    cfun: js_CFunction,\n678\t    name: *const c_char,\n679\t    length: c_int,\n680\t) {\n681\t    js_newcfunctionx(J, cfun, name, length, null_mut(), None);\n682\t}\n683\t\n684\t/* prototype -- constructor */\n685\t#[unsafe(no_mangle)]\n686\tpub unsafe extern \"C\" fn js_newcconstructor(\n687\t    J: *mut js_State,\n688\t    cfun: js_CFunction,\n689\t    ccon: js_CFunction,\n690\t    name: *const c_char,\n691\t    length: c_int,\n692\t) {\n693\t    let obj = jsV_newobject(J, JS_CCFUNCTION, (*J).Function_prototype);\n694\t    (*obj).u.c.name = name;\n695\t    (*obj).u.c.function = cfun;\n696\t    (*obj).u.c.constructor = ccon;\n697\t    (*obj).u.c.length = length;\n698\t    js_pushobject(J, obj); /* proto obj */\n699\t    {\n700\t        js_pushnumber(J, length as f64);\n701\t        js_defproperty(\n702\t            J,\n703\t            -2,\n704\t            cs!(\"length\"),\n705\t            JS_READONLY | JS_DONTENUM | JS_DONTCONF,\n706\t        );\n707\t        js_rot2(J); /* obj proto */\n708\t        js_copy(J, -2); /* obj proto obj */\n709\t        js_defproperty(J, -2, cs!(\"constructor\"), JS_DONTENUM);\n710\t        js_defproperty(J, -2, cs!(\"prototype\"), JS_DONTENUM | JS_DONTCONF);\n711\t    }\n712\t}\n713\t\n714\t#[unsafe(no_mangle)]\n715\tpub unsafe extern \"C\" fn js_newuserdatax(\n716\t    J: *mut js_State,\n717\t    tag: *const c_char,\n718\t    data: *mut c_void,\n719\t    has: js_HasProperty,\n720\t    put: js_Put,\n721\t    delete: js_Delete,\n722\t    finalize: js_Finalize,\n723\t) {\n724\t    let mut prototype: *mut js_Object = null_mut();\n725\t    let obj: *mut js_Object;\n726\t    let mut vdata = data;\n727\t    let mut vfinalize = finalize;\n728\t\n729\t    if js_isobject(J, -1) != 0 {\n730\t        prototype = js_toobject(J, -1);\n731\t    }\n732\t    js_pop(J, 1);\n733\t\n734\t    if js_try!(J) != 0 {\n735\t        let f = vol!(vfinalize);\n736\t        if let Some(f) = f {\n737\t            f(J, vol!(vdata));\n738\t        }\n739\t        js_throw(J);\n740\t    }\n741\t\n742\t    obj = jsV_newobject(J, JS_CUSERDATA, prototype);\n743\t    (*obj).u.user.tag = tag;\n744\t    (*obj).u.user.data = data;\n745\t    (*obj).u.user.has = has;\n746\t    (*obj).u.user.put = put;\n747\t    (*obj).u.user.delete = delete;\n748\t    (*obj).u.user.finalize = finalize;\n749\t\n750\t    js_endtry(J);\n751\t\n752\t    js_pushobject(J, obj);\n753\t}\n754\t\n755\t#[unsafe(no_mangle)]\n756\tpub unsafe extern \"C\" fn js_newuserdata(\n757\t    J: *mut js_State,\n758\t    tag: *const c_char,\n759\t    data: *mut c_void,\n760\t    finalize: js_Finalize,\n761\t) {\n762\t    js_newuserdatax(J, tag, data, None, None, None, finalize);\n763\t}\n764\t\n765\t/* Non-trivial operations on values. These are implemented using the stack. */\n766\t\n767\t#[unsafe(no_mangle)]\n768\tpub unsafe extern \"C\" fn js_instanceof(J: *mut js_State) -> c_int {\n769\t    let O: *mut js_Object;\n770\t    let mut V: *mut js_Object;\n771\t\n772\t    if js_iscallable(J, -1) == 0 {\n773\t        js_typeerror!(J, \"instanceof: invalid operand\");\n774\t    }\n775\t\n776\t    if js_isobject(J, -2) == 0 {\n777\t        return 0;\n778\t    }\n779\t\n780\t    js_getproperty(J, -1, cs!(\"prototype\"));\n781\t    if js_isobject(J, -1) == 0 {\n782\t        js_typeerr