427\t}\n428\t\n429\tstatic int lexstring(js_State *J)\n430\t{\n431\t\tconst char *s;\n432\t\n433\t\tint q = J->lexchar;\n434\t\tjsY_next(J);\n435\t\n436\t\ttextinit(J);\n437\t\n438\t\twhile (J->lexchar != q) {\n439\t\t\tif (J->lexchar == EOF || J->lexchar == '\\n')\n440\t\t\t\tjsY_error(J, \"string not terminated\");\n441\t\t\tif (jsY_accept(J, '\\\\')) {\n442\t\t\t\tif (lexescape(J))\n443\t\t\t\t\tjsY_error(J, \"malformed escape sequence\");\n444\t\t\t} else {\n445\t\t\t\ttextpush(J, J->lexchar);\n446\t\t\t\tjsY_next(J);\n447\t\t\t}\n448\t\t}\n449\t\tjsY_expect(J, q);\n450\t\n451\t\ts = textend(J);\n452\t\n453\t\tJ->text = s;\n454\t\treturn TK_STRING;\n455\t}\n456\t\n457\t/* the ugliest language wart ever... */\n458\tstatic int isregexpcontext(int last)\n459\t{\n460\t\tswitch (last) {\n461\t\tcase ']':\n462\t\tcase ')':\n463\t\tcase '}':\n464\t\tcase TK_IDENTIFIER:\n465\t\tcase TK_NUMBER:\n466\t\tcase TK_STRING:\n467\t\tcase TK_FALSE:\n468\t\tcase TK_NULL:\n469\t\tcase TK_THIS:\n470\t\tcase TK_TRUE:\n471\t\t\treturn 0;\n472\t\tdefault:\n473\t\t\treturn 1;\n474\t\t}\n475\t}\n476\t\n477\tstatic int lexregexp(js_State *J)\n478\t{\n479\t\tconst char *s;\n480\t\tint g, m, i, flags;\n481\t\tint inclass = 0;\n482\t\n483\t\t/* already consumed initial '/' */\n484\t\n485\t\ttextinit(J);\n486\t\n487\t\t/* regexp body */\n488\t\twhile (J->lexchar != '/' || inclass) {\n489\t\t\tif (J->lexchar == EOF || J->lexchar == '\\n') {\n490\t\t\t\tjsY_error(J, \"regular expression not terminated\");\n491\t\t\t} else if (jsY_accept(J, '\\\\')) {\n492\t\t\t\tif (jsY_accept(J, '/')) {\n493\t\t\t\t\ttextpush(J, '/');\n494\t\t\t\t} else {\n495\t\t\t\t\ttextpush(J, '\\\\');\n496\t\t\t\t\tif (J->lexchar == EOF || J->lexchar == '\\n')\n497\t\t\t\t\t\tjsY_error(J, \"regular expression not terminated\");\n498\t\t\t\t\ttextpush(J, J->lexchar);\n499\t\t\t\t\tjsY_next(J);\n500\t\t\t\t}\n501\t\t\t} else {\n502\t\t\t\tif (J->lexchar == '[' && !inclass)\n503\t\t\t\t\tinclass = 1;\n504\t\t\t\tif (J->lexchar == ']' && inclass)\n505\t\t\t\t\tinclass = 0;\n506\t\t\t\ttextpush(J, J->lexchar);\n507\t\t\t\tjsY_next(J);\n508\t\t\t}\n509\t\t}\n510\t\tjsY_expect(J, '/');\n511\t\n512\t\ts = textend(J);\n513\t\n514\t\t/* regexp flags */\n515\t\tg = i = m = 0;\n516\t\n517\t\twhile (jsY_isidentifierpart(J->lexchar)) {\n518\t\t\tif (jsY_accept(J, 'g')) ++g;\n519\t\t\telse if (jsY_accept(J, 'i')) ++i;\n520\t\t\telse if (jsY_accept(J, 'm')) ++m;\n521\t\t\telse jsY_error(J, \"illegal flag in regular expression: %c\", J->lexchar);\n522\t\t}\n523\t\n524\t\tif (g > 1 || i > 1 || m > 1)\n525\t\t\tjsY_error(J, \"duplicated flag in regular expression\");\n526\t\n527\t\tJ->text = s;\n528\t\n529\t\tflags = 0;\n530\t\tif (g) flags |= JS_REGEXP_G;\n531\t\tif (i) flags |= JS_REGEXP_I;\n532\t\tif (m) flags |= JS_REGEXP_M;\n533\t\tJ->number = flags;\n534\t\treturn TK_REGEXP;\n535\t}\n536\t\n537\t/* simple \"return [no Line Terminator here] ...\" contexts */\n538\tstatic int isnlthcontext(int last)\n539\t{\n540\t\tswitch (last) {\n541\t\tcase TK_BREAK:\n542\t\tcase TK_CONTINUE:\n543\t\tcase TK_RETURN:\n544\t\tcase TK_THROW:\n545\t\t\treturn 1;\n546\t\tdefault:\n547\t\t\treturn 0;\n548\t\t}\n549\t}\n550\t\n551\tstatic int jsY_lexx(js_State *J)\n552\t{\n553\t\tJ->newline = 0;\n554\t\n555\t\twhile (1) {\n556\t\t\tJ->lexline = J->line; /* save location of beginning of token */\n557\t\n558\t\t\twhile (jsY_iswhite(J->lexchar))\n559\t\t\t\tjsY_next(J);\n560\t\n561\t\t\tif (jsY_accept(J, '\\n')) {\n562\t\t\t\tJ->newline = 1;\n563\t\t\t\tif (isnlthcontext(J->lasttoken))\n564\t\t\t\t\treturn ';';\n565\t\t\t\tcontinue;\n566\t\t\t}\n567\t\n568\t\t\tif (jsY_accept(J, '/')) {\n569\t\t\t\tif (jsY_accept(J, '/')) {\n570\t\t\t\t\tlexlinecomment(J);\n571\t\t\t\t\tcontinue;\n572\t\t\t\t} else if (jsY_accept(J, '*')) {\n573\t\t\t\t\tif (lexcomment(J))\n574\t\t\t\t\t\tjsY_error(J, \"multi-line comment not terminated\");\n575\t\t\t\t\tcontinue;\n576\t\t\t\t} else if (isregexpcontext(J->lasttoken)) {\n577\t\t\t\t\treturn lexregexp(J);\n578\t\t\t\t} else if (jsY_accept(J, '=')) {\n579\t\t\t\t\treturn TK_DIV_ASS;\n580\t\t\t\t} else {\n581\t\t\t\t\treturn '/';\n582\t\t\t\t}\n583\t\t\t}\n584\t\n585\t\t\tif (J->lexchar >= '0' && J->lexchar <= '9') {\n586\t\t\t\treturn lexnumber(J);\n587\t\t\t}\n588\t\n589\t\t\tswitch (J->lexchar) {\n590\t\t\tcase '(': jsY_next(J); return '(';\n591\t\t\tcase ')': jsY_next(J); return ')';\n592\t\t\tcase ',': jsY_next(J); return ',';\n593\t\t\tcase ':': jsY_next(J); return ':';\n594\t\t\tcase ';': jsY_next(J); return ';';\n595\t\t\tcase '?': jsY_next(J); return '?';\n596\t\t\tcase '[': jsY_next(J); return '[';\n597\t\t\tcase ']': jsY_next(J); return ']';\n598\t\t\tcase '{': jsY_next(J); return '{';\n599\t\t\tcase '}': jsY_next(J); return '}';\n600\t\t\tcase '~': jsY_next(J); return '~';\n601\t\n602\t\t\tcase '\\'':\n603\t\t\tcase '\"':\n604\t\t\t\treturn lexstring(J);\n605\t\n606\t\t\tcase '.':\n607\t\t\t\treturn lexnumber(J);\n608\t\n609\t\t\tcase '<':\n610\t\t\t\tjsY_next(J);\n611\t\t\t\tif (jsY_accept(J, '<')) {\n612\t\t\t\t\tif (jsY_accept(J, '='))\n613\t\t\t\t\t\treturn TK_SHL_ASS;\n614\t\t\t\t\treturn TK_SHL;\n615\t\t\t\t}\n616\t\t\t\tif (jsY_accept(J, '='))\n617\t\t\t\t\treturn TK_LE;\n618\t\t\t\treturn '<';\n619\t\n620\t\t\tcase '>':\n621\t\t\t\tjsY_next(J);\n622\t\t\t\tif (jsY_accept(J, '>')) {\n623\t\t\t\t\tif (jsY_accept(J, '>')) {\n624\t\t\t\t\t\tif (jsY_accept(J, '='))\n625\t\t\t\t\t\t\treturn TK_USHR_ASS;\n626\t\t\t\t\t\treturn TK_USHR;\n627\t\t\t\t\t}\n628\t\t\t\t\tif (jsY_accept(J, '='))\n629\t\t\t\t\t\treturn TK_SHR_ASS;\n630\t\t\t\t\treturn TK_SHR;\n631\t\t\t\t}\n632\t\t\t\tif (jsY_accept(J, '='))\n633\t\t\t\t\treturn TK_GE;\n634\t\t\t\treturn '>';\n635\t\n636\t\t\tcase '=':\n637\t\t\t\tjsY_next(J);\n638\t\t\t\tif (jsY_accept(J, '=')) {\n639\t\t\t\t\tif (jsY_accept(J, '='))\n640\t\t\t\t\t\treturn TK_STRICTEQ;\n641\t\t\t\t\treturn TK_EQ;\n642\t\t\t\t}\n643\t\t\t\treturn '=';\n644\t\n645\t\t\tcase '!':\n646\t\t\t\tjsY_next(J);\n647\t\t\t\tif (jsY_accept(J, '=')) {\n648\t\t\t\t\tif (jsY_accept(J, '='))\n649\t\t\t\t\t\treturn TK_STRICTNE;\n650\t\t\t\t\treturn TK_NE;\n651\t\t\t\t}\n652\t\t\t\treturn '!';\n653\t\n654\t\t\tcase '+':\n655\t\t\t\tjsY_next(J);\n656\t\t\t\tif (jsY_accept(J, '+'))\n657\t\t\t\t\treturn TK_INC;\n658\t\t\t\tif (jsY_accept(J, '='))\n659\t\t\t\t\treturn TK_ADD_ASS;\n660\t\t\t\treturn '+';\n661\t\n662\t\t\tcase '-':\n663\t\t\t\tjsY_next(J);\n664\t\t\t\tif (jsY_accept(J, '-'))\n665\t\t\t\t\treturn TK_DEC;\n666\t\t\t\tif (jsY_accept(J, '='))\n667\t\t\t\t\treturn TK_SUB_ASS;\n668\t\t\t\treturn '-';\n669\t\n670\t\t\tcase '*':\n671\t\t\t\tjsY_next(J);\n672\t\t\t\tif (jsY_accept(J, '='))\n673\t\t\t\t\treturn TK_MUL_ASS;\n674\t\t\t\treturn '*';\n675\t\n676\t\t\tcase '%':\n677\t\t\t\tjsY_next(J);\n678\t\t\t\tif (jsY_accept(J, '='))\n679\t\t\t\t\treturn TK_MOD_ASS;\n680\t\t\t\treturn '%';\n681\t\n682\t\t\tcase '&':\n683\t\t\t\tjsY_next(J);\n684\t\t\t\tif (jsY_accept(J, '&'))\n685\t\t\t\t\treturn TK_AND;\n686\t\t\t\tif (jsY_accept(J, '='))\n687\t\t\t\t\treturn TK_AND_ASS;\n688\t\t\t\treturn '&';\n689\t\n690\t\t\tcase '|':\n691\t\t\t\tjsY_next(J);\n692\t\t\t\tif (jsY_accept(J, '|'))\n693\t\t\t\t\treturn TK_OR;\n694\t\t\t\tif (jsY_accept(J, '='))\n695\t\t\t\t\treturn TK_OR_ASS;\n696\t\t\t\treturn '|';\n697\t\n698\t\t\tcase '^':\n699\t\t\t\tjsY_next(J);\n700\t\t\t\tif (jsY_accept(J, '='))\n701\t\t\t\t\treturn TK_XOR_ASS;\n702\t\t\t\treturn '^';\n703\t\n704\t\t\tcase EOF:\n705\t\t\t\treturn 0; /* EOF */\n706\t\t\t}\n707\t\n708\t\t\t/* Handle \\uXXXX escapes in identifiers */\n709\t\t\tjsY_unescape(J);\n710\t\t\tif (jsY_isidentifierstart(J->lexchar)) {\n711\t\t\t\ttextinit(J);\n712\t\t\t\ttextpush(J, J->lexchar);\n713\t\n714\t\t\t\tjsY_next(J);\n715\t\t\t\tjsY_unescape(J);\n716\t\t\t\twhile (jsY_isidentifierpart(J->lexchar)) {\n717\t\t\t\t\ttextpush(J, J->lexchar);\n718\t\t\t\t\tjsY_next(J);\n719\t\t\t\t\tjsY_unescape(J);\n720\t\t\t\t}\n721\t\n722\t\t\t\ttextend(J);\n723\t\n724\t\t\t\treturn jsY