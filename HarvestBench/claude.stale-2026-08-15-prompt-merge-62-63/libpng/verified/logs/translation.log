{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GVtLJQMxMZV3qB2g1jbhaZ","type":"tool_result","content":"155\t// Chunk index values (pngpriv.h PNG_KNOWN_CHUNKS)\n156\tconst PNG_INDEX_cHRM: c_int = 6;\n157\tconst PNG_INDEX_cICP: c_int = 7;\n158\tconst PNG_INDEX_mDCV: c_int = 16;\n159\tconst PNG_INDEX_sRGB: c_int = 23;\n160\t\n161\t// png_file_has_chunk(png_ptr, i)\n162\t#[inline]\n163\tunsafe fn png_file_has_chunk(png_ptr: png_const_structrp, i: c_int) -> bool {\n164\t    ((*png_ptr).chunks & (0x80000000u32 >> (31 - i))) != 0\n165\t}\n166\t\n167\t// Cross-module read-only tables (defined in the png module).\n168\textern \"C\" {\n169\t    static png_sRGB_table: [png_uint_16; 256];\n170\t    static png_sRGB_base: [png_uint_16; 512];\n171\t    static png_sRGB_delta: [png_byte; 512];\n172\t}\n173\t\n174\t// stdio FFI needed for the simplified file reader.\n175\textern \"C\" {\n176\t    fn fopen(path: *const c_char, mode: *const c_char) -> *mut FILE;\n177\t    fn fclose(stream: *mut FILE) -> c_int;\n178\t    fn strerror(errnum: c_int) -> *mut c_char;\n179\t    #[link_name = \"__errno_location\"]\n180\t    fn errno_location() -> *mut c_int;\n181\t}\n182\t\n183\t// ---------------------------------------------------------------------------\n184\t// png_create_read_struct / png_create_read_struct_2\n185\t// ---------------------------------------------------------------------------\n186\t\n187\t#[unsafe(no_mangle)]\n188\tpub unsafe extern \"C\" fn png_create_read_struct(\n189\t    user_png_ver: png_const_charp,\n190\t    error_ptr: png_voidp,\n191\t    error_fn: png_error_ptr,\n192\t    warn_fn: png_error_ptr,\n193\t) -> png_structp {\n194\t    // PNG_USER_MEM_SUPPORTED is defined.\n195\t    png_create_read_struct_2(\n196\t        user_png_ver,\n197\t        error_ptr,\n198\t        error_fn,\n199\t        warn_fn,\n200\t        ptr::null_mut(),\n201\t        None,\n202\t        None,\n203\t    )\n204\t}\n205\t\n206\t#[unsafe(no_mangle)]\n207\t