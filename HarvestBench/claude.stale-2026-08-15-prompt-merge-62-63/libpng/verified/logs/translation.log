*const c_char > start && (number != 0 || count < mincount) {\n59\t        match format {\n60\t            x if x == PNG_NUMBER_FORMAT_fixed => {\n61\t                mincount = 5;\n62\t                if output != 0 || number % 10 != 0 {\n63\t                    end = end.offset(-1);\n64\t                    *end = DIGITS[(number % 10) as usize] as c_char;\n65\t                    output = 1;\n66\t                }\n67\t                number /= 10;\n68\t            }\n69\t            x if x == PNG_NUMBER_FORMAT_02u => {\n70\t                mincount = 2;\n71\t                end = end.offset(-1);\n72\t                *end = DIGITS[(number % 10) as usize] as c_char;\n73\t                number /= 10;\n74\t            }\n75\t            x if x == PNG_NUMBER_FORMAT_u => {\n76\t                end = end.offset(-1);\n77\t                *end = DIGITS[(number % 10) as usize] as c_char;\n78\t                number /= 10;\n79\t            }\n80\t            x if x == PNG_NUMBER_FORMAT_02x => {\n81\t                mincount = 2;\n82\t                end = end.offset(-1);\n83\t                *end = DIGITS[(number & 0xf) as usize] as c_char;\n84\t                number >>= 4;\n85\t            }\n86\t            x if x == PNG_NUMBER_FORMAT_x => {\n87\t                end = end.offset(-1);\n88\t                *end = DIGITS[(number & 0xf) as usize] as c_char;\n89\t                number >>= 4;\n90\t            }\n91\t            _ => {\n92\t                number = 0;\n93\t            }\n94\t        }\n95\t\n96\t        count += 1;\n97\t\n98\t        if format == PNG_NUMBER_FORMAT_fixed && count == 5 && (end as *const c_char > start) {\n99\t            if output != 0 {\n100\t                end = end.offset(-1);\n101\t                *end = b'.' as c_char;\n102\t            } else if number == 0 {\n103\t                end = end.offset(-1);\n104\t                *end = b'0' as c_char;\n105\t            }\n106\t        }\n107\t    }\n108\t\n109\t    end\n110\t}\n111\t\n112\t// This function is called whenever there is a non-fatal error.\n113\t#[unsafe(no_mangle)]\n114\tpub unsafe extern \"C\" fn png_warning(\n115\t    png_ptr: png_const_structrp,\n116\t    warning_message: png_const_charp,\n117\t) {\n118\t    let offset = 0isize;\n119\t    if !png_ptr.is_null() && (*png_ptr).warning_fn.is_some() {\n120\t        ((*png_ptr).warning_fn.unwrap())(png_ptr as png_structrp, warning_message.offset(offset));\n121\t    } else {\n122\t        png_default_warning(png_ptr, warning_message.offset(offset));\n123\t    }\n124\t}\n125\t\n126\t#[unsafe(no_mangle)]\n127\tpub unsafe extern \"C\" fn png_warning_parameter(\n128\t    p: *mut c_char,\n129\t    number: c_int,\n130\t    string: png_const_charp,\n131\t) {\n132\t    if number > 0 && number <= PNG_WARNING_PARAMETER_COUNT as c_int {\n133\t        let slot = p.add((number as usize - 1) * PNG_WARNING_PARAMETER_SIZE);\n134\t        png_safecat(slot, PNG_WARNING_PARAMETER_SIZE, 0, string);\n135\t    }\n136\t}\n137\t\n138\t#[unsafe(no_mangle)]\n139\tpub unsafe extern \"C\" fn png_warning_parameter_unsigned(\n140\t    p: *mut c_char,\n141\t    number: c_int,\n142\t    format: c_int,\n143\t    value: png_alloc_size_t,\n144\t) {\n145\t    let mut buffer = [0 as c_char; PNG_NUMBER_BUFFER_SIZE];\n146\t    let s = png_format_number(\n147\t        buffer.as_ptr(),\n148\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n149\t        format,\n150\t        value,\n151\t    );\n152\t    png_warning_parameter(p, number, s);\n153\t}\n154\t\n155\t#[unsafe(no_mangle)]\n156\tpub unsafe extern \"C\" fn png_warning_parameter_signed(\n157\t    p: *mut c_char,\n158\t    number: c_int,\n159\t    format: c_int,\n160\t    value: png_int_32,\n161\t) {\n162\t    let mut u = value as png_alloc_size_t;\n163\t    if value < 0 {\n164\t        u = (!u).wrapping_add(1);\n165\t    }\n166\t\n167\t    let mut buffer = [0 as c_char; PNG_NUMBER_BUFFER_SIZE];\n168\t    let mut str_ = png_format_number(\n169\t        buffer.as_ptr(),\n