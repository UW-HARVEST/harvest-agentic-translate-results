{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DkCw5NRFCL7hFXjTziVWBt","type":"tool_result","content":"1\t//! Translation of pngerror.c - error and warning handling.\n2\tuse crate::prelude::*;\n3\t\n4\tconst PNG_MAX_ERROR_TEXT: usize = 196;\n5\t\n6\t// This function is called whenever there is a fatal error.\n7\t#[unsafe(no_mangle)]\n8\tpub unsafe extern \"C\" fn png_error(\n9\t    png_ptr: png_const_structrp,\n10\t    error_message: png_const_charp,\n11\t) -> ! {\n12\t    if !png_ptr.is_null() && (*png_ptr).error_fn.is_some() {\n13\t        ((*png_ptr).error_fn.unwrap())(png_ptr as png_structrp, error_message);\n14\t    }\n15\t    // If the custom handler doesn't exist, or if it returns, use the default\n16\t    // handler, which will not return.\n17\t    png_default_error(png_ptr, error_message)\n18\t}\n19\t\n20\t/// Utility to safely append strings to a buffer.\n21\t#[unsafe(no_mangle)]\n22\tpub unsafe extern \"C\" fn png_safecat(\n23\t    buffer: png_charp,\n24\t    bufsize: size_t,\n25\t    mut pos: size_t,\n26\t    mut string: png_const_charp,\n27\t) -> size_t {\n28\t    if !buffer.is_null() && pos < bufsize {\n29\t        if !string.is_null() {\n30\t            while *string != 0 && pos < bufsize - 1 {\n31\t                *buffer.add(pos) = *string;\n32\t                pos += 1;\n33\t                string = string.add(1);\n34\t            }\n35\t        }\n36\t        *buffer.add(pos) = 0;\n37\t    }\n38\t    pos\n39\t}\n40\t\n41\t/// Dump an unsigned value into a buffer.\n42\t#[unsafe(no_mangle)]\n43\tpub unsafe extern \"C\" fn png_format_number(\n44\t    start: png_const_charp,\n45\t    mut end: png_charp,\n46\t    format: c_int,\n47\t    mut number: png_alloc_size_t,\n48\t) -> png_charp {\n49\t    let mut count = 0;\n50\t    let mut mincount = 1;\n51\t    let mut output = 0;\n52\t\n53\t    const DIGITS: &[u8; 16] = b\"0123456789ABCDEF\";\n54\t\n55\t    end = end.offset(-1);\n56\t    *end = 0;\n57\t\n58\t    while end as 