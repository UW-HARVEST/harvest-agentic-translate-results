{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015DkPdPj2CPaiRW6kLtVC1k","type":"tool_result","content":"1\t//! Translation of pngmem.c - memory allocation.\n2\tuse crate::prelude::*;\n3\t\n4\t/// Free a png_struct.\n5\t#[unsafe(no_mangle)]\n6\tpub unsafe extern \"C\" fn png_destroy_png_struct(png_ptr: png_structrp) {\n7\t    if !png_ptr.is_null() {\n8\t        // png_free might call png_error and may call png_get_mem_ptr, so fake a\n9\t        // temporary png_struct to support this.\n10\t        let mut dummy_struct: png_struct_def = core::ptr::read(png_ptr);\n11\t        memset(png_ptr as *mut c_void, 0, core::mem::size_of::<png_struct_def>());\n12\t        png_free(&mut dummy_struct, png_ptr as png_voidp);\n13\t\n14\t        // We may have a jmp_buf left to deallocate.\n15\t        png_free_jmpbuf(&mut dummy_struct);\n16\t    }\n17\t}\n18\t\n19\t/// Allocate memory and zero it.\n20\t#[unsafe(no_mangle)]\n21\tpub unsafe extern \"C\" fn png_calloc(png_ptr: png_const_structrp, size: png_alloc_size_t) -> png_voidp {\n22\t    let ret = png_malloc(png_ptr, size);\n23\t    if !ret.is_null() {\n24\t        memset(ret, 0, size);\n25\t    }\n26\t    ret\n27\t}\n28\t\n29\t/// Base allocator: honours user malloc_fn and limits, returns NULL on failure.\n30\t#[unsafe(no_mangle)]\n31\tpub unsafe extern \"C\" fn png_malloc_base(\n32\t    png_ptr: png_const_structrp,\n33\t    size: png_alloc_size_t,\n34\t) -> png_voidp {\n35\t    // size > PNG_SIZE_MAX check (PNG_SIZE_MAX == usize::MAX so always false, but\n36\t    // kept for fidelity).\n37\t    if size > PNG_SIZE_MAX {\n38\t        return ptr::null_mut();\n39\t    }\n40\t\n41\t    if !png_ptr.is_null() && (*png_ptr).malloc_fn.is_some() {\n42\t        return ((*png_ptr).malloc_fn.unwrap())(png_ptr as png_structrp, size);\n43\t    }\n44\t\n45\t    malloc(size as size_t)\n46\t}\n47\t\n48\tunsafe fn png_malloc_array_checked(\n49\t    png_ptr: png_const_structrp,\n50\t    nelements: c_int,\n51\t    element_size: size_t,\n52\t) -> png_voidp {\n53\t    let req = nelements as png_alloc_size_t; // known to be > 0\n54\t\n55\t    if req <= PNG_SIZE_MAX / element_size {\n56\t        return png_malloc_base(png_ptr, req * element_size);\n57\t    }\n58\t\n59\t    ptr::null_mut()\n60\t}\n61\t\n62\t#[unsafe(no_mangle)]\n63\tpub unsafe extern \"C\" fn png_malloc_array(\n64\t    png_ptr: png_const_structrp,\n65\t    nelements: c_int,\n66\t    element_size: size_t,\n67\t) -> png_voidp {\n68\t    if nelements <= 0 || element_size == 0 {\n69\t        png_error(png_ptr, c\"internal error: array alloc\".as_ptr());\n70\t    }\n71\t\n72\t    png_malloc_array_checked(png_ptr, nelements, element_size)\n73\t}\n74\t\n75\t#[unsafe(no_mangle)]\n76\tpub unsafe extern \"C\" fn png_realloc_array(\n77\t    png_ptr: png_const_structrp,\n78\t    old_array: png_const_voidp,\n79\t    old_elements: c_int,\n80\t    add_elements: c_int,\n81\t    element_size: size_t,\n82\t) -> png_voidp {\n83\t    // These are internal errors:\n84\t    if add_elements <= 0\n85\t        || element_size == 0\n86\t        || old_elements < 0\n87\t        || (old_array.is_null() && old_elements > 0)\n88\t    {\n89\t        png_error(png_ptr, c\"internal error: array realloc\".as_ptr());\n90\t    }\n91\t\n92\t    if add_elements <= c_int::MAX - old_elements {\n93\t        let new_array =\n94\t            png_malloc_array_checked(png_ptr, old_elements + add_elements, element_size);\n95\t\n96\t        if !new_array.is_null() {\n97\t            if old_elements > 0 {\n98\t                memcpy(\n99\t                    new_array,\n100\t                    old_array,\n101\t                    element_size * (old_elements as usize),\n102\t                );\n103\t            }\n104\t\n105\t            memset(\n106\t                (new_array as *mut u8).add(element_size * (old_elements as usize)) as *mut c_void,\n107\t                0,\n108\t                element_size * (add_elements as usize),\n109\t            );\n110\t\n111\t            return new_array;\n112\t        }\n113\t    }\n114\t\n115\t    ptr::null_mut()\n116\t}\n117\t\n118\t/// Allocate memory, error out on failure.\n119\t#[unsafe(no_mangle)]\n120\tpub unsafe extern \"C\" fn png_malloc(png_ptr: png_const_structrp, size: png_alloc_size_t) -> png_voidp {\n121\t    if png_ptr.is_null() {\n122\t        return ptr::null_mut();\n123\t    }\n124\t\n125\t    let ret = png_malloc_base(png_ptr, size);\n126\t\n127\t    if ret.is_null() {\n128\t        png_error(png_ptr, c\"Out of memory\".as_ptr());\n129\t    }\n130\t\n131\t    ret\n132\t}\n133\t\n134\t/// Bypass any user allocator (default allocator).\n135\t#[unsafe(no_mangle)]\n136\tpub unsafe extern \"C\" fn png_malloc_default(\n137\t    png_ptr: png_const_structrp,\n138\t    size: png_alloc_size_t,\n139\t) -> png_voidp {\n140\t    if png_ptr.is_null() {\n141\t        return ptr::null_mut();\n142\t    }\n143\t\n144\t    let ret = png_malloc_base(ptr::null(), size);\n145\t\n146\t    if ret.is_null() {\n147\t        png_error(png_ptr, c\"Out of Memory\".as_ptr());\n148\t    }\n149\t\n150\t    ret\n151\t}\n152\t\n153\t/// Allocate memory, warn and return NULL on failure.\n154\t#[unsafe(no_mangle)]\n155\tpub unsafe extern \"C\" fn png_malloc_warn(\n156\t    png_ptr: png_const_structrp,\n157\t    size: png_alloc_size_t,\n158\t) -> png_voidp {\n159\t    if !png_ptr.is_null() {\n160\t        let ret = png_malloc_base(png_ptr, size);\n161\t        if !ret.is_null() {\n162\t            return ret;\n163\t        }\n164\t        png_warning(png_ptr, c\"Out of memory\".as_ptr());\n165\t    }\n166\t    ptr::null_mut()\n167\t}\n168\t\n169\t/// Free memory allocated by png_malloc.\n170\t#[unsafe(no_mangle)]\n171\tpub unsafe extern \"C\" fn png_free(png_ptr: png_const_structrp, ptr_: png_voidp) {\n172\t    if png_ptr.is_null() || ptr_.is_null() {\n173\t        return;\n174\t    }\n175\t\n176\t    if (*png_ptr).free_fn.is_some() {\n177\t        ((*png_ptr).free_fn.unwrap())(png_ptr as png_structrp, ptr_);\n178\t    } else {\n179\t        png_free_default(png_ptr, ptr_);\n180\t    }\n181\t}\n182\t\n183\t#[unsafe(no_mangle)]\n184\tpub unsafe extern \"C\" fn png_free_default(png_ptr: png_const_structrp, ptr_: png_voidp) {\n185\t    if png_ptr.is_null() || ptr_.is_null() {\n186\t        return;\n187\t    }\n188\t\n189\t    free(ptr_);\n190\t}\n191\t\n192\t/// Set user memory functions.\n193\t#[unsafe(no_mangle)]\n194\tpub unsafe extern \"C\" fn png_set_mem_fn(\n195\t    png_ptr: png_structrp,\n196\t    mem_ptr: png_voidp,\n197\t    malloc_fn: png_malloc_ptr,\n198\t    free_fn: png_free_ptr,\n199\t) {\n200\t    if !png_ptr.is_null() {\n201\t        (*png_ptr).mem_ptr = mem_ptr;\n202\t        (*png_ptr).malloc_fn = malloc_fn;\n203\t        (*png_ptr).free_fn = free_fn;\n204\t    }\n205\t}\n206\t\n207\t/// Get the user mem_ptr.\n208\t#[unsafe(no_mangle)]\n209\tpub unsafe extern \"C\" fn png_get_mem_ptr(png_ptr: png_const_structrp) -> png_voidp {\n210\t    if png_ptr.is_null() {\n211\t        return ptr::null_mut();\n212\t    }\n213\t    (*png_ptr).mem_ptr\n214\t}\n215\t"}]},"parent_tool_use_id":"toolu_bdrk_01HZcMbAgyj5P4E2bXgyurtY","session_id":"a9e33088-46e8-41e9-a92d-60a8edf65823","uuid":"c2198960-ff0c-461a-8566-3a5f00e58da6","timestamp":"2026-08-05T02:07:40.555Z","subagent_type":"general-purpose","task_description":"Translate pngread.c to Rust"}
