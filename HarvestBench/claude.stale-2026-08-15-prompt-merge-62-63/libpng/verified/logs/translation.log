{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DtainrS3j1FF7KZ8hXYjWC","type":"tool_result","content":"1\t//! C library and zlib FFI declarations used throughout the port.\n2\t//!\n3\t//! libpng relies on the C standard library (malloc/free/memcpy/…), libm\n4\t//! (pow/floor/…), stdio (FILE*), and the system zlib for DEFLATE/INFLATE.  We\n5\t//! link the same system zlib the reference C build uses so that compressed\n6\t//! output is byte-identical.\n7\t#![allow(non_camel_case_types)]\n8\t\n9\tuse core::ffi::{c_char, c_int, c_long, c_void};\n10\t\n11\tpub type size_t = usize;\n12\t\n13\t// ---- libc ----\n14\textern \"C\" {\n15\t    pub fn malloc(size: size_t) -> *mut c_void;\n16\t    pub fn free(ptr: *mut c_void);\n17\t    pub fn memcpy(dst: *mut c_void, src: *const c_void, n: size_t) -> *mut c_void;\n18\t    pub fn memset(dst: *mut c_void, c: c_int, n: size_t) -> *mut c_void;\n19\t    pub fn memmove(dst: *mut c_void, src: *const c_void, n: size_t) -> *mut c_void;\n20\t    pub fn memcmp(a: *const c_void, b: *const c_void, n: size_t) -> c_int;\n21\t    pub fn strlen(s: *const c_char) -> size_t;\n22\t    pub fn strcmp(a: *const c_char, b: *const c_char) -> c_int;\n23\t    pub fn strncmp(a: *const c_char, b: *const c_char, n: size_t) -> c_int;\n24\t    pub fn strcpy(dst: *mut c_char, src: *const c_char) -> *mut c_char;\n25\t    pub fn strncpy(dst: *mut c_char, src: *const c_char, n: size_t) -> *mut c_char;\n26\t    pub fn strtod(s: *const c_char, endp: *mut *mut c_char) -> f64;\n27\t    pub fn atof(s: *const c_char) -> f64;\n28\t    pub fn abort() -> !;\n29\t    pub fn snprintf(s: *mut c_char, n: size_t, fmt: *const c_char, ...) -> c_int;\n30\t    pub fn sprintf(s: *mut c_char, fmt: *const c_char, ...) -> c_int;\n31\t\n32\t    // stdio\n33\t    pub fn fread(ptr: *mut c_void, size: size_t, n: size_t, stream: *mut FILE) -> size_t;\n34\t    pub fn fwrite(ptr: *const c_void, size: size_t, n: size_t, stream: *mut FILE) -> size_t;\n35\t    pub fn fflush(stream: *mut FILE) -> c_int;\n36\t    pub fn fprintf(stream: *mut FILE, fmt: *const c_char, ...) -> c_int;\n37\t    pub fn fputs(s: *const c_char, stream: *mut FILE) -> c_int;\n38\t    pub fn fputc(c: c_int, stream: *mut FILE) -> c_int;\n39\t\n40\t    // time\n41\t    pub fn gmtime(t: *const time_t) -> *mut tm;\n42\t\n43\t    // math\n44\t    pub fn pow(x: f64, y: f64) -> f64;\n45\t    pub fn floor(x: f64) -> f64;\n46\t    pub fn ceil(x: f64) -> f64;\n47\t    pub fn modf(x: f64, iptr: *mut f64) -> f64;\n48\t    pub fn frexp(x: f64, exp: *mut c_int) -> f64;\n49\t    pub fn fabs(x: f64) -> f64;\n50\t    pub fn log(x: f64) -> f64;\n51\t    pub fn exp(x: f64) -> f64;\n52\t    pub fn sqrt(x: f64) -> f64;\n53\t\n54\t    // errno-less longjmp support: the caller supplies longjmp via\n55\t    // png_set_longjmp_fn, so we do not need setjmp here.\n56\t    pub fn longjmp(env: *mut c_void, val: c_int) -> !;\n57\t}\n58\t\n59\textern \"C\" {\n60\t    /// setjmp shim (see csupport/shim.c). Returns 0 on the direct call and the\n61\t    /// longjmp value when returning via longjmp.\n62\t    #[link_name = \"png_rust_setjmp\"]\n63\t    pub fn setjmp_shim(env: *mut crate::pstruct::jmp_buf) -> c_int;\n64\t}\n65\t\n66\t// stderr accessor: `stderr` is a macro in C; use a helper symbol.\n67\textern \"C\" {\n68\t    #[link_name = \"stderr\"]\n69\t    static mut STDERR: *mut FILE;\n70\t}\n71\t\n72\t#[inline]\n73\tpub unsafe fn stderr() -> *mut FILE {\n74\t    STDERR\n75\t}\n76\t\n77\t// Opaque FILE type.\n78\t#[repr(C)]\n79\tpub struct FILE {\n80\t    _private: [u8; 0],\n81\t}\n82\t\n83\tpub type time_t = c_long;\n84\t\n85\t/// struct tm — layout as defined by glibc <time.h>.\n86\t#[repr(C)]\n87\t#[derive(Clone, Copy)]\n88\tpub struct tm {\n89\t    pub tm_sec: c_int,\n90\t    pub tm_min: c_int,\n91\t    pub tm_hour: c_int,\n92\t    pub tm_mday: c_int,\n93\t    pub tm_mon: c_int,\n94\t    pub tm_year: c_int,\n95\t    pub tm_wday: c_int,\n96\t    pub tm_yday: c_int,\n97\t    pub tm_isdst: c_int,\n98\t    pub tm_gmtoff: c_long,\n99\t    pub tm_zone: *const c_char,\n100\t}\n101\t\n102\t// ---- zlib ----\n103\t// z_stream layout must match the system zlib's z_stream_s exactly, since a\n104\t// z_stream lives embedded in png_struct and is passed to zlib functions.\n105\tpub type uInt = core::ffi::c_uint;\n106\tpub type uLong = core::ffi::c_ulong;\n107\tpub type Bytef = u8;\n108\tpub type voidpf = *mut c_void;\n109\t\n110\tpub type alloc_func = Option<unsafe extern \"C\" fn(voidpf, uInt, uInt) -> voidpf>;\n111\tpub type free_func = Option<unsafe extern \"C\" fn(voidpf, voidpf)>;\n112\t\n113\t#[repr(C)]\n114\tpub struct z_stream {\n115\t    pub next_in: *const Bytef,\n116\t    pub avail_in: uInt,\n117\t    pub total_in: uLong,\n118\t    pub next_out: *mut Bytef,\n119\t    pub avail_out: uInt,\n120\t    pub total_out: uLong,\n121\t    pub msg: *mut c_char,\n122\t    pub state: *mut c_void, // struct internal_state*\n123\t    pub zalloc: alloc_func,\n124\t    pub zfree: free_func,\n125\t    pub opaque: voidpf,\n126\t    pub data_type: c_int,\n127\t    pub adler: uLong,\n128\t    pub reserved: uLong,\n129\t}\n130\t\n131\tpub type z_streamp = *mut z_stream;\n132\t\n133\textern \"C\" {\n134\t    pub fn deflateInit2_(\n135\t        strm: z_streamp,\n136\t        level: c_int,\n137\t        method: c_int,\n138\t        windowBits: c_int,\n139\t        memLevel: c_int,\n140\t        strategy: c_int,\n141\t        version: *const c_char,\n142\t        stream_size: c_int,\n143\t    ) -> c_int;\n144\t    pub fn deflate(strm: z_streamp, flush: c_int) -> c_int;\n145\t    pub fn deflateEnd(strm: z_streamp) -> c_int;\n146\t    pub fn deflateReset(strm: z_streamp) -> c_int;\n147\t\n148\t    pub fn inflateInit2_(\n149\t        strm: z_streamp,\n150\t        windowBits: c_int,\n151\t        version: *const c_char,\n152\t        stream_size: c_int,\n153\t    ) -> c_int;\n154\t    pub fn inflate(strm: z_streamp, flush: c_int) -> c_int;\n155\t    pub fn inflateEnd(strm: z_streamp) -> c_int;\n156\t    pub fn inflateReset(strm: z_streamp) -> c_int;\n157\t    pub fn inflateReset2(strm: z_streamp, windowBits: c_int) -> c_int;\n158\t\n159\t    pub fn crc32(crc: uLong, buf: *const Bytef, len: uInt) -> uLong;\n160\t}\n161\t\n162\tpub const ZLIB_VERSION: &[u8] = b\"1.2.11\\0\";\n163\tpub const ZLIB_VERNUM: c_int = 0x12b0;\n164\t\n165\t#[inline]\n166\tpub unsafe fn deflateInit2(\n167\t    strm: z_streamp,\n168\t    level: c_int,\n169\t    method: c_int,\n170\t    window_bits: c_int,\n171\t    mem_level: c_int,\n172\t    strategy: c_int,\n173\t) -> c_int {\n174\t    deflateInit2_(\n175\t        strm,\n176\t        level,\n177\t        method,\n178\t        window_bits,\n179\t        mem_level,\n180\t        strategy,\n181\t        ZLIB_VERSION.as_ptr() as *const c_char,\n182\t        core::mem::size_of::<z_stream>() as c_int,\n183\t    )\n184\t}\n185\t\n186\t#[inline]\n187\tpub unsafe fn inflateInit2(strm: z_streamp, window_bits: c_int) -> c_int {\n188\t    inflateInit2_(\n189\t        strm,\n190\t        window_bits,\n191\t        ZLIB_VERSION.as_ptr() as *const c_char,\n192\t        core::mem::size_of::<z_stream>() as c_int,\n193\t    )\n194\t}\n195\t\n196\t// zlib return codes / flush values\n197\tpub const Z_OK: c_int = 0;\n198\tpub const Z_STREAM_END: c_int = 1;\n199\tpub const Z_NEED_DICT: c_int = 2;\n200\tpub const Z_ERRNO: c_int = -1;\n201\tpub const Z_STREAM_ERROR: c_int = -2;\n202\tpub const Z_DATA_ERROR: c_int = -3;\n203\tpub const Z_MEM_ERROR: c_int = -4;\n204\tpub const Z_BUF_ERROR: c_int = -5;\n205\tpub const Z_VERSION_ERROR: c_int = -6;\n206\t\n207\tpub const Z_NO_FLUSH: c_int = 0;\n208\tpub const Z_PARTIAL_FLUSH: c_int = 1;\n209\tpub const Z_SYNC_FLUSH: c_int = 2;\n210\tpub const Z_FULL_FLUSH: c_int = 3;\n211\tpub const Z_FINISH: c_int = 4;\n212\tpub const Z_BLOCK: c_int = 5;\n213\tpub const Z_TREES: c_int = 6;\n214\t\n215\tpub const Z_DEFLATED: c_int = 8;\n216\tpub const Z_DEFAULT_STRATEGY: c_int = 0;\n217\tpub const Z_DEFAULT_COMPRESSION: c_int = -1;\n218\t"}]},"parent_tool_use_id":"toolu_bdrk_01AJWUEDNLQsjxcy3B73d9Ja","session_id":"a9e33088-46e8-41e9-a92d-60a8edf65823","uuid":"c64f3b4c-c78a-4b25-a937-72be6fad533e","timestamp":"2026-08-05T02:06:55.872Z","subagent_type":"general-purpose","task_description":"Translate pngget.c to Rust"}
