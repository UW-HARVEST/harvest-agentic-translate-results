{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PQZ1MFYBYvZGsGfhD63YLf","type":"tool_result","content":"1\t//! Translation of pngerror.c - error and warning handling.\n2\tuse crate::prelude::*;\n3\t\n4\tconst PNG_MAX_ERROR_TEXT: usize = 196;\n5\t\n6\t// This function is called whenever there is a fatal error.\n7\t#[unsafe(no_mangle)]\n8\tpub unsafe extern \"C\" fn png_error(\n9\t    png_ptr: png_const_structrp,\n10\t    error_message: png_const_charp,\n11\t) -> ! {\n12\t    if !png_ptr.is_null() && (*png_ptr).error_fn.is_some() {\n13\t        ((*png_ptr).error_fn.unwrap())(png_ptr as png_structrp, error_message);\n14\t    }\n15\t    // If the custom handler doesn't exist, or if it returns, use the default\n16\t    // handler, which will not return.\n17\t    png_default_error(png_ptr, error_message)\n18\t}\n19\t\n20\t/// Utility to safely append strings to a buffer.\n21\t#[unsafe(no_mangle)]\n22\tpub unsafe extern \"C\" fn png_safecat(\n23\t    buffer: png_charp,\n24\t    bufsize: size_t,\n25\t    mut pos: size_t,\n26\t    mut string: png_const_charp,\n27\t) -> size_t {\n28\t    if !buffer.is_null() && pos < bufsize {\n29\t        if !string.is_null() {\n30\t            while *string != 0 && pos < bufsize - 1 {\n31\t                *buffer.add(pos) = *string;\n32\t                pos += 1;\n33\t                string = string.add(1);\n34\t            }\n35\t        }\n36\t        *buffer.add(pos) = 0;\n37\t    }\n38\t    pos\n39\t}\n40\t\n41\t/// Dump an unsigned value into a buffer.\n42\t#[unsafe(no_mangle)]\n43\tpub unsafe extern \"C\" fn png_format_number(\n44\t    start: png_const_charp,\n45\t    mut end: png_charp,\n46\t    format: c_int,\n47\t    mut number: png_alloc_size_t,\n48\t) -> png_charp {\n49\t    let mut count = 0;\n50\t    let mut mincount = 1;\n51\t    let mut output = 0;\n52\t\n53\t    const DIGITS: &[u8; 16] = b\"0123456789ABCDEF\";\n54\t\n55\t    end = end.offset(-1);\n56\t    *end = 0;\n57\t\n58\t    while end as *const c_char > start && (number != 0 || count < mincount) {\n59\t        match format {\n60\t            x if x == PNG_NUMBER_FORMAT_fixed => {\n61\t                mincount = 5;\n62\t                if output != 0 || number % 10 != 0 {\n63\t                    end = end.offset(-1);\n64\t                    *end = DIGITS[(number % 10) as usize] as c_char;\n65\t                    output = 1;\n66\t                }\n67\t                number /= 10;\n68\t            }\n69\t            x if x == PNG_NUMBER_FORMAT_02u => {\n70\t                mincount = 2;\n71\t                end = end.offset(-1);\n72\t                *end = DIGITS[(number % 10) as usize] as c_char;\n73\t                number /= 10;\n74\t            }\n75\t            x if x == PNG_NUMBER_FORMAT_u => {\n76\t                end = end.offset(-1);\n77\t                *end = DIGITS[(number % 10) as usize] as c_char;\n78\t                number /= 10;\n79\t            }\n80\t            x if x == PNG_NUMBER_FORMAT_02x => {\n81\t                mincount = 2;\n82\t                end = end.offset(-1);\n83\t                *end = DIGITS[(number & 0xf) as usize] as c_char;\n84\t                number >>= 4;\n85\t            }\n86\t            x if x == PNG_NUMBER_FORMAT_x => {\n87\t                end = end.offset(-1);\n88\t                *end = DIGITS[(number & 0xf) as usize] as c_char;\n89\t                number >>= 4;\n90\t            }\n91\t            _ => {\n92\t                number = 0;\n93\t            }\n94\t        }\n95\t\n96\t        count += 1;\n97\t\n98\t        if format == PNG_NUMBER_FORMAT_fixed && count == 5 && (end as *const c_char > start) {\n99\t            if output != 0 {\n100\t                end = end.offset(-1);\n101\t                *end = b'.' as c_char;\n102\t            } else if number == 0 {\n103\t                end = end.offset(-1);\n104\t                *end = b'0' as c_char;\n105\t            }\n106\t        }\n107\t    }\n108\t\n109\t    end\n110\t}\n111\t\n112\t// This function is called whenever there is a non-fatal error.\n113\t#[unsafe(no_mangle)]\n114\tpub unsafe extern \"C\" fn png_warning(\n115\t    png_ptr: png_const_structrp,\n116\t    warning_message: png_const_charp,\n117\t) {\n118\t    let offset = 0isize;\n119\t    if !png_ptr.is_null() && (*png_ptr).warning_fn.is_some() {\n120\t        ((*png_ptr).warning_fn.unwrap())(png_ptr as png_structrp, warning_message.offset(offset));\n121\t    } else {\n122\t        png_default_warning(png_ptr, warning_message.offset(offset));\n123\t    }\n124\t}\n125\t\n126\t#[unsafe(no_mangle)]\n127\tpub unsafe extern \"C\" fn png_warning_parameter(\n128\t    p: *mut c_char,\n129\t    number: c_int,\n130\t    string: png_const_charp,\n131\t) {\n132\t    if number > 0 && number <= PNG_WARNING_PARAMETER_COUNT as c_int {\n133\t        let slot = p.add((number as usize - 1) * PNG_WARNING_PARAMETER_SIZE);\n134\t        png_safecat(slot, PNG_WARNING_PARAMETER_SIZE, 0, string);\n135\t    }\n136\t}\n137\t\n138\t#[unsafe(no_mangle)]\n139\tpub unsafe extern \"C\" fn png_warning_parameter_unsigned(\n140\t    p: *mut c_char,\n141\t    number: c_int,\n142\t    format: c_int,\n143\t    value: png_alloc_size_t,\n144\t) {\n145\t    let mut buffer = [0 as c_char; PNG_NUMBER_BUFFER_SIZE];\n146\t    let s = png_format_number(\n147\t        buffer.as_ptr(),\n148\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n149\t        format,\n150\t        value,\n151\t    );\n152\t    png_warning_parameter(p, number, s);\n153\t}\n154\t\n155\t#[unsafe(no_mangle)]\n156\tpub unsafe extern \"C\" fn png_warning_parameter_signed(\n157\t    p: *mut c_char,\n158\t    number: c_int,\n159\t    format: c_int,\n160\t    value: png_int_32,\n161\t) {\n162\t    let mut u = value as png_alloc_size_t;\n163\t    if value < 0 {\n164\t        u = (!u).wrapping_add(1);\n165\t    }\n166\t\n167\t    let mut buffer = [0 as c_char; PNG_NUMBER_BUFFER_SIZE];\n168\t    let mut str_ = png_format_number(\n169\t        buffer.as_ptr(),\n170\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n171\t        format,\n172\t        u,\n173\t    );\n174\t\n175\t    if value < 0 && str_ > buffer.as_mut_ptr() {\n176\t        str_ = str_.offset(-1);\n177\t        *str_ = b'-' as c_char;\n178\t    }\n179\t\n180\t    png_warning_parameter(p, number, str_);\n181\t}\n182\t\n183\t#[unsafe(no_mangle)]\n184\tpub unsafe extern \"C\" fn png_formatted_warning(\n185\t    png_ptr: png_const_structrp,\n186\t    p: *mut c_char,\n187\t    mut message: png_const_charp,\n188\t) {\n189\t    let mut i: usize = 0;\n190\t    let mut msg = [0 as c_char; 192];\n191\t\n192\t    while i < 192 - 1 && *message != 0 {\n193\t        if !p.is_null() && *message == b'@' as c_char && *message.offset(1) != 0 {\n194\t            message = message.add(1);\n195\t            let parameter_char = *message;\n196\t            const VALID_PARAMETERS: &[u8; 9] = b\"123456789\";\n197\t            let mut parameter = 0usize;\n198\t\n199\t            while parameter < 9\n200\t                && VALID_PARAMETERS[parameter] as c_char != parameter_char\n201\t                && VALID_PARAMETERS[parameter] != 0\n202\t            {\n203\t                parameter += 1;\n204\t            }\n205\t\n206\t            if parameter < PNG_WARNING_PARAMETER_COUNT {\n207\t                let mut parm = p.add(parameter * PNG_WARNING_PARAMETER_SIZE) as png_const_charp;\n208\t                let pend = p.add(parameter * PNG_WARNING_PARAMETER_SIZE + PNG_WARNING_PARAMETER_SIZE)\n209\t                    as png_const_charp;\n210\t\n211\t                while i < 192 - 1 && *parm != 0 && parm < pend {\n212\t                    msg[i] = *parm;\n213\t                    i += 1;\n214\t                    parm = parm.add(1);\n215\t                }\n216\t\n217\t                message = message.add(1);\n218\t                continue;\n219\t            }\n220\t        }\n221\t\n222\t        msg[i] = *message;\n223\t        i += 1;\n224\t        message = message.add(1);\n225\t    }\n226\t\n227\t    msg[i] = 0;\n228\t\n229\t    png_warning(png_ptr, msg.as_ptr());\n230\t}\n231\t\n232\t#[unsafe(no_mangle)]\n233\tpub unsafe extern \"C\" fn png_benign_error(\n234\t    png_ptr: png_const_structrp,\n235\t    error_message: png_const_charp,\n236\t) {\n237\t    if ((*png_ptr).flags & PNG_FLAG_BENIGN_ERRORS_WARN) != 0 {\n238\t        if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 && (*png_ptr).chunk_name != 0 {\n239\t            png_chunk_warning(png_ptr, error_message);\n240\t        } else {\n241\t            png_warning(png_ptr, error_message);\n242\t        }\n243\t    } else {\n244\t        if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 && (*png_ptr).chunk_name != 0 {\n245\t            png_chunk_error(png_ptr, error_message);\n246\t        } else {\n247\t            png_error(png_ptr, error_message);\n248\t        }\n249\t    }\n250\t}\n251\t\n252\t#[unsafe(no_mangle)]\n253\tpub unsafe extern \"C\" fn png_app_warning(\n254\t    png_ptr: png_const_structrp,\n255\t    error_message: png_const_charp,\n256\t) {\n257\t    if ((*png_ptr).flags & PNG_FLAG_APP_WARNINGS_WARN) != 0 {\n258\t        png_warning(png_ptr, error_message);\n259\t    } else {\n260\t        png_error(png_ptr, error_message);\n261\t    }\n262\t}\n263\t\n264\t#[unsafe(no_mangle)]\n265\tpub unsafe extern \"C\" fn png_app_error(png_ptr: png_const_structrp, error_message: png_const_charp) {\n266\t    if ((*png_ptr).flags & PNG_FLAG_APP_ERRORS_WARN) != 0 {\n267\t        png_warning(png_ptr, error_message);\n268\t    } else {\n269\t        png_error(png_ptr, error_message);\n270\t    }\n271\t}\n272\t\n273\tconst PNG_LITERAL_LEFT_SQUARE_BRACKET: c_char = 0x5b;\n274\tconst PNG_LITERAL_RIGHT_SQUARE_BRACKET: c_char = 0x5d;\n275\t\n276\tconst PNG_DIGIT: [c_char; 16] = [\n277\t    b'0' as c_char, b'1' as c_char, b'2' as c_char, b'3' as c_char, b'4' as c_char, b'5' as c_char,\n278\t    b'6' as c_char, b'7' as c_char, b'8' as c_char, b'9' as c_char, b'A' as c_char, b'B' as c_char,\n279\t    b'C' as c_char, b'D' as c_char, b'E' as c_char, b'F' as c_char,\n280\t];\n281\t\n282\t#[inline]\n283\tfn isnonalpha(c: c_int) -> bool {\n284\t    c < 65 || c > 122 || (c > 90 && c < 97)\n285\t}\n286\t\n287\tunsafe fn png_format_buffer(\n288\t    png_ptr: png_const_structrp,\n289\t    buffer: png_charp,\n290\t    error_message: png_const_charp,\n291\t) {\n292\t    let chunk_name = (*png_ptr).chunk_name;\n293\t    let mut iout = 0isize;\n294\t    let mut ishift = 24i32;\n295\t\n296\t    while ishift >= 0 {\n297\t        let c = ((chunk_name >> ishift) & 0xff) as c_int;\n298\t        ishift -= 8;\n299\t        if isnonalpha(c) {\n300\t            *buffer.offset(iout) = PNG_LITERAL_LEFT_SQUARE_BRACKET;\n301\t            iout += 1;\n302\t            *buffer.offset(iout) = PNG_DIGIT[((c & 0xf0) >> 4) as usize];\n303\t            iout += 1;\n304\t            *buffer.offset(iout) = PNG_DIGIT[(c & 0x0f) as usize];\n305\t            iout += 1;\n306\t            *buffer.offset(iout) = PNG_LITERAL_RIGHT_SQUARE_BRACKET;\n307\t            iout += 1;\n308\t        } else {\n309\t            *buffer.offset(iout) = c as c_char;\n310\t            iout += 1;\n311\t        }\n312\t    }\n313\t\n314\t    if error_message.is_null() {\n315\t        *buffer.offset(iout) = 0;\n316\t    } else {\n317\t        let mut iin = 0isize;\n318\t        *buffer.offset(iout) = b':' as c_char;\n319\t        iout += 1;\n320\t        *buffer.offset(iout) = b' ' as c_char;\n321\t        iout += 1;\n322\t\n323\t        while iin < (PNG_MAX_ERROR_TEXT - 1) as isize && *error_message.offset(iin) != 0 {\n324\t            *buffer.offset(iout) = *error_message.offset(iin);\n325\t            iout += 1;\n326\t            iin += 1;\n327\t        }\n328\t        *buffer.offset(iout) = 0;\n329\t    }\n330\t}\n331\t\n332\t#[unsafe(no_mangle)]\n333\tpub unsafe extern \"C\" fn png_chunk_error(\n334\t    png_ptr: png_const_structrp,\n335\t    error_message: png_const_charp,\n336\t) -> ! {\n337\t    let mut msg = [0 as c_char; 18 + PNG_MAX_ERROR_TEXT];\n338\t    if png_ptr.is_null() {\n339\t        png_error(png_ptr, error_message);\n340\t    } else {\n341\t        png_format_buffer(png_ptr, msg.as_mut_ptr(), error_message);\n342\t        png_error(png_ptr, msg.as_ptr());\n343\t    }\n344\t}\n345\t\n346\t#[unsafe(no_mangle)]\n347\tpub unsafe extern \"C\" fn png_chunk_warning(\n348\t    png_ptr: png_const_structrp,\n349\t    warning_message: png_const_charp,\n350\t) {\n351\t    let mut msg = [0 as c_char; 18 + PNG_MAX_ERROR_TEXT];\n352\t    if png_ptr.is_null() {\n353\t        png_warning(png_ptr, warning_message);\n354\t    } else {\n355\t        png_format_buffer(png_ptr, msg.as_mut_ptr(), warning_message);\n356\t        png_warning(png_ptr, msg.as_ptr());\n357\t    }\n358\t}\n359\t\n360\t#[unsafe(no_mangle)]\n361\tpub unsafe extern \"C\" fn png_chunk_benign_error(\n362\t    png_ptr: png_const_structrp,\n363\t    error_message: png_const_charp,\n364\t) {\n365\t    if ((*png_ptr).flags & PNG_FLAG_BENIGN_ERRORS_WARN) != 0 {\n366\t        png_chunk_warning(png_ptr, error_message);\n367\t    } else {\n368\t        png_chunk_error(png_ptr, error_message);\n369\t    }\n370\t}\n371\t\n372\t#[unsafe(no_mangle)]\n373\tpub unsafe extern \"C\" fn png_chunk_report(\n374\t    png_ptr: png_const_structrp,\n375\t    message: png_const_charp,\n376\t    error: c_int,\n377\t) {\n378\t    if ((*png_ptr).mode & PNG_IS_READ_STRUCT) != 0 {\n379\t        if error < PNG_CHUNK_ERROR {\n380\t            png_chunk_warning(png_ptr, message);\n381\t        } else {\n382\t            png_chunk_benign_error(png_ptr, message);\n383\t        }\n384\t    } else if ((*png_ptr).mode & PNG_IS_READ_STRUCT) == 0 {\n385\t        if error < PNG_CHUNK_WRITE_ERROR {\n386\t            png_app_warning(png_ptr, message);\n387\t        } else {\n388\t            png_app_error(png_ptr, message);\n389\t        }\n390\t    }\n391\t}\n392\t\n393\t#[unsafe(no_mangle)]\n394\tpub unsafe extern \"C\" fn png_fixed_error(png_ptr: png_const_structrp, name: png_const_charp) -> ! {\n395\t    const FIXED_MESSAGE: &[u8] = b\"fixed point overflow in \";\n396\t    let fixed_message_ln = FIXED_MESSAGE.len();\n397\t    let mut msg = [0 as c_char; 24 + PNG_MAX_ERROR_TEXT];\n398\t    memcpy(\n399\t        msg.as_mut_ptr() as *mut c_void,\n400\t        FIXED_MESSAGE.as_ptr() as *const c_void,\n401\t        fixed_message_ln,\n402\t    );\n403\t    let mut iin = 0usize;\n404\t    if !name.is_null() {\n405\t        while iin < PNG_MAX_ERROR_TEXT - 1 && *name.add(iin) != 0 {\n406\t            msg[fixed_message_ln + iin] = *name.add(iin);\n407\t            iin += 1;\n408\t        }\n409\t    }\n410\t    msg[fixed_message_ln + iin] = 0;\n411\t    png_error(png_ptr, msg.as_ptr());\n412\t}\n413\t\n414\t// setjmp support\n415\t#[unsafe(no_mangle)]\n416\tpub unsafe extern \"C\" fn png_set_longjmp_fn(\n417\t    png_ptr: png_structrp,\n418\t    longjmp_fn: png_longjmp_ptr,\n419\t    jmp_buf_size: size_t,\n420\t) -> *mut c_void {\n421\t    if png_ptr.is_null() {\n422\t        return ptr::null_mut();\n423\t    }\n424\t\n425\t    if (*png_ptr).jmp_buf_ptr.is_null() {\n426\t        (*png_ptr).jmp_buf_size = 0;\n427\t\n428\t        if jmp_buf_size <= core::mem::size_of::<jmp_buf>() {\n429\t            (*png_ptr).jmp_buf_ptr = &mut (*png_ptr).jmp_buf_local;\n430\t        } else {\n431\t            (*png_ptr).jmp_buf_ptr =\n432\t                png_malloc_warn(png_ptr, jmp_buf_size as png_alloc_size_t) as *mut jmp_buf;\n433\t\n434\t            if (*png_ptr).jmp_buf_ptr.is_null() {\n435\t                return ptr::null_mut();\n436\t            }\n437\t\n438\t            (*png_ptr).jmp_buf_size = jmp_buf_size;\n439\t        }\n440\t    } else {\n441\t        let mut size = (*png_ptr).jmp_buf_size;\n442\t\n443\t        if size == 0 {\n444\t            size = core::mem::size_of::<jmp_buf>();\n445\t            if (*png_ptr).jmp_buf_ptr != &mut (*png_ptr).jmp_buf_local {\n446\t                png_error(png_ptr, c\"Libpng jmp_buf still allocated\".as_ptr());\n447\t            }\n448\t        }\n449\t\n450\t        if size != jmp_buf_size {\n451\t            png_warning(png_ptr, c\"Application jmp_buf size changed\".as_ptr());\n452\t            return ptr::null_mut();\n453\t        }\n454\t    }\n455\t\n456\t    (*png_ptr).longjmp_fn = longjmp_fn;\n457\t    (*png_ptr).jmp_buf_ptr as *mut c_void\n458\t}\n459\t\n460\t#[unsafe(no_mangle)]\n461\tpub unsafe extern \"C\" fn png_free_jmpbuf(png_ptr: png_structrp) {\n462\t    if !png_ptr.is_null() {\n463\t        let jb = (*png_ptr).jmp_buf_ptr;\n464\t\n465\t        if !jb.is_null() && (*png_ptr).jmp_buf_size > 0 {\n466\t            if jb != &mut (*png_ptr).jmp_buf_local {\n467\t                // Free the allocated jmp_buf.  The C code sets up a temporary\n468\t                // setjmp to recover from an error during free; here png_free\n469\t                // does not error, so we free directly.\n470\t                png_free(png_ptr, jb as png_voidp);\n471\t            }\n472\t        }\n473\t\n474\t        (*png_ptr).jmp_buf_size = 0;\n475\t        (*png_ptr).jmp_buf_ptr = ptr::null_mut();\n476\t        (*png_ptr).longjmp_fn = None;\n477\t    }\n478\t}\n479\t\n480\tunsafe fn png_default_error(png_ptr: png_const_structrp, error_message: png_const_charp) -> ! {\n481\t    let m = if error_message.is_null() {\n482\t        c\"undefined\".as_ptr()\n483\t    } else {\n484\t        error_message\n485\t    };\n486\t    fprintf(stderr(), c\"libpng error: %s\".as_ptr(), m);\n487\t    fprintf(stderr(), c\"\\n\".as_ptr());\n488\t    png_longjmp(png_ptr, 1)\n489\t}\n490\t\n491\t#[unsafe(no_mangle)]\n492\tpub unsafe extern \"C\" fn png_longjmp(png_ptr: png_const_structrp, val: c_int) -> ! {\n493\t    if !png_ptr.is_null()\n494\t        && (*png_ptr).longjmp_fn.is_some()\n495\t        && !(*png_ptr).jmp_buf_ptr.is_null()\n496\t    {\n497\t        ((*png_ptr).longjmp_fn.unwrap())((*png_ptr).jmp_buf_ptr as *mut c_void, val);\n498\t    }\n499\t    // png_longj