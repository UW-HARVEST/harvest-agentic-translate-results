avail_in;\n4229\t      }\n4230\t\n4231\t      /* And set up the output side. */\n4232\t      if (output != NULL) /* standard read */\n4233\t      {\n4234\t         uInt out = ZLIB_IO_MAX;\n4235\t\n4236\t         if (out > avail_out)\n4237\t            out = (uInt)avail_out;\n4238\t\n4239\t         avail_out -= out;\n4240\t         png_ptr->zstream.avail_out = out;\n4241\t      }\n4242\t\n4243\t      else /* after last row, checking for end */\n4244\t      {\n4245\t         png_ptr->zstream.next_out = tmpbuf;\n4246\t         png_ptr->zstream.avail_out = (sizeof tmpbuf);\n4247\t      }\n4248\t\n4249\t      /* Use NO_FLUSH; this gives zlib the maximum opportunity to optimize the\n4250\t       * process.  If the LZ stream is truncated the sequential reader will\n4251\t       * terminally damage the stream, above, by reading the chunk header of the\n4252\t       * following chunk (it then exits with png_error).\n4253\t       *\n4254\t       * TODO: deal more elegantly with truncated IDAT lists.\n4255\t       */\n4256\t      ret = PNG_INFLATE(png_ptr, Z_NO_FLUSH);\n4257\t\n4258\t      /* Take the unconsumed output back. */\n4259\t      if (output != NULL)\n4260\t         avail_out += png_ptr->zstream.avail_out;\n4261\t\n4262\t      else /* avail_out counts the extra bytes */\n4263\t         avail_out += (sizeof tmpbuf) - png_ptr->zstream.avail_out;\n4264\t\n4265\t      png_ptr->zstream.avail_out = 0;\n4266\t\n4267\t      if (ret == Z_STREAM_END)\n4268\t      {\n4269\t         /* Do this for safety; we won't read any more into this row. */\n4270\t         png_ptr->zstream.next_out = NULL;\n4271\t\n4272\t         png_ptr->mode |= PNG_AFTER_IDAT;\n4273\t         png_ptr->flags |= PNG_FLAG_ZSTREAM_ENDED;\n4274\t\n4275\t         if (png_ptr->zstream.avail_in > 0 || png_ptr->idat_size > 0)\n4276\t            png_chunk_benign_error(png_ptr, \"Extra compressed data\");\n4277\t         break;\n4278\t      }\n4279\t\n4280\t      if (ret != Z_OK)\n4281\t      {\n4282\t         png_zstream_error(png_ptr, ret);\n4283\t\n4284\t         if (output != NULL)\n4285\t            png_chunk_error(png_ptr, png_ptr->zstream.msg);\n4286\t\n4287\t         else /* checking */\n4288\t         {\n4289\t            png_chunk_benign_error(png_ptr, png_ptr->zstream.msg);\n4290\t            return;\n4291\t         }\n4292\t      }\n4293\t   } while (avail_out > 0);\n4294\t\n4295\t   if (avail_out > 0)\n4296\t   {\n4297\t      /* The stream ended before the image; this is the same as too few IDATs so\n4298\t       * should be handled the same way.\n4299\t       */\n4300\t      if (output != NULL)\n4301\t         png_error(png_ptr, \"Not enough image data\");\n4302\t\n4303\t      else /* the deflate stream contained extra data */\n4304\t         png_chunk_benign_error(png_ptr, \"Too much image data\");\n4305\t   }\n4306\t}\n4307\t\n4308\tvoid /* PRIVATE */\n4309\tpng_read_finish_IDAT(png_structrp png_ptr)\n4310\t{\n4311\t   /* We don't need any more data and the stream should have ended, however the\n4312\t    * LZ end code may actually not have been processed.  In this case we must\n4313\t    * read it otherwise stray unread IDAT data or, more likely, an IDAT chunk\n4314\t    * may still remain to be consumed.\n4315\t    */\n4316\t   if ((png_ptr->flags & PNG_FLAG_ZSTREAM_ENDED) == 0)\n4317\t   {\n4318\t      /* The NULL causes png_read_IDAT_data to swallow any remaining bytes in\n4319\t       * the compressed stream, but the stream may be damaged too, so even after\n4320\t       * this call we may need to terminate the zstream ownership.\n4321\t       */\n4322\t      png_read_IDAT_data(png_ptr, NULL, 0);\n4323\t      png_ptr->zstream.next_out = NULL; /* safety */\n4324\t\n4325\t      /* Now clear everything out for safety; the following may not have been\n4326\t       * done.\n4327\t       */\n4328\t      if ((png_ptr->flags & PNG_FLAG_ZSTREAM_ENDED) == 0)\n4329\t      {\n4330\t         png_ptr->mode |= PNG_AFTER_IDAT;\n4331\t         png_ptr->flags |= PNG_FLAG_ZSTREAM_ENDED;\n4332\t      }\n4333\t   }\n4334\t\n4335\t   /* If the zstream has not been released do it now *and* terminate the reading\n4336\t    * of the final IDAT chunk.\n4337\t    */\n4338\t   if (png_ptr->zowner == png_IDAT)\n4339\t   {\n4340\t      /* Always do this; the pointers otherwise point into the read buffer. */\n4341\t      png_ptr->zstream.next_in = NULL;\n4342\t      png_ptr->zstream.avail_in = 0;\n4343\t\n4344\t      /* Now we no longer own the zstream. */\n4345\t      png_ptr->zowner = 0;\n4346\t\n4347\t      /* The slightly weird semantics of the sequential IDAT reading is that we\n4348\t       * are always in or at the end of an IDAT chunk, so we always need to do a\n4349\t       * crc_finish here.  If idat_size is non-zero we also need to read the\n4350\t       * spurious bytes at the end of the chunk now.\n4351\t       */\n4352\t      (void)png_crc_finish(png_ptr, png_ptr->idat_size);\n4353\t   }\n4354\t}\n4355\t\n4356\tvoid /* PRIVATE */\n4357\tpng_read_finish_row(png_structrp png_ptr)\n4358\t{\n4359\t   png_debug(1, \"in png_read_finish_row\");\n4360\t   png_ptr->row_number++;\n4361\t   if (png_ptr->row_number < png_ptr->num_rows)\n4362\t      return;\n4363\t\n4364\t   if (png_ptr->interlaced != 0)\n4365\t   {\n4366\t      png_ptr->row_number = 0;\n4367\t\n4368\t      /* TO DO: don't do this if prev_row isn't needed (requires\n4369\t       * read-ahead of the next row's filter byte.\n4370\t       */\n4371\t      memset(png_ptr->prev_row, 0, png_ptr->rowbytes + 1);\n4372\t\n4373\t      do\n4374\t      {\n4375\t         png_ptr->pass++;\n4376\t\n4377\t         if (png_ptr->pass >= 7)\n4378\t            break;\n4379\t\n4380\t         png_ptr->iwidth = (png_ptr->width +\n4381\t            png_pass_inc[png_ptr->pass] - 1 -\n4382\t            png_pass_start[png_ptr->pass]) /\n4383\t            png_pass_inc[png_ptr->pass];\n4384\t\n4385\t         if ((png_ptr->transformations & PNG_INTERLACE) == 0)\n4386\t         {\n4387\t            png_ptr->num_rows = (png_ptr->height +\n4388\t                png_pass_yinc[png_ptr->pass] - 1 -\n4389\t                png_pass_ystart[png_ptr->pass]) /\n4390\t                png_pass_yinc[png_ptr->pass];\n4391\t         }\n4392\t\n4393\t         else  /* if (png_ptr->transformations & PNG_INTERLACE) */\n4394\t            break; /* libpng deinterlacing sees every row */\n4395\t\n4396\t      } while (png_ptr->num_rows == 0 || png_ptr->iwidth == 0);\n4397\t\n4398\t      if (png_ptr->pass < 7)\n4399\t         return;\n4400\t   }\n4401\t\n4402\t   /* Here after at the end of the last row of the last pass. */\n4403\t   png_read_finish_IDAT(png_ptr);\n4404\t}\n4405\t#endif /* SEQUENTIAL_READ */\n4406\t\n4407\tvoid /* PRIVATE */\n4408\tpng_read_start_row(png_structrp png_ptr)\n4409\t{\n4410\t   unsigned int max_pixel_depth;\n4411\t   size_t row_bytes;\n4412\t\n4413\t   png_debug(1, \"in png_read_start_row\");\n4414\t\n4415\t#ifdef PNG_READ_TRANSFORMS_SUPPORTED\n4416\t   png_init_read_transformations(png_ptr);\n4417\t#endif\n4418\t   if (png_ptr->interlaced != 0)\n4419\t   {\n4420\t      if ((png_ptr->transformations & PNG_INTERLACE) == 0)\n4421\t         png_ptr->num_rows = (png_ptr->height + png_pass_yinc[0] - 1 -\n4422\t             png_pass_ystart[0]) / png_pass_yinc[0];\n4423\t\n4424\t      else\n4425\t         png_ptr->num_rows = png_ptr->height;\n4426\t\n4427\t      png_ptr->iwidth = (png_ptr->width +\n4428\t          png_pass_inc[png_ptr->pass] - 1 -\n4429\t          png_pass_start[png_ptr->pass]) /\n4430\t          png_pass_inc[png_ptr->pass];\n4431\t   }\n4432\t\n4433\t   else\n4434\t   {\n4435\t      png_ptr->num_rows = png_ptr->height;\n4436\t      png_ptr->iwidth = png_ptr->width;\n4437\t   }\n4438\t\n4439\t   max_pixel_depth = (unsigned int)png_ptr->pixel_depth;\n4440\t\n4441\t   /* WARNING: * png_read_transform_info (pngrtran.c) performs a simpler set of\n4442\t    * calculations to calculate the final pixel depth, then\n4443\t    * png_do_read_transforms actually does