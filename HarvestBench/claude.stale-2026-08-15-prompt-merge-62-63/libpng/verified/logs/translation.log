      png_ptr->transformations &= ~PNG_EXPAND_16;\n4503\t   }\n4504\t#endif\n4505\t\n4506\t#ifdef PNG_READ_FILLER_SUPPORTED\n4507\t   if ((png_ptr->transformations & (PNG_FILLER)) != 0)\n4508\t   {\n4509\t      if (png_ptr->color_type == PNG_COLOR_TYPE_GRAY)\n4510\t      {\n4511\t         if (max_pixel_depth <= 8)\n4512\t            max_pixel_depth = 16;\n4513\t\n4514\t         else\n4515\t            max_pixel_depth = 32;\n4516\t      }\n4517\t\n4518\t      else if (png_ptr->color_type == PNG_COLOR_TYPE_RGB ||\n4519\t         png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n4520\t      {\n4521\t         if (max_pixel_depth <= 32)\n4522\t            max_pixel_depth = 32;\n4523\t\n4524\t         else\n4525\t            max_pixel_depth = 64;\n4526\t      }\n4527\t   }\n4528\t#endif\n4529\t\n4530\t#ifdef PNG_READ_GRAY_TO_RGB_SUPPORTED\n4531\t   if ((png_ptr->transformations & PNG_GRAY_TO_RGB) != 0)\n4532\t   {\n4533\t      if (\n4534\t#ifdef PNG_READ_EXPAND_SUPPORTED\n4535\t          (png_ptr->num_trans != 0 &&\n4536\t          (png_ptr->transformations & PNG_EXPAND) != 0) ||\n4537\t#endif\n4538\t#ifdef PNG_READ_FILLER_SUPPORTED\n4539\t          (png_ptr->transformations & (PNG_FILLER)) != 0 ||\n4540\t#endif\n4541\t          png_ptr->color_type == PNG_COLOR_TYPE_GRAY_ALPHA)\n4542\t      {\n4543\t         if (max_pixel_depth <= 16)\n4544\t            max_pixel_depth = 32;\n4545\t\n4546\t         else\n4547\t            max_pixel_depth = 64;\n4548\t      }\n4549\t\n4550\t      else\n4551\t      {\n4552\t         if (max_pixel_depth <= 8)\n4553\t         {\n4554\t            if (png_ptr->color_type == PNG_COLOR_TYPE_RGB_ALPHA)\n4555\t               max_pixel_depth = 32;\n4556\t\n4557\t            else\n4558\t               max_pixel_depth = 24;\n4559\t         }\n4560\t\n4561\t         else if (png_ptr->color_type == PNG_COLOR_TYPE_RGB_ALPHA)\n4562\t            max_pixel_depth = 64;\n4563\t\n4564\t         else\n4565\t            max_pixel_depth = 48;\n4566\t      }\n4567\