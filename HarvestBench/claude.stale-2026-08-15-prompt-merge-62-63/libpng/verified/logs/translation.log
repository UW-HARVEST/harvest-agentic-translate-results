558\t            c\"bad longjmp: \".as_ptr(),\n559\t        );\n560\t        png_safecat(\n561\t            (*image).message.as_mut_ptr(),\n562\t            core::mem::size_of_val(&(*image).message),\n563\t            pos,\n564\t            error_message,\n565\t        );\n566\t    }\n567\t\n568\t    abort()\n569\t}\n570\t\n571\t#[unsafe(no_mangle)]\n572\tpub unsafe extern \"C\" fn png_safe_warning(\n573\t    png_nonconst_ptr: png_structp,\n574\t    warning_message: png_const_charp,\n575\t) {\n576\t    let png_ptr = png_nonconst_ptr;\n577\t    let image = (*png_ptr).error_ptr as png_imagep;\n578\t\n579\t    if (*image).warning_or_error == 0 {\n580\t        png_safecat(\n581\t            (*image).message.as_mut_ptr(),\n582\t            core::mem::size_of_val(&(*image).message),\n583\t            0,\n584\t            warning_message,\n585\t        );\n586\t        (*image).warning_or_error |= PNG_IMAGE_WARNING;\n587\t    }\n588\t}\n589\t\n590\t#[unsafe(no_mangle)]\n591\tpub unsafe extern \"C\" fn png_safe_execute(\n592\t    image: png_imagep,\n593\t    function: Option<unsafe extern \"C\" fn(png_voidp) -> c_int>,\n594\t    arg: png_voidp,\n595\t) -> c_int {\n596\t    let saved_error_buf = (*(*image).opaque).error_buf;\n597\t    let mut safe_jmpbuf = jmp_buf { bytes: [0; 25] };\n598\t\n599\t    // Safely execute function(arg), with png_error returning back here.\n600\t    if setjmp_shim(&mut safe_jmpbuf) == 0 {\n601\t        (*(*image).opaque).error_buf = &mut safe_jmpbuf as *mut jmp_buf as png_voidp;\n602\t        let result = function.unwrap()(arg);\n603\t        (*(*image).opaque).error_buf = saved_error_buf;\n604\t\n605\t        if result != 0 {\n606\t            return 1;\n607\t        }\n608\t    }\n609\t\n610\t    (*(*image).opaque).error_buf = saved_error_buf;\n611\t\n612\t    if saved_error_buf.is_null() {\n613\t        png_image_free(image);\n614\t    }\n615\t\n616\t    0\n617\t}\n618\t"}]},"parent_tool_use_id":"toolu_bdrk_01LvP3u9dgfeGyXPRiryz5Cq","session_i