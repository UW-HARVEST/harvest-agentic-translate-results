{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BgXPoHz4NEYobrhwLHKsVB","type":"tool_result","content":"1\t//! Internal png_struct_def and png_info_def, mirroring pngstruct.h and\n2\t//! pnginfo.h for the enabled configuration (full libpng 1.6.59 feature set).\n3\t//!\n4\t//! These structures are opaque to applications, but libpng copies them by\n5\t//! value in a few places (e.g. png_destroy_png_struct), so we mirror the C\n6\t//! layout with `#[repr(C)]` and preserve field names/order.\n7\t#![allow(non_camel_case_types)]\n8\t\n9\tuse core::ffi::{c_int, c_uint};\n10\t\n11\tuse crate::cffi::z_stream;\n12\tuse crate::ptypes::*;\n13\t\n14\t/// glibc jmp_buf: struct __jmp_buf_tag[1], 200 bytes, 8-byte aligned.\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy)]\n17\tpub struct jmp_buf {\n18\t    pub bytes: [u64; 25],\n19\t}\n20\t\n21\tpub const PNG_FILTER_VALUE_LAST_M1: usize = PNG_FILTER_VALUE_LAST - 1;\n22\t\n23\t#[repr(C)]\n24\tpub struct png_struct_def {\n25\t    // setjmp\n26\t    pub jmp_buf_local: jmp_buf,\n27\t    pub longjmp_fn: png_longjmp_ptr,\n28\t    pub jmp_buf_ptr: *mut jmp_buf,\n29\t    pub jmp_buf_size: usize,\n30\t\n31\t    pub error_fn: png_error_ptr,\n32\t    pub warning_fn: png_error_ptr,\n33\t    pub error_ptr: png_voidp,\n34\t    pub write_data_fn: png_rw_ptr,\n35\t    pub read_data_fn: png_rw_ptr,\n36\t    pub io_ptr: png_voidp,\n37\t\n38\t    pub read_user_transform_fn: png_user_transform_ptr,\n39\t    pub write_user_transform_fn: png_user_transform_ptr,\n40\t\n41\t    pub user_transform_ptr: png_voidp,\n42\t    pub user_transform_depth: png_byte,\n43\t    pub user_transform_channels: png_byte,\n44\t\n45\t    pub mode: png_uint_32,\n46\t    pub flags: png_uint_32,\n47\t    pub transformations: png_uint_32,\n48\t\n49\t    pub zowner: png_uint_32,\n50\t    pub zstream: z_stream,\n51\t\n52\t    // WRITE_SUPPORTED\n53\t    pub zbuffer_list: png_compression_bufferp,\n54\t    pub zbuffer_size: crate::cffi::uInt,\n55\t    pub zlib_level: c_int,\n56\t    pub zlib_method: c_int,\n57\t    pub zlib_window_bits: c_int,\n58\t    pub zlib_mem_level: c_int,\n59\t    pub zlib_strategy: c_int,\n60\t\n61\t    // WRITE_CUSTOMIZE_ZTXT_COMPRESSION\n62\t    pub zlib_text_level: c_int,\n63\t    pub zlib_text_method: c_int,\n64\t    pub zlib_text_window_bits: c_int,\n65\t    pub zlib_text_mem_level: c_int,\n66\t    pub zlib_text_strategy: c_int,\n67\t\n68\t    // WRITE_SUPPORTED (1.6.0)\n69\t    pub zlib_set_level: c_int,\n70\t    pub zlib_set_method: c_int,\n71\t    pub zlib_set_window_bits: c_int,\n72\t    pub zlib_set_mem_level: c_int,\n73\t    pub zlib_set_strategy: c_int,\n74\t\n75\t    pub chunks: png_uint_32,\n76\t\n77\t    pub width: png_uint_32,\n78\t    pub height: png_uint_32,\n79\t    pub num_rows: png_uint_32,\n80\t    pub usr_width: png_uint_32,\n81\t    pub rowbytes: usize,\n82\t    pub iwidth: png_uint_32,\n83\t    pub row_number: png_uint_32,\n84\t    pub chunk_name: png_uint_32,\n85\t    pub prev_row: png_bytep,\n86\t    pub row_buf: png_bytep,\n87\t\n88\t    // WRITE_FILTER\n89\t    pub try_row: png_bytep,\n90\t    pub tst_row: png_bytep,\n91\t\n92\t    pub info_rowbytes: usize,\n93\t\n94\t    pub idat_size: png_uint_32,\n95\t    pub crc: png_uint_32,\n96\t    pub palette: png_colorp,\n97\t    pub num_palette: png_uint_16,\n98\t\n99\t    // CHECK_FOR_INVALID_INDEX\n100\t    pub num_palette_max: c_int,\n101\t\n102\t    pub num_trans: png_uint_16,\n103\t    pub compression: png_byte,\n104\t    pub filter: png_byte,\n105\t    pub interlaced: png_byte,\n106\t    pub pass: png_byte,\n107\t    pub do_filter: png_byte,\n108\t    pub color_type: png_byte,\n109\t    pub bit_depth: png_byte,\n110\t    pub usr_bit_depth: png_byte,\n111\t    pub pixel_depth: png_byte,\n112\t    pub channels: png_byte,\n113\t    pub usr_channels: png_byte,\n114\t    pub sig_bytes: png_byte,\n115\t    pub maximum_pixel_depth: png_byte,\n116\t    pub transformed_pixel_depth: png_byte,\n117\t\n118\t    // ZLIB >= 1.2.4