{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VuwK5LRpt6SttYeBYzVyDg","type":"tool_result","content":"1\t//! Small helper functions/macros used across modules (translations of\n2\t//! function-like macros in pngpriv.h).\n3\t#![allow(dead_code)]\n4\t\n5\tuse crate::ptypes::{png_byte, png_uint_32};\n6\t\n7\t/// PNG_ROWBYTES(pixel_bits, width)\n8\t#[inline]\n9\tpub fn png_rowbytes(pixel_bits: u32, width: u32) -> usize {\n10\t    let width = width as usize;\n11\t    let pixel_bits = pixel_bits as usize;\n12\t    if pixel_bits >= 8 {\n13\t        width * (pixel_bits >> 3)\n14\t    } else {\n15\t        (width * pixel_bits + 7) >> 3\n16\t    }\n17\t}\n18\t\n19\t/// PNG_DIV65535\n20\t#[inline]\n21\tpub fn png_div65535(v24: u32) -> u32 {\n22\t    (v24 + 32895) >> 16\n23\t}\n24\t\n25\t/// PNG_DIV257\n26\t#[inline]\n27\tpub fn png_div257(v16: u32) -> u32 {\n28\t    png_div65535(v16 * 255)\n29\t}\n30\t\n31\t/// PNG_PIXEL_DEPTH-ish helpers on chunk names\n32\t#[inline]\n33\tpub fn png_chunk_ancillary(c: png_uint_32) -> u32 {\n34\t    1 & (c >> 29)\n35\t}\n36\t#[inline]\n37\tpub fn png_chunk_critical(c: png_uint_32) -> u32 {\n38\t    (png_chunk_ancillary(c) == 0) as u32\n39\t}\n40\t#[inline]\n41\tpub fn png_chunk_private(c: png_uint_32) -> u32 {\n42\t    1 & (c >> 21)\n43\t}\n44\t#[inline]\n45\tpub fn png_chunk_reserved(c: png_uint_32) -> u32 {\n46\t    1 & (c >> 13)\n47\t}\n48\t#[inline]\n49\tpub fn png_chunk_safe_to_copy(c: png_uint_32) -> u32 {\n50\t    1 & (c >> 5)\n51\t}\n52\t\n53\t/// PNG_CSTRING_FROM_CHUNK: fill s[0..5] with the 4 chunk bytes + NUL.\n54\t#[inline]\n55\tpub unsafe fn png_cstring_from_chunk(s: *mut core::ffi::c_char, c: png_uint_32) {\n56\t    *s.offset(0) = ((c >> 24) & 0xff) as core::ffi::c_char;\n57\t    *s.offset(1) = ((c >> 16) & 0xff) as core::ffi::c_char;\n58\t    *s.offset(2) = ((c >> 8) & 0xff) as core::ffi::c_char;\n59\t    *s.offset(3) = (c & 0xff) as core::ffi::c_char;\n60\t    *s.offset(4) = 0;\n61\t}\n62\t\n63\t/// PNG_STRING_FROM_CHUNK (no NUL terminator)\n64\t#[inline]\n65\tpub unsafe fn png_string_from_chunk(s: *mut core::ffi::c_char, c: png_uint_32) {\n66\t    *s.offset(0) = ((c >> 24) & 0xff) as core::ffi::c_char;\n67\t    *s.offset(1) = ((c >> 16) & 0xff) as core::ffi::c_char;\n68\t    *s.offset(2) = ((c >> 8) & 0xff) as core::ffi::c_char;\n69\t    *s.offset(3) = (c & 0xff) as core::ffi::c_char;\n70\t}\n71\t\n72\t/// PNG_CHUNK_FROM_STRING\n73\t#[inline]\n74\tpub unsafe fn png_chunk_from_string(s: *const png_byte) -> png_uint_32 {\n75\t    ((*s.offset(0) as png_uint_32) << 24)\n76\t        | ((*s.offset(1) as png_uint_32) << 16)\n77\t        | ((*s.offset(2) as png_uint_32) << 8)\n78\t        | (*s.offset(3) as png_uint_32)\n79\t}\n80\t\n81\t/// PNG_OUT_OF_RANGE\n82\t#[inline]\n83\tpub fn png_out_of_range(value: i32, ideal: i32, delta: i32) -> bool {\n84\t    value < ideal - delta || value > ideal + delta\n85\t}\n86\t"}]},"parent_tool_use_id":"toolu_bdrk_013JUHdsFCXGWe6Hs8cviFi5","session_id":"a9e33088-46e8-41e9-a92d-60a8edf65823","uuid":"be79062f-c7ca-4c9d-b4f8-1cb680eb47a4","timestamp":"2026-08-05T02:08:18.872Z","subagent_type":"general-purpose","task_description":"Translate pngpread.c to Rust"}
