fn png_set_write_fn(\n61\t    png_ptr: png_structrp,\n62\t    io_ptr: png_voidp,\n63\t    write_data_fn: png_rw_ptr,\n64\t    output_flush_fn: png_flush_ptr,\n65\t) {\n66\t    if png_ptr.is_null() {\n67\t        return;\n68\t    }\n69\t\n70\t    (*png_ptr).io_ptr = io_ptr;\n71\t\n72\t    if write_data_fn.is_some() {\n73\t        (*png_ptr).write_data_fn = write_data_fn;\n74\t    } else {\n75\t        (*png_ptr).write_data_fn = Some(png_default_write_data);\n76\t    }\n77\t\n78\t    if output_flush_fn.is_some() {\n79\t        (*png_ptr).output_flush_fn = output_flush_fn;\n80\t    } else {\n81\t        (*png_ptr).output_flush_fn = Some(png_default_flush);\n82\t    }\n83\t\n84\t    // It is an error to read while writing a png file.\n85\t    if (*png_ptr).read_data_fn.is_some() {\n86\t        (*png_ptr).read_data_fn = None;\n87\t        png_warning(\n88\t            png_ptr,\n89\t            c\"Can't set both read_data_fn and write_data_fn in the same structure\".as_ptr(),\n90\t        );\n91\t    }\n92\t}\n93\t"}]},"parent_tool_use_id":"toolu_bdrk_01WHNJw93KaYEQeSXUtfcicV","session_id":"a9e33088-46e8-41e9-a92d-60a8edf65823","uuid":"917ede3c-1775-4048-b89b-6a7d66f2d43b","timestamp":"2026-08-05T02:08:02.886Z","subagent_type":"general-purpose","task_description":"Translate pngwutil.c to Rust"}
