\t\n3197\t               if (have_alpha != 0)\n3198\t                  *(dp++) = *(sp++);\n3199\t            }\n3200\t         }\n3201\t         else\n3202\t#endif\n3203\t         {\n3204\t            png_bytep sp = row;\n3205\t            png_bytep dp = row;\n3206\t            png_uint_32 i;\n3207\t\n3208\t            for (i = 0; i < row_width; i++)\n3209\t            {\n3210\t               png_byte red   = *(sp++);\n3211\t               png_byte green = *(sp++);\n3212\t               png_byte blue  = *(sp++);\n3213\t\n3214\t               if (red != green || red != blue)\n3215\t               {\n3216\t                  rgb_error |= 1;\n3217\t                  /* NOTE: this is the historical approach which simply\n3218\t                   * truncates the results.\n3219\t                   */\n3220\t                  *(dp++) = (png_byte)((rc*red + gc*green + bc*blue)>>15);\n3221\t               }\n3222\t\n3223\t               else\n3224\t                  *(dp++) = red;\n3225\t\n3226\t               if (have_alpha != 0)\n3227\t                  *(dp++) = *(sp++);\n3228\t            }\n3229\t         }\n3230\t      }\n3231\t\n3232\t      else /* RGB bit_depth == 16 */\n3233\t      {\n3234\t#ifdef PNG_READ_GAMMA_SUPPORTED\n3235\t         if (png_ptr->gamma_16_to_1 != NULL && png_ptr->gamma_16_from_1 != NULL)\n3236\t         {\n3237\t            png_bytep sp = row;\n3238\t            png_bytep dp = row;\n3239\t            png_uint_32 i;\n3240\t\n3241\t            for (i = 0; i < row_width; i++)\n3242\t            {\n3243\t               png_uint_16 red, green, blue, w;\n3244\t               png_byte hi,lo;\n3245\t\n3246\t               hi=*(sp)++; lo=*(sp)++; red   = (png_uint_16)((hi << 8) | (lo));\n3247\t               hi=*(sp)++; lo=*(sp)++; green = (png_uint_16)((hi << 8) | (lo));\n3248\t               hi=*(sp)++; lo=*(sp)++; blue  = (png_uint_16)((hi << 8) | (lo));\n3249\t\n3250\t               if (red == green && red == blue)\n3251\t               {\n3252\t     