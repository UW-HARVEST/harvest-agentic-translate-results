This function is called whenever there is a non-fatal error.\n113\t#[unsafe(no_mangle)]\n114\tpub unsafe extern \"C\" fn png_warning(\n115\t    png_ptr: png_const_structrp,\n116\t    warning_message: png_const_charp,\n117\t) {\n118\t    let offset = 0isize;\n119\t    if !png_ptr.is_null() && (*png_ptr).warning_fn.is_some() {\n120\t        ((*png_ptr).warning_fn.unwrap())(png_ptr as png_structrp, warning_message.offset(offset));\n121\t    } else {\n122\t        png_default_warning(png_ptr, warning_message.offset(offset));\n123\t    }\n124\t}\n125\t\n126\t#[unsafe(no_mangle)]\n127\tpub unsafe extern \"C\" fn png_warning_parameter(\n128\t    p: *mut c_char,\n129\t    number: c_int,\n130\t    string: png_const_charp,\n131\t) {\n132\t    if number > 0 && number <= PNG_WARNING_PARAMETER_COUNT as c_int {\n133\t        let slot = p.add((number as usize - 1) * PNG_WARNING_PARAMETER_SIZE);\n134\t        png_safecat(slot, PNG_WARNING_PARAMETER_SIZE, 0, string);\n135\t    }\n136\t}\n137\t\n138\t#[unsafe(no_mangle)]\n139\tpub unsafe extern \"C\" fn png_warning_parameter_unsigned(\n140\t    p: *mut c_char,\n141\t    number: c_int,\n142\t    format: c_int,\n143\t    value: png_alloc_size_t,\n144\t) {\n145\t    let mut buffer = [0 as c_char; PNG_NUMBER_BUFFER_SIZE];\n146\t    let s = png_format_number(\n147\t        buffer.as_ptr(),\n148\t        buffer.as_mut_ptr().add(PNG_NUMBER_BUFFER_SIZE),\n149\t        format,\n150\t        value,\n151\t    );\n152\t    png_warning_parameter(p, number, s);\n153\t}\n154\t\n155\t#[unsafe(no_mangle)]\n156\tpub unsafe extern \"C\" fn png_warning_parameter_signed(\n157\t    p: *mut c_char,\n158\t    number: c_int,\n159\t    format: c_int,\n160\t    value: png_int_32,\n161\t) {\n162\t    let mut u = value as png_alloc_size_t;\n163\t    if value < 0 {\n164\t        u = (!u).wrapping_add(1);\n165\t    }\n166\t\n167\t    let mut buffer = [0 as c_char; PNG_NUMBER_BUFFER_SIZE];\n168\t    let mut str_ = png_format_number(\n169\t        buffer.as_ptr(),\n