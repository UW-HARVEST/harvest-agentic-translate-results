 = 0;\n1759\t      return handled_error;\n1760\t   }\n1761\t\n1762\t   png_set_tRNS(png_ptr, info_ptr, readbuf, png_ptr->num_trans,\n1763\t       &(png_ptr->trans_color));\n1764\t   return handled_ok;\n1765\t}\n1766\t#else\n1767\t#  define png_handle_tRNS NULL\n1768\t#endif\n1769\t\n1770\t#ifdef PNG_READ_bKGD_SUPPORTED\n1771\tstatic png_handle_result_code /* PRIVATE */\n1772\tpng_handle_bKGD(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1773\t{\n1774\t   unsigned int truelen;\n1775\t   png_byte buf[6];\n1776\t   png_color_16 background;\n1777\t\n1778\t   png_debug(1, \"in png_handle_bKGD\");\n1779\t\n1780\t   if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n1781\t   {\n1782\t      if ((png_ptr->mode & PNG_HAVE_PLTE) == 0)\n1783\t      {\n1784\t         png_crc_finish(png_ptr, length);\n1785\t         png_chunk_benign_error(png_ptr, \"out of place\");\n1786\t         return handled_error;\n1787\t      }\n1788\t\n1789\t      truelen = 1;\n1790\t   }\n1791\t\n1792\t   else if ((png_ptr->color_type & PNG_COLOR_MASK_COLOR) != 0)\n1793\t      truelen = 6;\n1794\t\n1795\t   else\n1796\t      truelen = 2;\n1797\t\n1798\t   if (length != truelen)\n1799\t   {\n1800\t      png_crc_finish(png_ptr, length);\n1801\t      png_chunk_benign_error(png_ptr, \"invalid\");\n1802\t      return handled_error;\n1803\t   }\n1804\t\n1805\t   png_crc_read(png_ptr, buf, truelen);\n1806\t\n1807\t   if (png_crc_finish(png_ptr, 0) != 0)\n1808\t      return handled_error;\n1809\t\n1810\t   /* We convert the index value into RGB components so that we can allow\n1811\t    * arbitrary RGB values for background when we have transparency, and\n1812\t    * so it is easy to determine the RGB values of the background color\n1813\t    * from the info_ptr struct.\n1814\t    */\n1815\t   if (png_ptr->color_type == PNG_COLOR_TYPE_PALETTE)\n1816\t   {\n1817\t      background.index = buf[0];\n1818\t\n1819\t      if (info_ptr != NULL && info_ptr->num_palette != 0)\n1820\t      {\n1821\t         if (buf[0] >= info_ptr->num_palette)\n1822\t         {\n1823\t            png_chunk_benign_error(png_ptr, \"invalid index\");\n1824\t            return handled_error;\n1825\t         }\n1826\t\n1827\t         background.red = (png_uint_16)png_ptr->palette[buf[0]].red;\n1828\t         background.green = (png_uint_16)png_ptr->palette[buf[0]].green;\n1829\t         background.blue = (png_uint_16)png_ptr->palette[buf[0]].blue;\n1830\t      }\n1831\t\n1832\t      else\n1833\t         background.red = background.green = background.blue = 0;\n1834\t\n1835\t      background.gray = 0;\n1836\t   }\n1837\t\n1838\t   else if ((png_ptr->color_type & PNG_COLOR_MASK_COLOR) == 0) /* GRAY */\n1839\t   {\n1840\t      if (png_ptr->bit_depth <= 8)\n1841\t      {\n1842\t         if (buf[0] != 0 || buf[1] >= (unsigned int)(1 << png_ptr->bit_depth))\n1843\t         {\n1844\t            png_chunk_benign_error(png_ptr, \"invalid gray level\");\n1845\t            return handled_error;\n1846\t         }\n1847\t      }\n1848\t\n1849\t      background.index = 0;\n1850\t      background.red =\n1851\t      background.green =\n1852\t      background.blue =\n1853\t      background.gray = png_get_uint_16(buf);\n1854\t   }\n1855\t\n1856\t   else\n1857\t   {\n1858\t      if (png_ptr->bit_depth <= 8)\n1859\t      {\n1860\t         if (buf[0] != 0 || buf[2] != 0 || buf[4] != 0)\n1861\t         {\n1862\t            png_chunk_benign_error(png_ptr, \"invalid color\");\n1863\t            return handled_error;\n1864\t         }\n1865\t      }\n1866\t\n1867\t      background.index = 0;\n1868\t      background.red = png_get_uint_16(buf);\n1869\t      background.green = png_get_uint_16(buf + 2);\n1870\t      background.blue = png_get_uint_16(buf + 4);\n1871\t      background.gray = 0;\n1872\t   }\n1873\t\n1874\t   png_set_bKGD(png_ptr, info_ptr, &background);\n1875\t   return handled_ok;\n1876\t}\n1877\t#else\n1878\t#  define png_handle_bKGD NULL\n1879\t#endif\n1880\t\n1881\t#ifdef PNG_READ_cICP_SUPPORTED\n