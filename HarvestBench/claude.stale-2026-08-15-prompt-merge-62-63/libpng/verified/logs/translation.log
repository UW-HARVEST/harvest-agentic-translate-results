{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011Rw5yT6uU5QaMy67iB94Cg","type":"tool_result","content":"1\t//! Internal png_struct_def and png_info_def, mirroring pngstruct.h and\n2\t//! pnginfo.h for the enabled configuration (full libpng 1.6.59 feature set).\n3\t//!\n4\t//! These structures are opaque to applications, but libpng copies them by\n5\t//! value in a few places (e.g. png_destroy_png_struct), so we mirror the C\n6\t//! layout with `#[repr(C)]` and preserve field names/order.\n7\t#![allow(non_camel_case_types)]\n8\t\n9\tuse core::ffi::{c_int, c_uint};\n10\t\n11\tuse crate::cffi::z_stream;\n12\tuse crate::ptypes::*;\n13\t\n14\t/// glibc jmp_buf: struct __jmp_buf_tag[1], 200 bytes, 8-byte aligned.\n15\t#[repr(C)]\n16\t#[derive(Clone, Copy)]\n17\tpub struct jmp_buf {\n18\t    pub bytes: [u64; 25],\n19\t}\n20\t\n21\tpub const PNG_FILTER_VALUE_LAST_M1: usize = PNG_FILTER_VALUE_LAST - 1;\n22\t\n23\t#[repr(C)]\n24\tpub struct png_struct_def {\n25\t    // setjmp\n26\t    pub jmp_buf_local: jmp_buf,\n27\t    pub longjmp_fn: png_longjmp_ptr,\n28\t    pub jmp_buf_ptr: *mut jmp_buf,\n29\t    pub jmp_buf_size: usize,\n30\t\n31\t    pub error_fn: png_error_ptr,\n32\t    pub warning_fn: png_error_ptr,\n33\t    pub error_ptr: png_voidp,\n34\t    pub write_data_fn: png_rw_ptr,\n35\t    pub read_data_fn: png_rw_ptr,\n36\t    pub io_ptr: png_voidp,\n37\t\n38\t    pub read_user_transform_fn: png_user_transform_ptr,\n39\t    pub write_user_transform_fn: png_user_transform_ptr,\n40\t\n41\t    pub user_transform_ptr: png_voidp,\n42\t    pub user_transform_depth: png_byte,\n43\t    pub user_transform_channels: png_byte,\n44\t\n45\t    pub mode: png_uint_32,\n46\t    pub flags: png_uint_32,\n47\t    pub transformations: png_uint_32,\n48\t\n49\t    pub zowner: png_uint_32,\n50\t    pub zstream: z_stream,\n51\t\n52\t    // WRITE_SUPPORTED\n53\t    pub zbuffer_list: png_compression_bufferp,\n54\t    pub zbuffer_size: crate::cffi::uInt,\n55\t    pub z