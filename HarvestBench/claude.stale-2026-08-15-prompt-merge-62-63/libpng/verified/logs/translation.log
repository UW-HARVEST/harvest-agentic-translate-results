   png_ptr: png_structrp,\n    io_ptr: png_voidp,\n    write_data_fn: png_rw_ptr,\n    output_flush_fn: png_flush_ptr,\n) {\n    if png_ptr.is_null() {\n        return;\n    }\n\n    (*png_ptr).io_ptr = io_ptr;\n\n    if write_data_fn.is_some() {\n        (*png_ptr).write_data_fn = write_data_fn;\n    } else {\n        (*png_ptr).write_data_fn = Some(png_default_write_data);\n    }\n\n    if output_flush_fn.is_some() {\n        (*png_ptr).output_flush_fn = output_flush_fn;\n    } else {\n        (*png_ptr).output_flush_fn = Some(png_default_flush);\n    }\n\n    // It is an error to read while writing a png file.\n    if (*png_ptr).read_data_fn.is_some() {\n        (*png_ptr).read_data_fn = None;\n        png_warning(\n            png_ptr,\n            c\"Can't set both read_data_fn and write_data_fn in the same structure\".as_ptr(),\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1051,"cache_read_input_tokens":200945,"cache_creation":{"ephemeral_5m_input_tokens":1051,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a9e33088-46e8-41e9-a92d-60a8edf65823","uuid":"8bc6d1f8-4438-4138-9217-49cc89b0f8d9","timestamp":"2026-08-05T02:02:40.878Z"}
