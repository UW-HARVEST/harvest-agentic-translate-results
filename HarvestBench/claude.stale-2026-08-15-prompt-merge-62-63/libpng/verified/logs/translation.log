led */\n1525\t               errmsg = png_ptr->zstream.msg;\n1526\t         }\n1527\t\n1528\t         else\n1529\t            errmsg = \"bad compression method\"; /* or missing */\n1530\t      }\n1531\t\n1532\t      else\n1533\t         errmsg = \"bad keyword\";\n1534\t   }\n1535\t\n1536\t   /* Failure: the reason is in 'errmsg' */\n1537\t   if (finished == 0)\n1538\t      png_crc_finish(png_ptr, length);\n1539\t\n1540\t   if (errmsg != NULL) /* else already output */\n1541\t      png_chunk_benign_error(png_ptr, errmsg);\n1542\t\n1543\t   return handled_error;\n1544\t}\n1545\t#else\n1546\t#  define png_handle_iCCP NULL\n1547\t#endif /* READ_iCCP */\n1548\t\n1549\t#ifdef PNG_READ_sPLT_SUPPORTED\n1550\tstatic png_handle_result_code /* PRIVATE */\n1551\tpng_handle_sPLT(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1552\t/* Note: this does not properly handle chunks that are > 64K under DOS */\n1553\t{\n1554\t   png_bytep buffer;\n1555\t   png_bytep entry_start;\n1556\t   png_sPLT_t new_palette;\n1557\t   png_sPLT_entryp pp;\n1558\t   png_uint_32 data_length;\n1559\t   int entry_size, i;\n1560\t   png_uint_32 skip = 0;\n1561\t   png_uint_32 dl;\n1562\t   size_t max_dl;\n1563\t\n1564\t   png_debug(1, \"in png_handle_sPLT\");\n1565\t\n1566\t#ifdef PNG_USER_LIMITS_SUPPORTED\n1567\t   if (png_ptr->user_chunk_cache_max != 0)\n1568\t   {\n1569\t      if (png_ptr->user_chunk_cache_max == 1)\n1570\t      {\n1571\t         png_crc_finish(png_ptr, length);\n1572\t         return handled_error;\n1573\t      }\n1574\t\n1575\t      if (--png_ptr->user_chunk_cache_max == 1)\n1576\t      {\n1577\t         png_warning(png_ptr, \"No space in chunk cache for sPLT\");\n1578\t         png_crc_finish(png_ptr, length);\n1579\t         return handled_error;\n1580\t      }\n1581\t   }\n1582\t#endif\n1583\t\n1584\t   buffer = png_read_buffer(png_ptr, length+1);\n1585\t   if (buffer == NULL)\n1586\t   {\n1587\t      png_crc_finish(png_ptr, length);\n1588\t      png_chunk_benign_error(png_ptr, \"out of memory\");\n1589\t      return handled_error;\n1590\t   }\n1591\t\n1592\t\n1593\t   /* WARNING: this may break if size_t is less than 32 bits; it is assumed\n1594\t    * that the PNG_MAX_MALLOC_64K test is enabled in this case, but this is a\n1595\t    * potential breakage point if the types in pngconf.h aren't exactly right.\n1596\t    */\n1597\t   png_crc_read(png_ptr, buffer, length);\n1598\t\n1599\t   if (png_crc_finish(png_ptr, skip) != 0)\n1600\t      return handled_error;\n1601\t\n1602\t   buffer[length] = 0;\n1603\t\n1604\t   for (entry_start = buffer; *entry_start; entry_start++)\n1605\t      /* Empty loop to find end of name */ ;\n1606\t\n1607\t   ++entry_start;\n1608\t\n1609\t   /* A sample depth should follow the separator, and we should be on it  */\n1610\t   if (length < 2U || entry_start > buffer + (length - 2U))\n1611\t   {\n1612\t      png_warning(png_ptr, \"malformed sPLT chunk\");\n1613\t      return handled_error;\n1614\t   }\n1615\t\n1616\t   new_palette.depth = *entry_start++;\n1617\t   entry_size = (new_palette.depth == 8 ? 6 : 10);\n1618\t   /* This must fit in a png_uint_32 because it is derived from the original\n1619\t    * chunk data length.\n1620\t    */\n1621\t   data_length = length - (png_uint_32)(entry_start - buffer);\n1622\t\n1623\t   /* Integrity-check the data length */\n1624\t   if ((data_length % (unsigned int)entry_size) != 0)\n1625\t   {\n1626\t      png_warning(png_ptr, \"sPLT chunk has bad length\");\n1627\t      return handled_error;\n1628\t   }\n1629\t\n1630\t   dl = (png_uint_32)(data_length / (unsigned int)entry_size);\n1631\t   max_dl = PNG_SIZE_MAX / (sizeof (png_sPLT_entry));\n1632\t\n1633\t   if (dl > max_dl)\n1634\t   {\n1635\t      png_warning(png_ptr, \"sPLT chunk too long\");\n1636\t      return handled_error;\n1637\t   }\n1638\t\n1639\t   new_palette.nentries = (png_int_32)(data_length / (unsigned int)entry_size);\n1640\t\n1641\t   new_palette.entries = (png_sPLT_entryp)png_malloc_warn(png_ptr,\n1642\t       (png_alloc_size_t) new_palette.nentries * (sizeof (png_sPLT_entry)));\n1643\t\n1644\t   if (new_palette.entries == NULL)\n1645\t   {\n1646\t      png_warning(png_ptr, \"sPLT chunk requires too much memory\");\n1647\t      return handled_error;\n1648\t   }\n1649\t\n1650\t   for (i = 0; i < new_palette.nentries; i++)\n1651\t   {\n1652\t      pp = new_palette.entries + i;\n1653\t\n1654\t      if (new_palette.depth == 8)\n1655\t      {\n1656\t         pp->red = *entry_start++;\n1657\t         pp->green = *entry_start++;\n1658\t         pp->blue = *entry_start++;\n1659\t         pp->alpha = *entry_start++;\n1660\t      }\n1661\t\n1662\t      else\n1663\t      {\n1664\t         pp->red   = png_get_uint_16(entry_start); entry_start += 2;\n1665\t         pp->green = png_get_uint_16(entry_start); entry_start += 2;\n1666\t         pp->blue  = png_get_uint_16(entry_start); entry_start += 2;\n1667\t         pp->alpha = png_get_uint_16(entry_start); entry_start += 2;\n1668\t      }\n1669\t\n1670\t      pp->frequency = png_get_uint_16(entry_start); entry_start += 2;\n1671\t   }\n1672\t\n1673\t   /* Discard all chunk data except the name and stash that */\n1674\t   new_palette.name = (png_charp)buffer;\n1675\t\n1676\t   png_set_sPLT(png_ptr, info_ptr, &new_palette, 1);\n1677\t\n1678\t   png_free(png_ptr, new_palette.entries);\n1679\t   return handled_ok;\n1680\t}\n1681\t#else\n1682\t#  define png_handle_sPLT NULL\n1683\t#endif /* READ_sPLT */\n1684\t\n1685\t#ifdef PNG_READ_tRNS_SUPPORTED\n1686\tstatic png_handle_result_code /* PRIVATE */\n1687\tpng_handle_tRNS(png_structrp png_ptr, png_inforp info_ptr, png_uint_32 length)\n1688\t{\n1689\t   png_byte readbuf[PNG_MAX_PALETTE_LENGTH];\n1690\t\n1691\t   png_debug(1, \"in png_handle_tRNS\");\n1692\t\n1693\t   if (png_ptr->color_type == PNG_COLOR_TYPE_GRAY)\n1694\t   {\n1695\t      png_byte buf[2];\n1696\t\n1697\t      if (length != 2)\n1698\t      {\n1699\t         png_crc_finish(png_ptr, length);\n1700\t        