{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LLCZ3vxGuA7UY9PWWNyVnW","type":"tool_result","content":"1\t//! Translation of pngwio.c - functions for data output.\n2\tuse crate::prelude::*;\n3\t\n4\t/// Write the data to whatever output you are using.\n5\t#[unsafe(no_mangle)]\n6\tpub unsafe extern \"C\" fn png_write_data(\n7\t    png_ptr: png_structrp,\n8\t    data: png_const_bytep,\n9\t    length: size_t,\n10\t) {\n11\t    // NOTE: write_data_fn must not change the buffer!\n12\t    if (*png_ptr).write_data_fn.is_some() {\n13\t        ((*png_ptr).write_data_fn.unwrap())(png_ptr, data as png_bytep, length);\n14\t    } else {\n15\t        png_error(png_ptr, c\"Call to NULL write function\".as_ptr());\n16\t    }\n17\t}\n18\t\n19\t/// Default writer: writes to a C FILE* stored in io_ptr.\n20\t#[unsafe(no_mangle)]\n21\tpub unsafe extern \"C\" fn png_default_write_data(\n22\t    png_ptr: png_structp,\n23\t    data: png_bytep,\n24\t    length: size_t,\n25\t) {\n26\t    if png_ptr.is_null() {\n27\t        return;\n28\t    }\n29\t    let check = fwrite(\n30\t        data as *const c_void,\n31\t        1,\n32\t        length,\n33\t        (*png_ptr).io_ptr as *mut FILE,\n34\t    );\n35\t    if check != length {\n36\t        png_error(png_ptr, c\"Write Error\".as_ptr());\n37\t    }\n38\t}\n39\t\n40\t/// Flush pending output.\n41\t#[unsafe(no_mangle)]\n42\tpub unsafe extern \"C\" fn png_flush(png_ptr: png_structrp) {\n43\t    if (*png_ptr).output_flush_fn.is_some() {\n44\t        ((*png_ptr).output_flush_fn.unwrap())(png_ptr);\n45\t    }\n46\t}\n47\t\n48\t/// Default flush: flushes the C FILE*.\n49\t#[unsafe(no_mangle)]\n50\tpub unsafe extern \"C\" fn png_default_flush(png_ptr: png_structp) {\n51\t    if png_ptr.is_null() {\n52\t        return;\n53\t    }\n54\t    let io_ptr = (*png_ptr).io_ptr as *mut FILE;\n55\t    fflush(io_ptr);\n56\t}\n57\t\n58\t/// Set new output functions for libpng.\n59\t#[unsafe(no_mangle)]\n60\tpub unsafe extern \"C\" fn png_set_write_fn(\n61\t    png_ptr: png_structrp,\n62\t    io_ptr: png_voidp,\n63\t    write_data_fn: png_rw_ptr,\n64\t    output_flush_fn: png_flush_ptr,\n65\t) {\n66\t    if png_ptr.is_null() {\n67\t        return;\n68\t    }\n69\t\n70\t    (*png_ptr).io_ptr = io_ptr;\n71\t\n72\t    if write_data_fn.is_some() {\n73\t        (*png_ptr).write_data_fn = write_data_fn;\n74\t    } else {\n75\t        (*png_ptr).write_data_fn = Some(png_default_write_data);\n76\t    }\n77\t\n78\t    if output_flush_fn.is_some() {\n79\t        (*png_ptr).output_flush_fn = output_flush_fn;\n80\t    } else {\n81\t        (*png_ptr).output_flush_fn = Some(png_default_flush);\n82\t    }\n83\t\n84\t    // It is an error to read while writing a png file.\n85\t    if (*png_ptr).read_data_fn.is_some() {\n86\t        (*png_ptr).read_data_fn = None;\n87\t        png_warning(\n88\t            png_ptr,\n89\t            c\"Can't set both read_data_fn and write_data_fn in the same structure\".as_ptr(),\n90\t        );\n91\t    }\n92\t}\n93\t"}]},"parent_tool_use_id":"toolu_bdrk_01BYUDQyKJavFR3tTnP7b4tY","session_id":"a9e33088-46e8-41e9-a92d-60a8edf65823","uuid":"e4b051d9-4643-4c88-937c-1620917b3076","timestamp":"2026-08-05T02:07:40.536Z","subagent_type":"general-purpose","task_description":"Translate pngwrite.c to Rust"}
