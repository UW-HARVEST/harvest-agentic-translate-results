{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GCQHpdRbVhWA4G6R1UPRXY","type":"tool_result","content":"1\t//! Pure-Rust translation of libpng 1.6.59, preserving the complete public ABI.\n2\t//!\n3\t//! Every public C function is exported with `#[unsafe(no_mangle)] extern \"C\"`\n4\t//! and the exact C signature.  Internal libpng \"extern\" functions\n5\t//! (PNG_INTERNAL_FUNCTION) are also exported so that behaviour and the symbol\n6\t//! table match the reference C shared library.\n7\t//!\n8\t//! DEFLATE/INFLATE is delegated to the system zlib (linked via build.rs) so\n9\t//! that compressed output is byte-identical to the C reference build.\n10\t#![allow(non_camel_case_types)]\n11\t#![allow(non_snake_case)]\n12\t#![allow(non_upper_case_globals)]\n13\t#![allow(unused_parens)]\n14\t#![allow(unused_assignments)]\n15\t#![allow(unused_variables)]\n16\t#![allow(unused_mut)]\n17\t#![allow(dead_code)]\n18\t#![allow(clippy::all)]\n19\t\n20\t#[macro_use]\n21\tmod cffi;\n22\tpub mod consts;\n23\tpub mod helpers;\n24\tpub mod pstruct;\n25\tpub mod ptypes;\n26\t\n27\t// Translated libpng source modules.\n28\tmod png;\n29\tmod pngerror;\n30\tmod pngget;\n31\tmod pngmem;\n32\tmod pngpread;\n33\tmod pngread;\n34\tmod pngrio;\n35\tmod pngrtran;\n36\tmod pngrutil;\n37\tmod pngset;\n38\tmod pngtrans;\n39\tmod pngwio;\n40\tmod pngwrite;\n41\tmod pngwtran;\n42\tmod pngwutil;\n43\t\n44\t/// Re-exports of every translated module's functions so that cross-module\n45\t/// calls are ordinary (checked) Rust calls.  All the `png_*` functions are\n46\t/// defined once (with `#[unsafe(no_mangle)]`) in their home module and made\n47\t/// callable everywhere through this facade.\n48\tpub(crate) mod api {\n49\t    pub use crate::png::*;\n50\t    pub use crate::pngerror::*;\n51\t    pub use crate::pngget::*;\n52\t    pub use crate::pngmem::*;\n53\t    pub use crate::pngpread::*;\n54\t    pub use crate::pngread::*;\n55\t    pub use crate::pngrio::*;\n56\t    pub use