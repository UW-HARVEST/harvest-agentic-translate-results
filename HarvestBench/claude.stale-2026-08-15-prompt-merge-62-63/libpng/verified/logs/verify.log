{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TLHHB3knqNQtof8PhFAmir","type":"tool_result","content":"1\t//! Write-pipeline differential tests (CONFIGS.md rows W1..W12).\n2\t//!\n3\t//! Every test drives both the C reference `libpng.so` and the translated Rust\n4\t//! `liblibpng.so` through a complete write cycle and compares the produced PNG\n5\t//! byte stream (`Trace::out`) together with the whole event trace.\n6\t//!\n7\t//! All pixel data is produced by a deterministic PRNG seeded with a literal and\n8\t//! is generated *outside* the `diff` closure, so both libraries see byte\n9\t//! identical input.\n10\tmod support;\n11\t\n12\tuse std::ffi::c_int;\n13\tuse support::core::*;\n14\tuse support::*;\n15\t\n16\t// ---------------------------------------------------------------------------\n17\t// helpers\n18\t// ---------------------------------------------------------------------------\n19\t\n20\t/// The 15 legal (colour_type, bit_depth) combinations.\n21\tconst ALL_COMBOS: &[(c_int, c_int)] = &[\n22\t    (PNG_COLOR_TYPE_GRAY, 1),\n23\t    (PNG_COLOR_TYPE_GRAY, 2),\n24\t    (PNG_COLOR_TYPE_GRAY, 4),\n25\t    (PNG_COLOR_TYPE_GRAY, 8),\n26\t    (PNG_COLOR_TYPE_GRAY, 16),\n27\t    (PNG_COLOR_TYPE_RGB, 8),\n28\t    (PNG_COLOR_TYPE_RGB, 16),\n29\t    (PNG_COLOR_TYPE_PALETTE, 1),\n30\t    (PNG_COLOR_TYPE_PALETTE, 2),\n31\t    (PNG_COLOR_TYPE_PALETTE, 4),\n32\t    (PNG_COLOR_TYPE_PALETTE, 8),\n33\t    (PNG_COLOR_TYPE_GRAY_ALPHA, 8),\n34\t    (PNG_COLOR_TYPE_GRAY_ALPHA, 16),\n35\t    (PNG_COLOR_TYPE_RGB_ALPHA, 8),\n36\t    (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n37\t];\n38\t\n39\tfn rb(ct: c_int, bd: c_int, w: u32) -> usize {\n40\t    pngbuild::rowbytes(ct as u8, bd as u8, w)\n41\t}\n42\t\n43\t/// Store a (possibly sub-byte) palette index, MSB-first as PNG requires.\n44\tfn set_index(row: &mut [u8], x: usize, bd: c_int, idx: u8) {\n45\t    if bd == 8 {\n46\t        row[x] = idx;\n47\t        return;\n48\t    }\n49\t    let per = (8 / bd) as usize; // pixels per byte\n50\t    let byte = x / per;\n51\t    let shift = 8 - bd as usize * (x % per + 1);\n52\t    let mask = ((1u16 << bd) - 1) as u8;\n53\t    row[byte] = (row[byte] & !(mask << shift)) | ((idx & mask) << shift);\n54\t}\n55\t\n56\t/// `h` rows of pseudo-random content for the given image shape.  Palette rows\n57\t/// only ever contain indices `< npal`.  Each row has 8 bytes of slack.\n58\tfn make_rows(rng: &mut Rng, ct: c_int, bd: c_int, w: u32, h: u32, npal: u32) -> Vec<Vec<u8>> {\n59\t    let n = rb(ct, bd, w);\n60\t    (0..h)\n61\t        .map(|_| {\n62\t            let mut row = vec![0u8; n + 8];\n63\t            if ct == PNG_COLOR_TYPE_PALETTE {\n64\t                for x in 0..w as usize {\n65\t                    let idx = rng.below(npal) as u8;\n66\t                    set_index(&mut row, x, bd, idx);\n67\t                }\n68\t            } else {\n69\t                for i in 0..n {\n70\t                    row[i] = rng.byte();\n71\t                }\n72\t            }\n73\t            row\n74\t        })\n75\t        .collect()\n76\t}\n77\t\n78\t/// Rows of a fixed byte length (used where a write transform changes the number\n79\t/// of user-supplied channels or the user bit depth).\n80\tfn make_flat_rows(rng: &mut Rng, bytes: usize, h: u32) -> Vec<Vec<u8>> {\n81\t    (0..h)\n82\t        .map(|_| {\n83\t            let mut row = vec![0u8; bytes + 8];\n84\t            for i in 0..bytes {\n85\t                row[i] = rng.byte();\n86\t            }\n87\t            row\n88\t        })\n89\t        .collect()\n90\t}\n91\t\n92\t/// A compressible 8-bit RGB image: linear gradients plus a little noise.\n93\tfn gradient_rows(rng: &mut Rng, w: u32, h: u32) -> Vec<Vec<u8>> {\n94\t    let n = 3 * w as usize;\n95\t    (0..h)\n96\t        .map(|y| {\n97\t            let mut row = vec![0u8; n + 8];\n98\t            for x in 0..w as usize {\n99\t                let base = (x * 9 + y as usize * 5) as u8;\n100\t                row[3 * x] = base.wrapping_add(rng.byte() & 0x0f);\n101\t                row[3 * x + 1] = base.wrapping_mul(2).wrapping_add(rng.byte() & 0x07);\n102\t                row[3 * x + 2] = base.wrapping_add(0x40) ^ (rng.byte() & 0x03);\n103\t            }\n104\t            row\n105\t        })\n106\t        .collect()\n107\t}\n108\t\n109\tfn ptr_vec(rows: &mut [Vec<u8>]) -> Vec<*mut u8> {\n110\t    rows.iter_mut().map(|r| r.as_mut_ptr()).collect()\n111\t}\n112\t\n113\t/// CRC over every row buffer: libpng must not modify the caller's rows.\n114\tfn rowsum(rows: &[Vec<u8>]) -> u32 {\n115\t    let mut all = Vec::new();\n116\t    for r in rows {\n117\t        all.extend_from_slice(r);\n118\t    }\n119\t    pngbuild::crc32(&all)\n120\t}\n121\t\n122\t/// Sanity guard so a configuration can never silently do nothing: the driver\n123\t/// must have run to completion and emitted a PNG datastream.\n124\tfn checked(t: Trace) -> Trace {\n125\t    assert_eq!(t.rc, 0, \"unexpected longjmp out of the write driver\");\n126\t    assert!(\n127\t        t.out.starts_with(&pngbuild::SIG) && t.out.len() > 8,\n128\t        \"no PNG datastream produced (out.len={})\",\n129\t        t.out.len()\n130\t    );\n131\t    t\n132\t}\n133\t\n134\t/// `with_write` plus the sanity guard.\n135\tfn wwrite(lib: &Lib, body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n136\t    checked(with_write(lib, body))\n137\t}\n138\t\n139\tunsafe fn log_hdr(c: &Core, png: Png, info: Info) {\n140\t    log(format!(\n141\t        \"rowbytes={} channels={} cbuf={}\",\n142\t        (c.get_rowbytes)(png, info),\n143\t        (c.get_channels)(png, info),\n144\t        (c.get_compression_buffer_size)(png)\n145\t    ));\n146\t}\n147\t\n148\tunsafe fn maybe_plte(c: &Core, png: Png, info: Info, ct: c_int, pal: &[u8], npal: u32) {\n149\t    if ct == PNG_COLOR_TYPE_PALETTE {\n150\t        (c.set_PLTE)(png, info, pal.as_ptr(), npal as c_int);\n151\t    }\n152\t}\n153\t\n154\t/// A 256-entry random palette; only the first `3*npal` bytes are ever used.\n155\tfn full_palette(rng: &mut Rng) -> Vec<u8> {\n156\t    rng.bytes(3 * 256)\n157\t}\n158\t\n159\t/// One complete `png_write_row` cycle per repetition, compared between the two\n160\t/// libraries.  Handles Adam7 (`png_set_interlace_handling` + `height` rows per\n161\t/// pass) and the palette chunk, and optionally sets a row filter.\n162\t#[allow(clippy::too_many_arguments)]\n163\tfn row_case(\n164\t    tag: &str,\n165\t    ct: c_int,\n166\t    bd: c_int,\n167\t    w: u32,\n168\t    h: u32,\n169\t    il: c_int,\n170\t    filter: Option<(&str, c_int)>,\n171\t    reps: u32,\n172\t    rng: &mut Rng,\n173\t) {\n174\t    let npal = 1u32 << bd;\n175\t    for rep in 0..reps {\n176\t        let pal = full_palette(rng);\n177\t        let rows = make_rows(rng, ct, bd, w, h, npal);\n178\t        let fdesc = filter.map(|(n, _)| n).unwrap_or(\"-\");\n179\t        let label = format!(\"{tag} ct={ct} bd={bd} w={w} h={h} il={il} f={fdesc} rep={rep}\");\n180\t        diff(&label, |lib| {\n181\t            wwrite(lib, &mut |c, png, info| unsafe {\n182\t                (c.set_IHDR)(png, info, w, h, bd, ct, il, 0, 0);\n183\t                maybe_plte(c, png, info, ct, &pal, npal);\n184\t                if let Some((_, f)) = filter {\n185\t                    (c.set_filter)(png, PNG_FILTER_TYPE_BASE, f);\n186\t                }\n187\t                log_hdr(c, png, info);\n188\t                (c.write_info)(png, info);\n189\t                let passes = if il == PNG_INTERLACE_ADAM7 {\n190\t                    let p = (c.set_interlace_handling)(png);\n191\t                    log(format!(\"passes={p}\"));\n192\t                    p\n193\t                } else {\n194\t                    1\n195\t                };\n196\t                for _pass in 0..passes {\n197\t                    for r in &rows {\n198\t                        (c.write_row)(png, r.as_ptr());\n199\t                    }\n200\t                }\n201\t                (c.write_end)(png, info);\n202\t                log(format!(\"rowsum={:08x}\", rowsum(&rows)));\n203\t            })\n204\t        });\n205\t    }\n206\t}\n207\t\n208\t// ---------------------------------------------------------------------------\n209\t// W1 — png_write_row, GRAY 1/2/4/8/16, interlace NONE\n210\t// ---------------------------------------------------------------------------\n211\t\n212\t#[test]\n213\tfn w1_write_row_gray() {\n214\t    let mut rng = Rng::new(0x1101);\n215\t    let mut widths: Vec<u32> = (1..=17).collect();\n216\t    widths.push(33);\n217\t    for &bd in &[1, 2, 4, 8, 16] {\n218\t        for &w in &widths {\n219\t            for h in 1..=4u32 {\n220\t                row_case(\n221\t                    \"W1\",\n222\t                    PNG_COLOR_TYPE_GRAY,\n223\t                    bd,\n224\t                    w,\n225\t                    h,\n226\t                    PNG_INTERLACE_NONE,\n227\t                    None,\n228\t                    2,\n229\t                    &mut rng,\n230\t                );\n231\t            }\n232\t        }\n233\t    }\n234\t}\n235\t\n236\t// ---------------------------------------------------------------------------\n237\t// W2 — png_write_row, RGB 8/16\n238\t// ---------------------------------------------------------------------------\n239\t\n240\t#[test]\n241\tfn w2_write_row_rgb() {\n242\t    let mut rng = Rng::new(0x1202);\n243\t    for &bd in &[8, 16] {\n244\t        for w in 1..=9u32 {\n245\t            for h in 1..=3u32 {\n246\t                row_case(\n247\t                    \"W2\",\n248\t                    PNG_COLOR_TYPE_RGB,\n249\t                    bd,\n250\t                    w,\n251\t                    h,\n252\t                    PNG_INTERLACE_NONE,\n253\t                    None,\n254\t                    3,\n255\t                    &mut rng,\n256\t                );\n257\t            }\n258\t        }\n259\t    }\n260\t}\n261\t\n262\t// ---------------------------------------------------------------------------\n263\t// W3 — png_write_row, PALETTE 1/2/4/8 with random palette (+ optional tRNS)\n264\t// ---------------------------------------------------------------------------\n265\t\n266\t#[test]\n267\tfn w3_write_row_palette() {\n268\t    let mut rng = Rng::new(0x1303);\n269\t    for &bd in &[1, 2, 4, 8] {\n270\t        let full = 1u32 << bd;\n271\t        // Full palette (2**bd entries) and a shorter one; indices always stay\n272\t        // below num_palette (out-of-range indices are a Phase C row).\n273\t        for &npal in &[full, std::cmp::max(1, full * 3 / 4)] {\n274\t            for &w in &[1u32, 2, 3, 7, 17] {\n275\t                for &h in &[1u32, 3] {\n276\t                    for tv in 0..3 {\n277\t                        for rep in 0..2 {\n278\t                            let pal = full_palette(&mut rng);\n279\t                            let trns: Vec<u8> = match tv {\n280\t                                0 => Vec::new(),\n281\t                                1 => rng.bytes(npal as usize),\n282\t                                _ => rng.bytes(std::cmp::max(1, npal / 2) as usize),\n283\t                            };\n284\t                            let rows =\n285\t                                make_rows(&mut rng, PNG_COLOR_TYPE_PALETTE, bd, w, h, npal);\n286\t                            let label = format!(\n287\t                                \"W3 bd={bd} npal={npal} w={w} h={h} ntrns={} rep={rep}\",\n288\t                                trns.len()\n289\t                            );\n290\t                            diff(&label, |lib| {\n291\t                                wwrite(lib, &mut |c, png, info| unsafe {\n292\t                                    (c.set_IHDR)(\n293\t                                        png,\n294\t                                        info,\n295\t                                        w,\n296\t                                        h,\n297\t                                        bd,\n298\t                                        PNG_COLOR_TYPE_PALETTE,\n299\t                                        PNG_INTERLACE_NONE,\n300\t                                        0,\n301\t                                        0,\n302\t                                    );\n303\t                                    (c.set_PLTE)(png, info, pal.as_ptr(), npal as c_int);\n304\t                                    if !trns.is_empty() {\n305\t                                        (c.set_tRNS)(\n306\t                                            png,\n307\t                                            info,\n308\t                                            trns.as_ptr(),\n309\t                                            trns.len() as c_int,\n310\t                                            std::ptr::null(),\n311\t                                        );\n312\t                                    }\n313\t                                    log_hdr(c, png, info);\n314\t                                    log(format!(\n315\t                                        \"valid.PLTE={} valid.tRNS={}\",\n316\t                                        (c.get_valid)(png, info, PNG_INFO_PLTE),\n317\t                                        (c.get_valid)(png, info, PNG_INFO_tRNS)\n318\t                                    ));\n319\t                                    (c.write_info)(png, info);\n320\t                                    for r in &rows {\n321\t                                        (c.write_row)(png, r.as_ptr());\n322\t                                    }\n323\t                                    (c.write_end)(png, info);\n324\t                                    log(format!(\"rowsum={:08x}\", rowsum(&rows)));\n325\t                                })\n326\t                            });\n327\t                        }\n328\t                    }\n329\t                }\n330\t            }\n331\t        }\n332\t    }\n333\t}\n334\t\n335\t// ---------------------------------------------------------------------------\n336\t// W4 — png_write_row, GRAY_ALPHA 8/16\n337\t// ---------------------------------------------------------------------------\n338\t\n339\t#[test]\n340\tfn w4_write_row_gray_alpha() {\n341\t    let mut rng = Rng::new(0x1404);\n342\t    for &bd in &[8, 16] {\n343\t        for w in 1..=9u32 {\n344\t            for h in 1..=3u32 {\n345\t                row_case(\n346\t                    \"W4\",\n347\t                    PNG_COLOR_TYPE_GRAY_ALPHA,\n348\t                    bd,\n349\t                    w,\n350\t                    h,\n351\t                    PNG_INTERLACE_NONE,\n352\t                    None,\n353\t                    3,\n354\t                    &mut rng,\n355\t                );\n356\t            }\n357\t        }\n358\t    }\n359\t}\n360\t\n361\t// ---------------------------------------------------------------------------\n362\t// W5 — png_write_row, RGB_ALPHA 8/16\n363\t// ---------------------------------------------------------------------------\n364\t\n365\t#[test]\n366\tfn w5_write_row_rgb_alpha() {\n367\t    let mut rng = Rng::new(0x1505);\n368\t    for &bd in &[8, 16] {\n369\t        for w in 1..=9u32 {\n370\t            for h in 1..=3u32 {\n371\t                row_case(\n372\t                    \"W5\",\n373\t                    PNG_COLOR_TYPE_RGB_ALPHA,\n374\t                    bd,\n375\t                    w,\n376\t                    h,\n377\t                    PNG_INTERLACE_NONE,\n378\t                    None,\n379\t                    3,\n380\t                    &mut rng,\n381\t                );\n382\t            }\n383\t        }\n384\t    }\n385\t}\n386\t\n387\t// ---------------------------------------------------------------------------\n388\t// W6 — png_write_row, all 15 combos, interlace ADAM7\n389\t// ---------------------------------------------------------------------------\n390\t\n391\t#[test]\n392\tfn w6_write_row_adam7() {\n393\t    let mut rng = Rng::new(0x1606);\n394\t    for &(ct, bd) in ALL_COMBOS {\n395\t        for &w in &[1u32, 2, 5, 9, 17] {\n396\t            for &h in &[1u32, 2, 5, 9] {\n397\t                row_case(\n398\t                    \"W6\",\n399\t                    ct,\n400\t                    bd,\n401\t                    w,\n402\t                    h,\n403\t                    PNG_INTERLACE_ADAM7,\n404\t                    None,\n405\t                    2,\n406\t                    &mut rng,\n407\t                );\n408\t            }\n409\t        }\n410\t    }\n411\t}\n412\t\n413\t// ---------------------------------------------------------------------------\n414\t// W7 — png_write_rows with num_rows = 1 / height / mixed, interlace 0 and 1\n415\t// ---------------------------------------------------------------------------\n416\t\n417\t#[test]\n418\tfn w7_write_rows() {\n419\t    let mut rng = Rng::new(0x1707);\n420\t    let w = 7u32;\n421\t    let h = 5u32;\n422\t    for &(ct, bd) in ALL_COMBOS {\n423\t        let npal = 1u32 << bd;\n424\t        for &il in &[PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n425\t            for mode in 0..3 {\n426\t                for rep in 0..2 {\n427\t                    let pal = full_palette(&mut rng);\n428\t                    let mut rows = make_rows(&mut rng, ct, bd, w, h, npal);\n429\t                    let mut ptrs = ptr_vec(&mut rows);\n430\t                    let label = format!(\"W7 ct={ct} bd={bd} il={il} mode={mode} rep={rep}\");\n431\t                    diff(&label, |lib| {\n432\t                        wwrite(lib, &mut |c, png, info| unsafe {\n433\t                            (c.set_IHDR)(png, info, w, h, bd, ct, il, 0, 0);\n434\t                            maybe_plte(c, png, info, ct, &pal, npal);\n435\t                            log_hdr(c, png, info);\n436\t                            (c.write_info)(png, info);\n437\t                            let passes = if il == PNG_INTERLACE_ADAM7 {\n438\t                                let p = (c.set_interlace_handling)(png);\n439\t                                log(format!(\"passes={p}\"));\n440\t                                p\n441\t                            } else {\n442\t                                1\n443\t                            };\n444\t                            let base = ptrs.as_mut_ptr();\n445\t                            for _pass in 0..passes {\n446\t                                match mode {\n447\t                                    // one row per call\n448\t                                    0 => {\n449\t                                        for i in 0..h {\n450\t                                            (c.write_rows)(png, base.add(i as usize), 1);\n451\t                                        }\n452\t                                    }\n453\t                                    // the whole image in one call\n454\t                                    1 => (c.write_rows)(png, base, h),\n455\t                                    // 2 rows, then the rest\n456\t                                    _ => {\n457\t                                        (c.write_rows)(png, base, 2);\n458\t                                        (c.write_rows)(png, base.add(2), h - 2);\n459\t                                    }\n460\t                                }\n461\t                            }\n462\t                            (c.write_end)(png, info);\n463\t                            log(format!(\"rowsum={:08x}\", rowsum(&rows)));\n464\t                        })\n465\t                    });\n466\t                }\n467\t            }\n468\t        }\n469\t    }\n470\t}\n471\t\n472\t// ---------------------------------------------------------------------------\n473\t// W8 — png_write_image, all combos × interlace 0/1\n474\t// ---------------------------------------------------------------------------\n475\t\n476\t#[test]\n477\tfn w8_write_image() {\n478\t    let mut rng = Rng::new(0x1808);\n479\t    for &(ct, bd) in ALL_COMBOS {\n480\t        let npal = 1u32 << bd;\n481\t        for &(w, h) in &[(1u32, 1u32), (2, 3), (9, 6), (17, 9)] {\n482\t            for &il in &[PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n483\t                for rep in 0..2 {\n484\t                    let pal = full_palette(&mut rng);\n485\t                    let mut rows = make_rows(&mut rng, ct, bd, w, h, npal);\n486\t                    let mut ptrs = ptr_vec(&mut rows);\n487\t                    let label = format!(\"W8 ct={ct} bd={bd} w={w} h={h} il={il} rep={rep}\");\n488\t                    diff(&label, |lib| {\n489\t                        wwrite(lib, &mut |c, png, info| unsafe {\n490\t                            (c.set_IHDR)(png, info, w, h, bd, ct, il, 0, 0);\n491\t                            maybe_plte(c, png, info, ct, &pal, npal);\n492\t                            log_hdr(c, png, info);\n493\t                            (c.write_info)(png, info);\n494\t                            (c.write_image)(png, ptrs.as_mut_ptr());\n495\t                            (c.write_end)(png, info);\n496\t                            log(format!(\"rowsum={:08x}\", rowsum(&rows)));\n497\t                        })\n498\t                    });\n499\t                }\n500\t            }\n501\t        }\n502\t    }\n503\t}\n504\t\n505\t// ---------------------------------------------------------------------------\n506\t// W9 — png_write_png with png_set_rows and the write transform bits\n507\t// ---------------------------------------------------------------------------\n508\t\n509\t/// The colour types each bit that `png_write_png` acts on is legal for on the\n510\t/// write side (see `png_write_png` in `c_src/src/pngwrite.c` and the\n511\t/// `png_set_*` implementations in `c_src/src/pngtrans.c`).\n512\tfn w9_bit_combos(bit: c_int) -> Vec<(c_int, c_int)> {\n513\t    let gray_low = vec![\n514\t        (PNG_COLOR_TYPE_GRAY, 1),\n515\t        (PNG_COLOR_TYPE_GRAY, 2),\n516\t        (PNG_COLOR_TYPE_GRAY, 4),\n517\t        (PNG_COLOR_TYPE_PALETTE, 1),\n518\t        (PNG_COLOR_TYPE_PALETTE, 2),\n519\t        (PNG_COLOR_TYPE_PALETTE, 4),\n520\t    ];\n521\t    let alpha = vec![\n522\t        (PNG_COLOR_TYPE_GRAY_ALPHA, 8),\n523\t        (PNG_COLOR_TYPE_GRAY_ALPHA, 16),\n524\t        (PNG_COLOR_TYPE_RGB_ALPHA, 8),\n525\t        (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n526\t    ];\n527\t    let colour = vec![\n528\t        (PNG_COLOR_TYPE_RGB, 8),\n529\t        (PNG_COLOR_TYPE_RGB, 16),\n530\t        (PNG_COLOR_TYPE_RGB_ALPHA, 8),\n531\t        (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n532\t    ];\n533\t    // png_set_filler on write only accepts RGB (usr_channels 4) and GRAY with\n534\t    // bit depth >= 8 (usr_channels 2); anything else is an app error.\n535\t    let filler = vec![\n536\t        (PNG_COLOR_TYPE_GRAY, 8),\n537\t        (PNG_COLOR_TYPE_GRAY, 16),\n538\t        (PNG_COLOR_TYPE_RGB, 8),\n539\t        (PNG_COLOR_TYPE_RGB, 16),\n540\t    ];\n541\t    let d16 = vec![\n542\t        (PNG_COLOR_TYPE_GRAY, 16),\n543\t        (PNG_COLOR_TYPE_RGB, 16),\n544\t        (PNG_COLOR_TYPE_GRAY_ALPHA, 16),\n545\t        (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n546\t    ];\n547\t    match bit {\n548\t        PNG_TRANSFORM_IDENTITY => ALL_COMBOS.to_vec(),\n549\t        PNG_TRANSFORM_PACKING | PNG_TRANSFORM_PACKSWAP => gray_low,\n550\t        PNG_TRANSFORM_INVERT_MONO => vec![\n551\t            (PNG_COLOR_TYPE_GRAY, 1),\n552\t            (PNG_COLOR_TYPE_GRAY, 2),\n553\t            (PNG_COLOR_TYPE_GRAY, 4),\n554\t            (PNG_COLOR_TYPE_GRAY, 8),\n555\t            (PNG_COLOR_TYPE_GRAY, 16),\n556\t            (PNG_COLOR_TYPE_GRAY_ALPHA, 8),\n557\t            (PNG_COLOR_TYPE_GRAY_ALPHA, 16),\n558\t        ],\n559\t        PNG_TRANSFORM_SHIFT => ALL_COMBOS.to_vec(),\n560\t        PNG_TRANSFORM_BGR => colour,\n561\t        PNG_TRANSFORM_SWAP_ALPHA | PNG_TRANSFORM_INVERT_ALPHA => alpha,\n562\t        PNG_TRANSFORM_SWAP_ENDIAN => d16,\n563\t        PNG_TRANSFORM_STRIP_FILLER_BEFORE | PNG_TRANSFORM_STRIP_FILLER_AFTER => filler,\n564\t        _ => Vec::new(),\n565\t    }\n566\t}\n567\t\n568\tconst W9_BITS: &[(&str, c_int)] = &[\n569\t    (\"IDENTITY\", PNG_TRANSFORM_IDENTITY),\n570\t    (\"PACKING\", PNG_TRANSFORM_PACKING),\n571\t    (\"PACKSWAP\", PNG_TRANSFORM_PACKSWAP),\n572\t    (\"INVERT_MONO\", PNG_TRANSFORM_INVERT_MONO),\n573\t    (\"SHIFT\", PNG_TRANSFORM_SHIFT),\n574\t    (\"BGR\", PNG_TRANSFORM_BGR),\n575\t    (\"SWAP_ALPHA\", PNG_TRANSFORM_SWAP_ALPHA),\n576\t    (\"SWAP_ENDIAN\", PNG_TRANSFORM_SWAP_ENDIAN),\n577\t    (\"INVERT_ALPHA\", PNG_TRANSFORM_INVERT_ALPHA),\n578\t    (\"STRIP_FILLER_BEFORE\", PNG_TRANSFORM_STRIP_FILLER_BEFORE),\n579\t    (\"STRIP_FILLER_AFTER\", PNG_TRANSFORM_STRIP_FILLER_AFTER),\n580\t];\n581\t\n582\t/// Every write transform bit that is legal for `(ct, bd)`.\n583\tfn w9_legal_bits(ct: c_int, bd: c_int) -> Vec<c_int> {\n584\t    W9_BITS\n585\t        .iter()\n586\t        .filter(|(_, b)| *b != PNG_TRANSFORM_IDENTITY)\n587\t        .filter(|(_, b)| w9_bit_combos(*b).contains(&(ct, bd)))\n588\t        .map(|(_, b)| *b)\n589\t        .collect()\n590\t}\n591\t\n592\tfn w9_run(label: &str, ct: c_int, bd: c_int, il: c_int, transforms: c_int, rng: &mut Rng) {\n593\t    let w = 9u32;\n594\t    let h = 6u32;\n595\t    let npal = 1u32 << bd;\n596\t    let pal = full_palette(rng);\n597\t    // Widest row any write transform can ask for: 4 channels x 16 bit.\n598\t    let mut rows = make_flat_rows(rng, w as usize * 8, h);\n599\t    if ct == PNG_COLOR_TYPE_PALETTE {\n600\t        for row in rows.iter_mut() {\n601\t            // Packed indices (no PNG_TRANSFORM_PACKING) ...\n602\t            for x in 0..w as usize {\n603\t                let idx = rng.below(npal) as u8;\n604\t                set_index(row, x, bd, idx);\n605\t            }\n606\t            // ... and, for the low bit depths, one legal index per byte so the\n607\t            // same buffer is also valid under PNG_TRANSFORM_PACKING.\n608\t            if bd < 8 && (transforms & PNG_TRANSFORM_PACKING) != 0 {\n609\t                for x in 0..w as usize {\n610\t                    row[x] = rng.below(npal) as u8;\n611\t                }\n612\t            }\n613\t        }\n614\t    }\n615\t    let sb = std::cmp::max(1, bd - 1) as u8;\n616\t    let sbit = PngColor8 {\n617\t        red: sb,\n618\t        green: sb,\n619\t        blue: sb,\n620\t        gray: sb,\n621\t        alpha: sb,\n622\t    };\n623\t    let mut ptrs = ptr_vec(&mut rows);\n624\t    diff(label, |lib| {\n625\t        wwrite(lib, &mut |c, png, info| unsafe {\n626\t            (c.set_IHDR)(png, info, w, h, bd, ct, il, 0, 0);\n627\t            maybe_plte(c, png, info, ct, &pal, npal);\n628\t            // png_write_png only honours PNG_TRANSFORM_SHIFT when sBIT is valid.\n629\t            if transforms & PNG_TRANSFORM_SHIFT != 0 {\n630\t                (c.set_sBIT)(png, info, &sbit as *const PngColor8 as *const u8);\n631\t            }\n632\t            (c.set_rows)(png, info, ptrs.as_mut_ptr());\n633\t            log(format!(\n634\t                \"valid.IDAT={} rows_set={} valid.sBIT={}\",\n635\t                (c.get_valid)(png, info, PNG_INFO_IDAT),\n636\t                if (c.get_rows)(png, info).is_null() { 0 } else { 1 },\n637\t                (c.get_valid)(png, info, PNG_INFO_sBIT)\n638\t            ));\n639\t            log_hdr(c, png, info);\n640\t            (c.write_png)(png, info, transforms, std::ptr::null_mut());\n641\t            log_hdr(c, png, info);\n642\t            log(format!(\"rowsum={:08x}\", rowsum(&rows)));\n643\t        })\n644\t    });\n645\t}\n646\t\n647\t#[test]\n648\tfn w9_write_png_transforms() {\n649\t    let mut rng = Rng::new(0x1909);\n650\t\n651\t    // (a) every honoured bit on its own, on every colour type it applies to.\n652\t    for &(name, bit) in W9_BITS {\n653\t        for (ct, bd) in w9_bit_combos(bit) {\n654\t            for &il in &[PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n655\t                for rep in 0..2 {\n656\t                    let label = format!(\"W9 {name} ct={ct} bd={bd} il={il} rep={rep}\");\n657\t                    w9_run(&label, ct, bd, il, bit, &mut rng);\n658\t                }\n659\t            }\n660\t        }\n661\t    }\n662\t\n663\t    // (b) six seeded random combinations of the legal bits per colour type.\n664\t    for &(ct, bd) in ALL_COMBOS {\n665\t        let legal = w9_legal_bits(ct, bd);\n666\t        for k in 0..6 {\n667\t            let mut mask = 0;\n668\t            for &b in &legal {\n669\t                if rng.next_u32() & 1 != 0 {\n670\t                    mask |= b;\n671\t                }\n672\t            }\n673\t            // BEFORE+AFTER together is an app error (a Phase C row).\n674\t            if mask & PNG_TRANSFORM_STRIP_FILLER_AFTER != 0 {\n675\t                mask &= !PNG_TRANSFORM_STRIP_FILLER_BEFORE;\n676\t            }\n677\t            let il = if rng.next_u32() & 1 != 0 {\n678\t                PNG_INTERLACE_ADAM7\n679\t            } else {\n680\t                PNG_INTERLACE_NONE\n681\t            };\n682\t            let label = format!(\"W9 rand{k} ct={ct} bd={bd} il={il} mask={mask:#06x}\");\n683\t            w9_run(&label, ct, bd, il, mask, &mut rng);\n684\t        }\n685\t    }\n686\t}\n687\t\n688\t// ---------------------------------------------------------------------------\n689\t// W10 — png_set_filter, exercising png_write_find_filter's heuristic\n690\t// ---------------------------------------------------------------------------\n691\t\n692\t#[test]\n693\tfn w10_set_filter() {\n694\t    let mut rng = Rng::new(0x2010);\n695\t    let filters: &[(&str, c_int)] = &[\n696\t        (\"NO_FILTERS\", PNG_NO_FILTERS),\n697\t        (\"NONE\", PNG_FILTER_NONE),\n698\t        (\"SUB\", PNG_FILTER_SUB),\n699\t        (\"UP\", PNG_FILTER_UP),\n700\t        (\"AVG\", PNG_FILTER_AVG),\n701\t        (\"PAETH\", PNG_FILTER_PAETH),\n702\t        (\"ALL\", PNG_ALL_FILTERS),\n703\t        (\"NONE|SUB\", PNG_FILTER_NONE | PNG_FILTER_SUB),\n704\t        (\"SUB|PAETH\", PNG_FILTER_SUB | PNG_FILTER_PAETH),\n705\t        (\n706\t            \"UP|AVG|PAETH\",\n707\t            PNG_FILTER_UP | PNG_FILTER_AVG | PNG_FILTER_PAETH,\n708\t        ),\n709\t    ];\n710\t    let combos: &[(c_int, c_int)] = &[\n711\t        (PNG_COLOR_TYPE_GRAY, 1),\n712\t        (PNG_COLOR_TYPE_GRAY, 4),\n713\t        (PNG_COLOR_TYPE_GRAY, 8),\n714\t        (PNG_COLOR_TYPE_GRAY, 16),\n715\t        (PNG_COLOR_TYPE_RGB, 8),\n716\t        (PNG_COLOR_TYPE_RGB, 16),\n717\t        (PNG_COLOR_TYPE_PALETTE, 4),\n718\t        (PNG_COLOR_TYPE_PALETTE, 8),\n719\t        (PNG_COLOR_TYPE_GRAY_ALPHA, 8),\n720\t        (PNG_COLOR_TYPE_RGB_ALPHA, 8),\n721\t        (PNG_COLOR_TYPE_RGB_ALPHA, 16),\n722\t    ];\n723\t    // 13 x 9 gives the heuristic >= 8 rows to choose different filters from.\n724\t    for &(ct, bd) in combos {\n725\t        for &f in filters {\n726\t            for &il in &[PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n727\t                row_case(\"W10\", ct, bd, 13, 9, il, Some(f), 2, &mut rng);\n728\t            }\n729\t        }\n730\t    }\n731\t}\n732\t\n733\t// ---------------------------------------------------------------------------\n734\t// W11 — compression level × strategy\n735\t// ---------------------------------------------------------------------------\n736\t\n737\t#[test]\n738\tfn w11_compression_level_strategy() {\n739\t    let mut rng = Rng::new(0x2111);\n740\t    let w = 16u32;\n741\t    let h = 20u32;\n742\t    let images: Vec<Vec<Vec<u8>>> = (0..2).map(|_| gradient_rows(&mut rng, w, h)).collect();\n743\t    for (n, rows) in images.iter().enumerate() {\n744\t        for &level in &[0, 1, 6, 9] {\n745\t            for strategy in 0..=4 {\n746\t                let label = format!(\"W11 img={n} level={level} strategy={strategy}\");\n747\t                diff(&label, |lib| {\n748\t                    wwrite(lib, &mut |c, png, info| unsafe {\n749\t                        (c.set_IHDR)(\n750\t                            png,\n751\t                            info,\n752\t                            w,\n753\t                            h,\n754\t                            8,\n755\t                            PNG_COLOR_TYPE_RGB,\n756\t                            PNG_INTERLACE_NONE,\n757\t                            0,\n758\t                            0,\n759\t                        );\n760\t                        (c.set_compression_level)(png, level);\n761\t                        (c.set_compression_strategy)(png, strategy);\n762\t                        log_hdr(c, png, info);\n763\t                        (c.write_info)(png, info);\n764\t                        for r in rows {\n765\t                            (c.write_row)(png, r.as_ptr());\n766\t                        }\n767\t                        (c.write_end)(png, info);\n768\t                        log(format!(\"rowsum={:08x}\", rowsum(rows)));\n769\t                    })\n770\t                });\n771\t            }\n772\t        }\n773\t    }\n774\t}\n775\t\n776\t// ---------------------------------------------------------------------------\n777\t// W12 — compression window bits × mem level\n778\t// ---------------------------------------------------------------------------\n779\t\n780\t#[test]\n781\tfn w12_compression_window_mem() {\n782\t    let mut rng = Rng::new(0x2212);\n783\t    let w = 16u32;\n784\t    let h = 20u32;\n785\t    let images: Vec<Vec<Vec<u8>>> = (0..2).map(|_| gradient_rows(&mut rng, w, h)).collect();\n786\t    for (n, rows) in images.iter().enumerate() {\n787\t        // 7 and 16 are out of range: the C clamps them and emits a warning that\n788\t        // must be reproduced verbatim.\n789\t        for &wb in &[8, 9, 10, 15, 7, 16] {\n790\t            for &ml in &[1, 4, 8, 9] {\n791\t                let label = format!(\"W12 img={n} window_bits={wb} mem_level={ml}\");\n792\t                diff(&label, |lib| {\n793\t                    let t = wwrite(lib, &mut |c, png, info| unsafe {\n794\t                        (c.set_IHDR)(\n795\t                            png,\n796\t                            info,\n797\t                            w,\n798\t                            h,\n799\t                            8,\n800\t                            PNG_COLOR_TYPE_RGB,\n801\t                            PNG_INTERLACE_NONE,\n802\t                            0,\n803\t                            0,\n804\t                        );\n805\t                        (c.set_compression_window_bits)(png, wb);\n806\t                        (c.set_compression_mem_level)(png, ml);\n807\t                        log_hdr(c, png, info);\n808\t                        (c.write_info)(png, info);\n809\t                        for r in rows {\n810\t                            (c.write_row)(png, r.as_ptr());\n811\t                        }\n812\t                        (c.write_end)(png, info);\n813\t                        log(format!(\"rowsum={:08x}\", rowsum(rows)));\n814\t                    });\n815\t                    // The clamp warning must be produced by both libraries.\n816\t                    let warned = t.lines.iter().any(|l| l.starts_with(\"WARNING(\"));\n817\t                    assert_eq!(\n818\t                        warned,\n819\t                        !(8..=15).contains(&wb),\n820\t                        \"[{}] window_bits={wb}: warned={warned}\",\n821\t                        lib.tag\n822\t                    );\n823\t                    t\n824\t                });\n825\t            }\n826\t        }\n827\t    }\n828\t}\n829\t"}]},"parent_tool_use_id":"toolu_bdrk_011enmkBR3gAH2z6ofBWmEsy","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"3d1e58f2-0cc2-44af-812d-263153d47fdc","timestamp":"2026-08-14T17:11:30.613Z","subagent_type":"general-purpose","task_description":"Phase C write-side error tests"}
