n679\t    }\n680\t    // bKGD\n681\t    let mut bk: *mut u8 = std::ptr::null_mut();\n682\t    let r = (c.get_bKGD)(png, info, &mut bk);\n683\t    log(format!(\"bKGD rc={r}\"));\n684\t    if r != 0 && !bk.is_null() {\n685\t        let v = *(bk as *const PngColor16);\n686\t        log(format!(\"bKGD v={v:?}\"));\n687\t    }\n688\t    // hIST\n689\t    let mut hi: *mut u16 = std::ptr::null_mut();\n690\t    let r = (c.get_hIST)(png, info, &mut hi);\n691\t    log(format!(\"hIST rc={r}\"));\n692\t    if r != 0 && !hi.is_null() && npal > 0 {\n693\t        let s = std::slice::from_raw_parts(hi, npal as usize);\n694\t        log(format!(\"hIST v={s:?}\"));\n695\t    }\n696\t    // pHYs\n697\t    let (mut px, mut py, mut unit) = (0u32, 0u32, 0);\n698\t    log(format!(\n699\t        \"pHYs rc={} x={px} y={py} unit={unit}\",\n700\t        (c.get_pHYs)(png, info, &mut px, &mut py, &mut unit)\n701\t    ));\n702\t    // oFFs\n703\t    let (mut ox, mut oy, mut ounit) = (0i32, 0i32, 0);\n704\t    log(format!(\n705\t        \"oFFs rc={} x={ox} y={oy} unit={ounit}\",\n706\t        (c.get_oFFs)(png, info, &mut ox, &mut oy, &mut ounit)\n707\t    ));\n708\t    // tIME\n709\t    let mut tp: *mut u8 = std::ptr::null_mut();\n710\t    let r = (c.get_tIME)(png, info, &mut tp);\n711\t    log(format!(\"tIME rc={r}\"));\n712\t    if r != 0 && !tp.is_null() {\n713\t        let v = *(tp as *const PngTime);\n714\t        log(format!(\"tIME v={v:?}\"));\n715\t    }\n716\t    // pCAL\n717\t    let mut purpose: *mut c_char = std::ptr::null_mut();\n718\t    let (mut x0, mut x1) = (0i32, 0i32);\n719\t    let (mut etype, mut nparams) = (0, 0);\n720\t    let mut units: *mut c_char = std::ptr::null_mut();\n721\t    let mut params: *mut *mut c_char = std::ptr::null_mut();\n722\t    let r = (c.get_pCAL)(\n723\t        png,\n724\t        info,\n725\t        &mut purpose,\n726\t        &mut x0,\n727\t        &mut x1,\n728\t        &mut etype,\n729\t        &mut nparams,\n730\t        &mut units,\n731\t        