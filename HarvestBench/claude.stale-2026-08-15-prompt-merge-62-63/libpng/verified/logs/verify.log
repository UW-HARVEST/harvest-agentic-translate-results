{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TFD73RqXyraNBVGvJBqarF","type":"tool_result","content":"446\t// ---------------------------------------------------------------------------\n447\t// W14 — png_set_flush + png_write_flush\n448\t// ---------------------------------------------------------------------------\n449\t//\n450\t// `png_write_filtered_row` increments `flush_rows` and calls\n451\t// `png_write_flush` once `flush_rows >= flush_dist` (with flush_dist > 0).\n452\t// `png_write_flush` is a no-op once `row_number >= num_rows`.\n453\t// The harness `cb_flush` logs `FLUSH`, and `out.len` is logged after every row,\n454\t// so the flush ordering relative to the produced bytes is compared.\n455\t\n456\t#[test]\n457\tfn w14_flush() {\n458\t    let mut rng = Rng::new(0x2414);\n459\t    let w = 14u32;\n460\t    let h = 12u32;\n461\t    let images: Vec<(&str, Vec<Vec<u8>>)> = vec![\n462\t        (\"grad\", gradient_rows(&mut rng, w, h)),\n463\t        (\"noise\", noise_rows(&mut rng, w, h)),\n464\t    ];\n465\t    for (name, rows) in &images {\n466\t        for &n in &[0i32, 1, 2, 3, 7] {\n467\t            // mode 0: automatic flushing only\n468\t            // mode 1: + explicit png_write_flush every 3rd row\n469\t            // mode 2: + explicit png_write_flush before the first and after the\n470\t            //           last row (the latter is the no-op path)\n471\t            // mode 3: png_set_flush called again (to 0) half way through\n472\t            for mode in 0..4 {\n473\t                for &il in &[PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n474\t                    let label = format!(\"W14 img={name} n={n} mode={mode} il={il}\");\n475\t                    // Two png_write_flush calls with no row data in between make\n476\t                    // zlib return Z_BUF_ERROR, which libpng turns into a fatal\n477\t                    // png_error (\"buffer error\").  That happens for the explicit\n478\t                    // flush modes on interlaced images (most passes skip most\n479\t                    // rows), so a longjmp is tolerated there; the purely\n480\t                    // automatic modes must always run to completion.\n481\t                    let soft = mode == 1 || mode == 2;\n482\t                    diff(&label, |lib| {\n483\t                        let mut body = |c: &Core, png: Png, info: Info| unsafe {\n484\t                            (c.set_IHDR)(png, info, w, h, 8, PNG_COLOR_TYPE_RGB, il, 0, 0);\n485\t                            (c.set_flush)(png, n);\n486\t                            log_hdr(c, png, info);\n487\t                            (c.write_info)(png, info);\n488\t                            let passes = if il == PNG_INTERLACE_ADAM7 {\n489\t                                let p = (c.set_interlace_handling)(png);\n490\t                                log(format!(\"passes={p}\"));\n491\t                                p\n492\t                            } else {\n493\t                                1\n494\t                            };\n495\t                            if mode == 2 {\n496\t                                (c.write_flush)(png);\n497\t                                log(format!(\"pre out={}\", outlen()));\n498\t                            }\n499\t                            for pass in 0..passes {\n500\t                                for (i, r) in rows.iter().enumerate() {\n501\t                                    (c.write_row)(png, r.as_ptr());\n502\t                                    log(format!(\"row {pass}/{i} out={}\", outlen()));\n503\t                                    if mode == 1 && i % 3 == 2 {\n504\t                                        (c.write_flush)(png);\n505\t                                        log(format!(\"xflush {pass}/{i} out={}\", outlen()));\n506\t                                    }\n507\t                                    if mode == 3 && i == 5 {\n508\t                                        (c.set_flush)(png, 0);\n509\t                                        log(\"flush off\".to_string());\n510\t                                    }\n511\t                                }\n512\t                            }\n513\t                            if mode == 2 {\n514\t                                (c.write_flush)(png);\n515\t                                log(format!(\"post out={}\", outlen()));\n516\t                            }\n517\t                            (c.write_end)(png, info);\n518\t                            log(format!(\"end out={}\", outlen()));\n519\t                            log(format!(\"rowsum={:08x}\", rowsum(rows)));\n520\t                        };\n521\t                        if soft {\n522\t                            wsoft(lib, &mut body)\n523\t                        } else {\n524\t                            wwrite(lib, &mut body)\n525\t                        }\n526\t                    });\n527\t                }\n528\t            }\n529\t        }\n530\t    }\n531\t}\n532\t\n533\t// ---------------------------------------------------------------------------\n534\t// W15 — png_write_sig / png_write_chunk / png_write_chunk_start+data+end\n535\t// ---------------------------------------------------------------------------\n536\t\n537\t/// A legal private, ancillary chunk name: lower-case first byte (ancillary),\n538\t/// lower-case second byte (private), upper-case third byte (reserved bit must\n539\t/// be 0), either case for the fourth (safe-to-copy) byte.\n540\tfn private_name(rng: &mut Rng) -> [u8; 4] {\n541\t    let lo = |r: &mut Rng| b'a' + r.below(26) as u8;\n542\t    let up = |r: &mut Rng| b'A' + r.below(26) as u8;\n543\t    let b0 = lo(rng);\n544\t    let b1 = lo(rng);\n545\t    let b2 = up(rng);"}]},"parent_tool_use_id":"toolu_bdrk_0142wgcwC4DU2gkmXGMTmwBC","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"d4fe45e6-5d2d-4ab0-95fb-5f13ee90f7f9","timestamp":"2026-08-14T16:02:00.845Z","subagent_type":"general-purpose","task_description":"Write write_b tests W13-W24"}
