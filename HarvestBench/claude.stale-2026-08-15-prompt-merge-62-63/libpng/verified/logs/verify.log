{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HvE1eWG41hHBXR6f7Hk3CM","type":"tool_result","content":"2095\t/* Pick out the correct pixels for the interlace pass.\n2096\t * The basic idea here is to go through the row with a source\n2097\t * pointer and a destination pointer (sp and dp), and copy the\n2098\t * correct pixels for the pass.  As the row gets compacted,\n2099\t * sp will always be >= dp, so we should never overwrite anything.\n2100\t * See the default: case for the easiest code to understand.\n2101\t */\n2102\tvoid /* PRIVATE */\n2103\tpng_do_write_interlace(png_row_infop row_info, png_bytep row, int pass)\n2104\t{\n2105\t   png_debug(1, \"in png_do_write_interlace\");\n2106\t\n2107\t   /* We don't have to do anything on the last pass (6) */\n2108\t   if (pass < 6)\n2109\t   {\n2110\t      /* Each pixel depth is handled separately */\n2111\t      switch (row_info->pixel_depth)\n2112\t      {\n2113\t         case 1:\n2114\t         {\n2115\t            png_bytep sp;\n2116\t            png_bytep dp;\n2117\t            unsigned int shift;\n2118\t            int d;\n2119\t            int value;\n2120\t            png_uint_32 i;\n2121\t            png_uint_32 row_width = row_info->width;\n2122\t\n2123\t            dp = row;\n2124\t            d = 0;\n2125\t            shift = 7;\n2126\t\n2127\t            for (i = png_pass_start[pass]; i < row_width;\n2128\t               i += png_pass_inc[pass])\n2129\t            {\n2130\t               sp = row + (size_t)(i >> 3);\n2131\t               value = (int)(*sp >> (7 - (int)(i & 0x07))) & 0x01;\n2132\t               d |= (value << shift);\n2133\t\n2134\t               if (shift == 0)\n2135\t               {\n2136\t                  shift = 7;\n2137\t                  *dp++ = (png_byte)d;\n2138\t                  d = 0;\n2139\t               }\n2140\t\n2141\t               else\n2142\t                  shift--;\n2143\t\n2144\t            }\n2145\t            if (shift != 7)\n2146\t               *dp = (png_byte)d;\n2147\t\n2148\t            break;\n2149\t         }\n2150\t\n2151\t         case 2:\n2152\t         {\n2153\t            png_bytep sp;\n2154\t            png_bytep dp;\n2155\t            unsigned int shift;\n2156\t            int d;\n2157\t            int value;\n2158\t            png_uint_32 i;\n2159\t            png_uint_32 row_width = row_info->width;\n2160\t\n2161\t            dp = row;\n2162\t            shift = 6;\n2163\t            d = 0;\n2164\t\n2165\t            for (i = png_pass_start[pass]; i < row_width;\n2166\t               i += png_pass_inc[pass])\n2167\t            {\n2168\t               sp = row + (size_t)(i >> 2);\n2169\t               value = (*sp >> ((3 - (int)(i & 0x03)) << 1)) & 0x03;\n2170\t               d |= (value << shift);\n2171\t\n2172\t               if (shift == 0)\n2173\t               {\n2174\t                  shift = 6;\n2175\t                  *dp++ = (png_byte)d;\n2176\t                  d = 0;\n2177\t               }\n2178\t\n2179\t               else\n2180\t                  shift -= 2;\n2181\t            }\n2182\t            if (shift != 6)\n2183\t               *dp = (png_byte)d;\n2184\t\n2185\t            break;\n2186\t         }\n2187\t\n2188\t         case 4:\n2189\t         {\n2190\t            png_bytep sp;\n2191\t            png_bytep dp;\n2192\t            unsigned int shift;\n2193\t            int d;\n2194\t            int value;\n2195\t            png_uint_32 i;\n2196\t            png_uint_32 row_width = row_info->width;\n2197\t\n2198\t            dp = row;\n2199\t            shift = 4;\n2200\t            d = 0;\n2201\t            for (i = png_pass_start[pass]; i < row_width;\n2202\t                i += png_pass_inc[pass])\n2203\t            {\n2204\t               sp = row + (size_t)(i >> 1);\n2205\t               value = (*sp >> ((1 - (int)(i & 0x01)) << 2)) & 0x0f;\n2206\t               d |= (value << shift);\n2207\t\n2208\t               if (shift == 0)\n2209\t               {\n2210\t                  shift = 4;\n2211\t                  *dp++ = (png_byte)d;\n2212\t                  d = 0;\n2213\t               }\n2214\t"}]},"parent_tool_use_id":"toolu_bdrk_01KKgwxwravRomJENipvomj6","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"baf2991a-ca5c-4ed4-b0a0-d16e6f121f01","timestamp":"2026-08-14T15:18:46.126Z","subagent_type":"general-purpose","task_description":"Write lowlevel_b tests L19-L29"}
