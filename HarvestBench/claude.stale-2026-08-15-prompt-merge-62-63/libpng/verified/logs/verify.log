{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01R1WJik1Ds6Big61ZQ3zz4w","type":"tool_result","content":"1\t//! Sequential-read differential tests, CONFIGS.md rows R1..R16.\n2\t//!\n3\t//! Every test builds its input PNG with `support::pngbuild` (independent of\n4\t//! both libraries), then drives the C `.so` and the Rust `.so` through the\n5\t//! identical call sequence on those identical bytes and compares the complete\n6\t//! trace byte for byte.\n7\tmod support;\n8\t\n9\tuse std::ffi::c_int;\n10\tuse support::core::*;\n11\tuse support::pngbuild::{self, Builder};\n12\tuse support::*;\n13\t\n14\t// ---------------------------------------------------------------------------\n15\t// input construction\n16\t// ---------------------------------------------------------------------------\n17\t\n18\t/// The 15 legal (colour_type, bit_depth) combinations.\n19\tconst COMBOS: &[(u8, u8)] = &[\n20\t    (0, 1),\n21\t    (0, 2),\n22\t    (0, 4),\n23\t    (0, 8),\n24\t    (0, 16),\n25\t    (2, 8),\n26\t    (2, 16),\n27\t    (3, 1),\n28\t    (3, 2),\n29\t    (3, 4),\n30\t    (3, 8),\n31\t    (4, 8),\n32\t    (4, 16),\n33\t    (6, 8),\n34\t    (6, 16),\n35\t];\n36\t\n37\t/// Bytes of the row buffer logged past `rowbytes`, so that an overrun in\n38\t/// either library becomes visible in the trace.\n39\tconst SLACK: usize = 16;\n40\t\n41\t/// Seed offsets: every configuration is exercised with several inputs.\n42\tconst SEEDS: &[u64] = &[0, 0x9e37_79b9];\n43\t\n44\t/// The reference C `libpng.so` (`c_src/CMakeLists.txt`) is linked without\n45\t/// `-lm`, so its `floor`/`pow` references stay unresolved and the *first*\n46\t/// floating-point entry point that is called (e.g. `png_set_rgb_to_gray`,\n47\t/// which calls `png_fixed` -> `floor`) aborts the process with\n48\t/// \"symbol lookup error: undefined symbol: floor\".  Loading libm into the\n49\t/// global symbol scope makes the lazy binding resolvable.  This changes symbol\n50\t/// resolution only, and both libraries end up using the same libm.\n51\tfn ensure_libm() {\n52\t    use std::sync::OnceLock;\n53\t    static LIBM: OnceLock<libloading::os::unix::Library> = OnceLock::new();\n54\t    LIBM.get_or_init(|| unsafe {\n55\t        // RTLD_NOW | RTLD_GLOBAL on Linux\n56\t        libloading::os::unix::Library::open(Some(\"libm.so.6\"), 0x2 | 0x100)\n57\t            .expect(\"dlopen libm.so.6\")\n58\t    });\n59\t}\n60\t\n61\tfn palette_for(bd: u8, seed: u64) -> Vec<u8> {\n62\t    let n = 1usize << bd; // every index of a `bd`-bit image is in range\n63\t    let mut r = Rng::new(seed);\n64\t    (0..3 * n).map(|_| r.byte()).collect()\n65\t}\n66\t\n67\tfn trns_for(ct: u8, bd: u8, seed: u64) -> Vec<u8> {\n68\t    let mut r = Rng::new(seed);\n69\t    match ct {\n70\t        0 => {\n71\t            let m: u32 = if bd >= 16 { 0xffff } else { (1u32 << bd) - 1 };\n72\t            ((r.next_u32() % (m + 1)) as u16).to_be_bytes().to_vec()\n73\t        }\n74\t        2 => {\n75\t            let m: u32 = if bd >= 16 { 0xffff } else { 0xff };\n76\t            let mut v = Vec::new();\n77\t            for _ in 0..3 {\n78\t                v.extend_from_slice(&((r.next_u32() % (m + 1)) as u16).to_be_bytes());\n79\t            }\n80\t            v\n81\t        }\n82\t        3 => {\n83\t            let n = 1usize << bd;\n84\t            r.bytes(n)\n85\t        }\n86\t        // Illegal for GRAY_ALPHA/RGB_ALPHA: libpng reports a benign error.\n87\t        _ => vec![0x12, 0x34],\n88\t    }\n89\t}\n90\t\n91\t/// A legal sBIT chunk payload.  For palette images the sample depth is 8, but\n92\t/// `png_set_shift` (which `png_read_png` calls for `PNG_TRANSFORM_SHIFT`)\n93\t/// validates against the *index* depth, so `big` selects between a payload\n94\t/// that `png_set_shift` accepts and one it rejects.\n95\tfn sbit_for(ct: u8, bd: u8, big: bool) -> Vec<u8> {\n96\t    let v = if bd > 1 { bd - 1 } else { 1 };\n97\t    match ct {\n98\t        0 => vec![v],\n99\t        2 => vec![v, v, v],\n100\t        3 => {\n101\t            if big {\n102\t                vec![8, 7, 6]\n103\t            } else {\n104\t                vec![bd, bd.saturating_sub(1).max(1), bd.saturating_sub(2).max(1)]\n105\t            }\n106\t        }\n107\t        4 => vec![v, v],\n108\t        _ => vec![v, v, v, v],\n109\t    }\n110\t}\n111\t\n112\t/// Header chunks in canonical order: sBIT, gAMA, PLTE, tRNS.\n113\tfn base(w: u32, h: u32, ct: u8, bd: u8, il: u8, seed: u64, trns: bool, sbit: bool) -> Builder {\n114\t    let mut b = Builder::new(w, h, bd, ct).interlace(il);\n115\t    if sbit {\n116\t        b = b.add(b\"sBIT\", sbit_for(ct, bd, false));\n117\t        b = b.add(b\"gAMA\", 45455u32.to_be_bytes().to_vec());\n118\t    }\n119\t    if ct == 3 {\n120\t        b = b.add(b\"PLTE\", palette_for(bd, seed ^ 0x5eed_1234));\n121\t    }\n122\t    if trns {\n123\t        b = b.add(b\"tRNS\", trns_for(ct, bd, seed ^ 0x7a17_9999));\n124\t    }\n125\t    b\n126\t}\n127\t\n128\t/// Valid PNG, all row filters 0.\n129\tfn mk(w: u32, h: u32, ct: u8, bd: u8, il: u8, seed: u64) -> Vec<u8> {\n130\t    base(w, h, ct, bd, il, seed, false, false).build_valid(seed)\n131\t}\n132\t\n133\t/// Valid PNG carrying a tRNS chunk.\n134\tfn mk_trns(w: u32, h: u32, ct: u8, bd: u8, il: u8, seed: u64) -> Vec<u8> {\n135\t    base(w, h, ct, bd, il, seed, true, false).build_valid(seed)\n136\t}\n137\t\n138\t/// Valid PNG carrying sBIT + gAMA + tRNS.\n139\tfn mk_rich(w: u32, h: u32, ct: u8, bd: u8, il: u8, seed: u64) -> Vec<u8> {\n140\t    base(w, h, ct, bd, il, seed, true, true).build_valid(seed)\n141\t}\n142\t\n143\t/// Valid PNG whose (legal) sBIT chunk carries values `png_set_shift` refuses.\n144\tfn mk_bigsbit(w: u32, h: u32, ct: u8, bd: u8, seed: u64) -> Vec<u8> {\n145\t    let mut b = Builder::new(w, h, bd, ct);\n146\t    b = b.add(b\"sBIT\", sbit_for(ct, bd, true));\n147\t    if ct == 3 {\n148\t        b = b.add(b\"PLTE\", palette_for(bd, seed ^ 0x5eed_1234));\n149\t    }\n150\t    b.build_valid(seed)\n151\t}\n152\t\n153\t/// Raw pre-compression stream whose row filter bytes cycle through 0..4.\n154\tfn raw_filters(w: u32, h: u32, ct: u8, bd: u8, il: u8, seed: u64) -> Vec<u8> {\n155\t    let mut r = Rng::new(seed);\n156\t    let mut out = Vec::new();\n157\t    let mut fi = 0u8;\n158\t    if il == 0 {\n159\t        let rb = pngbuild::rowbytes(ct, bd, w);\n160\t        for _ in 0..h {\n161\t            out.push(fi % 5);\n162\t            fi = fi.wrapping_add(1);\n163\t            for _ in 0..rb {\n164\t                out.push(r.byte());\n165\t            }\n166\t        }\n167\t    } else {\n168\t        for p in 0..7 {\n169\t            let pw = pngbuild::pass_width(w, p);\n170\t            let ph = pngbuild::pass_height(h, p);\n171\t            if pw == 0 || ph == 0 {\n172\t                continue;\n173\t            }\n174\t            let rb = pngbuild::rowbytes(ct, bd, pw);\n175\t            for _ in 0..ph {\n176\t                out.push(fi % 5);\n177\t                fi = fi.wrapping_add(1);\n178\t                for _ in 0..rb {\n179\t                    out.push(r.byte());\n180\t                }\n181\t            }\n182\t        }\n183\t    }\n184\t    out\n185\t}\n186\t\n187\t/// Valid PNG exercising all five row filter types.\n188\tfn mk_filters(w: u32, h: u32, ct: u8, bd: u8, il: u8, seed: u64) -> Vec<u8> {\n189\t    let b = base(w, h, ct, bd, il, seed, false, false);\n190\t    let raw = raw_filters(w, h, ct, bd, il, seed ^ 0xf117_e000);\n191\t    b.build(&raw, 0)\n192\t}\n193\t\n194\t/// Non-interlaced RGB/RGBA raw stream (filter 0) whose pixels are all grey.\n195\tfn raw_grey_rgb(w: u32, h: u32, ct: u8, bd: u8, seed: u64) -> Vec<u8> {\n196\t    let mut r = Rng::new(seed);\n197\t    let ch = if ct == 6 { 4 } else { 3 };\n198\t    let mut out = Vec::new();\n199\t    for _ in 0..h {\n200\t        out.push(0u8);\n201\t        for _ in 0..w {\n202\t            if bd == 8 {\n203\t                let v = r.byte();\n204\t                for k in 0..ch {\n205\t                    if k < 3 {\n206\t                        out.push(v);\n207\t                    } else {\n208\t                        out.push(r.byte());\n209\t                    }\n210\t                }\n211\t            } else {\n212\t                let hi = r.byte();\n213\t                let lo = r.byte();\n214\t                for k in 0..ch {\n215\t                    if k < 3 {\n216\t                        out.push(hi);\n217\t                        out.push(lo);\n218\t                    } else {\n219\t                        out.push(r.byte());\n220\t                        out.push(r.byte());\n221\t                    }\n222\t                }\n223\t            }\n224\t        }\n225\t    }\n226\t    out\n227\t}\n228\t\n229\tfn mk_grey_rgb(w: u32, h: u32, ct: u8, bd: u8, seed: u64) -> Vec<u8> {\n230\t    let b = base(w, h, ct, bd, 0, seed, false, false);\n231\t    let raw = raw_grey_rgb(w, h, ct, bd, seed);\n232\t    b.build(&raw, 0)\n233\t}\n234\t\n235\t// ---------------------------------------------------------------------------\n236\t// drivers\n237\t// ---------------------------------------------------------------------------\n238\t\n239\t#[derive(Default, Clone, Copy)]\n240\tstruct Opts {\n241\t    /// log `png_get_rgb_to_gray_status` after every row\n242\t    status: bool,\n243\t    /// log `png_get_current_pass_number` / `png_get_current_row_number`\n244\t    rownum: bool,\n245\t}\n246\t\n247\tfn stride_for(w: u32) -> usize {\n248\t    // worst case after transforms: 4 channels * 2 bytes per pixel\n249\t    w as usize * 8 + SLACK + 24\n250\t}\n251\t\n252\t/// read_info -> transforms -> interlace handling -> read_update_info -> rows.\n253\tfn drive(\n254\t    lib: &Lib,\n255\t    png: &[u8],\n256\t    h: u32,\n257\t    stride: usize,\n258\t    bp: *mut u8,\n259\t    o: Opts,\n260\t    set: &mut dyn FnMut(&Core, Png, Info),\n261\t) -> Trace {\n262\t    unsafe { std::ptr::write_bytes(bp, 0, h as usize * stride) };\n263\t    with_read(lib, png, &mut |c, p, i| unsafe {\n264\t        (c.read_info)(p, i);\n265\t        set(c, p, i);\n266\t        let passes = (c.set_interlace_handling)(p);\n267\t        log(format!(\"passes={passes}\"));\n268\t        (c.read_update_info)(p, i);\n269\t        log_all_info(c, p, i);\n270\t        let rb = (c.get_rowbytes)(p, i);\n271\t        log(format!(\n272\t            \"rowbytes_after_update={rb} channels={} depth={} color={}\",\n273\t            (c.get_channels)(p, i),\n274\t            (c.get_bit_depth)(p, i),\n275\t            (c.get_color_type)(p, i)\n276\t        ));\n277\t        if rb + SLACK > stride {\n278\t            log(format!(\"BUF_TOO_SMALL rb={rb} stride={stride}\"));\n279\t            return;\n280\t        }\n281\t        for pass in 0..passes {\n282\t            for r in 0..h {\n283\t                let rp = bp.add(r as usize * stride);\n284\t                (c.read_row)(p, rp, std::ptr::null_mut());\n285\t                log(format!(\n286\t                    \"p{pass}r{r}={} slack={}\",\n287\t                    hex(std::slice::from_raw_parts(rp, rb)),\n288\t                    hex(std::slice::from_raw_parts(rp.add(rb), SLACK))\n289\t                ));\n290\t                if o.status {\n291\t                    log(format!(\"rgb_to_gray_status={}\", (c.get_rgb_to_gray_status)(p)));\n292\t                }\n293\t                if o.rownum {\n294\t                    log(format!(\n295\t                        \"pass_no={} row_no={}\",\n296\t                        (c.get_current_pass_number)(p),\n297\t                        (c.get_current_row_number)(p)\n298\t                    ));\n299\t                }\n300\t            }\n301\t        }\n302\t        (c.read_end)(p, std::ptr::null_mut());\n303\t    })\n304\t}\n305\t\n306\tfn case_opts<F: FnMut(&Core, Png, Info)>(\n307\t    label: &str,\n308\t    png: &[u8],\n309\t    w: u32,\n310\t    h: u32,\n311\t    o: Opts,\n312\t    mut set: F,\n313\t) {\n314\t    let stride = stride_for(w);\n315\t    let mut buf = vec![0u8; h as usize * stride];\n316\t    let bp = buf.as_mut_ptr();\n317\t    diff(label, |lib| drive(lib, png, h, stride, bp, o, &mut set));\n318\t}\n319\t\n320\tfn case<F: FnMut(&Core, Png, Info)>(label: &str, png: &[u8], w: u32, h: u32, set: F) {\n321\t    case_opts(label, png, w, h, Opts::default(), set)\n322\t}\n323\t\n324\tfn noset(_c: &Core, _p: Png, _i: Info) {}\n325\t\n326\tfn ptr_array(base: *mut u8, h: u32, stride: usize) -> Vec<*mut u8> {\n327\t    (0..h as usize)\n328\t        .map(|y| unsafe { base.add(y * stride) })\n329\t        .collect()\n330\t}\n331\t\n332\t/// `png_read_rows` driver.  `mode`: 0 = row only, 1 = display only, 2 = both.\n333\t/// `one`: one row per call instead of a whole pass per call.\n334\t#[allow(clippy::too_many_arguments)]\n335\tfn drive_rows(\n336\t    lib: &Lib,\n337\t    png: &[u8],\n338\t    h: u32,\n339\t    stride: usize,\n340\t    b1: *mut u8,\n341\t    b2: *mut u8,\n342\t    a1: *mut *mut u8,\n343\t    a2: *mut *mut u8,\n344\t    mode: u8,\n345\t    one: bool,\n346\t) -> Trace {\n347\t    unsafe {\n348\t        std::ptr::write_bytes(b1, 0, h as usize * stride);\n349\t        std::ptr::write_bytes(b2, 0, h as usize * stride);\n350\t    }\n351\t    with_read(lib, png, &mut |c, p, i| unsafe {\n352\t        (c.read_info)(p, i);\n353\t        let passes = (c.set_interlace_handling)(p);\n354\t        (c.read_update_info)(p, i);\n355\t        log_all_info(c, p, i);\n356\t        let rb = (c.get_rowbytes)(p, i);\n357\t        log(format!(\"passes={passes} rowbytes_after_update={rb}\"));\n358\t        if rb + SLACK > stride {\n359\t            log(format!(\"BUF_TOO_SMALL rb={rb} stride={stride}\"));\n360\t            return;\n361\t        }\n362\t        let rr = if mode == 1 { std::ptr::null_mut() } else { a1 };\n363\t        let dd = if mode == 0 { std::ptr::null_mut() } else { a2 };\n364\t        for pass in 0..passes {\n365\t            if one {\n366\t                for y in 0..h as usize {\n367\t                    let r2 = if rr.is_null() {\n368\t                        std::ptr::null_mut()\n369\t                    } else {\n370\t                        rr.add(y)\n371\t                    };\n372\t                    let d2 = if dd.is_null() {\n373\t                        std::ptr::null_mut()\n374\t                    } else {\n375\t                        dd.add(y)\n376\t                    };\n377\t                    (c.read_rows)(p, r2, d2, 1);\n378\t                }\n379\t            } else {\n380\t                (c.read_rows)(p, rr, dd, h);\n381\t            }\n382\t            for y in 0..h as usize {\n383\t                let r1 = b1.add(y * stride);\n384\t                let r2 = b2.add(y * stride);\n385\t                log(format!(\n386\t                    \"p{pass}r{y} row={} rs={} dsp={} ds={}\",\n387\t                    hex(std::slice::from_raw_parts(r1, rb)),\n388\t                    hex(std::slice::from_raw_parts(r1.add(rb), SLACK)),\n389\t                    hex(std::slice::from_raw_parts(r2, rb)),\n390\t                    hex(std::slice::from_raw_parts(r2.add(rb), SLACK))\n391\t                ));\n392\t            }\n393\t        }\n394\t        (c.read_end)(p, std::ptr::null_mut());\n395\t    })\n396\t}\n397\t\n398\tfn case_rows(label: &str, png: &[u8], w: u32, h: u32, mode: u8, one: bool) {\n399\t    let stride = stride_for(w);\n400\t    let mut buf1 = vec![0u8; h as usize * stride];\n401\t    let mut buf2 = vec![0u8; h as usize * stride];\n402\t    let p1 = buf1.as_mut_ptr();\n403\t    let p2 = buf2.as_mut_ptr();\n404\t    let mut arr1 = ptr_array(p1, h, stride);\n405\t    let mut arr2 = ptr_array(p2, h, stride);\n406\t    let a1 = arr1.as_mut_ptr();\n407\t    let a2 = arr2.as_mut_ptr();\n408\t    diff(label, |lib| {\n409\t        drive_rows(lib, png, h, stride, p1, p2, a1, a2, mode, one)\n410\t    });\n411\t}\n412\t\n413\t/// `png_read_image` driver.  `pre`: 0 = nothing, 1 = interlace handling +\n414\t/// update_info, 2 = update_info only (the documented \"should be turned on\"\n415\t/// warning path).\n416\t#[allow(clippy::too_many_arguments)]\n417\tfn drive_image(\n418\t    lib: &Lib,\n419\t    png: &[u8],\n420\t    h: u32,\n421\t    stride: usize,\n422\t    bp: *mut u8,\n423\t    ap: *mut *mut u8,\n424\t    pre: u8,\n425\t) -> Trace {\n426\t    unsafe { std::ptr::write_bytes(bp, 0, h as usize * stride) };\n427\t    with_read(lib, png, &mut |c, p, i| unsafe {\n428\t        (c.read_info)(p, i);\n429\t        if pre == 1 {\n430\t            let n = (c.set_interlace_handling)(p);\n431\t            log(format!(\"passes={n}\"));\n432\t        }\n433\t        if pre != 0 {\n434\t            (c.read_update_info)(p, i);\n435\t        }\n436\t        log_all_info(c, p, i);\n437\t        let rb = (c.get_rowbytes)(p, i);\n438\t        log(format!(\"rowbytes={rb} channels={}\", (c.get_channels)(p, i)));\n439\t        if rb + SLACK > stride {\n440\t            log(format!(\"BUF_TOO_SMALL rb={rb} stride={stride}\"));\n441\t            return;\n442\t        }\n443\t        (c.read_image)(p, ap);\n444\t        for y in 0..h as usize {\n445\t            let rp = bp.add(y * stride);\n446\t            log(format!(\n447\t                \"row{y}={} slack={}\",\n448\t                hex(std::slice::from_raw_parts(rp, rb)),\n449\t                hex(std::slice::from_raw_parts(rp.add(rb), SLACK))\n450\t            ));\n451\t        }\n452\t        (c.read_end)(p, std::ptr::null_mut());\n453\t    })\n454\t}\n455\t\n456\tfn case_image(label: &str, png: &[u8], w: u32, h: u32, pre: u8) {\n457\t    let stride = stride_for(w);\n458\t    let mut buf = vec![0u8; h as usize * stride];\n459\t    let bp = buf.as_mut_ptr();\n460\t    let mut arr = ptr_array(bp, h, stride);\n461\t    let ap = arr.as_mut_ptr();\n462\t    diff(label, |lib| drive_image(lib, png, h, stride, bp, ap, pre));\n463\t}\n464\t\n465\t/// `png_read_png` driver: the rows are libpng's own buffers, fetched with\n466\t/// `png_get_rows`.\n467\t///\n468\t/// `png_read_png` allocates the row buffers with `png_malloc` (uninitialised)\n469\t/// and `png_combine_row` deliberately *preserves* the bits of the last byte of\n470\t/// a row that lie beyond the image width.  Those padding bits are therefore\n471\t/// uninitialised heap in both libraries, so they are masked out of the trace\n472\t/// here (the mask itself is logged).  Padding-bit preservation is checked\n473\t/// deterministically by R1/R5/R6/R7, which read into caller buffers that this\n474\t/// file zero-fills first.\n475\tfn case_read_png(label: &str, png: &[u8], tr: c_int) {\n476\t    diff(label, |lib| {\n477\t        with_read(lib, png, &mut |c, p, i| unsafe {\n478\t            (c.read_png)(p, i, tr, std::ptr::null_mut());\n479\t            log_all_info(c, p, i);\n480\t            let rb = (c.get_rowbytes)(p, i);\n481\t            let h = (c.get_image_height)(p, i);\n482\t            let w = (c.get_image_width)(p, i) as usize;\n483\t            let pd = (c.get_channels)(p, i) as usize * (c.get_bit_depth)(p, i) as usize;\n484\t            log(format!(\n485\t                \"rowbytes={rb} height={h} channels={} depth={} color={}\",\n486\t                (c.get_channels)(p, i),\n487\t                (c.get_bit_depth)(p, i),\n488\t                (c.get_color_type)(p, i)\n489\t            ));\n490\t            let m = (pd * w) & 7;\n491\t            let keep: u8 = if m == 0 {\n492\t                0xff\n493\t            } else if tr & PNG_TRANSFORM_PACKSWAP != 0 {\n494\t                !(0xffu8 << m)\n495\t            } else {\n496\t                !(0xffu8 >> m)\n497\t            };\n498\t            log(format!(\"last_byte_mask={keep:02x}\"));\n499\t            let rows = (c.get_rows)(p, i);\n500\t            log(format!(\"rows_null={}\", rows.is_null() as u8));\n501\t            if !rows.is_null() {\n502\t                for y in 0..h as usize {\n503\t                    let rp = *rows.add(y);\n504\t                    if rp.is_null() {\n505\t                        log(format!(\"row{y}=<null>\"));\n506\t                    } else if rb == 0 {\n507\t                        log(format!(\"row{y}=\"));\n508\t                    } else {\n509\t                        let s = std::slice::from_raw_parts(rp, rb);\n510\t                        log(format!(\n511\t                            \"row{y}={}{:02x}\",\n512\t                            hex(&s[..rb - 1]),\n513\t                            s[rb - 1] & keep\n514\t                        ));\n515\t                    }\n516\t                }\n517\t            }\n518\t        })\n519\t    });\n520\t}\n521\t\n522\t// ---------------------------------------------------------------------------\n523\t// R1 — png_read_info + png_read_row, all combos, no transforms\n524\t// ---------------------------------------------------------------------------\n525\t\n526\t#[test]\n527\tfn r1_read_row_all_combos() {\n528\t    ensure_libm();\n529\t    for &(ct, bd) in COMBOS {\n530\t        for il in [0u8, 1] {\n531\t            for &w in &[1u32, 3, 7, 8, 17] {\n532\t                for &h in &[1u32, 5] {\n533\t                    for &sx in SEEDS {\n534\t                        let seed = 0x1000\n535\t                            + (ct as u64) * 97\n536\t                            + (bd as u64) * 13\n537\t                            + w as u64 * 3\n538\t                            + h as u64\n539\t                            + sx;\n540\t                        let png = mk(w, h, ct, bd, il, seed);\n541\t                        case(\n542\t                            &format!(\"R1 ct={ct} bd={bd} il={il} w={w} h={h} s={sx} f0\"),\n543\t                            &png,\n544\t                            w,\n545\t                            h,\n546\t                            noset,\n547\t                        );\n548\t                        if h > 1 {\n549\t                            // all five row filter types\n550\t                            let png = mk_filters(w, h, ct, bd, il, seed ^ 0xabc);\n551\t                            case(\n552\t                                &format!(\"R1 ct={ct} bd={bd} il={il} w={w} h={h} s={sx} filters\"),\n553\t                                &png,\n554\t                                w,\n555\t                                h,\n556\t                                noset,\n557\t                            );\n558\t                        }\n559\t                    }\n560\t                }\n561\t            }\n562\t        }\n563\t    }\n564\t}\n565\t\n566\t// ---------------------------------------------------------------------------\n567\t// R2 — png_read_rows\n568\t// ---------------------------------------------------------------------------\n569\t\n570\t#[test]\n571\tfn r2_read_rows() {\n572\t    ensure_libm();\n573\t    let (w, h) = (7u32, 5u32);\n574\t    for &(ct, bd) in COMBOS {\n575\t        for il in [0u8, 1] {\n576\t            for mode in 0u8..3 {\n577\t                for one in [false, true] {\n578\t                    for &sx in SEEDS {\n579\t                        let seed = 0x2000 + (ct as u64) * 31 + (bd as u64) * 7 + il as u64 + sx;\n580\t                        let png = mk(w, h, ct, bd, il, seed);\n581\t                        case_rows(\n582\t                            &format!(\"R2 ct={ct} bd={bd} il={il} mode={mode} one={one} s={sx}\"),\n583\t                            &png,\n584\t                            w,\n585\t                            h,\n586\t                            mode,\n587\t                            one,\n588\t                        );\n589\t                    }\n590\t                }\n591\t            }\n592\t        }\n593\t    }\n594\t    // a second input shape with all five filter types\n595\t    for &(ct, bd) in COMBOS {\n596\t        let png = mk_filters(3, 4, ct, bd, 1, 0x2bcd + ct as u64);\n597\t        case_rows(&format!(\"R2f ct={ct} bd={bd}\"), &png, 3, 4, 2, true);\n598\t    }\n599\t}\n600\t\n601\t// ---------------------------------------------------------------------------\n602\t// R3 — png_read_image\n603\t// ---------------------------------------------------------------------------\n604\t\n605\t#[test]\n606\tfn r3_read_image() {\n607\t    ensure_libm();\n608\t    let (w, h) = (7u32, 5u32);\n609\t    for &(ct, bd) in COMBOS {\n610\t        for il in [0u8, 1] {\n611\t            for pre in [0u8, 1] {\n612\t                for seed in [0x3000u64, 0x3777] {\n613\t                    let s = seed + (ct as u64) * 41 + (bd as u64) * 5 + il as u64;\n614\t                    let png = mk(w, h, ct, bd, il, s);\n615\t                    case_image(\n616\t                        &format!(\"R3 ct={ct} bd={bd} il={il} pre={pre} seed={s}\"),\n617\t                        &png,\n618\t                        w,\n619\t                        h,\n620\t                        pre,\n621\t                    );\n622\t                }\n623\t            }\n624\t        }\n625\t        // read_update_info without interlace handling: libpng warns and fixes up\n626\t        let png = mk(w, h, ct, bd, 1, 0x3aaa + ct as u64);\n627\t        case_image(&format!(\"R3warn ct={ct} bd={bd}\"), &png, w, h, 2);\n628\t    }\n629\t}\n630\t\n631\t// ---------------------------------------------------------------------------\n632\t// R4 — png_read_png with every transform bit it honours\n633\t// ---------------------------------------------------------------------------\n634\t\n635\t/// The read transforms `png_read_png` acts on (see `png_read_png` in\n636\t/// `c_src/src/pngread.c`).\n637\tconst RP_BITS: &[(c_int, &str)] = &[\n638\t    (PNG_TRANSFORM_IDENTITY, \"IDENTITY\"),\n639\t    (PNG_TRANSFORM_STRIP_16, \"STRIP_16\"),\n640\t    (PNG_TRANSFORM_STRIP_ALPHA, \"STRIP_ALPHA\"),\n641\t    (PNG_TRANSFORM_PACKING, \"PACKING\"),\n642\t    (PNG_TRANSFORM_PACKSWAP, \"PACKSWAP\"),\n643\t    (PNG_TRANSFORM_EXPAND, \"EXPAND\"),\n644\t    (PNG_TRANSFORM_INVERT_MONO, \"INVERT_MONO\"),\n645\t    (PNG_TRANSFORM_SHIFT, \"SHIFT\"),\n646\t    (PNG_TRANSFORM_BGR, \"BGR\"),\n647\t    (PNG_TRANSFORM_SWAP_ALPHA, \"SWAP_ALPHA\"),\n648\t    (PNG_TRANSFORM_SWAP_ENDIAN, \"SWAP_ENDIAN\"),\n649\t    (PNG_TRANSFORM_INVERT_ALPHA, \"INVERT_ALPHA\"),\n650\t    (PNG_TRANSFORM_GRAY_TO_RGB, \"GRAY_TO_RGB\"),\n651\t    (PNG_TRANSFORM_EXPAND_16, \"EXPAND_16\"),\n652\t    (PNG_TRANSFORM_SCALE_16, \"SCALE_16\"),\n653\t];\n654\t\n655\t#[test]\n656\tfn r4_read_png_transforms() {\n657\t    ensure_libm();\n658\t    let h = 3u32;\n659\t    // w=8 is byte-aligned at every bit depth (nothing is masked); w=5 leaves a\n660\t    // sub-byte remainder for the 1/2/4-bit formats.\n661\t    for &(bit, name) in RP_BITS {\n662\t        for &(ct, bd) in COMBOS {\n663\t            for &w in &[8u32, 5] {\n664\t                // rich input: sBIT (for SHIFT), gAMA, tRNS (for EXPAND)\n665\t                let png = mk_rich(w, h, ct, bd, 0, 0x4000 + (ct as u64) * 11 + bd as u64 + w as u64);\n666\t                case_read_png(\n667\t                    &format!(\"R4 tr={name} ct={ct} bd={bd} w={w} il=0\"),\n668\t                    &png,\n669\t                    bit,\n670\t                );\n671\t            }\n672\t        }\n673\t    }\n674\t    // PNG_TRANSFORM_SHIFT with an sBIT payload png_set_shift rejects (the\n675\t    // palette sample depth is 8 but it validates against the index depth)\n676\t    for &(ct, bd) in &[(3u8, 1u8), (3, 2), (3, 4), (3, 8), (0, 8), (2, 16)] {\n677\t        let png = mk_bigsbit(8, h, ct, bd, 0x4700 + (ct as u64) * 13 + bd as u64);\n678\t        case_read_png(\n679\t            &format!(\"R4 tr=SHIFT-bigsbit ct={ct} bd={bd}\"),\n680\t            &png,\n681\t            PNG_TRANSFORM_SHIFT,\n682\t        );\n683\t    }\n684\t    // seeded random combinations\n685\t    let mut r = Rng::new(0x4444_1111);\n686\t    for k in 0..8 {\n687\t        let nb = 2 + r.below(3) as usize;\n688\t        let mut m: c_int = 0;\n689\t        for _ in 0..nb {\n690\t            m |= RP_BITS[r.below(RP_BITS.len() as u32) as usize].0;\n691\t        }\n692\t        for &(ct, bd) in COMBOS {\n693\t            for &w in &[8u32, 5] {\n694\t                let png =\n695\t                    mk_rich(w, h, ct, bd, 1, 0x4500 + (ct as u64) * 7 + bd as u64 + k + w as u64);\n696\t                case_read_png(\n697\t                    &format!(\"R4 rand{k}=0x{m:04x} ct={ct} bd={bd} w={w} il=1\"),\n698\t                    &png,\n699\t                    m,\n700\t                );\n701\t            }\n702\t        }\n703\t    }\n704\t}\n705\t\n706\t// ---------------------------------------------------------------------------\n707\t// R5 — png_set_interlace_handling, all 7 passes, every combo\n708\t// ---------------------------------------------------------------------------\n709\t\n710\t#[test]\n711\tfn r5_interlace_handling() {\n712\t    ensure_libm();\n713\t    let o = Opts {\n714\t        rownum: true,\n715\t        ..Default::default()\n716\t    };\n717\t    for &(ct, bd) in COMBOS {\n718\t        for &(w, h) in &[(1u32, 1u32), (2, 3), (5, 8), (17, 7)] {\n719\t            for &sx in SEEDS {\n720\t                let seed = 0x5000 + (ct as u64) * 23 + (bd as u64) * 3 + w as u64 + sx;\n721\t                let png = mk(w, h, ct, bd, 1, seed);\n722\t                case_opts(\n723\t                    &format!(\"R5 ct={ct} bd={bd} w={w} h={h} s={sx} f0\"),\n724\t                    &png,\n725\t                    w,\n726\t                    h,\n727\t                    o,\n728\t                    noset,\n729\t                );\n730\t                if h > 1 {\n731\t                    let png = mk_filters(w, h, ct, bd, 1, seed ^ 0x99);\n732\t                    case_opts(\n733\t                        &format!(\"R5 ct={ct} bd={bd} w={w} h={h} s={sx} filters\"),\n734\t                        &png,\n735\t                        w,\n736\t                        h,\n737\t                        o,\n738\t                        noset,\n739\t                    );\n740\t                }\n741\t            }\n742\t        }\n743\t    }\n744\t}\n745\t\n746\t// ---------------------------------------------------------------------------\n747\t// R6 — png_set_packing\n748\t// ---------------------------------------------------------------------------\n749\t\n750\tconst SUBBYTE: &[(u8, u8)] = &[(0, 1), (0, 2), (0, 4), (3, 1), (3, 2), (3, 4)];\n751\t\n752\t#[test]\n753\tfn r6_packing() {\n754\t    ensure_libm();\n755\t    for &(ct, bd) in SUBBYTE {\n756\t        for &w in &[1u32, 3, 7, 8, 17] {\n757\t            for il in [0u8, 1] {\n758\t                for seed in [0x6000u64, 0x6abc] {\n759\t                    let s = seed + (ct as u64) * 17 + bd as u64 + w as u64;\n760\t                    let png = mk(w, 4, ct, bd, il, s);\n761\t                    case(\n762\t                        &format!(\"R6 ct={ct} bd={bd} w={w} il={il} seed={s}\"),\n763\t                        &png,\n764\t                        w,\n765\t                        4,\n766\t                        |c, p, _i| unsafe { (c.set_packing)(p) },\n767\t                    );\n768\t                }\n769\t            }\n770\t        }\n771\t    }\n772\t    // png_set_packing on inputs where it must do nothing\n773\t    for &(ct, bd) in COMBOS {\n774\t        if bd < 8 {\n775\t            continue;\n776\t        }\n777\t        let png = mk(5, 2, ct, bd, 0, 0x6def + ct as u64);\n778\t        case(\n779\t            &format!(\"R6noop ct={ct} bd={bd}\"),\n780\t            &png,\n781\t            5,\n782\t            2,\n783\t            |c, p, _i| unsafe { (c.set_packing)(p) },\n784\t        );\n785\t    }\n786\t}\n787\t\n788\t// ---------------------------------------------------------------------------\n789\t// R7 — png_set_packswap (alone and combined with packing)\n790\t// ---------------------------------------------------------------------------\n791\t\n792\t#[test]\n793\tfn r7_packswap() {\n794\t    ensure_libm();\n795\t    for &(ct, bd) in SUBBYTE {\n796\t        for &w in &[1u32, 3, 7, 17] {\n797\t            for il in [0u8, 1] {\n798\t                for variant in 0u8..3 {\n799\t                  for &sx in SEEDS {\n800\t                    let s = 0x7000 + (ct as u64) * 19 + bd as u64 + w as u64 * 5 + il as u64 + sx;\n801\t                    let png = mk(w, 4, ct, bd, il, s);\n802\t                    case(\n803\t                        &format!(\"R7 ct={ct} bd={bd} w={w} il={il} v={variant} s={sx}\"),\n804\t                        &png,\n805\t                        w,\n806\t                        4,\n807\t                        |c, p, _i| unsafe {\n808\t                            match variant {\n809\t                                0 => (c.set_packswap)(p),\n810\t                                1 => {\n811\t                                    (c.set_packing)(p);\n812\t                                    (c.set_packswap)(p);\n813\t                                }\n814\t                                _ => {\n815\t                                    (c.set_packswap)(p);\n816\t                                    (c.set_packing)(p);\n817\t                                }\n818\t                            }\n819\t                        },\n820\t                    );\n821\t                  }\n822\t                }\n823\t            }\n824\t        }\n825\t    }\n826\t    for &(ct, bd) in COMBOS {\n827\t        if bd < 8 {\n828\t            continue;\n829\t        }\n830\t        let png = mk(5, 2, ct, bd, 0, 0x7fff + ct as u64);\n831\t        case(\n832\t            &format!(\"R7noop ct={ct} bd={bd}\"),\n833\t            &png,\n834\t            5,\n835\t            2,\n836\t            |c, p, _i| unsafe { (c.set_packswap)(p) },\n837\t        );\n838\t    }\n839\t}\n840\t\n841\t// ---------------------------------------------------------------------------\n842\t// R8 — png_set_expand\n843\t// ---------------------------------------------------------------------------\n844\t\n845\t#[test]\n846\tfn r8_expand() {\n847\t    ensure_libm();\n848\t    for &(ct, bd) in COMBOS {\n849\t        for trns in [false, true] {\n850\t            for &w in &[3u32, 8] {\n851\t                for il in [0u8, 1] {\n852\t                    for &sx in SEEDS {\n853\t                        let s = 0x8000\n854\t                            + (ct as u64) * 29\n855\t                            + (bd as u64) * 3\n856\t                            + w as u64\n857\t                            + il as u64\n858\t                            + sx;\n859\t                        let png = if trns {\n860\t                            mk_trns(w, 3, ct, bd, il, s)\n861\t                        } else {\n862\t                            mk(w, 3, ct, bd, il, s)\n863\t                        };\n864\t                        case(\n865\t                            &format!(\"R8 ct={ct} bd={bd} w={w} il={il} trns={trns} s={sx}\"),\n866\t                            &png,\n867\t                            w,\n868\t                            3,\n869\t                            |c, p, _i| unsafe { (c.set_expand)(p) },\n870\t                        );\n871\t                    }\n872\t                }\n873\t            }\n874\t        }\n875\t    }\n876\t}\n877\t\n878\t// ---------------------------------------------------------------------------\n879\t// R9 — png_set_expand_16\n880\t// ---------------------------------------------------------------------------\n881\t\n882\t#[test]\n883\tfn r9_expand_16() {\n884\t    ensure_libm();\n885\t    for &(ct, bd) in COMBOS {\n886\t        for trns in [false, true] {\n887\t            for variant in 0u8..2 {\n888\t                for il in [0u8, 1] {\n889\t                    for &sx in SEEDS {\n890\t                        let s = 0x9000 + (ct as u64) * 37 + (bd as u64) * 5 + il as u64 + sx;\n891\t                        let png = if trns {\n892\t                            mk_trns(7, 3, ct, bd, il, s)\n893\t                        } else {\n894\t                            mk(7, 3, ct, bd, il, s)\n895\t                        };\n896\t                        case(\n897\t                            &format!(\"R9 ct={ct} bd={bd} il={il} trns={trns} v={variant} s={sx}\"),\n898\t                            &png,\n899\t                            7,\n900\t                            3,\n901\t                            |c, p, _i| unsafe {\n902\t                                if variant == 1 {\n903\t                                    (c.set_expand)(p);\n904\t                                }\n905\t                                (c.set_expand_16)(p);\n906\t                            },\n907\t                        );\n908\t                    }\n909\t                }\n910\t            }\n911\t        }\n912\t    }\n913\t}\n914\t\n915\t// ---------------------------------------------------------------------------\n916\t// R10 — the three fine-grained expand entry points\n917\t// ---------------------------------------------------------------------------\n918\t\n919\t#[test]\n920\tfn r10_expand_parts() {\n921\t    ensure_libm();\n922\t    for which in 0u8..3 {\n923\t        for &(ct, bd) in COMBOS {\n924\t            for trns in [false, true] {\n925\t              for &sx in SEEDS {\n926\t                let s = 0xa000 + (ct as u64) * 43 + (bd as u64) * 7 + which as u64 + sx;\n927\t                let png = if trns {\n928\t                    mk_trns(7, 3, ct, bd, 0, s)\n929\t                } else {\n930\t                    mk(7, 3, ct, bd, 0, s)\n931\t                };\n932\t                case(\n933\t                    &format!(\"R10 which={which} ct={ct} bd={bd} trns={trns} s={sx}\"),\n934\t                    &png,\n935\t                    7,\n936\t                    3,\n937\t                    |c, p, _i| unsafe {\n938\t                        match which {\n939\t                            0 => (c.set_expand_gray_1_2_4_to_8)(p),\n940\t                            1 => (c.set_palette_to_rgb)(p),\n941\t                            _ => (c.set_tRNS_to_alpha)(p),\n942\t                 