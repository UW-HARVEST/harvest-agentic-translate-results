522\tpng_do_strip_channel(png_row_infop row_info, png_bytep row, int at_start)\n523\t{\n524\t   png_bytep sp = row; /* source pointer */\n525\t   png_bytep dp = row; /* destination pointer */\n526\t   png_bytep ep = row + row_info->rowbytes; /* One beyond end of row */\n527\t\n528\t   png_debug(1, \"in png_do_strip_channel\");\n529\t\n530\t   /* At the start sp will point to the first byte to copy and dp to where\n531\t    * it is copied to.  ep always points just beyond the end of the row, so\n532\t    * the loop simply copies (channels-1) channels until sp reaches ep.\n533\t    *\n534\t    * at_start:        0 -- convert AG, XG, ARGB, XRGB, AAGG, XXGG, etc.\n535\t    *            nonzero -- convert GA, GX, RGBA, RGBX, GGAA, RRGGBBXX, etc.\n536\t    */\n537\t\n538\t   /* GA, GX, XG cases */\n539\t   if (row_info->channels == 2)\n540\t   {\n541\t      if (row_info->bit_depth == 8)\n542\t      {\n543\t         if (at_start != 0) /* Skip initial filler */\n544\t            ++sp;\n545\t         else          /* Skip initial channel and, for sp, the filler */\n546\t         {\n547\t            sp += 2; ++dp;\n548\t         }\n549\t\n550\t         /* For a 1 pixel wide image there is nothing to do */\n551\t         while (sp < ep)\n552\t         {\n553\t            *dp++ = *sp; sp += 2;\n554\t         }\n555\t\n556\t         row_info->pixel_depth = 8;\n557\t      }\n558\t\n559\t      else if (row_info->bit_depth == 16)\n560\t      {\n561\t         if (at_start != 0) /* Skip initial filler */\n562\t            sp += 2;\n563\t         else          /* Skip initial channel and, for sp, the filler */\n564\t         {\n565\t            sp += 4; dp += 2;\n566\t         }\n567\t\n568\t         while (sp < ep)\n569\t         {\n570\t            *dp++ = *sp++; *dp++ = *sp; sp += 3;\n571\t         }\n572\t\n573\t         row_info->pixel_depth = 16;\n574\t      }\n575\t\n576\t      else\n577\t         return; /* bad bit depth */\n578\t\n579\t      row_info->channels = 1;\n580\t\n581\t      /* Finally fix the color type if it records an alpha channel */\n582\t      if (row_info->color_type == PNG_COLOR_TYPE_GRAY_ALPHA)\n583\t         row_info->color_type = PNG_COLOR_TYPE_GRAY;\n584\t   }\n585\t\n586\t   /* RGBA, RGBX, XRGB cases */\n587\t   else if (row_info->channels == 4)\n588\t   {\n589\t      if (row_info->bit_depth == 8)\n590\t      {\n591\t         if (at_start != 0) /* Skip initial filler */\n592\t            ++sp;\n593\t         else          /* Skip initial channels and, for sp, the filler */\n594\t         {\n595\t            sp += 4; dp += 3;\n596\t         }\n597\t\n598\t         /* Note that the loop adds 3 to dp and 4 to sp each time. */\n599\t         while (sp < ep)\n600\t         {\n601\t            *dp++ = *sp++; *dp++ = *sp++; *dp++ = *sp; sp += 2;\n602\t         }\n603\t\n604\t         row_info->pixel_depth = 24;\n605\t      }\n606\t\n607\t      else if (row_info->bit_depth == 16)\n608\t      {\n609\t         if (at_start != 0) /* Skip initial filler */\n610\t            sp += 2;\n611\t         else          /* Skip initial channels and, for sp, the filler */\n612\t         {\n613\t            sp += 8; dp += 6;\n614\t         }\n615\t\n616\t         while (sp < ep)\n617\t         {\n618\t            /* Copy 6 bytes, skip 2 */\n619\t            *dp++ = *sp++; *dp++ = *sp++;\n620\t            *dp++ = *sp++; *dp++ = *sp++;\n621\t            *dp++ = *sp++; *dp++ = *sp; sp += 3;\n622\t         }\n623\t\n624\t         row_info->pixel_depth = 48;\n625\t      }\n626\t\n627\t      else\n628\t         return; /* bad bit depth */\n629\t\n630\t      row_info->channels = 3;\n631\t\n632\t      /* Finally fix the color type if it records an alpha channel */\n633\t      if (row_info->color_type == PNG_COLOR_TYPE_RGB_ALPHA)\n634\t         row_info->color_type = PNG_COLOR_TYPE_RGB;\n635\t   }\n636\t\n637\t   else\n638\t      return; /* The filler channel has gone already */\n639\t\n640\t   /* Fix the rowbytes value. */\n641\t   row_info->row