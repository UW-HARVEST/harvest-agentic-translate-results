{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01So7ESvK2owB5BCKSsNC2Ye","type":"tool_result","content":"1\t//! Self-contained PNG stream construction / dissection, independent of both\n2\t//! libraries under test.  Used to feed byte-identical (valid or deliberately\n3\t//! malformed) inputs to the C and the Rust decoder.\n4\t#![allow(dead_code)]\n5\t\n6\tpub const SIG: [u8; 8] = [0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a];\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// checksums\n10\t// ---------------------------------------------------------------------------\n11\t\n12\tpub fn crc32(data: &[u8]) -> u32 {\n13\t    let mut table = [0u32; 256];\n14\t    for (n, e) in table.iter_mut().enumerate() {\n15\t        let mut c = n as u32;\n16\t        for _ in 0..8 {\n17\t            c = if c & 1 != 0 { 0xEDB8_8320 ^ (c >> 1) } else { c >> 1 };\n18\t        }\n19\t        *e = c;\n20\t    }\n21\t    let mut c = 0xFFFF_FFFFu32;\n22\t    for b in data {\n23\t        c = table[((c ^ *b as u32) & 0xFF) as usize] ^ (c >> 8);\n24\t    }\n25\t    c ^ 0xFFFF_FFFF\n26\t}\n27\t\n28\tpub fn adler32(data: &[u8]) -> u32 {\n29\t    let mut a = 1u32;\n30\t    let mut b = 0u32;\n31\t    for x in data {\n32\t        a = (a + *x as u32) % 65521;\n33\t        b = (b + a) % 65521;\n34\t    }\n35\t    (b << 16) | a\n36\t}\n37\t\n38\t// ---------------------------------------------------------------------------\n39\t// zlib stream with stored (uncompressed) deflate blocks\n40\t// ---------------------------------------------------------------------------\n41\t\n42\t/// A valid zlib stream carrying `data` in stored deflate blocks.\n43\tpub fn zlib_stored(data: &[u8]) -> Vec<u8> {\n44\t    let mut out = vec![0x78, 0x01]; // CM=8, CINFO=7, FCHECK making 0x7801 % 31 == 0\n45\t    if data.is_empty() {\n46\t        out.extend_from_slice(&[0x01, 0x00, 0x00, 0xff, 0xff]);\n47\t    } else {\n48\t        let mut off = 0usize;\n49\t        while off < data.len() {\n50\t            let n = std::cmp::min(65535, data.len() - off);\n51\t            let last = off + n >= data.len();\n52\t            out.push(if last { 1 } else { 0 });\n53\t            out.extend_from_slice(&(n as u16).to_le_bytes());\n54\t            out.extend_from_slice(&(!(n as u16)).to_le_bytes());\n55\t            out.extend_from_slice(&data[off..off + n]);\n56\t            off += n;\n57\t        }\n58\t    }\n59\t    out.extend_from_slice(&adler32(data).to_be_bytes());\n60\t    out\n61\t}\n62\t\n63\t// ---------------------------------------------------------------------------\n64\t// chunks\n65\t// ---------------------------------------------------------------------------\n66\t\n67\t#[derive(Clone, Debug, PartialEq)]\n68\tpub struct Chunk {\n69\t    pub name: [u8; 4],\n70\t    pub data: Vec<u8>,\n71\t    /// When `Some`, this CRC is emitted verbatim instead of the correct one.\n72\t    pub crc_override: Option<u32>,\n73\t    /// When `Some`, this length is emitted verbatim instead of `data.len()`.\n74\t    pub len_override: Option<u32>,\n75\t}\n76\t\n77\timpl Chunk {\n78\t    pub fn new(name: &[u8; 4], data: Vec<u8>) -> Chunk {\n79\t        Chunk {\n80\t            name: *name,\n81\t            data,\n82\t            crc_override: None,\n83\t            len_override: None,\n84\t        }\n85\t    }\n86\t    pub fn bad_crc(mut self) -> Chunk {\n87\t        let good = self.crc();\n88\t        self.crc_override = Some(good ^ 0xFFFF_FFFF);\n89\t        self\n90\t    }\n91\t    pub fn with_crc(mut self, crc: u32) -> Chunk {\n92\t        self.crc_override = Some(crc);\n93\t        self\n94\t    }\n95\t    pub fn with_len(mut self, len: u32) -> Chunk {\n96\t        self.len_override = Some(len);\n97\t        self\n98\t    }\n99\t    pub fn crc(&self) -> u32 {\n100\t        let mut buf = Vec::with_capacity(4 + self.data.len());\n101\t        buf.extend_from_slice(&self.name);\n102\t        buf.extend_from_slice(&self.data);\n103\t        crc32(&buf)\n104\t    }\n105\t    pub fn encode(&self) -> Vec<u8> {\n106\t        let mut out = Vec::with_capacity(12 + self.data.len());\n107\t        out.extend_from_slice(&self.len_override.unwrap_or(self.data.len() as u32).to_be_bytes());\n108\t        out.extend_from_slice(&self.name);\n109\t        out.extend_from_slice(&self.data);\n110\t        out.extend_from_slice(&self.crc_override.unwrap_or_else(|| self.crc()).to_be_bytes());\n111\t        out\n112\t    }\n113\t}\n114\t\n115\t/// Split a complete PNG datastream into its signature and chunk list.\n116\tpub fn split(png: &[u8]) -> Vec<Chunk> {\n117\t    let mut out = Vec::new();\n118\t    let mut i = 8; // skip signature\n119\t    while i + 8 <= png.len() {\n120\t        let len = u32::from_be_bytes([png[i], png[i + 1], png[i + 2], png[i + 3]]) as usize;\n121\t        let name = [png[i + 4], png[i + 5], png[i + 6], png[i + 7]];\n122\t        let ds = i + 8;\n123\t        let de = std::cmp::min(ds + len, png.len());\n124\t        let data = png[ds..de].to_vec();\n125\t        out.push(Chunk::new(&name, data));\n126\t        i = de + 4;\n127\t    }\n128\t    out\n129\t}\n130\t\n131\tpub fn join(chunks: &[Chunk]) -> Vec<u8> {\n132\t    let mut out = SIG.to_vec();\n133\t    for c in chunks {\n134\t        out.extend_from_slice(&c.encode());\n135\t    }\n136\t    out\n137\t}\n138\t\n139\tpub fn find(chunks: &[Chunk], name: &[u8; 4]) -> Option<usize> {\n140\t    chunks.iter().position(|c| &c.name == name)\n141\t}\n142\t\n143\t// ---------------------------------------------------------------------------\n144\t// image geometry helpers (mirrors PNG_ROWBYTES / the Adam7 tables)\n145\t// ---------------------------------------------------------------------------\n146\t\n147\tpub fn channels(color_type: u8) -> u32 {\n148\t    match color_type {\n149\t        0 | 3 => 1,\n150\t        2 => 3,\n151\t        4 => 2,\n152\t        6 => 4,\n153\t        _ => 1,\n154\t    }\n155\t}\n156\t\n157\tpub fn pixel_bits(color_type: u8, bit_depth: u8) -> u32 {\n158\t    channels(color_type) * bit_depth as u32\n159\t}\n160\t\n161\tpub fn rowbytes(color_type: u8, bit_depth: u8, width: u32) -> usize {\n162\t    let pd = pixel_bits(color_type, bit_depth) as usize;\n163\t    (pd * width as usize + 7) >> 3\n164\t}\n165\t\n166\tpub const ADAM7_XSTART: [u32; 7] = [0, 4, 0, 2, 0, 1, 0];\n167\tpub const ADAM7_YSTART: [u32; 7] = [0, 0, 4, 0, 2, 0, 1];\n168\tpub const ADAM7_XSTEP: [u32; 7] = [8, 8, 4, 4, 2, 2, 1];\n169\tpub const ADAM7_YSTEP: [u32; 7] = [8, 8, 8, 4, 4, 2, 2];\n170\t\n171\tpub fn pass_width(width: u32, pass: usize) -> u32 {\n172\t    if width <= ADAM7_XSTART[pass] {\n173\t        0\n174\t    } else {\n175\t        (width - ADAM7_XSTART[pass] + ADAM7_XSTEP[pass] - 1) / ADAM7_XSTEP[pass]\n176\t    }\n177\t}\n178\t\n179\tpub fn pass_height(height: u32, pass: usize) -> u32 {\n180\t    if height <= ADAM7_YSTART[pass] {\n181\t        0\n182\t    } else {\n183\t        (height - ADAM7_YSTART[pass] + ADAM7_YSTEP[pass] - 1) / ADAM7_YSTEP[pass]\n184\t    }\n185\t}\n186\t\n187\t/// Total size of the raw (filter byte + row) data stream for an image.\n188\tpub fn raw_size(width: u32, height: u32, color_type: u8, bit_depth: u8, interlace: u8) -> usize {\n189\t    if interlace == 0 {\n190\t        (rowbytes(color_type, bit_depth, width) + 1) * height as usize\n191\t    } else {\n192\t        (0..7)\n193\t            .map(|p| {\n194\t                let w = pass_width(width, p);\n195\t                let h = pass_height(height, p);\n196\t                if w == 0 || h == 0 {\n197\t                    0\n198\t                } else {\n199\t                    (rowbytes(color_type, bit_depth, w) + 1) * h as usize\n200\t                }\n201\t            })\n202\t            .sum()\n203\t    }\n204\t}\n205\t\n206\t// ---------------------------------------------------------------------------\n207\t// builder\n208\t// ---------------------------------------------------------------------------\n209\t\n210\tpub struct Builder {\n211\t    pub width: u32,\n212\t    pub height: u32,\n213\t    pub bit_depth: u8,\n214\t    pub color_type: u8,\n215\t    pub interlace: u8,\n216\t    pub compression: u8,\n217\t    pub filter: u8,\n218\t    pub chunks: Vec<Chunk>,\n219\t}\n220\t\n221\timpl Builder {\n222\t    pub fn new(width: u32, height: u32, bit_depth: u8, color_type: u8) -> Builder {\n223\t        Builder {\n224\t            width,\n225\t            height,\n226\t            bit_depth,\n227\t            color_type,\n228\t            interlace: 0,\n229\t            compression: 0,\n230\t            filter: 0,\n231\t            chunks: Vec::new(),\n232\t        }\n233\t    }\n234\t\n235\t    pub fn interlace(mut self, v: u8) -> Builder {\n236\t        self.interlace = v;\n237\t        self\n238\t    }\n239\t\n240\t    pub fn ihdr_bytes(&self) -> Vec<u8> {\n241\t        let mut d = Vec::with_capacity(13);\n242\t        d.extend_from_slice(&self.width.to_be_bytes());\n243\t        d.extend_from_slice(&self.height.to_be_bytes());\n244\t        d.push(self.bit_depth);\n245\t        d.push(self.color_type);\n246\t        d.push(self.compression);\n247\t        d.push(self.filter);\n248\t        d.push(self.interlace);\n249\t        d\n250\t    }\n251\t\n252\t    pub fn add(mut self, name: &[u8; 4], data: Vec<u8>) -> Builder {\n253\t        self.chunks.push(Chunk::new(name, data));\n254\t        self\n255\t    }\n256\t\n257\t    pub fn add_chunk(mut self, c: Chunk) -> Builder {\n258\t        self.chunks.push(c);\n259\t        self\n260\t    }\n261\t\n262\t    /// Raw pre-compression data: every row filter type 0 with `fill` content.\n263\t    pub fn raw_rows(&self, seed: u64) -> Vec<u8> {\n264\t        let n = raw_size(\n265\t            self.width,\n266\t            self.height,\n267\t            self.color_type,\n268\t            self.bit_depth,\n269\t            self.interlace,\n270\t        );\n271\t        let mut out = Vec::with_capacity(n);\n272\t        let mut s = seed | 1;\n273\t        let mut next = || {\n274\t            s ^= s >> 12;\n275\t            s ^= s << 25;\n276\t            s ^= s >> 27;\n277\t            (s.wrapping_mul(0x2545_F491_4F6C_DD1D) >> 33) as u8\n278\t        };\n279\t        if self.interlace == 0 {\n280\t            let rb = rowbytes(self.color_type, self.bit_depth, self.width);\n281\t            for _ in 0..self.height {\n282\t                out.push(0);\n283\t                for _ in 0..rb {\n284\t                    out.push(next());\n285\t                }\n286\t            }\n287\t        } else {\n288\t            for p in 0..7 {\n289\t                let w = pass_width(self.width, p);\n290\t                let h = pass_height(self.height, p);\n291\t                if w == 0 || h == 0 {\n292\t                    continue;\n293\t                }\n294\t                let rb = rowbytes(self.color_type, self.bit_depth, w);\n295\t                for _ in 0..h {\n296\t                    out.push(0);\n297\t                    for _ in 0..rb {\n298\t                        out.push(next());\n299\t                    }\n300\t                }\n301\t            }\n302\t        }\n303\t        out\n304\t    }\n305\t\n306\t    /// Assemble: signature, IHDR, the added chunks, IDAT(s), IEND.\n307\t    pub fn build(&self, idat_payload: &[u8], idat_split: usize) -> Vec<u8> {\n308\t        let mut chunks = vec![Chunk::new(b\"IHDR\", self.ihdr_bytes())];\n309\t        chunks.extend(self.chunks.iter().cloned());\n310\t        let z = zlib_stored(idat_payload);\n311\t        if idat_split == 0 || z.len() <= idat_split {\n312\t            chunks.push(Chunk::new(b\"IDAT\", z));\n313\t        } else {\n314\t            for part in z.chunks(idat_split) {\n315\t                chunks.push(Chunk::new(b\"IDAT\", part.to_vec()));\n316\t            }\n317\t        }\n318\t        chunks.push(Chunk::new(b\"IEND\", Vec::new()));\n319\t        join(&chunks)\n320\t    }\n321\t\n322\t    /// Convenience: a complete, valid PNG with pseudo-random image content.\n323\t    pub fn build_valid(&self, seed: u64) -> Vec<u8> {\n324\t        let raw = self.raw_rows(seed);\n325\t        self.build(&raw, 0)\n326\t    }\n327\t}\n328\t"}]},"parent_tool_use_id":"toolu_bdrk_01466Nqb5z9B7fwBv76vVDfC","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"68529580-94aa-4da6-bc35-95386a2849c9","timestamp":"2026-08-14T15:46:38.276Z","subagent_type":"general-purpose","task_description":"Phase C read-stream error tests"}
