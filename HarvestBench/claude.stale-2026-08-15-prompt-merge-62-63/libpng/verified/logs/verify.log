{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MJCv4FpAJ2jUFtnm82X9bA","type":"tool_result","content":"{\n   png_uint_32 i; /* row index */\n   int pass, num_pass; /* pass variables */\n   png_bytepp rp; /* points to current row */\n\n   if (png_ptr == NULL)\n      return;\n\n   png_debug(1, \"in png_write_image\");\n\n#ifdef PNG_WRITE_INTERLACING_SUPPORTED\n   /* Initialize interlace handling.  If image is not interlaced,\n    * this will set pass to 1\n    */\n   num_pass = png_set_interlace_handling(png_ptr);\n#else\n   num_pass = 1;\n#endif\n   /* Loop through passes */\n   for (pass = 0; pass < num_pass; pass++)\n   {\n      /* Loop through image */\n      for (i = 0, rp = image; i < png_ptr->height; i++, rp++)\n      {\n         png_write_row(png_ptr, *rp);\n      }\n   }\n}\n\n#ifdef PNG_MNG_FEATURES_SUPPORTED\n/* Performs intrapixel differencing  */\nstatic void\npng_do_write_intrapixel(png_row_infop row_info, png_bytep row)\n{\n   png_debug(1, \"in png_do_write_intrapixel\");\n\n   if ((row_info->color_type & PNG_COLOR_MASK_COLOR) != 0)\n   {\n      int bytes_per_pixel;\n      png_uint_32 row_width = row_info->width;\n      if (row_info->bit_depth == 8)\n      {\n         png_bytep rp;\n         png_uint_32 i;\n\n         if (row_info->color_type == PNG_COLOR_TYPE_RGB)\n            bytes_per_pixel = 3;\n\n         else if (row_info->color_type == PNG_COLOR_TYPE_RGB_ALPHA)\n            bytes_per_pixel = 4;\n\n         else\n            return;\n\n         for (i = 0, rp = row; i < row_width; i++, rp += bytes_per_pixel)\n         {\n            *(rp)     = (png_byte)(*rp       - *(rp + 1));\n            *(rp + 2) = (png_byte)(*(rp + 2) - *(rp + 1));\n         }\n      }\n\n#ifdef PNG_WRITE_16BIT_SUPPORTED\n      else if (row_info->bit_depth == 16)\n      {\n         png_bytep rp;\n         png_uint_32 i;\n\n         if (row_info->color_type == PNG_COLOR_TYPE_RGB)\n            bytes_per_pixel = 6;\n\n         else if (row_info->color_type == PNG_COLOR_TYPE_RGB_ALPHA)\n            bytes_per_pixel = 8;\n\n         else\n            return;\n\n         for (i = 0, rp = row; i < row_width; i++, rp += bytes_per_pixel)\n         {\n            png_uint_32 s0   = (png_uint_32)(*(rp    ) << 8) | *(rp + 1);\n            png_uint_32 s1   = (png_uint_32)(*(rp + 2) << 8) | *(rp + 3);\n            png_uint_32 s2   = (png_uint_32)(*(rp + 4) << 8) | *(rp + 5);\n            png_uint_32 red  = (png_uint_32)((s0 - s1) & 0xffffL);\n            png_uint_32 blue = (png_uint_32)((s2 - s1) & 0xffffL);\n            *(rp    ) = (png_byte)(red >> 8);\n            *(rp + 1) = (png_byte)red;\n            *(rp + 4) = (png_byte)(blue >> 8);\n            *(rp + 5) = (png_byte)blue;\n         }\n      }\n#endif /* WRITE_16BIT */\n   }\n}\n#endif /* MNG_FEATURES */\n\n/* Called by user to write a row of image data */\nvoid PNGAPI\npng_write_row(png_structrp png_ptr, png_const_bytep row)\n{\n   /* 1.5.6: moved from png_struct to be a local structure: */\n   png_row_info row_info;\n\n   png_debug2(1, \"in png_write_row (row %u, pass %d)\",\n       png_ptr->row_number, png_ptr->pass);\n\n   if (png_ptr == NULL)\n      return;\n\n   /* Initialize transformations and other stuff if first time */\n   if (png_ptr->row_number == 0 && png_ptr->pass == 0)\n   {\n      /* Make sure we wrote the header info */\n      if ((png_ptr->mode & PNG_WROTE_INFO_BEFORE_PLTE) == 0)\n         png_error(png_ptr,\n             \"png_write_info was never called before png_write_row\");\n\n      /* Check for transforms that have been set but were defined out */\n#if !defined(PNG_WRITE_INVERT_SUPPORTED) && defined(PNG_READ_INVERT_SUPPORTED)\n      if ((png_ptr->transformations & PNG_INVERT_MONO) != 0)\n         png_warning(png_ptr, \"PNG_WRITE_INVERT_SUPPORTED is not defined\");\n#endif\n\n#if !defined(PNG_WRITE_FILLER_SUPPORTED) && defined(PNG_READ_FILLER_SUPPORTED)\n      if ((png_ptr->transformations & PNG_FILLER) != 0)\n         png_warning(png_ptr, \"PNG_WRITE_FILLER_SUPPORTED is not defined\");\n#endif\n#if !defined(PNG_WRITE_PACKSWAP_SUPPORTED) && \\\n    defined(PNG_READ_PACKSWAP_SUPPORTED)\n      if ((png_ptr->transformations & PNG_PACKSWAP) != 0)\n         png_warning(png_ptr,\n             \"PNG_WRITE_PACKSWAP_SUPPORTED is not defined\");\n#endif\n\n#if !defined(PNG_WRITE_PACK_SUPPORTED) && defined(PNG_READ_PACK_SUPPORTED)\n      if ((png_ptr->transformations & PNG_PACK) != 0)\n         png_warning(png_ptr, \"PNG_WRITE_PACK_SUPPORTED is not defined\");\n#endif\n\n#if !defined(PNG_WRITE_SHIFT_SUPPORTED) && defined(PNG_READ_SHIFT_SUPPORTED)\n      if ((png_ptr->transformations & PNG_SHIFT) != 0)\n         png_warning(png_ptr, \"PNG_WRITE_SHIFT_SUPPORTED is not defined\");\n#endif\n\n#if !defined(PNG_WRITE_BGR_SUPPORTED) && defined(PNG_READ_BGR_SUPPORTED)\n      if ((png_ptr->transformations & PNG_BGR) != 0)\n         png_warning(png_ptr, \"PNG_WRITE_BGR_SUPPORTED is not defined\");\n#endif\n\n#if !defined(PNG_WRITE_SWAP_SUPPORTED) && defined(PNG_READ_SWAP_SUPPORTED)\n      if ((png_ptr->transformations & PNG_SWAP_BYTES) != 0)\n         png_warning(png_ptr, \"PNG_WRITE_SWAP_SUPPORTED is not defined\");\n#endif\n\n      png_write_start_row(png_ptr);\n   }\n\n#ifdef PNG_WRITE_INTERLACING_SUPPORTED\n   /* If interlaced and not interested in row, return */\n   if (png_ptr->interlaced != 0 &&\n       (png_ptr->transformations & PNG_INTERLACE) != 0)\n   {\n      switch (png_ptr->pass)\n      {\n         case 0:\n            if ((png_ptr->row_number & 0x07) != 0)\n            {\n               png_write_finish_row(png_ptr);\n               return;\n            }\n            break;\n\n         case 1:\n            if ((png_ptr->row_number & 0x07) != 0 || png_ptr->width < 5)\n            {\n               png_write_finish_row(png_ptr);\n               return;\n            }\n            break;\n\n         case 2:\n            if ((png_ptr->row_number & 0x07) != 4)\n            {\n               png_write_finish_row(png_ptr);\n               return;\n            }\n            break;\n\n         case 3:\n            if ((png_ptr->row_number & 0x03) != 0 || png_ptr->width < 3)\n            {\n               png_write_finish_row(png_ptr);\n               return;\n            }\n            break;\n\n         case 4:\n            if ((png_ptr->row_number & 0x03) != 2)\n            {\n               png_write_finish_row(png_ptr);\n               return;\n            }\n            break;\n\n         case 5:\n            if ((png_ptr->row_number & 0x01) != 0 || png_ptr->width < 2)\n            {\n               png_write_finish_row(png_ptr);\n               return;\n            }\n            break;\n\n         case 6:\n            if ((png_ptr->row_number & 0x01) == 0)\n            {\n               png_write_finish_row(png_ptr);\n               return;\n            }\n            break;\n\n         default: /* error: ignore it */\n            break;\n      }\n   }\n#endif\n\n   /* Set up row info for transformations */\n   row_info.color_type = png_ptr->color_type;\n   row_info.width = png_ptr->usr_width;\n   row_info.channels = png_ptr->usr_channels;\n   row_info.bit_depth = png_ptr->usr_bit_depth;\n   row_info.pixel_depth = (png_byte)(row_info.bit_depth * row_info.channels);\n   row_info.rowbytes = PNG_ROWBYTES(row_info.pixel_depth, row_info.width);\n\n   png_debug1(3, \"row_info->color_type = %d\", row_info.color_type);\n   png_debug1(3, \"row_info->width = %u\", row_info.width);\n   png_debug1(3, \"row_info->channels = %d\", row_info.channels);\n   png_debug1(3, \"row_info->bit_depth = %d\", row_info.bit_depth);\n   png_debug1(3, \"row_info->pixel_depth = %d\", row_info.pixel_depth);\n   png_debug1(3, \"row_info->rowbytes = %lu\", (unsigned long)row_info.rowbytes);\n\n   /* Copy user's row into buffer, leaving room for filter byte. */\n   memcpy(png_ptr->row_buf + 1, row, row_info.rowbytes);\n\n#ifdef PNG_WRITE_INTERLACING_SUPPORTED\n   /* Handle interlacing */\n   if (png_ptr->interlaced && png_ptr->pass < 6 &&\n       (png_ptr->transformations & PNG_INTERLACE) != 0)\n   {\n      png_do_write_interlace(&row_info, png_ptr->row_buf + 1, png_ptr->pass);\n      /* This should always get caught above, but still ... */\n      if (row_info.width == 0)\n      {\n         png_write_finish_row(png_ptr);\n         return;\n      }\n   }\n#endif\n\n#ifdef PNG_WRITE_TRANSFORMS_SUPPORTED\n   /* Handle other transformations */\n   if (png_ptr->transformations != 0)\n      png_do_write_transformations(png_ptr, &row_info);\n#endif\n\n   /* At this point the row_info pixel depth must match the 'transformed' depth,\n    * which is also the output depth.\n    */\n   if (row_info.pixel_depth != png_ptr->pixel_depth ||\n       row_info.pixel_depth != png_ptr->transformed_pixel_depth)\n      png_error(png_ptr, \"internal write transform logic error\");\n\n#ifdef PNG_MNG_FEATURES_SUPPORTED\n   /* Write filter_method 64 (intrapixel differencing) only if\n    * 1. Libpng was compiled with PNG_MNG_FEATURES_SUPPORTED and\n    * 2. Libpng did not write a PNG signature (this filter_method is only\n    *    used in PNG datastreams that are embedded in MNG datastreams) and\n    * 3. The application called png_permit_mng_features with a mask that\n    *    included PNG_FLAG_MNG_FILTER_64 and\n    * 4. The filter_method is 64 and\n    * 5. The color_type is RGB or RGBA\n    */\n   if ((png_ptr->mng_features_permitted & PNG_FLAG_MNG_FILTER_64) != 0 &&\n       (png_ptr->filter_type == PNG_INTRAPIXEL_DIFFERENCING))\n   {\n      /* Intrapixel differencing */\n      png_do_write_intrapixel(&row_info, png_ptr->row_buf + 1);\n   }\n#endif\n\n/* Added at libpng-1.5.10 */\n#ifdef PNG_WRITE_CHECK_FOR_INVALID_INDEX_SUPPORTED\n   /* Check for out-of-range palette index */\n   if (row_info.color_type == PNG_COLOR_TYPE_PALETTE &&\n       png_ptr->num_palette_max >= 0)\n      png_do_check_palette_indexes(png_ptr, &row_info);\n#endif\n\n   /* Find a filter if necessary, filter the row and write it out. */\n   png_write_find_filter(png_ptr, &row_info);\n\n   if (png_ptr->write_row_fn != NULL)\n      (*(png_ptr->write_row_fn))(png_ptr, png_ptr->row_number, png_ptr->pass);\n}\n\n#ifdef PNG_WRITE_FLUSH_SUPPORTED\n/* Set the automatic flush interval or 0 to turn flushing off */\nvoid PNGAPI\npng_set_flush(png_structrp png_ptr, int nrows)\n{\n   png_debug(1, \"in png_set_flush\");\n\n   if (png_ptr == NULL)","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_0142wgcwC4DU2gkmXGMTmwBC","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"a11f096e-1c42-4908-9db4-7750d84a0d21","timestamp":"2026-08-14T15:41:26.790Z","subagent_type":"general-purpose","task_description":"Write write_b tests W13-W24"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01M9eZ6FKf4dukfd9tnXFKAC","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both the reference C `libpng.so` and the translated Rust `liblibpng.so` are\n4\t//! loaded with `libloading`; every call goes through the dynamic symbol table,\n5\t//! so the `#[no_mangle]` export wrappers are exercised exactly as an external\n6\t//! consumer would exercise them.\n7\t//!\n8\t//! Each driver produces a *trace*: a `Vec<String>` of every observable event\n9\t//! (return values, warning/error messages, produced bytes, decoded rows).  A\n10\t//! configuration passes when the C trace and the Rust trace are identical.\n11\t#![allow(dead_code)]\n12\t#![allow(non_camel_case_types)]\n13\t#![allow(non_snake_case)]\n14\t\n15\tuse std::cell::RefCell;\n16\tuse std::ffi::{c_char, c_int, c_void, CStr};\n17\tuse std::path::{Path, PathBuf};\n18\tuse std::process::Command;\n19\tuse std::sync::OnceLock;\n20\t\n21\tpub const VER_STRING: &[u8] = b\"1.6.59.git\\0\";\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// Library loading\n25\t// ---------------------------------------------------------------------------\n26\t\n27\tpub struct Lib {\n28\t    lib: libloading::Library,\n29\t    pub tag: &'static str,\n30\t}\n31\t\n32\timpl Lib {\n33\t    pub fn open(path: &Path, tag: &'static str) -> Lib {\n34\t        let lib = unsafe { libloading::Library::new(path) }\n35\t            .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {e}\", path.display()));\n36\t        Lib { lib, tag }\n37\t    }\n38\t\n39\t    /// Resolve `name` and transmute it to the requested function-pointer type.\n40\t    pub fn f<T: Copy>(&self, name: &str) -> T {\n41\t        assert_eq!(\n42\t            std::mem::size_of::<T>(),\n43\t            std::mem::size_of::<*const c_void>(),\n44\t            \"f::<T>() is only for pointer-sized types\"\n45\t        );\n46\t        let p = self.raw(name);\n47\t        unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n48\t    }\n49\t\n50\t    /// Resolve `name`, returning `None` when the symbol is absent.\n51\t    pub fn opt<T: Copy>(&self, name: &str) -> Option<T> {\n52\t        let mut owned = name.as_bytes().to_vec();\n53\t        owned.push(0);\n54\t        let sym: Result<libloading::Symbol<*const c_void>, _> = unsafe { self.lib.get(&owned) };\n55\t        sym.ok().map(|s| {\n56\t            let p = unsafe { *s };\n57\t            unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n58\t        })\n59\t    }\n60\t\n61\t    pub fn raw(&self, name: &str) -> *const c_void {\n62\t        let mut owned = name.as_bytes().to_vec();\n63\t        owned.push(0);\n64\t        let sym: libloading::Symbol<*const c_void> = unsafe { self.lib.get(&owned) }\n65\t            .unwrap_or_else(|e| panic!(\"{}: missing symbol {name}: {e}\", self.tag));\n66\t        unsafe { *sym }\n67\t    }\n68\t\n69\t    /// Address of an exported data object.\n70\t    pub fn data(&self, name: &str) -> *const u8 {\n71\t        self.raw(name) as *const u8\n72\t    }\n73\t}\n74\t\n75\tfn manifest_dir() -> PathBuf {\n76\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n77\t}\n78\t\n79\tpub fn c_so_path() -> PathBuf {\n80\t    if let Ok(p) = std::env::var(\"PNG_C_SO\") {\n81\t        return PathBuf::from(p);\n82\t    }\n83\t    let p = manifest_dir().join(\"target/cbuild/libpng.so\");\n84\t    assert!(\n85\t        p.exists(),\n86\t        \"C reference library not built: {} missing (cmake -S c_src -B target/cbuild && cmake --build target/cbuild)\",\n87\t        p.display()\n88\t    );\n89\t    p\n90\t}\n91\t\n92\tpub fn rust_so_path() -> PathBuf {\n93\t    if let Ok(p) = std::env::var(\"PNG_RUST_SO\") {\n94\t        return PathBuf::from(p);\n95\t    }\n96\t    // The integration test binary lives in target/<profile>/deps/, so the\n97\t    // cdylib is one directory up.\n98\t    let exe = std::env::current_exe().expect(\"current_exe\");\n99\t    let dir = exe.parent().unwrap().parent().unwrap();\n100\t    for name in [\"liblibpng.so\", \"libpng.so\"] {\n101\t        let p = dir.join(name);\n102\t        if p.exists() {\n103\t            return p;\n104\t        }\n105\t    }\n106\t    panic!(\"Rust cdylib not found next to {}\", exe.display());\n107\t}\n108\t\n109\tpub struct Pair {\n110\t    pub c: Lib,\n111\t    pub rust: Lib,\n112\t}\n113\t\n114\tstatic PAIR: OnceLock<Pair> = OnceLock::new();\n115\t\n116\tpub fn pair() -> &'static Pair {\n117\t    PAIR.get_or_init(|| {\n118\t        // Load the shim first so the landing pad exists before any png_error.\n119\t        shim();\n120\t        Pair {\n121\t            c: Lib::open(&c_so_path(), \"C\"),\n122\t            rust: Lib::open(&rust_so_path(), \"RUST\"),\n123\t        }\n124\t    })\n125\t}\n126\t\n127\t// ---------------------------------------------------------------------------\n128\t// setjmp/longjmp shim\n129\t// ---------------------------------------------------------------------------\n130\t\n131\tpub type ThFn = Option<unsafe extern \"C\" fn(*mut c_void)>;\n132\t\n133\tpub struct Shim {\n134\t    _lib: libloading::Library,\n135\t    protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int,\n136\t    pub longjmp_ptr: *const c_void,\n137\t    pub jmp_buf_size: usize,\n138\t}\n139\t\n140\tunsafe impl Send for Shim {}\n141\tunsafe impl Sync for Shim {}\n142\t\n143\tstatic SHIM: OnceLock<Shim> = OnceLock::new();\n144\t\n145\tpub fn shim() -> &'static Shim {\n146\t    SHIM.get_or_init(|| {\n147\t        let src = manifest_dir().join(\"tests/support/testshim.c\");\n148\t        let out_dir = manifest_dir().join(\"target/testsupport\");\n149\t        std::fs::create_dir_all(&out_dir).unwrap();\n150\t        let so = out_dir.join(\"libtestshim.so\");\n151\t        // Compile to a unique file then rename: several test binaries may race.\n152\t        let tmp = out_dir.join(format!(\"libtestshim-{}.so\", std::process::id()));\n153\t        let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());\n154\t        let st = Command::new(&cc)\n155\t            .args([\"-O0\", \"-fPIC\", \"-shared\", \"-o\"])\n156\t            .arg(&tmp)\n157\t            .arg(&src)\n158\t            .status()\n159\t            .expect(\"failed to run C compiler for test shim\");\n160\t        assert!(st.success(), \"test shim compilation failed\");\n161\t        std::fs::rename(&tmp, &so).unwrap();\n162\t\n163\t        let lib = unsafe { libloading::Library::new(&so) }.expect(\"dlopen test shim\");\n164\t        let protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int = unsafe {\n165\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_protect\\0\").unwrap();\n166\t            std::mem::transmute(*s)\n167\t        };\n168\t        let longjmp_ptr = unsafe {\n169\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_longjmp\\0\").unwrap();\n170\t            *s\n171\t        };\n172\t        let size_fn: unsafe extern \"C\" fn() -> usize = unsafe {\n173\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_jmp_buf_size\\0\").unwrap();\n174\t            std::mem::transmute(*s)\n175\t        };\n176\t        let jmp_buf_size = unsafe { size_fn() };\n177\t        Shim {\n178\t            _lib: lib,\n179\t            protect,\n180\t            longjmp_ptr,\n181\t            jmp_buf_size,\n182\t        }\n183\t    })\n184\t}\n185\t\n186\t/// Run `f` with a longjmp landing pad installed.  Returns 0 when `f` completed\n187\t/// normally, non-zero when libpng (or a harness callback) performed a longjmp.\n188\t///\n189\t/// `f` must not own anything that needs dropping: a longjmp skips destructors.\n190\tpub fn protected<F: FnMut()>(mut f: F) -> c_int {\n191\t    unsafe extern \"C\" fn tramp<F: FnMut()>(p: *mut c_void) {\n192\t        unsafe { (*(p as *mut F))() }\n193\t    }\n194\t    let s = shim();\n195\t    unsafe { (s.protect)(Some(tramp::<F>), &mut f as *mut F as *mut c_void) }\n196\t}\n197\t\n198\t// ---------------------------------------------------------------------------\n199\t// Per-thread session state (trace log + simulated I/O)\n200\t// ---------------------------------------------------------------------------\n201\t\n202\t#[derive(Default)]\n203\tpub struct Session {\n204\t    pub log: Vec<String>,\n205\t    /// Bytes handed to the write callback.\n206\t    pub out: Vec<u8>,\n207\t    /// Bytes served by the read callback.\n208\t    pub input: Vec<u8>,\n209\t    pub rpos: usize,\n210\t    /// Trace every png_malloc/png_free through the user-memory callbacks.\n211\t    pub trace_alloc: bool,\n212\t    /// Count of live allocations made through the user-memory callbacks.\n213\t    pub live_allocs: i64,\n214\t    /// Make the write callback fail (longjmp) once this many bytes were written.\n215\t    pub write_limit: Option<usize>,\n216\t    /// Fail malloc after this many successful allocations.\n217\t    pub malloc_limit: Option<usize>,\n218\t    pub malloc_count: usize,\n219\t}\n220\t\n221\tthread_local! {\n222\t    static SESSION: RefCell<Session> = RefCell::new(Session::default());\n223\t}\n224\t\n225\tpub fn session_reset(input: Vec<u8>) {\n226\t    SESSION.with(|s| {\n227\t        let mut s = s.borrow_mut();\n228\t        *s = Session::default();\n229\t        s.input = input;\n230\t    });\n231\t}\n232\t\n233\tpub fn with_session<R>(f: impl FnOnce(&mut Session) -> R) -> R {\n234\t    SESSION.with(|s| f(&mut s.borrow_mut()))\n235\t}\n236\t\n237\tpub fn log(msg: impl AsRef<str>) {\n238\t    let m = msg.as_ref().to_string();\n239\t    SESSION.with(|s| s.borrow_mut().log.push(m));\n240\t}\n241\t\n242\tpub fn take_log() -> Vec<String> {\n243\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().log))\n244\t}\n245\t\n246\tpub fn take_out() -> Vec<u8> {\n247\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().out))\n248\t}\n249\t\n250\tpub fn cstr(p: *const c_char) -> String {\n251\t    if p.is_null() {\n252\t        return \"<null>\".to_string();\n253\t    }\n254\t    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()\n255\t}\n256\t\n257\tpub fn hex(b: &[u8]) -> String {\n258\t    let mut s = String::with_capacity(b.len() * 2);\n259\t    for x in b {\n260\t        s.push_str(&format!(\"{x:02x}\"));\n261\t    }\n262\t    s\n263\t}\n264\t\n265\t// ---------------------------------------------------------------------------\n266\t// libpng callbacks (identical for both libraries)\n267\t// ---------------------------------------------------------------------------\n268\t\n269\tpub unsafe extern \"C\" fn cb_error(_png: *mut c_void, msg: *const c_char) {\n270\t    log(format!(\"ERROR({})\", cstr(msg)));\n271\t    // Returning lets libpng call png_longjmp -> th_longjmp, which is what a\n272\t    // real application relies on.\n273\t}\n274\t\n275\tpub unsafe extern \"C\" fn cb_warning(_png: *mut c_void, msg: *const c_char) {\n276\t    log(format!(\"WARNING({})\", cstr(msg)));\n277\t}\n278\t\n279\tpub unsafe extern \"C\" fn cb_write(_png: *mut c_void, data: *mut u8, len: usize) {\n280\t    let mut over = false;\n281\t    SESSION.with(|s| {\n282\t        let mut s = s.borrow_mut();\n283\t        if len > 0 {\n284\t            let src = unsafe { std::slice::from_raw_parts(data, len) };\n285\t            s.out.extend_from_slice(src);\n286\t        }\n287\t        if let Some(lim) = s.write_limit {\n288\t            if s.out.len() > lim {\n289\t                over = true;\n290\t            }\n291\t        }\n292\t    });\n293\t    if over {\n294\t        log(\"WRITE_LIMIT\".to_string());\n295\t        th_longjmp_now(7);\n296\t    }\n297\t}\n298\t\n299\tpub unsafe extern \"C\" fn cb_flush(_png: *mut c_void) {\n300\t    log(\"FLUSH\".to_string());\n301\t}\n302\t\n303\tpub unsafe extern \"C\" fn cb_read(_png: *mut c_void, data: *mut u8, len: usize) {\n304\t    let mut short = false;\n305\t    SESSION.with(|s| {\n306\t        let mut s = s.borrow_mut();\n307\t        let avail = s.input.len().saturating_sub(s.rpos);\n308\t        if avail < len {\n309\t            short = true;\n310\t        } else {\n311\t            if len > 0 {\n312\t                let src = &s.input[s.rpos..s.rpos + len];\n313\t                unsafe { std::ptr::copy_nonoverlapping(src.as_ptr(), data, len) };\n314\t            }\n315\t            s.rpos += len;\n316\t        }\n317\t    });\n318\t    if short {\n319\t        log(\"READ_SHORT\".to_string());\n320\t        th_longjmp_now(3);\n321\t    }\n322\t}\n323\t\n324\t/// User-memory malloc callback: `png_malloc_ptr`.\n325\tpub unsafe extern \"C\" fn cb_malloc(_png: *mut c_void, size: usize) -> *mut c_void {\n326\t    let mut fail = false;\n327\t    SESSION.with(|s| {\n328\t        let mut s = s.borrow_mut();\n329\t        s.malloc_count += 1;\n330\t        if let Some(lim) = s.malloc_limit {\n331\t            if s.malloc_count > lim {\n332\t                fail = true;\n333\t            }\n334\t        }\n335\t        if s.trace_alloc {\n336\t            let n = s.malloc_count;\n337\t            s.log.push(format!(\"MALLOC(#{n},{size})\"));\n338\t        }\n339\t        if !fail {\n340\t            s.live_allocs += 1;\n341\t        }\n342\t    });\n343\t    if fail {\n344\t        return std::ptr::null_mut();\n345\t    }\n346\t    // Use calloc so that any dependence on uninitialised memory shows up\n347\t    // identically in both libraries.\n348\t    unsafe { libc_calloc(1, if size == 0 { 1 } else { size }) }\n349\t}\n350\t\n351\tpub unsafe extern \"C\" fn cb_free(_png: *mut c_void, p: *mut c_void) {\n352\t    SESSION.with(|s| {\n353\t        let mut s = s.borrow_mut();\n354\t        if s.trace_alloc {\n355\t            s.log.push(format!(\"FREE({})\", if p.is_null() { 0 } else { 1 }));\n356\t        }\n357\t        if !p.is_null() {\n358\t            s.live_allocs -= 1;\n359\t        }\n360\t    });\n361\t    if !p.is_null() {\n362\t        unsafe { libc_free(p) };\n363\t    }\n364\t}\n365\t\n366\textern \"C\" {\n367\t    #[link_name = \"calloc\"]\n368\t    fn libc_calloc(n: usize, size: usize) -> *mut c_void;\n369\t    #[link_name = \"free\"]\n370\t    fn libc_free(p: *mut c_void);\n371\t}\n372\t\n373\tpub fn th_longjmp_now(val: c_int) -> ! {\n374\t    let f: unsafe extern \"C\" fn(*mut c_void, c_int) =\n375\t        unsafe { std::mem::transmute(shim().longjmp_ptr) };\n376\t    unsafe { f(std::ptr::null_mut(), val) };\n377\t    unreachable!(\"th_longjmp returned\");\n378\t}\n379\t\n380\t// ---------------------------------------------------------------------------\n381\t// Trace comparison\n382\t// ---------------------------------------------------------------------------\n383\t\n384\tpub struct Trace {\n385\t    pub lines: Vec<String>,\n386\t    pub out: Vec<u8>,\n387\t    pub rc: c_int,\n388\t}\n389\t\n390\timpl Trace {\n391\t    pub fn render(&self) -> String {\n392\t        let mut s = String::new();\n393\t        s.push_str(&format!(\"rc={}\\n\", self.rc));\n394\t        for l in &self.lines {\n395\t            s.push_str(l);\n396\t            s.push('\\n');\n397\t        }\n398\t        s.push_str(&format!(\"out.len={}\\n\", self.out.len()));\n399\t        s.push_str(&format!(\"out={}\\n\", hex(&self.out)));\n400\t        s\n401\t    }\n402\t}\n403\t\n404\t/// Every distinct `ERROR(...)`/`WARNING(...)` line observed from the C library,\n405\t/// appended to `target/testsupport/observed_msgs.txt` for mechanical\n406\t/// ERRORS.md coverage accounting.\n407\tstatic SEEN: OnceLock<std::sync::Mutex<std::collections::HashSet<String>>> = OnceLock::new();\n408\t\n409\tpub fn record_messages(lines: &[String]) {\n410\t    let set = SEEN.get_or_init(|| std::sync::Mutex::new(std::collections::HashSet::new()));\n411\t    let mut fresh: Vec<String> = Vec::new();\n412\t    {\n413\t        let mut g = set.lock().unwrap();\n414\t        for l in lines {\n415\t            if l.starts_with(\"ERROR(\") || l.starts_with(\"WARNING(\") || l.starts_with(\"IMAGE_ERR(\")\n416\t            {\n417\t                if g.insert(l.clone()) {\n418\t                    fresh.push(l.clone());\n419\t                }\n420\t            }\n421\t        }\n422\t    }\n423\t    if fresh.is_empty() {\n424\t        return;\n425\t    }\n426\t    use std::io::Write;\n427\t    let dir = manifest_dir().join(\"target/testsupport\");\n428\t    let _ = std::fs::create_dir_all(&dir);\n429\t    if let Ok(mut f) = std::fs::OpenOptions::new()\n430\t        .create(true)\n431\t        .append(true)\n432\t        .open(dir.join(\"observed_msgs.txt\"))\n433\t    {\n434\t        for l in fresh {\n435\t            let _ = writeln!(f, \"{l}\");\n436\t        }\n437\t    }\n438\t}\n439\t\n440\t/// Run one driver closure against both libraries and require identical traces.\n441\tpub fn diff(label: &str, mut run: impl FnMut(&Lib) -> Trace) {\n442\t    let p = pair();\n443\t    let ct = run(&p.c);\n444\t    let rt = run(&p.rust);\n445\t    record_messages(&ct.lines);\n446\t    if ct.render() != rt.render() {\n447\t        let a = ct.render();\n448\t        let b = rt.render();\n449\t        let mut first = String::new();\n450\t        for (i, (la, lb)) in a.lines().zip(b.lines()).enumerate() {\n451\t            if la != lb {\n452\t                let sa = clip(la);\n453\t                let sb = clip(lb);\n454\t                first = format!(\"first divergence at trace line {i}:\\n  C   : {sa}\\n  RUST: {sb}\");\n455\t                break;\n456\t            }\n457\t        }\n458\t        if first.is_empty() {\n459\t            let na = a.lines().count();\n460\t            let nb = b.lines().count();\n461\t            first = format!(\"trace lengths differ: C={na} lines, RUST={nb} lines\");\n462\t        }\n463\t        panic!(\"[{label}] C and Rust diverge\\n{first}\\n\");\n464\t    }\n465\t}\n466\t\n467\tfn clip(s: &str) -> String {\n468\t    if s.len() <= 400 {\n469\t        s.to_string()\n470\t    } else {\n471\t        format!(\"{}...<{} bytes total>\", &s[..400], s.len())\n472\t    }\n473\t}\n474\t\n475\t// ---------------------------------------------------------------------------\n476\t// Deterministic PRNG (xorshift64*) so every test is reproducible.\n477\t// ---------------------------------------------------------------------------\n478\t\n479\tpub struct Rng(pub u64);\n480\t\n481\timpl Rng {\n482\t    pub fn new(seed: u64) -> Rng {\n483\t        Rng(seed | 1)\n484\t    }\n485\t    pub fn next_u64(&mut self) -> u64 {\n486\t        let mut x = self.0;\n487\t        x ^= x >> 12;\n488\t        x ^= x << 25;\n489\t        x ^= x >> 27;\n490\t        self.0 = x;\n491\t        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n492\t    }\n493\t    pub fn next_u32(&mut self) -> u32 {\n494\t        (self.next_u64() >> 32) as u32\n495\t    }\n496\t    pub fn below(&mut self, n: u32) -> u32 {\n497\t        if n == 0 {\n498\t            0\n499\t        } else {\n500\t            self.next_u32() % n\n501\t        }\n502\t    }\n503\t    pub fn byte(&mut self) -> u8 {\n504\t        (self.next_u64() >> 24) as u8\n505\t    }\n506\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n507\t        (0..n).map(|_| self.byte()).collect()\n508\t    }\n509\t    pub fn f64(&mut self) -> f64 {\n510\t        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64\n511\t    }\n512\t}\n513\t\n514\t// ---------------------------------------------------------------------------\n515\t// Sub-modules\n516\t// ---------------------------------------------------------------------------\n517\t\n518\tpub mod core;\n519\tpub mod pngbuild;\n520\t\n521\tuse crate::support::core::{Cb, Core, Info, Png};\n522\t\n523\t/// Create a write struct wired to the harness callbacks, run `body`, destroy.\n524\tpub fn with_write(lib: &Lib, body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n525\t    session_reset(Vec::new());\n526\t    let core = Core::new(lib);\n527\t    let rc = protected(|| unsafe {\n528\t        let png = (core.create_write)(\n529\t            VER_STRING.as_ptr() as *const c_char,\n530\t            std::ptr::null_mut(),\n531\t            cb_error as Cb,\n532\t            cb_warning as Cb,\n533\t        );\n534\t        log(format!(\"create_write={}\", if png.is_null() { 0 } else { 1 }));\n535\t        if png.is_null() {\n536\t            return;\n537\t        }\n538\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n539\t        (core.set_write_fn)(png, std::ptr::null_mut(), cb_write as Cb, cb_flush as Cb);\n540\t        let info = (core.create_info)(png);\n541\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n542\t        body(&core, png, info);\n543\t        let mut p = png;\n544\t        let mut i = info;\n545\t        (core.destroy_write)(&mut p, &mut i);\n546\t        log(\"destroyed\".to_string());\n547\t    });\n548\t    Trace {\n549\t        lines: take_log(),\n550\t        out: take_out(),\n551\t        rc,\n552\t    }\n553\t}\n554\t\n555\t/// Create a read struct fed from `input`, run `body`, destroy.\n556\tpub fn with_read(lib: &Lib, input: &[u8], body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n557\t    session_reset(input.to_vec());\n558\t    let core = Core::new(lib);\n559\t    let rc = protected(|| unsafe {\n560\t        let png = (core.create_read)(\n561\t            VER_STRING.as_ptr() as *const c_char,\n562\t            std::ptr::null_mut(),\n563\t            cb_error as Cb,\n564\t            cb_warning as Cb,\n565\t        );\n566\t        log(format!(\"create_read={}\", if png.is_null() { 0 } else { 1 }));\n567\t        if png.is_null() {\n568\t            return;\n569\t        }\n570\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n571\t        (core.set_read_fn)(png, std::ptr::null_mut(), cb_read as Cb);\n572\t        let info = (core.create_info)(png);\n573\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n574\t        body(&core, png, info);\n575\t        let mut p = png;\n576\t        let mut i = info;\n577\t        (core.destroy_read)(&mut p, &mut i, std::ptr::null_mut());\n578\t        log(\"destroyed\".to_string());\n579\t    });\n580\t    Trace {\n581\t        lines: take_log(),\n582\t        out: take_out(),\n583\t        rc,\n584\t    }\n585\t}\n586\t\n587\t/// Log every ancillary-information getter, so that any divergence in the\n588\t/// decoded info struct shows up in the trace.\n589\tpub unsafe fn log_all_info(c: &Core, png: Png, info: Info) {\n590\t    use crate::support::core::*;\n591\t    let mut w = 0u32;\n592\t    let mut h = 0u32;\n593\t    let (mut bd, mut ct, mut il, mut cm, mut fm) = (0, 0, 0, 0, 0);\n594\t    let r = (c.get_IHDR)(png, info, &mut w, &mut h, &mut bd, &mut ct, &mut il, &mut cm, &mut fm);\n595\t    log(format!(\n596\t        \"IHDR rc={r} w={w} h={h} depth={bd} color={ct} interlace={il} comp={cm} filter={fm}\"\n597\t    ));\n598\t    log(format!(\n599\t        \"rowbytes={} channels={} palette_max={}\",\n600\t        (c.get_rowbytes)(png, info),\n601\t        (c.get_channels)(png, info),\n602\t        (c.get_palette_max)(png, info)\n603\t    ));\n604\t    let mut valid = 0u32;\n605\t    for (name, flag) in [\n606\t        (\"gAMA\", PNG_INFO_gAMA),\n607\t        (\"sBIT\", PNG_INFO_sBIT),\n608\t        (\"cHRM\", PNG_INFO_cHRM),\n609\t        (\"PLTE\", PNG_INFO_PLTE),\n610\t        (\"tRNS\", PNG_INFO_tRNS),\n611\t        (\"bKGD\", PNG_INFO_bKGD),\n612\t        (\"hIST\", PNG_INFO_hIST),\n613\t        (\"pHYs\", PNG_INFO_pHYs),\n614\t        (\"oFFs\", PNG_INFO_oFFs),\n615\t        (\"tIME\", PNG_INFO_tIME),\n616\t        (\"pCAL\", PNG_INFO_pCAL),\n617\t        (\"sRGB\", PNG_INFO_sRGB),\n618\t        (\"iCCP\", PNG_INFO_iCCP),\n619\t        (\"sPLT\", PNG_INFO_sPLT),\n620\t        (\"sCAL\", PNG_INFO_sCAL),\n621\t        (\"IDAT\", PNG_INFO_IDAT),\n622\t        (\"eXIf\", PNG_INFO_eXIf),\n623\t        (\"cICP\", PNG_INFO_cICP),\n624\t        (\"cLLI\", PNG_INFO_cLLI),\n625\t        (\"mDCV\", PNG_INFO_mDCV),\n626\t    ] {\n627\t        let v = (c.get_valid)(png, info, flag);\n628\t        if v != 0 {\n629\t            valid |= flag;\n630\t        }\n631\t        log(format!(\"valid.{name}={v}\"));\n632\t    }\n633\t\n634\t    // PLTE\n635\t    let mut pal: *mut u8 = std::ptr::null_mut();\n636\t    let mut npal: c_int = -1;\n637\t    let r = (c.get_PLTE)(png, info, &mut pal, &mut npal);\n638\t    log(format!(\"PLTE rc={r} n={npal}\"));\n639\t    if r != 0 && !pal.is_null() && npal > 0 {\n640\t        let s = std::slice::from_raw_parts(pal, npal as usize * 3);\n641\t        log(format!(\"PLTE data={}\", hex(s)));\n642\t    }\n643\t    // tRNS\n644\t    let mut ta: *mut u8 = std::ptr::null_mut();\n645\t    let mut nt: c_int = -1;\n646\t    let mut tc: *mut u8 = std::ptr::null_mut();\n647\t    let r = (c.get_tRNS)(png, info, &mut ta, &mut nt, &mut tc);\n648\t    log(format!(\"tRNS rc={r} n={nt}\"));\n649\t    if r != 0 && !ta.is_null() && nt > 0 {\n650\t        log(format!(\n651\t            \"tRNS alpha={}\",\n652\t            hex(std::slice::from_raw_parts(ta, nt as usize))\n653\t        ));\n654\t    }\n655\t    if r != 0 && !tc.is_null() {\n656\t        let v = *(tc as *const PngColor16);\n657\t        log(format!(\n658\t            \"tRNS color idx={} r={} g={} b={} gray={}\",\n659\t            v.index, v.red, v.green, v.blue, v.gray\n660\t        ));\n661\t    }\n662\t    // gAMA\n663\t    let mut g: i32 = -1;\n664\t    log(format!(\n665\t        \"gAMA rc={} v={g}\",\n666\t        (c.get_gAMA_fixed)(png, info, &mut g)\n667\t    ));\n668\t    let mut gd: f64 = -1.0;\n669\t    log(format!(\n670\t        \"gAMA_fp rc={} v={:.10}\",\n671\t        (c.get_gAMA)(png, info, &mut gd),\n672\t        gd\n673\t    ));\n674\t    // sRGB\n675\t    let mut intent: c_int = -1;\n676\t    log(format!(\n677\t        \"sRGB rc={} intent={intent}\",\n678\t        (c.get_sRGB)(png, info, &mut intent)\n679\t    ));\n680\t    // cHRM\n681\t    let mut v = [0i32; 8];\n682\t    let r = (c.get_cHRM_fixed)(\n683\t        png, info, &mut v[0], &mut v[1], &mut v[2], &mut v[3], &mut v[4], &mut v[5], &mut v[6],\n684\t        &mut v[7],\n685\t    );\n686\t    log(format!(\"cHRM rc={r} {v:?}\"));\n687\t    let mut xyz = [0i32; 9];\n688\t    let r = (c.get_cHRM_XYZ_fixed)(\n689\t        png, info, &mut xyz[0], &mut xyz[1], &mut xyz[2], &mut xyz[3], &mut xyz[4], &mut xyz[5],\n690\t        &mut xyz[6], &mut xyz[7], &mut xyz[8],\n691\t    );\n692\t    log(format!(\"cHRM_XYZ rc={r} {xyz:?}\"));\n693\t    // iCCP\n694\t    let mut name: *mut c_char = std::ptr::null_mut();\n695\t    let mut comp: c_int = -1;\n696\t    let mut prof: *mut u8 = std::ptr::null_mut();\n697\t    let mut plen: u32 = 0;\n698\t    let r = (c.get_iCCP)(png, info, &mut name, &mut comp, &mut prof, &mut plen);\n699\t    log(format!(\n700\t        \"iCCP rc={r} name={} comp={comp} len={plen}\",\n701\t        cstr(name)\n702\t    ));\n703\t    if r != 0 && !prof.is_null() && plen > 0 {\n704\t        log(format!(\n705\t            \"iCCP data={}\",\n706\t            hex(std::slice::from_raw_parts(prof, plen as usize))\n707\t        ));\n708\t    }\n709\t    // sBIT\n710\t    let mut sb: *mut u8 = std::ptr::null_mut();\n711\t    let r = (c.get_sBIT)(png, info, &mut sb);\n712\t    log(format!(\"sBIT rc={r}\"));\n713\t    if r != 0 && !sb.is_null() {\n714\t        let v = *(sb as *const PngColor8);\n715\t        log(format!(\"sBIT v={v:?}\"));\n716\t    }\n717\t    // bKGD\n718\t    let mut bk: *mut u8 = std::ptr::null_mut();\n719\t    let r = (c.get_bKGD)(png, info, &mut bk);\n720\t    log(format!(\"bKGD rc={r}\"));\n721\t    if r != 0 && !bk.is_null() {\n722\t        let v = *(bk as *const PngColor16);\n723\t        log(format!(\"bKGD v={v:?}\"));\n724\t    }\n725\t    // hIST\n726\t    let mut hi: *mut u16 = std::ptr::null_mut();\n727\t    let r = (c.get_hIST)(png, info, &mut hi);\n728\t    log(format!(\"hIST rc={r}\"));\n729\t    if r != 0 && !hi.is_null() && npal > 0 {\n730\t       