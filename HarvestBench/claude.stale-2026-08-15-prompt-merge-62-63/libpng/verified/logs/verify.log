{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011GVjtap8qVAHWE62vxxT6Y","type":"tool_result","content":"368\t}\n369\t\n370\t// ===========================================================================\n371\t// M2 — png_set_error_fn / png_get_error_ptr\n372\t// ===========================================================================\n373\t//\n374\t// With a NULL error_fn libpng uses png_default_error, which prints to stderr and\n375\t// then calls png_longjmp -> our th_longjmp pad, so the default path is safe\n376\t// here.  A NULL warning_fn selects png_default_warning (stderr only).  Nothing\n377\t// but the *observable* behaviour (whether the harness callback fired, and\n378\t// whether control came back through the pad) is compared.\n379\t\n380\t#[test]\n381\tfn m2_error_fn() {\n382\t    let tag_a: [u8; 8] = *b\"ERRPTRA\\0\";\n383\t    let tag_b: [u8; 8] = *b\"ERRPTRB\\0\";\n384\t    let good = Builder::new(4, 3, 8, 0).build_valid(0x1200_0001);\n385\t    let badcrc = Builder::new(4, 3, 8, 0)\n386\t        .add_chunk(Chunk::new(b\"tEXt\", b\"K\\0v\".to_vec()).bad_crc())\n387\t        .build_valid(0x1200_0002);\n388\t    // bit depth 3 is illegal: png_read_info issues a real png_error\n389\t    let badihdr = Builder::new(4, 3, 3, 0).build_valid(0x1200_0003);\n390\t    let inputs: Vec<(&str, &Vec<u8>)> = vec![\n391\t        (\"valid\", &good),\n392\t        (\"bad-crc-tEXt\", &badcrc),\n393\t        (\"bad-IHDR\", &badihdr),\n394\t    ];\n395\t\n396\t    for (iname, data) in &inputs {\n397\t        for &(ef, wf) in &[(false, false), (false, true), (true, false), (true, true)] {\n398\t            for &reset in &[false, true] {\n399\t                for &do_err in &[false, true] {\n400\t                    let label =\n401\t                        format!(\"M2 read {iname} err_fn={ef} warn_fn={wf} reset={reset} err={do_err}\");\n402\t                    diff(&label, |lib| {\n403\t                        let pa = tag_a.as_ptr() as *mut c_void;\n404\t                        let pb = tag_b.as_ptr() as *mut c_void;\n405\t                        let mut buf = [0u8; 32];\n406\t                        drive(lib, data, &mut |c| unsafe {\n407\t                            let p = (c.create_read)(\n408\t                                ver(),\n409\t                                pa,\n410\t                                if ef { cb_error as Cb } else { nullcb() },\n411\t                                if wf { cb_warning as Cb } else { nullcb() },\n412\t                            );\n413\t                            log(format!(\"create_read={}\", (!p.is_null()) as u8));\n414\t                            if p.is_null() {\n415\t                                return;\n416\t                            }\n417\t                            (c.set_longjmp)(p, shim().longjmp_ptr, shim().jmp_buf_size);\n418\t                            log(format!(\n419\t                                \"error_ptr_is_a={}\",\n420\t                                ((c.get_error_ptr)(p) == pa) as u8\n421\t                            ));\n422\t                            if reset {"}]},"parent_tool_use_id":"toolu_bdrk_01XHdnyMuFEuHb5xLVMQCDix","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"902ee6fe-755f-4253-b665-a64bc1e60459","timestamp":"2026-08-14T17:45:24.151Z","subagent_type":"general-purpose","task_description":"Cross-cutting modes tests M1-M8"}
