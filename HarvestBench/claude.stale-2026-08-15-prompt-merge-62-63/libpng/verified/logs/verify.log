 u16,\n456\t}\n457\t\n458\t/// `png_color_8 { png_byte red, green, blue, gray, alpha; }`\n459\t#[repr(C)]\n460\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n461\tpub struct PngColor8 {\n462\t    pub red: u8,\n463\t    pub green: u8,\n464\t    pub blue: u8,\n465\t    pub gray: u8,\n466\t    pub alpha: u8,\n467\t}\n468\t\n469\t/// `png_time { png_uint_16 year; png_byte month, day, hour, minute, second; }`\n470\t#[repr(C)]\n471\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n472\tpub struct PngTime {\n473\t    pub year: u16,\n474\t    pub month: u8,\n475\t    pub day: u8,\n476\t    pub hour: u8,\n477\t    pub minute: u8,\n478\t    pub second: u8,\n479\t}\n480\t\n481\t/// `png_text`\n482\t#[repr(C)]\n483\t#[derive(Clone, Copy)]\n484\tpub struct PngText {\n485\t    pub compression: c_int,\n486\t    pub key: *mut c_char,\n487\t    pub text: *mut c_char,\n488\t    pub text_length: usize,\n489\t    pub itxt_length: usize,\n490\t    pub lang: *mut c_char,\n491\t    pub lang_key: *mut c_char,\n492\t}\n493\t\n494\timpl Default for PngText {\n495\t    fn default() -> Self {\n496\t        PngText {\n497\t            compression: PNG_TEXT_COMPRESSION_NONE,\n498\t            key: std::ptr::null_mut(),\n499\t            text: std::ptr::null_mut(),\n500\t            text_length: 0,\n501\t            itxt_length: 0,\n502\t            lang: std::ptr::null_mut(),\n503\t            lang_key: std::ptr::null_mut(),\n504\t        }\n505\t    }\n506\t}\n507\t\n508\t/// `png_unknown_chunk { png_byte name[5]; png_byte *data; size_t size; png_byte location; }`\n509\t#[repr(C)]\n510\t#[derive(Clone, Copy)]\n511\tpub struct PngUnknownChunk {\n512\t    pub name: [u8; 5],\n513\t    pub data: *mut u8,\n514\t    pub size: usize,\n515\t    pub location: u8,\n516\t}\n517\t\n518\t/// `png_sPLT_t { png_charp name; png_byte depth; png_sPLT_entryp entries; png_int_32 nentries; }`\n519\t#[repr(C)]\n520\t#[derive(Clone, Copy)]\n521\tpub struct PngSpltT {\n522\t    pub name: *mut c_char,\n523\t    