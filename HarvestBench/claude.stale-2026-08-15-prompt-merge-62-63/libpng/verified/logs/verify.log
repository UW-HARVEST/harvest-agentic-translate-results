  {\n823\t      memcpy(info_ptr->palette, palette, (unsigned int)num_palette *\n824\t          (sizeof (png_color)));\n825\t      memcpy(png_ptr->palette, palette, (unsigned int)num_palette *\n826\t          (sizeof (png_color)));\n827\t   }\n828\t\n829\t   info_ptr->free_me |= PNG_FREE_PLTE;\n830\t   info_ptr->valid |= PNG_INFO_PLTE;\n831\t}\n832\t\n833\t#ifdef PNG_sBIT_SUPPORTED\n834\tvoid PNGAPI\n835\tpng_set_sBIT(png_const_structrp png_ptr, png_inforp info_ptr,\n836\t    png_const_color_8p sig_bit)\n837\t{\n838\t   png_debug1(1, \"in %s storage function\", \"sBIT\");\n839\t\n840\t   if (png_ptr == NULL || info_ptr == NULL || sig_bit == NULL)\n841\t      return;\n842\t\n843\t   info_ptr->sig_bit = *sig_bit;\n844\t   info_ptr->valid |= PNG_INFO_sBIT;\n845\t}\n846\t#endif\n847\t\n848\t#ifdef PNG_sRGB_SUPPORTED\n849\tvoid PNGAPI\n850\tpng_set_sRGB(png_const_structrp png_ptr, png_inforp info_ptr, int srgb_intent)\n851\t{\n852\t   png_debug1(1, \"in %s storage function\", \"sRGB\");\n853\t\n854\t   if (png_ptr == NULL || info_ptr == NULL)\n855\t      return;\n856\t\n857\t   info_ptr->rendering_intent = srgb_intent;\n858\t   info_ptr->valid |= PNG_INFO_sRGB;\n859\t}\n860\t\n861\tvoid PNGAPI\n862\tpng_set_sRGB_gAMA_and_cHRM(png_const_structrp png_ptr, png_inforp info_ptr,\n863\t    int srgb_intent)\n864\t{\n865\t   png_debug1(1, \"in %s storage function\", \"sRGB_gAMA_and_cHRM\");\n866\t\n867\t   if (png_ptr == NULL || info_ptr == NULL)\n868\t      return;\n869\t\n870\t   png_set_sRGB(png_ptr, info_ptr, srgb_intent);\n871\t\n872\t#  ifdef PNG_gAMA_SUPPORTED\n873\t      png_set_gAMA_fixed(png_ptr, info_ptr, PNG_GAMMA_sRGB_INVERSE);\n874\t#  endif /* gAMA */\n875\t\n876\t#  ifdef PNG_cHRM_SUPPORTED\n877\t      png_set_cHRM_fixed(png_ptr, info_ptr,\n878\t         /* color      x       y */\n879\t         /* white */ 31270, 32900,\n880\t         /* red   */ 64000, 33000,\n881\t         /* green */ 30000, 60000,\n882\t         /* blue  */ 15000,  6000);\n883\t#  endif /* cHRM */\n884\t}\n885\t#endif /* sRGB */\n886\t\n887\t\n888\t#ifdef PNG_iCCP_SUPPORTED\n889\tvoid PNGAPI\n890\tpng_set_iCCP(png_const_structrp png_ptr, png_inforp info_ptr,\n891\t    png_const_charp name, int compression_type,\n892\t    png_const_bytep profile, png_uint_32 proflen)\n893\t{\n894\t   png_charp new_iccp_name;\n895\t   png_bytep new_iccp_profile;\n896\t   size_t length;\n897\t\n898\t   png_debug1(1, \"in %s storage function\", \"iCCP\");\n899\t\n900\t   if (png_ptr == NULL || info_ptr == NULL || name == NULL || profile == NULL)\n901\t      return;\n902\t\n903\t   if (compression_type != PNG_COMPRESSION_TYPE_BASE)\n904\t      png_app_error(png_ptr, \"Invalid iCCP compression method\");\n905\t\n906\t   length = strlen(name)+1;\n907\t   new_iccp_name = png_voidcast(png_charp, png_malloc_warn(png_ptr, length));\n908\t\n909\t   if (new_iccp_name == NULL)\n910\t   {\n911\t      png_benign_error(png_ptr, \"Insufficient memory to process iCCP chunk\");\n912\t\n913\t      return;\n914\t   }\n915\t\n916\t   memcpy(new_iccp_name, name, length);\n917\t   new_iccp_profile = png_voidcast(png_bytep,\n918\t       png_malloc_warn(png_ptr, proflen));\n919\t\n920\t   if (new_iccp_profile == NULL)\n921\t   {\n922\t      png_free(png_ptr, new_iccp_name);\n923\t      png_benign_error(png_ptr,\n924\t          \"Insufficient memory to process iCCP profile\");\n925\t\n926\t      return;\n927\t   }\n928\t\n929\t   memcpy(new_iccp_profile, profile, proflen);\n930\t\n931\t   png_free_data(png_ptr, info_ptr, PNG_FREE_ICCP, 0);\n932\t\n933\t   info_ptr->iccp_proflen = proflen;\n934\t   info_ptr->iccp_name = new_iccp_name;\n935\t   info_ptr->iccp_profile = new_iccp_profile;\n936\t   info_ptr->free_me |= PNG_FREE_ICCP;\n937\t   info_ptr->valid |= PNG_INFO_iCCP;\n938\t}\n939\t#endif\n940\t\n941\t#ifdef PNG_TEXT_SUPPORTED\n942\tvoid PNGAPI\n943\tpng_set_text(png_const_structrp png_ptr, png_inforp info_ptr,\n944\t    png_const_textp text_ptr, int num_text)\n945\t{\n946\t   int ret;\n947\t   ret = png_set_text_2(png_ptr, info_ptr, text_ptr, num_text);\n948\t\n949\t   if (ret != 0)\n950\t      png_error(png_ptr, \"Insufficient memory to store text\");\n951\t}\n952\t\n953\tint /* PRIVATE */\n954\tpng_set_text_2(png_const_structrp png_ptr, png_inforp info_ptr,\n955\t    png_const_textp text_ptr, int num_text)\n956\t{\n957\t   int i;\n958\t   png_textp old_text = NULL;\n959\t\n960\t   png_debug1(1, \"in text storage function, chunk typeid = 0x%lx\",\n961\t      png_ptr == NULL ? 0xabadca11UL : (unsigned long)png_ptr->chunk_name);\n962\t\n963\t   if (png_ptr == NULL || info_ptr == NULL || num_text <= 0 || text_ptr == NULL)\n964\t      return 0;\n965\t\n966\t   /* Make sure we have enough space in the \"text\" array in info_struct\n967\t    * to hold all of the incoming text_ptr objects.  This compare can't overflow\n968\t    * because max_text >= num_text (anyway, subtract of two positive integers\n969\t    * can't overflow in any case.)\n970\t    */\n971\t   if (num_text > info_ptr->max_text - info_ptr->num_text)\n972\t   {\n973\t      int old_num_text = info_ptr->num_text;\n974\t      int max_text;\n975\t      png_textp new_text = NULL;\n976\t\n977\t      /* Calculate an appropriate max_text, checking for overflow. */\n978\t      max_text = old_num_text;\n979\t      if (num_text <= INT_MAX - max_text)\n980\t      {\n981\t         max_text += num_text;\n982\t\n983\t         /* Round up to a multiple of 8 */\n984\t         if (max_text < INT_MAX-8)\n985\t            max_text = (max_text + 8) & ~0x7;\n986\t\n987\t         else\n988\t            max_text = INT_MAX;\n989\t\n990\t         /* Now allocate a new array and copy the old members in; this does all\n991\t          * the overflow checks.\n992\t          */\n993\t         new_text = png_voidcast(png_textp,png_realloc_array(png_ptr,\n994\t             info_ptr->text, old_num_text, max_text-old_num_text,\n995\t             sizeof *new_text));\n996\t      }\n997\t\n998\t      if (new_text == NULL)\n999\t      {\n1000\t         png_chunk_report(png_ptr, \"too many text chunks\",\n1001\t             PNG_CHUNK_WRITE_ERROR);\n1002\t\n1003\t         return 1;\n1004\t      }\n1005\t\n1006\t      /* Defer freeing the old array until after the copy loop below,\n1007\t       * in case text_ptr aliases info_ptr->text (getter-to-setter).\n1008\t       */\n1009\t      old_text = info_ptr->text;\n1010\t\n1011\t      info_ptr->text = new_text;\n1012\t      info_ptr->free_me |= PNG_FREE_TEXT;\n1013\t      info_ptr->max_text = max_text;\n1014\t      /* num_text is adjusted below as the entries are copied in */\n1015\t\n1016\t      png_debug1(3, \"allocated %d entries for info_ptr->text\", max_text);\n1017\t   }\n1018\t\n1019\t   for (i = 0; i < num_text; i++)\n1020\t   {\n1021\t      size_t text_length, key_len;\n1022\t      size_t lang_len, lang_key_len;\n1023\t      png_textp textp = &(info_ptr->text[info_ptr->num_text]);\n1024\t\n1025\t      if (text_ptr[i].key == NULL)\n1026\t          continue;\n1027\t\n1028\t      if (text_ptr[i].compression < PNG_TEXT_COMPRESSION_NONE ||\n1029\t          text_ptr[i].compression >= PNG_TEXT_COMPRESSION_LAST)\n1030\t      {\n1031\t         png_chunk_report(png_ptr, \"text compression mode is out of range\",\n1032\t             PNG_CHUNK_WRITE_ERROR);\n1033\t         continue;\n1034\t      }\n1035\t\n1036\t      key_len = strlen(text_ptr[i].key);\n1037\t\n1038\t      if (text_ptr[i].compression <= 0)\n1039\t      {\n1040\t         lang_len = 0;\n1041\t         lang_key_len = 0;\n1042\t      }\n1043\t\n1044\t      else\n1045\t#  ifdef PNG_iTXt_SUPPORTED\n1046\t      {\n1047\t         /* Set iTXt data */\n1048\t\n1049\t         if (text_ptr[i].lang != NULL)\n1050\t            lang_len = strlen(text_ptr[i].lang);\n1051\t\n1052\t         else\n1053\t            lang_len = 0;\n1054\t\n1055\t         if (text_ptr[i].lang_key != NULL)\n1056\t            lang_key_len = strlen(text_ptr[i].lang_key);\n1057\t\n1058\t         else\n1059\t            lang_key_len = 0;\n1060\t      }\n1061\t#  else /* iTXt */\n1062\t      {\n1063\t         png_chunk_report(png_ptr, \"iTXt chunk not supported\",\n1064\t             PNG_CHUNK_WRITE_ERROR);\n1065\t         continue;\n1066\t      }\n1067\t#  endif\n1068\t\n1069\t      if (text_ptr[i].text == NULL || text_ptr[i].text[0] == '\\0')\n1070\t      {\n1071\t         text_length = 0;\n1072\t#  ifdef PNG_iTXt_SUPPORTED\n1073\t         if (text_ptr[i].compression > 0)\n1074\t            textp->compression = PNG_ITXT_COMPRESSION_NONE;\n1075\t\n1076\t         else\n1077\t#  endif\n1078\t            textp->compression = PNG_TEXT_COMPRESSION_NONE;\n1079\t      }\n1080\t\n1081\t      else\n1082\t      {\n1083\t         text_length = strlen(text_ptr[i].text);\n1084\t         textp->compression = text_ptr[i].compression;\n1085\t      }\n1086\t\n1087\t      textp->key = png_voidcast(png_charp,png_malloc_base(png_ptr,\n1088\t          key_len + text_length + lang_len + lang_key_len + 4));\n1089\t\n1090\t      if (textp->key == NULL)\n1091\t      {\n1092\t         png_chunk_report(png_ptr, \"text chunk: out of memory\",\n1093\t             PNG_CHUNK_WRITE_ERROR);\n1094\t         png_free(png_ptr, old_text);\n1095\t\n1096\t         return 1;\n1097\t      }\n1098\t\n1099\t      png_debug2(2, \"Allocated %lu bytes at %p in png_set_text\",\n1100\t          (unsigned long)(png_uint_32)\n1101\t          (key_len + lang_len + lang_key_len + text_length + 4),\n1102\t          textp->key);\n1103\t\n1104\t      memcpy(textp->key, text_ptr[i].key, key_len);\n1105\t      *(textp->key + key_len) = '\\0';\n1106\t\n1107\t      if (text_ptr[i].compression > 0)\n1108\t      {\n1109\t         textp->lang = textp->key + key_len + 1;\n1110\t         memcpy(textp->lang, text_ptr[i].lang, lang_len);\n1111\t         *(textp->lang + lang_len) = '\\0';\n1112\t         textp->lang_key = textp->lang + lang_len + 1;\n1113\t         memcpy(textp->lang_key, text_ptr[i].lang_key, lang_key_len);\n1114\t         *(textp->lang_key + lang_key_len) = '\\0';\n1115\t         textp->text = textp->lang_key + lang_key_len + 1;\n1116\t      }\n1117\t\n1118\t      else\n1119\t      {\n1120\t         textp->lang=NULL;\n1121\t         textp->lang_key=NULL;\n1122\t         textp->text = textp->key + key_len + 1;\n1123\t      }\n1124\t\n1125\t      if (text_length != 0)\n1126\t         memcpy(textp->text, text_ptr[i].text, text_length);\n1127\t\n1128\t      *(textp->text + text_length) = '\\0';\n1129\t\n1130\t#  ifdef PNG_iTXt_SUPPORTED\n1131\t      if (textp->compression > 0)\n1132\t      {\n1133\t         textp->text_length = 0;\n1134\t         textp->itxt_length = text_length;\n1135\t      }\n1136\t\n1137\t      else\n1138\t#  endif\n1139\t      {\n1140\t         textp->text_length = text_length;\n1141\t         textp->itxt_length = 0;\n1142\t      }\n1143\t\n1144\t      info_ptr->num_text++;\n1145\t      png_debug1(3, \"transferred text chunk %d\", info_ptr->num_text);\n1146\t   }\n1147\t\n1148\t   png_free(png_ptr, old_text);\n1149\t\n1150\t   return 0;\n1151\t}\n1152\t#endif\n1153\t\n1154\t#ifdef PNG_tIME_SUPPORTED\n1155\tvoid PNGAPI\n1156\tpng_set_tIME(png_const_structrp png_ptr, png_inforp info_ptr,\n1157\t    png_const_timep mod_time)\n1158\t{\n1159\t   png_debug1(1, \"in %s storage function\", \"tIME\");\n1160\t\n1161\t   if (png_ptr == NULL || info_ptr == NULL || mod_time == NULL ||\n1162\t       (png_ptr->mode & PNG_WROTE_tIME) != 0)\n1163\t      return;\n1164\t\n1165\t   if (mod_time->month == 0   || mod_time->month > 12  ||\n1166\t       mod_time->day   == 0   || mod_time->day   > 31  ||\n1167\t       mod_time->hour  > 23   || mod_time->minute > 59 ||\n1168\t       mod_time->second > 60)\n1169\t   {\n1170\t      png_warning(png_ptr, \"Ignoring invalid time value\");\n1171\t\n1172\t      return;\n1173\t   }\n1174\t\n1175\t   info_ptr->mod_time = *mod_time;\n1176\t   info_ptr->valid |= PNG_INFO_tIME;\n1177\t}\n1178\t#endif\n1179\t\n1180\t#ifdef PNG_tRNS_SUPPORTED\n1181\tvoid PNGAPI\n1182\tpng_set_tRNS(png_structrp png_ptr, png_inforp info_ptr,\n1183\t    png_const_bytep trans_alpha, int num_trans, png_const_color_16p trans_color)\n1184\t{\n1185\t   png_debug1(1, \"in %s storage function\", \"tRNS\");\n1186\t\n1187\t   if (png_ptr == NULL || info_ptr == NULL)\n1188\t\n1189\t      return;\n1190\t\n1191\t   if (trans_alpha != NULL)\n1192\t   {\n1193\t       /* Snapshot the caller's trans_alpha before freeing, in case it\n1194\t        * points to info_ptr->trans_alpha (getter-to-setter aliasing).\n1195\t        */\n1196\t       png_byte safe_trans[PNG_MAX_PALETTE_LENGTH];\n1197\t\n1198\t       if (num_trans > 0 && num_trans <= PNG_MAX_PALETTE_LENGTH)\n1199\t          memcpy(safe_trans, trans_alpha, (size_t)num_trans);\n1200\t\n1201\t       trans_alpha = safe_trans;\n1202\t\n1203\t       png_free_data(png_ptr, info_ptr, PNG_FREE_TRNS, 0);\n1204\t\n1205\t       if (num_trans > 0 && num_trans <= PNG_MAX_PALETTE_LENGTH)\n1206\t       {\n1207\t          /* Allocate info_ptr's copy of the transparency data.\n1208\t           * Initialize all entries to fully opaque (0xff), then overwrite\n1209\t           * the first num_trans entries with the actual values.\n1210\t           */\n1211\t          info_ptr->trans_alpha = png_voidcast(png_bytep,\n1212\t              png_malloc(png_ptr, PNG_MAX_PALETTE_LENGTH));\n1213\t          memset(info_ptr->trans_alpha, 0xff, PNG_MAX_PALETTE_LENGTH);\n1214\t          memcpy(info_ptr->trans_alpha, trans_alpha, (size_t)num_trans);\n1215\t          info_ptr->free_me |= PNG_FREE_TRNS;\n1216\t          info_ptr->valid |= PNG_INFO_tRNS;\n1217\t\n1218\t          /* Allocate an independent copy for png_struct, so that the\n1219\t           * lifetime of png_ptr->trans_alpha is decoupled from the\n1220\t           * lifetime of info_ptr->trans_alpha.  Previously these two\n1221\t           * pointers were aliased, which caused a use-after-free if\n1222\t           * png_free_data freed info_ptr->trans_alpha while\n1223\t           * png_ptr->trans_alpha was still in use by the row transform\n1224\t           * functions (e.g. png_do_expand_palette).\n1225\t           */\n1226\t          png_free(png_ptr, png_ptr->trans_alpha);\n1227\t          png_ptr->trans_alpha = NULL;\n1228\t          png_ptr->trans_alpha = png_voidcast(png_bytep,\n1229\t              png_malloc(png_ptr, PNG_MAX_PALETTE_LENGTH));\n1230\t          memset(png_ptr->trans_alpha, 0xff, PNG_MAX_PALETTE_LENGTH);\n1231\t          memcpy(png_ptr->trans_alpha, trans_alpha, (size_t)num_trans);\n1232\t       }\n1233\t       else\n1234\t       {\n1235\t          png_free(png_ptr, png_ptr->trans_alpha);\n1236\t          png_ptr->trans_alpha = NULL;\n1237\t       }\n1238\t   }\n1239\t\n1240\t   if (trans_color != NULL)\n1241\t   {\n1242\t#ifdef PNG_WARNINGS_SUPPORTED\n1243\t      if (info_ptr->bit_depth < 16)\n1244\t      {\n1245\t         int sample_max = (1 << info_ptr->bit_depth) - 1;\n1246\t\n1247\t         if ((info_ptr->color_type == PNG_COLOR_TYPE_GRAY &&\n1248\t             trans_color->gray > sample_max) ||\n1249\t             (info_ptr->color_type == PNG_COLOR_TYPE_RGB &&\n1250\t             (trans_color->red > sample_max ||\n1251\t             trans_color->green > sample_max ||\n1252\t             trans_color->blue > sample_max)))\n1253\t            png_warning(png_ptr,\n1254\t                \"tRNS chunk has out-of-range samples for bit_depth\");\n1255\t      }\n1256\t#endif\n1257\t\n1258\t      info_ptr->trans_color = *trans_color;\n1259\t\n1260\t      if (num_trans == 0)\n1261\t         num_trans = 1;\n1262\t   }\n1263\t\n1264\t   info_ptr->num_trans = (png_uint_16)num_trans;\n1265\t\n1266\t   if (num_trans != 0)\n1267\t   {\n1268\t      info_ptr->free_me |= PNG_FREE_TRNS;\n1269\t      info_ptr->valid |= PNG_INFO_tRNS;\n1270\t   }\n1271\t}\n1272\t#endif\n1273\t\n1274\t#ifdef PNG_sPLT_SUPPORTED\n1275\tvoid PNGAPI\n1276\tpng_set_sPLT(png_const_structrp png_ptr,\n1277\t    png_inforp info_ptr, png_const_sPLT_tp entries, int nentries)\n1278\t/*\n1279\t *  entries        - array of png_sPLT_t structures\n1280\t *                   to be added to the list of palettes\n1281\t *                   in the info structure.\n1282\t *\n1283\t *  nentries       - number of palette structures to be\n1284\t *                   added.\n1285\t */\n1286\t{\n1287\t   png_sPLT_tp np;\n1288\t   png_sPLT_tp old_spalettes;\n1289\t\n1290\t   png_debug1(1, \"in %s storage function\", \"sPLT\");\n1291\t\n1292\t   if (png_ptr == NULL || info_ptr == NULL || nentries <= 0 || entries == NULL)\n1293\t      return;\n1294\t\n1295\t   /* Use the internal realloc function, which checks for all the possible\n1296\t    * overflows.  Notice that the parameters are (int) and (size_t)\n1297\t    */\n1298\t   np = png_voidcast(png_sPLT_tp,png_realloc_array(png_ptr,\n1299\t       info_ptr->splt_palettes, info_ptr->splt_palettes_num, nentries,\n1300\t       sizeof *np));\n1301\t\n1302\t   if (np == NULL)\n1303\t   {\n1304\t      /* Out of memory or too many chunks */\n1305\t      png_chunk_report(png_ptr, \"too many sPLT chunks\", PNG_CHUNK_WRITE_ERROR);\n1306\t      return;\n1307\t   }\n1308\t\n1309\t   /* Defer freeing the old array until after the copy loop below,\n1310\t    * in case entries aliases info_ptr->splt_palettes (getter-to-setter).\n1311\t    */\n1312\t   old_spalettes = info_ptr->splt_palettes;\n1313\t\n1314\t   info_ptr->splt_palettes = np;\n1315\t   info_ptr->free_me |= PNG_FREE_SPLT;\n1316\t\n1317\t   np += info_ptr->splt_palettes_num;\n1318\t\n1319\t   do\n1320\t   {\n1321\t      size_t length;\n1322\t\n1323\t      /* Skip invalid input entries */\n1324\t      if (entries->name == NULL || entries->entries == NULL)\n1325\t      {\n1326\t         /* png_handle_sPLT doesn't do this, so this is an app error */\n1327\t         png_app_error(png_ptr, \"png_set_sPLT: invalid sPLT\");\n1328\t         /* Just skip the invalid entry */\n1329\t         continue;\n1330\t      }\n1331\t\n1332\t      np->depth = entries->depth;\n1333\t\n1334\t      /* In the event of out-of-memory just return - there's no point keeping\n1335\t       * on trying to add sPLT chunks.\n1336\t       */\n1337\t      length = strlen(entries->name) + 1;\n1338\t      np->name = png_voidcast(png_charp, png_malloc_base(png_ptr, length));\n1339\t\n1340\t      if (np->name == NULL)\n1341\t         break;\n1342\t\n1343\t      memcpy(np->name, entries->name, length);\n1344\t\n1345\t      /* IMPORTANT: we have memory now that won't get freed if something else\n1346\t       * goes wrong; this code must free it.  png_malloc_array produces no\n1347\t       * warnings; use a png_chunk_report (below) if there is an error.\n1348\t       */\n1349\t      np->entries = png_voidcast(png_sPLT_entryp, png_malloc_array(png_ptr,\n1350\t          entries->nentries, sizeof (png_sPLT_entry)));\n1351\t\n1352\t      if (np->entries == NULL)\n1353\t      {\n1354\t         png_free(png_ptr, np->name);\n1355\t         np->name = NULL;\n1356\t         break;\n1357\t      }\n1358\t\n1359\t      np->nentries = entries->nentries;\n1360\t      /* This multiply can't overflow because png_malloc_array has already\n1361\t       * checked it when doing the allocation.\n1362\t       */\n1363\t      memcpy(np->entries, entries->entries,\n1364\t          (unsigned int)entries->nentries * sizeof (png_sPLT_entry));\n1365\t\n1366\t      /* Note that 'continue' skips the advance of the out pointer and out\n1367\t       * count, so an invalid entry is not added.\n1368\t       */\n1369\t      info_ptr->valid |= PNG_INFO_sPLT;\n1370\t      ++(info_ptr->splt_palettes_num);\n1371\t      ++np;\n1372\t      ++entries;\n1373\t   }\n1374\t   while (--nentries);\n1375\t\n1376\t   png_free(png_ptr, old_spalettes);\n1377\t\n1378\t   if (nentries > 0)\n1379\t      png_chunk_report(png_ptr, \"sPLT out of memory\", PNG_CHUNK_WRITE_ERROR);\n1380\t}\n1381\t#endif /* sPLT */\n1382\t\n1383\t#ifdef PNG_STORE_UNKNOWN_CHUNKS_SUPPORTED\n1384\tstatic png_byte\n1385\tcheck_location(png_const_structrp png_ptr, int location)\n1386\t{\n1387\t   location &= (PNG_HAVE_IHDR|PNG_HAVE_PLTE|PNG_AFTER_IDAT);\n1388\t\n1389\t   /* New in 1.6.0; copy the location and check it.  This is an API\n1390\t    * change; previously the app had to use the\n1391\t    * png_set_unknown_chunk_location API below for each chunk.\n1392\t    */\n1393\t   if (location == 0 && (png_ptr->mode & PNG_IS_READ_STRUCT) == 0)\n1394\t   {\n1395\t      /* Write struct, so unknown chunks come from the app */\n1396\t      png_app_warning(png_ptr,\n1397\t          \"png_set_unknown_chunks now expects a valid location\");\n1398\t      /* Use the old behavior */\n1399\t      location = (png_byte)(png_ptr->mode &\n1400\t          (PNG_HAVE_IHDR|PNG_HAVE_PLTE|PNG_AFTER_IDAT));\n1401\t   }\n1402\t\n1403\t   /* This need not be an internal error - if the app calls\n1404\t    * png_set_unknown_chunks on a read pointer it must get the location right.\n1405\t    */\n1406\t   if (location == 0)\n1407\t      png_error(png_ptr, \"invalid location in png_set_unknown_chunks\");\n1408\t\n1409\t   /* Now reduce the location to the top-most set bit by removing each least\n1410\t    * significant bit in turn.\n1411\t    */\n1412\t   while (location != (location & -location))\n1413\t      location &= ~(location & -location);\n1414\t\n1415\t   /* The cast is safe because 'location' is a bit mask and only the low four\n1416\t    * bits are significant.\n1417\t    */\n1418\t   return (png_byte)location;\n1419\t}\n1420\t\n1421\tvoid PNGAPI\n1422\tpng_set_unknown_chunks(png_const_structrp png_ptr,\n1423\t    png_inforp info_ptr, png_const_unknown_chunkp unknowns, int num_unknowns)\n1424\t{\n1425\t   png_unknown_chunkp np;\n1426\t   png_unknown_chunkp old_unknowns;\n1427\t\n1428\t   if (png_ptr == NULL || info_ptr == NULL || num_unknowns <= 0 ||\n1429\t       unknowns == NULL)\n1430\t      return;\n1431\t\n1432\t   /* Check for the failure cases where support has been disabled at compile\n1433\t    * time.  This code is hardly ever compiled - it's here because\n1434\t    * STORE_UNKNOWN_CHUNKS is set by both read and write code (compiling in this\n1435\t    * code) but may be meaningless if the read or write handling of unknown\n1436\t    * chunks is not compiled in.\n1437\t    */\n1438\t#  if !defined(PNG_READ_UNKNOWN_CHUNKS_SUPPORTED) && \\\n1439\t      defined(PNG_READ_SUPPORTED)\n1440\t      if ((png_ptr->mode & PNG_IS_READ_STRUCT) != 0)\n1441\t      {\n1442\t         png_app_error(png_ptr, \"no unknown chunk support on read\");\n1443\t\n1444\t         return;\n1445\t      }\n1446\t#  endif\n1447\t#  if !defined(PNG_WRITE_UNKNOWN_CHUNKS_SUPPORTED) && \\\n1448\t      defined(PNG_WRITE_SUPPORTED)\n1449\t      if ((png_ptr->mode & PNG_IS_READ_STRUCT) == 0)\n1450\t      {\n1451\t         png_app_error(png_ptr, \"no unknown chunk support on write\");\n1452\t\n1453\t         return;\n1454\t      }\n1455\t#  endif\n1456\t\n1457\t   /* Prior to 1.6.0 this code used png_malloc_warn; however, this meant that\n1458\t    * unknown critical chunks could be lost with just a warning resulting in\n1459\t    * undefined behavior.  Now png_chunk_report is used to provide behavior\n1460\t    * appropriate to read or write.\n1461\t    */\n1462\t   np = png_voidcast(png_unknown_chunkp, png_realloc_array(png_ptr,\n1463\t       info_ptr->unknown_chunks, info_ptr->unknown_chunks_num, num_unknowns,\n1464\t       sizeof *np));\n1465\t\n1466\t   if (np == NULL)\n1467\t   {\n1468\t      png_chunk_report(png_ptr, \"too many unknown chunks\",\n1469\t          PNG_CHUNK_WRITE_ERROR);\n1470\t      return;\n1471\t   }\n1472\t\n1473\t   /* Defer freeing the old array until after the copy loop below,\n1474\t    * in case unknowns aliases info_ptr->unknown_chunks (getter-to-setter).\n1475\t    */\n1476\t   old_unknowns = info_ptr->unknown_chunks;\n1477\t\n1478\t   info_ptr->unknown_chunks = np; /* safe because it is initialized */\n1479\t   info_ptr->free_me |= PNG_FREE_UNKN;\n1480\t\n1481\t   np += info_ptr->unknown_chunks_num;\n1482\t\n1483\t   /* Increment unknown_chunks_num each time round the loop to protect the\n1484\t    * just-allocated chunk data.\n1485\t    */\n1486\t   for (; num_unknowns > 0; --num_unknowns, ++unknowns)\n1487\t   {\n1488\t      memcpy(np->name, unknowns->name, (sizeof np->name));\n1489\t      np->name[(sizeof np->name)-1] = '\\0';\n1490\t      np->location = check_location(png_ptr, unknowns->location);\n1491\t\n1492\t      if (unknowns->size == 0)\n1493\t      {\n1494\t         np->data = NULL;\n1495\t         np->size = 0;\n1496\t      }\n1497\t\n1498\t      else\n1499\t      {\n1500\t         np->data = png_voidcast(png_bytep,\n1501\t             png_malloc_base(png_ptr, unknowns->size));\n1502\t\n1503\t         if (np->data == NULL)\n1504\t         {\n1505\t            png_chunk_report(png_ptr, \"unknown chunk: out of memory\",\n1506\t                PNG_CHUNK_WRITE_ERROR);\n1507\t            /* But just skip storing the unknown chunk */\n1508\t            continue;\n1509\t         }\n1510\t\n1511\t         memcpy(np->data, unknowns->data, unknowns->size);\n1512\t         np->size = unknowns->size;\n1513\t      }\n1514\t\n1515\t      /* These increments are skipped on out-of-memory for the data - the\n1516\t       * unknown chunk entry gets overwritten if the png_chunk_report returns.\n1517\t       * This is correct in the read case (the chunk is just dropped.)\n1518\t       */\n1519\t      ++np;\n1520\t      ++(info_ptr->unknown_chunks_num);\n1521\t   }\n1522\t\n1523\t   png_free(png_ptr, old_unknowns);\n1524\t}\n1525\t\n1526\tvoid PNGAPI\n1527\tpng_set_unknown_chunk_location(png_const_structrp png_ptr, png_inforp info_ptr,\n1528\t    int chunk, int location)\n1529\t{\n1530\t   /* This API is pretty pointless in 1.6.0 because the location can be set\n1531\t    * before the call to png_set_unknown_chunks.\n1532\t    *\n1533\t    * TODO: add a png_app_warning in 1.7\n1534\t    */\n1535\t   if (png_ptr != NULL && info_ptr != NULL && chunk >= 0 &&\n1536\t      chunk < info_ptr->unknown_chunks_num)\n1537\t   {\n1538\t      if ((location & (PNG_HAVE_IHDR|PNG_HAVE_PLTE|PNG_AFTER_IDAT)) == 0)\n1539\t      {\n1540\t         png_app_error(png_ptr, \"invalid unknown chunk location\");\n1541\t         /* Fake out the pre 1.6.0 behavior: */\n1542\t         if (((unsigned int)location & PNG_HAVE_IDAT) != 0) /* undocumented! */\n1543\t            location = PNG_AFTER_IDAT;\n1544\t\n1545\t         else\n1546\t            location = PNG_HAVE_IHDR; /* also undocumented */\n1547\t      }\n1548\t\n1549\t      info_ptr->unknown_chunks[chunk].location =\n1550\t         check_location(png_ptr, location);\n1551\t   }\n1552\t}\n1553\t#endif /* STORE_UNKNOWN_CHUNKS */\n1554\t\n1555\t#ifdef PNG_MNG_FEATURES_SUPPORTED\n1556\tpng_uint_32 PNGAPI\n1557\tpng_permit_mng_features(png_structrp png_ptr, png_uint_32 mng_features)\n1558\t{\n1559\t   png_debug(1, \"in png_permit_mng_features\");\n1560\t\n1561\t   if (png_ptr == NULL)\n1562\t      return 0;\n1563\t\n1564\t   png_ptr->mng_features_permitted = mng_features & PNG_ALL_MNG_FEATURES;\n1565\t\n1566\t   return png_ptr->mng_features_permitted;\n1567\t}\n1568\t#endif\n1569\t\n1570\t#ifdef PNG_HANDLE_AS_UNKNOWN_SUPPORTED\n1571\tstatic unsigned int\n1572\tadd_one_chunk(png_bytep list, unsigned int count, png_const_bytep add, int keep)\n1573\t{\n1574\t   unsigned int i;\n1575\t\n1576\t   /* Utility function: update the 'keep' state of a chunk if it is already in\n1577\t    * the list, otherwise add it to the list.\n1578\t    */\n1579\t   for (i=0; i<count; ++i, list += 5)\n1580\t   {\n1581\t      if (memcmp(list, add, 4) == 0)\n1582\t      {\n1583\t         list[4] = (png_byte)keep;\n1584\t\n1585\t         return count;\n1586\t      }\n1587\t   }\n1588\t\n1589\t   if (keep != PNG_HANDLE_CHUNK_AS_DEFAULT)\n1590\t   {\n1591\t      ++count;\n1592\t      memcpy(list, add, 4);\n1593\t      list[4] = (png_byte)keep;\n1594\t   }\n1595\t\n1596\t   return count;\n1597\t}\n1598\t\n1599\tvoid PNGAPI\n1600\tpng_set_keep_unknown_chunks(png_structrp png_ptr, int keep,\n1601\t    png_const_bytep chunk_list, int num_chunks_in)\n1602\t{\n1603\t   png_bytep new_list;\n1604\t   unsigned int num_chunks, old_num_chunks;\n1605\t\n1606\t   if (png_ptr == NULL)\n1607\t      return;\n1608\t\n1609\t   if (keep < 0 || keep >= PNG_HANDLE_CHUNK_LAST)\n1610\t   {\n1611\t      png_app_error(png_ptr, \"png_set_keep_unknown_chunks: invalid keep\");\n1612\t\n1613\t      return;\n1614\t   }\n1615\t\n1616\t   if (num_chunks_in <= 0)\n1617\t   {\n1618\t      png_ptr->unknown_default = keep;\n1619\t\n1620\t      /* '0' means just set the flags, so stop here */\n1621\t      if (num_chunks_in == 0)\n1622\t        return;\n1623\t   }\n1624\t\n1625\t   if (num_chunks_in < 0)\n1626\t   {\n1627\t      /* Ignore all unknown chunks and all chunks recognized by\n1628\t       * libpng except for IHDR, PLTE, tRNS, IDAT, and IEND\n1629\t       */\n1630\t      static const png_byte chunks_to_ignore[] = {\n1631\t         98,  75,  71,  68, '\\0',  /* bKGD */\n1632\t         99,  72,  82,  77, '\\0',  /* cHRM */\n1633\t         99,  73,  67,  80, '\\0',  /* cICP */\n1634\t         99,  76,  76,  73, '\\0',  /* cLLI */\n1635\t        101,  88,  73, 102, '\\0',  /* eXIf */\n1636\t        103,  65,  77,  65, '\\0',  /* gAMA */\n1637\t        104,  73,  83,  84, '\\0',  /* hIST */\n1638\t        105,  67,  67,  80, '\\0',  /* iCCP */\n1639\t        105,  84,  88, 116, '\\0',  /* iTXt */\n1640\t        109,  68,  67,  86, '\\0',  /* mDCV */\n1641\t        111,  70,  70, 115, '\\0',  /* oFFs */\n1642\t        112,  67,  65,  76, '\\0',  /* pCAL */\n1643\t        112,  72,  89, 115, '\\0',  /* pHYs */\n1644\t        115,  66,  73,  84, '\\0',  /* sBIT */\n1645\t        115,  67,  65,  76, '\\0',  /* sCAL */\n1646\t        115,  80,  76,  84, '\\0',  /* sPLT */\n1647\t        115,  84,  69,  82, '\\0',  /* sTER */\n1648\t        115,  82,  71,  66, '\\0',  /* sRGB */\n1649\t        116,  69,  