cmp::max(1, maxb - 1) as u8;\n756\t                let sbit = PngColor8 {\n757\t                    red: sb,\n758\t                    green: sb,\n759\t                    blue: sb,\n760\t                    gray: sb,\n761\t                    alpha: sb,\n762\t                };\n763\t                let bkgd = PngColor16 {\n764\t                    index: rng.below(npal) as u8,\n765\t                    red: rng.next_u32() as u16 & 0xff,\n766\t                    green: rng.next_u32() as u16 & 0xff,\n767\t                    blue: rng.next_u32() as u16 & 0xff,\n768\t                    gray: rng.next_u32() as u16 & 0xff,\n769\t                };\n770\t                let extra = rng.bytes(9);\n771\t                let extra_name = private_name(&mut rng);\n772\t                let texts = [\n773\t                    PngText {\n774\t                        compression: PNG_TEXT_COMPRESSION_NONE,\n775\t                        key: key_a.as_ptr() as *mut c_char,\n776\t                        text: txt_a.as_ptr() as *mut c_char,\n777\t                        ..Default::default()\n778\t                    },\n779\t                    PngText {\n780\t                        compression: PNG_TEXT_COMPRESSION_NONE,\n781\t                        key: key_b.as_ptr() as *mut c_char,\n782\t                        text: txt_b.as_ptr() as *mut c_char,\n783\t                        ..Default::default()\n784\t                    },\n785\t                ];\n786\t                let label = format!(\"W16 ct={ct} bd={bd} variant={variant} rep={rep}\");\n787\t                diff(&label, |lib| {\n788\t                    wwrite_c(lib, &mut |c, png, info| unsafe {\n789\t                        (c.set_IHDR)(png, info, w, h, bd, ct, PNG_INTERLACE_NONE, 0, 0);\n790\t                        if ct == PNG_COLOR_TYPE_PALETTE {\n791\t                            (c.set_PLTE)(png, info, pal.as_ptr(), npal as c_int);\n792\t                            (c.set_tRNS)(\n793\t                                png,\n794\t                                info,\n795\t                                trns.as_ptr(),\n796\t                                npal as c_int,\n797\t                                std::ptr::null(),\n798\t                            );\n799\t                            (c.set_hIST)(png, info, hist.as_ptr());\n800\t                        }\n801\t                        (c.set_gAMA_fixed)(png, info, 45455);\n802\t                        (c.set_sBIT)(png, info, &sbit as *const PngColor8 as *const u8);\n803\t                        (c.set_bKGD)(png, info, &bkgd as *const PngColor16 as *const u8);\n804\t                        (c.set_pHYs)(png, info, 3000, 2500, PNG_RESOLUTION_METER);\n805\t                        (c.set_text)(png, info, texts.as_ptr() as *const c_void, 2);\n806\t                        log_hdr(c, png, info);\n807\t\n808\t                        match variant {\n809\t                            0 => {\n810\t                                // png_write_info calls it internally\n811\t                                (c.write_info)(png, info);\n812\t                            }\n813\t                            1 => {\n814\t                                (c.write_info_before_PLTE)(png, info);\n815\t                                log(format!(\"before_PLTE out={}\", outlen()));\n816\t                                (c.write_info)(png, info);\n817\t                            }\n818\t                            2 => {\n819\t                                // the second call is a no-op (mode flag)\n820\t                                (c.write_info_before_PLTE)(png, info);\n821\t                                log(format!(\"before_PLTE out={}\", outlen()));\n822\t                                (c.write_info_before_PLTE)(png, info);\n823\t                                log(format!(\"before_PLTE2 out={}\", outlen()));\n824\t                                (c.write_info)(png, info);\n825\t                            }\n826\t                            _ => {\n827\t                                // an application chunk between the header and\n828\t                                // the PLTE\n829\t                                (c.write_info_before_PLTE)(png, info);\n830\t                                log(format!(\"before_PLTE out={}\", outlen()));\n831\t                                (c.write_chunk)(\n832\t                                    png,\n833\t                                    extra_name.as_ptr(),\n834\t                                    extra.as_ptr(),\n835\t                                    extra.len(),\n836\t                                );\n837\t                                (c.write_info)(png, info);\n838\t                            }\n839\t                        }\n840\t                        log(format!(\"info out={}\", outlen()));\n841\t                        log_all_info(c, png, info);\n842\t                        for r in &rows {\n843\t                            (c.write_row)(png, r.as_ptr());\n844\t                        }\n845\t                        (c.write_end)(png, info);\n846\t                        log(format!(\"rowsum={:08x}\", rowsum(&rows)));\n847\t                    })\n848\t                });\n849\t            }\n850\t        }\n851\t    }\n852\t}\n853\t\n854\t// ---------------------------------------------------------------------------\n855\t// W17 — the write transforms, each alone and in random combinations\n856\t// ---------------------------------------------------------------------------\n857\t//\n858\t// All of these must be applied *after* png_write_info: png_write_IHDR is what\n859\t// sets png_ptr->bit_depth / color_type / usr_bit_depth / usr_channels, and the\n860\t// setters validate against (and modify) those fields.  This is exactly the\n861\t// order png_write_png uses."}]},"parent_tool_use_id":"toolu_bdrk_0142wgcwC4DU2gkmXGMTmwBC","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"ffb7f870-3a70-4180-b398-9094c636c501","ti