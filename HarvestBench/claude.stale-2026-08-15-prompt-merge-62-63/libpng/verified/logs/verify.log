cess_data\",\n115\t    process_data_pause: unsafe extern \"C\" fn(Png, c_int) -> usize = \"png_process_data_pause\",\n116\t    process_data_skip: unsafe extern \"C\" fn(Png) -> u32 = \"png_process_data_skip\",\n117\t    progressive_combine_row: unsafe extern \"C\" fn(Png, *mut u8, *const u8)\n118\t        = \"png_progressive_combine_row\",\n119\t    get_progressive_ptr: unsafe extern \"C\" fn(Png) -> *mut c_void = \"png_get_progressive_ptr\",\n120\t\n121\t    // ---- compression settings -------------------------------------------\n122\t    set_compression_level: unsafe extern \"C\" fn(Png, c_int) = \"png_set_compression_level\",\n123\t    set_compression_mem_level: unsafe extern \"C\" fn(Png, c_int) = \"png_set_compression_mem_level\",\n124\t    set_compression_strategy: unsafe extern \"C\" fn(Png, c_int) = \"png_set_compression_strategy\",\n125\t    set_compression_window_bits: unsafe extern \"C\" fn(Png, c_int)\n126\t        = \"png_set_compression_window_bits\",\n127\t    set_compression_method: unsafe extern \"C\" fn(Png, c_int) = \"png_set_compression_method\",\n128\t    set_compression_buffer_size: unsafe extern \"C\" fn(Png, usize)\n129\t        = \"png_set_compression_buffer_size\",\n130\t    get_compression_buffer_size: unsafe extern \"C\" fn(Png) -> usize\n131\t        = \"png_get_compression_buffer_size\",\n132\t    set_text_compression_level: unsafe extern \"C\" fn(Png, c_int) = \"png_set_text_compression_level\",\n133\t    set_text_compression_mem_level: unsafe extern \"C\" fn(Png, c_int)\n134\t        = \"png_set_text_compression_mem_level\",\n135\t    set_text_compression_strategy: unsafe extern \"C\" fn(Png, c_int)\n136\t        = \"png_set_text_compression_strategy\",\n137\t    set_text_compression_window_bits: unsafe extern \"C\" fn(Png, c_int)\n138\t        = \"png_set_text_compression_window_bits\",\n139\t    set_text_compression_method: unsafe extern \"C\" fn(Png, c_int)\n140\t        = \"png_set_text_compression_method\",\n141\t    set_filter: