   8,\n2238\t            PNG_FORMAT_FLAG_COLORMAP | PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA,\n2239\t            false,\n2240\t            \"rgb+alpha\",\n2241\t        ),\n2242\t        (6, 8, PNG_FORMAT_FLAG_COLORMAP | PNG_FORMAT_FLAG_COLOR, true, \"rgb-alpha\"),\n2243\t        (2, 8, PNG_FORMAT_FLAG_COLORMAP | PNG_FORMAT_FLAG_COLOR, false, \"rgb\"),\n2244\t    ];\n2245\t    for &(ct, bd, fmt, need_back, name) in cases {\n2246\t        let input = img(ct, bd, &[]);\n2247\t        simg(\n2248\t            &format!(\"SIMG cmap too few {name}\"),\n2249\t            &input,\n2250\t            &move |lib, ip, p, l| unsafe {\n2251\t                let begin: BeginMem = lib.f(\"png_image_begin_read_from_memory\");\n2252\t                let finish: FinishRead = lib.f(\"png_image_finish_read\");\n2253\t                let rc = begin(ip, p as *const c_void, l);\n2254\t                log_img(\"begin\", &*ip, rc);\n2255\t                (*ip).format = fmt;\n2256\t                (*ip).colormap_entries = 1;\n2257\t                let b = if need_back { backp } else { std::ptr::null() };\n2258\t                let rc = finish(ip, b, op, 0, cp);\n2259\t                log_img(\"finish\", &*ip, rc);\n2260\t            },\n2261\t        );\n2262\t    }\n2263\t    // palette input: \"palette color-map: too few entries\"\n2264\t    let pal4 = join(&[\n2265\t        ihdr(4, 2, 8, 3, 0),\n2266\t        plte(8),\n2267\t        ck(b\"IDAT\", zlib_stored(&vec![0u8; 10])),\n2268\t        iend(),\n2269\t    ]);\n2270\t    simg(\"SIMG cmap too few palette\", &pal4, &|lib, ip, p, l| unsafe {\n2271\t        let begin: BeginMem = lib.f(\"png_image_begin_read_from_memory\");\n2272\t        let finish: FinishRead = lib.f(\"png_image_finish_read\");\n2273\t        let rc = begin(ip, p as *const c_void, l);\n2274\t        log_img(\"begin\", &*ip, rc);\n2275\t        (*ip).colormap_entries = 1;\n2276\t        let rc = finish(ip, std::ptr::null(), op, 0, cp);\n2277\t        log_img(\"finish\"