{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BovJ3cuXbkj6Y7R59qnFkh","type":"tool_result","content":"1\t/* Test-harness shim: provides a real setjmp landing pad so that the Rust\n2\t * differential tests can drive libpng exactly like a C application does\n3\t * (png_error -> longjmp -> back to the caller).\n4\t *\n5\t * This file is NOT part of the library; it is compiled at test time into a\n6\t * small shared object which the integration tests dlopen.\n7\t */\n8\t#include <setjmp.h>\n9\t#include <stdlib.h>\n10\t#include <string.h>\n11\t#include <stddef.h>\n12\t\n13\ttypedef void (*th_fn)(void *);\n14\t\n15\tstatic __thread jmp_buf th_env;\n16\tstatic __thread int th_active = 0;\n17\t\n18\t/* Run f(ctx) with a longjmp landing pad installed.  Returns 0 if f returned\n19\t * normally, or the non-zero value passed to th_longjmp otherwise.\n20\t */\n21\tint th_protect(th_fn f, void *ctx)\n22\t{\n23\t    jmp_buf saved;\n24\t    volatile int was = th_active;\n25\t    int v;\n26\t\n27\t    if (was)\n28\t        memcpy(&saved, &th_env, sizeof(jmp_buf));\n29\t\n30\t    v = setjmp(th_env);\n31\t\n32\t    if (v == 0)\n33\t    {\n34\t        th_active = 1;\n35\t        f(ctx);\n36\t    }\n37\t\n38\t    th_active = was;\n39\t    if (was)\n40\t        memcpy(&th_env, &saved, sizeof(jmp_buf));\n41\t\n42\t    return v;\n43\t}\n44\t\n45\t/* Matches png_longjmp_ptr: void (*)(jmp_buf, int).  The buffer libpng hands us\n46\t * is ignored; we jump to the pad installed by th_protect.\n47\t */\n48\tvoid th_longjmp(void *env, int val)\n49\t{\n50\t    (void)env;\n51\t    if (th_active)\n52\t        longjmp(th_env, val != 0 ? val : 1);\n53\t    abort();\n54\t}\n55\t\n56\tsize_t th_jmp_buf_size(void)\n57\t{\n58\t    return sizeof(jmp_buf);\n59\t}\n60\t"}]},"parent_tool_use_id":"toolu_bdrk_01XHdnyMuFEuHb5xLVMQCDix","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"795ea278-c9bc-433c-94b1-7d1e4d34fa56","timestamp":"2026-08-14T17:12:57.629Z","subagent_type":"general-purpose","task_description":"Cross-cutting modes tests M1-M8"}
