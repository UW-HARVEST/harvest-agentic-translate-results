ond; }`\n461\t#[repr(C)]\n462\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n463\tpub struct PngTime {\n464\t    pub year: u16,\n465\t    pub month: u8,\n466\t    pub day: u8,\n467\t    pub hour: u8,\n468\t    pub minute: u8,\n469\t    pub second: u8,\n470\t}\n471\t\n472\t/// `png_text`\n473\t#[repr(C)]\n474\t#[derive(Clone, Copy)]\n475\tpub struct PngText {\n476\t    pub compression: c_int,\n477\t    pub key: *mut c_char,\n478\t    pub text: *mut c_char,\n479\t    pub text_length: usize,\n480\t    pub itxt_length: usize,\n481\t    pub lang: *mut c_char,\n482\t    pub lang_key: *mut c_char,\n483\t}\n484\t\n485\timpl Default for PngText {\n486\t    fn default() -> Self {\n487\t        PngText {\n488\t            compression: PNG_TEXT_COMPRESSION_NONE,\n489\t            key: std::ptr::null_mut(),\n490\t            text: std::ptr::null_mut(),\n491\t            text_length: 0,\n492\t            itxt_length: 0,\n493\t            lang: std::ptr::null_mut(),\n494\t            lang_key: std::ptr::null_mut(),\n495\t        }\n496\t    }\n497\t}\n498\t\n499\t/// `png_unknown_chunk { png_byte name[5]; png_byte *data; size_t size; png_byte location; }`\n500\t#[repr(C)]\n501\t#[derive(Clone, Copy)]\n502\tpub struct PngUnknownChunk {\n503\t    pub name: [u8; 5],\n504\t    pub data: *mut u8,\n505\t    pub size: usize,\n506\t    pub location: u8,\n507\t}\n508\t\n509\t/// `png_sPLT_t { png_charp name; png_byte depth; png_sPLT_entryp entries; png_int_32 nentries; }`\n510\t#[repr(C)]\n511\t#[derive(Clone, Copy)]\n512\tpub struct PngSpltT {\n513\t    pub name: *mut c_char,\n514\t    pub depth: u8,\n515\t    pub entries: *mut PngSpltEntry,\n516\t    pub nentries: i32,\n517\t}\n518\t\n519\t/// `png_sPLT_entry { png_uint_16 red, green, blue, alpha, frequency; }`\n520\t#[repr(C)]\n521\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n522\tpub struct PngSpltEntry {\n523\t    pub red: u16,\n524\t    pub green: u16,\n525\t    pub blue: u16,\n526\t    pub alpha: u16,\n527\t    pub frequ