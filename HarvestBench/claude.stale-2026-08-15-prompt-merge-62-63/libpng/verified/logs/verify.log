se data */\n         png_ptr->flags &= ~PNG_FLAG_CRC_ANCILLARY_MASK;\n         png_ptr->flags |= PNG_FLAG_CRC_ANCILLARY_USE;\n         break;\n\n      case PNG_CRC_QUIET_USE:                            /* Quiet/use data */\n         png_ptr->flags &= ~PNG_FLAG_CRC_ANCILLARY_MASK;\n         png_ptr->flags |= PNG_FLAG_CRC_ANCILLARY_USE |\n                           PNG_FLAG_CRC_ANCILLARY_NOWARN;\n         break;\n\n      case PNG_CRC_ERROR_QUIT:                               /* Error/quit */\n         png_ptr->flags &= ~PNG_FLAG_CRC_ANCILLARY_MASK;\n         png_ptr->flags |= PNG_FLAG_CRC_ANCILLARY_NOWARN;\n         break;\n\n      case PNG_CRC_WARN_DISCARD:                      /* Warn/discard data */","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01466Nqb5z9B7fwBv76vVDfC","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"94f52b69-becb-43cb-b382-f500c96faf06","timestamp":"2026-08-14T15:57:29.554Z","subagent_type":"general-purpose","task_description":"Phase C read-stream error tests"}
