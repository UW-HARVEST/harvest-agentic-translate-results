t | [ ] |\n152\t| R22 | `png_set_read_user_transform_fn` + `png_set_user_transform_info` | user transform rewriting rows, depth/channel override, `png_get_user_transform_ptr` | [ ] |\n153\t| R23 | `png_set_read_status_fn` | row/pass callback sequence, interlace 0/1 | [ ] |\n154\t| R24 | `png_set_crc_action` | all 6 critical × 6 ancillary actions on streams with good and bad CRCs | [ ] |\n155\t| R25 | `png_set_keep_unknown_chunks` + `png_set_read_user_chunk_fn` | AS_DEFAULT/NEVER/IF_SAFE/ALWAYS × per-chunk list × user callback returning -1/0/1 | [ ] |\n156\t| R26 | `png_set_user_limits`, `png_set_chunk_cache_max`, `png_set_chunk_malloc_max` | limits above and below the actual image/chunk sizes | [ ] |\n157\t| R27 | `png_set_sig_bytes` | 0..8 signature bytes already consumed | [ ] |\n158\t| R28 | `png_start_read_image` / `png_read_update_info` | called once, twice, and out of order (documented sequences) | [ ] |\n159\t| R29 | `png_read_end` | with and without an end-info struct, with trailing chunks after IEND | [ ] |\n160\t| R30 | transform stacking | expand+gray_to_rgb+add_alpha+swap+bgr+16→8 pipelines over every colour type | [ ] |\n161\t| R31 | `png_create_read_struct_2` + user memory | full read, allocation trace compared | [ ] |\n162\t| R32 | `png_get_io_state`/`png_get_io_chunk_type` | polled during read via the read callback | [ ] |\n163\t| R33 | `png_get_current_row_number`/`png_get_current_pass_number` | polled per row for interlace 0/1 | [ ] |\n164\t\n165\t## P — progressive read (`pngpread.c`)\n166\t\n167\t| # | entry point(s) | configuration (options set + input shape) | [ ] |\n168\t|---|----------------|--------------------------------------------|-----|\n169\t| P1 | `png_process_data` | feed sizes 1, 2, 3, 7, 13, 64, whole-file for all colour/depth combos | [ ] |\n170\t| P2 | `png_process_data` + interlace | Adam7 input, `png_progressive_combine_row` in the row callback | [ ] |\n171\t| P3 | `png_process_data_pause` | pause with save=0 and save=1 at every chunk boundary | [ ] |\n172\t| P4 | `png_process_data_skip` | after a paused unknown/large chunk | [ ] |\n173\t| P5 | progressive + transforms | `png_set_expand`, `gray_to_rgb`, `strip_16`, `packing`, gamma set in the info callback | [ ] |\n174\t| P6 | progressive + multi-IDAT / zero-length IDAT | IDAT split into 1-byte chunks | [ ] |\n175\t| P7 | progressive + ancillary chunks | all-chunk image, unknown chunk handling, user chunk callback | [ ] |\n176\t| P8 | `png_get_progressive_ptr` | pointer round trip | [ ] |\n177\t\n178\t## S — simplified API (`pngread.c` / `pngwrite.c` simplified sections)\n179\t\n180\t| # | entry point(s) | configuration (options set + input shape) | [ ] |\n181\t|---|----------------|--------------------------------------------|-----|\n182\t| S1 | `png_image_begin_read_from_memory` + `png_image_finish_read` | every input colour type/depth × output format GRAY/GA/AG/RGB/BGR/RGBA/ARGB/BGRA/ABGR | [ ] |\n183\t| S2 | same, LINEAR formats | LINEAR_Y / LINEAR_Y_ALPHA / LINEAR_RGB / LINEAR_RGB_ALPHA (16-bit output) | [ ] |\n184\t| S3 | same, COLORMAP formats | RGB/BGR/RGBA/ARGB/BGRA/ABGR + colormap, `colormap_entries` | [ ] |\n185\t| S4 | `png_image_finish_read` with background | `png_color` background × alpha-bearing input × row_stride negative (bottom-up) | [ ] |\n186\t| S5 | `png_image_write_to_memory` | every format × `convert_to_8_bit` 0/1 × colormap, two-pass size query (`memory=NULL`) | [ ] |\n187\t| S6 | `png_image_begin_read_from_stdio` / `png_image_write_to_stdio` / `..._to_file` | real temporary files | [ ] |\n188\t| S7 | `png_image_free` | after success, after failure, twice | [ ] |\n189\t\n190\t## M — cross-cutting state / modes\n191\t\n192\t| # | entry point(s) | configuration (options set + input shape) | [ ] |\n193\t|---|----------------|--------------------------------------------|-----|\n194\t| M1 | `png_set_benign_errors(0/1)` | read and write structs, driven into a benign-error condition | [ ] |\n195\t| M2 | `png_set_error_fn` with NULL / non-NULL callbacks | `png_get_error_ptr` round trip; default handler path | [ ] |\n196\t| M3 | `png_set_mem_fn`, `png_get_mem_ptr` | user memory on read and write, `png_malloc` failure injection | [ ] |\n197\t| M4 | `png_set_longjmp_fn` | jmp_buf sizes: equal to `sizeof(jmp_buf)`, smaller, larger (allocated) | [ ] |\n198\t| M5 | write → read round trip | every colour/depth/interlace combination, image content preserved | [ ] |\n199\t| M6 | `png_read_png`/`png_write_png` paired | all transform bits, round trip | [ ] |\n200\t| M7 | `png_handle_as_unknown`, `png_set_keep_unknown_chunks` interaction | every keep value with an all-chunk image | [ ] |\n201\t| M8 | `png_free_data` / `png_data_freer` | every mask × freer combination on a fully populated info struct | [ ] |\n202\t"}]},"parent_tool_use_id":"toolu_bdrk_01AxwS3LQDAQG2Gmsh4CrGkB","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"01dd9f16-fe34-4684-a8ab-42e65f885760","timestamp":"2026-08-14T15:44:33.942Z","subagent_type":"general-purpose","task_description":"Write progressive tests P1-P8"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PULaVsv4BfaVuQMErE7FR2","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both the reference C `libpng.so` and the translated Rust `liblibpng.so` are\n4\t//! loaded with `libloading`; every call goes through the dynamic symbol table,\n5\t//! so the `#[no_mangle]` export wrappers are exercised exactly as an external\n6\t//! consumer would exercise them.\n7\t//!\n8\t//! Each driver produces a *trace*: a `Vec<String>` of every observable event\n9\t//! (return values, warning/error messages, produced bytes, decoded rows).  A\n10\t//! configuration passes when the C trace and the Rust trace are identical.\n11\t#![allow(dead_code)]\n12\t#![allow(non_camel_case_types)]\n13\t#![allow(non_snake_case)]\n14\t\n15\tuse std::cell::RefCell;\n16\tuse std::ffi::{c_char, c_int, c_void, CStr};\n17\tuse std::path::{Path, PathBuf};\n18\tuse std::process::Command;\n19\tuse std::sync::OnceLock;\n20\t\n21\tpub const VER_STRING: &[u8] = b\"1.6.59.git\\0\";\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// Library loading\n25\t// ---------------------------------------------------------------------------\n26\t\n27\tpub struct Lib {\n28\t    lib: libloading::Library,\n29\t    pub tag: &'static str,\n30\t}\n31\t\n32\timpl Lib {\n33\t    pub fn open(path: &Path, tag: &'static str) -> Lib {\n34\t        let lib = unsafe { libloading::Library::new(path) }\n35\t            .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {e}\", path.display()));\n36\t        Lib { lib, tag }\n37\t    }\n38\t\n39\t    /// Resolve `name` and transmute it to the requested function-pointer type.\n40\t    pub fn f<T: Copy>(&self, name: &str) -> T {\n41\t        assert_eq!(\n42\t            std::mem::size_of::<T>(),\n43\t            std::mem::size_of::<*const c_void>(),\n44\t            \"f::<T>() is only for pointer-sized types\"\n45\t        );\n46\t        let p = self.raw(name);\n47\t        unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n48\t    }\n49\t\n50\t    /// Resolve `name`, returning `None` when the symbol is absent.\n51\t    pub fn opt<T: Copy>(&self, name: &str) -> Option<T> {\n52\t        let mut owned = name.as_bytes().to_vec();\n53\t        owned.push(0);\n54\t        let sym: Result<libloading::Symbol<*const c_void>, _> = unsafe { self.lib.get(&owned) };\n55\t        sym.ok().map(|s| {\n56\t            let p = unsafe { *s };\n57\t            unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n58\t        })\n59\t    }\n60\t\n61\t    pub fn raw(&self, name: &str) -> *const c_void {\n62\t        let mut owned = name.as_bytes().to_vec();\n63\t        owned.push(0);\n64\t        let sym: libloading::Symbol<*const c_void> = unsafe { self.lib.get(&owned) }\n65\t            .unwrap_or_else(|e| panic!(\"{}: missing symbol {name}: {e}\", self.tag));\n66\t        unsafe { *sym }\n67\t    }\n68\t\n69\t    /// Address of an exported data object.\n70\t    pub fn data(&self, name: &str) -> *const u8 {\n71\t        self.raw(name) as *const u8\n72\t    }\n73\t}\n74\t\n75\tfn manifest_dir() -> PathBuf {\n76\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n77\t}\n78\t\n79\tpub fn c_so_path() -> PathBuf {\n80\t    if let Ok(p) = std::env::var(\"PNG_C_SO\") {\n81\t        return PathBuf::from(p);\n82\t    }\n83\t    let p = manifest_dir().join(\"target/cbuild/libpng.so\");\n84\t    assert!(\n85\t        p.exists(),\n86\t        \"C reference library not built: {} missing (cmake -S c_src -B target/cbuild && cmake --build target/cbuild)\",\n87\t        p.display()\n88\t    );\n89\t    p\n90\t}\n91\t\n92\tpub fn rust_so_path() -> PathBuf {\n93\t    if let Ok(p) = std::env::var(\"PNG_RUST_SO\") {\n94\t        return PathBuf::from(p);\n95\t    }\n96\t    // The integration test binary lives in target/<profile>/deps/, so the\n97\t    // cdylib is one directory up.\n98\t    let exe = std::env::current_exe().expect(\"current_exe\");\n99\t    let dir = exe.parent().unwrap().parent().unwrap();\n100\t    for name in [\"liblibpng.so\", \"libpng.so\"] {\n101\t        let p = dir.join(name);\n102\t        if p.exists() {\n103\t            return p;\n104\t        }\n105\t    }\n106\t    panic!(\"Rust cdylib not found next to {}\", exe.display());\n107\t}\n108\t\n109\tpub struct Pair {\n110\t    pub c: Lib,\n111\t    pub rust: Lib,\n112\t}\n113\t\n114\tstatic PAIR: OnceLock<Pair> = OnceLock::new();\n115\t\n116\t/// The reference C `.so` is linked without `-lm` (the upstream CMakeLists links\n117\t/// only zlib), so `floor`/`pow` are unresolved in it.  A real application links\n118\t/// libm; we emulate that by loading libm globally before either library is used,\n119\t/// identically for both.\n120\tfn ensure_libm() {\n121\t    static LIBM: OnceLock<Option<libloading::Library>> = OnceLock::new();\n122\t    LIBM.get_or_init(|| unsafe { libloading::Library::new(\"libm.so.6\").ok() });\n123\t}\n124\t\n125\tpub fn pair() -> &'static Pair {\n126\t    PAIR.get_or_init(|| {\n127\t        ensure_libm();\n128\t        // Load the shim first so the landing pad exists before any png_error.\n129\t        shim();\n130\t        Pair {\n131\t            c: Lib::open(&c_so_path(), \"C\"),\n132\t            rust: Lib::open(&rust_so_path(), \"RUST\"),\n133\t        }\n134\t    })\n135\t}\n136\t\n137\t// ---------------------------------------------------------------------------\n138\t// setjmp/longjmp shim\n139\t// ---------------------------------------------------------------------------\n140\t\n141\tpub type ThFn = Option<unsafe extern \"C\" fn(*mut c_void)>;\n142\t\n143\tpub struct Shim {\n144\t    _lib: libloading::Library,\n145\t    protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int,\n146\t    pub longjmp_ptr: *const c_void,\n147\t    pub jmp_buf_size: usize,\n148\t}\n149\t\n150\tunsafe impl Send for Shim {}\n151\tunsafe impl Sync for Shim {}\n152\t\n153\tstatic SHIM: OnceLock<Shim> = OnceLock::new();\n154\t\n155\tpub fn shim() -> &'static Shim {\n156\t    SHIM.get_or_init(|| {\n157\t        let src = manifest_dir().join(\"tests/support/testshim.c\");\n158\t        let out_dir = manifest_dir().join(\"target/testsupport\");\n159\t        std::fs::create_dir_all(&out_dir).unwrap();\n160\t        let so = out_dir.join(\"libtestshim.so\");\n161\t        // Compile to a unique file then rename: several test binaries may race.\n162\t        let tmp = out_dir.join(format!(\"libtestshim-{}.so\", std::process::id()));\n163\t        let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());\n164\t        let st = Command::new(&cc)\n165\t            .args([\"-O0\", \"-fPIC\", \"-shared\", \"-o\"])\n166\t            .arg(&tmp)\n167\t            .arg(&src)\n168\t            .status()\n169\t            .expect(\"failed to run C compiler for test shim\");\n170\t        assert!(st.success(), \"test shim compilation failed\");\n171\t        std::fs::rename(&tmp, &so).unwrap();\n172\t\n173\t        let lib = unsafe { libloading::Library::new(&so) }.expect(\"dlopen test shim\");\n174\t        let protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int = unsafe {\n175\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_protect\\0\").unwrap();\n176\t            std::mem::transmute(*s)\n177\t        };\n178\t        let longjmp_ptr = unsafe {\n179\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_longjmp\\0\").unwrap();\n180\t            *s\n181\t        };\n182\t        let size_fn: unsafe extern \"C\" fn() -> usize = unsafe {\n183\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_jmp_buf_size\\0\").unwrap();\n184\t            std::mem::transmute(*s)\n185\t        };\n186\t        let jmp_buf_size = unsafe { size_fn() };\n187\t        Shim {\n188\t            _lib: lib,\n189\t            protect,\n190\t            longjmp_ptr,\n191\t            jmp_buf_size,\n192\t        }\n193\t    })\n194\t}\n195\t\n196\t/// Run `f` with a longjmp landing pad installed.  Returns 0 when `f` completed\n197\t/// normally, non-zero when libpng (or a harness callback) performed a longjmp.\n198\t///\n199\t/// `f` must not own anything that needs dropping: a longjmp skips destructors.\n200\tpub fn protected<F: FnMut()>(mut f: F) -> c_int {\n201\t    unsafe extern \"C\" fn tramp<F: FnMut()>(p: *mut c_void) {\n202\t        unsafe { (*(p as *mut F))() }\n203\t    }\n204\t    let s = shim();\n205\t    unsafe { (s.protect)(Some(tramp::<F>), &mut f as *mut F as *mut c_void) }\n206\t}\n207\t\n208\t// ---------------------------------------------------------------------------\n209\t// Per-thread session state (trace log + simulated I/O)\n210\t// ---------------------------------------------------------------------------\n211\t\n212\t#[derive(Default)]\n213\tpub struct Session {\n214\t    pub log: Vec<String>,\n215\t    /// Bytes handed to the write callback.\n216\t    pub out: Vec<u8>,\n217\t    /// Bytes served by the read callback.\n218\t    pub input: Vec<u8>,\n219\t    pub rpos: usize,\n220\t    /// Trace every png_malloc/png_free through the user-memory callbacks.\n221\t    pub trace_alloc: bool,\n222\t    /// Count of live allocations made through the user-memory callbacks.\n223\t    pub live_allocs: i64,\n224\t    /// Make the write callback fail (longjmp) once this many bytes were written.\n225\t    pub write_limit: Option<usize>,\n226\t    /// Fail malloc after this many successful allocations.\n227\t    pub malloc_limit: Option<usize>,\n228\t    pub malloc_count: usize,\n229\t}\n230\t\n231\tthread_local! {\n232\t    static SESSION: RefCell<Session> = RefCell::new(Session::default());\n233\t}\n234\t\n235\tpub fn session_reset(input: Vec<u8>) {\n236\t    SESSION.with(|s| {\n237\t        let mut s = s.borrow_mut();\n238\t        *s = Session::default();\n239\t        s.input = input;\n240\t    });\n241\t}\n242\t\n243\tpub fn with_session<R>(f: impl FnOnce(&mut Session) -> R) -> R {\n244\t    SESSION.with(|s| f(&mut s.borrow_mut()))\n245\t}\n246\t\n247\tpub fn log(msg: impl AsRef<str>) {\n248\t    let m = msg.as_ref().to_string();\n249\t    SESSION.with(|s| s.borrow_mut().log.push(m));\n250\t}\n251\t\n252\tpub fn take_log() -> Vec<String> {\n253\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().log))\n254\t}\n255\t\n256\tpub fn take_out() -> Vec<u8> {\n257\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().out))\n258\t}\n259\t\n260\tpub fn cstr(p: *const c_char) -> String {\n261\t    if p.is_null() {\n262\t        return \"<null>\".to_string();\n263\t    }\n264\t    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()\n265\t}\n266\t\n267\tpub fn hex(b: &[u8]) -> String {\n268\t    let mut s = String::with_capacity(b.len() * 2);\n269\t    for x in b {\n270\t        s.push_str(&format!(\"{x:02x}\"));\n271\t    }\n272\t    s\n273\t}\n274\t\n275\t// ---------------------------------------------------------------------------\n276\t// libpng callbacks (identical for both libraries)\n277\t// ---------------------------------------------------------------------------\n278\t\n279\tpub unsafe extern \"C\" fn cb_error(_png: *mut c_void, msg: *const c_char) {\n280\t    log(format!(\"ERROR({})\", cstr(msg)));\n281\t    // Returning lets libpng call png_longjmp -> th_longjmp, which is what a\n282\t    // real application relies on.\n283\t}\n284\t\n285\tpub unsafe extern \"C\" fn cb_warning(_png: *mut c_void, msg: *const c_char) {\n286\t    log(format!(\"WARNING({})\", cstr(msg)));\n287\t}\n288\t\n289\tpub unsafe extern \"C\" fn cb_write(_png: *mut c_void, data: *mut u8, len: usize) {\n290\t    let mut over = false;\n291\t    SESSION.with(|s| {\n292\t        let mut s = s.borrow_mut();\n293\t        if len > 0 {\n294\t            let src = unsafe { std::slice::from_raw_parts(data, len) };\n295\t            s.out.extend_from_slice(src);\n296\t        }\n297\t        if let Some(lim) = s.write_limit {\n298\t            if s.out.len() > lim {\n299\t                over = true;\n300\t            }\n301\t        }\n302\t    });\n303\t    if over {\n304\t        log(\"WRITE_LIMIT\".to_string());\n305\t        th_longjmp_now(7);\n306\t    }\n307\t}\n308\t\n309\tpub unsafe extern \"C\" fn cb_flush(_png: *mut c_void) {\n310\t    log(\"FLUSH\".to_string());\n311\t}\n312\t\n313\tpub unsafe extern \"C\" fn cb_read(_png: *mut c_void, data: *mut u8, len: usize) {\n314\t    let mut short = false;\n315\t    SESSION.with(|s| {\n316\t        let mut s = s.borrow_mut();\n317\t        let avail = s.input.len().saturating_sub(s.rpos);\n318\t        if avail < len {\n319\t            short = true;\n320\t        } else {\n321\t            if len > 0 {\n322\t                let src = &s.input[s.rpos..s.rpos + len];\n323\t                unsafe { std::ptr::copy_nonoverlapping(src.as_ptr(), data, len) };\n324\t            }\n325\t            s.rpos += len;\n326\t        }\n327\t    });\n328\t    if short {\n329\t        log(\"READ_SHORT\".to_string());\n330\t        th_longjmp_now(3);\n331\t    }\n332\t}\n333\t\n334\t/// User-memory malloc callback: `png_malloc_ptr`.\n335\tpub unsafe extern \"C\" fn cb_malloc(_png: *mut c_void, size: usize) -> *mut c_void {\n336\t    let mut fail = false;\n337\t    SESSION.with(|s| {\n338\t        let mut s = s.borrow_mut();\n339\t        s.malloc_count += 1;\n340\t        if let Some(lim) = s.malloc_limit {\n341\t            if s.malloc_count > lim {\n342\t                fail = true;\n343\t            }\n344\t        }\n345\t        if s.trace_alloc {\n346\t            let n = s.malloc_count;\n347\t            s.log.push(format!(\"MALLOC(#{n},{size})\"));\n348\t        }\n349\t        if !fail {\n350\t            s.live_allocs += 1;\n351\t        }\n352\t    });\n353\t    if fail {\n354\t        return std::ptr::null_mut();\n355\t    }\n356\t    // Use calloc so that any dependence on uninitialised memory shows up\n357\t    // identically in both libraries.\n358\t    unsafe { libc_calloc(1, if size == 0 { 1 } else { size }) }\n359\t}\n360\t\n361\tpub unsafe extern \"C\" fn cb_free(_png: *mut c_void, p: *mut c_void) {\n362\t    SESSION.with(|s| {\n363\t        let mut s = s.borrow_mut();\n364\t        if s.trace_alloc {\n365\t            s.log.push(format!(\"FREE({})\", if p.is_null() { 0 } else { 1 }));\n366\t        }\n367\t        if !p.is_null() {\n368\t            s.live_allocs -= 1;\n369\t        }\n370\t    });\n371\t    if !p.is_null() {\n372\t        unsafe { libc_free(p) };\n373\t    }\n374\t}\n375\t\n376\textern \"C\" {\n377\t    #[link_name = \"calloc\"]\n378\t    fn libc_calloc(n: usize, size: usize) -> *mut c_void;\n379\t    #[link_name = \"free\"]\n380\t    fn libc_free(p: *mut c_void);\n381\t}\n382\t\n383\tpub fn th_longjmp_now(val: c_int) -> ! {\n384\t    let f: unsafe extern \"C\" fn(*mut c_void, c_int) =\n385\t        unsafe { std::mem::transmute(shim().longjmp_ptr) };\n386\t    unsafe { f(std::ptr::null_mut(), val) };\n387\t    unreachable!(\"th_longjmp returned\");\n388\t}\n389\t\n390\t// ---------------------------------------------------------------------------\n391\t// Trace comparison\n392\t// ---------------------------------------------------------------------------\n393\t\n394\tpub struct Trace {\n395\t    pub lines: Vec<String>,\n396\t    pub out: Vec<u8>,\n397\t    pub rc: c_int,\n398\t}\n399\t\n400\timpl Trace {\n401\t    pub fn render(&self) -> String {\n402\t        let mut s = String::new();\n403\t        s.push_str(&format!(\"rc={}\\n\", self.rc));\n404\t        for l in &self.lines {\n405\t            s.push_str(l);\n406\t            s.push('\\n');\n407\t        }\n408\t        s.push_str(&format!(\"out.len={}\\n\", self.out.len()));\n409\t        s.push_str(&format!(\"out={}\\n\", hex(&self.out)));\n410\t        s\n411\t    }\n412\t}\n413\t\n414\t/// Every distinct `ERROR(...)`/`WARNING(...)` line observed from the C library,\n415\t/// appended to `target/testsupport/observed_msgs.txt` for mechanical\n416\t/// ERRORS.md coverage accounting.\n417\tstatic SEEN: OnceLock<std::sync::Mutex<std::collections::HashSet<String>>> = OnceLock::new();\n418\t\n419\tpub fn record_messages(lines: &[String]) {\n420\t    let set = SEEN.get_or_init(|| std::sync::Mutex::new(std::collections::HashSet::new()));\n421\t    let mut fresh: Vec<String> = Vec::new();\n422\t    {\n423\t        let mut g = set.lock().unwrap();\n424\t        for l in lines {\n425\t            if l.starts_with(\"ERROR(\") || l.starts_with(\"WARNING(\") || l.starts_with(\"IMAGE_ERR(\")\n426\t            {\n427\t                if g.insert(l.clone()) {\n428\t                    fresh.push(l.clone());\n429\t                }\n430\t            }\n431\t        }\n432\t    }\n433\t    if fresh.is_empty() {\n434\t        return;\n435\t    }\n436\t    use std::io::Write;\n437\t    let dir = manifest_dir().join(\"target/testsupport\");\n438\t    let _ = std::fs::create_dir_all(&dir);\n439\t    if let Ok(mut f) = std::fs::OpenOptions::new()\n440\t        .create(true)\n441\t        .append(true)\n442\t        .open(dir.join(\"observed_msgs.txt\"))\n443\t    {\n444\t        for l in fresh {\n445\t            let _ = writeln!(f, \"{l}\");\n446\t        }\n447\t    }\n448\t}\n449\t\n450\t/// Run one driver closure against both libraries and require identical traces.\n451\tpub fn diff(label: &str, mut run: impl FnMut(&Lib) -> Trace) {\n452\t    let p = pair();\n453\t    let ct = run(&p.c);\n454\t    let rt = run(&p.rust);\n455\t    record_messages(&ct.lines);\n456\t    if ct.render() != rt.render() {\n457\t        let a = ct.render();\n458\t        let b = rt.render();\n459\t        let mut first = String::new();\n460\t        for (i, (la, lb)) in a.lines().zip(b.lines()).enumerate() {\n461\t            if la != lb {\n462\t                let sa = clip(la);\n463\t                let sb = clip(lb);\n464\t                first = format!(\"first divergence at trace line {i}:\\n  C   : {sa}\\n  RUST: {sb}\");\n465\t                break;\n466\t            }\n467\t        }\n468\t        if first.is_empty() {\n469\t            let na = a.lines().count();\n470\t            let nb = b.lines().count();\n471\t            first = format!(\"trace lengths differ: C={na} lines, RUST={nb} lines\");\n472\t        }\n473\t        panic!(\"[{label}] C and Rust diverge\\n{first}\\n\");\n474\t    }\n475\t}\n476\t\n477\tfn clip(s: &str) -> String {\n478\t    if s.len() <= 400 {\n479\t        s.to_string()\n480\t    } else {\n481\t        format!(\"{}...<{} bytes total>\", &s[..400], s.len())\n482\t    }\n483\t}\n484\t\n485\t// ---------------------------------------------------------------------------\n486\t// Deterministic PRNG (xorshift64*) so every test is reproducible.\n487\t// ---------------------------------------------------------------------------\n488\t\n489\tpub struct Rng(pub u64);\n490\t\n491\timpl Rng {\n492\t    pub fn new(seed: u64) -> Rng {\n493\t        Rng(seed | 1)\n494\t    }\n495\t    pub fn next_u64(&mut self) -> u64 {\n496\t        let mut x = self.0;\n497\t        x ^= x >> 12;\n498\t        x ^= x << 25;\n499\t        x ^= x >> 27;\n500\t        self.0 = x;\n501\t        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n502\t    }\n503\t    pub fn next_u32(&mut self) -> u32 {\n504\t        (self.next_u64() >> 32) as u32\n505\t    }\n506\t    pub fn below(&mut self, n: u32) -> u32 {\n507\t        if n == 0 {\n508\t            0\n509\t        } else {\n510\t            self.next_u32() % n\n511\t        }\n512\t    }\n513\t    pub fn byte(&mut self) -> u8 {\n514\t        (self.next_u64() >> 24) as u8\n515\t    }\n516\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n517\t        (0..n).map(|_| self.byte()).collect()\n518\t    }\n519\t    pub fn f64(&mut self) -> f64 {\n520\t        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64\n521\t    }\n522\t}\n523\t\n524\t// ---------------------------------------------------------------------------\n525\t// Sub-modules\n526\t// ---------------------------------------------------------------------------\n527\t\n528\tpub mod core;\n529\tpub mod pngbuild;\n530\t\n531\tuse crate::support::core::{Cb, Core, Info, Png};\n532\t\n533\t/// Create a write struct wired to the harness callbacks, run `body`, destroy.\n534\tpub fn with_write(lib: &Lib, body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n535\t    session_reset(Vec::new());\n536\t    let core = Core::new(lib);\n537\t    let rc = protected(|| unsafe {\n538\t        let png = (core.create_write)(\n539\t            VER_STRING.as_ptr() as *const c_char,\n540\t            std::ptr::null_mut(),\n541\t            cb_error as Cb,\n542\t            cb_warning as Cb,\n543\t        );\n544\t        log(format!(\"create_write={}\", if png.is_null() { 0 } else { 1 }));\n545\t        if png.is_null() {\n546\t            return;\n547\t        }\n548\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n549\t        (core.set_write_fn)(png, std::ptr::null_mut(), cb_write as Cb, cb_flush as Cb);\n550\t        let info = (core.create_info)(png);\n551\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n552\t        body(&core, png, info);\n553\t        let mut p = png;\n554\t        let mut i = info;\n555\t        (core.destroy_write)(&mut p, &mut i);\n556\t        log(\"destroyed\".to_string());\n557\t    });\n558\t    Trace {\n559\t        lines: take_log(),\n560\t        out: take_out(),\n561\t        rc,\n562\t    }\n563\t}\n564\t\n565\t/// Create a read struct fed from `input`, run `body`, destroy.\n566\tpub fn with_read(lib: &Lib, input: &[u8], body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n567\t    session_reset(input.to_vec());\n568\t    let core = Core::new(lib);\n569\t    let rc = protected(|| unsafe {\n570\t        let png = (core.create_read)(\n571\t            VER_STRING.as_ptr() as *const c_char,\n572\t            std::ptr::null_mut(),\n573\t            cb_error as Cb,\n574\t            cb_warning as Cb,\n575\t        );\n576\t        log(format!(\"create_read={}\", if png.is_null() { 0 } else { 1 }));\n577\t        if png.is_null() {\n578\t            return;\n579\t        }\n580\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n581\t        (core.set_read_fn)(png, std::ptr::null_mut(), cb_read as Cb);\n582\t        let info = (core.create_info)(png);\n583\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n584\t        body(&core, png, info);\n585\t        let mut p = png;\n586\t        let mut i = info;\n587\t        (core.destroy_read)(&mut p, &mut i, std::ptr::null_mut());\n588\t        log(\"destroyed\".to_string());\n589\t    });\n590\t    Trace {\n591\t        lines: take_log(),\n592\t        out: take_out(),\n593\t        rc,\n594\t    }\n595\t}\n596\t\n597\t/// Log every ancillary-information getter, so that any divergence in the\n598\t/// decoded info struct shows up in the trace.\n599\tpub unsafe fn log_all_info(c: &Core, png: Png, info: Info) {\n600\t    use crate::support::core::*;\n601\t    let mut w = 0u32;\n602\t    let mut h = 0u32;\n603\t    let (mut bd, mut ct, mut il, mut cm, mut fm) = (0, 0, 0, 0, 0);\n604\t    let r = (c.get_IHDR)(png, info, &mut w, &mut h, &mut bd, &mut ct, &mut il, &mut cm, &mut fm);\n605\t    log(format!(\n606\t        \"IHDR rc={r} w={w} h={h} depth={bd} color={ct} interlace={il} comp={cm} filter={fm}\"\n607\t    ));\n608\t    log(format!(\n609\t        \"rowbytes={} channels={} palette_max={}\",\n610\t        (c.get_rowbytes)(png, info),\n611\t        (c.get_channels)(png, info),\n612\t        (c.get_palette_max)(png, info)\n613\t    ));\n614\t    let mut valid = 0u32;\n615\t    for (name, flag) in [\n616\t        (\"gAMA\", PNG_INFO_gAMA),\n617\t        (\"sBIT\", PNG_INFO_sBIT),\n618\t        (\"cHRM\", PNG_INFO_cHRM),\n619\t        (\"PLTE\", PNG_INFO_PLTE),\n620\t        (\"tRNS\", PNG_INFO_tRNS),\n621\t        (\"bKGD\", PNG_INFO_bKGD),\n622\t        (\"hIST\", PNG_INFO_hIST),\n623\t        (\"pHYs\", PNG_INFO_pHYs),\n624\t        (\"oFFs\", PNG_INFO_oFFs),\n625\t        (\"tIME\", PNG_INFO_tIME),\n626\t        (\"pCAL\", PNG_INFO_pCAL),\n627\t        (\"sRGB\", PNG_INFO_sRGB),\n628\t        (\"iCCP\", PNG_INFO_iCCP),\n629\t        (\"sPLT\", PNG_INFO_sPLT),\n630\t        (\"sCAL\", PNG_INFO_sCAL),\n631\t        (\"IDAT\", PNG_INFO_IDAT),\n632\t        (\"eXIf\", PNG_INFO_eXIf),\n633\t        (\"cICP\", PNG_INFO_cICP),\n634\t        (\"cLLI\", PNG_INFO_cLLI),\n635\t        (\"mDCV\", PNG_INFO_mDCV),\n636\t    ] {\n637\t        let v = (c.get_valid)(png, info, flag);\n638\t        if v != 0 {\n639\t            valid |= flag;\n640\t        }\n641\t        log(format!(\"valid.{name}={v}\"));\n642\t    }\n643\t\n644\t    // PLTE\n645\t    let mut pal: *mut u8 = std::ptr::null_mut();\n646\t    let mut npal: c_int = -1;\n647\t    let r = (c.get_PLTE)(png, info, &mut pal, &mut npal);\n648\t    log(format!(\"PLTE rc={r} n={npal}\"));\n649\t    if r != 0 && !pal.is_null() && npal > 0 {\n650\t        let s = std::slice::from_raw_parts(pal, npal as usize * 3);\n651\t        log(format!(\"PLTE data={}\", hex(s)));\n652\t    }\n653\t    // tRNS\n654\t    let mut ta: *mut u8 = std::ptr::null_mut();\n655\t    let mut nt: c_int = -1;\n656\t    let mut tc: *mut u8 = std::ptr::null_mut();\n657\t    let r = (c.get_tRNS)(png, info, &mut ta, &mut nt, &mut tc);\n658\t    log(format!(\"tRNS rc={r} n={nt}\"));\n659\t    if r != 0 && !ta.is_null() && nt > 0 {\n660\t        log(format!(\n661\t            \"tRNS alpha={}\",\n662\t            hex(std::slice::from_raw_parts(ta, nt as usize))\n663\t        ));\n664\t    }\n665\t    if r != 0 && !tc.is_null() {\n666\t        let v = *(tc as *const PngColor16);\n667\t        log(format!(\n668\t            \"tRNS color idx={} r={} g={} b={} gray={}\",\n669\t            v.index, v.red, v.green, v.blue, v.gray\n670\t        ));\n671\t    }\n672\t    // gAMA\n673\t    let mut g: i32 = -1;\n674\t    log(format!(\n675\t        \"gAMA rc={} v={g}\",\n676\t        (c.get_gAMA_fixed)(png, info, &mut g)\n677\t    ));\n678\t    let mut gd: f64 = -1.0;\n679\t    log(format!(\n680\t        \"gAMA_fp rc={} v={:.10}\",\n681\t        (c.get_gAMA)(png, info, &mut gd),\n682\t        gd\n683\t    ));\n684\t    // sRGB\n685\t    let mut intent: c_int = -1;\n686\t    log(format!(\n687\t        \"sRGB rc={} intent={intent}\",\n688\t        (c.get_sRGB)(png, info, &mut intent)\n689\t    ));\n690\t    // cHRM\n691\t    let mut v = [0i32; 8];\n692\t    let r = (c.get_cHRM_fixed)(\n693\t        png, info, &mut v[0], &mut v[1], &mut v[2], &mut v[3], &mut v[4], &mut v[5], &mut v[6],\n694\t        &mut v[7],\n695\t    );\n696\t    log(format!(\"cHRM rc={r} {v:?}\"));\n697\t    let mut xyz = [0i32; 9];\n698\t    let r = (c.get_cHRM_XYZ_fixed)(\n699\t        png, info, &mut xyz[0], &mut xyz[1], &mut xyz[2], &mut xyz[3], &mut xyz[4], &mut xyz[5],\n700\t        &mut xyz[6], &mut xyz[7], &mut xyz[8],\n701\t    );\n702\t    log(format!(\"cHRM_XYZ rc={r} {xyz:?}\"));\n703\t    // iCCP\n704\t    let mut name: *mut c_char = std::ptr::null_mut();\n705\t    let mut comp: c_int = -1;\n706\t    let mut prof: *mut u8 = std::ptr::null_mut();\n707\t    let mut plen: u32 = 0;\n708\t    let r = (c.get_iCCP)(png, info, &mut name, &mut comp, &mut prof, &mut plen);\n709\t    log(format!(\n710\t        \"iCCP rc={r} name={} comp={comp} len={plen}\",\n711\t        cstr(name)\n712\t    ));\n713\t    if r != 0 && !prof.is_null() && plen > 0 {\n714\t        log(format!(\n715\t            \"iCCP data={}\",\n716\t            hex(std::slice::from_raw_parts(prof, plen as usize))\n717\t        ));\n718\t    }\n719\t    // sBIT\n720\t    let mut sb: *mut u8 = std::ptr::null_mut();\n721\t    let r = (c.get_sBIT)(png, info, &mut sb);\n722\t    log(format!(\"sBIT rc={r}\"));\n723\t    if r != 0 && !sb.is_null() {\n724\t        let v = *(sb as *const PngColor8);\n725\t        log(format!(\"sBIT v={v:?}\"));\n726\t    }\n727\t    // bKGD\n728\t    let mut bk: *mut u8 = std::ptr::null_mut();\n729\t    let r = (c.get_bKGD)(png, info, &mut bk);\n730\t    log(format!(\"bKGD rc={r}\"));\n731\t    if r != 0 && !bk.is_null() {\n732\t        let v = *(bk as *const PngColor16);\n733\t        log(format!(\"bKGD v={v:?}\"));\n734\t    }\n735\t    // hIST\n736\t    let mut hi: *mut u16 = std::ptr::null_mut();\n737\t    let r = (c.get_hIST)(png, info, &mut hi);\n738\t    log(format!(\"hIST rc={r}\"));\n739\t    if r != 0 && !hi.is_null() && npal > 0 {\n740\t        let s = std::slice::from_raw_parts(hi, npal as usize);\n741\t        log(format!(\"hIST v={s:?}\"));\n742\t    }\n743\t    // pHYs\n744\t    let (mut px, mut py, mut unit) = (0u32, 0u32, 0);\n745\t    log(format!(\n746\t        \"pHYs rc={} x={px} y={py} unit={unit}\",\n747\t        (c.get_pHYs)(png, info, &mut px, &mut py, &mut unit)\n748\t    ));\n749\t    // oFFs\n750\t    let (mut ox, mut oy, mut ounit) = (0i32, 0i32, 0);\n751\t    log(format!(\n752\t        \"oFFs rc={} x={ox} y={oy} unit={ounit}\",\n753\t        (c.get_oFFs)(png, info, &mut ox, &mut oy, &mut ounit)\n754\t    ));\n755\t    // tIME\n756\t    let mut tp: *mut u8 = std::ptr::null_mut();\n757\t    let r = (c.get_tIME)(png, info, &mut tp);\n758\t    log(format!(\"tIME rc={r}\"));\n759\t    if r != 0 && !tp.is_null() {\n760\t        let v = *(tp as *const PngTime);\n761\t        log(format!(\"tIME v={v:?}\"));\n762\t    }\n763\t    // pCAL\n764\t    let mut purpose: *mut c_char = std::ptr::null_mut();\n765\t    let (mut x0, mut x1) = (0i32, 0i32);\n766\t    let (mut etype, mut nparams) = (0, 0);\n767\t    let mut units: *mut c_char = std::ptr::null_mut();\n768\t    let mut params: *mut *mut c_char = std::ptr::null_mut();\n769\t    let r = (c.get_pCAL)(\n770\t        png,\n771\t        info,\n772\t        &mut purpose,\n773\t        &mut x0,\n774\t        &mut x1,\n775\t        &mut etype,\n776\t        &mut nparams,\n777\t        &mut units,\n778\t        &mut params,\n779\t    