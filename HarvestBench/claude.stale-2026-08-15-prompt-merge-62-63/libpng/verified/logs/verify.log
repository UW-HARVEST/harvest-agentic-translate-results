(\n550\t                lib,\n551\t                W,\n552\t                H,\n553\t                depth,\n554\t                PNG_COLOR_TYPE_PALETTE,\n555\t                &rows,\n556\t                &mut |c, png, info| unsafe {\n557\t                    (c.set_PLTE)(png, info, pal.as_ptr(), npal);\n558\t                    log(format!(\"set_PLTE n={npal} valid={}\", (c.get_valid)(png, info, I_PLTE)));\n559\t                },\n560\t            )\n561\t        });\n562\t    }\n563\t    // a palette attached to a truecolour image: legal, written as a suggested\n564\t    // palette\n565\t    for &npal in &[1i32, 16, 256] {\n566\t        let mut rng = Rng::new(0xC190_0000 + npal as u64);\n567\t        let pal = rng.bytes(npal as usize * 3);\n568\t        let rows = img(0xC191_0000 + npal as u64, W, H, 8, PNG_COLOR_TYPE_RGB, 0);\n569\t        diff(&format!(\"C1 suggested-palette-on-RGB n={npal}\"), |lib| {\n570\t            rt(lib, W, H, 8, PNG_COLOR_TYPE_RGB, &rows, &mut |c, png, info| unsafe {\n571\t                (c.set_PLTE)(png, info, pal.as_ptr(), npal);\n572\t                log(format!(\"set_PLTE n={npal} valid={}\", (c.get_valid)(png, info, I_PLTE)));\n573\t            })\n574\t        });\n575\t    }\n576\t}\n577\t\n578\t// ===========================================================================\n579\t// C2 — png_set_tRNS / png_get_tRNS\n580\t// ===========================================================================\n581\t\n582\t#[test]\n583\tfn c2_trns() {\n584\t    ensure_libm();\n585\t    // palette alpha arrays, 1..256 entries\n586\t    for &nt in &[1i32, 2, 3, 16, 64, 129, 255, 256] {\n587\t        let mut rng = Rng::new(0xC200_0000 + nt as u64);\n588\t        let pal = rng.bytes(256 * 3);\n589\t        let alpha = rng.bytes(nt as usize);\n590\t        let rows = img(0xC201_0000 + nt as u64, W, H, 8, PNG_COLOR_TYPE_PALETTE, 256);\n591\t        diff(&format!(\"C2 palette-tRNS n={nt}\"), |lib| {\n592\t            rt(\n593\t                lib,\n594\t                W,\n595\t                H,\n596\t                8,\n597\t                PNG_COLOR_TYPE_PALETTE,\n598\t                &rows,\n599\t                &mut |c, png, info| unsafe {\n600\t                    (c.set_PLTE)(png, info, pal.as_ptr(), 256);\n601\t                    (c.set_tRNS)(png, info, alpha.as_ptr(), nt, std::ptr::null());\n602\t                    log(format!(\"set_tRNS n={nt} valid={}\", (c.get_valid)(png, info, I_tRNS)));\n603\t                },\n604\t            )\n605\t        });\n606\t    }\n607\t    // grey key, 8 and 16 bit\n608\t    for &depth in &[8i32, 16] {\n609\t        let maxv: u32 = if depth == 8 { 255 } else { 65535 };\n610\t        let mut rng = Rng::new(0xC220_0000 + depth as u64);\n611\t        let mut keys: Vec<u16> = vec![0, maxv as u16];\n612\t        for _ in 0..4 {\n613\t            keys.push(rng.below(maxv + 1) as u16);\n614\t        }"}]},"parent_tool_use_id":"toolu_bdrk_01XGJhK7CyRFH4G9gHb8xDNT","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"b5d01d48-6f75-4215-9da1-e929379ec844","timestamp":"2026-08-14T15:46:21.349Z","subagent_type":"general-purpose","task_description":"Write chunk round-trip tests C1-C24"}
