4616\t      png_ptr->big_prev_row = (png_bytep)png_malloc(png_ptr, row_bytes + 48);\n4617\t\n4618\t#ifdef PNG_ALIGNED_MEMORY_SUPPORTED\n4619\t      /* Use 16-byte aligned memory for row_buf with at least 16 bytes\n4620\t       * of padding before and after row_buf; treat prev_row similarly.\n4621\t       * NOTE: the alignment is to the start of the pixels, one beyond the start\n4622\t       * of the buffer, because of the filter byte.  Prior to libpng 1.5.6 this\n4623\t       * was incorrect; the filter byte was aligned, which had the exact\n4624\t       * opposite effect of that intended.\n4625\t       */\n4626\t      {\n4627\t         png_bytep temp = png_ptr->big_row_buf + 32;\n4628\t         size_t extra = (size_t)temp & 0x0f;\n4629\t         png_ptr->row_buf = temp - extra - 1/*filter byte*/;\n4630\t\n4631\t         temp = png_ptr->big_prev_row + 32;\n4632\t         extra = (size_t)temp & 0x0f;\n4633\t         png_ptr->prev_row = temp - extra - 1/*filter byte*/;\n4634\t      }\n4635\t#else\n4636\t      /* Use 31 bytes of padding before and 17 bytes after row_buf. */\n4637\t      png_ptr->row_buf = png_ptr->big_row_buf + 31;\n4638\t      png_ptr->prev_row = png_ptr->big_prev_row + 31;\n4639\t#endif\n4640\t      png_ptr->old_big_row_buf_size = row_bytes + 48;\n4641\t   }\n4642\t\n4643\t#ifdef PNG_MAX_MALLOC_64K\n4644\t   if (png_ptr->rowbytes > 65535)\n4645\t      png_error(png_ptr, \"This image requires a row greater than 64KB\");\n4646\t\n4647\t#endif\n4648\t   if (png_ptr->rowbytes > (PNG_SIZE_MAX - 1))\n4649\t      png_error(png_ptr, \"Row has too many bytes to allocate in memory\");\n4650\t\n4651\t   memset(png_ptr->prev_row, 0, png_ptr->rowbytes + 1);\n4652\t\n4653\t   png_debug1(3, \"width = %u,\", png_ptr->width);\n4654\t   png_debug1(3, \"height = %u,\", png_ptr->height);\n4655\t   png_debug1(3, \"iwidth = %u,\", png_ptr->iwidth);\n4656\t   png_debug1(3, \"num_rows = %u,\", png_ptr->num_rows);\n4657\t   png_debug1(3, \"rowbytes = %lu,\", (unsigned long)png_ptr->rowbytes);\n4658\t   png_debug1(3, \"irowbytes = %lu\",\n4659\t       (unsigned long)PNG_ROWBYTES(png_ptr->pixel_depth, png_ptr->iwidth) + 1);\n4660\t\n4661\t   /* The sequential reader needs a buffer for IDAT, but the progressive reader\n4662\t    * does not, so free the read buffer now regardless; the sequential reader\n4663\t    * reallocates it on demand.\n4664\t    */\n4665\t   if (png_ptr->read_buffer != NULL)\n4666\t   {\n4667\t      png_bytep buffer = png_ptr->read_buffer;\n4668\t\n4669\t      png_ptr->read_buffer_size = 0;\n4670\t      png_ptr->read_buffer = NULL;\n4671\t      png_free(png_ptr, buffer);\n4672\t   }\n4673\t\n4674\t   /* Finally claim the zstream for the inflate of the IDAT data, use the bits\n4675\t    * value from the stream (note that this will result in a fatal error if the\n4676\t    * IDAT stream has a bogus deflate header window_bits value, but this should\n4677\t    * not be happening any longer!)\n4678\t    */\n4679\t   if (png_inflate_claim(png_ptr, png_IDAT) != Z_OK)\n4680\t      png_error(png_ptr, png_ptr->zstream.msg);\n4681\t\n4682\t   png_ptr->flags |= PNG_FLAG_ROW_INIT;\n4683\t}\n4684\t#endif /* READ */"}]},"parent_tool_use_id":"toolu_bdrk_01466Nqb5z9B7fwBv76vVDfC","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"608a9316-abf3-4cbe-b008-0031cfebe799","timestamp":"2026-08-14T15:48:25.050Z","subagent_type":"general-purpose","task_description":"Phase C read-stream error tests"}
