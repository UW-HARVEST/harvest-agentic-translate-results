{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AyTiwSbjwCcSncHmHy1gds","type":"tool_result","content":"376\t                });\n377\t            }\n378\t        }\n379\t    }\n380\t}\n381\t\n382\t// ---------------------------------------------------------------------------\n383\t// W14 — png_set_flush + png_write_flush\n384\t// ---------------------------------------------------------------------------\n385\t//\n386\t// `png_write_filtered_row` increments `flush_rows` and calls\n387\t// `png_write_flush` once `flush_rows >= flush_dist` (with flush_dist > 0).\n388\t// `png_write_flush` is a no-op once `row_number >= num_rows`.\n389\t// The harness `cb_flush` logs `FLUSH`, and `out.len` is logged after every row,\n390\t// so the flush ordering relative to the produced bytes is compared.\n391\t\n392\t#[test]\n393\tfn w14_flush() {\n394\t    let mut rng = Rng::new(0x2414);\n395\t    let w = 14u32;\n396\t    let h = 12u32;\n397\t    let images: Vec<(&str, Vec<Vec<u8>>)> = vec![\n398\t        (\"grad\", gradient_rows(&mut rng, w, h)),\n399\t        (\"noise\", noise_rows(&mut rng, w, h)),\n400\t    ];\n401\t    for (name, rows) in &images {\n402\t        for &n in &[0i32, 1, 2, 3, 7] {\n403\t            // mode 0: automatic flushing only\n404\t            // mode 1: + explicit png_write_flush every 3rd row\n405\t            // mode 2: + explicit png_write_flush before the first and after the\n406\t            //           last row (the latter is the no-op path)\n407\t            // mode 3: png_set_flush called again (to 0) half way through\n408\t            for mode in 0..4 {\n409\t                for &il in &[PNG_INTERLACE_NONE, PNG_INTERLACE_ADAM7] {\n410\t                    let label = format!(\"W14 img={name} n={n} mode={mode} il={il}\");\n411\t                    diff(&label, |lib| {\n412\t                        // Two png_write_flush calls with no row data in between\n413\t                        // make zlib return Z_BUF_ERROR, which libpng turns into\n414\t                        // a fatal png_error (\"buffer error\").  That is a real\n415\t                        // configuration; both libraries must reach it at the\n416\t                        // same point, so the longjmp is tolerated here.\n417\t                        wsoft(lib, &mut |c, png, info| unsafe {\n418\t                            (c.set_IHDR)(png, info, w, h, 8, PNG_COLOR_TYPE_RGB, il, 0, 0);\n419\t                            (c.set_flush)(png, n);\n420\t                            log_hdr(c, png, info);\n421\t                            (c.write_info)(png, info);\n422\t                            let passes = if il == PNG_INTERLACE_ADAM7 {\n423\t                                let p = (c.set_interlace_handling)(png);\n424\t                                log(format!(\"passes={p}\"));\n425\t                                p\n426\t                            } else {\n427\t                                1\n428\t                            };\n429\t                            if mode == 2 {\n430\t                                (c.write_flush)(png);\n431\t                                log(format!(\"pre out={}\", outlen()));\n432\t                            }\n433\t                            for pass in 0..passes {\n434\t                                for (i, r) in rows.iter().enumerate() {\n435\t                                    (c.write_row)(png, r.as_ptr());\n436\t                                    log(format!(\"row {pass}/{i} out={}\", outlen()));\n437\t                                    if mode == 1 && i % 3 == 2 {\n438\t                                        (c.write_flush)(png);\n439\t                                        log(format!(\"xflush {pass}/{i} out={}\", outlen()));\n440\t                                    }\n441\t                                    if mode == 3 && i == 5 {\n442\t                                        (c.set_flush)(png, 0);\n443\t                                        log(\"flush off\".to_string());\n444\t                                    }\n445\t                                }"}]},"parent_tool_use_id":"toolu_bdrk_0142wgcwC4DU2gkmXGMTmwBC","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"93ae6d02-9aa0-4ad5-afda-61a700d85284","timestamp":"2026-08-14T15:58:30.279Z","subagent_type":"general-purpose","task_description":"Write write_b tests W13-W24"}
