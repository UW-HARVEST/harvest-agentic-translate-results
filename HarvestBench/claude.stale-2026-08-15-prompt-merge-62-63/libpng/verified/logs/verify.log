ams: *mut *mut c_char = std::ptr::null_mut();\n775\t    let r = (c.get_pCAL)(\n776\t        png,\n777\t        info,\n778\t        &mut purpose,\n779\t        &mut x0,\n780\t        &mut x1,\n781\t        &mut etype,\n782\t        &mut nparams,\n783\t        &mut units,\n784\t        &mut params,\n785\t    );\n786\t    log(format!(\n787\t        \"pCAL rc={r} purpose={} x0={x0} x1={x1} type={etype} nparams={nparams} units={}\",\n788\t        cstr(purpose),\n789\t        cstr(units)\n790\t    ));\n791\t    if r != 0 && !params.is_null() {\n792\t        for i in 0..nparams as isize {\n793\t            log(format!(\"pCAL param[{i}]={}\", cstr(*params.offset(i))));\n794\t        }\n795\t    }\n796\t    // sCAL\n797\t    let mut sunit: c_int = -1;\n798\t    let mut sw: *mut c_char = std::ptr::null_mut();\n799\t    let mut sh: *mut c_char = std::ptr::null_mut();\n800\t    let r = (c.get_sCAL_s)(png, info, &mut sunit, &mut sw, &mut sh);\n801\t    log(format!(\n802\t        \"sCAL rc={r} unit={sunit} w={} h={}\",\n803\t        cstr(sw),\n804\t        cstr(sh)\n805\t    ));\n806\t    // sPLT\n807\t    let mut splt: *mut c_void = std::ptr::null_mut();\n808\t    let n = (c.get_sPLT)(png, info, &mut splt);\n809\t    log(format!(\"sPLT n={n}\"));\n810\t    if n > 0 && !splt.is_null() {\n811\t        let arr = std::slice::from_raw_parts(splt as *const PngSpltT, n as usize);\n812\t        for (i, e) in arr.iter().enumerate() {\n813\t            log(format!(\n814\t                \"sPLT[{i}] name={} depth={} nentries={}\",\n815\t                cstr(e.name),\n816\t                e.depth,\n817\t                e.nentries\n818\t            ));\n819\t            if !e.entries.is_null() && e.nentries > 0 {\n820\t                let ents = std::slice::from_raw_parts(e.entries, e.nentries as usize);\n821\t                log(format!(\"sPLT[{i}] entries={ents:?}\"));\n822\t            }\n823\t        }\n824\t    }\n825\t    // eXIf\n826\t    let mut exif: *mut u8 = std::ptr::null_mut();\n827\t    let mut elen: u32 = 0;\n828\t    let r = (c.get_eXIf_1)(png, info, &mut elen, &mut exif);\n829\t    log(format!(\"eXIf rc={r} len={elen}\"));\n830\t    if r != 0 && !exif.is_null() && elen > 0 {\n831\t        log(format!(\n832\t            \"eXIf data={}\",\n833\t            hex(std::slice::from_raw_parts(exif, elen as usize))\n834\t        ));\n835\t    }\n836\t    // cICP\n837\t    let (mut cp, mut tf, mut mc, mut vfr) = (0u8, 0u8, 0u8, 0u8);\n838\t    log(format!(\n839\t        \"cICP rc={} p={cp} t={tf} m={mc} f={vfr}\",\n840\t        (c.get_cICP)(png, info, &mut cp, &mut tf, &mut mc, &mut vfr)\n841\t    ));\n842\t    // cLLI\n843\t    let (mut maxcll, mut maxfall) = (0u32, 0u32);\n844\t    log(format!(\n845\t        \"cLLI rc={} maxCLL={maxcll} maxFALL={maxfall}\",\n846\t        (c.get_cLLI_fixed)(png, info, &mut maxcll, &mut maxfall)\n847\t    ));\n848\t    // mDCV\n849\t    let mut mx = [0i32; 8];\n850\t    let mut ml = [0u32; 2];\n851\t    let r = (c.get_mDCV_fixed)(\n852\t        png, info, &mut mx[0], &mut mx[1], &mut mx[2], &mut mx[3], &mut mx[4], &mut mx[5],\n853\t        &mut mx[6], &mut mx[7], &mut ml[0], &mut ml[1],\n854\t    );\n855\t    log(format!(\"mDCV rc={r} {mx:?} {ml:?}\"));\n856\t    // text\n857\t    let mut tptr: *mut c_void = std::ptr::null_mut();\n858\t    let mut ntext: c_int = 0;\n859\t    let n = (c.get_text)(png, info, &mut tptr, &mut ntext);\n860\t    log(format!(\"text n={n} num={ntext}\"));\n861\t    if n > 0 && !tptr.is_null() {\n862\t        let arr = std::slice::from_raw_parts(tptr as *const PngText, n as usize);\n863\t        for (i, t) in arr.iter().enumerate() {\n864\t            log(format!(\n865\t                \"text[{i}] comp={} key={} text={} tlen={} ilen={} lang={} langkey={}\",\n866\t                t.compression,\n867\t                cstr(t.key),\n868\t                cstr(t.text),\n869\t                t.text_length,\n870\t                t.itxt_length,\n871\t                cstr(t.lang),\n872\t                cstr(t.lang_key)\n873\t            ));\n874\t        }\n875\t    }\n876\t    // unknown chunks\n877\t    let mut uptr: *mut c_void = std::ptr::null_mut();\n878\t    let n = (c.get_unknown_chunks)(png, info, &mut uptr);\n879\t    log(format!(\"unknown n={n}\"));\n880\t    if n > 0 && !uptr.is_null() {\n881\t        let arr = std::slice::from_raw_parts(uptr as *const PngUnknownChunk, n as usize);\n882\t        for (i, u) in arr.iter().enumerate() {\n883\t            let nm = String::from_utf8_lossy(&u.name[..4]).into_owned();\n884\t            log(format!(\n885\t                \"unknown[{i}] name={nm} size={} loc={} data={}\",\n886\t                u.size,\n887\t                u.location,\n888\t                if u.data.is_null() {\n889\t                    \"<null>\".to_string()\n890\t                } else {\n891\t                    hex(std::slice::from_raw_parts(u.data, u.size))\n892\t                }\n893\t            ));\n894\t        }\n895\t    }\n896\t    let _ = valid;\n897\t}\n898\t"}]},"parent_tool_use_id":"toolu_bdrk_011enmkBR3gAH2z6ofBWmEsy","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"a5bf2421-046e-42c7-8551-31d4e777af24","timestamp":"2026-08-14T17:11:23.323Z","subagent_type":"general-purpose","task_description":"Phase C write-side error tests"}
