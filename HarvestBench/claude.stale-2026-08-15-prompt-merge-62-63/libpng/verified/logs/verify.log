{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01J95RnCuxjtWKsgfuLgfzur","type":"tool_result","content":"1\t//! Translation of pngwtran.c - transforms the data in a row for PNG writers.\n2\t#![allow(unused_assignments)]\n3\tuse crate::prelude::*;\n4\t\n5\t/* Pack pixels into bytes.  Pass the true bit depth in bit_depth.  The\n6\t * row_info bit depth should be 8 (one pixel per byte).  The channels\n7\t * should be 1 (this only happens on grayscale and paletted images).\n8\t */\n9\tunsafe fn png_do_pack(row_info: png_row_infop, row: png_bytep, bit_depth: png_uint_32) {\n10\t    if (*row_info).bit_depth == 8 && (*row_info).channels == 1 {\n11\t        match bit_depth as c_int {\n12\t            1 => {\n13\t                let mut sp: png_bytep;\n14\t                let mut dp: png_bytep;\n15\t                let mut mask: c_int;\n16\t                let mut v: c_int;\n17\t                let row_width: png_uint_32 = (*row_info).width;\n18\t\n19\t                sp = row;\n20\t                dp = row;\n21\t                mask = 0x80;\n22\t                v = 0;\n23\t\n24\t                let mut i: png_uint_32 = 0;\n25\t                while i < row_width {\n26\t                    if *sp != 0 {\n27\t                        v |= mask;\n28\t                    }\n29\t\n30\t                    sp = sp.offset(1);\n31\t\n32\t                    if mask > 1 {\n33\t                        mask >>= 1;\n34\t                    } else {\n35\t                        mask = 0x80;\n36\t                        *dp = v as png_byte;\n37\t                        dp = dp.offset(1);\n38\t                        v = 0;\n39\t                    }\n40\t\n41\t                    i = i.wrapping_add(1);\n42\t                }\n43\t\n44\t                if mask != 0x80 {\n45\t                    *dp = v as png_byte;\n46\t                }\n47\t            }\n48\t\n49\t            2 => {\n50\t                let mut sp: png_bytep;\n51\t                let mut dp