WILL_FREE_DATA: c_int = 2;\n408\tpub const PNG_USER_WILL_FREE_DATA: c_int = 3;\n409\t\n410\tpub const PNG_TEXT_COMPRESSION_NONE: c_int = -1;\n411\tpub const PNG_TEXT_COMPRESSION_zTXt: c_int = 0;\n412\tpub const PNG_ITXT_COMPRESSION_NONE: c_int = 1;\n413\tpub const PNG_ITXT_COMPRESSION_zTXt: c_int = 2;\n414\t\n415\tpub const PNG_RESOLUTION_UNKNOWN: c_int = 0;\n416\tpub const PNG_RESOLUTION_METER: c_int = 1;\n417\tpub const PNG_OFFSET_PIXEL: c_int = 0;\n418\tpub const PNG_OFFSET_MICROMETER: c_int = 1;\n419\tpub const PNG_SCALE_UNKNOWN: c_int = 0;\n420\tpub const PNG_SCALE_METER: c_int = 1;\n421\tpub const PNG_SCALE_RADIAN: c_int = 2;\n422\t\n423\tpub const PNG_EQUATION_LINEAR: c_int = 0;\n424\tpub const PNG_EQUATION_BASE_E: c_int = 1;\n425\tpub const PNG_EQUATION_ARBITRARY: c_int = 2;\n426\tpub const PNG_EQUATION_HYPERBOLIC: c_int = 3;\n427\t\n428\tpub const PNG_sRGB_INTENT_PERCEPTUAL: c_int = 0;\n429\tpub const PNG_sRGB_INTENT_RELATIVE: c_int = 1;\n430\tpub const PNG_sRGB_INTENT_SATURATION: c_int = 2;\n431\tpub const PNG_sRGB_INTENT_ABSOLUTE: c_int = 3;\n432\t\n433\t/// `png_color` is 3 bytes; a palette is a flat `[u8]` of `3 * n`.\n434\tpub fn palette_bytes(entries: &[[u8; 3]]) -> Vec<u8> {\n435\t    entries.iter().flat_map(|e| e.iter().copied()).collect()\n436\t}\n437\t\n438\t/// `png_color_16 { png_byte index; png_uint_16 red, green, blue, gray; }`\n439\t#[repr(C)]\n440\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n441\tpub struct PngColor16 {\n442\t    pub index: u8,\n443\t    pub red: u16,\n444\t    pub green: u16,\n445\t    pub blue: u16,\n446\t    pub gray: u16,\n447\t}\n448\t\n449\t/// `png_color_8 { png_byte red, green, blue, gray, alpha; }`\n450\t#[repr(C)]\n451\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n452\tpub struct PngColor8 {\n453\t    pub red: u8,\n454\t    pub green: u8,\n455\t    pub blue: u8,\n456\t    pub gray: u8,\n457\t    pub alpha: u8,\n458\t}\n459\t\n460\t/// `png_time { png_uint_16 year; png_byte month, day, hour, minute, second; }`\n461\t#[repr(C)]\n462\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n463\tpub struct PngTime {\n464\t    pub year: u16,\n465\t    pub month: u8,\n466\t    pub day: u8,\n467\t    pub hour: u8,\n468\t    pub minute: u8,\n469\t    pub second: u8,\n470\t}\n471\t\n472\t/// `png_text`\n473\t#[repr(C)]\n474\t#[derive(Clone, Copy)]\n475\tpub struct PngText {\n476\t    pub compression: c_int,\n477\t    pub key: *mut c_char,\n478\t    pub text: *mut c_char,\n479\t    pub text_length: usize,\n480\t    pub itxt_length: usize,\n481\t    pub lang: *mut c_char,\n482\t    pub lang_key: *mut c_char,\n483\t}\n484\t\n485\timpl Default for PngText {\n486\t    fn default() -> Self {\n487\t        PngText {\n488\t            compression: PNG_TEXT_COMPRESSION_NONE,\n489\t            key: std::ptr::null_mut(),\n490\t            text: std::ptr::null_mut(),\n491\t            text_length: 0,\n492\t            itxt_length: 0,\n493\t            lang: std::ptr::null_mut(),\n494\t            lang_key: std::ptr::null_mut(),\n495\t        }\n496\t    }\n497\t}\n498\t\n499\t/// `png_unknown_chunk { png_byte name[5]; png_byte *data; size_t size; png_byte location; }`\n500\t#[repr(C)]\n501\t#[derive(Clone, Copy)]\n502\tpub struct PngUnknownChunk {\n503\t    pub name: [u8; 5],\n504\t    pub data: *mut u8,\n505\t    pub size: usize,\n506\t    pub location: u8,\n507\t}\n508\t\n509\t/// `png_sPLT_t { png_charp name; png_byte depth; png_sPLT_entryp entries; png_int_32 nentries; }`\n510\t#[repr(C)]\n511\t#[derive(Clone, Copy)]\n512\tpub struct PngSpltT {\n513\t    pub name: *mut c_char,\n514\t    pub depth: u8,\n515\t    pub entries: *mut PngSpltEntry,\n516\t    pub nentries: i32,\n517\t}\n518\t\n519\t/// `png_sPLT_entry { png_uint_16 red, green, blue, alpha, frequency; }`\n520\t#[repr(C)]\n521\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n522\tpub struct PngSpltEntry {\n523\t    pub red: u16,\n524\t    pub green: u16,\n525\t    pub blue: u16,\n526\t    pub alpha: u16,\n527\t    pub frequency: u16,\n528\t}\n529\t\n530\t// ---------------------------------------------------------------------------\n531\t// Simplified API\n532\t// ---------------------------------------------------------------------------\n533\t\n534\t/// `png_image` (png.h).  `opaque` must start as NULL and `version` as 1.\n535\t#[repr(C)]\n536\t#[derive(Clone, Copy)]\n537\tpub struct PngImage {\n538\t    pub opaque: *mut c_void,\n539\t    pub version: u32,\n540\t    pub width: u32,\n541\t    pub height: u32,\n542\t    pub format: u32,\n543\t    pub flags: u32,\n544\t    pub colormap_entries: u32,\n545\t    pub warning_or_error: u32,\n546\t    pub message: [c_char; 64],\n547\t}\n548\t\n549\timpl Default for PngImage {\n550\t    fn default() -> Self {\n551\t        PngImage {\n552\t            opaque: std::ptr::null_mut(),\n553\t            version: PNG_IMAGE_VERSION,\n554\t            width: 0,\n555\t            height: 0,\n556\t            format: 0,\n557\t            flags: 0,\n558\t            colormap_entries: 0,\n559\t            warning_or_error: 0,\n560\t            message: [0; 64],\n561\t        }\n562\t    }\n563\t}\n564\t\n565\timpl PngImage {\n566\t    pub fn msg(&self) -> String {\n567\t        let bytes: Vec<u8> = self\n568\t            .message\n569\t            .iter()\n570\t            .take_while(|c| **c != 0)\n571\t            .map(|c| *c as u8)\n572\t            .collect();\n573\t        String::from_utf8_lossy(&bytes).into_owned()\n574\t    }\n575\t}\n576\t\n577\tpub const PNG_IMAGE_VERSION: u32 = 1;\n578\tpub const PNG_IMAGE_WARNING: u32 = 1;\n579\tpub const PNG_IMAGE_ERROR: u32 = 2;\n580\t\n581\tpub const PNG_FORMAT_FLAG_ALPHA: u32 = 0x01;\n582\tpub const PNG_FORMAT_FLAG_COLOR: u32 = 0x02;\n583\tpub const PNG_FORMAT_FLAG_LINEAR: u32 = 0x04;\n584\tpub const PNG_FORMAT_FLAG_COLORMAP: u32 = 0x08;\n585\tpub const PNG_FORMAT_FLAG_BGR: u32 = 0x10;\n586\tpub const PNG_FORMAT_FLAG_AFIRST: u32 = 0x20;\n587\tpub const PNG_FORMAT_FLAG_ASSOCIATED_ALPHA: u32 = 0x40;\n588\t\n589\tpub const PNG_FORMAT_GRAY: u32 = 0;\n590\tpub const PNG_FORMAT_GA: u32 = PNG_FORMAT_FLAG_ALPHA;\n591\tpub const PNG_FORMAT_AG: u32 = PNG_FORMAT_GA | PNG_FORMAT_FLAG_AFIRST;\n592\tpub const PNG_FORMAT_RGB: u32 = PNG_FORMAT_FLAG_COLOR;\n593\tpub const PNG_FORMAT_BGR: u32 = PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_BGR;\n594\tpub const PNG_FORMAT_RGBA: u32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_ALPHA;\n595\tpub const PNG_FORMAT_ARGB: u32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_AFIRST;\n596\tpub const PNG_FORMAT_BGRA: u32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_ALPHA;\n597\tpub const PNG_FORMAT_ABGR: u32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_AFIRST;\n598\tpub const PNG_FORMAT_LINEAR_Y: u32 = PNG_FORMAT_FLAG_LINEAR;\n599\tpub const PNG_FORMAT_LINEAR_Y_ALPHA: u32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_ALPHA;\n600\tpub const PNG_FORMAT_LINEAR_RGB: u32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR;\n601\tpub const PNG_FORMAT_LINEAR_RGB_ALPHA: u32 =\n602\t    PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA;\n603\tpub const PNG_FORMAT_RGB_COLORMAP: u32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_COLORMAP;\n604\tpub const PNG_FORMAT_BGR_COLORMAP: u32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_COLORMAP;\n605\tpub const PNG_FORMAT_RGBA_COLORMAP: u32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_COLORMAP;\n606\tpub const PNG_FORMAT_ARGB_COLORMAP: u32 = PNG_FORMAT_ARGB | PNG_FORMAT_FLAG_COLORMAP;\n607\tpub const PNG_FORMAT_BGRA_COLORMAP: u32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_COLORMAP;\n608\tpub const PNG_FORMAT_ABGR_COLORMAP: u32 = PNG_FORMAT_ABGR | PNG_FORMAT_FLAG_COLORMAP;\n609\t\n610\t/// `png_row_info` — argument of the internal row transform functions.\n611\t#[repr(C)]\n612\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n613\tpub struct PngRowInfo {\n614\t    pub width: u32,\n615\t    pub rowbytes: usize,\n616\t    pub color_type: u8,\n617\t    pub bit_depth: u8,\n618\t    pub channels: u8,\n619\t    pub pixel_depth: u8,\n620\t}\n621\t"}]},"parent_tool_use_id":"toolu_bdrk_01466