{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CUU1VJ66avBvnWAWwAww5T","type":"tool_result","content":"1\t//! Translation of pngpread.c - read a png file in push (progressive) mode.\n2\tuse crate::prelude::*;\n3\t\n4\t/* Push model modes */\n5\tconst PNG_READ_SIG_MODE: c_int = 0;\n6\tconst PNG_READ_CHUNK_MODE: c_int = 1;\n7\tconst PNG_READ_IDAT_MODE: c_int = 2;\n8\t#[allow(dead_code)]\n9\tconst PNG_READ_tEXt_MODE: c_int = 4;\n10\t#[allow(dead_code)]\n11\tconst PNG_READ_zTXt_MODE: c_int = 5;\n12\tconst PNG_READ_DONE_MODE: c_int = 6;\n13\t#[allow(dead_code)]\n14\tconst PNG_READ_iTXt_MODE: c_int = 7;\n15\t#[allow(dead_code)]\n16\tconst PNG_ERROR_MODE: c_int = 8;\n17\t\n18\t/* Arrays to facilitate interlacing - use pass (0 - 6) as index. */\n19\t\n20\t/* Start of interlace block */\n21\tstatic png_pass_start: [png_byte; 7] = [0, 4, 0, 2, 0, 1, 0];\n22\t/* Offset to next interlace block */\n23\tstatic png_pass_inc: [png_byte; 7] = [8, 8, 4, 4, 2, 2, 1];\n24\t/* Start of interlace block in the y direction */\n25\tstatic png_pass_ystart: [png_byte; 7] = [0, 0, 4, 0, 2, 0, 1];\n26\t/* Offset to next interlace block in the y direction */\n27\tstatic png_pass_yinc: [png_byte; 7] = [8, 8, 8, 4, 4, 2, 2];\n28\t\n29\t#[unsafe(no_mangle)]\n30\tpub unsafe extern \"C\" fn png_process_data(\n31\t    png_ptr: png_structrp,\n32\t    info_ptr: png_inforp,\n33\t    buffer: png_bytep,\n34\t    buffer_size: size_t,\n35\t) {\n36\t    if png_ptr.is_null() || info_ptr.is_null() {\n37\t        return;\n38\t    }\n39\t\n40\t    png_push_restore_buffer(png_ptr, buffer, buffer_size);\n41\t\n42\t    while (*png_ptr).buffer_size != 0 {\n43\t        png_process_some_data(png_ptr, info_ptr);\n44\t    }\n45\t}\n46\t\n47\t#[unsafe(no_mangle)]\n48\tpub unsafe extern \"C\" fn png_process_data_pause(png_ptr: png_structrp, save: c_int) -> size_t {\n49\t    if !png_ptr.is_null() {\n50\t        /* It's easiest for the caller if we do the save; then the caller doesn't\n51\t         * have to supply the same data again:\n52\t         */\n53\t        if save != 0 {\n54\t            png_push_save_buffer(png_ptr);\n55\t        } else {\n56\t            /* This includes any pending saved bytes: */\n57\t            let remaining: size_t = (*png_ptr).buffer_size;\n58\t            (*png_ptr).buffer_size = 0;\n59\t\n60\t            /* So subtract the saved buffer size, unless all the data\n61\t             * is actually 'saved', in which case we just return 0\n62\t             */\n63\t            if (*png_ptr).save_buffer_size < remaining {\n64\t                return remaining - (*png_ptr).save_buffer_size;\n65\t            }\n66\t        }\n67\t    }\n68\t\n69\t    0\n70\t}\n71\t\n72\t#[unsafe(no_mangle)]\n73\tpub unsafe extern \"C\" fn png_process_data_skip(png_ptr: png_structrp) -> png_uint_32 {\n74\t    /* TODO: Deprecate and remove this API.\n75\t     * Somewhere the implementation of this seems to have been lost,\n76\t     * or abandoned.  It was only to support some internal back-door access\n77\t     * to png_struct) in libpng-1.4.x.\n78\t     */\n79\t    png_app_warning(\n80\t        png_ptr,\n81\t        c\"png_process_data_skip is not implemented in any current version of libpng\".as_ptr(),\n82\t    );\n83\t    0\n84\t}\n85\t\n86\t/* What we do with the incoming data depends on what we were previously\n87\t * doing before we ran out of data...\n88\t */\n89\t#[unsafe(no_mangle)]\n90\tpub unsafe extern \"C\" fn png_process_some_data(png_ptr: png_structrp, info_ptr: png_inforp) {\n91\t    if png_ptr.is_null() {\n92\t        return;\n93\t    }\n94\t\n95\t    match (*png_ptr).process_mode {\n96\t        PNG_READ_SIG_MODE => {\n97\t            png_push_read_sig(png_ptr, info_ptr);\n98\t        }\n99\t\n100\t        PNG_READ_CHUNK_MODE => {\n101\t            png_push_read_chunk(png_ptr, info_ptr);\n102\t        }\n103\t\n104\t        PNG_READ_IDAT_MODE => {\n105\t            png_push_read_IDAT(png_ptr);\n106\t        }\n107\t\n108\t        _ => {\n109\t            (*png_ptr).buffer_size = 0;\n110\t        }\n111\t    }\n112\t}\n113\t\n114\t/* Read any remaining signature bytes from the stream and compare them with\n115\t * the correct PNG signature.  It is possible that this routine is called\n116\t * with bytes already read from the signature, either because they have been\n117\t * checked by the calling application, or because of multiple calls to this\n118\t * routine.\n119\t */\n120\t#[unsafe(no_mangle)]\n121\tpub unsafe extern \"C\" fn png_push_read_sig(png_ptr: png_structrp, info_ptr: png_inforp) {\n122\t    let num_checked: size_t = (*png_ptr).sig_bytes as size_t; /* SAFE, does not exceed 8 */\n123\t    let mut num_to_check: size_t = 8 - num_checked;\n124\t\n125\t    if (*png_ptr).buffer_size < num_to_check {\n126\t        num_to_check = (*png_ptr).buffer_size;\n127\t    }\n128\t\n129\t    png_push_fill_buffer(\n130\t        png_ptr,"}]},"parent_tool_use_id":"toolu_bdrk_01AxwS3LQDAQG2Gmsh4CrGkB","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"1fa10bc2-b1db-47cb-a31e-b027275da57b","timestamp":"2026-08-14T15:47:32.846Z","subagent_type":"general-purpose","task_description":"Write progressive tests P1-P8"}
