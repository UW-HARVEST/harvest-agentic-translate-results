t_pCAL: unsafe extern \"C\" fn(Png, Info, *const c_char, i32, i32, c_int, c_int,\n264\t        *const c_char, *mut *mut c_char) = \"png_set_pCAL\",\n265\t    get_pCAL: unsafe extern \"C\" fn(Png, Info, *mut *mut c_char, *mut i32, *mut i32, *mut c_int,\n266\t        *mut c_int, *mut *mut c_char, *mut *mut *mut c_char) -> u32 = \"png_get_pCAL\",\n267\t    set_sCAL_s: unsafe extern \"C\" fn(Png, Info, c_int, *const c_char, *const c_char)\n268\t        = \"png_set_sCAL_s\",\n269\t    get_sCAL_s: unsafe extern \"C\" fn(Png, Info, *mut c_int, *mut *mut c_char, *mut *mut c_char)\n270\t        -> u32 = \"png_get_sCAL_s\",\n271\t    set_sCAL: unsafe extern \"C\" fn(Png, Info, c_int, f64, f64) = \"png_set_sCAL\",\n272\t    set_sCAL_fixed: unsafe extern \"C\" fn(Png, Info, c_int, i32, i32) = \"png_set_sCAL_fixed\",\n273\t    set_sPLT: unsafe extern \"C\" fn(Png, Info, *const c_void, c_int) = \"png_set_sPLT\",\n274\t    get_sPLT: unsafe extern \"C\" fn(Png, Info, *mut *mut c_void) -> u32 = \"png_get_sPLT\",\n275\t    set_eXIf_1: unsafe extern \"C\" fn(Png, Info, u32, *const u8) = \"png_set_eXIf_1\",\n276\t    get_eXIf_1: unsafe extern \"C\" fn(Png, Info, *mut u32, *mut *mut u8) -> u32 = \"png_get_eXIf_1\",\n277\t    set_cICP: unsafe extern \"C\" fn(Png, Info, u8, u8, u8, u8) = \"png_set_cICP\",\n278\t    get_cICP: unsafe extern \"C\" fn(Png, Info, *mut u8, *mut u8, *mut u8, *mut u8) -> u32\n279\t        = \"png_get_cICP\",\n280\t    set_cLLI_fixed: unsafe extern \"C\" fn(Png, Info, u32, u32) = \"png_set_cLLI_fixed\",\n281\t    get_cLLI_fixed: unsafe extern \"C\" fn(Png, Info, *mut u32, *mut u32) -> u32 = \"png_get_cLLI_fixed\",\n282\t    set_mDCV_fixed: unsafe extern \"C\" fn(Png, Info, u32, u32, u32, u32, u32, u32, u32, u32,\n283\t        u32, u32) -> () = \"png_set_mDCV_fixed\",\n284\t    get_mDCV_fixed: unsafe extern \"C\" fn(Png, Info, *mut u32, *mut u32, *mut u32, *mut u32,\n285\t        *mut u32, *mut u32, *mut u32, *mut u32, *mut u32, *mut u32) -> u32 = \"png_get_mDCV_fixed\",\n286\t\n287\t    // ---- misc ------------------------------------------------------------\n288\t    access_version_number: unsafe extern \"C\" fn() -> u32 = \"png_access_version_number\",\n289\t    get_copyright: unsafe extern \"C\" fn(Png) -> *const c_char = \"png_get_copyright\",\n290\t    get_libpng_ver: unsafe extern \"C\" fn(Png) -> *const c_char = \"png_get_libpng_ver\",\n291\t    get_header_ver: unsafe extern \"C\" fn(Png) -> *const c_char = \"png_get_header_ver\",\n292\t    get_header_version: unsafe extern \"C\" fn(Png) -> *const c_char = \"png_get_header_version\",\n293\t    convert_to_rfc1123_buffer: unsafe extern \"C\" fn(*mut c_char, *const u8) -> c_int\n294\t        = \"png_convert_to_rfc1123_buffer\",\n295\t    convert_from_time_t: unsafe extern \"C\" fn(*mut u8, i64) = \"png_convert_from_time_t\",\n296\t    build_grayscale_palette: unsafe extern \"C\" fn(c_int, *mut u8) = \"png_build_grayscale_palette\",\n297\t    reset_zstream: unsafe extern \"C\" fn(Png) -> c_int = \"png_reset_zstream\",\n298\t    info_init_3: unsafe extern \"C\" fn(*mut Info, usize) = \"png_info_init_3\",\n299\t    error: unsafe extern \"C\" fn(Png, *const c_char) = \"png_error\",\n300\t    warning: unsafe extern \"C\" fn(Png, *const c_char) = \"png_warning\",\n301\t    longjmp: unsafe extern \"C\" fn(Png, c_int) = \"png_longjmp\",\n302\t}\n303\t\n304\t// ---------------------------------------------------------------------------\n305\t// libpng constants used by the tests (from png.h).\n306\t// ---------------------------------------------------------------------------\n307\t\n308\tpub const PNG_COLOR_TYPE_GRAY: c_int = 0;\n309\tpub const PNG_COLOR_TYPE_RGB: c_int = 2;\n310\tpub const PNG_COLOR_TYPE_PALETTE: c_int = 3;\n311\tpub const PNG_COLOR_TYPE_GRAY_ALPHA: c_int = 4;\n312\tpub const PNG_COLOR_TYPE_RGB_ALPHA: c_int = 6;\n313\t\n314\tpub const PNG_INTERLACE_NONE: c_int = 0;\n315\tpub const PNG_INTERLACE_ADAM7: c_int = 1;\n316\t\n317\tpub const PNG_FILTER_TYPE_BASE: c_int = 0;\n318\tpub const PNG_INTRAPIXEL_DIFFERENCING: c_int = 64;\n319\tpub const PNG_COMPRESSION_TYPE_BASE: c_int = 0;\n320\t\n321\tpub const PNG_NO_FILTERS: c_int = 0x00;\n322\tpub const PNG_FILTER_NONE: c_int = 0x08;\n323\tpub const PNG_FILTER_SUB: c_int = 0x10;\n324\tpub const PNG_FILTER_UP: c_int = 0x20;\n325\tpub const PNG_FILTER_AVG: c_int = 0x40;\n326\tpub const PNG_FILTER_PAETH: c_int = 0x80;\n327\tpub const PNG_ALL_FILTERS: c_int = 0xF8;\n328\t\n329\tpub const PNG_INFO_gAMA: u32 = 0x0001;\n330\tpub const PNG_INFO_sBIT: u32 = 0x0002;\n331\tpub const PNG_INFO_cHRM: u32 = 0x0004;\n332\tpub const PNG_INFO_PLTE: u32 = 0x0008;\n333\tpub const PNG_INFO_tRNS: u32 = 0x0010;\n334\tpub const PNG_INFO_bKGD: u32 = 0x0020;\n335\tpub const PNG_INFO_hIST: u32 = 0x0040;\n336\tpub const PNG_INFO_pHYs: u32 = 0x0080;\n337\tpub const PNG_INFO_oFFs: u32 = 0x0100;\n338\tpub const PNG_INFO_tIME: u32 = 0x0200;\n339\tpub const PNG_INFO_pCAL: u32 = 0x0400;\n340\tpub const PNG_INFO_sRGB: u32 = 0x0800;\n341\tpub const PNG_INFO_iCCP: u32 = 0x1000;\n342\tpub const PNG_INFO_sPLT: u32 = 0x2000;\n343\tpub const PNG_INFO_sCAL: u32 = 0x4000;\n344\tpub const PNG_INFO_IDAT: u32 = 0x8000;\n345\tpub const PNG_INFO_eXIf: u32 = 0x10000;\n346\tpub const PNG_INFO_cICP: u32 = 0x40000;\n347\tpub const PNG_INFO_cLLI: u32 = 0x80000;\n348\tpub const PNG_INFO_mDCV: u32 = 0x100000;\n349\t\n350\tpub const PNG_TRANSFORM_IDENTITY: c_int = 0x0000;\n351\tpub const PNG_TRANSFORM_STRIP_16: c_int = 0x0001;\n352\tpub const PNG_TRANSFORM_STRIP_ALPHA: c_int = 0x0002;\n353\tpub const PNG_TRANSFORM_PACKING: c_int = 0x0004;\n354\tpub const PNG_TRANSFORM_PACKSWAP: c_int = 0x0008;\n355\tpub const PNG_TRANSFORM_EXPAND: c_int = 0x0010;\n356\tpub const PNG_TRANSFORM_INVERT_MONO: c_int = 0x0020;\n357\tpub const PNG_TRANSFORM_SHIFT: c_int = 0x0040;\n358\tpub const PNG_TRANSFORM_BGR: c_int = 0x0080;\n359\tpub const PNG_TRANSFORM_SWAP_ALPHA: c_int = 0x0100;\n360\tpub const PNG_TRANSFORM_SWAP_ENDIAN: c_int = 0x0200;\n361\tpub const PNG_TRANSFORM_INVERT_ALPHA: c_int = 0x0400;\n362\tpub const PNG_TRANSFORM_STRIP_FILLER: c_int = 0x0800;\n363\tpub const PNG_TRANSFORM_STRIP_FILLER_BEFORE: c_int = 0x0800;\n364\tpub const PNG_TRANSFORM_STRIP_FILLER_AFTER: c_int = 0x1000;\n365\tpub const PNG_TRANSFORM_GRAY_TO_RGB: c_int = 0x2000;\n366\tpub const PNG_TRANSFORM_EXPAND_16: c_int = 0x4000;\n367\tpub const PNG_TRANSFORM_SCALE_16: c_int = 0x8000;\n368\t\n369\tpub const PNG_FILLER_BEFORE: c_int = 0;\n370\tpub const PNG_FILLER_AFTER: c_int = 1;\n371\t\n372\tpub const PNG_BACKGROUND_GAMMA_UNKNOWN: c_int = 0;\n373\tpub const PNG_BACKGROUND_GAMMA_SCREEN: c_int = 1;\n374\tpub const PNG_BACKGROUND_GAMMA_FILE: c_int = 2;\n375\tpub const PNG_BACKGROUND_GAMMA_UNIQUE: c_int = 3;\n376\t\n377\tpub const PNG_ALPHA_PNG: c_int = 0;\n378\tpub const PNG_ALPHA_STANDARD: c_int = 1;\n379\tpub const PNG_ALPHA_ASSOCIATED: c_int = 1;\n380\tpub const PNG_ALPHA_OPTIMIZED: c_int = 2;\n381\tpub const PNG_ALPHA_BROKEN: c_int = 3;\n382\t\n383\tpub const PNG_ERROR_ACTION_NONE: c_int = 1;\n384\tpub const PNG_ERROR_ACTION_WARN: c_int = 2;\n385\tpub const PNG_ERROR_ACTION_ERROR: c_int = 3;\n386\t\n387\tpub const PNG_CRC_DEFAULT: c_int = 0;\n388\tpub const PNG_CRC_ERROR_QUIT: c_int = 1;\n389\tpub const PNG_CRC_WARN_DISCARD: c_int = 2;\n390\tpub const PNG_CRC_WARN_USE: c_int = 3;\n391\tpub const PNG_CRC_QUIET_USE: c_int = 4;\n392\tpub const PNG_CRC_NO_CHANGE: c_int = 5;\n393\t\n394\tpub const PNG_HANDLE_CHUNK_AS_DEFAULT: c_int = 0;\n395\tpub const PNG_HANDLE_CHUNK_NEVER: c_int = 1;\n396\tpub const PNG_HANDLE_CHUNK_IF_SAFE: c_int = 2;\n397\tpub const PNG_HANDLE_CHUNK_ALWAYS: c_int = 3;\n398\t\n399\tpub const PNG_FREE_ALL: u32 = 0x7FFF;\n400\tpub const PNG_FREE_TEXT: u32 = 0x0200;\n401\tpub const PNG_FREE_UNKN: u32 = 0x0800;\n402\tpub const PNG_FREE_PLTE: u32 = 0x1000;\n403\tpub const PNG_FREE_TRNS: u32 = 0x2000;\n404\tpub const PNG_FREE_ROWS: u32 = 0x0020;\n405\t\n406\tpub const PNG_DESTROY_WILL_FREE_DATA: c_int = 1;\n407\tpub const PNG_SET_WILL_FREE_DATA: c_int = 2;\n408\tpub const PNG_USER_WILL_FREE_DATA: c_int = 3;\n409\t\n410\tpub const PNG_TEXT_COMPRESSION_NONE: c_int = -1;\n411\tpub const PNG_TEXT_COMPRESSION_zTXt: c_int = 0;\n412\tpub const PNG_ITXT_COMPRESSION_NONE: c_int = 1;\n413\tpub const PNG_ITXT_COMPRESSION_zTXt: c_int = 2;\n414\t\n415\tpub const PNG_RESOLUTION_UNKNOWN: c_int = 0;\n416\tpub const PNG_RESOLUTION_METER: c_int = 1;\n417\tpub const PNG_OFFSET_PIXEL: c_int = 0;\n418\tpub const PNG_OFFSET_MICROMETER: c_int = 1;\n419\tpub const PNG_SCALE_UNKNOWN: c_int = 0;\n420\tpub const PNG_SCALE_METER: c_int = 1;\n421\tpub const PNG_SCALE_RADIAN: c_int = 2;\n422\t\n423\tpub const PNG_EQUATION_LINEAR: c_int = 0;\n424\tpub const PNG_EQUATION_BASE_E: c_int = 1;\n425\tpub const PNG_EQUATION_ARBITRARY: c_int = 2;\n426\tpub const PNG_EQUATION_HYPERBOLIC: c_int = 3;\n427\t\n428\tpub const PNG_sRGB_INTENT_PERCEPTUAL: c_int = 0;\n429\tpub const PNG_sRGB_INTENT_RELATIVE: c_int = 1;\n430\tpub const PNG_sRGB_INTENT_SATURATION: c_int = 2;\n431\tpub const PNG_sRGB_INTENT_ABSOLUTE: c_int = 3;\n432\t\n433\t/// `png_color` is 3 bytes; a palette is a flat `[u8]` of `3 * n`.\n434\tpub fn palette_bytes(entries: &[[u8; 3]]) -> Vec<u8> {\n435\t    entries.iter().flat_map(|e| e.iter().copied()).collect()\n436\t}\n437\t\n438\t/// `png_color_16 { png_byte index; png_uint_16 red, green, blue, gray; }`\n439\t#[repr(C)]\n440\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n441\tpub struct PngColor16 {\n442\t    pub index: u8,\n443\t    pub red: u16,\n444\t    pub green: u16,\n445\t    pub blue: u16,\n446\t    pub gray: u16,\n447\t}\n448\t\n449\t/// `png_color_8 { png_byte red, green, blue, gray, alpha; }`\n450\t#[repr(C)]\n451\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n452\tpub struct PngColor8 {\n453\t    pub red: u8,\n454\t    pub green: u8,\n455\t    pub blue: u8,\n456\t    pub gray: u8,\n457\t    pub alpha: u8,\n458\t}\n459\t\n460\t/// `png_time { png_uint_16 year; png_byte month, day, hour, minute, second; }`\n461\t#[repr(C)]\n462\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n463\tpub struct PngTime {\n464\t    pub year: u16,\n465\t    pub month: u8,\n466\t    pub day: u8,\n467\t    pub hour: u8,\n468\t    pub minute: u8,\n469\t    pub second: u8,\n470\t}\n471\t\n472\t/// `png_text`\n473\t#[repr(C)]\n474\t#[derive(Clone, Copy)]\n475\tpub struct PngText {\n476\t    pub compression: c_int,\n477\t    pub key: *mut c_char,\n478\t    pub text: *mut c_char,\n479\t    pub text_length: usize,\n480\t    pub itxt_length: usize,\n481\t    pub lang: *mut c_char,\n482\t    pub lang_key: *mut c_char,\n483\t}\n484\t\n485\timpl Default for PngText {\n486\t    fn default() -> Self {\n487\t        PngText {\n488\t            compression: PNG_TEXT_COMPRESSION_NONE,\n489\t            key: std::ptr::null_mut(),\n490\t            text: std::ptr::null_mut(),\n491\t            text_length: 0,\n492\t            itxt_length: 0,\n493\t            lang: std::ptr::null_mut(),\n494\t            lang_key: std::ptr::null_mut(),\n495\t        }\n496\t    }\n497\t}\n498\t\n499\t/// `png_unknown_chunk { png_byte name[5]; png_byte *data; size_t size; png_byte location; }`\n500\t#[repr(C)]\n501\t#[derive(Clone, Copy)]\n502\tpub struct PngUnknownChunk {\n503\t    pub name: [u8; 5],\n504\t    pub data: *mut u8,\n505\t    pub size: usize,\n506\t    pub location: u8,\n507\t}\n508\t\n509\t/// `png_sPLT_t { png_charp name; png_byte depth; png_sPLT_entryp entries; png_int_32 nentries; }`\n510\t#[repr(C)]\n511\t#[derive(Clone, Copy)]\n512\tpub struct PngSpltT {\n513\t    pub name: *mut c_char,\n514\t    pub depth: u8,\n515\t    pub entries: *mut PngSpltEntry,\n516\t    pub nentries: i32,\n517\t}\n518\t\n519\t/// `png_sPLT_entry { png_uint_16 red, green, blue, alpha, frequency; }`\n520\t#[repr(C)]\n521\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n522\tpub struct PngSpltEntry {\n523\t    pub red: u16,\n524\t    pub green: u16,\n525\t    pub blue: u16,\n526\t    pub alpha: u16,\n527\t    pub frequency: u16,\n528\t}\n529\t\n530\t// ---------------------------------------------------------------------------\n531\t// Simplified API\n532\t// ---------------------------------------------------------------------------\n533\t\n534\t/// `png_image` (png.h).  `opaque` must start as NULL and `version` as 1.\n535\t#[repr(C)]\n536\t#[derive(Clone, Copy)]\n537\tpub struct PngImage {\n538\t    pub opaque: *mut c_void,\n539\t    pub version: u32,\n540\t    pub width: u32,\n541\t    pub height: u32,\n542\t    pub format: u32,\n543\t    pub flags: u32,\n544\t    pub colormap_entries: u32,\n545\t    pub warning_or_error: u32,\n546\t    pub message: [c_char; 64],\n547\t}\n548\t\n549\timpl Default for PngImage {\n550\t    fn default() -> Self {\n551\t        PngImage {\n552\t            opaque: std::ptr::null_mut(),\n553\t            version: PNG_IMAGE_VERSION,\n554\t            width: 0,\n555\t            height: 0,\n556\t            format: 0,\n557\t            flags: 0,\n558\t            colormap_entries: 0,\n559\t            warning_or_error: 0,\n560\t            message: [0; 64],\n561\t        }\n562\t    }\n563\t}\n564\t\n565\timpl PngImage {\n566\t    pub fn msg(&self) -> String {\n567\t        let bytes: Vec<u8> = self\n568\t            .message\n569\t            .iter()\n570\t            .take_while(|c| **c != 0)\n571\t            .map(|c| *c as u8)\n572\t            .collect();\n573\t        String::from_utf8_lossy(&bytes).into_owned()\n574\t    }\n575\t}\n576\t\n577\tpub const PNG_IMAGE_VERSION: u32 = 1;\n578\tpub const PNG_IMAGE_WARNING: u32 = 1;\n579\tpub const PNG_IMAGE_ERROR: u32 = 2;\n580\t\n581\tpub const PNG_FORMAT_FLAG_ALPHA: u32 = 0x01;\n582\tpub const PNG_FORMAT_FLAG_COLOR: u32 = 0x02;\n583\tpub const PNG_FORMAT_FLAG_LINEAR: u32 = 0x04;\n584\tpub const PNG_FORMAT_FLAG_COLORMAP: u32 = 0x08;\n585\tpub const PNG_FORMAT_FLAG_BGR: u32 = 0x10;\n586\tpub const PNG_FORMAT_FLAG_AFIRST: u32 = 0x20;\n587\tpub const PNG_FORMAT_FLAG_ASSOCIATED_ALPHA: u32 = 0x40;\n588\t\n589\tpub const PNG_FORMAT_GRAY: u32 = 0;\n590\tpub const PNG_FORMAT_GA: u32 = PNG_FORMAT_FLAG_ALPHA;\n591\tpub const PNG_FORMAT_AG: u32 = PNG_FORMAT_GA | PNG_FORMAT_FLAG_AFIRST;\n592\tpub const PNG_FORMAT_RGB: u32 = PNG_FORMAT_FLAG_COLOR;\n593\tpub const PNG_FORMAT_BGR: u32 = PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_BGR;\n594\tpub const PNG_FORMAT_RGBA: u32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_ALPHA;\n595\tpub const PNG_FORMAT_ARGB: u32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_AFIRST;\n596\tpub const PNG_FORMAT_BGRA: u32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_ALPHA;\n597\tpub const PNG_FORMAT_ABGR: u32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_AFIRST;\n598\tpub const PNG_FORMAT_LINEAR_Y: u32 = PNG_FORMAT_FLAG_LINEAR;\n599\tpub const PNG_FORMAT_LINEAR_Y_ALPHA: u32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_ALPHA;\n600\tpub const PNG_FORMAT_LINEAR_RGB: u32 = PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR;\n601\tpub const PNG_FORMAT_LINEAR_RGB_ALPHA: u32 =\n602\t    PNG_FORMAT_FLAG_LINEAR | PNG_FORMAT_FLAG_COLOR | PNG_FORMAT_FLAG_ALPHA;\n603\tpub const PNG_FORMAT_RGB_COLORMAP: u32 = PNG_FORMAT_RGB | PNG_FORMAT_FLAG_COLORMAP;\n604\tpub const PNG_FORMAT_BGR_COLORMAP: u32 = PNG_FORMAT_BGR | PNG_FORMAT_FLAG_COLORMAP;\n605\tpub const PNG_FORMAT_RGBA_COLORMAP: u32 = PNG_FORMAT_RGBA | PNG_FORMAT_FLAG_COLORMAP;\n606\tpub const PNG_FORMAT_ARGB_COLORMAP: u32 = PNG_FORMAT_ARGB | PNG_FORMAT_FLAG_COLORMAP;\n607\tpub const PNG_FORMAT_BGRA_COLORMAP: u32 = PNG_FORMAT_BGRA | PNG_FORMAT_FLAG_COLORMAP;\n608\tpub const PNG_FORMAT_ABGR_COLORMAP: u32 = PNG_FORMAT_ABGR | PNG_FORMAT_FLAG_COLORMAP;\n609\t\n610\t/// `png_row_info` — argument of the internal row transform functions.\n611\t#[repr(C)]\n612\t#[derive(Default, Clone, Copy, Debug, PartialEq)]\n613\tpub struct PngRowInfo {\n614\t    pub width: u32,\n615\t    pub rowbytes: usize,\n616\t    pub color_type: u8,\n617\t    pub bit_depth: u8,\n618\t    pub channels: u8,\n619\t    pub pixel_depth: u8,\n620\t}\n621\t"}]},"parent_tool_use_id":"toolu_bdrk_01XGJ