{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01T1BKqTurd2XMqvZTNShMAa","type":"tool_result","content":"1\t//! Read-side rejection (\"error surface\") differential tests.\n2\t//!\n3\t//! Every individual malformed datastream is driven through the C `.so` and the\n4\t//! Rust `.so` in its own `diff(...)` run, so a fatal error on one input can\n5\t//! never mask a later input.  The complete trace (messages, warning-vs-fatal\n6\t//! behaviour, longjmp `rc`, partially decoded info state, decoded rows) is\n7\t//! compared byte for byte.\n8\t//!\n9\t//! Triggers were derived from the guarding conditions in `c_src/src/pngrutil.c`,\n10\t//! `pngread.c`, `pngpread.c` and `pngrio.c`; the corresponding source line is\n11\t//! given in a comment for each family.\n12\tmod support;\n13\t\n14\tuse std::cell::Cell;\n15\tuse std::ffi::{c_char, c_int, c_void};\n16\tuse support::core::*;\n17\tuse support::pngbuild::{join, split, zlib_stored, Builder, Chunk};\n18\tuse support::*;\n19\t\n20\t// ---------------------------------------------------------------------------\n21\t// input construction helpers\n22\t// ---------------------------------------------------------------------------\n23\t\n24\tconst STRIDE: usize = 1024;\n25\tconst MAXH: usize = 24;\n26\t\n27\tfn ck(name: &[u8; 4], data: Vec<u8>) -> Chunk {\n28\t    Chunk::new(name, data)\n29\t}\n30\t\n31\tfn g(n: usize, seed: u64) -> Vec<u8> {\n32\t    Rng::new(seed).bytes(n)\n33\t}\n34\t\n35\tfn ihdr(w: u32, h: u32, bd: u8, ct: u8, il: u8) -> Chunk {\n36\t    ck(b\"IHDR\", Builder::new(w, h, bd, ct).interlace(il).ihdr_bytes())\n37\t}\n38\t\n39\tfn rawrows(w: u32, h: u32, bd: u8, ct: u8, il: u8) -> Vec<u8> {\n40\t    Builder::new(w, h, bd, ct).interlace(il).raw_rows(0x1234)\n41\t}\n42\t\n43\tfn idat(w: u32, h: u32, bd: u8, ct: u8, il: u8) -> Chunk {\n44\t    ck(b\"IDAT\", zlib_stored(&rawrows(w, h, bd, ct, il)))\n45\t}\n46\t\n47\tfn iend() -> Chunk {\n48\t    ck(b\"IEND\", Vec::new())\n49\t}\n50\t\n51\tfn plte(n: usize) -> Chunk {\n52\t    ck(b\"PLTE\", g(3 * n, 0x5eed_1111))\n53\t}\n54\t\n55\t/// 4x2 grey 8-bit stream with `extra` inserted in front of IDAT.\n56\tfn grey(extra: &[Chunk]) -> Vec<u8> {\n57\t    let mut v = vec![ihdr(4, 2, 8, 0, 0)];\n58\t    v.extend(extra.iter().cloned());\n59\t    v.push(idat(4, 2, 8, 0, 0));\n60\t    v.push(iend());\n61\t    join(&v)\n62\t}\n63\t\n64\t/// 4x2 palette 8-bit stream (256 entry PLTE) with `extra` after the PLTE.\n65\tfn palimg(extra: &[Chunk]) -> Vec<u8> {\n66\t    let mut v = vec![ihdr(4, 2, 8, 3, 0), plte(256)];\n67\t    v.extend(extra.iter().cloned());\n68\t    v.push(idat(4, 2, 8, 3, 0));\n69\t    v.push(iend());\n70\t    join(&v)\n71\t}\n72\t\n73\t/// 4x2 stream of colour type `ct`, bit depth `bd`, `extra` before IDAT.\n74\tfn img(ct: u8, bd: u8, extra: &[Chunk]) -> Vec<u8> {\n75\t    let mut v = vec![ihdr(4, 2, bd, ct, 0)];\n76\t    if ct == 3 {\n77\t        v.push(plte(1usize << bd.min(8)));\n78\t    }\n79\t    v.extend(extra.iter().cloned());\n80\t    v.push(idat(4, 2, bd, ct, 0));\n81\t    v.push(iend());\n82\t    join(&v)\n83\t}\n84\t\n85\t// ---------------------------------------------------------------------------\n86\t// drivers\n87\t// ---------------------------------------------------------------------------\n88\t\n89\tfn noset(_c: &Core, _p: Png, _i: Info) {}\n90\t\n91\tfn benign_on(c: &Core, p: Png, _i: Info) {\n92\t    unsafe { (c.set_benign_errors)(p, 1) }\n93\t}\n94\t\n95\tfn benign_off(c: &Core, p: Png, _i: Info) {\n96\t    unsafe { (c.set_benign_errors)(p, 0) }\n97\t}\n98\t\n99\t/// mode 0: `png_read_info` only.  1: full read (rows + end).  2: info + end.\n100\tunsafe fn seq_body(c: &Core, p: Png, i: Info, mode: u8, bp: *mut u8) {\n101\t    (c.read_info)(p, i);\n102\t    log_all_info(c, p, i);\n103\t    if mode == 0 {\n104\t        return;\n105\t    }\n106\t    let h = (c.get_image_height)(p, i) as usize;\n107\t    let passes = (c.set_interlace_handling)(p);\n108\t    (c.read_update_info)(p, i);\n109\t    let rb = (c.get_rowbytes)(p, i);\n110\t    log(format!(\"rb={rb} passes={passes} h={h}\"));\n111\t    if mode == 1 {\n112\t        if rb + 8 <= STRIDE && h <= MAXH && h > 0 {\n113\t            for pass in 0..passes {\n114\t                for y in 0..h {\n115\t                    let rp = bp.add(y * STRIDE);\n116\t                    (c.read_row)(p, rp, std::ptr::null_mut());\n117\t                    log(format!(\n118\t                        \"p{pass}r{y}={}\",\n119\t                        hex(std::slice::from_raw_parts(rp, rb))\n120\t                    ));\n121\t                }\n122\t            }\n123\t        } else {\n124\t            log(\"SKIP_ROWS\".to_string());\n125\t        }\n126\t    }\n127\t    (c.read_end)(p, i);\n128\t    log(\"after_end\".to_string());\n129\t    log_all_info(c, p, i);\n130\t}\n131\t\n132\tfn drive(label: &str, png: &[u8], mode: u8, pre: &dyn Fn(&Core, Png, Info)) {\n133\t    let mut buf = vec![0u8; MAXH * STRIDE];\n134\t    let bp = buf.as_mut_ptr();\n135\t    diff(label, |lib| {\n136\t        with_read(lib, png, &mut |c, p, i| unsafe {\n137\t            std::ptr::write_bytes(bp, 0, MAXH * STRIDE);\n138\t            pre(c, p, i);\n139\t            seq_body(c, p, i, mode, bp);\n140\t        })\n141\t    });\n142\t}\n143\t\n144\t/// Same input run with `png_set_benign_errors(0)` and `(1)`.\n145\tfn drive_both(label: &str, png: &[u8], mode: u8) {\n146\t    drive(&format!(\"{label} benign=0\"), png, mode, &benign_off);\n147\t    drive(&format!(\"{label} benign=1\"), png, mode, &benign_on);\n148\t    drive(&format!(\"{label} benign=default\"), png, mode, &noset);\n149\t}\n150\t\n151\t// --- failing allocator ------------------------------------------------------\n152\t\n153\textern \"C\" {\n154\t    #[link_name = \"calloc\"]\n155\t    fn c_calloc(n: usize, size: usize) -> *mut c_void;\n156\t    #[link_name = \"free\"]\n157\t    fn c_free(p: *mut c_void);\n158\t}\n159\t\n160\tthread_local! {\n161\t    static FAIL_SIZE: Cell<usize> = const { Cell::new(usize::MAX) };\n162\t}\n163\t\n164\tfn set_fail(n: usize) {\n165\t    FAIL_SIZE.with(|f| f.set(n));\n166\t}\n167\t\n168\tunsafe extern \"C\" fn m_alloc(_p: *mut c_void, size: usize) -> *mut c_void {\n169\t    if size == FAIL_SIZE.with(|f| f.get()) {\n170\t        log(format!(\"MALLOC_FAIL({size})\"));\n171\t        return std::ptr::null_mut();\n172\t    }\n173\t    unsafe { c_calloc(1, if size == 0 { 1 } else { size }) }\n174\t}\n175\t\n176\tunsafe extern \"C\" fn m_free(_p: *mut c_void, q: *mut c_void) {\n177\t    if !q.is_null() {\n178\t        unsafe { c_free(q) }\n179\t    }\n180\t}\n181\t\n182\t/// Sequential read through a struct with a user allocator that fails every\n183\t/// allocation of exactly `fail` bytes.\n184\tfn drive_mem(label: &str, png: &[u8], fail: usize, mode: u8, pre: &dyn Fn(&Core, Png, Info)) {\n185\t    let mut buf = vec![0u8; MAXH * STRIDE];\n186\t    let bp = buf.as_mut_ptr();\n187\t    diff(label, |lib| {\n188\t        session_reset(png.to_vec());\n189\t        set_fail(fail);\n190\t        let c = Core::new(lib);\n191\t        let rc = protected(|| unsafe {\n192\t            std::ptr::write_bytes(bp, 0, MAXH * STRIDE);\n193\t            let p = (c.create_read_2)(\n194\t                VER_STRING.as_ptr() as *const c_char,\n195\t                std::ptr::null_mut(),\n196\t                cb_error as Cb,\n197\t                cb_warning as Cb,\n198\t                std::ptr::null_mut(),\n199\t                m_alloc as Cb,\n200\t                m_free as Cb,\n201\t            );\n202\t            log(format!(\"create={}\", (!p.is_null()) as u8));\n203\t            if p.is_null() {\n204\t                return;\n205\t            }\n206\t            (c.set_longjmp)(p, shim().longjmp_ptr, shim().jmp_buf_size);\n207\t            (c.set_read_fn)(p, std::ptr::null_mut(), cb_read as Cb);\n208\t            let i = (c.create_info)(p);\n209\t            pre(&c, p, i);\n210\t            seq_body(&c, p, i, mode, bp);\n211\t            let mut pp = p;\n212\t            let mut ii = i;\n213\t            (c.destroy_read)(&mut pp, &mut ii, std::ptr::null_mut());\n214\t            log(\"destroyed\".to_string());\n215\t        });\n216\t        set_fail(usize::MAX);\n217\t        Trace {\n218\t            lines: take_log(),\n219\t            out: take_out(),\n220\t            rc,\n221\t        }\n222\t    });\n223\t}\n224\t\n225\t// --- progressive ------------------------------------------------------------\n226\t\n227\t// P_UPDATE holds png_read_update_info of the library currently under test: a\n228\t// progressive reader has to call it from the info callback, otherwise\n229\t// png_read_start_row never runs (num_rows / row_buf stay unset).\n230\tthread_local! {\n231\t    static P_UPDATE: Cell<usize> = const { Cell::new(0) };\n232\t    static P_COMBINE: Cell<usize> = const { Cell::new(0) };\n233\t    static P_ROWBUF: Cell<usize> = const { Cell::new(0) };\n234\t    /// bit 0: call png_read_update_info from info_fn\n235\t    /// bit 1: call png_progressive_combine_row from row_fn\n236\t    /// bit 2: call png_progressive_combine_row from info_fn (before any row)\n237\t    static P_MODE: Cell<u8> = const { Cell::new(0) };\n238\t}\n239\t\n240\tunsafe extern \"C\" fn p_info(png: *mut c_void, info: *mut c_void) {\n241\t    log(\"PROG_INFO\".to_string());\n242\t    let m = P_MODE.with(|c| c.get());\n243\t    if m & 1 != 0 {\n244\t        let f: unsafe extern \"C\" fn(*mut c_void, *mut c_void) =\n245\t            std::mem::transmute(P_UPDATE.with(|c| c.get()));\n246\t        f(png, info);\n247\t        log(\"PROG_UPDATE_INFO\".to_string());\n248\t    }\n249\t    if m & 4 != 0 {\n250\t        // new_row is only a flag for png_progressive_combine_row; a non-NULL\n251\t        // value makes it call png_combine_row, which is what this exercises.\n252\t        let f: unsafe extern \"C\" fn(*mut c_void, *mut u8, *const u8) =\n253\t            std::mem::transmute(P_COMBINE.with(|c| c.get()));\n254\t        let bp = P_ROWBUF.with(|c| c.get()) as *mut u8;\n255\t        f(png, bp, bp as *const u8);\n256\t        log(\"PROG_COMBINE_EARLY\".to_string());\n257\t    }\n258\t}\n259\t\n260\tunsafe extern \"C\" fn p_row(png: *mut c_void, row: *mut u8, n: u32, pass: c_int) {\n261\t    log(format!(\n262\t        \"PROG_ROW n={n} pass={pass} null={}\",\n263\t        row.is_null() as u8\n264\t    ));\n265\t    let m = P_MODE.with(|c| c.get());\n266\t    if m & 2 != 0 && !row.is_null() {\n267\t        let bp = P_ROWBUF.with(|c| c.get()) as *mut u8;\n268\t        if !bp.is_null() && (n as usize) < MAXH {\n269\t            let f: unsafe extern \"C\" fn(*mut c_void, *mut u8, *const u8) =\n270\t                std::mem::transmute(P_COMBINE.with(|c| c.get()));\n271\t            let dst = bp.add(n as usize * STRIDE);\n272\t            f(png, dst, row);\n273\t            log(format!(\n274\t                \"PROG_COMBINE n={n} {}\",\n275\t                hex(std::slice::from_raw_parts(dst, 16))\n276\t            ));\n277\t        }\n278\t    }\n279\t}\n280\t\n281\tunsafe extern \"C\" fn p_end(_png: *mut c_void, _info: *mut c_void) {\n282\t    log(\"PROG_END\".to_string());\n283\t}\n284\t\n285\t/// Feed `png` to the progressive reader in `step`-byte pieces.  `fail` is the\n286\t/// allocation size the user allocator refuses (`usize::MAX` = never).  `mode`\n287\t/// selects what the callbacks do (see `P_MODE`).\n288\tfn prog_m(\n289\t    label: &str,\n290\t    png: &[u8],\n291\t    step: usize,\n292\t    fail: usize,\n293\t    mode: u8,\n294\t    pre: &dyn Fn(&Core, Png, Info),\n295\t) {\n296\t    let mut buf = vec![0u8; MAXH * STRIDE];\n297\t    let bp = buf.as_mut_ptr() as usize;\n298\t    let mut data = png.to_vec();\n299\t    let dp = data.as_mut_ptr();\n300\t    let len = data.len();\n301\t    diff(label, |lib| {\n302\t        session_reset(Vec::new());\n303\t        set_fail(fail);\n304\t        let c = Core::new(lib);\n305\t        P_UPDATE.with(|x| x.set(lib.raw(\"png_read_update_info\") as usize));\n306\t        P_COMBINE.with(|x| x.set(lib.raw(\"png_progressive_combine_row\") as usize));\n307\t        P_ROWBUF.with(|x| x.set(bp));\n308\t        P_MODE.with(|x| x.set(mode));\n309\t        let rc = protected(|| unsafe {\n310\t            std::ptr::write_bytes(bp as *mut u8, 0, MAXH * STRIDE);\n311\t            let p = (c.create_read_2)(\n312\t                VER_STRING.as_ptr() as *const c_char,\n313\t                std::ptr::null_mut(),\n314\t                cb_error as Cb,\n315\t                cb_warning as Cb,\n316\t                std::ptr::null_mut(),\n317\t                m_alloc as Cb,\n318\t                m_free as Cb,\n319\t            );\n320\t            log(format!(\"create={}\", (!p.is_null()) as u8));\n321\t            if p.is_null() {\n322\t                return;\n323\t            }\n324\t            (c.set_longjmp)(p, shim().longjmp_ptr, shim().jmp_buf_size);\n325\t            let i = (c.create_info)(p);\n326\t            (c.set_progressive_read_fn)(\n327\t                p,\n328\t                std::ptr::null_mut(),\n329\t                p_info as Cb,\n330\t                p_row as Cb,"}]},"parent_tool_use_id":"toolu_bdrk_01PPjifSwBpeNzA2vFizQEEM","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"f242af93-2f79-47f5-8586-26c4b4c674b0","timestamp":"2026-08-14T17:12:13.684Z","subagent_type":"general-purpose","task_description":"Phase C API/state error tests"}
