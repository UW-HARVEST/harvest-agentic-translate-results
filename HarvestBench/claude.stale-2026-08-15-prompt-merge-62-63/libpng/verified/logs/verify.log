{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0143Ukon8jCq8PR6gUF21y2j","type":"tool_result","content":"1\t//! Self-contained PNG stream construction / dissection, independent of both\n2\t//! libraries under test.  Used to feed byte-identical (valid or deliberately\n3\t//! malformed) inputs to the C and the Rust decoder.\n4\t#![allow(dead_code)]\n5\t\n6\tpub const SIG: [u8; 8] = [0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a];\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// checksums\n10\t// ---------------------------------------------------------------------------\n11\t\n12\tpub fn crc32(data: &[u8]) -> u32 {\n13\t    let mut table = [0u32; 256];\n14\t    for (n, e) in table.iter_mut().enumerate() {\n15\t        let mut c = n as u32;\n16\t        for _ in 0..8 {\n17\t            c = if c & 1 != 0 { 0xEDB8_8320 ^ (c >> 1) } else { c >> 1 };\n18\t        }\n19\t        *e = c;\n20\t    }\n21\t    let mut c = 0xFFFF_FFFFu32;\n22\t    for b in data {\n23\t        c = table[((c ^ *b as u32) & 0xFF) as usize] ^ (c >> 8);\n24\t    }\n25\t    c ^ 0xFFFF_FFFF\n26\t}\n27\t\n28\tpub fn adler32(data: &[u8]) -> u32 {\n29\t    let mut a = 1u32;\n30\t    let mut b = 0u32;\n31\t    for x in data {\n32\t        a = (a + *x as u32) % 65521;\n33\t        b = (b + a) % 65521;\n34\t    }\n35\t    (b << 16) | a\n36\t}\n37\t\n38\t// ---------------------------------------------------------------------------\n39\t// zlib stream with stored (uncompressed) deflate blocks\n40\t// ---------------------------------------------------------------------------\n41\t\n42\t/// A valid zlib stream carrying `data` in stored deflate blocks.\n43\tpub fn zlib_stored(data: &[u8]) -> Vec<u8> {\n44\t    let mut out = vec![0x78, 0x01]; // CM=8, CINFO=7, FCHECK making 0x7801 % 31 == 0\n45\t    if data.is_empty() {\n46\t        out.extend_from_slice(&[0x01, 0x00, 0x00, 0xff, 0xff]);\n47\t    } else {\n48\t        let mut off = 0usize;\n49\t        while off < data.len() {\n50\t            let n = std::cmp::min(65535, data.len() - off);\n51\t            let last = off + n >= data.len();\n52\t            out.push(if last { 1 } else { 0 });\n53\t            out.extend_from_slice(&(n as u16).to_le_bytes());\n54\t            out.extend_from_slice(&(!(n as u16)).to_le_bytes());\n55\t            out.extend_from_slice(&data[off..off + n]);\n56\t            off += n;\n57\t        }\n58\t    }\n59\t    out.extend_from_slice(&adler32(data).to_be_bytes());\n60\t    out\n61\t}\n62\t\n63\t// ---------------------------------------------------------------------------\n64\t// chunks\n65\t// ---------------------------------------------------------------------------\n66\t\n67\t#[derive(Clone, Debug, PartialEq)]\n68\tpub struct Chunk {\n69\t    pub name: [u8; 4],\n70\t    pub data: Vec<u8>,\n71\t    /// When `Some`, this CRC is emitted verbatim instead of the correct one.\n72\t    pub crc_override: Option<u32>,\n73\t    /// When `Some`, this length is emitted verbatim instead of `data.len()`.\n74\t    pub len_override: Option<u32>,\n75\t}\n76\t\n77\timpl Chunk {\n78\t    pub fn new(name: &[u8; 4], data: Vec<u8>) -> Chunk {\n79\t        Chunk {\n80\t            name: *name,\n81\t            data,\n82\t            crc_override: None,\n83\t            len_override: None,\n84\t        }\n85\t    }\n86\t    pub fn bad_crc(mut self) -> Chunk {\n87\t        let good = self.crc();\n88\t        self.crc_override = Some(good ^ 0xFFFF_FFFF);\n89\t        self\n90\t    }\n91\t    pub fn with_crc(mut self, crc: u32) -> Chunk {\n92\t        self.crc_override = Some(crc);\n93\t        self\n94\t    }\n95\t    pub fn with_len(mut self, len: u32) -> Chunk {\n96\t        self.len_override = Some(len);\n97\t        self\n98\t    }\n99\t    pub fn crc(&self) -> u32 {\n100\t        let mut buf = Vec::with_capacity(4 + self.data.len());\n101\t        buf.extend_from_slice(&self.name);\n102\t        buf.extend_from_slice(&self.data);\n103\t        crc32(&buf)\n104\t    }\n105\t    pub fn encode(&self) -> Vec<u8> {\n106\t        let mut out = Vec::with_capacity(12 + self.data.len());\n107\t        out.extend_from_slice(&self.len_override.unwrap_or(self.data.len() as u32).to_be_bytes());\n108\t        out.extend_from_slice(&self.name);\n109\t        out.extend_from_slice(&self.data);\n110\t        out.extend_from_slice(&self.crc_override.unwrap_or_else(|| self.crc()).to_be_bytes());\n111\t        out\n112\t    }\n113\t}\n114\t\n115\t/// Split a complete PNG datastream into its signature and chunk list.\n116\tpub fn split(png: &[u8]) -> Vec<Chunk> {\n117\t    let mut out = Vec::new();\n118\t    let mut i = 8; // skip signature\n119\t    while i + 8 <= png.len() {\n120\t        let len = u32::from_be_bytes([png[i], png[i + 1], png[i + 2], png[i + 3]]) as usize;\n121\t        let name = [png[i + 4], png[i + 5], png[i + 6], png[i + 7]];\n122\t        let ds = i + 8;\n123\t        let de = std::cmp::min(ds + len, png.len());\n124\t        let data = png[ds..de].to_vec();\n125\t        out.push(Chunk::new(&name, data));\n126\t        i = de + 4;\n127\t    }\n128\t    out\n129\t}\n130\t\n131\tpub fn join(chunks: &[Chunk]) -> Vec<u8> {\n132\t    let mut out = SIG.to_vec();\n133\t    for c in chunks {\n134\t        out.extend_from_slice(&c.encode());\n135\t    }\n136\t    out\n137\t}\n138\t\n139\tpub fn find(chunks: &[Chunk], name: &[u8; 4]) -> Option<usize> {\n140\t    chunks.iter().position(|c| &c.name == name)\n141\t}\n142\t\n143\t// ---------------------------------------------------------------------------\n144\t// image geometry helpers (mirrors PNG_ROWBYTES / the Adam7 tables)\n145\t// ---------------------------------------------------------------------------\n146\t\n147\tpub fn channels(color_type: u8) -> u32 {\n148\t    match color_type {\n149\t        0 | 3 => 1,\n150\t        2 => 3,\n151\t        4 => 2,\n152\t        6 => 4,\n153\t        _ => 1,\n154\t    }\n155\t}\n156\t\n157\tpub fn pixel_bits(color_type: u8, bit_depth: u8) -> u32 {\n158\t    channels(color_type) * bit_depth as u32\n159\t}\n160\t\n161\tpub fn rowbytes(color_type: u8, bit_depth: u8, width: u32) -> usize {\n162\t    let pd = pixel_bits(color_type, bit_depth) as usize;\n163\t    (pd * width as usize + 7) >> 3\n164\t}\n165\t\n166\tpub const ADAM7_XSTART: [u32; 7] = [0, 4, 0, 2, 0, 1, 0];\n167\tpub const ADAM7_YSTART: [u32; 7] = [0, 0, 4, 0, 2, 0, 1];\n168\tpub const ADAM7_XSTEP: [u32; 7] = [8, 8, 4, 4, 2, 2, 1];\n169\tpub const ADAM7_YSTEP: [u32; 7] = [8, 8, 8, 4, 4, 2, 2];\n170\t\n171\tpub fn pass_width(width: u32, pass: usize) -> u32 {\n172\t    if width <= ADAM7_XSTART[pass] {\n173\t        0\n174\t    } else {\n175\t        (width - ADAM7_XSTART[pass] + ADAM7_XSTEP[pass] - 1) / ADAM7_XSTEP[pass]\n176\t    }\n177\t}\n178\t\n179\tpub fn pass_height(height: u32, pass: usize) -> u32 {\n180\t    if height <= ADAM7_YSTART[pass] {\n181\t        0\n182\t    } else {\n183\t        (height - ADAM7_YSTART[pass] + ADAM7_YSTEP[pass] - 1) / ADAM7_YSTEP[pass]\n184\t    }\n185\t}\n186\t\n187\t/// Total size of the raw (filter byte + row) data stream for an image.\n188\tpub fn raw_size(width: u32, height: u32, color_type: u8, bit_depth: u8, interlace: u8) -> usize {\n189\t    if interlace == 0 {\n190\t        (rowbytes(color_type, bit_depth, width) + 1) * height as usize\n191\t    } else {\n192\t        (0..7)\n193\t            .map(|p| {\n194\t                let w = pass_width(width, p);\n195\t                let h = pass_height(height, p);\n196\t                if w == 0 || h == 0 {\n197\t                    0\n198\t                } else {\n199\t                    (rowbytes(color_type, bit_depth, w) + 1) * h as usize\n200\t                }\n201\t            })\n202\t            .sum()\n203\t    }\n204\t}\n205\t\n206\t// ---------------------------------------------------------------------------\n207\t// builder\n208\t// ---------------------------------------------------------------------------\n209\t\n210\tpub struct Builder {\n211\t    pub width: u32,\n212\t    pub height: u32,\n213\t    pub bit_depth: u8,\n214\t    pub color_type: u8,\n215\t    pub interlace: u8,\n216\t    pub compression: u8,\n217\t    pub filter: u8,\n218\t    pub chunks: Vec<Chunk>,\n219\t}\n220\t\n221\timpl Builder {\n222\t    pub fn new(width: u32, height: u32, bit_depth: u8, color_type: u8) -> Builder {\n223\t        Builder {\n224\t            width,\n225\t            height,\n226\t            bit_depth,\n227\t            color_type,\n228\t            interlace: 0,\n229\t            compression: 0,\n230\t            filter: 0,\n231\t            chunks: Vec::new(),\n232\t        }\n233\t    }\n234\t\n235\t    pub fn interlace(mut self, v: u8) -> Builder {\n236\t        self.interlace = v;\n237\t        self\n238\t    }\n239\t\n240\t    pub fn ihdr_bytes(&self) -> Vec<u8> {\n241\t        let mut d = Vec::with_capacity(13);\n242\t        d.extend_from_slice(&self.width.to_be_bytes());\n243\t        d.extend_from_slice(&self.height.to_be_bytes());\n244\t        d.push(self.bit_depth);\n245\t        d.push(self.color_type);\n246\t        d.push(self.compression);\n247\t        d.push(self.filter);\n248\t        d.push(self.interlace);\n249\t        d\n250\t    }\n251\t\n252\t    pub fn add(mut self, name: &[u8; 4], data: Vec<u8>) -> Builder {\n253\t        self.chunks.push(Chunk::new(name, data));\n254\t        self\n255\t    }\n256\t\n257\t    pub fn add_chunk(mut self, c: Chunk) -> Builder {\n258\t        self.chunks.push(c);\n259\t        self\n260\t    }\n261\t\n262\t    /// Raw pre-compression data: every row filter type 0 with `fill` content.\n263\t    pub fn raw_rows(&self, seed: u64) -> Vec<u8> {\n264\t        let n = raw_size(\n265\t            self.width,\n266\t            self.height,\n267\t            self.color_type,\n268\t            self.bit_depth,\n269\t            self.interlace,\n270\t        );\n271\t        let mut out = Vec::with_capacity(n);\n272\t        let mut s = seed | 1;\n273\t        let mut next = || {\n274\t            s ^= s >> 12;\n275\t            s ^= s << 25;\n276\t            s ^= s >> 27;\n277\t            (s.wrapping_mul(0x2545_F491_4F6C_DD1D) >> 33) as u8\n278\t        };\n279\t        if self.interlace == 0 {\n280\t            let rb = rowbytes(self.color_type, self.bit_depth, self.width);\n281\t            for _ in 0..self.height {\n282\t                out.push(0);\n283\t                for _ in 0..rb {\n284\t                    out.push(next());\n285\t                }\n286\t            }\n287\t        } else {\n288\t            for p in 0..7 {\n289\t                let w = pass_width(self.width, p);\n290\t                let h = pass_height(self.height, p);\n291\t                if w == 0 || h == 0 {\n292\t                    continue;\n293\t                }\n294\t                let rb = rowbytes(self.color_type, self.bit_depth, w);\n295\t                for _ in 0..h {\n296\t                    out.push(0);\n297\t                    for _ in 0..rb {\n298\t                        out.push(next());\n299\t                    }\n300\t                }\n301\t            }\n302\t        }\n303\t        out\n304\t    }\n305\t\n306\t    /// Assemble: signature, IHDR, the added chunks, IDAT(s), IEND.\n307\t    pub fn build(&self, idat_payload: &[u8], idat_split: usize) -> Vec<u8> {\n308\t        let mut chunks = vec![Chunk::new(b\"IHDR\", self.ihdr_bytes())];\n309\t        chunks.extend(self.chunks.iter().cloned());\n310\t        let z = zlib_stored(idat_payload);\n311\t        if idat_split == 0 || z.len() <= idat_split {\n312\t            chunks.push(Chunk::new(b\"IDAT\", z));\n313\t        } else {\n314\t            for part in z.chunks(idat_split) {\n315\t                chunks.push(Chunk::new(b\"IDAT\", part.to_vec()));\n316\t            }\n317\t        }\n318\t        chunks.push(Chunk::new(b\"IEND\", Vec::new()));\n319\t        join(&chunks)\n320\t    }\n321\t\n322\t    /// Convenience: a complete, valid PNG with pseudo-random image content.\n323\t    pub fn build_valid(&self, seed: u64) -> Vec<u8> {\n324\t        let raw = self.raw_rows(seed);\n325\t        self.build(&raw, 0)\n326\t    }\n327\t}\n328\t"}]},"parent_tool_use_id":"toolu_bdrk_01KKgwxwravRomJENipvomj6","session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"6737440f-a007-422b-975f-0fc4491104e9","timestamp":"2026-08-14T15:16:20.930Z","subagent_type":"general-purpose","task_description":"Write lowlevel_b tests L19-L29"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UP6M6Cvevgce31qqLhCwSY","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both the reference C `libpng.so` and the translated Rust `liblibpng.so` are\n4\t//! loaded with `libloading`; every call goes through the dynamic symbol table,\n5\t//! so the `#[no_mangle]` export wrappers are exercised exactly as an external\n6\t//! consumer would exercise them.\n7\t//!\n8\t//! Each driver produces a *trace*: a `Vec<String>` of every observable event\n9\t//! (return values, warning/error messages, produced bytes, decoded rows).  A\n10\t//! configuration passes when the C trace and the Rust trace are identical.\n11\t#![allow(dead_code)]\n12\t#![allow(non_camel_case_types)]\n13\t#![allow(non_snake_case)]\n14\t\n15\tuse std::cell::RefCell;\n16\tuse std::ffi::{c_char, c_int, c_void, CStr};\n17\tuse std::path::{Path, PathBuf};\n18\tuse std::process::Command;\n19\tuse std::sync::OnceLock;\n20\t\n21\tpub const VER_STRING: &[u8] = b\"1.6.59.git\\0\";\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// Library loading\n25\t// ---------------------------------------------------------------------------\n26\t\n27\tpub struct Lib {\n28\t    lib: libloading::Library,\n29\t    pub tag: &'static str,\n30\t}\n31\t\n32\timpl Lib {\n33\t    pub fn open(path: &Path, tag: &'static str) -> Lib {\n34\t        let lib = unsafe { libloading::Library::new(path) }\n35\t            .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {e}\", path.display()));\n36\t        Lib { lib, tag }\n37\t    }\n38\t\n39\t    /// Resolve `name` and transmute it to the requested function-pointer type.\n40\t    pub fn f<T: Copy>(&self, name: &str) -> T {\n41\t        assert_eq!(\n42\t            std::mem::size_of::<T>(),\n43\t            std::mem::size_of::<*const c_void>(),\n44\t            \"f::<T>() is only for pointer-sized types\"\n45\t        );\n46\t        let p = self.raw(name);\n47\t        unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n48\t    }\n49\t\n50\t    /// Resolve `name`, returning `None` when the symbol is absent.\n51\t    pub fn opt<T: Copy>(&self, name: &str) -> Option<T> {\n52\t        let mut owned = name.as_bytes().to_vec();\n53\t        owned.push(0);\n54\t        let sym: Result<libloading::Symbol<*const c_void>, _> = unsafe { self.lib.get(&owned) };\n55\t        sym.ok().map(|s| {\n56\t            let p = unsafe { *s };\n57\t            unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n58\t        })\n59\t    }\n60\t\n61\t    pub fn raw(&self, name: &str) -> *const c_void {\n62\t        let mut owned = name.as_bytes().to_vec();\n63\t        owned.push(0);\n64\t        let sym: libloading::Symbol<*const c_void> = unsafe { self.lib.get(&owned) }\n65\t            .unwrap_or_else(|e| panic!(\"{}: missing symbol {name}: {e}\", self.tag));\n66\t        unsafe { *sym }\n67\t    }\n68\t\n69\t    /// Address of an exported data object.\n70\t    pub fn data(&self, name: &str) -> *const u8 {\n71\t        self.raw(name) as *const u8\n72\t    }\n73\t}\n74\t\n75\tfn manifest_dir() -> PathBuf {\n76\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n77\t}\n78\t\n79\tpub fn c_so_path() -> PathBuf {\n80\t    if let Ok(p) = std::env::var(\"PNG_C_SO\") {\n81\t        return PathBuf::from(p);\n82\t    }\n83\t    let p = manifest_dir().join(\"target/cbuild/libpng.so\");\n84\t    assert!(\n85\t        p.exists(),\n86\t        \"C reference library not built: {} missing (cmake -S c_src -B target/cbuild && cmake --build target/cbuild)\",\n87\t        p.display()\n88\t    );\n89\t    p\n90\t}\n91\t\n92\tpub fn rust_so_path() -> PathBuf {\n93\t    if let Ok(p) = std::env::var(\"PNG_RUST_SO\") {\n94\t        return PathBuf::from(p);\n95\t    }\n96\t    // The integration test binary lives in target/<profile>/deps/, so the\n97\t    // cdylib is one directory up.\n98\t    let exe = std::env::current_exe().expect(\"current_exe\");\n99\t    let dir = exe.parent().unwrap().parent().unwrap();\n100\t    for name in [\"liblibpng.so\", \"libpng.so\"] {\n101\t        let p = dir.join(name);\n102\t        if p.exists() {\n103\t            return p;\n104\t        }\n105\t    }\n106\t    panic!(\"Rust cdylib not found next to {}\", exe.display());\n107\t}\n108\t\n109\tpub struct Pair {\n110\t    pub c: Lib,\n111\t    pub rust: Lib,\n112\t}\n113\t\n114\tstatic PAIR: OnceLock<Pair> = OnceLock::new();\n115\t\n116\tpub fn pair() -> &'static Pair {\n117\t    PAIR.get_or_init(|| {\n118\t        // Load the shim first so the landing pad exists before any png_error.\n119\t        shim();\n120\t        Pair {\n121\t            c: Lib::open(&c_so_path(), \"C\"),\n122\t            rust: Lib::open(&rust_so_path(), \"RUST\"),\n123\t        }\n124\t    })\n125\t}\n126\t\n127\t// ---------------------------------------------------------------------------\n128\t// setjmp/longjmp shim\n129\t// ---------------------------------------------------------------------------\n130\t\n131\tpub type ThFn = Option<unsafe extern \"C\" fn(*mut c_void)>;\n132\t\n133\tpub struct Shim {\n134\t    _lib: libloading::Library,\n135\t    protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int,\n136\t    pub longjmp_ptr: *const c_void,\n137\t    pub jmp_buf_size: usize,\n138\t}\n139\t\n140\tunsafe impl Send for Shim {}\n141\tunsafe impl Sync for Shim {}\n142\t\n143\tstatic SHIM: OnceLock<Shim> = OnceLock::new();\n144\t\n145\tpub fn shim() -> &'static Shim {\n146\t    SHIM.get_or_init(|| {\n147\t        let src = manifest_dir().join(\"tests/support/testshim.c\");\n148\t        let out_dir = manifest_dir().join(\"target/testsupport\");\n149\t        std::fs::create_dir_all(&out_dir).unwrap();\n150\t        let so = out_dir.join(\"libtestshim.so\");\n151\t        // Compile to a unique file then rename: several test binaries may race.\n152\t        let tmp = out_dir.join(format!(\"libtestshim-{}.so\", std::process::id()));\n153\t        let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());\n154\t        let st = Command::new(&cc)\n155\t            .args([\"-O0\", \"-fPIC\", \"-shared\", \"-o\"])\n156\t            .arg(&tmp)\n157\t            .arg(&src)\n158\t            .status()\n159\t            .expect(\"failed to run C compiler for test shim\");\n160\t        assert!(st.success(), \"test shim compilation failed\");\n161\t        std::fs::rename(&tmp, &so).unwrap();\n162\t\n163\t        let lib = unsafe { libloading::Library::new(&so) }.expect(\"dlopen test shim\");\n164\t        let protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int = unsafe {\n165\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_protect\\0\").unwrap();\n166\t            std::mem::transmute(*s)\n167\t        };\n168\t        let longjmp_ptr = unsafe {\n169\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_longjmp\\0\").unwrap();\n170\t            *s\n171\t        };\n172\t        let size_fn: unsafe extern \"C\" fn() -> usize = unsafe {\n173\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_jmp_buf_size\\0\").unwrap();\n174\t            std::mem::transmute(*s)\n175\t        };\n176\t        let jmp_buf_size = unsafe { size_fn() };\n177\t        Shim {\n178\t            _lib: lib,\n179\t            protect,\n180\t            longjmp_ptr,\n181\t            jmp_buf_size,\n182\t        }\n183\t    })\n184\t}\n185\t\n186\t/// Run `f` with a longjmp landing pad installed.  Returns 0 when `f` completed\n187\t/// normally, non-zero when libpng (or a harness callback) performed a longjmp.\n188\t///\n189\t/// `f` must not own anything that needs dropping: a longjmp skips destructors.\n190\tpub fn protected<F: FnMut()>(mut f: F) -> c_int {\n191\t    unsafe extern \"C\" fn tramp<F: FnMut()>(p: *mut c_void) {\n192\t        unsafe { (*(p as *mut F))() }\n193\t    }\n194\t    let s = shim();\n195\t    unsafe { (s.protect)(Some(tramp::<F>), &mut f as *mut F as *mut c_void) }\n196\t}\n197\t\n198\t// ---------------------------------------------------------------------------\n199\t// Per-thread session state (trace log + simulated I/O)\n200\t// ---------------------------------------------------------------------------\n201\t\n202\t#[derive(Default)]\n203\tpub struct Session {\n204\t    pub log: Vec<String>,\n205\t    /// Bytes handed to the write callback.\n206\t    pub out: Vec<u8>,\n207\t    /// Bytes served by the read callback.\n208\t    pub input: Vec<u8>,\n209\t    pub rpos: usize,\n210\t    /// Trace every png_malloc/png_free through the user-memory callbacks.\n211\t    pub trace_alloc: bool,\n212\t    /// Count of live allocations made through the user-memory callbacks.\n213\t    pub live_allocs: i64,\n214\t    /// Make the write callback fail (longjmp) once this many bytes were written.\n215\t    pub write_limit: Option<usize>,\n216\t    /// Fail malloc after this many successful allocations.\n217\t    pub malloc_limit: Option<usize>,\n218\t    pub malloc_count: usize,\n219\t}\n220\t\n221\tthread_local! {\n222\t    static SESSION: RefCell<Session> = RefCell::new(Session::default());\n223\t}\n224\t\n225\tpub fn session_reset(input: Vec<u8>) {\n226\t    SESSION.with(|s| {\n227\t        let mut s = s.borrow_mut();\n228\t        *s = Session::default();\n229\t        s.input = input;\n230\t    });\n231\t}\n232\t\n233\tpub fn with_session<R>(f: impl FnOnce(&mut Session) -> R) -> R {\n234\t    SESSION.with(|s| f(&mut s.borrow_mut()))\n235\t}\n236\t\n237\tpub fn log(msg: impl AsRef<str>) {\n238\t    let m = msg.as_ref().to_string();\n239\t    SESSION.with(|s| s.borrow_mut().log.push(m));\n240\t}\n241\t\n242\tpub fn take_log() -> Vec<String> {\n243\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().log))\n244\t}\n245\t\n246\tpub fn take_out() -> Vec<u8> {\n247\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().out))\n248\t}\n249\t\n250\tpub fn cstr(p: *const c_char) -> String {\n251\t    if p.is_null() {\n252\t        return \"<null>\".to_string();\n253\t    }\n254\t    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()\n255\t}\n256\t\n257\tpub fn hex(b: &[u8]) -> String {\n258\t    let mut s = String::with_capacity(b.len() * 2);\n259\t    for x in b {\n260\t        s.push_str(&format!(\"{x:02x}\"));\n261\t    }\n262\t    s\n263\t}\n264\t\n265\t// ---------------------------------------------------------------------------\n266\t// libpng callbacks (identical for both libraries)\n267\t// ---------------------------------------------------------------------------\n268\t\n269\tpub unsafe extern \"C\" fn cb_error(_png: *mut c_void, msg: *const c_char) {\n270\t    log(format!(\"ERROR({})\", cstr(msg)));\n271\t    // Returning lets libpng call png_longjmp -> th_longjmp, which is what a\n272\t    // real application relies on.\n273\t}\n274\t\n275\tpub unsafe extern \"C\" fn cb_warning(_png: *mut c_void, msg: *const c_char) {\n276\t    log(format!(\"WARNING({})\", cstr(msg)));\n277\t}\n278\t\n279\tpub unsafe extern \"C\" fn cb_write(_png: *mut c_void, data: *mut u8, len: usize) {\n280\t    let mut over = false;\n281\t    SESSION.with(|s| {\n282\t        let mut s = s.borrow_mut();\n283\t        if len > 0 {\n284\t            let src = unsafe { std::slice::from_raw_parts(data, len) };\n285\t            s.out.extend_from_slice(src);\n286\t        }\n287\t        if let Some(lim) = s.write_limit {\n288\t            if s.out.len() > lim {\n289\t                over = true;\n290\t            }\n291\t        }\n292\t    });\n293\t    if over {\n294\t        log(\"WRITE_LIMIT\".to_string());\n295\t        th_longjmp_now(7);\n296\t    }\n297\t}\n298\t\n299\tpub unsafe extern \"C\" fn cb_flush(_png: *mut c_void) {\n300\t    log(\"FLUSH\".to_string());\n301\t}\n302\t\n303\tpub unsafe extern \"C\" fn cb_read(_png: *mut c_void, data: *mut u8, len: usize) {\n304\t    let mut short = false;\n305\t    SESSION.with(|s| {\n306\t        let mut s = s.borrow_mut();\n307\t        let avail = s.input.len().saturating_sub(s.rpos);\n308\t        if avail < len {\n309\t            short = true;\n310\t        } else {\n311\t            if len > 0 {\n312\t                let src = &s.input[s.rpos..s.rpos + len];\n313\t                unsafe { std::ptr::copy_nonoverlapping(src.as_ptr(), data, len) };\n314\t            }\n315\t            s.rpos += len;\n316\t        }\n317\t    });\n318\t    if short {\n319\t        log(\"READ_SHORT\".to_string());\n320\t        th_longjmp_now(3);\n321\t    }\n322\t}\n323\t\n324\t/// User-memory malloc callback: `png_malloc_ptr`.\n325\tpub unsafe extern \"C\" fn cb_malloc(_png: *mut c_void, size: usize) -> *mut c_void {\n326\t    let mut fail = false;\n327\t    SESSION.with(|s| {\n328\t        let mut s = s.borrow_mut();\n329\t        s.malloc_count += 1;\n330\t        if let Some(lim) = s.malloc_limit {\n331\t            if s.malloc_count > lim {\n332\t                fail = true;\n333\t            }\n334\t        }\n335\t        if s.trace_alloc {\n336\t            let n = s.malloc_count;\n337\t            s.log.push(format!(\"MALLOC(#{n},{size})\"));\n338\t        }\n339\t        if !fail {\n340\t            s.live_allocs += 1;\n341\t        }\n342\t    });\n343\t    if fail {\n344\t        return std::ptr::null_mut();\n345\t    }\n346\t    // Use calloc so that any dependence on uninitialised memory shows up\n347\t    // identically in both libraries.\n348\t    unsafe { libc_calloc(1, if size == 0 { 1 } else { size }) }\n349\t}\n350\t\n351\tpub unsafe extern \"C\" fn cb_free(_png: *mut c_void, p: *mut c_void) {\n352\t    SESSION.with(|s| {\n353\t        let mut s = s.borrow_mut();\n354\t        if s.trace_alloc {\n355\t            s.log.push(format!(\"FREE({})\", if p.is_null() { 0 } else { 1 }));\n356\t        }\n357\t        if !p.is_null() {\n358\t            s.live_allocs -= 1;\n359\t        }\n360\t    });\n361\t    if !p.is_null() {\n362\t        unsafe { libc_free(p) };\n363\t    }\n364\t}\n365\t\n366\textern \"C\" {\n367\t    #[link_name = \"calloc\"]\n368\t    fn libc_calloc(n: usize, size: usize) -> *mut c_void;\n369\t    #[link_name = \"free\"]\n370\t    fn libc_free(p: *mut c_void);\n371\t}\n372\t\n373\tpub fn th_longjmp_now(val: c_int) -> ! {\n374\t    let f: unsafe extern \"C\" fn(*mut c_void, c_int) =\n375\t        unsafe { std::mem::transmute(shim().longjmp_ptr) };\n376\t    unsafe { f(std::ptr::null_mut(), val) };\n377\t    unreachable!(\"th_longjmp returned\");\n378\t}\n379\t\n380\t// ---------------------------------------------------------------------------\n381\t// Trace comparison\n382\t// ---------------------------------------------------------------------------\n383\t\n384\tpub struct Trace {\n385\t    pub lines: Vec<String>,\n386\t    pub out: Vec<u8>,\n387\t    pub rc: c_int,\n388\t}\n389\t\n390\timpl Trace {\n391\t    pub fn render(&self) -> String {\n392\t        let mut s = String::new();\n393\t        s.push_str(&format!(\"rc={}\\n\", self.rc));\n394\t        for l in &self.lines {\n395\t            s.push_str(l);\n396\t            s.push('\\n');\n397\t        }\n398\t        s.push_str(&format!(\"out.len={}\\n\", self.out.len()));\n399\t        s.push_str(&format!(\"out={}\\n\", hex(&self.out)));\n400\t        s\n401\t    }\n402\t}\n403\t\n404\t/// Run one driver closure against both libraries and require identical traces.\n405\tpub fn diff(label: &str, mut run: impl FnMut(&Lib) -> Trace) {\n406\t    let p = pair();\n407\t    let ct = run(&p.c);\n408\t    let rt = run(&p.rust);\n409\t    if ct.render() != rt.render() {\n410\t        let a = ct.render();\n411\t        let b = rt.render();\n412\t        let mut first = String::new();\n413\t        for (i, (la, lb)) in a.lines().zip(b.lines()).enumerate() {\n414\t            if la != lb {\n415\t                let sa = clip(la);\n416\t                let sb = clip(lb);\n417\t                first = format!(\"first divergence at trace line {i}:\\n  C   : {sa}\\n  RUST: {sb}\");\n418\t                break;\n419\t            }\n420\t        }\n421\t        if first.is_empty() {\n422\t            let na = a.lines().count();\n423\t            let nb = b.lines().count();\n424\t            first = format!(\"trace lengths differ: C={na} lines, RUST={nb} lines\");\n425\t        }\n426\t        panic!(\"[{label}] C and Rust diverge\\n{first}\\n\");\n427\t    }\n428\t}\n429\t\n430\tfn clip(s: &str) -> String {\n431\t    if s.len() <= 400 {\n432\t        s.to_string()\n433\t    } else {\n434\t        format!(\"{}...<{} bytes total>\", &s[..400], s.len())\n435\t    }\n436\t}\n437\t\n438\t// ---------------------------------------------------------------------------\n439\t// Deterministic PRNG (xorshift64*) so every test is reproducible.\n440\t// ---------------------------------------------------------------------------\n441\t\n442\tpub struct Rng(pub u64);\n443\t\n444\timpl Rng {\n445\t    pub fn new(seed: u64) -> Rng {\n446\t        Rng(seed | 1)\n447\t    }\n448\t    pub fn next_u64(&mut self) -> u64 {\n449\t        let mut x = self.0;\n450\t        x ^= x >> 12;\n451\t        x ^= x << 25;\n452\t        x ^= x >> 27;\n453\t        self.0 = x;\n454\t        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n455\t    }\n456\t    pub fn next_u32(&mut self) -> u32 {\n457\t        (self.next_u64() >> 32) as u32\n458\t    }\n459\t    pub fn below(&mut self, n: u32) -> u32 {\n460\t        if n == 0 {\n461\t            0\n462\t        } else {\n463\t            self.next_u32() % n\n464\t        }\n465\t    }\n466\t    pub fn byte(&mut self) -> u8 {\n467\t        (self.next_u64() >> 24) as u8\n468\t    }\n469\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n470\t        (0..n).map(|_| self.byte()).collect()\n471\t    }\n472\t    pub fn f64(&mut self) -> f64 {\n473\t        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64\n474\t    }\n475\t}\n476\t\n477\t// ---------------------------------------------------------------------------\n478\t// Sub-modules\n479\t// ---------------------------------------------------------------------------\n480\t\n481\tpub mod core;\n482\tpub mod pngbuild;\n483\t\n484\tuse crate::support::core::{Cb, Core, Info, Png};\n485\t\n486\t/// Create a write struct wired to the harness callbacks, run `body`, destroy.\n487\tpub fn with_write(lib: &Lib, body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n488\t    session_reset(Vec::new());\n489\t    let core = Core::new(lib);\n490\t    let rc = protected(|| unsafe {\n491\t        let png = (core.create_write)(\n492\t            VER_STRING.as_ptr() as *const c_char,\n493\t            std::ptr::null_mut(),\n494\t            cb_error as Cb,\n495\t            cb_warning as Cb,\n496\t        );\n497\t        log(format!(\"create_write={}\", if png.is_null() { 0 } else { 1 }));\n498\t        if png.is_null() {\n499\t            return;\n500\t        }\n501\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n502\t        (core.set_write_fn)(png, std::ptr::null_mut(), cb_write as Cb, cb_flush as Cb);\n503\t        let info = (core.create_info)(png);\n504\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n505\t        body(&core, png, info);\n506\t        let mut p = png;\n507\t        let mut i = info;\n508\t        (core.destroy_write)(&mut p, &mut i);\n509\t        log(\"destroyed\".to_string());\n510\t    });\n511\t    Trace {\n512\t        lines: take_log(),\n513\t        out: take_out(),\n514\t        rc,\n515\t    }\n516\t}\n517\t\n518\t/// Create a read struct fed from `input`, run `body`, destroy.\n519\tpub fn with_read(lib: &Lib, input: &[u8], body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n520\t    session_reset(input.to_vec());\n521\t    let core = Core::new(lib);\n522\t    let rc = protected(|| unsafe {\n523\t        let png = (core.create_read)(\n524\t            VER_STRING.as_ptr() as *const c_char,\n525\t            std::ptr::null_mut(),\n526\t            cb_error as Cb,\n527\t            cb_warning as Cb,\n528\t        );\n529\t        log(format!(\"create_read={}\", if png.is_null() { 0 } else { 1 }));\n530\t        if png.is_null() {\n531\t            return;\n532\t        }\n533\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n534\t        (core.set_read_fn)(png, std::ptr::null_mut(), cb_read as Cb);\n535\t        let info = (core.create_info)(png);\n536\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n537\t        body(&core, png, info);\n538\t        let mut p = png;\n539\t        let mut i = info;\n540\t        (core.destroy_read)(&mut p, &mut i, std::ptr::null_mut());\n541\t        log(\"destroyed\".to_string());\n542\t    });\n543\t    Trace {\n544\t        lines: take_log(),\n545\t        out: take_out(),\n546\t        rc,\n547\t    }\n548\t}\n549\t\n550\t/// Log every ancillary-information getter, so that any divergence in the\n551\t/// decoded info struct shows up in the trace.\n552\tpub unsafe fn log_all_info(c: &Core, png: Png, info: Info) {\n553\t    use crate::support::core::*;\n554\t    let mut w = 0u32;\n555\t    let mut h = 0u32;\n556\t    let (mut bd, mut ct, mut il, mut cm, mut fm) = (0, 0, 0, 0, 0);\n557\t    let r = (c.get_IHDR)(png, info, &mut w, &mut h, &mut bd, &mut ct, &mut il, &mut cm, &mut fm);\n558\t    log(format!(\n559\t        \"IHDR rc={r} w={w} h={h} depth={bd} color={ct} interlace={il} comp={cm} filter={fm}\"\n560\t    ));\n561\t    log(format!(\n562\t        \"rowbytes={} channels={} palette_max={}\",\n563\t        (c.get_rowbytes)(png, info),\n564\t        (c.get_channels)(png, info),\n565\t        (c.get_palette_max)(png, info)\n566\t    ));\n567\t    let mut valid = 0u32;\n568\t    for (name, flag) in [\n569\t        (\"gAMA\", PNG_INFO_gAMA),\n570\t        (\"sBIT\", PNG_INFO_sBIT),\n571\t        (\"cHRM\", PNG_INFO_cHRM),\n572\t        (\"PLTE\", PNG_INFO_PLTE),\n573\t        (\"tRNS\", PNG_INFO_tRNS),\n574\t        (\"bKGD\", PNG_INFO_bKGD),\n575\t        (\"hIST\", PNG_INFO_hIST),\n576\t        (\"pHYs\", PNG_INFO_pHYs),\n577\t        (\"oFFs\", PNG_INFO_oFFs),\n578\t        (\"tIME\", PNG_INFO_tIME),\n579\t        (\"pCAL\", PNG_INFO_pCAL),\n580\t        (\"sRGB\", PNG_INFO_sRGB),\n581\t        (\"iCCP\", PNG_INFO_iCCP),\n582\t        (\"sPLT\", PNG_INFO_sPLT),\n583\t        (\"sCAL\", PNG_INFO_sCAL),\n584\t        (\"IDAT\", PNG_INFO_IDAT),\n585\t        (\"eXIf\", PNG_INFO_eXIf),\n586\t        (\"cICP\", PNG_INFO_cICP),\n587\t        (\"cLLI\", PNG_INFO_cLLI),\n588\t        (\"mDCV\", PNG_INFO_mDCV),\n589\t    ] {\n590\t        let v = (c.get_valid)(png, info, flag);\n591\t        if v != 0 {\n592\t            valid |= flag;\n593\t        }\n594\t        log(format!(\"valid.{name}={v}\"));\n595\t    }\n596\t\n597\t    // PLTE\n598\t    let mut pal: *mut u8 = std::ptr::null_mut();\n599\t    let mut npal: c_int = -1;\n600\t    let r = (c.get_PLTE)(png, info, &mut pal, &mut npal);\n601\t    log(format!(\"PLTE rc={r} n={npal}\"));\n602\t    if r != 0 && !pal.is_null() && npal > 0 {\n603\t        let s = std::slice::from_raw_parts(pal, npal as usize * 3);\n604\t        log(format!(\"PLTE data={}\", hex(s)));\n605\t    }\n606\t    // tRNS\n607\t    let mut ta: *mut u8 = std::ptr::null_mut();\n608\t    let mut nt: c_int = -1;\n609\t    let mut tc: *mut u8 = std::ptr::null_mut();\n610\t    let r = (c.get_tRNS)(png, info, &mut ta, &mut nt, &mut tc);\n611\t    log(format!(\"tRNS rc={r} n={nt}\"));\n612\t    if r != 0 && !ta.is_null() && nt > 0 {\n613\t        log(format!(\n614\t            \"tRNS alpha={}\",\n615\t            hex(std::slice::from_raw_parts(ta, nt as usize))\n616\t        ));\n617\t    }\n618\t    if r != 0 && !tc.is_null() {\n619\t        let v = *(tc as *const PngColor16);\n620\t        log(format!(\n621\t            \"tRNS color idx={} r={} g={} b={} gray={}\",\n622\t            v.index, v.red, v.green, v.blue, v.gray\n623\t        ));\n624\t    }\n625\t    // gAMA\n626\t    let mut g: i32 = -1