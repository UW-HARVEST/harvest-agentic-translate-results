{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KbwgiLvJKniEpzhUyvqb1d","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Both the reference C `libpng.so` and the translated Rust `liblibpng.so` are\n4\t//! loaded with `libloading`; every call goes through the dynamic symbol table,\n5\t//! so the `#[no_mangle]` export wrappers are exercised exactly as an external\n6\t//! consumer would exercise them.\n7\t//!\n8\t//! Each driver produces a *trace*: a `Vec<String>` of every observable event\n9\t//! (return values, warning/error messages, produced bytes, decoded rows).  A\n10\t//! configuration passes when the C trace and the Rust trace are identical.\n11\t#![allow(dead_code)]\n12\t#![allow(non_camel_case_types)]\n13\t#![allow(non_snake_case)]\n14\t\n15\tuse std::cell::RefCell;\n16\tuse std::ffi::{c_char, c_int, c_void, CStr};\n17\tuse std::path::{Path, PathBuf};\n18\tuse std::process::Command;\n19\tuse std::sync::OnceLock;\n20\t\n21\tpub const VER_STRING: &[u8] = b\"1.6.59.git\\0\";\n22\t\n23\t// ---------------------------------------------------------------------------\n24\t// Library loading\n25\t// ---------------------------------------------------------------------------\n26\t\n27\tpub struct Lib {\n28\t    lib: libloading::Library,\n29\t    pub tag: &'static str,\n30\t}\n31\t\n32\timpl Lib {\n33\t    pub fn open(path: &Path, tag: &'static str) -> Lib {\n34\t        let lib = unsafe { libloading::Library::new(path) }\n35\t            .unwrap_or_else(|e| panic!(\"cannot dlopen {}: {e}\", path.display()));\n36\t        Lib { lib, tag }\n37\t    }\n38\t\n39\t    /// Resolve `name` and transmute it to the requested function-pointer type.\n40\t    pub fn f<T: Copy>(&self, name: &str) -> T {\n41\t        assert_eq!(\n42\t            std::mem::size_of::<T>(),\n43\t            std::mem::size_of::<*const c_void>(),\n44\t            \"f::<T>() is only for pointer-sized types\"\n45\t        );\n46\t        let p = self.raw(name);\n47\t        unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n48\t    }\n49\t\n50\t    /// Resolve `name`, returning `None` when the symbol is absent.\n51\t    pub fn opt<T: Copy>(&self, name: &str) -> Option<T> {\n52\t        let mut owned = name.as_bytes().to_vec();\n53\t        owned.push(0);\n54\t        let sym: Result<libloading::Symbol<*const c_void>, _> = unsafe { self.lib.get(&owned) };\n55\t        sym.ok().map(|s| {\n56\t            let p = unsafe { *s };\n57\t            unsafe { std::mem::transmute_copy::<*const c_void, T>(&p) }\n58\t        })\n59\t    }\n60\t\n61\t    pub fn raw(&self, name: &str) -> *const c_void {\n62\t        let mut owned = name.as_bytes().to_vec();\n63\t        owned.push(0);\n64\t        let sym: libloading::Symbol<*const c_void> = unsafe { self.lib.get(&owned) }\n65\t            .unwrap_or_else(|e| panic!(\"{}: missing symbol {name}: {e}\", self.tag));\n66\t        unsafe { *sym }\n67\t    }\n68\t\n69\t    /// Address of an exported data object.\n70\t    pub fn data(&self, name: &str) -> *const u8 {\n71\t        self.raw(name) as *const u8\n72\t    }\n73\t}\n74\t\n75\tfn manifest_dir() -> PathBuf {\n76\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n77\t}\n78\t\n79\tpub fn c_so_path() -> PathBuf {\n80\t    if let Ok(p) = std::env::var(\"PNG_C_SO\") {\n81\t        return PathBuf::from(p);\n82\t    }\n83\t    let p = manifest_dir().join(\"target/cbuild/libpng.so\");\n84\t    assert!(\n85\t        p.exists(),\n86\t        \"C reference library not built: {} missing (cmake -S c_src -B target/cbuild && cmake --build target/cbuild)\",\n87\t        p.display()\n88\t    );\n89\t    p\n90\t}\n91\t\n92\tpub fn rust_so_path() -> PathBuf {\n93\t    if let Ok(p) = std::env::var(\"PNG_RUST_SO\") {\n94\t        return PathBuf::from(p);\n95\t    }\n96\t    // The integration test binary lives in target/<profile>/deps/, so the\n97\t    // cdylib is one directory up.\n98\t    let exe = std::env::current_exe().expect(\"current_exe\");\n99\t    let dir = exe.parent().unwrap().parent().unwrap();\n100\t    for name in [\"liblibpng.so\", \"libpng.so\"] {\n101\t        let p = dir.join(name);\n102\t        if p.exists() {\n103\t            return p;\n104\t        }\n105\t    }\n106\t    panic!(\"Rust cdylib not found next to {}\", exe.display());\n107\t}\n108\t\n109\tpub struct Pair {\n110\t    pub c: Lib,\n111\t    pub rust: Lib,\n112\t}\n113\t\n114\tstatic PAIR: OnceLock<Pair> = OnceLock::new();\n115\t\n116\t/// The reference C `.so` is linked without `-lm` (the upstream CMakeLists links\n117\t/// only zlib), so `floor`/`pow` are unresolved in it.  A real application links\n118\t/// libm; we emulate that by loading libm globally before either library is used,\n119\t/// identically for both.\n120\tfn ensure_libm() {\n121\t    static LIBM: OnceLock<Option<libloading::os::unix::Library>> = OnceLock::new();\n122\t    LIBM.get_or_init(|| unsafe {\n123\t        // RTLD_GLOBAL is essential: the C .so is dlopen'ed RTLD_LOCAL and can\n124\t        // only resolve floor/pow from the global scope.\n125\t        const RTLD_NOW: i32 = 2;\n126\t        const RTLD_GLOBAL: i32 = 0x100;\n127\t        libloading::os::unix::Library::open(Some(\"libm.so.6\"), RTLD_NOW | RTLD_GLOBAL).ok()\n128\t    });\n129\t}\n130\t\n131\tpub fn pair() -> &'static Pair {\n132\t    PAIR.get_or_init(|| {\n133\t        ensure_libm();\n134\t        // Load the shim first so the landing pad exists before any png_error.\n135\t        shim();\n136\t        Pair {\n137\t            c: Lib::open(&c_so_path(), \"C\"),\n138\t            rust: Lib::open(&rust_so_path(), \"RUST\"),\n139\t        }\n140\t    })\n141\t}\n142\t\n143\t// ---------------------------------------------------------------------------\n144\t// setjmp/longjmp shim\n145\t// ---------------------------------------------------------------------------\n146\t\n147\tpub type ThFn = Option<unsafe extern \"C\" fn(*mut c_void)>;\n148\t\n149\tpub struct Shim {\n150\t    _lib: libloading::Library,\n151\t    protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int,\n152\t    pub longjmp_ptr: *const c_void,\n153\t    pub jmp_buf_size: usize,\n154\t}\n155\t\n156\tunsafe impl Send for Shim {}\n157\tunsafe impl Sync for Shim {}\n158\t\n159\tstatic SHIM: OnceLock<Shim> = OnceLock::new();\n160\t\n161\tpub fn shim() -> &'static Shim {\n162\t    SHIM.get_or_init(|| {\n163\t        let src = manifest_dir().join(\"tests/support/testshim.c\");\n164\t        let out_dir = manifest_dir().join(\"target/testsupport\");\n165\t        std::fs::create_dir_all(&out_dir).unwrap();\n166\t        let so = out_dir.join(\"libtestshim.so\");\n167\t        // Compile to a unique file then rename: several test binaries may race.\n168\t        let tmp = out_dir.join(format!(\"libtestshim-{}.so\", std::process::id()));\n169\t        let cc = std::env::var(\"CC\").unwrap_or_else(|_| \"cc\".to_string());\n170\t        let st = Command::new(&cc)\n171\t            .args([\"-O0\", \"-fPIC\", \"-shared\", \"-o\"])\n172\t            .arg(&tmp)\n173\t            .arg(&src)\n174\t            .status()\n175\t            .expect(\"failed to run C compiler for test shim\");\n176\t        assert!(st.success(), \"test shim compilation failed\");\n177\t        std::fs::rename(&tmp, &so).unwrap();\n178\t\n179\t        let lib = unsafe { libloading::Library::new(&so) }.expect(\"dlopen test shim\");\n180\t        let protect: unsafe extern \"C\" fn(ThFn, *mut c_void) -> c_int = unsafe {\n181\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_protect\\0\").unwrap();\n182\t            std::mem::transmute(*s)\n183\t        };\n184\t        let longjmp_ptr = unsafe {\n185\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_longjmp\\0\").unwrap();\n186\t            *s\n187\t        };\n188\t        let size_fn: unsafe extern \"C\" fn() -> usize = unsafe {\n189\t            let s: libloading::Symbol<*const c_void> = lib.get(b\"th_jmp_buf_size\\0\").unwrap();\n190\t            std::mem::transmute(*s)\n191\t        };\n192\t        let jmp_buf_size = unsafe { size_fn() };\n193\t        Shim {\n194\t            _lib: lib,\n195\t            protect,\n196\t            longjmp_ptr,\n197\t            jmp_buf_size,\n198\t        }\n199\t    })\n200\t}\n201\t\n202\t/// Run `f` with a longjmp landing pad installed.  Returns 0 when `f` completed\n203\t/// normally, non-zero when libpng (or a harness callback) performed a longjmp.\n204\t///\n205\t/// `f` must not own anything that needs dropping: a longjmp skips destructors.\n206\tpub fn protected<F: FnMut()>(mut f: F) -> c_int {\n207\t    unsafe extern \"C\" fn tramp<F: FnMut()>(p: *mut c_void) {\n208\t        unsafe { (*(p as *mut F))() }\n209\t    }\n210\t    let s = shim();\n211\t    unsafe { (s.protect)(Some(tramp::<F>), &mut f as *mut F as *mut c_void) }\n212\t}\n213\t\n214\t// ---------------------------------------------------------------------------\n215\t// Per-thread session state (trace log + simulated I/O)\n216\t// ---------------------------------------------------------------------------\n217\t\n218\t#[derive(Default)]\n219\tpub struct Session {\n220\t    pub log: Vec<String>,\n221\t    /// Bytes handed to the write callback.\n222\t    pub out: Vec<u8>,\n223\t    /// Bytes served by the read callback.\n224\t    pub input: Vec<u8>,\n225\t    pub rpos: usize,\n226\t    /// Trace every png_malloc/png_free through the user-memory callbacks.\n227\t    pub trace_alloc: bool,\n228\t    /// Count of live allocations made through the user-memory callbacks.\n229\t    pub live_allocs: i64,\n230\t    /// Make the write callback fail (longjmp) once this many bytes were written.\n231\t    pub write_limit: Option<usize>,\n232\t    /// Fail malloc after this many successful allocations.\n233\t    pub malloc_limit: Option<usize>,\n234\t    pub malloc_count: usize,\n235\t}\n236\t\n237\tthread_local! {\n238\t    static SESSION: RefCell<Session> = RefCell::new(Session::default());\n239\t}\n240\t\n241\tpub fn session_reset(input: Vec<u8>) {\n242\t    SESSION.with(|s| {\n243\t        let mut s = s.borrow_mut();\n244\t        *s = Session::default();\n245\t        s.input = input;\n246\t    });\n247\t}\n248\t\n249\tpub fn with_session<R>(f: impl FnOnce(&mut Session) -> R) -> R {\n250\t    SESSION.with(|s| f(&mut s.borrow_mut()))\n251\t}\n252\t\n253\tpub fn log(msg: impl AsRef<str>) {\n254\t    let m = msg.as_ref().to_string();\n255\t    SESSION.with(|s| s.borrow_mut().log.push(m));\n256\t}\n257\t\n258\tpub fn take_log() -> Vec<String> {\n259\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().log))\n260\t}\n261\t\n262\tpub fn take_out() -> Vec<u8> {\n263\t    SESSION.with(|s| std::mem::take(&mut s.borrow_mut().out))\n264\t}\n265\t\n266\tpub fn cstr(p: *const c_char) -> String {\n267\t    if p.is_null() {\n268\t        return \"<null>\".to_string();\n269\t    }\n270\t    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()\n271\t}\n272\t\n273\tpub fn hex(b: &[u8]) -> String {\n274\t    let mut s = String::with_capacity(b.len() * 2);\n275\t    for x in b {\n276\t        s.push_str(&format!(\"{x:02x}\"));\n277\t    }\n278\t    s\n279\t}\n280\t\n281\t// ---------------------------------------------------------------------------\n282\t// libpng callbacks (identical for both libraries)\n283\t// ---------------------------------------------------------------------------\n284\t\n285\tpub unsafe extern \"C\" fn cb_error(_png: *mut c_void, msg: *const c_char) {\n286\t    log(format!(\"ERROR({})\", cstr(msg)));\n287\t    // Returning lets libpng call png_longjmp -> th_longjmp, which is what a\n288\t    // real application relies on.\n289\t}\n290\t\n291\tpub unsafe extern \"C\" fn cb_warning(_png: *mut c_void, msg: *const c_char) {\n292\t    log(format!(\"WARNING({})\", cstr(msg)));\n293\t}\n294\t\n295\tpub unsafe extern \"C\" fn cb_write(_png: *mut c_void, data: *mut u8, len: usize) {\n296\t    let mut over = false;\n297\t    SESSION.with(|s| {\n298\t        let mut s = s.borrow_mut();\n299\t        if len > 0 {\n300\t            let src = unsafe { std::slice::from_raw_parts(data, len) };\n301\t            s.out.extend_from_slice(src);\n302\t        }\n303\t        if let Some(lim) = s.write_limit {\n304\t            if s.out.len() > lim {\n305\t                over = true;\n306\t            }\n307\t        }\n308\t    });\n309\t    if over {\n310\t        log(\"WRITE_LIMIT\".to_string());\n311\t        th_longjmp_now(7);\n312\t    }\n313\t}\n314\t\n315\tpub unsafe extern \"C\" fn cb_flush(_png: *mut c_void) {\n316\t    log(\"FLUSH\".to_string());\n317\t}\n318\t\n319\tpub unsafe extern \"C\" fn cb_read(_png: *mut c_void, data: *mut u8, len: usize) {\n320\t    let mut short = false;\n321\t    SESSION.with(|s| {\n322\t        let mut s = s.borrow_mut();\n323\t        let avail = s.input.len().saturating_sub(s.rpos);\n324\t        if avail < len {\n325\t            short = true;\n326\t        } else {\n327\t            if len > 0 {\n328\t                let src = &s.input[s.rpos..s.rpos + len];\n329\t                unsafe { std::ptr::copy_nonoverlapping(src.as_ptr(), data, len) };\n330\t            }\n331\t            s.rpos += len;\n332\t        }\n333\t    });\n334\t    if short {\n335\t        log(\"READ_SHORT\".to_string());\n336\t        th_longjmp_now(3);\n337\t    }\n338\t}\n339\t\n340\t/// User-memory malloc callback: `png_malloc_ptr`.\n341\tpub unsafe extern \"C\" fn cb_malloc(_png: *mut c_void, size: usize) -> *mut c_void {\n342\t    let mut fail = false;\n343\t    SESSION.with(|s| {\n344\t        let mut s = s.borrow_mut();\n345\t        s.malloc_count += 1;\n346\t        if let Some(lim) = s.malloc_limit {\n347\t            if s.malloc_count > lim {\n348\t                fail = true;\n349\t            }\n350\t        }\n351\t        if s.trace_alloc {\n352\t            let n = s.malloc_count;\n353\t            s.log.push(format!(\"MALLOC(#{n},{size})\"));\n354\t        }\n355\t        if !fail {\n356\t            s.live_allocs += 1;\n357\t        }\n358\t    });\n359\t    if fail {\n360\t        return std::ptr::null_mut();\n361\t    }\n362\t    // Use calloc so that any dependence on uninitialised memory shows up\n363\t    // identically in both libraries.\n364\t    unsafe { libc_calloc(1, if size == 0 { 1 } else { size }) }\n365\t}\n366\t\n367\tpub unsafe extern \"C\" fn cb_free(_png: *mut c_void, p: *mut c_void) {\n368\t    SESSION.with(|s| {\n369\t        let mut s = s.borrow_mut();\n370\t        if s.trace_alloc {\n371\t            s.log.push(format!(\"FREE({})\", if p.is_null() { 0 } else { 1 }));\n372\t        }\n373\t        if !p.is_null() {\n374\t            s.live_allocs -= 1;\n375\t        }\n376\t    });\n377\t    if !p.is_null() {\n378\t        unsafe { libc_free(p) };\n379\t    }\n380\t}\n381\t\n382\textern \"C\" {\n383\t    #[link_name = \"calloc\"]\n384\t    fn libc_calloc(n: usize, size: usize) -> *mut c_void;\n385\t    #[link_name = \"free\"]\n386\t    fn libc_free(p: *mut c_void);\n387\t}\n388\t\n389\tpub fn th_longjmp_now(val: c_int) -> ! {\n390\t    let f: unsafe extern \"C\" fn(*mut c_void, c_int) =\n391\t        unsafe { std::mem::transmute(shim().longjmp_ptr) };\n392\t    unsafe { f(std::ptr::null_mut(), val) };\n393\t    unreachable!(\"th_longjmp returned\");\n394\t}\n395\t\n396\t// ---------------------------------------------------------------------------\n397\t// Trace comparison\n398\t// ---------------------------------------------------------------------------\n399\t\n400\tpub struct Trace {\n401\t    pub lines: Vec<String>,\n402\t    pub out: Vec<u8>,\n403\t    pub rc: c_int,\n404\t}\n405\t\n406\timpl Trace {\n407\t    pub fn render(&self) -> String {\n408\t        let mut s = String::new();\n409\t        s.push_str(&format!(\"rc={}\\n\", self.rc));\n410\t        for l in &self.lines {\n411\t            s.push_str(l);\n412\t            s.push('\\n');\n413\t        }\n414\t        s.push_str(&format!(\"out.len={}\\n\", self.out.len()));\n415\t        s.push_str(&format!(\"out={}\\n\", hex(&self.out)));\n416\t        s\n417\t    }\n418\t}\n419\t\n420\t/// Every distinct `ERROR(...)`/`WARNING(...)` line observed from the C library,\n421\t/// appended to `target/testsupport/observed_msgs.txt` for mechanical\n422\t/// ERRORS.md coverage accounting.\n423\tstatic SEEN: OnceLock<std::sync::Mutex<std::collections::HashSet<String>>> = OnceLock::new();\n424\t\n425\tpub fn record_messages(lines: &[String]) {\n426\t    let set = SEEN.get_or_init(|| std::sync::Mutex::new(std::collections::HashSet::new()));\n427\t    let mut fresh: Vec<String> = Vec::new();\n428\t    {\n429\t        let mut g = set.lock().unwrap();\n430\t        for l in lines {\n431\t            if l.starts_with(\"ERROR(\") || l.starts_with(\"WARNING(\") || l.starts_with(\"IMAGE_ERR(\")\n432\t            {\n433\t                if g.insert(l.clone()) {\n434\t                    fresh.push(l.clone());\n435\t                }\n436\t            }\n437\t        }\n438\t    }\n439\t    if fresh.is_empty() {\n440\t        return;\n441\t    }\n442\t    use std::io::Write;\n443\t    let dir = manifest_dir().join(\"target/testsupport\");\n444\t    let _ = std::fs::create_dir_all(&dir);\n445\t    if let Ok(mut f) = std::fs::OpenOptions::new()\n446\t        .create(true)\n447\t        .append(true)\n448\t        .open(dir.join(\"observed_msgs.txt\"))\n449\t    {\n450\t        for l in fresh {\n451\t            let _ = writeln!(f, \"{l}\");\n452\t        }\n453\t    }\n454\t}\n455\t\n456\t/// Run one driver closure against both libraries and require identical traces.\n457\tpub fn diff(label: &str, mut run: impl FnMut(&Lib) -> Trace) {\n458\t    let p = pair();\n459\t    let ct = run(&p.c);\n460\t    let rt = run(&p.rust);\n461\t    record_messages(&ct.lines);\n462\t    if ct.render() != rt.render() {\n463\t        let a = ct.render();\n464\t        let b = rt.render();\n465\t        let mut first = String::new();\n466\t        for (i, (la, lb)) in a.lines().zip(b.lines()).enumerate() {\n467\t            if la != lb {\n468\t                let sa = clip(la);\n469\t                let sb = clip(lb);\n470\t                first = format!(\"first divergence at trace line {i}:\\n  C   : {sa}\\n  RUST: {sb}\");\n471\t                break;\n472\t            }\n473\t        }\n474\t        if first.is_empty() {\n475\t            let na = a.lines().count();\n476\t            let nb = b.lines().count();\n477\t            first = format!(\"trace lengths differ: C={na} lines, RUST={nb} lines\");\n478\t        }\n479\t        panic!(\"[{label}] C and Rust diverge\\n{first}\\n\");\n480\t    }\n481\t}\n482\t\n483\tfn clip(s: &str) -> String {\n484\t    if s.len() <= 400 {\n485\t        s.to_string()\n486\t    } else {\n487\t        format!(\"{}...<{} bytes total>\", &s[..400], s.len())\n488\t    }\n489\t}\n490\t\n491\t// ---------------------------------------------------------------------------\n492\t// Deterministic PRNG (xorshift64*) so every test is reproducible.\n493\t// ---------------------------------------------------------------------------\n494\t\n495\tpub struct Rng(pub u64);\n496\t\n497\timpl Rng {\n498\t    pub fn new(seed: u64) -> Rng {\n499\t        Rng(seed | 1)\n500\t    }\n501\t    pub fn next_u64(&mut self) -> u64 {\n502\t        let mut x = self.0;\n503\t        x ^= x >> 12;\n504\t        x ^= x << 25;\n505\t        x ^= x >> 27;\n506\t        self.0 = x;\n507\t        x.wrapping_mul(0x2545_F491_4F6C_DD1D)\n508\t    }\n509\t    pub fn next_u32(&mut self) -> u32 {\n510\t        (self.next_u64() >> 32) as u32\n511\t    }\n512\t    pub fn below(&mut self, n: u32) -> u32 {\n513\t        if n == 0 {\n514\t            0\n515\t        } else {\n516\t            self.next_u32() % n\n517\t        }\n518\t    }\n519\t    pub fn byte(&mut self) -> u8 {\n520\t        (self.next_u64() >> 24) as u8\n521\t    }\n522\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n523\t        (0..n).map(|_| self.byte()).collect()\n524\t    }\n525\t    pub fn f64(&mut self) -> f64 {\n526\t        (self.next_u64() >> 11) as f64 / (1u64 << 53) as f64\n527\t    }\n528\t}\n529\t\n530\t// ---------------------------------------------------------------------------\n531\t// Sub-modules\n532\t// ---------------------------------------------------------------------------\n533\t\n534\tpub mod core;\n535\tpub mod pngbuild;\n536\t\n537\tuse crate::support::core::{Cb, Core, Info, Png};\n538\t\n539\t/// Create a write struct wired to the harness callbacks, run `body`, destroy.\n540\tpub fn with_write(lib: &Lib, body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n541\t    session_reset(Vec::new());\n542\t    let core = Core::new(lib);\n543\t    let rc = protected(|| unsafe {\n544\t        let png = (core.create_write)(\n545\t            VER_STRING.as_ptr() as *const c_char,\n546\t            std::ptr::null_mut(),\n547\t            cb_error as Cb,\n548\t            cb_warning as Cb,\n549\t        );\n550\t        log(format!(\"create_write={}\", if png.is_null() { 0 } else { 1 }));\n551\t        if png.is_null() {\n552\t            return;\n553\t        }\n554\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n555\t        (core.set_write_fn)(png, std::ptr::null_mut(), cb_write as Cb, cb_flush as Cb);\n556\t        let info = (core.create_info)(png);\n557\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n558\t        body(&core, png, info);\n559\t        let mut p = png;\n560\t        let mut i = info;\n561\t        (core.destroy_write)(&mut p, &mut i);\n562\t        log(\"destroyed\".to_string());\n563\t    });\n564\t    Trace {\n565\t        lines: take_log(),\n566\t        out: take_out(),\n567\t        rc,\n568\t    }\n569\t}\n570\t\n571\t/// Create a read struct fed from `input`, run `body`, destroy.\n572\tpub fn with_read(lib: &Lib, input: &[u8], body: &mut dyn FnMut(&Core, Png, Info)) -> Trace {\n573\t    session_reset(input.to_vec());\n574\t    let core = Core::new(lib);\n575\t    let rc = protected(|| unsafe {\n576\t        let png = (core.create_read)(\n577\t            VER_STRING.as_ptr() as *const c_char,\n578\t            std::ptr::null_mut(),\n579\t            cb_error as Cb,\n580\t            cb_warning as Cb,\n581\t        );\n582\t        log(format!(\"create_read={}\", if png.is_null() { 0 } else { 1 }));\n583\t        if png.is_null() {\n584\t            return;\n585\t        }\n586\t        (core.set_longjmp)(png, shim().longjmp_ptr, shim().jmp_buf_size);\n587\t        (core.set_read_fn)(png, std::ptr::null_mut(), cb_read as Cb);\n588\t        let info = (core.create_info)(png);\n589\t        log(format!(\"create_info={}\", if info.is_null() { 0 } else { 1 }));\n590\t        body(&core, png, info);\n591\t        let mut p = png;\n592\t        let mut i = info;\n593\t        (core.destroy_read)(&mut p, &mut i, std::ptr::null_mut());\n594\t        log(\"destroyed\".to_string());\n595\t    });\n596\t    Trace {\n597\t        lines: take_log(),\n598\t        out: take_out(),\n599\t        rc,\n600\t    }\n601\t}\n602\t\n603\t/// Log every ancillary-information getter, so that any divergence in the\n604\t/// decoded info struct shows up in the trace.\n605\tpub unsafe fn log_all_info(c: &Core, png: Png, info: Info) {\n606\t    use crate::support::core::*;\n607\t    let mut w = 0u32;\n608\t    let mut h = 0u32;\n609\t    let (mut bd, mut ct, mut il, mut cm, mut fm) = (0, 0, 0, 0, 0);\n610\t    let r = (c.get_IHDR)(png, info, &mut w, &mut h, &mut bd, &mut ct, &mut il, &mut cm, &mut fm);\n611\t    log(format!(\n612\t        \"IHDR rc={r} w={w} h={h} depth={bd} color={ct} interlace={il} comp={cm} filter={fm}\"\n613\t    ));\n614\t    log(format!(\n615\t        \"rowbytes={} channels={} palette_max={}\",\n616\t        (c.get_rowbytes)(png, info),\n617\t        (c.get_channels)(png, info),\n618\t        (c.get_palette_max)(png, info)\n619\t    ));\n620\t    let mut valid = 0u32;\n621\t    for (name, flag) in [\n622\t        (\"gAMA\", PNG_INFO_gAMA),\n623\t        (\"sBIT\", PNG_INFO_sBIT),\n624\t        (\"cHRM\", PNG_INFO_cHRM),\n625\t        (\"PLTE\", PNG_INFO_PLTE),\n626\t        (\"tRNS\", PNG_INFO_tRNS),\n627\t        (\"bKGD\", PNG_INFO_bKGD),\n628\t        (\"hIST\", PNG_INFO_hIST),\n629\t        (\"pHYs\", PNG_INFO_pHYs),\n630\t        (\"oFFs\", PNG_INFO_oFFs),\n631\t        (\"tIME\", PNG_INFO_tIME),\n632\t        (\"pCAL\", PNG_INFO_pCAL),\n633\t        (\"sRGB\", PNG_INFO_sRGB),\n634\t        (\"iCCP\", PNG_INFO_iCCP),\n635\t        (\"sPLT\", PNG_INFO_sPLT),\n636\t        (\"sCAL\", PNG_INFO_sCAL),\n637\t        (\"IDAT\", PNG_INFO_IDAT),\n638\t        (\"eXIf\", PNG_INFO_eXIf),\n639\t        (\"cICP\", PNG_INFO_cICP),\n640\t        (\"cLLI\", PNG_INFO_cLLI),\n641\t        (\"mDCV\", PNG_INFO_mDCV),\n642\t    ] {\n643\t        let v = (c.get_valid)(png, info, flag);\n644\t        if v != 0 {\n645\t            valid |= flag;\n646\t        }\n647\t        log(format!(\"valid.{name}={v}\"));\n648\t    }\n649\t\n650\t    // PLTE\n651\t    let mut pal: *mut u8 = std::ptr::null_mut();\n652\t    let mut npal: c_int = -1;\n653\t    let r = (c.get_PLTE)(png, info, &mut pal, &mut npal);\n654\t    log(format!(\"PLTE rc={r} n={npal}\"));\n655\t    if r != 0 && !pal.is_null() && npal > 0 {\n656\t        let s = std::slice::from_raw_parts(pal, npal as usize * 3);\n657\t        log(format!(\"PLTE data={}\", hex(s)));\n658\t    }\n659\t    // tRNS\n660\t    let mut ta: *mut u8 = std::ptr::null_mut();\n661\t    let mut nt: c_int = -1;\n662\t    let mut tc: *mut u8 = std::ptr::null_mut();\n663\t    let r = (c.get_tRNS)(png, info, &mut ta, &mut nt, &mut tc);\n664\t    log(format!(\"tRNS rc={r} n={nt}\"));\n665\t    if r != 0 && !ta.is_null() && nt > 0 {\n666\t        log(format!(\n667\t            \"tRNS alpha={}\",\n668\t            hex(std::slice::from_raw_parts(ta, nt as usize))\n669\t        ));\n670\t    }\n671\t    if r != 0 && !tc.is_null() {\n672\t        let v = *(tc as *const PngColor16);\n673\t        log(format!(\n674\t            \"tRNS color idx={} r={} g={} b={} gray={}\",\n675\t            v.index, v.red, v.green, v.blue, v.gray\n676\t        ));\n677\t    }\n678\t    // gAMA\n679\t    let mut g: i32 = -1;\n680\t    log(format!(\n681\t        \"gAMA rc={} v={g}\",\n682\t        (c.get_gAMA_fixed)(png, info, &mut g)\n683\t    ));\n684\t    let mut gd: f64 = -1.0;\n685\t    log(format!(\n686\t        \"gAMA_fp rc={} v={:.10}\",\n687\t        (c.get_gAMA)(png, info, &mut gd),\n688\t        gd\n689\t    ));\n690\t    // sRGB\n691\t    let mut intent: c_int = -1;\n692\t    log(format!(\n693\t        \"sRGB rc={} intent={intent}\",\n694\t        (c.get_sRGB)(png, info, &mut intent)\n695\t    ));\n696\t    // cHRM\n697\t    let mut v = [0i32; 8];\n698\t    let r = (c.get_cHRM_fixed)(\n699\t        png, info, &mut v[0], &mut v[1], &mut v[2], &mut v[3], &mut v[4], &mut v[5], &mut v[6],\n700\t        &mut v[7],\n701\t    );\n702\t    log(format!(\"cHRM rc={r} {v:?}\"));\n703\t    let mut xyz = [0i32; 9];\n704\t    let r = (c.get_cHRM_XYZ_fixed)(\n705\t        png, info, &mut xyz[0], &mut xyz[1], &mut xyz[2], &mut xyz[3], &mut xyz[4], &mut xyz[5],\n706\t        &mut xyz[6], &mut xyz[7], &mut xyz[8],\n707\t    );\n708\t    log(format!(\"cHRM_XYZ rc={r} {xyz:?}\"));\n709\t    // iCCP\n710\t    let mut name: *mut c_char = std::ptr::null_mut();\n711\t    let mut comp: c_int = -1;\n712\t    let mut prof: *mut u8 = std::ptr::null_mut();\n713\t    let mut plen: u32 = 0;\n714\t    let r = (c.get_iCCP)(png, info, &mut name, &mut comp, &mut prof, &mut plen);\n715\t    log(format!(\n716\t        \"iCCP rc={r} name={} comp={comp} len={plen}\",\n717\t        cstr(name)\n718\t    ));\n719\t    if r != 0 && !prof.is_null() && plen > 0 {\n720\t        log(format!(\n721\t            \"iCCP data={}\",\n722\t            hex(std::slice::from_raw_parts(prof, plen as usize))\n723\t        ));\n724\t    }\n725\t    // s