       msg = re.findall(r'\"((?:[^\"\\\\]|\\\\.)*)\"', buf)\n                msg = ' '.join(msg) if msg else '(no literal message)'\n                rows.append(dict(file=base, line=i, fn=fn_at(fns, i), kind=kind,\n                                 result=result, msg=msg))\n        # sentinel returns in exported functions\n    # explicit sentinel returns\n    for i, ln in enumerate(lines, 1):\n        m = re.search(r'^\\s*return\\s*\\(?\\s*(0|NULL|-1|\\(-1\\))\\s*\\)?\\s*;', ln)\n        if m:\n            fn = fn_at(fns, i)\n            if fn in csyms:\n                rows.append(dict(file=base, line=i, fn=fn, kind='return-sentinel',\n                                 result='returns %s to the caller' % m.group(1).replace('(','').replace(')',''),\n                                 msg='(sentinel return)'))\n    for i, ln in enumerate(lines, 1):\n        if re.search(r'\\baffirm\\s*\\(|\\bassert\\s*\\(', ln):\n            rows.append(dict(file=base, line=i, fn=fn_at(fns, i), kind='assert',\n                             result='assertion', msg=ln.strip()[:100]))\n\njson.dump(rows, open('tmp/errors.json','w'), indent=0)\nprint('rows:', len(rows))\nfrom collections import Counter\nprint(Counter(r['kind'] for r in rows))\nPYEOF\npython3 tmp/gen_errors.py","description":"Extract error surface from C source"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1734,"cache_read_input_tokens":82148,"cache_creation":{"ephemeral_5m_input_tokens":1734,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"11547ad3-7cdc-4bcb-a504-9e6a5631306e","uuid":"30bbca10-ec27-4fb9-ad3d-04586fc4a7ae","timestamp":"2026-08-14T15:04:04.857Z"}
