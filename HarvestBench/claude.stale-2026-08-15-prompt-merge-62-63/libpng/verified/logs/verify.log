{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0171xf9s4ZdgKcKUEFa3Km3i","type":"tool_result","content":"1\t//! Typed handles for the most-used libpng entry points, resolved from a `.so`.\n2\t#![allow(dead_code)]\n3\t#![allow(non_snake_case)]\n4\t\n5\tuse super::Lib;\n6\tuse std::ffi::{c_char, c_int, c_uint, c_void};\n7\t\n8\tpub type Png = *mut c_void;\n9\tpub type Info = *mut c_void;\n10\t/// Any callback pointer; passed through as an opaque address.\n11\tpub type Cb = *mut c_void;\n12\t\n13\tmacro_rules! core_struct {\n14\t    ( $( $field:ident : $ty:ty = $sym:literal ),* $(,)? ) => {\n15\t        pub struct Core {\n16\t            $( pub $field: $ty, )*\n17\t        }\n18\t        impl Core {\n19\t            pub fn new(lib: &Lib) -> Core {\n20\t                Core { $( $field: lib.f($sym), )* }\n21\t            }\n22\t        }\n23\t    };\n24\t}\n25\t\n26\tcore_struct! {\n27\t    // ---- lifecycle -------------------------------------------------------\n28\t    create_write: unsafe extern \"C\" fn(*const c_char, *mut c_void, Cb, Cb) -> Png\n29\t        = \"png_create_write_struct\",\n30\t    create_read: unsafe extern \"C\" fn(*const c_char, *mut c_void, Cb, Cb) -> Png\n31\t        = \"png_create_read_struct\",\n32\t    create_write_2: unsafe extern \"C\" fn(*const c_char, *mut c_void, Cb, Cb, *mut c_void, Cb, Cb) -> Png\n33\t        = \"png_create_write_struct_2\",\n34\t    create_read_2: unsafe extern \"C\" fn(*const c_char, *mut c_void, Cb, Cb, *mut c_void, Cb, Cb) -> Png\n35\t        = \"png_create_read_struct_2\",\n36\t    create_info: unsafe extern \"C\" fn(Png) -> Info = \"png_create_info_struct\",\n37\t    destroy_write: unsafe extern \"C\" fn(*mut Png, *mut Info) = \"png_destroy_write_struct\",\n38\t    destroy_read: unsafe extern \"C\" fn(*mut Png, *mut Info, *mut Info) = \"png_destroy_read_struct\",\n39\t    destroy_info: unsafe extern \"C\" fn(Png, *mut Info) = \"png_destroy_info_struct\",\n40\t    set_longjmp: unsafe extern \"C\" fn(Png, *const c_void, usize) -> *mut c_void\n41\t        = \"png_set_longjmp_fn\",\n42\t    set_error_fn: unsafe extern \"C\" fn(Png, *mut c_void, Cb, Cb) = \"png_set_error_fn\",\n43\t    set_mem_fn: unsafe extern \"C\" fn(Png, *mut c_void, Cb, Cb) = \"png_set_mem_fn\",\n44\t    set_benign_errors: unsafe extern \"C\" fn(Png, c_int) = \"png_set_benign_errors\",\n45\t\n46\t    // ---- I/O -------------------------------------------------------------\n47\t    set_write_fn: unsafe extern \"C\" fn(Png, *mut c_void, Cb, Cb) = \"png_set_write_fn\",\n48\t    set_read_fn: unsafe extern \"C\" fn(Png, *mut c_void, Cb) = \"png_set_read_fn\",\n49\t    get_io_ptr: unsafe extern \"C\" fn(Png) -> *mut c_void = \"png_get_io_ptr\",\n50\t    get_io_state: unsafe extern \"C\" fn(Png) -> u32 = \"png_get_io_state\",\n51\t    get_io_chunk_type: unsafe extern \"C\" fn(Png) -> u32 = \"png_get_io_chunk_type\",\n52\t    set_read_status_fn: unsafe extern \"C\" fn(Png, Cb) = \"png_set_read_status_fn\",\n53\t    set_write_status_fn: unsafe extern \"C\" fn(Png, Cb) = \"png_set_write_status_fn\",\n54\t\n55\t    // ---- header ----------------------------------------------------------\n56\t    set_IHDR: unsafe extern \"C\" fn(Png, Info, u32, u32, c_int, c_int, c_int, c_int, c_int)\n57\t        = \"png_set_IHDR\",\n58\t    get_IHDR: unsafe extern \"C\" fn(Png, Info, *mut u32, *mut u32, *mut c_int, *mut c_int,\n59\t        *mut c_int, *mut c_int, *mut c_int) -> u32 = \"png_get_IHDR\",\n60\t    get_rowbytes: unsafe extern \"C\" fn(Png, Info) -> usize = \"png_get_rowbytes\",\n61\t    get_channels: unsafe extern \"C\" fn(Png, Info) -> u8 = \"png_get_channels\",\n62\t    get_bit_depth: unsafe extern \"C\" fn(Png, Info) -> u8 = \"png_get_bit_depth\",\n63\t    get_color_type: unsafe extern \"C\" fn(Png, Info) -> u8 = \"png_get_color_type\",\n64\t    get_interlace_type: unsafe extern \"C\" fn(Png, Info) -> u8 = \"png_get_interlace_type\",\n65\t    get_compression_type: unsafe extern \"C\" fn