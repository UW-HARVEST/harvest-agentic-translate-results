                let rest = &f.bytes[off..];\n                for n in 0..=rest.len().min(4) {\n                    let slice = &rest[..n];\n                    diff(\n                        &format!(\"getcBlockSize shape={shape:?} len={len} off={off} n={n}\"),\n                        |api| unsafe {\n                            let mut bp = BlockProperties::default();\n                            let r = sym::<FnGetcBlockSize>(api.lib, \"ZSTD_getcBlockSize\")(\n                                as_ptr_c(slice),\n                                slice.len(),\n                                &mut bp,\n                            );\n                            (is_error(r), err_code(r), r, bp)\n                        },\n                    );\n                }\n                let mut bp = BlockProperties::default();\n                let cs = unsafe {\n                    sym::<FnGetcBlockSize>(c_lib(), \"ZSTD_getcBlockSize\")(\n                        as_ptr_c(rest),\n                        rest.len(),\n                        &mut bp,\n                    )\n                };\n                if is_error(cs) {\n                    break;\n                }\n                off += 3 + cs;\n                if bp.lastBlock == 1 {\n                    break;\n                }\n            }\n        }\n    }\n    // fuzzed 3-byte headers\n    for seed in 0..300u64 {\n        let mut r = Rng::new(0x3B_00_00 + seed);\n        let buf = gen(Shape::Random, 8, &mut r);\n        for n in 0..=8usize {\n            let slice = &buf[..n];\n            diff(&format!(\"getcBlockSize fuzz seed={seed} n={n}\"), |api| unsafe {\n                let mut bp = BlockProperties::default();\n                let x = sym::<FnGetcBlockSize>(api.lib, \"ZSTD_getcBlockSize\")(\n                    as_ptr_c(slice),\n                    slice.len(),\n                    &mut bp,\n                );\n                (is_error(x), err_code(x), x, bp)\n            });\n        }\n    }\n}\n\n#[test]\nfn p5_block_decode_internals_match() {\n    let mut rng = Rng::new(0xDE_C0_DE_11);\n    for &shape in &[Shape::Text, Shape::Skewed, Shape::Records, Shape::LongRange] {\n        for &len in &[64usize, 1024, 16384, 65536, 131_072] {\n            let src = gen(shape, len, &mut rng);\n            // one raw block payload, produced by the C library\n            let block = unsafe {\n                let cctx = (capi().createCCtx)();\n                let _ = (capi().compressBegin)(cctx, 3);\n                let cap = (capi().compressBound)(src.len()) + 128;\n                let mut buf = vec![0u8; cap];\n                let r = (capi().compressBlock)(\n                    cctx,\n                    as_ptr_m(&mut buf),\n                    cap,\n                    as_ptr_c(&src),\n                    src.len(),\n                );\n                (capi().freeCCtx)(cctx);\n                if is_error(r) || r == 0 {\n                    continue;\n                }\n                buf[..r].to_vec()\n            };\n            let tag = format!(\"shape={shape:?} len={len} blockLen={}\", block.len());\n\n            // ZSTD_decodeLiteralsBlock_wrapper: returns bytes consumed by the\n            // literals section.\n            let lit_consumed = if both_have(\"ZSTD_decodeLiteralsBlock_wrapper\") {\n                let mut got = Vec::new();\n                for api in [capi(), rapi()] {\n                    let r = unsafe {\n                        let dctx = (api.createDCtx)();\n                        let _ = (api.decompressBegin)(dctx);\n                        let mut dst = vec![0u8; len + 1024];\n                        let dcap = dst.len();\n                        let x = sym::<FnDecodeLitsWrapper>(\n                            api.lib,\n                            \"ZSTD_decodeLiteralsBlock_wrapper\",\n                        )(dctx, as_ptr_c(&block), block.len(), as_ptr_m(&mut dst), dcap);\n                        (api.freeDCtx)(dctx);\n                        x\n                    };\n                    got.push(r);\n                }\n                assert_ret_eq(\n                    &format!(\"decodeLiteralsBlock_wrapper {tag}\"),\n                    got[0],\n                    got[1],\n                );\n                if is_error(got[0]) {\n                    None\n                } else {\n                    Some(got[0])\n                }\n            } else {\n                None\n            };\n\n            // ZSTD_decodeSeqHeaders on the real sequences section\n            if let Some(lc) = lit_consumed {\n                if lc < block.len() && both_have(\"ZSTD_decodeSeqHeaders\") {\n                    let seqsec = block[lc..].to_vec();\n                    for n in [\n                        0usize,\n                        1,\n                        2,\n                        3,\n                        seqsec.len() / 2,\n                        seqsec.len().saturating_sub(1),\n                        seqsec.len(),\n                    ] {\n                        let n = n.min(seqsec.len());\n                        let slice = seqsec[..n].to_vec();\n                        diff(\n                            &format!(\"decodeSeqHeaders {tag} n={n}\"),\n                            |api| unsafe {\n                                let dctx = (api.createDCtx)();\n                                let _ = (api.decompressBegin)(dctx);\n                                let mut dst = vec![0u8; len + 1024];\n                                let dcap = dst.len();\n                                // replay the literals section so the dctx state matches\n                                let _ = sym::<FnDecodeLitsWrapper>(\n                                    api.lib,\n                                    \"ZSTD_decodeLiteralsBlock_wrapper\",\n                                )(\n                                    dctx,\n                                    as_ptr_c(&block),\n                                    block.len(),\n                                    as_ptr_m(&mut dst),\n                                    dcap,\n                                );\n                                let mut nb_seq = -12345i32;\n                                let x = sym::<FnDecodeSeqHeaders>(\n                                    api.lib,\n                                    \"ZSTD_decodeSeqHeaders\",\n                                )(dctx, &mut nb_seq, as_ptr_c(&slice), slice.len());\n                                (api.freeDCtx)(dctx);\n                                (is_error(x), err_code(x), x, nb_seq)\n                            },\n                        );\n                    }\n                }\n            }\n\n            // ZSTD_decompressBlock_internal (streaming = not_streaming)\n            if both_have(\"ZSTD_decompressBlock_internal\") {\n                for &streaming in &[0i32, 1] {\n                    let ctx = format!(\"decompressBlock_internal {tag} streaming={streaming}\");\n                    let run = |api: &Api| -> Out {\n                        unsafe {\n                            let dctx = (api.createDCtx)();\n                            let _ = (api.decompressBegin)(dctx);\n                            let mut dst = vec![0u8; len + 1024];\n                            let dcap = dst.len();\n                            let x = sym::<FnDecompressBlockInternal>(\n                                api.lib,\n                                \"ZSTD_decompressBlock_internal\",\n                            )(\n                                dctx,\n                                as_ptr_m(&mut dst),\n                                dcap,\n                                as_ptr_c(&block),\n                                block.len(),\n                                streaming,\n                            );\n                            (api.freeDCtx)(dctx);\n                            Out::ok(x, &dst)\n                        }\n                    };\n                    same_out(&ctx, &run(capi()), &run(rapi()));\n                }\n            }\n\n            // ZSTD_decompressBlock (public) + ZSTD_checkContinuity + ZSTD_insertBlock\n            let ctx = format!(\"decompressBlock+checkContinuity+insertBlock {tag}\");\n            let run = |api: &Api| -> (Out, usize) {\n                unsafe {\n                    let dctx = (api.createDCtx)();\n                    let _ = (api.decompressBegin)(dctx);\n                    let mut dst = vec![0u8; len + 1024];\n                    let dcap = dst.len();\n                    if both_have(\"ZSTD_checkContinuity\") {\n                        sym::<FnCheckContinuity>(api.lib, \"ZSTD_checkContinuity\")(\n                            dctx,\n                            as_ptr_m(&mut dst),\n                            dcap,\n                        );\n                    }\n                    let x = (api.decompressBlock)(\n                        dctx,\n                        as_ptr_m(&mut dst),\n                        dcap,\n                        as_ptr_c(&block),\n                        block.len(),\n                    );\n                    let ib = (api.insertBlock)(dctx, as_ptr_c(&dst), 64);\n                    (api.freeDCtx)(dctx);\n                    (Out::ok(x, &dst), ib)\n                }\n            };\n            let c = run(capi());\n            let r = run(rapi());\n            same_out(&ctx, &c.0, &r.0);\n            assert_ret_eq(&format!(\"{ctx}: insertBlock\"), c.1, r.1);\n            if ok(c.0.ret) {\n                assert_bytes_eq(&format!(\"{ctx}: decoded block\"), &src, &c.0.bytes);\n            }\n        }\n    }\n}\n\n#[test]\nfn p5_buildFSETable_matches() {\n    if !both_have(\"ZSTD_buildFSETable\") {\n        return;\n    }\n    let cases: &[(&[i16], u32, &[u32], &[u8], u32, &str)] = &[\n        (&LL_DEFAULT_NORM, MaxLL, &LL_BASE, &LL_BITS, LL_DEFAULT_NORMLOG, \"LL\"),\n    ];\n    for &(norm, max, base, bits, tlog, name) in cases {\n        for &bmi2 in &[0i32, 1] {\n            let ctx = format!(\"ZSTD_buildFSETable {name} tableLog={tlog} bmi2={bmi2}\");\n            let run = |lib: &'static libloading::Library| -> Vec<u8> {\n                unsafe {\n                    // (1 << tableLog) + 1 entries of 8 bytes each\n                    let mut dt = vec![0u64; (1usize << tlog) + 8];\n                    let mut ws = vec![0u32; 512];\n                    let wsz = ws.len() * 4;\n                    sym::<FnBuildFSETable>(lib, \"ZSTD_buildFSETable\")(\n                        dt.as_mut_ptr() as *mut c_void,\n                        norm.as_ptr(),\n                        max,\n                        base.as_ptr(),\n                        bits.as_ptr(),\n                        tlog,\n                        ws.as_mut_ptr() as *mut c_void,\n                        wsz,\n                        bmi2,\n                    );\n                    dt.iter().flat_map(|w| w.to_le_bytes()).collect()\n                }\n            };\n            let c = run(c_lib());\n            let r = run(r_lib());\n            assert_bytes_eq(&ctx, &c, &r);\n        }\n    }\n}\n\n#[test]\nfn p5_loadCEntropy_loadDEntropy_match() {\n    let mut rng = Rng::new(0xEE_11_22_33);\n    let corpus = gen(Shape::Text, 400_000, &mut rng);\n    let dict = train_dict(&corpus, 110 * 1024);\n    if dict.len() < 64 {\n        return; // dictionary builder unavailable\n    }\n    // full dictionary + truncations (error paths must match too)\n    let mut sizes: Vec<usize> = vec![dict.len()];\n    for d in [1usize, 2, 8, 9, 16, 64, 256, 1024, dict.len() / 2] {\n        if d <= dict.len() {\n            sizes.push(d);\n        }\n    }\n    for &ds in &sizes {\n        let d = dict[..ds].to_vec();\n        if both_have(\"ZSTD_loadDEntropy\") {\n            let ctx = format!(\"ZSTD_loadDEntropy dictSize={ds}\");\n            let run = |lib: &'static libloading::Library| -> (usize, Vec<u8>) {\n                unsafe {\n                    // ZSTD_entropyDTables_t is ~27 KB; 64 KB zero-filled is ample.\n                    let mut ent = vec![0u64; 8192];\n                    let x = sym::<FnLoadDEntropy>(lib, \"ZSTD_loadDEntropy\")(\n                        ent.as_mut_ptr() as *mut c_void,\n                        as_ptr_c(&d),\n                        d.len(),\n                    );\n                    (x, ent.iter().flat_map(|w| w.to_le_bytes()).collect())\n                }\n            };\n            let c = run(c_lib());\n            let r = run(r_lib());\n            assert_ret_eq(&format!(\"{ctx}: return\"), c.0, r.0);\n            assert_bytes_eq(&format!(\"{ctx}: entropyDTables\"), &c.1, &r.1);\n        }\n        if both_have(\"ZSTD_loadCEntropy\") {\n            let ctx = format!(\"ZSTD_loadCEntropy dictSize={ds}\");\n            let run = |lib: &'static libloading::Library| -> (usize, Vec<u8>) {\n                unsafe {\n                    // ZSTD_compressedBlockState_t is ~5.6 KB; 16 KB zero-filled.\n                    let mut bs = vec![0u64; 2048];\n                    let mut ws = wksp(HUF_WORKSPACE_SIZE);\n                    let x = sym::<FnLoadCEntropy>(lib, \"ZSTD_loadCEntropy\")(\n                        bs.as_mut_ptr() as *mut c_void,\n                        ws.as_mut_ptr() as *mut c_void,\n                        as_ptr_c(&d),\n                        d.len(),\n                    );\n                    (x, bs.iter().flat_map(|w| w.to_le_bytes()).collect())\n                }\n            };\n            let c = run(c_lib());\n            let r = run(r_lib());\n            assert_ret_eq(&format!(\"{ctx}: return\"), c.0, r.0);\n            assert_bytes_eq(&format!(\"{ctx}: compressedBlockState\"), &c.1, &r.1);\n        }\n    }\n    // ZSTD_reset_compressedBlockState must produce identical state\n    if both_have(\"ZSTD_reset_compressedBlockState\") {\n        diff(\"ZSTD_reset_compressedBlockState\", |api| unsafe {\n            let mut bs = vec![0xABu8; 16384];\n            sym::<FnResetCBS>(api.lib, \"ZSTD_reset_compressedBlockState\")(\n                bs.as_mut_ptr() as *mut c_void,\n            );\n            bs\n        });\n    }\n    // the trained dictionary must also drive byte-identical real compression\n    for &lvl in &[1i32, 3, 19] {\n        check_frame_dict(\n            &format!(\"trained dict L={lvl} loadDictionary\"),\n            &[(ZSTD_c_compressionLevel, lvl)],\n            &dict,\n            DictMode::Load,\n            &corpus[..50_000],\n        );\n    }\n}\n\n// ------------------------------------------------- external sequence producer\n\ntype SeqProdFn = extern \"C\" fn(\n    *mut c_void,\n    *mut ZSTD_Sequence,\n    usize,\n    *const c_void,\n    usize,\n    *const c_void,\n    usize,\n    i32,\n    usize,\n) -> usize;\ntype FnRegisterSeqProd =\n    unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut c_void, Option<SeqProdFn>);\ntype FnParamsRegisterSeqProd =\n    unsafe extern \"C\" fn(*mut ZSTD_CCtxParams, *mut c_void, Option<SeqProdFn>);\n\n/// A deterministic \"all literals\" sequence producer, shared by both libraries.\nextern \"C\" fn all_literals_producer(\n    _state: *mut c_void,\n    out_seqs: *mut ZSTD_Sequence,\n    out_cap: usize,\n    _src: *const c_void,\n    src_size: usize,\n    _dict: *const c_void,\n    _dict_size: usize,\n    _level: i32,\n    _window: usize,\n) -> usize {\n    if out_cap < 1 || out_seqs.is_null() {\n        return usize::MAX; // ZSTD_SEQUENCE_PRODUCER_ERROR\n    }\n    unsafe {\n        *out_seqs = ZSTD_Sequence {\n            offset: 0,\n            litLength: src_size as u32,\n            matchLength: 0,\n            rep: 0,\n        };\n    }\n    1\n}\n\n/// A producer that always fails, to exercise the fallback path.\nextern \"C\" fn failing_producer(\n    _state: *mut c_void,\n    _out_seqs: *mut ZSTD_Sequence,\n    _out_cap: usize,\n    _src: *const c_void,\n    _src_size: usize,\n    _dict: *const c_void,\n    _dict_size: usize,\n    _level: i32,\n    _window: usize,\n) -> usize {\n    usize::MAX\n}\n\n#[test]\nfn p5_external_sequence_producer() {\n    if !both_have(\"ZSTD_registerSequenceProducer\") {\n        return;\n    }\n    let mut rng = Rng::new(0x5E_9P_00_01u64 as u64 ^ 0x5E90);\n    for &shape in ALL_SHAPES {\n        for &len in &[0usize, 1, 26, 1024, 131_072, 300_000] {\n            let src = gen(shape, len, &mut rng);\n            for producer in [0u8, 1] {\n                for &fallback in &[0i32, 1] {\n                    for &lvl in &[1i32, 3, 9] {\n                        let ctx = format!(\n                            \"registerSequenceProducer shape={shape:?} len={len} \\\n                             producer={producer} fallback={fallback} L={lvl}\"\n                        );\n                        let run = |api: &Api| -> Out {\n                            unsafe {\n                                let cctx = (api.createCCtx)();\n                                let _ =\n                                    (api.setParameter)(cctx, ZSTD_c_compressionLevel, lvl);\n                                let fr = (api.setParameter)(\n                                    cctx,\n                                    ZSTD_c_enableSeqProducerFallback,\n                                    fallback,\n                                );\n                                if is_error(fr) {\n                                    (api.freeCCtx)(cctx);\n                                    return Out::err(fr);\n                                }\n                                let f: SeqProdFn = if producer == 0 {\n                                    all_literals_producer\n                                } else {\n                                    failing_producer\n                                };\n                                sym::<FnRegisterSeqProd>(\n                                    api.lib,\n                                    \"ZSTD_registerSequenceProducer\",\n                                )(cctx, std::ptr::null_mut(), Some(f));\n                                let cap = (api.compressBound)(src.len()) + 256;\n                                let mut buf = vec![0u8; cap];\n                                let ret = (api.compress2)(\n                                    cctx,\n                                    as_ptr_m(&mut buf),\n                                    cap,\n                                    as_ptr_c(&src),\n                                    src.len(),\n                                );\n                                (api.freeCCtx)(cctx);\n                                Out::ok(ret, &buf)\n                            }\n                        };\n                        let c = run(capi());\n                        let r = run(rapi());\n                        same_out(&ctx, &c, &r);\n                        if ok(c.ret) {\n                            for api in [capi(), rapi()] {\n                                let d = decomp(api, &c.bytes, src.len());\n                                assert!(ok(d.ret), \"{ctx}: {} decompress err\", api.tag);\n                                assert_bytes_eq(\n                                    &format!(\"{ctx}/rt[{}]\", api.tag),\n                                    &src,\n                                    &d.bytes,\n                                );\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    // clearing the producer with a NULL function pointer restores normal behaviour\n    let src = gen(Shape::Text, 50_000, &mut rng);\n    let plain = comp2(capi(), &[(ZSTD_c_compressionLevel, 3)], None, &src);\n    let ctx = \"registerSequenceProducer(NULL) clears the producer\";\n    let run = |api: &Api| -> Out {\n        unsafe {\n            let cctx = (api.createCCtx)();\n            let _ = (api.setParameter)(cctx, ZSTD_c_compressionLevel, 3);\n            let reg = sym::<FnRegisterSeqProd>(api.lib, \"ZSTD_registerSequenceProducer\");\n            reg(cctx, std::ptr::null_mut(), Some(all_literals_producer));\n            reg(cctx, std::ptr::null_mut(), None);\n            let cap = (api.compressBound)(src.len()) + 256;\n            let mut buf = vec![0u8; cap];\n            let ret =\n                (api.compress2)(cctx, as_ptr_m(&mut buf), cap, as_ptr_c(&src), src.len());\n            (api.freeCCtx)(cctx);\n            Out::ok(ret, &buf)\n        }\n    };\n    let c = run(capi());\n    same_out(ctx, &c, &run(rapi()));\n    same_out(&format!(\"{ctx} == plain compress2\"), &plain, &c);\n\n    // ZSTD_CCtxParams_registerSequenceProducer + estimateCCtxSize_usingCCtxParams\n    if both_have(\"ZSTD_CCtxParams_registerSequenceProducer\") {\n        diff(\"CCtxParams_registerSequenceProducer + estimate\", |api| unsafe {\n            let params = sym::<FnCreateParams>(api.lib, \"ZSTD_createCCtxParams\")();\n            let _ = sym::<FnParamsInit>(api.lib, \"ZSTD_CCtxParams_init\")(params, 3);\n            let before = sym::<FnSizeFromParamsPtr>(\n                api.lib,\n                \"ZSTD_estimateCCtxSize_usingCCtxParams\",\n            )(params);\n            sym::<FnParamsRegisterSeqProd>(\n                api.lib,\n                \"ZSTD_CCtxParams_registerSequenceProducer\",\n            )(params, std::ptr::null_mut(), Some(all_literals_producer));\n            let after = sym::<FnSizeFromParamsPtr>(\n                api.lib,\n                \"ZSTD_estimateCCtxSize_usingCCtxParams\",\n            )(params);\n            sym::<FnParamsRegisterSeqProd>(\n                api.lib,\n                \"ZSTD_CCtxParams_registerSequenceProducer\",\n            )(params, std::ptr::null_mut(), None);\n            let cleared = sym::<FnSizeFromParamsPtr>(\n                api.lib,\n                \"ZSTD_estimateCCtxSize_usingCCtxParams\",\n            )(params);\n            sym::<FnFreeParams>(api.lib, \"ZSTD_freeCCtxParams\")(params);\n            (before, after, cleared)\n        });\n    }\n}\n\n// ----------------------------------------------------------- symbol resolution\n\n/// Every exported low-level entry point named in CONFIGS rows 118-120 must exist in\n/// BOTH libraries.  The 40 `ZSTD_compressBlock_*` match finders take an internal\n/// `ZSTD_MatchState_t*` that cannot be built from outside the library, so for those\n/// the resolvable-symbol check is the assertion.\n#[test]\nfn p5_all_low_level_symbols_resolve() {\n    const NAMES: &[&str] = &[\n        \"ZSTD_getSeqStore\",\n        \"ZSTD_resetSeqStore\",\n        \"ZSTD_seqToCodes\",\n        \"ZSTD_buildBlockEntropyStats\",\n        \"ZSTD_buildCTable\",\n        \"ZSTD_encodeSequences\",\n        \"ZSTD_selectEncodingType\",\n        \"ZSTD_compressLiterals\",\n        \"ZSTD_noCompressLiterals\",\n        \"ZSTD_compressRleLiteralsBlock\",\n        \"ZSTD_compressSuperBlock\",\n        \"ZSTD_splitBlock\",\n        \"ZSTD_get1BlockSummary\",\n        \"ZSTD_fillHashTable\",\n        \"ZSTD_fillDoubleHashTable\",\n        \"ZSTD_row_update\",\n        \"ZSTD_insertAndFindFirstIndex\",\n        \"ZSTD_updateTree\",\n        \"ZSTD_crossEntropyCost\",\n        \"ZSTD_fseBitCost\",\n        \"ZSTD_checkContinuity\",\n        \"ZSTD_invalidateRepCodes\",\n        \"ZSTD_referenceExternalSequences\",\n        \"ZSTD_reset_compressedBlockState\",\n        \"ZSTD_loadCEntropy\",\n        \"ZSTD_loadDEntropy\",\n        \"ZSTD_decodeSeqHeaders\",\n        \"ZSTD_decodeLiteralsBlock_wrapper\",\n        \"ZSTD_buildFSETable\",\n        \"ZSTD_getcBlockSize\",\n        \"ZSTD_decompressBlock_internal\",\n        \"ZSTD_selectBlockCompressor\",\n        \"ZSTD_ldm_adjustParameters\",\n        \"ZSTD_ldm_getTableSize\",\n        \"ZSTD_ldm_getMaxNbSeq\",\n        \"ZSTD_ldm_fillHashTable\",\n        \"ZSTD_ldm_generateSequences\",\n        \"ZSTD_ldm_blockCompress\",\n        \"ZSTD_ldm_skipSequences\",\n        \"ZSTD_ldm_skipRawSeqStoreBytes\",\n        \"ZSTD_dedicatedDictSearch_lazy_loadDictionary\",\n        \"ZSTD_cycleLog\",\n        \"ZSTD_compressBound\",\n        \"ZSTD_decompressionMargin\",\n        \"ZSTD_frameHeaderSize\",\n        \"ZSTD_getBlockSize\",\n        \"ZSTD_writeSkippableFrame\",\n        \"ZSTD_writeLastEmptyBlock\",\n        \"ZSTD_readSkippableFrame\",\n        \"ZSTD_getDictID_fromCDict\",\n        \"ZSTD_getDictID_fromDDict\",\n        \"ZSTD_DDict_dictContent\",\n        \"ZSTD_DDict_dictSize\",\n        \"ZSTD_copyDDictParameters\",\n        \"ZSTD_sizeof_CDict\",\n        \"ZSTD_sizeof_DDict\",\n        \"ZSTD_sizeof_CStream\",\n        \"ZSTD_sizeof_DStream\",\n        \"ZSTD_getFrameProgression\",\n        \"ZSTD_toFlushNow\",\n        \"ZSTD_getCParamsFromCDict\",\n        \"ZSTD_getCParamsFromCCtxParams\",\n        \"ZSTD_defaultCLevel\",\n        \"ZSTD_registerSequenceProducer\",\n        \"ZSTD_CCtxParams_registerSequenceProducer\",\n        \"ZSTD_convertBlockSequences\",\n        \"ZSTD_sequenceBound\",\n        \"ZSTD_generateSequences\",\n        \"ZSTD_mergeBlockDelimiters\",\n        \"ZSTD_compressSequences\",\n        \"ZSTD_compressSequencesAndLiterals\",\n        \"g_debuglevel\",\n        \"divsufsort\",\n        \"divbwt\",\n    ];\n    const BLOCK_COMPRESSORS: &[&str] = &[\n        \"ZSTD_compressBlock_fast\",\n        \"ZSTD_compressBlock_fast_dictMatchState\",\n        \"ZSTD_compressBlock_fast_extDict\",\n        \"ZSTD_compressBlock_doubleFast\",\n        \"ZSTD_compressBlock_doubleFast_dictMatchState\",\n        \"ZSTD_compressBlock_doubleFast_extDict\",\n        \"ZSTD_compressBlock_greedy\",\n        \"ZSTD_compressBlock_greedy_row\",\n        \"ZSTD_compressBlock_greedy_dictMatchState\",\n        \"ZSTD_compressBlock_greedy_dictMatchState_row\",\n        \"ZSTD_compressBlock_greedy_dedicatedDictSearch\",\n        \"ZSTD_compressBlock_greedy_dedicatedDictSearch_row\",\n        \"ZSTD_compressBlock_greedy_extDict\",\n        \"ZSTD_compressBlock_greedy_extDict_row\",\n        \"ZSTD_compressBlock_lazy\",\n        \"ZSTD_compressBlock_lazy_row\",\n        \"ZSTD_compressBlock_lazy_dictMatchState\",\n        \"ZSTD_compressBlock_lazy_dictMatchState_row\",\n        \"ZSTD_compressBlock_lazy_dedicatedDictSearch\",\n        \"ZSTD_compressBlock_lazy_dedicatedDictSearch_row\",\n        \"ZSTD_compressBlock_lazy_extDict\",\n        \"ZSTD_compressBlock_lazy_extDict_row\",\n        \"ZSTD_compressBlock_lazy2\",\n        \"ZSTD_compressBlock_lazy2_row\",\n        \"ZSTD_compressBlock_lazy2_dictMatchState\",\n        \"ZSTD_compressBlock_lazy2_dictMatchState_row\",\n        \"ZSTD_compressBlock_lazy2_dedicatedDictSearch\",\n        \"ZSTD_compressBlock_lazy2_dedicatedDictSearch_row\",\n        \"ZSTD_compressBlock_lazy2_extDict\",\n        \"ZSTD_compressBlock_lazy2_extDict_row\",\n        \"ZSTD_compressBlock_btlazy2\",\n        \"ZSTD_compressBlock_btlazy2_dictMatchState\",\n        \"ZSTD_compressBlock_btlazy2_extDict\",\n        \"ZSTD_compressBlock_btopt\",\n        \"ZSTD_compressBlock_btopt_dictMatchState\",\n        \"ZSTD_compressBlock_btopt_extDict\",\n        \"ZSTD_compressBlock_btultra\",\n        \"ZSTD_compressBlock_btultra2\",\n        \"ZSTD_compressBlock_btultra_dictMatchState\",\n        \"ZSTD_compressBlock_btultra_extDict\",\n    ];\n    let mut missing = Vec::new();\n    for n in NAMES.iter().chain(BLOCK_COMPRESSORS.iter()) {\n        let inc = unsafe { c_lib().get::<*const c_void>(n.as_bytes()).is_ok() };\n        let inr = unsafe { r_lib().get::<*const c_void>(n.as_bytes()).is_ok() };\n        if inc != inr {\n            missing.push(format!(\"{n}: C={inc} Rust={inr}\"));\n        } else if !inc {\n            missing.push(format!(\"{n}: absent from BOTH\"));\n        }\n    }\n    assert!(\n        missing.is_empty(),\n        \"{} low-level symbols do not resolve identically:\\n{}\",\n        missing.len(),\n        missing.join(\"\\n\")\n    );\n    assert_eq!(BLOCK_COMPRESSORS.len(), 40, \"expected 40 block compressors\");\n}\nRSEOF\nc