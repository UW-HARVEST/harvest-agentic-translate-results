{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_o5fl2cyekcafqycmzntywzkf5wl3qqo4sje7447tahewx4plmtwa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01TGVjhcgomcbQ6USo7M7Jb5","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/repro_ldm.rs","content":"//! Minimal reproduction driver for the LDM divergence. Shrinks the failing\n//! input to the smallest size/params that still differ.\nmod common;\nuse common::*;\nuse std::ffi::c_void;\n\nfn comp(api: &Api, params: &[(i32, i32)], src: &[u8]) -> Out {\n    unsafe {\n        let cctx = (api.createCCtx)();\n        for &(p, v) in params {\n            let r = (api.setParameter)(cctx, p, v);\n            assert!(!is_error(r), \"setParameter({p},{v}) -> {}\", err_code(r));\n        }\n        let cap = (api.compressBound)(src.len()) + 64;\n        let mut buf = vec![0u8; cap];\n        let ret = (api.compress2)(\n            cctx,\n            buf.as_mut_ptr() as *mut c_void,\n            cap,\n            src.as_ptr() as *const c_void,\n            src.len(),\n        );\n        (api.freeCCtx)(cctx);\n        Out::ok(ret, &buf)\n    }\n}\n\n#[test]\n#[ignore]\nfn shrink_ldm() {\n    let params = vec![\n        (ZSTD_c_enableLongDistanceMatching, 1),\n        (ZSTD_c_windowLog, 20),\n    ];\n    // Find the smallest LongRange length that diverges.\n    let mut smallest: Option<(usize, usize)> = None;\n    for len in (1000..400_000).step_by(1000) {\n        let mut rng = Rng::new(0x1D00_5EED);\n        let src = gen(Shape::LongRange, len, &mut rng);\n        let c = comp(capi(), &params, &src);\n        let r = comp(rapi(), &params, &src);\n        if c.bytes != r.bytes || c.ret != r.ret {\n            let idx = c\n                .bytes\n                .iter()\n                .zip(r.bytes.iter())\n                .position(|(a, b)| a != b)\n                .unwrap_or(c.bytes.len().min(r.bytes.len()));\n            smallest = Some((len, idx));\n            println!(\n                \"DIVERGE at len={len}: C ret={} Rust ret={} first differing byte index={idx}\",\n                c.ret, r.ret\n            );\n            break;\n        }\n    }\n    println!(\"smallest = {smallest:?}\");\n\n    // Which shapes diverge at a fixed size?\n    for &shape in ALL_SHAPES {\n        let mut rng = Rng::new(7);\n        let src = gen(shape, 300_000, &mut rng);\n        let c = comp(capi(), &params, &src);\n        let r = comp(rapi(), &params, &src);\n        println!(\n            \"shape={shape:?}: C ret={} Rust ret={} same={}\",\n            c.ret,\n            r.ret,\n            c.bytes == r.bytes\n        );\n    }\n\n    // Which LDM params are needed to trigger it?\n    let mut rng = Rng::new(0x1D00_5EED);\n    let src = gen(Shape::LongRange, 300_000, &mut rng);\n    for wl in [17i32, 18, 20, 22, 27] {\n        for hl in [0i32, 6, 16, 20] {\n            for mm in [0i32, 4, 32, 64] {\n                for bk in [0i32, 1, 4, 8] {\n                    for rt in [0i32, 1, 7] {\n                        let p = vec![\n                            (ZSTD_c_enableLongDistanceMatching, 1),\n                            (ZSTD_c_windowLog, wl),\n                            (ZSTD_c_ldmHashLog, hl),\n                            (ZSTD_c_ldmMinMatch, mm),\n                            (ZSTD_c_ldmBucketSizeLog, bk),\n                            (ZSTD_c_ldmHashRateLog, rt),\n                        ];\n                        let c = comp(capi(), &p, &src);\n                        let r = comp(rapi(), &p, &src);\n                        if c.bytes != r.bytes || c.ret != r.ret {\n                            println!(\n                                \"DIVERGE wl={wl} hl={hl} mm={mm} bk={bk} rt={rt}: C={} R={}\",\n                                c.ret, r.ret\n                            );\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n/// Does LDM diverge even at default (auto) settings on long-range data?\n#[test]\n#[ignore]\nfn ldm_default_vs_explicit() {\n    let mut rng = Rng::new(0x1D00_5EED);\n    let src = gen(Shape::LongRange, 300_000, &mut rng);\n    for p in [\n        vec![],\n        vec![(ZSTD_c_enableLongDistanceMatching, 0)],\n        vec![(ZSTD_c_enableLongDistanceMatching, 1)],\n        vec![(ZSTD_c_enableLongDistanceMatching, 2)],\n        vec![(ZSTD_c_compressionLevel, 19)],\n        vec![(ZSTD_c_windowLog, 27), (ZSTD_c_compressionLevel, 19)],\n    ] {\n        let c = comp(capi(), &p, &src);\n        let r = comp(rapi(), &p, &src);\n        println!(\"params={p:?} -> C={} R={} same={}\", c.ret, r.ret, c.bytes == r.bytes);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1938,"cache_read_input_tokens":153202,"cache_creation":{"ephemeral_5m_input_tokens":1938,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"cc1b0b73-84bd-4e36-a96a-a48b50704a8e","timestamp":"2026-08-14T21:21:30.284Z"}
