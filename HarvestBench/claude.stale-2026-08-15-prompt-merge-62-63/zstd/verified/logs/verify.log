{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Gs3oZBHdETGxbHBxFgtCnb","type":"tool_result","content":"The file /local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/common/mod.rs has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"5062b743-04e2-4969-ae34-d94812bf9e7e","timestamp":"2026-08-14T21:16:09.412Z","tool_use_result":{"filePath":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/common/mod.rs","oldString":"    if is_error(code) {\n        -((code as i64).wrapping_neg().wrapping_neg()) as i64;\n        (0i64).wrapping_sub(code as i64)\n    } else {\n        0\n    }","newString":"    if is_error(code) {\n        // e.g. 0xFFFF_FFFF_FFFF_FFD8 as i64 == -40  =>  code 40\n        (0i64).wrapping_sub(code as i64)\n    } else {\n        0\n    }","originalFile":"//! Differential-test harness: loads the C `.so` and the Rust `.so` side by side\n//! via `libloading` and calls BOTH only through their exported C symbols.\n//!\n//! Nothing in here ever links against the Rust crate directly — every Rust call\n//! goes through `dlopen`/`dlsym` on `target/<profile>/libzstd.so`, exactly as an\n//! external consumer would, so the `#[no_mangle] extern \"C\"` wrappers are under\n//! test too.\n#![allow(dead_code, non_snake_case, non_camel_case_types, non_upper_case_globals)]\n\nuse libloading::{Library, Symbol};\nuse std::ffi::c_void;\nuse std::path::PathBuf;\nuse std::sync::OnceLock;\n\n// ---------------------------------------------------------------- library load\n\nfn manifest_dir() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\n\nfn c_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"ZSTD_C_SO\") {\n        return PathBuf::from(p);\n    }\n    manifest_dir().join(\"c_src/build/libzstd.so\")\n}\n\nfn rust_so_path() -> PathBuf {\n    if let Ok(p) = std::env::var(\"ZSTD_RUST_SO\") {\n        return PathBuf::from(p);\n    }\n    // Prefer the profile this test binary was built into.\n    let exe = std::env::current_exe().expect(\"current_exe\");\n    // .../target/<profile>/deps/<test>-<hash>\n    let profile_dir = exe\n        .parent()\n        .and_then(|p| p.parent())\n        .map(|p| p.to_path_buf())\n        .expect(\"profile dir\");\n    let candidate = profile_dir.join(\"libzstd.so\");\n    if candidate.exists() {\n        return candidate;\n    }\n    for p in [\"target/release/libzstd.so\", \"target/debug/libzstd.so\"] {\n        let c = manifest_dir().join(p);\n        if c.exists() {\n            return c;\n        }\n    }\n    panic!(\n        \"Rust libzstd.so not found. Build it with `cargo build` (or set ZSTD_RUST_SO). \\\n         Looked in {:?}\",\n        profile_dir\n    );\n}\n\nstatic C_LIB: OnceLock<Library> = OnceLock::new();\nstatic R_LIB: OnceLock<Library> = OnceLock::new();\n\npub fn c_lib() -> &'static Library {\n    C_LIB.get_or_init(|| {\n        let p = c_so_path();\n        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen C {:?}: {e}\", p))\n    })\n}\n\npub fn r_lib() -> &'static Library {\n    R_LIB.get_or_init(|| {\n        let p = rust_so_path();\n        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen Rust {:?}: {e}\", p))\n    })\n}\n\n/// Look up `name` in one library.\npub fn sym<T>(lib: &'static Library, name: &str) -> Symbol<'static, T> {\n    unsafe { lib.get(name.as_bytes()) }\n        .unwrap_or_else(|e| panic!(\"dlsym {name} failed: {e}\"))\n}\n\n/// Look up `name` in BOTH libraries; returns `(c_fn, rust_fn)`.\npub fn pair<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n    (sym::<T>(c_lib(), name), sym::<T>(r_lib(), name))\n}\n\n/// True if both libraries export `name` (used to skip absent optional symbols).\npub fn both_have(name: &str) -> bool {\n    unsafe {\n        c_lib().get::<*const c_void>(name.as_bytes()).is_ok()\n            && r_lib().get::<*const c_void>(name.as_bytes()).is_ok()\n    }\n}\n\n// ------------------------------------------------------------------- C types\n\npub type ZSTD_CCtx = c_void;\npub type ZSTD_DCtx = c_void;\npub type ZSTD_CDict = c_void;\npub type ZSTD_DDict = c_void;\npub type ZSTD_CCtxParams = c_void;\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub struct ZSTD_bounds {\n    pub error: usize,\n    pub lowerBound: i32,\n    pub upperBound: i32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct ZSTD_inBuffer {\n    pub src: *const c_void,\n    pub size: usize,\n    pub pos: usize,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug)]\npub struct ZSTD_outBuffer {\n    pub dst: *mut c_void,\n    pub size: usize,\n    pub pos: usize,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct ZSTD_compressionParameters {\n    pub windowLog: u32,\n    pub chainLog: u32,\n    pub hashLog: u32,\n    pub searchLog: u32,\n    pub minMatch: u32,\n    pub targetLength: u32,\n    pub strategy: i32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct ZSTD_frameParameters {\n    pub contentSizeFlag: i32,\n    pub checksumFlag: i32,\n    pub noDictIDFlag: i32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct ZSTD_parameters {\n    pub cParams: ZSTD_compressionParameters,\n    pub fParams: ZSTD_frameParameters,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct ZSTD_Sequence {\n    pub offset: u32,\n    pub litLength: u32,\n    pub matchLength: u32,\n    pub rep: u32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct ZSTD_FrameHeader {\n    pub frameContentSize: u64,\n    pub windowSize: u64,\n    pub blockSizeMax: u32,\n    pub frameType: u32,\n    pub headerSize: u32,\n    pub dictID: u32,\n    pub checksumFlag: u32,\n    pub _reserved1: u32,\n    pub _reserved2: u32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\npub struct ZSTD_frameProgression {\n    pub ingested: u64,\n    pub consumed: u64,\n    pub produced: u64,\n    pub flushed: u64,\n    pub currentJobID: u32,\n    pub nbActiveWorkers: u32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct ZDICT_params_t {\n    pub compressionLevel: i32,\n    pub notificationLevel: u32,\n    pub dictID: u32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct ZDICT_cover_params_t {\n    pub k: u32,\n    pub d: u32,\n    pub steps: u32,\n    pub nbThreads: u32,\n    pub splitPoint: f64,\n    pub shrinkDict: u32,\n    pub shrinkDictMaxRegression: u32,\n    pub zParams: ZDICT_params_t,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct ZDICT_fastCover_params_t {\n    pub k: u32,\n    pub d: u32,\n    pub f: u32,\n    pub steps: u32,\n    pub nbThreads: u32,\n    pub splitPoint: f64,\n    pub accel: u32,\n    pub shrinkDict: u32,\n    pub shrinkDictMaxRegression: u32,\n    pub zParams: ZDICT_params_t,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, Default)]\npub struct ZDICT_legacy_params_t {\n    pub selectivityLevel: u32,\n    pub zParams: ZDICT_params_t,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy)]\npub struct ZSTD_customMem {\n    pub customAlloc: Option<extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n    pub customFree: Option<extern \"C\" fn(*mut c_void, *mut c_void)>,\n    pub opaque: *mut c_void,\n}\nimpl Default for ZSTD_customMem {\n    fn default() -> Self {\n        ZSTD_customMem { customAlloc: None, customFree: None, opaque: std::ptr::null_mut() }\n    }\n}\n\n// ------------------------------------------------------------------ constants\n\npub const ZSTD_CONTENTSIZE_UNKNOWN: u64 = u64::MAX;\npub const ZSTD_CONTENTSIZE_ERROR: u64 = u64::MAX - 1;\npub const ZSTD_MAGICNUMBER: u32 = 0xFD2F_B528;\npub const ZSTD_MAGIC_DICTIONARY: u32 = 0xEC30_A437;\npub const ZSTD_MAGIC_SKIPPABLE_START: u32 = 0x184D_2A50;\npub const ZSTD_BLOCKSIZE_MAX: usize = 1 << 17;\n\n// cParameters\npub const ZSTD_c_compressionLevel: i32 = 100;\npub const ZSTD_c_windowLog: i32 = 101;\npub const ZSTD_c_hashLog: i32 = 102;\npub const ZSTD_c_chainLog: i32 = 103;\npub const ZSTD_c_searchLog: i32 = 104;\npub const ZSTD_c_minMatch: i32 = 105;\npub const ZSTD_c_targetLength: i32 = 106;\npub const ZSTD_c_strategy: i32 = 107;\npub const ZSTD_c_targetCBlockSize: i32 = 130;\npub const ZSTD_c_enableLongDistanceMatching: i32 = 160;\npub const ZSTD_c_ldmHashLog: i32 = 161;\npub const ZSTD_c_ldmMinMatch: i32 = 162;\npub const ZSTD_c_ldmBucketSizeLog: i32 = 163;\npub const ZSTD_c_ldmHashRateLog: i32 = 164;\npub const ZSTD_c_contentSizeFlag: i32 = 200;\npub const ZSTD_c_checksumFlag: i32 = 201;\npub const ZSTD_c_dictIDFlag: i32 = 202;\npub const ZSTD_c_nbWorkers: i32 = 400;\npub const ZSTD_c_jobSize: i32 = 401;\npub const ZSTD_c_overlapLog: i32 = 402;\npub const ZSTD_c_rsyncable: i32 = 500;\npub const ZSTD_c_format: i32 = 10;\npub const ZSTD_c_forceMaxWindow: i32 = 1000;\npub const ZSTD_c_forceAttachDict: i32 = 1001;\npub const ZSTD_c_literalCompressionMode: i32 = 1002;\npub const ZSTD_c_experimentalParam6_retired: i32 = 1003;\npub const ZSTD_c_srcSizeHint: i32 = 1004;\npub const ZSTD_c_enableDedicatedDictSearch: i32 = 1005;\npub const ZSTD_c_stableInBuffer: i32 = 1006;\npub const ZSTD_c_stableOutBuffer: i32 = 1007;\npub const ZSTD_c_blockDelimiters: i32 = 1008;\npub const ZSTD_c_validateSequences: i32 = 1009;\npub const ZSTD_c_splitAfterSequences: i32 = 1010;\npub const ZSTD_c_useRowMatchFinder: i32 = 1011;\npub const ZSTD_c_deterministicRefPrefix: i32 = 1012;\npub const ZSTD_c_prefetchCDictTables: i32 = 1013;\npub const ZSTD_c_enableSeqProducerFallback: i32 = 1014;\npub const ZSTD_c_maxBlockSize: i32 = 1015;\npub const ZSTD_c_repcodeResolution: i32 = 1016;\npub const ZSTD_c_blockSplitterLevel: i32 = 1017;\n\n/// Every cParameter the C library recognises.\npub const ALL_CPARAMS: &[i32] = &[\n    100, 101, 102, 103, 104, 105, 106, 107, 130, 160, 161, 162, 163, 164, 200, 201, 202, 400,\n    401, 402, 500, 10, 1000, 1001, 1002, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012,\n    1013, 1014, 1015, 1016, 1017,\n];\n\n// dParameters\npub const ZSTD_d_windowLogMax: i32 = 100;\npub const ZSTD_d_format: i32 = 1000;\npub const ZSTD_d_stableOutBuffer: i32 = 1001;\npub const ZSTD_d_forceIgnoreChecksum: i32 = 1002;\npub const ZSTD_d_refMultipleDDicts: i32 = 1003;\npub const ZSTD_d_disableHuffmanAssembly: i32 = 1004;\npub const ZSTD_d_maxBlockSize: i32 = 1005;\npub const ALL_DPARAMS: &[i32] = &[100, 1000, 1001, 1002, 1003, 1004, 1005];\n\n// strategies\npub const ZSTD_fast: i32 = 1;\npub const ZSTD_btultra2: i32 = 9;\npub const ALL_STRATEGIES: &[i32] = &[1, 2, 3, 4, 5, 6, 7, 8, 9];\n\n// reset directives / end directives\npub const ZSTD_reset_session_only: u32 = 1;\npub const ZSTD_reset_parameters: u32 = 2;\npub const ZSTD_reset_session_and_parameters: u32 = 3;\npub const ZSTD_e_continue: u32 = 0;\npub const ZSTD_e_flush: u32 = 1;\npub const ZSTD_e_end: u32 = 2;\n\n/// `ERR_isError`: `code > (size_t)-ZSTD_error_maxCode` with maxCode == 120.\npub fn is_error(code: usize) -> bool {\n    code > (0usize).wrapping_sub(120)\n}\n/// Decode an error code returned across the FFI boundary into its enum value.\npub fn err_code(code: usize) -> i64 {\n    if is_error(code) {\n        -((code as i64).wrapping_neg().wrapping_neg()) as i64;\n        (0i64).wrapping_sub(code as i64)\n    } else {\n        0\n    }\n}\n\n// ------------------------------------------------------------------- PRNG\n\n/// Deterministic xorshift64* PRNG — fixed seed => reproducible test corpora.\npub struct Rng(pub u64);\n\nimpl Rng {\n    pub fn new(seed: u64) -> Self {\n        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x >> 12;\n        x ^= x << 25;\n        x ^= x >> 27;\n        self.0 = x;\n        x.wrapping_mul(0x2545F4914F6CDD1D)\n    }\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n    pub fn below(&mut self, n: usize) -> usize {\n        if n == 0 {\n            0\n        } else {\n            (self.next_u64() % n as u64) as usize\n        }\n    }\n    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n        if hi <= lo {\n            lo\n        } else {\n            lo + self.below(hi - lo + 1)\n        }\n    }\n    pub fn byte(&mut self) -> u8 {\n        (self.next_u64() >> 56) as u8\n    }\n}\n\n// ------------------------------------------------------------- data generators\n\n/// The distinct input SHAPES that `CONFIGS.md` AXIS 5 enumerates.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Shape {\n    /// All identical bytes -> exercises RLE block type.\n    Rle,\n    /// Cryptographically-random-ish -> incompressible, raw/stored block type.\n    Random,\n    /// English-like text -> literals + matches, compressed block type.\n    Text,\n    /// Small alphabet, highly repetitive -> huffman-friendly literals.\n    Skewed,\n    /// Long repeated blocks far apart -> exercises long-distance matching.\n    LongRange,\n    /// Structured binary records -> periodic matches.\n    Records,\n}\n\npub const ALL_SHAPES: &[Shape] =\n    &[Shape::Rle, Shape::Random, Shape::Text, Shape::Skewed, Shape::LongRange, Shape::Records];\n\npub fn gen(shape: Shape, len: usize, rng: &mut Rng) -> Vec<u8> {\n    let mut v = Vec::with_capacity(len);\n    match shape {\n        Shape::Rle => {\n            let b = rng.byte();\n            v.resize(len, b);\n        }\n        Shape::Random => {\n            while v.len() < len {\n                v.extend_from_slice(&rng.next_u64().to_le_bytes());\n            }\n            v.truncate(len);\n        }\n        Shape::Text => {\n            const W: &[&str] = &[\n                \"the \", \"quick \", \"brown \", \"fox \", \"jumps \", \"over \", \"lazy \", \"dog \",\n                \"zstandard \", \"compression \", \"dictionary \", \"entropy \", \"sequence \", \"block \",\n                \"literal \", \"match \", \"offset \", \"window \", \"frame \", \"checksum \",\n            ];\n            while v.len() < len {\n                v.extend_from_slice(W[rng.below(W.len())].as_bytes());\n            }\n            v.truncate(len);\n        }\n        Shape::Skewed => {\n            while v.len() < len {\n                let n = rng.range(1, 6);\n                let b = b'a' + (rng.below(4) as u8);\n                for _ in 0..n {\n                    v.push(b);\n                }\n            }\n            v.truncate(len);\n        }\n        Shape::LongRange => {\n            // A repeated 4 KB motif separated by random filler: matches at large\n            // distances, which is what enableLongDistanceMatching targets.\n            let motif: Vec<u8> = {\n                let mut m = Vec::with_capacity(4096);\n                let mut r = Rng::new(0xABCDEF);\n                while m.len() < 4096 {\n                    m.extend_from_slice(&r.next_u64().to_le_bytes());\n                }\n                m\n            };\n            while v.len() < len {\n                v.extend_from_slice(&motif);\n                let filler = rng.range(256, 2048);\n                for _ in 0..filler {\n                    if v.len() >= len {\n                        break;\n                    }\n                    v.push(rng.byte());\n                }\n            }\n            v.truncate(len);\n        }\n        Shape::Records => {\n            let mut ctr: u32 = 0;\n            while v.len() < len {\n                v.extend_from_slice(&ctr.to_le_bytes());\n                v.extend_from_slice(b\"HEADER\\0\\0\");\n                v.extend_from_slice(&(ctr % 7).to_le_bytes());\n                v.push(rng.byte());\n                ctr = ctr.wrapping_add(1);\n            }\n            v.truncate(len);\n        }\n    }\n    v\n}\n\n/// Build a set of training samples for the dictionary builders.\npub fn gen_samples(\n    shape: Shape,\n    nb: usize,\n    min_len: usize,\n    max_len: usize,\n    rng: &mut Rng,\n) -> (Vec<u8>, Vec<usize>) {\n    let mut buf = Vec::new();\n    let mut sizes = Vec::with_capacity(nb);\n    for _ in 0..nb {\n        let n = rng.range(min_len, max_len);\n        let s = gen(shape, n, rng);\n        buf.extend_from_slice(&s);\n        sizes.push(s.len());\n    }\n    (buf, sizes)\n}\n\n// ------------------------------------------------------------ assert helpers\n\n/// Compare two byte buffers and report the first differing index.\npub fn assert_bytes_eq(ctx: &str, c: &[u8], r: &[u8]) {\n    if c == r {\n        return;\n    }\n    if c.len() != r.len() {\n        panic!(\"{ctx}: length differs: C={} Rust={}\", c.len(), r.len());\n    }\n    let i = c.iter().zip(r.iter()).position(|(a, b)| a != b).unwrap();\n    let lo = i.saturating_sub(8);\n    let hi = (i + 8).min(c.len());\n    panic!(\n        \"{ctx}: bytes differ at index {i}: C=0x{:02x} Rust=0x{:02x}\\n  C   [{lo}..{hi}] = {:02x?}\\n  Rust[{lo}..{hi}] = {:02x?}\",\n        c[i], r[i], &c[lo..hi], &r[lo..hi]\n    );\n}\n\n/// Compare two `size_t` results, rendering error codes symbolically.\npub fn assert_ret_eq(ctx: &str, c: usize, r: usize) {\n    if c == r {\n        return;\n    }\n    panic!(\n        \"{ctx}: return differs: C={c} (err={}, code={}) Rust={r} (err={}, code={})\",\n        is_error(c),\n        err_code(c),\n        is_error(r),\n        err_code(r)\n    );\n}\n\npub fn err_name(lib: &'static Library, code: usize) -> String {\n    let f: Symbol<unsafe extern \"C\" fn(usize) -> *const std::os::raw::c_char> =\n        sym(lib, \"ZSTD_getErrorName\");\n    unsafe {\n        let p = f(code);\n        if p.is_null() {\n            \"<null>\".to_string()\n        } else {\n            std::ffi::CStr::from_ptr(p).to_string_lossy().into_owned()\n        }\n    }\n}\n","structuredPatch":[{"oldStart":327,"oldLines":7,"newStart":327,"newLines":7,"lines":[" /// Decode an error code returned across the FFI boundary into its enum value."," pub fn err_code(code: usize) -> i64 {","     if is_error(code) {","-        -((code as i64).wrapping_neg().wrapping_neg()) as i64;","+        // e.g. 0xFFFF_FFFF_FFFF_FFD8 as i64 == -40  =>  code 40","         (0i64).wrapping_sub(code as i64)","     } else {","         0"]}],"userModified":false,"replaceAll":false}}
