                  while ipos < n {\n                        let end = (ipos + bs).min(n);\n                        let blen = end - ipos;\n                        let body = opos + 3;\n                        let r = (a.compressBlock)(\n                            cctx,\n                            dst.as_mut_ptr().add(body) as *mut c_void,\n                            cap - body,\n                            src.as_ptr().add(ipos) as *const c_void,\n                            blen,\n                        );\n                        tr.step3(\"compressBlock\", r, blen, 0);\n                        if is_error(r) {\n                            ok = false;\n                            break;\n                        }\n                        let (bt, sz, body_len) = if r == 0 {\n                            // Incompressible: splice a bt_raw block by hand.\n                            std::ptr::copy_nonoverlapping(\n                                src.as_ptr().add(ipos),\n                                dst.as_mut_ptr().add(body),\n                                blen,\n                            );\n                            (0u32, blen as u32, blen)\n                        } else if r == 1 {\n                            (1u32, blen as u32, 1usize)\n                        } else {\n                            (2u32, r as u32, r)\n                        };\n                        let hdr: u32 = (bt << 1) | (sz << 3);\n                        dst[opos] = (hdr & 0xFF) as u8;\n                        dst[opos + 1] = ((hdr >> 8) & 0xFF) as u8;\n                        dst[opos + 2] = ((hdr >> 16) & 0xFF) as u8;\n                        tr.step3(\"blockHeader\", bt as usize, sz as usize, body_len);\n                        opos = body + body_len;\n                        ipos = end;\n                    }"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2029,"cache_read_input_tokens":173907,"c