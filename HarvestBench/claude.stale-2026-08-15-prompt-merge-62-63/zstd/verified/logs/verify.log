ibzstd.so\"] {\n        let c = manifest_dir().join(p);\n        if c.exists() {\n            return c;\n        }\n    }\n    panic!(\n        \"Rust libzstd.so not found. Build it with `cargo build` (or set ZSTD_RUST_SO). \\\n         Looked in {:?}\",\n        profile_dir\n    );\n}\n\nstatic C_LIB: OnceLock<Library> = OnceLock::new();\nstatic R_LIB: OnceLock<Library> = OnceLock::new();\n\npub fn c_lib() -> &'static Library {\n    C_LIB.get_or_init(|| {\n...\n</persisted-output>","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_011YDfa5uGtCzKrgciqkC7an","session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"2eeea2ca-f59a-4a1f-b9d0-a7b79c3d16f4","timestamp":"2026-08-14T21:34:44.673Z","subagent_type":"general-purpose","task_description":"Write legacy and zbuff tests"}
