capi());\n813\t    let r = f(rapi());\n814\t    if c != r {\n815\t        panic!(\"{ctx}\\n  C    = {c:?}\\n  Rust = {r:?}\");\n816\t    }\n817\t}\n818\t\n819\t/// Outcome of a compression attempt: return code plus the produced bytes.\n820\t#[derive(PartialEq, Eq)]\n821\tpub struct Out {\n822\t    pub ret: usize,\n823\t    pub bytes: Vec<u8>,\n824\t}\n825\t\n826\timpl std::fmt::Debug for Out {\n827\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n828\t        if is_error(self.ret) {\n829\t            write!(f, \"ERR({})\", err_code(self.ret))\n830\t        } else {\n831\t            write!(f, \"ok(ret={}, {} bytes, sha={:016x})\", self.ret, self.bytes.len(), fnv(&self.bytes))\n832\t        }\n833\t    }\n834\t}\n835\t\n836\t/// Cheap content fingerprint for debug output.\n837\tpub fn fnv(b: &[u8]) -> u64 {\n838\t    let mut h: u64 = 0xcbf29ce484222325;\n839\t    for &x in b {\n840\t        h ^= x as u64;\n841\t        h = h.wrapping_mul(0x100000001b3);\n842\t    }\n843\t    h\n844\t}\n845\t\n846\timpl Out {\n847\t    pub fn err(ret: usize) -> Out {\n848\t        Out { ret, bytes: Vec::new() }\n849\t    }\n850\t    pub fn ok(ret: usize, buf: &[u8]) -> Out {\n851\t        if is_error(ret) {\n852\t            Out::err(ret)\n853\t        } else {\n854\t            Out { ret, bytes: buf[..ret.min(buf.len())].to_vec() }\n855\t        }\n856\t    }\n857\t}\n858\t\n859\t/// Compare two `Out`s with a byte-level diff on mismatch.\n860\tpub fn diff_out(ctx: &str, f: impl Fn(&Api) -> Out) {\n861\t    let c = f(capi());\n862\t    let r = f(rapi());\n863\t    if c.ret != r.ret {\n864\t        panic!(\n865\t            \"{ctx}: return differs: C={} (err={},code={}) Rust={} (err={},code={})\",\n866\t            c.ret,\n867\t            is_error(c.ret),\n868\t            err_code(c.ret),\n869\t            r.ret,\n870\t            is_error(r.ret),\n871\t            err_code(r.ret)\n872\t        );\n873\t    }\n874\t    assert_bytes_eq(ctx, &c.bytes, &r.bytes);\n875\t}\n876\t"}]},"parent_tool_use_id":"toolu_bdrk_012PypEsJzKLuVi4g6Aphym4","session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"31e77a41-13bb-4bff-9b66-1821dc71365f","timestamp":"2026-08-14T21:34:10.181Z","subagent_type":"general-purpose","task_description":"Write dict and entropy tests"}
