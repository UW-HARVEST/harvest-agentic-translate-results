{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_rrjy75vufkhlvnty5wsrhofxvwosdiqua2zrfft2yhx7ygbjylcq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016v8TmQoANgYrfbTteAjJ9H","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/phase_b_params.rs","content":"//! Phase B — CONFIGS.md rows 1-57: the compression parameter surface and the\n//! full block-compressor dispatch matrix (strategy x dictMode x rowMatchFinder).\n//!\n//! Everything goes through `ZSTD_compress2`, `ZSTD_CCtx_setParameter` and the\n//! dictionary entry points on BOTH `.so` files; compressed output must be\n//! byte-identical, and each frame must round-trip through both decoders.\nmod common;\nuse common::*;\nuse std::ffi::c_void;\n\n/// How the dictionary/prefix is attached for a given run.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Dict<'a> {\n    None,\n    /// ZSTD_CCtx_loadDictionary -> ZSTD_dictMatchState (or dedicatedDictSearch)\n    Load(&'a [u8]),\n    /// ZSTD_CCtx_refPrefix -> ZSTD_extDict when deterministicRefPrefix is set\n    Prefix(&'a [u8]),\n    /// ZSTD_CCtx_refCDict at the given level\n    CDict(&'a [u8], i32),\n}\n\n#[derive(Clone, Debug)]\npub struct Cfg<'a> {\n    pub params: Vec<(i32, i32)>,\n    pub dict: Dict<'a>,\n    pub pledged: Option<u64>,\n    pub src: &'a [u8],\n}\n\n/// Drive one compression through `api`, returning ret + bytes.\nfn compress_cfg(api: &Api, cfg: &Cfg) -> Out {\n    unsafe {\n        let cctx = (api.createCCtx)();\n        assert!(!cctx.is_null(), \"{}: createCCtx\", api.tag);\n        let mut first_err = 0usize;\n\n        for &(p, v) in &cfg.params {\n            let r = (api.setParameter)(cctx, p, v);\n            if is_error(r) && first_err == 0 {\n                first_err = r;\n            }\n        }\n        if first_err != 0 {\n            (api.freeCCtx)(cctx);\n            return Out::err(first_err);\n        }\n\n        // A CDict must outlive the compression call.\n        let mut cdict = std::ptr::null_mut();\n        match cfg.dict {\n            Dict::None => {}\n            Dict::Load(d) => {\n                let r = (api.loadDictionary)(cctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeCCtx)(cctx);\n                    return Out::err(r);\n                }\n            }\n            Dict::Prefix(d) => {\n                let r = (api.refPrefix)(cctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeCCtx)(cctx);\n                    return Out::err(r);\n                }\n            }\n            Dict::CDict(d, lvl) => {\n                cdict = (api.createCDict)(d.as_ptr() as *const c_void, d.len(), lvl);\n                assert!(!cdict.is_null(), \"{}: createCDict\", api.tag);\n                let r = (api.refCDict)(cctx, cdict);\n                if is_error(r) {\n                    (api.freeCDict)(cdict);\n                    (api.freeCCtx)(cctx);\n                    return Out::err(r);\n                }\n            }\n        }\n\n        if let Some(p) = cfg.pledged {\n            let r = (api.setPledgedSrcSize)(cctx, p);\n            if is_error(r) {\n                if !cdict.is_null() {\n                    (api.freeCDict)(cdict);\n                }\n                (api.freeCCtx)(cctx);\n                return Out::err(r);\n            }\n        }\n\n        let cap = (api.compressBound)(cfg.src.len()) + 64;\n        let mut buf = vec![0u8; cap];\n        let ret = (api.compress2)(\n            cctx,\n            buf.as_mut_ptr() as *mut c_void,\n            cap,\n            cfg.src.as_ptr() as *const c_void,\n            cfg.src.len(),\n        );\n        if !cdict.is_null() {\n            (api.freeCDict)(cdict);\n        }\n        (api.freeCCtx)(cctx);\n        Out::ok(ret, &buf)\n    }\n}\n\n/// Decompress `frame` through `api` (with optional dict), returning ret + bytes.\nfn decompress_cfg(api: &Api, frame: &[u8], dict: Dict, expect: usize) -> Out {\n    unsafe {\n        let dctx = (api.createDCtx)();\n        assert!(!dctx.is_null());\n        match dict {\n            Dict::None => {}\n            Dict::Load(d) | Dict::CDict(d, _) => {\n                let r = (api.dLoadDictionary)(dctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeDCtx)(dctx);\n                    return Out::err(r);\n                }\n            }\n            Dict::Prefix(d) => {\n                let r = (api.dRefPrefix)(dctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeDCtx)(dctx);\n                    return Out::err(r);\n                }\n            }\n        }\n        let mut out = vec![0u8; expect + 1024];\n        let ret = (api.decompressDCtx)(\n            dctx,\n            out.as_mut_ptr() as *mut c_void,\n            out.len(),\n            frame.as_ptr() as *const c_void,\n            frame.len(),\n        );\n        (api.freeDCtx)(dctx);\n        Out::ok(ret, &out)\n    }\n}\n\n/// Full differential check for one configuration: identical compressed bytes\n/// from both libs, and identical decompressed bytes from both decoders, which\n/// must equal the original input.\nfn check(ctx: &str, cfg: &Cfg) {\n    let c = compress_cfg(capi(), cfg);\n    let r = compress_cfg(rapi(), cfg);\n    if c.ret != r.ret {\n        panic!(\n            \"{ctx}: compress ret differs: C={} (code={}) Rust={} (code={})\",\n            c.ret,\n            err_code(c.ret),\n            r.ret,\n            err_code(r.ret)\n        );\n    }\n    assert_bytes_eq(&format!(\"{ctx} [compressed bytes]\"), &c.bytes, &r.bytes);\n    if is_error(c.ret) {\n        return;\n    }\n\n    let dc = decompress_cfg(capi(), &c.bytes, cfg.dict, cfg.src.len());\n    let dr = decompress_cfg(rapi(), &c.bytes, cfg.dict, cfg.src.len());\n    if dc.ret != dr.ret {\n        panic!(\n            \"{ctx}: decompress ret differs: C={} (code={}) Rust={} (code={})\",\n            dc.ret,\n            err_code(dc.ret),\n            dr.ret,\n            err_code(dr.ret)\n        );\n    }\n    assert_bytes_eq(&format!(\"{ctx} [decompressed bytes]\"), &dc.bytes, &dr.bytes);\n    assert_bytes_eq(&format!(\"{ctx} [roundtrip vs original]\"), cfg.src, &dc.bytes);\n}\n\n/// Train a dictionary with the C library (ground truth) so both sides get the\n/// identical dictionary bytes.\nfn make_dict(rng: &mut Rng, cap: usize) -> Vec<u8> {\n    let (samples, sizes) = gen_samples(Shape::Text, 96, 512, 2048, rng);\n    let f: libloading::Symbol<\n        unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, *const usize, u32) -> usize,\n    > = sym(c_lib(), \"ZDICT_trainFromBuffer\");\n    let mut d = vec![0u8; cap];\n    let n = unsafe {\n        f(\n            d.as_mut_ptr() as *mut c_void,\n            cap,\n            samples.as_ptr() as *const c_void,\n            sizes.as_ptr(),\n            sizes.len() as u32,\n        )\n    };\n    assert!(!is_error(n), \"ZDICT_trainFromBuffer failed: {}\", err_name(c_lib(), n));\n    d.truncate(n);\n    d\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 1-12 + 16: the full strategy x dictMode dispatch matrix.\n// ---------------------------------------------------------------------------\n\n#[test]\nfn rows_1_12_strategy_x_dictmode_dispatch_matrix() {\n    let mut rng = Rng::new(0xD15_PA7C4);\n    let dict = make_dict(&mut rng, 32 * 1024);\n    // 200 KB so windowLog > 14 and the row-matchfinder \"auto\" path turns on.\n    let src = gen(Shape::Text, 200_000, &mut rng);\n    let prefix = gen(Shape::Text, 40_000, &mut rng);\n\n    for &strat in ALL_STRATEGIES {\n        // row=disable / enable / auto — only greedy|lazy|lazy2 honour it, but\n        // setting it on the others must still be accepted and inert.\n        for &row in &[0i32, 1, 2] {\n            let base = vec![\n                (ZSTD_c_strategy, strat),\n                (ZSTD_c_useRowMatchFinder, row),\n                // keep btopt/btultra2 from re-splitting so the compressor under\n                // test is the one we selected\n                (ZSTD_c_splitAfterSequences, 2),\n            ];\n\n            // noDict\n            check(\n                &format!(\"row1-12 noDict strat={strat} row={row}\"),\n                &Cfg { params: base.clone(), dict: Dict::None, pledged: None, src: &src },\n            );\n\n            // extDict: refPrefix + deterministicRefPrefix=1 is the deterministic\n            // way to reach the *_extDict compressors.\n            let mut p = base.clone();\n            p.push((ZSTD_c_deterministicRefPrefix, 1));\n            check(\n                &format!(\"row1-12 extDict strat={strat} row={row}\"),\n                &Cfg { params: p, dict: Dict::Prefix(&prefix), pledged: None, src: &src },\n            );\n\n            // dictMatchState via loadDictionary\n            check(\n                &format!(\"row1-12 dictMatchState strat={strat} row={row}\"),\n                &Cfg {\n                    params: base.clone(),\n                    dict: Dict::Load(&dict),\n                    pledged: None,\n                    src: &src,\n                },\n            );\n\n            // dedicatedDictSearch (only greedy/lazy/lazy2 have these variants;\n            // for others the flag is accepted and ignored)\n            let mut p = base.clone();\n            p.push((ZSTD_c_enableDedicatedDictSearch, 1));\n            p.push((ZSTD_c_forceAttachDict, 3)); // ZSTD_dictForceLoad\n            check(\n                &format!(\"row1-12 dedicatedDictSearch strat={strat} row={row}\"),\n                &Cfg { params: p, dict: Dict::Load(&dict), pledged: None, src: &src },\n            );\n\n            // CDict attach path (row 16: CDict's useRowMatchFinder overrides CCtx's)\n            for &attach in &[0i32, 1, 2, 3] {\n                let mut p = base.clone();\n                p.push((ZSTD_c_forceAttachDict, attach));\n                check(\n                    &format!(\"row16 cdict strat={strat} row={row} attach={attach}\"),\n                    &Cfg { params: p, dict: Dict::CDict(&dict, 5), pledged: None, src: &src },\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 13-15: row-match-finder resolution boundary (windowLog > 14).\n// ---------------------------------------------------------------------------\n\n#[test]\nfn rows_13_15_row_matchfinder_resolution() {\n    let mut rng = Rng::new(0x120W_5EED);\n    let small = gen(Shape::Text, 8 * 1024, &mut rng);\n    let big = gen(Shape::Text, 200_000, &mut rng);\n\n    // row 13: level 5 on 8 KB (tableID 3, windowLog 14, auto -> OFF) vs on 200 KB.\n    for (name, src) in [(\"8K\", &small), (\"200K\", &big)] {\n        check(\n            &format!(\"row13 auto level5 {name}\"),\n            &Cfg {\n                params: vec![(ZSTD_c_compressionLevel, 5)],\n                dict: Dict::None,\n                pledged: None,\n                src,\n            },\n        );\n    }\n\n    // row 14: the windowLog == 14 vs 15 boundary under auto.\n    for wlog in [10i32, 13, 14, 15, 16, 20] {\n        check(\n            &format!(\"row14 auto windowLog={wlog}\"),\n            &Cfg {\n                params: vec![\n                    (ZSTD_c_strategy, 5),\n                    (ZSTD_c_useRowMatchFinder, 0),\n                    (ZSTD_c_windowLog, wlog),\n                ],\n                dict: Dict::None,\n                pledged: None,\n                src: &big,\n            },\n        );\n    }\n\n    // row 15: rowLog = BOUNDED(4, searchLog, 6) -> 16/32/64-entry rows.\n    for slog in [1i32, 2, 3, 4, 5, 6, 7, 10] {\n        check(\n            &format!(\"row15 row=E searchLog={slog}\"),\n            &Cfg {\n                params: vec![\n                    (ZSTD_c_strategy, 5),\n                    (ZSTD_c_useRowMatchFinder, 1),\n                    (ZSTD_c_searchLog, slog),\n                ],\n                dict: Dict::None,\n                pledged: None,\n                src: &big,\n            },\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 17-28: compression levels and the srcSize-dependent cParam table.\n// ---------------------------------------------------------------------------\n\n#[test]\nfn rows_17_28_levels_and_cparam_tables() {\n    let mut rng = Rng::new(0x1EVE_15);\n\n    // Every level from min..max is a lot; sweep the whole positive range plus a\n    // representative set of negatives (which map to row 0 with targetLength).\n    let mut levels: Vec<i32> = (1..=22).collect();\n    levels.extend_from_slice(&[0, -1, -2, -5, -10, -50, -100, -1000, -131072, -131073]);\n\n    // The four clevel row-sets are picked by srcSize:\n    //   tableID = (rSize<=256K) + (rSize<=128K) + (rSize<=16K)\n    let sizes = [1usize, 8 * 1024, 16 * 1024, 16 * 1024 + 1, 128 * 1024, 130_000, 300_000];\n\n    for &lvl in &levels {\n        for &n in &sizes {\n            let src = gen(Shape::Text, n, &mut rng);\n            check(\n                &format!(\"row17-28 level={lvl} srcSize={n}\"),\n                &Cfg {\n                    params: vec![(ZSTD_c_compressionLevel, lvl)],\n                    dict: Dict::None,\n                    pledged: None,\n                    src: &src,\n                },\n            );\n        }\n    }\n}\n\n#[test]\nfn rows_17_28_getcparams_getparams_adjust_check() {\n    // These are pure functions of (level, srcSizeHint, dictSize) — sweep hard,\n    // including the ZSTD_CONTENTSIZE_UNKNOWN wraparound quirk.\n    let mut rng = Rng::new(0xCPAR);\n    let mut srcsizes: Vec<u64> = vec![\n        0,\n        1,\n        1024,\n        16 * 1024,\n        16 * 1024 + 1,\n        128 * 1024,\n        256 * 1024,\n        256 * 1024 + 1,\n        1 << 30,\n        ZSTD_CONTENTSIZE_UNKNOWN,\n        ZSTD_CONTENTSIZE_UNKNOWN - 1,\n        u64::MAX / 2,\n    ];\n    let mut dictsizes: Vec<usize> = vec![0, 1, 8, 256, 1024, 32 * 1024, 1 << 20];\n    for _ in 0..40 {\n        srcsizes.push(rng.next_u64() % (1 << 24));\n        dictsizes.push(rng.below(1 << 20));\n    }\n\n    for lvl in [-131072i32, -1000, -10, -1, 0, 1, 3, 9, 12, 19, 22, 23, 100] {\n        for &ss in &srcsizes {\n            for &ds in &dictsizes {\n                let ctx = format!(\"getCParams({lvl},{ss},{ds})\");\n                diff(&ctx, |a| unsafe { (a.getCParams)(lvl, ss, ds) });\n                let ctx = format!(\"getParams({lvl},{ss},{ds})\");\n                diff(&ctx, |a| unsafe { (a.getParams)(lvl, ss, ds) });\n            }\n        }\n    }\n\n    // checkCParams / adjustCParams over both valid and out-of-range cParams.\n    let mut cps: Vec<ZSTD_compressionParameters> = Vec::new();\n    for lvl in [1i32, 3, 9, 19, 22] {\n        cps.push(unsafe { (capi().getCParams)(lvl, 100_000, 0) });\n    }\n    for _ in 0..300 {\n        cps.push(ZSTD_compressionParameters {\n            windowLog: rng.range(0, 35) as u32,\n            chainLog: rng.range(0, 35) as u32,\n            hashLog: rng.range(0, 35) as u32,\n            searchLog: rng.range(0, 35) as u32,\n            minMatch: rng.range(0, 10) as u32,\n            targetLength: rng.range(0, 200_000) as u32,\n            strategy: rng.range(0, 12) as i32,\n        });\n    }\n    for cp in cps {\n        diff(&format!(\"checkCParams({cp:?})\"), |a| unsafe { (a.checkCParams)(cp) });\n        for ss in [0u64, 1, 1024, 1 << 20, ZSTD_CONTENTSIZE_UNKNOWN] {\n            for ds in [0usize, 1024, 1 << 20] {\n                diff(&format!(\"adjustCParams({cp:?},{ss},{ds})\"), |a| unsafe {\n                    (a.adjustCParams)(cp, ss, ds)\n                });\n            }\n        }\n    }\n\n    // ZSTD_cycleLog(hashLog, strategy) for every strategy incl. invalid ones.\n    for hl in 0u32..=32 {\n        for st in -2i32..=12 {\n            diff(&format!(\"cycleLog({hl},{st})\"), |a| unsafe { (a.cycleLog)(hl, st) });\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 29-57: every runtime parameter, swept over its distinct values.\n// ---------------------------------------------------------------------------\n\n/// Interesting values per parameter: the bounds, just inside, and defaults.\nfn param_values(p: i32, b: ZSTD_bounds) -> Vec<i32> {\n    let mut v = vec![b.lowerBound, b.upperBound];\n    if b.upperBound > b.lowerBound {\n        v.push(b.lowerBound + 1);\n        v.push(b.upperBound - 1);\n        v.push(b.lowerBound + (b.upperBound - b.lowerBound) / 2);\n    }\n    v.push(0); // \"use default\" for many params\n    // parameters where specific mid values matter\n    match p {\n        ZSTD_c_minMatch => v.extend_from_slice(&[3, 4, 5, 6, 7]),\n        ZSTD_c_strategy => v.extend_from_slice(ALL_STRATEGIES),\n        ZSTD_c_targetCBlockSize => v.extend_from_slice(&[1340, 2048, 65536]),\n        ZSTD_c_maxBlockSize => v.extend_from_slice(&[1024, 4096, 65536, 131072]),\n        ZSTD_c_windowLog => v.extend_from_slice(&[10, 14, 15, 17, 20]),\n        ZSTD_c_srcSizeHint => v.extend_from_slice(&[1, 1024, 100_000]),\n        _ => {}\n    }\n    v.sort_unstable();\n    v.dedup();\n    v\n}\n\n#[test]\nfn rows_29_57_every_parameter_swept_over_its_range() {\n    let mut rng = Rng::new(0xPARAM_5W);\n    let bounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_cParam_getBounds\");\n    let dict = make_dict(&mut rng, 16 * 1024);\n    // Two shapes: text (matches+literals) and long-range (for LDM params).\n    let text = gen(Shape::Text, 150_000, &mut rng);\n    let lr = gen(Shape::LongRange, 300_000, &mut rng);\n\n    for &p in ALL_CPARAMS {\n        let b = unsafe { bounds(p) };\n        assert_eq!(b.error, 0, \"param {p} unexpectedly unsupported\");\n        for v in param_values(p, b) {\n            for (sname, src) in [(\"text\", &text), (\"longrange\", &lr)] {\n                // plain\n                check(\n                    &format!(\"row29-57 param={p} value={v} src={sname}\"),\n                    &Cfg {\n                        params: vec![(p, v)],\n                        dict: Dict::None,\n                        pledged: None,\n                        src,\n                    },\n                );\n            }\n        }\n    }\n\n    // The same sweep but with a dictionary attached, since many parameters\n    // interact with dictionary loading.\n    for &p in ALL_CPARAMS {\n        let b = unsafe { bounds(p) };\n        for v in param_values(p, b) {\n            check(\n                &format!(\"row29-57 param={p} value={v} +dict\"),\n                &Cfg {\n                    params: vec![(p, v)],\n                    dict: Dict::Load(&dict),\n                    pledged: None,\n                    src: &text,\n                },\n            );\n        }\n    }\n}\n\n#[test]\nfn rows_29_57_ldm_parameter_combinations() {\n    // LDM has five interacting parameters; exercise their cross-product on\n    // data that actually contains long-distance matches.\n    let mut rng = Rng::new(0x1DM_5EED);\n    let lr = gen(Shape::LongRange, 400_000, &mut rng);\n    for &enable in &[0i32, 1, 2] {\n        for &hashlog in &[0i32, 6, 16, 20] {\n            for &minmatch in &[0i32, 4, 32, 4096] {\n                for &bucket in &[0i32, 1, 4, 8] {\n                    for &rate in &[0i32, 1, 7, 25] {\n                        check(\n                            &format!(\n                                \"ldm enable={enable} hashLog={hashlog} minMatch={minmatch} bucket={bucket} rate={rate}\"\n                            ),\n                            &Cfg {\n                                params: vec![\n                                    (ZSTD_c_enableLongDistanceMatching, enable),\n                                    (ZSTD_c_ldmHashLog, hashlog),\n                                    (ZSTD_c_ldmMinMatch, minmatch),\n                                    (ZSTD_c_ldmBucketSizeLog, bucket),\n                                    (ZSTD_c_ldmHashRateLog, rate),\n                                    (ZSTD_c_windowLog, 20),\n                                ],\n                                dict: Dict::None,\n                                pledged: None,\n                                src: &lr,\n                            },\n                        );\n                    }\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn rows_29_57_frame_flags_and_format() {\n    // contentSizeFlag / checksumFlag / dictIDFlag / format cross-product, with\n    // and without a dictionary and with and without a pledged size — these\n    // control the frame header layout directly.\n    let mut rng = Rng::new(0xF14G5);\n    let dict = make_dict(&mut rng, 8 * 1024);\n    let src = gen(Shape::Text, 50_000, &mut rng);\n    for &cs in &[0i32, 1] {\n        for &ck in &[0i32, 1] {\n            for &di in &[0i32, 1] {\n                for &fmt in &[0i32, 1] {\n                    for pledged in [None, Some(src.len() as u64), Some(ZSTD_CONTENTSIZE_UNKNOWN)] {\n                        for d in [Dict::None, Dict::Load(&dict)] {\n                            check(\n                                &format!(\n                                    \"flags cs={cs} ck={ck} dictID={di} format={fmt} pledged={pledged:?} dict={}\",\n                                    matches!(d, Dict::Load(_))\n                                ),\n                                &Cfg {\n                                    params: vec![\n                                        (ZSTD_c_contentSizeFlag, cs),\n                                        (ZSTD_c_checksumFlag, ck),\n                                        (ZSTD_c_dictIDFlag, di),\n                                        (ZSTD_c_format, fmt),\n                                    ],\n                                    dict: d,\n                                    pledged,\n                                    src: &src,\n                                },\n                            );\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn rows_29_57_randomized_parameter_soup() {\n    // Property-style: random VALID combinations of many parameters at once, on\n    // random shapes and sizes. This is where interaction bugs live.\n    let mut rng = Rng::new(0x5OUP_2024);\n    let bounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_cParam_getBounds\");\n    let dict = make_dict(&mut rng, 16 * 1024);\n    let prefix = gen(Shape::Text, 20_000, &mut rng);\n\n    for iter in 0..400 {\n        let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n        let len = match rng.below(6) {\n            0 => rng.below(64),\n            1 => rng.range(64, 4096),\n            2 => rng.range(4096, 100_000),\n            3 => rng.range(ZSTD_BLOCKSIZE_MAX - 4, ZSTD_BLOCKSIZE_MAX + 4),\n            4 => rng.range(100_000, 300_000),\n            _ => rng.range(0, 8),\n        };\n        let src = gen(shape, len, &mut rng);\n\n        let mut params = Vec::new();\n        let nb = rng.range(1, 8);\n        for _ in 0..nb {\n            let p = ALL_CPARAMS[rng.below(ALL_CPARAMS.len())];\n            let b = unsafe { bounds(p) };\n            let v = if b.upperBound == b.lowerBound {\n                b.lowerBound\n            } else {\n                // stay in-range: this test is about valid configurations\n                b.lowerBound + rng.below((b.upperBound - b.lowerBound + 1) as usize) as i32\n            };\n            params.push((p, v));\n        }\n\n        let d = match rng.below(4) {\n            0 => Dict::None,\n            1 => Dict::Load(&dict),\n            2 => Dict::Prefix(&prefix),\n            _ => Dict::CDict(&dict, rng.range(1, 12) as i32),\n        };\n        let pledged = match rng.below(3) {\n            0 => None,\n            1 => Some(src.len() as u64),\n            _ => Some(ZSTD_CONTENTSIZE_UNKNOWN),\n        };\n\n        check(\n            &format!(\"soup iter={iter} shape={shape:?} len={len} params={params:?} dict={d:?} pledged={pledged:?}\"),\n            &Cfg { params, dict: d, pledged, src: &src },\n        );\n    }\n}\n\n#[test]\nfn getparameter_roundtrips_match() {\n    // ZSTD_CCtx_getParameter must report the same stored value in both libs,\n    // including after clamping and after reset.\n    let bounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_cParam_getBounds\");\n    for &p in ALL_CPARAMS {\n        let b = unsafe { bounds(p) };\n        let mut vals = param_values(p, b);\n        // include out-of-range values: some params clamp, most reject\n        vals.extend_from_slice(&[b.lowerBound - 1, b.upperBound + 1, i32::MIN, i32::MAX]);\n        for v in vals {\n            diff(&format!(\"setParameter+getParameter p={p} v={v}\"), |a| unsafe {\n                let cctx = (a.createCCtx)();\n                let set = (a.setParameter)(cctx, p, v);\n                let mut got = 0i32;\n                let get = (a.getParameter)(cctx, p, &mut got);\n                // and again after a session-only reset (params must survive)\n                let rst = (a.cctxReset)(cctx, ZSTD_reset_session_only);\n                let mut got2 = 0i32;\n                let get2 = (a.getParameter)(cctx, p, &mut got2);\n                // and after a full parameter reset (params must go to default)\n                let rst2 = (a.cctxReset)(cctx, ZSTD_reset_parameters);\n                let mut got3 = 0i32;\n                let get3 = (a.getParameter)(cctx, p, &mut got3);\n                (a.freeCCtx)(cctx);\n                (set, got, get, rst, got2, get2, rst2, got3, get3)\n            });\n        }\n    }\n\n    // Same for the decompression side.\n    let dbounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_dParam_getBounds\");\n    for &p in ALL_DPARAMS {\n        let b = unsafe { dbounds(p) };\n        let mut vals = param_values(p, b);\n        vals.extend_from_slice(&[b.lowerBound - 1, b.upperBound + 1, i32::MIN, i32::MAX]);\n        for v in vals {\n            diff(&format!(\"dSetParameter+dGetParameter p={p} v={v}\"), |a| unsafe {\n                let dctx = (a.createDCtx)();\n                let set = (a.dSetParameter)(dctx, p, v);\n                let mut got = 0i32;\n                let get = (a.dGetParameter)(dctx, p, &mut got);\n                let rst = (a.dctxReset)(dctx, ZSTD_reset_session_and_parameters);\n                let mut got2 = 0i32;\n                let get2 = (a.dGetParameter)(dctx, p, &mut got2);\n                (a.freeDCtx)(dctx);\n                (set, got, get, rst, got2, get2)\n            });\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12944,"cache_read_input_tokens":121367,"cache_creation":{"ephemeral_5m_input_tokens":12944,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"0bb7f49c-ee2a-441d-a9a7-6e33ad54a634","timestamp":"2026-08-14T21:20:08.440Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016v8TmQoANgYrfbTteAjJ9H","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/phase_b_params.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"8ad20387-9f21-458b-aa4e-3c9b04c49665","timestamp":"2026-08-14T21:20:08.448Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/phase_b_params.rs","content":"//! Phase B — CONFIGS.md rows 1-57: the compression parameter surface and the\n//! full block-compressor dispatch matrix (strategy x dictMode x rowMatchFinder).\n//!\n//! Everything goes through `ZSTD_compress2`, `ZSTD_CCtx_setParameter` and the\n//! dictionary entry points on BOTH `.so` files; compressed output must be\n//! byte-identical, and each frame must round-trip through both decoders.\nmod common;\nuse common::*;\nuse std::ffi::c_void;\n\n/// How the dictionary/prefix is attached for a given run.\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\npub enum Dict<'a> {\n    None,\n    /// ZSTD_CCtx_loadDictionary -> ZSTD_dictMatchState (or dedicatedDictSearch)\n    Load(&'a [u8]),\n    /// ZSTD_CCtx_refPrefix -> ZSTD_extDict when deterministicRefPrefix is set\n    Prefix(&'a [u8]),\n    /// ZSTD_CCtx_refCDict at the given level\n    CDict(&'a [u8], i32),\n}\n\n#[derive(Clone, Debug)]\npub struct Cfg<'a> {\n    pub params: Vec<(i32, i32)>,\n    pub dict: Dict<'a>,\n    pub pledged: Option<u64>,\n    pub src: &'a [u8],\n}\n\n/// Drive one compression through `api`, returning ret + bytes.\nfn compress_cfg(api: &Api, cfg: &Cfg) -> Out {\n    unsafe {\n        let cctx = (api.createCCtx)();\n        assert!(!cctx.is_null(), \"{}: createCCtx\", api.tag);\n        let mut first_err = 0usize;\n\n        for &(p, v) in &cfg.params {\n            let r = (api.setParameter)(cctx, p, v);\n            if is_error(r) && first_err == 0 {\n                first_err = r;\n            }\n        }\n        if first_err != 0 {\n            (api.freeCCtx)(cctx);\n            return Out::err(first_err);\n        }\n\n        // A CDict must outlive the compression call.\n        let mut cdict = std::ptr::null_mut();\n        match cfg.dict {\n            Dict::None => {}\n            Dict::Load(d) => {\n                let r = (api.loadDictionary)(cctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeCCtx)(cctx);\n                    return Out::err(r);\n                }\n            }\n            Dict::Prefix(d) => {\n                let r = (api.refPrefix)(cctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeCCtx)(cctx);\n                    return Out::err(r);\n                }\n            }\n            Dict::CDict(d, lvl) => {\n                cdict = (api.createCDict)(d.as_ptr() as *const c_void, d.len(), lvl);\n                assert!(!cdict.is_null(), \"{}: createCDict\", api.tag);\n                let r = (api.refCDict)(cctx, cdict);\n                if is_error(r) {\n                    (api.freeCDict)(cdict);\n                    (api.freeCCtx)(cctx);\n                    return Out::err(r);\n                }\n            }\n        }\n\n        if let Some(p) = cfg.pledged {\n            let r = (api.setPledgedSrcSize)(cctx, p);\n            if is_error(r) {\n                if !cdict.is_null() {\n                    (api.freeCDict)(cdict);\n                }\n                (api.freeCCtx)(cctx);\n                return Out::err(r);\n            }\n        }\n\n        let cap = (api.compressBound)(cfg.src.len()) + 64;\n        let mut buf = vec![0u8; cap];\n        let ret = (api.compress2)(\n            cctx,\n            buf.as_mut_ptr() as *mut c_void,\n            cap,\n            cfg.src.as_ptr() as *const c_void,\n            cfg.src.len(),\n        );\n        if !cdict.is_null() {\n            (api.freeCDict)(cdict);\n        }\n        (api.freeCCtx)(cctx);\n        Out::ok(ret, &buf)\n    }\n}\n\n/// Decompress `frame` through `api` (with optional dict), returning ret + bytes.\nfn decompress_cfg(api: &Api, frame: &[u8], dict: Dict, expect: usize) -> Out {\n    unsafe {\n        let dctx = (api.createDCtx)();\n        assert!(!dctx.is_null());\n        match dict {\n            Dict::None => {}\n            Dict::Load(d) | Dict::CDict(d, _) => {\n                let r = (api.dLoadDictionary)(dctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeDCtx)(dctx);\n                    return Out::err(r);\n                }\n            }\n            Dict::Prefix(d) => {\n                let r = (api.dRefPrefix)(dctx, d.as_ptr() as *const c_void, d.len());\n                if is_error(r) {\n                    (api.freeDCtx)(dctx);\n                    return Out::err(r);\n                }\n            }\n        }\n        let mut out = vec![0u8; expect + 1024];\n        let ret = (api.decompressDCtx)(\n            dctx,\n            out.as_mut_ptr() as *mut c_void,\n            out.len(),\n            frame.as_ptr() as *const c_void,\n            frame.len(),\n        );\n        (api.freeDCtx)(dctx);\n        Out::ok(ret, &out)\n    }\n}\n\n/// Full differential check for one configuration: identical compressed bytes\n/// from both libs, and identical decompressed bytes from both decoders, which\n/// must equal the original input.\nfn check(ctx: &str, cfg: &Cfg) {\n    let c = compress_cfg(capi(), cfg);\n    let r = compress_cfg(rapi(), cfg);\n    if c.ret != r.ret {\n        panic!(\n            \"{ctx}: compress ret differs: C={} (code={}) Rust={} (code={})\",\n            c.ret,\n            err_code(c.ret),\n            r.ret,\n            err_code(r.ret)\n        );\n    }\n    assert_bytes_eq(&format!(\"{ctx} [compressed bytes]\"), &c.bytes, &r.bytes);\n    if is_error(c.ret) {\n        return;\n    }\n\n    let dc = decompress_cfg(capi(), &c.bytes, cfg.dict, cfg.src.len());\n    let dr = decompress_cfg(rapi(), &c.bytes, cfg.dict, cfg.src.len());\n    if dc.ret != dr.ret {\n        panic!(\n            \"{ctx}: decompress ret differs: C={} (code={}) Rust={} (code={})\",\n            dc.ret,\n            err_code(dc.ret),\n            dr.ret,\n            err_code(dr.ret)\n        );\n    }\n    assert_bytes_eq(&format!(\"{ctx} [decompressed bytes]\"), &dc.bytes, &dr.bytes);\n    assert_bytes_eq(&format!(\"{ctx} [roundtrip vs original]\"), cfg.src, &dc.bytes);\n}\n\n/// Train a dictionary with the C library (ground truth) so both sides get the\n/// identical dictionary bytes.\nfn make_dict(rng: &mut Rng, cap: usize) -> Vec<u8> {\n    let (samples, sizes) = gen_samples(Shape::Text, 96, 512, 2048, rng);\n    let f: libloading::Symbol<\n        unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, *const usize, u32) -> usize,\n    > = sym(c_lib(), \"ZDICT_trainFromBuffer\");\n    let mut d = vec![0u8; cap];\n    let n = unsafe {\n        f(\n            d.as_mut_ptr() as *mut c_void,\n            cap,\n            samples.as_ptr() as *const c_void,\n            sizes.as_ptr(),\n            sizes.len() as u32,\n        )\n    };\n    assert!(!is_error(n), \"ZDICT_trainFromBuffer failed: {}\", err_name(c_lib(), n));\n    d.truncate(n);\n    d\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 1-12 + 16: the full strategy x dictMode dispatch matrix.\n// ---------------------------------------------------------------------------\n\n#[test]\nfn rows_1_12_strategy_x_dictmode_dispatch_matrix() {\n    let mut rng = Rng::new(0xD15_PA7C4);\n    let dict = make_dict(&mut rng, 32 * 1024);\n    // 200 KB so windowLog > 14 and the row-matchfinder \"auto\" path turns on.\n    let src = gen(Shape::Text, 200_000, &mut rng);\n    let prefix = gen(Shape::Text, 40_000, &mut rng);\n\n    for &strat in ALL_STRATEGIES {\n        // row=disable / enable / auto — only greedy|lazy|lazy2 honour it, but\n        // setting it on the others must still be accepted and inert.\n        for &row in &[0i32, 1, 2] {\n            let base = vec![\n                (ZSTD_c_strategy, strat),\n                (ZSTD_c_useRowMatchFinder, row),\n                // keep btopt/btultra2 from re-splitting so the compressor under\n                // test is the one we selected\n                (ZSTD_c_splitAfterSequences, 2),\n            ];\n\n            // noDict\n            check(\n                &format!(\"row1-12 noDict strat={strat} row={row}\"),\n                &Cfg { params: base.clone(), dict: Dict::None, pledged: None, src: &src },\n            );\n\n            // extDict: refPrefix + deterministicRefPrefix=1 is the deterministic\n            // way to reach the *_extDict compressors.\n            let mut p = base.clone();\n            p.push((ZSTD_c_deterministicRefPrefix, 1));\n            check(\n                &format!(\"row1-12 extDict strat={strat} row={row}\"),\n                &Cfg { params: p, dict: Dict::Prefix(&prefix), pledged: None, src: &src },\n            );\n\n            // dictMatchState via loadDictionary\n            check(\n                &format!(\"row1-12 dictMatchState strat={strat} row={row}\"),\n                &Cfg {\n                    params: base.clone(),\n                    dict: Dict::Load(&dict),\n                    pledged: None,\n                    src: &src,\n                },\n            );\n\n            // dedicatedDictSearch (only greedy/lazy/lazy2 have these variants;\n            // for others the flag is accepted and ignored)\n            let mut p = base.clone();\n            p.push((ZSTD_c_enableDedicatedDictSearch, 1));\n            p.push((ZSTD_c_forceAttachDict, 3)); // ZSTD_dictForceLoad\n            check(\n                &format!(\"row1-12 dedicatedDictSearch strat={strat} row={row}\"),\n                &Cfg { params: p, dict: Dict::Load(&dict), pledged: None, src: &src },\n            );\n\n            // CDict attach path (row 16: CDict's useRowMatchFinder overrides CCtx's)\n            for &attach in &[0i32, 1, 2, 3] {\n                let mut p = base.clone();\n                p.push((ZSTD_c_forceAttachDict, attach));\n                check(\n                    &format!(\"row16 cdict strat={strat} row={row} attach={attach}\"),\n                    &Cfg { params: p, dict: Dict::CDict(&dict, 5), pledged: None, src: &src },\n                );\n            }\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 13-15: row-match-finder resolution boundary (windowLog > 14).\n// ---------------------------------------------------------------------------\n\n#[test]\nfn rows_13_15_row_matchfinder_resolution() {\n    let mut rng = Rng::new(0x120W_5EED);\n    let small = gen(Shape::Text, 8 * 1024, &mut rng);\n    let big = gen(Shape::Text, 200_000, &mut rng);\n\n    // row 13: level 5 on 8 KB (tableID 3, windowLog 14, auto -> OFF) vs on 200 KB.\n    for (name, src) in [(\"8K\", &small), (\"200K\", &big)] {\n        check(\n            &format!(\"row13 auto level5 {name}\"),\n            &Cfg {\n                params: vec![(ZSTD_c_compressionLevel, 5)],\n                dict: Dict::None,\n                pledged: None,\n                src,\n            },\n        );\n    }\n\n    // row 14: the windowLog == 14 vs 15 boundary under auto.\n    for wlog in [10i32, 13, 14, 15, 16, 20] {\n        check(\n            &format!(\"row14 auto windowLog={wlog}\"),\n            &Cfg {\n                params: vec![\n                    (ZSTD_c_strategy, 5),\n                    (ZSTD_c_useRowMatchFinder, 0),\n                    (ZSTD_c_windowLog, wlog),\n                ],\n                dict: Dict::None,\n                pledged: None,\n                src: &big,\n            },\n        );\n    }\n\n    // row 15: rowLog = BOUNDED(4, searchLog, 6) -> 16/32/64-entry rows.\n    for slog in [1i32, 2, 3, 4, 5, 6, 7, 10] {\n        check(\n            &format!(\"row15 row=E searchLog={slog}\"),\n            &Cfg {\n                params: vec![\n                    (ZSTD_c_strategy, 5),\n                    (ZSTD_c_useRowMatchFinder, 1),\n                    (ZSTD_c_searchLog, slog),\n                ],\n                dict: Dict::None,\n                pledged: None,\n                src: &big,\n            },\n        );\n    }\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 17-28: compression levels and the srcSize-dependent cParam table.\n// ---------------------------------------------------------------------------\n\n#[test]\nfn rows_17_28_levels_and_cparam_tables() {\n    let mut rng = Rng::new(0x1EVE_15);\n\n    // Every level from min..max is a lot; sweep the whole positive range plus a\n    // representative set of negatives (which map to row 0 with targetLength).\n    let mut levels: Vec<i32> = (1..=22).collect();\n    levels.extend_from_slice(&[0, -1, -2, -5, -10, -50, -100, -1000, -131072, -131073]);\n\n    // The four clevel row-sets are picked by srcSize:\n    //   tableID = (rSize<=256K) + (rSize<=128K) + (rSize<=16K)\n    let sizes = [1usize, 8 * 1024, 16 * 1024, 16 * 1024 + 1, 128 * 1024, 130_000, 300_000];\n\n    for &lvl in &levels {\n        for &n in &sizes {\n            let src = gen(Shape::Text, n, &mut rng);\n            check(\n                &format!(\"row17-28 level={lvl} srcSize={n}\"),\n                &Cfg {\n                    params: vec![(ZSTD_c_compressionLevel, lvl)],\n                    dict: Dict::None,\n                    pledged: None,\n                    src: &src,\n                },\n            );\n        }\n    }\n}\n\n#[test]\nfn rows_17_28_getcparams_getparams_adjust_check() {\n    // These are pure functions of (level, srcSizeHint, dictSize) — sweep hard,\n    // including the ZSTD_CONTENTSIZE_UNKNOWN wraparound quirk.\n    let mut rng = Rng::new(0xCPAR);\n    let mut srcsizes: Vec<u64> = vec![\n        0,\n        1,\n        1024,\n        16 * 1024,\n        16 * 1024 + 1,\n        128 * 1024,\n        256 * 1024,\n        256 * 1024 + 1,\n        1 << 30,\n        ZSTD_CONTENTSIZE_UNKNOWN,\n        ZSTD_CONTENTSIZE_UNKNOWN - 1,\n        u64::MAX / 2,\n    ];\n    let mut dictsizes: Vec<usize> = vec![0, 1, 8, 256, 1024, 32 * 1024, 1 << 20];\n    for _ in 0..40 {\n        srcsizes.push(rng.next_u64() % (1 << 24));\n        dictsizes.push(rng.below(1 << 20));\n    }\n\n    for lvl in [-131072i32, -1000, -10, -1, 0, 1, 3, 9, 12, 19, 22, 23, 100] {\n        for &ss in &srcsizes {\n            for &ds in &dictsizes {\n                let ctx = format!(\"getCParams({lvl},{ss},{ds})\");\n                diff(&ctx, |a| unsafe { (a.getCParams)(lvl, ss, ds) });\n                let ctx = format!(\"getParams({lvl},{ss},{ds})\");\n                diff(&ctx, |a| unsafe { (a.getParams)(lvl, ss, ds) });\n            }\n        }\n    }\n\n    // checkCParams / adjustCParams over both valid and out-of-range cParams.\n    let mut cps: Vec<ZSTD_compressionParameters> = Vec::new();\n    for lvl in [1i32, 3, 9, 19, 22] {\n        cps.push(unsafe { (capi().getCParams)(lvl, 100_000, 0) });\n    }\n    for _ in 0..300 {\n        cps.push(ZSTD_compressionParameters {\n            windowLog: rng.range(0, 35) as u32,\n            chainLog: rng.range(0, 35) as u32,\n            hashLog: rng.range(0, 35) as u32,\n            searchLog: rng.range(0, 35) as u32,\n            minMatch: rng.range(0, 10) as u32,\n            targetLength: rng.range(0, 200_000) as u32,\n            strategy: rng.range(0, 12) as i32,\n        });\n    }\n    for cp in cps {\n        diff(&format!(\"checkCParams({cp:?})\"), |a| unsafe { (a.checkCParams)(cp) });\n        for ss in [0u64, 1, 1024, 1 << 20, ZSTD_CONTENTSIZE_UNKNOWN] {\n            for ds in [0usize, 1024, 1 << 20] {\n                diff(&format!(\"adjustCParams({cp:?},{ss},{ds})\"), |a| unsafe {\n                    (a.adjustCParams)(cp, ss, ds)\n                });\n            }\n        }\n    }\n\n    // ZSTD_cycleLog(hashLog, strategy) for every strategy incl. invalid ones.\n    for hl in 0u32..=32 {\n        for st in -2i32..=12 {\n            diff(&format!(\"cycleLog({hl},{st})\"), |a| unsafe { (a.cycleLog)(hl, st) });\n        }\n    }\n}\n\n// ---------------------------------------------------------------------------\n// CONFIGS rows 29-57: every runtime parameter, swept over its distinct values.\n// ---------------------------------------------------------------------------\n\n/// Interesting values per parameter: the bounds, just inside, and defaults.\nfn param_values(p: i32, b: ZSTD_bounds) -> Vec<i32> {\n    let mut v = vec![b.lowerBound, b.upperBound];\n    if b.upperBound > b.lowerBound {\n        v.push(b.lowerBound + 1);\n        v.push(b.upperBound - 1);\n        v.push(b.lowerBound + (b.upperBound - b.lowerBound) / 2);\n    }\n    v.push(0); // \"use default\" for many params\n    // parameters where specific mid values matter\n    match p {\n        ZSTD_c_minMatch => v.extend_from_slice(&[3, 4, 5, 6, 7]),\n        ZSTD_c_strategy => v.extend_from_slice(ALL_STRATEGIES),\n        ZSTD_c_targetCBlockSize => v.extend_from_slice(&[1340, 2048, 65536]),\n        ZSTD_c_maxBlockSize => v.extend_from_slice(&[1024, 4096, 65536, 131072]),\n        ZSTD_c_windowLog => v.extend_from_slice(&[10, 14, 15, 17, 20]),\n        ZSTD_c_srcSizeHint => v.extend_from_slice(&[1, 1024, 100_000]),\n        _ => {}\n    }\n    v.sort_unstable();\n    v.dedup();\n    v\n}\n\n#[test]\nfn rows_29_57_every_parameter_swept_over_its_range() {\n    let mut rng = Rng::new(0xPARAM_5W);\n    let bounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_cParam_getBounds\");\n    let dict = make_dict(&mut rng, 16 * 1024);\n    // Two shapes: text (matches+literals) and long-range (for LDM params).\n    let text = gen(Shape::Text, 150_000, &mut rng);\n    let lr = gen(Shape::LongRange, 300_000, &mut rng);\n\n    for &p in ALL_CPARAMS {\n        let b = unsafe { bounds(p) };\n        assert_eq!(b.error, 0, \"param {p} unexpectedly unsupported\");\n        for v in param_values(p, b) {\n            for (sname, src) in [(\"text\", &text), (\"longrange\", &lr)] {\n                // plain\n                check(\n                    &format!(\"row29-57 param={p} value={v} src={sname}\"),\n                    &Cfg {\n                        params: vec![(p, v)],\n                        dict: Dict::None,\n                        pledged: None,\n                        src,\n                    },\n                );\n            }\n        }\n    }\n\n    // The same sweep but with a dictionary attached, since many parameters\n    // interact with dictionary loading.\n    for &p in ALL_CPARAMS {\n        let b = unsafe { bounds(p) };\n        for v in param_values(p, b) {\n            check(\n                &format!(\"row29-57 param={p} value={v} +dict\"),\n                &Cfg {\n                    params: vec![(p, v)],\n                    dict: Dict::Load(&dict),\n                    pledged: None,\n                    src: &text,\n                },\n            );\n        }\n    }\n}\n\n#[test]\nfn rows_29_57_ldm_parameter_combinations() {\n    // LDM has five interacting parameters; exercise their cross-product on\n    // data that actually contains long-distance matches.\n    let mut rng = Rng::new(0x1DM_5EED);\n    let lr = gen(Shape::LongRange, 400_000, &mut rng);\n    for &enable in &[0i32, 1, 2] {\n        for &hashlog in &[0i32, 6, 16, 20] {\n            for &minmatch in &[0i32, 4, 32, 4096] {\n                for &bucket in &[0i32, 1, 4, 8] {\n                    for &rate in &[0i32, 1, 7, 25] {\n                        check(\n                            &format!(\n                                \"ldm enable={enable} hashLog={hashlog} minMatch={minmatch} bucket={bucket} rate={rate}\"\n                            ),\n                            &Cfg {\n                                params: vec![\n                                    (ZSTD_c_enableLongDistanceMatching, enable),\n                                    (ZSTD_c_ldmHashLog, hashlog),\n                                    (ZSTD_c_ldmMinMatch, minmatch),\n                                    (ZSTD_c_ldmBucketSizeLog, bucket),\n                                    (ZSTD_c_ldmHashRateLog, rate),\n                                    (ZSTD_c_windowLog, 20),\n                                ],\n                                dict: Dict::None,\n                                pledged: None,\n                                src: &lr,\n                            },\n                        );\n                    }\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn rows_29_57_frame_flags_and_format() {\n    // contentSizeFlag / checksumFlag / dictIDFlag / format cross-product, with\n    // and without a dictionary and with and without a pledged size — these\n    // control the frame header layout directly.\n    let mut rng = Rng::new(0xF14G5);\n    let dict = make_dict(&mut rng, 8 * 1024);\n    let src = gen(Shape::Text, 50_000, &mut rng);\n    for &cs in &[0i32, 1] {\n        for &ck in &[0i32, 1] {\n            for &di in &[0i32, 1] {\n                for &fmt in &[0i32, 1] {\n                    for pledged in [None, Some(src.len() as u64), Some(ZSTD_CONTENTSIZE_UNKNOWN)] {\n                        for d in [Dict::None, Dict::Load(&dict)] {\n                            check(\n                                &format!(\n                                    \"flags cs={cs} ck={ck} dictID={di} format={fmt} pledged={pledged:?} dict={}\",\n                                    matches!(d, Dict::Load(_))\n                                ),\n                                &Cfg {\n                                    params: vec![\n                                        (ZSTD_c_contentSizeFlag, cs),\n                                        (ZSTD_c_checksumFlag, ck),\n                                        (ZSTD_c_dictIDFlag, di),\n                                        (ZSTD_c_format, fmt),\n                                    ],\n                                    dict: d,\n                                    pledged,\n                                    src: &src,\n                                },\n                            );\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn rows_29_57_randomized_parameter_soup() {\n    // Property-style: random VALID combinations of many parameters at once, on\n    // random shapes and sizes. This is where interaction bugs live.\n    let mut rng = Rng::new(0x5OUP_2024);\n    let bounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_cParam_getBounds\");\n    let dict = make_dict(&mut rng, 16 * 1024);\n    let prefix = gen(Shape::Text, 20_000, &mut rng);\n\n    for iter in 0..400 {\n        let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n        let len = match rng.below(6) {\n            0 => rng.below(64),\n            1 => rng.range(64, 4096),\n            2 => rng.range(4096, 100_000),\n            3 => rng.range(ZSTD_BLOCKSIZE_MAX - 4, ZSTD_BLOCKSIZE_MAX + 4),\n            4 => rng.range(100_000, 300_000),\n            _ => rng.range(0, 8),\n        };\n        let src = gen(shape, len, &mut rng);\n\n        let mut params = Vec::new();\n        let nb = rng.range(1, 8);\n        for _ in 0..nb {\n            let p = ALL_CPARAMS[rng.below(ALL_CPARAMS.len())];\n            let b = unsafe { bounds(p) };\n            let v = if b.upperBound == b.lowerBound {\n                b.lowerBound\n            } else {\n                // stay in-range: this test is about valid configurations\n                b.lowerBound + rng.below((b.upperBound - b.lowerBound + 1) as usize) as i32\n            };\n            params.push((p, v));\n        }\n\n        let d = match rng.below(4) {\n            0 => Dict::None,\n            1 => Dict::Load(&dict),\n            2 => Dict::Prefix(&prefix),\n            _ => Dict::CDict(&dict, rng.range(1, 12) as i32),\n        };\n        let pledged = match rng.below(3) {\n            0 => None,\n            1 => Some(src.len() as u64),\n            _ => Some(ZSTD_CONTENTSIZE_UNKNOWN),\n        };\n\n        check(\n            &format!(\"soup iter={iter} shape={shape:?} len={len} params={params:?} dict={d:?} pledged={pledged:?}\"),\n            &Cfg { params, dict: d, pledged, src: &src },\n        );\n    }\n}\n\n#[test]\nfn getparameter_roundtrips_match() {\n    // ZSTD_CCtx_getParameter must report the same stored value in both libs,\n    // including after clamping and after reset.\n    let bounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_cParam_getBounds\");\n    for &p in ALL_CPARAMS {\n        let b = unsafe { bounds(p) };\n        let mut vals = param_values(p, b);\n        // include out-of-range values: some params clamp, most reject\n        vals.extend_from_slice(&[b.lowerBound - 1, b.upperBound + 1, i32::MIN, i32::MAX]);\n        for v in vals {\n            diff(&format!(\"setParameter+getParameter p={p} v={v}\"), |a| unsafe {\n                let cctx = (a.createCCtx)();\n                let set = (a.setParameter)(cctx, p, v);\n                let mut got = 0i32;\n                let get = (a.getParameter)(cctx, p, &mut got);\n                // and again after a session-only reset (params must survive)\n                let rst = (a.cctxReset)(cctx, ZSTD_reset_session_only);\n                let mut got2 = 0i32;\n                let get2 = (a.getParameter)(cctx, p, &mut got2);\n                // and after a full parameter reset (params must go to default)\n                let rst2 = (a.cctxReset)(cctx, ZSTD_reset_parameters);\n                let mut got3 = 0i32;\n                let get3 = (a.getParameter)(cctx, p, &mut got3);\n                (a.freeCCtx)(cctx);\n                (set, got, get, rst, got2, get2, rst2, got3, get3)\n            });\n        }\n    }\n\n    // Same for the decompression side.\n    let dbounds: libloading::Symbol<unsafe extern \"C\" fn(i32) -> ZSTD_bounds> =\n        sym(c_lib(), \"ZSTD_dParam_getBounds\");\n    for &p in ALL_DPARAMS {\n        let b = unsafe { dbounds(p) };\n        let mut vals = param_values(p, b);\n        vals.extend_from_slice(&[b.lowerBound - 1, b.upperBound + 1, i32::MIN, i32::MAX]);\n        for v in vals {\n            diff(&format!(\"dSetParameter+dGetParameter p={p} v={v}\"), |a| unsafe {\n                let dctx = (a.createDCtx)();\n                let set = (a.dSetParameter)(dctx, p, v);\n                let mut got = 0i32;\n                let get = (a.dGetParameter)(dctx, p, &mut got);\n                let rst = (a.dctxReset)(dctx, ZSTD_reset_session_and_parameters);\n                let mut got2 = 0i32;\n                let get2 = (a.dGetParameter)(dctx, p, &mut got2);\n                (a.freeDCtx)(dctx);\n                (set, got, get, rst, got2, get2)\n            });\n        }\n    }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
