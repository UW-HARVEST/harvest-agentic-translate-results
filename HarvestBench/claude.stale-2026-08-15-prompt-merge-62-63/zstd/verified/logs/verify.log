{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_nin2jtdz3rlppwpyaqt4rm2dg7vax3j6ko5z3sq645ujbp4durfq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01XJxvJkUYrSQaWE8HFn9akM","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/phase_b_legacy_zbuff.rs","content":"//! Phase B — deprecated `ZBUFF_*` tier + legacy `ZSTDv01..v07` / `ZBUFFv04..v07`\n//! / `FSEv0N_*` / `HUFv0N_*` decoders, plus legacy auto-dispatch through the\n//! modern API.\n//!\n//! Everything here is a *differential* test: the identical byte-for-byte call\n//! sequence is replayed against the C `.so` and the Rust `.so` and the two\n//! transcripts (return codes, in/out pointer write-backs, produced bytes) must\n//! be identical. Most legacy inputs are rejected — that is still a meaningful\n//! differential assertion, provided BOTH libraries reject them identically with\n//! the SAME error code.\n//!\n//! Signatures were taken from:\n//!   * `c_src/src/deprecated/zbuff.h`  (in/out-pointer `size_t*` convention)\n//!   * `c_src/src/legacy/zstd_v01.h` .. `zstd_v07.h`\n//!   * `c_src/src/legacy/zstd_v0{5,6,7}.c` for the internal-but-exported\n//!     `FSEv0N_*` / `HUFv0N_*` / `ZSTDv0N_sizeofDCtx` / `isSkipFrame` symbols.\n#![allow(non_snake_case, non_camel_case_types)]\n\nmod common;\nuse common::*;\nuse libloading::{Library, Symbol};\nuse std::ffi::{c_void, CStr};\nuse std::os::raw::c_char;\n\n// ===========================================================================\n//  small utilities\n// ===========================================================================\n\n/// Render a `size_t` result symbolically.\nfn rr(v: usize) -> String {\n    if is_error(v) {\n        format!(\"E{}\", err_code(v))\n    } else {\n        format!(\"{v}\")\n    }\n}\n\nfn hx(b: &[u8]) -> String {\n    format!(\"{:016x}/{}\", fnv(b), b.len())\n}\n\n/// `src` followed by 512 zero bytes, so a legacy decoder that over-reads its\n/// input by a few bytes touches mapped memory in BOTH libraries identically.\nfn padded(src: &[u8]) -> Vec<u8> {\n    let mut v = src.to_vec();\n    v.resize(src.len() + 512, 0);\n    v\n}\n\n/// Run `f` for the C lib and the Rust lib; require identical transcript and\n/// identical produced bytes. Reports the first differing transcript step.\nfn diff_pair(ctx: &str, f: impl Fn(&'static Library) -> (Vec<String>, Vec<u8>)) {\n    let (cl, cb) = f(c_lib());\n    let (rl, rb) = f(r_lib());\n    if cl != rl {\n        let n = cl.len().min(rl.len());\n        for i in 0..n {\n            if cl[i] != rl[i] {\n                panic!(\n                    \"{ctx}: transcript differs at step {i}\\n  C    = {}\\n  Rust = {}\\n  \\\n                     (step {} was: {})\",\n                    cl[i],\n                    rl[i],\n                    i.saturating_sub(1),\n                    if i > 0 { cl[i - 1].as_str() } else { \"<start>\" }\n                );\n            }\n        }\n        panic!(\n            \"{ctx}: transcript LENGTH differs: C={} Rust={}\\n  C   tail = {:?}\\n  Rust tail = {:?}\",\n            cl.len(),\n            rl.len(),\n            &cl[n.saturating_sub(3)..],\n            &rl[n.saturating_sub(3)..]\n        );\n    }\n    assert_bytes_eq(ctx, &cb, &rb);\n}\n\nfn diff_log(ctx: &str, f: impl Fn(&'static Library) -> Vec<String>) {\n    diff_pair(ctx, |lib| (f(lib), Vec::new()))\n}\n\nfn have(names: &[&str]) -> bool {\n    names.iter().all(|n| both_have(n))\n}\n\n// ===========================================================================\n//  legacy magic numbers  (verified against zstd_v0N.h / zstd_v0N.c)\n//    v01 reads its magic with ZSTD_readBE32  -> on-disk bytes FD 2F B5 1E\n//    v02..v07 read with MEM_readLE32         -> on-disk bytes 2N B5 2F FD\n// ===========================================================================\n\nconst MAGIC_BYTES: [(&str, [u8; 4]); 8] = [\n    (\"v01\", [0xFD, 0x2F, 0xB5, 0x1E]), // 0xFD2FB51E big-endian\n    (\"v02\", [0x22, 0xB5, 0x2F, 0xFD]), // 0xFD2FB522 little-endian\n    (\"v03\", [0x23, 0xB5, 0x2F, 0xFD]), // 0xFD2FB523\n    (\"v04\", [0x24, 0xB5, 0x2F, 0xFD]), // 0xFD2FB524\n    (\"v05\", [0x25, 0xB5, 0x2F, 0xFD]), // 0xFD2FB525\n    (\"v06\", [0x26, 0xB5, 0x2F, 0xFD]), // 0xFD2FB526\n    (\"v07\", [0x27, 0xB5, 0x2F, 0xFD]), // 0xFD2FB527\n    (\"mod\", [0x28, 0xB5, 0x2F, 0xFD]), // 0xFD2FB528 = modern\n];\n\n/// A fixed, deterministic corpus of byte buffers shared by every legacy test.\nfn corpus() -> Vec<(String, Vec<u8>)> {\n    let mut out: Vec<(String, Vec<u8>)> = Vec::new();\n    out.push((\"empty\".into(), Vec::new()));\n    for n in [1usize, 2, 3, 4, 5, 8, 13, 64] {\n        out.push((format!(\"zeros{n}\"), vec![0u8; n]));\n        out.push((format!(\"ff{n}\"), vec![0xFFu8; n]));\n    }\n\n    let mut rng = Rng::new(0x5EED_C0FF_EE12_3456);\n    for (tag, m) in MAGIC_BYTES {\n        for k in 1..4usize {\n            out.push((format!(\"{tag}.trunc{k}\"), m[..k].to_vec()));\n        }\n        for tail in [0usize, 1, 2, 3, 4, 8, 13, 40, 200] {\n            let mut z = m.to_vec();\n            z.resize(4 + tail, 0);\n            out.push((format!(\"{tag}.zero{tail}\"), z));\n\n            let mut r = m.to_vec();\n            for _ in 0..tail {\n                r.push(rng.byte());\n            }\n            out.push((format!(\"{tag}.rand{tail}\"), r));\n        }\n    }\n\n    // Real modern frames, built with the C library (ground truth) so both\n    // libraries see byte-identical input.\n    let api = capi();\n    for (shape, len) in [(Shape::Text, 300usize), (Shape::Rle, 4096), (Shape::Random, 700)] {\n        let mut r = Rng::new(0xABCD_0001);\n        let src = gen(shape, len, &mut r);\n        let mut dst = vec![0u8; unsafe { (api.compressBound)(src.len()) } + 64];\n        let n = unsafe {\n            (api.compress)(\n                dst.as_mut_ptr() as *mut c_void,\n                dst.len() - 64,\n                src.as_ptr() as *const c_void,\n                src.len(),\n                3,\n            )\n        };\n        assert!(!is_error(n), \"corpus: C ZSTD_compress failed\");\n        dst.truncate(n);\n        out.push((format!(\"modframe.{shape:?}.{len}\"), dst.clone()));\n        // truncated modern frame\n        out.push((format!(\"modframe.{shape:?}.{len}.half\"), dst[..n / 2].to_vec()));\n    }\n\n    // dictionary magic + skippable frame magic\n    out.push((\"dictmagic\".into(), {\n        let mut v = ZSTD_MAGIC_DICTIONARY.to_le_bytes().to_vec();\n        v.resize(40, 0x5A);\n        v\n    }));\n    out.push((\"skippable\".into(), {\n        let mut v = ZSTD_MAGIC_SKIPPABLE_START.to_le_bytes().to_vec();\n        v.extend_from_slice(&8u32.to_le_bytes());\n        v.resize(16, 0x11);\n        v\n    }));\n    out\n}\n\n/// The interesting `size_t` values to probe `*_isError` / `*_getErrorName` with.\nfn error_probe_codes() -> Vec<usize> {\n    let mut v: Vec<usize> = Vec::new();\n    for k in 0..=130usize {\n        v.push((0usize).wrapping_sub(k));\n    }\n    v.extend_from_slice(&[0, 1, 2, 3, 100, 1000, 1 << 20, usize::MAX / 2]);\n    v\n}\n\n// ===========================================================================\n//  fn types\n// ===========================================================================\n\ntype FnVoidToPtr = unsafe extern \"C\" fn() -> *mut c_void;\ntype FnPtrToUsize = unsafe extern \"C\" fn(*mut c_void) -> usize;\ntype FnVoidToUsize = unsafe extern \"C\" fn() -> usize;\ntype FnUsizeToU32 = unsafe extern \"C\" fn(usize) -> u32;\ntype FnUsizeToStr = unsafe extern \"C\" fn(usize) -> *const c_char;\n\n/// `(dst, dstCapacity, src, srcSize) -> size_t`\ntype FnDec4 = unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize) -> usize;\n/// `(ctx, dst, dstCapacity, src, srcSize) -> size_t`\ntype FnDec5 = unsafe extern \"C\" fn(*mut c_void, *mut c_void, usize, *const c_void, usize) -> usize;\n/// `(ctx, dst, dstCapacity, src, srcSize, dict, dictSize) -> size_t`\ntype FnDecDict = unsafe extern \"C\" fn(\n    *mut c_void,\n    *mut c_void,\n    usize,\n    *const c_void,\n    usize,\n    *const c_void,\n    usize,\n) -> usize;\n/// `(dctx, refDCtx, dst, dstCapacity, src, srcSize) -> size_t`\ntype FnDecPrepared = unsafe extern \"C\" fn(\n    *mut c_void,\n    *const c_void,\n    *mut c_void,\n    usize,\n    *const c_void,\n    usize,\n) -> usize;\n/// `ZSTDv0N_findFrameSizeInfoLegacy(src, srcSize, size_t* cSize, U64* dBound)`\ntype FnFindFSI = unsafe extern \"C\" fn(*const c_void, usize, *mut usize, *mut u64);\n/// `(ctx, dict, dictSize) -> size_t`\ntype FnCtxDict = unsafe extern \"C\" fn(*mut c_void, *const c_void, usize) -> usize;\n\n/// ZBUFF in/out-pointer convention:\n/// `(ctx, dst, size_t* dstCapacityPtr, src, size_t* srcSizePtr) -> size_t`\ntype FnZbContinue =\n    unsafe extern \"C\" fn(*mut c_void, *mut c_void, *mut usize, *const c_void, *mut usize) -> usize;\n/// `(ctx, dst, size_t* dstCapacityPtr) -> size_t`\ntype FnZbFlush = unsafe extern \"C\" fn(*mut c_void, *mut c_void, *mut usize) -> usize;\ntype FnZbInit = unsafe extern \"C\" fn(*mut c_void, i32) -> usize;\ntype FnZbInitDict = unsafe extern \"C\" fn(*mut c_void, *const c_void, usize, i32) -> usize;\ntype FnZbInitAdv =\n    unsafe extern \"C\" fn(*mut c_void, *const c_void, usize, ZSTD_parameters, u64) -> usize;\ntype FnCreateAdvanced = unsafe extern \"C\" fn(ZSTD_customMem) -> *mut c_void;\n\n// FSE\ntype FnFseCreateDTable = unsafe extern \"C\" fn(u32) -> *mut u32;\ntype FnFseFreeDTable = unsafe extern \"C\" fn(*mut u32);\ntype FnFseBuildDTable = unsafe extern \"C\" fn(*mut u32, *const i16, u32, u32) -> usize;\ntype FnFseBuildRaw = unsafe extern \"C\" fn(*mut u32, u32) -> usize;\ntype FnFseBuildRle = unsafe extern \"C\" fn(*mut u32, u8) -> usize;\ntype FnFseReadNCount =\n    unsafe extern \"C\" fn(*mut i16, *mut u32, *mut u32, *const c_void, usize) -> usize;\ntype FnFseDecUsingDTable =\n    unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, *const u32) -> usize;\n\n// HUF\ntype FnHufReadDTableU16 = unsafe extern \"C\" fn(*mut u16, *const c_void, usize) -> usize;\ntype FnHufReadDTableU32 = unsafe extern \"C\" fn(*mut u32, *const c_void, usize) -> usize;\ntype FnHufDecUsingDTableU16 =\n    unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, *const u16) -> usize;\ntype FnHufDecUsingDTableU32 =\n    unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, *const u32) -> usize;\ntype FnHufDCtx = unsafe extern \"C\" fn(*mut u32, *mut c_void, usize, *const c_void, usize) -> usize;\ntype FnHufReadStats = unsafe extern \"C\" fn(\n    *mut u8,\n    usize,\n    *mut u32,\n    *mut u32,\n    *mut u32,\n    *const c_void,\n    usize,\n) -> usize;\ntype FnHufSelectDecoder = unsafe extern \"C\" fn(usize, usize) -> u32;\n\n// legacy frame-param structs\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\nstruct ZSTDv05_parameters {\n    srcSize: u64,\n    windowLog: u32,\n    contentLog: u32,\n    hashLog: u32,\n    searchLog: u32,\n    searchLength: u32,\n    targetLength: u32,\n    strategy: i32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\nstruct ZSTDv06_frameParams {\n    frameContentSize: u64,\n    windowLog: u32,\n}\n\n#[repr(C)]\n#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\nstruct ZSTDv07_frameParams {\n    frameContentSize: u64,\n    windowSize: u32,\n    dictID: u32,\n    checksumFlag: u32,\n}\n\n// ===========================================================================\n//  custom allocator for the `*_advanced` constructors\n// ===========================================================================\n\nconst HDR: usize = 16;\n\nextern \"C\" fn cm_alloc(_opaque: *mut c_void, size: usize) -> *mut c_void {\n    unsafe {\n        let layout = std::alloc::Layout::from_size_align(size + HDR, HDR).unwrap();\n        let p = std::alloc::alloc(layout);\n        if p.is_null() {\n            return std::ptr::null_mut();\n        }\n        (p as *mut usize).write(size);\n        p.add(HDR) as *mut c_void\n    }\n}\n\nextern \"C\" fn cm_free(_opaque: *mut c_void, ptr: *mut c_void) {\n    if ptr.is_null() {\n        return;\n    }\n    unsafe {\n        let base = (ptr as *mut u8).sub(HDR);\n        let size = (base as *const usize).read();\n        let layout = std::alloc::Layout::from_size_align(size + HDR, HDR).unwrap();\n        std::alloc::dealloc(base, layout);\n    }\n}\n\nfn custom_mem() -> ZSTD_customMem {\n    ZSTD_customMem {\n        customAlloc: Some(cm_alloc),\n        customFree: Some(cm_free),\n        opaque: std::ptr::null_mut(),\n    }\n}\n\n// ===========================================================================\n//  1.  Deprecated ZBUFF_* tier\n// ===========================================================================\n\n#[test]\nfn zbuff_recommended_sizes_match() {\n    for name in [\n        \"ZBUFF_recommendedCInSize\",\n        \"ZBUFF_recommendedCOutSize\",\n        \"ZBUFF_recommendedDInSize\",\n        \"ZBUFF_recommendedDOutSize\",\n    ] {\n        assert!(both_have(name), \"{name} missing\");\n        let (c, r) = pair::<FnVoidToUsize>(name);\n        unsafe { assert_eq!(c(), r(), \"{name}\") };\n    }\n    // and cross-check them against their modern equivalents in each library\n    for (zb, modern) in [\n        (\"ZBUFF_recommendedCInSize\", \"ZSTD_CStreamInSize\"),\n        (\"ZBUFF_recommendedCOutSize\", \"ZSTD_CStreamOutSize\"),\n        (\"ZBUFF_recommendedDInSize\", \"ZSTD_DStreamInSize\"),\n        (\"ZBUFF_recommendedDOutSize\", \"ZSTD_DStreamOutSize\"),\n    ] {\n        diff_log(&format!(\"{zb} vs {modern}\"), |lib| {\n            let a: Symbol<FnVoidToUsize> = sym(lib, zb);\n            let b: Symbol<FnVoidToUsize> = sym(lib, modern);\n            unsafe { vec![format!(\"{}\", a()), format!(\"{}\", b())] }\n        });\n    }\n}\n\n#[test]\nfn zbuff_error_api_matches() {\n    let codes = error_probe_codes();\n    let (ci, ri) = pair::<FnUsizeToU32>(\"ZBUFF_isError\");\n    let (cn, rn) = pair::<FnUsizeToStr>(\"ZBUFF_getErrorName\");\n    for &code in &codes {\n        unsafe {\n            assert_eq!(ci(code), ri(code), \"ZBUFF_isError({code}) [err={}]\", err_code(code));\n            let cs = CStr::from_ptr(cn(code)).to_string_lossy().into_owned();\n            let rs = CStr::from_ptr(rn(code)).to_string_lossy().into_owned();\n            assert_eq!(\n                cs,\n                rs,\n                \"ZBUFF_getErrorName({code}) [errcode={}]\",\n                err_code(code)\n            );\n        }\n    }\n}\n\nstruct ZbComp {\n    log: Vec<String>,\n    comp: Vec<u8>,\n}\n\n/// Drive a full `ZBUFF_compressContinue` / `Flush` / `End` compression, logging\n/// the return value and BOTH pointer write-backs after EVERY call.\nfn zbuff_compress_drive(\n    lib: &'static Library,\n    level: i32,\n    dict: Option<&[u8]>,\n    adv: Option<(ZSTD_parameters, u64)>,\n    src: &[u8],\n    in_chunk: usize,\n    out_chunk: usize,\n    flush_after: Option<usize>,\n    end_then_flush: bool,\n) -> ZbComp {\n    let create: Symbol<FnVoidToPtr> = sym(lib, \"ZBUFF_createCCtx\");\n    let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_freeCCtx\");\n    let cc: Symbol<FnZbContinue> = sym(lib, \"ZBUFF_compressContinue\");\n    let cf: Symbol<FnZbFlush> = sym(lib, \"ZBUFF_compressFlush\");\n    let ce: Symbol<FnZbFlush> = sym(lib, \"ZBUFF_compressEnd\");\n\n    let mut log = Vec::new();\n    let mut comp: Vec<u8> = Vec::new();\n    let cctx = unsafe { create() };\n    log.push(format!(\"createCCtx.null={}\", cctx.is_null()));\n    if cctx.is_null() {\n        return ZbComp { log, comp };\n    }\n\n    let init = unsafe {\n        match adv {\n            Some((params, pledged)) => {\n                let f: Symbol<FnZbInitAdv> = sym(lib, \"ZBUFF_compressInit_advanced\");\n                let (d, ds) = match dict {\n                    Some(d) => (d.as_ptr() as *const c_void, d.len()),\n                    None => (std::ptr::null(), 0),\n                };\n                f(cctx, d, ds, params, pledged)\n            }\n            None => match dict {\n                Some(d) => {\n                    let f: Symbol<FnZbInitDict> = sym(lib, \"ZBUFF_compressInitDictionary\");\n                    f(cctx, d.as_ptr() as *const c_void, d.len(), level)\n                }\n                None => {\n                    let f: Symbol<FnZbInit> = sym(lib, \"ZBUFF_compressInit\");\n                    f(cctx, level)\n                }\n            },\n        }\n    };\n    log.push(format!(\"init={}\", rr(init)));\n\n    let mut outbuf = vec![0u8; out_chunk + 64];\n    if !is_error(init) {\n        let mut pos = 0usize;\n        let mut guard = 0usize;\n        let mut flushed_mid = false;\n        while pos < src.len() {\n            if let Some(at) = flush_after {\n                if !flushed_mid && pos >= at {\n                    flushed_mid = true;\n                    let mut dcap = out_chunk;\n                    let ret = unsafe {\n                        cf(cctx, outbuf.as_mut_ptr() as *mut c_void, &mut dcap as *mut usize)\n                    };\n                    log.push(format!(\"midflush ret={} dcap={dcap}\", rr(ret)));\n                    comp.extend_from_slice(&outbuf[..dcap.min(outbuf.len())]);\n                    if is_error(ret) {\n                        break;\n                    }\n                }\n            }\n            let mut dcap = out_chunk;\n            let mut ssz = (src.len() - pos).min(in_chunk);\n            let ret = unsafe {\n                cc(\n                    cctx,\n                    outbuf.as_mut_ptr() as *mut c_void,\n                    &mut dcap as *mut usize,\n                    src[pos..].as_ptr() as *const c_void,\n                    &mut ssz as *mut usize,\n                )\n            };\n            log.push(format!(\"cc@{pos} ret={} dcap={dcap} ssz={ssz}\", rr(ret)));\n            if is_error(ret) {\n                break;\n            }\n            comp.extend_from_slice(&outbuf[..dcap.min(outbuf.len())]);\n            pos += ssz;\n            guard += 1;\n            if ssz == 0 && dcap == 0 {\n                log.push(\"cc STALL\".into());\n                break;\n            }\n            if guard > 4_000_000 {\n                log.push(\"cc GUARD\".into());\n                break;\n            }\n        }\n\n        // finalize\n        let mut dcap = out_chunk;\n        let mut ret =\n            unsafe { ce(cctx, outbuf.as_mut_ptr() as *mut c_void, &mut dcap as *mut usize) };\n        log.push(format!(\"end ret={} dcap={dcap}\", rr(ret)));\n        comp.extend_from_slice(&outbuf[..dcap.min(outbuf.len())]);\n        let mut g = 0usize;\n        while !is_error(ret) && ret != 0 {\n            let mut d2 = out_chunk;\n            ret = if end_then_flush {\n                // literal reading of zbuff.h: \"call again ZBUFF_compressFlush()\n                // to complete the flush\".\n                let r = unsafe { cf(cctx, outbuf.as_mut_ptr() as *mut c_void, &mut d2 as *mut usize) };\n                log.push(format!(\"endflush ret={} dcap={d2}\", rr(r)));\n                r\n            } else {\n                let r = unsafe { ce(cctx, outbuf.as_mut_ptr() as *mut c_void, &mut d2 as *mut usize) };\n                log.push(format!(\"end2 ret={} dcap={d2}\", rr(r)));\n                r\n            };\n            comp.extend_from_slice(&outbuf[..d2.min(outbuf.len())]);\n            g += 1;\n            if d2 == 0 {\n                log.push(\"fin STALL\".into());\n                break;\n            }\n            if g > 4_000_000 {\n                log.push(\"fin GUARD\".into());\n                break;\n            }\n        }\n    }\n\n    log.push(format!(\"freeCCtx={}\", rr(unsafe { freef(cctx) })));\n    log.push(format!(\"comp={}\", hx(&comp)));\n    ZbComp { log, comp }\n}\n\n/// Drive `ZBUFF_decompressContinue`, logging return + both write-backs.\nfn zbuff_decompress_drive(\n    lib: &'static Library,\n    dict: Option<&[u8]>,\n    comp: &[u8],\n    in_chunk: usize,\n    out_chunk: usize,\n) -> (Vec<String>, Vec<u8>) {\n    let create: Symbol<FnVoidToPtr> = sym(lib, \"ZBUFF_createDCtx\");\n    let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_freeDCtx\");\n    let dc: Symbol<FnZbContinue> = sym(lib, \"ZBUFF_decompressContinue\");\n\n    let mut log = Vec::new();\n    let mut dec: Vec<u8> = Vec::new();\n    let dctx = unsafe { create() };\n    log.push(format!(\"createDCtx.null={}\", dctx.is_null()));\n    if dctx.is_null() {\n        return (log, dec);\n    }\n    let init = unsafe {\n        match dict {\n            Some(d) => {\n                let f: Symbol<FnCtxDict> = sym(lib, \"ZBUFF_decompressInitDictionary\");\n                f(dctx, d.as_ptr() as *const c_void, d.len())\n            }\n            None => {\n                let f: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_decompressInit\");\n                f(dctx)\n            }\n        }\n    };\n    log.push(format!(\"dinit={}\", rr(init)));\n\n    let mut outbuf = vec![0u8; out_chunk + 64];\n    let padded_comp = padded(comp);\n    if !is_error(init) {\n        let mut pos = 0usize;\n        let mut guard = 0usize;\n        loop {\n            let mut dcap = out_chunk;\n            let mut ssz = (comp.len() - pos).min(in_chunk);\n            let ret = unsafe {\n                dc(\n                    dctx,\n                    outbuf.as_mut_ptr() as *mut c_void,\n                    &mut dcap as *mut usize,\n                    padded_comp[pos..].as_ptr() as *const c_void,\n                    &mut ssz as *mut usize,\n                )\n            };\n            log.push(format!(\"dc@{pos} ret={} dcap={dcap} ssz={ssz}\", rr(ret)));\n            if is_error(ret) {\n                break;\n            }\n            dec.extend_from_slice(&outbuf[..dcap.min(outbuf.len())]);\n            pos += ssz;\n            if ret == 0 {\n                log.push(format!(\"frame complete at {pos}/{}\", comp.len()));\n                break;\n            }\n            if ssz == 0 && dcap == 0 {\n                log.push(\"dc STALL\".into());\n                break;\n            }\n            guard += 1;\n            if guard > 4_000_000 {\n                log.push(\"dc GUARD\".into());\n                break;\n            }\n        }\n    }\n    log.push(format!(\"freeDCtx={}\", rr(unsafe { freef(dctx) })));\n    log.push(format!(\"dec={}\", hx(&dec)));\n    (log, dec)\n}\n\n#[test]\nfn zbuff_compress_roundtrip_matrix() {\n    assert!(have(&[\n        \"ZBUFF_createCCtx\",\n        \"ZBUFF_freeCCtx\",\n        \"ZBUFF_compressInit\",\n        \"ZBUFF_compressInitDictionary\",\n        \"ZBUFF_compressContinue\",\n        \"ZBUFF_compressFlush\",\n        \"ZBUFF_compressEnd\",\n        \"ZBUFF_createDCtx\",\n        \"ZBUFF_freeDCtx\",\n        \"ZBUFF_decompressInit\",\n        \"ZBUFF_decompressInitDictionary\",\n        \"ZBUFF_decompressContinue\",\n    ]));\n\n    let mut rng = Rng::new(0x2BUFF_2BUFF);\n    let dict = gen(Shape::Text, 4096, &mut rng);\n\n    let (cin, _) = pair::<FnVoidToUsize>(\"ZBUFF_recommendedCInSize\");\n    let (cout, _) = pair::<FnVoidToUsize>(\"ZBUFF_recommendedCOutSize\");\n    let rec_in = unsafe { cin() };\n    let rec_out = unsafe { cout() };\n\n    for &level in &[1i32, 3, 9, 19] {\n        for &(shape, srclen) in &[\n            (Shape::Text, 0usize),\n            (Shape::Text, 1),\n            (Shape::Skewed, 100),\n            (Shape::Text, 5000),\n            (Shape::LongRange, 70_000),\n        ] {\n            let mut r = Rng::new(0x1234_0000 + srclen as u64);\n            let src = gen(shape, srclen, &mut r);\n            let mut chunkings: Vec<(usize, usize)> =\n                vec![(usize::MAX / 4, rec_out), (rec_in, rec_out), (1024, 300)];\n            if srclen <= 5000 {\n                chunkings.push((1, 1));\n                chunkings.push((13, 7));\n            }\n            for &(in_chunk, out_chunk) in &chunkings {\n                for use_dict in [false, true] {\n                    let d = if use_dict { Some(&dict[..]) } else { None };\n                    let flush_after = if srclen > 100 { Some(srclen / 2) } else { None };\n                    let ctx = format!(\n                        \"ZBUFF compress lvl={level} shape={shape:?} len={srclen} \\\n                         in={in_chunk} out={out_chunk} dict={use_dict}\"\n                    );\n\n                    // ---- compression phase: identical transcript + bytes\n                    let c = zbuff_compress_drive(\n                        c_lib(),\n                        level,\n                        d,\n                        None,\n                        &src,\n                        in_chunk,\n                        out_chunk,\n                        flush_after,\n                        false,\n                    );\n                    let rs = zbuff_compress_drive(\n                        r_lib(),\n                        level,\n                        d,\n                        None,\n                        &src,\n                        in_chunk,\n                        out_chunk,\n                        flush_after,\n                        false,\n                    );\n                    cmp_log(&ctx, &c.log, &rs.log);\n                    assert_bytes_eq(&format!(\"{ctx} [compressed bytes]\"), &c.comp, &rs.comp);\n\n                    // ---- decompression phase: feed the SAME (C-produced) bytes\n                    let (cl, cd) =\n                        zbuff_decompress_drive(c_lib(), d, &c.comp, in_chunk.min(1 << 20), out_chunk);\n                    let (rl, rd) =\n                        zbuff_decompress_drive(r_lib(), d, &c.comp, in_chunk.min(1 << 20), out_chunk);\n                    cmp_log(&format!(\"{ctx} [decompress]\"), &cl, &rl);\n                    assert_bytes_eq(&format!(\"{ctx} [decompressed bytes]\"), &cd, &rd);\n\n                    // sanity: the C ground-truth round trip must reproduce src\n                    assert_bytes_eq(&format!(\"{ctx} [C round trip]\"), &src, &cd);\n                }\n            }\n        }\n    }\n}\n\nfn cmp_log(ctx: &str, c: &[String], r: &[String]) {\n    if c == r {\n        return;\n    }\n    let n = c.len().min(r.len());\n    for i in 0..n {\n        if c[i] != r[i] {\n            panic!(\n                \"{ctx}: transcript differs at step {i}\\n  C    = {}\\n  Rust = {}\\n  prev = {}\",\n                c[i],\n                r[i],\n                if i > 0 { c[i - 1].as_str() } else { \"<start>\" }\n            );\n        }\n    }\n    panic!(\n        \"{ctx}: transcript LENGTH differs: C={} Rust={}\\n  C   tail = {:?}\\n  Rust tail = {:?}\",\n        c.len(),\n        r.len(),\n        &c[n.saturating_sub(3)..],\n        &r[n.saturating_sub(3)..]\n    );\n}\n\n#[test]\nfn zbuff_end_then_flush_sequence_matches() {\n    // Exercise the literal zbuff.h advice: compressEnd, then compressFlush to\n    // finish flushing when dst was too small.\n    let mut rng = Rng::new(0xEEEE_1111);\n    let src = gen(Shape::Text, 9000, &mut rng);\n    for &out_chunk in &[1usize, 5, 64, 1000] {\n        for &level in &[1i32, 9] {\n            let ctx = format!(\"ZBUFF end-then-flush out={out_chunk} lvl={level}\");\n            let c = zbuff_compress_drive(\n                c_lib(), level, None, None, &src, 4096, out_chunk, None, true,\n            );\n            let r = zbuff_compress_drive(\n                r_lib(), level, None, None, &src, 4096, out_chunk, None, true,\n            );\n            cmp_log(&ctx, &c.log, &r.log);\n            assert_bytes_eq(&ctx, &c.comp, &r.comp);\n        }\n    }\n}\n\n#[test]\nfn zbuff_compress_init_advanced_matches() {\n    assert!(both_have(\"ZBUFF_compressInit_advanced\"));\n    let mut rng = Rng::new(0xAD_1234);\n    let dict = gen(Shape::Text, 2048, &mut rng);\n    let src = gen(Shape::Skewed, 6000, &mut rng);\n    let api = capi();\n\n    let mut cases: Vec<(String, ZSTD_parameters, u64, bool)> = Vec::new();\n    for &level in &[1i32, 3, 9, 19] {\n        for &(pledged, with_dict) in\n            &[(0u64, false), (src.len() as u64, false), (0, true), (src.len() as u64, true)]\n        {\n            let ds = if with_dict { dict.len() } else { 0 };\n            let p = unsafe { (api.getParams)(level, src.len() as u64, ds) };\n            cases.push((\n                format!(\"lvl={level} pledged={pledged} dict={with_dict}\"),\n                p,\n                pledged,\n                with_dict,\n            ));\n        }\n    }\n    // deliberately invalid cParams -> ZSTD_checkCParams must reject identically\n    let mut bad = unsafe { (api.getParams)(3, src.len() as u64, 0) };\n    bad.cParams.windowLog = 3;\n    cases.push((\"invalid windowLog=3\".into(), bad, 0, false));\n    let mut bad2 = unsafe { (api.getParams)(3, src.len() as u64, 0) };\n    bad2.cParams.strategy = 42;\n    cases.push((\"invalid strategy=42\".into(), bad2, 0, false));\n    let mut bad3 = unsafe { (api.getParams)(3, src.len() as u64, 0) };\n    bad3.cParams.hashLog = 99;\n    cases.push((\"invalid hashLog=99\".into(), bad3, 0, false));\n\n    for (tag, params, pledged, with_dict) in cases {\n        let d = if with_dict { Some(&dict[..]) } else { None };\n        let ctx = format!(\"ZBUFF_compressInit_advanced {tag}\");\n        let c = zbuff_compress_drive(\n            c_lib(),\n            0,\n            d,\n            Some((params, pledged)),\n            &src,\n            2048,\n            700,\n            None,\n            false,\n        );\n        let r = zbuff_compress_drive(\n            r_lib(),\n            0,\n            d,\n            Some((params, pledged)),\n            &src,\n            2048,\n            700,\n            None,\n            false,\n        );\n        cmp_log(&ctx, &c.log, &r.log);\n        assert_bytes_eq(&ctx, &c.comp, &r.comp);\n    }\n}\n\n#[test]\nfn zbuff_advanced_ctx_creation_roundtrip_matches() {\n    assert!(have(&[\"ZBUFF_createCCtx_advanced\", \"ZBUFF_createDCtx_advanced\"]));\n    let mut rng = Rng::new(0xC5_70_00);\n    let src = gen(Shape::Text, 3000, &mut rng);\n\n    diff_pair(\"ZBUFF_*_advanced round trip\", |lib| {\n        let mut log = Vec::new();\n        let cca: Symbol<FnCreateAdvanced> = sym(lib, \"ZBUFF_createCCtx_advanced\");\n        let freec: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_freeCCtx\");\n        let init: Symbol<FnZbInit> = sym(lib, \"ZBUFF_compressInit\");\n        let cc: Symbol<FnZbContinue> = sym(lib, \"ZBUFF_compressContinue\");\n        let ce: Symbol<FnZbFlush> = sym(lib, \"ZBUFF_compressEnd\");\n\n        let cctx = unsafe { cca(custom_mem()) };\n        log.push(format!(\"cctx.null={}\", cctx.is_null()));\n        let mut comp = Vec::new();\n        if !cctx.is_null() {\n            log.push(format!(\"init={}\", rr(unsafe { init(cctx, 5) })));\n            let mut ob = vec![0u8; 70_000];\n            let mut dcap = ob.len();\n            let mut ssz = src.len();\n            let ret = unsafe {\n                cc(\n                    cctx,\n                    ob.as_mut_ptr() as *mut c_void,\n                    &mut dcap,\n                    src.as_ptr() as *const c_void,\n                    &mut ssz,\n                )\n            };\n            log.push(format!(\"cc ret={} dcap={dcap} ssz={ssz}\", rr(ret)));\n            comp.extend_from_slice(&ob[..dcap]);\n            let mut dcap2 = ob.len();\n            let ret2 = unsafe { ce(cctx, ob.as_mut_ptr() as *mut c_void, &mut dcap2) };\n            log.push(format!(\"end ret={} dcap={dcap2}\", rr(ret2)));\n            comp.extend_from_slice(&ob[..dcap2]);\n            log.push(format!(\"freeCCtx={}\", rr(unsafe { freec(cctx) })));\n        }\n        log.push(format!(\"comp={}\", hx(&comp)));\n\n        let dca: Symbol<FnCreateAdvanced> = sym(lib, \"ZBUFF_createDCtx_advanced\");\n        let freed: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_freeDCtx\");\n        let dinit: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_decompressInit\");\n        let dc: Symbol<FnZbContinue> = sym(lib, \"ZBUFF_decompressContinue\");\n        let dctx = unsafe { dca(custom_mem()) };\n        log.push(format!(\"dctx.null={}\", dctx.is_null()));\n        let mut dec = Vec::new();\n        if !dctx.is_null() {\n            log.push(format!(\"dinit={}\", rr(unsafe { dinit(dctx) })));\n            let mut ob = vec![0u8; 70_000];\n            let mut dcap = ob.len();\n            let mut ssz = comp.len();\n            let pc = padded(&comp);\n            let ret = unsafe {\n                dc(\n                    dctx,\n                    ob.as_mut_ptr() as *mut c_void,\n                    &mut dcap,\n                    pc.as_ptr() as *const c_void,\n                    &mut ssz,\n                )\n            };\n            log.push(format!(\"dc ret={} dcap={dcap} ssz={ssz}\", rr(ret)));\n            dec.extend_from_slice(&ob[..dcap]);\n            log.push(format!(\"freeDCtx={}\", rr(unsafe { freed(dctx) })));\n        }\n        log.push(format!(\"dec={}\", hx(&dec)));\n        let mut bytes = comp.clone();\n        bytes.extend_from_slice(&dec);\n        (log, bytes)\n    });\n}\n\n#[test]\nfn zbuff_decompress_bad_input_matches() {\n    let corp = corpus();\n    for (tag, buf) in &corp {\n        for &(inc, outc) in &[(usize::MAX / 4, 1 << 17), (7usize, 5usize)] {\n            let ctx = format!(\"ZBUFF_decompressContinue {tag} in={inc} out={outc}\");\n            let (cl, cd) = zbuff_decompress_drive(c_lib(), None, buf, inc, outc);\n            let (rl, rd) = zbuff_decompress_drive(r_lib(), None, buf, inc, outc);\n            cmp_log(&ctx, &cl, &rl);\n            assert_bytes_eq(&ctx, &cd, &rd);\n        }\n    }\n    // srcSize 0 / dstCapacity 0 corner\n    diff_log(\"ZBUFF_decompressContinue zero-sized buffers\", |lib| {\n        let create: Symbol<FnVoidToPtr> = sym(lib, \"ZBUFF_createDCtx\");\n        let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_freeDCtx\");\n        let dinit: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFF_decompressInit\");\n        let dc: Symbol<FnZbContinue> = sym(lib, \"ZBUFF_decompressContinue\");\n        let mut log = Vec::new();\n        let dctx = unsafe { create() };\n        log.push(format!(\"dinit={}\", rr(unsafe { dinit(dctx) })));\n        for (dcap0, ssz0) in [(0usize, 0usize), (0, 4), (4, 0)] {\n            let mut dcap = dcap0;\n            let mut ssz = ssz0;\n            let src = [0x28u8, 0xB5, 0x2F, 0xFD, 0, 0, 0, 0];\n            let mut dst = [0u8; 8];\n            let ret = unsafe {\n                dc(\n                    dctx,\n                    dst.as_mut_ptr() as *mut c_void,\n                    &mut dcap,\n                    src.as_ptr() as *const c_void,\n                    &mut ssz,\n                )\n            };\n            log.push(format!(\"({dcap0},{ssz0}) ret={} dcap={dcap} ssz={ssz}\", rr(ret)));\n        }\n        log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n        log\n    });\n}\n\n// ===========================================================================\n//  2.  Legacy v01..v07 — direct calls\n// ===========================================================================\n\n#[test]\nfn legacy_error_api_matches() {\n    let codes = error_probe_codes();\n    let mut tested = 0usize;\n    for n in 1..=7u32 {\n        for base in [\"ZSTD\", \"ZBUFF\"] {\n            let isn = format!(\"{base}v0{n}_isError\");\n            if both_have(&isn) {\n                tested += 1;\n                let (c, r) = pair::<FnUsizeToU32>(&isn);\n                for &code in &codes {\n                    unsafe { assert_eq!(c(code), r(code), \"{isn}({code})\") };\n                }\n            }\n            let gen_ = format!(\"{base}v0{n}_getErrorName\");\n            if both_have(&gen_) {\n                tested += 1;\n                let (c, r) = pair::<FnUsizeToStr>(&gen_);\n                for &code in &codes {\n                    unsafe {\n                        let cs = CStr::from_ptr(c(code)).to_string_lossy().into_owned();\n                        let rs = CStr::from_ptr(r(code)).to_string_lossy().into_owned();\n                        assert_eq!(cs, rs, \"{gen_}({code}) errcode={}\", err_code(code));\n                    }\n                }\n            }\n        }\n    }\n    // FSE / HUF error helpers\n    for n in 5..=7u32 {\n        for base in [\"FSE\", \"HUF\"] {\n            let isn = format!(\"{base}v0{n}_isError\");\n            if both_have(&isn) {\n                tested += 1;\n                let (c, r) = pair::<FnUsizeToU32>(&isn);\n                for &code in &codes {\n                    unsafe { assert_eq!(c(code), r(code), \"{isn}({code})\") };\n                }\n            }\n            let gn = format!(\"{base}v0{n}_getErrorName\");\n            if both_have(&gn) {\n                tested += 1;\n                let (c, r) = pair::<FnUsizeToStr>(&gn);\n                for &code in &codes {\n                    unsafe {\n                        let cs = CStr::from_ptr(c(code)).to_string_lossy().into_owned();\n                        let rs = CStr::from_ptr(r(code)).to_string_lossy().into_owned();\n                        assert_eq!(cs, rs, \"{gn}({code}) errcode={}\", err_code(code));\n                    }\n                }\n            }\n        }\n    }\n    assert!(tested >= 15, \"expected many legacy error helpers, tested {tested}\");\n}\n\n#[test]\nfn legacy_decompress_matches_over_corpus() {\n    let corp = corpus();\n    for n in 1..=7u32 {\n        let name = format!(\"ZSTDv0{n}_decompress\");\n        if !both_have(&name) {\n            continue;\n        }\n        for (tag, src) in &corp {\n            for &cap in &[0usize, 1, 4096, 65536] {\n                diff_pair(&format!(\"{name} src={tag} cap={cap}\"), |lib| {\n                    let f: Symbol<FnDec4> = sym(lib, &name);\n                    let s = padded(src);\n                    let mut d = vec![0u8; cap + 4096];\n                    let ret = unsafe {\n                        f(\n                            d.as_mut_ptr() as *mut c_void,\n                            cap,\n                            s.as_ptr() as *const c_void,\n                            src.len(),\n                        )\n                    };\n                    let log =\n                        vec![format!(\"ret={}\", rr(ret)), format!(\"dst={}\", hx(&d[..cap]))];\n                    (log, d[..cap.min(8192)].to_vec())\n                });\n            }\n        }\n    }\n}\n\n#[test]\nfn legacy_decompress_dctx_matches_over_corpus() {\n    let corp = corpus();\n    for n in 1..=7u32 {\n        let name = format!(\"ZSTDv0{n}_decompressDCtx\");\n        let cr = format!(\"ZSTDv0{n}_createDCtx\");\n        let fr = format!(\"ZSTDv0{n}_freeDCtx\");\n        if !have(&[&name, &cr, &fr]) {\n            continue;\n        }\n        for (tag, src) in &corp {\n            for &cap in &[0usize, 4096, 65536] {\n                diff_pair(&format!(\"{name} src={tag} cap={cap}\"), |lib| {\n                    let create: Symbol<FnVoidToPtr> = sym(lib, &cr);\n                    let freef: Symbol<FnPtrToUsize> = sym(lib, &fr);\n                    let f: Symbol<FnDec5> = sym(lib, &name);\n                    let mut log = Vec::new();\n                    let dctx = unsafe { create() };\n                    log.push(format!(\"null={}\", dctx.is_null()));\n                    if dctx.is_null() {\n                        return (log, Vec::new());\n                    }\n                    let s = padded(src);\n                    let mut d = vec![0u8; cap + 4096];\n                    let ret = unsafe {\n                        f(\n                            dctx,\n                            d.as_mut_ptr() as *mut c_void,\n                            cap,\n                            s.as_ptr() as *const c_void,\n                            src.len(),\n                        )\n                    };\n                    log.push(format!(\"ret={}\", rr(ret)));\n                    log.push(format!(\"dst={}\", hx(&d[..cap])));\n                    log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n                    (log, d[..cap.min(8192)].to_vec())\n                });\n            }\n        }\n    }\n}\n\n#[test]\nfn legacy_find_frame_size_info_matches() {\n    let corp = corpus();\n    for n in 1..=7u32 {\n        let name = format!(\"ZSTDv0{n}_findFrameSizeInfoLegacy\");\n        if !both_have(&name) {\n            continue;\n        }\n        for (tag, src) in &corp {\n            diff_log(&format!(\"{name} src={tag}\"), |lib| {\n                let f: Symbol<FnFindFSI> = sym(lib, &name);\n                let s = padded(src);\n                let mut c_size: usize = 0xDEAD_BEEF;\n                let mut d_bound: u64 = 0x1234_5678_9ABC_DEF0;\n                unsafe {\n                    f(\n                        s.as_ptr() as *const c_void,\n                        src.len(),\n                        &mut c_size as *mut usize,\n                        &mut d_bound as *mut u64,\n                    )\n                };\n                vec![format!(\"cSize={}\", rr(c_size)), format!(\"dBound={d_bound}\")]\n            });\n        }\n    }\n}\n\n#[test]\nfn legacy_streaming_dctx_matches() {\n    let corp = corpus();\n    for n in 1..=7u32 {\n        let cr = format!(\"ZSTDv0{n}_createDCtx\");\n        let fr = format!(\"ZSTDv0{n}_freeDCtx\");\n        let nx = format!(\"ZSTDv0{n}_nextSrcSizeToDecompress\");\n        let co = format!(\"ZSTDv0{n}_decompressContinue\");\n        let reset = if n <= 4 {\n            format!(\"ZSTDv0{n}_resetDCtx\")\n        } else {\n            format!(\"ZSTDv0{n}_decompressBegin\")\n        };\n        if !have(&[&cr, &fr, &nx, &co, &reset]) {\n            continue;\n        }\n        for (tag, src) in &corp {\n            for &cap in &[0usize, 65536] {\n                diff_pair(&format!(\"ZSTDv0{n} stream src={tag} cap={cap}\"), |lib| {\n                    let create: Symbol<FnVoidToPtr> = sym(lib, &cr);\n                    let freef: Symbol<FnPtrToUsize> = sym(lib, &fr);\n                    let next: Symbol<FnPtrToUsize> = sym(lib, &nx);\n                    let cont: Symbol<FnDec5> = sym(lib, &co);\n                    let rst: Symbol<FnPtrToUsize> = sym(lib, &reset);\n\n                    let mut log = Vec::new();\n                    let dctx = unsafe { create() };\n                    log.push(format!(\"null={}\", dctx.is_null()));\n                    if dctx.is_null() {\n                        return (log, Vec::new());\n                    }\n                    log.push(format!(\"reset={}\", rr(unsafe { rst(dctx) })));\n                    let s = padded(src);\n                    let mut out = vec![0u8; cap + 4096];\n                    let mut acc: Vec<u8> = Vec::new();\n                    let mut pos = 0usize;\n                    for step in 0..64 {\n                        let ns = unsafe { next(dctx) };\n                        log.push(format!(\"s{step}.next={}\", rr(ns)));\n                        if ns == 0 || is_error(ns) {\n                            break;\n                        }\n                        if pos + ns > src.len() {\n                            log.push(format!(\"s{step}.short pos={pos} need={ns}\"));\n                            break;\n                        }\n                        let ret = unsafe {\n                            cont(\n                                dctx,\n                                out.as_mut_ptr() as *mut c_void,\n                                cap,\n                                s[pos..].as_ptr() as *const c_void,\n                                ns,\n                            )\n                        };\n                        log.push(format!(\"s{step}.ret={}\", rr(ret)));\n                        if is_error(ret) {\n                            break;\n                        }\n                        acc.extend_from_slice(&out[..ret.min(cap)]);\n                        pos += ns;\n                    }\n                    log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n                    log.push(format!(\"acc={}\", hx(&acc)));\n                    (log, acc)\n                });\n            }\n        }\n    }\n}\n\n#[test]\nfn legacy_v567_frame_params_matches() {\n    let corp = corpus();\n    // v05\n    if both_have(\"ZSTDv05_getFrameParams\") {\n        for (tag, src) in &corp {\n            diff_log(&format!(\"ZSTDv05_getFrameParams {tag}\"), |lib| {\n                let f: Symbol<\n                    unsafe extern \"C\" fn(*mut ZSTDv05_parameters, *const c_void, usize) -> usize,\n                > = sym(lib, \"ZSTDv05_getFrameParams\");\n                let s = padded(src);\n                let mut p = ZSTDv05_parameters {\n                    srcSize: 0xAAAA_AAAA_AAAA_AAAA,\n                    windowLog: 0xBBBB_BBBB,\n                    contentLog: 0xCCCC_CCCC,\n                    hashLog: 0xDDDD_DDDD,\n                    searchLog: 0xEEEE_EEEE,\n                    searchLength: 0x1111_1111,\n                    targetLength: 0x2222_2222,\n                    strategy: 0x3333_3333,\n                };\n                let ret =\n                    unsafe { f(&mut p as *mut _, s.as_ptr() as *const c_void, src.len()) };\n                vec![format!(\"ret={}\", rr(ret)), format!(\"{p:?}\")]\n            });\n        }\n    }\n    // v06\n    if both_have(\"ZSTDv06_getFrameParams\") {\n        for (tag, src) in &corp {\n            diff_log(&format!(\"ZSTDv06_getFrameParams {tag}\"), |lib| {\n                let f: Symbol<\n                    unsafe extern \"C\" fn(*mut ZSTDv06_frameParams, *const c_void, usize) -> usize,\n                > = sym(lib, \"ZSTDv06_getFrameParams\");\n                let s = padded(src);\n                let mut p = ZSTDv06_frameParams {\n                    frameContentSize: 0xAAAA_AAAA_AAAA_AAAA,\n                    windowLog: 0xBBBB_BBBB,\n                };\n                let ret =\n                    unsafe { f(&mut p as *mut _, s.as_ptr() as *const c_void, src.len()) };\n                vec![format!(\"ret={}\", rr(ret)), format!(\"{p:?}\")]\n            });\n        }\n    }\n    // v07\n    if both_have(\"ZSTDv07_getFrameParams\") {\n        for (tag, src) in &corp {\n            diff_log(&format!(\"ZSTDv07_getFrameParams {tag}\"), |lib| {\n                let f: Symbol<\n                    unsafe extern \"C\" fn(*mut ZSTDv07_frameParams, *const c_void, usize) -> usize,\n                > = sym(lib, \"ZSTDv07_getFrameParams\");\n                let s = padded(src);\n                let mut p = ZSTDv07_frameParams {\n                    frameContentSize: 0xAAAA_AAAA_AAAA_AAAA,\n                    windowSize: 0xBBBB_BBBB,\n                    dictID: 0xCCCC_CCCC,\n                    checksumFlag: 0xDDDD_DDDD,\n                };\n                let ret =\n                    unsafe { f(&mut p as *mut _, s.as_ptr() as *const c_void, src.len()) };\n                vec![format!(\"ret={}\", rr(ret)), format!(\"{p:?}\")]\n            });\n        }\n    }\n    // v06 compressBound (exported helper)\n    if both_have(\"ZSTDv06_compressBound\") {\n        diff_log(\"ZSTDv06_compressBound\", |lib| {\n            let f: Symbol<unsafe extern \"C\" fn(usize) -> usize> =\n                sym(lib, \"ZSTDv06_compressBound\");\n            [0usize, 1, 100, 1 << 16, 1 << 20]\n                .iter()\n                .map(|&n| unsafe { format!(\"{n}->{}\", f(n)) })\n                .collect()\n        });\n    }\n}\n\n#[test]\nfn legacy_v567_dict_and_block_api_matches() {\n    let corp = corpus();\n    let mut rng = Rng::new(0xD1C7_0000);\n    let dict = gen(Shape::Text, 3000, &mut rng);\n\n    for n in 5..=7u32 {\n        let cr = format!(\"ZSTDv0{n}_createDCtx\");\n        let fr = format!(\"ZSTDv0{n}_freeDCtx\");\n        if !have(&[&cr, &fr]) {\n            continue;\n        }\n\n        // sizeofDCtx: v05/v06 take no args, v07 takes a const DCtx*\n        let szname = format!(\"ZSTDv0{n}_sizeofDCtx\");\n        if both_have(&szname) {\n            diff_log(&szname, |lib| {\n                let create: Symbol<FnVoidToPtr> = sym(lib, &cr);\n                let freef: Symbol<FnPtrToUsize> = sym(lib, &fr);\n                let dctx = unsafe { create() };\n                let v = if n == 7 {\n                    let f: Symbol<unsafe extern \"C\" fn(*const c_void) -> usize> =\n                        sym(lib, &szname);\n                    unsafe { f(dctx) }\n                } else {\n                    let f: Symbol<FnVoidToUsize> = sym(lib, &szname);\n                    unsafe { f() }\n                };\n                let fr_ = unsafe { freef(dctx) };\n                vec![format!(\"size={v}\"), format!(\"free={}\", rr(fr_))]\n            });\n        }\n\n        // decompressBegin_usingDict + decompressBlock + nextSrcSizeToDecompress\n        let dbud = format!(\"ZSTDv0{n}_decompressBegin_usingDict\");\n        let dblk = format!(\"ZSTDv0{n}_decompressBlock\");\n        if have(&[&dbud, &dblk]) {\n            for (tag, src) in &corp {\n                for use_dict in [false, true] {\n                    diff_pair(\n                        &format!(\"ZSTDv0{n} begin_usingDict+decompressBlock {tag} dict={use_dict}\"),\n                        |lib| {\n                            let create: Symbol<FnVoidToPtr> = sym(lib, &cr);\n                            let freef: Symbol<FnPtrToUsize> = sym(lib, &fr);\n                            let beg: Symbol<FnCtxDict> = sym(lib, &dbud);\n                            let blk: Symbol<FnDec5> = sym(lib, &dblk);\n                            let mut log = Vec::new();\n                            let dctx = unsafe { create() };\n                            if dctx.is_null() {\n                                return (vec![\"null ctx\".into()], Vec::new());\n                            }\n                            let (dp, ds) = if use_dict {\n                                (dict.as_ptr() as *const c_void, dict.len())\n                            } else {\n                                (std::ptr::null(), 0)\n                            };\n                            log.push(format!(\"begin={}\", rr(unsafe { beg(dctx, dp, ds) })));\n                            let s = padded(src);\n                            let cap = 1usize << 17;\n                            let mut out = vec![0u8; cap + 4096];\n                            let ret = unsafe {\n                                blk(\n                                    dctx,\n                                    out.as_mut_ptr() as *mut c_void,\n                                    cap,\n                                    s.as_ptr() as *const c_void,\n                                    src.len(),\n                                )\n                            };\n                            log.push(format!(\"block={}\", rr(ret)));\n                            log.push(format!(\"out={}\", hx(&out[..cap])));\n                            log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n                            (log, out[..4096].to_vec())\n                        },\n                    );\n                }\n            }\n        }\n\n        // decompress_usingDict\n        let dud = format!(\"ZSTDv0{n}_decompress_usingDict\");\n        if both_have(&dud) {\n            for (tag, src) in &corp {\n                for use_dict in [false, true] {\n                    diff_pair(&format!(\"{dud} {tag} dict={use_dict}\"), |lib| {\n                        let create: Symbol<FnVoidToPtr> = sym(lib, &cr);\n                        let freef: Symbol<FnPtrToUsize> = sym(lib, &fr);\n                        let f: Symbol<FnDecDict> = sym(lib, &dud);\n                        let dctx = unsafe { create() };\n                        if dctx.is_null() {\n                            return (vec![\"null ctx\".into()], Vec::new());\n                        }\n                        let (dp, ds) = if use_dict {\n                            (dict.as_ptr() as *const c_void, dict.len())\n                        } else {\n                            (std::ptr::null(), 0)\n                        };\n                        let s = padded(src);\n                        let cap = 65536usize;\n                        let mut out = vec![0u8; cap + 4096];\n                        let ret = unsafe {\n                            f(\n                                dctx,\n                                out.as_mut_ptr() as *mut c_void,\n                                cap,\n                                s.as_ptr() as *const c_void,\n                                src.len(),\n                                dp,\n                                ds,\n                            )\n                        };\n                        let log = vec![\n                            format!(\"ret={}\", rr(ret)),\n                            format!(\"out={}\", hx(&out[..cap])),\n                            format!(\"free={}\", rr(unsafe { freef(dctx) })),\n                        ];\n                        (log, out[..4096].to_vec())\n                    });\n                }\n            }\n        }\n\n        // decompress_usingPreparedDCtx + copyDCtx\n        let dpd = format!(\"ZSTDv0{n}_decompress_usingPreparedDCtx\");\n        let cpy = format!(\"ZSTDv0{n}_copyDCtx\");\n        if have(&[&dpd, &cpy, &dbud]) {\n            for (tag, src) in &corp {\n                diff_pair(&format!(\"{dpd} {tag}\"), |lib| {\n                    let create: Symbol<FnVoidToPtr> = sym(lib, &cr);\n                    let freef: Symbol<FnPtrToUsize> = sym(lib, &fr);\n                    let beg: Symbol<FnCtxDict> = sym(lib, &dbud);\n                    let f: Symbol<FnDecPrepared> = sym(lib, &dpd);\n                    let cp: Symbol<unsafe extern \"C\" fn(*mut c_void, *const c_void)> =\n                        sym(lib, &cpy);\n\n                    let refc = unsafe { create() };\n                    let dctx = unsafe { create() };\n                    if refc.is_null() || dctx.is_null() {\n                        return (vec![\"null ctx\".into()], Vec::new());\n                    }\n                    let mut log = Vec::new();\n                    log.push(format!(\"refbegin={}\", rr(unsafe {\n                        beg(refc, dict.as_ptr() as *const c_void, dict.len())\n                    })));\n                    let s = padded(src);\n                    let cap = 65536usize;\n                    let mut out = vec![0u8; cap + 4096];\n                    let ret = unsafe {\n                        f(\n                            dctx,\n                            refc as *const c_void,\n                            out.as_mut_ptr() as *mut c_void,\n                            cap,\n                            s.as_ptr() as *const c_void,\n                            src.len(),\n                        )\n                    };\n                    log.push(format!(\"prepared={}\", rr(ret)));\n                    log.push(format!(\"out={}\", hx(&out[..cap])));\n                    // copyDCtx: refc -> dctx, then a bufferless block decode\n                    unsafe { cp(dctx, refc as *const c_void) };\n                    let blkname = format!(\"ZSTDv0{n}_decompressBlock\");\n                    let blk: Symbol<FnDec5> = sym(lib, &blkname);\n                    let mut out2 = vec![0u8; cap + 4096];\n                    let ret2 = unsafe {\n                        blk(\n                            dctx,\n                            out2.as_mut_ptr() as *mut c_void,\n                            cap,\n                            s.as_ptr() as *const c_void,\n                            src.len(),\n                        )\n                    };\n                    log.push(format!(\"afterCopy.block={}\", rr(ret2)));\n                    log.push(format!(\"out2={}\", hx(&out2[..cap])));\n                    log.push(format!(\"free1={}\", rr(unsafe { freef(dctx) })));\n                    log.push(format!(\"free2={}\", rr(unsafe { freef(refc) })));\n                    let mut bytes = out[..2048].to_vec();\n                    bytes.extend_from_slice(&out2[..2048]);\n                    (log, bytes)\n                });\n            }\n        }\n    }\n}\n\n#[test]\nfn legacy_v07_ddict_and_misc_matches() {\n    let corp = corpus();\n    let mut rng = Rng::new(0x07DD_1234);\n    let dict = gen(Shape::Text, 2500, &mut rng);\n\n    if both_have(\"ZSTDv07_estimateDCtxSize\") {\n        diff_log(\"ZSTDv07_estimateDCtxSize\", |lib| {\n            let f: Symbol<FnVoidToUsize> = sym(lib, \"ZSTDv07_estimateDCtxSize\");\n            unsafe { vec![format!(\"{}\", f())] }\n        });\n    }\n\n    if both_have(\"ZSTDv07_getDecompressedSize\") {\n        for (tag, src) in &corp {\n            diff_log(&format!(\"ZSTDv07_getDecompressedSize {tag}\"), |lib| {\n                let f: Symbol<unsafe extern \"C\" fn(*const c_void, usize) -> u64> =\n                    sym(lib, \"ZSTDv07_getDecompressedSize\");\n                let s = padded(src);\n                unsafe { vec![format!(\"{}\", f(s.as_ptr() as *const c_void, src.len()))] }\n            });\n        }\n    }\n\n    if have(&[\n        \"ZSTDv07_createDDict\",\n        \"ZSTDv07_freeDDict\",\n        \"ZSTDv07_decompress_usingDDict\",\n        \"ZSTDv07_createDCtx\",\n        \"ZSTDv07_freeDCtx\",\n    ]) {\n        for (tag, src) in &corp {\n            for dictlen in [0usize, 2500] {\n                diff_pair(\n                    &format!(\"ZSTDv07_decompress_usingDDict {tag} dictlen={dictlen}\"),\n                    |lib| {\n                        let mkdd: Symbol<\n                            unsafe extern \"C\" fn(*const c_void, usize) -> *mut c_void,\n                        > = sym(lib, \"ZSTDv07_createDDict\");\n                        let fredd: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_freeDDict\");\n                        let create: Symbol<FnVoidToPtr> = sym(lib, \"ZSTDv07_createDCtx\");\n                        let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_freeDCtx\");\n                        let f: Symbol<\n                            unsafe extern \"C\" fn(\n                                *mut c_void,\n                                *mut c_void,\n                                usize,\n                                *const c_void,\n                                usize,\n                                *const c_void,\n                            ) -> usize,\n                        > = sym(lib, \"ZSTDv07_decompress_usingDDict\");\n\n                        let mut log = Vec::new();\n                        let dd = unsafe {\n                            mkdd(dict.as_ptr() as *const c_void, dictlen)\n                        };\n                        log.push(format!(\"ddict.null={}\", dd.is_null()));\n                        let dctx = unsafe { create() };\n                        let s = padded(src);\n                        let cap = 65536usize;\n                        let mut out = vec![0u8; cap + 4096];\n                        let ret = unsafe {\n                            f(\n                                dctx,\n                                out.as_mut_ptr() as *mut c_void,\n                                cap,\n                                s.as_ptr() as *const c_void,\n                                src.len(),\n                                dd as *const c_void,\n                            )\n                        };\n                        log.push(format!(\"ret={}\", rr(ret)));\n                        log.push(format!(\"out={}\", hx(&out[..cap])));\n                        log.push(format!(\"freeDCtx={}\", rr(unsafe { freef(dctx) })));\n                        log.push(format!(\"freeDDict={}\", rr(unsafe { fredd(dd) })));\n                        (log, out[..4096].to_vec())\n                    },\n                );\n            }\n        }\n    }\n\n    if have(&[\"ZSTDv07_isSkipFrame\", \"ZSTDv07_createDCtx\", \"ZSTDv07_decompressBegin\"]) {\n        for (tag, src) in &corp {\n            diff_log(&format!(\"ZSTDv07_isSkipFrame {tag}\"), |lib| {\n                let create: Symbol<FnVoidToPtr> = sym(lib, \"ZSTDv07_createDCtx\");\n                let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_freeDCtx\");\n                let beg: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_decompressBegin\");\n                let nx: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_nextSrcSizeToDecompress\");\n                let cont: Symbol<FnDec5> = sym(lib, \"ZSTDv07_decompressContinue\");\n                let skip: Symbol<unsafe extern \"C\" fn(*mut c_void) -> i32> =\n                    sym(lib, \"ZSTDv07_isSkipFrame\");\n                let mut log = Vec::new();\n                let dctx = unsafe { create() };\n                log.push(format!(\"begin={}\", rr(unsafe { beg(dctx) })));\n                log.push(format!(\"skip0={}\", unsafe { skip(dctx) }));\n                let s = padded(src);\n                let ns = unsafe { nx(dctx) };\n                log.push(format!(\"next={}\", rr(ns)));\n                if !is_error(ns) && ns > 0 && ns <= src.len() {\n                    let cap = 4096usize;\n                    let mut out = vec![0u8; cap + 4096];\n                    let ret = unsafe {\n                        cont(\n                            dctx,\n                            out.as_mut_ptr() as *mut c_void,\n                            cap,\n                            s.as_ptr() as *const c_void,\n                            ns,\n                        )\n                    };\n                    log.push(format!(\"cont={}\", rr(ret)));\n                    log.push(format!(\"skip1={}\", unsafe { skip(dctx) }));\n                }\n                log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n                log\n            });\n        }\n    }\n\n    if have(&[\"ZSTDv07_insertBlock\", \"ZSTDv07_createDCtx\", \"ZSTDv07_decompressBegin\"]) {\n        diff_log(\"ZSTDv07_insertBlock\", |lib| {\n            let create: Symbol<FnVoidToPtr> = sym(lib, \"ZSTDv07_createDCtx\");\n            let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_freeDCtx\");\n            let beg: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_decompressBegin\");\n            let ins: Symbol<FnCtxDict> = sym(lib, \"ZSTDv07_insertBlock\");\n            let mut log = Vec::new();\n            let dctx = unsafe { create() };\n            log.push(format!(\"begin={}\", rr(unsafe { beg(dctx) })));\n            let blk = vec![0x5Au8; 1000];\n            for n in [0usize, 1, 500, 1000] {\n                let r = unsafe { ins(dctx, blk.as_ptr() as *const c_void, n) };\n                log.push(format!(\"insert({n})={}\", rr(r)));\n            }\n            log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n            log\n        });\n    }\n\n    if both_have(\"ZSTDv07_createDCtx_advanced\") {\n        diff_log(\"ZSTDv07_createDCtx_advanced\", |lib| {\n            let f: Symbol<FnCreateAdvanced> = sym(lib, \"ZSTDv07_createDCtx_advanced\");\n            let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZSTDv07_freeDCtx\");\n            let dec: Symbol<FnDec5> = sym(lib, \"ZSTDv07_decompressDCtx\");\n            let mut log = Vec::new();\n            let dctx = unsafe { f(custom_mem()) };\n            log.push(format!(\"null={}\", dctx.is_null()));\n            if !dctx.is_null() {\n                let src = [0x27u8, 0xB5, 0x2F, 0xFD, 0, 0, 0, 0, 0, 0, 0, 0];\n                let mut out = vec![0u8; 8192];\n                let ret = unsafe {\n                    dec(\n                        dctx,\n                        out.as_mut_ptr() as *mut c_void,\n                        4096,\n                        src.as_ptr() as *const c_void,\n                        src.len(),\n                    )\n                };\n                log.push(format!(\"dec={}\", rr(ret)));\n                log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n            }\n            log\n        });\n    }\n}\n\n#[test]\nfn legacy_zbuff_streaming_matches() {\n    let corp = corpus();\n    let mut rng = Rng::new(0x2B04_0007);\n    let dict = gen(Shape::Text, 1500, &mut rng);\n\n    for n in 4..=7u32 {\n        let cr = format!(\"ZBUFFv0{n}_createDCtx\");\n        let fr = format!(\"ZBUFFv0{n}_freeDCtx\");\n        let ini = format!(\"ZBUFFv0{n}_decompressInit\");\n        let co = format!(\"ZBUFFv0{n}_decompressContinue\");\n        if !have(&[&cr, &fr, &ini, &co]) {\n            continue;\n        }\n        // recommended sizes\n        for s in [\n            format!(\"ZBUFFv0{n}_recommendedDInSize\"),\n            format!(\"ZBUFFv0{n}_recommendedDOutSize\"),\n        ] {\n            if both_have(&s) {\n                let (c, r) = pair::<FnVoidToUsize>(&s);\n                unsafe { assert_eq!(c(), r(), \"{s}\") };\n            }\n        }\n\n        // dictionary init variants\n        let dict_init = if n == 4 {\n            format!(\"ZBUFFv04_decompressWithDictionary\")\n        } else {\n            format!(\"ZBUFFv0{n}_decompressInitDictionary\")\n        };\n        let have_dict_init = both_have(&dict_init);\n\n        for (tag, src) in &corp {\n            for &(inc, outc) in &[(usize::MAX / 4, 1usize << 17), (11usize, 9usize)] {\n                for use_dict in [false, true] {\n                    if use_dict && !have_dict_init {\n                        continue;\n                    }\n                    diff_pair(\n                        &format!(\n                            \"ZBUFFv0{n} stream {tag} in={inc} out={outc} dict={use_dict}\"\n                        ),\n                        |lib| {\n                            let create: Symbol<FnVoidToPtr> = sym(lib, &cr);\n                            let freef: Symbol<FnPtrToUsize> = sym(lib, &fr);\n                            let dc: Symbol<FnZbContinue> = sym(lib, &co);\n                            let mut log = Vec::new();\n                            let dctx = unsafe { create() };\n                            log.push(format!(\"null={}\", dctx.is_null()));\n                            if dctx.is_null() {\n                                return (log, Vec::new());\n                            }\n                            // v04's decompressWithDictionary only *sets* the\n                            // dictionary; decompressInit is still required.\n                            if n == 4 {\n                                let i: Symbol<FnPtrToUsize> = sym(lib, &ini);\n                                log.push(format!(\"init={}\", rr(unsafe { i(dctx) })));\n                                if use_dict {\n                                    let d: Symbol<FnCtxDict> = sym(lib, &dict_init);\n                                    log.push(format!(\n                                        \"withDict={}\",\n                                        rr(unsafe {\n                                            d(dctx, dict.as_ptr() as *const c_void, dict.len())\n                                        })\n                                    ));\n                                }\n                            } else if use_dict {\n                                let d: Symbol<FnCtxDict> = sym(lib, &dict_init);\n                                log.push(format!(\n                                    \"initDict={}\",\n                                    rr(unsafe {\n                                        d(dctx, dict.as_ptr() as *const c_void, dict.len())\n                                    })\n                                ));\n                            } else {\n                                let i: Symbol<FnPtrToUsize> = sym(lib, &ini);\n                                log.push(format!(\"init={}\", rr(unsafe { i(dctx) })));\n                            }\n\n                            let mut outbuf = vec![0u8; outc + 64];\n                            let s = padded(src);\n                            let mut acc: Vec<u8> = Vec::new();\n                            let mut pos = 0usize;\n                            for step in 0..4096 {\n                                let mut dcap = outc;\n                                let mut ssz = (src.len() - pos).min(inc);\n                                let ret = unsafe {\n                                    dc(\n                                        dctx,\n                                        outbuf.as_mut_ptr() as *mut c_void,\n                                        &mut dcap as *mut usize,\n                                        s[pos..].as_ptr() as *const c_void,\n                                        &mut ssz as *mut usize,\n                                    )\n                                };\n                                log.push(format!(\n                                    \"s{step}@{pos} ret={} dcap={dcap} ssz={ssz}\",\n                                    rr(ret)\n                                ));\n                                if is_error(ret) {\n                                    break;\n                                }\n                                acc.extend_from_slice(&outbuf[..dcap.min(outbuf.len())]);\n                                pos += ssz;\n                                if ret == 0 {\n                                    log.push(format!(\"done@{pos}/{}\", src.len()));\n                                    break;\n                                }\n                                if ssz == 0 && dcap == 0 {\n                                    log.push(\"STALL\".into());\n                                    break;\n                                }\n                            }\n                            log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n                            log.push(format!(\"acc={}\", hx(&acc)));\n                            (log, acc)\n                        },\n                    );\n                }\n            }\n        }\n    }\n\n    // ZBUFFv07_createDCtx_advanced\n    if both_have(\"ZBUFFv07_createDCtx_advanced\") {\n        diff_log(\"ZBUFFv07_createDCtx_advanced\", |lib| {\n            let f: Symbol<FnCreateAdvanced> = sym(lib, \"ZBUFFv07_createDCtx_advanced\");\n            let freef: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFFv07_freeDCtx\");\n            let ini: Symbol<FnPtrToUsize> = sym(lib, \"ZBUFFv07_decompressInit\");\n            let dc: Symbol<FnZbContinue> = sym(lib, \"ZBUFFv07_decompressContinue\");\n            let mut log = Vec::new();\n            let dctx = unsafe { f(custom_mem()) };\n            log.push(format!(\"null={}\", dctx.is_null()));\n            if !dctx.is_null() {\n                log.push(format!(\"init={}\", rr(unsafe { ini(dctx) })));\n                let src = [0x27u8, 0xB5, 0x2F, 0xFD, 1, 2, 3, 4, 5, 6, 7, 8];\n                let mut out = vec![0u8; 1 << 18];\n                let mut dcap = 1usize << 17;\n                let mut ssz = src.len();\n                let ret = unsafe {\n                    dc(\n                        dctx,\n                        out.as_mut_ptr() as *mut c_void,\n                        &mut dcap,\n                        src.as_ptr() as *const c_void,\n                        &mut ssz,\n                    )\n                };\n                log.push(format!(\"dc ret={} dcap={dcap} ssz={ssz}\", rr(ret)));\n                log.push(format!(\"free={}\", rr(unsafe { freef(dctx) })));\n            }\n            log\n        });\n    }\n}\n\n// ===========================================================================\n//  FSEv0N_* / HUFv0N_*  (internal but exported)\n// ===========================================================================\n\n/// A valid normalized FSE distribution over `maxSV+1` symbols with `tableLog`.\nfn norm_counts(max_sv: u32, table_log: u32) -> Vec<i16> {\n    let total = 1i32 << table_log;\n    let n = (max_sv + 1) as usize;\n    let mut v = vec![0i16; 256];\n    let each = total / n as i32;\n    let mut acc = 0i32;\n    for i in 0..n {\n        let c = if i + 1 == n { total - acc } else { each.max(1) };\n        v[i] = c as i16;\n        acc += c;\n    }\n    v\n}\n\n#[test]\nfn legacy_fse_api_matches() {\n    let corp = corpus();\n    for n in 5..=7u32 {\n        let cdt = format!(\"FSEv0{n}_createDTable\");\n        let fdt = format!(\"FSEv0{n}_freeDTable\");\n        if !have(&[&cdt, &fdt]) {\n            continue;\n        }\n\n        // createDTable / freeDTable\n        diff_log(&format!(\"FSEv0{n}_createDTable/freeDTable\"), |lib| {\n            let c: Symbol<FnFseCreateDTable> = sym(lib, &cdt);\n            let f: Symbol<FnFseFreeDTable> = sym(lib, &fdt);\n            let mut log = Vec::new();\n            for tl in [0u32, 1, 5, 9, 12] {\n                let p = unsafe { c(tl) };\n                log.push(format!(\"tl{tl}.null={}\", p.is_null()));\n                unsafe { f(p) };\n            }\n            // freeing NULL must be a no-op in both\n            unsafe { f(std::ptr::null_mut()) };\n            log.push(\"freeNull ok\".into());\n            log\n        });\n\n        // buildDTable_raw / _rle -> compare the FULL table image\n        let raw = format!(\"FSEv0{n}_buildDTable_raw\");\n        let rle = format!(\"FSEv0{n}_buildDTable_rle\");\n        if have(&[&raw, &rle]) {\n            diff_pair(&format!(\"FSEv0{n}_buildDTable_raw/rle\"), |lib| {\n                let c: Symbol<FnFseCreateDTable> = sym(lib, &cdt);\n                let f: Symbol<FnFseFreeDTable> = sym(lib, &fdt);\n                let br: Symbol<FnFseBuildRaw> = sym(lib, &raw);\n                let bl: Symbol<FnFseBuildRle> = sym(lib, &rle);\n                let mut log = Vec::new();\n                let mut bytes = Vec::new();\n                for nb in [0u32, 1, 4, 8, 12] {\n                    let words = 1usize + (1usize << nb);\n                    let dt = unsafe { c(nb) };\n                    if dt.is_null() {\n                        log.push(format!(\"raw{nb}: null table\"));\n                        continue;\n                    }\n                    unsafe { std::ptr::write_bytes(dt as *mut u8, 0, words * 4) };\n                    let ret = unsafe { br(dt, nb) };\n                    log.push(format!(\"raw({nb})={}\", rr(ret)));\n                    let img =\n                        unsafe { std::slice::from_raw_parts(dt as *const u8, words * 4) };\n                    log.push(format!(\"raw({nb}).table={}\", hx(img)));\n                    bytes.extend_from_slice(&img[..img.len().min(2048)]);\n                    unsafe { f(dt) };\n                }\n                for symv in [0u8, 1, 127, 255] {\n                    let dt = unsafe { c(0) };\n                    if dt.is_null() {\n                        continue;\n                    }\n                    unsafe { std::ptr::write_bytes(dt as *mut u8, 0, 8) };\n                    let ret = unsafe { bl(dt, symv) };\n                    log.push(format!(\"rle({symv})={}\", rr(ret)));\n                    let img = unsafe { std::slice::from_raw_parts(dt as *const u8, 8) };\n                    log.push(format!(\"rle({symv}).table={}\", hx(img)));\n                    bytes.extend_from_slice(img);\n                    unsafe { f(dt) };\n                }\n                (log, bytes)\n            });\n        }\n\n        // buildDTable with valid + invalid normalized counters\n        let bdt = format!(\"FSEv0{n}_buildDTable\");\n        if both_have(&bdt) {\n            diff_pair(&format!(\"FSEv0{n}_buildDTable\"), |lib| {\n                let c: Symbol<FnFseCreateDTable> = sym(lib, &cdt);\n                let f: Symbol<FnFseFreeDTable> = sym(lib, &fdt);\n                let b: Symbol<FnFseBuildDTable> = sym(lib, &bdt);\n                let mut log = Vec::new();\n                let mut bytes = Vec::new();\n                for &(max_sv, tl) in\n                    &[(3u32, 5u32), (15, 7), (63, 9), (255, 12), (3, 13), (3, 0), (0, 5)]\n                {\n                    let counts = norm_counts(max_sv, tl.min(12));\n                    let words = 1usize + (1usize << tl.min(12));\n                    let dt = unsafe { c(tl.min(12)) };\n                    if dt.is_null() {\n                        continue;\n                    }\n                    unsafe { std::ptr::write_bytes(dt as *mut u8, 0, words * 4) };\n                    let ret = unsafe { b(dt, counts.as_ptr(), max_sv, tl) };\n                    log.push(format!(\"build(sv={max_sv},tl={tl})={}\", rr(ret)));\n                    let img =\n                        unsafe { std::slice::from_raw_parts(dt as *const u8, words * 4) };\n                    log.push(format!(\"table={}\", hx(img)));\n                    bytes.extend_from_slice(&img[..img.len().min(2048)]);\n                    unsafe { f(dt) };\n                }\n                (log, bytes)\n            });\n        }\n\n        // readNCount over the corpus\n        let rnc = format!(\"FSEv0{n}_readNCount\");\n        if both_have(&rnc) {\n            for (tag, src) in &corp {\n                diff_pair(&format!(\"{rnc} {tag}\"), |lib| {\n                    let f: Symbol<FnFseReadNCount> = sym(lib, &rnc);\n                    let s = padded(src);\n                    let mut counts = vec![0x7B7Bi16; 256];\n                    let mut max_sv: u32 = 255;\n                    let mut table_log: u32 = 0xFFFF_FFFF;\n                    let ret = unsafe {\n                        f(\n                            counts.as_mut_ptr(),\n                            &mut max_sv as *mut u32,\n                            &mut table_log as *mut u32,\n                            s.as_ptr() as *const c_void,\n                            src.len(),\n                        )\n                    };\n                    let bytes: Vec<u8> =\n                        counts.iter().flat_map(|c| c.to_le_bytes()).collect();\n                    let log = vec![\n                        format!(\"ret={}\", rr(ret)),\n                        format!(\"maxSV={max_sv} tableLog={table_log}\"),\n                        format!(\"counts={}\", hx(&bytes)),\n                    ];\n                    (log, bytes)\n                });\n            }\n        }\n\n        // decompress over the corpus\n        let dec = format!(\"FSEv0{n}_decompress\");\n        if both_have(&dec) {\n            for (tag, src) in &corp {\n                for &cap in &[0usize, 1, 1024, 65536] {\n                    diff_pair(&format!(\"{dec} {tag} cap={cap}\"), |lib| {\n                        let f: Symbol<FnDec4> = sym(lib, &dec);\n                        let s = padded(src);\n                        let mut d = vec![0u8; cap + 4096];\n                        let ret = unsafe {\n                            f(\n                                d.as_mut_ptr() as *mut c_void,\n                                cap,\n                                s.as_ptr() as *const c_void,\n                                src.len(),\n                            )\n                        };\n                        (\n                            vec![format!(\"ret={}\", rr(ret)), format!(\"dst={}\", hx(&d[..cap]))],\n                            d[..cap.min(4096)].to_vec(),\n                        )\n                    });\n                }\n            }\n        }\n\n        // decompress_usingDTable on a *valid* table + arbitrary bitstreams\n        let dud = format!(\"FSEv0{n}_decompress_usingDTable\");\n        if have(&[&dud, &bdt]) {\n            for (tag, src) in &corp {\n                diff_pair(&format!(\"{dud} {tag}\"), |lib| {\n                    let c: Symbol<FnFseCreateDTable> = sym(lib, &cdt);\n                    let fr: Symbol<FnFseFreeDTable> = sym(lib, &fdt);\n                    let b: Symbol<FnFseBuildDTable> = sym(lib, &bdt);\n                    let f: Symbol<FnFseDecUsingDTable> = sym(lib, &dud);\n                    let mut log = Vec::new();\n                    let tl = 9u32;\n                    let words = 1usize + (1usize << tl);\n                    let dt = unsafe { c(tl) };\n                    if dt.is_null() {\n                        return (vec![\"null dt\".into()], Vec::new());\n                    }\n                    unsafe { std::ptr::write_bytes(dt as *mut u8, 0, words * 4) };\n                    let counts = norm_counts(31, tl);\n                    log.push(format!(\"build={}\", rr(unsafe { b(dt, counts.as_ptr(), 31, tl) })));\n                    let s = padded(src);\n                    let cap = 4096usize;\n                    let mut d = vec![0u8; cap + 4096];\n                    let ret = unsafe {\n                        f(\n                            d.as_mut_ptr() as *mut c_void,\n                            cap,\n                            s.as_ptr() as *const c_void,\n                            src.len(),\n                            dt as *const u32,\n                        )\n                    };\n                    log.push(format!(\"ret={}\", rr(ret)));\n                    log.push(format!(\"dst={}\", hx(&d[..cap])));\n                    unsafe { fr(dt) };\n                    (log, d[..cap].to_vec())\n                });\n            }\n        }\n    }\n}\n\n#[test]\nfn legacy_huf_api_matches() {\n    let corp = corpus();\n\n    for n in 5..=7u32 {\n        // plain decompress entry points\n        for base in [\n            format!(\"HUFv0{n}_decompress\"),\n            format!(\"HUFv0{n}_decompress1X2\"),\n            format!(\"HUFv0{n}_decompress1X4\"),\n            format!(\"HUFv0{n}_decompress4X2\"),\n            format!(\"HUFv0{n}_decompress4X4\"),\n        ] {\n            if !both_have(&base) {\n                continue;\n            }\n            for (tag, src) in &corp {\n                for &cap in &[1usize, 100, 4096, 65536] {\n                    diff_pair(&format!(\"{base} {tag} cap={cap}\"), |lib| {\n                        let f: Symbol<FnDec4> = sym(lib, &base);\n                        let s = padded(src);\n                        let mut d = vec![0u8; cap + 4096];\n                        let ret = unsafe {\n                            f(\n                                d.as_mut_ptr() as *mut c_void,\n                                cap,\n                                s.as_ptr() as *const c_void,\n                                src.len(),\n                            )\n                        };\n                        (\n                            vec![format!(\"ret={}\", rr(ret)), format!(\"dst={}\", hx(&d[..cap]))],\n                            d[..cap.min(4096)].to_vec(),\n                        )\n                    });\n                }\n            }\n        }\n\n        // readDTableX2 / X4 -> compare the full table image\n        let x2 = format!(\"HUFv0{n}_readDTableX2\");\n        let x4 = format!(\"HUFv0{n}_readDTableX4\");\n        if both_have(&x2) {\n            for (tag, src) in &corp {\n                diff_pair(&format!(\"{x2} {tag}\"), |lib| {\n                    let s = padded(src);\n                    if n == 7 {\n                        // HUFv07_DTable is U32; desc word mirrors\n                        // HUFv07_CREATE_STATIC_DTABLEX2(_, 12) -> 11*0x1000001\n                        let f: Symbol<FnHufReadDTableU32> = sym(lib, &x2);\n                        let mut dt = vec![0u32; 8200];\n                        dt[0] = 11u32.wrapping_mul(0x0100_0001);\n                        let ret = unsafe {\n                            f(dt.as_mut_ptr(), s.as_ptr() as *const c_void, src.len())\n                        };\n                        let bytes: Vec<u8> =\n                            dt.iter().flat_map(|w| w.to_le_bytes()).collect();\n                        (\n                            vec![format!(\"ret={}\", rr(ret)), format!(\"dt={}\", hx(&bytes))],\n                            bytes,\n                        )\n                    } else {\n                        let f: Symbol<FnHufReadDTableU16> = sym(lib, &x2);\n                        let mut dt = vec![0u16; 1 + (1 << 12)];\n                        dt[0] = 12;\n                        let ret = unsafe {\n                            f(dt.as_mut_ptr(), s.as_ptr() as *const c_void, src.len())\n                        };\n                        let bytes: Vec<u8> =\n                            dt.iter().flat_map(|w| w.to_le_bytes()).collect();\n                        (\n                            vec![format!(\"ret={}\", rr(ret)), format!(\"dt={}\", hx(&bytes))],\n                            bytes,\n                        )\n                    }\n                });\n            }\n        }\n        if both_have(&x4) {\n            for (tag, src) in &corp {\n                diff_pair(&format!(\"{x4} {tag}\"), |lib| {\n                    let f: Symbol<FnHufReadDTableU32> = sym(lib, &x4);\n                    let s = padded(src);\n                    let mut dt = vec![0u32; 8200];\n                    dt[0] = if n == 7 { 12u32.wrapping_mul(0x0100_0001) } else { 12 };\n                    let ret =\n                        unsafe { f(dt.as_mut_ptr(), s.as_ptr() as *const c_void, src.len()) };\n                    let bytes: Vec<u8> = dt.iter().flat_map(|w| w.to_le_bytes()).collect();\n                    (\n                        vec![format!(\"ret={}\", rr(ret)), format!(\"dt={}\", hx(&bytes))],\n                        bytes,\n                    )\n                });\n            }\n        }\n\n        // *_usingDTable on a table produced by readDTableX2 (when it succeeded)\n        for (tab, usename) in [\n            (x2.clone(), format!(\"HUFv0{n}_decompress1X2_usingDTable\")),\n            (x2.clone(), format!(\"HUFv0{n}_decompress4X2_usingDTable\")),\n        ] {\n            if !have(&[&tab, &usename]) {\n                continue;\n            }\n            for (tag, src) in &corp {\n                diff_pair(&format!(\"{usename} {tag}\"), |lib| {\n                    let s = padded(src);\n                    let cap = 4096usize;\n                    let mut d = vec![0u8; cap + 4096];\n                    let mut log = Vec::new();\n                    if n == 7 {\n                        let rd: Symbol<FnHufReadDTableU32> = sym(lib, &tab);\n                        let f: Symbol<FnHufDecUsingDTableU32> = sym(lib, &usename);\n                        let mut dt = vec![0u32; 8200];\n                        dt[0] = 11u32.wrapping_mul(0x0100_0001);\n                        let rr0 = unsafe {\n                            rd(dt.as_mut_ptr(), s.as_ptr() as *const c_void, src.len())\n                        };\n                        log.push(format!(\"read={}\", rr(rr0)));\n                        if !is_error(rr0) && rr0 <= src.len() {\n                            let ret = unsafe {\n                                f(\n                                    d.as_mut_ptr() as *mut c_void,\n                                    cap,\n                                    s[rr0..].as_ptr() as *const c_void,\n                                    src.len() - rr0,\n                                    dt.as_ptr(),\n                                )\n                            };\n                            log.push(format!(\"ret={}\", rr(ret)));\n                        }\n                    } else {\n                        let rd: Symbol<FnHufReadDTableU16> = sym(lib, &tab);\n                        let f: Symbol<FnHufDecUsingDTableU16> = sym(lib, &usename);\n                        let mut dt = vec![0u16; 1 + (1 << 12)];\n                        dt[0] = 12;\n                        let rr0 = unsafe {\n                            rd(dt.as_mut_ptr(), s.as_ptr() as *const c_void, src.len())\n                        };\n                        log.push(format!(\"read={}\", rr(rr0)));\n                        if !is_error(rr0) && rr0 <= src.len() {\n                            let ret = unsafe {\n                                f(\n                                    d.as_mut_ptr() as *mut c_void,\n                                    cap,\n                                    s[rr0..].as_ptr() as *const c_void,\n                                    src.len() - rr0,\n                                    dt.as_ptr(),\n                                )\n                            };\n                            log.push(format!(\"ret={}\", rr(ret)));\n                        }\n                    }\n                    log.push(format!(\"dst={}\", hx(&d[..cap])));\n                    (log, d[..cap].to_vec())\n                });\n            }\n        }\n    }\n\n    // v07-only helpers\n    if both_have(\"HUFv07_selectDecoder\") {\n        diff_log(\"HUFv07_selectDecoder\", |lib| {\n            let f: Symbol<FnHufSelectDecoder> = sym(lib, \"HUFv07_selectDecoder\");\n            let mut log = Vec::new();\n            for dst in [1usize, 2, 17, 256, 1000, 65536, 1 << 20] {\n                for csrc in [0usize, 1, 2, 16, 100, 1000, 60000] {\n                    if csrc > dst {\n                        continue;\n                    }\n                    log.push(format!(\"({dst},{csrc})={}\", unsafe { f(dst, csrc) }));\n                }\n            }\n            log\n        });\n    }\n    if both_have(\"HUFv07_readStats\") {\n        for (tag, src) in &corpus() {\n            diff_pair(&format!(\"HUFv07_readStats {tag}\"), |lib| {\n                let f: Symbol<FnHufReadStats> = sym(lib, \"HUFv07_readStats\");\n                let s = padded(src);\n                let mut w = vec![0x3Cu8; 256];\n                let mut ranks = vec![0x5A5A_5A5Au32; 17];\n                let mut nb: u32 = 0xFFFF_FFFF;\n                let mut tl: u32 = 0xEEEE_EEEE;\n                let ret = unsafe {\n                    f(\n                        w.as_mut_ptr(),\n                        256,\n                        ranks.as_mut_ptr(),\n                        &mut nb as *mut u32,\n                        &mut tl as *mut u32,\n                        s.as_ptr() as *const c_void,\n                        src.len(),\n                    )\n                };\n                let mut bytes = w.clone();\n                bytes.extend(ranks.iter().flat_map(|x| x.to_le_bytes()));\n                let log = vec![\n                    format!(\"ret={}\", rr(ret)),\n                    format!(\"nbSymbols={nb} tableLog={tl}\"),\n                    format!(\"weights={}\", hx(&w)),\n                    format!(\"ranks={:?}\", ranks),\n                ];\n                (log, bytes)\n            });\n        }\n    }\n    // v07 *_DCtx workspace variants\n    for name in [\"HUFv07_decompress4X_DCtx\", \"HUFv07_decompress1X_DCtx\"] {\n        if !both_have(name) {\n            continue;\n        }\n        for (tag, src) in &corpus() {\n            for &cap in &[1usize, 4096] {\n                diff_pair(&format!(\"{name} {tag} cap={cap}\"), |lib| {\n                    let f: Symbol<FnHufDCtx> = sym(lib, name);\n                    let s = padded(src);\n                    let mut ws = vec![0u32; 8200];\n                    ws[0] = 12u32.wrapping_mul(0x0100_0001);\n                    let mut d = vec![0u8; cap + 4096];\n                    let ret = unsafe {\n                        f(\n                            ws.as_mut_ptr(),\n                            d.as_mut_ptr() as *mut c_void,\n                            cap,\n                            s.as_ptr() as *const c_void,\n                            src.len(),\n                        )\n                    };\n                    (\n                        vec![format!(\"ret={}\", rr(ret)), format!(\"dst={}\", hx(&d[..cap]))],\n                        d[..cap].to_vec(),\n                    )\n                });\n            }\n        }\n    }\n}\n\n// ===========================================================================\n//  Randomised fuzz over magic-prefixed buffers\n// ===========================================================================\n\n#[test]\nfn legacy_fuzz_magic_prefixed_buffers() {\n    for n in 1..=7u32 {\n        let dec = format!(\"ZSTDv0{n}_decompress\");\n        let fsi = format!(\"ZSTDv0{n}_findFrameSizeInfoLegacy\");\n        if !both_have(&dec) {\n            continue;\n        }\n        let magic = MAGIC_BYTES[(n - 1) as usize].1;\n        let mut rng = Rng::new(0xF0_0000 + n as u64);\n        for case in 0..200usize {\n            let len = rng.range(0, 512);\n            let mut buf = Vec::with_capacity(4 + len);\n            // 1 in 8 cases: use a *wrong* magic to test rejection paths too\n            if case % 8 == 7 {\n                let other = MAGIC_BYTES[rng.below(MAGIC_BYTES.len())].1;\n                buf.extend_from_slice(&other);\n            } else {\n                buf.extend_from_slice(&magic);\n            }\n            for _ in 0..len {\n                buf.push(rng.byte());\n            }\n            // occasionally truncate below the magic\n            if case % 17 == 3 {\n                buf.truncate(rng.below(4));\n            }\n\n            let cap = if case % 3 == 0 { 4096usize } else { 65536 };\n            diff_pair(&format!(\"fuzz {dec} case={case} len={} cap={cap}\", buf.len()), |lib| {\n                let f: Symbol<FnDec4> = sym(lib, &dec);\n                let s = padded(&buf);\n                let mut d = vec![0u8; cap + 4096];\n                let ret = unsafe {\n                    f(\n                        d.as_mut_ptr() as *mut c_void,\n                        cap,\n                        s.as_ptr() as *const c_void,\n                        buf.len(),\n                    )\n                };\n                (\n                    vec![format!(\"ret={}\", rr(ret)), format!(\"dst={}\", hx(&d[..cap]))],\n    