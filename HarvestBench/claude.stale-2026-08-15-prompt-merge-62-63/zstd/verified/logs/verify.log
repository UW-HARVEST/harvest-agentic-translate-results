lib, \"ZSTD_referenceExternalSequences\")(\n                cctx,\n                empty.as_mut_ptr(),\n                0,\n            );\n            let cap = (api.compressBound)(src.len()) + 128;\n            let mut buf = vec![0u8; cap];\n            let ret =\n                (api.compress2)(cctx, as_ptr_m(&mut buf), cap, as_ptr_c(&src), src.len());\n            (api.freeCCtx)(cctx);\n            Out::ok(ret, &buf)\n        }\n    };\n    let c = run(capi());\n    same_out(ctx, &c, &run(rapi()));\n    same_out(&format!(\"{ctx} == plain\"), &plain, &c);\n\n    // A hand-built, trivially valid sequence set over a fully controlled input:\n    // 16 literals, then a 32-byte match at offset 16, repeated.\n    let mut synth = Vec::new();\n    for i in 0..64u32 {\n        synth.extend_from_slice(&[b'a' + (i % 16) as u8; 16]);\n    }\n    let seqs_template: Vec<RawSeq> = (0..8)\n        .map(|_| RawSeq { offset: 16, litLength: 16, matchLength: 32 })\n        .collect();\n    let total: usize = seqs_template\n        .iter()\n        .map(|s| s.litLength as usize + s.matchLength as usize)\n        .sum();\n    assert!(total <= synth.len());\n    let ctx2 = \"referenceExternalSequences(trivial valid prefix)\";\n    let run2 = |api: &Api| -> Out {\n        unsafe {\n            let cctx = (api.createCCtx)();\n            let _ = (api.setParameter)(cctx, ZSTD_c_compressionLevel, 3);\n            let mut seqs = seqs_template.clone();\n            let n = seqs.len();\n            sym::<FnRefExtSeqs>(api.lib, \"ZSTD_referenceExternalSequences\")(\n                cctx,\n                seqs.as_mut_ptr(),\n                n,\n            );\n            let cap = (api.compressBound)(synth.len()) + 128;\n            let mut buf = vec![0u8; cap];\n            let ret = (api.compress2)(\n                cctx,\n                as_ptr_m(&mut buf),\n                cap,\n                as_ptr_c(&synth),\n                synth.len(),\n            );\n            (api.freeCCtx)(cctx);\n            Out::ok(ret, &buf)\n        }\n    };\n    let c2 = run2(capi());\n    let r2 = run2(rapi());\n    same_out(ctx2, &c2, &r2);\n    if ok(c2.ret) {\n        for api in [capi(), rapi()] {\n            let d = decomp(api, &c2.bytes, synth.len());\n            assert!(ok(d.ret), \"{ctx2}: {} decompress err {}\", api.tag, err_code(d.ret));\n            assert_bytes_eq(&format!(\"{ctx2}/rt[{}]\", api.tag), &synth, &d.bytes);\n        }\n    }\n}\n\n#[test]\nfn p2_compress_sequences_extra_params() {\n    // minMatch / windowLog / repcodeResolution interactions on the sequence API.\n    let mut rng = Rng::new(0x2C_5E_00_22);\n    for &shape in &[Shape::Text, Shape::Records, Shape::Skewed] {\n        for &len in &[5000usize, 131_073] {\n            let src = gen(shape, len, &mut rng);\n            let (cret, delimited) = gen_seqs(capi(), 3, &src);\n            if is_error(cret) || delimited.is_empty() {\n                continue;\n            }\n            let min_ml = delimited\n                .iter()\n                .filter(|s| s.matchLength > 0)\n                .map(|s| s.matchLength)\n                .min()\n                .unwrap_or(3);\n            for &mm in &[3i32, 4, 5] {\n                if (mm as u32) > min_ml {\n                    continue;\n                }\n                for &rr in &[0i32, 1] {\n                    for &lvl in &[1i32, 3, 11, 19] {\n                        let ctx = format!(\n                            \"compressSequences+params shape={shape:?} len={len} minMatch={mm} \\\n                             repcodeResolution={rr} L={lvl}\"\n                        );\n                        let run = |api: &Api| -> Out {\n                            unsafe {\n                                let cctx = (api.createCCtx)();\n                                for &(p, v) in &[\n                                    (ZSTD_c_compressionLevel, lvl),\n                                    (ZSTD_c_blockDelimiters, 1),\n                                    (ZSTD_c_validateSequences, 1),\n                                    (ZSTD_c_minMatch, mm),\n                                    (ZSTD_c_repcodeResolution, rr),\n                                ] {\n                                    let x = (api.setParameter)(cctx, p, v);\n                                    if is_error(x) {\n                                        (api.freeCCtx)(cctx);\n                                        return Out::err(x);\n                                    }\n                                }\n                                let cap = (api.compressBound)(src.len()) + 256;\n                                let mut buf = vec![0u8; cap];\n                                let f = sym::<FnCompressSeqs>(\n                                    api.lib,\n                                    \"ZSTD_compressSequences\",\n                                );\n                                let ret = f(\n                                    cctx,\n                                    as_ptr_m(&mut buf),\n                                    cap,\n                                    delimited.as_ptr(),\n                                    delimited.len(),\n                                    as_ptr_c(&src),\n                                    src.len(),\n                                );\n                                (api.freeCCtx)(cctx);\n                                Out::ok(ret, &buf)\n                            }\n                        };\n                        let c = run(capi());\n                        let r = run(rapi());\n                        same_out(&ctx, &c, &r);\n                        if ok(c.ret) {\n                            for api in [capi(), rapi()] {\n                                let d = decomp(api, &c.bytes, src.len());\n                                assert!(ok(d.ret), \"{ctx}: {} decompress err\", api.tag);\n                                assert_bytes_eq(\n                                    &format!(\"{ctx}/rt[{}]\", api.tag),\n                                    &src,\n                                    &d.bytes,\n                                );\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n}\nRSEOF\ncd /local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust; cargo build --release --test phase_b_shapes_internals 2>&1 | grep -E \"^error\" -A 10 | head -40; echo BUILD_DONE","task_type":"local_bash","uuid":"ed2d35a7-38b7-4372-9402-8786a842b4d2","session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5"}
