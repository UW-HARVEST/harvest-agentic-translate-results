: *  3. build Huffman table from count using HUF_buildCTable()\n123: *  4. save Huffman table to memory buffer using HUF_writeCTable()\n124: *  5. encode the data stream using HUF_compress4X_usingCTable()\n125: *\n126: *  The following API allows targeting specific sub-functions for advanced tasks.\n127: *  For example, it's possible to compress several blocks using the same 'CTable',\n128: *  or to save and regenerate 'CTable' using external methods.\n129: */\n130:unsigned HUF_minTableLog(unsigned symbolCardinality);\n131:unsigned HUF_cardinality(const unsigned* count, unsigned maxSymbolValue);\n132:unsigned HUF_optimalTableLog(unsigned maxTableLog, size_t srcSize, unsigned maxSymbolValue, void* workSpace,\n133: size_t wkspSize, HUF_CElt* table, const unsigned* count, int flags); /* table is used as scratch space for building and testing tables, not a return value */\n134:size_t HUF_writeCTable_wksp(void* dst, size_t maxDstSize, const HUF_CElt* CTable, unsigned maxSymbolValue, unsigned huffLog, void* workspace, size_t workspaceSize);\n135:size_t HUF_compress4X_usingCTable(void* dst, size_t dstSize, const void* src, size_t srcSize, const HUF_CElt* CTable, int flags);\n136:size_t HUF_estimateCompressedSize(const HUF_CElt* CTable, const unsigned* count, unsigned maxSymbolValue);\n137:int HUF_validateCTable(const HUF_CElt* CTable, const unsigned* count, unsigned maxSymbolValue);\n138:\n139:typedef enum {\n140:   HUF_repeat_none,  /**< Cannot use the previous table */\n141:   HUF_repeat_check, /**< Can use the previous table but it must be checked. Note : The previous table must have been constructed by HUF_compress{1, 4}X_repeat */\n142:   HUF_repeat_valid  /**< Can use the previous table and it is assumed to be valid */\n143: } HUF_repeat;\n144:\n145:/** HUF_compress4X_repeat() :\n146: *  Same as HUF_compress4X_wksp(), but considers using hufTable if *repeat != HUF_repeat_none.\n147: *  If it uses hufTable it does not modify hufTable or repeat.\n148: *  If it doesn't,