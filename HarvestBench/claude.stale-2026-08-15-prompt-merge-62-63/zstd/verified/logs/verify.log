n185\t     * To match condition 1 we use a mask with hashRateLog bits set\n186\t     * and, because of the previous remark, we make sure these bits\n187\t     * have the highest possible weight while still respecting\n188\t     * condition 2.\n189\t     */\n190\t    if hashRateLog > 0 && hashRateLog <= maxBitsInMask {\n191\t        (*state).stopMask =\n192\t            (((1u64 << hashRateLog) - 1) as U64) << (maxBitsInMask - hashRateLog);\n193\t    } else {\n194\t        /* In this degenerate case we simply honor the hash rate. */\n195\t        (*state).stopMask = (1u64 << hashRateLog) - 1;\n196\t    }\n197\t}\n198\t\n199\t/** ZSTD_ldm_gear_reset()\n200\t * Feeds [data, data + minMatchLength) into the hash without registering any\n201\t * splits. This effectively resets the hash state. This is used when skipping\n202\t * over data, either at the beginning of a block, or skipping sections.\n203\t */\n204\tunsafe fn ZSTD_ldm_gear_reset(\n205\t    state: *mut ldmRollingHashState_t,\n206\t    data: *const u8,\n207\t    minMatchLength: usize,\n208\t) {\n209\t    let mut hash: U64 = (*state).rolling;\n210\t    let mut n: usize = 0;\n211\t\n212\t    macro_rules! gear_iter_once {\n213\t        () => {{\n214\t            hash = (hash << 1).wrapping_add(ZSTD_ldm_gearTab[(*data.add(n) & 0xff) as usize]);\n215\t            n += 1;\n216\t        }};\n217\t    }\n218\t    while n + 3 < minMatchLength {\n219\t        gear_iter_once!();\n220\t        gear_iter_once!();\n221\t        gear_iter_once!();\n222\t        gear_iter_once!();\n223\t    }\n224\t    while n < minMatchLength {\n225\t        gear_iter_once!();\n226\t    }\n227\t    (*state).rolling = hash;\n228\t}\n229\t\n230\t/** ZSTD_ldm_gear_feed():\n231\t *\n232\t * Registers in the splits array all the split points found in the first\n233\t * size bytes following the data pointer. This function terminates when\n234\t * either all the data has been processed or LDM_BATCH_SIZE splits are\n235\t * present in the splits array.\n236\t *\n237\t * Precondition: The splits array must not be full.\n238\t * Returns: The number of bytes processed. */\n239\tunsafe fn ZSTD_ldm_gear_feed(\n240\t    state: *mut ldmRollingHashState_t,\n241\t    data: *const u8,\n242\t    size: usize,\n243\t    splits: *mut usize,\n244\t    numSplits: *mut c_uint,\n245\t) -> usize {\n246\t    let mut hash: U64;\n247\t    let mask: U64;\n248\t    let mut n: usize;\n249\t\n250\t    hash = (*state).rolling;\n251\t    mask = (*state).stopMask;\n252\t    n = 0;\n253\t\n254\t    macro_rules! gear_iter_once {\n255\t        () => {{\n256\t            hash = (hash << 1).wrapping_add(ZSTD_ldm_gearTab[(*data.add(n) & 0xff) as usize]);\n257\t            n += 1;\n258\t            (hash & mask) == 0 && {\n259\t                *splits.add(*numSplits as usize) = n;\n260\t                *numSplits += 1;\n261\t                *numSplits as usize == LDM_BATCH_SIZE\n262\t            }\n263\t        }};\n264\t    }\n265\t\n266\t    'done: {\n267\t        while n + 3 < size {\n268\t            if gear_iter_once!() {\n269\t                break 'done;\n270\t            }\n271\t            if gear_iter_once!() {\n272\t                break 'done;\n273\t            }\n274\t            if gear_iter_once!() {\n275\t                break 'done;\n276\t            }\n277\t            if gear_iter_once!() {\n278\t                break 'done;\n279\t            }\n280\t        }\n281\t        while n < size {\n282\t            if gear_iter_once!() {\n283\t                break 'done;\n284\t            }\n285\t        }\n286\t    }\n287\t\n288\t    (*state).rolling = hash;\n289\t    n\n290\t}\n291\t\n292\t#[unsafe(no_mangle)]\n293\tpub unsafe extern \"C\" fn ZSTD_ldm_adjustParameters(\n294\t    params: *mut ldmParams_t,\n295\t    cParams: *const ZSTD_compressionParameters,\n296\t) {\n297\t    (*params).windowLog = (*cParams).windowLog;\n298\t    if (*params).hashRateLog == 0 {\n299\t        if (*params).hashLog > 0 {\n300\t            /* if params->hashLog is set, derive hashRateLog from it */\n301\t            if (*params).windowLog > (*params).hashLog {\n302\t                (*params).hashRateLog = (*params).windowLog - (*params).hashLog;\n303\t            }\n304\t        } else {\n305\t            /* mapping from [fast, rate7] to [btultra2, rate4] */\n306\t            (*params).hashRateLog = (7 - ((*cParams).strategy / 3)) as U32;\n307\t        }\n308\t    }\n309\t    if (*params).hashLog == 0 {\n310\t        (*params).hashLog = BOUNDED(\n311\t            ZSTD_HASHLOG_MIN,\n312\t            (*params).windowLog.wrapping_sub((*params).hashRateLog),\n313\t            ZSTD_HASHLOG_MAX,\n314\t        );\n315\t    }\n316\t    if (*params).minMatchLength == 0 {\n317\t        (*params).minMatchLength = LDM_MIN_MATCH_LENGTH;\n318\t        if (*cParams).strategy >= ZSTD_btultra {\n319\t            (*params).minMatchLength /= 2;\n320\t        }\n321\t    }\n322\t    if (*params).bucketSizeLog == 0 {\n323\t        (*params).bucketSizeLog = BOUNDED(\n324\t            LDM_BUCKET_SIZE_LOG,\n325\t            (*cParams).strategy as U32,\n326\t            ZSTD_LDM_BUCKETSIZELOG_MAX,\n327\t        );\n328\t    }\n329\t    (*params).bucketSizeLog = (*params).bucketSizeLog.min((*params).hashLog);\n330\t}\n331\t\n332\t#[inline]\n333\tfn BOUNDED(min: U32, val: U32, max: U32) -> U32 {\n334\t    min.max(val.min(max))\n335\t}\n336\t\n337\t#[unsafe(no_mangle)]\n338\tpub unsafe extern \"C\" fn ZSTD_ldm_getTableSize(params: ldmParams_t) -> usize {\n339\t    let ldmHSize: usize = 1usize << params.hashLog;\n340\t    let ldmBucketSizeLog: usize = (params.bucketSizeLog.min(params.hashLog)) as usize;\n341\t    let ldmBucketSize: usize = 1usize << ((params.hashLog as usize) - ldmBucketSizeLog);\n342\t    let totalSize: usize = ZSTD_cwksp_alloc_size(ldmBucketSize)\n343\t        + ZSTD_cwksp_alloc_size(ldmHSize * core::mem::size_of::<ldmEntry_t>());\n344\t    if params.enableLdm == ZSTD_ps_enable {\n345\t        totalSize\n346\t    } else {\n347\t        0\n348\t    }\n349\t}\n350\t\n351\t#[unsafe(no_mangle)]\n352\tpub unsafe extern \"C\" fn ZSTD_ldm_getMaxNbSeq(params: ldmParams_t, maxChunkSize: usize) -> usize {\n353\t    if params.enableLdm == ZSTD_ps_enable {\n354\t        maxChunkSize / params.minMatchLength as usize\n355\t    } else {\n356\t        0\n357\t    }\n358\t}\n359\t\n360\t/** ZSTD_ldm_getBucket() :\n361\t *  Returns a pointer to the start of the bucket associated with hash. */\n362\tunsafe fn ZSTD_ldm_getBucket(\n363\t    ldmState: *const ldmState_t,\n364\t    hash: usize,\n365\t    bucketSizeLog: U32,\n366\t) -> *mut ldmEntry_t {\n367\t    (*ldmState).hashTable.add(hash << bucketSizeLog)\n368\t}\n369\t\n370\t/** ZSTD_ldm_insertEntry() :\n371\t *  Insert the entry with corresponding hash into the hash table */\n372\tunsafe fn ZSTD_ldm_insertEntry(\n373\t    ldmState: *mut ldmState_t,\n374\t    hash: usize,\n375\t    entry: ldmEntry_t,\n376\t    bucketSizeLog: U32,\n377\t) {\n378\t    let pOffset: *mut u8 = (*ldmState).bucketOffsets.add(hash);\n379\t    let offset: c_uint = *pOffset as c_uint;\n380\t\n381\t    *(ZSTD_ldm_getBucket(ldmState, hash, bucketSizeLog).add(offset as usize)) = entry;\n382\t    *pOffset = ((offset + 1) & ((1u32 << bucketSizeLog) - 1)) as u8;\n383\t}\n384\t\n385\t/** ZSTD_ldm_countBackwardsMatch() :\n386\t *  Returns the number of bytes that match backwards before pIn and pMatch.\n387\t *\n388\t *  We count only bytes where pMatch >= pBase and pIn >= pAnchor. */\n389\tunsafe fn ZSTD_ldm_countBackwardsMatch(\n390\t    pIn: *const u8,\n391\t    pAnchor: *const u8,\n392\t    pMatch: *const u8,\n393\t    pMatchBase: *const u8,\n394\t) -> usize {\n395\t    let mut pIn = pIn;\n396\t    let mut pMatch = pMatch;\n397\t    let mut matchLength: usize = 0;\n398\t    while pIn > pAnchor && pMatch > pMatchBase && *pIn.offset(-1) == *pMatch.offset(-1) {\n399\t        pIn = pIn.offset(-1);\n400\t        pMatch = pMatch.offset(-1);\n401\t        matchLength += 1;\n402\t    }\n403\t    matchLength\n404\t}\n405\t\n406\t/** ZSTD_ldm_countBackwardsMatch_2segments() :\n407\t *  Returns the number of bytes that match backwards from pMatch,\n408\t *  even with the backwards match spanning 2 different segments.\n409\t *\n410\t *  On reaching `pMatchBase`, start counting from mEnd */\n411\tunsafe fn ZSTD_ldm_countBackwardsMatch_2segments(\n412\t    pIn: *const u8,\n413\t    pAnchor: *const u8,\n414\t    pMatch: *const u8,\n415\t    pMatchBase: *const u8,\n416\t    pExtDictStart: *const u8,\n417\t    pExtDictEnd: *const u8,\n418\t) -> usize {\n419\t    let mut matchLength: usize =\n420\t        ZSTD_ldm_countBackwardsMatch(pIn, pAnchor, pMatch, pMatchBase);\n421\t    if pMatch.wrapping_sub(matchLength) != pMatchBase || pMatchBase == pExtDictStart {\n422\t        /* If backwards match is entirely in the extDict or prefix, immediately return */\n423\t        return matchLength;\n424\t    }\n425\t    matchLength += ZSTD_ldm_countBackwardsMatch(\n426\t        pIn.wrapping_sub(matchLength),\n427\t        pAnchor,\n428\t        pExtDictEnd,\n429\t        pExtDictStart,\n430\t    );\n431\t    matchLength\n432\t}\n433\t\n434\t/** ZSTD_ldm_fillFastTables() :\n435\t *\n436\t *  Fills the relevant tables for the ZSTD_fast and ZSTD_dfast strategies.\n437\t *  This is similar to ZSTD_loadDictionaryContent.\n438\t *\n439\t *  The tables for the other strategies are filled within their\n440\t *  block compressors. */\n441\tunsafe fn ZSTD_ldm_fillFastTables(ms: *mut ZSTD_MatchState_t, end: *const c_void) -> usize {\n442\t    let iend: *const u8 = end as *const u8;\n443\t\n444\t    match (*ms).cParams.strategy {\n445\t        s if s == ZSTD_fast => {\n446\t            ZSTD_fillHashTable(ms, iend as *const c_void, ZSTD_dtlm_fast, ZSTD_tfp_forCCtx);\n447\t        }\n448\t        s if s == ZSTD_dfast => {\n449\t            ZSTD_fillDoubleHashTable(ms, iend as *const c_void, ZSTD_dtlm_fast, ZSTD_tfp_forCCtx);\n450\t        }\n451\t        _ => {\n452\t            /* greedy/lazy/lazy2/btlazy2/btopt/btultra/btultra2 -> nothing */\n453\t        }\n454\t    }\n455\t\n456\t    0\n457\t}\n458\t\n459\t#[unsafe(no_mangle)]\n460\tpub unsafe extern \"C\" fn ZSTD_ldm_fillHashTable(\n461\t    ldmState: *mut ldmState_t,\n462\t    ip: *const u8,\n463\t    iend: *const u8,\n464\t    params: *const ldmParams_t,\n465\t) {\n466\t    let minMatchLength: U32 = (*params).minMatchLength;\n467\t    let bucketSizeLog: U32 = (*params).bucketSizeLog;\n468\t    let hBits: U32 = (*params).hashLog - bucketSizeLog;\n469\t    let base: *const u8 = (*ldmState).window.base;\n470\t    let istart: *const u8 = ip;\n471\t    let mut hashState = ldmRollingHashState_t {\n472\t        rolling: 0,\n473\t        stopMask: 0,\n474\t    };\n475\t    let splits: *mut usize = (*ldmState).splitIndices.as_mut_ptr();\n476\t    let mut numSplits: c_uint;\n477\t\n478\t    let mut ip = ip;\n479\t\n480\t    ZSTD_ldm_gear_init(&mut hashState, params);\n481\t    while ip < iend {\n482\t        let hashed: usize;\n483\t        let mut n: c_uint;\n484\t\n485\t        numSplits = 0;\n486\t        hashed = ZSTD_ldm_gear_feed(\n487\t            &mut hashState,\n488\t            ip,\n489\t            iend.offset_from(ip) as usize,\n490\t            splits,\n491\t            &mut numSplits,\n492\t        );\n493\t\n494\t        n = 0;\n495\t        while n < numSplits {\n496\t            if ip.add(*splits.add(n as usize)) >= istart.add(minMatchLength as usize) {\n497\t                let split: *const u8 =\n498\t                    ip.add(*splits.add(n as usize)).wrapping_sub(minMatchLength as usize);\n499\t                let xxhash: U64 = ZSTD_XXH64(split as *const c_void, minMatchLength as usize, 0);\n500\t                let hash: U32 = (xxhash & (((1u32 << hBits) - 1) as U64)) as U32;\n501\t                let mut entry = ldmEntry_t {\n502\t                    offset: 0,\n503\t                    checksum: 0,\n504\t                };\n505\t\n506\t                entry.offset = split.offset_from(base) as U32;\n507\t                entry.checksum = (xxhash >> 32) as U32;\n508\t                ZSTD_ldm_insertEntry(ldmState, hash as usize, entry, (*params).bucketSizeLog);\n509\t            }\n510\t            n += 1;\n511\t        }\n512\t\n513\t        ip = ip.add(hashed);\n514\t    }\n515\t}\n516\t\n517\t/** ZSTD_ldm_limitTableUpdate() :\n518\t *\n519\t *  Sets cctx->nextToUpdate to a position corresponding closer to anchor\n520\t *  if it is far way\n521\t *  (after a long match, only update tables a limited amount). */\n522\tunsafe fn ZSTD_ldm_limitTableUpdate(ms: *mut ZSTD_MatchState_t, anchor: *const u8) {\n523\t    let curr: U32 = anchor.offset_from((*ms).window.base) as U32;\n524\t    if curr > (*ms).nextToUpdate + 1024 {\n525\t        (*ms).nextToUpdate =\n526\t            curr - (512u32).min(curr - (*ms).nextToUpdate - 1024);\n527\t    }\n528\t}\n529\t\n530\tunsafe fn ZSTD_ldm_generateSequences_internal(\n531\t    ldmState: *mut ldmState_t,\n532\t    rawSeqStore: *mut RawSeqStore_t,\n533\t    params: *const ldmParams_t,\n534\t    src: *const c_void,\n535\t    srcSize: usize,\n536\t) -> usize {\n537\t    /* LDM parameters */\n538\t    let extDict: i32 = ZSTD_window_hasExtDict((*ldmState).window) as i32;\n539\t    let minMatchLength: U32 = (*params).minMatchLength;\n540\t    let entsPerBucket: U32 = 1u32 << (*params).bucketSizeLog;\n541\t    let hBits: U32 = (*params).hashLog - (*params).bucketSizeLog;\n542\t    /* Prefix and extDict parameters */\n543\t    let dictLimit: U32 = (*ldmState).window.dictLimit;\n544\t    let lowestIndex: U32 = if extDict != 0 {\n545\t        (*ldmState).window.lowLimit\n546\t    } else {\n547\t        dictLimit\n548\t    };\n549\t    let base: *const u8 = (*ldmState).window.base;\n550\t    let dictBase: *const u8 = if extDict != 0 {\n551\t        (*ldmState).window.dictBase\n552\t    } else {\n553\t        core::ptr::null()\n554\t    };\n555\t    let dictStart: *const u8 = if extDict != 0 {\n556\t        dictBase.add(lowestIndex as usize)\n557\t    } else {\n558\t        core::ptr::null()\n559\t    };\n560\t    let dictEnd: *const u8 = if extDict != 0 {\n561\t        dictBase.add(dictLimit as usize)\n562\t    } else {\n563\t        core::ptr::null()\n564\t    };\n565\t    let lowPrefixPtr: *const u8 = base.add(dictLimit as usize);\n566\t    /* Input bounds */\n567\t    let istart: *const u8 = src as *const u8;\n568\t    let iend: *const u8 = istart.add(srcSize);\n569\t    let ilimit: *const u8 = iend.offset(-(HASH_READ_SIZE as isize));\n570\t    /* Input positions */\n571\t    let mut anchor: *const u8 = istart;\n572\t    let mut ip: *const u8 = istart;\n573\t    /* Rolling hash state */\n574\t    let mut hashState = ldmRollingHashState_t {\n575\t        rolling: 0,\n576\t        stopMask: 0,\n577\t    };\n578\t    /* Arrays for staged-processing */\n579\t    let splits: *mut usize = (*ldmState).splitIndices.as_mut_ptr();\n580\t    let candidates: *mut ldmMatchCandidate_t = (*ldmState).matchCandidates.as_mut_ptr();\n581\t    let mut numSplits: c_uint;\n582\t\n583\t    if srcSize < minMatchLength as usize {\n584\t        return iend.offset_from(anchor) as usize;\n585\t    }\n586\t\n587\t    /* Initialize the rolling hash state with the first minMatchLength bytes */\n588\t    ZSTD_ldm_gear_init(&mut hashState, params);\n589\t    ZSTD_ldm_gear_reset(&mut hashState, ip, minMatchLength as usize);\n590\t    ip = ip.add(minMatchLength as usize);\n591\t\n592\t    while ip < ilimit {\n593\t        let mut hashed: usize;\n594\t        let mut n: c_uint;\n595\t\n596\t        numSplits = 0;\n597\t        hashed = ZSTD_ldm_gear_feed(\n598\t            &mut hashState,\n599\t            ip,\n600\t            ilimit.offset_from(ip) as usize,\n601\t            splits,\n602\t            &mut numSplits,\n603\t        );\n604\t\n605\t        n = 0;\n606\t        while n < numSplits {\n607\t            let split: *const u8 =\n608\t                ip.add(*splits.add(n as usize)).wrapping_sub(minMatchLength as usize);\n609\t            let xxhash: U64 = ZSTD_XXH64(split as *const c_void, minMatchLength as usize, 0);\n610\t            let hash: U32 = (xxhash & (((1u32 << hBits) - 1) as U64)) as U32;\n611\t\n612\t            (*candidates.add(n as usize)).split = split;\n613\t            (*candidates.add(n as usize)).hash = hash;\n614\t            (*candidates.add(n as usize)).checksum = (xxhash >> 32) as U32;\n615\t            (*candidates.add(n as usize)).bucket =\n616\t                ZSTD_ldm_getBucket(ldmState, hash as usize, (*params).bucketSizeLog);\n617\t            PREFETCH_L1((*candidates.add(n as usize)).bucket as *const c_void);\n618\t            n += 1;\n619\t        }\n620\t\n621\t        n = 0;\n622\t        'candidate_loop: while n < numSplits {\n623\t            let mut forwardMatchLength: usize = 0;\n624\t            let mut backwardMatchLength: usize = 0;\n625\t            let mut bestMatchLength: usize = 0;\n626\t            let mLength: usize;\n627\t            let offset: U32;\n628\t            let split: *const u8 = (*candidates.add(n as usize)).split;\n629\t            let checksum: U32 = (*candidates.add(n as usize)).checksum;\n630\t            let hash: U32 = (*candidates.add(n as usize)).hash;\n631\t            let bucket: *mut ldmEntry_t = (*candidates.add(n as usize)).bucket;\n632\t            let mut cur: *const ldmEntry_t;\n633\t            let mut bestEntry: *const ldmEntry_t = core::ptr::null();\n634\t            let mut newEntry = ldmEntry_t {\n635\t                offset: 0,\n636\t                checksum: 0,\n637\t            };\n638\t\n639\t            newEntry.offset = split.offset_from(base) as U32;\n640\t            newEntry.checksum = checksum;\n641\t\n642\t            /* If a split point would generate a sequence overlapping with\n643\t             * the previous one, we merely register it in the hash table and\n644\t             * move on */\n645\t            if split < anchor {\n646\t                ZSTD_ldm_insertEntry(ldmState, hash as usize, newEntry, (*params).bucketSizeLog);\n647\t                n += 1;\n648\t                continue 'candidate_loop;\n649\t            }\n650\t\n651\t            cur = bucket;\n652\t            while cur < bucket.add(entsPerBucket as usize) {\n653\t                let curForwardMatchLength: usize;\n654\t                let curBackwardMatchLength: usize;\n655\t                let curTotalMatchLength: usize;\n656\t                if (*cur).checksum != checksum || (*cur).offset <= lowestIndex {\n657\t                    cur = cur.add(1);\n658\t                    continue;\n659\t                }\n660\t                if extDict != 0 {\n661\t                    let curMatchBase: *const u8 = if (*cur).offset < dictLimit {\n662\t                        dictBase\n663\t                    } else {\n664\t                        base\n665\t                    };\n666\t                    let pMatch: *const u8 = curMatchBase.add((*cur).offset as usize);\n667\t                    let matchEnd: *const u8 = if (*cur).offset < dictLimit {\n668\t                        dictEnd\n669\t                    } else {\n670\t                        iend\n671\t                    };\n672\t                    let lowMatchPtr: *const u8 = if (*cur).offset < dictLimit {\n673\t                        dictStart\n674\t                    } else {\n675\t                        lowPrefixPtr\n676\t                    };\n677\t                    curForwardMatchLength =\n678\t                        ZSTD_count_2segments(split, pMatch, iend, matchEnd, lowPrefixPtr);\n679\t                    if curForwardMatchLength < minMatchLength as usize {\n680\t                        cur = cur.add(1);\n681\t                        continue;\n682\t                    }\n683\t                    curBackwardMatchLength = ZSTD_ldm_countBackwardsMatch_2segments(\n684\t                        split, anchor, pMatch, lowMatchPtr, dictStart, dictEnd,\n685\t                    );\n686\t                } else {\n687\t                    /* !extDict */\n688\t                    let pMatch: *const u8 = base.add((*cur).offset as usize);\n689\t                    curForwardMatchLength = ZSTD_count(split, pMatch, iend);\n690\t                    if curForwardMatchLength < minMatchLength as usize {\n691\t                        cur = cur.add(1);\n692\t                        continue;\n693\t                    }\n694\t                    curBackwardMatchLength =\n695\t                        ZSTD_ldm_countBackwardsMatch(split, anchor, pMatch, lowPrefixPtr);\n696\t                }\n697\t                curTotalMatchLength = curForwardMatchLength + curBackwardMatchLength;\n698\t\n699\t                if curTotalMatchLength > bestMatchLength {\n700\t                    bestMatchLength = curTotalMatchLength;\n701\t                    forwardMatchLength = curForwardMatchLength;\n702\t                    backwardMatchLength = curBackwardMatchLength;\n703\t                    bestEntry = cur;\n704\t                }\n705\t                cur = cur.add(1);\n706\t            }\n707\t\n708\t            /* No match found -- insert an entry into the hash table\n709\t             * and process the next candidate match */\n710\t            if bestEntry.is_null() {\n711\t                ZSTD_ldm_insertEntry(ldmState, hash as usize, newEntry, (*params).bucketSizeLog);\n712\t                n += 1;\n713\t                continue 'candidate_loop;\n714\t            }\n715\t\n716\t            /* Match found */\n717\t            offset = (split.offset_from(base) as U32).wrapping_sub((*bestEntry).offset);\n718\t            mLength = forwardMatchLength + backwardMatchLength;\n719\t            {\n720\t                let seq: *mut rawSeq = (*rawSeqStore).seq.add((*rawSeqStore).size);\n721\t\n722\t                /* Out of sequence storage */\n723\t                if (*rawSeqStore).size == (*rawSeqStore).capacity {\n724\t                    return error::error(error::code::DSTSIZE_TOOSMALL);\n725\t                }\n726\t                (*seq).litLength =\n727\t                    split.wrapping_sub(backwardMatchLength).offset_from(anchor) as U32;\n728\t                (*seq).matchLength = mLength as U32;\n729\t                (*seq).offset = offset;\n730\t                (*rawSeqStore).size += 1;\n731\t            }\n732\t\n733\t            /* Insert the current entry into the hash table --- it must be\n734\t             * done after the previous block to avoid clobbering bestEntry */\n735\t            ZSTD_ldm_insertEntry(ldmState, hash as usize, newEntry, (*params).bucketSizeLog);\n736\t\n737\t            anchor = split.add(forwardMatchLength);\n738\t\n739\t            /* If we find a match that ends after the data that we've hashed\n740\t             * then we have a repeating, overlapping, pattern. E.g. all zeros.\n741\t             * If one repetition of the pattern matches our `stopMask` then all\n742\t             * repetitions will. We don't need to insert them all into out table,\n743\t             * only the first one. So skip over overlapping matches.\n744\t             * This is a major speed boost (20x) for compressing a single byte\n745\t             * repeated, when that byte ends up in the table.\n746\t             */\n747\t            if anchor > ip.add(hashed) {\n748\t                ZSTD_ldm_gear_reset(\n749\t                    &mut hashState,\n750\t                    anchor.wrapping_sub(minMatchLength as usize),\n751\t                    minMatchLength as usize,\n752\t                );\n753\t                /* Continue the outer loop at anchor (ip + hashed == anchor). */\n754\t                ip = anchor.wrapping_sub(hashed);\n755\t                break 'candidate_loop;\n756\t            }\n757\t            n += 1;\n758\t        }\n759\t\n760\t        ip = ip.add(hashed);\n761\t    }\n762\t\n763\t    iend.offset_from(anchor) as usize\n764\t}\n765\t\n766\t/* ZSTD_ldm_reduceTable() :\n767\t *  reduce table indexes by `reducerValue` */\n768\tunsafe fn ZSTD_ldm_reduceTable(table: *mut ldmEntry_t, size: U32, reducerValue: U32) {\n769\t    let mut u: U32 = 0;\n770\t    while u < size {\n771\t        if (*table.add(u as usize)).offset < reducerValue {\n772\t            (*table.add(u as usize)).offset = 0;\n773\t        } else {\n774\t            (*table.add(u as usize)).offset -= reducerValue;\n775\t        }\n776\t        u += 1;\n777\t    }\n778\t}\n779\t\n780\t#[unsafe(no_mangle)]\n781\tpub unsafe extern \"C\" fn ZSTD_ldm_generateSequences(\n782\t    ldmState: *mut ldmState_t,\n783\t    sequences: *mut RawSeqStore_t,\n784\t    params: *const ldmParams_t,\n785\t    src: *const c_void,\n786\t    srcSize: usize,\n787\t) -> usize {\n788\t    let maxDist: U32 = 1u32 << (*params).windowLog;\n789\t    let istart: *const u8 = src as *const u8;\n790\t    let iend: *const u8 = istart.add(srcSize);\n791\t    let kMaxChunkSize: usize = 1 << 20;\n792\t    let nbChunks: usize =\n793\t        (srcSize / kMaxChunkSize) + ((srcSize % kMaxChunkSize != 0) as usize);\n794\t    let mut chunk: usize;\n795\t    let mut leftoverSize: usize = 0;\n796\t\n797\t    /* The input could be very large (in zstdmt), so it must be broken up into\n798\t     * chunks to enforce the maximum distance and handle overflow correction.\n799\t     */\n800\t    chunk = 0;\n801\t    while chunk < nbChunks && (*sequences).size < (*sequences).capacity {\n802\t        let chunkStart: *const u8 = istart.add(chunk * kMaxChunkSize);\n803\t        let remaining: usize = iend.offset_from(chunkStart) as usize;\n804\t        let chunkEnd: *const u8 = if remaining < kMaxChunkSize {\n805\t            iend\n806\t        } else {\n807\t            chunkStart.add(kMaxChunkSize)\n808\t        };\n809\t        let chunkSize: usize = chunkEnd.offset_from(chunkStart) as usize;\n810\t        let newLeftoverSize: usize;\n811\t        let prevSize: usize = (*sequences).size;\n812\t\n813\t        /* 1. Perform overflow correction if necessary. */\n814\t        if ZSTD_window_needOverflowCorrection(\n815\t            (*ldmState).window,\n816\t            0,\n817\t            maxDist,\n818\t            (*ldmState).loadedDictEnd,\n819\t            chunkStart as *const c_void,\n820\t            chunkEnd as *const c_void,\n821\t        ) != 0\n822\t        {\n823\t            let ldmHSize: U32 = 1u32 << (*params).hashLog;\n824\t            let correction: U32 = ZSTD_window_correctOverflow(\n825\t                &mut (*ldmState).window,\n826\t                /* cycleLog */ 0,\n827\t                maxDist,\n828\t                chunkStart as *const c_void,\n829\t            );\n830\t            ZSTD_ldm_reduceTable((*ldmState).hashTable, ldmHSize, correction);\n831\t            /* invalidate dictionaries on overflow correction */\n832\t            (*ldmState).loadedDictEnd = 0;\n833\t        }\n834\t        /* 2. We enforce the maximum offset allowed. */\n835\t        ZSTD_window_enforceMaxDist(\n836\t            &mut (*ldmState).window,\n837\t            chunkEnd as *const c_void,\n838\t            maxDist,\n839\t            &mut (*ldmState).loadedDictEnd,\n840\t            core::ptr::null_mut(),\n841\t        );\n842\t        /* 3. Generate the sequences for the chunk, and get newLeftoverSize. */\n843\t        newLeftoverSize = ZSTD_ldm_generateSequences_internal(\n844\t            ldmState,\n845\t            sequences,\n846\t            params,\n847\t            chunkStart as *const c_void,\n848\t            chunkSize,\n849\t        );\n850\t        if error::err_is_error(newLeftoverSize) != 0 {\n851\t            return newLeftoverSize;\n852\t        }\n853\t        /* 4. We add the leftover literals from previous iterations to the first\n854\t         *    newly generated sequence, or add the `newLeftoverSize` if none are\n855\t         *    generated.\n856\t         */\n857\t        /* Prepend the leftover literals from the last call */\n858\t        if prevSize < (*sequences).size {\n859\t            (*(*sequences).seq.add(prevSize)).litLength += leftoverSize as U32;\n860\t            leftoverSize = newLeftoverSize;\n861\t        } else {\n862\t            leftoverSize += chunkSize;\n863\t        }\n864\t        chunk += 1;\n865\t    }\n866\t    0\n867\t}\n868\t\n869\t#[unsafe(no_mangle)]\n870\tpub unsafe extern \"C\" fn ZSTD_ldm_skipSequences(\n871\t    rawSeqStore: *mut RawSeqStore_t,\n872\t    srcSize: usize,\n873\t    minMatch: U32,\n874\t) {\n875\t    let mut srcSize = srcSize;\n876\t    while srcSize > 0 && (*rawSeqStore).pos < (*rawSeqStore).size {\n877\t        let seq: *mut rawSeq = (*rawSeqStore).seq.add((*rawSeqStore).pos);\n878\t        if srcSize <= (*seq).litLength as usize {\n879\t            /* Skip past srcSize literals */\n880\t            (*seq).litLength -= srcSize as U32;\n881\t            return;\n882\t        }\n883\t        srcSize -= (*seq).litLength as usize;\n884\t        (*seq).litLength = 0;\n885\t        if srcSize < (*seq).matchLength as usize {\n886\t            /* Skip past the first srcSize of the match */\n887\t            (*seq).matchLength -= srcSize as U32;\n888\t            if (*seq).matchLength < minMatch {\n889\t                /* The match is too short, omit it */\n890\t                if (*rawSeqStore).pos + 1 < (*rawSeqStore).size {\n891\t                    (*seq.add(1)).litLength += (*seq.add(0)).matchLength;\n892\t                }\n893\t                (*rawSeqStore).pos += 1;\n894\t            }\n895\t            return;\n896\t        }\n897\t        srcSize -= (*seq).matchLength as usize;\n898\t        (*seq).matchLength = 0;\n899\t        (*rawSeqStore).pos += 1;\n900\t    }\n901\t}\n902\t\n903\t/**\n904\t * If the sequence length is longer than remaining then the sequence is split\n905\t * between this block and the next.\n906\t *\n907\t * Returns the current sequence to handle, or if the rest of the block should\n908\t * be literals, it returns a sequence with offset == 0.\n909\t */\n910\tunsafe fn maybeSplitSequence(\n911\t    rawSeqStore: *mut RawSeqStore_t,\n912\t    remaining: U32,\n913\t    minMatch: U32,\n914\t) -> rawSeq {\n915\t    let mut sequence: rawSeq = *(*rawSeqStore).seq.add((*rawSeqStore).pos);\n916\t    /* Likely: No partial sequence */\n917\t    if remaining >= sequence.litLength + sequence.matchLength {\n918\t        (*rawSeqStore).pos += 1;\n919\t        return sequence;\n920\t    }\n921\t    /* Cut the sequence short (offset == 0 ==> rest is literals). */\n922\t    if remaining <= sequence.litLength {\n923\t        sequence.offset = 0;\n924\t    } else if remaining < sequence.litLength + sequence.matchLength {\n925\t        sequence.matchLength = remaining - sequence.litLength;\n926\t        if sequence.matchLength < minMatch {\n927\t            sequence.offset = 0;\n928\t        }\n929\t    }\n930\t    /* Skip past `remaining` bytes for the future sequences. */\n931\t    ZSTD_ldm_skipSequences(rawSeqStore, remaining as usize, minMatch);\n932\t    sequence\n933\t}\n934\t\n935\t#[unsafe(no_mangle)]\n936\tpub unsafe extern \"C\" fn ZSTD_ldm_skipRawSeqStoreBytes(\n937\t    rawSeqStore: *mut RawSeqStore_t,\n938\t    nbBytes: usize,\n939\t) {\n940\t    let mut currPos: U32 = ((*rawSeqStore).posInSequence + nbBytes) as U32;\n941\t    while currPos != 0 && (*rawSeqStore).pos < (*rawSeqStore).size {\n942\t        let currSeq: rawSeq = *(*rawSeqStore).seq.add((*rawSeqStore).pos);\n943\t        if currPos >= currSeq.litLength + currSeq.matchLength {\n944\t            currPos -= currSeq.litLength + currSeq.matchLength;\n945\t            (*rawSeqStore).pos += 1;\n946\t        } else {\n947\t            (*rawSeqStore).posInSequence = currPos as usize;\n948\t            break;\n949\t        }\n950\t    }\n951\t    if currPos == 0 || (*rawSeqStore).pos == (*rawSeqStore).size {\n952\t        (*rawSeqStore).posInSequence = 0;\n953\t    }\n954\t}\n955\t\n956\t#[unsafe(no_mangle)]\n957\tpub unsafe extern \"C\" fn ZSTD_ldm_blockCompress(\n958\t    rawSeqStore: *mut RawSeqStore_t,\n959\t    ms: *mut ZSTD_MatchState_t,\n960\t    seqStore: *mut SeqStore_t,\n961\t    rep: *mut U32,\n962\t    useRowMatchFinder: ZSTD_ParamSwitch_e,\n963\t    src: *const c_void,\n964\t    srcSize: usize,\n965\t) -> usize {\n966\t    let cParams: *const ZSTD_compressionParameters = &(*ms).cParams;\n967\t    let minMatch: c_uint = (*cParams).minMatch;\n968\t    let blockCompressor: ZSTD_BlockCompressor_f = ZSTD_selectBlockCompressor(\n969\t        (*cParams).strategy,\n970\t        useRowMatchFinder,\n971\t        ZSTD_matchState_dictMode(ms),\n972\t    );\n973\t    /* Input bounds */\n974\t    let istart: *const u8 = src as *const u8;\n975\t    let iend: *const u8 = istart.add(srcSize);\n976\t    /* Input positions */\n977\t    let mut ip: *const u8 = istart;\n978\t\n979\t    /* If using opt parser, use LDMs only as candidates rather than always accepting them */\n980\t    if (*cParams).strategy >= ZSTD_btopt {\n981\t        let lastLLSize: usize;\n982\t        (*ms).ldmSeqStore = rawSeqStore;\n983\t        lastLLSize = (blockCompressor.unwrap())(ms, seqStore, rep, src, srcSize);\n984\t        ZSTD_ldm_skipRawSeqStoreBytes(rawSeqStore, srcSize);\n985\t        return lastLLSize;\n986\t    }\n987\t\n988\t    /* Loop through each sequence and apply the block compressor to the literals */\n989\t    while (*rawSeqStore).pos < (*rawSeqStore).size && ip < iend {\n990\t        /* maybeSplitSequence updates rawSeqStore->pos */\n991\t        let sequence: rawSeq =\n992\t            maybeSplitSequence(rawSeqStore, iend.offset_from(ip) as U32, minMatch);\n993\t        /* End signal */\n994\t        if sequence.offset == 0 {\n995\t            break;\n996\t        }\n997\t\n998\t        /* Fill tables for block compressor */\n999\t        ZSTD_ldm_limitTableUpdate(ms, ip);\n1000\t        ZSTD_ldm_fillFastTables(ms, ip as *const c_void);\n1001\t        /* Run the block compressor */\n1002\t        {\n1003\t            let mut i: i32;\n1004\t            let newLitLength: usize = (blockCompressor.unwrap())(\n1005\t                ms,\n1006\t                seqStore,\n1007\t                rep,\n1008\t                ip as *const c_void,\n1009\t                sequence.litLength as usize,\n1010\t            );\n1011\t            ip = ip.add(sequence.litLength as usize);\n1012\t            /* Update the repcodes */\n1013\t            i = ZSTD_REP_NUM as i32 - 1;\n1014\t            while i > 0 {\n1015\t                *rep.add(i as usize) = *rep.add((i - 1) as usize);\n1016\t                i -= 1;\n1017\t            }\n1018\t            *rep.add(0) = sequence.offset;\n1019\t            /* Store the sequence */\n1020\t            ZSTD_storeSeq(\n1021\t                seqStore,\n1022\t                newLitLength,\n1023\t                ip.wrapping_sub(newLitLength),\n1024\t                iend,\n1025\t                OFFSET_TO_OFFBASE(sequence.offset),\n1026\t                sequence.matchLength as usize,\n1027\t            );\n1028\t            ip = ip.add(sequence.matchLength as usize);\n1029\t        }\n1030\t    }\n1031\t    /* Fill the tables for the block compressor */\n1032\t    ZSTD_ldm_limitTableUpdate(ms, ip);\n1033\t    ZSTD_ldm_fillFastTables(ms, ip as *const c_void);\n1034\t    /* Compress the last literals */\n1035\t    (blockCompressor.unwrap())(ms, seqStore, rep, ip as *const c_void, iend.offset_from(ip) as usize)\n1036\t}\n1037\t"}]},"parent_tool_use_id":"toolu_bdrk_01EzvN6VL3gn3YxcTHBLJCuB","session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"df4f1208-a5e3-455c-a8e8-e559523522c2","timestamp":"2026-08-14T21:23:24.837Z","subagent_type":"general-purpose","task_description":"Fix LDM divergence in zstd_ldm.rs"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HDCbnE1aG55toc9KtiCGTg","type":"tool_result","content":"1\t/*\n2\t * Copyright (c) Meta Platforms, Inc. and affiliates.\n3\t * All rights reserved.\n4\t *\n5\t * This source code is licensed under both the BSD-style license (found in the\n6\t * LICENSE file in the root directory of this source tree) and the GPLv2 (found\n7\t * in the COPYING file in the root directory of this source tree).\n8\t * You may select, at your option, one of the above-listed licenses.\n9\t */\n10\t\n11\t#include \"zstd_ldm.h\"\n12\t\n13\t#include \"../common/debug.h\"\n14\t#include \"../common/xxhash.h\"\n15\t#include \"zstd_fast.h\"          /* ZSTD_fillHashTable() */\n16\t#include \"zstd_double_fast.h\"   /* ZSTD_fillDoubleHashTable() */\n17\t#include \"zstd_ldm_geartab.h\"\n18\t\n19\t#define LDM_BUCKET_SIZE_LOG 4\n20\t#define LDM_MIN_MATCH_LENGTH 64\n21\t#define LDM_HASH_RLOG 7\n22\t\n23\ttypedef struct {\n24\t    U64 rolling;\n25\t    U64 stopMask;\n26\t} ldmRollingHashState_t;\n27\t\n28\t/** ZSTD_ldm_gear_init():\n29\t *\n30\t * Initializes the rolling hash state such that it will honor the\n31\t * settings in params. */\n32\tstatic void ZSTD_ldm_gear_init(ldmRollingHashState_t* state, ldmParams_t const* params)\n33\t{\n34\t    unsigned maxBitsInMask = MIN(params->minMatchLength, 64);\n35\t    unsigned hashRateLog = params->hashRateLog;\n36\t\n37\t    state->rolling = ~(U32)0;\n38\t\n39\t    /* The choice of the splitting criterion is subject to two conditions:\n40\t     *   1. it has to trigger on average every 2^(hashRateLog) bytes;\n41\t     *   2. ideally, it has to depend on a window of minMatchLength bytes.\n42\t     *\n43\t     * In the gear hash algorithm, bit n depends on the last n bytes;\n44\t     * so in order to obtain a good quality splitting criterion it is\n45\t     * preferable to use bits with high weight.\n46\t     *\n47\t     * To match condition 1 we use a mask with hashRateLog bits set\n48\t     * and, because of the previous remark, we make sure these bits\n49\t     * have the highest possible weight while still respecting\n50\t     * condition 2.\n51\t     */\n52\t    if (hashRateLog > 0 && hashRateLog <= maxBitsInMask) {\n53\t        state->stopMask = (((U64)1 << hashRateLog) - 1) << (maxBitsInMask - hashRateLog);\n54\t    } else {\n55\t        /* In this degenerate case we simply honor the hash rate. */\n56\t        state->stopMask = ((U64)1 << hashRateLog) - 1;\n57\t    }\n58\t}\n59\t\n60\t/** ZSTD_ldm_gear_reset()\n61\t * Feeds [data, data + minMatchLength) into the hash without registering any\n62\t * splits. This effectively resets the hash state. This is used when skipping\n63\t * over data, either at the beginning of a block, or skipping sections.\n64\t */\n65\tstatic void ZSTD_ldm_gear_reset(ldmRollingHashState_t* state,\n66\t                                BYTE const* data, size_t minMatchLength)\n67\t{\n68\t    U64 hash = state->rolling;\n69\t    size_t n = 0;\n70\t\n71\t#define GEAR_ITER_ONCE() do {                                  \\\n72\t        hash = (hash << 1) + ZSTD_ldm_gearTab[data[n] & 0xff]; \\\n73\t        n += 1;                                                \\\n74\t    } while (0)\n75\t    while (n + 3 < minMatchLength) {\n76\t        GEAR_ITER_ONCE();\n77\t        GEAR_ITER_ONCE();\n78\t        GEAR_ITER_ONCE();\n79\t        GEAR_ITER_ONCE();\n80\t    }\n81\t    while (n < minMatchLength) {\n82\t        GEAR_ITER_ONCE();\n83\t    }\n84\t#undef GEAR_ITER_ONCE\n85\t}\n86\t\n87\t/** ZSTD_ldm_gear_feed():\n88\t *\n89\t * Registers in the splits array all the split points found in the first\n90\t * size bytes following the data pointer. This function terminates when\n91\t * either all the data has been processed or LDM_BATCH_SIZE splits are\n92\t * present in the splits array.\n93\t *\n94\t * Precondition: The splits array must not be full.\n95\t * Returns: The number of bytes processed. */\n96\tstatic size_t ZSTD_ldm_gear_feed(ldmRollingHashState_t* state,\n97\t                                 BYTE const* data, size_t size,\n98\t                                 size_t* splits, unsigned* numSplits)\n99\t{\n100\t    size_t n;\n101\t    U64 hash, mask;\n102\t\n103\t    hash = state->rolling;\n104\t    mask = state->stopMask;\n105\t    n = 0;\n106\t\n107\t#define GEAR_ITER_ONCE() do { \\\n108\t        hash = (hash << 1) + ZSTD_ldm_gearTab[data[n] & 0xff]; \\\n109\t        n += 1; \\\n110\t        if (UNLIKELY((hash & mask) == 0)) { \\\n111\t            splits[*numSplits] = n; \\\n112\t            *numSplits += 1; \\\n113\t            if (*numSplits == LDM_BATCH_SIZE) \\\n114\t                goto done; \\\n115\t        } \\\n116\t    } while (0)\n117\t\n118\t    while (n + 3 < size) {\n119\t        GEAR_ITER_ONCE();\n120\t        GEAR_ITER_ONCE();\n121\t        GEAR_ITER_ONCE();\n122\t        GEAR_ITER_ONCE();\n123\t    }\n124\t    while (n < size) {\n125\t        GEAR_ITER_ONCE();\n126\t    }\n127\t\n128\t#undef GEAR_ITER_ONCE\n129\t\n130\tdone:\n131\t    state->rolling = hash;\n132\t    return n;\n133\t}\n134\t\n135\tvoid ZSTD_ldm_adjustParameters(ldmParams_t* params,\n136\t                        const ZSTD_compressionParameters* cParams)\n137\t{\n138\t    params->windowLog = cParams->windowLog;\n139\t    ZSTD_STATIC_ASSERT(LDM_BUCKET_SIZE_LOG <= ZSTD_LDM_BUCKETSIZELOG_MAX);\n140\t    DEBUGLOG(4, \"ZSTD_ldm_adjustParameters\");\n141\t    if (params->hashRateLog == 0) {\n142\t        if (params->hashLog > 0) {\n143\t            /* if params->hashLog is set, derive hashRateLog from it */\n144\t            assert(params->hashLog <= ZSTD_HASHLOG_MAX);\n145\t            if (params->windowLog > params->hashLog) {\n146\t                params->hashRateLog = params->windowLog - params->hashLog;\n147\t            }\n148\t        } else {\n149\t            assert(1 <= (int)cParams->strategy && (int)cParams->strategy <= 9);\n150\t            /* mapping from [fast, rate7] to [btultra2, rate4] */\n151\t            params->hashRateLog = 7 - (cParams->strategy/3);\n152\t        }\n153\t    }\n154\t    if (params->hashLog == 0) {\n155\t        params->hashLog = BOUNDED(ZSTD_HASHLOG_MIN, params->windowLog - params->hashRateLog, ZSTD_HASHLOG_MAX);\n156\t    }\n157\t    if (params->minMatchLength == 0) {\n158\t        params->minMatchLength = LDM_MIN_MATCH_LENGTH;\n159\t        if (cParams->strategy >= ZSTD_btultra)\n160\t            params->minMatchLength /= 2;\n161\t    }\n162\t    if (params->bucketSizeLog==0) {\n163\t        assert(1 <= (int)cParams->strategy && (int)cParams->strategy <= 9);\n164\t        params->bucketSizeLog = BOUNDED(LDM_BUCKET_SIZE_LOG, (U32)cParams->strategy, ZSTD_LDM_BUCKETSIZELOG_MAX);\n165\t    }\n166\t    params->bucketSizeLog = MIN(params->bucketSizeLog, params->hashLog);\n167\t}\n168\t\n169\tsize_t ZSTD_ldm_getTableSize(ldmParams_t params)\n170\t{\n171\t    size_t const ldmHSize = ((size_t)1) << params.hashLog;\n172\t    size_t const ldmBucketSizeLog = MIN(params.bucketSizeLog, params.hashLog);\n173\t    size_t const ldmBucketSize = ((size_t)1) << (params.hashLog - ldmBucketSizeLog);\n174\t    size_t const totalSize = ZSTD_cwksp_alloc_size(ldmBucketSize)\n175\t                           + ZSTD_cwksp_alloc_size(ldmHSize * sizeof(ldmEntry_t));\n176\t    return params.enableLdm == ZSTD_ps_enable ? totalSize : 0;\n177\t}\n178\t\n179\tsize_t ZSTD_ldm_getMaxNbSeq(ldmParams_t params, size_t maxChunkSize)\n180\t{\n181\t    return params.enableLdm == ZSTD_ps_enable ? (maxChunkSize / params.minMatchLength) : 0;\n182\t}\n183\t\n184\t/** ZSTD_ldm_getBucket() :\n185\t *  Returns a pointer to the start of the bucket associated with hash. */\n186\tstatic ldmEntry_t* ZSTD_ldm_getBucket(\n187\t        const ldmState_t* ldmState, size_t hash, U32 const bucketSizeLog)\n188\t{\n189\t    return ldmState->hashTable + (hash << bucketSizeLog);\n190\t}\n191\t\n192\t/** ZSTD_ldm_insertEntry() :\n193\t *  Insert the entry with corresponding hash into the hash table */\n194\tstatic void ZSTD_ldm_insertEntry(ldmState_t* ldmState,\n195\t                                 size_t const hash, const ldmEntry_t entry,\n196\t                                 U32 const bucketSizeLog)\n197\t{\n198\t    BYTE* const pOffset = ldmState->bucketOffsets + hash;\n199\t    unsigned const offset = *pOffset;\n200\t\n201\t    *(ZSTD_ldm_getBucket(ldmState, hash, bucketSizeLog) + offset) = entry;\n202\t    *pOffset = (BYTE)((offset + 1) & ((1u << bucketSizeLog) - 1));\n203\t\n204\t}\n205\t\n206\t/** ZSTD_ldm_countBackwardsMatch() :\n207\t *  Returns the number of bytes that match backwards before pIn and pMatch.\n208\t *\n209\t *  We count only bytes where pMatch >= pBase and pIn >= pAnchor. */\n210\tstatic size_t ZSTD_ldm_countBackwardsMatch(\n211\t            const BYTE* pIn, const BYTE* pAnchor,\n212\t            const BYTE* pMatch, const BYTE* pMatchBase)\n213\t{\n214\t    size_t matchLength = 0;\n215\t    while (pIn > pAnchor && pMatch > pMatchBase && pIn[-1] == pMatch[-1]) {\n216\t        pIn--;\n217\t        pMatch--;\n218\t        matchLength++;\n219\t    }\n220\t    return matchLength;\n221\t}\n222\t\n223\t/** ZSTD_ldm_countBackwardsMatch_2segments() :\n224\t *  Returns the number of bytes that match backwards from pMatch,\n225\t *  even with the backwards match spanning 2 different segments.\n226\t *\n227\t *  On reaching `pMatchBase`, start counting from mEnd */\n228\tstatic size_t ZSTD_ldm_countBackwardsMatch_2segments(\n229\t                    const BYTE* pIn, const BYTE* pAnchor,\n230\t                    const BYTE* pMatch, const BYTE* pMatchBase,\n231\t                    const BYTE* pExtDictStart, const BYTE* pExtDictEnd)\n232\t{\n233\t    size_t matchLength = ZSTD_ldm_countBackwardsMatch(pIn, pAnchor, pMatch, pMatchBase);\n234\t    if (pMatch - matchLength != pMatchBase || pMatchBase == pExtDictStart) {\n235\t        /* If backwards match is entirely in the extDict or prefix, immediately return */\n236\t        return matchLength;\n237\t    }\n238\t    DEBUGLOG(7, \"ZSTD_ldm_countBackwardsMatch_2segments: found 2-parts backwards match (length in prefix==%zu)\", matchLength);\n239\t    matchLength += ZSTD_ldm_countBackwardsMatch(pIn - matchLength, pAnchor, pExtDictEnd, pExtDictStart);\n240\t    DEBUGLOG(7, \"final backwards match length = %zu\", matchLength);\n241\t    return matchLength;\n242\t}\n243\t\n244\t/** ZSTD_ldm_fillFastTables() :\n245\t *\n246\t *  Fills the relevant tables for the ZSTD_fast and ZSTD_dfast strategies.\n247\t *  This is similar to ZSTD_loadDictionaryContent.\n248\t *\n249\t *  The tables for the other strategies are filled within their\n250\t *  block compressors. */\n251\tstatic size_t ZSTD_ldm_fillFastTables(ZSTD_MatchState_t* ms,\n252\t                                      void const* end)\n253\t{\n254\t    const BYTE* const iend = (const BYTE*)end;\n255\t\n256\t    switch(ms->cParams.strategy)\n257\t    {\n258\t    case ZSTD_fast:\n259\t        ZSTD_fillHashTable(ms, iend, ZSTD_dtlm_fast, ZSTD_tfp_forCCtx);\n260\t        break;\n261\t\n262\t    case ZSTD_dfast:\n263\t#ifndef ZSTD_EXCLUDE_DFAST_BLOCK_COMPRESSOR\n264\t        ZSTD_fillDoubleHashTable(ms, iend, ZSTD_dtlm_fast, ZSTD_tfp_forCCtx);\n265\t#else\n266\t        assert(0); /* shouldn't be called: cparams should've been adjusted. */\n267\t#endif\n268\t        break;\n269\t\n270\t    case ZSTD_greedy:\n271\t    case ZSTD_lazy:\n272\t    case ZSTD_lazy2:\n273\t    case ZSTD_btlazy2:\n274\t    case ZSTD_btopt:\n275\t    case ZSTD_btultra:\n276\t    case ZSTD_btultra2:\n277\t        break;\n278\t    default:\n279\t        assert(0);  /* not possible : not a valid strategy id */\n280\t    }\n281\t\n282\t    return 0;\n283\t}\n284\t\n285\tvoid ZSTD_ldm_fillHashTable(\n286\t            ldmState_t* ldmState, const BYTE* ip,\n287\t            const BYTE* iend, ldmParams_t const* params)\n288\t{\n289\t    U32 const minMatchLength = params->minMatchLength;\n290\t    U32 const bucketSizeLog = params->bucketSizeLog;\n291\t    U32 const hBits = params->hashLog - bucketSizeLog;\n292\t    BYTE const* const base = ldmState->window.base;\n293\t    BYTE const* const istart = ip;\n294\t    ldmRollingHashState_t hashState;\n295\t    size_t* const splits = ldmState->splitIndices;\n296\t    unsigned numSplits;\n297\t\n298\t    DEBUGLOG(5, \"ZSTD_ldm_fillHashTable\");\n299\t\n300\t    ZSTD_ldm_gear_init(&hashState, params);\n301\t    while (ip < iend) {\n302\t        size_t hashed;\n303\t        unsigned n;\n304\t\n305\t        numSplits = 0;\n306\t        hashed = ZSTD_ldm_gear_feed(&hashState, ip, (size_t)(iend - ip), splits, &numSplits);\n307\t\n308\t        for (n = 0; n < numSplits; n++) {\n309\t            if (ip + splits[n] >= istart + minMatchLength) {\n310\t                BYTE const* const split = ip + splits[n] - minMatchLength;\n311\t                U64 const xxhash = XXH64(split, minMatchLength, 0);\n312\t                U32 const hash = (U32)(xxhash & (((U32)1 << hBits) - 1));\n313\t                ldmEntry_t entry;\n314\t\n315\t                entry.offset = (U32)(split - base);\n316\t                entry.checksum = (U32)(xxhash >> 32);\n317\t                ZSTD_ldm_insertEntry(ldmState, hash, entry, params->bucketSizeLog);\n318\t            }\n319\t        }\n320\t\n321\t        ip += hashed;\n322\t    }\n323\t}\n324\t\n325\t\n326\t/** ZSTD_ldm_limitTableUpdate() :\n327\t *\n328\t *  Sets cctx->nextToUpdate to a position corresponding closer to anchor\n329\t *  if it is far way\n330\t *  (after a long match, only update tables a limited amount). */\n331\tstatic void ZSTD_ldm_limitTableUpdate(ZSTD_MatchState_t* ms, const BYTE* anchor)\n332\t{\n333\t    U32 const curr = (U32)(anchor - ms->window.base);\n334\t    if (curr > ms->nextToUpdate + 1024) {\n335\t        ms->nextToUpdate =\n336\t            curr - MIN(512, curr - ms->nextToUpdate - 1024);\n337\t    }\n338\t}\n339\t\n340\tstatic\n341\tZSTD_ALLOW_POINTER_OVERFLOW_ATTR\n342\tsize_t ZSTD_ldm_generateSequences_internal(\n343\t        ldmState_t* ldmState, RawSeqStore_t* rawSeqStore,\n344\t        ldmParams_t const* params, void const* src, size_t srcSize)\n345\t{\n346\t    /* LDM parameters */\n347\t    int const extDict = ZSTD_window_hasExtDict(ldmState->window);\n348\t    U32 const minMatchLength = params->minMatchLength;\n349\t    U32 const entsPerBucket = 1U << params->bucketSizeLog;\n350\t    U32 const hBits = params->hashLog - params->bucketSizeLog;\n351\t    /* Prefix and extDict parameters */\n352\t    U32 const dictLimit = ldmState->window.dictLimit;\n353\t    U32 const lowestIndex = extDict ? ldmState->window.lowLimit : dictLimit;\n354\t    BYTE const* const base = ldmState->window.base;\n355\t    BYTE const* const dictBase = extDict ? ldmState->window.dictBase : NULL;\n356\t    BYTE const* const dictStart = extDict ? dictBase + lowestIndex : NULL;\n357\t    BYTE const* const dictEnd = extDict ? dictBase + dictLimit : NULL;\n358\t    BYTE const* const lowPrefixPtr = base + dictLimit;\n359\t    /* Input bounds */\n360\t    BYTE const* const istart = (BYTE const*)src;\n361\t    BYTE const* const iend = istart + srcSize;\n362\t    BYTE const* const ilimit = iend - HASH_READ_SIZE;\n363\t    /* Input positions */\n364\t    BYTE const* anchor = istart;\n365\t    BYTE const* ip = istart;\n366\t    /* Rolling hash state */\n367\t    ldmRollingHashState_t hashState;\n368\t    /* Arrays for staged-processing */\n369\t    size_t* const splits = ldmState->splitIndices;\n370\t    ldmMatchCandidate_t* const candidates = ldmState->matchCandidates;\n371\t    unsigned numSplits;\n372\t\n373\t    if (srcSize < minMatchLength)\n374\t        return iend - anchor;\n375\t\n376\t    /* Initialize the rolling hash state with the first minMatchLength bytes */\n377\t    ZSTD_ldm_gear_init(&hashState, params);\n378\t    ZSTD_ldm_gear_reset(&hashState, ip, minMatchLength);\n379\t    ip += minMatchLength;\n380\t\n381\t    while (ip < ilimit) {\n382\t        size_t hashed;\n383\t        unsigned n;\n384\t\n385\t        numSplits = 0;\n386\t        hashed = ZSTD_ldm_gear_feed(&hashState, ip, ilimit - ip,\n387\t                                    splits, &numSplits);\n388\t\n389\t        for (n = 0; n < numSplits; n++) {\n390\t            BYTE const* const split = ip + splits[n] - minMatchLength;\n391\t            U64 const xxhash = XXH64(split, minMatchLength, 0);\n392\t            U32 const hash = (U32)(xxhash & (((U32)1 << hBits) - 1));\n393\t\n394\t            candidates[n].split = split;\n395\t            candidates[n].hash = hash;\n396\t            candidates[n].checksum = (U32)(xxhash >> 32);\n397\t            candidates[n].bucket = ZSTD_ldm_getBucket(ldmState, hash, params->bucketSizeLog);\n398\t            PREFETCH_L1(candidates[n].bucket);\n399\t        }\n400\t\n401\t        for (n = 0; n < numSplits; n++) {\n402\t            size_t forwardMatchLength = 0, backwardMatchLength = 0,\n403\t                   bestMatchLength = 0, mLength;\n404\t            U32 offset;\n405\t            BYTE const* const split = candidates[n].split;\n406\t            U32 const checksum = candidates[n].checksum;\n407\t            U32 const hash = candidates[n].hash;\n408\t            ldmEntry_t* const bucket = candidates[n].bucket;\n409\t            ldmEntry_t const* cur;\n410\t            ldmEntry_t const* bestEntry = NULL;\n411\t            ldmEntry_t newEntry;\n412\t\n413\t            newEntry.offset = (U32)(split - base);\n414\t            newEntry.checksum = checksum;\n415\t\n416\t            /* If a split point would generate a sequence overlapping with\n417\t             * the previous one, we merely register it in the hash table and\n418\t             * move on */\n419\t            if (split < anchor) {\n420\t                ZSTD_ldm_insertEntry(ldmState, hash, newEntry, params->bucketSizeLog);\n421\t                continue;\n422\t            }\n423\t\n424\t            for (cur = bucket; cur < bucket + entsPerBucket; cur++) {\n425\t                size_t curForwardMatchLength, curBackwardMatchLength,\n426\t                       curTotalMatchLength;\n427\t                if (cur->checksum != checksum || cur->offset <= lowestIndex) {\n428\t                    continue;\n429\t                }\n430\t                if (extDict) {\n431\t                    BYTE const* const curMatchBase =\n432\t                        cur->offset < dictLimit ? dictBase : base;\n433\t                    BYTE const* const pMatch = curMatchBase + cur->offset;\n434\t                    BYTE const* const matchEnd =\n435\t                        cur->offset < dictLimit ? dictEnd : iend;\n436\t                    BYTE const* const lowMatchPtr =\n437\t                        cur->offset < dictLimit ? dictStart : lowPrefixPtr;\n438\t                    curForwardMatchLength =\n439\t                        ZSTD_count_2segments(split, pMatch, iend, matchEnd, lowPrefixPtr);\n440\t                    if (curForwardMatchLength < minMatchLength) {\n441\t                        continue;\n442\t                    }\n443\t                    curBackwardMatchLength = ZSTD_ldm_countBackwardsMatch_2segments(\n444\t                            split, anchor, pMatch, lowMatchPtr, dictStart, dictEnd);\n445\t                } else { /* !extDict */\n446\t                    BYTE const* const pMatch = base + cur->offset;\n447\t                    curForwardMatchLength = ZSTD_count(split, pMatch, iend);\n448\t                    if (curForwardMatchLength < minMatchLength) {\n449\t                        continue;\n450\t                    }\n451\t                    curBackwardMatchLength =\n452\t                        ZSTD_ldm_countBackwardsMatch(split, anchor, pMatch, lowPrefixPtr);\n453\t                }\n454\t                curTotalMatchLength = curForwardMatchLength + curBackwardMatchLength;\n455\t\n456\t                if (curTotalMatchLength > bestMatchLength) {\n457\t                    bestMatchLength = curTotalMatchLength;\n458\t                    forwardMatchLength = curForwardMatchLength;\n459\t                    backwardMatchLength = curBackwardMatchLength;\n460\t                    bestEntry = cur;\n461\t                }\n462\t            }\n463\t\n464\t            /* No match found -- insert an entry into the hash table\n465\t             * and process the next candidate match */\n466\t            if (bestEntry == NULL) {\n467\t                ZSTD_ldm_insertEntry(ldmState, hash, newEntry, params->bucketSizeLog);\n468\t                continue;\n469\t            }\n470\t\n471\t            /* Match found */\n472\t            offset = (U32)(split - base) - bestEntry->offset;\n473\t            mLength = forwardMatchLength + backwardMatchLength;\n474\t            {\n475\t                rawSeq* const seq = rawSeqStore->seq + rawSeqStore->size;\n476\t\n477\t                /* Out of sequence storage */\n478\t                if (rawSeqStore->size == rawSeqStore->capacity)\n479\t                    return ERROR(dstSize_tooSmall);\n480\t                seq->litLength = (U32)(split - backwardMatchLength - anchor);\n481\t                seq->matchLength = (U32)mLength;\n482\t                seq->offset = offset;\n483\t                rawSeqStore->size++;\n484\t            }\n485\t\n486\t            /* Insert the current entry into the hash table --- it must be\n487\t             * done after the previous block to avoid clobbering bestEntry */\n488\t            ZSTD_ldm_insertEntry(ldmState, hash, newEntry, params->bucketSizeLog);\n489\t\n490\t            anchor = split + forwardMatchLength;\n491\t\n492\t            /* If we find a match that ends after the data that we've hashed\n493\t             * then we have a repeating, overlapping, pattern. E.g. all zeros.\n494\t             * If one repetition of the pattern matches our `stopMask` then all\n495\t             * repetitions will. We don't need to insert them all into out table,\n496\t             * only the first one. So skip over overlapping matches.\n497\t             * This is a major speed boost (20x) for compressing a single byte\n498\t             * repeated, when that byte ends up in the table.\n499\t             */\n500\t            if (anchor > ip + hashed) {\n501\t                ZSTD_ldm_gear_reset(&hashState, anchor - minMatchLength, minMatchLength);\n502\t                /* Continue the outer loop at anchor (ip + hashed == anchor). */\n503\t                ip = anchor - hashed;\n504\t                break;\n505\t            }\n506\t        }\n507\t\n508\t        ip += hashed;\n509\t    }\n510\t\n511\t    return iend - anchor;\n512\t}\n513\t\n514\t/*! ZSTD_ldm_reduceTable() :\n515\t *  reduce table indexes by `reducerValue` */\n516\tstatic void ZSTD_ldm_reduceTable(ldmEntry_t* const table, U32 const size,\n517\t                                 U32 const reducerValue)\n518\t{\n519\t    U32 u;\n520\t    for (u = 0; u < size; u++) {\n521\t        if (table[u].offset < reducerValue) table[u].offset = 0;\n522\t        else table[u].offset -= reducerValue;\n523\t    }\n524\t}\n525\t\n526\tsize_t ZSTD_ldm_generateSequences(\n527\t        ldmState_t* ldmState, RawSeqStore_t* sequences,\n528\t        ldmParams_t const* params, void const* src, size_t srcSize)\n529\t{\n530\t    U32 const maxDist = 1U << params->windowLog;\n531\t    BYTE const* const istart = (BYTE const*)src;\n532\t    BYTE const* const iend = istart + srcSize;\n533\t    size_t const kMaxChunkSize = 1 << 20;\n534\t    size_t const nbChunks = (srcSize / kMaxChunkSize) + ((srcSize % kMaxChunkSize) != 0);\n535\t    size_t chunk;\n536\t    size_t leftoverSize = 0;\n537\t\n538\t    assert(ZSTD_CHUNKSIZE_MAX >= kMaxChunkSize);\n539\t    /* Check that ZSTD_window_update() has been called for this chunk prior\n540\t     * to passing it to this function.\n541\t     */\n542\t    assert(ldmState->window.nextSrc >= (BYTE const*)src + srcSize);\n543\t    /* The input could be very large (in zstdmt), so it must be broken up into\n544\t     * chunks to enforce the maximum distance and handle overflow correction.\n545\t     */\n546\t    assert(sequences->pos <= sequences->size);\n547\t    assert(sequences->size <= sequences->capacity);\n548\t    for (chunk = 0; chunk < nbChunks && sequences->size < sequences->capacity; ++chunk) {\n549\t        BYTE const* const chunkStart = istart + chunk * kMaxChunkSize;\n550\t        size_t const remaining = (size_t)(iend - chunkStart);\n551\t        BYTE const *const chunkEnd =\n552\t            (remaining < kMaxChunkSize) ? iend : chunkStart + kMaxChunkSize;\n553\t        size_t const chunkSize = chunkEnd - chunkStart;\n554\t        size_t newLeftoverSize;\n555\t        size_t const prevSize = sequences->size;\n556\t\n557\t        assert(chunkStart < iend);\n558\t        /* 1. Perform overflow correction if necessary. */\n559\t        if (ZSTD_window_needOverflowCorrection(ldmState->window, 0, maxDist, ldmState->loadedDictEnd, chunkStart, chunkEnd)) {\n560\t            U32 const ldmHSize = 1U << params->hashLog;\n561\t            U32 const correction = ZSTD_window_correctOverflow(\n562\t                &ldmState->window, /* cycleLog */ 0, maxDist, chunkStart);\n563\t            ZSTD_ldm_reduceTable(ldmState->hashTable, ldmHSize, correction);\n564\t            /* invalidate dictionaries on overflow correction */\n565\t            ldmState->loadedDictEnd = 0;\n566\t        }\n567\t        /* 2. We enforce the maximum offset allowed.\n568\t         *\n569\t         * kMaxChunkSize should be small enough that we don't lose too much of\n570\t         * the window through early invalidation.\n571\t         * TODO: * Test the chunk size.\n572\t         *       * Try invalidation after the sequence generation and test the\n573\t         *         offset against maxDist directly.\n574\t         *\n575\t         * NOTE: Because of dictionaries + sequence splitting we MUST make sure\n576\t         * that any offset used is valid at the END of the sequence, since it may\n577\t         * be split into two sequences. This condition holds when using\n578\t         * ZSTD_window_enforceMaxDist(), but if we move to checking offsets\n579\t         * against maxDist directly, we'll have to carefully handle that case.\n580\t         */\n581\t        ZSTD_window_enforceMaxDist(&ldmState->window, chunkEnd, maxDist, &ldmState->loadedDictEnd, NULL);\n582\t        /* 3. Generate the sequences for the chunk, and get newLeftoverSize. */\n583\t        newLeftoverSize = ZSTD_ldm_generateSequences_internal(\n584\t            ldmState, sequences, params, chunkStart, chunkSize);\n585\t        if (ZSTD_isError(newLeftoverSize))\n586\t            return newLeftoverSize;\n587\t        /* 4. We add the leftover literals from previous iterations to the first\n588\t         *    newly generated sequence, or add the `newLeftoverSize` if none are\n589\t         *    generated.\n590\t         */\n591\t        /* Prepend the leftover literals from the last call */\n592\t        if (prevSize < sequences->size) {\n593\t            sequences->seq[prevSize].litLength += (U32)leftoverSize;\n594\t            leftoverSize = newLeftoverSize;\n595\t        } else {\n596\t            assert(newLeftoverSize == chunkSize);\n597\t            leftoverSize += chunkSize;\n598\t        }\n599\t    }\n600\t    return 0;\n601\t}\n602\t\n603\tvoid\n604\tZSTD_ldm_skipSequences(RawSeqStore_t* rawSeqStore, size_t srcSize, U32 const minMatch)\n605\t{\n606\t    while (srcSize > 0 && rawSeqStore->pos < rawSeqStore->size) {\n607\t        rawSeq* seq = rawSeqStore->seq + rawSeqStore->pos;\n608\t        if (srcSize <= seq->litLength) {\n609\t            /* Skip past srcSize literals */\n610\t            seq->litLength -= (U32)srcSize;\n611\t            return;\n612\t        }\n613\t        srcSize -= seq->litLength;\n614\t        seq->litLength = 0;\n615\t        if (srcSize < seq->matchLength) {\n616\t            /* Skip past the first srcSize of the match */\n617\t            seq->matchLength -= (U32)srcSize;\n618\t         