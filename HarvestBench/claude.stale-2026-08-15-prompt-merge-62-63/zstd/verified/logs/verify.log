{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EReB3sBXPe51pVEzn4Anz4","type":"tool_result","content":"//! Phase B smoke tests: validate the harness itself and the most basic\n//! C-vs-Rust parity (version, bounds, error strings, one-shot round trip).\nmod common;\nuse common::*;\nuse std::ffi::c_void;\n\ntype FnU32Void = unsafe extern \"C\" fn() -> u32;\ntype FnI32Void = unsafe extern \"C\" fn() -> i32;\ntype FnUsizeVoid = unsafe extern \"C\" fn() -> usize;\ntype FnBounds = unsafe extern \"C\" fn(i32) -> ZSTD_bounds;\ntype FnCompress =\n    unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, i32) -> usize;\ntype FnDecompress = unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize) -> usize;\ntype FnCompressBound = unsafe extern \"C\" fn(usize) -> usize;\n\n#[test]\nfn version_and_levels_match() {\n    let (c, r) = pair::<FnU32Void>(\"ZSTD_versionNumber\");\n    unsafe { assert_eq!(c(), r(), \"ZSTD_versionNumber\") };\n\n    let (c, r) = pair::<unsafe extern \"C\" fn() -> *const std::os::raw::c_char>(\"ZSTD_versionString\");\n    unsafe {\n        let cs = std::ffi::CStr::from_ptr(c()).to_string_lossy().into_owned();\n        let rs = std::ffi::CStr::from_ptr(r()).to_string_lossy().into_owned();\n        assert_eq!(cs, rs, \"ZSTD_versionString\");\n    }\n\n    for name in [\"ZSTD_maxCLevel\", \"ZSTD_minCLevel\", \"ZSTD_defaultCLevel\"] {\n        let (c, r) = pair::<FnI32Void>(name);\n        unsafe { assert_eq!(c(), r(), \"{name}\") };\n    }\n\n    for name in [\n        \"ZSTD_CStreamInSize\",\n        \"ZSTD_CStreamOutSize\",\n        \"ZSTD_DStreamInSize\",\n        \"ZSTD_DStreamOutSize\",\n        \"ZSTD_estimateDCtxSize\",\n    ] {\n        let (c, r) = pair::<FnUsizeVoid>(name);\n        unsafe { assert_eq!(c(), r(), \"{name}\") };\n    }\n}\n\n#[test]\nfn cparam_bounds_match_for_every_param_including_invalid() {\n    let (c, r) = pair::<FnBounds>(\"ZSTD_cParam_getBounds\");\n    // Every valid param, every retired param, and a sweep of invalid ints\n    // (C enums accept any int across FFI).\n    let mut params: Vec<i32> = ALL_CPARAMS.to_vec();\n    params.extend_from_slice(&[\n        1003, // retired experimentalParam6\n        0, -1, -100, 1, 99, 108, 129, 131, 159, 165, 199, 203, 399, 403, 499, 501, 999, 1018,\n        1019, 2000, i32::MIN, i32::MAX,\n    ]);\n    for p in params {\n        unsafe {\n            let cb = c(p);\n            let rb = r(p);\n            assert_eq!(cb, rb, \"ZSTD_cParam_getBounds({p})\");","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_011YDfa5uGtCzKrgciqkC7an","session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"4ae38317-6c4c-4a63-8204-c46a96d6a6f3","timestamp":"2026-08-14T21:35:45.197Z","subagent_type":"general-purpose","task_description":"Write legacy and zbuff tests"}
