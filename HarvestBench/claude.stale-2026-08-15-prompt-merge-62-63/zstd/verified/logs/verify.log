i.createCCtx)();\n                        let rr = (api.refCDict)(cctx, cdict);\n                        if is_error(rr) {\n                            (api.freeCCtx)(cctx);\n                            (api.freeCDict)(cdict);\n                            return Out::err(rr);\n                        }\n                        let cap = (api.compressBound)(src.len()) + 128;\n                        let mut buf = vec![0u8; cap];\n                        let ret = (api.compress2)(\n                            cctx,\n                            as_ptr_m(&mut buf),\n                            cap,\n                            as_ptr_c(&src),\n                            src.len(),\n                        );\n                        (api.freeCCtx)(cctx);\n                        (api.freeCDict)(cdict);\n                        Out::ok(ret, &buf)\n                    }\n                };\n                let c = run(capi());\n                let r = run(rapi());\n                same_out(&ctx, &c, &r);\n                if ok(c.ret) {\n                    for api in [capi(), rapi()] {\n                        let d2 = decomp_dict(api, &c.bytes, &d, DictMode::Load, src.len());\n                        assert!(ok(d2.ret), \"{ctx}: {} decompress err\", api.tag);\n                        assert_bytes_eq(&format!(\"{ctx}/rt[{}]\", api.tag), &src, &d2.bytes);\n                    }\n                }\n            }\n        }\n    }\n    // the hashLog/chainLog suffix-clamp case: raw dict much larger than the tables\n    let big = gen(Shape::Text, 200_000, &mut drng);\n    for &(hl, cl) in &[(6u32, 6u32), (10, 10), (17, 17)] {\n        check_frame_dict(\n            &format!(\"row117 suffix clamp hashLog={hl} chainLog={cl}\"),\n            &[\n                (ZSTD_c_compressionLevel, 3),\n                (ZSTD_c_hashLog, hl as i32),\n                (ZSTD_c_chainLog, cl as i32),\n            ],\n            &big,\n            DictMode::Load,\n            &src,\n        );\n    }\n}\n\n#[test]\nfn p5_row118_dict_table_fills_all_strategies() {\n    // Drives ZSTD_fillHashTable / ZSTD_fillDoubleHashTable / ZSTD_row_update /\n    // ZSTD_insertAndFindFirstIndex / ZSTD_updateTree /\n    // ZSTD_dedicatedDictSearch_lazy_loadDictionary through every strategy x\n    // dictMode x rowMatchFinder combination, and requires byte-identical frames.\n    let mut rng = Rng::new(0x11_80_00_11);\n    let src = gen(Shape::Text, 20_000, &mut rng);\n    for &dl in &[8usize, 1024, 65536] {\n        let dict = gen(Shape::Text, dl, &mut rng);\n        for &strat in ALL_STRATEGIES {\n            for &row in &[1i32, 2] {\n                for &dds in &[0i32, 1] {\n                    for &fad in &[0i32, 2] {\n                        let ctx = format!(\n                            \"row118 dictLen={dl} strategy={strat} row={row} dds={dds} \\\n                             forceAttachDict={fad}\"\n                        );\n                        check_frame_dict(\n                            &ctx,\n                            &[\n                                (ZSTD_c_compressionLevel, 3),\n                                (ZSTD_c_strategy, strat),\n                                (ZSTD_c_useRowMatchFinder, row),\n                                (ZSTD_c_enableDedicatedDictSearch, dds),\n                                (ZSTD_c_forceAttachDict, fad),\n                            ],\n                            &dict,\n                            DictMode::Load,\n                            &src,\n                        );\n                        // extDict path: the same dictionary as a prefix\n                        check_frame_dict(\n                            &format!(\"{ctx} (refPrefix/extDict)\"),\n                            &[\n                                (ZSTD_c_compressionLevel, 3),\n                                (ZSTD_c_strategy, strat),\n                                (ZSTD_c_useRowMatchFinder, row),\n                            ],\n         