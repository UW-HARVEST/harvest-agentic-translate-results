{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_33dttqhpxeclps2e73hszlei2xlojsocogufpazsfzh6g72xtora","type":"message","role":"assistant","content":[{"type":"text","text":"Now let me write a smoke test to validate the harness infrastructure."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2616,"cache_read_input_tokens":108382,"cache_creation":{"ephemeral_5m_input_tokens":2616,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"909bbd54-a9e7-4842-824d-d7bfb54e3ef1","timestamp":"2026-08-14T21:16:16.241Z"}
{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_33dttqhpxeclps2e73hszlei2xlojsocogufpazsfzh6g72xtora","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_011iMq6x18go1v6Z2b8tqcWf","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/phase_b_smoke.rs","content":"//! Phase B smoke tests: validate the harness itself and the most basic\n//! C-vs-Rust parity (version, bounds, error strings, one-shot round trip).\nmod common;\nuse common::*;\nuse std::ffi::c_void;\n\ntype FnU32Void = unsafe extern \"C\" fn() -> u32;\ntype FnI32Void = unsafe extern \"C\" fn() -> i32;\ntype FnUsizeVoid = unsafe extern \"C\" fn() -> usize;\ntype FnBounds = unsafe extern \"C\" fn(i32) -> ZSTD_bounds;\ntype FnCompress =\n    unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, i32) -> usize;\ntype FnDecompress = unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize) -> usize;\ntype FnCompressBound = unsafe extern \"C\" fn(usize) -> usize;\n\n#[test]\nfn version_and_levels_match() {\n    let (c, r) = pair::<FnU32Void>(\"ZSTD_versionNumber\");\n    unsafe { assert_eq!(c(), r(), \"ZSTD_versionNumber\") };\n\n    let (c, r) = pair::<unsafe extern \"C\" fn() -> *const std::os::raw::c_char>(\"ZSTD_versionString\");\n    unsafe {\n        let cs = std::ffi::CStr::from_ptr(c()).to_string_lossy().into_owned();\n        let rs = std::ffi::CStr::from_ptr(r()).to_string_lossy().into_owned();\n        assert_eq!(cs, rs, \"ZSTD_versionString\");\n    }\n\n    for name in [\"ZSTD_maxCLevel\", \"ZSTD_minCLevel\", \"ZSTD_defaultCLevel\"] {\n        let (c, r) = pair::<FnI32Void>(name);\n        unsafe { assert_eq!(c(), r(), \"{name}\") };\n    }\n\n    for name in [\n        \"ZSTD_CStreamInSize\",\n        \"ZSTD_CStreamOutSize\",\n        \"ZSTD_DStreamInSize\",\n        \"ZSTD_DStreamOutSize\",\n        \"ZSTD_estimateDCtxSize\",\n    ] {\n        let (c, r) = pair::<FnUsizeVoid>(name);\n        unsafe { assert_eq!(c(), r(), \"{name}\") };\n    }\n}\n\n#[test]\nfn cparam_bounds_match_for_every_param_including_invalid() {\n    let (c, r) = pair::<FnBounds>(\"ZSTD_cParam_getBounds\");\n    // Every valid param, every retired param, and a sweep of invalid ints\n    // (C enums accept any int across FFI).\n    let mut params: Vec<i32> = ALL_CPARAMS.to_vec();\n    params.extend_from_slice(&[\n        1003, // retired experimentalParam6\n        0, -1, -100, 1, 99, 108, 129, 131, 159, 165, 199, 203, 399, 403, 499, 501, 999, 1018,\n        1019, 2000, i32::MIN, i32::MAX,\n    ]);\n    for p in params {\n        unsafe {\n            let cb = c(p);\n            let rb = r(p);\n            assert_eq!(cb, rb, \"ZSTD_cParam_getBounds({p})\");\n        }\n    }\n}\n\n#[test]\nfn dparam_bounds_match_for_every_param_including_invalid() {\n    let (c, r) = pair::<FnBounds>(\"ZSTD_dParam_getBounds\");\n    let mut params: Vec<i32> = ALL_DPARAMS.to_vec();\n    params.extend_from_slice(&[\n        0, -1, 1, 99, 101, 999, 1006, 1007, 2000, i32::MIN, i32::MAX,\n    ]);\n    for p in params {\n        unsafe {\n            let cb = c(p);\n            let rb = r(p);\n            assert_eq!(cb, rb, \"ZSTD_dParam_getBounds({p})\");\n        }\n    }\n}\n\n#[test]\nfn error_names_match_for_every_code() {\n    // ZSTD_getErrorName over the whole error-code space plus non-error values.\n    let (cf, rf) =\n        pair::<unsafe extern \"C\" fn(usize) -> *const std::os::raw::c_char>(\"ZSTD_getErrorName\");\n    let (cc, rc) = pair::<unsafe extern \"C\" fn(usize) -> u32>(\"ZSTD_getErrorCode\");\n    let (ci, ri) = pair::<unsafe extern \"C\" fn(usize) -> u32>(\"ZSTD_isError\");\n    for code in 0..=130u64 {\n        let enc = (0u64).wrapping_sub(code) as usize;\n        unsafe {\n            let cs = std::ffi::CStr::from_ptr(cf(enc)).to_string_lossy().into_owned();\n            let rs = std::ffi::CStr::from_ptr(rf(enc)).to_string_lossy().into_owned();\n            assert_eq!(cs, rs, \"ZSTD_getErrorName(-{code})\");\n            assert_eq!(cc(enc), rc(enc), \"ZSTD_getErrorCode(-{code})\");\n            assert_eq!(ci(enc), ri(enc), \"ZSTD_isError(-{code})\");\n        }\n    }\n    // Also plain small values (not errors).\n    for v in [0usize, 1, 2, 100, 1000, usize::MAX / 2] {\n        unsafe {\n            let cs = std::ffi::CStr::from_ptr(cf(v)).to_string_lossy().into_owned();\n            let rs = std::ffi::CStr::from_ptr(rf(v)).to_string_lossy().into_owned();\n            assert_eq!(cs, rs, \"ZSTD_getErrorName({v})\");\n            assert_eq!(ci(v), ri(v), \"ZSTD_isError({v})\");\n        }\n    }\n    // ERR_getErrorString is exported directly too.\n    let (cg, rg) =\n        pair::<unsafe extern \"C\" fn(u32) -> *const std::os::raw::c_char>(\"ERR_getErrorString\");\n    for code in 0..=130u32 {\n        unsafe {\n            let cs = std::ffi::CStr::from_ptr(cg(code)).to_string_lossy().into_owned();\n            let rs = std::ffi::CStr::from_ptr(rg(code)).to_string_lossy().into_owned();\n            assert_eq!(cs, rs, \"ERR_getErrorString({code})\");\n        }\n    }\n}\n\n#[test]\nfn compress_bound_matches() {\n    let (c, r) = pair::<FnCompressBound>(\"ZSTD_compressBound\");\n    let mut sizes: Vec<usize> = vec![\n        0,\n        1,\n        2,\n        7,\n        8,\n        127,\n        128,\n        1023,\n        1024,\n        ZSTD_BLOCKSIZE_MAX - 1,\n        ZSTD_BLOCKSIZE_MAX,\n        ZSTD_BLOCKSIZE_MAX + 1,\n        1 << 20,\n        1 << 30,\n    ];\n    // ZSTD_MAX_INPUT_SIZE boundary: 0xFF00FF00FF00FF00 on 64-bit.\n    let max_input: usize = 0xFF00_FF00_FF00_FF00;\n    sizes.extend_from_slice(&[max_input - 1, max_input, max_input + 1, usize::MAX]);\n    let mut rng = Rng::new(0xB0UND);\n    for _ in 0..200 {\n        sizes.push(rng.below(1 << 22));\n    }\n    for s in sizes {\n        unsafe { assert_ret_eq(&format!(\"ZSTD_compressBound({s})\"), c(s), r(s)) };\n    }\n}\n\n#[test]\nfn simple_roundtrip_is_byte_identical() {\n    let (cc, rc) = pair::<FnCompress>(\"ZSTD_compress\");\n    let (cd, rd) = pair::<FnDecompress>(\"ZSTD_decompress\");\n    let (cb, _) = pair::<FnCompressBound>(\"ZSTD_compressBound\");\n    let mut rng = Rng::new(0x5EED_0001);\n\n    for &shape in ALL_SHAPES {\n        for &len in &[0usize, 1, 7, 100, 4096, 100_000] {\n            let src = gen(shape, len, &mut rng);\n            for lvl in [1i32, 3, 9, 19] {\n                unsafe {\n                    let cap = cb(src.len()).max(64);\n                    let mut cbuf = vec![0u8; cap];\n                    let mut rbuf = vec![0u8; cap];\n                    let cn = cc(\n                        cbuf.as_mut_ptr() as *mut c_void,\n                        cap,\n                        src.as_ptr() as *const c_void,\n                        src.len(),\n                        lvl,\n                    );\n                    let rn = rc(\n                        rbuf.as_mut_ptr() as *mut c_void,\n                        cap,\n                        src.as_ptr() as *const c_void,\n                        src.len(),\n                        lvl,\n                    );\n                    let ctx = format!(\"ZSTD_compress({shape:?},len={len},lvl={lvl})\");\n                    assert_ret_eq(&ctx, cn, rn);\n                    assert!(!is_error(cn), \"{ctx}: C errored: {}\", err_name(c_lib(), cn));\n                    assert_bytes_eq(&ctx, &cbuf[..cn], &rbuf[..rn]);\n\n                    // Decompress the C-produced frame with BOTH decoders.\n                    let mut co = vec![0u8; src.len() + 64];\n                    let mut ro = vec![0u8; src.len() + 64];\n                    let cdn = cd(\n                        co.as_mut_ptr() as *mut c_void,\n                        co.len(),\n                        cbuf.as_ptr() as *const c_void,\n                        cn,\n                    );\n                    let rdn = rd(\n                        ro.as_mut_ptr() as *mut c_void,\n                        ro.len(),\n                        cbuf.as_ptr() as *const c_void,\n                        cn,\n                    );\n                    let dctx = format!(\"ZSTD_decompress({shape:?},len={len},lvl={lvl})\");\n                    assert_ret_eq(&dctx, cdn, rdn);\n                    assert_bytes_eq(&dctx, &co[..cdn], &ro[..rdn]);\n                    assert_bytes_eq(&format!(\"{dctx} vs original\"), &src, &co[..cdn]);\n                }\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2616,"cache_read_input_tokens":108382,"cache_creation":{"ephemeral_5m_input_tokens":2616,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"f4458977-f1c8-4885-a53b-79ee0f912274","timestamp":"2026-08-14T21:16:49.574Z"}
