{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_nl3d237e5rffszflr4e7w2klxzaddrbgxs54b3oehzehiagtt7wq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01CVbu2KBmxrTT1YfKZw2zg5","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/phase_b_streaming.rs","content":"//! Phase B — CONFIGS.md rows 58-86: the STREAMING, BUFFER-LESS/BLOCK-LEVEL and\n//! FRAME-UTILITY entry-point tiers.\n//!\n//! Every scenario is expressed once as a function of `&Api` that records a\n//! *trace* — the exact sequence of return codes plus the `input.pos` /\n//! `output.pos` values after **every** individual call — together with the\n//! produced compressed stream and the regenerated plaintext.  The same closure\n//! is then run against the C `.so` and the Rust `.so` and the two traces must be\n//! identical step for step and byte for byte.\n//!\n//! Nothing is called directly on the Rust crate: both sides go through\n//! `dlopen`/`dlsym`, so the `#[no_mangle] extern \"C\"` surface is under test too.\n#![allow(non_snake_case, non_camel_case_types)]\n\nmod common;\nuse common::*;\nuse std::ffi::c_void;\n\n/// One fixed seed for the whole file => fully reproducible corpora.\nconst SEED: u64 = 0x5157_2A11_0BAD_F00D;\n\n/// Hard cap on the number of iterations any streaming driver may spin for.\n/// Reaching it means the library stopped making forward progress; the driver\n/// records a `STALL` step so C and Rust diverge loudly instead of hanging.\nconst GUARD: usize = 4_000_000;\n\n// ============================================================================\n// Trace: the comparable record of one whole scenario\n// ============================================================================\n\n#[derive(Clone, Copy, PartialEq, Eq)]\nstruct Step {\n    tag: &'static str,\n    a: u64,\n    b: u64,\n    c: u64,\n}\n\nimpl std::fmt::Debug for Step {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let a = self.a as usize;\n        if is_error(a) && (self.a >> 32) == 0xFFFF_FFFF {\n            write!(f, \"{}{{ERR({}) in={} out={}}}\", self.tag, err_code(a), self.b, self.c)\n        } else {\n            write!(f, \"{}{{ret={} in={} out={}}}\", self.tag, self.a, self.b, self.c)\n        }\n    }\n}\n\n#[derive(Clone, PartialEq, Eq, Default)]\nstruct Trace {\n    log: Vec<Step>,\n    /// The compressed byte stream the scenario produced (if any).\n    cdata: Vec<u8>,\n    /// The plaintext the scenario regenerated (if any).\n    out: Vec<u8>,\n}\n\nimpl Trace {\n    fn new() -> Trace {\n        Trace::default()\n    }\n    fn step3(&mut self, tag: &'static str, a: usize, b: usize, c: usize) {\n        self.log.push(Step { tag, a: a as u64, b: b as u64, c: c as u64 });\n    }\n    fn ret(&mut self, tag: &'static str, r: usize) {\n        self.step3(tag, r, 0, 0);\n    }\n    fn u64v(&mut self, tag: &'static str, v: u64) {\n        self.log.push(Step { tag, a: v, b: 0, c: 0 });\n    }\n}\n\nfn slice_dbg(v: &[Step], i: usize) -> Vec<Step> {\n    let lo = i.saturating_sub(4);\n    let hi = (i + 1).min(v.len());\n    if lo >= hi {\n        Vec::new()\n    } else {\n        v[lo..hi].to_vec()\n    }\n}\n\n/// Run `f` on both libraries; require identical step logs and identical bytes.\n/// Returns the C trace so callers can additionally assert C-side correctness\n/// (e.g. \"the round trip really did reproduce the input\").\nfn diff_trace(ctx: &str, f: impl Fn(&Api) -> Trace) -> Trace {\n    let c = f(capi());\n    let r = f(rapi());\n    let n = c.log.len().max(r.log.len());\n    for i in 0..n {\n        let a = c.log.get(i);\n        let b = r.log.get(i);\n        if a != b {\n            panic!(\n                \"{ctx}\\n  first divergence at call #{i} (C made {} calls, Rust made {})\\n  \\\n                 C    = {:?}\\n  Rust = {:?}\\n  C    tail = {:?}\\n  Rust tail = {:?}\",\n                c.log.len(),\n                r.log.len(),\n                a,\n                b,\n                slice_dbg(&c.log, i),\n                slice_dbg(&r.log, i)\n            );\n        }\n    }\n    assert_bytes_eq(&format!(\"{ctx} [compressed stream]\"), &c.cdata, &r.cdata);\n    assert_bytes_eq(&format!(\"{ctx} [regenerated plaintext]\"), &c.out, &r.out);\n    c\n}\n\n/// Resolve a `size_t (*)(void)` in both libs, assert equality, return the value.\nfn nsize(name: &str) -> usize {\n    let (c, r) = pair::<unsafe extern \"C\" fn() -> usize>(name);\n    unsafe {\n        let (cv, rv) = (c(), r());\n        assert_eq!(cv, rv, \"{name}\");\n        cv\n    }\n}\n\nfn cstream_out_size() -> usize {\n    nsize(\"ZSTD_CStreamOutSize\")\n}\nfn cstream_in_size() -> usize {\n    nsize(\"ZSTD_CStreamInSize\")\n}\nfn dstream_out_size() -> usize {\n    nsize(\"ZSTD_DStreamOutSize\")\n}\nfn dstream_in_size() -> usize {\n    nsize(\"ZSTD_DStreamInSize\")\n}\n\n// ============================================================================\n// 1. ZSTD_compressStream2 — all endOps x all buffer sizes\n// ============================================================================\n\n#[derive(Clone, Copy, Debug)]\nstruct SCfg {\n    level: i32,\n    checksum: i32,\n    content_size: i32,\n    pledge: bool,\n    outcap: usize,\n    /// `usize::MAX` == feed the whole input in one `ZSTD_inBuffer`.\n    inchunk: usize,\n    /// 0 == never issue a mid-stream `ZSTD_e_flush`; n == flush after every n chunks.\n    flush_every: usize,\n}\n\n/// Loop `endOp` (flush or end) until the library reports 0 bytes left to flush.\nunsafe fn drain(\n    api: &Api,\n    cctx: *mut ZSTD_CCtx,\n    endop: u32,\n    tag: &'static str,\n    src_anchor: *const u8,\n    obuf: &mut [u8],\n    cdata: &mut Vec<u8>,\n    tr: &mut Trace,\n) -> bool {\n    let outcap = obuf.len();\n    let mut guard = 0usize;\n    loop {\n        let mut inb =\n            ZSTD_inBuffer { src: src_anchor as *const c_void, size: 0, pos: 0 };\n        let mut outb =\n            ZSTD_outBuffer { dst: obuf.as_mut_ptr() as *mut c_void, size: outcap, pos: 0 };\n        let ret = (api.compressStream2)(cctx, &mut outb, &mut inb, endop);\n        tr.step3(tag, ret, inb.pos, outb.pos);\n        if is_error(ret) {\n            return false;\n        }\n        cdata.extend_from_slice(&obuf[..outb.pos]);\n        if ret == 0 {\n            return true;\n        }\n        guard += 1;\n        if guard > GUARD {\n            tr.ret(\"STALL\", 0);\n            return false;\n        }\n    }\n}\n\nunsafe fn cs2_inner(\n    api: &Api,\n    cctx: *mut ZSTD_CCtx,\n    cfg: &SCfg,\n    src: &[u8],\n    tr: &mut Trace,\n) -> Vec<u8> {\n    let mut cdata: Vec<u8> = Vec::new();\n    let r = (api.setParameter)(cctx, ZSTD_c_compressionLevel, cfg.level);\n    tr.ret(\"setLevel\", r);\n    if is_error(r) {\n        return cdata;\n    }\n    let r = (api.setParameter)(cctx, ZSTD_c_checksumFlag, cfg.checksum);\n    tr.ret(\"setChecksum\", r);\n    if is_error(r) {\n        return cdata;\n    }\n    let r = (api.setParameter)(cctx, ZSTD_c_contentSizeFlag, cfg.content_size);\n    tr.ret(\"setContentSize\", r);\n    if is_error(r) {\n        return cdata;\n    }\n    if cfg.pledge {\n        let r = (api.setPledgedSrcSize)(cctx, src.len() as u64);\n        tr.ret(\"pledge\", r);\n        if is_error(r) {\n            return cdata;\n        }\n    }\n\n    let outcap = cfg.outcap.max(1);\n    let mut obuf = vec![0u8; outcap];\n    let inchunk = if cfg.inchunk == usize::MAX { src.len().max(1) } else { cfg.inchunk.max(1) };\n    let anchor = src.as_ptr();\n\n    let mut ipos = 0usize;\n    let mut chunk_no = 0usize;\n    while ipos < src.len() {\n        let end = (ipos + inchunk).min(src.len());\n        let mut inb = ZSTD_inBuffer {\n            src: src.as_ptr().add(ipos) as *const c_void,\n            size: end - ipos,\n            pos: 0,\n        };\n        let mut guard = 0usize;\n        loop {\n            let mut outb = ZSTD_outBuffer {\n                dst: obuf.as_mut_ptr() as *mut c_void,\n                size: outcap,\n                pos: 0,\n            };\n            let ret = (api.compressStream2)(cctx, &mut outb, &mut inb, ZSTD_e_continue);\n            tr.step3(\"cs2/continue\", ret, inb.pos, outb.pos);\n            if is_error(ret) {\n                return cdata;\n            }\n            cdata.extend_from_slice(&obuf[..outb.pos]);\n            if inb.pos == inb.size {\n                break;\n            }\n            guard += 1;\n            if guard > GUARD {\n                tr.ret(\"STALL\", 0);\n                return cdata;\n            }\n        }\n        ipos = end;\n        chunk_no += 1;\n        if cfg.flush_every != 0 && chunk_no % cfg.flush_every == 0 && ipos < src.len() {\n            if !drain(api, cctx, ZSTD_e_flush, \"cs2/flush\", anchor, &mut obuf, &mut cdata, tr) {\n                return cdata;\n            }\n        }\n    }\n\n    // One explicit flush before the final end, to exercise the flush->end path.\n    if cfg.flush_every != 0\n        && !drain(api, cctx, ZSTD_e_flush, \"cs2/flush\", anchor, &mut obuf, &mut cdata, tr)\n    {\n        return cdata;\n    }\n    drain(api, cctx, ZSTD_e_end, \"cs2/end\", anchor, &mut obuf, &mut cdata, tr);\n    cdata\n}\n\nfn cs2_trace(api: &Api, cfg: &SCfg, src: &[u8]) -> Trace {\n    let mut tr = Trace::new();\n    unsafe {\n        let cctx = (api.createCCtx)();\n        assert!(!cctx.is_null(), \"{}: createCCtx\", api.tag);\n        let cdata = cs2_inner(api, cctx, cfg, src, &mut tr);\n        tr.ret(\"sizeofCCtx>0\", ((api.sizeofCCtx)(cctx) > 0) as usize);\n        (api.freeCCtx)(cctx);\n        // Round-trip verification also goes into the trace.\n        if !cdata.is_empty() || src.is_empty() {\n            let dctx = (api.createDCtx)();\n            let mut plain = vec![0u8; src.len() + 64];\n            let dr = (api.decompressDCtx)(\n                dctx,\n                plain.as_mut_ptr() as *mut c_void,\n                plain.len(),\n                cdata.as_ptr() as *const c_void,\n                cdata.len(),\n            );\n            tr.ret(\"roundtrip\", dr);\n            if !is_error(dr) {\n                tr.out = plain[..dr].to_vec();\n            }\n            (api.freeDCtx)(dctx);\n        }\n        tr.cdata = cdata;\n    }\n    tr\n}\n\n#[test]\nfn streaming_compressStream2_all_endops_and_buffer_sizes() {\n    let mut rng = Rng::new(SEED);\n    let cos = cstream_out_size();\n    let outcaps = [1usize, 2, 7, 100, 1024, cos];\n    let inchunks = [1usize, 3, 100, 4096, usize::MAX];\n\n    // -- (a) small sources x EVERY (outcap, inchunk) pair, including srcSize 0.\n    for &n in &[0usize, 1, 100, 4096] {\n        for (si, &shape) in ALL_SHAPES.iter().enumerate() {\n            // Rotate shapes so all six are covered without a 4x6x6x5 explosion.\n            if si % 2 != n % 2 {\n                continue;\n            }\n            let src = gen(shape, n, &mut rng);\n            for &outcap in &outcaps {\n                for &inchunk in &inchunks {\n                    let cfg = SCfg {\n                        level: 3,\n                        checksum: 1,\n                        content_size: 1,\n                        pledge: false,\n                        outcap,\n                        inchunk,\n                        flush_every: 2,\n                    };\n                    let ctx = format!(\n                        \"cs2 n={n} shape={shape:?} outcap={outcap} inchunk={}\",\n                        if inchunk == usize::MAX { \"ALL\".to_string() } else { inchunk.to_string() }\n                    );\n                    let t = diff_trace(&ctx, |a| cs2_trace(a, &cfg, &src));\n                    assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n                }\n            }\n        }\n    }\n\n    // -- (b) levels x checksum x contentSize x pledged, moderate sources.\n    for &n in &[4096usize, 20000] {\n        let src = gen(Shape::Text, n, &mut rng);\n        let rnd = gen(Shape::Random, n, &mut rng);\n        for srcv in [&src, &rnd] {\n            for &level in &[1i32, 3, 9, 19] {\n                for &checksum in &[0i32, 1] {\n                    for &content_size in &[0i32, 1] {\n                        for &pledge in &[false, true] {\n                            let outcap = outcaps[rng.below(outcaps.len())];\n                            let inchunk = inchunks[rng.below(inchunks.len())];\n                            let cfg = SCfg {\n                                level,\n                                checksum,\n                                content_size,\n                                pledge,\n                                outcap: if outcap < 8 { 100 } else { outcap },\n                                inchunk,\n                                flush_every: rng.below(3),\n                            };\n                            let ctx = format!(\"cs2 flags n={n} cfg={cfg:?}\");\n                            let t = diff_trace(&ctx, |a| cs2_trace(a, &cfg, srcv));\n                            assert_eq!(&t.out, *srcv, \"{ctx}: C round trip mismatch\");\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    // -- (c) block-boundary-crossing sources with realistic buffer sizes.\n    for &n in &[131072usize, 300000] {\n        for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n            let src = gen(shape, n, &mut rng);\n            for &level in &[1i32, 3] {\n                for &outcap in &[100usize, 1024, cos] {\n                    for &inchunk in &[4096usize, 13 * 1024, usize::MAX] {\n                        let cfg = SCfg {\n                            level,\n                            checksum: (n % 2) as i32,\n                            content_size: 1,\n                            pledge: level == 3,\n                            outcap,\n                            inchunk,\n                            flush_every: 3,\n                        };\n                        let ctx = format!(\"cs2 big n={n} shape={shape:?} cfg={cfg:?}\");\n                        let t = diff_trace(&ctx, |a| cs2_trace(a, &cfg, &src));\n                        assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n                    }\n                }\n            }\n        }\n    }\n\n    // -- (d) 40 fully randomized scenarios.\n    for it in 0..40 {\n        let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n        let n = rng.range(0, 70000);\n        let src = gen(shape, n, &mut rng);\n        let outcap = *[1usize, 2, 7, 100, 1024, cos, 65536][rng.below(7)];\n        let cfg = SCfg {\n            level: *[1i32, 2, 3, 5, 9, 12, 19][rng.below(7)],\n            checksum: (rng.below(2)) as i32,\n            content_size: (rng.below(2)) as i32,\n            pledge: rng.below(2) == 1,\n            // Keep tiny output buffers away from huge sources (step-count blowup).\n            outcap: if outcap < 8 && n > 8192 { 1024 } else { outcap },\n            inchunk: *[1usize, 3, 100, 4096, 65535, usize::MAX][rng.below(6)],\n            flush_every: rng.below(4),\n        };\n        let ctx = format!(\"cs2 rand#{it} shape={shape:?} n={n} cfg={cfg:?}\");\n        let t = diff_trace(&ctx, |a| cs2_trace(a, &cfg, &src));\n        assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n    }\n\n    // -- (e) the single-call ZSTD_e_end fast path that delegates to compress2,\n    //        plus ZSTD_compressStream2_simpleArgs.\n    type FnSimple = unsafe extern \"C\" fn(\n        *mut ZSTD_CCtx,\n        *mut c_void,\n        usize,\n        *mut usize,\n        *const c_void,\n        usize,\n        *mut usize,\n        u32,\n    ) -> usize;\n    for &n in &[0usize, 1, 7, 1000, 131072, 200000] {\n        let src = gen(Shape::Text, n, &mut rng);\n        for &endop in &[ZSTD_e_continue, ZSTD_e_flush, ZSTD_e_end] {\n            let ctx = format!(\"cs2_simpleArgs n={n} endop={endop}\");\n            diff_trace(&ctx, |a| {\n                let mut tr = Trace::new();\n                unsafe {\n                    let f = sym::<FnSimple>(a.lib, \"ZSTD_compressStream2_simpleArgs\");\n                    let cctx = (a.createCCtx)();\n                    tr.ret(\"setLevel\", (a.setParameter)(cctx, ZSTD_c_compressionLevel, 5));\n                    let cap = (a.compressBound)(n);\n                    let mut dst = vec![0u8; cap];\n                    let mut dpos = 0usize;\n                    let mut spos = 0usize;\n                    let mut guard = 0usize;\n                    loop {\n                        let ret = f(\n                            cctx,\n                            dst.as_mut_ptr() as *mut c_void,\n                            cap,\n                            &mut dpos,\n                            src.as_ptr() as *const c_void,\n                            n,\n                            &mut spos,\n                            endop,\n                        );\n                        tr.step3(\"simpleArgs\", ret, spos, dpos);\n                        if is_error(ret) {\n                            break;\n                        }\n                        if endop == ZSTD_e_continue {\n                            if spos == n {\n                                break;\n                            }\n                        } else if ret == 0 {\n                            break;\n                        }\n                        guard += 1;\n                        if guard > 1000 {\n                            tr.ret(\"STALL\", 0);\n                            break;\n                        }\n                    }\n                    tr.cdata = dst[..dpos].to_vec();\n                    (a.freeCCtx)(cctx);\n                }\n                tr\n            });\n        }\n    }\n}\n\n// ============================================================================\n// 2. deprecated ZSTD_initCStream* / compressStream / flushStream / endStream\n// ============================================================================\n\ntype FnInitCStreamSrcSize = unsafe extern \"C\" fn(*mut ZSTD_CCtx, i32, u64) -> usize;\ntype FnInitCStreamUsingDict =\n    unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const c_void, usize, i32) -> usize;\ntype FnInitCStreamAdvanced =\n    unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const c_void, usize, ZSTD_parameters, u64) -> usize;\ntype FnInitCStreamUsingCDict = unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const ZSTD_CDict) -> usize;\ntype FnInitCStreamUsingCDictAdv =\n    unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const ZSTD_CDict, ZSTD_frameParameters, u64) -> usize;\ntype FnResetCStream = unsafe extern \"C\" fn(*mut ZSTD_CCtx, u64) -> usize;\n\n#[derive(Clone, Copy, Debug)]\nenum CInit<'a> {\n    /// `ZSTD_initCStream(cctx, level)`\n    Level(i32),\n    /// `ZSTD_initCStream_srcSize(cctx, level, pledged)`\n    SrcSize(i32, u64),\n    /// `ZSTD_initCStream_usingDict(cctx, dict, dictSize, level)`\n    UsingDict(&'a [u8], i32),\n    /// `ZSTD_initCStream_advanced(cctx, dict, dictSize, params, pledged)`\n    Advanced(&'a [u8], ZSTD_parameters, u64),\n    /// `ZSTD_initCStream_usingCDict(cctx, cdict)`\n    UsingCDict(&'a [u8], i32),\n    /// `ZSTD_initCStream_usingCDict_advanced(cctx, cdict, fParams, pledged)`\n    UsingCDictAdv(&'a [u8], i32, ZSTD_frameParameters, u64),\n    /// `ZSTD_initCStream(cctx, level)` then `ZSTD_resetCStream(cctx, pledged)`\n    Reset(i32, u64),\n}\n\n/// Drive the *old* streaming tier. Returns (compressed bytes, dict for decode).\nunsafe fn old_stream_compress(\n    api: &Api,\n    init: &CInit,\n    src: &[u8],\n    inchunk: usize,\n    outcap: usize,\n    flush_every: usize,\n    tr: &mut Trace,\n) -> Vec<u8> {\n    let cctx = (api.createCCtx)();\n    assert!(!cctx.is_null(), \"{}: createCCtx\", api.tag);\n    let mut cdict: *mut ZSTD_CDict = std::ptr::null_mut();\n    let mut cdata: Vec<u8> = Vec::new();\n\n    let init_ret = match *init {\n        CInit::Level(l) => (api.initCStream)(cctx, l),\n        CInit::SrcSize(l, p) => {\n            sym::<FnInitCStreamSrcSize>(api.lib, \"ZSTD_initCStream_srcSize\")(cctx, l, p)\n        }\n        CInit::UsingDict(d, l) => sym::<FnInitCStreamUsingDict>(\n            api.lib,\n            \"ZSTD_initCStream_usingDict\",\n        )(cctx, d.as_ptr() as *const c_void, d.len(), l),\n        CInit::Advanced(d, params, p) => sym::<FnInitCStreamAdvanced>(\n            api.lib,\n            \"ZSTD_initCStream_advanced\",\n        )(cctx, d.as_ptr() as *const c_void, d.len(), params, p),\n        CInit::UsingCDict(d, l) => {\n            cdict = (api.createCDict)(d.as_ptr() as *const c_void, d.len(), l);\n            assert!(!cdict.is_null(), \"{}: createCDict\", api.tag);\n            sym::<FnInitCStreamUsingCDict>(api.lib, \"ZSTD_initCStream_usingCDict\")(cctx, cdict)\n        }\n        CInit::UsingCDictAdv(d, l, fp, p) => {\n            cdict = (api.createCDict)(d.as_ptr() as *const c_void, d.len(), l);\n            assert!(!cdict.is_null(), \"{}: createCDict\", api.tag);\n            sym::<FnInitCStreamUsingCDictAdv>(\n                api.lib,\n                \"ZSTD_initCStream_usingCDict_advanced\",\n            )(cctx, cdict, fp, p)\n        }\n        CInit::Reset(l, p) => {\n            let r0 = (api.initCStream)(cctx, l);\n            tr.ret(\"initCStream(pre-reset)\", r0);\n            sym::<FnResetCStream>(api.lib, \"ZSTD_resetCStream\")(cctx, p)\n        }\n    };\n    tr.ret(\"init\", init_ret);\n    if is_error(init_ret) {\n        if !cdict.is_null() {\n            (api.freeCDict)(cdict);\n        }\n        (api.freeCCtx)(cctx);\n        return cdata;\n    }\n\n    let outcap = outcap.max(1);\n    let mut obuf = vec![0u8; outcap];\n    let inchunk = if inchunk == usize::MAX { src.len().max(1) } else { inchunk.max(1) };\n\n    let mut ipos = 0usize;\n    let mut chunk_no = 0usize;\n    let mut failed = false;\n    'outer: while ipos < src.len() {\n        let end = (ipos + inchunk).min(src.len());\n        let mut inb = ZSTD_inBuffer {\n            src: src.as_ptr().add(ipos) as *const c_void,\n            size: end - ipos,\n            pos: 0,\n        };\n        let mut guard = 0usize;\n        loop {\n            let mut outb = ZSTD_outBuffer {\n                dst: obuf.as_mut_ptr() as *mut c_void,\n                size: outcap,\n                pos: 0,\n            };\n            let ret = (api.compressStream)(cctx, &mut outb, &mut inb);\n            tr.step3(\"compressStream\", ret, inb.pos, outb.pos);\n            if is_error(ret) {\n                failed = true;\n                break 'outer;\n            }\n            cdata.extend_from_slice(&obuf[..outb.pos]);\n            if inb.pos == inb.size {\n                break;\n            }\n            guard += 1;\n            if guard > GUARD {\n                tr.ret(\"STALL\", 0);\n                failed = true;\n                break 'outer;\n            }\n        }\n        ipos = end;\n        chunk_no += 1;\n        if flush_every != 0 && chunk_no % flush_every == 0 && ipos < src.len() {\n            let mut guard = 0usize;\n            loop {\n                let mut outb = ZSTD_outBuffer {\n                    dst: obuf.as_mut_ptr() as *mut c_void,\n                    size: outcap,\n                    pos: 0,\n                };\n                let ret = (api.flushStream)(cctx, &mut outb);\n                tr.step3(\"flushStream\", ret, 0, outb.pos);\n                if is_error(ret) {\n                    failed = true;\n                    break 'outer;\n                }\n                cdata.extend_from_slice(&obuf[..outb.pos]);\n                if ret == 0 {\n                    break;\n                }\n                guard += 1;\n                if guard > GUARD {\n                    tr.ret(\"STALL\", 0);\n                    failed = true;\n                    break 'outer;\n                }\n            }\n        }\n    }\n\n    if !failed {\n        let mut guard = 0usize;\n        loop {\n            let mut outb = ZSTD_outBuffer {\n                dst: obuf.as_mut_ptr() as *mut c_void,\n                size: outcap,\n                pos: 0,\n            };\n            let ret = (api.endStream)(cctx, &mut outb);\n            tr.step3(\"endStream\", ret, 0, outb.pos);\n            if is_error(ret) {\n                break;\n            }\n            cdata.extend_from_slice(&obuf[..outb.pos]);\n            if ret == 0 {\n                break;\n            }\n            guard += 1;\n            if guard > GUARD {\n                tr.ret(\"STALL\", 0);\n                break;\n            }\n        }\n    }\n\n    if !cdict.is_null() {\n        (api.freeCDict)(cdict);\n    }\n    (api.freeCCtx)(cctx);\n    cdata\n}\n\n/// One-shot decode with an optional dictionary, recorded into `tr`.\nunsafe fn decode_oneshot(api: &Api, cdata: &[u8], dict: &[u8], expect: usize, tr: &mut Trace) {\n    if cdata.is_empty() {\n        return;\n    }\n    let dctx = (api.createDCtx)();\n    if !dict.is_empty() {\n        tr.ret(\n            \"dLoadDictionary\",\n            (api.dLoadDictionary)(dctx, dict.as_ptr() as *const c_void, dict.len()),\n        );\n    }\n    let mut plain = vec![0u8; expect + 64];\n    let dr = (api.decompressDCtx)(\n        dctx,\n        plain.as_mut_ptr() as *mut c_void,\n        plain.len(),\n        cdata.as_ptr() as *const c_void,\n        cdata.len(),\n    );\n    tr.ret(\"roundtrip\", dr);\n    if !is_error(dr) {\n        tr.out = plain[..dr].to_vec();\n    }\n    (api.freeDCtx)(dctx);\n}\n\n#[test]\nfn streaming_deprecated_compressStream_flush_end() {\n    let mut rng = Rng::new(SEED ^ 0x2222);\n    let cin = cstream_in_size();\n    let cos = cstream_out_size();\n\n    // -- (a) ZSTD_initCStream + compressStream/flushStream/endStream, row 63:\n    //        levels {1,3,19} x 1 / 7 / 131071 / 131073-byte input chunks.\n    for &level in &[1i32, 3, 19] {\n        for &inchunk in &[1usize, 7, 131071, 131073, usize::MAX] {\n            for &n in &[0usize, 1, 6, 4096, 200000] {\n                // 1-byte chunking of 200 KB at level 19 is quadratic-ish; skip.\n                if inchunk < 8 && n > 20000 {\n                    continue;\n                }\n                let src = gen(if n % 3 == 0 { Shape::Text } else { Shape::Records }, n, &mut rng);\n                let outcap = *[7usize, 1024, cos][rng.below(3)];\n                let ctx =\n                    format!(\"oldstream L{level} n={n} inchunk={inchunk} outcap={outcap}\");\n                let init = CInit::Level(level);\n                let t = diff_trace(&ctx, |a| {\n                    let mut tr = Trace::new();\n                    unsafe {\n                        let cdata =\n                            old_stream_compress(a, &init, &src, inchunk, outcap, 2, &mut tr);\n                        decode_oneshot(a, &cdata, &[], n, &mut tr);\n                        tr.cdata = cdata;\n                    }\n                    tr\n                });\n                assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n            }\n        }\n    }\n\n    // -- (b) every init variant, row 65.\n    let dict = gen(Shape::Text, 32 * 1024, &mut rng);\n    let src = gen(Shape::Text, 200_000, &mut rng);\n    let params_c = unsafe { (capi().getParams)(7, src.len() as u64, dict.len()) };\n    let mut params_no_cs = params_c;\n    params_no_cs.fParams.contentSizeFlag = 0;\n    params_no_cs.fParams.checksumFlag = 1;\n    let mut params_nodid = params_c;\n    params_nodid.fParams.noDictIDFlag = 1;\n\n    let fp_a = ZSTD_frameParameters { contentSizeFlag: 1, checksumFlag: 1, noDictIDFlag: 0 };\n    let fp_b = ZSTD_frameParameters { contentSizeFlag: 0, checksumFlag: 0, noDictIDFlag: 1 };\n\n    let inits: Vec<(&str, CInit, &[u8])> = vec![\n        (\"initCStream(L3)\", CInit::Level(3), &[]),\n        (\"srcSize(L3,known)\", CInit::SrcSize(3, src.len() as u64), &[]),\n        (\"srcSize(L3,UNKNOWN)\", CInit::SrcSize(3, ZSTD_CONTENTSIZE_UNKNOWN), &[]),\n        (\"srcSize(L3,0)\", CInit::SrcSize(3, 0), &[]),\n        (\"usingDict(L3)\", CInit::UsingDict(&dict, 3), &dict),\n        (\"usingDict(L19)\", CInit::UsingDict(&dict, 19), &dict),\n        (\"usingDict(empty)\", CInit::UsingDict(&[], 3), &[]),\n        (\"advanced(known)\", CInit::Advanced(&dict, params_c, src.len() as u64), &dict),\n        (\n            \"advanced(UNKNOWN)\",\n            CInit::Advanced(&dict, params_no_cs, ZSTD_CONTENTSIZE_UNKNOWN),\n            &dict,\n        ),\n        (\"advanced(noDictID)\", CInit::Advanced(&dict, params_nodid, src.len() as u64), &dict),\n        (\"advanced(nodict)\", CInit::Advanced(&[], params_c, src.len() as u64), &[]),\n        (\"usingCDict(L3)\", CInit::UsingCDict(&dict, 3), &dict),\n        (\"usingCDict(L19)\", CInit::UsingCDict(&dict, 19), &dict),\n        (\n            \"usingCDictAdv(fpA,known)\",\n            CInit::UsingCDictAdv(&dict, 6, fp_a, src.len() as u64),\n            &dict,\n        ),\n        (\n            \"usingCDictAdv(fpB,UNKNOWN)\",\n            CInit::UsingCDictAdv(&dict, 6, fp_b, ZSTD_CONTENTSIZE_UNKNOWN),\n            &dict,\n        ),\n        (\"reset(known)\", CInit::Reset(4, src.len() as u64), &[]),\n        (\"reset(UNKNOWN)\", CInit::Reset(4, ZSTD_CONTENTSIZE_UNKNOWN), &[]),\n        (\"reset(0)\", CInit::Reset(4, 0), &[]),\n    ];\n\n    for (name, init, dct) in inits {\n        for &(inchunk, outcap) in &[(cin, cos), (7usize, 100usize), (usize::MAX, cos)] {\n            let ctx = format!(\"initvariant {name} inchunk={inchunk} outcap={outcap}\");\n            let t = diff_trace(&ctx, |a| {\n                let mut tr = Trace::new();\n                unsafe {\n                    let cdata = old_stream_compress(a, &init, &src, inchunk, outcap, 3, &mut tr);\n                    decode_oneshot(a, &cdata, dct, src.len(), &mut tr);\n                    tr.cdata = cdata;\n                }\n                tr\n            });\n            assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n        }\n    }\n\n    // -- (c) resetCStream reuse: three successive frames from one CCtx.\n    let ctx = \"resetCStream: 3 frames from one CCtx\";\n    diff_trace(ctx, |a| {\n        let mut tr = Trace::new();\n        unsafe {\n            let cctx = (a.createCCtx)();\n            let reset = sym::<FnResetCStream>(a.lib, \"ZSTD_resetCStream\");\n            let mut all: Vec<u8> = Vec::new();\n            let mut obuf = vec![0u8; 512];\n            for f in 0..3usize {\n                let piece = &src[..(20_000 * (f + 1)).min(src.len())];\n                let r = if f == 0 {\n                    (a.initCStream)(cctx, 5)\n                } else {\n                    reset(cctx, piece.len() as u64)\n                };\n                tr.ret(\"init/reset\", r);\n                let mut inb = ZSTD_inBuffer {\n                    src: piece.as_ptr() as *const c_void,\n                    size: piece.len(),\n                    pos: 0,\n                };\n                let mut guard = 0;\n                while inb.pos < inb.size {\n                    let mut outb = ZSTD_outBuffer {\n                        dst: obuf.as_mut_ptr() as *mut c_void,\n                        size: obuf.len(),\n                        pos: 0,\n                    };\n                    let ret = (a.compressStream)(cctx, &mut outb, &mut inb);\n                    tr.step3(\"compressStream\", ret, inb.pos, outb.pos);\n                    if is_error(ret) {\n                        break;\n                    }\n                    all.extend_from_slice(&obuf[..outb.pos]);\n                    guard += 1;\n                    if guard > GUARD {\n                        tr.ret(\"STALL\", 0);\n                        break;\n                    }\n                }\n                loop {\n                    let mut outb = ZSTD_outBuffer {\n                        dst: obuf.as_mut_ptr() as *mut c_void,\n                        size: obuf.len(),\n                        pos: 0,\n                    };\n                    let ret = (a.endStream)(cctx, &mut outb);\n                    tr.step3(\"endStream\", ret, 0, outb.pos);\n                    if is_error(ret) || ret == 0 {\n                        all.extend_from_slice(&obuf[..outb.pos]);\n                        break;\n                    }\n                    all.extend_from_slice(&obuf[..outb.pos]);\n                }\n            }\n            (a.freeCCtx)(cctx);\n            tr.cdata = all;\n        }\n        tr\n    });\n}\n\n// ============================================================================\n// 3. ZSTD_decompressStream over every buffer geometry\n// ============================================================================\n\n#[derive(Clone, Copy)]\nenum DDict<'a> {\n    None,\n    Load(&'a [u8]),\n    Prefix(&'a [u8]),\n    Ref(&'a [u8]),\n}\n\n/// Stream-decode `frame` with the given buffer geometry, recording every call.\nunsafe fn stream_decompress(\n    api: &Api,\n    frame: &[u8],\n    outcap: usize,\n    inchunk: usize,\n    dict: DDict,\n    stable_out: Option<usize>,\n    tr: &mut Trace,\n) -> Vec<u8> {\n    let dctx = (api.createDCtx)();\n    assert!(!dctx.is_null(), \"{}: createDCtx\", api.tag);\n    let mut ddict: *mut ZSTD_DDict = std::ptr::null_mut();\n    let mut plain: Vec<u8> = Vec::new();\n\n    tr.ret(\"initDStream\", (api.initDStream)(dctx));\n    match dict {\n        DDict::None => {}\n        DDict::Load(d) => tr.ret(\n            \"dLoadDictionary\",\n            (api.dLoadDictionary)(dctx, d.as_ptr() as *const c_void, d.len()),\n        ),\n        DDict::Prefix(d) => tr.ret(\n            \"dRefPrefix\",\n            (api.dRefPrefix)(dctx, d.as_ptr() as *const c_void, d.len()),\n        ),\n        DDict::Ref(d) => {\n            ddict = (api.createDDict)(d.as_ptr() as *const c_void, d.len());\n            assert!(!ddict.is_null(), \"{}: createDDict\", api.tag);\n            tr.ret(\"dRefDDict\", (api.dRefDDict)(dctx, ddict));\n        }\n    }\n\n    let inchunk = if inchunk == usize::MAX { frame.len().max(1) } else { inchunk.max(1) };\n\n    if let Some(total) = stable_out {\n        // ZSTD_d_stableOutBuffer: one buffer, never moved, big enough for the frame.\n        tr.ret(\"d_stableOutBuffer\", (api.dSetParameter)(dctx, ZSTD_d_stableOutBuffer, 1));\n        let mut obuf = vec![0u8; total];\n        let mut outb =\n            ZSTD_outBuffer { dst: obuf.as_mut_ptr() as *mut c_void, size: total, pos: 0 };\n        let mut ipos = 0usize;\n        let mut guard = 0usize;\n        loop {\n            let take = inchunk.min(frame.len() - ipos);\n            let mut inb = ZSTD_inBuffer {\n                src: frame.as_ptr().add(ipos) as *const c_void,\n                size: take,\n                pos: 0,\n            };\n            let before = outb.pos;\n            let ret = (api.decompressStream)(dctx, &mut outb, &mut inb);\n            tr.step3(\"dstream/stable\", ret, inb.pos, outb.pos);\n            if is_error(ret) {\n                break;\n            }\n            ipos += inb.pos;\n            if ipos >= frame.len() && inb.pos == 0 && outb.pos == before {\n                break;\n            }\n            guard += 1;\n            if guard > GUARD {\n                tr.ret(\"STALL\", 0);\n                break;\n            }\n        }\n        plain = obuf[..outb.pos].to_vec();\n    } else {\n        let outcap = outcap.max(1);\n        let mut obuf = vec![0u8; outcap];\n        let mut ipos = 0usize;\n        let mut guard = 0usize;\n        loop {\n            let take = inchunk.min(frame.len() - ipos);\n            let mut inb = ZSTD_inBuffer {\n                src: frame.as_ptr().add(ipos) as *const c_void,\n                size: take,\n                pos: 0,\n            };\n            let mut outb = ZSTD_outBuffer {\n                dst: obuf.as_mut_ptr() as *mut c_void,\n                size: outcap,\n                pos: 0,\n            };\n            let ret = (api.decompressStream)(dctx, &mut outb, &mut inb);\n            tr.step3(\"dstream\", ret, inb.pos, outb.pos);\n            if is_error(ret) {\n                break;\n            }\n            plain.extend_from_slice(&obuf[..outb.pos]);\n            ipos += inb.pos;\n            if ipos >= frame.len() && inb.pos == 0 && outb.pos == 0 {\n                break;\n            }\n            guard += 1;\n            if guard > GUARD {\n                tr.ret(\"STALL\", 0);\n                break;\n            }\n        }\n    }\n\n    tr.ret(\"sizeofDCtx>0\", ((api.sizeofDCtx)(dctx) > 0) as usize);\n    if !ddict.is_null() {\n        (api.freeDDict)(ddict);\n    }\n    (api.freeDCtx)(dctx);\n    plain\n}\n\n/// Compress `src` with the C library under `params`, returning the frame.\nfn c_frame(src: &[u8], params: &[(i32, i32)], pledge: Option<u64>) -> Vec<u8> {\n    unsafe {\n        let a = capi();\n        let cctx = (a.createCCtx)();\n        for &(p, v) in params {\n            let r = (a.setParameter)(cctx, p, v);\n            assert!(!is_error(r), \"setParameter({p},{v}) -> {}\", err_code(r));\n        }\n        if let Some(p) = pledge {\n            let r = (a.setPledgedSrcSize)(cctx, p);\n            assert!(!is_error(r));\n        }\n        let cap = (a.compressBound)(src.len()) + 64;\n        let mut dst = vec![0u8; cap];\n        let n = (a.compress2)(\n            cctx,\n            dst.as_mut_ptr() as *mut c_void,\n            cap,\n            src.as_ptr() as *const c_void,\n            src.len(),\n        );\n        assert!(!is_error(n), \"compress2 -> {}\", err_code(n));\n        (a.freeCCtx)(cctx);\n        dst.truncate(n);\n        dst\n    }\n}\n\n#[test]\nfn streaming_decompressStream_all_buffer_sizes() {\n    let mut rng = Rng::new(SEED ^ 0x3333);\n    let dos = dstream_out_size();\n    let dis = dstream_in_size();\n    let outcaps = [1usize, 2, 3, 7, 100, 1024, dos];\n    let inchunks = [1usize, 2, 3, 7, 100, 1024, dis, usize::MAX];\n\n    // Frames of every interesting header/block shape.\n    struct FrameCase {\n        name: String,\n        frame: Vec<u8>,\n        plain: Vec<u8>,\n    }\n    let mut cases: Vec<FrameCase> = Vec::new();\n\n    for &n in &[0usize, 1, 100, 4096, 131072, 200000] {\n        for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n            let src = gen(shape, n, &mut rng);\n            for &(chk, cs) in &[(0i32, 1i32), (1, 1), (0, 0), (1, 0)] {\n                let f = c_frame(\n                    &src,\n                    &[\n                        (ZSTD_c_compressionLevel, 3),\n                        (ZSTD_c_checksumFlag, chk),\n                        (ZSTD_c_contentSizeFlag, cs),\n                    ],\n                    None,\n                );\n                cases.push(FrameCase {\n                    name: format!(\"n={n} {shape:?} chk={chk} cs={cs}\"),\n                    frame: f,\n                    plain: src.clone(),\n                });\n            }\n        }\n    }\n    // Multi-frame concatenations.\n    {\n        let a = gen(Shape::Text, 5000, &mut rng);\n        let b = gen(Shape::Random, 3000, &mut rng);\n        let c = gen(Shape::Rle, 70000, &mut rng);\n        let mut frame = Vec::new();\n        let mut plain = Vec::new();\n        for (s, chk) in [(&a, 1i32), (&b, 0), (&c, 1), (&a, 0)] {\n            frame.extend_from_slice(&c_frame(\n                s,\n                &[(ZSTD_c_compressionLevel, 3), (ZSTD_c_checksumFlag, chk)],\n                None,\n            ));\n            plain.extend_from_slice(s);\n        }\n        cases.push(FrameCase { name: \"4-frame concat\".to_string(), frame, plain });\n    }\n\n    for case in &cases {\n        // Full geometry sweep, but keep step counts sane for the big frames.\n        for &outcap in &outcaps {\n            for &inchunk in &inchunks {\n                if case.plain.len() > 20000 && (outcap < 8 || inchunk < 8) {\n                    continue;\n                }\n                let ctx =\n                    format!(\"dstream {} outcap={outcap} inchunk={inchunk}\", case.name);\n                let t = diff_trace(&ctx, |a| {\n                    let mut tr = Trace::new();\n                    unsafe {\n                        let p = stream_decompress(\n                            a,\n                            &case.frame,\n                            outcap,\n                            inchunk,\n                            DDict::None,\n                            None,\n                            &mut tr,\n                        );\n                        tr.out = p;\n                    }\n                    tr\n                });\n                assert_eq!(t.out, case.plain, \"{ctx}: C round trip mismatch\");\n            }\n        }\n    }\n\n    // Randomized geometries over randomized frames.\n    for it in 0..40 {\n        let shape = ALL_SHAPES[rng.below(ALL_SHAPES.len())];\n        let n = rng.range(0, 90000);\n        let src = gen(shape, n, &mut rng);\n        let frame = c_frame(\n            &src,\n            &[\n                (ZSTD_c_compressionLevel, *[1i32, 3, 9, 19][rng.below(4)]),\n                (ZSTD_c_checksumFlag, rng.below(2) as i32),\n                (ZSTD_c_contentSizeFlag, rng.below(2) as i32),\n            ],\n            None,\n        );\n        let outcap = outcaps[rng.below(outcaps.len())];\n        let inchunk = inchunks[rng.below(inchunks.len())];\n        let ctx = format!(\"dstream rand#{it} {shape:?} n={n} outcap={outcap} inchunk={inchunk}\");\n        let t = diff_trace(&ctx, |a| {\n            let mut tr = Trace::new();\n            unsafe {\n                tr.out =\n                    stream_decompress(a, &frame, outcap, inchunk, DDict::None, None, &mut tr);\n            }\n            tr\n        });\n        assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n    }\n\n    // ZSTD_decompressStream_simpleArgs\n    type FnDSimple = unsafe extern \"C\" fn(\n        *mut ZSTD_DCtx,\n        *mut c_void,\n        usize,\n        *mut usize,\n        *const c_void,\n        usize,\n        *mut usize,\n    ) -> usize;\n    for case in cases.iter().take(12) {\n        let ctx = format!(\"dstream_simpleArgs {}\", case.name);\n        let t = diff_trace(&ctx, |a| {\n            let mut tr = Trace::new();\n            unsafe {\n                let f = sym::<FnDSimple>(a.lib, \"ZSTD_decompressStream_simpleArgs\");\n                let dctx = (a.createDCtx)();\n                let mut dst = vec![0u8; case.plain.len() + 128];\n                let mut dpos = 0usize;\n                let mut spos = 0usize;\n                let mut guard = 0usize;\n                loop {\n                    let before = (dpos, spos);\n                    let ret = f(\n                        dctx,\n                        dst.as_mut_ptr() as *mut c_void,\n                        dst.len(),\n                        &mut dpos,\n                        case.frame.as_ptr() as *const c_void,\n                        case.frame.len(),\n                        &mut spos,\n                    );\n                    tr.step3(\"dSimple\", ret, spos, dpos);\n                    if is_error(ret) {\n                        break;\n                    }\n                    if (dpos, spos) == before {\n                        break;\n                    }\n                    guard += 1;\n                    if guard > GUARD {\n                        tr.ret(\"STALL\", 0);\n                        break;\n                    }\n                }\n                tr.out = dst[..dpos].to_vec();\n                (a.freeDCtx)(dctx);\n            }\n            tr\n        });\n        assert_eq!(t.out, case.plain, \"{ctx}: C round trip mismatch\");\n    }\n\n    // initDStream_usingDict / _usingDDict / resetDStream on plain frames.\n    type FnInitDDict = unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const c_void, usize) -> usize;\n    type FnInitDDDict = unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const ZSTD_DDict) -> usize;\n    type FnResetDStream = unsafe extern \"C\" fn(*mut ZSTD_DCtx) -> usize;\n    let case = &cases[8];\n    let ctx = \"initDStream variants\";\n    let t = diff_trace(ctx, |a| {\n        let mut tr = Trace::new();\n        unsafe {\n            let dctx = (a.createDCtx)();\n            tr.ret(\n                \"initDStream_usingDict(NULL)\",\n                sym::<FnInitDDict>(a.lib, \"ZSTD_initDStream_usingDict\")(\n                    dctx,\n                    std::ptr::null(),\n                    0,\n                ),\n            );\n            tr.ret(\n                \"initDStream_usingDDict(NULL)\",\n                sym::<FnInitDDDict>(a.lib, \"ZSTD_initDStream_usingDDict\")(\n                    dctx,\n                    std::ptr::null(),\n                ),\n            );\n            tr.ret(\"resetDStream\", sym::<FnResetDStream>(a.lib, \"ZSTD_resetDStream\")(dctx));\n            let mut obuf = vec![0u8; 333];\n            let mut plain = Vec::new();\n            let mut ipos = 0usize;\n            loop {\n                let take = 77.min(case.frame.len() - ipos);\n                let mut inb = ZSTD_inBuffer {\n                    src: case.frame.as_ptr().add(ipos) as *const c_void,\n                    size: take,\n                    pos: 0,\n                };\n                let mut outb = ZSTD_outBuffer {\n                    dst: obuf.as_mut_ptr() as *mut c_void,\n                    size: obuf.len(),\n                    pos: 0,\n                };\n                let ret = (a.decompressStream)(dctx, &mut outb, &mut inb);\n                tr.step3(\"dstream\", ret, inb.pos, outb.pos);\n                if is_error(ret) {\n                    break;\n                }\n                plain.extend_from_slice(&obuf[..outb.pos]);\n                ipos += inb.pos;\n                if ipos >= case.frame.len() && inb.pos == 0 && outb.pos == 0 {\n                    break;\n                }\n            }\n            tr.out = plain;\n            (a.freeDCtx)(dctx);\n        }\n        tr\n    });\n    assert_eq!(t.out, case.plain, \"{ctx}: C round trip mismatch\");\n}\n\n// ============================================================================\n// 4. streaming with dictionaries\n// ============================================================================\n\n#[derive(Clone, Copy, Debug)]\nenum CDictMode {\n    Load,\n    Prefix,\n    RefCDict(i32),\n}\n\n#[test]\nfn streaming_with_dictionary() {\n    let mut rng = Rng::new(SEED ^ 0x4444);\n    let cos = cstream_out_size();\n\n    let mut dicts: Vec<(String, Vec<u8>)> = Vec::new();\n    dicts.push((\"raw32k\".to_string(), gen(Shape::Text, 32 * 1024, &mut rng)));\n    dicts.push((\"raw1k\".to_string(), gen(Shape::Records, 1024, &mut rng)));\n    dicts.push((\"raw7\".to_string(), gen(Shape::Text, 7, &mut rng)));\n    // A real trained zstd dictionary (has ZSTD_MAGIC_DICTIONARY + dictID).\n    {\n        type FnTrain = unsafe extern \"C\" fn(\n            *mut c_void,\n            usize,\n            *const c_void,\n            *const usize,\n            u32,\n        ) -> usize;\n        let (train, _) = pair::<FnTrain>(\"ZDICT_trainFromBuffer\");\n        let (samples, sizes) = gen_samples(Shape::Text, 400, 256, 2048, &mut rng);\n        let mut d = vec![0u8; 24 * 1024];\n        let n = unsafe {\n            train(\n                d.as_mut_ptr() as *mut c_void,\n                d.len(),\n                samples.as_ptr() as *const c_void,\n                sizes.as_ptr(),\n                sizes.len() as u32,\n            )\n        };\n        if !is_error(n) {\n            d.truncate(n);\n            dicts.push((\"trained\".to_string(), d));\n        }\n    }\n\n    for (dname, dict) in &dicts {\n        for &n in &[0usize, 1, 100, 4096, 60000] {\n            let src = gen(Shape::Text, n, &mut rng);\n            for mode in [CDictMode::Load, CDictMode::Prefix, CDictMode::RefCDict(3), CDictMode::RefCDict(19)]\n            {\n                for &(inchunk, outcap) in\n                    &[(1usize, 7usize), (100, 100), (4096, 1024), (usize::MAX, cos)]\n                {\n                    if n > 10000 && inchunk < 8 {\n                        continue;\n                    }\n                    let ctx = format!(\n                        \"dictstream dict={dname} n={n} mode={mode:?} inchunk={inchunk} outcap={outcap}\"\n                    );\n                    let t = diff_trace(&ctx, |a| {\n                        let mut tr = Trace::new();\n                        unsafe {\n                            // --- compress\n                            let cctx = (a.createCCtx)();\n                            let mut cdict: *mut ZSTD_CDict = std::ptr::null_mut();\n                            tr.ret(\n                                \"setLevel\",\n                                (a.setParameter)(cctx, ZSTD_c_compressionLevel, 5),\n                            );\n                            tr.ret(\"setChk\", (a.setParameter)(cctx, ZSTD_c_checksumFlag, 1));\n                            match mode {\n                                CDictMode::Load => tr.ret(\n                                    \"loadDictionary\",\n                                    (a.loadDictionary)(\n                                        cctx,\n                                        dict.as_ptr() as *const c_void,\n                                        dict.len(),\n                                    ),\n                                ),\n                                CDictMode::Prefix => tr.ret(\n                                    \"refPrefix\",\n                                    (a.refPrefix)(\n                                        cctx,\n                                        dict.as_ptr() as *const c_void,\n                                        dict.len(),\n                                    ),\n                                ),\n                                CDictMode::RefCDict(lvl) => {\n                                    cdict = (a.createCDict)(\n                                        dict.as_ptr() as *const c_void,\n                                        dict.len(),\n                                        lvl,\n                                    );\n                                    assert!(!cdict.is_null());\n                                    tr.ret(\"refCDict\", (a.refCDict)(cctx, cdict));\n                                }\n                            }\n                            let cfg = SCfg {\n                                level: 5,\n                                checksum: 1,\n                                content_size: 1,\n                                pledge: false,\n                                outcap,\n                                inchunk,\n                                flush_every: 2,\n                            };\n                            // Re-apply level/checksum via cs2_inner (idempotent) and stream.\n                            let cdata = cs2_inner(a, cctx, &cfg, &src, &mut tr);\n                            if !cdict.is_null() {\n                                (a.freeCDict)(cdict);\n                            }\n                            (a.freeCCtx)(cctx);\n\n                            // --- decompress, streaming, with the matching dict mode\n                            let dmode = match mode {\n                                CDictMode::Load => DDict::Load(dict),\n                                CDictMode::Prefix => DDict::Prefix(dict),\n                                CDictMode::RefCDict(_) => DDict::Ref(dict),\n                            };\n                            tr.out = stream_decompress(\n                                a,\n                                &cdata,\n                                if outcap < 8 { 7 } else { 1024 },\n                                if inchunk == usize::MAX { usize::MAX } else { inchunk },\n                                dmode,\n                                None,\n                                &mut tr,\n                            );\n                            tr.cdata = cdata;\n                        }\n                        tr\n                    });\n                    assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n                }\n            }\n        }\n    }\n}\n\n// ============================================================================\n// 5. stableInBuffer / stableOutBuffer / d_stableOutBuffer\n// ============================================================================\n\n#[test]\nfn streaming_stable_buffers() {\n    let mut rng = Rng::new(SEED ^ 0x5555);\n\n    // ---------------- (a) ZSTD_c_stableInBuffer, growing `size` ----------------\n    for &n in &[0usize, 1, 100, 4096, 131071, 131072, 131073, 300000] {\n        for &shape in &[Shape::Text, Shape::Random] {\n            let src = gen(shape, n, &mut rng);\n            for &reveals in &[1usize, 3, 7] {\n                let ctx = format!(\"stableIn n={n} {shape:?} reveals={reveals}\");\n                let t = diff_trace(&ctx, |a| {\n                    let mut tr = Trace::new();\n                    unsafe {\n                        let cctx = (a.createCCtx)();\n                        tr.ret(\"setLevel\", (a.setParameter)(cctx, ZSTD_c_compressionLevel, 5));\n                        tr.ret(\n                            \"setStableIn\",\n                            (a.setParameter)(cctx, ZSTD_c_stableInBuffer, 1),\n                        );\n                        tr.ret(\"setChk\", (a.setParameter)(cctx, ZSTD_c_checksumFlag, 1));\n                        let mut obuf = vec![0u8; 1024];\n                        let mut cdata: Vec<u8> = Vec::new();\n                        // ONE inBuffer for the whole session; only `size` grows.\n                        let mut inb = ZSTD_inBuffer {\n                            src: src.as_ptr() as *const c_void,\n                            size: 0,\n                            pos: 0,\n                        };\n                        for step in 1..=reveals {\n                            inb.size = src.len() * step / reveals;\n                            let last = step == reveals;\n                            let endop = if last { ZSTD_e_end } else { ZSTD_e_continue };\n                            let mut guard = 0usize;\n                            loop {\n                                let mut outb = ZSTD_outBuffer {\n                                    dst: obuf.as_mut_ptr() as *mut c_void,\n                                    size: obuf.len(),\n                                    pos: 0,\n                                };\n                                let ret =\n                                    (a.compressStream2)(cctx, &mut outb, &mut inb, endop);\n                                tr.step3(\"stableIn/cs2\", ret, inb.pos, outb.pos);\n                                if is_error(ret) {\n                                    break;\n                                }\n                                cdata.extend_from_slice(&obuf[..outb.pos]);\n                                if last {\n                                    if ret == 0 {\n                                        break;\n                                    }\n                                } else if inb.pos == inb.size {\n                                    break;\n                                }\n                                guard += 1;\n                                if guard > GUARD {\n                                    tr.ret(\"STALL\", 0);\n                                    break;\n                                }\n                            }\n                        }\n                        (a.freeCCtx)(cctx);\n                        decode_oneshot(a, &cdata, &[], src.len(), &mut tr);\n                        tr.cdata = cdata;\n                    }\n                    tr\n                });\n                if n > 0 {\n                    assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n                }\n            }\n        }\n    }\n\n    // -------- (b) stableInBuffer VIOLATIONS: moved src / caller-modified pos ----\n    let src = gen(Shape::Text, 200_000, &mut rng);\n    let copy = src.clone();\n    for &(what, small) in &[(\"moved-src\", false), (\"moved-src-small\", true), (\"bumped-pos\", false)]\n    {\n        let ctx = format!(\"stableIn violation {what}\");\n        diff_trace(&ctx, |a| {\n            let mut tr = Trace::new();\n            unsafe {\n                let cctx = (a.createCCtx)();\n                tr.ret(\"setLevel\", (a.setParameter)(cctx, ZSTD_c_compressionLevel, 3));\n                tr.ret(\"setStableIn\", (a.setParameter)(cctx, ZSTD_c_stableInBuffer, 1));\n                let mut obuf = vec![0u8; 4096];\n                let first = if small { 1000usize } else { 150_000usize };\n                let mut inb = ZSTD_inBuffer {\n                    src: src.as_ptr() as *const c_void,\n                    size: first,\n                    pos: 0,\n                };\n                let mut outb = ZSTD_outBuffer {\n                    dst: obuf.as_mut_ptr() as *mut c_void,\n                    size: obuf.len(),\n                    pos: 0,\n                };\n                let r1 = (a.compressStream2)(cctx, &mut outb, &mut inb, ZSTD_e_continue);\n                tr.step3(\"call1\", r1, inb.pos, outb.pos);\n\n                // Now break the contract.\n                if what == \"bumped-pos\" {\n                    inb.pos = inb.pos.saturating_sub(1);\n                } else {\n                    inb.src = copy.as_ptr() as *const c_void;\n                }\n                inb.size = src.len();\n                let mut outb2 = ZSTD_outBuffer {\n                    dst: obuf.as_mut_ptr() as *mut c_void,\n                    size: obuf.len(),\n                    pos: 0,\n                };\n                let r2 = (a.compressStream2)(cctx, &mut outb2, &mut inb, ZSTD_e_end);\n                tr.step3(\"call2\", r2, inb.pos, outb2.pos);\n                (a.freeCCtx)(cctx);\n            }\n            tr\n        });\n    }\n\n    // ---------------- (c) ZSTD_c_stableOutBuffer ----------------\n    for &n in &[0usize, 1, 100, 4096, 131072, 300000] {\n        for &shape in &[Shape::Text, Shape::Random] {\n            let s = gen(shape, n, &mut rng);\n            // Row 51: capacity exactly compressBound(n), and one byte less.\n            for &shave in &[0usize, 1] {\n                for &inchunk in &[1usize, 4096, usize::MAX] {\n                    if n > 10000 && inchunk < 8 {\n                        continue;\n                    }\n                    let ctx = format!(\"stableOut n={n} {shape:?} shave={shave} inchunk={inchunk}\");\n                    let t = diff_trace(&ctx, |a| {\n                        let mut tr = Trace::new();\n                        unsafe {\n                            let cctx = (a.createCCtx)();\n                            tr.ret(\n                                \"setLevel\",\n                                (a.setParameter)(cctx, ZSTD_c_compressionLevel, 3),\n                            );\n                            tr.ret(\n                                \"setStableOut\",\n                                (a.setParameter)(cctx, ZSTD_c_stableOutBuffer, 1),\n                            );\n                            let bound = (a.compressBound)(n);\n                            let cap = bound.saturating_sub(shave).max(1);\n                            let mut obuf = vec![0u8; cap];\n                            // ONE outBuffer, never resized; pos only touched by zstd.\n                            let mut outb = ZSTD_outBuffer {\n                                dst: obuf.as_mut_ptr() as *mut c_void,\n                                size: cap,\n                                pos: 0,\n                            };\n                            let step =\n                                if inchunk == usize::MAX { s.len().max(1) } else { inchunk };\n                            let mut ipos = 0usize;\n                            let mut failed = false;\n                            while ipos < s.len() {\n                                let end = (ipos + step).min(s.len());\n                                let mut inb = ZSTD_inBuffer {\n                                    src: s.as_ptr().add(ipos) as *const c_void,\n                                    size: end - ipos,\n                                    pos: 0,\n                                };\n                                let mut guard = 0usize;\n                                loop {\n                                    let ret = (a.compressStream2)(\n                                        cctx,\n                                        &mut outb,\n                                        &mut inb,\n                                        ZSTD_e_continue,\n                                    );\n                                    tr.step3(\"stableOut/cont\", ret, inb.pos, outb.pos);\n                                    if is_error(ret) {\n                                        failed = true;\n                                        break;\n                                    }\n                                    if inb.pos == inb.size {\n                                        break;\n                                    }\n                                    guard += 1;\n                                    if guard > GUARD {\n                                        tr.ret(\"STALL\", 0);\n                                        failed = true;\n                                        break;\n                                    }\n                                }\n                                if failed {\n                                    break;\n                                }\n                                ipos = end;\n                            }\n                            if !failed {\n                                let mut guard = 0usize;\n                                loop {\n                                    let mut inb = ZSTD_inBuffer {\n                                        src: s.as_ptr() as *const c_void,\n                                        size: 0,\n                                        pos: 0,\n                                    };\n                                    let ret = (a.compressStream2)(\n                                        cctx,\n                                        &mut outb,\n                                        &mut inb,\n                                        ZSTD_e_end,\n                                    );\n                                    tr.step3(\"stableOut/end\", ret, inb.pos, outb.pos);\n                                    if is_error(ret) || ret == 0 {\n                                        break;\n                                    }\n                                    guard += 1;\n                                    if guard > GUARD {\n                                        tr.ret(\"STALL\", 0);\n                                        break;\n                                    }\n                                }\n                            }\n                            let cdata = obuf[..outb.pos].to_vec();\n                            (a.freeCCtx)(cctx);\n                            decode_oneshot(a, &cdata, &[], s.len(), &mut tr);\n                            tr.cdata = cdata;\n                        }\n                        tr\n                    });\n                    // When the buffer was big enough the round trip must be exact.\n                    if shave == 0 && n > 0 && !t.cdata.is_empty() {\n                        assert_eq!(t.out, s, \"{ctx}: C round trip mismatch\");\n                    }\n                }\n            }\n        }\n    }\n\n    // -------- (d) stableOutBuffer VIOLATION: (size - pos) grows between calls ---\n    let s = gen(Shape::Text, 200_000, &mut rng);\n    for &grow in &[true, false] {\n        let ctx = format!(\"stableOut violation grow={grow}\");\n        diff_trace(&ctx, |a| {\n            let mut tr = Trace::new();\n            unsafe {\n                let cctx = (a.createCCtx)();\n                tr.ret(\"setLevel\", (a.setParameter)(cctx, ZSTD_c_compressionLevel, 3));\n                tr.ret(\"setStableOut\", (a.setParameter)(cctx, ZSTD_c_stableOutBuffer, 1));\n                let bound = (a.compressBound)(s.len());\n                let mut obuf = vec![0u8; bound];\n                let mut inb = ZSTD_inBuffer {\n                    src: s.as_ptr() as *const c_void,\n                    size: 100_000,\n                    pos: 0,\n                };\n                let mut outb = ZSTD_outBuffer {\n                    dst: obuf.as_mut_ptr() as *mut c_void,\n                    size: bound / 2,\n                    pos: 0,\n                };\n                let r1 = (a.compressStream2)(cctx, &mut outb, &mut inb, ZSTD_e_continue);\n                tr.step3(\"call1\", r1, inb.pos, outb.pos);\n                // Change (size - pos): grow it (illegal) or shrink it (also checked).\n                if grow {\n                    outb.size = bound;\n                } else {\n                    outb.size = outb.pos + 10;\n                }\n                let mut inb2 = ZSTD_inBuffer {\n                    src: s.as_ptr().add(100_000) as *const c_void,\n                    size: s.len() - 100_000,\n                    pos: 0,\n                };\n                let r2 = (a.compressStream2)(cctx, &mut outb, &mut inb2, ZSTD_e_end);\n                tr.step3(\"call2\", r2, inb2.pos, outb.pos);\n                (a.freeCCtx)(cctx);\n            }\n            tr\n        });\n    }\n\n    // ---------------- (e) ZSTD_d_stableOutBuffer ----------------\n    for &n in &[0usize, 1, 100, 4096, 131072, 300000] {\n        for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n            let s = gen(shape, n, &mut rng);\n            for &cs in &[0i32, 1] {\n                let frame = c_frame(\n                    &s,\n                    &[\n                        (ZSTD_c_compressionLevel, 3),\n                        (ZSTD_c_contentSizeFlag, cs),\n                        (ZSTD_c_checksumFlag, 1),\n                    ],\n                    None,\n                );\n                for &inchunk in &[1usize, 7, 1024, usize::MAX] {\n                    if n > 10000 && inchunk < 8 {\n                        continue;\n                    }\n                    // Exactly-sized buffer, and one byte short (must error when\n                    // the content size is known).\n                    for &extra in &[0usize, 1] {\n                        let total = n + extra;\n                        let ctx = format!(\n                            \"d_stableOut n={n} {shape:?} cs={cs} inchunk={inchunk} total={total}\"\n                        );\n                        let t = diff_trace(&ctx, |a| {\n                            let mut tr = Trace::new();\n                            unsafe {\n                                tr.out = stream_decompress(\n                                    a,\n                                    &frame,\n                                    0,\n                                    inchunk,\n                                    DDict::None,\n                                    Some(total),\n                                    &mut tr,\n                                );\n                            }\n                            tr\n                        });\n                        assert_eq!(t.out, s, \"{ctx}: C round trip mismatch\");\n                    }\n                    // Too-small buffer: must fail identically.\n                    if n > 16 {\n                        let ctx = format!(\"d_stableOut TOO SMALL n={n} {shape:?} cs={cs}\");\n                        diff_trace(&ctx, |a| {\n                            let mut tr = Trace::new();\n                            unsafe {\n                                stream_decompress(\n                                    a,\n                                    &frame,\n                                    0,\n                                    inchunk,\n                                    DDict::None,\n                                    Some(n / 2),\n                                    &mut tr,\n                                );\n                            }\n                            tr\n                        });\n                    }\n                }\n            }\n        }\n    }\n\n    // -------- (f) d_stableOutBuffer VIOLATION: the buffer moves mid-frame ------\n    let s = gen(Shape::Text, 200_000, &mut rng);\n    let frame = c_frame(&s, &[(ZSTD_c_compressionLevel, 3)], None);\n    for &what in &[\"moved\", \"resized\", \"pos-bumped\"] {\n        let ctx = format!(\"d_stableOut violation {what}\");\n        diff_trace(&ctx, |a| {\n            let mut tr = Trace::new();\n            unsafe {\n                let dctx = (a.createDCtx)();\n                tr.ret(\n                    \"setStable\",\n                    (a.dSetParameter)(dctx, ZSTD_d_stableOutBuffer, 1),\n                );\n                let mut buf1 = vec![0u8; s.len() + 16];\n                let mut buf2 = vec![0u8; s.len() + 16];\n                let mut outb = ZSTD_outBuffer {\n                    dst: buf1.as_mut_ptr() as *mut c_void,\n                    size: buf1.len(),\n                    pos: 0,\n                };\n                let mut inb = ZSTD_inBuffer {\n                    src: frame.as_ptr() as *const c_void,\n                    size: frame.len() / 3,\n                    pos: 0,\n                };\n                let r1 = (a.decompressStream)(dctx, &mut outb, &mut inb);\n                tr.step3(\"call1\", r1, inb.pos, outb.pos);\n                match what {\n                    \"moved\" => outb.dst = buf2.as_mut_ptr() as *mut c_void,\n                    \"resized\" => outb.size -= 1,\n                    _ => outb.pos = outb.pos.saturating_sub(1),\n                }\n                let mut inb2 = ZSTD_inBuffer {\n                    src: frame.as_ptr().add(inb.pos) as *const c_void,\n                    size: frame.len() - inb.pos,\n                    pos: 0,\n                };\n                let r2 = (a.decompressStream)(dctx, &mut outb, &mut inb2);\n                tr.step3(\"call2\", r2, inb2.pos, outb.pos);\n                (a.freeDCtx)(dctx);\n            }\n            tr\n        });\n    }\n}\n\n// ============================================================================\n// 6. buffer-less tier: compressBegin* / compressContinue / compressEnd\n//    and decompressBegin* / nextSrcSizeToDecompress / decompressContinue\n// ============================================================================\n\ntype FnCompressBeginUsingDict =\n    unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const c_void, usize, i32) -> usize;\ntype FnCompressBeginAdvanced = unsafe extern \"C\" fn(\n    *mut ZSTD_CCtx,\n    *const c_void,\n    usize,\n    ZSTD_parameters,\n    u64,\n) -> usize;\ntype FnCompressBeginUsingCDict = unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const ZSTD_CDict) -> usize;\ntype FnCompressBeginUsingCDictAdv = unsafe extern \"C\" fn(\n    *mut ZSTD_CCtx,\n    *const ZSTD_CDict,\n    ZSTD_frameParameters,\n    u64,\n) -> usize;\ntype FnCopyCCtx = unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const ZSTD_CCtx, u64) -> usize;\ntype FnDecompressBeginUsingDict =\n    unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const c_void, usize) -> usize;\ntype FnDecompressBeginUsingDDict =\n    unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const ZSTD_DDict) -> usize;\ntype FnCopyDCtx = unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const ZSTD_DCtx);\n\n#[derive(Clone, Copy, Debug)]\nenum BBegin<'a> {\n    Level(i32),\n    UsingDict(&'a [u8], i32),\n    Advanced(&'a [u8], ZSTD_parameters, u64),\n    UsingCDict(&'a [u8], i32),\n    UsingCDictAdv(&'a [u8], i32, ZSTD_frameParameters, u64),\n    /// prepare with compressBegin_usingDict, then ZSTD_copyCCtx into a fresh CCtx\n    CopyOf(&'a [u8], i32, u64),\n}\n\n#[derive(Clone, Copy, Debug)]\nenum DBegin<'a> {\n    Plain,\n    UsingDict(&'a [u8]),\n    UsingDDict(&'a [u8]),\n    /// prepare with decompressBegin_usingDict, then ZSTD_copyDCtx into a fresh DCtx\n    CopyOf(&'a [u8]),\n}\n\n/// Buffer-less compression of `src` in `chunk`-sized pieces.\nunsafe fn bufferless_compress(\n    api: &Api,\n    begin: &BBegin,\n    src: &[u8],\n    chunk: usize,\n    tr: &mut Trace,\n) -> Vec<u8> {\n    let cctx = (api.createCCtx)();\n    let mut prepared: *mut ZSTD_CCtx = std::ptr::null_mut();\n    let mut cdict: *mut ZSTD_CDict = std::ptr::null_mut();\n    let mut cdata: Vec<u8> = Vec::new();\n\n    let br = match *begin {\n        BBegin::Level(l) => (api.compressBegin)(cctx, l),\n        BBegin::UsingDict(d, l) => sym::<FnCompressBeginUsingDict>(\n            api.lib,\n            \"ZSTD_compressBegin_usingDict\",\n        )(cctx, d.as_ptr() as *const c_void, d.len(), l),\n        BBegin::Advanced(d, p, pss) => sym::<FnCompressBeginAdvanced>(\n            api.lib,\n            \"ZSTD_compressBegin_advanced\",\n        )(cctx, d.as_ptr() as *const c_void, d.len(), p, pss),\n        BBegin::UsingCDict(d, l) => {\n            cdict = (api.createCDict)(d.as_ptr() as *const c_void, d.len(), l);\n            assert!(!cdict.is_null());\n            sym::<FnCompressBeginUsingCDict>(api.lib, \"ZSTD_compressBegin_usingCDict\")(\n                cctx, cdict,\n            )\n        }\n        BBegin::UsingCDictAdv(d, l, fp, pss) => {\n            cdict = (api.createCDict)(d.as_ptr() as *const c_void, d.len(), l);\n            assert!(!cdict.is_null());\n            sym::<FnCompressBeginUsingCDictAdv>(\n                api.lib,\n                \"ZSTD_compressBegin_usingCDict_advanced\",\n            )(cctx, cdict, fp, pss)\n        }\n        BBegin::CopyOf(d, l, pss) => {\n            prepared = (api.createCCtx)();\n            let r0 = sym::<FnCompressBeginUsingDict>(\n                api.lib,\n                \"ZSTD_compressBegin_usingDict\",\n            )(prepared, d.as_ptr() as *const c_void, d.len(), l);\n            tr.ret(\"prepare\", r0);\n            sym::<FnCopyCCtx>(api.lib, \"ZSTD_copyCCtx\")(cctx, prepared, pss)\n        }\n    };\n    tr.ret(\"compressBegin\", br);\n    tr.u64v(\"getBlockSize\", (api.getBlockSize)(cctx) as u64);\n\n    if !is_error(br) {\n        let cap = (api.compressBound)(src.len()) + 1024;\n        let mut dst = vec![0u8; cap];\n        let mut opos = 0usize;\n        let chunk = if chunk == usize::MAX { src.len().max(1) } else { chunk.max(1) };\n        let mut ipos = 0usize;\n        let mut ok = true;\n        while ipos < src.len() {\n            let end = (ipos + chunk).min(src.len());\n            let r = (api.compressContinue)(\n                cctx,\n                dst.as_mut_ptr().add(opos) as *mut c_void,\n                cap - opos,\n                src.as_ptr().add(ipos) as *const c_void,\n                end - ipos,\n            );\n            tr.step3(\"compressContinue\", r, end - ipos, 0);\n            if is_error(r) {\n                ok = false;\n                break;\n            }\n            opos += r;\n            ipos = end;\n        }\n        if ok {\n            let r = (api.compressEnd)(\n                cctx,\n                dst.as_mut_ptr().add(opos) as *mut c_void,\n                cap - opos,\n                std::ptr::null(),\n                0,\n            );\n            tr.ret(\"compressEnd\", r);\n            if !is_error(r) {\n                opos += r;\n                cdata = dst[..opos].to_vec();\n            }\n        }\n    }\n\n    if !cdict.is_null() {\n        (api.freeCDict)(cdict);\n    }\n    if !prepared.is_null() {\n        (api.freeCCtx)(prepared);\n    }\n    (api.freeCCtx)(cctx);\n    cdata\n}\n\n/// Buffer-less decode driven by nextSrcSizeToDecompress / nextInputType.\nunsafe fn bufferless_decompress(\n    api: &Api,\n    begin: &DBegin,\n    frame: &[u8],\n    expect: usize,\n    tr: &mut Trace,\n) -> Vec<u8> {\n    let dctx = (api.createDCtx)();\n    let mut prepared: *mut ZSTD_DCtx = std::ptr::null_mut();\n    let mut ddict: *mut ZSTD_DDict = std::ptr::null_mut();\n\n    let br = match *begin {\n        DBegin::Plain => (api.decompressBegin)(dctx),\n        DBegin::UsingDict(d) => sym::<FnDecompressBeginUsingDict>(\n            api.lib,\n            \"ZSTD_decompressBegin_usingDict\",\n        )(dctx, d.as_ptr() as *const c_void, d.len()),\n        DBegin::UsingDDict(d) => {\n            ddict = (api.createDDict)(d.as_ptr() as *const c_void, d.len());\n            assert!(!ddict.is_null());\n            sym::<FnDecompressBeginUsingDDict>(api.lib, \"ZSTD_decompressBegin_usingDDict\")(\n                dctx, ddict,\n            )\n        }\n        DBegin::CopyOf(d) => {\n            prepared = (api.createDCtx)();\n            let r0 = sym::<FnDecompressBeginUsingDict>(\n                api.lib,\n                \"ZSTD_decompressBegin_usingDict\",\n            )(prepared, d.as_ptr() as *const c_void, d.len());\n            tr.ret(\"prepare\", r0);\n            sym::<FnCopyDCtx>(api.lib, \"ZSTD_copyDCtx\")(dctx, prepared);\n            0\n        }\n    };\n    tr.ret(\"decompressBegin\", br);\n\n    // One contiguous destination so decompressContinue keeps its history.\n    let mut dst = vec![0u8; expect + ZSTD_BLOCKSIZE_MAX * 2 + 1024];\n    let mut opos = 0usize;\n    let mut ipos = 0usize;\n    let mut guard = 0usize;\n    if !is_error(br) {\n        loop {\n            let need = (api.nextSrcSizeToDecompress)(dctx);\n            let nit = (api.nextInputType)(dctx);\n            tr.step3(\"nextSrcSize/type\", need, nit as usize, 0);\n            if need == 0 || is_error(need) {\n                break;\n            }\n            if ipos + need > frame.len() {\n                tr.ret(\"TRUNCATED\", ipos + need - frame.len());\n                break;\n            }\n            let r = (api.decompressContinue)(\n                dctx,\n                dst.as_mut_ptr().add(opos) as *mut c_void,\n                dst.len() - opos,\n                frame.as_ptr().add(ipos) as *const c_void,\n                need,\n            );\n            tr.step3(\"decompressContinue\", r, need, 0);\n            if is_error(r) {\n                break;\n            }\n            opos += r;\n            ipos += need;\n            guard += 1;\n            if guard > GUARD {\n                tr.ret(\"STALL\", 0);\n                break;\n            }\n        }\n    }\n    if !ddict.is_null() {\n        (api.freeDDict)(ddict);\n    }\n    if !prepared.is_null() {\n        (api.freeDCtx)(prepared);\n    }\n    (api.freeDCtx)(dctx);\n    dst[..opos].to_vec()\n}\n\n#[test]\nfn blocklevel_compressBegin_continue_end() {\n    let mut rng = Rng::new(SEED ^ 0x6666);\n    let dict = gen(Shape::Text, 32 * 1024, &mut rng);\n\n    // -- (a) levels x chunk sizes around getBlockSize()/ZSTD_BLOCKSIZE_MAX (row 67)\n    let bmax = ZSTD_BLOCKSIZE_MAX;\n    for &level in &[1i32, 3, 19] {\n        for &n in &[0usize, 1, 7, 100, 131071, 131072, 131073, 300000] {\n            for &chunk in\n                &[1usize, 100, bmax - 1, bmax, bmax + 1, 65536, usize::MAX]\n            {\n                if chunk < 8 && n > 5000 {\n                    continue;\n                }\n                if level == 19 && n > 140000 && chunk < 1000 {\n                    continue;\n                }\n                let shape = if n % 2 == 0 { Shape::Text } else { Shape::Records };\n                let src = gen(shape, n, &mut rng);\n                let ctx = format!(\"bufferless L{level} n={n} chunk={chunk}\");\n                let begin = BBegin::Level(level);\n                let t = diff_trace(&ctx, |a| {\n                    let mut tr = Trace::new();\n                    unsafe {\n                        let cdata = bufferless_compress(a, &begin, &src, chunk, &mut tr);\n                        tr.out =\n                            bufferless_decompress(a, &DBegin::Plain, &cdata, n, &mut tr);\n                        tr.cdata = cdata;\n                    }\n                    tr\n                });\n                assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n            }\n        }\n    }\n\n    // -- (b) every compressBegin_* / decompressBegin_* variant (rows 68, 69, 84)\n    let src = gen(Shape::Text, 200_000, &mut rng);\n    let params = unsafe { (capi().getParams)(9, src.len() as u64, dict.len()) };\n    let mut params_chk = params;\n    params_chk.fParams.checksumFlag = 1;\n    params_chk.fParams.contentSizeFlag = 0;\n    let fp = ZSTD_frameParameters { contentSizeFlag: 1, checksumFlag: 1, noDictIDFlag: 0 };\n\n    let combos: Vec<(&str, BBegin, DBegin)> = vec![\n        (\"plain\", BBegin::Level(5), DBegin::Plain),\n        (\"usingDict/dict\", BBegin::UsingDict(&dict, 5), DBegin::UsingDict(&dict)),\n        (\"usingDict/ddict\", BBegin::UsingDict(&dict, 5), DBegin::UsingDDict(&dict)),\n        (\"usingDict/copyDctx\", BBegin::UsingDict(&dict, 5), DBegin::CopyOf(&dict)),\n        (\n            \"advanced(known)\",\n            BBegin::Advanced(&dict, params, src.len() as u64),\n            DBegin::UsingDict(&dict),\n        ),\n        (\n            \"advanced(UNKNOWN,chk)\",\n            BBegin::Advanced(&dict, params_chk, ZSTD_CONTENTSIZE_UNKNOWN),\n            DBegin::UsingDict(&dict),\n        ),\n        (\n            \"advanced(nodict)\",\n            BBegin::Advanced(&[], params, src.len() as u64),\n            DBegin::Plain,\n        ),\n        (\"usingCDict(L3)\", BBegin::UsingCDict(&dict, 3), DBegin::UsingDDict(&dict)),\n        (\"usingCDict(L19)\", BBegin::UsingCDict(&dict, 19), DBegin::UsingDDict(&dict)),\n        (\n            \"usingCDictAdv(known)\",\n            BBegin::UsingCDictAdv(&dict, 6, fp, src.len() as u64),\n            DBegin::UsingDDict(&dict),\n        ),\n        (\n            \"usingCDictAdv(UNKNOWN)\",\n            BBegin::UsingCDictAdv(&dict, 6, fp, ZSTD_CONTENTSIZE_UNKNOWN),\n            DBegin::UsingDDict(&dict),\n        ),\n        (\n            \"copyCCtx(known)\",\n            BBegin::CopyOf(&dict, 7, src.len() as u64),\n            DBegin::UsingDict(&dict),\n        ),\n        (\n            \"copyCCtx(UNKNOWN)\",\n            BBegin::CopyOf(&dict, 7, ZSTD_CONTENTSIZE_UNKNOWN),\n            DBegin::UsingDict(&dict),\n        ),\n    ];\n\n    for (name, begin, dbegin) in combos {\n        for &chunk in &[1000usize, 131072, usize::MAX] {\n            let ctx = format!(\"bufferless variant {name} chunk={chunk}\");\n            let t = diff_trace(&ctx, |a| {\n                let mut tr = Trace::new();\n                unsafe {\n                    let cdata = bufferless_compress(a, &begin, &src, chunk, &mut tr);\n                    tr.out = bufferless_decompress(a, &dbegin, &cdata, src.len(), &mut tr);\n                    tr.cdata = cdata;\n                }\n                tr\n            });\n            assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n        }\n    }\n\n    // -- (c) manual decode of frames with checksum / a prepended skippable frame\n    //        / RLE blocks / raw blocks, walking every ZSTDnit_* value (row 71).\n    type FnWriteSkip =\n        unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, u32) -> usize;\n    let (cwrite, _) = pair::<FnWriteSkip>(\"ZSTD_writeSkippableFrame\");\n    let mut skip = vec![0u8; 64];\n    let skn = unsafe {\n        cwrite(\n            skip.as_mut_ptr() as *mut c_void,\n            skip.len(),\n            b\"hello-skippable\".as_ptr() as *const c_void,\n            15,\n            3,\n        )\n    };\n    assert!(!is_error(skn));\n    skip.truncate(skn);\n\n    for &shape in &[Shape::Rle, Shape::Random, Shape::Text] {\n        for &n in &[0usize, 25, 26, 131072, 262144] {\n            let s = gen(shape, n, &mut rng);\n            for &chk in &[0i32, 1] {\n                let f = c_frame(\n                    &s,\n                    &[(ZSTD_c_compressionLevel, 3), (ZSTD_c_checksumFlag, chk)],\n                    None,\n                );\n                for prepend in [false, true] {\n                    let mut frame = Vec::new();\n                    if prepend {\n                        frame.extend_from_slice(&skip);\n                    }\n                    frame.extend_from_slice(&f);\n                    let ctx = format!(\n                        \"manual decode {shape:?} n={n} chk={chk} skippable={prepend}\"\n                    );\n                    let t = diff_trace(&ctx, |a| {\n                        let mut tr = Trace::new();\n                        unsafe {\n                            tr.out =\n                                bufferless_decompress(a, &DBegin::Plain, &frame, n, &mut tr);\n                        }\n                        tr\n                    });\n                    assert_eq!(t.out, s, \"{ctx}: C round trip mismatch\");\n                }\n            }\n        }\n    }\n}\n\n// ============================================================================\n// 7. raw blocks: getBlockSize / compressBlock / decompressBlock / insertBlock\n// ============================================================================\n\n/// Compress `src` as a sequence of RAW BLOCKS, then decode them back.\n/// Both directions are recorded, including which blocks came back incompressible.\nunsafe fn raw_block_roundtrip(\n    api: &Api,\n    level: i32,\n    max_block_size: Option<i32>,\n    src: &[u8],\n    split: Option<usize>,\n    tr: &mut Trace,\n) -> Vec<u8> {\n    let cctx = (api.createCCtx)();\n    if let Some(mbs) = max_block_size {\n        tr.ret(\"maxBlockSize\", (api.setParameter)(cctx, ZSTD_c_maxBlockSize, mbs));\n    }\n    tr.ret(\"setLevel\", (api.setParameter)(cctx, ZSTD_c_compressionLevel, level));\n    let br = (api.compressBegin)(cctx, level);\n    tr.ret(\"compressBegin\", br);\n    let bs = (api.getBlockSize)(cctx);\n    tr.u64v(\"getBlockSize\", bs as u64);\n\n    // (is_raw, bytes)\n    let mut blocks: Vec<(bool, Vec<u8>)> = Vec::new();\n    let step = split.unwrap_or(bs).max(1);\n    let cap = (api.compressBound)(step.max(1)) + 1024;\n    let mut dst = vec![0u8; cap];\n    let mut ipos = 0usize;\n    let mut fatal = false;\n    while ipos < src.len() {\n        let end = (ipos + step).min(src.len());\n        let r = (api.compressBlock)(\n            cctx,\n            dst.as_mut_ptr() as *mut c_void,\n            cap,\n            src.as_ptr().add(ipos) as *const c_void,\n            end - ipos,\n        );\n        tr.step3(\"compressBlock\", r, end - ipos, 0);\n        if is_error(r) {\n            fatal = true;\n            break;\n        }\n        if r == 0 {\n            // Incompressible: the caller must carry the raw bytes itself.\n            blocks.push((true, src[ipos..end].to_vec()));\n        } else {\n            blocks.push((false, dst[..r].to_vec()));\n        }\n        ipos = end;\n    }\n    (api.freeCCtx)(cctx);\n    for (raw, b) in &blocks {\n        tr.ret(if *raw { \"blk/raw\" } else { \"blk/comp\" }, b.len());\n        tr.cdata.extend_from_slice(b);\n    }\n    if fatal {\n        return Vec::new();\n    }\n\n    // ---- decode\n    let dctx = (api.createDCtx)();\n    tr.ret(\"decompressBegin\", (api.decompressBegin)(dctx));\n    let mut out = vec![0u8; src.len() + ZSTD_BLOCKSIZE_MAX * 2 + 1024];\n    let mut opos = 0usize;\n    let mut isrc = 0usize;\n    for (raw, b) in &blocks {\n        let want = (isrc + step).min(src.len()) - isrc;\n        if *raw {\n            // Uncompressed block: place it into the history buffer, then declare it.\n            std::ptr::copy_nonoverlapping(b.as_ptr(), out.as_mut_ptr().add(opos), b.len());\n            let r = (api.insertBlock)(dctx, out.as_ptr().add(opos) as *const c_void, b.len());\n            tr.step3(\"insertBlock\", r, b.len(), 0);\n            if is_error(r) {\n                break;\n            }\n            opos += b.len();\n        } else {\n            let r = (api.decompressBlock)(\n                dctx,\n                out.as_mut_ptr().add(opos) as *mut c_void,\n                out.len() - opos,\n                b.as_ptr() as *const c_void,\n                b.len(),\n            );\n            tr.step3(\"decompressBlock\", r, b.len(), want);\n            if is_error(r) {\n                break;\n            }\n            opos += r;\n        }\n        isrc += want;\n    }\n    (api.freeDCtx)(dctx);\n    out[..opos].to_vec()\n}\n\n#[test]\nfn blocklevel_compressBlock_decompressBlock_insertBlock() {\n    let mut rng = Rng::new(SEED ^ 0x7777);\n\n    // -- (a) single block, every size 1..=48 plus the interesting widths,\n    //        for every shape (raw / RLE / compressible), row 70.\n    let mut sizes: Vec<usize> = (0..=48).collect();\n    sizes.extend_from_slice(&[\n        63, 64, 65, 127, 128, 255, 256, 1023, 1024, 4095, 4096, 16384, 65535, 65536,\n        131071, 131072, 131073,\n    ]);\n    for &shape in ALL_SHAPES {\n        let big = gen(shape, 131073, &mut rng);\n        for &n in &sizes {\n            let src = &big[..n];\n            let ctx = format!(\"rawblock single {shape:?} n={n}\");\n            let t = diff_trace(&ctx, |a| {\n                let mut tr = Trace::new();\n                unsafe {\n                    tr.out = raw_block_roundtrip(a, 3, None, src, Some(n.max(1)), &mut tr);\n                }\n                tr\n            });\n            // n == blockSize+1 must be rejected; smaller sizes must round-trip.\n            if n <= ZSTD_BLOCKSIZE_MAX {\n                assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n            } else {\n                assert!(t.out.is_empty(), \"{ctx}: expected C to reject srcSize>blockSize\");\n            }\n        }\n    }\n\n    // -- (b) multi-block sequences: exercises insertBlock for the raw blocks.\n    for &shape in ALL_SHAPES {\n        for &n in &[300usize, 5000, 200_000, 400_000] {\n            let src = gen(shape, n, &mut rng);\n            for &split in &[7usize, 100, 4096, 65536, ZSTD_BLOCKSIZE_MAX] {\n                if split < 200 && n > 6000 {\n                    continue;\n                }\n                for &level in &[1i32, 3, 19] {\n                    if level == 19 && n > 210_000 {\n                        continue;\n                    }\n                    let ctx =\n                        format!(\"rawblock multi {shape:?} n={n} split={split} L{level}\");\n                    let t = diff_trace(&ctx, |a| {\n                        let mut tr = Trace::new();\n                        unsafe {\n                            tr.out = raw_block_roundtrip(\n                                a,\n                                level,\n                                None,\n                                &src,\n                                Some(split),\n                                &mut tr,\n                            );\n                        }\n                        tr\n                    });\n                    assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n                }\n            }\n        }\n    }\n\n    // -- (c) ZSTD_c_maxBlockSize 1024 and 131072 change getBlockSize().\n    for &mbs in &[1024i32, 4096, 65536, 131072] {\n        for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n            let src = gen(shape, 40_000, &mut rng);\n            let ctx = format!(\"rawblock maxBlockSize={mbs} {shape:?}\");\n            let t = diff_trace(&ctx, |a| {\n                let mut tr = Trace::new();\n                unsafe {\n                    tr.out = raw_block_roundtrip(a, 3, Some(mbs), &src, None, &mut tr);\n                }\n                tr\n            });\n            assert_eq!(t.out, src, \"{ctx}: C round trip mismatch\");\n        }\n    }\n\n    // -- (d) explicit oversize rejection: exactly blockSize and blockSize+1.\n    let big = gen(Shape::Text, ZSTD_BLOCKSIZE_MAX + 64, &mut rng);\n    for &delta in &[0i64, 1, 2, 64] {\n        let n = (ZSTD_BLOCKSIZE_MAX as i64 + delta) as usize;\n        let ctx = format!(\"rawblock oversize blockSize+{delta}\");\n        diff_trace(&ctx, |a| {\n            let mut tr = Trace::new();\n            unsafe {\n                let cctx = (a.createCCtx)();\n                tr.ret(\"compressBegin\", (a.compressBegin)(cctx, 3));\n                let bs = (a.getBlockSize)(cctx);\n                tr.u64v(\"getBlockSize\", bs as u64);\n                let cap = (a.compressBound)(n) + 1024;\n                let mut dst = vec![0u8; cap];\n                let r = (a.compressBlock)(\n                    cctx,\n                    dst.as_mut_ptr() as *mut c_void,\n                    cap,\n                    big.as_ptr() as *const c_void,\n                    n,\n                );\n                tr.ret(\"compressBlock\", r);\n                // Also probe a deliberately short dstCapacity.\n                let r2 = (a.compressBlock)(\n                    cctx,\n                    dst.as_mut_ptr() as *mut c_void,\n                    1,\n                    big.as_ptr() as *const c_void,\n                    n.min(ZSTD_BLOCKSIZE_MAX),\n                );\n                tr.ret(\"compressBlock/dst=1\", r2);\n                (a.freeCCtx)(cctx);\n            }\n            tr\n        });\n    }\n\n    // -- (e) decompressBlock / insertBlock error surface.\n    let ctx = \"rawblock decode errors\";\n    diff_trace(ctx, |a| {\n        let mut tr = Trace::new();\n        unsafe {\n            let dctx = (a.createDCtx)();\n            tr.ret(\"decompressBegin\", (a.decompressBegin)(dctx));\n            let mut out = vec![0u8; 4096];\n            let junk = [0u8, 1, 2, 3, 4, 5, 6, 7];\n            for n in 0..=junk.len() {\n                let r = (a.decompressBlock)(\n                    dctx,\n                    out.as_mut_ptr() as *mut c_void,\n                    out.len(),\n                    junk.as_ptr() as *const c_void,\n                    n,\n                );\n                tr.step3(\"decompressBlock/junk\", r, n, 0);\n            }\n            let r = (a.insertBlock)(dctx, out.as_ptr() as *const c_void, 0);\n            tr.ret(\"insertBlock/0\", r);\n            let r = (a.insertBlock)(dctx, out.as_ptr() as *const c_void, 100);\n            tr.ret(\"insertBlock/100\", r);\n            (a.freeDCtx)(dctx);\n        }\n        tr\n    });\n}\n\n// ============================================================================\n// 8. frame utilities on valid (and truncated) frames\n// ============================================================================\n\ntype FnDecodingBufSizeMin = unsafe extern \"C\" fn(u64, u64) -> usize;\ntype FnEstDStreamFromFrame = unsafe extern \"C\" fn(*const c_void, usize) -> usize;\n\nfn frame_utils_all(ctx: &str, frame: &[u8]) {\n    let p = frame.as_ptr() as *const c_void;\n    let n = frame.len();\n\n    diff(&format!(\"{ctx} getFrameContentSize\"), |a| unsafe {\n        (a.getFrameContentSize)(p, n)\n    });\n    diff(&format!(\"{ctx} findDecompressedSize\"), |a| unsafe {\n        (a.findDecompressedSize)(p, n)\n    });\n    diff(&format!(\"{ctx} decompressBound\"), |a| unsafe { (a.decompressBound)(p, n) });\n    diff(&format!(\"{ctx} findFrameCompressedSize\"), |a| unsafe {\n        (a.findFrameCompressedSize)(p, n)\n    });\n    diff(&format!(\"{ctx} frameHeaderSize\"), |a| unsafe { (a.frameHeaderSize)(p, n) });\n    diff(&format!(\"{ctx} isFrame\"), |a| unsafe { (a.isFrame)(p, n) });\n    diff(&format!(\"{ctx} isSkippableFrame\"), |a| unsafe { (a.isSkippableFrame)(p, n) });\n    diff(&format!(\"{ctx} getDictID_fromFrame\"), |a| unsafe {\n        (a.getDictIDFromFrame)(p, n)\n    });\n    diff(&format!(\"{ctx} decompressionMargin\"), |a| unsafe {\n        (a.decompressionMargin)(p, n)\n    });\n    diff(&format!(\"{ctx} estimateDStreamSize_fromFrame\"), |a| unsafe {\n        sym::<FnEstDStreamFromFrame>(a.lib, \"ZSTD_estimateDStreamSize_fromFrame\")(p, n)\n    });\n    // The WHOLE filled struct, for getFrameHeader and both formats of _advanced.\n    diff(&format!(\"{ctx} getFrameHeader\"), |a| unsafe {\n        let mut h = ZSTD_FrameHeader::default();\n        let r = (a.getFrameHeader)(&mut h, p, n);\n        (r, h)\n    });\n    for fmt in [0u32, 1] {\n        diff(&format!(\"{ctx} getFrameHeader_advanced(fmt={fmt})\"), |a| unsafe {\n            let mut h = ZSTD_FrameHeader::default();\n            let r = (a.getFrameHeaderAdvanced)(&mut h, p, n, fmt);\n            (r, h)\n        });\n    }\n    // decodingBufferSize_min over the header's own windowSize/contentSize plus\n    // a fixed grid, so the oracle is exercised well past this frame.\n    let (ws, fcs) = unsafe {\n        let mut h = ZSTD_FrameHeader::default();\n        let r = (capi().getFrameHeader)(&mut h, p, n);\n        if r == 0 {\n            (h.windowSize, h.frameContentSize)\n        } else {\n            (1u64 << 17, ZSTD_CONTENTSIZE_UNKNOWN)\n        }\n    };\n    diff(&format!(\"{ctx} decodingBufferSize_min(hdr)\"), |a| unsafe {\n        sym::<FnDecodingBufSizeMin>(a.lib, \"ZSTD_decodingBufferSize_min\")(ws, fcs)\n    });\n}\n\n#[test]\nfn frame_utilities_on_valid_frames() {\n    let mut rng = Rng::new(SEED ^ 0x8888);\n\n    // Frames spanning every header shape: fcs field 0/1/2/4/8 bytes, dictID\n    // 0/1/2/4 bytes, singleSegment on/off, checksum on/off, magicless.\n    struct FC {\n        name: String,\n        frame: Vec<u8>,\n    }\n    let mut cases: Vec<FC> = Vec::new();\n\n    for &n in &[0usize, 1, 100, 255, 256, 65791, 65792, 200_000] {\n        let src = gen(Shape::Text, n, &mut rng);\n        for &cs in &[0i32, 1] {\n            for &chk in &[0i32, 1] {\n                for &wl in &[10i32, 17] {\n                    for &fmt in &[0i32, 1] {\n                        let f = c_frame(\n                            &src,\n                            &[\n                                (ZSTD_c_compressionLevel, 3),\n                                (ZSTD_c_contentSizeFlag, cs),\n                                (ZSTD_c_checksumFlag, chk),\n                                (ZSTD_c_windowLog, wl),\n                                (ZSTD_c_format, fmt),\n                            ],\n                            None,\n                        );\n                        cases.push(FC {\n                            name: format!(\"n={n} cs={cs} chk={chk} wl={wl} fmt={fmt}\"),\n                            frame: f,\n                        });\n                    }\n                }\n            }\n        }\n    }\n    // dictID widths 0 / 1 / 2 / 4 bytes.\n    {\n        type FnCDictAdv = unsafe extern \"C\" fn(\n            *const c_void,\n            usize,\n            u32,\n            u32,\n            ZSTD_compressionParameters,\n            ZSTD_customMem,\n        ) -> *mut ZSTD_CDict;\n        let src = gen(Shape::Text, 40_000, &mut rng);\n        let raw = gen(Shape::Records, 8192, &mut rng);\n        for &did in &[0u32, 1, 255, 256, 65535, 65536, 0xFFFF_FFFF] {\n            // Build a dictionary whose header declares the wanted dictID.\n            let mut d: Vec<u8> = Vec::new();\n            d.extend_from_slice(&ZSTD_MAGIC_DICTIONARY.to_le_bytes());\n            d.extend_from_slice(&did.to_le_bytes());\n            d.extend_from_slice(&raw);\n            // Only a well-formed zstd dict carries a dictID; a hand-made one is\n            // rejected, so use refPrefix-style raw content plus the CDict path.\n            unsafe {\n                let a = capi();\n                let cparams = (a.getCParams)(3, src.len() as u64, raw.len());\n                let f = sym::<FnCDictAdv>(a.lib, \"ZSTD_createCDict_advanced\");\n                let cdict = f(\n                    raw.as_ptr() as *const c_void,\n                    raw.len(),\n                    1, /* byRef */\n                    1, /* rawContent */\n                    cparams,\n                    ZSTD_customMem::default(),\n                );\n                if cdict.is_null() {\n                    continue;\n                }\n                let cctx = (a.createCCtx)();\n                let _ = (a.refCDict)(cctx, cdict);\n                let cap = (a.compressBound)(src.len()) + 64;\n                let mut dst = vec![0u8; cap];\n                let r = (a.compress2)(\n                    cctx,\n                    dst.as_mut_ptr() as *mut c_void,\n                    cap,\n                    src.as_ptr() as *const c_void,\n                    src.len(),\n                );\n                if !is_error(r) {\n                    dst.truncate(r);\n                    cases.push(FC { name: format!(\"rawdict did={did}\"), frame: dst });\n                }\n                (a.freeCCtx)(cctx);\n                (a.freeCDict)(cdict);\n            }\n        }\n    }\n    // A three-frame concatenation and a skippable frame.\n    {\n        let a = gen(Shape::Text, 3000, &mut rng);\n        let b = gen(Shape::Random, 500, &mut rng);\n        let mut cat = Vec::new();\n        cat.extend_from_slice(&c_frame(&a, &[(ZSTD_c_compressionLevel, 1)], None));\n        cat.extend_from_slice(&c_frame(\n            &b,\n            &[(ZSTD_c_compressionLevel, 3), (ZSTD_c_checksumFlag, 1)],\n            None,\n        ));\n        cat.extend_from_slice(&c_frame(&a, &[(ZSTD_c_compressionLevel, 9)], None));\n        cases.push(FC { name: \"3-frame concat\".to_string(), frame: cat });\n\n        type FnWriteSkip =\n            unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, u32) -> usize;\n        let (w, _) = pair::<FnWriteSkip>(\"ZSTD_writeSkippableFrame\");\n        let mut sk = vec![0u8; 200];\n        let sn = unsafe {\n            w(sk.as_mut_ptr() as *mut c_void, sk.len(), b.as_ptr() as *const c_void, 100, 7)\n        };\n        assert!(!is_error(sn));\n        sk.truncate(sn);\n        cases.push(FC { name: \"skippable\".to_string(), frame: sk });\n    }\n\n    for case in &cases {\n        frame_utils_all(&format!(\"frameutil[{}]\", case.name), &case.frame);\n        // Every truncation from 0 to min(len, 40): the \"needs more input\"\n        // return values must match exactly.\n        let lim = case.frame.len().min(40);\n        for t in 0..=lim {\n            frame_utils_all(\n                &format!(\"frameutil[{}] trunc={t}\", case.name),\n                &case.frame[..t],\n            );\n        }\n    }\n\n    // Also a handful of deliberately corrupt / non-frame buffers.\n    let junk_cases: Vec<Vec<u8>> = vec![\n        vec![],\n        vec![0],\n        vec![0, 0, 0, 0],\n        vec![0x28, 0xB5, 0x2F, 0xFD],\n        vec![0x28, 0xB5, 0x2F, 0xFD, 0x00],\n        vec![0x28, 0xB5, 0x2F, 0xFD, 0xFF, 0xFF, 0xFF, 0xFF],\n        vec![0x50, 0x2A, 0x4D, 0x18],\n        vec![0x50, 0x2A, 0x4D, 0x18, 1, 0, 0, 0],\n        ZSTD_MAGICNUMBER.to_le_bytes().to_vec(),\n        ZSTD_MAGIC_SKIPPABLE_START.to_le_bytes().to_vec(),\n    ];\n    for (i, j) in junk_cases.iter().enumerate() {\n        frame_utils_all(&format!(\"frameutil junk#{i}\"), j);\n    }\n\n    // decodingBufferSize_min oracle grid (independent of any frame).\n    for &ws in &[0u64, 1, 1024, 1 << 10, 1 << 17, 1 << 27, 1 << 31, u64::MAX / 2] {\n        for &fcs in &[0u64, 1, 1024, 1 << 20, ZSTD_CONTENTSIZE_UNKNOWN] {\n            diff(&format!(\"decodingBufferSize_min({ws},{fcs})\"), |a| unsafe {\n                sym::<FnDecodingBufSizeMin>(a.lib, \"ZSTD_decodingBufferSize_min\")(ws, fcs)\n            });\n        }\n    }\n}\n\n// ============================================================================\n// 9. skippable frames\n// ============================================================================\n\ntype FnWriteSkippable =\n    unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, u32) -> usize;\ntype FnReadSkippable =\n    unsafe extern \"C\" fn(*mut c_void, usize, *mut u32, *const c_void, usize) -> usize;\ntype FnWriteLastEmptyBlock = unsafe extern \"C\" fn(*mut c_void, usize) -> usize;\n\n#[test]\nfn skippable_frames() {\n    let mut rng = Rng::new(SEED ^ 0x9999);\n\n    // -- (a) writeSkippableFrame for magicVariant 0..15 (+16 = invalid) and\n    //        payloads 0 / 1 / 65536 bytes, at exact and short dstCapacity.\n    for &plen in &[0usize, 1, 7, 100, 65536] {\n        let payload = gen(Shape::Records, plen, &mut rng);\n        for variant in 0u32..=17 {\n            for &shave in &[0usize, 1, 8] {\n                let ctx = format!(\"writeSkippable plen={plen} variant={variant} shave={shave}\");\n                let t = diff_trace(&ctx, |a| {\n                    let mut tr = Trace::new();\n                    unsafe {\n                        let w = sym::<FnWriteSkippable>(a.lib, \"ZSTD_writeSkippableFrame\");\n                        let r = sym::<FnReadSkippable>(a.lib, \"ZSTD_readSkippableFrame\");\n                        let cap = (plen + 8).saturating_sub(shave);\n                        let mut dst = vec![0u8; cap.max(1)];\n                        let wn = w(\n                            dst.as_mut_ptr() as *mut c_void,\n                            cap,\n                            payload.as_ptr() as *const c_void,\n                            plen,\n                            variant,\n                        );\n                        tr.ret(\"write\", wn);\n                        if is_error(wn) {\n                            return tr;\n                        }\n                        tr.cdata = dst[..wn].to_vec();\n                        tr.u64v(\n                            \"isSkippableFrame\",\n                            (a.isSkippableFrame)(dst.as_ptr() as *const c_void, wn) as u64,\n                        );\n                        tr.u64v(\n                            \"isFrame\",\n                            (a.isFrame)(dst.as_ptr() as *const c_void, wn) as u64,\n                        );\n                        tr.u64v(\n                            \"getFrameContentSize\",\n                            (a.getFrameContentSize)(dst.as_ptr() as *const c_void, wn),\n                        );\n                        tr.ret(\n                            \"findFrameCompressedSize\",\n                            (a.findFrameCompressedSize)(dst.as_ptr() as *const c_void, wn),\n                        );\n                        let mut h = ZSTD_FrameHeader::default();\n                        let hr =\n                            (a.getFrameHeader)(&mut h, dst.as_ptr() as *const c_void, wn);\n                        tr.ret(\"getFrameHeader\", hr);\n                        tr.u64v(\"hdr.frameType\", h.frameType as u64);\n                        tr.u64v(\"hdr.frameContentSize\", h.frameContentSize);\n                        tr.u64v(\"hdr.headerSize\", h.headerSize as u64);\n                        // read it back, with and without the magicVariant out-param\n                        for rcap in [plen, plen + 1, plen.saturating_sub(1)] {\n                            let mut back = vec![0u8; rcap.max(1)];\n                            let mut mv: u32 = 0xDEAD_BEEF;\n                            let rn = r(\n                                back.as_mut_ptr() as *mut c_void,\n                                rcap,\n                                &mut mv,\n                                dst.as_ptr() as *const c_void,\n                                wn,\n                            );\n                            tr.step3(\"read\", rn, rcap, mv as usize);\n                            if !is_error(rn) {\n                                tr.out.extend_from_slice(&back[..rn]);\n                            }\n                        }\n                        let mut back = vec![0u8; plen.max(1)];\n                        let rn = r(\n                            back.as_mut_ptr() as *mut c_void,\n                            plen,\n                            std::ptr::null_mut(),\n                            dst.as_ptr() as *const c_void,\n                            wn,\n                        );\n                        tr.ret(\"read(NULL mv)\", rn);\n                        // truncated skippable frames\n                        for t in 0..=wn.min(12) {\n                            let mut back = vec![0u8; plen.max(1)];\n                            let mut mv: u32 = 0;\n                            let rn = r(\n                                back.as_mut_ptr() as *mut c_void,\n                                plen,\n                                &mut mv,\n                                dst.as_ptr() as *const c_void,\n                                t,\n                            );\n                            tr.step3(\"read/trunc\", rn, t, mv as usize);\n                            tr.u64v(\n                                \"isSkippable/trunc\",\n                                (a.isSkippableFrame)(dst.as_ptr() as *const c_void, t) as u64,\n                            );\n                        }\n                    }\n                    tr\n                });\n                if variant <= 15 && shave == 0 {\n                    assert!(!t.cdata.is_empty(), \"{ctx}: C refused a valid skippable frame\");\n                }\n            }\n        }\n    }\n\n    // -- (b) readSkippableFrame on a REAL frame must fail identically.\n    let real = c_frame(&gen(Shape::Text, 1000, &mut rng), &[(ZSTD_c_compressionLevel, 3)], None);\n    diff_trace(\"readSkippable on real frame\", |a| {\n        let mut tr = Trace::new();\n        unsafe {\n            let r = sym::<FnReadSkippable>(a.lib, \"ZSTD_readSkippableFrame\");\n            let mut back = vec![0u8; 4096];\n            let mut mv: u32 = 0;\n            let rn = r(\n                back.as_mut_ptr() as *mut c_void,\n                back.len(),\n                &mut mv,\n                real.as_ptr() as *const c_void,\n                real.len(),\n            );\n            tr.step3(\"read\", rn, real.len(), mv as usize);\n        }\n        tr\n    });\n\n    // -- (c) skippable frames interleaved with real frames, one-shot + streaming.\n    for &variant in &[0u32, 1, 7, 15] {\n        for &plen in &[0usize, 1, 100, 70000] {\n            let payload = gen(Shape::Random, plen, &mut rng);\n            let a_src = gen(Shape::Text, 5000, &mut rng);\n            let b_src = gen(Shape::Rle, 3000, &mut rng);\n            let mut sk = vec![0u8; plen + 16];\n            let skn = unsafe {\n                let (w, _) = pair::<FnWriteSkippable>(\"ZSTD_writeSkippableFrame\");\n                w(\n                    sk.as_mut_ptr() as *mut c_void,\n                    sk.len(),\n                    payload.as_ptr() as *const c_void,\n                    plen,\n                    variant,\n                )\n            };\n            assert!(!is_error(skn));\n            sk.truncate(skn);\n\n            let fa = c_frame(&a_src, &[(ZSTD_c_compressionLevel, 3)], None);\n            let fb =\n                c_frame(&b_src, &[(ZSTD_c_compressionLevel, 3), (ZSTD_c_checksumFlag, 1)], None);\n\n            let mut stream = Vec::new();\n            stream.extend_from_slice(&sk);\n            stream.extend_from_slice(&fa);\n            stream.extend_from_slice(&sk);\n            stream.extend_from_slice(&fb);\n            stream.extend_from_slice(&sk);\n            let mut plain = Vec::new();\n            plain.extend_from_slice(&a_src);\n            plain.extend_from_slice(&b_src);\n\n            let ctx = format!(\"skippable interleave variant={variant} plen={plen}\");\n            let t = diff_trace(&ctx, |a| {\n                let mut tr = Trace::new();\n                unsafe {\n                    // one-shot\n                    let mut dst = vec![0u8; plain.len() + 128];\n                    let dctx = (a.createDCtx)();\n                    let r = (a.decompressDCtx)(\n                        dctx,\n                        dst.as_mut_ptr() as *mut c_void,\n                        dst.len(),\n                        stream.as_ptr() as *const c_void,\n                        stream.len(),\n                    );\n                    tr.ret(\"decompressDCtx\", r);\n                    if !is_error(r) {\n                        tr.out = dst[..r].to_vec();\n                    }\n                    (a.freeDCtx)(dctx);\n                    tr.u64v(\n                        \"findDecompressedSize\",\n                        (a.findDecompressedSize)(\n                            stream.as_ptr() as *const c_void,\n                            stream.len(),\n                        ),\n                    );\n                    tr.u64v(\n                        \"decompressBound\",\n                        (a.decompressBound)(stream.as_ptr() as *const c_void, stream.len()),\n                    );\n                    // streaming, small buffers\n                    let p = stream_decompress(\n                        a,\n                        &stream,\n                        333,\n                        77,\n                        DDict::None,\n                        None,\n                        &mut tr,\n                    );\n                    tr.cdata = p;\n                }\n                tr\n            });\n            assert_eq!(t.out, plain, \"{ctx}: C one-shot mismatch\");\n            assert_eq!(t.cdata, plain, \"{ctx}: C streaming mismatch\");\n        }\n    }\n\n    // -- (d) ZSTD_writeLastEmptyBlock at every capacity around its true size.\n    for cap in 0usize..=8 {\n        diff_trace(&format!(\"writeLastEmptyBlock cap={cap}\"), |a| {\n            let mut tr = Trace::new();\n            unsafe {\n                let f = sym::<FnWriteLastEmptyBlock>(a.lib, \"ZSTD_writeLastEmptyBlock\");\n                let mut dst = vec![0xA5u8; 16];\n                let r = f(dst.as_mut_ptr() as *mut c_void, cap);\n                tr.ret(\"writeLastEmptyBlock\", r);\n                tr.cdata = dst.clone();\n            }\n            tr\n        });\n    }\n\n    // -- (e) hand-assembled frame: compressBegin + compressBlock* + lastEmptyBlock,\n    //        decoded by the normal decoder (row 70's final sub-case).\n    for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n        for &n in &[100usize, 5000, 200_000] {\n            let src = gen(shape, n, &mut rng);\n            let ctx = format!(\"handmade frame {shape:?} n={n}\");\n            let t = diff_trace(&ctx, |a| {\n                let mut tr = Trace::new();\n                unsafe {\n                    let cctx = (a.createCCtx)();\n                    // magicless-free: keep the standard header via compressBegin,\n                    // then emit blocks by hand and close with an empty last block.\n                    tr.ret(\"compressBegin\", (a.compressBegin)(cctx, 3));\n                    let bs = (a.getBlockSize)(cctx);\n                    tr.u64v(\"getBlockSize\", bs as u64);\n                    let cap = (a.compressBound)(n) + 4096;\n                    let mut dst = vec![0u8; cap];\n                    // header first: compressContinue with 0 bytes writes the header\n                    let hr = (a.compressContinue)(\n                        cctx,\n                        dst.as_mut_ptr() as *mut c_void,\n                        cap,\n                        src.as_ptr() as *const c_void,\n                        0,\n                    );\n                    tr.ret(\"headerWrite\", hr);\n                    if is_error(hr) {\n                        (a.freeCCtx)(cctx);\n                        return tr;\n                    }\n                    let mut opos = hr;\n                    let mut ipos = 0usize;\n                    let mut raws: Vec<(usize, usize)> = Vec::new();\n                    let mut ok = true;\n                    while ipos < n {\n                        let end = (ipos + bs).min(n);\n                        let r = (a.compressBlock)(\n                            cctx,\n                            dst.as_mut_ptr().add(opos) as *mut c_void,\n                            cap - opos,\n                            src.as_ptr().add(ipos) as *const c_void,\n                            end - ipos,\n                        );\n                        tr.step3(\"compressBlock\", r, end - ipos, 0);\n                        if is_error(r) {\n                            ok = false;\n                            break;\n                        }\n                        if r == 0 {\n                            raws.push((ipos, end));\n                            ok = false; // cannot splice raw blocks into a frame here\n                            break;\n                        }\n                        opos += r;\n                        ipos = end;\n                    }\n                    if ok {\n                        let f =\n                            sym::<FnWriteLastEmptyBlock>(a.lib, \"ZSTD_writeLastEmptyBlock\");\n                        let r = f(dst.as_mut_ptr().add(opos) as *mut c_void, cap - opos);\n                        tr.ret(\"writeLastEmptyBlock\", r);\n                        if !is_error(r) {\n                            opos += r;\n                            tr.cdata = dst[..opos].to_vec();\n                            let mut plain = vec![0u8; n + 64];\n                            let dctx = (a.createDCtx)();\n                            let dr = (a.decompressDCtx)(\n                                dctx,\n                                plain.as_mut_ptr() as *mut c_void,\n                                plain.len(),\n                                dst.as_ptr() as *const c_void,\n                                opos,\n                            );\n                            tr.ret(\"decode\", dr);\n                