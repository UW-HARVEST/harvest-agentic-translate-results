e\")(dict.len(), dlm)\n                };\n                assert_eq!(ddsz, ddsz_r);\n                let frame = c.bytes.clone();\n                let rund = |api: &Api| -> Out {\n                    unsafe {\n                        let mut ws = wksp(ddsz);\n                        let f = sym::<FnInitStaticDDict>(api.lib, \"ZSTD_initStaticDDict\");\n                        let ddict = f(\n                            ws.as_mut_ptr() as *mut c_void,\n                            ddsz,\n                            as_ptr_c(&dict),\n                            dict.len(),\n                            dlm,\n                            dct,\n                        );\n                        assert!(!ddict.is_null(), \"{} initStaticDDict NULL\", api.tag);\n                        let dctx = (api.createDCtx)();\n                        let rr = (api.dRefDDict)(dctx, ddict);\n                        if is_error(rr) {\n                            (api.freeDCtx)(dctx);\n                            return Out::err(rr);\n                        }\n                        let mut buf = vec![0u8; src.len() + 64];\n                        let n = buf.len();\n                        let ret = (api.decompressDCtx)(\n                            dctx,\n                            as_ptr_m(&mut buf),\n                            n,\n                            as_ptr_c(&frame),\n                            frame.len(),\n                        );\n                        (api.freeDCtx)(dctx);\n                        Out::ok(ret, &buf)\n                    }\n                };\n                let dc = rund(capi());\n                let dr = rund(rapi());\n                same_out(&format!(\"{ctx}: static ddict\"), &dc, &dr);\n                assert_bytes_eq(&format!(\"{ctx}: rt\"), &src, &dc.bytes);\n            }\n        }\n    }\n}\n\n#[test]\nfn p3_static_init_rejects_small_and_misaligned() {\n    let mut drng = Rng::new(0x57A7_4C00);\n    let dict = gen(Shape::Text, 4096, &mu