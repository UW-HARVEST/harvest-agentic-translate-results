e number of bytes that would be read to decompress this frame\n43\t                                 or an error code if it fails (which can be tested using ZSTDv01_isError())\n44\t     dBound (output parameter) : an upper-bound for the decompressed size of the data in the frame\n45\t                                 or ZSTD_CONTENTSIZE_ERROR if an error occurs\n46\t\n47\t     note : assumes `cSize` and `dBound` are _not_ NULL.\n48\t */\n49\tvoid ZSTDv01_findFrameSizeInfoLegacy(const void *src, size_t srcSize,\n50\t                                     size_t* cSize, unsigned long long* dBound);\n51\t\n52\t/**\n53\tZSTDv01_isError() : tells if the result of ZSTDv01_decompress() is an error\n54\t*/\n55\tunsigned ZSTDv01_isError(size_t code);\n56\t\n57\t\n58\t/* *************************************\n59\t*  Advanced functions\n60\t***************************************/\n61\ttypedef struct ZSTDv01_Dctx_s ZSTDv01_Dctx;\n62\tZSTDv01_Dctx* ZSTDv01_createDCtx(void);\n63\tsize_t ZSTDv01_freeDCtx(ZSTDv01_Dctx* dctx);\n64\t\n65\tsize_t ZSTDv01_decompressDCtx(void* ctx,\n66\t                              void* dst, size_t maxOriginalSize,\n67\t                        const void* src, size_t compressedSize);\n68\t\n69\t/* *************************************\n70\t*  Streaming functions\n71\t***************************************/\n72\tsize_t ZSTDv01_resetDCtx(ZSTDv01_Dctx* dctx);\n73\t\n74\tsize_t ZSTDv01_nextSrcSizeToDecompress(ZSTDv01_Dctx* dctx);\n75\tsize_t ZSTDv01_decompressContinue(ZSTDv01_Dctx* dctx, void* dst, size_t maxDstSize, const void* src, size_t srcSize);\n76\t/**\n77\t  Use above functions alternatively.\n78\t  ZSTD_nextSrcSizeToDecompress() tells how much bytes to provide as 'srcSize' to ZSTD_decompressContinue().\n79\t  ZSTD_decompressContinue() will use previous data blocks to improve compression if they are located prior to current block.\n80\t  Result is the number of bytes regenerated within 'dst'.\n81\t  It can be zero, which is not an error; it just means ZSTD_decompressContinue() has decoded some header.\n82\t*/\n83\t\n84\t/* *************************************\n85\t*  Prefix - version detection\n86\t***************************************/\n87\t#define ZSTDv01_magicNumber   0xFD2FB51E   /* Big Endian version */\n88\t#define ZSTDv01_magicNumberLE 0x1EB52FFD   /* Little Endian version */\n89\t\n90\t\n91\t#if defined (__cplusplus)\n92\t}\n93\t#endif\n94\t\n95\t#endif /* ZSTD_V01_H_28739879432 */\n96\t=========== zstd_v02.h ===========\n97\t/*\n98\t * Copyright (c) Yann Collet, Meta Platforms, Inc. and affiliates.\n99\t * All rights reserved.\n100\t *\n101\t * This source code is licensed under both the BSD-style license (found in the\n102\t * LICENSE file in the root directory of this source tree) and the GPLv2 (found\n103\t * in the COPYING file in the root directory of this source tree).\n104\t * You may select, at your option, one of the above-listed licenses.\n105\t */\n106\t\n107\t#ifndef ZSTD_V02_H_4174539423\n108\t#define ZSTD_V02_H_4174539423\n109\t\n110\t#if defined (__cplusplus)\n111\textern \"C\" {\n112\t#endif\n113\t\n114\t/* *************************************\n115\t*  Includes\n116\t***************************************/\n117\t#include <stddef.h>   /* size_t */\n118\t\n119\t\n120\t/* *************************************\n121\t*  Simple one-step function\n122\t***************************************/\n123\t/**\n124\tZSTDv02_decompress() : decompress ZSTD frames compliant with v0.2.x format\n125\t    compressedSize : is the exact source size\n126\t    maxOriginalSize : is the size of the 'dst' buffer, which must be already allocated.\n127\t                      It must be equal or larger than originalSize, otherwise decompression will fail.\n128\t    return : the number of bytes decompressed into destination buffer (originalSize)\n129\t             or an errorCode if it fails (which can be tested using ZSTDv01_isError())\n130\t*/\n131\tsize_t ZSTDv02_decompress( void* dst, size_t maxOriginalSize,\n132\t                     const void* src, size_t compressedSize);\n133\t\n134\t /**\n135\t ZSTDv02_findFrameSizeInfoLegacy() : get the source length and decompressed bound of a ZSTD frame compliant with v0.2.x format\n136\t     srcSize : The size of the 'src' buffer, at least as large as the frame pointed to by 'src'\n137\t     cSize (output parameter)  : the number of bytes that would be read to decompress this frame\n138\t                                 or an error code if it fails (which can be tested using ZSTDv01_isError())\n139\t     dBound (output parameter) : an upper-bound for the decompressed size of the data in the frame\n140\t                                 or ZSTD_CONTENTSIZE_ERROR if an error occurs\n141\t\n142\t    note : assumes `cSize` and `dBound` are _not_ NULL.\n143\t */\n144\tvoid ZSTDv02_findFrameSizeInfoLegacy(const void *src, size_t srcSize,\n145\t                                     size_t* cSize, unsigned long long* dBound);\n146\t\n147\t/**\n148\tZSTDv02_isError() : tells if the result of ZSTDv02_decompress() is an error\n149\t*/\n150\tunsigned ZSTDv02_isError(size_t code);\n151\t\n152\t\n153\t/* *************************************\n154\t*  Advanced functions\n155\t***************************************/\n156\ttypedef struct ZSTDv02_Dctx_s ZSTDv02_Dctx;\n157\tZSTDv02_Dctx* ZSTDv02_createDCtx(void);\n158\tsize_t ZSTDv02_freeDCtx(ZSTDv02_Dctx* dctx);\n159\t\n160\tsize_t ZSTDv02_decompressDCtx(void* ctx,\n161\t                              void* dst, size_t maxOriginalSize,\n162\t                        const void* src, size_t compressedSize);\n163\t\n164\t/* *************************************\n165\t*  Streaming functions\n166\t***************************************/\n167\tsize_t ZSTDv02_resetDCtx(ZSTDv02_Dctx* dctx);\n168\t\n169\tsize_t ZSTDv02_nextSrcSizeToDecompress(ZSTDv02_Dctx* dctx);\n170\tsize_t ZSTDv02_decompressContinue(ZSTDv02_Dctx* dctx, void* dst, size_t maxDstSize, const void* src, size_t srcSize);\n171\t/**\n172\t  Use above functions alternatively.\n173\t  ZSTD_nextSrcSizeToDecompress() tells how much bytes to provide as 'srcSize' to ZSTD_decompressContinue().\n174\t  ZSTD_decompressContinue() will use previous data blocks to improve compression if they are located prior to current block.\n175\t  Result is the number of bytes regenerated within 'dst'.\n176\t  It can be zero, which is not an error; it just means ZSTD_decompressContinue() has decoded some header.\n177\t*/\n178\t\n179\t/* *************************************\n180\t*  Prefix - version detection\n181\t***************************************/\n182\t#define ZSTDv02_magicNumber 0xFD2FB522   /* v0.2 */\n183\t\n184\t\n185\t#if defined (__cplusplus)\n186\t}\n187\t#endif\n188\t\n189\t#endif /* ZSTD_V02_H_4174539423 */\n190\t=========== zstd_v03.h ===========\n191\t/*\n192\t * Copyright (c) Yann Collet, Meta Platforms, Inc. and affiliates.\n193\t * All rights reserved.\n194\t *\n195\t * This source code is licensed under both the BSD-style license (found in the\n196\t * LICENSE file in the root directory of this source tree) and the GPLv2 (found\n197\t * in the COPYING file in the root directory of this source tree).\n198\t * You may select, at your option, one of the above-listed licenses.\n199\t */\n200\t\n201\t#ifndef ZSTD_V03_H_298734209782\n202\t#define ZSTD_V03_H_298734209782\n203\t\n204\t#if defined (__cplusplus)\n205\textern \"C\" {\n206\t#endif\n207\t\n208\t/* *************************************\n209\t*  Includes\n210\t***************************************/\n211\t#include <stddef.h>   /* size_t */\n212\t\n213\t\n214\t/* *************************************\n215\t*  Simple one-step function\n216\t***************************************/\n217\t/**\n218\tZSTDv03_decompress() : decompress ZSTD frames compliant with v0.3.x format\n219\t    compressedSize : is the exact source size\n220\t    maxOriginalSize : is the size of the 'dst' buffer, which must be already allocated.\n221\t                      It must be equal or larger than originalSize, otherwise decompression will fail.\n222\t    return : the number of bytes decompressed into destination buffer (originalSize)\n223\t             or an errorCode if it fails (which can be tested using ZSTDv01_isError())\n224\t*/\n225\tsize_t ZSTDv03_decompress( void* dst, size_t maxOriginalSize,\n226\t                     const void* src, size_t compressedSize);\n227\t\n228\t /**\n229\t ZSTDv03_findFrameSizeInfoLegacy() : get the source length and decompressed bound of a ZSTD frame compliant with v0.3.x format\n230\t     srcSize : The size of the 'src' buffer, at least as large as the frame pointed to by 'src'\n231\t     cSize (output parameter)  : the number of bytes that would be read to decompress this frame\n232\t                                 or an error code if it fails (which can be tested using ZSTDv01_isError())\n233\t     dBound (output parameter) : an upper-bound for the decompressed size of the data in the frame\n234\t                                 or ZSTD_CONTENTSIZE_ERROR if an error occurs\n235\t\n236\t    note : assumes `cSize` and `dBound` are _not_ NULL.\n237\t */\n238\t void ZSTDv03_findFrameSizeInfoLegacy(const void *src, size_t srcSize,\n239\t                                      size_t* cSize, unsigned long long* dBound);\n240\t\n241\t    /**\n242\tZSTDv03_isError() : tells if the result of ZSTDv03_decompress() is an error\n243\t*/\n244\tunsigned ZSTDv03_isError(size_t code);\n245\t\n246\t\n247\t/* *************************************\n248\t*  Advanced functions\n249\t***************************************/\n250\ttypedef struct ZSTDv03_Dctx_s ZSTDv03_Dctx;\n251\tZSTDv03_Dctx* ZSTDv03_createDCtx(void);\n252\tsize_t ZSTDv03_freeDCtx(ZSTDv03_Dctx* dctx);\n253\t\n254\tsize_t ZSTDv03_decompressDCtx(void* ctx,\n255\t                              void* dst, size_t maxOriginalSize,\n256\t                        const void* src, size_t compressedSize);\n257\t\n258\t/* *************************************\n259\t*  Streaming functions\n260\t***************************************/\n261\tsize_t ZSTDv03_resetDCtx(ZSTDv03_Dctx* dctx);\n262\t\n263\tsize_t ZSTDv03_nextSrcSizeToDecompress(ZSTDv03_Dctx* dctx);\n264\tsize_t ZSTDv03_decompressContinue(ZSTDv03_Dctx* dctx, void* dst, size_t maxDstSize, const void* src, size_t srcSize);\n265\t/**\n266\t  Use above functions alternatively.\n267\t  ZSTD_nextSrcSizeToDecompress() tells how much bytes to provide as 'srcSize' to ZSTD_decompressContinue().\n268\t  ZSTD_decompressContinue() will use previous data blocks to improve compression if they are located prior to current block.\n269\t  Result is the number of bytes regenerated within 'dst'.\n270\t  It can be zero, which is not an error; it just means ZSTD_decompressContinue() has decoded some header.\n271\t*/\n272\t\n273\t/* *************************************\n274\t*  Prefix - version detection\n275\t***************************************/\n276\t#define ZSTDv03_magicNumber 0xFD2FB523   /* v0.3 */\n277\t\n278\t\n279\t#if defined (__cplusplus)\n280\t}\n281\t#endif\n282\t\n283\t#endif /* ZSTD_V03_H_298734209782 */\n284\t=========== zstd_v04.h ===========\n285\t/*\n286\t * Copyright (c) Yann Collet, Meta Platforms, Inc. and affiliates.\n287\t * All rights reserved.\n288\t *\n289\t * This source code is licensed under both the BSD-style license (found in the\n290\t * LICENSE file in the root directory of this source tree) and the GPLv2 (found\n291\t * in the COPYING file in the root directory of this source tree).\n292\t * You may select, at your option, one of the above-listed licenses.\n293\t */\n294\t\n295\t#ifndef ZSTD_V04_H_91868324769238\n296\t#define ZSTD_V04_H_91868324769238\n297\t\n298\t#if defined (__cplusplus)\n299\textern \"C\" {\n300\t#endif\n301\t\n302\t/* *************************************\n303\t*  Includes\n304\t***************************************/\n305\t#include <stddef.h>   /* size_t */\n306\t\n307\t\n308\t/* *************************************\n309\t*  Simple one-step function\n310\t***************************************/\n311\t/**\n312\tZSTDv04_decompress() : decompress ZSTD frames compliant with v0.4.x format\n313\t    compressedSize : is the exact source size\n314\t    maxOriginalSize : is the size of the 'dst' buffer, which must be already allocated.\n315\t                      It must be equal or larger than originalSize, otherwise decompression will fail.\n316\t    return : the number of bytes decompressed into destination buffer (originalSize)\n317\t             or an errorCode if it fails (which can be tested using ZSTDv01_isError())\n318\t*/\n319\tsize_t ZSTDv04_decompress( void* dst, size_t maxOriginalSize,\n320\t                     const void* src, size_t compressedSize);\n321\t\n322\t /**\n323\t ZSTDv04_findFrameSizeInfoLegacy() : get the source length and decompressed bound of a ZSTD frame compliant with v0.4.x format\n324\t     srcSize : The size of the 'src' buffer, at least as large as the frame pointed to by 'src'\n325\t     cSize (output parameter)  : the number of bytes that would be read to decompress this frame\n326\t                                 or an error code if it fails (which can be tested using ZSTDv01_isError())\n327\t     dBound (output parameter) : an upper-bound for the decompressed size of the data in the frame\n328\t                                 or ZSTD_CONTENTSIZE_ERROR if an error occurs\n329\t\n330\t    note : assumes `cSize` and `dBound` are _not_ NULL.\n331\t */\n332\t void ZSTDv04_findFrameSizeInfoLegacy(const void *src, size_t srcSize,\n333\t                                      size_t* cSize, unsigned long long* dBound);\n334\t\n335\t/**\n336\tZSTDv04_isError() : tells if the result of ZSTDv04_decompress() is an error\n337\t*/\n338\tunsigned ZSTDv04_isError(size_t code);\n339\t\n340\t\n341\t/* *************************************\n342\t*  Advanced functions\n343\t***************************************/\n344\ttypedef struct ZSTDv04_Dctx_s ZSTDv04_Dctx;\n345\tZSTDv04_Dctx* ZSTDv04_createDCtx(void);\n346\tsize_t ZSTDv04_freeDCtx(ZSTDv04_Dctx* dctx);\n347\t\n348\tsize_t ZSTDv04_decompressDCtx(ZSTDv04_Dctx* dctx,\n349\t                              void* dst, size_t maxOriginalSize,\n350\t                        const void* src, size_t compressedSize);\n351\t\n352\t\n353\t/* *************************************\n354\t*  Direct Streaming\n355\t***************************************/\n356\tsize_t ZSTDv04_resetDCtx(ZSTDv04_Dctx* dctx);\n357\t\n358\tsize_t ZSTDv04_nextSrcSizeToDecompress(ZSTDv04_Dctx* dctx);\n359\tsize_t ZSTDv04_decompressContinue(ZSTDv04_Dctx* dctx, void* dst, size_t maxDstSize, const void* src, size_t srcSize);\n360\t/**\n361\t  Use above functions alternatively.\n362\t  ZSTD_nextSrcSizeToDecompress() tells how much bytes to provide as 'srcSize' to ZSTD_decompressContinue().\n363\t  ZSTD_decompressContinue() will use previous data blocks to improve compression if they are located prior to current block.\n364\t  Result is the number of bytes regenerated within 'dst'.\n365\t  It can be zero, which is not an error; it just means ZSTD_decompressContinue() has decoded some header.\n366\t*/\n367\t\n368\t\n369\t/* *************************************\n370\t*  Buffered Streaming\n371\t***************************************/\n372\ttypedef struct ZBUFFv04_DCtx_s ZBUFFv04_DCtx;\n373\tZBUFFv04_DCtx* ZBUFFv04_createDCtx(void);\n374\tsize_t         ZBUFFv04_freeDCtx(ZBUFFv04_DCtx* dctx);\n375\t\n376\tsize_t ZBUFFv04_decompressInit(ZBUFFv04_DCtx* dctx);\n377\tsize_t ZBUFFv04_decompressWithDictionary(ZBUFFv04_DCtx* dctx, const void* dict, size_t dictSize);\n378\t\n379\tsize_t ZBUFFv04_decompressContinue(ZBUFFv04_DCtx* dctx, void* dst, size_t* maxDstSizePtr, const void* src, size_t* srcSizePtr);\n380\t\n381\t/** ************************************************\n382\t*  Streaming decompression\n383\t*\n384\t*  A ZBUFF_DCtx object is required to track streaming operation.\n385\t*  Use ZBUFF_createDCtx() and ZBUFF_freeDCtx() to create/release resources.\n386\t*  Use ZBUFF_decompressInit() to start a new decompression operation.\n387\t*  ZBUFF_DCtx objects can be reused multiple times.\n388\t*\n389\t*  Optionally, a reference to a static dictionary can be set, using ZBUFF_decompressWithDictionary()\n390\t*  It must be the same content as the one set during compression phase.\n391\t*  Dictionary content must remain accessible during the decompression process.\n392\t*\n393\t*  Use ZBUFF_decompressContinue() repetitively to consume your input.\n394\t*  *srcSizePtr and *maxDstSizePtr can be any size.\n395\t*  The function will report how many bytes were read or written by modifying *srcSizePtr and *maxDstSizePtr.\n396\t*  Note that it may not consume the entire input, in which case it's up to the caller to present remaining input again.\n397\t*  The content of dst will be overwritten (up to *maxDstSizePtr) at each function call, so save its content if it matters or change dst.\n398\t*  @return : a hint to preferred nb of bytes to use as input for next function call (it's only a hint, to improve latency)\n399\t*            or 0 when a frame is completely decoded\n400\t*            or an error code, which can be tested using ZBUFF_isError().\n401\t*\n402\t*  Hint : recommended buffer sizes (not compulsory) : ZBUFF_recommendedDInSize / ZBUFF_recommendedDOutSize\n403\t*  output : ZBUFF_recommendedDOutSize==128 KB block size is the internal unit, it ensures it's always possible to write a full block when it's decoded.\n404\t*  input : ZBUFF_recommendedDInSize==128Kb+3; just follow indications from ZBUFF_decompressContinue() to minimize latency. It should always be <= 128 KB + 3 .\n405\t* **************************************************/\n406\tunsigned ZBUFFv04_isError(size_t errorCode);\n407\tconst char* ZBUFFv04_getErrorName(size_t errorCode);\n408\t\n409\t\n410\t/** The below functions provide recommended buffer sizes for Compression or Decompression operations.\n411\t*   These sizes are not compulsory, they just tend to offer better latency */\n412\tsize_t ZBUFFv04_recommendedDInSize(void);\n413\tsize_t ZBUFFv04_recommendedDOutSize(void);\n414\t\n415\t\n416\t/* *************************************\n417\t*  Prefix - version detection\n418\t***************************************/\n419\t#define ZSTDv04_magicNumber 0xFD2FB524   /* v0.4 */\n420\t\n421\t\n422\t#if defined (__cplusplus)\n423\t}\n424\t#endif\n425\t\n426\t#endif /* ZSTD_V04_H_91868324769238 */\n427\t=========== zstd_v05.h ===========\n428\t/*\n429\t * Copyright (c) Yann Collet, Meta Platforms, Inc. and affiliates.\n430\t * All rights reserved.\n431\t *\n432\t * This source code is licensed under both the BSD-style license (found in the\n433\t * LICENSE file in the root directory of this source tree) and the GPLv2 (found\n434\t * in the COPYING file in the root directory of this source tree).\n435\t * You may select, at your option, one of the above-listed licenses.\n436\t */\n437\t\n438\t#ifndef ZSTDv05_H\n439\t#define ZSTDv05_H\n440\t\n441\t#if defined (__cplusplus)\n442\textern \"C\" {\n443\t#endif\n444\t\n445\t/*-*************************************\n446\t*  Dependencies\n447\t***************************************/\n448\t#include <stddef.h>   /* size_t */\n449\t#include \"../common/mem.h\"      /* U64, U32 */\n450\t\n451\t\n452\t/* *************************************\n453\t*  Simple functions\n454\t***************************************/\n455\t/*! ZSTDv05_decompress() :\n456\t    `compressedSize` : is the _exact_ size of the compressed blob, otherwise decompression will fail.\n457\t    `dstCapacity` must be large enough, equal or larger than originalSize.\n458\t    @return : the number of bytes decompressed into `dst` (<= `dstCapacity`),\n459\t              or an errorCode if it fails (which can be tested using ZSTDv05_isError()) */\n460\tsize_t ZSTDv05_decompress( void* dst, size_t dstCapacity,\n461\t                     const void* src, size_t compressedSize);\n462\t\n463\t /**\n464\t ZSTDv05_findFrameSizeInfoLegacy() : get the source length and decompressed bound of a ZSTD frame compliant with v0.5.x format\n465\t     srcSize : The size of the 'src' buffer, at least as large as the frame pointed to by 'src'\n466\t     cSize (output parameter)  : the number of bytes that would be read to decompress this frame\n467\t                                 or an error code if it fails (which can be tested using ZSTDv01_isError())\n468\t     dBound (output parameter) : an upper-bound for the decompressed size of the data in the frame\n469\t                                 or ZSTD_CONTENTSIZE_ERROR if an error occurs\n470\t\n471\t    note : assumes `cSize` and `dBound` are _not_ NULL.\n472\t */\n473\tvoid ZSTDv05_findFrameSizeInfoLegacy(const void *src, size_t srcSize,\n474\t                                     size_t* cSize, unsigned long long* dBound);\n475\t\n476\t/* *************************************\n477\t*  Helper functions\n478\t***************************************/\n479\t/* Error Management */\n480\tunsigned    ZSTDv05_isError(size_t code);          /*!< tells if a `size_t` function result is an error code */\n481\tconst char* ZSTDv05_getErrorName(size_t code);     /*!< provides readable string for an error code */\n482\t\n483\t\n484\t/* *************************************\n485\t*  Explicit memory management\n486\t***************************************/\n487\t/** Decompression context */\n488\ttypedef struct ZSTDv05_DCtx_s ZSTDv05_DCtx;\n489\tZSTDv05_DCtx* ZSTDv05_createDCtx(void);\n490\tsize_t ZSTDv05_freeDCtx(ZSTDv05_DCtx* dctx);      /*!< @return : errorCode */\n491\t\n492\t/** ZSTDv05_decompressDCtx() :\n493\t*   Same as ZSTDv05_decompress(), but requires an already allocated ZSTDv05_DCtx (see ZSTDv05_createDCtx()) */\n494\tsize_t ZSTDv05_decompressDCtx(ZSTDv05_DCtx* ctx, void* dst, size_t dstCapacity, const void* src, size_t srcSize);\n495\t\n496\t\n497\t/*-***********************\n498\t*  Simple Dictionary API\n499\t*************************/\n500\t/*! ZSTDv05_decompress_usingDict() :\n501\t*   Decompression using a pre-defined Dictionary content (see dictBuilder).\n502\t*   Dictionary must be identical to the one used during compression, otherwise regenerated data will be corrupted.\n503\t*   Note : dict can be NULL, in which case, it's equivalent to ZSTDv05_decompressDCtx() */\n504\tsize_t ZSTDv05_decompress_usingDict(ZSTDv05_DCtx* dctx,\n505\t                                            void* dst, size_t dstCapacity,\n506\t                                      const void* src, size_t srcSize,\n507\t                                      const void* dict,size_t dictSize);\n508\t\n509\t/*-************************\n510\t*  Advanced Streaming API\n511\t***************************/\n512\ttypedef enum { ZSTDv05_fast, ZSTDv05_greedy, ZSTDv05_lazy, ZSTDv05_lazy2, ZSTDv05_btlazy2, ZSTDv05_opt, ZSTDv05_btopt } ZSTDv05_strategy;\n513\ttypedef struct {\n514\t    U64 srcSize;\n515\t    U32 windowLog;     /* the only useful information to retrieve */\n516\t    U32 contentLog; U32 hashLog; U32 searchLog; U32 searchLength; U32 targetLength; ZSTDv05_strategy strategy;\n517\t} ZSTDv05_parameters;\n518\tsize_t ZSTDv05_getFrameParams(ZSTDv05_parameters* params, const void* src, size_t srcSize);\n519\t\n520\tsize_t ZSTDv05_decompressBegin_usingDict(ZSTDv05_DCtx* dctx, const void* dict, size_t dictSize);\n521\tvoid   ZSTDv05_copyDCtx(ZSTDv05_DCtx* dstDCtx, const ZSTDv05_DCtx* srcDCtx);\n522\tsize_t ZSTDv05_nextSrcSizeToDecompress(ZSTDv05_DCtx* dctx);\n523\tsize_t ZSTDv05_decompressContinue(ZSTDv05_DCtx* dctx, void* dst, size_t dstCapacity, const void* src, size_t srcSize);\n524\t\n525\t\n526\t/*-***********************\n527\t*  ZBUFF API\n528\t*************************/\n529\ttypedef struct ZBUFFv05_DCtx_s ZBUFFv05_DCtx;\n530\tZBUFFv05_DCtx* ZBUFFv05_createDCtx(void);\n531\tsize_t         ZBUFFv05_freeDCtx(ZBUFFv05_DCtx* dctx);\n532\t\n533\tsize_t ZBUFFv05_decompressInit(ZBUFFv05_DCtx* dctx);\n534\tsize_t ZBUFFv05_decompressInitDictionary(ZBUFFv05_DCtx* dctx, const void* dict, size_t dictSize);\n535\t\n536\tsize_t ZBUFFv05_decompressContinue(ZBUFFv05_DCtx* dctx,\n537\t                                            void* dst, size_t* dstCapacityPtr,\n538\t                                      const void* src, size_t* srcSizePtr);\n539\t\n540\t/*-***************************************************************************\n541\t*  Streaming decompression\n542\t*\n543\t*  A ZBUFFv05_DCtx object is required to track streaming operations.\n544\t*  Use ZBUFFv05_createDCtx() and ZBUFFv05_freeDCtx() to create/release resources.\n545\t*  Use ZBUFFv05_decompressInit() to start a new decompression operation,\n546\t*   or ZBUFFv05_decompressInitDictionary() if decompression requires a dictionary.\n547\t*  Note that ZBUFFv05_DCtx objects can be reused multiple times.\n548\t*\n549\t*  Use ZBUFFv05_decompressContinue() repetitively to consume your input.\n550\t*  *srcSizePtr and *dstCapacityPtr can be any size.\n551\t*  The function will report how many bytes were read or written by modifying *srcSizePtr and *dstCapacityPtr.\n552\t*  Note that it may not consume the entire input, in which case it's up to the caller to present remaining input again.\n553\t*  The content of @dst will be overwritten (up to *dstCapacityPtr) at each function call, so save its content if it matters or change @dst.\n554\t*  @return : a hint to preferred nb of bytes to use as input for next function call (it's only a hint, to help latency)\n555\t*            or 0 when a frame is completely decoded\n556\t*            or an error code, which can be tested using ZBUFFv05_isError().\n557\t*\n558\t*  Hint : recommended buffer sizes (not compulsory) : ZBUFFv05_recommendedDInSize() / ZBUFFv05_recommendedDOutSize()\n559\t*  output : ZBUFFv05_recommendedDOutSize==128 KB block size is the internal unit, it ensures it's always possible to write a full block when decoded.\n560\t*  input  : ZBUFFv05_recommendedDInSize==128Kb+3; just follow indications from ZBUFFv05_decompressContinue() to minimize latency. It should always be <= 128 KB + 3 .\n561\t* *******************************************************************************/\n562\t\n563\t\n564\t/* *************************************\n565\t*  Tool functions\n566\t***************************************/\n567\tunsigned ZBUFFv05_isError(size_t errorCode);\n568\tconst char* ZBUFFv05_getErrorName(size_t errorCode);\n569\t\n570\t/** Functions below provide recommended buffer sizes for Compression or Decompression operations.\n571\t*   These sizes are just hints, and tend to offer better latency */\n572\tsize_t ZBUFFv05_recommendedDInSize(void);\n573\tsize_t ZBUFFv05_recommendedDOutSize(void);\n574\t\n575\t\n576\t\n577\t/*-*************************************\n578\t*  Constants\n579\t***************************************/\n580\t#define ZSTDv05_MAGICNUMBER 0xFD2FB525   /* v0.5 */\n581\t\n582\t\n583\t\n584\t\n585\t#if defined (__cplusplus)\n586\t}\n587\t#endif\n588\t\n589\t#endif  /* ZSTDv0505_H */\n590\t=========== zstd_v06.h ===========\n591\t/*\n592\t * Copyright (c) Yann Collet, Meta Platforms, Inc. and affiliates.\n593\t * All rights reserved.\n594\t *\n595\t * This source code is licensed under both the BSD-style license (found in the\n596\t * LICENSE file in the root directory of this source tree) and the GPLv2 (found\n597\t * in the COPYING file in the root directory of this source tree).\n598\t * You may select, at your option, one of the above-listed licenses.\n599\t */\n600\t\n601\t#ifndef ZSTDv06_H\n602\t#define ZSTDv06_H\n603\t\n604\t#if defined (__cplusplus)\n605\textern \"C\" {\n606\t#endif\n607\t\n608\t/*======  Dependency  ======*/\n609\t#include <stddef.h>   /* size_t */\n610\t\n611\t\n612\t/*======  Export for Windows  ======*/\n613\t/*!\n614\t*  ZSTDv06_DLL_EXPORT :\n615\t*  Enable exporting of functions when building a Windows DLL\n616\t*/\n617\t#if defined(_WIN32) && defined(ZSTDv06_DLL_EXPORT) && (ZSTDv06_DLL_EXPORT==1)\n618\t#  define ZSTDLIBv06_API __declspec(dllexport)\n619\t#else\n620\t#  define ZSTDLIBv06_API\n621\t#endif\n622\t\n623\t\n624\t/* *************************************\n625\t*  Simple functions\n626\t***************************************/\n627\t/*! ZSTDv06_decompress() :\n628\t    `compressedSize` : is the _exact_ size of the compressed blob, otherwise decompression will fail.\n629\t    `dstCapacity` must be large enough, equal or larger than originalSize.\n630\t    @return : the number of bytes decompressed into `dst` (<= `dstCapacity`),\n631\t              or an errorCode if it fails (which can be tested using ZSTDv06_isError()) */\n632\tZSTDLIBv06_API size_t ZSTDv06_decompress( void* dst, size_t dstCapacity,\n633\t                                    const void* src, size_t compressedSize);\n634\t\n635\t/**\n636\tZSTDv06_findFrameSizeInfoLegacy() : get the source length and decompressed bound of a ZSTD frame compliant with v0.6.x format\n637\t    srcSize : The size of the 'src' buffer, at least as large as the frame pointed to by 'src'\n638\t    cSize (output parameter)  : the number of bytes that would be read to decompress this frame\n639\t                                or an error code if it fails (which can be tested using ZSTDv01_isError())\n640\t    dBound (output parameter) : an upper-bound for the decompressed size of the data in the frame\n641\t                                or ZSTD_CONTENTSIZE_ERROR if an error occurs\n642\t\n643\t    note : assumes `cSize` and `dBound` are _not_ NULL.\n644\t*/\n645\tvoid ZSTDv06_findFrameSizeInfoLegacy(const void *src, size_t srcSize,\n646\t                                     size_t* cSize, unsigned long long* dBound);\n647\t\n648\t/* *************************************\n649\t*  Helper functions\n650\t***************************************/\n651\tZSTDLIBv06_API size_t      ZSTDv06_compressBound(size_t srcSize); /*!< maximum compressed size (worst case scenario) */\n652\t\n653\t/* Error Management */\n654\tZSTDLIBv06_API unsigned    ZSTDv06_isError(size_t code);          /*!< tells if a `size_t` function result is an error code */\n655\tZSTDLIBv06_API const char* ZSTDv06_getErrorName(size_t code);     /*!< provides readable string for an error code */\n656\t\n657\t\n658\t/* *************************************\n659\t*  Explicit memory management\n660\t***************************************/\n661\t/** Decompression context */\n662\ttypedef struct ZSTDv06_DCtx_s ZSTDv06_DCtx;\n663\tZSTDLIBv06_API ZSTDv06_DCtx* ZSTDv06_createDCtx(void);\n664\tZSTDLIBv06_API size_t     ZSTDv06_freeDCtx(ZSTDv06_DCtx* dctx);      /*!< @return : errorCode */\n665\t\n666\t/** ZSTDv06_decompressDCtx() :\n667\t*   Same as ZSTDv06_decompress(), but requires an already allocated ZSTDv06_DCtx (see ZSTDv06_createDCtx()) */\n668\tZSTDLIBv06_API size_t ZSTDv06_decompressDCtx(ZSTDv06_DCtx* ctx, void* dst, size_t dstCapacity, const void* src, size_t srcSize);\n669\t\n670\t\n671\t/*-***********************\n672\t*  Dictionary API\n673\t*************************/\n674\t/*! ZSTDv06_decompress_usingDict() :\n675\t*   Decompression using a pre-defined Dictionary content (see dictBuilder).\n676\t*   Dictionary must be identical to the one used during compression, otherwise regenerated data will be corrupted.\n677\t*   Note : dict can be NULL, in which case, it's equivalent to ZSTDv06_decompressDCtx() */\n678\tZSTDLIBv06_API size_t ZSTDv06_decompress_usingDict(ZSTDv06_DCtx* dctx,\n679\t                                                   void* dst, size_t dstCapacity,\n680\t                                             const void* src, size_t srcSize,\n681\t                                             const void* dict,size_t dictSize);\n682\t\n683\t\n684\t/*-************************\n685\t*  Advanced Streaming API\n686\t***************************/\n687\tstruct ZSTDv06_frameParams_s { unsigned long long frameContentSize; unsigned windowLog; };\n688\ttypedef struct ZSTDv06_frameParams_s ZSTDv06_frameParams;\n689\t\n690\tZSTDLIBv06_API size_t ZSTDv06_getFrameParams(ZSTDv06_frameParams* fparamsPtr, const void* src, size_t srcSize);   /**< doesn't consume input */\n691\tZSTDLIBv06_API size_t ZSTDv06_decompressBegin_usingDict(ZSTDv06_DCtx* dctx, const void* dict, size_t dictSize);\n692\tZSTDLIBv06_API void   ZSTDv06_copyDCtx(ZSTDv06_DCtx* dctx, const ZSTDv06_DCtx* preparedDCtx);\n693\t\n694\tZSTDLIBv06_API size_t ZSTDv06_nextSrcSizeToDecompress(ZSTDv06_DCtx* dctx);\n695\tZSTDLIBv06_API size_t ZSTDv06_decompressContinue(ZSTDv06_DCtx* dctx, void* dst, size_t dstCapacity, const void* src, size_t srcSize);\n696\t\n697\t\n698\t\n699\t/* *************************************\n700\t*  ZBUFF API\n701\t***************************************/\n702\t\n703\ttypedef struct ZBUFFv06_DCtx_s ZBUFFv06_DCtx;\n704\tZSTDLIBv06_API ZBUFFv06_DCtx* ZBUFFv06_createDCtx(void);\n705\tZSTDLIBv06_API size_t         ZBUFFv06_freeDCtx(ZBUFFv06_DCtx* dctx);\n706\t\n707\tZSTDLIBv06_API size_t ZBUFFv06_decompressInit(ZBUFFv06_DCtx* dctx);\n708\tZSTDLIBv06_API size_t ZBUFFv06_decompressInitDictionary(ZBUFFv06_DCtx* dctx, const void* dict, size_t dictSize);\n709\t\n710\tZSTDLIBv06_API size_t ZBUFFv06_decompressContinue(ZBUFFv06_DCtx* dctx,\n711\t                                                  void* dst, size_t* dstCapacityPtr,\n712\t                                            const void* src, size_t* srcSizePtr);\n713\t\n714\t/*-***************************************************************************\n715\t*  Streaming decompression howto\n716\t*\n717\t*  A ZBUFFv06_DCtx object is required to track streaming operations.\n718\t*  Use ZBUFFv06_createDCtx() and ZBUFFv06_freeDCtx() to create/release resources.\n719\t*  Use ZBUFFv06_decompressInit() to start a new decompression operation,\n720\t*   or ZBUFFv06_decompressInitDictionary() if decompression requires a dictionary.\n721\t*  Note that ZBUFFv06_DCtx objects can be re-init multiple times.\n722\t*\n723\t*  Use ZBUFFv06_decompressContinue() repetitively to consume your input.\n724\t*  *srcSizePtr and *dstCapacityPtr can be any size.\n725\t*  The function will report how many bytes were read or written by modifying *srcSizePtr and *dstCapacityPtr.\n726\t*  Note that it may not consume the entire input, in which case it's up to the caller to present remaining input again.\n727\t*  The content of `dst` will be overwritten (up to *dstCapacityPtr) at each function call, so save its content if it matters, or change `dst`.\n728\t*  @return : a hint to preferred nb of bytes to use as input for next function call (it's only a hint, to help latency),\n729\t*            or 0 when a frame is completely decoded,\n730\t*            or an error code, which can be tested using ZBUFFv06_isError().\n731\t*\n732\t*  Hint : recommended buffer sizes (not compulsory) : ZBUFFv06_recommendedDInSize() and ZBUFFv06_recommendedDOutSize()\n733\t*  output : ZBUFFv06_recommendedDOutSize== 128 KB block size is the internal unit, it ensures it's always possible to write a full block when decoded.\n734\t*  input  : ZBUFFv06_recommendedDInSize == 128KB + 3;\n735\t*           just follow indications from ZBUFFv06_decompressContinue() to minimize latency. It should always be <= 128 KB + 3 .\n736\t* *******************************************************************************/\n737\t\n738\t\n739\t/* *************************************\n740\t*  Tool functions\n741\t***************************************/\n742\tZSTDLIBv06_API unsigned ZBUFFv06_isError(size_t errorCode);\n743\tZSTDLIBv06_API const char* ZBUFFv06_getErrorName(size_t errorCode);\n744\t\n745\t/** Functions below provide recommended buffer sizes for Compression or Decompression operations.\n746\t*   These sizes are just hints, they tend to offer better latency */\n747\tZSTDLIBv06_API size_t ZBUFFv06_recommendedDInSize(void);\n748\tZSTDLIBv06_API size_t ZBUFFv06_recommendedDOutSize(void);\n749\t\n750\t\n751\t/*-*************************************\n752\t*  Constants\n753\t***************************************/\n754\t#define ZSTDv06_MAGICNUMBER 0xFD2FB526   /* v0.6 */\n755\t\n756\t\n757\t\n758\t#if defined (__cplusplus)\n759\t}\n760\t#endif\n761\t\n762\t#endif  /* ZSTDv06_BUFFERED_H */\n763\t=========== zstd_v07.h ===========\n764\t/*\n765\t * Copyright (c) Yann Collet, Meta Platforms, Inc. and affiliates.\n766\t * All rights reserved.\n767\t *\n768\t * This source code is licensed under both the BSD-style license (found in the\n769\t * LICENSE file in the root directory of this source tree) and the GPLv2 (found\n770\t * in the COPYING file in the root directory of this source tree).\n771\t * You may select, at your option, one of the above-listed licenses.\n772\t */\n773\t\n774\t#ifndef ZSTDv07_H_235446\n775\t#define ZSTDv07_H_235446\n776\t\n777\t#if defined (__cplusplus)\n778\textern \"C\" {\n779\t#endif\n780\t\n781\t/*======  Dependency  ======*/\n782\t#include <stddef.h>   /* size_t */\n783\t\n784\t\n785\t/*======  Export for Windows  ======*/\n786\t/*!\n787\t*  ZSTDv07_DLL_EXPORT :\n788\t*  Enable exporting of functions when building a Windows DLL\n789\t*/\n790\t#if defined(_WIN32) && defined(ZSTDv07_DLL_EXPORT) && (ZSTDv07_DLL_EXPORT==1)\n791\t#  define ZSTDLIBv07_API __declspec(dllexport)\n792\t#else\n793\t#  define ZSTDLIBv07_API\n794\t#endif\n795\t\n796\t\n797\t/* *************************************\n798\t*  Simple API\n799\t***************************************/\n800\t/*! ZSTDv07_getDecompressedSize() :\n801\t*   @return : decompressed size if known, 0 otherwise.\n802\t       note 1 : if `0`, follow up with ZSTDv07_getFrameParams() to know precise failure cause.\n803\t       note 2 : decompressed size could be wrong or intentionally modified !\n804\t                always ensure results fit within application's authorized limits */\n805\tunsigned long long ZSTDv07_getDecompressedSize(const void* src, size_t srcSize);\n806\t\n807\t/*! ZSTDv07_decompress() :\n808\t    `compressedSize` : must be _exact_ size of compressed input, otherwise decompression will fail.\n809\t    `dstCapacity` must be equal or larger than originalSize.\n810\t    @return : the number of bytes decompressed into `dst` (<= `dstCapacity`),\n811\t              or an errorCode if it fails (which can be tested using ZSTDv07_isError()) */\n812\tZSTDLIBv07_API size_t ZSTDv07_decompress( void* dst, size_t dstCapacity,\n813\t                                    const void* src, size_t compressedSize);\n814\t\n815\t/**\n816\tZSTDv07_findFrameSizeInfoLegacy() : get the source length and decompressed bound of a ZSTD frame compliant with v0.7.x format\n817\t    srcSize : The size of the 'src' buffer, at least as large as the frame pointed to by 'src'\n818\t    cSize (output parameter)  : the number of bytes that would be read to decompress this frame\n819\t                                or an error code if it fails (which can be tested using ZSTDv01_isError())\n820\t    dBound (output parameter) : an upper-bound for the decompressed size of the data in the frame\n821\t                                or ZSTD_CONTENTSIZE_ERROR if an error occurs\n822\t\n823\t    note : assumes `cSize` and `dBound` are _not_ NULL.\n824\t*/\n825\tvoid ZSTDv07_findFrameSizeInfoLegacy(const void *src, size_t srcSize,\n826\t                                     size_t* cSize, unsigned long long* dBound);\n827\t\n828\t/*======  Helper functions  ======*/\n829\tZSTDLIBv07_API unsigned    ZSTDv07_isError(size_t code);          /*!< tells if a `size_t` function result is an error code */\n830\tZSTDLIBv07_API const char* ZSTDv07_getErrorName(size_t code);     /*!< provides readable string from an error code */\n831\t\n832\t\n833\t/*-*************************************\n834\t*  Explicit memory management\n835\t***************************************/\n836\t/** Decompression context */\n837\ttypedef struct ZSTDv07_DCtx_s ZSTDv07_DCtx;\n838\tZSTDLIBv07_API ZSTDv07_DCtx* ZSTDv07_createDCtx(void);\n839\tZSTDLIBv07_API size_t     ZSTDv07_freeDCtx(ZSTDv07_DCtx* dctx);      /*!< @return : errorCode */\n840\t\n841\t/** ZSTDv07_decompressDCtx() :\n842\t*   Same as ZSTDv07_decompress(), requires an allocated ZSTDv07_DCtx (see ZSTDv07_createDCtx()) */\n843\tZSTDLIBv07_API size_t ZSTDv07_decompressDCtx(ZSTDv07_DCtx* ctx, void* dst, size_t dstCapacity, const void* src, size_t srcSize);\n844\t\n845\t\n846\t/*-************************\n847\t*  Simple dictionary API\n848\t***************************/\n849\t/*! ZSTDv07_decompress_usingDict() :\n850\t*   Decompression using a pre-defined Dictionary content (see dictBuilder).\n851\t*   Dictionary must be identical to the one used during compression.\n852\t*   Note : This function load the dictionary, resulting in a significant startup time */\n853\tZSTDLIBv07_API size_t ZSTDv07_decompress_usingDict(ZSTDv07_DCtx* dctx,\n854\t                                                   void* dst, size_t dstCapacity,\n855\t                                             const void* src, size_t srcSize,\n856\t                                             const void* dict,size_t dictSize);\n857\t\n858\t\n859\t/*-**************************\n860\t*  Advanced Dictionary API\n861\t****************************/\n862\t/*! ZSTDv07_createDDict() :\n863\t*   Create a digested dictionary, ready to start decompression operation without startup delay.\n864\t*   `dict` can be released after creation */\n865\ttypedef struct ZSTDv07_DDict_s ZSTDv07_DDict;\n866\tZSTDLIBv07_API ZSTDv07_DDict* ZSTDv07_createDDict(const void* dict, size_t dictSize);\n867\tZSTDLIBv07_API size_t      ZSTDv07_freeDDict(ZSTDv07_DDict* ddict);\n868\t\n869\t/*! ZSTDv07_decompress_usingDDict() :\n870\t*   Decompression using a pre-digested Dictionary\n871\t*   Faster startup than ZSTDv07_decompress_usingDict(), recommended when same dictionary is used multiple times. */\n872\tZSTDLIBv07_API size_t ZSTDv07_decompress_usingDDict(ZSTDv07_DCtx* dctx,\n873\t                                                    void* dst, size_t dstCapacity,\n874\t                         