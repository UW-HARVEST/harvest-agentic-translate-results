{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_l7mrmeli5sagat6ahv54t5s7zcren33t6ar5fyahemgt3mxt5ynq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01WwPJ3YGW1Yka5X7hRVbK15","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-KufEFj/translated_rust/tests/phase_b_shapes_internals.rs","content":"//! PHASE B — Part 7 (CONFIGS.md rows 107-120).\n//!\n//! Four tiers are exercised here, all differentially (C `.so` vs Rust `.so`):\n//!   PART 1  input SHAPES x every size / frame-header boundary\n//!   PART 2  the sequence-level API (generate / merge / compressSequences)\n//!   PART 3  the static / preallocated tier (estimate* + initStatic*)\n//!   PART 4  the ZSTD_CCtx_params tier\n//!   PART 5  exported low-level compress & decompress internals\n#![allow(non_snake_case, non_upper_case_globals, dead_code)]\n\nmod common;\nuse common::*;\nuse libloading::Symbol;\nuse std::ffi::c_void;\n\n// ============================================================ small utilities\n\nfn ok(r: usize) -> bool {\n    !is_error(r)\n}\n\n/// 8-byte aligned scratch buffer of at least `nbytes` bytes.\nfn wksp(nbytes: usize) -> Vec<u64> {\n    vec![0u64; nbytes / 8 + 2]\n}\n\nfn as_ptr_c<T>(v: &[T]) -> *const c_void {\n    v.as_ptr() as *const c_void\n}\n\nfn as_ptr_m<T>(v: &mut [T]) -> *mut c_void {\n    v.as_mut_ptr() as *mut c_void\n}\n\n#[derive(Clone, Copy, Debug, PartialEq, Eq)]\nenum DictMode {\n    None,\n    Load,\n    Prefix,\n}\n\n// ------------------------------------------------------------ compress drivers\n\nfn comp2(api: &Api, params: &[(i32, i32)], pledged: Option<u64>, src: &[u8]) -> Out {\n    unsafe {\n        let cctx = (api.createCCtx)();\n        assert!(!cctx.is_null());\n        for &(p, v) in params {\n            let r = (api.setParameter)(cctx, p, v);\n            if is_error(r) {\n                (api.freeCCtx)(cctx);\n                return Out::err(r);\n            }\n        }\n        if let Some(ps) = pledged {\n            let r = (api.setPledgedSrcSize)(cctx, ps);\n            if is_error(r) {\n                (api.freeCCtx)(cctx);\n                return Out::err(r);\n            }\n        }\n        let cap = (api.compressBound)(src.len()) + 128;\n        let mut buf = vec![0u8; cap];\n        let ret = (api.compress2)(cctx, as_ptr_m(&mut buf), cap, as_ptr_c(src), src.len());\n        (api.freeCCtx)(cctx);\n        Out::ok(ret, &buf)\n    }\n}\n\nfn comp2_dict(\n    api: &Api,\n    params: &[(i32, i32)],\n    dict: &[u8],\n    mode: DictMode,\n    src: &[u8],\n) -> Out {\n    unsafe {\n        let cctx = (api.createCCtx)();\n        assert!(!cctx.is_null());\n        for &(p, v) in params {\n            let r = (api.setParameter)(cctx, p, v);\n            if is_error(r) {\n                (api.freeCCtx)(cctx);\n                return Out::err(r);\n            }\n        }\n        let dr = match mode {\n            DictMode::None => 0,\n            DictMode::Load => (api.loadDictionary)(cctx, as_ptr_c(dict), dict.len()),\n            DictMode::Prefix => (api.refPrefix)(cctx, as_ptr_c(dict), dict.len()),\n        };\n        if is_error(dr) {\n            (api.freeCCtx)(cctx);\n            return Out::err(dr);\n        }\n        let cap = (api.compressBound)(src.len()) + 128;\n        let mut buf = vec![0u8; cap];\n        let ret = (api.compress2)(cctx, as_ptr_m(&mut buf), cap, as_ptr_c(src), src.len());\n        (api.freeCCtx)(cctx);\n        Out::ok(ret, &buf)\n    }\n}\n\nfn comp_simple(api: &Api, level: i32, src: &[u8]) -> Out {\n    unsafe {\n        let cap = (api.compressBound)(src.len()) + 128;\n        let mut buf = vec![0u8; cap];\n        let ret = (api.compress)(as_ptr_m(&mut buf), cap, as_ptr_c(src), src.len(), level);\n        Out::ok(ret, &buf)\n    }\n}\n\nfn decomp(api: &Api, frame: &[u8], cap: usize) -> Out {\n    unsafe {\n        let dctx = (api.createDCtx)();\n        assert!(!dctx.is_null());\n        let mut buf = vec![0u8; cap + 64];\n        let n = buf.len();\n        let ret = (api.decompressDCtx)(dctx, as_ptr_m(&mut buf), n, as_ptr_c(frame), frame.len());\n        (api.freeDCtx)(dctx);\n        Out::ok(ret, &buf)\n    }\n}\n\nfn decomp_dict(api: &Api, frame: &[u8], dict: &[u8], mode: DictMode, cap: usize) -> Out {\n    unsafe {\n        let dctx = (api.createDCtx)();\n        assert!(!dctx.is_null());\n        let dr = match mode {\n            DictMode::None => 0,\n            DictMode::Load => (api.dLoadDictionary)(dctx, as_ptr_c(dict), dict.len()),\n            DictMode::Prefix => (api.dRefPrefix)(dctx, as_ptr_c(dict), dict.len()),\n        };\n        if is_error(dr) {\n            (api.freeDCtx)(dctx);\n            return Out::err(dr);\n        }\n        let mut buf = vec![0u8; cap + 64];\n        let n = buf.len();\n        let ret = (api.decompressDCtx)(dctx, as_ptr_m(&mut buf), n, as_ptr_c(frame), frame.len());\n        (api.freeDCtx)(dctx);\n        Out::ok(ret, &buf)\n    }\n}\n\n/// Assert two `Out` values agree; render a useful message otherwise.\nfn same_out(ctx: &str, c: &Out, r: &Out) {\n    if c.ret != r.ret {\n        panic!(\n            \"{ctx}: return differs: C={} (err={},code={}) Rust={} (err={},code={})\",\n            c.ret,\n            is_error(c.ret),\n            err_code(c.ret),\n            r.ret,\n            is_error(r.ret),\n            err_code(r.ret)\n        );\n    }\n    assert_bytes_eq(ctx, &c.bytes, &r.bytes);\n}\n\n/// Compress with both libs, require byte identity, then round-trip in both libs.\nfn check_frame(ctx: &str, params: &[(i32, i32)], pledged: Option<u64>, src: &[u8]) {\n    let c = comp2(capi(), params, pledged, src);\n    let r = comp2(rapi(), params, pledged, src);\n    same_out(ctx, &c, &r);\n    if ok(c.ret) {\n        for api in [capi(), rapi()] {\n            let d = decomp(api, &c.bytes, src.len());\n            assert!(\n                ok(d.ret),\n                \"{ctx}: {} decompress failed: {} ({})\",\n                api.tag,\n                err_code(d.ret),\n                err_name(api.lib, d.ret)\n            );\n            assert_eq!(d.ret, src.len(), \"{ctx}: {} decompressed size\", api.tag);\n            assert_bytes_eq(&format!(\"{ctx}/roundtrip[{}]\", api.tag), src, &d.bytes);\n        }\n    }\n}\n\nfn check_frame_dict(\n    ctx: &str,\n    params: &[(i32, i32)],\n    dict: &[u8],\n    mode: DictMode,\n    src: &[u8],\n) {\n    let c = comp2_dict(capi(), params, dict, mode, src);\n    let r = comp2_dict(rapi(), params, dict, mode, src);\n    same_out(ctx, &c, &r);\n    if ok(c.ret) {\n        for api in [capi(), rapi()] {\n            let d = decomp_dict(api, &c.bytes, dict, mode, src.len());\n            assert!(\n                ok(d.ret),\n                \"{ctx}: {} decompress failed: {} ({})\",\n                api.tag,\n                err_code(d.ret),\n                err_name(api.lib, d.ret)\n            );\n            assert_bytes_eq(&format!(\"{ctx}/roundtrip[{}]\", api.tag), src, &d.bytes);\n        }\n    }\n}\n\n// ============================================================================\n// PART 1 — CONFIGS rows 107-115: input shapes at every boundary\n// ============================================================================\n\nconst MICRO_SIZES: &[usize] = &[0, 1, 2, 3, 7, 8, 9, 25, 26, 127, 128, 129, 1023, 1024, 1025];\nconst LEVELS: &[i32] = &[-5, 1, 3, 9, 19, 22];\n\n#[test]\nfn p1_row107_micro_size_sweep_all_shapes_all_levels() {\n    for &shape in ALL_SHAPES {\n        for &len in MICRO_SIZES {\n            let mut rng = Rng::new(0xA5A5_0000 ^ len as u64);\n            let src = gen(shape, len, &mut rng);\n            assert_eq!(src.len(), len);\n            for &lvl in LEVELS {\n                let ctx = format!(\"row107 compress2 shape={shape:?} len={len} L={lvl}\");\n                check_frame(&ctx, &[(ZSTD_c_compressionLevel, lvl)], None, &src);\n            }\n        }\n    }\n}\n\n#[test]\nfn p1_row107_micro_size_sweep_plain_compress() {\n    for &shape in ALL_SHAPES {\n        for &len in MICRO_SIZES {\n            let mut rng = Rng::new(0xB6B6_0000 ^ len as u64);\n            let src = gen(shape, len, &mut rng);\n            for &lvl in LEVELS {\n                let ctx = format!(\"row107 ZSTD_compress shape={shape:?} len={len} L={lvl}\");\n                let c = comp_simple(capi(), lvl, &src);\n                let r = comp_simple(rapi(), lvl, &src);\n                same_out(&ctx, &c, &r);\n                if ok(c.ret) {\n                    for api in [capi(), rapi()] {\n                        let d = decomp(api, &c.bytes, src.len());\n                        assert!(ok(d.ret), \"{ctx}: {} decompress err\", api.tag);\n                        assert_bytes_eq(&ctx, &src, &d.bytes);\n                    }\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn p1_row108_block_boundary_sweep() {\n    // 131071 / 131072 / 131073 straddle ZSTD_BLOCKSIZE_MAX (single vs multi block),\n    // 262144 / 262145 straddle 2 * ZSTD_BLOCKSIZE_MAX.\n    let big: &[usize] = &[\n        ZSTD_BLOCKSIZE_MAX - 1,\n        ZSTD_BLOCKSIZE_MAX,\n        ZSTD_BLOCKSIZE_MAX + 1,\n        2 * ZSTD_BLOCKSIZE_MAX,\n        2 * ZSTD_BLOCKSIZE_MAX + 1,\n        300_000,\n    ];\n    for &shape in ALL_SHAPES {\n        for &len in big {\n            let mut rng = Rng::new(0xC7C7_0000 ^ len as u64);\n            let src = gen(shape, len, &mut rng);\n            // Keep the very slow levels off the biggest inputs.\n            let levels: &[i32] = if len <= ZSTD_BLOCKSIZE_MAX + 1 {\n                &[-5, 1, 3, 9, 19, 22]\n            } else {\n                &[-5, 1, 3, 9]\n            };\n            for &lvl in levels {\n                let ctx = format!(\"row108 shape={shape:?} len={len} L={lvl}\");\n                check_frame(&ctx, &[(ZSTD_c_compressionLevel, lvl)], None, &src);\n            }\n        }\n    }\n}\n\n#[test]\nfn p1_row109_rle_boundary_25_26() {\n    // rleMaxLength == 25: a block whose compressed size is < 25 can become bt_rle,\n    // but never for the FIRST block of a frame (`!isFirstBlock`).  Everything here\n    // is verified purely differentially, so the rule is checked implicitly.\n    for &len in &[1usize, 6, 7, 24, 25, 26, 27, 1024, ZSTD_BLOCKSIZE_MAX, 300_000] {\n        for b in [0u8, 1, 0x41, 0xff] {\n            let src = vec![b; len];\n            for &lvl in &[-5i32, 1, 3, 9, 19, 22] {\n                if len > ZSTD_BLOCKSIZE_MAX && lvl > 9 {\n                    continue;\n                }\n                let ctx = format!(\"row109 rle byte={b} len={len} L={lvl}\");\n                check_frame(&ctx, &[(ZSTD_c_compressionLevel, lvl)], None, &src);\n            }\n        }\n    }\n    // Multi-block RLE with a tiny maxBlockSize forces many non-first blocks, so the\n    // bt_rle path is definitely taken.\n    for &mbs in &[1024i32, 4096, 65536] {\n        for &len in &[2048usize, 5000, 131072, 300_000] {\n            let src = vec![0x5Au8; len];\n            let ctx = format!(\"row109 rle maxBlockSize={mbs} len={len}\");\n            check_frame(\n                &ctx,\n                &[(ZSTD_c_compressionLevel, 3), (ZSTD_c_maxBlockSize, mbs)],\n                None,\n                &src,\n            );\n        }\n    }\n}\n\n#[test]\nfn p1_row115_window_log_10_wrap() {\n    // windowLog pinned to its minimum (1 KB window): 1025+ bytes force the window\n    // to wrap, and 2048/5000 force ZSTD_window_enforceMaxDist / overflow handling.\n    for &shape in ALL_SHAPES {\n        for &len in &[1023usize, 1024, 1025, 2048, 5000] {\n            let mut rng = Rng::new(0xD8D8_0000 ^ len as u64);\n            let src = gen(shape, len, &mut rng);\n            for &lvl in &[-5i32, 1, 3, 9, 19, 22] {\n                let ctx = format!(\"row115 wLog=10 shape={shape:?} len={len} L={lvl}\");\n                check_frame(\n                    &ctx,\n                    &[(ZSTD_c_compressionLevel, lvl), (ZSTD_c_windowLog, 10)],\n                    None,\n                    &src,\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn p1_row115_around_window_size_and_single_segment() {\n    // (1<<wl)-1 / 1<<wl / (1<<wl)+1 / 3<<wl for small window logs, plus a very\n    // large window with a small input => singleSegment frames.\n    for &wl in &[10u32, 12, 14] {\n        let w = 1usize << wl;\n        for &len in &[w - 1, w, w + 1, 3 * w] {\n            for &shape in &[Shape::Text, Shape::Records, Shape::Random, Shape::Rle] {\n                let mut rng = Rng::new(0xE9E9_0000 ^ len as u64);\n                let src = gen(shape, len, &mut rng);\n                for &lvl in &[1i32, 3, 19] {\n                    let ctx = format!(\"row115 wl={wl} shape={shape:?} len={len} L={lvl}\");\n                    check_frame(\n                        &ctx,\n                        &[(ZSTD_c_compressionLevel, lvl), (ZSTD_c_windowLog, wl as i32)],\n                        None,\n                        &src,\n                    );\n                }\n            }\n        }\n    }\n    // singleSegment: window much larger than src, content size known.\n    for &wl in &[17i32, 20, 27] {\n        for &len in &[1usize, 7, 26, 1000, 65536, 200_000] {\n            for &shape in &[Shape::Text, Shape::Rle] {\n                let mut rng = Rng::new(0xFAFA_0000 ^ len as u64);\n                let src = gen(shape, len, &mut rng);\n                let ctx = format!(\"row115 singleSegment wl={wl} shape={shape:?} len={len}\");\n                check_frame(\n                    &ctx,\n                    &[\n                        (ZSTD_c_compressionLevel, 3),\n                        (ZSTD_c_windowLog, wl),\n                        (ZSTD_c_contentSizeFlag, 1),\n                    ],\n                    Some(len as u64),\n                    &src,\n                );\n            }\n        }\n    }\n}\n\n#[test]\nfn p1_row114_fcs_field_widths() {\n    // frameContentSize field is 0 / 1 / 2 / 4 / 8 bytes wide depending on the value.\n    // 255|256 straddle the 1-byte form, 65791|65792 the 2-byte form.\n    for &n in &[0usize, 1, 255, 256, 65535, 65791, 65792, 70000] {\n        for &shape in &[Shape::Text, Shape::Random, Shape::Rle] {\n            let mut rng = Rng::new(0x1234_0000 ^ n as u64);\n            let src = gen(shape, n, &mut rng);\n            for &csf in &[0i32, 1] {\n                for &cks in &[0i32, 1] {\n                    let ctx = format!(\n                        \"row114 fcs shape={shape:?} n={n} contentSizeFlag={csf} checksum={cks}\"\n                    );\n                    check_frame(\n                        &ctx,\n                        &[\n                            (ZSTD_c_compressionLevel, 3),\n                            (ZSTD_c_contentSizeFlag, csf),\n                            (ZSTD_c_checksumFlag, cks),\n                        ],\n                        Some(n as u64),\n                        &src,\n                    );\n                    // and with a large window so the frame is single-segment\n                    let ctx2 = format!(\"{ctx} +wl=27\");\n                    check_frame(\n                        &ctx2,\n                        &[\n                            (ZSTD_c_compressionLevel, 3),\n                            (ZSTD_c_contentSizeFlag, csf),\n                            (ZSTD_c_checksumFlag, cks),\n                            (ZSTD_c_windowLog, 27),\n                        ],\n                        Some(n as u64),\n                        &src,\n                    );\n                }\n            }\n        }\n    }\n    // A pledged size that does not match the real one must fail identically.\n    let mut rng = Rng::new(9);\n    let src = gen(Shape::Text, 1000, &mut rng);\n    for &pledged in &[0u64, 1, 999, 1001, 65792, 1u64 << 32, u64::MAX - 1] {\n        let ctx = format!(\"row114 mismatched pledgedSrcSize={pledged}\");\n        let c = comp2(capi(), &[(ZSTD_c_compressionLevel, 3)], Some(pledged), &src);\n        let r = comp2(rapi(), &[(ZSTD_c_compressionLevel, 3)], Some(pledged), &src);\n        same_out(&ctx, &c, &r);\n    }\n}\n\n#[test]\nfn p1_row114_eight_byte_fcs_via_streaming() {\n    // The only way to observe the 8-byte fcs field without a 4 GB buffer: pledge a\n    // huge size, stream a little data, flush, and compare the emitted header bytes.\n    fn head(api: &Api, pledged: u64, src: &[u8]) -> Out {\n        unsafe {\n            let cctx = (api.createCCtx)();\n            let mut ret = (api.setParameter)(cctx, ZSTD_c_compressionLevel, 3);\n            assert!(ok(ret));\n            ret = (api.setPledgedSrcSize)(cctx, pledged);\n            if is_error(ret) {\n                (api.freeCCtx)(cctx);\n                return Out::err(ret);\n            }\n            let mut buf = vec![0u8; 1 << 16];\n            let mut outb = ZSTD_outBuffer {\n                dst: buf.as_mut_ptr() as *mut c_void,\n                size: buf.len(),\n                pos: 0,\n            };\n            let mut inb = ZSTD_inBuffer {\n                src: src.as_ptr() as *const c_void,\n                size: src.len(),\n                pos: 0,\n            };\n            let r = (api.compressStream2)(cctx, &mut outb, &mut inb, ZSTD_e_flush);\n            (api.freeCCtx)(cctx);\n            if is_error(r) {\n                return Out::err(r);\n            }\n            Out::ok(outb.pos, &buf)\n        }\n    }\n    let mut rng = Rng::new(0x8888);\n    let src = gen(Shape::Text, 4096, &mut rng);\n    for &pledged in &[\n        0u64,\n        1,\n        255,\n        256,\n        65535,\n        65791,\n        65792,\n        1u64 << 32,\n        (1u64 << 32) + 1,\n        u64::MAX - 2,\n    ] {\n        let ctx = format!(\"row114 streaming header pledged={pledged}\");\n        let c = head(capi(), pledged, &src);\n        let r = head(rapi(), pledged, &src);\n        same_out(&ctx, &c, &r);\n    }\n}\n\n#[test]\nfn p1_row117_dictionary_size_sweep() {\n    let dict_sizes: &[usize] = &[0, 1, 7, 8, 256, 1024, 128 * 1024, 200_000];\n    let mut drng = Rng::new(0x0D1C_7000);\n    for &ds in dict_sizes {\n        // A raw-content dictionary built from text so it actually helps.\n        let dict = gen(Shape::Text, ds, &mut drng);\n        for &sl in &[5000usize, 70_000] {\n            let mut rng = Rng::new(0x5EED_0001 ^ sl as u64);\n            let src = gen(Shape::Text, sl, &mut rng);\n            for &lvl in &[1i32, 3, 19] {\n                for mode in [DictMode::Load, DictMode::Prefix] {\n                    let ctx =\n                        format!(\"row117 dictSize={ds} srcLen={sl} L={lvl} mode={mode:?}\");\n                    check_frame_dict(\n                        &ctx,\n                        &[(ZSTD_c_compressionLevel, lvl)],\n                        &dict,\n                        mode,\n                        &src,\n                    );\n                }\n            }\n        }\n    }\n}\n\n#[test]\nfn p1_row110_113_shape_mix_and_incompressible() {\n    // All three block types in one frame + explicit incompressible inputs.\n    let mut rng = Rng::new(0x0BAD_BEEF);\n    let mut mixed = Vec::new();\n    mixed.extend_from_slice(&gen(Shape::Text, 65536, &mut rng));\n    mixed.extend_from_slice(&gen(Shape::Random, 65536, &mut rng));\n    mixed.extend_from_slice(&vec![0x7u8; 65536]);\n    for &lvl in &[-5i32, 1, 3, 9, 19] {\n        check_frame(\n            &format!(\"row113 mixed L={lvl}\"),\n            &[(ZSTD_c_compressionLevel, lvl)],\n            None,\n            &mixed,\n        );\n    }\n    for &len in &[100usize, ZSTD_BLOCKSIZE_MAX, 300_000] {\n        let src = gen(Shape::Random, len, &mut rng);\n        for &lvl in &[1i32, 19] {\n            check_frame(\n                &format!(\"row110 random len={len} L={lvl}\"),\n                &[(ZSTD_c_compressionLevel, lvl)],\n                None,\n                &src,\n            );\n        }\n    }\n    // match-heavy: a 4-byte unit repeated, crossing the 1/2/3-byte nbSeq header widths\n    for &len in &[512usize, 1024, 300_000] {\n        let mut src = Vec::with_capacity(len);\n        while src.len() < len {\n            src.extend_from_slice(b\"abcd\");\n        }\n        src.truncate(len);\n        for &lvl in &[1i32, 3, 19] {\n            check_frame(\n                &format!(\"row112 4-byte-unit len={len} L={lvl}\"),\n                &[(ZSTD_c_compressionLevel, lvl)],\n                None,\n                &src,\n            );\n        }\n    }\n    // literal-only (nbSeq == 0) with minMatch pushed to its maximum\n    for &mm in &[3i32, 5, 7] {\n        let src = gen(Shape::Random, 65536, &mut rng);\n        check_frame(\n            &format!(\"row111 literal-only minMatch={mm}\"),\n            &[(ZSTD_c_compressionLevel, 3), (ZSTD_c_minMatch, mm)],\n            None,\n            &src,\n        );\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3821,"cache_read_input_tokens":128385,"cache_creation":{"ephemeral_5m_input_tokens":3821,"ephemeral_1h_input_tokens":0},"output_tokens":17,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":"toolu_bdrk_01QKsbugUYA2Tb4JkuQ6tX77","session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"4ca7666c-9097-46a1-b2c6-af7259e2dde3","timestamp":"2026-08-14T21:53:04.786Z","subagent_type":"general-purpose","task_description":"Write shapes and internals tests"}
