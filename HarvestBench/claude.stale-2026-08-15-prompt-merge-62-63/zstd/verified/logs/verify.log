{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014FKqQ5nJjFRYMEVdFyF51C","type":"tool_result","content":"1\t//! Differential-test harness: loads the C `.so` and the Rust `.so` side by side\n2\t//! via `libloading` and calls BOTH only through their exported C symbols.\n3\t//!\n4\t//! Nothing in here ever links against the Rust crate directly — every Rust call\n5\t//! goes through `dlopen`/`dlsym` on `target/<profile>/libzstd.so`, exactly as an\n6\t//! external consumer would, so the `#[no_mangle] extern \"C\"` wrappers are under\n7\t//! test too.\n8\t#![allow(dead_code, non_snake_case, non_camel_case_types, non_upper_case_globals)]\n9\t\n10\tuse libloading::{Library, Symbol};\n11\tuse std::ffi::c_void;\n12\tuse std::path::PathBuf;\n13\tuse std::sync::OnceLock;\n14\t\n15\t// ---------------------------------------------------------------- library load\n16\t\n17\tfn manifest_dir() -> PathBuf {\n18\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n19\t}\n20\t\n21\tfn c_so_path() -> PathBuf {\n22\t    if let Ok(p) = std::env::var(\"ZSTD_C_SO\") {\n23\t        return PathBuf::from(p);\n24\t    }\n25\t    manifest_dir().join(\"c_src/build/libzstd.so\")\n26\t}\n27\t\n28\tfn rust_so_path() -> PathBuf {\n29\t    if let Ok(p) = std::env::var(\"ZSTD_RUST_SO\") {\n30\t        return PathBuf::from(p);\n31\t    }\n32\t    // Prefer the profile this test binary was built into.\n33\t    let exe = std::env::current_exe().expect(\"current_exe\");\n34\t    // .../target/<profile>/deps/<test>-<hash>\n35\t    let profile_dir = exe\n36\t        .parent()\n37\t        .and_then(|p| p.parent())\n38\t        .map(|p| p.to_path_buf())\n39\t        .expect(\"profile dir\");\n40\t    let candidate = profile_dir.join(\"libzstd.so\");\n41\t    if candidate.exists() {\n42\t        return candidate;\n43\t    }\n44\t    for p in [\"target/release/libzstd.so\", \"target/debug/libzstd.so\"] {\n45\t        let c = manifest_dir().join(p);\n46\t        if c.exists() {\n47\t            return c;\n48\t        }\n49\t    }\n50\t    panic!(\n51\t        \"Rust libzstd.so not found. Build it with `cargo build` (or set ZSTD_RUST_SO). \\\n52\t         Looked in {:?}\",\n53\t        profile_dir\n54\t    );\n55\t}\n56\t\n57\tstatic C_LIB: OnceLock<Library> = OnceLock::new();\n58\tstatic R_LIB: OnceLock<Library> = OnceLock::new();\n59\t\n60\tpub fn c_lib() -> &'static Library {\n61\t    C_LIB.get_or_init(|| {\n62\t        let p = c_so_path();\n63\t        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen C {:?}: {e}\", p))\n64\t    })\n65\t}\n66\t\n67\tpub fn r_lib() -> &'static Library {\n68\t    R_LIB.get_or_init(|| {\n69\t        let p = rust_so_path();\n70\t        unsafe { Library::new(&p) }.unwrap_or_else(|e| panic!(\"dlopen Rust {:?}: {e}\", p))\n71\t    })\n72\t}\n73\t\n74\t/// Look up `name` in one library.\n75\tpub fn sym<T>(lib: &'static Library, name: &str) -> Symbol<'static, T> {\n76\t    unsafe { lib.get(name.as_bytes()) }\n77\t        .unwrap_or_else(|e| panic!(\"dlsym {name} failed: {e}\"))\n78\t}\n79\t\n80\t/// Look up `name` in BOTH libraries; returns `(c_fn, rust_fn)`.\n81\tpub fn pair<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n82\t    (sym::<T>(c_lib(), name), sym::<T>(r_lib(), name))\n83\t}\n84\t\n85\t/// True if both libraries export `name` (used to skip absent optional symbols).\n86\tpub fn both_have(name: &str) -> bool {\n87\t    unsafe {\n88\t        c_lib().get::<*const c_void>(name.as_bytes()).is_ok()\n89\t            && r_lib().get::<*const c_void>(name.as_bytes()).is_ok()\n90\t    }\n91\t}\n92\t\n93\t// ------------------------------------------------------------------- C types\n94\t\n95\tpub type ZSTD_CCtx = c_void;\n96\tpub type ZSTD_DCtx = c_void;\n97\tpub type ZSTD_CDict = c_void;\n98\tpub type ZSTD_DDict = c_void;\n99\tpub type ZSTD_CCtxParams = c_void;\n100\t\n101\t#[repr(C)]\n102\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n103\tpub struct ZSTD_bounds {\n104\t    pub error: usize,\n105\t    pub lowerBound: i32,\n106\t    pub upperBound: i32,\n107\t}\n108\t\n109\t#[repr(C)]\n110\t#[derive(Clone, Copy, Debug)]\n111\tpub struct ZSTD_inBuffer {\n112\t    pub src: *const c_void,\n113\t    pub size: usize,\n114\t    pub pos: usize,\n115\t}\n116\t\n117\t#[repr(C)]\n118\t#[derive(Clone, Copy, Debug)]\n119\tpub struct ZSTD_outBuffer {\n120\t    pub dst: *mut c_void,\n121\t    pub size: usize,\n122\t    pub pos: usize,\n123\t}\n124\t\n125\t#[repr(C)]\n126\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n127\tpub struct ZSTD_compressionParameters {\n128\t    pub windowLog: u32,\n129\t    pub chainLog: u32,\n130\t    pub hashLog: u32,\n131\t    pub searchLog: u32,\n132\t    pub minMatch: u32,\n133\t    pub targetLength: u32,\n134\t    pub strategy: i32,\n135\t}\n136\t\n137\t#[repr(C)]\n138\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n139\tpub struct ZSTD_frameParameters {\n140\t    pub contentSizeFlag: i32,\n141\t    pub checksumFlag: i32,\n142\t    pub noDictIDFlag: i32,\n143\t}\n144\t\n145\t#[repr(C)]\n146\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n147\tpub struct ZSTD_parameters {\n148\t    pub cParams: ZSTD_compressionParameters,\n149\t    pub fParams: ZSTD_frameParameters,\n150\t}\n151\t\n152\t#[repr(C)]\n153\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n154\tpub struct ZSTD_Sequence {\n155\t    pub offset: u32,\n156\t    pub litLength: u32,\n157\t    pub matchLength: u32,\n158\t    pub rep: u32,\n159\t}\n160\t\n161\t#[repr(C)]\n162\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n163\tpub struct ZSTD_FrameHeader {\n164\t    pub frameContentSize: u64,\n165\t    pub windowSize: u64,\n166\t    pub blockSizeMax: u32,\n167\t    pub frameType: u32,\n168\t    pub headerSize: u32,\n169\t    pub dictID: u32,\n170\t    pub checksumFlag: u32,\n171\t    pub _reserved1: u32,\n172\t    pub _reserved2: u32,\n173\t}\n174\t\n175\t#[repr(C)]\n176\t#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]\n177\tpub struct ZSTD_frameProgression {\n178\t    pub ingested: u64,\n179\t    pub consumed: u64,\n180\t    pub produced: u64,\n181\t    pub flushed: u64,\n182\t    pub currentJobID: u32,\n183\t    pub nbActiveWorkers: u32,\n184\t}\n185\t\n186\t#[repr(C)]\n187\t#[derive(Clone, Copy, Debug, Default)]\n188\tpub struct ZDICT_params_t {\n189\t    pub compressionLevel: i32,\n190\t    pub notificationLevel: u32,\n191\t    pub dictID: u32,\n192\t}\n193\t\n194\t#[repr(C)]\n195\t#[derive(Clone, Copy, Debug, Default)]\n196\tpub struct ZDICT_cover_params_t {\n197\t    pub k: u32,\n198\t    pub d: u32,\n199\t    pub steps: u32,\n200\t    pub nbThreads: u32,\n201\t    pub splitPoint: f64,\n202\t    pub shrinkDict: u32,\n203\t    pub shrinkDictMaxRegression: u32,\n204\t    pub zParams: ZDICT_params_t,\n205\t}\n206\t\n207\t#[repr(C)]\n208\t#[derive(Clone, Copy, Debug, Default)]\n209\tpub struct ZDICT_fastCover_params_t {\n210\t    pub k: u32,\n211\t    pub d: u32,\n212\t    pub f: u32,\n213\t    pub steps: u32,\n214\t    pub nbThreads: u32,\n215\t    pub splitPoint: f64,\n216\t    pub accel: u32,\n217\t    pub shrinkDict: u32,\n218\t    pub shrinkDictMaxRegression: u32,\n219\t    pub zParams: ZDICT_params_t,\n220\t}\n221\t\n222\t#[repr(C)]\n223\t#[derive(Clone, Copy, Debug, Default)]\n224\tpub struct ZDICT_legacy_params_t {\n225\t    pub selectivityLevel: u32,\n226\t    pub zParams: ZDICT_params_t,\n227\t}\n228\t\n229\t#[repr(C)]\n230\t#[derive(Clone, Copy)]\n231\tpub struct ZSTD_customMem {\n232\t    pub customAlloc: Option<extern \"C\" fn(*mut c_void, usize) -> *mut c_void>,\n233\t    pub customFree: Option<extern \"C\" fn(*mut c_void, *mut c_void)>,\n234\t    pub opaque: *mut c_void,\n235\t}\n236\timpl Default for ZSTD_customMem {\n237\t    fn default() -> Self {\n238\t        ZSTD_customMem { customAlloc: None, customFree: None, opaque: std::ptr::null_mut() }\n239\t    }\n240\t}\n241\t\n242\t// ------------------------------------------------------------------ constants\n243\t\n244\tpub const ZSTD_CONTENTSIZE_UNKNOWN: u64 = u64::MAX;\n245\tpub const ZSTD_CONTENTSIZE_ERROR: u64 = u64::MAX - 1;\n246\tpub const ZSTD_MAGICNUMBER: u32 = 0xFD2F_B528;\n247\tpub const ZSTD_MAGIC_DICTIONARY: u32 = 0xEC30_A437;\n248\tpub const ZSTD_MAGIC_SKIPPABLE_START: u32 = 0x184D_2A50;\n249\tpub const ZSTD_BLOCKSIZE_MAX: usize = 1 << 17;\n250\t\n251\t// cParameters\n252\tpub const ZSTD_c_compressionLevel: i32 = 100;\n253\tpub const ZSTD_c_windowLog: i32 = 101;\n254\tpub const ZSTD_c_hashLog: i32 = 102;\n255\tpub const ZSTD_c_chainLog: i32 = 103;\n256\tpub const ZSTD_c_searchLog: i32 = 104;\n257\tpub const ZSTD_c_minMatch: i32 = 105;\n258\tpub const ZSTD_c_targetLength: i32 = 106;\n259\tpub const ZSTD_c_strategy: i32 = 107;\n260\tpub const ZSTD_c_targetCBlockSize: i32 = 130;\n261\tpub const ZSTD_c_enableLongDistanceMatching: i32 = 160;\n262\tpub const ZSTD_c_ldmHashLog: i32 = 161;\n263\tpub const ZSTD_c_ldmMinMatch: i32 = 162;\n264\tpub const ZSTD_c_ldmBucketSizeLog: i32 = 163;\n265\tpub const ZSTD_c_ldmHashRateLog: i32 = 164;\n266\tpub const ZSTD_c_contentSizeFlag: i32 = 200;\n267\tpub const ZSTD_c_checksumFlag: i32 = 201;\n268\tpub const ZSTD_c_dictIDFlag: i32 = 202;\n269\tpub const ZSTD_c_nbWorkers: i32 = 400;\n270\tpub const ZSTD_c_jobSize: i32 = 401;\n271\tpub const ZSTD_c_overlapLog: i32 = 402;\n272\tpub const ZSTD_c_rsyncable: i32 = 500;\n273\tpub const ZSTD_c_format: i32 = 10;\n274\tpub const ZSTD_c_forceMaxWindow: i32 = 1000;\n275\tpub const ZSTD_c_forceAttachDict: i32 = 1001;\n276\tpub const ZSTD_c_literalCompressionMode: i32 = 1002;\n277\tpub const ZSTD_c_experimentalParam6_retired: i32 = 1003;\n278\tpub const ZSTD_c_srcSizeHint: i32 = 1004;\n279\tpub const ZSTD_c_enableDedicatedDictSearch: i32 = 1005;\n280\tpub const ZSTD_c_stableInBuffer: i32 = 1006;\n281\tpub const ZSTD_c_stableOutBuffer: i32 = 1007;\n282\tpub const ZSTD_c_blockDelimiters: i32 = 1008;\n283\tpub const ZSTD_c_validateSequences: i32 = 1009;\n284\tpub const ZSTD_c_splitAfterSequences: i32 = 1010;\n285\tpub const ZSTD_c_useRowMatchFinder: i32 = 1011;\n286\tpub const ZSTD_c_deterministicRefPrefix: i32 = 1012;\n287\tpub const ZSTD_c_prefetchCDictTables: i32 = 1013;\n288\tpub const ZSTD_c_enableSeqProducerFallback: i32 = 1014;\n289\tpub const ZSTD_c_maxBlockSize: i32 = 1015;\n290\tpub const ZSTD_c_repcodeResolution: i32 = 1016;\n291\tpub const ZSTD_c_blockSplitterLevel: i32 = 1017;\n292\t\n293\t/// Every cParameter the C library recognises.\n294\tpub const ALL_CPARAMS: &[i32] = &[\n295\t    100, 101, 102, 103, 104, 105, 106, 107, 130, 160, 161, 162, 163, 164, 200, 201, 202, 400,\n296\t    401, 402, 500, 10, 1000, 1001, 1002, 1004, 1005, 1006, 1007, 1008, 1009, 1010, 1011, 1012,\n297\t    1013, 1014, 1015, 1016, 1017,\n298\t];\n299\t\n300\t// dParameters\n301\tpub const ZSTD_d_windowLogMax: i32 = 100;\n302\tpub const ZSTD_d_format: i32 = 1000;\n303\tpub const ZSTD_d_stableOutBuffer: i32 = 1001;\n304\tpub const ZSTD_d_forceIgnoreChecksum: i32 = 1002;\n305\tpub const ZSTD_d_refMultipleDDicts: i32 = 1003;\n306\tpub const ZSTD_d_disableHuffmanAssembly: i32 = 1004;\n307\tpub const ZSTD_d_maxBlockSize: i32 = 1005;\n308\tpub const ALL_DPARAMS: &[i32] = &[100, 1000, 1001, 1002, 1003, 1004, 1005];\n309\t\n310\t// strategies\n311\tpub const ZSTD_fast: i32 = 1;\n312\tpub const ZSTD_btultra2: i32 = 9;\n313\tpub const ALL_STRATEGIES: &[i32] = &[1, 2, 3, 4, 5, 6, 7, 8, 9];\n314\t\n315\t// reset directives / end directives\n316\tpub const ZSTD_reset_session_only: u32 = 1;\n317\tpub const ZSTD_reset_parameters: u32 = 2;\n318\tpub const ZSTD_reset_session_and_parameters: u32 = 3;\n319\tpub const ZSTD_e_continue: u32 = 0;\n320\tpub const ZSTD_e_flush: u32 = 1;\n321\tpub const ZSTD_e_end: u32 = 2;\n322\t\n323\t/// `ERR_isError`: `code > (size_t)-ZSTD_error_maxCode` with maxCode == 120.\n324\tpub fn is_error(code: usize) -> bool {\n325\t    code > (0usize).wrapping_sub(120)\n326\t}\n327\t/// Decode an error code returned across the FFI boundary into its enum value.\n328\tpub fn err_code(code: usize) -> i64 {\n329\t    if is_error(code) {\n330\t        // e.g. 0xFFFF_FFFF_FFFF_FFD8 as i64 == -40  =>  code 40\n331\t        (0i64).wrapping_sub(code as i64)\n332\t    } else {\n333\t        0\n334\t    }\n335\t}\n336\t\n337\t// ------------------------------------------------------------------- PRNG\n338\t\n339\t/// Deterministic xorshift64* PRNG — fixed seed => reproducible test corpora.\n340\tpub struct Rng(pub u64);\n341\t\n342\timpl Rng {\n343\t    pub fn new(seed: u64) -> Self {\n344\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n345\t    }\n346\t    pub fn next_u64(&mut self) -> u64 {\n347\t        let mut x = self.0;\n348\t        x ^= x >> 12;\n349\t        x ^= x << 25;\n350\t        x ^= x >> 27;\n351\t        self.0 = x;\n352\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n353\t    }\n354\t    pub fn next_u32(&mut self) -> u32 {\n355\t        (self.next_u64() >> 32) as u32\n356\t    }\n357\t    pub fn below(&mut self, n: usize) -> usize {\n358\t        if n == 0 {\n359\t            0\n360\t        } else {\n361\t            (self.next_u64() % n as u64) as usize\n362\t        }\n363\t    }\n364\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n365\t        if hi <= lo {\n366\t            lo\n367\t        } else {\n368\t            lo + self.below(hi - lo + 1)\n369\t        }\n370\t    }\n371\t    pub fn byte(&mut self) -> u8 {\n372\t        (self.next_u64() >> 56) as u8\n373\t    }\n374\t}\n375\t\n376\t// ------------------------------------------------------------- data generators\n377\t\n378\t/// The distinct input SHAPES that `CONFIGS.md` AXIS 5 enumerates.\n379\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n380\tpub enum Shape {\n381\t    /// All identical bytes -> exercises RLE block type.\n382\t    Rle,\n383\t    /// Cryptographically-random-ish -> incompressible, raw/stored block type.\n384\t    Random,\n385\t    /// English-like text -> literals + matches, compressed block type.\n386\t    Text,\n387\t    /// Small alphabet, highly repetitive -> huffman-friendly literals.\n388\t    Skewed,\n389\t    /// Long repeated blocks far apart -> exercises long-distance matching.\n390\t    LongRange,\n391\t    /// Structured binary records -> periodic matches.\n392\t    Records,\n393\t}\n394\t\n395\tpub const ALL_SHAPES: &[Shape] =\n396\t    &[Shape::Rle, Shape::Random, Shape::Text, Shape::Skewed, Shape::LongRange, Shape::Records];\n397\t\n398\tpub fn gen(shape: Shape, len: usize, rng: &mut Rng) -> Vec<u8> {\n399\t    let mut v = Vec::with_capacity(len);\n400\t    match shape {\n401\t        Shape::Rle => {\n402\t            let b = rng.byte();\n403\t            v.resize(len, b);\n404\t        }\n405\t        Shape::Random => {\n406\t            while v.len() < len {\n407\t                v.extend_from_slice(&rng.next_u64().to_le_bytes());\n408\t            }\n409\t            v.truncate(len);\n410\t        }\n411\t        Shape::Text => {\n412\t            const W: &[&str] = &[\n413\t                \"the \", \"quick \", \"brown \", \"fox \", \"jumps \", \"over \", \"lazy \", \"dog \",\n414\t                \"zstandard \", \"compression \", \"dictionary \", \"entropy \", \"sequence \", \"block \",\n415\t                \"literal \", \"match \", \"offset \", \"window \", \"frame \", \"checksum \",\n416\t            ];\n417\t            while v.len() < len {\n418\t                v.extend_from_slice(W[rng.below(W.len())].as_bytes());\n419\t            }\n420\t            v.truncate(len);\n421\t        }\n422\t        Shape::Skewed => {\n423\t            while v.len() < len {\n424\t                let n = rng.range(1, 6);\n425\t                let b = b'a' + (rng.below(4) as u8);\n426\t                for _ in 0..n {\n427\t                    v.push(b);\n428\t                }\n429\t            }\n430\t            v.truncate(len);\n431\t        }\n432\t        Shape::LongRange => {\n433\t            // A repeated 4 KB motif separated by random filler: matches at large\n434\t            // distances, which is what enableLongDistanceMatching targets.\n435\t            let motif: Vec<u8> = {\n436\t                let mut m = Vec::with_capacity(4096);\n437\t                let mut r = Rng::new(0xABCDEF);\n438\t                while m.len() < 4096 {\n439\t                    m.extend_from_slice(&r.next_u64().to_le_bytes());\n440\t                }\n441\t                m\n442\t            };\n443\t            while v.len() < len {\n444\t                v.extend_from_slice(&motif);\n445\t                let filler = rng.range(256, 2048);\n446\t                for _ in 0..filler {\n447\t                    if v.len() >= len {\n448\t                        break;\n449\t                    }\n450\t                    v.push(rng.byte());\n451\t                }\n452\t            }\n453\t            v.truncate(len);\n454\t        }\n455\t        Shape::Records => {\n456\t            let mut ctr: u32 = 0;\n457\t            while v.len() < len {\n458\t                v.extend_from_slice(&ctr.to_le_bytes());\n459\t                v.extend_from_slice(b\"HEADER\\0\\0\");\n460\t                v.extend_from_slice(&(ctr % 7).to_le_bytes());\n461\t                v.push(rng.byte());\n462\t                ctr = ctr.wrapping_add(1);\n463\t            }\n464\t            v.truncate(len);\n465\t        }\n466\t    }\n467\t    v\n468\t}\n469\t\n470\t/// Build a set of training samples for the dictionary builders.\n471\tpub fn gen_samples(\n472\t    shape: Shape,\n473\t    nb: usize,\n474\t    min_len: usize,\n475\t    max_len: usize,\n476\t    rng: &mut Rng,\n477\t) -> (Vec<u8>, Vec<usize>) {\n478\t    let mut buf = Vec::new();\n479\t    let mut sizes = Vec::with_capacity(nb);\n480\t    for _ in 0..nb {\n481\t        let n = rng.range(min_len, max_len);\n482\t        let s = gen(shape, n, rng);\n483\t        buf.extend_from_slice(&s);\n484\t        sizes.push(s.len());\n485\t    }\n486\t    (buf, sizes)\n487\t}\n488\t\n489\t// ------------------------------------------------------------ assert helpers\n490\t\n491\t/// Compare two byte buffers and report the first differing index.\n492\tpub fn assert_bytes_eq(ctx: &str, c: &[u8], r: &[u8]) {\n493\t    if c == r {\n494\t        return;\n495\t    }\n496\t    if c.len() != r.len() {\n497\t        panic!(\"{ctx}: length differs: C={} Rust={}\", c.len(), r.len());\n498\t    }\n499\t    let i = c.iter().zip(r.iter()).position(|(a, b)| a != b).unwrap();\n500\t    let lo = i.saturating_sub(8);\n501\t    let hi = (i + 8).min(c.len());\n502\t    panic!(\n503\t        \"{ctx}: bytes differ at index {i}: C=0x{:02x} Rust=0x{:02x}\\n  C   [{lo}..{hi}] = {:02x?}\\n  Rust[{lo}..{hi}] = {:02x?}\",\n504\t        c[i], r[i], &c[lo..hi], &r[lo..hi]\n505\t    );\n506\t}\n507\t\n508\t/// Compare two `size_t` results, rendering error codes symbolically.\n509\tpub fn assert_ret_eq(ctx: &str, c: usize, r: usize) {\n510\t    if c == r {\n511\t        return;\n512\t    }\n513\t    panic!(\n514\t        \"{ctx}: return differs: C={c} (err={}, code={}) Rust={r} (err={}, code={})\",\n515\t        is_error(c),\n516\t        err_code(c),\n517\t        is_error(r),\n518\t        err_code(r)\n519\t    );\n520\t}\n521\t\n522\tpub fn err_name(lib: &'static Library, code: usize) -> String {\n523\t    let f: Symbol<unsafe extern \"C\" fn(usize) -> *const std::os::raw::c_char> =\n524\t        sym(lib, \"ZSTD_getErrorName\");\n525\t    unsafe {\n526\t        let p = f(code);\n527\t        if p.is_null() {\n528\t            \"<null>\".to_string()\n529\t        } else {\n530\t            std::ffi::CStr::from_ptr(p).to_string_lossy().into_owned()\n531\t        }\n532\t    }\n533\t}\n534\t\n535\t// ============================================================================\n536\t// Api — one bundle of resolved symbols per library.\n537\t//\n538\t// Test bodies are written ONCE against `&Api` and then run twice (C, Rust), so\n539\t// the two libraries provably receive an identical call sequence.\n540\t// ============================================================================\n541\t\n542\tpub struct Api {\n543\t    pub lib: &'static Library,\n544\t    pub tag: &'static str,\n545\t\n546\t    // contexts\n547\t    pub createCCtx: Symbol<'static, unsafe extern \"C\" fn() -> *mut ZSTD_CCtx>,\n548\t    pub freeCCtx: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx) -> usize>,\n549\t    pub createDCtx: Symbol<'static, unsafe extern \"C\" fn() -> *mut ZSTD_DCtx>,\n550\t    pub freeDCtx: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx) -> usize>,\n551\t\n552\t    // one-shot\n553\t    pub compress: Symbol<\n554\t        'static,\n555\t        unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize, i32) -> usize,\n556\t    >,\n557\t    pub compressCCtx: Symbol<\n558\t        'static,\n559\t        unsafe extern \"C\" fn(\n560\t            *mut ZSTD_CCtx,\n561\t            *mut c_void,\n562\t            usize,\n563\t            *const c_void,\n564\t            usize,\n565\t            i32,\n566\t        ) -> usize,\n567\t    >,\n568\t    pub compress2: Symbol<\n569\t        'static,\n570\t        unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut c_void, usize, *const c_void, usize) -> usize,\n571\t    >,\n572\t    pub decompress:\n573\t        Symbol<'static, unsafe extern \"C\" fn(*mut c_void, usize, *const c_void, usize) -> usize>,\n574\t    pub decompressDCtx: Symbol<\n575\t        'static,\n576\t        unsafe extern \"C\" fn(*mut ZSTD_DCtx, *mut c_void, usize, *const c_void, usize) -> usize,\n577\t    >,\n578\t    pub compressBound: Symbol<'static, unsafe extern \"C\" fn(usize) -> usize>,\n579\t\n580\t    // params\n581\t    pub setParameter:\n582\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, i32, i32) -> usize>,\n583\t    pub getParameter:\n584\t        Symbol<'static, unsafe extern \"C\" fn(*const ZSTD_CCtx, i32, *mut i32) -> usize>,\n585\t    pub setPledgedSrcSize:\n586\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, u64) -> usize>,\n587\t    pub cctxReset: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, u32) -> usize>,\n588\t    pub dctxReset: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx, u32) -> usize>,\n589\t    pub dSetParameter:\n590\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx, i32, i32) -> usize>,\n591\t    pub dGetParameter:\n592\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx, i32, *mut i32) -> usize>,\n593\t\n594\t    // dictionaries\n595\t    pub loadDictionary: Symbol<\n596\t        'static,\n597\t        unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const c_void, usize) -> usize,\n598\t    >,\n599\t    pub refPrefix:\n600\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const c_void, usize) -> usize>,\n601\t    pub refCDict:\n602\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, *const ZSTD_CDict) -> usize>,\n603\t    pub createCDict: Symbol<\n604\t        'static,\n605\t        unsafe extern \"C\" fn(*const c_void, usize, i32) -> *mut ZSTD_CDict,\n606\t    >,\n607\t    pub freeCDict: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CDict) -> usize>,\n608\t    pub dLoadDictionary: Symbol<\n609\t        'static,\n610\t        unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const c_void, usize) -> usize,\n611\t    >,\n612\t    pub dRefPrefix:\n613\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const c_void, usize) -> usize>,\n614\t    pub dRefDDict:\n615\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx, *const ZSTD_DDict) -> usize>,\n616\t    pub createDDict:\n617\t        Symbol<'static, unsafe extern \"C\" fn(*const c_void, usize) -> *mut ZSTD_DDict>,\n618\t    pub freeDDict: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DDict) -> usize>,\n619\t\n620\t    // streaming\n621\t    pub compressStream2: Symbol<\n622\t        'static,\n623\t        unsafe extern \"C\" fn(\n624\t            *mut ZSTD_CCtx,\n625\t            *mut ZSTD_outBuffer,\n626\t            *mut ZSTD_inBuffer,\n627\t            u32,\n628\t        ) -> usize,\n629\t    >,\n630\t    pub compressStream: Symbol<\n631\t        'static,\n632\t        unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut ZSTD_outBuffer, *mut ZSTD_inBuffer) -> usize,\n633\t    >,\n634\t    pub flushStream:\n635\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut ZSTD_outBuffer) -> usize>,\n636\t    pub endStream:\n637\t        Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut ZSTD_outBuffer) -> usize>,\n638\t    pub initCStream: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, i32) -> usize>,\n639\t    pub decompressStream: Symbol<\n640\t        'static,\n641\t        unsafe extern \"C\" fn(*mut ZSTD_DCtx, *mut ZSTD_outBuffer, *mut ZSTD_inBuffer) -> usize,\n642\t    >,\n643\t    pub initDStream: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx) -> usize>,\n644\t\n645\t    // block level\n646\t    pub compressBegin: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_CCtx, i32) -> usize>,\n647\t    pub compressContinue: Symbol<\n648\t        'static,\n649\t        unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut c_void, usize, *const c_void, usize) -> usize,\n650\t    >,\n651\t    pub compressEnd: Symbol<\n652\t        'static,\n653\t        unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut c_void, usize, *const c_void, usize) -> usize,\n654\t    >,\n655\t    pub getBlockSize: Symbol<'static, unsafe extern \"C\" fn(*const ZSTD_CCtx) -> usize>,\n656\t    pub compressBlock: Symbol<\n657\t        'static,\n658\t        unsafe extern \"C\" fn(*mut ZSTD_CCtx, *mut c_void, usize, *const c_void, usize) -> usize,\n659\t    >,\n660\t    pub decompressBegin: Symbol<'static, unsafe extern \"C\" fn(*mut ZSTD_DCtx) -> usize>,\n661\t    pub decompressContinue: Symbol<\n662\t        'static,\n663\t        unsafe extern \"C\" fn(*mut ZSTD_DCtx, *mut c_void, usize, *const c_void, usize) -> usize,\n664\t    >,\n665\t    pub nextSrcSizeToDecompress:\n666\t        Symbol<'static, unsafe extern \"C\" fn(