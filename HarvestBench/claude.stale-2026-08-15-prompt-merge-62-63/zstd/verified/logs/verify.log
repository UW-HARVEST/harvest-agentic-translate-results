{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YNRRaVjYRNpn4nedL8juW3","type":"tool_result","content":"1\t//! Minimal reproduction driver for the LDM divergence. Shrinks the failing\n2\t//! input to the smallest size/params that still differ.\n3\tmod common;\n4\tuse common::*;\n5\tuse std::ffi::c_void;\n6\t\n7\tfn comp(api: &Api, params: &[(i32, i32)], src: &[u8]) -> Out {\n8\t    unsafe {\n9\t        let cctx = (api.createCCtx)();\n10\t        for &(p, v) in params {\n11\t            let r = (api.setParameter)(cctx, p, v);\n12\t            assert!(!is_error(r), \"setParameter({p},{v}) -> {}\", err_code(r));\n13\t        }\n14\t        let cap = (api.compressBound)(src.len()) + 64;\n15\t        let mut buf = vec![0u8; cap];\n16\t        let ret = (api.compress2)(\n17\t            cctx,\n18\t            buf.as_mut_ptr() as *mut c_void,\n19\t            cap,\n20\t            src.as_ptr() as *const c_void,\n21\t            src.len(),\n22\t        );\n23\t        (api.freeCCtx)(cctx);\n24\t        Out::ok(ret, &buf)\n25\t    }\n26\t}\n27\t\n28\t#[test]\n29\t#[ignore]\n30\tfn shrink_ldm() {\n31\t    let params = vec![\n32\t        (ZSTD_c_enableLongDistanceMatching, 1),\n33\t        (ZSTD_c_windowLog, 20),\n34\t    ];\n35\t    // Find the smallest LongRange length that diverges.\n36\t    let mut smallest: Option<(usize, usize)> = None;\n37\t    for len in (1000..400_000).step_by(1000) {\n38\t        let mut rng = Rng::new(0x1D00_5EED);\n39\t        let src = gen(Shape::LongRange, len, &mut rng);\n40\t        let c = comp(capi(), &params, &src);\n41\t        let r = comp(rapi(), &params, &src);\n42\t        if c.bytes != r.bytes || c.ret != r.ret {\n43\t            let idx = c\n44\t                .bytes\n45\t                .iter()\n46\t                .zip(r.bytes.iter())\n47\t                .position(|(a, b)| a != b)\n48\t                .unwrap_or(c.bytes.len().min(r.bytes.len()));\n49\t            smallest = Some((len, idx));\n50\t            println!(\n51\t                \"DIVERGE at len={len}: C ret={} Rust ret={} first differing byte index={idx}\",\n52\t                c.ret, r.ret\n53\t            );\n54\t            break;\n55\t        }\n56\t    }\n57\t    println!(\"smallest = {smallest:?}\");\n58\t\n59\t    // Which shapes diverge at a fixed size?\n60\t    for &shape in ALL_SHAPES {\n61\t        let mut rng = Rng::new(7);\n62\t        let src = gen(shape, 300_000, &mut rng);\n63\t        let c = comp(capi(), &params, &src);\n64\t        let r = comp(rapi(), &params, &src);\n65\t        println!(\n66\t            \"shape={shape:?}: C ret={} Rust ret={} same={}\",\n67\t            c.ret,\n68\t            r.ret,\n69\t            c.bytes == r.bytes\n70\t        );\n71\t    }\n72\t\n73\t    // Which LDM params are needed to trigger it?\n74\t    let mut rng = Rng::new(0x1D00_5EED);\n75\t    let src = gen(Shape::LongRange, 300_000, &mut rng);\n76\t    for wl in [17i32, 18, 20, 22, 27] {\n77\t        for hl in [0i32, 6, 16, 20] {\n78\t            for mm in [0i32, 4, 32, 64] {\n79\t                for bk in [0i32, 1, 4, 8] {\n80\t                    for rt in [0i32, 1, 7] {\n81\t                        let p = vec![\n82\t                            (ZSTD_c_enableLongDistanceMatching, 1),\n83\t                            (ZSTD_c_windowLog, wl),\n84\t                            (ZSTD_c_ldmHashLog, hl),\n85\t                            (ZSTD_c_ldmMinMatch, mm),\n86\t                            (ZSTD_c_ldmBucketSizeLog, bk),\n87\t                            (ZSTD_c_ldmHashRateLog, rt),\n88\t                        ];\n89\t                        let c = comp(capi(), &p, &src);\n90\t                        let r = comp(rapi(), &p, &src);\n91\t                        if c.bytes != r.bytes || c.ret != r.ret {\n92\t                            println!(\n93\t                                \"DIVERGE wl={wl} hl={hl} mm={mm} bk={bk} rt={rt}: C={} R={}\",\n94\t                                c.ret, r.ret\n95\t                            );\n96\t                        }\n97\t                    }\n98\t                }\n99\t            }\n100\t        }\n101\t    }\n102\t}\n103\t\n104\t/// Does LDM diverge even at default (auto) settings on long-range data?\n105\t#[test]\n106\t#[ignore]\n107\tfn ldm_default_vs_explicit() {\n108\t    let mut rng = Rng::new(0x1D00_5EED);\n109\t    let src = gen(Shape::LongRange, 300_000, &mut rng);\n110\t    for p in [\n111\t        vec![],\n112\t        vec![(ZSTD_c_enableLongDistanceMatching, 0)],\n113\t        vec![(ZSTD_c_enableLongDistanceMatching, 1)],\n114\t        vec![(ZSTD_c_enableLongDistanceMatching, 2)],\n115\t        vec![(ZSTD_c_compressionLevel, 19)],\n116\t        vec![(ZSTD_c_windowLog, 27), (ZSTD_c_compressionLevel, 19)],\n117\t    ] {\n118\t        let c = comp(capi(), &p, &src);\n119\t        let r = comp(rapi(), &p, &src);\n120\t        println!(\"params={p:?} -> C={} R={} same={}\", c.ret, r.ret, c.bytes == r.bytes);\n121\t    }\n122\t}\n123\t\n124\t/// FAST focused repro — this is the canonical LDM regression check.\n125\t/// Runs in well under a second. Must pass byte-for-byte.\n126\t#[test]\n127\tfn ldm_fast_repro() {\n128\t    let mut rng = Rng::new(0x1D00_5EED);\n129\t    let src = gen(Shape::LongRange, 132_000, &mut rng);\n130\t    let mut bad = Vec::new();\n131\t    for wl in [17i32, 20, 27] {\n132\t        for hl in [0i32, 6, 16, 20] {\n133\t            for mm in [0i32, 4, 32, 64, 4096] {\n134\t                for bk in [0i32, 1, 4, 8] {\n135\t                    for rt in [0i32, 1, 7, 25] {\n136\t                        let p = vec![\n137\t                            (ZSTD_c_enableLongDistanceMatching, 1),\n138\t                            (ZSTD_c_windowLog, wl),\n139\t                            (ZSTD_c_ldmHashLog, hl),\n140\t                            (ZSTD_c_ldmMinMatch, mm),\n141\t                            (ZSTD_c_ldmBucketSizeLog, bk),\n142\t                            (ZSTD_c_ldmHashRateLog, rt),\n143\t                        ];\n144\t                        let c = comp(capi(), &p, &src);\n145\t                        let r = comp(rapi(), &p, &src);\n146\t                        if c.ret != r.ret || c.bytes != r.bytes {\n147\t                            let idx = c.bytes.iter().zip(r.bytes.iter())\n148\t                                .position(|(a, b)| a != b);\n149\t                            bad.push(format!(\n150\t                                \"wl={wl} hl={hl} mm={mm} bk={bk} rt={rt}: Cret={} Rret={} firstdiff={idx:?}\",\n151\t                                c.ret, r.ret));\n152\t                        }\n153\t                    }\n154\t                }\n155\t            }\n156\t        }\n157\t    }\n158\t    assert!(bad.is_empty(), \"{} LDM configs diverge:\\n{}\", bad.len(), bad.join(\"\\n\"));\n159\t}\n160\t"}]},"parent_tool_use_id":"toolu_bdrk_01QKsbugUYA2Tb4JkuQ6tX77","session_id":"f3f9022d-a72c-4fdb-a0a0-2ee15f7b56e5","uuid":"72613aa4-9b52-45bb-810a-c8789516291e","timestamp":"2026-08-14T21:36:45.616Z","subagent_type":"general-purpose","task_description":"Write shapes and internals tests"}
