const px, const size_t n,\n64\t                  const unsigned char *ctx, size_t ctx_len,\n65\t                  const unsigned char *msg, size_t msg_len,\n66\t                  int hash_alg)\n67\t{\n68\t    unsigned char h[crypto_core_ed25519_HASHBYTES];\n69\t    unsigned char h_be[2U * HASH_GE_L];\n70\t    size_t        i, j;\n71\t\n72\t    if (n > 2U) {\n73\t        abort(); /* LCOV_EXCL_LINE */\n74\t    }\n75\t    if (core_h2c_string_to_hash(h_be, n * HASH_GE_L, ctx, ctx_len, msg, msg_len,\n76\t                                hash_alg) != 0) {\n77\t        return -1; /* LCOV_EXCL_LINE */\n78\t    }\n79\t    COMPILER_ASSERT(sizeof h >= HASH_GE_L);\n80\t    for (i = 0U; i < n; i++) {\n81\t        for (j = 0U; j < HASH_GE_L; j++) {\n82\t            h[j] = h_be[i * HASH_GE_L + HASH_GE_L - 1U - j];\n83\t        }\n84\t        memset(&h[j], 0, (sizeof h) - j);\n85\t        ge25519_from_hash(&px[i * crypto_core_ed25519_BYTES], h);\n86\t    }\n87\t    return 0;\n88\t}\n89\t\n90\t/* LCOV_EXCL_START */\n91\tint\n92\tcrypto_core_ed25519_from_string_nu(unsigned char p[crypto_core_ed25519_BYTES],\n93\t                                   const unsigned char *ctx, size_t ctx_len,\n94\t                                   const unsigned char *msg, size_t msg_len,\n95\t                                   int hash_alg)\n96\t{\n97\t    return _string_to_points(p, 1, ctx, ctx_len, msg, msg_len, hash_alg);\n98\t}\n99\t\n100\tint\n101\tcrypto_core_ed25519_from_string(unsigned char p[crypto_core_ed25519_BYTES],\n102\t                                   const unsigned char *ctx, size_t ctx_len,\n103\t                                   const unsigned char *msg, size_t msg_len,\n104\t                                   int hash_alg)\n105\t{\n106\t    unsigned char px[2 * crypto_core_ed25519_BYTES];\n107\t\n108\t    if (_string_to_points(px, 2, ctx, ctx_len, msg, msg_len, hash_alg) != 0) {\n109\t        return -1;\n110\t    }\n111\t    return crypto_core_ed25519_add(p, &px[0], &px[crypto_core_