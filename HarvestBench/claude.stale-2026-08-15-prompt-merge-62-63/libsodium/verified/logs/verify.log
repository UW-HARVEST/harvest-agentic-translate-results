2_OK;\n464\t\n465\t    if (instance == NULL || context == NULL) {\n466\t        return ARGON2_INCORRECT_PARAMETER; /* LCOV_EXCL_LINE */\n467\t    }\n468\t\n469\t    /* 1. Memory allocation */\n470\t\n471\t    if ((instance->pseudo_rands = (uint64_t *)\n472\t         malloc(sizeof(uint64_t) * instance->segment_length)) == NULL) {\n473\t        return ARGON2_MEMORY_ALLOCATION_ERROR; /* LCOV_EXCL_LINE */\n474\t    }\n475\t\n476\t    result = allocate_memory(&(instance->region), instance->memory_blocks);\n477\t    if (ARGON2_OK != result) {\n478\t        argon2_free_instance(instance, context->flags); /* LCOV_EXCL_LINE */\n479\t        return result;                                   /* LCOV_EXCL_LINE */\n480\t    }\n481\t\n482\t    /* 2. Initial hashing */\n483\t    /* H_0 + 8 extra bytes to produce the first blocks */\n484\t    /* uint8_t blockhash[ARGON2_PREHASH_SEED_LENGTH]; */\n485\t    /* Hashing all inputs */\n486\t    argon2_initial_hash(blockhash, context, instance->type);\n487\t    /* Zeroing 8 extra bytes */\n488\t    sodium_memzero(blockhash + ARGON2_PREHASH_DIGEST_LENGTH,\n489\t                   ARGON2_PREHASH_SEED_LENGTH - ARGON2_PREHASH_DIGEST_LENGTH);\n490\t\n491\t    /* 3. Creating first blocks, we always have at least two blocks in a slice\n492\t     */\n493\t    argon2_fill_first_blocks(blockhash, instance);\n494\t    /* Clearing the hash */\n495\t    sodium_memzero(blockhash, ARGON2_PREHASH_SEED_LENGTH);\n496\t\n497\t    return ARGON2_OK;\n498\t}\n499\t\n500\tstatic int\n501\targon2_pick_best_implementation(void)\n502\t{\n503\t/* LCOV_EXCL_START */\n504\t#if defined(__wasm_simd128__)\n505\t    fill_segment = argon2_fill_segment_wasm32;\n506\t    return 0;\n507\t#endif\n508\t#if defined(HAVE_AVX512FINTRIN_H) && defined(HAVE_AVX2INTRIN_H) && \\\n509\t    defined(HAVE_TMMINTRIN_H) && defined(HAVE_SMMINTRIN_H)\n510\t    if (sodium_runtime_has_avx512f()) {\n511\t        fill_segment = argon2_fill_segment_avx512f;\n512\t        return 0;\n513\t    }\n514\