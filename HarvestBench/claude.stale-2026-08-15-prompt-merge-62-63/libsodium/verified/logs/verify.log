{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NoKmTsg1Nn3V2UdTmaN44Z","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C `libsodium.so` and the Rust `liblibsodium.so` via\n4\t//! `libloading` and calls every function through `dlsym`, exactly as an\n5\t//! external consumer would. Rust functions are NEVER called directly, so the\n6\t//! `#[no_mangle]` / `extern \"C\"` export wrappers are under test too.\n7\t#![allow(dead_code)]\n8\t\n9\tuse libloading::{Library, Symbol};\n10\tuse std::ffi::c_void;\n11\tuse std::path::PathBuf;\n12\tuse std::sync::OnceLock;\n13\t\n14\t// ---------------------------------------------------------------- library load\n15\t\n16\tpub struct Libs {\n17\t    pub c: Library,\n18\t    pub r: Library,\n19\t}\n20\t\n21\tfn crate_root() -> PathBuf {\n22\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n23\t}\n24\t\n25\tfn find_c_so() -> PathBuf {\n26\t    let p = crate_root().join(\"c_src/build/libsodium.so\");\n27\t    assert!(\n28\t        p.exists(),\n29\t        \"C shared library not found at {p:?}. Build it with:\\n  \\\n30\t         cd c_src && mkdir -p build && cd build && \\\n31\t         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n32\t    );\n33\t    p\n34\t}\n35\t\n36\t/// Prefer the profile the tests were built with, then fall back.\n37\tfn find_rust_so() -> PathBuf {\n38\t    let root = crate_root();\n39\t    let mut cands = vec![];\n40\t    if cfg!(debug_assertions) {\n41\t        cands.push(root.join(\"target/debug/liblibsodium.so\"));\n42\t        cands.push(root.join(\"target/release/liblibsodium.so\"));\n43\t    } else {\n44\t        cands.push(root.join(\"target/release/liblibsodium.so\"));\n45\t        cands.push(root.join(\"target/debug/liblibsodium.so\"));\n46\t    }\n47\t    for c in &cands {\n48\t        if c.exists() {\n49\t            return c.clone();\n50\t        }\n51\t    }\n52\t    panic!(\"Rust cdylib not found; tried {cands:?}. Run `cargo build`.\");\n53\t}\n54\t\n55\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n56\t\n57\tpub fn libs() -> &'static Libs {\n58\t    LIBS.get_or_init(|| unsafe {\n59\t        let c = Library::new(find_c_so()).expect(\"dlopen C libsodium.so\");\n60\t        let r = Library::new(find_rust_so()).expect(\"dlopen Rust liblibsodium.so\");\n61\t        Libs { c, r }\n62\t    })\n63\t}\n64\t\n65\t/// Look a symbol up in one library. Panics with the symbol name on failure so a\n66\t/// missing export is reported clearly rather than as an opaque dlsym error.\n67\tpub unsafe fn sym<T>(lib: &'static Library, name: &str) -> Symbol<'static, T> {\n68\t    let mut owned: Vec<u8> = Vec::with_capacity(name.len() + 1);\n69\t    owned.extend_from_slice(name.as_bytes());\n70\t    owned.push(0);\n71\t    lib.get::<T>(&owned)\n72\t        .unwrap_or_else(|e| panic!(\"symbol `{name}` not found: {e}\"))\n73\t}\n74\t\n75\t/// Get the same symbol from both libraries: `(c_fn, rust_fn)`.\n76\tpub unsafe fn pair<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n77\t    let l = libs();\n78\t    (sym::<T>(&l.c, name), sym::<T>(&l.r, name))\n79\t}\n80\t\n81\t/// Convenience wrapper: fetch a function pair, typed.\n82\t#[macro_export]\n83\tmacro_rules! fnpair {\n84\t    ($name:literal, $t:ty) => {{ unsafe { $crate::common::pair::<$t>($name) } }};\n85\t}\n86\t\n87\t// ------------------------------------------------------------------- assertion\n88\t\n89\tpub fn assert_eq_bytes(what: &str, c: &[u8], r: &[u8]) {\n90\t    if c != r {\n91\t        let n = c.len().min(r.len());\n92\t        let mut first = n;\n93\t        for i in 0..n {\n94\t            if c[i] != r[i] {\n95\t                first = i;\n96\t                break;\n97\t            }\n98\t        }\n99\t        panic!(\n100\t            \"{what}: OUTPUT MISMATCH\\n  C len={} rust len={}\\n  first differing byte at {}\\n  \\\n101\t             C   ={}\\n  rust={}\",\n102\t            c.len(),\n103\t            r.len(),\n104\t            first,\n105\t            hexs(c),\n106\t            hexs(r)\n107\t        );\n108\t    }\n109\t}\n110\t\n111\tpub fn hexs(b: &[u8]) -> String {\n112\t    const MAX: usize = 96;\n113\t    let mut s = String::new();\n114\t    for (i, x) in b.iter().enumerate() {\n115\t        if i == MAX {\n116\t            s.push_str(&format!(\"... (+{} more)\", b.len() - MAX));\n117\t            break;\n118\t        }\n119\t        s.push_str(&format!(\"{x:02x}\"));\n120\t    }\n121\t    if b.is_empty() {\n122\t        s.push_str(\"<empty>\");\n123\t    }\n124\t    s\n125\t}\n126\t\n127\t// ------------------------------------------------------- deterministic PRNG\n128\t\n129\t/// SplitMix64 — reproducible, no external dependency.\n130\tpub struct Rng(pub u64);\n131\t\n132\timpl Rng {\n133\t    pub fn new(seed: u64) -> Self {\n134\t        Rng(seed)\n135\t    }\n136\t    pub fn next_u64(&mut self) -> u64 {\n137\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n138\t        let mut z = self.0;\n139\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n140\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n141\t        z ^ (z >> 31)\n142\t    }\n143\t    pub fn next_u32(&mut self) -> u32 {\n144\t        (self.next_u64() >> 32) as u32\n145\t    }\n146\t    pub fn byte(&mut self) -> u8 {\n147\t        (self.next_u64() >> 56) as u8\n148\t    }\n149\t    pub fn fill(&mut self, b: &mut [u8]) {\n150\t        for x in b.iter_mut() {\n151\t            *x = self.byte();\n152\t        }\n153\t    }\n154\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n155\t        let mut v = vec![0u8; n];\n156\t        self.fill(&mut v);\n157\t        v\n158\t    }\n159\t    /// Uniform-ish in `[0, n)`.\n160\t    pub fn below(&mut self, n: usize) -> usize {\n161\t        if n == 0 {\n162\t            0\n163\t        } else {\n164\t            (self.next_u64() % n as u64) as usize\n165\t        }\n166\t    }\n167\t    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n168\t        &xs[self.below(xs.len())]\n169\t    }\n170\t}\n171\t\n172\t/// The fixed seed used across all property-style rows, so failures reproduce.\n173\tpub const SEED: u64 = 0x5EED_1234_5EED_1234;\n174\t\n175\t// ------------------------------------------------ forked abort/misuse checking\n176\t\n177\t#[derive(Debug, PartialEq, Eq, Clone, Copy)]\n178\tpub enum Outcome {\n179\t    /// The call returned normally with this value.\n180\t    Returned(i64),\n181\t    /// The process died from this signal (SIGABRT == 6 for `sodium_misuse()`).\n182\t    Signaled(i32),\n183\t}\n184\t\n185\t/// Run `f` in a forked child so that a `sodium_misuse()` -> `abort()` can be\n186\t/// observed without killing the test runner. Used for every `misuse` row in\n187\t/// ERRORS.md: both the C and the Rust library must abort on the same input.\n188\tpub fn forked<F: FnOnce() -> i64>(f: F) -> Outcome {\n189\t    unsafe {\n190\t        // Flush so the child does not duplicate buffered output.\n191\t        libc::fflush(std::ptr::null_mut());\n192\t        let pid = libc::fork();\n193\t        assert!(pid >= 0, \"fork failed\");\n194\t        if pid == 0 {\n195\t            // Child: silence stderr so abort() messages do not spam the log.\n196\t            let devnull = libc::open(b\"/dev/null\\0\".as_ptr() as *const libc::c_char, libc::O_WRONLY);\n197\t            if devnull >= 0 {\n198\t                libc::dup2(devnull, 2);\n199\t            }\n200\t            let v = f();\n201\t            // Encode a normal return in the low 7 bits + a marker.\n202\t            libc::_exit(if (0..=100).contains(&v) { v as i32 } else { 101 });\n203\t        }\n204\t        let mut status: i32 = 0;\n205\t        let w = libc::waitpid(pid, &mut status, 0);\n206\t        assert_eq!(w, pid, \"waitpid failed\");\n207\t        if libc::WIFSIGNALED(status) {\n208\t            Outcome::Signaled(libc::WTERMSIG(status))\n209\t        } else {\n210\t            Outcome::Returned(libc::WEXITSTATUS(status) as i64)\n211\t        }\n212\t    }\n213\t}\n214\t\n215\tpub const SIGABRT: i32 = 6;\n216\t\n217\t/// Assert that C and Rust behave identically for a branch that ends in\n218\t/// `sodium_misuse()` (or any other fatal path).\n219\tpub fn assert_same_fatal(what: &str, c: Outcome, r: Outcome) {\n220\t    assert_eq!(\n221\t        c, r,\n222\t        \"{what}: C and Rust disagree on the fatal/abort path (C={c:?} rust={r:?})\"\n223\t    );\n224\t}\n225\t\n226\t// ---------------------------------------------------- injected randombytes RNG\n227\t//\n228\t// `struct randombytes_implementation` — field order and signatures taken\n229\t// verbatim from c_src/libsodium/include/sodium/randombytes.h.\n230\t\n231\t#[repr(C)]\n232\tpub struct RandombytesImpl {\n233\t    pub implementation_name: Option<extern \"C\" fn() -> *const libc::c_char>,\n234\t    pub random: Option<extern \"C\" fn() -> u32>,\n235\t    pub stir: Option<extern \"C\" fn()>,\n236\t    pub uniform: Option<extern \"C\" fn(u32) -> u32>,\n237\t    pub buf: Option<extern \"C\" fn(*mut c_void, usize)>,\n238\t    pub close: Option<extern \"C\" fn() -> libc::c_int>,\n239\t}\n240\t\n241\t// Two INDEPENDENT counter states so the C library and the Rust library each see\n242\t// the same deterministic stream instead of interleaving one shared counter.\n243\tstatic mut CTR_C: u64 = 0;\n244\tstatic mut CTR_R: u64 = 0;\n245\t\n246\tconst IMPL_NAME: &[u8] = b\"difftest\\0\";\n247\t\n248\textern \"C\" fn name_cb() -> *const libc::c_char {\n249\t    IMPL_NAME.as_ptr() as *const libc::c_char\n250\t}\n251\textern \"C\" fn stir_cb() {}\n252\textern \"C\" fn close_cb() -> libc::c_int {\n253\t    0\n254\t}\n255\t\n256\t#[inline]\n257\tfn step(ctr: &mut u64) -> u64 {\n258\t    *ctr = ctr.wrapping_add(0x9E37_79B9_7F4A_7C15);\n259\t    let mut z = *ctr;\n260\t    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n261\t    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n262\t    z ^ (z >> 31)\n263\t}\n264\t\n265\textern \"C\" fn random_c() -> u32 {\n266\t    unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_C)) >> 32) as u32 }\n267\t}\n268\textern \"C\" fn random_r() -> u32 {\n269\t    unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_R)) >> 32) as u32 }\n270\t}\n271\textern \"C\" fn buf_c(p: *mut c_void, n: usize) {\n272\t    let s = unsafe { std::slice::from_raw_parts_mut(p as *mut u8, n) };\n273\t    for x in s.iter_mut() {\n274\t        *x = unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_C)) >> 56) as u8 };\n275\t    }\n276\t}\n277\textern \"C\" fn buf_r(p: *mut c_void, n: usize) {\n278\t    let s = unsafe { std::slice::from_raw_parts_mut(p as *mut u8, n) };\n279\t    for x in s.iter_mut() {\n280\t        *x = unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_R)) >> 56) as u8 };\n281\t    }\n282\t}\n283\t/// A custom `uniform` so the delegation path (impl->uniform != NULL) is covered.\n284\textern \"C\" fn uniform_c(ub: u32) -> u32 {\n285\t    if ub < 2 { 0 } else { random_c() % ub }\n286\t}\n287\textern \"C\" fn uniform_r(ub: u32) -> u32 {\n288\t    if ub < 2 { 0 } else { random_r() % ub }\n289\t}\n290\t\n291\tpub static mut IMPL_C: RandombytesImpl = RandombytesImpl {\n292\t    implementation_name: Some(name_cb),\n293\t    random: Some(random_c),\n294\t    stir: Some(stir_cb),\n295\t    uniform: None,\n296\t    buf: Some(buf_c),\n297\t    close: Some(close_cb),\n298\t};\n299\tpub static mut IMPL_R: RandombytesImpl = RandombytesImpl {\n300\t    implementation_name: Some(name_cb),\n301\t    random: Some(random_r),\n302\t    stir: Some(stir_cb),\n303\t    uniform: None,\n304\t    buf: Some(buf_r),\n305\t    close: Some(close_cb),\n306\t};\n307\tpub static mut IMPL_C_UNIF: RandombytesImpl = RandombytesImpl {\n308\t    implementation_name: Some(name_cb),\n309\t    random: Some(random_c),\n310\t    stir: Some(stir_cb),\n311\t    uniform: Some(uniform_c),\n312\t    buf: Some(buf_c),\n313\t    close: Some(close_cb),\n314\t};\n315\tpub static mut IMPL_R_UNIF: RandombytesImpl = RandombytesImpl {\n316\t    implementation_name: Some(name_cb),\n317\t    random: Some(random_r),\n318\t    stir: Some(stir_cb),\n319\t    uniform: Some(uniform_r),\n320\t    buf: Some(buf_r),\n321\t    close: Some(close_cb),\n322\t};\n323\t\n324\ttype SetImpl = unsafe extern \"C\" fn(*const RandombytesImpl) -> libc::c_int;\n325\t\n326\t/// Install the deterministic RNG into BOTH libraries and reset both counters,\n327\t/// so that any `*_keygen` / `*_random` output is byte-comparable.\n328\tpub fn install_det_rng(with_uniform: bool) {\n329\t    let (c, r) = unsafe { pair::<SetImpl>(\"randombytes_set_implementation\") };\n330\t    unsafe {\n331\t        CTR_C = 0;\n332\t        CTR_R = 0;\n333\t        if with_uniform {\n334\t            c(std::ptr::addr_of!(IMPL_C_UNIF));\n335\t            r(std::ptr::addr_of!(IMPL_R_UNIF));\n336\t        } else {\n337\t            c(std::ptr::addr_of!(IMPL_C));\n338\t            r(std::ptr::addr_of!(IMPL_R));\n339\t        }\n340\t    }\n341\t}\n342\t\n343\t/// Reset both deterministic counters to the same point.\n344\tpub fn reset_det_rng() {\n345\t    unsafe {\n346\t        CTR_C = 0;\n347\t        CTR_R = 0;\n348\t    }\n349\t}\n350\t\n351\t// ------------------------------------------------------------------ init once\n352\t\n353\tstatic INIT: OnceLock<()> = OnceLock::new();\n354\t\n355\t/// Call `sodium_init()` on both libraries exactly once per test process.\n356\tpub fn init_both() {\n357\t    INIT.get_or_init(|| {\n358\t        let (c, r) = unsafe { pair::<unsafe extern \"C\" fn() -> libc::c_int>(\"sodium_init\") };\n359\t        let (rc, rr) = unsafe { (c(), r()) };\n360\t        assert_eq!(rc, rr, \"sodium_init() first-call return differs\");\n361\t        assert!(rc == 0 || rc == 1, \"sodium_init() returned {rc}\");\n362\t    });\n363\t}\n364\t\n365\t// --------------------------------------------------------------- misc helpers\n366\t\n367\t/// Standard length sweep used by most hash/stream rows.\n368\tpub const LENS: &[usize] = &[\n369\t    0, 1, 2, 3, 7, 8, 15, 16, 17, 31, 32, 33, 55, 56, 63, 64, 65, 71, 72, 73, 111, 112, 127, 128,\n370\t    129, 135, 136, 137, 143, 144, 167, 168, 169, 191, 192, 255, 256, 257, 271, 272, 336, 337, 383,\n371\t    384, 512, 513, 1000, 1024,\n372\t];\n373\t\n374\t/// Interesting fixed byte patterns for keys/nonces.\n375\tpub fn patterns(n: usize, rng: &mut Rng) -> Vec<Vec<u8>> {\n376\t    vec![\n377\t        vec![0u8; n],\n378\t        vec![0xffu8; n],\n379\t        (0..n).map(|i| i as u8).collect(),\n380\t        rng.bytes(n),\n381\t        rng.bytes(n),\n382\t    ]\n383\t}\n384\t"}]},"parent_tool_use_id":"toolu_bdrk_01KNkPmwdpAPnqM1jGTvs6a2","session_id":"94902601-9803-4a17-b8b6-a77154607051","uuid":"ec69dd32-9837-4cf9-a675-943a9900c9ea","timestamp":"2026-08-14T16:45:31.857Z","subagent_type":"general-purpose","task_description":"Write codecs differential tests"}
