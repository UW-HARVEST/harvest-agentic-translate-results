= inlen;\n54\t        }\n55\t        core_xor_bytes(s.state.as_mut_ptr(), input, s.offset, chunk_size);\n56\t        s.offset += chunk_size;\n57\t        consumed = chunk_size;\n58\t        if s.offset == s.rate && consumed < inlen {\n59\t            core_permute_24(s.state.as_mut_ptr());\n60\t            s.offset = 0;\n61\t        }\n62\t    }\n63\t    while inlen - consumed >= s.rate {\n64\t        core_xor_bytes(s.state.as_mut_ptr(), input.add(consumed), 0, s.rate);\n65\t        consumed += s.rate;\n66\t        s.offset = s.rate;\n67\t        if consumed < inlen {\n68\t            core_permute_24(s.state.as_mut_ptr());\n69\t            s.offset = 0;\n70\t        }\n71\t    }\n72\t    if consumed < inlen {\n73\t        let chunk_size = inlen - consumed;\n74\t        core_xor_bytes(s.state.as_mut_ptr(), input.add(consumed), 0, chunk_size);\n75\t        s.offset = chunk_size;\n76\t    }\n77\t    ret\n78\t}\n79\t\n80\tunsafe fn sha3_final(state: *mut Sha3StateInternal, out: *mut u8) -> i32 {\n81\t    let s = &mut *state;\n82\t    let mut pad: u8;\n83\t    let mut ret = 0i32;\n84\t\n85\t    if s.phase != SHA3_PHASE_ABSORBING {\n86\t        core_permute_24(s.state.as_mut_ptr());\n87\t        ret = -1;\n88\t    } else {\n89\t        if s.offset == s.rate {\n90\t            core_permute_24(s.state.as_mut_ptr());\n91\t            s.offset = 0;\n92\t        }\n93\t        if s.offset == s.rate - 1 {\n94\t            pad = SHA3_DOMAIN ^ 0x80;\n95\t            core_xor_bytes(s.state.as_mut_ptr(), &pad, s.offset, 1);\n96\t        } else {\n97\t            pad = SHA3_DOMAIN;\n98\t            core_xor_bytes(s.state.as_mut_ptr(), &pad, s.offset, 1);\n99\t            pad = 0x80;\n100\t            core_xor_bytes(s.state.as_mut_ptr(), &pad, s.rate - 1, 1);\n101\t        }\n102\t        core_permute_24(s.state.as_mut_ptr());\n103\t    }\n104\t    core_extract_bytes(s.state.as_ptr(), out, 0, s.outlen);\n105\t    s.offset = 0;\n106\t    s.phase = SHA3_PHASE_FINALIZED;\n107\t    ret\n1