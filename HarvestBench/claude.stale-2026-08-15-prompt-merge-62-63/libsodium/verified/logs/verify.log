t = argon2_context {\n1136\t        out,\n1137\t        outlen: hashlen as u32,\n1138\t        pwd: pwd as *mut u8,\n1139\t        pwdlen: pwdlen as u32,\n1140\t        salt: salt as *mut u8,\n1141\t        saltlen: saltlen as u32,\n1142\t        secret: core::ptr::null_mut(),\n1143\t        secretlen: 0,\n1144\t        ad: core::ptr::null_mut(),\n1145\t        adlen: 0,\n1146\t        t_cost,\n1147\t        m_cost,\n1148\t        lanes: parallelism,\n1149\t        threads: parallelism,\n1150\t        flags: ARGON2_DEFAULT_FLAGS,\n1151\t    };\n1152\t\n1153\t    let result = _sodium_argon2_ctx(&mut context, type_);\n1154\t\n1155\t    if result != ARGON2_OK {\n1156\t        sodium_memzero(out as *mut c_void, hashlen);\n1157\t        libc::free(out as *mut c_void);\n1158\t        return result;\n1159\t    }\n1160\t\n1161\t    if !encoded.is_null() && encodedlen != 0 {\n1162\t        if _sodium_argon2_encode_string(encoded, encodedlen, &mut context, type_) != ARGON2_OK {\n1163\t            sodium_memzero(out as *mut c_void, hashlen);\n1164\t            sodium_memzero(encoded as *mut c_void, encodedlen);\n1165\t            libc::free(out as *mut c_void);\n1166\t            return ARGON2_ENCODING_FAIL;\n1167\t        }\n1168\t    }\n1169\t\n1170\t    if !hash.is_null() {\n1171\t        core::ptr::copy_nonoverlapping(out, hash as *mut u8, hashlen);\n1172\t    }\n1173\t\n1174\t    sodium_memzero(out as *mut c_void, hashlen);\n1175\t    libc::free(out as *mut c_void);\n1176\t\n1177\t    ARGON2_OK\n1178\t}\n1179\t\n1180\t#[unsafe(no_mangle)]\n1181\tpub unsafe extern \"C\" fn _sodium_argon2i_hash_encoded(\n1182\t    t_cost: u32,\n1183\t    m_cost: u32,\n1184\t    parallelism: u32,\n1185\t    pwd: *const c_void,\n1186\t    pwdlen: usize,\n1187\t    salt: *const c_void,\n1188\t    saltlen: usize,\n1189\t    hashlen: usize,\n1190\t    encoded: *mut c_char,\n1191\t    encodedlen: usize,\n1192\t) -> c_int {\n1193\t    _sodium_argon2_hash(\n1194\t        t_cost,\n1195\t        m_co