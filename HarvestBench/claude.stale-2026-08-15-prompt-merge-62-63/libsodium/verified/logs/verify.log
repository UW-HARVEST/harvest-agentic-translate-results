----------------------------------------------------------\n1392\t\n1393\tunsafe fn c_strlen(mut p: *const u8) -> usize {\n1394\t    let mut n = 0usize;\n1395\t    while *p != 0 {\n1396\t        n += 1;\n1397\t        p = p.add(1);\n1398\t    }\n1399\t    n\n1400\t}\n1401\t\n1402\t/// Returns true if `p` starts with `prefix`.\n1403\tunsafe fn starts_with(p: *const u8, prefix: &[u8]) -> bool {\n1404\t    for (i, &b) in prefix.iter().enumerate() {\n1405\t        if *p.add(i) != b {\n1406\t            return false;\n1407\t        }\n1408\t    }\n1409\t    true\n1410\t}\n1411\t\n1412\tfn decode_decimal(str_: *const u8, v: &mut u64) -> *const u8 {\n1413\t    unsafe {\n1414\t        let mut acc: u64 = 0;\n1415\t        let orig = str_;\n1416\t        let mut s = str_;\n1417\t        loop {\n1418\t            let c = *s as i32;\n1419\t            if c < b'0' as i32 || c > b'9' as i32 {\n1420\t                break;\n1421\t            }\n1422\t            let c = c - b'0' as i32;\n1423\t            if acc > (u64::MAX / 10) {\n1424\t                return core::ptr::null();\n1425\t            }\n1426\t            acc *= 10;\n1427\t            if (c as u64) > (u64::MAX - acc) {\n1428\t                return core::ptr::null();\n1429\t            }\n1430\t            acc += c as u64;\n1431\t            s = s.add(1);\n1432\t        }\n1433\t        if s == orig || (*orig == b'0' && s != orig.add(1)) {\n1434\t            return core::ptr::null();\n1435\t        }\n1436\t        *v = acc;\n1437\t        s\n1438\t    }\n1439\t}\n1440\t\n1441\t#[unsafe(no_mangle)]\n1442\tpub unsafe extern \"C\" fn _sodium_argon2_decode_string(\n1443\t    ctx: *mut argon2_context,\n1444\t    str_: *const c_char,\n1445\t    type_: c_int,\n1446\t) -> c_int {\n1447\t    let ctxr = &mut *ctx;\n1448\t    let mut str_ = str_ as *const u8;\n1449\t\n1450\t    let maxsaltlen = ctxr.saltlen as usize;\n1451\t    let maxoutlen = ctxr.outlen as usize;\n1452\t    let mut version: u32 = 0;\n1453\t\n1454\t    ctxr.saltlen = 0;\n1455\t    ctxr.outlen = 0;\n1456\t\n1457\t    // CC prefix helper (returns false -> DECODING_FAIL)\n1458\t    macro_rules! cc {\n1459\t        ($prefix:expr) => {{\n1460\t            let prefix: &[u8] = $prefix;\n1461\t            if !starts_with(str_, prefix) {\n1462\t                return ARGON2_DECODING_FAIL;\n1463\t            }\n1464\t            str_ = str_.add(prefix.len());\n1465\t        }};\n1466\t    }\n1467\t\n1468\t    macro_rules! decimal_u32 {\n1469\t        ($x:expr) => {{\n1470\t            let mut dec_x: u64 = 0;\n1471\t            str_ = decode_decimal(str_, &mut dec_x);\n1472\t            if str_.is_null() || dec_x > u32::MAX as u64 {\n1473\t                return ARGON2_DECODING_FAIL;\n1474\t            }\n1475\t            $x = dec_x as u32;\n1476\t        }};\n1477\t    }\n1478\t\n1479\t    if type_ == ARGON2_ID {\n1480\t        cc!(b\"$argon2id\");\n1481\t    } else if type_ == ARGON2_I {\n1482\t        cc!(b\"$argon2i\");\n1483\t    } else {\n1484\t        return ARGON2_INCORRECT_TYPE;\n1485\t    }\n1486\t    cc!(b\"$v=\");\n1487\t    decimal_u32!(version);\n1488\t    if version != ARGON2_VERSION_NUMBER {\n1489\t        return ARGON2_INCORRECT_TYPE;\n1490\t    }\n1491\t    cc!(b\"$m=\");\n1492\t    decimal_u32!(ctxr.m_cost);\n1493\t    cc!(b\",t=\");\n1494\t    decimal_u32!(ctxr.t_cost);\n1495\t    cc!(b\",p=\");\n1496\t    decimal_u32!(ctxr.lanes);\n1497\t    ctxr.threads = ctxr.lanes;\n1498\t\n1499\t    // BIN(salt)\n1500\t    cc!(b\"$\");\n1501\t    {\n1502\t        let mut bin_len: usize = maxsaltlen;\n1503\t        let mut str_end: *const c_char = core::ptr::null();\n1504\t        if sodium_base642bin(\n1505\t            ctxr.salt,\n1506\t            maxsaltlen,\n1507\t            str_ as *const c_char,\n1508\t            c_strlen(str_),\n1509\t            core::ptr::null(),\n1510\t            &mut bin_len,\n1511\t            &mut str_end,\n1512\t            SODIUM_BASE64_VARIANT_ORIGINAL_NO_PADDING,\n1513\t        ) != 0\n1514\t            || bin_len > u32::MAX as usize\n1515\t        {\n1516\t            return ARGON2_DECODING_FAIL;\n1517\t        }\n1518\t        ctxr.saltlen = bin_len as u32;\n1519\t        str_ = str_end as *const u8;\n1520\t    }\n1521\t    cc!(b\"$\");\n1522\t    {\n1523\t        let mut bin_len: usize = maxoutlen;\n1524\t        let mut str_end: *const c_char = core::ptr::null();\n1525\t        if sodium_base642bin(\n1526\t            ctxr.out,\n1527\t            maxoutlen,\n1528\t            str_ as *const c_char,\n1529\t            c_strlen(str_),\n1530\t            core::ptr::null(),\n1531\t            &mut bin_len,\n1532\t            &mut str_end,\n1533\t            SODIUM_BASE64_VARIANT_ORIGINAL_NO_PADDING,\n1534\t        ) != 0\n1535\t            || bin_len > u32::MAX as usize\n1536\t        {\n1537\t            return ARGON2_DECODING_FAIL;\n1538\t        }\n1539\t        ctxr.outlen = bin_len as u32;\n1540\t        str_ = str_end as *const u8;\n1541\t    }\n1542\t    let validation_result = _sodium_argon2_validate_inputs(ctx);\n1543\t    if validation_result != ARGON2_OK {\n1544\t        return validation_result;\n1545\t    }\n1546\t    if *str_ == 0 {\n1547\t        return ARGON2_OK;\n1548\t    }\n1549\t    ARGON2_DECODING_FAIL\n1550\t}\n1551\t\n1552\tconst U32_STR_MAXSIZE: usize = 11;\n1553\t\n1554\tfn u32_to_string(str_: *mut u8, mut x: u32) {\n1555\t    unsafe {\n1556\t        let mut tmp = [0u8; U32_STR_MAXSIZE - 1]; // 10\n1557\t        let mut i = tmp.len();\n1558\t        loop {\n1559\t            i -= 1;\n1560\t            tmp[i] = ((x % 10) as u8) + b'0';\n1561\t            x /= 10;\n1562\t            if x == 0 || i == 0 {\n1563\t                break;\n1564\t            }\n1565\t        }\n1566\t        let len = tmp.len() - i;\n1567\t        core::ptr::copy_nonoverlapping(tmp.as_ptr().add(i), str_, len);\n1568\t        *str_.add(len) = 0;\n1569\t    }\n1570\t}\n1571\t\n1572\t#[unsafe(no_mangle)]\n1573\tpub unsafe extern \"C\" fn _sodium_arg