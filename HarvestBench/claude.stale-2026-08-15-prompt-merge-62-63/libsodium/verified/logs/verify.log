{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013g9iZDXRdmKrkQ8q41JEKF","type":"tool_result","content":"1\t//! Harness smoke test + Phase D symbol-parity assertion.\n2\tmod common;\n3\tuse common::*;\n4\tuse libc::{c_char, c_int, c_uchar};\n5\tuse std::ffi::CStr;\n6\t\n7\t#[test]\n8\tfn version_and_constants_match() {\n9\t    init_both();\n10\t    let (c, r) = fnpair!(\"sodium_version_string\", unsafe extern \"C\" fn() -> *const c_char);\n11\t    let (cs, rs) = unsafe { (CStr::from_ptr(c()), CStr::from_ptr(r())) };\n12\t    assert_eq!(cs, rs, \"sodium_version_string differs\");\n13\t\n14\t    for n in [\n15\t        \"sodium_library_version_major\",\n16\t        \"sodium_library_version_minor\",\n17\t        \"sodium_library_minimal\",\n18\t    ] {\n19\t        let (c, r) = unsafe { pair::<unsafe extern \"C\" fn() -> c_int>(n) };\n20\t        assert_eq!(unsafe { c() }, unsafe { r() }, \"{n} differs\");\n21\t    }\n22\t}\n23\t\n24\t#[test]\n25\tfn verify_16_32_64_differential() {\n26\t    init_both();\n27\t    let mut rng = Rng::new(SEED);\n28\t    for (name, n) in [(\"crypto_verify_16\", 16usize), (\"crypto_verify_32\", 32), (\"crypto_verify_64\", 64)] {\n29\t        let (c, r) =\n30\t            unsafe { pair::<unsafe extern \"C\" fn(*const c_uchar, *const c_uchar) -> c_int>(name) };\n31\t        for _ in 0..64 {\n32\t            let a = rng.bytes(n);\n33\t            // equal\n34\t            assert_eq!(unsafe { c(a.as_ptr(), a.as_ptr()) }, unsafe {\n35\t                r(a.as_ptr(), a.as_ptr())\n36\t            });\n37\t            // differ at every position\n38\t            for i in 0..n {\n39\t                let mut b = a.clone();\n40\t                b[i] ^= 0x80;\n41\t                let (rc, rr) = unsafe { (c(a.as_ptr(), b.as_ptr()), r(a.as_ptr(), b.as_ptr())) };\n42\t                assert_eq!(rc, rr, \"{name} differs at byte {i}\");\n43\t            }\n44\t        }\n45\t        // all-zero vs all-ff\n46\t        let z = vec![0u8; n];\n47\t        let f = vec![0xffu8; n];\n48\t        assert_eq!(unsafe { c(z.as_ptr(), f.as_ptr()) }, unsafe {\n49\t            r(z.as_ptr(), f.as_ptr())\n50\t        });\n51\t    }\n52\t}\n53\t\n54\t/// ERRORS row 2: `sodium_bin2hex` misuse when `hex_maxlen <= bin_len*2`.\n55\t/// Demonstrates the forked-abort mechanism used for every `misuse` row.\n56\t#[test]\n57\tfn forked_misuse_mechanism_works() {\n58\t    init_both();\n59\t    let l = libs();\n60\t    let run = |lib: &'static libloading::Library| -> Outcome {\n61\t        forked(|| {\n62\t            let f = unsafe {\n63\t                sym::<unsafe extern \"C\" fn(*mut c_char, usize, *const c_uchar, usize) -> *mut c_char>(\n64\t                    lib,\n65\t                    \"sodium_bin2hex\",\n66\t                )\n67\t            };\n68\t            let bin = [1u8, 2, 3];\n69\t            let mut out = [0u8; 8];\n70\t            // hex_maxlen == 6 == bin_len*2  -> must abort\n71\t            unsafe { f(out.as_mut_ptr() as *mut c_char, 6, bin.as_ptr(), 3) };\n72\t            0\n73\t        })\n74\t    };\n75\t    let (oc, or) = (run(&l.c), run(&l.r));\n76\t    assert_same_fatal(\"sodium_bin2hex hex_maxlen<=2*bin_len\", oc, or);\n77\t    assert_eq!(oc, Outcome::Signaled(SIGABRT), \"expected SIGABRT, got {oc:?}\");\n78\t}\n79\t\n80\t/// Phase D: the Rust `.so` must export every symbol the C `.so` exports.\n81\t#[test]\n82\tfn symbol_parity() {\n83\t    use std::process::Command;\n84\t    let root = std::path::PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"));\n85\t    let nm = |p: &std::path::Path| -> Vec<String> {\n86\t        let o = Command::new(\"nm\")\n87\t            .args([\"-D\", \"--defined-only\", p.to_str().unwrap()])\n88\t            .output()\n89\t            .expect(\"run nm\");\n90\t        let mut v: Vec<String> = String::from_utf8_lossy(&o.stdout)\n91\t            .lines()\n92\t            .filter_map(|l| l.split_whitespace().nth(2).map(|s| s.to_string()))\n93\t            .collect(