1736\t    ARGON2_MEMLIMIT_MIN\n1737\t}\n1738\t#[unsafe(no_mangle)]\n1739\tpub extern \"C\" fn crypto_pwhash_argon2i_memlimit_max() -> usize {\n1740\t    ARGON2_MEMLIMIT_MAX\n1741\t}\n1742\t#[unsafe(no_mangle)]\n1743\tpub extern \"C\" fn crypto_pwhash_argon2i_opslimit_interactive() -> u64 {\n1744\t    4\n1745\t}\n1746\t#[unsafe(no_mangle)]\n1747\tpub extern \"C\" fn crypto_pwhash_argon2i_memlimit_interactive() -> usize {\n1748\t    33554432\n1749\t}\n1750\t#[unsafe(no_mangle)]\n1751\tpub extern \"C\" fn crypto_pwhash_argon2i_opslimit_moderate() -> u64 {\n1752\t    6\n1753\t}\n1754\t#[unsafe(no_mangle)]\n1755\tpub extern \"C\" fn crypto_pwhash_argon2i_memlimit_moderate() -> usize {\n1756\t    134217728\n1757\t}\n1758\t#[unsafe(no_mangle)]\n1759\tpub extern \"C\" fn crypto_pwhash_argon2i_opslimit_sensitive() -> u64 {\n1760\t    8\n1761\t}\n1762\t#[unsafe(no_mangle)]\n1763\tpub extern \"C\" fn crypto_pwhash_argon2i_memlimit_sensitive() -> usize {\n1764\t    536870912\n1765\t}\n1766\t\n1767\t#[unsafe(no_mangle)]\n1768\tpub unsafe extern \"C\" fn crypto_pwhash_argon2i(\n1769\t    out: *mut u8,\n1770\t    outlen: u64,\n1771\t    passwd: *const c_char,\n1772\t    passwdlen: u64,\n1773\t    salt: *const u8,\n1774\t    opslimit: u64,\n1775\t    memlimit: usize,\n1776\t    alg: c_int,\n1777\t) -> c_int {\n1778\t    core::ptr::write_bytes(out, 0, outlen as usize);\n1779\t    if outlen > ARGON2_BYTES_MAX as u64 {\n1780\t        set_errno(libc::EFBIG);\n1781\t        return -1;\n1782\t    }\n1783\t    if outlen < ARGON2_BYTES_MIN as u64 {\n1784\t        set_errno(libc::EINVAL);\n1785\t        return -1;\n1786\t    }\n1787\t    if passwdlen > ARGON2_PASSWD_MAX as u64\n1788\t        || opslimit > ARGON2_OPSLIMIT_MAX\n1789\t        || memlimit > ARGON2_MEMLIMIT_MAX\n1790\t    {\n1791\t        set_errno(libc::EFBIG);\n1792\t        return -1;\n1793\t    }\n1794\t    if passwdlen < ARGON2_PASSWD_MIN as u64\n1795\t        || opslimit < ARGON2I_OPSLIMIT_MIN\n1796\t        || memlimit < ARGON2I_MEMLIMIT_MIN\n1797\t    {\n1798\t        set_errno(libc::EINVAL);\n1799\t        return -1;\n1800\t    }\n1801\t    if out as *const c_void == passwd as *const c_void {\n1802\t        set_errno(libc::EINVAL);\n1803\t        return -1;\n1804\t    }\n1805\t    match alg {\n1806\t        ARGON2I_ALG_ARGON2I13 => {\n1807\t            if _sodium_argon2i_hash_raw(\n1808\t                opslimit as u32,\n1809\t                (memlimit / 1024) as u32,\n1810\t                1,\n1811\t                passwd as *const c_void,\n1812\t                passwdlen as usize,\n1813\t                salt as *const c_void,\n1814\t                ARGON2_SALTBYTES,\n1815\t                out as *mut c_void,\n1816\t                outlen as usize,\n1817\t            ) != ARGON2_OK\n1818\t            {\n1819\t                return -1;\n1820\t            }\n1821\t            0\n1822\t        }\n1823\t        _ => {\n1824\t            set_errno(libc::EINVAL);\n1825\t            -1\n1826\t        }\n1827\t    }\n1828\t}\n1829\t\n1830\t#[unsafe(no_mangle)]\n1831\tpub unsafe extern \"C\" fn crypto_pwhash_argon2i_str(\n1832\t    out: *mut c_char,\n1833\t    passwd: *const c_char,\n1834\t    passwdlen: u64,\n1835\t    opslimit: u64,\n1836\t    memlimit: usize,\n1837\t) -> c_int {\n1838\t    let mut salt = [0u8; ARGON2_SALTBYTES];\n1839\t\n1840\t    core::ptr::write_bytes(out, 0, ARGON2_STRBYTES);\n1841\t    if passwdlen > ARGON2_PASSWD_MAX as u64\n1842\t        || opslimit > ARGON2_OPSLIMIT_MAX\n1843\t        || memlimit > ARGON2_MEMLIMIT_MAX\n1844\t    {\n1845\t        set_errno(libc::EFBIG);\n1846\t        return -1;\n1847\t    }\n1848\t    if passwdlen < ARGON2_PASSWD_MIN as u64\n1849\t        || opslimit < ARGON2I_OPSLIMIT_MIN\n1850\t        || memlimit < ARGON2I_MEMLIMIT_MIN\n1851\t    {\n1852\t        set_errno(libc::EINVAL);\n1853\t        return -1;\n1854\t    }\n1855\t    randombytes_buf(salt.as_mut_ptr() as *mut c_void, ARGON2_SALTBYTES);\n1856\t    if _sodium_argon2i_hash_en