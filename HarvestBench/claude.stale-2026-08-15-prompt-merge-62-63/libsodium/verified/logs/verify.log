returns crypto_generichash_PRIMITIVE, never NULL | \"blake2b\"\n\n\nDELIVERABLE 2 — CONFIG AXES / SHAPES (valid inputs the code branches on)\n\n--- CONSTANTS (name = numeric value) ---\ncrypto_sign_BYTES = crypto_sign_ed25519_BYTES = 64 | crypto_sign_SEEDBYTES = crypto_sign_ed25519_SEEDBYTES = 32 | crypto_sign_PUBLICKEYBYTES = crypto_sign_ed25519_PUBLICKEYBYTES = 32 | crypto_sign_SECRETKEYBYTES = crypto_sign_ed25519_SECRETKEYBYTES = 32+32 = 64 | crypto_sign_MESSAGEBYTES_MAX = SODIUM_SIZE_MAX - 64 | crypto_sign_PRIMITIVE = \"ed25519\" | sizeof(crypto_sign_state) = sizeof(crypto_sign_ed25519ph_state) = sizeof(crypto_hash_sha512_state)\ncrypto_scalarmult_BYTES = crypto_scalarmult_curve25519_BYTES = 32 | crypto_scalarmult_SCALARBYTES = crypto_scalarmult_curve25519_SCALARBYTES = 32 | crypto_scalarmult_PRIMITIVE = \"curve25519\" | crypto_scalarmult_ed25519_BYTES = 32 | crypto_scalarmult_ed25519_SCALARBYTES = 32 | crypto_scalarmult_ristretto255_BYTES = 32 | crypto_scalarmult_ristretto255_SCALARBYTES = 32\ncrypto_core_ed25519_BYTES = 32 | crypto_core_ed25519_UNIFORMBYTES = 32 | crypto_core_ed25519_HASHBYTES = 64 | crypto_core_ed25519_SCALARBYTES = 32 | crypto_core_ed25519_NONREDUCEDSCALARBYTES = 64 | crypto_core_ed25519_H2CSHA256 = 1 | crypto_core_ed25519_H2CSHA512 = 2 | HASH_GE_L = 48 | HASH_SC_L = 48\ncrypto_core_ristretto255_BYTES = 32 | _HASHBYTES = 64 | _SCALARBYTES = 32 | _NONREDUCEDSCALARBYTES = 64 | _H2CSHA256 = 1 | _H2CSHA512 = 2\nCORE_H2C_SHA256 = 1 | CORE_H2C_SHA512 = 2 | sha256 HASH_BLOCKBYTES = 64 | sha512 HASH_BLOCKBYTES = 128\nL (group order) = 2^252 + 27742317777372353535851937790883648493 = little-endian bytes ed d3 f5 5c 1a 63 12 58 d6 9c f7 a2 de f9 de 14 00*15 10\ncrypto_core_hchacha20_OUTPUTBYTES = 32, _INPUTBYTES = 16, _KEYBYTES = 32, _CONSTBYTES = 16\ncrypto_core_hsalsa20_OUTPUTBYTES = 32, _INPUTBYTES = 16, _KEYBYTES = 32, _CONSTBYTES = 16\ncrypto_core_salsa20_OUTPUTBYTES = 64, _INPUTBYTES = 16, _KEYBYTES = 32, _CONSTBYTES = 16 (identical for salsa2012 / salsa208)\ncrypto_verify_16_BYTES = 16 | crypto_verify_32_BYTES = 32 | crypto_verify_64_BYTES = 64\ncrypto_generichash_BYTES_MIN = 16 | _BYTES = 32 | _BYTES_MAX = 64 | _KEYBYTES_MIN = 16 | _KEYBYTES = 32 | _KEYBYTES_MAX = 64 | crypto_generichash_blake2b_SALTBYTES = 16 | _PERSONALBYTES = 16 | crypto_generichash_PRIMITIVE = \"blake2b\" | statebytes = 384 (opaque[384]) | BLAKE2B_BLOCKBYTES = 128 | BLAKE2B_OUTBYTES = 64 | BLAKE2B_KEYBYTES = 64 | BLAKE2B_SALTBYTES = 16 | BLAKE2B_PERSONALBYTES = 16 | sizeof(blake2b_param) = 64\ncrypto_hash_BYTES = crypto_hash_sha512_BYTES = 64 | crypto_hash_sha256_BYTES = 32 | crypto_hash_PRIMITIVE = \"sha512\" | crypto_hash_sha3256_BYTES = 32 | crypto_hash_sha3512_BYTES = 64 | sha3 states are opaque[256], CRYPTO_ALIGN(16) | SHA3_256_RATE = 136 | SHA3_512_RATE = 72 | SHA3_DOMAIN = 0x06 | sha256 block = 64 | sha512 block = 128\ncrypto_xof_shake128_BLOCKBYTES = 168, _STATEBYTES = 256, _DOMAIN_STANDARD = 0x1F, SHAKE128_RATE = 168\ncrypto_xof_shake256_BLOCKBYTES = 136, _STATEBYTES = 256, _DOMAIN_STANDARD = 0x1F, SHAKE256_RATE = 136\ncrypto_xof_turboshake128_BLOCKBYTES = 168, _STATEBYTES = 256, _DOMAIN_STANDARD = 0x1F, TURBOSHAKE128_RATE = 168 (12-round permute)\ncrypto_xof_turboshake256_BLOCKBYTES = 136, _STATEBYTES = 256, _DOMAIN_STANDARD = 0x1F, TURBOSHAKE256_RATE = 136 (12-round permute)\ncrypto_shorthash_BYTES = crypto_shorthash_siphash24_BYTES = 8 | crypto_shorthash_KEYBYTES = crypto_shorthash_siphash24_KEYBYTES = 16 | crypto_shorthash_siphashx24_BYTES = 16 | _siphashx24_KEYBYTES = 16 | crypto_shorthash_PRIMITIVE = \"siphash24\"\ncrypto_stream_KEYBYTES = crypto_stream_xsalsa20_KEYBYTES = 32 | crypto_stream_NONCEBYTES = crypto_stream_xsalsa20_NONCEBYTES = 24 | crypto_stream_MESSAGEBYTES_MAX = SODIUM_SIZE_MAX | crypto_stream_PRIMITIVE = \"xsalsa20\"\ncrypto_stream_chacha20_KEYBYTES = 32, _NONCEBYTES = 8, _MESSAGEBYTES_MAX = SODIUM_SIZE_MAX\ncrypto_stream_chacha20_ietf_KEYBYTES = 32, _NONCEBYTES = 12, _MESSAGEBYTES_MAX = SODIUM_MIN(SODIUM_SIZE_MAX, 64ULL*(1ULL<<32)) = 274877906944 (2^38)\ncrypto_stream_salsa20_KEYBYTES = 32, _NONCEBYTES = 8, _MESSAGEBYTES_MAX = SODIUM_SIZE_MAX (same for salsa2012, salsa208)\ncrypto_stream_xchacha20_KEYBYTES = 32, _NONCEBYTES = 24, _MESSAGEBYTES_MAX = SODIUM_SIZE_MAX\ncrypto_stream_xsalsa20_KEYBYTES = 32, _NONCEBYTES = 24, _MESSAGEBYTES_MAX = SODIUM_SIZE_MAX\nSODIUM_SIZE_MAX = SODIUM_MIN(UINT64_MAX, SIZE_MAX) | curve25519 ladder constant 121666 | x25519 clamp: t[0]&=248, t[31]&=127, t[31]|=64 | ed25519 clamp: k[0]&=248, k[31]&=127, k[31]|=64 | ed25519 scalarmult clamp (noclamp variant): k[0]&=248, k[31]|=64 then t[31]&=127\n\n--- generichash / blake2b axes ---\noutlen: 1 (accepted despite BYTES_MIN=16), 15, 16 (BYTES_MIN), 32 (BYTES), 63, 64 (BYTES_MAX); reject 0 and 65\nkeylen: 0 (unkeyed path -> blake2b_init), 1, 15, 16 (KEYBYTES_MIN), 32 (KEYBYTES), 64 (KEYBYTES_MAX); reject 65. key == NULL with keylen > 0 -> unkeyed path in the wrapper (no misuse), but bare blake2b() aborts\nAPI shape: one-shot crypto_generichash() vs init/update.../final; keyed vs unkeyed; salt+personal vs plain\nsalt/personal: 16-byte each; salt == NULL and/or personal == NULL zero-fill; distinct salt or distinct personal must change the digest\nkeyed path detail: blake2b_init_key absorbs one full zero-padded BLAKE2B_BLOCKBYTES=128 block containing the key before any message bytes -> initial S->buflen = 128\nupdate chunking around the 128-byte block and the 2*128=256-byte double buffer: inlen 0, 1, 127, 128, 129, 255, 256, 257, 383, 384; the branch is `inlen > fill` where fill = 256 - buflen, so a compress happens only when the buffer would exceed 256 bytes\nmulti-update: 1+1, 63+65, 127+1, 128+128, 1x256, 256x1, and a final chunk that lands exactly on buflen == 128 (blake2b_final's `S->buflen > BLAKE2B_BLOCKBYTES` extra-compress branch is taken only when buflen > 128)\nfinal: outlen equal to init's outlen (normal), outlen != init's outlen (silently allowed, truncated/mismatched digest), _final called twice (-1)\nstatebytes: crypto_generichash_statebytes() = crypto_generichash_blake2b_statebytes() = 384\ncompress backend axis: blake2b_compress_ref / _ssse3 / _sse41 / _avx2 (must be byte-identical)\n\n--- sha256 / sha512 / sha3 axes ---\nsha256 (block 64, counter in bits): message lengths 0, 1, 55, 56, 63, 64, 65, 111, 112, 119, 120, 127, 128, 191, 192, 1000; padding boundary is r == 56 (length field needs 8 bytes)\nsha512 (block 128): message lengths 0, 1, 111, 112, 119, 120, 127, 128, 129, 239, 240, 255, 256, 1000; padding boundary is r == 112 (length field needs 16 bytes)\nmulti-update chunking: exercise `inlen < 64 - r` (resp. `inlen < 128 - r`) small path, the exact-fill path, the `while (inlen >= 64/128)` multi-block loop, and the `inlen &= 63/127` tail; inlen == 0 must be a no-op that leaves state->count unchanged\nsha256/sha512 one-shot vs init/update/final must agree; _final zeroizes the state\nsha3-256: rate 136, outlen 32; sha3-512: rate 72, outlen 64; domain 0x06\nsha3 lengths: 0, 1, 71, 72, 73, 135, 136, 137, 143, 144, 271, 272, 1000 — the interesting cases are offset == rate-1 (single-byte pad 0x06^0x80 = 0x86) and offset == rate (permute before pad), plus offset == 0\nsha3 chunking axes: state->offset != 0 partial-fill branch, the `while (inlen - consumed >= rate)` loop with the \"don't permute the last full block\" behavior (offset left == rate), and the trailing-remainder branch\nsha3 phase axis: update-after-final and final-after-final both return -1 but still produce output (absorbing restart semantics)\n\n--- xof axes (shake128 rate 168, shake256 rate 136, turboshake128 rate 168 / 12 rounds, turboshake256 rate 136 / 12 rounds) ---\noutlen: 0, 1, rate-1, rate, rate+1, 2*rate, 2*rate+1, 3*rate, 1000 — squeeze must permute between blocks and resume mid-block across calls\nmulti-squeeze: squeeze(rate) then squeeze(rate) must equal one squeeze(2*rate); squeeze(1) x N must equal squeeze(N)\nabsorb chunking: inlen 0, 1, rate-1, rate, rate+1, 2*rate, 2*rate+1; multi-update splits that straddle a rate boundary\none-shot crypto_xof_*() vs init/update/squeeze must agree\ndomain byte axis: DOMAIN_STANDARD = 0x1F for ALL FOUR variants; init_with_domain accepts any 0x00..0xFF with NO validation — worth exercising 0x00, 0x01, 0x06, 0x07, 0x1F, 0x7F, 0x80, 0xFF (0x80 collides with the 0x80 pad bit; offset == rate-1 case XORs domain^0x80)\npadding-branch axis: offset == rate-1 (single combined byte domain^0x80) vs offset < rate-1 (two separate XORs) vs offset == rate (permute first)\nkeccak1600 backend axis: keccak1600_ref vs keccak1600_armsha3 (__ARM_FEATURE_SHA3)\n\n--- stream cipher axes ---\nmlen/clen: 0 (early-return, nothing written), 1, 31, 32, 63, 64, 65, 127, 128, 129, 191, 192, 255, 256, 512, 513, 1024, 4096 (exercises the multi-block loop and the <64-byte tmp-buffer tail in chacha20_encrypt_bytes)\nchacha20 (ref, 8-byte nonce, 64-bit counter split across input[12],input[13]) vs chacha20_ietf (12-byte nonce, 32-bit counter in input[12] only)\n_xor vs _xor_ic vs keystream-only (_chacha20 / _salsa20 which memset then encrypt)\nchacha20 _xor_ic: ic (uint64_t) = 0, 1, 2^32-1, 2^32, 2^32+1, 2^64-1 — exercises the j12 wrap into j13 (`if (!j12) j13 = PLUSONE(j13)`); low half in ic_bytes[0..4), high half in ic_bytes[4..8)\nchacha20_ietf _xor_ic: ic (uint32_t) = 0, 1, 2^32-2, 2^32-1, plus the guard boundary ic == 2^32 - ceil(mlen/64) (last legal) and ic == 2^32 - ceil(mlen/64) + 1 (abort)\nsalsa20 _xor_ic: ic (uint64_t) = 0, 1, 2^32-1, 2^32, 2^64-1, 2^64-2 (written little-endian into in[8..16); the counter increment loop is a manual 8-byte carry chain with no wrap detection)\nsalsa20 backend axis: salsa20_ref / salsa20_xmm6 (HAVE_AMD64_ASM) / xmm6int-sse2 / -avx2 / -avx512 / -neon\nchacha20 backend axis: chacha20_ref / dolbeau-ssse3 / -avx2 / -avx512 / -neon\nsalsa2012 (12 rounds) and salsa208 (8 rounds): only stream + _xor exist (NO _xor_ic); same lengths as salsa20\nxsalsa20 = HSalsa20(k, n[0..16)) then salsa