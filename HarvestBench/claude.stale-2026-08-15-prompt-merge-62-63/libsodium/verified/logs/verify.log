size_t saltlen, const size_t hashlen, char *encoded,\n173\t                     const size_t encodedlen)\n174\t{\n175\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n176\t                       NULL, hashlen, encoded, encodedlen, Argon2_i);\n177\t}\n178\t\n179\tint\n180\targon2i_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n181\t                 const uint32_t parallelism, const void *pwd,\n182\t                 const size_t pwdlen, const void *salt, const size_t saltlen,\n183\t                 void *hash, const size_t hashlen)\n184\t{\n185\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n186\t                       hash, hashlen, NULL, 0, Argon2_i);\n187\t}\n188\t\n189\tint\n190\targon2id_hash_encoded(const uint32_t t_cost, const uint32_t m_cost,\n191\t                      const uint32_t parallelism, const void *pwd,\n192\t                      const size_t pwdlen, const void *salt,\n193\t                      const size_t saltlen, const size_t hashlen, char *encoded,\n194\t                      const size_t encodedlen)\n195\t{\n196\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n197\t                       NULL, hashlen, encoded, encodedlen, Argon2_id);\n198\t}\n199\t\n200\tint\n201\targon2id_hash_raw(const uint32_t t_cost, const uint32_t m_cost,\n202\t                  const uint32_t parallelism, const void *pwd,\n203\t                  const size_t pwdlen, const void *salt, const size_t saltlen,\n204\t                  void *hash, const size_t hashlen)\n205\t{\n206\t    return argon2_hash(t_cost, m_cost, parallelism, pwd, pwdlen, salt, saltlen,\n207\t                       hash, hashlen, NULL, 0, Argon2_id);\n208\t}\n209\t\n210\tint\n211\targon2_verify(const char *encoded, const void *pwd, const size_t pwdlen,\n212\t              argon2_type type)\n213\t{\n214\t    argon2_context ctx;\n215\t    uint8_t       *out;\n216\t    int            decode_result