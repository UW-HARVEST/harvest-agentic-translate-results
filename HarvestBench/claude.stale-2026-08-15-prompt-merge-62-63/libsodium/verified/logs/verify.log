 crypto_aead_aegis256_ABYTES;\n114\t\n115\t    (void) nsec;\n116\t    if (maclen_p != NULL) {\n117\t        *maclen_p = maclen;\n118\t    }\n119\t    if (mlen > crypto_aead_aegis256_MESSAGEBYTES_MAX ||\n120\t        adlen > crypto_aead_aegis256_MESSAGEBYTES_MAX) {\n121\t        sodium_misuse(); /* LCOV_EXCL_LINE */\n122\t    }\n123\t    return implementation->encrypt_detached(c, mac, maclen, m, (size_t) mlen, ad, (size_t) adlen,\n124\t                                            npub, k);\n125\t}\n126\t\n127\tint\n128\tcrypto_aead_aegis256_decrypt_detached(unsigned char *m, unsigned char *nsec, const unsigned char *c,\n129\t                                      unsigned long long clen, const unsigned char *mac,\n130\t                                      const unsigned char *ad, unsigned long long adlen,\n131\t                                      const unsigned char *npub, const unsigned char *k)\n132\t{\n133\t    const size_t maclen = crypto_aead_aegis256_ABYTES;\n134\t\n135\t    (void) nsec;\n136\t    if (clen > crypto_aead_aegis256_MESSAGEBYTES_MAX ||\n137\t        adlen > crypto_aead_aegis256_MESSAGEBYTES_MAX) {\n138\t        return -1; /* LCOV_EXCL_LINE */\n139\t    }\n140\t    return implementation->decrypt_detached(m, c, (size_t) clen, mac, maclen, ad, (size_t) adlen,\n141\t                                            npub, k);\n142\t}\n143\t\n144\tint\n145\t_crypto_aead_aegis256_pick_best_implementation(void)\n146\t{\n147\t    implementation = &aegis256_soft_implementation;\n148\t\n149\t#if defined(HAVE_ARMCRYPTO) && defined(NATIVE_LITTLE_ENDIAN)\n150\t    if (sodium_runtime_has_armcrypto()) {\n151\t        implementation = &aegis256_armcrypto_implementation;\n152\t        return 0;\n153\t    }\n154\t#endif\n155\t\n156\t#if defined(HAVE_AVXINTRIN_H) && defined(HAVE_WMMINTRIN_H)\n157\t    if (sodium_runtime_has_aesni() & sodium_runtime_has_avx()) {\n158\t        implementation = &aegis256_aesni_implementation;\n159\t        return 0;\n160\t    }\n161\t#endif\n