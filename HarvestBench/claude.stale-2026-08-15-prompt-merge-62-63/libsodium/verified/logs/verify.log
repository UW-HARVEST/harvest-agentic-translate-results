t\n    93\t// ---------------- crypto_kdf_blake2b ----------------\n    94\t\n    95\t#[unsafe(no_mangle)]\n    96\tpub extern \"C\" fn crypto_kdf_blake2b_bytes_min() -> usize {\n    97\t    CRYPTO_KDF_BYTES_MIN\n    98\t}\n    99\t\n   100\t#[unsafe(no_mangle)]\n   101\tpub extern \"C\" fn crypto_kdf_blake2b_bytes_max() -> usize {\n   102\t    CRYPTO_KDF_BYTES_MAX\n   103\t}\n   104\t\n   105\t#[unsafe(no_mangle)]\n   106\tpub extern \"C\" fn crypto_kdf_blake2b_contextbytes() -> usize {\n   107\t    CRYPTO_KDF_CONTEXTBYTES\n   108\t}\n   109\t\n   110\t#[unsafe(no_mangle)]\n   111\tpub extern \"C\" fn crypto_kdf_blake2b_keybytes() -> usize {\n   112\t    CRYPTO_KDF_KEYBYTES\n   113\t}\n   114\t\n   115\t#[unsafe(no_mangle)]\n   116\tpub unsafe extern \"C\" fn crypto_kdf_blake2b_derive_from_key(\n   117\t    subkey: *mut u8,\n   118\t    subkey_len: usize,\n   119\t    subkey_id: u64,\n   120\t    ctx: *const c_char,\n   121\t    key: *const u8,\n   122\t) -> c_int {\n   123\t    let mut ctx_padded = [0u8; BLAKE2B_PERSONALBYTES];\n   124\t    let mut salt = [0u8; BLAKE2B_SALTBYTES];\n   125\t\n   126\t    core::ptr::copy_nonoverlapping(ctx as *const u8, ctx_padded.as_mut_ptr(), CRYPTO_KDF_CONTEXTBYTES);\n   127\t    // remaining bytes of ctx_padded already zero\n   128\t    store64_le(&mut salt[0..8], subkey_id);\n   129\t    // salt[8..] already zero\n   130\t\n   131\t    if subkey_len < CRYPTO_KDF_BYTES_MIN || subkey_len > CRYPTO_KDF_BYTES_MAX {\n   132\t        set_einval();\n   133\t        return -1;\n   134\t    }\n   135\t    crypto_generichash_blake2b_salt_personal(\n   136\t        subkey,\n   137\t        subkey_len,\n   138\t        core::ptr::null(),\n   139\t        0,\n   140\t        key,\n   141\t        CRYPTO_KDF_KEYBYTES,\n   142\t        salt.as_ptr(),\n   143\t        ctx_padded.as_ptr(),\n   144\t    )\n   145\t}\n   146\t\n   147\t// ---------------- HKDF ----------------\n   148\t//\n   149\t// State layouts mirror the C structs (a single em