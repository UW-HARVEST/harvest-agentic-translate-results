t c_void,\n1274\t    saltlen: usize,\n1275\t    hash: *mut c_void,\n1276\t    hashlen: usize,\n1277\t) -> c_int {\n1278\t    _sodium_argon2_hash(\n1279\t        t_cost,\n1280\t        m_cost,\n1281\t        parallelism,\n1282\t        pwd,\n1283\t        pwdlen,\n1284\t        salt,\n1285\t        saltlen,\n1286\t        hash,\n1287\t        hashlen,\n1288\t        core::ptr::null_mut(),\n1289\t        0,\n1290\t        ARGON2_ID,\n1291\t    )\n1292\t}\n1293\t\n1294\t#[unsafe(no_mangle)]\n1295\tpub unsafe extern \"C\" fn _sodium_argon2_verify(\n1296\t    encoded: *const c_char,\n1297\t    pwd: *const c_void,\n1298\t    pwdlen: usize,\n1299\t    type_: c_int,\n1300\t) -> c_int {\n1301\t    let mut ctx: argon2_context = core::mem::zeroed();\n1302\t\n1303\t    ctx.pwd = core::ptr::null_mut();\n1304\t    ctx.pwdlen = 0;\n1305\t    ctx.secret = core::ptr::null_mut();\n1306\t    ctx.secretlen = 0;\n1307\t\n1308\t    let encoded_len = c_strlen(encoded as *const u8);\n1309\t    if encoded_len > u32::MAX as usize {\n1310\t        return ARGON2_DECODING_LENGTH_FAIL;\n1311\t    }\n1312\t    ctx.adlen = encoded_len as u32;\n1313\t    ctx.saltlen = encoded_len as u32;\n1314\t    ctx.outlen = encoded_len as u32;\n1315\t\n1316\t    ctx.ad = libc::malloc(ctx.adlen as usize) as *mut u8;\n1317\t    ctx.salt = libc::malloc(ctx.saltlen as usize) as *mut u8;\n1318\t    ctx.out = libc::malloc(ctx.outlen as usize) as *mut u8;\n1319\t    if ctx.out.is_null() || ctx.salt.is_null() || ctx.ad.is_null() {\n1320\t        libc::free(ctx.ad as *mut c_void);\n1321\t        libc::free(ctx.salt as *mut c_void);\n1322\t        libc::free(ctx.out as *mut c_void);\n1323\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n1324\t    }\n1325\t    let out = libc::malloc(ctx.outlen as usize) as *mut u8;\n1326\t    if out.is_null() {\n1327\t        libc::free(ctx.ad as *mut c_void);\n1328\t        libc::free(ctx.salt as *mut c_void);\n1329\t        libc::free(ctx.out as *mut c_void);\n1330\t        return ARGON