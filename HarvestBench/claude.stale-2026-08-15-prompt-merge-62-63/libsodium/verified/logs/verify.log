{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013ikrMLiMQmLb8oqX8pqqd1","type":"tool_result","content":"1\t//! Translation of libsodium argon2 (reference path).\n2\t//! Covers argon2.c, argon2-core.c, argon2-fill-block-ref.c, blake2b-long.c,\n3\t//! argon2-encoding.c, pwhash_argon2i.c, pwhash_argon2id.c.\n4\t\n5\tuse core::ffi::{c_char, c_int, c_void};\n6\tuse crate::common::{load64_le, rotr64, store32_le, store64_le};\n7\t\n8\t// ---------------------------------------------------------------------------\n9\t// Externs from other packages\n10\t// ---------------------------------------------------------------------------\n11\t\n12\t#[repr(C, align(64))]\n13\tstruct Blake2bState {\n14\t    opaque: [u8; 384],\n15\t}\n16\t\n17\textern \"C\" {\n18\t    fn crypto_generichash_blake2b_init(\n19\t        state: *mut Blake2bState,\n20\t        key: *const u8,\n21\t        keylen: usize,\n22\t        outlen: usize,\n23\t    ) -> c_int;\n24\t    fn crypto_generichash_blake2b_update(\n25\t        state: *mut Blake2bState,\n26\t        in_: *const u8,\n27\t        inlen: u64,\n28\t    ) -> c_int;\n29\t    fn crypto_generichash_blake2b_final(\n30\t        state: *mut Blake2bState,\n31\t        out: *mut u8,\n32\t        outlen: usize,\n33\t    ) -> c_int;\n34\t    fn crypto_generichash_blake2b(\n35\t        out: *mut u8,\n36\t        outlen: usize,\n37\t        in_: *const u8,\n38\t        inlen: u64,\n39\t        key: *const u8,\n40\t        keylen: usize,\n41\t    ) -> c_int;\n42\t\n43\t    fn randombytes_buf(buf: *mut c_void, size: usize);\n44\t    fn sodium_memzero(pnt: *mut c_void, len: usize);\n45\t    fn sodium_memcmp(b1: *const c_void, b2: *const c_void, len: usize) -> c_int;\n46\t\n47\t    fn sodium_bin2base64(\n48\t        b64: *mut c_char,\n49\t        b64_maxlen: usize,\n50\t        bin: *const u8,\n51\t        bin_len: usize,\n52\t        variant: c_int,\n53\t    ) -> *mut c_char;\n54\t    fn sodium_base642bin(\n55\t        bin: *mut u8,\n56\t        bin_maxlen: usize,\n57\t        b64: *const c_char,\n58\t        b64_len: usize,\n59\t        ignore: *const c_char,\n60\t        bin_len: *mut usize,\n61\t        b64_end: *mut *const c_char,\n62\t        variant: c_int,\n63\t    ) -> c_int;\n64\t}\n65\t\n66\tconst SODIUM_BASE64_VARIANT_ORIGINAL_NO_PADDING: c_int = 3;\n67\tconst CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX: usize = 64;\n68\t\n69\t#[inline]\n70\tunsafe fn set_errno(e: c_int) {\n71\t    *libc::__errno_location() = e;\n72\t}\n73\t\n74\t// ---------------------------------------------------------------------------\n75\t// Constants\n76\t// ---------------------------------------------------------------------------\n77\t\n78\tconst ARGON2_VERSION_NUMBER: u32 = 0x13;\n79\tconst ARGON2_BLOCK_SIZE: usize = 1024;\n80\tconst ARGON2_QWORDS_IN_BLOCK: usize = ARGON2_BLOCK_SIZE / 8; // 128\n81\tconst ARGON2_ADDRESSES_IN_BLOCK: usize = 128;\n82\tconst ARGON2_PREHASH_DIGEST_LENGTH: usize = 64;\n83\tconst ARGON2_PREHASH_SEED_LENGTH: usize = 72;\n84\tconst ARGON2_SYNC_POINTS: u32 = 4;\n85\t\n86\tconst ARGON2_MIN_OUTLEN: u32 = 16;\n87\tconst ARGON2_MAX_OUTLEN: u32 = 0xFFFFFFFF;\n88\tconst ARGON2_MIN_PWD_LENGTH: u32 = 0;\n89\tconst ARGON2_MAX_PWD_LENGTH: u32 = 0xFFFFFFFF;\n90\tconst ARGON2_MIN_AD_LENGTH: u32 = 0;\n91\tconst ARGON2_MAX_AD_LENGTH: u32 = 0xFFFFFFFF;\n92\tconst ARGON2_MIN_SALT_LENGTH: u32 = 8;\n93\tconst ARGON2_MAX_SALT_LENGTH: u32 = 0xFFFFFFFF;\n94\tconst ARGON2_MIN_SECRET: u32 = 0;\n95\tconst ARGON2_MAX_SECRET: u32 = 0xFFFFFFFF;\n96\tconst ARGON2_MIN_LANES: u32 = 1;\n97\tconst ARGON2_MAX_LANES: u32 = 0xFFFFFF;\n98\tconst ARGON2_MIN_THREADS: u32 = 1;\n99\tconst ARGON2_MAX_THREADS: u32 = 0xFFFFFF;\n100\tconst ARGON2_MIN_MEMORY: u32 = 2 * ARGON2_SYNC_POINTS; // 8\n101\t// ARGON2_MAX_MEMORY on 64-bit: min(0xFFFFFFFF, 1<<32) = 0xFFFFFFFF\n102\tconst ARGON2_MAX_MEMORY: u32 = 0xFFFFFFFF;\n103\tconst ARGON2_MIN_TIME: u32 = 1;\n104\tconst ARGON2_MAX_TIME: u32 = 0xFFFFFFFF;\n105\t\n106\tconst ARGON2_FLAG_CLEAR_PASSWORD: u32 = 1 << 0;\n107\tconst ARGON2_FLAG_CLEAR_SECRET: u32 = 1 << 1;\n108\tconst ARGON2_DEFAULT_FLAGS: u32 = 0;\n109\t\n110\t// Error codes\n111\tconst ARGON2_OK: c_int = 0;\n112\tconst ARGON2_OUTPUT_PTR_NULL: c_int = -1;\n113\tconst ARGON2_OUTPUT_TOO_SHORT: c_int = -2;\n114\tconst ARGON2_OUTPUT_TOO_LONG: c_int = -3;\n115\tconst ARGON2_PWD_TOO_SHORT: c_int = -4;\n116\tconst ARGON2_PWD_TOO_LONG: c_int = -5;\n117\tconst ARGON2_SALT_TOO_SHORT: c_int = -6;\n118\tconst ARGON2_SALT_TOO_LONG: c_int = -7;\n119\tconst ARGON2_AD_TOO_SHORT: c_int = -8;\n120\tconst ARGON2_AD_TOO_LONG: c_int = -9;\n121\tconst ARGON2_SECRET_TOO_SHORT: c_int = -10;\n122\tconst ARGON2_SECRET_TOO_LONG: c_int = -11;\n123\tconst ARGON2_TIME_TOO_SMALL: c_int = -12;\n124\tconst ARGON2_TIME_TOO_LARGE: c_int = -13;\n125\tconst ARGON2_MEMORY_TOO_LITTLE: c_int = -14;\n126\tconst ARGON2_MEMORY_TOO_MUCH: c_int = -15;\n127\tconst ARGON2_LANES_TOO_FEW: c_int = -16;\n128\tconst ARGON2_LANES_TOO_MANY: c_int = -17;\n129\tconst ARGON2_PWD_PTR_MISMATCH: c_int = -18;\n130\tconst ARGON2_SALT_PTR_MISMATCH: c_int = -19;\n131\tconst ARGON2_SECRET_PTR_MISMATCH: c_int = -20;\n132\tconst ARGON2_AD_PTR_MISMATCH: c_int = -21;\n133\tconst ARGON2_MEMORY_ALLOCATION_ERROR: c_int = -22;\n134\tconst ARGON2_INCORRECT_PARAMETER: c_int = -25;\n135\tconst ARGON2_INCORRECT_TYPE: c_int = -26;\n136\tconst ARGON2_THREADS_TOO_FEW: c_int = -28;\n137\tconst ARGON2_THREADS_TOO_MANY: c_int = -29;\n138\tconst ARGON2_ENCODING_FAIL: c_int = -31;\n139\tconst ARGON2_DECODING_FAIL: c_int = -32;\n140\tconst ARGON2_DECODING_LENGTH_FAIL: c_int = -34;\n141\tconst ARGON2_VERIFY_MISMATCH: c_int = -35;\n142\t\n143\t// argon2_type\n144\tconst ARGON2_I: c_int = 1;\n145\tconst ARGON2_ID: c_int = 2;\n146\t\n147\t// ---------------------------------------------------------------------------\n148\t// Structures (repr(C) to match argon2 internal ABI)\n149\t// ---------------------------------------------------------------------------\n150\t\n151\ttype Block = [u64; ARGON2_QWORDS_IN_BLOCK];\n152\t\n153\t#[repr(C)]\n154\tstruct block_region {\n155\t    base: *mut c_void,\n156\t    memory: *mut Block,\n157\t    size: usize,\n158\t}\n159\t\n160\t#[repr(C)]\n161\tpub struct argon2_context {\n162\t    out: *mut u8,\n163\t    outlen: u32,\n164\t    pwd: *mut u8,\n165\t    pwdlen: u32,\n166\t    salt: *mut u8,\n167\t    saltlen: u32,\n168\t    secret: *mut u8,\n169\t    secretlen: u32,\n170\t    ad: *mut u8,\n171\t    adlen: u32,\n172\t    t_cost: u32,\n173\t    m_cost: u32,\n174\t    lanes: u32,\n175\t    threads: u32,\n176\t    flags: u32,\n177\t}\n178\t\n179\t#[repr(C)]\n180\tpub struct argon2_instance_t {\n181\t    region: *mut block_region,\n182\t    pseudo_rands: *mut u64,\n183\t    passes: u32,\n184\t    current_pass: u32,\n185\t    memory_blocks: u32,\n186\t    segment_length: u32,\n187\t    lane_length: u32,\n188\t    lanes: u32,\n189\t    threads: u32,\n190\t    type_: c_int,\n191\t    print_internals: c_int,\n192\t}\n193\t\n194\t#[repr(C)]\n195\t#[derive(Clone, Copy)]\n196\tpub struct argon2_position_t {\n197\t    pass: u32,\n198\t    lane: u32,\n199\t    slice: u8,\n200\t    index: u32,\n201\t}\n202\t\n203\t// ---------------------------------------------------------------------------\n204\t// Block helpers\n205\t// ---------------------------------------------------------------------------\n206\t\n207\t#[inline(always)]\n208\tunsafe fn init_block_value(b: *mut Block, val: u8) {\n209\t    core::ptr::write_bytes(b as *mut u8, val, ARGON2_BLOCK_SIZE);\n210\t}\n211\t\n212\t#[inline(always)]\n213\tunsafe fn copy_block(dst: *mut Block, src: *const Block) {\n214\t    core::ptr::copy_nonoverlapping(src as *const u8, dst as *mut u8, ARGON2_BLOCK_SIZE);\n215\t}\n216\t\n217\t#[inline(always)]\n218\tunsafe fn xor_block(dst: *mut Block, src: *const Block) {\n219\t    for i in 0..ARGON2_QWORDS_IN_BLOCK {\n220\t        (*dst)[i] ^= (*src)[i];\n221\t    }\n222\t}\n223\t\n224\tunsafe fn load_block(dst: *mut Block, input: *const u8) {\n225\t    for i in 0..ARGON2_QWORDS_IN_BLOCK {\n226\t        let s = core::slice::from_raw_parts(input.add(i * 8), 8);\n227\t        (*dst)[i] = load64_le(s);\n228\t    }\n229\t}\n230\t\n231\tunsafe fn store_block(output: *mut u8, src: *const Block) {\n232\t    for i in 0..ARGON2_QWORDS_IN_BLOCK {\n233\t        let d = core::slice::from_raw_parts_mut(output.add(i * 8), 8);\n234\t        store64_le(d, (*src)[i]);\n235\t    }\n236\t}\n237\t\n238\t// ---------------------------------------------------------------------------\n239\t// BlaMka round (blamka-round-ref.h)\n240\t// ---------------------------------------------------------------------------\n241\t\n242\t#[inline(always)]\n243\tfn fblamka(x: u64, y: u64) -> u64 {\n244\t    let m: u64 = 0xFFFFFFFF;\n245\t    let xy = (x & m).wrapping_mul(y & m);\n246\t    x.wrapping_add(y).wrapping_add(2u64.wrapping_mul(xy))\n247\t}\n248\t\n249\t#[inline(always)]\n250\tfn g(v: &mut [u64; ARGON2_QWORDS_IN_BLOCK], a: usize, b: usize, c: usize, d: usize) {\n251\t    v[a] = fblamka(v[a], v[b]);\n252\t    v[d] = rotr64(v[d] ^ v[a], 32);\n253\t    v[c] = fblamka(v[c], v[d]);\n254\t    v[b] = rotr64(v[b] ^ v[c], 24);\n255\t    v[a] = fblamka(v[a], v[b]);\n256\t    v[d] = rotr64(v[d] ^ v[a], 16);\n257\t    v[c] = fblamka(v[c], v[d]);\n258\t    v[b] = rotr64(v[b] ^ v[c], 63);\n259\t}\n260\t\n261\t#[inline(always)]\n262\tfn blake2_round_nomsg(v: &mut [u64; ARGON2_QWORDS_IN_BLOCK], idx: [usize; 16]) {\n263\t    g(v, idx[0], idx[4], idx[8], idx[12]);\n264\t    g(v, idx[1], idx[5], idx[9], idx[13]);\n265\t    g(v, idx[2], idx[6], idx[10], idx[14]);\n266\t    g(v, idx[3], idx[7], idx[11], idx[15]);\n267\t    g(v, idx[0], idx[5], idx[10], idx[15]);\n268\t    g(v, idx[1], idx[6], idx[11], idx[12]);\n269\t    g(v, idx[2], idx[7], idx[8], idx[13]);\n270\t    g(v, idx[3], idx[4], idx[9], idx[14]);\n271\t}\n272\t\n273\tfn apply_rounds(block_r: &mut [u64; ARGON2_QWORDS_IN_BLOCK]) {\n274\t    // Columns\n275\t    for i in 0..8usize {\n276\t        let b = 16 * i;\n277\t        blake2_round_nomsg(\n278\t            block_r,\n279\t            [\n280\t                b, b + 1, b + 2, b + 3, b + 4, b + 5, b + 6, b + 7, b + 8, b + 9, b + 10, b + 11,\n281\t                b + 12, b + 13, b + 14, b + 15,\n282\t            ],\n283\t        );\n284\t    }\n285\t    // Rows\n286\t    for i in 0..8usize {\n287\t        let b = 2 * i;\n288\t        blake2_round_nomsg(\n289\t            block_r,\n290\t            [\n291\t                b,\n292\t                b + 1,\n293\t                b + 16,\n294\t                b + 17,\n295\t                b + 32,\n296\t                b + 33,\n297\t                b + 48,\n298\t                b + 49,\n299\t                b + 64,\n300\t                b + 65,\n301\t                b + 80,\n302\t                b + 81,\n303\t                b + 96,\n304\t                b + 97,\n305\t                b + 112,\n306\t                b + 113,\n307\t            ],\n308\t        );\n309\t    }\n310\t}\n311\t\n312\tunsafe fn fill_block(prev_block: *const Block, ref_block: *const Block, next_block: *mut Block) {\n313\t    let mut block_r: Block = *ref_block;\n314\t    xor_block(&mut block_r, prev_block);\n315\t    let block_tmp: Block = block_r;\n316\t\n317\t    apply_rounds(&mut block_r);\n318\t\n319\t    *next_block = block_tmp;\n320\t    xor_block(next_block, &block_r);\n321\t}\n322\t\n323\tunsafe fn fill_block_with_xor(\n324\t    prev_block: *const Block,\n325\t    ref_block: *const Block,\n326\t    next_block: *mut Block,\n327\t) {\n328\t    let mut block_r: Block = *ref_block;\n329\t    xor_block(&mut block_r, prev_block);\n330\t    let mut block_tmp: Block = block_r;\n331\t    xor_block(&mut block_tmp, next_block);\n332\t\n333\t    apply_rounds(&mut block_r);\n334\t\n335\t    *next_block = block_tmp;\n336\t    xor_block(next_block, &block_r);\n337\t}\n338\t\n339\t// ---------------------------------------------------------------------------\n340\t// blake2b-long.c  ->  _sodium_blake2b_long\n341\t// ---------------------------------------------------------------------------\n342\t\n343\t#[unsafe(no_mangle)]\n344\tpub unsafe extern \"C\" fn _sodium_blake2b_long(\n345\t    pout: *mut c_void,\n346\t    outlen: usize,\n347\t    in_: *const c_void,\n348\t    inlen: usize,\n349\t) -> c_int {\n350\t    let mut out = pout as *mut u8;\n351\t    let mut blake_state = Blake2bState { opaque: [0u8; 384] };\n352\t    let mut outlen_bytes = [0u8; 4];\n353\t    let mut ret: c_int = -1;\n354\t\n355\t    'fail: {\n356\t        if outlen > u32::MAX as usize {\n357\t            break 'fail;\n358\t        }\n359\t        store32_le(&mut outlen_bytes, outlen as u32);\n360\t\n361\t        macro_rules! trys {\n362\t            ($stmt:expr) => {{\n363\t                ret = $stmt;\n364\t                if ret < 0 {\n365\t                    break 'fail;\n366\t                }\n367\t            }};\n368\t        }\n369\t\n370\t        if outlen <= CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX {\n371\t            trys!(crypto_generichash_blake2b_init(\n372\t                &mut blake_state,\n373\t                core::ptr::null(),\n374\t                0,\n375\t                outlen\n376\t            ));\n377\t            trys!(crypto_generichash_blake2b_update(\n378\t                &mut blake_state,\n379\t                outlen_bytes.as_ptr(),\n380\t                4\n381\t            ));\n382\t            trys!(crypto_generichash_blake2b_update(\n383\t                &mut blake_state,\n384\t                in_ as *const u8,\n385\t                inlen as u64\n386\t            ));\n387\t            trys!(crypto_generichash_blake2b_final(\n388\t                &mut blake_state,\n389\t                out,\n390\t                outlen\n391\t            ));\n392\t        } else {\n393\t            let mut toproduce: u32;\n394\t            let mut out_buffer = [0u8; CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX];\n395\t            let mut in_buffer = [0u8; CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX];\n396\t            trys!(crypto_generichash_blake2b_init(\n397\t                &mut blake_state,\n398\t                core::ptr::null(),\n399\t                0,\n400\t                CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX\n401\t            ));\n402\t            trys!(crypto_generichash_blake2b_update(\n403\t                &mut blake_state,\n404\t                outlen_bytes.as_ptr(),\n405\t                4\n406\t            ));\n407\t            trys!(crypto_generichash_blake2b_update(\n408\t                &mut blake_state,\n409\t                in_ as *const u8,\n410\t                inlen as u64\n411\t            ));\n412\t            trys!(crypto_generichash_blake2b_final(\n413\t                &mut blake_state,\n414\t                out_buffer.as_mut_ptr(),\n415\t                CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX\n416\t            ));\n417\t            let half = CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX / 2; // 32\n418\t            core::ptr::copy_nonoverlapping(out_buffer.as_ptr(), out, half);\n419\t            out = out.add(half);\n420\t            toproduce = (outlen as u32) - half as u32;\n421\t\n422\t            while toproduce as usize > CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX {\n423\t                core::ptr::copy_nonoverlapping(\n424\t                    out_buffer.as_ptr(),\n425\t                    in_buffer.as_mut_ptr(),\n426\t                    CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX,\n427\t                );\n428\t                trys!(crypto_generichash_blake2b(\n429\t                    out_buffer.as_mut_ptr(),\n430\t                    CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX,\n431\t                    in_buffer.as_ptr(),\n432\t                    CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX as u64,\n433\t                    core::ptr::null(),\n434\t                    0\n435\t                ));\n436\t                core::ptr::copy_nonoverlapping(out_buffer.as_ptr(), out, half);\n437\t                out = out.add(half);\n438\t                toproduce -= half as u32;\n439\t            }\n440\t\n441\t            core::ptr::copy_nonoverlapping(\n442\t                out_buffer.as_ptr(),\n443\t                in_buffer.as_mut_ptr(),\n444\t                CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX,\n445\t            );\n446\t            trys!(crypto_generichash_blake2b(\n447\t                out_buffer.as_mut_ptr(),\n448\t                toproduce as usize,\n449\t                in_buffer.as_ptr(),\n450\t                CRYPTO_GENERICHASH_BLAKE2B_BYTES_MAX as u64,\n451\t                core::ptr::null(),\n452\t                0\n453\t            ));\n454\t            core::ptr::copy_nonoverlapping(out_buffer.as_ptr(), out, toproduce as usize);\n455\t        }\n456\t    }\n457\t    sodium_memzero(\n458\t        &mut blake_state as *mut Blake2bState as *mut c_void,\n459\t        core::mem::size_of::<Blake2bState>(),\n460\t    );\n461\t    ret\n462\t}\n463\t\n464\t// ---------------------------------------------------------------------------\n465\t// argon2-core.c\n466\t// ---------------------------------------------------------------------------\n467\t\n468\tfn index_alpha(\n469\t    instance: &argon2_instance_t,\n470\t    position: &argon2_position_t,\n471\t    pseudo_rand: u32,\n472\t    same_lane: bool,\n473\t) -> u32 {\n474\t    let reference_area_size: u32;\n475\t\n476\t    if position.pass == 0 {\n477\t        if position.slice == 0 {\n478\t            reference_area_size = position.index.wrapping_sub(1);\n479\t        } else if same_lane {\n480\t            reference_area_size = (position.slice as u32)\n481\t                .wrapping_mul(instance.segment_length)\n482\t                .wrapping_add(position.index)\n483\t                .wrapping_sub(1);\n484\t        } else {\n485\t            let adj: u32 = if position.index == 0 { 0u32.wrapping_sub(1) } else { 0 };\n486\t            reference_area_size = (position.slice as u32)\n487\t                .wrapping_mul(instance.segment_length)\n488\t                .wrapping_add(adj);\n489\t        }\n490\t    } else if same_lane {\n491\t        reference_area_size = instance\n492\t            .lane_length\n493\t            .wrapping_sub(instance.segment_length)\n494\t            .wrapping_add(position.index)\n495\t            .wrapping_sub(1);\n496\t    } else {\n497\t        let adj: u32 = if position.index == 0 { 0u32.wrapping_sub(1) } else { 0 };\n498\t        reference_area_size = instance\n499\t            .lane_length\n500\t            .wrapping_sub(instance.segment_length)\n501\t            .wrapping_add(adj);\n502\t    }\n503\t\n504\t    let mut relative_position: u64 = pseudo_rand as u64;\n505\t    relative_position = relative_position.wrapping_mul(relative_position) >> 32;\n506\t    relative_position = ((reference_area_size.wrapping_sub(1)) as u64)\n507\t        .wrapping_sub((reference_area_size as u64).wrapping_mul(relative_position) >> 32);\n508\t\n509\t    let mut start_position: u32 = 0;\n510\t    if position.pass != 0 {\n511\t        start_position = if position.slice as u32 == ARGON2_SYNC_POINTS - 1 {\n512\t            0\n513\t        } else {\n514\t            (position.slice as u32 + 1).wrapping_mul(instance.segment_length)\n515\t        };\n516\t    }\n517\t\n518\t    let mut absolute_position: u64 = (start_position as u64)\n519\t        .wrapping_add(relative_position)\n520\t        .wrapping_sub(instance.lane_length as u64);\n521\t    absolute_position = absolute_position\n522\t        .wrapping_add((instance.lane_length as u64) & (absolute_position >> 32));\n523\t    absolute_position as u32\n524\t}\n525\t\n526\t#[unsafe(no_mangle)]\n527\tpub unsafe extern \"C\" fn _sodium_argon2_validate_inputs(\n528\t    context: *const argon2_context,\n529\t) -> c_int {\n530\t    if context.is_null() {\n531\t        return ARGON2_INCORRECT_PARAMETER;\n532\t    }\n533\t    let ctx = &*context;\n534\t\n535\t    if ctx.out.is_null() {\n536\t        return ARGON2_OUTPUT_PTR_NULL;\n537\t    }\n538\t    if ARGON2_MIN_OUTLEN > ctx.outlen {\n539\t        return ARGON2_OUTPUT_TOO_SHORT;\n540\t    }\n541\t    if ARGON2_MAX_OUTLEN < ctx.outlen {\n542\t        return ARGON2_OUTPUT_TOO_LONG;\n543\t    }\n544\t    if ctx.pwd.is_null() {\n545\t        if 0 != ctx.pwdlen {\n546\t            return ARGON2_PWD_PTR_MISMATCH;\n547\t        }\n548\t    }\n549\t    if ARGON2_MIN_PWD_LENGTH > ctx.pwdlen {\n550\t        return ARGON2_PWD_TOO_SHORT;\n551\t    }\n552\t    if ARGON2_MAX_PWD_LENGTH < ctx.pwdlen {\n553\t        return ARGON2_PWD_TOO_LONG;\n554\t    }\n555\t    if ctx.salt.is_null() {\n556\t        if 0 != ctx.saltlen {\n557\t            return ARGON2_SALT_PTR_MISMATCH;\n558\t        }\n559\t    }\n560\t    if ARGON2_MIN_SALT_LENGTH > ctx.saltlen {\n561\t        return ARGON2_SALT_TOO_SHORT;\n562\t    }\n563\t    if ARGON2_MAX_SALT_LENGTH < ctx.saltlen {\n564\t        return ARGON2_SALT_TOO_LONG;\n565\t    }\n566\t    if ctx.secret.is_null() {\n567\t        if 0 != ctx.secretlen {\n568\t            return ARGON2_SECRET_PTR_MISMATCH;\n569\t        }\n570\t    } else {\n571\t        if ARGON2_MIN_SECRET > ctx.secretlen {\n572\t            return ARGON2_SECRET_TOO_SHORT;\n573\t        }\n574\t        if ARGON2_MAX_SECRET < ctx.secretlen {\n575\t            return ARGON2_SECRET_TOO_LONG;\n576\t        }\n577\t    }\n578\t    if ctx.ad.is_null() {\n579\t        if 0 != ctx.adlen {\n580\t            return ARGON2_AD_PTR_MISMATCH;\n581\t        }\n582\t    } else {\n583\t        if ARGON2_MIN_AD_LENGTH > ctx.adlen {\n584\t            return ARGON2_AD_TOO_SHORT;\n585\t        }\n586\t        if ARGON2_MAX_AD_LENGTH < ctx.adlen {\n587\t            return ARGON2_AD_TOO_LONG;\n588\t        }\n589\t    }\n590\t    if ARGON2_MIN_LANES > ctx.lanes {\n591\t        return ARGON2_LANES_TOO_FEW;\n592\t    }\n593\t    if ARGON2_MAX_LANES < ctx.lanes {\n594\t        return ARGON2_LANES_TOO_MANY;\n595\t    }\n596\t    if ARGON2_MIN_MEMORY > ctx.m_cost {\n597\t        return ARGON2_MEMORY_TOO_LITTLE;\n598\t    }\n599\t    if ARGON2_MAX_MEMORY < ctx.m_cost {\n600\t        return ARGON2_MEMORY_TOO_MUCH;\n601\t    }\n602\t    if ctx.m_cost < 8u32.wrapping_mul(ctx.lanes) {\n603\t        return ARGON2_MEMORY_TOO_LITTLE;\n604\t    }\n605\t    if ARGON2_MIN_TIME > ctx.t_cost {\n606\t        return ARGON2_TIME_TOO_SMALL;\n607\t    }\n608\t    if ARGON2_MAX_TIME < ctx.t_cost {\n609\t        return ARGON2_TIME_TOO_LARGE;\n610\t    }\n611\t    if ARGON2_MIN_THREADS > ctx.threads {\n612\t        return ARGON2_THREADS_TOO_FEW;\n613\t    }\n614\t    if ARGON2_MAX_THREADS < ctx.threads {\n615\t        return ARGON2_THREADS_TOO_MANY;\n616\t    }\n617\t    ARGON2_OK\n618\t}\n619\t\n620\tunsafe fn allocate_memory(region: *mut *mut block_region, m_cost: u32) -> c_int {\n621\t    if region.is_null() {\n622\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n623\t    }\n624\t    let block_sz = core::mem::size_of::<Block>(); // 1024\n625\t    let memory_size = block_sz.wrapping_mul(m_cost as usize);\n626\t    if m_cost == 0 || memory_size / (m_cost as usize) != block_sz {\n627\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n628\t    }\n629\t    *region = libc::malloc(core::mem::size_of::<block_region>()) as *mut block_region;\n630\t    if (*region).is_null() {\n631\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n632\t    }\n633\t    (**region).base = core::ptr::null_mut();\n634\t    (**region).memory = core::ptr::null_mut();\n635\t\n636\t    // Portable path: malloc(memory_size + 63) and align to 64.\n637\t    let mut base: *mut c_void = core::ptr::null_mut();\n638\t    let mut memory: *mut Block = core::ptr::null_mut();\n639\t    if memory_size + 63 < memory_size {\n640\t        base = core::ptr::null_mut();\n641\t        set_errno(libc::ENOMEM);\n642\t    } else {\n643\t        base = libc::malloc(memory_size + 63);\n644\t        if !base.is_null() {\n645\t            let mut aligned = (base as *mut u8).add(63);\n646\t            aligned = aligned.sub((aligned as usize) & 63);\n647\t            memory = aligned as *mut Block;\n648\t        }\n649\t    }\n650\t    if base.is_null() {\n651\t        libc::free(*region as *mut c_void);\n652\t        *region = core::ptr::null_mut();\n653\t        return ARGON2_MEMORY_ALLOCATION_ERROR;\n654\t    }\n655\t    (**region).base = base;\n656\t    (**region).memory = memory;\n657\t    (**region).size = memory_size;\n658\t\n659\t    ARGON2_OK\n660\t}\n661\t\n662\tunsafe fn free_memory(region: *mut block_region) {\n663\t    if !region.is_null() && !(*region).base.is_null() {\n664\t        libc::free((*region).base);\n665\t    }\n666\t    libc::free(region as *mut c_void);\n667\t}\n668\t\n669\tunsafe fn argon2_free_instance(instance: *mut argon2_instance_t, _flags: u32) {\n670\t    libc::free((*instance).pseudo_rands as *mut c_void);\n671\t    (*instance).pseudo_rands = core::ptr::null_mut();\n672\t    free_memory((*instance).region);\n673\t    (*instance).region = core::ptr::null_mut();\n674\t}\n675\t\n676\t#[unsafe(no_mangle)]\n677\tpub unsafe extern \"C\" fn _sodium_argon2_finalize(\n678\t    context: *const argon2_context,\n679\t    instance: *mut argon2_instance_t,\n680\t) {\n681\t    if !context.is_null() && !instance.is_null() {\n682\t        let ctx = &*context;\n683\t        let inst = &mut *instance;\n684\t        let memory = (*inst.region).memory;\n685\t\n686\t        let mut blockhash: Block = [0u64; ARGON2_QWORDS_IN_BLOCK];\n687\t        copy_block(\n688\t            &mut blockhash,\n689\t            memory.add((inst.lane_length - 1) as usize),\n690\t        );\n691\t\n692\t        let mut l: u32 = 1;\n693\t        while l < inst.lanes {\n694\t            let last_block_in_lane =\n695\t                l * inst.lane_length + (inst.lane_length - 1);\n696\t            xor_block(&mut blockhash, memory.add(last_block_in_lane as usize));\n697\t            l += 1;\n698\t        }\n699\t\n700\t        {\n701\t            let mut blockhash_bytes = [0u8; ARGON2_BLOCK_SIZE];\n702\t            store_block(bloc