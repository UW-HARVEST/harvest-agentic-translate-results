   let bmo = rl(a[17] ^ di, 15);\n101\t    let bmu = rl(a[23] ^ dofs, 56);\n102\t    e[15] = bma ^ ((!bme) & bmi);\n103\t    e[16] = bme ^ ((!bmi) & bmo);\n104\t    e[17] = bmi ^ ((!bmo) & bmu);\n105\t    e[18] = bmo ^ ((!bmu) & bma);\n106\t    e[19] = bmu ^ ((!bma) & bme);\n107\t\n108\t    // group s (E[20..25])\n109\t    let bsa = rl(a[2] ^ di, 62);\n110\t    let bse = rl(a[8] ^ dofs, 55);\n111\t    let bsi = rl(a[14] ^ du, 39);\n112\t    let bso = rl(a[15] ^ da, 41);\n113\t    let bsu = rl(a[21] ^ de, 2);\n114\t    e[20] = bsa ^ ((!bse) & bsi);\n115\t    e[21] = bse ^ ((!bsi) & bso);\n116\t    e[22] = bsi ^ ((!bso) & bsu);\n117\t    e[23] = bso ^ ((!bsu) & bsa);\n118\t    e[24] = bsu ^ ((!bsa) & bse);\n119\t}\n120\t\n121\tunsafe fn load_state(state: *const u8, st: &mut [u64; 25]) {\n122\t    for i in 0..25 {\n123\t        st[i] = load64_le(state.add(i * 8));\n124\t    }\n125\t}\n126\tunsafe fn store_state(state: *mut u8, st: &[u64; 25]) {\n127\t    for i in 0..25 {\n128\t        store64_le(state.add(i * 8), st[i]);\n129\t    }\n130\t}\n131\t\n132\t// ---- _sodium_keccak1600_ref_* exported symbols ----\n133\t\n134\t#[unsafe(no_mangle)]\n135\tpub unsafe extern \"C\" fn _sodium_keccak1600_ref_permute_24(state: *mut core::ffi::c_void) {\n136\t    let mut st = [0u64; 25];\n137\t    load_state(state as *const u8, &mut st);\n138\t    keccakf(&mut st, 0);\n139\t    store_state(state as *mut u8, &st);\n140\t}\n141\t\n142\t#[unsafe(no_mangle)]\n143\tpub unsafe extern \"C\" fn _sodium_keccak1600_ref_permute_12(state: *mut core::ffi::c_void) {\n144\t    let mut st = [0u64; 25];\n145\t    load_state(state as *const u8, &mut st);\n146\t    keccakf(&mut st, 12);\n147\t    store_state(state as *mut u8, &st);\n148\t}\n149\t\n150\t#[unsafe(no_mangle)]\n151\tpub unsafe extern \"C\" fn _sodium_keccak1600_ref_init(state: *mut core::ffi::c_void) {\n152\t    core::ptr::write_bytes(state as *mut u8, 0, KECCAK1600_STATEBYTES);\n153\t}\n154\t\n155\t#[unsafe(no_mangle)]\n156\tpub unsafe extern \"C\" fn _sodium_keccak1600_ref_xor_bytes(\n157\t    state: *mut core::ffi::c_void,\n158\t    mut data: *const u8,\n159\t    mut offset: usize,\n160\t    mut length: usize,\n161\t) {\n162\t    let st = state as *mut u8;\n163\t    while length > 0 && (offset & 7) != 0 {\n164\t        *st.add(offset) ^= *data;\n165\t        data = data.add(1);\n166\t        offset += 1;\n167\t        length -= 1;\n168\t    }\n169\t    while length >= 8 {\n170\t        let t = load64_le(st.add(offset)) ^ load64_le(data);\n171\t        store64_le(st.add(offset), t);\n172\t        data = data.add(8);\n173\t        offset += 8;\n174\t        length -= 8;\n175\t    }\n176\t    while length > 0 {\n177\t        *st.add(offset) ^= *data;\n178\t        data = data.add(1);\n179\t        offset += 1;\n180\t        length -= 1;\n181\t    }\n182\t}\n183\t\n184\t#[unsafe(no_mangle)]\n185\tpub unsafe extern \"C\" fn _sodium_keccak1600_ref_extract_bytes(\n186\t    state: *const core::ffi::c_void,\n187\t    data: *mut u8,\n188\t    offset: usize,\n189\t    length: usize,\n190\t) {\n191\t    let st = state as *const u8;\n192\t    core::ptr::copy_nonoverlapping(st.add(offset), data, length);\n193\t}\n194\t\n195\t// ---- crypto_core_keccak1600 wrappers ----\n196\t// Only statebytes and permute_24 are exported (in P1). The rest are private helpers\n197\t// used by the SHA-3 module.\n198\t\n199\t#[unsafe(no_mangle)]\n200\tpub extern \"C\" fn crypto_core_keccak1600_statebytes() -> usize {\n201\t    // sizeof(crypto_core_keccak1600_state) == 224 (opaque[224])\n202\t    224\n203\t}\n204\t\n205\t#[unsafe(no_mangle)]\n206\tpub unsafe extern \"C\" fn crypto_core_keccak1600_permute_24(state: *mut core::ffi::c_void) {\n207\t    _sodium_keccak1600_ref_permute_24(state);\n208\t}\n209\t\n210\t// state->opaque is at offset 0, so the state pointer equals &state->opaque.\n211\t#[unsafe(no_mangle)]\n212\tpub unsafe extern \"C\" fn crypto_core_keccak1600_init(state: *mut core::ffi::c_void) {\n213\t    _sodium_keccak1