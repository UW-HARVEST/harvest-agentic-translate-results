{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YJDPVCHSffwjWttdcuKFWK","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C `libsodium.so` and the Rust `liblibsodium.so` via\n4\t//! `libloading` and calls every function through `dlsym`, exactly as an\n5\t//! external consumer would. Rust functions are NEVER called directly, so the\n6\t//! `#[no_mangle]` / `extern \"C\"` export wrappers are under test too.\n7\t#![allow(dead_code)]\n8\t\n9\tuse libloading::{Library, Symbol};\n10\tuse std::ffi::c_void;\n11\tuse std::path::PathBuf;\n12\tuse std::sync::OnceLock;\n13\t\n14\t// ---------------------------------------------------------------- library load\n15\t\n16\tpub struct Libs {\n17\t    pub c: Library,\n18\t    pub r: Library,\n19\t}\n20\t\n21\tfn crate_root() -> PathBuf {\n22\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n23\t}\n24\t\n25\tfn find_c_so() -> PathBuf {\n26\t    let p = crate_root().join(\"c_src/build/libsodium.so\");\n27\t    assert!(\n28\t        p.exists(),\n29\t        \"C shared library not found at {p:?}. Build it with:\\n  \\\n30\t         cd c_src && mkdir -p build && cd build && \\\n31\t         cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n32\t    );\n33\t    p\n34\t}\n35\t\n36\t/// Prefer the profile the tests were built with, then fall back.\n37\tfn find_rust_so() -> PathBuf {\n38\t    let root = crate_root();\n39\t    let mut cands = vec![];\n40\t    if cfg!(debug_assertions) {\n41\t        cands.push(root.join(\"target/debug/liblibsodium.so\"));\n42\t        cands.push(root.join(\"target/release/liblibsodium.so\"));\n43\t    } else {\n44\t        cands.push(root.join(\"target/release/liblibsodium.so\"));\n45\t        cands.push(root.join(\"target/debug/liblibsodium.so\"));\n46\t    }\n47\t    for c in &cands {\n48\t        if c.exists() {\n49\t            assert_not_stale(c);\n50\t            return c.clone();\n51\t        }\n52\t    }\n53\t    panic!(\"Rust cdylib not found; tried {cands:?}. Run `cargo build`.\");\n54\t}\n55\t\n56\t/// `cargo test` does NOT rebuild a `cdylib`-only crate for integration tests\n57\t/// (there is no dependency edge from the test target to the `.so`), so a stale\n58\t/// `.so` would be silently tested and every assertion could pass vacuously.\n59\t/// Refuse to run if any `src/**.rs` is newer than the `.so`.\n60\tfn assert_not_stale(so: &std::path::Path) {\n61\t    let so_t = match so.metadata().and_then(|m| m.modified()) {\n62\t        Ok(t) => t,\n63\t        Err(_) => return,\n64\t    };\n65\t    let mut newest: Option<(std::time::SystemTime, PathBuf)> = None;\n66\t    let mut stack = vec![crate_root().join(\"src\")];\n67\t    while let Some(d) = stack.pop() {\n68\t        let rd = match std::fs::read_dir(&d) {\n69\t            Ok(x) => x,\n70\t            Err(_) => continue,\n71\t        };\n72\t        for e in rd.flatten() {\n73\t            let p = e.path();\n74\t            if p.is_dir() {\n75\t                stack.push(p);\n76\t            } else if p.extension().is_some_and(|x| x == \"rs\") {\n77\t                if let Ok(t) = e.metadata().and_then(|m| m.modified()) {\n78\t                    if newest.as_ref().is_none_or(|(bt, _)| t > *bt) {\n79\t                        newest = Some((t, p));\n80\t                    }\n81\t                }\n82\t            }\n83\t        }\n84\t    }\n85\t    if let Some((t, p)) = newest {\n86\t        assert!(\n87\t            t <= so_t,\n88\t            \"STALE Rust .so!\\n  {} is newer than\\n  {}\\n\\n\\\n89\t             `cargo test` does not rebuild a cdylib-only crate for integration \\\n90\t             tests. Run `cargo build` (or `cargo build --release`) first, \\\n91\t             otherwise the tests silently run against old code.\",\n92\t            p.display(),\n93\t            so.display()\n94\t        );\n95\t    }\n96\t}\n97\t\n98\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n99\t\n100\tpub fn libs() -> &'static Libs {\n101\t    LIBS.get_or_init(|| unsafe {\n102\t        let c = Library::new(find_c_so()).expect(\"dlopen C libsodium.so\");\n103\t        let r = Library::new(find_rust_so()).expect(\"dlopen Rust liblibsodium.so\");\n104\t        Libs { c, r }\n105\t    })\n106\t}\n107\t\n108\t/// Look a symbol up in one library. Panics with the symbol name on failure so a\n109\t/// missing export is reported clearly rather than as an opaque dlsym error.\n110\tpub unsafe fn sym<T>(lib: &'static Library, name: &str) -> Symbol<'static, T> {\n111\t    let mut owned: Vec<u8> = Vec::with_capacity(name.len() + 1);\n112\t    owned.extend_from_slice(name.as_bytes());\n113\t    owned.push(0);\n114\t    lib.get::<T>(&owned)\n115\t        .unwrap_or_else(|e| panic!(\"symbol `{name}` not found: {e}\"))\n116\t}\n117\t\n118\t/// Get the same symbol from both libraries: `(c_fn, rust_fn)`.\n119\tpub unsafe fn pair<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n120\t    let l = libs();\n121\t    (sym::<T>(&l.c, name), sym::<T>(&l.r, name))\n122\t}\n123\t\n124\t/// Convenience wrapper: fetch a function pair, typed.\n125\t#[macro_export]\n126\tmacro_rules! fnpair {\n127\t    ($name:literal, $t:ty) => {{ unsafe { $crate::common::pair::<$t>($name) } }};\n128\t}\n129\t\n130\t// ------------------------------------------------------------------- assertion\n131\t\n132\tpub fn assert_eq_bytes(what: &str, c: &[u8], r: &[u8]) {\n133\t    if c != r {\n134\t        let n = c.len().min(r.len());\n135\t        let mut first = n;\n136\t        for i in 0..n {\n137\t            if c[i] != r[i] {\n138\t                first = i;\n139\t                break;\n140\t            }\n141\t        }\n142\t        panic!(\n143\t            \"{what}: OUTPUT MISMATCH\\n  C len={} rust len={}\\n  first differing byte at {}\\n  \\\n144\t             C   ={}\\n  rust={}\",\n145\t            c.len(),\n146\t            r.len(),\n147\t            first,\n148\t            hexs(c),\n149\t            hexs(r)\n150\t        );\n151\t    }\n152\t}\n153\t\n154\tpub fn hexs(b: &[u8]) -> String {\n155\t    const MAX: usize = 96;\n156\t    let mut s = String::new();\n157\t    for (i, x) in b.iter().enumerate() {\n158\t        if i == MAX {\n159\t            s.push_str(&format!(\"... (+{} more)\", b.len() - MAX));\n160\t            break;\n161\t        }\n162\t        s.push_str(&format!(\"{x:02x}\"));\n163\t    }\n164\t    if b.is_empty() {\n165\t        s.push_str(\"<empty>\");\n166\t    }\n167\t    s\n168\t}\n169\t\n170\t// ------------------------------------------------------- deterministic PRNG\n171\t\n172\t/// SplitMix64 — reproducible, no external dependency.\n173\tpub struct Rng(pub u64);\n174\t\n175\timpl Rng {\n176\t    pub fn new(seed: u64) -> Self {\n177\t        Rng(seed)\n178\t    }\n179\t    pub fn next_u64(&mut self) -> u64 {\n180\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n181\t        let mut z = self.0;\n182\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n183\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n184\t        z ^ (z >> 31)\n185\t    }\n186\t    pub fn next_u32(&mut self) -> u32 {\n187\t        (self.next_u64() >> 32) as u32\n188\t    }\n189\t    pub fn byte(&mut self) -> u8 {\n190\t        (self.next_u64() >> 56) as u8\n191\t    }\n192\t    pub fn fill(&mut self, b: &mut [u8]) {\n193\t        for x in b.iter_mut() {\n194\t            *x = self.byte();\n195\t        }\n196\t    }\n197\t    pub fn bytes(&mut self, n: usize) -> Vec<u8> {\n198\t        let mut v = vec![0u8; n];\n199\t        self.fill(&mut v);\n200\t        v\n201\t    }\n202\t    /// Uniform-ish in `[0, n)`.\n203\t    pub fn below(&mut self, n: usize) -> usize {\n204\t        if n == 0 {\n205\t            0\n206\t        } else {\n207\t            (self.next_u64() % n as u64) as usize\n208\t        }\n209\t    }\n210\t    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n211\t        &xs[self.below(xs.len())]\n212\t    }\n213\t}\n214\t\n215\t/// The fixed seed used across all property-style rows, so failures reproduce.\n216\tpub const SEED: u64 = 0x5EED_1234_5EED_1234;\n217\t\n218\t// ------------------------------------------------ forked abort/misuse checking\n219\t\n220\t#[derive(Debug, PartialEq, Eq, Clone, Copy)]\n221\tpub enum Outcome {\n222\t    /// The call returned normally with this value.\n223\t    Returned(i64),\n224\t    /// The process died from this signal (SIGABRT == 6 for `sodium_misuse()`).\n225\t    Signaled(i32),\n226\t}\n227\t\n228\t/// Run `f` in a forked child so that a `sodium_misuse()` -> `abort()` can be\n229\t/// observed without killing the test runner. Used for every `misuse` row in\n230\t/// ERRORS.md: both the C and the Rust library must abort on the same input.\n231\tpub fn forked<F: FnOnce() -> i64>(f: F) -> Outcome {\n232\t    unsafe {\n233\t        // Flush so the child does not duplicate buffered output.\n234\t        libc::fflush(std::ptr::null_mut());\n235\t        let pid = libc::fork();\n236\t        assert!(pid >= 0, \"fork failed\");\n237\t        if pid == 0 {\n238\t            // Child: silence stderr so abort() messages do not spam the log.\n239\t            let devnull = libc::open(b\"/dev/null\\0\".as_ptr() as *const libc::c_char, libc::O_WRONLY);\n240\t            if devnull >= 0 {\n241\t                libc::dup2(devnull, 2);\n242\t            }\n243\t            let v = f();\n244\t            // Encode a normal return in the low 7 bits + a marker.\n245\t            libc::_exit(if (0..=100).contains(&v) { v as i32 } else { 101 });\n246\t        }\n247\t        let mut status: i32 = 0;\n248\t        let w = libc::waitpid(pid, &mut status, 0);\n249\t        assert_eq!(w, pid, \"waitpid failed\");\n250\t        if libc::WIFSIGNALED(status) {\n251\t            Outcome::Signaled(libc::WTERMSIG(status))\n252\t        } else {\n253\t            Outcome::Returned(libc::WEXITSTATUS(status) as i64)\n254\t        }\n255\t    }\n256\t}\n257\t\n258\tpub const SIGABRT: i32 = 6;\n259\t\n260\t/// Assert that C and Rust behave identically for a branch that ends in\n261\t/// `sodium_misuse()` (or any other fatal path).\n262\tpub fn assert_same_fatal(what: &str, c: Outcome, r: Outcome) {\n263\t    assert_eq!(\n264\t        c, r,\n265\t        \"{what}: C and Rust disagree on the fatal/abort path (C={c:?} rust={r:?})\"\n266\t    );\n267\t}\n268\t\n269\t// ---------------------------------------------------- injected randombytes RNG\n270\t//\n271\t// `struct randombytes_implementation` — field order and signatures taken\n272\t// verbatim from c_src/libsodium/include/sodium/randombytes.h.\n273\t\n274\t#[repr(C)]\n275\tpub struct RandombytesImpl {\n276\t    pub implementation_name: Option<extern \"C\" fn() -> *const libc::c_char>,\n277\t    pub random: Option<extern \"C\" fn() -> u32>,\n278\t    pub stir: Option<extern \"C\" fn()>,\n279\t    pub uniform: Option<extern \"C\" fn(u32) -> u32>,\n280\t    pub buf: Option<extern \"C\" fn(*mut c_void, usize)>,\n281\t    pub close: Option<extern \"C\" fn() -> libc::c_int>,\n282\t}\n283\t\n284\t// Two INDEPENDENT counter states so the C library and the Rust library each see\n285\t// the same deterministic stream instead of interleaving one shared counter.\n286\tstatic mut CTR_C: u64 = 0;\n287\tstatic mut CTR_R: u64 = 0;\n288\t\n289\tconst IMPL_NAME: &[u8] = b\"difftest\\0\";\n290\t\n291\textern \"C\" fn name_cb() -> *const libc::c_char {\n292\t    IMPL_NAME.as_ptr() as *const libc::c_char\n293\t}\n294\textern \"C\" fn stir_cb() {}\n295\textern \"C\" fn close_cb() -> libc::c_int {\n296\t    0\n297\t}\n298\t\n299\t#[inline]\n300\tfn step(ctr: &mut u64) -> u64 {\n301\t    *ctr = ctr.wrapping_add(0x9E37_79B9_7F4A_7C15);\n302\t    let mut z = *ctr;\n303\t    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n304\t    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n305\t    z ^ (z >> 31)\n306\t}\n307\t\n308\textern \"C\" fn random_c() -> u32 {\n309\t    unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_C)) >> 32) as u32 }\n310\t}\n311\textern \"C\" fn random_r() -> u32 {\n312\t    unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_R)) >> 32) as u32 }\n313\t}\n314\textern \"C\" fn buf_c(p: *mut c_void, n: usize) {\n315\t    let s = unsafe { std::slice::from_raw_parts_mut(p as *mut u8, n) };\n316\t    for x in s.iter_mut() {\n317\t        *x = unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_C)) >> 56) as u8 };\n318\t    }\n319\t}\n320\textern \"C\" fn buf_r(p: *mut c_void, n: usize) {\n321\t    let s = unsafe { std::slice::from_raw_parts_mut(p as *mut u8, n) };\n322\t    for x in s.iter_mut() {\n323\t        *x = unsafe { (step(&mut *std::ptr::addr_of_mut!(CTR_R)) >> 56) as u8 };\n324\t    }\n325\t}\n326\t/// A custom `uniform` so the delegation path (impl->uniform != NULL) is covered.\n327\textern \"C\" fn uniform_c(ub: u32) -> u32 {\n328\t    if ub < 2 { 0 } else { random_c() % ub }\n329\t}\n330\textern \"C\" fn uniform_r(ub: u32) -> u32 {\n331\t    if ub < 2 { 0 } else { random_r() % ub }\n332\t}\n333\t\n334\tpub static mut IMPL_C: RandombytesImpl = RandombytesImpl {\n335\t    implementation_name: Some(name_cb),\n336\t    random: Some(random_c),\n337\t    stir: Some(stir_cb),\n338\t    uniform: None,\n339\t    buf: Some(buf_c),\n340\t    close: Some(close_cb),\n341\t};\n342\tpub static mut IMPL_R: RandombytesImpl = RandombytesImpl {\n343\t    implementation_name: Some(name_cb),\n344\t    random: Some(random_r),\n345\t    stir: Some(stir_cb),\n346\t    uniform: None,\n347\t    buf: Some(buf_r),\n348\t    close: Some(close_cb),\n349\t};\n350\tpub static mut IMPL_C_UNIF: RandombytesImpl = RandombytesImpl {\n351\t    implementation_name: Some(name_cb),\n352\t    random: Some(random_c),\n353\t    stir: Some(stir_cb),\n354\t    uniform: Some(uniform_c),\n355\t    buf: Some(buf_c),\n356\t    close: Some(close_cb),\n357\t};\n358\tpub static mut IMPL_R_UNIF: RandombytesImpl = RandombytesImpl {\n359\t    implementation_name: Some(name_cb),\n360\t    random: Some(random_r),\n361\t    stir: Some(stir_cb),\n362\t    uniform: Some(uniform_r),\n363\t    buf: Some(buf_r),\n364\t    close: Some(close_cb),\n365\t};\n366\t\n367\ttype SetImpl = unsafe extern \"C\" fn(*const RandombytesImpl) -> libc::c_int;\n368\t\n369\t/// Install the deterministic RNG into BOTH libraries and reset both counters,\n370\t/// so that any `*_keygen` / `*_random` output is byte-comparable.\n371\tpub fn install_det_rng(with_uniform: bool) {\n372\t    let (c, r) = unsafe { pair::<SetImpl>(\"randombytes_set_implementation\") };\n373\t    unsafe {\n374\t        CTR_C = 0;\n375\t        CTR_R = 0;\n376\t        if with_uniform {\n377\t            c(std::ptr::addr_of!(IMPL_C_UNIF));\n378\t            r(std::ptr::addr_of!(IMPL_R_UNIF));\n379\t        } else {\n380\t            c(std::ptr::addr_of!(IMPL_C));\n381\t            r(std::ptr::addr_of!(IMPL_R));\n382\t        }\n383\t    }\n384\t}\n385\t\n386\t/// Reset both deterministic counters to the same point.\n387\tpub fn reset_det_rng() {\n388\t    unsafe {\n389\t        CTR_C = 0;\n390\t        CTR_R = 0;\n391\t    }\n392\t}\n393\t\n394\t// ------------------------------------------------------------------ init once\n395\t\n396\tstatic INIT: OnceLock<()> = OnceLock::new();\n397\t\n398\t/// Call `sodium_init()` on both libraries exactly once per test process.\n399\tpub fn init_both() {\n400\t    INIT.get_or_init(|| {\n401\t        let (c, r) = unsafe { pair::<unsafe extern \"C\" fn() -> libc::c_int>(\"sodium_init\") };\n402\t        let (rc, rr) = unsafe { (c(), r()) };\n403\t        assert_eq!(rc, rr, \"sodium_init() first-call return differs\");\n404\t        assert!(rc == 0 || rc == 1, \"sodium_init() returned {rc}\");\n405\t    });\n406\t}\n407\t\n408\t// --------------------------------------------------------------- misc helpers\n409\t\n410\t/// Standard length sweep used by most hash/stream rows.\n411\tpub const LENS: &[usize] = &[\n412\t    0, 1, 2, 3, 7, 8, 15, 16, 17, 31, 32, 33, 55, 56, 63, 64, 65, 71, 72, 73, 111, 112, 127, 128,\n413\t    129, 135, 136, 137, 143, 144, 167, 168, 169, 191, 192, 255, 256, 257, 271, 272, 336, 337, 383,\n414\t    384, 512, 513, 1000, 1024,\n415\t];\n416\t\n417\t/// Interesting fixed byte patterns for keys/nonces.\n418\tpub fn patterns(n: usize, rng: &mut Rng) -> Vec<Vec<u8>> {\n419\t    vec![\n420\t        vec![0u8; n],\n421\t        vec![0xffu8; n],\n422\t        (0..n).map(|i| i as u8).collect(),\n423\t        rng.bytes(n),\n424\t        rng.bytes(n),\n425\t    ]\n426\t}\n427\t"}]},"parent_tool_use_id":"toolu_bdrk_013xj565Xgh7bG77qAPP4THZ","session_id":"94902601-9803-4a17-b8b6-a77154607051","uuid":"0e433b89-f8fa-4e3c-9f3e-c2e6e9ccaf64","timestamp":"2026-08-14T17:37:38.284Z","subagent_type":"general-purpose","task_description":"Write MAC/generichash tests"}
