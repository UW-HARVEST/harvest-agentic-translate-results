{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014o4VEEf9JskzjVpuxwjNhq","type":"tool_result","content":"1\t//! Phase B rows A1..A16 — `utf.c` differential tests.\n2\t//! Every call goes through the `.so` exports of both libraries.\n3\t#![allow(non_snake_case)]\n4\t\n5\tmod common;\n6\tuse common::*;\n7\tuse std::os::raw::{c_char, c_int};\n8\t\n9\t/// Decode one byte string with both libraries; returns (retlen, rune).\n10\tfn chartorune(api: &Api, bytes: &[u8]) -> (c_int, c_int) {\n11\t    // Always NUL-terminate: chartorune relies on the terminator.\n12\t    let mut buf: Vec<u8> = bytes.to_vec();\n13\t    buf.push(0);\n14\t    let mut rune: c_int = -12345;\n15\t    let n = unsafe { (api.jsU_chartorune)(&mut rune, buf.as_ptr() as *const c_char) };\n16\t    (n, rune)\n17\t}\n18\t\n19\tfn diff_chartorune(label: &str, cases: impl Iterator<Item = Vec<u8>>) {\n20\t    let cases: Vec<Vec<u8>> = cases.collect();\n21\t    let (cr, rr) = both(|api, _| {\n22\t        cases.iter().map(|b| chartorune(api, b)).collect::<Vec<_>>()\n23\t    });\n24\t    for (i, (c, r)) in cr.iter().zip(rr.iter()).enumerate() {\n25\t        assert_eq!(\n26\t            c, r,\n27\t            \"chartorune DIVERGENCE [{}] input={:02x?}: C={:?} Rust={:?}\",\n28\t            label, cases[i], c, r\n29\t        );\n30\t    }\n31\t}\n32\t\n33\t// ---------------------------------------------------------------- A1, A2, A6, A9\n34\t#[test]\n35\tfn a1_a2_a6_a9_chartorune_all_single_bytes() {\n36\t    diff_chartorune(\"single bytes 0x00..0xFF\", (0u32..=0xFF).map(|b| vec![b as u8]));\n37\t}\n38\t\n39\t// ---------------------------------------------------------------- A3\n40\t#[test]\n41\tfn a3_chartorune_all_two_byte_sequences() {\n42\t    let mut cases = Vec::new();\n43\t    for b0 in 0xC0u32..=0xDF {\n44\t        for b1 in 0x00u32..=0xFF {\n45\t            if b1 == 0 {\n46\t                cases.push(vec![b0 as u8]); // truncated\n47\t            } else {\n48\t                cases.push(vec![b0 as u8, b1 as u8]);\n49\t            }\n50\t        }\n51\t    }\n52\t    diff_chartorune(\"2-byte\", cases.into_iter());\n53\t}\n54\t\n55\t// ---------------------------------------------------------------- A4, A8\n56\t#[test]\n57\tfn a4_a8_chartorune_all_three_byte_sequences() {\n58\t    // Exhaustive over lead+first continuation, and a sweep of second bytes.\n59\t    let mut cases = Vec::new();\n60\t    for b0 in 0xE0u32..=0xEF {\n61\t        for b1 in 1u32..=0xFF {\n62\t            for b2 in [1u32, 0x40, 0x7F, 0x80, 0xA0, 0xBF, 0xC0, 0xFF] {\n63\t                cases.push(vec![b0 as u8, b1 as u8, b2 as u8]);\n64\t            }\n65\t            cases.push(vec![b0 as u8, b1 as u8]); // truncated\n66\t        }\n67\t    }\n68\t    diff_chartorune(\"3-byte\", cases.into_iter());\n69\t}\n70\t\n71\t#[test]\n72\tfn a4_chartorune_surrogates_and_overlong() {\n73\t    let mut cases: Vec<Vec<u8>> = vec![\n74\t        vec![0xC0, 0x80],             // overlong NUL\n75\t        vec![0xC1, 0xBF],             // overlong\n76\t        vec![0xE0, 0x80, 0x80],       // overlong\n77\t        vec![0xE0, 0x9F, 0xBF],       // overlong\n78\t        vec![0xF0, 0x80, 0x80, 0x80], // overlong\n79\t        vec![0xF0, 0x8F, 0xBF, 0xBF], // overlong\n80\t        vec![0xED, 0xA0, 0x80],       // U+D800 surrogate\n81\t        vec![0xED, 0xBF, 0xBF],       // U+DFFF surrogate\n82\t        vec![0xEF, 0xBF, 0xBD],       // U+FFFD\n83\t        vec![0xF4, 0x8F, 0xBF, 0xBF], // U+10FFFF = Runemax\n84\t        vec![0xF4, 0x90, 0x80, 0x80], // Runemax+1\n85\t        vec![0xF7, 0xBF, 0xBF, 0xBF], // 0x1FFFFF\n86\t        vec![0xF8, 0x88, 0x80, 0x80, 0x80],\n87\t        vec![0xFC, 0x84, 0x80, 0x80, 0x80, 0x80],\n88\t        vec![0xFE, 0x80],\n89\t        vec![0xFF, 0xFF],\n90\t    ];\n91\t    // every surrogate code point, encoded as 3-byte UTF-8 (CESU style)\n92\t    for cp in 0xD800u32..=0xDFFF {\n93\t        cases.push(vec![\n94\t            (0xE0 | (cp >> 12)) as u8,\n95\t            (0x80 | ((cp >> 6) & 0x3F)) as u8,\n96\t            (0x80 | (cp & 0x3F)) as u8,\n97\t        ]);\n98\t    }\n99\t    diff_chartorune(\"surrogates/overlong\", cases.into_iter());\n100\t}\n101\t\n102\t// ---------------------------------------------------------------- A5, A7\n103\t#[test]\n104\tfn a5_a7_chartorune_four_byte_and_truncated() {\n105\t    let mut cases = Vec::new();\n106\t    for b0 in 0xF0u32..=0xFF {\n107\t        for b1 in [1u32, 0x7F, 0x80, 0x8F, 0x90, 0xBF, 0xC0, 0xFF] {\n108\t            for b2 in [1u32, 0x80, 0xBF, 0xC0] {\n109\t                for b3 in [1u32, 0x80, 0xBF, 0xC0] {\n110\t                    cases.push(vec![b0 as u8, b1 as u8, b2 as u8, b3 as u8]);\n111\t                }\n112\t                cases.push(vec![b0 as u8, b1 as u8, b2 as u8]); // truncated\n113\t            }\n114\t            cases.push(vec![b0 as u8, b1 as u8]); // truncated\n115\t        }\n116\t        cases.push(vec![b0 as u8]); // truncated\n117\t    }\n118\t    diff_chartorune(\"4-byte\", cases.into_iter());\n119\t}\n120\t\n121\t// ---------------------------------------------------------------- A10\n122\t#[test]\n123\tfn a10_chartorune_randomized_byte_strings() {\n124\t    let mut rng = Rng::new(0xC0FFEE_1234);\n125\t    let mut cases = Vec::new();\n126\t    for _ in 0..40000 {\n127\t        let len = 1 + rng.below(6) as usize;\n128\t        let mut v = Vec::with_capacity(len);\n129\t        for _ in 0..len {\n130\t            // bias towards lead/continuation bytes\n131\t            let b = match rng.below(4) {\n132\t                0 => rng.next_u32() as u8,\n133\t                1 => 0x80 | (rng.next_u32() as u8 & 0x3F),\n134\t                2 => 0xC0 | (rng.next_u32() as u8 & 0x3F),\n135\t                _ => rng.next_u32() as u8 & 0x7F,\n136\t            };\n137\t            v.push(if b == 0 { 1 } else { b });\n138\t        }\n139\t        cases.push(v);\n140\t    }\n141\t    diff_chartorune(\"random\", cases.into_iter());\n142\t}\n143\t\n144\t// ---------------------------------------------------------------- A11\n145\t#[test]\n146\tfn a11_runetochar_all_runes() {\n147\t    let runes: Vec<c_int> = (-2000i64..0x110200i64)\n148\t        .step_by(1)\n149\t        .map(|x| x as c_int)\n150\t        .chain([\n151\t            i32::MIN,\n152\t            i32::MIN + 1,\n153\t            -1,\n154\t            0x7FFFFFFF,\n155\t            0x7FFFFFFE,\n156\t            0x10FFFF,\n157\t            0x110000,\n158\t            0xFFFD,\n159\t        ])\n160\t        .collect();\n161\t    let (cr, rr) = both(|api, _| {\n162\t        let mut out: Vec<(c_int, Vec<u8>)> = Vec::with_capacity(runes.len());\n163\t        for &r in &runes {\n164\t            // UTFmax is 4 but runetochar can emit more for out-of-range runes:\n165\t            // give it a generous buffer and a poison pattern so we detect writes.\n166\t            let mut buf = [0xAAu8; 32];\n167\t            let n = unsafe { (api.jsU_runetochar)(buf.as_mut_ptr() as *mut c_char, &r) };\n168\t            out.push((n, buf.to_vec()));\n169\t        }\n170\t        out\n171\t    });\n172\t    for (i, (c, r)) in cr.iter().zip(rr.iter()).enumerate() {\n173\t        assert_eq!(\n174\t            c, r,\n175\t            \"runetochar DIVERGENCE rune={:#x}({}): C=({}, {:02x?}) Rust=({}, {:02x?})\",\n176\t            runes[i], runes[i], c.0, c.1, r.0, r.1\n177\t        );\n178\t    }\n179\t}\n180\t\n181\t// ---------------------------------------------------------------- A12\n182\t#[test]\n183\tfn a12_runelen_all_runes() {\n184\t    let runes: Vec<c_int> = (-2000i64..0x110200i64)\n185\t        .map(|x| x as c_int)\n186\t        .chain([i32::MIN, i32::MIN + 1, -1, 0x7FFFFFFF])\n187\t        .collect();\n188\t    let (cr, rr) = both(|api, _| {\n189\t        runes\n190\t            .iter()\n191\t            .map(|&r| unsafe { (api.jsU_runelen)(r) })\n192\t            .collect::<Vec<_>>()\n193\t    });\n194\t    for (i, (c, r)) in cr.iter().zip(rr.iter()).enumerate() {\n195\t        assert_eq!(c, r, \"runelen DIVERGENCE rune={:#x}: C={} Rust={}\", runes[i], c, r);\n196\t    }\n197\t}\n198\t\n199\t// ---------------------------------------------------------------- A13\n200\t#[test]\n201\tfn a13_roundtrip_runetochar_chartorune() {\n202\t    let (cr, rr) = both(|api, _| {\n203\t        let mut out = Vec::new();\n204\t        for r in (0i64..0x110100).map(|x| x as c_int) {\n205\t            let mut buf = [0u8; 16];\n206\t            let n = unsafe { (api.jsU_runetochar)(buf.as_mut_ptr() as *mut c_char, &r) };\n207\t            buf[n.clamp(0, 15) as usize] = 0;\n208\t            let mut back: c_int = -1;\n209\t            let m = unsafe { (api.jsU_chartorune)(&mut back, buf.as_ptr() as *const c_char) };\n210\t            out.push((n, m, back));\n211\t        }\n212\t        out\n213\t    });\n214\t    assert_eq!(cr.len(), rr.len());\n215\t    for (i, (c, r)) in cr.iter().zip(rr.iter()).enumerate() {\n216\t        assert_eq!(c, r, \"roundtrip DIVERGENCE rune={:#x}: C={:?} Rust={:?}\", i, c, r);\n217\t    }\n218\t}\n219\t\n220\t// ---------------------------------------------------------------- A14\n221\t#[test]\n222\tfn a14_rune_class_predicates_exhaustive() {\n223\t    for (name, get) in [\n224\t        (\"isalpharune\", 0usize),\n225\t        (\"islowerrune\", 1),\n226\t        (\"isupperrune\", 2),\n227\t    ] {\n228\t        let (cr, rr) = both(|api, _| {\n229\t            let f = match get {\n230\t                0 => api.jsU_isalpharune,\n231\t                1 => api.jsU_islowerrune,\n232\t                _ => api.jsU_isupperrune,\n233\t            };\n234\t            let mut v = Vec::with_capacity(0x110200);\n235\t            for c in (-256i64..0x110200i64).map(|x| x as c_int) {\n236\t                v.push(unsafe { f(c) });\n237\t            }\n238\t            v\n239\t        });\n240\t        let mut base = -256i64;\n241\t        for (c, r) in cr.iter().zip(rr.iter()) {\n242\t            assert_eq!(c, r, \"{} DIVERGENCE rune={:#x}: C={} Rust={}\", name, base, c, r);\n243\t            base += 1;\n244\t        }\n245\t    }\n246\t}\n247\t\n248\t// ---------------------------------------------------------------- A15\n249\t#[test]\n250\tfn a15_case_conversion_exhaustive() {\n251\t    for (name, which) in [(\"tolowerrune\", 0usize), (\"toupperrune\", 1)] {\n252\t        let (cr, rr) = both(|api, _| {\n253\t            let f = if which == 0 { api.jsU_tolowerrune } else { api.jsU_toupperrune };\n254\t            let mut v = Vec::with_capacity(0x110200);\n255\t            for c in (-256i64..0x110200i64).map(|x| x as c_int) {\n256\t                v.push(unsafe { f(c) });\n257\t            }\n258\t            v\n259\t        });\n260\t        let mut base = -256i64;\n261\t        for (c, r) in cr.iter().zip(rr.iter()) {\n262\t            assert_eq!(c, r, \"{} DIVERGENCE rune={:#x}: C={:#x} Rust={:#x}\", name, base, c, r);\n263\t            base += 1;\n264\t        }\n265\t    }\n266\t}\n267\t\n268\t// ---------------------------------------------------------------- A16\n269\t#[test]\n270\tfn a16_case_conversion_full_exhaustive() {\n271\t    /// Read the NUL(0)-terminated Rune array returned by *_full.\n272\t    unsafe fn read_full(p: *const c_int) -> Option<Vec<c_int>> {\n273\t        if p.is_null() {\n274\t            return None;\n275\t        }\n276\t        let mut v = Vec::new();\n277\t        let mut i = 0isize;\n278\t        while *p.offset(i) != 0 {\n279\t            v.push(*p.offset(i));\n280\t            i += 1;\n281\t            assert!(i < 64, \"unterminated *_full array\");\n282\t        }\n283\t        Some(v)\n284\t    }\n285\t    for (name, which) in [(\"tolowerrune_full\", 0usize), (\"toupperrune_full\", 1)] {\n286\t        let (cr, rr) = both(|api, _| {\n287\t            let f = if which == 0 {\n288\t                api.jsU_tolowerrune_full\n289\t            } else {\n290\t                api.jsU_toupperrune_full\n291\t            };\n292\t            let mut v = Vec::with_capacity(0x110200);\n293\t            for c in (-256i64..0x110200i64).map(|x| x as c_int) {\n294\t                v.push(unsafe { read_full(f(c)) });\n295\t            }\n296\t            v\n297\t        });\n298\t        let mut base = -256i64;\n299\t        for (c, r) in cr.iter().zip(rr.iter()) {\n300\t            assert_eq!(\n301\t                c, r,\n302\t                \"{} DIVERGENCE rune={:#x}: C={:?} Rust={:?}\",\n303\t                name, base, c, r\n304\t            );\n305\t            base += 1;\n306\t        }\n307\t    }\n308\t}\n309\t\n310\t// ---------------------------------------------------------------- js_utflen / js_utfptrtoidx / js_runeat\n311\t#[test]\n312\tfn utflen_and_ptrtoidx_and_runeat() {\n313\t    let corpus: Vec<Vec<u8>> = vec![\n314\t        b\"\".to_vec(),\n315\t        b\"a\".to_vec(),\n316\t        b\"abc\".to_vec(),\n317\t        \"\\u{e9}\".as_bytes().to_vec(),\n318\t        \"h\\u{e9}llo w\\u{f6}rld\".as_bytes().to_vec(),\n319\t        \"\\u{10FFFF}\".as_bytes().to_vec(),\n320\t        \"\\u{1F600}\\u{1F601}\".as_bytes().to_vec(),\n321\t        vec![0xFF, 0xFE, 0x41],\n322\t        vec![0x80, 0x80, 0x41],\n323\t        vec![0xC3],\n324\t        vec![0xE2, 0x82],\n325\t    ];\n326\t    let (cr, rr) = both(|api, _| {\n327\t        let mut out = Vec::new();\n328\t        for s in &corpus {\n329\t            let mut buf = s.clone();\n330\t            buf.push(0);\n331\t            let base = buf.as_ptr() as *const c_char;\n332\t            let len = unsafe { (api.js_utflen)(base) };\n333\t            let mut idxs = Vec::new();\n334\t            for off in 0..=buf.len() {\n335\t                idxs.push(unsafe { (api.js_utfptrtoidx)(base, base.add(off)) });\n336\t            }\n337\t            // js_runeat needs a state (only for the error path, which cannot\n338\t            // trigger here) — pass a real state.\n339\t            let J = unsafe { (api.js_newstate)(None, std::ptr::null_mut(), 0) };\n340\t            let mut runes = Vec::new