{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AHDfo8LoVncMqf9EQi8rFi","type":"tool_result","content":"1\t//! Differential-test harness: loads BOTH the C `libmujs.so` and the Rust\n2\t//! `libmujs.so` with `libloading` and exposes every exported symbol as a\n3\t//! function pointer, so all calls cross the real FFI boundary.\n4\t#![allow(dead_code, non_snake_case, non_camel_case_types, improper_ctypes_definitions)]\n5\t\n6\tuse std::cell::RefCell;\n7\tuse std::ffi::{CStr, CString};\n8\tuse std::os::raw::{c_char, c_double, c_int, c_short, c_uint, c_ushort, c_void};\n9\tuse std::path::PathBuf;\n10\t\n11\tpub type State = *mut c_void;\n12\tpub type Alloc = Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void, c_int) -> *mut c_void>;\n13\tpub type CFunction = Option<unsafe extern \"C-unwind\" fn(State)>;\n14\tpub type Report = Option<unsafe extern \"C-unwind\" fn(State, *const c_char)>;\n15\tpub type Panic = Option<unsafe extern \"C-unwind\" fn(State)>;\n16\tpub type Finalize = Option<unsafe extern \"C-unwind\" fn(State, *mut c_void)>;\n17\tpub type HasProperty = Option<unsafe extern \"C-unwind\" fn(State, *mut c_void, *const c_char) -> c_int>;\n18\tpub type Put = Option<unsafe extern \"C-unwind\" fn(State, *mut c_void, *const c_char) -> c_int>;\n19\tpub type Delete = Option<unsafe extern \"C-unwind\" fn(State, *mut c_void, *const c_char) -> c_int>;\n20\t\n21\t/* ---------- state-constructor flags / attributes / enums (mujs.h) ---------- */\n22\tpub const JS_STRICT: c_int = 1;\n23\tpub const JS_REGEXP_G: c_int = 1;\n24\tpub const JS_REGEXP_I: c_int = 2;\n25\tpub const JS_REGEXP_M: c_int = 4;\n26\tpub const JS_READONLY: c_int = 1;\n27\tpub const JS_DONTENUM: c_int = 2;\n28\tpub const JS_DONTCONF: c_int = 4;\n29\t\n30\t/* ---------- regexp.h ---------- */\n31\tpub const REG_ICASE: c_int = 1;\n32\tpub const REG_NEWLINE: c_int = 2;\n33\tpub const REG_NOTBOL: c_int = 4;\n34\tpub const REG_MAXSUB: usize = 16;\n35\t\n36\t#[repr(C)]\n37\t#[derive(Clone, Copy)]\n38\tpub struct ResubSpan {\n39\t    pub sp: *const c_char,\n40\t    pub ep: *const c_char,\n41\t}\n42\t#[repr(C)]\n43\t#[derive(Clone, Copy)]\n44\tpub struct Resub {\n45\t    pub nsub: c_int,\n46\t    pub sub: [ResubSpan; REG_MAXSUB],\n47\t}\n48\timpl Default for Resub {\n49\t    fn default() -> Self {\n50\t        Resub {\n51\t            nsub: 0,\n52\t            sub: [ResubSpan { sp: std::ptr::null(), ep: std::ptr::null() }; REG_MAXSUB],\n53\t        }\n54\t    }\n55\t}\n56\t\n57\t/* ---------- js_Value (jsi.h): 16-byte union, passed by value ---------- */\n58\t#[repr(C)]\n59\t#[derive(Clone, Copy)]\n60\tpub struct JsValueT {\n61\t    pub pad: [c_char; 15],\n62\t    pub type_: c_char,\n63\t}\n64\t#[repr(C)]\n65\t#[derive(Clone, Copy)]\n66\tpub union JsValueU {\n67\t    pub shrstr: [c_char; 16],\n68\t    pub boolean: c_int,\n69\t    pub number: c_double,\n70\t    pub litstr: *const c_char,\n71\t    pub memstr: *mut c_void,\n72\t    pub object: *mut c_void,\n73\t}\n74\t#[repr(C)]\n75\t#[derive(Clone, Copy)]\n76\tpub union JsValue {\n77\t    pub t: JsValueT,\n78\t    pub u: JsValueU,\n79\t}\n80\timpl JsValue {\n81\t    pub fn zeroed() -> JsValue {\n82\t        JsValue { t: JsValueT { pad: [0; 15], type_: 0 } }\n83\t    }\n84\t    /// Byte-wise view, for byte-identical comparison of stack slots.\n85\t    pub fn bytes(&self) -> [u8; 16] {\n86\t        unsafe { std::mem::transmute_copy(self) }\n87\t    }\n88\t    pub fn tag(&self) -> i8 {\n89\t        unsafe { self.t.type_ as i8 }\n90\t    }\n91\t}\n92\tpub const JS_TSHRSTR: i8 = 0;\n93\tpub const JS_TUNDEFINED: i8 = 1;\n94\tpub const JS_TNULL: i8 = 2;\n95\tpub const JS_TBOOLEAN: i8 = 3;\n96\tpub const JS_TNUMBER: i8 = 4;\n97\tpub const JS_TLITSTR: i8 = 5;\n98\tpub const JS_TMEMSTR: i8 = 6;\n99\tpub const JS_TOBJECT: i8 = 7;\n100\t\n101\t/* enum js_Class */\n102\tpub const JS_COBJECT: c_int = 0;\n103\tpub const JS_CARRAY: c_int = 1;\n104\tpub const JS_CFUNCTION: c_int = 2;\n105\tpub const JS_CSCRIPT: c_int = 3;\n106\tpub const JS_CCFUNCTION: c_int = 4;\n107\tpub const JS_CERROR: c_int = 5;\n108\tpub const JS_CBOOLEAN: c_int = 6;\n109\tpub const JS_CNUMBER: c_int = 7;\n110\tpub const JS_CSTRING: c_int = 8;\n111\tpub const JS_CREGEXP: c_int = 9;\n112\tpub const JS_CDATE: c_int = 10;\n113\tpub const JS_CMATH: c_int = 11;\n114\tpub const JS_CJSON: c_int = 12;\n115\tpub const JS_CARGUMENTS: c_int = 13;\n116\tpub const JS_CITERATOR: c_int = 14;\n117\tpub const JS_CUSERDATA: c_int = 15;\n118\t\n119\t/* limits (jsi.h) */\n120\tpub const JS_STACKSIZE: c_int = 4096;\n121\tpub const JS_ENVLIMIT: c_int = 1024;\n122\tpub const JS_TRYLIMIT: c_int = 64;\n123\tpub const JS_ARRAYLIMIT: c_int = 1 << 26;\n124\tpub const JS_ASTLIMIT: c_int = 400;\n125\tpub const JS_STRLIMIT: c_int = 1 << 28;\n126\t\n127\t/* token ids (jsi.h) — only what tests need */\n128\tpub const TK_IDENTIFIER: c_int = 256;\n129\tpub const TK_WITH: c_int = 256 + 3 + 24 + 30; // last keyword; computed in tests instead\n130\t\n131\t/* ------------------------------------------------------------------ */\n132\t/*  The API table                                                      */\n133\t/* ------------------------------------------------------------------ */\n134\t\n135\tmacro_rules! api {\n136\t    ( $( $name:ident : fn ( $($at:ty),* ) $( -> $rt:ty )? ; )* ) => {\n137\t        pub struct Api {\n138\t            pub path: String,\n139\t            $( pub $name : unsafe extern \"C-unwind\" fn ( $($at),* ) $( -> $rt )? , )*\n140\t        }\n141\t        impl Api {\n142\t            pub fn open(path: &str) -> Api {\n143\t                let lib: &'static libloading::Library = Box::leak(Box::new(\n144\t                    unsafe { libloading::Library::new(path) }\n145\t                        .unwrap_or_else(|e| panic!(\"dlopen {}: {}\", path, e)),\n146\t                ));\n147\t                unsafe {\n148\t                    Api {\n149\t                        path: path.to_string(),\n150\t                        $( $name : {\n151\t                            let s: libloading::Symbol<unsafe extern \"C-unwind\" fn ( $($at),* ) $( -> $rt )?> =\n152\t                                lib.get(concat!(stringify!($name), \"\\0\").as_bytes())\n153\t                                   .unwrap_or_else(|e| panic!(\"dlsym {} in {}: {}\", stringify!($name), path, e));\n154\t                            *s\n155\t                        }, )*\n156\t                    }\n157\t                }\n158\t            }\n159\t        }\n160\t    };\n161\t}\n162\t\n163\tapi! {\n164\t    /* --- utf.c --- */\n165\t    jsU_chartorune: fn(*mut c_int, *const c_char) -> c_int;\n166\t    jsU_runetochar: fn(*mut c_char, *const c_int) -> c_int;\n167\t    jsU_runelen: fn(c_int) -> c_int;\n168\t    jsU_isalpharune: fn(c_int) -> c_int;\n169\t    jsU_islowerrune: fn(c_int) -> c_int;\n170\t    jsU_isupperrune: fn(c_int) -> c_int;\n171\t    jsU_tolowerrune: fn(c_int) -> c_int;\n172\t    jsU_toupperrune: fn(c_int) -> c_int;\n173\t    jsU_tolowerrune_full: fn(c_int) -> *const c_int;\n174\t    jsU_toupperrune_full: fn(c_int) -> *const c_int;\n175\t\n176\t    /* --- regexp.c --- */\n177\t    js_regcomp: fn(*const c_char, c_int, *mut *const c_char) -> *mut c_void;\n178\t    js_regcompx: fn(Alloc, *mut c_void, *const c_char, c_int, *mut *const c_char) -> *mut c_void;\n179\t    js_regexec: fn(*mut c_void, *const c_char, *mut Resub, c_int) -> c_int;\n180\t    js_regfree: fn(*mut c_void);\n181\t    js_regfreex: fn(Alloc, *mut c_void, *mut c_void);\n182\t\n183\t    /* --- jsdtoa.c --- */\n184\t    js_strtod: fn(*const c_char, *mut *mut c_char) -> c_double;\n185\t    js_grisu2: fn(c_double, *mut c_char, *mut c_int) -> c_int;\n186\t    js_fmtexp: fn(*mut c_char, c_int) -> *mut c_char;\n187\t\n188\t    /* --- jsvalue.c number/string helpers --- */\n189\t    js_itoa: fn(*mut c_char, c_int, c_int) -> *mut c_char;\n190\t    js_strtol: fn(*const c_char, *mut *mut c_char, c_int) -> c_double;\n191\t    js_stringtofloat: fn(*const c_char, *mut *mut c_char) -> c_double;\n192\t    jsV_numbertostring: fn(State, *mut c_char, c_double) -> *const c_char;\n193\t    jsV_stringtonumber: fn(State, *const c_char) -> c_double;\n194\t    jsV_numbertointeger: fn(c_double) -> c_double;\n195\t    jsV_numbertoint32: fn(c_double) -> c_int;\n196\t    jsV_numbertouint32: fn(c_double) -> c_uint;\n197\t    jsV_numbertoint16: fn(c_double) -> c_short;\n198\t    jsV_numbertouint16: fn(c_double) -> c_ushort;\n199\t\n200\t    /* --- jsvalue.c low level --- */\n201\t    jsV_toboolean: fn(State, *const JsValue) -> c_int;\n202\t    jsV_tonumber: fn(State, *const JsValue) -> c_double;\n203\t    jsV_tointeger: fn(State, *const JsValue) -> c_double;\n204\t    jsV_tostring: fn(State, *const JsValue) -> *const c_char;\n205\t    jsV_toobject: fn(State, *const JsValue) -> *mut c_void;\n206\t    jsV_toprimitive: fn(State, *mut JsValue, c_int);\n207\t    js_newarguments: fn(State);\n208\t    js_newfunction: fn(State, *mut c_void, *mut c_void);\n209\t    js_newscript: fn(State, *mut c_void, *mut c_void);\n210\t    js_compare: fn(State, *mut c_int) -> c_int;\n211\t    js_equal: fn(State) -> c_int;\n212\t    js_strictequal: fn(State) -> c_int;\n213\t    js_instanceof: fn(State) -> c_int;\n214\t    js_concat: fn(State);\n215\t\n216\t    /* --- jsproperty.c --- */\n217\t    jsV_newobject: fn(State, c_int, *mut c_void) -> *mut c_void;\n218\t    jsV_getownproperty: fn(State, *mut c_void, *const c_char) -> *mut c_void;\n219\t    jsV_getproperty: fn(State, *mut c_void, *const c_char) -> *mut c_void;\n220\t    jsV_getpropertyx: fn(State, *mut c_void, *const c_char, *mut c_int) -> *mut c_void;\n221\t    jsV_setproperty: fn(State, *mut c_void, *const c_char) -> *mut c_void;\n222\t    jsV_delproperty: fn(State, *mut c_void, *const c_char);\n223\t    jsV_newiterator: fn(State, *mut c_void, c_int) -> *mut c_void;\n224\t    jsV_nextiterator: fn(State, *mut c_void) -> *const c_char;\n225\t    jsV_resizearray: fn(State, *mut c_void, c_int);\n226\t\n227\t    /* --- jsintern.c --- */\n228\t    js_intern: fn(State, *const c_char) -> *const c_char;\n229\t    jsS_dumpstrings: fn(State);\n230\t    jsS_freestrings: fn(State);\n231\t    js_putc: fn(State, *mut *mut c_void, c_int);\n232\t    js_puts: fn(State, *mut *mut c_void, *const c_char);\n233\t    js_putm: fn(State, *mut *mut c_void, *const c_char, *const c_char);\n234\t\n235\t    /* --- jslex.c --- */\n236\t    jsY_initlex: fn(State, *const c_char, *const c_char);\n237\t    jsY_lex: fn(State) -> c_int;\n238\t    jsY_lexjson: fn(State) -> c_int;\n239\t    jsY_findword: fn(*const c_char, *const *const c_char, c_int) -> c_int;\n240\t    jsY_iswhite: fn(c_int) -> c_int;\n241\t    jsY_isnewline: fn(c_int) -> c_int;\n242\t    jsY_ishex: fn(c_int) -> c_int;\n243\t    jsY_tohex: fn(c_int) -> c_int;\n244\t    jsY_tokenstring: fn(c_int) -> *const c_char;\n245\t\n246\t    /* --- jsparse.c / jscompile.c --- */\n247\t    jsP_parse: fn(State, *const c_char, *const c_char) -> *mut c_void;\n248\t    jsP_parsefunction: fn(State, *const c_char, *const c_char, *const c_char) -> *mut c_void;\n249\t    jsP_freeparse: fn(State);\n250\t    jsC_compilefunction: fn(State, *mut c_void) -> *mut c_void;\n251\t    jsC_compilescript: fn(State, *mut c_void, c_int) -> *mut c_void;\n252\t\n253\t    /* --- jsrun.c: memory --- */\n254\t    js_malloc: fn(State, c_int) -> *mut c_void;\n255\t    js_realloc: fn(State, *mut c_void, c_int) -> *mut c_void;\n256\t    js_free: fn(State, *mut c_void);\n257\t    js_strdup: fn(State, *const c_char) -> *mut c_char;\n258\t    jsV_newmemstring: fn(State, *const c_char, c_int) -> *mut c_void;\n259\t    jsR_newenvironment: fn(State, *mut c_void, *mut c_void) -> *mut c_void;\n260\t    jsR_unflattenarray: fn(State, *mut c_void);\n261\t\n262\t    /* --- jsstate.c --- */\n263\t    js_newstate: fn(Alloc, *mut c_void, c_int) -> State;\n264\t    js_freestate: fn(State);\n265\t    js_setcontext: fn(State, *mut c_void);\n266\t    js_getcontext: fn(State) -> *mut c_void;\n267\t    js_setreport: fn(State, Report);\n268\t    js_atpanic: fn(State, Panic) -> Panic;\n269\t    js_report: fn(State, *const c_char);\n270\t    js_gc: fn(State, c_int);\n271\t    js_setlimit: fn(State, c_int, c_int);\n272\t    js_dostring: fn(State, *const c_char) -> c_int;\n273\t    js_ploadstring: fn(State, *const c_char, *const c_char) -> c_int;\n274\t    js_loadstring: fn(State, *const c_char, *const c_char);\n275\t    js_loadeval: fn(State, *const c_char, *const c_char);\n276\t    js_trystring: fn(State, c_int, *const c_char) -> *const c_char;\n277\t    js_trynumber: fn(State, c_int, c_double) -> c_double;\n278\t    js_tryinteger: fn(State, c_int, c_int) -> c_int;\n279\t    js_tryboolean: fn(State, c_int, c_int) -> c_int;\n280\t\n281\t    /* --- jsrun.c: calls & exceptions --- */\n282\t    js_pcall: fn(State, c_int) -> c_int;\n283\t    js_pconstruct: fn(State, c_int) -> c_int;\n284\t    js_call: fn(State, c_int);\n285\t    js_construct: fn(State, c_int);\n286\t    js_eval: fn(State);\n287\t    js_savetry: fn(State) -> *mut c_void;\n288\t    js_savetrypc: fn(State, *mut c_void) -> *mut c_void;\n289\t    js_endtry: fn(State);\n290\t    js_throw: fn(State);\n291\t    js_trap: fn(State, c_int);\n292\t\n293\t    /* --- jsrun.c: stack --- */\n294\t    js_gettop: fn(State) -> c_int;\n295\t    js_pop: fn(State, c_int);\n296\t    js_rot: fn(State, c_int);\n297\t    js_copy: fn(State, c_int);\n298\t    js_remove: fn(State, c_int);\n299\t    js_insert: fn(State, c_int);\n300\t    js_replace: fn(State, c_int);\n301\t    js_dup: fn(State);\n302\t    js_dup2: fn(State);\n303\t    js_rot2: fn(State);\n304\t    js_rot3: fn(State);\n305\t    js_rot4: fn(State);\n306\t    js_rot2pop1: fn(State);\n307\t    js_rot3pop2: fn(State);\n308\t\n309\t    /* --- jsrun.c: push --- */\n310\t    js_pushvalue: fn(State, JsValue);\n311\t    js_pushobject: fn(State, *mut c_void);\n312\t    js_pushglobal: fn(State);\n313\t    js_pushundefined: fn(State);\n314\t    js_pushnull: fn(State);\n315\t    js_pushboolean: fn(State, c_int);\n316\t    js_pushnumber: fn(State, c_double);\n317\t    js_pushstring: fn(State, *const c_char);\n318\t    js_pushlstring: fn(State, *const c_char, c_int);\n319\t    js_pushliteral: fn(State, *const c_char);\n320\t    js_pushiterator: fn(State, c_int, c_int);\n321\t    js_nextiterator: fn(State, c_int) -> *const c_char;\n322\t\n323\t    /* --- jsrun.c: new --- */\n324\t    js_newobject: fn(State);\n325\t    js_newobjectx: fn(State);\n326\t    js_newarray: fn(State);\n327\t    js_newboolean: fn(State, c_int);\n328\t    js_newnumber: fn(State, c_double);\n329\t    js_newstring: fn(State, *const c_char);\n330\t    js_newcfunction: fn(State, CFunction, *const c_char, c_int);\n331\t    js_newcfunctionx: fn(State, CFunction, *const c_char, c_int, *mut c_void, Finalize);\n332\t    js_newcconstructor: fn(State, CFunction, CFunction, *const c_char, c_int);\n333\t    js_newuserdata: fn(State, *const c_char, *mut c_void, Finalize);\n334\t    js_newuserdatax: fn(State, *const c_char, *mut c_void, HasProperty, Put, Delete, Finalize);\n335\t    js_newregexp: fn(State, *const c_char, c_int);\n336\t\n337\t    /* --- jserror.c: js_new*error --- */\n338\t    js_newerror: fn(State, *const c_char);\n339\t    js_newevalerror: fn(State, *const c_char);\n340\t    js_newrangeerror: fn(State, *const c_char);\n341\t    js_newreferenceerror: fn(State, *const c_char);\n342\t    js_newsyntaxerror: fn(State, *const c_char);\n343\t    js_newtypeerror: fn(State, *const c_char);\n344\t    js_newurierror: fn(State, *const c_char);\n345\t\n346\t    /* --- jsrun.c: properties --- */\n347\t    js_hasproperty: fn(State, c_int, *const c_char) -> c_int;\n348\t    js_getproperty: fn(State, c_int, *const c_char);\n349\t    js_setproperty: fn(State, c_int, *const c_char);\n350\t    js_defproperty: fn(State, c_int, *const c_char, c_int);\n351\t    js_delproperty: fn(State, c_int, *const c_char);\n352\t    js_defaccessor: fn(State, c_int, *const c_char, c_int);\n353\t    js_getglobal: fn(State, *const c_char);\n354\t    js_setglobal: fn(State, *const c_char);\n355\t    js_defglobal: fn(State, *const c_char, c_int);\n356\t    js_delglobal: fn(State, *const c_char);\n357\t    js_getregistry: fn(State, *const c_char);\n358\t    js_setregistry: fn(State, *const c_char);\n359\t    js_delregistry: fn(State, *const c_char);\n360\t    js_ref: fn(State) -> *const c_char;\n361\t    js_unref: fn(State, *const c_char);\n362\t    js_getlength: fn(State, c_int) -> c_int;\n363\t    js_setlength: fn(State, c_int, c_int);\n364\t    js_hasindex: fn(State, c_int, c_int) -> c_int;\n365\t    js_getindex: fn(State, c_int, c_int);\n366\t    js_setindex: fn(State, c_int, c_int);\n367\t    js_delindex: fn(State, c_int, c_int);\n368\t    js_currentfunction: fn(State);\n369\t    js_currentfunctiondata: fn(State) -> *mut c_void;\n370\t\n371\t    /* --- jsrun.c: predicates & conversions --- */\n372\t    js_isdefined: fn(State, c_int) -> c_int;\n373\t    js_isundefined: fn(State, c_int) -> c_int;\n374\t    js_isnull: fn(State, c_int) -> c_int;\n375\t    js_isboolean: fn(State, c_int) -> c_int;\n376\t    js_isnumber: fn(State, c_int) -> c_int;\n377\t    js_isstring: fn(State, c_int) -> c_int;\n378\t    js_isprimitive: fn(State, c_int) -> c_int;\n379\t    js_isobject: fn(State, c_int) -> c_int;\n380\t    js_isarray: fn(State, c_int) -> c_int;\n381\t    js_isregexp: fn(State, c_int) -> c_int;\n382\t    js_iscoercible: fn(State, c_int) -> c_int;\n383\t    js_iscallable: fn(State, c_int) -> c_int;\n384\t    js_isuserdata: fn(State, c_int, *const c_char) -> c_int;\n385\t    js_iserror: fn(State, c_int) -> c_int;\n386\t    js_isnumberobject: fn(State, c_int) -> c_int;\n387\t    js_isstringobject: fn(State, c_int) -> c_int;\n388\t    js_isbooleanobject: fn(State, c_int) -> c_int;\n389\t    js_isdateobject: fn(State, c_int) -> c_int;\n390\t    js_isarrayindex: fn(State, *const c_char, *mut c_int) -> c_int;\n391\t    js_toboolean: fn(State, c_int) -> c_int;\n392\t    js_tonumber: fn(State, c_int) -> c_double;\n393\t    js_tostring: fn(State, c_int) -> *const c_char;\n394\t    js_touserdata: fn(State, c_int, *const c_char) -> *mut c_void;\n395\t    js_tointeger: fn(State, c_int) -> c_int;\n396\t    js_toint32: fn(State, c_int) -> c_int;\n397\t    js_touint32: fn(State, c_int) -> c_uint;\n398\t    js_toint16: fn(State, c_int) -> c_short;\n399\t    js_touint16: fn(State, c_int) -> c_ushort;\n400\t    js_tovalue: fn(State, c_int) -> *mut JsValue;\n401\t    js_toobject: fn(State, c_int) -> *mut c_void;\n402\t    js_toprimitive: fn(State, c_int, c_int);\n403\t    js_toregexp: fn(State, c_int) -> *mut c_void;\n404\t    js_typeof: fn(State, c_int) -> *const c_char;\n405\t    js_type: fn(State, c_int) -> c_int;\n406\t    js_utflen: fn(*const c_char) -> c_int;\n407\t    js_utfptrtoidx: fn(*const c_char, *const c_char) -> c_int;\n408\t    js_runeat: fn(State, *const c_char, c_int) -> c_int;\n409\t\n410\t    /* --- jsrepr.c --- */\n411\t    js_repr: fn(State, c_int);\n412\t    js_torepr: fn(State, c_int) -> *const c_char;\n413\t    js_tryrepr: fn(State, c_int, *const c_char) -> *const c_char;\n414\t\n415\t    /* --- jsbuiltin.c / init entry points --- */\n416\t    jsB_init: fn(State);\n417\t    jsB_initobject: fn(State);\n418\t    jsB_initarray: fn(State);\n419\t    jsB_initboolean: fn(State);\n420\t    jsB_initdate: fn(State);\n421\t    jsB_initerror: fn(State);\n422\t    jsB_initfunction: fn(State);\n423\t    jsB_initjson: fn(State);\n424\t    jsB_initmath: fn(State);\n425\t    jsB_initnumber: fn(State);\n426\t    jsB_initregexp: fn(State);\n427\t    jsB_initstring: fn(State);\n428\t    jsB_propf: fn(State, *const c_char, CFunction, c_int);\n429\t    jsB_propn: fn(State, *const c_char, c_double);\n430\t    jsB_props: fn(State, *const c_char, *const c_char);\n431\t    js_RegExp_prototype_exec: fn(State, *mut c_void, *const c_char);\n432\t}\n433\t\n434\t/* ------------------------------------------------------------------ */\n435\t/*  Library discovery                                                  */\n436\t/* ------------------------------------------------------------------ */\n437\t\n438\tfn crate_root() -> PathBuf {\n439\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n440\t}\n441\t\n442\t/// Directory holding the freshly built Rust cdylib (target/<profile>).\n443\t///\n444\t/// `cargo test --test X` does not itself emit the cdylib, so the test suite\n445\t/// must be run after `cargo build` (see `run_tests.sh`). We look in the\n446\t/// profile directory that matches this test binary first.\n447\tfn rust_so_path() -> PathBuf {\n448\t    // current_exe = target/<profile>/deps/<testname>-<hash>\n449\t    let exe = std::env::current_exe().expect(\"current_exe\");\n450\t    let mut dir = exe.parent().unwrap().to_path_buf(); // deps\n451\t    if dir.file_name().map(|n| n == \"deps\").unwrap_or(false) {\n452\t        dir.pop();\n453\t    }\n454\t    let p = dir.join(\"libmujs.so\");\n455\t    if p.exists() {\n456\t        return p;\n457\t    }\n458\t    panic!(\n459\t        \"Rust cdylib not found at {:?}.\\n\\\n460\t         `cargo test --test ...` does not build a cdylib-only lib target; run\\n\\\n461\t         `cargo build` (same profile) first, or use ./run_tests.sh\",\n462\t        p\n463\t    );\n464\t}\n465\t\n466\tfn c_so_path() -> PathBuf {\n467\t    let p = crate_root().join(\"c_src/build/libmujs.so\");\n468\t    assert!(\n469\t        p.exists(),\n470\t        \"C shared library not found at {:?}; build it with:\\n  cd c_src && mkdir -p build && cd build && cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\",\n471\t        p\n472\t    );\n473\t    p\n474\t}\n475\t\n476\tthread_local! {\n477\t    static LIBS: (Api, Api) = (\n478\t        Api::open(c_so_path().to_str().unwrap()),\n479\t        Api::open(rust_so_path().to_str().unwrap()),\n480\t    );\n481\t}\n482\t\n483\t/// Run `f` once for the C library and once for the Rust library.\n484\t/// Returns `(c_result, rust_result)`.\n485\tpub fn both<T>(mut f: impl FnMut(&Api, Side) -> T) -> (T, T) {\n486\t    LIBS.with(|(c, r)| (f(c, Side::C), f(r, Side::Rust)))\n487\t}\n488\t\n489\t#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n490\tpub enum Side {\n491\t    C,\n492\t    Rust,\n493\t}\n494\timpl Side {\n495\t    pub fn name(self) -> &'static str {\n496\t        match self {\n497\t            Side::C => \"C\",\n498\t            Side::Rust => \"Rust\",\n499\t        }\n500\t    }\n501\t}\n502\t\n503\t/// Assert the two results are equal, with a descriptive message.\n504\t#[track_caller]\n505\tpub fn same<T: PartialEq + std::fmt::Debug>(what: &str, (c, r): (T, T)) {\n506\t    assert_eq!(c, r, \"DIVERGENCE in {}: C={:?} Rust={:?}\", what, c, r);\n507\t}\n508\t\n509\t/* ------------------------------------------------------------------ */\n510\t/*  Helpers                                                           */\n511\t/* ------------------------------------------------------------------ */\n512\t\n513\tpub fn cs(s: &str) -> CString {\n514\t    CString::new(s).unwrap()\n515\t}\n516\t\n517\t/// Read a NUL-terminated C string as a lossless byte vector (may be non-UTF8).\n518\tpub unsafe fn cstr_bytes(p: *const c_char) -> Option<Vec<u8>> {\n519\t    if p.is_null() {\n520\t        None\n521\t    } else {\n522\t        Some(CStr::from_ptr(p).to_bytes().to_vec())\n523\t    }\n524\t}\n525\t\n526\tpub unsafe fn cstr_string(p: *const c_char) -> Option<String> {\n527\t    cstr_bytes(p).map(|b| String::from_utf8_lossy(&b).into_owned())\n528\t}\n529\t\n530\t/* ---------- report / print capture ---------- */\n531\t\n532\tthread_local! {\n533\t    static OUT: RefCell<Vec<u8>> = RefCell::new(Vec::new());\n534\t    /// js_tostring of the library currently executing, for the print callback.\n535\t    static TOSTRING: RefCell<Option<unsafe extern \"C-unwind\" fn(State, c_int) -> *const c_char>> =\n536\t        RefCell::new(None);\n537\t    static TRYSTRING: RefCell<Option<unsafe extern \"C-unwind\" fn(State, c_int, *const c_char) -> *const c_char>> =\n538\t        RefCell::new(None);\n539\t    static GETTOP: RefCell<Option<unsafe extern \"C-unwind\" fn(State) -> c_int>> = RefCell::new(None);\n540\t    static PUSHUNDEF: RefCell<Option<unsafe extern \"C-unwind\" fn(State)>> = RefCell::new(None);\n541\t}\n542\t\n543\tfn out_push(bytes: &[u8]) {\n544\t    OUT.with(|o| o.borrow_mut().extend_from_slice(bytes));\n545\t}\n546\tpub fn out_take() -> Vec<u8> {\n547\t    OUT.with(|o| std::mem::take(&mut *o.borrow_mut()))\n548\t}\n549\tpub fn out_clear() {\n550\t    OUT.with(|o| o.borrow_mut().clear());\n551\t}\n552\t\n553\tpub unsafe extern \"C-unwind\" fn report_cb(_J: State, msg: *const c_char) {\n554\t    out_push(b\"[report] \");\n555\t    if !msg.is_null() {\n556\t        out_push(CStr::from_ptr(msg).to_bytes());\n557\t    } else {\n558\t        out_push(b\"(null)\");\n559\t    }\n560\t    out_push(b\"\\n\");\n561\t}\n562\t\n563\tpub unsafe extern \"C-unwind\" fn panic_cb(_J: State) {\n564\t    out_push(b\"[panic]\\n\");\n565\t}\n566\t\n567\t/// A `print`-style cfunction: joins all arguments with a space using the\n568\t/// *protected* `js_trystring` (so it can never throw out of the callback).\n569\tpub unsafe extern \"C-unwind\" fn print_cb(J: State) {\n570\t    let gettop = GETTOP.with(|g| *g.borrow()).unwrap();\n571\t    let trystring = TRYSTRING.with(|g| *g.borrow()).unwrap();\n572\t    let pushundef = PUSHUNDEF.with(|g| *g.borrow()).unwrap();\n573\t    let top = gettop(J);\n574\t    let err = b\"(unprintable)\\0\";\n575\t    let mut line: Vec<u8> = Vec::new();\n576\t    for i in 1..top {\n577\t        if i > 1 {\n578\t            line.push(b' ');\n579\t        }\n580\t        let p = trystring(J, i, err.as_ptr() as *const c_char);\n581\t        if !p.is_null() {\n582\t            line.extend_from_slice(CStr::from_ptr(p).to_bytes());\n583\t        }\n584\t    }\n585\t    line.push(b'\\n');\n586\t    out_push(&line);\n587\t    pushundef(J);\n588\t}\n589\t\n590\t/// Install the thread-local trampoline slots for `api` (needed by `print_cb`).\n591\tpub fn bind_callbacks(api: &Api) {\n592\t    TOSTRING.with(|s| *s.borrow_mut() = Some(api.js_tostring));\n593\t    TRYSTRING.with(|s| *s.borrow_mut() = Some(api.js_trystring));\n594\t    GETTOP.with(|s| *s.borrow_mut() = Some(api.js_gettop));\n595\t    PUSHUNDEF.with(|s| *s.borrow_mut() = Some(api.js_pushundefined));\n596\t}\n597\t\n598\t/// Create a state with a report callback and a global `print` function bound.\n599\tpub unsafe fn new_state(api: &Api, flags: c_int) -> State {\n600\t    bind_callbacks(api);\n601\t    let J = (api.js_newstate)(None, std::ptr::null_mut(), flags);\n602\t    assert!(!J.is_null(), \"js_newstate returned NULL in {}\", api.path);\n603\t    (api.js_setreport)(J, Some(report_cb));\n604\t    (api.js_atpanic)(J, Some(panic_cb));\n605\t    (api.js_newcfunction)(J, Some(print_cb), cs(\"print\").as_ptr(), 1);\n606\t    (api.js_setglobal)(J, cs(\"print\").as_ptr());\n607\t    J\n608\t}\n609\t\n610\t/// Run one script through `js_dostring` and return\n611\t/// `(return code, captured output bytes)`.\n612\tpub fn run_script(api: &Api, flags: c_int, src: &str) -> (c_int, Vec<u8>) {\n613\t    unsafe {\n614\t        out_clear();\n615\t        let J = new_state(api, flags);\n616\t        let rc = (api.js_dostring)(J, cs(src).as_ptr());\n617\t        (api.js_freestate)(J);\n618\t        (rc, out_take())\n619\t    }\n620\t}\n621\t\n622\t/// Differential helper: run the same script in both libraries and assert the\n623\t/// return code and all captured output are byte-identical.\n624\t#[track_caller]\n625\tpub fn diff_script(flags: c_int, src: &str) {\n626\t    let (c, r) = both(|api, _| run_script(api, flags, src));\n627\t    if c != r {\n628\t        panic!(\n629\t            \"DIVERGENCE for script (flags={}):\\n---8<--- {}\\n--->8---\\n C  rc={} out={:?}\\n Rust rc={} out={:?}\",\n630\t            flags,\n631\t            src,\n632\t            c.0,\n633\t            String::from_utf8_lossy(&c.1),\n634\t            r.0,\n635\t            String::from_utf8_lossy(&r.1)\n636\t        );\n637\t    }\n638\t}\n639\t\n640\t/// Same, but for a whole list of scripts; reports every divergence at once.\n641\t#[track_caller]\n642\tpub fn diff_scripts(flags: c_int, scripts: &[&str]) {\n643\t    let mut fails = Vec::new();\n644\t    for (i, s) in scripts.iter().enumerate() {\n645\t        let (c, r) = both(|api, _| run_script(api, flags, s));\n646\t        if c != r {\n647\t            fails.push(format!(\n648\t                \"  [{}] {:?}\\n      C   : rc={} out={:?}\\n      Rust: rc={} out={:?}\",\n649\t                i,\n650\t                s,\n651\t                c.0,\n652\t                String::from_utf8_lossy(&c.1),\n653\t                r.0,\n654\t                String::from_utf8_lossy(&r.1)\n655\t            ));\n656\t        }\n657\t    }\n658\t    if !fails.is_empty() {\n659\t        panic!(\n660\t            \"{} of {} scripts diverged (flags={}):\\n{}\",\n661\t            fails.len(),\n662\t            scripts.len(),\n663\t            flags,\n664\t            fails.join(\"\\n\")\n665\t        );\n666\t    }\n667\t}\n668\t\n669\t/// Run a script under both non-strict and strict states.\n670\t#[track_caller]\n671\tpub fn diff_scripts_both_modes(scripts: &[&str]) {\n672\t    diff_scripts(0, scripts);\n673\t    diff_scripts(JS_STRICT, scripts);\n674\t}\n675\t\n676\t/* ---------- deterministic RNG (xorshift64*) for property tests ---------- */\n677\t\n678\tpub struct Rng(pub u64);\n679\timpl Rng {\n680\t    pub fn new(seed: u64) -> Rng {\n681\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n682\t    }\n683\t    pub fn next_u64(&mut self) -> u64 {\n684\t        let mut x = self.0;\n685\t        x ^= x >> 12;\n686\t        x ^= x << 25;\n687\t        x ^= x >> 27;\n688\t        self.0 = x;\n689\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n690\t    }\n691\t    pub fn next_u32(&mut self) -> u32 {\n692\t        (self.next_u64() >> 32) as u32\n693\t    }\n694\t    pub fn below(&mut self, n: u32) -> u32 {\n695\t        if n == 0 {\n696\t            0\n697\t        } else {\n698\t            self.next_u32() % n\n699\t        }\n700\t    }\n701\t    pub fn range(&mut self, lo: i64, hi: i64) -> i64 {\n702\t        if hi <= lo {\n703\t            lo\n704\t        } else {\n705\t            lo + (self.next_u64() % ((hi - lo) as u64)) as i64\n706\t        }\n707\t    }\n708\t    pub fn f64_bits(&mut self) -> f64 {\n709\t        f64::from_bits(self.next_u64())\n710\t    }\n711\t    /// A \"interesting\" finite-ish double.\n712\t    pub fn nice_f64(&mut self) -> f64 {\n713\t        match self.below(10) {\n714\t            0 => 0.0,\n715\t            1 => -0.0,\n716\t            2 => f64::NAN,\n717\t            3 => f64::INFINITY,\n718\t            4 => f64::NEG_INFINITY,\n719\t            5 => self.range(-1000, 1000) as f64,\n720\t            6 => self.range(i32::MIN as i64, i32::MAX as i64) as f64,\n721\t            7 => self.f64_bits(),\n722\t            8 => (self.next_u32() as f64) / 4096.0,\n723\t            _ => (self.range(-1_000_000, 1_000_000) as f64) / 1000.0,\n724\t        }\n725\t    }\n726\t    pub fn pick<'a, T>(&mut self, xs: &'a [T]) -> &'a T {\n727\t        &xs[self.below(xs.len() as u32) as usize]\n728\t    }\n729\t}\n730\t\n731\t/// Format a double so that all bits are visible in diagnostics.\n732\tpub fn dbg_f64(x: f64) -> String {\n733\t    format!(\"{:?}/{:#018x}\", x, x.to_bits())\n734\t}\n735\t"}]},"parent_tool_use_id":"toolu_bdrk_01NJxrfUwvUycV6oomBiYuBt","session_id":"f3ff8386-8592-4dbd-8b83-c0778c2e2173","uuid":"8521d726-64b8-43f0-87a2-3e98f46b6a1d","timestamp":"2026-08-14T19:37:21.763Z","subagent_type":"general-purpose","task_description":"Write dtoa/number differential tests"}
