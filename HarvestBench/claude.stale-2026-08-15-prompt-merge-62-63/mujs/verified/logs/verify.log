{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VnMdLs6xW9sLiANKjFUhTq","type":"tool_result","content":"1\t/* Locale-independent implementations of string <-> double conversions. */\n2\t\n3\t#include \"jsi.h\"\n4\t\n5\t#if defined(_MSC_VER) && (_MSC_VER < 1700) /* VS2012 has stdint.h */\n6\ttypedef unsigned int uint32_t;\n7\ttypedef unsigned __int64 uint64_t;\n8\t#else\n9\t#include <stdint.h>\n10\t#endif\n11\t\n12\t#include <errno.h>\n13\t#include <assert.h>\n14\t\n15\t#ifndef TRUE\n16\t#define TRUE 1\n17\t#define FALSE 0\n18\t#endif\n19\t\n20\t/*\n21\t * format exponent like sprintf(p, \"e%+d\", e)\n22\t */\n23\tvoid\n24\tjs_fmtexp(char *p, int e)\n25\t{\n26\t\tchar se[9];\n27\t\tint i;\n28\t\n29\t\t*p++ = 'e';\n30\t\tif(e < 0) {\n31\t\t\t*p++ = '-';\n32\t\t\te = -e;\n33\t\t} else\n34\t\t\t*p++ = '+';\n35\t\ti = 0;\n36\t\twhile(e) {\n37\t\t\tse[i++] = e % 10 + '0';\n38\t\t\te /= 10;\n39\t\t}\n40\t\twhile(i < 1)\n41\t\t\tse[i++] = '0';\n42\t\twhile(i > 0)\n43\t\t\t*p++ = se[--i];\n44\t\t*p++ = '\\0';\n45\t}\n46\t\n47\t/*\n48\t * grisu2_59_56.c\n49\t *\n50\t * Grisu prints the optimal decimal representation of floating-point numbers.\n51\t *\n52\t * Copyright (c) 2009 Florian Loitsch\n53\t *\n54\t * Permission is hereby granted, free of charge, to any person obtaining a copy\n55\t * of this software and associated documentation files (the \"Software\"), to\n56\t * deal in the Software without restriction, including without limitation the\n57\t * rights to use, copy, modify, merge, publish, distribute, sublicense, and/or\n58\t * sell copies of the Software, and to permit persons to whom the Software is\n59\t * furnished to do so, subject to the following conditions:\n60\t *\n61\t * The above copyright notice and this permission notice shall be included in\n62\t * all copies or substantial portions of the Software.\n63\t *\n64\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n65\t * IMPLIED, INCLUDING BUT 