;\n        (api.js_setglobal)(J, cs(\"UDX\").as_ptr());\n        eprintln!(\"11 dostring\");\n        let rc = (api.js_dostring)(J, cs(\"print(typeof UD, typeof UDX);\").as_ptr());\n        eprintln!(\"12 rc={}\", rc);\n        let rc2 = (api.js_dostring)(J, cs(\"print(UDX.anything);\").as_ptr());\n        eprintln!(\"13 rc={}\", rc2);\n        let rc3 = (api.js_dostring)(J, cs(\"UDX.other = 5;\").as_ptr());\n        eprintln!(\"14 rc={}\", rc3);\n        let rc4 = (api.js_dostring)(J, cs(\"print(delete UDX.gone);\").as_ptr());\n        eprintln!(\"15 rc={}\", rc4);\n        let rc5 = (api.js_dostring)(J, cs(\"print('own' in UDX);\").as_ptr());\n        eprintln!(\"16 rc={}\", rc5);\n        (api.js_dostring)(J, cs(\"UD=null; UDX=null;\").as_ptr());\n        eprintln!(\"17 gc\");\n        (api.js_gc)(J, 0);\n        eprintln!(\"18 gc\");\n        (api.js_gc)(J, 0);\n        eprintln!(\"19 freestate\");\n        (api.js_freestate)(J);\n        eprintln!(\"20 done\");\n    });\n}\nEOF\ntimeout 300 cargo test --test zz_dbg2 -- --nocapture 2>&1 | grep -E \"^==|^  |^[0-9]+ |Assertion|abort|SIGABRT|error\" | head -60","description":"Debug userdata abort step by step"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":299,"cache_read_input_tokens":399199,"cache_creation":{"ephemeral_5m_input_tokens":299,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3ff8386-8592-4dbd-8b83-c0778c2e2173","uuid":"2c1d91ec-b9d3-4c05-9add-4929268e96fc","timestamp":"2026-08-14T20:17:34.099Z"}
