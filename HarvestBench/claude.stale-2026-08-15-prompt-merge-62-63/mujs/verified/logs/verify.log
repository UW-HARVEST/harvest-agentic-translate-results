{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Pis1zec2Zb19MD3k8YQGEj","type":"tool_result","content":"1\t//! Small C-library-style helpers used throughout the port.\n2\t#![allow(dead_code)]\n3\t\n4\tuse std::os::raw::{c_char, c_int};\n5\t\n6\t#[inline]\n7\tpub unsafe fn strlen(s: *const c_char) -> usize {\n8\t    libc::strlen(s)\n9\t}\n10\t\n11\t#[inline]\n12\tpub unsafe fn strcmp(a: *const c_char, b: *const c_char) -> c_int {\n13\t    libc::strcmp(a, b)\n14\t}\n15\t\n16\t#[inline]\n17\tpub unsafe fn strncmp(a: *const c_char, b: *const c_char, n: usize) -> c_int {\n18\t    libc::strncmp(a, b, n)\n19\t}\n20\t\n21\t#[inline]\n22\tpub unsafe fn strcpy(dst: *mut c_char, src: *const c_char) -> *mut c_char {\n23\t    libc::strcpy(dst, src)\n24\t}\n25\t\n26\t#[inline]\n27\tpub unsafe fn strcat(dst: *mut c_char, src: *const c_char) -> *mut c_char {\n28\t    libc::strcat(dst, src)\n29\t}\n30\t\n31\t#[inline]\n32\tpub unsafe fn strchr(s: *const c_char, c: c_int) -> *mut c_char {\n33\t    libc::strchr(s, c)\n34\t}\n35\t\n36\t#[inline]\n37\tpub unsafe fn strrchr(s: *const c_char, c: c_int) -> *mut c_char {\n38\t    libc::strrchr(s, c)\n39\t}\n40\t\n41\t#[inline]\n42\tpub unsafe fn strstr(h: *const c_char, n: *const c_char) -> *mut c_char {\n43\t    libc::strstr(h, n)\n44\t}\n45\t\n46\t#[inline]\n47\tpub unsafe fn memcpy(dst: *mut c_char, src: *const c_char, n: usize) {\n48\t    if n > 0 {\n49\t        libc::memcpy(dst as *mut _, src as *const _, n);\n50\t    }\n51\t}\n52\t\n53\t#[inline]\n54\tpub unsafe fn memset(dst: *mut c_char, c: c_int, n: usize) {\n55\t    libc::memset(dst as *mut _, c, n);\n56\t}\n57\t\n58\t/* Math functions (libc on linux-gnu doesn't export these; f64 methods call the\n59\t * same system libm, giving identical results). */\n60\t#[inline] pub fn floor(x: f64) -> f64 { x.floor() }\n61\t#[inline] pub fn ceil(x: f64) -> f64 { x.ceil() }\n62\t#[inline] pub fn fabs(x: f64) -> f64 { x.abs() }\n63\t#[inline] pub fn fmod(x: f64, 