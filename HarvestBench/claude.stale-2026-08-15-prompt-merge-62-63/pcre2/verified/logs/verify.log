re2_set_optimize(pcre2_compile_context *ccontext, uint32_t directive)\n413\t{\n414\tif (ccontext == NULL)\n415\t  return PCRE2_ERROR_NULL;\n416\t\n417\tswitch (directive)\n418\t  {\n419\t  case PCRE2_OPTIMIZATION_NONE:\n420\t  ccontext->optimization_flags = 0;\n421\t  break;\n422\t\n423\t  case PCRE2_OPTIMIZATION_FULL:\n424\t  ccontext->optimization_flags = PCRE2_OPTIMIZATION_ALL;\n425\t  break;\n426\t\n427\t  default:\n428\t  if (directive >= PCRE2_AUTO_POSSESS && directive <= PCRE2_START_OPTIMIZE_OFF)\n429\t    {\n430\t    /* Even directive numbers starting from 64 switch a bit on;\n431\t     * Odd directive numbers starting from 65 switch a bit off */\n432\t    if ((directive & 1) != 0)\n433\t      ccontext->optimization_flags &= ~(1u << ((directive >> 1) - 32));\n434\t    else\n435\t      ccontext->optimization_flags |= 1u << ((directive >> 1) - 32);\n436\t    return 0;\n437\t    }\n438\t  return PCRE2_ERROR_BADOPTION;\n439\t  }\n440\t\n441\treturn 0;\n442\t}\n443\t\n444\t/* ------------ Match context ------------ */\n445\t\n446\tPCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\n447\tpcre2_set_callout(pcre2_match_context *mcontext,\n448\t  int (*callout)(pcre2_callout_block *, void *), void *callout_data)\n449\t{\n450\tmcontext->callout = callout;\n451\tmcontext->callout_data = callout_data;\n452\treturn 0;\n453\t}\n454\t\n455\tPCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\n456\tpcre2_set_substitute_callout(pcre2_match_context *mcontext,\n457\t  int (*substitute_callout)(pcre2_substitute_callout_block *, void *),\n458\t  void *substitute_callout_data)\n459\t{\n460\tmcontext->substitute_callout = substitute_callout;\n461\tmcontext->substitute_callout_data = substitute_callout_data;\n462\treturn 0;\n463\t}\n464\t\n465\tPCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\n466\tpcre2_set_substitute_case_callout(pcre2_match_context *mcontext,\n467\t  PCRE2_SIZE (*substitute_case_callout)(PCRE2_SPTR, PCRE2_SIZE, PCRE2_UCHAR *,\n468\t                                        PCRE2_SIZE, int, vo