         /* If group is still negative, it means we did not find a group\n1394\t            that is in the ovector. Just set the first group. */\n1395\t\n1396\t            if (group < 0) group = GET2(first, 0);\n1397\t            }\n1398\t          }\n1399\t\n1400\t        /* We now have a group that is identified by number. Find the length of\n1401\t        the captured string. If a group in a non-special substitution is unset\n1402\t        when PCRE2_SUBSTITUTE_UNSET_EMPTY is set, substitute nothing. */\n1403\t\n1404\t        rc = pcre2_substring_length_bynumber(match_data, group, &sublength);\n1405\t        if (rc < 0)\n1406\t          {\n1407\t          if (rc == PCRE2_ERROR_NOSUBSTRING &&\n1408\t              (suboptions & PCRE2_SUBSTITUTE_UNKNOWN_UNSET) != 0)\n1409\t            {\n1410\t            rc = PCRE2_ERROR_UNSET;\n1411\t            }\n1412\t          if (rc != PCRE2_ERROR_UNSET) goto PTREXIT;  /* Non-unset errors */\n1413\t          if (special == 0)                           /* Plain substitution */\n1414\t            {\n1415\t            if ((suboptions & PCRE2_SUBSTITUTE_UNSET_EMPTY) != 0) continue;\n1416\t            goto PTREXIT;                             /* Else error */\n1417\t            }\n1418\t          }\n1419\t\n1420\t        /* If special is '+' we have a 'set' and possibly an 'unset' text,\n1421\t        both of which are reprocessed when used. If special is '-' we have a\n1422\t        default text for when the group is unset; it must be reprocessed. */\n1423\t\n1424\t        if (special != 0)\n1425\t          {\n1426\t          if (special == CHAR_MINUS)\n1427\t            {\n1428\t            if (rc == 0) goto LITERAL_SUBSTITUTE;\n1429\t            text2_start = text1_start;\n1430\t            text2_end = text1_end;\n1431\t            }\n1432\t\n1433\t          if (ptrstackptr >= PTR_STACK_SIZE) goto BAD;\n1434\t          ptrstack[ptrstackptr++] = ptr;\n1435\t          ptrstack[ptrstackptr++] = repend;\n1436\t\n1437\t          if 