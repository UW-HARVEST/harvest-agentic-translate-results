sed_memory: FnJitFreeUnused = \"pcre2_jit_free_unused_memory_8\";\n    jit_stack_create: FnJitStackCreate = \"pcre2_jit_stack_create_8\";\n    jit_stack_assign: FnJitStackAssign = \"pcre2_jit_stack_assign_8\";\n    jit_stack_free: FnJitStackFree = \"pcre2_jit_stack_free_8\";\n    jit_get_size: FnJitGetSize = \"_pcre2_jit_get_size_8\";\n    jit_get_target: FnJitGetTarget = \"_pcre2_jit_get_target_8\";\n    jit_free: FnJitFree = \"_pcre2_jit_free_8\";\n    jit_free_rodata: FnJitFreeRodata = \"_pcre2_jit_free_rodata_8\";\n\n    get_error_message: FnGetErrorMessage = \"pcre2_get_error_message_8\";\n    maketables: FnMaketables = \"pcre2_maketables_8\";\n    maketables_free: FnMaketablesFree = \"pcre2_maketables_free_8\";\n\n    valid_utf: FnValidUtf = \"_pcre2_valid_utf_8\";\n    ord2utf: FnOrd2Utf = \"_pcre2_ord2utf_8\";\n    strcmp: FnStrcmp = \"_pcre2_strcmp_8\";\n    strcmp_c8: FnStrcmpC8 = \"_pcre2_strcmp_c8_8\";\n    strncmp: FnStrncmp = \"_pcre2_strncmp_8\";\n    strncmp_c8: FnStrncmpC8 = \"_pcre2_strncmp_c8_8\";\n    strcpy_c8: FnStrcpyC8 = \"_pcre2_strcpy_c8_8\";\n    strlen: FnStrlen = \"_pcre2_strlen_8\";\n    ckd_smul: FnCkdSmul = \"_pcre2_ckd_smul_8\";\n    is_newline: FnIsNewline = \"_pcre2_is_newline_8\";\n    was_newline: FnWasNewline = \"_pcre2_was_newline_8\";\n    extuni: FnExtuni = \"_pcre2_extuni_8\";\n    script_run: FnScriptRun = \"_pcre2_script_run_8\";\n    find_bracket: FnFindBracket = \"_pcre2_find_bracket_8\";\n    xclass: FnXclass = \"_pcre2_xclass_8\";\n    eclass: FnEclass = \"_pcre2_eclass_8\";\n    update_classbits: FnUpdateClassbits = \"_pcre2_update_classbits_8\";\n    memctl_malloc: FnMemctlMalloc = \"_pcre2_memctl_malloc_8\";\n    get_hash_from_name: FnGetHashFromName = \"_pcre2_compile_get_hash_from_name8\";\n}\n\nimpl Api {\n    /// Raw dlsym for symbols not in the typed table (data objects etc.).\n    pub unsafe fn raw(&self, name: &str) -> *const u8 {\n        let mut n = name.as_bytes().to_vec();\n        n.push(0);\n        let s: Symbol<*const u8> = self\n            ._lib\n            .get(&n)\n            .unwrap_or_else(|e| panic!(\"missing symbol {name}: {e}\"));\n        // Symbol<*const u8> derefs to the value; we want the address instead.\n        s.into_raw().into_raw() as *const u8\n    }\n    pub unsafe fn try_raw(&self, name: &str) -> Option<*const u8> {\n        let mut n = name.as_bytes().to_vec();\n        n.push(0);\n        let s: Result<Symbol<*const u8>, _> = self._lib.get(&n);\n        s.ok().map(|s| s.into_raw().into_raw() as *const u8)\n    }\n}\n\npub fn crate_root() -> PathBuf {\n    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n}\npub fn c_so() -> PathBuf {\n    let p = crate_root().join(\"c_src/build/libpcre2.so\");\n    assert!(p.exists(), \"build the C library first: {p:?}\");\n    p\n}\npub fn rust_so() -> PathBuf {\n    let p = crate_root().join(\"target/release/libpcre2.so\");\n    assert!(\n        p.exists(),\n        \"run `cargo build --release` first (tests load the release cdylib): {p:?}\"\n    );\n    p\n}\n\n/// The two libraries under comparison.\npub struct Pair {\n    pub c: Api,\n    pub r: Api,\n}\n\npub fn pair() -> &'static Pair {\n    use std::sync::OnceLock;\n    static P: OnceLock<Pair> = OnceLock::new();\n    P.get_or_init(|| unsafe {\n        Pair {\n            c: Api::load(&c_so()),\n            r: Api::load(&rust_so()),\n        }\n    })\n}\n\n// ------------------------------------------------------------------ utilities\n\n/// Deterministic xorshift PRNG so every test run is reproducible.\npub struct Rng(pub u64);\nimpl Rng {\n    pub fn new(seed: u64) -> Rng {\n        Rng(seed | 1)\n    }\n    pub fn next_u64(&mut self) -> u64 {\n        let mut x = self.0;\n        x ^= x << 13;\n        x ^= x >> 7;\n        x ^= x << 17;\n        self.0 = x;\n        x\n    }\n    pub fn below(&mut self, n: usize) -> usize {\n        if n == 0 {\n            0\n        } else {\n            (self.next_u64() % n as u64) as usize\n        }\n    }\n    pub fn pick<'a, T>(&mut self, v: &'a [T]) -> &'a T {\n        &v[self.below(v.len())]\n    }\n    pub fn byte(&mut self) -> u8 {\n        (self.next_u64() >> 11) as u8\n    }\n    pub fn bool_(&mut self) -> bool {\n        self.next_u64() & 1 == 1\n    }\n}\n\npub fn cstr(s: &str) -> Vec<u8> {\n    let mut v = s.as_bytes().to_vec();\n    v.push(0);\n    v\n}\n\n/// A compiled pattern in one library plus its match data, for lock-step use.\npub struct Compiled<'a> {\n    pub api: &'a Api,\n    pub code: Ptr,\n}\nimpl<'a> Compiled<'a> {\n    pub unsafe fn new(\n        api: &'a Api,\n        pat: &[u8],\n        opts: u32,\n        ctx: Ptr,\n    ) -> Result<Compiled<'a>, (c_int, Sz)> {\n        let mut ec: c_int = 0;\n        let mut eo: Sz = 0;\n        let code = (api.compile)(pat.as_ptr(), pat.len(), opts, &mut ec, &mut eo, ctx);\n        if code.is_null() {\n            Err((ec, eo))\n        } else {\n            Ok(Compiled { api, code })\n        }\n    }\n}\nimpl<'a> Drop for Compiled<'a> {\n    fn drop(&mut self) {\n        unsafe { (self.api.code_free)(self.code) }\n    }\n}\n\npub const OVEC_INFO: u32 = consts::PCRE2_INFO_CAPTURECOUNT;\n\n/// Render bytes for assertion messages.\npub fn show(b: &[u8]) -> String {\n    let mut s = String::new();\n    for &c in b {\n        if c.is_ascii_graphic() || c == b' ' {\n            s.push(c as char)\n        } else {\n            s.push_str(&format!(\"\\\\x{c:02x}\"))\n        }\n    }\n    s\n}\n\npub type Uchar = c_uchar;\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1357,"cache_read_input_tokens":92988,"cache_creation":{"ephemeral_5m_input_tokens":1357,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"aeab5d90-512d-4436-80fd-a67670a151c9","uuid":"fd362a62-ff34-4424-8c2c-d7f0c6b420f2","timestamp":"2026-08-14T21:26:27.212Z"}
