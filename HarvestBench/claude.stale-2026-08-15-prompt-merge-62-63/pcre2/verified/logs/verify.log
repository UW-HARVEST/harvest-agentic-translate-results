t mut p: *mut u8 = std::ptr::null_mut();\n        let mut glen: Sz = 0;\n        let grc = (api.substring_get_bynumber)(md, i, &mut p, &mut glen);\n        log(format!(\n            \"substr[{i}] lenrc={lrc} len={} copyrc={crc} copy={} getrc={grc} get={}\",\n            fmt_sz(len),\n            if crc >= 0 { show(&buf[..blen]) } else { \"-\".into() },\n            if grc >= 0 {\n                show(std::slice::from_raw_parts(p, glen))\n            } else {\n                \"-\".into()\n            }\n        ));\n        if grc >= 0 {\n            (api.substring_free)(p);\n        }\n    }\n    // whole list\n    let mut list: *mut *mut u8 = std::ptr::null_mut();\n    let mut lens: *mut Sz = std::ptr::null_mut();\n    let lrc = (api.substring_list_get)(md, &mut list, &mut lens);\n    log(format!(\"substring_list rc={lrc}\"));\n    if lrc == 0 {\n        let mut i = 0;\n        while !(*list.add(i)).is_null() {\n            log(format!(\n                \"  list[{i}]={} len={}\",\n                show(std::slice::from_raw_parts(*list.add(i), *lens.add(i))),\n                fmt_sz(*lens.add(i))\n            ));\n            i += 1;\n        }\n        (api.substring_list_free)(list);\n    }\n    // named groups\n    let mut count: u32 = 0;\n    let mut esize: u32 = 0;\n    (api.pattern_info)(\n        code,\n        PCRE2_INFO_NAMECOUNT,\n        &mut count as *mut u32 as *mut c_void,\n    );\n    (api.pattern_info)(\n        code,\n        PCRE2_INFO_NAMEENTRYSIZE,\n        &mut esize as *mut u32 as *mut c_void,\n    );\n    let mut tab: *const u8 = std::ptr::null();\n    (api.pattern_info)(\n        code,\n        PCRE2_INFO_NAMETABLE,\n        &mut tab as *mut *const u8 as *mut c_void,\n    );\n    for k in 0..count as usize {\n        let entry = tab.add(k * esize as usize);\n        let name = entry.add(2);\n        let mut len: Sz = 0;\n        let lrc = (api.substring_length_byname)(md, name, &mut len);\n        let mut p: *mut u8 = std::ptr::null_mut();\n        let mut glen: Sz = 0;\n        let grc = (api.substring_get_byname)(md, name, &mut p, &mut glen);\n        let num = (api.substring_number_from_name)(code, name);\n        let mut f: *const u8 = std::ptr::null();\n        let mut l: *const u8 = std::ptr::null();\n        let src = (api.substring_nametable_scan)(code, name, &mut f, &mut l);\n        log(format!(\n            \"named[{k}] lenrc={lrc} len={} getrc={grc} get={} num={num} scanrc={src} entries={}\",\n            fmt_sz(len),\n            if grc >= 0 {\n                show(std::slice::from_raw_parts(p, glen))\n            } else {\n                \"-\".into()\n            },\n            if src >= 0 && !f.is_null() {\n                ((l as usize - f as usize) / esize as usize + 1).to_string()\n            } else {\n                \"-\".into()\n            }\n        ));\n        if grc >= 0 {\n            (api.substring_free)(p);\n        }\n    }\n}\n\npub fn hex(b: &[u8]) -> String {\n    let mut s = String::with_capacity(b.len() * 2);\n    for &c in b {\n        s.push_str(&format!(\"{c:02x}\"));\n    }\n    s\n}\n\n/// Run one scenario against both libraries and assert identical logs.\npub fn diff(s: &Scen) {\n    let p = pair();\n    let (c, r) = unsafe { (run(&p.c, s), run(&p.r, s)) };\n    if c != r {\n        let n = c.len().max(r.len());\n        for i in 0..n {\n            let a = c.get(i).map(|x| x.as_str()).unwrap_or(\"<missing>\");\n            let b = r.get(i).map(|x| x.as_str()).unwrap_or(\"<missing>\");\n            if a != b {\n                panic!(\n                    \"divergence at log line {i}\\n  scenario: pat={} opts={:#x} xopts={:#x}\\n  C   : {a}\\n  Rust: {b}\\n  (C log {} lines, Rust log {} lines)\",\n                    show(&s.pat),\n                    s.opts,\n                    s.xopts,\n                    c.len(),\n                    r.len()\n                );\n            }\n        }\n        panic!(\"logs differ in length only: C={} Rust={}\", c.len(),