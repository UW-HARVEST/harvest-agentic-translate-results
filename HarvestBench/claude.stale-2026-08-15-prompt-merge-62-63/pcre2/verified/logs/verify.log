if let Some(v) = s.heap_limit {\n        log(format!(\"set_heap_limit={}\", (api.set_heap_limit)(mcontext, v)));\n    }\n    if let Some(v) = s.offset_limit {\n        log(format!(\"set_offset_limit={}\", (api.set_offset_limit)(mcontext, v)));\n    }\n    if s.callout {\n        log(format!(\n            \"set_callout={}\",\n            (api.set_callout)(mcontext, Some(callout_fn), std::ptr::null_mut())\n        ));\n    }\n    if s.sub_callout {\n        log(format!(\n            \"set_substitute_callout={}\",\n            (api.set_substitute_callout)(mcontext, Some(sub_callout_fn), std::ptr::null_mut())\n        ));\n    }\n    if s.sub_case_callout {\n        log(format!(\n            \"set_substitute_case_callout={}\",\n            (api.set_substitute_case_callout)(\n                mcontext,\n                Some(case_callout_fn),\n                std::ptr::null_mut()\n            )\n        ));\n    }\n\n    // ------------------------------------------------------------------- match\n    let md = if s.ovec == 0 {\n        (api.match_data_create_from_pattern)(code, std::ptr::null_mut())\n    } else {\n        (api.match_data_create)(s.ovec, std::ptr::null_mut())\n    };\n    assert!(!md.is_null());\n    log(format!(\n        \"md ovector_count={} size={}\",\n        (api.get_ovector_count)(md),\n        fmt_sz((api.get_match_data_size)(md))\n    ));\n\n    for subj in &s.subjects {\n        let slen = if s.zero_terminated_subj {\n            PCRE2_ZERO_TERMINATED\n        } else {\n            subj.len()\n        };\n        for &mo in &s.match_opts {\n            for &so in &s.start_offsets {\n                let rc = (api.do_match)(code, subj.as_ptr(), slen, so, mo, md, mcontext);\n                log(format!(\n                    \"match subj={} mo={mo:#x} so={} rc={rc}\",\n                    show(subj),\n                    fmt_sz(so)\n                ));\n                report_match(api, md, rc, subj);\n                if s.next_match_loop && rc >= 0 {\n                    let mut off: Sz = 0;\n                    let mut gopts: u32 = 0;\n                    let mut n = 0;\n                    while (api.next_match)(md, &mut off, &mut gopts) != 0 && n < 12 {\n                        log(format!(\n                            \"next_match off={} gopts={gopts:#x}\",\n                            fmt_sz(off)\n                        ));\n                        let rc2 =\n                            (api.do_match)(code, subj.as_ptr(), slen, off, mo | gopts, md, mcontext);\n                        log(format!(\"  regmatch rc={rc2}\"));\n                        if rc2 < 0 {\n                            break;\n                        }\n                        report_match(api, md, rc2, subj);\n                        n += 1;\n                    }\n                }\n                if rc > 0 {\n                    substrings(api, code, md, rc);\n                }\n                if s.dfa {\n                    let mut ws = vec![0i32; s.dfa_ws];\n                    let rc = (api.dfa_match)(\n                        code,\n                        subj.as_ptr(),\n                        slen,\n                        so,\n                        mo,\n                        md,\n                        mcontext,\n                        ws.as_mut_ptr(),\n                        ws.len(),\n                    );\n                    log(format!(\"dfa subj={} mo={mo:#x} so={} rc={rc}\", show(subj), fmt_sz(so)));\n                    report_match(api, md, rc, subj);\n                }\n            }\n        }\n        for (repl, sopts, bufsz) in &s.substitutions {\n            let mut buf = vec![0xcdu8; *bufsz + 1];\n            let mut blen: Sz = *bufsz;\n            let rc = (api.substitute)(\n                code,\n                subj.as_ptr(),\n                slen,\n                0,\n                *sopts,\n                md,\n                mcontext,\n                repl.as_ptr(),\n                repl.len(),