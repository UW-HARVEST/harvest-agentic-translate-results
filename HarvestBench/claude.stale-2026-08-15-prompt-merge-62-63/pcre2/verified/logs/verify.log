\t/* Process the BSR setting. */\n10675\t\n10676\tif (bsr == 0) bsr = ccontext->bsr_convention;\n10677\t\n10678\t/* Process the newline setting. */\n10679\t\n10680\tif (newline == 0) newline = ccontext->newline_convention;\n10681\tcb.nltype = NLTYPE_FIXED;\n10682\tswitch(newline)\n10683\t  {\n10684\t  case PCRE2_NEWLINE_CR:\n10685\t  cb.nllen = 1;\n10686\t  cb.nl[0] = CHAR_CR;\n10687\t  break;\n10688\t\n10689\t  case PCRE2_NEWLINE_LF:\n10690\t  cb.nllen = 1;\n10691\t  cb.nl[0] = CHAR_NL;\n10692\t  break;\n10693\t\n10694\t  case PCRE2_NEWLINE_NUL:\n10695\t  cb.nllen = 1;\n10696\t  cb.nl[0] = CHAR_NUL;\n10697\t  break;\n10698\t\n10699\t  case PCRE2_NEWLINE_CRLF:\n10700\t  cb.nllen = 2;\n10701\t  cb.nl[0] = CHAR_CR;\n10702\t  cb.nl[1] = CHAR_NL;\n10703\t  break;\n10704\t\n10705\t  case PCRE2_NEWLINE_ANY:\n10706\t  cb.nltype = NLTYPE_ANY;\n10707\t  break;\n10708\t\n10709\t  case PCRE2_NEWLINE_ANYCRLF:\n10710\t  cb.nltype = NLTYPE_ANYCRLF;\n10711\t  break;\n10712\t\n10713\t  /* LCOV_EXCL_START */\n10714\t  default:\n10715\t  PCRE2_DEBUG_UNREACHABLE();\n10716\t  errorcode = ERR56;\n10717\t  goto HAD_EARLY_ERROR;\n10718\t  /* LCOV_EXCL_STOP */\n10719\t  }\n10720\t\n10721\t/* Pre-scan the pattern to do two things: (1) Discover the named groups and\n10722\ttheir numerical equivalents, so that this information is always available for\n10723\tthe remaining processing. (2) At the same time, parse the pattern and put a\n10724\tprocessed version into the parsed_pattern vector. This has escapes interpreted\n10725\tand comments removed (amongst other things). */\n10726\t\n10727\t/* Ensure that the parsed pattern buffer is big enough. For many smaller\n10728\tpatterns the vector on the stack (which was set up above) can be used. */\n10729\t\n10730\tparsed_size_needed = max_parsed_pattern(ptr, cb.end_pattern, utf, options);\n10731\t\n10732\t/* Allow for 2x uint32_t at the start and 2 at the end, for\n10733\tPCRE2_EXTRA_MATCH_WORD or PCRE2_EXTRA_MATCH_LINE (which are exclusive). */\n1