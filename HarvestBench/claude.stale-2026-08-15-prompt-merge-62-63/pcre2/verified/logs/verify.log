{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01R3NkAaFRSKsyDisJKRptfS","type":"tool_result","content":"File created successfully at: /local/home/scheschb/.harvest/work/harvest-work-GdDnk6/translated_rust/tests/common/scen.rs (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"aeab5d90-512d-4436-80fd-a67670a151c9","uuid":"a57fe34b-0d6d-4e84-8721-61ceb5b8b10c","timestamp":"2026-08-14T21:32:08.640Z","tool_use_result":{"type":"create","filePath":"/local/home/scheschb/.harvest/work/harvest-work-GdDnk6/translated_rust/tests/common/scen.rs","content":"//! A \"scenario\" is a full end-to-end use of the library: build the contexts,\n//! apply the options, compile, interrogate, match, extract substrings,\n//! substitute.  `run()` executes one scenario against ONE loaded library and\n//! returns a text log of every observable result; the differential tests run the\n//! same scenario against both `.so`s and compare the logs line by line.\n#![allow(dead_code)]\n\nuse super::consts::*;\nuse super::*;\nuse std::cell::RefCell;\nuse std::ffi::c_void;\nuse std::os::raw::c_int;\n\n// ------------------------------------------------------------------ pcre2 ABI\n#[repr(C)]\npub struct CalloutBlock {\n    pub version: u32,\n    pub callout_number: u32,\n    pub capture_top: u32,\n    pub capture_last: u32,\n    pub offset_vector: *mut Sz,\n    pub mark: *const u8,\n    pub subject: *const u8,\n    pub subject_length: Sz,\n    pub start_match: Sz,\n    pub current_position: Sz,\n    pub pattern_position: Sz,\n    pub next_item_length: Sz,\n    pub callout_string_offset: Sz,\n    pub callout_string_length: Sz,\n    pub callout_string: *const u8,\n    pub callout_flags: u32,\n}\n\n#[repr(C)]\npub struct CalloutEnumBlock {\n    pub version: u32,\n    pub pattern_position: Sz,\n    pub next_item_length: Sz,\n    pub callout_number: u32,\n    pub callout_string_offset: Sz,\n    pub callout_string_length: Sz,\n    pub callout_string: *const u8,\n}\n\n#[repr(C)]\npub struct SubstituteCalloutBlock {\n    pub version: u32,\n    pub input: *const u8,\n    pub output: *const u8,\n    pub output_offsets: [Sz; 2],\n    pub ovector: *mut Sz,\n    pub oveccount: u32,\n    pub subscount: u32,\n}\n\n// ------------------------------------------------------------------- log sink\nthread_local! {\n    static LOG: RefCell<Vec<String>> = RefCell::new(Vec::new());\n    /// value returned by the match callout (to exercise abort/skip paths)\n    static CALLOUT_RET: RefCell<c_int> = RefCell::new(0);\n    static SUBCALLOUT_RET: RefCell<c_int> = RefCell::new(0);\n}\nfn log(s: String) {\n    LOG.with(|l| l.borrow_mut().push(s));\n}\nfn take_log() -> Vec<String> {\n    LOG.with(|l| std::mem::take(&mut *l.borrow_mut()))\n}\n\nunsafe extern \"C\" fn callout_fn(blk: *mut c_void, _data: *mut c_void) -> c_int {\n    let b = &*(blk as *const CalloutBlock);\n    let mark = if b.mark.is_null() {\n        \"-\".to_string()\n    } else {\n        let mut v = vec![];\n        let mut i = 0;\n        while *b.mark.add(i) != 0 {\n            v.push(*b.mark.add(i));\n            i += 1;\n        }\n        show(&v)\n    };\n    let cs = if b.callout_string.is_null() {\n        \"-\".to_string()\n    } else {\n        show(std::slice::from_raw_parts(\n            b.callout_string,\n            b.callout_string_length,\n        ))\n    };\n    let ovec: Vec<String> = (0..2 * (b.capture_top as usize))\n        .map(|i| fmt_sz(*b.offset_vector.add(i)))\n        .collect();\n    log(format!(\n        \"callout v{} n{} top{} last{} sublen{} start{} cur{} patpos{} nextlen{} csoff{} cslen{} flags{:#x} mark={mark} cs={cs} ovec=[{}]\",\n        b.version, b.callout_number, b.capture_top, b.capture_last,\n        b.subject_length, fmt_sz(b.start_match), fmt_sz(b.current_position),\n        fmt_sz(b.pattern_position), fmt_sz(b.next_item_length),\n        fmt_sz(b.callout_string_offset), b.callout_string_length, b.callout_flags,\n        ovec.join(\",\")\n    ));\n    CALLOUT_RET.with(|r| *r.borrow())\n}\n\nunsafe extern \"C\" fn callout_enum_fn(blk: *mut c_void, _data: *mut c_void) -> c_int {\n    let b = &*(blk as *const CalloutEnumBlock);\n    let cs = if b.callout_string.is_null() {\n        \"-\".to_string()\n    } else {\n        show(std::slice::from_raw_parts(\n            b.callout_string,\n            b.callout_string_length,\n        ))\n    };\n    log(format!(\n        \"enum v{} patpos{} nextlen{} n{} csoff{} cslen{} cs={cs}\",\n        b.version,\n        fmt_sz(b.pattern_position),\n        fmt_sz(b.next_item_length),\n        b.callout_number,\n        fmt_sz(b.callout_string_offset),\n        b.callout_string_length\n    ));\n    0\n}\n\nunsafe extern \"C\" fn sub_callout_fn(blk: *mut c_void, _data: *mut c_void) -> c_int {\n    let b = &*(blk as *const SubstituteCalloutBlock);\n    let out = show(std::slice::from_raw_parts(\n        b.output.add(b.output_offsets[0]),\n        b.output_offsets[1].saturating_sub(b.output_offsets[0]),\n    ));\n    let ovec: Vec<String> = (0..2 * (b.oveccount as usize))\n        .map(|i| fmt_sz(*b.ovector.add(i)))\n        .collect();\n    log(format!(\n        \"subcallout v{} subs{} oveccount{} outoff[{},{}] out={out} ovec=[{}]\",\n        b.version,\n        b.subscount,\n        b.oveccount,\n        fmt_sz(b.output_offsets[0]),\n        fmt_sz(b.output_offsets[1]),\n        ovec.join(\",\")\n    ));\n    SUBCALLOUT_RET.with(|r| *r.borrow())\n}\n\n/// A case-conversion callout that mirrors an ASCII-only transformation, to\n/// exercise the `substitute_case_callout` path deterministically.\nunsafe extern \"C\" fn case_callout_fn(\n    input: *const u8,\n    input_len: Sz,\n    output: *mut u8,\n    output_cap: Sz,\n    to_case: c_int,\n    _data: *mut c_void,\n) -> Sz {\n    let inp = std::slice::from_raw_parts(input, input_len);\n    let mut out: Vec<u8> = Vec::with_capacity(input_len);\n    for (i, &c) in inp.iter().enumerate() {\n        let c2 = match to_case {\n            0 => c,                                          // NONE\n            1 => c.to_ascii_lowercase(),                     // LOWER\n            2 => c.to_ascii_uppercase(),                     // UPPER\n            3 => {\n                if i == 0 {\n                    c.to_ascii_uppercase()\n                } else {\n                    c.to_ascii_lowercase()\n                }\n            } // TITLE_FIRST\n            _ => c ^ 0x20,\n        };\n        out.push(c2);\n    }\n    if out.len() <= output_cap {\n        std::ptr::copy_nonoverlapping(out.as_ptr(), output, out.len());\n    }\n    out.len()\n}\n\npub fn fmt_sz(v: Sz) -> String {\n    if v == PCRE2_UNSET {\n        \"UNSET\".into()\n    } else {\n        v.to_string()\n    }\n}\n\n// ------------------------------------------------------------------- scenario\n#[derive(Clone, Debug)]\npub struct Scen {\n    pub pat: Vec<u8>,\n    /// pass PCRE2_ZERO_TERMINATED instead of the real length\n    pub zero_terminated_pat: bool,\n    pub opts: u32,\n    pub xopts: u32,\n    pub newline: u32,\n    pub bsr: u32,\n    pub max_varlookbehind: Option<u32>,\n    pub parens_nest: Option<u32>,\n    pub max_pat_len: Option<Sz>,\n    pub max_compiled_len: Option<Sz>,\n    pub optimize: Option<u32>,\n    /// use `pcre2_maketables()` output as the character tables\n    pub maketables: bool,\n    pub subjects: Vec<Vec<u8>>,\n    pub zero_terminated_subj: bool,\n    pub match_opts: Vec<u32>,\n    pub start_offsets: Vec<Sz>,\n    /// 0 → `pcre2_match_data_create_from_pattern`, else that ovector count\n    pub ovec: u32,\n    pub match_limit: Option<u32>,\n    pub depth_limit: Option<u32>,\n    pub heap_limit: Option<u32>,\n    pub offset_limit: Option<Sz>,\n    pub callout: bool,\n    pub callout_ret: c_int,\n    pub dfa: bool,\n    pub dfa_ws: usize,\n    pub substitutions: Vec<(Vec<u8>, u32, usize)>, // replacement, options, buffer size\n    pub sub_callout: bool,\n    pub sub_case_callout: bool,\n    pub serialize: bool,\n    pub code_copy: bool,\n    pub next_match_loop: bool,\n}\n\nimpl Default for Scen {\n    fn default() -> Scen {\n        Scen {\n            pat: b\"a\".to_vec(),\n            zero_terminated_pat: false,\n            opts: 0,\n            xopts: 0,\n            newline: 0,\n            bsr: 0,\n            max_varlookbehind: None,\n            parens_nest: None,\n            max_pat_len: None,\n            max_compiled_len: None,\n            optimize: None,\n            maketables: false,\n            subjects: vec![],\n            zero_terminated_subj: false,\n            match_opts: vec![0],\n            start_offsets: vec![0],\n            ovec: 0,\n            match_limit: None,\n            depth_limit: None,\n            heap_limit: None,\n            offset_limit: None,\n            callout: false,\n            callout_ret: 0,\n            dfa: true,\n            dfa_ws: 100,\n            substitutions: vec![],\n            sub_callout: false,\n            sub_case_callout: false,\n            serialize: true,\n            code_copy: false,\n            next_match_loop: false,\n        }\n    }\n}\n\nimpl Scen {\n    pub fn pat(p: &[u8]) -> Scen {\n        Scen {\n            pat: p.to_vec(),\n            ..Default::default()\n        }\n    }\n    pub fn opts(mut self, o: u32) -> Scen {\n        self.opts = o;\n        self\n    }\n    pub fn xopts(mut self, o: u32) -> Scen {\n        self.xopts = o;\n        self\n    }\n    pub fn subj(mut self, s: &[u8]) -> Scen {\n        self.subjects.push(s.to_vec());\n        self\n    }\n    pub fn subjects(mut self, s: &[&[u8]]) -> Scen {\n        self.subjects = s.iter().map(|x| x.to_vec()).collect();\n        self\n    }\n    pub fn mopts(mut self, v: &[u32]) -> Scen {\n        self.match_opts = v.to_vec();\n        self\n    }\n    pub fn starts(mut self, v: &[Sz]) -> Scen {\n        self.start_offsets = v.to_vec();\n        self\n    }\n    pub fn ovec(mut self, n: u32) -> Scen {\n        self.ovec = n;\n        self\n    }\n    pub fn sub(mut self, repl: &[u8], opts: u32, buf: usize) -> Scen {\n        self.substitutions.push((repl.to_vec(), opts, buf));\n        self\n    }\n}\n\n/// Run `s` against one library and return the observation log.\npub unsafe fn run(api: &Api, s: &Scen) -> Vec<String> {\n    let _ = take_log();\n    CALLOUT_RET.with(|r| *r.borrow_mut() = s.callout_ret);\n    SUBCALLOUT_RET.with(|r| *r.borrow_mut() = 0);\n\n    // ---------------------------------------------------------- compile context\n    let ccontext = (api.compile_context_create)(std::ptr::null_mut());\n    assert!(!ccontext.is_null());\n    if s.newline != 0 {\n        log(format!(\"set_newline={}\", (api.set_newline)(ccontext, s.newline)));\n    }\n    if s.bsr != 0 {\n        log(format!(\"set_bsr={}\", (api.set_bsr)(ccontext, s.bsr)));\n    }\n    if let Some(v) = s.max_varlookbehind {\n        log(format!(\n            \"set_max_varlookbehind={}\",\n            (api.set_max_varlookbehind)(ccontext, v)\n        ));\n    }\n    if let Some(v) = s.parens_nest {\n        log(format!(\n            \"set_parens_nest_limit={}\",\n            (api.set_parens_nest_limit)(ccontext, v)\n        ));\n    }\n    if let Some(v) = s.max_pat_len {\n        log(format!(\n            \"set_max_pattern_length={}\",\n            (api.set_max_pattern_length)(ccontext, v)\n        ));\n    }\n    if let Some(v) = s.max_compiled_len {\n        log(format!(\n            \"set_max_pattern_compiled_length={}\",\n            (api.set_max_pattern_compiled_length)(ccontext, v)\n        ));\n    }\n    if let Some(v) = s.optimize {\n        log(format!(\"set_optimize={}\", (api.set_optimize)(ccontext, v)));\n    }\n    if s.xopts != 0 {\n        log(format!(\n            \"set_extra_options={}\",\n            (api.set_compile_extra_options)(ccontext, s.xopts)\n        ));\n    }\n    let mut tables: *const u8 = std::ptr::null();\n    if s.maketables {\n        tables = (api.maketables)(std::ptr::null_mut());\n        assert!(!tables.is_null());\n        log(format!(\n            \"set_character_tables={}\",\n            (api.set_character_tables)(ccontext, tables)\n        ));\n        // the produced tables themselves must be identical\n        log(format!(\n            \"maketables={}\",\n            show(std::slice::from_raw_parts(tables, 1088))\n        ));\n    }\n\n    // ----------------------------------------------------------------- compile\n    let plen = if s.zero_terminated_pat {\n        PCRE2_ZERO_TERMINATED\n    } else {\n        s.pat.len()\n    };\n    let mut ec: c_int = -999;\n    let mut eo: Sz = 0xdead;\n    let mut code = (api.compile)(s.pat.as_ptr(), plen, s.opts, &mut ec, &mut eo, ccontext);\n    log(format!(\n        \"compile ok={} errorcode={} erroroffset={}\",\n        !code.is_null(),\n        ec,\n        fmt_sz(eo)\n    ));\n    if code.is_null() {\n        let mut buf = [0u8; 256];\n        let n = (api.get_error_message)(ec, buf.as_mut_ptr(), buf.len());\n        log(format!(\n            \"errmsg n={n} msg={}\",\n            show(&buf[..(if n > 0 { n as usize } else { 0 })])\n        ));\n        if s.maketables {\n            (api.maketables_free)(std::ptr::null_mut(), tables);\n        }\n        (api.compile_context_free)(ccontext);\n        return take_log();\n    }\n\n    if s.code_copy {\n        let c2 = (api.code_copy_with_tables)(code);\n        assert!(!c2.is_null());\n        (api.code_free)(code);\n        code = c2;\n        log(\"code_copy_with_tables\".into());\n    }\n\n    // ------------------------------------------------------------ pattern_info\n    for what in 0u32..=26 {\n        match what {\n            PCRE2_INFO_SIZE | PCRE2_INFO_FRAMESIZE | PCRE2_INFO_JITSIZE => {\n                let mut v: Sz = 0;\n                let rc = (api.pattern_info)(code, what, &mut v as *mut Sz as *mut c_void);\n                log(format!(\"info[{what}] rc={rc} sz={}\", fmt_sz(v)));\n            }\n            PCRE2_INFO_FIRSTBITMAP => {\n                let mut p: *const u8 = std::ptr::null();\n                let rc = (api.pattern_info)(\n                    code,\n                    what,\n                    &mut p as *mut *const u8 as *mut c_void,\n                );\n                if p.is_null() {\n                    log(format!(\"info[{what}] rc={rc} bitmap=NULL\"));\n                } else {\n                    log(format!(\n                        \"info[{what}] rc={rc} bitmap={}\",\n                        show(std::slice::from_raw_parts(p, 32))\n                    ));\n                }\n            }\n            PCRE2_INFO_NAMETABLE => {\n                let mut p: *const u8 = std::ptr::null();\n                let rc = (api.pattern_info)(\n                    code,\n                    what,\n                    &mut p as *mut *const u8 as *mut c_void,\n                );\n                let mut count: u32 = 0;\n                let mut esize: u32 = 0;\n                (api.pattern_info)(\n                    code,\n                    PCRE2_INFO_NAMECOUNT,\n                    &mut count as *mut u32 as *mut c_void,\n                );\n                (api.pattern_info)(\n                    code,\n                    PCRE2_INFO_NAMEENTRYSIZE,\n                    &mut esize as *mut u32 as *mut c_void,\n                );\n                let n = (count * esize) as usize;\n                log(format!(\n                    \"info[{what}] rc={rc} names={}\",\n                    show(std::slice::from_raw_parts(p, n))\n                ));\n            }\n            _ => {\n                let mut v: u32 = 0;\n                let rc = (api.pattern_info)(code, what, &mut v as *mut u32 as *mut c_void);\n                log(format!(\"info[{what}] rc={rc} v={v:#x}\"));\n            }\n        }\n    }\n\n    // -------------------------------------------------------------- serialize\n    if s.serialize {\n        let codes = [code];\n        let mut bytes: *mut u8 = std::ptr::null_mut();\n        let mut size: Sz = 0;\n        let rc = (api.serialize_encode)(\n            codes.as_ptr(),\n            1,\n            &mut bytes,\n            &mut size,\n            std::ptr::null_mut(),\n        );\n        log(format!(\"serialize_encode rc={rc} size={}\", fmt_sz(size)));\n        if rc > 0 {\n            // The first sizeof(pcre2_memctl) == 24 bytes hold the allocator\n            // pointers of the producing library; everything after that is the\n            // compiled bytecode and the character tables and must be identical.\n            let b = std::slice::from_raw_parts(bytes, size);\n            log(format!(\"serialized={}\", hex(&b[24..])));\n            log(format!(\n                \"serialize_get_number_of_codes={}\",\n                (api.serialize_get_number_of_codes)(bytes)\n            ));\n            let mut out: [Ptr; 1] = [std::ptr::null_mut()];\n            let rc2 = (api.serialize_decode)(\n                out.as_mut_ptr(),\n                1,\n                bytes,\n                std::ptr::null_mut(),\n            );\n            log(format!(\"serialize_decode rc={rc2}\"));\n            if rc2 > 0 {\n                let mut v: Sz = 0;\n                (api.pattern_info)(\n                    out[0],\n                    PCRE2_INFO_SIZE,\n                    &mut v as *mut Sz as *mut c_void,\n                );\n                log(format!(\"decoded size={}\", fmt_sz(v)));\n                (api.code_free)(out[0]);\n            }\n            (api.serialize_free)(bytes);\n        }\n    }\n\n    // ------------------------------------------------------- callout enumerate\n    log(format!(\n        \"callout_enumerate rc={}\",\n        (api.callout_enumerate)(code, Some(callout_enum_fn), std::ptr::null_mut())\n    ));\n\n    // ------------------------------------------------------------ match context\n    let mcontext = (api.match_context_create)(std::ptr::null_mut());\n    if let Some(v) = s.match_limit {\n        log(format!(\"set_match_limit={}\", (api.set_match_limit)(mcontext, v)));\n    }\n    if let Some(v) = s.depth_limit {\n        log(format!(\"set_depth_limit={}\", (api.set_depth_limit)(mcontext, v)));\n    }\n    if let Some(v) = s.heap_limit {\n        log(format!(\"set_heap_limit={}\", (api.set_heap_limit)(mcontext, v)));\n    }\n    if let Some(v) = s.offset_limit {\n        log(format!(\"set_offset_limit={}\", (api.set_offset_limit)(mcontext, v)));\n    }\n    if s.callout {\n        log(format!(\n            \"set_callout={}\",\n            (api.set_callout)(mcontext, Some(callout_fn), std::ptr::null_mut())\n        ));\n    }\n    if s.sub_callout {\n        log(format!(\n            \"set_substitute_callout={}\",\n            (api.set_substitute_callout)(mcontext, Some(sub_callout_fn), std::ptr::null_mut())\n        ));\n    }\n    if s.sub_case_callout {\n        log(format!(\n            \"set_substitute_case_callout={}\",\n            (api.set_substitute_case_callout)(\n                mcontext,\n                Some(case_callout_fn),\n                std::ptr::null_mut()\n            )\n        ));\n    }\n\n    // ------------------------------------------------------------------- match\n    let md = if s.ovec == 0 {\n        (api.match_data_create_from_pattern)(code, std::ptr::null_mut())\n    } else {\n        (api.match_data_create)(s.ovec, std::ptr::null_mut())\n    };\n    assert!(!md.is_null());\n    log(format!(\n        \"md ovector_count={} size={}\",\n        (api.get_ovector_count)(md),\n        fmt_sz((api.get_match_data_size)(md))\n    ));\n\n    for subj in &s.subjects {\n        let slen = if s.zero_terminated_subj {\n            PCRE2_ZERO_TERMINATED\n        } else {\n            subj.len()\n        };\n        for &mo in &s.match_opts {\n            for &so in &s.start_offsets {\n                let rc = (api.do_match)(code, subj.as_ptr(), slen, so, mo, md, mcontext);\n                log(format!(\n                    \"match subj={} mo={mo:#x} so={} rc={rc}\",\n                    show(subj),\n                    fmt_sz(so)\n                ));\n                report_match(api, md, rc, subj);\n                if s.next_match_loop && rc >= 0 {\n                    let mut off: Sz = 0;\n                    let mut gopts: u32 = 0;\n                    let mut n = 0;\n                    while (api.next_match)(md, &mut off, &mut gopts) != 0 && n < 12 {\n                        log(format!(\n                            \"next_match off={} gopts={gopts:#x}\",\n                            fmt_sz(off)\n                        ));\n                        let rc2 =\n                            (api.do_match)(code, subj.as_ptr(), slen, off, mo | gopts, md, mcontext);\n                        log(format!(\"  regmatch rc={rc2}\"));\n                        if rc2 < 0 {\n                            break;\n                        }\n                        report_match(api, md, rc2, subj);\n                        n += 1;\n                    }\n                }\n                if rc > 0 {\n                    substrings(api, code, md, rc);\n                }\n                if s.dfa {\n                    let mut ws = vec![0i32; s.dfa_ws];\n                    let rc = (api.dfa_match)(\n                        code,\n                        subj.as_ptr(),\n                        slen,\n                        so,\n                        mo,\n                        md,\n                        mcontext,\n                        ws.as_mut_ptr(),\n                        ws.len(),\n                    );\n                    log(format!(\"dfa subj={} mo={mo:#x} so={} rc={rc}\", show(subj), fmt_sz(so)));\n                    report_match(api, md, rc, subj);\n                }\n            }\n        }\n        for (repl, sopts, bufsz) in &s.substitutions {\n            let mut buf = vec![0xcdu8; *bufsz + 1];\n            let mut blen: Sz = *bufsz;\n            let rc = (api.substitute)(\n                code,\n                subj.as_ptr(),\n                slen,\n                0,\n                *sopts,\n                md,\n                mcontext,\n                repl.as_ptr(),\n                repl.len(),\n                buf.as_mut_ptr(),\n                &mut blen,\n            );\n            log(format!(\n                \"substitute subj={} repl={} opts={sopts:#x} bufsz={bufsz} rc={rc} blen={}\",\n                show(subj),\n                show(repl),\n                fmt_sz(blen)\n            ));\n            if rc >= 0 {\n                let n = blen.min(*bufsz);\n                log(format!(\"  out={}\", show(&buf[..n])));\n            }\n            log(format!(\"  guard=0x{:02x}\", buf[*bufsz]));\n        }\n    }\n\n    (api.match_data_free)(md);\n    (api.match_context_free)(mcontext);\n    (api.code_free)(code);\n    if s.maketables {\n        (api.maketables_free)(std::ptr::null_mut(), tables);\n    }\n    (api.compile_context_free)(ccontext);\n    take_log()\n}\n\nunsafe fn report_match(api: &Api, md: Ptr, rc: c_int, _subj: &[u8]) {\n    let n = (api.get_ovector_count)(md);\n    let ov = (api.get_ovector_pointer)(md);\n    let pairs = if rc > 0 { rc as u32 } else { n };\n    let v: Vec<String> = (0..2 * pairs.min(n) as usize)\n        .map(|i| fmt_sz(*ov.add(i)))\n        .collect();\n    let mark = (api.get_mark)(md);\n    let mark_s = if mark.is_null() {\n        \"-\".to_string()\n    } else {\n        let mut v = vec![];\n        let mut i = 0;\n        while *mark.add(i) != 0 {\n            v.push(*mark.add(i));\n            i += 1;\n        }\n        show(&v)\n    };\n    log(format!(\n        \"  ovec=[{}] startchar={} mark={mark_s} hf={}\",\n        v.join(\",\"),\n        fmt_sz((api.get_startchar)(md)),\n        fmt_sz((api.get_match_data_heapframes_size)(md))\n    ));\n}\n\nunsafe fn substrings(api: &Api, code: Ptr, md: Ptr, rc: c_int) {\n    for i in 0..(rc as u32 + 1) {\n 