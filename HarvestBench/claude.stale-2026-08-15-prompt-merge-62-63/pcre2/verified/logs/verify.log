"C\" },\n    { \"\\\\Z\\\\C\",       NEVER_BACKSLASH_C, BAD_ESCAPE_IS_LITERAL, \"C\" },\n    { \"a\\\\C\",         NEVER_BACKSLASH_C, BAD_ESCAPE_IS_LITERAL, \"aC\" },\n    { \"a\\\\C+\",        NEVER_BACKSLASH_C, BAD_ESCAPE_IS_LITERAL, \"aCCC\" },\n    { \"\\\\C\",          0, BAD_ESCAPE_IS_LITERAL, \"x\" },\n    /* \\p / \\P -> get_ucp failure site */\n    { \"\\\\p{Xyz}\",     0, 0, \"p\" },\n    { \"\\\\p{Xyz}\",     0, BAD_ESCAPE_IS_LITERAL, \"p{Xyz}\" },\n    { \"\\\\P{Xyz}\",     0, BAD_ESCAPE_IS_LITERAL, \"P{Xyz}\" },\n    { \"\\\\p\",          0, BAD_ESCAPE_IS_LITERAL, \"p\" },\n    { \"\\\\p{\",         0, BAD_ESCAPE_IS_LITERAL, \"p{\" },\n    { \"x\\\\p{Nd}\",     0, BAD_ESCAPE_IS_LITERAL, \"x5\" },\n    /* \\g and \\k delimiter site (ERR57 / ERR69) */\n    { \"\\\\ka\",         0, 0, \"ka\" },\n    { \"\\\\ka\",         0, BAD_ESCAPE_IS_LITERAL, \"ka\" },\n    { \"\\\\k\",          0, BAD_ESCAPE_IS_LITERAL, \"k\" },\n    { \"\\\\ga\",         0, BAD_ESCAPE_IS_LITERAL, \"ga\" },\n    { \"\\\\g\",          0, BAD_ESCAPE_IS_LITERAL, \"g\" },\n    /* ERR119: missing terminator for number */\n    { \"()\\\\g<1x>\",    0, 0, \"g<1x>\" },\n    { \"()\\\\g<1x>\",    0, BAD_ESCAPE_IS_LITERAL, \"g<1x>\" },\n    { \"()\\\\g'1\",      0, BAD_ESCAPE_IS_LITERAL, \"g'1\" },\n    /* read_number error site (ERR61 overflow) */\n    { \"\\\\g<9999999999999>\", 0, 0, \"x\" },\n    { \"\\\\g<9999999999999>\", 0, BAD_ESCAPE_IS_LITERAL, \"g<9999999999999>\" },\n    /* read_name failure site */\n    { \"\\\\k<1a>\",      0, 0, \"k<1a>\" },\n    { \"\\\\k<1a>\",      0, BAD_ESCAPE_IS_LITERAL, \"k<1a>\" },\n    { \"\\\\k<>\",        0, BAD_ESCAPE_IS_LITERAL, \"k<>\" },\n    { \"\\\\g<>\",        0, BAD_ESCAPE_IS_LITERAL, \"g<>\" },\n    { \"\\\\k{ab\",       0, BAD_ESCAPE_IS_LITERAL, \"k{ab\" },\n    /* valid ones must be unaffected */\n    { \"(?<n>a)\\\\k<n>\", 0, BAD_ESCAPE_IS_LITERAL, \"aa\" },\n    { \"(?<n>a)\\\\g<n>\", 0, BAD_ESCAPE_IS_LITERAL, \"aa\" },\n    { \"(a)\\\\g<1