{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Dn5uHBszV35NkM12fGnPcG","type":"tool_result","content":"1\t//! Differential tests for the low-level (`PRIV(...)`) exports of PCRE2.\n2\t//!\n3\t//! Every test calls the same function in the C library (`p.c`) and in the Rust\n4\t//! library (`p.r`) with byte-identical inputs and compares *all* observable\n5\t//! results: the return value, every output parameter and every written byte.\n6\t//!\n7\t//! Safety notes (derived from the C sources in `c_src/src`):\n8\t//!   * `PRIV(strncmp)`/`PRIV(strncmp_c8)` do **not** stop at a NUL, so all\n9\t//!     comparison buffers are fully initialised for at least `n` bytes.\n10\t//!   * `PRIV(compile_get_hash_from_name)` reads `name[length - 1]`, so a length\n11\t//!     of 0 reads `name[-1]`; we therefore hand it a pointer one byte inside an\n12\t//!     initialised buffer (still in-bounds, deterministic for both libraries).\n13\t//!   * `PRIV(is_newline)` requires `ptr < endptr`, `PRIV(was_newline)` requires\n14\t//!     `ptr > startptr`; in UTF mode `GETCHAR`/`BACKCHAR` are unchecked, so UTF\n15\t//!     subjects only ever contain complete sequences and never start with a\n16\t//!     continuation byte.\n17\t//!   * `PRIV(ord2utf)` may write up to 6 code units, so the buffer is 8 bytes.\n18\t//!   * `PRIV(ckd_smul)` asserts `a >= 0 && b >= 0` and takes `int`s, so only\n19\t//!     values in `0 ..= i32::MAX` are used.\n20\t//!   * `PRIV(memctl_malloc)` writes a `pcre2_memctl` (24 bytes) into the block\n21\t//!     it obtains, so the test allocator always over-allocates (this makes the\n22\t//!     `size == 0` case well defined).\n23\t\n24\t#![allow(clippy::too_many_arguments)]\n25\t\n26\tmod common;\n27\tuse common::consts::*;\n28\tuse common::*;\n29\t\n30\tuse std::ffi::c_void;\n31\tuse std::os::raw::{c_char, c_int};\n32\tuse std::ptr;\n33\tuse std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};\n34\t\n35\t// ---------------------------------------------------------------------------\n36\t// helpers\n37\t// ---------------------------------------------------------------------------\n38\t\n39\t/// Encode one Unicode scalar as UTF-8 (input must not be a surrogate).\n40\tfn utf8_push(cp: u32, out: &mut Vec<u8>) {\n41\t    if cp < 0x80 {\n42\t        out.push(cp as u8);\n43\t    } else if cp < 0x800 {\n44\t        out.push(0xc0 | (cp >> 6) as u8);\n45\t        out.push(0x80 | (cp & 0x3f) as u8);\n46\t    } else if cp < 0x10000 {\n47\t        out.push(0xe0 | (cp >> 12) as u8);\n48\t        out.push(0x80 | ((cp >> 6) & 0x3f) as u8);\n49\t        out.push(0x80 | (cp & 0x3f) as u8);\n50\t    } else {\n51\t        out.push(0xf0 | (cp >> 18) as u8);\n52\t        out.push(0x80 | ((cp >> 12) & 0x3f) as u8);\n53\t        out.push(0x80 | ((cp >> 6) & 0x3f) as u8);\n54\t        out.push(0x80 | (cp & 0x3f) as u8);\n55\t    }\n56\t}\n57\t\n58\tfn utf8_of(cps: &[u32]) -> Vec<u8> {\n59\t    let mut v = Vec::new();\n60\t    for &c in cps {\n61\t        utf8_push(c, &mut v);\n62\t    }\n63\t    v\n64\t}\n65\t\n66\t/// Decode the (valid) UTF-8 character at `s[i]`; returns (code point, length).\n67\tfn decode_utf8(s: &[u8], i: usize) -> (u32, usize) {\n68\t    let b = s[i];\n69\t    if b < 0xc0 {\n70\t        return (b as u32, 1);\n71\t    }\n72\t    let n = if b < 0xe0 {\n73\t        2\n74\t    } else if b < 0xf0 {\n75\t        3\n76\t    } else {\n77\t        4\n78\t    };\n79\t    assert!(i + n <= s.len(), \"truncated utf8 at {i} in {}\", show(s));\n80\t    let mut c = (b as u32) & (0x7f >> n);\n81\t    for k in 1..n {\n82\t        c = (c << 6) | ((s[i + k] as u32) & 0x3f);\n83\t    }\n84\t    (c, n)\n85\t}\n86\t\n87\t/// Offsets at which a character starts, for a valid UTF-8 string.\n88\tfn char_starts(s: &[u8]) -> Vec<usize> {\n89\t    let mut v = Vec::new();\n90\t    let mut i = 0;\n91\t    while i < s.len() {\n92\t        v.push(i);\n93\t        i += decode_utf8(s, i).1;\n94\t    }\n95\t    v\n96\t}\n97\t\n98\t/// Render an optional pointer as an offset from `base`.\n99\tfn off_of(p: *const u8, base: *const u8) -> Option<usize> {\n100\t    if p.is_null() {\n101\t        None\n102\t    } else {\n103\t        Some(p as usize - base as usize)\n104\t    }\n105\t}\n106\t\n107\t// --------------------------- compiled-code layout --------------------------\n108\t//\n109\t// `pcre2_real_code` (pcre2_intmodedep.h):\n110\t//   pcre2_memctl memctl;      /* 24 bytes: 2 fn ptrs + void* */\n111\t//   const uint8_t *tables;    /* +24 */\n112\t//   void *executable_jit;     /* +32 */\n113\t//   uint8_t start_bitmap[32]; /* +40 */\n114\t//   PCRE2_SIZE blocksize;     /* +72 */\n115\t//   PCRE2_SIZE code_start;    /* +80 */\n116\t//   ...                       /* sizeof == 152 on LP64 */\n117\t//\n118\t// `codestart = (uint8_t *)re + re->code_start` (pcre2_compile.c), and the\n119\t// byte-code is preceded by the name table plus (4-byte aligned) the encoded\n120\t// character lists.  `PCRE2_INFO_NAMETABLE` yields `re + sizeof(pcre2_real_code)`\n121\t// and `PCRE2_INFO_SIZE` yields `re->blocksize`, which lets us *verify* the two\n122\t// field offsets at run time in each library before trusting them.\n123\tconst OFF_BLOCKSIZE: usize = 72;\n124\tconst OFF_CODE_START: usize = 80;\n125\t\n126\tstruct Layout {\n127\t    base: *const u8,\n128\t    codestart: *const u8,\n129\t    blocksize: usize,\n130\t    code_start: usize,\n131\t    namecount: u32,\n132\t    nameentrysize: u32,\n133\t}\n134\t\n135\tunsafe fn layout(api: &Api, code: Ptr, what: &str) -> Layout {\n136\t    let base = code as *const u8;\n137\t\n138\t    let mut bs: Sz = 0;\n139\t    assert_eq!(\n140\t        (api.pattern_info)(code, PCRE2_INFO_SIZE, &mut bs as *mut Sz as *mut c_void),\n141\t        0\n142\t    );\n143\t    let mut nt: *const u8 = ptr::null();\n144\t    assert_eq!(\n145\t        (api.pattern_info)(\n146\t            code,\n147\t            PCRE2_INFO_NAMETABLE,\n148\t            &mut nt as *mut *const u8 as *mut c_void\n149\t        ),\n150\t        0\n151\t    );\n152\t    let mut nc: u32 = 0;\n153\t    assert_eq!(\n154\t        (api.pattern_info)(code, PCRE2_INFO_NAMECOUNT, &mut nc as *mut u32 as *mut c_void),\n155\t        0\n156\t    );\n157\t    let mut nes: u32 = 0;\n158\t    assert_eq!(\n159\t        (api.pattern_info)(\n160\t            code,\n161\t            PCRE2_INFO_NAMEENTRYSIZE,\n162\t            &mut nes as *mut u32 as *mut c_void\n163\t        ),\n164\t        0\n165\t    );\n166\t\n167\t    let structsz = nt as usize - base as usize;\n168\t    assert_eq!(\n169\t        structsz, 152,\n170\t        \"{what}: unexpected sizeof(pcre2_real_code) = {structsz}\"\n171\t    );\n172\t    let raw_bs = *(base.add(OFF_BLOCKSIZE) as *const usize);\n173\t    assert_eq!(\n174\t        raw_bs, bs,\n175\t        \"{what}: blocksize field is not at offset {OFF_BLOCKSIZE} \\\n176\t         (field={raw_bs}, PCRE2_INFO_SIZE={bs}) - struct layout assumption broken\"\n177\t    );\n178\t    let cs = *(base.add(OFF_CODE_START) as *const usize);\n179\t    assert!(\n180\t        cs >= structsz && cs < bs,"}]},"parent_tool_use_id":"toolu_bdrk_01TRdAa52zmZ4H8aRPEchWK3","session_id":"aeab5d90-512d-4436-80fd-a67670a151c9","uuid":"b1821704-78a6-49b6-8b4d-0f4724508dd7","timestamp":"2026-08-14T22:12:23.446Z","subagent_type":"general-purpose","task_description":"Write error-path diff tests (Table 1)"}
