{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013LApU4t1XjhL4WbwuzWTA9","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH shared libraries with `libloading` and exposes every exported\n4\t//! symbol as a typed function pointer / data pointer.  Rust functions are never\n5\t//! called directly: everything goes through `target/release/libpcre2.so`, so the\n6\t//! `#[no_mangle]`/`extern \"C\"` wrappers are under test too.\n7\t#![allow(dead_code, non_snake_case, non_camel_case_types)]\n8\t\n9\tpub mod consts;\n10\tpub mod scen;\n11\t\n12\tuse libloading::{Library, Symbol};\n13\tuse std::ffi::c_void;\n14\tuse std::os::raw::{c_int, c_uchar};\n15\tuse std::path::PathBuf;\n16\t\n17\tpub type Sz = usize; // PCRE2_SIZE\n18\tpub type Ptr = *mut c_void; // opaque pcre2_* pointer\n19\t\n20\t// ---------------------------------------------------------------- signatures\n21\tpub type FnConfig = unsafe extern \"C\" fn(u32, *mut c_void) -> c_int;\n22\t\n23\tpub type FnGenCtxCreate = unsafe extern \"C\" fn(\n24\t    Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>,\n25\t    Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>,\n26\t    *mut c_void,\n27\t) -> Ptr;\n28\tpub type FnCtxCreate = unsafe extern \"C\" fn(Ptr) -> Ptr;\n29\tpub type FnCtxCopy = unsafe extern \"C\" fn(Ptr) -> Ptr;\n30\tpub type FnCtxFree = unsafe extern \"C\" fn(Ptr);\n31\t\n32\tpub type FnSetU32 = unsafe extern \"C\" fn(Ptr, u32) -> c_int;\n33\tpub type FnSetSz = unsafe extern \"C\" fn(Ptr, Sz) -> c_int;\n34\tpub type FnSetTables = unsafe extern \"C\" fn(Ptr, *const u8) -> c_int;\n35\tpub type FnSetGuard =\n36\t    unsafe extern \"C\" fn(Ptr, Option<unsafe extern \"C\" fn(u32, *mut c_void) -> c_int>, *mut c_void)\n37\t        -> c_int;\n38\tpub type FnSetCallout = unsafe extern \"C\" fn(\n39\t    Ptr,\n40\t    Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void) -> c_int>,\n41\t    *mut c_void,\n42\t) -> c_int;\n43\tpub type FnSetCaseCallout = unsafe extern \"C\" fn(\n44\t    Ptr,\n45\t    Option<\n46\t        unsafe extern \"C\" fn(*const u8, Sz, *mut u8, Sz, c_int, *mut c_void) -> Sz,\n47\t    >,\n48\t    *mut c_void,\n49\t) -> c_int;\n50\tpub type FnSetRecMem = unsafe extern \"C\" fn(\n51\t    Ptr,\n52\t    Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>,\n53\t    Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>,\n54\t    *mut c_void,\n55\t) -> c_int;\n56\t\n57\tpub type FnCompile =\n58\t    unsafe extern \"C\" fn(*const u8, Sz, u32, *mut c_int, *mut Sz, Ptr) -> Ptr;\n59\tpub type FnCodeFree = unsafe extern \"C\" fn(Ptr);\n60\tpub type FnCodeCopy = unsafe extern \"C\" fn(Ptr) -> Ptr;\n61\t\n62\tpub type FnPatternInfo = unsafe extern \"C\" fn(Ptr, u32, *mut c_void) -> c_int;\n63\tpub type FnCalloutEnumerate = unsafe extern \"C\" fn(\n64\t    Ptr,\n65\t    Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void) -> c_int>,\n66\t    *mut c_void,\n67\t) -> c_int;\n68\t\n69\tpub type FnMatchDataCreate = unsafe extern \"C\" fn(u32, Ptr) -> Ptr;\n70\tpub type FnMatchDataFromPattern = unsafe extern \"C\" fn(Ptr, Ptr) -> Ptr;\n71\tpub type FnMatchDataFree = unsafe extern \"C\" fn(Ptr);\n72\tpub type FnMatch =\n73\t    unsafe extern \"C\" fn(Ptr, *const u8, Sz, Sz, u32, Ptr, Ptr) -> c_int;\n74\tpub type FnDfaMatch = unsafe extern \"C\" fn(\n75\t    Ptr,\n76\t    *const u8,\n77\t    Sz,\n78\t    Sz,\n79\t    u32,\n80\t    Ptr,\n81\t    Ptr,\n82\t    *mut c_int,\n83\t    Sz,\n84\t) -> c_int;\n85\tpub type FnGetMark = unsafe extern \"C\" fn(Ptr) -> *const u8;\n86\tpub type FnGetSz = unsafe extern \"C\" fn(Ptr) -> Sz;\n87\tpub type FnGetU32 = unsafe extern \"C\" fn(Ptr) -> u32;\n88\tpub type FnGetOvecPtr = unsafe extern \"C\" fn(Ptr) -> *mut Sz;\n89\tpub type FnNextMatch = unsafe extern \"C\" fn(Ptr, *mut Sz, *mut u32) -> c_int;\n90\t\n91\tpub type FnSubCopyByName =\n92\t    unsafe extern \"C\" fn(Ptr, *const u8, *mut u8, *mut Sz) -> c_int;\n93\tpub type FnSubCopyByNumber = unsafe extern \"C\" fn(Ptr, u32, *mut u8, *mut Sz) -> c_int;\n94\tpub type FnSubFree = unsafe extern \"C\" fn(*mut u8);\n95\tpub type FnSubGetByName =\n96\t    unsafe extern \"C\" fn(Ptr, *const u8, *mut *mut u8, *mut Sz) -> c_int;\n97\tpub type FnSubGetByNumber =\n98\t    unsafe extern \"C\" fn(Ptr, u32, *mut *mut u8, *mut Sz) -> c_int;\n99\tpub type FnSubLenByName = unsafe extern \"C\" fn(Ptr, *const u8, *mut Sz) -> c_int;\n100\tpub type FnSubLenByNumber = unsafe extern \"C\" fn(Ptr, u32, *mut Sz) -> c_int;\n101\tpub type FnNametableScan =\n102\t    unsafe extern \"C\" fn(Ptr, *const u8, *mut *const u8, *mut *const u8) -> c_int;\n103\tpub type FnNumberFromName = unsafe extern \"C\" fn(Ptr, *const u8) -> c_int;\n104\tpub type FnSubListFree = unsafe extern \"C\" fn(*mut *mut u8);\n105\tpub type FnSubListGet =\n106\t    unsafe extern \"C\" fn(Ptr, *mut *mut *mut u8, *mut *mut Sz) -> c_int;\n107\t\n108\tpub type FnSerEncode =\n109\t    unsafe extern \"C\" fn(*const Ptr, i32, *mut *mut u8, *mut Sz, Ptr) -> i32;\n110\tpub type FnSerDecode = unsafe extern \"C\" fn(*mut Ptr, i32, *const u8, Ptr) -> i32;\n111\tpub type FnSerNumCodes = unsafe extern \"C\" fn(*const u8) -> i32;\n112\tpub type FnSerFree = unsafe extern \"C\" fn(*mut u8);\n113\t\n114\tpub type FnSubstitute = unsafe extern \"C\" fn(\n115\t    Ptr,\n116\t    *const u8,\n117\t    Sz,\n118\t    Sz,\n119\t    u32,\n120\t    Ptr,\n121\t    Ptr,\n122\t    *const u8,\n123\t    Sz,\n124\t    *mut u8,\n125\t    *mut Sz,\n126\t) -> c_int;\n127\t\n128\tpub type FnPatternConvert =\n129\t    unsafe extern \"C\" fn(*const u8, Sz, u32, *mut *mut u8, *mut Sz, Ptr) -> c_int;\n130\tpub type FnConvertedFree = unsafe extern \"C\" fn(*mut u8);\n131\t\n132\tpub type FnJitCompile = unsafe extern \"C\" fn(Ptr, u32) -> c_int;\n133\tpub type FnJitMatch =\n134\t    unsafe extern \"C\" fn(Ptr, *const u8, Sz, Sz, u32, Ptr, Ptr) -> c_int;\n135\tpub type FnJitFreeUnused = unsafe extern \"C\" fn(Ptr);\n136\tpub type FnJitStackCreate = unsafe extern \"C\" fn(usize, usize, Ptr) -> Ptr;\n137\tpub type FnJitStackAssign = unsafe extern \"C\" fn(Ptr, *mut c_void, *mut c_void);\n138\tpub type FnJitStackFree = unsafe extern \"C\" fn(Ptr);\n139\tpub type FnJitGetSize = unsafe extern \"C\" fn(Ptr) -> Sz;\n140\tpub type FnJitGetTarget = unsafe extern \"C\" fn() -> *const i8;\n141\tpub type FnJitFree = unsafe extern \"C\" fn(Ptr, Ptr);\n142\tpub type FnJitFreeRodata = unsafe extern \"C\" fn(Ptr, Ptr);\n143\t\n144\tpub type FnGetErrorMessage = unsafe extern \"C\" fn(c_int, *mut u8, Sz) -> c_int;\n145\tpub type FnMaketables = unsafe extern \"C\" fn(Ptr) -> *const u8;\n146\tpub type FnMaketablesFree = unsafe extern \"C\" fn(Ptr, *const u8);\n147\t\n148\t// low-level internals\n149\tpub type FnValidUtf = unsafe extern \"C\" fn(*const u8, Sz, *mut Sz) -> c_int;\n150\tpub type FnOrd2Utf = unsafe extern \"C\" fn(u32, *mut u8) -> c_int;\n151\tpub type FnStrcmp = unsafe extern \"C\" fn(*const u8, *const u8) -> c_int;\n152\tpub type FnStrcmpC8 = unsafe extern \"C\" fn(*const u8, *const i8) -> c_int;\n153\tpub type FnStrncmp = unsafe extern \"C\" fn(*const u8, *const u8, Sz) -> c_int;\n154\tpub type FnStrncmpC8 = unsafe extern \"C\" fn(*const u8, *const i8, Sz) -> c_int;\n155\tpub type FnStrcpyC8 = unsafe extern \"C\" fn(*mut u8, *const i8) -> Sz;\n156\tpub type FnStrlen = unsafe extern \"C\" fn(*const u8) -> Sz;\n157\tpub type FnCkdSmul = unsafe extern \"C\" fn(*mut Sz, Sz, Sz) -> c_int;\n158\tpub type FnIsNewline =\n159\t    unsafe extern \"C\" fn(*const u8, u32, *const u8, *mut u32, c_int) -> c_int;\n160\tpub type FnWasNewline =\n161\t    unsafe extern \"C\" fn(*const u8, u32, *const u8, *mut u32, c_int) -> c_int;\n162\tpub type FnExtuni = unsafe extern \"C\" fn(\n163\t    u32,\n164\t    *const u8,\n165\t    *const u8,\n166\t    *const u8,\n167\t    c_int,\n168\t    *mut c_int,\n169\t) -> *const u8;\n170\tpub type FnScriptRun = unsafe extern \"C\" fn(*const u8, *const u8, c_int) -> c_int;\n171\tpub type FnFindBracket = unsafe extern \"C\" fn(*const u8, c_int, c_int) -> *const u8;\n172\tpub type FnXclass =\n173\t    unsafe extern \"C\" fn(u32, *const u8, *const u8, c_int) -> c_int;\n174\tpub type FnEclass = unsafe extern \"C\" fn(\n175\t    u32,\n176\t    *const u8,\n177\t    *const u8,\n178\t    *const u8,\n179\t    c_int,\n180\t) -> c_int;\n181\tpub type FnUpdateClassbits = unsafe extern \"C\" fn(u32, u32, c_int, *mut u8);\n182\tpub type FnMemctlMalloc = unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void;\n183\tpub type FnGetHashFromName = unsafe extern \"C\" fn(*const u8, Sz) -> u32;\n184\t\n185\tmacro_rules! api {\n186\t    ( $( $field:ident : $ty:ty = $sym:literal ; )* ) => {\n187\t        pub struct Api {\n188\t            _lib: Library,\n189\t            $( pub $field: $ty, )*\n190\t        }\n191\t        impl Api {\n192\t            pub unsafe fn load(path: &std::path::Path) -> Api {\n193\t                let lib = Library::new(path)\n194\t                    .unwrap_or_else(|e| panic!(\"dlopen {:?}: {e}\", path));\n195\t                $(\n196\t                    let $field: $ty = {\n197\t                        let s: Symbol<$ty> = lib\n198\t                            .get(concat!($sym, \"\\0\").as_bytes())\n199\t                            .unwrap_or_else(|e| panic!(\"missing symbol {} in {:?}: {e}\", $sym, path));\n200\t                        *s\n201\t                    };\n202\t                )*\n203\t                Api { _lib: lib, $( $field, )* }\n204\t            }\n205\t        }\n206\t    };\n207\t}\n208\t\n209\tapi! {\n210\t    config: FnConfig = \"pcre2_config_8\";\n211\t\n212\t    general_context_create: FnGenCtxCreate = \"pcre2_general_context_create_8\";\n213\t    general_context_copy: FnCtxCopy = \"pcre2_general_context_copy_8\";\n214\t    general_context_free: FnCtxFree = \"pcre2_general_context_free_8\";\n215\t    compile_context_create: FnCtxCreate = \"pcre2_compile_context_create_8\";\n216\t    compile_context_copy: FnCtxCopy = \"pcre2_compile_context_copy_8\";\n217\t    compile_context_free: FnCtxFree = \"pcre2_compile_context_free_8\";\n218\t    match_context_create: FnCtxCreate = \"pcre2_match_context_create_8\";\n219\t    match_context_copy: FnCtxCopy = \"pcre2_match_context_copy_8\";\n220\t    match_context_free: FnCtxFree = \"pcre2_match_context_free_8\";\n221\t    convert_context_create: FnCtxCreate = \"pcre2_convert_context_create_8\";\n222\t    convert_context_copy: FnCtxCopy = \"pcre2_convert_context_copy_8\";\n223\t    convert_context_free: FnCtxFree = \"pcre2_convert_context_free_8\";\n224\t\n225\t    set_bsr: FnSetU32 = \"pcre2_set_bsr_8\";\n226\t    set_character_tables: FnSetTables = \"pcre2_set_character_tables_8\";\n227\t    set_compile_extra_options: FnSetU32 = \"pcre2_set_compile_extra_options_8\";\n228\t    set_max_pattern_length: FnSetSz = \"pcre2_set_max_pattern_length_8\";\n229\t    set_max_pattern_compiled_length: FnSetSz = \"pcre2_set_max_pattern_compiled_length_8\";\n230\t    set_max_varlookbehind: FnSetU32 = \"pcre2_set_max_varlookbehind_8\";\n231\t    set_newline: FnSetU32 = \"pcre2_set_newline_8\";\n232\t    set_parens_nest_limit: FnSetU32 = \"pcre2_set_parens_nest_limit_8\";\n233\t    set_compile_recursion_guard: FnSetGuard = \"pcre2_set_compile_recursion_guard_8\";\n234\t    set_optimize: FnSetU32 = \"pcre2_set_optimize_8\";\n235\t    set_callout: FnSetCallout = \"pcre2_set_callout_8\";\n236\t    set_substitute_callout: FnSetCallout = \"pcre2_set_substitute_callout_8\";\n237\t    set_substitute_case_callout: FnSetCaseCallout = \"pcre2_set_substitute_case_callout_8\";\n238\t    set_depth_limit: FnSetU32 = \"pcre2_set_depth_limit_8\";\n239\t    set_heap_limit: FnSetU32 = \"pcre2_set_heap_limit_8\";\n240\t    set_match_limit: FnSetU32 = \"pcre2_set_match_limit_8\";\n241\t    set_offset_limit: FnSetSz = \"pcre2_set_offset_limit_8\";\n242\t    set_recursion_limit: FnSetU32 = \"pcre2_set_recursion_limit_8\";\n243\t    set_recursion_memory_management: FnSetRec