t of UTF checking;\n7305\t  lookbehinds can go back no further than this. */\n7306\t\n7307\t  mb->check_subject = start_match;\n7308\t\n7309\t  /* Move back by the maximum lookbehind, just in case it happens at the very\n7310\t  start of matching, but don't do this if we skipped bad 8-bit or 16-bit code\n7311\t  units above. */\n7312\t\n7313\t#if PCRE2_CODE_UNIT_WIDTH != 32\n7314\t  if (!skipped_bad_start)\n7315\t    {\n7316\t    unsigned int i;\n7317\t    for (i = re->max_lookbehind; i > 0 && mb->check_subject > subject; i--)\n7318\t      {\n7319\t      mb->check_subject--;\n7320\t      while (mb->check_subject > subject &&\n7321\t#if PCRE2_CODE_UNIT_WIDTH == 8\n7322\t      (*mb->check_subject & 0xc0) == 0x80)\n7323\t#else  /* 16-bit */\n7324\t      (*mb->check_subject & 0xfc00) == 0xdc00)\n7325\t#endif\n7326\t        mb->check_subject--;\n7327\t      }\n7328\t    }\n7329\t#else  /* PCRE2_CODE_UNIT_WIDTH != 32 */\n7330\t\n7331\t  /* In the 32-bit library, one code unit equals one character. However,\n7332\t  we cannot just subtract the lookbehind and then compare pointers, because\n7333\t  a very large lookbehind could create an invalid pointer. */\n7334\t\n7335\t  if (start_offset >= re->max_lookbehind)\n7336\t    mb->check_subject -= re->max_lookbehind;\n7337\t  else\n7338\t    mb->check_subject = subject;\n7339\t#endif  /* PCRE2_CODE_UNIT_WIDTH != 32 */"}]},"parent_tool_use_id":"toolu_bdrk_01T3vzpD4D4RJrsJaMNxtuxQ","session_id":"aeab5d90-512d-4436-80fd-a67670a151c9","uuid":"ce4646a9-ba30-4ee5-853f-3e7be0f92b6f","timestamp":"2026-08-14T20:54:32.578Z","subagent_type":"general-purpose","task_description":"Derive API error surface rows"}
