\t\n314\t/*************************************************\n315\t*            Return error message                *\n316\t*************************************************/\n317\t\n318\t/* This function copies an error message into a buffer whose units are of an\n319\tappropriate width. Error numbers are positive for compile-time errors, and\n320\tnegative for match-time errors (except for UTF errors), but the numbers are all\n321\tdistinct.\n322\t\n323\tArguments:\n324\t  enumber       error number\n325\t  buffer        where to put the message (zero terminated)\n326\t  size          size of the buffer in code units\n327\t\n328\tReturns:        length of message if all is well\n329\t                negative on error\n330\t*/\n331\t\n332\tPCRE2_EXP_DEFN int PCRE2_CALL_CONVENTION\n333\tpcre2_get_error_message(int enumber, PCRE2_UCHAR *buffer, PCRE2_SIZE size)\n334\t{\n335\tconst unsigned char *message;\n336\tPCRE2_SIZE i;\n337\tint n, rc = 0;\n338\t\n339\tif (size == 0) return PCRE2_ERROR_NOMEMORY;\n340\t\n341\tif (enumber >= COMPILE_ERROR_BASE)  /* Compile error */\n342\t  {\n343\t  message = compile_error_texts;\n344\t  n = enumber - COMPILE_ERROR_BASE;\n345\t  }\n346\telse if (enumber < 0)               /* Match or UTF error */\n347\t  {\n348\t  message = match_error_texts;\n349\t  n = -enumber;\n350\t  }\n351\telse                                /* Invalid error number */\n352\t  {\n353\t  message = (const unsigned char *)\"\\0\";  /* Empty message list */\n354\t  n = 1;\n355\t  }\n356\t\n357\tfor (; n > 0; n--)\n358\t  {\n359\t  while (*message++ != CHAR_NUL) {}\n360\t  if (*message == CHAR_NUL) return PCRE2_ERROR_BADDATA;\n361\t  }\n362\t\n363\tfor (i = 0; *message != 0; i++)\n364\t  {\n365\t  if (i >= size - 1)\n366\t    {\n367\t    rc = PCRE2_ERROR_NOMEMORY;\n368\t    break;\n369\t    }\n370\t  buffer[i] = *message++;\n371\t  }\n372\t\n373\t#if defined EBCDIC && 'a' != 0x81\n374\t/* If compiling for EBCDIC, but the compiler's string literals are not EBCDIC,\n375\tthen we are in the \"force EBCDIC 1047\" mode. I have chosen to add a few lines\n376\there to translate the error strings on the fly, rather than require the string\n377\tliterals above to be written out arduously using the \"STR_XYZ\" macros. */\n378\tfor (PCRE2_SIZE j = 0; j < i; ++j)\n379\t  buffer[j] = PRIV(ascii_to_ebcdic_1047)[buffer[j]];\n380\t#endif\n381\t\n382\tbuffer[i] = 0;     /* Terminate message, even if truncated. */\n383\treturn rc? rc : (int)i;\n384\t}\n385\t\n386\t/* End of pcre2_error.c */\n387\t"}]},"parent_tool_use_id":"toolu_bdrk_01T3vzpD4D4RJrsJaMNxtuxQ","session_id":"aeab5d90-512d-4436-80fd-a67670a151c9","uuid":"30acf31b-e930-44fa-9211-9e6f90a48041","timestamp":"2026-08-14T20:53:48.919Z","subagent_type":"general-purpose","task_description":"Derive API error surface rows"}
