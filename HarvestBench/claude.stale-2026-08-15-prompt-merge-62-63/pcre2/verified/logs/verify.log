  }\n346\t}\n347\t\n348\tpub fn crate_root() -> PathBuf {\n349\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n350\t}\n351\tpub fn c_so() -> PathBuf {\n352\t    let p = crate_root().join(\"c_src/build/libpcre2.so\");\n353\t    assert!(p.exists(), \"build the C library first: {p:?}\");\n354\t    p\n355\t}\n356\tpub fn rust_so() -> PathBuf {\n357\t    let p = crate_root().join(\"target/release/libpcre2.so\");\n358\t    assert!(\n359\t        p.exists(),\n360\t        \"run `cargo build --release` first (tests load the release cdylib): {p:?}\"\n361\t    );\n362\t    p\n363\t}\n364\t\n365\t/// The two libraries under comparison.\n366\tpub struct Pair {\n367\t    pub c: Api,\n368\t    pub r: Api,\n369\t}\n370\t\n371\tpub fn pair() -> &'static Pair {\n372\t    use std::sync::OnceLock;\n373\t    static P: OnceLock<Pair> = OnceLock::new();\n374\t    P.get_or_init(|| unsafe {\n375\t        Pair {\n376\t            c: Api::load(&c_so()),\n377\t            r: Api::load(&rust_so()),\n378\t        }\n379\t    })\n380\t}\n381\t\n382\t// ------------------------------------------------------------------ utilities\n383\t\n384\t/// Deterministic xorshift PRNG so every test run is reproducible.\n385\tpub struct Rng(pub u64);\n386\timpl Rng {\n387\t    pub fn new(seed: u64) -> Rng {\n388\t        Rng(seed | 1)\n389\t    }\n390\t    pub fn next_u64(&mut self) -> u64 {\n391\t        let mut x = self.0;\n392\t        x ^= x << 13;\n393\t        x ^= x >> 7;\n394\t        x ^= x << 17;\n395\t        self.0 = x;\n396\t        x\n397\t    }\n398\t    pub fn below(&mut self, n: usize) -> usize {\n399\t        if n == 0 {\n400\t            0\n401\t        } else {\n402\t            (self.next_u64() % n as u64) as usize\n403\t        }\n404\t    }\n405\t    pub fn pick<'a, T>(&mut self, v: &'a [T]) -> &'a T {\n406\t        &v[self.below(v.len())]\n407\t    }\n408\t    pub fn byte(&mut self) -> u8 {\n409\t        (self.next_u64() >> 11) as u8\n410\t    }\n411\t    pub fn bool_(&mut self) -> bool {\n412\t        self.next_u64() & 1 == 1\n413\t    }\n414\t}\n415\t\n416\tpub fn cstr(s: &str) -> Vec<u8> {\n417\t    let mut v = s.as_bytes().to_vec();\n418\t    v.push(0);\n419\t    v\n420\t}\n421\t\n422\t/// A compiled pattern in one library plus its match data, for lock-step use.\n423\tpub struct Compiled<'a> {\n424\t    pub api: &'a Api,\n425\t    pub code: Ptr,\n426\t}\n427\timpl<'a> Compiled<'a> {\n428\t    pub unsafe fn new(\n429\t        api: &'a Api,\n430\t        pat: &[u8],\n431\t        opts: u32,\n432\t        ctx: Ptr,\n433\t    ) -> Result<Compiled<'a>, (c_int, Sz)> {\n434\t        let mut ec: c_int = 0;\n435\t        let mut eo: Sz = 0;\n436\t        let code = (api.compile)(pat.as_ptr(), pat.len(), opts, &mut ec, &mut eo, ctx);\n437\t        if code.is_null() {\n438\t            Err((ec, eo))\n439\t        } else {\n440\t            Ok(Compiled { api, code })\n441\t        }\n442\t    }\n443\t}\n444\timpl<'a> Drop for Compiled<'a> {\n445\t    fn drop(&mut self) {\n446\t        unsafe { (self.api.code_free)(self.code) }\n447\t    }\n448\t}\n449\t\n450\tpub const OVEC_INFO: u32 = consts::PCRE2_INFO_CAPTURECOUNT;\n451\t\n452\t/// Render bytes for assertion messages.\n453\tpub fn show(b: &[u8]) -> String {\n454\t    let mut s = String::new();\n455\t    for &c in b {\n456\t        if c.is_ascii_graphic() || c == b' ' {\n457\t            s.push(c as char)\n458\t        } else {\n459\t            s.push_str(&format!(\"\\\\x{c:02x}\"))\n460\t        }\n461\t    }\n462\t    s\n463\t}\n464\t\n465\tpub type Uchar = c_uchar;\n466\t"}]},"parent_tool_use_id":"toolu_bdrk_013NSMVc8SARPYNsPV2hp5jr","session_id":"aeab5d90-512d-4436-80fd-a67670a151c9","uuid":"b09fe147-7ce1-43b2-bbe8-5e561a90e4b5","timestamp":"2026-08-14T21:50:26.070Z","subagent_type":"general-purpose","task_description":"Write lowlevel internals diff test"}
