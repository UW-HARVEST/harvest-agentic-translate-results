= 2 &&\n10500\t         ptr[skipatstart] == CHAR_LEFT_PARENTHESIS &&\n10501\t         ptr[skipatstart+1] == CHAR_ASTERISK)\n10502\t    {\n10503\t    for (i = 0; i < sizeof(pso_list)/sizeof(pso); i++)\n10504\t      {\n10505\t      const pso *p = pso_list + i;\n10506\t\n10507\t      if (patlen - skipatstart - 2 >= p->length &&\n10508\t          PRIV(strncmp_c8)(ptr + skipatstart + 2, p->name, p->length) == 0)\n10509\t        {\n10510\t        uint32_t c, pp;\n10511\t\n10512\t        skipatstart += p->length + 2;\n10513\t        switch(p->type)\n10514\t          {\n10515\t          case PSO_OPT:\n10516\t          cb.external_options |= p->value;\n10517\t          break;\n10518\t\n10519\t          case PSO_XOPT:\n10520\t          xoptions |= p->value;\n10521\t          break;\n10522\t\n10523\t          case PSO_FLG:\n10524\t          setflags |= p->value;\n10525\t          break;\n10526\t\n10527\t          case PSO_NL:\n10528\t          newline = p->value;\n10529\t          setflags |= PCRE2_NL_SET;\n10530\t          break;\n10531\t\n10532\t          case PSO_BSR:\n10533\t          bsr = p->value;\n10534\t          setflags |= PCRE2_BSR_SET;\n10535\t          break;\n10536\t\n10537\t          case PSO_LIMM:\n10538\t          case PSO_LIMD:\n10539\t          case PSO_LIMH:\n10540\t          c = 0;\n10541\t          pp = skipatstart;\n10542\t          while (pp < patlen && IS_DIGIT(ptr[pp]))\n10543\t            {\n10544\t            if (c > UINT32_MAX / 10 - 1) break;   /* Integer overflow */\n10545\t            c = c*10 + (ptr[pp++] - CHAR_0);\n10546\t            }\n10547\t          if (pp >= patlen || pp == skipatstart || ptr[pp] != CHAR_RIGHT_PARENTHESIS)\n10548\t            {\n10549\t            errorcode = ERR60;\n10550\t            ptr += pp;\n10551\t            utf = FALSE;  /* Used by HAD_EARLY_ERROR */\n10552\t            goto HAD_EARLY_ERROR;\n10553\t            }\n10554\t          if (p->type == PSO_LIMH) limit_heap = c;\n10555\t            else if (p->type == 