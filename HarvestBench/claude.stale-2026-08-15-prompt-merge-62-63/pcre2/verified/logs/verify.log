ring_length_bynumber: FnSubLenByNumber = \"pcre2_substring_length_bynumber_8\";\n275\t    substring_nametable_scan: FnNametableScan = \"pcre2_substring_nametable_scan_8\";\n276\t    substring_number_from_name: FnNumberFromName = \"pcre2_substring_number_from_name_8\";\n277\t    substring_list_free: FnSubListFree = \"pcre2_substring_list_free_8\";\n278\t    substring_list_get: FnSubListGet = \"pcre2_substring_list_get_8\";\n279\t\n280\t    serialize_encode: FnSerEncode = \"pcre2_serialize_encode_8\";\n281\t    serialize_decode: FnSerDecode = \"pcre2_serialize_decode_8\";\n282\t    serialize_get_number_of_codes: FnSerNumCodes = \"pcre2_serialize_get_number_of_codes_8\";\n283\t    serialize_free: FnSerFree = \"pcre2_serialize_free_8\";\n284\t\n285\t    substitute: FnSubstitute = \"pcre2_substitute_8\";\n286\t\n287\t    pattern_convert: FnPatternConvert = \"pcre2_pattern_convert_8\";\n288\t    converted_pattern_free: FnConvertedFree = \"pcre2_converted_pattern_free_8\";\n289\t\n290\t    jit_compile: FnJitCompile = \"pcre2_jit_compile_8\";\n291\t    jit_match: FnJitMatch = \"pcre2_jit_match_8\";\n292\t    jit_free_unused_memory: FnJitFreeUnused = \"pcre2_jit_free_unused_memory_8\";\n293\t    jit_stack_create: FnJitStackCreate = \"pcre2_jit_stack_create_8\";\n294\t    jit_stack_assign: FnJitStackAssign = \"pcre2_jit_stack_assign_8\";\n295\t    jit_stack_free: FnJitStackFree = \"pcre2_jit_stack_free_8\";\n296\t    jit_get_size: FnJitGetSize = \"_pcre2_jit_get_size_8\";\n297\t    jit_get_target: FnJitGetTarget = \"_pcre2_jit_get_target_8\";\n298\t    jit_free: FnJitFree = \"_pcre2_jit_free_8\";\n299\t    jit_free_rodata: FnJitFreeRodata = \"_pcre2_jit_free_rodata_8\";\n300\t\n301\t    get_error_message: FnGetErrorMessage = \"pcre2_get_error_message_8\";\n302\t    maketables: FnMaketables = \"pcre2_maketables_8\";\n303\t    maketables_free: FnMaketablesFree = \"pcre2_maketables_free_8\";\n304\t\n305\t    valid_utf: FnValidUtf = \"_pcre2_valid_utf_8\";\n306\t    ord2utf: FnOrd2Utf = \"_pcre2_ord2utf_8\";\n307\t    strcmp: FnStrcmp = \"_pcre2_strcmp_8\";\n308\t    strcmp_c8: FnStrcmpC8 = \"_pcre2_strcmp_c8_8\";\n309\t    strncmp: FnStrncmp = \"_pcre2_strncmp_8\";\n310\t    strncmp_c8: FnStrncmpC8 = \"_pcre2_strncmp_c8_8\";\n311\t    strcpy_c8: FnStrcpyC8 = \"_pcre2_strcpy_c8_8\";\n312\t    strlen: FnStrlen = \"_pcre2_strlen_8\";\n313\t    ckd_smul: FnCkdSmul = \"_pcre2_ckd_smul_8\";\n314\t    is_newline: FnIsNewline = \"_pcre2_is_newline_8\";\n315\t    was_newline: FnWasNewline = \"_pcre2_was_newline_8\";\n316\t    extuni: FnExtuni = \"_pcre2_extuni_8\";\n317\t    script_run: FnScriptRun = \"_pcre2_script_run_8\";\n318\t    find_bracket: FnFindBracket = \"_pcre2_find_bracket_8\";\n319\t    xclass: FnXclass = \"_pcre2_xclass_8\";\n320\t    eclass: FnEclass = \"_pcre2_eclass_8\";\n321\t    update_classbits: FnUpdateClassbits = \"_pcre2_update_classbits_8\";\n322\t    memctl_malloc: FnMemctlMalloc = \"_pcre2_memctl_malloc_8\";\n323\t    get_hash_from_name: FnGetHashFromName = \"_pcre2_compile_get_hash_from_name8\";\n324\t}\n325\t\n326\timpl Api {\n327\t    /// Raw dlsym for symbols not in the typed table (data objects etc.).\n328\t    pub unsafe fn raw(&self, name: &str) -> *const u8 {\n329\t        let mut n = name.as_bytes().to_vec();\n330\t        n.push(0);\n331\t        let s: Symbol<*const u8> = self\n332\t            ._lib\n333\t            .get(&n)\n334\t            .unwrap_or_else(|e| panic!(\"missing symbol {name}: {e}\"));\n335\t        // Symbol<*const u8> derefs to the value; we want the address instead.\n336\t        s.try_as_raw_ptr().expect(\"symbol address\") as *const u8\n337\t    }\n338\t    pub unsafe fn try_raw(&self, name: &str) -> Option<*const u8> {\n339\t        let mut n = name.as_bytes().to_vec();\n340\t        n.push(0);\n341\t        let s: Result<Symbol<*const u8>, _> = self._lib.get(&n);\n342\t        s.ok()\n343\t            .and_then(|s| s.try_as_raw_ptr())\n344\t            .map(|p| p as *const u8)\n345\t    }\n346\t}\n347\t\n348\tpub fn crate_root() -> PathBuf {\n349\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n350\t}\n351\tpub fn c_so() -> PathBuf {\n352\t    let p = crate_root().join(\"c_src/build/libpcre2.so\");\n353\t    assert!(p.exists(), \"build the C library first: {p:?}\");\n354\t    p\n355\t}\n356\tpub fn rust_so() -> PathBuf {\n357\t    let p = crate_root().join(\"target/release/libpcre2.so\");\n358\t    assert!(\n359\t        p.exists(),\n360\t        \"run `cargo build --release` first (tests load the release cdylib): {p:?}\"\n361\t    );\n362\t    p\n363\t}\n364\t\n365\t/// The two libraries under comparison.\n366\tpub struct Pair {\n367\t    pub c: Api,\n368\t    pub r: Api,\n369\t}\n370\t\n371\tpub fn pair() -> &'static Pair {\n372\t    use std::sync::OnceLock;\n373\t    static P: OnceLock<Pair> = OnceLock::new();\n374\t    P.get_or_init(|| unsafe {\n375\t        Pair {\n376\t            c: Api::load(&c_so()),\n377\t            r: Api::load(&rust_so()),\n378\t        }\n379\t    })\n380\t}\n381\t\n382\t// ------------------------------------------------------------------ utilities\n383\t\n384\t/// Deterministic xorshift PRNG so every test run is reproducible.\n385\tpub struct Rng(pub u64);\n386\timpl Rng {\n387\t    pub fn new(seed: u64) -> Rng {\n388\t        Rng(seed | 1)\n389\t    }\n390\t    pub fn next_u64(&mut self) -> u64 {\n391\t        let mut x = self.0;\n392\t        x ^= x << 13;\n393\t        x ^= x >> 7;\n394\t        x ^= x << 17;\n395\t        self.0 = x;\n396\t        x\n397\t    }\n398\t    pub fn below(&mut self, n: usize) -> usize {\n399\t        if n == 0 {\n400\t            0\n401\t        } else {\n402\t            (self.next_u64() % n as u64) as usize\n403\t        }\n404\t    }\n405\t    pub fn pick<'a, T>(&mut self, v: &'a [T]) -> &'a T {\n406\t        &v[self.below(v.len())]\n407\t    }\n408\t    pub fn byte(&mut self) -> u8 {\n409\t        (self.next_u64() >> 11) as u8\n410\t    }\n411\t    pub fn bool_(&mut self) -> bool {\n412\t        self.next_u64() & 1 == 1\n413\t    }\n414\t}\n415\t\n416\tpub fn cstr(s: &str) -> Vec<u8> {\n417\t    let mut v = s.as_bytes().to_vec();\n418\t    v.push(0);\n419\t    v\n420\t}\n421\t\n422\t/// A compiled pattern in one library plus its match data, for lock-step use.\n423\tpub struct Compiled<'a> {\n424\t    pub api: &'a Api,\n425\t    pub code: Ptr,\n426\t}\n427\timpl<'a> Compiled<'a> {\n428\t    pub unsafe fn new(\n429\t        api: &'a Api,\n430\t        pat: &[u8],\n431\t        opts: u32,\n432\t        ctx: Ptr,\n433\t    ) -> Result<Compiled<'a>, (c_int, Sz)> {\n434\t        let mut ec: c_int = 0;\n435\t        let mut eo: Sz = 0;\n436\t        let code = (api.compile)(pat.as_ptr(), pat.len(), opts, &mut ec, &mut eo, ctx);\n437\t        if code.is_null() {\n438\t            Err((ec, eo))\n439\t        } else {\n440\t            Ok(Compiled { api, code })\n441\t        }\n442\t    }\n443\t}\n444\timpl<'a> Drop for Compiled<'a> {\n445\t    fn drop(&mut self) {\n446\t        unsafe { (self.api.code_free)(self.code) }\n447\t    }\n448\t}\n449\t\n450\tpub const OVEC_INFO: u32 = consts::PCRE2_INFO_CAPTURECOUNT;\n451\t\n452\t/// Render bytes for assertion messages.\n453\tpub fn show(b: &[u8]) -> String {\n454\t    let mut s = String::new();\n455\t    for &c in b {\n456\t        if c.is_ascii_graphic() || c == b' ' {\n457\t            s.push(c as char)\n458\t        } else {\n459\t            s.push_str(&format!(\"\\\\x{c:02x}\"))\n460\t        }\n461\t    }\n462\t    s\n463\t}\n464\t\n465\tpub type Uchar = c_uchar;\n466\t"}]},"parent_tool_use_id":"toolu_bdrk_01TRdAa52zmZ4H8aRPEchWK3","session_id":"aeab5d90-512d-4436-80fd-a67670a151c9","uuid":"aa7cbed3-0a9d-432a-900d-d7bfafccb278","timestamp":"2026-08-14T22:12:03.019Z","subagent_type":"general-purpose","task_description":"Write error-path diff tests (Table 1)"}
