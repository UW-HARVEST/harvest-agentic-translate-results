       panic!(\n                    \"{name}: scalar field bytes differ at +{}: C=0x{:02x} Rust=0x{:02x}\",\n                    off + at,\n                    cb[at],\n                    rb[at]\n                );\n            }\n        }\n    }\n}","newString":"/// The three default-context prototypes hold pointers whose values are\n/// library-local (`default_malloc`, `default_free`, `PRIV(default_tables)`), so\n/// compare the scalar regions only, using the layouts from\n/// `pcre2_intmodedep.h` (no SUPPORT_JIT in this build):\n///\n/// * `pcre2_real_compile_context`: memctl(0..24) stack_guard(24) guard_data(32)\n///   tables(40) then scalars at 48..80\n/// * `pcre2_real_match_context`: memctl(0..24) callout(24) callout_data(32)\n///   substitute_callout(40) sc_data(48) substitute_case_callout(56)\n///   scc_data(64) then scalars offset_limit(72) heap/match/depth limit(80..92)\n/// * `pcre2_real_convert_context`: memctl(0..24) then glob_separator(24),\n///   glob_escape(28)\n#[test]\nfn default_contexts_agree_on_scalar_fields() {\n    let p = pair();\n    let ranges: &[(&str, usize, usize)] = &[\n        (\"_pcre2_default_compile_context_8\", 48, 80),\n        (\"_pcre2_default_match_context_8\", 72, 92),\n        (\"_pcre2_default_convert_context_8\", 24, 32),\n    ];\n    unsafe {\n        for (name, from, to) in ranges {\n            let c = std::slice::from_raw_parts(p.c.raw(name).add(*from), to - from);\n            let r = std::slice::from_raw_parts(p.r.raw(name).add(*from), to - from);\n            assert_eq!(\n                show(c),\n                show(r),\n                \"{name}: scalar bytes [{from}..{to}) differ\"\n            );\n        }\n        // The pointer fields must at least be NULL / non-NULL identically.\n        for name in POINTER_BEARING {\n            if !name.ends_with(\"context_8\") {\n                continue;\n            }\n            let words = if name.contains(\"compile\") {\n                6\n            } else if name.contains(\"match\") {\n                9\n            } else {\n                3\n            };\n            for w in 0..words {\n                let cv = *(p.c.raw(name).add(w * 8) as *const usize);\n                let rv = *(p.r.raw(name).add(w * 8) as *const usize);\n                assert_eq!(\n                    cv == 0,\n                    rv == 0,\n                    \"{name}: pointer word {w} nullness differs (C={cv:#x} Rust={rv:#x})\"\n                );\n            }\n        }\n    }\n}","originalFile":"//! Phase D — symbol parity, and Phase B row 290: byte-for-byte parity of every\n//! exported data object.\nmod common;\n\nuse common::*;\nuse std::collections::BTreeMap;\nuse std::process::Command;\n\nfn nm(path: &std::path::Path) -> BTreeMap<String, (char, usize)> {\n    let out = Command::new(\"nm\")\n        .args([\"-D\", \"-S\", \"--defined-only\"])\n        .arg(path)\n        .output()\n        .expect(\"run nm\");\n    assert!(out.status.success(), \"nm failed on {path:?}\");\n    let mut m = BTreeMap::new();\n    for line in String::from_utf8_lossy(&out.stdout).lines() {\n        let f: Vec<&str> = line.split_whitespace().collect();\n        let (size, typ, name) = match f.len() {\n            4 => (usize::from_str_radix(f[1], 16).unwrap_or(0), f[2], f[3]),\n            3 => (0usize, f[1], f[2]),\n            _ => continue,\n        };\n        m.insert(name.to_string(), (typ.chars().next().unwrap(), size));\n    }\n    m\n}\n\n#[test]\nfn every_c_symbol_is_exported_by_rust() {\n    let c = nm(&c_so());\n    let r = nm(&rust_so());\n    let missing: Vec<&String> = c.keys().filter(|k| !r.contains_key(*k)).collect();\n    assert!(\n        missing.is_empty(),\n        \"{} C symbols missing from the Rust .so: {:?}\",\n        missing.len(),\n        missing\n    );\n    assert_eq!(c.len(), 143, \"unexpected C symbol count\");\n    // every symbol is loadable through dlsym in both libraries\n    let p = pair();\n    for name in c.keys() {\n        unsafe {\n            assert!(p.c.try_raw(name).is_some(), \"dlsym C {name}\");\n            assert!(p.r.try_raw(name).is_some(), \"dlsym Rust {name}\");\n        }\n    }\n}\n\n#[test]\nfn data_object_sizes_match() {\n    let c = nm(&c_so());\n    let r = nm(&rust_so());\n    let mut bad = vec![];\n    for (name, (typ, size)) in &c {\n        if matches!(typ, 'T' | 't' | 'W' | 'i') {\n            continue;\n        }\n        let (_rt, rsize) = r[name];\n        if *size != rsize {\n            bad.push(format!(\"{name}: C={size} Rust={rsize}\"));\n        }\n    }\n    assert!(bad.is_empty(), \"data size mismatches: {bad:#?}\");\n}\n\n/// Objects holding function pointers / library-local pointers cannot be compared\n/// bytewise (they legitimately point into different libraries).\nconst POINTER_BEARING: &[&str] = &[\n    \"_pcre2_default_compile_context_8\",\n    \"_pcre2_default_match_context_8\",\n    \"_pcre2_default_convert_context_8\",\n    // `const char *PRIV(unicode_version)` — a pointer variable; its *target*\n    // is compared in `unicode_version_string_matches`.\n    \"_pcre2_unicode_version_8\",\n];\n\n#[test]\nfn unicode_version_string_matches() {\n    let p = pair();\n    unsafe {\n        let deref = |api: &Api| -> Vec<u8> {\n            let pp = api.raw(\"_pcre2_unicode_version_8\") as *const *const u8;\n            let s = *pp;\n            let mut v = vec![];\n            let mut i = 0;\n            while *s.add(i) != 0 {\n                v.push(*s.add(i));\n                i += 1;\n            }\n            v\n        };\n        assert_eq!(\n            show(&deref(&p.c)),\n            show(&deref(&p.r)),\n            \"_pcre2_unicode_version_8 string differs\"\n        );\n    }\n}\n\n#[test]\nfn data_objects_are_byte_identical() {\n    let c = nm(&c_so());\n    let r = nm(&rust_so());\n    let p = pair();\n    let mut compared = 0;\n    let mut diffs = vec![];\n    for (name, (typ, size)) in &c {\n        if matches!(typ, 'T' | 't' | 'W' | 'i') || POINTER_BEARING.contains(&name.as_str()) {\n            continue;\n        }\n        let (_rt, rsize) = r[name];\n        let n = (*size).min(rsize);\n        if n == 0 {\n            continue;\n        }\n        unsafe {\n            let cp = p.c.raw(name);\n            let rp = p.r.raw(name);\n            let cb = std::slice::from_raw_parts(cp, n);\n            let rb = std::slice::from_raw_parts(rp, n);\n            if cb != rb {\n                let at = cb.iter().zip(rb).position(|(a, b)| a != b).unwrap();\n                diffs.push(format!(\n                    \"{name}: {n} bytes, first difference at offset {at}: C=0x{:02x} Rust=0x{:02x}\",\n                    cb[at], rb[at]\n                ));\n            }\n        }\n        compared += 1;\n    }\n    assert!(compared >= 25, \"only compared {compared} data objects\");\n    assert!(diffs.is_empty(), \"data content mismatches: {diffs:#?}\");\n}\n\n/// The three context prototypes: compare every field except the malloc/free\n/// function pointers and the `tables` pointer, whose values are library-local.\n#[test]\nfn default_contexts_agree_on_scalar_fields() {\n    let p = pair();\n    unsafe {\n        // pcre2_real_compile_context: memctl{malloc,free,data}, tables,\n        // max_pattern_length, max_pattern_compiled_length, max_varlookbehind,\n        // bsr_convention, newline_convention, parens_nest_limit, extra_options,\n        // optimization_flags, stack_guard, stack_guard_data\n        // Compare the scalar tail after the 4 pointers (3 memctl + tables).\n        let off = 4 * std::mem::size_of::<usize>();\n        for name in POINTER_BEARING {\n            let c = p.c.raw(name);\n            let r = p.r.raw(name);\n            let size = 12 * std::mem::size_of::<usize>();\n            let cb = std::slice::from_raw_parts(c.add(off), size - off - 2 * 8);\n            let rb = std::slice::from_raw_parts(r.add(off), size - off - 2 * 8);\n            // Only meaningful for the compile/convert contexts, whose scalar\n            // fields are all non-pointer; the match context ends with pointers\n            // so we stop before its final two words (already excluded above).\n            if cb != rb {\n                let at = cb.iter().zip(rb).position(|(a, b)| a != b).unwrap();\n                panic!(\n                    \"{name}: scalar field bytes differ at +{}: C=0x{:02x} Rust=0x{:02x}\",\n                    off + at,\n                    cb[at],\n                    rb[at]\n                );\n            }\n        }\n    }\n}\n","structuredPatch":[{"oldStart":134,"oldLines":34,"newStart":134,"newLines":55,"lines":["     assert!(diffs.is_empty(), \"data content mismatches: {diffs:#?}\");"," }"," ","-/// The three context prototypes: compare every field except the malloc/free","-/// function pointers and the `tables` pointer, whose values are library-local.","+/// The three default-context prototypes hold pointers whose values are","+/// library-local (`default_malloc`, `default_free`, `PRIV(default_tables)`), so","+/// compare the scalar regions only, using the layouts from","+/// `pcre2_intmodedep.h` (no SUPPORT_JIT in this build):","+///","+/// * `pcre2_real_compile_context`: memctl(0..24) stack_guard(24) guard_data(32)","+///   tables(40) then scalars at 48..80","+/// * `pcre2_real_match_context`: memctl(0..24) callout(24) callout_data(32)","+///   substitute_callout(40) sc_data(48) substitute_case_callout(56)","+///   scc_data(64) then scalars offset_limit(72) heap/match/depth limit(80..92)","+/// * `pcre2_real_convert_context`: memctl(0..24) then glob_separator(24),","+///   glob_escape(28)"," #[test]"," fn default_contexts_agree_on_scalar_fields() {","     let p = pair();","+    let ranges: &[(&str, usize, usize)] = &[","+        (\"_pcre2_default_compile_context_8\", 48, 80),","+        (\"_pcre2_default_match_context_8\", 72, 92),","+        (\"_pcre2_default_convert_context_8\", 24, 32),","+    ];","     unsafe {","-        //