{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_bdrk_5hwhihxldns6xmidue5jeglbbwrdf7hbslpposnbrkzwt5ml6abq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_011ZYLSq1Gh8GpijukPcX77a","name":"Write","input":{"file_path":"/local/home/scheschb/.harvest/work/harvest-work-GdDnk6/translated_rust/tests/lowlevel.rs","content":"//! Differential tests for the low-level (`PRIV(...)`) exports of PCRE2.\n//!\n//! Every test calls the same function in the C library (`p.c`) and in the Rust\n//! library (`p.r`) with byte-identical inputs and compares *all* observable\n//! results: the return value, every output parameter and every written byte.\n//!\n//! Safety notes (derived from the C sources in `c_src/src`):\n//!   * `PRIV(strncmp)`/`PRIV(strncmp_c8)` do **not** stop at a NUL, so all\n//!     comparison buffers are fully initialised for at least `n` bytes.\n//!   * `PRIV(compile_get_hash_from_name)` reads `name[length - 1]`, so a length\n//!     of 0 reads `name[-1]`; we therefore hand it a pointer one byte inside an\n//!     initialised buffer (still in-bounds, deterministic for both libraries).\n//!   * `PRIV(is_newline)` requires `ptr < endptr`, `PRIV(was_newline)` requires\n//!     `ptr > startptr`; in UTF mode `GETCHAR`/`BACKCHAR` are unchecked, so UTF\n//!     subjects only ever contain complete sequences and never start with a\n//!     continuation byte.\n//!   * `PRIV(ord2utf)` may write up to 6 code units, so the buffer is 8 bytes.\n//!   * `PRIV(ckd_smul)` asserts `a >= 0 && b >= 0` and takes `int`s, so only\n//!     values in `0 ..= i32::MAX` are used.\n//!   * `PRIV(memctl_malloc)` writes a `pcre2_memctl` (24 bytes) into the block\n//!     it obtains, so the test allocator always over-allocates (this makes the\n//!     `size == 0` case well defined).\n\n#![allow(clippy::too_many_arguments)]\n\nmod common;\nuse common::consts::*;\nuse common::*;\n\nuse std::ffi::c_void;\nuse std::os::raw::{c_char, c_int};\nuse std::ptr;\nuse std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};\n\n// ---------------------------------------------------------------------------\n// helpers\n// ---------------------------------------------------------------------------\n\n/// Encode one Unicode scalar as UTF-8 (input must not be a surrogate).\nfn utf8_push(cp: u32, out: &mut Vec<u8>) {\n    if cp < 0x80 {\n        out.push(cp as u8);\n    } else if cp < 0x800 {\n        out.push(0xc0 | (cp >> 6) as u8);\n        out.push(0x80 | (cp & 0x3f) as u8);\n    } else if cp < 0x10000 {\n        out.push(0xe0 | (cp >> 12) as u8);\n        out.push(0x80 | ((cp >> 6) & 0x3f) as u8);\n        out.push(0x80 | (cp & 0x3f) as u8);\n    } else {\n        out.push(0xf0 | (cp >> 18) as u8);\n        out.push(0x80 | ((cp >> 12) & 0x3f) as u8);\n        out.push(0x80 | ((cp >> 6) & 0x3f) as u8);\n        out.push(0x80 | (cp & 0x3f) as u8);\n    }\n}\n\nfn utf8_of(cps: &[u32]) -> Vec<u8> {\n    let mut v = Vec::new();\n    for &c in cps {\n        utf8_push(c, &mut v);\n    }\n    v\n}\n\n/// Decode the (valid) UTF-8 character at `s[i]`; returns (code point, length).\nfn decode_utf8(s: &[u8], i: usize) -> (u32, usize) {\n    let b = s[i];\n    if b < 0xc0 {\n        return (b as u32, 1);\n    }\n    let n = if b < 0xe0 {\n        2\n    } else if b < 0xf0 {\n        3\n    } else {\n        4\n    };\n    assert!(i + n <= s.len(), \"truncated utf8 at {i} in {}\", show(s));\n    let mut c = (b as u32) & (0x7f >> n);\n    for k in 1..n {\n        c = (c << 6) | ((s[i + k] as u32) & 0x3f);\n    }\n    (c, n)\n}\n\n/// Offsets at which a character starts, for a valid UTF-8 string.\nfn char_starts(s: &[u8]) -> Vec<usize> {\n    let mut v = Vec::new();\n    let mut i = 0;\n    while i < s.len() {\n        v.push(i);\n        i += decode_utf8(s, i).1;\n    }\n    v\n}\n\n/// Render an optional pointer as an offset from `base`.\nfn off_of(p: *const u8, base: *const u8) -> Option<usize> {\n    if p.is_null() {\n        None\n    } else {\n        Some(p as usize - base as usize)\n    }\n}\n\n// --------------------------- compiled-code layout --------------------------\n//\n// `pcre2_real_code` (pcre2_intmodedep.h):\n//   pcre2_memctl memctl;      /* 24 bytes: 2 fn ptrs + void* */\n//   const uint8_t *tables;    /* +24 */\n//   void *executable_jit;     /* +32 */\n//   uint8_t start_bitmap[32]; /* +40 */\n//   PCRE2_SIZE blocksize;     /* +72 */\n//   PCRE2_SIZE code_start;    /* +80 */\n//   ...                       /* sizeof == 152 on LP64 */\n//\n// `codestart = (uint8_t *)re + re->code_start` (pcre2_compile.c), and the\n// byte-code is preceded by the name table plus (4-byte aligned) the encoded\n// character lists.  `PCRE2_INFO_NAMETABLE` yields `re + sizeof(pcre2_real_code)`\n// and `PCRE2_INFO_SIZE` yields `re->blocksize`, which lets us *verify* the two\n// field offsets at run time in each library before trusting them.\nconst OFF_BLOCKSIZE: usize = 72;\nconst OFF_CODE_START: usize = 80;\n\nstruct Layout {\n    base: *const u8,\n    codestart: *const u8,\n    blocksize: usize,\n    code_start: usize,\n    namecount: u32,\n    nameentrysize: u32,\n}\n\nunsafe fn layout(api: &Api, code: Ptr, what: &str) -> Layout {\n    let base = code as *const u8;\n\n    let mut bs: Sz = 0;\n    assert_eq!(\n        (api.pattern_info)(code, PCRE2_INFO_SIZE, &mut bs as *mut Sz as *mut c_void),\n        0\n    );\n    let mut nt: *const u8 = ptr::null();\n    assert_eq!(\n        (api.pattern_info)(\n            code,\n            PCRE2_INFO_NAMETABLE,\n            &mut nt as *mut *const u8 as *mut c_void\n        ),\n        0\n    );\n    let mut nc: u32 = 0;\n    assert_eq!(\n        (api.pattern_info)(code, PCRE2_INFO_NAMECOUNT, &mut nc as *mut u32 as *mut c_void),\n        0\n    );\n    let mut nes: u32 = 0;\n    assert_eq!(\n        (api.pattern_info)(\n            code,\n            PCRE2_INFO_NAMEENTRYSIZE,\n            &mut nes as *mut u32 as *mut c_void\n        ),\n        0\n    );\n\n    let structsz = nt as usize - base as usize;\n    assert_eq!(\n        structsz, 152,\n        \"{what}: unexpected sizeof(pcre2_real_code) = {structsz}\"\n    );\n    let raw_bs = *(base.add(OFF_BLOCKSIZE) as *const usize);\n    assert_eq!(\n        raw_bs, bs,\n        \"{what}: blocksize field is not at offset {OFF_BLOCKSIZE} \\\n         (field={raw_bs}, PCRE2_INFO_SIZE={bs}) - struct layout assumption broken\"\n    );\n    let cs = *(base.add(OFF_CODE_START) as *const usize);\n    assert!(\n        cs >= structsz && cs < bs,\n        \"{what}: implausible code_start={cs} (blocksize={bs}, structsz={structsz})\"\n    );\n\n    Layout {\n        base,\n        codestart: base.add(cs),\n        blocksize: bs,\n        code_start: cs,\n        namecount: nc,\n        nameentrysize: nes,\n    }\n}\n\n/// Compile `pat` in both libraries and check that the generated byte code (and\n/// the character-list area that precedes it) is byte-identical, so that direct\n/// calls into the low-level matchers are comparing like with like.\nstruct BothCodes<'a> {\n    c: Compiled<'a>,\n    r: Compiled<'a>,\n    lc: Layout,\n    lr: Layout,\n}\n\nunsafe fn compile_both(pat: &[u8], opts: u32) -> BothCodes<'static> {\n    let p = pair();\n    let c = Compiled::new(&p.c, pat, opts, ptr::null_mut())\n        .unwrap_or_else(|e| panic!(\"C failed to compile {:?}: err {} at {}\", show(pat), e.0, e.1));\n    let r = Compiled::new(&p.r, pat, opts, ptr::null_mut())\n        .unwrap_or_else(|e| panic!(\"Rust failed to compile {:?}: err {} at {}\", show(pat), e.0, e.1));\n    let lc = layout(&p.c, c.code, \"C\");\n    let lr = layout(&p.r, r.code, \"Rust\");\n    assert_eq!(\n        (lc.blocksize, lc.code_start, lc.namecount, lc.nameentrysize),\n        (lr.blocksize, lr.code_start, lr.namecount, lr.nameentrysize),\n        \"pattern {:?}: layout differs (C: size={} code_start={} nc={} nes={}; \\\n         Rust: size={} code_start={} nc={} nes={})\",\n        show(pat),\n        lc.blocksize,\n        lc.code_start,\n        lc.namecount,\n        lc.nameentrysize,\n        lr.blocksize,\n        lr.code_start,\n        lr.namecount,\n        lr.nameentrysize\n    );\n\n    // Compare char-lists + byte code.  Skip the 0..3 alignment padding bytes\n    // between the name table and the char lists: they are never written.\n    let nt_end = 152 + (lc.namecount as usize) * (lc.nameentrysize as usize);\n    let from = (nt_end + 3) & !3usize;\n    let from = from.min(lc.code_start);\n    let cb = std::slice::from_raw_parts(lc.base.add(from), lc.blocksize - from);\n    let rb = std::slice::from_raw_parts(lr.base.add(from), lr.blocksize - from);\n    assert_eq!(\n        cb,\n        rb,\n        \"pattern {:?}: compiled byte code differs from offset {from}\\n C: {}\\n R: {}\",\n        show(pat),\n        show(cb),\n        show(rb)\n    );\n\n    BothCodes { c, r, lc, lr }\n}\n\n// ---------------------------------------------------------------------------\n// 1. pcre2_string_utils.c\n// ---------------------------------------------------------------------------\n\n/// Buffer of `total` fully-initialised bytes holding a NUL-terminated string of\n/// length `slen`.  Bytes after the NUL are initialised too, so `strncmp` with\n/// `n > slen` never reads uninitialised/out-of-bounds memory.\nfn mkbuf(rng: &mut Rng, slen: usize, total: usize, high_only: bool) -> Vec<u8> {\n    let mut v = Vec::with_capacity(total);\n    for _ in 0..slen {\n        let mut b = rng.byte();\n        if high_only {\n            b |= 0x80;\n        }\n        if b == 0 {\n            b = 1;\n        }\n        v.push(b);\n    }\n    v.push(0);\n    while v.len() < total {\n        v.push(rng.byte());\n    }\n    v\n}\n\n#[test]\nfn t01_string_utils() {\n    let p = pair();\n    const TOTAL: usize = 40;\n    let mut rng = Rng::new(0x5111_0001);\n    let mut cases: Vec<(Vec<u8>, Vec<u8>)> = Vec::new();\n\n    // ---- hand-picked boundary cases ----\n    let fill = |s: &[u8]| -> Vec<u8> {\n        let mut v = s.to_vec();\n        v.push(0);\n        while v.len() < TOTAL {\n            v.push(0x5a);\n        }\n        v\n    };\n    let hand: &[(&[u8], &[u8])] = &[\n        (b\"\", b\"\"),\n        (b\"\", b\"a\"),\n        (b\"a\", b\"\"),\n        (b\"a\", b\"a\"),\n        (b\"a\", b\"b\"),\n        (b\"b\", b\"a\"),\n        (b\"abc\", b\"abc\"),\n        (b\"abc\", b\"abd\"),\n        (b\"abd\", b\"abc\"),\n        (b\"abc\", b\"ab\"),\n        (b\"ab\", b\"abc\"),\n        (b\"abc\", b\"abcd\"),\n        (b\"\\x7f\", b\"\\x80\"),\n        (b\"\\x80\", b\"\\x7f\"),\n        (b\"\\xff\", b\"\\xfe\"),\n        (b\"\\xfe\", b\"\\xff\"),\n        (b\"\\x80\\x81\\x82\", b\"\\x80\\x81\\x82\"),\n        (b\"\\x80\\x81\\x82\", b\"\\x80\\x81\\x83\"),\n        (b\"\\xff\\xff\\xff\\xff\", b\"\\xff\\xff\\xff\"),\n        (b\"A\", b\"a\"),\n        (b\"z\", b\"Z\"),\n        (b\"hello world\", b\"hello worlds\"),\n        (b\"\\x01\", b\"\\x02\"),\n        (b\"same\", b\"same\"),\n    ];\n    for (a, b) in hand {\n        cases.push((fill(a), fill(b)));\n    }\n\n    // ---- randomized cases ----\n    const N_RAND: usize = 3000;\n    for _ in 0..N_RAND {\n        let kind = rng.below(6);\n        let l1 = rng.below(TOTAL - 1);\n        let s1 = mkbuf(&mut rng, l1, TOTAL, kind == 5);\n        let s2 = match kind {\n            1 => s1.clone(),\n            2 => {\n                // prefix of s1\n                let mut v = s1.clone();\n                let cut = if l1 == 0 { 0 } else { rng.below(l1) };\n                v[cut] = 0;\n                v\n            }\n            3 => {\n                // one byte changed\n                let mut v = s1.clone();\n                let i = rng.below(TOTAL);\n                v[i] = v[i].wrapping_add(1 + rng.byte() % 3);\n                v\n            }\n            4 => mkbuf(&mut rng, 0, TOTAL, false),\n            _ => mkbuf(&mut rng, rng.below(TOTAL - 1), TOTAL, kind == 5),\n        };\n        cases.push((s1, s2));\n    }\n\n    let mut ncmp = 0usize;\n    for (s1, s2) in &cases {\n        unsafe {\n            // ---------------- strlen ----------------\n            for s in [s1, s2] {\n                let c = (p.c.strlen)(s.as_ptr());\n                let r = (p.r.strlen)(s.as_ptr());\n                assert_eq!(\n                    c,\n                    r,\n                    \"strlen(\\\"{}\\\"): C={c} Rust={r}\",\n                    show(&s[..s.iter().position(|&b| b == 0).unwrap_or(s.len())])\n                );\n            }\n\n            let l1 = (p.c.strlen)(s1.as_ptr());\n            let l2 = (p.c.strlen)(s2.as_ptr());\n\n            // ---------------- strcmp / strcmp_c8 ----------------\n            let c = (p.c.strcmp)(s1.as_ptr(), s2.as_ptr());\n            let r = (p.r.strcmp)(s1.as_ptr(), s2.as_ptr());\n            assert_eq!(\n                c,\n                r,\n                \"strcmp(\\\"{}\\\", \\\"{}\\\"): C={c} Rust={r}\",\n                show(&s1[..l1]),\n                show(&s2[..l2])\n            );\n            assert!(c == 0 || c == 1 || c == -1, \"strcmp returned {c}\");\n\n            let c8c = (p.c.strcmp_c8)(s1.as_ptr(), s2.as_ptr() as *const c_char);\n            let c8r = (p.r.strcmp_c8)(s1.as_ptr(), s2.as_ptr() as *const c_char);\n            assert_eq!(\n                c8c,\n                c8r,\n                \"strcmp_c8(\\\"{}\\\", \\\"{}\\\"): C={c8c} Rust={c8r}\",\n                show(&s1[..l1]),\n                show(&s2[..l2])\n            );\n\n            // ---------------- strncmp / strncmp_c8 ----------------\n            // n = 0, shorter than both, exactly each length, longer than both.\n            let mut ns = vec![0usize, 1, l1, l2, l1 + 1, l2 + 1, TOTAL / 2, TOTAL];\n            ns.push(l1.min(l2));\n            ns.push(l1.max(l2) + 2);\n            ns.retain(|&n| n <= TOTAL);\n            ns.sort_unstable();\n            ns.dedup();\n            for &n in &ns {\n                let c = (p.c.strncmp)(s1.as_ptr(), s2.as_ptr(), n);\n                let r = (p.r.strncmp)(s1.as_ptr(), s2.as_ptr(), n);\n                assert_eq!(\n                    c,\n                    r,\n                    \"strncmp(<{}>, <{}>, {n}): C={c} Rust={r}\",\n                    show(&s1[..n]),\n                    show(&s2[..n])\n                );\n                let c8 = (p.c.strncmp_c8)(s1.as_ptr(), s2.as_ptr() as *const c_char, n);\n                let r8 = (p.r.strncmp_c8)(s1.as_ptr(), s2.as_ptr() as *const c_char, n);\n                assert_eq!(\n                    c8,\n                    r8,\n                    \"strncmp_c8(<{}>, <{}>, {n}): C={c8} Rust={r8}\",\n                    show(&s1[..n]),\n                    show(&s2[..n])\n                );\n                ncmp += 1;\n            }\n\n            // ---------------- strcpy_c8 ----------------\n            let mut dc = [0xaau8; 64];\n            let mut dr = [0xaau8; 64];\n            let rc = (p.c.strcpy_c8)(dc.as_mut_ptr(), s1.as_ptr() as *const c_char);\n            let rr = (p.r.strcpy_c8)(dr.as_mut_ptr(), s1.as_ptr() as *const c_char);\n            assert_eq!(\n                rc,\n                rr,\n                \"strcpy_c8(\\\"{}\\\") length: C={rc} Rust={rr}\",\n                show(&s1[..l1])\n            );\n            assert_eq!(\n                &dc[..],\n                &dr[..],\n                \"strcpy_c8(\\\"{}\\\") bytes:\\n C: {}\\n R: {}\",\n                show(&s1[..l1]),\n                show(&dc),\n                show(&dr)\n            );\n            assert_eq!(rc, l1, \"strcpy_c8 returned {rc}, strlen is {l1}\");\n        }\n    }\n    eprintln!(\n        \"t01_string_utils: {} string pairs ({} strncmp lengths)\",\n        cases.len(),\n        ncmp\n    );\n}\n\n// ---------------------------------------------------------------------------\n// 2. pcre2_chkdint.c\n// ---------------------------------------------------------------------------\n\n#[test]\nfn t02_ckd_smul() {\n    let p = pair();\n    // HAVE_BUILTIN_MUL_OVERFLOW is *not* defined in this build (see\n    // c_src/CMakeLists.txt / config.h), so the C code computes\n    //     m = (int64_t)a * (int64_t)b\n    // and the overflow test is `sizeof(m) > sizeof(*r) && m > PCRE2_SIZE_MAX`,\n    // whose first term is false on LP64 (8 > 8).  Hence C can never report\n    // overflow, and `*r` is always the (never-overflowing, because\n    // 0 <= a,b <= INT_MAX) 64-bit product.\n    let mut vals: Vec<i32> = vec![\n        0,\n        1,\n        2,\n        3,\n        255,\n        256,\n        1000,\n        0xffff,\n        0x10000,\n        46340,\n        46341, // 46341^2 > INT32_MAX\n        0x3fff_ffff,\n        0x4000_0000,\n        0x7fff_fffe,\n        0x7fff_ffff, // INT_MAX: INT_MAX*INT_MAX is the largest product C accepts\n    ];\n    let mut rng = Rng::new(0x5111_0002);\n    const N_RAND: usize = 800;\n    for _ in 0..N_RAND {\n        vals.push((rng.next_u64() & 0x7fff_ffff) as i32);\n    }\n\n    let mut n = 0usize;\n    for (i, &a) in vals.iter().enumerate() {\n        for &b in vals.iter().skip(i).take(20) {\n            for (a, b) in [(a, b), (b, a)] {\n                unsafe {\n                    const SENT: Sz = 0xa5a5_a5a5_a5a5_a5a5;\n                    let mut rc: Sz = SENT;\n                    let mut rr: Sz = SENT;\n                    let cret = (p.c.ckd_smul)(&mut rc, a as u32 as Sz, b as u32 as Sz);\n                    let rret = (p.r.ckd_smul)(&mut rr, a as u32 as Sz, b as u32 as Sz);\n                    assert_eq!(\n                        (cret, rc),\n                        (rret, rr),\n                        \"ckd_smul(a={a}, b={b}): C=(ret {cret}, *r {rc}) Rust=(ret {rret}, *r {rr})\"\n                    );\n                    // The maths the C actually performs.\n                    let want = (a as i64) * (b as i64);\n                    assert_eq!(cret, 0, \"C reported overflow for a={a} b={b}\");\n                    assert_eq!(rc as u64, want as u64, \"C product wrong for a={a} b={b}\");\n                    n += 1;\n                }\n            }\n        }\n    }\n    eprintln!(\"t02_ckd_smul: {n} (a,b) pairs\");\n}\n\n// ---------------------------------------------------------------------------\n// 3. pcre2_ord2utf.c\n// ---------------------------------------------------------------------------\n\n#[test]\nfn t03_ord2utf() {\n    let p = pair();\n    let mut n = 0usize;\n    let mut check = |cp: u32| unsafe {\n        let mut bc = [0x5au8; 8];\n        let mut br = [0x5au8; 8];\n        let lc = (p.c.ord2utf)(cp, bc.as_mut_ptr());\n        let lr = (p.r.ord2utf)(cp, br.as_mut_ptr());\n        assert_eq!(\n            lc, lr,\n            \"ord2utf(0x{cp:x}) length: C={lc} Rust={lr} (C bytes {}, Rust bytes {})\",\n            show(&bc),\n            show(&br)\n        );\n        assert_eq!(\n            &bc[..],\n            &br[..],\n            \"ord2utf(0x{cp:x}) bytes: C={} Rust={}\",\n            show(&bc),\n            show(&br)\n        );\n        n += 1;\n    };\n\n    // Every boundary named in the task, plus the whole surrogate block.\n    for cp in [\n        0u32, 1, 0x7e, 0x7f, 0x80, 0x81, 0x7fe, 0x7ff, 0x800, 0x801, 0xfffe, 0xffff, 0x10000,\n        0x10001, 0x10fffe, 0x10ffff,\n    ] {\n        check(cp);\n    }\n    // Exhaustive over the whole Unicode range (includes surrogates\n    // 0xd800..0xdfff, which PRIV(ord2utf) encodes without complaint).\n    for cp in 0..=0x10ffffu32 {\n        check(cp);\n    }\n    // The C also accepts (and encodes as 5/6 bytes) values up to 0x7fffffff.\n    for cp in [\n        0x110000u32,\n        0x1fffff,\n        0x200000,\n        0x3ffffff,\n        0x4000000,\n        0x7fffffff,\n    ] {\n        check(cp);\n    }\n    let mut rng = Rng::new(0x5111_0003);\n    for _ in 0..2000 {\n        check((rng.next_u64() & 0x7fff_ffff) as u32);\n    }\n    eprintln!(\"t03_ord2utf: {n} code points\");\n}\n\n// ---------------------------------------------------------------------------\n// 4. pcre2_valid_utf.c\n// ---------------------------------------------------------------------------\n\n#[test]\nfn t04_valid_utf() {\n    let p = pair();\n    const SENT: Sz = 0xdead_beef_dead_beef;\n    let mut seen: Vec<i32> = Vec::new();\n    let mut n = 0usize;\n\n    let mut check = |s: &[u8], label: &str, seen: &mut Vec<i32>| unsafe {\n        let mut oc: Sz = SENT;\n        let mut or: Sz = SENT;\n        let cret = (p.c.valid_utf)(s.as_ptr(), s.len(), &mut oc);\n        let rret = (p.r.valid_utf)(s.as_ptr(), s.len(), &mut or);\n        assert_eq!(\n            (cret, oc),\n            (rret, or),\n            \"valid_utf(<{}>, len {}) [{label}]: C=(ret {cret}, off {}) Rust=(ret {rret}, off {})\",\n            show(s),\n            s.len(),\n            if oc == SENT { -1i64 } else { oc as i64 },\n            if or == SENT { -1i64 } else { or as i64 }\n        );\n        if cret == 0 {\n            assert_eq!(oc, SENT, \"valid_utf wrote erroroffset on success\");\n        }\n        if !seen.contains(&cret) {\n            seen.push(cret);\n        }\n        n += 1;\n    };\n\n    // ---------------- valid sequences of every length ----------------\n    let valid: &[&[u8]] = &[\n        b\"\",\n        b\"a\",\n        b\"\\x00\",\n        b\"abc\\x00def\",\n        b\"\\x7f\",\n        b\"\\xc2\\x80\",         // U+0080, shortest 2-byte\n        b\"\\xdf\\xbf\",         // U+07FF, longest 2-byte\n        b\"\\xe0\\xa0\\x80\",     // U+0800, shortest 3-byte\n        b\"\\xed\\x9f\\xbf\",     // U+D7FF, just below surrogates\n        b\"\\xee\\x80\\x80\",     // U+E000, just above surrogates\n        b\"\\xef\\xbf\\xbf\",     // U+FFFF\n        b\"\\xf0\\x90\\x80\\x80\", // U+10000, shortest 4-byte\n        b\"\\xf4\\x8f\\xbf\\xbf\", // U+10FFFF, largest\n        b\"a\\xc2\\x80b\\xe0\\xa0\\x80c\\xf0\\x90\\x80\\x80d\",\n    ];\n    for s in valid {\n        check(s, \"valid\", &mut seen);\n    }\n\n    // ---------------- one case per PCRE2_ERROR_UTF8_ERRn ----------------\n    // (numbers refer to the table at the top of pcre2_valid_utf.c)\n    let bad: &[(&[u8], i32, usize, &str)] = &[\n        // ERR1..ERR5: missing 1..5 bytes at the end of the string.\n        (b\"a\\xc2\", PCRE2_ERROR_UTF8_ERR1, 1, \"2-byte truncated by 1\"),\n        (b\"a\\xe0\\xa0\", PCRE2_ERROR_UTF8_ERR1, 1, \"3-byte truncated by 1\"),\n        (b\"a\\xe0\", PCRE2_ERROR_UTF8_ERR2, 1, \"3-byte truncated by 2\"),\n        (b\"\\xf0\\x90\\x80\", PCRE2_ERROR_UTF8_ERR1, 0, \"4-byte truncated by 1\"),\n        (b\"\\xf0\\x90\", PCRE2_ERROR_UTF8_ERR2, 0, \"4-byte truncated by 2\"),\n        (b\"\\xf0\", PCRE2_ERROR_UTF8_ERR3, 0, \"4-byte truncated by 3\"),\n        (b\"\\xf8\\x88\\x80\\x80\", PCRE2_ERROR_UTF8_ERR1, 0, \"5-byte truncated by 1\"),\n        (b\"\\xf8\", PCRE2_ERROR_UTF8_ERR4, 0, \"5-byte truncated by 4\"),\n        (b\"\\xfc\\x84\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR1, 0, \"6-byte truncated by 1\"),\n        (b\"\\xfc\", PCRE2_ERROR_UTF8_ERR5, 0, \"6-byte truncated by 5\"),\n        // ERR6..ERR10: byte 2..6 does not have top bits 10.\n        (b\"\\xc2\\x41\", PCRE2_ERROR_UTF8_ERR6, 0, \"bad 2nd byte (2-byte)\"),\n        (b\"\\xc2\\xc2\", PCRE2_ERROR_UTF8_ERR6, 0, \"bad 2nd byte (c2)\"),\n        (b\"\\xe0\\x41\\x80\", PCRE2_ERROR_UTF8_ERR6, 0, \"bad 2nd byte (3-byte)\"),\n        (b\"\\xe0\\xa0\\x41\", PCRE2_ERROR_UTF8_ERR7, 0, \"bad 3rd byte (3-byte)\"),\n        (b\"\\xf0\\x90\\x41\\x80\", PCRE2_ERROR_UTF8_ERR7, 0, \"bad 3rd byte (4-byte)\"),\n        (b\"\\xf0\\x90\\x80\\x41\", PCRE2_ERROR_UTF8_ERR8, 0, \"bad 4th byte (4-byte)\"),\n        (b\"\\xf8\\x88\\x41\\x80\\x80\", PCRE2_ERROR_UTF8_ERR7, 0, \"bad 3rd byte (5-byte)\"),\n        (b\"\\xf8\\x88\\x80\\x41\\x80\", PCRE2_ERROR_UTF8_ERR8, 0, \"bad 4th byte (5-byte)\"),\n        (b\"\\xf8\\x88\\x80\\x80\\x41\", PCRE2_ERROR_UTF8_ERR9, 0, \"bad 5th byte (5-byte)\"),\n        (b\"\\xfc\\x84\\x41\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR7, 0, \"bad 3rd byte (6-byte)\"),\n        (b\"\\xfc\\x84\\x80\\x41\\x80\\x80\", PCRE2_ERROR_UTF8_ERR8, 0, \"bad 4th byte (6-byte)\"),\n        (b\"\\xfc\\x84\\x80\\x80\\x41\\x80\", PCRE2_ERROR_UTF8_ERR9, 0, \"bad 5th byte (6-byte)\"),\n        (b\"\\xfc\\x84\\x80\\x80\\x80\\x41\", PCRE2_ERROR_UTF8_ERR10, 0, \"bad 6th byte (6-byte)\"),\n        // ERR11/ERR12: 5- and 6-byte characters not permitted by RFC 3629.\n        (b\"\\xf8\\x88\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR11, 0, \"5-byte char\"),\n        (b\"\\xfc\\x84\\x80\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR12, 0, \"6-byte char\"),\n        // ERR13: 4-byte char > 0x10ffff.\n        (b\"\\xf4\\x90\\x80\\x80\", PCRE2_ERROR_UTF8_ERR13, 0, \"> 0x10ffff (f4 90)\"),\n        (b\"\\xf5\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR13, 0, \"> 0x10ffff (f5)\"),\n        (b\"\\xf7\\xbf\\xbf\\xbf\", PCRE2_ERROR_UTF8_ERR13, 0, \"> 0x10ffff (f7)\"),\n        // ERR14: 3-byte encoding of a surrogate.\n        (b\"\\xed\\xa0\\x80\", PCRE2_ERROR_UTF8_ERR14, 0, \"surrogate d800\"),\n        (b\"\\xed\\xbf\\xbf\", PCRE2_ERROR_UTF8_ERR14, 0, \"surrogate dfff\"),\n        // ERR15..ERR19: overlong forms.\n        (b\"\\xc0\\x80\", PCRE2_ERROR_UTF8_ERR15, 0, \"overlong 2 (c0)\"),\n        (b\"\\xc1\\xbf\", PCRE2_ERROR_UTF8_ERR15, 0, \"overlong 2 (c1)\"),\n        (b\"\\xe0\\x80\\x80\", PCRE2_ERROR_UTF8_ERR16, 0, \"overlong 3\"),\n        (b\"\\xe0\\x9f\\xbf\", PCRE2_ERROR_UTF8_ERR16, 0, \"overlong 3 (max)\"),\n        (b\"\\xf0\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR17, 0, \"overlong 4\"),\n        (b\"\\xf0\\x8f\\xbf\\xbf\", PCRE2_ERROR_UTF8_ERR17, 0, \"overlong 4 (max)\"),\n        (b\"\\xf8\\x80\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR18, 0, \"overlong 5\"),\n        (b\"\\xfc\\x80\\x80\\x80\\x80\\x80\", PCRE2_ERROR_UTF8_ERR19, 0, \"overlong 6\"),\n        // ERR20: isolated 0x80..0xbf.\n        (b\"\\x80\", PCRE2_ERROR_UTF8_ERR20, 0, \"isolated 80\"),\n        (b\"a\\xbfb\", PCRE2_ERROR_UTF8_ERR20, 1, \"isolated bf\"),\n        (b\"\\xc2\\x80\\x80\", PCRE2_ERROR_UTF8_ERR20, 2, \"trailing continuation\"),\n        // ERR21: 0xfe / 0xff.\n        (b\"\\xfe\", PCRE2_ERROR_UTF8_ERR21, 0, \"0xfe\"),\n        (b\"a\\xff\", PCRE2_ERROR_UTF8_ERR21, 1, \"0xff\"),\n    ];\n    for (s, want, wantoff, label) in bad {\n        unsafe {\n            let mut oc: Sz = SENT;\n            let cret = (p.c.valid_utf)(s.as_ptr(), s.len(), &mut oc);\n            assert_eq!(\n                (cret, oc as i64),\n                (*want, *wantoff as i64),\n                \"C itself disagrees with the expected classification of {label} <{}>\",\n                show(s)\n            );\n        }\n        check(s, label, &mut seen);\n        // Same case with a valid prefix, to move the reported offset.\n        let mut pre = b\"x\\xc2\\xa9\".to_vec();\n        pre.extend_from_slice(s);\n        check(&pre, label, &mut seen);\n        // Same case truncated in every possible way.\n        for l in 0..s.len() {\n            check(&s[..l], label, &mut seen);\n        }\n    }\n\n    // Every leading byte on its own and followed by 1..5 continuation bytes.\n    for lead in 0u32..=0xffu32 {\n        for extra in 0..=5usize {\n            let mut v = vec![lead as u8];\n            for _ in 0..extra {\n                v.push(0x80);\n            }\n            check(&v, \"lead+continuations\", &mut seen);\n            let mut v2 = v.clone();\n            v2.push(b'Z');\n            check(&v2, \"lead+continuations+ascii\", &mut seen);\n        }\n    }\n\n    // ---------------- randomized ----------------\n    let mut rng = Rng::new(0x5111_0004);\n    const N_RAND: usize = 6000;\n    for _ in 0..N_RAND {\n        let len = rng.below(12);\n        let mut v = Vec::with_capacity(len);\n        for _ in 0..len {\n            v.push(match rng.below(4) {\n                0 => rng.byte(),                        // anything\n                1 => 0x80 | (rng.byte() & 0x3f),        // continuation\n                2 => 0xc0 | (rng.byte() & 0x3f),        // leading\n                _ => rng.byte() & 0x7f,                 // ascii\n            });\n        }\n        check(&v, \"random bytes\", &mut seen);\n    }\n    // Random *valid* strings, plus single-byte mutations of them.\n    for _ in 0..N_RAND {\n        let n = 1 + rng.below(5);\n        let mut cps = Vec::new();\n        for _ in 0..n {\n            let cp = loop {\n                let c = (rng.next_u64() % 0x11_0000) as u32;\n                if !(0xd800..=0xdfff).contains(&c) {\n                    break c;\n                }\n            };\n            cps.push(cp);\n        }\n        let mut v = utf8_of(&cps);\n        check(&v, \"random valid\", &mut seen);\n        if !v.is_empty() {\n            let i = rng.below(v.len());\n            v[i] = rng.byte();\n            check(&v, \"mutated valid\", &mut seen);\n        }\n    }\n\n    // Make sure the hand-written table really did reach every error code.\n    for e in 1..=21i32 {\n        let code = -(e + 2); // PCRE2_ERROR_UTF8_ERR1 == -3\n        assert!(\n            seen.contains(&code),\n            \"no test case produced PCRE2_ERROR_UTF8_ERR{e} ({code})\"\n        );\n    }\n    assert!(seen.contains(&0), \"no valid string was tested\");\n    eprintln!(\"t04_valid_utf: {n} strings, error codes covered: {}\", seen.len());\n}\n\n// ---------------------------------------------------------------------------\n// 5. pcre2_newline.c\n// ---------------------------------------------------------------------------\n\n/// Subjects used for the newline tests.  For UTF mode every byte >= 0xc0 starts\n/// a complete sequence and the first byte is never a continuation byte, which is\n/// what the unchecked GETCHAR/BACKCHAR macros require.\nfn newline_subjects() -> Vec<(Vec<u8>, bool)> {\n    // (subject, safe in UTF mode)\n    let mut v: Vec<(Vec<u8>, bool)> = vec![\n        (b\"a\".to_vec(), true),\n        (b\"\\n\".to_vec(), true),\n        (b\"\\r\".to_vec(), true),\n        (b\"\\r\\n\".to_vec(), true),\n        (b\"\\n\\r\".to_vec(), true),\n        (b\"\\r\\r\\n\\n\".to_vec(), true),\n        (b\"a\\rb\".to_vec(), true),\n        (b\"a\\r\\nb\".to_vec(), true),\n        (b\"\\x0b\".to_vec(), true),   // VT\n        (b\"\\x0c\".to_vec(), true),   // FF\n        (b\"a\\x0b\\x0cb\".to_vec(), true),\n        (b\"\\x00\".to_vec(), true),\n        (b\"a\\x00\\rb\".to_vec(), true),\n        (b\"\\x85\".to_vec(), true),   // bare NEL byte (C reads it as c == 0x85)\n        (b\"a\\x85b\".to_vec(), true),\n        (b\"\\xc2\\x85\".to_vec(), true), // NEL, UTF-8\n        (b\"a\\xc2\\x85b\".to_vec(), true),\n        (b\"\\xe2\\x80\\xa8\".to_vec(), true), // LS\n        (b\"\\xe2\\x80\\xa9\".to_vec(), true), // PS\n        (b\"a\\xe2\\x80\\xa8\\xe2\\x80\\xa9b\".to_vec(), true),\n        (b\"\\xe2\\x80\\xa8\\r\\n\".to_vec(), true),\n        (b\"\\r\\xe2\\x80\\xa9\".to_vec(), true),\n        (b\"\\xc2\\x85\\r\".to_vec(), true),\n        (b\"abc\".to_vec(), true),\n        (b\"\\xf0\\x90\\x80\\x80\\n\".to_vec(), true),\n        (b\"\\n\\xf0\\x90\\x80\\x80\".to_vec(), true),\n        (b\"\\xc3\\xa9\\r\\n\\xc3\\xa9\".to_vec(), true),\n        // Non-UTF only: lone high bytes / truncated sequences.\n        (b\"\\xe2\\x80\".to_vec(), false),\n        (b\"\\xff\\xfe\\r\".to_vec(), false),\n        (b\"\\x80\\x85\".to_vec(), false),\n        (b\"\\xc2\".to_vec(), false),\n    ];\n    let mut rng = Rng::new(0x5111_0005);\n    // Random subjects built from newline-relevant characters (UTF-safe).\n    let pool: [u32; 12] = [\n        0x0a, 0x0d, 0x0b, 0x0c, 0x85, 0x2028, 0x2029, 0x61, 0x00, 0x2027, 0x10000, 0xe9,\n    ];\n    for _ in 0..400 {\n        let n = 1 + rng.below(6);\n        let mut cps = Vec::new();\n        for _ in 0..n {\n            cps.push(*rng.pick(&pool));\n        }\n        v.push((utf8_of(&cps), true));\n    }\n    // Random raw bytes (non-UTF only).\n    for _ in 0..400 {\n        let n = 1 + rng.below(6);\n        let mut s = Vec::new();\n        for _ in 0..n {\n            s.push(*rng.pick(&[0x0a, 0x0d, 0x0b, 0x0c, 0x85, 0x61, 0x00, 0xff, 0x80, 0xc2]));\n        }\n        v.push((s, false));\n    }\n    v\n}\n\n#[test]\nfn t05_is_and_was_newline() {\n    let p = pair();\n    const SENT: u32 = 0xdead_beef;\n    let subjects = newline_subjects();\n    let mut n_is = 0usize;\n    let mut n_was = 0usize;\n\n    for (s, utf_ok) in &subjects {\n        let end = s.len();\n        for &utf in &[0i32, 1i32] {\n            if utf == 1 && !*utf_ok {\n                continue;\n            }\n            // NLTYPE_FIXED(0), NLTYPE_ANY(1), NLTYPE_ANYCRLF(2) - the C treats\n            // anything that is not ANYCRLF as ANY, so 0 and 3 exercise that.\n            for &ty in &[0u32, 1, 2, 3] {\n                // is_newline: requires ptr < endptr.\n                for i in 0..end {\n                    unsafe {\n                        let mut lc = SENT;\n                        let mut lr = SENT;\n                        let cret =\n                            (p.c.is_newline)(s.as_ptr().add(i), ty, s.as_ptr().add(end), &mut lc, utf);\n                        let rret =\n                            (p.r.is_newline)(s.as_ptr().add(i), ty, s.as_ptr().add(end), &mut lr, utf);\n                        assert_eq!(\n                            (cret, lc),\n                            (rret, lr),\n                            \"is_newline(<{}>, pos {i}, type {ty}, utf {utf}): \\\n                             C=(ret {cret}, len {}) Rust=(ret {rret}, len {})\",\n                            show(s),\n                            if lc == SENT { \"unset\".into() } else { lc.to_string() },\n                            if lr == SENT { \"unset\".into() } else { lr.to_string() }\n                        );\n                        if cret == 0 {\n                            assert_eq!(lc, SENT, \"is_newline wrote *lenptr while returning FALSE\");\n                        }\n                        n_is += 1;\n                    }\n                }\n                // was_newline: requires ptr > startptr.\n                for i in 1..=end {\n                    unsafe {\n                        let mut lc = SENT;\n                        let mut lr = SENT;\n                        let cret =\n                            (p.c.was_newline)(s.as_ptr().add(i), ty, s.as_ptr(), &mut lc, utf);\n                        let rret =\n                            (p.r.was_newline)(s.as_ptr().add(i), ty, s.as_ptr(), &mut lr, utf);\n                        assert_eq!(\n                            (cret, lc),\n                            (rret, lr),\n                            \"was_newline(<{}>, pos {i}, type {ty}, utf {utf}): \\\n                             C=(ret {cret}, len {}) Rust=(ret {rret}, len {})\",\n                            show(s),\n                            if lc == SENT { \"unset\".into() } else { lc.to_string() },\n                            if lr == SENT { \"unset\".into() } else { lr.to_string() }\n                        );\n                        if cret == 0 {\n                            assert_eq!(lc, SENT, \"was_newline wrote *lenptr while returning FALSE\");\n                        }\n                        n_was += 1;\n                    }\n                }\n            }\n        }\n    }\n    eprintln!(\n        \"t05_is_and_was_newline: {} subjects, {n_is} is_newline calls, {n_was} was_newline calls\",\n        subjects.len()\n    );\n}\n\n// ---------------------------------------------------------------------------\n// 6. pcre2_extuni.c\n// ---------------------------------------------------------------------------\n\n#[test]\nfn t06_extuni() {\n    let p = pair();\n    let mut subjects: Vec<Vec<u8>> = Vec::new();\n\n    // Hand-picked grapheme-cluster material.\n    let hand: &[&[u32]] = &[\n        &[0x61],                                     // \"a\"\n        &[0x61, 0x62, 0x63],                         // ascii\n        &[0x61, 0x300, 0x301, 0x62],                 // combining marks\n        &[0x65, 0x301],                              // e + acute\n        &[0x0d, 0x0a, 0x61],                         // CRLF\n        &[0x0a, 0x0d],                               // LF CR\n        &[0x61, 0x0d, 0x0a],                         //\n        &[0x1f1e6, 0x1f1e7],                         // 2 regional indicators\n        &[0x1f1e6, 0x1f1e7, 0x1f1e8],                // 3 RIs\n        &[0x1f1e6, 0x1f1e7, 0x1f1e8, 0x1f1e9],       // 4 RIs\n        &[0x61, 0x1f1e6, 0x1f1e7, 0x1f1e8],          // RIs after a letter\n        &[0x1100, 0x1161, 0x11a8],                   // Hangul L V T\n        &[0x1100, 0x1100, 0x1161],                   // L L V\n        &[0xac00, 0x11a8],                           // LV + T\n        &[0xac01, 0x11a8],                           // LVT + T\n        &[0x1f468, 0x200d, 0x1f469, 0x200d, 0x1f466],// ZWJ family\n        &[0x200d, 0x1f469],                          // ZWJ not preceded by Ext_Pict\n        &[0x1f468, 0xfe0f, 0x200d, 0x1f469],         // Ext_Pict + Extend + ZWJ\n        &[0x2764, 0xfe0f],                           // heart + VS16\n        &[0x600, 0x61],                              // Prepend + letter\n        &[0x903, 0x61],                              // SpacingMark\n        &[0x61, 0x903],                              // letter + SpacingMark\n        &[0x94d, 0x915],                             // virama\n        &[0x1, 0x61],                                // Control\n        &[0x61, 0x1, 0x62],                          //\n        &[0x62, 0x483, 0x5bf, 0x63],                 // more marks\n        &[0x1f1e6],                                  // single RI\n        &[0x10ffff, 0x300],                          // unassigned + mark\n        &[0x61, 0x200d, 0x200d, 0x62],               // ZWJ ZWJ\n        &[0x1f468, 0x200d, 0x200d, 0x1f469],         //\n    ];\n    for cps in hand {\n        subjects.push(utf8_of(cps));\n    }\n\n    // Randomized sequences drawn from a pool that hits every gbtable row.\n    let pool: [u32; 24] = [\n        0x61, 0x62, 0x30, 0x0d, 0x0a, 0x01, 0x300, 0x301, 0xfe0f, 0x200d, 0x1f1e6, 0x1f1e7,\n        0x1f1e8, 0x1100, 0x1161, 0x11a8, 0xac00, 0xac01, 0x1f468, 0x1f469, 0x2764, 0x600, 0x903,\n        0x94d,\n    ];\n    let mut rng = Rng::new(0x5111_0006);\n    const N_RAND: usize = 1200;\n    for _ in 0..N_RAND {\n        let n = 1 + rng.below(8);\n        let mut cps = Vec::new();\n        for _ in 0..n {\n            cps.push(*rng.pick(&pool));\n        }\n        subjects.push(utf8_of(&cps));\n    }\n    // Random raw bytes for the non-UTF path.\n    let mut raw: Vec<Vec<u8>> = Vec::new();\n    for _ in 0..400 {\n        let n = 1 + rng.below(8);\n        let mut s = Vec::new();\n        for _ in 0..n {\n            s.push(rng.byte());\n        }\n        raw.push(s);\n    }\n\n    let mut n = 0usize;\n    let mut run = |s: &[u8], utf: c_int, n: &mut usize| unsafe {\n        let starts: Vec<usize> = if utf != 0 {\n            char_starts(s)\n        } else {\n            (0..s.len()).collect()\n        };\n        let end = s.len();\n        for &i in &starts {\n            let (c, clen) = if utf != 0 {\n                decode_utf8(s, i)\n            } else {\n                (s[i] as u32, 1)\n            };\n            let eptr = i + clen;\n            for xinit in [None, Some(0i32), Some(7i32)] {\n                let (rc, xc) = {\n                    let mut x = xinit.unwrap_or(0);\n                    let xp = if xinit.is_some() {\n                        &mut x as *mut i32\n                    } else {\n                        ptr::null_mut()\n                    };\n                    let r = (p.c.extuni)(\n                        c,\n                        s.as_ptr().add(eptr),\n                        s.as_ptr(),\n                        s.as_ptr().add(end),\n                        utf,\n                        xp,\n                    );\n                    (off_of(r, s.as_ptr()), x)\n                };\n                let (rr, xr) = {\n                    let mut x = xinit.unwrap_or(0);\n                    let xp = if xinit.is_some() {\n                        &mut x as *mut i32\n                    } else {\n                        ptr::null_mut()\n                    };\n                    let r = (p.r.extuni)(\n                        c,\n                        s.as_ptr().add(eptr),\n                        s.as_ptr(),\n                        s.as_ptr().add(end),\n                        utf,\n                        xp,\n                    );\n                    (off_of(r, s.as_ptr()), x)\n                };\n                assert_eq!(\n                    (rc, xc),\n                    (rr, xr),\n                    \"extuni(c=U+{c:04X}, eptr=+{eptr}, subject=<{}>, utf={utf}, xcount={:?}): \\\n                     C=(offset {:?}, xcount {xc}) Rust=(offset {:?}, xcount {xr})\",\n                    show(s),\n                    xinit,\n                    rc,\n                    rr\n                );\n                assert!(\n                    rc.map(|o| o >= eptr && o <= end).unwrap_or(false),\n                    \"extuni returned an out-of-range pointer: {rc:?} (eptr=+{eptr}, end={end})\"\n                );\n                *n += 1;\n            }\n        }\n    };\n\n    for s in &subjects {\n        run(s, 1, &mut n);\n        run(s, 0, &mut n);\n    }\n    for s in &raw {\n        run(s, 0, &mut n);\n    }\n    eprintln!(\n        \"t06_extuni: {} utf subjects + {} raw subjects, {n} calls\",\n        subjects.len(),\n        raw.len()\n    );\n}\n\n// ---------------------------------------------------------------------------\n// 7. pcre2_script_run.c\n// ---------------------------------------------------------------------------\n\n#[test]\nfn t07_script_run() {\n    let p = pair();\n    let mut subjects: Vec<Vec<u8>> = Vec::new();\n\n    let hand: &[&[u32]] = &[\n        &[],                                  // empty\n        &[0x61],                              // one char\n        &[0x3b1],                             // one Greek char\n        &[0x378],                             // Unknown script, single char\n        &[0x378, 0x379],                      // Unknown, two chars\n        &[0x61, 0x62, 0x63],                  // Latin\n        &[0x3b1, 0x3b2, 0x3b3],               // Greek\n        &[0x430, 0x431],                      // Cyrillic\n        &[0x61, 0x3b1],                       // Latin + Greek: mixed\n        &[0x430, 0x61],                       // Cyrillic + Latin: mixed\n        &[0x4e00, 0x6f22],                    // Han\n        &[0x4e00, 0x3042],                    // Han + Hiragana\n        &[0x4e00, 0x30a2],                    // Han + Katakana\n        &[0x3042, 0x4e00, 0x30a2],            // Hiragana + Han + Katakana\n        &[0x4e00, 0x3105],                    // Han + Bopomofo\n        &[0x3105, 0x4e00, 0x3105],            //\n        &[0x4e00, 0xac00],                    // Han + Hangul\n        &[0xac00, 0x4e00, 0x3042],            // Hangul + Han + Hiragana: bad\n        &[0x3042, 0x3105],                    // Hiragana + Bopomofo: bad\n        &[0x61, 0x30, 0x31],                  // Latin + Common digits\n        &[0x61, 0x2e, 0x20, 0x62],            // Latin + Common punctuation\n        &[0x61, 0x300],                       // Latin + Inherited\n        &[0x300, 0x300],                      // Inherited only\n        &[0x660, 0x661],                      // Arabic-Indic digits\n        &[0x660, 0x6f0],                      // two different digit sets: bad\n        &[0x966, 0x967, 0x968],               // Devanagari digits\n        &[0x966, 0x660],                      // mixed digit sets: bad\n        &[0x628, 0x629, 0x660],               // Arabic + Arabic-Indic digits\n        &[0x628, 0x966],                      // Arabic + Devanagari digits\n        &[0x5d0, 0x5d1],                      // Hebrew\n        &[0x5d0, 0x628],                      // Hebrew + Arabic: bad\n        &[0x61, 0x1f1e6],                     // Latin + regional indicator\n        &[0x30, 0x31, 0x32],                  // digits only (Common)\n        &[0x10ffff, 0x61],                    // unassigned + Latin\n        &[0x3042, 0x3043, 0x3044],            // Hiragana\n        &[0x61, 0x300, 0x62, 0x301, 0x63],    //\n        &[0xe01, 0xe02, 0xe50],               // Thai + Thai digits\n        &[0x2028, 0x61],                      // Common separator + Latin\n    ];\n    for cps in hand {\n        subjects.push(utf8_of(cps));\n    }\n\n    let pool: [u32; 26] = [\n        0x61, 0x5a, 0x30, 0x39, 0x2e, 0x20, 0x300, 0x3b1, 0x391, 0x430, 0x4e00, 0x6f22, 0x3042,\n        0x30a2, 0x3105, 0xac00, 0x628, 0x5d0, 0x660, 0x6f0, 0x966, 0xe50, 0x378, 0x10ffff, 0x1f1e6,\n        0x2028,\n    ];\n    let mut rng = Rng::new(0x5111_0007);\n    const N_RAND: usize = 1500;\n    for _ in 0..N_RAND {\n        let n = rng.below(7);\n        let mut cps = Vec::new();\n        for _ in 0..n {\n            cps.push(*rng.pick(&pool));\n        }\n        subjects.push(utf8_of(&cps));\n    }\n\n    let mut n = 0usize;\n    for s in &subjects {\n        unsafe {\n            // UTF mode: only whole-character ranges.\n            let mut bounds = char_starts(s);\n            bounds.push(s.len());\n            for (bi, &b) in bounds.iter().enumerate() {\n                for &e in bounds.iter().skip(bi) {\n                    let cret = (p.c.script_run)(s.as_ptr().add(b), s.as_ptr().add(e), 1);\n                    let rret = (p.r.script_run)(s.as_ptr().add(b), s.as_ptr().add(e), 1);\n                    assert_eq!(\n                        cret, rret,\n                        \"script_run(<{}>, [{b}..{e}), utf=1): C={cret} Rust={rret}\",\n                        show(s)\n                    );\n                    n += 1;\n                }\n            }\n            // Non-UTF mode: every byte is its own code point, any range is fine.\n            for b in 0..=s.len() {\n                for e in b..=s.len() {\n                    let cret = (p.c.script_run)(s.as_ptr().add(b), s.as_ptr().add(e), 0);\n                    let rret = (p.r.script_run)(s.as_ptr().add(b), s.as_ptr().add(e), 0);\n                    assert_eq!(\n                        cret, rret,\n                        \"script_run(<{}>, [{b}..{e}), utf=0): C={cret} Rust={rret}\",\n                        show(s)\n                    );\n                    n += 1;\n                }\n            }\n        }\n    }\n    eprintln!(\"t07_script_run: {} subjects, {n} calls\", subjects.len());\n}\n\n// ---------------------------------------------------------------------------\n// 8. _pcre2_compile_get_hash_from_name8\n// ---------------------------------------------------------------------------\n\n#[test]\nfn t08_get_hash_from_name() {\n    let p = pair();\n    // The C reads name[0] and name[length - 1]; with length == 0 that is\n    // name[-1], so the pointer we hand over always has one initialised byte in\n    // front of it (still inside our own allocation).\n    let mut rng = Rng::new(0x5111_0008);\n    let mut n = 0usize;\n    let mut mismatched_high_bits = 0usize;\n\n    let mut check = |buf: &[u8], len: usize, n: &mut usize| unsafe {\n        let name = buf.as_ptr().add(1);\n        let c = (p.c.get_hash_from_name)(name, len);\n        let r = (p.r.get_hash_from_name)(name, len);\n        // The C function returns uint16_t, so only the low 16 bits are part of\n        // the ABI contract; the upper bits of the register are undefined.\n        assert_eq!(\n            c & 0xffff,\n            r & 0xffff,\n            \"get_hash_from_name(<{}>, {len}): C=0x{:04x} Rust=0x{:04x}\",\n            show(&buf[1..1 + len]),\n            c & 0xffff,\n            r & 0xffff\n        );\n        *n += 1;\n        (c >> 16) != (r >> 16)\n    };\n\n    // Hand-picked names.\n    for name in [\n        &b\"\"[..],\n        b\"a\",\n        b\"z\",\n        b\"A\",\n        b\"ab\",\n        b\"abc\",\n        b\"abcdefgh\",\n        b\"\\x00\",\n        b\"\\x7f\",\n        b\"\\x80\",\n        b\"\\xff\",\n        b\"\\xff\\xff\",\n        b\"\\x00\\xff\",\n        b\"a\\xff\",\n        b\"\\xffa\",\n        b\"name1\",\n        b\"n1\",\n    ] {\n        let mut buf = vec![0x5au8];\n        buf.extend_from_slice(name);\n        buf.push(0x5a);\n        if check(&buf, name.len(), &mut n) {\n            mismatched_high_bits += 1;\n        }\n    }\n    // Random names of length 0..8.\n    const N_RAND: usize = 4000;\n    for _ in 0..N_RAND {\n        let len = rng.below(9);\n        let mut buf = vec![rng.byte()];\n        for _ in 0..len {\n            buf.push(rng.byte());\n        }\n        buf.push(rng.byte());\n        if check(&buf, len, &mut n) {\n            mismatched_high_bits += 1;\n        }\n    }\n    eprintln!(\n        \"t08_get_hash_from_name: {n} names ({mismatched_high_bits} calls differed only in the \\\n         padding bits above the uint16_t return value)\"\n    );\n}\n\n// ---------------------------------------------------------------------------\n// 9. _pcre2_memctl_malloc_8\n// ---------------------------------------------------------------------------\n\n/// Mirrors `pcre2_memctl` from pcre2_intmodedep.h.\n#[repr(C)]\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\nstruct MemCtl {\n    malloc: Option<unsafe extern \"C\" fn(usize, *mut c_void) -> *mut c_void>,\n    free: Option<unsafe extern \"C\" fn(*mut c_void, *mut c_void)>,\n    memory_data: *mut c_void,\n}\n\nextern \"C\" {\n    fn malloc(n: usize) -> *mut c_void;\n    fn free(p: *mut c_void);\n}\n\nstatic ALLOC_CALLS: AtomicUsize = AtomicUsize::new(0);\nstatic ALLOC_LAST_SIZE: AtomicUsize = AtomicUsize::new(usize::MAX);\nstatic ALLOC_FAIL: AtomicBool = AtomicBool::new(false);\nstatic FREE_CALLS: AtomicUsize = AtomicUsize::new(0);\n\n/// Always over-allocates: `PRIV(memctl_malloc)` writes a 24-byte\n/// `pcre2_memctl` into the returned block even when `size` is 0.\nunsafe extern \"C\" fn test_malloc(size: usize, data: *mut c_void) -> *mut c_void {\n    ALLOC_CALLS.fetch_add(1, Ordering::SeqCst);\n    ALLOC_LAST_SIZE.store(size, Ordering::SeqCst);\n    assert_eq!(data as usize, 0xf00d, \"malloc got the wrong memory_data\");\n    if ALLOC_FAIL.load(Ordering::SeqCst) {\n        return ptr::null_mut();\n    }\n    malloc(size + 64)\n}\n\nunsafe extern \"C\" fn test_free(block: *mut c_void, data: *mut c_void) {\n    FREE_CALLS.fetch_add(1, Ordering::SeqCst);\n    assert_eq!(data as usize, 0xf00d, \"free got the wrong memory_data\");\n    free(block);\n}\n\n#[test]\nfn t09_memctl_malloc() {\n    let p = pair();\n    let mut mc = MemCtl {\n        malloc: Some(test_malloc),\n        free: Some(test_free),\n        memory_data: 0xf00d as *mut c_void,\n    };\n    let sizes = [\n        0usize, 1, 23, 24, 25, 32, 64, 100, 1024, 4096, 65536, 100_000,\n    ];\n    let mut n = 0usize;\n\n    // ---- the normal path: the returned block starts with a copy of *memctl --\n    for &size in &sizes {\n        for (which, api) in [(\"C\", &p.c), (\"Rust\", &p.r)] {\n            unsafe {\n                ALLOC_CALLS.store(0, Ordering::SeqCst);\n                FREE_CALLS.store(0, Ordering::SeqCst);\n                ALLOC_LAST_SIZE.store(usize::MAX, Ordering::SeqCst);\n                let blk = (api.memctl_malloc)(size, &mut mc as *mut MemCtl as *mut c_void);\n                assert!(!blk.is_null(), \"{which}: memctl_malloc({size}) returned NULL\");\n                assert_eq!(\n                    ALLOC_CALLS.load(Ordering::SeqCst),\n                    1,\n                    \"{which}: memctl_malloc({size}) called malloc {} times\",\n                    ALLOC_CALLS.load(Ordering::SeqCst)\n                );\n                assert_eq!(\n                    ALLOC_LAST_SIZE.load(Ordering::SeqCst),\n                    size,\n                    \"{which}: memctl_malloc({size}) asked its allocator for a different size\"\n                );\n                let got = *(blk as *const MemCtl);\n                assert_eq!(\n                    got, mc,\n                    \"{which}: memctl_malloc({size}) stored {got:?}, expected {mc:?}\"\n                );\n                test_free(blk, mc.memory_data);\n                assert_eq!(FREE_CALLS.load(Ordering::SeqCst), 1);\n                n += 1;\n            }\n        }\n    }\n\n    // ---- allocation failure ----\n    ALLOC_FAIL.store(true, Ordering::SeqCst);\n    for &size in &[0usize, 1, 4096] {\n        unsafe {\n            ALLOC_CALLS.store(0, Ordering::SeqCst);\n            let bc = (p.c.memctl_malloc)(size, &mut mc as *mut MemCtl as *mut c_void);\n            let calls_c = ALLOC_CALLS.swap(0, Ordering::SeqCst);\n            let br = (p.r.memctl_malloc)(size, &mut mc as *mut MemCtl as *mut c_void);\n            let calls_r = ALLOC_CALLS.load(Ordering::SeqCst);\n            assert!(\n                bc.is_null() && br.is_null(),\n                \"memctl_malloc({size}) with a failing allocator: C={bc:?} Rust={br:?}\"\n            );\n            assert_eq!(\n                (calls_c, calls_r),\n                (1, 1),\n                \"memctl_malloc({size}) allocator call counts: C={calls_c} Rust={calls_r}\"\n            );\n            n += 1;\n        }\n    }\n    ALLOC_FAIL.store(false, Ordering::SeqCst);\n\n    // ---- memctl == NULL: the library installs its own default_malloc/free ---\n    // Those are library-private symbols, so only their observable properties\n    // can be compared (non-NULL, and memory_data == NULL).\n    for &size in &[24usize, 64, 4096] {\n        unsafe {\n            for (which, api) in [(\"C\", &p.c), (\"Rust\", &p.r)] {\n                let blk = (api.memctl_malloc)(size, ptr::null_mut());\n                assert!(!blk.is_null(), \"{which}: memctl_malloc({size}, NULL) failed\");\n                let got = *(blk as *const MemCtl);\n                assert!(\n                    got.malloc.is_some() && got.free.is_some(),\n                    \"{which}: memctl_malloc({size}, NULL) left null function pointers\"\n                );\n                assert!(\n                    got.memory_data.is_null(),\n                    \"{which}: memctl_malloc({size}, NULL) set memory_data = {:?}\",\n                    got.memory_data\n                );\n                // Both libraries' default_malloc is plain libc malloc.\n                free(blk);\n                n += 1;\n            }\n        }\n    }\n    eprintln!(\"t09_memctl_malloc: {n} calls\");\n}\n\n// ---------------------------------------------------------------------------\n// 10. _pcre2_find_bracket_8\n// ---------------------------------------------------------------------------\n\n/// Patterns exercising the opcode walk in pcre2_find_bracket.c.\nconst FB_PATTERNS: &[(&[u8], u32)] = &[\n    (b\"abc\", 0),\n    (b\"(a)\", 0),\n    (b\"(a)(b)(c)\", 0),\n    (b\"((((((a))))))\", 0),\n    (b\"(?:x)(y(z))\", 0),\n    (b\"(a)|(b)|(c)\", 0),\n    (b\"(?<one>a)(?<two>b)|(c)\", 0),\n    (b\"(?<x>a)(?<x>b)\", PCRE2_DUPNAMES),\n    (b\"(a)(?<n>b)(?:c)(?<m>d)(e)\", 0),\n    (b\"(a)(?=(b))(?!(c))\", 0),\n    (b\"(a)(?>(b))(?|(x)|(y))\", 0),\n    (b\"(a)*+(b)?(c){2,5}\", 0),\n    (b\"(?<=(ab))c\", 0),                     // fixed lookbehind -> OP_REVERSE\n    (b\"(?<=a{2,5})b\", 0),                   // variable lookbehind -> OP_VREVERSE\n    (b\"(?<=(?:ab|cde))x(y)\", 0),            // two lookbehind branches\n    (b\"(?<!(foo))bar(z)\", 0),\n    (b\"(a)(?<=(b)c)\", 0),\n    (b\"(?<=x)(?<=(y))z\", 0),\n    (b\"a(?<=\\\\d{1,4})(b)\", 0),\n    (b\"(*MARK:x)(a)(*THEN:y)b\", 0),\n    (b\"(*COMMIT:c1)(a)(*PRUNE:p1)(b)(*SKIP:s1)(c)\", 0),\n    (b\"(?C{hello})(a)(?C1)(b)\", 0),\n    (b\"(?C\\\"str\\\")(a)(?C'q')(b)\", 0),\n    (b\"\\\\p{L}+(a)\\\\p{Nd}*(b)\", PCRE2_UTF | PCRE2_UCP),\n    (b\"a{2,3}(b)\\\\p{L}{1,4}(c)\\\\p{Nd}{3}\", PCRE2_UTF | PCRE2_UCP),\n    (b\"\\\\P{L}?(a)\\\\p{Greek}*+(b)\", PCRE2_UTF | PCRE2_UCP),\n    (b\"[\\\\x{100}-\\\\x{200}](a)\", PCRE2_UTF),\n    (b\"[^\\\\p{L}](a)(b)\", PCRE2_UTF | PCRE2_UCP),\n    (\n        b\"[\\\\x{100}\\\\x{300}\\\\x{500}\\\\x{700}\\\\x{900}\\\\x{1100}\\\\x{1300}\\\\x{1500}](a)(b)\",\n        PCRE2_UTF,\n    ),\n    (\n        b\"(?[[\\\\x{100}-\\\\x{500}]-[\\\\x{200}-\\\\x{300}]])(a)(b)\",\n        PCRE2_UTF,\n    ),\n    (\n        b\"[[\\\\x{100}-\\\\x{500}]&&[\\\\x{200}-\\\\x{fff}]](a)\",\n        PCRE2_UTF | PCRE2_ALT_EXTENDED_CLASS,\n    ),\n    (b\"\\\\x{1000}*(a)\\\\x{2000}{2,4}(b)\", PCRE2_UTF),\n    (b\"(?<=\\\\x{100}\\\\x{200})(a)\", PCRE2_UTF),\n    (b\"\\\\x{10000}+(a)[\\\\x{100}](b)\", PCRE2_UTF),\n    (b\"(?i)(\\\\x{100})+(b)?\", PCRE2_UTF | PCRE2_CASELESS),\n    (b\"a(*ACCEPT)(b)\", 0),\n    (b\"(?(1)x|y)(a)\", 0),\n    (b\"(?(<n>)x|y)(?<n>a)\", 0),\n    (b\"(a)\\\\1(b)\\\\2\", 0),\n    (b\"(?x) (a) # comment\\n (b)\", PCRE2_EXTENDED),\n    (b\"^(a)$|\\\\A(b)\\\\z|\\\\G(c)\", PCRE2_MULTILINE),\n    (b\"(?s).(a).\", 0),\n    (b\"\\\\R(a)\\\\R*(b)\", 0),\n    (b\"\\\\X(a)\\\\X+(b)\", PCRE2_UTF),\n    (b\"(?=(?:(a)|(b)))c\", 0),\n    (b\"(?:(?<n1>a)|(?<n2>b))(c)\", 0),\n    (b\"(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)\", 0),\n    (b\"\\\\b(a)\\\\B(b)\\\\Q()\\\\E(c)\", 0),\n    (b\"(?<=(?<w>ab))(c)\", 0),\n    (b\"(?<=a|bc|def)(x)\", 0),\n];\n\n#[test]\nfn t10_find_bracket() {\n    let p = pair();\n    let mut n = 0usize;\n    for (pat, opts) in FB_PATTERNS {\n        unsafe {\n            let both = compile_both(pat, *opts);\n            let utf: c_int = if opts & PCRE2_UTF != 0 { 1 } else { 0 };\n            let mut top: u32 = 0;\n            assert_eq!(\n                (p.c.pattern_info)(\n                    both.c.code,\n                    PCRE2_INFO_CAPTURECOUNT,\n                    &mut top as *mut u32 as *mut c_void\n                ),\n                0\n            );\n            // number == 0 walks the whole code (no group is numbered 0);\n            // negative numbers switch to \"find the first OP_REVERSE/OP_VREVERSE\".\n            let mut numbers: Vec<c_int> = vec![-5, -1, 0];\n            for k in 1..=(top as c_int + 2) {\n                numbers.push(k);\n            }\n            numbers.push(65535);\n            for &num in &numbers {\n                let rc = (p.c.find_bracket)(both.lc.codestart, utf, num);\n                let rr = (p.r.find_bracket)(both.lr.codestart, utf, num);\n                let oc = off_of(rc, both.lc.codestart);\n                let or = off_of(rr, both.lr.codestart);\n                assert_eq!(\n                    oc,\n                    or,\n                    \"find_bracket({:?}, utf={utf}, number={num}): C={} Rust={}\",\n                    show(pat),\n                    oc.map(|v| format!(\"codestart+{v}\")).unwrap_or(\"NULL\".into()),\n                    or.map(|v| format!(\"codestart+{v}\")).unwrap_or(\"NULL\".into())\n                );\n                if let Some(o) = oc {\n                    assert!(\n                        o < both.lc.blocksize - both.lc.code_start,\n                        \"find_bracket({:?}, {num}) returned codestart+{o}, past the code end\",\n                        show(pat)\n                    );\n                }\n                n += 1;\n            }\n        }\n    }\n    eprintln!(\n        \"t10_find_bracket: {} patterns, {n} calls\",\n        FB_PATTERNS.len()\n    );\n}\n\n// ---------------------------------------------------------------------------\n// 11. _pcre2_xclass_8 / _pcre2_eclass_8\n// ---------------------------------------------------------------------------\n//\n// In-tree callers (pcre2_match.c cases OP_XCLASS / OP_ECLASS,\n// pcre2_dfa_match.c, and PRIV(eclass)'s own ECL_XCLASS branch) build the\n// arguments like this, with `code` pointing at the opcode:\n//\n//   xclass(c, code + 1 + LINK_SIZE, (const uint8_t *)mb->start_code, utf)\n//   eclass(c, code + 1 + LINK_SIZE, code + GET(code, 1),\n//          (const uint8_t *)mb->start_code, utf)\n//\n// `mb->start_code` is the `codestart` computed by pcre2_compile(), i.e. exactly\n// the pointer the encoded character lists grow downwards from - hence the name\n// `char_lists_end`.\nconst OP_XCLASS: u8 = 112;\nconst OP_ECLASS: u8 = 113;\nconst LINK_SIZE: usize = 2;\n\n/// The compiled code always starts with OP_BRA + LINK_SIZE, so the first real\n/// opcode of these patterns is at codestart + 1 + LINK_SIZE.\nconst FIRST_OP: usize = 1 + LINK_SIZE;\n\nfn class_test_points(rng: &mut Rng) -> Vec<u32> {\n    let mut v: Vec<u32> = (0..=0x2ffu32).collect();\n    for cp in [\n        0x300u32, 0x7fe, 0x7ff, 0x800, 0x1000, 0x1fff, 0x2000, 0x3000, 0x4e00, 0x7fff, 0x8000,\n        0x8001, 0xfffe, 0xffff, 0x10000, 0x10001, 0x1f1e6, 0x100000, 0x10fffe, 0x10ffff,\n    ] {\n        v.push(cp);\n    }\n    for _ in 0..600 {\n        v.push((rng.next_u64() % 0x11_0000) as u32);\n    }\n    v\n}\n\n#[test]\nfn t11_xclass() {\n    let p = pair();\n    // Patterns whose first opcode is an OP_XCLASS.\n    let pats: &[(&[u8], u32)] = &[\n        (b\"[\\\\x{100}-\\\\x{200}]\", PCRE2_UTF),\n        (b\"[^\\\\x{100}-\\\\x{ffff}]\", PCRE2_UTF),\n        (b\"[\\\\p{L}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[^\\\\p{L}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[\\\\p{Greek}\\\\p{Han}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[\\\\p{Nd}\\\\p{Zs}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[^\\\\p{Xan}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[[:graph:]\\\\x{100}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[[:print:]\\\\x{2000}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[[:punct:]\\\\x{3000}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[[:xdigit:]\\\\x{ff10}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[\\\\p{Bidi_Control}\\\\x{500}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[\\\\p{Lu}\\\\p{Ll}\\\\x{800}-\\\\x{900}]\", PCRE2_UTF | PCRE2_UCP),\n        (b\"[a-c\\\\x{100}-\\\\x{200}]\", PCRE2_UTF),\n        (b\"[^a-c\\\\x{100}-\\\\x{200}]\", PCRE2_UTF),\n        (b\"[\\\\x{100}]\", PCRE2_UTF),\n        (b\"[\\\\x{10ffff}]\", PCRE2_UTF),\n        (b\"[\\\\x{80}-\\\\x{10ffff}]\", PCRE2_UTF),\n        // >= 6 high ranges: the compiler switches to the encoded char lists\n        // (XCL_LIST) that live just below codestart, exercising the binary\n        // search path and `char_lists_end`.\n        (\n            b\"[\\\\x{100}\\\\x{300}\\\\x{500}\\\\x{700}\\\\x{900}\\\\x{1100}\\\\x{1300}\\\\x{1500}]\",\n            PCRE2_UTF,\n        ),\n        (\n            b\"[^\\\\x{100}\\\\x{300}\\\\x{500}\\\\x{700}\\\\x{900}\\\\x{1100}\\\\x{1300}\\\\x{1500}]\",\n            PCRE2_UTF,\n        ),\n        (\n            b\"[a-c\\\\x{100}\\\\x{300}\\\\x{500}\\\\x{700}\\\\x{900}\\\\x{1100}\\\\x{1300}\\\\x{1500}]\",\n            PCRE2_UTF,\n        ),\n        (\n            b\"[\\\\x{100}-\\\\x{110}\\\\x{300}-\\\\x{310}\\\\x{500}\\\\x{700}\\\\x{9000}-\\\\x{9100}\\\n              \\\\x{11000}\\\\x{13000}-\\\\x{14000}\\\\x{100000}]\",\n            PCRE2_UTF,\n        ),\n        (\n            b\"[\\\\x{7ff0}-\\\\x{8010}\\\\x{fff0}-\\\\x{10010}\\\\x{100}\\\\x{200}\\\\x{300}\\\\x{400}\\\\x{500}]\",\n            PCRE2_UTF,\n        ),\n        (\n            b\"[^\\\\x{7ff0}-\\\\x{8010}\\\\x{fff0}-\\\\x{10010}\\\\x{100}\\\\x{200}\\\\x{300}\\\\x{400}\\\\x{500}]\",\n            PCRE2_UTF,\n        ),\n        (b\"(?[![\\\\x{100}-\\\\x{200}]])\", PCRE2_UTF),\n        (b\"(?[[a-m]|[\\\\x{100}-\\\\x{200}]])\", PCRE2_UTF),\n    ];\n\n    let mut rng = Rng::new(0x5111_0011);\n    let points = class_test_points(&mut rng);\n    let mut n = 0usize;\n    for (pat, opts) in pats {\n        unsafe {\n            let both = compile_both(pat, *opts);\n            let opc = *both.lc.codestart.add(FIRST_OP);\n            assert_eq!(\n                opc, OP_XCLASS,\n                \"pattern {:?}: first opcode is {opc}, expected OP_XCLASS\",\n                show(pat)\n            );\n            let dc = both.lc.codestart.add(FIRST_OP + 1 + LINK_SIZE);\n            let dr = both.lr.codestart.add(FIRST_OP + 1 + LINK_SIZE);\n            for &utf in &[1i32, 0i32] {\n                for &c in &points {\n                    let rc = (p.c.xclass)(c, dc, both.lc.codestart, utf);\n                    let rr = (p.r.xclass)(c, dr, both.lr.codestart, utf);\n                    assert_eq!(\n                        rc, rr,\n                        \"xclass(U+{c:04X}, {:?}, utf={utf}): C={rc} Rust={rr}\",\n                        show(pat)\n                    );\n                    n += 1;\n                }\n            }\n        }\n    }\n    eprintln!(\"t11_xclass: {} patterns, {n} calls\", pats.len());\n}\n\n#[test]\nfn t12_eclass() {\n    let p = pair();\n    // Patterns whose first opcode is an OP_ECLASS.  `(?[...])` (Perl extended\n    // class, single-character operators) needs no option; `[...&&...]`\n    // (UTS#18 style, doubled operators) needs PCRE2_ALT_EXTENDED_CLASS.\n    let pats: &[(&[u8], u32)] = &[\n        (b\"(?[[\\\\x{100}-\\\\x{500}]-[\\\\x{200}-\\\\x{300}]])\", PCRE2_UTF),\n        (b\"(?[[\\\\x{100}-\\\\x{500}]|[\\\\x{2000}-\\\\x{3000}]])\", PCRE2_UTF),\n        (b\"(?[[\\\\x{100}-\\\\x{500}]&[\\\\x{200}-\\\\x{fff}]])\", PCRE2_UTF),\n        (b\"(?[[\\\\p{L}]^[\\\\x{100}-\\\\x{2ff}]])\", PCRE2_UTF | PCRE2_UCP),\n        (b\"(?[[\\\\p{L}]&[\\\\x{100}-\\\\x{2ff}]])\", PCRE2_UTF | PCRE2_UCP),\n        (b\"(?[[\\\\p{Greek}]&[\\\\p{Ll}]])\", PCRE2_UTF | PCRE2_UCP),\n        (b\"(?[![[\\\\x{100}-\\\\x{500}]&[\\\\x{200}-\\\\x{fff}]]])\", PCRE2_UTF),\n        (\n            b\"(?[[\\\\p{L}]&[\\\\p{Nd}]|[\\\\x{1000}-\\\\x{2000}]])\",\n            PCRE2_UTF | PCRE2_UCP,\n        ),\n        (\n            b\"(?[[\\\\x{100}\\\\x{300}\\\\x{500}\\\\x{700}\\\\x{900}\\\\x{1100}\\\\x{1300}\\\\x{1500}]&[\\\\x{100}-\\\\x{1000}]])\",\n            PCRE2_UTF,\n        ),\n        (\n            b\"[[\\\\x{100}-\\\\x{500}]&&[\\\\x{200}-\\\\x{fff}]]\",\n            PCRE2_UTF | PCRE2_ALT_EXTENDED_CLASS,\n        ),\n        (\n            b\"[[\\\\x{100}-\\\\x{500}]--[\\\\x{200}-\\\\x{300}]]\",\n            PCRE2_UTF | PCRE2_ALT_EXTENDED_CLASS,\n        ),\n        (\n            b\"[[\\\\p{L}]~~[\\\\x{100}-\\\\x{2ff}]]\",\n            PCRE2_UTF | PCRE2_UCP | PCRE2_ALT_EXTENDED_CLASS,\n        ),\n        (\n            b\"[[\\\\x{100}-\\\\x{500}]||[\\\\x{2000}-\\\\x{3000}]]\",\n            PCRE2_UTF | PCRE2_ALT_EXTENDED_CLASS,\n        ),\n    ];\n\n    let mut rng = Rng::new(0x5111_0012);\n    let points = class_test_points(&mut rng);\n    let mut n = 0usize;\n    for (pat, opts) in pats {\n        unsafe {\n            let both = compile_both(pat, *opts);\n            let opc = *both.lc.codestart.add(FIRST_OP);\n            assert_eq!(\n                opc, OP_ECLASS,\n                \"pattern {:?}: first opcode is {opc}, expected OP_ECLASS\",\n                show(pat)\n            );\n            // GET(code, 1) with LINK_SIZE == 2.\n            let itemlen = ((*both.lc.codestart.add(FIRST_OP + 1) as usize) << 8)\n                | (*both.lc.codestart.add(FIRST_OP + 2) as usize);\n            let sc = both.lc.codestart.add(FIRST_OP + 1 + LINK_SIZE);\n            let ec = both.lc.codestart.add(FIRST_OP + itemlen);\n            let sr = both.lr.codestart.add(FIRST_OP + 1 + LINK_SIZE);\n            let er = both.lr.codestart.add(FIRST_OP + itemlen);\n            assert!(itemlen > 1 + LINK_SIZE, \"implausible ECLASS length {itemlen}\");\n            for &utf in &[1i32, 0i32] {\n                for &c in &points {\n                    let rc = (p.c.eclass)(c, sc, ec, both.lc.codestart, utf);\n                    let rr = (p.r.eclass)(c, sr, er, both.lr.codestart, utf);\n                    assert_eq!(\n                        rc, rr,\n                        \"eclass(U+{c:04X}, {:?}, utf={utf}): C={rc} Rust={rr}\",\n                        show(pat)\n                    );\n                    n += 1;\n                }\n            }\n        }\n    }\n    eprintln!(\"t12_eclass: {} patterns, {n} calls\", pats.len());\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_d