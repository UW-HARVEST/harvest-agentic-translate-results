{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UyvvjBR31ntiQ9sArKn3b3","type":"tool_result","content":"250\t}\n251\t\n252\t/// Input lengths that hit every size-dependent branch in the C:\n253\t/// 0/1 (empty & minimal), 11..14 (`LZ4_minLength` = 13 / `MFLIMIT` = 12),\n254\t/// 63..65, 65535 (`LZ4_DISTANCE_MAX`), 65536, 65546/65547/65548\n255\t/// (`LZ4_64Klimit` — the `byU16`→`byU32` table switch), and past 4 MB blocks.\n256\tpub const KEY_LENS: &[usize] = &[\n257\t    0, 1, 2, 3, 4, 5, 6, 11, 12, 13, 14, 15, 16, 17, 19, 20, 31, 63, 64, 65, 127, 128, 255, 256,\n258\t    511, 512, 1023, 1024, 4095, 4096, 4097, 8192, 16384, 65534, 65535, 65536, 65537, 65546, 65547,\n259\t    65548, 100_000, 131_072,\n260\t];\n261\t\n262\t/// A smaller sweep for expensive (level 10-12 / optimal-parser) tests.\n263\tpub const SMALL_LENS: &[usize] = &[\n264\t    0, 1, 12, 13, 14, 63, 64, 65, 255, 1024, 4096, 8192, 65535, 65536, 65547, 100_000,\n265\t];\n266\t\n267\t// ---------------------------------------------------------------------------\n268\t// Comparison helpers\n269\t// ---------------------------------------------------------------------------\n270\t\n271\t/// Assert two byte slices are identical, reporting the first differing index.\n272\t#[track_caller]\n273\tpub fn assert_bytes_eq(c: &[u8], r: &[u8], ctx: &str) {\n274\t    if c == r {\n275\t        return;\n276\t    }\n277\t    assert_eq!(\n278\t        c.len(),\n279\t        r.len(),\n280\t        \"{ctx}: length mismatch C={} Rust={}\",\n281\t        c.len(),\n282\t        r.len()\n283\t    );\n284\t    for i in 0..c.len() {\n285\t        if c[i] != r[i] {\n286\t            let lo = i.saturating_sub(8);\n287\t            let hi = (i + 8).min(c.len());\n288\t            panic!(\n289\t                \"{ctx}: first byte difference at index {i}: C=0x{:02x} Rust=0x{:02x}\\n  \\\n290\t                 C   [{lo}..{hi}] = {:02x?}\\n  Rust[{lo}..{hi}] = {:02x?}\",\n291\t                c[i],\n292\t                r[i],\n293\t                &c[lo..hi],\n294\t                &r[lo..hi]\n295\t            );\n296\t        }\n297\t    }\n298\t    unreachable!()\n299\t}\n300\t\n301\t/// Assert two return codes match.\n302\t#[track_caller]\n303\tpub fn assert_ret_eq<T: PartialEq + std::fmt::Debug>(c: T, r: T, ctx: &str) {\n304\t    assert_eq!(c, r, \"{ctx}: return value mismatch (C vs Rust)\");\n305\t}\n306\t\n307\t/// Assert a compression result (return code AND produced bytes) matches.\n308\t#[track_caller]\n309\tpub fn assert_out_eq(cn: i32, cbuf: &[u8], rn: i32, rbuf: &[u8], ctx: &str) {\n310\t    assert_eq!(cn, rn, \"{ctx}: return value mismatch C={cn} Rust={rn}\");\n311\t    if cn > 0 {\n312\t        let n = cn as usize;\n313\t        assert!(\n314\t            n <= cbuf.len() && n <= rbuf.len(),\n315\t            \"{ctx}: bogus length {n}\"\n316\t        );\n317\t        assert_bytes_eq(&cbuf[..n], &rbuf[..n], ctx);\n318\t    }\n319\t}\n320\t\n321\t/// Same for `size_t`-returning frame APIs.\n322\t#[track_caller]\n323\tpub fn assert_sz_eq(cn: usize, cbuf: &[u8], rn: usize, rbuf: &[u8], ctx: &str) {\n324\t    assert_eq!(cn, rn, \"{ctx}: return mismatch C={cn:#x} Rust={rn:#x}\");\n325\t    if !is_lz4f_error(cn) && cn > 0 {\n326\t        assert_bytes_eq(&cbuf[..cn], &rbuf[..cn], ctx);\n327\t    }\n328\t}\n329\t\n330\t/// Mirrors `LZ4F_isError`: `code > (size_t)-LZ4F_ERROR_maxCode` (= `(usize)-24`).\n331\tpub fn is_lz4f_error(code: usize) -> bool {\n332\t    code > (0usize).wrapping_sub(24)\n333\t}\n334\t\n335\t/// `(size_t)-n`, i.e. the value `LZ4F_returnErrorCode` produces for ordinal `n`.\n336\tpub fn lz4f_err(n: usize) -> usize {\n337\t    (0usize).wrapping_sub(n)\n338\t}\n339\t\n340\t// ---------------------------------------------------------------------------\n341\t// 8-byte-aligned scratch buffer (LZ4_initStream / LZ4_initStreamHC require it)\n342\t// ---------------------------------------------------------------------------\n343\t\n344\t/// A heap buffer guaranteed to be 8-byte aligned (actually 16, via `Vec<u64>`).\n345\tpub struct Aligned {\n346\t    buf: Vec<u64>,\n347\t    len: usize,\n348\t}\n349\t\n350\timpl Aligned {\n351\t    pub fn new(len: usize) -> Self {\n352\t        Aligned {\n353\t            buf: vec![0u64; (len + 7) / 8 + 1],\n354\t            len,\n355\t        }\n356\t    }\n357\t    pub fn ptr(&mut self) -> *mut u8 {\n358\t        self.buf.as_mut_ptr() as *mut u8\n359\t    }\n360\t    pub fn len(&self) -> usize {\n361\t        self.len\n362\t    }\n363\t}\n364\t\n365\tpub const SIZEOF_LZ4_STREAM_T: usize = 16416;\n366\tpub const SIZEOF_LZ4_STREAMHC_T: usize = 262200;\n367\tpub const LZ4_MAX_INPUT_SIZE: i32 = 0x7E00_0000;\n368\tpub const LZ4_ACCELERATION_MAX: i32 = 65537;\n369\tpub const LZ4F_HEADER_SIZE_MAX: usize = 19;\n370\tpub const LZ4F_VERSION: u32 = 100;\n371\tpub const LZ4F_MAGICNUMBER: u32 = 0x184D_2204;\n372\t"}]},"parent_tool_use_id":"toolu_bdrk_01Y4ushvz3xgK5E6YkGpuQp4","session_id":"cf344e3a-451b-4037-95c8-f04f4dd0216c","uuid":"bfafeb67-fc67-4639-a223-2d339b3db367","timestamp":"2026-08-14T19:18:37.432Z","subagent_type":"general-purpose","task_description":"Write lz4hc diff tests"}
