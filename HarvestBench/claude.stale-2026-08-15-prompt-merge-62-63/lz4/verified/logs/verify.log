{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016HohCFceuPEGtdViwukDkG","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C `.so` (built by `c_src/CMakeLists.txt`) and the Rust\n4\t//! `cdylib` through `libloading` and exposes them as a pair, so every test\n5\t//! calls both implementations exactly as an external C consumer would.\n6\t#![allow(dead_code, non_snake_case, non_camel_case_types)]\n7\t\n8\tuse libloading::{Library, Symbol};\n9\tuse std::path::PathBuf;\n10\tuse std::sync::OnceLock;\n11\t\n12\t// ---------------------------------------------------------------------------\n13\t// Library loading\n14\t// ---------------------------------------------------------------------------\n15\t\n16\tfn manifest_dir() -> PathBuf {\n17\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n18\t}\n19\t\n20\t/// `target/<profile>/` — derived from the running test binary's location\n21\t/// (`target/<profile>/deps/<test>-<hash>`).\n22\tfn target_profile_dir() -> PathBuf {\n23\t    let exe = std::env::current_exe().expect(\"current_exe\");\n24\t    exe.parent()\n25\t        .and_then(|p| p.parent())\n26\t        .expect(\"target/<profile>\")\n27\t        .to_path_buf()\n28\t}\n29\t\n30\tstatic C_LIB: OnceLock<Library> = OnceLock::new();\n31\tstatic R_LIB: OnceLock<Library> = OnceLock::new();\n32\t\n33\tpub fn c_lib() -> &'static Library {\n34\t    C_LIB.get_or_init(|| {\n35\t        let p = manifest_dir().join(\"c_src/build/liblz4.so\");\n36\t        assert!(\n37\t            p.exists(),\n38\t            \"C shared library not found at {p:?}. Build it with:\\n  \\\n39\t             cd c_src && mkdir -p build && cd build && \\\n40\t             cmake .. -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build .\"\n41\t        );\n42\t        unsafe { Library::new(&p) }.expect(\"dlopen C liblz4.so\")\n43\t    })\n44\t}\n45\t\n46\tpub fn r_lib() -> &'static Library {\n47\t    R_LIB.get_or_init(|| {\n48\t        let p = target_profile_dir().join(\"liblz4.so\");\n49\t        assert!(p.exists(), \"Rust cdylib not found at {p:?}\");\n50\t        unsafe { Library::new(&p) }.expect(\"dlopen Rust liblz4.so\")\n51\t    })\n52\t}\n53\t\n54\t/// Fetch the same symbol from both libraries. Returns `(c_fn, rust_fn)`.\n55\tpub fn pair<T>(name: &str) -> (Symbol<'static, T>, Symbol<'static, T>) {\n56\t    let cn: Symbol<'static, T> = unsafe { c_lib().get(name.as_bytes()) }\n57\t        .unwrap_or_else(|e| panic!(\"C .so missing symbol {name}: {e}\"));\n58\t    let rn: Symbol<'static, T> = unsafe { r_lib().get(name.as_bytes()) }\n59\t        .unwrap_or_else(|e| panic!(\"Rust .so missing symbol {name}: {e}\"));\n60\t    (cn, rn)\n61\t}\n62\t\n63\t/// Declare a `(c, rust)` function-pointer pair for an exported symbol.\n64\t///\n65\t/// ```ignore\n66\t/// sym!(bound, \"LZ4_compressBound\", unsafe extern \"C\" fn(i32) -> i32);\n67\t/// let (c, r) = (bound.0, bound.1);\n68\t/// ```\n69\t#[macro_export]\n70\tmacro_rules! sym {\n71\t    ($var:ident, $name:literal, $ty:ty) => {\n72\t        let $var: (\n73\t            libloading::Symbol<'static, $ty>,\n74\t            libloading::Symbol<'static, $ty>,\n75\t        ) = $crate::common::pair::<$ty>($name);\n76\t    };\n77\t}\n78\t\n79\t// ---------------------------------------------------------------------------\n80\t// Deterministic RNG (fixed seed => reproducible property-style testing)\n81\t// ---------------------------------------------------------------------------\n82\t\n83\t/// splitmix64 — small, fast, deterministic, and identical across platforms.\n84\tpub struct Rng(u64);\n85\t\n86\timpl Rng {\n87\t    pub fn new(seed: u64) -> Self {\n88\t        Rng(seed.wrapping_add(0x9E37_79B9_7F4A_7C15))\n89\t    }\n90\t    pub fn next_u64(&mut self) -> u64 {\n91\t        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);\n92\t        let mut z = self.0;\n93\t        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);\n94\t        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);\n95\t        z ^ (z >> 31)\n96\t    }\n97\t    pub fn next_u32(&mut self) -> u32 {\n98\t        (self.next_u64() >> 32) as u32\n99\t    }\n100\t    pub fn next_u8(&mut self) -> u8 {\n101\t        (self.next_u64() >> 56) as u8\n102\t    }\n103\t    /// Uniform in `0..n` (n > 0).\n104\t    pub fn below(&mut self, n: usize) -> usize {\n105\t        if n == 0 {\n106\t            0\n107\t        } else {\n108\t            (self.next_u64() % (n as u64)) as usize\n109\t        }\n110\t    }\n111\t    /// Uniform in `lo..=hi`.\n112\t    pub fn range(&mut self, lo: usize, hi: usize) -> usize {\n113\t        if hi <= lo {\n114\t            lo\n115\t        } else {\n116\t            lo + self.below(hi - lo + 1)\n117\t        }\n118\t    }\n119\t    pub fn fill(&mut self, buf: &mut [u8]) {\n120\t        for b in buf.iter_mut() {\n121\t            *b = self.next_u8();\n122\t        }\n123\t    }\n124\t}\n125\t\n126\t// ---------------------------------------------------------------------------\n127\t// Input-shape generators (the \"data shape\" axis of CONFIGS.md)\n128\t// ---------------------------------------------------------------------------\n129\t\n130\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n131\tpub enum Shape {\n132\t    /// Uniform random bytes — incompressible, exercises the literal paths.\n133\t    Random,\n134\t    /// Long runs of one byte — maximally compressible, long matches.\n135\t    Runs,\n136\t    /// Small alphabet, short period — many short matches.\n137\t    Periodic,\n138\t    /// Text-like: small alphabet with words, realistic match distribution.\n139\t    Texty,\n140\t    /// Mostly zeros with sparse random bytes.\n141\t    Sparse,\n142\t    /// Random blocks that repeat at a distance near `LZ4_DISTANCE_MAX`.\n143\t    FarMatches,\n144\t    /// Two halves: incompressible then highly compressible.\n145\t    Mixed,\n146\t}\n147\t\n148\tpub const ALL_SHAPES: &[Shape] = &[\n149\t    Shape::Random,\n150\t    Shape::Runs,\n151\t    Shape::Periodic,\n152\t    Shape::Texty,\n153\t    Shape::Sparse,\n154\t    Shape::FarMatches,\n155\t    Shape::Mixed,\n156\t];\n157\t\n158\tpub fn gen_data(shape: Shape, len: usize, rng: &mut Rng) -> Vec<u8> {\n159\t    let mut v = vec![0u8; len];\n160\t    match shape {\n161\t        Shape::Random => rng.fill(&mut v),\n162\t        Shape::Runs => {\n163\t            let mut i = 0;\n164\t            while i < len {\n165\t                let run = rng.range(1, 300).min(len - i);\n166\t                let b = rng.next_u8();\n167\t                for k in 0..run {\n168\t                    v[i + k] = b;\n169\t                }\n170\t                i += run;\n171\t            }\n172\t        }\n173\t        Shape::Periodic => {\n174\t            let period = rng.range(1, 64);\n175\t            let mut pat = vec![0u8; period];\n176\t            for p in pat.iter_mut() {\n177\t                *p = rng.next_u8() & 0x0F;\n178\t            }\n179\t            for i in 0..len {\n180\t                v[i] = pat[i % period];\n181\t            }\n182\t        }\n183\t        Shape::Texty => {\n184\t            const AL: &[u8] = b\"abcdefghijklmnopqrstuvwxyz \";\n185\t            let nwords = 64;\n186\t            let words: Vec<Vec<u8>> = (0..nwords)\n187\t                .map(|_| {\n188\t                    let n = rng.range(2, 9);\n189\t                    (0..n).map(|_| AL[rng.below(AL.len())]).collect()\n190\t                })\n191\t                .collect();\n192\t            let mut i = 0;\n193\t            while i < len {\n194\t                let w = &words[rng.below(nwords)];\n195\t                for &b in w.iter() {\n196\t                    if i < len {\n197\t                        v[i] = b;\n198\t                        i += 1;\n199\t                    }\n200\t                }\n201\t                if i < len {\n202\t                    v[i] = b' ';\n203\t                    i += 1;\n204\t                }\n205\t            }\n206\t        }\n207\t        Shape::Sparse => {\n208\t            let n = len / 50;\n209\t            for _ in 0..n {\n210\t                let i = rng.below(len.max(1));\n211\t                if i < len {\n212\t                    v[i] = rng.next_u8();\n213\t                }\n214\t            }\n215\t        }\n216\t        Shape::FarMatches => {\n217\t            // Fill the first chunk randomly, then copy it back from a distance\n218\t            // that straddles LZ4_DISTANCE_MAX (65535).\n219\t            let chunk = 4096.min(len);\n220\t            if chunk > 0 {\n221\t                rng.fill(&mut v[..chunk]);\n222\t            }\n223\t            let mut i = chunk;\n224\t            while i < len {\n225\t                let dist = *[65535usize, 65536, 65534, 32768, 1024]\n226\t                    .get(rng.below(5))\n227\t                    .unwrap();\n228\t                let n = rng.range(4, 512).min(len - i);\n229\t                for k in 0..n {\n230\t                    v[i + k] = if i + k >= dist { v[i + k - dist] } else { 0 };\n231\t                }\n232\t                i += n;\n233\t            }\n234\t        }\n235\t        Shape::Mixed => {\n236\t            let half = len / 2;\n237\t            rng.fill(&mut v[..half]);\n238\t            let mut i = half;\n239\t            while i < len {\n240\t                let run = rng.range(1, 200).min(len - i);\n241\t                let b = rng.next_u8();\n242\t                for k in 0..run {\n243\t                    v[i + k] = b;\n244\t                }\n245\t                i += run;\n246\t            }\n247\t        }\n248\t    }\n249\t    v\n250\t}\n251\t\n252\t/// Input lengths that hit every size-dependent branch in the C:\n253\t/// 0/1 (empty & minimal), 11..14 (`LZ4_minLength` = 13 / `MFLIMIT` = 12),\n254\t/// 63..65, 65535 (`LZ4_DISTANCE_MAX`), 65536, 65546/65547/65548\n255\t/// (`LZ4_64Klimit` — the `byU16`→`byU32` table switch), and past 4 MB blocks.\n256\tpub const KEY_LENS: &[usize] = &[\n257\t    0, 1, 2, 3, 4, 5, 6, 11, 12, 13, 14, 15, 16, 17, 19, 20, 31, 63, 64, 65, 127, 128, 255, 256,\n258\t    511, 512, 1023, 1024, 4095, 4096, 4097, 8192, 16384, 65534, 65535, 65536, 65537, 65546, 65547,\n259\t    65548, 100_000, 131_072,\n260\t];\n261\t\n262\t/// A smaller sweep for expensive (level 10-12 / optimal-parser) tests.\n263\tpub const SMALL_LENS: &[usize] = &[\n264\t    0, 1, 12, 13, 14, 63, 64, 65, 255, 1024, 4096, 8192, 65535, 65536, 65547, 100_000,\n265\t];\n266\t\n267\t// ---------------------------------------------------------------------------\n268\t// Comparison helpers\n269\t// ---------------------------------------------------------------------------\n270\t\n271\t/// Assert two byte slices are identical, reporting the first differing index.\n272\t#[track_caller]\n273\tpub fn assert_bytes_eq(c: &[u8], r: &[u8], ctx: &str) {\n274\t    if c == r {\n275\t        return;\n276\t    }\n277\t    assert_eq!(\n278\t        c.len(),\n279\t        r.len(),\n280\t        \"{ctx}: length mismatch C={} Rust={}\",\n281\t        c.len(),\n282\t        r.len()\n283\t    );\n284\t    for i in 0..c.len() {\n285\t        if c[i] != r[i] {\n286\t            let lo = i.saturating_sub(8);\n287\t            let hi = (i + 8).min(c.len());\n288\t            panic!(\n289\t                \"{ctx}: first byte difference at index {i}: C=0x{:02x} Rust=0x{:02x}\\n  \\\n290\t                 C   [{lo}..{hi}] = {:02x?}\\n  Rust[{lo}..{hi}] = {:02x?}\",\n291\t                c[i],\n292\t                r[i],\n293\t                &c[lo..hi],\n294\t                &r[lo..hi]\n295\t            );\n296\t        }\n297\t    }\n298\t    unreachable!()\n299\t}\n300\t\n301\t/// Assert two return codes match.\n302\t#[track_caller]\n303\tpub fn assert_ret_eq<T: PartialEq + std::fmt::Debug>(c: T, r: T, ctx: &str) {\n304\t    assert_eq!(c, r, \"{ctx}: return value mismatch (C vs Rust)\");\n305\t}\n306\t\n307\t/// Assert a compression result (return code AND produced bytes) matches.\n308\t#[track_caller]\n309\tpub fn assert_out_eq(cn: i32, cbuf: &[u8], rn: i32, rbuf: &[u8], ctx: &str) {\n310\t    assert_eq!(cn, rn, \"{ctx}: return value mismatch C={cn} Rust={rn}\");\n311\t    if cn > 0 {\n312\t        let n = cn as usize;\n313\t        assert!(n <= cbuf.len() && n <= rbuf.len(), \"{ctx}: bogus length {n}\");\n314\t        assert_bytes_eq(&cbuf[..n], &rbuf[..n], ctx);\n315\t    }\n316\t}\n317\t\n318\t/// Same for `size_t`-returning frame APIs.\n319\t#[track_caller]\n320\tpub fn assert_sz_eq(cn: usize, cbuf: &[u8], rn: usize, rbuf: &[u8], ctx: &str) {\n321\t    assert_eq!(cn, rn, \"{ctx}: return mismatch C={cn:#x} Rust={rn:#x}\");\n322\t    if !is_lz4f_error(cn) && cn > 0 {\n323\t        assert_bytes_eq(&cbuf[..cn], &rbuf[..cn], ctx);\n324\t    }\n325\t}\n326\t\n327\t/// Mirrors `LZ4F_isError`: `code > (size_t)-LZ4F_ERROR_maxCode` (= `(usize)-24`).\n328\tpub fn is_lz4f_error(code: usize) -> bool {\n329\t    code > (0usize).wrapping_sub(24)\n330\t}\n331\t\n332\t/// `(size_t)-n`, i.e. the value `LZ4F_returnErrorCode` produces for ordinal `n`.\n333\tpub fn lz4f_err(n: usize) -> usize {\n334\t    (0usize).wrapping_sub(n)\n335\t}\n336\t\n337\t// ---------------------------------------------------------------------------\n338\t// 8-byte-aligned scratch buffer (LZ4_initStream / LZ4_initStreamHC require it)\n339\t// ---------------------------------------------------------------------------\n340\t\n341\t/// A heap buffer guaranteed to be 8-byte aligned (actually 16, via `Vec<u64>`).\n342\tpub struct Aligned {\n343\t    buf: Vec<u64>,\n344\t    len: usize,\n345\t}\n346\t\n347\timpl Aligned {\n348\t    pub fn new(len: usize) -> Self {\n349\t        Aligned {\n350\t            buf: vec![0u64; (len + 7) / 8 + 1],\n351\t            len,\n352\t        }\n353\t    }\n354\t    pub fn ptr(&mut self) -> *mut u8 {\n355\t        self.buf.as_mut_ptr() as *mut u8\n356\t    }\n357\t    pub fn len(&self) -> usize {\n358\t        self.len\n359\t    }\n360\t}\n361\t\n362\tpub const SIZEOF_LZ4_STREAM_T: usize = 16416;\n363\tpub const SIZEOF_LZ4_STREAMHC_T: usize = 262200;\n364\tpub const LZ4_MAX_INPUT_SIZE: i32 = 0x7E00_0000;\n365\tpub const LZ4_ACCELERATION_MAX: i32 = 65537;\n366\tpub const LZ4F_HEADER_SIZE_MAX: usize = 19;\n367\tpub const LZ4F_VERSION: u32 = 100;\n368\tpub const LZ4F_MAGICNUMBER: u32 = 0x184D_2204;\n369\t"}]},"parent_tool_use_id":"toolu_bdrk_018sW7qJeRE7yaPd45kLYPUS","session_id":"cf344e3a-451b-4037-95c8-f04f4dd0216c","uuid":"07d56c15-39e0-4f06-9df7-315e773b1735","timestamp":"2026-08-14T20:24:32.242Z","subagent_type":"general-purpose","task_description":"Write lz4frame diff tests"}
