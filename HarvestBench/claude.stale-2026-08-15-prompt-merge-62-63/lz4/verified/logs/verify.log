{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S8upzuBcWiESzfRPeme1NQ","type":"tool_result","content":"1163\t// ===========================================================================\n1164\t#[test]\n1165\tfn row62_partial_force_ext_dict() {\n1166\t    let enc = Enc::new();\n1167\t    sym!(pfed, \"LZ4_decompress_safe_partial_forceExtDict\", FnDecPartialForceExt);\n1168\t    let mut rng = Rng::new(0xD0_0062);\n1169\t\n1170\t    for &dsz in DICT_SIZES {\n1171\t        for &shape in ALL_SHAPES {\n1172\t            for &n in &[64usize, 1024, 4096] {\n1173\t                let whole = dict_case(shape, dsz, n, &mut rng);\n1174\t                let (dict, block) = whole.split_at(dsz);\n1175\t                let comp = enc.compress_after_dict(dict, block);\n1176\t                let cdict = separate_dict(dict);\n1177\t                let rdict = separate_dict(dict);\n1178\t\n1179\t                for &t in &targets_for(n) {\n1180\t                    for &cap in &[n, t.min(n)] {\n1181\t                        let mut cb = vec![0u8; cap + 64];\n1182\t                        let mut rb = vec![0u8; cap + 64];\n1183\t                        let (cn, rn) = unsafe {\n1184\t                            (\n1185\t                                pfed.0(\n1186\t                                    comp.ptr(),\n1187\t                                    cb.as_mut_ptr() as *mut c_char,\n1188\t                                    comp.n(),\n1189\t                                    t as c_int,\n1190\t                                    cap as c_int,\n1191\t                                    cdict.as_ptr() as *const c_void,\n1192\t                                    dsz,\n1193\t                                ),\n1194\t                                pfed.1(\n1195\t                                    comp.ptr(),\n1196\t                                    rb.as_mut_ptr() as *mut c_char,\n1197\t                                    comp.n(),\n1198\t                                    t as c_int,\n1199\t                                    cap as c_int,\n1200\t                                    rdict.as_ptr() as *const c_void,\n1201\t                                    dsz,\n1202\t                                ),\n1203\t                            )\n1204\t                        };\n1205\t                        let ctx = format!(\n1206\t                            \"partial_forceExtDict dsz={dsz} {shape:?} n={n} tgt={t} cap={cap}\"\n1207\t                        );\n1208\t                        chk(cn, &cb, rn, &rb, &ctx);\n1209\t                        assert!(cn >= 0, \"{ctx}: negative return {cn}\");\n1210\t                        let got = cn as usize;\n1211\t                        assert!(got <= cap, \"{ctx}: wrote {got} > cap {cap}\");\n1212\t                        assert_bytes_eq(&cb[..got], &block[..got], &format!(\"{ctx}: prefix\"));\n1213\t                        if t >= n && cap >= n {\n1214\t                            assert_eq!(cn, n as c_int, \"{ctx}: full decode expected\");\n1215\t                        }\n1216\t                    }\n1217\t                }\n1218\t            }\n1219\t        }\n1220\t    }\n1221\t}\n1222\t\n1223\t// ===========================================================================\n1224\t// Row 63 — LZ4_setStreamDecode + _safe_continue, UNIFORM blocks, one\n1225\t//          contiguous output buffer\n1226\t// ===========================================================================\n1227\t#[test]\n1228\tfn row63_safe_continue_uniform_contiguous() {\n1229\t    let enc = Enc::new();\n1230\t    sym!(csd, \"LZ4_createStreamDecode\", FnCreateSD);\n1231\t    sym!(fsd, \"LZ4_freeStreamDecode\", FnFreeSD);\n1232\t    sym!(ssd, \"LZ4_setStreamDecode\", FnSetSD);"}]},"parent_tool_use_id":"toolu_bdrk_01VsXBW9ahhWH6aeqQrmNV2M","session_id":"cf344e3a-451b-4037-95c8-f04f4dd0216c","uuid":"c0dbffe5-59d2-469f-9d2c-bcda5256258c","timestamp":"2026-08-14T18:46:01.660Z","subagent_type":