      std::ffi::CStr::from_ptr(vs.1()),\n74\t        );\n75\t        assert_eq!(cs, rs, \"LZ4_versionString\");\n76\t\n77\t        let mut sizes: Vec<c_int> = vec![\n78\t            i32::MIN,\n79\t            -1,\n80\t            0,\n81\t            1,\n82\t            2,\n83\t            15,\n84\t            16,\n85\t            17,\n86\t            64,\n87\t            1024,\n88\t            65535,\n89\t            65536,\n90\t            LZ4_MAX_INPUT_SIZE - 1,\n91\t            LZ4_MAX_INPUT_SIZE,\n92\t            LZ4_MAX_INPUT_SIZE + 1,\n93\t            i32::MAX,\n94\t        ];\n95\t        let mut rng = Rng::new(0xB0_0001);\n96\t        for _ in 0..2000 {\n97\t            sizes.push(rng.next_u32() as c_int);\n98\t        }\n99\t        for &s in &sizes {\n100\t            assert_ret_eq(bound.0(s), bound.1(s), &format!(\"LZ4_compressBound({s})\"));\n101\t            assert_ret_eq(\n102\t                drbs.0(s),\n103\t                drbs.1(s),\n104\t                &format!(\"LZ4_decoderRingBufferSize({s})\"),\n105\t            );\n106\t        }\n107\t    }\n108\t}\n109\t\n110\t// ---------------------------------------------------------------------------\n111\t// Rows 12-17 — LZ4_compress_default across shapes, tableTypes and sizes\n112\t// ---------------------------------------------------------------------------\n113\t#[test]\n114\tfn rows12_17_compress_default_shapes_and_sizes() {\n115\t    sym!(cd, \"LZ4_compress_default\", FnDefault);\n116\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n117\t    sym!(dec, \"LZ4_decompress_safe\", FnDecSafe);\n118\t    let mut rng = Rng::new(0xB0_0012);\n119\t\n120\t    for &len in KEY_LENS {\n121\t        for &shape in ALL_SHAPES {\n122\t            let src = gen_data(shape, len, &mut rng);\n123\t            let cap = unsafe { bound.0(len as c_int) }.max(1) as usize;\n124\t            let mut cb = vec![0u8; cap + 16];\n125\t            let mut rb = vec![0u8; cap + 16];\n126\t            let (cn, rn) = unsafe {\n127\t                (\n128\t                    cd.0(\n129\t                        src.as_ptr() as *const c_char,\n130\t                        cb.as_mut_ptr() as *mut c_char,\n131\t                        len as c_int,\n132\t                        cap as c_int,\n133\t                    ),\n134\t                    cd.1(\n135\t                        src.as_ptr() as *const c_char,\n136\t                        rb.as_mut_ptr() as *mut c_char,\n137\t                        len as c_int,\n138\t                        cap as c_int,\n139\t                    ),\n140\t                )\n141\t            };\n142\t            let ctx = format!(\"compress_default len={len} shape={shape:?}\");\n143\t            assert_out_eq(cn, &cb, rn, &rb, &ctx);\n144\t            if cn > 0 {\n145\t                check_roundtrip(&dec.0, &cb[..cn as usize], &src, &ctx);\n146\t            }\n147\t        }\n148\t    }\n149\t}\n150\t\n151\t// ---------------------------------------------------------------------------\n152\t// Rows 18, 20 — limitedOutput: dstCapacity swept below the bound\n153\t// ---------------------------------------------------------------------------\n154\t#[test]\n155\tfn rows18_20_limited_output_capacity_sweep() {\n156\t    sym!(cd, \"LZ4_compress_default\", FnDefault);\n157\t    sym!(cf, \"LZ4_compress_fast\", FnFast);\n158\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n159\t    let mut rng = Rng::new(0xB0_0018);\n160\t\n161\t    for &len in &[13usize, 64, 300, 1024, 4096, 65536, 65547, 100_000] {\n162\t        for &shape in ALL_SHAPES {\n163\t            let src = gen_data(shape, len, &mut rng);\n164\t            let full = unsafe { bound.0(len as c_int) }.max(1) as usize;\n165\t            // Determine the natural compressed size, then sweep around it.\n166\t            let mut probe = vec![0u8; full + 16];\n167\t            let natural = unsafe {\n168\t                cd.0(\n169\t                    src.as_ptr() as *const c_char,\n170\t                    prob