, const LZ4_streamHC_t* dictionary_stream);\nint LZ4_compress_HC_continue(LZ4_streamHC_t*, const char* src, char* dst, int srcSize, int maxDstSize);\nint LZ4_compress_HC_continue_destSize(LZ4_streamHC_t*, const char* src, char* dst, int* srcSizePtr, int targetDstSize);\nint LZ4_saveDictHC(LZ4_streamHC_t*, char* safeBuffer, int maxDictSize);\nvoid LZ4_setCompressionLevel(LZ4_streamHC_t*, int compressionLevel);\nvoid LZ4_favorDecompressionSpeed(LZ4_streamHC_t*, int favor);\nint LZ4_sizeofStreamStateHC(void);\nint LZ4_resetStreamStateHC(void* state, char* inputBuffer);\nvoid* LZ4_createHC(const char* inputBuffer);\nint LZ4_freeHC(void* LZ4HC_Data);\nchar* LZ4_slideInputBufferHC(void* LZ4HC_Data);\nint LZ4_compressHC(const char* source, char* dest, int inputSize);\nint LZ4_compressHC_limitedOutput(const char* source, char* dest, int inputSize, int maxOutputSize);\nint LZ4_compressHC2(const char* source, char* dest, int inputSize, int cLevel);\nint LZ4_compressHC2_limitedOutput(const char* source, char* dest, int inputSize, int maxOutputSize, int cLevel);\nint LZ4_compressHC_withStateHC(void* state, const char* source, char* dest, int inputSize);\nint LZ4_compressHC_limitedOutput_withStateHC(void* state, const char* source, char* dest, int inputSize, int maxOutputSize);\nint LZ4_compressHC2_withStateHC(void* state, const char* source, char* dest, int inputSize, int cLevel);\nint LZ4_compressHC2_limitedOutput_withStateHC(void* state, const char* source, char* dest, int inputSize, int maxOutputSize, int cLevel);\nint LZ4_compressHC_continue(void* LZ4HC_Data, const char* source, char* dest, int inputSize);\nint LZ4_compressHC_limitedOutput_continue(void* LZ4HC_Data, const char* source, char* dest, int inputSize, int maxOutputSize);\nint LZ4_compressionLevel_max(void);   /* exported from lz4frame */\n```\n`LZ4_compressBound` and `LZ4_decompress_safe`/`LZ4_decompress_safe_usingDict` (from lz4.h) are also available for sizing and round-trip verification.\n\n## Compression-level classes the C branches on (CRITICAL — must all be covered)\n`LZ4HC_getCLevelParams`: `cLevel < 1` -> clamped to 9; `cLevel > 12` -> clamped to 12; `cLevel == 1` is ACCEPTED (not clamped to 2). Levels 1-2 use the `lz4mid` algorithm, 3-9 the HC chain, 10-12 the optimal parser (`LZ4HC_CLEVEL_OPT_MIN`). `favorDecSpeed` is only consulted at levels >= 10.\n\n## Write ONE `#[test]` fn per CONFIGS.md row group, named `rowNN_...`:\n- row70/71/72: `LZ4_compress_HC` with cLevel 1..12 (plus 0, -1, 13, 100 which clamp) x `ALL_SHAPES` x input lengths. Use `KEY_LENS` for levels 1-9 and `SMALL_LENS` for levels 10-12 (the optimal parser is slow in a debug build). Verify return code + bytes + round trip via `LZ4_decompress_safe`.\n- row73: cLevel sweep x `limitedOutput` dstCapacity sweep (0,1,2,5, natural-1, natural, natural/2, natural/4, plus random values).\n- row74/75/76: dedicated tests pinning levels {1,2}, {3..9}, {10,11,12} across all shapes.\n- row77: `LZ4_compress_HC_extStateHC` with caller-owned aligned state x cLevel sweep.\n- row78: `LZ4_compress_HC_extStateHC_fastReset` — a FRESH state and then the SAME state REUSED across many calls (the fast-reset path) x cLevel sweep.\n- row79/80: `LZ4_compress_HC_destSize` (fillOutput) with targetDstSize swept x cLevel 1..12; make sure the sweep produces truncation so the \"dest overflow salvage\" paths at all three level classes are hit. Compare the returned size AND the updated `*srcSizePtr` AND the bytes.\n- row81/82: `LZ4_favorDecompressionSpeed(stream, favor)` with favor 0 and 1 (and nonzero values like -1, 12345) x cLevel {10,11,12} (row81) and {1..9} (row82), then `LZ4_compress_HC_continue`.\n- row83: `LZ4_setCompressionLevel` changing the level BETWEEN blocks on one stream, including 1<->12 (straddling the lz4mid boundary) and out-of-range values that clamp.\n- row84/85: `LZ4_createStreamHC` + `LZ4_compress_HC_continue` contiguous chain, UNIFORM block sizes (row84) and RANDOM block sizes (row85), x cLevel sweep.\n- row86: `LZ4_compress_HC_continue` with each block in its OWN allocation => non-contiguous => `LZ4HC_setExternalDict`, x cLevel sweep. This also exercises the exported `LZ4HC_searchExtDict` (CONFIGS row 98).\n- row87: a chain whose total exceeds 64 KB, plus many blocks, to exercise the dictionary-reload path.\n- row89/90: `LZ4_loadDictHC` on a dict stream + `LZ4_attach_HC_dictionary` on a working stream, then `LZ4_compress_HC_continue`. Cover COMPATIBLE levels (both <=2, or both >=3) with srcSize <= 4096 and > 4096, AND INCOMPATIBLE levels straddling the lz4mid boundary (e.g. dict stream at level 2, working stream at level 9, and vice versa). Also cover attaching NULL (detach).\n- row88: `LZ4_loadDictHC` dictSize sweep {0,1,3,4,8,9,64,1024,65535,65536,70000} x cLevel sweep, then a chain of blocks.\n- row91: `LZ4_saveDictHC` after a chain, maxDictSize in {0,1,3,4,64,1024,65536,70000,-1} x cLevel; compare return AND saved bytes AND that the stream stays usable identically afterwards.\n- row92: `LZ4_resetStreamHC` / `LZ4_resetStreamHC_fast` / `LZ4_initStreamHC` — reset then reuse; `resetStreamHC` and `initStreamHC` must be equivalent to a fresh stream.\n- row93: `LZ4_compress_HC_continue_destSize` chain with targetDestSize swept x cLevel.\n- row94/95/96/97: the deprecated wrappers (`LZ4_compressHC*`, `*_withStateHC`, `LZ4_compressHC_continue`, `LZ4_compressHC_limitedOutput_continue`, `LZ4_createHC`/`LZ4_freeHC`/`LZ4_slideInputBufferHC`/`LZ4_resetStreamStateHC`/`LZ4_sizeofStateHC`/`LZ4_sizeofStreamStateHC`/`LZ4_compressionLevel_max`).\n- row99: every HC-produced block round-trips through `LZ4_decompress_safe` (or `_usingDict` when a dictionary was used) back to the original bytes.\n\nFor EVERY call: compare the C and Rust return values AND the produced output bytes byte-for-byte. Use MANY randomized inputs per row with a FIXED seed.\n\n## CRITICAL RULES\n1. Do NOT modify anything under `c_src/`. Do NOT modify `tests/common/mod.rs`, `SYMBOLS.md`, `ERRORS.md`, `CONFIGS.md`, `Cargo.toml`, or `tests/block_compress.rs`.\n2. Watch out for DANGLING POINTERS in your own test code: HC streams keep raw pointers into your source buffers (`prefixStart`, `end`, `dictionary`). Any `Vec` whose address a stream retains MUST outlive every later call on that stream, including `LZ4_saveDictHC`. (A previous test had exactly this bug and it looked like a library divergence.)\n3. Keep the total runtime under ~5 minutes: levels 10-12 with the optimal parser are slow in a DEBUG build, so use `SMALL_LENS` and modest iteration counts for those.\n4. Build/iterate with: `timeout 600 cargo build 2>&1 | grep -E \"^error\"` then `timeout 600 cargo test --test hc 2>&1 | tail -40`. Iterate until it COMPILES and RUNS.\n5. If C and Rust genuinely DIVERGE: the C is ALWAYS correct. Fix the RUST implementation in `src/lz4hc.rs` (or `src/lz4.rs`) to match C exactly. Never weaken, delete, `#[ignore]`, or skip a test to make it pass. Never change an expected value to match Rust.\n   - Real bug class already found elsewhere: the Rust panics \"attempt to subtract with overflow\" where C does signed `ptrdiff_t` pointer subtraction that can go negative — fix with `wrapping_sub`/`wrapping_add` after confirming against the C source.\n6. In your FINAL REPORT state: (a) the exact test names created, (b) the final pass/fail count from your last `cargo test` run, (c) EVERY divergence found with the exact `src/*.rs` edit (file + line + before/after), (d) anything you could NOT get passing.\nDo not claim success without having actually run the tests."}]},"parent_tool_use_id":"toolu_bdrk_01Y4ushvz3xgK5E6YkGpuQp4","session_id":"cf344e3a-451b-4037-95c8-f04f4dd0216c","uuid":"2fcf9ae7-e136-483a-a8b6-0ca4702a6bfb","timestamp":"2026-08-14T18:16:35.785Z","subagent_type":"general-purpose","task_description":"Write lz4hc diff tests"}
