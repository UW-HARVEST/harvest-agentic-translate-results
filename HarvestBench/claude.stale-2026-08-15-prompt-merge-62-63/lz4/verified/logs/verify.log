    &format!(\"extState_fastReset r={round} len={len} {shape:?} acc={acc}\"),\n398\t                    );\n399\t                }\n400\t            }\n401\t        }\n402\t    }\n403\t}\n404\t\n405\t// ---------------------------------------------------------------------------\n406\t// Rows 24-26 — LZ4_compress_destSize / _destSize_extState (fillOutput)\n407\t// ---------------------------------------------------------------------------\n408\t#[test]\n409\tfn rows24_26_dest_size() {\n410\t    sym!(ds, \"LZ4_compress_destSize\", FnDestSize);\n411\t    sym!(dse, \"LZ4_compress_destSize_extState\", FnDestSizeExt);\n412\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n413\t    sym!(dec, \"LZ4_decompress_safe\", FnDecSafe);\n414\t    let mut rng = Rng::new(0xB0_0024);\n415\t\n416\t    let mut cst = Aligned::new(SIZEOF_LZ4_STREAM_T);\n417\t    let mut rst = Aligned::new(SIZEOF_LZ4_STREAM_T);\n418\t\n419\t    for &len in &[0usize, 1, 13, 64, 300, 1024, 4096, 65535, 65536, 65547, 100_000] {\n420\t        for &shape in ALL_SHAPES {\n421\t            let src = gen_data(shape, len, &mut rng);\n422\t            let full = unsafe { bound.0(len as c_int) }.max(1) as usize;\n423\t            let mut targets: Vec<usize> = vec![0, 1, 2, 3, 4, 5, 10, 17, full];\n424\t            for f in [1usize, 2, 4, 8, 16] {\n425\t                targets.push(full / f);\n426\t            }\n427\t            for _ in 0..10 {\n428\t                targets.push(rng.range(0, full));\n429\t            }\n430\t            targets.sort_unstable();\n431\t            targets.dedup();\n432\t\n433\t            for &tgt in &targets {\n434\t                // one-shot\n435\t                let mut csz = len as c_int;\n436\t                let mut rsz = len as c_int;\n437\t                let mut cb = vec![0u8; tgt + 32];\n438\t                let mut rb = vec![0u8; tgt + 32];\n439\t                let (cn, rn) = unsafe {\n440\t                    (\n441\t                        ds.0(\n442\t                            src.as_ptr() as *const c_char,\n443\t                            cb.as_mut_ptr() as *mut c_char,\n444\t                            &mut csz,\n445\t                            tgt as c_int,\n446\t                        ),\n447\t                        ds.1(\n448\t                            src.as_ptr() as *const c_char,\n449\t                            rb.as_mut_ptr() as *mut c_char,\n450\t                            &mut rsz,\n451\t                            tgt as c_int,\n452\t                        ),\n453\t                    )\n454\t                };\n455\t                let ctx = format!(\"destSize len={len} {shape:?} tgt={tgt}\");\n456\t                assert_eq!(csz, rsz, \"{ctx}: *srcSizePtr mismatch\");\n457\t                assert_out_eq(cn, &cb, rn, &rb, &ctx);\n458\t                if cn > 0 {\n459\t                    assert!(cn as usize <= tgt, \"{ctx}: exceeded targetDstSize\");\n460\t                    check_roundtrip(&dec.0, &cb[..cn as usize], &src[..csz as usize], &ctx);\n461\t                }\n462\t\n463\t                // ext-state variant, with an acceleration sweep\n464\t                for &acc in &[1i32, 0, 7, 65537] {\n465\t                    let mut csz = len as c_int;\n466\t                    let mut rsz = len as c_int;\n467\t                    let mut cb = vec![0u8; tgt + 32];\n468\t                    let mut rb = vec![0u8; tgt + 32];\n469\t                    let (cn, rn) = unsafe {\n470\t                        (\n471\t                            dse.0(\n472\t                                cst.ptr() as *mut c_void,\n473\t                                src.as_ptr() as *const c_char,\n474\t                                cb.as_mut_ptr() as *mut c_char,\n475\t                                &mut csz,\n476\t                                tgt as c_int,\n477\t                                acc,\n478\t                            ),\n479\t                            dse.1(\n480\t                                rst.ptr() as *mut c_void,\n481\t                                src.as_ptr() as *const c_char,\n482\t                                rb.as_mut_ptr() as *mut c_char,\n483\t                                &mut rsz,\n484\t                                tgt as c_int,\n485\t                                acc,\n486\t                            ),\n487\t                        )\n488\t                    };\n489\t                    let ctx = format!(\"destSize_extState len={len} {shape:?} tgt={tgt} acc={acc}\");\n490\t                    assert_eq!(csz, rsz, \"{ctx}: *srcSizePtr mismatch\");\n491\t                    assert_out_eq(cn, &cb, rn, &rb, &ctx);\n492\t                }\n493\t            }\n494\t        }\n495\t    }\n496\t}\n497\t\n498\t// ---------------------------------------------------------------------------\n499\t// Rows 27-29 — deprecated one-shot wrappers\n500\t// ---------------------------------------------------------------------------\n501\t#[test]\n502\tfn rows27_29_deprecated_oneshot() {\n503\t    sym!(c3, \"LZ4_compress\", FnCompress3);\n504\t    sym!(clo, \"LZ4_compress_limitedOutput\", FnDefault);\n505\t    sym!(cws, \"LZ4_compress_withState\", FnFastExt);\n506\t    sym!(clows, \"LZ4_compress_limitedOutput_withState\", FnFastExt);\n507\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n508\t    let mut rng = Rng::new(0xB0_0027);\n509\t\n510\t    let mut cst = Aligned::new(SIZEOF_LZ4_STREAM_T);\n511\t    let mut rst = Aligned::new(SIZEOF_LZ4_STREAM_T);\n512\t\n513\t    for &len in &[0usize, 1, 13, 64, 1024, 4096, 65535, 65536, 65547, 100_000] {\n514\t        for &shape in ALL_SHAPES {\n515\t            let src = gen_data(shape, len, &mut rng);\n516\t            let cap = unsafe { bound.0(len as c_int) }.max(1) as usize;\n517\t\n518\t            // LZ4_compress: notLimited, dst must be >= bound.\n519\t            let mut cb = vec![0u8; cap + 16];\n520\t            let mut rb = vec![0u8; cap + 16];\n521\t            let (cn, rn) = unsafe {\n522\t                (\n523\t                    c3.0(\n524\t                        src.as_ptr() as *const c_char,\n525\t                        cb.as_mut_ptr() as *mut c_char,\n526\t                        len as c_int,\n527\t                    ),\n528\t                    c3.1(\n529\t                        src.as_ptr() as *const c_char,\n530\t                        rb.as_mut_ptr() as *mut c_char,\n531\t                        len as c_int,\n532\t                    ),\n533\t                )\n534\t            };\n535\t            assert_out_eq(cn, &cb, rn, &rb, &format!(\"LZ4_compress len={len} {shape:?}\"));\n536\t\n537\t            // LZ4_compress_withState (notLimited, needs cap >= bound)\n538\t            let mut cb = vec![0u8; cap + 16];\n539\t            let mut rb = vec![0u8; cap + 16];\n540\t            let (cn, rn) = unsafe {\n541\t                (\n542\t                    cws.0(\n543\t                        cst.ptr() as *mut c_void,\n544\t                        src.as_ptr() as *const c_char,\n545\t                        cb.as_mut_ptr() as *mut c_char,\n546\t                        len as c_int,\n547\t                        0,\n548\t                        0,\n549\t                    ),\n550\t                    cws.1(\n551\t                        rst.ptr() as *mut c_void,\n552\t                        src.as_ptr() as *const c_char,\n553\t                        rb.as_mut_ptr() as *mut c_char,\n554\t                        len as c_int,\n555\t                        0,\n556\t                        0,\n557\t                    ),\n558\t                )\n559\t            };\n560\t            assert_out_eq(\n561\t                cn,\n562\t                &cb,\n563\t                rn,\n564\t                &rb,\n565\t                &format!(\"LZ4_compress_withState len={len} {shape:?}\"),\n566\t            );\n567\t\n568\t            // limitedOutput variants across a capacity sweep\n569\t            let mut caps: Vec<usize> = vec![0, 1, 2, 5, cap];\n570\t            for f in [2usize, 4, 8] {\n571\t                caps.push(cap / f);\n572\t            }\n573\t            caps.sort_unstable();\n574\t            caps.dedup();\n575\t            for &c in &caps {\n576\t                let mut cb = vec![0u8; c + 32];\n577\t                let mut rb = vec![0u8; c + 32];\n578\t                let (cn, rn) = unsafe {\n579\t                    (\n580\t                        clo.0(\n581\t                            src.as_ptr() as *const c_char,\n582\t                            cb.as_mut_ptr() as *mut c_char,\n583\t                            len as c_int,\n584\t                            c as c_int,\n585\t                        ),\n586\t                        clo.1(\n587\t                            src.as_ptr() as *const c_char,\n588\t                            rb.as_mut_ptr() as *mut c_char,\n589\t                            len as c_int,\n590\t                            c as c_int,\n591\t                        ),\n592\t                    )\n593\t                };\n594\t                assert_out_eq(\n595\t                    cn,\n596\t                    &cb,\n597\t                    rn,\n598\t                    &rb,\n599\t                    &format!(\"LZ4_compress_limitedOutput len={len} {shape:?} cap={c}\"),\n600\t                );\n601\t\n602\t                let mut cb = vec![0u8; c + 32];\n603\t                let mut rb = vec![0u8; c + 32];\n604\t                let (cn, rn) = unsafe {\n605\t                    (\n606\t                        clows.0(\n607\t                            cst.ptr() as *mut c_void,\n608\t                            src.as_ptr() as *const c_char,\n609\t                            cb.as_mut_ptr() as *mut c_char,\n610\t                            len as c_int,\n611\t                            c as c_int,\n612\t                            0,\n613\t                        ),\n614\t                        clows.1(\n615\t                            rst.ptr() as *mut c_void,\n616\t                            src.as_ptr() as *const c_char,\n617\t                            rb.as_mut_ptr() as *mut c_char,\n618\t                            len as c_int,\n619\t                            c as c_int,\n620\t                            0,\n621\t                        ),\n622\t                    )\n623\t                };\n624\t                assert_out_eq(\n625\t                    cn,\n626\t                    &cb,\n627\t                    rn,\n628\t                    &rb,\n629\t                    &format!(\"limitedOutput_withState len={len} {shape:?} cap={c}\"),\n630\t                );\n631\t            }\n632\t        }\n633\t    }\n634\t}\n635\t\n636\t// ---------------------------------------------------------------------------\n637\t// Rows 32-35 — contiguous-prefix streaming chains\n638\t// ---------------------------------------------------------------------------\n639\t#[test]\n640\tfn rows32_35_prefix_streaming() {\n641\t    sym!(cs, \"LZ4_createStream\", FnCreateStream);\n642\t    sym!(fs, \"LZ4_freeStream\", FnFreeStream);\n643\t    sym!(cont, \"LZ4_compress_fast_continue\", FnContinue);\n644\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n645\t    sym!(dec, \"LZ4_decompress_safe_usingDict\", FnDecUsingDict);\n646\t    let mut rng = Rng::new(0xB0_0032);\n647\t\n648\t    // Uniform block sizes (row 32) + random block sizes (row 33) + sizes that\n649\t    // keep the prefix under 64 KB so `dictSmall` engages (row 34) + chains that\n650\t    // cross 64 KB so `withPrefix64k` engages (row 35).\n651\t    let plans: &[(&str, usize, usize)] = &[\n652\t        (\"uniform-1k\", 1024, 40),\n653\t        (\"uniform-64\", 64, 60),\n654\t        (\"uniform-4k\", 4096, 40),\n655\t        (\"uniform-70k\", 70_000, 6),\n656\t        (\"dictSmall-100\", 100, 80),\n657\t        (\"cross64k-9k\", 9000, 20),\n658\t    ];\n659\t\n660\t    for &(name, blk, nblocks) in plans {\n661\t        for &shape in ALL_SHAPES {\n662\t            let total = blk * nblocks;\n663\t            let data = gen_data(shape, total, &mut rng);\n664\t            unsafe {\n665\t                let (csp, rsp) = (cs.0(), cs.1());\n666\t                assert!(!csp.is_null() && !rsp.is_null());\n667\t                for i in 0..nblocks {\n668\t                    let off = i * blk;\n669\t                    let n = blk.min(total - off);\n670\t                    let cap = bound.0(n as c_int).max(1) as usize;\n671\t                    let mut cb = vec![0u8; cap + 16];\n672\t                    let mut rb = vec![0u8; cap + 16];\n673\t                    let (cn, rn) = (\n674\t                        cont.0(\n675\t                            csp,\n676\t                            data[off..].as_ptr() as *const c_char,\n677\t                            cb.as_mut_ptr() as *mut c_char,\n678\t                            n as c_int,\n679\t                            cap as c_int,\n680\t                            1,\n681\t                        ),\n682\t                        cont.1(\n683\t                            rsp,\n684\t                            data[off..].as_ptr() as *const c_char,\n685\t                            rb.as_mut_ptr() as *mut c_char,\n686\t                            n as c_int,\n687\t                            cap as c_int,\n688\t                            1,\n689\t                        ),\n690\t                    );\n691\t                    assert_out_eq(\n692\t                        cn,\n693\t                        &cb,\n694\t                        rn,\n695\t                        &rb,\n696\t                        &format!(\"prefix chain {name} {shape:?} block {i}\"),\n697\t                    );\n698\t                    // Decode with the preceding bytes as the dictionary.\n699\t                    if cn > 0 {\n700\t                        let mut out = vec![0u8; n + 32];\n701\t                        let d = dec.0(\n702\t                            cb.as_ptr() as *const c_char,\n703\t                            out.as_mut_ptr() as *mut c_char,\n704\t                            cn,\n705\t                            n as c_int,\n706\t                            data.as_ptr() as *const c_char,\n707\t                            off as c_int,\n708\t                        );\n709\t                        assert_eq!(d, n as c_int, \"{name} {shape:?} block {i}: decode size\");\n710\t                        assert_bytes_eq(\n711\t                            &out[..n],\n712\t                            &data[off..off + n],\n713\t                            &format!(\"{name} {shape:?} block {i}: decoded data\"),\n714\t                        );\n715\t                    }\n716\t                }\n717\t                assert_ret_eq(fs.0(csp), fs.1(rsp), \"LZ4_freeStream\");\n718\t            }\n719\t        }\n720\t    }\n721\t\n722\t    // Random block sizes (row 33)\n723\t    for &shape in ALL_SHAPES {\n724\t        let total = 250_000usize;\n725\t        let data = gen_data(shape, total, &mut rng);\n726\t        unsafe {\n727\t            let (csp, rsp) = (cs.0(), cs.1());\n728\t            let mut off = 0usize;\n729\t            let mut i = 0;\n730\t            while off < total {\n731\t                let n = rng.range(1, 20_000).min(total - off);\n732\t                let cap = bound.0(n as c_int).max(1) as usize;\n733\t                let mut cb = vec![0u8; cap + 16];\n734\t                let mut rb = vec![0u8; cap + 16];\n735\t                let acc = *[1i32, 2, 9].get(rng.below(3)).unwrap();\n736\t                let (cn, rn) = (\n737\t                    cont.0(\n738\t                        csp,\n739\t                        data[off..].as_ptr() as *const c_char,\n740\t                        cb.as_mut_ptr() as *mut c_char,\n741\t                        n as c_int,\n742\t                        cap as c_int,\n743\t                        acc,\n744\t                    ),\n745\t                    cont.1(\n746\t                        rsp,\n747\t                        data[off..].as_ptr() as *const c_char,\n748\t                        rb.as_mut_ptr() as *mut c_char,\n749\t                        n as c_int,\n750\t                        cap as c_int,\n751\t                        acc,\n752\t                    ),\n753\t                );\n754\t                assert_out_eq(\n755\t                    cn,\n756\t                    &cb,\n757\t                    rn,\n758\t                    &rb,\n759\t                    &format!(\"random prefix chain {shape:?} block {i} n={n} acc={acc}\"),\n760\t                );\n761\t                off += n;\n762\t                i += 1;\n763\t            }\n764\t            fs.0(csp);\n765\t            fs.1(rsp);\n766\t        }\n767\t    }\n768\t}\n769\t\n770\ttype FnDecUsingDict =\n771\t    unsafe extern \"C\" fn(*const c_char, *mut c_char, c_int, c_int, *const c_char, c_int) -> c_int;\n772\t\n773\t// ---------------------------------------------------------------------------\n774\t// Row 36 — non-contiguous blocks => usingExtDict\n775\t// ---------------------------------------------------------------------------\n776\t#[test]\n777\tfn row36_ext_dict_streaming() {\n778\t    sym!(cs, \"LZ4_createStream\", FnCreateStream);\n779\t    sym!(fs, \"LZ4_freeStream\", FnFreeStream);\n780\t    sym!(cont, \"LZ4_compress_fast_continue\", FnContinue);\n781\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n782\t    let mut rng = Rng::new(0xB0_0036);\n783\t\n784\t    for &shape in ALL_SHAPES {\n785\t        for &blk in &[64usize, 1024, 9000, 70_000] {\n786\t            // Each block lives in its OWN allocation => guaranteed non-contiguous.\n787\t            let blocks: Vec<Vec<u8>> = (0..12).map(|_| gen_data(shape, blk, &mut rng)).collect();\n788\t            unsafe {\n789\t                let (csp, rsp) = (cs.0(), cs.1());\n790\t                for (i, b) in blocks.iter().enumerate() {\n791\t                    let cap = bound.0(blk as c_int).max(1) as usize;\n792\t                    let mut cb = vec![0u8; cap + 16];\n793\t                    let mut rb = vec![0u8; cap + 16];\n794\t                    let (cn, rn) = (\n795\t                        cont.0(\n796\t                            csp,\n797\t                            b.as_ptr() as *const c_char,\n798\t                            cb.as_mut_ptr() as *mut c_char,\n799\t                            blk as c_int,\n800\t                            cap as c_int,\n801\t                            1,\n802\t                        ),\n803\t                        cont.1(\n804\t                            rsp,\n805\t                            b.as_ptr() as *const c_char,\n806\t                            rb.as_mut_ptr() as *mut c_char,\n807\t                            blk as c_int,\n808\t                            cap as c_int,\n809\t                            1,\n810\t                        ),\n811\t                    );\n812\t                    assert_out_eq(\n813\t                        cn,\n814\t                        &cb,\n815\t                        rn,\n816\t                        &rb,\n817\t                        &format!(\"extDict chain {shape:?} blk={blk} i={i}\"),\n818\t                    );\n819\t                }\n820\t                fs.0(csp);\n821\t                fs.1(rsp);\n822\t            }\n823\t        }\n824\t    }\n825\t}\n826\t\n827\t// ---------------------------------------------------------------------------\n828\t// Row 37 — ring-buffer source\n829\t// ---------------------------------------------------------------------------\n830\t#[test]\n831\tfn row37_ring_buffer_source() {\n832\t    sym!(cs, \"LZ4_createStream\", FnCreateStream);\n833\t    sym!(fs, \"LZ4_freeStream\", FnFreeStream);\n834\t    sym!(cont, \"LZ4_compress_fast_continue\", FnContinue);\n835\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n836\t    sym!(drbs, \"LZ4_decoderRingBufferSize\", FnBound);\n837\t    let mut rng = Rng::new(0xB0_0037);\n838\t\n839\t    for &blk in &[1024usize, 4096, 9000] {\n840\t        let ring_sz = unsafe { drbs.0(blk as c_int) } as usize;\n841\t        assert!(ring_sz > 0);\n842\t        for &shape in ALL_SHAPES {\n843\t            let mut cring = vec![0u8; ring_sz];\n844\t            let mut rring = vec![0u8; ring_sz];\n845\t            unsafe {\n846\t                let (csp, rsp) = (cs.0(), cs.1());\n847\t                let mut pos = 0usize;\n848\t                for i in 0..40 {\n849\t                    if pos + blk > ring_sz {\n850\t                        pos = 0;\n851\t                    }\n852\t                    let chunk = gen_data(shape, blk, &mut rng);\n853\t                    cring[pos..pos + blk].copy_from_slice(&chunk);\n854\t                    rring[pos..pos + blk].copy_from_slice(&chunk);\n855\t                    let cap = bound.0(blk as c_int).max(1) as usize;\n856\t                    let mut cb = vec![0u8; cap + 16];\n857\t                    let mut rb = vec![0u8; cap + 16];\n858\t                    let (cn, rn) = (\n859\t                        cont.0(\n860\t                            csp,\n861\t                            cring[pos..].as_ptr() as *const c_char,\n862\t                            cb.as_mut_ptr() as *mut c_char,\n863\t                            blk as c_int,\n864\t                            cap as c_int,\n865\t                            1,\n866\t                        ),\n867\t                        cont.1(\n868\t                            rsp,\n869\t                            rring[pos..].as_ptr() as *const c_char,\n870\t                            rb.as_mut_ptr() as *mut c_char,\n871\t                            blk as c_int,\n872\t                            cap as c_int,\n873\t                            1,\n874\t                        ),\n875\t                    );\n876\t                    assert_out_eq(\n877\t                        cn,\n878\t                        &cb,\n879\t                        rn,\n880\t                        &rb,\n881\t                        &format!(\"ring src {shape:?} blk={blk} i={i} pos={pos}\"),\n882\t                    );\n883\t                    pos += blk;\n884\t                }\n885\t                fs.0(csp);\n886\t                fs.1(rsp);\n887\t            }\n888\t        }\n889\t    }\n890\t}\n891\t\n892\t// ---------------------------------------------------------------------------\n893\t// Rows 38-39 — LZ4_loadDict / LZ4_loadDictSlow + continue\n894\t// ---------------------------------------------------------------------------\n895\t#[test]\n896\tfn rows38_39_load_dict() {\n897\t    sym!(cs, \"LZ4_createStream\", FnCreateStream);\n898\t    sym!(fs, \"LZ4_freeStream\", FnFreeStream);\n899\t    sym!(ld, \"LZ4_loadDict\", FnLoadDict);\n900\t    sym!(lds, \"LZ4_loadDictSlow\", FnLoadDict);\n901\t    sym!(ldi, \"LZ4_loadDict_internal\", FnLoadDictInternal);\n902\t    sym!(cont, \"LZ4_compress_fast_continue\", FnContinue);\n903\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n904\t    let mut rng = Rng::new(0xB0_0038);\n905\t\n906\t    let dict_sizes = [0usize, 1, 4, 7, 8, 9, 64, 1024, 65535, 65536, 70_000];\n907\t    for &dsz in &dict_sizes {\n908\t        for &shape in ALL_SHAPES {\n909\t            let dict = gen_data(shape, dsz, &mut rng);\n910\t            for (which, f) in [(\"loadDict\", &ld), (\"loadDictSlow\", &lds)] {\n911\t                unsafe {\n912\t                    let (csp, rsp) = (cs.0(), cs.1());\n913\t                    let (cd, rd) = (\n914\t                        f.0(csp, dict.as_ptr() as *const c_char, dsz as c_int),\n915\t                        f.1(rsp, dict.as_ptr() as *const c_char, dsz as c_int),\n916\t                    );\n917\t                    assert_ret_eq(cd, rd, &format!(\"{which} dsz={dsz} {shape:?}\"));\n918\t                    for &blk in &[64usize, 1024, 9000] {\n919\t                        for i in 0..6 {\n920\t                            let src = gen_data(shape, blk, &mut rng);\n921\t                            let cap = bound.0(blk as c_int).max(1) as usize;\n922\t                            let mut cb = vec![0u8; cap + 16];\n923\t                            let mut rb = vec![0u8; cap + 16];\n924\t                            let (cn, rn) = (\n925\t                                cont.0(\n926\t                                    csp,\n927\t                                    src.as_ptr() as *const c_char,\n928\t                                    cb.as_mut_ptr() as *mut c_char,\n929\t                                    blk as c_int,\n930\t                                    cap as c_int,\n931\t                                    1,\n932\t                                ),\n933\t                                cont.1(\n934\t                                    rsp,\n935\t                                    src.as_ptr() as *const c_char,\n936\t                                    rb.as_mut_ptr() as *mut c_char,\n937\t                                    blk as c_int,\n938\t                                    cap as c_int,\n939\t                                    1,\n940\t                                ),\n941\t                            );\n942\t                            assert_out_eq(\n943\t                                cn,\n944\t                                &cb,\n945\t                                rn,\n946\t                                &rb,\n947\t                                &format!(\"{which} dsz={dsz} {shape:?} blk={blk} i={i}\"),\n948\t                            );\n949\t                        }\n950\t                    }\n951\t                    fs.0(csp);\n952\t                    fs.1(rsp);\n953\t                }\n954\t            }\n955\t            // LZ4_loadDict_internal is exported too: exercise both modes.\n956\t            for mode in 0..2i32 {\n957\t                unsafe {\n958\t                    let (csp, rsp) = (cs.0(), cs.1());\n959\t                    let (cd, rd) = (\n960\t                        ldi.0(csp, dict.as_ptr() as *const c_char, dsz as c_int, mode),\n961\t                        ldi.1(rsp, dict.as_ptr() as *const c_char, dsz as c_int, mode),\n962\t                    );\n963\t                    assert_ret_eq(\n964\t                        cd,\n965\t                        rd,\n966\t                        &format!(\"loadDict_internal mode={mode} dsz={dsz} {shape:?}\"),\n967\t                    );\n968\t                    let src = gen_data(shape, 4096, &mut rng);\n969\t                    let cap = bound.0(4096).max(1) as usize;\n970\t                    let mut cb = vec![0u8; cap + 16];\n971\t                    let mut rb = vec![0u8; cap + 16];\n972\t                    let (cn, rn) = (\n973\t                        cont.0(\n974\t                            csp,\n975\t                            src.as_ptr() as *const c_char,\n976\t                            cb.as_mut_ptr() as *mut c_char,\n977\t                            4096,\n978\t                            cap as c_int,\n979\t                            1,\n980\t                        ),\n981\t                        cont.1(\n982\t                            rsp,\n983\t                            src.as_ptr() as *const c_char,\n984\t                            rb.as_mut_ptr() as *mut c_char,\n985\t                            4096,\n986\t                            cap as c_int,\n987\t                            1,\n988\t                        ),\n989\t                    );\n990\t                    assert_out_eq(\n991\t                        cn,\n992\t                        &cb,\n993\t                        rn,\n994\t                        &rb,\n995\t                        &format!(\"loadDict_internal mode={mode} dsz={dsz} {shape:?} compress\"),\n996\t                    );\n997\t                    fs.0(csp);\n998\t                    fs.1(rsp);\n999\t                }\n1000\t            }\n1001\t        }\n1002\t    }\n1003\t}\n1004\t\n1005\ttype FnLoadDictInternal = unsafe extern \"C\" fn(*mut c_void, *const c_char, c_int, c_int) -> c_int;\n1006\t\n1007\t// ---------------------------------------------------------------------------\n1008\t// Rows 40-41 — LZ4_attach_dictionary (usingDictCtx), below/above the 4096 cutoff\n1009\t// ---------------------------------------------------------------------------\n1010\t#[test]\n1011\tfn rows40_41_attach_dictionary() {\n1012\t    sym!(cs, \"LZ4_createStream\", FnCreateStream);\n1013\t    sym!(fs, \"LZ4_freeStream\", FnFreeStream);\n1014\t    sym!(ld, \"LZ4_loadDict\", FnLoadDict);\n1015\t    sym!(at, \"LZ4_attach_dictionary\", FnAttach);\n1016\t    sym!(rsf, \"LZ4_resetStream_fast\", FnResetStream);\n1017\t    sym!(cont, \"LZ4_compress_fast_continue\", FnContinue);\n1018\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n1019\t    let mut rng = Rng::new(0xB0_0040);\n1020\t\n1021\t    for &dsz in &[0usize, 8, 64, 1024, 65536, 70_000] {\n1022\t        for &shape in ALL_SHAPES {\n1023\t            let dict = gen_data(shape, dsz, &mut rng);\n1024\t            unsafe {\n1025\t                let (cdict, rdict) = (cs.0(), cs.1());\n1026\t                let (cw, rw) = (cs.0(), cs.1());\n1027\t                assert_ret_eq(\n1028\t                    ld.0(cdict, dict.as_ptr() as *const c_char, dsz as c_int),\n1029\t                    ld.1(rdict, dict.as_ptr() as *const c_char, dsz as c_int),\n1030\t                    \"loadDict for attach\",\n1031\t                );\n1032\t                // srcSize <= 4096 (row 40) and > 4096 (bulk table copy, row 41)\n1033\t                for &blk in &[64usize, 1024, 4096, 4097, 9000, 70_000] {\n1034\t                    rsf.0(cw);\n1035\t                    rsf.1(rw);\n1036\t                    at.0(cw, cdict);\n1037\t                    at.1(rw, rdict);\n1038\t                    let src = gen_data(shape, blk, &mut rng);\n1039\t                    let cap = bound.0(blk as c_int).max(1) as usize;\n1040\t                    let mut cb = vec![0u8; cap + 16];\n1041\t                    let mut rb = vec![0u8; cap + 16];\n1042\t                    let (cn, rn) = (\n1043\t                        cont.0(\n1044\t                            cw,\n1045\t                            src.as_ptr() as *const c_char,\n1046\t                            cb.as_mut_ptr() as *mut c_char,\n1047\t                            blk as c_int,\n1048\t                            cap as c_int,\n1049\t                            1,\n1050\t                        ),\n1051\t                        cont.1(\n1052\t                            rw,\n1053\t                            src.as_ptr() as *const c_char,\n1054\t                            rb.as_mut_ptr() as *mut c_char,\n1055\t                            blk as c_int,\n1056\t                            cap as c_int,\n1057\t                            1,\n1058\t                        ),\n1059\t                    );\n1060\t                    assert_out_eq(\n1061\t                        cn,\n1062\t                        &cb,\n1063\t                        rn,\n1064\t                        &rb,\n1065\t                        &format!(\"attach_dictionary dsz={dsz} {shape:?} blk={blk}\"),\n1066\t                    );\n1067\t                    // A second block continues from the working prefix.\n1068\t                    let src2 = gen_data(shape, blk, &mut rng);\n1069\t                    let mut cb = vec![0u8; cap + 16];\n1070\t                    let mut rb = vec![0u8; cap + 16];\n1071\t                    let (cn, rn) = (\n1072\t                        cont.0(\n1073\t                            cw,\n1074\t                            src2.as_ptr() as *const c_char,\n1075\t                            cb.as_mut_ptr() as *mut c_char,\n1076\t                            blk as c_int,\n1077\t                            cap as c_int,\n1078\t                            1,\n1079\t                        ),\n1080\t                        cont.1(\n1081\t                            rw,\n1082\t                            src2.as_ptr() as *const c_char,\n1083\t                            rb.as_mut_ptr() as *mut c_char,\n1084\t                            blk as c_int,\n1085\t                            cap as c_int,\n1086\t                            1,\n1087\t                        ),\n1088\t                    );\n1089\t                    assert_out_eq(\n1090\t                        cn,\n1091\t                        &cb,\n1092\t                        rn,\n1093\t                        &rb,\n1094\t                        &format!(\"attach_dictionary 2nd dsz={dsz} {shape:?} blk={blk}\"),\n1095\t                    );\n1096\t                }\n1097\t                // Detach (NULL dictionaryStream) — ERRORS.md row 64.\n1098\t                rsf.0(cw);\n1099\t                rsf.1(rw);\n1100\t                at.0(cw, std::ptr::null());\n1101\t                at.1(rw, std::ptr::null());\n1102\t                let src = gen_data(shape, 2048, &mut rng);\n1103\t                let cap = bound.0(2048) as usize;\n1104\t                let mut cb = vec![0u8; cap + 16];\n1105\t                let mut rb = vec![0u8; cap + 16];\n1106\t                let (cn, rn) = (\n1107\t                    cont.0(\n1108\t                        cw,\n1109\t                        src.as_ptr() as *const c_char,\n1110\t                        cb.as_mut_ptr() as *mut c_char,\n1111\t                        2048,\n1112\t                        cap as c_int,\n1113\t                        1,\n1114\t                    ),\n1115\t                    cont.1(\n1116\t                        rw,\n1117\t                        src.as_ptr() as *const c_char,\n1118\t                        rb.as_mut_ptr() as *mut c_char,\n1119\t                        2048,\n1120\t                        cap as c_int,\n1121\t                        1,\n1122\t                    ),\n1123\t                );\n1124\t                assert_out_eq(cn, &cb, rn, &rb, &format!(\"detach dsz={dsz} {shape:?}\"));\n1125\t                for p in [cdict, cw] {\n1126\t                    fs.0(p);\n1127\t                }\n1128\t                for p in [rdict, rw] {\n1129\t                    fs.1(p);\n1130\t                }\n1131\t            }\n1132\t        }\n1133\t    }\n1134\t}\n1135\t\n1136\t// ---------------------------------------------------------------------------\n1137\t// Row 42 — LZ4_saveDict\n1138\t// ---------------------------------------------------------------------------\n1139\t#[test]\n1140\tfn row42_save_dict() {\n1141\t    sym!(cs, \"LZ4_createStream\", FnCreateStream);\n1142\t    sym!(fs, \"LZ4_freeStream\", FnFreeStream);\n1143\t    sym!(cont, \"LZ4_compress_fast_continue\", FnContinue);\n1144\t    sym!(sd, \"LZ4_saveDict\", FnSaveDict);\n1145\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n1146\t    let mut rng = Rng::new(0xB0_0042);\n1147\t\n1148\t    for &shape in ALL_SHAPES {\n1149\t        for &pre in &[0usize, 64, 1024, 40_000, 100_000] {\n1150\t            for &want in &[0i32, 1, 4, 64, 1024, 65536, 70_000, -1] {\n1151\t                // NOTE: `data` must outlive the saveDict call — the stream keeps\n1152\t                // a raw `dictionary` pointer into it.\n1153\t                let data = gen_data(shape, pre, &mut rng);\n1154\t                unsafe {\n1155\t                    let (csp, rsp) = (cs.0(), cs.1());\n1156\t                    if pre > 0 {\n1157\t                        let cap = bound.0(pre as c_int) as usize;\n1158\t                        let mut cb = vec![0u8; cap + 16];\n1159\t                        let mut rb = vec![0u8; cap + 16];\n1160\t                        let (cn, rn) = (\n1161\t                            cont.0(\n1162\t                                csp,\n1163\t                                data.as_ptr() as *const c_char,\n1164\t                                cb.as_mut_ptr() as *mut c_char,\n1165\t                                pre as c_int,\n1166\t                                cap as c_int,\n1167\t                                1,\n1168\t                            ),\n1169\t                            cont.1(\n1170\t                                rsp,\n1171\t                                data.as_ptr() as *const c_char,\n1172\t                                rb.as_mut_ptr() as *mut c_char,\n1173\t                                pre as c_int,\n1174\t                                cap as c_int,\n1175\t                                1,\n1176\t                            ),\n1177\t                        );\n1178\t                        assert_out_eq(cn, &cb, rn, &rb, \"saveDict setup compress\");\n1179\t                    }\n1180\t                    let mut csafe = vec![0u8; 80_000];\n1181\t                    let mut rsafe = vec![0u8; 80_000];\n1182\t                    let (cn, rn) = (\n1183\t                        sd.0(csp, csafe.as_mut_ptr() as *mut c_char, want),\n1184\t                        sd.1(rsp, rsafe.as_mut_ptr() as *mut c_char, want),\n1185\t                    );\n1186\t                    let ctx = format!(\"saveDict {shape:?} pre={pre} want={want}\");\n1187\t                    assert_ret_eq(cn, rn, &ctx);\n1188\t                    assert!(cn >= 0, \"{ctx}: saveDict returned {cn}\");\n1189\t                    assert_bytes_eq(&csafe[..cn as usize], &rsafe[..cn as usize], &ctx);\n1190\t\n1191\t                    // The stream must remain usable, and identically so.\n1192\t                    let nxt = gen_data(shape, 3000, &mut rng);\n1193\t                    let cap = bound.0(3000) as usize;\n1194\t                    let mut cb = vec![0u8; cap + 16];\n1195\t                    let mut rb = vec![0u8; cap + 16];\n1196\t                    let (cn2, rn2) = (\n1197\t                        cont.0(\n1198\t                            csp,\n1199\t                            nxt.as_ptr() as *const c_char,\n1200\t                            cb.as_mut_ptr() as *mut c_char,\n1201\t                            3000,\n1202\t                            cap as c_int,\n1203\t                            1,\n1204\t                        ),\n1205\t                        cont.1(\n1206\t                            rsp,\n1207\t                            nxt.as_ptr() as *const c_char,\n1208\t                            rb.as_mut_ptr() as *mut c_char,\n1209\t                            3000,\n1210\t                            cap as c_int,\n1211\t                            1,\n1212\t                        ),\n1213\t                    );\n1214\t                    assert_out_eq(cn2, &cb, rn2, &rb, &format!(\"{ctx}: after-save compress\"));\n1215\t                    fs.0(csp);\n1216\t                    fs.1(rsp);\n1217\t                }\n1218\t            }\n1219\t        }\n1220\t    }\n1221\t}\n1222\t\n1223\t// ---------------------------------------------------------------------------\n1224\t// Row 43 — reset paths must be equivalent to a fresh stream\n1225\t// ---------------------------------------------------------------------------\n1226\t#[test]\n1227\tfn row43_reset_paths() {\n1228\t    sym!(cs, \"LZ4_createStream\", FnCreateStream);\n1229\t    sym!(fs, \"LZ4_freeStream\", FnFreeStream);\n1230\t    sym!(rst, \"LZ4_resetStream\", FnResetStream);\n1231\t    sym!(rstf, \"LZ4_resetStream_fast\", FnResetStream);\n1232\t    sym!(init, \"LZ4_initStream\", FnInitStream);\n1233\t    sym!(cont, \"LZ4_compress_fast_continue\", FnContinue);\n1234\t    sym!(bound, \"LZ4_compressBound\", FnBound);\n1235\t    let mut rng = Rng::new(0xB0_0043);\n1236\t\n1237\t    for &shape in ALL_SHAPES {\n1238\t        let a = gen_data(shape, 5000, &mut rng);\n1239\t        let b = gen_data(shape, 5000, &mut rng);\n1240\t        let cap = unsafe { bound.0(5000) } as usize;\n1241\t\n1242\t        // Reference: fresh stream compressing `b` alone.\n1243\t        let mut refbuf = vec![0u8; cap + 16];\n1244\t        let refn = unsafe {\n1245\t            let s = cs.0();\n1246\t            let n = cont.0(\n1247\t                s,\n1248\t                b.as_ptr() as *const c_char,\n1249\t                refbuf.as_mut_ptr() as *mut c_char,\n1250\t                5000,\n1251\t                cap as c_int,\n1252\t                1,\n1253\t            );\n1254\t            fs.0(s);\n1255\t            n\n1256\t        };\n1257\t\n1258\t        for which in 0..3 {\n1259\t            unsafe {\n1260\t                let (csp, rsp) = (cs.0(), cs.1());\n1261\t                // Dirty both streams with `a`.\n1262\t                let mut t = vec![0u8; cap + 16];\n1263\t                cont.0(\n1264\t                    csp,\n1265\t                    a.as_ptr() as *const c_char,\n1266\t                    t.as_mut_ptr() as *mut c_char,\n1267\t                    5000,\n1268\t                    cap as c_int,\n1269\t                    1,\n1270\t                );\n1271\t                cont.1(\n1272\t                    rsp,\n1273\t                    a.as_ptr() as *const c_char,\n1274\t                    t.as_mut_ptr() as *mut c_char,\n1275\t                    5000,\n1276\t                    cap as c_int,\n1277\t                    1,\n1278\t                );\n1279\t                match which {\n1280\t                    0 => {\n1281\t                        rst.0(csp);\n1282\t                        rst.1(rsp);\n1283\t                    }\n1284\t                    1 => {\n1285\t                        rstf.0(csp);\n1286\t                        rstf.1(rsp);\n1287\t                    }\n1288\t                    _ => {\n1289\t                        assert!(!init.0(csp, SIZEOF_LZ4_STREAM_T).is_null());\n1290\t                        assert!(!init.1(rsp, SIZEOF_LZ4_STREAM_T).is_null());\n1291\t                    }\n1292\t                }\n1293\t                let mut cb = vec![0u8; cap + 16];\n1294\t                let mut rb = vec![0u8; cap + 16];\n1295\t                let (cn, rn) = (\n1296\t                    cont.0(\n1297\t                        csp,\n1298\t                        b.as_ptr() as *const c_char,\n1299\t                        cb.as_mut_ptr() as *mut c