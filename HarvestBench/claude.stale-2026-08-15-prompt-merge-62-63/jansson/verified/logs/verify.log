ut json_t> = sym(&l.c, \"json_array\");\n        let aapp: Symbol<FnArrAppendNew> = sym(&l.c, \"json_array_append_new\");\n        let a = arr();\n        incref(a);\n        assert_eq!((*a).refcount, 2);\n        assert_eq!(aapp(a, a), -1, \"self-append must be rejected\");\n        assert_eq!((*a).refcount, 1, \"self-append must consume the reference\");\n        decref(&l.c, a);\n    }\n}\n\n#[test]\nfn index_one_past_valid_range() {"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1777,"cache_read_input_tokens":381257,"cache_creation":{"ephemeral_5m_input_tokens":1777,"ephemeral_1h_input_tokens":0},"output_tokens":20,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c1ef89ae-e696-4035-a7a9-923ffb551939","uuid":"ffa39c1d-3604-4ae5-8bab-19c214aac5e9","timestamp":"2026-08-14T15:47:37.310Z"}
