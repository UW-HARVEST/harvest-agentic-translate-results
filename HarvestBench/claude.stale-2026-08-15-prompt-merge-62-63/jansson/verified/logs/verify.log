{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Kt4e1uXNZSojwwKRWR5e4i","type":"tool_result","content":"1\t//! Shared differential-test harness.\n2\t//!\n3\t//! Loads BOTH the C `libjansson.so` and the Rust `libjansson.so` through\n4\t//! `libloading` and calls them purely through their exported C ABI, exactly as\n5\t//! an external consumer would. Rust functions are NEVER called directly, so the\n6\t//! `#[no_mangle]` export wrappers are exercised too.\n7\t\n8\t#![allow(dead_code)]\n9\t#![allow(non_camel_case_types)]\n10\t\n11\tuse libloading::{Library, Symbol};\n12\tuse std::ffi::{c_char, c_double, c_int, c_longlong, c_void, CStr, CString};\n13\tuse std::fmt::Debug;\n14\tuse std::path::PathBuf;\n15\tuse std::sync::OnceLock;\n16\t\n17\t// ---------------------------------------------------------------- ABI types\n18\t\n19\tpub type json_int_t = c_longlong;\n20\t\n21\t#[repr(C)]\n22\tpub struct json_t {\n23\t    pub type_: c_int,\n24\t    pub refcount: usize,\n25\t}\n26\t\n27\tpub const JSON_ERROR_TEXT_LENGTH: usize = 160;\n28\tpub const JSON_ERROR_SOURCE_LENGTH: usize = 80;\n29\t\n30\t#[repr(C)]\n31\t#[derive(Clone)]\n32\tpub struct json_error_t {\n33\t    pub line: c_int,\n34\t    pub column: c_int,\n35\t    pub position: c_int,\n36\t    pub source: [c_char; JSON_ERROR_SOURCE_LENGTH],\n37\t    pub text: [c_char; JSON_ERROR_TEXT_LENGTH],\n38\t}\n39\t\n40\timpl json_error_t {\n41\t    pub fn new() -> Self {\n42\t        json_error_t { line: 0, column: 0, position: 0, source: [0; 80], text: [0; 160] }\n43\t    }\n44\t    /// Mirrors the `json_error_code()` static inline in jansson.h:\n45\t    /// `(enum json_error_code)e->text[JSON_ERROR_TEXT_LENGTH - 1]`\n46\t    pub fn code(&self) -> i32 {\n47\t        self.text[JSON_ERROR_TEXT_LENGTH - 1] as i32\n48\t    }\n49\t    pub fn text_str(&self) -> String {\n50\t        cstr_to_string(self.text.as_ptr())\n51\t    }\n52\t    pub fn source_str(&self) -> String {\n53\t        cstr_to_string(self.source.as_ptr())\n54\t    }\n55\t    /// Full comparable snapshot of the error struct.\n56\t    pub fn snapshot(&self) -> ErrSnap {\n57\t        ErrSnap {\n58\t            line: self.line,\n59\t            column: self.column,\n60\t            position: self.position,\n61\t            source: self.source_str(),\n62\t            text: self.text_str(),\n63\t            code: self.code(),\n64\t        }\n65\t    }\n66\t}\n67\t\n68\timpl Default for json_error_t {\n69\t    fn default() -> Self {\n70\t        Self::new()\n71\t    }\n72\t}\n73\t\n74\t#[derive(PartialEq, Eq, Debug, Clone)]\n75\tpub struct ErrSnap {\n76\t    pub line: c_int,\n77\t    pub column: c_int,\n78\t    pub position: c_int,\n79\t    pub source: String,\n80\t    pub text: String,\n81\t    pub code: i32,\n82\t}\n83\t\n84\t// json_type\n85\tpub const JSON_OBJECT: c_int = 0;\n86\tpub const JSON_ARRAY: c_int = 1;\n87\tpub const JSON_STRING: c_int = 2;\n88\tpub const JSON_INTEGER: c_int = 3;\n89\tpub const JSON_REAL: c_int = 4;\n90\tpub const JSON_TRUE: c_int = 5;\n91\tpub const JSON_FALSE: c_int = 6;\n92\tpub const JSON_NULL: c_int = 7;\n93\t\n94\t// enum json_error_code\n95\tpub const JSON_ERROR_UNKNOWN: i32 = 0;\n96\tpub const JSON_ERROR_OUT_OF_MEMORY: i32 = 1;\n97\tpub const JSON_ERROR_STACK_OVERFLOW: i32 = 2;\n98\tpub const JSON_ERROR_CANNOT_OPEN_FILE: i32 = 3;\n99\tpub const JSON_ERROR_INVALID_ARGUMENT: i32 = 4;\n100\tpub const JSON_ERROR_INVALID_UTF8: i32 = 5;\n101\tpub const JSON_ERROR_PREMATURE_END_OF_INPUT: i32 = 6;\n102\tpub const JSON_ERROR_END_OF_INPUT_EXPECTED: i32 = 7;\n103\tpub const JSON_ERROR_INVALID_SYNTAX: i32 = 8;\n104\tpub const JSON_ERROR_INVALID_FORMAT: i32 = 9;\n105\tpub const JSON_ERROR_WRONG_TYPE: i32 = 10;\n106\tpub const JSON_ERROR_NULL_CHARACTER: i32 = 11;\n107\tpub const JSON_ERROR_NULL_VALUE: i32 = 12;\n108\tpub const JSON_ERROR_NULL_BYTE_IN_KEY: i32 = 13;\n109\tpub const JSON_ERROR_DUPLICATE_KEY: i32 = 14;\n110\tpub const JSON_ERROR_NUMERIC_OVERFLOW: i32 = 15;\n111\tpub const JSON_ERROR_ITEM_NOT_FOUND: i32 = 16;\n112\tpub const JSON_ERROR_INDEX_OUT_OF_RANGE: i32 = 17;\n113\t\n114\t// decoder flags\n115\tpub const JSON_REJECT_DUPLICATES: usize = 0x1;\n116\tpub const JSON_DISABLE_EOF_CHECK: usize = 0x2;\n117\tpub const JSON_DECODE_ANY: usize = 0x4;\n118\tpub const JSON_DECODE_INT_AS_REAL: usize = 0x8;\n119\tpub const JSON_ALLOW_NUL: usize = 0x10;\n120\t\n121\t// encoder flags\n122\tpub const JSON_MAX_INDENT: usize = 0x1F;\n123\tpub const JSON_COMPACT: usize = 0x20;\n124\tpub const JSON_ENSURE_ASCII: usize = 0x40;\n125\tpub const JSON_SORT_KEYS: usize = 0x80;\n126\tpub const JSON_PRESERVE_ORDER: usize = 0x100;\n127\tpub const JSON_ENCODE_ANY: usize = 0x200;\n128\tpub const JSON_ESCAPE_SLASH: usize = 0x400;\n129\tpub const JSON_EMBED: usize = 0x10000;\n130\t\n131\tpub fn json_indent(n: usize) -> usize {\n132\t    n & JSON_MAX_INDENT\n133\t}\n134\tpub fn json_real_precision(n: usize) -> usize {\n135\t    (n & 0x1F) << 11\n136\t}\n137\t\n138\t// pack/unpack flags\n139\tpub const JSON_VALIDATE_ONLY: usize = 0x1;\n140\tpub const JSON_STRICT: usize = 0x2;\n141\t\n142\t// ---------------------------------------------------------------- lib loading\n143\t\n144\tpub struct Libs {\n145\t    pub c: Library,\n146\t    pub r: Library,\n147\t}\n148\t\n149\tfn manifest_dir() -> PathBuf {\n150\t    PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n151\t}\n152\t\n153\tfn c_so_path() -> PathBuf {\n154\t    if let Ok(p) = std::env::var(\"C_JANSSON_SO\") {\n155\t        return PathBuf::from(p);\n156\t    }\n157\t    let root = manifest_dir();\n158\t    for cand in [\"cbuild/libjansson.so\", \"c_src/build/libjansson.so\"] {\n159\t        let p = root.join(cand);\n160\t        if p.exists() {\n161\t            return p;\n162\t        }\n163\t    }\n164\t    panic!(\"C libjansson.so not found; build it first (see CMakeLists.txt)\");\n165\t}\n166\t\n167\tfn rust_so_path() -> PathBuf {\n168\t    if let Ok(p) = std::env::var(\"RUST_JANSSON_SO\") {\n169\t        return PathBuf::from(p);\n170\t    }\n171\t    // Prefer the artifact matching the current test profile, then fall back.\n172\t    let root = manifest_dir();\n173\t    let mut best: Option<(std::time::SystemTime, PathBuf)> = None;\n174\t    for cand in [\"target/release/libjansson.so\", \"target/debug/libjansson.so\"] {\n175\t        let p = root.join(cand);\n176\t        if let Ok(md) = std::fs::metadata(&p) {\n177\t            let t = md.modified().unwrap_or(std::time::UNIX_EPOCH);\n178\t            if best.as_ref().map(|(bt, _)| t > *bt).unwrap_or(true) {\n179\t                best = Some((t, p));\n180\t            }\n181\t        }\n182\t    }\n183\t    best.map(|(_, p)| p)\n184\t        .expect(\"Rust libjansson.so not found; run `cargo build` (or --release) first\")\n185\t}\n186\t\n187\tstatic LIBS: OnceLock<Libs> = OnceLock::new();\n188\t\n189\t/// Fixed hash seed applied to BOTH libraries before any object is created.\n190\t///\n191\t/// `json_object_seed(0)` would pull entropy from /dev/urandom, making object\n192\t/// iteration order (and therefore `json_dumps` key order) differ between the two\n193\t/// libraries and between runs. Seeding both with the same non-zero value makes\n194\t/// every object-order-dependent comparison deterministic and reproducible.\n195\t/// Note the C only honours this while `hashtable_seed == 0`, i.e. it must happen\n196\t/// before the first hashtable use — hence doing it here at load time.\n197\tpub const FIXED_SEED: usize = 0x5eed_1234;\n198\t\n199\tpub fn libs() -> &'static Libs {\n200\t    LIBS.get_or_init(|| unsafe {\n201\t        let c = Library::new(c_so_path()).expect(\"failed to dlopen C libjansson.so\");\n202\t        let r = Library::new(rust_so_path()).expect(\"failed to dlopen Rust libjansson.so\");\n203\t        type FnSeed = unsafe extern \"C\" fn(usize);\n204\t        let cs: Symbol<FnSeed> = sym(&c, \"json_object_seed\");\n205\t        cs(FIXED_SEED);\n206\t        let rs: Symbol<FnSeed> = sym(&r, \"json_object_seed\");\n207\t        rs(FIXED_SEED);\n208\t        Libs { c, r }\n209\t    })\n210\t}\n211\t\n212\t/// Fetch an exported symbol, panicking with a useful message if absent.\n213\tpub unsafe fn sym<'a, T>(lib: &'a Library, name: &str) -> Symbol<'a, T> {\n214\t    lib.get::<T>(name.as_bytes())\n215\t        .unwrap_or_else(|e| panic!(\"symbol `{}` missing from .so: {}\", name, e))\n216\t}\n217\t\n218\t/// Run `f` against the C library and the Rust library and assert the results\n219\t/// are identical. `f` receives the `Library` handle and must drive the API only\n220\t/// through exported symbols.\n221\t#[track_caller]\n222\tpub fn diff<T: PartialEq + Debug>(label: &str, f: impl Fn(&Library) -> T) {\n223\t    let l = libs();\n224\t    let cv = f(&l.c);\n225\t    let rv = f(&l.r);\n226\t    assert_eq!(cv, rv, \"C/Rust divergence in [{}]\\n  C   = {:?}\\n  Rust= {:?}\", label, cv, rv);\n227\t}\n228\t\n229\t/// Like `diff` but the closure also gets a per-iteration index, for\n230\t/// property-style randomized runs.\n231\t#[track_caller]\n232\tpub fn diff_n<T: PartialEq + Debug>(label: &str, n: u64, f: impl Fn(&Library, u64) -> T) {\n233\t    let l = libs();\n234\t    for i in 0..n {\n235\t        let cv = f(&l.c, i);\n236\t        let rv = f(&l.r, i);\n237\t        assert_eq!(\n238\t            cv, rv,\n239\t            \"C/Rust divergence in [{}] iteration {}\\n  C   = {:?}\\n  Rust= {:?}\",\n240\t            label, i, cv, rv\n241\t        );\n242\t    }\n243\t}\n244\t\n245\t// ---------------------------------------------------------------- utilities\n246\t\n247\tpub fn cstr_to_string(p: *const c_char) -> String {\n248\t    if p.is_null() {\n249\t        return \"<null>\".to_string();\n250\t    }\n251\t    unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()\n252\t}\n253\t\n254\t/// Owned NUL-terminated C string (keeps the CString alive for the call).\n255\tpub fn cs(s: &str) -> CString {\n256\t    CString::new(s).expect(\"interior NUL: use cs_bytes instead\")\n257\t}\n258\t\n259\t/// NUL-terminated buffer that MAY contain interior NUL bytes.\n260\tpub fn cs_bytes(b: &[u8]) -> Vec<u8> {\n261\t    let mut v = b.to_vec();\n262\t    v.push(0);\n263\t    v\n264\t}\n265\t\n266\t/// Deterministic xorshift64* PRNG so every randomized row is reproducible.\n267\tpub struct Rng(u64);\n268\t\n269\timpl Rng {\n270\t    pub fn new(seed: u64) -> Self {\n271\t        Rng(if seed == 0 { 0x9E3779B97F4A7C15 } else { seed })\n272\t    }\n273\t    pub fn next_u64(&mut self) -> u64 {\n274\t        let mut x = self.0;\n275\t        x ^= x >> 12;\n276\t        x ^= x << 25;\n277\t        x ^= x >> 27;\n278\t        self.0 = x;\n279\t        x.wrapping_mul(0x2545F4914F6CDD1D)\n280\t    }\n281\t    pub fn below(&mut self, n: u64) -> u64 {\n282\t        if n == 0 {\n283\t            0\n284\t        } else {\n285\t            self.next_u64() % n\n286\t        }\n287\t    }\n288\t    pub fn i64(&mut self) -> i64 {\n289\t        self.next_u64() as i64\n290\t    }\n291\t    /// Arbitrary double from random bits (may be NaN/inf).\n292\t    pub fn f64_bits(&mut self) -> f64 {\n293\t        f64::from_bits(self.next_u64())\n294\t    }\n295\t    /// Finite double in a \"reasonable\" range.\n296\t    pub fn f64_finite(&mut self) -> f64 {\n297\t        loop {\n298\t            let d = f64::from_bits(self.next_u64());\n299\t            if d.is_finite() {\n300\t                return d;\n301\t            }\n302\t        }\n303\t    }\n304\t    pub fn ascii_string(&mut self, maxlen: usize) -> String {\n305\t        let n = (self.below(maxlen as u64 + 1)) as usize;\n306\t        (0..n)\n307\t            .map(|_| {\n308\t                let c = 0x20u8 + (self.below(0x5f) as u8);\n309\t                c as char\n310\t            })\n311\t            .collect()\n312\t    }\n313\t    /// String drawn from a pool that includes escape-worthy and multi-byte UTF-8.\n314\t    pub fn utf8_string(&mut self, maxlen: usize) -> String {\n315\t        const POOL: &[&str] = &[\n316\t            \"a\", \"Z\", \"0\", \" \", \"\\\"\", \"\\\\\", \"/\", \"\\u{8}\", \"\\u{c}\", \"\\n\", \"\\r\", \"\\t\", \"\\u{1}\",\n317\t            \"\\u{1f}\", \"\\u{7f}\", \"é\", \"ß\", \"€\", \"中\", \"日\", \"\\u{10348}\", \"𝄞\", \"😀\", \"\\u{a0}\",\n318\t            \"\\u{2028}\", \"~\", \"}\", \"{\", \"[\", \"]\", \":\", \",\",\n319\t        ];\n320\t        let n = (self.below(maxlen as u64 + 1)) as usize;\n321\t        let mut s = String::new();\n322\t        for _ in 0..n {\n323\t            s.push_str(POOL[self.below(POOL.len() as u64) as usize]);\n324\t        }\n325\t        s\n326\t    }\n327\t}\n328\t\n329\t// ---------------------------------------------------------------- fn types\n330\t\n331\tpub type FnVoidPtr = unsafe extern \"C\" fn() -> *mut json_t;\n332\tpub type FnStr = unsafe extern \"C\" fn(*const c_char) -> *mut json_t;\n333\tpub type FnStrN = unsafe extern \"C\" fn(*const c_char, usize) -> *mut json_t;\n334\tpub type FnInt = unsafe extern \"C\" fn(json_int_t) -> *mut json_t;\n335\tpub type FnReal = unsafe extern \"C\" fn(c_double) -> *mut json_t;\n336\tpub type FnDelete = unsafe extern \"C\" fn(*mut json_t);\n337\tpub type FnDumps = unsafe extern \"C\" fn(*const json_t, usize) -> *mut c_char;\n338\tpub type FnDumpb = unsafe extern \"C\" fn(*const json_t, *mut c_char, usize, usize) -> usize;\n339\tpub type FnLoads = unsafe extern \"C\" fn(*const c_char, usize, *mut json_error_t) -> *mut json_t;\n340\tpub type FnLoadb =\n341\t    unsafe extern \"C\" fn(*const c_char, usize, usize, *mut json_error_t) -> *mut json_t;\n342\tpub type FnSize = unsafe extern \"C\" fn(*const json_t) -> usize;\n343\tpub type FnObjGet = unsafe extern \"C\" fn(*const json_t, *const c_char) -> *mut json_t;\n344\tpub type FnObjGetN = unsafe extern \"C\" fn(*const json_t, *const c_char, usize) -> *mut json_t;\n345\tpub type FnObjSetNew = unsafe extern \"C\" fn(*mut json_t, *const c_char, *mut json_t) -> c_int;\n346\tpub type FnObjSetNNew =\n347\t    unsafe extern \"C\" fn(*mut json_t, *const c_char, usize, *mut json_t) -> c_int;\n348\tpub type FnObjDel = unsafe extern \"C\" fn(*mut json_t, *const c_char) -> c_int;\n349\tpub type FnObjDelN = unsafe extern \"C\" fn(*mut json_t, *const c_char, usize) -> c_int;\n350\tpub type FnArrGet = unsafe extern \"C\" fn(*const json_t, usize) -> *mut json_t;\n351\tpub type FnArrSetNew = unsafe extern \"C\" fn(*mut json_t, usize, *mut json_t) -> c_int;\n352\tpub type FnArrAppendNew = unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int;\n353\tpub type FnArrRemove = unsafe extern \"C\" fn(*mut json_t, usize) -> c_int;\n354\tpub type FnIntVal = unsafe extern \"C\" fn(*const json_t) -> json_int_t;\n355\tpub type FnRealVal = unsafe extern \"C\" fn(*const json_t) -> c_double;\n356\tpub type FnStrVal = unsafe extern \"C\" fn(*const json_t) -> *const c_char;\n357\tpub type FnTwoJson = unsafe extern \"C\" fn(*mut json_t, *mut json_t) -> c_int;\n358\tpub type FnEqual = unsafe extern \"C\" fn(*const json_t, *const json_t) -> c_int;\n359\tpub type FnCopy = unsafe extern \"C\" fn(*mut json_t) -> *mut json_t;\n360\tpub type FnDeepCopy = unsafe extern \"C\" fn(*const json_t) -> *mut json_t;\n361\tpub type FnIter = unsafe extern \"C\" fn(*mut json_t) -> *mut c_void;\n362\tpub type FnIterNext = unsafe extern \"C\" fn(*mut json_t, *mut c_void) -> *mut c_void;\n363\tpub type FnIterKey = unsafe extern \"C\" fn(*mut c_void) -> *const c_char;\n364\tpub type FnIterKeyLen = unsafe extern \"C\" fn(*mut c_void) -> usize;\n365\tpub type FnIterValue = unsafe extern \"C\" fn(*mut c_void) -> *mut json_t;\n366\t\n367\t// ---------------------------------------------------------------- helpers\n368\t\n369\t/// Mirrors the `json_decref` static inline from jansson.h (not exported).\n370\tpub unsafe fn decref(lib: &Library, j: *mut json_t) {\n371\t    if j.is_null() {\n372\t        return;\n373\t    }\n374\t    if (*j).refcount == usize::MAX {\n375\t        return;\n376\t    }\n377\t    (*j).refcount -= 1;\n378\t    if (*j).refcount == 0 {\n379\t        let del: Symbol<FnDelete> = sym(lib, \"json_delete\");\n380\t        del(j);\n381\t    }\n382\t}\n383\t\n384\t/// Mirrors the `json_incref` static inline from jansson.h (not exported).\n385\tpub unsafe fn incref(j: *mut json_t) -> *mut json_t {\n386\t    if !j.is_null() && (*j).refcount != usize::MAX {\n387\t        (*j).refcount += 1;\n388\t    }\n389\t    j\n390\t}\n391\t\n392\t/// `json_dumps` + convert to an owned String, then free with the library's own\n393\t/// allocator-compatible `free` (jansson uses the configured free; default libc).\n394\tpub unsafe fn dumps_to_string(lib: &Library, j: *const json_t, flags: usize) -> Option<String> {\n395\t    let f: Symbol<FnDumps> = sym(lib, \"json_dumps\");\n396\t    let p = f(j, flags);\n397\t    if p.is_null() {\n398\t        return None;\n399\t    }\n400\t    let s = cstr_to_string(p);\n401\t    libc_free(p as *mut c_void);\n402\t    Some(s)\n403\t}\n404\t\n405\textern \"C\" {\n406\t    fn free(p: *mut c_void);\n407\t}\n408\t\n409\tpub unsafe fn libc_free(p: *mut c_void) {\n410\t    free(p)\n411\t}\n412\t\n413\t/// Parse `text` with `flags`, returning (dumped-round-trip, error snapshot).\n414\t/// This is the canonical \"did both libraries behave identically\" probe.\n415\tpub unsafe fn load_then_dump(\n416\t    lib: &Library,\n417\t    text: &[u8],\n418\t    load_flags: usize,\n419\t    dump_flags: usize,\n420\t) -> (Option<String>, ErrSnap) {\n421\t    let loads: Symbol<FnLoadb> = sym(lib, \"json_loadb\");\n422\t    let mut err = json_error_t::new();\n423\t    let j = loads(text.as_ptr() as *const c_char, text.len(), load_flags, &mut err);\n424\t    if j.is_null() {\n425\t        return (None, err.snapshot());\n426\t    }\n427\t    let out = dumps_to_string(lib, j, dump_flags);\n428\t    decref(lib, j);\n429\t    (out, err.snapshot())\n430\t}\n431\t"}]},"parent_tool_use_id":"toolu_bdrk_01NzHmYknxKqZawbs93pVEjv","session_id":"c1ef89ae-e696-4035-a7a9-923ffb551939","uuid":"155c1ccd