 with multi-byte UTF-8  (utf8_check_string on the arg, pack_unpack.c:145)\njson_pack | \"s#\" with (char*, int len) shorter than strlen  (truncation)\njson_pack | \"s%\" with (char*, size_t len)\njson_pack | \"s+\"  (two args concatenated)\njson_pack | \"s++\"  (three args concatenated)\njson_pack | \"s+#\"  (first arg strlen'd, second length-limited)\njson_pack | \"s#+#\"  (both length-limited)\njson_pack | \"s%+%\"  (both size_t-limited)\njson_pack | \"{s#:i}\" / \"{s%:i}\" / \"{s+:i}\"  (length/concat modifiers on an object KEY, read_string optional=0)\njson_pack | \"s?\" with a non-NULL string  (normal string)\njson_pack | \"s?\" with NULL  (-> json_null())\njson_pack | \"[s*]\" with NULL  (element omitted entirely -> [])\njson_pack | \"{s:s*}\" with NULL value  (key omitted entirely -> {})\njson_pack | \"{s:s?}\" with NULL value  (-> {\"k\":null})\njson_pack | \"s?#\"  (rejected: \"Cannot use '#' on optional strings\")\njson_pack | \"n\"  (json_null singleton)\njson_pack | \"b\" with 0 and with nonzero  (false / true singletons)\njson_pack | \"i\" with 0, INT_MIN, INT_MAX  (int-width vararg)\njson_pack | \"I\" with LLONG_MIN, LLONG_MAX  (json_int_t vararg)\njson_pack | \"f\" with 0.0, -0.0, 3.5, DBL_MAX, 5e-324\njson_pack | \"f\" with NaN or Inf  (rejected: json_real_set -> \"Invalid floating point value\", numeric_overflow)\njson_pack | \"O\" with a non-NULL json_t  (refcount incremented; same pointer twice -> \"[O,O]\" shares it)\njson_pack | \"o\" with a non-NULL json_t  (reference stolen, no incref)\njson_pack | \"O?\" / \"o?\" with NULL  (-> null)\njson_pack | \"O*\" / \"o*\" with NULL  (value omitted from the enclosing container)\njson_pack | \"O\" / \"o\" with NULL and no ?/*  (rejected: json_error_null_value)\njson_pack | \"r\" (any position)  (rejected: 'r' is NOT a format char in 2.15)\njson_pack | \"F\"  (rejected: 'F' is unpack-only)\njson_pack_ex | flags=JSON_VALIDATE_ONLY|JSON_STRICT  (both are INERT for packing; pack never reads s->flags)\njson_pack_ex | error == NULL vs a real json_error_t\njson_vpack_ex | fmt=NULL or \"\"  (rejected: json_error_invalid_argument)\njson_pack | \"{s:i}x\"  (rejected: \"Garbage after format string\")\njson_sprintf / json_vsprintf | \"%s-%d\" style fmt producing ASCII\njson_sprintf | fmt producing a zero-length result  (special-cased -> json_string(\"\"), value.c:846-849)\njson_sprintf | fmt producing multi-byte UTF-8; and one producing invalid UTF-8 (rejected -> NULL)\n```\n\n## Unpack — format characters, modifiers and flags\n```\njson_unpack / json_unpack_ex / json_vunpack_ex | \"{s:s}\" on a matching object\njson_unpack | \"{s:s%}\"  (also fills a size_t* length target)\njson_unpack | \"{s:i}\", \"{s:I}\", \"{s:b}\" (on true and on false), \"{s:f}\", \"{s:n}\"\njson_unpack | \"{s:F}\" on a REAL member  (json_number_value)\njson_unpack | \"{s:F}\" on an INTEGER member  (the only numeric-widening format)\njson_unpack | \"{s:f}\" on an integer member  (rejected: \"Expected real, got integer\")\njson_unpack | \"{s:o}\"  (borrowed pointer, no incref)\njson_unpack | \"{s:O}\"  (incref'd pointer, caller must decref)\njson_unpack | \"{s?i}\" with the key PRESENT\njson_unpack | \"{s?i}\" with the key MISSING  (target untouched, gotopt set)\njson_unpack | \"{s?{s:i}}\" with the outer key missing  (recursion with root=NULL: format-only \"skipping\" mode)\njson_unpack | \"{s:i,s:i}\" naming the SAME key twice  (key_set dedupes; still consistent with '!')\njson_unpack | \"{}\" on an empty object\njson_unpack | \"{s:i!}\"  (strict: all keys must be consumed)\njson_unpack | \"{s:i!}\" leaving keys unconsumed  (rejected: \"N object item(s) left unpacked: ...\")\njson_unpack | \"{s:i*}\"  (explicitly non-strict; overrides JSON_STRICT)\njson_unpack_ex | flags=JSON_STRICT (0x2) with \"{s:i}\" consuming every key  (passes)\njson_unpack_ex | flags=JSON_STRICT with \"{s:i}\" on a larger object  (rejected: promoted to '!')\njson_unpack_ex | flags=JSON_STRICT + explicit '*' in the container  (flag suppressed)\njson_unpack | \"{s:i!x}\"  (rejected: \"Expected '}' after '!'\")\njson_unpack | \"[i,i]\" on a 2-element array\njson_unpack | \"[]\" on an empty array\njson_unpack | \"[i!]\" on a longer array  (rejected: \"N array item(s) left unpacked\")\njson_unpack | \"[i*]\" on a longer array  (accepted)\njson_unpack_ex | flags=JSON_STRICT with \"[i,i]\" consuming the whole array\njson_unpack | \"[i,i,i]\" on a 2-element array  (rejected: json_error_index_out_of_range)\njson_unpack | \"[s]\",\"[i]\",\"[I]\",\"[b]\",\"[f]\",\"[F]\",\"[o]\",\"[O]\",\"[n]\",\"[{...}]\",\"[[...]]\"  (each member of unpack_value_starters \"{[siIbfFOon\")\njson_unpack | \"[?i]\"  (rejected: '?' is only handled inside objects, not arrays)\njson_unpack | \"[%]\" or \"[#]\"  (rejected: not in unpack_value_starters)\njson_unpack_ex | flags=JSON_VALIDATE_ONLY (0x1); \"{s:s,s:i}\" with NO value args  (keys are still consumed)\njson_unpack_ex | flags=JSON_VALIDATE_ONLY; \"{s:s%}\"  (rejected: '%' left unconsumed -> \"Expected format 's', got '%'\")\njson_unpack_ex | flags=JSON_VALIDATE_ONLY|JSON_STRICT together\njson_unpack | \"{s:s#}\"  (rejected: '#' is pack-only in unpack context)\njson_unpack | \"{s:r}\" or \"[r]\"  (rejected: 'r' does not exist)\njson_unpack | root scalar with format \"i\" / \"s\" / \"b\" / \"n\" / \"f\" / \"F\" / \"o\" / \"O\"  (no container required)\njson_unpack | wrong root type for '{' or '['  (rejected: json_error_wrong_type with the type_names[] string)\njson_unpack | format with ' ' '\\t' '\\n' ',' ':' decoration\njson_unpack | \"{s:i}x\"  (rejected: \"Garbage after format string\")\njson_vunpack_ex | root=NULL  (rejected: json_error_null_value) ; fmt=NULL or \"\"  (rejected: invalid_argument)\njson_unpack | object with >8 keys under '!'  (the internal key_set hashtable itself rehashes)\njson_unpack | key with an embedded NUL in the target object  (unreachable: unpack uses strlen(key))\n```\n\n## Value API — objects, arrays, strings, numbers\n```\njson_object / json_object_size | brand-new empty object (size 0, order 3, 8 buckets)\njson_object_set_new / json_object_set | valid UTF-8 key; key = \"\"; key of length 1/4/12/13/>24 (hashlittle tail + alignment paths)\njson_object_setn_new / json_object_setn | explicit key_len shorter than strlen(key)\njson_object_setn_new / json_object_setn | key containing an embedded NUL (accepted: NUL passes utf8_check_string)\njson_object_set_new_nocheck / json_object_setn_new_nocheck | invalid-UTF-8 key (accepted; the check is skipped)\njson_object_setn_new | invalid UTF-8 key  (rejected: -1, value decref'd)\njson_object_set* | value == the object itself  (rejected: -1, prevents direct cycles)\njson_object_set* | key already present  (value replaced, ordinal position preserved)\njson_object_set* | inserting the 8th then the 9th distinct key  (rehash boundary)\njson_object_get / json_object_getn | present key, absent key, key differing only past key_len, NUL-containing key\njson_object_del / json_object_deln | present key (0), absent key (-1), NUL-containing key\njson_object_clear | populated object then reuse  (buckets reset, order retained)\njson_object_update | overlapping + disjoint keys  ({\"a\":1,\"b\":2} + {\"b\":9,\"c\":3} -> {\"a\":1,\"b\":9,\"c\":3})\njson_object_update_existing | same inputs  (-> {\"a\":1,\"b\":9}; no new keys)\njson_object_update_missing | same inputs  (-> {\"a\":1,\"b\":2,\"c\":3}; existing untouched)\njson_object_update_recursive | nested objects on both sides  (merges the nested object, {\"x\":{\"a\":1,\"b\":9}})\njson_object_update_recursive | value object vs non-object mismatch  (replaces instead of merging)\njson_object_update_recursive | self-referential 'other'  (jsonp_loop_check -> -1)\njson_object_update* | non-object argument  (rejected: -1)\njson_object_iter / iter_next / iter_key / iter_key_len / iter_value | empty object (iter==NULL), 1 key, 9+ keys\njson_object_iter_at | present key / absent key (NULL)\njson_object_key_to_iter | pointer returned by iter_key  (container_of round trip)\njson_object_iter_set_new / iter_set | replace a value through an iterator\njson_object_iter_* | iter == NULL  (each returns NULL/0 defensively)\njson_array / json_array_size | brand-new array (size 8, entries 0)\njson_array_append_new | appends 1..8 (no realloc) then the 9th (grow to 16)\njson_array_insert_new | index 0, middle, index == entries (no memmove), index > entries (rejected)\njson_array_set_new | valid index; index >= entries (rejected)\njson_array_remove | index 0, middle, last element (no memmove), out of range (rejected)\njson_array_clear | populated array (entries=0, capacity kept)\njson_array_extend | other larger than 2x capacity  (takes the size+amount side of json_array_grow)\njson_array_extend | empty other; non-array argument (rejected)\njson_array_get | valid index, index == entries, huge index (NULL)\njson_string / json_stringn | \"\", ASCII, 2/3/4-byte UTF-8, embedded NUL via json_stringn\njson_string / json_stringn | invalid UTF-8  (rejected: NULL)\njson_string_nocheck / json_stringn_nocheck | invalid UTF-8 (accepted)\njson_string_set / json_string_setn | new value shorter and longer than the old; embedded NUL; invalid UTF-8 (rejected)\njson_string_set_nocheck / json_string_setn_nocheck | invalid UTF-8 (accepted)\njson_string_value / json_string_length | on a string; on a non-string (NULL / 0)\njson_integer / json_integer_set / json_integer_value | 0, -1, LLONG_MIN, LLONG_MAX; wrong type (0 / -1)\njson_real / json_real_set / json_real_value | 0.0, -0.0, subnormal 5e-324, DBL_MAX\njson_real / json_real_set | NaN and +/-Inf  (rejected: NULL / -1 -- the only values json_t cannot hold)\njson_number_value | integer, real, and a non-number (0.0)\njson_true / json_false / json_null | singletons with refcount (size_t)-1 (incref/decref are no-ops)\njson_equal | same pointer; type mismatch (integer 1 vs real 1.0 -> 0); NULL argument -> 0\njson_equal | equal/unequal objects (size then per-key), arrays (order-sensitive), strings (length+memcmp, NUL-safe), integers, reals\njson_copy | object/array (shallow: children shared), string, integer, real, and a singleton (returns the SAME pointer)\njson_deep_copy | nested object+array (children not shared)\njson_deep_copy | indirect cycle  (rejected: NULL via jsonp_loop_check)\njson_delete / json_decref | each of the 5 heap types; and on a singleton (never freed)\n```\n\n## Low-level exported helpers\n```\nutf8_encode | codepoint 0 (1 byte), 0x7F/0x80 (1/2-byte boundary), 0x7FF/0x800 (2/3), 0xFFFF/0x10000 (3/4), 0x10FFFF (4)\nutf8_encode | codepoint in D800-DFFF  (ACCEPTED, encodes 3 bytes -- asymmetric with utf8_check_full)\nutf8_encode | codepoint < 0 or > 0x10FFFF  (rejected: -1)\nutf8_check_first | 0x00-0x7F ->1 ; 0x80-0xBF ->0 ; 0xC0,0xC1 ->0 ; 0xC2-0xDF ->2 ; 0xE0-0xEF ->3 ; 0xF0-0xF4 ->4 ; 0xF5-0xFF ->0\nutf8_check_full | valid 2/3/4-byte sequences; size 1 or >4 (returns 0); codepoint out-param NULL vs non-NULL\nutf8_check_full | overlong (E0 80 A9), surrogate (ED A0 80), value > 0x10FFFF, bad continuation byte  (each returns 0)\nutf8_iterate | bufsize 0  (returns buffer unchanged, codepoint untouched); 1-byte; 3-byte; truncated sequence (NULL)\nutf8_check_string | length 0 (valid); ASCII; embedded NUL (valid); multi-byte; sequence truncated by length (invalid)\nstrbuffer_init | fresh buffer (size 16, length 0, value[0]='\\0')\nstrbuffer_append_byte | single byte; repeated to cross 16 -> 32 -> 64 (max(size*2, length+size+1))\nstrbuffer_append_bytes | size 0; size exactly filling the buffer (>= comparison, always leaves room for '\\0'); huge size (overflow guards, strbuffer.c:66-69)\nstrbuffer_pop | non-empty (returns and removes last byte) ; EMPTY (returns '\\0', length stays 0)\nstrbuffer_clear | populated buffer  (length 0, capacity retained)\nstrbuffer_value | fresh, populated, and post-clear buffer\nstrbuffer_steal_value | populated buffer  (value set to NULL; caller frees; strbuffer_close afterwards is safe)\nstrbuffer_close | after steal (value NULL) and without steal\nhashtable_init / hashtable_close | fresh table (order 3, 8 buckets)\nhashtable_set | new key; existing key (value replaced, order kept); 8th then 9th key (rehash to order 4); 17th (order 5)\nhashtable_set | key_len 0; key with embedded NUL; key_len at the offsetof overflow guard (hashtable.c:205-208)\nhashtable_get | hit, miss, hash collision within a bucket (find_pair walk); key_len mismatch on equal prefix\nhashtable_del | hit (0); miss (-1); sole entry in a bucket; first entry; last entry (three distinct relink branches)\nhashtable_clear | populated table then reuse\nhashtable_iter / iter_next / iter_key / iter_key_len / iter_value / iter_set / hashtable_key_to_iter | empty table (NULL), 1 pair, many pairs, iterate to exhaustion\nhashtable_iter_at | present key / absent key (NULL)\njsonp_strtod | integer-looking text, fraction, exponent, \"-0.0\"; value at HUGE_VAL with ERANGE (rejected: -1); non-'.' locale decimal point (to_locale)\njsonp_dtostr | precision 0 (dtoa mode 0) vs 1..17 (mode 2); buffer exactly large enough; buffer too small (rejected: -1)\njsonp_dtostr | values on both sides of the decpt <= -4 and decpt > 16 exponent thresholds; -0.0 (sign==1)\njsonp_strndup | len 0; len < strlen; len == strlen; data containing NUL bytes\njsonp_malloc | size 0  (returns NULL by design, memory.c:26-27); nonzero size\njsonp_free | NULL pointer (no-op) and a real pointer\njsonp_realloc | with a realloc hook installed (direct call) ; with realloc==NULL (malloc+memcpy+free emulation) ; newSize 0 in emulation mode\njsonp_loop_check | first visit (inserts \"%p\" key, returns 0); repeat visit (returns -1); key buffer of exactly LOOP_KEY_LEN\njson_object_seed | seed 0  (autoseed from /dev/urandom, then gettimeofday^getpid fallback); nonzero seed (deterministic hashing); called twice (second call ignored once hashtable_seed != 0)\njson_object_seed | never called explicitly  (auto-seeded lazily by the first json_object(), value.c:69-72)\nhashtable_seed (exported variable) | read as 0 before seeding and nonzero after\njson_set_alloc_funcs | custom malloc+free  (do_realloc forced to NULL -> emulation path everywhere)\njson_set_alloc_funcs2 | custom malloc+realloc+free\njson_get_alloc_funcs / json_get_alloc_funcs2 | all out-params non-NULL; each individually NULL (skipped)\njansson_version_str | returns \"2.15.0\"\njansson_version_cmp | equal (0); lower/higher major; equal major with lower/higher minor; equal major+minor with differing micro\njsonp_error_init / jsonp_error_set / jsonp_error_vset / jsonp_error_set_source | error==NULL (no-op); source NULL; source >= 80 chars (truncated with \"...\"); second set on an already-set error (IGNORED, error.c:47-50)\njson_error_code | reads the code smuggled into text[JSON_ERROR_TEXT_LENGTH-1]\n```\n\n**Row count: ~215.** Two findings worth flagging to whoever consumes this: (1) `JSON_PRESERVE_ORDER` (0x100) is referenced in **zero** `.c` files — it is a pure no-op, so a port needs no behavior for it; (2) format character `'r'` **does not exist** in Jansson 2.15's pack or unpack switches (it appears in neither switch nor `unpack_value_starters`), `'F'` is unpack-only, and `'#'` is pack-only — any test matrix that assumes `'r'` exists will be testing an error path, not a valid one.","usage":{"total_tokens":136556,"tool_uses":30,"duration_ms":617707},"uuid":"15c54a93-6f65-476b-b915-93ab9d7651ca","session_id":"c1ef89ae-e696-4035-a7a9-923ffb551939"}
