ll_mut());\n    65\t    *seed = (tv.tv_sec as u32) ^ (tv.tv_usec as u32);\n    66\t\n    67\t    *seed ^= getpid() as u32;\n    68\t\n    69\t    0\n    70\t}\n    71\t\n    72\tunsafe fn generate_seed() -> u32 {\n    73\t    let mut seed: u32 = 0;\n    74\t    let mut done = 0;\n    75\t\n    76\t    if seed_from_urandom(&mut seed) == 0 {\n    77\t        done = 1;\n    78\t    }\n    79\t\n    80\t    if done == 0 {\n    81\t        seed_from_timestamp_and_pid(&mut seed);\n    82\t    }\n    83\t\n    84\t    /* Make sure the seed is never zero */\n    85\t    if seed == 0 {\n    86\t        seed = 1;\n    87\t    }\n    88\t\n    89\t    seed\n    90\t}\n    91\t\n    92\t// volatile uint32_t hashtable_seed = 0;\n    93\t#[unsafe(no_mangle)]\n    94\tpub static hashtable_seed: AtomicU32 = AtomicU32::new(0);\n    95\t\n    96\tstatic seed_initialized: AtomicU8 = AtomicU8::new(0);\n    97\t\n    98\t// __atomic path (HAVE_ATOMIC_BUILTINS && HAVE_SCHED_YIELD)\n    99\t#[unsafe(no_mangle)]\n   100\tpub unsafe extern \"C\" fn json_object_seed(seed: usize) {\n   101\t    let mut new_seed = seed as u32;\n   102\t\n   103\t    if hashtable_seed.load(Ordering::Relaxed) == 0 {\n   104\t        // __atomic_test_and_set(&seed_initialized, __ATOMIC_RELAXED) == 0\n   105\t        if seed_initialized.swap(1, Ordering::Relaxed) == 0 {\n   106\t            /* Do the seeding ourselves */\n   107\t            if new_seed == 0 {\n   108\t                new_seed = generate_seed();\n   109\t            }\n   110\t\n   111\t            hashtable_seed.store(new_seed, Ordering::Release);\n   112\t        } else {\n   113\t            /* Wait for another thread to do the seeding */\n   114\t            while hashtable_seed.load(Ordering::Acquire) == 0 {\n   115\t                sched_yield();\n   116\t            }\n   117\t        }\n   118\t    }\n   119\t}","is_error":false}]},"parent_tool_use_id":"toolu_bdrk_01JeVWYt1jVAYTTeEu5hYVcr","session_id":"c1ef89ae-e696-4035-a7a9-923ffb551939