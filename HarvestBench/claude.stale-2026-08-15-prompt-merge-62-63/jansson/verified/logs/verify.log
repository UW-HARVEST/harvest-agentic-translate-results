{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VdzN1qGScT5Ct42Ftqoi36","type":"tool_result","content":"1\t//! Translation of value.c\n2\t#![allow(non_upper_case_globals)]\n3\t\n4\tuse crate::hashtable::*;\n5\tuse crate::hashtable_seed::{hashtable_seed, json_object_seed};\n6\tuse crate::memory::{jsonp_free, jsonp_malloc, jsonp_strndup};\n7\tuse crate::types::*;\n8\tuse crate::utf::utf8_check_string;\n9\tuse core::ffi::{c_char, c_int, c_void, VaList};\n10\tuse core::mem::size_of;\n11\tuse core::ptr;\n12\tuse core::sync::atomic::Ordering;\n13\t\n14\textern \"C\" {\n15\t    fn strlen(s: *const c_char) -> usize;\n16\t    fn memcmp(a: *const c_void, b: *const c_void, n: usize) -> c_int;\n17\t    fn memmove(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n18\t    fn memcpy(dst: *mut c_void, src: *const c_void, n: usize) -> *mut c_void;\n19\t    fn snprintf(s: *mut c_char, n: usize, fmt: *const c_char, ...) -> c_int;\n20\t    fn vsnprintf(s: *mut c_char, n: usize, fmt: *const c_char, ap: VaList) -> c_int;\n21\t}\n22\t\n23\t// re-export refcount helpers under the public no_mangle names is done in lib.rs\n24\t\n25\t#[inline]\n26\tunsafe fn json_init(json: *mut json_t, type_: json_type) {\n27\t    (*json).type_ = type_;\n28\t    (*json).refcount = 1;\n29\t}\n30\t\n31\tfn isnan_(x: f64) -> bool {\n32\t    x != x\n33\t}\n34\tfn isinf_(x: f64) -> bool {\n35\t    !isnan_(x) && isnan_(x - x)\n36\t}\n37\t\n38\t#[unsafe(no_mangle)]\n39\tpub unsafe extern \"C\" fn jsonp_loop_check(\n40\t    parents: *mut hashtable_t,\n41\t    json: *const json_t,\n42\t    key: *mut c_char,\n43\t    key_size: usize,\n44\t    key_len_out: *mut usize,\n45\t) -> c_int {\n46\t    let key_len = snprintf(key, key_size, b\"%p\\0\".as_ptr() as *const c_char, json) as usize;\n47\t\n48\t    if !key_len_out.is_null() {\n49\t        *key_len_out = key_len;\n50\t    }\n51\t\n52\t    if !hashtable_get(parents, key, key_len).is_null() {\n53\t        return -1;\n54\t    }\n55\t\n56\t    hashtable_set(parents, key, key_len, json_null())\n57\t}\n58\t\n59\t/*** object ***/\n60\t\n61\t#[unsafe(no_mangle)]\n62\tpub unsafe extern \"C\" fn json_object() -> *mut json_t {\n63\t    let object = jsonp_malloc(size_of::<json_object_t>()) as *mut json_object_t;\n64\t    if object.is_null() {\n65\t        return ptr::null_mut();\n66\t    }\n67\t\n68\t    if hashtable_seed.load(Ordering::Relaxed) == 0 {\n69\t        /* Autoseed */\n70\t        json_object_seed(0);\n71\t    }\n72\t\n73\t    json_init(&mut (*object).json, JSON_OBJECT);\n74\t\n75\t    if hashtable_init(&mut (*object).hashtable) != 0 {\n76\t        jsonp_free(object as *mut c_void);\n77\t        return ptr::null_mut();\n78\t    }\n79\t\n80\t    &mut (*object).json\n81\t}\n82\t\n83\tunsafe fn json_delete_object(object: *mut json_object_t) {\n84\t    hashtable_close(&mut (*object).hashtable);\n85\t    jsonp_free(object as *mut c_void);\n86\t}\n87\t\n88\t#[unsafe(no_mangle)]\n89\tpub unsafe extern \"C\" fn json_object_size(json: *const json_t) -> usize {\n90\t    if !json_is_object(json) {\n91\t        return 0;\n92\t    }\n93\t\n94\t    let object = json_to_object(json);\n95\t    (*object).hashtable.size\n96\t}\n97\t\n98\t#[unsafe(no_mangle)]\n99\tpub unsafe extern \"C\" fn json_object_get(json: *const json_t, key: *const c_char) -> *mut json_t {\n100\t    if key.is_null() {\n101\t        return ptr::null_mut();\n102\t    }\n103\t\n104\t    json_object_getn(json, key, strlen(key))\n105\t}\n106\t\n107\t#[unsafe(no_mangle)]\n108\tpub unsafe extern \"C\" fn json_object_getn(\n109\t    json: *const json_t,\n110\t    key: *const c_char,\n111\t    key_len: usize,\n112\t) -> *mut json_t {\n113\t    if key.is_null() || !json_is_object(json) {\n114\t        return ptr::null_mut();\n115\t    }\n116\t\n117\t    let object = json_to_object(json);\n118\t    hashtable_get(&mut (*object).hashtable, key, key_len) as *mut json_t\n119\t}\n120\t\n121\t#[unsafe(no_mangle)]\n122\tpub unsafe extern \"C\" fn