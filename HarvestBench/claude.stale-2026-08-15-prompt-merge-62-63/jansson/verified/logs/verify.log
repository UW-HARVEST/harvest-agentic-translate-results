{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TEJtjDVLLJqfJYduPuoVEX","type":"tool_result","content":"1\t//! Phase B — encoder (dump) differential tests. CONFIGS.md rows 1-77.\n2\t//!\n3\t//! Every test drives BOTH the C `.so` and the Rust `.so` through their exported\n4\t//! symbols only and compares results byte-for-byte.\n5\t\n6\tmod common;\n7\t\n8\tuse common::*;\n9\tuse libloading::{Library, Symbol};\n10\tuse std::ffi::{c_char, c_int, c_void};\n11\t\n12\t/// Build a representative tree entirely through exported constructors.\n13\t/// Returns a value with refcount 1 owned by the caller.\n14\tunsafe fn build_baseline(lib: &Library) -> *mut json_t {\n15\t    let obj: Symbol<unsafe extern \"C\" fn() -> *mut json_t> = sym(lib, \"json_object\");\n16\t    let arr: Symbol<unsafe extern \"C\" fn() -> *mut json_t> = sym(lib, \"json_array\");\n17\t    let int: Symbol<FnInt> = sym(lib, \"json_integer\");\n18\t    let nul: Symbol<unsafe extern \"C\" fn() -> *mut json_t> = sym(lib, \"json_null\");\n19\t    let oset: Symbol<FnObjSetNew> = sym(lib, \"json_object_set_new\");\n20\t    let aapp: Symbol<FnArrAppendNew> = sym(lib, \"json_array_append_new\");\n21\t\n22\t    let root = obj();\n23\t    let a = arr();\n24\t    aapp(a, int(1));\n25\t    aapp(a, int(2));\n26\t    oset(root, cs(\"arr\").as_ptr(), a);\n27\t    let inner = obj();\n28\t    oset(inner, cs(\"k\").as_ptr(), nul());\n29\t    oset(root, cs(\"o\").as_ptr(), inner);\n30\t    root\n31\t}\n32\t\n33\t/// Dump a freshly built baseline tree with `flags` and return the string.\n34\tfn dump_baseline(flags: usize) -> impl Fn(&Library) -> Option<String> {\n35\t    move |lib: &Library| unsafe {\n36\t        let root = build_baseline(lib);\n37\t        let out = dumps_to_string(lib, root, flags);\n38\t        decref(lib, root);\n39\t        out\n40\t    }\n41\t}\n42\t\n43\t// ---------------------------------------------------------------- rows 1-9, 20, 28, 29\n44\t\n45\t#[test]\n46\tfn row1_baseline_all_entry_points() {\n47\t    // json_dumps\n48\t    diff(\"row1/dumps\", dump_baseline(0));\n49\t\n50\t    // json_dumpb, json_dump_callback, json_dumpf, json_dumpfd, json_dump_file\n51\t    diff(\"row1/dumpb\", |lib: &Library| unsafe {\n52\t        let root = build_baseline(lib);\n53\t        let f: Symbol<FnDumpb> = sym(lib, \"json_dumpb\");\n54\t        let need = f(root, std::ptr::null_mut(), 0, 0);\n55\t        let mut buf = vec![0u8; need + 8];\n56\t        let wrote = f(root, buf.as_mut_ptr() as *mut c_char, need, 0);\n57\t        decref(lib, root);\n58\t        (need, wrote, buf[..need].to_vec())\n59\t    });\n60\t}\n61\t\n62\t#[test]\n63\tfn rows2_9_20_28_29_flag_axes() {\n64\t    let cases: &[(&str, usize)] = &[\n65\t        (\"row2/COMPACT\", JSON_COMPACT),\n66\t        (\"row3/INDENT1\", json_indent(1)),\n67\t        (\"row4/INDENT2\", json_indent(2)),\n68\t        (\"row5/INDENT4\", json_indent(4)),\n69\t        (\"row6/INDENT31\", json_indent(31)),\n70\t        (\"row8/INDENT0\", json_indent(0)),\n71\t        (\"row9/INDENT4|COMPACT\", json_indent(4) | JSON_COMPACT),\n72\t        (\"row20/PRESERVE_ORDER\", JSON_PRESERVE_ORDER),\n73\t        (\n74\t            \"row28/ALL\",\n75\t            JSON_ENSURE_ASCII | JSON_ESCAPE_SLASH | JSON_SORT_KEYS | JSON_COMPACT,\n76\t        ),\n77\t        // row 29: every unknown high bit set (must be ignored). Keep EMBED clear.\n78\t        (\"row29/unknown-bits\", 0xFFFF_0000_usize & !JSON_EMBED),\n79\t    ];\n80\t    for (label, flags) in cases {\n81\t        diff(label, dump_baseline(*flags));\n82\t    }\n83\t}\n84\t\n85\t#[test]\n86\tfn row7_indent31_deep_multichunk() {\n87\t    // depth >= 2 so depth*31 > 32, exercising the whitespace[] chunk loop (dump.c:79-87).\n88\t    diff(\"row7/INDENT31 deep\", |lib: &Library| unsafe {\n89\t        let arr: Symbol<unsafe extern \"C\" fn() -> *mut json_t> = sym(lib, \"json_array\");\n90\t        let int: Symbol<FnInt> = sym(lib, \"json_integer\");\n91\t        let aapp: Symbol<FnArrAppendNew> = sym(lib, \"json_array_append_new\");\n92\t        // 5 levels of nesting -> depth*31 up to 155\n93\t        let mut cur = arr();\n94\t        aapp(cur, int(7));\n95\t        for _ in 0..4 {\n96\t            let outer = arr();\n97\t            aapp(outer, cur);\n98\t            cur = outer;\n99\t        }\n100\t        let out = dumps_to_string(lib, cur, json_indent(31));\n101\t        decref(lib, cur);\n102\t        out\n103\t    });\n104\t}\n105\t\n106\t// ---------------------------------------------------------------- rows 10-14: escaping\n107\t\n108\t/// Dump a single string value (via JSON_ENCODE_ANY) with the given flags.\n109\tfn dump_string_value(bytes: Vec<u8>, flags: usize) -> impl Fn(&Library) -> Option<String> {\n110\t    move |lib: &Library| unsafe {\n111\t        let sn: Symbol<FnStrN> = sym(lib, \"json_stringn\");\n112\t        let s = sn(bytes.as_ptr() as *const c_char, bytes.len());\n113\t        if s.is_null() {\n114\t            return None;\n115\t        }\n116\t        let out = dumps_to_string(lib, s, flags | JSON_ENCODE_ANY);\n117\t        decref(lib, s);\n118\t        out\n119\t    }\n120\t}"}]},"parent_tool_use_id":"toolu_bdrk_016LYYBrEbgUGcvbCs2aEcTR","session_id":"c1ef89ae-e696-4035-a7a9-923ffb551939","uuid":"c7509fd8-ee32-4b8d-bcf0-e95024c62fc1","timestamp":"2026-08-14T15:11:07.895Z","subagent_type":"general-purpose","task_description":"Write decoder differential tests"}
