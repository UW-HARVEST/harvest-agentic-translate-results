{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PtBkzetPs7GXjqGjW2Wapq","type":"tool_result","content":"400\t    let cases: Vec<(String, String)> = vec![\n401\t        (\"nonexistent file\".into(), missing.to_str().unwrap().to_string()),\n402\t        (\"nonexistent parent dir\".into(), no_parent.to_str().unwrap().to_string()),\n403\t        (\"directory\".into(), \"/tmp\".to_string()),\n404\t        (\"unreadable file\".into(), noperm.to_str().unwrap().to_string()),\n405\t        (\"empty path\".into(), \"\".to_string()),\n406\t    ];\n407\t\n408\t    for (what, path) in &cases {\n409\t        for &flags in &[0usize, JSON_DECODE_ANY] {\n410\t            let label = format!(\"row191/json_load_file({:?}) [{}] flags={:#x}\", path, what, flags);\n411\t            let p = path.clone();\n412\t            let probe = move |lib: &Library| unsafe {\n413\t                let f: Symbol<FnLoadFile> = sym(lib, \"json_load_file\");\n414\t                let cp = cs(&p);\n415\t                let mut err = json_error_t::new();\n416\t                let j = f(cp.as_ptr(), flags, &mut err);\n417\t                let dumped =\n418\t                    if j.is_null() { None } else { dumps_to_string(lib, j, JSON_SORT_KEYS) };\n419\t                decref(lib, j);\n420\t                let j2 = f(cp.as_ptr(), flags, ptr::null_mut());\n421\t                let j2_null = j2.is_null();\n422\t                decref(lib, j2);\n423\t                (j.is_null(), j2_null, dumped, err.snapshot())\n424\t            };\n425\t            diff(&label, &probe);\n426\t\n427\t            // Absolute pin, but only when fopen(path,\"rb\") really fails here\n428\t            // too. NOTE: on glibc, opening a DIRECTORY read-only SUCCEEDS, so\n429\t            // \"/tmp\" does not take the cannot-open branch at all; and if the\n430\t            // suite runs as root the unreadable file opens as well.\n431\t            if let Some(errno) = unsafe { fopen_rb_errno(path) } {\n432\t                let expected = ErrSnap {\n433\t                    line: -1,\n434\t                    column: -1,\n435\t                    position: 0,\n436\t                    source: expected_source(path),\n437\t                    text: clamp_text(&format!(\n438\t                        \"unable to open {}: {}\",\n439\t                        path,\n440\t                        strerror_str(errno)\n441\t                    )),\n442\t                    code: JSON_ERROR_CANNOT_OPEN_FILE,\n443\t                };\n444\t                pin_c(&label, &expected, |lib| probe(lib).3);\n445\t            } else {\n446\t                // Opened fine -> the failure must come from reading instead.\n447\t                pin_c_code_source(\n448\t                    &label,\n449\t                    JSON_ERROR_PREMATURE_END_OF_INPUT,\n450\t                    &expected_source(path),\n451\t                    |lib| probe(lib).3,\n452\t                );\n453\t            }\n454\t        }\n455\t    }\n456\t\n457\t    #[cfg(unix)]\n458\t    {\n459\t        use std::os::unix::fs::PermissionsExt;\n460\t        let _ = std::fs::set_permissions(&noperm, std::fs::Permissions::from_mode(0o644));\n461\t    }\n462\t    let _ = std::fs::remove_file(&noperm);\n463\t}\n464\t\n465\t/// `JSON_ERROR_SOURCE_LENGTH` is 80: a source of length <= 79 is stored\n466\t/// verbatim, length >= 80 becomes `\"...\"` + the last 76 bytes (79 chars total).\n467\t#[test]\n468\tfn row191_source_truncation_boundary() {\n469\t    let lens = [40usize, 70, 77, 78, 79, 80, 81, 82, 100, 200];"}]},"parent_tool_use_id":"toolu_bdrk_01PZc4LTABgtZwW9WvB6Msq1","session_id":"c1ef89ae-e696-4035-a7a9-923ffb551939","uuid":"4e20091e-e74f-4083-8eec-05f8827f7d2c","timestamp":"2026-08-14T15:38:41.543Z","subagent_type":"general-purpose","task_description":"Write load entry-point error tests"}
