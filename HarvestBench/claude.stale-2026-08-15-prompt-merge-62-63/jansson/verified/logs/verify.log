  g_case++;\n}\n\n/* ---- individual cases ------------------------------------------------ */\n\nstatic void c_version_cmp(void) {\n    version_cmp_t f = (version_cmp_t)SYM(\"jansson_version_cmp\");\n    int vals[] = {INT_MIN, INT_MIN + 1, -1, 0, 1, 2, 15, INT_MAX - 1, INT_MAX};\n    for (unsigned i = 0; i < sizeof(vals) / sizeof(vals[0]); i++)\n        for (unsigned j = 0; j < sizeof(vals) / sizeof(vals[0]); j++)\n            printf(\"  vc %d %d -> %d %d %d\\n\", vals[i], vals[j],\n                   f(vals[i], 0, 0), f(2, vals[i], 0), f(2, 15, vals[j]));\n}\n\nstatic void c_strndup(void) {\n    strndup_t f = (strndup_t)SYM(\"jsonp_strndup\");\n    printf(\"  strndup SIZE_MAX -> %p\\n\", (void *)f(\"x\", (size_t)-1));\n    printf(\"  strndup 0        -> %d\\n\", f(\"x\", 0) != NULL);\n}\n\nstatic void c_utf8_encode(void) {\n    utf8_encode_t f = (utf8_encode_t)SYM(\"utf8_encode\");\n    int32_t vals[] = {INT32_MIN, INT32_MIN + 1, -2, -1, 0, 1, 0x7f, 0x80, 0x7ff,\n                      0x800, 0xffff, 0x10000, 0x10fffe, 0x10ffff, 0x110000,\n                      0x7fffff, INT32_MAX - 1, INT32_MAX};\n    for (unsigned i = 0; i < sizeof(vals) / sizeof(vals[0]); i++) {\n        char b[8]; size_t sz = 0;\n        memset(b, 0, sizeof(b));\n        int r = f(vals[i], b, &sz);\n        printf(\"  enc %11d -> %d sz=%zu [%02x %02x %02x %02x]\\n\", vals[i], r, sz,\n               (unsigned char)b[0], (unsigned char)b[1], (unsigned char)b[2],\n               (unsigned char)b[3]);\n    }\n}\n\nstatic void c_utf8_check_full(void) {\n    utf8_check_full_t f = (utf8_check_full_t)SYM(\"utf8_check_full\");\n    static const char *bufs[] = {\"\\xc2\\xa9zzzz\", \"\\xe2\\x82\\xacz\", \"\\xf0\\x9f\\x98\\x80\",\n                                 \"\\xff\\xff\\xff\\xff\", \"\\x80\\x80\\x80\\x80\", \"Azzz\"};\n    size_t sizes[] = {0, 1, 2, 3, 4, 5, 6, 100, (size_t)-1, (size_t)-2};\n    for (unsigned b = 0; b < sizeof(bufs) / sizeof(bufs[0]); b++)\n        for (unsigned s = 0; s < sizeof(si