{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014Pgcr6uiAdAk7SpU7JwYdq","type":"tool_result","content":"1\t//! Translation of dtoa.c (David Gay's dtoa/strtod).\n2\t//!\n3\t//! Active configuration (from jansson_private_config.h + x86_64 Linux):\n4\t//!   IEEE_8087 (little-endian), long long available.\n5\t//!   We implement the *classic Bigint* code path (equivalent to compiling\n6\t//!   without USE_BF96). David Gay's algorithm computes the mathematically\n7\t//!   unique correctly-rounded result, so this produces byte-identical output\n8\t//!   to the BF96 fast path that the reference C build uses.\n9\t//!\n10\t//! Exported symbols: dtoa_r, dtoa, freedtoa, gethex, strtod__unused,\n11\t//! plus the data symbol dtoa_divmax.\n12\t#![allow(unused_assignments)]\n13\t#![allow(unused_variables)]\n14\t\n15\tuse crate::memory::{jsonp_free, jsonp_malloc};\n16\tuse core::ffi::{c_char, c_int, c_void};\n17\tuse core::ptr;\n18\t\n19\t#[path = \"dtoa_tables.rs\"]\n20\tmod dtoa_tables;\n21\tuse dtoa_tables::{BF96, LHINT, PTEN};\n22\t\n23\t// ---- Permit experimenting data symbol (must be exported) ----\n24\t#[unsafe(no_mangle)]\n25\tpub static mut dtoa_divmax: c_int = 2;\n26\t\n27\t// ==== IEEE_Arith constants (P=53 double) ====\n28\tconst EXP_SHIFT: c_int = 20;\n29\tconst EXP_SHIFT1: c_int = 20;\n30\tconst EXP_MSK1: u32 = 0x100000;\n31\tconst EXP_MSK11: u32 = 0x100000;\n32\tconst EXP_MASK: u32 = 0x7ff00000;\n33\tconst P: c_int = 53;\n34\tconst BIAS: c_int = 1023;\n35\tconst EMIN: c_int = -1022;\n36\tconst EXP_1: u32 = 0x3ff00000;\n37\tconst EXP_11: u32 = 0x3ff00000;\n38\tconst EBITS: c_int = 11;\n39\tconst FRAC_MASK: u32 = 0xfffff;\n40\tconst FRAC_MASK1: u32 = 0xfffff;\n41\tconst TEN_PMAX: c_int = 22;\n42\tconst BNDRY_MASK: u32 = 0xfffff;\n43\tconst BNDRY_MASK1: u32 = 0xfffff;\n44\tconst LSB: u32 = 1;\n45\tconst SIGN_BIT: u32 = 0x80000000;\n46\tconst LOG2P: c_int = 1;\n47\tconst QUICK_MAX: c_int = 14;\n48\tconst INT_MAX_: c_int = 14;\n49\tconst DB