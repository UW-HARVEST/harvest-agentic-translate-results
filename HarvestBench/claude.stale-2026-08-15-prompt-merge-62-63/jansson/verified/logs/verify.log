ares elem=%d equal=%d/%d\\n\", json_array_get(c,0)==json_array_get(a,0), json_array_get(d,0)==json_array_get(a,0), json_equal(a,c), json_equal(a,d));\n      json_decref(c); json_decref(d);\n      json_array_append(a,a); /* self-reference */\n      char*s=json_dumps(a,0); printf(\"dump cyclic array -> %s\\n\", s?s:\"(NULL)\"); if(s)free(s);\n      json_t*dc=json_deep_copy(a); printf(\"deep_copy cyclic -> %s\\n\", dc?\"non-NULL\":\"NULL\"); if(dc)json_decref(dc);\n      json_array_remove(a,1); json_decref(a); }\n    /* copy of singletons */\n    printf(\"json_copy(true)==json_true(): %d\\n\", json_copy(json_true())==json_true());\n    /* update variants */\n    { json_t *o=json_pack(\"{s:i,s:i}\",\"a\",1,\"b\",2), *p=json_pack(\"{s:i,s:i}\",\"b\",9,\"c\",3);\n      json_t *o1=json_deep_copy(o),*o2=json_deep_copy(o),*o3=json_deep_copy(o);\n      json_object_update(o1,p); json_object_update_existing(o2,p); json_object_update_missing(o3,p);\n      char*s1=json_dumps(o1,JSON_COMPACT),*s2=json_dumps(o2,JSON_COMPACT),*s3=json_dumps(o3,JSON_COMPACT);\n      printf(\"update=%s existing=%s missing=%s\\n\",s1,s2,s3); free(s1);free(s2);free(s3);\n      json_t *n1=json_pack(\"{s:{s:i,s:i}}\",\"x\",\"a\",1,\"b\",2), *n2=json_pack(\"{s:{s:i}}\",\"x\",\"b\",9);\n      json_object_update_recursive(n1,n2); char*sr=json_dumps(n1,JSON_COMPACT); printf(\"update_recursive=%s\\n\",sr); free(sr);\n      json_decref(o);json_decref(p);json_decref(o1);json_decref(o2);json_decref(o3);json_decref(n1);json_decref(n2); }\n    return 0;\n}\nEOF\ngcc -I/local/home/scheschb/.harvest/work/harvest-work-QfYM1w/translated_rust/c_src/include -o /tmp/jchk/t4 /tmp/jchk/t4.c /local/home/scheschb/.harvest/work/harvest-work-QfYM1w/translated_rust/cbuild/libjansson.so -Wl,-rpath,/local/home/scheschb/.harvest/work/harvest-work-QfYM1w/translated_rust/cbuild 2>&1|head -5; /tmp/jchk/t4","description":"Probe low-level helpers and value ops"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"inp