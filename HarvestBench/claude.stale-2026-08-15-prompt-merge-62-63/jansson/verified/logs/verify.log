   0\n    45\t    } else if u == 0xC0 || u == 0xC1 {\n    46\t        /* overlong encoding of an ASCII byte */\n    47\t        0\n    48\t    } else if (0xC2..=0xDF).contains(&u) {\n    49\t        /* 2-byte sequence */\n    50\t        2\n    51\t    } else if (0xE0..=0xEF).contains(&u) {\n    52\t        /* 3-byte sequence */\n    53\t        3\n    54\t    } else if (0xF0..=0xF4).contains(&u) {\n    55\t        /* 4-byte sequence */\n    56\t        4\n    57\t    } else {\n    58\t        /* u >= 0xF5 : restricted or invalid */\n    59\t        0\n    60\t    }\n    61\t}\n    62\t\n    63\t#[unsafe(no_mangle)]\n    64\tpub unsafe extern \"C\" fn utf8_check_full(\n    65\t    buffer: *const c_char,\n    66\t    size: usize,\n    67\t    codepoint: *mut i32,\n    68\t) -> usize {\n    69\t    let mut value: i32;\n    70\t    let mut u = *buffer.add(0) as u8;\n    71\t\n    72\t    if size == 2 {\n    73\t        value = (u & 0x1F) as i32;\n    74\t    } else if size == 3 {\n    75\t        value = (u & 0xF) as i32;\n    76\t    } else if size == 4 {\n    77\t        value = (u & 0x7) as i32;\n    78\t    } else {\n    79\t        return 0;\n    80\t    }\n    81\t\n    82\t    let mut i = 1usize;\n    83\t    while i < size {\n    84\t        u = *buffer.add(i) as u8;\n    85\t\n    86\t        if u < 0x80 || u > 0xBF {\n    87\t            /* not a continuation byte */\n    88\t            return 0;\n    89\t        }\n    90\t\n    91\t        value = (value << 6) + (u & 0x3F) as i32;\n    92\t        i += 1;\n    93\t    }\n    94\t\n    95\t    if value > 0x10FFFF {\n    96\t        /* not in Unicode range */\n    97\t        return 0;\n    98\t    } else if (0xD800..=0xDFFF).contains(&value) {\n    99\t        /* UTF-16 surrogate halves */\n   100\t        return 0;\n   101\t    } else if (size == 2 && value < 0x80)\n   102\t        || (size == 3 && value < 0x800)\n   103\t        || (size == 4 && value < 0x10000)\n   104\t    {\n   105\t        /* overlong