nue;\n256\t        }\n257\t\n258\t        if (s->has_error)\n259\t            json_decref(value);\n260\t\n261\t        if (!s->has_error && json_object_setn_new_nocheck(object, key, len, value)) {\n262\t            set_error(s, \"<internal>\", json_error_out_of_memory,\n263\t                      \"Unable to add key \\\"%s\\\"\", key);\n264\t            s->has_error = 1;\n265\t        }\n266\t\n267\t        if (ours)\n268\t            jsonp_free(key);\n269\t\n270\t        next_token(s);\n271\t    }\n272\t\n273\t    if (!s->has_error)\n274\t        return object;\n275\t\n276\terror:\n277\t    json_decref(object);\n278\t    return NULL;\n279\t}\n280\t\n281\tstatic json_t *pack_array(scanner_t *s, va_list *ap) {\n282\t    json_t *array = json_array();\n283\t    next_token(s);\n284\t\n285\t    while (token(s) != ']') {\n286\t        json_t *value;\n287\t        char valueOptional;\n288\t\n289\t        if (!token(s)) {\n290\t            set_error(s, \"<format>\", json_error_invalid_format,\n291\t                      \"Unexpected end of format string\");\n292\t            /* Format string errors are unrecoverable. */\n293\t            goto error;\n294\t        }\n295\t\n296\t        next_token(s);\n297\t        valueOptional = token(s);\n298\t        prev_token(s);\n299\t\n300\t        value = pack(s, ap);\n301\t        if (!value) {\n302\t            if (valueOptional != '*') {\n303\t                s->has_error = 1;\n304\t            }\n305\t\n306\t            next_token(s);\n307\t            continue;\n308\t        }\n309\t\n310\t        if (s->has_error)\n311\t            json_decref(value);\n312\t\n313\t        if (!s->has_error && json_array_append_new(array, value)) {\n314\t            set_error(s, \"<internal>\", json_error_out_of_memory,\n315\t                      \"Unable to append to array\");\n316\t            s->has_error = 1;\n317\t        }\n318\t\n319\t        next_token(s);\n320\t    }\n321\t\n322\t    if (!s->has_error)\n323\t        return array;\n324\t\n325\terror:\n326\t    json_decref(array);\n327\t    return NULL;\n328\t}\n329\t\n330\tstatic json_t *pack_string(scanner_t *s, va_list *ap) {\n331\t    char *str;\n332\t    char t;\n333\t    size_t len;\n334\t    int ours;\n335\t    int optional;\n336\t\n337\t    next_token(s);\n338\t    t = token(s);\n339\t    optional = t == '?' || t == '*';\n340\t    if (!optional)\n341\t        prev_token(s);\n342\t\n343\t    str = read_string(s, ap, \"string\", &len, &ours, optional);\n344\t\n345\t    if (!str)\n346\t        return t == '?' && !s->has_error ? json_null() : NULL;\n347\t\n348\t    if (s->has_error) {\n349\t        /* It's impossible to reach this point if ours != 0, do not free str. */\n350\t        return NULL;\n351\t    }\n352\t\n353\t    if (ours)\n354\t        return jsonp_stringn_nocheck_own(str, len);\n355\t\n356\t    return json_stringn_nocheck(str, len);\n357\t}\n358\t\n359\tstatic json_t *pack_object_inter(scanner_t *s, va_list *ap, int need_incref) {\n360\t    json_t *json;\n361\t    char ntoken;\n362\t\n363\t    next_token(s);\n364\t    ntoken = token(s);\n365\t\n366\t    if (ntoken != '?' && ntoken != '*')\n367\t        prev_token(s);\n368\t\n369\t    json = va_arg(*ap, json_t *);\n370\t\n371\t    if (json)\n372\t        return need_incref ? json_incref(json) : json;\n373\t\n374\t    switch (ntoken) {\n375\t        case '?':\n376\t            return json_null();\n377\t        case '*':\n378\t            return NULL;\n379\t        default:\n380\t            break;\n381\t    }\n382\t\n383\t    set_error(s, \"<args>\", json_error_null_value, \"NULL object\");\n384\t    s->has_error = 1;\n385\t    return NULL;\n386\t}\n387\t\n388\tstatic json_t *pack_integer(scanner_t *s, json_int_t value) {\n389\t    json_t *json = json_integer(value);\n390\t\n391\t    if (!json) {\n392\t        set_error(s, \"<internal>\", json_error_out_of_memory, \"Out of memory\");\n393\t        s->has_error = 1;\n394\t    }\n395\t\n396\t    return json;\n397\t}\n398\t\n399\tstatic json_t *pack_real(scanner_t *s, double value) {\n400\t    /* Allocate without setting value so we can identify OOM error. */\n401\t    json_t *json = json_real(0.0);\n402\t\n403\t    if (!json) {\n404\t        set_error(s, \"<internal>\", json_error_out_of_memory, \"Out of memory\");\n405\t        s->has_error = 1;\n406\t\n407\t        return NULL;\n408\t    }\n409\t\n410\t    if (json_real_set(json, value)) {\n411\t        json_decref(json);\n412\t\n413\t        set_error(s, \"<args>\", json_error_numeric_overflow,\n414\t                  \"Invalid floating point value\");\n415\t        s->has_error = 1;\n416\t\n417\t        return NULL;\n418\t    }\n419\t\n420\t    return json;\n421\t}\n422\t\n423\tstatic json_t *pack(scanner_t *s, va_list *ap) {\n424\t    switch (token(s)) {\n425\t        case '{':\n426\t            return pack_object(s, ap);\n427\t\n428\t        case '[':\n429\t            return pack_array(s, ap);\n430\t\n431\t        case 's': /* string */\n432\t            return pack_string(s, ap);\n433\t\n434\t        case 'n': /* null */\n435\t            return json_null();\n436\t\n437\t        case 'b': /* boolean */\n438\t            return va_arg(*ap, int) ? json_true() : json_false();\n439\t\n440\t        case 'i': /* integer from int */\n441\t            return pack_integer(s, va_arg(*ap, int));\n442\t\n443\t        case 'I': /* integer from json_int_t */\n444\t            return pack_integer(s, va_arg(*ap, json_int_t));\n445\t\n446\t        case 'f': /* real */\n447\t            return pack_real(s, va_arg(*ap, double));\n448\t\n449\t        case 'O': /* a json_t object; increments refcount */\n450\t            return pack_object_inter(s, ap, 1);\n451\t\n452\t        case 'o': /* a json_t object; doesn't increment refcount */\n453\t            return pack_object_inter(s, ap, 0);\n454\t\n455\t        default:\n456\t            set_error(s, \"<format>\", json_error_invalid_format,\n457\t                      \"Unexpected format character '%c'\", token(s));\n458\t            s->has_error = 1;\n459\t            return NULL;\n460\t    }\n461\t}\n462\t\n463\tstatic int unpack(scanner_t *s, json_t *root, va_list *ap);\n464\t\n465\tstatic int unpack_object(scanner_t *s, json_t *root, va_list *ap) {\n466\t    int ret = -1;\n467\t    int strict = 0;\n468\t    int gotopt = 0;\n469\t\n470\t    /* Use a set (emulated by a hashtable) to check that all object\n471\t       keys are accessed. Checking that the correct number of keys\n472\t       were accessed is not enough, as the same key can be unpacked\n473\t       multiple times.\n474\t    */\n475\t    hashtable_t key_set;\n476\t\n477\t    if (hashtable_init(&key_set)) {\n478\t        set_error(s, \"<internal>\", json_error_out_of_memory, \"Out of memory\");\n479\t        return -1;\n480\t    }\n481\t\n482\t    if (root && !json_is_object(root)) {\n483\t        set_error(s, \"<validation>\", json_error_wrong_type, \"Expected object, got %s\",\n484\t                  type_name(root));\n485\t        goto out;\n486\t    }\n487\t    next_token(s);\n488\t\n489\t    while (token(s) != '}') {\n490\t        const char *key;\n491\t        size_t key_len;\n492\t        json_t *value;\n493\t        int opt = 0;\n494\t\n495\t        if (strict != 0) {\n496\t            set_error(s, \"<format>\", json_error_invalid_format,\n497\t                      \"Expected '}' after '%c', got '%c'\", (strict == 1 ? '!' : '*'),\n498\t                      token(s));\n499\t            goto out;\n500\t        }\n501\t\n502\t        if (!token(s)) {\n503\t            set_error(s, \"<format>\", json_error_invalid_format,\n504\t                      \"Unexpected end of format string\");\n505\t            goto out;\n506\t        }\n507\t\n508\t        if (token(s) == '!' || token(s) == '*') {\n509\t            strict = (token(s) == '!' ? 1 : -1);\n510\t            next_token(s);\n511\t            continue;\n512\t        }\n513\t\n514\t        if (token(s) != 's') {\n515\t            set_error(s, \"<format>\", json_error_invalid_format,\n516\t                      \"Expected format 's', got '%c'\", token(s));\n517\t            goto out;\n518\t        }\n519\t\n520\t        key = va_arg(*ap, const char *);\n521\t        if (!key) {\n522\t            set_error(s, \"<args>\", json_error_null_value, \"NULL object key\");\n523\t            goto out;\n524\t        }\n525\t        key_len = strlen(key);\n526\t\n527\t        next_token(s);\n528\t\n529\t        if (token(s) == '?') {\n530\t            opt = gotopt = 1;\n531\t            next_token(s);\n532\t        }\n533\t\n534\t        if (!root) {\n535\t            /* skipping */\n536\t            value = NULL;\n537\t        } else {\n538\t            value = json_object_getn(root, key, key_len);\n539\t            if (!value && !opt) {\n540\t                set_error(s, \"<validation>\", json_error_item_not_found,\n541\t                          \"Object item not found: %s\", key);\n542\t                goto out;\n543\t            }\n544\t        }\n545\t\n546\t        if (unpack(s, value, ap))\n547\t            goto out;\n548\t\n549\t        hashtable_set(&key_set, key, key_len, json_null());\n550\t        next_token(s);\n551\t    }\n552\t\n553\t    if (strict == 0 && (s->flags & JSON_STRICT))\n554\t        strict = 1;\n555\t\n556\t    if (root && strict == 1) {\n557\t        /* We need to check that all non optional items have been parsed */\n558\t        const char *key;\n559\t        size_t key_len;\n560\t        /* keys_res is 1 for uninitialized, 0 for success, -1 for error. */\n561\t        int keys_res = 1;\n562\t        strbuffer_t unrecognized_keys;\n563\t        json_t *value;\n564\t        long unpacked = 0;\n565\t\n566\t        if (gotopt || json_object_size(root) != key_set.size) {\n567\t            json_object_keylen_foreach(root, key, key_len, value) {\n568\t                if (!hashtable_get(&key_set, key, key_len)) {\n569\t                    unpacked++;\n570\t\n571\t                    /* Save unrecognized keys for the error message */\n572\t                    if (keys_res == 1) {\n573\t                        keys_res = strbuffer_init(&unrecognized_keys);\n574\t                    } else if (!keys_res) {\n575\t                        keys_res = strbuffer_append_bytes(&unrecognized_keys, \", \", 2);\n576\t                    }\n577\t\n578\t                    if (!keys_res)\n579\t                        keys_res =\n580\t                            strbuffer_append_bytes(&unrecognized_keys, key, key_len);\n581\t                }\n582\t            }\n583\t        }\n584\t        if (unpacked) {\n585\t            set_error(s, \"<validation>\", json_error_end_of_input_expected,\n586\t                      \"%li object item(s) left unpacked: %s\", unpacked,\n587\t                      keys_res ? \"<unknown>\" : strbuffer_value(&unrecognized_keys));\n588\t            strbuffer_close(&unrecognized_keys);\n589\t            goto out;\n590\t        }\n591\t    }\n592\t\n593\t    ret = 0;\n594\t\n595\tout:\n596\t    hashtable_close(&key_set);\n597\t    return ret;\n598\t}\n599\t\n600\tstatic int unpack_array(scanner_t *s, json_t *root, va_list *ap) {\n601\t    size_t i = 0;\n602\t    int strict = 0;\n603\t\n604\t    if (root && !json_is_array(root)) {\n605\t        set_error(s, \"<validation>\", json_error_wrong_type, \"Expected array, got %s\",\n606\t                  type_name(root));\n607\t        return -1;\n608\t    }\n609\t    next_token(s);\n610\t\n611\t    while (token(s) != ']') {\n612\t        json_t *value;\n613\t\n614\t        if (strict != 0) {\n615\t            set_error(s, \"<format>\", json_error_invalid_format,\n616\t                      \"Expected ']' after '%c', got '%c'\", (strict == 1 ? '!' : '*'),\n617\t                      token(s));\n618\t            return -1;\n619\t        }\n620\t\n621\t        if (!token(s)) {\n622\t            set_error(s, \"<format>\", json_error_invalid_format,\n623\t                      \"Unexpected end of format string\");\n624\t            return -1;\n625\t        }\n626\t\n627\t        if (token(s) == '!' || token(s) == '*') {\n628\t            strict = (token(s) == '!' ? 1 : -1);\n629\t            next_token(s);\n630\t            continue;\n631\t        }\n632\t\n633\t        if (!strchr(unpack_value_starters, token(s))) {\n634\t            set_error(s, \"<format>\", json_error_invalid_format,\n635\t                      \"Unexpected format character '%c'\", token(s));\n636\t            return -1;\n637\t        }\n638\t\n639\t        if (!root) {\n640\t            /* skipping */\n641\t            value = NULL;\n642\t        } else {\n643\t            value = json_array_get(root, i);\n644\t            if (!value) {\n645\t                set_error(s, \"<validation>\", json_error_index_out_of_range,\n646\t                          \"Array index %lu out of range\", (unsigned long)i);\n647\t                return -1;\n648\t            }\n649\t        }\n650\t\n651\t        if (unpack(s, value, ap))\n652\t            return -1;\n653\t\n654\t        next_token(s);\n655\t        i++;\n656\t    }\n657\t\n658\t    if (strict == 0 && (s->flags & JSON_STRICT))\n659\t        strict = 1;\n660\t\n661\t    if (root && strict == 1 && i != json_array_size(root)) {\n662\t        long diff = (long)json_array_size(root) - (long)i;\n663\t        set_error(s, \"<validation>\", json_error_end_of_input_expected,\n664\t                  \"%li array item(s) left unpacked\", diff);\n665\t        return -1;\n666\t    }\n667\t\n668\t    return 0;\n669\t}\n670\t\n671\tstatic int unpack(scanner_t *s, json_t *root, va_list *ap) {\n672\t    switch (token(s)) {\n673\t        case '{':\n674\t            return unpack_object(s, root, ap);\n675\t\n676\t        case '[':\n677\t            return unpack_array(s, root, ap);\n678\t\n679\t        case 's':\n680\t            if (root && !json_is_string(root)) {\n681\t                set_error(s, \"<validation>\", json_error_wrong_type,\n682\t                          \"E