{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '345,380p' c_src/src/lz4hc.c; sed -n '350,410p' c_src/src/lz4hc.c; sed -n '150,245p' c_src/include/lz4frame.h; sed -n '245,540p' c_src/include/lz4frame.h | rg -n 'LZ4F_[A-Za-z0-9_]+\\\\(' -B2 -A5\"","aggregated_output":"    /* Prepare next loop */\n    ip += matchLength;\n    anchor = ip;\n\n    return 0;\n\n#undef ip\n#undef op\n#undef anchor\n}\n\n\ntypedef struct {\n    int off;\n    int len;\n    int back;  /* negative value */\n} LZ4HC_match_t;\n\nLZ4HC_match_t LZ4HC_searchExtDict(const BYTE* ip, U32 ipIndex,\n        const BYTE* const iLowLimit, const BYTE* const iHighLimit,\n        const LZ4HC_CCtx_internal* dictCtx, U32 gDictEndIndex,\n        int currentBestML, int nbAttempts)\n{\n    size_t const lDictEndIndex = (size_t)(dictCtx->end - dictCtx->prefixStart) + dictCtx->dictLimit;\n    U32 lDictMatchIndex = dictCtx->hashTable[LZ4HC_hashPtr(ip)];\n    U32 matchIndex = lDictMatchIndex + gDictEndIndex - (U32)lDictEndIndex;\n    int offset = 0, sBack = 0;\n    assert(lDictEndIndex <= 1 GB);\n    if (lDictMatchIndex>0)\n        DEBUGLOG(7, \"lDictEndIndex = %zu, lDictMatchIndex = %u\", lDictEndIndex, lDictMatchIndex);\n    while (ipIndex - matchIndex <= LZ4_DISTANCE_MAX && nbAttempts--) {\n        const BYTE* const matchPtr = dictCtx->prefixStart - dictCtx->dictLimit + lDictMatchIndex;\n\n        if (LZ4_read32(matchPtr) == LZ4_read32(ip)) {\n            int mlt;\n            int back = 0;\n\n#undef ip\n#undef op\n#undef anchor\n}\n\n\ntypedef struct {\n    int off;\n    int len;\n    int back;  /* negative value */\n} LZ4HC_match_t;\n\nLZ4HC_match_t LZ4HC_searchExtDict(const BYTE* ip, U32 ipIndex,\n        const BYTE* const iLowLimit, const BYTE* const iHighLimit,\n        const LZ4HC_CCtx_internal* dictCtx, U32 gDictEndIndex,\n        int currentBestML, int nbAttempts)\n{\n    size_t const lDictEndIndex = (size_t)(dictCtx->end - dictCtx->prefixStart) + dictCtx->dictLimit;\n    U32 lDictMatchIndex = dictCtx->hashTable[LZ4HC_hashPtr(ip)];\n    U32 matchIndex = lDictMatchIndex + gDictEndIndex - (U32)lDictEndIndex;\n    int offset = 0, sBack = 0;\n    assert(lDictEndIndex <= 1 GB);\n    if (lDictMatchIndex>0)\n        DEBUGLOG(7, \"lDictEndIndex = %zu, lDictMatchIndex = %u\", lDictEndIndex, lDictMatchIndex);\n    while (ipIndex - matchIndex <= LZ4_DISTANCE_MAX && nbAttempts--) {\n        const BYTE* const matchPtr = dictCtx->prefixStart - dictCtx->dictLimit + lDictMatchIndex;\n\n        if (LZ4_read32(matchPtr) == LZ4_read32(ip)) {\n            int mlt;\n            int back = 0;\n            const BYTE* vLimit = ip + (lDictEndIndex - lDictMatchIndex);\n            if (vLimit > iHighLimit) vLimit = iHighLimit;\n            mlt = (int)LZ4_count(ip+MINMATCH, matchPtr+MINMATCH, vLimit) + MINMATCH;\n            back = (ip > iLowLimit) ? LZ4HC_countBack(ip, matchPtr, iLowLimit, dictCtx->prefixStart) : 0;\n            mlt -= back;\n            if (mlt > currentBestML) {\n                currentBestML = mlt;\n                offset = (int)(ipIndex - matchIndex);\n                sBack = back;\n                DEBUGLOG(7, \"found match of length %i within extDictCtx\", currentBestML);\n        }   }\n\n        {   U32 const nextOffset = DELTANEXTU16(dictCtx->chainTable, lDictMatchIndex);\n            lDictMatchIndex -= nextOffset;\n            matchIndex -= nextOffset;\n    }   }\n\n    {   LZ4HC_match_t md;\n        md.len = currentBestML;\n        md.off = offset;\n        md.back = sBack;\n        return md;\n    }\n}\n\ntypedef LZ4HC_match_t (*LZ4MID_searchIntoDict_f)(const BYTE* ip, U32 ipIndex,\n        const BYTE* const iHighLimit,\n        const LZ4HC_CCtx_internal* dictCtx, U32 gDictEndIndex);\n\nstatic LZ4HC_match_t LZ4MID_searchHCDict(const BYTE* ip, U32 ipIndex,\n} LZ4F_contentChecksum_t;\n\ntypedef enum {\n    LZ4F_noBlockChecksum=0,\n    LZ4F_blockChecksumEnabled\n} LZ4F_blockChecksum_t;\n\ntypedef enum {\n    LZ4F_frame=0,\n    LZ4F_skippableFrame\n    LZ4F_OBSOLETE_ENUM(skippableFrame)\n} LZ4F_frameType_t;\n\n#ifdef LZ4F_ENABLE_OBSOLETE_ENUMS\ntypedef LZ4F_blockSizeID_t blockSizeID_t;\ntypedef LZ4F_blockMode_t blockMode_t;\ntypedef LZ4F_frameType_t frameType_t;\ntypedef LZ4F_contentChecksum_t contentChecksum_t;\n#endif\n\n/*! LZ4F_frameInfo_t :\n *  makes it possible to set or read frame parameters.\n *  Structure must be first init to 0, using memset() or LZ4F_INIT_FRAMEINFO,\n *  setting all parameters to default.\n *  It's then possible to update selectively some parameters */\ntypedef struct {\n  LZ4F_blockSizeID_t     blockSizeID;         /* max64KB, max256KB, max1MB, max4MB; 0 == default (LZ4F_max64KB) */\n  LZ4F_blockMode_t       blockMode;           /* LZ4F_blockLinked, LZ4F_blockIndependent; 0 == default (LZ4F_blockLinked) */\n  LZ4F_contentChecksum_t contentChecksumFlag; /* 1: add a 32-bit checksum of frame's decompressed data; 0 == default (disabled) */\n  LZ4F_frameType_t       frameType;           /* read-only field : LZ4F_frame or LZ4F_skippableFrame */\n  unsigned long long     contentSize;         /* Size of uncompressed content ; 0 == unknown */\n  unsigned               dictID;              /* Dictionary ID, sent by compressor to help decoder select correct dictionary; 0 == no dictID provided */\n  LZ4F_blockChecksum_t   blockChecksumFlag;   /* 1: each block followed by a checksum of block's compressed data; 0 == default (disabled) */\n} LZ4F_frameInfo_t;\n\n#define LZ4F_INIT_FRAMEINFO   { LZ4F_max64KB, LZ4F_blockLinked, LZ4F_noContentChecksum, LZ4F_frame, 0ULL, 0U, LZ4F_noBlockChecksum }    /* v1.8.3+ */\n\n/*! LZ4F_preferences_t :\n *  makes it possible to supply advanced compression instructions to streaming interface.\n *  Structure must be first init to 0, using memset() or LZ4F_INIT_PREFERENCES,\n *  setting all parameters to default.\n *  All reserved fields must be set to zero. */\ntypedef struct {\n  LZ4F_frameInfo_t frameInfo;\n  int      compressionLevel;    /* 0: default (fast mode); values > LZ4HC_CLEVEL_MAX count as LZ4HC_CLEVEL_MAX; values < 0 trigger \"fast acceleration\" */\n  unsigned autoFlush;           /* 1: always flush; reduces usage of internal buffers */\n  unsigned favorDecSpeed;       /* 1: parser favors decompression speed vs compression ratio. Only works for high compression modes (>= LZ4HC_CLEVEL_OPT_MIN) */  /* v1.8.2+ */\n  unsigned reserved[3];         /* must be zero for forward compatibility */\n} LZ4F_preferences_t;\n\n#define LZ4F_INIT_PREFERENCES   { LZ4F_INIT_FRAMEINFO, 0, 0u, 0u, { 0u, 0u, 0u } }    /* v1.8.3+ */\n\n\n/*-*********************************\n*  Simple compression function\n***********************************/\n\n/*! LZ4F_compressFrame() :\n *  Compress srcBuffer content into an LZ4-compressed frame.\n *  It's a one shot operation, all input content is consumed, and all output is generated.\n *\n *  Note : it's a stateless operation (no LZ4F_cctx state needed).\n *  In order to reduce load on the allocator, LZ4F_compressFrame(), by default,\n *  uses the stack to allocate space for the compression state and some table.\n *  If this usage of the stack is too much for your application,\n *  consider compiling `lz4frame.c` with compile-time macro LZ4F_HEAPMODE set to 1 instead.\n *  All state allocations will use the Heap.\n *  It also means each invocation of LZ4F_compressFrame() will trigger several internal alloc/free invocations.\n *\n * @dstCapacity MUST be >= LZ4F_compressFrameBound(srcSize, preferencesPtr).\n * @preferencesPtr is optional : one can provide NULL, in which case all preferences are set to default.\n * @return : number of bytes written into dstBuffer.\n *           or an error code if it fails (can be tested using LZ4F_isError())\n */\nLZ4FLIB_API size_t LZ4F_compressFrame(void* dstBuffer, size_t dstCapacity,\n                                const void* srcBuffer, size_t srcSize,\n                                const LZ4F_preferences_t* preferencesPtr);\n\n/*! LZ4F_compressFrameBound() :\n *  Returns the maximum possible compressed size with LZ4F_compressFrame() given srcSize and preferences.\n * `preferencesPtr` is optional. It can be replaced by NULL, in which case, the function will assume default preferences.\n *  Note : this result is only usable with LZ4F_compressFrame().\n *         It may also be relevant to LZ4F_compressUpdate() _only if_ no flush() operation is ever performed.\n */\nLZ4FLIB_API size_t LZ4F_compressFrameBound(size_t srcSize, const LZ4F_preferences_t* preferencesPtr);\n\n\n/*! LZ4F_compressionLevel_max() :\n * @return maximum allowed compression level (currently: 12)\n */\nLZ4FLIB_API int LZ4F_compressionLevel_max(void);   /* v1.8.0+ */\n\n\n/*-***********************************\n*  Advanced compression functions\n*************************************/\n4-\n5-typedef struct {\n6:  unsigned stableSrc;    /* 1 == src content will remain present on future calls to LZ4F_compress(); skip copying src content within tmp buffer */\n7-  unsigned reserved[3];\n8-} LZ4F_compressOptions_t;\n9-\n10-/*---   Resource Management   ---*/\n11-\n12-#define LZ4F_VERSION 100    /* This number can be used to check for an incompatible API breaking change */\n13:LZ4FLIB_API unsigned LZ4F_getVersion(void);\n14-\n15:/*! LZ4F_createCompressionContext() :\n16- *  The first thing to do is to create a compressionContext object,\n17- *  which will keep track of operation state during streaming compression.\n18: *  This is achieved using LZ4F_createCompressionContext(), which takes as argument a version,\n19- *  and a pointer to LZ4F_cctx*, to write the resulting pointer into.\n20- *  @version provided MUST be LZ4F_VERSION. It is intended to track potential version mismatch, notably when using DLL.\n21- *  The function provides a pointer to a fully allocated LZ4F_cctx object.\n22- *  @cctxPtr MUST be != NULL.\n23- *  If @return != zero, context creation failed.\n24- *  A created compression context can be employed multiple times for consecutive streaming operations.\n25- *  Once all streaming compression jobs are completed,\n26: *  the state object can be released using LZ4F_freeCompressionContext().\n27: *  Note1 : LZ4F_freeCompressionContext() is always successful. Its return value can be ignored.\n28: *  Note2 : LZ4F_freeCompressionContext() works fine with NULL input pointers (do nothing).\n29-**/\n30:LZ4FLIB_API LZ4F_errorCode_t LZ4F_createCompressionContext(LZ4F_cctx** cctxPtr, unsigned version);\n31:LZ4FLIB_API LZ4F_errorCode_t LZ4F_freeCompressionContext(LZ4F_cctx* cctx);\n32-\n33-\n34-/*----    Compression    ----*/\n35-\n36-#define LZ4F_HEADER_SIZE_MIN  7   /* LZ4 Frame header size can vary, depending on selected parameters */\n--\n46-#define LZ4F_CONTENT_CHECKSUM_SIZE 4\n47-\n48:/*! LZ4F_compressBegin() :\n49- *  will write the frame header into dstBuffer.\n50- *  dstCapacity must be >= LZ4F_HEADER_SIZE_MAX bytes.\n51- * `prefsPtr` is optional : NULL can be provided to set all preferences to default.\n52- * @return : number of bytes written into dstBuffer for the header\n53: *           or an error code (which can be tested using LZ4F_isError())\n54- */\n55:LZ4FLIB_API size_t LZ4F_compressBegin(LZ4F_cctx* cctx,\n56-                                      void* dstBuffer, size_t dstCapacity,\n57-                                      const LZ4F_preferences_t* prefsPtr);\n58-\n59:/*! LZ4F_compressBound() :\n60- *  Provides minimum dstCapacity required to guarantee success of\n61: *  LZ4F_compressUpdate(), given a srcSize and preferences, for a worst case scenario.\n62: *  When srcSize==0, LZ4F_compressBound() provides an upper bound for LZ4F_flush() and LZ4F_compressEnd() instead.\n63: *  Note that the result is only valid for a single invocation of LZ4F_compressUpdate().\n64: *  When invoking LZ4F_compressUpdate() multiple times,\n65- *  if the output buffer is gradually filled up instead of emptied and re-used from its start,\n66: *  one must check if there is enough remaining capacity before each invocation, using LZ4F_compressBound().\n67- * @return is always the same for a srcSize and prefsPtr.\n68- *  prefsPtr is optional : when NULL is provided, preferences will be set to cover worst case scenario.\n69- *  tech details :\n70- * @return if automatic flushing is not enabled, includes the possibility that internal buffer might already be filled by up to (blockSize-1) bytes.\n71: *  It also includes frame footer (ending + checksum), since it might be generated by LZ4F_compressEnd().\n72: * @return doesn't include frame header, as it was already generated by LZ4F_compressBegin().\n73- */\n74:LZ4FLIB_API size_t LZ4F_compressBound(size_t srcSize, const LZ4F_preferences_t* prefsPtr);\n75-\n76:/*! LZ4F_compressUpdate() :\n77: *  LZ4F_compressUpdate() can be called repetitively to compress as much data as necessary.\n78- *  Important rule: dstCapacity MUST be large enough to ensure operation success even in worst case situations.\n79: *  This value is provided by LZ4F_compressBound().\n80: *  If this condition is not respected, LZ4F_compress() will fail (result is an errorCode).\n81- *  After an error, the state is left in a UB state, and must be re-initialized or freed.\n82- *  If previously an uncompressed block was written, buffered data is flushed\n83- *  before appending compressed data is continued.\n84- * `cOptPtr` is optional : NULL can be provided, in which case all options are set to default.\n85- * @return : number of bytes written into `dstBuffer` (it can be zero, meaning input data was just buffered).\n86: *           or an error code if it fails (which can be tested using LZ4F_isError())\n87- */\n88:LZ4FLIB_API size_t LZ4F_compressUpdate(LZ4F_cctx* cctx,\n89-                                       void* dstBuffer, size_t dstCapacity,\n90-                                 const void* srcBuffer, size_t srcSize,\n91-                                 const LZ4F_compressOptions_t* cOptPtr);\n92-\n93:/*! LZ4F_flush() :\n94- *  When data must be generated and sent immediately, without waiting for a block to be completely filled,\n95- *  it's possible to call LZ4_flush(). It will immediately compress any data buffered within cctx.\n96- * `dstCapacity` must be large enough to ensure the operation will be successful.\n97- * `cOptPtr` is optional : it's possible to provide NULL, all options will be set to default.\n98- * @return : nb of bytes written into dstBuffer (can be zero, when there is no data stored within cctx)\n99: *           or an error code if it fails (which can be tested using LZ4F_isError())\n100: *  Note : LZ4F_flush() is guaranteed to be successful when dstCapacity >= LZ4F_compressBound(0, prefsPtr).\n101- */\n102:LZ4FLIB_API size_t LZ4F_flush(LZ4F_cctx* cctx,\n103-                              void* dstBuffer, size_t dstCapacity,\n104-                        const LZ4F_compressOptions_t* cOptPtr);\n105-\n106:/*! LZ4F_compressEnd() :\n107: *  To properly finish an LZ4 frame, invoke LZ4F_compressEnd().\n108- *  It will flush whatever data remained within `cctx` (like LZ4_flush())\n109- *  and properly finalize the frame, with an endMark and a checksum.\n110- * `cOptPtr` is optional : NULL can be provided, in which case all options will be set to default.\n111- * @return : nb of bytes written into dstBuffer, necessarily >= 4 (endMark),\n112: *           or an error code if it fails (which can be tested using LZ4F_isError())\n113: *  Note : LZ4F_compressEnd() is guaranteed to be successful when dstCapacity >= LZ4F_compressBound(0, prefsPtr).\n114: *  A successful call to LZ4F_compressEnd() makes `cctx` available again for another compression task.\n115- */\n116:LZ4FLIB_API size_t LZ4F_compressEnd(LZ4F_cctx* cctx,\n117-                                    void* dstBuffer, size_t dstCapacity,\n118-                              const LZ4F_compressOptions_t* cOptPtr);\n119-\n120-\n121-/*-*********************************\n--\n138-/* Resource management */\n139-\n140:/*! LZ4F_createDecompressionContext() :\n141- *  Create an LZ4F_dctx object, to track all decompression operations.\n142- *  @version provided MUST be LZ4F_VERSION.\n143- *  @dctxPtr MUST be valid.\n144- *  The function fills @dctxPtr with the value of a pointer to an allocated and initialized LZ4F_dctx object.\n145: *  The @return is an errorCode, which can be tested using LZ4F_isError().\n146: *  dctx memory can be released using LZ4F_freeDecompressionContext();\n147: *  Result of LZ4F_freeDecompressionContext() indicates current state of decompressionContext when being released.\n148- *  That is, it should be == 0 if decompression has been completed fully and correctly.\n149- */\n150:LZ4FLIB_API LZ4F_errorCode_t LZ4F_createDecompressionContext(LZ4F_dctx** dctxPtr, unsigned version);\n151:LZ4FLIB_API LZ4F_errorCode_t LZ4F_freeDecompressionContext(LZ4F_dctx* dctx);\n152-\n153-\n154-/*-***********************************\n155-*  Streaming decompression functions\n156-*************************************/\n--\n160-#define LZ4F_MIN_SIZE_TO_KNOW_HEADER_LENGTH 5\n161-\n162:/*! LZ4F_headerSize() : v1.9.0+\n163- *  Provide the header size of a frame starting at `src`.\n164- * `srcSize` must be >= LZ4F_MIN_SIZE_TO_KNOW_HEADER_LENGTH,\n165- *  which is enough to decode the header length.\n166- * @return : size of frame header\n167: *           or an error code, which can be tested using LZ4F_isError()\n168- *  note : Frame header size is variable, but is guaranteed to be\n169- *         >= LZ4F_HEADER_SIZE_MIN bytes, and <= LZ4F_HEADER_SIZE_MAX bytes.\n170- */\n171:LZ4FLIB_API size_t LZ4F_headerSize(const void* src, size_t srcSize);\n172-\n173:/*! LZ4F_getFrameInfo() :\n174- *  This function extracts frame parameters (max blockSize, dictID, etc.).\n175: *  Its usage is optional: user can also invoke LZ4F_decompress() directly.\n176- *\n177- *  Extracted information will fill an existing LZ4F_frameInfo_t structure.\n178- *  This can be useful for allocation and dictionary identification purposes.\n179- *\n180: *  LZ4F_getFrameInfo() can work in the following situations :\n181- *\n182: *  1) At the beginning of a new frame, before any invocation of LZ4F_decompress().\n183- *     It will decode header from `srcBuffer`,\n184- *     consuming the header and starting the decoding process.\n185- *\n186- *     Input size must be large enough to contain the full frame header.\n187: *     Frame header size can be known beforehand by LZ4F_headerSize().\n188- *     Frame header size is variable, but is guaranteed to be >= LZ4F_HEADER_SIZE_MIN bytes,\n189- *     and not more than <= LZ4F_HEADER_SIZE_MAX bytes.\n190- *     Hence, blindly providing LZ4F_HEADER_SIZE_MAX bytes or more will always work.\n191- *     It's allowed to provide more input data than the header size,\n192: *     LZ4F_getFrameInfo() will only consume the header.\n193- *\n194- *     If input size is not large enough,\n195- *     aka if it's smaller than header size,\n196- *     function will fail and return an error code.\n197- *\n198- *  2) After decoding has been started,\n199: *     it's possible to invoke LZ4F_getFrameInfo() anytime\n200- *     to extract already decoded frame parameters stored within dctx.\n201- *\n202- *     Note that, if decoding has barely started,\n203- *     and not yet read enough information to decode the header,\n204: *     LZ4F_getFrameInfo() will fail.\n205- *\n206- *  The number of bytes consumed from srcBuffer will be updated in *srcSizePtr (necessarily <= original value).\n207: *  LZ4F_getFrameInfo() only consumes bytes when decoding has not yet started,\n208- *  and when decoding the header has been successful.\n209- *  Decompression must then resume from (srcBuffer + *srcSizePtr).\n210- *\n211: * @return : a hint about how many srcSize bytes LZ4F_decompress() expects for next call,\n212: *           or an error code which can be tested using LZ4F_isError().\n213- *  note 1 : in case of error, dctx is not modified. Decoding operation can resume from beginning safely.\n214- *  note 2 : frame parameters are *copied into* an already allocated LZ4F_frameInfo_t structure.\n215- */\n216-LZ4FLIB_API size_t\n217:LZ4F_getFrameInfo(LZ4F_dctx* dctx,\n218-                  LZ4F_frameInfo_t* frameInfoPtr,\n219-            const void* srcBuffer, size_t* srcSizePtr);\n220-\n221:/*! LZ4F_decompress() :\n222- *  Call this function repetitively to regenerate data compressed in `srcBuffer`.\n223- *\n224- *  The function requires a valid dctx state.\n225- *  It will read up to *srcSizePtr bytes from srcBuffer,\n226- *  and decompress data into dstBuffer, of capacity *dstSizePtr.\n--\n235- * `dstBuffer` content will be overwritten.\n236- *\n237: *  Note: if `LZ4F_getFrameInfo()` is called before `LZ4F_decompress()`, srcBuffer must be updated to reflect\n238- *  the number of bytes consumed after reading the frame header. Failure to update srcBuffer before calling\n239: *  `LZ4F_decompress()` will cause decompression failure or, even worse, successful but incorrect decompression.\n240: *  See the `LZ4F_getFrameInfo()` docs for details.\n241- *\n242: * @return : an hint of how many `srcSize` bytes LZ4F_decompress() expects for next call.\n243- *  Schematically, it's the size of the current (or remaining) compressed block + header of next block.\n244- *  Respecting the hint provides some small speed benefit, because it skips intermediate buffers.\n245- *  This is just a hint though, it's always possible to provide any srcSize.\n246- *\n247- *  When a frame is fully decoded, @return will be 0 (no more data expected).\n248- *  When provided with more bytes than necessary to decode a frame,\n249: *  LZ4F_decompress() will stop reading exactly at end of current frame, and @return 0.\n250- *\n251: *  If decompression failed, @return is an error code, which can be tested using LZ4F_isError().\n252- *  After a decompression error, the `dctx` context is not resumable.\n253: *  Use LZ4F_resetDecompressionContext() to return to clean state.\n254- *\n255- *  After a frame is fully decoded, dctx can be used again to decompress another frame.\n256- */\n257-LZ4FLIB_API size_t\n258:LZ4F_decompress(LZ4F_dctx* dctx,\n259-                void* dstBuffer, size_t* dstSizePtr,\n260-          const void* srcBuffer, size_t* srcSizePtr,\n261-          const LZ4F_decompressOptions_t* dOptPtr);\n262-\n263-\n264:/*! LZ4F_resetDecompressionContext() : added in v1.8.0\n265- *  In case of an error, the context is left in \"undefined\" state.\n266- *  In which case, it's necessary to reset it, before re-using it.\n267- *  This method can also be used to abruptly stop any unfinished decompression,\n268- *  and start a new one using same context resources. */\n269:LZ4FLIB_API void LZ4F_resetDecompressionContext(LZ4F_dctx* dctx);   /* always successful */\n270-\n271-\n272-/**********************************\n273- *  Dictionary compression API\n274- *********************************/\n--\n287- */\n288-\n289:/*! LZ4F_compressBegin_usingDict() : stable since v1.10\n290- *  Inits dictionary compression streaming, and writes the frame header into dstBuffer.\n291- * @dstCapacity must be >= LZ4F_HEADER_SIZE_MAX bytes.\n292- * @prefsPtr is optional : one may provide NULL as argument,\n293- *  however, it's the only way to provide dictID in the frame header.\n294- * @dictBuffer must outlive the compression session.\n295- * @return : number of bytes written into dstBuffer for the header,\n296: *           or an error code (which can be tested using LZ4F_isError())\n","exit_code":0,"status":"completed"}}
