  421\t    }\n   422\t\n   423\tout:\n   424\t    hashtable_del(parents, loop_key, loop_key_len);\n   425\t\n   426\t    return result;\n   427\t}\n   428\t\n   429\t/*** array ***/\n   430\t\n   431\tjson_t *json_array(void) {\n   432\t    json_array_t *array = jsonp_malloc(sizeof(json_array_t));\n   433\t    if (!array)\n   434\t        return NULL;\n   435\t    json_init(&array->json, JSON_ARRAY);\n   436\t\n   437\t    array->entries = 0;\n   438\t    array->size = 8;\n   439\t\n   440\t    array->table = jsonp_malloc(array->size * sizeof(json_t *));\n   441\t    if (!array->table) {\n   442\t        jsonp_free(array);\n   443\t        return NULL;\n   444\t    }\n   445\t\n   446\t    return &array->json;\n   447\t}\n   448\t\n   449\tstatic void json_delete_array(json_array_t *array) {\n   450\t    size_t i;\n   451\t\n   452\t    for (i = 0; i < array->entries; i++)\n   453\t        json_decref(array->table[i]);\n   454\t\n   455\t    jsonp_free(array->table);\n   456\t    jsonp_free(array);\n   457\t}\n   458\t\n   459\tsize_t json_array_size(const json_t *json) {\n   460\t    if (!json_is_array(json))\n   461\t        return 0;\n   462\t\n   463\t    return json_to_array(json)->entries;\n   464\t}\n   465\t\n   466\tjson_t *json_array_get(const json_t *json, size_t index) {\n   467\t    json_array_t *array;\n   468\t    if (!json_is_array(json))\n   469\t        return NULL;\n   470\t    array = json_to_array(json);\n   471\t\n   472\t    if (index >= array->entries)\n   473\t        return NULL;\n   474\t\n   475\t    return array->table[index];\n   476\t}\n   477\t\n   478\tint json_array_set_new(json_t *json, size_t index, json_t *value) {\n   479\t    json_array_t *array;\n   480\t\n   481\t    if (!value)\n   482\t        return -1;\n   483\t\n   484\t    if (!json_is_array(json) || json == value) {\n   485\t        json_decref(value);\n   486\t        return -1;\n   487\t    }\n   488\t    array = json_to_array(json);\n   489\t\n   490\t    if (index >= array->entries) {\n   491\t        json_decref(value);\n   492\t        return -1;\n   493\t    }\n   494\t\n   495\t    json_decref(array->table[index]);\n   496\t    array->table[index] = value;\n   497\t\n   498\t    return 0;\n   499\t}\n   500\t\n   501\tstatic void array_move(json_array_t *array, size_t dest, size_t src, size_t count) {\n   502\t    memmove(&array->table[dest], &array->table[src], count * sizeof(json_t *));\n   503\t}\n   504\t\n   505\tstatic void array_copy(json_t **dest, size_t dpos, json_t **src, size_t spos,\n   506\t                       size_t count) {\n   507\t    memcpy(&dest[dpos], &src[spos], count * sizeof(json_t *));\n   508\t}\n   509\t\n   510\tstatic json_t **json_array_grow(json_array_t *array, size_t amount) {\n   511\t    size_t new_size;\n   512\t    json_t **old_table, **new_table;\n   513\t\n   514\t    if (array->entries + amount <= array->size)\n   515\t        return array->table;\n   516\t\n   517\t    old_table = array->table;\n   518\t\n   519\t    new_size = max(array->size + amount, array->size * 2);\n   520\t    new_table = jsonp_realloc(old_table, array->size * sizeof(json_t *),\n   521\t                              new_size * sizeof(json_t *));\n   522\t    if (!new_table)\n   523\t        return NULL;\n   524\t\n   525\t    array->size = new_size;\n   526\t    array->table = new_table;\n   527\t\n   528\t    return array->table;\n   529\t}\n   530\t\n   531\tint json_array_append_new(json_t *json, json_t *value) {\n   532\t    json_array_t *array;\n   533\t\n   534\t    if (!value)\n   535\t        return -1;\n   536\t\n   537\t    if (!json_is_array(json) || json == value) {\n   538\t        json_decref(value);\n   539\t        return -1;\n   540\t    }\n   541\t    array = json_to_array(json);\n   542\t\n   543\t    if (!json_array_grow(array, 1)) {\n   544\t        json_decref(value);\n   545\t        return -1;\n   546\t    }\n   547\t\n   548\t    array->table[array->entries] = value;\n   549\t    array->entries++;\n   550\t\n   551\t    return 0;\n   552\t}\n   553\t\n   554\tint json_array_insert_new(json_t *json, size_t index, json_t *value) {\n   555\t    json_array_t *array;\n   556\t\n   557\t    if (!value)\n   558\t        return -1;\n   559\t\n   560\t    if (!json_is_array(json) || json == value) {\n   561\t        json_decref(value);\n   562\t        return -1;\n   563\t    }\n   564\t    array = json_to_array(json);\n   565\t\n   566\t    if (index > array->entries) {\n   567\t        json_decref(value);\n   568\t        return -1;\n   569\t    }\n   570\t\n   571\t    if (!json_array_grow(array, 1)) {\n   572\t        json_decref(value);\n   573\t        return -1;\n   574\t    }\n   575\t    if (index != array->entries)\n   576\t        array_move(array, index + 1, index, array->entries - index);\n   577\t\n   578\t    array->table[index] = value;\n   579\t    array->entries++;\n   580\t\n   581\t    return 0;\n   582\t}\n   583\t\n   584\tint json_array_remove(json_t *json, size_t index) {\n   585\t    json_array_t *array;\n   586\t\n   587\t    if (!json_is_array(json))\n   588\t        return -1;\n   589\t    array = json_to_array(json);\n   590\t\n   591\t    if (index >= array->entries)\n   592\t        return -1;\n   593\t\n   594\t    json_decref(array->table[index]);\n   595\t\n   596\t    /* If we're removing the last element, nothing has to be moved */\n   597\t    if (index < array->entries - 1)\n   598\t        array_move(array, index, index + 1, array->entries - index - 1);\n   599\t\n   600\t    array->entries--;\n   601\t\n   602\t    return 0;\n   603\t}\n   604\t\n   605\tint json_array_clear(json_t *json) {\n   606\t    json_array_t *array;\n   607\t    size_t i;\n   608\t\n   609\t    if (!json_is_array(json))\n   610\t        return -1;\n   611\t    array = json_to_array(json);\n   612\t\n   613\t    for (i = 0; i < array->entries; i++)\n   614\t        json_decref(array->table[i]);\n   615\t\n   616\t    array->entries = 0;\n   617\t    return 0;\n   618\t}\n   619\t\n   620\tint json_array_extend(json_t *json, json_t *other_json) {\n   621\t    json_array_t *array, *other;\n   622\t    size_t i;\n   623\t\n   624\t    if (!json_is_array(json) || !json_is_array(other_json))\n   625\t        return -1;\n   626\t    array = json_to_array(json);\n   627\t    other = json_to_array(other_json);\n   628\t\n   629\t    if (!json_array_grow(array, other->entries))\n   630\t        return -1;\n   631\t\n   632\t    for (i = 0; i < other->entries; i++)\n   633\t        json_incref(other->table[i]);\n   634\t\n   635\t    array_copy(array->table, array->entries, other->table, 0, other->entries);\n   636\t\n   637\t    array->entries += other->entries;\n   638\t    return 0;\n   639\t}\n   640\t\n   641\tstatic int json_array_equal(const json_t *array1, const json_t *array2) {\n   642\t    size_t i, size;\n   643\t\n   644\t    size = json_array_size(array1);\n   645\t    if (size != json_array_size(array2))\n   646\t        return 0;\n   647\t\n   648\t    for (i = 0; i < size; i++) {\n   649\t        json_t *value1, *value2;\n   650\t\n   651\t        value1 = json_array_get(array1, i);\n   652\t        value2 = json_array_get(array2, i);\n   653\t\n   654\t        if (!json_equal(value1, value2))\n   655\t            return 0;\n   656\t    }\n   657\t\n   658\t    return 1;\n   659\t}\n   660\t\n   661\tstatic json_t *json_array_copy(json_t *array) {\n   662\t    json_t *result;\n   663\t    size_t i;\n   664\t\n   665\t    result = json_array();\n   666\t    if (!result)\n   667\t        return NULL;\n   668\t\n   669\t    for (i = 0; i < json_array_size(array); i++)\n   670\t        json_array_append(result, json_array_get(array, i));\n   671\t\n   672\t    return result;\n   673\t}\n   674\t\n   675\tstatic json_t *json_array_deep_copy(const json_t *array, hashtable_t *parents) {\n   676\t    json_t *result;\n   677\t    size_t i;\n   678\t    char loop_key[LOOP_KEY_LEN];\n   679\t    size_t loop_key_len;\n   680\t\n   681\t    if (jsonp_loop_check(parents, array, loop_key, sizeof(loop_key), &loop_key_len))\n   682\t        return NULL;\n   683\t\n   684\t    result = json_array();\n   685\t    if (!result)\n   686\t        goto out;\n   687\t\n   688\t    for (i = 0; i < json_array_size(array); i++) {\n   689\t        if (json_array_append_new(result,\n   690\t                                  do_deep_copy(json_array_get(array, i), parents))) {\n   691\t            json_decref(result);\n   692\t            result = NULL;\n   693\t            break;\n   694\t        }\n   695\t    }\n   696\t\n   697\tout:\n   698\t    hashtable_del(parents, loop_key, loop_key_len);\n   699\t\n   700\t    return result;\n   701\t}\n   702\t\n   703\t/*** string ***/\n   704\t\n   705\tstatic json_t *string_create(const char *value, size_t len, int own) {\n   706\t    char *v;\n   707\t    json_string_t *string;\n   708\t\n   709\t    if (!value)\n   710\t        return NULL;\n   711\t\n   712\t    if (own)\n   713\t        v = (char *)value;\n   714\t    else {\n   715\t        v = jsonp_strndup(value, len);\n   716\t        if (!v)\n   717\t            return NULL;\n   718\t    }\n   719\t\n   720\t    string = jsonp_malloc(sizeof(json_string_t));\n   721\t    if (!string) {\n   722\t        jsonp_free(v);\n   723\t        return NULL;\n   724\t    }\n   725\t    json_init(&string->json, JSON_STRING);\n   726\t    string->value = v;\n   727\t    string->length = len;\n   728\t\n   729\t    return &string->json;\n   730\t}\n   731\t\n   732\tjson_t *json_string_nocheck(const char *value) {\n   733\t    if (!value)\n   734\t        return NULL;\n   735\t\n   736\t    return string_create(value, strlen(value), 0);\n   737\t}\n   738\t\n   739\tjson_t *json_stringn_nocheck(const char *value, size_t len) {\n   740\t    return string_create(value, len, 0);\n   741\t}\n   742\t\n   743\t/* this is private; \"steal\" is not a public API concept */\n   744\tjson_t *jsonp_stringn_nocheck_own(const char *value, size_t len) {\n   745\t    return string_create(value, len, 1);\n   746\t}\n   747\t\n   748\tjson_t *json_string(const char *value) {\n   749\t    if (!value)\n   750\t        return NULL;\n   751\t\n   752\t    return json_stringn(value, strlen(value));\n   753\t}\n   754\t\n   755\tjson_t *json_stringn(const char *value, size_t len) {\n   756\t    if (!value || !utf8_check_string(value, len))\n   757\t        return NULL;\n   758\t\n   759\t    return json_stringn_nocheck(value, len);\n   760\t}\n   761\t\n   762\tconst char *json_string_value(const json_t *json) {\n   763\t    if (!json_is_string(json))\n   764\t        return NULL;\n   765\t\n   766\t    return json_to_string(json)->value;\n   767\t}\n   768\t\n   769\tsize_t json_string_length(const json_t *json) {\n   770\t    if (!json_is_string(json))\n   771\t        return 0;\n   772\t\n   773\t    return json_to_string(json)->length;\n   774\t}\n   775\t\n   776\tint json_string_set_nocheck(json_t *json, const char *value) {\n   777\t    if (!value)\n   778\t        return -1;\n   779\t\n   780\t    return json_string_setn_nocheck(json, value, strlen(value));\n   781\t}\n   782\t\n   783\tint json_string_setn_nocheck(json_t *json, const char *value, size_t len) {\n   784\t    char *dup;\n   785\t    json_string_t *string;\n   786\t\n   787\t    if (!json_is_string(json) || !value)\n   788\t        return -1;\n   789\t\n   790\t    dup = jsonp_strndup(value, len);\n   791\t    if (!dup)\n   792\t        return -1;\n   793\t\n   794\t    string = json_to_string(json);\n   795\t    jsonp_free(string->value);\n   796\t    string->value = dup;\n   797\t    string->length = len;\n   798\t\n   799\t    return 0;\n   800\t}\n   801\t\n   802\tint json_string_set(json_t *json, const char *value) {\n   803\t    if (!value)\n   804\t        return -1;\n   805\t\n   806\t    return json_string_setn(json, value, strlen(value));\n   807\t}\n   808\t\n   809\tint json_string_setn(json_t *json, const char *value, size_t len) {\n   810\t    if (!value || !utf8_check_string(value, len))\n   811\t        return -1;\n   812\t\n   813\t    return json_string_setn_nocheck(json, value, len);\n   814\t}\n   815\t\n   816\tstatic void json_delete_string(json_string_t *string) {\n   817\t    jsonp_free(string->value);\n   818\t    jsonp_free(string);\n   819\t}\n   820\t\n   821\tstatic int json_string_equal(const json_t *string1, const json_t *string2) {\n   822\t    json_string_t *s1, *s2;\n   823\t\n   824\t    s1 = json_to_string(string1);\n   825\t    s2 = json_to_string(string2);\n   826\t    return s1->length == s2->length && !memcmp(s1->value, s2->value, s1->length);\n   827\t}\n   828\t\n   829\tstatic json_t *json_string_copy(const json_t *string) {\n   830\t    json_string_t *s;\n   831\t\n   832\t    s = json_to_string(string);\n   833\t    return json_stringn_nocheck(s->value, s->length);\n   834\t}\n   835\t\n   836\tjson_t *json_vsprintf(const char *fmt, va_list ap) {\n   837\t    json_t *json = NULL;\n   838\t    int length;\n   839\t    char *buf;\n   840\t    va_list aq;\n   841\t    va_copy(aq, ap);\n   842\t\n   843\t    length = vsnprintf(NULL, 0, fmt, ap);\n   844\t    if (length < 0)\n   845\t        goto out;\n   846\t    if (length == 0) {\n   847\t        json = json_string(\"\");\n   848\t        goto out;\n   849\t    }\n   850\t\n   851\t    buf = jsonp_malloc((size_t)length + 1);\n   852\t    if (!buf)\n   853\t        goto out;\n   854\t\n   855\t    vsnprintf(buf, (size_t)length + 1, fmt, aq);\n   856\t    if (!utf8_check_string(buf, length)) {\n   857\t        jsonp_free(buf);\n   858\t        goto out;\n   859\t    }\n   860\t\n   861\t    json = jsonp_stringn_nocheck_own(buf, length);\n   862\t\n   863\tout:\n   864\t    va_end(aq);\n   865\t    return json;\n   866\t}\n   867\t\n   868\tjson_t *json_sprintf(const char *fmt, ...) {\n   869\t    json_t *result;\n   870\t    va_list ap;\n   871\t\n   872\t    va_start(ap, fmt);\n   873\t    result = json_vsprintf(fmt, ap);\n   874\t    va_end(ap);\n   875\t\n   876\t    return result;\n   877\t}\n   878\t\n   879\t/*** integer ***/\n   880\t\n   881\tjson_t *json_integer(json_int_t value) {\n   882\t    json_integer_t *integer = jsonp_malloc(sizeof(json_integer_t));\n   883\t    if (!integer)\n   884\t        return NULL;\n   885\t    json_init(&integer->json, JSON_INTEGER);\n   886\t\n   887\t    integer->value = value;\n   888\t    return &integer->json;\n   889\t}\n   890\t\n   891\tjson_int_t json_integer_value(const json_t *json) {\n   892\t    if (!json_is_integer(json))\n   893\t        return 0;\n   894\t\n   895\t    return json_to_integer(json)->value;\n   896\t}\n   897\t\n   898\tint json_integer_set(json_t *json, json_int_t value) {\n   899\t    if (!json_is_integer(json))\n   900\t        return -1;\n   901\t\n   902\t    json_to_integer(json)->value = value;\n   903\t\n   904\t    return 0;\n   905\t}\n   906\t\n   907\tstatic void json_delete_integer(json_integer_t *integer) { jsonp_free(integer); }\n   908\t\n   909\tstatic int json_integer_equal(const json_t *integer1, const json_t *integer2) {\n   910\t    return json_integer_value(integer1) == json_integer_value(integer2);\n   911\t}\n   912\t\n   913\tstatic json_t *json_integer_copy(const json_t *integer) {\n   914\t    return json_integer(json_integer_value(integer));\n   915\t}\n   916\t\n   917\t/*** real ***/\n   918\t\n   919\tjson_t *json_real(double value) {\n   920\t    json_real_t *real;\n   921\t\n   922\t    if (isnan(value) || isinf(value))\n   923\t        return NULL;\n   924\t\n   925\t    real = jsonp_malloc(sizeof(json_real_t));\n   926\t    if (!real)\n   927\t        return NULL;\n   928\t    json_init(&real->json, JSON_REAL);\n   929\t\n   930\t    real->value = value;\n   931\t    return &real->json;\n   932\t}\n   933\t\n   934\tdouble json_real_value(const json_t *json) {\n   935\t    if (!json_is_real(json))\n   936\t        return 0;\n   937\t\n   938\t    return json_to_real(json)->value;\n   939\t}\n   940\t\n   941\tint json_real_set(json_t *json, double value) {\n   942\t    if (!json_is_real(json) || isnan(value) || isinf(value))\n   943\t        return -1;\n   944\t\n   945\t    json_to_real(json)->value = value;\n   946\t\n   947\t    return 0;\n   948\t}\n   949\t\n   950\tstatic void json_delete_real(json_real_t *real) { jsonp_free(real); }\n   951\t\n   952\tstatic int json_real_equal(const json_t *real1, const json_t *real2) {\n   953\t    return json_real_value(real1) == json_real_value(real2);\n   954\t}\n   955\t\n   956\tstatic json_t *json_real_copy(const json_t *real) {\n   957\t    return json_real(json_real_value(real));\n   958\t}\n   959\t\n   960\t/*** number ***/\n   961\t\n   962\tdouble json_number_value(const json_t *json) {\n   963\t    if (json_is_integer(json))\n   964\t        return (double)json_integer_value(json);\n   965\t    else if (json_is_real(json))\n   966\t        return json_real_value(json);\n   967\t    else\n   968\t        return 0.0;\n   969\t}\n   970\t\n   971\t/*** simple values ***/\n   972\t\n   973\tjson_t *json_true(void) {\n   974\t    static json_t the_true = {JSON_TRUE, (size_t)-1};\n   975\t    return &the_true;\n   976\t}\n   977\t\n   978\tjson_t *json_false(void) {\n   979\t    static json_t the_false = {JSON_FALSE, (size_t)-1};\n   980\t    return &the_false;\n   981\t}\n   982\t\n   983\tjson_t *json_null(void) {\n   984\t    static json_t the_null = {JSON_NULL, (size_t)-1};\n   985\t    return &the_null;\n   986\t}\n   987\t\n   988\t/*** deletion ***/\n   989\t\n   990\tvoid json_delete(json_t *json) {\n   991\t    if (!json)\n   992\t        return;\n   993\t\n   994\t    switch (json_typeof(json)) {\n   995\t        case JSON_OBJECT:\n   996\t            json_delete_object(json_to_object(json));\n   997\t            break;\n   998\t        case JSON_ARRAY:\n   999\t            json_delete_array(json_to_array(json));\n  1000\t            break;\n  1001\t        case JSON_STRING:\n  1002\t            json_delete_string(json_to_string(json));\n  1003\t            break;\n  1004\t        case JSON_INTEGER:\n  1005\t            json_delete_integer(json_to_integer(json));\n  1006\t            break;\n  1007\t        case JSON_REAL:\n  1008\t            json_delete_real(json_to_real(json));\n  1009\t            break;\n  1010\t        default:\n  1011\t            return;\n  1012\t    }\n  1013\t\n  1014\t    /* json_delete is not called for true, false or null */\n  1015\t}\n  1016\t\n  1017\t/*** equality ***/\n  1018\t\n  1019\tint json_equal(const json_t *json1, const json_t *json2) {\n  1020\t    if (!json1 || !json2)\n  1021\t        return 0;\n  1022\t\n  1023\t    if (json_typeof(json1) != json_typeof(json2))\n  1024\t        return 0;\n  1025\t\n  1026\t    /* this covers true, false and null as they are singletons */\n  1027\t    if (json1 == json2)\n  1028\t        return 1;\n  1029\t\n  1030\t    switch (json_typeof(json1)) {\n  1031\t        case JSON_OBJECT:\n  1032\t            return json_object_equal(json1, json2);\n  1033\t        case JSON_ARRAY:\n  1034\t            return json_array_equal(json1, json2);\n  1035\t        case JSON_STRING:\n  1036\t            return json_string_equal(json1, json2);\n  1037\t        case JSON_INTEGER:\n  1038\t            return json_integer_equal(json1, json2);\n  1039\t        case JSON_REAL:\n  1040\t            return json_real_equal(json1, json2);\n  1041\t        default:\n  1042\t            return 0;\n  1043\t    }\n  1044\t}\n  1045\t\n  1046\t/*** copying ***/\n  1047\t\n  1048\tjson_t *json_copy(json_t *json) {\n  1049\t    if (!json)\n  1050\t        return NULL;\n  1051\t\n  1052\t    switch (json_typeof(json)) {\n  1053\t        case JSON_OBJECT:\n  1054\t            return json_object_copy(json);\n  1055\t        case JSON_ARRAY:\n  1056\t            return json_array_copy(json);\n  1057\t        case JSON_STRING:\n  1058\t            return json_string_copy(json);\n  1059\t        case JSON_INTEGER:\n  1060\t            return json_integer_copy(json);\n  1061\t        case JSON_REAL:\n  1062\t            return json_real_copy(json);\n  1063\t        case JSON_TRUE:\n  1064\t        case JSON_FALSE:\n  1065\t        case JSON_NULL:\n  1066\t            return json;\n  1067\t        default:\n  1068\t            return NULL;\n  1069\t    }\n  1070\t}\n  1071\t\n  1072\tjson_t *json_deep_copy(const json_t *json) {\n  1073\t    json_t *res;\n  1074\t    hashtable_t parents_set;\n  1075\t\n  1076\t    if (hashtable_init(&parents_set))\n  1077\t        return NULL;\n  1078\t    res = do_deep_copy(json, &parents_set);\n  1079\t    hashtable_close(&parents_set);\n  1080\t\n  1081\t    return res;\n  1082\t}\n  1083\t\n  1084\tjson_t *do_deep_copy(const json_t *json, hashtable_t *parents) {\n  1085\t    if (!json)\n  1086\t        return NULL;\n  1087\t\n  1088\t    switch (json_typeof(json)) {\n  1089\t        case JSON_OBJECT:\n  1090\t            return json_object_deep_copy(json, parents);\n  1091\t        case JSON_ARRAY:\n  1092\t            return json_array_deep_copy(json, parents);\n  1093\t            /* for the rest of the types, deep copying doesn't differ from\n  1094\t               shallow copying */\n  1095\t        case JSON_STRING:\n  1096\t            return json_string_copy(json);\n  1097\t        case JSON_INTEGER:\n  1098\t            return json_integer_copy(json);\n  1099\t        case JSON_REAL:\n  1100\t            return json_real_copy(json);\n  1101\t        case JSON_TRUE:\n  1102\t        case JSON_FALSE:\n  1103\t        case JSON_NULL:\n  1104\t            return (json_t *)json;\n  1105\t        default:\n  1106\t            return NULL;\n  1107\t    }\n  1108\t}\n","exit_code":0,"status":"completed"}}
