        *target = root;\n   801\t            }\n   802\t\n   803\t            return 0;\n   804\t\n   805\t        case 'n':\n   806\t            /* Never assign, just validate */\n   807\t            if (root && !json_is_null(root)) {\n   808\t                set_error(s, \"<validation>\", json_error_wrong_type,\n   809\t                          \"Expected null, got %s\", type_name(root));\n   810\t                return -1;\n   811\t            }\n   812\t            return 0;\n   813\t\n   814\t        default:\n   815\t            set_error(s, \"<format>\", json_error_invalid_format,\n   816\t                      \"Unexpected format character '%c'\", token(s));\n   817\t            return -1;\n   818\t    }\n   819\t}\n   820\t\n   821\tjson_t *json_vpack_ex(json_error_t *error, size_t flags, const char *fmt, va_list ap) {\n   822\t    scanner_t s;\n   823\t    va_list ap_copy;\n   824\t    json_t *value;\n   825\t\n   826\t    if (!fmt || !*fmt) {\n   827\t        jsonp_error_init(error, \"<format>\");\n   828\t        jsonp_error_set(error, -1, -1, 0, json_error_invalid_argument,\n   829\t                        \"NULL or empty format string\");\n   830\t        return NULL;\n   831\t    }\n   832\t    jsonp_error_init(error, NULL);\n   833\t\n   834\t    scanner_init(&s, error, flags, fmt);\n   835\t    next_token(&s);\n   836\t\n   837\t    va_copy(ap_copy, ap);\n   838\t    value = pack(&s, &ap_copy);\n   839\t    va_end(ap_copy);\n   840\t\n   841\t    /* This will cover all situations where s.has_error is true */\n   842\t    if (!value)\n   843\t        return NULL;\n   844\t\n   845\t    next_token(&s);\n   846\t    if (token(&s)) {\n   847\t        json_decref(value);\n   848\t        set_error(&s, \"<format>\", json_error_invalid_format,\n   849\t                  \"Garbage after format string\");\n   850\t        return NULL;\n   851\t    }\n   852\t\n   853\t    return value;\n   854\t}\n   855\t\n   856\tjson_t *json_pack_ex(json_error_t *error, size_t flags, const char *fmt, ...) {\n   857\t    json_t *value;\n   858\t    va_list ap;\n   859\t\n   860\t    va_start(ap, fmt);\n   861\t    value = json_vpack_ex(error, flags, fmt, ap);\n   862\t    va_end(ap);\n   863\t\n   864\t    return value;\n   865\t}\n   866\t\n   867\tjson_t *json_pack(const char *fmt, ...) {\n   868\t    json_t *value;\n   869\t    va_list ap;\n   870\t\n   871\t    va_start(ap, fmt);\n   872\t    value = json_vpack_ex(NULL, 0, fmt, ap);\n   873\t    va_end(ap);\n   874\t\n   875\t    return value;\n   876\t}\n   877\t\n   878\tint json_vunpack_ex(json_t *root, json_error_t *error, size_t flags, const char *fmt,\n   879\t                    va_list ap) {\n   880\t    scanner_t s;\n   881\t    va_list ap_copy;\n   882\t\n   883\t    if (!root) {\n   884\t        jsonp_error_init(error, \"<root>\");\n   885\t        jsonp_error_set(error, -1, -1, 0, json_error_null_value, \"NULL root value\");\n   886\t        return -1;\n   887\t    }\n   888\t\n   889\t    if (!fmt || !*fmt) {\n   890\t        jsonp_error_init(error, \"<format>\");\n   891\t        jsonp_error_set(error, -1, -1, 0, json_error_invalid_argument,\n   892\t                        \"NULL or empty format string\");\n   893\t        return -1;\n   894\t    }\n   895\t    jsonp_error_init(error, NULL);\n   896\t\n   897\t    scanner_init(&s, error, flags, fmt);\n   898\t    next_token(&s);\n   899\t\n   900\t    va_copy(ap_copy, ap);\n   901\t    if (unpack(&s, root, &ap_copy)) {\n   902\t        va_end(ap_copy);\n   903\t        return -1;\n   904\t    }\n   905\t    va_end(ap_copy);\n   906\t\n   907\t    next_token(&s);\n   908\t    if (token(&s)) {\n   909\t        set_error(&s, \"<format>\", json_error_invalid_format,\n   910\t                  \"Garbage after format string\");\n   911\t        return -1;\n   912\t    }\n   913\t\n   914\t    return 0;\n   915\t}\n   916\t\n   917\tint json_unpack_ex(json_t *root, json_error_t *error, size_t flags, const char *fmt,\n   