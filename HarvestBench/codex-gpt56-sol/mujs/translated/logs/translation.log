factoring\n            Disable running refactoring tool after translation\n\n        --disable-rustfmt\n            Disable running rustfmt after translation\n\n        --dump-typed-clang-ast\n            Prints out the parsed typed Clang AST\n\n        --dump-untyped-clang-ast\n            Prints out CBOR based Clang AST\n\n    -e, --emit-build-files\n            Emit Rust build files, i.e., Cargo.toml for a library (and one or more binaries if\n            -b/--binary is given). Implies --emit-modules\n\n        --emit-c-decl-map\n            Write map of C decls corresponding to each translated Rust item alongside the transpiled\n            output with the extension `.c_decls.json`\n\n        --emit-modules\n            Emit .rs files as modules instead of crates, excluding the crate preambles\n\n        --emit-no-std\n            Emit code using core rather than std\n\n    -f, --filter <FILTER>\n            Only transpile files matching filter\n\n        --fail-on-error\n            Fail to translate a module when a portion is not able to be translated\n\n        --fail-on-multiple\n            Fail when the control-flow graph generates branching constructs\n\n    -h, --help\n            Print help information\n\n        --ignore-c-loop-info\n            Don't keep/use information about C loops\n\n        --ignore-c-multiple-info\n            Don't keep/use information about C branches\n\n        --invalid-code <INVALID_CODE>\n            How to handle violated invariants or invalid code [default: compile_error] [possible\n            values: panic, compile_error]\n\n        --json-function-cfgs\n            Dumps into files JSON visualizations of the CFGs of every function\n\n        --log-level <LOG_LEVEL>\n            Logging level [default: WARN]\n\n        --no-incremental-relooper\n            Disable relooping function bodies incrementally\n\n        --no-simplify-structures\n            Do not run a pass to simplify structures\n\n    -o, --output-dir <DIR>\n            Path to output directory. Rust sources will be emitted in DIR/src/ and build files will\n            be emitted in DIR/\n\n        --overwrite-existing\n            Emit files even if it causes existing files to be overwritten\n\n        --prefix-function-names <PREFIX_FUNCTION_NAMES>\n            Adds a prefix to all function names. Generally only useful for testing\n\n        --preserve-unused-functions\n            Include static and inline functions in translation\n\n        --pretty-typed-clang-ast\n            Pretty-prints out the parsed typed Clang AST\n\n    -r, --reorganize-definitions\n            Output file in such a way that the refactoring tool can deduplicate code\n\n        --reduce-type-annotations\n            Reduces the number of explicit type annotations where it should be safe to do so\n\n        --translate-const-macros <TRANSLATE_CONST_MACROS>\n            Enable translation of some C macros into consts [default: conservative] [possible\n            values: none, conservative, experimental]\n\n        --translate-fn-macros <TRANSLATE_FN_MACROS>\n            Enable translation of some C function macros [default: conservative] [possible values:\n            none, conservative, experimental]\n\n    -v, --verbose\n            Verbose mode\n\n    -V, --version\n            Print version information\n\n    -W <WARN>\n            Enable the specified warning (all enables all warnings)\n\n    -x, --cross-checks\n            \n\n    -X, --cross-check-config <CROSS_CHECK_CONFIG>...\n            \n","exit_code":0,"status":"completed"}}
