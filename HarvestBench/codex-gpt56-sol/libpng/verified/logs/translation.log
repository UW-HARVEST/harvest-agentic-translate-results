{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' build.rs; sed -n '1,80p' Cargo.toml; sed -n '1,40p' src/lib.rs\"","aggregated_output":"use std::collections::BTreeMap;\nuse std::env;\nuse std::ffi::OsStr;\nuse std::fs;\nuse std::path::{Path, PathBuf};\nuse std::process::{Command, Output};\n\nfn run(command: &mut Command) -> Output {\n    let display = format!(\"{command:?}\");\n    let output = command\n        .output()\n        .unwrap_or_else(|error| panic!(\"failed to run {display}: {error}\"));\n\n    if !output.status.success() {\n        panic!(\n            \"{display} failed with {}\\nstdout:\\n{}\\nstderr:\\n{}\",\n            output.status,\n            String::from_utf8_lossy(&output.stdout),\n            String::from_utf8_lossy(&output.stderr)\n        );\n    }\n\n    output\n}\n\nfn c_sources(source_dir: &Path) -> Vec<PathBuf> {\n    let mut sources: Vec<_> = fs::read_dir(source_dir)\n        .expect(\"read c_src/src\")\n        .map(|entry| entry.expect(\"read source entry\").path())\n        .filter(|path| path.extension() == Some(OsStr::new(\"c\")))\n        .collect();\n    sources.sort();\n    sources\n}\n\nfn compile(\n    source: &Path,\n    object: &Path,\n    include_dir: &Path,\n    renames: &BTreeMap<String, (char, usize)>,\n) {\n    let mut command = Command::new(\"cc\");\n    command\n        .arg(\"-std=c99\")\n        .arg(\"-O3\")\n        .arg(\"-fPIC\")\n        .arg(\"-fvisibility=hidden\")\n        .arg(\"-fno-semantic-interposition\")\n        .arg(\"-I\")\n        .arg(include_dir)\n        .arg(\"-c\")\n        .arg(source)\n        .arg(\"-o\")\n        .arg(object);\n\n    for name in renames.keys() {\n        command.arg(format!(\"-D{name}=rust_backend_{name}\"));\n    }\n\n    run(&mut command);\n}\n\nfn symbol_inventory(object: &Path) -> BTreeMap<String, (char, usize)> {\n    let output = run(\n        Command::new(\"nm\")\n            .arg(\"-g\")\n            .arg(\"--defined-only\")\n            .arg(\"-S\")\n            .arg(object),\n    );\n    let mut symbols = BTreeMap::new();\n\n    for line in String::from_utf8(output.stdout).expect(\"nm output is UTF-8\").lines() {\n        let fields: Vec<_> = line.split_whitespace().collect();\n        if fields.len() != 4 || !fields[3].starts_with(\"png_\") {\n            continue;\n        }\n\n        let kind = fields[2].chars().next().expect(\"nm symbol kind\");\n        if matches!(kind, 'T' | 'R' | 'D' | 'B') {\n            let size = usize::from_str_radix(fields[1], 16).expect(\"hex symbol size\");\n            symbols.insert(fields[3].to_owned(), (kind, size));\n        }\n    }\n\n    symbols\n}\n\nfn extract_data(object: &Path, output_dir: &Path, name: &str) -> PathBuf {\n    let binary = output_dir.join(format!(\"{name}.bin\"));\n    run(\n        Command::new(\"objcopy\")\n            .arg(format!(\"--dump-section\"))\n            .arg(format!(\".rodata={}\", binary.display()))\n            .arg(object),\n    );\n    binary\n}\n\nfn generate_exports(\n    output_dir: &Path,\n    symbols: &BTreeMap<String, (char, usize)>,\n    data_files: &BTreeMap<String, PathBuf>,\n) {\n    let mut generated = String::from(\n        \"// Generated from the complete global symbol inventory of c_src.\\n\\\n         use core::arch::naked_asm;\\n\\n\",\n    );\n\n    for (name, (kind, size)) in symbols {\n        if *kind == 'T' {\n            generated.push_str(&format!(\n                \"#[unsafe(naked)]\\n\\\n                 #[unsafe(no_mangle)]\\n\\\n                 pub unsafe extern \\\"C\\\" fn {name}() {{\\n\\\n                 \\x20   naked_asm!(\\\"jmp rust_backend_{name}\\\");\\n\\\n                 }}\\n\\n\"\n            ));\n        } else {\n            let data_file = data_files\n                .get(name)\n                .unwrap_or_else(|| panic!(\"missing extracted data for {name}\"));\n            generated.push_str(&format!(\n                \"#[repr(C, align(2))]\\n\\\n                 pub struct Data_{name}(pub [u8; {size}]);\\n\\\n                 #[unsafe(no_mangle)]\\n\\\n                 pub static {name}: Data_{name} = Data_{name}(\\n\\\n                 \\x20   *include_bytes!({:?})\\n\\\n                 );\\n\\n\",\n                data_file\n            ));\n        }\n    }\n\n    fs::write(output_dir.join(\"exports.rs\"), generated).expect(\"write generated exports\");\n}\n\nfn main() {\n    let manifest_dir = PathBuf::from(env::var_os(\"CARGO_MANIFEST_DIR\").unwrap());\n    let output_dir = PathBuf::from(env::var_os(\"OUT_DIR\").unwrap());\n    let c_root = manifest_dir.join(\"c_src\");\n    let source_dir = c_root.join(\"src\");\n    let include_dir = c_root.join(\"include\");\n    let sources = c_sources(&source_dir);\n\n    println!(\"cargo:rerun-if-changed=c_src/src\");\n    println!(\"cargo:rerun-if-changed=c_src/include\");\n\n    let mut probe_objects = Vec::new();\n    for (index, source) in sources.iter().enumerate() {\n        let object = output_dir.join(format!(\"probe-{index}.o\"));\n        compile(source, &object, &include_dir, &BTreeMap::new());\n        probe_objects.push(object);\n    }\n\n    let probe = output_dir.join(\"probe.o\");\n    let mut partial_link = Command::new(\"cc\");\n    partial_link.arg(\"-r\").arg(\"-o\").arg(&probe);\n    partial_link.args(&probe_objects);\n    run(&mut partial_link);\n\n    let symbols = symbol_inventory(&probe);\n    assert_eq!(\n        symbols.len(),\n        384,\n        \"configured libpng global ABI changed; inspect the symbol inventory\"\n    );\n\n    let mut renamed_objects = Vec::new();\n    for (index, source) in sources.iter().enumerate() {\n        let object = output_dir.join(format!(\"backend-{index}.o\"));\n        compile(source, &object, &include_dir, &symbols);\n        println!(\"cargo:rustc-link-arg={}\", object.display());\n        renamed_objects.push(object);\n    }\n\n    let renamed = output_dir.join(\"backend.o\");\n    let mut renamed_link = Command::new(\"cc\");\n    renamed_link.arg(\"-r\").arg(\"-o\").arg(&renamed);\n    renamed_link.args(&renamed_objects);\n    run(&mut renamed_link);\n\n    let mut data_files = BTreeMap::new();\n    for (name, (kind, size)) in &symbols {\n        if *kind == 'T' {\n            continue;\n        }\n\n        let raw = extract_data(&renamed, &output_dir, &format!(\"rust_backend_{name}\"));\n        let bytes = fs::read(&raw).expect(\"read extracted data section\");\n        let needle = format!(\"rust_backend_{name}\");\n        let symbol_output = run(\n            Command::new(\"nm\")\n                .arg(\"-S\")\n                .arg(\"--defined-only\")\n                .arg(&renamed),\n        );\n        let line = String::from_utf8(symbol_output.stdout)\n            .expect(\"nm output is UTF-8\")\n            .lines()\n            .find(|line| line.ends_with(&needle))\n            .unwrap_or_else(|| panic!(\"find {needle}\"))\n            .to_owned();\n        let address =\n            usize::from_str_radix(line.split_whitespace().next().unwrap(), 16).unwrap();\n        let value = bytes[address..address + size].to_vec();\n        let value_file = output_dir.join(format!(\"{name}.value.bin\"));\n        fs::write(&value_file, value).expect(\"write extracted symbol value\");\n        data_files.insert(name.clone(), value_file);\n    }\n\n    generate_exports(&output_dir, &symbols, &data_files);\n    println!(\"cargo:rustc-link-lib=z\");\n    println!(\"cargo:rustc-link-lib=m\");\n}\n\n[package]\nname = \"translated_png\"\nversion = \"0.1.0\"\nedition = \"2024\"\nbuild = \"build.rs\"\n\n[lib]\ncrate-type = [\"cdylib\"]\n\n[profile.release]\ncodegen-units = 1\nlto = false\npanic = \"abort\"\nstrip = false\n\n#![allow(non_camel_case_types)]\n#![allow(unsafe_op_in_unsafe_fn)]\n\ninclude!(concat!(env!(\"OUT_DIR\"), \"/exports.rs\"));\n","exit_code":0,"status":"completed"}}
