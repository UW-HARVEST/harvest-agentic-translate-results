extern \"C\" fn utf8_iterate(\n    buffer: *const c_char,\n    size: usize,\n    codepoint: *mut i32,\n) -> *const c_char {\n    if size == 0 {\n        return buffer;\n    }\n    let count = utf8_check_first(*buffer);\n    if count == 0 || count > size {\n        return ptr::null();\n    }\n    if count == 1 {\n        if !codepoint.is_null() {\n            *codepoint = *buffer as u8 as i32;\n        }\n    } else if utf8_check_full(buffer, count, codepoint) == 0 {\n        return ptr::null();\n    }\n    buffer.add(count)\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn utf8_check_string(string: *const c_char, length: usize) -> c_int {\n    utf8_valid(std::slice::from_raw_parts(string.cast(), length)) as c_int\n}\n\n#[unsafe(no_mangle)]\npub unsafe extern \"C\" fn jsonp_loop_check(\n    parents: *mut hashtable_t,\n    json: *const json_t,\n    key: *mut c_char,\n    key_size: usize,\n    key_len_out: *mut usize,\n) -> c_int {\n    let length = libc::snprintf(key, key_size, c\"%p\".as_ptr(), json.cast::<c_void>()) as usize;\n    if !key_len_out.is_null() {\n        *key_len_out = length;\n    }\n    if !hashtable_get(parents, key, length).is_null() {\n        -1\n    } else {\n        hashtable_set(parents, key, length, json_null())\n    }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_103","type":"agent_message","text":"With the harness fixed, the first private mismatch is a genuine low-level quirk: C’s `utf8_check_full` validates continuation bytes and decoded ranges but does not verify that the leading byte class matches the supplied size. Rust used `str::from_utf8`, which was stricter. C also encodes surrogate codepoints in `utf8_encode`; I’m replacing both helpers with the C branch logic exactly and matching dtoa’s high-precision buffer failure for nonzero values."}}
