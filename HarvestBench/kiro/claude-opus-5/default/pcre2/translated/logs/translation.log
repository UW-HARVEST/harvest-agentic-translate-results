pub(crate) unsafe fn read_number(
    ptrptr: *mut PCRE2_SPTR,
    ptrend: PCRE2_SPTR,
    allow_sign: i32,
    mut max_value: u32,
    max_error: u32,
    intptr: *mut c_int,
