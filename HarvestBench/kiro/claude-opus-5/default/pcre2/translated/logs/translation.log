            if n == 0 {
                *errorcodeptr = ERR26; /* +0 and -0 are not allowed */
                *intptr = n as c_int;
                *ptrptr = ptr;
                return yield_;
            }

            if sign > 0 {
                n += allow_sign as u32;
            } else if n > allow_sign as u32 {
                *errorcodeptr = ERR15; /* Non-existent subpattern */
                *intptr = n as c_int;
                *ptrptr = ptr;
                return yield_;
            } else {
                n = allow_sign as u32 + 1 - n;
            }
        }

        yield_ = TRUE;

        *intptr = n as c_int;
        *ptrptr = ptr;
        yield_
    }
}
