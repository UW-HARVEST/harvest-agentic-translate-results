import re
src = open('src/match_core.rs').read()

def find_args(s, i):
    """i points at '(' ; return (args_list, index_after_matching_')')"""
    assert s[i] == '('
    depth = 0
    j = i
    parts = []
    cur = []
    while j < len(s):
        c = s[j]
        if c in '([{':
            depth += 1
            if depth == 1:
                j += 1
                continue
        elif c in ')]}':
            depth -= 1
            if depth == 0:
                parts.append(''.join(cur))
                return parts, j + 1
        elif c == ',' and depth == 1:
            parts.append(''.join(cur))
            cur = []
            j += 1
            continue
        cur.append(c)
        j += 1
    raise RuntimeError('unbalanced')

def replace_macro(src, name, build):
    out = []
    pos = 0
    count = 0
    pat = re.compile(r'\b' + re.escape(name) + r'!\s*')
    while True:
        m = pat.search(src, pos)
        if not m:
            out.append(src[pos:])
            break
        i = m.end()
        if i >= len(src) or src[i] != '(':
            out.append(src[pos:m.end()])
            pos = m.end()
            continue
        args, after = find_args(src, i)
        # swallow a trailing ';'
        j = after
        while j < len(src) and src[j] in ' \t':
            j += 1
        if j < len(src) and src[j] == ';':
            j += 1
        out.append(src[pos:m.start()])
        out.append(build([a.strip() for a in args]))
        pos = j
        count += 1
    return ''.join(out), count

src, n1 = replace_macro(src, 'MAINLOOP',
    lambda a: '{ label = Lbl::MainLoop; continue \'sm; }')
src, n2 = replace_macro(src, 'RRETURN',
    lambda a: '{ rrc = %s; label = Lbl::ReturnSwitch; continue \'sm; }' % a[0])
src, n3 = replace_macro(src, 'RMATCH',
    lambda a: '{ start_ecode = %s; *Freturn_id(F) = %s; label = Lbl::MatchRecurse; continue \'sm; }'
              % (a[0], a[1]))

# Drop the now-unused macro definitions for the three inlined macros.
for name in ('RRETURN', 'RMATCH', 'MAINLOOP'):
    m = re.search(r'[ \t]*macro_rules! ' + name + r' \{', src)
    if not m:
        print('WARN: definition of', name, 'not found')
        continue
    i = m.start()
    # find matching closing brace of the macro_rules block
    b = src.index('{', m.end() - 1)
    depth = 0
    j = b
    while True:
        if src[j] == '{':
            depth += 1
        elif src[j] == '}':
            depth -= 1
            if depth == 0:
                break
        j += 1
    # swallow trailing newline
    k = j + 1
    while k < len(src) and src[k] == '\n':
        k += 1
        break
    src = src[:i] + src[k:]

open('src/match_core.rs', 'w').write(src)
print('inlined: MAINLOOP=%d RRETURN=%d RMATCH=%d' % (n1, n2, n3))
