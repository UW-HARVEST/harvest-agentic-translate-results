import re,os
names=set()
# opcode enum: lines 1638..1908 of internal.h
txt=open('pcre2_internal.h').read()
def enum_names(text):
    return re.findall(r'\b(OP_[A-Za-z0-9_]+|ESC_[A-Za-z0-9_]+|ucp_[A-Za-z0-9_]+|PCRE2_MATCHEDBY_[A-Z_]+)\b', text)
lines=txt.split('\n')
op=enum_names('\n'.join(lines[1637:1909]))
esc=enum_names('\n'.join(lines[1606:1637]))
mb=enum_names('\n'.join(lines[531:536]))
ucp=enum_names(open('pcre2_ucp.h').read())
def dedup(l):
    seen=[];s=set()
    for x in l:
        if x not in s: s.add(x); seen.append(x)
    return seen
print("OPCOUNT",len(dedup(op)))
print("ESC",len(dedup(esc)))
print("UCP",len(dedup(ucp)))
print("MB",dedup(mb))
open('/tmp/pcre2gen/names_op.txt','w').write('\n'.join(dedup(op)))
open('/tmp/pcre2gen/names_esc.txt','w').write('\n'.join(dedup(esc)))
