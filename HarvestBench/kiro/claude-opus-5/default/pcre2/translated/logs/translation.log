static void t(const char*pat,uint32_t o,uint32_t x,const unsigned char*s,size_t n,PCRE2_SIZE so,uint32_t m){
  int ec; PCRE2_SIZE eo;
  pcre2_compile_context*cc=pcre2_compile_context_create(NULL);
  pcre2_set_compile_extra_options(cc,x);
  pcre2_code*re=pcre2_compile((PCRE2_SPTR)pat,PCRE2_ZERO_TERMINATED,o,&ec,&eo,cc);
  if(!re){printf("<%s> FAIL %d\n",pat,ec);return;}
