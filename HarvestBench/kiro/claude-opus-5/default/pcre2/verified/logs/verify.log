101:/*************************************************
102:*          Create and initialize contexts        *
103:*************************************************/
104:
105:/* Initializing for compile and match contexts is done in separate, private
106:functions so that these can be called from functions such as pcre2_compile()
107:when an external context is not supplied. The initializing functions have an
108:option to set up default memory management. */
109:
110:PCRE2_EXP_DEFN pcre2_general_context * PCRE2_CALL_CONVENTION
111:pcre2_general_context_create(void *(*private_malloc)(size_t, void *),
112:  void (*private_free)(void *, void *), void *memory_data)
113:{
114:pcre2_general_context *gcontext;
115:if (private_malloc == NULL) private_malloc = default_malloc;
116:if (private_free == NULL) private_free = default_free;
117:gcontext = private_malloc(sizeof(pcre2_real_general_context), memory_data);
118:if (gcontext == NULL) return NULL;
119:gcontext->memctl.malloc = private_malloc;
120:gcontext->memctl.free = private_free;
121:gcontext->memctl.memory_data = memory_data;
122:return gcontext;
123:}
