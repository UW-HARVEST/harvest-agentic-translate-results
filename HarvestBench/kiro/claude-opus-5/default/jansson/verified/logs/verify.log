/// `multadd(b, m, a);` where dtoa.c discards the result: assign it back, which
/// is what the C code observes whenever `multadd` does not have to grow `b`
/// (growing would leave dtoa.c with a dangling pointer).
pub fn multadd_inplace(b: &mut Bigint, m: i32, a: i32) {
    let taken = core::mem::replace(
        b,
        Bigint {
            k: 0,
            maxwds: 0,
            sign: 0,
            wds: 0,
            x: Vec::new(),
        },
    );
    *b = multadd(taken, m, a);
}
