import re
src = open('../c_src/src/dtoa.c').read()

# pten
m = re.search(r'static BF96 pten\[667\] = \{(.*?)\n\t\};', src, re.S)
body = m.group(1)
entries = re.findall(r'\{\s*(0x[0-9a-fA-F]+),\s*(0x[0-9a-fA-F]+),\s*(0x[0-9a-fA-F]+),\s*(-?\d+)\s*\}', body)
assert len(entries) == 667, len(entries)
out = []
out.append('// Auto-extracted tables from c_src/src/dtoa.c (David M. Gay\'s dtoa).\n')
out.append('#[derive(Copy, Clone)]\npub struct BF96 {\n    pub b0: u32,\n    pub b1: u32,\n    pub b2: u32,\n    pub e: i32,\n}\n')
out.append('pub static PTEN: [BF96; 667] = [')
for a,b,c,e in entries:
    out.append('    BF96 { b0: %s, b1: %s, b2: %s, e: %s },' % (a,b,c,e))
out.append('];\n')

# Lhint
m = re.search(r'static short int Lhint\[2098\] = \{(.*?)\};', src, re.S)
nums = re.findall(r'-?\d+', m.group(1))
assert len(nums) == 2098, len(nums)
out.append('pub static LHINT: [i16; 2098] = [')
for i in range(0, len(nums), 16):
    out.append('    ' + ' '.join(n + ',' for n in nums[i:i+16]))
out.append('];\n')

# pfive
m = re.search(r'static ULLong pfive\[27\] = \{(.*?)\};', src, re.S)
nums = re.findall(r'(\d+)ll', m.group(1))
assert len(nums) == 27, len(nums)
out.append('pub static PFIVE: [u64; 27] = [')
for n in nums:
    out.append('    %s,' % n)
out.append('];\n')

# pfivebits
m = re.search(r'static int pfivebits\[25\] = \{(.*?)\};', src, re.S)
nums = re.findall(r'\d+', m.group(1))
assert len(nums) == 25, len(nums)
out.append('pub static PFIVEBITS: [i32; 25] = [' + ' '.join(n+',' for n in nums) + '];\n')

open('src/dtoa_tables.rs','w').write('\n'.join(out))
print("ok")
