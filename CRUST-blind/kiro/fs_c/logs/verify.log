#include <stdio.h>
#include <string.h>
#include "fs.h"

int main() {
    char *alpha = "abcdefghijklmnopqrstuvwxyz\n";
    
    // fs_write returns strlen(buffer) via fwrite
    int r = fs_write("./tmp/alpha", alpha);
    printf("fs_write returned: %d (strlen=%zu)\n", r, strlen(alpha));
    
    // fs_nwrite returns fwrite result
    r = fs_nwrite("./tmp/alpha", alpha, 9);
    printf("fs_nwrite(9) returned: %d\n", r);
    
    // fs_size
    fs_write("./tmp/alpha", alpha);
    size_t sz = fs_size("./tmp/alpha");
    printf("fs_size: %zu\n", sz);
    
    // fs_exists returns 0 on success, -1 on failure
    printf("fs_exists(existing): %d\n", fs_exists("./tmp/file"));
    printf("fs_exists(nonexistent): %d\n", fs_exists("./tmp/nonexistent"));
    
    // fs_read content
    char *buf = fs_read("./tmp/file");
    printf("fs_read(file) len=%zu content='%s'\n", strlen(buf), buf);
    
    // fs_read nonexistent
    char *nbuf = fs_read("./tmp/nonexistent");
    printf("fs_read(nonexistent): %p\n", nbuf);
    
    // fs_nread
    fs_write("./tmp/alpha", alpha);
    char *nr = fs_nread("./tmp/alpha", 9);
    printf("fs_nread(9): '%s'\n", nr);
    
    return 0;
}
EOF
