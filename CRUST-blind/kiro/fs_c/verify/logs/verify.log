#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "fs.h"

int main() {
    // fs_exists returns
    printf("fs_exists('./tmp/file') = %d\n", fs_exists("./tmp/file"));
    printf("fs_exists('./tmp/nonexistent') = %d\n", fs_exists("./tmp/nonexistent"));

    // fs_size
    printf("fs_size('./tmp/file') = %zu\n", fs_size("./tmp/file"));

    // fs_write returns
    char *alpha = "abcdefghijklmnopqrstuvwxyz\n";
    int wr = fs_write("./tmp/alpha", alpha);
    printf("fs_write alpha = %d\n", wr);

    // fs_nwrite returns
    int nwr = fs_nwrite("./tmp/alpha", alpha, 9);
    printf("fs_nwrite alpha 9 = %d\n", nwr);

    // fs_read
    char *buf = fs_read("./tmp/alpha");
    printf("fs_read after nwrite = '%s' len=%zu\n", buf, strlen(buf));
    free(buf);

    // fs_nread
    fs_write("./tmp/alpha", alpha);
    buf = fs_nread("./tmp/alpha", 9);
    printf("fs_nread 9 = '%s'\n", buf);
    free(buf);

    // fs_fnwrite
    FILE *fd = fs_open("./tmp/alpha", FS_OPEN_WRITE);
    int fnw = fs_fnwrite(fd, alpha, 5);
    printf("fs_fnwrite 5 = %d\n", fnw);
    fs_close(fd);
    buf = fs_read("./tmp/alpha");
    printf("after fnwrite 5 = '%s'\n", buf);
    free(buf);

    // fs_fwrite
    fs_write("./tmp/alpha", alpha);
    fd = fs_open("./tmp/alpha", FS_OPEN_WRITE);
    int fw = fs_fwrite(fd, alpha);
    printf("fs_fwrite = %d\n", fw);
    fs_close(fd);

    // fs_truncate
    fs_write("./tmp/alpha", alpha);
    int tr = fs_truncate("./tmp/alpha", 9);
    printf("fs_truncate = %d\n", tr);
    buf = fs_read("./tmp/alpha");
    printf("after truncate = '%s'\n", buf);
    free(buf);

    // fs_open nonexistent
    fd = fs_open("/root/foo", FS_OPEN_WRITE);
    printf("fs_open nonexistent = %p\n", (void*)fd);

    // fs_stat nonexistent
    fs_stats *s = fs_stat("./tmp/nonexistent");
    printf("fs_stat nonexistent = %p\n", (void*)s);

    // fs_fstat NULL
    s = fs_fstat(NULL);
    printf("fs_fstat NULL = %p\n", (void*)s);

    return 0;
}
EOF
