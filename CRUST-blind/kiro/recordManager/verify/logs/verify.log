void testSerializeFloat() {
    // Test float serialization format
    printf("FLOAT_5.3=%s\n", serializeValue(stringToValue("f5.3")));
    printf("FLOAT_0.0=%s\n", serializeValue(stringToValue("f0.0")));
    printf("FLOAT_1.5=%s\n", serializeValue(stringToValue("f1.5")));
    printf("FLOAT_-2.7=%s\n", serializeValue(stringToValue("f-2.7")));
}

void testBoolAndDt() {
    // Check what boolAnd sets for result->dt
    Value *result = (Value *) malloc(sizeof(Value));
    result->dt = DT_INT;
    result->v.intV = -1;
    boolAnd(stringToValue("bt"), stringToValue("bt"), result);
    printf("BOOLAND_DT=%d\n", result->dt);
    printf("BOOLAND_BOOLV=%d\n", result->v.boolV);
    
    // boolOr
    result->dt = DT_INT;
    result->v.intV = -1;
    boolOr(stringToValue("bt"), stringToValue("bf"), result);
    printf("BOOLOR_DT=%d\n", result->dt);
    printf("BOOLOR_BOOLV=%d\n", result->v.boolV);
    
    free(result);
}

void testMakeValue() {
    // Test make_value in Rust (tables.rs)
    Value *v = stringToValue("i10");
    printf("MV_i10_dt=%d v=%d\n", v->dt, v->v.intV);
    
    v = stringToValue("f3.14");
    printf("MV_f3.14_dt=%d v=%f\n", v->dt, v->v.floatV);
    
    v = stringToValue("stest string");
    printf("MV_stest_dt=%d v=%s\n", v->dt, v->v.stringV);
    
    v = stringToValue("bt");
    printf("MV_bt_dt=%d v=%d\n", v->dt, v->v.boolV);
    
    v = stringToValue("bf");
    printf("MV_bf_dt=%d v=%d\n", v->dt, v->v.boolV);
}

void testRecordSerialize() {
    char *names[] = { "a", "b", "c" };
    DataType dt[] = { DT_INT, DT_STRING, DT_INT };
    int sizes[] = { 0, 4, 0 };
    int keys[] = {0};
    char **cpNames = (char **) malloc(sizeof(char*) * 3);
    DataType *cpDt = (DataType *) malloc(sizeof(DataType) * 3);
    int *cpSizes = (int *) malloc(sizeof(int) * 3);
    int *cpKeys = (int *) malloc(sizeof(int));
    for(int i = 0; i < 3; i++) {
        cpNames[i] = (char *) malloc(2);
        strcpy(cpNames[i], names[i]);
    }
    memcpy(cpDt, dt, sizeof(DataType) * 3);
    memcpy(cpSizes, sizes, sizeof(int) * 3);
    memcpy(cpKeys, keys, sizeof(int));
    Schema *schema = createSchema(3, cpNames, cpDt, cpSizes, 1, cpKeys);
    
    Record *r;
    createRecord(&r, schema);
    Value *val;
    
    MAKE_VALUE(val, DT_INT, 42);
    setAttr(r, schema, 0, val);
    freeVal(val);
    
    MAKE_STRING_VALUE(val, "test");
    setAttr(r, schema, 1, val);
    freeVal(val);
    
    MAKE_VALUE(val, DT_INT, 99);
    setAttr(r, schema, 2, val);
    freeVal(val);
    
    r->id.page = 5;
    r->id.slot = 3;
    
    char *ser = serializeRecord(r, schema);
    printf("REC_42_test_99=%s\n", ser);
    free(ser);
    
    for (int i = 0; i < 3; i++) {
        char *sa = serializeAttr(r, schema, i);
        printf("ATTR42_%d=%s\n", i, sa);
        free(sa);
    }
    
    freeRecord(r);
    freeSchema(schema);
}

void testMakeStringValue() {
    // Test make_string_value (tables.rs)
