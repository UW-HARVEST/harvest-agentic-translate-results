// Test value serialization
void testValueSer() {
    printf("SER_i10=%s\n", serializeValue(stringToValue("i10")));
    printf("SER_f5.3=%s\n", serializeValue(stringToValue("f5.3")));
    printf("SER_sHello=%s\n", serializeValue(stringToValue("sHello World")));
    printf("SER_bt=%s\n", serializeValue(stringToValue("bt")));
    printf("SER_btrue=%s\n", serializeValue(stringToValue("btrue")));
    printf("SER_bf=%s\n", serializeValue(stringToValue("bf")));
    printf("SER_i0=%s\n", serializeValue(stringToValue("i0")));
    printf("SER_i-1=%s\n", serializeValue(stringToValue("i-1")));
    printf("SER_f0.0=%s\n", serializeValue(stringToValue("f0.0")));
}

// Test operators
void testOps() {
    Value *result = (Value *) malloc(sizeof(Value));
    
    // valueEquals
    valueEquals(stringToValue("i10"), stringToValue("i10"), result);
    printf("EQ_i10_i10=%d\n", result->v.boolV);
    
    valueEquals(stringToValue("i9"), stringToValue("i10"), result);
    printf("EQ_i9_i10=%d\n", result->v.boolV);
    
    valueEquals(stringToValue("sHello World"), stringToValue("sHello World"), result);
    printf("EQ_sHW_sHW=%d\n", result->v.boolV);
    
    valueEquals(stringToValue("sHello Worl"), stringToValue("sHello World"), result);
    printf("EQ_sHWl_sHWd=%d\n", result->v.boolV);
    
    // valueSmaller
    valueSmaller(stringToValue("i3"), stringToValue("i10"), result);
    printf("SM_i3_i10=%d\n", result->v.boolV);
    
    valueSmaller(stringToValue("i10"), stringToValue("i3"), result);
    printf("SM_i10_i3=%d\n", result->v.boolV);
    
    valueSmaller(stringToValue("f5.0"), stringToValue("f6.5"), result);
    printf("SM_f5_f6=%d\n", result->v.boolV);
    
    // boolAnd
    boolAnd(stringToValue("bt"), stringToValue("bt"), result);
    printf("AND_tt=%d\n", result->v.boolV);
    
    boolAnd(stringToValue("bt"), stringToValue("bf"), result);
    printf("AND_tf=%d\n", result->v.boolV);
    
    // boolOr
    boolOr(stringToValue("bt"), stringToValue("bf"), result);
    printf("OR_tf=%d\n", result->v.boolV);
    
    boolOr(stringToValue("bf"), stringToValue("bf"), result);
    printf("OR_ff=%d\n", result->v.boolV);
    
    // boolNot
    boolNot(stringToValue("bf"), result);
    printf("NOT_f=%d\n", result->v.boolV);
    
    boolNot(stringToValue("bt"), result);
    printf("NOT_t=%d\n", result->v.boolV);
    
    // Error cases
    RC rc = valueEquals(stringToValue("i10"), stringToValue("sHello"), result);
    printf("EQ_DIFF_TYPE_RC=%d\n", rc);
    
    rc = boolNot(stringToValue("i10"), result);
    printf("NOT_INT_RC=%d\n", rc);
    
    rc = boolAnd(stringToValue("i10"), stringToValue("bt"), result);
    printf("AND_INT_RC=%d\n", rc);
    
    free(result);
}

