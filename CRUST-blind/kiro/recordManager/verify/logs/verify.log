    free(msg);
    
    RC_message = "test error";
    msg = errorMessage(200);
    printf("ERR_MSG_SET=%s", msg);
    free(msg);
}

int main() {
    testSerializeFloat();
    testBoolAndDt();
    testMakeValue();
    testRecordSerialize();
    testMakeStringValue();
    testErrorMessages();
    return 0;
}
