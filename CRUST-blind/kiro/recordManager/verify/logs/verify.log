    printf("RECORD_SIZE=%d\n", getRecordSize(schema));
    printf("SIZEOF_BOOL=%zu\n", sizeof(bool));
    printf("SIZEOF_INT=%zu\n", sizeof(int));
    printf("SIZEOF_FLOAT=%zu\n", sizeof(float));
    printf("SIZEOF_PAGEHEADER=%zu\n", sizeof(PageHeader));
    
