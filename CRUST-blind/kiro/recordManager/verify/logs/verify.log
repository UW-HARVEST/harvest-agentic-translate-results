// Test record creation and attr get/set
void testRecordAttrs() {
    char *names[] = { "a", "b", "c" };
    DataType dt[] = { DT_INT, DT_STRING, DT_INT };
    int sizes[] = { 0, 4, 0 };
    int keys[] = {0};
    char **cpNames = (char **) malloc(sizeof(char*) * 3);
    DataType *cpDt = (DataType *) malloc(sizeof(DataType) * 3);
    int *cpSizes = (int *) malloc(sizeof(int) * 3);
    int *cpKeys = (int *) malloc(sizeof(int));
    for(int i = 0; i < 3; i++) {
        cpNames[i] = (char *) malloc(2);
        strcpy(cpNames[i], names[i]);
    }
    memcpy(cpDt, dt, sizeof(DataType) * 3);
    memcpy(cpSizes, sizes, sizeof(int) * 3);
    memcpy(cpKeys, keys, sizeof(int));
    Schema *schema = createSchema(3, cpNames, cpDt, cpSizes, 1, cpKeys);
    
    Record *r;
    createRecord(&r, schema);
    
    Value *val;
    MAKE_VALUE(val, DT_INT, 1);
    setAttr(r, schema, 0, val);
    freeVal(val);
    
    MAKE_STRING_VALUE(val, "aaaa");
    setAttr(r, schema, 1, val);
    freeVal(val);
    
    MAKE_VALUE(val, DT_INT, 3);
    setAttr(r, schema, 2, val);
    freeVal(val);
    
    Value *out;
    getAttr(r, schema, 0, &out);
    printf("ATTR0=%s\n", serializeValue(out));
    freeVal(out);
    
    getAttr(r, schema, 1, &out);
    printf("ATTR1=%s\n", serializeValue(out));
    freeVal(out);
    
    getAttr(r, schema, 2, &out);
    printf("ATTR2=%s\n", serializeValue(out));
    freeVal(out);
    
    // Serialize record
    r->id.page = 0;
    r->id.slot = 0;
    char *ser = serializeRecord(r, schema);
    printf("REC_SER=%s\n", ser);
    free(ser);
    
    // Serialize attrs
    for (int i = 0; i < 3; i++) {
        char *sa = serializeAttr(r, schema, i);
        printf("ATTR_SER_%d=%s\n", i, sa);
        free(sa);
    }
    
    // Modify attr
    setAttr(r, schema, 2, stringToValue("i4"));
    getAttr(r, schema, 2, &out);
    printf("ATTR2_MOD=%s\n", serializeValue(out));
    freeVal(out);
    
    freeRecord(r);
    freeSchema(schema);
}

// Test evalExpr with constants
void testEvalExpr() {
    Expr *l, *r;
    Value *res;
    
    MAKE_CONS(l, stringToValue("i10"));
    evalExpr(NULL, NULL, l, &res);
    printf("EVAL_CONST_i10=%s\n", serializeValue(res));
    
    MAKE_CONS(r, stringToValue("i20"));
    evalExpr(NULL, NULL, r, &res);
    printf("EVAL_CONST_i20=%s\n", serializeValue(res));
    
    Expr *op;
    MAKE_BINOP_EXPR(op, l, r, OP_COMP_SMALLER);
    evalExpr(NULL, NULL, op, &res);
    printf("EVAL_10_LT_20=%s\n", serializeValue(res));
    
    MAKE_CONS(l, stringToValue("bt"));
    evalExpr(NULL, NULL, l, &res);
    printf("EVAL_CONST_bt=%s\n", serializeValue(res));
    
    r = op;
    MAKE_BINOP_EXPR(op, r, l, OP_BOOL_AND);
    evalExpr(NULL, NULL, op, &res);
    printf("EVAL_AND_true=%s\n", serializeValue(res));
}

