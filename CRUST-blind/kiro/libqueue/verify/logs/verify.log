#include <stdlib.h>
#include <stdio.h>
#include <stdbool.h>
#include <sys/types.h>

// Inline the queue implementation for testing
typedef struct queue_node_t {
    void* value;
    struct queue_node_t* next;
} queue_node_t;

typedef struct {
    u_int32_t size;
    queue_node_t* head;
    queue_node_t* tail;
} queue_t;

void queue_new(queue_t *queue) {
    queue->head = NULL;
    queue->tail = NULL;
    queue->size = 0;
}

bool queue_empty(queue_t *queue) {
    return queue->size == 0;
}

void queue_push(queue_t *queue, void *value) {
    queue_node_t *new_node = malloc(sizeof(queue_node_t));
    new_node->value = value;
    new_node->next = NULL;
    if(queue_empty(queue)) {
        queue->tail = new_node;
        queue->head = new_node;
    } else {
        queue->tail->next = new_node;
        queue->tail = new_node;
    }
    queue->size++;
}

void* queue_pop(queue_t *queue) {
    if(!queue || queue_empty(queue)) return NULL;
    queue_node_t *elem = queue->head;
    queue->head = queue->head->next;
    void *value = elem->value;
    if(queue->size == 1) queue->tail = NULL;
    queue->size--;
    free(elem);
    return value;
}

void* queue_front(queue_t *queue) {
    if(!queue) return NULL;
    if(queue_empty(queue)) return NULL;
    return queue->head->value;
}

void* queue_back(queue_t *queue) {
    if(!queue) return NULL;
    if(queue_empty(queue)) return NULL;
    return queue->tail->value;
}

void queue_free(queue_t *queue) {
    queue_node_t *temp = queue->head;
    queue_node_t *temp2;
    while(temp) {
        temp2 = temp;
        temp = temp->next;
        free(temp2);
    }
}

int main() {
    queue_t q;
    
    // Test 1: new queue
    queue_new(&q);
    printf("after_new: size=%u empty=%d front_null=%d back_null=%d\n",
        q.size, queue_empty(&q), queue_front(&q)==NULL, queue_back(&q)==NULL);
    
    // Test 2: push one element
    int a = 10;
    queue_push(&q, &a);
    printf("after_push_10: size=%u empty=%d front=%d back=%d front_eq_back=%d\n",
        q.size, queue_empty(&q), *(int*)queue_front(&q), *(int*)queue_back(&q),
        queue_front(&q)==queue_back(&q));
    
    // Test 3: push second element
    int b = 20;
    queue_push(&q, &b);
    printf("after_push_20: size=%u front=%d back=%d\n",
        q.size, *(int*)queue_front(&q), *(int*)queue_back(&q));
    
    // Test 4: push third element
    int c = 30;
    queue_push(&q, &c);
    printf("after_push_30: size=%u front=%d back=%d\n",
        q.size, *(int*)queue_front(&q), *(int*)queue_back(&q));
    
    // Test 5: pop
    int *popped = (int*)queue_pop(&q);
    printf("pop1: val=%d size=%u front=%d back=%d\n",
        *popped, q.size, *(int*)queue_front(&q), *(int*)queue_back(&q));
    
    // Test 6: pop again
    popped = (int*)queue_pop(&q);
    printf("pop2: val=%d size=%u front=%d back=%d\n",
        *popped, q.size, *(int*)queue_front(&q), *(int*)queue_back(&q));
    
    // Test 7: pop last
    popped = (int*)queue_pop(&q);
    printf("pop3: val=%d size=%u empty=%d\n",
        *popped, q.size, queue_empty(&q));
    
    // Test 8: pop from empty
    void *result = queue_pop(&q);
    printf("pop_empty: null=%d size=%u\n", result==NULL, q.size);
    
    // Test 9: front/back on empty
    printf("empty_front_null=%d empty_back_null=%d\n",
        queue_front(&q)==NULL, queue_back(&q)==NULL);
    
    // Test 10: push after emptying
    int d = 42;
    queue_push(&q, &d);
    printf("repush: size=%u front=%d back=%d front_eq_back=%d\n",
        q.size, *(int*)queue_front(&q), *(int*)queue_back(&q),
        queue_front(&q)==queue_back(&q));
    
    // Test 11: free and check size stays (C free doesn't reset size)
    queue_free(&q);
    printf("after_free: size=%u\n", q.size);
    
    return 0;
}
EOF
