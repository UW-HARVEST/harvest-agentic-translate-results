#include <stdio.h>
#include <string.h>
#include "tisp.h"
#include "tibs.tsp.h"

int main() {
    Tsp st = tisp_env_init(1024);
    tib_env_core(st);
    tib_env_math(st);
    tib_env_string(st);
    tisp_env_lib(st, tibs);

    // Set up foo=8, bar=4 like the test suite
    char *setup[] = {
        "(def foo 4)", "(def bar foo)", "(def foo (+ foo bar))", NULL
    };
    for (int i = 0; setup[i]; i++) {
        Val v;
        st->file = strdup(setup[i]);
        st->filec = 0;
        v = tisp_read(st);
        tisp_eval(st, st->env, v);
    }

    char *tests[] = {
        "`7.2", "`cory", "`,foo", "`(1 2 3)", "`(cory trevor)",
        "`(,foo ,bar)", "`(,foo . ,bar)", "`(,foo ,@bar)",
        "`(foo bar ,foo fry)", "`(1 ,(+ 1 2) 5 ,(- 9 2))",
        "`(1 ,@(list 4 9))", "`(3 ,@foo)", "`(a b c ,@foo)",
        "`(0 ,@(list 1 2) 3 4)",
        NULL
    };
    for (int i = 0; tests[i]; i++) {
        Val v;
        st->file = strdup(tests[i]);
        st->filec = 0;
        v = tisp_read(st);
        if (!v) { printf("READ_ERR\n"); continue; }
        v = tisp_eval(st, st->env, v);
        if (!v) { printf("EVAL_ERR\n"); continue; }
        tisp_print(stdout, v);
        printf("\n");
    }
    return 0;
}
