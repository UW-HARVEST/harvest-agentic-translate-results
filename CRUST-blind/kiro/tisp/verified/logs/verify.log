int main(int argc, char *argv[]) {
    Tsp st = tisp_env_init(1024);
    tib_env_core(st);
    tib_env_math(st);
    tib_env_string(st);
    tisp_env_lib(st, tibs);

    for (int i = 1; i < argc; i++) {
        Val v;
        st->file = strdup(argv[i]);
        st->filec = 0;
        if (!(v = tisp_read(st))) { printf("READ_ERR\n"); continue; }
        if (!(v = tisp_eval(st, st->env, v))) { printf("EVAL_ERR\n"); continue; }
        tisp_print(stdout, v);
        printf("\n");
    }
    return 0;
}
