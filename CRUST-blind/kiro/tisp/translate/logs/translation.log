// Better mk_list: build list from end to start
pub fn mk_list_from_vec(st: &mut Tsp, args: Vec<Val>) -> Option<Val> {
    let mut result = clone_val(&st.nil);
    for arg in args.into_iter().rev() {
        result = mk_pair(arg, result)?;
    }
    Some(result)
