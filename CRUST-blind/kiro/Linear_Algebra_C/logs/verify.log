#include <stdio.h>
#include <math.h>
#include "linear-algebra.h"

int main() {
    // hasZeroCol with square matrix
    double d1[4] = {0, 1, 0, 2};
    matrix* m1 = newMatrix(d1, 2, 2);
    printf("hasZeroCol 2x2 col0=zero: %d\n", hasZeroCol(m1));
    
    // hasZeroCol with non-square - C bug: outer loop j < m->rows, inner i < m->cols
    // For 2x3 matrix: rows=2, cols=3. Outer j=0,1 (only checks 2 cols), inner i=0,1,2
    // data[i*cols+j] = data[i*3+j]
    // j=0: i=0 -> data[0], i=1 -> data[3], i=2 -> data[6] (OUT OF BOUNDS!)
    double d2[6] = {0, 1, 2, 0, 3, 4};
    matrix* m2 = newMatrix(d2, 2, 3);
    printf("hasZeroCol 2x3: %d\n", hasZeroCol(m2));
    
    // For 3x2 matrix: rows=3, cols=2. Outer j=0,1,2 (checks 3 "cols" but only 2 exist)
    // inner i=0,1 (only 2 iterations)
    // j=0: data[0*2+0]=data[0], data[1*2+0]=data[2]
    // j=1: data[0*2+1]=data[1], data[1*2+1]=data[3]
    // j=2: data[0*2+2]=data[2], data[1*2+2]=data[4]  (wraps around!)
    double d3[6] = {0, 1, 0, 2, 0, 3};
    matrix* m3 = newMatrix(d3, 3, 2);
    printf("hasZeroCol 3x2: %d\n", hasZeroCol(m3));
    
    // scalarTripleProduct with specific vectors
    double a[3] = {2, 4, 3};
    double b[3] = {5, 10, 15};
    double c[3] = {1, 0, 0};
    vector* va = newVector(a, 3);
    vector* vb = newVector(b, 3);
    vector* vc = newVector(c, 3);
    printf("stp(a,b,c): %f\n", scalarTripleProduct(va, vb, vc));
    
    // Verify anti-diagonal for 3x3
    double ad[9] = {1, 2, 3, 4, 5, 6, 7, 8, 9};
    matrix* adm = newMatrix(ad, 3, 3);
    vector* adv = getAntiDiagonal(adm);
    printf("antiDiag 3x3: %f %f %f\n", adv->data[0], adv->data[1], adv->data[2]);
    
    // set anti diagonal
    double sad[3] = {10, 20, 30};
    vector* sadv = newVector(sad, 3);
    setAntiDiagonal(adm, sadv);
    printf("after setAntiDiag: ");
    for(int i = 0; i < 9; i++) printf("%f ", adm->data[i]);
    printf("\n");
    
    // Verify element-wise multiply (C's multiplyMatrices is NOT standard matrix mult)
    // Actually looking at C code again: it IS matrix multiplication, just with unusual loop order
    // and requires same dimensions
    
    // Verify addVectors
    double av1[3] = {1, 2, 3};
    double av2[3] = {4, 5, 6};
    vector* vav1 = newVector(av1, 3);
    vector* vav2 = newVector(av2, 3);
    vector* vsum = addVectors(vav1, vav2);
    printf("addVectors: %f %f %f\n", vsum->data[0], vsum->data[1], vsum->data[2]);
    
    // scaleVector
    vector* sv = scaleVector(vav1, 3.0);
    printf("scaleVector: %f %f %f\n", sv->data[0], sv->data[1], sv->data[2]);
    
    // Verify isMatrixOrthogonal is not in C source (only in header)
    // So we skip that
    
    // Verify det of 1x1, 2x2, 3x3
    double d1x1[1] = {5};
    matrix* m1x1 = newMatrix(d1x1, 1, 1);
    printf("det 1x1: %f\n", determinant(m1x1));
    
    double d2x2[4] = {1, 2, 3, 4};
    matrix* m2x2 = newMatrix(d2x2, 2, 2);
    printf("det 2x2: %f\n", determinant(m2x2));
    
    double d3x3[9] = {6, 1, 1, 4, -2, 5, 2, 8, 7};
    matrix* m3x3 = newMatrix(d3x3, 3, 3);
    printf("det 3x3: %f\n", determinant(m3x3));
    
    // Verify subMatrix
    double sm_data[9] = {1, 2, 3, 4, 5, 6, 7, 8, 9};
    matrix* sm = newMatrix(sm_data, 3, 3);
    matrix* sm00 = subMatrix(sm, 0, 0);
    printf("subMatrix(0,0): %f %f %f %f\n", sm00->data[0], sm00->data[1], sm00->data[2], sm00->data[3]);
    matrix* sm11 = subMatrix(sm, 1, 1);
    printf("subMatrix(1,1): %f %f %f %f\n", sm11->data[0], sm11->data[1], sm11->data[2], sm11->data[3]);
    
    return 0;
}
