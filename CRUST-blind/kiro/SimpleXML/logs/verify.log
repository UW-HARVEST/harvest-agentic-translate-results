#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "simple_xml.h"
#include "simple_vector.h"

void test_vector_edge() {
    Vector *v = vector_create(v);
    
    // Empty vector: top_front and top_back return NULL
    printf("top_front empty: %p\n", vector_top_front(v));
    printf("top_back empty: %p\n", vector_top_back(v));
    
    // push_back returns 1
    int a = 10, b = 20, c = 30;
    int r = vector_push_back(v, &a);
    printf("push_back return: %d\n", r);
    
    r = vector_push_front(v, &b);
    printf("push_front return: %d\n", r);
    
    r = vector_insert_at_index(v, &c, 1);
    printf("insert_at_index return: %d\n", r);
    
    // size after 3 inserts
    printf("size: %d\n", vector_size(v));
    
    // index_of with pointer comparison
    printf("index_of &a: %d\n", vector_index_of(v, &a));
    printf("index_of &b: %d\n", vector_index_of(v, &b));
    printf("index_of &c: %d\n", vector_index_of(v, &c));
    
    int d = 99;
    printf("index_of not found: %d\n", vector_index_of(v, &d));
    
    // index_of_with_start
    vector_push_back(v, &a); // v = [&b, &c, &a, &a]
    printf("index_of_with_start &a from 1: %d\n", vector_index_of_with_start(v, &a, 1));
    printf("index_of_with_start &a from 3: %d\n", vector_index_of_with_start(v, &a, 3));
    printf("index_of_with_start &a from 4: %d\n", vector_index_of_with_start(v, &a, 4));
    
    // pop_back
    void* elem = vector_pop_back(v);
    printf("pop_back == &a: %d\n", elem == &a);
    printf("size after pop_back: %d\n", vector_size(v));
    
    // pop_front
    elem = vector_pop_front(v);
    printf("pop_front == &b: %d\n", elem == &b);
    printf("size after pop_front: %d\n", vector_size(v));
    
    // remove_element_at_index
    elem = vector_remove_element_at_index(v, 0);
    printf("remove at 0 == &c: %d\n", elem == &c);
    printf("size after remove: %d\n", vector_size(v));
    
    vector_release(v);
    printf("PASSED edge tests\n");
}

void test_simple_xml() {
    // Simple single element
    char* s1 = "<root>hello</root>";
    XMLElement* e1 = parse_xml_from_text(s1);
    printf("tag: %s, value: %s, children: %d\n", e1->tag_name, e1->value, vector_size(e1->children));
    
    // Nested
    char* s2 = "<a><b>inner</b></a>";
    XMLElement* e2 = parse_xml_from_text(s2);
    printf("tag: %s, children: %d\n", e2->tag_name, vector_size(e2->children));
    XMLElement* child = vector_get_element_at(e2->children, 0);
    printf("child tag: %s, value: %s\n", child->tag_name, child->value);
    
    // Multiple children
    char* s3 = "<root><a>1</a><b>2</b><c>3</c></root>";
    XMLElement* e3 = parse_xml_from_text(s3);
    printf("root children: %d\n", vector_size(e3->children));
    for (int i = 0; i < vector_size(e3->children); i++) {
        XMLElement* c = vector_get_element_at(e3->children, i);
        printf("  child %d: tag=%s value=%s\n", i, c->tag_name, c->value);
    }
    
    // Deep nesting
    char* s4 = "<a><b><c>deep</c></b></a>";
    XMLElement* e4 = parse_xml_from_text(s4);
    printf("a children: %d\n", vector_size(e4->children));
    XMLElement* b = vector_get_element_at(e4->children, 0);
    printf("b tag: %s, children: %d\n", b->tag_name, vector_size(b->children));
    XMLElement* c = vector_get_element_at(b->children, 0);
    printf("c tag: %s, value: %s\n", c->tag_name, c->value);
    
    printf("PASSED xml edge tests\n");
}

int main() {
    test_vector_edge();
    test_simple_xml();
    return 0;
}
EOF
