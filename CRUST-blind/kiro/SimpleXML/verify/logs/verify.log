#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "simple_xml.h"
#include "simple_vector.h"

int main() {
    // Test vector basics
    Vector *v = vector_create(v);
    printf("initial size: %d\n", vector_size(v));
    printf("initial capacity: %d\n", v->_capacity);
    
    // top_front/top_back on empty
    printf("top_front empty: %p\n", vector_top_front(v));
    printf("top_back empty: %p\n", vector_top_back(v));
    
    int a = 10, b = 20, c = 30;
    vector_push_back(v, &a);
    printf("after push_back a: size=%d\n", vector_size(v));
    
    vector_push_back(v, &b);
    printf("after push_back b: size=%d\n", vector_size(v));
    
    // index_of uses pointer comparison
    printf("index_of &a: %d\n", vector_index_of(v, &a));
    printf("index_of &b: %d\n", vector_index_of(v, &b));
    printf("index_of &c (not in): %d\n", vector_index_of(v, &c));
    
    // index_of_with_start
    vector_push_back(v, &a); // v = [&a, &b, &a]
    printf("index_of_with_start &a from 0: %d\n", vector_index_of_with_start(v, &a, 0));
    printf("index_of_with_start &a from 1: %d\n", vector_index_of_with_start(v, &a, 1));
    printf("index_of_with_start &a from 3: %d\n", vector_index_of_with_start(v, &a, 3));
    
    // pop_back
    void *popped = vector_pop_back(v);
    printf("pop_back == &a: %d\n", popped == &a);
    printf("after pop_back size: %d\n", vector_size(v));
    
    // pop_front
    popped = vector_pop_front(v);
    printf("pop_front == &a: %d\n", popped == &a);
    printf("after pop_front size: %d\n", vector_size(v));
    
    vector_release(v);
    
    // Test simple XML
    char *s1 = "<root>hello</root>";
    XMLElement *e1 = parse_xml_from_text(s1);
    printf("simple xml tag: %s\n", e1->tag_name);
    printf("simple xml value: %s\n", e1->value);
    printf("simple xml children: %d\n", vector_size(e1->children));
    
    // Test nested XML
    char *s2 = "<a><b>val_b</b><c>val_c</c></a>";
    XMLElement *e2 = parse_xml_from_text(s2);
    printf("nested tag: %s\n", e2->tag_name);
    printf("nested children: %d\n", vector_size(e2->children));
    XMLElement *b_elem = vector_get_element_at(e2->children, 0);
    XMLElement *c_elem = vector_get_element_at(e2->children, 1);
    printf("child0 tag: %s, value: %s, children: %d\n", b_elem->tag_name, b_elem->value, vector_size(b_elem->children));
    printf("child1 tag: %s, value: %s, children: %d\n", c_elem->tag_name, c_elem->value, vector_size(c_elem->children));
    
    // Test deeply nested
    char *s3 = "<a><b><c>deep</c></b></a>";
    XMLElement *e3 = parse_xml_from_text(s3);
    printf("deep tag: %s, children: %d\n", e3->tag_name, vector_size(e3->children));
    XMLElement *b3 = vector_get_element_at(e3->children, 0);
    printf("deep child0 tag: %s, children: %d\n", b3->tag_name, vector_size(b3->children));
    XMLElement *c3 = vector_get_element_at(b3->children, 0);
    printf("deep child0.child0 tag: %s, value: %s, children: %d\n", c3->tag_name, c3->value, vector_size(c3->children));
    
    return 0;
}
EOF
