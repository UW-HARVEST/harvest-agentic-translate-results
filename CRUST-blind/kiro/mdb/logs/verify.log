static uint32_t mdb_hash(const char *key) {
  uint32_t ret = 0;
  for (uint32_t i = 0; *key != '\0'; ++key, ++i) {
    ret += (uint32_t)*key * i;
  }
  return ret;
}

int main() {
  // Test hash values for various keys
  printf("hash(\"\") = %u\n", mdb_hash(""));
  printf("hash(\"a\") = %u\n", mdb_hash("a"));
  printf("hash(\"ab\") = %u\n", mdb_hash("ab"));
  printf("hash(\"abc\") = %u\n", mdb_hash("abc"));
  printf("hash(\"misakawa\") = %u\n", mdb_hash("misakawa"));
  printf("hash(\"Lisp\") = %u\n", mdb_hash("Lisp"));
  printf("hash(\"000\") = %u\n", mdb_hash("000"));
  printf("hash(\"999\") = %u\n", mdb_hash("999"));
  
  // Test hash % 128 for bucket assignment
