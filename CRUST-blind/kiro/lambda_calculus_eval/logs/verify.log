    printf("parse_token('\\n') = %d\n", parse_token('\n'));
    printf("parse_token('=') = %d\n", parse_token('='));
    printf("parse_token('\"') = %d\n", parse_token('"'));
    printf("parse_token(':') = %d\n", parse_token(':'));
    printf("parse_token('$') = %d\n", parse_token('$'));
    
    // Test is_uppercase
    printf("is_uppercase('A') = %d\n", is_uppercase('A'));
    printf("is_uppercase('Z') = %d\n", is_uppercase('Z'));
    printf("is_uppercase('a') = %d\n", is_uppercase('a'));
    printf("is_uppercase('z') = %d\n", is_uppercase('z'));
    
    // Test substitute - variable matches
    AstNode *var_x = create_variable("x", NULL);
    AstNode *replacement = create_variable("y", "Nat");
    AstNode *result = substitute(var_x, "x", replacement);
    printf("substitute var match: name=%s, type=%s\n", result->node.variable->name, result->node.variable->type);
    
    // Test substitute - variable doesn't match
    AstNode *var_z = create_variable("z", "Bool");
    result = substitute(var_z, "x", replacement);
    printf("substitute var no match: name=%s, type=%s\n", result->node.variable->name, result->node.variable->type);
    
    // Test deepcopy
    AstNode *body = create_variable("x", NULL);
    AstNode *lambda = create_lambda("x", body, "Nat");
    AstNode *copy = deepcopy(lambda);
    printf("deepcopy lambda: param=%s, type=%s, body_type=%d\n", 
        copy->node.lambda_expr->parameter, copy->node.lambda_expr->type, copy->node.lambda_expr->body->type);
    
    // Test deepcopy application
    AstNode *func = create_variable("f", "Nat");
    AstNode *arg = create_variable("a", "Bool");
    AstNode *app = create_application(func, arg);
    AstNode *app_copy = deepcopy(app);
    printf("deepcopy app: func_name=%s, arg_name=%s\n",
        app_copy->node.application->function->node.variable->name,
        app_copy->node.application->argument->node.variable->name);
    
    // Test type_equal
    Type *t1 = create_type("Nat", NULL, NULL);
    Type *t2 = create_type("Nat", NULL, NULL);
    Type *t3 = create_type("Bool", NULL, NULL);
    Type *t4 = create_type("Nat", "Bool", NULL);
    Type *t5 = create_type("Nat", "Bool", NULL);
    Type *t6 = create_type("Nat", "Nat", NULL);
    printf("type_equal(Nat,Nat) = %d\n", type_equal(t1, t2));
    printf("type_equal(Nat,Bool) = %d\n", type_equal(t1, t3));
    printf("type_equal(Nat->Bool,Nat->Bool) = %d\n", type_equal(t4, t5));
    printf("type_equal(Nat->Bool,Nat->Nat) = %d\n", type_equal(t4, t6));
    printf("type_equal(Nat,Nat->Bool) = %d\n", type_equal(t1, t4));
    printf("type_equal(NULL,Nat) = %d\n", type_equal(NULL, t1));
    
    // Test get_type_from_expr
    AstNode *var_typed = create_variable("x", "Nat");
    AstNode *lambda_typed = create_lambda("x", create_variable("x", NULL), "Bool");
    printf("get_type_from_expr(var) = %s\n", get_type_from_expr(var_typed));
    printf("get_type_from_expr(lambda) = %s\n", get_type_from_expr(lambda_typed));
    AstNode *app2 = create_application(var_typed, var_typed);
    char *app_type = get_type_from_expr(app2);
    printf("get_type_from_expr(app) = %s\n", app_type == NULL ? "NULL" : app_type);
    
    // Test parse_function_type
    Type *ft = parse_function_type("Nat");
    printf("parse_function_type: type=%s, return_type=%s\n", ft->type, ft->return_type == NULL ? "NULL" : ft->return_type);
    
    return 0;
}
