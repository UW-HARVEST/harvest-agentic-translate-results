    printf("hash(\"test\") = %u\n", hash("test"));
    printf("hash(\"\") = %u\n", hash(""));
    printf("hash(\"a\") = %u\n", hash("a"));
    printf("hash(\"hello\") = %u\n", hash("hello"));
    
    // Test HashTable operations
    HashTable *ht = createHashTable();
    printf("exists before insert: %d\n", table_exists(ht, "key1"));
    
    insert(ht, "key1", NULL);
    printf("exists after insert: %d\n", table_exists(ht, "key1"));
    printf("search NULL value: %p\n", search(ht, "key1"));
    
    AstNode *var = (AstNode*)malloc(sizeof(AstNode));
    var->type = VAR;
    var->node.variable = (Variable*)malloc(sizeof(Variable));
    var->node.variable->name = "x";
    var->node.variable->type = "Nat";
    
    insert(ht, "key2", var);
    AstNode *found = search(ht, "key2");
    printf("search found: %d, name=%s\n", found != NULL, found->node.variable->name);
    
    delete_c(ht, "key1");
    printf("exists after delete: %d\n", table_exists(ht, "key1"));
    
    // Test search with NULL key
    AstNode *null_result = search(ht, NULL);
    printf("search NULL key: %p\n", null_result);
    
    // Test ast_to_string
    char *s = ast_to_string(var);
    printf("ast_to_string VAR: '%s'\n", s);
    
    // Variable with NULL type
    AstNode *var2 = (AstNode*)malloc(sizeof(AstNode));
    var2->type = VAR;
    var2->node.variable = (Variable*)malloc(sizeof(Variable));
    var2->node.variable->name = "y";
    var2->node.variable->type = NULL;
    s = ast_to_string(var2);
    printf("ast_to_string VAR no type: '%s'\n", s);
    
    // Lambda
    AstNode *lambda = (AstNode*)malloc(sizeof(AstNode));
    lambda->type = LAMBDA_EXPR;
    lambda->node.lambda_expr = (LambdaExpression*)malloc(sizeof(LambdaExpression));
    lambda->node.lambda_expr->parameter = "x";
    lambda->node.lambda_expr->type = "Nat";
    lambda->node.lambda_expr->body = var2;
    s = ast_to_string(lambda);
    printf("ast_to_string LAMBDA: '%s'\n", s);
    
    // Application
    AstNode *app = (AstNode*)malloc(sizeof(AstNode));
    app->type = APPLICATION;
    app->node.application = (Application*)malloc(sizeof(Application));
    app->node.application->function = lambda;
    app->node.application->argument = var;
    s = ast_to_string(app);
    printf("ast_to_string APP: '%s'\n", s);
    
    // Definition
    AstNode *def = (AstNode*)malloc(sizeof(AstNode));
    def->type = DEFINITION;
    def->node.variable = (Variable*)malloc(sizeof(Variable));
    def->node.variable->name = "mydef";
    s = ast_to_string(def);
    printf("ast_to_string DEF: '%s'\n", s);
    
    return 0;
}
EOF
