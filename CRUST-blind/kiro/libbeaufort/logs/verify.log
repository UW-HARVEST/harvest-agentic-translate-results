#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <beaufort.h>

int main(void) {
    // Test with "abc" alphabet
    char **mat_abc = beaufort_tableau("abc");
    printf("abc tableau:\n");
    for (int y = 0; y < 3; y++) {
        for (int x = 0; x < 3; x++) printf("%c ", mat_abc[y][x]);
        printf("\n");
    }
    // Verify NULL terminator
    printf("mat_abc[3] is NULL: %d\n", mat_abc[3] == NULL);

    // Test single char alphabet
    char **mat1 = beaufort_tableau("X");
    printf("single char tableau: %c\n", mat1[0][0]);

    // Encrypt/decrypt with chars not in alphabet (passthrough)
    char *enc = beaufort_encrypt("hello!", "key", NULL);
    printf("encrypt 'hello!' with 'key': '%s'\n", enc);
    char *dec = beaufort_decrypt(enc, "key", NULL);
    printf("decrypt back: '%s'\n", dec);

    // Encrypt empty string
    char *enc_empty = beaufort_encrypt("", "key", NULL);
    printf("encrypt empty: '%s'\n", enc_empty);

    // Encrypt with single char key
    char *enc1 = beaufort_encrypt("abc", "a", NULL);
    printf("encrypt 'abc' with 'a': '%s'\n", enc1);

    // Test with custom tableau
    char **custom = beaufort_tableau("abc");
    char *enc_custom = beaufort_encrypt("abc", "a", custom);
    printf("encrypt 'abc' with 'a' custom abc: '%s'\n", enc_custom);
    char *dec_custom = beaufort_decrypt(enc_custom, "a", custom);
    printf("decrypt back custom: '%s'\n", dec_custom);

    // Decrypt with chars not in first column
    char *dec2 = beaufort_decrypt("!@#", "key", NULL);
    printf("decrypt '!@#' with 'key': '%s'\n", dec2);

    // Test roundtrip with special chars
    char *src = "Hello World 123!";
    char *enc3 = beaufort_encrypt(src, "test", NULL);
    printf("encrypt '%s' with 'test': '%s'\n", src, enc3);
    char *dec3 = beaufort_decrypt(enc3, "test", NULL);
    printf("decrypt back: '%s'\n", dec3);

    return 0;
}
EOF
