#include <stdio.h>
#include <string.h>
#include "compactsize.h"

int main() {
    // Test that compactsize_write for small values works correctly
    unsigned char buf[16] = {0};
    enum psbt_result err = PSBT_OK;
    
    // Values < 253 should work fine
    compactsize_write(buf, 0);
    printf("write 0: %02x, read back: %llu\n", buf[0], (unsigned long long)compactsize_read(buf, &err));
    
