[?25l[0m[38;5;141m> [0mInteresting — the C [38;5;10mcompactsize_write[0m has a bug for values >= 253 (it writes the marker byte then overwrites it with the serialized value at [38;5;10mdest[0m instead of [38;5;10mdest+1[0m). Let me verify:[0m[0m
[?25l[0m[0mI will run the following command: [38;5;141mcd /tmp/harvest-crust-verify-yXL7DF/project/c_src && cat > cs_test.c << 'EOF'
#include <stdio.h>
#include "compactsize.h"

int main() {
    unsigned char buf[16] = {0};
    
    // Write 253 and check bytes
    compactsize_write(buf, 253);
    printf("write 253: ");
    for (int i = 0; i < 4; i++) printf("%02x ", buf[i]);
    printf("\n");
    
    // Write 0x10000 and check bytes
    compactsize_write(buf, 0x10000);
    printf("write 0x10000: ");
    for (int i = 0; i < 6; i++) printf("%02x ", buf[i]);
    printf("\n");
    
    // Write 0x100000000 and check bytes
    compactsize_write(buf, 0x100000000ULL);
    printf("write 0x100000000: ");
    for (int i = 0; i < 10; i++) printf("%02x ", buf[i]);
    printf("\n");
    
    // The C code has a bug: serialize_u16/u32/u64 write to dest, not dest+1
    // So for 253, it writes: fd to dest[0], then 253 as u16 LE to dest[0..1]
    // Result: fd00 at dest[0..1] (overwriting fd with fd), then 00 at dest[1]
    // Wait, 253 as u16 LE = 0xFD 0x00, so dest[0]=0xFD, dest[1]=0x00
    // But the marker byte 253 was already at dest[0]
    // So the final bytes are: FD FD 00 (marker, then u16 LE at dest[0])
    // No wait, serialize_u16 writes to dest, not dest+1!
    
    return 0;
}
EOF
