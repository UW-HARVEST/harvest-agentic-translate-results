    printf("\nsplit_by 'WsomeWstringW124!' by 'W' -> %zu parts:\n", arr_size2);
    for (size_t i = 0; i < arr_size2; i++) {
        printf("  [%zu] '%s' (size=%zu)\n", i, arr2[i]->bytes, arr2[i]->size);
    }

    // string_strip edge cases
    string_t *s4 = new_string_from_bytes("");
    string_t *stripped = string_strip(s4);
    printf("\nstrip '' -> '%s' (size=%zu)\n", stripped->bytes, stripped->size);

    string_t *s5 = new_string_from_bytes("   ");
    string_t *stripped2 = string_strip(s5);
    printf("strip '   ' -> '%s' (size=%zu)\n", stripped2->bytes, stripped2->size);

    // string_eq with different strings
    string_t *a = new_string_from_bytes("abc");
    string_t *b = new_string_from_bytes("def");
