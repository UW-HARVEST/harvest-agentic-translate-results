    string_t *j1 = new_string_from_bytes("abc");
    string_t *j2 = new_string_from_bytes("def");
    string_t *jarr[] = {j1, j2};
    string_t *joined = string_join_arr(jarr, 2, "");
    printf("\njoin ['abc','def'] with '': '%s' (size=%zu)\n", joined->bytes, joined->size);

