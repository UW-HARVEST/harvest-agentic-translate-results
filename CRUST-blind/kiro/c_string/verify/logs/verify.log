    printf("find 'no' in 'test string': %d\n", string_find(s1, "no"));
    printf("find '' in 'test string': %d\n", string_find(s1, ""));
    printf("find '' in '': %d\n", string_find(new_string_from_bytes(""), ""));
    printf("find 'str' in 'test string': %d\n", string_find(s1, "str"));

