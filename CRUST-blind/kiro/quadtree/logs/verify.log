#include <stdio.h>
#include "src/quadtree.h"

int main() {
    // Test bounds initial values
    quadtree_bounds_t *b = quadtree_bounds_new();
    printf("bounds_new: nw=(%f,%f) se=(%f,%f) w=%f h=%f\n", b->nw->x, b->nw->y, b->se->x, b->se->y, b->width, b->height);
    
    // Extend with single point
    quadtree_bounds_extend(b, 5.0, 5.0);
    printf("after extend(5,5): nw=(%f,%f) se=(%f,%f) w=%f h=%f\n", b->nw->x, b->nw->y, b->se->x, b->se->y, b->width, b->height);
    
    // Extend with second point
    quadtree_bounds_extend(b, 10.0, 10.0);
    printf("after extend(10,10): nw=(%f,%f) se=(%f,%f) w=%f h=%f\n", b->nw->x, b->nw->y, b->se->x, b->se->y, b->width, b->height);
    quadtree_bounds_free(b);

    // Test node_with_bounds
    quadtree_node_t *n = quadtree_node_with_bounds(1.0, 1.0, 10.0, 10.0);
    printf("node_with_bounds(1,1,10,10): nw=(%f,%f) se=(%f,%f) w=%f h=%f\n",
        n->bounds->nw->x, n->bounds->nw->y, n->bounds->se->x, n->bounds->se->y,
        n->bounds->width, n->bounds->height);

    // Test tree insert edge cases
    quadtree_t *tree = quadtree_new(0, 0, 10, 10);
    printf("tree bounds: nw=(%f,%f) se=(%f,%f)\n",
        tree->root->bounds->nw->x, tree->root->bounds->nw->y,
        tree->root->bounds->se->x, tree->root->bounds->se->y);
    
    int val = 42;
    // Insert at boundary
    printf("insert(0,0): %d\n", quadtree_insert(tree, 0.0, 0.0, &val));
    printf("length: %d\n", tree->length);
    printf("insert(10,10): %d\n", quadtree_insert(tree, 10.0, 10.0, &val));
    printf("length: %d\n", tree->length);
    printf("insert(5,5): %d\n", quadtree_insert(tree, 5.0, 5.0, &val));
    printf("length: %d\n", tree->length);
    
    // Search
    quadtree_point_t *found = quadtree_search(tree, 0.0, 0.0);
    printf("search(0,0): %s\n", found ? "found" : "NULL");
    found = quadtree_search(tree, 5.0, 5.0);
    printf("search(5,5): %s x=%f y=%f\n", found ? "found" : "NULL", found ? found->x : 0, found ? found->y : 0);
    found = quadtree_search(tree, 99.0, 99.0);
    printf("search(99,99): %s\n", found ? "found" : "NULL");
    
    // Insert out of bounds
    printf("insert(-1,-1): %d\n", quadtree_insert(tree, -1.0, -1.0, &val));
    printf("insert(11,11): %d\n", quadtree_insert(tree, 11.0, 11.0, &val));
    
    // Replace
    printf("insert(5,5) again: %d\n", quadtree_insert(tree, 5.0, 5.0, &val));
    printf("length after replace: %d\n", tree->length);
    
    // More inserts to force splits
    printf("insert(1,1): %d\n", quadtree_insert(tree, 1.0, 1.0, &val));
    printf("insert(9,9): %d\n", quadtree_insert(tree, 9.0, 9.0, &val));
    printf("insert(2,8): %d\n", quadtree_insert(tree, 2.0, 8.0, &val));
    printf("insert(8,2): %d\n", quadtree_insert(tree, 8.0, 2.0, &val));
    printf("length: %d\n", tree->length);
    
    // Search after splits
    found = quadtree_search(tree, 1.0, 1.0);
    printf("search(1,1): %s\n", found ? "found" : "NULL");
    found = quadtree_search(tree, 9.0, 9.0);
    printf("search(9,9): %s\n", found ? "found" : "NULL");
    found = quadtree_search(tree, 7.0, 7.0);
    printf("search(7,7): %s\n", found ? "found" : "NULL");
    
    quadtree_free(tree);
    
    // Test with tree(1,1,10,10) like in test.c
    quadtree_t *tree2 = quadtree_new(1, 1, 10, 10);
    printf("\ntree2 bounds: nw=(%f,%f) se=(%f,%f)\n",
        tree2->root->bounds->nw->x, tree2->root->bounds->nw->y,
        tree2->root->bounds->se->x, tree2->root->bounds->se->y);
    printf("insert(0,0): %d\n", quadtree_insert(tree2, 0.0, 0.0, &val));
    printf("insert(0,1): %d\n", quadtree_insert(tree2, 0.0, 1.0, &val));
    printf("insert(1,1): %d\n", quadtree_insert(tree2, 1.0, 1.0, &val));
    printf("length: %d\n", tree2->length);
    quadtree_free(tree2);
    
    return 0;
}
EOF
