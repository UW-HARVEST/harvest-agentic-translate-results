use libfor::forLib::*;

fn main() {
    // Test basic compress/uncompress
    let input: Vec<u32> = vec![10, 12, 15, 18, 20, 25, 30, 35];
    let mut compressed = vec![0u8; 1024];
    let len = for_compress_sorted(&input, &mut compressed, 8);
    println!("Compressed {} values into {} bytes", 8, len);

    let mut output = vec![0u32; 8];
    let consumed = for_uncompress(&compressed, &mut output, 8);
    println!("Uncompressed {} bytes", consumed);
    println!("Input:  {:?}", input);
    println!("Output: {:?}", output);
    assert_eq!(input, output, "Sorted compress/uncompress mismatch!");

    // Test unsorted
    let input2: Vec<u32> = vec![30, 10, 25, 15, 20, 35, 12, 18];
    let len2 = for_compress_unsorted(&input2, &mut compressed, 8);
    println!("\nUnsorted compressed {} values into {} bytes", 8, len2);
    let mut output2 = vec![0u32; 8];
    for_uncompress(&compressed, &mut output2, 8);
    println!("Input:  {:?}", input2);
    println!("Output: {:?}", output2);
    assert_eq!(input2, output2, "Unsorted compress/uncompress mismatch!");

    // Test select
    let val = for_select(&compressed, 3);
    println!("\nSelect index 3: {} (expected {})", val, input2[3]);
    assert_eq!(val, input2[3]);

    // Test linear search
    let idx = for_linear_search(&compressed, 8, 25);
    println!("Linear search for 25: index {} (expected 2)", idx);
    assert_eq!(idx, 2);

    let idx_not = for_linear_search(&compressed, 8, 99);
    println!("Linear search for 99: index {} (expected 8=not found)", idx_not);
    assert_eq!(idx_not, 8);

    // Test required_bits
    assert_eq!(required_bits(0), 0);
    assert_eq!(required_bits(1), 1);
    assert_eq!(required_bits(2), 2);
    assert_eq!(required_bits(3), 2);
    assert_eq!(required_bits(255), 8);
    assert_eq!(required_bits(256), 9);

    // Test compressed_size
    let sz = for_compressed_size_bits(32, 1);
    println!("\nCompressed size for 32 values at 1 bit: {} bytes", sz);
    assert_eq!(sz, 4);

    // Test append
    let mut buf = vec![0u8; 1024];
    let s = for_compress_sorted(&[100, 105, 110], &mut buf, 3);
    println!("\nCompressed 3 sorted values into {} bytes", s);
    let s2 = for_append_sorted(&mut buf, 3, 115);
    println!("After append: {} bytes", s2);
    let mut out4 = vec![0u32; 4];
    for_uncompress(&buf, &mut out4, 4);
    println!("After append: {:?}", out4);
    assert_eq!(out4, vec![100, 105, 110, 115]);

    // Test lower bound search
    let sorted = vec![10u32, 20, 30, 40, 50];
    let mut buf2 = vec![0u8; 1024];
    for_compress_sorted(&sorted, &mut buf2, 5);
    let mut actual = 0u32;
    let idx = for_lower_bound_search(&buf2, 5, 25, &mut actual);
    println!("\nLower bound search for 25: index={}, actual={}", idx, actual);
    assert_eq!(idx, 2);
    assert_eq!(actual, 30);

    // Test with all same values
    let same = vec![42u32; 16];
    let mut buf3 = vec![0u8; 1024];
    let s = for_compress_sorted(&same, &mut buf3, 16);
    println!("\nCompressed 16 identical values into {} bytes", s);
    let mut out16 = vec![0u32; 16];
    for_uncompress(&buf3, &mut out16, 16);
    assert_eq!(same, out16);

    // Test with 32-bit range
    let big = vec![0u32, u32::MAX];
    let mut buf4 = vec![0u8; 1024];
    let s = for_compress_sorted(&big, &mut buf4, 2);
    println!("Compressed [0, MAX] into {} bytes", s);
    let mut out2 = vec![0u32; 2];
    for_uncompress(&buf4, &mut out2, 2);
    println!("Output: {:?}", out2);
    assert_eq!(big, out2);

    println!("\nAll tests passed!");
}
EOF
