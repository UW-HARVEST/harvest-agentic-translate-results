#include "ltre.h"
#include <stdio.h>
#include <string.h>

int main(void) {
    // Test ltre_parse with valid regex
    char *error = NULL, *loc;
    
    // Test 1: simple regex
    loc = "abc";
    struct nfa nfa = ltre_parse(&loc, &error);
    printf("parse 'abc': error=%s\n", error ? error : "none");
    
    // Test 2: compile and match
    struct dstate *dfa = ltre_compile(nfa);
    printf("match 'abc' vs 'abc': %d\n", ltre_matches(dfa, (uint8_t*)"abc"));
    printf("match 'abc' vs 'ab': %d\n", ltre_matches(dfa, (uint8_t*)"ab"));
    printf("match 'abc' vs 'abcd': %d\n", ltre_matches(dfa, (uint8_t*)"abcd"));
    printf("match 'abc' vs '': %d\n", ltre_matches(dfa, (uint8_t*)""));
    
    // Test 3: serialize/deserialize
    size_t size = 0;
    uint8_t *buf = dfa_serialize(dfa, &size);
    printf("serialize size: %zu\n", size);
    size_t dsize = 0;
    struct dstate *dfa2 = dfa_deserialize(buf, &dsize);
    printf("deserialize size: %zu\n", dsize);
    printf("match after deser 'abc' vs 'abc': %d\n", ltre_matches(dfa2, (uint8_t*)"abc"));
    printf("match after deser 'abc' vs 'ab': %d\n", ltre_matches(dfa2, (uint8_t*)"ab"));
    dfa_free(dfa2);
    free(buf);
    
    // Test 4: decompile
    char *re = ltre_decompile(dfa);
    printf("decompile 'abc': '%s'\n", re);
    free(re);
    dfa_free(dfa);
    
    // Test 5: fixed string
    struct nfa nfa2 = ltre_fixed_string("hello");
    struct dstate *dfa3 = ltre_compile(nfa2);
    printf("fixed 'hello' vs 'hello': %d\n", ltre_matches(dfa3, (uint8_t*)"hello"));
    printf("fixed 'hello' vs 'hell': %d\n", ltre_matches(dfa3, (uint8_t*)"hell"));
    printf("fixed 'hello' vs '': %d\n", ltre_matches(dfa3, (uint8_t*)""));
    dfa_free(dfa3);
    
    // Test 6: partial
    loc = "foo";
    nfa = ltre_parse(&loc, &error);
    ltre_partial(&nfa);
    dfa = ltre_compile(nfa);
    printf("partial 'foo' vs 'foobar': %d\n", ltre_matches(dfa, (uint8_t*)"foobar"));
    printf("partial 'foo' vs 'barfoo': %d\n", ltre_matches(dfa, (uint8_t*)"barfoo"));
    printf("partial 'foo' vs 'bar': %d\n", ltre_matches(dfa, (uint8_t*)"bar"));
    printf("partial 'foo' vs '': %d\n", ltre_matches(dfa, (uint8_t*)""));
    dfa_free(dfa);
    
    // Test 7: ignorecase
    loc = "abc";
    nfa = ltre_parse(&loc, &error);
    ltre_ignorecase(&nfa);
    dfa = ltre_compile(nfa);
    printf("icase 'abc' vs 'ABC': %d\n", ltre_matches(dfa, (uint8_t*)"ABC"));
    printf("icase 'abc' vs 'AbC': %d\n", ltre_matches(dfa, (uint8_t*)"AbC"));
    printf("icase 'abc' vs 'abd': %d\n", ltre_matches(dfa, (uint8_t*)"abd"));
    dfa_free(dfa);
    
    // Test 8: complement
    loc = "abc";
    nfa = ltre_parse(&loc, &error);
    ltre_complement(&nfa);
    dfa = ltre_compile(nfa);
    printf("complement 'abc' vs 'abc': %d\n", ltre_matches(dfa, (uint8_t*)"abc"));
    printf("complement 'abc' vs 'ab': %d\n", ltre_matches(dfa, (uint8_t*)"ab"));
    printf("complement 'abc' vs '': %d\n", ltre_matches(dfa, (uint8_t*)""));
    printf("complement 'abc' vs 'xyz': %d\n", ltre_matches(dfa, (uint8_t*)"xyz"));
    dfa_free(dfa);
    
    // Test 9: uncompile
    loc = "a|b";
    nfa = ltre_parse(&loc, &error);
    dfa = ltre_compile(nfa);
    struct nfa nfa3 = ltre_uncompile(dfa);
    struct dstate *dfa4 = ltre_compile(nfa3);
    printf("uncompile 'a|b' vs 'a': %d\n", ltre_matches(dfa4, (uint8_t*)"a"));
    printf("uncompile 'a|b' vs 'b': %d\n", ltre_matches(dfa4, (uint8_t*)"b"));
    printf("uncompile 'a|b' vs 'c': %d\n", ltre_matches(dfa4, (uint8_t*)"c"));
    printf("uncompile 'a|b' vs '': %d\n", ltre_matches(dfa4, (uint8_t*)""));
    dfa_free(dfa4);
    nfa_free(nfa3);
    dfa_free(dfa);
    
    // Test 10: lazy matches
    loc = "a+b";
    nfa = ltre_parse(&loc, &error);
    struct dstate *ldfa = NULL;
    printf("lazy 'a+b' vs 'ab': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)"ab"));
    printf("lazy 'a+b' vs 'aab': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)"aab"));
    printf("lazy 'a+b' vs 'b': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)"b"));
    printf("lazy 'a+b' vs '': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)""));
    dfa_free(ldfa);
    nfa_free(nfa);
    
    // Test 11: parse errors
    loc = "[abc";
    nfa = ltre_parse(&loc, &error);
    printf("parse '[abc': error=%s\n", error ? error : "none");
    
    loc = "(abc";
    nfa = ltre_parse(&loc, &error);
    printf("parse '(abc': error=%s\n", error ? error : "none");
    
    loc = "+a";
    nfa = ltre_parse(&loc, &error);
    printf("parse '+a': error=%s\n", error ? error : "none");
    
    // Test 12: empty regex
    loc = "";
    nfa = ltre_parse(&loc, &error);
    printf("parse '': error=%s\n", error ? error : "none");
    dfa = ltre_compile(nfa);
    printf("match '' vs '': %d\n", ltre_matches(dfa, (uint8_t*)""));
    printf("match '' vs 'a': %d\n", ltre_matches(dfa, (uint8_t*)"a"));
    dfa_free(dfa);
    
    // Test 13: fixed string empty
    nfa2 = ltre_fixed_string("");
    dfa3 = ltre_compile(nfa2);
    printf("fixed '' vs '': %d\n", ltre_matches(dfa3, (uint8_t*)""));
    printf("fixed '' vs 'a': %d\n", ltre_matches(dfa3, (uint8_t*)"a"));
    dfa_free(dfa3);
    
    // Test 14: C isspace includes \x0c (form feed)?
    loc = "\\s+";
    nfa = ltre_parse(&loc, &error);
    dfa = ltre_compile(nfa);
    printf("isspace 0x0b: %d\n", ltre_matches(dfa, (uint8_t*)"\x0b"));
    printf("isspace 0x0c: %d\n", ltre_matches(dfa, (uint8_t*)"\x0c"));
    printf("isspace 0x20: %d\n", ltre_matches(dfa, (uint8_t*)"\x20"));
    dfa_free(dfa);
    
    return 0;
}
EOF
