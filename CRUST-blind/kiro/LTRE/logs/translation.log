use LTRE::ltre::*;

fn test_match(regex: &str, input: &str, expected: bool) {
    let nfa = ltre_parse(regex).unwrap();
    let dfa = ltre_compile(nfa);
    let result = ltre_matches(&dfa, input.as_bytes());
    assert_eq!(result, expected, "regex: /{regex}/ input: '{input}' expected: {expected} got: {result}");
}

fn test_match_partial(regex: &str, input: &str, expected: bool) {
    let mut nfa = ltre_parse(regex).unwrap();
    ltre_partial(&mut nfa).unwrap();
    let dfa = ltre_compile(nfa);
    let result = ltre_matches(&dfa, input.as_bytes());
    assert_eq!(result, expected, "partial regex: /{regex}/ input: '{input}' expected: {expected} got: {result}");
}

fn main() {
    // Basic literal
    test_match("abc", "abc", true);
    test_match("abc", "ab", false);
    test_match("abc", "abcd", false);
    
    // Alternation
    test_match("a|b", "a", true);
    test_match("a|b", "b", true);
    test_match("a|b", "c", false);
    
    // Kleene star
    test_match("a*", "", true);
    test_match("a*", "aaa", true);
    test_match("a*b", "b", true);
    test_match("a*b", "aaab", true);
    
    // Plus
    test_match("a+", "", false);
    test_match("a+", "a", true);
    test_match("a+", "aaa", true);
    
    // Optional
    test_match("a?b", "b", true);
    test_match("a?b", "ab", true);
    test_match("a?b", "aab", false);
    
    // Dot
    test_match(".", "a", true);
    test_match(".", "\n", false);
    test_match("..", "ab", true);
    
    // Character classes
    test_match("[abc]", "a", true);
    test_match("[abc]", "d", false);
    test_match("[a-z]", "m", true);
    test_match("[a-z]", "A", false);
    
    // Shorthand classes
    test_match("\\d", "5", true);
    test_match("\\d", "a", false);
    test_match("\\w+", "hello", true);
    test_match("\\s", " ", true);
    
    // Partial matching
    test_match_partial("abc", "xabcx", true);
    test_match_partial("abc", "xyz", false);
    
    // Complement
    {
        let mut nfa = ltre_parse("abc").unwrap();
        ltre_complement(&mut nfa);
        let dfa = ltre_compile(nfa);
        assert!(!ltre_matches(&dfa, b"abc"));
        assert!(ltre_matches(&dfa, b"ab"));
        assert!(ltre_matches(&dfa, b"xyz"));
    }
    
    // Fixed string
    {
        let nfa = ltre_fixed_string("hello");
        let dfa = ltre_compile(nfa);
        assert!(ltre_matches(&dfa, b"hello"));
        assert!(!ltre_matches(&dfa, b"hell"));
    }
    
    // Serialize/deserialize
    {
        let nfa = ltre_parse("a+b").unwrap();
        let dfa = ltre_compile(nfa);
        let buf = dfa_serialize(&dfa);
        let (dfa2, _) = dfa_deserialize(&buf).unwrap();
        assert_eq!(ltre_matches(&dfa, b"ab"), ltre_matches(&dfa2, b"ab"));
        assert_eq!(ltre_matches(&dfa, b"aab"), ltre_matches(&dfa2, b"aab"));
        assert_eq!(ltre_matches(&dfa, b"b"), ltre_matches(&dfa2, b"b"));
    }
    
    // Lazy matching
    {
        let nfa = ltre_parse("a+b").unwrap();
        let mut cache: Option<Dfa> = None;
        assert!(ltre_matches_lazy(&mut cache, &nfa, b"ab"));
        assert!(ltre_matches_lazy(&mut cache, &nfa, b"aab"));
        assert!(!ltre_matches_lazy(&mut cache, &nfa, b"b"));
    }
    
    // Ignorecase
    {
        let mut nfa = ltre_parse("abc").unwrap();
        ltre_ignorecase(&mut nfa).unwrap();
        let dfa = ltre_compile(nfa);
        assert!(ltre_matches(&dfa, b"abc"));
        assert!(ltre_matches(&dfa, b"ABC"));
        assert!(ltre_matches(&dfa, b"AbC"));
    }
    
    // Quantifiers
    test_match("a{3}", "aaa", true);
    test_match("a{3}", "aa", false);
    test_match("a{2,4}", "aa", true);
    test_match("a{2,4}", "aaaa", true);
    test_match("a{2,4}", "a", false);
    test_match("a{2,}", "aa", true);
    test_match("a{2,}", "aaaaa", true);
    test_match("a{2,}", "a", false);
    
    // Empty regex
    test_match("()", "", true);
    test_match("()", "a", false);
    
    // Intersection
    test_match("[a-z]&\\w", "a", true);
    
    // Uncompile
    {
        let nfa = ltre_parse("a+b").unwrap();
        let dfa = ltre_compile(nfa);
        let nfa2 = ltre_uncompile(&dfa);
        let dfa2 = ltre_compile(nfa2);
        assert_eq!(ltre_matches(&dfa, b"ab"), ltre_matches(&dfa2, b"ab"));
        assert_eq!(ltre_matches(&dfa, b"aab"), ltre_matches(&dfa2, b"aab"));
        assert_eq!(ltre_matches(&dfa, b"b"), ltre_matches(&dfa2, b"b"));
    }
    
    // Decompile
    {
        let nfa = ltre_parse("a+b").unwrap();
        let dfa = ltre_compile(nfa);
        let regex_str = ltre_decompile(&dfa);
        // The decompiled regex should be parseable and match the same language
        let nfa2 = ltre_parse(&regex_str).unwrap();
        let dfa2 = ltre_compile(nfa2);
        assert_eq!(ltre_matches(&dfa, b"ab"), ltre_matches(&dfa2, b"ab"));
        assert_eq!(ltre_matches(&dfa, b"aab"), ltre_matches(&dfa2, b"aab"));
        assert_eq!(ltre_matches(&dfa, b"b"), ltre_matches(&dfa2, b"b"));
        assert_eq!(ltre_matches(&dfa, b""), ltre_matches(&dfa2, b""));
    }
    
    // Parse errors
    assert!(ltre_parse("(").is_err());
    assert!(ltre_parse("[").is_err());
    assert!(ltre_parse("*").is_err());
    
    println!("All tests passed!");
}
