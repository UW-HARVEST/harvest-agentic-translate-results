#include "ltre.h"
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

void check(const char *regex, const char *input, int partial, int ignorecase, int complement, int quick) {
    char *error = NULL;
    char *loc = (char*)regex;
    struct nfa nfa = ltre_parse(&loc, &error);
    if (error) {
        printf("PARSE_ERROR /%s/\n", regex);
        return;
    }
    if (partial) ltre_partial(&nfa);
    if (ignorecase) ltre_ignorecase(&nfa);
    if (complement) ltre_complement(&nfa);
    
    struct dstate *dfa = ltre_compile(nfa);
    
    // serialize/deserialize round-trip
    size_t sz = 0;
    uint8_t *buf = dfa_serialize(dfa, &sz);
    printf("SER_SIZE /%s/ %zu\n", regex, sz);
    
    size_t sz2 = 0;
    struct dstate *dfa2 = dfa_deserialize(buf, &sz2);
    printf("DESER_SIZE /%s/ %zu (match=%d)\n", regex, sz2, sz == sz2);
    
    int m1 = ltre_matches(dfa, (uint8_t*)input);
    int m2 = ltre_matches(dfa2, (uint8_t*)input);
    printf("MATCH /%s/ '%s' dfa=%d dfa2=%d\n", regex, input, m1, m2);
    
    if (!quick) {
        char *re = ltre_decompile(dfa);
        printf("DECOMPILE /%s/ -> /%s/\n", regex, re);
        free(re);
    }
    
    dfa_free(dfa);
    dfa_free(dfa2);
    nfa_free(nfa);
    free(buf);
}

int main(void) {
    // Basic tests
    check("abba", "abba", 0, 0, 0, 0);
    check("abba", "abcd", 0, 0, 0, 0);
    check("[ab]+", "abba", 0, 0, 0, 0);
    check(".*", "hello", 0, 0, 0, 0);
    check("a{2}", "aa", 0, 0, 0, 0);
    check("a{2}", "a", 0, 0, 0, 0);
    check("a{2}", "aaa", 0, 0, 0, 0);
    check("", "", 0, 0, 0, 0);
    check("", "\n", 0, 0, 0, 0);
    
    // Fixed string
    printf("\n--- fixed string ---\n");
    {
        struct nfa nfa = ltre_fixed_string("hello");
        struct dstate *dfa = ltre_compile(nfa);
        printf("fixed 'hello' vs 'hello': %d\n", ltre_matches(dfa, (uint8_t*)"hello"));
        printf("fixed 'hello' vs 'world': %d\n", ltre_matches(dfa, (uint8_t*)"world"));
        printf("fixed 'hello' vs '': %d\n", ltre_matches(dfa, (uint8_t*)""));
        dfa_free(dfa);
        nfa_free(nfa);
    }
    {
        struct nfa nfa = ltre_fixed_string("");
        struct dstate *dfa = ltre_compile(nfa);
        printf("fixed '' vs '': %d\n", ltre_matches(dfa, (uint8_t*)""));
        printf("fixed '' vs 'a': %d\n", ltre_matches(dfa, (uint8_t*)"a"));
        dfa_free(dfa);
        nfa_free(nfa);
    }
    
    // Partial
    printf("\n--- partial ---\n");
    check("b", "abc", 1, 0, 0, 0);
    check("ba", "abc", 1, 0, 0, 0);
    
    // Ignorecase
    printf("\n--- ignorecase ---\n");
    check("abCdEF", "aBCdEf", 0, 1, 0, 0);
    
    // Complement
    printf("\n--- complement ---\n");
    check("a", "", 0, 0, 1, 0);
    check("a", "a", 0, 0, 1, 0);
    check("a", "aa", 0, 0, 1, 0);
    
    // DFA size checks
    printf("\n--- dfa sizes ---\n");
    {
        char *error = NULL, *loc;
        loc = "a*";
        struct nfa nfa = ltre_parse(&loc, &error);
        struct dstate *dfa = ltre_compile(nfa);
        int sz = 0;
        for (struct dstate *d = dfa; d; d = d->next) sz++;
        printf("DFA_SIZE /a*/ = %d\n", sz);
        dfa_free(dfa); nfa_free(nfa);
    }
    {
        char *error = NULL, *loc;
        loc = "a|b";
        struct nfa nfa = ltre_parse(&loc, &error);
        struct dstate *dfa = ltre_compile(nfa);
        int sz = 0;
        for (struct dstate *d = dfa; d; d = d->next) sz++;
        printf("DFA_SIZE /a|b/ = %d\n", sz);
        dfa_free(dfa); nfa_free(nfa);
    }
    
    // Lazy matching
    printf("\n--- lazy ---\n");
    {
        char *error = NULL, *loc;
        loc = "ab+";
        struct nfa nfa = ltre_parse(&loc, &error);
        struct dstate *ldfa = NULL;
        printf("lazy /ab+/ 'abb': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)"abb"));
        printf("lazy /ab+/ 'a': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)"a"));
        printf("lazy /ab+/ 'ab': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)"ab"));
        printf("lazy /ab+/ '': %d\n", ltre_matches_lazy(&ldfa, nfa, (uint8_t*)""));
        dfa_free(ldfa); nfa_free(nfa);
    }
    
    return 0;
}
