use rect_pack_h::rect_pack::*;

#[test]
fn test_rect_pack_uniform_paging() {
    let mut rects: Vec<Rect> = (0..100).map(|i| Rect::new(i, i + 1, i + 1)).collect();
    assert!(RectPacker::pack(512, 512, true, &mut rects));
}

#[test]
fn test_rect_pack_one_rect_per_page_paging() {
    let mut rects = vec![
        Rect::new(0, 6, 7),
        Rect::new(1, 8, 7),
        Rect::new(2, 8, 9),
        Rect::new(3, 10, 9),
    ];
    assert!(RectPacker::pack(10, 10, true, &mut rects));
    // After sorting, order changes. Check all packed with unique pages.
    for r in &rects {
        assert!(r.info.packed);
    }
    // Each should be on its own page
    let mut pages: Vec<i32> = rects.iter().map(|r| r.info.page).collect();
    pages.sort();
    assert_eq!(pages, vec![0, 1, 2, 3]);
}

#[test]
fn test_rect_pack_fill() {
    let mut rects: Vec<Rect> = (0..100).map(|i| Rect::new(i, 1, 1)).collect();
    assert!(RectPacker::pack(10, 10, false, &mut rects));
    for r in &rects {
        assert!(r.info.packed);
        assert_eq!(r.info.page, 0);
    }
}

#[test]
fn test_rect_pack_no_paging() {
    let mut rects = vec![
        Rect::new(0, 6, 7),
        Rect::new(1, 8, 7),
        Rect::new(2, 8, 9),
        Rect::new(3, 10, 9),
    ];
    assert!(!RectPacker::pack(10, 10, false, &mut rects));
    // After sorting by max side desc: 10x9 (max=10), 8x9 (max=9), 8x7 (max=8), 6x7 (max=7)
    // The C test checks rects[0].packed=true, rest false — but that's pre-sort indices.
    // After sort: rects[0] is the biggest (10x9), which fits in 10x10. 
    // rects[1] is 8x9, won't fit alongside. etc.
    // The first one should be packed, rest not.
    assert!(rects[0].info.packed);
    assert!(!rects[1].info.packed);
    assert!(!rects[2].info.packed);
    assert!(!rects[3].info.packed);
}

#[test]
fn test_rect_pack_fail_paging() {
    let mut rects = vec![
        Rect::new(0, 900, 900),
        Rect::new(1, 1100, 1100),
    ];
    assert!(!RectPacker::pack(1000, 1000, true, &mut rects));
    // After sort: 1100x1100 first (max=1100), 900x900 second (max=900)
    // 1100x1100 > 1000x1000, so it gets clamped to 1000x1000 root but still won't fit? 
    // Actually the root is min(1100,1000)=1000 x min(1100,1000)=1000
    // rect 1100x1100 needs w<=1000 && h<=1000 which is false. So it won't fit.
    // Then grow: can_grow_down = 1100<=1000 false, can_grow_right = 1100<=1000 false. No grow.
    // So 1100x1100 is NOT packed.
    // Next: 900x900. Root is 1000x1000. 900<=1000 && 900<=1000 -> fits! Packed on page 0.
    // But wait, the root was created for the first rect (1100x1100) which didn't fit.
    // Hmm, contiguous tracking: next starts at 0, first rect (i=0) doesn't pack, contiguous=false, last=0.
    // But i=1 (900x900) does pack. After loop, ctx.last=0, ctx.next stays 0.
    // Next iteration: page 1, next=0, last=0. Only rect 0 (1100x1100). Root = min(1100,1000)x min(1100,1000) = 1000x1000.
    // 1100x1100 still doesn't fit. none_fit=true -> break.
    // Result: 900x900 packed (page 0), 1100x1100 not packed. all_packed = false.
    // After sort: rects[0] = 1100x1100 (id=1), rects[1] = 900x900 (id=0)
    assert!(!rects[0].info.packed); // 1100x1100
    assert!(rects[1].info.packed);  // 900x900
}

#[test]
fn test_empty() {
    let mut rects: Vec<Rect> = vec![];
    assert!(RectPacker::pack(100, 100, false, &mut rects));
}
