#include <stdio.h>
#include <stdint.h>
#include <string.h>
#include "totp.h"

static void to_hex(const uint8_t *a, size_t len, char *buf) {
    for (size_t i=0; i<len; i++) {
        buf[i*2]   = "0123456789abcdef"[a[i] >> 4];
        buf[i*2+1] = "0123456789abcdef"[a[i] & 0xF];
    }
    buf[len*2] = '\0';
}

int main() {
    uint8_t buf[512], hash[20];
    char str[41];

    // pack32 roundtrip
    uint8_t a[4] = {0,0,0,0};
    unpack32(0, a);
    printf("unpack32(0): %02x %02x %02x %02x\n", a[0], a[1], a[2], a[3]);
    printf("pack32([0,0,0,0]): %u\n", pack32(a));

    unpack32(0xFFFFFFFF, a);
    printf("unpack32(0xFFFFFFFF): %02x %02x %02x %02x\n", a[0], a[1], a[2], a[3]);
    printf("pack32([ff,ff,ff,ff]): %u\n", pack32(a));

    // unpack64
    uint8_t b[8];
    unpack64(0, b);
    printf("unpack64(0): %02x %02x %02x %02x %02x %02x %02x %02x\n", b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7]);
    unpack64(0xFFFFFFFFFFFFFFFF, b);
    printf("unpack64(max): %02x %02x %02x %02x %02x %02x %02x %02x\n", b[0],b[1],b[2],b[3],b[4],b[5],b[6],b[7]);

    // rotl
    printf("rotl(1,1): %u\n", rotl(1, 1));
    printf("rotl(0x80000000,1): %u\n", rotl(0x80000000, 1));

    // sha1 empty
    memset(buf, 0, sizeof(buf));
    buf[0] = 0;
    sha1(buf, 0, sizeof(buf), hash);
    to_hex(hash, 20, str);
    printf("sha1(''): %s\n", str);

    // sha1 "abc"
    memset(buf, 0, sizeof(buf));
    snprintf((char*)buf, sizeof(buf), "abc");
    sha1(buf, 3, sizeof(buf), hash);
    to_hex(hash, 20, str);
    printf("sha1('abc'): %s\n", str);

    // sha1 capacity too small
    memset(buf, 0, sizeof(buf));
    int ret = sha1(buf, 0, 0, hash);
    printf("sha1 cap=0: %d\n", ret);

    // hmac_sha1 len > 64
    uint8_t key[64] = {0};
    uint8_t data[65] = {0};
    ret = hmac_sha1(key, data, 65, hash);
    printf("hmac_sha1 len=65: %d\n", ret);

    // hotp with RFC 4226 test vectors (more counters)
    static const uint8_t secret[64] = {
        0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38,
        0x39, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36,
        0x37, 0x38, 0x39, 0x30 };
    for (int i = 0; i < 10; i++) {
        printf("hotp(%d): %d\n", i, hotp(secret, i));
    }

    // totp at specific times
    printf("totp(secret, 0): %d\n", totp(secret, 0));
    printf("totp(secret, 29): %d\n", totp(secret, 29));
    printf("totp(secret, 30): %d\n", totp(secret, 30));
    printf("totp(secret, 59): %d\n", totp(secret, 59));
    printf("totp(secret, 60): %d\n", totp(secret, 60));

    // from_base32 tests
    uint8_t out[64];
    memset(out, 0, sizeof(out));
    size_t n;

    // empty string
    n = from_base32("", out, sizeof(out));
    printf("from_base32(''): %zu\n", n);

    // "MZXW6===" -> "foo"
    n = from_base32("MZXW6===", out, sizeof(out));
    printf("from_base32('MZXW6==='): %zu bytes: ", n);
    for (size_t i=0; i<n; i++) printf("%02x ", out[i]);
    printf("str: %.*s\n", (int)n, out);

    // "MZXW6YQ=" -> "foob"
    n = from_base32("MZXW6YQ=", out, sizeof(out));
    printf("from_base32('MZXW6YQ='): %zu bytes: ", n);
    for (size_t i=0; i<n; i++) printf("%02x ", out[i]);
    printf("str: %.*s\n", (int)n, out);

    // "MZXW6YTB" -> "fooba"
    n = from_base32("MZXW6YTB", out, sizeof(out));
    printf("from_base32('MZXW6YTB'): %zu bytes: ", n);
    for (size_t i=0; i<n; i++) printf("%02x ", out[i]);
    printf("str: %.*s\n", (int)n, out);

    // "MZXW6YTBOI======" -> "foobar"
    n = from_base32("MZXW6YTBOI======", out, sizeof(out));
    printf("from_base32('MZXW6YTBOI======'): %zu bytes: ", n);
    for (size_t i=0; i<n; i++) printf("%02x ", out[i]);
    printf("str: %.*s\n", (int)n, out);

    // invalid: odd length
    n = from_base32("ABC", out, sizeof(out));
    printf("from_base32('ABC'): %zu\n", n);

    // invalid char
    n = from_base32("MZXW6!==", out, sizeof(out));
    printf("from_base32('MZXW6!=='): %zu\n", n);

    // cap too small
    n = from_base32("MZXW6===", out, 2);
    printf("from_base32 cap=2: %zu\n", n);

    // lowercase
    n = from_base32("mzxw6===", out, sizeof(out));
    printf("from_base32('mzxw6==='): %zu bytes: str: %.*s\n", n, (int)n, out);

    // "JBSWY3DPEHPK3PXP" (standard test vector)
    n = from_base32("JBSWY3DPEHPK3PXP", out, sizeof(out));
    printf("from_base32('JBSWY3DPEHPK3PXP'): %zu bytes: ", n);
    for (size_t i=0; i<n; i++) printf("%02x ", out[i]);
    printf("str: %.*s\n", (int)n, out);

    // "ME======" -> "a"
    n = from_base32("ME======", out, sizeof(out));
    printf("from_base32('ME======'): %zu bytes: str: %.*s\n", n, (int)n, out);

    return 0;
}
EOF
