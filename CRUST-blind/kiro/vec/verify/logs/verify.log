#include <stdio.h>
#include "src/vec.h"

int main(void) {
    // Test vec_insert return value
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_insert(&v, 0, 42);
        printf("insert_ret=%d len=%d val=%d\n", r, v.length, v.data[0]);
        vec_deinit(&v);
    }

    // Test vec_splice: splice from middle
    {
        vec_int_t v;
        vec_init(&v);
        for (int i = 0; i < 10; i++) vec_push(&v, i * 10);
        vec_splice(&v, 2, 3); // remove indices 2,3,4 (values 20,30,40)
        printf("splice: len=%d [0]=%d [1]=%d [2]=%d [3]=%d [4]=%d [5]=%d [6]=%d\n",
               v.length, v.data[0], v.data[1], v.data[2], v.data[3], v.data[4], v.data[5], v.data[6]);
        vec_deinit(&v);
    }

    // Test vec_swapsplice
    {
        vec_int_t v;
        vec_init(&v);
        for (int i = 0; i < 10; i++) vec_push(&v, i);
        vec_swapsplice(&v, 0, 3);
        printf("swapsplice: len=%d", v.length);
        for (int i = 0; i < v.length; i++) printf(" [%d]=%d", i, v.data[i]);
        printf("\n");
        vec_deinit(&v);
    }

    // Test vec_reserve_po2
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_reserve_po2_((char**)&v.data, &v.length, &v.capacity, sizeof(int), 5);
        printf("reserve_po2(5): ret=%d cap=%d\n", r, v.capacity);
        vec_deinit(&v);
    }
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_reserve_po2_((char**)&v.data, &v.length, &v.capacity, sizeof(int), 0);
        printf("reserve_po2(0): ret=%d cap=%d\n", r, v.capacity);
        vec_deinit(&v);
    }
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_reserve_po2_((char**)&v.data, &v.length, &v.capacity, sizeof(int), 8);
        printf("reserve_po2(8): ret=%d cap=%d\n", r, v.capacity);
        vec_deinit(&v);
    }
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_reserve_po2_((char**)&v.data, &v.length, &v.capacity, sizeof(int), 1);
        printf("reserve_po2(1): ret=%d cap=%d\n", r, v.capacity);
        vec_deinit(&v);
    }

    // Test vec_expand
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_expand_((char**)&v.data, &v.length, &v.capacity, sizeof(int));
        printf("expand: ret=%d cap=%d\n", r, v.capacity);
        vec_deinit(&v);
    }

    // Test vec_reserve
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_reserve_((char**)&v.data, &v.length, &v.capacity, sizeof(int), 10);
        printf("reserve(10): ret=%d cap=%d\n", r, v.capacity);
        r = vec_reserve_((char**)&v.data, &v.length, &v.capacity, sizeof(int), 5);
        printf("reserve(5): ret=%d cap=%d\n", r, v.capacity);
        vec_deinit(&v);
    }

    // Test vec_compact
    {
        vec_int_t v;
        vec_init(&v);
        int r = vec_compact_((char**)&v.data, &v.length, &v.capacity, sizeof(int));
        printf("compact_empty: ret=%d cap=%d data=%p\n", r, v.capacity, (void*)v.data);
        vec_deinit(&v);
    }
    {
        vec_int_t v;
        vec_init(&v);
        for (int i = 0; i < 100; i++) vec_push(&v, i);
        vec_truncate(&v, 5);
        int r = vec_compact_((char**)&v.data, &v.length, &v.capacity, sizeof(int));
        printf("compact_5: ret=%d len=%d cap=%d\n", r, v.length, v.capacity);
        vec_deinit(&v);
    }

    // Test vec_swap with same index
    {
        vec_int_t v;
        vec_init(&v);
        vec_push(&v, 10);
        vec_push(&v, 20);
        vec_push(&v, 30);
        vec_swap(&v, 1, 1);
        printf("swap_same: [0]=%d [1]=%d [2]=%d\n", v.data[0], v.data[1], v.data[2]);
        vec_swap(&v, 0, 2);
        printf("swap_0_2: [0]=%d [1]=%d [2]=%d\n", v.data[0], v.data[1], v.data[2]);
        vec_deinit(&v);
    }

    // Test VEC_VERSION
    printf("version=%s\n", VEC_VERSION);

    return 0;
}
