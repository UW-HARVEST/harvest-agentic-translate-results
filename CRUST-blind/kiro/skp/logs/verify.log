#include <stdio.h>
#define SKP_MAIN
#include "skp.h"

int main() {
    char *to, *end;
    int alt, len;
    char *from;

    // Basic character classes
    from = "abc";
    alt = skp(from, "a", &to); len = (int)(to-from);
    printf("alpha 'abc' 'a': alt=%d len=%d\n", alt, len);

    alt = skp(from, "*a", &to); len = (int)(to-from);
    printf("alpha 'abc' '*a': alt=%d len=%d\n", alt, len);

    alt = skp(from, "+a", &to); len = (int)(to-from);
    printf("alpha 'abc' '+a': alt=%d len=%d\n", alt, len);

    from = "123";
    alt = skp(from, "d", &to); len = (int)(to-from);
    printf("digit '123' 'd': alt=%d len=%d\n", alt, len);

    alt = skp(from, "*d", &to); len = (int)(to-from);
    printf("digit '123' '*d': alt=%d len=%d\n", alt, len);

    from = "ABC";
    alt = skp(from, "u", &to); len = (int)(to-from);
    printf("upper 'ABC' 'u': alt=%d len=%d\n", alt, len);

    alt = skp(from, "*u", &to); len = (int)(to-from);
    printf("upper 'ABC' '*u': alt=%d len=%d\n", alt, len);

    from = "abc";
    alt = skp(from, "l", &to); len = (int)(to-from);
    printf("lower 'abc' 'l': alt=%d len=%d\n", alt, len);

    alt = skp(from, "*l", &to); len = (int)(to-from);
    printf("lower 'abc' '*l': alt=%d len=%d\n", alt, len);

    // Hex digits
    from = "0xFF";
    alt = skp(from, "X", &to); len = (int)(to-from);
    printf("hex '0xFF' 'X': alt=%d len=%d\n", alt, len);

    from = "FF";
    alt = skp(from, "*x", &to); len = (int)(to-from);
    printf("xdigit 'FF' '*x': alt=%d len=%d\n", alt, len);

    // Whitespace
    from = "  abc";
    alt = skp(from, "*w", &to); len = (int)(to-from);
    printf("blank '  abc' '*w': alt=%d len=%d\n", alt, len);

    from = " \t\nabc";
    alt = skp(from, "*s", &to); len = (int)(to-from);
    printf("space ' \\t\\nabc' '*s': alt=%d len=%d\n", alt, len);

    // Identifier
    from = "_foo123 bar";
    alt = skp(from, "I", &to); len = (int)(to-from);
    printf("ident '_foo123 bar' 'I': alt=%d len=%d\n", alt, len);

    from = "123foo";
    alt = skp(from, "I", &to); len = (int)(to-from);
    printf("ident '123foo' 'I': alt=%d len=%d\n", alt, len);

    // Balanced
    from = "(abc)rest";
    alt = skp(from, "B", &to); len = (int)(to-from);
    printf("balanced '(abc)rest' 'B': alt=%d len=%d\n", alt, len);

    from = "[a[b]c]rest";
    alt = skp(from, "B", &to); len = (int)(to-from);
    printf("balanced '[a[b]c]rest' 'B': alt=%d len=%d\n", alt, len);

    from = "{abc";
    alt = skp(from, "B", &to); len = (int)(to-from);
    printf("balanced '{abc' 'B': alt=%d len=%d\n", alt, len);

    // Quoted
    from = "\"hello\\\"world\"rest";
    alt = skp(from, "Q", &to); len = (int)(to-from);
    printf("quoted '\"hello\\\"world\"rest' 'Q': alt=%d len=%d\n", alt, len);

    from = "'abc'rest";
    alt = skp(from, "Q", &to); len = (int)(to-from);
    printf("quoted '\\'abc\\'rest' 'Q': alt=%d len=%d\n", alt, len);

    // Newline
    from = "abc\ndef";
    alt = skp(from, "N", &to); len = (int)(to-from);
    printf("newline 'abc\\ndef' 'N': alt=%d len=%d\n", alt, len);

    // Integer
    from = "-42rest";
    alt = skp(from, "D", &to); len = (int)(to-from);
    printf("int '-42rest' 'D': alt=%d len=%d\n", alt, len);

    from = "+7rest";
    alt = skp(from, "D", &to); len = (int)(to-from);
    printf("int '+7rest' 'D': alt=%d len=%d\n", alt, len);

    // Float
    from = "3.14rest";
    alt = skp(from, "F", &to); len = (int)(to-from);
    printf("float '3.14rest' 'F': alt=%d len=%d\n", alt, len);

    from = "1.5e10rest";
    alt = skp(from, "F", &to); len = (int)(to-from);
    printf("float '1.5e10rest' 'F': alt=%d len=%d\n", alt, len);

    // Negation
    from = "abc";
    alt = skp(from, "!d", &to); len = (int)(to-from);
    printf("not digit 'abc' '!d': alt=%d len=%d\n", alt, len);

    from = "123";
    alt = skp(from, "!d", &to); len = (int)(to-from);
    printf("not digit '123' '!d': alt=%d len=%d\n", alt, len);

    // Any char
    from = "abc";
    alt = skp(from, ".", &to); len = (int)(to-from);
    printf("any 'abc' '.': alt=%d len=%d\n", alt, len);

    alt = skp(from, "*.", &to); len = (int)(to-from);
    printf("any 'abc' '*.': alt=%d len=%d\n", alt, len);

    // End of text
    from = "";
    alt = skp(from, "!.", &to); len = (int)(to-from);
    printf("eot '' '!.': alt=%d len=%d\n", alt, len);

    // Set
    from = "abc";
    alt = skp(from, "[abc]", &to); len = (int)(to-from);
    printf("set 'abc' '[abc]': alt=%d len=%d\n", alt, len);

    alt = skp(from, "*[abc]", &to); len = (int)(to-from);
    printf("set 'abc' '*[abc]': alt=%d len=%d\n", alt, len);

    from = "xyz";
    alt = skp(from, "[abc]", &to); len = (int)(to-from);
    printf("set 'xyz' '[abc]': alt=%d len=%d\n", alt, len);

    // Range in set
    from = "c";
    alt = skp(from, "[a-z]", &to); len = (int)(to-from);
    printf("set range 'c' '[a-z]': alt=%d len=%d\n", alt, len);

    // Goal
    from = "abc123";
    alt = skp(from, "*a &*d", &to); len = (int)(to-from);
    printf("goal 'abc123' '*a &*d': alt=%d len=%d\n", alt, len);

    // Skip to
    from = "xxxABC";
    alt = skp(from, ">*u", &to, &end); len = (int)(end-to);
    printf("skipto 'xxxABC' '>*u': alt=%d to_offset=%d len=%d\n", alt, (int)(to-from), len);

    // Alnum
    from = "a1b2";
    alt = skp(from, "*@", &to); len = (int)(to-from);
    printf("alnum 'a1b2' '*@': alt=%d len=%d\n", alt, len);

    // Control
    from = "\x01\x02abc";
    alt = skp(from, "*c", &to); len = (int)(to-from);
    printf("ctrl '\\x01\\x02abc' '*c': alt=%d len=%d\n", alt, len);

    // idchr
    from = "_a1";
    alt = skp(from, "*i", &to); len = (int)(to-from);
    printf("idchr '_a1' '*i': alt=%d len=%d\n", alt, len);

    // () balanced
    from = "(abc)rest";
    alt = skp(from, "()", &to); len = (int)(to-from);
    printf("parens '(abc)rest' '()': alt=%d len=%d\n", alt, len);

    from = "[abc]rest";
    alt = skp(from, "()", &to); len = (int)(to-from);
    printf("parens '[abc]rest' '()': alt=%d len=%d\n", alt, len);

    // Case insensitive
    from = "abCD";
    alt = skp(from, "!C 'abcd'", &to); len = (int)(to-from);
    printf("case insensitive 'abCD' '!C abcd': alt=%d len=%d\n", alt, len);

    // S and W (skip spaces)
    from = "  abc";
    alt = skp(from, "W *a", &to); len = (int)(to-from);
    printf("W skip '  abc' 'W *a': alt=%d len=%d\n", alt, len);

    from = " \n abc";
    alt = skp(from, "S *a", &to); len = (int)(to-from);
    printf("S skip ' \\n abc' 'S *a': alt=%d len=%d\n", alt, len);

    // $ end of line
    from = "";
    alt = skp(from, "$", &to); len = (int)(to-from);
    printf("eol '' '$': alt=%d len=%d\n", alt, len);

    from = "\n";
    alt = skp(from, "$", &to); len = (int)(to-from);
    printf("eol '\\n' '$': alt=%d len=%d\n", alt, len);

    return 0;
}
