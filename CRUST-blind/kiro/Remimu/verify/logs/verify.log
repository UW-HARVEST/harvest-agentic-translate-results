#include "my_regex.h"
#include <stdlib.h>

void test_parse_and_match(const char* pattern, const char* text, int flags, int cap_slots) {
    RegexToken tokens[256];
    int16_t token_count = 256;
    int e = regex_parse(pattern, tokens, &token_count, flags);
    printf("PARSE: pattern=`%s` result=%d token_count=%d\n", pattern, e, token_count);
    if (e != 0) return;
    
    int64_t cap_pos[16];
    int64_t cap_span[16];
    memset(cap_pos, 0xFF, sizeof(cap_pos));
    memset(cap_span, 0xFF, sizeof(cap_span));
    
    int64_t match_len = regex_match(tokens, text, 0, cap_slots, cap_pos, cap_span);
    printf("MATCH: text=`%s` result=%zd\n", text, match_len);
    if (cap_slots > 0 && match_len >= 0) {
        for (int i = 0; i < cap_slots; i++)
            printf("  CAP[%d]: pos=%zd span=%zd\n", i, cap_pos[i], cap_span[i]);
    }
}

int main(void) {
    // Basic literal match
    test_parse_and_match("[0-9]+\\.[0-9]+", "23.53) ", 0, 0);
    test_parse_and_match("[0-9]+\\.[0-9]+", "abc", 0, 0);
    
    // Captures
    test_parse_and_match("((a)|(b))++", "aaaaaabbbabaqa", 0, 5);
    test_parse_and_match("((a)|(b))+", "aaaaaabbbabaqa", 0, 5);
    test_parse_and_match("((a)|(b))*", "aaaaaabbbabaqa", 0, 5);
    
    // Anchors
    test_parse_and_match("^asdf$", "asdf", 0, 0);
    test_parse_and_match("^asdf$", "asdfg", 0, 0);
    test_parse_and_match("^asdf", "asdf", 0, 0);
    test_parse_and_match("asdf$", "asdf", 0, 0);
    
    // Alternation
    test_parse_and_match("(a|ab)*b", "aab", 0, 1);
    test_parse_and_match("(a|ab)*b", "aaaaaababab", 0, 1);
    
    // Quantifiers
    test_parse_and_match("a{3}", "aaaa", 0, 0);
    test_parse_and_match("a{3,5}", "aaaa", 0, 0);
    test_parse_and_match("a{3,5}", "aaaaaa", 0, 0);
    test_parse_and_match("a{3,}", "aaaaaa", 0, 0);
    
    // Lazy
    test_parse_and_match("a*?", "aaa", 0, 0);
    test_parse_and_match("a+?", "aaa", 0, 0);
    test_parse_and_match("a??", "aaa", 0, 0);
    
    // Dot
    test_parse_and_match(".", "a", 0, 0);
    test_parse_and_match(".", "\n", 0, 0);
    test_parse_and_match(".", "\n", REMIMU_FLAG_DOT_NO_NEWLINES, 0);
    
    // Character classes
    test_parse_and_match("[abc]", "b", 0, 0);
    test_parse_and_match("[^abc]", "d", 0, 0);
    test_parse_and_match("[^abc]", "a", 0, 0);
    test_parse_and_match("[a-z]", "m", 0, 0);
    
    // Shorthand classes
    test_parse_and_match("\\d+", "12345abc", 0, 0);
    test_parse_and_match("\\w+", "hello world", 0, 0);
    test_parse_and_match("\\s+", "   abc", 0, 0);
    test_parse_and_match("\\D+", "abc123", 0, 0);
    
    // Word boundary
    test_parse_and_match("asdf\\b", "asdf ", 0, 0);
    test_parse_and_match("asdf\\b", "asdfg", 0, 0);
    test_parse_and_match("\\basdf", "asdf", 0, 0);
    test_parse_and_match("\\basdf", "Xasdf", 0, 0);
    
    // Empty pattern
    test_parse_and_match("", "anything", 0, 0);
    
    // Non-capturing group
    test_parse_and_match("(?:abc)+", "abcabc", 0, 0);
    
    // Possessive
    test_parse_and_match("a++ab", "aaab", 0, 0);
    test_parse_and_match("(b|a|)*+", "aaaaaababab", 0, 1);
    
    // Error cases
    {
        RegexToken tokens[256];
        int16_t tc = 256;
        printf("PARSE_ERR: unbalanced_open=%d\n", regex_parse("(abc", tokens, &tc, 0));
        tc = 256;
        printf("PARSE_ERR: unbalanced_close=%d\n", regex_parse("abc)", tokens, &tc, 0));
        tc = 256;
        printf("PARSE_ERR: bad_quantifier=%d\n", regex_parse("*abc", tokens, &tc, 0));
        tc = 256;
        printf("PARSE_ERR: bad_escape=%d\n", regex_parse("\\z", tokens, &tc, 0));
        tc = 256;
        printf("PARSE_ERR: open_class=%d\n", regex_parse("[abc", tokens, &tc, 0));
        tc = 256;
        printf("PARSE_ERR: trailing_backslash=%d\n", regex_parse("abc\\", tokens, &tc, 0));
    }
    
    // start_i test
    {
        RegexToken tokens[256];
        int16_t tc = 256;
        regex_parse("[0-9]+", tokens, &tc, 0);
        int64_t r = regex_match(tokens, "abc123def", 3, 0, 0, 0);
        printf("START_I: result=%zd\n", r);
    }
    
    // More complex patterns from the test suite
    test_parse_and_match("(b|a|as|q)*X", "asqbX", 0, 1);
    test_parse_and_match("(b|a|as|q)*?X", "asqbX", 0, 1);
    test_parse_and_match("(b|a|as|q)+X", "asqbX", 0, 1);
    
    // Greedy vs lazy group
    test_parse_and_match("(a?)*a{10}", "aaaaaaaaaa", 0, 1);
    test_parse_and_match("(a?)*?a{10}", "aaaaaaaaaa", 0, 1);
    
    // Empty group
    test_parse_and_match("()", "aa", 0, 1);
    test_parse_and_match("a()a", "aa", 0, 1);
    
    // Complex email-like
    test_parse_and_match("(?:\\w+(?:\\.\\w+)*)@(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)", "testacc@example.com", 0, 0);
    
    // Dot-no-newlines flag
    test_parse_and_match(".", "\r", REMIMU_FLAG_DOT_NO_NEWLINES, 0);
    test_parse_and_match(".", "a", REMIMU_FLAG_DOT_NO_NEWLINES, 0);
    
    // Buffer too small
    {
        RegexToken tokens[2];
        int16_t tc = 2;
        int e = regex_parse("[0-9]+\\.[0-9]+", tokens, &tc, 0);
        printf("SMALL_BUFFER: result=%d\n", e);
    }
    
    // More match tests
    test_parse_and_match("(ab?)*b", "abba) ", 0, 1);
    test_parse_and_match("(ab?)*?b", "abba) ", 0, 1);
    test_parse_and_match("(ab?)b", "abc) ", 0, 1);
    
    // Escaped chars in char class
    test_parse_and_match("[\\t\\n]", "\t", 0, 0);
    test_parse_and_match("[\\t\\n]", "\n", 0, 0);
    test_parse_and_match("[\\t\\n]", "a", 0, 0);
    
    return 0;
}
