#include "my_regex.h"

int main(void) {
    // DOT_NO_NEWLINES: the C code XORs bits for \n and \r
    // Let's check what the mask looks like
    RegexToken tokens[256];
    int16_t tc = 256;
    
    // Without flag
    regex_parse(".", tokens, &tc, 0);
    printf("Without flag, mask[0]=%04x mask[1]=%04x\n", tokens[1].mask[0], tokens[1].mask[1]);
    int64_t r = regex_match(tokens, "\n", 0, 0, 0, 0);
    printf("dot vs \\n (no flag): %zd\n", r);
    r = regex_match(tokens, "\r", 0, 0, 0, 0);
    printf("dot vs \\r (no flag): %zd\n", r);
    
    // With flag
    tc = 256;
    regex_parse(".", tokens, &tc, REMIMU_FLAG_DOT_NO_NEWLINES);
    printf("With flag, mask[0]=%04x mask[1]=%04x\n", tokens[1].mask[0], tokens[1].mask[1]);
    r = regex_match(tokens, "\n", 0, 0, 0, 0);
    printf("dot vs \\n (with flag): %zd\n", r);
    r = regex_match(tokens, "\r", 0, 0, 0, 0);
    printf("dot vs \\r (with flag): %zd\n", r);
    r = regex_match(tokens, "a", 0, 0, 0, 0);
    printf("dot vs a (with flag): %zd\n", r);
    
    // \n is 0x0A = 10, so mask[0] bit 10 = mask[0] & 0x0400
    // \r is 0x0D = 13, so mask[0] bit 13 = mask[0] & 0x2000
    // Wait, the mask is indexed by byte>>4, so \n (0x0A) -> mask[0] bit 10
    // \r (0x0D) -> mask[0] bit 13
    // But the code does mask[1] ^= 0x04 for \n and mask[1] ^= 0x20 for \r
    // \n = 0x0A, byte>>4 = 0, byte&0xF = 0xA = 10, so mask[0] bit 10
    // But the C code does mask[1] ^= 0x04... that's mask[1] bit 2
    // That would be byte 0x12 = 18, not \n!
    // This looks like a bug in the C code where DOT_NO_NEWLINES doesn't actually work
    
    printf("\n\\n = %d, >>4 = %d, &0xF = %d\n", '\n', '\n'>>4, '\n'&0xF);
    printf("\\r = %d, >>4 = %d, &0xF = %d\n", '\r', '\r'>>4, '\r'&0xF);
    
    return 0;
}
