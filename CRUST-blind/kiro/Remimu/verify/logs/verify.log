#include "my_regex.h"
#include <stdlib.h>

void test(const char* pattern, const char* text, int flags, int cap_slots) {
    RegexToken tokens[256];
    int16_t token_count = 256;
    int e = regex_parse(pattern, tokens, &token_count, flags);
    if (e != 0) { printf("PARSE_ERR: pattern=`%s` result=%d\n", pattern, e); return; }
    
    int64_t cap_pos[16];
    int64_t cap_span[16];
    memset(cap_pos, 0xFF, sizeof(cap_pos));
    memset(cap_span, 0xFF, sizeof(cap_span));
    
    int64_t match_len = regex_match(tokens, text, 0, cap_slots, cap_pos, cap_span);
    printf("pattern=`%s` text=`%s` match=%zd", pattern, text, match_len);
    if (cap_slots > 0 && match_len >= 0) {
        for (int i = 0; i < cap_slots; i++)
            printf(" cap[%d]=(%zd,%zd)", i, cap_pos[i], cap_span[i]);
    }
    printf("\n");
}

int main(void) {
    // DOT_NO_NEWLINES flag
    test(".", "\n", REMIMU_FLAG_DOT_NO_NEWLINES, 0);
    test(".", "\r", REMIMU_FLAG_DOT_NO_NEWLINES, 0);
    test(".", "a", REMIMU_FLAG_DOT_NO_NEWLINES, 0);
    test(".", "\n", 0, 0);
    test(".", "\r", 0, 0);
    
    // The C code has a bug in hex escape: reads pattern[i+1] twice
    // So \t in char class uses the escape char approach, not hex
    // Let's test actual \t and \n matching
    test("\\t", "\t", 0, 0);
    test("\\n", "\n", 0, 0);
    test("\\r", "\r", 0, 0);
    
    // Greedy vs lazy vs possessive normal tokens
    test("a*", "aaa", 0, 0);
    test("a*?", "aaa", 0, 0);
    test("a++", "aaa", 0, 0);
    
    // Complex group patterns
    test("(a|)*b", "b", 0, 1);
    test("(a|)*b", "aab", 0, 1);
    test("(z?)*a{10}", "aaaaaaaaaa", 0, 1);
    
    // Alternation edge cases
    test("(a|a|ab)bc", "abbc) ", 0, 1);
    test("(ab|ab|a)bc", "abbc) ", 0, 1);
    
    // Shorthand in char class
    test("[\\d]+", "123abc", 0, 0);
    test("[\\w]+", "hello world", 0, 0);
    
    // Nested groups
    test("((a)|((b)q))*", "aabqaaaaba", 0, 5);
    
    // start_i
    {
        RegexToken tokens[256];
        int16_t tc = 256;
        regex_parse("\\w+", tokens, &tc, 0);
        int64_t r = regex_match(tokens, "   hello", 3, 0, 0, 0);
        printf("start_i=3 match=%zd\n", r);
    }
    
    // Lazy quantified groups
    test("(b|a|as|q|)*?X", "asqbX", 0, 1);
    test("(b|a|as|q|)+?X", "asqbX", 0, 1);
    
    // Non-capturing group with quantifier
    test("(?:ab)+c", "ababc", 0, 0);
    
    // Atomic group
    test("(?>(a|b)*)c", "aabc", 0, 0);
    test("(?>(a|b)*)c", "aac", 0, 0);
    
    // Escaped special chars
    test("\\.", ".", 0, 0);
    test("\\.", "a", 0, 0);
    test("\\*", "*", 0, 0);
    
    // Char class with dash at end
    test("[a-]", "a", 0, 0);
    test("[a-]", "-", 0, 0);
    test("[a-]", "b", 0, 0);
    
    // Multiple alternations
    test("a|b|c", "a", 0, 0);
    test("a|b|c", "b", 0, 0);
    test("a|b|c", "c", 0, 0);
    test("a|b|c", "d", 0, 0);
    
    // Quantifier ranges
    test("[0-9]{3,5}\\.[0-9]+", "12345.67", 0, 0);
    test("[0-9]{3,5}?\\.[0-9]+", "12345.67", 0, 0);
    
    // Dollar anchor
    test(".*asdf$", "XXXasdf", 0, 0);
    test(".*asdf$", "asdfXXX", 0, 0);
    
    // Regex match returning -1 (no match)
    test("xyz", "abc", 0, 0);
    
    // Empty string match
    test("a*", "", 0, 0);
    test("", "", 0, 0);
    
    return 0;
}
