#include "src/aes.h"

int main() {
    uint8_t key[16] = {0x2B,0x7E,0x15,0x16,0x28,0xAE,0xD2,0xA6,0xAB,0xF7,0x15,0x88,0x09,0xCF,0x4F,0x3C};
    uint8_t w[176];
    
    // Trace the C expansion step by step
    int i;
    __m128i temp;
    uint8_t temp_bytes[16] = {0};
    memset(w, 0, 176);
    
    // Initial copy: the C code copies 16 bytes at a time with SIMD
    // for i=0, it loads Key[0..15] and stores to w[0], w[4], w[8], w[12]
    // But _mm_storeu_si128 stores 16 bytes, so w[0..15], w[4..19], w[8..23], w[12..27]
    // This overwrites! The last store w[12..27] writes key[0..15] to positions 12-27
    // But wait, the loop only runs once since Nk*4=16, i starts at 0, i+=16
    for (i = 0; i < Nk * 4; i += 16) {
        temp = _mm_loadu_si128((__m128i*)&key[i]);
        // This stores 16 bytes starting at w[i], w[i+4], w[i+8], w[i+12]
        _mm_storeu_si128((__m128i*)&w[i], temp);      // w[0..15] = key[0..15]
        _mm_storeu_si128((__m128i*)&w[i + 4], temp);   // w[4..19] = key[0..15]
        _mm_storeu_si128((__m128i*)&w[i + 8], temp);   // w[8..23] = key[0..15]
        _mm_storeu_si128((__m128i*)&w[i + 12], temp);  // w[12..27] = key[0..15]
    }
    
    printf("After init copy:\n");
    for (int k = 0; k < 32; k++) printf("w[%d]=0x%02X ", k, w[k]);
    printf("\n\n");
    
    // Now the main loop with i starting at Nk=4 (word index), stepping by 4
    i = Nk; // i=4
    while (i < Nb * (Nr + 1)) { // i < 44
        // Load 16 bytes from w[4*(i-1)] = w[12]
        temp = _mm_loadu_si128((__m128i*)&w[4 * (i - 1)]);
        printf("i=%d: load w[%d..%d]\n", i, 4*(i-1), 4*(i-1)+15);
        
        if (i % Nk == 0) { // always true for AES-128 since i steps by 4
            // _MM_SHUFFLE(3,0,1,2) on 32-bit lanes
            temp = _mm_shuffle_epi32(temp, _MM_SHUFFLE(3, 0, 1, 2));
            _mm_storeu_si128((__m128i*)temp_bytes, temp);
            printf("  After shuffle: ");
            for (int k = 0; k < 16; k++) printf("%02X ", temp_bytes[k]);
            printf("\n");
            
            // SubBytes only first 4 bytes
            for (int j = 0; j < 4; j++) {
                temp_bytes[j] = sbox[temp_bytes[j]];
            }
            temp_bytes[0] ^= Rcon[i / Nk];
            printf("  After sub+rcon: ");
            for (int k = 0; k < 16; k++) printf("%02X ", temp_bytes[k]);
            printf("\n");
            
            temp = _mm_loadu_si128((__m128i*)temp_bytes);
        }
        
        __m128i w_i_Nk = _mm_loadu_si128((__m128i*)&w[4 * (i - Nk)]);
        printf("  XOR with w[%d..%d]: ", 4*(i-Nk), 4*(i-Nk)+15);
        uint8_t xor_src[16];
        _mm_storeu_si128((__m128i*)xor_src, w_i_Nk);
        for (int k = 0; k < 16; k++) printf("%02X ", xor_src[k]);
        printf("\n");
        
        temp = _mm_xor_si128(temp, w_i_Nk);
        _mm_storeu_si128((__m128i*)&w[4 * i], temp);
        
        printf("  Result w[%d..%d]: ", 4*i, 4*i+15);
        for (int k = 4*i; k < 4*i+16; k++) printf("%02X ", w[k]);
        printf("\n\n");
        
        i += 4;
    }
    
    printf("Final expanded key:\n");
    for (int k = 0; k < 176; k++) printf("0x%02X,", w[k]);
    printf("\n");
    
    return 0;
}
