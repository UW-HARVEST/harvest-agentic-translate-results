#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include "btree.h"

int main() {
    // Test calc_key_hash with various inputs
    printf("=== HASH VALUES ===\n");
    
    // Note: C sizeof("entry_1") includes null terminator = 8 bytes
    printf("hash(\"entry_1\", %zu) = %u\n", sizeof("entry_1"), calc_key_hash("entry_1", sizeof("entry_1")));
    printf("hash(\"entry_2\", %zu) = %u\n", sizeof("entry_2"), calc_key_hash("entry_2", sizeof("entry_2")));
    printf("hash(\"entry_3\", %zu) = %u\n", sizeof("entry_3"), calc_key_hash("entry_3", sizeof("entry_3")));
    printf("hash(\"entry_4\", %zu) = %u\n", sizeof("entry_4"), calc_key_hash("entry_4", sizeof("entry_4")));
    printf("hash(\"entry_5\", %zu) = %u\n", sizeof("entry_5"), calc_key_hash("entry_5", sizeof("entry_5")));
    printf("hash(\"key_1\", %zu) = %u\n", sizeof("key_1"), calc_key_hash("key_1", sizeof("key_1")));
    
    // Empty key
    printf("hash(\"\", 0) = %u\n", calc_key_hash("", 0));
    printf("hash(\"a\", 1) = %u\n", calc_key_hash("a", 1));
    printf("hash(\"ab\", 2) = %u\n", calc_key_hash("ab", 2));
    printf("hash(\"abc\", 3) = %u\n", calc_key_hash("abc", 3));
    
    // Binary keys
    uint32_t int_key = 1;
    printf("hash(uint32:1, %zu) = %u\n", sizeof(int_key), calc_key_hash(&int_key, sizeof(int_key)));
    uint64_t long_key = 10;
    printf("hash(uint64:10, %zu) = %u\n", sizeof(long_key), calc_key_hash(&long_key, sizeof(long_key)));
    uint8_t byte_key = 9;
    printf("hash(uint8:9, %zu) = %u\n", sizeof(byte_key), calc_key_hash(&byte_key, sizeof(byte_key)));
    
    // Struct key
    struct { uint32_t k1; uint32_t k2; } struct_key = {1, 2};
    printf("hash(struct{1,2}, %zu) = %u\n", sizeof(struct_key), calc_key_hash(&struct_key, sizeof(struct_key)));
    
    // Key longer than BTREE_KEY_SIZE (10)
    printf("hash(\"12345678901234\", 14) = %u\n", calc_key_hash("12345678901234", 14));
    // But new_node truncates to 10, so the effective hash:
    printf("hash(\"1234567890\", 10) = %u\n", calc_key_hash("1234567890", 10));
    
    printf("\n=== ENTRY LIST ORDERING ===\n");
    btree_t* btree = new_btree();
    add_entry(btree, "entry_1", sizeof("entry_1"), "value_1", sizeof("value_1"));
    add_entry(btree, "entry_2", sizeof("entry_2"), "value_2", sizeof("value_2"));
    add_entry(btree, "entry_3", sizeof("entry_3"), "value_3", sizeof("value_3"));
    add_entry(btree, "entry_4", sizeof("entry_4"), "value_4", sizeof("value_4"));
    add_entry(btree, "entry_5", sizeof("entry_5"), "value_5", sizeof("value_5"));
    
    entry_list_t* list = list_entries(btree);
    printf("list len=%zu cap=%zu\n", list->len, list->cap);
    for (size_t i = 0; i < list->len; i++) {
        printf("  [%zu] key=%.*s (len=%zu) value=%.*s (len=%zu)\n", i,
            (int)list->entries[i].key.len, list->entries[i].key.key, list->entries[i].key.len,
            (int)list->entries[i].value.len, list->entries[i].value.value, list->entries[i].value.len);
    }
    
    printf("\n=== ENTRY COUNT ===\n");
    printf("count = %zu\n", get_entry_count(btree));
    
    printf("\n=== AFTER REMOVE entry_3 ===\n");
    remove_entry(btree, "entry_3", sizeof("entry_3"));
    printf("count = %zu\n", get_entry_count(btree));
    entry_list_t* list2 = list_entries(btree);
    for (size_t i = 0; i < list2->len; i++) {
        printf("  [%zu] key=%.*s (len=%zu) value=%.*s (len=%zu)\n", i,
            (int)list2->entries[i].key.len, list2->entries[i].key.key, list2->entries[i].key.len,
            (int)list2->entries[i].value.len, list2->entries[i].value.value, list2->entries[i].value.len);
    }
    
    printf("\n=== UPDATE EXISTING KEY ===\n");
    free_tree(&btree);
    btree = new_btree();
    add_entry(btree, "key_1", sizeof("key_1"), "old_val", sizeof("old_val"));
    add_entry(btree, "key_1", sizeof("key_1"), "new_val", sizeof("new_val"));
    printf("count = %zu\n", get_entry_count(btree));
    value_t* v = find_entry(btree, "key_1", sizeof("key_1"));
    printf("value = %.*s\n", (int)v->len, v->value);
    
    printf("\n=== FIND NON-EXISTENT ===\n");
    value_t* nv = find_entry(btree, "no_key", sizeof("no_key"));
    printf("find non-existent = %s\n", nv == NULL ? "NULL" : "FOUND");
    
    printf("\n=== EMPTY TREE ===\n");
    free_tree(&btree);
    btree = new_btree();
    printf("empty count = %zu\n", get_entry_count(btree));
    entry_list_t* elist = list_entries(btree);
    printf("empty list len = %zu\n", elist->len);
    value_t* ev = find_entry(btree, "x", 1);
    printf("find in empty = %s\n", ev == NULL ? "NULL" : "FOUND");
    
    printf("\n=== REMOVE FROM EMPTY ===\n");
    remove_entry(btree, "x", 1);
    printf("count after remove from empty = %zu\n", get_entry_count(btree));
    
    printf("\n=== REMOVE NON-EXISTENT ===\n");
    add_entry(btree, "a", 1, "va", 2);
    remove_entry(btree, "b", 1);
    printf("count after remove non-existent = %zu\n", get_entry_count(btree));
    
    free_tree(&btree);
    free_entry_list(&list);
    free_entry_list(&list2);
    free_entry_list(&elist);
    
    printf("\nDone.\n");
    return 0;
}
EOF
