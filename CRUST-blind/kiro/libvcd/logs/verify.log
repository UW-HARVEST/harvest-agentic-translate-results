#include <stdio.h>
#include "vcd.h"

// Replicate the static function
int get_signal_index_test(const char *string) {
    int id = *string - '!';
    if (id >= VCD_SIGNAL_COUNT)
        return -1;
    return id;
}

int main() {
    printf("!=%d\n", get_signal_index_test("!"));
    printf("\"=%d\n", get_signal_index_test("\""));
    printf("#=%d\n", get_signal_index_test("#"));
    printf("A=%d\n", get_signal_index_test("A"));
    // '!' is 33, VCD_SIGNAL_COUNT is 32, so max valid is '!' + 31 = '@' (64)
    printf("@=%d\n", get_signal_index_test("@"));  // 31
    printf("A=%d\n", get_signal_index_test("A"));  // 32 -> -1
    return 0;
}
EOF
