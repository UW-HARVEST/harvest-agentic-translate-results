#include <stdio.h>
#include <stdlib.h>
#include "vcd.h"

int main(int argc, char *argv[]) {
    vcd_t *vcd = vcd_read_from_path(argv[1]);
    if (vcd == NULL) {
        fprintf(stderr, "Could not read the VCD\n");
        return 1;
    }

    printf("date=[%s]\n", vcd->date);
    printf("version=[%s]\n", vcd->version);
    printf("timescale.scale=%zu\n", vcd->timescale.scale);
    printf("timescale.unit=[%s]\n", vcd->timescale.unit);
    printf("signals_count=%zu\n", vcd->signals_count);
    for (int i = 0; i < vcd->signals_count; ++i) {
        printf("signal[%d].name=[%s]\n", i, vcd->signals[i].name);
        printf("signal[%d].size=%zu\n", i, vcd->signals[i].size);
        printf("signal[%d].changes_count=%zu\n", i, vcd->signals[i].changes_count);
        for (int j = 0; j < vcd->signals[i].changes_count; ++j) {
            printf("  change[%d].timestamp=%u\n", j, vcd->signals[i].value_changes[j].timestamp);
            printf("  change[%d].value=[%s]\n", j, vcd->signals[i].value_changes[j].value);
        }
    }
    free(vcd);
    return 0;
}
EOF
