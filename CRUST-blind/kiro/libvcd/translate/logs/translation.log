cat > /tmp/harvest-crust-hPZ3W7/project/tests/integration.rs << 'EOF'
use libvcd::vcd::*;

#[test]
fn test_read_vcd() {
    let vcd = VCD::read_from_path("c_src/test/assets/ram.vcd").expect("Failed to read VCD");
    
    let date_len = vcd.date.iter().position(|&b| b == 0).unwrap_or(vcd.date.len());
    let date = std::str::from_utf8(&vcd.date[..date_len]).unwrap();
    println!("date: '{}'", date);
    assert!(date.contains("Fri Jul 15"));
    
    let ver_len = vcd.version.iter().position(|&b| b == 0).unwrap_or(vcd.version.len());
    let version = std::str::from_utf8(&vcd.version[..ver_len]).unwrap();
    println!("version: '{}'", version);
    assert!(version.contains("Icarus Verilog"));
    
    assert_eq!(vcd.timescale.scale, 1);
    let unit_len = vcd.timescale.unit.iter().position(|&b| b == 0).unwrap_or(vcd.timescale.unit.len());
    let unit = std::str::from_utf8(&vcd.timescale.unit[..unit_len]).unwrap();
    println!("unit: '{}'", unit);
    assert!(unit.contains("s"));
    
    // Should have 7 signals from top module (!, ", #, $, %, &, ')
    println!("signals_count: {}", vcd.signals.len());
    for (i, sig) in vcd.signals.iter().enumerate() {
        let name_len = sig.name.iter().position(|&b| b == 0).unwrap_or(sig.name.len());
        let name = std::str::from_utf8(&sig.name[..name_len]).unwrap();
        println!("  signal[{}]: name='{}', size={}, changes={}", i, name, sig.size, sig.value_changes.len());
    }
    
    // Test clock signal
    let clock = vcd.get_signal_by_name("clock").expect("clock signal not found");
    
    // At timestamp 5, clock should be 1
    let val = clock.get_value_at_timestamp(5).expect("no value at ts 5");
    let val_len = val.iter().position(|&b| b == 0).unwrap_or(val.len());
    let val_str = std::str::from_utf8(&val[..val_len]).unwrap();
    println!("clock at 5 = {}", val_str);
    assert_eq!(val_str, "1");
    
    // At timestamp 10, clock should be 0
    let val = clock.get_value_at_timestamp(10).expect("no value at ts 10");
    let val_len = val.iter().position(|&b| b == 0).unwrap_or(val.len());
    let val_str = std::str::from_utf8(&val[..val_len]).unwrap();
    println!("clock at 10 = {}", val_str);
    assert_eq!(val_str, "0");
}
EOF
