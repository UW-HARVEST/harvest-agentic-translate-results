#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_no_padding_needed() {
        let mut buf = [0u8; 10];
        assert_eq!(leftpad("test", "*", 4, &mut buf), 4);
        assert_eq!(&buf[..4], b"test");
    }
    #[test]
    fn test_padding_applied() {
        let mut buf = [0u8; 10];
        assert_eq!(leftpad("test", "*", 9, &mut buf), 9);
        assert_eq!(&buf[..9], b"*****test");
    }
    #[test]
    fn test_no_truncate_lower_target() {
        let mut buf = [0u8; 10];
        assert_eq!(leftpad("test", "*", 2, &mut buf), 4);
        assert_eq!(&buf[..4], b"test");
    }
    #[test]
    fn test_padding_repeated() {
        let mut buf = [0u8; 10];
        assert_eq!(leftpad("test", " .", 9, &mut buf), 9);
        assert_eq!(&buf[..9], b" . . test");
    }
    #[test]
    fn test_default_padding() {
        let mut buf = [0u8; 10];
        assert_eq!(leftpad("test", "", 9, &mut buf), 9);
        assert_eq!(&buf[..9], b"     test");
    }
    #[test]
    fn test_empty_string() {
        let mut buf = [0u8; 10];
        assert_eq!(leftpad("", "*", 9, &mut buf), 9);
        assert_eq!(&buf[..9], b"*********");
    }
    #[test]
    fn test_truncation() {
        let mut buf = [0u8; 10];
        assert_eq!(leftpad("test", "*", 11, &mut buf), 9);
        assert_eq!(&buf[..9], b"*******te");
    }
    #[test]
    fn test_empty_dest() {
        let mut empty: [u8; 0] = [];
        assert_eq!(leftpad("test", " ", 2, &mut empty), 4);
        assert_eq!(leftpad("test", " ", 4, &mut empty), 4);
        assert_eq!(leftpad("test", " ", 6, &mut empty), 6);
    }
}
