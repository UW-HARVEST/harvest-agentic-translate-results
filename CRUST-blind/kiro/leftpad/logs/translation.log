use leftpad::leftpad::leftpad;

fn check(s: &str, pad: &str, min_len: usize, buf_sz: usize, expected_ret: usize, expected_str: Option<&str>) {
    let mut buf = vec![0u8; buf_sz];
    let ret = leftpad(s, pad, min_len, &mut buf);
    assert_eq!(ret, expected_ret, "return mismatch for leftpad({:?}, {:?}, {}, buf, {})", s, pad, min_len, buf_sz);
    if let Some(exp) = expected_str {
        let result = std::str::from_utf8(&buf[..ret]).unwrap();
        assert_eq!(result, exp, "string mismatch");
    }
}

fn main() {
    // no padding needed
    check("test", "*", 4, 10, 4, Some("test"));
    // padding is applied
    check("test", "*", 9, 10, 9, Some("*****test"));
    // string not truncated for lower target
    check("test", "*", 2, 10, 4, Some("test"));
    // padding is repeated
    check("test", " .", 9, 10, 9, Some(" . . test"));
    // default padding is spaces (we pass empty string since Rust sig uses &str)
    check("test", "", 9, 10, 9, Some("     test"));
    // default string is empty
    check("", "*", 9, 10, 9, Some("*********"));
    // doesn't write beyond buffer
    check("test", "*", 11, 10, 9, Some("*******te"));
    // calculates required size if no buf (empty slice)
    let mut empty: [u8; 0] = [];
    assert_eq!(leftpad("test", " ", 2, &mut empty), 4);
    assert_eq!(leftpad("test", " ", 4, &mut empty), 4);
    assert_eq!(leftpad("test", " ", 6, &mut empty), 6);

    println!("All tests passed!");
}
