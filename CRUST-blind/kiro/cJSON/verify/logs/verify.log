use cJSON::cjson::{parse, CJson};

fn main() {
    // Number formatting
    for &d in &[0.0, 1.0, -1.0, 1.5, 1e10, 1e-7, 123456789.0, 1e60, 2147483647.0, -2147483648.0, 1.23456789, 0.5, 100.0, 1e-6, 1e9, 37.7668, -122.3959, 37.371991, -122.02602] {
        let n = CJson::create_number(d);
        println!("num {} -> {}", d, n.print_unformatted());
    }
    
    // Compact
    let arr = parse("[1,2,3]", false).unwrap();
    println!("array unformatted: [{}]", arr.print_unformatted());
    let obj = parse("{\"a\":1,\"b\":2}", false).unwrap();
    println!("object unformatted: [{}]", obj.print_unformatted());
    
    // Formatted
    println!("array formatted:\n{}", arr.print_formatted());
    println!("object formatted:\n{}", obj.print_formatted());
    
    // Empty
    println!("empty array: [{}]", CJson::create_array().print_formatted());
    println!("empty object: [{}]", CJson::create_object().print_formatted());
}
