#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "src/cJSON.h"

int main() {
    // C unformatted: comma with space or without?
    // From print_array: *ptr++=',';if(fmt)*ptr++=' '; -- so unformatted has NO space
    // From print_array formatted: *ptr++=',';if(fmt)*ptr++=' '; -- formatted has space
    
    // Let's verify with actual output
    cJSON *arr = cJSON_Parse("[1,2,3]");
    char *uf = cJSON_PrintUnformatted(arr);
    char *f = cJSON_Print(arr);
    printf("array unformatted: [%s]\n", uf);
    printf("array formatted: [%s]\n", f);
    free(uf); free(f); cJSON_Delete(arr);
    
    // Object
    cJSON *obj = cJSON_Parse("{\"a\":1,\"b\":2}");
    uf = cJSON_PrintUnformatted(obj);
    f = cJSON_Print(obj);
    printf("object unformatted: [%s]\n", uf);
    printf("object formatted: [%s]\n", f);
    free(uf); free(f); cJSON_Delete(obj);
    
    // Number formatting edge cases
    double nums[] = {0.1, 0.01, 0.001, 0.0001, 0.00001, 0.000001, 0.0000001, 
                     999999999.0, 1000000000.0, 1000000001.0,
                     1e-6, 1e-7, 1e9, 1.0000000001e9};
    for (int i = 0; i < 14; i++) {
        cJSON *n = cJSON_CreateNumber(nums[i]);
        char *s = cJSON_PrintUnformatted(n);
        printf("num %.15g -> %s\n", nums[i], s);
        free(s); cJSON_Delete(n);
    }
    
    // Formatted object with nested object
    cJSON *root = cJSON_CreateObject();
    cJSON *inner = cJSON_CreateObject();
    cJSON_AddStringToObject(inner, "x", "1");
    cJSON_AddItemToObject(root, "o", inner);
    f = cJSON_Print(root);
    printf("nested obj formatted:\n%s\n", f);
    free(f); cJSON_Delete(root);
    
    // Formatted array with nested array
    root = cJSON_CreateArray();
    cJSON *inner_arr = cJSON_CreateArray();
    cJSON_AddItemToArray(inner_arr, cJSON_CreateNumber(1));
    cJSON_AddItemToArray(root, inner_arr);
    cJSON_AddItemToArray(root, cJSON_CreateNumber(2));
    f = cJSON_Print(root);
    printf("nested arr formatted:\n%s\n", f);
    free(f); cJSON_Delete(root);
    
    return 0;
}
