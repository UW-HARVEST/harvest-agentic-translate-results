#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_new_empty() {
        let set = RSet::new();
        assert_eq!(set.cardinality(), 0);
        assert_eq!(set.length(), std::mem::size_of::<u16>() * 2);
    }

    #[test]
    fn test_add_contains() {
        let mut set = RSet::new();
        assert!(!set.contains(42));
        assert!(set.add(42));
        assert!(set.contains(42));
        assert_eq!(set.cardinality(), 1);
    }

    #[test]
    fn test_truncate() {
        let mut set = RSet::new();
        for i in 0..5 { set.add(i); }
        assert_eq!(set.cardinality(), 5);
        set.truncate();
        assert_eq!(set.cardinality(), 0);
    }

    #[test]
    fn test_fill() {
        let mut set = RSet::new();
        set.fill();
        assert_eq!(set.cardinality(), MAX_CARDINALITY);
        assert!(set.contains(0));
        assert!(set.contains(MAX_ITEM));
    }

    #[test]
    fn test_equals() {
        let mut a = RSet::new();
        let mut b = RSet::new();
        assert!(a.equals(&b));
        a.add(1); a.add(2); a.add(3);
        b.add(1); b.add(2); b.add(3);
        assert!(a.equals(&b));
    }

    #[test]
    fn test_copy_export_import() {
        let mut set = RSet::new();
        set.add(1); set.add(2); set.add(3);
        let copy = set.copy();
        assert!(set.equals(&copy));
        let exported = set.export();
        let imported = RSet::import(&exported, set.length());
        assert!(set.equals(&imported));
    }

    #[test]
    fn test_invert() {
        let mut set = RSet::new();
        for i in 4..=65535u16 { set.add(i); }
        let mut inverted = RSet::new();
        assert!(set.invert(&mut inverted));
        assert_eq!(inverted.cardinality(), 4);
        assert!(inverted.contains(0));
        assert!(inverted.contains(1));
        assert!(inverted.contains(2));
        assert!(inverted.contains(3));
        assert!(!inverted.contains(4));
    }

    #[test]
    fn test_intersection() {
        let mut a = RSet::new();
        let mut b = RSet::new();
        for i in (0..100).step_by(2) { a.add(i); }
        for i in 0..10 { b.add(i); }
        let mut result = RSet::new();
        assert!(a.intersection(&b, &mut result));
        assert_eq!(result.cardinality(), 5);
        assert!(result.contains(0));
        assert!(result.contains(2));
        assert!(result.contains(4));
        assert!(result.contains(6));
        assert!(result.contains(8));
    }

    #[test]
    fn test_fill_ascending() {
        let mut set = RSet::new();
        for i in 0..=65535u16 {
            assert!(set.add(i));
            assert!(set.add(i)); // idempotent
        }
        assert_eq!(set.cardinality(), 65536);
        assert_eq!(set.length(), std::mem::size_of::<u16>());
    }

    #[test]
    fn test_fill_descending() {
        let mut set = RSet::new();
        for i in (0..=65535u16).rev() {
            assert!(set.add(i));
            assert!(set.add(i)); // idempotent
        }
        assert_eq!(set.cardinality(), 65536);
        assert_eq!(set.length(), std::mem::size_of::<u16>());
    }

    #[test]
    fn test_array_to_bitset() {
        let mut set = RSet::new();
        for i in 0..32768u16 {
            set.add(i * 2);
        }
        assert_eq!(set.cardinality(), 32768);
        for i in 0..4096 {
            assert_eq!(set.buffer[i + 1], 0x5555);
        }
    }

    #[test]
    fn test_bitset_to_inverted_array() {
        let mut set = RSet::new();
        for i in 0..=61440u16 {
            set.add(i);
        }
        assert_eq!(set.cardinality(), 61441);
        for i in 0..4095u16 {
            assert_eq!(set.buffer[i as usize + 1], 61441 + i);
        }
    }

    #[test]
    fn test_buffer_resizing() {
        let mut set = RSet::new();
        for i in 0..1000u16 {
            assert!(set.add(i));
        }
        assert_eq!(set.cardinality(), 1000);
    }

    #[test]
    fn test_contains_all_modes() {
        let mut set = RSet::new();
        for i in 0..=65535u16 {
            assert!(!set.contains(i));
            assert!(set.add(i));
            assert!(set.contains(i));
        }
    }

    #[test]
    fn test_invert_empty_full() {
        let mut set = RSet::new();
        let mut inverted = RSet::new();
        // invert empty => full
        assert!(set.invert(&mut inverted));
        assert_eq!(inverted.cardinality(), MAX_CARDINALITY);
        // invert full => empty
        let mut inv2 = RSet::new();
        assert!(inverted.invert(&mut inv2));
        assert_eq!(inv2.cardinality(), 0);
    }

    #[test]
    fn test_intersection_empty() {
        let a = RSet::new();
        let mut b = RSet::new();
        b.add(1); b.add(2);
        let mut result = RSet::new();
        assert!(a.intersection(&b, &mut result));
        assert_eq!(result.cardinality(), 0);
    }

    #[test]
    fn test_intersection_full() {
        let mut a = RSet::new();
        a.fill();
        let mut b = RSet::new();
        b.add(1); b.add(2);
        let mut result = RSet::new();
        assert!(a.intersection(&b, &mut result));
        assert!(result.equals(&b));
    }

    #[test]
    fn test_intersection_disjoint() {
        let mut a = RSet::new();
        let mut b = RSet::new();
        for i in (0..100).step_by(2) { a.add(i); }
        for i in (1..100).step_by(2) { b.add(i); }
        let mut result = RSet::new();
        assert!(a.intersection(&b, &mut result));
        assert_eq!(result.cardinality(), 0);
    }
}
