#include <stdio.h>
#include <string.h>
#include <stdint.h>

// Reproduce fnva1 from hashmap.c
unsigned fnva1(char *value) {
    unsigned long h = 16777619;
    long int prime = 2166136261;
    while (*value != '\0') {
        h ^= *value;
        h *= prime;
        ++value;
    }
    return h;
}

int main() {
    // fnva1 hash values
    printf("fnva1(\"test\") = %u\n", fnva1("test"));
    printf("fnva1(\"jake\") = %u\n", fnva1("jake"));
    printf("fnva1(\"hello\") = %u\n", fnva1("hello"));
