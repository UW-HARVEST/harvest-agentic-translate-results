#include <stdio.h>
#include <string.h>
#include <ctype.h>

// Reproduce the C functions
int in_string(char c, char s[]) {
    for (char *d = s; *d; ++d) {
        if (*d == c) return 1;
    }
    return 0;
}

int starts_operator(char c) {
    switch (c) {
    case '-': case '+': case '*': case '/': case '=': case ':': case '%':
    case '&': case '|': case '<': case '>': case '!': case '~': case '^':
        return 1;
    default:
        return 0;
    }
}

int is_valid_numeric_or_id_char(char c) {
    return isalnum(c) || (c == '_') || (c == '.');
}

char* operator_strings[] = {
    "-", "+", "*", "/", "=", ":", "%", "&", "&&", "|", "||",
    "-=", "+=", "++", "--", "/=", "*=", "%=", "&=", "|=",
    "&&=", "||=", ">", "<", "<=", ">=", "<<", ">>", "!",
    "==", "!=", "^", "^=", "->", "<<=", ">>=", NULL,
};

int valid_operator_sequence(char* op) {
    for (char** top = operator_strings; *top; ++top) {
        if (!strcmp(*top, op)) return 1;
    }
    return 0;
}

int main() {
    // in_string tests
    char single_char_tokens[] = "(){}[];~#,.:?~";
    printf("in_string('(', sct) = %d\n", in_string('(', single_char_tokens));
    printf("in_string('a', sct) = %d\n", in_string('a', single_char_tokens));
    printf("in_string(';', sct) = %d\n", in_string(';', single_char_tokens));
    printf("in_string('+', sct) = %d\n", in_string('+', single_char_tokens));

    // starts_operator tests
    printf("starts_operator('+') = %d\n", starts_operator('+'));
    printf("starts_operator('a') = %d\n", starts_operator('a'));
    printf("starts_operator('=') = %d\n", starts_operator('='));
    printf("starts_operator(' ') = %d\n", starts_operator(' '));
    printf("starts_operator('(') = %d\n", starts_operator('('));

