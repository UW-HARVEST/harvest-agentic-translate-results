#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include "slothvm.h"

int progLen(FILE* f);
char *readline(FILE *file);

int main(){
  FILE* sFile = fopen("Examples/Count.sloth", "r");
  int numCodes = progLen(sFile);
  ubyte* byteCode = malloc(sizeof(char) * numCodes);
  
  char c = '\0';
  size_t count = 0;
  char *line = 0x0;
  size_t len = 0;
  size_t codeNum = 0;
  unsigned char currentCode = 0;
  char hadToken = 0;
  int lineNum = 0;

  while(1){
    count = 0;
    currentCode = 0;
    line = readline(sFile);
    len = strlen(line);
    lineNum++;
    
    printf("Line %d: len=%zu, line[0]=%d\n", lineNum, len, (int)(signed char)line[0]);
    
    if(line[0] == -1){
      printf("  EOF detected, breaking\n");
      free(line);
      break;
    }
    if(len == 0){
      printf("  Empty line, continuing\n");
      free(line);
      continue;
    }
    
    c = line[0];
    while(c != 0 && c != -1 && c != '#' && count <= len){
      if(strncmp("slothy", line + count, 6) == 0){
        byteCode[codeNum] = 0x1;
        printf("  slothy -> code[%zu]=0x01\n", codeNum);
        codeNum++;
        count += 6;
        hadToken = 1;
      } else if(strncmp("sloth", line + count, 5) == 0){
        currentCode++;
        count += 5;
        hadToken = 1;
      }else if(strncmp("and", line + count, 3) == 0){
        byteCode[codeNum] = currentCode;
        printf("  and -> code[%zu]=0x%02x\n", codeNum, currentCode);
        codeNum++;
        currentCode = 0;
        count += 3;
        hadToken = 1;
      }else if(strncmp("nap", line + count, 3) == 0){
        byteCode[codeNum] = 0x0;
        printf("  nap -> code[%zu]=0x00\n", codeNum);
        codeNum++;
        count += 3;
        hadToken = 1;
      }else{
        count++;
      }
      c = line[count];
    }

    if(hadToken){
      byteCode[codeNum] = currentCode;
      printf("  hadToken -> code[%zu]=0x%02x\n", codeNum, currentCode);
      codeNum++;
      hadToken = 0;
    }
    free(line);
  }
  
  printf("\nTotal codes: %zu\n", codeNum);
  for(size_t i = 0; i < codeNum; i++){
    printf("[%zu]=0x%02x ", i, byteCode[i]);
  }
  printf("\n");
  
  free(byteCode);
  fclose(sFile);
  return 0;
}
EOF
