use clhash::clhash::*;

fn main() {
    // Replicate the C demo test
    let random = get_random_key_for_clhash(0x23a23cf5033c3c81u64, 0xb3816f6a2c68e530u64);
    let h1 = clhash(&random, b"my dog");
    let h2 = clhash(&random, b"my cat");
    let h3 = clhash(&random, b"my dog");
    println!("h1={:#018x} h2={:#018x} h3={:#018x}", h1, h2, h3);
    assert_eq!(h1, h3, "same input should give same hash");
    assert_ne!(h1, h2, "different input should give different hash");
    
    // Replicate clhashtest: flipping a bit changes hash
    let mut rs = vec![0u8; RANDOM_BYTES_NEEDED_FOR_CLHASH];
    for k in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {
        rs[k] = (1i32 - k as i32) as u8;
    }
    
    for bit in 0..64u32 {
        let min_length = ((bit + 8) / 8) as usize;
        for length in min_length..=8 {
            let x: u64 = 0;
            let xbytes = x.to_le_bytes();
            let orig = clhash(&rs, &xbytes[..length]);
            
            let x2: u64 = 1u64 << bit;
            let x2bytes = x2.to_le_bytes();
            let flip = clhash(&rs, &x2bytes[..length]);
            assert_ne!(flip, orig, "bit={} length={}: flip should differ", bit, length);
            
            let back = clhash(&rs, &xbytes[..length]);
            assert_eq!(back, orig, "bit={} length={}: back should match", bit, length);
        }
    }
    println!("clhashtest passed!");
    
    // Replicate clhashcollisiontest (Eik List's test)
    let num_trials = 10usize;
    let clnh_num_bytes_per_block = 1024usize;
    let key_offset: u8 = 0x63;
    
    let mut k = vec![0u8; RANDOM_BYTES_NEEDED_FOR_CLHASH];
    for j2 in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {
        k[j2] = ((j2 as u64 + key_offset as u64) & 0xFF) as u8;
    }
    
    for i in 1..num_trials {
        for j in 1..=8 {
            let mlen = i * clnh_num_bytes_per_block + j;
            let mut m = vec![0u8; mlen];
            for j2 in 0..mlen {
                m[j2] = (j2 & 0xFF) as u8;
            }
            let actual1 = clhash(&k, &m);
            m[mlen - 1] = (m[mlen - 1].wrapping_add(1)) & 0xFF;
            let actual2 = clhash(&k, &m);
            assert_ne!(actual1, actual2, "collision at mlen={}", mlen);
        }
    }
    println!("clhashcollisiontest passed!");
    
    // Avalanche test
    let n = 1024usize;
    let mut array = vec![0u8; n];
    let mut array1 = vec![0u8; n];
    let mut rs2 = vec![0u8; RANDOM_BYTES_NEEDED_FOR_CLHASH];
    for k in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {
        rs2[k] = ((k as i64 + 1 - (k as i64) * (k as i64)) & 0xFF) as u8;
    }
    let big_k = 16;
    for bytelength in 1..big_k {
        for whichcase in 0..256u32 {
            for k in 0..bytelength {
                array[k] = whichcase as u8;
                array1[k] = (whichcase + 35) as u8;
            }
            let orighash = clhash(&rs2, &array[..bytelength]);
            let orighash1 = clhash(&rs2, &array1[..bytelength]);
            
            for z in 0..(8 * bytelength) {
                let byte_idx = z / 8;
                let bit_idx = z % 8;
                
                array[byte_idx] ^= 1 << bit_idx;
                let newhash = clhash(&rs2, &array[..bytelength]);
                array[byte_idx] ^= 1 << bit_idx;
                assert_ne!(orighash, newhash, "avalanche fail at bytelength={} whichcase={} z={}", bytelength, whichcase, z);
                
                array1[byte_idx] ^= 1 << bit_idx;
                let newhash1 = clhash(&rs2, &array1[..bytelength]);
                array1[byte_idx] ^= 1 << bit_idx;
                assert_ne!(orighash1, newhash1);
                
                if bytelength <= 8 {
                    assert_eq!((orighash ^ newhash), (orighash1 ^ newhash1),
                        "XOR diff mismatch at bytelength={} whichcase={} z={}", bytelength, whichcase, z);
                }
            }
        }
    }
    println!("avalanche test passed!");
    println!("All tests passed!");
}
