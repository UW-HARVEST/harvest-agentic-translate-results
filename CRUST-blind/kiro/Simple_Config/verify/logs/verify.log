#include <stdio.h>
#include <string.h>
#include "config.h"

int main(void) {
    CfgError err;
    CfgEntry entries[32];
    Cfg cfg = {.entries = entries, .capacity = 32};

    // Test: parse sample config
    const char *src = "font: \"JetBrainsMono Nerd Font\"\n"
                      "font.size: 14\n"
                      "zoom: 1.5\n"
                      "line_numbers: true\n"
                      "ruler: false\n"
                      "bg.color: rgba(255, 255, 255, 1)";
    int res = cfg_parse(src, strlen(src), &cfg, &err);
    printf("parse result: %d, count: %d\n", res, cfg.count);
    for (int i = 0; i < cfg.count; i++) {
        printf("entry[%d]: key=%s type=%d\n", i, entries[i].key, entries[i].type);
        switch (entries[i].type) {
            case CFG_TYPE_STRING: printf("  val=%s\n", entries[i].val.string); break;
            case CFG_TYPE_BOOL: printf("  val=%d\n", entries[i].val.boolean); break;
            case CFG_TYPE_INT: printf("  val=%d\n", entries[i].val.integer); break;
            case CFG_TYPE_FLOAT: printf("  val=%f\n", entries[i].val.floating); break;
            case CFG_TYPE_COLOR: printf("  val=rgba(%d,%d,%d,%d)\n", entries[i].val.color.r, entries[i].val.color.g, entries[i].val.color.b, entries[i].val.color.a); break;
        }
    }

    // Test: error position for "a:true\nb:"
    cfg.count = 0;
    res = cfg_parse("a:true\nb:", 9, &cfg, &err);
    printf("\nerror test: res=%d row=%d col=%d msg=%s\n", res, err.row, err.col, err.msg);

    // Test: error for empty string parse_file
    cfg.count = 0;
    res = cfg_parse_file("", &cfg, &err);
    printf("parse_file empty: res=%d row=%d col=%d msg=%s\n", res, err.row, err.col, err.msg);

    // Test: error for wrong extension
    cfg.count = 0;
    res = cfg_parse_file("sample.txt", &cfg, &err);
    printf("parse_file wrong ext: res=%d msg=%s\n", res, err.msg);

    // Test: error for nonexistent file
    cfg.count = 0;
    res = cfg_parse_file("nonexistent.cfg", &cfg, &err);
    printf("parse_file nonexistent: res=%d msg=%s\n", res, err.msg);

    // Test: get functions with parsed config
    cfg.count = 0;
    cfg_parse(src, strlen(src), &cfg, &err);
    printf("\nget_string font: %s\n", cfg_get_string(&cfg, "font", "default"));
    printf("get_string missing: %s\n", cfg_get_string(&cfg, "missing", "fallback"));
    printf("get_bool line_numbers: %d\n", cfg_get_bool(&cfg, "line_numbers", false));
    printf("get_bool missing: %d\n", cfg_get_bool(&cfg, "missing", true));
    printf("get_int font.size: %d\n", cfg_get_int(&cfg, "font.size", 0));
    printf("get_int missing: %d\n", cfg_get_int(&cfg, "missing", 42));
    printf("get_float zoom: %f\n", cfg_get_float(&cfg, "zoom", 0.0));
    printf("get_float missing: %f\n", cfg_get_float(&cfg, "missing", 3.14));
    CfgColor fb = {0, 0, 0, 0};
    CfgColor c = cfg_get_color(&cfg, "bg.color", fb);
    printf("get_color bg.color: rgba(%d,%d,%d,%d)\n", c.r, c.g, c.b, c.a);
    CfgColor c2 = cfg_get_color(&cfg, "missing", fb);
    printf("get_color missing: rgba(%d,%d,%d,%d)\n", c2.r, c2.g, c2.b, c2.a);

    // Test: int range functions
    CfgEntry int_entries[] = {
        {.key = "key", .type = CFG_TYPE_INT, .val.integer = 16},
    };
    Cfg int_cfg = {.entries = int_entries, .capacity = 1, .count = 1};
    printf("\nint_min(key,64,8): %d\n", cfg_get_int_min(&int_cfg, "key", 64, 8));
    printf("int_min(key,64,32): %d\n", cfg_get_int_min(&int_cfg, "key", 64, 32));
    printf("int_max(key,64,32): %d\n", cfg_get_int_max(&int_cfg, "key", 64, 32));
    printf("int_max(key,4,8): %d\n", cfg_get_int_max(&int_cfg, "key", 4, 8));
    printf("int_range(key,64,8,32): %d\n", cfg_get_int_range(&int_cfg, "key", 64, 8, 32));
    printf("int_range(key,4,4,8): %d\n", cfg_get_int_range(&int_cfg, "key", 4, 4, 8));
    printf("int_range(key,32,32,64): %d\n", cfg_get_int_range(&int_cfg, "key", 32, 32, 64));

    // Test: float range functions
    CfgEntry float_entries[] = {
        {.key = "key", .type = CFG_TYPE_FLOAT, .val.floating = 16.0},
    };
    Cfg float_cfg = {.entries = float_entries, .capacity = 1, .count = 1};
    printf("\nfloat_min(key,64,8): %f\n", cfg_get_float_min(&float_cfg, "key", 64, 8));
    printf("float_min(key,64,32): %f\n", cfg_get_float_min(&float_cfg, "key", 64, 32));
    printf("float_max(key,64,32): %f\n", cfg_get_float_max(&float_cfg, "key", 64, 32));
    printf("float_max(key,4,8): %f\n", cfg_get_float_max(&float_cfg, "key", 4, 8));
    printf("float_range(key,64,8,32): %f\n", cfg_get_float_range(&float_cfg, "key", 64, 8, 32));
    printf("float_range(key,4,4,8): %f\n", cfg_get_float_range(&float_cfg, "key", 4, 4, 8));
    printf("float_range(key,32,32,64): %f\n", cfg_get_float_range(&float_cfg, "key", 32, 32, 64));

    // Test: parse edge cases
    // negative int
    cfg.count = 0;
    cfg_parse("key: -1", 7, &cfg, &err);
    printf("\nneg int: %d\n", cfg.entries[0].val.integer);

    // float "1."
    cfg.count = 0;
    cfg_parse("key: 1.", 7, &cfg, &err);
    printf("float 1.: %f\n", cfg.entries[0].val.floating);

    // float "0.5"
    cfg.count = 0;
    cfg_parse("key: 0.5", 8, &cfg, &err);
    printf("float 0.5: %f\n", cfg.entries[0].val.floating);

    // rgba with float alpha
    cfg.count = 0;
    cfg_parse("key: rgba(100, 200, 50, 0.5)", 28, &cfg, &err);
    CfgColor rc = cfg.entries[0].val.color;
    printf("rgba float alpha: rgba(%d,%d,%d,%d)\n", rc.r, rc.g, rc.b, rc.a);

    // rgba with int alpha 0
    cfg.count = 0;
    cfg_parse("key: rgba(100, 200, 50, 0)", 26, &cfg, &err);
    rc = cfg.entries[0].val.color;
    printf("rgba int alpha 0: rgba(%d,%d,%d,%d)\n", rc.r, rc.g, rc.b, rc.a);

    // rgba with int alpha 1
    cfg.count = 0;
    cfg_parse("key: rgba(100, 200, 50, 1)", 26, &cfg, &err);
    rc = cfg.entries[0].val.color;
    printf("rgba int alpha 1: rgba(%d,%d,%d,%d)\n", rc.r, rc.g, rc.b, rc.a);

    // Test: Display/fprint output
    cfg.count = 0;
    cfg_parse(src, strlen(src), &cfg, &err);
    printf("\nfprint output:\n");
    cfg_fprint(stdout, &cfg);

    // Test: error display
    cfg.count = 0;
    res = cfg_parse("a:true\nb:", 9, &cfg, &err);
    printf("\nfprint_error output:\n");
    cfg_fprint_error(stdout, &err);

    // Test: error display for file error (row=-1, col=-1)
    cfg.count = 0;
    res = cfg_parse_file("", &cfg, &err);
    printf("fprint_error file output:\n");
    cfg_fprint_error(stdout, &err);

    // Test: multiple entries, last one wins for get
    cfg.count = 0;
    cfg_parse("key: 10\nkey: 20", 15, &cfg, &err);
    printf("\nduplicate key get_int: %d\n", cfg_get_int(&cfg, "key", 0));

    // Test: inline comment
    cfg.count = 0;
    cfg_parse("key: 10 # comment", 17, &cfg, &err);
    printf("inline comment: %d\n", cfg.entries[0].val.integer);

    // Test: key with underscore and dot
    cfg.count = 0;
    cfg_parse("key_: true", 10, &cfg, &err);
    printf("key_: key=%s val=%d\n", cfg.entries[0].key, cfg.entries[0].val.boolean);

    cfg.count = 0;
    cfg_parse("key.: true", 10, &cfg, &err);
    printf("key.: key=%s val=%d\n", cfg.entries[0].key, cfg.entries[0].val.boolean);

    // Test: two entries "a: true\nb:true"
    cfg.count = 0;
    cfg_parse("a: true\nb:true", 14, &cfg, &err);
    printf("two entries: count=%d key0=%s val0=%d key1=%s val1=%d\n",
        cfg.count, cfg.entries[0].key, cfg.entries[0].val.boolean,
        cfg.entries[1].key, cfg.entries[1].val.boolean);

    return 0;
}
EOF
