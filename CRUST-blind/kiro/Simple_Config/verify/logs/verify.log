#include <stdio.h>
#include <string.h>
#include "config.h"

void test_err(const char *src) {
    CfgError err;
    CfgEntry entries[32];
    Cfg cfg = {.entries = entries, .capacity = 32};
    int res = cfg_parse(src, strlen(src), &cfg, &err);
    printf("src=\"%s\" res=%d off=%d row=%d col=%d msg=%s\n", src, res, err.off, err.row, err.col, err.msg);
}

int main(void) {
    test_err("!");
    test_err("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx");
    test_err("key");
    test_err("key!");
    test_err("key  :");
    test_err("key:");
    test_err("key:  ");
    test_err("key:\n");
    test_err("key:  \n");
    test_err("key: @\n");
    test_err("key: \"");
    test_err("key: \"hello");
    test_err("key: 10x");
    test_err("key: -");
    test_err("key: t");
    test_err("key: f");
    test_err("key: x");
    test_err("key: rgba(");
    test_err("key: rgba");
    test_err("key: rgba x");
    test_err("key: r");
    test_err("key: rgba(0.5");
    test_err("key: rgba(-1");
    test_err("key: rgba(256");
    test_err("key: rgba(255, 255, 255, -1)");
    test_err("key: rgba(255, 255, 255, 2)");
    test_err("key: rgba(255, 255, 255, 1");
    test_err("key: rgba(255, 255, 255, x");
    test_err("key: rgba(x");
    test_err("key: rgba(255 x");
    test_err("key: rgba(255, 255, 255, 1 x");
    test_err("key: 2147483648");
    test_err("key: 0.0000000000");
    test_err("key: 1.33333333333333333");
    test_err("key: rgba(255, 255, 255, -0.5)");
    test_err("key: rgba(255, 255, 255, -)");
    test_err("key: rgba(255, 255, 255, 1.5)");

    // Test: init_error sets -1 for off/col/row
    CfgError err;
    CfgEntry entries[32];
    Cfg cfg = {.entries = entries, .capacity = 32};
    int res = cfg_parse_file("", &cfg, &err);
    printf("\nparse_file empty: off=%d row=%d col=%d msg=%s\n", err.off, err.row, err.col, err.msg);
    res = cfg_parse_file("x.txt", &cfg, &err);
    printf("parse_file x.txt: off=%d row=%d col=%d msg=%s\n", err.off, err.row, err.col, err.msg);

    return 0;
}
EOF
