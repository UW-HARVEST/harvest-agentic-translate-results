#include <stdio.h>
#include <string.h>
#include "config.h"

int main() {
    CfgError err;
    CfgEntry entries[32];
    Cfg cfg;

    // Test: error position for "a:true\nb:"
    cfg = (Cfg){.entries = entries, .capacity = 32};
    int res = cfg_parse("a:true\nb:", 9, &cfg, &err);
    printf("err_test: res=%d row=%d col=%d msg='%s'\n", res, err.row, err.col, err.msg);

    // Test: cfg_fprint_error with row=-1 col=-1
    CfgError file_err = {.off = -1, .row = -1, .col = -1};
    snprintf(file_err.msg, CFG_MAX_ERR, "invalid filename");
    cfg_fprint_error(stdout, &file_err);

    // Test: rgba with alpha=1 (integer)
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse("key: rgba(255, 255, 255, 1)", 27, &cfg, &err);
    printf("rgba_int_alpha: res=%d count=%d\n", res, cfg.count);
    if (res == 0) {
        printf("  r=%d g=%d b=%d a=%d\n", entries[0].val.color.r, entries[0].val.color.g, entries[0].val.color.b, entries[0].val.color.a);
    }

    // Test: rgba with alpha=0.5 (float)
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse("key: rgba(255, 255, 255, 0.5)", 29, &cfg, &err);
    printf("rgba_float_alpha: res=%d count=%d\n", res, cfg.count);
    if (res == 0) {
        printf("  r=%d g=%d b=%d a=%d\n", entries[0].val.color.r, entries[0].val.color.g, entries[0].val.color.b, entries[0].val.color.a);
    }

    // Test: rgba with alpha=0 (integer)
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse("key: rgba(0, 0, 0, 0)", 21, &cfg, &err);
    printf("rgba_zero_alpha: res=%d count=%d\n", res, cfg.count);
    if (res == 0) {
        printf("  r=%d g=%d b=%d a=%d\n", entries[0].val.color.r, entries[0].val.color.g, entries[0].val.color.b, entries[0].val.color.a);
    }

    // Test: Display format for float
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse("key: 1.5", 8, &cfg, &err);
    if (res == 0) cfg_fprint(stdout, &cfg);

    // Test: Display format for negative float
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse("key: -1.5", 9, &cfg, &err);
    if (res == 0) cfg_fprint(stdout, &cfg);

    // Test: Display format for negative int
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse("key: -1", 7, &cfg, &err);
    if (res == 0) cfg_fprint(stdout, &cfg);

    // Test: "1." parses as float 1.0
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse("key: 1.", 7, &cfg, &err);
    printf("float_1dot: res=%d type=%d val=%f\n", res, entries[0].type, entries[0].val.floating);

    return 0;
}
EOF
