#include <stdio.h>
#include <string.h>
#include "config.h"

int main(void) {
    CfgError err;
    CfgEntry entries[32];
    Cfg cfg;

    // value too long: 65 x's
    char long_val[100] = "key: \"";
    for (int i = 6; i < 6+65; i++) long_val[i] = 'x';
    long_val[71] = '"';
    long_val[72] = '\0';
    cfg = (Cfg){.entries = entries, .capacity = 32};
    int res = cfg_parse(long_val, strlen(long_val), &cfg, &err);
    printf("value too long: res=%d off=%d row=%d col=%d msg=%s\n", res, err.off, err.row, err.col, err.msg);

    // Test: cfg_parse_file with valid file
    cfg = (Cfg){.entries = entries, .capacity = 32};
    res = cfg_parse_file("sample.cfg", &cfg, &err);
    printf("\nparse_file sample.cfg: res=%d count=%d\n", res, cfg.count);
    for (int i = 0; i < cfg.count; i++) {
        printf("  entry[%d]: key=%s type=%d\n", i, entries[i].key, entries[i].type);
    }

    // Test: cfg_get_bool with ruler (false)
    printf("get_bool ruler: %d\n", cfg_get_bool(&cfg, "ruler", true));

    // Test: capacity 0 with valid input
    cfg = (Cfg){.entries = entries, .capacity = 0};
    res = cfg_parse("x", 1, &cfg, &err);
    printf("\ncapacity 0: res=%d count=%d\n", res, cfg.count);

    return 0;
}
