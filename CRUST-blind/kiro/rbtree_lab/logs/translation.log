use rbtree::rbtree::RBTree;

fn main() {
    let mut t = RBTree::new();
    
    // Insert
    for k in [10, 5, 15, 3, 7, 12, 20, 1] {
        t.rbtree_insert(k);
    }
    
    // Find
    assert!(t.rbtree_find(10).is_some());
    assert!(t.rbtree_find(99).is_none());
    
    // Min/Max
    assert_eq!(t.rbtree_min().unwrap().borrow().key, 1);
    assert_eq!(t.rbtree_max().unwrap().borrow().key, 20);
    
    // to_array (in-order)
    let arr = t.to_array(100);
    assert_eq!(arr, vec![1, 3, 5, 7, 10, 12, 15, 20]);
    
    // Erase
    let node = t.rbtree_find(10).unwrap();
    t.erase(node);
    assert!(t.rbtree_find(10).is_none());
    let arr = t.to_array(100);
    assert_eq!(arr, vec![1, 3, 5, 7, 12, 15, 20]);
    
    // Erase all
    while let Some(min) = t.rbtree_min() {
        t.erase(min);
    }
    assert!(t.rbtree_min().is_none());
    assert_eq!(t.to_array(100), vec![]);
    
    // Duplicate keys
    let mut t2 = RBTree::new();
    t2.rbtree_insert(5);
    t2.rbtree_insert(5);
    t2.rbtree_insert(5);
    assert_eq!(t2.to_array(100), vec![5, 5, 5]);
    
    // delete_rbtree
    t2.delete_rbtree();
    
    println!("All tests passed!");
}
EOF
