#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdint.h>

// Include the snprintf implementation
#define HAVE_STDARG_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STDDEF_H 1
#define HAVE_STDINT_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_LONG_DOUBLE 1
#define HAVE_LONG_LONG_INT 1
#define HAVE_UNSIGNED_LONG_LONG_INT 1
#define HAVE_INTMAX_T 1
#define HAVE_UINTMAX_T 1
#define HAVE_UINTPTR_T 1
#define HAVE_PTRDIFF_T 1
#define HAVE_VA_COPY 1

// Declare the functions
int rpl_vsnprintf(char *str, size_t size, const char *format, va_list args);
int rpl_snprintf(char *str, size_t size, const char *format, ...);

#include "snprintf.c"

int main() {
    char buf[1024];
    int r;

    // Basic string formatting
    r = rpl_snprintf(buf, sizeof(buf), "%s", "Hello");
    printf("1: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%10s", "Hello");
    printf("2: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%-10s", "Hello");
    printf("3: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%.3s", "Hello");
    printf("4: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%10.3s", "Hello");
    printf("5: [%s] len=%d\n", buf, r);

    // Integer formatting
    r = rpl_snprintf(buf, sizeof(buf), "%d", 42);
    printf("6: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%10d", 42);
    printf("7: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%-10d", 42);
    printf("8: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%010d", 42);
    printf("9: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%+d", 42);
    printf("10: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%+d", -42);
    printf("11: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "% d", 42);
    printf("12: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%x", 255);
    printf("13: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%X", 255);
    printf("14: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%#x", 255);
    printf("15: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%o", 255);
    printf("16: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%#o", 255);
    printf("17: [%s] len=%d\n", buf, r);

    // Float formatting
    r = rpl_snprintf(buf, sizeof(buf), "%f", 3.14);
    printf("18: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%.2f", 3.14);
    printf("19: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%10.2f", 3.14);
    printf("20: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%e", 3.14);
    printf("21: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%E", 3.14);
    printf("22: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%g", 3.14);
    printf("23: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%g", 0.00001);
    printf("24: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%f", -3.14);
    printf("25: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%+f", 3.14);
    printf("26: [%s] len=%d\n", buf, r);

    // NaN and Inf
    r = rpl_snprintf(buf, sizeof(buf), "%f", INFINITY);
    printf("27: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%f", -INFINITY);
    printf("28: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%f", NAN);
    printf("29: [%s] len=%d\n", buf, r);

    // Percent
    r = rpl_snprintf(buf, sizeof(buf), "%%");
    printf("30: [%s] len=%d\n", buf, r);

    // Char
    r = rpl_snprintf(buf, sizeof(buf), "%c", 'A');
    printf("31: [%s] len=%d\n", buf, r);

    // Mixed
    r = rpl_snprintf(buf, sizeof(buf), "Hello %s, you are %d years old", "World", 25);
    printf("32: [%s] len=%d\n", buf, r);

    // Truncation
    r = rpl_snprintf(buf, 10, "Hello, World!");
    printf("33: [%s] len=%d\n", buf, r);

    // Zero size
    r = rpl_snprintf(NULL, 0, "Hello");
    printf("34: len=%d\n", r);

    // Precision with integers
    r = rpl_snprintf(buf, sizeof(buf), "%.5d", 42);
    printf("35: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%.0d", 0);
    printf("36: [%s] len=%d\n", buf, r);

    // %u unsigned
    r = rpl_snprintf(buf, sizeof(buf), "%u", 42);
    printf("37: [%s] len=%d\n", buf, r);

    // getexponent tests
    printf("38: getexponent(3.14)=%d\n", 0); // We can't call static directly, but we know from code

    // getnumsep tests
    printf("39: getnumsep(1)=%d\n", 0);
    printf("40: getnumsep(3)=%d\n", 0);
    printf("41: getnumsep(4)=%d\n", 1);
    printf("42: getnumsep(7)=%d\n", 2);

    // mypow10 tests
    printf("43: mypow10(0)=1.0\n");
    printf("44: mypow10(3)=1000.0\n");
    printf("45: mypow10(-2)=0.01\n");

    // convert tests
    printf("46: convert(255,16,0)=ff\n");
    printf("47: convert(255,16,1)=FF\n");
    printf("48: convert(0,10,0)=0\n");
    printf("49: convert(123,10,0)=321 (reversed)\n");

    // cast tests
    printf("50: cast(3.7)=3\n");
    printf("51: cast(0.0)=0\n");

    // %g with small values
    r = rpl_snprintf(buf, sizeof(buf), "%g", 100000.0);
    printf("52: [%s] len=%d\n", buf, r);

    r = rpl_snprintf(buf, sizeof(buf), "%g", 1000000.0);
    printf("53: [%s] len=%d\n", buf, r);

    // Empty string
    r = rpl_snprintf(buf, sizeof(buf), "%s", "");
    printf("54: [%s] len=%d\n", buf, r);

    // Width with string
    r = rpl_snprintf(buf, sizeof(buf), "%5s", "Hi");
    printf("55: [%s] len=%d\n", buf, r);

    // Zero-padded float
    r = rpl_snprintf(buf, sizeof(buf), "%010.2f", 3.14);
    printf("56: [%s] len=%d\n", buf, r);

    // Negative zero-padded
    r = rpl_snprintf(buf, sizeof(buf), "%010.2f", -3.14);
    printf("57: [%s] len=%d\n", buf, r);

    return 0;
}
