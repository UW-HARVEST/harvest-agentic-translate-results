use std::mem::size_of;
fn main() {
    // RHBloom has: count(usize), nbuckets(usize), buckets(Vec<u64>), k(usize), m(usize), bits(Vec<u8>)
    // Vec is 3 * usize (ptr, len, cap)
    // So: 4 * usize + 2 * 3 * usize = 10 * usize = 80 bytes on 64-bit
    println!("usize: {}", size_of::<usize>());
    println!("Vec<u64>: {}", size_of::<Vec<u64>>());
    println!("Vec<u8>: {}", size_of::<Vec<u8>>());
    // Estimate: 4*8 + 2*24 = 32 + 48 = 80
    println!("estimated RHBloom size: {}", 4 * size_of::<usize>() + 2 * size_of::<Vec<u64>>());
}
EOF
