    42	            m: m0,
    43	            bits: Vec::new(),
    44	        }
    45	    }
    46	    pub fn memsize(&self) -> usize {
    47	        let base = std::mem::size_of::<RHBloom>();
    48	        base + if !self.bits.is_empty() {
