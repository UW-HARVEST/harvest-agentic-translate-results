    24	impl RHBloom {
    25	    pub fn new(n: usize, p: f64) -> Self {
    26	        let n = if n < 16 { 16 } else { n };
    27	
    28	        let m = (n as f64 * p.ln() / (1.0 / 2.0_f64.powf(2.0_f64.ln())).ln()) as usize;
    29	        let k = ((m as f64 / n as f64) * 2.0_f64.ln()).round() as usize;
    30	
