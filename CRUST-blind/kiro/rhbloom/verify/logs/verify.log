#include <stdio.h>
#include <math.h>
#include "rhbloom.h"

unsigned int murmurhash2(const void * key, int len, const unsigned int seed) {
    const unsigned int m = 0x5bd1e995;
    const int r = 24;
    unsigned int h = seed ^ len;
    const unsigned char * data = (const unsigned char *)key;
    while(len >= 4) {
        unsigned int k = *(unsigned int *)data;
        k *= m; k ^= k >> r; k *= m; h *= m; h ^= k;
        data += 4; len -= 4;
    }
    switch(len) {
    case 3: h ^= data[2] << 16;
    case 2: h ^= data[1] << 8;
    case 1: h ^= data[0]; h *= m;
    };
    h ^= h >> 13; h *= m; h ^= h >> 15;
    return h;
}
uint64_t hash(int x) { return murmurhash2(&x, sizeof(int), 0); }

int main() {
    // Check upgrade transition more carefully for n=16
    printf("=== UPGRADE TRANSITION DETAIL n=16 p=0.01 ===\n");
    {
        struct rhbloom *b = rhbloom_new(16, 0.01);
        printf("before any add: upgraded=%d nbuckets(via memsize)=%zu\n", rhbloom_upgraded(b), rhbloom_memsize(b));
        // The first add triggers grow since count==0 == nbuckets>>1 (0==0)
        rhbloom_add(b, hash(0));
        printf("after 1 add: upgraded=%d memsize=%zu\n", rhbloom_upgraded(b), rhbloom_memsize(b));
        rhbloom_free(b);
    }

    // Check n=100 upgrade point
    printf("\n=== UPGRADE TRANSITION n=100 p=0.01 ===\n");
    {
        struct rhbloom *b = rhbloom_new(100, 0.01);
        for (int i = 0; i < 200; i++) {
            rhbloom_add(b, hash(i));
            if (rhbloom_upgraded(b)) {
                printf("upgraded at add %d, memsize=%zu\n", i, rhbloom_memsize(b));
                break;
            }
        }
        rhbloom_free(b);
    }

    // Check n=1000 upgrade point
    printf("\n=== UPGRADE TRANSITION n=1000 p=0.01 ===\n");
    {
        struct rhbloom *b = rhbloom_new(1000, 0.01);
        for (int i = 0; i < 2000; i++) {
            rhbloom_add(b, hash(i));
            if (rhbloom_upgraded(b)) {
                printf("upgraded at add %d, memsize=%zu\n", i, rhbloom_memsize(b));
                break;
            }
        }
        rhbloom_free(b);
    }

    // Memsize after adds in robinhood phase
    printf("\n=== MEMSIZE DURING ROBINHOOD n=1000 p=0.01 ===\n");
    {
        struct rhbloom *b = rhbloom_new(1000, 0.01);
        printf("0 adds: memsize=%zu\n", rhbloom_memsize(b));
        rhbloom_add(b, hash(0));
        printf("1 add: memsize=%zu upgraded=%d\n", rhbloom_memsize(b), rhbloom_upgraded(b));
        for (int i = 1; i < 8; i++) rhbloom_add(b, hash(i));
        printf("8 adds: memsize=%zu upgraded=%d\n", rhbloom_memsize(b), rhbloom_upgraded(b));
        for (int i = 8; i < 16; i++) rhbloom_add(b, hash(i));
        printf("16 adds: memsize=%zu upgraded=%d\n", rhbloom_memsize(b), rhbloom_upgraded(b));
        for (int i = 16; i < 32; i++) rhbloom_add(b, hash(i));
        printf("32 adds: memsize=%zu upgraded=%d\n", rhbloom_memsize(b), rhbloom_upgraded(b));
        for (int i = 32; i < 64; i++) rhbloom_add(b, hash(i));
        printf("64 adds: memsize=%zu upgraded=%d\n", rhbloom_memsize(b), rhbloom_upgraded(b));
        rhbloom_free(b);
    }

    // Test with n=100, p=0.1 (different params)
    printf("\n=== n=100 p=0.1 ===\n");
    {
        struct rhbloom *b = rhbloom_new(100, 0.1);
        int nn = 101;
        for (int i = 0; i < nn; i++) rhbloom_add(b, hash(i));
        printf("upgraded=%d memsize=%zu\n", rhbloom_upgraded(b), rhbloom_memsize(b));
        int hits = 0;
        for (int i = 0; i < nn; i++) if (rhbloom_test(b, hash(i))) hits++;
        printf("hits_present=%d\n", hits);
        int fp = 0;
        for (int i = nn; i < nn*2; i++) if (rhbloom_test(b, hash(i))) fp++;
        printf("false_positives=%d\n", fp);
        rhbloom_free(b);
    }

    // Hash values for reference
    printf("\n=== HASH VALUES ===\n");
    for (int i = 0; i < 10; i++) {
        printf("hash(%d) = %llu\n", i, (unsigned long long)hash(i));
    }

    return 0;
}
EOF
