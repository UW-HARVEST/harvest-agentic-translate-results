#include "src/include/Common.h"
#include "src/include/Polynomial.h"
#include "src/include/Channel.h"
#include <stdio.h>
#include <string.h>

int main() {
    // Test poly_sub
    Polynomial p1, p2, result;
    Coeff m1[3] = {5, 3, 1};
    Coeff m2[3] = {1, 2, 3};
    Coeff mr[3];
    set_polynomial(&p1, m1, 3);
    set_polynomial(&p2, m2, 3);
    set_polynomial(&result, mr, 3);
    poly_sub(&p1, &p2, &result, 10);
    printf("poly_sub [5,3,1]-[1,2,3] mod 10: [%ld,%ld,%ld]\n", mr[0], mr[1], mr[2]);

    // Test poly_sub with negative results
    Coeff m3[3] = {1, 2, 3};
    Coeff m4[3] = {5, 3, 1};
    Coeff mr2[3];
    set_polynomial(&p1, m3, 3);
    set_polynomial(&p2, m4, 3);
    set_polynomial(&result, mr2, 3);
    poly_sub(&p1, &p2, &result, 10);
    printf("poly_sub [1,2,3]-[5,3,1] mod 10: [%ld,%ld,%ld]\n", mr2[0], mr2[1], mr2[2]);

    // Test poly_sub_scaler
    Coeff m5[3] = {5, 10, 15};
    Coeff mr3[3];
    set_polynomial(&p1, m5, 3);
    set_polynomial(&result, mr3, 3);
    poly_sub_scaler(&p1, 3, &result, 10);
    printf("poly_sub_scaler [5,10,15] - 3 mod 10: [%ld,%ld,%ld]\n", mr3[0], mr3[1], mr3[2]);

    // Test poly_add_scaler
    Coeff m6[3] = {5, 10, 15};
    Coeff mr4[3];
    set_polynomial(&p1, m6, 3);
    set_polynomial(&result, mr4, 3);
    poly_add_scaler(&p1, 3, &result, 10);
    printf("poly_add_scaler [5,10,15] + 3 mod 10: [%ld,%ld,%ld]\n", mr4[0], mr4[1], mr4[2]);

    // Test poly_fit
    Coeff m7[5] = {0, 0, 3, 5, 7};
    Polynomial pfit;
    set_polynomial(&pfit, m7, 5);
    poly_fit(&pfit, 10);
    printf("poly_fit [0,0,3,5,7] mod 10: size=%zu coeffs=[", pfit.size);
    for (size_t i = 0; i < pfit.size; i++) printf("%ld%s", pfit.coeffs[i], i<pfit.size-1?",":"");
    printf("]\n");

    // Test poly_degree
    Coeff m8[5] = {0, 0, 0, 0, 5};
    Polynomial pdeg;
    set_polynomial(&pdeg, m8, 5);
    printf("poly_degree [0,0,0,0,5]: %lu\n", poly_degree(&pdeg));

    Coeff m9[5] = {0, 0, 0, 0, 0};
    set_polynomial(&pdeg, m9, 5);
    printf("poly_degree [0,0,0,0,0]: %lu\n", poly_degree(&pdeg));

    // Test channel init
    Channel ch;
    init_channel(&ch, 2, 33, 1);
    printf("channel init(2,33,1): p=%lu q=%lu w=%lu\n", ch.p, ch.q, ch.w);

    init_channel(&ch, 5, 10, 1);
    printf("channel init(5,10,1): p=%lu q=%lu w=%lu\n", ch.p, ch.q, ch.w);

    init_channel(&ch, 5, 26, 1);
    printf("channel init(5,26,1): p=%lu q=%lu w=%lu\n", ch.p, ch.q, ch.w);

    // Test coef_sum
    Coeff m10[4] = {1, -2, 3, -4};
    Polynomial psum;
    set_polynomial(&psum, m10, 4);
    printf("coef_sum [1,-2,3,-4]: %ld\n", coef_sum(&psum));

    // Test poly_lshift
    Coeff lm1[4] = {1, 2, 3, 4};
    Coeff lm2[3] = {1, 1, 1};
    Coeff lmr[4];
    Polynomial lp1, lp2, lresult;
    set_polynomial(&lp1, lm1, 4);
    set_polynomial(&lp2, lm2, 3);
    set_polynomial(&lresult, lmr, 4);
    int ret = poly_lshift(&lp1, &lp2, &lresult, 10);
    printf("poly_lshift [1,2,3,4] by [1,1,1] mod 10: ret=%d size=%zu coeffs=[", ret, lresult.size);
    for (size_t i = 0; i < lresult.size; i++) printf("%ld%s", lresult.coeffs[i], i<lresult.size-1?",":"");
    printf("]\n");

    // Test poly_mod
    Coeff mm1[4] = {1, 2, 3, 4};
    Coeff mm2[3] = {1, 1, 1};
    Polynomial pm1, pm2;
    set_polynomial(&pm1, mm1, 4);
    set_polynomial(&pm2, mm2, 3);
    poly_mod(&pm1, &pm2, 10);
    printf("poly_mod [1,2,3,4] by [1,1,1] mod 10: size=%zu coeffs=[", pm1.size);
    for (size_t i = 0; i < pm1.size; i++) printf("%ld%s", pm1.coeffs[i], i<pm1.size-1?",":"");
    printf("]\n");

    // Test scale_transform return value
    printf("scale_transform returns: documented as 1 in C code\n");

    // Test poly_add with different sizes
    Coeff da1[3] = {1, 2, 3};
    Coeff da2[5] = {10, 20, 30, 40, 50};
    Coeff dar[5];
    Polynomial dp1, dp2, dresult;
    set_polynomial(&dp1, da1, 3);
    set_polynomial(&dp2, da2, 5);
    set_polynomial(&dresult, dar, 5);
    poly_add(&dp1, &dp2, &dresult, 100);
    printf("poly_add [1,2,3]+[10,20,30,40,50] mod 100 (diff sizes): [");
    for (size_t i = 0; i < dresult.size; i++) printf("%ld%s", dar[i], i<dresult.size-1?",":"");
    printf("]\n");

    // Test poly_sub with different sizes
    Coeff ds1[3] = {1, 2, 3};
    Coeff ds2[5] = {10, 20, 30, 40, 50};
    Coeff dsr[5];
    set_polynomial(&dp1, ds1, 3);
    set_polynomial(&dp2, ds2, 5);
    set_polynomial(&dresult, dsr, 5);
    poly_sub(&dp1, &dp2, &dresult, 100);
    printf("poly_sub [1,2,3]-[10,20,30,40,50] mod 100 (diff sizes): [");
    for (size_t i = 0; i < dresult.size; i++) printf("%ld%s", dsr[i], i<dresult.size-1?",":"");
    printf("]\n");

    return 0;
}
