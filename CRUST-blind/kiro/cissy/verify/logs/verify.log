#include <stdio.h>
#include <stdbool.h>

bool isBinChar(char c) {
  switch(c) {
  case 1 ... 8:
  case 11:
  case 12:
  case 14 ... 26:
  case 28 ... 31:
  case 127:
    return true;
  }
  return false;
}

int main() {
    // Test specific values
    printf("0: %d\n", isBinChar(0));
    printf("1: %d\n", isBinChar(1));
    printf("8: %d\n", isBinChar(8));
    printf("9(tab): %d\n", isBinChar(9));
    printf("10(lf): %d\n", isBinChar(10));
    printf("11: %d\n", isBinChar(11));
    printf("12: %d\n", isBinChar(12));
    printf("13(cr): %d\n", isBinChar(13));
    printf("14: %d\n", isBinChar(14));
    printf("26: %d\n", isBinChar(26));
    printf("27(esc): %d\n", isBinChar(27));
    printf("28: %d\n", isBinChar(28));
    printf("31: %d\n", isBinChar(31));
    printf("32(space): %d\n", isBinChar(32));
    printf("65(A): %d\n", isBinChar(65));
    printf("126(~): %d\n", isBinChar(126));
    printf("127(del): %d\n", isBinChar(127));
    return 0;
}
EOF
