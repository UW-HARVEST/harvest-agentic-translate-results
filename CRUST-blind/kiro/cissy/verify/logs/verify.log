#include <stdio.h>
#include <string.h>
#include "range.h"

int main() {
    char buf[1024];
    
    // Test parseIntRanges with various inputs
    struct rangeElement* l;
    
    l = parseIntRanges("1");
    memset(buf, 0, sizeof(buf));
    rangeListToString(buf, sizeof(buf), l);
    printf("parse '1' => %s\n", buf);
    rangeFree(l);
    
    l = parseIntRanges("1,2,3");
    memset(buf, 0, sizeof(buf));
    rangeListToString(buf, sizeof(buf), l);
    printf("parse '1,2,3' => %s\n", buf);
    rangeFree(l);
    
    l = parseIntRanges("1-5");
    memset(buf, 0, sizeof(buf));
    rangeListToString(buf, sizeof(buf), l);
    printf("parse '1-5' => %s\n", buf);
    rangeFree(l);
    
    l = parseIntRanges("3-");
    memset(buf, 0, sizeof(buf));
    rangeListToString(buf, sizeof(buf), l);
    printf("parse '3-' => %s\n", buf);
    rangeFree(l);
    
    l = parseIntRanges("1,3-5,7-");
    memset(buf, 0, sizeof(buf));
    rangeListToString(buf, sizeof(buf), l);
    printf("parse '1,3-5,7-' => %s\n", buf);
    rangeFree(l);
    
    l = parseIntRanges("3-3");
    memset(buf, 0, sizeof(buf));
    rangeListToString(buf, sizeof(buf), l);
    printf("parse '3-3' => %s\n", buf);
    rangeFree(l);

    // Test add_start_end with start==end => SINGLE
    l = NULL;
    l = rangeAddStartEnd(5, 5, l);
    memset(buf, 0, sizeof(buf));
    rangeListToString(buf, sizeof(buf), l);
    printf("addStartEnd(5,5) => %s\n", buf);
    rangeFree(l);

    // Test contains_num with GreaterEqual
    l = NULL;
    l = rangeAddGreaterEqual(1, l);
    printf("GE(1) contains 1: %d\n", rangeContainsNum(1, l));
    printf("GE(1) contains 0: %d\n", rangeContainsNum(0, l));
    printf("GE(1) contains 100: %d\n", rangeContainsNum(100, l));
    rangeFree(l);

    return 0;
}
EOF
