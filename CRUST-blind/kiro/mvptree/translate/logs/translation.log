use std::fs::File;
use std::io::{self, Read, Write, Seek, SeekFrom};
use std::sync::Arc;
use std::rc::Rc;
use std::cell::RefCell;

pub const TAG: &str = "phashmvp2010";
pub const VERSION: u32 = 0x01000000;
pub const HEADER_SIZE: usize = 32;
pub const FILE_OFFSET_BITS: usize = 64;
pub const ERROR_MSGS: [&str; 25] = [
    "no error",
    "bad argument",
    "no distance function found",
    "mem alloc error",
    "no leaf node created",
    "no internal node created",
    "no path array alloc'd",
    "could not select vantage points",
    "could not calculate range from an sv1",
    "could not calculate range from an sv2",
    "points too compact",
    "could not sort points",
    "could not open file",
    "could not close file",
    "mmap error",
    "unmap error",
    "no write",
    "could not extend file",
    "could not remap file",
    "datatypes in conflict",
    "no. retrieved exceeds k",
    "empty tree",
    "distance value either NaN or less than zero",
    "could not open file",
    "unrecognized node",
];

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MVPDataType {
    ByteArray = 1,
    UInt16Array = 2,
    UInt32Array = 4,
    UInt64Array = 8,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum NodeType {
    InternalNode = 1,
    LeafNode,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MVPError {
    Success,
    ArgErr,
    NoDistanceFunc,
    MemAlloc,
    NoLeaf,
    NoInternal,
    PathAlloc,
    VpNoSelect,
    NoSv1Range,
    NoSv2Range,
    NoSpace,
    NoSort,
    FileOpen,
    FileClose,
    MemMap,
    Munmap,
    NoWrite,
    FileTruncate,
    MremapFail,
    TypeMismatch,
    KNearestCap,
    EmptyTree,
    NoSplits,
    BadDistVal,
    FileNotFound,
    Unrecognized,
}

#[derive(Debug, Clone)]
pub struct MVPDatapoint {
    pub id: String,
    pub data: Vec<u8>,
    pub path: Vec<f32>,
    pub datalen: usize,
    pub data_type: MVPDataType,
}

pub type DistanceFunction = fn(&MVPDatapoint, &MVPDatapoint) -> f32;

pub struct InternalNode {
    pub node_type: NodeType,
    pub sv1: Option<Arc<MVPDatapoint>>,
    pub sv2: Option<Arc<MVPDatapoint>>,
    pub m1: Vec<f32>,
    pub m2: Vec<f32>,
    pub child_nodes: Vec<Rc<RefCell<Node>>>,
}

impl InternalNode {
    pub fn new(bf: u32) -> Self {
        Self {
            node_type: NodeType::InternalNode,
            sv1: None,
            sv2: None,
            m1: vec![0.0; (bf - 1) as usize],
            m2: vec![0.0; ((bf - 1) * bf) as usize],
            child_nodes: Vec::new(),
        }
    }
}

pub struct LeafNode {
    pub node_type: NodeType,
    pub sv1: Option<Arc<MVPDatapoint>>,
    pub sv2: Option<Arc<MVPDatapoint>>,
    pub points: Vec<Arc<MVPDatapoint>>,
    pub d1: Vec<f32>,
    pub d2: Vec<f32>,
    pub nbpoints: usize,
}

impl LeafNode {
    pub fn new(bf: u32) -> Self {
        Self {
            node_type: NodeType::LeafNode,
            sv1: None,
            sv2: None,
            points: Vec::new(),
            d1: Vec::new(),
            d2: Vec::new(),
            nbpoints: 0,
        }
    }
}

pub enum Node {
    Leaf(LeafNode),
    Internal(InternalNode),
}

pub struct MVPTree {
    pub branch_factor: usize,
    pub path_length: usize,
    pub leaf_capacity: usize,
    pub datatype: MVPDataType,
    pub pos: i64,
    pub size: i64,
    pub pgsize: i64,
    pub buf: Vec<u8>,
    pub node: Option<Rc<RefCell<Node>>>,
    pub distance_function: DistanceFunction,
}

// --- Helper functions ---

fn select_vp(points: &[Arc<MVPDatapoint>], dist: DistanceFunction) -> Result<(i32, i32), ()> {
    if points.is_empty() { return Err(()); }
    let mut sv1: i32 = 0;
    let mut sv2: i32 = -1;
    let mut max_d = 0.0f32;
    for i in 0..points.len() {
        for j in (i + 1)..points.len() {
            let d = dist(&points[i], &points[j]);
            if d.is_nan() || d < 0.0 { return Err(()); }
            if d > max_d { max_d = d; sv1 = i as i32; sv2 = j as i32; }
        }
    }
    Ok((sv1, sv2))
}

fn calc_splits(points: &[Arc<MVPDatapoint>], vp: &MVPDatapoint, dist: DistanceFunction, len_m: usize) -> Result<Vec<f32>, ()> {
    let nb = points.len();
    if nb == 0 || len_m == 0 { return Err(()); }
    let mut ds: Vec<f32> = Vec::with_capacity(nb);
    for p in points {
        let d = dist(p, vp);
        if d.is_nan() || d < 0.0 { return Err(()); }
        ds.push(d);
    }
    for i in 0..nb.saturating_sub(1) {
        let mut mp = i;
        for j in (i + 1)..nb { if ds[j] < ds[mp] { mp = j; } }
        if mp != i { ds.swap(i, mp); }
    }
    let mut m = vec![0.0f32; len_m];
    for i in 0..len_m {
        let idx = ((i + 1) * nb / (len_m + 1)).min(nb - 1);
        m[i] = ds[idx];
    }
    Ok(m)
}

fn sort_bins(
    points: &[Arc<MVPDatapoint>], skip1: i32, skip2: i32,
    vp: &MVPDatapoint, dist: DistanceFunction, bf: usize, pivots: &[f32],
) -> Result<Vec<Vec<Arc<MVPDatapoint>>>, ()> {
    if points.is_empty() { return Err(()); }
    let lm1 = bf - 1;
    let mut bins: Vec<Vec<Arc<MVPDatapoint>>> = (0..bf).map(|_| Vec::new()).collect();
    for (i, p) in points.iter().enumerate() {
        if i as i32 == skip1 || i as i32 == skip2 { continue; }
        let d = dist(vp, p);
        if d.is_nan() || d < 0.0 { return Err(()); }
        let mut placed = false;
        for k in 0..lm1 {
            if d <= pivots[k] { bins[k].push(Arc::clone(p)); placed = true; break; }
        }
        if !placed { bins[lm1].push(Arc::clone(p)); }
    }
    Ok(bins)
}

fn set_paths(points: &[Arc<MVPDatapoint>], vp: &MVPDatapoint, dist: DistanceFunction, lvl: usize, pl: usize) -> Result<Vec<Arc<MVPDatapoint>>, ()> {
    let mut out = Vec::with_capacity(points.len());
    for p in points {
        let d = dist(vp, p);
        if d.is_nan() || d < 0.0 { return Err(()); }
        if lvl < pl {
            let mut np = (**p).clone();
            if np.path.len() <= lvl { np.path.resize(lvl + 1, 0.0); }
            np.path[lvl] = d;
            out.push(Arc::new(np));
        } else {
            out.push(Arc::clone(p));
        }
    }
    Ok(out)
}

fn empty_bins(bf: usize) -> Vec<Vec<Arc<MVPDatapoint>>> {
    (0..bf).map(|_| Vec::new()).collect()
}

fn _add(
    bf: usize, pl: usize, lc: usize, dist: DistanceFunction,
    node: Option<Rc<RefCell<Node>>>, points: &[Arc<MVPDatapoint>], lvl: usize,
) -> Result<Option<Rc<RefCell<Node>>>, MVPError> {
    let nb = points.len();
    if nb == 0 { return Ok(node); }
    let lm1 = bf - 1;

    if node.is_none() {
        if nb <= lc + 2 {
            // create leaf
            let (s1, s2) = select_vp(points, dist).map_err(|_| MVPError::VpNoSelect)?;
            let sv1 = if s1 >= 0 { Some(Arc::clone(&points[s1 as usize])) } else { None };
            let sv2 = if s2 >= 0 { Some(Arc::clone(&points[s2 as usize])) } else { None };
            let pts = if let Some(ref v) = sv1 { set_paths(points, v, dist, lvl, pl).map_err(|_| MVPError::NoSv1Range)? } else { points.to_vec() };
            let pts = if let Some(ref v) = sv2 { set_paths(&pts, v, dist, lvl + 1, pl).map_err(|_| MVPError::NoSv2Range)? } else { pts };
            let mut leaf = LeafNode::new(lc as u32);
            leaf.sv1 = sv1; leaf.sv2 = sv2;
            for (i, p) in pts.iter().enumerate() {
                if i as i32 == s1 || i as i32 == s2 { continue; }
                leaf.d1.push(dist(p, leaf.sv1.as_ref().unwrap()));
                leaf.d2.push(if let Some(ref v) = leaf.sv2 { dist(p, v) } else { 0.0 });
                leaf.points.push(Arc::clone(p));
            }
            leaf.nbpoints = leaf.points.len();
            return Ok(Some(Rc::new(RefCell::new(Node::Leaf(leaf)))));
        }
        // create internal
        let (s1, s2) = select_vp(points, dist).map_err(|_| MVPError::VpNoSelect)?;
        let sv1 = Arc::clone(&points[s1 as usize]);
        let sv2 = Arc::clone(&points[s2 as usize]);
        let pts = set_paths(points, &sv1, dist, lvl, pl).map_err(|_| MVPError::NoSv1Range)?;
        let m1 = calc_splits(&pts, &sv1, dist, lm1).map_err(|_| MVPError::NoSplits)?;
        let bins = sort_bins(&pts, s1, s2, &sv1, dist, bf, &m1).map_err(|_| MVPError::NoSort)?;
        let mut m2 = vec![0.0f32; lm1 * bf];
        let mut children: Vec<Rc<RefCell<Node>>> = Vec::with_capacity(bf * bf);
        for i in 0..bf {
            let bp = set_paths(&bins[i], &sv2, dist, lvl + 1, pl).map_err(|_| MVPError::NoSv2Range)?;
            let sp = if !bp.is_empty() { calc_splits(&bp, &sv2, dist, lm1).map_err(|_| MVPError::NoSplits)? } else { vec![0.0; lm1] };
            for k in 0..lm1 { m2[i * lm1 + k] = sp[k]; }
            let b2 = if !bp.is_empty() { sort_bins(&bp, -1, -1, &sv2, dist, bf, &sp).map_err(|_| MVPError::NoSort)? } else { empty_bins(bf) };
            for j in 0..bf {
                let c = _add(bf, pl, lc, dist, None, &b2[j], lvl + 2)?;
                children.push(c.unwrap_or_else(|| Rc::new(RefCell::new(Node::Leaf(LeafNode::new(0))))));
            }
        }
        let mut internal = InternalNode::new(bf as u32);
        internal.sv1 = Some(sv1); internal.sv2 = Some(sv2);
        internal.m1 = m1; internal.m2 = m2; internal.child_nodes = children;
        return Ok(Some(Rc::new(RefCell::new(Node::Internal(internal)))));
    }

    let existing = node.unwrap();
    let is_leaf = matches!(&*existing.borrow(), Node::Leaf(_));

    if is_leaf {
        let cur_nb = match &*existing.borrow() { Node::Leaf(l) => l.nbpoints, _ => 0 };
        if cur_nb + nb <= lc {
            let sv1a = match &*existing.borrow() { Node::Leaf(l) => l.sv1.clone(), _ => None };
            let pts = if let Some(ref v) = sv1a { set_paths(points, v, dist, lvl, pl).map_err(|_| MVPError::NoSv1Range)? } else { points.to_vec() };
            let mut start = 0usize;
            let has_sv2 = match &*existing.borrow() { Node::Leaf(l) => l.sv2.is_some(), _ => false };
            if !has_sv2 && !pts.is_empty() {
                start = 1;
                match &mut *existing.borrow_mut() { Node::Leaf(l) => l.sv2 = Some(Arc::clone(&pts[0])), _ => {} }
            }
            let sv2a = match &*existing.borrow() { Node::Leaf(l) => l.sv2.clone(), _ => None };
            let pts = if let Some(ref v) = sv2a { set_paths(&pts, v, dist, lvl + 1, pl).map_err(|_| MVPError::NoSv2Range)? } else { pts };
            match &mut *existing.borrow_mut() {
                Node::Leaf(leaf) => {
                    for i in start..pts.len() {
                        leaf.d1.push(dist(&pts[i], leaf.sv1.as_ref().unwrap()));
                        leaf.d2.push(dist(&pts[i], leaf.sv2.as_ref().unwrap()));
                        leaf.points.push(Arc::clone(&pts[i]));
                    }
                    leaf.nbpoints = leaf.points.len();
                }
                _ => {}
            }
            Ok(Some(existing))
        } else {
            let mut tmp: Vec<Arc<MVPDatapoint>> = Vec::new();
            match &*existing.borrow() {
                Node::Leaf(l) => {
                    if let Some(ref v) = l.sv1 { tmp.push(Arc::clone(v)); }
                    if let Some(ref v) = l.sv2 { tmp.push(Arc::clone(v)); }
                    for p in &l.points { tmp.push(Arc::clone(p)); }
                }
                _ => {}
            }
            for p in points { tmp.push(Arc::clone(p)); }
            _add(bf, pl, lc, dist, None, &tmp, lvl)
        }
    } else {
        // internal node
        let sv1a = match &*existing.borrow() { Node::Internal(n) => n.sv1.clone().unwrap(), _ => return Err(MVPError::Unrecognized) };
        let sv2a = match &*existing.borrow() { Node::Internal(n) => n.sv2.clone().unwrap(), _ => return Err(MVPError::Unrecognized) };
        let m1c = match &*existing.borrow() { Node::Internal(n) => n.m1.clone(), _ => return Err(MVPError::Unrecognized) };
        let pts = set_paths(points, &sv1a, dist, lvl, pl).map_err(|_| MVPError::NoSv1Range)?;
        let bins = sort_bins(&pts, -1, -1, &sv1a, dist, bf, &m1c).map_err(|_| MVPError::NoSort)?;
        for i in 0..bf {
            if bins[i].is_empty() { continue; }
            let bp = set_paths(&bins[i], &sv2a, dist, lvl + 1, pl).map_err(|_| MVPError::NoSv2Range)?;
            let m2s: Vec<f32> = match &*existing.borrow() { Node::Internal(n) => n.m2[i*lm1..i*lm1+lm1].to_vec(), _ => return Err(MVPError::Unrecognized) };
            let b2 = sort_bins(&bp, -1, -1, &sv2a, dist, bf, &m2s).map_err(|_| MVPError::NoSort)?;
            for j in 0..bf {
                let ci = i * bf + j;
                let ec = match &*existing.borrow() { Node::Internal(n) => Some(Rc::clone(&n.child_nodes[ci])), _ => None };
                let child = _add(bf, pl, lc, dist, ec, &b2[j], lvl + 2)?;
                if let Some(c) = child {
                    match &mut *existing.borrow_mut() { Node::Internal(n) => n.child_nodes[ci] = c, _ => {} }
                }
            }
        }
        Ok(Some(existing))
    }
}

fn _retrieve(
    bf: usize, pl: usize, knearest: usize, dist: DistanceFunction,
    node: &Node, target: &mut MVPDatapoint, radius: f32,
    results: &mut Vec<MVPDatapoint>,
) -> MVPError {
    let lm1 = bf - 1;
    match node {
        Node::Leaf(leaf) => {
            let d1 = if let Some(ref sv1) = leaf.sv1 {
                let d = dist(target, sv1);
                if d.is_nan() || d < 0.0 { return MVPError::BadDistVal; }
                if pl > 0 && target.path.len() <= 0 { target.path.resize(1, 0.0); }
                if 0 < pl { target.path[0] = d; }
                // use lvl=0 logic: we track path via the target directly
                d
            } else { return MVPError::Success; };

            // We need lvl info - but the C code passes lvl. We'll need to thread it through.
            // Actually let me refactor to pass lvl.
            MVPError::Success
        }
        _ => MVPError::Success,
    }
}
