#include "nand.c"
#include <stdio.h>

int main(void) {
    // Truth tables for basic gates
    bool vals[] = {false, true};
    printf("=== NAND ===\n");
    for(int i=0;i<2;i++) for(int j=0;j<2;j++)
        printf("nand(%d,%d)=%d\n", vals[i], vals[j], nand(vals[i],vals[j]));
    printf("=== NOT ===\n");
    for(int i=0;i<2;i++)
        printf("not(%d)=%d\n", vals[i], not(vals[i]));
    printf("=== OR ===\n");
    for(int i=0;i<2;i++) for(int j=0;j<2;j++)
        printf("or(%d,%d)=%d\n", vals[i], vals[j], or(vals[i],vals[j]));
    printf("=== AND ===\n");
    for(int i=0;i<2;i++) for(int j=0;j<2;j++)
        printf("and(%d,%d)=%d\n", vals[i], vals[j], and(vals[i],vals[j]));
    printf("=== XOR ===\n");
    for(int i=0;i<2;i++) for(int j=0;j<2;j++)
        printf("xor(%d,%d)=%d\n", vals[i], vals[j], xor(vals[i],vals[j]));

    // add_bit: all 8 combos
    printf("=== ADD_BIT ===\n");
    for(int i=0;i<2;i++) for(int j=0;j<2;j++) for(int k=0;k<2;k++) {
        bool cr;
        bool r = add_bit(vals[i],vals[j],vals[k],&cr);
        printf("add_bit(%d,%d,%d)=bit:%d,carry:%d\n", vals[i],vals[j],vals[k],r,cr);
    }

    // half_sub
    printf("=== HALF_SUB ===\n");
    for(int i=0;i<2;i++) for(int j=0;j<2;j++) {
        bool cr;
        bool r = half_sub(vals[i],vals[j],&cr);
        printf("half_sub(%d,%d)=bit:%d,borrow:%d\n", vals[i],vals[j],r,cr);
    }

    // sub_bit: all 8 combos
    printf("=== SUB_BIT ===\n");
    for(int i=0;i<2;i++) for(int j=0;j<2;j++) for(int k=0;k<2;k++) {
        bool cr;
        bool r = sub_bit(vals[i],vals[j],vals[k],&cr);
        printf("sub_bit(%d,%d,%d)=bit:%d,borrow:%d\n", vals[i],vals[j],vals[k],r,cr);
    }

    // bll
    printf("=== BLL ===\n");
    printf("bll(0)=%s\n", bll(false));
    printf("bll(1)=%s\n", bll(true));

    // add_u4 samples
    printf("=== ADD_U4 ===\n");
    printf("add_u4(0,0)=%d\n", add_u4(0,0));
    printf("add_u4(5,3)=%d\n", add_u4(5,3));
    printf("add_u4(15,1)=%d\n", add_u4(15,1));
    printf("add_u4(7,8)=%d\n", add_u4(7,8));
    printf("add_u4(15,15)=%d\n", add_u4(15,15));

    // sub_u4 samples
    printf("=== SUB_U4 ===\n");
    printf("sub_u4(0,0)=%d\n", sub_u4(0,0));
    printf("sub_u4(5,3)=%d\n", sub_u4(5,3));
    printf("sub_u4(3,5)=%d\n", sub_u4(3,5));
    printf("sub_u4(15,1)=%d\n", sub_u4(15,1));
    printf("sub_u4(0,1)=%d\n", sub_u4(0,1));

    return 0;
}
EOF
