use expr::mapper_expr::*;

#[test]
fn test_simple_add() {
    let s = "y=1+2";
    let mut e = mapper_expr_new_from_string(s, 0, 0, 1);
    let inp = MapperSignalValue::I32(0);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    let result = outp.as_i32().unwrap();
    println!("1+2 = {}", result);
    assert_eq!(result, 3);
}

#[test]
fn test_simple_mul() {
    let s = "y=3*4";
    let mut e = mapper_expr_new_from_string(s, 0, 0, 1);
    let inp = MapperSignalValue::I32(0);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    let result = outp.as_i32().unwrap();
    println!("3*4 = {}", result);
    assert_eq!(result, 12);
}

#[test]
fn test_mul_div() {
    let s = "y=26*2/2";
    let mut e = mapper_expr_new_from_string(s, 0, 0, 1);
    let inp = MapperSignalValue::I32(0);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    let result = outp.as_i32().unwrap();
    println!("26*2/2 = {}", result);
    assert_eq!(result, 26);
}

#[test]
fn test_with_x() {
    let s = "y=x+1";
    let mut e = mapper_expr_new_from_string(s, 0, 0, 1);
    let inp = MapperSignalValue::I32(5);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    let result = outp.as_i32().unwrap();
    println!("x+1 with x=5 = {}", result);
    assert_eq!(result, 6);
}
