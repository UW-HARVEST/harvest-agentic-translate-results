use expr::mapper_expr::*;

#[test]
fn test1_float() {
    let s = "y=26*2/2+log10(pi)+2.*pow(2,1*(3+7*.1)*1.1+x{-6*2+12})*3*4+cos(2.)";
    let mut e = mapper_expr_new_from_string(s, 1, 1, 1);
    let inp = MapperSignalValue::F(3.0);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    let expected = 26.0*2.0/2.0 + (std::f32::consts::PI).log10() 
        + 2.0 * (2.0f32).powf(1.0*(3.0+7.0*0.1)*1.1 + 3.0)*3.0*4.0 + (2.0f32).cos();
    let result = outp.as_f32().unwrap();
    println!("test1: result={}, expected={}", result, expected);
    assert!((result - expected).abs() < 0.01, "test1 failed: {} vs {}", result, expected);
}

#[test]
fn test2_int() {
    let s = "y=26*2/2+x*30/(20*1)";
    let mut e = mapper_expr_new_from_string(s, 0, 0, 1);
    
    let inp = MapperSignalValue::I32(3);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    let expected = 26*2/2 + 3*30/(20*1);
    let result = outp.as_i32().unwrap();
    println!("test2a: result={}, expected={}", result, expected);
    assert_eq!(result, expected);

    let inp = MapperSignalValue::I32(321);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    let expected = 26*2/2 + 321*30/(20*1);
    let result = outp.as_i32().unwrap();
    println!("test2b: result={}, expected={}", result, expected);
    assert_eq!(result, expected);
}
EOF
