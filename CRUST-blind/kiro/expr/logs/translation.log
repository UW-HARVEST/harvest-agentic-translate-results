use expr::mapper_expr::*;

fn main() {
    // Test 1: float expression
    let str1 = "y=26*2/2+log10(pi)+2.*pow(2,1*(3+7*.1)*1.1+x{-6*2+12})*3*4+cos(2.)";
    let mut e = mapper_expr_new_from_string(str1, 1, 1, 1);
    let inp = MapperSignalValue::F(3.0);
    let outp = mapper_expr_evaluate(&mut e, &inp);
    
    let expected: f32 = 26.0*2.0/2.0 + (std::f32::consts::PI).log10() 
        + 2.0 * (2.0f32).powf(1.0*(3.0+7.0*0.1)*1.1 + 3.0) * 3.0 * 4.0 
        + (2.0f32).cos();
    
    println!("Test 1: got {:?}, expected {}", outp, expected);
    
    // Test 2: integer expression
    let str2 = "y=26*2/2+x*30/(20*1)";
    let mut e2 = mapper_expr_new_from_string(str2, 0, 0, 1);
    
    let inp2 = MapperSignalValue::I32(3);
    let outp2 = mapper_expr_evaluate(&mut e2, &inp2);
    let expected2 = 26*2/2 + 3*30/(20*1);
    println!("Test 2a: got {:?}, expected {}", outp2, expected2);
    
    let inp3 = MapperSignalValue::I32(321);
    let outp3 = mapper_expr_evaluate(&mut e2, &inp3);
    let expected3 = 26*2/2 + 321*30/(20*1);
    println!("Test 2b: got {:?}, expected {}", outp3, expected3);
}
EOF
