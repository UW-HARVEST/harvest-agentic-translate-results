        printf("slice 6,1000: byte_len=%zu\n", sl.byte_len);
        sl = slice_utf8_string(str, 7, 3);
        printf("slice 7,3: str_null=%d byte_len=%zu\n", sl.str == NULL, sl.byte_len);
        sl = slice_utf8_string(str, 6, 3);
        printf("slice 6,3: str_null=%d byte_len=%zu\n", sl.str == NULL, sl.byte_len);
    }
    // char count
    {
        utf8_string s = make_utf8_string("Hello Здравствуйте こんにちは 🚩😁");
        printf("char_count: %zu\n", utf8_char_count(s));
        utf8_string e = make_utf8_string("");
        printf("char_count empty: %zu\n", utf8_char_count(e));
    }
    // is_utf8_char_boundary
    {
        const char* s = "Hдこ😁";
        for (int i = 0; i <= 10; i++) {
            printf("boundary[%d]=%d\n", i, is_utf8_char_boundary(s+i));
        }
    }
    // nth_utf8_char
    {
        utf8_string s = make_utf8_string("Hello Здравствуйте こんにちは 🚩😁");
        utf8_char ch;
        ch = nth_utf8_char(s, 0);
        printf("nth 0: byte_len=%d\n", ch.byte_len);
        ch = nth_utf8_char(s, 20);
        printf("nth 20: byte_len=%d\n", ch.byte_len);
        ch = nth_utf8_char(s, 26);
        printf("nth 26: byte_len=%d\n", ch.byte_len);
        ch = nth_utf8_char(s, 100);
        printf("nth 100: str_null=%d byte_len=%d\n", ch.str == NULL, ch.byte_len);
        utf8_string e = make_utf8_string("");
        ch = nth_utf8_char(e, 0);
        printf("nth empty 0: str_null=%d byte_len=%d\n", ch.str == NULL, ch.byte_len);
    }
    // unicode_code_point
    {
        utf8_string s = make_utf8_string("Hдこ😁");
        utf8_char_iter iter = make_utf8_char_iter(s);
        printf("cp H: %u\n", unicode_code_point(next_utf8_char(&iter)));
        printf("cp д: %u\n", unicode_code_point(next_utf8_char(&iter)));
        printf("cp こ: %u\n", unicode_code_point(next_utf8_char(&iter)));
        printf("cp 😁: %u\n", unicode_code_point(next_utf8_char(&iter)));
    }
    // as_utf8_string
    {
        owned_utf8_string owned = make_utf8_string_lossy("test");
        utf8_string s = as_utf8_string(&owned);
        printf("as_utf8_string: byte_len=%zu str_eq=%d\n", s.byte_len, strcmp(s.str, "test") == 0);
        free_owned_utf8_string(&owned);
    }
    // free_owned_utf8_string
    {
        owned_utf8_string owned = make_utf8_string_lossy("test");
        free_owned_utf8_string(&owned);
        printf("after free: str_null=%d byte_len=%zu\n", owned.str == NULL, owned.byte_len);
    }
    // lossy with mixed invalid
    {
        owned_utf8_string s = make_utf8_string_lossy("\xC0He\xC0llo Здр\xC0авствуйте\xC0\xC0 こんに\xC0\xC0\xC0\xC0ちは 🚩\xC0😁\xC0");
        printf("lossy mixed: byte_len=%zu\n", s.byte_len);
        free_owned_utf8_string(&s);
    }
    return 0;
}
