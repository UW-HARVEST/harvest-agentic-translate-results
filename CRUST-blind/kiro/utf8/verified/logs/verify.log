#include "src/utf8.h"
#include <stdio.h>
#include <string.h>

int main() {
    // validate_utf8 on valid mixed string
    {
        utf8_validity v = validate_utf8("Hello Здравствуйте こんにちは 🚩😁");
        printf("validate_utf8 mixed: valid=%d valid_upto=%zu\n", v.valid, v.valid_upto);
    }
    // validate_utf8 on invalid
    {
        utf8_validity v = validate_utf8("Hello Здравствуйте\xC0\xC0 こんにちは 🚩😁");
        printf("validate_utf8 invalid: valid=%d valid_upto=%zu\n", v.valid, v.valid_upto);
    }
    // validate_utf8 on empty
    {
        utf8_validity v = validate_utf8("");
        printf("validate_utf8 empty: valid=%d valid_upto=%zu\n", v.valid, v.valid_upto);
    }
    // validate_utf8 boundary chars
    {
        utf8_validity v;
        v = validate_utf8("\x7F");
        printf("boundary 7F: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xC2\x80");
        printf("boundary C280: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xDF\xBF");
        printf("boundary DFBF: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xE0\xA0\x80");
        printf("boundary E0A080: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xEF\xBF\xBF");
        printf("boundary EFBFBF: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xF0\x90\x80\x80");
        printf("boundary F0908080: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xF7\xBF\xBF\xBF");
        printf("boundary F7BFBFBF: valid=%d upto=%zu\n", v.valid, v.valid_upto);
    }
    // surrogates
    {
        utf8_validity v;
        v = validate_utf8("\xED\xA0\x80");
        printf("surrogate EDA080: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xED\xBF\xBF");
        printf("surrogate EDBFBF: valid=%d upto=%zu\n", v.valid, v.valid_upto);
    }
    // overlong
    {
        utf8_validity v;
        v = validate_utf8("\xC1\x88");
        printf("overlong C188: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xE0\x81\x88");
        printf("overlong E08188: valid=%d upto=%zu\n", v.valid, v.valid_upto);
        v = validate_utf8("\xF0\x80\x81\x88");
        printf("overlong F0808188: valid=%d upto=%zu\n", v.valid, v.valid_upto);
    }
    // make_utf8_string valid
    {
        utf8_string s = make_utf8_string("Hello");
        printf("make_utf8_string Hello: str=%s byte_len=%zu\n", s.str, s.byte_len);
    }
    // make_utf8_string invalid
    {
        utf8_string s = make_utf8_string("\xC0\xC0");
        printf("make_utf8_string invalid: str=%s byte_len=%zu\n", s.str == NULL ? "NULL" : s.str, s.byte_len);
    }
    // make_utf8_string_lossy
    {
        owned_utf8_string s = make_utf8_string_lossy("hello\xC0\xC0 world!");
        printf("lossy: str=%s byte_len=%zu\n", s.str, s.byte_len);
        free_owned_utf8_string(&s);
    }
    {
        owned_utf8_string s = make_utf8_string_lossy("\xC0\xC0\xC0\xC0");
        printf("lossy all invalid: str=%s byte_len=%zu\n", s.str, s.byte_len);
        free_owned_utf8_string(&s);
    }
    // slice
    {
        utf8_string str = make_utf8_string("Hello Здравствуйте こんにちは 🚩😁");
        utf8_string sl;
        sl = slice_utf8_string(str, 6, 24);
        printf("slice 6,24: byte_len=%zu str=%.24s\n", sl.byte_len, sl.str);
        sl = slice_utf8_string(str, 1000, 1);
        printf("slice 1000,1: byte_len=%zu str_is_empty=%d\n", sl.byte_len, strcmp(sl.str, "") == 0);
        sl = slice_utf8_string(str, 6, 1000);
        printf("slice 6,1000: byte_len=%zu\n", sl.byte_len);
        sl = slice_utf8_string(str, 7, 3);
        printf("slice 7,3 non-boundary: str=%s byte_len=%zu\n", sl.str == NULL ? "NULL" : sl.str, sl.byte_len);
        sl = slice_utf8_string(str, 6, 3);
        printf("slice 6,3 non-boundary end: str=%s byte_len=%zu\n", sl.str == NULL ? "NULL" : sl.str, sl.byte_len);
    }
    // char iter
    {
        utf8_string str = make_utf8_string("Hдこ😁");
        utf8_char_iter iter = make_utf8_char_iter(str);
        utf8_char ch;
        ch = next_utf8_char(&iter);
        printf("iter ch1: byte_len=%d str=%.1s\n", ch.byte_len, ch.str);
        ch = next_utf8_char(&iter);
        printf("iter ch2: byte_len=%d str=%.2s\n", ch.byte_len, ch.str);
        ch = next_utf8_char(&iter);
        printf("iter ch3: byte_len=%d str=%.3s\n", ch.byte_len, ch.str);
        ch = next_utf8_char(&iter);
        printf("iter ch4: byte_len=%d str=%.4s\n", ch.byte_len, ch.str);
        ch = next_utf8_char(&iter);
        printf("iter exhausted: byte_len=%d\n", ch.byte_len);
    }
    // char count
    {
        utf8_string s = make_utf8_string("Hello Здравствуйте こんにちは 🚩😁");
        printf("char_count: %zu\n", utf8_char_count(s));
        utf8_string e = make_utf8_string("");
        printf("char_count empty: %zu\n", utf8_char_count(e));
    }
    // is_utf8_char_boundary
    {
        const char* s = "Hдこ😁";
        printf("boundary[0]=%d\n", is_utf8_char_boundary(s+0)); // H
        printf("boundary[1]=%d\n", is_utf8_char_boundary(s+1)); // д start
        printf("boundary[2]=%d\n", is_utf8_char_boundary(s+2)); // д cont
        printf("boundary[3]=%d\n", is_utf8_char_boundary(s+3)); // こ start
        printf("boundary[4]=%d\n", is_utf8_char_boundary(s+4)); // こ cont
        printf("boundary[5]=%d\n", is_utf8_char_boundary(s+5)); // こ cont
        printf("boundary[6]=%d\n", is_utf8_char_boundary(s+6)); // 😁 start
        printf("boundary[7]=%d\n", is_utf8_char_boundary(s+7)); // 😁 cont
        printf("boundary[8]=%d\n", is_utf8_char_boundary(s+8)); // 😁 cont
        printf("boundary[9]=%d\n", is_utf8_char_boundary(s+9)); // 😁 cont
    }
    // nth_utf8_char
    {
        utf8_string s = make_utf8_string("Hello Здравствуйте こんにちは 🚩😁");
        utf8_char ch;
        ch = nth_utf8_char(s, 0);
        printf("nth 0: byte_len=%d ch=%c\n", ch.byte_len, ch.str[0]);
        ch = nth_utf8_char(s, 20);
        printf("nth 20: byte_len=%d str=%.3s\n", ch.byte_len, ch.str);
        ch = nth_utf8_char(s, 26);
        printf("nth 26: byte_len=%d str=%.4s\n", ch.byte_len, ch.str);
        ch = nth_utf8_char(s, 100);
        printf("nth 100: str=%s byte_len=%d\n", ch.str == NULL ? "NULL" : ch.str, ch.byte_len);
        utf8_string e = make_utf8_string("");
        ch = nth_utf8_char(e, 0);
        printf("nth empty 0: str=%s byte_len=%d\n", ch.str == NULL ? "NULL" : ch.str, ch.byte_len);
    }
    // unicode_code_point
    {
        utf8_string s = make_utf8_string("Hдこ😁");
        utf8_char_iter iter = make_utf8_char_iter(s);
        printf("cp H: %u\n", unicode_code_point(next_utf8_char(&iter)));
        printf("cp д: %u\n", unicode_code_point(next_utf8_char(&iter)));
        printf("cp こ: %u\n", unicode_code_point(next_utf8_char(&iter)));
        printf("cp 😁: %u\n", unicode_code_point(next_utf8_char(&iter)));
    }
    // as_utf8_string
    {
        owned_utf8_string owned = make_utf8_string_lossy("test");
        utf8_string s = as_utf8_string(&owned);
        printf("as_utf8_string: str=%s byte_len=%zu\n", s.str, s.byte_len);
        free_owned_utf8_string(&owned);
    }
    // free_owned_utf8_string
    {
        owned_utf8_string owned = make_utf8_string_lossy("test");
        free_owned_utf8_string(&owned);
        printf("after free: str=%s byte_len=%zu\n", owned.str == NULL ? "NULL" : owned.str, owned.byte_len);
    }
    // validate_utf8_char
    {
        utf8_char_validity cv;
        cv = validate_utf8_char("H", 0);
        printf("validate_char H: valid=%d next=%zu\n", cv.valid, cv.next_offset);
        cv = validate_utf8_char("д", 0);
        printf("validate_char д: valid=%d next=%zu\n", cv.valid, cv.next_offset);
        cv = validate_utf8_char("こ", 0);
        printf("validate_char こ: valid=%d next=%zu\n", cv.valid, cv.next_offset);
        cv = validate_utf8_char("😁", 0);
        printf("validate_char 😁: valid=%d next=%zu\n", cv.valid, cv.next_offset);
        cv = validate_utf8_char("\xC0", 0);
        printf("validate_char C0: valid=%d next=%zu\n", cv.valid, cv.next_offset);
    }
    // lossy with mixed invalid
    {
        owned_utf8_string s = make_utf8_string_lossy("\xC0He\xC0llo Здр\xC0авствуйте\xC0\xC0 こんに\xC0\xC0\xC0\xC0ちは 🚩\xC0😁\xC0");
        printf("lossy mixed: byte_len=%zu\n", s.byte_len);
        free_owned_utf8_string(&s);
    }
    return 0;
}
