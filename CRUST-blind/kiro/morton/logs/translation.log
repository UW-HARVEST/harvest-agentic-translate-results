fn main() {
    use morton::morton::{morton, unmortoner, Morton};
    
    // Basic tests from C
    assert_eq!(morton(0, 0), 0);
    assert_eq!(morton(0, 1), 1);
    assert_eq!(morton(1, 0), 2);
    assert_eq!(morton(1, 1), 3);
    assert_eq!(morton(0b0011, 0b0000), 0b1010);
    assert_eq!(morton(0b0000, 0b0011), 0b0101);
    assert_eq!(morton(0b1100, 0b0011), 0b10100101);
    assert_eq!(morton(0x347210d1, 0xc6843fad), 0x5a346a180755e653);
    
    // Round-trip test
    let z = morton(0x347210d1, 0xc6843fad);
    let lo = unmortoner(z);
    let hi = unmortoner(z >> 1);
    // In C: unmorton returns .hi = unmortoner(z), .lo = unmortoner(z >> 1)
    // C test: m.lo == x (first arg=hi), m.hi == y (second arg=lo)... 
    // Wait, C signature: morton(unsigned hi, unsigned lo), unmorton: m.hi = unmortoner(z), m.lo = unmortoner(z>>1)
    // C test: morton(x, y) then m.lo == x, m.hi == y
    // So m.lo = unmortoner(z>>1) == x (which was hi param), m.hi = unmortoner(z) == y (which was lo param)
    // That means: unmortoner(z) extracts the lo bits, unmortoner(z>>1) extracts the hi bits
    assert_eq!(unmortoner(z), 0xc6843fad); // lo
    assert_eq!(unmortoner(z >> 1), 0x347210d1); // hi
    
    println!("All tests passed!");
}
