use coroutine::coroutine::*;
use std::any::Any;

fn foo(s: &mut Schedule, ud: &mut dyn Any) {
    let start = *ud.downcast_ref::<i32>().unwrap();
    for i in 0..5 {
        println!("coroutine {} : {}", coroutine_running(s), start + i);
        coroutine_yield(s);
    }
}

fn main() {
    let mut s = coroutine_open();
    let co1 = coroutine_new(&mut s, foo, Box::new(0i32));
    let co2 = coroutine_new(&mut s, foo, Box::new(100i32));
    println!("main start");
    while coroutine_status(&s, co1) != COROUTINE_DEAD && coroutine_status(&s, co2) != COROUTINE_DEAD {
        coroutine_resume(&mut s, co1);
        coroutine_resume(&mut s, co2);
    }
    println!("main end");
    coroutine_close(s);
}
EOF
