#include "avalanche.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* FNV-1a 32-bit */
void fnv_1a(char *key, size_t key_len, uint32_t* value)
{
    uint32_t hash = 0x811c9dc5;
    for (size_t i = 0; i < key_len; ++i) {
        hash ^= key[i];
        hash *= 0x01000193;
    }
    *value = hash;
}

void test_matrix_fprintf_formats() {
    matrix_t* M = matrix_alloc(2, 2);
    MATRIX_SET(M, 0, 0, 1.0);
    MATRIX_SET(M, 0, 1, 0.5);
    MATRIX_SET(M, 1, 0, 0.333333);
    MATRIX_SET(M, 1, 1, 0.0);

    printf("=== %%8.4f format ===\n");
    matrix_fprintf(stdout, "%8.4f", M);

    printf("=== %% 6.4g format ===\n");
    matrix_fprintf(stdout, "% 6.4g", M);

    printf("=== %%10.4e format ===\n");
    matrix_fprintf(stdout, "%10.4e", M);

    matrix_free(M);
}

void test_avalanche_small() {
    /* Use a 1-byte key, 1-word hash => 8 rows, 32 cols */
    /* Create a known input stream: 2 bytes (2 keys of 1 byte each) */
    FILE* tmp = tmpfile();
    unsigned char data[] = {0xAB, 0xCD};
    fwrite(data, 1, 2, tmp);
    rewind(tmp);

    matrix_t* results = matrix_alloc(8, 32);
    avalanche(&fnv_1a, tmp, 2, results);
    fclose(tmp);

    printf("=== avalanche 1-byte key, 2 keys ===\n");
    /* Print all values with high precision */
    for (size_t r = 0; r < 8; ++r) {
        for (size_t c = 0; c < 32; ++c) {
            printf("%.17g", MATRIX_GET(results, r, c));
            if (c < 31) printf(" ");
        }
        printf("\n");
    }
    matrix_free(results);
}

void test_avalanche_single_key() {
    /* Use a 1-byte key, 1-word hash => 8 rows, 32 cols */
    /* Single key: 0x42 */
    FILE* tmp = tmpfile();
    unsigned char data[] = {0x42};
    fwrite(data, 1, 1, tmp);
    rewind(tmp);

    matrix_t* results = matrix_alloc(8, 32);
    avalanche(&fnv_1a, tmp, 1, results);
    fclose(tmp);

    printf("=== avalanche 1-byte key, 1 key (0x42) ===\n");
    for (size_t r = 0; r < 8; ++r) {
        for (size_t c = 0; c < 32; ++c) {
            printf("%.17g", MATRIX_GET(results, r, c));
            if (c < 31) printf(" ");
        }
        printf("\n");
    }
    matrix_free(results);
}

void test_matrix_alloc_zeros() {
    matrix_t* M = matrix_alloc(3, 4);
    printf("=== matrix_alloc zeros ===\n");
    int all_zero = 1;
    for (size_t r = 0; r < 3; ++r) {
        for (size_t c = 0; c < 4; ++c) {
            if (MATRIX_GET(M, r, c) != 0.0) all_zero = 0;
        }
    }
    printf("all_zero=%d n_rows=%zu n_cols=%zu vals_len=%zu\n", all_zero, M->n_rows, M->n_cols, M->n_rows * M->n_cols);
    matrix_free(M);
}

void test_printf_formats_individual() {
    /* Test individual format strings */
    printf("=== individual printf formats ===\n");
    printf("f1=[%8.4f]\n", 3.14159);
    printf("f2=[%8.4f]\n", 0.0);
    printf("f3=[%8.4f]\n", -1.5);
    printf("g1=[% 6.4g]\n", 0.5);
    printf("g2=[% 6.4g]\n", 0.0);
    printf("g3=[% 6.4g]\n", 1234.5);
    printf("g4=[% 6.4g]\n", 0.00012345);
    printf("g5=[% 6.4g]\n", -0.5);
    printf("e1=[%10.4e]\n", 3.14159);
    printf("e2=[%10.4e]\n", 0.0);
    printf("e3=[%10.4e]\n", -1.5);
    printf("g6=[%g]\n", 100000.0);
    printf("g7=[%g]\n", 99999.9);
    printf("g8=[%g]\n", 1e-4);
    printf("g9=[%g]\n", 9.99999e-5);
}

void test_avalanche_empty_stream() {
    FILE* tmp = tmpfile();
    /* empty - no data */
    rewind(tmp);

    matrix_t* results = matrix_alloc(8, 32);
    avalanche(&fnv_1a, tmp, 100, results);
    fclose(tmp);

    printf("=== avalanche empty stream ===\n");
    int all_zero = 1;
    for (size_t r = 0; r < 8; ++r) {
        for (size_t c = 0; c < 32; ++c) {
            if (MATRIX_GET(results, r, c) != 0.0) all_zero = 0;
        }
    }
    printf("all_zero=%d\n", all_zero);
    matrix_free(results);
}

int main() {
    test_matrix_alloc_zeros();
    test_matrix_fprintf_formats();
    test_printf_formats_individual();
    test_avalanche_single_key();
    test_avalanche_small();
    test_avalanche_empty_stream();
    return 0;
}
