#include "src/hydra.h"
#include <stdio.h>
#include <string.h>
#include <assert.h>

int main() {
    setbuf(stdout, NULL);

    // Test CommandRun with NULL
    printf("CommandRun(NULL) = %d\n", CommandRun(NULL));

    // Test CommandRun with empty command
    Command *cmd1 = NewCommand('a', "test", NULL);
    printf("CommandRun(cmd with NULL command) = %d\n", CommandRun(cmd1));

    // Test CommandRun with a command string
    Command *cmd2 = NewCommand('b', "test", "hello");
    printf("CommandRun(cmd with 'hello') = ");
    int ret = CommandRun(cmd2);
    printf(" => returned %d\n", ret);

    // Test CommandRun with longer string
    Command *cmd3 = NewCommand('c', "test", "abcdefghij");
    printf("CommandRun(cmd with 'abcdefghij') = ");
    int ret2 = CommandRun(cmd3);
    printf(" => returned %d\n", ret2);

    // Test FindCommand
    Command *parent = NewCommand(0, "root", NULL);
    Command *childA = NewCommand('a', "alpha", NULL);
    Command *childB = NewCommand('b', "beta", NULL);
    CommandAddChild(parent, childA);
    CommandAddChild(parent, childB);

    Command *found = FindCommand(parent, 'a');
    printf("FindCommand('a') found: %s\n", found ? "yes" : "no");
    printf("FindCommand('a') key: %c\n", found->key);

    found = FindCommand(parent, 'z');
    printf("FindCommand('z') found: %s\n", found ? "yes" : "no");

    // Test TreeAddCommand
    Command *tree = NewCommand(0, "root", NULL);
    TreeAddCommand(tree, "a", "alpha", "cmd_a");
    TreeAddCommand(tree, "b", "beta", "cmd_b");
    TreeAddCommand(tree, "ab", "alpha-beta", "cmd_ab");

    Command *a = FindCommand(tree, 'a');
    printf("tree 'a' name: %s, command: %s\n", a->name, a->command);
    Command *ab = FindCommand(a, 'b');
    printf("tree 'ab' name: %s, command: %s\n", ab->name, ab->command);
    Command *b = FindCommand(tree, 'b');
    printf("tree 'b' name: %s, command: %s\n", b->name, b->command);

    // Test TreeAddCommand with multi-level keys creating intermediate nodes
    Command *tree2 = NewCommand(0, "root", NULL);
    TreeAddCommand(tree2, "abc", "deep", "cmd_deep");
    Command *t2a = FindCommand(tree2, 'a');
    printf("tree2 'a' name: %s\n", t2a->name);
    Command *t2ab = FindCommand(t2a, 'b');
    printf("tree2 'ab' name: %s\n", t2ab->name);
    Command *t2abc = FindCommand(t2ab, 'c');
    printf("tree2 'abc' name: %s, command: %s\n", t2abc->name, t2abc->command);

    // Test CommandAddChild ordering
    Command *p = NewCommand(0, "root", NULL);
    CommandAddChild(p, NewCommand('c', "charlie", NULL));
    CommandAddChild(p, NewCommand('a', "alpha", NULL));
    CommandAddChild(p, NewCommand('b', "bravo", NULL));
    Command *ch = p->children;
    printf("Ordered children: ");
    while(ch) {
        printf("%c ", ch->key);
        ch = ch->next;
    }
    printf("\n");

    // Test TreeAddCommand updating existing command
    Command *tree3 = NewCommand(0, "root", NULL);
    TreeAddCommand(tree3, "a", "old_name", "old_cmd");
    TreeAddCommand(tree3, "a", "new_name", "new_cmd");
    Command *updated = FindCommand(tree3, 'a');
    printf("Updated 'a' name: %s, command: %s\n", updated->name, updated->command);

    // Test ReadField and ReadUntilEOL
    char buf[] = "key,name,command\n";
    char *ptr = buf;
    char *k = ReadField(&ptr, "key");
    printf("ReadField key: '%s'\n", k);
    char *n = ReadField(&ptr, "name");
    printf("ReadField name: '%s'\n", n);
    char *cmd = ReadUntilEOL(&ptr);
    printf("ReadUntilEOL command: '%s'\n", cmd);

    // Test CommandRun with empty string
    Command *cmd4 = NewCommand('d', "test", "");
    printf("CommandRun(cmd with '') = %d\n", CommandRun(cmd4));

    // fprintf returns number of chars written
    // "hello" = 5 chars
    // "abcdefghij" = 10 chars
    // "" = 0 chars

    return 0;
}
EOF
