int main(void) {
    // Test hash values for str keys
    printf("=== String hash values ===\n");
    const char* strs[] = {"Hello", "World", "0", "1", "2", "-1"};
    for (int i = 0; i < 6; i++) {
        uint64_t code = 0;
        size_t len = strlen(strs[i]);
        for (size_t j = 0; j < len; j++) {
            code = (code * 256LLU + strs[i][j]) % 1000000007LLU;
        }
        printf("hash(\"%s\") = %" PRIu64 ", bucket(mod8) = %" PRIu64 "\n", strs[i], code, code % 8);
    }
    
    // Test struct hash for test2
    printf("\n=== Struct hash (custom) for test2 ===\n");
    typedef struct { size_t size; char* str; } str_t;
    // The custom hash: code = (code * 256 + str[i]) % 1007 -- note: no LLU, different from default
    const char* skeys[] = {"s1", "s2", "s3", "s4", "s5"};
    for (int i = 0; i < 5; i++) {
        uint64_t code = 0;
        size_t len = strlen(skeys[i]);
        for (size_t j = 0; j < len; j++) {
            code = (code * 256 + skeys[i][j]) % 1007;
        }
        printf("hash(\"%s\") = %" PRIu64 ", bucket(mod8) = %" PRIu64 "\n", skeys[i], code, code % 8);
    }
    
