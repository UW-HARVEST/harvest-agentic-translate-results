#include "src/dict.h"
#include <stdio.h>
#include <stdint.h>
#include <inttypes.h>

int main(void) {
    // dict_key for i32 keys
    dict_t* dict = dict_new(DICT_I32, sizeof(int32_t), sizeof(double));
    for (int32_t i = 0; i < 5; i++) {
        *(double*)dict_get(dict, i) = (double)i;
    }
    size_t size;
    const int32_t* keys = (const int32_t*)dict_key(dict, &size);
    printf("key count: %zu\n", size);
    for (size_t i = 0; i < size; i++) {
        printf("key[%zu] = %d\n", i, keys[i]);
    }
    free((void*)keys);
    dict_destroy(dict);
    return 0;
}
