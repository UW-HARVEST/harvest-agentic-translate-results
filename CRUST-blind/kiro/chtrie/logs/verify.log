use chtrie::chtrie::Chtrie;

fn main() {
    // Quick sanity check matching C edge_test
    let mut tr = Chtrie::new(100, 4).unwrap();
    let a = tr.walk(0, 0, 1);
    let b = tr.walk(0, 1, 1);
    let c = tr.walk(0, 2, 1);
    println!("a={} b={} c={}", a, b, c);
    
    tr.del(0, 1); // pushes 2
    tr.del(0, 2); // pushes 3
    
    let d = tr.walk(0, 3, 1);
    let e = tr.walk(1, 0, 1);
    println!("d={} e={}", d, e);
    
    // Test del head bug
    let mut tr2 = Chtrie::new(10, 4).unwrap();
    let a = tr2.walk(0, 0, 1); // h=0, node 1
    let b = tr2.walk(3, 0, 1); // h=0, node 2
    println!("a={} b={}", a, b);
    println!("walk(0,0,0)={}", tr2.walk(0, 0, 0));
    println!("walk(3,0,0)={}", tr2.walk(3, 0, 0));
    
    tr2.del(3, 0); // delete head, should drop chain
    println!("After del(3,0):");
    println!("walk(0,0,0)={}", tr2.walk(0, 0, 0));
    println!("walk(3,0,0)={}", tr2.walk(3, 0, 0));
}
EOF
