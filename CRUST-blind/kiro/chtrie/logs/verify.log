#include <stdio.h>
#include "src/chtrie.h"

int main(void) {
    // Small trie: n=10, m=4, ecap = 9 + 9/3 = 12
    chtrie *tr = chtrie_alloc(10, 4);
    if (!tr) { printf("alloc failed\n"); return 1; }

    // Create edges that hash to the same bucket to test del() chain behavior
    // h = (from * alphsz + sym) % ecap = (from * 4 + sym) % 12
    
    // Let's find collisions:
    // (0,0) -> h=0, (0,1) -> h=1, (1,0) -> h=4, (3,0) -> h=0 (collision with 0,0!)
    
    int a = chtrie_walk(tr, 0, 0, 1); // h=0, creates node 1
    printf("walk(0,0,1) = %d\n", a);
    
    int b = chtrie_walk(tr, 3, 0, 1); // h=0, creates node 2, chains with (0,0)
    printf("walk(3,0,1) = %d\n", b);
    
    // Now bucket 0 has chain: (3,0)->2 -> (0,0)->1
    // Verify both exist
    printf("walk(0,0,0) = %d\n", chtrie_walk(tr, 0, 0, 0)); // should be 1
    printf("walk(3,0,0) = %d\n", chtrie_walk(tr, 3, 0, 0)); // should be 2
    
    // Delete (3,0) which is the HEAD of the chain
    // C code: etab[h] = NULL (drops the whole chain including (0,0)->1!)
    chtrie_del(tr, 3, 0);
    
    printf("After del(3,0):\n");
    printf("walk(0,0,0) = %d\n", chtrie_walk(tr, 0, 0, 0)); // C bug: returns -1!
    printf("walk(3,0,0) = %d\n", chtrie_walk(tr, 3, 0, 0)); // should be -1
    
    // Now test deleting non-head: recreate
    chtrie_free(tr);
    tr = chtrie_alloc(10, 4);
    
    a = chtrie_walk(tr, 0, 0, 1); // h=0, node 1
    b = chtrie_walk(tr, 3, 0, 1); // h=0, node 2, head of chain
    
    // Delete (0,0) which is NOT the head (it's second in chain)
    // C code: q->next = p->next (correctly unlinks just this node)
    chtrie_del(tr, 0, 0);
    
    printf("\nAfter del(0,0) [non-head]:\n");
    printf("walk(0,0,0) = %d\n", chtrie_walk(tr, 0, 0, 0)); // should be -1
    printf("walk(3,0,0) = %d\n", chtrie_walk(tr, 3, 0, 0)); // should be 2 (preserved)
    
    chtrie_free(tr);
    return 0;
}
EOF
