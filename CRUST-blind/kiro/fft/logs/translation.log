use fft::fft::{FftComplex, fft_inplace};

fn main() {
    let mut data = [
        FftComplex { real: 1.0, imag: 0.0 },
        FftComplex { real: -1.0, imag: 0.0 },
        FftComplex { real: 1.0, imag: 0.0 },
        FftComplex { real: -1.0, imag: 0.0 },
        FftComplex { real: 1.0, imag: 0.0 },
        FftComplex { real: -1.0, imag: 0.0 },
        FftComplex { real: 1.0, imag: 0.0 },
        FftComplex { real: -1.0, imag: 0.0 },
    ];
    let expected = [0.0f32, 0.0, 0.0, 0.0, 8.0, 0.0, 0.0, 0.0];
    
    fft_inplace(&mut data, 3);
    
    for i in 0..8 {
        assert!((data[i].real - expected[i]).abs() < 1e-5, 
            "Mismatch at {}: got {} expected {}", i, data[i].real, expected[i]);
    }
    println!("Test passed");
}
EOF
