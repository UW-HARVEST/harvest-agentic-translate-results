#include "src/fft.h"
#include <stdio.h>
#include <string.h>
#include <limits.h>

#define INTBITS(t) (sizeof(t)*CHAR_BIT)

#if defined(__GNUC__) || defined(__clang__)
#define my_clz(n) _Generic(n, unsigned long: __builtin_clzl(n))
#endif

static inline size_t next_reversed_n(size_t reversed_n, size_t shift) {
  reversed_n <<= shift;
  size_t clo = my_clz(~reversed_n);
  reversed_n <<= clo;
  reversed_n |= (size_t)1 << (INTBITS(size_t) - 1);
  reversed_n >>= (shift + clo);
  return reversed_n;
}

static inline void rader(const fft_complex_t *restrict array, fft_complex_t *restrict target, size_t logsize) {
  size_t size = (size_t)1 << logsize;
  size_t shift = INTBITS(size_t) - logsize;
  for (size_t n = 0, reversed_n = 0; n < size; ++n) {
    target[reversed_n] = array[n];
    reversed_n = next_reversed_n(reversed_n, shift);
  }
}

static inline void rader_inplace(fft_complex_t *array, size_t logsize) {
  size_t size = (size_t)1 << logsize;
  size_t shift = INTBITS(size_t) - logsize;
  for (size_t n = 1, reversed_n = size >> 1; n < size - 1; ++n) {
    if (n < reversed_n) {
      fft_complex_t tmp = array[n];
      array[n] = array[reversed_n];
      array[reversed_n] = tmp;
    }
    reversed_n = next_reversed_n(reversed_n, shift);
  }
}

int main(void) {
    /* rader logsize=3: indices 0..7 */
    printf("=== rader logsize=3 ===\n");
    fft_complex_t in8[8], out8[8];
    for (int i = 0; i < 8; i++) { in8[i].real = (float)i; in8[i].imag = 0.0f; }
    rader(in8, out8, 3);
    for (int i = 0; i < 8; i++)
        printf("out[%d] = {%.1f, %.1f}\n", i, out8[i].real, out8[i].imag);

    /* rader_inplace logsize=3 */
    printf("\n=== rader_inplace logsize=3 ===\n");
    fft_complex_t ri8[8];
    for (int i = 0; i < 8; i++) { ri8[i].real = (float)i; ri8[i].imag = 0.0f; }
    rader_inplace(ri8, 3);
    for (int i = 0; i < 8; i++)
        printf("ri[%d] = {%.1f, %.1f}\n", i, ri8[i].real, ri8[i].imag);

    /* rader_inplace logsize=1 */
    printf("\n=== rader_inplace logsize=1 ===\n");
    fft_complex_t ri2[2] = {{10,0},{20,0}};
    rader_inplace(ri2, 1);
    for (int i = 0; i < 2; i++)
        printf("ri[%d] = {%.1f, %.1f}\n", i, ri2[i].real, ri2[i].imag);

    return 0;
}
EOF
