fn hecc_encode_impl(input: &[u8; 15], output: &mut Vec<u8>) {
    let mut p1: u8 = 0;
    let mut p2: u8 = 0;
    let mut power2: usize = 4;
    let mut data: u8 = 0;
    let mut inpos = 0;
    let insize = 15 * 8;

    let mut i: usize = 3;
    let mut j: usize = 0;
    while j < insize {
        if power2 == i {
            power2 *= 2;
            i += 1;
            continue;
        }
        if j % 8 == 0 {
            data = input[inpos];
            output.push(data);
            inpos += 1;
            p2 ^= (data.count_ones() & 1) as u8;
        }
        if data & 1 != 0 {
            p1 ^= i as u8;
        }
        data >>= 1;
        j += 1;
        i += 1;
    }

    p2 ^= (p1.count_ones() & 1) as u8;
    output.push(p1 + (p2 << 7));
}

fn hecc_encode_impl_c(input: &[u8], output: &mut Vec<u8>) {
    let mut p1: u8 = 0;
    let mut p2: u8 = 0;
    let mut power2: usize = 4;
    let mut data: u8 = 0;
    let mut inpos = 0;
    let insize = input.len() * 8;

    let mut i: usize = 3;
    let mut j: usize = 0;
    while j < insize {
        if power2 == i {
            power2 *= 2;
            i += 1;
            continue;
        }
        if j % 8 == 0 {
            data = input[inpos];
            output.push(data);
            inpos += 1;
            p2 ^= (data.count_ones() & 1) as u8;
        }
        if data & 1 != 0 {
            p1 ^= i as u8;
        }
        data >>= 1;
        j += 1;
        i += 1;
    }

    p2 ^= (p1.count_ones() & 1) as u8;
    output.push(p1 + (p2 << 7));
}

fn main() {
    // Test with 1 byte: 0xAB
    let mut buf = [0u8; 15];
    buf[0] = 0xAB;
    
    let mut out_rust = Vec::new();
    hecc_encode_impl(&buf, &mut out_rust);
    println!("Rust (15 bytes): {:02x?}", out_rust);
    println!("  check byte: 0x{:02x}", out_rust[15]);
    
    let mut out_c = Vec::new();
    hecc_encode_impl_c(&[0xAB], &mut out_c);
    println!("C-like (1 byte): {:02x?}", out_c);
    println!("  check byte: 0x{:02x}", out_c[1]);
}
