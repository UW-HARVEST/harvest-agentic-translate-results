    }

    // check byte error correction
    for idx in 0..7 {
        let mut corrupted = data8_enc.to_vec();
        corrupted[15] ^= 1 << idx;
        let fixed = hecc_decode(&corrupted).unwrap();
        assert_eq!(&fixed[..], &data8[..], "check bit {}", idx);
    }

