use FastHamming::fast_hamming::*;

fn main() {
    let data8: [u8; 15] = [
        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4, 0x46,
    ];
    let data8_enc: [u8; 16] = [
        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4, 0x46, 0xd9,
    ];

    // Test log2uint8
    assert_eq!(log2uint8(1), 0);
    assert_eq!(log2uint8(2), 1);
    assert_eq!(log2uint8(3), 1);
    assert_eq!(log2uint8(4), 2);
    assert_eq!(log2uint8(128), 7);
    assert_eq!(log2uint8(255), 7);
    println!("log2uint8: OK");

    // Test encode
    let encoded = hecc_encode(&data8);
    assert_eq!(encoded.len(), 16);
    assert_eq!(&encoded[..], &data8_enc[..]);
    println!("encode: OK");

    // Test decode (no error)
    let decoded = hecc_decode(&data8_enc).unwrap();
    assert_eq!(decoded.len(), 15);
    assert_eq!(&decoded[..], &data8[..]);
    println!("decode: OK");

    // Test roundtrip
    let enc = hecc_encode(&data8);
    let dec = hecc_decode(&enc).unwrap();
    assert_eq!(&dec[..], &data8[..]);
    println!("roundtrip: OK");

    // Test single bit error correction in data
    for idx in 0..(15 * 8) {
        let mut corrupted = data8_enc.to_vec();
        corrupted[idx / 8] ^= 1 << (idx % 8);
        let fixed = hecc_decode(&corrupted).unwrap();
        assert_eq!(&fixed[..], &data8[..], "Failed at data bit {}", idx);
    }
    println!("single data error correction: OK");

    // Test single bit error in check byte (bits 0-6)
    for idx in 0..7 {
        let mut corrupted = data8_enc.to_vec();
        corrupted[15] ^= 1 << idx;
        let fixed = hecc_decode(&corrupted).unwrap();
        assert_eq!(&fixed[..], &data8[..], "Failed at check bit {}", idx);
    }
    println!("single check error correction: OK");

    // Test parity bit error
    let mut corrupted = data8_enc.to_vec();
    corrupted[15] ^= 1 << 7;
    let fixed = hecc_decode(&corrupted).unwrap();
    assert_eq!(&fixed[..], &data8[..]);
    println!("parity error correction: OK");

    // Test double error detection
    let mut corrupted = data8_enc.to_vec();
    corrupted[0] ^= 3;
    assert!(hecc_decode(&corrupted).is_none());
    println!("double error detection: OK");

    // Test truncated message
    assert!(hecc_decode(&[0u8; 1]).is_none());
    println!("truncated message rejection: OK");

    println!("\nAll tests passed!");
}
