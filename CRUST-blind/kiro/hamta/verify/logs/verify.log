#include <stdint.h>

int main() {
    // C way
    unsigned int hash_c = (unsigned int)14695981039346656037ULL;
    unsigned int prime_c = (unsigned int)1099511628211ULL;
    const char *s = "hello";
    for (int i = 0; s[i]; i++) {
        hash_c *= prime_c;
        hash_c ^= s[i];
    }
    printf("C hash of 'hello' = %u\n", hash_c);
    
    // Rust way
    uint64_t hash_r = 14695981039346656037ULL;
    uint64_t prime_r = 1099511628211ULL;
    for (int i = 0; s[i]; i++) {
        hash_r = hash_r * prime_r;
        hash_r ^= s[i];
    }
    printf("Rust hash of 'hello' = %u\n", (unsigned int)hash_r);
    
    return 0;
}
EOF
