#include <stdio.h>
#include <stdint.h>

#define CHUNK_SIZE 6

int hamt_get_symbol(unsigned int hash, int lvl) {
    int left = lvl * CHUNK_SIZE;
    int left_plus_chunk = left + CHUNK_SIZE;
    int right = 32 - left_plus_chunk;
    if (left_plus_chunk > 32)
        right = 0;
    unsigned int symbol = hash << left;
    symbol >>= (right + left);
    return symbol;
}

