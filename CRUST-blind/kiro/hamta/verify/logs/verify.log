#include <stdio.h>
#include <stdint.h>
#include <string.h>

#define FNV_BASE 14695981039346656037
#define FNV_PRIME 1099511628211

unsigned int my_fnv1(void *key, size_t len) {
    unsigned int hash = FNV_BASE;
    for (size_t i = 0; i < len; i++) {
        hash *= FNV_PRIME;
        hash ^= ((char*) key)[i];
    }
    return hash;
}

int main() {
    // Step by step for 255
