use murmurhash_c::murmurhash::murmurhash;

fn main() {
    let tests: Vec<(&str, u32, u32)> = vec![
        ("", 0, 0x00000000),
        ("0", 0, 0xd271c07f),
        ("01", 0, 0x61ec6600),
        ("012", 0, 0xec6cff8c),
        ("0123", 0, 0xd41994a0),
        ("01234", 0, 0x19d02170),
        ("2", 0, 0x0129e217),
        ("88", 0, 0x7a0040a5),
        ("asdfqwer", 0, 0xa46b5209),
        ("asdfqwerty", 0, 0xa3cfe04b),
        ("asd", 0, 0x14570c6f),
        ("Hello", 0, 0x12da77c8),
        ("Hello1", 0, 0x6357e0a6),
        ("Hello2", 0, 0xe5ce223e),
        ("hey", 0, 0x12f94418),
        ("dude", 0, 0xef0487f3),
        ("test", 0, 0xba6bd213),
        ("kinkajou", 0, 0xb6d99cf8),
        ("", 1, 0x514e28b7),
    ];

    let mut pass = 0;
    let mut fail = 0;
    for (key, seed, expected) in &tests {
        let result = murmurhash(key.as_bytes(), *seed);
        if result == *expected {
            pass += 1;
        } else {
            fail += 1;
            println!("FAIL: key='{}' seed={} expected=0x{:08x} got=0x{:08x}", key, seed, expected, result);
        }
    }
    println!("{} passed, {} failed", pass, fail);
}
