use Megalania::range_encoder::RangeEncoder;
use Megalania::probability_model::encode_bit;
use Megalania::probability::PROB_INIT_VAL;
use Megalania::output_interface::OutputInterface;
use Megalania::encoder_interface::EncoderInterface;

struct BufOutput {
    data: Vec<u8>,
}
impl OutputInterface for BufOutput {
    fn write(&mut self, data: &[u8]) -> bool {
        self.data.extend_from_slice(data);
        true
    }
}

fn main() {
    let mut out = BufOutput { data: Vec::new() };
    let mut prob = PROB_INIT_VAL;
    println!("initial prob={}", prob);
    {
        let mut enc = RangeEncoder::new(&mut out);
        
        // Manually trace encode_bit behavior
        // First call: encode_bit(false, &mut prob, &mut enc)
        // This calls enc.encode_bit(false, 1024) then updates prob
        println!("calling encode_bit(false, prob={})", prob);
        encode_bit(false, &mut prob, &mut enc);
        println!("after: prob={}", prob);
        
        println!("calling encode_bit(true, prob={})", prob);
        encode_bit(true, &mut prob, &mut enc);
        println!("after: prob={}", prob);
        
        println!("calling encode_bit(false, prob={})", prob);
        encode_bit(false, &mut prob, &mut enc);
        println!("after: prob={}", prob);
        
        enc.flush();
    }
    print!("output ({} bytes):", out.data.len());
    for b in &out.data {
        print!(" {:02x}", b);
    }
    println!();
}
EOF
