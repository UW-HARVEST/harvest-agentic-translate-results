    uint8_t cache;
    uint64_t cache_size;
} RangeEncoderData;

typedef struct {
    uint8_t buf[256];
    size_t pos;
} BufferOutput;

static bool buffer_write(OutputInterface* output, const void* data, size_t data_size) {
    BufferOutput* bo = (BufferOutput*)output->private_data;
    memcpy(bo->buf + bo->pos, data, data_size);
    bo->pos += data_size;
    return true;
}

static void range_encoder_shift_low(EncoderInterface* enc)
{
    RangeEncoderData* data = (RangeEncoderData*)enc->private_data;
    OutputInterface* output = data->output;

    uint32_t high_bytes = data->low >> 32;
    uint32_t low_bytes = data->low & 0xFFFFFFFF;
    if (low_bytes < TOP_MASK || high_bytes != 0) {
        uint8_t temp = data->cache;
        do {
            uint8_t out_byte = temp + (high_bytes & 0xFF);
            (*output->write)(output, &out_byte, 1);
            temp = 0xFF;
        } while (--data->cache_size != 0);
        data->cache = (data->low >> 24) & 0xFF;
    }
    data->cache_size++;
    data->low = low_bytes << 8;
}

static void range_encoder_encode_bit(EncoderInterface* enc, bool bit, Prob prob)
{
    RangeEncoderData* data = (RangeEncoderData*)enc->private_data;
    uint32_t new_bound = (data->range >> NUM_BIT_MODEL_TOTAL_BITS) * prob;
    printf("  encode_bit: bit=%d prob=%d range=%u new_bound=%u low=%lu\n", bit, prob, data->range, new_bound, data->low);
    if (bit) {
        data->low += new_bound;
        data->range -= new_bound;
    } else {
        data->range = new_bound;
    }
    printf("  after: range=%u low=%lu\n", data->range, data->low);
    while ((data->range & TOP_MASK) == 0) {
        data->range <<= 8;
        range_encoder_shift_low(enc);
        printf("  shift_low: range=%u low=%lu\n", data->range, data->low);
    }
}

int main() {
    BufferOutput bo = { .pos = 0 };
    OutputInterface output;
    output.write = buffer_write;
    output.private_data = &bo;

    RangeEncoderData* rdata = malloc(sizeof(RangeEncoderData));
    rdata->output = &output;
    rdata->low = 0;
    rdata->range = 0xFFFFFFFF;
    rdata->cache = 0;
    rdata->cache_size = 1;

    EncoderInterface enc;
    enc.encode_bit = range_encoder_encode_bit;
    enc.private_data = rdata;

    // encode_bit(false, prob=1024)
    printf("encode_bit(false, 1024)\n");
    range_encoder_encode_bit(&enc, 0, 1024);

    // encode_bit(true, prob=1056)
    printf("encode_bit(true, 1056)\n");
    range_encoder_encode_bit(&enc, 1, 1056);

    // encode_bit(false, prob=1023)
    printf("encode_bit(false, 1023)\n");
    range_encoder_encode_bit(&enc, 0, 1023);

    // flush
    for (int i = 0; i < 5; i++) range_encoder_shift_low(&enc);

    printf("output (%ld bytes):", bo.pos);
    for (size_t i = 0; i < bo.pos; i++) printf(" %02x", bo.buf[i]);
    printf("\n");

    free(rdata);
    return 0;
}
