pub struct BRSAPublicKey {
    pub evp_pkey: Option<EVP_PKEY>,
    pub mont_ctx: Option<BN_MONT_CTX>,
}
impl BRSAPublicKey {
    pub fn new() -> Self {
        BRSAPublicKey { evp_pkey: None, mont_ctx: None }
    }
    pub fn brsa_publickey_import(
        &mut self,
        der: &[u8],
        der_len: usize,
    ) -> i32 {
        if der_len > MAX_SERIALIZED_PK_LEN { return -1; }
        let rsa = match Rsa::public_key_from_der(&der[..der_len]) {
            Ok(r) => r,
            Err(_) => return -1,
        };
        if !rsa_parameters_check_rsa(&rsa) { return -1; }
        let der_owned = der[..der_len].to_vec();
        pk_store_set(self as *const _ as usize, der_owned);
        0
    }
    pub fn brsa_publickey_deinit(&mut self) {
        pk_store_remove(self as *const _ as usize);
        self.evp_pkey = None;
        self.mont_ctx = None;
    }
    pub fn brsa_publickey_recover(
        &mut self,
        sk: &BRSASecretKey,
    ) -> i32 {
        let sk_rsa = match recover_sk_rsa(sk) {
            Some(r) => r,
            None => return -1,
        };
        // Extract public key DER from private key
        let pk_der = match sk_rsa.public_key_to_der() {
            Ok(d) => d,
            Err(_) => return -1,
        };
        self.brsa_publickey_import(&pk_der, pk_der.len())
    }
}

pub struct BRSASecretKey {
    pub evp_pkey: Option<EVP_PKEY>,
}
impl BRSASecretKey {
    pub fn new() -> Self {
        BRSASecretKey { evp_pkey: None }
    }
    pub fn brsa_keypair_generate(
        &mut self,
        pk: &mut BRSAPublicKey,
        modulus_bits: c_int,
    ) -> i32 {
        self.evp_pkey = None;
        pk.evp_pkey = None;
        pk.mont_ctx = None;

        let rsa = match Rsa::generate(modulus_bits as u32) {
            Ok(r) => r,
            Err(_) => return -1,
        };
        let sk_der = match rsa.private_key_to_der() {
            Ok(d) => d,
            Err(_) => return -1,
        };
        sk_store_set(self as *const _ as usize, sk_der);
        pk.brsa_publickey_recover(self)
    }
    pub fn brsa_secretkey_import(
        &mut self,
        der: &[u8],
        der_len: usize,
    ) -> i32 {
        self.evp_pkey = None;
        if Rsa::private_key_from_der(&der[..der_len]).is_err() { return -1; }
        sk_store_set(self as *const _ as usize, der[..der_len].to_vec());
        0
    }
    pub fn brsa_secretkey_deinit(&mut self) {
        sk_store_remove(self as *const _ as usize);
        self.evp_pkey = None;
    }
}

