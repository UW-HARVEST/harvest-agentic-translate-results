    pub fn brsa_publickey_export_spki(
        &self,
        spki: &mut BRSASerializedKey,
        pk: &BRSAPublicKey,
    ) -> i32 {
        let pk_rsa = match recover_pk_rsa(pk) {
            Some(r) => r,
            None => return -1,
        };
        let pk_der = match pk_rsa.public_key_to_der() {
            Ok(d) => d,
            Err(_) => return -1,
        };

        // Get the hash algorithm OID bytes
        let md = self.get_md();
        let alg_oid: &[u8] = match md.type_().as_raw() {
            nid if nid == openssl::nid::Nid::SHA256.as_raw() =>
                &[0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01],
            nid if nid == openssl::nid::Nid::SHA384.as_raw() =>
                &[0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02],
            nid if nid == openssl::nid::Nid::SHA512.as_raw() =>
                &[0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03],
            _ => return -1,
        };

        // Build SPKI using the template from C code
        #[rustfmt::skip]
        let template: Vec<u8> = vec![
            0x30, 0x80 | 2, 0, 0, // SEQ, container length at [2..4]
                0x30, 61, // Algorithm sequence
                    0x06, 9, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0a, // RSASSA-PSS OID
                    0x30, 48, // params
                        0xa0, 2 + 2 + 9,
                        0x30, 2 + 9, 0x06, 9, 0,0,0,0,0,0,0,0,0, // hash OID at [21..21+2+9]

                        0xa1, 2 + 24,
                        0x30, 24, 0x06, 9, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x08,
                            0x30, 2 + 9, 0x06, 9, 0,0,0,0,0,0,0,0,0, // MGF1 hash OID at [49..49+2+9]

                        0xa2, 2 + 1, 0x02, 1, 0, // salt length at [66]
                0x03, 0x80 | 2, 0, 0, // BIT STRING length at [69..71]
                    0, // no partial bytes
        ];
        let template_len = template.len(); // should be 72

        let container_len = template_len - 4 + pk_der.len();
        let mut spki_bytes = Vec::with_capacity(template_len + pk_der.len());
        spki_bytes.extend_from_slice(&template);
        spki_bytes.extend_from_slice(&pk_der);

        spki_bytes[2] = (container_len >> 8) as u8;
        spki_bytes[3] = (container_len & 0xff) as u8;
        spki_bytes[66] = (self.salt_len & 0xff) as u8;
        spki_bytes[69] = ((1 + pk_der.len()) >> 8) as u8;
        spki_bytes[70] = ((1 + pk_der.len()) & 0xff) as u8;

        // Fill hash OIDs
        let mgf1_data: [u8; 11] = [
            0x30, 2 + 9, 0x06, 9,
            alg_oid[0], alg_oid[1], alg_oid[2], alg_oid[3],
            alg_oid[4], alg_oid[5], alg_oid[6],
        ];
        // But we need all 13 bytes (2+2+9)
        // Actually the template has 2+9=11 bytes for the inner SEQ
        // offset 21 is where the hash function SEQ starts: 0x30, 2+9, 0x06, 9, ...9 bytes...
        spki_bytes[21] = 0x30;
        spki_bytes[22] = 2 + 9;
        spki_bytes[23] = 0x06;
        spki_bytes[24] = 9;
        spki_bytes[25..34].copy_from_slice(alg_oid);

        spki_bytes[49] = 0x30;
        spki_bytes[50] = 2 + 9;
        spki_bytes[51] = 0x06;
        spki_bytes[52] = 9;
        spki_bytes[53..62].copy_from_slice(alg_oid);

        let len = spki_bytes.len();
        spki.bytes = leak_vec(spki_bytes);
        spki.bytes_len = len;
        0
    }

    pub fn brsa_publickey_import_spki(
        &self,
        pk: &mut BRSAPublicKey,
        spki: &[u8],
        spki_len: usize,
    ) -> i32 {
        let template_len = 72usize; // same as C template size
        if spki_len > MAX_SERIALIZED_PK_LEN || spki_len <= template_len { return -1; }
        // Verify RSASSA-PSS OID at offset 6..18
        let expected = [0x06, 9, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0a];
        if spki[6..17] != expected[..] { return -1; }
        let alg_len = spki[5] as usize;
        if spki_len <= alg_len + 11 { return -1; }
        pk.brsa_publickey_import(&spki[alg_len + 11..spki_len], spki_len - alg_len - 11)
    }

    pub fn brsa_publickey_id(
        &self,
        id: &[u8],
        id_len: usize,
        pk: &BRSAPublicKey,
    ) -> i32 {
        let mut spki = BRSASerializedKey::new();
        if self.brsa_publickey_export_spki(&mut spki, pk) != 0 { return -1; }

        let hash = openssl::sha::sha256(spki.bytes);
        spki.brsa_serializedkey_deinit();

        // Write to id (which is &[u8] but we need to write to it)
        let id_slice = unsafe {
            std::slice::from_raw_parts_mut(id.as_ptr() as *mut u8, id_len)
        };
        let out_len = id_len.min(hash.len());
        id_slice[..out_len].copy_from_slice(&hash[..out_len]);
        if out_len < id_len {
            for b in &mut id_slice[out_len..] { *b = 0; }
        }
        0
    }
}
