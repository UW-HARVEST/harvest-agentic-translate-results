impl BRSAContext {
    pub fn new() -> Self {
        BRSAContext { evp_md: None, salt_len: 0 }
    }
    pub fn brsa_context_init_default(&mut self) {
        self.brsa_context_init_custom(BRSAHashFunction::BRSA_SHA384, BRSA_DEFAULT_SALT_LENGTH);
    }
    pub fn brsa_context_init_deterministic(&mut self) {
        self.brsa_context_init_custom(BRSAHashFunction::BRSA_SHA384, 0);
    }
    pub fn brsa_context_init_custom(
        &mut self,
        hash_function: BRSAHashFunction,
        salt_len: usize,
    ) -> i32 {
        let md = get_md(hash_function);
        if salt_len == BRSA_DEFAULT_SALT_LENGTH {
            self.salt_len = md.size();
        } else {
            self.salt_len = salt_len;
        }
        ctx_hash_set(self as *const _ as usize, hash_function);
        0
    }

    fn get_md(&self) -> MessageDigest {
        let hf = ctx_hash_get(self as *const _ as usize)
            .unwrap_or(BRSAHashFunction::BRSA_SHA384);
        get_md(hf)
    }

    fn hash_msg(&self, prefix: Option<&BRSAMessageRandomizer>, msg: &[u8]) -> Option<Vec<u8>> {
        let md = self.get_md();
        let mut h = Hasher::new(md).ok()?;
        if let Some(p) = prefix {
            h.update(&p.noise).ok()?;
        }
        h.update(msg).ok()?;
        let result = h.finish().ok()?;
        Some(result.to_vec())
    }

    fn pss_pad(&self, pk_rsa: &Rsa<Public>, msg_hash: &[u8]) -> Option<Vec<u8>> {
        let modulus_bytes = pk_rsa.size() as usize;
        let md = self.get_md();
        let mut em = vec![0u8; modulus_bytes];
        // Use openssl's RSA_padding_add_PKCS1_PSS_mgf1 via raw API
        unsafe {
            let rsa_ptr = pk_rsa.as_ref() as *const openssl::ffi::RSA;
            let ret = openssl_sys::RSA_padding_add_PKCS1_PSS_mgf1(
                rsa_ptr as *mut openssl_sys::RSA,
                em.as_mut_ptr(),
                msg_hash.as_ptr(),
                md.as_ptr(),
                md.as_ptr(),
                self.salt_len as i32,
            );
            if ret != 1 { return None; }
        }
        Some(em)
    }

    fn pss_verify_raw(&self, pk_rsa: &Rsa<Public>, msg_hash: &[u8], em: &[u8]) -> bool {
        let md = self.get_md();
        unsafe {
            let rsa_ptr = pk_rsa.as_ref() as *const openssl::ffi::RSA;
            let ret = openssl_sys::RSA_verify_PKCS1_PSS_mgf1(
                rsa_ptr as *mut openssl_sys::RSA,
                msg_hash.as_ptr(),
                md.as_ptr(),
                md.as_ptr(),
                em.as_ptr(),
                self.salt_len as i32,
            );
            ret == 1
        }
    }

    pub fn brsa_blind_message_generate(
        &self,
        blind_message: &mut BRSABlindMessage,
        msg: &[u8],
        msg_len: usize,
        secret: &mut BRSABlindingSecret,
        pk: &mut BRSAPublicKey,
    ) -> i32 {
        // msg is pre-allocated by caller, fill with random bytes
        // But msg is &[u8] (immutable)... we need to fill it.
        // In C, msg is uint8_t* (mutable). Here it's &[u8].
        // We'll use unsafe to write random bytes into it.
        let msg_slice = unsafe {
            std::slice::from_raw_parts_mut(msg.as_ptr() as *mut u8, msg_len)
        };
        openssl::rand::rand_bytes(msg_slice).unwrap_or(());
        self.brsa_blind_inner(blind_message, secret, None, pk, msg, msg_len)
    }

    pub fn brsa_blind(
        self,
        blind_message: &mut BRSABlindMessage,
        secret: &mut BRSABlindingSecret,
        msg_randomizer: &mut BRSAMessageRandomizer,
        pk: &mut BRSAPublicKey,
        msg: &[u8],
        msg_len: usize,
    ) -> i32 {
        // Fill randomizer with random bytes
        if openssl::rand::rand_bytes(&mut msg_randomizer.noise).is_err() {
            return -1;
        }
        self.brsa_blind_inner(blind_message, secret, Some(msg_randomizer), pk, msg, msg_len)
    }

    fn brsa_blind_inner(
        &self,
        blind_message: &mut BRSABlindMessage,
        secret: &mut BRSABlindingSecret,
        msg_randomizer: Option<&BRSAMessageRandomizer>,
        pk: &mut BRSAPublicKey,
        msg: &[u8],
        msg_len: usize,
    ) -> i32 {
        let pk_rsa = match recover_pk_rsa(pk) {
            Some(r) => r,
            None => return -1,
        };
        if !rsa_parameters_check_rsa(&pk_rsa) { return -1; }
        let modulus_bytes = pk_rsa.size() as usize;

        // Hash message
        let msg_hash = match self.hash_msg(msg_randomizer, &msg[..msg_len]) {
            Some(h) => h,
            None => return -1,
        };

        // PSS pad
        let padded = match self.pss_pad(&pk_rsa, &msg_hash) {
            Some(p) => p,
            None => return -1,
        };

        // Blind
        let mut ctx = match BigNumContext::new() {
            Ok(c) => c,
            Err(_) => return -1,
        };

        let m = match BigNum::from_slice(&padded) {
            Ok(b) => b,
            Err(_) => return -1,
        };
        let n = pk_rsa.n().to_owned().unwrap();
        let e = pk_rsa.e().to_owned().unwrap();

        // Check gcd(m, n) == 1
        let mut gcd = BigNum::new().unwrap();
        gcd.gcd(&m, &n, &mut ctx).unwrap();
        if !gcd.is_one() { return -1; }

        // Generate random blinding factor
        let mut secret_inv = BigNum::new().unwrap();
        let mut secret_bn = BigNum::new().unwrap();
        loop {
            if secret_inv.rand_range(&n).is_err() { return -1; }
            if secret_inv.is_one() { continue; }
            match secret_bn.mod_inverse(&secret_inv, &n, &mut ctx) {
                Ok(_) => break,
                Err(_) => continue,
            }
        }

        // x = secret_inv^e mod n
        let mont = match MontgomeryContext::new(&n, &mut ctx) {
            Ok(m) => m,
            Err(_) => return -1,
        };
        let mut x = BigNum::new().unwrap();
        if x.mod_exp_mont(&secret_inv, &e, &n, &mut ctx, &mont).is_err() { return -1; }

        // blind_m = m * x mod n
        let mut blind_m = BigNum::new().unwrap();
        if blind_m.mod_mul(&m, &x, &n, &mut ctx).is_err() { return -1; }

        // Serialize
        let mut blind_msg_bytes = vec![0u8; modulus_bytes];
        let bm_bytes = blind_m.to_vec();
        if bm_bytes.len() > modulus_bytes { return -1; }
        let offset = modulus_bytes - bm_bytes.len();
        blind_msg_bytes[offset..].copy_from_slice(&bm_bytes);

        let mut secret_bytes = vec![0u8; modulus_bytes];
        let sb = secret_bn.to_vec();
        if sb.len() > modulus_bytes { return -1; }
        let offset2 = modulus_bytes - sb.len();
        secret_bytes[offset2..].copy_from_slice(&sb);

        blind_message.blind_message = leak_vec(blind_msg_bytes);
        blind_message.blind_message_len = modulus_bytes;
        secret.secret = leak_vec(secret_bytes);
        secret.secret_len = modulus_bytes;
        0
    }
