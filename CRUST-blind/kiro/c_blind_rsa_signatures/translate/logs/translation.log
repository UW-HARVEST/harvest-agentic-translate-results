#![allow(non_snake_case, non_camel_case_types, unused_variables)]

use openssl_sys::*;
use openssl::bn::{BigNum, BigNumContext, MontgomeryContext};
use openssl::hash::{Hasher, MessageDigest};
use openssl::pkey::{PKey, Private, Public};
use openssl::rsa::{Padding, Rsa};
use openssl::sign::{Signer, Verifier};
use std::collections::HashMap;
use std::sync::Mutex;

pub const BRSA_DEFAULT_SALT_LENGTH: usize = usize::MAX;

#[derive(Debug, Clone, Copy)]
pub enum BRSAHashFunction {
    BRSA_SHA256,
    BRSA_SHA384,
    BRSA_SHA512,
}

// Global key stores keyed by struct address
static PK_STORE: Mutex<Option<HashMap<usize, Vec<u8>>>> = Mutex::new(None);
static SK_STORE: Mutex<Option<HashMap<usize, Vec<u8>>>> = Mutex::new(None);
// Store hash function choice for BRSAContext (keyed by address)
static CTX_HASH_STORE: Mutex<Option<HashMap<usize, BRSAHashFunction>>> = Mutex::new(None);

fn pk_store_set(addr: usize, der: Vec<u8>) {
    let mut guard = PK_STORE.lock().unwrap();
    guard.get_or_insert_with(HashMap::new).insert(addr, der);
}
fn pk_store_get(addr: usize) -> Option<Vec<u8>> {
    let guard = PK_STORE.lock().unwrap();
    guard.as_ref().and_then(|m| m.get(&addr).cloned())
}
fn pk_store_remove(addr: usize) {
    let mut guard = PK_STORE.lock().unwrap();
    if let Some(m) = guard.as_mut() { m.remove(&addr); }
}
fn sk_store_set(addr: usize, der: Vec<u8>) {
    let mut guard = SK_STORE.lock().unwrap();
    guard.get_or_insert_with(HashMap::new).insert(addr, der);
}
fn sk_store_get(addr: usize) -> Option<Vec<u8>> {
    let guard = SK_STORE.lock().unwrap();
    guard.as_ref().and_then(|m| m.get(&addr).cloned())
}
fn sk_store_remove(addr: usize) {
    let mut guard = SK_STORE.lock().unwrap();
    if let Some(m) = guard.as_mut() { m.remove(&addr); }
}
fn ctx_hash_set(addr: usize, hf: BRSAHashFunction) {
    let mut guard = CTX_HASH_STORE.lock().unwrap();
    guard.get_or_insert_with(HashMap::new).insert(addr, hf);
}
fn ctx_hash_get(addr: usize) -> Option<BRSAHashFunction> {
    let guard = CTX_HASH_STORE.lock().unwrap();
    guard.as_ref().and_then(|m| m.get(&addr).copied())
}

fn leak_vec(v: Vec<u8>) -> &'static [u8] {
    Box::leak(v.into_boxed_slice())
}

fn get_md(hf: BRSAHashFunction) -> MessageDigest {
    match hf {
        BRSAHashFunction::BRSA_SHA256 => MessageDigest::sha256(),
        BRSAHashFunction::BRSA_SHA384 => MessageDigest::sha384(),
        BRSAHashFunction::BRSA_SHA512 => MessageDigest::sha512(),
    }
}

fn recover_pk_rsa(pk: &BRSAPublicKey) -> Option<Rsa<Public>> {
    let der = pk_store_get(pk as *const _ as usize)?;
    Rsa::public_key_from_der(&der).ok()
}

fn recover_sk_rsa(sk: &BRSASecretKey) -> Option<Rsa<Private>> {
    let der = sk_store_get(sk as *const _ as usize)?;
    Rsa::private_key_from_der(&der).ok()
}

fn rsa_parameters_check_rsa(rsa: &Rsa<impl openssl::pkey::HasPublic>) -> bool {
    let bits = rsa.size() * 8;
    if (bits as usize) < MIN_MODULUS_BITS || (bits as usize) > MAX_MODULUS_BITS {
        return false;
    }
    let e = rsa.e();
    let e3 = BigNum::from_u32(3).unwrap();
    let ef4 = BigNum::from_u32(65537).unwrap();
    e == &e3 || e == &ef4
}

pub struct BRSAContext {
    pub evp_md: Option<EVP_MD>,
    pub salt_len: usize,
}
