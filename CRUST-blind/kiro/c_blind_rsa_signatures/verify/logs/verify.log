#include <stdio.h>
#include <string.h>
#include "blind_rsa.h"

int main(void) {
    // Test context init
    BRSAContext ctx;
    brsa_context_init_default(&ctx);
    printf("default salt_len=%zu\n", ctx.salt_len);

    brsa_context_init_deterministic(&ctx);
    printf("deterministic salt_len=%zu\n", ctx.salt_len);

    brsa_context_init_custom(&ctx, BRSA_SHA256, 48);
    printf("custom sha256/48 salt_len=%zu\n", ctx.salt_len);

    int ret = brsa_context_init_custom(&ctx, BRSA_SHA256, BRSA_DEFAULT_SALT_LENGTH);
    printf("sha256 default salt_len=%zu ret=%d\n", ctx.salt_len, ret);

    ret = brsa_context_init_custom(&ctx, BRSA_SHA384, BRSA_DEFAULT_SALT_LENGTH);
    printf("sha384 default salt_len=%zu ret=%d\n", ctx.salt_len, ret);

    ret = brsa_context_init_custom(&ctx, BRSA_SHA512, BRSA_DEFAULT_SALT_LENGTH);
    printf("sha512 default salt_len=%zu ret=%d\n", ctx.salt_len, ret);

    // Test invalid hash function
    ret = brsa_context_init_custom(&ctx, 99, 0);
    printf("invalid hash ret=%d\n", ret);

    // Test keygen with too-small modulus
    BRSASecretKey sk;
    BRSAPublicKey pk;
    ret = brsa_keypair_generate(&sk, &pk, 1024);
    printf("keygen 1024 ret=%d\n", ret);

    // Test keygen with valid modulus
    ret = brsa_keypair_generate(&sk, &pk, 2048);
    printf("keygen 2048 ret=%d\n", ret);

    // Test key export/import round-trip
    BRSASerializedKey sk_der, pk_der;
    brsa_secretkey_export(&sk_der, &sk);
    brsa_publickey_export(&pk_der, &pk);
    printf("sk_der_len=%zu pk_der_len=%zu\n", sk_der.bytes_len, pk_der.bytes_len);

    BRSASecretKey sk2;
    BRSAPublicKey pk2;
    ret = brsa_secretkey_import(&sk2, sk_der.bytes, sk_der.bytes_len);
    printf("sk import ret=%d\n", ret);
    ret = brsa_publickey_import(&pk2, pk_der.bytes, pk_der.bytes_len);
    printf("pk import ret=%d\n", ret);

    // Test public key recover
    BRSAPublicKey pk3;
    ret = brsa_publickey_recover(&pk3, &sk);
    printf("pk recover ret=%d\n", ret);

    // Test key ID
    brsa_context_init_default(&ctx);
    uint8_t key_id[4];
    ret = brsa_publickey_id(&ctx, key_id, sizeof key_id, &pk);
    printf("key_id ret=%d bytes=%02x%02x%02x%02x\n", ret, key_id[0], key_id[1], key_id[2], key_id[3]);

    // Test key ID with larger buffer
    uint8_t key_id2[64];
    memset(key_id2, 0xff, sizeof key_id2);
    ret = brsa_publickey_id(&ctx, key_id2, sizeof key_id2, &pk);
    printf("key_id2 ret=%d last_bytes=%02x%02x\n", ret, key_id2[32], key_id2[63]);

    // SPKI export/import
    BRSASerializedKey spki;
    ret = brsa_publickey_export_spki(&ctx, &spki, &pk);
    printf("spki export ret=%d len=%zu\n", ret, spki.bytes_len);

    BRSAPublicKey pk4;
    ret = brsa_publickey_import_spki(&ctx, &pk4, spki.bytes, spki.bytes_len);
    printf("spki import ret=%d\n", ret);

    // Cleanup
    brsa_serializedkey_deinit(&spki);
    brsa_serializedkey_deinit(&sk_der);
    brsa_serializedkey_deinit(&pk_der);
    brsa_secretkey_deinit(&sk);
    brsa_secretkey_deinit(&sk2);
    brsa_publickey_deinit(&pk);
    brsa_publickey_deinit(&pk2);
    brsa_publickey_deinit(&pk3);
    brsa_publickey_deinit(&pk4);

    return 0;
}
EOF
