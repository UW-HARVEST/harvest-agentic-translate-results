use CircularBuffer::circular_buffer::CircularBuffer;

#[test]
fn test_c_behavior() {
    let mut cb = CircularBuffer::new(8);
    let a = b"0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let mut b = [0u8; 128];
    let mut offset: usize = 0;

    // push 3 bytes
    let len = 3;
    cb.push(&a[offset..offset+len], len);
    offset += len;
    assert_eq!(cb.get_data_size(), 3);

    // push 7 bytes
    let len = 7;
    cb.push(&a[offset..offset+len], len);
    offset += len;
    assert_eq!(cb.get_data_size(), 8);

    // pop 3 bytes
    let len = 3;
    b = [0u8; 128];
    let out_len = cb.pop(len, &mut b);
    assert_eq!(out_len, 3);
    assert_eq!(&b[..3], b"234");
    assert_eq!(cb.get_data_size(), 5);

    // read 2 bytes
    let len = 2;
    b = [0u8; 128];
    let out_len = cb.read(len, &mut b);
    assert_eq!(out_len, 2);
    assert_eq!(&b[..2], b"56");
    assert_eq!(cb.get_data_size(), 5);

    // push 10 bytes
    let len = 10;
    cb.push(&a[offset..offset+len], len);
    offset += len;
    assert_eq!(cb.get_data_size(), 8);

    // pop 3 bytes
    let len = 3;
    b = [0u8; 128];
    let out_len = cb.pop(len, &mut b);
    assert_eq!(out_len, 3);
    assert_eq!(&b[..3], b"cde");
    assert_eq!(cb.get_data_size(), 5);

    // pop 30 bytes
    let len = 30;
    b = [0u8; 128];
    let out_len = cb.pop(len, &mut b);
    assert_eq!(out_len, 5);
    assert_eq!(&b[..5], b"fghij");
    assert_eq!(cb.get_data_size(), 0);

    // push 5 bytes
    let len = 5;
    cb.push(&a[offset..offset+len], len);
    offset += len;
    assert_eq!(cb.get_data_size(), 5);

    // pop 2 bytes
    let len = 2;
    b = [0u8; 128];
    let out_len = cb.pop(len, &mut b);
    assert_eq!(out_len, 2);
    assert_eq!(cb.get_data_size(), 3);

    // push 10 bytes
    let len = 10;
    cb.push(&a[offset..offset+len], len);
    offset += len;
    assert_eq!(cb.get_data_size(), 8);

    // pop 6 bytes
    let len = 6;
    b = [0u8; 128];
    let out_len = cb.pop(len, &mut b);
    assert_eq!(out_len, 6);
    assert_eq!(&b[..6], b"rstuvw");
    assert_eq!(cb.get_data_size(), 2);

    // push 4 bytes
    let len = 4;
    cb.push(&a[offset..offset+len], len);
    offset += len;
    assert_eq!(cb.get_data_size(), 6);
}
EOF
