#include "circular_buffer.h"
#include <string.h>
#include <stdio.h>

int main() {
    char *a = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    char b[128];
    int offset = 0;

    // Replicate the C test exactly and print intermediate pop results
    CircularBuffer cb = CircularBufferCreate(8);

    // push 3: "012"
    CircularBufferPush(cb, a + 0, 3); offset = 3;
    printf("After push 3: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // push 7: "3456789"
    CircularBufferPush(cb, a + 3, 7); offset = 10;
    printf("After push 7: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // pop 3
    memset(b, 0, 128);
    size_t n = CircularBufferPop(cb, 3, b);
    printf("Pop 3: n=%zu data='%s' dataSize=%zu\n", n, b, CircularBufferGetDataSize(cb));

    // read 2
    memset(b, 0, 128);
    n = CircularBufferRead(cb, 2, b);
    printf("Read 2: n=%zu data='%s' dataSize=%zu\n", n, b, CircularBufferGetDataSize(cb));

    // push 10: "abcdefghij"
    CircularBufferPush(cb, a + 10, 10); offset = 20;
    printf("After push 10: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // pop 3
    memset(b, 0, 128);
    n = CircularBufferPop(cb, 3, b);
    printf("Pop 3: n=%zu data='%s' dataSize=%zu\n", n, b, CircularBufferGetDataSize(cb));

    // pop 30
    memset(b, 0, 128);
    n = CircularBufferPop(cb, 30, b);
    printf("Pop 30: n=%zu data='%s' dataSize=%zu\n", n, b, CircularBufferGetDataSize(cb));

    // push 5: "klmno"
    CircularBufferPush(cb, a + 20, 5); offset = 25;
    printf("After push 5: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // pop 2
    memset(b, 0, 128);
    n = CircularBufferPop(cb, 2, b);
    printf("Pop 2: n=%zu data='%s' dataSize=%zu\n", n, b, CircularBufferGetDataSize(cb));

    // push 10: "pqrstuvwxy"
    CircularBufferPush(cb, a + 25, 10); offset = 35;
    printf("After push 10: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // pop 6
    memset(b, 0, 128);
    n = CircularBufferPop(cb, 6, b);
    printf("Pop 6: n=%zu data='%s' dataSize=%zu\n", n, b, CircularBufferGetDataSize(cb));

    // push 4: "ABCD" (offset 35 = 'z'-'A'... let me check)
    printf("Push chars: %.4s\n", a + 35);
    CircularBufferPush(cb, a + 35, 4); offset = 39;
    printf("After push 4: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // Now test edge cases
    CircularBufferFree(cb);

    // Test: empty buffer pop
    cb = CircularBufferCreate(4);
    memset(b, 0, 128);
    n = CircularBufferPop(cb, 5, b);
    printf("\nEmpty pop: n=%zu\n", n);

    // Test: push 0 length
    CircularBufferPush(cb, a, 0);
    printf("After push 0: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // Test: push more than capacity
    CircularBufferPush(cb, a, 10);
    printf("After push 10 to cap 4: dataSize=%zu\n", CircularBufferGetDataSize(cb));
    memset(b, 0, 128);
    n = CircularBufferPop(cb, 4, b);
    printf("Pop 4: n=%zu data='%s'\n", n, b);

    // Test: capacity and size
    CircularBufferFree(cb);
    cb = CircularBufferCreate(16);
    printf("\nCapacity: %zu Size: %zu\n", CircularBufferGetCapacity(cb), CircularBufferGetSize(cb));

    // Test: reset
    CircularBufferPush(cb, a, 5);
    printf("Before reset: dataSize=%zu\n", CircularBufferGetDataSize(cb));
    CircularBufferReset(cb);
    printf("After reset: dataSize=%zu\n", CircularBufferGetDataSize(cb));

    // Test: read 0 length
    CircularBufferPush(cb, a, 5);
    memset(b, 0, 128);
    n = CircularBufferRead(cb, 0, b);
    printf("Read 0: n=%zu\n", n);

    // Test: pop 0 length
    n = CircularBufferPop(cb, 0, b);
    printf("Pop 0: n=%zu dataSize=%zu\n", n, CircularBufferGetDataSize(cb));

    CircularBufferFree(cb);

    printf("\nAll exploration done!\n");
    return 0;
}
EOF
