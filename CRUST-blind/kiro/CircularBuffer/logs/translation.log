use CircularBuffer::circular_buffer::CircularBuffer;

fn main() {
    let mut cb = CircularBuffer::new(8);
    let a = b"0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
    let mut b = [0u8; 128];
    let mut offset = 0usize;

    // push 3 bytes
    cb.push(&a[offset..], 3);
    offset += 3;
    assert_eq!(cb.get_data_size(), 3);

    // push 7 bytes
    cb.push(&a[offset..], 7);
    offset += 7;
    assert_eq!(cb.get_data_size(), 8);

    // pop 3 bytes
    b = [0u8; 128];
    let out = cb.pop(3, &mut b);
    assert_eq!(out, 3);
    assert_eq!(&b[..3], b"234");
    assert_eq!(cb.get_data_size(), 5);

    // read 2 bytes
    b = [0u8; 128];
    let out = cb.read(2, &mut b);
    assert_eq!(out, 2);
    assert_eq!(&b[..2], b"56");
    assert_eq!(cb.get_data_size(), 5);

    // push 10 bytes
    cb.push(&a[offset..], 10);
    offset += 10;
    assert_eq!(cb.get_data_size(), 8);

    // pop 3 bytes
    b = [0u8; 128];
    let out = cb.pop(3, &mut b);
    assert_eq!(out, 3);
    assert_eq!(&b[..3], b"cde");
    assert_eq!(cb.get_data_size(), 5);

    // pop 30 bytes
    b = [0u8; 128];
    let out = cb.pop(30, &mut b);
    assert_eq!(out, 5);
    assert_eq!(&b[..5], b"fghij");
    assert_eq!(cb.get_data_size(), 0);

    // push 5 bytes
    cb.push(&a[offset..], 5);
    offset += 5;
    assert_eq!(cb.get_data_size(), 5);

    // pop 2 bytes
    b = [0u8; 128];
    let out = cb.pop(2, &mut b);
    assert_eq!(cb.get_data_size(), 3);

    // push 10 bytes
    cb.push(&a[offset..], 10);
    offset += 10;
    assert_eq!(cb.get_data_size(), 8);

    // pop 6 bytes
    b = [0u8; 128];
    let out = cb.pop(6, &mut b);
    assert_eq!(out, 6);
    assert_eq!(&b[..6], b"rstuvw");
    assert_eq!(cb.get_data_size(), 2);

    // push 4 bytes
    cb.push(&a[offset..], 4);
    offset += 4;
    assert_eq!(cb.get_data_size(), 6);

    println!("All tests passed!");
}
