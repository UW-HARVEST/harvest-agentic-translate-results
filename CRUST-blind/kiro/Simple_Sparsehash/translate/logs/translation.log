fn bucket_to_bytes(bucket: &SparseBucket) -> Vec<u8> {
    let size = std::mem::size_of::<SparseBucket>();
    let mut bytes = vec![0u8; size];
    // We store the SparseBucket as raw fields packed into our byte buffer.
    // Layout: key_offset(usize), klen(usize), val_offset(usize), vlen(usize), hash(u64)
