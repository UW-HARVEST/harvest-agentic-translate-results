use Simple_Sparsehash::simple_sparsehash::*;

fn main() {
    // Test 1: empty array
    let arr = sparse_array_init(std::mem::size_of::<u64>(), 32).unwrap();
    assert!(sparse_array_get(&arr, 0, None).is_none());
    sparse_array_free(arr);
    println!("PASS: empty array");

    // Test 2: cannot set outside bounds
    let mut arr = sparse_array_init(std::mem::size_of::<u64>(), 32).unwrap();
    let test_num: u64 = 666;
    assert_eq!(sparse_array_set(&mut arr, 35, &test_num.to_ne_bytes(), std::mem::size_of::<u64>()), 0);
    sparse_array_free(arr);
    println!("PASS: cannot set outside bounds");

    // Test 3: cannot get outside bounds
    let arr = sparse_array_init(std::mem::size_of::<u64>(), 32).unwrap();
    assert!(sparse_array_get(&arr, 35, None).is_none());
    sparse_array_free(arr);
    println!("PASS: cannot get outside bounds");

    // Test 4: cannot set bigger elements
    let mut arr = sparse_array_init(std::mem::size_of::<u8>(), 100).unwrap();
    let test_num: u64 = 666;
    assert_eq!(sparse_array_set(&mut arr, 0, &test_num.to_ne_bytes(), std::mem::size_of::<u64>()), 0);
    sparse_array_free(arr);
    println!("PASS: cannot set bigger elements");

    // Test 5: array set and get
    let array_size = 130;
    let mut arr = sparse_array_init(std::mem::size_of::<i32>(), array_size).unwrap();
    for i in 0..array_size as i32 {
        let bytes = i.to_ne_bytes();
        assert_eq!(sparse_array_set(&mut arr, i as u32, &bytes, std::mem::size_of::<i32>()), 1);
        let mut siz: usize = 0;
        let ret = sparse_array_get(&arr, i as u32, Some(&mut siz)).unwrap();
        let val = i32::from_ne_bytes(ret[..4].try_into().unwrap());
        assert_eq!(val, i);
        assert_eq!(siz, std::mem::size_of::<i32>());
    }
    for i in 0..array_size as i32 {
        let mut siz: usize = 0;
        let ret = sparse_array_get(&arr, i as u32, Some(&mut siz)).unwrap();
        let val = i32::from_ne_bytes(ret[..4].try_into().unwrap());
        assert_eq!(val, i);
    }
    sparse_array_free(arr);
    println!("PASS: array set forward");

    // Test 6: array set backwards
    let array_size = 120;
    let mut arr = sparse_array_init(std::mem::size_of::<i32>(), array_size).unwrap();
    for i in (0..array_size as i32).rev() {
        let bytes = i.to_ne_bytes();
        assert_eq!(sparse_array_set(&mut arr, i as u32, &bytes, std::mem::size_of::<i32>()), 1);
        let mut siz: usize = 0;
        let ret = sparse_array_get(&arr, i as u32, Some(&mut siz)).unwrap();
        let val = i32::from_ne_bytes(ret[..4].try_into().unwrap());
        assert_eq!(val, i, "backwards set failed at i={}", i);
    }
    for i in (0..array_size as i32).rev() {
        let mut siz: usize = 0;
        let ret = sparse_array_get(&arr, i as u32, Some(&mut siz)).unwrap();
        let val = i32::from_ne_bytes(ret[..4].try_into().unwrap());
        assert_eq!(val, i);
    }
    sparse_array_free(arr);
    println!("PASS: array set backwards");

    // Test 7: overwrite
    let mut arr = sparse_array_init(std::mem::size_of::<i32>(), 150).unwrap();
    let v1: i32 = 666;
    let v2: i32 = 1024;
    sparse_array_set(&mut arr, 0, &v1.to_ne_bytes(), 4);
    sparse_array_set(&mut arr, 0, &v2.to_ne_bytes(), 4);
    let ret = sparse_array_get(&arr, 0, None).unwrap();
    let val = i32::from_ne_bytes(ret[..4].try_into().unwrap());
    assert_eq!(val, 1024);
    sparse_array_free(arr);
    println!("PASS: overwrite");

    // Test 8: high num at GROUP_SIZE-1
    let test_num: i32 = 65555555;
    let index = (GROUP_SIZE - 1) as u32;
    let mut arr = sparse_array_init(std::mem::size_of::<i32>(), 140).unwrap();
    assert_eq!(sparse_array_set(&mut arr, index, &test_num.to_ne_bytes(), 4), 1);
    let mut siz: usize = 0;
    let ret = sparse_array_get(&arr, index, Some(&mut siz)).unwrap();
    let val = i32::from_ne_bytes(ret[..4].try_into().unwrap());
    assert_eq!(val, test_num);
    assert_eq!(siz, 4);
    sparse_array_free(arr);
    println!("PASS: high num");

    // Test 9: dict set
    let mut dict = sparse_dict_init().unwrap();
    assert_eq!(sparse_dict_set(&mut dict, "key", 3, b"value", 5), 1);
    sparse_dict_free(dict);
    println!("PASS: dict set");

    // Test 10: dict get
    let mut dict = sparse_dict_init().unwrap();
    assert_eq!(sparse_dict_set(&mut dict, "key", 3, b"value", 5), 1);
    let mut outsize: usize = 0;
    let val = sparse_dict_get(&dict, "key", 3, Some(&mut outsize)).unwrap();
    assert_eq!(outsize, 5);
    assert_eq!(&val[..5], b"value");
    sparse_dict_free(dict);
    println!("PASS: dict get");

    // Test 11: lots of set
    let mut dict = sparse_dict_init().unwrap();
    let iterations = 1000;
    for i in 0..iterations {
        let key = format!("crazy hash{}", i);
        let val = format!("value{}", i);
        assert_eq!(sparse_dict_set(&mut dict, &key, key.len(), val.as_bytes(), val.len()), 1,
            "failed to set at i={}", i);
        assert_eq!(dict.bucket_count, i + 1);
        let mut outsize: usize = 0;
        let retrieved = sparse_dict_get(&dict, &key, key.len(), Some(&mut outsize)).unwrap();
        assert_eq!(outsize, val.len());
        assert_eq!(&retrieved[..val.len()], val.as_bytes());
    }
    for i in (0..iterations).rev() {
        let key = format!("crazy hash{}", i);
        let val = format!("value{}", i);
        let mut outsize: usize = 0;
        let retrieved = sparse_dict_get(&dict, &key, key.len(), Some(&mut outsize)).unwrap();
        assert_eq!(outsize, val.len());
        assert_eq!(&retrieved[..val.len()], val.as_bytes());
    }
    sparse_dict_free(dict);
    println!("PASS: lots of set (1000)");

    println!("\nAll tests passed!");
}
