#include "dev-deps/blake2b.h"
#include <stdio.h>
#include <string.h>

int main() {
    // Test 1: blake2b hash of empty input, 32-byte output
    {
        uint8_t out[32];
        int ret = blake2b(out, 32, NULL, 0, NULL, 0);
        printf("blake2b_empty_ret=%d\n", ret);
        printf("blake2b_empty=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test 2: blake2b hash of "abc", 32-byte output
    {
        uint8_t out[32];
        const char *msg = "abc";
        int ret = blake2b(out, 32, msg, 3, NULL, 0);
        printf("blake2b_abc_ret=%d\n", ret);
        printf("blake2b_abc=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test 3: streaming API
    {
        blake2b_state S;
        uint8_t out[32];
        blake2b_init(&S, 32);
        blake2b_update(&S, "abc", 3);
        int ret = blake2b_final(&S, out, 32);
        printf("blake2b_stream_ret=%d\n", ret);
        printf("blake2b_stream=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test 4: blake2b with key
    {
        uint8_t out[32];
        const char *key = "secretkey";
        int ret = blake2b(out, 32, "abc", 3, key, 9);
        printf("blake2b_keyed_ret=%d\n", ret);
        printf("blake2b_keyed=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test 5: 64-byte output
    {
        uint8_t out[64];
        int ret = blake2b(out, 64, "hello", 5, NULL, 0);
        printf("blake2b_64_ret=%d\n", ret);
        printf("blake2b_64=");
        for (int i = 0; i < 64; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test 6: error cases
    {
        uint8_t out[32];
        int ret = blake2b(out, 0, NULL, 0, NULL, 0);
        printf("blake2b_zero_outlen_ret=%d\n", ret);
        ret = blake2b(out, 65, NULL, 0, NULL, 0);
        printf("blake2b_big_outlen_ret=%d\n", ret);
    }
    // Test 7: double final should fail
    {
        blake2b_state S;
        uint8_t out[32];
        blake2b_init(&S, 32);
        blake2b_update(&S, "test", 4);
        blake2b_final(&S, out, 32);
        int ret = blake2b_final(&S, out, 32);
        printf("blake2b_double_final_ret=%d\n", ret);
    }
    return 0;
}
EOF
