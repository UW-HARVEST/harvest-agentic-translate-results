#define CBMT_NODE_I32
#include "merkle_tree.h"
#include <stdio.h>
#include <assert.h>

cbmt_node node_merge(void *merge_ctx, cbmt_node *left, cbmt_node *right) {
  cbmt_node ret;
  int32_t lv = *((int32_t *)left->bytes);
  int32_t rv = *((int32_t *)right->bytes);
  int32_t value = rv - lv;
  memcpy(ret.bytes, &value, 4);
  return ret;
}

cbmt_node int32_to_node(int32_t value) {
  cbmt_node node;
  memcpy(node.bytes, &value, sizeof(value));
  return node;
}
int32_t node_to_int32(cbmt_node node) {
  return *((int32_t *)node.bytes);
}

int main() {
  cbmt_node nodes[1024];
  cbmt_node leaf_nodes[256];
  cbmt_buffer nodes_buffer;
  cbmt_buffer_init(&nodes_buffer, nodes, sizeof(nodes));

  // Test single leaf
  {
    cbmt_tree tree;
    cbmt_leaves leaves;
    leaf_nodes[0] = int32_to_node(42);
    cbmt_leaves_init(&leaves, leaf_nodes, 1);
    int ret = cbmt_build_merkle_tree(&tree, &leaves, node_merge, NULL, nodes_buffer);
    assert(ret == 0);
    printf("single_leaf: tree.length=%ld, root=%d\n", tree.length, node_to_int32(cbmt_tree_root(&tree)));
  }

  // Test two leaves
  {
    cbmt_tree tree;
    cbmt_leaves leaves;
    leaf_nodes[0] = int32_to_node(10);
    leaf_nodes[1] = int32_to_node(20);
    cbmt_leaves_init(&leaves, leaf_nodes, 2);
    int ret = cbmt_build_merkle_tree(&tree, &leaves, node_merge, NULL, nodes_buffer);
    assert(ret == 0);
    printf("two_leaves: tree.length=%ld, nodes=[%d, %d, %d]\n",
      tree.length,
      node_to_int32(tree.nodes[0]),
      node_to_int32(tree.nodes[1]),
      node_to_int32(tree.nodes[2]));
  }

  // Test three leaves
  {
    cbmt_tree tree;
    cbmt_leaves leaves;
    leaf_nodes[0] = int32_to_node(1);
    leaf_nodes[1] = int32_to_node(2);
    leaf_nodes[2] = int32_to_node(3);
    cbmt_leaves_init(&leaves, leaf_nodes, 3);
    int ret = cbmt_build_merkle_tree(&tree, &leaves, node_merge, NULL, nodes_buffer);
    assert(ret == 0);
    printf("three_leaves: tree.length=%ld, nodes=[%d, %d, %d, %d, %d]\n",
      tree.length,
      node_to_int32(tree.nodes[0]),
      node_to_int32(tree.nodes[1]),
      node_to_int32(tree.nodes[2]),
      node_to_int32(tree.nodes[3]),
      node_to_int32(tree.nodes[4]));
  }

  // Test build_merkle_root single leaf
  {
    cbmt_leaves leaves;
    leaf_nodes[0] = int32_to_node(42);
    cbmt_leaves_init(&leaves, leaf_nodes, 1);
    cbmt_node root;
    int ret = cbmt_build_merkle_root(&root, &leaves, node_merge, NULL, nodes_buffer);
    assert(ret == 0);
    printf("root_single: %d\n", node_to_int32(root));
  }

  // Test build_merkle_root three leaves
  {
    cbmt_leaves leaves;
    leaf_nodes[0] = int32_to_node(1);
    leaf_nodes[1] = int32_to_node(2);
    leaf_nodes[2] = int32_to_node(3);
    cbmt_leaves_init(&leaves, leaf_nodes, 3);
    cbmt_node root;
    int ret = cbmt_build_merkle_root(&root, &leaves, node_merge, NULL, nodes_buffer);
    assert(ret == 0);
    printf("root_three: %d\n", node_to_int32(root));
  }

  // Test macros
  printf("is_left(0)=%d, is_left(1)=%d, is_left(2)=%d, is_left(3)=%d\n",
    cbmt_is_left(0), cbmt_is_left(1), cbmt_is_left(2), cbmt_is_left(3));
  printf("parent(0)=%d, parent(1)=%d, parent(2)=%d, parent(3)=%d, parent(4)=%d\n",
    cbmt_parent(0), cbmt_parent(1), cbmt_parent(2), cbmt_parent(3), cbmt_parent(4));
  printf("sibling(0)=%d, sibling(1)=%d, sibling(2)=%d, sibling(3)=%d, sibling(4)=%d\n",
    cbmt_sibling(0), cbmt_sibling(1), cbmt_sibling(2), cbmt_sibling(3), cbmt_sibling(4));

  // Test proof with single leaf index
  {
    cbmt_tree tree;
    cbmt_leaves leaves;
    leaf_nodes[0] = int32_to_node(2);
    leaf_nodes[1] = int32_to_node(3);
    leaf_nodes[2] = int32_to_node(5);
    leaf_nodes[3] = int32_to_node(7);
    leaf_nodes[4] = int32_to_node(11);
    cbmt_leaves_init(&leaves, leaf_nodes, 5);
    int ret = cbmt_build_merkle_tree(&tree, &leaves, node_merge, NULL, nodes_buffer);
    assert(ret == 0);

    cbmt_proof proof;
    uint32_t leaf_index_values[1] = { 2 };
    cbmt_indices leaf_indices;
    cbmt_indices_init(&leaf_indices, leaf_index_values, 1, 1);

    uint32_t idx_data[256];
    cbmt_node lemma_nodes[256];
    cbmt_buffer idx_buf, lem_buf;
    cbmt_buffer_init(&idx_buf, idx_data, sizeof(idx_data));
    cbmt_buffer_init(&lem_buf, lemma_nodes, sizeof(lemma_nodes));
    ret = cbmt_tree_build_proof(&proof, &tree, &leaf_indices, idx_buf, lem_buf);
    assert(ret == 0);
    printf("proof_single: indices.length=%ld, lemmas_length=%ld\n",
      proof.indices.length, proof.lemmas_length);
    for (size_t i = 0; i < proof.indices.length; i++) {
      printf("  index[%ld]=%d\n", i, proof.indices.values[i]);
    }
    for (size_t i = 0; i < proof.lemmas_length; i++) {
      printf("  lemma[%ld]=%d\n", i, node_to_int32(proof.lemmas[i]));
    }
  }

  // Test node_cmp
  {
    cbmt_node a = int32_to_node(5);
    cbmt_node b = int32_to_node(10);
    cbmt_node c = int32_to_node(5);
    printf("cmp(5,10)=%d, cmp(10,5)=%d, cmp(5,5)=%d\n",
      cbmt_node_cmp(&a, &b), cbmt_node_cmp(&b, &a), cbmt_node_cmp(&a, &c));
  }

  // Test bubble sort
  {
    uint32_t arr[5] = {3, 1, 4, 1, 5};
    cbmt_simple_bubble_sort(arr, 5, sizeof(uint32_t), cbmt_uint32_reverse_cmp);
    printf("sorted_reverse: %d %d %d %d %d\n", arr[0], arr[1], arr[2], arr[3], arr[4]);
  }

  return 0;
}
EOF
