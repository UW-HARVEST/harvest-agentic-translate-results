#include "dev-deps/blake2b.h"
#include <stdio.h>
#include <string.h>

int main() {
    // Test blake2b with empty input, 32-byte output, no key
    {
        uint8_t out[32];
        int ret = blake2b(out, 32, "", 0, NULL, 0);
        printf("blake2b_empty_ret=%d\n", ret);
        printf("blake2b_empty=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test blake2b with "abc", 32-byte output
    {
        uint8_t out[32];
        int ret = blake2b(out, 32, "abc", 3, NULL, 0);
        printf("blake2b_abc_ret=%d\n", ret);
        printf("blake2b_abc=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test blake2b with key
    {
        uint8_t out[32];
        const char *key = "secretkey";
        int ret = blake2b(out, 32, "hello", 5, key, 9);
        printf("blake2b_key_ret=%d\n", ret);
        printf("blake2b_key=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test streaming API
    {
        blake2b_state S;
        blake2b_init(&S, 32);
        blake2b_update(&S, "hello ", 6);
        blake2b_update(&S, "world", 5);
        uint8_t out[32];
        blake2b_final(&S, out, 32);
        printf("blake2b_stream=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Test blake2b one-shot same as streaming
    {
        uint8_t out[32];
        blake2b(out, 32, "hello world", 11, NULL, 0);
        printf("blake2b_oneshot=");
        for (int i = 0; i < 32; i++) printf("%02x", out[i]);
        printf("\n");
    }
    // Error: outlen=0
    {
        uint8_t out[32];
        int ret = blake2b(out, 0, "x", 1, NULL, 0);
        printf("blake2b_outlen0_ret=%d\n", ret);
    }
    return 0;
}
