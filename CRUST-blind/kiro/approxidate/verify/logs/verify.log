#define _POSIX_C_SOURCE 200809L
#include "approxidate.h"
#include <stdio.h>
#include <time.h>

int main() {
    struct timeval tv;
    int ret;

    /* 1/1/2014 UTC - parse_date_basic should handle this fully */
    ret = approxidate("1/1/2014 UTC", &tv);
    /* start_of_day should be 1388534400 */
    long sod = tv.tv_sec - (tv.tv_sec % 86400);
    printf("1_1_2014_utc: ret=%d sec=%ld sod=%ld usec=%ld\n", ret, (long)tv.tv_sec, sod, (long)tv.tv_usec);

    /* 1/1/2014 without UTC - goes through parse_date_basic, time fields are -1 so tm_to_time_t returns -1,
       then falls through to approxidate_str */
    ret = approxidate("1/1/2014", &tv);
    sod = tv.tv_sec - (tv.tv_sec % 86400);
    printf("1_1_2014: ret=%d sec=%ld sod=%ld usec=%ld\n", ret, (long)tv.tv_sec, sod, (long)tv.tv_usec);

    /* Test parse_date_basic directly for 1/1/2014 UTC */
    struct timeval tv2;
    int offset = -1;
    extern int parse_date_basic(const char*, struct timeval*, int*);
    ret = parse_date_basic("1/1/2014 UTC", &tv2, &offset);
    printf("pdb_1_1_2014_utc: ret=%d sec=%ld usec=%ld offset=%d\n", ret, (long)tv2.tv_sec, (long)tv2.tv_usec, offset);

    /* parse_date_basic for date with full time */
    offset = -1;
    ret = parse_date_basic("10/Mar/2013:00:00:02 UTC", &tv2, &offset);
    printf("pdb_full: ret=%d sec=%ld usec=%ld offset=%d\n", ret, (long)tv2.tv_sec, (long)tv2.tv_usec, offset);

    /* parse_date_basic for @epoch */
    offset = -1;
    ret = parse_date_basic("@1234567890 +0000", &tv2, &offset);
    printf("pdb_epoch: ret=%d sec=%ld usec=%ld offset=%d\n", ret, (long)tv2.tv_sec, (long)tv2.tv_usec, offset);

    /* parse_date_basic for date without time - should fail since hour/min/sec are -1 */
    offset = -1;
    ret = parse_date_basic("1/1/2014", &tv2, &offset);
    printf("pdb_notime: ret=%d sec=%ld usec=%ld offset=%d\n", ret, (long)tv2.tv_sec, (long)tv2.tv_usec, offset);

    /* parse_date_basic for date with time but no tz */
    offset = -1;
    ret = parse_date_basic("10/Mar/2013:00:00:02", &tv2, &offset);
    printf("pdb_notz: ret=%d sec=%ld usec=%ld offset=%d\n", ret, (long)tv2.tv_sec, (long)tv2.tv_usec, offset);

    return 0;
}
EOF
