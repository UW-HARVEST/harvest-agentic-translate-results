#include <stdio.h>
#include "compiler.h"
#include "helpers/vector.h"

int main() {
    struct compile_process* cp = compile_process_create("./test.txt", "./test", 0);
    
    // Division: 5/2 - the / goes through handle_comment, then pushes back and makes operator
    struct lex_process* lp = tokens_build_for_string(cp, "5/2$");
    if(lp) {
        printf("count: %d\n", vector_count(lp->token_vec));
        vector_set_peek_pointer(lp->token_vec, 0);
        for(int i = 0; i < vector_count(lp->token_vec); i++) {
            struct token* tk = vector_peek(lp->token_vec);
            if(tk) {
                printf("tok[%d] type=%d", i, tk->type);
                if(tk->type == 4) printf(" llnum=%llu", tk->llnum);
                if(tk->type == 2) printf(" sval=%s", tk->sval ? tk->sval : "NULL");
                if(tk->type == 0) printf(" sval=%s", tk->sval ? tk->sval : "NULL");
                printf("\n");
            }
        }
    }
    
    // Test: what does the C code produce for "a + b$"
    struct lex_process* lp2 = tokens_build_for_string(cp, "a + b$");
    if(lp2) {
        printf("\n'a + b$' count: %d\n", vector_count(lp2->token_vec));
        vector_set_peek_pointer(lp2->token_vec, 0);
        for(int i = 0; i < vector_count(lp2->token_vec); i++) {
            struct token* tk = vector_peek(lp2->token_vec);
            if(tk) {
                printf("tok[%d] type=%d ws=%d", i, tk->type, tk->whitespace);
                if(tk->sval) printf(" sval='%s'", tk->sval);
                if(tk->type == 4) printf(" llnum=%llu", tk->llnum);
                printf("\n");
            }
        }
    }
    
