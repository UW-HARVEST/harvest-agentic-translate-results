        (3, 3, 0u128),\n            (4, 4, 0u128),\n            (5, 5, 0u128),\n        ],\n    );\n}\n\n#[test]\nfn test_naive_case3_periodic() {\n    let (res, num) = run_naive(\"ACGTACGTACGTACGTACGT\", 6, 3);\n    assert_eq!(num, 8);\n    assert_entries(\n        &res,\n        &[\n            (0, 0, 6u128),\n            (1, 1, 6u128),\n            (4, 4, 6u128),\n            (5, 5, 6u128),\n            (8, 8, 6u128),\n            (9, 9, 6u128),\n            (12, 12, 6u128),\n            (13, 13, 6u128),\n        ],\n    );\n}\n\n#[test]\nfn test_naive_case4_long_periodic() {\n    let (res, num) = run_naive(\n        \"ACGTACGTACGTACGTACGTACGTACGTACGTACGTACGTACGT\",\n        10,\n        4,\n    );\n    assert_eq!(num, 9);\n    assert_entries(\n        &res,\n        &[\n            (0, 0, 27u128),\n            (4, 4, 27u128),\n            (8, 8, 27u128),\n            (12, 12, 27u128),\n            (16, 16, 27u128),\n            (20, 20, 27u128),\n            (24, 24, 27u128),\n            (28, 28, 27u128),\n            (32, 32, 27u128),\n        ],\n    );\n}\n\n#[test]\nfn test_naive_case5_mixed() {\n    let (res, num) = run_naive(\"ACGTGGCCAATTACGTAGCTAGCTACGATCGAT\", 8, 3);\n    assert_eq!(num, 12);\n    assert_entries(\n        &res,\n        &[\n            (0, 0, 6u128),\n            (1, 1, 6u128),\n            (2, 7, 16u128),\n            (3, 8, 3u128),\n            (8, 8, 3u128),\n            (9, 9, 3u128),\n            (12, 12, 6u128),\n            (13, 13, 6u128),\n            (16, 16, 9u128),\n            (17, 17, 9u128),\n            (19, 24, 6u128),\n            (24, 24, 6u128),\n        ],\n    );\n}\n\n#[test]\nfn test_naive_case7_k_equals_len() {\n    let (res, num) = run_naive(\"ACGTACGT\", 8, 3);\n    assert_eq!(num, 1);\n    assert_entries(&res, &[(0, 0, 6u128)]);\n}\n\n#[test]\nfn test_naive_case8_k_equals_s() {\n    let (res, num) = run_naive(\"ACGTACGTAC\", 4, 4);\n    assert_eq!(num, 7);\n    assert_entries(\n        &res,\n        &[\n   