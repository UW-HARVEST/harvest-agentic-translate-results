)) as u128;\n\n    let bytes = sequence_input.as_bytes();\n    for i in 0..len_us {\n        let base = base_to_bits(bytes[i] as char);\n        hash_fwd = ((hash_fwd << 2) | (base as u128)) & mask;\n        let comp_base = complement_base(base);\n        hash_rev = ((hash_rev >> 2) | ((comp_base as u128) << rc_shift)) & mask;\n        if i + 1 >= s_us {\n            let s_mer_pos = i - s_us + 1;\n            let canonical_hash = if hash_fwd < hash_rev { hash_fwd } else { hash_rev };\n            s_mer_hashes[s_mer_pos] = canonical_hash;\n        }\n    }\n\n    // Initialize deque\n    let window_size: usize = k_us - s_us + 1;\n    let mut deque: Vec<usize> = vec![0usize; num_s_mers];\n    let mut front: usize = 0;\n    let mut back: usize = 0;\n\n    // Use deque to find minimal s-mers in O(N)\n    for i in 0..num_s_mers {\n        while back > front && s_mer_hashes[deque[back - 1]] > s_mer_hashes[i] {\n            back -= 1;\n        }\n        deque[back] = i;\n        back += 1;\n        if i >= window_size && deque[front] <= i - window_size {\n            front += 1;\n        }\n\n        // Check for closed syncmer condition\n        if i + 1 >= window_size {\n            let min_pos = deque[front];\n            let kmer_pos = i - window_size + 1;\n            if min_pos == kmer_pos || min_pos == kmer_pos + k_us - s_us {\n                add_minimizer(results, num_results, s_mer_hashes[min_pos], kmer_pos, min_pos);\n            }\n        }\n    }\n\n    // Suppress unused warning\n    let _ = HashMap::<(), ()>::new();\n}\npub fn base_to_bits(base: char) -> u8 {\n    match base {\n        'A' | 'a' => 0,\n        'C' | 'c' => 1,\n        'G' | 'g' => 2,\n        'T' | 't' => 3,\n        _ => 0,\n    }\n}\npub fn complement_base(base: u8) -> u8 {\n    3 - base\n}\npub fn add_minimizer(results: &mut Vec<MinimizerResult>, size: &mut i32, minimizer_hash: u128, kmer_position: usize, smer_position: usize) {\n    let idx = *size as usize;\n    let entry = MinimizerResult {\n        minimizer_hash,\n        kmer_position,\n        smer_position,\n    };\n    if idx < results.len() {\n        results[idx] = entry;\n    } else {\n        results.push(entry);\n    }\n    *size += 1;\n}\n","structuredPatch":[{"oldStart":35,"oldLines":7,"newStart":35,"newLines":7,"lines":["         let comp_base = complement_base(base);","         hash_rev = ((hash_rev >> 2) | ((comp_base as u128) << rc_shift)) & mask;","         if i + 1 >= s_us {","-            let s_mer_pos = i - s_us + 1;","+            let s_mer_pos = i + 1 - s_us;","             let canonical_hash = if hash_fwd < hash_rev { hash_fwd } else { hash_rev };","             s_mer_hashes[s_mer_pos] = canonical_hash;","         }"]}],"userModified":false,"replaceAll":false}}
