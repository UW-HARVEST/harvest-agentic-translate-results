 end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            my_hand.insert_into_hand(&decided_cards.my_cards[i]);\n        }\n        let remaining = (RAZZ_CARD_IN_HAND_COUNT as usize).saturating_sub(end);\n        for _ in 0..remaining {\n            let c = deck.deal_from_deck();\n            my_hand.insert_into_hand(&c);\n        }\n    }\n\n    // Static state for the duplicated_rank_remover (mirrors C `static enum card_rank prev_rank;`)\n    use std::cell::Cell;\n    thread_local! {\n        static PREV_RANK: Cell<CardRank> = Cell::new(CardRank::InvalidRank);\n    }\n\n    fn duplicated_rank_remover(_len: u64, pos: u64, c: &Option<Card>) -> ItrAction {\n        let curr_rank = match c {\n            Some(card) => card.get_card_rank(),\n            None => return ItrAction::Continue,\n        };\n        if pos == 0 {\n            PREV_RANK.with(|p| p.set(curr_rank));\n            return ItrAction::Continue;\n        }\n        let prev = PREV_RANK.with(|p| p.get());\n        if prev == curr_rank {\n            return ItrAction::RemoveAndContinue;\n        }\n        PREV_RANK.with(|p| p.set(curr_rank));\n        ItrAction::Continue\n    }\n\n    fn length_trimmer(_len: u64, pos: u64, _c: &Option<Card>) -> ItrAction {\n        if pos >= 5 {\n            return ItrAction::RemoveAndContinue;\n        }\n        ItrAction::Continue\n    }\n\n    fn get_razz_rank(hand: &mut CardHand) -> CardRank {\n        // Reset thread-local state\n        PREV_RANK.with(|p| p.set(CardRank::InvalidRank));\n        hand.iterate_hand(duplicated_rank_remover);\n        let cards_count = hand.count_cards_in_hand();\n        if cards_count < 5 {\n            return CardRank::InvalidRank;\n        }\n        hand.iterate_hand(length_trimmer);\n        hand.get_max_rank_of_hand()\n    }\n\n    pub fn simulate_razz_game<T>(decided_cards: &DecidedCards, game_count: u64, arg: &mut T, listener: RankListener<T>) -> i32 {\n        let mut my_hand = match CardHand::create_hand(RAZZ_CARD_IN_HAND_COUNT, sort_card_by_rank) {\n            Some(h) => h,\n            None => return 1,\n        };\n\n        for _ in 0..game_count {\n            let mut deck = match CardDeck::create_shuffled_deck() {\n                Some(d) => d,\n                None => return 1,\n            };\n            strip_deck(&mut deck, decided_cards);\n            complete_hand(&mut my_hand, decided_cards, &mut deck);\n            let r = get_razz_rank(&mut my_hand);\n            listener(arg, r);\n            my_hand.reset_hand();\n        }\n        0\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":10,"lines":[" use crate::card::card::{Card, CardDeck, CardHand, CardRank};"," pub mod razz_simulation {","     use super::*;","+    use crate::card::card::{","+        sort_card_by_rank, CardSuitRank, ItrAction,","+    };","+","     pub struct DecidedCards {","         pub my_card_count: u8,","         pub my_cards: [Option<Card>; 3],"]},{"oldStart":8,"oldLines":13,"newStart":12,"newLines":99,"lines":["         pub opponent_cards: [Option<Card>; 7],","     }","     pub type RankListener<T> = fn(&mut T, CardRank);","-    pub fn simulate_razz_game<T>(decided_cards: &DecidedCards, game_count: u64, arg: &mut T, listener: RankListener<T>) -> i32 {","-        unimplemented!()","-    }","+","+    const RAZZ_CARD_IN_HAND_COUNT: u8 = 7;","+","     pub fn strip_deck(deck: &mut CardDeck, decided_cards: &DecidedCards) {","-        unimplemented!()","+        for i in 0..decided_cards.my_card_count as usize {","+            if let Some(c) = &decided_cards.my_cards[i] {","+                let csr: CardSuitRank = c.get_card_suit_rank();","+                if csr != CardSuitRank::InvalidCard {","+                    deck.strip_card_from_deck(csr);","+                }","+            }","+        }","+        for i in 0..decided_cards.opponent_card_count as usize {","+            if let Some(c) = &decided_cards.opponent_cards[i] {","+         