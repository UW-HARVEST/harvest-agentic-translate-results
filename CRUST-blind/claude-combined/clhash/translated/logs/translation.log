ngth,z);\n55\t                assert(orighash1 != newhash1);\n56\t\n57\t                if((unsigned int) bytelength <= sizeof(uint64_t))\n58\t                    assert((orighash ^ newhash) == (orighash1 ^ newhash1));\n59\t\n60\t            }\n61\t        }\n62\t    }\n63\t    free(array);\n64\t    free(array1);\n65\t    free(rs);\n66\t    printf(\"Test passed! \\n\");\n67\t}\n68\t\n69\t// ---------------------------------------------------------------------\n70\t// contributed by Eik List\n71\tstatic void clhashcollisiontest() {\n72\t    printf(\"[clhashcollisiontest] Testing whether we can induce collisions by hacking the right bytes (Eik List's test).\\n\");\n73\t    const size_t NUM_TRIALS = 10;\n74\t    const size_t CLNH_NUM_BYTES_PER_BLOCK = 1024;\n75\t    const uint8_t KEY_OFFSET = 0x63; // Anything to prevent that K = M\n76\t\n77\t    uint8_t* k = (uint8_t*)malloc(RANDOM_BYTES_NEEDED_FOR_CLHASH);\n78\t    size_t j2;\n79\t\n80\t    // Fill key with some deterministic information\n81\t    for (j2 = 0; j2 < RANDOM_BYTES_NEEDED_FOR_CLHASH; ++j2) {\n82\t        k[j2] = (j2 + KEY_OFFSET) & 0xFF;\n83\t    }\n84\t\n85\t    for (size_t i = 1; i < NUM_TRIALS; ++i) {\n86\t        for (size_t j = 1; j <= sizeof(uint64_t); ++j) {\n87\t            // #Bytes / block + x, with 1 <= x < 8\n88\t            const uint64_t mlen = i * CLNH_NUM_BYTES_PER_BLOCK + j;\n89\t            uint8_t* m = (uint8_t*)malloc(mlen);\n90\t\n91\t            for (j2 = 0; j2 < mlen; ++j2) {\n92\t                m[j2] = j2 & 0xFF;\n93\t            }\n94\t\n95\t            const uint64_t actual1 = clhash(k, (const char*)m, mlen);\n96\t\n97\t            // Change final byte\n98\t            m[mlen-1] = (m[mlen-1] + 1) & 0xFF;\n99\t\n100\t            const uint64_t actual2 = clhash(k, (const char*)m, mlen);\n101\t            const int are_equal = !memcmp(&actual1, &actual2, sizeof(uint64_t));\n102\t\n103\t            if(are_equal) printf(\"Testing %\" PRIu64 \" bytes, H1: %\" PRIX64 \", H2: %\" PRIX64 \", equal: %d \\n\", mlen, actual1, actual2, are_equal);\n104\t            free(m);\n105\t            assert(!are_equal); // strictly speaking this would not be a bug, but if it happens, it is very likely to be a bug!\n106\t        }\n107\t    }\n108\t\n109\t    free(k);\n110\t    printf(\"Test passed! \\n\");\n111\t}\n112\t\n113\t\n114\tstatic void clhashtest() {\n115\t    const int N = 1024;\n116\t    char * array  = (char*)malloc(N);\n117\t    char *  rs = (char*)malloc(RANDOM_BYTES_NEEDED_FOR_CLHASH);\n118\t    for(int k = 0; k<N; ++k) {\n119\t        array[k] = 0;\n120\t    }\n121\t    for(int k = 0; k < RANDOM_BYTES_NEEDED_FOR_CLHASH ; ++k) {\n122\t        rs[k] = (char) (1-k);\n123\t    }\n124\t\n125\t    printf(\"[clhashtest] checking that flipping a bit changes hash value with clhash \\n\");\n126\t    for(int bit = 0; bit < 64; ++bit ) {\n127\t        for(int length = (bit+8)/8; length <= (int)sizeof(uint64_t); ++length) {\n128\t            uint64_t x = 0;\n129\t            uint64_t orig = clhash(rs, (const char *)&x, length);\n130\t            x ^= ((uint64_t)1) << bit;\n131\t            uint64_t flip = clhash(rs, (const char *)&x, length);\n132\t            assert(flip != orig);\n133\t            x ^= ((uint64_t)1) << bit;\n134\t            uint64_t back = clhash(rs, (const char *)&x, length);\n135\t            assert(back == orig);\n136\t        }\n137\t    }\n138\t\n139\t    free(array);\n140\t    free(rs);\n141\t    printf(\"Test passed! \\n\");\n142\t}\n143\t\n144\tvoid demo() {\n145\t    // generate random key\n146\t    void * random =  get_random_key_for_clhash(UINT64_C(0x23a23cf5033c3c81),UINT64_C(0xb3816f6a2c68e530));\n147\t    uint64_t hashvalue1 = clhash(random,\"my dog\",6);\n148\t    uint64_t hashvalue2 = clhash(random,\"my cat\",6);\n149\t    uint64_t hashvalue3 = clhash(random,\"my dog\",6);\n150\t    assert(hashvalue1 == hashvalue3);\n151\t    assert(hashvalue1 != hashvalue2);// very likely to be true\n152\t\n153\t    free(random);\n154\t}\n155\t\n156\t\n157\tint main() {\n158\t    clhashtest();\n159\t    clhashcollisiontest();\n160\t    clhashavalanchetest();\n161\t    demo();\n162\t}\n163\t\n164\t"}]},"parent_tool_use_id":null,"session_id":"86e79e97-05fc-4b8d-bf01-d7671f3f927f","uuid":"6370d6ba-7231-4dea-adc1-67578bf7a051","timestamp":"2026-06-01T13:59:38.997Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-6in5BL/project/c_src/tests/unit.c","content":"#include <assert.h>\n#include <string.h>\n#include <stdio.h>\n#include <inttypes.h>\n\n#include \"../src/include/clhash.h\"\n\n\n\n\nstatic inline void flipbit ( void * block, int length, uint32_t bit ) {\n    uint8_t * b = (uint8_t*)block;\n    int byte = bit >> 3;\n    assert(byte < length);\n    bit = bit & 0x7;\n    b[byte] ^= (1 << bit);\n}\n\nstatic void clhashavalanchetest() {\n    const int N = 1024;\n    char * array  = (char*)malloc(N);\n    char * array1  = (char*)malloc(N);\n\n    char *  rs = (char*)malloc(RANDOM_BYTES_NEEDED_FOR_CLHASH);\n    for(int k = 0; k<N; ++k) {\n        array[k] = 0;\n        array1[k] = 0;\n    }\n    for(int k = 0; k<RANDOM_BYTES_NEEDED_FOR_CLHASH; ++k) {\n        rs[k] = k+1-k*k;\n    }\n    int K = 16;\n    printf(\"[clhashavalanchetest] Testing CLHASH avalanche effect.\\n\");\n\n    for(int bytelength = 1; bytelength < K; ++bytelength ) {\n\n        for(int whichcase = 0; whichcase < 256; ++whichcase) {\n\n            for(int k = 0; k<bytelength; ++k) {\n                array[k] = whichcase;\n                array1[k] = whichcase + 35;\n            }\n            uint64_t orighash = clhash(rs, array, bytelength);\n            uint64_t orighash1 = clhash(rs, array1, bytelength);\n\n            for(int z = 0; z < 8*bytelength; ++z) {\n                flipbit(array,bytelength,z);\n                uint64_t newhash = clhash(rs, array, bytelength);\n                flipbit(array,bytelength,z);\n                assert(orighash != newhash);\n\n                flipbit(array1,