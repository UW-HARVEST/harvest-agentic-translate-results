 inversion_list_create(cap, j, buff);\n441\t}\n442\t\n443\tstatic InversionList *_intersection(const InversionList *set1,\n444\t                                    const InversionList *set2) {\n445\t  if (set2 == NULL) {\n446\t    return inversion_list_clone(set1);\n447\t  }\n448\t  if (set1 == NULL) {\n449\t    return inversion_list_clone(set2);\n450\t  }\n451\t\n452\t  unsigned int *buff =\n453\t      _get_buffer((set1->support + set2->support) * sizeof(unsigned int));\n454\t  if (!buff) {\n455\t    return NULL;\n456\t  }\n457\t\n458\t  unsigned int j = 0;\n459\t  unsigned int i2 = 0;\n460\t  unsigned int cap = MAX(set1->capacity, set2->capacity);\n461\t\n462\t  unsigned int i = 0;\n463\t  unsigned int set1_size = set1->size;\n464\t  unsigned int set2_size = set2->size;\n465\t\n466\t  while (i < set1_size && i2 < set2_size) {\n467\t    unsigned int set1_min = set1->couples[i];\n468\t    unsigned int set1_max = set1->couples[i + 1];\n469\t\n470\t    unsigned int set2_min = set2->couples[i2];\n471\t    unsigned int set2_max = set2->couples[i2 + 1];\n472\t\n473\t    unsigned int min = MAX(set1_min, set2_min);\n474\t    unsigned int max = MIN(set1_max, set2_max);\n475\t\n476\t    if (min <= max) {\n477\t      for (unsigned int k = min; k <= max; k++) {\n478\t        if (inversion_list_member(set1, k) &&\n479\t            inversion_list_member(set2, k)) {\n480\t          buff[j++] = k;\n481\t        }\n482\t      }\n483\t    }\n484\t\n485\t    if (set1_max < set2_max) {\n486\t      i += 2;\n487\t    } else if (set1_max > set2_max) {\n488\t      i2 += 2;\n489\t    } else {\n490\t      i += 2;\n491\t      i2 += 2;\n492\t    }\n493\t  }\n494\t\n495\t  return inversion_list_create(cap, j, buff);\n496\t}\n497\t\n498\tstatic InversionList *_difference(const InversionList *set1,\n499\t                                  const InversionList *set2) {\n500\t  if (set2 == NULL) {\n501\t    return inversion_list_clone(set1);\n502\t  }\n503\t  if (set1 == NULL) {\n504\t    return inversion_list_clone(set2);\n505\t  }\n506\t\n507\t  unsigned int *buff =\n508\t      _get_buffer((set1->support + set2->support) * sizeof(unsigned int));\n509\t  if (!buff) {\n510\t    return NULL;\n511\t  }\n512\t\n513\t  unsigned int j = 0;\n514\t  unsigned int i2 = 0;\n515\t  unsigned int cap = MAX(set1->capacity, set2->capacity);\n516\t\n517\t  unsigned int i = 0;\n518\t  unsigned int set1_size = set1->size;\n519\t  unsigned int set2_size = set2->size;\n520\t\n521\t  while (i < set1_size && i2 < set2_size) {\n522\t    unsigned int set1_min = set1->couples[i];\n523\t    unsigned int set1_max = set1->couples[i + 1];\n524\t\n525\t    unsigned int set2_min = set2->couples[i2];\n526\t    unsigned int set2_max = set2->couples[i2 + 1];\n527\t\n528\t    unsigned int min = MAX(set1->couples[0], set1->couples[0]);\n529\t    unsigned int max = MIN(set1_max, set2_max);\n530\t\n531\t    if (min <= max) {\n532\t      for (unsigned int k = min; k <= max; k++) {\n533\t        if (inversion_list_member(set1, k) &&\n534\t            !inversion_list_member(set2, k)) {\n535\t          buff[j++] = k;\n536\t        }\n537\t      }\n538\t    }\n539\t\n540\t    if (set1_max < set2_max) {\n541\t      for (unsigned int k = set1_min; k < set2_max; k++) {\n542\t        if (inversion_list_member(set1, k) &&\n543\t            !inversion_list_member(set2, k)) {\n544\t          buff[j++] = k;\n545\t        }\n546\t      }\n547\t      i += 2;\n548\t    } else if (set1_max > set2_max) {\n549\t      i2 += 2;\n550\t    } else {\n551\t      i += 2;\n552\t      i2 += 2;\n553\t    }\n554\t  }\n555\t\n556\t  return inversion_list_create(cap, j, buff);\n557\t}\n558\t\n559\t\n560\t/***************************EXERCICE4***************************/\n561\t\n562\tInversionList *inversion_list_union(const InversionList *set, ...) {\n563\t  const InversionList *arg;\n564\t\n565\t  InversionList *res = NULL;\n566\t  InversionList *temp = inversion_list_clone(set);\n567\t  va_list args;\n568\t  unsigned int i = 0;\n569\t\n570\t  va_start(args, set);\n571\t  unsigned int count = 0;\n572\t\n573\t  while ((arg = va_arg(args, const InversionList *))) {\n574\t    inversion_list_destroy(res);\n575\t\n576\t    res = _union(temp, arg);\n577\t\n578\t    inversion_list_destroy(temp);\n579\t    temp = inversion_list_clone(res);\n580\t  }\n581\t\n582\t  va_end(args);\n583\t\n584\t  inversion_list_destroy(temp);\n585\t\n586\t  return res;\n587\t}\n588\t\n589\tInversionList *inversion_list_intersection(const InversionList *set, ...) {\n590\t  const InversionList *arg;\n591\t  InversionList *res = NULL;\n592\t  InversionList *temp = inversion_list_clone(set);\n593\t\n594\t  va_list args;\n595\t  va_start(args, set);\n596\t\n597\t  while ((arg = va_arg(args, const InversionList *))) {\n598\t    inversion_list_destroy(res);\n599\t\n600\t    res = _intersection(temp, arg);\n601\t\n602\t    inversion_list_destroy(temp);\n603\t    temp = inversion_list_clone(res);\n604\t  }\n605\t\n606\t  va_end(args);\n607\t  inversion_list_destroy(temp);\n608\t\n609\t  return res;\n610\t}\n611\t\n612\tInversionList *inversion_list_difference(const InversionList *set, ...) {\n613\t  const InversionList *arg;\n614\t  InversionList *res;\n615\t  InversionList *temp = NULL;\n616\t\n617\t  va_list args;\n618\t  va_start(args, set);\n619\t\n620\t  while ((arg = va_arg(args, const InversionList *))) {\n621\t    if (inversion_list_not_equal(set, arg)) {\n622\t      if (temp == NULL) {\n623\t        inversion_list_destroy(temp);\n624\t        temp = inversion_list_clone(arg);\n625\t      } else {\n626\t        res = _union(temp, arg);\n627\t\n628\t        inversion_list_destroy(temp);\n629\t        temp = inversion_list_clone(res);\n630\t\n631\t        inversion_list_destroy(res);\n632\t      }\n633\t    }\n634\t  }\n635\t  va_end(args);\n636\t  res = _difference(set, temp);\n637\t\n638\t  inversion_list_destroy(temp);\n639\t  return res;\n640\t}\n641\t\n642\t/***************************EXERCICE3***************************/\n643\tInversionList *inversion_list_symmetric_difference(\n644\t    const InversionList *set1, const InversionList *set2) {\n645\t  InversionList *null = NULL;\n646\t  InversionList *i = inversion_list_intersection(set1, set2, null);\n647\t  InversionList *u = inversion_list_union(set1, set2, null);\n648\t  InversionList *res = inversion_list_difference(u, i, null);\n649\t\n650\t  inversion_list_destroy(i);\n651\t  inversion_list_destroy(u);\n652\t  inversion_list_destroy(null);\n653\t\n654\t  return res;\n655\t}\n656\t\n657\t/***************************EXERCICE 6***************************/\n658\t\n659\tInversionListIterator *inversion_list_iterator_create(\n660\t    const InversionList *set) {\n661\t  assert(_counter > 0);\n662\t  InversionListIterator *iterator = malloc(sizeof(InversionListIterator));\n663\t  if (iterator) {\n664\t    iterator->set = set;\n665\t\n666\t    iterator->index = 0;\n667\t  }\n668\t  return iterator;\n669\t}\n670\t\n671\tvoid inversion_list_iterator_destroy(InversionListIterator *iterator) {\n672\t  assert(_counter > 0);\n673\t  free(iterator);\n674\t}\n675\t\n676\tInversionListIterator *inversion_list_iterator_next(\n677\t    InversionListIterator *iterator) {\n678\t  assert(_counter > 0);\n679\t  iterator->index++;\n680\t  return iterator;\n681\t}\n682\t\n683\tInversionListIterator *inversion_list_iterator_rewind(\n684\t    InversionListIterator *iterator) {\n685\t  assert(_counter > 0);\n686\t  iterator->index = 0;\n687\t  return iterator;\n688\t}\n689\t\n690\tbool inversion_list_iterator_valid(const InversionListIterator *iterator) {\n691\t  assert(_counter > 0);\n692\t  return iterator->index < iterator->set->couples[iterator->set->size - 1];\n693\t}\n694\t\n695\tunsigned int inversion_list_iterator_get(InversionListIterator *iterator) {\n696\t  if (iterator) {\n697\t    if (inversion_list_member(iterator->set, iterator->index)) {\n698\t      return iterator->index;\n699\t    } else {\n700\t      return inversion_list_iterator_get(\n701\t          inversion_list_iterator_next(iterator));\n702\t    }\n703\t  }\n704\t  return iterator->set->support;\n705\t}\n706\t\n707\t/***************************EXERCICE 7***************************/\n708\tInversionListCoupleIterator *inversion_list_couple_iterator_create(\n709\t    const InversionList *set) {\n710\t  assert(_counter > 0);\n711\t  InversionListCoupleIterator *iterator =\n712\t      malloc(sizeof(InversionListIterator));\n713\t  if (iterator) {\n714\t    iterator->set = set;\n715\t    iterator->index = 0;\n716\t  }\n717\t  return iterator;\n718\t}\n719\t\n720\tvoid inversion_list_iterator_couple_destroy(\n721\t    InversionListIterator *iterator) {\n722\t  assert(_counter > 0);\n723\t  free(iterator);\n724\t}\n725\t\n726\tInversionListCoupleIterator *inversion_list_couple_iterator_next(\n727\t    InversionListCoupleIterator *iterator) {\n728\t  assert(_counter > 0);\n729\t  iterator->index++;\n730\t  return iterator;\n731\t}\n732\t\n733\tInversionListCoupleIterator *inversion_list_couple_iterator_rewind(\n734\t    InversionListCoupleIterator *iterator) {\n735\t  assert(_counter > 0);\n736\t  iterator->index = 0;\n737\t  return iterator;\n738\t}\n739\t\n740\tbool inversion_list_iterator_couple_valid(\n741\t    const InversionListCoupleIterator *iterator) {\n742\t  assert(_counter > 0);\n743\t  return iterator->index < iterator->set->size / 2;\n744\t}\n745\t\n746\tunsigned int inversion_list_couple_iterator_get_inf(\n747\t    const InversionListCoupleIterator *iterator) {\n748\t  return iterator->set->couples[iterator->index * 2];\n749\t}\n750\t\n751\tunsigned int inversion_list_couple_iterator_get_sup(\n752\t    const InversionListCoupleIterator *iterator) {\n753\t  return iterator->set->couples[iterator->index * 2 + 1];\n754\t}\n755\t"}]},"parent_tool_use_id":null,"session_id":"4cbf28ea-555e-41a4-9eb7-0739e8d9dc98","uuid":"180eb6c1-819f-4df6-acb7-afc1337f3143","timestamp":"2026-06-01T11:08:33.403Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-kInZBc/project/c_src/src/inversion-list/inversion-list.c","content":"#include <assert.h>\n#include <errno.h>\n#include <math.h>\n#include <stdarg.h>\n#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"../inversion-list/inversion-list.h\"  // NOLINT(build/include)\n#include \"inversion-list.inc\"\n\n#define MAX(a, b) ((a) > (b) ? (a) : (b))\n#define MIN(a, b) ((a) < (b) ? (a) : (b))\n\nstatic void *_buffer = NULL;\nstatic size_t _size = 0;\n\nstatic void *_get_buffer(size_t size) {\n  if (size > _size) {\n    void *buffer = realloc(_buffer, size);\n    if (buffer) {\n      _buffer = buffer;\n      _size = size;\n    } else {\n      errno = ENOMEM;\n      return NULL;\n    }\n  }\n  return _buffer;\n}\n\nstatic int _counter = 0;\n\nstatic void _verify(void) { assert(_counter == 0); }\n\nbool inversion_list_init(void) {\n  static bool first = true;\n  if (first) {\n    atexit(_verify);\n    first = false;\n  }\n  if (!_counter++) {\n    assert(printf(\"Inversion list initialised\\n\"));\n  }\n  return true;\n}\n\nbool inversion_list_finish(void) {\n  if (_counter) {\n    if (!--_counter) {\n      free(_buffer);\n      _buffer = NULL;\n      _size = 0;\n\n      inversion_list_to_string(NULL);\n      assert(printf(\"Inversion list finished\\n\"));\n    }\n    return true;\n  } else {\n    return false;\n  }\n}\n\nstatic int _compare_unsigned_int(const void *value1, const void *value2) {\n  return *(unsigned int *)value1 -\n         *(unsigned int *)value2;  // NOLINT(readability/casting)\n}\n\nInversionList *inversion_list_create(unsigned int capacity, size_t count,\n                                     const unsigned int *values) {\n  assert(_counter > 0);\n\n  unsigned int *buffer = _get_buffer(count * sizeof(unsigned int));\n  if (!buffer) {\n    return NULL;\n  }\n\n  unsigned int i;\n  size_t size;\n  memcpy(buffer, values,\n         count * sizeof(unsigned int));  // flawfinder: ignore\n  unsigned int support = 0;\n  if (count) {\n    qsort(buffer, count, sizeof *buffer, _compare_unsigned_int);\n    if (buffer[count - 1] >= capacity) {\n      errno = EINVAL;\n      return NULL;\n    }\n    size = 2;\n    support++;\n    for (i = 1; i < count; i++) {\n      if (buffer[i] != buffer[i - 1]) {\n        support++;\n        if (buffer[i] > buffer[i - 1] + 1) {\n          size += 2;\n        }\n      }\n    }\n  } else {\n    size = 0;\n  }\n\n  InversionList *set =\n      malloc(sizeof(InversionList) + size * sizeof(unsigned int));\n  if (set) {\n    set->size = size;\n    set->capacity = capacity;\n    set->support = support;\n    if (size) {\n      i = 0;\n      unsigned int current = 0;\n      set->couples[current] = buffer[i];\n      current++;\n      set->couples[current] = buffer[i] + 1;\n      for (i = 1; i < count; i++) {\n        if (buffer[i] == set->couples[current]) {\n          set->couples[current]++;\n        } else if (buffer[i] > set->couples[current]) {\n          current++;\n          set->couples[current] = buffer[i];\n          current++;\n          set->couples[current] = buffer[i] + 1;\n        }\n      }\n    }\n    return set;\n  } else {\n    errno = ENOMEM;\n    return NULL;\n  }\n}\n\nvoid inversion_list_destroy(InversionList *set) {\n  assert(_counter > 0);\n\n  free(set);\n}\n\nunsigned int inversion_list_capacity(const InversionList *set) {\n  assert(_counter > 0);\n\n  return set->capacity;\n}\n\nunsigned int inversion_list_support(const InversionList *set) {\n  assert(_counter > 0);\n\n  return set->support;\n}\n\nstatic int _index_of(const void *element, const void *base, size_t size) {\n  return (element - base) / size;\n}\n\nstatic int _sign;\nstatic bool _strict;\nstatic const void *_found;\nstatic int (*_compare_func)(const void *, const void *);\nstatic int _search(const void *key, const void *value) {\n  int compare = _compare_func(key, value);\n  if (_strict) {\n    if (_sign * compare > 0) {\n      _found = value;\n      compare = _sign;\n    } else {\n      compare = -_sign;\n    }\n  } else {\n    if (_sign * compare >= 0) {\n      _found = value;\n      compare = _sign;\n    }\n  }\n  return compare;\n}\n\nstatic const void *_bound(const void *key, const void *base, size_t nmemb,\n                          size_t size,\n                          int (*compar)(const void *, const void *),\n                          int sign, bool strict) {\n  _compare_func = compar;\n  _found = NULL;\n  _sign = sign;\n  _strict = strict;\n  bsearch(key, base, nmemb, size, _search);\n  return _found;\n}\n\nstatic const void *_lower_bound(const void *key, const void *base,\n                                size_t nmemb, size_t size,\n                                int (*compar)(const void *, const void *),\n                                bool strict) {\n  return _bound(key, base, nmemb, size, compar, 1, strict);\n}\n\nstatic const void *_upper_bound(const void *key, const void *base,\n                                size_t nmemb, size_t size,\n                                int (*compar)(const void *, const void *),\n                                bool strict) {\n  return _bound(key, base, nmemb, size, compar, -1, strict);\n}\n\nbool inversion_list_member(const InversionList *set, unsigned int value) {\n  assert(_counter > 0);\n\n  const void *bound =\n      _lower_bound(&value, set->couples, set->size, sizeof(unsigned int),\n                   _compare_unsigned_int, false);\n  if (bound) {\n    return _index_of(bound, set->couples, sizeof(unsigned int)) % 2 == 0;\n  } else {\n    return false;\n  }\n}\n\nInversionList *inversion_list_clone(const InversionList *set) {\n  assert(_counter > 0);\n\n  InversionList *clone =\n      malloc(sizeof(InversionList) + set->size * sizeof(unsigned int));\n  if (clone) {\n    memcpy(clone, set,\n           sizeof(InversionList) +\n               set->size * sizeof(unsigned int));  // flawfinder: ignore\n    return clone;\n  } else {\n    errno = ENOMEM;\n    return NULL;\n  }\n}\n\nInversionList *inversion_list_complement(const InversionList *set) {\n  assert(_counter > 0);\n\n  size_t size = set->size;\n  if (set->couples[0] == 0 &&\n      set->couples[set->size - 1] == set->capacity) {\n    size -= 2;\n  } else if (set->couples[0] != 0 &&\n             set->couples[set->size - 1] != set->capacity) {\n    size += 2;\n  }\n\n  InversionList *complement =\n      malloc(sizeof(InversionList) + size * sizeof(unsigned int));\n  if (complement) {\n    complement->size = size;\n    complement->capacity = set->capacity;\n    complement->support = set->capacity - set->support;\n    if (set->couples[0] == 0) {\n      if (set->couples[set->size - 1] == set->capacity) {\n        memcpy(complement->couples, set->couples + 1,\n               size * sizeof(unsigned int));  // flawfinder: ignore\n      } else {\n        memcpy(complement->couples, set->couples + 1,\n               (size - 1) * sizeof(unsigned int));  // flawfinder: ignore\n        complement->couples[size - 1] = set->capacity;\n      }\n    } else {\n      complement->couples[0] = 0;\n      if (set->couples[set->size - 1] == set->capacity) {\n        memcpy(complement->couples + 1, set->couples,\n               (size - 1) * sizeof(unsigned int));  // flawfinder: ignore\n      } else {\n        memcpy(complement->couples + 1, set->couples,\n               (size - 2) * sizeof(unsigned int));  // flawfinder: ignore\n        complement->couples[size - 1] = set->capacity;\n      }\n    }\n    return complement;\n  } else {\n    errno = ENOMEM;\n    return NULL;\n  }\n}\n\nstatic bool _add_string(char **pstring, unsigned int *plength,\n                        const char *add) {\n  if (add) {\n    unsigned int inc_length = strlen(add);  // flawfinder: ignore\n    char *string = realloc(*pstring, *plength + inc_length + 1);\n    if (string) {\n      *pstring = string;\n      strncpy(*pstring + *plength, add,\n              inc_length + 1);  // flawfin