{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011mTmmVodgVqjgNhpumuDyw","type":"tool_result","content":"1\t#ifndef CIRC_ARRAY_H_\n2\t#define CIRC_ARRAY_H_\n3\t\n4\t#include <stdlib.h>\n5\t#include <string.h>\n6\t#include <assert.h>\n7\t\n8\t#include \"carrays.h\"\n9\t\n10\t//\n11\t// Generic circular array\n12\t//\n13\t\n14\t#ifndef roundup64\n15\t  #define roundup64(x) roundup64(x)\n16\t  static inline uint64_t roundup64(uint64_t x) {\n17\t    return (--x, x|=x>>1, x|=x>>2, x|=x>>4, x|=x>>8, x|=x>>16, x|=x>>32, ++x);\n18\t  }\n19\t#endif\n20\t\n21\ttypedef struct\n22\t{\n23\t  const size_t el; // element size in bytes\n24\t  size_t start, n, size, mask; // n<=size, mask=size-1\n25\t  void *b;\n26\t} CircBuf;\n27\t\n28\tstatic inline void circa_alloc(CircBuf *l, size_t el, size_t size) __attribute__((unused));\n29\tstatic inline void circa_dealloc(CircBuf *l) __attribute__((unused));\n30\tstatic inline void circa_capacity(CircBuf *l, size_t s) __attribute__((unused));\n31\tstatic inline void* circa_push(CircBuf *l) __attribute__((unused));\n32\tstatic inline void* circa_pop(CircBuf *l) __attribute__((unused));\n33\tstatic inline void* circa_unshift(CircBuf *l) __attribute__((unused));\n34\tstatic inline void* circa_shift(CircBuf *l) __attribute__((unused));\n35\tstatic inline void circa_norm(CircBuf *l) __attribute__((unused));\n36\t\n37\tstatic inline void circa_alloc(CircBuf *l, size_t el, size_t size)\n38\t{\n39\t  size = roundup64(size);\n40\t  CircBuf tmp = {.el = el, .start = 0, .n = 0,\n41\t                   .size = size, .mask = size-1,\n42\t                   .b = malloc(size * el)};\n43\t  memcpy(l, &tmp, sizeof(CircBuf));\n44\t}\n45\t\n46\tstatic inline void circa_dealloc(CircBuf *l)\n47\t{\n48\t  free(l->b);\n49\t}\n50\t\n51\tstatic inline void circa_resize(CircBuf *l, size_t size)\n52\t{\n53\t  // resize is only for growing array and new size must be a power of two\n54\t  assert(size > l->size && (size & (size-1)) == 0);\n55\t\n56\t  l->b = realloc(l->b, l->el*size);\n57\t  if(l->start + l->n > l->size) {\n58\t    // nend is the num items at the end of the b, nbeg is at the beginning\n59\t    size_t nend = l->size-l->start, nbeg = (l->start+l->n) & l->mask;\n60\t    if(nend < nbeg) memmove(l->b+size-nend, l->b+l->size-nend, l->el*nend);\n61\t    else            memmove(l->b+l->size, l->b, l->el*nbeg);\n62\t  }\n63\t  l->size = size;\n64\t  l->mask = size-1;\n65\t}\n66\t\n67\tstatic inline void circa_capacity(CircBuf *l, size_t size)\n68\t{\n69\t  if(size > l->size) circa_resize(l, roundup64(size));\n70\t}\n71\t\n72\t#define circa_pos(l,idx) (((l)->start + (idx)) & (l)->mask)\n73\t#define circa_get(l,idx) ((l)->b + (l)->el * circa_pos(l,idx))\n74\t\n75\t// Add to start\n76\t// Returns a pointer to the item added (zero'd)\n77\tstatic inline void* circa_push(CircBuf *l)\n78\t{\n79\t  if(l->n == l->size) circa_resize(l, l->size*2);\n80\t  l->start = l->start ? l->start-1 : l->size-1;\n81\t  l->n++;\n82\t  void *ptr = circa_get(l, 0);\n83\t  memset(ptr, 0, l->el);\n84\t  return ptr;\n85\t}\n86\t\n87\t// Remove from start\n88\t// Returns a pointer to the item removed\n89\tstatic inline void* circa_pop(CircBuf *l)\n90\t{\n91\t  assert(l->n > 0);\n92\t  size_t old = l->start;\n93\t  l->start = (l->start+1) & l->mask;\n94\t  l->n--;\n95\t  return l->b + l->el*old;\n96\t}\n97\t\n98\t// Add to end\n99\t// Returns a pointer to the item added (zero'd)\n100\tstatic inline void* circa_unshift(CircBuf *l)\n101\t{\n102\t  if(l->n == l->size) circa_resize(l, l->size*2);\n103\t  void *ptr = circa_get(l, l->n);\n104\t  memset(ptr, 0, l->el);\n105\t  l->n++;\n106\t  return ptr;\n107\t}\n108\t\n109\t// Remove from end\n110\t// Returns a pointer to the item removed\n111\tstatic inline void* circa_shift(CircBuf *l)\n112\t{\n113\t  assert(l->n > 0);\n114\t  void *ptr = circa_get(l, l->n);\n115\t  l->n--;\n116\t  return ptr;\n117\t}\n118\t\n119\t// Stop circular array from wrapping around\n120\tstatic inline void circa_norm(CircBuf *l)\n121\t{\n122\t  size_t newstart, nright, nleft;\n123\t  if(l->start + l->n > l->size) {\n124\t    newstart = (l->size - l->n) / 2; // pick a new start\n125\t    nleft = l->start + l->n - l->size;\n126\t    nright = l->size - l->start;\n127\t    if(nleft <= newstart) {\n128\t      memmove(l->b+newstart, l->b+l->start, l->el * nright);\n129\t      memcpy(l->b+newstart+nright, l->b, l->el * nleft);\n130\t    } else {\n131\t      // memset(l->b+nleft, 0, l->el*(l->size-l->n)); // silence valgrind warning\n132\t      gca_cycle_left(l->b, l->size, l->el, l->start-newstart);\n133\t    }\n134\t    l->start = newstart;\n135\t  }\n136\t}\n137\t\n138\t#endif /* CIRC_ARRAY_H_ */\n139\t"}]},"parent_tool_use_id":null,"session_id":"c98d8dee-9666-409e-8a3d-73704d2829d8","uuid":"c64f7295-4e19-45b6-9a01-ac4ecf811c72","timestamp":"2026-06-01T13:55:02.357Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-2oXSmp/project/c_src/src/circ_array.h","content":"#ifndef CIRC_ARRAY_H_\n#define CIRC_ARRAY_H_\n\n#include <stdlib.h>\n#include <string.h>\n#include <assert.h>\n\n#include \"carrays.h\"\n\n//\n// Generic circular array\n//\n\n#ifndef roundup64\n  #define roundup64(x) roundup64(x)\n  static inline uint64_t roundup64(uint64_t x) {\n    return (--x, x|=x>>1, x|=x>>2, x|=x>>4, x|=x>>8, x|=x>>16, x|=x>>32, ++x);\n  }\n#endif\n\ntypedef struct\n{\n  const size_t el; // element size in bytes\n  size_t start, n, size, mask; // n<=size, mask=size-1\n  void *b;\n} CircBuf;\n\nstatic inline void circa_alloc(CircBuf *l, size_t el, size_t size) __attribute__((unused));\nstatic inline void circa_dealloc(CircBuf *l) __attribute__((unused));\nstatic inline void circa_capacity(CircBuf *l, size_t s) __attribute__((unused));\nstatic inline void* circa_push(CircBuf *l) __attribute__((unused));\nstatic inline void* circa_pop(CircBuf *l) __attribute__((unused));\nstatic inline void* circa_unshift(CircBuf *l) __attribute__((unused));\nstatic inline void* circa_shift(CircBuf *l) __attribute__((unused));\nstatic inline void circa_norm(CircBuf *l) __attribute__((unused));\n\nstatic inline void circa_alloc(CircBuf *l, size_t el, size_t size)\n{\n  size = roundup64(size);\n  CircBuf tmp = {.el = el, .start = 0, .n = 0,\n                   .size = size, .mask = size-1,\n                   .b = malloc(size * el)};\n  memcpy(l, &tmp, sizeof(CircBuf));\n}\n\nstatic inline void circa_dealloc(CircBuf *l)\n{\n  free(l->b);\n}\n\nstatic inline void circa_resize(CircBuf *l, size_t size)\n{\n  // resize is only for growing array and new size must be a power of two\n  assert(size > l->size && (size & (size-1)) == 0);\n\n  l->b = realloc(l->b, l->el*size);\n  if(l->start + l->n > l->size) {\n    // nend is the num items at the end of the b, nbeg is at the beginning\n    size_t nend = l->size-l->start, nbeg = (l->start+l->n) & l->mask;\n    if(nend < nbeg) memmove(l->b+size-nend, l->b+l->size-nend, l->el*nend);\n    else            memmove(l->b+l->size, l->b, l->el*nbeg);\n  }\n  l->size = size;\n  l->mask = size-1;\n}\n\nstatic inline void circa_capacity(CircBuf *l, size_t size)\n{\n  if(size > l->size) circa_resize(l, roundup64(size));\n}\n\n#define circa_pos(l,idx) (((l)->start + (idx)) & (l)->mask)\n#define circa_get(l,idx) ((l)->b + (l)->el * circa_pos(l,idx))\n\n// Add to start\n// Returns a pointer to the item added (zero'd)\nstatic inline void* circa_push(CircBuf *l)\n{\n  if(l->n == l->size) circa_resize(l, l->size*2);\n  l->start = l->start ? l->start-1 : l->size-1;\n  l->n++;\n  void *ptr = circa_get(l, 0);\n  memset(ptr, 0, l->el);\n  return ptr;\n}\n\n// Remove from start\n// Returns a pointer to the item removed\nstatic inline void* circa_pop(CircBuf *l)\n{\n  assert(l->n > 0);\n  size_t old = l->start;\n  l->start = (l->start+1) & l->mask;\n  l->n--;\n  return l->b + l->el*old;\n}\n\n// Add to end\n// Returns a pointer to the item added (zero'd)\nstatic inline void* circa_unshift(CircBuf *l)\n{\n  if(l->n == l->size) circa_resize(l, l->size*2);\n  void *ptr = circa_get(l, l->n);\n  memset(ptr, 0, l->el);\n  l->n++;\n  return ptr;\n}\n\n// Remove from end\n// Returns a pointer to the item removed\nstatic inline void* circa_shift(CircBuf *l)\n{\n  assert(l->n > 0);\n  void *ptr = circa_get(l, l->n);\n  l->n--;\n  return ptr;\n}\n\n// Stop circular array from wrapping around\nstatic inline void circa_norm(CircBuf *l)\n{\n  size_t newstart, nright, nleft;\n  if(l->start + l->n > l->size) {\n    newstart = (l->size - l->n) / 2; // pick a new start\n    nleft = l->start + l->n - l->size;\n    nright = l->size - l->start;\n    if(nleft <= newstart) {\n      memmove(l->b+newstart, l->b+l->start, l->el * nright);\n      memcpy(l->b+newstart+nright, l->b, l->el * nleft);\n    } else {\n      // memset(l->b+nleft, 0, l->el*(l->size-l->n)); // silence valgrind warning\n      gca_cycle_left(l->b, l->size, l->el, l->start-newstart);\n    }\n    l->start = newstart;\n  }\n}\n\n#endif /* CIRC_ARRAY_H_ */\n","numLines":139,"startLine":1,"totalLines":139}}}
