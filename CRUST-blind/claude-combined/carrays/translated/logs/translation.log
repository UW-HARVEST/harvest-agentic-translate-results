\n    let mut buf = CircBuf::new(4, 2);\n    {\n        let s = buf.push();\n        assert_eq!(s, &[0u8, 0, 0, 0]);\n    }\n    {\n        let s = buf.unshift();\n        assert_eq!(s, &[0u8, 0, 0, 0]);\n    }\n}\n\n#[test]\nfn test_capacity_resize() {\n    let mut buf = CircBuf::new(1, 2);\n    // initial size = 2 (rounded up)\n    buf.capacity(10);\n    // Now should be at least 10, rounded up to power of 2 = 16\n    // Test by pushing 16 items without resize occurring within capacity\n    for i in 0..10u8 {\n        let s = buf.unshift();\n        s[0] = i;\n    }\n    // Verify shift retrieves them in reverse order\n    for i in (0..10u8).rev() {\n        let s = buf.shift();\n        assert_eq!(s[0], i);\n    }\n}\n\n#[test]\nfn test_unshift_growth() {\n    // start very small, force resize\n    let mut buf = CircBuf::new(1, 1);\n    for i in 0..20u8 {\n        let s = buf.unshift();\n        s[0] = i;\n    }\n    // shift in reverse\n    for i in (0..20u8).rev() {\n        let s = buf.shift();\n        assert_eq!(s[0], i);\n    }\n}\n\n#[test]\nfn test_push_growth() {\n    let mut buf = CircBuf::new(1, 1);\n    for i in 0..20u8 {\n        let s = buf.push();\n        s[0] = i;\n    }\n    // pop in LIFO order\n    for i in (0..20u8).rev() {\n        let s = buf.pop();\n        assert_eq!(s[0], i);\n    }\n}\n\n#[test]\nfn test_norm() {\n    // create scenario where buffer wraps around\n    let mut buf = CircBuf::new(1, 8);\n    // unshift 4 items\n    for i in 0..4u8 {\n        let s = buf.unshift();\n        s[0] = i + 1; // 1..4\n    }\n    // pop 2 items so start advances\n    let _ = buf.pop();\n    let _ = buf.pop();\n    // unshift 4 more items - now wraps around\n    for i in 0..4u8 {\n        let s = buf.unshift();\n        s[0] = i + 10; // 10..13\n    }\n    // call norm to unwrap\n    buf.norm();\n    // shift items - we should be able to retrieve them\n    // Order: items remaining: 3,4 (from original) then 10,11,12,13\n    // shift removes from the end (last-in)\n    // current items (front->back): 3, 4, 10, 11, 12, 13\n    let s = buf.shift();\n    assert_eq!(s[0], 13);\n    let s = buf.shift();\n    assert_eq!(s[0], 12);\n    let s = buf.shift();\n    assert_eq!(s[0], 11);\n    let s = buf.shift();\n    assert_eq!(s[0], 10);\n    let s = buf.shift();\n    assert_eq!(s[0], 4);\n    let s = buf.shift();\n    assert_eq!(s[0], 3);\n}\n\n#[test]\nfn test_mixed_ops() {\n    let mut buf = CircBuf::new(1, 4);\n    // unshift 1, 2 (back of queue)\n    {\n        let s = buf.unshift();\n        s[0] = 1;\n    }\n    {\n        let s = buf.unshift();\n        s[0] = 2;\n    }\n    // push 3 (front of queue)\n    {\n        let s = buf.push();\n        s[0] = 3;\n    }\n    // current: front->back: 3, 1, 2\n    // pop from front -> 3\n    {\n        let s = buf.pop();\n        assert_eq!(s[0], 3);\n    }\n    // shift from back -> 2\n    {\n        let s = buf.shift();\n        assert_eq!(s[0], 2);\n    }\n    // shift from back -> 1\n    {\n        let s = buf.shift();\n        assert_eq!(s[0], 1);\n    }\n}\n\nfn main() {}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
