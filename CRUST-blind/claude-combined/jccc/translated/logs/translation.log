ttype_many_chars() -> i32 {","-unimplemented!()","+    if ttype_many_chars(\"foo\") != TokenType::TT_IDENTIFIER {","+        return -1;","+    }","+    if ttype_many_chars(\"struct\") != TokenType::TT_STRUCT {","+        return -1;","+    }","+    if ttype_many_chars(\"while\") != TokenType::TT_WHILE {","+        return -1;","+    }","+    0"," }","+"," /// Skips characters until the next token is found."," pub fn skip_to_token(l: &mut Lexer) -> i32 {","-unimplemented!()","+    let mut prev: i32;","+    let mut in_block = 0;","+    let mut pass = 0;","+","+    let cur = lexer_getchar(l);","+    if cur == -1 {","+        return -1;","+    }","+    prev = cur;","+    if !(cur == b' ' as i32 || cur == b'\\t' as i32 || cur == b'/' as i32) {","+        lexer_ungetchar(l);","+        return 0;","+    }","+","+    loop {","+        let cur = lexer_getchar(l);","+        if cur == -1 {","+            return -1;","+        }","+        let curb = cur as u8;","+","+        if curb == b'/' && prev == b'/' as i32 && in_block == 0 {","+            in_block = 1;","+        } else if curb == b'*' && prev == b'/' as i32 && in_block == 0 {","+            in_block = 2;","+            pass = 2;","+        } else if (in_block == 1 && curb == b'\\n')","+            || (in_block == 2 && curb == b'/' && prev == b'*' as i32 && pass <= 0)","+        {","+            in_block = 0;","+        } else if prev == b'/' as i32","+            && !(curb == b'*' || curb == b'/')","+            && in_block == 0","+        {","+            lexer_ungetchar(l);","+            return 0;","+        }","+","+        if !(curb == b' ' || curb == b'\\t' || curb == b'/') && in_block == 0 {","+            lexer_ungetchar(l);","+            return 0;","+        }","+","+        pass -= 1;","+        prev = cur;","+    }"," }","+"," /// Pushes a token back into the lexer's buffer."," pub fn unlex(l: &mut Lexer, t: &Token) -> i32 {","-unimplemented!()","+    if l.unlexed_count as usize >= TOKEN_PUTBACKS {","+     