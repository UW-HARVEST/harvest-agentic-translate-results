}\n\n#[test]\nfn test_get_digest_high_bytes() {\n    let h = fnv::fnv1(&[0xffu8, 0x80, 0x01]);\n    let s = fnv::getDigest(h);\n    assert_eq!(s, \"d950b8186c127fa1\");\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":131,"cache_read_input_tokens":44885,"cache_creation":{"ephemeral_5m_input_tokens":131,"ephemeral_1h_input_tokens":0},"output_tokens":28,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"13672f0b-baa7-480a-b6a1-2142a52cdb93","uuid":"16ad4936-f205-4b02-822c-1882b3dbed66"}
