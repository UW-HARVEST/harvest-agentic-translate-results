onflict_val=%d, size=%d\\n\",\n        c, *(int*)conflict_kv.key, *(int*)conflict_kv.value, hamt_size(h));\n\n    // Search for 5 again\n    int q5 = 5;\n    f = hamt_search(h, &q5);\n    printf(\"search(5) -> value=%d\\n\", *(int*)f->value);\n\n    // Remove 5\n    key_value_t removed_kv;\n    bool r = hamt_remove(h, &q5, &removed_kv);\n    printf(\"remove(5) = %d, key=%d, val=%d, size=%d\\n\", r, *(int*)removed_kv.key, *(int*)removed_kv.value, hamt_size(h));\n\n    // Search for 5 after removal\n    f = hamt_search(h, &q5);\n    printf(\"search(5) after remove -> %s\\n\", f ? \"found\" : \"NULL\");\n\n    // Remove non-existent\n    int q_ne = 999;\n    r = hamt_remove(h, &q_ne, &removed_kv);\n    printf(\"remove(999) = %d, size=%d\\n\", r, hamt_size(h));\n\n    // Remove all remaining\n    for (int i = 0; i < N; i++) {\n        if (i == 5) continue;\n        int q = i;\n        bool r2 = hamt_remove(h, &q, &removed_kv);\n        printf(\"remove(%d) = %d, size=%d\\n\", i, r2, hamt_size(h));\n    }\n\n    // Test single insert + remove\n    hamt_t *h2 = new_hamt(hamt_str_hash, hamt_str_equals);\n    char *s = \"hello\";\n    bool c2 = hamt_set(h2, s, s, &conflict_kv);\n    printf(\"single insert hello, conflict=%d, size=%d\\n\", c2, hamt_size(h2));\n    key_value_t *fs = hamt_search(h2, \"hello\");\n    printf(\"search(hello) -> %s\\n\", fs ? (char*)fs->value : \"NULL\");\n\n    bool r2 = hamt_remove(h2, \"hello\", &removed_kv);\n    printf(\"remove(hello) = %d, size=%d, key=%s, val=%s\\n\", r2, hamt_size(h2), (char*)removed_kv.key, (char*)removed_kv.value);\n\n    // Empty remove\n    bool r3 = hamt_remove(h2, \"anything\", &removed_kv);\n    printf(\"remove from empty = %d, size=%d\\n\", r3, hamt_size(h2));\n\n    // Empty search\n    fs = hamt_search(h2, \"anything\");\n    printf(\"search empty -> %s\\n\", fs ? \"found\" : \"NULL\");\n\n    return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
