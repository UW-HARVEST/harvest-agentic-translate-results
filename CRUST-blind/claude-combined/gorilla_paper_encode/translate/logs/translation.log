unt;\n        }\n        0\n    }\n    pub fn write_bits(&mut self, u: U64, nbits: i32) -> i32 {\n        if nbits > 64 || nbits < 0 {\n            return -1;\n        }\n        if nbits == 0 {\n            return 0;\n        }\n        let mut u: u64 = u << (64 - nbits as u32);\n        let mut nbits = nbits;\n        while nbits >= 8 {\n            let byte = (u >> 56) as u8;\n            if self.write_byte(byte) != 0 {\n                return -1;\n            }\n            u <<= 8;\n            nbits -= 8;\n        }\n        while nbits > 0 {\n            if self.write_bit((u >> 63) != 0) != 0 {\n                return -2;\n            }\n            u <<= 1;\n            nbits -= 1;\n        }\n        0\n    }\n    pub fn write_flush(&mut self, bit: bool) -> i32 {\n        while self.bit_count != 8 {\n            if self.write_bit(bit) != 0 {\n                return -1;\n            }\n        }\n        0\n    }\n}\npub struct BitReader <'a>{\n    pub data: &'a [u8],\n    pub len: U32,\n    pub v: U64,\n    pub n: U32,\n}\nimpl BitReader<'_> {\n    pub fn bit_readbuf(&mut self) -> i32 {\n        let mut byte_n: u32 = 8u32 - (self.n / 8);\n\n        if self.len != 0 && byte_n > self.len {\n            byte_n = self.len;\n        }\n\n        // Guard: no remaining data\n        if self.len == 0 {\n            return 0;\n        }\n\n        if byte_n == 8 {\n            // Need at least 8 bytes in the slice\n            let d = self.data;\n            self.v = (d[7] as u64)\n                | ((d[6] as u64) << 8)\n                | ((d[5] as u64) << 16)\n                | ((d[4] as u64) << 24)\n                | ((d[3] as u64) << 32)\n                | ((d[2] as u64) << 40)\n                | ((d[1] as u64) << 48)\n                | ((d[0] as u64) << 56);\n            self.n = 64;\n            self.data = &self.data[8..];\n            self.len -= 8;\n            return 0;\n        }\n\n        for i in 0..byte_n {\n            self.n += 8;\n            self.