st_match_half_sorted_rev() {\n    let a = vec![arc(0, 0, 0), arc(2, 1, 5), arc(3, 2, 6)];\n    let b = vec![arc(0, 0, 0), arc(5, 5, 7), arc(6, 6, 8)];\n    let mut q: Queue<(ArcData, ArcData)> = Queue::new();\n    match_half_sorted_rev(&a, &b, &mut q);\n    assert_eq!(q.len(), 2);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1411,"cache_read_input_tokens":146755,"cache_creation":{"ephemeral_5m_input_tokens":1411,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"96f71bf1-42e2-412f-a86d-f9ab65fb1f4d","uuid":"88991e4e-43a8-415e-983d-6322fa15899c"}
