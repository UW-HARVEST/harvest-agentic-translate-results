{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GLbym911GieHGdYhhp4f3z","type":"tool_result","content":"1\t#include <stdlib.h>\n2\t#include <assert.h>\n3\t#include \"fst.h\"\n4\t#include \"iter.h\"\n5\t#include \"bitset.h\"\n6\t#include \"queue.h\"\n7\t\n8\tvoid fst_close(struct _fst * fst, struct _queue * finals) {\n9\t    /*\n10\t    This methods replace multiple final states with\n11\t    a single final state. \n12\t\n13\t    */\n14\t    if ( finals->n_items < 2)\n15\t        return;    \n16\t\n17\t    struct _state * state;\n18\t    struct _sr sr = sr_get(fst->sr_type); \n19\t    state_t final;\n20\t    state_t s;\n21\t\n22\t    final = fst_add_state(fst);\n23\t    fst_set_final(fst, final, sr.one);\n24\t\n25\t\n26\t    while(queue_deque(finals, &s) != NULL) {\n27\t        state = &fst->states[s];\n28\t        state->final = 0;\n29\t        fst_add_arc(    fst,\n30\t                        s,\n31\t                        final,\n32\t                        EPS,\n33\t                        EPS,\n34\t                        state->weight);\n35\t    }\n36\t}\n37\t\n38\tvoid fst_reverse(struct _fst * fst) {\n39\t    struct _sr sr = sr_get(fst->sr_type); \n40\t    struct _state * state;\n41\t    struct _arc * arc;\n42\t    struct _fst * orig = fst_create();\n43\t    state_t s;\n44\t    state_t start_s = fst->start;\n45\t\n46\t    fst_copy(fst, orig);\n47\t\n48\t    for(s=0; s < fst->n_states; ++s ) {\n49\t        state = &fst->states[s];\n50\t\n51\t        // 'delete' arcs from each of the automaton states\n52\t        state->n_arcs = 0;\n53\t       \n54\t        // change start to final \n55\t        // NOTE: fst should have only 1 start state\n56\t        if (state->final) {\n57\t            fst->start = s;\n58\t            state->final = 0;\n59\t        }\n60\t    }\n61\t\n62\t    // set start as final\n63\t    fst_set_final(fst, start_s, sr.one);\n64\t\n65\t    // add reversed arcs to the automaton\n66\t    for(s=0; s < orig->n_states; ++s) {\n67\t        state = &orig->states[s];         \n68\t\n69\t        for(arc_t a=0; a < state->n_arcs; ++a) { \n70\t            arc = &state->arcs[a];\n71\t            fst_add_arc(    fst, \n72\t                            arc->state, \n73\t                            s, \n74\t                            arc->ilabel, \n75\t                            arc->olabel, \n76\t                            arc->weight);\n77\t        }\n78\t    }\n79\t\n80\t    fst_remove(orig);\n81\t}\n82\t\n83\tstruct _fst * fst_rm_states(struct _fst * fst, struct _bitset * mask) {\n84\t    struct _state * state;\n85\t    struct _arc * arc;\n86\t\n87\t    state_t idx[sizeof(state_t) * fst->n_states];\n88\t\n89\t    state_t shift = 0;\n90\t\n91\t    for(state_t s=0; s < fst->n_states; ++s) {\n92\t        if (bitset_get(mask, s) ) {\n93\t            ++shift;\n94\t        }\n95\t        else {\n96\t            idx[s] = shift;\n97\t            fst->states[s - shift] = fst->states[s];\n98\t        }\n99\t    } \n100\t\n101\t    fst->n_states -= shift;\n102\t\n103\t    // TODO: do not forget to clean up arcs of removed states\n104\t\n105\t    // fix arc's destination state id\n106\t    for(state_t s=0; s < fst->n_states; ++s) {\n107\t        state = &fst->states[s];\n108\t\n109\t        arc_t sh = 0;\n110\t        \n111\t        for(arc_t a=0; a < state->n_arcs; ++a) {\n112\t            arc = &state->arcs[a];\n113\t            arc->state -= idx[arc->state];\n114\t\n115\t            // found link to non-existing state\n116\t            if (arc->state >= fst->n_states) {\n117\t                ++sh;\n118\t            } else {\n119\t                state->arcs[a - sh] = state->arcs[a];\n120\t            }\n121\t        }\n122\t        \n123\t        state->n_arcs -= sh;\n124\t    }\n125\t\n126\t    return fst;\n127\t}\n128\t\n129\tstatic void fst_get_finals(struct _fst * fst, struct _queue * finals) {\n130\t    struct _state * state;\n131\t\n132\t    for (state_t s=0; s < fst->n_states; ++s) {\n133\t        state = fst->states + s;\n134\t        if (state->final)\n135\t            queue_enque(finals, &s);\n136\t    }\n137\t}\n138\t\n139\tstruct _fst * fst_trim(struct _fst * fst) {\n140\t    struct _queue * finals = queue_create(sizeof(state_t));\n141\t\n142\t    /*\n143\t    Before trimming check that we have at least one final states.\n144\t    If not then all the states are not co-accessible and\n145\t    there resulting automaton should be empty.\n146\t    */\n147\t\n148\t    fst_get_finals(fst, finals);\n149\t\n150\t    if (finals->n_items == 0) {\n151\t        fst_empty(fst);\n152\t         \n153\t    } else { \n154\t\n155\t        if (finals->n_items > 1) {\n156\t            fst_close(fst, finals);\n157\t        }\n158\t\n159\t        /* \n160\t        First lets traverse it directly and remove\n161\t        all the unreachable states    \n162\t        */\n163\t\n164\t        struct _fst_iter * iter = fst_iter_create(fst);\n165\t        while ( fst_iter_next(iter) != -1 ) \n166\t            ;\n167\t        \n168\t        /* \n169\t        Then inverse the arcs and traverse starting\n170\t        from the final states of the original transducer\n171\t        \n172\t        NOTE: we should refresh finals queue\n173\t        */\n174\t\n175\t        fst_reverse(fst);\n176\t\n177\t        struct _fst_iter * iter_rev = fst_iter_create(fst);\n178\t        while ( fst_iter_next(iter_rev) != -1 ) \n179\t            ;\n180\t\n181\t        /* Reverse it back */\n182\t        fst_reverse(fst);\n183\t\n184\t        /* Remove non accessible and non coacessible states */\n185\t\n186\t        bitset_intersect(iter->marked, iter_rev->marked);\n187\t\n188\t        bitset_toggle_all(iter->marked);\n189\t\n190\t        //fst_rm_states(fst, bitset_toggle_all(iter->marked));\n191\t        fst_rm_states(fst, iter->marked);\n192\t\n193\t\n194\t        fst_iter_remove(iter_rev);\n195\t        fst_iter_remove(iter);\n196\t    }\n197\t\n198\t    queue_remove(finals);\n199