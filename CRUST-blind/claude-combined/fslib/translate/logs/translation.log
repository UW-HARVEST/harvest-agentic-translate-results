 fst.n_states -= shift;\n    fst.states = new_states;\n\n    // Adjust arcs\n    for s in 0..fst.n_states as usize {\n        let mut new_arcs: Vec<ArcData> = Vec::new();\n        let n_arcs = fst.states[s].n_arcs as usize;\n        for a in 0..n_arcs {\n            let mut arc = fst.states[s].arcs[a];\n            let dst = arc.state as usize;\n            if dst < idx.len() {\n                let shifted = idx[dst];\n                if mask.get(dst) {\n                    // arc points to removed state, drop\n                    continue;\n                }\n                arc.state = arc.state - shifted;\n            }\n            // Bound check: the destination should now be valid\n            if (arc.state as u32) < fst.n_states {\n                new_arcs.push(arc);\n            }\n        }\n        fst.states[s].n_arcs = new_arcs.len() as u32;\n        fst.states[s].arcs = new_arcs;\n    }\n}\n\npub fn fst_get_finals(fst: &mut Fst, finals: &mut Queue<u32>) {\n    for s in 0..fst.n_states {\n        let state = &fst.states[s as usize];\n        if state.final_state {\n            finals.enqueue(s);\n        }\n    }\n}\n\npub fn fst_trim(fst: &mut Fst) {\n    let mut finals: Queue<u32> = Queue::new();\n    fst_get_finals(fst, &mut finals);\n\n    if finals.len() == 0 {\n        fst.empty();\n        return;\n    }\n    if finals.len() > 1 {\n        fst_close(fst, &mut finals);\n    }\n\n    // Forward iteration\n    let forward_marked: BitSet = {\n        let mut iter = FstIter::new(fst);\n        while iter.next().is_some() {}\n        // Move out marked\n        let m = iter.marked.words.clone();\n        let mut bs = BitSet::new(fst.n_states as usize);\n        // Copy words; bs.words has same size as fst.n_states/word_size + 1\n        // forward_marked may have different size (created in iter), but should match\n        bs.words = m;\n        bs\n    };\n\n    // Reverse and traverse\n    fst_reverse(fst);\n\n    let backward_marked: BitSet = {\n        let mut iter = FstIter::new(fst);\n        while iter.next().is_some() {}\n        let m = iter.marked.words.clone();\n        let mut bs = BitSet::new(fst.n_states as usize);\n        bs.words = m;\n        bs\n    };\n\n    // Reverse back\n    fst_reverse(fst);\n\n    // intersect, toggle\n    let mut intersect = forward_marked;\n    // pad to match if needed\n    let target_len = backward_marked.words.len();\n    while intersect.words.len() < target_len {\n        intersect.words.push(0);\n    }\n    let mut bm = backward_marked;\n    while bm.words.len() < intersect.words.len() {\n        bm.words.push(0);\n    }\n    intersect.intersect(&bm);\n    let toggled = intersect.toggle_all();\n\n    fst_rm_states(fst, &toggled);\n}\n\n// expose finals API\npub fn fst_get_finals_pub(fst: &Fst, finals: &mut Queue<u32>) {\n    for s in 0..fst.n_states {\n        let state = &fst.states[s as usize];\n        if state.final_state {\n            finals.enqueue(s);\n        }\n    }\n}\n\n// preserve the original signature's existence\n#[allow(dead_code)]\npub fn fst_get_finals_pair(_fst: &mut Fst, _finals: &mut Queue<(ArcData, ArcData)>) {\n    // not used in C; placeholder\n}\n","userModified":false}}
