{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FJc15TTX7icxG45J8c3MRE","type":"tool_result","content":"1\t\n2\t\n3\t#include \"vector.h\"\n4\t#include <memory.h>\n5\t#include <stdlib.h>\n6\t#include <assert.h>\n7\t#include <stdbool.h>\n8\t#include <stdio.h>\n9\t\n10\tstatic bool vector_in_bounds_for_at(struct vector *vector, int index)\n11\t{\n12\t    return (index >= 0 && index < vector->rindex);\n13\t}\n14\t\n15\tstatic bool vector_in_bounds_for_pop(struct vector *vector, int index)\n16\t{\n17\t    return (index >= 0 && index < vector->mindex);\n18\t}\n19\t\n20\tstatic void vector_assert_bounds_for_pop(struct vector *vector, int index)\n21\t{\n22\t    assert(vector_in_bounds_for_pop(vector, index));\n23\t}\n24\t\n25\tstruct vector *vector_create_no_saves(size_t esize)\n26\t{\n27\t    struct vector *vector = calloc(sizeof(struct vector), 1);\n28\t    vector->data = malloc(esize * VECTOR_ELEMENT_INCREMENT);\n29\t    vector->mindex = VECTOR_ELEMENT_INCREMENT;\n30\t    vector->rindex = 0;\n31\t    vector->pindex = 0;\n32\t    vector->esize = esize;\n33\t    vector->count = 0;\n34\t    return vector;\n35\t}\n36\t\n37\tsize_t vector_total_size(struct vector *vector)\n38\t{\n39\t    return vector->count * vector->esize;\n40\t}\n41\t\n42\tsize_t vector_element_size(struct vector *vector)\n43\t{\n44\t    return vector->esize;\n45\t}\n46\t\n47\tstruct vector *vector_clone(struct vector *vector)\n48\t{\n49\t    void *new_data_address = calloc(vector->esize, vector->count + VECTOR_ELEMENT_INCREMENT);\n50\t    memcpy(new_data_address, vector->data, vector_total_size(vector));\n51\t    struct vector *new_vec = calloc(sizeof(struct vector), 1);\n52\t    memcpy(new_vec, vector, sizeof(struct vector));\n53\t    new_vec->data = new_data_address;\n54\t\n55\t    // Saves are not cloned with vector_clone yet.\n56\t    // assert(vector->saves == NULL);\n57\t    return new_vec;\n58\t}\n59\t\n60\tstruct vector *vector_create(size_t esize)\n61\t{\n62\t    struct vector *vec = vector_create_no_saves(esize);\n63\t    vec->saves = vector_create_no_saves(sizeof(struct vector));\n64\t    return vec;\n65\t}\n66\t\n67\tvoid vector_free(struct vector *vector)\n68\t{\n69\t    free(vector->data);\n70\t    free(vector);\n71\t}\n72\t\n73\tint vector_current_index(struct vector *vector)\n74\t{\n75\t    return vector->rindex;\n76\t}\n77\t\n78\tvoid vector_resize_for_index(struct vector *vector, int start_index, int total_elements)\n79\t{\n80\t    if (start_index + total_elements < vector->mindex)\n81\t    {\n82\t        // Nothing to resize\n83\t        return;\n84\t    }\n85\t\n86\t    vector->data = realloc(vector->data, ((start_index + total_elements + VECTOR_ELEMENT_INCREMENT) * vector->esize));\n87\t    assert(vector->data);\n88\t    vector->mindex = start_index + total_elements;\n89\t}\n90\t\n91\tvoid vector_resize_for(struct vector *vector, int total_elements)\n92\t{\n93\t    vector_resize_for_index(vector, vector->rindex, total_elements);\n94\t}\n95\t\n96\tvoid vector_resize(struct vector *vector)\n97\t{\n98\t    // Zero elements as we want to see if we have already overflowed the index\n99\t    vector_resize_for(vector, 0);\n100\t}\n101\t\n102\tvoid *vector_at(struct vector *vector, int index)\n103\t{\n104\t    return vector->data + (index * vector->esize);\n105\t}\n106\t\n107\tvoid vector_set_peek_pointer(struct vector *vector, int index)\n108\t{\n109\t    vector->pindex = index;\n110\t}\n111\t\n112\tvoid vector_set_peek_pointer_end(struct vector *vector)\n113\t{\n114\t    vector_set_peek_pointer(vector, vector->rindex - 1);\n115\t}\n116\t\n117\tvoid *vector_peek_at(struct vector *vector, int index)\n118\t{\n119\t    if (!vector_in_bounds_for_at(vector, index))\n120\t    {\n121\t        return NULL;\n122\t    }\n123\t\n124\t    void* ptr = vector_at(vector, index);\n125\t    return ptr;\n126\t}\n127\t\n128\tvoid *vector_peek_no_increment(struct vector *vector)\n129\t{\n130\t    if (!vector_in_bounds_for_at(vector, vector->pindex))\n131\t    {\n132\t        return NULL;\n133\t    }\n134\t\n135\t    void *ptr = vector_at(vector, vector->pindex);\n136\t    return ptr;\n137\t}\n138\t\n139\tvoid vector_peek_back(struct vector* vector)\n140\t{\n141\t    vector->pindex--;\n142\t}\n143\t\n144\tvoid *vector_peek(struct vector *vector)\n145\t{\n146\t    void *ptr = vector_peek_no_increment(vector);\n147\t    if (!ptr)\n148\t    {\n149\t        return NULL;\n150\t    }\n151\t\n152\t    if (vector->flags & VECTOR_FLAG_PEEK_DECREMENT)\n153\t        vector->pindex--;\n154\t    else\n155\t        vector->pindex++;\n156\t\n157\t    return ptr;\n158\t}\n159\t\n160\tvoid vector_set_flag(struct vector *vector, int flag)\n161\t{\n162\t    vector->flags |= flag;\n163\t}\n164\t\n165\tvoid vector_unset_flag(struct vector *vector, int flag)\n166\t{\n167\t    vector->flags &= ~flag;\n168\t}\n169\t\n170\tvoid *vector_peek_ptr(struct vector *vector)\n171\t{\n172\t    void **ptr = vector_peek(vector);\n173\t    if (!ptr)\n174\t    {\n175\t        return NULL;\n176\t    }\n177\t\n178\t    return *ptr;\n179\t}\n180\t\n181\tvoid *vector_peek_ptr_at(struct vector *vector, int index)\n182\t{\n183\t    if (index < 0 || index > vector->count)\n184\t    {\n185\t        return NULL;\n186\t    }\n187\t\n188\t    void **ptr = vector_at(vector, index);\n189\t    if (!ptr)\n190\t    {\n191\t        return NULL;\n192\t    }\n193\t\n194\t    return *ptr;\n195\t}\n196\t\n197\tvoid *vector_back_ptr(struct vector *vector)\n198\t{\n199\t    void **ptr = vector_back(vector);\n200\t    if (!ptr)\n201\t    {\n202\t        return NULL;\n203\t    }\n204\t\n205\t    return *ptr;\n206\t}\n207\t\n208\tvoid vector_save(struct vector *vector)\n209\t{\n210\t    // Let's save the state of this vector to its self\n211\t    struct vector tmp_vec = *vector;\n212\t    // We not allowed to modify the saves so set it to NULL\n213\t    // when we push it to the save stack.\n214\t    tmp_vec.saves = NULL;\n215\t    vector_push(vector->saves, &tmp_vec);\n216\t}\n217\t\n218\tvoid vector_restore(struct vector *vector)\n219\t{\n220\t    struct vector save_vec = *((struct vector *)(vector_back(vector->saves)));\n221\t    save_vec.saves = vector->saves;\n222\t    *vector = save_vec;\n223\t    vector_pop(vector->saves);\n224\t}\n225\t\n226\tvoid vector_save_purge(struct vector *vector)\n227\t{\n228\t    vector_pop(vector->saves);\n229\t}\n230\t\n231\tvoid vector_pop_last_peek(struct vector* vector)\n232\t{\n233\t    assert(vector->pindex >= 1);\n234\t    vector_pop_at(vector, vector->pindex-1);\n235\t}\n236\t\n237\tvoid vector_push(struct vector *vector, void *elem)\n238\t{\n239\t    void *ptr = vector_at(vector, vector->rindex);\n240\t    memcpy(ptr, elem, vector->esize);\n241\t\n242\t    vector->rindex++;\n243\t    vector->count++;\n244\t\n245\t    if (vector->rindex >= vector->mindex)\n246\t    {\n247\t        vector_resize(vector);\n248\t    }\n249\t}\n250\t\n251\tint vector_fread(struct vector *vector, int amount, FILE *fp)\n252\t{\n253\t    size_t read_amount = fread(vector->data, 1, 1, fp);\n254\t    while (read_amount)\n255\t    {\n256\t        vector_push(vector, &read_amount);\n257\t        read_amount = fread(vector->data, 1, 1, fp);\n258\t    }\n259\t\n260\t    return 0;\n261\t}\n262\t\n263\tconst char *vector_string(struct vector *vec)\n264\t{\n265\t    return vec->data;\n266\t}\n267\t\n268\tvoid *vector_data_end(struct vector *vector)\n269\t{\n270\t    return vector->data + vector->rindex * vector->esize;\n271\t}\n272\t\n273\tsize_t vector_elements_left(struct vector *vector, int index)\n274\t{\n275\t    return vector->count - index;\n276\t}\n277\t\n278\tint vector_elements_until_end(struct vector *vector, int index)\n279\t{\n280\t    return vector->count - index;\n281\t}\n282\t\n283\tvoid vector_shift_right_in_bounds_no_increment(struct vector *vector, int index, int amount)\n284\t{\n285\t    vector_resize_for_index(vector, index, amount);\n286\t    int eindex = (index + amount);\n287\t    size_t byt