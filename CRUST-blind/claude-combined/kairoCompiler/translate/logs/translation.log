}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3260,"cache_read_input_tokens":63330,"cache_creation":{"ephemeral_5m_input_tokens":3260,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d1e3c993-7488-4e40-a0b7-819e9f774d92","uuid":"5d2324b6-e98d-4587-929c-9b7bac871bc9"}
