{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NVgU1KVQczpbEfuR81sezW","type":"tool_result","content":"1\t#include <math.h>\n2\t#include <stdio.h>\n3\t#include <stdlib.h>\n4\t#include \"data.h\"\n5\t#include \"functions.h\"\n6\t\n7\t// Maximum acceptable error when comparing double values.\n8\t#define TOLERANCE 0.00005d\n9\t\n10\t// Terminal color constants.\n11\t#define RED   \"\\033[1;31m\"\n12\t#define GREEN \"\\033[1;32m\"\n13\t#define RESETCOLOR \"\\033[0m\"\n14\t\n15\t// Keeps track of the number of failed tests.\n16\tunsigned int number_failed;\n17\t\n18\t/**\n19\t * Asserts that two double values are equals, within the allowed tolerance.\n20\t * Prints to console if the test passed or not.\n21\t */\n22\tvoid assert(const double result, const double expected, const char* test_description) {\n23\t  if (fabs(result - expected) > TOLERANCE) {\n24\t    ++number_failed;\n25\t    printf(RED \"Test: '%s' FAILED!\\n\\t%f did not equal %f\\n\" RESETCOLOR, test_description, expected, result);\n26\t  } else {\n27\t    printf(GREEN \"Test: '%s' PASSED!\\n\" RESETCOLOR, test_description);\n28\t  }\n29\t}\n30\t\n31\t/**\n32\t * Asserts that two double values are equals, within the allowed tolerance.\n33\t * Prints to console if the test passed or not, together with the iteration number.\n34\t */\n35\tvoid for_assert(const double result, const double expected, const char* test_description, const int i) {\n36\t  if (fabs(result - expected) > TOLERANCE) {\n37\t    ++number_failed;\n38\t    printf(RED \"Test: '%s' (%i) FAILED!\\n\\t%f did not equal %f\\n\" RESETCOLOR, test_description, i, expected, result);\n39\t  } else {\n40\t    printf(GREEN \"Test: '%s' (%i) PASSED!\\n\" RESETCOLOR, test_description, i);\n41\t  }\n42\t}\n43\t\n44\t/**\n45\t * Checks that compute_forces works for two particles with only one contact.\n46\t */\n47\tvoid test_compute_forces_one_contact() {\n48\t  #define size 2\n49\t  #define contacts_size 1\n50\t\n51\t  ParticleProperties properties[size] = {\n52\t    { 0.049, 247435.829652697, 19033.5253578998 },\n53\t    { 0.049, 247435.829652697, 19033.5253578998 }\n54\t  };\n55\t  Particle particles[size] = {\n56\t    { 24.9999428493601, 25, 50 , NULL, 0},\n57\t    { 24.7762980060664, 74.6253249615872, 50, NULL, 1 }\n58\t  };\n59\t  Vector velocities[size] = {\n60\t    { -0.00159733057834793, 0 },\n61\t    { -4.64544001147225, -6.36971454859269 }\n62\t  };\n63\t  double normal_forces[size * size] = {\n64\t    0, 53.2634277334533,\n65\t    53.2634277334533, 0\n66\t  };\n67\t  double tangent_forces[size * size] = {\n68\t    0, 2.0526062679878,\n69\t    2.0526062679878, 0\n70\t  };\n71\t  double dt = 0.000025;\n72\t  Contact contacts[contacts_size] = { { 0, 1, 42.9554 } };\n73\t  Vector resultant_forces[size] = { { 0 } };\n74\t\n75\t  compute_forces(dt, size, contacts_size, particles, properties, contacts,\n76\t                 velocities, normal_forces, tangent_forces, resultant_forces);\n77\t\n78\t  // P1.\n79\t  assert(resultant_forces[0].x_component, -3.858892943d, \"test_compute_forces_one_contact - resultant_forces[P1].x_component\");\n80\t  assert(resultant_forces[0].y_component, -93.03497946d, \"test_compute_forces_one_contact - resultant_forces[P1].y_component\");\n81\t  assert(normal_forces[2], 92.53595901628790d, \"test_compute_forces_one_contact - normal_forces[P1 <- P2]\");\n82\t  assert(tangent_forces[2], 4.275960624d, \"test_compute_forces_one_contact - tangent_forces[P1 <- P2]\");\n83\t\n84\t  // P2.\n85\t  assert(resultant_forces[1].x_component, 3.858892943d, \"test_compute_forces_one_contact - resultant_forces[P2].x_component\");\n86\t  assert(resultant_forces[1].y_component, 92.07359946d, \"test_compute_forces_one_contact - resultant_forces[P2].y_component\");\n87\t  assert(normal_forces[1], 92.53595901628790d, \"test_compute_forces_one_contact - normal_forces[P2 <- P1]\");\n88\t  assert(tangent_forces[1], 4.275960624d, \"test_compute_forces_one_contact - tangent_forc