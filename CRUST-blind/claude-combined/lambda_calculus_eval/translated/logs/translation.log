s: fmt::Arguments) {\n    if !is_verbose() {\n        return;\n    }\n    println!();\n    let _ = format;\n    print!(\"{}\", args);\n}\n\npub fn error(msg: &str, file: &str, line: i32, func: &str) {\n    eprintln!(\"ERROR: {} at {}:{} in {}()\", msg, file, line, func);\n    std::process::exit(1);\n}\n\npub fn format(fmt: &str, args: fmt::Arguments) -> String {\n    let _ = fmt;\n    args.to_string()\n}\n\npub fn append_to_buffer(buffer: &mut String, str: &str) {\n    buffer.push_str(str);\n}\n\npub fn append_ast_to_buffer(buffer: &mut String, node: &AstNode) {\n    match node.type_ {\n        AstNodeType::LAMBDA_EXPR => {\n            if let AstNodeUnion::LambdaExpr(ref le) = node.node {\n                append_to_buffer(buffer, \"(@\");\n                append_to_buffer(buffer, &le.parameter);\n                append_to_buffer(buffer, \" : \");\n                append_to_buffer(buffer, &le.type_);\n                append_to_buffer(buffer, \" .\");\n                if let Some(ref body) = le.body {\n                    append_ast_to_buffer(buffer, body);\n                }\n                append_to_buffer(buffer, \") \");\n            }\n        }\n        AstNodeType::APPLICATION => {\n            if let AstNodeUnion::Application(ref app) = node.node {\n                append_to_buffer(buffer, \"(\");\n                if let Some(ref f) = app.function {\n                    append_ast_to_buffer(buffer, f);\n                }\n                if let Some(ref a) = app.argument {\n                    append_ast_to_buffer(buffer, a);\n                }\n                append_to_buffer(buffer, \") \");\n            }\n        }\n        AstNodeType::VAR => {\n            if let AstNodeUnion::Variable(ref v) = node.node {\n                append_to_buffer(buffer, \"(\");\n                append_to_buffer(buffer, &v.name);\n                if !v.type_.is_empty() {\n                    append_to_buffer(buffer, \" : \");\n                    append_to_buffer(buffer, &v.type_);\n                }\n                append_to_buffer(buffer, \") \");\n            }\n        }\n        AstNodeType::DEFINITION => {\n            if let AstNodeUnion::Variable(ref v) = node.node {\n                append_to_buffer(buffer, \"(\");\n                append_to_buffer(buffer, &v.name);\n                append_to_buffer(buffer, \") \");\n            }\n        }\n    }\n}\n\npub fn ast_to_string(node: &AstNode) -> String {\n    let mut buffer = String::new();\n    append_ast_to_buffer(&mut buffer, node);\n    buffer\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":183,"cache_read_input_tokens":55804,"cache_creation":{"ephemeral_5m_input_tokens":183,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"21effaa7-b190-4049-bfa4-d0d9afabe229","uuid":"56954d1a-9b3f-4b36-b374-8b797de12088"}
