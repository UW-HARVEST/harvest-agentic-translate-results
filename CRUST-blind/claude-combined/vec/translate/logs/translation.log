  { test_section(\"vec_foreach\");\n    vec_int_t v;\n    vec_init(&v);\n    vec_push(&v, 19);\n    vec_push(&v, 31);\n    vec_push(&v, 47);\n    int i, x;\n    int count = 0, acc = 1;\n    vec_foreach(&v, x, i) {\n      acc *= (x + count);\n      count++;\n    }\n    test_assert(acc == (19 + 0) * (31 + 1) * (47 + 2));\n    vec_deinit(&v);\n  }\n\n  { test_section(\"vec_foreach_rev\");\n    vec_int_t v;\n    vec_init(&v);\n    vec_push(&v, 19);\n    vec_push(&v, 31);\n    vec_push(&v, 47);\n    int i, x;\n    int count = 0, acc = 1;\n    vec_foreach_rev(&v, x, i) {\n      acc *= (x + count);\n      count++;\n    }\n    test_assert(acc == (19 + 2) * (31 + 1) * (47 + 0));\n    vec_deinit(&v);\n  }\n\n  { test_section(\"vec_foreach_ptr\");\n    vec_int_t v;\n    vec_init(&v);\n    vec_push(&v, 19);\n    vec_push(&v, 31);\n    vec_push(&v, 47);\n    int i, *x;\n    int count = 0, acc = 1;\n    vec_foreach_ptr(&v, x, i) {\n      acc *= (*x + count);\n      count++;\n    }\n    test_assert(acc == (19 + 0) * (31 + 1) * (47 + 2));\n    vec_deinit(&v);\n  }\n\n  { test_section(\"vec_foreach_ptr_rev\");\n    vec_int_t v;\n    vec_init(&v);\n    vec_push(&v, 19);\n    vec_push(&v, 31);\n    vec_push(&v, 47);\n    int i, *x;\n    int count = 0, acc = 1;\n    vec_foreach_ptr_rev(&v, x, i) {\n      acc *= (*x + count);\n      count++;\n    }\n    test_assert(acc == (19 + 2) * (31 + 1) * (47 + 0));\n    vec_deinit(&v);\n  }\n\n  test_print_res();\n\n  return 0;\n}\n","numLines":353,"startLine":1,"totalLines":353}}}
