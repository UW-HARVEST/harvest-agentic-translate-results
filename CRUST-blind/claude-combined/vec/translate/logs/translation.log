n\n/// Reserve capacity equal to the next power of two that is >= n.\n/// Returns 0 on success, -1 on failure.\npub fn vec_reserve_po2<T>(data: &mut Vec<T>, n: usize) -> i32 {\n    if n == 0 {\n        return 0;\n    }\n    let mut n2: usize = 1;\n    while n2 < n {\n        n2 <<= 1;\n    }\n    vec_reserve(data, n2)\n}\n\n/// If the vector is full, double its capacity (or grow from 0 to 1).\n/// Returns 0 on success, -1 on failure.\npub fn vec_expand<T>(data: &mut Vec<T>) -> i32 {\n    let len = data.len();\n    let cap = data.capacity();\n    if len + 1 > cap {\n        let n = if cap == 0 { 1 } else { cap << 1 };\n        let additional = n - cap;\n        data.reserve_exact(additional);\n    }\n    0\n}\n\n/// Reserve capacity to be at least `n`. If `n > capacity`, capacity grows\n/// to `n`. Returns 0 on success, -1 on failure.\npub fn vec_reserve<T>(data: &mut Vec<T>, n: usize) -> i32 {\n    let cap = data.capacity();\n    if n > cap {\n        let additional = n - cap;\n        data.reserve_exact(additional);\n    }\n    0\n}\n\n/// Shrink the capacity of the vector to fit its current length.\n/// Returns 0 on success, -1 on failure.\npub fn vec_compact<T>(data: &mut Vec<T>) -> i32 {\n    data.shrink_to_fit();\n    0\n}\n\n/// Swap the elements at positions `idx1` and `idx2`. No-op if equal.\npub fn vec_swap<T>(data: &mut Vec<T>, idx1: usize, idx2: usize) {\n    if idx1 == idx2 {\n        return;\n    }\n    data.swap(idx1, idx2);\n}\n","structuredPatch":[{"oldStart":47,"oldLines":7,"newStart":47,"newLines":7,"lines":["     // Take ownership of the old buffer; use Option<T> so we can extract","     // elements out of arbitrary positions without requiring T: Default.","     let cap = data.capacity();","-    let old: Vec<T> = std::mem::take(data);","+    let old: Vec<T> = std::mem::replace(data, Vec::new());","     let mut old_opts: Vec<Option<T>> = old.into_iter().map(Some).collect();","     let mut result: Vec<T> = Vec::with_capacity(cap);"," "]}],"userModified":false,"replaceAll":false}}
