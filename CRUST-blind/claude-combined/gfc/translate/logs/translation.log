           let end = start + SPECK_ROUNDS;\n            speck_expand(&key, &mut speck_exp[start..end]);\n        }\n        GFC {\n            m: range,\n            r: rounds,\n            a,\n            b,\n            speck_exp,\n        }\n    }\n    /// Encrypt using the Feistel cipher\n    pub fn encrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe(m);\n        while c >= self.m {\n            c = self.fe(c);\n        }\n        c\n    }\n    /// Decrypt using the Feistel cipher\n    pub fn decrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe_inv(m);\n        while c >= self.m {\n            c = self.fe_inv(c);\n        }\n        c\n    }\n    /// Function F for Feistel cipher using Speck encryption\n    fn f(&self, j: u64, r: u64) -> u64 {\n        let key_start = ((j - 1) as usize) * SPECK_ROUNDS;\n        let key = &self.speck_exp[key_start..key_start + SPECK_ROUNDS];\n        // Reinterpret the 64-bit R as two 32-bit halves (low, high) -- matches little-endian C\n        let pt = [r as u32, (r >> 32) as u32];\n        let mut ct = [0u32; 2];\n        speck_encrypt(&pt, &mut ct, key);\n        (ct[0] as u64) | ((ct[1] as u64) << 32)\n    }\n    /// Function fe[r, a, b] for encryption\n    fn fe(&self, m: u64) -> u64 {\n        let mut l = m % self.a;\n        let mut r_val = m / self.a;\n        let mut j: u64 = 1;\n        while j <= self.r {\n            let f_val = self.f(j, r_val);\n            let tmp = if j & 1 == 1 {\n                l.wrapping_add(f_val) % self.a\n            } else {\n                l.wrapping_add(f_val) % self.b\n            };\n            l = r_val;\n            r_val = tmp;\n            j += 1;\n        }\n        if self.r & 1 == 1 {\n            self.a.wrapping_mul(l).wrapping_add(r_val)\n        } else {\n            self.a.wrapping_mul(r_val).wrapping_add(l)\n        }\n    }\n    /// Function fe^-1[r, a, b] for decryption\n    fn fe_inv(&self, m: u64) -> u64 {\n        let (mut l, mut r_val) = if self.r & 1 == 1 {\n            (m / self.a, m % self.a)\n        } else {\n            (m % self.a, m / self.a)\n        };\n        let mut j = self.r;\n        while j >= 1 {\n            let f_val = self.f(j, l);\n            let tmp = if j & 1 == 1 {\n                (r_val + self.a - (f_val % self.a)) % self.a\n            } else {\n                (r_val + self.b - (f_val % self.b)) % self.b\n            };\n            r_val = l;\n            l = tmp;\n            j -= 1;\n        }\n        self.a.wrapping_mul(r_val).wrapping_add(l)\n    }\n}\n/// Speck key expansion\nfn speck_expand(key: &[u32; SPECK_KEY_LEN], round_keys: &mut [u32]) {\n    let mut b = key[0];\n    let mut a = [0u32; SPECK_KEY_LEN - 1];\n    for i in 0..(SPECK_KEY_LEN - 1) {\n        a[i] = key[i + 1];\n    }\n    round_keys[0] = b;\n    for i in 0..(SPECK_ROUNDS - 1) {\n        let idx = i % (SPECK_KEY_LEN - 1);\n        let mut a_val = a[idx];\n        round(&mut a_val, &mut b, i as u32);\n        a[idx] = a_val;\n        round_keys[i + 1] = b;\n    }\n}\n/// Speck encryption function\nfn speck_encrypt(pt: &[u32; 2], ct: &mut [u32; 2], key: &[u32]) {\n    ct[0] = pt[0];\n    ct[1] = pt[1];\n    for i in 0..SPECK_ROUNDS {\n        // R(ct[1], ct[0], K[i]): x is ct[1], y is ct[0]\n        let mut x = ct[1];\n        let mut y = ct[0];\n        round(&mut x, &mut y, key[i]);\n        ct[1] = x;\n        ct[0] = y;\n    }\n}\n","structuredPatch":[{"oldStart":3,"oldLines":13,"newStart":3,"newLines":19,"lines":[" const SPECK_ROUNDS: usize = 27;"," const SPECK_KEY_LEN: usize = 4;"," fn ror(x: u32, r: u32) -> u32 {","-    unimplemented!()","+    (x >> r) | (x << (32 - r))"," }"," fn rol(x: u32, r: u32) -> u32 {","-    unimplemented!()","+    (x << r) | (x >> (32 - r))"," }"," fn round(x: &mut u32, y: &mut u32, k: u32) {","-    unimplemented!()","+    // R(x, y, k) macro:","+    //   x = ROR(x, 8); x += y; x ^= k; y = ROL(y, 3); y ^= x;","+    *x = ror(*x, 8);","+    *x = x.wrapping_add(*y);","+    *x ^=