{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_myxuh2yhwbk2yhiapcolluk3otydqvxci7kvhyjg3hthrb55wqha","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01XuAFzv6Rt6CFDf4Do8EwnH","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-Tq94ar/project/src/gfc.rs","content":"use std::f64::consts::SQRT_2;\n/// Constants for Speck encryption\nconst SPECK_ROUNDS: usize = 27;\nconst SPECK_KEY_LEN: usize = 4;\nfn ror(x: u32, r: u32) -> u32 {\n    (x >> r) | (x << (32 - r))\n}\nfn rol(x: u32, r: u32) -> u32 {\n    (x << r) | (x >> (32 - r))\n}\nfn round(x: &mut u32, y: &mut u32, k: u32) {\n    // R(x, y, k) macro:\n    //   x = ROR(x, 8); x += y; x ^= k; y = ROL(y, 3); y ^= x;\n    *x = ror(*x, 8);\n    *x = x.wrapping_add(*y);\n    *x ^= k;\n    *y = rol(*y, 3);\n    *y ^= *x;\n}\n#[derive(Debug)]\npub struct GFC {\n    m: u64,       // Range\n    r: u64,       // Number of Feistel rounds\n    a: u64,\n    b: u64,\n    speck_exp: Vec<u32>,\n}\nimpl GFC {\n    /// Initialize the GFC structure\n    pub fn new(range: u64, rounds: u64, seed: u64) -> Self {\n        let tmp = (range as f64).sqrt().ceil();\n        let a = tmp as u64;\n        let b = tmp as u64;\n        let total = (rounds as usize) * SPECK_ROUNDS;\n        let mut speck_exp = vec![0u32; total];\n        for i in 0..rounds {\n            // const uint64_t key[2] = {seed, i};\n            // On little-endian, this is 4 u32 words:\n            //   [seed_lo, seed_hi, i_lo, i_hi]\n            let key = [\n                seed as u32,\n                (seed >> 32) as u32,\n                i as u32,\n                (i >> 32) as u32,\n            ];\n            let start = (i as usize) * SPECK_ROUNDS;\n            let end = start + SPECK_ROUNDS;\n            speck_expand(&key, &mut speck_exp[start..end]);\n        }\n        GFC {\n            m: range,\n            r: rounds,\n            a,\n            b,\n            speck_exp,\n        }\n    }\n    /// Encrypt using the Feistel cipher\n    pub fn encrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe(m);\n        while c >= self.m {\n            c = self.fe(c);\n        }\n        c\n    }\n    /// Decrypt using the Feistel cipher\n    pub fn decrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe_inv(m);\n        while c >= self.m {\n            c = self.fe_inv(c);\n        }\n        c\n    }\n    /// Function F for Feistel cipher using Speck encryption\n    fn f(&self, j: u64, r: u64) -> u64 {\n        let key_start = ((j - 1) as usize) * SPECK_ROUNDS;\n        let key = &self.speck_exp[key_start..key_start + SPECK_ROUNDS];\n        // Reinterpret the 64-bit R as two 32-bit halves (low, high) -- matches little-endian C\n        let pt = [r as u32, (r >> 32) as u32];\n        let mut ct = [0u32; 2];\n        speck_encrypt(&pt, &mut ct, key);\n        (ct[0] as u64) | ((ct[1] as u64) << 32)\n    }\n    /// Function fe[r, a, b] for encryption\n    fn fe(&self, m: u64) -> u64 {\n        let mut l = m % self.a;\n        let mut r_val = m / self.a;\n        let mut j: u64 = 1;\n        while j <= self.r {\n            let f_val = self.f(j, r_val);\n            let tmp = if j & 1 == 1 {\n                l.wrapping_add(f_val) % self.a\n            } else {\n                l.wrapping_add(f_val) % self.b\n            };\n            l = r_val;\n            r_val = tmp;\n            j += 1;\n        }\n        if self.r & 1 == 1 {\n            self.a.wrapping_mul(l).wrapping_add(r_val)\n        } else {\n            self.a.wrapping_mul(r_val).wrapping_add(l)\n        }\n    }\n    /// Function fe^-1[r, a, b] for decryption\n    fn fe_inv(&self, m: u64) -> u64 {\n        let (mut l, mut r_val) = if self.r & 1 == 1 {\n            (m / self.a, m % self.a)\n        } else {\n            (m % self.a, m / self.a)\n        };\n        let mut j = self.r;\n        while j >= 1 {\n            let f_val = self.f(j, l);\n            let tmp = if j & 1 == 1 {\n                (r_val + self.a - (f_val % self.a)) % self.a\n            } else {\n                (r_val + self.b - (f_val % self.b)) % self.b\n            };\n            r_val = l;\n            l = tmp;\n            j -= 1;\n        }\n        self.a.wrapping_mul(r_val).wrapping_add(l)\n    }\n}\n/// Speck key expansion\nfn speck_expand(key: &[u32; SPECK_KEY_LEN], round_keys: &mut [u32]) {\n    let mut b = key[0];\n    let mut a = [0u32; SPECK_KEY_LEN - 1];\n    for i in 0..(SPECK_KEY_LEN - 1) {\n        a[i] = key[i + 1];\n    }\n    round_keys[0] = b;\n    for i in 0..(SPECK_ROUNDS - 1) {\n        let idx = i % (SPECK_KEY_LEN - 1);\n        let mut a_val = a[idx];\n        round(&mut a_val, &mut b, i as u32);\n        a[idx] = a_val;\n        round_keys[i + 1] = b;\n    }\n}\n/// Speck encryption function\nfn speck_encrypt(pt: &[u32; 2], ct: &mut [u32; 2], key: &[u32]) {\n    ct[0] = pt[0];\n    ct[1] = pt[1];\n    for i in 0..SPECK_ROUNDS {\n        // R(ct[1], ct[0], K[i]): x is ct[1], y is ct[0]\n        let mut x = ct[1];\n        let mut y = ct[0];\n        round(&mut x, &mut y, key[i]);\n        ct[1] = x;\n        ct[0] = y;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":884,"cache_read_input_tokens":20795,"cache_creation":{"ephemeral_5m_input_tokens":884,"ephemeral_1h_input_tokens":0},"output_tokens":38,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"dd268676-0e28-4a22-b5fc-eafc36a01197","uuid":"5d40f464-29d6-4feb-8e56-a9359918c9c4"}
