      }\n        // Remove A..Z\n        for (char i = 'A'; i <= 'Z'; i++) {\n            char k[2] = {i, 0};\n            BOSNode *n = bostree_lookup(tree, k);\n            bostree_remove(tree, n);\n        }\n        printf(\"--- after remove all ---\\n\");\n        print_inorder(tree);\n    } else if (strcmp(argv[1], \"asc_3\") == 0) {\n        bostree_insert(tree, strdup(\"A\"), NULL);\n        bostree_insert(tree, strdup(\"B\"), NULL);\n        bostree_insert(tree, strdup(\"C\"), NULL);\n        printf(\"--- after asc_3 ---\\n\");\n        print_inorder(tree);\n    } else if (strcmp(argv[1], \"desc_3\") == 0) {\n        bostree_insert(tree, strdup(\"C\"), NULL);\n        bostree_insert(tree, strdup(\"B\"), NULL);\n        bostree_insert(tree, strdup(\"A\"), NULL);\n        printf(\"--- after desc_3 ---\\n\");\n        print_inorder(tree);\n    } else if (strcmp(argv[1], \"left_right\") == 0) {\n        bostree_insert(tree, strdup(\"C\"), NULL);\n        bostree_insert(tree, strdup(\"A\"), NULL);\n        bostree_insert(tree, strdup(\"B\"), NULL);\n        printf(\"--- after left_right ---\\n\");\n        print_inorder(tree);\n    } else if (strcmp(argv[1], \"right_left\") == 0) {\n        bostree_insert(tree, strdup(\"A\"), NULL);\n        bostree_insert(tree, strdup(\"C\"), NULL);\n        bostree_insert(tree, strdup(\"B\"), NULL);\n        printf(\"--- after right_left ---\\n\");\n        print_inorder(tree);\n    } else if (strcmp(argv[1], \"duplicates\") == 0) {\n        bostree_insert(tree, strdup(\"A\"), strdup(\"d1\"));\n        bostree_insert(tree, strdup(\"A\"), strdup(\"d2\"));\n        bostree_insert(tree, strdup(\"A\"), strdup(\"d3\"));\n        printf(\"--- after dup A ---\\n\");\n        print_inorder(tree);\n    } else if (strcmp(argv[1], \"lookup_missing\") == 0) {\n        bostree_insert(tree, strdup(\"A\"), NULL);\n        bostree_insert(tree, strdup(\"B\"), NULL);\n        BOSNode *n = bostree_lookup(tree, \"Z\");\n        printf(\"lookup Z=%s\\n\", n ? \"found\" : \"missing\");\n        BOSNode *n2 = bostree_select(tree, 100);\n        printf(\"select 100=%s\\n\", n2 ? \"found\" : \"missing\");\n    } else {\n        fprintf(stderr, \"Unknown test: %s\\n\", argv[1]);\n        bostree_destroy(tree);\n        return 1;\n    }\n\n    bostree_destroy(tree);\n    return 0;\n}\n","structuredPatch":[{"oldStart":13,"oldLines":8,"newStart":13,"newLines":11,"lines":["                i, (char*)node->key, bostree_rank(node), node->depth,","                node->left_child_count, node->right_child_count);","     }","-    if (tree->root_node) {","-        printf(\"root=%s\\n\", (char*)tree->root_node->key);","+    if (n > 0) {","+        // Find root via parent_node walk from first element","+        BOSNode *cur = bostree_select(tree, 0);","+        while (cur->parent_node) cur = cur->parent_node;","+        printf(\"root=%s\\n\", (char*)cur->key);","     } else {","         printf(\"root=NULL\\n\");","     }"]}],"userModified":false,"replaceAll":false}}
