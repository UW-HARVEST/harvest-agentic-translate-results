29\t  debug(50,\"outputLine:start\\n\");\n130\t  if (cline == NULL) return;\n131\t  if (gpOutColumns == NULL) { // print all\n132\t    debug(50,\"outputLine:printall\\n\");\n133\t    int fieldcnt = csvline_getFieldCnt(cline);\n134\t    int i;\n135\t    for (i=0; i<fieldcnt; i++) {\n136\t      char* str = csvline_getField(cline,i);\n137\t      formatOutput(&str);\n138\t      fprintf(gpOutput, \"%s\", str);\n139\t      if ( (i+1) != fieldcnt) {\n140\t\tfprintf(gpOutput, \"%c\", gpDelimOut);\n141\t      }\n142\t    }    \n143\t  }\n144\t  else {\n145\t    debug(50,\"outputLine:printranges\\n\");\n146\t    struct rangeElement* list = gpOutColumns;\n147\t    int colCnt = csvline_getFieldCnt(cline);\n148\t    do {\n149\t      switch (list->rangetype) {\n150\t      case EMPTY:\n151\t\tbreak;\n152\t      case SINGLE:\n153\t\tdebug(50,\"outputLine:single(%d)\\n\", list->start);\n154\t\tchar* str = csvline_getField(cline,list->start - 1);\n155\t\tformatOutput(&str);\n156\t\tif (strlen(str) == 0) {\n157\t\t  //don't print (null)\n158\t\t}\n159\t\telse {\n160\t\t  fprintf(gpOutput, \"%s\",str);\n161\t\t}\n162\t\tif (list->next != NULL) {\n163\t\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n164\t\t}\n165\t\tbreak;\n166\t      case STARTEND:\n167\t\tdebug(50,\"outputLine:startend (%d - %d)\\n\", list->start, list->end);\n168\t\t{\n169\t\t  int i=0;\n170\t\t  char* str = NULL;\n171\t\t  for (i=list->start - 1; (i+1) < list->end; i++) {\n172\t\t    str = csvline_getField(cline,i);\n173\t\t    formatOutput(&str);\n174\t\t    if (strlen(str) == 0) {\n175\t\t      fprintf(gpOutput, \"%c\", gpDelimOut);\n176\t\t    }\n177\t\t    else {\n178\t\t      fprintf(gpOutput, \"%s%c\", str, gpDelimOut);\n179\t\t    }\n180\t\t  }\n181\t\t  int last = list->end - 1;\n182\t\t  if (last >= colCnt) {\n183\t\t    break;\n184\t\t  }\n185\t\t  str = csvline_getField(cline, last);\n186\t\t  formatOutput(&str);\n187\t\t  if (strlen(str) == 0) {\n188\t\t  }\n189\t\t  else {\n190\t\t    fprintf(gpOutput, \"%s\",str);\n191\t\t  }\n192\t\t}\n193\t\tif (list->next != NULL) {\n194\t\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n195\t\t}\n196\t\tbreak;\n197\t      case GREATEREQUAL:\n198\t\tdebug(50,\"outputLine:greaterequal\\n\");\n199\t\t{\n200\t\t  int i;\n201\t\t  char* str = \"\";\n202\t\t  for (i=list->start - 1; (i+1)<colCnt; i++) {\n203\t\t    str =  csvline_getField(cline,i);\n204\t\t    formatOutput(&str);\n205\t\t    if (strlen(str) == 0) {\n206\t\t    }\n207\t\t    else {\n208\t\t      fprintf(gpOutput, \"%s%c\", str, gpDelimOut);\n209\t\t    }\n210\t\t  }\n211\t\t  int last = colCnt - 1;\n212\t\t  str =  csvline_getField(cline,last);\n213\t\t  formatOutput(&str);\n214\t\t  if (strlen(str) == 0) {\n215\t\t  }\n216\t\t  else {\n217\t\t    fprintf(gpOutput, \"%s\",str);\n218\t\t  }\n219\t\t}\n220\t\tif (list->next != NULL) {\n221\t\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n222\t\t}\n223\t\tbreak;\n224\t      default:\n225\t\tdebug(50,\"outputLine:default (error)\\n\");\n226\t\tbreak;\n227\t      }\n228\t      list = list->next;\n229\t    }\n230\t    while (list != NULL);\n231\t  }\n232\t  fprintf(gpOutput, \"%s\", (gpEndLine == NULL ? cline->eolStr : gpEndLine));\n233\t  debug(50,\"outputLine:end\\n\");\n234\t  return;\n235\t}\n236\t\n237\t// find field\n238\t// return state\n239\tint getField(char* buf, int buflen, int* end, bool* inQuoted) {\n240\t  bool bquoted = *inQuoted;\n241\t  for (*end=0; *end<buflen; *end += 1) {\n242\t    char c = buf[*end];\n243\t    //debug(50, \"char(%c)(%d)(%d)(%d)\\n\", c, (int)c, *end, buflen);\n244\t    if (!gpAllowBinaryFlag && isBinChar(c)) {\n245\t      fprintf(stderr, \"error: line(%d): binary character (%d) found.  Use flag to ignore/pass\\n\", gLineCnt, (int)c);\n246\t      exit(-1);\n247\t    }\n248\t    if (*inQuoted) {\n249\t      if (c==gpQuoteIn) {\n250\t\t*inQuoted=false;\n251\t      }\n252\t    }\n253\t    else {\n254\t      if (c==gpQuoteIn) {\n255\t\t*inQuoted=true;\n256\t      }\n257\t      if (c==gpDelimIn) {\n258\t\treturn rvDelim;\n259\t      }\n260\t      if (c=='\\r') {\n261\t\treturn rvStateEOL;\n262\t      }\n263\t      if (c=='\\n') {\n264\t\treturn rvStateEOL;\n265\t      }\n266\t      //if (buf[*end]=='\\n' && *end == buflen-1) {\n267\t      //\treturn rvStateEOL;\n268\t      //}\n269\t      //if (buf[*end]=='\\r' && *end == buflen-1) {\n270\t      //\treturn rvStateEOL;\n271\t      //}\n272\t      if (c=='\\0' && *end == buflen-1) {\n273\t\treturn rvStateEOL;\n274\t      }      \n275\t    }\n276\t  }\n277\t  return rvStateEOL;\n278\t}\n279\tint main(int argc, char** argv) {\n280\t  //init\n281\t  gpInput=stdin;\n282\t  gpOutput=stdout;\n283\t  gpDelimIn = ',';\n284\t  gpDelimOut = ',';\n285\t  gpQuoteIn = '\"';\n286\t  gpQuoteOut = '\"';\n287\t  gpEndLine = NULL;\n288\t  gpVerbose = 0;\n289\t\n290\t  \n291\t  int arginc = 1;\n292\t  while(arginc < argc) {\n293\t    debug(5, \"argc=(%d) arginc=(%d)  argv[arginc]=(%s)\\n\", argc, arginc, argv[arginc]);\n294\t    if (strcmp(argv[arginc], \"-i\")==0) {\n295\t      if (argc <= arginc+1) {\n296\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n297\t\treturn -1;\n298\t      }\n299\t      arginc++;\n300\t      debug(5, \"arg %s\\n\", argv[arginc]);\n301\t      gpInput = fopen(argv[arginc], \"r\");\n302\t      if (gpInput == NULL) {\n303\t\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n304\t\treturn -1;\n305\t      }\n306\t      arginc++;\n307\t    }\n308\t    else if (strcmp(argv[arginc], \"-o\")==0) {\n309\t      if (argc <= arginc+1) {\n310\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n311\t\treturn -1;\n312\t      }\n313\t      arginc++;\n314\t      debug(5, \"arg %s\\n\", argv[arginc]);\n315\t      gpOutput = fopen(argv[arginc], \"r\");\n316\t      if (gpOutput == NULL) {\n317\t\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n318\t\treturn -1;\n319\t      }\n320\t      arginc++;\n321\t    }\n322\t  