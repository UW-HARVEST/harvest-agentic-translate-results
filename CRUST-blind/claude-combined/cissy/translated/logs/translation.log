{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015WXm3YuSCxYip6DhKcW3C3","type":"tool_result","content":"1\t/*\n2\t   Copyright 2015 Steven Lass\n3\t\n4\t   Licensed under the Apache License, Version 2.0 (the \"License\");\n5\t   you may not use this file except in compliance with the License.\n6\t   You may obtain a copy of the License at\n7\t\n8\t       http://www.apache.org/licenses/LICENSE-2.0\n9\t\n10\t   Unless required by applicable law or agreed to in writing, software\n11\t   distributed under the License is distributed on an \"AS IS\" BASIS,\n12\t   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n13\t   See the License for the specific language governing permissions and\n14\t   limitations under the License.\n15\t*/\n16\t\n17\t#include <stdlib.h>\n18\t#include <stdio.h>\n19\t#include <stdbool.h>\n20\t#include <assert.h>\n21\t#include <string.h>\n22\t#include \"range.h\"\n23\t\n24\t/**\n25\t* Used for column lists\n26\t*/\n27\t\n28\t/**\n29\t* free memory\n30\t*\n31\t* @param list range\n32\t*/\n33\tvoid rangeFree(struct rangeElement* list) {\n34\t  if (list == NULL) {\n35\t    return;\n36\t  }\n37\t  struct rangeElement* ptr = list;\n38\t  while (ptr->next != NULL) {\n39\t    struct rangeElement* ptrNext = ptr->next;\n40\t    free(ptr);\n41\t    ptr = ptrNext;\n42\t  }\n43\t  free(ptr);\n44\t  list=NULL;\n45\t}\n46\t\n47\t/**\n48\t* Create a new range\n49\t*/\n50\tstruct rangeElement* rangeCreate() {\n51\t  struct rangeElement* ptr = malloc(sizeof(struct rangeElement));\n52\t  if (ptr == NULL) {\n53\t    fprintf(stderr, \"rangeCreate: malloc error\\n\");\n54\t    exit(-1);\n55\t  }\n56\t  ptr->start = -1;\n57\t  ptr->end = -1;\n58\t  ptr->next = NULL;\n59\t  return ptr;\n60\t}\n61\t\n62\t// pass NULL list to create new list\n63\t/**\n64\t* add a n-m range to the list\n65\t*\n66\t* Add start-end range.  Create a new list if necessary\n67\t*\n68\t* @param start beginning \n69\t* @param end ending\n70\t* @param startOfList list\n71\t* @return list\n72\t*/\n73\tstruct rangeElement* rangeAddStartEnd(uint32_t start, uint32_t end, struct rangeElement* startOfList) {\n74\t  assert(start > 0);\n75\t  assert(end >= start);\n76\t  if (startOfList == NULL) {\n77\t    startOfList = rangeCreate();\n78\t    startOfList->start = start;\n79\t    if (start == end) {\n80\t      startOfList->rangetype = SINGLE;\n81\t    }\n82\t    else {\n83\t      startOfList->rangetype = STARTEND;\n84\t      startOfList->end = end;\n85\t    }\n86\t    return startOfList;\n87\t  }\n88\t  struct rangeElement* ptr = startOfList;\n89\t  //advance to the end of list\n90\t  while (ptr->next != NULL) {\n91\t    ptr = ptr->next;\n92\t  }\n93\t  ptr->next = rangeCreate();\n94\t  ptr = ptr->next;\n95\t  ptr->start = start;\n96\t  if (end == start) {\n97\t    ptr->rangetype = SINGLE;\n98\t  }\n99\t  else {\n100\t    ptr->rangetype = STARTEND;\n101\t    ptr->end = end;\n102\t  }\n103\t  return startOfList;\n104\t}\n105\t\n106\t/**\n107\t* Add a n- range (to end of line) to list\n108\t*\n109\t* Add a greater than range, create new list if necessary\n110\t*\n111\t* @param num beginning \n112\t* @param startOfList list\n113\t* @return list\n114\t*/\n115\tstruct rangeElement* rangeAddGreaterEqual(uint32_t num, struct rangeElement* startOfList) {\n116\t  assert(num >= 0);\n117\t  if (startOfList == NULL) {\n118\t    startOfList = rangeCreate();\n119\t    startOfList->start = num;\n120\t    startOfList->rangetype = GREATEREQUAL;\n121\t    return startOfList;\n122\t  }\n123\t  struct rangeElement* ptr = startOfList;\n124\t  //advance to the end of list\n125\t  while (ptr->next != NULL) {\n126\t    ptr = ptr->next;\n127\t  }\n128\t  ptr->next = rangeCreate();\n129\t  ptr = ptr->next;\n130\t  ptr->start = num;\n131\t  ptr->rangetype = GREATEREQUAL;\n132\t  return startOfList;\n133\t}\n134\t\n135\t/**\n136\t* Add a single element to list\n137\t*\n138\t* Add a number, create new list if necessary\n139\t*\n140\t* @param num number to add \n141\t* @param startOfList list\n142\t* @return list\n143\t*/\n144\tstruct rangeElement* rangeAddSingle(uint32_t num, struct rangeElement* startOfList) {\n145\t  assert(num > 0);\n146\t  if (startOfList == NULL) {\n147\t    startOfList = rangeCreate();\n148\t    startOfList->start = num;\n149\t    startOfList->rangetype = SINGLE;\n150\t    return startOfList;\n151\t  }\n152\t  struct rangeElement* ptr = startOfList;\n153\t  //advance to the end of list\n154\t  while (ptr->next != NULL) {\n155\t    ptr = ptr->next;\n156\t  }\n157\t  ptr->next = rangeCreate();\n158\t  ptr = ptr->next;\n159\t  ptr->start = num;\n160\t  ptr->rangetype = SINGLE;\n161\t  return startOfList;\n162\t}\n163\t\n164\t/**\n165\t* format as string\n166\t*\n167\t* pass in the buffer\n168\t*\n169\t* @param buf buffer for output\n170\t* @param bufsize size of buffer\n171\t* @param element range element to format\n172\t* @return buf\n173\t*/\n174\tchar* rangeElementToString(char* buf, uint32_t bufsize, struct rangeElement* element) {\n175\t  assert(bufsize >= 0);\n176\t  assert(element != NULL);\n177\t  switch (element->rangetype) {\n178\t  case SINGLE:\n179\t    snprintf(buf, bufsize, \"[%d]\", element->start);\n180\t    return buf;\n181\t  case GREATEREQUAL:\n182\t    snprintf(buf, bufsize, \"[%d-]\", element->start);\n183\t    return buf;\n184\t  case STARTEND:\n185\t    snprintf(buf, bufsize, \"[%d-%d]\", element->start, element->end);\n186\t    return buf;\n187\t  case EMPTY:\n188\t    snprintf(buf, bufsize, \"[]\");\n189\t    return buf;\n190\t  default:\n191\t    return buf;\n192\t  }\n193\t}\n194\t\n195\t/**\n196\t* format range list as string\n197\t*\n198\t* pass in the buffer\n199\t*\n200\t* @param buf buffer for output\n201\t* @param bufsize size of buffer\n202\t* @param element range element to format\n203\t* @return buf\n204\t*/\n205\tchar* rangeListToString(char* buf, uint32_t bufsize, struct rangeElement* startOfList) {\n206\t  int tmpbufsize = 256;\n207\t  char tm