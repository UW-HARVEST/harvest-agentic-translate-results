{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01N1cWVnMH2WnEndSonaB5vd","type":"tool_result","content":"1\t#include <assert.h>\n2\t#include <stdio.h>\n3\t#include <string.h>\n4\t#include <time.h>\n5\t#include \"../src/ulid.h\"\n6\t// Helper function to validate ULID structure\n7\tint is_valid_ulid(const char *ulid) {\n8\t    const char *b32alphabet = \"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n9\t\n10\t    // Check length\n11\t    if (strlen(ulid) != 26)\n12\t        return 0;\n13\t\n14\t    // Check characters\n15\t    for (int i = 0; i < 26; i++) {\n16\t        if (!strchr(b32alphabet, ulid[i]))\n17\t            return 0;\n18\t    }\n19\t\n20\t    return 1;\n21\t}\n22\t\n23\t// Test Cases\n24\tvoid test_ulid_length() {\n25\t    char ulid[27];\n26\t    ulidgen_r(ulid);\n27\t    assert(strlen(ulid) == 26 && \"ULID length should be 26 characters\");\n28\t}\n29\t\n30\tvoid test_ulid_structure() {\n31\t    char ulid[27];\n32\t    ulidgen_r(ulid);\n33\t    printf(\"Generated ULID: %s\\n\", ulid);\n34\t    assert(is_valid_ulid(ulid) && \"ULID should only contain valid Base32 characters\");\n35\t}\n36\t\n37\tvoid test_ulid_uniqueness() {\n38\t    char ulid1[27], ulid2[27];\n39\t    ulidgen_r(ulid1);\n40\t    ulidgen_r(ulid2);\n41\t\n42\t    // Ensure two ULIDs generated consecutively are not the same\n43\t    assert(strcmp(ulid1, ulid2) != 0 && \"Consecutive ULIDs should be unique\");\n44\t}\n45\t\n46\tvoid test_ulid_sortability() {\n47\t    char ulid1[27], ulid2[27];\n48\t    ulidgen_r(ulid1);\n49\t\n50\t    // Simulate a delay to ensure different timestamps\n51\t    struct timespec ts = { .tv_sec = 0, .tv_nsec = 1500000 }; // 1.5 ms\n52\t    nanosleep(&ts, NULL);\n53\t\n54\t    ulidgen_r(ulid2);\n55\t    assert(strcmp(ulid1, ulid2) < 0 && \"ULIDs should be lexicographically sortable based on time\");\n56\t}\n57\t\n58\tint main() {\n59\t    test_ulid_length();\n60\t    printf(\"Test passed: ULID length is valid\\n\");\n61\t\n62\t    // test_ulid_structure();\n63\t    // printf(\"Test passed: ULID structure is valid\\n\");\n64\t\n65\t    test_ulid_uniqueness();\n66\t    printf(\"Test passed: ULID uniqueness is valid\\n\");\n67\t\n68\t    test_ulid_sortability();\n69\t    printf(\"Test passed: ULID sortability is valid\\n\");\n70\t\n71\t    printf(\"All tests passed successfully.\\n\");\n72\t    return 0;\n73\t}"}]},"parent_tool_use_id":null,"session_id":"bb239184-db45-482f-9e1d-2c48d6b8bbb2","uuid":"173c76b7-39ba-448d-9584-ad13608cfb77","timestamp":"2026-06-01T13:33:40.235Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-oGlt1a/project/c_src/tests/test.c","content":"#include <assert.h>\n#include <stdio.h>\n#include <string.h>\n#include <time.h>\n#include \"../src/ulid.h\"\n// Helper function to validate ULID structure\nint is_valid_ulid(const char *ulid) {\n    const char *b32alphabet = \"0123456789ABCDEFGHJKMNPQRSTVWXYZ\";\n\n    // Check length\n    if (strlen(ulid) != 26)\n        return 0;\n\n    // Check characters\n    for (int i = 0; i < 26; i++) {\n        if (!strchr(b32alphabet, ulid[i]))\n            return 0;\n    }\n\n    return 1;\n}\n\n// Test Cases\nvoid test_ulid_length() {\n    char ulid[27];\n    ulidgen_r(ulid);\n    assert(strlen(ulid) == 26 && \"ULID length should be 26 characters\");\n}\n\nvoid test_ulid_structure() {\n    char ulid[27];\n    ulidgen_r(ulid);\n    printf(\"Generated ULID: %s\\n\", ulid);\n    assert(is_valid_ulid(ulid) && \"ULID should only contain valid Base32 characters\");\n}\n\nvoid test_ulid_uniqueness() {\n    char ulid1[27], ulid2[27];\n    ulidgen_r(ulid1);\n    ulidgen_r(ulid2);\n\n    // Ensure two ULIDs generated consecutively are not the same\n    assert(strcmp(ulid1, ulid2) != 0 && \"Consecutive ULIDs should be unique\");\n}\n\nvoid test_ulid_sortability() {\n    char ulid1[27], ulid2[27];\n    ulidgen_r(ulid1);\n\n    // Simulate a delay to ensure different timestamps\n    struct timespec ts = { .tv_sec = 0, .tv_nsec = 1500000 }; // 1.5 ms\n    nanosleep(&ts, NULL);\n\n    ulidgen_r(ulid2);\n    assert(strcmp(ulid1, ulid2) < 0 && \"ULIDs should be lexicographically sortable based on time\");\n}\n\nint main() {\n    test_ulid_length();\n    printf(\"Test passed: ULID length is valid\\n\");\n\n    // test_ulid_structure();\n    // printf(\"Test passed: ULID structure is valid\\n\");\n\n    test_ulid_uniqueness();\n    printf(\"Test passed: ULID uniqueness is valid\\n\");\n\n    test_ulid_sortability();\n    printf(\"Test passed: ULID sortability is valid\\n\");\n\n    printf(\"All tests passed successfully.\\n\");\n    return 0;\n}","numLines":73,"startLine":1,"totalLines":73}}}
