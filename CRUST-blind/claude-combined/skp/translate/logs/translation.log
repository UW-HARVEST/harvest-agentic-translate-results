1;\n1248\t  int32_t min_pos = INT32_MAX;\n1249\t  int32_t min_slot = 0;\n1250\t  int32_t numnodes;\n1251\t\n1252\t  assert(mmz != NULL);\n1253\t\n1254\t  end_par = ast->par_cnt;\n1255\t  if (ast->fail || end_par <= start_par) {\n1256\t    start_par = -1;\n1257\t    end_par = -1;\n1258\t  }\n1259\t  numnodes = (end_par - start_par)/2;\n1260\t\n1261\t _skptrace(\"MMZ: [%d] %s @%d par:[%d,%d]\",ast->fail,rule,old_pos, start_par,end_par);\n1262\t  // Find the proper slot\n1263\t  //    Any empty slot?\n1264\t  for (slot = 0; (slot<4) && mmz[slot] ; slot++) {\n1265\t    if (mmz[slot]->pos > min_pos) {\n1266\t       min_pos = mmz[slot]->pos;\n1267\t       min_slot = slot;\n1268\t    };\n1269\t  }\n1270\t\n1271\t  // If none, use the one with lowest pos.\n1272\t  if (slot >= 4) {\n1273\t    slot = min_slot;\n1274\t  }\n1275\t\n1276\t _skptrace(\"MMZ: slot=%d (maxnodes: %d needed: %d\",slot,mmz[slot]?mmz[slot]->maxnodes:0,numnodes);\n1277\t  // Check if there's enough memory\n1278\t  if (mmz[slot] && mmz[slot]->maxnodes < numnodes) {\n1279\t    free(mmz[slot]);\n1280\t    mmz[slot] = NULL;\n1281\t  }\n1282\t\n1283\t _skptrace(\"MMZ: storing %d\",slot);\n1284\t  if (mmz[slot] == NULL) {\n1285\t    mmz[slot] = malloc(sizeof(struct ast_mmz_s) + numnodes * sizeof(ast_node_t));\n1286\t    assert(mmz[slot]);\n1287\t    mmz[slot]->maxnodes = numnodes;\n1288\t  }\n1289\t\n1290\t  // Record position\n1291\t _skptrace(\"MMZ: storing %d pos: %d\",slot,old_pos);\n1292\t  mmz[slot]->pos = old_pos;\n1293\t  mmz[slot]->endpos = ast->pos;\n1294\t  // Record fail\n1295\t  mmz[slot]->numnodes = ast->fail? -1 : numnodes;\n1296\t  mmz[slot]->lastinfo = ast->lastinfo;\n1297\t\n1298\t  // Save nodes\n1299\t  //ast_node_t *nd;\n1300\t  int32_t cur_node = 0;\n1301\t  for (int32_t k=start_par; k < end_par; k++) {\n1302\t    if (ast->par[k] >=0) {\n1303\t      //nd = & ast->nodes[ast->par[k]];\n1304\t      //skptrace(\"MMZ:   [%d] from: %d to: %d delta: %d rule: '%s':\",k,nd->from,nd->to,nd->delta,nd->rule);\n1305\t      mmz[slot]->nodes[cur_node++] = ast->nodes[ast->par[k]];\n1306\t    }\n1307\t  }\n1308\t}\n1309\t\n1310\tvoid skp_mmz_add(ast_t ast, ast_mmz_t *mmz)\n1311\t{\n1312\t  int32_t new_max;\n1313\t  ast_mmz_t  **new_mmz;\n1314\t  if (ast->mmz_cnt >= ast->mmz_max) {\n1315\t    new_max = ast->mmz_max;\n1316\t    new_max += new_max/2;\n1317\t    new_max += new_max&1;\n1318\t    new_mmz = realloc(ast->mmz,new_max * sizeof(ast_mmz_t *));\n1319\t    assert(new_mmz);\n1320\t    ast->mmz = new_mmz;\n1321\t    ast->mmz_max = new_max;\n1322\t  }\n1323\t  ast->mmz[ast->mmz_cnt++] = mmz;\n1324\t}\n1325\t\n1326\tvoid skp_mmz_clean(ast_t ast)\n1327\t{\n1328\t  ast_mmz_t *mmz;\n1329\t _skptrace(\"MMZ clean: %p (%d)\",(void *)ast->mmz,ast->mmz_cnt);\n1330\t  while (ast->mmz_cnt) {\n1331\t    mmz = ast->mmz[--ast->mmz_cnt];\n1332\t    for (int k=0; k<4; k++) {\n1333\t     _skptrace(\"MMZ clean: %p %p\",(void *)mmz,(void *)mmz[k]);\n1334\t      if (mmz[k]) free(mmz[k]); \n1335\t      mmz[k] = SKP_MMZ_NULL;\n1336\t    }\n1337\t  }\n1338\t  ast->mmz_cnt = 0;\n1339\t}\n1340\t\n1341\t#define SKP_DELTA_MAX INT32_MAX\n1342\tint skp_dememoize(ast_t ast, ast_mmz_t *mmz, char *rule)\n1343\t{\n1344\t _skptrace(\"MM?: '%s' %d\",rule,ast->pos);\n1345\t  if (mmz[0] == SKP_MMZ_NULL) {\n1346\t    skp_mmz_add(ast, mmz);\n1347\t    for (int k=0; k<4; k++) mmz[k] = NULL;\n1348\t   _skptrace(\"MM?: first mmz\");\n1349\t    return 0;\n1350\t  }\n1351\t  // Search for pos\n1352\t  int slot = 0;\n1353\t  while(1) {\n1354\t   _skptrace(\"MM?:   search %d\",slot);\n1355\t    if (mmz[slot] && (mmz[slot]->pos == ast->pos)) break;\n1356\t    if (++slot >= 4) return 0;\n1357\t  }\n1358\t  int32_t numnodes = mmz[slot]->numnodes;\n1359\t _skptrace(\"MM?: found at %d (nodes: %d)\",slot,numnodes);\n1360\t  int32_t cur_par, delta;\n1361\t  ast->fail = (numnodes < 0); // restore fail flag\n1362\t  ast->lastpos = ast->pos;\n1363\t  ast->pos = mmz[slot]->endpos;\n1364\t  ast->lastinfo = mmz[slot]->lastinfo;\n1365\t  if (numnodes > 0) {\n1366\t    // Copy memoized result into the AST\n1367\t    skp_nodes_makeroom(ast, numnodes); // ensure enough space for nodes\n1368\t    skp_par_makeroom(ast,2 * numnodes); // same for parenthesis\n1369\t    for (int k=ast->par_cnt; k<ast->par_cnt + 2*numnodes; k++) \n1370\t      ast->par[k] = SKP_DELTA_MAX;\n1371\t\n1372\t    cur_par = ast->par_cnt;\n1373\t    for (int32_t k=0; k<numnodes; k++) {\n1374\t      // Copy node\n1375\t      ast->nodes[ast->nodes_cnt] = mmz[slot]->nodes[k];\n1376\t      // Rebuild tree\n1377\t      while (ast->par[cur_par] != SKP_DELTA_MAX) cur_par++;\n1378\t      ast->par[cur_par] = ast->nodes_cnt;\n1379\t      delta = mmz[slot]->nodes[k].delta;\n1380\t      ast->par[cur_par+delta] = -delta;\n1381\t      ast->nodes_cnt++;\n1382\t    }\n1383\t    ast->par_cnt += 2*numnodes;\n1384\t  } \n1385\t  return 1;\n1386\t}\n1387\t\n1388\tint skp_debug2(ast_t ast,uint8_t d)\n1389\t{\n1390\t  switch(d) {\n1391\t    case  0: ast->flg &= ~SKP_DEBUG; break;\n1392\t    case  1: ast->flg |=  SKP_DEBUG; break;\n1393\t    default: ast->flg ^=  SKP_DEBUG; break;\n1394\t  }\n1395\t  return ast->flg & SKP_DEBUG;\n1396\t}\n1397\t\n1398\tchar *skp_N__STRING = \"$\";\n1399\tchar *skp_N__INFO   = \"#\";\n1400\t\n1401\tast_t skp_parse(char *src, skprule_t rule,char *rulename, int debug)\n1402\t{\n1403\t  ast_t ast = NULL;\n1404\t  astnode_t open;\n1405\t  if (!(ast = ast_new())) return NULL;\n1406\t  ast->start = src;\n1407\t  ast->flg = debug?SKP_DEBUG:0;\n1408\t\n1409\t _skptrace(\"Parsing %s\",rulename);\n1410\t  if ((open = ast_open(ast, ast->pos, rulename)) >= 0) {\n1411\t    if (!setjmp(ast->jbuf)) rule(ast,&ast->ret);\n1412\t    else  ast->fail = 1;\n1413\t\n1414\t    if (ast->fail && ast->err_pos < ast->pos) {\n1415\t      ast->err_pos = ast->pos; ast->err_rule = rulename;\n1416\t    }\n1417\t      \n1418\t    ast_close(ast, ast->pos, open);\n1419\t    if (ast->nodes_cnt > 0) {\n1420\t      ast->err_pos = -1;\n1421\t      astsettag(ast,ast->lastinfo,0);\n1422\t    }\n1423\t  }\n1424\t  skp_mmz_clean(ast);\n1425\t  return ast;\n1426\t}\n1427\t\n1428\tint ast_lastnodeisempty(ast_t ast)\n1429\t{\n1430\t  astnode_t node;\n1431\t  ast_node_t *nd;\n1432\t  node = ast_lastnode(ast);\n1433\t  if (node == ASTNULL) return 0;\n1434\t  assert(ast->par[node]>=0);\n1435\t  nd = ast->nodes+ast->par[node];\n1436\t  return (nd->from == nd->to); \n1437\t} \n1438\t\n1439\t//ast_node_t *ast_lastnode(ast_t ast)\n1440\tint32_t ast_lastnode(ast_t ast)\n1441\t{\n1442\t  // get last node!\n1443\t  //    ,------- o1\n1444\t  //   /    ,--- c1\n1445\t  //  ( ... )\n1446\t#if 0 \n1447\t  int32_t o1, c1;\n1448\t\n1449\t  if (ast->fail || ast->par_cnt < 2) return NULL;\n1450\t  \n1451\t  c1 = ast->par_cnt-1;\n1452\t  if (c1<0 || ast->par[c1] >= 0) return NULL;\n1453\t\n1454\t  o1 = c1+ast->par[c1];\n1455\t  if (o1<0 || ast->par[o1] < 0) return NULL;\n1456\t\n1457\t  return (ast->nodes+ast->par[o1]);\n1458\t#endif\n1459\t  astnode_t o1, c1;\n1460\t\n1461\t  if (ast->fail || ast->par_cnt < 2) return ASTNULL;\n1462\t  \n1463\t  c1 = ast->par_cnt-1;\n1464\t  if (c1<0 || ast->par[c1] >= 0) return ASTNULL;\n1465\t\n1466\t  o1 = c1+ast->par[c1];\n1467\t  if (o1<0 || ast->par[o1] < 0) return ASTNULL;\n1468\t\n1469\t  return (o1);\n1470\t}\n1471\t\n1472\tvoid ast_swap(ast_t ast)\n1473\t{\n1474\t  // Swap the last two nodes in the AST (if they belong to the same subtree)\n1475\t  //          ,--- o1\n1476\t  //         / ,-- c1\n1477\t  //  (BBBB)(AA)\n1478\t  //   \\   '------ c2\n1479\t  //    '--------- o2   \n1480\t  //\n1481\t  //  (AA)(BBBB)\n1482\t  //   \\  '------- o2+(c1-o1+1)\n1483\t  //    '--------- o2   \n1484\t\n1485\t  astnode_t o1, c1, o2, c2;\n1486\t\n1487\t _skptrace(\"SWAP fail? %d\",ast->fail);\n1488\t  if (ast->fail || ast->par_cnt < 4) return;\n1489\t\n1490\t  c1 = ast->par_cnt-1;\n1491\t _skptrace(\"SWAP c1: %d (%d)\",c1,ast->par[c1]);\n1492\t  if (c1<0 || ast->par[c1] >= 0) return;\n1493\t\n1494\t  o1 = c1+ast->par[c1];\n1495\t _skptrace(\"SWAP o1: %d (%d)\",o1,ast->par[o1]);\n1496\t  if (o1<0 || ast->par[o1] < 0) return;\n1497\t\n1498\t  c2 = o1-1;\n1499\t _skptrace(\"SWAP c2: %d (%d)\",c2,ast->par[c2]);\n1500\t  if (c2<0 || ast->par[c2] >= 0) return;\n1501\t\n1502\t  o2 = c2+ast->par[c2];\n1503\t _skptrace(\"SWAP o2: %d (%d)\",o2,ast->par[o2]);\n1504\t  if (o2<0 || ast->par[o2] < 0) return;\n1505\t  \n1506\t  void *tmp = malloc((c2-o2+1) * sizeof(int32_t));\n1507\t  if (tmp) {\n1508\t   _skptrace(\"SWAP: tmp<- (%d,%d) [%d]\",o2,c2,c2-o2+1);\n1509\t    memcpy(tmp,ast->par+o2,(c2-o2+1)*sizeof(int32_t));\n1510\t\n1511\t   _skptrace(\"SWAP: (%d)<-(%d,%d) [%d]\",o2,o1,c1,c1-o1+1);\n1512\t    memmove(ast->par+o2, ast->par+o1,(c1-o1+1)*sizeof(int32_t));\n1513\t    \n1514\t   _skptrace(\"SWAP: (%d)<-tmp [%d]\",o2+(c1-o1+1),c2-o2+1);\n1515\t    memcpy(ast->par+o2+(c1-o1+1),tmp,(c2-o2+1)*sizeof(int32_t));\n1516\t\n1517\t    free(tmp);\n1518\t   _skptrace(\"SWP: done\");\n1519\t  }\n1520\t}\n1521\t\n1522\tvoid ast_lift(ast_t ast)\n1523\t{\n1524\t  // If there's only one child lift it up\n1525\t  //    ,-------- o1\n1526\t  //   /     ,--- c1\n1527\t  //  ((BBBB))\n1528\t  //    \\   '---- c2\n1529\t  //     '------- o2   \n1530\t\n1531\t  astnode_t o1, c1, o2, c2;\n1532\t\n1533\t  if (ast->fail || ast->par_cnt < 4) return;\n1534\t  \n1535\t  c1 = ast->par_cnt-1;\n1536\t  if (c1<0 || ast->par[c1] >= 0) return;\n1537\t\n1538\t  c2 = c1-1;\n1539\t  if (c2<0 || ast->par[c2] >= 0) return;\n1540\t\n1541\t  o1 = c1+ast->par[c1];\n1542\t  if (o1<0 || ast->par[o1] < 0) return;\n1543\t\n1544\t  o2 = c2+ast->par[c2];\n1545\t  if (o2<0 || ast->par[o2] < 0) return;\n1546\t\n1547\t  if (o2 != o1+1) return; // More than one child\n1548\t\n1549\t _skptrace(\"REMOVE1: (%d) %s \",ast->nodes[ast->par[o1]].tag,ast->nodes[ast->par[o1]].rule);\n1550\t  if (ast->nodes[ast->par[o1]].tag == 0) {\n1551\t    memmove(ast->par+o1,ast->par+o2,(c2-o2+1)*sizeof(int32_t));\n1552\t    ast->par_cnt -= 2;\n1553\t  }\n1554\t}\n1555\t#if 0\n1556\tvoid ast_lift_all(ast_t ast)\n1557\t{\n1558\t  // Lift all single children  up\n1559\t  //    ,-------- o1\n1560\t  //   /       ,--- c1\n1561\t  //  ((((..))))\n1562\t  //    \\     '---- c2\n1563\t  //     '------- o2   \n1564\t\n1565\t  int32_t o1, c1, o2, c2;\n1566\t\n1567\t  if (ast->fail) return;\n1568\t  \n1569\t  while (ast->par_cnt >= 4) {\n1570\t    c1 = ast->par_cnt-1;\n1571\t    if (c1<0 || ast->par[c1] >= 0) return;\n1572\t  \n1573\t    c2 = c1-1;\n1574\t    if (c2<0 || ast->par[c2] >= 0) return;\n1575\t  \n1576\t    o1 = c1+ast->par[c1];\n1577\t    if (o1<0 || ast->par[o1] < 0) return;\n1578\t  \n1579\t    o2 = c2+ast->par[c2];\n1580\t    if (o2<0 || ast->par[o2] < 0) return;\n1581\t  \n1582\t    if (o2 != o1+1) return; // More than one child\n1583\t\n1584\t    skptrace(\"REMOVEA: (%d)\",ast->nodes[o1].tag);\n1585\t    if (ast->nodes[ast->par[o1]].tag != 0) return;\n1586\t  \n1587\t    memmove(ast->par+o1,ast->par+o2,(c2-o2+1)*sizeof(int32_t));\n1588\t    ast->par_cnt -= 2;\n1589\t  }\n1590\t}\n1591\t#endif\n1592\tvoid ast_lift_all(ast_t ast)\n1593\t{\n1594\t  // Lift all single children  up\n1595\t  //    ,-------- o1\n1596\t  //   /       ,--- c1\n1597\t  //  ((((..))))\n1598\t  //    \\     '---- c2\n1599\t  //     '------- o2   \n1600\t\n1601\t  astnode_t n;  \n1602\t  do {\n1603\t    n = ast->par_cnt;\n1604\t   _skptrace(\"L1: %d\",n);\n1605\t    ast_lift(ast);\n1606\t   _skptrace(\"L2: %d\",ast->par_cnt);\n1607\t  } while (n != ast->par_cnt);\n1608\t}\n1609\t\n1610\tvoid ast_lower(ast_t astcur, char *rule, astnode_t lft, astnode_t rgt)\n1611\t{\n1612\t  // insert node and lower children\n1613\t  //    ,----------- lft\n1614\t  //   /        ,--- rgt\n1615\t  //  ( ) .(). ( ) ...\n1616\t  //\n1617\t  //  (( ) .(). ( )) ...\n1618\t\n1619\t  if (!astcur || astcur->par_cnt<=lft || astcur->par_cnt <= rgt || lft >= rgt) return;\n1620\t\n1621\t  astnode_t node;\n1622\t\n1623\t  astnode_t node_from;\n1624\t  astnode_t node_to;\n1625\t\n1626\t  // ensure we are on the opening par of the node\n1627\t  if (astcur->par[lft] < 0) lft += astcur->par[lft];\n1628\t  if (astcur->par[rgt] < 0) rgt += astcur->par[rgt];\n1629\t\n1630\t  // The new node will cover the full span of its children\n1631\t  node_from = astcur->nodes[astcur->par[lft]].from;\n1632\t  node_to   = astcur->nodes[astcur->par[rgt]].to;\n1633\t\n1634\t  // Move to the close par of the rightmost node\n1635\t  rgt += astcur->nodes[astcur->par[rgt]].delta;\n1636\t\n1637\t  if ((node = ast_newnode(astcur)) < 0) return;\n1638\t  \n1639\t  int32_t delta = rgt-lft+2;\n1640\t  astcur->nodes[node] = (ast_node_t){rule, node_from, node_to, delta, 0};\n1641\t  \n1642\t  int32_t par;\n1643\t  // make room for the new node parenthesis\n1644\t  if ((par = ast_newpar(astcur)) < 0) return ;\n1645\t  if ((par = ast_newpar(astcur)) < 0) return ;\n1646\t\n1647\t  // Move the nodes after the rgt one\n1648\t  if (astcur->par_cnt-1-rgt > 2 ) {\n1649\t    memmove(&(astcur->par[rgt+3]),\n1650\t            &(astcur->par[rgt+1]),\n1651\t             (astcur->par_cnt-1-rgt-2)*sizeof(int32_t));\n1652\t  }\n1653\t\n1654\t  // Move the nodes\n1655\t  memmove(&(astcur->par[lft+1]),\n1656\t          &(astcur->par[lft]),\n1657\t           (rgt-lft+1)*sizeof(int32_t));\n1658\t\n1659\t  astcur->par[lft] = node;\n1660\t  astcur->par[rgt+2] = -delta;\n1661\t}\n1662\t\n1663\tvoid ast_delete(ast_t ast)\n1664\t{\n1665\t  // remove last node!\n1666\t  //    ,------- o1\n1667\t  //   /    ,--- c1\n1668\t  //  ( ... )\n1669\t\n1670\t  int32_t o1, c1;\n1671\t\n1672\t  if (ast->fail || ast->par_cnt < 2) return;\n1673\t  \n1674\t  c1 = ast->par_cnt-1;\n1675\t  if (c1<0 || ast->par[c1] >= 0) return;\n1676\t\n1677\t  o1 = c1+ast->par[c1];\n1678\t  if (o1<0 || ast->par[o1] < 0) return;\n1679\t\n1680\t  ast->par_cnt -= (c1-o1+1);\n1681\t}\n1682\t\n1683\tvoid ast_noleaf(ast_t ast)\n1684\t{\n1685\t  // If the last node is a leaf, remove it!\n1686\t  //    ,------- o1