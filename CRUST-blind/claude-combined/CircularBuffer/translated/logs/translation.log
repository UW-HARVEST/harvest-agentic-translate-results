{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01V2pCJtoDVfZuacDpdGmknE","type":"tool_result","content":"1\t//\n2\t//  CircularBuffer.c\n3\t//\n4\t//  Created by 罗亮富(Roen zxllf23@163.com) on 14-1-14.\n5\t//  Copyright (c) 2014年 All rights reserved.\n6\t//\n7\t\n8\t\n9\t#include \"circular_buffer.h\"\n10\t#include <string.h>\n11\t\n12\tstruct s_circularBuffer{\n13\t    \n14\t    size_t size; //capacity bytes size\n15\t    size_t dataSize; //occupied data size\n16\t    size_t tailOffset; //head offset, the oldest byte position offset\n17\t    size_t headOffset; //tail offset, the lastest byte position offset\n18\t    void *buffer;\n19\t\n20\t};\n21\t\n22\textern CircularBuffer CircularBufferCreate(size_t size)\n23\t{\n24\t    size_t totalSize = sizeof(struct s_circularBuffer) + size;\n25\t    void *p = malloc(totalSize);\n26\t    CircularBuffer buffer = (CircularBuffer)p;\n27\t    buffer->buffer = p + sizeof(struct s_circularBuffer);\n28\t    buffer->size = size;\n29\t    CircularBufferReset(buffer);\n30\t    return buffer;\n31\t}\n32\t\n33\tvoid CircularBufferFree(CircularBuffer cBuf)\n34\t{\n35\t    CircularBufferReset(cBuf);\n36\t    cBuf->size = 0;\n37\t    cBuf->dataSize = 0;\n38\t    cBuf->buffer = NULL;\n39\t    free(cBuf);\n40\t}\n41\t\n42\tvoid CircularBufferReset(CircularBuffer cBuf)\n43\t{\n44\t    cBuf->headOffset = -1;\n45\t    cBuf->tailOffset = -1;\n46\t    cBuf->dataSize = 0;\n47\t}\n48\t\n49\tsize_t CircularBufferGetCapacity(CircularBuffer cBuf) {\n50\t    \n51\t    return cBuf->size;\n52\t}\n53\t\n54\tsize_t CircularBufferGetSize(CircularBuffer cBuf)\n55\t{\n56\t    return cBuf->size;\n57\t}\n58\t\n59\tsize_t CircularBufferGetDataSize(CircularBuffer cBuf)\n60\t{\n61\t    return cBuf->dataSize;\n62\t}\n63\t\n64\tvoid CircularBufferPush(CircularBuffer cBuf,void *src, size_t length)\n65\t{\n66\t    if(length == 0)\n67\t        return;\n68\t\n69\t    size_t writableLen = length;\n70\t    void *pSrc = src;\n71\t    \n72\t    if(writableLen > cBuf->size)//in case of size overflow\n73\t    {\n74\t        size_t overFlowLen = writableLen - cBuf->size;\n75\t        writableLen = cBuf->size;\n76\t        pSrc = src + overFlowLen;\n77\t    }\n78\t    \n79\t    \n80\t    bool resetHead = false;\n81\t    //in case the circle buffer won't be full after adding the data\n82\t    if(cBuf->tailOffset+writableLen < cBuf->size)\n83\t    {\n84\t        memcpy(&cBuf->buffer[cBuf->tailOffset + 1], pSrc, writableLen);\n85\t        \n86\t        if((cBuf->tailOffset < cBuf->headOffset) && (cBuf->tailOffset+writableLen >= cBuf->headOffset) )\n87\t            resetHead = true;\n88\t        \n89\t        cBuf->tailOffset += writableLen;\n90\t    }\n91\t    else//in case the circle buffer will be overflow after adding the data\n92\t    {\n93\t        size_t remainSize = cBuf->size - cBuf->tailOffset - 1; //the remain size\n94\t        memcpy(&cBuf->buffer[cBuf->tailOffset+1], pSrc, remainSize);\n95\t        \n96\t        size_t coverSize = writableLen - remainSize; //size of data to be covered from the beginning\n97\t        memcpy(cBuf->buffer, pSrc+remainSize, coverSize);\n98\t        \n99\t        if(cBuf->tailOffset < cBuf->headOffset)\n100\t            resetHead = true;\n101\t        else\n102\t        {\n103\t            if(coverSize>cBuf->headOffset)\n104\t                resetHead = true;\n105\t        }\n106\t        \n107\t        cBuf->tailOffset = coverSize - 1;\n108\t    }\n109\t    \n110\t    if(cBuf->headOffset == -1)\n111\t        cBuf->headOffset = 0;\n112\t    \n113\t    if(resetHead)\n114\t    {\n115\t        if(cBuf->tailOffset+1 < cBuf->size)\n116\t            cBuf->headOffset = cBuf->tailOffset + 1;\n117\t        else\n118\t            cBuf->headOffset = 0;\n119\t        \n120\t        cBuf->dataSize = cBuf->size;\n121\t    }\n122\t    else\n123\t    {\n124\t        if(cBuf->tailOffset >= cBuf->headOffset)\n125\t            cBuf->dataSize = cBuf->tailOffset - cBuf->headOffset + 1;\n126\t        else\n127\t            cBuf->dataSize = cBuf->size - (cBuf->headOffset - cBuf->tailOffset - 1);\n128\t    }\n129\t}\n130\t\n131\tsize_t inter_circularBuffer_read(CircularBuffer cBuf, size_t length, void *dataOut, bool resetHead)\n132\t{\n133\t    if(cBuf->dataSize == 0 || length == 0)\n134\t        return 0;\n135\t    \n136\t    size_t rdLen = length;\n137\t    \n138\t    if(cBuf->dataSize < rdLen)\n139\t        rdLen = cBuf->dataSize;\n140\t    \n141\t    \n142\t    if(cBuf->headOffset <= cBuf->tailOffset)\n143\t    {\n144\t        if(dataOut)\n145\t            memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n146\t        \n147\t        if(resetHead)\n148\t        {\n149\t            cBuf->headOffset += rdLen;\n150\t            if(cBuf->headOffset > cBuf->tailOffset)\n151\t            {\n152\t                cBuf->headOffset = -1;\n153\t                cBuf->tailOffset = -1;\n154\t            }\n155\t        }\n156\t    }\n157\t    else\n158\t    {\n159\t        if(cBuf->headOffset+rdLen <= cBuf->size)\n160\t        {\n161\t            if(dataOut)\n162\t                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n163\t            \n164\t            if(resetHead)\n165\t            {\n166\t                cBuf->headOffset += rdLen;\n167\t                if(cBuf->headOffset == cBuf->size)\n168\t                    cBuf->headOffset = 0;\n169\t            }\n170\t        }\n171\t        else\n172\t        {\n173\t            size_t frg1Len = cBuf->size - cBuf->headOffset;\n174\t            if(dataOut)\n175\t                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], frg1Len);\n176\t            \n177\t            size_t frg2len = rdLen - frg1Len;\n178\t            if(dataOut)\n179\t                memcpy(dataOut+frg1Len, cBuf->buffer, frg2len);\n180\t            \n181\t            if(resetHead)\n182\t            {\n183\t                cBuf->headOffset = frg2len;\n184\t                if(cBuf->headOffset > cBuf->tailOffset)\n185\t      