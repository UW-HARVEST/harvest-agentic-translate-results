{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_mqhkg6smnpaok3mfvnhmotuyla3ez72iemnqfyqoqcvaashckzka","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01AVPcFS2LdY4pkgWW8j7LhU","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-NSYEhg/project/src/totp.rs","content":"// Importing required modules\nuse crate::std;\n// Constants\npub const TOTP_EXPORT: &str = \"__attribute__((visibility(\\\"default\\\")))\";\n\npub const TOTP_OK: i32 = 0;\npub const TOTP_EBOUNDS: i32 = 1;\n\n// Function Declarations\npub fn hotp(key: &[u8; 64], counter: u64) -> i32 {\n    let mut data: [u8; 8] = [0; 8];\n    let mut hash: [u8; 20] = [0; 20];\n\n    unpack64(counter, &mut data);\n    hmac_sha1(key, &data, 8, &mut hash);\n\n    let offset = (hash[19] & 0xF) as usize;\n    let bytes: [u8; 4] = [hash[offset], hash[offset + 1], hash[offset + 2], hash[offset + 3]];\n    let trunc = pack32(&bytes) & 0x7FFFFFFF;\n\n    (trunc % 1000000) as i32\n}\n\npub fn sha1(buf: &mut [u8], len: usize, cap: usize, hash: &mut [u8; 20]) -> i32 {\n    // 4.2.1\n    let k: [u32; 4] = [0x5A827999, 0x6ED9EBA1, 0x8F1BBCDC, 0xCA62C1D6];\n\n    // 5.1.1 (padding)\n    if len > std::SIZE_MAX - 9 - 63 {\n        return TOTP_EBOUNDS;\n    }\n    let new_len = ((len + 9 + 63) / 64) * 64;\n    if new_len > cap {\n        return TOTP_EBOUNDS;\n    }\n\n    // memset(buf+len, 0, new_len-len);\n    for i in len..new_len {\n        buf[i] = 0;\n    }\n    buf[len] = 1 << 7;\n    let mut tail: [u8; 8] = [0; 8];\n    unpack64((len as u64).wrapping_mul(8), &mut tail);\n    for i in 0..8 {\n        buf[new_len - 8 + i] = tail[i];\n    }\n\n    // 5.3.1\n    let mut h: [u32; 5] = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0];\n\n    let mut w: [u32; 80] = [0; 80];\n\n    // 6.1.2\n    let blocks = new_len / 64;\n    for i in 0..blocks {\n        for t in 0..16 {\n            let off = i * 64 + t * 4;\n            let chunk: [u8; 4] = [buf[off], buf[off + 1], buf[off + 2], buf[off + 3]];\n            w[t] = pack32(&chunk);\n        }\n        for t in 16..80 {\n            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);\n        }\n\n        let mut a = h[0];\n        let mut b = h[1];\n        let mut c = h[2];\n        let mut d = h[3];\n        let mut e = h[4];\n\n        for t in 0..80 {\n            // 4.1.1 (f function)\n            let f: u32 = if t < 20 {\n                (b & c) ^ (!b & d)\n            } else if t < 40 {\n                b ^ c ^ d\n            } else if t < 60 {\n                (b & c) ^ (b & d) ^ (c & d)\n            } else {\n                b ^ c ^ d\n            };\n\n            let big_t = rotl(a, 5)\n                .wrapping_add(f)\n                .wrapping_add(e)\n                .wrapping_add(k[t / 20])\n                .wrapping_add(w[t]);\n            e = d;\n            d = c;\n            c = rotl(b, 30);\n            b = a;\n            a = big_t;\n        }\n\n        h[0] = h[0].wrapping_add(a);\n        h[1] = h[1].wrapping_add(b);\n        h[2] = h[2].wrapping_add(c);\n        h[3] = h[3].wrapping_add(d);\n        h[4] = h[4].wrapping_add(e);\n    }\n\n    for i in 0..5 {\n        let mut chunk: [u8; 4] = [0; 4];\n        unpack32(h[i], &mut chunk);\n        hash[i * 4] = chunk[0];\n        hash[i * 4 + 1] = chunk[1];\n        hash[i * 4 + 2] = chunk[2];\n        hash[i * 4 + 3] = chunk[3];\n    }\n\n    TOTP_OK\n}\n\npub fn from_base32(s: &str, buf: &mut [u8], cap: usize) -> usize {\n    let bytes = s.as_bytes();\n    let slen = std::strlen(s);\n\n    if slen % 8 != 0 {\n        return 0;\n    }\n    if cap < (slen + 1) / 8 * 5 {\n        return 0;\n    }\n\n    let mut v: [u8; 8] = [0; 8];\n    let mut i = 0usize;\n    while i * 8 < slen && bytes[i * 8] != 0 {\n        for j in 0..8 {\n            let c = bytes[i * 8 + j] as char;\n            if c == '=' {\n                v[j] = 0;\n            } else if c >= 'A' && c <= 'Z' {\n                v[j] = (c as u8) - b'A';\n            } else if c >= 'a' && c <= 'z' {\n                v[j] = (c as u8) - b'a';\n            } else if c >= '2' && c <= '7' {\n                v[j] = (c as u8) - b'2' + 26;\n            } else {\n                return 0;\n            }\n        }\n\n        buf[i * 5] = (v[0] << 3) | (v[1] >> 2);\n        buf[i * 5 + 1] = (v[1] << 6) | (v[2] << 1) | (v[3] >> 4);\n        buf[i * 5 + 2] = (v[3] << 4) | (v[4] >> 1);\n        buf[i * 5 + 3] = (v[4] << 7) | (v[5] << 2) | (v[6] >> 3);\n        buf[i * 5 + 4] = (v[6] << 5) | v[7];\n\n        if bytes[i * 8 + 2] == b'=' {\n            return i * 5 + 1;\n        }\n        if bytes[i * 8 + 4] == b'=' {\n            return i * 5 + 2;\n        }\n        if bytes[i * 8 + 5] == b'=' {\n            return i * 5 + 3;\n        }\n        if bytes[i * 8 + 7] == b'=' {\n            return i * 5 + 4;\n        }\n\n        i += 1;\n    }\n\n    i * 5\n}\n\npub fn unpack64(x: u64, a: &mut [u8; 8]) {\n    let mut hi: [u8; 4] = [0; 4];\n    let mut lo: [u8; 4] = [0; 4];\n    unpack32((x >> 32) as u32, &mut hi);\n    unpack32(x as u32, &mut lo);\n    a[0] = hi[0];\n    a[1] = hi[1];\n    a[2] = hi[2];\n    a[3] = hi[3];\n    a[4] = lo[0];\n    a[5] = lo[1];\n    a[6] = lo[2];\n    a[7] = lo[3];\n}\n\npub fn pack32(a: &[u8; 4]) -> u32 {\n    ((a[0] as u32) << 24) | ((a[1] as u32) << 16) | ((a[2] as u32) << 8) | (a[3] as u32)\n}\n\npub fn unpack32(x: u32, a: &mut [u8; 4]) {\n    a[0] = (x >> 24) as u8;\n    a[1] = (x >> 16) as u8;\n    a[2] = (x >> 8) as u8;\n    a[3] = x as u8;\n}\n\npub fn totp(key: &[u8; 64], time: u64) -> i32 {\n    hotp(key, time / 30)\n}\n\npub fn hmac_sha1(key: &[u8; 64], data: &[u8], len: usize, hash: &mut [u8; 20]) -> i32 {\n    if len > 64 {\n        return TOTP_EBOUNDS;\n    }\n\n    let mut buf: [u8; 196] = [0; 196];\n\n    for i in 0..64 {\n        buf[i] = key[i] ^ 0x36;\n    }\n    for i in 0..len {\n        buf[64 + i] = data[i];\n    }\n    sha1(&mut buf, 64 + len