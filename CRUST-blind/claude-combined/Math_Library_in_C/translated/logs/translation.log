), EPS_6);\n  ck_assert_double_eq_tol(sin(2.0 * S21_M_PI), castom_sin(2.0 * S21_M_PI), EPS_6);\n}\nEND_TEST\n\nSTART_TEST(castom_test_tan) {\n  for (double j = -10.0; j <= 10.0; j += 0.1) {\n    ck_assert_double_eq_tol(tan(j), castom_tan(j), EPS_6);\n  }\n  ck_assert_double_eq_tol(tan(360.0), castom_tan(360.0), EPS_6);\n  ck_assert_double_eq_tol(tan(0.000001), castom_tan(0.000001), EPS_6);\n  ck_assert_double_eq_tol(tan(30.0), castom_tan(30.0), EPS_6);\n  ck_assert_double_eq_tol(tan(45.0), castom_tan(45.0), EPS_6);\n  ck_assert_double_eq_tol(tan(0.0), castom_tan(0.0), EPS_6);\n  ck_assert_double_eq_tol(tan(180.0), castom_tan(180.0), EPS_6);\n  ck_assert_double_eq_tol(tan(25.5), castom_tan(25.5), EPS_6);\n  ck_assert_double_eq_tol(tan(-5.0), castom_tan(-5.0), EPS_6);\n  ck_assert_double_eq_tol(tan(500.21), castom_tan(500.21), EPS_6);\n  ck_assert_double_eq_tol(tan(0.0001), castom_tan(0.0001), EPS_6);\n  ck_assert_double_eq_tol(tan(S21_M_PI / 6), castom_tan(S21_M_PI / 6), EPS_6);\n  ck_assert_double_eq_tol(tan(S21_M_PI / 4), castom_tan(S21_M_PI / 4), EPS_6);\n  ck_assert_double_eq_tol(tan(S21_M_PI / 3), castom_tan(S21_M_PI / 3), EPS_6);\n  ck_assert_double_eq_tol(tan(S21_M_PI), castom_tan(S21_M_PI), EPS_6);\n}\nEND_TEST\n\nint main(void) {\n  Suite *s1 = suite_create(\"Core\");\n  TCase *tc1_1 = tcase_create(\"Core\");\n  SRunner *sr = srunner_create(s1);\n  int nf;\n\n  suite_add_tcase(s1, tc1_1);\n  tcase_add_test(tc1_1, castom_test_abs);\n  tcase_add_test(tc1_1, castom_test_fabs);\n  tcase_add_test(tc1_1, scastom_test_pow);\n  tcase_add_test(tc1_1, castom_test_log);\n  tcase_add_test(tc1_1, castom_test_exp);\n  tcase_add_test(tc1_1, castom_test_sqrt);\n  tcase_add_test(tc1_1, castom_test_ceil);\n  tcase_add_test(tc1_1, castom_test_floor);\n  tcase_add_test(tc1_1, castom_test_trunc);\n  tcase_add_test(tc1_1, castom_test_fmod);\n  tcase_add_test(tc1_1, castom_test_asin);\n  tcase_add_test(tc1_1, castom_test_cos);\n  tcase_add_test(tc1_1, castom_test_acos);\n  tcase_add_test(tc1_1, castom_test_atan);\n  tcase_add_test(tc1_1, castom_test_sin);\n  tcase_add_test(tc1_1, castom_test_tan);\n\n  srunner_run_all(sr, CK_ENV);\n  nf = srunner_ntests_failed(sr);\n  srunner_free(sr);\n\n  return nf == 0 ? 0 : 1;\n}\n","numLines":327,"startLine":1,"totalLines":327}}}
