 Rec *next;\n82\t} *Rec;\n83\t\n84\t/* possible tisp object types */\n85\ttypedef enum {\n86\t\tTSP_NONE  = 1 << 0,  /* void */\n87\t\tTSP_NIL   = 1 << 1,  /* nil: false, empty list */\n88\t\tTSP_INT   = 1 << 2,  /* integer: whole number */\n89\t\tTSP_DEC   = 1 << 3,  /* decimal: floating point number */\n90\t\tTSP_RATIO = 1 << 4,  /* ratio: numerator/denominator */\n91\t\tTSP_STR   = 1 << 5,  /* string: immutable characters */\n92\t\tTSP_SYM   = 1 << 6,  /* symbol: variable names */\n93\t\tTSP_PRIM  = 1 << 7,  /* primitive: built-in function */\n94\t\tTSP_FORM  = 1 << 8,  /* special form: built-in macro */\n95\t\tTSP_FUNC  = 1 << 9,  /* function: procedure written is tisp */\n96\t\tTSP_MACRO = 1 << 10, /* macro: function without evaluated arguments */\n97\t\tTSP_PAIR  = 1 << 11, /* pair: building block for lists */\n98\t\tTSP_REC   = 1 << 12, /* record: hash table */\n99\t} TspType;\n100\t#define TSP_RATIONAL (TSP_INT | TSP_RATIO)\n101\t#define TSP_NUM      (TSP_RATIONAL | TSP_DEC)\n102\t/* TODO rename to expr type to math ? */\n103\t#define TSP_EXPR     (TSP_NUM | TSP_SYM | TSP_PAIR)\n104\t\n105\t/* bultin function written in C, not tisp */\n106\ttypedef Val (*Prim)(Tsp, Rec, Val);\n107\t\n108\t/* tisp object */\n109\tstruct Val {\n110\t\tTspType t; /* NONE, NIL */\n111\t\tunion {\n112\t\t\tchar *s;                                           /* STRING, SYMBOL */\n113\t\t\tstruct { double num, den; } n;                     /* NUMBER */\n114\t\t\tstruct { char *name; Prim pr; } pr;                /* PRIMITIVE, FORM */\n115\t\t\tstruct { char *name; Val args, body; Rec env; } f; /* FUNCTION, MACRO */\n116\t\t\tstruct { Val car, cdr; } p;                        /* PAIR */\n117\t\t\tRec r;                                             /* REC */\n118\t\t} v;\n119\t};\n120\t\n121\t/* tisp state and global environment */\n122\tstruct Tsp {\n123\t\tchar *file;\n124\t\tsize_t filec;\n125\t\tVal none, nil, t;\n126\t\tRec env, strs, syms;\n127\t\tvoid **libh;\n128\t\tsize_t libh