gs)\n- `init_env`, `init_allocator`, `allocate`\n\nExpected values were verified against the C implementation built via `gcc src/worsp.c bin/main.c -o test_prog -lm` and run against `.wsp` fixtures and short ad-hoc programs."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":150,"cache_read_input_tokens":109183,"cache_creation":{"ephemeral_5m_input_tokens":150,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"40699c6e-550f-4c04-9c67-ef358548cdf3","uuid":"30da79d3-599b-49a7-853f-c4cd8d13945e"}
