scii_validate(d, 32));\n    }\n\n    // utf8_validate\n    {\n        const uint8_t a[] = \"Hello\";\n        printf(\"utf8_validate(Hello)=%d\\n\", utf8_validate(a, 5));\n        // 2-byte: U+00A9 © => 0xC2 0xA9\n        const uint8_t b[] = {0xC2, 0xA9};\n        printf(\"utf8_validate(C2 A9)=%d\\n\", utf8_validate(b, 2));\n        // 3-byte: U+20AC € => 0xE2 0x82 0xAC\n        const uint8_t c[] = {0xE2, 0x82, 0xAC};\n        printf(\"utf8_validate(E2 82 AC)=%d\\n\", utf8_validate(c, 3));\n        // 4-byte: U+1F600 😀 => 0xF0 0x9F 0x98 0x80\n        const uint8_t d[] = {0xF0, 0x9F, 0x98, 0x80};\n        printf(\"utf8_validate(F0 9F 98 80)=%d\\n\", utf8_validate(d, 4));\n        // Invalid: lone continuation\n        const uint8_t e[] = {0x80};\n        printf(\"utf8_validate(80)=%d\\n\", utf8_validate(e, 1));\n        // Overlong\n        const uint8_t f[] = {0xC0, 0xAF};\n        printf(\"utf8_validate(C0 AF)=%d\\n\", utf8_validate(f, 2));\n        // Surrogate\n        const uint8_t g[] = {0xED, 0xA0, 0x80};\n        printf(\"utf8_validate(ED A0 80)=%d\\n\", utf8_validate(g, 3));\n        // Truncated\n        const uint8_t h[] = {0xC2};\n        printf(\"utf8_validate(C2)=%d\\n\", utf8_validate(h, 1));\n        // Empty\n        printf(\"utf8_validate(empty)=%d\\n\", utf8_validate(NULL, 0));\n        // 16-byte ascii fast path\n        const uint8_t lng[] = \"abcdefghijklmnopqrstuvwxyz\";\n        printf(\"utf8_validate(long ASCII)=%d\\n\", utf8_validate(lng, strlen((const char*)lng)));\n    }\n\n    // Lengths\n    {\n        const uint8_t a[] = \"Hello\";\n        printf(\"utf8_length_from_latin1(Hello)=%zu\\n\", utf8_length_from_latin1(a, 5));\n        const uint8_t b[] = {0x80, 0xff};\n        printf(\"utf8_length_from_latin1(80,ff)=%zu\\n\", utf8_length_from_latin1(b, 2));\n\n        const uint16_t u16a[] = {'H', 'i'};\n        printf(\"utf8_length_from_utf16le(Hi)=%zu\\n\", utf8_length_from_utf16le(u16a, 2));\n        const uint16_t u16b[] = {0x00A9}; // ©