ound-trips, and linsearch found/not-found returns including the 32-bit specialization.\n\nExpected values were obtained by running a custom C oracle against `c_src/for.c`, then asserted exactly in the Rust tests."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":560,"cache_read_input_tokens":141548,"cache_creation":{"ephemeral_5m_input_tokens":560,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b1db73b1-eb5f-4e58-a88b-7fefeced636b","uuid":"77ee8281-faaf-41bb-b88e-2e32cb9f553d"}
