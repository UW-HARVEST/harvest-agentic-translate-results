"+) -> usize {","+    let bytes = s.as_bytes();","+    let mut cursor = 0usize;","+    while cursor < bytes.len() && bytes[cursor] == b'(' {","+        cursor += 1;","+        if alt.is_none() {","+            *alt = Some(PgnAlternativeMoves::new());","+        }","+        pgn_cursor_skip_whitespace(s, &mut cursor);","+","+        let mut inner = PgnMoves::new();","+        moves_recurse(&s[cursor..], &mut {","+            // We need an inner cursor because moves_recurse expects offset 0 onwards.","+            let mut inner_cursor = 0usize;","+            moves_recurse(&s[cursor..], &mut inner_cursor, &mut inner, expect);","+            cursor += inner_cursor;","+            0usize","+        }, &mut PgnMoves::new(), expect);","+        // The above closure already did the work; now push.","+        alt.as_mut().unwrap().push(inner);","+","+        pgn_cursor_skip_whitespace(s, &mut cursor);","+        assert!(cursor < bytes.len() && bytes[cursor] == b')');","+        cursor += 1;","+","+        pgn_cursor_skip_whitespace(s, &mut cursor);","+","+        if placeholder.is_none() {","+            *placeholder = Some(PgnComments::new());","+        }","+        let added = placeholder","+            .as_mut()","+            .unwrap()","+            .poll(PgnCommentPosition::AfterAlternative, &s[cursor..]);","+        cursor += added;","+    }","+    cursor","+}"]}],"originalFile":"use std::fmt::Display;\nuse crate::{\n    annotation::PgnAnnotation, check::PgnCheck, comments::PgnComments, coordinate::PgnCoordinate,\n    piece::PgnPiece,\n};\npub const PGN_CASTLING_NONE: u8 = 0;\npub const PGN_CASTLING_KINGSIDE: u8 = 2;\npub const PGN_CASTLING_QUEENSIDE: u8 = 3;\npub const PGN_MOVES_INITIAL_SIZE: usize = 32;\npub const PGN_MOVES_GROW_SIZE: usize = 32;\npub const PGN_MOVE_NOTATION_SIZE: usize = 16;\npub const PGN_ALTERNATIVE_MOVES_INITIAL_SIZE: usize = 1;\npub const PGN_ALTERNATIVE_MOVES_GROW_SIZE: usize = 1;\n#[derive(Debug)]\npub struct PgnMove {\n    pub piece: PgnPiece,\n    pub promoted_to: PgnPiece,\n    pub notation: String,\n    pub castles: u8,\n    pub captures: bool,\n    pub en_passant: bool,\n    pub check: PgnCheck,\n    pub from: PgnCoordinate,\n    pub dest: PgnCoordinate,\n    pub annotation: PgnAnnotation,\n    pub comments: Option<PgnComments>,\n    pub alternatives: Option<PgnAlternativeMoves>,\n}\nimpl Default for PgnMove {\n    fn default() -> Self {\n        unimplemented!()\n    }\n}\nimpl PgnMove {\n    pub fn from_string_with_consumption(s: &str, consumed: &mut usize) -> Self {\n        unimplemented!()\n    }\n}\nimpl From<&str> for PgnMove {\n    fn from(s: &str) -> Self {\n        unimplemented!()\n    }\n}\nimpl Display for PgnMove {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        unimplemented!()\n    }\n}\n#[derive(Debug)]\npub struct PgnMoves {\n    pub values: Vec<PgnMovesItem>,\n}\nimpl From<&str> for PgnMoves {\n    fn from(s: &str) -> Self {\n        unimplemented!()\n    }\n}\nimpl PgnMoves {\n    pub fn new() -> Self {\n        unimplemented!()\n    }\n    pub fn from_string_with_consumption(s: &str, consumed: &mut usize) -> Self {\n        unimplemented!()\n    }\n    pub fn push(&mut self, moves: PgnMovesItem) {\n        unimplemented!()\n    }\n}\n#[derive(Debug)]\npub struct PgnMovesItem {\n    pub white: PgnMove,\n    pub black: PgnMove,\n}\n#[derive(Debug)]\npub struct PgnAlternativeMoves {\n    pub values: Vec<Box<PgnMoves>>,\n}\nimpl PgnAlternativeMoves {\n    pub fn new() -> Self {\n        unimplemented!()\n    }\n    pub fn poll(\n        alt: &mut Option<Self>,\n        placeholder: &mut Option<PgnComments>,\n        s: &str,\n        expect: i32,\n    ) -> usize {\n        unimplemented!()\n    }\n    pub fn push(&mut self, moves: PgnMoves) {\n        unimplemented!()\n    }\n}","userModified":false}}
