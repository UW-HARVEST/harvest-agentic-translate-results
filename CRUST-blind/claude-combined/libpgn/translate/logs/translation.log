        out.push_str(\"O-O\");","+                at_check = true;","+            }","+            PGN_CASTLING_QUEENSIDE => {","+                out.push_str(\"O-O-O\");","+                at_check = true;","+            }","+            _ => {}","+        }","+","+        if !at_check {","+            assert!(self.piece != PgnPiece::Unknown);","+            if self.piece != PgnPiece::Pawn {","+                out.push(self.piece as u8 as char);","+            }","+            if let Some(file) = self.from.file {","+                out.push(file);","+            }","+            if let Some(rank) = self.from.rank {","+                if rank != 0 {","+                    out.push((b'0' + rank as u8) as char);","+                }","+            }","+            if self.captures {","+                out.push('x');","+            }","+            if let Some(file) = self.dest.file {","+                out.push(file);","+            }","+            if let Some(rank) = self.dest.rank {","+                out.push((b'0' + rank as u8) as char);","+            }","+            if self.promoted_to != PgnPiece::Unknown {","+                assert!(self.piece == PgnPiece::Pawn);","+                assert!(self.promoted_to != PgnPiece::Pawn);","+                out.push('=');","+                out.push(self.promoted_to as u8 as char);","+            }","+        }","+","+        match self.check {","+            PgnCheck::None => {}","+            PgnCheck::Mate => out.push('#'),","+            PgnCheck::Single => out.push('+'),","+            PgnCheck::Double => {","+                out.push('+');","+                out.push('+');","+            }","+        }","+","+        // Annotations [GoodMove..DubiousMove] are inline","+        let in_inline_range = matches!(","+            self.annotation,","+            PgnAnnotation::GoodMove","+                | PgnAnnotation::Mistake","+                | PgnAnnotation::BrilliantMove","+                | PgnAnnotation::Blunder","+                | PgnAnnotation::InterestingMove","+                | PgnAnnotation::DubiousMove","+        );","+        if in_inline_range {","+            out.push_str(&format!(\"{}\", self.annotation));","+        }","+","+        if self.en_passant {","+            out.push(' ');","+            out.push_str(\"e.p.\");","+        }","+","+        // For NAG-only or Null annotation, output trailing space + format","+        let is_null = matches!(self.annotation, PgnAnnotation::Null);","+        // PgnAnnotation enum has a fixed set of variants; \"above DubiousMove\" is impossible.","+        // Match the C semantics: only Null trailing space here.","+        if is_null {","+            out.push(' ');","+            // Annotation Null produces empty string but we still match C output that is `$0` only","+            // if we've stored a number > DubiousMove. With this enum we can't represent NAG","+            // numbers, so treat Null as empty and rely on the inline_range path for known variants.","+            out.push_str(&format!(\"{}\", self.annotation));","+        }","+","+        f.write_str(&out)","     }"," }","+"," #[derive(Debug)]"," pub struct PgnMoves {","     pub values: Vec<PgnMovesItem>,"," }","+"," impl From<&str> for PgnMoves {","     fn from(s: &str) -> Self {","-        unimplemented!()","+        let mut consumed = 0usize;","+        PgnMoves::from_string_with_consumption(s, &mut consumed)","     }"," }","+"," impl PgnMoves {","     pub fn new() -> Self {","-        unimplemented!()","+        let _ = (PGN_MOVES_INITIAL_SIZE, PGN_MOVES_GROW_SIZE);","+        PgnMoves {","+            values: Vec::with_capacity(PGN_MOVES_INITIAL_SIZE),","+        }","     }","+","     pub fn from_string_with_consumption(s: &str, consumed: &mut usize) -> Self {","-        unimplemented!()","+        let mut moves = PgnMoves::new();","+        let mut cursor = 0usize;","+        moves_recurse(s, &mut cursor, &mut moves, PGN_EXPECT_WHITE);","+        *consumed