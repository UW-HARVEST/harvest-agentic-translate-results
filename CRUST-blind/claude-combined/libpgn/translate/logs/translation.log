{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RzjPSSdCWSQii63cVP1tfS","type":"tool_result","content":"1\t/* libpgn - PGN file parser.\n2\t * Copyright (C) 2024 youkwhd <lolywk@tutanota.com>\n3\t *\n4\t * This program is free software; you can redistribute it and/or modify\n5\t * it under the terms of the GNU General Public License as published by\n6\t * the Free Software Foundation; either version 2 of the License, or\n7\t * (at your option) any later version.\n8\t *\n9\t * This program is distributed in the hope that it will be useful,\n10\t * but WITHOUT ANY WARRANTY; without even the implied warranty of\n11\t * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n12\t * GNU General Public License for more details.\n13\t *\n14\t * You should have received a copy of the GNU General Public License along\n15\t * with this program; if not, write to the Free Software Foundation, Inc.,\n16\t * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n17\t */\n18\t\n19\t#include <assert.h>\n20\t#include <stdio.h>\n21\t#include <string.h>\n22\t#include <ctype.h>\n23\t\n24\t#include \"annotation.h\"\n25\t#include \"utils/cursor.h\"\n26\t\n27\tpgn_annotation_t __pgn_annotation_nag_from_string(char *str, size_t *consumed)\n28\t{\n29\t    pgn_annotation_t annotation = PGN_ANNOTATION_UNKNOWN;\n30\t    size_t cursor = 0;\n31\t\n32\t    /* works for not revisiting whitespaces\n33\t     */\n34\t    if (str[cursor] != '$')\n35\t        return annotation;\n36\t\n37\t    /* NOTE: NAG annotation tends to have $0 followed by another $<num>.\n38\t     * thus why the while loop, take the last.\n39\t     */\n40\t    while (str[cursor] == '$')\n41\t    {\n42\t        assert(isdigit(str[++cursor]));\n43\t\n44\t        /* TODO: don't discard the rest.\n45\t         */\n46\t        char *endptr = NULL;\n47\t        long num = strtol(str + cursor, &endptr, 10);\n48\t\n49\t        annotation = num;\n50\t        cursor += endptr - (str + cursor);\n51\t\n52\t        pgn_cursor_skip_whitespace(str, &cursor);\n53\t    }\n54\t    pgn_cursor_revisit_whitespace(str, &cursor);\n55\t\n56\t    *consumed += cursor;\n57\t    return annotation;\n58\t}\n59\t\n60\tpgn_annotation_t __pgn_annotation_from_string(char *str, size_t *consumed)\n61\t{\n62\t    /* TODO: maybe refactor using strcmp()?\n63\t     */\n64\t    pgn_annotation_t annotation = PGN_ANNOTATION_UNKNOWN;\n65\t\n66\t    if (str[0] == '\\0')\n67\t        return annotation;\n68\t\n69\t    if (str[0] == '!') {\n70\t        (*consumed)++;\n71\t        annotation = PGN_ANNOTATION_GOOD_MOVE;\n72\t    }\n73\t\n74\t    if (str[0] == '?') {\n75\t        (*consumed)++;\n76\t        annotation = PGN_ANNOTATION_MISTAKE;\n77\t    }\n78\t\n79\t    if (str[1] == '\\0')\n80\t        return annotation;\n81\t\n82\t    if (str[0] == '!' && str[1] == '!') {\n83\t        (*consumed)++;\n84\t        annotation = PGN_ANNOTATION_BRILLIANT_MOVE;\n85\t    }\n86\t\n87\t    if (str[0] == '!' && str[1] == '?') {\n88\t        (*consumed)++;\n89\t        annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n90\t    }\n91\t\n92\t    if (str[0] == '?' && str[1] == '!') {\n93\t        (*consumed)++;\n94\t        annotation = PGN_ANNOTATION_DUBIOUS_MOVE;\n95\t    }\n96\t\n97\t    if (str[0] == '?' && str[1] == '?') {\n98\t        (*consumed)++;\n99\t        annotation = PGN_ANNOTATION_BLUNDER;\n100\t    }\n101\t\n102\t    return annotation;\n103\t}\n104\t\n105\tpgn_annotation_t pgn_annotation_from_string(char *str)\n106\t{\n107\t    size_t consumed = 0;\n108\t    return __pgn_annotation_from_string(str, &consumed);\n109\t}\n110\t\n111\tsize_t pgn_annotation_to_string(pgn_annotation_t annotation, char *dest)\n112\t{\n113\t    switch (annotation) {\n114\t    case PGN_ANNOTATION_UNKNOWN: return 0;\n115\t    case PGN_ANNOTATION_NULL: break;\n116\t    case PGN_ANNOTATION_GOOD_MOVE:\n117\t        strcpy(dest, \"!\");\n118\t        return 1;\n119\t    case PGN_ANNOTATION_MISTAKE:\n120\t        strcpy(dest, \"?