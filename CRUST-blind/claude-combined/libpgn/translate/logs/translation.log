sor);","+        if *cursor < bytes.len() && bytes[*cursor] == b'{' {","+            if comments_placeholder.is_none() {","+                comments_placeholder = Some(PgnComments::new());","+            }","+            let added = comments_placeholder","+                .as_mut()","+                .unwrap()","+                .poll(PgnCommentPosition::AfterMove, &s[*cursor..]);","+            *cursor += added;","+        }","+        let added = poll_alternatives(","+            &mut item.black.alternatives,","+            &mut comments_placeholder,","+            &s[*cursor..],","+            PGN_EXPECT_BLACK,","+        );","+        *cursor += added;","+","+        pgn_cursor_skip_whitespace(s, cursor);","+        if *cursor < bytes.len() && bytes[*cursor] == b'{' {","+            if comments_placeholder.is_none() {","+                comments_placeholder = Some(PgnComments::new());","+            }","+            let added = comments_placeholder","+                .as_mut()","+                .unwrap()","+                .poll(PgnCommentPosition::AfterMove, &s[*cursor..]);","+            *cursor += added;","+        }","+","+        if let Some(c) = comments_placeholder.take() {","+            item.black.comments = Some(c);","+        }","+        moves.push(item);","+        moves_recurse(s, cursor, moves, PGN_EXPECT_WHITE);","+        return;","+    }","+","+    // Parse white move","+    let mut local = 0usize;","+    item.white = PgnMove::from_string_with_consumption(&s[*cursor..], &mut local);","+    *cursor += local;","+","+    pgn_cursor_skip_whitespace(s, cursor);","+    if *cursor < bytes.len() && bytes[*cursor] == b'{' {","+        if comments_placeholder.is_none() {","+            comments_placeholder = Some(PgnComments::new());","+        }","+        let added = comments_placeholder","+            .as_mut()","+            .unwrap()","+            .poll(PgnCommentPosition::AfterMove, &s[*cursor..]);","+        *cursor += added;","+    }","+    let