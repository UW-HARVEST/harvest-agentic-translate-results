n * Deinterleaves bits.\n */\nstruct Morton unmorton(unsigned long long z) {\n    struct Morton m;\n#ifdef __BMI2__\n    m.hi = _pext_u64(z, 0x5555555555555555);\n    m.lo = _pext_u64(z, 0xAAAAAAAAAAAAAAAA);\n#else\n    m.hi = unmortoner(z);\n    m.lo = unmortoner(z >> 1);\n#endif\n    return m;\n}\n","numLines":85,"startLine":1,"totalLines":85}}}
