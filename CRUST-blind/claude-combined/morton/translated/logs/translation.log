{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_3obri4b4xx7nfivmcuy2o5fkkxi6cglxd5zzsty6bg2s7dxpqckq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01PDsKUGfZ6GkFxcpAYdmi3Y","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-8KoWgR/project/src/bin/test_unmorton.rs","content":"use morton::morton;\n\n#[test]\nfn test_unmorton_zero() {\n    let m = morton::unmorton(0);\n    assert_eq!(m.hi, 0);\n    assert_eq!(m.lo, 0);\n}\n\n#[test]\nfn test_unmorton_one() {\n    // hi reads even bits, lo reads odd bits.\n    // unmorton(0x1) -> hi=1, lo=0 (per C ground truth)\n    let m = morton::unmorton(0x1);\n    assert_eq!(m.hi, 0x1);\n    assert_eq!(m.lo, 0x0);\n}\n\n#[test]\nfn test_unmorton_two() {\n    let m = morton::unmorton(0x2);\n    assert_eq!(m.hi, 0x0);\n    assert_eq!(m.lo, 0x1);\n}\n\n#[test]\nfn test_unmorton_three() {\n    let m = morton::unmorton(0x3);\n    assert_eq!(m.hi, 0x1);\n    assert_eq!(m.lo, 0x1);\n}\n\n#[test]\nfn test_unmorton_ff() {\n    let m = morton::unmorton(0xFF);\n    assert_eq!(m.hi, 0xF);\n    assert_eq!(m.lo, 0xF);\n}\n\n#[test]\nfn test_unmorton_5555() {\n    // 0x5555... has the even bits set (bit 0, 2, 4, ...).\n    // C struct: hi = unmortoner(z) with mask 0x5555..., lo = unmortoner(z>>1).\n    // So unmorton(0x5555...) -> hi=0xFFFFFFFF, lo=0\n    let m = morton::unmorton(0x5555555555555555u64);\n    assert_eq!(m.hi, 0xFFFFFFFFu32);\n    assert_eq!(m.lo, 0u32);\n}\n\n#[test]\nfn test_unmorton_aaaa() {\n    let m = morton::unmorton(0xAAAAAAAAAAAAAAAAu64);\n    assert_eq!(m.hi, 0u32);\n    assert_eq!(m.lo, 0xFFFFFFFFu32);\n}\n\n#[test]\nfn test_unmorton_all_ones() {\n    let m = morton::unmorton(0xFFFFFFFFFFFFFFFFu64);\n    assert_eq!(m.hi, 0xFFFFFFFFu32);\n    assert_eq!(m.lo, 0xFFFFFFFFu32);\n}\n\n#[test]\nfn test_unmorton_known() {\n    // unmorton(0x5a346a180755e653) -> hi=0xc6843fad, lo=0x347210d1\n    let m = morton::unmorton(0x5a346a180755e653u64);\n    assert_eq!(m.hi, 0xc6843fadu32);\n    assert_eq!(m.lo, 0x347210d1u32);\n}\n\n#[test]\nfn test_unmorton_misc() {\n    let m = morton::unmorton(0x123456789ABCDEF0u64);\n    assert_eq!(m.hi, 0x46ec46ecu32);\n    assert_eq!(m.lo, 0x1416bebcu32);\n}\n\n#[test]\nfn test_morton_unmorton_roundtrip() {\n    // Roundtrip — inverse of morton must be unmorton (matching C semantics:\n    // morton(hi, lo) -> z, unmorton(z) -> {hi: hi, lo: lo})\n    let pairs: [(u32, u32); 6] = [\n        (0, 0),\n        (1, 1),\n        (0xFFFFFFFFu32, 0xFFFFFFFFu32),\n        (0x347210d1u32, 0xc6843fadu32),\n        (0xAAAAAAAAu32, 0x55555555u32),\n        (12345, 67890),\n    ];\n    for (hi, lo) in pairs.iter() {\n        let z = morton::morton(*hi, *lo);\n        let m = morton::unmorton(z);\n        assert_eq!(m.hi, *hi);\n        assert_eq!(m.lo, *lo);\n    }\n}\n\n#[test]\nfn test_unmortoner_zero() {\n    assert_eq!(morton::unmortoner(0), 0);\n}\n\n#[test]\nfn test_unmortoner_one() {\n    // unmortoner(0x1) = 0x1 (only bit 0 set, that's even -> stays)\n    assert_eq!(morton::unmortoner(0x1), 0x1);\n}\n\n#[test]\nfn test_unmortoner_two() {\n    // unmortoner(0x2) = 0x0 (bit 1 set, odd, masked away)\n    assert_eq!(morton::unmortoner(0x2), 0x0);\n}\n\n#[test]\nfn test_unmortoner_three() {\n    assert_eq!(morton::unmortoner(0x3), 0x1);\n}\n\n#[test]\nfn test_unmortoner_ff() {\n    assert_eq!(morton::unmortoner(0xFF), 0xF);\n}\n\n#[test]\nfn test_unmortoner_aa() {\n    // 0xAA has only odd bits, masked off -> 0\n    assert_eq!(morton::unmortoner(0xAA), 0x0);\n}\n\n#[test]\nfn test_unmortoner_55() {\n    // 0x55 has only even bits -> compresses to 0xF\n    assert_eq!(morton::unmortoner(0x55), 0xF);\n}\n\n#[test]\nfn test_unmortoner_all_even_bits() {\n    assert_eq!(morton::unmortoner(0x5555555555555555u64), 0xFFFFFFFFu32);\n}\n\n#[test]\nfn test_unmortoner_all_odd_bits() {\n    assert_eq!(morton::unmortoner(0xAAAAAAAAAAAAAAAAu64), 0u32);\n}\n\n#[test]\nfn test_unmortoner_all_ones() {\n    assert_eq!(morton::unmortoner(0xFFFFFFFFFFFFFFFFu64), 0xFFFFFFFFu32);\n}\n\n#[test]\nfn test_unmortoner_misc() {\n    assert_eq!(morton::unmortoner(0x123456789ABCDEF0u64), 0x46ec46ecu32);\n}\n\n#[test]\nfn test_unmortoner_known() {\n    assert_eq!(morton::unmortoner(0x5a346a180755e653u64), 0xc6843fadu32);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1241,"cache_read_input_tokens":24859,"cache_creation":{"ephemeral_5m_input_tokens":1241,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0770061b-177d-4480-9d0d-c1f03847d66b","uuid":"2f01d150-72ad-4f53-8a94-97e4246cbdd0"}
