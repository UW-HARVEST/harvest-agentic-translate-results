 {\n    assert_eq!(unmortoner(0xAAAAAAAAAAAAAAAAu64), 0u32);\n}\n\n#[test]\nfn test_unmortoner_all_ones() {\n    assert_eq!(unmortoner(0xFFFFFFFFFFFFFFFFu64), 0xFFFFFFFFu32);\n}\n\n#[test]\nfn test_unmortoner_misc() {\n    assert_eq!(unmortoner(0x123456789ABCDEF0u64), 0x46ec46ecu32);\n}\n\n#[test]\nfn test_unmortoner_known() {\n    assert_eq!(unmortoner(0x5a346a180755e653u64), 0xc6843fadu32);\n}\n\nfn main() {}\n","structuredPatch":[{"oldStart":1,"oldLines":36,"newStart":1,"newLines":39,"lines":["+use morton::morton::morton as morton_fn;","+use morton::morton::unmorton;","+use morton::morton::unmortoner;","+"," #[test]"," fn test_unmorton_zero() {","-    let m = morton::unmorton(0);","+    let m = unmorton(0);","     assert_eq!(m.hi, 0);","     assert_eq!(m.lo, 0);"," }"," "," #[test]"," fn test_unmorton_one() {","-    // hi reads even bits, lo reads odd bits.","     // unmorton(0x1) -> hi=1, lo=0 (per C ground truth)","-    let m = morton::unmorton(0x1);","+    let m = unmorton(0x1);","     assert_eq!(m.hi, 0x1);","     assert_eq!(m.lo, 0x0);"," }"," "," #[test]"," fn test_unmorton_two() {","-    let m = morton::unmorton(0x2);","+    let m = unmorton(0x2);","     assert_eq!(m.hi, 0x0);","     assert_eq!(m.lo, 0x1);"," }"," "," #[test]"," fn test_unmorton_three() {","-    let m = morton::unmorton(0x3);","+    let m = unmorton(0x3);","     assert_eq!(m.hi, 0x1);","     assert_eq!(m.lo, 0x1);"," }"," "," #[test]"," fn test_unmorton_ff() {","-    let m = morton::unmorton(0xFF);","+    let m = unmorton(0xFF);","     assert_eq!(m.hi, 0xF);","     assert_eq!(m.lo, 0xF);"," }"]},{"oldStart":38,"oldLines":23,"newStart":41,"newLines":23,"lines":[" #[test]"," fn test_unmorton_5555() {","     // 0x5555... has the even bits set (bit 0, 2, 4, ...).","-    // C struct: hi = unmortoner(z) with mask 0x5555..., lo = unmortoner(z>>1).","-    // So unmorton(0x5555...) -> hi=0xFFFFFFFF, lo=0","-    let m = morton::unmorton(0x5555555555555555u64);","+    // C: hi = unmortoner(z) with ma