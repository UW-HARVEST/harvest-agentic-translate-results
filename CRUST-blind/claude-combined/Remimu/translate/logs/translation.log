an[2], 1);\n    assert_eq!(cap_pos[3], -1);\n    assert_eq!(cap_span[3], -1);\n}\n\n#[test]\nfn test_match_captures_words() {\n    // Verified against C: (\\w+)\\s(\\w+) on \"hello world\" -> len=11, caps (0,5)(6,5)\n    let tokens = parse(\"(\\\\w+)\\\\s(\\\\w+)\");\n    let mut cap_pos = vec![-1i64; 16];\n    let mut cap_span = vec![-1i64; 16];\n    let m = regex_match(&tokens, \"hello world\", 0, 16, &mut cap_pos, &mut cap_span);\n    assert_eq!(m, Some(11));\n    assert_eq!(cap_pos[0], 0);\n    assert_eq!(cap_span[0], 5);\n    assert_eq!(cap_pos[1], 6);\n    assert_eq!(cap_span[1], 5);\n    assert_eq!(cap_pos[2], -1);\n    assert_eq!(cap_span[2], -1);\n}\n\n#[test]\nfn test_match_captures_alt() {\n    // Verified against C: (a|b)(c|d) on \"ad\" -> len=2, caps (0,1)(1,1)\n    let tokens = parse(\"(a|b)(c|d)\");\n    let mut cap_pos = vec![-1i64; 16];\n    let mut cap_span = vec![-1i64; 16];\n    let m = regex_match(&tokens, \"ad\", 0, 16, &mut cap_pos, &mut cap_span);\n    assert_eq!(m, Some(2));\n    assert_eq!(cap_pos[0], 0);\n    assert_eq!(cap_span[0], 1);\n    assert_eq!(cap_pos[1], 1);\n    assert_eq!(cap_span[1], 1);\n}\n\n#[test]\nfn test_match_captures_quant_a() {\n    // Verified against C: (a)+ on \"aaaa\" -> len=4, cap 0: pos=3, span=1\n    let tokens = parse(\"(a)+\");\n    let mut cap_pos = vec![-1i64; 16];\n    let mut cap_span = vec![-1i64; 16];\n    let m = regex_match(&tokens, \"aaaa\", 0, 16, &mut cap_pos, &mut cap_span);\n    assert_eq!(m, Some(4));\n    // C captures the LAST iteration of the group\n    assert_eq!(cap_pos[0], 3);\n    assert_eq!(cap_span[0], 1);\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1011,"cache_read_input_tokens":89386,"cache_creation":{"ephemeral_5m_input_tokens":1011,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8207d0ed-6633-41fe-88d4-b0c52d2b4