2_t *data2 = (int32_t*)pointB->data;\n60\t    for (i = 0; i < pointA->datalen; i++){\n61\t\tdouble diff = (double)data1[i] - (double)data2[i];\n62\t\tsum = sum + abs(diff);\n63\t    }\n64\t    nbcalcs++;\n65\t    return (float)sum/(float)pointA->datalen;\n66\t}\n67\t\n68\tfloat point_l2_distance(MVPDP *pointA, MVPDP *pointB){\n69\t    /* L2 distance */\n70\t    if (!pointA || !pointB || pointA->datalen != pointB->datalen) return -1.0f;\n71\t    int i;\n72\t    double sum = 0.0;\n73\t    int32_t *data1 = (int32_t*)pointA->data;\n74\t    int32_t *data2 = (int32_t*)pointB->data;\n75\t    for (i=0;i<pointA->datalen;i++){\n76\t\tdouble diff =  (double)data1[i] - (double)data2[i];\n77\t\tsum = sum + pow(diff,2.0f) ;\n78\t    }\n79\t    nbcalcs++;\n80\t    float result = (float)(sqrt(sum)/(float)pointA->datalen);\n81\t    return result;\n82\t}\n83\t\n84\t\n85\tMVPDP* mvpdp_dup(MVPDP *dp){\n86\t    MVPDP *newpnt = dp_alloc(dp->type);\n87\t    if (!newpnt) return NULL;\n88\t    newpnt->datalen = dp->datalen;\n89\t    newpnt->data = malloc(dp->datalen*dp->type);\n90\t    memcpy(newpnt->data, dp->data, dp->datalen*dp->type);\n91\t    newpnt->id = strdup(dp->id);\n92\t    return newpnt;\n93\t}\n94\t\n95\tMVPDP* generate_point(const unsigned int dp_length){\n96\t    /* generate one datapoint with UINT32ARRAY type data of length dp_length */\n97\t    static unsigned long long uid = 0;\n98\t    char scratch[32];\n99\t\n100\t    MVPDP *newpnt = dp_alloc(UINT32ARRAY);\n101\t    if (newpnt == NULL) return NULL;\n102\t\n103\t    newpnt->datalen = dp_length;\n104\t    newpnt->data = malloc(dp_length*sizeof(int32_t));\n105\t    if (newpnt->data == NULL) {\n106\t\tfree (newpnt);\n107\t\treturn NULL;\n108\t    }\n109\t    int32_t *row = (int32_t*)newpnt->data;\n110\t\n111\t    int i;\n112\t    for (i=0;i<dp_length;i++){\n113\t\trow[i] = rand()%1024;\n114\t    }\n115\t    snprintf(scratch, 32, \"point%llu\", ++uid);\n116\t    newpnt->id = strdup(scratch);\n117\t    if (newpnt->id == NULL){