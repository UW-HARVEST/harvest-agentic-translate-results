{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NiPYLp8x3zXRqXt3iwtFFa","type":"tool_result","content":"1\t// Crit-bit trees and linked list.\n2\t// No parent pointers.\n3\t//\n4\t// Uses pointer casting and different structs instead of unions.\n5\t// In a trie, internal nodes never become external nodes, and vice versa.\n6\t//\n7\t// Removing linked list code and data saves a little.\n8\t\n9\t#define __CBT_H__\n10\t\n11\tstruct cbt_s;\n12\ttypedef struct cbt_s *cbt_t;\n13\t\n14\tstruct cbt_leaf_s;\n15\t// Iterator.\n16\ttypedef struct cbt_leaf_s *cbt_it;\n17\t\n18\t// Never mix keys from different types of trees.\n19\t\n20\t// Default: ASCIIZ keys.\n21\tcbt_t cbt_new(void);\n22\t\n23\t// \"u\" mode: all keys are the same length but can contain any data.\n24\t// e.g. SHA1 hashes.\n25\tcbt_t cbt_new_u(int len);\n26\t\n27\t// \"enc\" mode: First 2 bytes encode length of remaining data. First byte\n28\t// is the least significant.\n29\tcbt_t cbt_new_enc();\n30\t\n31\tvoid cbt_delete(cbt_t cbt);\n32\t\n33\tvoid *cbt_get_at(cbt_t cbt, const void *key);\n34\tcbt_it cbt_put_at(cbt_t cbt, void *data, const void *key);\n35\t\n36\tint cbt_size(cbt_t cbt);\n37\t\n38\tstatic inline int cbt_is_off(cbt_it it) { return !it; }\n39\t\n40\tcbt_it cbt_first(cbt_t cbt);\n41\tcbt_it cbt_last(cbt_t cbt);\n42\tcbt_it cbt_next(cbt_it it);\n43\tvoid cbt_put(cbt_it it, void *data);\n44\tvoid *cbt_get(cbt_it it);\n45\tchar *cbt_key(cbt_it it);\n46\t\n47\tcbt_it cbt_at(cbt_t cbt, const void *key);\n48\tint cbt_has(cbt_t cbt, const void *key);\n49\t\n50\tvoid cbt_forall(cbt_t cbt, void (*fn)(cbt_it));\n51\tvoid cbt_forall_at(cbt_t cbt, void (*fn)(void *data, const void *key));\n52\t\n53\tvoid *cbt_remove(cbt_t cbt, const void *key);\n54\tvoid cbt_remove_all(cbt_t cbt);\n55\tvoid cbt_remove_all_with(cbt_t cbt, void (*fn)(void *data, const void *key));\n56\t\n57\tstatic inline void cbt_clear_with(cbt_t cbt,\n58\t    void (*fn)(void *data, const void *key)) {\n59\t 