st]\nfn test_viterbi_decode_bit() {\n    let _g = VITERBI_LOCK.lock().unwrap();\n    // Just call to ensure no crash; behavior is internal state mutation.\n    viterbi_decode_bit(0, 0, 0);\n    viterbi_decode_bit(0xFFFF, 0xFFFF, 1);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":387,"cache_read_input_tokens":119951,"cache_creation":{"ephemeral_5m_input_tokens":387,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c23f0813-221f-4931-b2a2-1b29ad63dcc1","uuid":"a096968a-54f3-48cc-a8c9-ffefbbeb13c5"}
