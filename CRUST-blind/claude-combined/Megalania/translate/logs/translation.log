       let new_idx = self.data.len();\n        self.data.push(value);\n        self.heapify_up(new_idx);\n        true\n    }\n    pub fn maximum(&self) -> Option<u32> {\n        if self.data.is_empty() {\n            None\n        } else {\n            Some(self.data[0])\n        }\n    }\n    pub fn remove_maximum(&mut self) -> bool {\n        if self.data.is_empty() {\n            return false;\n        }\n        let last = self.data.pop().unwrap();\n        if !self.data.is_empty() {\n            self.data[0] = last;\n            self.heapify_down(0);\n        }\n        true\n    }\n    /// Assumes that the element at index 0 may have changed.\n    pub fn update_maximum(&mut self) -> bool {\n        if self.data.is_empty() {\n            return false;\n        }\n        self.heapify_down(0);\n        true\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":5049,"cache_read_input_tokens":84821,"cache_creation":{"ephemeral_5m_input_tokens":5049,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9ca8114d-ea7d-43b9-88bb-9adde4161124","uuid":"75bd8cd4-659d-4c95-bbc1-7f4ec1ff76a7"}
