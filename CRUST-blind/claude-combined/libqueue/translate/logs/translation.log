{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_acxrioiqolfbr5vwuamzkydjtrtpzj7q4f6urkwu65c27lvpk2eq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_011qiphsKB1QKJMBweUu8d9L","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-p7OQJk/project/src/queue.rs","content":"struct QueueNode<T> {\n    value: T,\n    next: Option<Box<QueueNode<T>>>,\n}\npub struct Queue<T> {\n    pub head: Option<Box<QueueNode<T>>>,\n    pub tail: Option<*mut QueueNode<T>>, // Tail for efficient appending\n    pub size: usize,\n}\nimpl<T> Queue<T> {\n    /// Creates a new, empty queue.\n    pub fn new() -> Self {\n        Queue {\n            head: None,\n            tail: None,\n            size: 0,\n        }\n    }\n    /// Checks if the queue is empty.\n    pub fn is_empty(&self) -> bool {\n        self.size == 0\n    }\n    /// Adds a value to the back of the queue.\n    pub fn push(&mut self, value: T) {\n        let mut new_node = Box::new(QueueNode {\n            value,\n            next: None,\n        });\n        let new_tail: *mut QueueNode<T> = &mut *new_node;\n\n        if self.is_empty() {\n            self.head = Some(new_node);\n        } else {\n            // Append to current tail's `next`. Tail must be valid.\n            unsafe {\n                let tail_ptr = self.tail.expect(\"tail must exist when not empty\");\n                (*tail_ptr).next = Some(new_node);\n            }\n        }\n        self.tail = Some(new_tail);\n        self.size += 1;\n    }\n    /// Removes and returns the value at the front of the queue.\n    pub fn pop(&mut self) -> Option<T> {\n        if self.is_empty() {\n            return None;\n        }\n        let mut head_node = self.head.take()?;\n        self.head = head_node.next.take();\n\n        if self.size == 1 {\n            self.tail = None;\n        }\n        self.size -= 1;\n        Some(head_node.value)\n    }\n    /// Returns a reference to the value at the front of the queue.\n    pub fn front(&self) -> Option<&T> {\n        if self.is_empty() {\n            return None;\n        }\n        self.head.as_ref().map(|node| &node.value)\n    }\n    /// Returns a reference to the value at the back of the queue.\n    pub fn back(&self) -> Option<&T> {\n        if self.is_empty() {\n            return None;\n        }\n        match self.tail {\n            Some(tail_ptr) => unsafe { Some(&(*tail_ptr).value) },\n            None => None,\n        }\n    }\n    /// Frees all nodes in the queue.\n    pub fn free(&mut self) {\n        // Iteratively drop nodes to avoid recursive deep stack drops.\n        let mut current = self.head.take();\n        while let Some(mut node) = current {\n            current = node.next.take();\n        }\n        self.tail = None;\n        self.size = 0;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":328,"cache_read_input_tokens":18977,"cache_creation":{"ephemeral_5m_input_tokens":328,"ephemeral_1h_input_tokens":0},"output_tokens":40,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e7575f60-260f-45a8-b8b5-86a1e6ba7415","uuid":"a8d6800e-e9cc-4b8b-95e7-89da0d88a798"}
