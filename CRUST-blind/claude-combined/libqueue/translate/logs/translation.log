rt_eq!(q.pop().unwrap(), 15);\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n    assert!(q.front().is_none());\n    assert!(q.back().is_none());\n}\n\n#[test]\nfn test_pop_empty_returns_none() {\n    let mut q: Queue<i32> = Queue::new();\n    assert!(q.pop().is_none());\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_many_push_then_pop() {\n    let mut q: Queue<i32> = Queue::new();\n    let values = [1, 2, 3, 4, 5];\n    for &v in &values {\n        q.push(v);\n    }\n    assert_eq!(q.size, 5);\n    assert_eq!(*q.front().unwrap(), 1);\n    assert_eq!(*q.back().unwrap(), 5);\n\n    let expected_pops = [1, 2, 3, 4, 5];\n    for &expected in &expected_pops {\n        assert_eq!(q.pop().unwrap(), expected);\n    }\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_push_pop_alternating() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(100);\n    let popped = q.pop().unwrap();\n    assert_eq!(popped, 100);\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n    q.push(200);\n    assert_eq!(q.size, 1);\n    assert_eq!(*q.front().unwrap(), 200);\n    assert_eq!(*q.back().unwrap(), 200);\n}\n\n#[test]\nfn test_is_empty_initial() {\n    let q: Queue<i32> = Queue::new();\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_is_empty_after_push() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(42);\n    assert!(!q.is_empty());\n}\n\n#[test]\nfn test_front_empty() {\n    let q: Queue<i32> = Queue::new();\n    assert!(q.front().is_none());\n}\n\n#[test]\nfn test_back_empty() {\n    let q: Queue<i32> = Queue::new();\n    assert!(q.back().is_none());\n}\n\n#[test]\nfn test_free_resets_queue() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(1);\n    q.push(2);\n    q.push(3);\n    assert_eq!(q.size, 3);\n    q.free();\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n    assert!(q.front().is_none());\n    assert!(q.back().is_none());\n    assert!(q.head.is_none());\n    assert!(q.tail.is_none());\n}\n\n#[test]\nfn test_free_empty_queue() {\n    let mut q: Queue<i32> = Queue::new();\n    q.free();\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_push_after_free() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(1);\n    q.push(2);\n    q.free();\n    q.push(99);\n    assert_eq!(q.size, 1);\n    assert_eq!(*q.front().unwrap(), 99);\n    assert_eq!(*q.back().unwrap(), 99);\n}\n\n#[test]\nfn test_with_strings() {\n    let mut q: Queue<String> = Queue::new();\n    q.push(String::from(\"hello\"));\n    q.push(String::from(\"world\"));\n    assert_eq!(q.size, 2);\n    assert_eq!(q.front().unwrap(), \"hello\");\n    assert_eq!(q.back().unwrap(), \"world\");\n    assert_eq!(q.pop().unwrap(), \"hello\");\n    assert_eq!(q.pop().unwrap(), \"world\");\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_size_progression() {\n    let mut q: Queue<i32> = Queue::new();\n    assert_eq!(q.size, 0);\n    q.push(1);\n    assert_eq!(q.size, 1);\n    q.push(2);\n    assert_eq!(q.size, 2);\n    q.push(3);\n    assert_eq!(q.size, 3);\n    q.pop();\n    assert_eq!(q.size, 2);\n    q.pop();\n    assert_eq!(q.size, 1);\n    q.pop();\n    assert_eq!(q.size, 0);\n    q.pop(); // pop from empty - should not underflow\n    assert_eq!(q.size, 0);\n}\n\nfn main() {}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
