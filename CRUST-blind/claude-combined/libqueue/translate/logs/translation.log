{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_3a2zonsuxrrfxtvglj5el77rm776t6rjfhabn3a3w7fqqiyuxupq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018HEs15T2ppcLziZjTr3QJs","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-p7OQJk/project/src/bin/test_queue.rs","content":"use libqueue::queue::Queue;\n\n#[test]\nfn test_new_queue() {\n    let q: Queue<i32> = Queue::new();\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n    assert!(q.head.is_none());\n    assert!(q.tail.is_none());\n    assert!(q.front().is_none());\n    assert!(q.back().is_none());\n}\n\n#[test]\nfn test_push_one() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(10);\n    assert_eq!(q.size, 1);\n    assert!(!q.is_empty());\n    assert_eq!(*q.front().unwrap(), 10);\n    assert_eq!(*q.back().unwrap(), 10);\n    // front and back point to the same node\n    let front_ptr: *const i32 = q.front().unwrap();\n    let back_ptr: *const i32 = q.back().unwrap();\n    assert_eq!(front_ptr, back_ptr);\n}\n\n#[test]\nfn test_push_two() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(10);\n    q.push(15);\n    assert_eq!(q.size, 2);\n    assert_eq!(*q.front().unwrap(), 10);\n    assert_eq!(*q.back().unwrap(), 15);\n}\n\n#[test]\nfn test_pop_one_of_two() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(10);\n    q.push(15);\n    let popped = q.pop().unwrap();\n    assert_eq!(popped, 10);\n    assert_eq!(q.size, 1);\n    assert_eq!(*q.front().unwrap(), 15);\n    assert_eq!(*q.back().unwrap(), 15);\n}\n\n#[test]\nfn test_pop_to_empty() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(10);\n    q.push(15);\n    assert_eq!(q.pop().unwrap(), 10);\n    assert_eq!(q.pop().unwrap(), 15);\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n    assert!(q.front().is_none());\n    assert!(q.back().is_none());\n}\n\n#[test]\nfn test_pop_empty_returns_none() {\n    let mut q: Queue<i32> = Queue::new();\n    assert!(q.pop().is_none());\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_many_push_then_pop() {\n    let mut q: Queue<i32> = Queue::new();\n    let values = [1, 2, 3, 4, 5];\n    for &v in &values {\n        q.push(v);\n    }\n    assert_eq!(q.size, 5);\n    assert_eq!(*q.front().unwrap(), 1);\n    assert_eq!(*q.back().unwrap(), 5);\n\n    let expected_pops = [1, 2, 3, 4, 5];\n    for &expected in &expected_pops {\n        assert_eq!(q.pop().unwrap(), expected);\n    }\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_push_pop_alternating() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(100);\n    let popped = q.pop().unwrap();\n    assert_eq!(popped, 100);\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n    q.push(200);\n    assert_eq!(q.size, 1);\n    assert_eq!(*q.front().unwrap(), 200);\n    assert_eq!(*q.back().unwrap(), 200);\n}\n\n#[test]\nfn test_is_empty_initial() {\n    let q: Queue<i32> = Queue::new();\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_is_empty_after_push() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(42);\n    assert!(!q.is_empty());\n}\n\n#[test]\nfn test_front_empty() {\n    let q: Queue<i32> = Queue::new();\n    assert!(q.front().is_none());\n}\n\n#[test]\nfn test_back_empty() {\n    let q: Queue<i32> = Queue::new();\n    assert!(q.back().is_none());\n}\n\n#[test]\nfn test_free_resets_queue() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(1);\n    q.push(2);\n    q.push(3);\n    assert_eq!(q.size, 3);\n    q.free();\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n    assert!(q.front().is_none());\n    assert!(q.back().is_none());\n    assert!(q.head.is_none());\n    assert!(q.tail.is_none());\n}\n\n#[test]\nfn test_free_empty_queue() {\n    let mut q: Queue<i32> = Queue::new();\n    q.free();\n    assert_eq!(q.size, 0);\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_push_after_free() {\n    let mut q: Queue<i32> = Queue::new();\n    q.push(1);\n    q.push(2);\n    q.free();\n    q.push(99);\n    assert_eq!(q.size, 1);\n    assert_eq!(*q.front().unwrap(), 99);\n    assert_eq!(*q.back().unwrap(), 99);\n}\n\n#[test]\nfn test_with_strings() {\n    let mut q: Queue<String> = Queue::new();\n    q.push(String::from(\"hello\"));\n    q.push(String::from(\"world\"));\n    assert_eq!(q.size, 2);\n    assert_eq!(q.front().unwrap(), \"hello\");\n    assert_eq!(q.back().unwrap(), \"world\");\n    assert_eq!(q.pop().unwrap(), \"hello\");\n    assert_eq!(q.pop().unwrap(), \"world\");\n    assert!(q.is_empty());\n}\n\n#[test]\nfn test_size_progression() {\n    let mut q: Queue<i32> = Queue::new();\n    assert_eq!(q.size, 0);\n    q.push(1);\n    assert_eq!(q.size, 1);\n    q.push(2);\n    assert_eq!(q.size, 2);\n    q.push(3);\n    assert_eq!(q.size, 3);\n    q.pop();\n    assert_eq!(q.size, 2);\n    q.pop();\n    assert_eq!(q.size, 1);\n    q.pop();\n    assert_eq!(q.size, 0);\n    q.pop(); // pop from empty - should not underflow\n    assert_eq!(q.size, 0);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":939,"cache_read_input_tokens":23610,"cache_creation":{"ephemeral_5m_input_tokens":939,"ephemeral_1h_input_tokens":0},"output_tokens":40,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e7575f60-260f-45a8-b8b5-86a1e6ba7415","uuid":"2ef2135f-7007-42cb-bfcd-091b825ffa93"}
