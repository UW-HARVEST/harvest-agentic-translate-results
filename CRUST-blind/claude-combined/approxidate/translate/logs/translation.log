,"+        }","+        i += m as usize;","+    }","+","+    tv.tv_usec = tm.tm_usec;","+    let tt = tm_to_time_t(&tm).unwrap_or(-1);","+    tv.tv_sec = tt;","+","+    if *off_ref == -1 {","+        let temp_time = mktime_local(&tm);","+        if tv.tv_sec > temp_time {","+            *off_ref = ((tv.tv_sec - temp_time) / 60) as i32;","+        } else {","+            *off_ref = -(((temp_time - tv.tv_sec) / 60) as i32);","+        }","+    }","+","+    if *off_ref == -1 {","+        let mt = mktime_local(&tm);","+        *off_ref = ((tv.tv_sec - mt) / 60) as i32;","+    }","+","+    if tv.tv_sec == -1 {","+        return -1;","+    }","+","+    if tm_gmt == 0 {","+        tv.tv_sec -= (*off_ref as i64) * 60;","+    }","+","+    0"," }","+","+// mktime equivalent using chrono::Local","+fn mktime_local(tm: &Atm) -> i64 {","+    // Year/mon/mday/hour/min/sec must be valid","+    let year = tm.tm_year + 1900;","+    let mon0 = tm.tm_mon;","+    let mday = tm.tm_mday;","+    let hour = tm.tm_hour;","+    let min = tm.tm_min;","+    let sec = tm.tm_sec;","+","+    if mon0 < 0 || mon0 > 11 || mday < 1 || mday > 31 || hour < 0 || hour > 23","+        || min < 0 || min > 59 || sec < 0 || sec > 60 || year < 1 {","+        return -1;","+    }","+","+    match Local.with_ymd_and_hms(year, (mon0 + 1) as u32, mday as u32, hour as u32, min as u32, sec as u32) {","+        chrono::offset::LocalResult::Single(dt) => dt.timestamp(),","+        chrono::offset::LocalResult::Ambiguous(dt, _) => dt.timestamp(),","+        chrono::offset::LocalResult::None => -1,","+    }","+}","+","+fn localtime_into(tm: &mut Atm, sec: i64) {","+    if let Some(dt) = Local.timestamp_opt(sec, 0).single() {","+        tm.tm_sec = dt.second() as i32;","+        tm.tm_min = dt.minute() as i32;","+        tm.tm_hour = dt.hour() as i32;","+        tm.tm_mday = dt.day() as i32;","+        tm.tm_mon = dt.month0() as i32;","+        tm.tm_year = (dt.year() - 1900) as i32;","+        tm.tm_wday = dt.weekday().num_days_from_sunday() as i32;","+        tm.tm_yday = dt.ordinal0() as i32;","+        // tm_isdst left as-is","+    }","+}","+"," pub fn update_tm(tm: &mut Atm, now: &mut Atm, sec: u64) -> u64 {","-    unimplemented!()","+    if tm.tm_mday < 0 {","+        tm.tm_mday = now.tm_mday;","+    }","+    if tm.tm_mon < 0 {","+        tm.tm_mon = now.tm_mon;","+    }","+    if tm.tm_year < 0 {","+        tm.tm_year = now.tm_year;","+        if tm.tm_mon > now.tm_mon {","+            tm.tm_year -= 1;","+        }","+    }","+","+    let n = mktime_local(tm) - sec as i64;","+    localtime_into(tm, n);","+    n as u64"," }","-pub fn date_now(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_now(tm: &mut Atm, now: &mut Atm, _num: &mut i32) {","+    update_tm(tm, now, 0);"," }","-pub fn date_yesterday(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_yesterday(tm: &mut Atm, now: &mut Atm, _num: &mut i32) {","+    update_tm(tm, now, 24 * 60 * 60);"," }","+"," pub fn date_time(tm: &mut Atm, now: &mut Atm, hour: i32) {","-    unimplemented!()","+    if tm.tm_hour < hour {","+        let mut dummy = 0;","+        date_yesterday(tm, now, &mut dummy);","+    }","+    tm.tm_hour = hour;","+    tm.tm_min = 0;","+    tm.tm_sec = 0;"," }","-pub fn date_midnight(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_midnight(tm: &mut Atm, now: &mut Atm, _num: &mut i32) {","+    date_time(tm, now, 0);"," }","-pub fn date_noon(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_noon(tm: &mut Atm, now: &mut Atm, _num: &mut i32) {","+    date_time(tm, now, 12);"," }","-pub fn date_tea(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_tea(tm: &mut Atm, now: &mut Atm, _num: &mut i32) {","+    date_time(tm, now, 17);"," }","-pub fn date_pm(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_pm(tm: &mut Atm, _now: &mut Atm, num: &mut i32) {","+    let n = *num;","+    *num = 0;","+","+    let mut hour = tm.tm_hour;","+    if n != 0 {","+        hour = n;","+        tm.tm_min = 0;","+        tm.tm_sec = 0;","+    }","+    tm.tm_hour = (hour % 12) + 12;"," }","-pub fn date_am(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_am(tm: &mut Atm, _now: &mut Atm, num: &mut i32) {","+    let n = *num;","+    *num = 0;","+","+    let mut hour = tm.tm_hour;","+    if n != 0 {","+        hour = n;","+        tm.tm_min = 0;","+        tm.tm_sec = 0;","+    }","+    tm.tm_hour = hour % 12;"," }","-pub fn date_never(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_never(tm: &mut Atm, _now: &mut Atm, _num: &mut i32) {","+    localtime_into(tm, 0);"," }","+"," pub struct Special {","     pub name: &'static str,","-    pub fn_ptr: fn(&mut Atm, &mut Atm, &mut i32), // Use function pointer","+    pub fn_ptr: fn(&mut Atm, &mut Atm, &mut i32),"," }","+"," pub static SPECIAL: &[Special] = &[","     Special { name: \"yesterday\", fn_ptr: date_yesterday },","     Special { name: \"noon\", fn_ptr: date_noon },"]},{"oldStart":159,"oldLines":27,"newStart":767,"newLines":16,"lines":["     Special { name: \"never\", fn_ptr: date_never },","     Special { name: \"now\", fn_ptr: date_now },"," ];","-// pub struct Special {","-//     pub name: &'static str,","-//     pub fn_ptr: fn(&mut Atm, TimeT, &mut i32),","-// }","-// pub const SPECIAL: &[Special] = &[","-//     Special { name: \"yesterday\", fn_ptr: date_yesterday },","-//     Special { name: \"noon\", fn_ptr: date_noon },","-//     Special { name: \"midnight\", fn_ptr: date_midnight },","-//     Special { name: \"tea\", fn_ptr: date_tea },","-//     Special { name: \"PM\", fn_ptr: date_pm },","-//     Special { name: \"AM\", fn_ptr: date_am },","-//     Special { name: \"never\", fn_ptr: date_never },","-//     Special { name: \"now\", fn_ptr: date_now },","-// ];","+"," pub const NUMBER_NAME: [&str; 11] = [","     \"zero\", \"one\", \"two\", \"three\", \"four\", \"five\", \"six\", \"seven\", \"eight\", \"nine\", \"ten\""," ];","+"," pub struct TypeLen {","     pub type_name: &'static str,","     pub length: i32,"," }","+"," pub const TYPELEN: &[TypeLen] = &[","     TypeLen { type_name: \"seconds\", length: 1 },","     TypeLen { type_name: \"minutes\", length: 60 },"]},{"oldStart":187,"oldLines":21,"newStart":784,"newLines":234,"lines":["     TypeLen { type_name: \"days\", length: 24 * 60 * 60 },","     TypeLen { type_name: \"weeks\", length: 7 * 24 * 60 * 60 },"," ];","+"," pub fn approxidate_alpha(date: &str, tm: &mut Atm, now: &mut Atm, num: &i32, touched: &i32) -> String {","-    unimplemented!()","+    // SAFETY: We need to mutate `num` and `touched` to match C semantics.","+    // Callers should pass `&local_var` where local_var is mutable.","+    let num_mut = unsafe { &mut *(num as *const i32 as *mut i32) };","+    let touched_mut = unsafe { &mut *(touched as *const i32 as *mut i32) };","+","+    let d = date.as_bytes();","+    // Find end of alpha run starting from index 1","+    let mut end_idx: usize = 1;","+    while end_idx < d.len() && is_alpha_byte(d[end_idx]) {","+        end_idx += 1;","+    }","+","+    // month names","+    for i in 0..12 {","+        let m = match_string(date, MONTH_NAMES[i]);","+        if m >= 3 {","+            tm.tm_mon = i as i32;","+            *touched_mut = 1;","+            return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+        }","+    }","+","+    // special","+    for s in SPECIAL.iter() {","+        let len = s.name.len();","+        if match_string(date, s.name) as usize == len {","+            (s.fn_ptr)(tm, now, num_mut);","+            *touched_mut = 1;","+            return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+        }","+    }","+","+    if *num_mut == 0 {","+        for i in 1..11 {","+            let len = NUMBER_NAME[i].len();","+            if match_string(date, NUMBER_NAME[i]) as usize == len {","+                *num_mut = i as i32;","+                *touched_mut = 1;","+                return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+            }","+        }","+        if match_string(date, \"last\") == 4 {","+            *num_mut = 1;","+            *touched_mut = 1;","+        }","+        return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+    }","+","+    // typelen","+    for tl in TYPELEN.iter() {","+        let len = tl.type_name.len();","+        if match_string(date, tl.type_name) as usize >= len - 1 {","+            update_tm(tm, now, (tl.length as u64) * (*num_mut as u64));","+            *num_mut = 0;","+            *touched_mut = 1;","+            return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+        }","+    }","+","+    // weekdays","+    for i in 0..7 {","+        let m = match_string(date, WEEKDAY_NAMES[i]);","+        if m >= 3 {","+            let mut n = *num_mut - 1;","+            *num_mut = 0;","+            let mut diff = tm.tm_wday - i as i32;","+            if diff <= 0 {","+                n += 1;","+            }","+            diff += 7 * n;","+            update_tm(tm, now, (diff as u64) * 24 * 60 * 60);","+            *touched_mut = 1;","+            return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+        }","+    }","+","+    if match_string(date, \"months\") >= 5 {","+        update_tm(tm, now, 0);","+        let mut n = tm.tm_mon - *num_mut;","+        *num_mut = 0;","+        while n < 0 {","+            n += 12;","+            tm.tm_year -= 1;","+        }","+        tm.tm_mon = n;","+        *touched_mut = 1;","+        return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+    }","+","+    if match_string(date, \"years\") >= 4 {","+        update_tm(tm, now, 0);","+        tm.tm_year -= *num_mut;","+        *num_mut = 0;","+        *touched_mut = 1;","+        return std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string();","+    }","+","+    std::str::from_utf8(&d[end_idx..]).unwrap_or(\"\").to_string()"," }","+"," pub fn approxidate_digit(date: &str, tm: &mut Atm, num: &i32, now: TimeT) -> String {","-    unimplemented!()","+    let num_mut = unsafe { &mut *(num as *const i32 as *mut i32) };","+    let d = date.as_bytes();","+    let (number, end_offset) = parse_uint(d);","+","+    if end_offset < d.len() {","+        let sep = d[end_offset];","+        if sep == b':' || sep == b'.' || sep == b'/' || sep == b'-' {","+            if end_offset + 1 < d.len() && is_digit_byte(d[end_offset + 1]) {","+                let end_str = std::str::from_utf8(&d[end_offset..]).unwrap_or(\"\");","+                let m = match_multi_number(number, sep as char, date, end_str, tm, now);","+                if m != 0 {","+                    return std::str::from_utf8(&d[m as usize..]).unwrap_or(\"\").to_string();","+                }","+            }","+        }","+    }","+","+    // Accept zero-padding only for small numbers","+    if d.is_empty() || d[0] != b'0' || end_offset <= 2 {","+        *num_mut = number as i32;","+    }","+    std::str::from_utf8(&d[end_offset..]).unwrap_or(\"\").to_string()"," }","+"," pub fn pending_number(tm: &mut Atm, num: &i32) {","-    unimplemented!()","+    let n = *num;","+    if n != 0 {","+        let num_mut = unsafe { &mut *(num as *const i32 as *mut i32) };","+        *num_mut = 0;","+        if tm.tm_mday < 0 && n < 32 {","+            tm.tm_mday = n;","+        } else if tm.tm_mon < 0 && n < 13 {","+            tm.tm_mon = n - 1;","+        } else if tm.tm_year < 0 {","+            if n > 1969 && n < 2100 {","+                tm.tm_year = n - 1900;","+            } else if n > 69 && n < 100 {","+                tm.tm_year = n;","+            } else if n < 38 {","+                tm.tm_year = 100 + n;","+  