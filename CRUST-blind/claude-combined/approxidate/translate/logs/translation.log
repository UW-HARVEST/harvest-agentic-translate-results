{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_bm32eabpnceqrmle5j34xdgc3o2cfrjmxl2ei7y7h25y2s2gapvq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01RXPTfXvQE9L77bjCME7ppW","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-Iblcoq/project/c_src/probe2.c","content":"#define _POSIX_C_SOURCE 200809L\n#include <stdio.h>\n#include <string.h>\n#include <time.h>\n\n// Copy of internal tm_to_time_t logic (replicated from approxidate.c)\nstruct atm {\n    int tm_sec, tm_min, tm_hour, tm_mday, tm_mon, tm_year, tm_wday, tm_yday, tm_isdst;\n    long tm_usec;\n};\n\nstatic time_t tm_to_time_t(const struct atm *tm)\n{\n    static const int mdays[] = {0,31,59,90,120,151,181,212,243,273,304,334};\n    int year = tm->tm_year - 70;\n    int month = tm->tm_mon;\n    int day = tm->tm_mday;\n    if (year < 0 || year > 129) return -1;\n    if (month < 0 || month > 11) return -1;\n    if (month < 2 || (year + 2) % 4) day--;\n    if (tm->tm_hour < 0 || tm->tm_min < 0 || tm->tm_sec < 0) return -1;\n    return (year*365 + (year+1)/4 + mdays[month] + day)*24*60*60UL +\n        tm->tm_hour*60*60 + tm->tm_min*60 + tm->tm_sec;\n}\n\nint main() {\n    // 1970-01-01 00:00:00\n    {\n        struct atm t = {0,0,0,1,0,70,0,0,0,0};\n        printf(\"epoch: %ld\\n\", (long)tm_to_time_t(&t));\n    }\n    // 2013-03-10 00:00:02 UTC\n    {\n        struct atm t = {2,0,0,10,2,113,0,0,0,0};\n        printf(\"mar10_2013: %ld\\n\", (long)tm_to_time_t(&t));\n    }\n    // negative year\n    {\n        struct atm t = {0,0,0,1,0,69,0,0,0,0};\n        printf(\"year69: %ld\\n\", (long)tm_to_time_t(&t));\n    }\n    // invalid month\n    {\n        struct atm t = {0,0,0,1,12,113,0,0,0,0};\n        printf(\"invalid_month: %ld\\n\", (long)tm_to_time_t(&t));\n    }\n    // negative seconds\n    {\n        struct atm t = {-1,0,0,1,0,113,0,0,0,0};\n        printf(\"invalid_sec: %ld\\n\", (long)tm_to_time_t(&t));\n    }\n    // 2000-02-29