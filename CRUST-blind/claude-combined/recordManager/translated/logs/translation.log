   }\n\n    let _ = close_table(&mut table);\n    let _ = delete_table(path);\n}\n\n#[test]\nfn test_get_record_invalid_slot() {\n    let path = \"/tmp/rm_test_invalid.bin\";\n    let _ = delete_table(path);\n    let s = make_test_schema();\n    let _ = create_table(path, &s);\n    let mut table = empty_table_data();\n    let _ = open_table(&mut table, path);\n\n    let mut rec_opt: Option<Record> = None;\n    let _ = create_record(&mut rec_opt, &s);\n    let mut got = rec_opt.unwrap();\n    let invalid = RID { page: 1, slot: 1_000_000 };\n    let rc = get_record(&table, &invalid, &mut got);\n    assert!(rc == RC::RecordNotFound);\n\n    let _ = close_table(&mut table);\n    let _ = delete_table(path);\n}\n\nfn main() {}\n","structuredPatch":[{"oldStart":305,"oldLines":6,"newStart":305,"newLines":15,"lines":["     let mut rec = from_test_record(&s, 7, \"zzzz\", 11);","     let _ = insert_record_mut(&mut table, &mut rec);","     let rid = rec.id.clone();","+    // Verify that we can read back the record before close","+    let mut rec_opt: Option<Record> = None;","+    let _ = create_record(&mut rec_opt, &s);","+    let mut got = rec_opt.unwrap();","+    let pre_rc = get_record(&table, &rid, &mut got);","+    let mut a_val_pre = Value { dt: DataType::DtInt, v: ValueUnion::IntV(0) };","+    let _ = get_attr(&got, &s, 0, &mut a_val_pre);","+    eprintln!(\"pre-close get_record rc = {:?}, a_val = {:?}\", pre_rc, a_val_pre.v);","+","     let close_rc = close_table(&mut table);","     eprintln!(\"close_table rc = {:?}\", close_rc);"," "]},{"oldStart":312,"oldLines":7,"newStart":321,"newLines":6,"lines":["     let open_rc = open_table(&mut table, path);","     eprintln!(\"open_table rc = {:?}\", open_rc);","     eprintln!(\"get_num_tuples = {}\", get_num_tuples(&table));","-    eprintln!(\"first_free_page_num expected: should be at least 2\");","     assert_eq!(get_num_tuples(&table), 1);","     let mut rec_opt: Option<Record> = None;","     let _ = create_record(&mut rec_