n get_attr_pos(schema: &Schema, attr_num: i32) -> i32 {\n    let mut attr_pos = 0i32;\n    for i in 0..attr_num as usize {\n        match schema.data_types[i] {\n            DataType::DtString => attr_pos += schema.type_length[i],\n            DataType::DtInt => attr_pos += 4,\n            DataType::DtFloat => attr_pos += 4,\n            DataType::DtBool => attr_pos += 1,\n        }\n    }\n    attr_pos\n}\n","structuredPatch":[{"oldStart":540,"oldLines":6,"newStart":540,"newLines":7,"lines":["     let mut page = tm.page_handler.take().unwrap_or(BM_PageHandle { page_num: -1, data: String::new() });","     let rc = pin_page(bm, &mut page, record.id.page);","     if rc != RC::Ok {","+        eprintln!(\"update_record: pin_page failed rc={:?}\", rc);","         tm.page_handler = Some(page);","         return RC::Error;","     }"]},{"oldStart":549,"oldLines":6,"newStart":550,"newLines":7,"lines":["     }","     let position = PAGE_HEADER_SIZE_PADDED + (record.id.slot as usize) * (tm.rec_size as usize + 2);","     if buf[position] != b'Y' {","+        eprintln!(\"update_record: slot marker at {} is {} (expected Y)\", position, buf[position]);","         let _ = unpin_page(bm, &mut page);","         tm.page_handler = Some(page);","         return RC::RecordNotFound;"]}],"userModified":false,"replaceAll":false}}
