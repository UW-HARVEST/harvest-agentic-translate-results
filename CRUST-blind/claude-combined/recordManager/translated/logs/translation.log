lueUnion::StringV(s)) => {\n            let len = schema.type_length[attr_idx] as usize;\n            let src = string_to_bytes(s);\n            for k in 0..len {\n                bytes[pos + k] = src.get(k).copied().unwrap_or(0);\n            }\n        }\n        (DataType::DtBool, ValueUnion::BoolV(b)) => {\n            bytes[pos] = if *b { 1 } else { 0 };\n        }\n        _ => {}\n    }\n    record.data = bytes_to_string(&bytes);\n    RC::Ok\n}\n\npub fn get_attr_pos(schema: &Schema, attr_num: i32) -> i32 {\n    let mut attr_pos = 0i32;\n    for i in 0..attr_num as usize {\n        match schema.data_types[i] {\n            DataType::DtString => attr_pos += schema.type_length[i],\n            DataType::DtInt => attr_pos += 4,\n            DataType::DtFloat => attr_pos += 4,\n            DataType::DtBool => attr_pos += 1,\n        }\n    }\n    attr_pos\n}\n","structuredPatch":[{"oldStart":304,"oldLines":8,"newStart":304,"newLines":8,"lines":["         Some(b) => b,","         None => return RC::Error,","     };","-    let cell = match tm_box.downcast_ref::<RefCell<TableManager>>() {","-        Some(c) => c,","+    let cell = match tm_box.downcast_ref::<Rc<RefCell<TableManager>>>() {","+        Some(c) => c.clone(),","         None => return RC::Error,","     };","     let mut tm = cell.borrow_mut();"]},{"oldStart":400,"oldLines":8,"newStart":400,"newLines":8,"lines":["         Some(b) => b,","         None => return RC::Error,","     };","-    let cell = match tm_box.downcast_ref::<RefCell<TableManager>>() {","-        Some(c) => c,","+    let cell = match tm_box.downcast_ref::<Rc<RefCell<TableManager>>>() {","+        Some(c) => c.clone(),","         None => return RC::Error,","     };","     let mut tm = cell.borrow_mut();"]}],"userModified":false,"replaceAll":true}}
