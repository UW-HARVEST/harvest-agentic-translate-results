{ 1 } else { 0 };\n        }\n        _ => {}\n    }\n    record.data = bytes_to_string(&bytes);\n    RC::Ok\n}\n\npub fn get_attr_pos(schema: &Schema, attr_num: i32) -> i32 {\n    let mut attr_pos = 0i32;\n    for i in 0..attr_num as usize {\n        match schema.data_types[i] {\n            DataType::DtString => attr_pos += schema.type_length[i],\n            DataType::DtInt => attr_pos += 4,\n            DataType::DtFloat => attr_pos += 4,\n            DataType::DtBool => attr_pos += 1,\n        }\n    }\n    attr_pos\n}\n","structuredPatch":[{"oldStart":290,"oldLines":7,"newStart":290,"newLines":7,"lines":[" pub fn get_num_tuples(rel: &RM_TableData) -> i32 {","     rel.mgmt_data","         .as_ref()","-        .and_then(|m| m.downcast_ref::<RefCell<TableManager>>())","+        .and_then(|m| m.downcast_ref::<Rc<RefCell<TableManager>>>())","         .map(|c| c.borrow().total_tuples)","         .unwrap_or(-1)"," }"]}],"userModified":false,"replaceAll":true}}
