ue(\"bt\")), \"true\", \"create Value true\");\n58\t\tASSERT_EQUALS_STRING(serializeValue(stringToValue(\"btrue\")), \"true\", \"create Value true\");\n59\t\n60\t\tTEST_DONE();\n61\t}\n62\t\n63\t// ************************************************************ \n64\tvoid\n65\ttestOperators (void)\n66\t{\n67\t\tValue *result;\n68\t\ttestName = \"test value comparison and boolean operators\";\n69\t\tMAKE_VALUE(result, DT_INT, 0);\n70\t\n71\t\t// equality\n72\t\tOP_TRUE(stringToValue(\"i10\"),stringToValue(\"i10\"), valueEquals, \"10 = 10\");\n73\t\tOP_FALSE(stringToValue(\"i9\"),stringToValue(\"i10\"), valueEquals, \"9 != 10\");\n74\t\tOP_TRUE(stringToValue(\"sHello World\"),stringToValue(\"sHello World\"), valueEquals, \"Hello World = Hello World\");\n75\t\tOP_FALSE(stringToValue(\"sHello Worl\"),stringToValue(\"sHello World\"), valueEquals, \"Hello Worl != Hello World\");\n76\t\tOP_FALSE(stringToValue(\"sHello Worl\"),stringToValue(\"sHello Wor\"), valueEquals, \"Hello Worl != Hello Wor\");\n77\t\n78\t\t// smaller\n79\t\tOP_TRUE(stringToValue(\"i3\"),stringToValue(\"i10\"), valueSmaller, \"3 < 10\");\n80\t\tOP_TRUE(stringToValue(\"f5.0\"),stringToValue(\"f6.5\"), valueSmaller, \"5.0 < 6.5\");\n81\t\n82\t\t// boolean\n83\t\tOP_TRUE(stringToValue(\"bt\"),stringToValue(\"bt\"), boolAnd, \"t AND t = t\");\n84\t\tOP_FALSE(stringToValue(\"bt\"),stringToValue(\"bf\"), boolAnd, \"t AND f = f\");\n85\t\n86\t\tOP_TRUE(stringToValue(\"bt\"),stringToValue(\"bf\"), boolOr, \"t OR f = t\");\n87\t\tOP_FALSE(stringToValue(\"bf\"),stringToValue(\"bf\"), boolOr, \"f OR f = f\");\n88\t\n89\t\tTEST_CHECK(boolNot(stringToValue(\"bf\"), result));\n90\t\tASSERT_TRUE(result->v.boolV, \"!f = t\");\n91\t\n92\t\tTEST_DONE();\n93\t}\n94\t\n95\t// ************************************************************\n96\tvoid\n97\ttestExpressions (void)\n98\t{\n99\t\tExpr *op, *l, *r;\n100\t\tValue *res;\n101\t\ttestName = \"test complex expressions\";\n102\t\n103\t\tMAKE_CONS(l, stringToValue(\"i10\"));\n104\t\tevalExpr(NULL, NULL, l, &res);\n105\t\tOP_TRUE(stringToValue(\"i10\"), res, valueEquals, \"Const 10\");\n106\t\n107\t\tMAKE_CONS(r, stringToValue(\"i20\"));\n108\t\tevalExpr(NULL, NULL, r, &res);\n109\t\tOP_TRUE(stringToValue(\"i20\"), res, valueEquals, \"Const 20\");\n110\t\n111\t\tMAKE_BINOP_EXPR(op, l, r, OP_COMP_SMALLER);\n112\t\tevalExpr(NULL, NULL, op, &res);\n113\t\tOP_TRUE(stringToValue(\"bt\"), res, valueEquals, \"Const 10 < Const 20\");\n114\t\n115\t\tMAKE_CONS(l, stringToValue(\"bt\"));\n116\t\tevalExpr(NULL, NULL, l, &res);\n117\t\tOP_TRUE(stringToValue(\"bt\"), res, valueEquals, \"Const true\");\n118\t\n119\t\tr = op;\n120\t\tMAKE_BINOP_EXPR(op, r, l, OP_BOOL_AND);\n121\t\tevalExpr(NULL, NULL, op, &res);\n122\t\tOP_TRUE(stringToValue(\"bt\"), res, valueEquals, \"(Const 10 < Const 20) AND true\");\n123\t\n124\t\tTEST_DONE();\n125\t}\n126\t"}]},"parent_tool_use_id":null,"session_id":"6fb3a7c0-2555-4272-82ef-d11ca31bfd8b","uuid":"ae930ab9-8007-4398-9a86-f1d2b6075af0","timestamp":"2026-06-01T13:02:31.855Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-bprjWC/project/c_src/test_expr.c","content":"#include \"dberror.h\"\n#include \"expr.h\"\n#include \"record_mgr.h\"\n#include \"tables.h\"\n#include \"test_helper.h\"\n\n// helper macros\n#define OP_TRUE(left, right, op, message)\t\t\\\n\t\tdo {\t\t\t\t\t\t\t\\\n\t\t\tValue *result;\t\t\t\t\t\\\n\t\t\tMAKE_VALUE(result, DT_INT, -1);\t\t\t\\\n\t\t\top(left, right, result);\t\t\t\t\\\n\t\t\tbool b = result->v.boolV;\t\t\t\t\\\n\t\t\tfree(result);\t\t\t\t\t\\\n\t\t\tASSERT_TRUE(b,message);\t\t\t\t\\\n\t\t} while (0)\n\n#define OP_FALSE(left, right, op, message)\t\t\\\n\t\tdo {\t\t\t\t\t\t\t\\\n\t\t\tValue *result;\t\t\t\t\t\\\n\t\t\tMAKE_VALUE(result, DT_INT, -1);\t\t\t\\\n\t\t\top(left, right, result);\t\t\t\t\\\n\t\t\tbool b = result->v.boolV;\t\t\t\t\\\n\t\t\tfree(result);\t\t\t\t\t\\\n\t\t\tASSERT_TRUE(!b,message);\t\t\t\t\\\n\t\t} while (0)\n\n// test methods\nstatic void testValueSerialize (void);\nstatic void testOperators (void);\nstatic void testExpressions (void);\n\nchar *testName;\n\n// main method\nint \nmain (void) \n{\n\ttestName = \"\";\n\n\ttestValueSerialize();\n\ttestOperators();\n\ttestExpressions();\n\n\treturn 0;\n}\n\n// ************************************************************ \nvoid\ntestValueSerialize (void)\n{\n\ttestName = \"test value serialization and deserialization\";\n\n\tASSERT_EQUALS_STRING(serializeValue(stringToValue(\"i10\")), \"10\", \"create Value 10\");\n\tASSERT_EQUALS_STRING(serializeValue(stringToValue(\"f5.3\")), \"5.300000\", \"create Value 5.3\");\n\tASSERT_EQUALS_STRING(serializeValue(stringToValue(\"sHello World\")), \"Hello World\", \"create Value Hello World\");\n\tASSERT_EQUALS_STRING(serializeValue(stringToValue(\"bt\")), \"true\", \"create Value true\");\n\tASSERT_EQUALS_STRING(serializeValue(stringToValue(\"btrue\")), \"true\", \"create Value true\");\n\n\tTEST_DONE();\n}\n\n// ************************************************************ \nvoid\ntestOperators (void)\n{\n\tValue *result;\n\ttestName = \"test value comparison and boolean operators\";\n\tMAKE_VALUE(result, DT_INT, 0);\n\n\t// equality\n\tOP_TRUE(stringToValue(\"i10\"),stringToValue(\"i10\"), valueEquals, \"10 = 10\");\n\tOP_FALSE(stringToValue(\"i9\"),stringToValue(\"i10\"), valueEquals, \"9 != 10\");\n\tOP_TRUE(stringToValue(\"sHello World\"),stringToValue(\"sHello World\"), valueEquals, \"Hello World = Hello World\");\n\tOP_FALSE(stringToValue(\"sHello Worl\"),stringToValue(\"sHello World\"), valueEquals, \"Hello Worl != Hello World\");\n\tOP_FALSE(stringToValue(\"sHello Worl\"),stringToValue(\"sHello Wor\"), valueEquals, \"Hello Worl != Hello Wor\");\n\n\t// smaller\n\tOP_TRUE(stringToValue(\"i3\"),stringToValue(\"i10\"), valueSmaller, \"3 < 10\");\n\tOP_TRUE(stringToValue(\"f5.0\"),stringToValue(\"f6.5\"), valueSmaller, \"5.0 < 6.5\");\n\n\t// boolean\n\tOP_TRUE(stringToValue(\"bt\"),stringToValue(\"bt\"), boolAnd, \"t AND t = t\");\n\tOP_FALSE(stringToValue(\"bt\"),stringToValue(\"bf\"), boolAnd, \"t AND f = f\");\n\n\tOP_TRUE(stringToValue(\"bt\"),stringToValue(\"bf\"), boolOr, \"t OR f = t\");\n\tOP_FALSE(stringToValue(\"bf\"),stringToValue(\"bf\"), boolOr, \"f OR f = f\");\n\n\tTEST_CHECK(boolNot(stringToValue(\"bf\"), result));\n\tASSERT_TRUE(result->v.boolV, \"!f = t\");\n\n\tTEST_DONE();\n}\n\n// ************************************************************\nvoid\ntestExpressions (void)\n{\n\tExpr *op, *l, *r;\n\tValue *res;\n\ttestName = \"test complex expressions\";\n\n\tMAKE_CONS(l, stringToValue(\"i10\"));\n\tevalExpr(NULL, NULL, l, &res);\n\tOP_TRUE(stringToValue(\"i10\"), res, valueEquals, \"Const 10\");\n\n\tMAKE_CONS(r, stringToValue(\"i20\"));\n\tevalExpr(NULL, NULL, r, &res);\n\tOP_TRUE(stringToValue(\"i20\"), res, valueEquals, \"Const 20\");\n\n\tMAKE_BINOP_EXPR(op, l, r, OP_COMP_SMALLER);\n\tevalExpr(NULL, NULL, op, &res);\n\tOP_TRUE(stringToValue(\"bt\"), res, valueEquals, \"Const 10 < Const 20\");\n\n\tMAKE_CONS(l, stringToValue(\"bt\"));\n\tevalExpr(NULL, NULL, l, &res);\n\tOP_TRUE(stringToValue(\"bt\"), res, valueEquals, \"Const true\");\n\n\tr = op;\n\tMAKE_BINOP_EXPR(op, r, l, OP_BOOL_AND);\n\tevalExpr(NULL, NULL, op, &res);\n\tOP_TRUE(stringToValue(\"bt\"), res, valueEquals, \"(Const 10 < Const 20) AND true\");\n\n\tTEST_DONE();\n}\n","numLines":126,"startLine":1,"totalLines":126}}}
