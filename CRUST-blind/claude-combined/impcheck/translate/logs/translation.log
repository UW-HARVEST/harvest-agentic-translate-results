ration in get_or_create_id assign a","-    // fresh id. To preserve the old id, we explicitly insert here.","-    register_id_for_data_impl(addr, id);","-}","-","-fn register_id_for_data_impl(addr: usize, id: u64) {","-    use std::sync::OnceLock;","-    // Match the same OnceLock used in get_or_create_id by using the same path.","-    // We can't reach into the OnceLock declared inside another function. Instead,","-    // we declare a separate registry here and check it first in get_or_create_id.","-    static EXTRA: OnceLock<Mutex<HashMap<usize, u64>>> = OnceLock::new();","-    let m = EXTRA.get_or_init(|| Mutex::new(HashMap::new()));","-    m.lock().unwrap().insert(addr, id);","-}"]}],"originalFile":"use std::any::Any;\nuse std::collections::HashMap;\nuse std::sync::Mutex;\n\npub struct HashTableEntry<'a, T> {\n    pub key: u64,\n    pub val: &'a mut [T],\n}\n\npub struct HashTable<'a, T> {\n    pub size: u64,\n    pub max_size: u64,\n    pub growth_factor: f32,\n    pub capacity: u64,\n    pub data: &'a mut [HashTableEntry<'a, T>],\n    pub last_found_idx: u64,\n}\n\n// Global side storage for Box<dyn Any> values.\n// Each table has a unique ID, and each (table_id, key) maps to a stored value.\nfn next_table_id() -> u64 {\n    use std::sync::atomic::{AtomicU64, Ordering};\n    static NEXT_ID: AtomicU64 = AtomicU64::new(1);\n    NEXT_ID.fetch_add(1, Ordering::SeqCst)\n}\n\nfn storage() -> &'static Mutex<HashMap<u64, HashMap<u64, Box<dyn Any + Send + Sync>>>> {\n    use std::sync::OnceLock;\n    static STORAGE: OnceLock<Mutex<HashMap<u64, HashMap<u64, Box<dyn Any + Send + Sync>>>>> =\n        OnceLock::new();\n    STORAGE.get_or_init(|| Mutex::new(HashMap::new()))\n}\n\n// We encode the table_id into last_found_idx's upper bits when uninitialized?\n// Better: stash table id in `growth_factor` bits? No, must keep growth_factor=2.\n// Use a separate static map from address-of-data-slice to id.\n\nfn get_or_create_id<T>(ht: &HashTable<T>) -> u64 {\n    use std::sync::OnceLock;\n    static ID_MAP: OnceLock<Mutex<HashMap<usize, u64>>> = OnceLock::new();\n    let m = ID_MAP.get_or_init(|| Mutex::new(HashMap::new()));\n    let key = ht.data.as_ptr() as usize;\n    let mut g = m.lock().unwrap();\n    if let Some(&id) = g.get(&key) {\n        id\n    } else {\n        let id = next_table_id();\n        g.insert(key, id);\n        id\n    }\n}\n\nimpl<T: 'static> HashTable<'_, T> {\n    pub fn new(log_init_capacity: i32) -> Self {\n        let capacity: u64 = 1u64 << log_init_capacity;\n        let cap = capacity as usize;\n\n        // Build a Vec<HashTableEntry<T>> with empty entries\n        // val is &mut [T] - we use a leaked empty slice\n        let mut entries: Vec<HashTableEntry<'static, T>> = Vec::with_capacity(cap);\n        for _ in 0..cap {\n            let empty: &'static mut [T] = Box::leak(Vec::<T>::new().into_boxed_slice());\n            entries.push(HashTableEntry {\n                key: 0,\n                val: empty,\n            });\n        }\n        let boxed = entries.into_boxed_slice();\n        let leaked: &'static mut [HashTableEntry<'static, T>] = Box::leak(boxed);\n        // Transmute the lifetime to match return type\n        let data: &'_ mut [HashTableEntry<'_, T>] = unsafe { std::mem::transmute(leaked) };\n\n        let ht = HashTable {\n            size: 0,\n            max_size: capacity >> 1,\n            growth_factor: 2.0,\n            capacity,\n            data,\n            last_found_idx: 0,\n        };\n        // initialize storage entry\n        let id = get_or_create_id(&ht);\n        storage().lock().unwrap().entry(id).or_insert_with(HashMap::new);\n        ht\n    }\n\n    pub fn realloc_table(&mut self) -> bool {\n        let new_capacity = (self.growth_factor * (self.capacity as f32)) as u64;\n        let new_cap = new_capacity as usize;\n        let old_cap = self.capacity as usize;\n\n        // Save existing entries\n        let mut old_entries: Vec<(u64, ())> = Vec::with_capacity(old_cap);\n        for i in 0..old_cap {\n            old_entries.push((self.data[i].key, ()));\n        }\n\n        // Build new data\n        let mut entries: Vec<HashTableEntry<'static, T>> = Vec::with_capacity(new_cap);\n        for _ in 0..new_cap {\n            let empty: &'static mut [T] = Box::leak(Vec::<T>::new().into_boxed_slice());\n            entries.push(HashTableEntry {\n                key: 0,\n                val: empty,\n            });\n        }\n        let boxed = entries.into_boxed_slice();\n        let leaked: &'static mut [HashTableEntry<'static, T>] = Box::leak(boxed);\n        let new_data: &'_ mut [HashTableEntry<'_, T>] = unsafe { std::mem::transmute(leaked) };\n\n        // Update IDs in storage: register new pointer\n        let old_id = get_or_create_id(self);\n        // assign same id to new pointer\n        {\n            use std::sync::OnceLock;\n            // Re-fetch the same map used in get_or_create_id\n            // Already have ID_MAP via that function; reuse via fresh lookup\n            let _: &'static OnceLock<()> = &OnceLock::new();\n        }\n        // Insert mapping for new data ptr into the same id_map\n        {\n            // Reuse ID_MAP: re-implement\n        }\n\n        self.data = new_data;\n        self.size = 0;\n        self.max_size = (self.growth_factor * (self.max_size as f32)) as u64;\n        self.capacity = new_capacity;\n\n        // reassociate id with new pointer\n        register_id_for_data(self.data.as_ptr() as usize, old_id);\n\n        // Reinsert old entries (only their keys; values remain in storage keyed by id+key)\n        for (k, _) in old_entries.into_iter() {\n            if k != 0 {\n                if !self.reinsert_key(k) {\n                    return false;\n                }\n            }\n        }\n        true\n    }\n\n    fn reinsert_key(&mut self, key: u64) -> bool {\n        let mut idx: u64 = 0;\n        if Self::find_entry(self, key, &mut idx) {\n            return false;\n        }\n        if !Self::cell_empty(&self.data[idx as usize]) {\n            return false;\n        }\n        self.data[idx as usize].key = key;\n        self.size += 1;\n        true\n    }\n\n    pub fn hash_table_find(&self, key: u64) -> Option<&Box<dyn std::any::Any>> {\n        let mut idx: u64 = 0;\n        if !Self::find_entry(self, key, &mut idx) {\n            return None;\n        }\n        // safe: mutate last_found_idx via interior mutability hack\n        // Self is &self, but last_found_idx is normally pub. We use unsafe to mutate.\n        unsafe {\n            let p = &self.last_found_idx as *const u64 as *mut u64;\n            *p = idx;\n        }\n        let id = get_or_create_id(self);\n        let g = storage().lock().unwrap();\n        let table = g.get(&id)?;\n        if table.contains_key(&key) {\n            // we need to return &Box<dyn Any>, but our storage is Box<dyn Any+Send+Sync>\n            // Use leak/transmute to return reference\n            let bx = table.get(&key).unwrap();\n            // The reference's lifetime is tied to the lock; we need to return safely.\n            // We'll leak: get_static_ref keyed by (id, key)\n            let r: *const Box<dyn Any + Send + Sync> = bx as *const _;\n            let r: &'static Box<dyn Any + Send + Sync> = unsafe { &*r };\n            // Box<dyn Any+Send+Sync> coerces to Box<dyn Any> trivially? Not as a reference.\n            // Treat &Box<dyn Any+Send+Sync> as &Box<dyn Any> via transmute.\n            let r2: &'static Box<dyn Any> = unsafe { std::mem::transmute(r) };\n            // SAFETY: we deliberately leak the lock too via mem::forget\n            std::mem::forget(g);\n            Some(r2)\n        } else {\n            None\n        }\n    }\n\n    pub fn hash_table_delete(&mut self, key: u64) -> bool {\n        let mut idx: u64 = 0;\n        if !Self::find_entry(self, key, &mut idx) {\n            return false;\n        }\n        if !Self::handle_gap(self, idx) {\n            return false;\n        }\n        let id = get_or_create_id(self);\n        storage().lock().unwrap().get_mut(&id).map(|m| m.remove(&key));\n        self.size -= 1;\n        true\n    }\n\n    pub fn compute_idx(&self, key: u64) -> u64 {\n        Self::compute_hash(key) & (self.capacity - 1)\n    }\n\n    pub fn hash_table_insert(&mut self, key: u64, val: Box<dyn std::any::Any>) -> bool {\n        if key == 0 {\n            return false;\n        }\n        if self.size == self.max_size {\n            if !Self::realloc_table(self) {\n                return false;\n            }\n            if self.size >= self.max_size {\n                return false;\n            }\n        }\n        let mut idx: u64 = 0;\n        if Self::find_entry(self, key, &mut idx) {\n            return false;\n        }\n        if !Self::cell_empty(&self.data[idx as usize]) {\n            return false;\n        }\n        self.data[idx as usize].key = key;\n        self.size += 1;\n\n        // Save val into storage. We need Box<dyn Any+Send+Sync>.\n        // We can't safely require Send+Sync. Use !Send variant via Mutex<HashMap<u64, ...>> ?\n        // Workaround: convert via Box::into_raw and store as raw pointer\n        let raw = Box::into_raw(val) as usize;\n        let id = get_or_create_id(self);\n        let stored: Box<dyn Any + Send + Sync> = Box::new(RawHolder(raw));\n        storage()\n            .lock()\n            .unwrap()\n            .entry(id)\n            .or_insert_with(HashMap::new)\n            .insert(key, stored);\n        true\n    }\n\n    pub fn compute_hash(key: u64) -> u64 {\n        (0xcbf29ce484222325u64 ^ key).wrapping_mul(0x00000100000001B3u64)\n    }\n\n    pub fn cell_empty(entry: &HashTableEntry<T>) -> bool {\n        entry.key == 0\n    }\n\n    pub fn hash_table_free(&mut self) {\n        // Free internal data box\n        let cap = self.capacity as usize;\n        if cap > 0 {\n            let ptr = self.data.as_mut_ptr();\n           