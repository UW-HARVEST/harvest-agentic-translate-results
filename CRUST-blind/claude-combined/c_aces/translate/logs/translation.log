"channel(5,27,1): p=%lu q=%lu w=%lu\\n\", ch.p, ch.q, ch.w);","+","+    init_channel(&ch, 5, 30, 1); // 25<30 but coprime gcd(5,30)=5, so use (5+1)^2=36","+    printf(\"channel(5,30,1): p=%lu q=%lu w=%lu\\n\", ch.p, ch.q, ch.w);","+","+    // matrix2d_eye","+    {","+        Matrix2D m;","+        m.dim = 3;","+        uint64_t d[9] = {1,2,3,4,5,6,7,8,9};","+        m.data = d;","+        matrix2d_eye(&m);","+        printf(\"eye: \");","+        for (int i = 0; i < 9; i++) printf(\"%lu \", d[i]);","+        printf(\"\\n\");","+    }","+","     return 0;"," }"]}],"originalFile":"#include \"src/include/Common.h\"\n#include \"src/include/Polynomial.h\"\n#include \"src/include/Channel.h\"\n#include <stdio.h>\n\nint main(void) {\n    // Verify xgcd cases\n    Xgcd r = xgcd(7, 7);\n    printf(\"xgcd(7,7): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    r = xgcd(2, 2);\n    printf(\"xgcd(2,2): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    r = xgcd(1, 1);\n    printf(\"xgcd(1,1): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    r = xgcd(1, 2);\n    printf(\"xgcd(1,2): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    r = xgcd(5, 6);\n    printf(\"xgcd(5,6): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    r = xgcd(19, 13);\n    printf(\"xgcd(19,13): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    r = xgcd(35, 15);\n    printf(\"xgcd(35,15): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    r = xgcd(0, 5);\n    printf(\"xgcd(0,5): gcd=%lu a=%ld b=%ld\\n\", r.gcd, r.a, r.b);\n\n    return 0;\n}\n","userModified":false}}
