al, 0 otherwise.\n54\t */\n55\tint poly_equal(const Polynomial *, const Polynomial *);\n56\t\n57\t/**\n58\t * @brief Free memory allocated for a polynomial.\n59\t *\n60\t * This function releases the memory allocated for the coefficients array of a\n61\t * polynomial.\n62\t *\n63\t * @param poly Pointer to the polynomial to be freed.\n64\t */\n65\tvoid poly_free(Polynomial *poly);\n66\t\n67\t/**\n68\t * @brief Set coefficients for a polynomial.\n69\t *\n70\t * This function sets the coefficients for a given polynomial structure.\n71\t *\n72\t * @param p Pointer to the polynomial structure.\n73\t * @param coeffs Pointer to an array of coefficients.\n74\t * @param size Size of the coefficients array.\n75\t *\n76\t * @return 0 if successful, -1 if an error occurred.\n77\t */\n78\tint set_polynomial(Polynomial *p, Coeff *coeffs, size_t size);\n79\t\n80\t/**\n81\t * @brief Allocate memory for a polynomial using malloc.\n82\t *\n83\t * This function allocates memory for a polynomial structure using malloc.\n84\t *\n85\t * @param p Pointer to the polynomial structure.\n86\t * @param size Size of the polynomial.\n87\t *\n88\t * @return 0 if successful, -1 if an error occurred.\n89\t */\n90\tint get_polynomial(Polynomial *p, size_t size);\n91\t\n92\tint get_polyarray(PolyArray *p, size_t size);\n93\t\n94\t/**\n95\t * @brief Set all coefficients of a polynomial to zero.\n96\t *\n97\t * This function sets all coefficients of a given polynomial to zero.\n98\t *\n99\t * @param p Pointer to the polynomial structure.\n100\t *\n101\t * @return 0 if successful, -1 if an error occurred.\n102\t */\n103\tint set_zero(const Polynomial *p);\n104\t\n105\t/**\n106\t * @brief Calculate the sum of coefficients in a polynomial.\n107\t *\n108\t * This function calculates the sum of all coefficients in the given polynomial.\n109\t *\n110\t * @param poly Pointer to the polynomial structure.\n111\t *\n112\t * @return The sum of coefficients in the polynomial.\n113\t */\n114\tint64_t coef_sum(const Polynomial *poly);\n115\t\n116\t/**\n117\t * @brief Calculate the degree of a polynomial.\n118\t *\n119\t * This function calculates the degree of the given polynomial.\n120\t *\n121\t * @param poly Pointer to the polynomial structure.\n122\t *\n123\t * @return The degree of the polynomial.\n124\t */\n125\tuint64_t poly_degree(const Polynomial *poly);\n126\t\n127\t/**\n128\t * @brief Fit polynomial to a specified modulus and remove leading zeros.\n129\t *\n130\t * This function adjusts the coefficients of the polynomial to fit within the\n131\t * specified modulus and removes leading zeros from the highest degrees (left of\n132\t * array).\n133\t *\n134\t * @param poly Pointer to the polynomial structure.\n135\t * @param mod The modulus to fit the coefficients within.\n136\t *\n137\t * @return 0 if successful, -1 if an error occurred.\n138\t */\n139\tint poly_fit(Polynomial *poly, uint64_t mod);\n140\t\n141\t/**\n142\t * @brief Multiply two polynomials and store the result.\n143\t *\n144\t * This function multiplies two polynomials and stores the result in the\n145\t * provided result polynomial, applying the specified modulus to each\n146\t * coefficient.\n147\t *\n148\t * @param poly1 Pointer to the first polynomial.\n149\t * @param poly2 Pointer to the second polynomial.\n150\t * @param result Pointer to the polynomial structure to store the result.\n151\t * @param mod The modulus to apply to each coefficient.\n152\t *\n153\t * @return 0 if successful, -1 if an error occurred.\n154\t */\n155\tint poly_mul(const Polynomial *poly1, const Polynomial *poly2,\n156\t             Polynomial *result, uint64_t mod);\n157\t\n158\t/**\n159\t * @brief Add two polynomials and store the result.\n160\t *\n161\t * This function adds two polynomials and stores the result in the provided\n162\t * result polynomial, applying the specified modulus to each coefficient.\n163\t *\n164\t * @param poly1 Pointer to the first polynomial.\n165\t * @param poly2 Pointer to the second polynomial.\n166\t * @param result Pointer to the polynomial structure to store the result.\n167\t * @param mod The modulus to apply to each coefficient.\n168\t *\n169\t * @return 0 if successful, -1 if an error occurred.\n170\t */\n171\tint poly_add(const Polynomial *poly1, const Polynomial *poly2,\n172\t             Polynomial *result, uint64_t mod);\n173\t\n174\t/**\n175\t * @brief Subtract one polynomial from another and store the result.\n176\t *\n177\t * This function subtracts the second polynomial from the first polynomial and\n178\t * stores the result in the provided result polynomial, applying the specified\n179\t * modulus to each coefficient.\n180\t *\n181\t * @param poly1 Pointer to the first polynomial.\n182\t * @param poly2 Pointer to the second polynomial.\n183\t * @param result Pointer to the polynomial structure to store the result.\n184\t * @param mod The modulus to apply to each coefficient.\n185\t *\n186\t * @return 0 if successful, -1 if an error occurred.\n187\t */\n188\tint poly_sub(const Polynomial *poly1, const Polynomial *poly2,\n189\t             Polynomial *result, uint64_t mod);\n190\t\n191\t/**\n192\t * @brief Left shift one polynomial by another and store the result.\n193\t *\n194\t * This function left shifts the first polynomial by the second polynomial and\n195\t * stores the result in the provided result polynomial, applying the specified\n196\t * modulus to each coefficient.\n197\t *\n198\t * @param poly1 Pointer to the first polynomial.\n199\t * @param poly2 Pointer to the second polynomial.\n200\t * @param result Pointer to the polynomial structure to store the result.\n201\t * @param mod The modulus to apply to each coefficient.\n202\t *\n203\t * @return 0 if successful, -1 if an error occurred.\n204\t */\n205\tint poly_lshift(const Polynomial *poly1, const Polynomial *poly2,\n206\t                Polynomial *result, uint64_t mod);\n207\t\n208\t/**\n209\t * @brief Compute the modulus of a polynomial.\n210\t *\n211\t * This function