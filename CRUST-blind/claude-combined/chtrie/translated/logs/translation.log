"); return 1; }\n\n    printf(\"ecap=%d maxn=%d alphsz=%d idxmax=%d\\n\", tr->ecap, tr->maxn, tr->alphsz, tr->idxmax);\n\n    // Insert from 0 with sym 'a'(0..)\n    int r1 = chtrie_walk(tr, 0, 0, 1);\n    int r2 = chtrie_walk(tr, 0, 1, 1);\n    int r3 = chtrie_walk(tr, r1, 0, 1);\n    int r4 = chtrie_walk(tr, r1, 1, 1);\n    int r5 = chtrie_walk(tr, r2, 2, 1);\n    printf(\"r1=%d r2=%d r3=%d r4=%d r5=%d\\n\", r1, r2, r3, r4, r5);\n    printf(\"idxmax=%d\\n\", tr->idxmax);\n\n    // Lookup\n    int q1 = chtrie_walk(tr, 0, 0, 0);\n    int q2 = chtrie_walk(tr, 0, 99, 0);\n    printf(\"q1=%d q2=%d\\n\", q1, q2);\n\n    // Delete and re-create\n    chtrie_del(tr, 0, 1); // remove edge to r2\n    int r6 = chtrie_walk(tr, 0, 5, 1); // should reuse r2's slot\n    printf(\"after del r2 then add new: r6=%d (expected reuse %d)\\n\", r6, r2);\n    printf(\"idxmax=%d\\n\", tr->idxmax);\n\n    // Delete non-existent\n    chtrie_del(tr, 0, 99);\n    printf(\"after no-op del idxmax=%d\\n\", tr->idxmax);\n\n    // Insertion limit test\n    chtrie *t2 = chtrie_alloc(3, 4);\n    printf(\"t2 ecap=%d maxn=%d\\n\", t2->ecap, t2->maxn);\n    int a = chtrie_walk(t2, 0, 0, 1); // ok\n    int b = chtrie_walk(t2, 0, 1, 1); // ok\n    int c = chtrie_walk(t2, 0, 2, 1); // should fail (maxn=3, indexes 0,1,2 used)\n    printf(\"a=%d b=%d c=%d\\n\", a, b, c);\n    chtrie_free(tr);\n    chtrie_free(t2);\n\n    // Edge case: alloc with 0 args -> normalized to (1,1), ecap=0\n    chtrie *t3 = chtrie_alloc(0, 0);\n    printf(\"t3 maxn=%d alphsz=%d ecap=%d idxmax=%d\\n\", t3->maxn, t3->alphsz, t3->ecap, t3->idxmax);\n    chtrie_free(t3);\n\n    // Alloc with 1, 1\n    chtrie *t4 = chtrie_alloc(1, 1);\n    printf(\"t4 maxn=%d alphsz=%d ecap=%d\\n\", t4->maxn, t4->alphsz, t4->ecap);\n    chtrie_free(t4);\n\n    // Alloc with 2,2: ecap = 1\n    chtrie *t6 = chtrie_alloc(2, 2);\n    printf(\"t6 maxn=%d alphsz=%d ecap=%d\\n\", t6->maxn, t6->alphsz, t6->ecap);\n    int t6r = chtrie_walk(t6, 0, 0, 1);\n    printf(\"t6 walk 0,0,creat: %d\\n\", t6r);\n    int t6r2 = chtrie_walk(t6, 0, 1, 1); // should fail (limit reached)\n    printf(\"t6 walk 0,1,creat (should fail): %d\\n\", t6r2);\n    chtrie_free(t6);\n\n    // Test walks without create\n    chtrie *t5 = chtrie_alloc(10, 5);\n    int w = chtrie_walk(t5, 0, 3, 0); // should be -1\n    printf(\"walk without create: w=%d\\n\", w);\n    chtrie_free(t5);\n\n    // Collision test: chtrie_alloc(8, 3) -> ecap=9\n    chtrie *t7 = chtrie_alloc(8, 3);\n    printf(\"t7 ecap=%d\\n\", t7->ecap);\n    int n00 = chtrie_walk(t7, 0, 0, 1);\n    int n01 = chtrie_walk(t7, 0, 1, 1);\n    int n02 = chtrie_walk(t7, 0, 2, 1);\n    int n30 = chtrie_walk(t7, n02, 0, 1); // Insert (3, 0) -> h=0 collides with (0,0)\n    printf(\"n00=%d n01=%d n02=%d n30=%d\\n\", n00, n01, n02, n30);\n\n    // Lookups\n    printf(\"lookup (0,0)=%d (3,0)=%d\\n\", chtrie_walk(t7, 0, 0, 0), chtrie_walk(t7, n02, 0, 0));\n\n    // Delete (0,0) - head of chain, will lose (3,0) edge per C semantics\n    chtrie_del(t7, 0, 0);\n    printf(\"after del head (0,0): lookup (0,0)=%d (3,0)=%d\\n\",\n        chtrie_walk(t7, 0, 0, 0), chtrie_walk(t7, n02, 0, 0));\n\n    chtrie_free(t7);\n\n    // Collision test again, delete non-head\n    chtrie *t8 = chtrie_alloc(8, 3);\n    int m00 = chtrie_walk(t8, 0, 0, 1);\n    int m01 = chtrie_walk(t8, 0, 1, 1);\n    int m02 = chtrie_walk(t8, 0, 2, 1);\n    int m30 = chtrie_walk(t8, m02, 0, 1);\n    printf(\"t8: m00=%d m01=%d m02=%d m30=%d\\n\", m00, m01, m02, m30);\n\n    // Delete (3,0) which is the tail (added later, becomes head). Wait - new node\n    // is inserted at HEAD of chain. So (3,0) is head, (0,0) is tail.\n    // Delete (0,0) - it's the tail, q is non-NULL.\n    chtrie_del(t8, 0, 0);\n    printf(\"after del tail (0,0): lookup (0,0)=%d (3,0)=%d\\n\",\n        chtrie_walk(t8, 0, 0, 0), chtrie_walk(t8, m02, 0, 0));\n\n    // Re-add (0, 0) - should reuse index\n    int m00b = chtrie_walk(t8, 0, 0, 1);\n    printf(\"re-create (0,0): %d (was %d)\\n\", m00b, m00);\n\n    chtrie_free(t8);\n\n    return 0;\n}\n","structuredPatch":[{"oldStart":107,"oldLines":5,"newStart":107,"newLines":31,"lines":[" ","     chtrie_free(t8);"," ","+    // Test head-deletion bug behavior","+    chtrie *t9 = chtrie_alloc(8, 3);","+    int p00 = chtrie_walk(t9, 0, 0, 1);  // h=0","+    int p02 = chtrie_walk(t9, 0, 2, 1);  // h=2","+    int p30 = chtrie_walk(t9, p02, 0, 1); // h=0, becomes head","+    printf(\"t9 idxmax_before_del=%d\\n\", t9->idxmax);","+    // Now bucket 0: head=(3,0)/p30, tail=(0,0)/p00","+    chtrie_del(t9, p02, 0);  // delete head","+    int look00 = chtrie_walk(t9, 0, 0, 0); // tail also destroyed in C","+    int look30 = chtrie_walk(t9, p02, 0, 0);","+    printf(\"after del head (3,0): (0,0) look=%d, (3,0) look=%d\\n\", look00, look30);","+","+    // The pool should now have one slot (p30=4)","+    int reuse = chtrie_walk(t9, 0, 5, 1);","+    printf(\"reuse expected=%d got=%d\\n\", p30, reuse);","+    chtrie_free(t9);","+","+    // Delete from non-existent bucket","+    chtrie *t10 = chtrie_alloc(10, 5);","+    chtrie_del(t10, 0, 0); // empty bucket - no-op","+    chtrie_walk(t10, 0, 0, 1);","+    chtrie_del(t10, 0, 1); // exists in bucket but different from,sym - no-op","+    int still = chtrie_walk(t10, 0, 0, 0);","+    printf(\"after no-op deletes (0,0)=%d\\n\", still);","+    chtrie_free(t10);","+","     return 0;"," }"]}],"userModified":false,"replaceAll":false}}
