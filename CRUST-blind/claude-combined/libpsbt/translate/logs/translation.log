intbuf, 2048);\n\n    let mut nothing: i32 = 0;\n    let res = psbt_read(&buf, plen, &mut psbt, None, &mut nothing);\n    assert_eq!(res, PsbtResult::Ok);\n    assert_eq!(psbt.state, PsbtState::Finalized);\n}\n\nfn main() {}\n","structuredPatch":[{"oldStart":17,"oldLines":8,"newStart":17,"newLines":8,"lines":["     let mut plen = 0usize;","     let res = psbt_decode(EMPTY_INPUTS_B64, EMPTY_INPUTS_B64.len(), &mut buf, 2048, &mut plen);","     assert_eq!(res, PsbtResult::Ok);","-    // The decoded length should be 50 bytes per the embedded test vector.","-    assert_eq!(plen, 50);","+    // C's psbt_decode of this string yields 52 bytes","+    assert_eq!(plen, 52);"," ","     let mut psbt = Psbt::new(2048);","     let mut intbuf = vec![0u8; 2048];"]}],"userModified":false,"replaceAll":false}}
