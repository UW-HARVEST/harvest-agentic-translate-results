et_size: u64 = if chsize < 253 {\n        chsize as u64\n    } else if chsize == 253 {\n        if data.len() < 3 {\n            return (0, PsbtResult::CompactReadError);\n        }\n        let v = u16::from_le_bytes([data[1], data[2]]) as u64;\n        if v < 253 {\n            return (0, PsbtResult::CompactReadError);\n        }\n        v\n    } else if chsize == 254 {\n        if data.len() < 5 {\n            return (0, PsbtResult::CompactReadError);\n        }\n        let v = u32::from_le_bytes([data[1], data[2], data[3], data[4]]) as u64;\n        if v < 0x10000u64 {\n            return (0, PsbtResult::CompactReadError);\n        }\n        v\n    } else {\n        if data.len() < 9 {\n            return (0, PsbtResult::CompactReadError);\n        }\n        let v = u64::from_le_bytes([\n            data[1], data[2], data[3], data[4],\n            data[5], data[6], data[7], data[8],\n        ]);\n        if v < 0x100000000u64 {\n            return (0, PsbtResult::CompactReadError);\n        }\n        v\n    };\n\n    if ret_size > MAX_SERIALIZE_SIZE as u64 {\n        return (0, PsbtResult::CompactReadError);\n    }\n\n    (ret_size, PsbtResult::Ok)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1051,"cache_read_input_tokens":60048,"cache_creation":{"ephemeral_5m_input_tokens":1051,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6410ab4b-bca7-484e-8f66-3dfe60a42e6d","uuid":"a3051187-60aa-4e27-9175-5cb507f668a2"}
