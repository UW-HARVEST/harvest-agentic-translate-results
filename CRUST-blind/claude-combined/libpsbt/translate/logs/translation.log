est_cli.rs` — 1 test exercising the cli's PSBT decode+read flow on the empty-inputs base64 vector.\n\nExpected values were derived by compiling and running the original C code through small oracle programs, which I have since cleaned up."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":508,"cache_read_input_tokens":128967,"cache_creation":{"ephemeral_5m_input_tokens":508,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6410ab4b-bca7-484e-8f66-3dfe60a42e6d","uuid":"ff8088db-f615-48a4-9e88-606c469195a2"}
