use gfc::gfc::GFC;

fn test_range(range: u64, rounds: u64) {
    let mut counts = vec![0u64; range as usize];
    let gfc = GFC::new(range, rounds, 42);
    for i in 0..range {
        let enc = gfc.encrypt(i);
        let dec = gfc.decrypt(enc);
        assert_eq!(dec, i, "dec[{}] = {}", i, dec);
        counts[enc as usize] += 1;
    }
    for i in 0..range as usize {
        assert_eq!(counts[i], 1, "counts[{}] = {}", i, counts[i]);
    }
    println!("test_range({}, {}) passed", range, rounds);
}

fn main() {
    test_range(0, 0);
    test_range(0, 1);
    test_range(1, 0);
    test_range(1, 1);
    test_range(10, 1);
    test_range(100, 1);
    test_range(100, 6);
    test_range(500_000, 6);
    println!("All tests passed!");
}
EOF
