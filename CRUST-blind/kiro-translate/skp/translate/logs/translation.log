pub fn is_oneof(ch: u32, set: &str, iso: i32) -> bool {
    if ch == 0 { return false; }
    let (mut p_ch, mut s) = skp_next(set, iso);
    // If first char in set is ']', it's a literal ']'
    if p_ch == b']' as u32 {
        if ch == b']' as u32 { return true; }
        let r = skp_next(s, iso);
        p_ch = r.0; s = r.1;
    }
    while p_ch != b']' as u32 {
        if p_ch == ch { return true; }
        let q_ch = p_ch;
        let r = skp_next(s, iso);
        p_ch = r.0; s = r.1;
        if p_ch == b'-' as u32 && !s.is_empty() && bytes(s)[0] != b']' {
            let r = skp_next(s, iso);
            p_ch = r.0; s = r.1;
            if q_ch < ch && ch <= p_ch { return true; }
            let r = skp_next(s, iso);
            p_ch = r.0; s = r.1;
        }
    }
    false
}

pub fn is_string(s: &str, p: &str, len: i32, flg: i32) -> i32 {
    let start = s;
    let mut s = s;
    let mut p = p;
    let mut len = len;
    let mut mlen: i32 = 0;
    while len > 0 {
        if !p.is_empty() && bytes(p)[0] == 0x0E { return mlen; }
        let (p_chr, p_end) = skp_next(p, flg & 2);
        let (s_chr, s_end) = skp_next(s, flg & 2);
        if chr_cmp(s_chr, p_chr, flg & 1) {
            mlen += (s_end.as_ptr() as i32) - (s.as_ptr() as i32);
            len -= (p_end.as_ptr() as i32) - (p.as_ptr() as i32);
            p = p_end; s = s_end;
        } else {
            // search for alternative (0x0E separator)
            while len > 0 {
                if p.is_empty() { break; }
                let b = bytes(p)[0];
                p = &p[1..];
                len -= 1;
                if b == 0x0E { break; }
            }
            if len <= 0 { return 0; }
            len -= 1; // consume the separator
            s = start;
            mlen = 0;
        }
    }
    mlen
}
