// Parsing functions

pub fn skp_debug2(ast: &mut Ast, d: u8) -> i32 {
    match d {
        0 => { ast.flg &= !SKP_DEBUG; }
        1 => { ast.flg |= SKP_DEBUG; }
        _ => { ast.flg ^= SKP_DEBUG; }
    }
    (ast.flg & SKP_DEBUG) as i32
}

pub fn skp__abort(ast: &mut Ast, msg: &str, rule: &str) {
    if !msg.is_empty() { ast.err_msg = Some(msg.to_string()); }
    ast.err_pos = ast.pos;
    ast.err_rule = Some(rule.to_string());
    // In C this does longjmp. In Rust we set fail flag.
    ast.fail = 1;
}

pub fn skp_memoize(ast: &mut Ast, mmz: &mut AstMmz, rule: &str, old_pos: i32, start_par: i32) {
    let end_par;
    if ast.fail != 0 || ast.par_cnt <= start_par {
        end_par = -1;
        // start_par = -1; // not needed since we check below
        mmz.pos = old_pos;
        mmz.endpos = ast.pos;
        mmz.numnodes = -1;
        mmz.lastinfo = ast.lastinfo;
        mmz.nodes.clear();
        return;
    }
    end_par = ast.par_cnt;
    let numnodes = (end_par - start_par) / 2;

    mmz.pos = old_pos;
    mmz.endpos = ast.pos;
    mmz.numnodes = numnodes;
    mmz.lastinfo = ast.lastinfo;
    mmz.nodes.clear();

    for k in start_par..end_par {
        if ast.par[k as usize] >= 0 {
            mmz.nodes.push(ast.nodes[ast.par[k as usize] as usize].clone());
        }
    }
}

pub fn skp_dememoize(ast: &mut Ast, mmz: &mut AstMmz, _rule: &str) -> i32 {
    // Check if memoized at current position
    if mmz.pos != ast.pos { return 0; }

    let numnodes = mmz.numnodes;
    ast.fail = if numnodes < 0 { 1 } else { 0 };
    ast.lastpos = ast.pos;
    ast.pos = mmz.endpos;
    ast.lastinfo = mmz.lastinfo;

    if numnodes > 0 {
        skp_nodes_makeroom(ast, numnodes);
        skp_par_makeroom(ast, 2 * numnodes);

        // Fill new par slots with SKP_DELTA_MAX
        for k in ast.par_cnt..(ast.par_cnt + 2 * numnodes) {
            ast.par[k as usize] = SKP_DELTA_MAX;
        }

        let mut cur_par = ast.par_cnt;
        for k in 0..numnodes {
            ast.nodes[ast.nodes_cnt as usize] = mmz.nodes[k as usize].clone();
            while ast.par[cur_par as usize] != SKP_DELTA_MAX { cur_par += 1; }
            ast.par[cur_par as usize] = ast.nodes_cnt;
            let delta = mmz.nodes[k as usize].delta;
            ast.par[(cur_par + delta) as usize] = -delta;
            ast.nodes_cnt += 1;
        }
        ast.par_cnt += 2 * numnodes;
    }
    1
}

pub fn skp_parse(src: &str, rule: SkpRule, rulename: &str, debug: i32) -> Option<Ast> {
    let mut ast = ast_new()?;
    ast.start = src.to_string();
    ast.flg = if debug != 0 { SKP_DEBUG } else { 0 };

    let open = ast_open(&mut ast, ast.pos, rulename);
    if open >= 0 {
        // In C, setjmp/longjmp is used for abort. In Rust, we use catch_unwind or just call.
        // Since skp__abort sets fail=1, we just call the rule.
        use std::panic;
        let ast_ptr = &mut ast as *mut Ast;
        let result = panic::catch_unwind(panic::AssertUnwindSafe(|| {
            let ast_ref = unsafe { &mut *ast_ptr };
            let mut ret = 0i32;
            rule(ast_ref, &mut ret);
            ast_ref.ret = ret;
        }));
        if result.is_err() {
            ast.fail = 1;
        }

        if ast.fail != 0 && ast.err_pos < ast.pos {
            ast.err_pos = ast.pos;
            ast.err_rule = Some(rulename.to_string());
        }

        ast_close(&mut ast, ast.pos, open);
        if ast.nodes_cnt > 0 {
            ast.err_pos = -1;
            ast_setinfo(&mut ast, ast.lastinfo, 0);
        }
    }
    Some(ast)
}
