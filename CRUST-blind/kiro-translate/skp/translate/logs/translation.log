pub fn skp_<'a>(src: &'a str, pat: &'a str) -> (i32, &'a str, &'a str) {
    if src.is_empty() && pat.is_empty() { return (0, src, src); }
    let mut pat = pat;
    let mut start = src;
    let mut skp_to = false;
    let mut flg: i32 = 0;
    let mut goal: Option<&'a str> = None;
    let mut goalnot: Option<&'a str> = None;

    if !pat.is_empty() && bytes(pat)[0] == b'>' {
        skp_to = true;
        pat = &pat[1..];
    }

    let pat_orig = pat;
    let mut p = pat;
    let mut s = start;

    // skip leading spaces in pattern
    while !p.is_empty() && is_space(bytes(p)[0] as u32) { p = &p[1..]; }

    let mut matched: i32 = 0;

    while !p.is_empty() && bytes(p)[0] > 7 {
        let (m, s_end, p_end) = match_pat(p, s, &mut flg);
        matched = m;
        if matched != 0 {
            s = s_end; p = p_end;
            if matched == MATCHED_GOAL && goalnot.is_none() { goal = Some(s); }
            else if matched == MATCHED_GOALNOT { goalnot = Some(s); }
        } else {
            // skip to end of current alternative
            while !p.is_empty() && bytes(p)[0] > 7 { p = &p[1..]; }
            if !p.is_empty() && p.len() > 1 && bytes(p)[0] > 0 && bytes(&p[1..])[0] > 0 {
                // Try next alternative
                s = start;
                p = &p[1..];
            } else if skp_to {
                goal = None; goalnot = None;
                p = pat_orig;
                // advance start by one byte
                if start.is_empty() { break; }
                start = &start[1..];
                s = start;
                if s.is_empty() { break; }
            } else {
                break;
            }
        }
        while !p.is_empty() && is_space(bytes(p)[0] as u32) { p = &p[1..]; }
    }

    if matched == 0 && goalnot.is_some() {
        goal = goalnot;
        matched = MATCHED;
        p = "";
    }

    if let Some(g) = goal { s = g; }

    if matched != 0 && (p.is_empty() || bytes(p)[0] <= 7) {
        let ret_code = if !p.is_empty() && bytes(p)[0] > 0 { bytes(p)[0] as i32 } else { 1 };
        let to_val = if skp_to { start } else { s };
        return (ret_code, to_val, s);
    }

    (0, src, src)
}

pub fn skp_4(src: &str, pat: &str, to: Option<&mut &str>, end: Option<&mut &str>) -> i32 {
    let (ret, to_val, end_val) = skp_(src, pat);
    if let Some(t) = to { *t = to_val; }
    if let Some(e) = end { *e = end_val; }
    ret
}

pub fn skp_3(src: &str, pat: &str, end: Option<&mut &str>) -> i32 {
    let (ret, _to_val, end_val) = skp_(src, pat);
    if let Some(e) = end { *e = end_val; }
    ret
}

pub fn skp_2(src: &str, pat: &str) -> i32 {
    let (ret, _, _) = skp_(src, pat);
    ret
}
