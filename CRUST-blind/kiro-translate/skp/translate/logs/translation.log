pub const MATCHED_FAIL: i32 = 0;
pub const MATCHED: i32 = 1;
pub const MATCHED_GOAL: i32 = 2;
pub const MATCHED_GOALNOT: i32 = 3;

// Helper: offset of s2 within the same string that s1 comes from
fn str_offset(base: &str, sub: &str) -> usize {
    let bp = base.as_ptr() as usize;
    let sp = sub.as_ptr() as usize;
    sp - bp
}

// Helper: get byte at index, or 0 if out of bounds
fn byte_at(s: &str, i: usize) -> u8 {
    if i < s.len() { bytes(s)[i] } else { 0 }
}

pub fn match_pat<'a>(pat: &'a str, src: &'a str, flg: &mut i32) -> (i32, &'a str, &'a str) {
    let mut pat = pat;
    let mut ret = MATCHED_FAIL;
    let mut match_min: u32 = 1;
    let mut match_max: u32 = 1;
    let mut match_not: u32 = 0;
    let mut intnumber = false;

    let mut s_end = src;
    let mut s_tmp = src;
    let (mut s_chr, next_tmp) = skp_next(s_end, *flg & 2);
    s_tmp = next_tmp;

    if !pat.is_empty() && bytes(pat)[0] == b'*' { match_min = 0; match_max = u32::MAX; pat = &pat[1..]; }
    else if !pat.is_empty() && bytes(pat)[0] == b'+' { match_max = u32::MAX; pat = &pat[1..]; }
    else if !pat.is_empty() && bytes(pat)[0] == b'?' { match_min = 0; pat = &pat[1..]; }

    if !pat.is_empty() && bytes(pat)[0] == b'!' { match_not = 1; pat = &pat[1..]; }

    if pat.is_empty() {
        return (MATCHED_FAIL, src, pat);
    }

    let pat_char = bytes(pat)[0];
    pat = &pat[1..];

    // Macro W equivalent: match while condition holds
    macro_rules! w_match {
        ($test:expr) => {{
            let mut match_cnt: u32 = 0;
            while match_cnt < match_max && s_chr != 0 && (if $test { match_not == 0 } else { match_not != 0 }) {
                match_cnt += 1;
                s_end = s_tmp;
                let r = skp_next(s_end, *flg & 2);
                s_chr = r.0; s_tmp = r.1;
            }
            ret = if match_cnt >= match_min { MATCHED } else { MATCHED_FAIL };
        }};
    }

    // get_next_s_chr macro equivalent (single byte advance)
    macro_rules! get_next {
        () => {{
            s_end = s_tmp;
            if s_end.is_empty() { s_chr = 0; s_tmp = s_end; }
            else { s_chr = bytes(s_end)[0] as u32; s_tmp = &s_end[1..]; }
        }};
    }

    intnumber = false;

    match pat_char {
        b'.' => {
            if match_not != 0 { ret = if s_chr == 0 { MATCHED } else { MATCHED_FAIL }; }
            else { w_match!(s_chr != 0); }
        }
        b'$' => {
            if s_chr == 0 { ret = MATCHED; }
            else { w_match!(is_break(s_chr)); }
        }
        b'n' => { w_match!(is_break(s_chr)); }
        b'd' => { w_match!(is_digit(s_chr)); }
        b'x' => { w_match!(is_xdigit(s_chr)); }
        b'a' => { w_match!(is_alpha(s_chr)); }
        b'u' => { w_match!(is_upper(s_chr)); }
        b'l' => { w_match!(is_lower(s_chr)); }
        b's' => { w_match!(is_space(s_chr)); }
        b'w' => { w_match!(is_blank(s_chr)); }
        b'c' => { w_match!(is_ctrl(s_chr)); }
        b'i' => { w_match!(is_idchr(s_chr)); }
        b'@' => { w_match!(is_alnum(s_chr)); }
        b'&' => {
            ret = if match_not != 0 { MATCHED_GOALNOT } else { MATCHED_GOAL };
        }
        b'[' => {
            w_match!(is_oneof(s_chr, pat, *flg & 2));
            // skip past the set definition
            if !pat.is_empty() && bytes(pat)[0] == b']' { pat = &pat[1..]; }
            while !pat.is_empty() && bytes(pat)[0] != b']' { pat = &pat[1..]; }
            if !pat.is_empty() { pat = &pat[1..]; }
        }
        b'"' | b'\'' | b'`' => {
            let quote = pat_char;
            let mut l = 0;
            while l < pat.len() && bytes(pat)[l] != quote { l += 1; }
            if l > 0 {
                let ml = is_string(s_end, &pat[..l], l as i32, *flg);
                if ml > 0 {
                    if match_not == 0 {
                        s_end = &s_end[ml as usize..];
                        ret = MATCHED;
                    }
                } else if match_min == 0 || match_not != 0 {
                    ret = MATCHED;
                }
            } else if match_min == 0 || match_not != 0 {
                ret = MATCHED;
            }
            pat = if l < pat.len() { &pat[l+1..] } else { &pat[l..] };
        }
        b'C' => {
            *flg = (*flg & !1) | (match_not as i32);
            ret = MATCHED;
        }
        b'U' => {
            *flg = (*flg & !2) | ((match_not as i32) * 2);
            ret = MATCHED;
        }
        b'S' => {
            while is_space(s_chr) { get_next!(); }
            ret = MATCHED;
        }
        b'W' => {
            while is_blank(s_chr) { get_next!(); }
            ret = MATCHED;
        }
        b'N' => {
            while s_chr != 0 && !is_break(s_chr) { get_next!(); }
            if s_chr != 0 { get_next!(); }
            ret = MATCHED;
        }
        b'I' => {
            if is_alpha(s_chr) || s_chr == b'_' as u32 {
                loop {
                    get_next!();
                    if !(is_alnum(s_chr) || s_chr == b'_' as u32) { break; }
                }
                ret = MATCHED;
            }
        }
        b'(' => {
            if pat.is_empty() || bytes(pat)[0] != b')' || s_chr != b'(' as u32 {
                // no match, restore pat
            } else {
                pat = &pat[1..]; // skip ')'
                // fall through to B
                let close = get_close(s_chr);
                if close != 0 {
                    let open = s_chr;
                    let mut count: i32 = 1;
                    while s_chr != 0 && count > 0 {
                        get_next!();
                        if s_chr == open { count += 1; }
                        if s_chr == close { count -= 1; }
                    }
                    if count == 0 { get_next!(); ret = MATCHED; }
                }
            }
        }
        b'B' => {
            let close = get_close(s_chr);
            if close != 0 {
                let open = s_chr;
                let mut count: i32 = 1;
                while s_chr != 0 && count > 0 {
                    get_next!();
                    if s_chr == open { count += 1; }
                    if s_chr == close { count -= 1; }
                }
                if count == 0 { get_next!(); ret = MATCHED; }
            }
        }
        b'Q' => {
            let qclose = get_qclose(s_chr);
            if qclose != 0 {
                while s_chr != 0 {
                    get_next!();
                    if s_chr == qclose { break; }
                    if s_chr == b'\\' as u32 { get_next!(); }
                }
                if s_chr != 0 { get_next!(); ret = MATCHED; }
            }
        }
        b'X' => {
            if s_chr == b'0' as u32
                && !s_end.is_empty() && s_end.len() > 1
                && (byte_at(s_end, 1) == b'x' || byte_at(s_end, 1) == b'X')
                && s_end.len() > 2 && is_xdigit(byte_at(s_end, 2) as u32)
            {
                get_next!(); get_next!(); get_next!();
                ret = MATCHED;
            }
            while is_xdigit(s_chr) { ret = MATCHED; get_next!(); }
        }
        b'D' => {
            intnumber = true;
            // sign
            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {
                loop { get_next!(); if !is_space(s_chr) { break; } }
            }
            while is_digit(s_chr) { ret = MATCHED; get_next!(); }
        }
        b'F' => {
            // sign
            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {
                loop { get_next!(); if !is_space(s_chr) { break; } }
            }
            while is_digit(s_chr) { ret = MATCHED; get_next!(); }
            if !intnumber {
                if s_chr == b'.' as u32 { get_next!(); }
                while is_digit(s_chr) { ret = MATCHED; get_next!(); }
                if ret == MATCHED && (s_chr == b'E' as u32 || s_chr == b'e' as u32) {
                    get_next!();
                    if s_chr == b'+' as u32 || s_chr == b'-' as u32 { get_next!(); }
                    while is_digit(s_chr) { get_next!(); }
                    if s_chr == b'.' as u32 { get_next!(); }
                    while is_digit(s_chr) { get_next!(); }
                }
            }
        }
        _ => {
            ret = MATCHED_FAIL;
            // undo the pat advance
            // We need to go back one byte. Since we did pat = &pat[1..] after reading pat_char,
            // we need to reconstruct the original pat position.
            // We can't easily go back, so we use a trick: the caller checks *p > '\7'
            // The default case in C does pat-- which undoes the switch advance.
            // We need to return pat pointing before the consumed char.
            // Since we consumed one byte, let's reconstruct:
            let orig_len = pat.len() + 1;
            // Safety: pat_char was at pat[-1], we need to include it back
            // We can use unsafe to go back one byte
            let ptr = pat.as_ptr();
            pat = unsafe { std::str::from_utf8_unchecked(std::slice::from_raw_parts(ptr.sub(1), orig_len)) };
        }
    }

    if ret != MATCHED_FAIL {
        (ret, s_end, pat)
    } else {
        (MATCHED_FAIL, src, pat)
    }
}
