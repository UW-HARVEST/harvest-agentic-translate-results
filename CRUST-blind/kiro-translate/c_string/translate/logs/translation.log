    assert_eq!(string_bytes(&joined), "\nsome\nstring");
}

#[test]
fn test_concat() {
    let a = new_string_from_bytes("first");
    let b = new_string_from_bytes("second");
    let c = string_concat(&a, &b);
    assert_eq!(string_bytes(&c), "firstsecond");
}

#[test]
fn test_split_by_vnkrtv() {
    let s = new_string_from_bytes("SomeWgithubWaccount:Wvnkrtv");
    let mut arr_size = 0;
    let arr = string_split_by(&s, &mut arr_size, "W");
    assert_eq!(arr_size, 4);
    assert_eq!(string_bytes(&arr[0]), "Some");
    assert_eq!(string_bytes(&arr[1]), "github");
    assert_eq!(string_bytes(&arr[2]), "account:");
    assert_eq!(string_bytes(&arr[3]), "vnkrtv");
}

#[test]
fn test_startswith() {
    let s = new_string_from_bytes("1234");
    assert_eq!(string_startswith(&s, "2"), false);
    assert_eq!(string_startswith(&s, "1"), true);
}

#[test]
fn test_endswith() {
    let s = new_string_from_bytes("1234");
    assert_eq!(string_endswith(&s, "2"), false);
    assert_eq!(string_endswith(&s, "4"), true);
}

#[test]
fn test_join_with_some() {
    let arr = vec![
        new_string_from_bytes("some"),
        new_string_from_bytes("string"),
    ];
    let joined = string_join_arr(&arr, 2, "SOME");
    assert_eq!(string_bytes(&joined), "someSOMEstring");
}
