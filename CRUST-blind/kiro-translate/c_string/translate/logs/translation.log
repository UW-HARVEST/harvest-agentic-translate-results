use c_string::string_t::*;

#[test]
fn test_strip_empty() {
    let s = new_string_from_bytes("");
    let stripped = string_strip(&s);
    assert_eq!(stripped.size, 0);
    assert_eq!(string_bytes(&stripped), "");
}

#[test]
fn test_strip_all_spaces() {
    let s = new_string_from_bytes("  \t\n");
    let stripped = string_strip(&s);
    // C code: start_pos >= end_pos => returns copy
    assert_eq!(stripped.size, s.size);
}

#[test]
fn test_split_leading_space() {
    let s = new_string_from_bytes(" some string 124!");
    let mut arr_size = 0;
    let arr = string_split(&s, &mut arr_size);
    assert_eq!(arr_size, 4);
    assert_eq!(string_bytes(&arr[0]), "");
    assert_eq!(string_bytes(&arr[1]), "some");
    assert_eq!(string_bytes(&arr[2]), "string");
    assert_eq!(string_bytes(&arr[3]), "124!");
}

#[test]
fn test_split_by() {
    let s = new_string_from_bytes("WsomeWstringW124!");
    let mut arr_size = 0;
    let arr = string_split_by(&s, &mut arr_size, "W");
    assert_eq!(arr_size, 4);
    assert_eq!(string_bytes(&arr[0]), "");
    assert_eq!(string_bytes(&arr[1]), "some");
    assert_eq!(string_bytes(&arr[2]), "string");
    assert_eq!(string_bytes(&arr[3]), "124!");
}

#[test]
fn test_find_empty_chars() {
    let s = new_string_from_bytes("test");
    assert_eq!(string_find(&s, ""), Some(0));
}

#[test]
fn test_find_not_found() {
    let s = new_string_from_bytes("test string");
    assert_eq!(string_find(&s, "no"), None);
}

#[test]
fn test_join() {
    let arr = vec![
        new_string_from_bytes(""),
        new_string_from_bytes("some"),
        new_string_from_bytes("string"),
    ];
    let joined = string_join_arr(&arr, 3, "\n");
    assert_eq!(string_bytes(&joined), "\nsome\nstring");
}

#[test]
fn test_concat() {
    let a = new_string_from_bytes("first");
    let b = new_string_from_bytes("second");
    let c = string_concat(&a, &b);
    assert_eq!(string_bytes(&c), "firstsecond");
}
