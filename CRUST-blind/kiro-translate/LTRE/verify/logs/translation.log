use LTRE::ltre::*;

fn test_match(regex: &str, input: &str, expected: bool, partial: bool, ignorecase: bool, complement: bool, quick: bool) {
    let parse_result = ltre_parse(regex);
    match parse_result {
        Ok(mut nfa) => {
            if partial { ltre_partial(&mut nfa).unwrap(); }
            if ignorecase { ltre_ignorecase(&mut nfa).unwrap(); }
            if complement { ltre_complement(&mut nfa); }
            let dfa = ltre_compile(nfa.clone());
            
            // Test basic matching
            let result = ltre_matches(&dfa, input.as_bytes());
            if result != expected {
                println!("FAIL: /{regex}/ against '{input}': got {result}, expected {expected}");
                return;
            }
            
            // Test serialize/deserialize round-trip
            let buf = dfa_serialize(&dfa);
            let (dfa2, _) = dfa_deserialize(&buf).unwrap();
            let nfa2 = ltre_uncompile(&dfa2);
            let dfa3 = ltre_compile(nfa2.clone());
            let result2 = ltre_matches(&dfa3, input.as_bytes());
            if result2 != expected {
                println!("FAIL (roundtrip): /{regex}/ against '{input}': got {result2}, expected {expected}");
                return;
            }
            
            if !quick {
                // Test decompile round-trip
                let re = ltre_decompile(&dfa3);
                match ltre_parse(&re) {
                    Ok(nfa3) => {
                        let dfa4 = ltre_compile(nfa3);
                        let result3 = ltre_matches(&dfa4, input.as_bytes());
                        if result3 != expected {
                            println!("FAIL (decompile): /{regex}/ -> /{re}/ against '{input}': got {result3}, expected {expected}");
                            return;
                        }
                    }
                    Err(e) => {
                        println!("FAIL (decompile parse): /{regex}/ -> /{re}/ error: {e}");
                        return;
                    }
                }
            }
            
            // Test lazy matching
            let mut ldfa = None;
            let result4 = ltre_matches_lazy(&mut ldfa, &nfa, input.as_bytes());
            if result4 != expected {
                println!("FAIL (lazy): /{regex}/ against '{input}': got {result4}, expected {expected}");
                return;
            }
        }
        Err(e) => {
            println!("FAIL: /{regex}/ parse error: {e}");
        }
    }
}

fn test_error(regex: &str) {
    match ltre_parse(regex) {
        Ok(_) => println!("FAIL: /{regex}/ should have errored"),
        Err(_) => {}
    }
}

fn main() {
    // Basic tests
    test_match("abba", "abba", true, false, false, false, false);
    test_match("[ab]+", "abba", true, false, false, false, false);
    test_match("[ab]+", "abc", false, false, false, false, false);
    test_match(".*", "abba", true, false, false, false, false);
    test_match("(a|b+){3}", "abbba", true, false, false, false, false);
    test_match("(a|b+){3}", "abbab", false, false, false, false, false);
    test_match("\\x61\\+", "a+", true, false, false, false, false);
    test_match("", "", true, false, false, false, false);
    test_match("[]", "", false, false, false, false, false);
    test_match("[]*", "", true, false, false, false, false);
    test_match("[]+", "", false, false, false, false, false);
    test_match("[]?", "", true, false, false, false, false);
    test_match("()", "", true, false, false, false, false);
    test_match("()*", "", true, false, false, false, false);
    test_match("()+", "", true, false, false, false, false);
    test_match("()?", "", true, false, false, false, false);
    test_match(" ", " ", true, false, false, false, false);
    test_match("", "\n", false, false, false, false, false);
    test_match("\\n", "\n", true, false, false, false, false);
    test_match(".", "\n", false, false, false, false, false);
    test_match("\\\\n", "\n", false, false, false, false, false);
    test_match("(|n)(\\n)", "\n", true, false, false, false, false);
    test_match("\\r?\\n", "\n", true, false, false, false, false);
    test_match("\\r?\\n", "\r\n", true, false, false, false, false);
    test_match("(a*)*", "a", true, false, false, false, false);
    test_match("(a+)+", "aa", true, false, false, false, false);
    test_match("(a?)?", "", true, false, false, false, false);
    test_match("a+", "aa", true, false, false, false, false);
    test_match("a?", "aa", false, false, false, false, false);
    test_match("(a+)?", "aa", true, false, false, false, false);
    
    // Quantifier tests
    test_match("a{1,2}", "", false, false, false, false, false);
    test_match("a{1,2}", "a", true, false, false, false, false);
    test_match("a{1,2}", "aa", true, false, false, false, false);
    test_match("a{1,2}", "aaa", false, false, false, false, false);
    test_match("a{0,}", "", true, false, false, false, false);
    test_match("a{0,}", "aaa", true, false, false, false, false);
    test_match("a{2}", "a", false, false, false, false, false);
    test_match("a{2}", "aa", true, false, false, false, false);
    test_match("a{2}", "aaa", false, false, false, false, false);
    test_match("a{0}", "", true, false, false, false, false);
    test_match("a{0}", "a", false, false, false, false, false);
    
    // Partial, ignorecase, complement
    test_match("", "", true, true, false, false, false);
    test_match("", "abc", true, true, false, false, false);
    test_match("b", "abc", true, true, false, false, false);
    test_match("ba", "abc", false, true, false, false, false);
    test_match("abc", "abc", true, true, false, false, false);
    test_match("", "", true, false, true, false, false);
    test_match("abCdEF", "aBCdEf", true, false, true, false, false);
    test_match("a", "", true, false, false, true, false);
    test_match("a", "a", false, false, false, true, false);
    test_match("a", "aa", true, false, false, true, false);
    
    // Nonstandard features
    test_match("^a", "z", true, false, false, false, false);
    test_match("^a", "a", false, false, false, false, false);
    test_match("\\d+", "0123456789", true, false, false, false, false);
    test_match("\\s+", " \x0c\n\r\t\x0b", true, false, false, false, false);
    test_match("\\w+", "azAZ09_", true, false, false, false, false);
    
    // Complement and intersection
    test_match("~0*", "", false, false, false, false, false);
    test_match("~0*", "0", false, false, false, false, false);
    test_match("~0*", "001", true, false, false, false, false);
    test_match("\\w+&~\\d+", "abc", true, false, false, false, false);
    test_match("\\w+&~\\d+", "123", false, false, false, false, false);
    
    // Fixed string
    let nfa = ltre_fixed_string("hello");
    let dfa = ltre_compile(nfa);
    assert!(ltre_matches(&dfa, b"hello"));
    assert!(!ltre_matches(&dfa, b"hell"));
    assert!(!ltre_matches(&dfa, b"helloo"));
    
    // Parse errors
    test_error("abc]");
    test_error("[abc");
    test_error("abc)");
    test_error("(abc");
    test_error("+a");
    test_error("a|*");
    test_error("\\x0");
    test_error("\\zzz");
    test_error("\x08");
    test_error("\t");
    test_error("a**");
    test_error("a{2,1}");
    test_error("-");
    test_error("a-");
    
    // Catastrophic backtracking (should be fast)
    test_match("(a*)*c", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", false, false, false, false, false);
    test_match("(x+x+)+y", "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", false, false, false, false, false);
    
    println!("All tests completed.");
}
