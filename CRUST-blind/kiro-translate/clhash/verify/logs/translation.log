use clhash::clhash::*;

#[test]
fn test_demo() {
    let random = get_random_key_for_clhash(0x23a23cf5033c3c81u64, 0xb3816f6a2c68e530u64);
    let h1 = clhash(&random, b"my dog");
    let h2 = clhash(&random, b"my cat");
    let h3 = clhash(&random, b"my dog");
    assert_eq!(h1, h3);
    assert_ne!(h1, h2);
}

#[test]
fn test_bit_flip() {
    let mut rs = vec![0u8; RANDOM_BYTES_NEEDED_FOR_CLHASH];
    for k in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {
        rs[k] = (1i32 - k as i32) as u8;
    }
    for bit in 0..64u32 {
        let min_len = ((bit + 8) / 8) as usize;
        for length in min_len..=8 {
            let x: u64 = 0;
            let xbytes = x.to_le_bytes();
            let orig = clhash(&rs, &xbytes[..length]);
            let x2: u64 = 1u64 << bit;
            let x2bytes = x2.to_le_bytes();
            let flip = clhash(&rs, &x2bytes[..length]);
            assert_ne!(flip, orig);
            let back = clhash(&rs, &xbytes[..length]);
            assert_eq!(back, orig);
        }
    }
}

#[test]
fn test_collision() {
    let key_offset: u8 = 0x63;
    let mut k = vec![0u8; RANDOM_BYTES_NEEDED_FOR_CLHASH];
    for j in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {
        k[j] = ((j as u64 + key_offset as u64) & 0xFF) as u8;
    }
    for i in 1..10usize {
        for j in 1..=8usize {
            let mlen = i * 1024 + j;
            let mut m: Vec<u8> = (0..mlen).map(|x| (x & 0xFF) as u8).collect();
            let actual1 = clhash(&k, &m);
            m[mlen - 1] = m[mlen - 1].wrapping_add(1) & 0xFF;
            let actual2 = clhash(&k, &m);
            assert_ne!(actual1, actual2, "collision at mlen={}", mlen);
        }
    }
}

#[test]
fn test_avalanche() {
    let mut rs = vec![0u8; RANDOM_BYTES_NEEDED_FOR_CLHASH];
    for k in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {
        rs[k] = (1i32 - k as i32) as u8;
    }
    for bytelength in 1..16usize {
        for whichcase in 0..256u16 {
            let mut array: Vec<u8> = vec![(whichcase & 0xFF) as u8; bytelength];
            let mut array1: Vec<u8> = vec![((whichcase + 35) & 0xFF) as u8; bytelength];
            let orighash = clhash(&rs, &array);
            let orighash1 = clhash(&rs, &array1);
            for z in 0..(8 * bytelength) {
                let byte_idx = z / 8;
                let bit_idx = z % 8;
                array[byte_idx] ^= 1 << bit_idx;
                let newhash = clhash(&rs, &array);
                array[byte_idx] ^= 1 << bit_idx;
                assert_ne!(orighash, newhash);
                array1[byte_idx] ^= 1 << bit_idx;
                let newhash1 = clhash(&rs, &array1);
                array1[byte_idx] ^= 1 << bit_idx;
                assert_ne!(orighash1, newhash1);
                if bytelength <= 8 {
                    assert_eq!(orighash ^ newhash, orighash1 ^ newhash1);
                }
            }
        }
    }
}
