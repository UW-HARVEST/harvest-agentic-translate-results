// Quick verification script
use libbeaufort::tableau::beaufort_tableau;
use libbeaufort::encrypt::beaufort_encrypt;
use libbeaufort::decrypt::beaufort_decrypt;

fn main() {
    let alpha = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    let mat_owned = beaufort_tableau(alpha);
    let mat_refs: Vec<&[u8]> = mat_owned.iter().map(|r| r.as_slice()).collect();

    // Test tableau with "abc"
    let abc = beaufort_tableau("abc");
    assert_eq!(abc[0], b"acb");
    assert_eq!(abc[1], b"bac");
    assert_eq!(abc[2], b"cba");
    println!("tableau abc: OK");

    // Test encrypt
    let enc1 = beaufort_encrypt(b"kinkajous are awesome", b"monkey", &mat_refs);
    assert_eq!(enc1, b"26004Fyuv AnK Cs9sqC8", "encrypt monkey failed: got {:?}", String::from_utf8_lossy(&enc1));
    println!("encrypt monkey: OK");

    let enc2 = beaufort_encrypt(b"the \nbig \nlebowski", b"goodman", &mat_refs);
    assert_eq!(enc2, b"n7A \n24u \n22D0huq5", "encrypt goodman failed: got {:?}", String::from_utf8_lossy(&enc2));
    println!("encrypt goodman: OK");

    let enc3 = beaufort_encrypt(b"d4nc3 t0 th3 mus!c :D", b"groove", &mat_refs);
    assert_eq!(enc3, b"3n1Cs lg y7l 9ko!F :b", "encrypt groove failed: got {:?}", String::from_utf8_lossy(&enc3));
    println!("encrypt groove: OK");

    // Test decrypt
    let dec1 = beaufort_decrypt(&enc1, b"monkey", &mat_refs);
    assert_eq!(dec1, b"kinkajous are awesome");
    println!("decrypt monkey: OK");

    let dec2 = beaufort_decrypt(&enc2, b"goodman", &mat_refs);
    assert_eq!(dec2, b"the \nbig \nlebowski");
    println!("decrypt goodman: OK");

    let dec3 = beaufort_decrypt(&enc3, b"groove", &mat_refs);
    assert_eq!(dec3, b"d4nc3 t0 th3 mus!c :D");
    println!("decrypt groove: OK");

    println!("\nAll tests passed!");
}
EOF

