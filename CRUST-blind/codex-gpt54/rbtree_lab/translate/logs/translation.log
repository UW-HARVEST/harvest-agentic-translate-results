n        w->color = RBTREE_RED;\n        x = x->parent;\n      }\n\n      // CASE 3 : x의 형제 w는 흑색, w의 왼쪽 자식은 적색, w의 오른쪽 자신은 흑색인 경우\n      else{ \n        if (w->right->color == RBTREE_BLACK) {\n","exit_code":0,"status":"completed"}}
