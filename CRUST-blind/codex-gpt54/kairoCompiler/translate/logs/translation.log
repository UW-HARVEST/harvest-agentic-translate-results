eturn -1;\n    }\n    char c = buffer->data[buffer->rindex];\n    buffer->rindex++;\n    return c;\n}\n\nchar buffer_peek(struct buffer* buffer)\n{\n    if (buffer->rindex >= buffer->len)\n    {\n        return -1;\n    }\n    char c = buffer->data[buffer->rindex];\n    return c;\n}\n\nvoid buffer_free(struct buffer* buffer)\n{\n    free(buffer->data);\n    free(buffer);\n}","exit_code":0,"status":"completed"}}
