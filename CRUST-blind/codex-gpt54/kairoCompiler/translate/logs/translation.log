           S_EQ(op, \"-\") ||\n           S_EQ(op, \"*\") ||\n           S_EQ(op, \"/\") ||\n           S_EQ(op, \"!\") ||\n           S_EQ(op, \"^\") ||\n           S_EQ(op, \"+=\") ||\n           S_EQ(op, \"-=\") ||\n           S_EQ(op, \"*=\") ||\n           S_EQ(op, \"/=\") ||\n           S_EQ(op, \">>\") ||\n           S_EQ(op, \"<<\") ||\n           S_EQ(op, \">=\") ||\n           S_EQ(op, \"<=\") ||\n           S_EQ(op, \">\") ||\n           S_EQ(op, \"<\") ||\n           S_EQ(op, \"||\") ||\n           S_EQ(op, \"&&\") ||\n           S_EQ(op, \"|\") ||\n           S_EQ(op, \"&\") ||\n           S_EQ(op, \"++\") ||\n           S_EQ(op, \"--\") ||\n           S_EQ(op, \"= \") ||\n           S_EQ(op, \"!=\") ||\n           S_EQ(op, \"==\") ||\n           S_EQ(op, \"->\") ||\n           S_EQ(op, \"(\") ||\n           S_EQ(op, \"[\") ||\n           S_EQ(op, \",\") ||\n           S_EQ(op, \".\") ||\n           S_EQ(op, \"...\") ||\n           S_EQ(op, \"~\") ||\n           S_EQ(op, \"?\") ||\n           S_EQ(op, \"%\");\n}\n\nvoid read_op_flush_back_keep_first(struct buffer *buffer)\n{\n    //+*\n    const char *data = buffer_ptr(buffer);\n    int len = buffer->len;\n    for (int i = len - 1; i >= 1; i--)\n    {\n        if (data[i] == 0x00)\n        {\n            continue;\n        }\n\n        pushc(data[i]); // * is pushed back and only + remains\n    }\n}\nconst char *read_op()\n{\n    bool single_operator = true; // eg : ++\n    char op = nextc();           // +\n    struct buffer *buffer = buffer_create();\n    buffer_write(buffer, op); //=+\n\n    if (!op_treated_as_one(op))\n    {\n        op = peekc(); // 2nd +\n        if (is_single_operator(op))\n        {\n            buffer_write(buffer, op); // =++\n            nextc();                  // after 2nd +\n            single_operator = false;\n        }\n    }\n    buffer_write(buffer, 0x00);\n    char *ptr = buffer_ptr(buffer);\n\n    // check if its valid like ++ and its not like +-\n    if (!single_o