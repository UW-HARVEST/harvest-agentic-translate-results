{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/common.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse rand::Rng;\n     2\t\n     3\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n     4\tpub struct Xgcd {\n     5\t    pub gcd: u64,\n     6\t    pub a: i64,\n     7\t    pub b: i64,\n     8\t}\n     9\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n    10\tpub struct Pair {\n    11\t    pub first: u64,\n    12\t    pub second: u64,\n    13\t}\n    14\tpub fn gcd(mut x: u64, mut y: u64) -> u64 {\n    15\t    if x == 0 {\n    16\t        return y;\n    17\t    }\n    18\t    if y == 0 {\n    19\t        return x;\n    20\t    }\n    21\t\n    22\t    while x != y {\n    23\t        if x > y {\n    24\t            x -= y;\n    25\t        } else {\n    26\t            y -= x;\n    27\t        }\n    28\t    }\n    29\t\n    30\t    x\n    31\t}\n    32\tpub fn xgcd(mut a: u64, mut b: u64) -> Xgcd {\n    33\t    let mut prev_a: i64 = 1;\n    34\t    let mut cur_a: i64 = 0;\n    35\t    let mut prev_b: i64 = 0;\n    36\t    let mut cur_b: i64 = 1;\n    37\t\n    38\t    while b != 0 {\n    39\t        let q = (a / b) as i64;\n    40\t        let temp = (a % b) as i64;\n    41\t        a = b;\n    42\t        b = temp as u64;\n    43\t\n    44\t        let next_a = prev_a - (q * cur_a);\n    45\t        prev_a = cur_a;\n    46\t        cur_a = next_a;\n    47\t\n    48\t        let next_b = prev_b - (q * cur_b);\n    49\t        prev_b = cur_b;\n    50\t        cur_b = next_b;\n    51\t    }\n    52\t\n    53\t    Xgcd {\n    54\t        gcd: a,\n    55\t        a: prev_a,\n    56\t        b: prev_b,\n    57\t    }\n    58\t}\n    59\tpub fn are_coprime(x: u64, y: u64) -> bool {\n    60\t    gcd(x, y) <= 1\n    61\t}\n    62\tpub fn randinverse(value: u64) -> Pair {\n    63\t    if value <= 2 {\n    64\t        return Pair {\n    65\t            first: 0,\n    66\t            second: 0,\n    67\t        };\n    68\t    }\n    69\t\n    70\t    let mut a = randrange(2, value - 1);\n    71\t    while !are_coprime(a, value) {\n    72\t        a = randrange(2, value - 1);\n    73\t    }\n    74\t\n    75\t    let result = xgcd(a, value);\n    76\t    Pair {\n    77\t        first: a,\n    78\t        second: if result.a > 0 {\n    79\t            result.a as u64\n    80\t        } else {\n    81\t            (result.a + value as i64) as u64\n    82\t        },\n    83\t    }\n    84\t}\n    85\tpub fn randrange(lower: u64, upper: u64) -> u64 {\n    86\t    let mut rng = rand::rng();\n    87\t    if lower >= upper {\n    88\t        return lower;\n    89\t    }\n    90\t    rng.random_range(lower..=upper)\n    91\t}\n    92\tpub fn normal_rand(mean: f64, stddev: f64) -> f64 {\n    93\t    let mut rng = rand::rng();\n    94\t\n    95\t    let u = loop {\n    96\t        let sample = rng.random::<f64>();\n    97\t        if sample != 0.0 {\n    98\t            break sample;\n    99\t        }\n   100\t    };\n   101\t\n   102\t    let r = (-2.0 * u.ln()).sqrt();\n   103\t\n   104\t    let theta = loop {\n   105\t        let sample = 2.0 * std::f64::consts::PI * rng.random::<f64>();\n   106\t        if sample != 0.0 {\n   107\t            break sample;\n   108\t        }\n   109\t    };\n   110\t\n   111\t    (r * theta.cos() * stddev) + mean\n   112\t}\n   113\tpub fn max(a: u64, b: u64) -> u64 {\n   114\t    if a > b {\n   115\t        a\n   116\t    } else {\n   117\t        b\n   118\t    }\n   119\t}\n   120\tpub fn min(a: u64, b: u64) -> u64 {\n   121\t    if a < b {\n   122\t        a\n   123\t    } else {\n   124\t        b\n   125\t    }\n   126\t}\n   127\tpub fn clamp(min_value: u64, max_value: u64, value: u64) -> u64 {\n   128\t    max(min_value, min(max_value, value))\n   129\t}\n","exit_code":0,"status":"completed"}}
