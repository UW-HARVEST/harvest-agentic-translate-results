{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/polynomial.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse crate::error::Result;\n     2\tpub type Coeff = i64;\n     3\t\n     4\tfn err(msg: &str) -> crate::error::AcesError {\n     5\t    crate::error::AcesError::GenericError(msg.to_string())\n     6\t}\n     7\t\n     8\tfn mod_u64(value: Coeff) -> u64 {\n     9\t    value as u64\n    10\t}\n    11\t\n    12\t#[derive(Debug, Clone, PartialEq, Eq)]\n    13\tpub struct Polynomial {\n    14\t    pub coeffs: Vec<Coeff>,\n    15\t}\n    16\timpl Polynomial {\n    17\t    pub fn new(coeffs: Vec<Coeff>) -> Self {\n    18\t        Self { coeffs }\n    19\t    }\n    20\t    pub fn degree(&self) -> usize {\n    21\t        if self.coeffs.is_empty() {\n    22\t            return 0;\n    23\t        }\n    24\t\n    25\t        for (idx, coeff) in self.coeffs.iter().enumerate() {\n    26\t            if *coeff != 0 {\n    27\t                return self.coeffs.len() - idx - 1;\n    28\t            }\n    29\t        }\n    30\t\n    31\t        0\n    32\t    }\n    33\t    pub fn set_zero(&mut self) {\n    34\t        self.coeffs.fill(0);\n    35\t    }\n    36\t    pub fn coef_sum(&self) -> Coeff {\n    37\t        self.coeffs.iter().copied().sum()\n    38\t    }\n    39\t    pub fn fit(&mut self, modulus: u64) -> Result<()> {\n    40\t        if self.coeffs.is_empty() || modulus == 0 {\n    41\t            return Err(err(\"invalid polynomial or modulus\"));\n    42\t        }\n    43\t\n    44\t        let degree = self.degree();\n    45\t        let idx = self.coeffs.len() - 1 - degree;\n    46\t        let new_len = self.coeffs.len() - idx;\n    47\t\n    48\t        for i in 0..new_len {\n    49\t            self.coeffs[i] = (mod_u64(self.coeffs[i + idx]) % modulus) as Coeff;\n    50\t        }\n    51\t        self.coeffs.truncate(new_len);\n    52\t        Ok(())\n    53\t    }\n    54\t    pub fn add(&self, other: &Polynomial, modulus: u64) -> Result<Polynomial> {\n    55\t        if modulus == 0 {\n    56\t            return Err(err(\"modulus must be non-zero\"));\n    57\t        }\n    58\t\n    59\t        let size = self.coeffs.len().max(other.coeffs.len());\n    60\t        let diff1 = size - self.coeffs.len();\n    61\t        let diff2 = size - other.coeffs.len();\n    62\t        let mut coeffs = vec![0; size];\n    63\t\n    64\t        for (i, slot) in coeffs.iter_mut().enumerate() {\n    65\t            let left = if i >= diff1 {\n    66\t                mod_u64(self.coeffs[i - diff1])\n    67\t            } else {\n    68\t                0\n    69\t            };\n    70\t            let right = if i >= diff2 {\n    71\t                mod_u64(other.coeffs[i - diff2])\n    72\t            } else {\n    73\t                0\n    74\t            };\n    75\t            *slot = left.wrapping_add(right).wrapping_rem(modulus) as Coeff;\n    76\t        }\n    77\t\n    78\t        Ok(Polynomial::new(coeffs))\n    79\t    }\n    80\t    pub fn sub(&self, other: &Polynomial, modulus: u64) -> Result<Polynomial> {\n    81\t        if modulus == 0 {\n    82\t            return Err(err(\"modulus must be non-zero\"));\n    83\t        }\n    84\t\n    85\t        let size = self.coeffs.len().max(other.coeffs.len());\n    86\t        let diff1 = size - self.coeffs.len();\n    87\t        let diff2 = size - other.coeffs.len();\n    88\t        let mut coeffs = vec![0; size];\n    89\t\n    90\t        for (i, slot) in coeffs.iter_mut().enumerate() {\n    91\t            let left = if i >= diff1 {\n    92\t                mod_u64(self.coeffs[i - diff1])\n    93\t            } else {\n    94\t                0\n    95\t            };\n    96\t            let right = if i >= diff2 {\n    97\t                mod_u64(other.coeffs[i - diff2])\n    98\t            } else {\n    99\t                0\n   100\t            };\n   101\t            *slot = left.wrapping_sub(right).wrapping_rem(modulus) as Coeff;\n   102\t        }\n   103\t\n   104\t        Ok(Polynomial::new(coeffs))\n   105\t    }\n   106\t    pub fn mul(&self, other: &Polynomial, modulus: u64) -> Result<Polynomial> {\n   107\t        if self.coeffs.is_empty() || other.coeffs.is_empty() || modulus == 0 {\n   108\t            return Err(err(\"invalid polynomial or modulus\"));\n   109\t        }\n   110\t\n   111\t        let mut result = Polynomial::new(vec![0; self.coeffs.len() + other.coeffs.len()]);\n   112\t        let deg1 = self.coeffs.len() - 1;\n   113\t        let deg2 = other.coeffs.len() - 1;\n   114\t        let res_deg = result.coeffs.len() - deg2 - deg1 - 1;\n   115\t\n   116\t        for i in 0..self.coeffs.len() {\n   117\t            for j in 0..other.coeffs.len() {\n   118\t                let term = mod_u64(self.coeffs[i]).wrapping_mul(mod_u64(other.coeffs[j])) % modulus;\n   119\t                result.coeffs[res_deg + i + j] += term as Coeff;\n   120\t            }\n   121\t        }\n   122\t\n   123\t        result.fit(modulus)?;\n   124\t        Ok(result)\n   125\t    }\n   126\t    pub fn lshift(&self, other: &Polynomial, modulus: u64) -> Result<Polynomial> {\n   127\t        if self.coeffs.is_empty() || other.coeffs.is_empty() || modulus == 0 {\n   128\t            return Err(err(\"invalid polynomial or modulus\"));\n   129\t        }\n   130\t        if other.coeffs[0] != 1 {\n   131\t            return Err(err(\"divisor must be monic\"));\n   132\t        }\n   133\t\n   134\t        let degree1 = self.degree();\n   135\t        let degree2 = other.degree();\n   136\t        if degree1 < degree2 {\n   137\t            return Err(err(\"degree too small\"));\n   138\t        }\n   139\t\n   140\t        let a_d = self.coeffs[0];\n   141\t        let mut result = Polynomial::new(vec![0; self.coeffs.len()]);\n   142\t\n   143\t        for i in 0..self.coeffs.len() {\n   144\t            if i < other.coeffs.len() {\n   145\t                let res = (self.coeffs[i] - (other.coeffs[i] * a_d)).wrapping_rem(modulus as Coeff);\n   146\t                result.coeffs[i] = if res < 0 { res + modulus as Coeff } else { res };\n   147\t            } else {\n   148\t                result.coeffs[i] = self.coeffs[i];\n   149\t            }\n   150\t        }\n   151\t\n   152\t        result.fit(modulus)?;\n   153\t        Ok(result)\n   154\t    }\n   155\t    pub fn poly_mod(&mut self, divisor: &Polynomial, modulus: u64) -> Result<()> {\n   156\t        while let Ok(next) = self.lshift(divisor, modulus) {\n   157\t            *self = next;\n   158\t        }\n   159\t        Ok(())\n   160\t    }\n   161\t    pub fn sub_scaler(&self, scaler: u64, modulus: u64) -> Result<Polynomial> {\n   162\t        if modulus == 0 {\n   163\t            return Err(err(\"modulus must be non-zero\"));\n   164\t        }\n   165\t\n   166\t        Ok(Polynomial::new(\n   167\t            self.coeffs\n   168\t                .iter()\n   169\t                .map(|coeff| mod_u64(*coeff).wrapping_sub(scaler).wrapping_rem(modulus) as Coeff)\n   170\t                .collect(),\n   171\t        ))\n   172\t    }\n   173\t    pub fn add_scaler(&self, scaler: u64, modulus: u64) -> Result<Polynomial> {\n   174\t        if modulus == 0 {\n   175\t            return Err(err(\"modulus must be non-zero\"));\n   176\t        }\n   177\t\n   178\t        Ok(Polynomial::new(\n   179\t            self.coeffs\n   180\t                .iter()\n   181\t                .map(|coeff| mod_u64(*coeff).wrapping_add(scaler).wrapping_rem(modulus) as Coeff)\n   182\t                .collect(),\n   183\t        ))\n   184\t    }\n   185\t}\n   186\t#[derive(Debug, Clone, PartialEq, Eq)]\n   187\tpub struct PolyArray {\n   188\t    pub polies: Vec<Polynomial>,\n   189\t}\n   190\timpl PolyArray {\n   191\t    pub fn new(polies: Vec<Polynomial>) -> Self {\n   192\t        Self { polies }\n   193\t    }\n   194\t}\n","exit_code":0,"status":"completed"}}
