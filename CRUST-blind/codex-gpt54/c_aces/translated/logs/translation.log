{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/aces.rs | sed -n '1,320p'\"","aggregated_output":"     1\tuse crate::aces_internal::{\n     2\t    generate_error, generate_f0, generate_f1, generate_linear, generate_secret, generate_u,\n     3\t    generate_vanisher,\n     4\t};\n     5\tuse crate::channel::{Channel, Parameters};\n     6\tuse crate::error::{AcesError, Result};\n     7\tuse crate::matrix::Matrix3D;\n     8\tuse crate::polynomial::{PolyArray, Polynomial};\n     9\t\n    10\tfn err(msg: &str) -> AcesError {\n    11\t    AcesError::GenericError(msg.to_string())\n    12\t}\n    13\t\n    14\tfn zero_poly(size: usize) -> Polynomial {\n    15\t    Polynomial::new(vec![0; size])\n    16\t}\n    17\t\n    18\tfn zero_poly_array(count: usize, size: usize) -> PolyArray {\n    19\t    PolyArray::new((0..count).map(|_| zero_poly(size)).collect())\n    20\t}\n    21\t\n    22\t/// Represents the public key for the arithmetic channel.\n    23\t#[derive(Debug, Clone)]\n    24\tpub struct PublicKey {\n    25\t    pub u: Polynomial,\n    26\t    pub lambda: Matrix3D,\n    27\t}\n    28\t/// Represents the private key for the arithmetic channel.\n    29\t#[derive(Debug, Clone)]\n    30\tpub struct PrivateKey {\n    31\t    pub x: PolyArray,\n    32\t    pub f0: PolyArray,\n    33\t    pub f1: Polynomial,\n    34\t}\n    35\t/// Shared information for the arithmetic channel.\n    36\t#[derive(Debug, Clone)]\n    37\tpub struct SharedInfo {\n    38\t    pub channel: Channel,\n    39\t    pub param: Parameters,\n    40\t    pub pk: PublicKey,\n    41\t}\n    42\t/// An instance of the ACES encryption scheme.\n    43\t#[derive(Debug, Clone)]\n    44\tpub struct Aces {\n    45\t    pub shared_info: SharedInfo,\n    46\t    pub private_key: PrivateKey,\n    47\t}\n    48\t/// A ciphertext in the ACES framework.\n    49\t#[derive(Debug, Clone)]\n    50\tpub struct CipherMessage {\n    51\t    pub c1: PolyArray,\n    52\t    pub c2: Polynomial,\n    53\t    pub level: u64,\n    54\t}\n    55\t/// Set up the ACES instance (using external memory, for example).\n    56\tpub fn set_aces(aces: &mut Aces, dim: usize, mem: &mut [u8]) -> Result<()> {\n    57\t    let coeff_size = std::mem::size_of::<i64>();\n    58\t    let c_matrix2d_size = std::mem::size_of::<usize>() + std::mem::size_of::<*const u64>();\n    59\t    let c_polynomial_size = std::mem::size_of::<*const i64>() + std::mem::size_of::<usize>();\n    60\t    let required = coeff_size * (2 * dim + 1 + 2 * dim * dim)\n    61\t        + c_matrix2d_size * dim\n    62\t        + c_polynomial_size * 2 * dim\n    63\t        + std::mem::size_of::<u64>() * dim * dim * dim;\n    64\t\n    65\t    if mem.len() < required {\n    66\t        return Err(err(\"insufficient memory for ACES setup\"));\n    67\t    }\n    68\t\n    69\t    aces.shared_info.pk.u = zero_poly(dim + 1);\n    70\t    aces.shared_info.pk.lambda = Matrix3D::new(dim, dim);\n    71\t    aces.private_key.x = zero_poly_array(dim, dim);\n    72\t    aces.private_key.f0 = zero_poly_array(dim, dim);\n    73\t    aces.private_key.f1 = zero_poly(dim);\n    74\t\n    75\t    Ok(())\n    76\t}\n    77\t/// Initialize an instance of ACES.\n    78\tpub fn init_aces(p: u64, q: u64, dim: u64, aces: &mut Aces) -> Result<()> {\n    79\t    aces.shared_info.param = Parameters { dim, N: 1 };\n    80\t    aces.shared_info.channel = Channel::init(p, q, 1)?;\n    81\t\n    82\t    generate_u(\n    83\t        &aces.shared_info.channel,\n    84\t        &aces.shared_info.param,\n    85\t        &mut aces.shared_info.pk.u,\n    86\t    )?;\n    87\t    generate_secret(\n    88\t        &aces.shared_info.channel,\n    89\t        &aces.shared_info.param,\n    90\t        &aces.shared_info.pk.u,\n    91\t        &mut aces.private_key.x,\n    92\t        &mut aces.shared_info.pk.lambda,\n    93\t    )?;\n    94\t    generate_f0(\n    95\t        &aces.shared_info.channel,\n    96\t        &aces.shared_info.param,\n    97\t        &mut aces.private_key.f0,\n    98\t    )?;\n    99\t    generate_f1(\n   100\t        &aces.shared_info.channel,\n   101\t        &aces.shared_info.param,\n   102\t        &aces.private_key.f0,\n   103\t        &aces.private_key.x,\n   104\t        &aces.shared_info.pk.u,\n   105\t        &mut aces.private_key.f1,\n   106\t    )?;\n   107\t\n   108\t    Ok(())\n   109\t}\n   110\t/// Encrypt a message.\n   111\tpub fn aces_encrypt(aces: &Aces, message: &[u64], result: &mut CipherMessage) -> Result<()> {\n   112\t    if message.len() != 1 {\n   113\t        return Err(err(\"exactly one message value is required\"));\n   114\t    }\n   115\t\n   116\t    let dim = aces.shared_info.param.dim as usize;\n   117\t    let mut r_m = zero_poly(dim);\n   118\t    let mut e = zero_poly(dim);\n   119\t    let mut b = zero_poly(dim);\n   120\t\n   121\t    generate_error(aces.shared_info.channel.q, message[0], &mut r_m)?;\n   122\t    generate_vanisher(\n   123\t        aces.shared_info.channel.p,\n   124\t        aces.shared_info.channel.q,\n   125\t        &mut e,\n   126\t    )?;\n   127\t    generate_linear(\n   128\t        aces.shared_info.channel.p,\n   129\t        aces.shared_info.channel.q,\n   130\t        &mut b,\n   131\t    )?;\n   132\t\n   133\t    for i in 0..dim {\n   134\t        let mut tmp = aces.private_key.f0.polies[i].mul(&b, aces.shared_info.channel.q)?;\n   135\t        tmp.poly_mod(&aces.shared_info.pk.u, aces.shared_info.channel.q)?;\n   136\t\n   137\t        result.c1.polies[i].set_zero();\n   138\t        for (idx, coeff) in tmp.coeffs.iter().enumerate() {\n   139\t            if idx < result.c1.polies[i].coeffs.len() {\n   140\t                result.c1.polies[i].coeffs[idx] = *coeff;\n   141\t            }\n   142\t        }\n   143\t    }\n   144\t\n   145\t    result.c2 = aces\n   146\t        .private_key\n   147\t        .f1\n   148\t        .add(&e, aces.shared_info.channel.q)?\n   149\t        .mul(&b, aces.shared_info.channel.q)?;\n   150\t    result.c2 = result.c2.add(&r_m, aces.shared_info.channel.q)?;\n   151\t    result\n   152\t        .c2\n   153\t        .poly_mod(&aces.shared_info.pk.u, aces.shared_info.channel.q)?;\n   154\t\n   155\t    let mut c2 = zero_poly(dim);\n   156\t    for (idx, coeff) in result.c2.coeffs.iter().enumerate() {\n   157\t        if idx < c2.coeffs.len() {\n   158\t            c2.coeffs[idx] = *coeff;\n   159\t        }\n   160\t    }\n   161\t    result.c2 = c2;\n   162\t    result.level = aces.shared_info.channel.p;\n   163\t\n   164\t    Ok(())\n   165\t}\n   166\t/// Decrypt a ciphertext.\n   167\tpub fn aces_decrypt(aces: &Aces, message: &CipherMessage, result: &mut [u64]) -> Result<()> {\n   168\t    if result.len() != 1 {\n   169\t        return Err(err(\"exactly one result slot is required\"));\n   170\t    }\n   171\t\n   172\t    let dim = aces.shared_info.param.dim as usize;\n   173\t    let mut c0_tx = zero_poly(dim * 2);\n   174\t\n   175\t    for i in 0..dim {\n   176\t        let tmp =\n   177\t            message.c1.polies[i].mul(&aces.private_key.x.polies[i], aces.shared_info.channel.q)?;\n   178\t        c0_tx = tmp.add(&c0_tx, aces.shared_info.channel.q)?;\n   179\t    }\n   180\t\n   181\t    c0_tx.fit(aces.shared_info.channel.q)?;\n   182\t    c0_tx = message.c2.sub(&c0_tx, aces.shared_info.channel.q)?;\n   183\t    result[0] = (c0_tx.coef_sum() as u64 % aces.shared_info.channel.q) % aces.shared_info.channel.p;\n   184\t\n   185\t    Ok(())\n   186\t}\n   187\t/// Perform homomorphic addition on two ciphertexts.\n   188\tpub fn aces_add(\n   189\t    a: &CipherMessage,\n   190\t    b: &CipherMessage,\n   191\t    info: &SharedInfo,\n   192\t    result: &mut CipherMessage,\n   193\t) -> Result<()> {\n   194\t    let dim = info.param.dim as usize;\n   195\t    for i in 0..dim {\n   196\t        result.c1.polies[i] = a.c1.polies[i].add(&b.c1.polies[i], info.channel.q)?;\n   197\t        result.c1.polies[i].poly_mod(&info.pk.u, info.channel.q)?;\n   198\t    }\n   199\t\n   200\t    result.c2 = a.c2.add(&b.c2, info.channel.q)?;\n   201\t    result.c2.poly_mod(&info.pk.u, info.channel.q)?;\n   202\t    result.level = a.level.wrapping_add(b.level);\n   203\t    Ok(())\n   204\t}\n   205\t/// Perform homomorphic multiplication on two ciphertexts.\n   206\tpub fn aces_mul(\n   207\t    a: &CipherMessage,\n   208\t    b: &CipherMessage,\n   209\t    info: &SharedInfo,\n   210\t    result: &mut CipherMessage,\n   211\t) -> Result<()> {\n   212\t    let _ = (a, b, info, result);\n   213\t    Ok(())\n   214\t}\n   215\t/// Refresh a ciphertext to mitigate level increase.\n   216\tpub fn aces_refresh(info: &SharedInfo, message: &mut CipherMessage, level: u64) -> Result<()> {\n   217\t    message.c2 = message\n   218\t        .c2\n   219\t        .sub_scaler(level.wrapping_mul(info.channel.p), info.channel.q)?;\n   220\t    message.level = message.level.wrapping_sub(level);\n   221\t    Ok(())\n   222\t}\n","exit_code":0,"status":"completed"}}
