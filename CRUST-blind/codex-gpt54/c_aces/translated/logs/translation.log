{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/matrix.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse crate::common::{randinverse, randrange};\n     2\tuse crate::error::{AcesError, Result};\n     3\t\n     4\tfn err(msg: &str) -> AcesError {\n     5\t    AcesError::GenericError(msg.to_string())\n     6\t}\n     7\t\n     8\t#[derive(Debug, Clone)]\n     9\tpub struct Matrix2D {\n    10\t    pub dim: usize,\n    11\t    pub data: Vec<u64>,\n    12\t}\n    13\timpl Matrix2D {\n    14\t    pub fn new(dim: usize) -> Self {\n    15\t        Self {\n    16\t            dim,\n    17\t            data: vec![0; dim * dim],\n    18\t        }\n    19\t    }\n    20\t    pub fn row(&self, row: usize) -> Option<&[u64]> {\n    21\t        if row >= self.dim {\n    22\t            return None;\n    23\t        }\n    24\t        let start = row * self.dim;\n    25\t        Some(&self.data[start..start + self.dim])\n    26\t    }\n    27\t    pub fn row_mut(&mut self, row: usize) -> Option<&mut [u64]> {\n    28\t        if row >= self.dim {\n    29\t            return None;\n    30\t        }\n    31\t        let start = row * self.dim;\n    32\t        Some(&mut self.data[start..start + self.dim])\n    33\t    }\n    34\t    pub fn get(&self, row: usize, col: usize) -> Option<u64> {\n    35\t        if row >= self.dim || col >= self.dim {\n    36\t            return None;\n    37\t        }\n    38\t        Some(self.data[row * self.dim + col])\n    39\t    }\n    40\t    pub fn set(&mut self, row: usize, col: usize, value: u64) -> Result<()> {\n    41\t        if row >= self.dim || col >= self.dim {\n    42\t            return Err(err(\"matrix index out of bounds\"));\n    43\t        }\n    44\t        self.data[row * self.dim + col] = value;\n    45\t        Ok(())\n    46\t    }\n    47\t}\n    48\t#[derive(Debug, Clone)]\n    49\tpub struct Matrix3D {\n    50\t    pub data: Vec<Matrix2D>,\n    51\t}\n    52\timpl Matrix3D {\n    53\t    pub fn new(size: usize, dim: usize) -> Self {\n    54\t        Self {\n    55\t            data: vec![Matrix2D::new(dim); size],\n    56\t        }\n    57\t    }\n    58\t    pub fn get_mut(&mut self, idx: usize) -> Option<&mut Matrix2D> {\n    59\t        self.data.get_mut(idx)\n    60\t    }\n    61\t}\n    62\tpub fn matrix2d_multiply(m: &Matrix2D, invm: &Matrix2D, modulus: u64) -> Result<Matrix2D> {\n    63\t    if m.dim != invm.dim || modulus == 0 {\n    64\t        return Err(err(\"invalid matrix multiply arguments\"));\n    65\t    }\n    66\t\n    67\t    let dim = m.dim;\n    68\t    let mut result = Matrix2D::new(dim);\n    69\t    for i in 0..dim {\n    70\t        for j in 0..dim {\n    71\t            result.set(i, j, 0)?;\n    72\t            for k in 0..dim {\n    73\t                let current = result\n    74\t                    .get(i, j)\n    75\t                    .ok_or_else(|| err(\"matrix index out of bounds\"))?;\n    76\t                let next = current.wrapping_add(\n    77\t                    m.get(i, k)\n    78\t                        .ok_or_else(|| err(\"matrix index out of bounds\"))?\n    79\t                        .wrapping_mul(\n    80\t                            invm.get(k, j)\n    81\t                                .ok_or_else(|| err(\"matrix index out of bounds\"))?,\n    82\t                        ),\n    83\t                );\n    84\t                result.set(i, j, next)?;\n    85\t            }\n    86\t            let value = result\n    87\t                .get(i, j)\n    88\t                .ok_or_else(|| err(\"matrix index out of bounds\"))?;\n    89\t            result.set(i, j, value % modulus)?;\n    90\t        }\n    91\t    }\n    92\t\n    93\t    Ok(result)\n    94\t}\n    95\tpub fn swap_transform(m: &mut Matrix2D, invm: &mut Matrix2D, modulus: u64) -> Result<()> {\n    96\t    let _ = modulus;\n    97\t    if m.dim != invm.dim || m.dim < 2 {\n    98\t        return Err(err(\"invalid matrix dimensions\"));\n    99\t    }\n   100\t\n   101\t    let dim = m.dim;\n   102\t    let source = randrange(1, (dim - 1) as u64) as usize;\n   103\t    let target = randrange(0, (source - 1) as u64) as usize;\n   104\t\n   105\t    for row in 0..dim {\n   106\t        let left_idx = row * dim + source;\n   107\t        let right_idx = row * dim + target;\n   108\t        m.data.swap(left_idx, right_idx);\n   109\t    }\n   110\t\n   111\t    for col in 0..dim {\n   112\t        let top_idx = source * dim + col;\n   113\t        let bottom_idx = target * dim + col;\n   114\t        invm.data.swap(top_idx, bottom_idx);\n   115\t    }\n   116\t\n   117\t    Ok(())\n   118\t}\n   119\tpub fn linear_mix_transform(m: &mut Matrix2D, invm: &mut Matrix2D, modulus: u64) -> Result<()> {\n   120\t    if m.dim != invm.dim || m.dim < 2 || modulus < 2 {\n   121\t        return Err(err(\"invalid matrix dimensions or modulus\"));\n   122\t    }\n   123\t\n   124\t    let dim = m.dim;\n   125\t    let scale = randrange(1, modulus - 1);\n   126\t    let source = randrange(1, (dim - 1) as u64) as usize;\n   127\t    let target = randrange(0, (source - 1) as u64) as usize;\n   128\t\n   129\t    for row in 0..dim {\n   130\t        let target_val = m\n   131\t            .get(row, target)\n   132\t            .ok_or_else(|| err(\"matrix index out of bounds\"))?;\n   133\t        let source_val = m\n   134\t            .get(row, source)\n   135\t            .ok_or_else(|| err(\"matrix index out of bounds\"))?;\n   136\t        m.set(\n   137\t            row,\n   138\t            target,\n   139\t            target_val.wrapping_add(source_val.wrapping_mul(scale)) % modulus,\n   140\t        )?;\n   141\t\n   142\t        let source_inv = invm\n   143\t            .get(source, row)\n   144\t            .ok_or_else(|| err(\"matrix index out of bounds\"))?;\n   145\t        let target_inv = invm\n   146\t            .get(target, row)\n   147\t            .ok_or_else(|| err(\"matrix index out of bounds\"))?;\n   148\t        invm.set(\n   149\t            source,\n   150\t            row,\n   151\t            source_inv.wrapping_add(target_inv.wrapping_mul(modulus - scale)) % modulus,\n   152\t        )?;\n   153\t    }\n   154\t\n   155\t    Ok(())\n   156\t}\n   157\tpub fn scale_transform(m: &mut Matrix2D, invm: &mut Matrix2D, modulus: u64) -> Result<()> {\n   158\t    if m.dim != invm.dim || modulus == 0 {\n   159\t        return Err(err(\"invalid matrix dimensions or modulus\"));\n   160\t    }\n   161\t\n   162\t    let scale = randinverse(modulus);\n   163\t    for value in &mut m.data {\n   164\t        *value = value.wrapping_mul(scale.first) % modulus;\n   165\t    }\n   166\t    for value in &mut invm.data {\n   167\t        *value = value.wrapping_mul(scale.second) % modulus;\n   168\t    }\n   169\t\n   170\t    Ok(())\n   171\t}\n   172\tpub fn matrix2d_eye(m: &mut Matrix2D) -> Result<()> {\n   173\t    m.data.fill(0);\n   174\t    for row in 0..m.dim {\n   175\t        m.set(row, row, 1)?;\n   176\t    }\n   177\t    Ok(())\n   178\t}\n   179\tpub fn fill_random_invertible_pairs(\n   180\t    m: &mut Matrix2D,\n   181\t    invm: &mut Matrix2D,\n   182\t    modulus: u64,\n   183\t    iterations: usize,\n   184\t) -> Result<()> {\n   185\t    if m.dim != invm.dim {\n   186\t        return Err(err(\"matrix dimensions must match\"));\n   187\t    }\n   188\t\n   189\t    matrix2d_eye(m)?;\n   190\t    matrix2d_eye(invm)?;\n   191\t\n   192\t    for _ in 0..iterations {\n   193\t        match randrange(0, 2) {\n   194\t            0 => swap_transform(m, invm, modulus)?,\n   195\t            1 => scale_transform(m, invm, modulus)?,\n   196\t            _ => linear_mix_transform(m, invm, modulus)?,\n   197\t        }\n   198\t    }\n   199\t\n   200\t    Ok(())\n   201\t}\n","exit_code":0,"status":"completed"}}
