{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/aces_internal.rs | sed -n '1,320p'\"","aggregated_output":"     1\tuse crate::channel::{Channel, Parameters};\n     2\tuse crate::common::{clamp, normal_rand, randrange};\n     3\tuse crate::error::{AcesError, Result};\n     4\tuse crate::matrix::{fill_random_invertible_pairs, matrix2d_multiply, Matrix2D, Matrix3D};\n     5\tuse crate::polynomial::{PolyArray, Polynomial};\n     6\t\n     7\tconst EPROB: f64 = 0.5;\n     8\t\n     9\tfn err(msg: &str) -> AcesError {\n    10\t    AcesError::GenericError(msg.to_string())\n    11\t}\n    12\t\n    13\t/// Generate an error element `rm` over Zq[X]₍u₎.\n    14\tpub fn generate_error(q: u64, message: u64, rm: &mut Polynomial) -> Result<()> {\n    15\t    if rm.coeffs.is_empty() || q == 0 {\n    16\t        return Err(err(\"invalid polynomial or modulus\"));\n    17\t    }\n    18\t\n    19\t    for coeff in &mut rm.coeffs {\n    20\t        *coeff = randrange(0, q) as i64;\n    21\t    }\n    22\t\n    23\t    let last = rm.coeffs.len() - 1;\n    24\t    let shift = (rm.coeffs[last] + (message as i64 - rm.coef_sum())) % q as i64;\n    25\t    rm.coeffs[last] = if shift > 0 { shift } else { shift + q as i64 };\n    26\t    Ok(())\n    27\t}\n    28\t/// Generate a vanisher vector `e` over Zq[X]₍u₎.\n    29\tpub fn generate_vanisher(p: u64, q: u64, e: &mut Polynomial) -> Result<()> {\n    30\t    if e.coeffs.is_empty() || q == 0 {\n    31\t        return Err(err(\"invalid polynomial or modulus\"));\n    32\t    }\n    33\t\n    34\t    let k = if (randrange(0, 1) as f64) < EPROB {\n    35\t        0\n    36\t    } else {\n    37\t        1\n    38\t    };\n    39\t    for coeff in &mut e.coeffs {\n    40\t        *coeff = randrange(0, q) as i64;\n    41\t    }\n    42\t\n    43\t    let last = e.coeffs.len() - 1;\n    44\t    let shift = (e.coeffs[last] + (p as i64 * k) - e.coef_sum()) % q as i64;\n    45\t    e.coeffs[last] = if shift > 0 { shift } else { shift + q as i64 };\n    46\t    Ok(())\n    47\t}\n    48\t/// Generate a linear vector `b` over Zq[X]₍u₎.\n    49\tpub fn generate_linear(p: u64, q: u64, b: &mut Polynomial) -> Result<()> {\n    50\t    if b.coeffs.is_empty() || q == 0 {\n    51\t        return Err(err(\"invalid polynomial or modulus\"));\n    52\t    }\n    53\t\n    54\t    let k = randrange(0, p) as i64;\n    55\t    for coeff in &mut b.coeffs {\n    56\t        *coeff = randrange(0, q) as i64;\n    57\t    }\n    58\t\n    59\t    let last = b.coeffs.len() - 1;\n    60\t    let shift = (b.coeffs[last] + k - b.coef_sum()) % q as i64;\n    61\t    b.coeffs[last] = if shift > 0 { shift } else { shift + q as i64 };\n    62\t    Ok(())\n    63\t}\n    64\t/// Generate the polynomial `u` for the arithmetic channel.\n    65\tpub fn generate_u(channel: &Channel, param: &Parameters, u: &mut Polynomial) -> Result<()> {\n    66\t    let dim = param.dim as usize;\n    67\t    if u.coeffs.len() <= dim || dim == 0 {\n    68\t        return Err(err(\"u polynomial has invalid size\"));\n    69\t    }\n    70\t\n    71\t    u.set_zero();\n    72\t    let mut nonzeros = randrange(param.dim / 2, param.dim - 1) as usize;\n    73\t    let mut zeroes = dim - nonzeros;\n    74\t    u.coeffs[0] = 1;\n    75\t\n    76\t    let mut i = 1usize;\n    77\t    while i < dim {\n    78\t        if nonzeros > 1 {\n    79\t            u.coeffs[i] = randrange(0, channel.q) as i64;\n    80\t            i += 1;\n    81\t            nonzeros -= 1;\n    82\t        } else {\n    83\t            break;\n    84\t        }\n    85\t\n    86\t        if zeroes > 0 {\n    87\t            let sample = clamp(\n    88\t                0,\n    89\t                zeroes as u64,\n    90\t                normal_rand((zeroes / 2) as f64, (zeroes / 2) as f64) as u64,\n    91\t            ) as usize;\n    92\t            let zero = randrange(0, sample as u64) as usize;\n    93\t            for _ in 0..zero {\n    94\t                if i >= dim {\n    95\t                    break;\n    96\t                }\n    97\t                u.coeffs[i] = 0;\n    98\t                i += 1;\n    99\t            }\n   100\t            zeroes -= zero.min(zeroes);\n   101\t        }\n   102\t    }\n   103\t\n   104\t    u.coeffs[dim] = 0;\n   105\t    u.coeffs[dim] = channel.q as i64 - u.coef_sum();\n   106\t    Ok(())\n   107\t}\n   108\t/// Generate the secret key for the arithmetic channel.\n   109\tpub fn generate_secret(\n   110\t    channel: &Channel,\n   111\t    param: &Parameters,\n   112\t    u: &Polynomial,\n   113\t    secret: &mut PolyArray,\n   114\t    lambda: &mut Matrix3D,\n   115\t) -> Result<()> {\n   116\t    let dim = param.dim as usize;\n   117\t    if secret.polies.len() != dim || lambda.data.len() != dim {\n   118\t        return Err(err(\"secret or lambda dimensions do not match\"));\n   119\t    }\n   120\t\n   121\t    let mut m = Matrix2D::new(dim);\n   122\t    let mut invm = Matrix2D::new(dim);\n   123\t    fill_random_invertible_pairs(&mut m, &mut invm, channel.q, 600)?;\n   124\t\n   125\t    for i in 0..dim {\n   126\t        if secret.polies[i].coeffs.len() < dim {\n   127\t            return Err(err(\"secret polynomial has invalid size\"));\n   128\t        }\n   129\t        for j in 0..dim {\n   130\t            secret.polies[i].coeffs[j] =\n   131\t                m.get(j, i)\n   132\t                    .ok_or_else(|| err(\"matrix index out of bounds\"))? as i64;\n   133\t        }\n   134\t    }\n   135\t\n   136\t    let mut arr = m.clone();\n   137\t    for i in 0..dim {\n   138\t        for j in 0..dim {\n   139\t            let mut a_ij_poly = secret.polies[i].mul(&secret.polies[j], channel.q)?;\n   140\t            a_ij_poly.poly_mod(u, channel.q)?;\n   141\t\n   142\t            let pad = dim.saturating_sub(a_ij_poly.coeffs.len());\n   143\t            for row in 0..dim {\n   144\t                let idx = dim - row - 1;\n   145\t                let coeff = if idx < pad {\n   146\t                    0\n   147\t                } else {\n   148\t                    a_ij_poly.coeffs[idx - pad]\n   149\t                };\n   150\t                arr.set(row, j, coeff as u64)?;\n   151\t            }\n   152\t        }\n   153\t\n   154\t        let product = matrix2d_multiply(&invm, &arr, channel.q)?;\n   155\t        let target = lambda\n   156\t            .get_mut(i)\n   157\t            .ok_or_else(|| err(\"lambda index out of bounds\"))?;\n   158\t        *target = product;\n   159\t    }\n   160\t\n   161\t    Ok(())\n   162\t}\n   163\t/// Generate the polynomial array `f0` for the public key.\n   164\tpub fn generate_f0(channel: &Channel, param: &Parameters, f0: &mut PolyArray) -> Result<()> {\n   165\t    let dim = param.dim as usize;\n   166\t    if f0.polies.len() != dim {\n   167\t        return Err(err(\"f0 dimension does not match parameters\"));\n   168\t    }\n   169\t\n   170\t    for poly in &mut f0.polies {\n   171\t        for coeff in &mut poly.coeffs {\n   172\t            *coeff = randrange(0, channel.q.saturating_sub(1)) as i64;\n   173\t        }\n   174\t    }\n   175\t\n   176\t    Ok(())\n   177\t}\n   178\t/// Generate the polynomial `f1` for the public key.\n   179\tpub fn generate_f1(\n   180\t    channel: &Channel,\n   181\t    param: &Parameters,\n   182\t    f0: &PolyArray,\n   183\t    x: &PolyArray,\n   184\t    u: &Polynomial,\n   185\t    f1: &mut Polynomial,\n   186\t) -> Result<()> {\n   187\t    let dim = param.dim as usize;\n   188\t    if f0.polies.len() != dim || x.polies.len() != dim || f1.coeffs.len() < dim {\n   189\t        return Err(err(\"invalid polynomial dimensions\"));\n   190\t    }\n   191\t\n   192\t    let mut f_pre = Polynomial::new(vec![0; dim * 2]);\n   193\t    for i in 0..dim {\n   194\t        let tmp = f0.polies[i].mul(&x.polies[i], channel.q)?;\n   195\t        f_pre = f_pre.add(&tmp, channel.q)?;\n   196\t    }\n   197\t    f_pre.poly_mod(u, channel.q)?;\n   198\t\n   199\t    f1.set_zero();\n   200\t    let diff = f1.coeffs.len().saturating_sub(f_pre.coeffs.len());\n   201\t    for (idx, coeff) in f_pre.coeffs.iter().enumerate() {\n   202\t        if diff + idx < f1.coeffs.len() {\n   203\t            f1.coeffs[diff + idx] = *coeff;\n   204\t        }\n   205\t    }\n   206\t\n   207\t    Ok(())\n   208\t}\n","exit_code":0,"status":"completed"}}
