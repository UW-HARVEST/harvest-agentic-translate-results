ypted str : %.*s\\n\", (int)unpaddedLen, decryptedData);\n\tprintf(\"base64 : %s\\n\", decrypted);\n    assert(memcmp(str, decryptedData, unpaddedLen) == 0);\n\t// if (memcmp(str, decryptedData, unpaddedLen) == 0)\n    //     printf(\"Done.\\n\");\n    // else\n    //     printf(\"Failed.\\n\");\n\n    _mm_free(paddedData);\n    free(ciphertext);\n    free(decryptedData);\n\n    return 0;\n}\n","exit_code":0,"status":"completed"}}
