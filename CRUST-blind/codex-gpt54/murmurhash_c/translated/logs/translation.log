ed = Some(value.to_string());\n    56\t                    }\n    57\t                }\n    58\t                _ => {\n    59\t                    eprintln!(\"unknown option: `{}`\", stripped);\n    60\t                    usage();\n    61\t                    return;\n    62\t                }\n    63\t            }\n    64\t        }\n    65\t    }\n    66\t\n    67\t    let parsed_seed = seed\n    68\t        .as_deref()\n    69\t        .unwrap_or(\"0\")\n    70\t        .parse::<u32>()\n    71\t        .unwrap_or(0);\n    72\t\n    73\t    let stdin = io::stdin();\n    74\t    if stdin.is_terminal() {\n    75\t        return;\n    76\t    }\n    77\t\n    78\t    let mut reader = stdin.lock();\n    79\t    let mut stdout = io::stdout().lock();\n    80\t    let mut buf = Vec::new();\n    81\t\n    82\t    if read_line_like_c(&mut reader, &mut buf).is_none() {\n    83\t        return;\n    84\t    }\n    85\t\n    86\t    let first_hash = murmurhash::murmurhash(&buf, parsed_seed);\n    87\t    let _ = writeln!(stdout, \"{}\", first_hash);\n    88\t\n    89\t    loop {\n    90\t        let mut key = Vec::new();\n    91\t        if read_line_like_c(&mut reader, &mut key).is_none() {\n    92\t            break;\n    93\t        }\n    94\t\n    95\t        let repeated_hash = murmurhash::murmurhash(&buf, parsed_seed);\n    96\t        let _ = writeln!(stdout, \"{}u\", repeated_hash);\n    97\t    }\n    98\t}\n    99\t\n   100\tfn read_line_like_c<R: std::io::BufRead>(reader: &mut R, buf: &mut Vec<u8>) -> Option<()> {\n   101\t    buf.clear();\n   102\t    match reader.read_until(b'\\n', buf) {\n   103\t        Ok(0) | Err(_) => None,\n   104\t        Ok(_) => {\n   105\t            if buf.len() > 1023 {\n   106\t                buf.truncate(1023);\n   107\t            }\n   108\t            Some(())\n   109\t        }\n   110\t    }\n   111\t}\n","exit_code":0,"status":"completed"}}
