{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,240p' src/castom_math.rs\"","aggregated_output":"// Constants\npub const S21_NAN: f64 = f64::NAN;\npub const EPS_6: f64 = 1e-06;\npub const S21_M_E: f64 = 2.71828182845904523536028747135266250;\npub const S21_INFINITY: f64 = f64::INFINITY;\npub const EPS_10: f64 = 1e-10;\npub const S21_M_PI: f64 = 3.14159265358979323846264338327950288;\n\nconst LLONG_MAX_F64: f64 = i64::MAX as f64;\nconst LLONG_MIN_F64: f64 = i64::MIN as f64;\n// Function Declarations\npub fn castom_floor(x: f64) -> f64 {\n    if x >= LLONG_MAX_F64 || x <= LLONG_MIN_F64 || x.is_nan() {\n        return x;\n    }\n    let truncation = x as i64 as f64;\n    truncation - f64::from((truncation > x) as u8)\n}\npub fn castom_tan(x: f64) -> f64 {\n    let mut result = 0.0;\n    if x == 0.0 {\n        result = 0.0;\n    } else if S21_M_PI / 6.0 == x {\n        result = 1.0 / castom_sqrt(3.0);\n    } else if S21_M_PI / 4.0 == x {\n        result = 1.0;\n    } else if S21_M_PI / 3.0 == x {\n        result = castom_sqrt(3.0);\n    } else if S21_M_PI / 2.0 == x {\n        result = S21_INFINITY;\n    } else if S21_M_PI == x {\n        result = 0.0;\n    } else if 3.0 * S21_M_PI / 2.0 == x {\n        result = S21_INFINITY;\n    } else if 2.0 * S21_M_PI == x {\n        result = 0.0;\n    } else {\n        result = castom_sin(x) / castom_cos(x);\n    }\n    result\n}\npub fn castom_atan(x: f64) -> f64 {\n    castom_asin(x / castom_sqrt(1.0 + x * x))\n}\npub fn castom_ceil(x: f64) -> f64 {\n    if x >= LLONG_MAX_F64 || x <= LLONG_MIN_F64 || x.is_nan() {\n        return x;\n    }\n    let truncation = x as i64 as f64;\n    truncation + f64::from((truncation < x) as u8)\n}\npub fn castom_sqrt(x: f64) -> f64 {\n    if x.is_nan() || x < 0.0 {\n        return S21_NAN;\n    }\n    if x.is_infinite() {\n        return S21_INFINITY;\n    }\n    let mut sqrt = x / 2.0;\n    let mut temp = 0.0;\n    while sqrt != temp {\n        temp = sqrt;\n        sqrt = (x / temp + temp) / 2.0;\n    }\n    sqrt\n}\npub fn castom_trunc(x: f64) -> f64 {\n    if x > 0.0 {\n        castom_floor(x)\n    } else {\n        castom_ceil(x)\n    }\n}\npub fn castom_exp(x: f64) -> f64 {\n    let mut sum = 1.0;\n    let mut cur = 1.0;\n    let mut n: u32 = 1;\n\n    while castom_fabs(cur) > EPS_10 {\n        cur *= x / f64::from(n);\n        n += 1;\n        sum += cur;\n    }\n\n    sum\n}\npub fn castom_factorial(n: u64) -> u64 {\n    let mut result = 1_u64;\n    for value in 1..=n {\n        result = result.wrapping_mul(value);\n    }\n    result\n}\npub fn castom_asin(x: f64) -> f64 {\n    let mut term = x;\n    let mut sum = S21_NAN;\n\n    if -1.0 < x && x < 1.0 {\n        sum = term;\n        let squared_x = x * x;\n        let mut k = 1.0;\n        while castom_fabs(term) > EPS_10 {\n            term *= squared_x * k / (k + 1.0);\n            sum += term / (k + 2.0);\n            k += 2.0;\n        }\n    } else if x == 1.0 {\n        sum = S21_M_PI / 2.0;\n    } else if x == -1.0 {\n        sum = -S21_M_PI / 2.0;\n    }\n\n    sum\n}\npub fn castom_fmod(x: f64, y: f64) -> f64 {\n    x - castom_trunc(x / y) * y\n}\npub fn castom_acos(x: f64) -> f64 {\n    S21_M_PI / 2.0 - castom_asin(x)\n}\npub fn castom_pow(base: f64, exp: f64) -> f64 {\n    let result;\n    if base == 0.0 && exp != 0.0 {\n        result = 0.0;\n    } else if exp < 0.0 {\n        result = castom_pow(1.0 / base, -exp);\n    } else if base < 0.0 && exp != (exp as i64) as f64 {\n        result = -S21_NAN;\n    } else if exp == 0.0 {\n        result = 1.0;\n    } else {\n        let mut flag = 1.0;\n        if base < 0.0 && (exp as i64) % 2 != 0 {\n            flag = -1.0;\n        }\n\n        let positive_base = if base < 0.0 { -base } else { base };\n        let div = exp as i64;\n        let mut integer_part = 1.0;\n        for _ in 0..div {\n            integer_part *= positive_base;\n        }\n\n        result = integer_part * castom_exp((exp - div as f64) * castom_log(positive_base)) * flag;\n    }\n    result\n}\npub fn castom_abs(x: i32) -> i32 {\n    if x > 0 { x } else { x.wrapping_neg() }\n}\npub fn castom_log(x: f64) -> f64 {\n    let mut a: u32 = 0;\n    let b: f64;\n\n    if x > 0.0 {\n        let mut c = if x < 1.0 { 1.0 / x } else { x };\n        while {\n            c /= S21_M_E;\n            c > 1.0\n        } {\n            a += 1;\n        }\n\n        c = 1.0 / (c * S21_M_E - 1.0);\n        c = c + c + 1.0;\n        let f = c * c;\n        let mut current = c / 2.0;\n        let mut acc = 0.0;\n        let mut d = 1.0;\n\n        loop {\n            let prev = acc;\n            acc += 1.0 / (d * current);\n            if acc - prev == 0.0 {\n                break;\n            }\n            d += 2.0;\n            current *= f;\n        }\n        b = acc;\n    } else {\n        b = if x == 0.0 {\n            1.0 / 0.0\n        } else {\n            0.0 / 0.0\n        };\n    }\n\n    if x < 1.0 {\n        -(f64::from(a) + b)\n    } else {\n        f64::from(a) + b\n    }\n}\npub fn castom_sin(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut sum = 0.0;\n    for i in 0..=20 {\n        let mut fa = 1.0;\n        let mut pow = 1.0;\n        for j in 1..=(2 * i + 1) {\n            fa *= j as f64;\n            pow *= x;\n        }\n        sum += (if i % 2 == 0 { 1.0 } else { -1.0 } / fa) * pow;\n    }\n    sum\n}\npub fn castom_cos(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut t_s = 0.0;\n    let mut last = 1.0;\n    let mut k = 1.0;\n    while castom_fabs(last) > EPS_10 {\n        t_s += last;\n        last *= -x * x / (2.0 * k - 1.0) / (2.0 * k);\n        k += 1.0;\n    }\n    t_s\n}\npub fn castom_fabs(x: f64) -> f64 {\n    if x > 0.0 { x } else { -x }\n}\n","exit_code":0,"status":"completed"}}
