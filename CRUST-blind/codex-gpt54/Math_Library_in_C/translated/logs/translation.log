n(0.000001), EPS_6);\n  ck_assert_double_eq_tol(atan(2.1), castom_atan(2.1), EPS_6);\n  ck_assert_double_eq_tol(atan(1), castom_atan(1), EPS_6);\n  ck_assert_double_eq_tol(atan(-1), castom_atan(-1), EPS_6);\n  ck_assert_double_eq_tol(atan(-50), castom_atan(-50), EPS_6);\n  ck_assert_double_eq_tol(atan(0), castom_atan(0), EPS_6);\n}\nEND_TEST\n\nSTART_TEST(castom_test_sin) {\n","exit_code":0,"status":"completed"}}
