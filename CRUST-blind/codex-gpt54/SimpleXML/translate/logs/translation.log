ity = if self.capacity == 0 { 1 } else { self.capacity * 2 };\n    53\t            let target_capacity = self.capacity;\n    54\t            if self.data.capacity() < target_capacity {\n    55\t                self.data.reserve_exact(target_capacity - self.data.capacity());\n    56\t            }\n    57\t        }\n    58\t\n    59\t        self.data.insert(index, value);\n    60\t        self.size += 1;\n    61\t    }\n    62\t    pub fn remove_at_index(&mut self, index: usize) -> Option<T> {\n    63\t        if index >= self.size {\n    64\t            return None;\n    65\t        }\n    66\t\n    67\t        self.size -= 1;\n    68\t        Some(self.data.remove(index))\n    69\t    }\n    70\t    pub fn index_of(&self, value: &T) -> Option<usize>\n    71\t    where\n    72\t        T: PartialEq,\n    73\t    {\n    74\t        self.index_of_with_start(value, 0)\n    75\t    }\n    76\t    pub fn index_of_with_start(&self, value: &T, start: usize) -> Option<usize>\n    77\t    where\n    78\t        T: PartialEq,\n    79\t    {\n    80\t        self.data\n    81\t            .iter()\n    82\t            .enumerate()\n    83\t            .skip(start)\n    84\t            .find_map(|(index, item)| (item == value).then_some(index))\n    85\t    }\n    86\t}\n","exit_code":0,"status":"completed"}}
