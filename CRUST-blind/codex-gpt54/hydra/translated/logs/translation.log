{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -c \"nl -ba src/hydra.rs | sed -n '1,320p'\"","aggregated_output":"     1\tuse crossterm::event::{read, Event, KeyCode};\n     2\tuse crossterm::terminal::{disable_raw_mode, enable_raw_mode, size};\n     3\tuse std::fs;\n     4\tuse std::io::{self, Write};\n     5\t\n     6\tpub const RED: &str = \"\\x1b[0;31m\";\n     7\tpub const WHITE: &str = \"\\x1b[0;37m\";\n     8\tpub const COLOR_OFF: &str = \"\\x1b[0m\";\n     9\tpub const PURPLE: &str = \"\\x1b[0;35m\";\n    10\tpub const GREEN: &str = \"\\x1b[0;32m\";\n    11\tpub const YELLOW: &str = \"\\x1b[0;33m\";\n    12\tpub const BLUE: &str = \"\\x1b[0;34m\";\n    13\tpub const RIGHT_MARGIN: usize = 5;\n    14\tpub const CYAN: &str = \"\\x1b[0;36m\";\n    15\tpub const DEFAULT_NAME: &str = \"unnamed\";\n    16\tpub struct Command {\n    17\t    pub key: char,\n    18\t    pub name: String,\n    19\t    pub command: String,\n    20\t    pub children: Option<Box<Command>>,\n    21\t    pub next: Option<Box<Command>>,\n    22\t}\n    23\timpl Command {\n    24\t    pub fn new(key: char, name: String, command: String) -> Self {\n    25\t        Command {\n    26\t            key,\n    27\t            name,\n    28\t            command,\n    29\t            children: None,\n    30\t            next: None,\n    31\t        }\n    32\t    }\n    33\t}\n    34\t\n    35\tfn split_first_char(s: &str) -> Option<(char, &str)> {\n    36\t    let mut chars = s.char_indices();\n    37\t    let (_, first) = chars.next()?;\n    38\t    let next_index = chars.next().map_or(s.len(), |(idx, _)| idx);\n    39\t    Some((first, &s[next_index..]))\n    40\t}\n    41\t\n    42\tfn find_command_mut(c: &mut Command, key: char) -> Option<&mut Command> {\n    43\t    let mut child = c.children.as_deref_mut();\n    44\t    while let Some(node) = child {\n    45\t        if node.key == key {\n    46\t            return Some(node);\n    47\t        }\n    48\t        child = node.next.as_deref_mut();\n    49\t    }\n    50\t    None\n    51\t}\n    52\t\n    53\tpub fn read_field(file: &mut &[u8], field: &str) -> String {\n    54\t    let mut end = 0;\n    55\t    while end < file.len() && file[end] != b',' && file[end] != b'\\n' && file[end] != 0 {\n    56\t        end += 1;\n    57\t    }\n    58\t\n    59\t    if end >= file.len() || file[end] != b',' {\n    60\t        let found = file.get(end).copied().unwrap_or(0) as char;\n    61\t        eprint!(\"Found incorrect end after {}, found: {}\", field, found);\n    62\t        std::process::exit(1);\n    63\t    }\n    64\t\n    65\t    let value = String::from_utf8_lossy(&file[..end]).into_owned();\n    66\t    *file = &file[end + 1..];\n    67\t    value\n    68\t}\n    69\tpub fn load_file(c: &mut Command, file: &str) {\n    70\t    let content = read_file(file);\n    71\t    let mut cursor = content.as_bytes();\n    72\t    while !cursor.is_empty() && cursor[0] != 0 {\n    73\t        read_line(c, &mut cursor);\n    74\t    }\n    75\t}\n    76\tpub fn start(c: &Command) {\n    77\t    let mut current = Some(c);\n    78\t\n    79\t    while let Some(node) = current {\n    80\t        if node.children.is_none() {\n    81\t            break;\n    82\t        }\n    83\t\n    84\t        let last_printed_lines = print_command(node);\n    85\t        let selected = find_command(node, getch());\n    86\t        clear_lines(last_printed_lines);\n    87\t\n    88\t        if let Some(command) = selected {\n    89\t            if command_run(command) > 0 {\n    90\t                return;\n    91\t            }\n    92\t        }\n    93\t\n    94\t        current = selected;\n    95\t    }\n    96\t}\n    97\tpub fn tree_add_command(tree: &mut Command, keys: &str, name: &str, command: &str) {\n    98\t    let Some((key, rest)) = split_first_char(keys) else {\n    99\t        return;\n   100\t    };\n   101\t\n   102\t    if rest.is_empty() {\n   103\t        if let Some(existing) = find_command_mut(tree, key) {\n   104\t            existing.name = name.to_string();\n   105\t            existing.command = command.to_string();\n   106\t        } else {\n   107\t            command_add_child(\n   108\t                tree,\n   109\t                Command::new(key, name.to_string(), command.to_string()),\n   110\t            );\n   111\t        }\n   112\t        return;\n   113\t    }\n   114\t\n   115\t    if find_command(tree, key).is_none() {\n   116\t        command_add_child(\n   117\t            tree,\n   118\t            Command::new(key, DEFAULT_NAME.to_string(), String::new()),\n   119\t        );\n   120\t    }\n   121\t\n   122\t    if let Some(child) = find_command_mut(tree, key) {\n   123\t        tree_add_command(child, rest, name, command);\n   124\t    }\n   125\t}\n   126\tpub fn read_line(c: &mut Command, file: &mut &[u8]) {\n   127\t    let key = read_field(file, \"key\");\n   128\t    let name = read_field(file, \"name\");\n   129\t    let command = read_until_eol(file);\n   130\t    tree_add_command(c, &key, &name, &command);\n   131\t}\n   132\tpub fn command_add_child(c: &mut Command, child: Command) {\n   133\t    let mut child = Box::new(child);\n   134\t\n   135\t    if c.children.as_ref().map_or(true, |first| first.key > child.key) {\n   136\t        child.next = c.children.take();\n   137\t        c.children = Some(child);\n   138\t        return;\n   139\t    }\n   140\t\n   141\t    let mut current = c.children.as_mut().expect(\"child list must exist\");\n   142\t    while current\n   143\t        .next\n   144\t        .as_ref()\n   145\t        .map_or(false, |next| next.key <= child.key)\n   146\t    {\n   147\t        current = current.next.as_mut().expect(\"next child must exist\");\n   148\t    }\n   149\t\n   150\t    child.next = current.next.take();\n   151\t    current.next = Some(child);\n   152\t}\n   153\tpub fn getch() -> char {\n   154\t    if enable_raw_mode().is_err() {\n   155\t        return '\\0';\n   156\t    }\n   157\t\n   158\t    loop {\n   159\t        match read() {\n   160\t            Ok(Event::Key(event)) => {\n   161\t                let key = match event.code {\n   162\t                    KeyCode::Char(c) => c,\n   163\t                    KeyCode::Enter => '\\n',\n   164\t                    KeyCode::Tab => '\\t',\n   165\t                    KeyCode::Backspace => '\\u{8}',\n   166\t                    KeyCode::Esc => '\\u{1b}',\n   167\t                    _ => continue,\n   168\t                };\n   169\t                let _ = disable_raw_mode();\n   170\t                return key;\n   171\t            }\n   172\t            Ok(_) => continue,\n   173\t            Err(_) => {\n   174\t                let _ = disable_raw_mode();\n   175\t                return '\\0';\n   176\t            }\n   177\t        }\n   178\t    }\n   179\t}\n   180\tpub fn print_command(c: &Command) -> i32 {\n   181\t    let width = size().map(|(width, _)| width as usize).unwrap_or(80);\n   182\t    let mut lines = 0;\n   183\t\n   184\t    if !c.name.is_empty() {\n   185\t        eprint!(\"{}{}:{}\\n\", BLUE, c.name, COLOR_OFF);\n   186\t        lines += 1;\n   187\t    }\n   188\t\n   189\t    let mut max_line_width = 0usize;\n   190\t    let mut child = c.children.as_deref();\n   191\t    while let Some(node) = child {\n   192\t        max_line_width = max_line_width.max(node.name.len());\n   193\t        child = node.next.as_deref();\n   194\t    }\n   195\t\n   196\t    max_line_width = (max_line_width + RIGHT_MARGIN).min(width);\n   197\t    let items_per_row = (width / (max_line_width + 5)).max(1);\n   198\t\n   199\t    child = c.children.as_deref();\n   200\t    let mut current_item = 0usize;\n   201\t    while let Some(node) = child {\n   202\t        current_item += 1;\n   203\t\n   204\t        if node.children.is_some() {\n   205\t            eprint!(\n   206\t                \"{}{}{} {}➔{} {}+{:<width$}{}\",\n   207\t                YELLOW,\n   208\t                node.key,\n   209\t                COLOR_OFF,\n   210\t                PURPLE,\n   211\t                COLOR_OFF,\n   212\t                BLUE,\n   213\t                node.name,\n   214\t                COLOR_OFF,\n   215\t                width = max_line_width\n   216\t            );\n   217\t        } else {\n   218\t            eprint!(\n   219\t                \"{}{}{} {}➔{}  {:<width$}\",\n   220\t                YELLOW,\n   221\t                node.key,\n   222\t                COLOR_OFF,\n   223\t                PURPLE,\n   224\t                COLOR_OFF,\n   225\t                node.name,\n   226\t                width = max_line_width\n   227\t            );\n   228\t        }\n   229\t\n   230\t        if current_item % items_per_row == 0 {\n   231\t            eprint!(\"\\n\");\n   232\t            lines += 1;\n   233\t        }\n   234\t\n   235\t        child = node.next.as_deref();\n   236\t    }\n   237\t\n   238\t    eprint!(\"\\n\");\n   239\t    lines += 1;\n   240\t    lines\n   241\t}\n   242\tpub fn clear_lines(count: i32) {\n   243\t    let mut stderr = io::stderr().lock();\n   244\t    for _ in 0..count.max(0) {\n   245\t        let _ = stderr.write_all(b\"\\x1b[A\\r\\x1b[2K\");\n   246\t    }\n   247\t    let _ = stderr.flush();\n   248\t}\n   249\tpub fn find_command(c: &Command, key: char) -> Option<&Command> {\n   250\t    let mut child = c.children.as_deref();\n   251\t    while let Some(node) = child {\n   252\t        if node.key == key {\n   253\t            return Some(node);\n   254\t        }\n   255\t        child = node.next.as_deref();\n   256\t    }\n   257\t    None\n   258\t}\n   259\tpub fn read_until_eol(file: &mut &[u8]) -> String {\n   260\t    let mut end = 0;\n   261\t    while end < file.len() && file[end] != b'\\n' && file[end] != 0 {\n   262\t        end += 1;\n   263\t    }\n   264\t\n   265\t    let value = String::from_utf8_lossy(&file[..end]).into_owned();\n   266\t    *file = if end < file.len() && file[end] == b'\\n' {\n   267\t        &file[end + 1..]\n   268\t    } else {\n   269\t        &file[end..]\n   270\t    };\n   271\t    value\n   272\t}\n   273\tpub fn read_file(file: &str) -> String {\n   274\t    match fs::read(file) {\n   275\t        Ok(content) => String::from_utf8_lossy(&content).into_owned(),\n   276\t        Err(err) => {\n   277\t            eprintln!(\"Failed to open file: {}\", err);\n   278\t            std::process::exit(1);\n   279\t        }\n   280\t    }\n   281\t}\n   282\tpub fn command_run(c: &Command) -> i32 {\n   283\t    if c.command.is_empty() {\n   284\t        return 0;\n   285\t    }\n   286\t\n   287\t    let mut stdout = io::stdout().lock();\n   288\t    if stdout.write_all(c.command.as_bytes()).is_ok() && stdout.flush().is_ok() {\n   289\t        c.command.len() as i32\n   290\t    } else {\n   291\t        0\n   292\t    }\n   293\t}\n","exit_code":0,"status":"completed"}}
