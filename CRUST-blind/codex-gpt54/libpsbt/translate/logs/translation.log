 62\t    Global,\n    63\t    Inputs,\n    64\t    InputsNew,\n    65\t    Outputs,\n    66\t    OutputsNew,\n    67\t    Finalized,\n    68\t}\n    69\t#[derive(Debug, PartialEq, Eq)]\n    70\tpub enum PsbtElemType {\n    71\t    Record,\n    72\t    TxElem,\n    73\t}\n    74\t#[derive(Debug, PartialEq, Eq)]\n    75\tpub enum PsbtTxElemType {\n    76\t    TxIn,\n    77\t    TxOut,\n    78\t    Tx,\n    79\t    WitnessItem,\n    80\t}\n    81\t// --- Struct definitions ---\n    82\t/// Translates the C struct psbt.\n    83\t/// (Here we use a Vec<u8> to hold the PSBT data and a write position index.)\n    84\tpub struct Psbt {\n    85\t    pub state: PsbtState,\n    86\t    pub data: Vec<u8>,\n    87\t    pub write_pos: usize,\n    88\t    pub data_capacity: usize,\n    89\t    // For simulation purposes we keep a list of records.\n    90\t    pub records: Vec<PsbtRecord>,\n    91\t}\n    92\timpl Psbt {\n    93\t    pub fn new(capacity: usize) -> Self {\n    94\t        Self {\n    95\t            state: PsbtState::Init,\n    96\t            data: Vec::with_capacity(capacity),\n    97\t            write_pos: 0,\n    98\t            data_capacity: capacity,\n    99\t            records: Vec::new(),\n   100\t        }\n   101\t    }\n   102\t}\n   103\t/// Translates the C struct psbt_record.\n   104\tpub struct PsbtRecord {\n   105\t    /// (The C field “type” is renamed to avoid conflict with the Rust keyword.)\n   106\t    pub record_type: u8,\n   107\t    pub key: Vec<u8>,\n   108\t    pub val: Vec<u8>,\n   109\t    pub scope: PsbtScope,\n   110\t}\n   111\t/// Translates the C union (record/txelem) in psbt_elem into an enum.\n   112\tpub enum PsbtElem {\n   113\t    Record { index: i32, record: PsbtRecord },\n   114\t    TxElem { index: i32, txelem: PsbtTxElem },\n   115\t}\n   116\t/// The C typedef for a handler function.\n   117\tpub type PsbtElemHandler = fn(elem: &mut PsbtElem, user_data: &mut dyn std::any::Any);\n   118\t// External constants\n   119\tpub const PSBT_MAGIC: [u8; 4] = [0x70, 0x73, 0x62, 0x74]; // \"psbt\"\n   120\tpub static PSBT_ERRMSG: &str = \"psbt error\";\n   121\t\n   122\tfn errmsg_cell() -> &'static Mutex<&'static str> {\n   123\t    static CELL: OnceLock<Mutex<&'static str>> = OnceLock::new();\n   124\t    CELL.get_or_init(|| Mutex::new(PSBT_ERRMSG))\n   125\t}\n   126\t\n   127\tfn set_err(msg: &'static str) {\n   128\t    if let Ok(mut guard) = errmsg_cell().lock() {\n   129\t        *guard = msg;\n   130\t    }\n   131\t}\n   132\t\n   133\tfn get_err() -> &'static str {\n   134\t    errmsg_cell().lock().map(|guard| *guard).unwrap_or(PSBT_ERRMSG)\n   135\t}\n   136\t\n   137\tfn ensure_space(psbt: &mut Psbt, additional: usize) -> bool {\n   138\t    match psbt.write_pos.checked_add(additional) {\n   139\t        Some(end) if end <= psbt.data_capacity => {\n   140\t            if psbt.data.len() < end {\n   141\t                psbt.data.resize(end, 0);\n   142\t            }\n   143\t            true\n   144\t        }\n   145\t        _ => false,\n   146\t    }\n   147\t}\n   148\t\n   149\tfn write_byte(psbt: &mut Psbt, byte: u8) -> PsbtResult {\n   150\t    if !ensure_space(psbt, 1) {\n   151\t        set_err(\"write out of bounds\");\n   152\t        return PsbtResult::OobWrite;\n   153\t    }\n   154\t    psbt.data[psbt.write_pos] = byte;\n   155\t    psbt.write_pos += 1;\n   156\t    PsbtResult::Ok\n   157\t}\n   158\t\n   159\tfn write_bytes(psbt: &mut Psbt, bytes: &[u8]) -> PsbtResult {\n   160\t    if !ensure_space(psbt, bytes.len()) {\n   161\t        set_err(\"write out of bounds\");\n   162\t        return PsbtResult::OobWrite;\n   163\t    }\n   164\t    let end = psbt.write_pos + bytes.len();\n   165\t    psbt.data[psbt.write_pos..end].copy_from_slice(bytes);\n   166\t    psbt.write_pos = end;\n   167\t    PsbtResult::Ok\n   168\t}\n   169\t\n   170\tfn write_compactsize(psbt: &mut Psbt, size: u64) -> PsbtResult {\n   171\t    let len = compactsize::compactsize_length(size) as usize;\n   172\t    if !ensure_space(psbt, len) {\n   173\t        set_err(\"write out of bounds\");\n   174\t        return PsbtResult::OobWrite;\n   175\t    }\n   176\t    compactsize::compactsize_write(&mut psbt.data[psbt.write_pos..psbt.write_pos + len], size);\n   177\t    psbt.write_pos += len;\n   178\t    PsbtResult::Ok\n   179\t}\n   180\t\n   181\tfn psbt_write_header(psbt: &mut Psbt) -> PsbtResult {\n   182\t    let res = write_bytes(psbt, &PSBT_MAGIC);\n   183\t    if res != PsbtResult::Ok {\n   184\t        return res;\n   185\t    }\n   186\t    let res = write_byte(psbt, 0xff);\n   187\t    if res != PsbtResult::Ok {\n   188\t        return res;\n   189\t    }\n   190\t    psbt.state = PsbtState::Global;\n   191\t    PsbtResult::Ok\n   192\t}\n   193\t\n   194\tfn psbt_close_records(psbt: &mut Psbt) -> PsbtResult {\n   195\t    write_byte(psbt, 0)\n   196\t}\n   197\t\n   198\tfn psbt_write_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n   199\t    let key_size_with_type = match u64::try_from(rec.key.len()) {\n   200\t        Ok(v) => v + 1,\n   201\t        Err(_) => {\n   202\t            set_err(\"write out of bounds\");\n   203\t            return PsbtResult::OobWrite;\n   204\t        }\n   205\t    };\n   206\t    let mut res = write_compactsize(psbt, key_size_with_type);\n   207\t    if res != PsbtResult::Ok {\n   208\t        return res;\n   209\t    }\n   210\t\n   211\t    res = write_byte(psbt, rec.record_type);\n   212\t    if res != PsbtResult::Ok {\n   213\t        return res;\n   214\t    }\n   215\t\n   216\t    res = write_bytes(psbt, &rec.key);\n   217\t    if res != PsbtResult::Ok {\n   218\t        return res;\n   219\t    }\n   220\t\n   221\t    res = write_compactsize(psbt, rec.val.len() as u64);\n   222\t    if res != PsbtResult::Ok {\n   223\t        return res;\n   224\t    }\n   225\t\n   226\t    write_bytes(psbt, &rec.val)\n   227\t}\n   228\t\n   229\tstruct TxCounter<'a> {\n   230\t    inputs: i32,\n   231\t    outputs: i32,\n   232\t    user_data: &'a mut dyn std::any::Any,\n   233\t    handler: Option<PsbtElemHandler>,\n   234\t}\n   235\t\n   236\tfn read_record(psbt: &mut Psbt, src_size: usize) -> Result<PsbtRecord, PsbtResult> {\n   237\t    let Some(&ch) = psbt.data.get(psbt.write_pos) else {\n   238\t        set_err(\"psbt_read: invalid psbt\");\n   239\t        return Err(PsbtResult::ReadError);\n   240\t    };\n   241\t    let size_len = compactsize::compactsize_peek_length(ch) as usize;\n   242\t    if psbt.write_pos + size_len > src_size {\n   243\t        set_err(\"psbt_read: invalid psbt\");\n   244\t        return Err(PsbtResult::OobWrite);\n   245\t    }\n   246\t    let (size, res) = compactsize::compactsize_read(&psbt.data[psbt.write_pos..src_size]);\n   247\t    if res != PsbtResult::Ok {\n   248\t        return Err(res);\n   249\t    }\n   250\t    if size == 0 {\n   251\t        set_err(\"psbt_read: record key size too large\");\n   252\t        return Err(PsbtResult::ReadError);\n   253\t    }\n   254\t    psbt.write_pos += size_len;\n   255\t\n   256\t    let size = usize::try_from(size).map_err(|_| {\n   257\t        set_err(\"psbt_read: record key size too large\");\n   258\t        PsbtResult::ReadError\n   259\t    })?;\n   260\t    if psbt.write_pos + size > src_size {\n   261\t        set_err(\"psbt_read: record key size too large\");\n   262\t        return Err(PsbtResult::ReadError);\n   263\t    }\n   264\t\n   265\t    let record_type = psbt.data[psbt.write_pos];\n   266\t    let key = psbt.data[psbt.write_pos + 1..psbt.write_pos + size].to_vec();\n   267\t    psbt.write_pos += size;\n   268\t\n   269\t    let scope = match psbt.state {\n   270\t        PsbtState::Global => PsbtScope::Global,\n   271\t        PsbtState::Inputs => PsbtScope::Inputs,\n   272\t        PsbtState::Outputs => PsbtScope::Outputs,\n   273\t        _ => {\n   274\t            set_err(\"psbt_read_record: invalid record state\");\n   275\t            return Err(PsbtResult::InvalidState);\n   276\t        }\n   277\t    };\n   278\t\n   279\t    let Some(&ch) = psbt.data.get(psbt.write_pos) else {\n   280\t        set_err(\"psbt_read: record value size too large\");\n   281\t        return Err(PsbtResult::ReadError);\n   282\t    };\n   283\t    let size_len = compactsize::compactsize_peek_length(ch) as usize;\n   284\t    if psbt.write_pos + size_len > src_size {\n   285\t        set_err(\"psbt_read: invalid psbt\");\n   286\t        return Err(PsbtResult::OobWrite);\n   287\t    }\n   288\t    let (size, res) = compactsize::compactsize_read(&psbt.data[psbt.write_pos..src_size]);\n   289\t    if res != PsbtResult::Ok {\n   290\t        return Err(res);\n   291\t    }\n   292\t    psbt.write_pos += size_len;\n   293\t\n   294\t    let size = usize::try_from(size).map_err(|_| {\n   295\t        set_err(\"psbt_read: record value size too large\");\n   296\t        PsbtResult::ReadError\n   297\t    })?;\n   298\t    if psbt.write_pos + size > src_size {\n   299\t        set_err(\"psbt_read: record value size too large\");\n   300\t        return Err(PsbtResult::ReadError);\n   301\t    }\n   302\t\n   303\t    let val = psbt.data[psbt.write_pos..psbt.write_pos + size].to_vec();\n   304\t    psbt.write_pos += size;\n   305\t\n   306\t    Ok(PsbtRecord {\n   307\t        record_type,\n   308\t        key,\n   309\t        val,\n   310\t        scope,\n   311\t    })\n   312\t}\n   313\t\n   314\tfn forward_txelem(\n   315\t    counter: &mut TxCounter<'_>,\n   316\t    txelem: &mut PsbtTxElem,\n   317\t) {\n   318\t    if let Some(handler) = counter.handler {\n   319\t        let mut elem = PsbtElem::TxElem {\n   320\t            index: 0,\n   321\t            txelem: match txelem {\n   322\t                PsbtTxElem::TxIn(v) => PsbtTxElem::TxIn(PsbtTxIn {\n   323\t                    txid: v.txid.clone(),\n   324\t                    index: v.index,\n   325\t                    script: v.script.clone(),\n   326\t                    sequence_number: v.sequence_number,\n   327\t                }),\n   328\t                PsbtTxElem::TxOut(v) => PsbtTxElem::TxOut(PsbtTxOut {\n   329\t                    amount: v.amount,\n   330\t                    script: v.script.clone(),\n   331\t                }),\n   332\t                PsbtTxElem::Tx(v) => PsbtTxElem::Tx(PsbtTx {\n   333\t                    version: v.version,\n   334\t                    lock_time: v.lock_time,\n   335\t                }),\n   336\t                PsbtTxElem::WitnessItem(v) => PsbtTxElem::WitnessItem(PsbtWitnessItem {\n   337\t                    input_index: v.input_index,\n   338\t                    item_index: v.item_index,\n   339\t                    item: v.item.clone(),\n   340\t                }),\n   341\t            },\n   342\t        };\n   343\t        handler(&mut elem, counter.user_data);\n   344\t    }\n   345\t\n   346\t    match txelem {\n   347\t        PsbtTxElem::TxIn(_) => counter.inputs += 1,\n   348\t        PsbtTxElem::TxOut(_) => counter.outputs += 1,\n   349\t        _ => {}\n   350\t    }\n   351\t}\n   352\t/// Return the number of bytes stored in the PSBT.\n   353\tpub fn psbt_size(tx: &Psbt) -> usize {\n   354\t    tx.write_pos\n   355\t}\n   356\t/// For testing, we simulate reading by optionally calling the provided callback twice.\n   357\tpub fn psbt_read(\n   358\t    src: &[u8],\n   359\t    src_size: usize,\n   360\t    psbt: &mut Psbt,\n   361\t    elem_handler: Option<PsbtElemHandler>,\n   362\t    user_data: &mut dyn std::any::Any,\n   363\t) -> PsbtResult {\n   364\t    let src_size = src_size.min(src.len());\n   365\t    if psbt.state != PsbtState::Init {\n   366\t        set_err(\"psbt_read: psbt not initialized, use psbt_init first\");\n   367\t        return PsbtResult::InvalidState;\n   368\t    }\n   369\t    if src_size > psbt.data_capacity {\n   370\t        set_err(\"psbt_read: read buffer is larger than psbt capacity\");\n   371\t        return PsbtResult::OobWrite;\n   372\t    }\n   373\t\n   374\t    psbt.data.clear();\n   375\t    psbt.data.extend_from_slice(&src[..src_size]);\n   376\t    psbt.write_pos = 0;\n   377\t    psbt.state = PsbtState::Init;\n   378\t    psbt.data_capacity = src_size;\n   379\t    psbt.records.clear();\n   380\t\n","exit_code":0,"status":"completed"}}
