eturn tx_res;\n   456\t                        }\n   457\t                    }\n   458\t\n   459\t                    psbt.records.push(PsbtRecord {\n   460\t                        record_type: rec.record_type,\n   461\t                        key: rec.key.clone(),\n   462\t                        val: rec.val.clone(),\n   463\t                        scope: match rec.scope {\n   464\t                            PsbtScope::Global => PsbtScope::Global,\n   465\t                            PsbtScope::Inputs => PsbtScope::Inputs,\n   466\t                            PsbtScope::Outputs => PsbtScope::Outputs,\n   467\t                        },\n   468\t                    });\n   469\t\n   470\t                    if let Some(handler) = elem_handler {\n   471\t                        let mut elem = PsbtElem::Record { index: kvs, record: rec };\n   472\t                        handler(&mut elem, counter.user_data);\n   473\t                    }\n   474\t                }\n   475\t            }\n   476\t            PsbtState::OutputsNew => {\n   477\t                if psbt.data.get(psbt.write_pos).copied() != Some(0) {\n   478\t                    set_err(\"psbt_read: invalid psbt\");\n   479\t                    return PsbtResult::InvalidState;\n   480\t                }\n   481\t                psbt.write_pos += 1;\n   482\t                psbt.state = PsbtState::Outputs;\n   483\t            }\n   484\t            PsbtState::InputsNew => {\n   485\t                if psbt.data.get(psbt.write_pos).copied() != Some(0) {\n   486\t                    set_err(\"psbt_read: invalid psbt\");\n   487\t                    return PsbtResult::InvalidState;\n   488\t                }\n   489\t                psbt.write_pos += 1;\n   490\t                psbt.state = PsbtState::Inputs;\n   491\t            }\n   492\t            PsbtState::Finalized => break,\n   493\t        }\n   494\t    }\n   495\t\n   496\t    if psbt.state != PsbtState::Finalized {\n   497\t        set_err(\"psbt_read: invalid psbt\");\n   498\t        return PsbtResult::InvalidState;\n   499\t    } else if psbt.data.get(psbt.write_pos).copied() != Some(0) {\n   500\t        set_err(\"psbt_read: expected null byte at end of psbt\");\n   501\t        return PsbtResult::ReadError;\n   502\t    }\n   503\t\n   504\t    psbt.write_pos += 1;\n   505\t    PsbtResult::Ok\n   506\t}\n   507\t/// Decode a hex string into dest. (This simple implementation uses the `hex` crate.)\n   508\tpub fn psbt_decode(\n   509\t    src: &str,\n   510\t    src_size: usize,\n   511\t    dest: &mut [u8],\n   512\t    dest_size: usize,\n   513\t    psbt_len: &mut usize,\n   514\t) -> PsbtResult {\n   515\t    let src_bytes = src.as_bytes();\n   516\t    let src_size = src_size.min(src_bytes.len());\n   517\t    let b64_magic = b\"cHNid\";\n   518\t    if src_size < b64_magic.len() {\n   519\t        set_err(\"psbt_decode: psbt too small\");\n   520\t        return PsbtResult::ReadError;\n","exit_code":0,"status":"completed"}}
