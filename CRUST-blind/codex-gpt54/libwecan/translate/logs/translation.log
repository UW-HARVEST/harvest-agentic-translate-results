   target\n   101\t}\n   102\t/// Insert a signal value into a CAN frame.\n   103\t///\n   104\t/// * `frame`     – mutable byte slice.\n   105\t/// * `startbit`  – signal start bit.\n   106\t/// * `len`       – signal length in bits.\n   107\t/// * `can_value` – signal value (as raw bits).\n   108\t/// * `endianness`– INTEL or MOTOROLA.\n   109\tpub fn insert(frame: &mut [u8], startbit: u16, len: u8, can_value: u64, endianness: u8) {\n   110\t    if len == 0 {\n   111\t        return;\n   112\t    }\n   113\t\n   114\t    let (offset_lsb, byte_idx_lsb, byte_idx_msb) = compute_indexes(startbit, len, endianness);\n   115\t    let mut target = frame_to_local(frame, byte_idx_lsb, byte_idx_msb, endianness);\n   116\t\n   117\t    let mask = bitmask(len);\n   118\t    let erase_mask = !(mask << offset_lsb);\n   119\t\n   120\t    target = (target & erase_mask) | (can_value << offset_lsb);\n   121\t\n   122\t    write_local_to_frame(frame, byte_idx_lsb, byte_idx_msb, endianness, target);\n   123\t}\n   124\t/// Encode an unsigned 64‑bit physical value into the CAN frame.\n   125\tpub fn encode_uint64_t(\n   126\t    frame: &mut [u8],\n   127\t    phy_value: u64,\n   128\t    startbit: u16,\n   129\t    len: u8,\n   130\t    endianness: u8,\n   131\t    factor: f64,\n   132\t    offset: f64,\n   133\t) {\n   134\t    let can_value = (((phy_value as f64) - offset) / factor) as u64;\n   135\t    insert(frame, startbit, len, can_value, endianness);\n   136\t}\n   137\t/// Encode a signed 64‑bit physical value into the CAN frame.\n   138\tpub fn encode_int64_t(\n   139\t    frame: &mut [u8],\n   140\t    phy_value: i64,\n   141\t    startbit: u16,\n   142\t    len: u8,\n   143\t    endianness: u8,\n   144\t    factor: f64,\n   145\t    offset: f64,\n   146\t) {\n   147\t    let can_value = ((((phy_value as f64) - offset) / factor) as i64) as u64;\n   148\t    insert(frame, startbit, len, can_value, endianness);\n   149\t}\n   150\t/// Encode a double‑precision (f64) physical value.\n   151\tpub fn encode_double(\n   152\t    frame: &mut [u8],\n   153\t    phy_value: f64,\n   154\t    startbit: u16,\n   155\t    len: u8,\n   156\t    endianness: u8,\n   157\t    factor: f64,\n   158\t    offset: f64,\n   159\t) {\n   160\t    let can_value = (((phy_value - offset) / factor) as i64) as u64;\n   161\t    insert(frame, startbit, len, can_value, endianness);\n   162\t}\n   163\t/// Encode a single‑precision (f32) physical value.\n   164\tpub fn encode_float(\n   165\t    frame: &mut [u8],\n   166\t    phy_value: f32,\n   167\t    startbit: u16,\n   168\t    len: u8,\n   169\t    endianness: u8,\n   170\t    factor: f64,\n   171\t    offset: f64,\n   172\t) {\n   173\t    let can_value = ((((phy_value as f64) - offset) / factor) as i64) as u64;\n   174\t    insert(frame, startbit, len, can_value, endianness);\n   175\t}\n   176\t/// Decode an unsigned 64‑bit value from the CAN frame.\n   177\tpub fn decode_uint64_t(\n   178\t    frame: &[u8],\n   179\t    startbit: u16,\n   180\t    len: u8,\n   181\t    endianness: u8,\n   182\t    factor: f64,\n   183\t    offset: f64,\n   184\t) -> u64 {\n   185\t    let can_value = extract(frame, startbit, len, UNSIGNED, endianness);\n   186\t    ((can_value as f64) * factor + offset) as u64\n   187\t}\n   188\t/// Decode a signed 64‑bit value from the CAN frame.\n   189\tpub fn decode_int64_t(\n   190\t    frame: &[u8],\n   191\t    startbit: u16,\n   192\t    len: u8,\n   193\t    endianness: u8,\n   194\t    factor: f64,\n   195\t    offset: f64,\n   196\t) -> i64 {\n   197\t    let can_value = extract(frame, startbit, len, SIGNED, endianness) as i64;\n   198\t    ((can_value as f64) * factor + offset) as i64\n   199\t}\n   200\t/// Decode a double‑precision (f64) physical value.\n   201\tpub fn decode_double(\n   202\t    frame: &[u8],\n   203\t    startbit: u16,\n   204\t    len: u8,\n   205\t    endianness: u8,\n   206\t    factor: f64,\n   207\t    offset: f64,\n   208\t) -> f64 {\n   209\t    let c