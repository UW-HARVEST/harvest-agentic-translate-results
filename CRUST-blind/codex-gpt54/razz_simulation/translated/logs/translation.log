deck will be invalid.\n *\n * @param [in] d_ptr the pointer pointing to the card deck to be freed.\n */\nvoid\ndestroy_deck (card_deck **d_ptr);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /* CARD_H */\n","exit_code":0,"status":"completed"}}
