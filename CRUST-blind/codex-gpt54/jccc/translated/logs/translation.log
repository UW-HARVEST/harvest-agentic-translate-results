{"type":"item.completed","item":{"id":"item_77","type":"command_execution","command":"/bin/zsh -c \"nl -ba src/lex.rs | sed -n '1,360p'\"","aggregated_output":"     1\tuse crate::token::{Token, TokenType};\n     2\tuse std::io::{Read, Seek, SeekFrom};\n     3\tpub const TOKEN_PUTBACKS: usize = 5;\n     4\t/// Represents a lexer for tokenizing input.\n     5\t#[derive(Debug)]\n     6\tpub struct Lexer {\n     7\t/// An optional file; in C this would be a FILE*, here we keep it as a File for demonstration.\n     8\tpub fp: Option<std::fs::File>,\n     9\tpub current_file: String,\n    10\tpub buffer: [u8; 1],\n    11\tpub position: i64,\n    12\tpub last_column: i32,\n    13\tpub column: i32,\n    14\tpub line: i32,\n    15\tpub unlexed: [Token; TOKEN_PUTBACKS],\n    16\tpub unlexed_count: u32,\n    17\t}\n    18\t\n    19\tconst SINGLE_CHAR_TOKENS: &str = \"(){}[];~#,.:?~\";\n    20\tconst OPERATOR_STRINGS: &[&str] = &[\n    21\t    \"-\", \"+\", \"*\", \"/\", \"=\", \":\", \"%\", \"&\", \"&&\", \"|\", \"||\", \"-=\", \"+=\", \"++\", \"--\", \"/=\",\n    22\t    \"*=\", \"%=\", \"&=\", \"|=\", \"&&=\", \"||=\", \">\", \"<\", \"<=\", \">=\", \"<<\", \">>\", \"!\", \"==\", \"!=\",\n    23\t    \"^\", \"^=\", \"->\", \"<<=\", \">>=\",\n    24\t];\n    25\t\n    26\tfn set_token_basic_fields(l: &Lexer, t: &mut Token) {\n    27\t    t.source_file = l.current_file.clone();\n    28\t    t.line = l.line;\n    29\t    t.column = l.column;\n    30\t}\n    31\t/// Gets the next character from the lexer.\n    32\tpub fn lexer_getchar(l: &mut Lexer) -> i32 {\n    33\t    l.position += 1;\n    34\t    l.last_column = l.column;\n    35\t\n    36\t    let Some(fp) = l.fp.as_mut() else {\n    37\t        l.column += 1;\n    38\t        return -1;\n    39\t    };\n    40\t\n    41\t    let mut byte = [0_u8; 1];\n    42\t    match fp.read(&mut byte) {\n    43\t        Ok(1) => {\n    44\t            l.buffer[0] = byte[0];\n    45\t            if byte[0] == b'\\n' {\n    46\t                l.line += 1;\n    47\t                l.column = 0;\n    48\t            } else {\n    49\t                l.column += 1;\n    50\t            }\n    51\t            i32::from(byte[0])\n    52\t        }\n    53\t        Ok(0) | Err(_) => {\n    54\t            l.buffer[0] = 0;\n    55\t            l.column += 1;\n    56\t            -1\n    57\t        }\n    58\t        Ok(_) => {\n    59\t            l.column += 1;\n    60\t            -1\n    61\t        }\n    62\t    }\n    63\t}\n    64\t/// Retrieves the next token from the lexer.\n    65\tpub fn real_lex(l: &mut Lexer, t: &mut Token) -> i32 {\n    66\t    if l.unlexed_count > 0 {\n    67\t        l.unlexed_count -= 1;\n    68\t        *t = l.unlexed[l.unlexed_count as usize].clone();\n    69\t        return 0;\n    70\t    }\n    71\t\n    72\t    let _ = skip_to_token(l);\n    73\t    let init = lexer_getchar(l);\n    74\t\n    75\t    t.contents.clear();\n    76\t    t.length = 0;\n    77\t    t.token_type = TokenType::TT_NO_TOKEN;\n    78\t    t.source_file = l.current_file.clone();\n    79\t    t.line = 0;\n    80\t    t.column = 0;\n    81\t\n    82\t    if init == -1 {\n    83\t        t.contents = \"[end of file]\".to_string();\n    84\t        t.length = t.contents.len();\n    85\t        t.token_type = TokenType::TT_EOF;\n    86\t        set_token_basic_fields(l, t);\n    87\t        return 0;\n    88\t    }\n    89\t\n    90\t    if init == i32::from(b' ') || init == i32::from(b'\\t') {\n    91\t        return -1;\n    92\t    }\n    93\t\n    94\t    if init == i32::from(b'\\n') {\n    95\t        t.contents = \"[newline]\".to_string();\n    96\t        t.length = t.contents.len();\n    97\t        t.token_type = TokenType::TT_NEWLINE;\n    98\t        set_token_basic_fields(l, t);\n    99\t        return 0;\n   100\t    }\n   101\t\n   102\t    let init_char = char::from_u32(init as u32).unwrap_or('\\0');\n   103\t    t.contents.push(init_char);\n   104\t\n   105\t    if in_string(init_char, SINGLE_CHAR_TOKENS) != 0 {\n   106\t        t.length = t.contents.len();\n   107\t        t.token_type = ttype_one_char(init_char);\n   108\t        set_token_basic_fields(l, t);\n   109\t        return 0;\n   110\t    }\n   111\t\n   112\t    if is_valid_numeric_or_id_char(init_char) != 0 {\n   113\t        let starting_line = l.line;\n   114\t        let starting_col = l.column;\n   115\t        loop {\n   116\t            let c = lexer_getchar(l);\n   117\t            if c == -1 {\n   118\t                break;\n   119\t            }\n   120\t            let c_char = char::from_u32(c as u32).unwrap_or('\\0');\n   121\t            if is_valid_numeric_or_id_char(c_char) == 0 {\n   122\t                break;\n   123\t            }\n   124\t            if t.contents.len() >= crate::token::TOKEN_LENGTH - 1 {\n   125\t                return -1;\n   126\t            }\n   127\t            t.contents.push(c_char);\n   128\t        }\n   129\t        let _ = lexer_ungetchar(l);\n   130\t        t.token_type = ttype_many_chars(&t.contents);\n   131\t        t.length = t.contents.len();\n   132\t        t.line = starting_line;\n   133\t        t.column = starting_col;\n   134\t        return 0;\n   135\t    }\n   136\t\n   137\t    if starts_operator(init_char) != 0 {\n   138\t        loop {\n   139\t            if valid_operator_sequence(&t.contents) == 0 {\n   140\t                break;\n   141\t            }\n   142\t            let c = lexer_getchar(l);\n   143\t            if c == -1 {\n   144\t                break;\n   145\t            }\n   146\t            t.contents.push(char::from_u32(c as u32).unwrap_or('\\0'));\n   147\t        }\n   148\t        let _ = lexer_ungetchar(l);\n   149\t        t.contents.pop();\n   150\t        t.token_type = ttype_from_string(&t.contents);\n   151\t        t.length = t.contents.len() + 1;\n   152\t        set_token_basic_fields(l, t);\n   153\t        return 0;\n   154\t    }\n   155\t\n   156\t    0\n   157\t}\n   158\t/// Un-gets (pushes back) the last character.\n   159\tpub fn lexer_ungetchar(l: &mut Lexer) -> i32 {\n   160\t    if l.position < 0 {\n   161\t        return -1;\n   162\t    }\n   163\t\n   164\t    l.position -= 1;\n   165\t    l.column = l.last_column;\n   166\t    if l.buffer[0] == b'\\n' {\n   167\t        l.line -= 1;\n   168\t    }\n   169\t\n   170\t    let Some(fp) = l.fp.as_mut() else {\n   171\t        return -1;\n   172\t    };\n   173\t\n   174\t    if fp.seek(SeekFrom::Current(-1)).is_ok() {\n   175\t        1\n   176\t    } else {\n   177\t        -1\n   178\t    }\n   179\t}\n   180\t/// Determines a token type from a multi-character sequence.\n   181\tpub fn ttype_many_chars(contents: &str) -> TokenType {\n   182\t    match contents {\n   183\t        \"auto\" => TokenType::TT_AUTO,\n   184\t        \"break\" => TokenType::TT_BREAK,\n   185\t        \"continue\" => TokenType::TT_CONTINUE,\n   186\t        \"const\" => TokenType::TT_CONST,\n   187\t        \"case\" => TokenType::TT_CASE,\n   188\t        \"char\" => TokenType::TT_CHAR,\n   189\t        \"do\" => TokenType::TT_DO,\n   190\t        \"double\" => TokenType::TT_DOUBLE,\n   191\t        \"default\" => TokenType::TT_DEFAULT,\n   192\t        \"enum\" => TokenType::TT_ENUM,\n   193\t        \"else\" => TokenType::TT_ELSE,\n   194\t        \"extern\" => TokenType::TT_EXTERN,\n   195\t        \"float\" => TokenType::TT_FLOAT,\n   196\t        \"for\" => TokenType::TT_FOR,\n   197\t        \"goto\" => TokenType::TT_GOTO,\n   198\t        \"int\" => TokenType::TT_INT,\n   199\t        \"if\" => TokenType::TT_IF,\n   200\t        \"long\" => TokenType::TT_LONG,\n   201\t        \"return\" => TokenType::TT_RETURN,\n   202\t        \"register\" => TokenType::TT_REGISTER,\n   203\t        \"struct\" => TokenType::TT_STRUCT,\n   204\t        \"signed\" => TokenType::TT_SIGNED,\n   205\t        \"sizeof\" => TokenType::TT_SIZEOF,\n   206\t        \"static\" => TokenType::TT_STATIC,\n   207\t        \"short\" => TokenType::TT_SHORT,\n   208\t        \"switch\" => TokenType::TT_SWITCH,\n   209\t        \"typedef\" => TokenType::TT_TYPEDEF,\n   210\t        \"union\" => TokenType::TT_UNION,\n   211\t        \"unsigned\" => TokenType::TT_UNSIGNED,\n   212\t        \"void\" => TokenType::TT_VOID,\n   213\t        \"volatile\" => TokenType::TT_VOLATILE,\n   214\t        \"while\" => TokenType::TT_WHILE,\n   215\t        \"&&\" => TokenType::TT_LAND,\n   216\t        \"||\" => TokenType::TT_LOR,\n   217\t        \"-=\" => TokenType::TT_DEC,\n   218\t        \"+=\" => TokenType::TT_INC,\n   219\t        \"++\" => TokenType::TT_PLUSPLUS,\n   220\t        \"--\" => TokenType::TT_MINUSMINUS,\n   221\t        \"/=\" => TokenType::TT_DIVEQ,\n   222\t        \"*=\" => TokenType::TT_MULEQ,\n   223\t        \"%=\" => TokenType::TT_MODEQ,\n   224\t        \"&=\" => TokenType::TT_BANDEQ,\n   225\t        \"|=\" => TokenType::TT_BOREQ,\n   226\t        \"&&=\" => TokenType::TT_LANDEQ,\n   227\t        \"||=\" => TokenType::TT_LOREQ,\n   228\t        \"<=\" => TokenType::TT_LESSEQ,\n   229\t        \">=\" => TokenType::TT_GREATEREQ,\n   230\t        \"<<\" => TokenType::TT_LEFTSHIFT,\n   231\t        \">>\" => TokenType::TT_RIGHTSHIFT,\n   232\t        \"==\" => TokenType::TT_EQUALS,\n   233\t        \"^=\" => TokenType::TT_XOREQ,\n   234\t        \"->\" => TokenType::TT_POINT,\n   235\t        \"<<=\" => TokenType::TT_LEFTSHIFTEQUALS,\n   236\t        \">>=\" => TokenType::TT_RIGHTSHIFTEQUALS,\n   237\t        \"!=\" => TokenType::TT_NOTEQ,\n   238\t        _ => {\n   239\t            if contents.is_empty() {\n   240\t                return TokenType::TT_IDENTIFIER;\n   241\t            }\n   242\t\n   243\t            let mut all_numeric = true;\n   244\t            let mut count_us = 0;\n   245\t\n   246\t            for c in contents.chars() {\n   247\t                if c == '.' || c == '\\'' || c == '\"' {\n   248\t                    return TokenType::TT_LITERAL;\n   249\t                }\n   250\t                if c == 'u' {\n   251\t                    count_us += 1;\n   252\t                }\n   253\t                if !c.is_ascii_digit() && c != 'u' {\n   254\t                    all_numeric = false;\n   255\t                }\n   256\t            }\n   257\t\n   258\t            if all_numeric {\n   259\t                if count_us == 1 && contents.ends_with('u') {\n   260\t                    return TokenType::TT_LITERAL;\n   261\t                }\n   262\t                if count_us == 0 {\n   263\t                    return TokenType::TT_LITERAL;\n   264\t                }\n   265\t            }\n   266\t\n   267\t            TokenType::TT_IDENTIFIER\n   268\t        }\n   269\t    }\n   270\t}\n   271\t/// Tests the function that identifies token types by name.\n   272\tpub fn test_ttype_name() -> i32 {\n   273\t    if ttype_name(TokenType::TT_LITERAL) == \"literal\"\n   274\t        && ttype_name(TokenType::TT_PLUS) == \"+\"\n   275\t        && ttype_name(TokenType::TT_SIZEOF) == \"sizeof\"\n   276\t        && ttype_name(TokenType::TT_WHILE) == \"while\"\n   277\t    {\n   278\t        0\n   279\t    } else {\n   280\t        -1\n   281\t    }\n   282\t}\n   283\t/// Determines a token type from a single character.\n   284\tpub fn ttype_one_char(c: char) -> TokenType {\n   285\t    match c {\n   286\t        '(' => TokenType::TT_OPAREN,\n   287\t        ')' => TokenType::TT_CPAREN,\n   288\t        '{' => TokenType::TT_OBRACE,\n   289\t        '}' => TokenType::TT_CBRACE,\n   290\t        '[' => TokenType::TT_OBRACKET,\n   291\t        ']' => TokenType::TT_CBRACKET,\n   292\t        ';' => TokenType::TT_SEMI,\n   293\t        '.' => TokenType::TT_PERIOD,\n   294\t        ',' => TokenType::TT_COMMA,\n   295\t        '-' => TokenType::TT_MINUS,\n   296\t        '+' => TokenType::TT_PLUS,\n   297\t        '*' => TokenType::TT_STAR,\n   298\t        '/' => TokenType::TT_SLASH,\n   299\t        '=' => TokenType::TT_ASSIGN,\n   300\t        ':' => TokenType::TT_COLON,\n   301\t        '%' => TokenType::TT_MOD,\n   302\t        '&' => TokenType::TT_BAND,\n   303\t        '|' => TokenType::TT_BOR,\n   304\t        '>' => TokenType::TT_GREATER,\n   305\t        '<' => TokenType::TT_LESS,\n   306\t        '!' => TokenType::TT_LNOT,\n   307\t        '~' => TokenType::TT_BNOT,\n   308\t        '^' => TokenType::TT_XOR,\n   309\t        '#' => TokenType::TT_POUND,\n   310\t        '?' => TokenType::TT_QMARK,\n   311\t        _ if c.is_ascii_digit() => TokenType::TT_LITERAL,\n   312\t        _ => TokenType::TT_IDENTIFIER,\n   313\t    }\n   314\t}\n   315\t/// Returns the name of a token type as a string.\n   316\tpub fn ttype_name(tt: TokenType) -> String {\n   317\t    let name = match tt {\n   318\t        TokenType::TT_LITERAL => \"literal\",\n   319\t        TokenType::TT_IDENTIFIER => \"identifier\",\n   320\t        TokenType::TT_OPAREN => \"open paren\",\n   321\t        TokenType::TT_CPAREN => \"close paren\",\n   322\t        TokenType::TT_OBRACE => \"open brace\",\n   323\t        TokenType::TT_CBRACE => \"close brace\",\n   324\t        TokenType::TT_OBRACKET => \"open bracket\",\n   325\t        TokenType::TT_CBRACKET => \"close bracket\",\n   326\t        TokenType::TT_SEMI => \"semicolon\",\n   327\t        TokenType::TT_NO_TOKEN => \"no token\",\n   328\t        TokenType::TT_EOF => \"end of file\",\n   329\t        TokenType::TT_NEWLINE => \"newline\",\n   330\t        TokenType::TT_POUND => \"pound\",\n   331\t        TokenType::TT_PERIOD => \".\",\n   332\t        TokenType::TT_COMMA => \",\",\n   333\t        TokenType::TT_QMARK => \"?\",\n   334\t        TokenType::TT_MINUS => \"-\",\n   335\t        TokenType::TT_PLUS => \"+\",\n   336\t        TokenType::TT_STAR => \"*\",\n   337\t        TokenType::TT_SLASH => \"/\",\n   338\t        TokenType::TT_ASSIGN => \"=\",\n   339\t        TokenType::TT_COLON => \":\",\n   340\t        TokenType::TT_MOD => \"%\",\n   341\t        TokenType::TT_BAND => \"&\",\n   342\t        TokenType::TT_LAND => \"&&\",\n   343\t        TokenType::TT_BOR => \"|\",\n   344\t        TokenType::TT_LOR => \"||\",\n   345\t        TokenType::TT_DEC => \"-=\",\n   346\t        TokenType::TT_INC => \"+=\",\n   347\t        TokenType::TT_PLUSPLUS => \"++\",\n   348\t        TokenType::TT_MINUSMINUS => \"--\",\n   349\t        TokenType::TT_DIVEQ => \"/=\",\n   350\t        TokenType::TT_MULEQ => \"*=\",\n   351\t        TokenType::TT_MODEQ => \"%=\",\n   352\t        TokenType::TT_BANDEQ => \"&=\",\n   353\t        TokenType::TT_BOREQ => \"|=\",\n   354\t        TokenType::TT_LANDEQ => \"&&=\",\n   355\t        TokenType::TT_LOREQ => \"||=\",\n   356\t        TokenType::TT_GREATER => \">\",\n   357\t        TokenType::TT_LESS => \"<\",\n   358\t        TokenType::TT_LESSEQ => \"<=\",\n   359\t        TokenType::TT_GREATEREQ => \">=\",\n   360\t        TokenType::TT_LEFTSHIFT => \"<<\",\n","exit_code":0,"status":"completed"}}
