size)\n    53\t}\n    54\t/// Destroys the list and frees resources.\n    55\tpub fn destroy_list(l: &mut List) -> i32 {\n    56\t    l.head = None;\n    57\t    l.tail = None;\n    58\t    0\n    59\t}\n    60\t/// Adds an element to the list.\n    61\tpub fn ladd_element(l: &mut List, element: Box<dyn Any>) -> i32 {\n    62\t    if l.blocksize <= 0 {\n    63\t        return -1;\n    64\t    }\n    65\t    let blocksize = l.blocksize;\n    66\t\n    67\t    if l.head.is_none() {\n    68\t        let mut block = make_block(blocksize);\n    69\t        let raw = &mut *block as *mut ListBlock;\n    70\t        l.tail = Some(raw);\n    71\t        l.head = Some(block);\n    72\t    }\n    73\t\n    74\t    let mut current = match l.head.as_mut() {\n    75\t        Some(current) => current,\n    76\t        None => return -1,\n    77\t    };\n    78\t\n    79\t    while current.next.is_some() {\n    80\t        current = match current.next.as_mut() {\n    81\t            Some(next) => next,\n    82\t            None => return -1,\n    83\t        };\n    84\t    }\n    85\t\n    86\t    if current.full < current.size {\n    87\t        current.array.push(element);\n    88\t        current.full += 1;\n    89\t        l.tail = Some(&mut **current as *mut ListBlock);\n    90\t        return 0;\n    91\t    }\n    92\t\n    93\t    let mut block = make_block(blocksize);\n    94\t    block.array.push(element);\n    95\t    block.full = 1;\n    96\t    let raw = &mut *block as *mut ListBlock;\n    97\t    current.next = Some(block);\n    98\t    l.tail = Some(raw);\n    99\t    0\n   100\t}\n   101\t/// Allocates a new block and links it into the list.\n   102\tpub fn new_block(l: &mut List) -> Box<ListBlock> {\n   103\t    make_block(l.blocksize)\n   104\t}\n   105\t/// Iterates over the list with a provided function.\n   106\tpub fn literate(l: &mut List, func: fn(&mut Box<dyn Any>) -> i32) -> i32 {\n   107\t    let mut acc = 0;\n   108\t    let mut current = l.head.as_mut(