 match h.buckets.get(bucket_index) {\n    52\t        Some(bucket) => bucket,\n    53\t        None => return -1,\n    54\t    };\n    55\t\n    56\t    if bucket.is_none() {\n    57\t        if h.size == h.cap {\n    58\t            double_cap(h);\n    59\t        }\n    60\t\n    61\t        h.size += 1;\n    62\t        if let Some(slot) = h.buckets.get_mut(bucket_index) {\n    63\t            *slot = Some(Box::new(BucketNode {\n    64\t                key: key.to_string(),\n    65\t                value,\n    66\t                next: None,\n    67\t            }));\n    68\t            0\n    69\t        } else {\n    70\t            -1\n    71\t        }\n    72\t    } else {\n    73\t        -1\n    74\t    }\n    75\t}\n    76\t/// Tests setting and getting a value in the Hashmap.\n    77\tpub fn test_hash_set_and_get() -> i32 {\n    78\t    let mut h = create_hashmap(100);\n    79\t    let ret = hm_set(&mut h, \"test\", Box::new(String::from(\"jake\")));\n    80\t    if ret == -1 {\n    81\t        return -1;\n    82\t    }\n    83\t\n    84\t    match hm_get(&h, \"test\")\n    85\t        .and_then(|node| node.value.as_ref().downcast_ref::<String>())\n    86\t        .map(|s| s == \"jake\")\n    87\t    {\n    88\t        Some(true) => 0,\n    89\t        _ => -1,\n    90\t    }\n    91\t}\n    92\t/// Doubles the capacity of the Hashmap.\n    93\tpub fn double_cap(h: &mut Hashmap) {\n    94\t    if h.cap <= 0 {\n    95\t        return;\n    96\t    }\n    97\t\n    98\t    let old_cap = h.cap;\n    99\t    let mut new_buckets: Vec<Option<Box<BucketNode>>> = std::iter::repeat_with(|| None)\n   100\t        .take((old_cap * 2) as usize)\n   101\t        .collect();\n   102\t\n   103\t    for slot in h.buckets.iter_mut() {\n   104\t        if let Some(bucket) = slot.take() {\n   105\t            let bucket_index = ((h.hash)(&bucket.key) % (old_cap as u32)) as usize;\n   106\t            new_buckets[bucket_index] = Some(bucket);\n   107\t        }\n   108\t    }\n   109\t\n   110\t    h.buckets = new_buckets;\n   111\t    h.cap = old_cap * 2;\n   112\t}\n   113\t/// A sample FNV-1 hash function.\n   114\tpub fn fnva1(value: &str) -> u32 {\n   115\t    let mut h: u64 = 16_777_619;\n   116\t    let prime: u64 = 2_166_136_261;\n   117\t\n   118\t    for byte in value.bytes() {\n   119\t        h ^= u64::from(byte);\n   120\t        h = h.wrapping_mul(prime);\n   121\t    }\n   122\t\n   123\t    h as u32\n   124\t}\n   125\t/// Tests initializing the Hashmap.\n   126\tpub fn test_hash_init() -> i32 {\n   127\t    let h = create_hashmap(100);\n   128\t    if h.size == 0 && h.cap == 100 { 0 } else { -1 }\n   129\t}\n   130\t/// Destroys the Hashmap and frees resources.\n   131\tpub fn destroy_hashmap(h: &mut Hashmap) {\n   132\t    h.buckets.clear();\n   133\t    h.size = 0;\n   134\t    h.cap = 0;\n   135\t}\n   136\t/// Tests initializing the Hashmap and storing a value.\n   137\tpub fn test_hash_init_and_store() -> i32 {\n   138\t    let mut h = create_hashmap(100);\n   139\t    if h.size != 0 || h.cap != 100 {\n   140\t        return -1;\n   141\t    }\n   142\t\n   143\t    let ret = hm_set(&mut h, \"test\", Box::new(String::from(\"jake\")));\n   144\t    if ret == -1 {\n   145\t        return -1;\n   146\t    }\n   147\t\n   148\t    let index = ((h.hash)(\"test\") % (h.cap as u32)) as usize;\n   149\t    let bucket = match h.buckets.get(index).and_then(|slot| slot.as_ref()) {\n   150\t        Some(bucket) => bucket,\n   151\t        None => return -1,\n   152\t    };\n   153\t\n   154\t    if bucket.key == \"test\" && h.size == 1 && h.cap == 100 {\n   155\t        0\n   156\t    } else {\n   157\t        -1\n   158\t    }\n   159\t}\n   160\t/// Tests setting a key-value pair, then doubling capacity, then getting the value.\n   161\tpub fn test_hash_set_and_double_get() -> i32 {\n   162\t    let mut h = create_hashmap(100);\n   163\t    let ret = hm_set(&mut h, \"test\", Box::new(String::from(\"jake\")));\n   164\t   