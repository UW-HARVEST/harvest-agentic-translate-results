args.len() == 1 {\n    57\t        eprintln!(\n    58\t            \"jccc: default compilation not supported yet -- try 'jccc --token-dump {}' instead.\",\n    59\t            args[0]\n    60\t        );\n    61\t        return;\n    62\t    }\n    63\t\n    64\t    if args.len() > 2 {\n    65\t        eprintln!(\"jccc: expected only two arguments!\");\n    66\t        return;\n    67\t    }\n    68\t\n    69\t    match args[0].as_str() {\n    70\t        \"--token-dump\" => {\n    71\t            let _ = lexer_dump(&args[1]);\n    72\t        }\n    73\t        \"--test-parse\" => {\n    74\t            let _ = parse(&args[1]);\n    75\t        }\n    76\t        _ => {\n    77\t            eprintln!(\"Error: jccc: option {} not recognized.\", args[1]);\n    78\t        }\n    79\t    }\n    80\t}\n","exit_code":0,"status":"completed"}}
