{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,220p' c_src/LangKernel/utils.c\"","aggregated_output":"//\n// Created by lixiaobai on 24-7-6.\n//\n\n#include \"utils.h\"\n\n#ifdef _WIN32\n#include \"utils.h\"\n#include <stdlib.h>\n#include <string.h>\n\nchar *strndup(const char *s, size_t n) {\n    char *result;\n    size_t len = strlen(s);\n\n    if (len > n) len = n;\n\n    result = (char *)malloc(len + 1);\n    if (!result) return 0;\n\n    result[len] = '\\0';\n    return (char *)memcpy(result, s, len);\n}\n#endif","exit_code":0,"status":"completed"}}
