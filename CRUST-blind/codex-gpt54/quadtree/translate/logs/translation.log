lk(quadtree_node_t *root,\n              void (*descent)(quadtree_node_t *node),\n              void (*ascent)(quadtree_node_t *node));\n\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n","exit_code":0,"status":"completed"}}
