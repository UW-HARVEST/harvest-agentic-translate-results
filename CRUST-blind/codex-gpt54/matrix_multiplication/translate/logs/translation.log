 50\t\n    51\t        for (j, cell) in result_row.iter_mut().enumerate() {\n    52\t            let mut sum = 0.0;\n    53\t            for (k, lhs) in m1_row.iter().enumerate() {\n    54\t                if let Some(rhs_row) = m2.get(k) {\n    55\t                    sum += *lhs * rhs_row.get(j).copied().unwrap_or(0.0);\n    56\t                }\n    57\t            }\n    58\t            *cell = sum;\n    59\t        }\n    60\t    }\n    61\t}\n    62\tpub fn algorithm3(m1: &[Vec<f32>], m2: &[Vec<f32>], result: &mut [Vec<f32>]) {\n    63\t    for row in result.iter_mut() {\n    64\t        row.fill(0.0);\n    65\t    }\n    66\t\n    67\t    for (i, m1_row) in m1.iter().enumerate() {\n    68\t        let Some(result_row) = result.get_mut(i) else {\n    69\t            break;\n    70\t        };\n    71\t\n    72\t        for (k, lhs) in m1_row.iter().enumerate() {\n    73\t            let Some(m2_row) = m2.get(k) else {\n    74\t                continue;\n    75\t            };\n    76\t\n    77\t            for (j, cell) in result_row.iter_mut().enumerate() {\n    78\t                *cell += *lhs * m2_row.get(j).copied().unwrap_or(0.0);\n    79\t            }\n    80\t        }\n    81\t    }\n    82\t}\n    83\tpub fn algorithm2(m1: &[Vec<f32>], m2: &[Vec<f32>], result: &mut [Vec<f32>]) {\n    84\t    let size = m1.len().min(m2.len()).min(result.len());\n    85\t\n    86\t    let mut transposed = vec![vec![0.0; size]; size];\n    87\t    for i in 0..size {\n    88\t        for j in 0..size {\n    89\t            transposed[i][j] = m2.get(j).and_then(|row| row.get(i)).copied().unwrap_or(0.0);\n    90\t        }\n    91\t    }\n    92\t\n    93\t    for i in 0..size {\n    94\t        if let Some(result_row) = result.get_mut(i) {\n    95\t            let width = result_row.len().min(size);\n    96\t            for cell in result_row.iter_mut().take(width) {\n    97\t                *cell = 0.0;\n    98\t            }\n    99\t\n   100\t            let lhs_row 