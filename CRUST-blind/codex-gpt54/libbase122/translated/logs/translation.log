{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/base122.rs | sed -n '1,260p'\"","aggregated_output":"     1\t//! Base122 encoder/decoder\n     2\t//! \n     3\t//! Base122 is a binary-to-text encoding scheme that avoids certain illegal characters\n     4\t//! such as null, newline, carriage return, double quote, ampersand, and backslash.\n     5\tuse std::error::Error;\n     6\tuse std::fmt;\n     7\t/// Error type for Base122 operations\n     8\t#[derive(Debug, Clone)]\n     9\tpub struct Base122Error {\n    10\t    pub message: String,\n    11\t}\n    12\timpl Base122Error {\n    13\t    fn new(message: &str) -> Self {\n    14\t        Self {\n    15\t            message: message.to_string(),\n    16\t        }\n    17\t    }\n    18\t}\n    19\t\n    20\timpl fmt::Display for Base122Error {\n    21\t    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n    22\t        f.write_str(&self.message)\n    23\t    }\n    24\t}\n    25\t\n    26\timpl Error for Base122Error {}\n    27\t/// BitReader is used to read bits from a byte array\n    28\tpub struct BitReader<'a> {\n    29\t    pub input: &'a [u8],\n    30\t    pub byte_pos: usize,\n    31\t    pub bit_pos: usize,\n    32\t}\n    33\timpl<'a> BitReader<'a> {\n    34\t    pub fn new(input: &'a [u8]) -> Self {\n    35\t        Self {\n    36\t            input,\n    37\t            byte_pos: 0,\n    38\t            bit_pos: 0,\n    39\t        }\n    40\t    }\n    41\t    /// Read up to `nbits` from the input, returns (bits_read, value)\n    42\t    pub fn read(&mut self, nbits: u8) -> (u8, u8) {\n    43\t        assert!((1..=8).contains(&nbits));\n    44\t\n    45\t        let cur_bit = self.byte_pos * 8 + self.bit_pos;\n    46\t        let bit_len = self.input.len() * 8;\n    47\t        let max_nbits = bit_len.saturating_sub(cur_bit);\n    48\t        let nbits = usize::min(nbits as usize, max_nbits);\n    49\t\n    50\t        if nbits == 0 {\n    51\t            return (0, 0);\n    52\t        }\n    53\t\n    54\t        let first_byte_index = cur_bit / 8;\n    55\t        let first_byte_cur_bit = cur_bit % 8;\n    56\t        let mut two_bytes = u16::from(self.input[first_byte_index]) << 8;\n    57\t        if first_byte_index + 1 < self.input.len() {\n    58\t            two_bytes |= u16::from(self.input[first_byte_index + 1]);\n    59\t        }\n    60\t\n    61\t        let shift = (8 - first_byte_cur_bit) + (8 - nbits);\n    62\t        two_bytes >>= shift;\n    63\t        let mask = if nbits == 8 {\n    64\t            0xFF\n    65\t        } else {\n    66\t            ((1u16 << nbits) - 1) as u8\n    67\t        };\n    68\t        let out = (two_bytes as u8) & mask;\n    69\t\n    70\t        let next_bit = cur_bit + nbits;\n    71\t        self.byte_pos = next_bit / 8;\n    72\t        self.bit_pos = next_bit % 8;\n    73\t\n    74\t        (nbits as u8, out)\n    75\t    }\n    76\t}\n    77\t/// BitWriter is used to write bits to a byte array\n    78\tpub struct BitWriter<'a> {\n    79\t    pub output: Option<&'a mut [u8]>,\n    80\t    pub len: usize,\n    81\t    pub cur_bit: usize,\n    82\t    pub count_only: bool,\n    83\t}\n    84\timpl<'a> BitWriter<'a> {\n    85\t    pub fn new(output: Option<&'a mut [u8]>, len: usize) -> Self {\n    86\t        Self {\n    87\t            count_only: output.is_none(),\n    88\t            output,\n    89\t            len,\n    90\t            cur_bit: 0,\n    91\t        }\n    92\t    }\n    93\t    /// Write `nbits` bits from `value` to the output\n    94\t    /// Returns the number of bytes used so far or an error\n    95\t    pub fn write(&mut self, nbits: u8, value: u8) -> Result<usize, Base122Error> {\n    96\t        assert!((1..=8).contains(&nbits));\n    97\t\n    98\t        let nbits = nbits as usize;\n    99\t        if self.count_only {\n   100\t            self.cur_bit += nbits;\n   101\t            return Ok(self.cur_bit.div_ceil(8));\n   102\t        }\n   103\t\n   104\t        if self.cur_bit + nbits > self.len * 8 {\n   105\t            return Err(Base122Error::new(\"Output does not have sufficient size\"));\n   106\t        }\n   107\t\n   108\t        let first_byte_index = self.cur_bit / 8;\n   109\t        let first_byte_cur_bit = self.cur_bit % 8;\n   110\t        let mask = !((0xFFu16 >> first_byte_cur_bit) as u8);\n   111\t        let buf = self\n   112\t            .output\n   113\t            .as_deref_mut()\n   114\t            .expect(\"BitWriter output must exist unless count_only is true\");\n   115\t\n   116\t        let mut two_bytes = u16::from(buf[first_byte_index] & mask) << 8;\n   117\t        let value_mask = if nbits == 8 {\n   118\t            0xFF\n   119\t        } else {\n   120\t            ((1u16 << nbits) - 1) as u8\n   121\t        };\n   122\t        let shift = 8 + (8 - first_byte_cur_bit) - nbits;\n   123\t        two_bytes |= u16::from(value & value_mask) << shift;\n   124\t\n   125\t        buf[first_byte_index] = (two_bytes >> 8) as u8;\n   126\t        if first_byte_cur_bit + nbits > 8 {\n   127\t            buf[first_byte_index + 1] = two_bytes as u8;\n   128\t        }\n   129\t\n   130\t        self.cur_bit += nbits;\n   131\t        Ok(self.cur_bit.div_ceil(8))\n   132\t    }\n   133\t}\n   134\tconst ILLEGALS: [u8; 6] = [\n   135\t    0,  // null\n   136\t    10, // newline\n   137\t    13, // carriage return\n   138\t    34, // double quote\n   139\t    38, // ampersand\n   140\t    92, // backslash\n   141\t];\n   142\t/// Check if a byte value is one of the illegal characters\n   143\tfn is_illegal(val: u8) -> bool {\n   144\t    ILLEGALS.contains(&val)\n   145\t}\n   146\t/// Get the index of an illegal character in the ILLEGALS array\n   147\tfn get_illegal_index(val: u8) -> u8 {\n   148\t    for (idx, illegal) in ILLEGALS.iter().enumerate() {\n   149\t        if *illegal == val {\n   150\t            return idx as u8;\n   151\t        }\n   152\t    }\n   153\t    debug_assert!(false, \"unreachable\");\n   154\t    u8::MAX\n   155\t}\n   156\t/// Encode binary data to Base122 encoding\n   157\t///\n   158\t/// # Arguments\n   159\t///\n   160\t/// * `input` - The binary data to encode\n   161\t///\n   162\t/// # Returns\n   163\t///\n   164\t/// * `Ok(Vec<u8>)` - The encoded data\n   165\t/// * `Err(Base122Error)` - If there was an error during encoding\n   166\tpub fn encode(input: &[u8]) -> Result<Vec<u8>, Base122Error> {\n   167\t    let mut encoded_len = 0;\n   168\t    encode_internal(input, None, &mut encoded_len)?;\n   169\t\n   170\t    let mut output = vec![0; encoded_len];\n   171\t    let mut written = 0;\n   172\t    encode_internal(input, Some(output.as_mut_slice()), &mut written)?;\n   173\t    debug_assert_eq!(written, encoded_len);\n   174\t    Ok(output)\n   175\t}\n   176\t/// Internal function to perform the encoding\n   177\tfn encode_internal(input: &[u8], mut output: Option<&mut [u8]>, out_written: &mut usize) -> Result<(), Base122Error> {\n   178\t    fn emit_byte(\n   179\t        output: &mut Option<&mut [u8]>,\n   180\t        out_index: &mut usize,\n   181\t        out_written: &mut usize,\n   182\t        byte: u8,\n   183\t    ) -> Result<(), Base122Error> {\n   184\t        if let Some(buf) = output.as_deref_mut() {\n   185\t            if *out_index == buf.len() {\n   186\t                return Err(Base122Error::new(\"output does not have sufficient size\"));\n   187\t            }\n   188\t            buf[*out_index] = byte;\n   189\t            *out_index += 1;\n   190\t        }\n   191\t\n   192\t        *out_written += 1;\n   193\t        Ok(())\n   194\t    }\n   195\t\n   196\t    let mut reader = BitReader::new(input);\n   197\t    let mut out_index = 0usize;\n   198\t    *out_written = 0;\n   199\t\n   200\t    loop {\n   201\t        let (nbits, mut bits) = reader.read(7);\n   202\t        if nbits == 0 {\n   203\t            break;\n   204\t        }\n   205\t\n   206\t        if nbits < 7 {\n   207\t            bits <<= 7 - nbits;\n   208\t        }\n   209\t\n   210\t        if is_illegal(bits) {\n   211\t            let illegal_index = get_illegal_index(bits);\n   212\t            let (next_nbits, mut next_bits) = reader.read(7);\n   213\t            next_bits <<= 7 - next_nbits;\n   214\t\n   215\t            let mut b1 = 0xC2u8;\n   216\t            let mut b2 = 0x80u8;\n   217\t            if next_nbits == 0 {\n   218\t                b1 |= 0x7 << 2;\n   219\t                next_bits = bits;\n   220\t            } else {\n   221\t                b1 |= illegal_index << 2;\n   222\t            }\n   223\t\n   224\t            let first_bit = (next_bits >> 6) & 1;\n   225\t            b1 |= first_bit;\n   226\t            b2 |= next_bits & 0x3F;\n   227\t\n   228\t            emit_byte(&mut output, &mut out_index, out_written, b1)?;\n   229\t            emit_byte(&mut output, &mut out_index, out_written, b2)?;\n   230\t        } else {\n   231\t            emit_byte(&mut output, &mut out_index, out_written, bits)?;\n   232\t        }\n   233\t    }\n   234\t\n   235\t    Ok(())\n   236\t}\n   237\t/// Write the last 7 bits of byteVal for decoding.\n   238\t/// Returns an error if byteVal has 1 bits exceeding the last byte boundary.\n   239\tfn write_last_7(writer: &mut BitWriter, byte_val: u8, error: &mut Base122Error) -> Result<(), Base122Error> {\n   240\t    let nbits = 8 - (writer.cur_bit % 8);\n   241\t    if nbits == 8 {\n   242\t        *error = Base122Error::new(\"Decoded data is not a byte multiple\");\n   243\t        return Err(error.clone());\n   244\t    }\n   245\t\n   246\t    let mask = if 7 == nbits {\n   247\t        0\n   248\t    } else {\n   249\t        ((1u16 << (7 - nbits)) - 1) as u8\n   250\t    };\n   251\t    if (byte_val & mask) > 0 {\n   252\t        *error = Base122Error::new(\"Encoded data is malformed. Last byte has extra data.\");\n   253\t        return Err(error.clone());\n   254\t    }\n   255\t\n   256\t    let byte_val = byte_val >> (7 - nbits);\n   257\t    if writer.write(nbits as u8, byte_val).is_err() {\n   258\t        *error = Base122Error::new(\"Output does not have sufficient size\");\n   259\t        return Err(error.clone());\n   260\t    }\n","exit_code":0,"status":"completed"}}
