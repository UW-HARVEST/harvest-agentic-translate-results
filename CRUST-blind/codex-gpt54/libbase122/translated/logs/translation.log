     if input[cur_byte] >> 7 == 0 {\n   304\t            write_7(writer, cur_byte, input[cur_byte])?;\n   305\t        } else {\n   306\t            let cur_byte_val = input[cur_byte];\n   307\t            if (cur_byte_val & 0xE2) != 0xC2 {\n   308\t                return Err(Base122Error::new(\n   309\t                    \"First byte of two byte sequence malformed\",\n   310\t                ));\n   311\t            }\n   312\t            if cur_byte + 1 == input.len() {\n   313\t                return Err(Base122Error::new(\n   314\t                    \"Two byte sequence is missing second byte\",\n   315\t                ));\n   316\t            }\n   317\t\n   318\t            cur_byte += 1;\n   319\t            let next_byte_val = input[cur_byte];\n   320\t            if (next_byte_val & 0xC0) != 0x80 {\n   321\t                return Err(Base122Error::new(\n   322\t                    \"Second byte of two byte sequence malformed\",\n   323\t                ));\n   324\t            }\n   325\t\n   326\t            let illegal_index = (cur_byte_val & 0x1C) >> 2;\n   327\t            if illegal_index == 0x7 {\n   328\t                if cur_byte + 1 != input.len() {\n   329\t                    return Err(Base122Error::new(\n   330\t                        \"Got unexpected extra data after shortened two byte sequence\",\n   331\t                    ));\n   332\t                }\n   333\t\n   334\t                let last_byte_val = cur_byte_val.wrapping_shl(6) | (next_byte_val & 0x3F);\n   335\t                write_7(writer, cur_byte, last_byte_val)?;\n   336\t            } else if usize::from(illegal_index) < ILLEGALS.len() {\n   337\t                if writer\n   338\t                    .write(7, ILLEGALS[usize::from(illegal_index)])\n   339\t                    .is_err()\n   340\t                {\n   341\t                    return Err(Base122Error::new(\"Output does not have sufficient size\"));\n   342\t                }\n   343\t\n   344\t                let second_byte_val = cur_byte_val.wrapping_shl(6) | (next_byte_val & 0x3F);\n   345\t                write_7(writer, cur_byte, second_byte_val)?;\n   346\t            } else {\n   347\t                return Err(Base122Error::new(\"Got unrecognized illegal index\"));\n   348\t            }\n   349\t        }\n   350\t\n   351\t        cur_byte += 1;\n   352\t    }\n   353\t\n   354\t    *out_written = writer.cur_bit / 8;\n   355\t    Ok(())\n   356\t}\n","exit_code":0,"status":"completed"}}
