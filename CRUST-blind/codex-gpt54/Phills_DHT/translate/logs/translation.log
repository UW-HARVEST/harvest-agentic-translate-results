{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/dht.rs | sed -n '1,220p'\"","aggregated_output":"     1\tpub mod dht {\n     2\t    pub struct HASHTABLE<T> {\n     3\t        pub hash_table: Vec<Option<T>>, \n     4\t        pub lower_bound: i32, \n     5\t        pub higher_bound: i32,\n     6\t    }\n     7\t    impl <T> HASHTABLE<T> {\n     8\t        pub fn dht_init() -> HASHTABLE<T> {\n     9\t            HASHTABLE {\n    10\t                hash_table: Vec::new(),\n    11\t                lower_bound: 0,\n    12\t                higher_bound: 0,\n    13\t            }\n    14\t        }\n    15\t        pub fn dht_is_initialised(&self) -> bool {\n    16\t            !self.hash_table.is_empty()\n    17\t        }\n    18\t        pub fn dht_init_table(&mut self, new_lower_bound: u32, new_upper_bound: u32, migrate: bool) -> bool {\n    19\t            assert!(new_upper_bound > new_lower_bound);\n    20\t\n    21\t            let new_hash_table_size = (new_upper_bound - new_lower_bound) as usize;\n    22\t            let mut new_hash_table = Vec::new();\n    23\t\n    24\t            if new_hash_table.try_reserve_exact(new_hash_table_size).is_err() {\n    25\t                return false;\n    26\t            }\n    27\t\n    28\t            new_hash_table.resize_with(new_hash_table_size, || None);\n    29\t\n    30\t            if self.dht_is_initialised() {\n    31\t                let old_lower_bound = self.lower_bound as u32;\n    32\t\n    33\t                for (i, item) in self.hash_table.iter_mut().enumerate() {\n    34\t                    if let Some(value) = item.take() {\n    35\t                        let absolute_position = i as u32 + old_lower_bound;\n    36\t\n    37\t                        if migrate\n    38\t                            && absolute_position >= new_lower_bound\n    39\t                            && absolute_position < new_upper_bound\n    40\t                        {\n    41\t                            new_hash_table[(absolute_position - new_lower_bound) as usize] = Some(value);\n    42\t                        }\n    43\t                    }\n    44\t                }\n    45\t            }\n    46\t\n    47\t            self.hash_table = new_hash_table;\n    48\t            self.lower_bound = new_lower_bound as i32;\n    49\t            self.higher_bound = new_upper_bound as i32;\n    50\t            true\n    51\t        }\n    52\t        pub fn dht_get_lower_bound(&self) -> u32 {\n    53\t            assert!(self.dht_is_initialised());\n    54\t            self.lower_bound as u32\n    55\t        }\n    56\t        pub fn dht_get_upper_bound(&self) -> u32 {\n    57\t            assert!(self.dht_is_initialised());\n    58\t            self.higher_bound as u32\n    59\t        }\n    60\t        pub fn dht_get_size(&self) -> u32 {\n    61\t            assert!(self.dht_is_initialised());\n    62\t            (self.higher_bound - self.lower_bound) as u32\n    63\t        }\n    64\t        pub fn dht_read(&self, location: u32) -> &Option<T> {\n    65\t            assert!(self.dht_is_initialised());\n    66\t            assert!(location >= self.lower_bound as u32);\n    67\t            assert!(location < self.higher_bound as u32);\n    68\t\n    69\t            &self.hash_table[(location - self.lower_bound as u32) as usize]\n    70\t        }\n    71\t        pub fn dht_write(&mut self, location: u32, data: T) {\n    72\t            assert!(self.dht_is_initialised());\n    73\t            assert!(location >= self.lower_bound as u32);\n    74\t            assert!(location < self.higher_bound as u32);\n    75\t\n    76\t            self.hash_table[(location - self.lower_bound as u32) as usize] = Some(data);\n    77\t        }\n    78\t    }\n    79\t}\n","exit_code":0,"status":"completed"}}
