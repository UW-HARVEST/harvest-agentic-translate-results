.size - off - 1].clone();\n        self.push(item);\n        0\n    }\n\n    pub fn swap(&mut self, off: usize) -> i32 {\n        if off + 1 > self.size {\n            return -1;\n        }\n        let a = self.size - off - 1;\n        let b = self.size - 1;\n        self.buf.swap(a, b);\n        0\n    }\n\n    pub fn shrink_to(&mut self, size: usize) {\n        if size == self.size {\n            return;\n        }\n        assert!(size < self.size);\n\n        // Collect string data for popped tracking\n        let mut to_add: Vec<String> = Vec::new();\n        for i in size..self.size {\n            if let data::DataValue::Str(ref s) = self.buf[i].value {\n                to_add.push(s.clone());\n            }\n        }\n        for s in to_add {\n            self.add_popped(s);\n        }\n\n        self.buf.truncate(size);\n        self.size = size;\n    }\n\n    pub fn clear(&mut self) {\n        self.shrink_to(0);\n        self.gc();\n    }\n\n    pub fn gc(&mut self) {\n        if self.popped_size == 0 {\n            return;\n        }\n        // In Rust, `popped` strings are owned; just drop them all.\n        self.popped.clear();\n        self.popped_size = 0;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3110,"cache_read_input_tokens":41852,"cache_creation":{"ephemeral_5m_input_tokens":3110,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"962e6e99-2d47-4bdd-a40b-5551cf517dea","uuid":"dbe591e6-cda6-4c71-8de5-0a146ddd7f5b"}
