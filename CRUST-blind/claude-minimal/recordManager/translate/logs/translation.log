{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014cfAze3TdBugmajMJdTevf","type":"tool_result","content":"1\t#include <string.h>\n2\t#include <stdlib.h>\n3\t#include <stdio.h>\n4\t\n5\t#include \"tables.h\"\n6\t#include \"buffer_mgr.h\"\n7\t#include \"storage_mgr.h\"\n8\t#include \"record_mgr.h\"\n9\t#include \"dberror.h\"\n10\t\n11\t#define MAX_ATTR_NAME_LEN 15\n12\t\n13\textern int getAttrPos (Schema *schema, int attrNum);\n14\tstatic void prepareTableHeader(char **tableHeaderPtr, TableManager *tableManager, Schema *schema);\n15\tstatic void populateSchemaDetails(char **tableHeaderPtr, Schema *schema);\n16\tstatic void handleCleanup(BM_BufferPool *bufferPool, BM_PageHandle *pageHandle, TableManager *tableManager); \n17\t\n18\t\n19\tRC initRecordManager(void *mgmtData) {\n20\t\n21\t    printf(\"Initializing Record Manager...\\n\");\n22\t\n23\t    return RC_OK;\n24\t}\n25\t\n26\tRC shutdownRecordManager() {\n27\t\n28\t    printf(\"Shutting down Record Manager...\\n\");\n29\t\n30\t    printf(\"Record Manager shutdown successfully.\\n\");\n31\t    return RC_OK;\n32\t}\n33\t\n34\tvoid handleCleanup(BM_BufferPool *bufferPool, BM_PageHandle *pageHandle, TableManager *tableManager) {\n35\t    if (bufferPool != NULL) {\n36\t        shutdownBufferPool(bufferPool);\n37\t        free(bufferPool);\n38\t    }\n39\t    if (pageHandle != NULL) {\n40\t        free(pageHandle);\n41\t    }\n42\t    if (tableManager != NULL) {\n43\t        free(tableManager);\n44\t    }\n45\t}\n46\t\n47\tRC createTable(char *name, Schema *schema) {\n48\t    if (name == NULL || schema == NULL) return RC_GENERAL_ERROR;\n49\t\n50\t    BM_BufferPool *bufferPool = calloc(1, sizeof(BM_BufferPool));\n51\t    if (bufferPool == NULL) return RC_MEMORY_ALLOCATION_FAIL;\n52\t\n53\t    BM_PageHandle *pageHandle = calloc(1, sizeof(BM_PageHandle));\n54\t    if (pageHandle == NULL) {\n55\t        free(bufferPool);\n56\t        return RC_MEMORY_ALLOCATION_FAIL;\n57\t    }\n58\t\n59\t    