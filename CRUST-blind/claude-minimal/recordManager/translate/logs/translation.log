n        RC::ImNToLarge => 302,\n        RC::ImNoMoreEntries => 303,\n        RC::MemoryAllocationFail => 401,\n        RC::BufferpoolInUse => 402,\n        RC::CloseFailed => 403,\n        RC::Error => 404,\n        RC::BufferpoolFull => 405,\n        RC::ReadFailed => 406,\n        RC::InvalidHeader => 407,\n        RC::SeekFailed => 408,\n        RC::DestroyFailed => 409,\n        RC::RecordNotFound => 410,\n        RC::GeneralError => 411,\n        RC::ShutdownWithoutInit => 420,\n        RC::LoggingSetupFailure => 430,\n    }\n}\n\npub fn throw(rc: RC, message: &str) -> i32 {\n    if let Ok(mut msg) = RC_MESSAGE.lock() {\n        *msg = Some(message.to_string());\n    }\n    rc_to_int(&rc)\n}\n\npub fn check(code: i32) {\n    if code != 0 {\n        let message = error_message_from_code(code);\n        println!(\"ERROR: Operation returned error: {}\", message);\n        std::process::exit(1);\n    }\n}\n\npub fn print_error(error: RC) {\n    let code = rc_to_int(&error);\n    if let Ok(msg) = RC_MESSAGE.lock() {\n        if let Some(ref m) = *msg {\n            println!(\"EC ({}), \\\"{}\\\"\", code, m);\n            return;\n        }\n    }\n    println!(\"EC ({})\", code);\n}\n\npub fn error_message(error: RC) -> String {\n    let code = rc_to_int(&error);\n    error_message_from_code(code)\n}\n\nfn error_message_from_code(code: i32) -> String {\n    if let Ok(msg) = RC_MESSAGE.lock() {\n        if let Some(ref m) = *msg {\n            return format!(\"EC ({}), \\\"{}\\\"\\n\", code, m);\n        }\n    }\n    format!(\"EC ({})\\n\", code)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1378,"cache_read_input_tokens":63277,"cache_creation":{"ephemeral_5m_input_tokens":1378,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bb253d24-c91b-4fc6-bfd4-cde067c2e4fd","uuid":"b16809c6-f9db-4925-9ea0