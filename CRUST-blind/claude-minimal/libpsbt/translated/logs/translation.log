cords(struct psbt *tx) {\n76\t\tASSERT_SPACE(1);\n77\t\t*tx->write_pos = '\\0';\n78\t\ttx->write_pos++;\n79\t\treturn PSBT_OK;\n80\t}\n81\t\n82\t\n83\tenum psbt_result\n84\tpsbt_finalize(struct psbt *tx) {\n85\t\tenum psbt_result res;\n86\t\n87\t\tif (tx->state != PSBT_ST_OUTPUTS_NEW && tx->state != PSBT_ST_OUTPUTS) {\n88\t\t\tpsbt_errmsg = \"psbt_finalize: no output records found\";\n89\t\t\treturn PSBT_INVALID_STATE;\n90\t\t}\n91\t\n92\t\tres = psbt_close_records(tx);\n93\t\tif (res != PSBT_OK)\n94\t\t\treturn res;\n95\t\n96\t\ttx->state = PSBT_ST_FINALIZED;\n97\t\n98\t\treturn PSBT_OK;\n99\t}\n100\t\n101\tstatic enum psbt_result\n102\tpsbt_write_record(struct psbt *tx, struct psbt_record *rec) {\n103\t\tu32 size;\n104\t\tu32 key_size_with_type = rec->key_size + 1;\n105\t\n106\t\t// write key length\n107\t\tsize = compactsize_length(key_size_with_type);\n108\t\tASSERT_SPACE(size);\n109\t\tcompactsize_write((u8*)tx->write_pos, key_size_with_type);\n110\t\ttx->write_pos += size;\n111\t\n112\t\t// write type\n113\t\tASSERT_SPACE(1);\n114\t\t*tx->write_pos++ = rec->type;\n115\t\n116\t\t// write key\n117\t\tASSERT_SPACE(rec->key_size);\n118\t\tmemcpy(tx->write_pos, rec->key, rec->key_size);\n119\t\ttx->write_pos += rec->key_size;\n120\t\n121\t\t// write value length\n122\t\tsize = compactsize_length(rec->val_size);\n123\t\tASSERT_SPACE(size);\n124\t\tcompactsize_write((u8*)tx->write_pos, rec->val_size);\n125\t\ttx->write_pos += size;\n126\t\n127\t\t// write value\n128\t\tASSERT_SPACE(rec->val_size);\n129\t\tmemcpy(tx->write_pos, rec->val, rec->val_size);\n130\t\ttx->write_pos += rec->val_size;\n131\t\n132\t\treturn PSBT_OK;\n133\t}\n134\t\n135\tstatic enum psbt_result\n136\tpsbt_read_header(struct psbt *tx) {\n137\t\tASSERT_SPACE(4);\n138\t\n139\t\tdebug(\"magic %02X %02X %02X %02X\\n\",\n140\t\t\t*tx->write_pos,\n141\t\t\t*(tx->write_pos+1),\n142\t\t\t*(tx->write_pos+2),\n143\t\t\t*(tx->write_pos+3));\n144\t\n145\t\tif (memcmp(tx->write_pos, PSBT_MAGIC, sizeof(PSBT_MAGIC)) != 0) {\n146\t\t\tpsbt_errmsg = \"psbt_read: invalid magic header\";\n147\t\t\treturn PSBT_READ_ERROR;\n148\t\t}\n149\t\n150\t\ttx->write_pos += 4;\n151\t\n152\t\tif (*tx->write_pos++ != 0xff) {\n153\t\t\tpsbt_errmsg = \"psbt_read: no 0xff found after magic\";\n154\t\t\treturn PSBT_READ_ERROR;\n155\t\t}\n156\t\n157\t\ttx->state = PSBT_ST_GLOBAL;\n158\t\n159\t\treturn PSBT_OK;\n160\t}\n161\t\n162\tconst char *\n163\tpsbt_input_type_tostr(enum psbt_input_type type) {\n164\t\tswitch (type) {\n165\t\tcase PSBT_IN_NON_WITNESS_UTXO:\n166\t\t\treturn \"IN_NON_WITNESS_UTXO\";\n167\t\tcase PSBT_IN_WITNESS_UTXO:\n168\t\t\treturn \"IN_WITNESS_UTXO\";\n169\t\tcase PSBT_IN_PARTIAL_SIG:\n170\t\t\treturn \"IN_PARTIAL_SIG\";\n171\t\tcase PSBT_IN_SIGHASH_TYPE:\n172\t\t\treturn \"IN_SIGHASH_TYPE\";\n173\t\tcase PSBT_IN_REDEEM_SCRIPT:\n174\t\t\treturn \"IN_REDEEM_SCRIPT\";\n175\t\tcase PSBT_IN_WITNESS_SCRIPT:\n176\t\t\treturn \"IN_WITNESS_SCRIPT\";\n177\t\tcase PSBT_IN_BIP32_DERIVATION:\n178\t\t\treturn \"IN_BIP32_DERIVATION\";\n179\t\tcase PSBT_IN_FINAL_SCRIPTSIG:\n180\t\t\treturn \"IN_FINAL_SCRIPTSIG\";\n181\t\tcase PSBT_IN_FINAL_SCRIPTWITNESS:\n182\t\t\treturn \"IN_FINAL_SCRIPTWITNESS\";\n183\t\t}\n184\t\n185\t\treturn \"UNKNOWN_INPUT_TYPE\";\n186\t}\n187\t\n188\tconst char *\n189\tpsbt_state_tostr(enum psbt_state state) {\n190\t\tswitch (state) {\n191\t\tcase PSBT_ST_INIT:\n192\t\t\treturn \"INIT\";\n193\t\tcase PSBT_ST_GLOBAL:\n194\t\t\treturn \"GLOBAL\";\n195\t\tcase PSBT_ST_INPUTS:\n196\t\t\treturn \"INPUTS\";\n197\t\tcase PSBT_ST_INPUTS_NEW:\n198\t\t\treturn \"INPUTS_NEW\";\n199\t\tcase PSBT_ST_OUTPUTS:\n200\t\t\treturn \"OUTPUTS\";\n201\t\tcase PSBT_ST_OUTPUTS_NEW:\n202\t\t\treturn \"OUTPUTS_NEW\";\n203\t\tcase PSBT_ST_FINALIZED:\n204\t\t\treturn \"FINALIZED\";\n205\t\t}\n206\t\n207\t\treturn \"UNKNOWN_STATE\";\n208\t}\n209\t\n210\tconst char *\n211\tpsbt_output_type_tostr(enum psbt_output_type type) {\n212\t\tswitch (type) {\n213\t\tcase PSBT_OUT_REDEEM_SCRIPT:\n214\t\