n\n    }\n    pub fn get_size(&self) -> usize {\n        self.size\n    }\n    pub fn print(&self, hex: bool) {\n        let mut s = String::new();\n        for i in 0..self.size {\n            let c: u8 = if self.data_size == 0 {\n                b'_'\n            } else if self.tail_offset < self.head_offset {\n                if i > self.tail_offset && i < self.head_offset {\n                    b'_'\n                } else {\n                    self.buffer[i]\n                }\n            } else if i > self.tail_offset || i < self.head_offset {\n                b'_'\n            } else {\n                self.buffer[i]\n            };\n\n            if hex {\n                s.push_str(&format!(\"{:02X}|\", c));\n            } else {\n                s.push(c as char);\n                s.push('|');\n            }\n        }\n        println!(\n            \"CircularBuffer: {} <size {} dataSize:{}>\",\n            s, self.size, self.data_size\n        );\n    }\n    pub fn free(self) {\n        // Rust drops the buffer automatically when `self` goes out of scope.\n    }\n    pub fn reset(&mut self) {\n        self.head_offset = SENTINEL;\n        self.tail_offset = SENTINEL;\n        self.data_size = 0;\n    }\n    pub fn get_capacity(&self) -> usize {\n        self.size\n    }\n    pub fn push(&mut self, src: &[u8], length: usize) {\n        if length == 0 {\n            return;\n        }\n\n        let mut writable_len = length;\n        let mut src_start = 0usize;\n\n        // In case of size overflow, drop the oldest portion of `src`.\n        if writable_len > self.size {\n            let overflow_len = writable_len - self.size;\n            writable_len = self.size;\n            src_start = overflow_len;\n        }\n\n        let p_src = &src[src_start..src_start + writable_len];\n\n        let mut reset_head = false;\n\n        // tail_offset + writable_len < size (with wrapping when tail_offset == SENTINEL)\n        let tail_plus = self.tail_offset.wrapping_add(writable_len);\n\n        if tail_plus < self.size {\n            // Buffer won't be full after adding the data.\n            let start = self.tail_offset.wrapping_add(1);\n            self.buffer[start..start + writable_len].copy_from_slice(p_src);\n\n            if self.tail_offset < self.head_offset\n                && tail_plus >= self.head_offset\n            {\n                reset_head = true;\n            }\n\n            self.tail_offset = tail_plus;\n        } else {\n            // Buffer will overflow after adding the data.\n            let start = self.tail_offset.wrapping_add(1);\n            let remain_size = self.size - start;\n            self.buffer[start..start + remain_size]\n                .copy_from_slice(&p_src[..remain_size]);\n\n            let cover_size = writable_len - remain_size;\n            self.buffer[..cover_size].copy_from_slice(&p_src[remain_size..]);\n\n            if self.tail_offset < self.head_offset {\n                reset_head = true;\n            } else if cover_size > self.head_offset {\n                reset_head = true;\n            }\n\n            self.tail_offset = cover_size - 1;\n        }\n\n        if self.head_offset == SENTINEL {\n            self.head_offset = 0;\n        }\n\n        if reset_head {\n            if self.tail_offset + 1 < self.size {\n                self.head_offset = self.tail_offset + 1;\n            } else {\n                self.head_offset = 0;\n            }\n            self.data_size = self.size;\n        } else if self.tail_offset >= self.head_offset {\n            self.data_size = self.tail_offset - self.head_offset + 1;\n        } else {\n            self.data_size = self.size - (self.head_offset - self.tail_offset - 1);\n        }\n    }\n    pub fn inter_read(&mut self, length: usize, data_out: &mut [u8], reset_head: bool) -> usize {\n        if self.data_size == 0 || length == 0 {\n            return 0;\n        }\n\n        let mut rd_len = length;\n        if sel