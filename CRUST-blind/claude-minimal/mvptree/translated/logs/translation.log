                  let idx = i * bf + j;","+                            if idx >= child_count {","+                                continue;","+                            }","+                            let existing_child = {","+                                let n = node_rc.borrow();","+                                if let Node::Internal(internal) = &*n {","+                                    Some(internal.child_nodes[idx].clone())","+                                } else {","+                                    None","+                                }","+                            };","+                            let new_child = self._add_recursive(","+                                existing_child,","+                                bins2[j].clone(),","+                                lvl + 2,","+                                bf,","+                                leafcap,","+                                path_length,","+                                dist,","+                            )?;","+                            if let Some(nc) = new_child {","+                                let mut n_mut = node_rc.borrow_mut();","+                                if let Node::Internal(internal) = &mut *n_mut {","+                                    internal.child_nodes[idx] = nc;","+                                }","+                            }","+                        }","+                    }","+                    Ok(Some(node_rc.clone()))","+                }","+            }","+        }","+    }","+","+    /* Recursive retrieve helper. Mirrors _mvptree_retrieve() in mvptree.c. */","+    fn _retrieve_recursive(","+        node: Rc<RefCell<Node>>,","+        target: &MVPDatapoint,","+        radius: f32,","+        knearest: usize,","+        results: &mut Vec<Arc<MVPDatapoint>>,","+        target_path: &mut Vec<f32>,","+        lvl: usize,","+        bf: usize,","+        path_length: usize,","+        dist: DistanceFunction,","+    ) -> Resul