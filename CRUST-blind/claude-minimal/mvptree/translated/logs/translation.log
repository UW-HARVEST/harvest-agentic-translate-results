                + idlen as usize","+                    + 4","+                    + (datalength as usize) * type_size","+                    + path_length * 4) as u32;","+                buf.push(active);","+                buf.extend_from_slice(&bytelength.to_le_bytes());","+                buf.push(idlen);","+                buf.extend_from_slice(&id_bytes[..idlen as usize]);","+                buf.extend_from_slice(&datalength.to_le_bytes());","+                let data_byte_count = (datalength as usize) * type_size;","+                if dp.data.len() >= data_byte_count {","+                    buf.extend_from_slice(&dp.data[..data_byte_count]);","+                } else {","+                    buf.extend_from_slice(&dp.data);","+                    for _ in dp.data.len()..data_byte_count {","+                        buf.push(0);","+                    }","+                }","+                for i in 0..path_length {","+                    let f = if i < dp.path.len() { dp.path[i] } else { 0.0f32 };","+                    buf.extend_from_slice(&f.to_le_bytes());","+                }","+            }","+        }","+        start","+    }","+","+    /* Recursively write a node to buf. Mirrors _mvptree_write() in mvptree.c. */","+    fn _write_node_recursive(","+        node: Rc<RefCell<Node>>,","+        buf: &mut Vec<u8>,","+        error: &mut MVPError,","+        path_length: usize,","+        bf: usize,","+        leafcap: usize,","+        datatype: MVPDataType,","+    ) -> u64 {","+        let start = buf.len() as u64;","+        let n = node.borrow();","+        match &*n {","+            Node::Leaf(leaf) => {","+                buf.push(NodeType::LeafNode as u8);","+                Self::_write_datapoint(buf, leaf.sv1.as_deref(), path_length, datatype);","+                Self::_write_datapoint(buf, leaf.sv2.as_deref(), path_length, datatype);","+                let nbpoints: u32 = leaf.nbpoints as u32;","+                buf.extend_from_slice(&nbpoin