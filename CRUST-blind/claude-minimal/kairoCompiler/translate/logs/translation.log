ne => return Node::default(),\n    };\n\n    let mut nvr = NODE_VECTOR_ROOT.lock().unwrap();\n    let root_idx = if let Some(rv) = nvr.as_mut() {\n        if vector_empty(rv) {\n            None\n        } else {\n            vector_back_ptr_or_null(rv).and_then(|b| decode_index(b))\n        }\n    } else {\n        None\n    };\n\n    vector_pop(v);\n    if Some(last_idx) == root_idx {\n        if let Some(rv) = nvr.as_mut() {\n            vector_pop(rv);\n        }\n    }\n    drop(nv);\n    drop(nvr);\n    let nodes = NODES.lock().unwrap();\n    nodes\n        .get(last_idx as usize)\n        .cloned()\n        .unwrap_or_default()\n}\n/// Creates a new node from a template node, pushing it onto node_vector and returning the clone.\npub fn node_create(template: &Node) -> Node {\n    node_push(template);\n    template.clone()\n}\n","structuredPatch":[{"oldStart":1,"oldLines":69,"newStart":1,"newLines":137,"lines":[" use crate::compiler::Pos;"," use crate::vector::{","-vector_back_ptr, vector_back_ptr_or_null, vector_create, vector_empty,","-vector_pop, vector_push, vector_element_size, Vector,","+    vector_back_ptr, vector_back_ptr_or_null, vector_empty, vector_pop, vector_push, Vector,"," };"," use std::sync::Mutex;"," use lazy_static::lazy_static;","+"," #[derive(Debug, Default, Clone)]"," pub struct NodeBinded {","-pub owner: Option<Box<Node>>,","-pub function: Option<Box<Node>>,","+    pub owner: Option<Box<Node>>,","+    pub function: Option<Box<Node>>,"," }","+"," #[derive(Debug, Default, Clone)]"," pub struct Node {","-pub r#type: i32,","-pub flags: i32,","-pub pos: Pos,","-pub binded: NodeBinded,","-pub cval: Option<char>,","-pub sval: Option<String>,","-pub inum: Option<u32>,","-pub lnum: Option<u64>,","-pub llnum: Option<u64>,","+    pub r#type: i32,","+    pub flags: i32,","+    pub pos: Pos,","+    pub binded: NodeBinded,","+    pub cval: Option<char>,","+    pub sval: Option<String>,","+    pub inum: Option<u32>,","+    pub lnum: Option<u64>,","+    