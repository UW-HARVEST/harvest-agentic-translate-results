{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013VBBH2uY8EnUNzogrKjtQ3","type":"tool_result","content":"1\t#include \"assert.h\"\n2\t#include \"satc.h\"\n3\t\n4\t#define satc_nearest_hundredth(n) floor(n * 100 + 0.5) / 100\n5\t\n6\tvoid satc_point_scale_xy_test () {\n7\t  satc_point_alloca(v);\n8\t  satc_point_set_xy(v, 5.0, 5.0);\n9\t  satc_point_scale_xy(v, 10.0, 10.0);\n10\t  assert(satc_point_get_x(v) == 50.0);\n11\t  assert(satc_point_get_y(v) == 50.0);\n12\t  satc_point_scale_xy(v, 0.0, 1.0);\n13\t  assert(satc_point_get_x(v) == 0.0);\n14\t  assert(satc_point_get_y(v) == 50.0);\n15\t  satc_point_scale_xy(v, 1.0, 0.0);\n16\t  assert(satc_point_get_x(v) == 0.0);\n17\t  assert(satc_point_get_y(v) == 0.0);\n18\t}\n19\t\n20\tvoid satc_polygon_get_centroid_test () {\n21\t  {\n22\t    // Centroid of a square\n23\t    satc_point_array_alloca(points, 4);\n24\t    satc_point_alloca(pos);\n25\t    satc_point_set_xy(pos, 0.0, 0.0);\n26\t    satc_point_alloca(a);\n27\t    satc_point_set_xy(a, 0.0, 0.0);\n28\t    satc_point_alloca(b);\n29\t    satc_point_set_xy(b, 40.0, 0.0);\n30\t    satc_point_alloca(c);\n31\t    satc_point_set_xy(c, 40.0, 40.0);\n32\t    satc_point_alloca(d);\n33\t    satc_point_set_xy(d, 0.0, 40.0);\n34\t    points[0] = a;\n35\t    points[1] = b;\n36\t    points[2] = c;\n37\t    points[3] = d;\n38\t    satc_polygon_t *polygon = satc_polygon_create(pos, 4, points);\n39\t    double *centroid = satc_polygon_get_centroid(polygon);\n40\t    assert(satc_point_get_x(centroid) == 20.0);\n41\t    assert(satc_point_get_y(centroid) == 20.0);\n42\t    satc_point_destroy(centroid);\n43\t    satc_polygon_destroy(polygon);\n44\t  }\n45\t\n46\t  {\n47\t    // Centroid of a triangle\n48\t    satc_point_array_alloca(points, 3);\n49\t    satc_point_alloca(pos);\n50\t    satc_point_set_xy(pos, 0.0, 0.0);\n51\t    satc_point_alloca(a);\n52\t    satc_point_set_xy(a, 0.0, 0.0);\n53\t    satc_point_alloca(b);\n54\t    satc_point_set_xy(b, 100.0,