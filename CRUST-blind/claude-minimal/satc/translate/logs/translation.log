ted pointer values.\n175\t *\n176\t * Since it uses `alloca`, the array will automatically be deallocated when it\n177\t * falls out of scope.\n178\t *\n179\t * The members will not be automatically deallocated when the array falls out\n180\t * of scope, unless the members were allocated with `alloca` too!\n181\t *\n182\t * This macro is considered a statement.\n183\t *\n184\t * @param name the variable name for the array.\n185\t * @param size the number of pointers to points in the array.\n186\t */\n187\t#define satc_point_array_alloca(name, size) \\\n188\t  double **name = NULL; \\\n189\t  name = (double **) alloca(sizeof(double *) * size);\n190\t\n191\t/**\n192\t * Creates a pointer to an array of doubles (a point), with undefined `x` and\n193\t * `y` values.\n194\t *\n195\t * Since it uses `alloca`, the point will automatically be deallocated when it\n196\t * falls out of scope.\n197\t *\n198\t * This macro is considered a statement.\n199\t *\n200\t * @param name the variable name for the point.\n201\t */\n202\t#define satc_point_alloca(name) \\\n203\t  double *name = NULL; \\\n204\t  name = (double *) alloca(sizeof(double) * 2);\n205\t\n206\t/**\n207\t * Creates a pointer to an array of doubles (a point), with defined `x` and `y`\n208\t * values.\n209\t *\n210\t * Since it uses `alloca`, the point will automatically be deallocated when it\n211\t * falls out of scope.\n212\t *\n213\t * This macro is considered a statement.\n214\t *\n215\t * @param name the variable name for the array.\n216\t * @param x the x value, as a double, for the point.\n217\t * @param y the y value, as a double, for the point.\n218\t */\n219\t#define satc_point_alloca_xy(name, x, y) \\\n220\t  satc_point_alloca(name); \\\n221\t  satc_point_set_xy(name, x, y);\n222\t\n223\t/** Denotes a left voronoi region, for polygon collision detection. */\n224\t#define SATC_LEFT_VORONOI_REGION -1\n225\t/** Denotes a middle voronoi region, for polygon collision detection. */\n226\t#define SATC_MIDDLE_VORONOI_REGION 0\n227\t/** Denotes a right voronoi region, for polygon collision detection. */\n228\t#define SATC_RIGHT_VORONOI_REGION 1\n229\t\n230\t/** The index of the double array which contains the `x` value.. */\n231\t#define SATC_POINT_X 0\n232\t/** The index of the double array which contains the `y` value.. */\n233\t#define SATC_POINT_Y 1\n234\t\n235\t/**\n236\t * Get the `x` value from an array of doubles (a point).\n237\t *\n238\t * @param p the array of doubles (point) to fetch from.\n239\t * @return the `x` value as a double.\n240\t */\n241\t#define satc_point_get_x(p) p[SATC_POINT_X]\n242\t/**\n243\t * Set the `x` value in an array of doubles (a point).\n244\t *\n245\t * This macro is considered a statement.\n246\t *\n247\t * @param p the array of doubles (point) whose value should change.\n248\t * @param v the `x` value to change.\n249\t */\n250\t#define satc_point_set_x(p, v) p[SATC_POINT_X] = v;\n251\t/**\n252\t * Get the `y` value from an array of doubles (a point).\n253\t *\n254\t * @param p the array of doubles (point) to fetch from.\n255\t * @return the `y` value as a double.\n256\t */\n257\t#define satc_point_get_y(p) p[SATC_POINT_Y]\n258\t/**\n259\t * Set the `y` value in an array of doubles (a point).\n260\t *\n261\t * This macro is considered a statement.\n262\t *\n263\t * @param p the array of doubles (point) whose value should change.\n264\t * @param v the `y` value to change.\n265\t */\n266\t#define satc_point_set_y(p, v) p[SATC_POINT_Y] = v;\n267\t/**\n268\t * Set both the `x` and `y` values in an array of doubles (a point).\n269\t *\n270\t * This macro is considered a statement.\n271\t *\n272\t * @param p the array of doubles (point) whose value should change.\n273\t * @param x the `x` value to change.\n274\t * @param y the `y` value to change.\n275\t */\n276\t#define satc_point_set_xy(p, x, y) \\\n277\t  p[SATC_POINT_X] = x; \\\n278\t  p[SATC_POINT_Y] = y;\n279\t/**\n280\t * Given a point, allocate a separate array of doubles (a point) with\n281\t * equivalent values.\n282\t *\n283\t * This macro is considered a statement.\n284\t *\n285\t * You are responsible for deallocating the point.\n286\t *\n287\t * @param p the point to clone.\n288\t */\n289\t#define satc_point_clone(p) satc_point_create(satc_point_get_x(p), satc_point_get_y(p))\n290\t\n291\t// --------------------------------------------------------------------\n292\t// Forward declarations of certain functions called by other functions.\n293\t// --------------------------------------------------------------------\n294\t\n295\t/** Forward declaration of `satc_polygon_set_points`. */\n296\tsatc_polygon_t *satc_polygon_set_points (satc_polygon_t *polygon, size_t num_points, double **points);\n297\t/** Forward declaration of `_satc_polygon_recalc`. */\n298\tsatc_polygon_t *_satc_polygon_recalc (satc_polygon_t *polygon);\n299\t/** Forward declaration of `satc_box_create`. */\n300\tsatc_box_t *satc_box_create (double *pos, double w, double h);\n301\t/** Forward declaration of `satc_box_destroy`. */\n302\tvoid satc_box_destroy (satc_box_t *box);\n303\t/** Forward declaration of `satc_box_to_polygon`. */\n304\tsatc_polygon_t *satc_box_to_polygon (satc_box_t *box);\n305\t/** Forward declaration of `satc_test_polygon_polygon`. */\n306\tbool satc_test_polygon_polygon (satc_polygon_t *a, satc_polygon_t *b, satc_response_t *response);\n307\t\n308\t// ---------\n309\t// Functions\n310\t// ---------\n311\t\n312\t/**\n313\t * Copy the values of some array of doubles (a point) `q`, onto some point `p`.\n314\t *\n315\t * `p` will be mutated.\n316\t *\n317\t * @param p the point to mutate.\n318\t * @param q the point whose values to use\n319\t * @return the mutated point.\n320\t */\n321\tdouble *satc_point_copy (double *p, double *q) {\n322\t  satc_point_set_xy(p, satc_point_get_x(q), satc_point_get_y(q));\n323\t  return p;\n324\t}\n325\t\n326\t/**\n327\t * Modify the values of some array of doubles (a point) `p` so they match a\n328\t * point perpendicular to the original point.\n329\t *\n330\t * `p` will be mutated.\n331\t *\n332\t * @param p the point to mutate.\n333\t * @return the mutated point.\n334\t */\n335\tdouble *satc_point_perp (double *p) {\n336\t  double x = satc_point_get_y(p);\n337\t  double y = -satc_point_get_x(p);\n338\t  satc_point_set_xy(p, x, y);\n339\t  return p;\n340\t}\n341\t\n342\t/**\n343\t * Modify the values of some array of doubles (a point) `p` so they match an\n344\t * inverse point to the original point.\n345\t *\n346\t * `p` will be mutated.\n347\t *\n348\t * @param p the point to mutate.\n349\t * @return the mutated point.\n350\t */\n351\tdouble *satc_point_reverse (double *p) {\n352\t  satc_point_set_xy(p, -satc_point_get_x(p), -satc_point_get_y(p));\n353\t  return p;\n354\t}\n355\t\n356\t/**\n357\t * Find the dot product of two arrays of doubles (points).\n358\t *\n359\t * @param p the first point.\n360\t * @param q the second point.\n361\t * @return the dot product, as a double.\n362\t */\n363\t#define satc_point_dot(p, q) satc_point_get_x(p) * satc_point_get_x(q) + satc_point_get_y(p) * satc_point_get_y(q)\n364\t/**\n365\t * Find the length, squared, of an array of doubles (a point).\n366\t *\n367\t * @param p the point to query.\n368\t * @return the length squared, as a double.\n369\t */\n370\t#define satc_point_len2(p) satc_point_dot(p, p)\n371\t/**\n372\t * Find the length, of an array of doubles (a point). This is slightly more\n373\t * intensive than finding the length squared.\n374\t *\n375\t * @param p the point to query.\n376\t * @return the length, as a double.\n377\t */\n378\t#define satc_point_len(p) sqrt(satc_point_len2(p))\n379\t\n380\t/**\n381\t * Find the sum of two arrays of doubles (points), and replace the values of the\n382\t * first point to match the sum.\n383\t *\n384\t * `p` will be mutated.\n385\t *\n386\t * @param p the first point.\n387\t * @param q the second point.\n388\t * @return the mutated point.\n389\t */\n390\tdouble *satc_point_add (double *p, double *q) {\n391\t  satc_point_set_xy(p, satc_point_get_x(p) + satc_point_get_x(q), satc_point_get_y(p) + satc_point_get_y(q));\n392\t  return p;\n393\t}\n394\t\n395\t/**\n396\t * Find the difference of two arrays of doubles (points), and replace the\n397\t * values of the first point to match the difference.\n398\t *\n399\t * `p` will be mutated.\n400\t *\n401\t * @param p the first point.\n402\t * @param q the second point.\n403\t * @return the mutated point.\n404\t */\n405\tdouble *satc_point_sub (double *p, double *q) {\n406\t  satc_point_set_xy(p, satc_point_get_x(p) - satc_point_get_x(q), satc_point_get_y(p) - satc_point_get_y(q));\n407\t  return p;\n408\t}\n409\t\n410\t/**\n411\t * Scale some array of doubles (a point) by some value, `x`, and some value,\n412\t * `y`, and replace the values of the point to match the scaled result.\n413\t *\n414\t * `p` will be mutated.\n415\t *\n416\t * @param p the point to mutate.\n417\t * @param x the `x` value to scale by.\n418\t * @param y the `y` value to scale by.\n419\t * @return the mutated point.\n420\t */\n421\tdouble *satc_point_scale_xy (double *p, double x, double y) {\n422\t  satc_point_set_xy(p, satc_point_get_x(p) * x, satc_point_get_y(p) * y);\n423\t  return p;\n424\t}\n425\t\n426\t/**\n427\t * Scale some array of doubles (a point) by some value, `x`, along both axes.\n428\t *\n429\t * `p` will be mutated.\n430\t *\n431\t * @param p the point to mutate.\n432\t * @param x the `x` value to scale by, horizontally, and vertically.\n433\t * @return the mutated point.\n434\t */\n435\tdouble *satc_point_scale_x (double *p, double x) {\n436\t  return satc_point_scale_xy(p, x, x);\n437\t}\n438\t\n439\t/**\n440\t * Allocates a new array of doubles (a point). The values will be undefined.\n441\t *\n442\t * You are responsible for deallocating the point.\n443\t *\n444\t * @return the newly-created point.\n445\t */\n446\tdouble *satc_point_create (double x, double y) {\n447\t  double *point = NULL;\n448\t  point = (double *) malloc(sizeof(double) * 2);\n449\t  satc_point_set_xy(point, x, y);\n450\t  return point;\n451\t}\n452\t\n453\t/**\n454\t * Deallocates an array of doubles (a point).\n455\t *\n456\t * @param point the point to deallocate.\n457\t */\n458\tvoid satc_point_destroy (double *point) {\n459\t  free(point);\n460\t}\n461\t\n462\t/**\n463\t * Rotates a point by some angle.\n464\t *\n465\t * `p` will be mutated.\n466\t *\n467\t * @param p the point to rotate.\n468\t * @param angle the angle to rotate by.\n469\t */\n470\tdouble *satc_point_rotate (double *p, double angle) {\n471\t  double x = satc_point_get_x(p);\n472\t  double y = satc_point_get_y(p);\n473\t  satc_point_set_xy(p, x * cos(angle) - y * sin(angle), x * sin(angle) - y * cos(angle));\n474\t  return p;\n475\t}\n476\t\n477\t/**\n478\t * Normalize some array of doubles (a point) into a unit vector.\n479\t *\n480\t * `p` will be mutated.\n481\t *\n482\t * @param p the point to mutate.\n483\t * @return the normalized point.\n484\t */\n485\tdouble *satc_point_normalize (double *p) {\n486\t  double d = satc_point_len(p);\n487\t  if (d > 0) satc_point_set_xy(p, satc_point_get_x(p) / d, satc_point_get_y(p) / d);\n488\t  return p;\n489\t}\n490\t\n491\t/**\n492\t * Project some array of doubles (a point) `q` onto `p`.\n493\t *\n494\t * `p` will be mutated.\n495\t *\n496\t * @param p the point to mutate.\n497\t * @param q the point used to project.\n498\t * @return the projected point point.\n499\t */\n500\tdouble *satc_point_project (double *p, double *q) {\n501\t  double amt = satc_point_dot(p, q) / satc_point_len2(q);\n502\t  satc_point_set_xy(p, amt * satc_point_get_x(p), amt * satc_point_get_y(p));\n503\t  return p;\n504\t}\n505\t\n506\t/**\n507\t * Project some array of doubles (a point) `q` onto `p`, but the result is not\n508\t * divided by the length of `q` squared.\n509\t *\n510\t * `p` will be mutated.\n511\t *\n512\t * @param p the point to mutate.\n513\t * @param q the point used to project.\n514\t * @return the projected point point.\n515\t */\n516\tdouble *satc_point_project_n (double *p, double *q) {\n517\t  double amt = satc_point_dot(p, q);\n518\t  satc_point_set_xy(p, amt * satc_point_get_x(p), amt * satc_point_get_y(p));\n519\t  return p;\n520\t}\n521\t\n522\t/**\n523\t * Reflect some array of doubles (a point) along some axis.\n524\t *\n525\t * `p` will be mutated.\n526\t *\n527\t * @param p the point to mutate.\n528\t * @param axis the angle to reflect on.\n529\t * @return the normalized point.\n530\t */\n531\tdouble *satc_point_reflect (double *p, double *axis) {\n532\t  double x = satc_point_get_x(p);\n533\t  double y = satc_point_get_y(p);\n534\t  satc_point_project(p, axis);\n535\t  satc_point_scale_x(p, 2.0);\n536\t  satc_point_set_xy(p, satc_point_get_x(p) - x, satc_point_get_y(p) - y);\n537\t  return p;\n538\t}\n539\t\n540\t/**\n541\t * Reflect some array of doubles (a point) along some axis. When projecting, the\n542\t * value is not divided by the length of `p` squared.\n543\t *\n544\t * `p` will be mutated.\n545\t *\n546\t * @param p the point to mutate.\n547\t * @param axis the angle to reflect on.\n548\t * @return the normalized point.\n549\t */\n550\tdouble *satc_point_reflect_n (double *p, double *axis) {\n551\t  double x = satc_point_get_x(p);\n552\t  double y = satc_point_get_y(p);\n553\t  satc_point_project_n(p, axis);\n554\t  satc_point_scale_x(p, 2.0);\n555\t  satc_point_set_xy(p, satc_point_get_x(p) - x, satc_point_get_y(p) - y);\n556\t  return p;\n557\t}\n558\t\n559\t/**\n560\t * Create a struct representing a circle, with a given position and radius.\n561\t *\n562\t * You are responsible for deallocating the circle.\n563\t *\n564\t * @param pos the position of the circle.\n565\t * @param r the radius of the circle.\n566\t * @return a circle struct.\n567\t */\n568\tsatc_circle_t *satc_circle_create (double *pos, double r) {\n569\t  satc_circle_t *circle = NULL;\n570\t  circle = (satc_circle_t *) malloc(sizeof(satc_circle_t));\n571\t  circle->type = satc_type_circle;\n572\t  circle->pos = satc_point_clone(pos);\n573\t  circle->r = r;\n574\t  return circle;\n575\t}\n576\t\n577\t/**\n578\t * Deallocates a struct representing a circle.\n579\t *\n580\t * @param circle the circle to deallocate.\n581\t */\n582\tvoid satc_circle_destroy (satc_circle_t *circle) {\n583\t  satc_point_destroy(circle->pos);\n584\t  circle->type = satc_type_none;\n585\t  circle->pos = NULL;\n586\t  circle->r = -1.0;\n587\t  free(circle);\n588\t}\n589\t\n590\t/**\n591\t * Returns a struct representing a rectangular polygon which is equivalent to\n592\t * the bounding box of a circle.\n593\t *\n594\t * You are responsible for deallocating the polygon.\n595\t *\n596\t * @param circle the circle whose bounding box is of interest.\n597\t * @return a polygon struct.\n598\t */\n599\tsatc_polygon_t *satc_circle_get_aabb (satc_circle_t *circle) {\n600\t  double r = circle->r;\n601\t  satc_point_alloca(corner);\n602\t  satc_point_copy(corner, circle->pos);\n603\t  satc_point_set_xy(corner, satc_point_get_x(corner) - r, satc_point_get_y(corner) - r);\n604\t  satc_box_t *box = satc_box_create(corner, r * 2.0, r * 2.0);\n605\t  satc_polygon_t *polygon = satc_box_to_polygon(box);\n606\t  satc_box_destroy(box);\n607\t  return polygon;\n608\t}\n609\t\n610\t/**\n611\t * Create a struct representing a polygon, with a given position and points.\n612\t *\n613\t * The points passed in are copied, and so you must handle the deallocation of\n614\t * the passed-in points.\n615\t *\n616\t * You are responsible for deallocating the polygon.\n617\t *\n618\t * @param pos the position of the polygon.\n619\t * @param num_points the number of points provided.\n620\t * @param points an array of arrays of doubles (array of points).\n621\t * @return a polygon struct.\n622\t */\n623\tsatc_polygon_t *satc_polygon_create (double *pos, size_t num_points, double **points) {\n624\t  satc_polygon_t *polygon = NULL;\n625\t  polygon = (satc_polygon_t *) malloc(sizeof(satc_polygon_t));\n626\t  polygon->type = satc_type_polygon;\n627\t  polygon->pos = satc_point_clone(pos);\n628\t  polygon->angle = 0.0;\n629\t  polygon->offset = satc_point_create(0.0, 0.0);\n630\t\n631\t  polygon->num_points = 0;\n632\t  polygon->points = NULL;\n633\t  polygon->num_calc_points = 0;\n634\t  polygon->calc_points = NULL;\n635\t  polygon->num_edges = 0;\n636\t  polygon->edges = NULL;\n637\t  polygon->num_normals = 0;\n638\t  polygon->normals = NULL;\n639\t\n640\t  satc_polygon_set_points(polygon, num_points, points);\n641\t\n642\t  return polygon;\n643\t}\n644\t\n645\t/**\n646\t * Deallocates a struct representing a polygon.\n647\t *\n648\t * @param polygon the polygon to deallocate.\n649\t */\n650\tvoid satc_polygon_destroy (satc_polygon_t *polygon) {\n651\t  satc_point_destroy(polygon->pos);\n652\t  satc_point_destroy(polygon->offset);\n653\t\n654\t  size_t i = 0;\n655\t  for (; i < polygon->num_points; i++) {\n656\t    satc_point_destroy(polygon->points[i]);\n657\t  }\n658\t\n659\t  free(polygon->points);\n660\t\n661\t  polygon->type = satc_type_none;\n662\t  polygon->pos = NULL;\n663\t  polygon->num_points = -1;\n664\t  polygon->points = NULL;\n665\t  polygon->angle = 0.0;\n666\t  polygon->offset = NULL;\n667\t  free(polygon);\n668\t}\n669\t\n670\t/**\n671\t * Replace a polygon struct's list of points.\n672\t *\n673\t * The old points will be deallocated. The new points will be deallocated when\n674\t * the polygon is deallocated.\n675\t *\n676\t * The calculated values of the polygon will be recalculated.\n677\t *\n678\t * The points passed in are copied, and so you must handle the deallocation of\n679\t * the passed-in points.\n680\t *\n681\t * For internal use.\n682\t *\n683\t * @param polygon the polygon whose points to replace.\n684\t * @param num_points the number of new points.\n685\t * @param points an array of arrays of doubles (array of points).\n686\t */\n687\tvoid _satc_polygon_copy_points (satc_polygon_t *polygon, size_t num_points, double **points) {\n688\t  if (polygon->points != NULL) {\n689\t    size_t i = 0;\n690\t    for (; i < polygon->num_points; i++) satc_point_destroy(polygon->points[i]);\n691\t    free(polygon->points);\n692\t    polygon->num_points = 0;\n693\t    polygon->points = NULL;\n694\t  }\n695\t\n696\t  double **new_points = NULL;\n697\t  new_points = (double **) malloc(sizeof(double *) * num_points);\n698\t  size_t i = 0;\n699\t  for (; i < num_points; i++) new_points[i] = satc_point_clone(points[i]);\n700\t  polygon->num_points = num_points;\n701\t  polygon->points = new_points;\n702\t  _satc_polygon_recalc(polygon);\n703\t}\n704\t\n705\t/**\n706\t * Clear out the calculated points of a polygon and replace them with some\n707\t * number of preallocated empty points.\n708\t *\n709\t * The old calculated points will be deallocated. The new points will be\n710\t * deallocated when the polygon is deallocated.\n711\t *\n712\t * For internal use.\n713\t *\n714\t * @param polygon the polygon whose calculated points should be replaced.\n715\t * @param num_calc_points the number of pristine points to add.\n716\t */\n717\tvoid _satc_polygon_reset_calc_points (satc_polygon_t *polygon, size_t num_calc_points) {\n718\t  if (polygon->calc_points != NULL) {\n719\t    size_t i = 0;\n720\t    for (; i < polygon->num_calc_points; i++) satc_point_destroy(polygon->calc_points[i]);\n721\t    free(polygon->calc_points);\n722\t    polygon->num_calc_points = 0;\n723\t    polygon->calc_points = NULL;\n724\t  }\n725\t\n726\t  double **new_calc_points = NULL;\n727\t  new_calc_points = (double **) malloc(sizeof(double *) * num_calc_points);\n728\t\n729\t  size_t i = 0;\n730\t  for (; i < num_calc_points; i++) {\n731\t    new_calc_points[i] = satc_point_create(0.0, 0.0);\n732\t  }\n733\t\n734\t  polygon->num_calc_points = num_calc_points;\n735\t  polygon->calc_points = new_calc_points;\n736\t}\n737\t\n738\t/**\n739\t * Replace the calculated edges of a polygon with some number of pristine\n740\t * points representing edges.\n741\t *\n742\t * The old calculated edges will be deallocated. The new edges will be\n743\t * deallocated when the polygon is deallocated.\n744\t *\n745\t * For internal use.\n746\t *\n747\t * @param polygon the polygon whose edges should be replaced.\n748\t * @param num_edges the number of pristine points to add.\n749\t */\n750\tvoid _satc_polygon_reset_edges (satc_polygon_t *polygon, size_t num_edges) {\n751\t  if (polygon->edges != NULL) {\n752\t    size_t i = 0;\n753\t    for (; i < polygon->num_edges; i++) satc_point_destroy(polygon->edges[i]);\n754\t    free(polygon->edges);\n755\t    polygon->num_edges = 0;\n756\t    polygon->edges = NULL;\n757\t  }\n758\t\n759\t  double **new_edges = NULL;\n760\t  new_edges = (double **) malloc(sizeof(double *) * num_edges);\n761\t\n762\t  size_t i = 0;\n763\t  for (; i < num_edges; i++) {\n764\t    new_edges[i] = satc_point_create(0.0, 0.0);\n765\t  }\n766\t\n767\t  polygon->num_edges = num_edges;\n768\t  polygon->edges = new_edges;\n769\t}\n770\t\n771\t/**\n772\t * Replace the calculated normals of a polygon.\n773\t *\n774\t * The old calculated normals will be deallocated. The new calculated normals\n775\t * will be deallocated when the polygon is deallocated.\n776\t *\n777\t * For internal use.\n778\t *\n779\t * @param polygon the polygon whose calculated normals should be replaced.\n780\t * @param num_normals the number of pristine normals to add.\n781\t */\n782\tvoid _satc_polygon_reset_normals (satc_polygon_t *polygon, size_t num_normals) {\n783\t  if (polygon->normals != NULL) {\n784\t    size_t i = 0;\n785\t    for (; i < polygon->num_normals; i++) satc_point_destroy(polygon->normals[i]);\n786\t    free(polygon->normals);\n787\t    polygon->num_normals = 0;\n788\t    polygon->normals = NULL;\n789\t  }\n790\t\n791\t  double **new_normals = NULL;\n792\t  new_normals = (double **) malloc(sizeof(double *) * num_normals);\n793\t\n794\t  size_t i = 0;\n795\t  for (; i < num_normals; i++) {\n796\t    new_normals[i] = satc_point_create(0.0, 0.0);\n797\t  }\n798\t\n799\t  polygon->num_normals = num_normals;\n800\t  polygon->normals = new_normals;\n801\t}\n802\t\n803\t/**\n804\t * Given a polygon and number of points, it will clear out all of the\n805\t * calculated values, replace the points already on the polygon, and\n806\t * recalculate all the calculated values.\n807\t *\n808\t * All deallocation and allocation is handled for you.\n809\t *\n810\t * The points passed in are copied, and so you must handle the deallocation of\n811\t * the passed-in points.\n812\t *\n813\t * @param polygon the polygon whose points should be replaced.\n814\t * @param num_points the number of new points.\n815\t * @param points an array of arrays of doubles (array of points).\n816\t * @return the polygon passed in.\n817\t */\n818\tsatc_polygon_t *satc_polygon_set_points (satc_polygon_t *polygon, size_t num_points, double **points) {\n819\t  bool length_changed = num_points != polygon->num_points;\n820\t  if (length_changed) {\n821\t    _satc_polygon_reset_calc_points(polygon, num_points);\n822\t    _satc_polygon_reset_edges(polygon, num_points);\n823\t    _satc_polygon_reset_normals(polygon, num_points);\n824\t  }\n825\t\n826\t  _satc_polygon_copy_points(polygon, num_points, points);\n827\t  return polygon;\n828\t}\n829\t\n830\t/**\n831\t * Set the angle of rotation of the polygon. All calculated values will be\n832\t * recalculated.\n833\t *\n834\t * @param polygon the polygon to rotate.\n835\t * @param angle the angle to rotate by.\n836\t * @return the passed-in polygon.\n837\t */\n838\tsatc_polygon_t *satc_polygon_set_angle (satc_polygon_t *polygon, double angle) {\n839\t  polygon->angle = angle;\n840\t  _satc_polygon_recalc(polygon);\n841\t  return polygon;\n842\t}\n843\t\n844\t/**\n845\t * Set the offset of the polygon. All calculated values will be recalculated.\n846\t *\n847\t * @param polygon the polygon to offset.\n848\t * @param offset the array of doubles (a point) to offset by.\n849\t * @return the passed-in polygon.\n850\t */\n851\tsatc_polygon_t *satc_polygon_set_offset (satc_polygon_t *polygon, double *offset) {\n852\t  satc_point_copy(polygon->offset, offset);\n853\t  _satc_polygon_recalc(polygon);\n854\t  return polygon;\n855\t}\n856\t\n857\t/**\n858\t * In lieu of setting the angle of the polygon, you can actually rotate all of\n859\t * the points. All calculated values will be recalculated.\n860\t *\n861\t * @param polygon the polygon to offset.\n862\t * @param angle the array of doubles (a point) to offset by.\n863\t * @return the passed-in polygon.\n864\t */\n865\tsatc_polygon_t *satc_polygon_rotate (satc_polygon_t *polygon, double angle) {\n866\t  size_t i = 0;\n867\t  for (; i < polygon->num_points; i++) satc_point_rotate(polygon->points[i], angle);\n868\t  _satc_polygon_recalc(polygon);\n869\t  return polygon;\n870\t}\n871\t\n872\t/**\n873\t * In lieu of setting the offset of the polygon, you can actually translate all\n874\t * of the points by some `x` and `y`. All calculated values will be\n875\t * recalculated.\n876\t *\n877\t * @param polygon the polygon to offset.\n878\t * @param x the horizontal amount to translate by.\n879\t * @param y the vertical amount to translate by.\n880\t * @return the passed-in polygon.\n881\t */\n882\tsatc_polygon_t *satc_polygon_translate (satc_polygon_t *polygon, double x, double y) {\n883\t  size_t i = 0;\n884\t  for (; i < polygon->num_points; i++) satc_point_set_xy(polygon->points[i], x, y);\n885\t  _satc_polygon_recalc(polygon);\n886\t  return polygon;\n887\t}\n888\t\n889\t/**\n890\t * Recalculates all the calculated values for a struct representing a polygon\n891\t * shape.\n892\t *\n893\t * For internal use.\n894\t *\n895\t * @param polygon a polygon whose values should be recalculated.\n896\t * @return the passed-in polygon.\n897\t */\n898\tsatc_polygon_t *_satc_polygon_recalc (satc_polygon_t *polygon) {\n899\t  double **calc_points = polygon->calc_points;\n900\t  double **edges = polygon->edges;\n901\t  double **normals = polygon->normals;\n902\t  double **points = polygon->points;\n903\t  double *offset = polygon->offset;\n904\t  double angle = polygon->angle;\n905\t  size_t num_points = polygon->num_points;\n906\t  size_t i = 0;\n907\t  for (; i < num_points; i++) {\n908\t    double *calc_point = satc_point_copy(calc_points[i], points[i]);\n909\t    satc_point_add(calc_point, offset);\n910\t    if (angle != 0.0) satc_point_rotate(calc_point, angle);\n911\t  }\n912\t\n913\t  i = 0;\n914\t  for (; i < num_points; i++) {\n915\t    double *p1 = calc_points[i];\n916\t    double *p2 = (i < num_points - 1) ? calc_points[i + 1] : calc_points[0];\n917\t    double *edge = edges[i];\n918\t    satc_point_copy(edge, p2);\n919\t    satc_point_sub(edge, p1);\n920\t    double *normal = normals[i];\n921\t    satc_point_copy(normal, edge);\n922\t    satc_point_perp(normal);\n923\t    satc_point_normalize(normal);\n924\t  }\n925\t\n926\t  return polygon;\n927\t}\n928\t\n929\t/**\n930\t * Returns a polygon struct representing the bounding box of a polygon.\n931\t *\n932\t * You are responsible for deallocating the returned polygon.\n933\t *\n934\t * @param polygon the polygon whose bounding box should be calculated.\n935\t * @return a polygon representing the bounding box.\n936\t */\n937\tsatc_polygon_t *satc_polygon_get_aabb (satc_polygon_t *polygon) {\n938\t  double x_min = satc_point_get_x(polygon->points[0]);\n939\t  double y_min = satc_point_get_y(polygon->points[0]);\n940\t  double x_max = x_min;\n941\t  double y_max = x_max;\n942\t  size_t i = 1;\n943\t  for (; i < polygon->num_points; i++) {\n944\t    double x = satc_point_get_x(polygon->points[i]);\n945\t    double y = satc_point_get_y(polygon->points[i]);\n946\t    if (x < x_min) x_min = x;\n947\t    if (x > x_max) x_max = x;\n948\t    if (y < y_min) y_min = y;\n949\t    if (y > y_max) y_max = y;\n950\t  }\n951\t\n952\t  satc_point_alloca(pos);\n953\t  satc_point_set_xy(pos, satc_point_get_x(pos) + x_min, satc_point_get_y(pos) + y_min);\n954\t  satc_box_t *box = satc_box_create(pos, x_max - x_min, y_max - y_min);\n955\t  satc_polygon_t *new_polygon = satc_box_to_polygon(box);\n956\t  satc_box_destroy(box);\n957\t  return new_polygon;\n958\t}\n959\t\n960\t/**\n961\t * Get the \"centroid\" (the estimated center) of a polygon as an array of\n962\t * doubles (a point).\n963\t *\n964\t * You are responsible for deallocating the point.\n965\t *\n966\t * @param polygon the polygon whose centroid should be calculated.\n967\t * @return an array of doubles (a point) representing the centroid.\n968\t */\n969\tdouble *satc_polygon_get_centroid (satc_polygon_t *polygon) {\n970\t  double **points = polygon->calc_points;\n971\t  size_t len = polygon->num_calc_points;\n972\t  double cx = 0.0;\n973\t  double cy = 0.0;\n974\t  double ar = 0.0;\n975\t  size_t i = 0;\n976\t  for (; i < len; i++) {\n977\t    double *p1 = points[i];\n978\t    double *p2 = (i == len - 1) ? points[0] : points[i + 1];\n979\t    double a = satc_point_get_x(p1) * satc_point_get_y(p2) - satc_point_get_x(p2) * satc_point_get_y(p1);\n980\t    cx += (satc_point_get_x(p1) + satc_point_get_x(p2)) * a;\n981\t    cy += (satc_point_get_y(p1) + satc_point_get_y(p2)) * a;\n982\t    ar += a;\n983\t  }\n984\t\n985\t  ar = ar * 3.0;\n986\t  cx = cx / ar;\n987\t  cy = cy / ar;\n988\t\n989\t  return satc_point_create(cx, cy);\n990\t}\n991\t\n992\t/**\n993\t * Creates a struct representing a box shape.\n994\t *\n995\t * @param pos the position of the box, from the top left.\n996\t * @param w the width of the box.\n997\t * @param h the height of the box.\n998\t * @return a box struct.\n999\t */\n1000\tsatc_box_t *satc_box_create (double *pos, double w, double h) {\n1001\t  satc_box_t *box = NULL;\n1002\t  box = (satc_box_t *) malloc(sizeof(satc_box_t));\n1003\t  box->type = satc_type_box;\n1004\t  box->pos = satc_point_clone(pos);\n1005\t  box->w = w;\n1006\t  box->h = h;\n1007\t  return box;\n1008\t}\n1009\t\n1010\t/**\n1011\t * Deallocates a struct representing a box shape.\n1012\t *\n1013\t * @param box the box to deallocate.\n1014\t */\n1015\tvoid satc_box_destroy (satc_box_t *box) {\n1016\t  satc_point_destroy(box->pos);\n1017\t  box->type = satc_type_none;\n1018\t  box->pos = NULL;\n1019\t  box->w = -1.0;\n1020\t  box->h = -1.0;\n1021\t  free(box);\n1022\t}\n1023\t\n1024\t/**\n1025\t * Returns a polygon representing the box.\n1026\t *\n1027\t * You are responsible for deallocating the polygon.\n1028\t *\n1029\t * @param box the box to generate a polygon of.\n1030\t * @return a polygon representing the box.\n1031\t */\n1032\tsatc_polygon_t *satc_box_to_polygon (satc_box_t *box) {\n1033\t  double *pos = box->pos;\n1034\t  double w = box->w;\n1035\t  double h = box->h;\n1036\t  double **points = NULL;\n1037\t  points = (double **) alloca(sizeof(double *) * 4);\n1038\t  satc_point_alloca(nw);\n1039\t  satc_point_alloca(ne);\n1040\t  satc_point_alloca(se);\n1041\t  satc_point_alloca(sw);\n1042\t  satc_point_set_xy(nw, 0.0, 0.0);\n1043\t  satc_point_set_xy(ne, w, 0.0);\n1044\t  satc_point_set_xy(se, w, h);\n1045\t  satc_point_set_xy(sw, 0.0, h);\n1046\t  points[0] = nw;\n1047\t  points[1] = ne;\n1048\t  points[2] = se;\n1049\t  points[3] = sw;\n1050\t  return satc_polygon_create(pos, 4, points);\n1051\t}\n1052\t\n1053\t/**\n1054\t * Creates a struct representing a collision response.\n1055\t *\n1056\t * Instead of setting the values manually, you should use a `satc_test_*`\n1057\t * function, which will set the values for you.\n1058\t *\n1059\t * @return a struct representing a collision response.\n1060\t */\n1061\tsatc_response_t *satc_response_create () {\n1062\t  satc_response_t *response = NULL;\n1063\t  response = (satc_response_t *) malloc(sizeof(satc_response_t));\n1064\t  response->a = NULL;\n1065\t  response->b = NULL;\n1066\t  response->overlap_n = satc_point_create(0.0, 0.0);\n1067\t  response->overlap_v = satc_point_create(0.0, 0.0);\n1068\t  response->overlap = DBL_MAX;\n1069\t  response->a_in_b = true;\n1070\t  response->b_in_a = true;\n1071\t  return response;\n1072\t}\n1073\t\n1074\t/**\n1075\t * Deallocates a struct representing a collision response.\n1076\t *\n1077\t * `response->a` and `response->b` are not deallocated for you!\n1078\t *\n1079\t * @param response the response to deallocate.\n1080\t */\n1081\tvoid satc_response_destroy (satc_response_t *response) {\n1082\t  satc_point_destroy(response->overlap_n);\n1083\t  satc_point_destroy(response->overlap_v);\n1084\t\n1085\t  response->a = NULL;\n1086\t  response->b = NULL;\n1087\t  response->overlap_n = NULL;\n1088\t  response->overlap_v = NULL;\n1089\t  response->overlap = DBL_MAX;\n1090\t  response->a_in_b = true;\n1091\t  response->b_in_a = true;\n1092\t  free(response);\n1093\t}\n1094\t\n1095\t/**\n1096\t * Project the array of arrays of doubles (array of points) onto an axis.\n1097\t *\n1098\t * @param len the number of points.\n1099\t * @param points the array of arrays of doubles (points) to project.\n1100\t * @param normal the array of doubles (a point) of the normal.\n1101\t * @param result the arary of doubles (a point) representing the result.\n1102\t */\n1103\tvoid satc_flatten_points_on (size_t len, double **points, double *normal, double *result) {\n1104\t  double min = DBL_MAX;\n1105\t  double max = -DBL_MAX;\n1106\t\n1107\t  size_t i = 0;\n1108\t  for (; i < len; i++) {\n1109\t    double dot = satc_point_dot(points[i], normal);\n1110\t    if (dot < min) min = dot;\n1111\t    if (dot > max) max = dot;\n1112\t  }\n1113\t\n1114\t  result[0] = min;\n1115\t  result[1] = max;\n1116\t}\n1117\t\n1118\t/**\n1119\t * Figure out if two arrays of arrays of doubles (two arrays of points)\n1120\t * represent a separating axis.\n1121\t *\n1122\t * Primarily meant for internal use.\n1123\t *\n1124\t * @param a_pos an array of doubles (a point).\n1125\t * @param b_pos an array of doubles (a point).\n1126\t * @param a_len the number of points in `a_points`.\n1127\t * @param a_points an array of arrays of doubles (an array of points).\n1128\t * @param b_len the number of points in `b_points`.\n1129\t * @param b_points an array of arrays of doubles (an array of points).\n1130\t * @param axis the axis as an array of doubles (a point).\n1131\t * @param response the collision response to mutate.\n1132\t * @return whether this represents a separating axis, as a boolean.\n1133\t */\n1134\tbool satc_is_separating_axis (double *a_pos, double *b_pos, size_t a_len, double **a_points, size_t b_len, double **b_points, double *axis, satc_response_t *response) {\n1135\t  // Allocate temporary variables.\n1136\t  satc_double_array_alloca(range_a, 2);\n1137\t  satc_double_array_alloca(range_b, 2);\n1138\t  satc_point_alloca(offset_v);\n1139\t\n1140\t  // The magnitude of the offset between the two polygons.\n1141\t  satc_point_copy(offset_v, b_pos);\n1142\t  satc_point_sub(offset_v, a_pos);\n1143\t  double projected_offset = satc_point_dot(offset_v, axis);\n1144\t  // Project the polygons onto the axis.\n1145\t  satc_flatten_points_on(a_len, a_points, axis, range_a);\n1146\t  satc_flatten_points_on(b_len, b_points, axis, range_b);\n1147\t  // Move B's range to its position relative to A.\n1148\t  range_b[0] += projected_offset;\n1149\t  range_b[1] += projected_offset;\n1150\t  // Check if there is a gap. If there is, this is a separating axis and we can stop.\n1151\t  if (range_a[0] > range_b[1] || range_b[0] > range_a[1]) {\n1152\t    return true;\n1153\t  }\n1154\t\n1155\t  // This is not a separating axis. If we're calculating a response, calculate the overlap.\n1156\t  if (response != NULL) {\n1157\t    double overlap = 0;\n1158\t    // A starts further left than B.\n1159\t    if (range_a[0] < range_b[0]) {\n1160\t      response->a_in_b = false;\n1161\t      // A ends before B does. We have to pull A out of B.\n1162\t      if (range_a[1] < range_b[1]) {\n1163\t        overlap = range_a[1] - range_b[1];\n1164\t        response->b_in_a = false;\n1165\t      // B is fully inside A. Pick the shortest way out.\n1166\t      } else {\n1167\t        double option_1 = range_a[1] - range_b[0];\n1168\t        double option_2 = range_b[1] - range_a[0];\n1169\t        overlap = option_1 < option_2 ? option_1 : -option_2;\n1170\t      }\n1171\t    // B starts further left than A.\n1172\t    } else {\n1173\t      response->b_in_a = false;\n1174\t      // B ends before A ends. We have to push A out of B.\n1175\t      if (range_a[1] > range_b[1]) {\n1176\t        overlap = range_a[0] - range_b[1];\n1177\t        response->a_in_b = false;\n1178\t      // A is fully inside B.  Pick the shortest way out.\n1179\t      } else {\n1180\t        double option_1 = range_a[1] - range_b[0];\n1181\t        double option_2 = range_b[1] - range_a[0];\n1182\t        overlap = option_1 < option_2 ? option_1 : -option_2;\n1183\t      }\n1184\t    }\n1185\t\n1186\t    // If this is the smallest amount of overlap we've seen so far, set it as the minimum overlap.\n1187\t    double abs_overlap = fabs(overlap);\n1188\t    if (abs_overlap < response->overlap) {\n1189\t      response->overlap = abs_overlap;\n1190\t      satc_point_copy(response->overlap_n, axis);\n1191\t      if (overlap < 0) {\n1192\t        satc_point_reverse(response->overlap_n);\n1193\t      }\n1194\t    }\n1195\t  }\n1196\t\n1197\t  return false;\n1198\t}\n1199\t\n1200\t/**\n1201\t * Figure out if an array of doubles (a point) representing a line, and another\n1202\t * point represent either a left, middle, or right voronoi region.\n1203\t *\n1204\t * @param line an array of doubles (a point) representing a line.\n1205\t * @param point an array of doubles (a point).\n1206\t * @return an integer (-1, 0, or 1) representing which voronoi region was found.\n1207\t */\n1208\tint satc_voronoi_region (double *line, double *point) {\n1209\t  double len_2 = satc_point_len2(line);\n1210\t  double dp = satc_point_dot(point, line);\n1211\t  // If the point is beyond the start of the line, it is in the left voronoi region.\n1212\t  if (dp < 0) return SATC_LEFT_VORONOI_REGION;\n1213\t  // If the point is beyond the end of the line, it is in the right voronoi region.\n1214\t  if (dp > len_2) return SATC_RIGHT_VORONOI_REGION;\n1215\t  return SATC_MIDDLE_VORONOI_REGION;\n1216\t}\n1217\t\n1218\t/**\n1219\t * Returns true if an array of doubles (a point) is inside of a circle.\n1220\t *\n1221\t * @param p an array of doubles (a point).\n1222\t * @param c a circle.\n1223\t * @return true if point is inside of circle, false otherwise.\n1224\t */\n1225\tbool satc_point_in_circle (double *point, satc_circle_t *circle) {\n1226\t  satc_point_alloca(difference_v);\n1227\t  satc_point_copy(difference_v, point);\n1228\t  satc_point_sub(difference_v, circle->pos);\n1229\t  double radius_sq = circle->r * circle->r;\n1230\t  double distance_sq = satc_point_len2(difference_v);\n1231\t  return distance_sq <= radius_sq;\n1232\t}\n1233\t\n1234\t/**\n1235\t * Creates a very small polygon representing a point, for collision purposes.\n1236\t *\n1237\t * For internal use.\n1238\t *\n1239\t * You are responsible for deallocating the polygon.\n1240\t *\n1241\t * @return a polygon.\n1242\t */\n1243\tsatc_polygon_t *_satc_test_point_create () {\n1244\t  satc_point_alloca(zero);\n1245\t  satc_point_set_xy(zero, 0.0, 0.0);\n1246\t  satc_box_t *box = satc_box_create(zero, 0.000001, 0.000001);\n1247\t  satc_polygon_t *polygon = satc_box_to_polygon(box);\n1248\t  satc_box_destroy(box);\n1249\t  return polygon;\n1250\t}\n1251\t\n1252\t/**\n1253\t * Returns true if an array of doubles (a point) is inside of a polygon.\n1254\t *\n1255\t * @param p an array of doubles (a point).\n1256\t * @param polygon a polygon.\n1257\t * @return true if point is inside of polygon, false otherwise.\n1258\t */\n1259\tbool satc_point_in_polygon (double *point, satc_polygon_t *polygon) {\n1260\t  satc_polygon_t *test_point = _satc_test_point_create();\n1261\t  satc_point_copy(test_point->pos, point);\n1262\t  satc_response_t *response = satc_response_create();\n1263\t\n1264\t  bool result = satc_test_polygon_polygon(test_point, polygon, response);\n1265\t  if (result) result = response->a_in_b;\n1266\t\n1267\t  satc_response_destroy(response);\n1268\t  satc_polygon_destroy(test_point);\n1269\t\n1270\t  return result;\n1271\t}\n1272\t\n1273\t/**\n1274\t * Returns true if a circle overlaps with another circle.\n1275\t *\n1276\t * @param a a circle.\n1277\t * @param b another circle.\n1278\t * @param response a response representing the collision.\n1279\t * @return true if the circles overlap, false otherwise.\n1280\t */\n1281\tbool satc_test_circle_circle (satc_circle_t *a, satc_circle_t *b, satc_response_t *response) {\n1282\t  satc_point_alloca(difference_v);\n1283\t  satc_point_copy(difference_v, b->pos);\n1284\t  satc_point_sub(difference_v, a->pos);\n1285\t  double total_radius = a->r + b->r;\n1286\t  double total_radius_sq = total_radius * total_radius;\n1287\t  double distance_sq = satc_point_len2(difference_v);\n1288\t  if (distance_sq > total_radius_sq) return false;\n1289\t  if (response != NULL) {\n1290\t    double distance = sqrt(distance_sq);\n1291\t    response->a = a;\n1292\t    response->b = b;\n1293\t    response->overlap = total_radius - distance;\n1294\t    satc_point_normalize(difference_v);\n1295\t    satc_point_copy(response->overlap_n, difference_v);\n1296\t    satc_point_scale_x(difference_v, response->overlap);\n1297\t    satc_point_copy(response->overlap_v, difference_v);\n1298\t    response->a_in_b = (a->r <= b->r) && (distance <= b->r - a->r);\n1299\t    response->b_in_a = (b->r <= a->r) && (distance <= a->r - b->r);\n1300\t  }\n1301\t\n1302\t  return true;\n1303\t}\n1304\t\n1305\t/**\n1306\t * Checks to see if one polygon and one circle are overlapping.\n1307\t *\n1308\t * @param polygon a polygon.\n1309\t * @param circle a circle.\n1310\t * @param response the response object to set with collision data.\n1311\t */\n1312\tbool satc_test_polygon_circle (satc_polygon_t *polygon, satc_circle_t *circle, satc_response_t *response) {\n1313\t  satc_point_alloca(circle_pos);\n1314\t  satc_point_copy(circle_pos, circle->pos);\n1315\t  satc_point_sub(circle_pos, polygon->pos);\n1316\t  double radius = circle->r;\n1317\t  double radius2 = radius * radius;\n1318\t  double **points = polygon->calc_points;\n1319\t  size_t len = polygon->num_calc_points;\n1320\t  satc_point_alloca(edge);\n1321\t  satc_point_alloca(point);\n1322\t\n1323\t  size_t i = 0;\n1324\t  for (; i < len; i++) {\n1325\t    size_t next = (i == len - 1) ? 0 : i + 1;\n1326\t    size_t prev = (i == 0) ? len - 1 : i - 1;\n1327\t    double overlap = 0.0;\n1328\t    double *overlap_n = NULL;\n1329\t\n1330\t    satc_point_copy(edge, polygon->edges[i]);\n1331\t    satc_point_copy(point, circle_pos);\n1332\t    satc_point_sub(point, points[i]);\n1333\t\n1334\t    if (response != NULL && satc_point_len2(point) > radius2) {\n1335\t      response->a_in_b = false;\n1336\t    }\n1337\t\n1338\t    int region = satc_voronoi_region(edge, point);\n1339\t    if (region == SATC_LEFT_VORONOI_REGION) {\n1340\t      satc_point_copy(edge, polygon->edges[prev]);\n1341\t      satc_point_alloca(point2);\n1342\t      satc_point_copy(point2, circle_pos);\n1343\t      satc_point_sub(point2, points[prev]);\n1344\t      region = satc_voronoi_region(edge, point2);\n1345\t      if (region == SATC_RIGHT_VORONOI_REGION) {\n1346\t        double dist = satc_point_len(point);\n1347\t        if (dist > radius) {\n1348\t          return false;\n1349\t        } else if (response != NULL) {\n1350\t          response->b_in_a = false;\n1351\t          satc_point_normalize(point);\n1352\t          overlap_n = point;\n1353\t          overlap = radius - dist;\n1354\t        }\n1355\t      }\n1356\t    } else if (region == SATC_RIGHT_VORONOI_REGION) {\n1357\t      satc_point_copy(edge, polygon->edges[next]);\n1358\t      satc_point_copy(point, circle_pos);\n1359\t      satc_point_sub(point, points[next]);\n1360\t      region = satc_voronoi_region(edge, point);\n1361\t      if (region == SATC_LEFT_VORONOI_REGION) {\n1362\t        double dist = satc_point_len(point);\n1363\t        if (dist > radius) {\n1364\t          return false;\n1365\t        } else if (response != NULL) {\n1366\t          response->b_in_a = false;\n1367\t          satc_point_normalize(point);\n1368\t          overlap_n = point;\n1369\t          overlap = radius - dist;\n1370\t        }\n1371\t      }\n1372\t    } else {\n1373\t      satc_point_alloca(normal);\n1374\t      satc_point_perp(edge);\n1375\t      satc_point_normalize(edge);\n1376\t      satc_point_copy(normal, edge);\n1377\t      double dist = satc_point_dot(point, normal);\n1378\t      double dist_abs = fabs(dist);\n1379\t      if (dist > 0.0 && dist_abs > radius) {\n1380\t        return false;\n1381\t      } else {\n1382\t        overlap_n = normal;\n1383\t        overlap = radius - dist;\n1384\t        if (dist >= 0.0 || overlap < 2.0 * radius) {\n1385\t          response->b_in_a = false;\n1386\t        }\n1387\t      }\n1388\t    }\n1389\t\n1390\t    if (overlap_n != NULL && response != NULL && fabs(overlap) < fabs(response->overlap)) {\n1391\t      response->overlap = overlap;\n1392\t      satc_point_copy(response->overlap_n, overlap_n);\n1393\t    }\n1394\t  }\n1395\t\n1396\t  if (response != NULL) {\n1397\t    response->a = polygon;\n1398\t    response->b = circle;\n1399\t    satc_point_copy(response->overlap_v, response->overlap_n);\n1400\t    satc_point_scale_x(response->overlap_v, response->overlap);\n1401\t  }\n1402\t\n1403\t  return true;\n1404\t}\n1405\t\n1406\t/**\n1407\t * Checks to see if one circle and one polygon are overlapping.\n1408\t *\n1409\t * This is ever so slightly more expensive than `satc_test_polygon_circle`,\n1410\t * since the response data needs to be flipped after checking collision.\n1411\t *\n1412\t * @param circle a circle.\n1413\t * @param polygon a polygon.\n1414\t * @param response the response object to set with collision data.\n1415\t */\n1416\tbool satc_test_circle_polygon (satc_circle_t *circle, satc_polygon_t *polygon, satc_response_t *response) {\n1417\t  bool result = satc_test_polygon_circle(polygon, circle, response);\n1418\t  if (result && response != NULL) {\n1419\t    void *a = response->a;\n1420\t    bool a_in_b = response->a_in_b;\n1421\t    satc_point_reverse(response->overlap_n);\n1422\t    satc_point_reverse(response->overlap_v);\n1423\t    response->a = response->b;\n1424\t    response->b = a;\n1425\t    response->a_in_b = response->b_in_a;\n1426\t    response->b_in_a = a_in_b;\n1427\t  }\n1428\t\n1429\t  return result;\n1430\t}\n1431\t\n1432\t/**\n1433\t * Checks to see if one polygon and another are overlapping.\n1434\t *\n1435\t * @param a a polygon.\n1436\t * @param b another polygon.\n1437\t * @param response the response object to set with collision data.\n1438\t */\n1439\tbool satc_test_polygon_polygon (satc_polygon_t *a, satc_polygon_t *b, satc_response_t *response) {\n1440\t  double **a_points = a->points;\n1441\t  size_t a_len = a->num_points;\n1442\t  double **b_points = b->points;\n1443\t  size_t b_len = b->num_points;\n1444\t\n1445\t  size_t i = 0;\n1446\t  for (; i < a_len; i++) {\n1447\t    if (satc_is_separating_axis(a->pos, b->pos, a_len, a_points, b_len, b_points, a->normals[i], response)) {\n1448\t      return false;\n1449\t    }\n1450\t  }\n1451\t\n1452\t  i = 0;\n1453\t  for (; i < b_len; i++) {\n1454\t    if (satc_is_separating_axis(a->pos, b->pos, a_len, a_points, b_len, b_points, b->normals[i], response)) {\n1455\t      return false;\n1456\t    }\n1457\t  }\n1458\t\n1459\t  if (response != NULL) {\n1460\t    response->a = a;\n1461\t    response->b = b;\n1462\t    satc_point_copy(response->overlap_v, response->overlap_n);\n1463\t    satc_point_scale_x(response->overlap_v, response->overlap);\n1464\t  }\n1465\t\n1466\t  return true;\n1467\t}\n1468\t\n1469\t#endif\n1470\t"}]},"parent_tool_use_id":null,"session_id":"4da6dec1-f3b7-461b-99cc-23990d7db58e","uuid":"833f87da-6fe1-43cc-9840-aedcb6729c92","timestamp":"2026-06-02T03:22:41.470Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-TE0YcA/project/c_src/satc.h","content":"/* vim: set ft=c: */\n\n/** @file */\n\n#ifndef __SATC__\n#define __SATC__\n\n#include \"stdio.h\"\n#include \"stdlib.h\"\n#include \"stdbool.h\"\n#include \"math.h\"\n#include \"float.h\"\n\n// -------------------------------------\n// Forward declarations for the structs.\n// -------------------------------------\n\n/** The type of a circle struct. */\ntypedef struct satc_circle satc_circle_t;\n/** The type of a polygon struct. */\ntypedef struct satc_polygon satc_polygon_t;\n/** The type of a box struct. */\ntypedef struct satc_box satc_box_t;\n/** The type of a response struct. */\ntypedef struct satc_response satc_response_t;\n\n/** A circle shape, with a position and radius. */\nstruct satc_circle {\n  /** The shape type of the struct. */\n  int type;\n  /** The position of the circle. */\n  double *pos;\n  /** The radius of the circle. */\n  double r;\n};\n\n/** A polygon shape, with a position, angle, offset, and points. */\nstruct satc_polygon {\n  /** The shape type of the struct. */\n  int type;\n  /** The position of the polygon. */\n  double *pos;\n  /** The number of points in the polygon. */\n  size_t num_points;\n  /**\n   * The list of points in the polygon, as an array of arrays of doubles.\n   *\n   * Use `satc_polygon_copy_points` to change this. Or, if you need to do it\n   * manually, call `_satc_polygon_recalc` afterward.\n   */\n  double **points;\n  /**\n   * The angle of rotation of the polygon.\n   *\n   * Use `satc_polygon_set_angle` to change this. Or, if you need to do it\n   * manually, call `_satc_polygon_recalc` afterward.\n   */\n  double angle;\n  /**\n   * The offset as an array of doubles (a point) of the polygon.\n   *\n   * Use `satc_polygon_set_offset` to change this. Or, if you need to do it\n   * manually, call `_satc_polygon_recalc` afterward.\n   */\n  double *offset;\n  /**\n   * The number of calculated points for the polygon. This will match the\n   * number of points.\n   *\n   * This should not be modified manually.\n   */\n  size_t num_calc_points;\n  /**\n   * An array of arrays of doubles (array of points) representing the\n   * calculated points of the polygon. This will match the number of points.\n   *\n   * This should not be modified manually.\n   */\n  double **calc_points;\n  /**\n   * The number of calculated edges for the polygon. This will match the\n   * number of points.\n   *\n   * This should not be modified manually.\n   */\n  size_t num_edges;\n  /**\n   * An array of arrays of doubles (array of points) representing the\n   * calculated edges of the polygon. This will match the number of points.\n   *\n   * This should not be modified manually.\n   */\n  double **edges;\n  /**\n   * The number of calculated normals for the polygon. This will match the\n   * number of points.\n   *\n   * This should not be modified manually.\n   */\n  size_t num_normals;\n  /**\n   * An array of arrays of doubles (array of points) representing the\n   * calculated normals of the polygon. This will match the number of points.\n   *\n   * This should not be modified manually.\n   */\n  double **normals;\n};\n\n/** A box shape, with a position, width, and height. */\nstruct satc_box {\n  /** The shape type of the struct. */\n  int type;\n  /** The position of the box. */\n  double *pos;\n  /** The width of the box. */\n  double w;\n  /** The height of the box. */\n  double h;\n};\n\n/** A response, representing an overlap between two shapes. */\nstruct satc_response {\n  /** The first shape participating in the collision. */\n  void *a;\n  /** The second shape participating in the collision. */\n  void *b;\n  /** The length of overlap of the collision. */\n  double overlap;\n  /** The unit vector of the overlap of the collision. */\n  double *overlap_n;\n  /**\n   * The unit vector of the overlap of the collision, scaled by the length of\n   * overlap.\n   */\n  double *overlap_v;\n  /** True if shape `a` is entirely within shape `b`. */\n  bool a_in_b;\n  /** True if shape `b` is entirely within shape `a`. */\n  bool b_in_a;\n};\n\n// ------\n// Macros\n// ------\n\n/** Denotes an undefined type in a struct with a `type` field. */\n#define satc_type_none 0\n/** Denotes a circle type in a struct with a `type` field. */\n#define satc_type_circle 1\n/** Denotes a polygon type in a struct with a `type` field. */\n#define satc_type_polygon 2\n/** Denotes a box type in a struct with a `type` field. */\n#define satc_type_box 3\n\n/** Given a struct, returns an int representing the type.. */\n#define satc_shape_get_type(s) s->type;\n\n/**\n * Creates an array of doubles, with undefined values. Since it uses `alloca`,\n * the array will automatically be deallocated when it falls out of scope.\n *\n * This macro is considered a statement.\n *\n * @param name the variable name for the array.\n * @param size the number of doubles in the array.\n */\n#define satc_double_array_alloca(name, size) \\\n  double *name = NULL; \\\n  name = (double *) alloca(sizeof(double) * size);\n\n/**\n * Creates an array of pointers to `double *` (a point), with undefined,\n * not-yet-allocated pointer values.\n *\n * Since it uses `alloca`, the array will automatically be deallocated when it\n * falls out of scope.\n *\n * The members will not be automatically deallocated when the array falls out\n * of scope, unless the members were allocated with `alloca` too!\n *\n * This macro is considered a statement.\n *\n * @param name the variable name for the array.\n * @param size the number of pointers to points in the array.\n */\n#define satc_point_array_alloca(name, size) \\\n  double **name = NULL; \\\n  name = (double **) alloca(sizeof(double *) * size);\n\n/**\n * Creates a pointer to an array of doubles (a point), with undefined `x` and\n * `y` values.\n *\n * Since it uses `alloca`, the point will automatically be deallocated when it\n * falls out of scope.\n *\n * This macro is considered a statement.\n *\n * @param name the variable name for the point.\n */\n#define satc_point_alloca(name) \\\n  double *name = NULL; \\\n  name = (double *) alloca(sizeof(double) * 2);\n\n/**\n * Creates a pointer to an array of doubles (a point), with defined `x` and `y`\n * values.\n *\n * Since it uses `alloca`, the point will automatically be deallocated when it\n * falls out of scope.\n *\n * This macro is considered a statement.\n *\n * @param name the variable name for the array.\n * @param x the x value, as a double, for the point.\n * @param y the y value, as a double, for the point.\n */\n#define satc_point_alloca_xy(name, x, y) \\\n  satc_point_alloca(name); \\\n  satc_point_set_xy(name, x, y);\n\n/** Denotes a left voronoi region, for polygon collision detection. */\n#define SATC_LEFT_VORONOI_REGION -1\n/** Denotes a middle voronoi region, for polygon collision detection. */\n#define SATC_MIDDLE_VORONOI_REGION 0\n/** Denotes a right voronoi region, for polygon collision detection. */\n#define SATC_RIGHT_VORONOI_REGION 1\n\n/** The index of the double array which contains the `x` value.. */\n#define SATC_POINT_X 0\n/** The index of the double array which contains the `y` value.. */\n#define SATC_POINT_Y 1\n\n/**\n * Get the `x` value from an array of doubles (a point).\n *\n * @param p the array of doubles (point) to fetch from.\n * @return the `x` value as a double.\n */\n#define satc_point_get_x(p) p[SATC_POINT_X]\n/**\n * Set the `x` value in an array of doubles (a point).\n *\n * This macro is considered a statement.\n *\n * @param p the array of doubles (point) whose value should change.\n * @param v the `x` value to change.\n */\n#define satc_point_set_x(p, v) p[SATC_POINT_X] = v;\n/**\n * Get the `y` value from an array of doubles (a point).\n *\n * @param p the array of doubles (point) to fetch from.\n * @return the `y` value as a double.\n */\n#define satc_point_get_y(p) p[SATC_POINT_Y]\n/**\n * Set the `y` value in an array of doubles (a point).\n *\n * This macro is considered a statement.\n *\n * @param p the array of doubles (point) whose value should change.\n * @param v the `y` value to change.\n */\n#define satc_point_set_y(p, v) p[SATC_POINT_Y] = v;\n/**\n * Set both the `x` and `y` values in an array of doubles (a point).\n *\n * This macro is considered a statement.\n *\n * @param p the array of doubles (point) whose value should change.\n * @param x the `x` value to change.\n * @param y the `y` value to change.\n */\n#define satc_point_set_xy(p, x, y) \\\n  p[SATC_POINT_X] = x; \\\n  p[SATC_POINT_Y] = y;\n/**\n * Given a point, allocate a separate array of doubles (a point) with\n * equivalent values.\n *\n * This macro is considered a statement.\n *\n * You are responsible for deallocating the point.\n *\n * @param p the point to clone.\n */\n#define satc_point_clone(p) satc_point_create(satc_point_get_x(p), satc_point_get_y(p))\n\n// --------------------------------------------------------------------\n// Forward declarations of certain functions called by other functions.\n// --------------------------------------------------------------------\n\n/** Forward declaration of `satc_polygon_set_points`. */\nsatc_polygon_t *satc_polygon_set_points (satc_polygon_t *polygon, size_t num_points, double **points);\n/** Forward declaration of `_satc_polygon_recalc`. */\nsatc_polygon_t *_satc_polygon_recalc (satc_polygon_t *polygon);\n/** Forward declaration of `satc_box_create`. */\nsatc_box_t *satc_box_create (double *pos, double w, double h);\n/** Forward declaration of `satc_box_destroy`. */\nvoid satc_box_destroy (satc_box_t *box);\n/** Forward declaration of `satc_box_to_polygon`. */\nsatc_polygon_t *satc_box_to_polygon (satc_box_t *box);\n/** Forward declaration of `satc_test_polygon_polygon`. */\nbool satc_test_polygon_polygon (satc_polygon_t *a, satc_polygon_t *b, satc_response_t *response);\n\n// ---------\n// Functions\n// ---------\n\n/**\n * Copy the values of some array of doubles (a point) `q`, onto some point `p`.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @param q the point whose values to use\n * @return the mutated point.\n */\ndouble *satc_point_copy (double *p, double *q) {\n  satc_point_set_xy(p, satc_point_get_x(q), satc_point_get_y(q));\n  return p;\n}\n\n/**\n * Modify the values of some array of doubles (a point) `p` so they match a\n * point perpendicular to the original point.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @return the mutated point.\n */\ndouble *satc_point_perp (double *p) {\n  double x = satc_point_get_y(p);\n  double y = -satc_point_get_x(p);\n  satc_point_set_xy(p, x, y);\n  return p;\n}\n\n/**\n * Modify the values of some array of doubles (a point) `p` so they match an\n * inverse point to the original point.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @return the mutated point.\n */\ndouble *satc_point_reverse (double *p) {\n  satc_point_set_xy(p, -satc_point_get_x(p), -satc_point_get_y(p));\n  return p;\n}\n\n/**\n * Find the dot product of two arrays of doubles (points).\n *\n * @param p the first point.\n * @param q the second point.\n * @return the dot product, as a double.\n */\n#define satc_point_dot(p, q) satc_point_get_x(p) * satc_point_get_x(q) + satc_point_get_y(p) * satc_point_get_y(q)\n/**\n * Find the length, squared, of an array of doubles (a point).\n *\n * @param p the point to query.\n * @return the length squared, as a double.\n */\n#define satc_point_len2(p) satc_point_dot(p, p)\n/**\n * Find the length, of an array of doubles (a point). This is slightly more\n * intensive than finding the length squared.\n *\n * @param p the point to query.\n * @return the length, as a double.\n */\n#define satc_point_len(p) sqrt(satc_point_len2(p))\n\n/**\n * Find the sum of two arrays of doubles (points), and replace the values of the\n * first point to match the sum.\n *\n * `p` will be mutated.\n *\n * @param p the first point.\n * @param q the second point.\n * @return the mutated point.\n */\ndouble *satc_point_add (double *p, double *q) {\n  satc_point_set_xy(p, satc_point_get_x(p) + satc_point_get_x(q), satc_point_get_y(p) + satc_point_get_y(q));\n  return p;\n}\n\n/**\n * Find the difference of two arrays of doubles (points), and replace the\n * values of the first point to match the difference.\n *\n * `p` will be mutated.\n *\n * @param p the first point.\n * @param q the second point.\n * @return the mutated point.\n */\ndouble *satc_point_sub (double *p, double *q) {\n  satc_point_set_xy(p, satc_point_get_x(p) - satc_point_get_x(q), satc_point_get_y(p) - satc_point_get_y(q));\n  return p;\n}\n\n/**\n * Scale some array of doubles (a point) by some value, `x`, and some value,\n * `y`, and replace the values of the point to match the scaled result.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @param x the `x` value to scale by.\n * @param y the `y` value to scale by.\n * @return the mutated point.\n */\ndouble *satc_point_scale_xy (double *p, double x, double y) {\n  satc_point_set_xy(p, satc_point_get_x(p) * x, satc_point_get_y(p) * y);\n  return p;\n}\n\n/**\n * Scale some array of doubles (a point) by some value, `x`, along both axes.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @param x the `x` value to scale by, horizontally, and vertically.\n * @return the mutated point.\n */\ndouble *satc_point_scale_x (double *p, double x) {\n  return satc_point_scale_xy(p, x, x);\n}\n\n/**\n * Allocates a new array of doubles (a point). The values will be undefined.\n *\n * You are responsible for deallocating the point.\n *\n * @return the newly-created point.\n */\ndouble *satc_point_create (double x, double y) {\n  double *point = NULL;\n  point = (double *) malloc(sizeof(double) * 2);\n  satc_point_set_xy(point, x, y);\n  return point;\n}\n\n/**\n * Deallocates an array of doubles (a point).\n *\n * @param point the point to deallocate.\n */\nvoid satc_point_destroy (double *point) {\n  free(point);\n}\n\n/**\n * Rotates a point by some angle.\n *\n * `p` will be mutated.\n *\n * @param p the point to rotate.\n * @param angle the angle to rotate by.\n */\ndouble *satc_point_rotate (double *p, double angle) {\n  double x = satc_point_get_x(p);\n  double y = satc_point_get_y(p);\n  satc_point_set_xy(p, x * cos(angle) - y * sin(angle), x * sin(angle) - y * cos(angle));\n  return p;\n}\n\n/**\n * Normalize some array of doubles (a point) into a unit vector.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @return the normalized point.\n */\ndouble *satc_point_normalize (double *p) {\n  double d = satc_point_len(p);\n  if (d > 0) satc_point_set_xy(p, satc_point_get_x(p) / d, satc_point_get_y(p) / d);\n  return p;\n}\n\n/**\n * Project some array of doubles (a point) `q` onto `p`.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @param q the point used to project.\n * @return the projected point point.\n */\ndouble *satc_point_project (double *p, double *q) {\n  double amt = satc_point_dot(p, q) / satc_point_len2(q);\n  satc_point_set_xy(p, amt * satc_point_get_x(p), amt * satc_point_get_y(p));\n  return p;\n}\n\n/**\n * Project some array of doubles (a point) `q` onto `p`, but the result is not\n * divided by the length of `q` squared.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @param q the point used to project.\n * @return the projected point point.\n */\ndouble *satc_point_project_n (double *p, double *q) {\n  double amt = satc_point_dot(p, q);\n  satc_point_set_xy(p, amt * satc_point_get_x(p), amt * satc_point_get_y(p));\n  return p;\n}\n\n/**\n * Reflect some array of doubles (a point) along some axis.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @param axis the angle to reflect on.\n * @return the normalized point.\n */\ndouble *satc_point_reflect (double *p, double *axis) {\n  double x = satc_point_get_x(p);\n  double y = satc_point_get_y(p);\n  satc_point_project(p, axis);\n  satc_point_scale_x(p, 2.0);\n  satc_point_set_xy(p, satc_point_get_x(p) - x, satc_point_get_y(p) - y);\n  return p;\n}\n\n/**\n * Reflect some array of doubles (a point) along some axis. When projecting, the\n * value is not divided by the length of `p` squared.\n *\n * `p` will be mutated.\n *\n * @param p the point to mutate.\n * @param axis the angle to reflect on.\n * @return the normalized point.\n */\ndouble *satc_point_reflect_n (double *p, double *axis) {\n  double x = satc_point_get_x(p);\n  double y = satc_point_get_y(p);\n  satc_point_project_n(p, axis);\n  satc_point_scale_x(p, 2.0);\n  satc_point_set_xy(p, satc_point_get_x(p) - x, satc_point_get_y(p) - y);\n  return p;\n}\n\n/**\n * Create a struct representing a circle, with a given position and radius.\n *\n * You are responsible for deallocating the circle.\n *\n * @param pos the position of the circle.\n * @param r the radius of the circle.\n * @return a circle struct.\n */\nsatc_circle_t *satc_circle_create (double *pos, double r) {\n  satc_circle_t *circle = NULL;\n  circle = (satc_circle_t *) malloc(sizeof(satc_circle_t));\n  circle->type = satc_type_circle;\n  circle->pos = satc_point_clone(pos);\n  circle->r = r;\n  return circle;\n}\n\n/**\n * Deallocates a struct representing a circle.\n *\n * @param circle the circle to deallocate.\n */\nvoid satc_circle_destroy (satc_circle_t *circle) {\n  satc_point_destroy(circle->pos);\n  circle->type = satc_type_none;\n  circle->pos = NULL;\n  circle->r = -1.0;\n  free(circle);\n}\n\n/**\n * Returns a struct representing a rectangular polygon which is equivalent to\n * the bounding box of a circle.\n *\n * You are responsible for deallocating the polygon.\n *\n * @param circle the circle whose bounding box is of interest.\n * @return a polygon struct.\n */\nsatc_polygon_t *satc_circle_get_aabb (satc_circle_t *circle) {\n  double r = circle->r;\n  satc_point_alloca(corner);\n  satc_point_copy(corner, circle->pos);\n  satc_point_set_xy(corner, satc_point_get_x(corner) - r, satc_point_get_y(corner) - r);\n  satc_box_t *box = satc_box_create(corner, r * 2.0, r * 2.0);\n  satc_polygon_t *polygon = satc_box_to_polygon(box);\n  satc_box_destroy(box);\n  return polygon;\n}\n\n/**\n * Create a struct representing a polygon, with a given position and points.\n *\n * The points passed in are copied, and so you must handle the deallocation of\n * the passed-in points.\n *\n * You are responsible for deallocating the polygon.\n *\n * @param pos the position of the polygon.\n * @param num_points the number of points provided.\n * @param points an array of arrays of doubles (array of points).\n * @return a polygon struct.\n */\nsatc_polygon_t *satc_polygon_create (double *pos, size_t num_points, double **points) {\n  satc_polygon_t *polygon = NULL;\n  polygon = (satc_polygon_t *) malloc(sizeof(satc_polygon_t));\n  polygon->type = satc_type_polygon;\n  polygon->pos = satc_point_clone(pos);\n  polygon->angle = 0.0;\n  polygon->offset = satc_point_create(0.0, 0.0);\n\n  polygon->num_points = 0;\n  polygon->points = NULL;\n  polygon->num_calc_points = 0;\n  polygon->calc_points = NULL;\n  polygon->num_edges = 0;\n  polygon->edges = NULL;\n  polygon->num_normals = 0;\n  polygon->normals = NULL;\n\n  satc_polygon_set_points(polygon, num_points, points);\n\n  return polygon;\n}\n\n/**\n * Deallocates a struct representing a polygon.\n *\n * @param polygon the polygon to deallocate.\n */\nvoid satc_polygon_destroy (satc_polygon_t *polygon) {\n  satc_point_destroy(polygon->pos);\n  satc_point_destroy(polygon->offset);\n\n  size_t i = 0;\n  for (; i < polygon->num_points; i++) {\n    satc_point_destroy(polygon->points[i]);\n  }\n\n  free(polygon->points);\n\n  polygon->type = satc_type_none;\n  polygon->pos = NULL;\n  polygon->num_points = -1;\n  polygon->points = NULL;\n  polygon->angle = 0.0;\n  polygon->offset = NULL;\n  free(polygon);\n}\n\n/**\n * Replace a polygon struct's list of points.\n *\n * The old points will be deallocated. The new points will be deallocated when\n * the polygon is deallocated.\n *\n * The calculated values of the polygon will be recalculated.\n *\n * The points passed in are copied, and so you must handle the deallocation of\n * the passed-in points.\n *\n * For internal use.\n *\n * @param polygon the polygon whose points to replace.\n * @param num_points the number of new points.\n * @param points an array of arrays of doubles (array of points).\n */\nvoid _satc_polygon_copy_points (satc_polygon_t *polygon, size_t num_points, double **points) {\n  if (polygon->points != NULL) {\n    size_t i = 0;\n    for (; i < polygon->num_points; i++) satc_point_destroy(polygon->points[i]);\n    free(polygon->points);\n    polygon->num_points = 0;\n    polygon->points = NULL;\n  }\n\n  double **new_points = NULL;\n  new_points = (double **) malloc(sizeof(double *) * num_points);\n  size_t i = 0;\n  for (; i < num_points; i++) new_points[i] = satc_point_clone(points[i]);\n  polygon->num_points = num_points;\n  polygon->points = new_points;\n  _satc_polygon_recalc(polygon);\n}\n\n/**\n * Clear out the calculated points of a polygon and replace them with some\n * number of preallocated empty points.\n *\n * The old calculated points will be deallocated. The new points will be\n * deallocated when the polygon is deallocated.\n *\n * For internal use.\n *\n * @param polygon the polygon whose calculated points should be replaced.\n * @param num_calc_points the number of pristine points to add.\n */\nvoid _satc_polygon_reset_calc_points (satc_polygon_t *polygon, size_t num_calc_points) {\n  if (polygon->calc_points != NULL) {\n    size_t i = 0;\n    for (; i < polygon->num_calc_points; i++) satc_point_destroy(polygon->calc_points[i]);\n    free(polygon->calc_points);\n    polygon->num_calc_points = 0;\n    polygon->calc_points = NULL;\n  }\n\n  double **new_calc_points = NULL;\n  new_calc_points = (double **) malloc(sizeof(double *) * num_calc_points);\n\n  size_t i = 0;\n  for (; i < num_calc_points; i++) {\n    new_calc_points[i] = satc_point_create(0.0, 0.0);\n  }\n\n  polygon->num_calc_points = num_calc_points;\n  polygon->calc_points = new_calc_points;\n}\n\n/**\n * Replace the calculated edges of a polygon with some number of pristine\n * points representing edges.\n *\n * The old calculated edges will be deallocated. The new edges will be\n * deallocated when the polygon is deallocated.\n *\n * For internal use.\n *\n * @param polygon the polygon whose edges should be replaced.\n * @param num_edges the number of pristine points to add.\n */\nvoid _satc_polygon_reset_edges (satc_polygon_t *polygon, size_t num_edges) {\n  if (polygon->edges != NULL) {\n    size_t i = 0;\n    for (; i < polygon->num_edges; i++) satc_point_destroy(polygon->edges[i]);\n    free(polygon->edges);\n    polygon->num_edges = 0;\n    polygon->edges = NULL;\n  }\n\n  double **new_edges = NULL;\n  new_edges = (double **) malloc(sizeof(double *) * num_edges);\n\n  size_t i = 0;\n  for (; i < num_edges; i++) {\n    new_edges[i] = satc_point_create(0.0, 0.0);\n  }\n\n  polygon->num_edges = num_edges;\n  polygon->edges = new_edges;\n}\n\n/**\n * Replace the calculated normals of a polygon.\n *\n * The old calculated normals will be deallocated. The new calculated normals\n * will be deallocated when the polygon is deallocated.\n *\n * For internal use.\n *\n * @param polygon the polygon whose calculated normals should be replaced.\n * @param num_normals the number of pristine normals to add.\n */\nvoid _satc_polygon_reset_normals (satc_polygon_t *polygon, size_t num_normals) {\n  if (polygon->normals != NULL) {\n    size_t i = 0;\n    for (; i < polygon->num_normals; i++) satc_point_destroy(polygon->normals[i]);\n    free(polygon->normals);\n    polygon->num_normals = 0;\n    polygon->normals = NULL;\n  }\n\n  double **new_normals = NULL;\n  new_normals = (double **) malloc(sizeof(double *) * num_normals);\n\n  size_t i = 0;\n  for (; i < num_normals; i++) {\n    new_normals[i] = satc_point_create(0.0, 0.0);\n  }\n\n  polygon->num_normals = num_normals;\n  polygon->normals = new_normals;\n}\n\n/**\n * Given a polygon and number of points, it will clear out all of the\n * calculated values, replace the points already on the polygon, and\n * recalculate all the calculated values.\n *\n * All deallocation and allocation is handled for you.\n *\n * The points passed in are copied, and so you must handle the deallocation of\n * the passed-in points.\n *\n * @param polygon the polygon whose points should be replaced.\n * @param num_points the number of new points.\n * @param points an array of arrays of doubles (array of points).\n * @return the polygon passed in.\n */\nsatc_polygon_t *satc_polygon_set_points (satc_polygon_t *polygon, size_t num_points, double **points) {\n  bool length_changed = num_points != polygon->num_points;\n  if (length_changed) {\n    _satc_polygon_reset_calc_points(polygon, num_points);\n    _satc_polygon_reset_edges(polygon, num_points);\n    _satc_polygon_reset_normals(polygon, num_points);\n  }\n\n  _satc_polygon_copy_points(polygon, num_points, points);\n  return polygon;\n}\n\n/**\n * Set the angle of rotation of the polygon. All calculated values will be\n * recalculated.\n *\n * @param polygon the polygon to rotate.\n * @param angle the angle to rotate by.\n * @return the passed-in polygon.\n */\nsatc_polygon_t *satc_polygon_set_angle (satc_polygon_t *polygon, double angle) {\n  polygon->angle = angle;\n  _satc_polygon_recalc(polygon);\n  return polygon;\n}\n\n/**\n * Set the offset of the polygon. All calculated values will be recalculated.\n *\n * @param polygon the polygon to offset.\n * @param offset the array of doubles (a point) to offset by.\n * @return the passed-in polygon.\n */\nsatc_polygon_t *satc_polygon_set_offset (satc_polygon_t *polygon, double *offset) {\n  satc_point_copy(polygon->offset, offset);\n  _satc_polygon_recalc(polygon);\n  return polygon;\n}\n\n/**\n * In lieu of setting the angle of the polygon, you can actually rotate all of\n * the points. All calculated values will be recalculated.\n *\n * @param polygon the polygon to offset.\n * @param angle the array of doubles (a point) to offset by.\n * @return the passed-in polygon.\n */\nsatc_polygon_t *satc_polygon_rotate (satc_polygon_t *polygon, double angle) {\n  size_t i = 0;\n  for (; i < polygon->num_points; i++) satc_point_rotate(polygon->points[i], angle);\n  _satc_polygon_recalc(polygon);\n  return polygon;\n}\n\n/**\n * In lieu of setting the offset of the polygon, you can actually translate all\n * of the points by some `x` and `y`. All calculated values will be\n * recalculated.\n *\n * @param polygon the polygon to offset.\n * @param x the horizontal amount to translate by.\n * @param y the vertical amount to translate by.\n * @return the passed-in polygon.\n */\nsatc_polygon_t *satc_polygon_translate (satc_polygon_t *polygon, double x, double y) {\n  size_t i = 0;\n  for (; i < polygon->num_points; i++) satc_point_set_xy(polygon->points[i], x, y);\n  _satc_polygon_recalc(polygon);\n  return polygon;\n}\n\n/**\n * Recalculates all the calculated values for a struct representing a polygon\n * shape.\n *\n * For internal use.\n *\n * @param polygon a polygon whose values should be recalculated.\n * @return the passed-in polygon.\n */\nsatc_polygon_t *_satc_polygon_recalc (satc_polygon_t *polygon) {\n  double **calc_points = polygon->calc_points;\n  double **edges = polygon->edges;\n  double **normals = polygon->normals;\n  double **points = polygon->points;\n  double *offset = polygon->offset;\n  double angle = polygon->angle;\n  size_t num_points = polygon->num_points;\n  size_t i = 0;\n  for (; i < num_points; i++) {\n    double *calc_point = satc_point_copy(calc_points[i], points[i]);\n    satc_point_add(calc_point, offset);\n    if (angle != 0.0) satc_point_rotate(calc_point, angle);\n  }\n\n  i = 0;\n  for (; i < num_points; i++) {\n    double *p1 = calc_points[i];\n    double *p2 = (i < num_points - 1) ? calc_points[i + 1] : calc_points[0];\n    double *edge = edges[i];\n    satc_point_copy(edge, p2);\n    satc_point_sub(edge, p1);\n    double *normal = normals[i];\n    satc_point_copy(normal, edge);\n    satc_point_perp(normal);\n    satc_point_normalize(normal);\n  }\n\n  return polygon;\n}\n\n/**\n * Returns a polygon struct representing the bounding box of a polygon.\n *\n * You are responsible for deallocating the returned polygon.\n *\n * @param polygon the polygon whose bounding box should be calculated.\n * @return a polygon representing the bounding box.\n */\nsatc_polygon_t *satc_polygon_get_aabb (satc_polygon_t *polygon) {\n  double x_min = satc_point_get_x(polygon->points[0]);\n  double y_min = satc_point_get_y(polygon->points[0]);\n  double x_max = x_min;\n  double y_max = x_max;\n  size_t i = 1;\n  for (; i < polygon->num_points; i++) {\n    double x = satc_point_get_x(polygon->points[i]);\n    double y = satc_point_get_y(polygon->points[i]);\n    if (x < x_min) x_min = x;\n    if (x > x_max) x_max = x;\n    if (y < y_min) y_min = y;\n    if (y > y_max) y_max = y;\n  }\n\n  satc_point_alloca(pos);\n  satc_point_set_xy(pos, satc_point_get_x(pos) + x_min, satc_point_get_y(pos) + y_min);\n  satc_box_t *box = satc_box_create(pos, x_max - x_min, y_max - y_min);\n  satc_polygon_t *new_polygon = satc_box_to_polygon(box);\n  satc_box_destroy(box);\n  return new_polygon;\n}\n\n/**\n * Get the \"centroid\" (the estimated center) of a polygon as an array of\n * doubles (a point).\n *\n * You are responsible for deallocating the point.\n *\n * @param polygon the polygon whose centroid should be calculated.\n * @return an array of doubles (a point) representing the centroid.\n */\ndouble *satc_polygon_get_centroid (satc_polygon_t *polygon) {\n  double **points = polygon->calc_points;\n  size_t len = polygon->num_calc_points;\n  double cx = 0.0;\n  double cy = 0.0;\n  double ar = 0.0;\n  size_t i = 0;\n  for (; i < len; i++) {\n    double *p1 = points[i];\n    double *p2 = (i == len - 1) ? points[0] : points[i + 1];\n    double a = satc_point_get_x(p1) * satc_point_get_y(p2) - satc_point_get_x(p2) * satc_point_get_y(p1);\n    cx += (satc_point_get_x(p1) + satc_point_get_x(p2)) * a;\n    cy += (satc_point_get_y(p1) + satc_point_get_y(p2)) * a;\n    ar += a;\n  }\n\n  ar = ar * 3.0;\n  cx = cx / ar;\n  cy = cy / ar;\n\n  return satc_point_create(cx, cy);\n}\n\n/**\n * Creates a struct representing a box shape.\n *\n * @param pos the position of the box, from the top left.\n * @param w the width of the box.\n * @param h the height of the box.\n * @return a box struct.\n */\nsatc_box_t *satc_box_create (double *pos, double w, double h) {\n  satc_box_t *box = NULL;\n  box = (satc_box_t *) malloc(sizeof(satc_box_t));\n  box->type = satc_type_box;\n  box->pos = satc_point_clone(pos);\n  box->w = w;\n  box->h = h;\n  return box;\n}\n\n/**\n * Deallocates a struct representing a box shape.\n *\n * @param box the box to deallocate.\n */\nvoid satc_box_destroy (satc_box_t *box) {\n  satc_point_destroy(box->pos);\n  box->type = satc_type_none;\n  box->pos = NULL;\n  box->w = -1.0;\n  box->h = -1.0;\n  free(box);\n}\n\n/**\n * Returns a polygon representing the box.\n *\n * You are responsible for deallocating the polygon.\n *\n * @param box the box to generate a polygon of.\n * @return a polygon representing the box.\n */\nsatc_polygon_t *satc_box_to_polygon (satc_box_t *box) {\n  double *pos = box->pos;\n  double w = box->w;\n  double h = box->h;\n  double **points = NULL;\n  points = (double **) alloca(sizeof(double *) * 4);\n  satc_point_alloca(nw);\n  satc_point_alloca(ne);\n  satc_point_alloca(se);\n  satc_point_alloca(sw);\n  satc_point_set_xy(nw, 0.0, 0.0);\n  satc_point_set_xy(ne, w, 0.0);\n  satc_point_set_xy(se, w, h);\n  satc_point_set_xy(sw, 0.0, h);\n  points[0] = nw;\n  points[1] = ne;\n  points[2] = se;\n  points[3] = sw;\n  return satc_polygon_create(pos, 4, points);\n}\n\n/**\n * Creates a struct representing a collision response.\n *\n * Instead of setting the values manually, you should use a `satc_test_*`\n * function, which will set the values for you.\n *\n * @return a struct representing a collision response.\n */\nsatc_response_t *satc_response_create () {\n  satc_response_t *response = NULL;\n  response = (satc_response_t *) malloc(sizeof(satc_response_t));\n  response->a = NULL;\n  response->b = NULL;\n  response->overlap_n = satc_point_create(0.0, 0.0);\n  response->overlap_v = satc_point_create(0.0, 0.0);\n  response->overlap = DBL_MAX;\n  response->a_in_b = true;\n  response->b_in_a = true;\n  return response;\n}\n\n/**\n * Deallocates a struct representing a collision response.\n *\n * `response->a` and `response->b` are not deallocated for you!\n *\n * @param response the response to deallocate.\n */\nvoid satc_response_destroy (satc_response_t *response) {\n  satc_point_destroy(response->overlap_n);\n  satc_point_destroy(response->overlap_v);\n\n  response->a = NULL;\n  response->b = NULL;\n  response->overlap_n = NULL;\n  response->overlap_v = NULL;\n  response->overlap = DBL_MAX;\n  response->a_in_b = true;\n  response->b_in_a = true;\n  free(response);\n}\n\n/**\n * Project the array of arrays of doubles (array of points) onto an axis.\n *\n * @param len the number of points.\n * @param points the array of arrays of doubles (points) to project.\n * @param normal the array of doubles (a point) of the normal.\n * @param result the arary of doubles (a point) representing the result.\n */\nvoid satc_flatten_points_on (size_t len, double **points, double *normal, double *result) {\n  double min = DBL_MAX;\n  double max = -DBL_MAX;\n\n  size_t i = 0;\n  for (; i < len; i++) {\n    double dot = satc_point_dot(points[i], normal);\n    if (dot < min) min = dot;\n    if (dot > max) max = dot;\n  }\n\n  result[0] = min;\n  result[1] = max;\n}\n\n/**\n * Figure out if two arrays of arrays of doubles (two arrays of points)\n * represent a separating axis.\n *\n * Primarily meant for internal use.\n *\n * @param a_pos an array of doubles (a point).\n * @param b_pos an array of doubles (a point).\n * @param a_len the number of points in `a_points`.\n * @param a_points an array of arrays of doubles (an array of points).\n * @param b_len the number of points in `b_points`.\n * @param b_points an array of arrays of doubles (an array of points).\n * @param axis the axis as an array of doubles (a point).\n * @param response the collision response to mutate.\n * @return whether this represents a separating axis, as a boolean.\n */\nbool satc_is_separating_axis (double *a_pos, double *b_pos, size_t a_len, double **a_points, size_t b_len, double **b_points, double *axis, satc_response_t *response) {\n  // Allocate temporary variables.\n  satc_double_array_alloca(range_a, 2);\n  satc_double_array_alloca(range_b, 2);\n  satc_point_alloca(offset_v);\n\n  // The magnitude of the offset between the two polygons.\n  satc_point_copy(offset_v, b_pos);\n  satc_point_sub(offset_v, a_pos);\n  double projected_offset = satc_point_dot(offset_v, axis);\n  // Project the polygons onto the axis.\n  satc_flatten_points_on(a_len, a_points, axis, range_a);\n  satc_flatten_points_on(b_len, b_points, axis, range_b);\n  // Move B's range to its position relative to A.\n  range_b[0] += projected_offset;\n  range_b[1] += projected_offset;\n  // Check if there is a gap. If there is, this is a separating axis and we can stop.\n  if (range_a[0] > range_b[1] || range_b[0] > range_a[1]) {\n    return true;\n  }\n\n  // This is not a separating axis. If we're calculating a response, calculate the overlap.\n  if (response != NULL) {\n    double overlap = 0;\n    // A starts further left than B.\n    if (range_a[0] < range_b[0]) {\n      response->a_in_b = false;\n      // A ends before B does. We have to pull A out of B.\n      if (range_a[1] < range_b[1]) {\n        overlap = range_a[1] - range_b[1];\n        response->b_in_a = false;\n      // B is fully inside A. Pick the shortest way out.\n      } else {\n        double option_1 = range_a[1] - range_b[0];\n        double option_2 = range_b[1] - range_a[0];\n        overlap = option_1 < option_2 ? option_1 : -option_2;\n      }\n    // B starts further left than A.\n    } else {\n      response->b_in_a = false;\n      // B ends before A ends. We have to push A out of B.\n      if (range_a[1] > range_b[1]) {\n        overlap = range_a[0] - range_b[1];\n        response->a_in_b = false;\n      // A is fully inside B.  Pick the shortest way out.\n      } else {\n        double option_1 = range_a[1] - range_b[0];\n        double option_2 = range_b[1] - range_a[0];\n        overlap = option_1 < option_2 ? option_1 : -option_2;\n      }\n    }\n\n    // If this is the smallest amount of overlap we've seen so far, set it as the minimum overlap.\n    double abs_overlap = fabs(overlap);\n    if (abs_overlap < response->overlap) {\n      response->overlap = abs_overlap;\n      satc_point_copy(response->overlap_n, axis);\n      if (overlap < 0) {\n        satc_point_reverse(response->overlap_n);\n      }\n    }\n  }\n\n  return false;\n}\n\n/**\n * Figure out if an array of doubles (a point) representing a line, and another\n * point represent either a left, middle, or right voronoi region.\n *\n * @param line an array of doubles (a point) representing a line.\n * @param point an array of doubles (a point).\n * @return an integer (-1, 0, or 1) representing which voronoi region was found.\n */\nint satc_voronoi_region (double *line, double *point) {\n  double len_2 = satc_point_len2(line);\n  double dp = satc_point_dot(point, line);\n  // If the point is beyond the start of the line, it is in the left voronoi region.\n  if (dp < 0) return SATC_LEFT_VORONOI_REGION;\n  // If the point is beyond the end of the line, it is in the right voronoi region.\n  if (dp > len_2) return SATC_RIGHT_VORONOI_REGION;\n  return SATC_MIDDLE_VORONOI_REGION;\n}\n\n/**\n * Returns true if an array of doubles (a point) is inside of a circle.\n *\n * @param p an array of doubles (a point).\n * @param c a circle.\n * @return true if point is inside of circle, false otherwise.\n */\nbool satc_point_in_circle (double *point, satc_circle_t *circle) {\n  satc_point_alloca(difference_v);\n  satc_point_copy(difference_v, point);\n  satc_point_sub(difference_v, circle->pos);\n  double radius_sq = circle->r * circle->r;\n  double distance_sq = satc_point_len2(difference_v);\n  return distance_sq <= radius_sq;\n}\n\n/**\n * Creates a very small polygon representing a point, for collision purposes.\n *\n * For internal use.\n *\n * You are responsible for deallocating the polygon.\n *\n * @return a polygon.\n */\nsatc_polygon_t *_satc_test_point_create () {\n  satc_point_alloca(zero);\n  satc_point_set_xy(zero, 0.0, 0.0);\n  satc_box_t *box = satc_box_create(zero, 0.000001, 0.000001);\n  satc_polygon_t *polygon = satc_box_to_polygon(box);\n  satc_box_destroy(box);\n  return polygon;\n}\n\n/**\n * Returns true if an array of doubles (a point) is inside of a polygon.\n *\n * @param p an array of doubles (a point).\n * @param polygon a polygon.\n * @return true if point is inside of polygon, false otherwise.\n */\nbool satc_point_in_polygon (double *point, satc_polygon_t *polygon) {\n  satc_polygon_t *test_point = _satc_test_point_create();\n  satc_point_copy(test_point->pos, point);\n  satc_response_t *response = satc_response_create();\n\n  bool result = satc_test_polygon_polygon(test_point, polygon, response);\n  if (result) result = response->a_in_b;\n\n  satc_response_destroy(response);\n  satc_polygon_destroy(test_point);\n\n  return result;\n}\n\n/**\n * Returns true if a circle overlaps with another circle.\n *\n * @param a a circle.\n * @param b another circle.\n * @param response a response representing the collision.\n * @return true if the circles overlap, false otherwise.\n */\nbool satc_test_circle_circle (satc_circle_t *a, satc_circle_t *b, satc_response_t *response) {\n  satc_point_alloca(difference_v);\n  satc_point_copy(difference_v, b->pos);\n  satc_point_sub(difference_v, a->pos);\n  double total_radius = a->r + b->r;\n  double total_radius_sq = total_radius * total_radius;\n  double distance_sq = satc_point_len2(difference_v);\n  if (distance_sq > total_radius_sq) return false;\n  if (response != NULL) {\n    double distance = sqrt(distance_sq);\n    response->a = a;\n    response->b = b;\n    response->overlap = total_radius - distance;\n    satc_point_normalize(difference_v);\n    satc_point_copy(response->overlap_n, difference_v);\n    satc_point_scale_x(difference_v, response->overlap);\n    satc_point_copy(response->overlap_v, difference_v);\n    response->a_in_b = (a->r <= b->r) && (distance <= b->r - a->r);\n    response->b_in_a = (b->r <= a->r) && (distance <= a->r - b->r);\n  }\n\n  return true;\n}\n\n/**\n * Checks to see if one polygon and one circle are overlapping.\n *\n * @param polygon a polygon.\n * @param circle a circle.\n * @param response the response object to set with collision data.\n */\nbool satc_test_polygon_circle (satc_polygon_t *polygon, satc_circle_t *circle, satc_response_t *response) {\n  satc_point_alloca(circle_pos);\n  satc_point_copy(circle_pos, circle->pos);\n  satc_point_sub(circle_pos, polygon->pos);\n  double radius = circle->r;\n  double radius2 = radius * radius;\n  double **points = polygon->calc_points;\n  size_t len = polygon->num_calc_points;\n  satc_point_alloca(edge);\n  satc_point_alloca(point);\n\n  size_t i = 0;\n  for (; i < len; i++) {\n    size_t next = (i == len - 1) ? 0 : i + 1;\n    size_t prev = (i == 0) ? len - 1 : i - 1;\n    double overlap = 0.0;\n    double *overlap_n = NULL;\n\n    satc_point_copy(edge, polygon->edges[i]);\n    satc_point_copy(point, circle_pos);\n    satc_point_sub(point, points[i]);\n\n    if (response != NULL && satc_point_len2(point) > radius2) {\n      response->a_in_b = false;\n    }\n\n    int region = satc_voronoi_region(edge, point);\n    if (region == SATC_LEFT_VORONOI_REGION) {\n      satc_point_copy(edge, polygon->edges[prev]);\n      satc_point_alloca(point2);\n      satc_point_copy(point2, circle_pos);\n      satc_point_sub(point2, points[prev]);\n      region = satc_voronoi_region(edge, point2);\n      if (region == SATC_RIGHT_VORONOI_REGION) {\n        double dist = satc_point_len(point);\n        if (dist > radius) {\n          return false;\n        } else if (response != NULL) {\n          response->b_in_a = false;\n          satc_point_normalize(point);\n          overlap_n = point;\n          overlap = radius - dist;\n        }\n      }\n    } else if (region == SATC_RIGHT_VORONOI_REGION) {\n      satc_point_copy(edge, polygon->edges[next]);\n      satc_point_copy(point, circle_pos);\n      satc_point_sub(point, points[next]);\n      region = satc_voronoi_region(edge, point);\n      if (region == SATC_LEFT_VORONOI_REGION) {\n        double dist = satc_point_len(point);\n        if (dist > radius) {\n          return false;\n        } else if (response != NULL) {\n          response->b_in_a = false;\n          satc_point_normalize(point);\n          overlap_n = point;\n          overlap = radius - dist;\n        }\n      }\n    } else {\n      satc_point_alloca(normal);\n      satc_point_perp(edge);\n      satc_point_normalize(edge);\n      satc_point_copy(normal, edge);\n      double dist = satc_point_dot(point, normal);\n      double dist_abs = fabs(dist);\n      if (dist > 0.0 && dist_abs > radius) {\n        return false;\n      } else {\n        overlap_n = normal;\n        overlap = radius - dist;\n        if (dist >= 0.0 || overlap < 2.0 * radius) {\n          response->b_in_a = false;\n        }\n      }\n    }\n\n    if (overlap_n != NULL && response != NULL && fabs(overlap) < fabs(response->overlap)) {\n      response->overlap = overlap;\n      satc_point_copy(response->overlap_n, overlap_n);\n    }\n  }\n\n  if (response != NULL) {\n    response->a = polygon;\n    response->b = circle;\n    satc_point_copy(response->overlap_v, response->overlap_n);\n    satc_point_scale_x(response->overlap_v, response->overlap);\n  }\n\n  return true;\n}\n\n/**\n * Checks to see if one circle and one polygon are overlapping.\n *\n * This is ever so slightly more expensive than `satc_test_polygon_circle`,\n * since the response data needs to be flipped after checking collision.\n *\n * @param circle a circle.\n * @param polygon a polygon.\n * @param response the response object to set with collision data.\n */\nbool satc_test_circle_polygon (satc_circle_t *circle, satc_polygon_t *polygon, satc_response_t *response) {\n  bool result = satc_test_polygon_circle(polygon, circle, response);\n  if (result && response != NULL) {\n    void *a = response->a;\n    bool a_in_b = response->a_in_b;\n    satc_point_reverse(response->overlap_n);\n    satc_point_reverse(response->overlap_v);\n    response->a = response->b;\n    response->b = a;\n    response->a_in_b = response->b_in_a;\n    response->b_in_a = a_in_b;\n  }\n\n  return result;\n}\n\n/**\n * Checks to see if one polygon and another are overlapping.\n *\n * @param a a polygon.\n * @param b another polygon.\n * @param response the response object to set with collision data.\n */\nbool satc_test_polygon_polygon (satc_polygon_t *a, satc_polygon_t *b, satc_response_t *response) {\n  double **a_points = a->points;\n  size_t a_len = a->num_points;\n  double **b_points = b->points;\n  size_t b_len = b->num_points;\n\n  size_t i = 0;\n  for (; i < a_len; i++) {\n    if (satc_is_separating_axis(a->pos, b->pos, a_len, a_points, b_len, b_points, a->normals[i], response)) {\n      return false;\n    }\n  }\n\n  i = 0;\n  for (; i < b_len; i++) {\n    if (satc_is_separating_axis(a->pos, b->pos, a_len, a_points, b_len, b_points, b->normals[i], response)) {\n      return false;\n    }\n  }\n\n  if (response != NULL) {\n    response->a = a;\n    response->b = b;\n    satc_point_copy(response->overlap_v, response->overlap_n);\n    satc_point_scale_x(response->overlap_v, response->overlap);\n  }\n\n  return true;\n}\n\n#endif\n","numLines":1470,"startLine":1,"totalLines":1470}}}
