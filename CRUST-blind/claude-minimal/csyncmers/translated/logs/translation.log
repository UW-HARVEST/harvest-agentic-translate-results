{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_ovq3elx6ci6e6hst6fmkeyk72hlebveoixexv5l67sehxlb6zqvq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01VEBxPKHpagMjCJrT5THdho","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-e4IKlr/project/src/closed_syncmers.rs","content":"// Import necessary modules\nuse std::collections::HashMap;\n// Struct Definitions\n#[derive(Debug, Clone)]\npub struct MinimizerResult {\n    pub minimizer_hash: u128,\n    pub kmer_position: usize,\n    pub smer_position: usize,\n}\n// Function Declarations\npub fn compute_closed_syncmers(sequence_input: &str, len: i32, k: i32, s: i32, results: &mut Vec<MinimizerResult>, num_results: &mut i32) {\n    let _ = HashMap::<u128, usize>::new();\n    *num_results = 0;\n    if len < k {\n        eprintln!(\"Sequence length is less than K\");\n        return;\n    }\n\n    let len_usize = len as usize;\n    let s_usize = s as usize;\n    let k_usize = k as usize;\n\n    let bytes = sequence_input.as_bytes();\n\n    let num_s_mers: usize = len_usize - s_usize + 1;\n    let mut s_mer_hashes: Vec<u128> = vec![0u128; num_s_mers];\n\n    // Precompute all s-mer hashes\n    let mask: u128 = (1u128 << (2 * s_usize)) - 1;\n    let mut hash_fwd: u128 = 0;\n    let mut hash_rev: u128 = 0;\n    let rc_shift: u32 = (2 * (s_usize - 1)) as u32;\n\n    for i in 0..len_usize {\n        let base = base_to_bits(bytes[i] as char);\n        hash_fwd = ((hash_fwd << 2) | base as u128) & mask;\n        let comp_base = complement_base(base);\n        hash_rev = ((hash_rev >> 2) | ((comp_base as u128) << rc_shift)) & mask;\n        if i + 1 >= s_usize {\n            let s_mer_pos = i - s_usize + 1;\n            let canonical_hash = if hash_fwd < hash_rev { hash_fwd } else { hash_rev };\n            s_mer_hashes[s_mer_pos] = canonical_hash;\n        }\n    }\n\n    // Initialize deque\n    let window_size: usize = k_usize - s_usize + 1;\n    let mut deque: Vec<usize> = vec![0usize; num_s_mers];\n    let mut front: usize = 0;\n    let mut back: usize = 0;\n\n    // Use deque to find minimal s-mers in O(N)\n    for i in 0..num_s_mers {\n        while back > front && s_mer_hashes[deque[back - 1]] > s_mer_hashes[i] {\n            back -= 1;\n        }\n        deque[back] = i;\n        back += 1;\n        if i >= window_size && deque[front] <= i - window_size {\n            front += 1;\n        }\n\n        // Check for closed syncmer condition\n        if i + 1 >= window_size {\n            let min_pos = deque[front];\n            let kmer_pos = i - window_size + 1;\n            if min_pos == kmer_pos || min_pos == kmer_pos + k_usize - s_usize {\n                add_minimizer(results, num_results, s_mer_hashes[min_pos], kmer_pos, min_pos);\n            }\n        }\n    }\n}\npub fn base_to_bits(base: char) -> u8 {\n    match base {\n        'A' | 'a' => 0,\n        'C' | 'c' => 1,\n        'G' | 'g' => 2,\n        'T' | 't' => 3,\n        _ => 0, // Treat unknown as 'A'\n    }\n}\npub fn complement_base(base: u8) -> u8 {\n    3 - base // Complement: A<->T, C<->G\n}\npub fn add_minimizer(results: &mut Vec<MinimizerResult>, size: &mut i32, minimizer_hash: u128, kmer_position: usize, smer_position: usize) {\n    let idx = *size as usize;\n    let entry = MinimizerResult {\n        minimizer_hash,\n        kmer_position,\n        smer_position,\n    };\n    if idx < results.len() {\n        results[idx] = entry;\n    } else {\n        results.push(entry);\n    }\n    *size += 1;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1728,"cache_read_input_tokens":18300,"cache_creation":{"ephemeral_5m_input_tokens":1728,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"3b49df35-a265-4f31-91dd-ac2ac7e00d77","uuid":"241022bc-ebb8-488c-a023-5ab4e9b58764"}
