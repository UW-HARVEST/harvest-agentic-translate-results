{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_g55mxl5g6ugpiycxjdam2ehcbnwkcildo7mrhqzccgbcucqikvaa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018tppdvtWHWAPtqgRDGjfFH","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-fFc29r/project/src/compose.rs","content":"use std::collections::{HashMap, VecDeque};\nuse std::hash::{Hash, Hasher};\n// Flags (just examples; adapt to your constants)\nconst OSORT: u32 = 0x1;\nconst ISORT: u32 = 0x2;\n// A trait to represent your semiring\npub trait Semiring: Clone {\n    fn zero() -> Self;\n    fn one() -> Self;\n    fn plus(&self, rhs: &Self) -> Self;\n    fn prod(&self, rhs: &Self) -> Self;\n}\n// Example semiring for Weighted FST with float weights (Tropical semiring-like)\n#[derive(Clone, Debug)]\npub struct FloatSemiring(pub f32);\nimpl Semiring for FloatSemiring {\n    fn zero() -> Self {\n        FloatSemiring(f32::MAX)\n    }\n    fn one() -> Self {\n        FloatSemiring(0.0)\n    }\n    fn plus(&self, rhs: &Self) -> Self {\n        if self.0 < rhs.0 { FloatSemiring(self.0) } else { FloatSemiring(rhs.0) }\n    }\n    fn prod(&self, rhs: &Self) -> Self {\n        FloatSemiring(self.0 + rhs.0)\n    }\n}\n// Arc representation\n#[derive(Clone, Debug)]\npub struct Arc<W: Semiring> {\n    pub state: usize,\n    pub ilabel: u32,\n    pub olabel: u32,\n    pub weight: W,\n}\n// State representation\n#[derive(Clone, Debug)]\npub struct State<W: Semiring> {\n    pub arcs: Vec<Arc<W>>,\n    pub final_weight: Option<W>,\n}\n// Fst representation\n#[derive(Clone, Debug)]\npub struct Fst<W: Semiring> {\n    pub states: Vec<State<W>>,\n    pub start: usize,\n    pub flags: u32,   // Might store OSORT/ISORT flags, etc.\n    // sr_type, etc. could go here if needed\n}\nimpl<W: Semiring> Fst<W> {\n    pub fn new() -> Self {\n        Fst {\n            states: Vec::new(),\n            start: 0,\n            flags: 0,\n        }\n    }\n    // Add a new state, returns its index\n    pub fn add_state(&mut self) -> usize {\n        self.states.push(State {\n            arcs: Vec::new(),\n            final_weight: None,\n        });\n        self.states.len() - 1\n    }\n    // Set final weight\n    pub fn set_final(&mut self, st: usize, weight: W) {\n        self.states[st].final_weight = Some(weight);\n    }\n    // Add arc\n    pub fn add_arc(&mut self, src: usize, arc: Arc<W>) {\n        self.states[src].arcs.push(arc);\n    }\n}\n// A pair of states (a,b)\n#[derive(Copy, Clone, Debug, Eq)]\npub struct StatePair {\n    pub a: usize,\n    pub b: usize,\n}\n// We need to implement PartialEq and Hash for StatePair\nimpl PartialEq for StatePair {\n    fn eq(&self, other: &Self) -> bool {\n        self.a == other.a && self.b == other.b\n    }\n}\nimpl Hash for StatePair {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        // A simple combination for demonstration\n        // for fewer collisions you can do something stronger\n        state.write_usize(self.a);\n        state.write_usize(self.b);\n    }\n}\n// A pair of arcs matched together\n#[derive(Clone, Debug)]\npub struct ArcPair<W: Semiring> {\n    pub a: Arc<W>,\n    pub b: Arc<W>,\n}\n// The \"EPS\" label constant\npub const EPS: u32 = 0;\n\nfn match_check<W: Semiring>(arcs_a: &[Arc<W>], _arcs_b: &[Arc<W>], i: usize, j: usize) -> bool {\n    let al = arcs_a[i].olabel;\n    if al == EPS {\n        if (i != 0 && j != 0) || (i == 0 && j == 0) {\n            return false;\n        }\n    }\n    true\n}\n\nfn match_full_sorted<W: Semiring>(\n    arcs_a: &[Arc<W>],\n    arcs_b: &[Arc<W>],\n) -> Vec<ArcPair<W>> {\n    let mut result = Vec::new();\n    let m = arcs_a.len();\n    let n = arcs_b.len();\n    let mut i = 0usize;\n    let mut j = 0usize;\n    while i < m && j < n {\n        if arcs_a[i].olabel < arcs_b[j].ilabel {\n            i += 1;\n        } else if arcs_a[i].olabel > arcs_b[j].ilabel {\n            j += 1;\n        } else {\n            let mut t = j;\n            while t < n && arcs_a[i].olabel == arcs_b[t].ilabel {\n                if match_check(arcs_a, arcs_b, i, t) {\n                    result.push(ArcPair {\n                        a: arcs_a[i].clone(),\n                        b: arcs_b[t].clone(),\n                    });\n                }\n                t += 1;\n            }\n            i += 1;\n        }\n    }\n    result\n}\nfn match_half_sorted<W: Semiring>(\n    arcs_a: &[Arc<W>],\n    arcs_b: &[Arc<W>],\n) -> Vec<ArcPair<W>> {\n    let mut result = Vec::new();\n    let m = arcs_a.len();\n    let n = arcs_b.len();\n    if n == 0 {\n        return result;\n    }\n    for i in 0..m {\n        let mut l: i64 = 0;\n        let mut h: i64 = (n as i64) - 1;\n        while l <= h {\n            let mid = ((l + h) >> 1) as usize;\n            if arcs_a[i].olabel > arcs_b[mid].ilabel {\n                l = mid as i64 + 1;\n            } else if arcs_a[i].olabel < arcs_b[mid].ilabel {\n                if mid == 0 {\n                    break;\n                }\n                h = mid as i64 - 1;\n            } else {\n                let mut ll = mid;\n                let mut hh = mid;\n                while (ll as i64) > l && arcs_a[i].olabel == arcs_b[ll - 1].ilabel {\n                    ll -= 1;\n                }\n                while (hh as i64) < h && arcs_a[i].olabel == arcs_b[hh + 1].ilabel {\n                    hh += 1;\n                }\n                while (ll as i64) <= hh as i64 {\n                    if match_check(arcs_a, arcs_b, i, ll) {\n                        result.push(ArcPair {\n                            a: arcs_a[i].clone(),\n                            b: arcs_b[ll].clone(),\n                        });\n                    }\n                    ll += 1;\n                }\n                break;\n            }\n        }\n    }\n    result\n}\nfn match_half_sorted_rev<W: Semiring>(\n    arcs_a: &[Arc<W>],\n    arcs_b: &[Arc<W>],\n) -> Vec<ArcPair<W>> {\n    let mut result = Vec::new();\n    let m = arcs_a.len();\n    let n = arcs_b.len();\n    if m == 0 {\n        return result;\n    }\n    for i in 0..n {\n        let mut l: i64 = 0;\n        let mut h: i64 = (m as i64) - 1;\n        while l <= h {\n            let mid = ((l + h) >> 1) as usize;\n            if arcs_b[i].ilabel > arcs_a[mid].olabel {\n                l = mid as i64 + 1;\n            } else if arcs_b[i].ilabel < arcs_a[mid].olabel {\n                if mid == 0 {\n                    break;\n                }\n                h = mid as i64 - 1;\n            } else {\n                let mut ll = mid;\n                let mut hh = mid;\n                while (ll as i64) > l && arcs_b[i].ilabel == arcs_a[ll - 1].olabel {\n                    ll -= 1;\n                }\n                while (hh as i64) < h && arcs_b[i].ilabel == arcs_a[hh + 1].olabel {\n                    hh += 1;\n                }\n                while (ll as i64) <= hh as i64 {\n                    if match_check(arcs_a, arcs_b, ll, i) {\n                        result.push(ArcPair {\n                            a: arcs_a[ll].clone(),\n                            b: arcs_b[i].clone(),\n                        });\n                    }\n                    ll += 1;\n                }\n                break;\n            }\n        }\n    }\n    result\n}\nfn match_unsorted<W: Semiring>(\n    arcs_a: &[Arc<W>],\n    arcs_b: &[Arc<W>],\n) -> Vec<ArcPair<W>> {\n    let mut result = Vec::new();\n    for i in 0..arcs_a.len() {\n        for j in 0..arcs_b.len() {\n            if arcs_a[i].olabel == arcs_b[j].ilabel && match_check(arcs_a, arcs_b, i, j) {\n                result.push(ArcPair {\n                    a: arcs_a[i].clone(),\n                    b: arcs_b[j].clone(),\n                });\n            }\n        }\n    }\n    result\n}\n/// Matches arcs from two states (given by `pair`) and enqueues matched pairs\nfn match_arcs<W: Semiring>(\n    fst_a: &Fst<W>,\n    fst_b: &Fst<W>,\n    pair: &StatePair,\n    sr: &W,\n) -> Vec<ArcPair<W>> {\n    let state_a = &fst_a.states[pair.a];\n    let state_b = &fst_b.states[pair.b];\n\n    let osort = (fst_a.flags & OSORT) != 0;\n    let isort = (fst_b.flags & ISORT) != 0;\n\n    // Build augmented arc lists with a leading epsilon self-loop.\n    let mut arcs_a: Vec<Arc<W>> = Vec::with_capacity(state_a.arcs.len() + 1);\n    let mut arcs_b: Vec<Arc<W>> = Vec::with_capacity(state_b.arcs.len() + 1);\n\n    arcs_a.push(Arc {\n        state: pair.a,\n        ilabel: EPS,\n        olabel: EPS,\n        weight: sr.clone(),\n    });\n    for arc in &state_a.arcs {\n        arcs_a.push(arc.clone());\n    }\n    arcs_b.push(Arc {\n        state: pair.b,\n        ilabel: EPS,\n        olabel: EPS,\n        weight: sr.clone(),\n    });\n    for arc in &state_b.arcs {\n        arcs_b.push(arc.clone());\n    }\n\n    if isort && osort {\n        match_full_sorted(&arcs_a, &arcs_b)\n    } else if isort || osort {\n        if isort {\n            match_half_sorted(&arcs_a, &arcs_b)\n        } else {\n            match_half_sorted_rev(&arcs_a, &arcs_b)\n        }\n    } else {\n        match_unsorted(&arcs_a, &arcs_b)\n    }\n}\n/// Compose two FSTs into a third.\npub fn fst_compose<W: Semiring>(\n    fst_a: &Fst<W>,\n    fst_b: &Fst<W>,\n    sr: &W,\n) -> Fst<W> {\n    let mut fst_c: Fst<W> = Fst::new();\n    let mut q: VecDeque<StatePair> = VecDeque::new();\n    let mut marked: HashMap<StatePair, usize> = HashMap::new();\n\n    let initial = StatePair {\n        a: fst_a.start,\n        b: fst_b.start,\n    };\n    q.push_back(initial);\n\n    while let Some(pair) = q.pop_front() {\n        let state_a = &fst_a.states[pair.a];\n        let state_b = &fst_b.states[pair.b];\n\n        let sc = match marked.get(&pair) {\n            Some(&v) => v,\n            None => {\n                let new_id = fst_c.add_state();\n                if state_a.final_weight.is_some() && state_b.final_weight.is_some() {\n                    fst_c.set_final(new_id, sr.clone());\n                }\n                if pair.a == fst_a.start && pair.b == fst_b.start {\n                    fst_c.start = new_id;\n                }\n                marked.insert(pair, new_id);\n                new_id\n            }\n        };\n\n        let matches = match_arcs(fst_a, fst_b, &pair, sr);\n        for mi in matches {\n            let arc_a = mi.a;\n            let arc_b = mi.b;\n            let next_pair = StatePair {\n                a: arc_a.state,\n                b: arc_b.state,\n            };\n            let dst_sc = match marked.get(&next_pair) {\n                Some(&v) => v,\n                None => {\n                    let dst_state_a = &fst_a.states[next_pair.a];\n                    let dst_state_b = &fst_b.states[next_pair.b];\n                    let dst_id = fst_c.add_state();\n                    if dst_state_a.final_weight.is_some() && dst_state_b.final_weight.is_some() {\n                        fst_c.set_final(dst_id, sr.clone());\n                    }\n                    q.push_back(next_pair);\n                    marked.insert(next_pair, dst_id);\n                    dst_id\n                }\n            };\n            fst_c.add_arc(\n                sc,\n                Arc {\n                    state: dst_sc,\n                    ilabel: arc_a.ilabel,\n                    olabel: arc_b.olabel,\n                    weight: arc_a.weight.prod(&arc_b.weight),\n                },\n            );\n        }\n    }\n    fst_c\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2445,"cache_read_input_tokens":106877,"cache_creation":{"ephemeral_5m_input_tokens":2445,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"dd738c1f-93ad-4c23-bff1-17ed51c8bb56","uuid":"2254a4d0-3816-4008-8a87-1beff80e69dc"}
