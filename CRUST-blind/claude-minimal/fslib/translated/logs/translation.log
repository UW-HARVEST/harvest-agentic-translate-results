{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015iVV7JkJBvLoSHTj3KLhEZ","type":"tool_result","content":"1\t#include <string.h>\n2\t#include <stdlib.h>\n3\t#include <stdio.h>\n4\t#include <assert.h>\n5\t#include \"symt.h\"\n6\t#include \"hash.h\"\n7\t\n8\tstatic size_t fnv32(void * str) {\n9\t\n10\t    const char * s = str;\n11\t    uint32_t hsh = FNV_OFFSET_32, i;\n12\t\n13\t    for(i = 0; i < strlen(s); i++) {\n14\t        // xor next byte into the bottom of the hash\n15\t        hsh = hsh ^ (s[i]); \n16\t        // Multiply by prime number found to work well\n17\t        hsh = hsh * FNV_PRIME_32; \n18\t    }\n19\t    return hsh;\n20\t}\n21\t\n22\tstatic int str_cmp(void * a, void * b) {\n23\t    return strcmp((const char *)a, (const char *)b) == 0 ? 1: 0;\n24\t}\n25\t\n26\tstruct _symt * symt_read(struct _symt * st, FILE * fin) {\n27\t    char p[0xffff];\n28\t    char token[TOKEN_SIZE];\n29\t    size_t line = 1;\n30\t    size_t token_id;\n31\t\n32\t    while (fgets(p, sizeof(p), fin) != NULL) {\n33\t        if (sscanf(p, \"%s\\t%zu\", token, &token_id) == 2) {\n34\t            symt_add(st, token_id, token);\n35\t        }\n36\t        else {\n37\t                printf(\"Invalid input line %zd: %s\", line, p);\n38\t                exit(EXIT_FAILURE);\n39\t        }\n40\t        ++line;\n41\t    }\n42\t    return st;\n43\t}\n44\t\n45\tstruct _symt * symt_compile(struct _symt * st, const char * str) {\n46\t    char p[0xffff];\n47\t    char token[TOKEN_SIZE];\n48\t    char * tok;\n49\t    size_t line = 1;\n50\t    size_t token_id;\n51\t\n52\t    strcpy(p, str);\n53\t\n54\t    do {\n55\t        if (line == 1)\n56\t            tok = strtok(p, \"\\n\");\n57\t        else {\n58\t            tok = strtok(NULL, \"\\n\");\n59\t        }\n60\t\n61\t        if (tok) {\n62\t            if (sscanf(p, \"%s\\t%zd\", token, &token_id) == 2) {\n63\t                symt_add(st, token_id, token);\n64\t            }\n65\t            else {\n66\t                    printf(\"Invalid input line %zd: %s\", line, p);\n67\t                    exit(EXIT_FAILURE);\n68\t            }\n69\t        }\n70\t        ++line;\n71\t    } while (tok);\n72\t\n73\t    return st;\n74\t}    \n75\t\n76\tstruct _symt * symt_fread(struct _symt * st, const char * filename) {\n77\t    FILE * fin = NULL;\n78\t    if (( fin = fopen(filename, \"r\")) == NULL ) {\n79\t        fprintf(stderr, \"Error opening file: %s\\n\", filename);\n80\t        exit(EXIT_FAILURE);\n81\t    }\n82\t\n83\t    st = symt_read(st, fin);\n84\t    if (fin != NULL)\n85\t        fclose(fin);\n86\t    return st;\n87\t}   \n88\t\n89\tstruct _symt * symt_create() {\n90\t    struct _symt * st = malloc(sizeof(struct _symt));\n91\t\n92\t    st->rev = NULL;\n93\t    st->sym = malloc(SYM_INIT_SIZE * sizeof(char *));\n94\t\n95\t    st->n_items = 0;\n96\t    st->n_max = SYM_INIT_SIZE;\n97\t\n98\t    for(size_t i=0; i < st->n_max; ++i)\n99\t        st->sym[i] = NULL;\n100\t\n101\t    return st;\n102\t}\n103\t\n104\tvoid symt_remove(struct _symt * st) {\n105\t    for(size_t i=0; i < st->n_max; ++i) \n106\t        if(st->sym[i] != NULL)  \n107\t            free(st->sym[i]);\n108\t\n109\t    if (st->rev != NULL)\n110\t        hash_remove(st->rev);\n111\t\n112\t    free(st->sym);\n113\t    free(st);\n114\t}\n115\t\n116\tchar * symt_add(\n117\t                        struct _symt * st, \n118\t                        size_t id, \n119\t                        const char * token) {\n120\t\n121\t    // Token should be a C-string\n122\t    size_t s = st->n_max;\n123\t    char ** p;\n124\t\n125\t    assert(st->sym != NULL);\n126\t    assert(st->n_max != 0);\n127\t\n128\t    while (st->n_max <= id) {\n129\t        st->n_max *= 2;\n130\t    }\n131\t\n132\t    if( st->n_max > s) {\n133\t        p = realloc(st->sym, st->n_max * sizeof(char *)); \n134\t        st->sym = p;\n135\t    }\n136\t\n137\t    for(size_t i = s; i < st->n_max; ++i)\n138\t        st->sym[i] = NULL;\n139\t\n140\t    char * t = malloc(strlen(token) + 1);\n141\t    //strncpy(t, token, TOKEN_SIZE);\n142\t    strcpy(t, token);\n143\t    st->sym[id] = t;\n144\t    ++st->n_items;\n145\t\n146\t    return st->sym[id];\n147\t}\n148\t\n149\tvoid symt_print(struct _symt * st) {\n150\t    for(size_t i=0; i < st->n_max; ++i) {\n151\t        if ( st->sym[i] != NULL )\n152\t            printf(\"%s\\t%zd\\n\", st->sym[i], i);\n153\t    } \n154\t} \n155\t\n156\tstruct _hash * symt_reverse(struct _symt * st) {\n157\t    if(st->rev != NULL)\n158\t        hash_remove(st->rev);\n159\t\n160\t    st->rev = hash_create(\n161\t                    fnv32,\n162\t                    str_cmp,\n163\t                    TOKEN_SIZE,\n164\t                    sizeof(size_t),\n165\t                    st->n_items * 2);\n166\t\n167\t    char token[TOKEN_SIZE] = {0};\n168\t\n169\t    for(size_t i=0; i < st->n_max; ++i) {\n170\t        if ( st->sym[i] != NULL ) {\n171\t            strncpy(token, st->sym[i], TOKEN_SIZE - 1);\n172\t            //strcpy(token, st->sym[i]);\n173\t            hash_add(st->rev, token, &i);\n174\t            //hash_add(st->rev, st->sym[i], &i);\n175\t        }\n176\t    } \n177\t\n178\t    return st->rev;\n179\t}\n180\t\n181\tsize_t symt_getr(struct _symt * st, char * token) {\n182\t    size_t id = -1;\n183\t    if (st->rev == NULL)\n184\t       symt_reverse(st); \n185\t\n186\t    hash_get(st->rev, token, &id); \n187\t\n188\t    return id; \n189\t}\n190\t\n191\tchar * symt_get(struct _symt * st, size_t id) {\n192\t    if ( id > st->n_items ) \n193\t        return NULL;\n194\t    return st->sym[id];\n195\t}\n196\t"}]},"parent_tool_use_id":null,"session_id":"dd738c1f-93ad-4c23-bff1-17ed51c8bb56","uuid":"8199d878-4327-4466-848a-632af72b4597","timestamp":"2026-06-02T02:45:33.422Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-fFc29r/project/c_src/src/symt.c","content":"#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include <assert.h>\n#include \"symt.h\"\n#include \"hash.h\"\n\nstatic size_t fnv32(void * str) {\n\n    const char * s = str;\n    uint32_t hsh = FNV_OFFSET_32, i;\n\n    for(i = 0; i < strlen(s); i++) {\n        // xor next byte into the bottom of the hash\n        hsh = hsh ^ (s[i]); \n        // Multiply by prime number found to work well\n        hsh = hsh * FNV_PRIME_32; \n    }\n    return hsh;\n}\n\nstatic int str_cmp(void * a, void * b) {\n    return strcmp((const char *)a, (const char *)b) == 0 ? 1: 0;\n}\n\nstruct _symt * symt_read(struct _symt * st, FILE * fin) {\n    char p[0xffff];\n    char token[TOKEN_SIZE];\n    size_t line = 1;\n    size_t token_id;\n\n    while (fgets(p, sizeof(p), fin) != NULL) {\n        if (sscanf(p, \"%s\\t%zu\", token, &token_id) == 2) {\n            symt_add(st, token_id, token);\n        }\n        else {\n                printf(\"Invalid input line %zd: %s\", line, p);\n                exit(EXIT_FAILURE);\n        }\n        ++line;\n    }\n    return st;\n}\n\nstruct _symt * symt_compile(struct _symt * st, const char * str) {\n    char p[0xffff];\n    char token[TOKEN_SIZE];\n    char * tok;\n    size_t line = 1;\n    size_t token_id;\n\n    strcpy(p, str);\n\n    do {\n        if (line == 1)\n            tok = strtok(p, \"\\n\");\n        else {\n            tok = strtok(NULL, \"\\n\");\n        }\n\n        if (tok) {\n            if (sscanf(p, \"%s\\t%zd\", token, &token_id) == 2) {\n                symt_add(st, token_id, token);\n            }\n            else {\n                    printf(\"Invalid input line %zd: %s\", line, p);\n                    exit(EXIT_FAILURE);\n            }\n        }\n        ++line;\n    } while (tok);\n\n    return st;\n}    \n\nstruct _symt * symt_fread(struct _symt * st, const char * filename) {\n    FILE * fin = NULL;\n    if (( fin = fopen(filename, \"r\")) == NULL ) {\n        fprintf(stderr, \"Error opening file: %s\\n\", filename);\n        exit(EXIT_FAILURE);\n    }\n\n    st = symt_read(st, fin);\n    if (fin != NULL)\n        fclose(fin);\n    return st;\n}   \n\nstruct _symt * symt_create() {\n    struct _symt * st = malloc(sizeof(struct _symt));\n\n    st->rev = NULL;\n    st->sym = malloc(SYM_INIT_SIZE * sizeof(char *));\n\n    st->n_items = 0;\n    st->n_max = SYM_INIT_SIZE;\n\n    for(size_t i=0; i < st->n_max; ++i)\n        st->sym[i] = NULL;\n\n    return st;\n}\n\nvoid symt_remove(struct _symt * st) {\n    for(size_t i=0; i < st->n_max; ++i) \n        if(st->sym[i] != NULL)  \n            free(st->sym[i]);\n\n    if (st->rev != NULL)\n        hash_remove(st->rev);\n\n    free(st->sym);\n    free(st);\n}\n\nchar * symt_add(\n                        struct _symt * st, \n                        size_t id, \n                        const char * token) {\n\n    // Token should be a C-string\n    size_t s = st->n_max;\n    char ** p;\n\n    assert(st->sym != NULL);\n    assert(st->n_max != 0);\n\n    while (st->n_max <= id) {\n        st->n_max *= 2;\n    }\n\n    if( st->n_max > s) {\n        p = realloc(st->sym, st->n_max * sizeof(char *)); \n        st->sym = p;\n    }\n\n    for(size_t i = s; i < st->n_max; ++i)\n        st->sym[i] = NULL;\n\n    char * t = malloc(strlen(token) + 1);\n    //strncpy(t, token, TOKEN_SIZE);\n    strcpy(t, token);\n    st->sym[id] = t;\n    ++st->n_items;\n\n    return st->sym[id];\n}\n\nvoid symt_print(struct _symt * st) {\n    for(size_t i=0; i < st->n_max; ++i) {\n        if ( st->sym[i] != NULL )\n            printf(\"%s\\t%zd\\n\", st->sym[i], i);\n    } \n} \n\nstruct _hash * symt_reverse(struct _symt * st) {\n    if(st->rev != NULL)\n        hash_remove(st->rev);\n\n    st->rev = hash_create(\n                    fnv32,\n                    str_cmp,\n                    TOKEN_SIZE,\n                    sizeof(size_t),\n                    st->n_items * 2);\n\n    char token[TOKEN_SIZE] = {0};\n\n    for(size_t i=0; i < st->n_max; ++i) {\n        if ( st->sym[i] != NULL ) {\n            strncpy(token, st->sym[i], TOKEN_SIZE - 1);\n            //strcpy(token, st->sym[i]);\n            hash_add(st->rev, token, &i);\n            //hash_add(st->rev, st->sym[i], &i);\n        }\n    } \n\n    return st->rev;\n}\n\nsize_t symt_getr(struct _symt * st, char * token) {\n    size_t id = -1;\n    if (st->rev == NULL)\n       symt_reverse(st); \n\n    hash_get(st->rev, token, &id); \n\n    return id; \n}\n\nchar * symt_get(struct _symt * st, size_t id) {\n    if ( id > st->n_items ) \n        return NULL;\n    return st->sym[id];\n}\n","numLines":196,"startLine":1,"totalLines":196}}}
