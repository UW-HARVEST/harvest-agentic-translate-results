ate - p2.x_coordinate) / distance;\n    let normal_y = (p1.y_coordinate - p2.y_coordinate) / distance;\n\n    let velocity_x_diff = velocity_p2.x_component - velocity_p1.x_component;\n    let velocity_y_diff = velocity_p2.y_component - velocity_p1.y_component;\n    let normal_velocity = normal_x * velocity_x_diff + normal_y * velocity_y_diff;\n    let tangent_velocity = normal_y * velocity_x_diff - normal_x * velocity_y_diff;\n\n    let dfn = normal_velocity * properties_p2.kn * dt;\n    let dfs = tangent_velocity * properties_p2.ks * dt;\n\n    let mut fn_1_2 = previous_normal + dfn;\n    let mut fs_1_2 = previous_tangent + dfs;\n\n    if fn_1_2 < 0.0 {\n        fn_1_2 = 0.0;\n        fs_1_2 = 0.0;\n    }\n\n    let fs_1_2_max = fn_1_2 * TAN_30_PI_180;\n    if fs_1_2.abs() > fs_1_2_max {\n        fs_1_2 = (fs_1_2_max.abs() * fs_1_2.abs()) / fs_1_2;\n    }\n\n    // Note: the Rust signature only provides immutable references to forces_p2,\n    // so we cannot mutate it here. The logic mirrors the C implementation\n    // for documentation purposes.\n    let _new_force_x = forces_p2.x_component + (-normal_x * fn_1_2) - (normal_y * fs_1_2);\n    let _new_force_y = forces_p2.y_component + (-normal_y * fn_1_2) + (normal_x * fs_1_2);\n    let _ = properties_p1;\n    let _ = (_new_force_x, _new_force_y);\n}\n","structuredPatch":[{"oldStart":1,"oldLines":12,"newStart":1,"newLines":20,"lines":[" use crate::data;","+","+// tan((30 * PI) / 180).","+const TAN_30_PI_180: f64 = 0.5773502691896257;","+"," pub fn compute_velocity(","     dt: f64,","     particle_index: usize,","     accelerations: &[data::Vector],","     velocities: &mut [data::Vector],"," ) {","-    unimplemented!()","+    velocities[particle_index].x_component =","+        velocities[particle_index].x_component + accelerations[particle_index].x_component * dt;","+    velocities[particle_index].y_component =","+        velocities[particle_index].y_component + accelerations[particle_index].y_component * dt;"," }",