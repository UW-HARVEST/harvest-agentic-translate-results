{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MmUMvFHipX7vvNEvSUp8tf","type":"tool_result","content":"1\t#include <assert.h>\n2\t#include <stdio.h>\n3\t#include <string.h>\n4\t\n5\t#include \"../config.h\"\n6\t#include \"test_print.h\"\n7\t\n8\tTestResult\n9\trun_test(const char *expected, void *arg, bool is_error)\n10\t{\n11\t    char buffer[256];\n12\t    FILE *stream = fmemopen(buffer, sizeof(buffer), \"w\");\n13\t    if (stream == NULL)\n14\t        return ABORT;\n15\t\n16\t    if (!is_error)\n17\t        cfg_fprint(stream, (Cfg *) arg);\n18\t    else\n19\t        cfg_fprint_error(stream, (CfgError *) arg);\n20\t\n21\t    fclose(stream);\n22\t\n23\t    ASSERT(0 == strncmp(expected, buffer, strlen(expected)));\n24\t    return OK;\n25\t}\n26\t\n27\tTestResult\n28\trun_print_test()\n29\t{\n30\t    CfgError err;\n31\t    CfgEntry entries[TEST_CAPACITY];\n32\t    Cfg cfg = {.entries = entries, .capacity = TEST_CAPACITY};\n33\t\n34\t    static const char expected[] = \"font: \\\"JetBrainsMono Nerd Font\\\"\\n\"\n35\t                                   \"font.size: 14\\n\"\n36\t                                   \"zoom: 1.500000\\n\"\n37\t                                   \"line_numbers: true\\n\"\n38\t                                   \"ruler: false\\n\"\n39\t                                   \"bg.color: rgba(255, 255, 255, 255)\";\n40\t\n41\t    static const char src[] = \"font: \\\"JetBrainsMono Nerd Font\\\"\\n\"\n42\t                              \"font.size: 14\\n\"\n43\t                              \"zoom: 1.5\\n\"\n44\t                              \"line_numbers: true\\n\"\n45\t                              \"ruler: false\\n\"\n46\t                              \"bg.color: rgba(255, 255, 255, 1)\";\n47\t\n48\t    int res = cfg_parse(src, strlen(src), &cfg, &err);\n49\t    if (res != 0)\n50\t        return ABORT;\n51\t\n52\t    return run_test(expected, &cfg, false);\n53\t}\n54\t\n55\tTestResult\n56\trun_error_test_1()\n57\t{\n58\t    CfgError err;\n59\t    CfgEntry entries[TEST_CAPACITY];\n60\t    Cfg cfg = {.entries = entries, .capacity = TEST_CAPACITY};\n61\t\n62\t    int res = cfg_parse_file(\"\", &cfg, &err);\n63\t    if (res == 0)\n64\t        return ABORT;\n65\t\n66\t    return run_test(\"Error: invalid filename\\n\", &err, true);\n67\t}\n68\t\n69\tTestResult\n70\trun_error_test_2()\n71\t{\n72\t    CfgError err;\n73\t    CfgEntry entries[TEST_CAPACITY];\n74\t    Cfg cfg = {.entries = entries, .capacity = TEST_CAPACITY};\n75\t\n76\t    static const char *src = \"a:true\\nb:\";\n77\t\n78\t    int res = cfg_parse(src, strlen(src), &cfg, &err);\n79\t    if (res == 0)\n80\t        return ABORT;\n81\t\n82\t    return run_test(\"Error at 2:3 :: missing value\\n\", &err, true);\n83\t}\n84\t\n85\tvoid\n86\trun_print_tests(Scoreboard *sb, FILE *stream)\n87\t{\n88\t    TestResult result;\n89\t\n90\t    result = run_print_test();\n91\t    update_scoreboard(sb, result);\n92\t    log_result(result, stream);\n93\t\n94\t    result = run_error_test_1();\n95\t    update_scoreboard(sb, result);\n96\t    log_result(result, stream);\n97\t\n98\t    result = run_error_test_2();\n99\t    update_scoreboard(sb, result);\n100\t    log_result(result, stream);\n101\t}\n102\t"}]},"parent_tool_use_id":null,"session_id":"beb644fa-13ff-4e27-b93b-478f75af258b","uuid":"c0bb3fe1-953e-4d49-b173-c6ad262c413a","timestamp":"2026-06-02T03:29:42.232Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-89hpRC/project/c_src/test/test_print.c","content":"#include <assert.h>\n#include <stdio.h>\n#include <string.h>\n\n#include \"../config.h\"\n#include \"test_print.h\"\n\nTestResult\nrun_test(const char *expected, void *arg, bool is_error)\n{\n    char buffer[256];\n    FILE *stream = fmemopen(buffer, sizeof(buffer), \"w\");\n    if (stream == NULL)\n        return ABORT;\n\n    if (!is_error)\n        cfg_fprint(stream, (Cfg *) arg);\n    else\n        cfg_fprint_error(stream, (CfgError *) arg);\n\n    fclose(stream);\n\n    ASSERT(0 == strncmp(expected, buffer, strlen(expected)));\n    return OK;\n}\n\nTestResult\nrun_print_test()\n{\n    CfgError err;\n    CfgEntry entries[TEST_CAPACITY];\n    Cfg cfg = {.entries = entries, .capacity = TEST_CAPACITY};\n\n    static const char expected[] = \"font: \\\"JetBrainsMono Nerd Font\\\"\\n\"\n                                   \"font.size: 14\\n\"\n                                   \"zoom: 1.500000\\n\"\n                                   \"line_numbers: true\\n\"\n                                   \"ruler: false\\n\"\n                                   \"bg.color: rgba(255, 255, 255, 255)\";\n\n    static const char src[] = \"font: \\\"JetBrainsMono Nerd Font\\\"\\n\"\n                              \"font.size: 14\\n\"\n                              \"zoom: 1.5\\n\"\n                              \"line_numbers: true\\n\"\n                              \"ruler: false\\n\"\n                              \"bg.color: rgba(255, 255, 255, 1)\";\n\n    int res = cfg_parse(src, strlen(src), &cfg, &err);\n    if (res != 0)\n        return ABORT;\n\n    return run_test(expected, &cfg, false);\n}\n\nTestResult\nrun_error_test_1()\n{\n    CfgError err;\n    CfgEntry entries[TEST_CAPACITY];\n    Cfg cfg = {.entries = entries, .capacity = TEST_CAPACITY};\n\n    int res = cfg_parse_file(\"\", &cfg, &err);\n    if (res == 0)\n        return ABORT;\n\n    return run_test(\"Error: invalid filename\\n\", &err, true);\n}\n\nTestResult\nrun_error_test_2()\n{\n    CfgError err;\n    CfgEntry entries[TEST_CAPACITY];\n    Cfg cfg = {.entries = entries, .capacity = TEST_CAPACITY};\n\n    static const char *src = \"a:true\\nb:\";\n\n    int res = cfg_parse(src, strlen(src), &cfg, &err);\n    if (res == 0)\n        return ABORT;\n\n    return run_test(\"Error at 2:3 :: missing value\\n\", &err, true);\n}\n\nvoid\nrun_print_tests(Scoreboard *sb, FILE *stream)\n{\n    TestResult result;\n\n    result = run_print_test();\n    update_scoreboard(sb, result);\n    log_result(result, stream);\n\n    result = run_error_test_1();\n    update_scoreboard(sb, result);\n    log_result(result, stream);\n\n    result = run_error_test_2();\n    update_scoreboard(sb, result);\n    log_result(result, stream);\n}\n","numLines":102,"startLine":1,"totalLines":102}}}
