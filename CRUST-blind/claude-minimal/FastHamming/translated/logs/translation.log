byte_idx] ^= 1u8 << bit_idx;\n        }\n    }\n\n    true\n}\npub fn log2uint8(x: u8) -> u8 {\n    // Equivalent to `31 - __builtin_clz((unsigned)x)` for x > 0.\n    // For x == 0 the C builtin is undefined; mirror that by returning 0.\n    if x == 0 {\n        return 0;\n    }\n    7 - x.leading_zeros() as u8\n}\n","structuredPatch":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":5,"lines":["-use std::cmp;"," /// Encodes the input buffer using Hamming ECC encoding."," pub fn hecc_encode(input: &[u8]) -> Vec<u8> {","-    let _ = cmp::min(0, 0);","     let mut output = Vec::new();","     let mut chunks = input.chunks_exact(15);","     for chunk in chunks.by_ref() {"]}],"userModified":false,"replaceAll":false}}
