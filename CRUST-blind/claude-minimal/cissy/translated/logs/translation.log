{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KfrHduP2vwhiE6pKb3iTSB","type":"tool_result","content":"1\t/*\n2\t   Copyright 2015 Steven Lass\n3\t\n4\t   Licensed under the Apache License, Version 2.0 (the \"License\");\n5\t   you may not use this file except in compliance with the License.\n6\t   You may obtain a copy of the License at\n7\t\n8\t       http://www.apache.org/licenses/LICENSE-2.0\n9\t\n10\t   Unless required by applicable law or agreed to in writing, software\n11\t   distributed under the License is distributed on an \"AS IS\" BASIS,\n12\t   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n13\t   See the License for the specific language governing permissions and\n14\t   limitations under the License.\n15\t*/\n16\t\n17\t#include <stdlib.h>\n18\t#include <stdio.h>\n19\t#include <stdbool.h>\n20\t#include <assert.h>\n21\t#include <string.h>\n22\t#include \"range.h\"\n23\t\n24\t/**\n25\t* Used for column lists\n26\t*/\n27\t\n28\t/**\n29\t* free memory\n30\t*\n31\t* @param list range\n32\t*/\n33\tvoid rangeFree(struct rangeElement* list) {\n34\t  if (list == NULL) {\n35\t    return;\n36\t  }\n37\t  struct rangeElement* ptr = list;\n38\t  while (ptr->next != NULL) {\n39\t    struct rangeElement* ptrNext = ptr->next;\n40\t    free(ptr);\n41\t    ptr = ptrNext;\n42\t  }\n43\t  free(ptr);\n44\t  list=NULL;\n45\t}\n46\t\n47\t/**\n48\t* Create a new range\n49\t*/\n50\tstruct rangeElement* rangeCreate() {\n51\t  struct rangeElement* ptr = malloc(sizeof(struct rangeElement));\n52\t  if (ptr == NULL) {\n53\t    fprintf(stderr, \"rangeCreate: malloc error\\n\");\n54\t    exit(-1);\n55\t  }\n56\t  ptr->start = -1;\n57\t  ptr->end = -1;\n58\t  ptr->next = NULL;\n59\t  return ptr;\n60\t}\n61\t\n62\t// pass NULL list to create new list\n63\t/**\n64\t* add a n-m range to the list\n65\t*\n66\t* Add start-end range.  Create a new list if necessary\n67\t*\n68\t* @param start beginning \n69\t* @param end ending\n70\t* @param startOfList list\n71\t* @return list\n72\t*/\n73\tstruct rangeElement* rangeAddStartEnd(uint32_t start, uint32_t end, struct rangeElement* startOfList) {\n74\t  assert(start > 0);\n75\t  assert(end >= start);\n76\t  if (startOfList == NULL) {\n77\t    startOfList = rangeCreate();\n78\t    startOfList->start = start;\n79\t    if (start == end) {\n80\t      startOfList->rangetype = SINGLE;\n81\t    }\n82\t    else {\n83\t      startOfList->rangetype = STARTEND;\n84\t      startOfList->end = end;\n85\t    }\n86\t    return startOfList;\n87\t  }\n88\t  struct rangeElement* ptr = startOfList;\n89\t  //advance to the end of list\n90\t  while (ptr->next != NULL) {\n91\t    ptr = ptr->next;\n92\t  }\n93\t  ptr->next = rangeCreate();\n94\t  ptr = ptr->next;\n95\t  ptr->start = start;\n96\t  if (end == start) {\n97\t    ptr->rangetype = SINGLE;\n98\t  }\n99\t  else {\n100\t    ptr->rangetype = STARTEND;\n101\t    ptr->end = end;\n102\t  }\n103\t  return startOfList;\n104\t}\n105\t\n106\t/**\n107\t* Add a n- range (to end of line) to list\n108\t*\n109\t* Add a greater than range, create new list if necessary\n110\t*\n111\t* @param num beginning \n112\t* @param startOfList list\n113\t* @return list\n114\t*/\n115\tstruct rangeElement* rangeAddGreaterEqual(uint32_t num, struct rangeElement* startOfList) {\n116\t  assert(num >= 0);\n117\t  if (startOfList == NULL) {\n118\t    startOfList = rangeCreate();\n119\t    startOfList->start = num;\n120\t    startOfList->rangetype = GREATEREQUAL;\n121\t    return startOfList;\n122\t  }\n123\t  struct rangeElement* ptr = startOfList;\n124\t  //advance to the end of list\n125\t  while (ptr->next != NULL) {\n126\t    ptr = ptr->next;\n127\t  }\n128\t  ptr->next = rangeCreate();\n129\t  ptr = ptr->next;\n130\t  ptr->start = num;\n131\t  ptr->rangetype = GREATEREQUAL;\n132\t  return startOfList;\n133\t}\n134\t\n135\t/**\n136\t* Add a single element to list\n137\t*\n138\t* Add a number, create new list if necessary\n139\t*\n140\t* @param num number to add \n141\t* @param startOfList list\n142\t* @return list\n143\t*/\n144\tstruct rangeElement* rangeAddSingle(uint32_t num, struct rangeElement* startOfList) {\n145\t  assert(num > 0);\n146\t  if (startOfList == NULL) {\n147\t    startOfList = rangeCreate();\n148\t    startOfList->start = num;\n149\t    startOfList->rangetype = SINGLE;\n150\t    return startOfList;\n151\t  }\n152\t  struct rangeElement* ptr = startOfList;\n153\t  //advance to the end of list\n154\t  while (ptr->next != NULL) {\n155\t    ptr = ptr->next;\n156\t  }\n157\t  ptr->next = rangeCreate();\n158\t  ptr = ptr->next;\n159\t  ptr->start = num;\n160\t  ptr->rangetype = SINGLE;\n161\t  return startOfList;\n162\t}\n163\t\n164\t/**\n165\t* format as string\n166\t*\n167\t* pass in the buffer\n168\t*\n169\t* @param buf buffer for output\n170\t* @param bufsize size of buffer\n171\t* @param element range element to format\n172\t* @return buf\n173\t*/\n174\tchar* rangeElementToString(char* buf, uint32_t bufsize, struct rangeElement* element) {\n175\t  assert(bufsize >= 0);\n176\t  assert(element != NULL);\n177\t  switch (element->rangetype) {\n178\t  case SINGLE:\n179\t    snprintf(buf, bufsize, \"[%d]\", element->start);\n180\t    return buf;\n181\t  case GREATEREQUAL:\n182\t    snprintf(buf, bufsize, \"[%d-]\", element->start);\n183\t    return buf;\n184\t  case STARTEND:\n185\t    snprintf(buf, bufsize, \"[%d-%d]\", element->start, element->end);\n186\t    return buf;\n187\t  case EMPTY:\n188\t    snprintf(buf, bufsize, \"[]\");\n189\t    return buf;\n190\t  default:\n191\t    return buf;\n192\t  }\n193\t}\n194\t\n195\t/**\n196\t* format range list as string\n197\t*\n198\t* pass in the buffer\n199\t*\n200\t* @param buf buffer for output\n201\t* @param bufsize size of buffer\n202\t* @param element range element to format\n203\t* @return buf\n204\t*/\n205\tchar* rangeListToString(char* buf, uint32_t bufsize, struct rangeElement* startOfList) {\n206\t  int tmpbufsize = 256;\n207\t  char tmpbuf[tmpbufsize];\n208\t  struct rangeElement* ptr = startOfList;\n209\t  //should I?\n210\t  memset(buf, 0, bufsize);\n211\t  int bufidx = 0;\n212\t  while (ptr != NULL) {\n213\t    memset(tmpbuf, 0, tmpbufsize);\n214\t    rangeElementToString(&tmpbuf[0], tmpbufsize, ptr);\n215\t    int tblen = sizeof(tmpbuf);\n216\t    // try not to buffer overflow\n217\t    int copylen = ( (tblen+bufidx) >= bufsize ? bufsize-bufidx : tblen);\n218\t    strncat(buf, tmpbuf, copylen);\n219\t    bufidx += copylen;\n220\t    ptr = ptr->next;\n221\t  }\n222\t  return buf;\n223\t}\n224\t\n225\t/**\n226\t* test if num in range\n227\t*\n228\t* @param num number to check\n229\t* @param startOfList range\n230\t* @return true if num in range\n231\t*/\n232\tbool rangeContainsNum(uint32_t num, struct rangeElement* startOfList) {\n233\t  assert(startOfList != NULL);\n234\t  assert(num >= 0);\n235\t  struct rangeElement* ptr = startOfList;\n236\t  while(true) {\n237\t    if (ptr->rangetype == SINGLE && ptr->start == num) {\n238\t      return true;\n239\t    }\n240\t    if (ptr->rangetype == GREATEREQUAL && num >= ptr->start) {\n241\t      return true;\n242\t    }\n243\t    if (ptr->rangetype == STARTEND && num >= ptr->start && num <= ptr->end) {\n244\t      return true;\n245\t    }\n246\t    ptr = ptr->next;\n247\t    if (ptr == NULL) {\n248\t      return false;\n249\t    }\n250\t  }\n251\t}\n252\t\n253\t/**\n254\t* parse a string to a range list\n255\t*\n256\t* @param text input string\n257\t* @return rangelist\n258\t*/\n259\tstruct rangeElement* parseIntRanges(const char* text) {\n260\t  int state = 0;\n261\t  int flag_dash = 0x01;\n262\t  int i;\n263\t  char numbuf[1024];\n264\t  int numbufi;\n265\t  struct rangeElement* rv = NULL;\n266\t  int start=0;\n267\t  int end=0;\n268\t  \n269\t  memset(numbuf, 0, sizeof(numbuf));\n270\t  numbufi = 0;\n271\t  \n272\t  for (i=0; i<strlen(text); i++) {\n273\t    if (text[i] >= '0' && text[i] <= '9') {\n274\t      numbuf[numbufi] = text[i];\n275\t      numbufi++;\n276\t    }\n277\t    else if (text[i] == '-') {\n278\t      if (state & flag_dash) {\n279\t\tfprintf(stderr, \"error: too many dashes in range\\n\");\n280\t\texit(-1);\n281\t      }\n282\t      state |= flag_dash;\n283\t      if (numbufi == 0) {\n284\t\t// nothing stored for start\n285\t\tfprintf(stderr, \"error: range cannot start with '-'\\n\");\n286\t\texit(-1);\n287\t      }\n288\t      start = atoi(numbuf);\n289\t      if (start <= 0) {\n290\t\tfprintf(stderr, \"error: start range <= 0\\n\");\n291\t\texit(-1);\n292\t      }\n293\t      memset(numbuf, 0, sizeof(numbuf));\n294\t      numbufi = 0;\n295\t    }\n296\t    else if (text[i] == ',') {\n297\t      if (numbufi == 0) {\n298\t\tif (flag_dash) {\n299\t\t  rv = rangeAddGreaterEqual(start, rv);\n300\t\t}\n301\t      }\n302\t      else if (start > 0) {\n303\t\tend = atoi(numbuf);\n304\t\tif (end <= 0 || start > end) {\n305\t\t  fprintf(stderr, \"error: illegal start/end ranges\\n\");\n306\t\t  exit(-1);\n307\t\t}\n308\t\trv = rangeAddStartEnd(start, end, rv);\n309\t      }\n310\t      else {\n311\t\tstart = atoi(numbuf);\n312\t\trv = rangeAddSingle(start, rv);\n313\t      }\n314\t      memset(numbuf, 0, sizeof(numbuf));\n315\t      numbufi = 0;\n316\t      start = 0;\n317\t      end = 0;\n318\t      state = 0;\n319\t    }\n320\t  }\n321\t  // finish up\n322\t  if (numbufi == 0) {\n323\t    if (flag_dash) {\n324\t      rv = rangeAddGreaterEqual(start, rv);\n325\t    }\n326\t  }\n327\t  else if (start > 0) {\n328\t    end = atoi(numbuf);\n329\t    if (end <= 0 || start > end) {\n330\t      fprintf(stderr, \"error: illegal start/end range %s\\n\", text);\n331\t      exit(-1);\n332\t    }\n333\t    rv = rangeAddStartEnd(start, end, rv);\n334\t  }\n335\t  else {\n336\t    start = atoi(numbuf);\n337\t    rv = rangeAddSingle(start, rv);\n338\t  }\n339\t  return rv;\n340\t}\n341\t"}]},"parent_tool_use_id":null,"session_id":"238755ec-dddd-43bf-8dca-73c60cd6cafb","uuid":"fad343ea-d10f-4091-9228-d7ecb5bc79c9","