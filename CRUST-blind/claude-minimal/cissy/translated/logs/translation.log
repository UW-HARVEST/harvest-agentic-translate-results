8\t\treturn rvDelim;\n259\t      }\n260\t      if (c=='\\r') {\n261\t\treturn rvStateEOL;\n262\t      }\n263\t      if (c=='\\n') {\n264\t\treturn rvStateEOL;\n265\t      }\n266\t      //if (buf[*end]=='\\n' && *end == buflen-1) {\n267\t      //\treturn rvStateEOL;\n268\t      //}\n269\t      //if (buf[*end]=='\\r' && *end == buflen-1) {\n270\t      //\treturn rvStateEOL;\n271\t      //}\n272\t      if (c=='\\0' && *end == buflen-1) {\n273\t\treturn rvStateEOL;\n274\t      }      \n275\t    }\n276\t  }\n277\t  return rvStateEOL;\n278\t}\n279\tint main(int argc, char** argv) {\n280\t  //init\n281\t  gpInput=stdin;\n282\t  gpOutput=stdout;\n283\t  gpDelimIn = ',';\n284\t  gpDelimOut = ',';\n285\t  gpQuoteIn = '\"';\n286\t  gpQuoteOut = '\"';\n287\t  gpEndLine = NULL;\n288\t  gpVerbose = 0;\n289\t\n290\t  \n291\t  int arginc = 1;\n292\t  while(arginc < argc) {\n293\t    debug(5, \"argc=(%d) arginc=(%d)  argv[arginc]=(%s)\\n\", argc, arginc, argv[arginc]);\n294\t    if (strcmp(argv[arginc], \"-i\")==0) {\n295\t      if (argc <= arginc+1) {\n296\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n297\t\treturn -1;\n298\t      }\n299\t      arginc++;\n300\t      debug(5, \"arg %s\\n\", argv[arginc]);\n301\t      gpInput = fopen(argv[arginc], \"r\");\n302\t      if (gpInput == NULL) {\n303\t\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n304\t\treturn -1;\n305\t      }\n306\t      arginc++;\n307\t    }\n308\t    else if (strcmp(argv[arginc], \"-o\")==0) {\n309\t      if (argc <= arginc+1) {\n310\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n311\t\treturn -1;\n312\t      }\n313\t      arginc++;\n314\t      debug(5, \"arg %s\\n\", argv[arginc]);\n315\t      gpOutput = fopen(argv[arginc], \"r\");\n316\t      if (gpOutput == NULL) {\n317\t\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n318\t\treturn -1;\n319\t      }\n320\t      arginc++;\n321\t    }\n322\t    else if (strcmp(argv[arginc], \"-d\")==0) {\n323\t      if (argc <= arginc+1) {\n324\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n325\t\treturn -1;\n326\t      }\n327\t      arginc++;\n328\t      if (strlen(argv[arginc]) != 1) {\n329\t\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n330\t\treturn -1;\n331\t      }\n332\t      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n333\t      gpDelimIn = argv[arginc][0];\n334\t      gpDelimOut = argv[arginc][0];\n335\t      arginc++;\n336\t    }\n337\t    else if (strcmp(argv[arginc], \"-di\")==0) {\n338\t      if (argc <= arginc+1) {\n339\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n340\t\treturn -1;\n341\t      }\n342\t      arginc++;\n343\t      if (strlen(argv[arginc]) != 1) {\n344\t\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n345\t\treturn -1;\n346\t      }\n347\t      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n348\t      gpDelimIn = argv[arginc][0];\n349\t      arginc++;\n350\t    }\n351\t    else if (strcmp(argv[arginc], \"-do\")==0) {\n352\t      if (argc <= arginc+1) {\n353\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n354\t\treturn -1;\n355\t      }\n356\t      arginc++;\n357\t      if (strlen(argv[arginc]) != 1) {\n358\t\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n359\t\treturn -1;\n360\t      }\n361\t      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n362\t      gpDelimOut = argv[arginc][0];\n363\t      arginc++;\n364\t    }\n365\t    else if (strcmp(argv[arginc], \"-q\")==0) {\n366\t      if (argc <= arginc+1) {\n367\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n368\t\treturn -1;\n369\t      }\n370\t      arginc++;\n371\t      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n372\t      gpQuoteIn = argv[arginc][0];\n373\t      arginc++;\n374\t    }\n375\t    else if (strcmp(argv[arginc], \"-qi\")==0) {\n376\t      if (argc <= arginc+1) {\n377\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n378\t\treturn -1;\n379\t      }\n380\t      arginc++;\n381\t      if (strlen(argv[arginc]) != 1) {\n382\t\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n383\t\treturn -1;\n384\t      }\n385\t      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n386\t      gpQuoteIn = argv[arginc][0];\n387\t      arginc++;\n388\t    }\n389\t    else if (strcmp(argv[arginc], \"-qo\")==0) {\n390\t      if (argc <= arginc+1) {\n391\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n392\t\treturn -1;\n393\t      }\n394\t      arginc++;\n395\t      if (strlen(argv[arginc]) != 1) {\n396\t\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n397\t\treturn -1;\n398\t      }\n399\t      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n400\t      gpQuoteOut = argv[arginc][0];\n401\t      arginc++;\n402\t    }\n403\t    else if (strcmp(argv[arginc], \"-eu\")==0) {\n404\t      gpEndLine = \"\\n\";\n405\t      arginc++;\n406\t    } \n407\t    else if (strcmp(argv[arginc], \"-ed\")==0) {\n408\t      gpEndLine = \"\\r\\n\";\n409\t      arginc++;\n410\t    }\n411\t    else if (strcmp(argv[arginc], \"-em\")==0) {\n412\t      gpEndLine = \"\\r\";\n413\t      arginc++;\n414\t    }     \n415\t    else if (strcmp(argv[arginc], \"-c\")==0) {\n416\t      if (argc <= arginc+1) {\n417\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n418\t\treturn -1;\n419\t      }\n420\t      arginc++;\n421\t      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n422\t      gpOutColumns = parseIntRanges(argv[arginc]);\n423\t      arginc++;\n424\t    }\n425\t    else if (strcmp(argv[arginc], \"-h\")==0) {\n426\t      usage(stdout);\n427\t      exit(0);\n428\t    }    \n429\t    else if (strcmp(argv[arginc], \"-v\")==0) {\n430\t      gpVerbose++;\n431\t      arginc++;\n432\t    }\n433\t    else if (strcmp(argv[arginc], \"-DDD\")==0) {\n434\t      gpVerbose += 100;\n435\t      arginc++;\n436\t    }\n437\t    else if (strcmp(argv[arginc], \"-b\")==0) {\n438\t      gpAllowBinaryFlag = true;\n439\t      arginc++;\n440\t    }\n441\t    else {\n442\t      fprintf(stderr, \"error: unknown switch (%s)\\n\", argv[arginc]);\n443\t      fclose(gpInput);\n444\t      fclose(gpOutput);\n445\t      return -1;\n446\t    }\n447\t  }\n448\t  debug(5, \"main: input delimiter(%c) output delimiter(%c)\\n\", gpDelimIn, gpDelimOut);\n449\t  debug(5, \"main: input quote(%c) output quote(%c)\\n\", gpQuoteIn, gpQuoteOut);\n450\t  char sbuf[1024]; //FIXME\n451\t  debug(5, \"main: OutputColumns = %s\\n\", rangeListToString(sbuf, sizeof(sbuf), gpOutColumns));\n452\t  debug(5, \"main:start\\n\");\n453\t    \n454\t  int psAccumFlag = 0x01;\n455\t  int psBeginFlag = 0x02;\n456\t  int psQuotedFlag = 0x04;\n457\t  \n458\t  int parseState = psBeginFlag;\n459\t  \n460\t  char colData[BUFSIZE];\n461\t  size_t colDataLen[MAXCOL];\n462\t  char* colPtr[MAXCOL];\n463\t  //init\n464\t  {\n465\t    memset(colData, 0, BUFSIZE);\n466\t    int i;\n467\t    for (i=0; i<MAXCOL; i++) {\n468\t      colPtr[i] = NULL;\n469\t      colDataLen[i] = 0;\n470\t    }\n471\t  }\n472\t  \n473\t  char* rawInput = NULL;\n474\t  size_t rawInputSize = 128;\n475\t  // getline malloc/realloc\n476\t  rawInput = malloc(rawInputSize);\n477\t  if (rawInput == NULL) {\n478\t    fprintf(stderr, \"main: rawInput malloc error\\n\");\n479\t    exit(-1);\n480\t  }\n481\t\n482\t  bool bdone = false;\n483\t  gLineCnt = 0;\n484\t\n485\t  while (! bdone) {\n486\t    struct csvline* cline = csvline_create();\n487\t    memset(rawInput, 0, rawInputSize);\n488\t    int c = getline(&rawInput, &rawInputSize, gpInput);\n489\t    gLineCnt++;\n490\t    debug(5, \"main: line(%d) read (%d) bytes\\n\", gLineCnt, c);\n491\t    if (c == -1 || c == 0) {\n492\t      debug(10, \"main: EOF\\n\");\n493\t      //EOF ... we're done\n494\t      fclose(gpInput);\n495\t      fclose(gpOutput);\n496\t      return 0;\n497\t    }\n498\t    int startIdx = 0;\n499\t    int fieldLen = 0;\n500\t    int bufsize = c - startIdx;\n501\t    bool bline = false;\n502\t\n503\t    int d=0;\n504\t    bool bInsideQuote = false;\n505\t    bool appendMode = false;\n506\t    while (!bline) {\n507\t      int parseState = getField(&rawInput[startIdx], bufsize-startIdx, &fieldLen, &bInsideQuote);\n508\t      debug(50, \"s(%d)e(%d) (%d)\\n\", startIdx, fieldLen, bInsideQuote);\n509\t      if (appendMode) {\n510\t\tcsvline_appendField(cline, rawInput, startIdx, fieldLen);\n511\t      }\n512\t      else {\n513\t\tcsvline_addField(cline, rawInput, startIdx, fieldLen);\n514\t      }\n515\t      startIdx += fieldLen;\n516\t      if (parseState == rvDelim) {\n517\t\tstartIdx++;\n518\t      }\n519\t      appendMode = bInsideQuote;\n520\t      if (parseState == rvStateEOL) {\n521\t\tif (bInsideQuote) {\n522\t\t  c = getline(&rawInput, &rawInputSize, gpInput);\n523\t\t  if (c == -1 || c == 0) {\n524\t\t    fprintf(stderr, \"error: unterminated quote\\n\");\n525\t\t    fclose(gpInput);\n526\t\t    fclose(gpOutput);\n527\t\t    exit(-1);\n528\t\t  }\n529\t\t  //reset line\n530\t\t  startIdx = 0;\n531\t\t  fieldLen = 0;\n532\t\t  bufsize = c - startIdx;\n533\t\t}\n534\t\telse {\n535\t\t  bline=true;\n536\t\t}\n537\t      }\n538\t    }\n539\t    if (gpVerbose > 2) {\n540\t      csvline_printToFile(cline, stderr);\n541\t    }\n542\t    outputLine(cline);\n543\t  }\n544\t  return 0;\n545\t}\n546\t\n547\t"}]},"parent_tool_use_id":null,"session_id":"238755ec-dddd-43bf-8dca-73c60cd6cafb","uuid":"8e235482-f868-4320-98cc-994856c77562","timestamp":"2026-06-02T01:53:26.684Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-99BhsE/project/c_src/src/cissy.c","content":"/*\n   Copyright 2015 Steven Lass\n\n   Licensed under the Apache License, Version 2.0 (the \"License\");\n   you may not use this file except in compliance with the License.\n   You may obtain a copy of the License at\n\n       http://www.apache.org/licenses/LICENSE-2.0\n\n   Unless required by applicable law or agreed to in writing, software\n   distributed under the License is distributed on an \"AS IS\" BASIS,\n   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n   See the License for the specific language governing permissions and\n   limitations under the License.\n*/\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdarg.h>\n#include <assert.h>\n#include <stdbool.h>\n#include <limits.h>\n\n#include \"range.h\"\n#include \"csvline.h\"\n\n#define BUFSIZE 4096\n#define MAXCOL 1024\n\n\n// Globals\nint32_t gLineCnt;\n\n//Global parameters\nFILE* gpInput;\nFILE* gpOutput;\nchar gpDelimIn;\nchar gpDelimOut;\nchar gpQuoteIn;\nchar gpQuoteOut;\nchar* gpEndLine;\nbool gpAllowBinaryFlag = false;\nint gpVerbose;\nstruct rangeElement* gpOutColumns = NULL;\n\nint rvStateNormal = 0;\nint rvStateMultiline = 0x01;\nint rvStateEOL = 0x02;\nint rvDelim = 0x04;\n\nvoid outputLine(struct csvline* cline);\n\nvoid usage(FILE* fp) {\n  char* help =\n    \"cissy [options]\\n\" \n    \"\\t-i <inputfile>\\t\\t (defaults to stdin)\\n\" \n    \"\\t-o <outputfile>\\t\\t (defaults to stdout)\\n\" \n    \"\\n\"\n    \"\\t-c <columns>\\t\\t specify columns to output eg. [2][5-8][12-]\\n\"\n    \"\\t-d <delimiter>\\t\\t set the input and output delimiter\\n\"\n    \"\\t\\t\\t\\t defaults to ','\\n\"\n    \"\\t-di <input delimiter>\\t set the input delimiter\\n\" \n    \"\\t-do <output delimiter>\\t set the output delimiter\\n\"\n    \"\\n\"\n    \"\\t-q <quote character>\\t defaults to \\\"\\n\"\n    \"\\t-qi <quote input character>\\n\"\n    \"\\t-qo <quote output character>\\n\"\n    \"\\n\"\n    \"\\t-ed \\t\\t\\t dos end of line \\\\r\\\\n\\n\"\n    \"\\t-eu \\t\\t\\t unix end of line \\\\n\\n\"\n    \"\\t-em \\t\\t\\t mac end of line \\\\r\\n\"\n    \"\\n\"    \n    \"\\t-b \\t\\t\\t allow binary data\\n\"\n    \"\\t-v \\t\\t\\t send processing info to stderr\\n\"\n    \"\\t-h \\t\\t\\t help\\n\"\n    \"\"\n    ;\n  fprintf(fp, help, NULL);\n}\n\nvoid debug(int level, char* fmt, ...) {\n  if (level <= gpVerbose) {\n    va_list args;\n    va_start(args, fmt);\n    vfprintf(stderr, fmt, args);\n    va_end(args);\n  }\n}\n\nbool isBinChar(char c) {\n  switch(c) {\n  case 1 ... 8:\n  case 11:\n  case 12:\n  case 14 ... 26:\n  case 28 ... 31:\n  case 127:\n    return true;\n  }\n  return false;\n}\n\n/*\n *  Change quote char if needed.\n */\nvoid formatOutput(char** str) {\n  debug(100, \"formatOutput:start\\n\");\n  if (gpQuoteIn == gpQuoteOut) {\n    return;\n  }\n  int slen = strlen(*str);\n  if (slen < 2) {\n    return;\n  }\n  debug(100, \"formatOutput:slen(%d)\\n\", slen);\n  debug(100, \"formatOutput:str[%d](%c) str[%d](%c)\\n\", 0, (*str)[0], slen-1, (*str)[2]);\n  if ((*str)[0] == gpQuoteIn && (*str)[slen-1] == gpQuoteIn) {\n    // modify in place for efficiency\n    debug(100, \"formatOutput:quoted\\n\");\n    (*str)[0] = gpQuoteOut;\n    (*str)[slen-1] = gpQuoteOut;\n  }\n  \n  return;\n}\n\nvoid outputLine(struct csvline* cline) {\n  debug(50,\"outputLine:start\\n\");\n  if (cline == NULL) return;\n  if (gpOutColumns == NULL) { // print all\n    debug(50,\"outputLine:printall\\n\");\n    int fieldcnt = csvline_getFieldCnt(cline);\n    int i;\n    for (i=0; i<fieldcnt; i++) {\n      char* str = csvline_getField(cline,i);\n      formatOutput(&str);\n      fprintf(gpOutput, \"%s\", str);\n      if ( (i+1) != fieldcnt) {\n\tfprintf(gpOutput, \"%c\", gpDelimOut);\n      }\n    }    \n  }\n  else {\n    debug(50,\"outputLine:printranges\\n\");\n    struct rangeElement* list = gpOutColumns;\n    int colCnt = csvline_getFieldCnt(cline);\n    do {\n      switch (list->rangetype) {\n      case EMPTY:\n\tbreak;\n      case SINGLE:\n\tdebug(50,\"outputLine:single(%d)\\n\", list->start);\n\tchar* str = csvline_getField(cline,list->start - 1);\n\tformatOutput(&str);\n\tif (strlen(str) == 0) {\n\t  //don't print (null)\n\t}\n\telse {\n\t  fprintf(gpOutput, \"%s\",str);\n\t}\n\tif (list->next != NULL) {\n\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n\t}\n\tbreak;\n      case STARTEND:\n\tdebug(50,\"outputLine:startend (%d - %d)\\n\", list->start, list->end);\n\t{\n\t  int i=0;\n\t  char* str = NULL;\n\t  for (i=list->start - 1; (i+1) < list->end; i++) {\n\t    str = csvline_getField(cline,i);\n\t    formatOutput(&str);\n\t    if (strlen(str) == 0) {\n\t      fprintf(gpOutput, \"%c\", gpDelimOut);\n\t    }\n\t    else {\n\t      fprintf(gpOutput, \"%s%c\", str, gpDelimOut);\n\t    }\n\t  }\n\t  int last = list->end - 1;\n\t  if (last >= colCnt) {\n\t    break;\n\t  }\n\t  str = csvline_getField(cline, last);\n\t  formatOutput(&str);\n\t  if (strlen(str) == 0) {\n\t  }\n\t  else {\n\t    fprintf(gpOutput, \"%s\",str);\n\t  }\n\t}\n\tif (list->next != NULL) {\n\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n\t}\n\tbreak;\n      case GREATEREQUAL:\n\tdebug(50,\"outputLine:greaterequal\\n\");\n\t{\n\t  int i;\n\t  char* str = \"\";\n\t  for (i=list->start - 1; (i+1)<colCnt; i++) {\n\t    str =  csvline_getField(cline,i);\n\t    formatOutput(&str);\n\t    if (strlen(str) == 0) {\n\t    }\n\t    else {\n\t      fprintf(gpOutput, \"%s%c\", str, gpDelimOut);\n\t    }\n\t  }\n\t  int last = colCnt - 1;\n\t  str =  csvline_getField(cline,last);\n\t  formatOutput(&str);\n\t  if (strlen(str) == 0) {\n\t  }\n\t  else {\n\t    fprintf(gpOutput, \"%s\",str);\n\t  }\n\t}\n\tif (list->next != NULL) {\n\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n\t}\n\tbreak;\n      default:\n\tdebug(50,\"outputLine:default (error)\\n\");\n\tbreak;\n      }\n      list = list->next;\n    }\n    while (list != NULL);\n  }\n  fprintf(gpOutput, \"%s\", (gpEndLine == NULL ? cline->eolStr : gpEndLine));\n  debug(50,\"outputLine:end\\n\");\n  return;\n}\n\n// find field\n// return state\nint getField(char* buf, int buflen, int* end, bool* inQuoted) {\n  bool bquoted = *inQuoted;\n  for (*end=0; *end<buflen; *end += 1) {\n    char c = buf[*end];\n    //debug(50, \"char(%c)(%d)(%d)(%d)\\n\", c, (int)c, *end, buflen);\n    if (!gpAllowBinaryFlag && isBinChar(c)) {\n      fprintf(stderr, \"error: line(%d): binary character (%d) found.  Use flag to ignore/pass\\n\", gLineCnt, (int)c);\n      exit(-1);\n    }\n    if (*inQuoted) {\n      if (c==gpQuoteIn) {\n\t*inQuoted=false;\n      }\n    }\n    else {\n      if (c==gpQuoteIn) {\n\t*inQuoted=true;\n      }\n      if (c==gpDelimIn) {\n\treturn rvDelim;\n      }\n      if (c=='\\r') {\n\treturn rvStateEOL;\n      }\n      if (c=='\\n') {\n\treturn rvStateEOL;\n      }\n      //if (buf[*end]=='\\n' && *end == buflen-1) {\n      //\treturn rvStateEOL;\n      //}\n      //if (buf[*end]=='\\r' && *end == buflen-1) {\n      //\treturn rvStateEOL;\n      //}\n      if (c=='\\0' && *end == buflen-1) {\n\treturn rvStateEOL;\n      }      \n    }\n  }\n  return rvStateEOL;\n}\nint main(int argc, char** argv) {\n  //init\n  gpInput=stdin;\n  gpOutput=stdout;\n  gpDelimIn = ',';\n  gpDelimOut = ',';\n  gpQuoteIn = '\"';\n  gpQuoteOut = '\"';\n  gpEndLine = NULL;\n  gpVerbose = 0;\n\n  \n  int arginc = 1;\n  while(arginc < argc) {\n    debug(5, \"argc=(%d) arginc=(%d)  argv[arginc]=(%s)\\n\", argc, arginc, argv[arginc]);\n    if (strcmp(argv[arginc], \"-i\")==0) {\n      if (argc <= arginc+1) {\n\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      arginc++;\n      debug(5, \"arg %s\\n\", argv[arginc]);\n      gpInput = fopen(argv[arginc], \"r\");\n      if (gpInput == NULL) {\n\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n\treturn -1;\n      }\n      arginc++;\n    }\n    else if (strcmp(argv[arginc], \"-o\")==0) {\n      if (argc <= arginc+1) {\n\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      arginc++;\n      debug(5, \"arg %s\\n\", argv[arginc]);\n      gpOutput = fopen(argv[arginc], \"r\");\n      if (gpOutput == NULL) {\n\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n\treturn -1;\n      }\n      arginc++;\n    }\n    else if (strcmp(argv[arginc], \"-d\")==0) {\n      if (argc <= arginc+1) {\n\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      arginc++;\n      if (strlen(argv[arginc]) != 1) {\n\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n      gpDelimIn = argv[arginc][0];\n      gpDelimOut = argv[arginc][0];\n      arginc++;\n    }\n    else if (strcmp(argv[arginc], \"-di\")==0) {\n      if (argc <= arginc+1) {\n\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      arginc++;\n      if (strlen(argv[arginc]) != 1) {\n\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n      gpDelimIn = argv[arginc][0];\n      arginc++;\n    }\n    else if (strcmp(argv[arginc], \"-do\")==0) {\n      if (argc <= arginc+1) {\n\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      arginc++;\n      if (strlen(argv[arginc]) != 1) {\n\tfprintf(stderr, \"error: only single character delimiters allowed: '%s'\\n\", argv[arginc]);\n\treturn -1;\n      }\n      debug(5, \"arg %s %d\\n\", argv[arginc], strlen(argv[arginc]));\n      gpDelimOut = argv[arginc][0];\n      arginc++;\n    }\n    else if (strcmp(argv[arginc], \"-q\")==0) {\n      if (argc <= arginc+1) {\n\tfprintf(stderr, \"error