\\t\\t defaults to ','\\n\"\n63\t    \"\\t-di <input delimiter>\\t set the input delimiter\\n\" \n64\t    \"\\t-do <output delimiter>\\t set the output delimiter\\n\"\n65\t    \"\\n\"\n66\t    \"\\t-q <quote character>\\t defaults to \\\"\\n\"\n67\t    \"\\t-qi <quote input character>\\n\"\n68\t    \"\\t-qo <quote output character>\\n\"\n69\t    \"\\n\"\n70\t    \"\\t-ed \\t\\t\\t dos end of line \\\\r\\\\n\\n\"\n71\t    \"\\t-eu \\t\\t\\t unix end of line \\\\n\\n\"\n72\t    \"\\t-em \\t\\t\\t mac end of line \\\\r\\n\"\n73\t    \"\\n\"    \n74\t    \"\\t-b \\t\\t\\t allow binary data\\n\"\n75\t    \"\\t-v \\t\\t\\t send processing info to stderr\\n\"\n76\t    \"\\t-h \\t\\t\\t help\\n\"\n77\t    \"\"\n78\t    ;\n79\t  fprintf(fp, help, NULL);\n80\t}\n81\t\n82\tvoid debug(int level, char* fmt, ...) {\n83\t  if (level <= gpVerbose) {\n84\t    va_list args;\n85\t    va_start(args, fmt);\n86\t    vfprintf(stderr, fmt, args);\n87\t    va_end(args);\n88\t  }\n89\t}\n90\t\n91\tbool isBinChar(char c) {\n92\t  switch(c) {\n93\t  case 1 ... 8:\n94\t  case 11:\n95\t  case 12:\n96\t  case 14 ... 26:\n97\t  case 28 ... 31:\n98\t  case 127:\n99\t    return true;\n100\t  }\n101\t  return false;\n102\t}\n103\t\n104\t/*\n105\t *  Change quote char if needed.\n106\t */\n107\tvoid formatOutput(char** str) {\n108\t  debug(100, \"formatOutput:start\\n\");\n109\t  if (gpQuoteIn == gpQuoteOut) {\n110\t    return;\n111\t  }\n112\t  int slen = strlen(*str);\n113\t  if (slen < 2) {\n114\t    return;\n115\t  }\n116\t  debug(100, \"formatOutput:slen(%d)\\n\", slen);\n117\t  debug(100, \"formatOutput:str[%d](%c) str[%d](%c)\\n\", 0, (*str)[0], slen-1, (*str)[2]);\n118\t  if ((*str)[0] == gpQuoteIn && (*str)[slen-1] == gpQuoteIn) {\n119\t    // modify in place for efficiency\n120\t    debug(100, \"formatOutput:quoted\\n\");\n121\t    (*str)[0] = gpQuoteOut;\n122\t    (*str)[slen-1] = gpQuoteOut;\n123\t  }\n124\t  \n125\t  return;\n126\t}\n127\t\n128\tvoid outputLine(struct csvline* cline) {\n129\t  debug(50,\"outputLine:start\\n\");\n130\t  if (cline == NULL) return;\n131\t  if (gpOutColumns == NULL) { // print all\n132\t    debug(50,\"outputLine:printall\\n\");\n133\t    int fieldcnt = csvline_getFieldCnt(cline);\n134\t    int i;\n135\t    for (i=0; i<fieldcnt; i++) {\n136\t      char* str = csvline_getField(cline,i);\n137\t      formatOutput(&str);\n138\t      fprintf(gpOutput, \"%s\", str);\n139\t      if ( (i+1) != fieldcnt) {\n140\t\tfprintf(gpOutput, \"%c\", gpDelimOut);\n141\t      }\n142\t    }    \n143\t  }\n144\t  else {\n145\t    debug(50,\"outputLine:printranges\\n\");\n146\t    struct rangeElement* list = gpOutColumns;\n147\t    int colCnt = csvline_getFieldCnt(cline);\n148\t    do {\n149\t      switch (list->rangetype) {\n150\t      case EMPTY:\n151\t\tbreak;\n152\t      case SINGLE:\n153\t\tdebug(50,\"outputLine:single(%d)\\n\", list->start);\n154\t\tchar* str = csvline_getField(cline,list->start - 1);\n155\t\tformatOutput(&str);\n156\t\tif (strlen(str) == 0) {\n157\t\t  //don't print (null)\n158\t\t}\n159\t\telse {\n160\t\t  fprintf(gpOutput, \"%s\",str);\n161\t\t}\n162\t\tif (list->next != NULL) {\n163\t\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n164\t\t}\n165\t\tbreak;\n166\t      case STARTEND:\n167\t\tdebug(50,\"outputLine:startend (%d - %d)\\n\", list->start, list->end);\n168\t\t{\n169\t\t  int i=0;\n170\t\t  char* str = NULL;\n171\t\t  for (i=list->start - 1; (i+1) < list->end; i++) {\n172\t\t    str = csvline_getField(cline,i);\n173\t\t    formatOutput(&str);\n174\t\t    if (strlen(str) == 0) {\n175\t\t      fprintf(gpOutput, \"%c\", gpDelimOut);\n176\t\t    }\n177\t\t    else {\n178\t\t      fprintf(gpOutput, \"%s%c\", str, gpDelimOut);\n179\t\t    }\n180\t\t  }\n181\t\t  int last = list->end - 1;\n182\t\t  if (last >= colCnt) {\n183\t\t    break;\n184\t\t  }\n185\t\t  str = csvline_getField(cline, last);\n186\t\t  formatOutput(&str);\n187\t\t  if (strlen(str) == 0) {\n188\t\t  }\n189\t\t  else {\n190\t\t    fprintf(gpOutput, \"%