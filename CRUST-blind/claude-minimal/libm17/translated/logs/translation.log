\n51\t\tuint8_t ud[144+4+4];\t//unpacked data\n52\t\n53\t\tmemset(ud, 0, 144+4+4);\n54\t\n55\t\t//unpack frame number\n56\t\tfor(uint8_t i=0; i<16; i++)\n57\t\t{\n58\t\t\tud[4+i]=(fn>>(15-i))&1;\n59\t\t}\n60\t\n61\t\t//unpack data\n62\t\tfor(uint8_t i=0; i<16; i++)\n63\t\t{\n64\t\t\tfor(uint8_t j=0; j<8; j++)\n65\t\t\t{\n66\t\t\t\tud[4+16+i*8+j]=(in[i]>>(7-j))&1;\n67\t\t\t}\n68\t\t}\n69\t\n70\t\t//encode\n71\t\tfor(uint8_t i=0; i<144+4; i++)\n72\t\t{\n73\t\t\tuint8_t G1=(ud[i+4]                +ud[i+1]+ud[i+0])%2;\n74\t        uint8_t G2=(ud[i+4]+ud[i+3]+ud[i+2]        +ud[i+0])%2;\n75\t\n76\t\t\t//printf(\"%d%d\", G1, G2);\n77\t\n78\t\t\tif(puncture_pattern_2[p])\n79\t\t\t{\n80\t\t\t\tout[pb]=G1;\n81\t\t\t\tpb++;\n82\t\t\t}\n83\t\n84\t\t\tp++;\n85\t\t\tp%=pp_len;\n86\t\n87\t\t\tif(puncture_pattern_2[p])\n88\t\t\t{\n89\t\t\t\tout[pb]=G2;\n90\t\t\t\tpb++;\n91\t\t\t}\n92\t\n93\t\t\tp++;\n94\t\t\tp%=pp_len;\n95\t\t}\n96\t\n97\t\t//printf(\"pb=%d\\n\", pb);\n98\t}\n99\t\n100\t/**\n101\t * @brief Encode M17 packet frame using convolutional encoder with puncturing.\n102\t *\n103\t * @param out Output array, unpacked.\n104\t * @param in Input - packed array of uint8_t, 206 type-1 bits.\n105\t */\n106\tvoid conv_encode_packet_frame(uint8_t* out, const uint8_t* in)\n107\t{\n108\t\tuint8_t pp_len = sizeof(puncture_pattern_3);\n109\t\tuint8_t p=0;\t\t\t//puncturing pattern index\n110\t\tuint16_t pb=0;\t\t\t//pushed punctured bits\n111\t\tuint8_t ud[206+4+4];\t//unpacked data\n112\t\n113\t\tmemset(ud, 0, 206+4+4);\n114\t\n115\t\t//unpack data\n116\t\tfor(uint8_t i=0; i<26; i++)\n117\t\t{\n118\t\t\tfor(uint8_t j=0; j<8; j++)\n119\t\t\t{\n120\t            if(i<=24 || j<=5)\n121\t                ud[4+i*8+j]=(in[i]>>(7-j))&1;\n122\t\t\t}\n123\t\t}\n124\t\n125\t\t//encode\n126\t\tfor(uint8_t i=0; i<206+4; i++)\n127\t\t{\n128\t\t\tuint8_t G1=(ud[i+4]                +ud[i+1]+ud[i+0])%2;\n129\t        uint8_t G2=(ud[i+4]+ud[i+3]+ud[i+2]        +ud[i+0])%2;\n130\t\n131\t\t\t//fprintf(st