(rand_seq[i/8]>>(7-(i%8)))&1) //flip bit if '1'\n86\t        {\n87\t            if(inp[i])\n88\t                inp[i]=0;\n89\t            else\n90\t                inp[i]=1;\n91\t        }\n92\t    }\n93\t}\n94\t\n95\t/**\n96\t * @brief Randomize type-4 soft bits.\n97\t * \n98\t * @param inp Input 368 soft type-4 bits.\n99\t */\n100\tvoid randomize_soft_bits(uint16_t inp[SYM_PER_PLD*2])\n101\t{\n102\t    for(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n103\t    {\n104\t        if((rand_seq[i/8]>>(7-(i%8)))&1) //flip bit if '1'\n105\t        {\n106\t            inp[i]=soft_bit_NOT(inp[i]);\n107\t        }\n108\t    }\n109\t}\n110\t\n111\t//-------------------------------\n112\t// M17 C library - phy/slice.c\n113\t//\n114\t// Wojciech Kaczmarski, SP5WWP\n115\t// M17 Project, 14 January 2024\n116\t//-------------------------------\n117\t\n118\t/**\n119\t * @brief Slice payload symbols into soft dibits.\n120\t * Input (RRC filtered baseband sampled at symbol centers)\n121\t * should be already normalized to {-3, -1, +1 +3}.\n122\t * @param out Soft valued dibits (type-4).\n123\t * @param inp Array of 184 floats (1 sample per symbol).\n124\t */\n125\tvoid slice_symbols(uint16_t out[2*SYM_PER_PLD], const float inp[SYM_PER_PLD])\n126\t{\n127\t    for(uint8_t i=0; i<SYM_PER_PLD; i++)\n128\t    {\n129\t        //bit 0\n130\t        if(inp[i]>=symbol_list[3])\n131\t        {\n132\t            out[i*2+1]=0xFFFF;\n133\t        }\n134\t        else if(inp[i]>=symbol_list[2])\n135\t        {\n136\t            out[i*2+1]=-(float)0xFFFF/(symbol_list[3]-symbol_list[2])*symbol_list[2]+inp[i]*(float)0xFFFF/(symbol_list[3]-symbol_list[2]);\n137\t        }\n138\t        else if(inp[i]>=symbol_list[1])\n139\t        {\n140\t            out[i*2+1]=0x0000;\n141\t        }\n142\t        else if(inp[i]>=symbol_list[0])\n143\t        {\n144\t            out[i*2+1]=(float)0xFFFF/(symbol_list[1]-symbol_list[0])*symbol_list[1]-inp[i]*(float)0xFFFF/(symbol_list[1]-symbol_list[0]);\n145\t        }\n146\t        else\n147\t        {\n148\t            out[i*2+1]=0xFFFF;\n149\t        }\n150\t\n151\t        //bit 1\n152\t        if(inp[i]>=symbol_list[2])\n153\t        {\n154\t            out[i*2]=0x0000;\n155\t        }\n156\t        else if(inp[i]>=symbol_list[1])\n157\t        {\n158\t            out[i*2]=0x7FFF-inp[i]*(float)0xFFFF/(symbol_list[2]-symbol_list[1]);\n159\t        }\n160\t        else\n161\t        {\n162\t            out[i*2]=0xFFFF;\n163\t        }\n164\t    }\n165\t}\n166\t\n167\t//--------------------------------------------------------------------\n168\t// M17 C library - phy/sync.c\n169\t//\n170\t// Wojciech Kaczmarski, SP5WWP\n171\t// M17 Project, 29 December 2023\n172\t//--------------------------------------------------------------------\n173\t\n174\t//syncwords\n175\tconst uint16_t SYNC_LSF = 0x55F7;\n176\tconst uint16_t SYNC_STR = 0xFF5D;\n177\tconst uint16_t SYNC_PKT = 0x75FF;\n178\tconst uint16_t SYNC_BER = 0xDF55;\n179\tconst uint16_t EOT_MRKR = 0x555D;\n180\t"}]},"parent_tool_use_id":null,"session_id":"1a56645c-d3cb-4018-a8ef-d9b023c74b1e","uuid":"94b8b63c-f03c-4e60-9b48-7e612eaf0604","timestamp":"2026-06-02T03:07:54.753Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-RBB0d1/project/c_src/phy/phy.c","content":"//-------------------------------\n// M17 C library - phy/interleave.c\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 28 December 2023\n//-------------------------------\n\n#include <m17.h>\n\n//interleaver pattern\nconst uint16_t intrl_seq[SYM_PER_PLD*2]=\n{\n\t0, 137, 90, 227, 180, 317, 270, 39, 360, 129, 82, 219, 172, 309, 262, 31,\n\t352, 121, 74, 211, 164, 301, 254, 23, 344, 113, 66, 203, 156, 293, 246, 15,\n\t336, 105, 58, 195, 148, 285, 238, 7, 328, 97, 50, 187, 140, 277, 230, 367,\n\t320, 89, 42, 179, 132, 269, 222, 359, 312, 81, 34, 171, 124, 261, 214, 351,\n\t304, 73, 26, 163, 116, 253, 206, 343, 296, 65, 18, 155, 108, 245, 198, 335,\n\t288, 57, 10, 147, 100, 237, 190, 327