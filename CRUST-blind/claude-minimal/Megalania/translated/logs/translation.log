{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_ozgquzthtzmflm5ibqgdebe7a366w5giuv4fvnxurocqlcdcfkeq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01GxFdeoMp5VpsTvF6NS9WAt","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-cB1zbN/project/src/max_heap.rs","content":"pub struct MaxHeap {\n    capacity: usize,\n    data: Vec<u32>,\n    comparator: Box<dyn Fn(u32, u32) -> i32>,\n}\nimpl MaxHeap {\n    pub fn new(capacity: usize, comparator: Box<dyn Fn(u32, u32) -> i32>) -> Self {\n        Self {\n            capacity,\n            data: Vec::with_capacity(capacity),\n            comparator,\n        }\n    }\n    pub fn count(&self) -> usize {\n        self.data.len()\n    }\n    pub fn clear(&mut self) {\n        self.data.clear();\n    }\n    fn heapify_up(&mut self, mut idx: usize) {\n        while idx > 0 {\n            let parent = (idx - 1) / 2;\n            if (self.comparator)(self.data[idx], self.data[parent]) > 0 {\n                self.data.swap(idx, parent);\n                idx = parent;\n            } else {\n                break;\n            }\n        }\n    }\n    fn heapify_down(&mut self, mut idx: usize) {\n        let n = self.data.len();\n        loop {\n            let left = idx * 2 + 1;\n            if left >= n {\n                break;\n            }\n            let right = idx * 2 + 2;\n            let mut largest_child = left;\n            if right < n\n                && (self.comparator)(self.data[right], self.data[left]) > 0\n            {\n                largest_child = right;\n            }\n            if (self.comparator)(self.data[largest_child], self.data[idx]) > 0 {\n                self.data.swap(largest_child, idx);\n                idx = largest_child;\n            } else {\n                break;\n            }\n        }\n    }\n    pub fn insert(&mut self, value: u32) -> bool {\n        if self.data.len() == self.capacity {\n            return false;\n        }\n        let new_node = self.data.len();\n        self.data.push(value);\n        self.heapify_up(new_node);\n        true\n    }\n    pub fn maximum(&self) -> Option<u32> {\n        self.data.first().copied()\n    }\n    pub fn remove_maximum(&mut self) -> bool {\n        if self.data.is_empty() {\n            return false;\n        }\n        let last = self.data.pop().unwrap();\n        if !self.data.is_empty() {\n            self.data[0] = last;\n            self.heapify_down(0);\n        }\n        true\n    }\n    /// Assumes that the element at index 0 may have changed.\n    pub fn update_maximum(&mut self) -> bool {\n        if self.data.is_empty() {\n            return false;\n        }\n        self.heapify_down(0);\n        true\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2383,"cache_read_input_tokens":62237,"cache_creation":{"ephemeral_5m_input_tokens":2383,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"16ff3e6c-7949-4723-8f87-eb2a50ddcdf1","uuid":"f18b8ce9-8952-4e7b-b916-1a1592f20e43"}
