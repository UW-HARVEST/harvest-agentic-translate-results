 TOK_FLOAT:\n926\t            stack[++top].f = node->tok.f;\n927\t            break;\n928\t        case TOK_VAR:\n929\t            die_unless(input_vector,\n930\t                       \"Input required but not provided for \"\n931\t                       \"expression evaluation.\\n\");\n932\t            {\n933\t                int idx = ((node->history_index + expr->history_pos\n934\t                            + expr->history_size) % expr->history_size);\n935\t                switch (node->tok.var) {\n936\t                case 'x':\n937\t                    idx = idx * expr->vector_size + node->vector_index;\n938\t                    stack[++top] = expr->input_history[idx];\n939\t                    break;\n940\t                case 'y':\n941\t                    stack[++top] = expr->output_history[idx];\n942\t                    break;\n943\t                default: goto error;\n944\t                }\n945\t            }\n946\t            break;\n947\t        case TOK_TOFLOAT:\n948\t            stack[top].f = (float)stack[top].i32;\n949\t            break;\n950\t        case TOK_TOINT32:\n951\t            stack[top].i32 = (int)stack[top].f;\n952\t            break;\n953\t        case TOK_OP:\n954\t            right = stack[top--];\n955\t            left = stack[top--];\n956\t            if (node->is_float) {\n957\t                trace_eval(\"%f %c %f = \", left.f, node->tok.op, right.f);\n958\t                switch (node->tok.op) {\n959\t                case '+': stack[++top].f = left.f + right.f; break;\n960\t                case '-': stack[++top].f = left.f - right.f; break;\n961\t                case '*': stack[++top].f = left.f * right.f; break;\n962\t                case '/': stack[++top].f = left.f / right.f; break;\n963\t                default: goto error;\n964\t                }\n965\t                trace_eval(\"%f\\n\", stack[top].f);\n966\t            } else {\n967\t                trace_eval(\"%d %c %d = \", left.i32, node->tok.op, right.i32);\n968\t                switch (node->tok.op) {\n969\t                case '+': stack[++top].i32 = left.i32 + right.i32; break;\n970\t                case '-': stack[++top].i32 = left.i32 - right.i32; break;\n971\t                case '*': stack[++top].i32 = left.i32 * right.i32; break;\n972\t                case '/': stack[++top].i32 = left.i32 / right.i32; break;\n973\t                default: goto error;\n974\t                }\n975\t                trace_eval(\"%d\\n\", stack[top].i32);\n976\t            }\n977\t            break;\n978\t        case TOK_FUNC:\n979\t            switch (function_table[node->tok.func].arity) {\n980\t            case 0:\n981\t                stack[++top].f = ((func_float_arity0*)function_table[node->tok.func].func)();\n982\t                trace_eval(\"%s = %f\\n\", function_table[node->tok.func].name,\n983\t                           stack[top].f);\n984\t                break;\n985\t            case 1:\n986\t                right = stack[top--];\n987\t                trace_eval(\"%s(%f) = \", function_table[node->tok.func].name, right.f);\n988\t                right.f = ((func_float_arity1*)function_table[node->tok.func].func)(right.f);\n989\t                trace_eval(\"%f\\n\", right.f);\n990\t                stack[++top].f = right.f;\n991\t                break;\n992\t            case 2:\n993\t                right = stack[top--];\n994\t                left = stack[top--];\n995\t                trace_eval(\"%s(%f,%f) = \", function_table[node->tok.func].name, left.f, right.f);\n996\t                right.f = ((func_float_arity2*)function_table[node->tok.func].func)(left.f, right.f);\n997\t                trace_eval(\"%f\\n\", right.f);\n998\t                stack[++top].f = right.f;\n999\t                break;\n1000\t            default: goto error;\n1001\t            }\n1002\t            break;\n1003\t        default: goto error;\n1004\t        }\n1005\t        node = node->next;\n1006\t    }\n1007\t\n1008\t    if (input_vector)\n100