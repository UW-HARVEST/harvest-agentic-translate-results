);\n    run_source(\"complex\", \"let a = 1 + 2 + 3 - 4 + 5;\");\n    run_source(\"identifier_in_expr\", \"let a = 10; let b = a + 5;\");\n    run_source(\"zero\", \"let z = 0;\");\n    run_source(\"repeated_identifier\", \"let a = 7; a = a + 1;\");\n    return 0;\n}\n","structuredPatch":[{"oldStart":87,"oldLines":5,"newStart":87,"newLines":10,"lines":["     run_source(\"identifier_in_expr\", \"let a = 10; let b = a + 5;\");","     run_source(\"zero\", \"let z = 0;\");","     run_source(\"repeated_identifier\", \"let a = 7; a = a + 1;\");","+    run_source(\"reassign_after_other\", \"let a = 1; let b = 2; a = 3;\");","+    run_source(\"dis_only_const\", \"dis 100;\");","+    run_source(\"multi_dis\", \"let x = 5; dis x; dis x;\");","+    run_source(\"subtract_only\", \"let x = 100 - 50;\");","+    run_source(\"two_let_same\", \"let x = 1; let x = 2;\");","     return 0;"," }"]}],"userModified":false,"replaceAll":false}}
