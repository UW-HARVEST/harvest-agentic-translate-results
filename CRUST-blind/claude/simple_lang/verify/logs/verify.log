dis\");\n    assert_eq!(t.token_type, TokenType::TOKEN_DIS);\n    assert_eq!(t.value, \"dis\");\n}\n\n#[test]\nfn test_token_clone() {\n    let t = new_token(TokenType::TOKEN_INT, \"100\");\n    let c: Token = t.clone();\n    assert_eq!(c.token_type, TokenType::TOKEN_INT);\n    assert_eq!(c.value, \"100\");\n}\n\n#[test]\nfn test_free_token_no_panic() {\n    let t = new_token(TokenType::TOKEN_INT, \"5\");\n    free_token(t);\n}\n\n#[test]\nfn test_token_types_distinct() {\n    let a = new_token(TokenType::TOKEN_INT, \"1\");\n    let b = new_token(TokenType::TOKEN_PLUS, \"+\");\n    assert_ne!(a.token_type, b.token_type);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":164,"cache_read_input_tokens":49691,"cache_creation":{"ephemeral_5m_input_tokens":164,"ephemeral_1h_input_tokens":0},"output_tokens":38,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"04cfcd12-5c0a-4cc9-b9a7-87ab3112e051","uuid":"39cc52a3-2e87-41ec-9299-23a11884b8ac"}
