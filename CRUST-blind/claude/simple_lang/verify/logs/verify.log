w_ast_node_dis_empty() {\n    let n = new_ast_node(TokenType::TOKEN_DIS, \"\");\n    assert_eq!(n.type_, TokenType::TOKEN_DIS);\n    assert_eq!(n.value, \"\");\n}\n\n#[test]\nfn test_free_ast_node_no_panic() {\n    let n = new_ast_node(TokenType::TOKEN_INT, \"1\");\n    free_ast_node(n);\n}\n\n#[test]\nfn test_ast_clone() {\n    let n = new_ast_node(TokenType::TOKEN_INT, \"99\");\n    let cloned: Box<ASTNode> = n.clone();\n    assert_eq!(cloned.type_, TokenType::TOKEN_INT);\n    assert_eq!(cloned.value, \"99\");\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3636,"cache_read_input_tokens":55383,"cache_creation":{"ephemeral_5m_input_tokens":3636,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"04cfcd12-5c0a-4cc9-b9a7-87ab3112e051","uuid":"d73ffd04-ce89-4529-a6e7-e1f1ad719c03"}
