{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EHGaVx8RU5uvL4vKu3dmFM","type":"tool_result","content":"1\t/// The maximum size of each sparse_array_group.\n2\tpub const GROUP_SIZE: usize = 48;\n3\t/// The default size of the hash table. Used to init bucket_max.\n4\tpub const STARTING_SIZE: usize = 32;\n5\t/// The default 'should we resize' percentage, out of 100.\n6\tpub const RESIZE_PERCENT: usize = 80;\n7\t/// Number of bits per u32.\n8\tpub const BITCHUNK_SIZE: usize = std::mem::size_of::<u32>() * 8;\n9\t/// The minimum number of u32 entries required to hold GROUP_SIZE bits.\n10\tpub const BITMAP_SIZE: usize = (GROUP_SIZE - 1) / BITCHUNK_SIZE + 1;\n11\t/// Represents one stored key/value pair.\n12\t#[derive(Debug)]\n13\tpub struct SparseBucket {\n14\t    /// The key as an owned String.\n15\t    pub key: String,\n16\t    /// The length of the key.\n17\t    pub klen: usize,\n18\t    /// The value as a vector of bytes.\n19\t    pub val: Vec<u8>,\n20\t    /// The length of the value.\n21\t    pub vlen: usize,\n22\t    /// The hash of the key.\n23\t    pub hash: u64,\n24\t}\n25\t/// One group in a sparse array.\n26\t#[derive(Debug)]\n27\tpub struct SparseArrayGroup {\n28\t    /// The number of items currently in this group.\n29\t    pub count: u32,\n30\t    /// The maximum size of each element.\n31\t    pub elem_size: usize,\n32\t    /// The storage for the elements.\n33\t    pub group: Vec<u8>,\n34\t    /// A bitmap tracking which slots in `group` are occupied.\n35\t    pub bitmap: [u32; BITMAP_SIZE],\n36\t}\n37\t/// A sparse array consisting of one or more groups.\n38\t#[derive(Debug)]\n39\tpub struct SparseArray {\n40\t    /// The maximum number of items that can be stored.\n41\t    pub maximum: usize,\n42\t    /// The groups that hold the elements.\n43\t    pub groups: Vec<SparseArrayGroup>,\n44\t}\n45\t/// A sparse dictionary that maps keys to values.\n46\t#[derive(Debug)]\n47\tpub struct SparseDict {\n48\t    /// The current maximum number of buckets in the dictionary.\n49\t    pub bucket_max: usize,\n50\t    /// The number of buckets that are currently occupied.\n51\t    pub bucket_count: usize,\n52\t    /// An array of sparse arrays (buckets).\n53\t    pub buckets: Vec<SparseArray>,\n54\t}\n55\t\n56\t// ---------- Internal helpers ----------\n57\t\n58\t/// FNV-1a 64-bit hash.\n59\tfn hash_fnv1a(key: &[u8], klen: usize) -> u64 {\n60\t    const FNV_PRIME: u64 = 1099511628211u64;\n61\t    const FNV_OFFSET_BIAS: u64 = 14695981039346656037u64;\n62\t    let mut hash: u64 = FNV_OFFSET_BIAS;\n63\t    let n = klen.min(key.len());\n64\t    for i in 0..n {\n65\t        hash ^= key[i] as u64;\n66\t        hash = hash.wrapping_mul(FNV_PRIME);\n67\t    }\n68\t    hash\n69\t}\n70\t\n71\t#[inline]\n72\tfn charbit(position: u32) -> u32 {\n73\t    position >> 5\n74\t}\n75\t\n76\t#[inline]\n77\tfn modbit(position: u32) -> u32 {\n78\t    1u32 << (position & 31)\n79\t}\n80\t\n81\t#[inline]\n82\tfn is_position_occupied(bitmap: &[u32; BITMAP_SIZE], position: u32) -> bool {\n83\t    (bitmap[charbit(position) as usize] & modbit(position)) != 0\n84\t}\n85\t\n86\t#[inline]\n87\tfn set_position(bitmap: &mut [u32; BITMAP_SIZE], position: u32) {\n88\t    bitmap[charbit(position) as usize] |= modbit(position);\n89\t}\n90\t\n91\t/// Counts the number of occupied positions in the bitmap before `position`.\n92\tfn position_to_offset(bitmap: &[u32; BITMAP_SIZE], position: u32) -> u32 {\n93\t    let mut retval: u32 = 0;\n94\t    let mut pos = position;\n95\t    let mut iter: usize = 0;\n96\t    while pos >= BITCHUNK_SIZE as u32 {\n97\t        retval += bitmap[iter].count_ones();\n98\t        pos -= BITCHUNK_SIZE as u32;\n99\t        iter += 1;\n100\t    }\n101\t    let mask: u32 = if pos == 0 { 0 } else { (1u32 << pos).wrapping_sub(1) };\n102\t    retval + (bitmap[iter] & mask).count_ones()\n103\t}\n104\t\n105\t/// Returns the byte offset in `group_buf` where the record at logical `offset` lives.\n106\tfn record_byte_offset(group_buf: &[u8], offset: u32) -> usize {\n107\t    let mut byte: usize = 0;\n108\t    for _ in 0..offset {\n109\t        let mut sz_bytes = [0u8; 8];\n110\t        sz_bytes.copy_from_slice(&group_buf[byte..byte + 8]);\n111\t        let size = usize::from_le_bytes(sz_bytes);\n112\t        byte += 8 + size;\n113\t    }\n114\t    byte\n115\t}\n116\t\n117\t/// Reads the size header at byte offset.\n118\tfn read_size_at(group_buf: &[u8], byte_offset: usize) -> usize {\n119\t    let mut sz_bytes = [0u8; 8];\n120\t    sz_bytes.copy_from_slice(&group_buf[byte_offset..byte_offset + 8]);\n121\t    usize::from_le_bytes(sz_bytes)\n122\t}\n123\t\n124\tfn _sparse_array_group_set(\n125\t    arr: &mut SparseArrayGroup,\n126\t    i: u32,\n127\t    val: &[u8],\n128\t    vlen: usize,\n129\t) -> i32 {\n130\t    if vlen > arr.elem_size {\n131\t        return 0;\n132\t    }\n133\t    if vlen > val.len() {\n134\t        return 0;\n135\t    }\n136\t\n137\t    let offset = position_to_offset(&arr.bitmap, i);\n138\t    let byte_offset = record_byte_offset(&arr.group, offset);\n139\t\n140\t    // Build the new record bytes: [size: 8 bytes][data: vlen bytes]\n141\t    let mut new_record: Vec<u8> = Vec::with_capacity(8 + vlen);\n142\t    new_record.extend_from_slice(&vlen.to_le_bytes());\n143\t    new_record.extend_from_slice(&val[..vlen]);\n144\t\n145\t    if !is_position_occupied(&arr.bitmap, i) {\n146\t        // Insert new record at byte_offset.\n147\t        arr.group.splice(byte_offset..byte_offset, new_record);\n148\t        arr.count += 1;\n149\t        set_position(&mut arr.bitmap, i);\n150\t    } else {\n151\t        // Replace existing record.\n152\t        let existing_size = read_size_at(&arr.group, byte_offset);\n153\t        let existing_total = 8 + existing_size;\n154\t        arr.group\n155\t            .splice(byte_offset..byte_offset + existing_total, new_record);\n156\t    }\n157\t    1\n158\t}\n159\t\n160\tfn _sparse_array_group_get<'a>(\n161\t    arr: &'a SparseArrayGroup,\n162\t    i: u32,\n163\t    outsize: Option<&mut usize>,\n164\t) -> Option<&'a [u8]> {\n165\t    if !is_position_occupied(&arr.bitmap, i) {\n166\t        return None;\n167\t    }\n168\t    let offset = position_to_offset(&arr.bitmap, i);\n169\t    let byte_offset = record_byte_offset(&arr.group, offset);\n170\t    let size = read_size_at(&arr.group, byte_offset);\n171\t    if size == 0 {\n172\t        return None;\n173\t    }\n174\t    if let Some(out) = outsize {\n175\t        *out = size;\n176\t    }\n177\t    Some(&arr.group[byte_offset + 8..byte_offset + 8 + size])\n178\t}\n179\t\n180\t// ---------- Sparse Array API ----------\n181\t\n182\tpub fn sparse_array_init(element_size: usize, maximum: u32) -> Option<Box<SparseArray>> {\n183\t    let max_arr_size = if maximum == 0 {\n184\t        1\n185\t    } else {\n186\t        (maximum as usize - 1) / GROUP_SIZE + 1\n187\t    };\n188\t    let mut groups: Vec<SparseArrayGroup> = Vec::with_capacity(max_arr_size);\n189\t    for _ in 0..max_arr_size {\n190\t        groups.push(SparseArrayGroup {\n191\t            count: 0,\n192\t            elem_size: element_size,\n193\t            group: Vec::new(),\n194\t            bitmap: [0u32; BITMAP_SIZE],\n195\t        });\n196\t    }\n197\t    Some(Box::new(SparseArray {\n198\t        maximum: maximum as usize,\n199\t        groups,\n200\t    }))\n201\t}\n202\t\n203\tpub fn sparse_array_set(arr: &mut SparseArray, i: u32, val: &[u8], vlen: usize) -> i32 {\n204\t    if (i as usize) > arr.maximum {\n205\t        return 0;\n206\t    }\n207\t    let group_idx = (i as usize) / GROUP_SIZE;\n208\t    let position = i % (GROUP_SIZE as u32);\n209\t    if group_idx >= arr.groups.len() {\n210\t        return 0;\n211\t    }\n212\t    _sparse_array_group_set(&mut arr.groups[group_idx], position, val, vlen)\n213\t}\n214\t\n215\tpub fn sparse_array_get<'a>(\n216\t    arr: &'a SparseArray,\n217\t    i: u32,\n218\t    outsize: Option<&mut usize>,\n219\t) -> Option<&'a [u8]> {\n220\t    if (i as usize) > arr.maximum {\n221\t        return None;\n222\t    }\n223\t    let group_idx = (i as usize) / GROUP_SIZE;\n224\t    let position = i % (GROUP_SIZE as u32);\n225\t    if group_idx >= arr.groups.len() {\n226\t        return None;\n227\t    }\n228\t    _sparse_array_group_get(&arr.groups[group_idx], position, outsize)\n229\t}\n230\t\n231\tpub fn sparse_array_free(_arr: Box<SparseArray>) -> i32 {\n232\t    // Box drops automatically when going out of scope.\n233\t    1\n234\t}\n235\t\n236\t// ---------- Sparse Dictionary helpers ----------\n237\t\n238\t#[inline]\n239\tfn quadratic_probe(key_hash: u64, num_probes: u64, maximum: u64) -> u64 {\n240\t    key_hash.wrapping_add(num_probes.wrapping_mul(num_probes)) & (maximum - 1)\n241\t}\n242\t\n243\t/// Serialize a bucket into bytes:\n244\t/// [klen: 8 bytes LE][vlen: 8 bytes LE][hash: 8 bytes LE][key bytes][value bytes]\n245\tfn serialize_bucket(klen: usize, vlen: usize, hash: u64, key: &[u8], value: &[u8]) -> Vec<u8> {\n246\t    let mut buf = Vec::with_capacity(24 + klen + vlen);\n247\t    buf.extend_from_slice(&klen.to_le_bytes());\n248\t    buf.extend_from_slice(&vlen.to_le_bytes());\n249\t    buf.extend_from_slice(&hash.to_le_bytes());\n250\t    buf.extend_from_slice(&key[..klen]);\n251\t    buf.extend_from_slice(&value[..vlen]);\n252\t    buf\n253\t}\n254\t\n255\tfn deserialize_bucket_header(bytes: &[u8]) -> (usize, usize, u64) {\n256\t    let mut a = [0u8; 8];\n257\t    let mut b = [0u8; 8];\n258\t    let mut c = [0u8; 8];\n259\t    a.copy_from_slice(&bytes[0..8]);\n260\t    b.copy_from_slice(&bytes[8..16]);\n261\t    c.copy_from_slice(&bytes[16..24]);\n262\t    (\n263\t        usize::from_le_bytes(a),\n264\t        usize::from_le_bytes(b),\n265\t        u64::from_le_bytes(c),\n266\t    )\n267\t}\n268\t\n269\tfn bucket_key_slice<'a>(bytes: &'a [u8], klen: usize) -> &'a [u8] {\n270\t    &bytes[24..24 + klen]\n271\t}\n272\t\n273\tfn bucket_value_slice<'a>(bytes: &'a [u8], klen: usize, vlen: usize) -> &'a [u8] {\n274\t    &bytes[24 + klen..24 + klen + vlen]\n275\t}\n276\t\n277\t/// A safely large element size for the dict's underlying sparse_array. We use\n278\t/// variable-length records inside the group, so this just needs to be large\n279\t/// enough that `vlen <= elem_size` is always true for serialized buckets.\n280\tconst DICT_ELEM_SIZE: usize = usize::MAX / 4;\n281\t\n282\tfn rehash_and_grow_table(dict: &mut SparseDict) -> i32 {\n283\t    let new_bucket_max = dict.bucket_max * 2;\n284\t    let mut new_arr = match sparse_array_init(DICT_ELEM_SIZE, new_bucket_max as u32) {\n285\t        Some(b) => *b,\n286\t        None => return 0,\n287\t    };\n288\t\n289\t    // Collect all serialized bucket bytes from the old array.\n290\t    let mut entries: Vec<Vec<u8>> = Vec::with_capacity(dict.bucket_count);\n291\t    {\n292\t        let old_arr = &dict.buckets[0];\n293\t        for i in 0..dict.bucket_max as u32 {\n294\t            let mut size: usize = 0;\n295\t            if let Some(bytes) = sparse_array_get(old_arr, i, Some(&mut size)) {\n296\t                if size != 0 {\n297\t                    entries.push(bytes.to_vec());\n298\t                    if entries.len() == dict.bucket_count {\n299\t                        break;\n300\t                    }\n301\t                }\n302\t            }\n303\t        }\n304\t    }\n305\t\n306\t    // Re-insert each entry into the new array using quadratic probing.\n307\t    for entry in entries.iter() {\n308\t        let (_klen, _vlen, key_hash) = deserialize_bucket_header(entry);\n309\t        let mut num_probes: u64 = 0;\n310\t        loop {\n311\t            let probed_val =\n312\t                quadratic_probe(key_hash, num_probes, new_bucket_max as u64) as u32;\n313\t            let mut size: usize = 0;\n314\t            let is_empty = sparse_array_get(&new_arr, probed_val, Some(&mut size)).is_none();\n315\t            if is_empty {\n316\t                if sparse_array_set(&mut new_arr, probed_val, entry, entry.len()) == 0 {\n317\t                    return 0;\n318\t                }\n319\t                break;\n320\t            }\n321\t            num_probes += 1;\n322\t            if num_probes > dict.bucket_count as u64 {\n323\t                return 0;\n324\t            }\n325\t        }\n326\t    }\n327\t\n328\t    dict.buckets[0] = new_arr;\n329\t    dict.bucket_max = new_bucket_max;\n330\t    1\n331\t}\n332\t\n333\t// ---------- Sparse Dictionary API ----------\n334\t\n335\tpub fn sparse_dict_init() -> Option<Box<SparseDict>> {\n336\t    let arr = sparse_array_init(DICT_ELEM_SIZE, STARTING_SIZE as u32)?;\n337\t    let mut buckets: Vec<SparseArray> = Vec::with_capacity(1);\n338\t    buckets.push(*arr);\n339\t    Some(Box::new(SparseDict {\n340\t        bucket_max: STARTING_SIZE,\n341\t        bucket_count: 0,\n342\t        buckets,\n343\t    }))\n344\t}\n345\t\n346\tpub fn sparse_dict_set(\n347\t    dict: &mut SparseDict,\n348\t    key: &str,\n349\t    klen: usize,\n350\t    value: &[u8],\n351\t    vlen: usize,\n352\t) -> i32 {\n353\t    let key_bytes = key.as_bytes();\n354\t    if klen > key_bytes.len() {\n355\t        return 0;\n356\t    }\n357\t    if vlen > value.len() {\n358\t        return 0;\n359\t    }\n360\t    let key_hash = hash_fnv1a(key_bytes, klen);\n361\t    let mut num_probes: u64 = 0;\n362\t\n363\t    loop {\n364\t        let probed_val =\n365\t            quadratic_probe(key_hash, num_probes, dict.bucket_max as u64) as u32;\n366\t\n367\t        // Inspect current slot; capture decision in a small local enum so\n368\t        // the borrow ends before we mutate.\n369\t        enum Decision {\n370\t            Empty,\n371\t            SameKey,\n372\t            DifferentKey,\n373\t        }\n374\t        let decision = {\n375\t            let arr = &dict.buckets[0];\n376\t            let mut size: usize = 0;\n377\t            match sparse_array_get(arr, probed_val, Some(&mut size)) {\n378\t                None => Decision::Empty,\n379\t                Some(bytes) => {\n380\t                    let (existing_klen, _existing_vlen, existing_hash) =\n381\t                        deserialize_bucket_header(bytes);\n382\t                    if existing_hash == key_hash\n383\t                        && existing_klen == klen\n384\t                        && bucket_key_slice(bytes, existing_klen) == &key_bytes[..klen]\n385\t                    {\n386\t                        Decision::SameKey\n387\t                    } else {\n388\t                        Decision::DifferentKey\n389\t                    }\n390\t                }\n391\t            }\n392\t        };\n393\t\n394\t        match decision {\n395\t            Decision::Empty => {\n396\t                let serialized = serialize_bucket(klen, vlen, key_hash, key_bytes, value);\n397\t                let arr_mut = &mut dict.buckets[0];\n398\t                let n = serialized.len();\n399\t                if sparse_array_set(arr_mut, probed_val, &serialized, n) == 0 {\n400\t                    return 0;\n401\t                }\n402\t                break;\n403\t            }\n404\t            Decision::SameKey => {\n405\t                let serialized = serialize_bucket(klen, vlen, key_hash, key_bytes, value);\n406\t                let arr_mut = &mut dict.buckets[0];\n407\t                let n = serialized.len();\n408\t                if sparse_array_set(arr_mut, probed_val, &serialized, n) == 0 {\n409\t                    return 0;\n410\t                }\n411\t                // Overwrite, no count change, no resize.\n412\t                return 1;\n413\t            }\n414\t            Decision::DifferentKey => {\n415\t                num_probes += 1;\n416\t                if num_probes > dict.bucket_count as u64 {\n417\t                    return 0;\n418\t                }\n419\t            }\n420\t        }\n421\t    }\n422\t\n423\t    dict.bucket_count += 1;\n424\t\n425\t    // Resize if load factor reaches RESIZE_PERCENT/100.\n426\t    if dict.bucket_count.saturating_mul(100) >= dict.bucket_max.saturating_mul(RESIZE_PERCENT) {\n427\t        return rehash_and_grow_table(dict);\n428\t    }\n429\t    1\n430\t}\n431\t\n432\tpub fn sparse_dict_get<'a>(\n433\t    dict: &'a SparseDict,\n434\t    key: &str,\n435\t    klen: usize,\n436\t    outsize: Option<&mut usize>,\n437\t) -> Option<&'a [u8]> {\n438\t    let key_bytes = key.as_bytes();\n439\t    if klen > key_bytes.len() {\n440\t        return None;\n441\t    }\n442\t    let key_hash = hash_fnv1a(key_bytes, klen);\n443\t    let mut num_probes: u64 = 0;\n444\t    let mut outsize = outsize;\n445\t\n446\t    loop {\n447\t        let probed_val =\n448\t            quadratic_probe(key_hash, num_probes, dict.bucket_max as u64) as u32;\n449\t        let arr = &dict.buckets[0];\n450\t        let mut size: usize = 0;\n451\t        match sparse_array_get(arr, probed_val, Some(&mut size)) {\n452\t            Some(bytes) => {\n453\t                let (existing_klen, existing_vlen, existing_hash) =\n454\t                    deserialize_bucket_header(bytes);\n455\t                if existing_hash == key_hash\n456\t                    && existing_klen == klen\n457\t                    && bucket_key_slice(bytes, existing_klen) == &key_bytes[..klen]\n458\t                {\n459\t                    if let Some(out) = outsize.as_mut() {\n460\t                        **out = existing_vlen;\n461\t                    }\n462\t                    return Some(bucket_value_slice(bytes, existing_klen, existing_vlen));\n463\t                }\n464\t            }\n465\t            None => return None,\n466\t        }\n467\t        num_probes += 1;\n468\t        if num_probes > dict.bucket_count as u64 {\n469\t            return None;\n470\t        }\n471\t    }\n472\t}\n473\t\n474\tpub fn sparse_dict_free(_dict: Box<SparseDict>) -> i32 {\n475\t    // Box drops automatically.\n476\t    1\n477\t}\n478\t"}]},"parent_tool_use_id":null,"session_id":"575f22d5-9db7-4a34-9d85-c046635f9daf","uuid":"6b889049-04b5-4770-95e0-d940b2ec76af","timestamp":"2026-05-29T17:33:47.045Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-n0b0Yw/project/src/simple_sparsehash.rs","content":"/// The maximum size of each sparse_array_group.\npub const GROUP_SIZE: usize = 48;\n/// The default size of the hash table. Used to init bucket_max.\npub const STARTING_SIZE: usize = 32;\n/// The default 'should we resize' percentage, out of 100.\npub const RESIZE_PERCENT: usize = 80;\n/// Number of bits per u32.\npub const BITCHUNK_SIZE: usize = std::mem::size_of::<u32>() * 8;\n/// The minimum number of u32 entries required to hold GROUP_SIZE bits.\npub const BITMAP_SIZE: usize = (GROUP_SIZE - 1) / BITCHUNK_SIZE + 1;\n/// Represents one stored key/value pair.\n#[derive(Debug)]\npub struct SparseBucket {\n    /// The key as an owned String.\n    pub key: String,\n    /// The length of the key.\n    pub klen: usize,\n    /// The value as a vector of bytes.\n    pub val: Vec<u8>,\n    /// The length of the value.\n    pub vlen: usize,\n    /// The hash of the key.\n    pub hash: u64,\n}\n/// One group in a sparse array.\n#[derive(Debug)]\npub struct SparseArrayGroup {\n    /// The number of items currently in this group.\n    pub count: u32,\n    /// The maximum size of each element.\n    pub elem_size: usize,\n    /// The storage for the elements.\n    pub group: Vec<u8>,\n    /// A bitmap tracking which slots in `group` are occupied.\n    pub bitmap: [u32; BITMAP_SIZE],\n}\n/// A sparse array consisting of one or more groups.\n#[derive(Debug)]\npub struct SparseArray {\n    /// The maximum number of items that can be stored.\n    pub maximum: usize,\n    /// The groups that hold the elements.\n    pub groups: Vec<SparseArrayGroup>,\n}\n/// A sparse dictionary that maps keys to values.\n#[derive(Debug)]\npub struct SparseDict {\n    /// The current maximum number of buckets in the dictionary.\n    pub bucket_max: usize,\n    /// The number of buckets that are currently occupied.\n    pub bucket_count: usize,\n    /// An array of sparse arrays (buckets).\n    pub buckets: Vec<SparseArray>,\n}\n\n// ---------- Internal helpers ----------\n\n/// FNV-1a 64-bit hash.\nfn hash_fnv1a(key: &[u8], klen: usize) -> u64 {\n    const FNV_PRIME: u64 = 1099511628211u64;\n    const FNV_OFFSET_BIAS: u64 = 14695981039346656037u64;\n    let mut hash: u64 = FNV_OFFSET_BIAS;\n    let n = klen.min(key.len());\n    for i in 0..n {\n        hash ^= key[i] as u64;\n        hash = hash.wrapping_mul(FNV_PRIME);\n    }\n    hash\n}\n\n#[inline]\nfn charbit(position: u32) -> u32 {\n    position >> 5\n}\n\n#[inline]\nfn modbit(position: u32) -> u32 {\n    1u32 << (position & 31)\n}\n\n#[inline]\nfn is_position_occupied(bitmap: &[u32; BITMAP_SIZE], position: u32) -> bool {\n    (bitmap[charbit(position) as usize] & modbit(position)) != 0\n}\n\n#[inline]\nfn set_position(bitmap: &mut [u32; BITMAP_SIZE], position: u32) {\n    bitmap[charbit(position) as usize] |= modbit(position);\n}\n\n/// Counts the number of occupied positions in the bitmap before `position`.\nfn position_to_offset(bitmap: &[u32; BITMAP_SIZE], position: u32) -> u32 {\n    let mut retval: u32 = 0;\n    let mut pos = position;\n    let mut iter: usize = 0;\n    while pos >= BITCHUNK_SIZE as u32 {\n        retval += bitmap[iter].count_ones();\n        pos -= BITCHUNK_SIZE as u32;\n        iter += 1;\n    }\n    let mask: u32 = if pos == 0 { 0 } else { (1u32 << pos).wrapping_sub(1) };\n    retval + (bitmap[iter] & mask).count_ones()\n}\n\n/// Returns the byte offset in `group_buf` where the record at logical `offset` lives.\nfn record_byte_offset(group_buf: &[u8], offset: u32) -> usize {\n    let mut byte: usize = 0;\n    for _ in 0..offset {\n        let mut sz_bytes = [0u8; 8];\n        sz_bytes.copy_from_slice(&group_buf[byte..byte + 8]);\n        let size = usize::from_le_bytes(sz_bytes);\n        byte += 8 + size;\n    }\n    byte\n}\n\n/// Reads the size header at byte offset.\nfn read_size_at(group_buf: &[u8], byte_offset: usize) -> usize {\n    let mut sz_bytes = [0u8; 8];\n    sz_bytes.copy_from_slice(&group_buf[byte_offset..byte_offset + 8]);\n    usize::from_le_bytes(sz_bytes)\n}\n\nfn _sparse_array_group_set(\n    arr: &mut SparseArrayGroup,\n    i: u32,\n    val: &[u8],\n    vlen: usize,\n) -> i32 {\n    if vlen > arr.elem_size {\n        return 0;\n    }\n    if vlen > val.len() {\n        return 0;\n    }\n\n    let offset = position_to_offset(&arr.bitmap, i);\n    let byte_offset = record_byte_offset(&arr.group, offset);\n\n    // Build the new record bytes: [size: 8 bytes][data: vlen bytes]\n    let mut new_record: Vec<u8> = Vec::with_capacity(8 + vlen);\n    new_record.extend_from_slice(&vlen.to_le_bytes());\n    new_record.extend_from_slice(&val[..vlen]);\n\n    if !is_position_occupied(&arr.bitmap, i) {\n        // Insert new record at byte_offset.\n        arr.group.splice(byte_offset..byte_offset, new_record);\n        arr.count += 1;\n        set_position(&mut arr.bitmap, i);\n    } else {\n        // Replace existing record.\n        let existing_size = read_size_at(&arr.group, byte_offset);\n        let existing_total = 8 + existing_size;\n        arr.group\n            .splice(byte_offset..byte_offset + existing_total, new_record);\n    }\n    1\n}\n\nfn _sparse_array_group_get<'a>(\n    arr: &'a SparseArrayGroup,\n    i: u32,\n    outsize: Option<&mut usize>,\n) -> Option<&'a [u8]> {\n    if !is_position_occupied(&arr.bitmap, i) {\n        return None;\n    }\n    let offset = position_to_offset(&arr.bitmap, i);\n    let byte_offset = record_byte_offset(&arr.group, offset);\n    let size = read_size_at(&arr.group, byte_offset);\n    if size == 0 {\n        return None;\n    }\n    if let Some(out) = outsize {\n        *out = size;\n    }\n    Some(&arr.group[byte_offset + 8..byte_offset + 8 + size])\n}\n\n// ---------- Sparse Array API ----------\n\npub fn sparse_array_init(element_size: usize, maximum: u32) -> Option<Box<SparseArray>> {\n    let max_arr_size = if maximum == 0 {\n        1\n    } else {\n        (maximum as usize - 1) / GROUP_SIZE + 1\n    };\n    let mut groups: Vec<SparseArrayGroup> = Vec::with_capacity(max_arr_size);\n    for _ in 0..max_arr_size {\n        groups.push(SparseArrayGroup {\n            count: 0,\n            elem_size: element_size,\n            group: Vec::new(),\n            bitmap: [0u32; BITMAP_SIZE],\n        });\n    }\n    Some(Box::new(SparseArray {\n        maximum: maximum as usize,\n        groups,\n    }))\n}\n\npub fn sparse_array_set(arr: &mut SparseArray, i: u32, val: &[u8], vlen: usize) -> i32 {\n    if (i as usize) > arr.maximum {\n        return 0;\n    }\n    let group_idx = (i as usize) / GROUP_SIZE;\n    let position = i % (GROUP_SIZE as u32);\n    if group_idx >= arr.groups.len() {\n        return 0;\n    }\n    _sparse_array_group_set(&mut arr.groups[group_idx], position, val, vlen)\n}\n\npub fn sparse_array_get<'a>(\n    arr: &'a SparseArray,\n    i: u32,\n    outsize: Option<&mut usize>,\n) -> Option<&'a [u8]> {\n    if (i as usize) > arr.maximum {\n        return None;\n    }\n    let group_idx = (i as usize) / GROUP_SIZE;\n    let position = i % (GROUP_SIZE as u32);\n    if group_idx >= arr.groups.len() {\n        return None;\n    }\n    _sparse_array_group_get(&arr.groups[group_idx], position, outsize)\n}\n\npub fn sparse_array_free(_arr: Box<SparseArray>) -> i32 {\n    // Box drops automatically when going out of scope.\n    1\n}\n\n// ---------- Sparse Dictionary helpers ----------\n\n#[inline]\nfn quadratic_probe(key_hash: u64, num_probes: u64, maximum: u64) -> u64 {\n    key_hash.wrapping_add(num_probes.wrapping_mul(num_probes)) & (maximum - 1)\n}\n\n/// Serialize a bucket into bytes:\n/// [klen: 8 bytes LE][vlen: 8 bytes LE][hash: 8 bytes LE][key bytes][value bytes]\nfn serialize_bucket(klen: usize, vlen: usize, hash: u64, key: &[u8], value: &[u8]) -> Vec<u8> {\n    let mut buf = Vec::with_capacity(24 + klen + vlen);\n    buf.extend_from_slice(&klen.to_le_bytes());\n    buf.extend_from_slice(&vlen.to_le_bytes());\n    buf.extend_from_slice(&hash.to_le_bytes());\n    buf.extend_from_slice(&key[..klen]);\n    buf.extend_from_slice(&value[..vlen]);\n    buf\n}\n\nfn deserialize_bucket_header(bytes: &[u8]) -> (usize, usize, u64) {\n    let mut a = [0u8; 8];\n    let mut b = [0u8; 8];\n    let mut c = [0u8; 8];\n    a.copy_from_slice(&bytes[0..8]);\n    b.copy_from_slice(&bytes[8..16]);\n    c.copy_from_slice(&bytes[16..24]);\n    (\n        usize::from_le_bytes(a),\n        usize::from_le_bytes(b),\n        u64::from_le_bytes(c),\n    )\n}\n\nfn bucket_key_slice<'a>(bytes: &'a [u8], klen: usize) -> &'a [u8] {\n    &bytes[24..24 + klen]\n}\n\nfn bucket_value_slice<'a>(bytes: &'a [u8], klen: usize, vlen: usize) -> &'a [u8] {\n    &bytes[24 + klen..24 + klen + vlen]\n}\n\n/// A safely large element size for the dict's underlying sparse_array. We use\n/// variable-length records inside the group, so this just needs to be large\n/// enough that `vlen <= elem_size` is always true for serialized buckets.\nconst DICT_ELEM_SIZE: usize = usize::MAX / 4;\n\nfn rehash_and_grow_table(dict: &mut SparseDict) -> i32 {\n    let new_bucket_max = dict.bucket_max * 2;\n    let mut new_arr = match sparse_array_init(DICT_ELEM_SIZE, new_bucket_max as u32) {\n        Some(b) => *b,\n        None => return 0,\n    };\n\n    // Collect all serialized bucket bytes from the old array.\n    let mut entries: Vec<Vec<u8>> = Vec::with_capacity(dict.bucket_count);\n    {\n        let old_arr = &dict.buckets[0];\n        for i in 0..dict.bucket_max as u32 {\n            let mut size: usize = 0;\n            if let Some(bytes) = sparse_array_get(old_arr, i, Some(&mut size)) {\n                if size != 0 {\n                    entries.push(bytes.to_vec());\n                    if entries.len() == dict.bucket_count {\n                        break;\n                    }\n                }\n            }\n        }\n    }\n\n    // Re-insert each entry into the new array using quadratic probing.\n    for entry in entries.iter() {\n        let (_klen, _vlen, key_hash) = deserialize_bucket_header(entry);\n        let mut num_probes: u64 = 0;\n        loop {\n            let probed_val =\n                quadratic_probe(key_hash, num_probes, new_bucket_max as u64) as u32;\n            let mut size: usize = 0;\n            let is_empty = sparse_array_get(&new_arr, probed_val, Some(&mut size)).is_none();\n            if is_empty {\n                if sparse_array_set(&mut new_arr, probed_val, entry, entry.len()) == 0 {\n                    return 0;\n                }\n                break;\n            }\n            num_probes += 1;\n            if num_probes > dict.bucket_count as u64 {\n                return 0;\n            }\n        }\n    }\n\n    dict.buckets[0] = new_arr;\n    dict.bucket_max = new_bucket_max;\n    1\n}\n\n// ---------- Sparse Dictionary API ----------\n\npub fn sparse_dict_init() -> Option<Box<SparseDict>> {\n    let arr = sparse_array_init(DICT_ELEM_SIZE, STARTING_SIZE as u32)?;\n    let mut buckets: Vec<SparseArray> = Vec::with_capacity(1);\n    buckets.push(*arr);\n    Some(Box::new(SparseDict {\n        bucket_max: STARTING_SIZE,\n        bucket_count: 0,\n        buckets,\n    }))\n}\n\npub fn sparse_dict_set(\n    dict: &mut SparseDict,\n    key: &str,\n    klen: usize,\n    value: &[u8],\n    vlen: usize,\n) -> i32 {\n    let key_bytes = key.as_bytes();\n    if klen > key_bytes.len() {\n        return 0;\n    }\n    if vlen > value.len() {\n        return 0;\n    }\n    let key_hash = hash_fnv1a(key_bytes, klen);\n    let mut num_probes: u64 = 0;\n\n    loop {\n        let probed_val =\n            quadratic_probe(key_hash, num_probes, dict.bucket_max as u64) as u32;\n\n        // Inspect current slot; capture decision in a small local enum so\n        // the borrow ends before we mutate.\n        enum Decision {\n            Empty,\n            SameKey,\n            DifferentKey,\n        }\n        let decision = {\n            let arr = &dict.buckets[0];\n            let mut size: usize = 0;\n            match sparse_array_get(arr, probed_val, Some(&mut size)) {\n                None => Decision::Empty,\n                Some(bytes) => {\n                    let (existing_klen, _existing_vlen, existing_hash) =\n                        deserialize_bucket_header(bytes);\n                    if existing_hash == key_hash\n                        && existing_klen == klen\n                        && bucket_key_slice(bytes, existing_klen) == &key_bytes[..klen]\n                    {\n                        Decision::SameKey\n                    } else {\n                        Decision::DifferentKey\n                    }\n                }\n            }\n        };\n\n        match decision {\n            Decision::Empty => {\n                let serialized = serialize_bucket(klen, vlen, key_hash, key_bytes, value);\n                let arr_mut = &mut dict.buckets[0];\n                let n = serialized.len();\n                if sparse_array_set(arr_mut, probed_val, &serialized, n) == 0 {\n                    return 0;\n                }\n                break;\n            }\n            Decision::SameKey => {\n                let serialized = serialize_bucket(klen, vlen, key_hash, key_bytes, value);\n                let arr_mut = &mut dict.buckets[0];\n                let n = serialized.len();\n                if sparse_array_set(arr_mut, probed_val, &serialized, n) == 0 {\n                    return 0;\n                }\n                // Overwrite, no count change, no resize.\n                return 1;\n            }\n            Decision::DifferentKey => {\n                num_probes += 1;\n                if num_probes > dict.bucket_count as u64 {\n                    return 0;\n                }\n            }\n        }\n    }\n\n    dict.bucket_count += 1;\n\n    // Resize if load factor reaches RESIZE_PERCENT/100.\n    if dict.bucket_count.saturating_mul(100) >= dict.bucket_max.saturating_mul(RESIZE_PERCENT) {\n        return rehash_and_grow_table(dict);\n    }\n    1\n}\n\npub fn sparse_dict_get<'a>(\n    dict: &'a SparseDict,\n    key: &str,\n    klen: usize,\n    outsize: Option<&mut usize>,\n) -> Option<&'a [u8]> {\n    let key_bytes = key.as_bytes();\n    if klen > key_bytes.len() {\n        return None;\n    }\n    let key_hash = hash_fnv1a(key_bytes, klen);\n    let mut num_probes: u64 = 0;\n    let mut outsize = outsize;\n\n    loop {\n        let probed_val =\n            quadratic_probe(key_hash, num_probes, dict.bucket_max as u64) as u32;\n        let arr = &dict.buckets[0];\n        let mut size: usize = 0;\n        match sparse_array_get(arr, probed_val, Some(&mut size)) {\n            Some(bytes) => {\n                let (existing_klen, existing_vlen, existing_hash) =\n                    deserialize_bucket_header(bytes);\n                if existing_hash == key_hash\n                    && existing_klen == klen\n                    && bucket_key_slice(bytes, existing_klen) == &key_bytes[..klen]\n                {\n                    if let Some(out) = outsize.as_mut() {\n                        **out = existing_vlen;\n                    }\n                    return Some(bucket_value_slice(bytes, existing_klen, existing_vlen));\n                }\n            }\n            None => return None,\n        }\n        num_probes += 1;\n        if num_probes > dict.bucket_count as u64 {\n            return None;\n        }\n    }\n}\n\npub fn sparse_dict_free(_dict: Box<SparseDict>) -> i32 {\n    // Box drops automatically.\n    1\n}\n","numLines":478,"startLine":1,"totalLines":478}}}
