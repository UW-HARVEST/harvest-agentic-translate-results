pow(2, log(2)));\n    size_t k = round(((double)m / (double)(n)) * log(2));\n    size_t m0 = 2;\n    while (m0 < m) {\n        m0 *= 2;\n    }\n    size_t k0 = round((double)m / (double)m0 * (double)k);\n    *m_out = m0;\n    *k_out = k0;\n}\n\nint main(int argc, char **argv) {\n    if (argc < 2) {\n        fprintf(stderr, \"usage: helper <command> args...\\n\");\n        return 1;\n    }\n    if (strcmp(argv[1], \"mix\") == 0) {\n        for (int i = 2; i < argc; i++) {\n            uint64_t k = strtoull(argv[i], NULL, 10);\n            printf(\"%llu\\n\", (unsigned long long)my_mix(k));\n        }\n        return 0;\n    }\n    if (strcmp(argv[1], \"mk\") == 0) {\n        size_t n = strtoull(argv[2], NULL, 10);\n        double p = atof(argv[3]);\n        size_t m, k;\n        compute_mk(n, p, &m, &k);\n        printf(\"m=%zu k=%zu\\n\", m, k);\n        return 0;\n    }\n    if (strcmp(argv[1], \"memsize_initial\") == 0) {\n        // Compute memsize after rhbloom_new\n        size_t n = strtoull(argv[2], NULL, 10);\n        double p = atof(argv[3]);\n        struct rhbloom *r = rhbloom_new(n, p);\n        printf(\"memsize=%zu\\n\", rhbloom_memsize(r));\n        printf(\"upgraded=%d\\n\", rhbloom_upgraded(r));\n        rhbloom_free(r);\n        return 0;\n    }\n    if (strcmp(argv[1], \"add_seq\") == 0) {\n        // Add sequence of keys 0..count then report behavior\n        size_t n = strtoull(argv[2], NULL, 10);\n        double p = atof(argv[3]);\n        size_t count = strtoull(argv[4], NULL, 10);\n        struct rhbloom *r = rhbloom_new(n, p);\n        for (size_t i = 0; i < count; i++) {\n            rhbloom_add(r, i);\n        }\n        printf(\"upgraded=%d\\n\", rhbloom_upgraded(r));\n        for (size_t i = 0; i < count; i++) {\n            printf(\"test_%zu=%d\\n\", i, rhbloom_test(r, i));\n        }\n        rhbloom_free(r);\n        return 0;\n    }\n    if (strcmp(argv[1], \"test_when_empty\") == 0) {\n        // What does test return for fresh filter?\n        size_t n = strtoull(argv[2], NULL, 10);\n        double p = atof(argv[3]);\n        struct rhbloom *r = rhbloom_new(n, p);\n        printf(\"test_5=%d\\n\", rhbloom_test(r, 5));\n        printf(\"test_0=%d\\n\", rhbloom_test(r, 0));\n        printf(\"test_max=%d\\n\", rhbloom_test(r, UINT64_MAX));\n        rhbloom_free(r);\n        return 0;\n    }\n    if (strcmp(argv[1], \"upgrade_threshold\") == 0) {\n        // Find at what add count the filter upgrades to bloom\n        size_t n = strtoull(argv[2], NULL, 10);\n        double p = atof(argv[3]);\n        struct rhbloom *r = rhbloom_new(n, p);\n        size_t i = 0;\n        while (!rhbloom_upgraded(r) && i < 10000000) {\n            rhbloom_add(r, i);\n            i++;\n        }\n        printf(\"upgrade_at=%zu\\n\", i);\n        rhbloom_free(r);\n        return 0;\n    }\n    return 1;\n}\n","structuredPatch":[{"oldStart":101,"oldLines":5,"newStart":101,"newLines":98,"lines":["         rhbloom_free(r);","         return 0;","     }","+    if (strcmp(argv[1], \"rh_test\") == 0) {","+        // Add few keys (staying in robinhood mode) and confirm exact behavior","+        size_t n = strtoull(argv[2], NULL, 10);","+        double p = atof(argv[3]);","+        size_t count = strtoull(argv[4], NULL, 10);","+        struct rhbloom *r = rhbloom_new(n, p);","+        for (size_t i = 0; i < count; i++) {","+            rhbloom_add(r, i);","+        }","+        printf(\"upgraded=%d\\n\", rhbloom_upgraded(r));","+        // Test all the ones we added.","+        for (size_t i = 0; i < count; i++) {","+            printf(\"test_%zu=%d\\n\", i, rhbloom_test(r, i));","+        }","+        // Check memsize.","+        printf(\"memsize=%zu\\n\", rhbloom_memsize(r));","+        rhbloom_free(r);","+        return 0;","+    }","+    if (strcmp(argv[1], \"after_clear\") == 0) {","+        // Add keys then clear and check behavior","+        size_t n = strtoull(argv[2], NULL, 10);","+        double p = atof(argv[3]);"