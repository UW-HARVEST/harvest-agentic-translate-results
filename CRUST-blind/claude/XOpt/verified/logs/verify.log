{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01P8kaph2q8Po7bnvYP3aqHV","type":"tool_result","content":"1\tuse crate::snprintf;\n2\tpub const XOPT_TYPE_STRING: i64 = 0x1;   // const char * type\n3\tpub const XOPT_TYPE_INT: i64    = 0x2;   // int type\n4\tpub const XOPT_TYPE_LONG: i64   = 0x4;   // long type\n5\tpub const XOPT_TYPE_FLOAT: i64  = 0x8;   // float type\n6\tpub const XOPT_TYPE_DOUBLE: i64 = 0x10;  // double type\n7\tpub const XOPT_TYPE_BOOL: i64   = 0x20;  // boolean (int) type\n8\t/// Indicates that the argument value is optional.\n9\tpub const XOPT_OPTIONAL: i64    = 0x40;\n10\t/// Bitmask constants for context flags.\n11\tpub const XOPT_CTX_KEEPFIRST: i64     = 0x1;\n12\tpub const XOPT_CTX_POSIXMEHARDER: i64 = 0x2;\n13\tpub const XOPT_CTX_NOCONDENSE: i64    = 0x4;\n14\t/// `XOPT_CTX_SLOPPYSHORTS` is defined as 0x8 | 0x4 in C\n15\tpub const XOPT_CTX_SLOPPYSHORTS: i64  = 0x8 | XOPT_CTX_NOCONDENSE;\n16\tpub const XOPT_CTX_STRICT: i64        = 0x10;\n17\tpub type XoptCallback = fn(\n18\t    value: Option<&str>,\n19\t    data: *mut u8,\n20\t    option: &XoptOption,\n21\t    long_arg: bool,\n22\t    err: &mut Option<String>,\n23\t);\n24\t#[derive(Debug, Clone)]\n25\tpub struct XoptOption {\n26\t    /// Matches the `--longArg`; `None` means no long argument.\n27\t    pub long_arg: Option<String>,\n28\t    /// Matches the single `-s` short argument.  If `'\\0'`, there is no short argument.\n29\t    pub short_arg: char,\n30\t    /// Matches the original `offsetof(...)` usage.  In Rust, we typically do not\n31\t    /// manually offset into structs, but we keep this for compatibility.\n32\t    pub offset: usize,\n33\t    /// Callback for resolved option handling.  May be `None` if not specified.\n34\t    pub callback: Option<XoptCallback>,\n35\t    /// Bitmask of `XOPT_TYPE_*` and possibly `XOPT_OPTIONAL`.\n36\t    pub options: i64,\n37\t    /// For help text: `--argument=argDescrip`.\n38\t    pub arg_descrip: Option<String>,\n39\t    /// For help text: descriptive explanation.\n40\t    pub descrip: Option<String>,\n41\t}\n42\tpub const fn XOPT_NULLOPTION() -> XoptOption {\n43\t    XoptOption {\n44\t        long_arg: None,\n45\t        short_arg: '\\0',\n46\t        offset: 0,\n47\t        callback: None,\n48\t        options: 0,\n49\t        arg_descrip: None,\n50\t        descrip: None,\n51\t    }\n52\t}\n53\t#[derive(Debug)]\n54\tpub struct XoptContext {\n55\t    /// In the C code, `const xoptOption *options;`\n56\t    pub options: Vec<XoptOption>,\n57\t    /// The bitflags for context configuration.\n58\t    pub flags: i64,\n59\t    /// The `name` from the original code (like the CLI binary name).\n60\t    pub name: Option<String>,\n61\t    /// Tracks whether `--` was encountered, in the C code.\n62\t    pub doubledash: bool,\n63\t}\n64\t#[derive(Debug, Clone)]\n65\tpub struct XoptAutohelpOptions {\n66\t    /// Usage string or `None` if not specified.\n67\t    pub usage: Option<String>,\n68\t    /// Printed before the options list, or `None`.\n69\t    pub prefix: Option<String>,\n70\t    /// Printed after the options list, or `None`.\n71\t    pub suffix: Option<String>,\n72\t    /// Number of spaces between option and description.\n73\t    pub spacer: usize,\n74\t}\n75\t\n76\t/// Helper: detect whether an option entry is a \"null terminator\" (matches the\n77\t/// C code's `XOPT_NULLOPTION`).  An entry is a terminator iff it has neither a\n78\t/// long nor a short argument.\n79\tfn is_terminator(opt: &XoptOption) -> bool {\n80\t    opt.long_arg.is_none() && opt.short_arg == '\\0'\n81\t}\n82\t\n83\t/// Iterate over the option list, skipping the terminator(s).\n84\tfn iter_options(opts: &[XoptOption]) -> impl Iterator<Item = (usize, &XoptOption)> {\n85\t    opts.iter().enumerate().take_while(|(_, o)| !is_terminator(o))\n86\t}\n87\t\n88\t/// Determine the size of an argument string: 0 for extras, 1 for short\n89\t/// (begins with a single dash), 2 for long (begins with two dashes).\n90\tfn xopt_get_size(arg: &str) -> usize {\n91\t    let bytes = arg.as_bytes();\n92\t    let mut size = 0usize;\n93\t    while size < 2 && size < bytes.len() && bytes[size] == b'-' {\n94\t        size += 1;\n95\t    }\n96\t    size\n97\t}\n98\t\n99\t/// Search the options list for a matching short or long argument and return\n100\t/// `(arg_requirement, found_index)`.  `arg_requirement` follows the C\n101\t/// convention: 0 = no value, 1 = optional, 2 = required.\n102\tfn xopt_get_arg(arg: &str, len: usize, options: &[XoptOption], size: usize) -> (i32, Option<usize>) {\n103\t    let mut found: Option<usize> = None;\n104\t    let arg_chars: Vec<char> = arg.chars().collect();\n105\t    for (i, o) in iter_options(options) {\n106\t        if size == 1 {\n107\t            if !arg_chars.is_empty() && o.short_arg == arg_chars[0] {\n108\t                found = Some(i);\n109\t                break;\n110\t            }\n111\t        } else {\n112\t            if let Some(la) = &o.long_arg {\n113\t                let la_chars: Vec<char> = la.chars().collect();\n114\t                if la_chars.len() == len {\n115\t                    let prefix: String = arg_chars.iter().take(len).collect();\n116\t                    if &prefix == la {\n117\t                        found = Some(i);\n118\t                        break;\n119\t                    }\n120\t                }\n121\t            }\n122\t        }\n123\t    }\n124\t\n125\t    let req = match found {\n126\t        None => 0,\n127\t        Some(i) => {\n128\t            let opt = &options[i];\n129\t            if (opt.options & XOPT_TYPE_BOOL) != 0 {\n130\t                0\n131\t            } else if (opt.options & XOPT_OPTIONAL) != 0 {\n132\t                1\n133\t            } else {\n134\t                2\n135\t            }\n136\t        }\n137\t    };\n138\t\n139\t    (req, found)\n140\t}\n141\t\n142\t/// Default implementation of the option-resolved callback.  Mirrors the\n143\t/// behaviour of `_xopt_default_callback` in the C source.\n144\tfn xopt_default_callback(\n145\t    value: Option<&str>,\n146\t    _data: *mut u8,\n147\t    option: &XoptOption,\n148\t    long_arg: bool,\n149\t    err: &mut Option<String>,\n150\t) {\n151\t    let is_bool = (option.options & XOPT_TYPE_BOOL) != 0;\n152\t    let value_is_empty = match value {\n153\t        None => true,\n154\t        Some(v) => v.is_empty(),\n155\t    };\n156\t\n157\t    if value_is_empty && !is_bool {\n158\t        // Optional non-boolean option with no value: nothing to do.\n159\t        return;\n160\t    }\n161\t\n162\t    // Determine the type encoded in the lower 6 bits.\n163\t    let type_bits = option.options & 0x3F;\n164\t    let mut parse_ok = true;\n165\t\n166\t    match type_bits {\n167\t        x if x == XOPT_TYPE_BOOL => {\n168\t            // No data interaction in safe Rust - the user provides their own\n169\t            // callback if they want to record bool values.\n170\t        }\n171\t        x if x == XOPT_TYPE_STRING => {\n172\t            // Same as above: storage is the user's responsibility.\n173\t        }\n174\t        x if x == XOPT_TYPE_INT || x == XOPT_TYPE_LONG => {\n175\t            if let Some(v) = value {\n176\t                let v = v.trim();\n177\t                if v.is_empty() {\n178\t                    parse_ok = false;\n179\t                } else {\n180\t                    // Honour C's `strtol(_, _, 0)` base detection.\n181\t                    let parsed = parse_c_long(v);\n182\t                    if parsed.is_none() {\n183\t                        parse_ok = false;\n184\t                    }\n185\t                }\n186\t            }\n187\t        }\n188\t        x if x == XOPT_TYPE_FLOAT || x == XOPT_TYPE_DOUBLE => {\n189\t            if let Some(v) = value {\n190\t                let v = v.trim();\n191\t                if v.is_empty() {\n192\t                    parse_ok = false;\n193\t                } else if v.parse::<f64>().is_err() {\n194\t                    parse_ok = false;\n195\t                }\n196\t            }\n197\t        }\n198\t        _ => {\n199\t            // Implementations specifying multiple types end up here.  Match\n200\t            // the C version's \"warning\" by leaving things alone.\n201\t        }\n202\t    }\n203\t\n204\t    if !parse_ok {\n205\t        if let Some(v) = value {\n206\t            if long_arg {\n207\t                let la = option.long_arg.as_deref().unwrap_or(\"\");\n208\t                *err = Some(format!(\"value isn't a valid number: --{}={}\", la, v));\n209\t            } else {\n210\t                *err = Some(format!(\"value isn't a valid number: -{} {}\", option.short_arg, v));\n211\t            }\n212\t        }\n213\t    }\n214\t}\n215\t\n216\t/// Replicate `strtol(s, NULL, 0)` parsing semantics: \"0x\" / \"0X\" prefixes\n217\t/// indicate hex, a leading \"0\" indicates octal, otherwise decimal.\n218\tfn parse_c_long(s: &str) -> Option<i64> {\n219\t    let s = s.trim();\n220\t    if s.is_empty() {\n221\t        return None;\n222\t    }\n223\t    let (sign, rest) = if let Some(stripped) = s.strip_prefix('-') {\n224\t        (-1i64, stripped)\n225\t    } else if let Some(stripped) = s.strip_prefix('+') {\n226\t        (1i64, stripped)\n227\t    } else {\n228\t        (1i64, s)\n229\t    };\n230\t\n231\t    if rest.is_empty() {\n232\t        return None;\n233\t    }\n234\t\n235\t    let parsed = if let Some(stripped) = rest.strip_prefix(\"0x\").or_else(|| rest.strip_prefix(\"0X\")) {\n236\t        i64::from_str_radix(stripped, 16).ok()?\n237\t    } else if let Some(stripped) = rest.strip_prefix('0') {\n238\t        if stripped.is_empty() {\n239\t            0\n240\t        } else {\n241\t            i64::from_str_radix(stripped, 8).ok()?\n242\t        }\n243\t    } else {\n244\t        rest.parse::<i64>().ok()?\n245\t    };\n246\t\n247\t    parsed.checked_mul(sign)\n248\t}\n249\t\n250\t/// Dispatch helper - selects either the user-provided callback or the default.\n251\tfn xop