rg_idx).copied().unwrap_or(\"\");\n158\t                arg_idx += 1;\n159\t                if let Some(c) = val.chars().next() {\n160\t                    outchar(s, &mut len, n, c);\n161\t                }\n162\t            }\n163\t            'd' | 'i' => {\n164\t                let val = args.get(arg_idx).copied().unwrap_or(\"0\");\n165\t                arg_idx += 1;\n166\t                let n_val: i32 = val.parse().unwrap_or(0);\n167\t                fmtint_internal(s, &mut len, n, n_val as i64, 10, width, precision, flags);\n168\t            }\n169\t            'u' => {\n170\t                let val = args.get(arg_idx).copied().unwrap_or(\"0\");\n171\t                arg_idx += 1;\n172\t                let n_val: u64 = val.parse().unwrap_or(0);\n173\t                fmtint_internal(\n174\t                    s,\n175\t                    &mut len,\n176\t                    n,\n177\t                    n_val as i64,\n178\t                    10,\n179\t                    width,\n180\t                    precision,\n181\t                    flags | PRINT_F_UNSIGNED,\n182\t                );\n183\t            }\n184\t            'x' => {\n185\t                let val = args.get(arg_idx).copied().unwrap_or(\"0\");\n186\t                arg_idx += 1;\n187\t                let n_val: u64 = val.parse().unwrap_or(0);\n188\t                fmtint_internal(\n189\t                    s,\n190\t                    &mut len,\n191\t                    n,\n192\t                    n_val as i64,\n193\t                    16,\n194\t                    width,\n195\t                    precision,\n196\t                    flags | PRINT_F_UNSIGNED,\n197\t                );\n198\t            }\n199\t            'X' => {\n200\t                let val = args.get(arg_idx).copied().unwrap_or(\"0\");\n201\t                arg_idx += 1;\n202\t                let n_val: u64 = val.parse().unwrap_or(0);\n203\t                fmtint_internal(\n204\t                    s,\n205\t                    &mut len,\n206\t                    n,\n207\t                    n_val as i64,\n208\t                    16,\n209\t                    width,\n210\t                    precision,\n211\t                    flags | PRINT_F_UNSIGNED | PRINT_F_UP,\n212\t                );\n213\t            }\n214\t            'o' => {\n215\t                let val = args.get(arg_idx).copied().unwrap_or(\"0\");\n216\t                arg_idx += 1;\n217\t                let n_val: u64 = val.parse().unwrap_or(0);\n218\t                fmtint_internal(\n219\t                    s,\n220\t                    &mut len,\n221\t                    n,\n222\t                    n_val as i64,\n223\t                    8,\n224\t                    width,\n225\t                    precision,\n226\t                    flags | PRINT_F_UNSIGNED,\n227\t                );\n228\t            }\n229\t            'f' | 'F' | 'e' | 'E' | 'g' | 'G' => {\n230\t                let val = args.get(arg_idx).copied().unwrap_or(\"0\");\n231\t                arg_idx += 1;\n232\t                let f_val: f64 = val.parse().unwrap_or(0.0);\n233\t                let prec = if precision < 0 { 6 } else { precision as usize };\n234\t                fmtflt_internal(s, &mut len, n, f_val, width, prec, flags);\n235\t            }\n236\t            _ => {\n237\t                // Unknown conversion: skip silently.\n238\t            }\n239\t        }\n240\t    }\n241\t\n242\t    len as i32\n243\t}\n244\t\n245\t/// Public wrapper used by other tests.  It mirrors the public signature.\n246\tpub fn fmtstr(s: &mut String, size: usize, value: &str, width: usize, precision: usize, flags: i32) {\n247\t    let mut len = s.chars().count();\n248\t    fmtstr_chars(s, &mut len, size, value, width, precision, flags);\n249\t}\n250\t\n251\tfn fmtstr_chars(\n252\t    s: &mut String,\n253\t    len: &mut usize,\n254\t    size: usize,\n255\t    value: &str,\n256\t    width: usize,\n257\t    precision: usize,\n258\t    flags: i32,\n259\t) {\n260\t    let chars: Vec<char> = value.chars().collect();\n261\t    let strln = chars.len().min(precision);\n262\t\n263\t    let mut padlen: i64 = width as i64 - strln as i64;\n264\t    if padlen < 0 {\n265\t        padlen = 0;\n266\t    }\n267\t    if (flags & PRINT_F_MINUS) != 0 {\n268\t        padlen = -padlen;\n269\t    }\n270\t\n271\t    while padlen > 0 {\n272\t        outchar(s, len, size, ' ');\n273\t        padlen -= 1;\n274\t    }\n275\t    let mut emitted = 0;\n276\t    for c in chars {\n277\t        if emitted >= precision {\n278\t            break;\n279\t        }\n280\t        outchar(s, len, size, c);\n281\t        emitted += 1;\n282\t    }\n283\t    while padlen < 0 {\n284\t        outchar(s, len, size, ' ');\n285\t        padlen += 1;\n286\t    }\n287\t}\n288\t\n289\t/// Public wrapper for `fmtint`, matching the documented signature.\n290\tpub fn fmtint(s: &mut String, size: usize, value: i32, width: usize, precision: usize, flags: i32) {\n291\t    let mut len = s.chars().count();\n292\t    let prec = if precision == usize::MAX {\n293\t        -1\n294\t    } else {\n295\t        precision as i32\n296\t    };\n297\t    fmtint_internal(s, &mut len, size, value as i64, 10, width, prec, flags);\n298\t}\n299\t\n300\tfn fmtint_internal(\n301\t    s: &mut String,\n302\t    len: &mut usize,\n303\t    size: usize,\n304\t    value: i64,\n305\t    base: i32,\n306\t    width: usize,\n307\t    precision: i32,\n308\t    flags: i32,\n309\t) {\n310\t    let mut sign: char = '\\0';\n311\t    let unsigned_flag = (flags & PRINT_F_UNSIGNED) != 0;\n312\t    let uvalue: u64 = if unsigned_flag {\n313\t        value as u64\n314\t    } else if value >= 0 {\n315\t        value as u64\n316\t    } else {\n317\t        (-(value as i128)) as u64\n318\t    };\n319\t\n320\t    if !unsigned_flag {\n321\t        if value < 0 {\n322\t            sign = '-';\n323\t        } else if (flags & PRINT_F_PLUS) != 0 {\n324\t            sign = '+';\n325\t        } else if (flags & PRINT_F_SPACE) != 0 {\n326\t            sign = ' ';\n327\t        }\n328\t    }\n329\t\n330\t    let mut iconvert = String::new();\n331\t    let pos = convert_internal(uvalue as usize, &mut iconvert, base as usize, (flags & PRINT_F_UP) as usize);\n332\t\n333\t    let mut hexprefix: char = '\\0';\n334\t    let mut precision = precision;\n335\t    if (flags & PRINT_F_NUM) != 0 && uvalue != 0 {\n336\t        match base {\n337\t            8 => {\n338\t                if precision <= pos as i32 {\n339\t                    precision = pos as i32 + 1;\n340\t                }\n341\t            }\n342\t            16 => {\n343\t                hexprefix = if (flags & PRINT_F_UP) != 0 { 'X' } else { 'x' };\n344\t            }\n345\t            _ => {}\n346\t        }\n347\t    }\n348\t\n349\t    let noprecision = precision == -1;\n350\t    let separators = 0;\n351\t    let mut zpadlen: i64 = if noprecision {\n352\t        0\n353\t    } else {\n354\t        precision as i64 - pos as i64\n355\t    };\n356\t    let max_pos_prec = if noprecision { pos as i64 } else { (precision as i64).max(pos as i64) };\n357\t    let mut spadlen: i64 = width as i64\n358\t        - separators\n359\t        - max_pos_prec\n360\t        - if sign != '\\0' { 1 } else { 0 }\n361\t        - if hexprefix != '\\0' { 2 } else { 0 };\n362\t\n363\t    if zpadlen < 0 {\n364\t        zpadlen = 0;\n365\t    }\n366\t    if spadlen < 0 {\n367\t        spadlen = 0;\n368\t    }\n369\t\n370\t    if (flags & PRINT_F_MINUS) != 0 {\n371\t        spadlen = -spadlen;\n372\t    } else if (flags & PRINT_F_ZERO) != 0 && noprecision {\n373\t        zpadlen += spadlen;\n374\t        spadlen = 0;\n375\t    }\n376\t\n377\t    while spadlen > 0 {\n378\t        outchar(s, len, size, ' ');\n379\t        spadlen -= 1;\n380\t    }\n381\t    if sign != '\\0' {\n382\t        outchar(s, len, size, sign);\n383\t    }\n384\t    if hexprefix != '\\0' {\n385\t        outchar(s, len, size, '0');\n386\t        outchar(s, len, size, hexprefix);\n387\t   