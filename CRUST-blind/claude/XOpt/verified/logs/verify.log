_snprintf(buf, sizeof(buf), \"%c\", 'A');\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    r = rpl_snprintf(buf, sizeof(buf), \"%o\", 8);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    r = rpl_snprintf(buf, sizeof(buf), \"%x\", 255);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    r = rpl_snprintf(buf, sizeof(buf), \"%X\", 255);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    r = rpl_snprintf(buf, sizeof(buf), \"%u\", 42);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    r = rpl_snprintf(buf, sizeof(buf), \"100%% done\");\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    r = rpl_snprintf(buf, sizeof(buf), \"%f\", 3.14);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    r = rpl_snprintf(buf, sizeof(buf), \"%.2f\", 3.14159);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    // The %.*s test\n    r = rpl_snprintf(buf, sizeof(buf), \"invalid option: --%.*s\", 4, \"abcdef\");\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    // Multiple types\n    r = rpl_snprintf(buf, sizeof(buf), \"name=%s, value=%d\", \"foo\", 42);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    // Format with width\n    r = rpl_snprintf(buf, sizeof(buf), \"%-10s [%d]\", \"abc\", 99);\n    printf(\"[%s] (%d)\\n\", buf, r);\n\n    return 0;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":11,"lines":["+#define HAVE_STDARG_H 1","+#define HAVE_STDLIB_H 1","+#define HAVE_VASPRINTF_H 1","+#define HAVE_ASPRINTF_H 1","+"," #include <stdarg.h>"," #include <stdio.h>","+#include <stdlib.h>"," #include <string.h>"," "," #include \"/tmp/harvest-crust-verify-gCe872/project/c_src/snprintf.c\""]}],"userModified":false,"replaceAll":false}}
