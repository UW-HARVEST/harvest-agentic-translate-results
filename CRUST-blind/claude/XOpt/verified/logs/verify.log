37\t\tif (options && options->suffix) {\n238\t\t\tfprintf(stream, \"%s%s\\n\", nl, options->suffix);\n239\t\t}\n240\t}\n241\t\n242\tstatic void _xopt_set_err(const char **err, const char *const fmt, ...) {\n243\t\tva_list list;\n244\t\tva_start(list, fmt);\n245\t\trpl_vsnprintf(&errbuf[0], ERRBUF_SIZE, fmt, list);\n246\t\tva_end(list);\n247\t\t*err = &errbuf[0];\n248\t}\n249\t\n250\tstatic bool _xopt_parse_arg(xoptContext *ctx, int argc, const char **argv,\n251\t\t\tint *argi, void *data, const char **err) {\n252\t\tint size;\n253\t\tsize_t length;\n254\t\tbool isExtra = false;\n255\t\tconst char* arg = argv[*argi];\n256\t\n257\t\t/* are we in doubledash mode? */\n258\t\tif (ctx->doubledash) {\n259\t\t\treturn true;\n260\t\t}\n261\t\n262\t\t/* get argument 'size' (long/short/extra) */\n263\t\tsize = _xopt_get_size(arg);\n264\t\n265\t\t/* adjust to parse from beginning of actual content */\n266\t\targ += size;\n267\t\tlength = strlen(arg);\n268\t\n269\t\tif (size == 1 && length == 0) {\n270\t\t\t/* it's just a singular dash - treat it as an extra arg */\n271\t\t\treturn true;\n272\t\t}\n273\t\n274\t\tif (size == 2 && length == 0) {\n275\t\t\t/* double-dash - everything after this is an extra */\n276\t\t\tctx->doubledash = 1;\n277\t\t\treturn false;\n278\t\t}\n279\t\n280\t\tswitch (size) {\n281\t\t\tconst xoptOption *option;\n282\t\t\tint argRequirement;\n283\t\t\tchar *valStart;\n284\t\tcase 1: /* short */\n285\t\t\tif (length > 1 && ctx->flags & XOPT_CTX_NOCONDENSE) {\n286\t\t\t\t/* invalid argument? */\n287\t\t\t\t_xopt_set_err(err, \"short options cannot be combined: %s\", argv[*argi]);\n288\t\t\t} else if (length > 1 && ctx->flags & XOPT_CTX_SLOPPYSHORTS) {\n289\t\t\t\t/* get argument or error if not found and strict mode enabled. */\n290\t\t\t\targRequirement = _xopt_get_arg(arg, 1, ctx->options, size, &option);\n291\t\t\t\tif (!option) {\n292\t\t\t\t\tif (ctx->flags & XOPT_CTX_STRICT) {\n293\t\t\t\t\t\t_xopt_set_err(err, \"invalid option: -%c\", arg[0]);\n294\t