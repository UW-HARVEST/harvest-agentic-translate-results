        tm.tm_sec = 0;","+    }","+    tm.tm_hour = hour % 12;"," }","-pub fn date_never(tm: &mut Atm, now: &mut Atm, num: &mut i32) {","-    unimplemented!()","+","+pub fn date_never(tm: &mut Atm, _now: &mut Atm, _num: &mut i32) {","+    localtime_r_atm(0, tm);"," }","+"," pub struct Special {","     pub name: &'static str,","-    pub fn_ptr: fn(&mut Atm, &mut Atm, &mut i32), // Use function pointer","+    pub fn_ptr: fn(&mut Atm, &mut Atm, &mut i32),"," }"," pub static SPECIAL: &[Special] = &[","     Special { name: \"yesterday\", fn_ptr: date_yesterday },"]},{"oldStart":159,"oldLines":20,"newStart":850,"newLines":6,"lines":["     Special { name: \"never\", fn_ptr: date_never },","     Special { name: \"now\", fn_ptr: date_now },"," ];","-// pub struct Special {","-//     pub name: &'static str,","-//     pub fn_ptr: fn(&mut Atm, TimeT, &mut i32),","-// }","-// pub const SPECIAL: &[Special] = &[","-//     Special { name: \"yesterday\", fn_ptr: date_yesterday },","-//     Special { name: \"noon\", fn_ptr: date_noon },","-//     Special { name: \"midnight\", fn_ptr: date_midnight },","-//     Special { name: \"tea\", fn_ptr: date_tea },","-//     Special { name: \"PM\", fn_ptr: date_pm },","-//     Special { name: \"AM\", fn_ptr: date_am },","-//     Special { name: \"never\", fn_ptr: date_never },","-//     Special { name: \"now\", fn_ptr: date_now },","-// ];"," pub const NUMBER_NAME: [&str; 11] = [","     \"zero\", \"one\", \"two\", \"three\", \"four\", \"five\", \"six\", \"seven\", \"eight\", \"nine\", \"ten\""," ];"]},{"oldStart":187,"oldLines":21,"newStart":864,"newLines":245,"lines":["     TypeLen { type_name: \"days\", length: 24 * 60 * 60 },","     TypeLen { type_name: \"weeks\", length: 7 * 24 * 60 * 60 },"," ];","+"," pub fn approxidate_alpha(date: &str, tm: &mut Atm, now: &mut Atm, num: &i32, touched: &i32) -> String {","-    unimplemented!()","+    // The signatures in the source here are odd (immutable references for things","+    // the C code mutates