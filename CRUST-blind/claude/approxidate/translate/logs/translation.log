- tm.tm_sec.rem_euclid(60) as i64);","+    match Local.from_local_datetime(&ndt).single() {","+        Some(d) => d.timestamp() + extra_secs,","+        None => {","+            // ambiguous (DST); use earliest","+            match Local.from_local_datetime(&ndt).earliest() {","+                Some(d) => d.timestamp() + extra_secs,","+                None => -1,","+            }","+        }","+    }","+}","+"," pub fn match_digit(date: &str, tm: &mut Atm, offset: &mut i32, tm_gmt: &mut i32) -> i32 {","-    unimplemented!()","+    let b = date.as_bytes();","+    let (num, end) = parse_u64(b);","+","+    if num >= 100000000 && nodate(tm) != 0 {","+        let time = num as i64;","+        if gmtime_r_atm(time, tm) {","+            *tm_gmt = 1;","+            return end as i32;","+        }","+    }","+","+    if end < b.len() {","+        let cend = b[end];","+        if cend == b':' || cend == b'.' || cend == b'/' || cend == b'-' {","+            if end + 1 < b.len() && is_digit_byte(b[end + 1]) {","+                let tail = &date[end..];","+                let m = match_multi_number(num, cend as char, date, tail, tm, 0);","+                if m != 0 {","+                    return m;","+                }","+            }","+        }","+    }","+","+    let mut n = 0;","+    loop {","+        n += 1;","+        if n >= b.len() || !is_digit_byte(b[n]) {","+            break;","+        }","+    }","+","+    if n == 4 {","+        if num <= 1400 && *offset == -1 {","+            let minutes = (num % 100) as i32;","+            let hours = (num / 100) as i32;","+            *offset = hours * 60 + minutes;","+        } else if num > 1900 && num < 2100 {","+            tm.tm_year = num as i32 - 1900;","+        }","+        return n as i32;","+    }","+","+    if n > 2 {","+        return n as i32;","+    }","+","+    if num > 0 && num < 32 && tm.tm_mday < 0 {","+        tm.tm_mday = num as i32;","+        return n as i32;","+    }","+","+    if n == 2 && tm.tm_year < 0 {","+        if num < 10 && tm.tm_mday >= 0 {","+            tm.tm_year = num as i32 + 100;","+            return n as i32;","+        }","+        if num >= 70 {","+            tm.tm_year = num as i32;","+            return n as i32;","+        }","+    }","+","+    if num > 0 && num < 13 && tm.tm_mon < 0 {","+        tm.tm_mon = num as i32 - 1;","+    }","+","+    n as i32"," }","+"," pub fn match_tz(date: &str, offp: &mut i32) -> i32 {","-    unimplemented!()","+    let b = date.as_bytes();","+    let (hr, end) = strtoul_unsigned(b, 1);","+    let mut hour = hr as i32;","+    let n = end - 1;","+    let mut min: i32 = 0;","+    let mut end_pos = end;","+","+    if n == 4 {","+        min = hour % 100;","+        hour = hour / 100;","+    } else if n != 2 {","+        min = 99;","+    } else if end_pos < b.len() && b[end_pos] == b':' {","+        let (m, ep) = strtoul_unsigned(b, end_pos + 1);","+        min = m as i32;","+        end_pos = ep;","+        if end_pos as i64 - 1 != 5 {","+            min = 99;","+        }","+    }","+","+    if min < 60 && hour < 24 {","+        let mut offset = hour * 60 + min;","+        if b[0] == b'-' {","+            offset = -offset;","+        }","+        *offp = offset;","+    }","+    end_pos as i32"," }","+"," pub fn match_object_header_date(date: &str, tv: &mut TimeVal, offset: &mut i32) -> i32 {","-    unimplemented!()","+    let b = date.as_bytes();","+    if b.is_empty() || b[0] < b'0' || b[0] > b'9' {","+        return -1;","+    }","+    let (stamp, end) = strtoul_unsigned(b, 0);","+    if end >= b.len() || b[end] != b' ' || stamp == u64::MAX {","+        return -1;","+    }","+    if end + 1 >= b.len() || (b[end + 1] != b'+' && b[end + 1] != b'-') {","+        return -1;","+    }","+    let sign_pos = end + 1;","+    let parse_start = end + 2;","+    let (ofs, end2) = strtol_signed(b, parse_start);","+    // Equivalent to: end != date + 4 (relative to start = parse_start)","+    if end2 != parse_start + 4 {","