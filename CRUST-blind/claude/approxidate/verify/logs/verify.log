ar = -1; tm.tm_mon = -1; tm.tm_mday = -1;\n        int r = is_date(year, month, day, NULL, 0, &tm);\n        printf(\"r=%d year=%d mon=%d mday=%d\\n\", r, tm.tm_year, tm.tm_mon, tm.tm_mday);\n    } else if (strcmp(argv[1], \"parse_date_basic\") == 0) {\n        struct timeval tv = {0,0};\n        int offset = -1;\n        int rc = parse_date_basic(argv[2], &tv, &offset);\n        printf(\"rc=%d sec=%lld usec=%ld offset=%d\\n\", rc, (long long)tv.tv_sec, (long)tv.tv_usec, offset);\n    } else if (strcmp(argv[1], \"approxidate_relative\") == 0) {\n        struct timeval tv = {0,0};\n        struct timeval tv_rel;\n        tv_rel.tv_sec = atoll(argv[3]);\n        tv_rel.tv_usec = 0;\n        int rc = approxidate_relative(argv[2], &tv, &tv_rel);\n        printf(\"rc=%d sec=%lld usec=%ld\\n\", rc, (long long)tv.tv_sec, (long)tv.tv_usec);\n    } else if (strcmp(argv[1], \"match_alpha\") == 0) {\n        struct atm tm;\n        memset(&tm, 0, sizeof(tm));\n        tm.tm_year = -1; tm.tm_mon = -1; tm.tm_mday = -1; tm.tm_hour = -1;\n        tm.tm_min = -1; tm.tm_sec = -1;\n        int offset = -1;\n        int r = match_alpha(argv[2], &tm, &offset);\n        printf(\"r=%d mon=%d wday=%d hour=%d offset=%d\\n\", r, tm.tm_mon, tm.tm_wday, tm.tm_hour, offset);\n    } else if (strcmp(argv[1], \"match_alpha_PM\") == 0) {\n        // Test PM with prefilled hour\n        struct atm tm;\n        memset(&tm, 0, sizeof(tm));\n        tm.tm_year = -1; tm.tm_mon = -1; tm.tm_mday = -1;\n        tm.tm_hour = atoi(argv[3]);\n        tm.tm_min = -1; tm.tm_sec = -1;\n        int offset = -1;\n        int r = match_alpha(argv[2], &tm, &offset);\n        printf(\"r=%d hour=%d\\n\", r, tm.tm_hour);\n    } else if (strcmp(argv[1], \"match_digit\") == 0) {\n        struct atm tm;\n        memset(&tm, 0, sizeof(tm));\n        tm.tm_year = -1; tm.tm_mon = -1; tm.tm_mday = -1; tm.tm_hour = -1;\n        tm.tm_min = -1; tm.tm_sec = -1;\n        int offset = -1;\n        int tm_gmt = 0;\n        int r = match_digit(argv[2], &tm, &offset, &tm_gmt);\n        printf(\"r=%d year=%d mon=%d mday=%d hour=%d min=%d sec=%d offset=%d gmt=%d\\n\",\n               r, tm.tm_year, tm.tm_mon, tm.tm_mday, tm.tm_hour, tm.tm_min, tm.tm_sec, offset, tm_gmt);\n    } else if (strcmp(argv[1], \"nodate\") == 0) {\n        struct atm tm;\n        memset(&tm, 0, sizeof(tm));\n        tm.tm_year = atoi(argv[2]);\n        tm.tm_mon = atoi(argv[3]);\n        tm.tm_mday = atoi(argv[4]);\n        tm.tm_hour = atoi(argv[5]);\n        tm.tm_min = atoi(argv[6]);\n        tm.tm_sec = atoi(argv[7]);\n        printf(\"%d\\n\", nodate((struct tm*)&tm));\n    } else {\n        return 2;\n    }\n    return 0;\n}\nEOF\ngcc -O0 -std=c11 -D_GNU_SOURCE test_func_helper.c -o test_func_helper -lm 2>&1 | head -20","description":"Compile function helper"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":200,"cache_read_input_tokens":51182,"cache_creation":{"ephemeral_5m_input_tokens":200,"ephemeral_1h_input_tokens":0},"output_tokens":40,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"abb1af17-b48e-4456-b720-acc9f3ac7733","uuid":"ed5650e0-bc87-427b-92aa-9988f4aee830"}
