;\n        int num = 0;\n        date_now(&tm, &now, &num);\n        printf(\"hour=%d min=%d sec=%d mday=%d mon=%d year=%d\\n\",\n               tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_mday, tm.tm_mon, tm.tm_year);\n    } else if (strcmp(argv[1], \"date_yesterday\") == 0) {\n        time_t now_t = atoll(argv[2]);\n        struct atm tm, now;\n        memset(&tm, 0, sizeof(tm));\n        memset(&now, 0, sizeof(now));\n        localtime_r(&now_t, (struct tm*)&tm);\n        now = tm;\n        tm.tm_mday = -1; tm.tm_mon = -1; tm.tm_year = -1;\n        int num = 0;\n        date_yesterday(&tm, &now, &num);\n        printf(\"hour=%d min=%d sec=%d mday=%d mon=%d year=%d\\n\",\n               tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_mday, tm.tm_mon, tm.tm_year);\n    } else if (strcmp(argv[1], \"date_midnight\") == 0) {\n        time_t now_t = atoll(argv[2]);\n        struct atm tm, now;\n        memset(&tm, 0, sizeof(tm));\n        memset(&now, 0, sizeof(now));\n        localtime_r(&now_t, (struct tm*)&tm);\n        now = tm;\n        tm.tm_mday = -1; tm.tm_mon = -1; tm.tm_year = -1;\n        int num = 0;\n        date_midnight(&tm, &now, &num);\n        printf(\"hour=%d min=%d sec=%d mday=%d mon=%d year=%d\\n\",\n               tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_mday, tm.tm_mon, tm.tm_year);\n    } else if (strcmp(argv[1], \"date_noon\") == 0) {\n        time_t now_t = atoll(argv[2]);\n        struct atm tm, now;\n        memset(&tm, 0, sizeof(tm));\n        memset(&now, 0, sizeof(now));\n        localtime_r(&now_t, (struct tm*)&tm);\n        now = tm;\n        tm.tm_mday = -1; tm.tm_mon = -1; tm.tm_year = -1;\n        int num = 0;\n        date_noon(&tm, &now, &num);\n        printf(\"hour=%d min=%d sec=%d mday=%d mon=%d year=%d\\n\",\n               tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_mday, tm.tm_mon, tm.tm_year);\n    } else if (strcmp(argv[1], \"date_tea\") == 0) {\n        time_t now_t = atoll(argv[2]);\n        struct atm tm, now;\n        memset(&tm, 0, sizeof(tm));\n        memset(&now, 0, sizeof(now));\n        localtime_r(&now_t, (struct tm*)&tm);\n        now = tm;\n        tm.tm_mday = -1; tm.tm_mon = -1; tm.tm_year = -1;\n        int num = 0;\n        date_tea(&tm, &now, &num);\n        printf(\"hour=%d min=%d sec=%d mday=%d mon=%d year=%d\\n\",\n               tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_mday, tm.tm_mon, tm.tm_year);\n    } else if (strcmp(argv[1], \"date_never\") == 0) {\n        struct atm tm, now;\n        memset(&tm, 0, sizeof(tm));\n        memset(&now, 0, sizeof(now));\n        tm.tm_year = 99; tm.tm_mon = 5; tm.tm_mday = 15;\n        tm.tm_hour = 12; tm.tm_min = 30; tm.tm_sec = 0;\n        int num = 0;\n        date_never(&tm, &now, &num);\n        printf(\"hour=%d min=%d sec=%d mday=%d mon=%d year=%d\\n\",\n               tm.tm_hour, tm.tm_min, tm.tm_sec, tm.tm_mday, tm.tm_mon, tm.tm_year);\n    }\n    return 0;\n}\nEOF\ngcc -O0 -std=c11 -D_GNU_SOURCE test_helpers2.c -o test_helpers2 -lm 2>&1 | head -5\n./test_helpers2 approxidate_str \"yesterday\" 1577910617\n./test_helpers2 approxidate_str \"noon\" 1577910617\n./test_helpers2 approxidate_str \"\" 1577910617\n./test_helpers2 update_tm 1577910617 0\n./test_helpers2 update_tm 1577910617 86400\n./test_helpers2 date_now 1577910617\n./test_helpers2 date_yesterday 1577910617\n./test_helpers2 date_midnight 1577910617\n./test_helpers2 date_noon 1577910617\n./test_helpers2 date_tea 1577910617\n./test_helpers2 date_never","description":"Test more helpers"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":578,"cache_read_input_tokens":114552,"cache_creation":{"ephemeral_5m_input_tokens":578,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"abb1af17-b48e-4456-b720-acc9f3ac7733","uuid":"c45a5599-6835-47d7-94a3-97e303cc24f5"}
