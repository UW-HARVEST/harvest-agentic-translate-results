{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014UuKmdPRt72VzDVFpF2EZw","type":"tool_result","content":"1\t#![allow(non_snake_case)]\n2\tuse LTRE::ltre::*;\n3\t\n4\t#[derive(Default, Clone)]\n5\tstruct TArgs {\n6\t    regex: &'static str,\n7\t    input: &'static str,\n8\t    matches: bool,\n9\t    errors: bool,\n10\t    partial: bool,\n11\t    ignorecase: bool,\n12\t    complement: bool,\n13\t    quick: bool,\n14\t}\n15\t\n16\tfn t(args: TArgs) {\n17\t    let parsed = ltre_parse(args.regex);\n18\t    if parsed.is_err() != args.errors {\n19\t        eprintln!(\n20\t            \"FAIL: /{}/ parse (err={:?}, expected_err={})\",\n21\t            args.regex,\n22\t            parsed.as_ref().err(),\n23\t            args.errors\n24\t        );\n25\t        return;\n26\t    }\n27\t    let mut nfa = match parsed {\n28\t        Ok(n) => n,\n29\t        Err(_) => return,\n30\t    };\n31\t    if args.partial {\n32\t        ltre_partial(&mut nfa).unwrap();\n33\t    }\n34\t    if args.ignorecase {\n35\t        ltre_ignorecase(&mut nfa).unwrap();\n36\t    }\n37\t    if args.complement {\n38\t        ltre_complement(&mut nfa);\n39\t    }\n40\t    let dfa = ltre_compile(nfa.clone());\n41\t\n42\t    // Round-trip via serialize\n43\t    let buf = dfa_serialize(&dfa);\n44\t    let (dfa2, _) = dfa_deserialize(&buf).unwrap();\n45\t    let nfa2 = ltre_uncompile(&dfa2);\n46\t    let dfa3 = ltre_compile(nfa2.clone());\n47\t\n48\t    let final_dfa = if !args.quick {\n49\t        let re = ltre_decompile(&dfa3);\n50\t        match ltre_parse(&re) {\n51\t            Ok(n) => ltre_compile(n),\n52\t            Err(e) => {\n53\t                eprintln!(\"FAIL: /{}/ decompile-reparse: {} for {:?}\", args.regex, e, re);\n54\t                dfa3\n55\t            }\n56\t        }\n57\t    } else {\n58\t        dfa3\n59\t    };\n60\t\n61\t    let actual = ltre_matches(&final_dfa, args.input.as_bytes());\n62\t    let mut ldfa = None;\n63\t    let lazy_actual = ltre_matches_lazy(&mut ldfa, &nfa, args.input.as_bytes());\n64\t    if actual != args.matches {\n65\t        eprintln!(\n66\t            \"FAIL: /{}/ against '{}' expected {} got {}\",\n67\t            args.regex, args.input, args.matches, actual\n68\t        );\n69\t    }\n70\t    if lazy_actual != args.matches {\n71\t        eprintln!(\n72\t            \"FAIL LAZY: /{}/ against '{}' expected {} got {}\",\n73\t            args.regex, args.input, args.matches, lazy_actual\n74\t        );\n75\t    }\n76\t}\n77\t\n78\tmacro_rules! test {\n79\t    ($($field:ident: $val:expr),* $(,)?) => {\n80\t        t(TArgs { $($field: $val,)* ..Default::default() })\n81\t    };\n82\t}\n83\t\n84\tfn main() {\n85\t    // catastrophic backtracking\n86\t    test!(regex: \"(a*)*c\", input: \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", matches: false);\n87\t    test!(regex: \"(x+x+)+y\", input: \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\", matches: false);\n88\t\n89\t    // determinization state blowout\n90\t    test!(regex: \"[01]*1[01]{8}\", input: \"11011100011100\", matches: true, quick: true);\n91\t    test!(regex: \"[01]*1[01]{8}\", input: \"01010010010010\", matches: false, quick: true);\n92\t\n93\t    // powerset construction state blowout\n94\t    test!(regex: \".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", input: \"\", matches: false);\n95\t    test!(regex: \".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", input: \"123\", matches: true);\n96\t\n97\t    // potential edge cases\n98\t    test!(regex: \"abba\", input: \"abba\", matches: true);\n99\t    test!(regex: \"[ab]+\", input: \"abba\", matches: true);\n100\t    test!(regex: \"[ab]+\", input: \"abc\", matches: false);\n101\t    test!(regex: \".*\", input: \"abba\", matches: true);\n102\t    test!(regex: \"(a|b+){3}\", input: \"abbba\", matches: true);\n103\t    test!(regex: \"(a|b+){3}\", input: \"abbab\", matches: false);\n104\t    test!(regex: \"\\\\x61\\\\+\", input: \"a+\", matches: true);\n105\t    test!(regex: \"\", input: \"\", matches: true);\n106\t    test!(rege