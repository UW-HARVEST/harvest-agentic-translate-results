7\t  // partial, ignorecase, complement\n168\t  test(\"\", \"\", true, .partial = true);\n169\t  test(\"\", \"abc\", true, .partial = true);\n170\t  test(\"b\", \"abc\", true, .partial = true);\n171\t  test(\"ba\", \"abc\", false, .partial = true);\n172\t  test(\"abc\", \"abc\", true, .partial = true);\n173\t  test(\"[]\", \"\", false, .partial = true);\n174\t  test(\"\", \"\", true, .ignorecase = true);\n175\t  test(\"abCdEF\", \"aBCdEf\", true, .ignorecase = true);\n176\t  test(\"ab\", \"abc\", false, .ignorecase = true);\n177\t  test(\"a\", \"\", true, .complement = true);\n178\t  test(\"a\", \"aa\", true, .complement = true);\n179\t  test(\"a\", \"a\", false, .complement = true);\n180\t  test(\"ab*\", \"ac\", true, .complement = true);\n181\t  test(\"ab*\", \"abb\", false, .complement = true);\n182\t\n183\t  // decompilation edge cases\n184\t  test(\"^aa*\", \"ba\", true);\n185\t  test(\"a-zz*\", \"abc\", false);\n186\t  test(\"\\\\x0a(0a)*\", \"\\x0a\", true);\n187\t  test(\"\\\\x0aa*\", \"\\x0a\\x0a\", false);\n188\t\n189\t  // parse errors\n190\t  test(\"abc]\", .errors = true);\n191\t  test(\"[abc\", .errors = true);\n192\t  test(\"abc)\", .errors = true);\n193\t  test(\"(abc\", .errors = true);\n194\t  test(\"+a\", .errors = true);\n195\t  test(\"a|*\", .errors = true);\n196\t  test(\"\\\\x0\", .errors = true);\n197\t  test(\"\\\\zzz\", .errors = true);\n198\t  test(\"[a\\\\x]\", .errors = true);\n199\t  test(\"\\b\", .errors = true);\n200\t  test(\"\\t\", .errors = true);\n201\t  test(\"^^a\", .errors = true);\n202\t  test(\"a**\", .errors = true);\n203\t  test(\"a*+\", .errors = true);\n204\t  test(\"a*?\", .errors = true);\n205\t  test(\"a+*\", .errors = true);\n206\t  test(\"a++\", .errors = true);\n207\t  test(\"a+?\", .errors = true);\n208\t  test(\"a?*\", .errors = true);\n209\t  test(\"a?+\", .errors = true);\n210\t  test(\"a??\", .errors = true);\n211\t#define NAT_OVF \"9999999999999999999999999999999999999999\"\n212\t  test(\"a{\" NAT_OVF \"}\", .