{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PFi2htU5edrDX9RWSKvyKJ","type":"tool_result","content":"1\tuse core::cmp::Ordering;\n2\tuse std::collections::hash_map::DefaultHasher;\n3\tuse std::hash::{Hash as StdHash, Hasher};\n4\tuse std::sync::Mutex;\n5\t/// A collection of constants matching the original C #defines.\n6\tpub const HASH_MOD: u64 = 1000000007;\n7\tpub const HASH_BASE: u64 = 256;\n8\tpub const DEFAULT_STEP: usize = 2;\n9\tpub const DEFAULT_MOD: usize = 8;\n10\t/// Enum corresponding to the C enum `dict_type_t`.\n11\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n12\tpub enum DictType {\n13\tChar,\n14\tWChar,\n15\tI32,\n16\tU32,\n17\tF32,\n18\tI64,\n19\tU64,\n20\tF64,\n21\tPtr,\n22\tStr,\n23\tStruct,\n24\t}\n25\t/// A safe function pointer type for deep-copying values.\n26\tpub type DictDeepCopy = fn(dest: &mut [u8], src: &[u8]);\n27\t/// A safe function pointer type for destructors.\n28\tpub type DictDestructor = fn(data: &mut [u8]);\n29\t/// A safe function pointer type for comparisons.\n30\tpub type DictCmpr = fn(a: &[u8], b: &[u8]) -> i32;\n31\t/// A safe function pointer type for hashing.\n32\tpub type DictHash = fn(data: &[u8]) -> u64;\n33\t/// A safe function pointer type for memory allocation (unused in safe Rust).\n34\tpub type DictMalloc = fn(size: usize) -> Vec<u8>;\n35\t/// A safe function pointer type for freeing allocated memory (unused in safe Rust).\n36\tpub type DictFree = fn(_: Vec<u8>);\n37\t/// Corresponds to `dict_alloc_t` in C.\n38\t#[derive(Clone)]\n39\tpub struct DictAlloc {\n40\tpub malloc: Option<DictMalloc>,\n41\tpub free: Option<DictFree>,\n42\t}\n43\t/// Corresponds to `dict_key_attr_t` in C.\n44\t#[derive(Clone)]\n45\tpub struct DictKeyAttr {\n46\tpub type_: DictType,\n47\tpub size: usize,\n48\tpub copy: Option<DictDeepCopy>,\n49\tpub free: Option<DictDestructor>,\n50\tpub hash: Option<DictHash>,\n51\tpub cmpr: Option<DictCmpr>,\n52\t}\n53\t/// Corresponds to `dict_val_attr_t` in C.\n54\t#[derive(Clone)]\n55\tpub struct DictValAttr {\n56\tpub size: usize,\n57\tpub free: Option<DictDestructor>,\n58\t}\n59\t/// Corresponds to `dict_args_t` in C.\n60\t#[derive(Clone)]\n61\tpub struct DictArgs {\n62\tpub key: DictKeyAttr,\n63\tpub val: DictValAttr,\n64\tpub alloc: DictAlloc,\n65\t}\n66\t/// Each element in the dictionary. Mirrors the struct dict_elem in C.\n67\t/// We store the key bytes in `key` and the value bytes in `val`.\n68\t#[derive(Clone)]\n69\tpub struct DictElem {\n70\tpub code: u64,    // The hash code\n71\tpub key: Vec<u8>, // Owned bytes for the key\n72\tpub val: Vec<u8>, // Owned bytes for the value\n73\t}\n74\t/// A bucket (list) in the dictionary. Mirrors dict_list_t in C, but\n75\t/// instead of a linked list, we store a Vec for safe iteration/removal.\n76\t#[derive(Clone)]\n77\tpub struct DictBucket {\n78\tpub elements: Vec<DictElem>,\n79\t}\n80\t/// Corresponds to `struct dict` in C.\n81\tpub struct Dict {\n82\tpub key: DictKeyAttr,\n83\tpub val: DictValAttr,\n84\tpub alloc: DictAlloc,\n85\tpub mod_: usize,              // Number of buckets\n86\tpub buckets: Vec<DictBucket>, // The buckets array\n87\tpub key_temp: Vec<u8>,        // Temporary buffer for constructing a key\n88\tpub keys_dump: Vec<u8>,       // Unused here; effectively replaced by a safe approach\n89\tpub count: usize,             // Number of elements total\n90\t}\n91\t\n92\t// =============================================================================\n93\t// Internal helpers\n94\t// =============================================================================\n95\t\n96\t/// The conventional pointer size used by the original C code (sizeof(uintptr_t)).\n97\tfn ptr_size() -> usize {\n98\t    std::mem::size_of::<usize>()\n99\t}\n100\t\n101\t/// Round `size` up to a multiple of `align`.\n102\tfn align_up(size: usize, align: usize) -> usize {\n103\t    if align == 0 {\n104\t        return size;\n105\t    }\n106\t    (size + align - 1) & !(align - 1)\n107\t}\n108\t\n109\t/// Resolve the byte size of a key based on its type. For `Struct`, the\n110\t/// caller-provided size is rounded up to a pointer-aligned boundary, mirroring\n111\t/// the C implementation.\n112\tfn type_key_size(t: DictType, struct_size: usize) -> usize {\n113\t    match t {\n114\t        DictType::Char => 1,\n115\t        DictType::WChar => 4, // wchar_t is 4 bytes on Linux\n116\t        DictType::I32 | DictType::U32 | DictType::F32 => 4,\n117\t        DictType::I64 | DictType::U64 | DictType::F64 => 8,\n118\t        DictType::Ptr | DictType::Str => ptr_size(),\n119\t        DictType::Struct => align_up(struct_size, ptr_size()),\n120\t    }\n121\t}\n122\t\n123\t/// Build a fresh empty dictionary from `args`, computing the proper key/val\n124\t/// sizes and creating an empty bucket array of `DEFAULT_MOD` buckets.\n125\tfn build_dict(args: DictArgs) -> Dict {\n126\t    let key_size = type_key_size(args.key.type_, args.key.size);\n127\t    let val_size = align_up(args.val.size, ptr_size());\n128\t\n129\t    let mut key_attr = args.key.clone();\n130\t    key_attr.size = key_size;\n131\t\n132\t    let mut val_attr = args.val.clone();\n133\t    val_attr.size = val_size;\n134\t\n135\t    let mod_ = DEFAULT_MOD;\n136\t    let buckets = (0..mod_)\n137\t        .map(|_| DictBucket {\n138\t            elements: Vec::new(),\n139\t        })\n140\t        .collect::<Vec<_>>();\n141\t\n142\t    Dict {\n143\t        key: key_attr,\n144\t        val: val_attr,\n145\t        alloc: args.alloc,\n146\t        mod_,\n147\t        buckets,\n148\t        key_temp: vec![0u8; key_size],\n149\t        keys_dump: Vec::new(),\n150\t        count: 0,\n151\t    }\n152\t}\n153\t\n154\t/// Convert raw user-supplied key bytes into the canonical key representation\n155\t/// stored inside a `DictElem`.\n156\t///\n157\t/// * For `Str`, the input is returned as-is (variable length string bytes).\n158\t/// * For all other types, the input is truncated/zero-padded to exactly\n159\t///   `dict.key.size` bytes.\n160\tfn prepare_key_bytes(dict: &Dict, key_data: &[u8]) -> Vec<u8> {\n161\t    if dict.key.type_ == DictType::Str {\n162\t        return key_data.to_vec();\n163\t    }\n164\t    let mut buf = vec![0u8; dict.key.size];\n165\t    let n = key_data.len().min(dict.key.size);\n166\t    if n > 0 {\n167\t        buf[..n].copy_from_slice(&key_data[..n]);\n168\t    }\n169\t    buf\n170\t}\n171\t\n172\t/// Read the first 4 bytes of `bytes` as a little-endian `u32`.\n173\tfn read_u32(bytes: &[u8]) -> u32 {\n174\t    u32::from_le_bytes([bytes[0], bytes[1], bytes[2], bytes[3]])\n175\t}\n176\t\n177\t/// Compute the hash code for a prepared key.\n178\tfn compute_hash_internal(key_attr: &DictKeyAttr, key: &[u8]) -> u64 {\n179\t    if let Some(h) = key_attr.hash {\n180\t        return h(key);\n181\t    }\n182\t    let mut code: u64 = 0;\n183\t    match key_attr.type_ {\n184\t        DictType::Char => {\n185\t            // C treats char as signed on x86-64 GCC default — sign-extend.\n186\t            code = (key[0] as i8) as i64 as u64;\n187\t        }\n188\t        DictType::WChar => {\n189\t            let v = i32::from_le_bytes([key[0], key[1], key[2], key[3]]);\n190\t            code = v as i64 as u64;\n191\t        }\n192\t        DictType::I32 => {\n193\t            let v = i32::from_le_bytes([key[0], key[1], key[2], key[3]]);\n194\t            code = v as i64 as u64;\n195\t        }\n196\t        DictType::U32 => {\n197\t            let v = u32::from_le_bytes([key[0], key[1], key[2], key[3]]);\n198\t            code = v as u64;\n199\t        }\n200\t        DictType::F32 => {\n201\t            let v = f32::from_le_bytes([key[0], key[1], key[2], key[3]]);\n202\t            // Match C semantics: implicit float-to-uint64 truncation.\n203\t            code = v as u64;\n204\t        }\n205\t        DictType::I64 => {\n206\t            let arr: [u8; 8] = key[..8].try_into().unwrap_or([0u8; 8]);\n207\t            let v = i64::from_le_bytes(arr);\n208\t            code = v as u64;\n209\t        }\n210\t        DictType::U64 => {\n211\t            let arr: [u8; 8] = key[..8].try_into().unwrap_or([0u8; 8]);\n212\t            code = u64::from_le_bytes(arr);\n213\t        }\n214\t        DictType::F64 => {\n215\t            let arr: [u8; 8] = key[..8].try_into().unwrap_or([0u8; 8]);\n216\t            let v = f64::from_le_bytes(arr);\n217\t            code = v as u64;\n218\t        }\n219\t        DictType::Ptr => {\n220\t            let arr: [u8; 8] = key[..8].try_into().unwrap_or([0u8; 8]);\n221\t            code = u64::from_le_bytes(arr);\n222\t        }\n223\t        DictType::Str => {\n224\t            for &b in key {\n225\t                code = (code.wrapping_mul(HASH_BASE).wrapping_add(b as u64)) % HASH_MOD;\n226\t            }\n227\t        }\n228\t        DictType::Struct => {\n229\t            let len = key_attr.size.min(key.len());\n230\t            for &b in &key[..len] {\n231\t                code = (code.wrapping_mul(HASH_BASE).wrapping_add(b as u64)) % HASH_MOD;\n232\t            }\n233\t        }\n234\t    }\n235\t    code\n236\t}\n237\t\n238\t/// Determine if two prepared key buffers represent the same key.\n239\tfn keys_match_internal(key_attr: &DictKeyAttr, a: &[u8], b: &[u8]) -> bool {\n240\t    if let Some(cmpr) = key_attr.cmpr {\n241\t        return cmpr(a, b) == 0;\n242\t    }\n243\t    // For STR keys, compare full slice contents. For others, both buffers\n244\t    // have been normalized to `key_attr.size` bytes by `prepare_key_bytes`.\n245\t    a == b\n246\t}\n247\t\n248\t// =============================================================================\n249\t// Public API\n250\t// =============================================================================\n251\t\n252\t/// Create a dictionary using detailed arguments. Matches C's dict_create().\n253\tpub fn dict_create(args: DictArgs) -> Dict {\n254\t    build_dict(args)\n255\t}\n256\t\n257\t/// Create a dictionary with derived arguments. Matches C's dict_new().\n258\tpub fn dict_new(key_type: DictType, key_size: usize, val_size: usize) -> Dict {\n259\t    let args = DictArgs {\n260\t        key: DictKeyAttr {\n261\t            type_: key_type,\n262\t            size: key_size,\n263\t            copy: None,\n264\t            free: None,\n265\t            hash: None,\n266\t            cmpr: None,\n267\t        },\n268\t        val: DictValAttr {\n269\t            size: val_size,\n270\t            free: None,\n271\t        },\n272\t        alloc: DictAlloc {\n273\t            malloc: None,\n274\t            free: None,\n275\t        },\n276\t    };\n277\t    build_dict(args)\n278\t}\n279\t\n280\t/// Destroy a dictionary. Matches C's dict_destroy().\n281\t/// In Rust, memory is freed automatically, but we emulate calling destructors if provided.\n282\tpub fn dict_destroy(dict: &mut Dict) {\n283\t    let key_copy = dict.key.copy;\n284\t    let key_free = dict.key.free;\n285\t    let val_size = dict.val.size;\n286\t    let val_free = dict.val.free;\n287\t    for bucket in dict.buckets.iter_mut() {\n288\t        for elem in bucket.elements.iter_mut() {\n289\t            if key_copy.is_some() {\n290\t                if let Some(f) = key_free {\n291\t                    f(&mut elem.key);\n292\t                }\n293\t            }\n294\t            if val_size != 0 {\n295\t                if let Some(f) = val_free {\n296\t                    f(&mut elem.val);\n297\t                }\n298\t            }\n299\t        }\n300\t        bucket.elements.clear();\n301\t    }\n302\t    dict.buckets.clear();\n303\t    dict.count = 0;\n304\t}\n305\t\n306\t/// Retrieve or create a value from the dictionary.\n307\tpub fn dict_get<'dict>(dict: &'dict mut Dict, key_data: &[u8]) -> Option<&'dict mut [u8]> {\n308\t    let key_bytes = prepare_key_bytes(dict, key_data);\n309\t    let code = compute_hash_internal(&dict.key, &key_bytes);\n310\t    let idx = (code % dict.mod_ as u64) as usize;\n311\t\n312\t    // Step 1: attempt to find an existing element.\n313\t    let existing = {\n314\t        let key_attr = &dict.key;\n315\t        dict.buckets[idx].elements.iter().position(|e| {\n316\t            e.code == code && keys_match_internal(key_attr, &e.key, &key_bytes)\n317\t        })\n318\t    };\n319\t\n320\t    if let Some(p) = existing {\n321\t        return Some(&mut dict.buckets[idx].elements[p].val);\n322\t    }\n323\t\n324\t    // Step 2: insert a new element.\n325\t    let val_size = dict.val.size;\n326\t    dict.buckets[idx].elements.push(DictElem {\n327\t        code,\n328\t        key: key_bytes.clone(),\n329\t        val: vec![0u8; val_size],\n330\t    });\n331\t    dict.count += 1;\n332\t    let bucket_size_after = dict.buckets[idx].elements.len();\n333\t\n334\t    // Step 3: reshape if the bucket grew too large.\n335\t    if bucket_size_after > dict.mod_ {\n336\t        let _ = dict_reshape(dict, 1);\n337\t        let new_idx = (code % dict.mod_ as u64) as usize;\n338\t        let key_attr = &dict.key;\n339\t        let new_pos = dict.buckets[new_idx]\n340\t            .elements\n341\t            .iter()\n342\t            .position(|e| e.code == code && keys_match_internal(key_attr, &e.key, &key_bytes))\n343\t            .expect(\"element must still exist after reshape\");\n344\t        return Some(&mut dict.buckets[new_idx].elements[new_pos].val);\n345\t    }\n346\t\n347\t    let last = dict.buckets[idx].elements.len() - 1;\n348\t    Some(&mut dict.buckets[idx].elements[last].val)\n349\t}\n350\t\n351\t/// Remove a value from the dictionary. Returns true if the element was found and removed.\n352\tpub fn dict_remove(dict: &mut Dict, key_data: &[u8]) -> bool {\n353\t    let key_bytes = prepare_key_bytes(dict, key_data);\n354\t    let code = compute_hash_internal(&dict.key, &key_bytes);\n355\t    let idx = (code % dict.mod_ as u64) as usize;\n356\t\n357\t    let pos = {\n358\t        let key_attr = &dict.key;\n359\t        dict.buckets[idx].elements.iter().position(|e| {\n360\t            e.code == code && keys_match_internal(key_attr, &e.key, &key_bytes)\n361\t        })\n362\t    };\n363\t\n364\t    if let Some(p) = pos {\n365\t        let mut elem = dict.buckets[idx].elements.remove(p);\n366\t        let key_copy = dict.key.copy;\n367\t        let key_free = dict.key.free;\n368\t        let val_size = dict.val.size;\n369\t        let val_free = dict.val.free;\n370\t        if key_copy.is_some() {\n371\t            if let Some(f) = key_free {\n372\t                f(&mut elem.key);\n373\t            }\n374\t        }\n375\t        if val_size != 0 {\n376\t            if let Some(f) = val_free {\n377\t                f(&mut elem.val);\n378\t            }\n379\t        }\n380\t        if dict.count > 0 {\n381\t            dict.count -= 1;\n382\t        }\n383\t        true\n384\t    } else {\n385\t        false\n386\t    }\n387\t}\n388\t\n389\t/// Check if a key exists in the dictionary.\n390\tpub fn dict_has(dict: &Dict, key_data: &[u8]) -> bool {\n391\t    let key_bytes = prepare_key_bytes(dict, key_data);\n392\t    let code = compute_hash_internal(&dict.key, &key_bytes);\n393\t    let idx = (code % dict.mod_ as u64) as usize;\n394\t    let key_attr = &dict.key;\n395\t    dict.buckets[idx]\n396\t        .elements\n397\t        .iter()\n398\t        .any(|e| e.code == code && keys_match_internal(key_attr, &e.key, &key_bytes))\n399\t}\n400\t\n401\t/// Return the number of elements in the dictionary.\n402\tpub fn dict_len(dict: &Dict) -> usize {\n403\t    let mut total = 0usize;\n404\t    for bucket in &dict.buckets {\n405\t        total += bucket.elements.len();\n406\t    }\n407\t    total\n408\t}\n409\t\n410\t/// Return a snapshot of all keys as a flat byte slice. The buffer is leaked\n411\t/// to provide a `'static` lifetime, matching the C version's caller-frees-it\n412\t/// model (without resorting to unsafe).\n413\tpub fn dict_key(dict: &Dict, size: &mut usize) -> Option<&'static [u8]> {\n414\t    let len = dict_len(dict);\n415\t    *size = len;\n416\t    if len == 0 {\n417\t        return None;\n418\t    }\n419\t    let mut buf: Vec<u8> = Vec::new();\n420\t    for bucket in &dict.buckets {\n421\t        for elem in &bucket.elements {\n422\t            buf.extend_from_slice(&elem.key);\n423\t        }\n424\t    }\n425\t    let leaked: &'static [u8] = Box::leak(buf.into_boxed_slice());\n426\t    Some(leaked)\n427\t}\n428\t\n429\t/// Serialize a dictionary into a contiguous Vec<u8>.\n430\tpub fn dict_serialize(dict: &Dict, bytes: &mut usize) -> Option<Vec<u8>> {\n431\t    let count = dict_len(dict) as u32;\n432\t    let key_size = dict.key.size as u32;\n433\t    let val_size = dict.val.size as u32;\n434\t\n435\t    let mut output: Vec<u8> = Vec::new();\n436\t    output.extend_from_slice(&key_size.to_le_bytes());\n437\t    output.extend_from_slice(&val_size.to_le_bytes());\n438\t    output.extend_from_slice(&count.to_le_bytes());\n439\t\n440\t    if dict.key.type_ == DictType::Str {\n441\t        // Per-element record: u32 strlen + val_size bytes; then the string area.\n442\t        let mut strings: Vec<u8> = Vec::new();\n443\t        for bucket in &dict.buckets {\n444\t            for elem in &bucket.elements {\n445\t                let strlen = elem.key.len() as u32;\n446\t                output.extend_from_slice(&strlen.to_le_bytes());\n447\t                if dict.val.size != 0 {\n448\t                    let pad = dict.val.size.saturating_sub(elem.val.len());\n449\t                    output.extend_from_slice(&elem.val);\n450\t                    if pad > 0 {\n451\t                        output.extend(std::iter::repeat(0u8).take(pad));\n452\t                    }\n453\t                }\n454\t                strings.extend_from_slice(&elem.key);\n455\t            }\n456\t        }\n457\t        output.extend_from_slice(&strings);\n458\t    } else {\n459\t        for bucket in &dict.buckets {\n460\t            for elem in &bucket.elements {\n461\t                // Write key bytes (already exactly key.size in lengt