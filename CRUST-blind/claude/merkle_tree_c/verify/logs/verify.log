.capacity = indices_buffer.capacity / sizeof(uint32_t);\n299\t  for (size_t i = 0; i < indices.length; i++) {\n300\t    indices.values[i] = leaf_indices->values[i] + (leaves_count - 1);\n301\t  }\n302\t\n303\t  for (size_t i = 0; i < indices.length - 1; i++) {\n304\t    for (size_t j = i + 1; j < indices.length; j++) {\n305\t      uint32_t left_index = indices.values[i];\n306\t      uint32_t right_index = indices.values[j];\n307\t      int order = cbmt_node_cmp(tree->nodes + left_index, tree->nodes + right_index);\n308\t      if (order > 0) {\n309\t        indices.values[i] = right_index;\n310\t        indices.values[j] = left_index;\n311\t      }\n312\t    }\n313\t  }\n314\t  proof->indices = indices;\n315\t  return 0;\n316\t}\n317\t\n318\tcbmt_node cbmt_tree_root(cbmt_tree *tree) {\n319\t  cbmt_node node;\n320\t  if (tree->length == 0) {\n321\t    memset(node.bytes, 0, CBMT_NODE_SIZE);\n322\t  } else {\n323\t    cbmt_node_copy(&node, tree->nodes);\n324\t  }\n325\t  return node;\n326\t}\n327\t\n328\tint cbmt_proof_root(cbmt_proof *proof,\n329\t                    cbmt_node *root,\n330\t                    cbmt_leaves *leaves,\n331\t                    cbmt_node_merge_fn merge,\n332\t                    void *merge_ctx,\n333\t                    /* for saving nodes in cloned leaves */\n334\t                    cbmt_buffer nodes_buffer,\n335\t                    /* for saving (index, node) pairs */\n336\t                    cbmt_buffer pairs_buffer) {\n337\t  if (leaves->length * sizeof(cbmt_node) > nodes_buffer.capacity) {\n338\t    return CBMT_ERROR_OVER_CAPACITY;\n339\t  }\n340\t  if (leaves->length * sizeof(cbmt_node_pair) > pairs_buffer.capacity) {\n341\t    return CBMT_ERROR_OVER_CAPACITY;\n342\t  }\n343\t  if (leaves->length != proof->indices.length || leaves->length == 0) {\n344\t    return CBMT_ERROR_PROOF_ROOT;\n345\t  }\n346\t\n347\t  cbmt_leaves leaves_clone;\n348\t  leaves_clone.nodes = (cbmt_node *)nodes_buffer.data;\n349\t  leaves_clone.length = leaves->length;\n350\t  for (size_t i = 0; i < leaves->length; i++) {\n351\t    cbmt_node_copy(leaves_clone.nodes + i, leaves->nodes + i);\n352\t  }\n353\t  /* sort to align with indices */\n354\t  cbmt_simple_bubble_sort(leaves_clone.nodes,\n355\t                          leaves_clone.length,\n356\t                          sizeof(cbmt_node),\n357\t                          cbmt_node_cmp);\n358\t\n359\t  int ret;\n360\t  cbmt_queue queue;\n361\t  ret = cbmt_queue_init(&queue, pairs_buffer, sizeof(cbmt_node_pair), leaves->length);\n362\t  if (ret != 0) {\n363\t    return ret;\n364\t  }\n365\t  for (size_t i = 0; i < leaves->length; i++) {\n366\t    cbmt_node_pair pair;\n367\t    pair.index = proof->indices.values[i];\n368\t    cbmt_node_copy(&pair.node, leaves_clone.nodes + i);\n369\t    ret = cbmt_queue_push_back(&queue, &pair);\n370\t    if (ret != 0) {\n371\t      return ret;\n372\t    }\n373\t  }\n374\t  cbmt_simple_bubble_sort(queue.buffer.data,\n375\t                          queue.length,\n376\t                          sizeof(cbmt_node_pair),\n377\t                          cbmt_node_pair_reverse_cmp);\n378\t  size_t lemmas_offset = 0;\n379\t  cbmt_node_pair pair_current;\n380\t  cbmt_node_pair pair_sibling;\n381\t  uint32_t index;\n382\t  cbmt_node *node;\n383\t  while (queue.length > 0) {\n384\t    ret = cbmt_queue_pop_front(&queue, &pair_current);\n385\t    if (ret != 0) {\n386\t      return ret;\n387\t    }\n388\t    index = pair_current.index;\n389\t    node = &pair_current.node;\n390\t\n391\t    if (index == 0) {\n392\t      if (proof->lemmas_length == lemmas_offset && queue.length == 0) {\n393\t        cbmt_node_copy(root, node);\n394\t        return 0;\n395\t      } else {\n396\t        return CBMT_ERROR_PROOF_ROOT;\n397\t      }\n398\t    }\n399\t\n400\t    cbmt_node_pair *pair_front = (cbmt_node_pair *)cbmt_queue_front(&queue);\n401\t    cbmt_node *sibling = NULL;\n402\t    if (pair_front != NULL && pair_front->index == cbmt_sibling(index)) {\n403\t     