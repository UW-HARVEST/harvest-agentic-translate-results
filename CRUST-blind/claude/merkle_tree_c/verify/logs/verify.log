  nodes[offset + i] = leaf.clone();\n460\t    }\n461\t\n462\t    // Build internal nodes upward.\n463\t    for i in 0..(leaves_len - 1) {\n464\t        let rev_idx = leaves_len - 2 - i;\n465\t        let li = (rev_idx << 1) + 1;\n466\t        let ri = (rev_idx << 1) + 2;\n467\t        let merged = {\n468\t            let left = &nodes[li];\n469\t            let right = &nodes[ri];\n470\t            merge(left, right)\n471\t        };\n472\t        nodes[rev_idx] = merged;\n473\t    }\n474\t\n475\t    tree.length = length;\n476\t    tree.capacity = length;\n477\t    tree.nodes = nodes;\n478\t    0\n479\t}\n480\t\n481\tpub fn cbmt_build_merkle_tree(\n482\t    tree: &mut CbmtTree,\n483\t    leaves: &CbmtLeaves,\n484\t    merge: fn(Option<&mut ()>, &CbmtNode, &CbmtNode) -> CbmtNode,\n485\t) -> i32 {\n486\t    build_merkle_tree_impl(tree, leaves, |l, r| merge(None, l, r))\n487\t}\n488\t\n489\tpub fn cbmt_build_merkle_proof<Ctx>(\n490\t    proof: &mut CbmtProof,\n491\t    leaves: &CbmtLeaves,\n492\t    leaf_indices: &CbmtIndices,\n493\t    merge: CbmtNodeMergeFn<Ctx>,\n494\t    merge_ctx: &mut Ctx,\n495\t    _nodes_buffer: CbmtBuffer,\n496\t    _indices_buffer: CbmtBuffer,\n497\t    _lemmas_buffer: CbmtBuffer,\n498\t) -> i32 {\n499\t    let mut tree = CbmtTree::default();\n500\t    let ret = build_merkle_tree_impl(&mut tree, leaves, |l, r| merge(merge_ctx, l, r));\n501\t    if ret != 0 {\n502\t        return ret;\n503\t    }\n504\t    match cbmt_tree_build_proof(&tree, leaf_indices) {\n505\t        Ok(p) => {\n506\t            *proof = p;\n507\t            0\n508\t        }\n509\t        Err(e) => e,\n510\t    }\n511\t}\n512\t"}]},"parent_tool_use_id":null,"session_id":"ceb2771e-db65-4be7-be7f-3ae3a1828a1f","uuid":"33277035-6c6e-4d48-8b1a-e0eb9c1a435a","timestamp":"2026-05-29T18:50:17.945Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-UpxGce/project/src/merkle_tree.rs","content":"use std::collections::VecDeque;\n\npub const CBMT_NODE_SIZE