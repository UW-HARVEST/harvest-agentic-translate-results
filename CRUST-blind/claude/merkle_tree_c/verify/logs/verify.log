{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018TcMypLd5BVjHmbiqaVUsz","type":"tool_result","content":"1\tuse std::collections::VecDeque;\n2\t\n3\tpub const CBMT_NODE_SIZE: usize = 4;\n4\t// pub const CBMT_NODE_SIZE: usize = 32;\n5\tpub const CBMT_ERROR_OVER_CAPACITY: i32 = -1;\n6\tpub const CBMT_ERROR_QUEUE_EMPTY: i32 = -2;\n7\tpub const CBMT_ERROR_PROOF_ROOT: i32 = -3;\n8\tpub const CBMT_ERROR_BUILD_PROOF: i32 = -4;\n9\tpub const CBMT_ERROR_INVALID_CAPACITY: i32 = -5;\n10\tpub const CBMT_ERROR_VERIFY_FAILED: i32 = -6;\n11\tpub const CBMT_FATAL_BUILD_PROOF: i32 = -99;\n12\t\n13\t#[derive(Debug, Default)]\n14\tpub struct CbmtBuffer<'a> {\n15\t    pub data: &'a mut [u8],\n16\t    pub capacity: usize,\n17\t}\n18\t#[derive(Debug, Clone, Default)]\n19\tpub struct CbmtNode {\n20\t    pub bytes: [u8; CBMT_NODE_SIZE],\n21\t}\n22\t#[derive(Debug, Clone)]\n23\tpub struct CbmtIndices {\n24\t    pub values: Vec<u32>,\n25\t    pub capacity: usize,\n26\t}\n27\t#[derive(Debug, Clone)]\n28\tpub struct CbmtProof {\n29\t    pub indices: CbmtIndices,\n30\t    pub lemmas: Vec<CbmtNode>,\n31\t}\n32\t#[derive(Debug, Clone, Default)]\n33\tpub struct CbmtTree {\n34\t    pub nodes: Vec<CbmtNode>,\n35\t    pub length: usize,\n36\t    pub capacity: usize,\n37\t}\n38\t#[derive(Debug, Clone)]\n39\tpub struct CbmtLeaves {\n40\t    pub nodes: Vec<CbmtNode>,\n41\t}\n42\t#[derive(Debug)]\n43\tpub struct CbmtQueue<'a> {\n44\t    pub buffer: CbmtBuffer<'a>,\n45\t    pub width: usize,\n46\t    pub length: usize,\n47\t    pub capacity: usize,\n48\t    pub tail: usize,\n49\t    pub head: usize,\n50\t}\n51\t#[derive(Debug, Clone)]\n52\tpub struct CbmtNodePair {\n53\t    pub index: u32,\n54\t    pub node: CbmtNode,\n55\t}\n56\t// Type alias for the node merge function.\n57\t// (In an idiomatic Rust implementation you might use generics or traits.)\n58\tpub type CbmtNodeMergeFn<Ctx> = fn(ctx: &mut Ctx, left: &CbmtNode, right: &CbmtNode) -> CbmtNode;\n59\t\n60\t// Sibling, parent, is_left helpers for tree-index arithmetic.\n61\t#[inline]\n62\tfn cbmt_is_left(index: u32) -> bool {\n63\t    (index & 1) == 1\n64\t}\n65\t#[inline]\n66\tfn cbmt_parent(index: u32) -> u32 {\n67\t    if index == 0 {\n68\t        0\n69\t    } else {\n70\t        (index - 1) >> 1\n71\t    }\n72\t}\n73\t#[inline]\n74\tfn cbmt_sibling(index: u32) -> u32 {\n75\t    if index == 0 {\n76\t        0\n77\t    } else {\n78\t        ((index + 1) ^ 1) - 1\n79\t    }\n80\t}\n81\t\n82\tpub fn cbmt_universal_swap(left: &mut [u8], right: &mut [u8], width: usize) {\n83\t    for i in 0..width {\n84\t        std::mem::swap(&mut left[i], &mut right[i]);\n85\t    }\n86\t}\n87\t\n88\tpub fn cbmt_simple_bubble_sort<T>(slice: &mut [T], cmp: fn(&T, &T) -> i32) {\n89\t    let n = slice.len();\n90\t    if n < 2 {\n91\t        return;\n92\t    }\n93\t    for i in 0..(n - 1) {\n94\t        for j in (i + 1)..n {\n95\t            if cmp(&slice[i], &slice[j]) > 0 {\n96\t                slice.swap(i, j);\n97\t            }\n98\t        }\n99\t    }\n100\t}\n101\t\n102\tpub fn cbmt_uint32_reverse_cmp(left: &u32, right: &u32) -> i32 {\n103\t    // Reverse order: emulate C `right - left` with unsigned wrap then cast to int.\n104\t    right.wrapping_sub(*left) as i32\n105\t}\n106\t\n107\tpub fn cbmt_buffer_init<'a>(buffer: &mut CbmtBuffer<'a>, data: &'a mut [u8]) {\n108\t    buffer.capacity = data.len();\n109\t    buffer.data = data;\n110\t}\n111\t\n112\tpub fn cbmt_leaves_init(leaves: &mut CbmtLeaves, nodes: Vec<CbmtNode>) {\n113\t    leaves.nodes = nodes;\n114\t}\n115\t\n116\tpub fn cbmt_indices_init(indices: &mut CbmtIndices, values: Vec<u32>) {\n117\t    indices.capacity = values.len();\n118\t    indices.values = values;\n119\t}\n120\t\n121\tpub fn cbmt_queue_init<'a>(\n122\t    queue: &mut CbmtQueue<'a>,\n123\t    buffer: CbmtBuffer<'a>,\n124\t    width: usize,\n125\t    capacity: usize,\n126\t) -> i32 {\n127\t    if width == 0 {\n128\t        return CBMT_ERROR_INVALID_CAPACITY;\n129\t    }\n130\t    if capacity.saturating_mul(width) > buffer.capacity {\n131\t        return CBMT_ERROR_OVER_CAPACITY;\n132\t    }\n133\t    if buffer.capacity % width != 0 {\n134\t        return CBMT_ERROR_INVALID_CAPACITY;\n135\t    }\n136\t    queue.buffer = buffer;\n137\t    queue.capacity = capacity;\n138\t    queue.width = width;\n139\t    queue.length = 0;\n140\t    queue.head = 0;\n141\t    queue.tail = 0;\n142\t    0\n143\t}\n144\t\n145\tpub fn cbmt_queue_push_back(queue: &mut CbmtQueue, item: &[u8]) -> i32 {\n146\t    if queue.length >= queue.capacity {\n147\t        return CBMT_ERROR_OVER_CAPACITY;\n148\t    }\n149\t    let start = queue.head * queue.width;\n150\t    queue.buffer.data[start..start + queue.width].copy_from_slice(&item[..queue.width]);\n151\t    queue.head = (queue.head + 1) % queue.capacity;\n152\t    queue.length += 1;\n153\t    0\n154\t}\n155\t\n156\tpub fn cbmt_queue_push_front(queue: &mut CbmtQueue, item: &[u8]) -> i32 {\n157\t    if queue.length >= queue.capacity {\n158\t        return CBMT_ERROR_OVER_CAPACITY;\n159\t    }\n160\t    queue.tail = (queue.tail + queue.capacity - 1) % queue.capacity;\n161\t    let start = queue.tail * queue.width;\n162\t    queue.buffer.data[start..start + queue.width].copy_from_slice(&item[..queue.width]);\n163\t    queue.length += 1;\n164\t    0\n165\t}\n166\t\n167\tpub fn cbmt_queue_pop_front(queue: &mut CbmtQueue, item: &mut [u8]) -> i32 {\n168\t    if queue.length == 0 {\n169\t        return CBMT_ERROR_QUEUE_EMPTY;\n170\t    }\n171\t    let start = queue.tail * queue.width;\n172\t    item[..queue.width].copy_from_slice(&queue.buffer.data[start..start + queue.width]);\n173\t    queue.tail = (queue.tail + 1) % queue.capacity;\n174\t    queue.length -= 1;\n175\t    0\n176\t}\n177\t\n178\tpub fn cbmt_queue_front<'a>(queue: &'a CbmtQueue<'a>) -> Option<&'a [u8]> {\n179\t    if queue.length == 0 {\n180\t        return None;\n181\t    }\n182\t    let start = queue.tail * queue.width;\n183\t    Some(&queue.buffer.data[start..start + queue.width])\n184\t}\n185\t\n186\tpub fn cbmt_node_copy(dest: &mut CbmtNode, src: &CbmtNode) {\n187\t    dest.bytes.copy_from_slice(&src.bytes);\n188\t}\n189\t\n190\tpub fn cbmt_node_cmp(left: &CbmtNode, right: &CbmtNode) -> i32 {\n191\t    // CBMT_NODE_I32 mode: interpret bytes as little-endian i32.\n192\t    let l = i32::from_le_bytes(left.bytes);\n193\t    let r = i32::from_le_bytes(right.bytes);\n194\t    l.wrapping_sub(r)\n195\t}\n196\t\n197\tpub fn cbmt_node_pair_reverse_cmp(left: &CbmtNodePair, right: &CbmtNodePair) -> i32 {\n198\t    right.index.wrapping_sub(left.index) as i32\n199\t}\n200\t\n201\tpub fn cbmt_tree_build_proof(\n202\t    tree: &CbmtTree,\n203\t    leaf_indices: &CbmtIndices,\n204\t) -> Result<CbmtProof, i32> {\n205\t    if tree.length == 0 || leaf_indices.values.is_empty() {\n206\t        return Err(CBMT_ERROR_BUILD_PROOF);\n207\t    }\n208\t\n209\t    let leaves_count: u32 = ((tree.length >> 1) + 1) as u32;\n210\t\n211\t    // Build initial deque of (leaf_index + leaves_count - 1) values, sorted descending.\n212\t    let mut initial: Vec<u32> = leaf_indices\n213\t        .values\n214\t        .iter()\n215\t        .map(|&v| v + (leaves_count - 1))\n216\t        .collect();\n217\t    // Reverse-sort to align with C behavior (bubble sort with reverse cmp).\n218\t    initial.sort_by(|a, b| b.cmp(a));\n219\t\n220\t    let first_value = initial[0];\n221\t    if first_value >= ((leaves_count << 1) - 1) {\n222\t        return Err(CBMT_ERROR_BUILD_PROOF);\n223\t    }\n224\t\n225\t    let mut queue: VecDeque<u32> = VecDeque::from(initial);\n226\t    let mut lemmas: Vec<CbmtNode> = Vec::new();\n227\t\n228\t    while let Some(index) = queue.pop_front() {\n229\t        if index == 0 {\n230\t            if !queue.is_empty() {\n231\t                return Err(CBMT_FATAL_BUILD_PROOF);\n232\t            }\n233\t            break;\n234\t        }\n235\t\n236\t        let sibling = cbmt_sibling(index);\n237\t        if let Some(&front) = queue.front() {\n238\t            if front == sibling {\n239\t                queue.pop_front();\n240\t            } else {\n241\t                lemmas.push(tree.nodes[sibling as usize].clone());\n242\t            }\n243\t        } else {\n244\t            lemmas.push(tree.nodes[sibling as usize].clone());\n245\t        }\n246\t\n247\t        let parent = cbmt_parent(index);\n248\t        if parent != 0 {\n249\t            queue.push_back(parent);\n250\t        }\n251\t    }\n252\t\n253\t    // Compute final indices and sort them by tree node value (ascending).\n254\t    let mut indices_values: Vec<u32> = leaf_indices\n255\t        .values\n256\t        .iter()\n257\t        .map(|&v| v + (leaves_count - 1))\n258\t        .collect();\n259\t    let n = indices_values.len();\n260\t    if n > 1 {\n261\t        for i in 0..(n - 1) {\n262\t            for j in (i + 1)..n {\n263\t                let li = indices_values[i] as usize;\n264\t                let ri = indices_values[j] as usize;\n265\t                if cbmt_node_cmp(&tree.nodes[li], &tree.nodes[ri]) > 0 {\n266\t                    indices_values.swap(i, j);\n267\t                }\n268\t            }\n269\t        }\n270\t    }\n271\t\n272\t    let capacity = indices_values.len();\n273\t    Ok(CbmtProof {\n274\t        indices: CbmtIndices {\n275\t            values: indices_values,\n276\t            capacity,\n277\t        },\n278\t        lemmas,\n279\t    })\n280\t}\n281\t\n282\tpub fn cbmt_tree_root(tree: &CbmtTree) -> CbmtNode {\n283\t    if tree.length == 0 {\n284\t        CbmtNode::default()\n285\t    } else {\n286\t        tree.nodes[0].clone()\n287\t    }\n288\t}\n289\t\n290\t// Internal helper to compute a proof root using a closure-based merge function.\n291\tfn compute_proof_root_impl<F>(\n292\t    proof: &CbmtProof,\n293\t    leaves: &CbmtLeaves,\n294\t    mut merge: F,\n295\t) -> Result<CbmtNode, i32>\n296\twhere\n297\t    F: FnMut(&CbmtNode, &CbmtNode) -> CbmtNode,\n298\t{\n299\t    if leaves.nod