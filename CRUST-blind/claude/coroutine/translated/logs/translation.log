e_status(S,co2)) {\n\t\tcoroutine_resume(S,co1);\n\t\tcoroutine_resume(S,co2);\n\t} \n\tprintf(\"main end\\n\");\n}\n\nint \nmain() {\n\tstruct schedule * S = coroutine_open();\n\ttest(S);\n\tcoroutine_close(S);\n\t\n\treturn 0;\n}\n\n","numLines":43,"startLine":1,"totalLines":43}}}
