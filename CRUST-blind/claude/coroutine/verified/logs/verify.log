ion\n66\t// is enforced by the mutex/condvar protocol so only one thread accesses the\n67\t// pointee at a time.\n68\tstruct SendMutPtr<T: ?Sized>(*mut T);\n69\tunsafe impl<T: ?Sized> Send for SendMutPtr<T> {}\n70\timpl<T: ?Sized> SendMutPtr<T> {\n71\t    fn get(&self) -> *mut T {\n72\t        self.0\n73\t    }\n74\t}\n75\t\n76\timpl Drop for Coroutine {\n77\t    fn drop(&mut self) {\n78\t        let key = self as *mut Coroutine as usize;\n79\t        let state_opt = {\n80\t            let mut map = states_map().lock().unwrap();\n81\t            map.remove(&key)\n82\t        };\n83\t        if let Some(state) = state_opt {\n84\t            // Tell the thread (if it is suspended in a yield) to terminate.\n85\t            {\n86\t                let mut cmd = state.cmd.lock().unwrap();\n87\t                *cmd = Cmd::Kill;\n88\t            }\n89\t            state.cmd_cv.notify_all();\n90\t            let handle = state.handle.lock().unwrap().take();\n91\t            if let Some(h) = handle {\n92\t                let _ = h.join();\n93\t            }\n94\t        }\n95\t    }\n96\t}\n97\t\n98\t// --- public API ---\n99\t\n100\tpub fn coroutine_open() -> Box<Schedule> {\n101\t    Box::new(Schedule {\n102\t        stack: vec![0u8; STACK_SIZE].into_boxed_slice(),\n103\t        nco: 0,\n104\t        cap: DEFAULT_COROUTINE,\n105\t        running: -1,\n106\t        co: (0..DEFAULT_COROUTINE).map(|_| None).collect(),\n107\t    })\n108\t}\n109\t\n110\tpub fn coroutine_close(_schedule: Box<Schedule>) {\n111\t    // Dropping the Box drops the Schedule, which drops every remaining\n112\t    // Coroutine, which kills/joins their backing threads via Drop.\n113\t}\n114\t\n115\tpub fn coroutine_new(schedule: &mut Schedule, func: CoroutineFunc, data: Box<dyn Any>) -> i32 {\n116\t    let co = Box::new(Coroutine {\n117\t        func,\n118\t        data,\n119\t        cap: 0,\n120\t        size: 0,\n121\t        status: COROUTINE_READY,\n122\t        stack: None,\n123\t    });\n124\t    