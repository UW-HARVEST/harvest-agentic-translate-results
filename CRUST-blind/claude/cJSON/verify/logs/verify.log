e(out); cJSON_Delete(json);\n\n    print_section(\"pretty_empty_array\");\n    json = cJSON_Parse(\"[]\");\n    out = cJSON_Print(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"pretty_nested\");\n    json = cJSON_Parse(\"{\\\"a\\\":{\\\"b\\\":1}}\");\n    out = cJSON_Print(json);\n    printf(\"%s\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    /* CreateNumber/string roundtrips */\n    print_section(\"create_int\");\n    {\n        cJSON *o = cJSON_CreateNumber(123);\n        out = cJSON_PrintUnformatted(o);\n        printf(\"[%s]\\n\", out);\n        free(out); cJSON_Delete(o);\n    }\n\n    print_section(\"create_neg\");\n    {\n        cJSON *o = cJSON_CreateNumber(-7);\n        out = cJSON_PrintUnformatted(o);\n        printf(\"[%s]\\n\", out);\n        free(out); cJSON_Delete(o);\n    }\n\n    print_section(\"create_zero\");\n    {\n        cJSON *o = cJSON_CreateNumber(0.0);\n        out = cJSON_PrintUnformatted(o);\n        printf(\"[%s]\\n\", out);\n        free(out); cJSON_Delete(o);\n    }\n\n    print_section(\"create_decimal\");\n    {\n        cJSON *o = cJSON_CreateNumber(3.14159);\n        out = cJSON_PrintUnformatted(o);\n        printf(\"[%s]\\n\", out);\n        free(out); cJSON_Delete(o);\n    }\n\n    print_section(\"create_fmt_neg\");\n    {\n        cJSON *o = cJSON_CreateNumber(-122.026020);\n        out = cJSON_PrintUnformatted(o);\n        printf(\"[%s]\\n\", out);\n        free(out); cJSON_Delete(o);\n    }\n\n    print_section(\"string_with_control\");\n    {\n        cJSON *o = cJSON_CreateString(\"a\\x01b\");\n        out = cJSON_PrintUnformatted(o);\n        printf(\"[%s]\\n\", out);\n        free(out); cJSON_Delete(o);\n    }\n\n    print_section(\"string_special\");\n    {\n        cJSON *o = cJSON_CreateString(\"hello\\nworld\\t\\\"quote\\\"\");\n        out = cJSON_PrintUnformatted(o);\n        printf(\"[%s]\\n\", out);\n        free(out); cJSON_Delete(o);\n    }\n\n    /* Stri