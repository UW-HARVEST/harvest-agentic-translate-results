tUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"number_neg_exp\");\n    json = cJSON_Parse(\"1.5e-7\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"number_large\");\n    json = cJSON_Parse(\"1.0e9\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"number_decimal\");\n    json = cJSON_Parse(\"37.7668\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    /* Strings */\n    print_section(\"string_simple\");\n    json = cJSON_Parse(\"\\\"hello\\\"\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"string_empty\");\n    json = cJSON_Parse(\"\\\"\\\"\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"string_escapes\");\n    json = cJSON_Parse(\"\\\"a\\\\\\\"b\\\\\\\\c\\\\nd\\\\tend\\\"\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"string_unicode\");\n    json = cJSON_Parse(\"\\\"\\\\u0041\\\"\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    /* Arrays */\n    print_section(\"array_empty\");\n    json = cJSON_Parse(\"[]\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"array_nums\");\n    json = cJSON_Parse(\"[1, 2, 3]\");\n    out = cJSON_PrintUnformatted(json);\n    printf(\"[%s]\\n\", out);\n    free(out); cJSON_Delete(json);\n\n    print_section(\"array_mixed\");\n    json = cJSON_Parse(\"[null, true, false, 42, \\\"hi\\\", [], {}]\");\n    out = cJSON_PrintUnformatted(json