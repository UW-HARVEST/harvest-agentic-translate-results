    hamt_set(h, losos, losos, &cf);\n    hamt_set(h, bro, bro, &cf);\n    hamt_set(h, b, b, &cf);\n    hamt_set(h, bub, bub, &cf);\n    \n    printf(\"STR_SIZE: %d\\n\", hamt_size(h));\n    \n    char *queries[] = {aut, bus, vlak, kokos, banan, losos, bro, b, bub};\n    int qlen = sizeof(queries) / sizeof(char*);\n    for (int i = 0; i < qlen; i++) {\n        key_value_t *r = hamt_search(h, queries[i]);\n        printf(\"STR_SEARCH \\\"%s\\\" found: %d, val: %s\\n\", queries[i], r != NULL, r ? (char*)r->value : \"NULL\");\n    }\n    \n    char *missing = \"missing\";\n    key_value_t *r = hamt_search(h, missing);\n    printf(\"STR_SEARCH_MISSING \\\"missing\\\" found: %d\\n\", r != NULL);\n    \n    hamt_destroy(h, NULL);\n}\n\nvoid test_many() {\n    hamt_t *h = new_hamt(hamt_int_hash, hamt_int_equals);\n    \n    int n = 100;\n    int *keys = malloc(sizeof(int)*n);\n    int *vals = malloc(sizeof(int)*n);\n    for (int i = 0; i < n; i++) {\n        keys[i] = i;\n        vals[i] = i*i + 7;\n        key_value_t cf;\n        hamt_set(h, &keys[i], &vals[i], &cf);\n    }\n    printf(\"MANY_SIZE: %d\\n\", hamt_size(h));\n    \n    for (int i = 0; i < n; i++) {\n        int sk = i;\n        key_value_t *r = hamt_search(h, &sk);\n        if (!r || *(int*)r->value != i*i+7) {\n            printf(\"MANY_BAD i=%d found=%d val=%d\\n\", i, r!=NULL, r?*(int*)r->value:-1);\n        }\n    }\n    printf(\"MANY_SEARCH_OK\\n\");\n    \n    // Remove half\n    for (int i = 0; i < n; i+=2) {\n        int rk = i;\n        key_value_t rkv;\n        bool removed = hamt_remove(h, &rk, &rkv);\n        if (!removed) {\n            printf(\"MANY_REMOVE_FAIL i=%d\\n\", i);\n        }\n    }\n    printf(\"MANY_SIZE_AFTER_REMOVE: %d\\n\", hamt_size(h));\n    \n    for (int i = 0; i < n; i++) {\n        int sk = i;\n        key_value_t *r = hamt_search(h, &sk);\n        bool should_exist = (i % 2 == 1);\n        if ((r != NULL) != should_exist) {\n            printf(\"MANY_BAD2 i=%d found=%d sh