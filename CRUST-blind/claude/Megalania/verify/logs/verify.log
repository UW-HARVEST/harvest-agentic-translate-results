{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_tc5w3xs7ljiad4zyslq5uuhcvwwyesd6zgraergdsywrhkeqcmiq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01B3DmcD9DGUfW8FEvGP7Y5q","name":"Write","input":{"file_path":"/tmp/c_helpers/run_tests.c","content":"// Helper program to compute expected values for Rust tests by running C code.\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_state.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_packet.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_header_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/probability.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/range_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/probability_model.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/perplexity_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_packet_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/file_output.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/packet_slab.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/packet_slab_undo_stack.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/substring_enumerator.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/max_heap.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/packet_enumerator.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/perplexity_table.h\"\n\n// =========================\n// 1. Test ctx_state transitions\n// =========================\nstatic void test_ctx_state_transitions() {\n    printf(\"=== CTX STATE TRANSITIONS ===\\n\");\n    LZMAState s;\n    LZMAProperties p = { .lc = 0, .lp = 0, .pb = 0 };\n    uint8_t data[1] = {0};\n\n    // For each input ctx_state and each packet type, print resulting state\n    for (int packet_type = 1; packet_type <= 4; packet_type++) {\n        for (int init_ctx = 0; init_ctx < 12; init_ctx++) {\n            lzma_state_init(&s, data, 1, p);\n            s.ctx_state = init_ctx;\n            lzma_state_update_ctx_state(&s, packet_type);\n            printf(\"packet_type=%d init=%d -> %d\\n\", packet_type, init_ctx, s.ctx_state);\n        }\n    }\n}\n\n// =========================\n// 2. Test header encoding properties\n// =========================\ntypedef struct {\n    uint8_t bytes[256];\n    size_t len;\n} ByteCollector;\n\nstatic bool collector_write(OutputInterface* out, const void* data, size_t size) {\n    ByteCollector* c = (ByteCollector*) out->private_data;\n    memcpy(c->bytes + c->len, data, size);\n    c->len += size;\n    return true;\n}\n\nstatic void test_header() {\n    printf(\"=== HEADER ===\\n\");\n    LZMAState s;\n    uint8_t data[3] = {1, 2, 3};\n    LZMAProperties p1 = { .lc = 3, .lp = 0, .pb = 2 };\n    lzma_state_init(&s, data, 3, p1);\n    OutputInterface out;\n    ByteCollector c = {0};\n    out.write = collector_write;\n    out.private_data = &c;\n    lzma_encode_header(&s, &out);\n    printf(\"header(lc=3,lp=0,pb=2,size=3): len=%zu bytes=\", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    LZMAProperties p2 = { .lc = 0, .lp = 0, .pb = 0 };\n    uint8_t data2[5] = {0};\n    lzma_state_init(&s, data2, 5, p2);\n    c.len = 0;\n    lzma_encode_header(&s, &out);\n    printf(\"header(lc=0,lp=0,pb=0,size=5): len=%zu bytes=\", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    // Test data_size that fits in u32\n    LZMAProperties p3 = { .lc = 1, .lp = 2, .pb = 3 };\n    uint8_t* data3 = malloc(0x100);\n    lzma_state_init(&s, data3, 0x100, p3);\n    c.len = 0;\n    lzma_encode_header(&s, &out);\n    printf(\"header(lc=1,lp=2,pb=3,size=0x100): len=%zu bytes=\", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n    free(data3);\n}\n\n// =========================\n// 3. Test probability_model\n// =========================\ntypedef struct {\n    uint8_t bits[1024];\n    Prob probs_after[1024];\n    size_t bit_count;\n    uint32_t direct_bits[256];\n    uint32_t direct_num_bits[256];\n    size_t direct_count;\n} CapturingEnc;\n\nstatic void cap_encode_bit(EncoderInterface* enc, bool bit, Prob prob) {\n    CapturingEnc* d = (CapturingEnc*) enc->private_data;\n    d->bits[d->bit_count] = bit;\n    d->probs_after[d->bit_count] = prob;\n    d->bit_count++;\n}\nstatic void cap_encode_direct_bits(EncoderInterface* enc, unsigned bits, unsigned num_bits) {\n    CapturingEnc* d = (CapturingEnc*) enc->private_data;\n    d->direct_bits[d->direct_count] = bits;\n    d->direct_num_bits[d->direct_count] = num_bits;\n    d->direct_count++;\n}\n\nstatic void test_encode_bit() {\n    printf(\"=== ENCODE BIT ===\\n\");\n    EncoderInterface enc;\n    CapturingEnc cap = {0};\n    enc.encode_bit = cap_encode_bit;\n    enc.encode_direct_bits = cap_encode_direct_bits;\n    enc.private_data = &cap;\n\n    // bit=0, prob=1024 (initial)\n    Prob p = 1024;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 1024) -> p=%u\\n\", p);\n    p = 1024;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 1024) -> p=%u\\n\", p);\n\n    // Iterate encode_bit(0) several times from initial value 1024\n    p = 1024;\n    for (int i = 0; i < 5; i++) {\n        encode_bit(0, &p, &enc);\n        printf(\"encode_bit(0) iter%d -> p=%u\\n\", i, p);\n    }\n\n    p = 1024;\n    for (int i = 0; i < 5; i++) {\n        encode_bit(1, &p, &enc);\n        printf(\"encode_bit(1) iter%d -> p=%u\\n\", i, p);\n    }\n\n    // Edge: prob=0\n    p = 0;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 0) -> p=%u\\n\", p);\n    p = 0;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 0) -> p=%u\\n\", p);\n\n    // Edge: prob=2047\n    p = 2047;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 2047) -> p=%u\\n\", p);\n    p = 2047;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 2047) -> p=%u\\n\", p);\n\n    // Edge: prob=2048\n    p = 2048;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 2048) -> p=%u\\n\", p);\n    p = 2048;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 2048) -> p=%u\\n\", p);\n}\n\nstatic void test_encode_bit_tree() {\n    printf(\"=== ENCODE BIT TREE ===\\n\");\n    EncoderInterface enc;\n    CapturingEnc cap = {0};\n    enc.encode_bit = cap_encode_bit;\n    enc.encode_direct_bits = cap_encode_direct_bits;\n    enc.private_data = &cap;\n\n    // 4-bit tree, encode value 0b1010 = 10\n    Prob probs[16];\n    for (int i = 0; i < 16; i++) probs[i] = 1024;\n    cap.bit_count = 0;\n    encode_bit_tree(10, probs, 4, &enc);\n    printf(\"encode_bit_tree(10, 4): captured %zu bits = \", cap.bit_count);\n    for (size_t i = 0; i < cap.bit_count; i++) printf(\"%d \", cap.bits[i]);\n    printf(\"\\n probs after: \");\n    for (int i = 1; i < 16; i++) printf(\"%u \", probs[i]);\n    printf(\"\\n\");\n\n    // reverse\n    for (int i = 0; i < 16; i++) probs[i] = 1024;\n    cap.bit_count = 0;\n    encode_bit_tree_reverse(10, probs, 4, &enc);\n    printf(\"encode_bit_tree_reverse(10, 4): captured %zu bits = \", cap.bit_count);\n    for (size_t i = 0; i < cap.bit_count; i++) printf(\"%d \", cap.bits[i]);\n    printf(\"\\n probs after: \");\n    for (int i = 1; i < 16; i++) printf(\"%u \", probs[i]);\n    printf(\"\\n\");\n}\n\n// =========================\n// 4. Test perplexity_encoder\n// =========================\nstatic void test_perplexity_encoder() {\n    printf(\"=== PERPLEXITY ENCODER ===\\n\");\n    EncoderInterface enc;\n    uint64_t perp = 0;\n    perplexity_encoder_new(&enc, &perp);\n\n    enc.encode_bit(&enc, 0, 1024);\n    printf(\"after encode_bit(0, 1024): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_bit(&enc, 1, 1024);\n    printf(\"after encode_bit(1, 1024): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_bit(&enc, 0, 0);\n    printf(\"after encode_bit(0, 0): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_bit(&enc, 1, 2048);\n    printf(\"after encode_bit(1, 2048): perp=%llu\\n\", (unsigned long long)perp);\n\n    enc.encode_direct_bits(&enc, 0xFF, 8);\n    printf(\"after encode_direct_bits(0xFF, 8): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_direct_bits(&enc, 0, 4);\n    printf(\"after encode_direct_bits(0, 4): perp=%llu\\n\", (unsigned long long)perp);\n}\n\n// =========================\n// 5. Test range encoder\n// =========================\nstatic void test_range_encoder() {\n    printf(\"=== RANGE ENCODER ===\\n\");\n    OutputInterface out;\n    ByteCollector c = {0};\n    out.write = collector_write;\n    out.private_data = &c;\n\n    EncoderInterface enc;\n    range_encoder_new(&enc, &out);\n\n    // encode 5 zero bits with prob 1024\n    Prob p = 1024;\n    for (int i = 0; i < 5; i++) {\n        encode_bit(0, &p, &enc);\n    }\n    range_encoder_free(&enc);\n    printf(\"range_encoder bits=5 zeros prob=1024: bytes=%zu: \", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    // Direct bits\n    c.len = 0;\n    range_encoder_new(&enc, &out);\n    enc.encode_direct_bits(&enc, 0xABCDEF, 24);\n    range_encoder_free(&enc);\n    printf(\"range_encoder direct(0xABCDEF, 24): bytes=%zu: \", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    // Mix\n    c.len = 0;\n    range_encoder_new(&enc, &out);\n    p = 1024;\n    encode_bit(1, &p, &enc);\n    encode_bit(0, &p, &enc);\n    encode_bit(1, &p, &enc);\n    enc.encode_direct_bits(&enc, 0x5, 4);\n    range_encoder_free(&enc);\n    printf(\"range_encoder mix: bytes=%zu: \", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n}\n\n// =========================\n// 6. Test packet_slab\n// =========================\nstatic void test_packet_slab() {\n    printf(\"=== PACKET SLAB ===\\n\");\n    printf(\"memory_usage(100) = %zu, memory_usage(0) = %zu\\n\",\n        packet_slab_memory_usage(100), packet_slab_memory_usage(0));\n    printf(\"sizeof(LZMAPacket) = %zu\\n\", sizeof(LZMAPacket));\n\n    PacketSlab* slab = packet_slab_new(10);\n    LZMAPacket* packets = packet_slab_packets(slab);\n    printf(\"size(10) = %zu, count(all literals) = %zu\\n\",\n        packet_slab_size(slab), packet_slab_count(slab));\n\n    // Mutate packets[0] to a length-3 match, count should reflect this\n    packets[0] = match_packet(5, 3);\n    printf(\"after match(5,3) at idx 0: count = %zu\\n\", packet_slab_count(slab));\n\n    // Long match at end\n    packets[0] = match_packet(5, 5);\n    packets[5] = literal_packet();\n    packets[6] = literal_packet();\n    packets[7] = literal_packet();\n    packets[8] = literal_packet();\n    packets[9] = literal_packet();\n    printf(\"after match(5,5)+literals: count = %zu\\n\", packet_slab_count(slab));\n\n    packet_slab_free(slab);\n}\n\n// =========================\n// 7. Test packet_slab_undo_stack\n// =========================\nstatic void test_packet_slab_undo_stack() {\n    printf(\"=== PACKET SLAB UNDO STACK ===\\n\");\n    PacketSlabUndoStack stack;\n    packet_slab_undo_stack_new(&stack);\n    printf(\"initial count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n\n    PacketSlab* slab = packet_slab_new(50);\n    LZMAPacket* packets = packet_slab_packets(slab);\n    // Insert 5 undos, count goes to 5\n    for (int i = 0; i < 5; i++) {\n        PacketSlabUndo undo = { .position = i, .old_packet = packets[i] };\n        packets[i] = short_rep_packet();\n        packet_slab_undo_stack_insert(&stack, undo);\n    }\n    printf(\"after 5 inserts, count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n\n    // Insert 20 more (total 25, exceeds UNDO_STACK_SIZE=16)\n    for (int i = 5; i < 25; i++) {\n        PacketSlabUndo undo = { .position = i, .old_packet = packets[i] };\n        packets[i] = match_packet(2, 1);\n        packet_slab_undo_stack_insert(&stack, undo);\n    }\n    printf(\"after 25 inserts, count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n\n    // Apply\n    packet_slab_undo_stack_apply(&stack, slab);\n    printf(\"after apply, count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n    for (int i = 0; i < 25; i++) {\n        if (packets[i].type != LITERAL) {\n            printf(\"  packet %d type = %d (FAIL)\\n\", i, packets[i].type);\n        }\n    }\n    printf(\"all 25 reverted to LITERAL OK\\n\");\n\n    packet_slab_undo_stack_free(&stack);\n    packet_slab_free(slab);\n}\n\n// =========================\n// 8. Test substring_enumerator\n// =========================\ntypedef struct {\n    size_t offsets[256];\n    size_t lengths[256];\n    size_t count;\n} SubstringCollector;\n\nstatic void substring_collect(void* user_data, size_t offset, size_t length) {\n    SubstringCollector* c = (SubstringCollector*) user_data;\n    c->offsets[c->count] = offset;\n    c->lengths[c->count] = length;\n    c->count++;\n}\n\nstatic void test_substring_enumerator() {\n    printf(\"=== SUBSTRING ENUMERATOR ===\\n\");\n    uint8_t data[] = {'h','e','l','l','o',' ','h','e','l','l','o'};\n    size_t data_size = 11;\n    SubstringEnumerator* e = substring_enumerator_new(data, data_size, 2, 273);\n\n    for (size_t pos = 0; pos < data_size; pos++) {\n        SubstringCollector c = {0};\n        substring_enumerator_for_each(e, pos, substring_collect, &c);\n        printf(\"pos %zu: count=%zu\", pos, c.count);\n        for (size_t i = 0; i < c.count; i++) {\n            printf(\" (%zu,%zu)\", c.offsets[i], c.lengths[i]);\n        }\n        printf(\"\\n\");\n    }\n    substring_enumerator_free(e);\n\n    printf(\"memory_usage(100) = %zu\\n\", substring_enumerator_memory_usage(100));\n}\n\n// =========================\n// 9. Test packet_enumerator\n// =========================\ntypedef struct {\n    LZMAPacket packets[256];\n    size_t count;\n} PEnumCollector;\n\nstatic void pen_callback(void* user_data, const LZMAState* state, LZMAPacket packet) {\n    (void) state;\n    PEnumCollector* c = (PEnumCollector*) user_data;\n    c->packets[c->count++] = packet;\n}\n\nstatic void test_packet_enumerator() {\n    printf(\"=== PACKET ENUMERATOR ===\\n\");\n    uint8_t data[] = {'a','b','c','a','b','c','a','b'};\n    size_t data_size = 8;\n\n    PacketEnumerator* pe = packet_enumerator_new(data, data_size);\n    LZMAState s;\n    LZMAProperties p = {0, 0, 0};\n    lzma_state_init(&s, data, data_size, p);\n\n    // Try at position 0, 3, 6\n    size_t positions[] = {0, 3, 6};\n    for (int pi = 0; pi < 3; pi++) {\n        s.position = positions[pi];\n        PEnumCollector c = {0};\n        packet_enumerator_for_each(pe, &s, pen_callback, &c);\n        printf(\"pos %zu: count=%zu\\n\", s.position, c.count);\n        for (size_t i = 0; i < c.count; i++) {\n            printf(\"  type=%d dist=%u len=%u\\n\",\n                c.packets[i].type, c.packets[i].dist, c.packets[i].len);\n        }\n    }\n    printf(\"memory_usage(100) = %zu\\n\", packet_enumerator_memory_usage(100));\n    packet_enumerator_free(pe);\n}\n\n// =========================\n// 10. Test lzma_state_promote_distance_at and push\n// =========================\nstatic void test_lzma_state_dists() {\n    printf(\"=== LZMA STATE DISTS ===\\n\");\n    LZMAState s;\n    uint8_t data[1] = {0};\n    LZMAProperties p = {0, 0, 0};\n    lzma_state_init(&s, data, 1, p);\n    s.dists[0] = 10;\n    s.dists[1] = 20;\n    s.dists[2] = 30;\n    s.dists[3] = 40;\n    lzma_state_push_distance(&s, 99);\n    printf(\"push 99: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n\n    // promote at index 0\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 0);\n    printf(\"promote 0: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 1);\n    printf(\"promote 1: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 2);\n    printf(\"promote 2: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 3);\n    printf(\"promote 3: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n}\n\n// =========================\n// 11. Test lzma_packet_encoder via perplexity for known data\n// =========================\nstatic void test_packet_encoder_perplexity() {\n    printf(\"=== PACKET ENCODER PERPLEXITY ===\\n\");\n    uint8_t data[] = {'a','b','c','a','b','c','a','b'};\n    size_t data_size = 8;\n\n    LZMAState s;\n    LZMAProperties p = {0, 0, 0};\n    lzma_state_init(&s, data, data_size, p);\n\n    EncoderInterface enc;\n    uint64_t perp = 0;\n    perplexity_encoder_new(&enc, &perp);\n\n    // encode literal\n    perp = 0;\n    LZMAState s1 = s;\n    lzma_encode_packet(&s1, &enc, literal_packet());\n    printf(\"literal at pos 0: perp=%llu, position=%zu, ctx_state=%u\\n\",\n        (unsigned long long)perp, s1.position, s1.ctx_state);\n\n    // encode literal then match(2, 3) - but state not advanced enough; let's do literal x3 then match\n    lzma_state_init(&s, data, data_size, p);\n    perp = 0;\n    lzma_encode_packet(&s, &enc, literal_packet());\n    lzma_encode_packet(&s, &enc, literal_packet());\n    lzma_encode_packet(&s, &enc, literal_packet());\n    printf(\"after 3 literals: perp=%llu, pos=%zu, ctx=%u\\n\",\n        (unsigned long long)perp, s.position, s.ctx_state);\n    lzma_encode_packet(&s, &enc, match_packet(2, 3));  // dist=2, len=3 from pos 3 -> repeat 'abc'\n    printf(\"after match(2,3): perp=%llu, pos=%zu, ctx=%u, dists=[%u,%u,%u,%u]\\n\",\n        (unsigned long long)perp, s.position, s.ctx_state,\n        s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n\n    // short_rep\n    lzma_state_init(&s, data, data_size, p);\n    perp = 0;\n    s.position = 3;\n    s.dists[0] = 2;\n    lzma_encode_packet(&s, &enc, short_rep_packet());\n    printf(\"short_rep at pos 3: perp=%llu, pos=%zu, ctx=%u\\n\",\n        (unsigned long long)perp, s.position, s.ctx_state);\n}\n\n// =========================\n// 12. Test max_heap with known sequences\n// =========================\nstatic int simple_cmp(void* user_data, unsigned a, unsigned b) {\n    (void) user_data;\n    return a - b;\n}\n\nstatic void test_max_heap() {\n    printf(\"=== MAX HEAP ===\\n\");\n    MaxHeap* h = max_heap_new(5, simple_cmp, NULL);\n    printf(\"count after new = %zu\\n\", max_heap_count(h));\n    unsigned val = 99;\n    bool got = max_heap_maximum(h, &val);\n    printf(\"maximum on empty: ret=%d val=%u\\n\", got, val);\n    printf(\"remove on empty: ret=%d\\n\", max_heap_remove_maximum(h));\n    printf(\"update on empty: ret=%d\\n\", max_heap_update_maximum(h));\n\n    bool ins;\n    ins = max_heap_insert(h, 3); printf(\"insert 3 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 1); printf(\"insert 1 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 5); printf(\"insert 5 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 2); printf(\"insert 2 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 4); printf(\"insert 4 -> %d\\n\", ins);\n    printf(\"count = %zu\\n\", max_heap_count(h));\n    // now full, try inserting 6\n    ins = max_heap_insert(h, 6); printf(\"insert 6 -> %d (count=%zu)\\n\", ins, max_heap_count(h));\n\n    while (max_heap_maximum(h, &val)) {\n        printf(\"max: %u\\n\", val);\n        max_heap_remove_maximum(h);\n    }\n    printf(\"count after pops = %zu\\n\", max_heap_count(h));\n\n    // Test clear\n    max_heap_insert(h, 1);\n    max_heap_insert(h, 2);\n    max_heap_clear(h);\n    printf(\"count after clear = %zu\\n\", max_heap_count(h));\n\n    max_heap_free(h);\n}\n\nint main() {\n    test_ctx_state_transitions();\n    test_header();\n    test_encode_bit();\n    test_encode_bit_tree();\n    test_perplexity_encoder();\n    test_range_encoder();\n    test_packet_slab();\n    test_packet_slab_undo_stack();\n    test_substring_enumerator();\n    test_packet_enumerator();\n    test_lzma_state_dists();\n    test_packet_encoder_perplexity();\n    test_max_heap();\n    printf(\"LOG2_LOOKUP[0] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[0]);\n    printf(\"LOG2_LOOKUP[1] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[1]);\n    printf(\"LOG2_LOOKUP[1024] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[1024]);\n    printf(\"LOG2_LOOKUP[2047] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[2047]);\n    printf(\"PROB_INIT_VAL = %u\\n\", PROB_INIT_VAL);\n    return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":160,"cache_read_input_tokens":101321,"cache_creation":{"ephemeral_5m_input_tokens":160,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"003c0021-c071-44bb-a307-8700b03e7db1","uuid":"af07131e-90b3-4592-86b2-ac81c93c2f82"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01B3DmcD9DGUfW8FEvGP7Y5q","type":"tool_result","content":"File created successfully at: /tmp/c_helpers/run_tests.c (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"003c0021-c071-44bb-a307-8700b03e7db1","uuid":"f535ec4b-d7a3-418b-b339-5fb8563ed926","timestamp":"2026-05-29T13:50:25.285Z","tool_use_result":{"type":"create","filePath":"/tmp/c_helpers/run_tests.c","content":"// Helper program to compute expected values for Rust tests by running C code.\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_state.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_packet.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_header_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/probability.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/range_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/probability_model.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/perplexity_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/lzma_packet_encoder.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/file_output.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/packet_slab.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/packet_slab_undo_stack.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/substring_enumerator.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/max_heap.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/packet_enumerator.h\"\n#include \"../harvest-crust-verify-DsNyH3/project/c_src/src/perplexity_table.h\"\n\n// =========================\n// 1. Test ctx_state transitions\n// =========================\nstatic void test_ctx_state_transitions() {\n    printf(\"=== CTX STATE TRANSITIONS ===\\n\");\n    LZMAState s;\n    LZMAProperties p = { .lc = 0, .lp = 0, .pb = 0 };\n    uint8_t data[1] = {0};\n\n    // For each input ctx_state and each packet type, print resulting state\n    for (int packet_type = 1; packet_type <= 4; packet_type++) {\n        for (int init_ctx = 0; init_ctx < 12; init_ctx++) {\n            lzma_state_init(&s, data, 1, p);\n            s.ctx_state = init_ctx;\n            lzma_state_update_ctx_state(&s, packet_type);\n            printf(\"packet_type=%d init=%d -> %d\\n\", packet_type, init_ctx, s.ctx_state);\n        }\n    }\n}\n\n// =========================\n// 2. Test header encoding properties\n// =========================\ntypedef struct {\n    uint8_t bytes[256];\n    size_t len;\n} ByteCollector;\n\nstatic bool collector_write(OutputInterface* out, const void* data, size_t size) {\n    ByteCollector* c = (ByteCollector*) out->private_data;\n    memcpy(c->bytes + c->len, data, size);\n    c->len += size;\n    return true;\n}\n\nstatic void test_header() {\n    printf(\"=== HEADER ===\\n\");\n    LZMAState s;\n    uint8_t data[3] = {1, 2, 3};\n    LZMAProperties p1 = { .lc = 3, .lp = 0, .pb = 2 };\n    lzma_state_init(&s, data, 3, p1);\n    OutputInterface out;\n    ByteCollector c = {0};\n    out.write = collector_write;\n    out.private_data = &c;\n    lzma_encode_header(&s, &out);\n    printf(\"header(lc=3,lp=0,pb=2,size=3): len=%zu bytes=\", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    LZMAProperties p2 = { .lc = 0, .lp = 0, .pb = 0 };\n    uint8_t data2[5] = {0};\n    lzma_state_init(&s, data2, 5, p2);\n    c.len = 0;\n    lzma_encode_header(&s, &out);\n    printf(\"header(lc=0,lp=0,pb=0,size=5): len=%zu bytes=\", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    // Test data_size that fits in u32\n    LZMAProperties p3 = { .lc = 1, .lp = 2, .pb = 3 };\n    uint8_t* data3 = malloc(0x100);\n    lzma_state_init(&s, data3, 0x100, p3);\n    c.len = 0;\n    lzma_encode_header(&s, &out);\n    printf(\"header(lc=1,lp=2,pb=3,size=0x100): len=%zu bytes=\", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n    free(data3);\n}\n\n// =========================\n// 3. Test probability_model\n// =========================\ntypedef struct {\n    uint8_t bits[1024];\n    Prob probs_after[1024];\n    size_t bit_count;\n    uint32_t direct_bits[256];\n    uint32_t direct_num_bits[256];\n    size_t direct_count;\n} CapturingEnc;\n\nstatic void cap_encode_bit(EncoderInterface* enc, bool bit, Prob prob) {\n    CapturingEnc* d = (CapturingEnc*) enc->private_data;\n    d->bits[d->bit_count] = bit;\n    d->probs_after[d->bit_count] = prob;\n    d->bit_count++;\n}\nstatic void cap_encode_direct_bits(EncoderInterface* enc, unsigned bits, unsigned num_bits) {\n    CapturingEnc* d = (CapturingEnc*) enc->private_data;\n    d->direct_bits[d->direct_count] = bits;\n    d->direct_num_bits[d->direct_count] = num_bits;\n    d->direct_count++;\n}\n\nstatic void test_encode_bit() {\n    printf(\"=== ENCODE BIT ===\\n\");\n    EncoderInterface enc;\n    CapturingEnc cap = {0};\n    enc.encode_bit = cap_encode_bit;\n    enc.encode_direct_bits = cap_encode_direct_bits;\n    enc.private_data = &cap;\n\n    // bit=0, prob=1024 (initial)\n    Prob p = 1024;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 1024) -> p=%u\\n\", p);\n    p = 1024;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 1024) -> p=%u\\n\", p);\n\n    // Iterate encode_bit(0) several times from initial value 1024\n    p = 1024;\n    for (int i = 0; i < 5; i++) {\n        encode_bit(0, &p, &enc);\n        printf(\"encode_bit(0) iter%d -> p=%u\\n\", i, p);\n    }\n\n    p = 1024;\n    for (int i = 0; i < 5; i++) {\n        encode_bit(1, &p, &enc);\n        printf(\"encode_bit(1) iter%d -> p=%u\\n\", i, p);\n    }\n\n    // Edge: prob=0\n    p = 0;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 0) -> p=%u\\n\", p);\n    p = 0;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 0) -> p=%u\\n\", p);\n\n    // Edge: prob=2047\n    p = 2047;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 2047) -> p=%u\\n\", p);\n    p = 2047;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 2047) -> p=%u\\n\", p);\n\n    // Edge: prob=2048\n    p = 2048;\n    encode_bit(0, &p, &enc);\n    printf(\"encode_bit(0, 2048) -> p=%u\\n\", p);\n    p = 2048;\n    encode_bit(1, &p, &enc);\n    printf(\"encode_bit(1, 2048) -> p=%u\\n\", p);\n}\n\nstatic void test_encode_bit_tree() {\n    printf(\"=== ENCODE BIT TREE ===\\n\");\n    EncoderInterface enc;\n    CapturingEnc cap = {0};\n    enc.encode_bit = cap_encode_bit;\n    enc.encode_direct_bits = cap_encode_direct_bits;\n    enc.private_data = &cap;\n\n    // 4-bit tree, encode value 0b1010 = 10\n    Prob probs[16];\n    for (int i = 0; i < 16; i++) probs[i] = 1024;\n    cap.bit_count = 0;\n    encode_bit_tree(10, probs, 4, &enc);\n    printf(\"encode_bit_tree(10, 4): captured %zu bits = \", cap.bit_count);\n    for (size_t i = 0; i < cap.bit_count; i++) printf(\"%d \", cap.bits[i]);\n    printf(\"\\n probs after: \");\n    for (int i = 1; i < 16; i++) printf(\"%u \", probs[i]);\n    printf(\"\\n\");\n\n    // reverse\n    for (int i = 0; i < 16; i++) probs[i] = 1024;\n    cap.bit_count = 0;\n    encode_bit_tree_reverse(10, probs, 4, &enc);\n    printf(\"encode_bit_tree_reverse(10, 4): captured %zu bits = \", cap.bit_count);\n    for (size_t i = 0; i < cap.bit_count; i++) printf(\"%d \", cap.bits[i]);\n    printf(\"\\n probs after: \");\n    for (int i = 1; i < 16; i++) printf(\"%u \", probs[i]);\n    printf(\"\\n\");\n}\n\n// =========================\n// 4. Test perplexity_encoder\n// =========================\nstatic void test_perplexity_encoder() {\n    printf(\"=== PERPLEXITY ENCODER ===\\n\");\n    EncoderInterface enc;\n    uint64_t perp = 0;\n    perplexity_encoder_new(&enc, &perp);\n\n    enc.encode_bit(&enc, 0, 1024);\n    printf(\"after encode_bit(0, 1024): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_bit(&enc, 1, 1024);\n    printf(\"after encode_bit(1, 1024): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_bit(&enc, 0, 0);\n    printf(\"after encode_bit(0, 0): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_bit(&enc, 1, 2048);\n    printf(\"after encode_bit(1, 2048): perp=%llu\\n\", (unsigned long long)perp);\n\n    enc.encode_direct_bits(&enc, 0xFF, 8);\n    printf(\"after encode_direct_bits(0xFF, 8): perp=%llu\\n\", (unsigned long long)perp);\n    enc.encode_direct_bits(&enc, 0, 4);\n    printf(\"after encode_direct_bits(0, 4): perp=%llu\\n\", (unsigned long long)perp);\n}\n\n// =========================\n// 5. Test range encoder\n// =========================\nstatic void test_range_encoder() {\n    printf(\"=== RANGE ENCODER ===\\n\");\n    OutputInterface out;\n    ByteCollector c = {0};\n    out.write = collector_write;\n    out.private_data = &c;\n\n    EncoderInterface enc;\n    range_encoder_new(&enc, &out);\n\n    // encode 5 zero bits with prob 1024\n    Prob p = 1024;\n    for (int i = 0; i < 5; i++) {\n        encode_bit(0, &p, &enc);\n    }\n    range_encoder_free(&enc);\n    printf(\"range_encoder bits=5 zeros prob=1024: bytes=%zu: \", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    // Direct bits\n    c.len = 0;\n    range_encoder_new(&enc, &out);\n    enc.encode_direct_bits(&enc, 0xABCDEF, 24);\n    range_encoder_free(&enc);\n    printf(\"range_encoder direct(0xABCDEF, 24): bytes=%zu: \", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n\n    // Mix\n    c.len = 0;\n    range_encoder_new(&enc, &out);\n    p = 1024;\n    encode_bit(1, &p, &enc);\n    encode_bit(0, &p, &enc);\n    encode_bit(1, &p, &enc);\n    enc.encode_direct_bits(&enc, 0x5, 4);\n    range_encoder_free(&enc);\n    printf(\"range_encoder mix: bytes=%zu: \", c.len);\n    for (size_t i = 0; i < c.len; i++) printf(\"%02x \", c.bytes[i]);\n    printf(\"\\n\");\n}\n\n// =========================\n// 6. Test packet_slab\n// =========================\nstatic void test_packet_slab() {\n    printf(\"=== PACKET SLAB ===\\n\");\n    printf(\"memory_usage(100) = %zu, memory_usage(0) = %zu\\n\",\n        packet_slab_memory_usage(100), packet_slab_memory_usage(0));\n    printf(\"sizeof(LZMAPacket) = %zu\\n\", sizeof(LZMAPacket));\n\n    PacketSlab* slab = packet_slab_new(10);\n    LZMAPacket* packets = packet_slab_packets(slab);\n    printf(\"size(10) = %zu, count(all literals) = %zu\\n\",\n        packet_slab_size(slab), packet_slab_count(slab));\n\n    // Mutate packets[0] to a length-3 match, count should reflect this\n    packets[0] = match_packet(5, 3);\n    printf(\"after match(5,3) at idx 0: count = %zu\\n\", packet_slab_count(slab));\n\n    // Long match at end\n    packets[0] = match_packet(5, 5);\n    packets[5] = literal_packet();\n    packets[6] = literal_packet();\n    packets[7] = literal_packet();\n    packets[8] = literal_packet();\n    packets[9] = literal_packet();\n    printf(\"after match(5,5)+literals: count = %zu\\n\", packet_slab_count(slab));\n\n    packet_slab_free(slab);\n}\n\n// =========================\n// 7. Test packet_slab_undo_stack\n// =========================\nstatic void test_packet_slab_undo_stack() {\n    printf(\"=== PACKET SLAB UNDO STACK ===\\n\");\n    PacketSlabUndoStack stack;\n    packet_slab_undo_stack_new(&stack);\n    printf(\"initial count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n\n    PacketSlab* slab = packet_slab_new(50);\n    LZMAPacket* packets = packet_slab_packets(slab);\n    // Insert 5 undos, count goes to 5\n    for (int i = 0; i < 5; i++) {\n        PacketSlabUndo undo = { .position = i, .old_packet = packets[i] };\n        packets[i] = short_rep_packet();\n        packet_slab_undo_stack_insert(&stack, undo);\n    }\n    printf(\"after 5 inserts, count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n\n    // Insert 20 more (total 25, exceeds UNDO_STACK_SIZE=16)\n    for (int i = 5; i < 25; i++) {\n        PacketSlabUndo undo = { .position = i, .old_packet = packets[i] };\n        packets[i] = match_packet(2, 1);\n        packet_slab_undo_stack_insert(&stack, undo);\n    }\n    printf(\"after 25 inserts, count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n\n    // Apply\n    packet_slab_undo_stack_apply(&stack, slab);\n    printf(\"after apply, count = %zu\\n\", packet_slab_undo_stack_count(&stack));\n    for (int i = 0; i < 25; i++) {\n        if (packets[i].type != LITERAL) {\n            printf(\"  packet %d type = %d (FAIL)\\n\", i, packets[i].type);\n        }\n    }\n    printf(\"all 25 reverted to LITERAL OK\\n\");\n\n    packet_slab_undo_stack_free(&stack);\n    packet_slab_free(slab);\n}\n\n// =========================\n// 8. Test substring_enumerator\n// =========================\ntypedef struct {\n    size_t offsets[256];\n    size_t lengths[256];\n    size_t count;\n} SubstringCollector;\n\nstatic void substring_collect(void* user_data, size_t offset, size_t length) {\n    SubstringCollector* c = (SubstringCollector*) user_data;\n    c->offsets[c->count] = offset;\n    c->lengths[c->count] = length;\n    c->count++;\n}\n\nstatic void test_substring_enumerator() {\n    printf(\"=== SUBSTRING ENUMERATOR ===\\n\");\n    uint8_t data[] = {'h','e','l','l','o',' ','h','e','l','l','o'};\n    size_t data_size = 11;\n    SubstringEnumerator* e = substring_enumerator_new(data, data_size, 2, 273);\n\n    for (size_t pos = 0; pos < data_size; pos++) {\n        SubstringCollector c = {0};\n        substring_enumerator_for_each(e, pos, substring_collect, &c);\n        printf(\"pos %zu: count=%zu\", pos, c.count);\n        for (size_t i = 0; i < c.count; i++) {\n            printf(\" (%zu,%zu)\", c.offsets[i], c.lengths[i]);\n        }\n        printf(\"\\n\");\n    }\n    substring_enumerator_free(e);\n\n    printf(\"memory_usage(100) = %zu\\n\", substring_enumerator_memory_usage(100));\n}\n\n// =========================\n// 9. Test packet_enumerator\n// =========================\ntypedef struct {\n    LZMAPacket packets[256];\n    size_t count;\n} PEnumCollector;\n\nstatic void pen_callback(void* user_data, const LZMAState* state, LZMAPacket packet) {\n    (void) state;\n    PEnumCollector* c = (PEnumCollector*) user_data;\n    c->packets[c->count++] = packet;\n}\n\nstatic void test_packet_enumerator() {\n    printf(\"=== PACKET ENUMERATOR ===\\n\");\n    uint8_t data[] = {'a','b','c','a','b','c','a','b'};\n    size_t data_size = 8;\n\n    PacketEnumerator* pe = packet_enumerator_new(data, data_size);\n    LZMAState s;\n    LZMAProperties p = {0, 0, 0};\n    lzma_state_init(&s, data, data_size, p);\n\n    // Try at position 0, 3, 6\n    size_t positions[] = {0, 3, 6};\n    for (int pi = 0; pi < 3; pi++) {\n        s.position = positions[pi];\n        PEnumCollector c = {0};\n        packet_enumerator_for_each(pe, &s, pen_callback, &c);\n        printf(\"pos %zu: count=%zu\\n\", s.position, c.count);\n        for (size_t i = 0; i < c.count; i++) {\n            printf(\"  type=%d dist=%u len=%u\\n\",\n                c.packets[i].type, c.packets[i].dist, c.packets[i].len);\n        }\n    }\n    printf(\"memory_usage(100) = %zu\\n\", packet_enumerator_memory_usage(100));\n    packet_enumerator_free(pe);\n}\n\n// =========================\n// 10. Test lzma_state_promote_distance_at and push\n// =========================\nstatic void test_lzma_state_dists() {\n    printf(\"=== LZMA STATE DISTS ===\\n\");\n    LZMAState s;\n    uint8_t data[1] = {0};\n    LZMAProperties p = {0, 0, 0};\n    lzma_state_init(&s, data, 1, p);\n    s.dists[0] = 10;\n    s.dists[1] = 20;\n    s.dists[2] = 30;\n    s.dists[3] = 40;\n    lzma_state_push_distance(&s, 99);\n    printf(\"push 99: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n\n    // promote at index 0\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 0);\n    printf(\"promote 0: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 1);\n    printf(\"promote 1: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 2);\n    printf(\"promote 2: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n    s.dists[0] = 10; s.dists[1] = 20; s.dists[2] = 30; s.dists[3] = 40;\n    lzma_state_promote_distance_at(&s, 3);\n    printf(\"promote 3: %u %u %u %u\\n\", s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n}\n\n// =========================\n// 11. Test lzma_packet_encoder via perplexity for known data\n// =========================\nstatic void test_packet_encoder_perplexity() {\n    printf(\"=== PACKET ENCODER PERPLEXITY ===\\n\");\n    uint8_t data[] = {'a','b','c','a','b','c','a','b'};\n    size_t data_size = 8;\n\n    LZMAState s;\n    LZMAProperties p = {0, 0, 0};\n    lzma_state_init(&s, data, data_size, p);\n\n    EncoderInterface enc;\n    uint64_t perp = 0;\n    perplexity_encoder_new(&enc, &perp);\n\n    // encode literal\n    perp = 0;\n    LZMAState s1 = s;\n    lzma_encode_packet(&s1, &enc, literal_packet());\n    printf(\"literal at pos 0: perp=%llu, position=%zu, ctx_state=%u\\n\",\n        (unsigned long long)perp, s1.position, s1.ctx_state);\n\n    // encode literal then match(2, 3) - but state not advanced enough; let's do literal x3 then match\n    lzma_state_init(&s, data, data_size, p);\n    perp = 0;\n    lzma_encode_packet(&s, &enc, literal_packet());\n    lzma_encode_packet(&s, &enc, literal_packet());\n    lzma_encode_packet(&s, &enc, literal_packet());\n    printf(\"after 3 literals: perp=%llu, pos=%zu, ctx=%u\\n\",\n        (unsigned long long)perp, s.position, s.ctx_state);\n    lzma_encode_packet(&s, &enc, match_packet(2, 3));  // dist=2, len=3 from pos 3 -> repeat 'abc'\n    printf(\"after match(2,3): perp=%llu, pos=%zu, ctx=%u, dists=[%u,%u,%u,%u]\\n\",\n        (unsigned long long)perp, s.position, s.ctx_state,\n        s.dists[0], s.dists[1], s.dists[2], s.dists[3]);\n\n    // short_rep\n    lzma_state_init(&s, data, data_size, p);\n    perp = 0;\n    s.position = 3;\n    s.dists[0] = 2;\n    lzma_encode_packet(&s, &enc, short_rep_packet());\n    printf(\"short_rep at pos 3: perp=%llu, pos=%zu, ctx=%u\\n\",\n        (unsigned long long)perp, s.position, s.ctx_state);\n}\n\n// =========================\n// 12. Test max_heap with known sequences\n// =========================\nstatic int simple_cmp(void* user_data, unsigned a, unsigned b) {\n    (void) user_data;\n    return a - b;\n}\n\nstatic void test_max_heap() {\n    printf(\"=== MAX HEAP ===\\n\");\n    MaxHeap* h = max_heap_new(5, simple_cmp, NULL);\n    printf(\"count after new = %zu\\n\", max_heap_count(h));\n    unsigned val = 99;\n    bool got = max_heap_maximum(h, &val);\n    printf(\"maximum on empty: ret=%d val=%u\\n\", got, val);\n    printf(\"remove on empty: ret=%d\\n\", max_heap_remove_maximum(h));\n    printf(\"update on empty: ret=%d\\n\", max_heap_update_maximum(h));\n\n    bool ins;\n    ins = max_heap_insert(h, 3); printf(\"insert 3 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 1); printf(\"insert 1 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 5); printf(\"insert 5 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 2); printf(\"insert 2 -> %d\\n\", ins);\n    ins = max_heap_insert(h, 4); printf(\"insert 4 -> %d\\n\", ins);\n    printf(\"count = %zu\\n\", max_heap_count(h));\n    // now full, try inserting 6\n    ins = max_heap_insert(h, 6); printf(\"insert 6 -> %d (count=%zu)\\n\", ins, max_heap_count(h));\n\n    while (max_heap_maximum(h, &val)) {\n        printf(\"max: %u\\n\", val);\n        max_heap_remove_maximum(h);\n    }\n    printf(\"count after pops = %zu\\n\", max_heap_count(h));\n\n    // Test clear\n    max_heap_insert(h, 1);\n    max_heap_insert(h, 2);\n    max_heap_clear(h);\n    printf(\"count after clear = %zu\\n\", max_heap_count(h));\n\n    max_heap_free(h);\n}\n\nint main() {\n    test_ctx_state_transitions();\n    test_header();\n    test_encode_bit();\n    test_encode_bit_tree();\n    test_perplexity_encoder();\n    test_range_encoder();\n    test_packet_slab();\n    test_packet_slab_undo_stack();\n    test_substring_enumerator();\n    test_packet_enumerator();\n    test_lzma_state_dists();\n    test_packet_encoder_perplexity();\n    test_max_heap();\n    printf(\"LOG2_LOOKUP[0] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[0]);\n    printf(\"LOG2_LOOKUP[1] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[1]);\n    printf(\"LOG2_LOOKUP[1024] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[1024]);\n    printf(\"LOG2_LOOKUP[2047] = %llu\\n\", (unsigned long long)LOG2_LOOKUP[2047]);\n    printf(\"PROB_INIT_VAL = %u\\n\", PROB_INIT_VAL);\n    return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
