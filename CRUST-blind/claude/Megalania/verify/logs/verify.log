{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016ubsMMpxXGwLA2kVwt4B7g","type":"tool_result","content":"1\tuse crate::encoder_interface::EncoderInterface;\n2\tuse crate::lzma_packet::LZMAPacket;\n3\tuse crate::lzma_packet_encoder::lzma_encode_packet;\n4\tuse crate::lzma_state::LZMAState;\n5\tuse crate::max_heap::MaxHeap;\n6\tuse crate::packet_enumerator::PacketEnumerator;\n7\tuse crate::probability::Prob;\n8\tuse std::cell::RefCell;\n9\t\n10\t/// A single entry for a Top-K packet candidate.\n11\tpub struct TopKEntry {\n12\t    pub packet: LZMAPacket,\n13\t    pub cost: f32,\n14\t}\n15\t\n16\t// Thread-local snapshot of the current finder's entry costs, used by the\n17\t// MaxHeap's comparator (which can only see two `u32` indices). Updated by\n18\t// the finder before any heap operation.\n19\tthread_local! {\n20\t    static FINDER_COSTS: RefCell<Vec<f32>> = const { RefCell::new(Vec::new()) };\n21\t}\n22\t\n23\tfn set_finder_costs(entries: &[TopKEntry]) {\n24\t    FINDER_COSTS.with(|costs| {\n25\t        let mut costs = costs.borrow_mut();\n26\t        costs.clear();\n27\t        for e in entries {\n28\t            costs.push(e.cost);\n29\t        }\n30\t    });\n31\t}\n32\t\n33\tfn update_finder_cost(index: usize, cost: f32) {\n34\t    FINDER_COSTS.with(|costs| {\n35\t        let mut costs = costs.borrow_mut();\n36\t        if costs.len() <= index {\n37\t            costs.resize(index + 1, 0.0);\n38\t        }\n39\t        costs[index] = cost;\n40\t    });\n41\t}\n42\t\n43\tfn cost_comparator(a: u32, b: u32) -> i32 {\n44\t    FINDER_COSTS.with(|costs| {\n45\t        let costs = costs.borrow();\n46\t        let ca = costs[a as usize];\n47\t        let cb = costs[b as usize];\n48\t        if ca < cb {\n49\t            -1\n50\t        } else if ca > cb {\n51\t            1\n52\t        } else {\n53\t            0\n54\t        }\n55\t    })\n56\t}\n57\t\n58\t/// A simple perplexity-tracking encoder used internally by the finder.\n59\tstruct CostEncoder<'a> {\n60\t    perplexity: &'a mut u64,\n61\t}\n62\t\n63\timpl<'a> EncoderInterface for CostEncoder<'a> {\n64\t    fn encode_bit(&mut self, bit: bool, prob: Prob) {\n65\t        let idx = if bit {\n66\t            (2048u32 - prob as u32) as usize\n67\t        } else {\n68\t            prob as usize\n69\t        };\n70\t        *self.perplexity += crate::perplexity_table::LOG2_LOOKUP[idx];\n71\t    }\n72\t\n73\t    fn encode_direct_bits(&mut self, _bits: u32, num_bits: u32) {\n74\t        *self.perplexity += (num_bits as u64) << 11;\n75\t    }\n76\t}\n77\t\n78\t/// Finds the top-K best packets for encoding.\n79\tpub struct TopKPacketFinder<'a> {\n80\t    /// The maximum number of entries.\n81\t    pub size: usize,\n82\t    /// A vector holding the candidate TopK entries.\n83\t    pub entries: Vec<TopKEntry>,\n84\t    /// A vector holding the next packet values.\n85\t    pub next_packets: Vec<LZMAPacket>,\n86\t    /// A max-heap structure used for maintaining the order of entries.\n87\t    pub heap: Box<MaxHeap>,\n88\t    /// A reference to the packet enumerator used to generate candidate packets.\n89\t    pub packet_enumerator: &'a PacketEnumerator<'a>,\n90\t}\n91\timpl<'a> TopKPacketFinder<'a> {\n92\t    pub fn new(size: usize, packet_enumerator: &'a PacketEnumerator<'a>) -> Self {\n93\t        let comparator: Box<dyn Fn(u32, u32) -> i32> = Box::new(cost_comparator);\n94\t        let heap = Box::new(MaxHeap::new(size, comparator));\n95\t        Self {\n96\t            size,\n97\t            entries: Vec::with_capacity(size),\n98\t            next_packets: Vec::new(),\n99\t            heap,\n100\t            packet_enumerator,\n101\t        }\n102\t    }\n103\t    pub fn count(&self) -> usize {\n104\t        self.heap.count()\n105\t    }\n106\t\n107\t    fn insert_entry(&mut self, entry: TopKEntry) {\n108\t        let count = self.heap.count();\n109\t        if count < self.size {\n110\t            // There is room: append and insert into heap.\n111\t            let pos = self.entries.len();\n112\t            update_finder_cost(pos, entry.cost);\n113\t            self.entries.push(entry);\n114\t            self.heap.insert(pos as u32);\n115\t            return;\n116\t        }\n117\t        // Otherwise, compare with the current maximum (worst entry).\n118\t        let maximum = self.heap.maximum().expect(\"heap is full but has no max\");\n119\t        let max_cost = self.entries[maximum as usize].cost;\n120\t        if entry.cost <= max_cost {\n121\t            update_finder_cost(maximum as usize, entry.cost);\n122\t            self.entries[maximum as usize] = entry;\n123\t            self.heap.update_maximum();\n124\t        }\n125\t    }\n126\t\n127\t    pub fn find(&mut self, lzma_state: &LZMAState, next_packets: &mut [LZMAPacket]) {\n128\t        // Snapshot next_packets so the callback can compare against it without\n129\t        // borrowing conflicts.\n130\t        self.next_packets.clear();\n131\t        self.next_packets.extend_from_slice(next_packets);\n132\t        // Reset entries and the heap.\n133\t        self.entries.clear();\n134\t        self.heap.clear();\n135\t        set_finder_costs(&[]);\n136\t\n137\t        // Collect candidates from the packet enumerator first. We can't borrow\n138\t        // `self` mutably from inside the callback (it takes `Fn`), so we use\n139\t        // a RefCell to accumulate and then process.\n140\t        let candidates_cell: RefCell<Vec<LZMAPacket>> = RefCell::new(Vec::new());\n141\t        // Track position to filter dupes against next_packets.\n142\t        let pos = lzma_state.position;\n143\t        let next_packet_at_pos = if pos < self.next_packets.len() {\n144\t            Some(self.next_packets[pos])\n145\t        } else {\n146\t            None\n147\t        };\n148\t\n149\t        self.packet_enumerator\n150\t            .for_each(lzma_state, |_state, packet| {\n151\t                if let Some(np) = next_packet_at_pos {\n152\t                    if LZMAPacket::cmp(&packet, &np) {\n153\t                        return;\n154\t                    }\n155\t                }\n156\t                candidates_cell.borrow_mut().push(packet);\n157\t            });\n158\t        let candidates = candidates_cell.into_inner();\n159\t\n160\t        // For each candidate, simulate encoding and compute cost.\n161\t        for packet in candidates {\n162\t            let mut new_state = lzma_state.clone();\n163\t            let mut perplexity: u64 = 0;\n164\t            let start_position = new_state.position;\n165\t            {\n166\t                let mut enc = CostEncoder {\n167\t                    perplexity: &mut perplexity,\n168\t                };\n169\t                lzma_encode_packet(&mut new_state, &mut enc, packet);\n170\t            }\n171\t\n172\t            let length = new_state.position - start_position;\n173\t            if length == 0 {\n174\t                continue;\n175\t            }\n176\t            let cost = (perplexity as f32) / (length as f32);\n177\t            let entry = TopKEntry { packet, cost };\n178\t            self.insert_entry(entry);\n179\t        }\n180\t    }\n181\t\n182\t    pub fn pop(&mut self) -> Option<LZMAPacket> {\n183\t        let maximum = self.heap.maximum()?;\n184\t        let packet = self.entries[maximum as usize].packet;\n185\t        self.heap.remove_maximum();\n186\t        Some(packet)\n187\t    }\n188\t}\n189\t"}]},"parent_tool_use_id":null,"session_id":"003c0021-c071-44bb-a307-8700b03e7db1","uuid":"3ff5ce74-6868-4939-8092-09581b249c40","timestamp":"2026-05-29T13:47:56.152Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-DsNyH3/project/src/top_k_packet_finder.rs","content":"use crate::encoder_interface::EncoderInterface;\nuse crate::lzma_packet::LZMAPacket;\nuse crate::lzma_packet_encoder::lzma_encode_packet;\nuse crate::lzma_state::LZMAState;\nuse crate::max_heap::MaxHeap;\nuse crate::packet_enumerator::PacketEnumerator;\nuse crate::probability::Prob;\nuse std::cell::RefCell;\n\n/// A single entry for a Top-K packet candidate.\npub struct TopKEntry {\n    pub packet: LZMAPacket,\n    pub cost: f32,\n}\n\n// Thread-local snapshot of the current finder's entry costs, used by the\n// MaxHeap's comparator (which can only see two `u32` indices). Updated by\n// the finder before any heap operation.\nthread_local! {\n    static FINDER_COSTS: RefCell<Vec<f32>> = const { RefCell::new(Vec::new()) };\n}\n\nfn set_finder_costs(entries: &[TopKEntry]) {\n    FINDER_COSTS.with(|costs| {\n        let mut costs = costs.borrow_mut();\n        costs.clear();\n        for e in entries {\n            costs.push(e.cost);\n        }\n    });\n}\n\nfn update_finder_cost(index: usize, cost: f32) {\n    FINDER_COSTS.with(|costs| {\n        let mut costs = costs.borrow_mut();\n        if costs.len() <= index {\n            costs.resize(index + 1, 0.0);\n        }\n        costs[index] = cost;\n    });\n}\n\nfn cost_comparator(a: u32, b: u32) -> i32 {\n    FINDER_COSTS.with(|costs| {\n        let costs = costs.borrow();\n        let ca = costs[a as usize];\n        let cb = costs[b as usize];\n        if ca < cb {\n            -1\n        } else if ca > cb {\n            1\n        } else {\n            0\n        }\n    })\n}\n\n/// A simple perplexity-tracking encoder used internally by the finder.\nstruct CostEncoder<'a> {\n    perplexity: &'a mut u64,\n}\n\nimpl<'a> EncoderInterface for CostEncoder<'a> {\n    fn encode_bit(&mut self, bit: bool, prob: Prob) {\n        let idx = if bit {\n            (2048u32 - prob as u32) as usize\n        } else {\n            prob as usize\n        };\n        *self.perplexity += crate::perplexity_table::LOG2_LOOKUP[idx];\n    }\n\n    fn encode_direct_bits(&mut self, _bits: u32, num_bits: u32) {\n        *self.perplexity += (num_bits as u64) << 11;\n    }\n}\n\n/// Finds the top-K best packets for encoding.\npub struct TopKPacketFinder<'a> {\n    /// The maximum number of entries.\n    pub size: usize,\n    /// A vector holding the candidate TopK entries.\n    pub entries: Vec<TopKEntry>,\n    /// A vector holding the next packet values.\n    pub next_packets: Vec<LZMAPacket>,\n    /// A max-heap structure used for maintaining the order of entries.\n    pub heap: Box<MaxHeap>,\n    /// A reference to the packet enumerator used to generate candidate packets.\n    pub packet_enumerator: &'a PacketEnumerator<'a>,\n}\nimpl<'a> TopKPacketFinder<'a> {\n    pub fn new(size: usize, packet_enumerator: &'a PacketEnumerator<'a>) -> Self {\n        let comparator: Box<dyn Fn(u32, u32) -> i32> = Box::new(cost_comparator);\n        let heap = Box::new(MaxHeap::new(size, comparator));\n        Self {\n            size,\n            entries: Vec::with_capacity(size),\n            next_packets: Vec::new(),\n            heap,\n            packet_enumerator,\n        }\n    }\n    pub fn count(&self) -> usize {\n        self.heap.count()\n    }\n\n    fn insert_entry(&mut self, entry: TopKEntry) {\n        let count = self.heap.count();\n        if count < self.size {\n            // There is room: append and insert into heap.\n            let pos = self.entries.len();\n            update_finder_cost(pos, entry.cost);\n            self.entries.push(entry);\n            self.heap.insert(pos as u32);\n            return;\n        }\n        // Otherwise, compare with the current maximum (worst entry).\n        let maximum = self.heap.maximum().expect(\"heap is full but has no max\");\n        let max_cost = self.entries[maximum as usize].cost;\n        if entry.cost <= max_cost {\n            update_finder_cost(maximum as usize, entry.cost);\n            self.entries[maximum as usize] = entry;\n            self.heap.update_maximum();\n        }\n    }\n\n    pub fn find(&mut self, lzma_state: &LZMAState, next_packets: &mut [LZMAPacket]) {\n        // Snapshot next_packets so the callback can compare against it without\n        // borrowing conflicts.\n        self.next_packets.clear();\n        self.next_packets.extend_from_slice(next_packets);\n        // Reset entries and the heap.\n        self.entries.clear();\n        self.heap.clear();\n        set_finder_costs(&[]);\n\n        // Collect candidates from the packet enumerator first. We can't borrow\n        // `self` mutably from inside the callback (it takes `Fn`), so we use\n        // a RefCell to accumulate and then process.\n        let candidates_cell: RefCell<Vec<LZMAPacket>> = RefCell::new(Vec::new());\n        // Track position to filter dupes against next_packets.\n        let pos = lzma_state.position;\n        let next_packet_at_pos = if pos < self.next_packets.len() {\n            Some(self.next_packets[pos])\n        } else {\n            None\n        };\n\n        self.packet_enumerator\n            .for_each(lzma_state, |_state, packet| {\n                if let Some(np) = next_packet_at_pos {\n                    if LZMAPacket::cmp(&packet, &np) {\n                        return;\n                    }\n                }\n                candidates_cell.borrow_mut().push(packet);\n            });\n        let candidates = candidates_cell.into_inner();\n\n        // For each candidate, simulate encoding and compute cost.\n        for packet in candidates {\n            let mut new_state = lzma_state.clone();\n            let mut perplexity: u64 = 0;\n            let start_position = new_state.position;\n            {\n                let mut enc = CostEncoder {\n                    perplexity: &mut perplexity,\n                };\n                lzma_encode_packet(&mut new_state, &mut enc, packet);\n            }\n\n            let length = new_state.position - start_position;\n            if length == 0 {\n                continue;\n            }\n            let cost = (perplexity as f32) / (length as f32);\n            let entry = TopKEntry { packet, cost };\n            self.insert_entry(entry);\n        }\n    }\n\n    pub fn pop(&mut self) -> Option<LZMAPacket> {\n        let maximum = self.heap.maximum()?;\n        let packet = self.entries[maximum as usize].packet;\n        self.heap.remove_maximum();\n        Some(packet)\n    }\n}\n","numLines":189,"startLine":1,"totalLines":189}}}
