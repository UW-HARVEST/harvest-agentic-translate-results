   uint8_t pin[4] = {0xDE, 0xAD, 0xBE, 0xEF};\n    printf(\"pack32(DEADBEEF)=%08x\\n\", pack32(pin));\n\n    /* unpack32(0) */\n    unpack32(0, p);\n    printf(\"unpack32_0=%02x %02x %02x %02x\\n\", p[0], p[1], p[2], p[3]);\n\n    /* unpack32(MAX) */\n    unpack32(0xFFFFFFFF, p);\n    printf(\"unpack32_max=%02x %02x %02x %02x\\n\", p[0], p[1], p[2], p[3]);\n\n    /* unpack64(0) */\n    unpack64(0, p);\n    printf(\"unpack64_0=%02x %02x %02x %02x %02x %02x %02x %02x\\n\",\n           p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);\n\n    /* rotl */\n    printf(\"rotl(1,1)=%u\\n\", rotl(1u, 1));\n    printf(\"rotl(1,31)=%u\\n\", rotl(1u, 31));\n    printf(\"rotl(0x80000000,1)=%u\\n\", rotl(0x80000000u, 1));\n    printf(\"rotl(0xDEADBEEF,4)=0x%x\\n\", rotl(0xDEADBEEFu, 4));\n    printf(\"rotl(0xDEADBEEF,16)=0x%x\\n\", rotl(0xDEADBEEFu, 16));\n\n    return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
