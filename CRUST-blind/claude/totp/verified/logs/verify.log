0u8; 3]);\n}\n\n#[test]\nfn test_strlen_empty() {\n    assert_eq!(std::strlen(\"\"), 0);\n}\n\n#[test]\nfn test_strlen_basic() {\n    assert_eq!(std::strlen(\"hello\"), 5);\n}\n\n#[test]\nfn test_strlen_one_char() {\n    assert_eq!(std::strlen(\"a\"), 1);\n}\n\n#[test]\nfn test_strlen_long() {\n    assert_eq!(std::strlen(\"The quick brown fox\"), 19);\n}\n\n#[test]\nfn test_strlen_with_embedded_null() {\n    // Rust strlen mirrors C: stops at first null byte\n    let s = \"abc\\0def\";\n    assert_eq!(std::strlen(s), 3);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":177,"cache_read_input_tokens":31534,"cache_creation":{"ephemeral_5m_input_tokens":177,"ephemeral_1h_input_tokens":0},"output_tokens":38,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f53d3676-cdf3-4652-a4b0-3bd2c1415a75","uuid":"14534b76-c5a0-4f97-8152-a68fb81972d9"}
