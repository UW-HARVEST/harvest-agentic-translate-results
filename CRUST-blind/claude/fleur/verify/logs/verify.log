ter bf2 = fleur_initialize(2, 0.01, \"\");\n    int a1 = fleur_add(&bf2, \"x\", 1);\n    int a2 = fleur_add(&bf2, \"y\", 1);\n    int a3 = fleur_add(&bf2, \"z\", 1);\n    printf(\"fill capacity 2: %d %d %d (n=%lu N=%lu)\\n\", a1, a2, a3,\n        (unsigned long)bf2.h.n, (unsigned long)bf2.h.N);\n\n    /* Roundtrip a small filter */\n    BloomFilter bf3 = fleur_initialize(100, 0.001, \"\");\n    /* allocate Data on heap so set_data's free won't UB */\n    bf3.Data = calloc(1, 1);\n    bf3.datasize = 0;\n    fleur_set_data(&bf3, \"hi!\", 3);\n    fleur_add(&bf3, \"one\", 3);\n    fleur_add(&bf3, \"two\", 3);\n\n    FILE *f = fopen(\"/tmp/c_build/rt.bloom\", \"wb\");\n    int wrote = fleur_bloom_filter_to_file(&bf3, f);\n    fclose(f);\n    printf(\"write ret: %d\\n\", wrote);\n\n    /* Read it back */\n    f = fopen(\"/tmp/c_build/rt.bloom\", \"rb\");\n    BloomFilter bf4 = fleur_bloom_filter_from_file(f);\n    fclose(f);\n    printf(\"rt read: error=%d N=%lu n=%lu p=%g k=%lu m=%lu M=%lu datasize=%lu data='%.*s'\\n\",\n        bf4.error, (unsigned long)bf4.h.N, (unsigned long)bf4.h.n, bf4.h.p,\n        (unsigned long)bf4.h.k, (unsigned long)bf4.h.m, (unsigned long)bf4.M,\n        (unsigned long)bf4.datasize, (int)bf4.datasize, bf4.Data);\n    printf(\"rt check one: %d\\n\", fleur_check(&bf4, \"one\", 3));\n    printf(\"rt check two: %d\\n\", fleur_check(&bf4, \"two\", 3));\n    printf(\"rt check three: %d\\n\", fleur_check(&bf4, \"three\", 5));\n\n    /* Test set_data */\n    BloomFilter bf5 = fleur_initialize(10, 0.01, \"init_data\");\n    printf(\"bf5 datasize before set: %lu\\n\", (unsigned long)bf5.datasize);\n    /* note: in fleur_initialize, datasize is not set, but bf5.Data points to \"init_data\" */\n    fleur_set_data(&bf5, \"newdata\", 7);\n    printf(\"bf5 after set_data: datasize=%lu data='%.*s'\\n\",\n        (unsigned long)bf5.datasize, (int)bf5.datasize, bf5.Data);\n\n    /* Successful join */\n    BloomFilter a = fleur_initialize(100, 0.01, \"\");\n    BloomFilter b = fleur_initialize(100, 0.01, \"\");\n    fleur_add(&a, \"apple\", 5);\n    fleur_add(&a, \"pear\", 4);\n    fleur_add(&b, \"banana\", 6);\n    fleur_add(&b, \"kiwi\", 4);\n    int jr = fleur_join(&b, &a); // src=b, dst=a\n    printf(\"join b->a: %d a.N=%lu\\n\", jr, (unsigned long)a.h.N);\n    printf(\"a check apple=%d pear=%d banana=%d kiwi=%d\\n\",\n        fleur_check(&a, \"apple\", 5),\n        fleur_check(&a, \"pear\", 4),\n        fleur_check(&a, \"banana\", 6),\n        fleur_check(&a, \"kiwi\", 4));\n\n    /* mismatch joins */\n    BloomFilter c = fleur_initialize(200, 0.01, \"\");\n    int jr2 = fleur_join(&c, &a);\n    printf(\"join mismatch n: %d\\n\", jr2);\n\n    BloomFilter d = fleur_initialize(100, 0.001, \"\");\n    int jr3 = fleur_join(&d, &a);\n    printf(\"join mismatch p: %d\\n\", jr3);\n\n    return 0;\n}\n","structuredPatch":[{"oldStart":60,"oldLines":9,"newStart":60,"newLines":9,"lines":["     printf(\"rt check three: %d\\n\", fleur_check(&bf4, \"three\", 5));"," ","     /* Test set_data */","-    BloomFilter bf5 = fleur_initialize(10, 0.01, \"init_data\");","-    printf(\"bf5 datasize before set: %lu\\n\", (unsigned long)bf5.datasize);","-    /* note: in fleur_initialize, datasize is not set, but bf5.Data points to \"init_data\" */","+    BloomFilter bf5 = fleur_initialize(10, 0.01, \"\");","+    bf5.Data = calloc(1, 1);","+    bf5.datasize = 0;","     fleur_set_data(&bf5, \"newdata\", 7);","     printf(\"bf5 after set_data: datasize=%lu data='%.*s'\\n\",","         (unsigned long)bf5.datasize, (int)bf5.datasize, bf5.Data);"]}],"userModified":false,"replaceAll":false}}
