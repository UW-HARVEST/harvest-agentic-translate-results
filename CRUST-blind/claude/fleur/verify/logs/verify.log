\n    printf(\"print_bin(42)=%s\\n\", print_bin(42));\n}\n\nvoid test_check_header() {\n    // Construct a known good header (matches what initialize produces for n=10000, p=0.001)\n    BloomFilter bf = fleur_initialize(10000, 0.001, \"\");\n    printf(\"hdr good check_header=%d\\n\", fleur_check_header(&bf.h));\n    // Now break version\n    header h = bf.h;\n    h.version = 2;\n    printf(\"hdr version=2 check_header=%d\\n\", fleur_check_header(&h));\n    h = bf.h; h.k = 9223372036854775807ULL;\n    printf(\"hdr k=maxint check_header=%d\\n\", fleur_check_header(&h));\n    h = bf.h; h.p = 0.0;\n    printf(\"hdr p=0 check_header=%d\\n\", fleur_check_header(&h));\n    h = bf.h; h.p = 1.5;\n    printf(\"hdr p=1.5 check_header=%d\\n\", fleur_check_header(&h));\n    h = bf.h; h.N = h.n + 1;\n    printf(\"hdr N>n check_header=%d\\n\", fleur_check_header(&h));\n    h = bf.h; h.m = h.m + 1;\n    printf(\"hdr m wrong check_header=%d\\n\", fleur_check_header(&h));\n    h = bf.h; h.k = h.k + 1;\n    printf(\"hdr k wrong check_header=%d\\n\", fleur_check_header(&h));\n    h = bf.h; h.p = 1.0;\n    printf(\"hdr p=1.0 check_header=%d\\n\", fleur_check_header(&h));\n    fleur_destroy_filter(&bf);\n}\n\nvoid test_join_fixtures(const char *base) {\n    char path[512];\n    snprintf(path, sizeof(path), \"%s/datatest.bloom\", base);\n    FILE *infull = fopen(path, \"rb\");\n    snprintf(path, sizeof(path), \"%s/join1.bloom\", base);\n    FILE *fj1 = fopen(path, \"rb\");\n    snprintf(path, sizeof(path), \"%s/join2.bloom\", base);\n    FILE *fj2 = fopen(path, \"rb\");\n    snprintf(path, sizeof(path), \"%s/join3.bloom\", base);\n    FILE *fj3 = fopen(path, \"rb\");\n\n    BloomFilter j0 = fleur_bloom_filter_from_file(infull);\n    BloomFilter j1 = fleur_bloom_filter_from_file(fj1);\n    BloomFilter j2 = fleur_bloom_filter_from_file(fj2);\n    BloomFilter j3 = fleur_bloom_filter_from_file(fj3);\n\n    printf(\"j0 error=%d M=%lu n=%lu N=%lu m=%lu k=%lu p=%g\\n\",\n        j0.error, (uns