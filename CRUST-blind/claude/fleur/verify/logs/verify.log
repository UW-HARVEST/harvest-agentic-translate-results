jr, (unsigned long)a.h.N);\n    printf(\"a check apple=%d pear=%d banana=%d kiwi=%d\\n\",\n        fleur_check(&a, \"apple\", 5),\n        fleur_check(&a, \"pear\", 4),\n        fleur_check(&a, \"banana\", 6),\n        fleur_check(&a, \"kiwi\", 4));\n\n    /* mismatch joins */\n    BloomFilter c = fleur_initialize(200, 0.01, \"\");\n    int jr2 = fleur_join(&c, &a);\n    printf(\"join mismatch n: %d\\n\", jr2);\n\n    BloomFilter d = fleur_initialize(100, 0.001, \"\");\n    int jr3 = fleur_join(&d, &a);\n    printf(\"join mismatch p: %d\\n\", jr3);\n\n    return 0;\n}\n","structuredPatch":[{"oldStart":7,"oldLines":7,"newStart":7,"newLines":7,"lines":[" "," int main(int argc, char **argv) {","     BloomFilter bf = fleur_initialize(1000, 0.001, \"\");","-    fleur_set_data(&bf, \"hello\", 5);","+    /* skip set_data because it frees the original string literal */"," ","     fleur_add(&bf, \"alpha\", 5);","     fleur_add(&bf, \"beta\", 4);"]}],"userModified":false,"replaceAll":false}}
