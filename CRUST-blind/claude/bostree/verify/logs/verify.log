stree_insert(&mut self, key: String, data: Option<String>) -> Rc<RefCell<BOSNode>> {\n223\t        // Find tree position to insert new node.\n224\t        let mut current = self.root_node.clone();\n225\t        let mut parent_node: Option<Rc<RefCell<BOSNode>>> = None;\n226\t        let mut go_left = false;\n227\t\n228\t        while let Some(n) = current {\n229\t            parent_node = Some(n.clone());\n230\t            let cmp = (self.cmp_function)(&key, &n.borrow().key);\n231\t            if cmp < 0 {\n232\t                n.borrow_mut().left_child_count += 1;\n233\t                current = n.borrow().left_child_node.clone();\n234\t                go_left = true;\n235\t            } else {\n236\t                n.borrow_mut().right_child_count += 1;\n237\t                current = n.borrow().right_child_node.clone();\n238\t                go_left = false;\n239\t            }\n240\t        }\n241\t\n242\t        let new_node = Rc::new(RefCell::new(BOSNode {\n243\t            left_child_count: 0,\n244\t            right_child_count: 0,\n245\t            depth: 0,\n246\t            left_child_node: None,\n247\t            right_child_node: None,\n248\t            parent_node: parent_node.as_ref().map(|p| Rc::downgrade(p)),\n249\t            key,\n250\t            data,\n251\t            weak_ref_count: 1,\n252\t            weak_ref_node_valid: 1,\n253\t        }));\n254\t\n255\t        // No parent means this is the first node.\n256\t        let parent = match parent_node {\n257\t            None => {\n258\t                self.root_node = Some(new_node.clone());\n259\t                return new_node;\n260\t            }\n261\t            Some(p) => p,\n262\t        };\n263\t\n264\t        if go_left {\n265\t            parent.borrow_mut().left_child_node = Some(new_node.clone());\n266\t        } else {\n267\t            parent.borrow_mut().right_child_node = Some(new_node.clone());\n268\t        }\n269\t\n270\t        // Check if the depth changed: only if the parent had no other child before.\n271\t        let parent_has_one_child = {\n272\t            let p = parent.borrow();\n273\t            p.left_child_node.is_some() ^ p.right_child_node.is_some()\n274\t        };\n275\t\n276\t        if parent_has_one_child {\n277\t            parent.borrow_mut().depth += 1;\n278\t            let mut p_node = parent;\n279\t            while let Some(p_parent) = get_parent(&p_node) {\n280\t                p_node = p_parent;\n281\t\n282\t                let new_left_depth = p_node\n283\t                    .borrow()\n284\t                    .left_child_node\n285\t                    .as_ref()\n286\t                    .map_or(0u32, |n| n.borrow().depth + 1);\n287\t                let new_right_depth = p_node\n288\t                    .borrow()\n289\t                    .right_child_node\n290\t                    .as_ref()\n291\t                    .map_or(0u32, |n| n.borrow().depth + 1);\n292\t                let max_depth = max(new_left_depth, new_right_depth);\n293\t\n294\t                let cur_depth = p_node.borrow().depth;\n295\t                if cur_depth != max_depth {\n296\t                    p_node.borrow_mut().depth = max_depth;\n297\t                } else {\n298\t                    // Depth unchanged here, propagation can stop.\n299\t                    break;\n300\t                }\n301\t\n302\t                let nld = new_left_depth as i64;\n303\t                let nrd = new_right_depth as i64;\n304\t                if nld - 2 == nrd {\n305\t                    // Left-right case\n306\t                    let left_child = p_node.borrow().left_child_node.clone().unwrap();\n307\t                    if balance(&left_child) > 0 {\n308\t                        rotate_left(&mut self.root_node, &left_child);\n309\t                    }\n310\t                    p_node = rotate_right(&mut self.root_node, &p_node);\n311\t                } else if nld + 2 == nrd {\n312\t                    // Right-left case\n313\t                    let right_child = p_node.borrow().right_child_node.clone().unwrap();\n314\t                    if balance(&right_child) < 0 {\n315\t                        rotate_right(&mut self.root_node, &right_child);\n316\t                    }\n317\t                    p_node = rotate_left(&mut self.root_node, &p_node);\n318\t                }\n319\t            }\n320\t        }\n321\t\n322\t        new_node\n323\t    }\n324\t    /// Remove a given node from the tree.\n325\t    pub fn bostree_remove(&mut self, node: &Rc<RefCell<BOSNode>>) {\n326\t        let bubble_up: Option<Rc<RefCell<BOSNode>>>;\n327\t\n328\t        let has_left = node.borrow().left_child_node.is_some();\n329\t        let has_right = node.borrow().right_child_node.is_some();\n330\t\n331\t        if has_left && has_right {\n332\t            // Two-children case.\n333\t            let (candidate, lost_child) = {\n334\t                let left_depth = node\n335\t                    .borrow()\n336\t                    .left_child_node\n337\t                    .as_ref()\n338\t                    .unwrap()\n339\t                    .borrow()\n340\t                    .depth;\n341\t                let right_depth = node\n342\t                    .borrow()\n343\t                    .right_child_node\n344\t                    .as_ref()\n345\t                    .unwrap()\n346\t                    .borrow()\n347\t                    .depth;\n348\t                let go_left = left_depth >= right_depth;\n349\t\n350\t                if go_left {\n351\t                    node.borrow_mut().left_child_count -= 1;\n352\t                    let mut cand = node.borrow().left_child_node.clone().unwrap();\n353\t                    while cand.borrow().right_child_node.is_some() {\n354\t                        cand.borrow_mut().right_child_count -= 1;\n355\t                        let next = cand.borrow().right_child_node.clone().unwrap();\n356\t                        cand = next;\n357\t                    }\n358\t                    let lc = cand.borrow().left_child_node.clone();\n359\t                    (cand, lc)\n360\t                } else {\n361\t                    node.borrow_mut().right_child_count -= 1;\n362\t                    let mut cand = node.borrow().right_child_node.clone().unwrap();\n363\t                    while cand.borrow().left_child_node.is_some() {\n364\t                        cand.borrow_mut().left_child_count -= 1;\n365\t                        let next = cand.borrow().left_child_node.clone().unwrap();\n366\t                        cand = next;\n367\t                    }\n368\t                    let lc = cand.borrow().right_child_node.clone();\n369\t                    (cand, lc)\n370\t                }\n371\t            };\n372\t\n373\t            let bubble_start = get_parent(&candidate).expect(\"candidate must have a parent\");\n374\t\n375\t            // Splice out candidate, replacing it with lost_child in bubble_start.\n376\t            let candidate_is_left = bubble_start\n377\t                .borrow()\n378\t                .left_child_node\n379\t                .as_ref()\n380\t                .map_or(false, |c| Rc::ptr_eq(c, &candidate));\n381\t            if candidate_is_left {\n382\t                bubble_start.borrow_mut().left_child_node = lost_child.clone();\n383\t            } else {\n384\t                bubble_start.borrow_mut().right_child_node = lost_child.clone();\n385\t            }\n386\t            if let Some(ref lc) = lost_child {\n387\t                lc.borrow_mut().parent_node = Some(Rc::downgrade(&bubble_start));\n388\t            }\n389\t\n390\t            // Anchor candidate where node was.\n391\t            let node_parent = get_parent(node);\n392\t            match &node_parent {\n393\t                Some(np) => {\n394\t                    let node_is_left = np\n395\t                        .borrow()\n396\t                        .left_child_node\n397\t                        .as_ref()\n398\t                        .map_or(false, |c| Rc::ptr_eq(c, node));\n399\t                    if node_is_left {\n400\t                        np.borrow_mut().left_child_node = Some(candidate.clone());\n401\t                    } else {\n402\t                        np.borrow_mut().right_child_node = Some(candidate.clone());\n403\t                    }\n404\t                }\n405\t                None => {\n406\t                    self.root_node = Some(candidate.clone());\n407\t                }\n408\t            }\n409\t            candidate.borrow_mut().parent_node =\n410\t                node_parent.as_ref().map(|p| Rc::downgrade(p));\n411\t\n412\t            // Move node's children to candidate. Note: read AFTER splice so that\n413\t            // if candidate was directly under node, the changed node->[lr]_child_node\n414\t            // is observed.\n415\t            let node_left = node.borrow().left_child_node.clone();\n416\t            let node_right = node.borrow().right_child_node.clone();\n417\t            let node_left_count = node.borrow().left_child_count;\n418\t            let node_right_count = node.borrow().right_child_count;\n419\t\n420\t            candidate.borrow_mut().left_child_node = node_left.clone();\n421\t            candidate.borrow_mut().left_child_count = node_left_count;\n422\t            candidate.borrow_mut().right_child_node = node_right.clone();\n423\t            candidate.borrow_mut().right_child_count = node_right_count;\n424\t\n425\t            if let Some(ref lc) = node_left {\n426\t                lc.borrow_mut().parent_node = Some(Rc::downgrade(&candidate));\n427\t            }\n428\t            if let Some(ref rc) = node_right {\n429\t                rc.borrow_mut().parent_node = Some(Rc::downgrade(&candidate));\n430\t            }\n431\t\n432\t            // Rebalance up to candidate.\n433\t            if !Rc::ptr_eq(&bubble_start, node) {\n434\t                let mut bs = bubble_start.clone();\n435\t                while !Rc::ptr_eq(&bs, &candidate) {\n436\t                    update_depth(&bs);\n437\t                    let bal = balance(&bs);\n438\t                    if bal > 1 {\n439\t                        let right_child = bs.borrow().right_child_node.clone().unwrap();\n440\t                        if balance(&right_child) < 0 {\n441\t                            rotate_right(&mut self.root_node, &right_child);\n442\t                        }\n443\t                        bs = rotate_left(&mut self.root_node, &bs);\n444\t                    } else if bal < -1 {\n445\t                        let left_child = bs.borrow().left_child_node.clone().unwrap();\n446\t                        if balance(&left_child) > 0 {\n447\t                            rotate_left(&mut self.root_node, &left_child);\n448\t                        }\n449\t                        bs = rotate_right(&mut self.root_node, &bs);\n450\t                    }\n451\t                    let parent = get_parent(&bs).expect(\"walk should reach candidate\");\n452\t                    bs = parent;\n453\t                }\n454\t            }\n455\t\n456\t            update_depth(&candidate);\n457\t\n458\t            bubble_up = get_parent(&candidate);\n459\t\n460\t            if let Some(ref bu) = bubble_up {\n461\t                let candidate_is_left_of_bu = bu\n462\t                    .borrow()\n463\t                    .left_child_node\n464\t                    .as_ref()\n465\t                    .map_or(false, |c| Rc::ptr_eq(c, &candidate));\n466\t                if candidate_is_left_of_bu {\n467\t                    bu.borrow_mut().left_child_count -= 1;\n468\t                } else {\n469\t                    bu.borrow_mut().right_child_count -= 1;\n470\t                }\n471\t            }\n472\t        } else {\n473\t            // Zero or one child case.\n474\t            let node_parent = get_parent(node);\n475\t            match &node_parent {\n476\t                None => {\n477\t                    let new_root = if has_left {\n478\t                        node.borrow().left_child_node.clone()\n479\t                    } else {\n480\t                        node.borrow().right_child_node.clone()\n481\t                    };\n482\t                    if let Some(ref nr) = new_root {\n483\t                        nr.borrow_mut().parent_node = None;\n484\t                    }\n485\t                    self.root_node = new_root;\n486\t                    bubble_up = None;\n487\t                }\n488\t                Some(np) => {\n489\t                    let (candidate, candidate_count) =\n490\t                        if let Some(rc) = node.borrow().right_child_node.clone() {\n491\t                            let cc = node.borrow().right_child_count;\n492\t                            (Some(rc), cc)\n493\t                        } else {\n494\t                            let cc = node.borrow().left_child_count;\n495\t                            (node.borrow().left_child_node.clone(), cc)\n496\t                        };\n497\t\n498\t                    let node_is_left = np\n499\t                        .borrow()\n500\t                        .left_child_node\n501\t                        .as_ref()\n502\t                        .map_or(false, |c| Rc::ptr_eq(c, node));\n503\t                    if node_is_left {\n504\t                        np.borrow_mut().left_child_node = candidate.clone();\n505\t                        np.borrow_mut().left_child_count = candidate_count;\n506\t                    } else {\n507\t                        np.borrow_mut().right_child_node = candidate.clone();\n508\t                        np.borrow_mut().right_child_count = candidate_count;\n509\t                    }\n510\t\n511\t                    if let Some(ref c) = candidate {\n512\t                        c.borrow_mut().parent_node = Some(Rc::downgrade(np));\n513\t                    }\n514\t\n515\t                    bubble_up = Some(np.clone());\n516\t                }\n517\t            }\n518\t        }\n519\t\n520\t        // Bubble up rebalancing.\n521\t        let mut bubbling_finished = false;\n522\t        let mut bu = bubble_up;\n523\t        while let Some(node_bu) = bu {\n524\t            let post_node = if !bubbling_finished {\n525\t                let left_depth = node_bu\n526\t                    .borrow()\n527\t                    .left_child_node\n528\t                    .as_ref()\n529\t                    .map_or(0u32, |n| n.borrow().depth + 1);\n530\t                let right_depth = node_bu\n531\t                    .borrow()\n532\t                    .right_child_node\n533\t                    .as_ref()\n534\t                    .map_or(0u32, |n| n.borrow().depth + 1);\n535\t                let new_depth = max(left_depth, right_depth);\n536\t                let cur_depth = node_bu.borrow().depth;\n537\t                let depth_changed = new_depth != cur_depth;\n538\t                node_bu.borrow_mut().depth = new_depth;\n539\t\n540\t                let bal = balance(&node_bu);\n541\t                if bal < -1 {\n542\t                    let left_child = node_bu.borrow().left_child_node.clone().unwrap();\n543\t                    if balance(&left_child) > 0 {\n544\t                        rotate_left(&mut self.root_node, &left_child);\n545\t                    }\n546\t                    rotate_right(&mut self.root_node, &node_bu)\n547\t                } else if bal > 1 {\n548\t                    let right_child = node_bu.borrow().right_child_node.clone().unwrap();\n549\t                    if balance(&right_child) < 0 {\n550\t                        rotate_right(&mut self.root_node, &right_child);\n551\t                    }\n552\t                    rotate_left(&mut self.root_node, &node_bu)\n553\t                } else {\n554\t                    if !depth_changed {\n555\t                        bubbling_finished = true;\n556\t                    }\n557\t                    node_bu.clone()\n558\t                }\n559\t            } else {\n560\t                node_bu.clone()\n561\t            };\n562\t\n563\t            // Decrement parent's child count for the side that contains post_node.\n564\t            let parent = get_parent(&post_node);\n565\t            if let Some(ref p) = parent {\n566\t                let post_is_left = p\n567\t                    .borrow()\n568\t                    .left_child_node\n569\t                    .as_ref()\n570\t                    .map_or(false, |c| Rc::ptr_eq(c, &post_node));\n571\t                if post_is_left {\n572\t                    p.borrow_mut().left_child_count -= 1;\n573\t                } else {\n574\t                    p.borrow_mut().right_child_count -= 1;\n575\t                }\n576\t            }\n577\t            bu = parent;\n578\t        }\n579\t\n580\t        node.borrow_mut().weak_ref_node_valid = 0;\n581\t        self.bostree_node_weak_unref(node);\n582\t    }\n583\t    /// Decrease the weak reference count for a node; if that was the last reference,\n584\t    /// free the node and return None; otherwise return the node.\n585\t    pub fn bostree_node_weak_unref(\n586\t        &mut self,\n587\t        node: &Rc<RefCell<BOSNode>>,\n588\t    ) -> Option<Rc<RefCell<BOSNode>>> {\n589\t        let (count, valid) = {\n590\t            let mut n = node.borrow_mut();\n591\t            n.weak_ref_count = n.weak_ref_count.saturating_sub(1);\n592\t            (n.weak_ref_count, n.weak_ref_node_valid)\n593\t        };\n594\t\n595\t        if count == 0 {\n596\t            if let Some(free_fn) = self.free_function {\n597\t                free_fn(node);\n598\t            }\n599\t            None\n600\t        } else if valid != 0 {\n601\t            Some(node.clone())\n602\t        } else {\n603\t            None\n604\t        }\n605\t    }\n606\t    /// Lookup a node in the tree by its key.\n607\t    pub fn bostree_lookup(&self, key: &str) -> Option<Rc<RefCell<BOSNode>>> {\n608\t        let mut current = self.root_node.clone();\n609\t        while let Some(n) = current {\n610\t            let cmp = (self.cmp_function)(key, &n.borrow().key);\n611\t            if cmp == 0 {\n612\t                return Some(n);\n613\t            } else if cmp < 0 {\n614\t                let next = n.borrow().left_child_node.clone();\n615\t                current = next;\n616\t            } else {\n617\t                let next = n.borrow().right_child_node.clone();\n618\t                current = next;\n619\t            }\n620\t        }\n621\t        None\n622\t    }\n623\t    /// Return the node at the given in-order index (starting at 0).\n624\t    pub fn bostree_select(&self, mut index: u32) -> Option<Rc<RefCell<BOSNode>>> {\n625\t        let mut current = self.root_node.clone();\n626\t        while let Some(n) = current {\n627\t            let lcc = n.borrow().left_child_count;\n628\t            if lcc <= index {\n629\t                index -= lcc;\n630\t                if index == 0 {\n631\t                    return Some(n);\n632\t                }\n633\t                index -= 1;\n634\t                let next = n.borrow().right_child_node.clone();\n635\t                current = next;\n636\t            } else {\n637\t                let next = n.borrow().left_child_node.clone();\n638\t                current = next;\n639\t            }\n640\t        }\n641\t        None\n642\t    }\n643\t    /// Print the tree (only available in debug builds).\n644\t    #[cfg(debug_assertions)]\n645\t    pub fn bostree_print(&self) {\n646\t        if let Some(root) = &self.root_node {\n647\t            println!(\"digraph {{\\n  ordering = out;\");\n648\t            print_helper(root);\n649\t            println!(\"}}\");\n650\t        }\n651\t    }\n652\t}\n653\t\n654\t#[cfg(debug_assertions)]\n655\tfn print_helper(node: &Rc<RefCell<BOSNode>>) {\n656\t    let (key_clone, lcc, rcc, dep, parent_key, lc, rc) = {\n657\t        let nb = node.borrow();\n658\t        (\n659\t            nb.key.clone(),\n660\t            nb.left_child_count,\n661\t            nb.right_child_count,\n662\t            nb.depth,\n663\t            nb.parent_node\n664\t                .as_ref()\n665\t                .and_then(|w| w.upgrade())\n666\t                .map(|p| p.borrow().key.clone()),\n667\t            nb.left_child_node.clone(),\n668\t            nb.right_child_node.clone(),\n669\t        )\n670\t    };\n671\t    println!(\n672\t        \"  {} [label=\\\"\\\\N ({},{},{})\\\"];\",\n673\t        key_clone, lcc, rcc, dep\n674\t    );\n675\t    if let Some(pk) = parent_key {\n676\t        println!(\"  {} -> {} [color=green];\", key_clone, pk);\n677\t    }\n678\t    if let Some(l) = lc {\n679\t        println!(\"  {} -> {}\", key_clone, l.borrow().key);\n680\t        print_helper(&l);\n681\t    }\n682\t    if let Some(r) = rc {\n683\t        println!(\"  {} -> {}\", key_clone, r.borrow().key);\n684\t        print_helper(&r);\n685\t    }\n686\t}\n687\t\n688\t/// Increase the weak reference count for a node and return the node.\n689\tpub fn bostree_node_weak_ref(node: &Rc<RefCell<BOSNode>>) -> Rc<RefCell<BOSNode>> {\n690\t    {\n691\t        let mut n = node.borrow_mut();\n692\t        assert!(n.weak_ref_count < 127);\n693\t        assert!(n.weak_ref_count > 0);\n694\t        n.weak_ref_count += 1;\n695\t    }\n696\t    node.clone()\n697\t}\n698\t/// Return the next node in an in-order traversal.\n699\tpub fn bostree_next_node(node: &Rc<RefCell<BOSNode>>) -> Option<Rc<RefCell<BOSNode>>> {\n700\t    let right = node.borrow().right_child_node.clone();\n701\t    if let Some(r) = right {\n702\t        let mut cur = r;\n703\t        loop {\n704\t            let next = cur.borrow().left_child_node.clone();\n705\t            match next {\n706\t                Some(n) => cur = n,\n707\t                None => return Some(cur),\n708\t            }\n709\t        }\n710\t    }\n711\t    let mut cur = node.clone();\n712\t    loop {\n713\t        let parent = cur\n714\t            .borrow()\n715\t            .parent_node\n716\t            .as_ref()\n717\t            .and_then(|w| w.upgrade());\n718\t        match parent {\n719\t            Some(p) => {\n720\t                let is_right = p\n721\t                    .borrow()\n722\t                    .right_child_node\n723\t                    .as_ref()\n724\t                    .map_or(false, |r| Rc::ptr_eq(r, &cur));\n725\t                if is_right {\n726\t                    cur = p;\n727\t                } else {\n728\t                    return Some(p);\n729\t                }\n730\t            }\n731\t            None => return None,\n732\t        }\n733\t    }\n734\t}\n735\t/// Return the previous node in an in-order traversal.\n736\tpub fn bostree_previous_node(node: &Rc<RefCell<BOSNode>>) -> Option<Rc<RefCell<BOSNode>>> {\n737\t    let left = node.borrow().left_child_node.clone();\n738\t    if let Some(l) = left {\n739\t        let mut cur = l;\n740\t        loop {\n741\t            let next = cur.borrow().right_child_node.clone();\n742\t            match next {\n743\t                Some(n) => cur = n,\n744\t                None => return Some(cur),\n745\t            }\n746\t        }\n747\t    }\n748\t    let mut cur = node.clone();\n749\t    loop {\n750\t        let parent = cur\n751\t            .borrow()\n752\t            .parent_node\n753\t            .as_ref()\n754\t            .and_then(|w| w.upgrade());\n755\t        match parent {\n756\t            Some(p) => {\n757\t                let is_left = p\n758\t                    .borrow()\n759\t                    .left_child_node\n760\t                    .as_ref()\n761\t                    .map_or(false, |l| Rc::ptr_eq(l, &cur));\n762\t                if is_left {\n763\t                    cur = p;\n764\t                } else {\n765\t                    return Some(p);\n766\t                }\n767\t            }\n768\t            None => return None,\n769\t        }\n770\t    }\n771\t}\n772\t/// Return the rank (in-order index) of the given node.\n773\tpub fn bostree_rank(node: &Rc<RefCell<BOSNode>>) -> u32 {\n774\t    let mut counter = node.borrow().left_child_count;\n775\t    let mut cur = node.clone();\n776\t    loop {\n777\t        let parent = cur\n778\t            .borrow()\n779\t            .parent_node\n780\t            .as_ref()\n781\t            .and_then(|w| w.upgrade());\n782\t        match parent {\n783\t            Some(p) => {\n784\t                let is_right = p\n785\t                    .borrow()\n786\t                    .right_child_node\n787\t                    .as_ref()\n788\t                    .map_or(false, |r| Rc::ptr_eq(r, &cur));\n789\t                if is_right {\n790\t                    counter += 1 + p.borrow().left_child_count;\n791\t                }\n792\t                cur = p;\n793\t            }\n794\t            None => break,\n795\t        }\n796\t    }\n797\t    counter\n798\t}\n799\t"}]},"parent_tool_use_id":null,"session_id":"6778e5a7-5e47-49db-a906-3d66df2078b3","uuid":"0cfed4e4-3471-4700-92ec-ad9f031c67b7","timestamp":"2026-05-29T16:59:01.212Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-sZrLJB/project/src/bostree.rs","content":"use std::cell::RefCell;\nuse std::rc::{Rc, Weak};\n\n#[inline]\nfn max(a: u32, b: u32) -> u32 {\n    if a > b { a } else { b }\n}\n\n#[derive(Debug)]\npub struct BOSTree {\n    /// The root node of the tree.\n    pub root_node: Option<Rc<RefCell<BOSNode>>>,\n    /// The key comparison function.\n    pub cmp_function: BOSTreeCmpFunction,\n    /// The optional free function for node data.\n    pub free_function: Option<BOSTreeFreeFunction>,\n}\n/// The node structure.\n#[derive(Debug)]\npub struct BOSNode {\n    /// Number of nodes in the left subtree.\n    pub left_child_count: u32,\n    /// Number of nodes in the right subtree.\n    pub right_child_count: u32,\n    /// Cached depth of the node.\n    pub depth: u32,\n    /// Left child node.\n    pub left_child_node: Option<Rc<RefCell<BOSNode>>>,\n    /// Right child node.\n    pub right_child_node: Option<Rc<RefCell<BOSNode>>>,\n    /// Parent node (using a weak reference to avoid cycles).\n    pub parent_node: Option<Weak<RefCell<BOSNode>>>,\n    /// The key for this node.\n    pub key: String,\n    /// The associated data.\n    pub data: Option<String>,\n    /// Internal weak reference counter.\n    pub weak_ref_count: u8,\n    /// Validity flag for the weak reference.\n    pub weak_ref_node_valid: u8,\n}\n/// Type alias for a key comparison function.\n/// Should return a positive value if `b` is larger than `a`,\n/// a negative value if `a` is larger, and zero if equal.\npub type BOSTreeCmpFunction = fn(&str, &str) -> i32;\n/// Type alias for a free function which will be called on nodes\n/// that are removed.\npub type BOSTreeFreeFunction = fn(&Rc<RefCell<BOSNode>>);\n\n// --- Internal helpers ---\n\nfn get_parent(node: &Rc<RefCell<BOSNode>>) -> Option<Rc<RefCell<BOSNode>>> {\n    node.borrow().parent_node.as_ref().and_then(|w| w.upgrade())\n}\n\nfn balance(node: &Rc<RefCell<BOSNode>>) -> i32 {\n    let n = node.borrow();\n    let left_depth = n\n        .left_child_node\n        .as_ref()\n        .map_or(0i32, |c| c.borrow().depth as i32 + 1);\n    let right_depth = n\n        .right_child_node\n        .as_ref()\n        .map_or(0i32, |c| c.borrow().depth as i32 + 1);\n    right_depth - left_depth\n}\n\nfn update_depth(node: &Rc<RefCell<BOSNode>>) {\n    let new_depth = {\n        let n = node.borrow();\n        let left = n\n            .left_child_node\n            .as_ref()\n            .map_or(0u32, |c| c.borrow().depth + 1);\n        let right = n\n            .right_child_node\n            .as_ref()\n            .map_or(0u32, |c| c.borrow().depth + 1);\n        max(left, right)\n    };\n    node.borrow_mut().depth = new_depth;\n}\n\n/// Rotate right around P. Returns the new top of the rotated subtree (formerly L).\nfn rotate_right(\n    root: &mut Option<Rc<RefCell<BOSNode>>>,\n    p: &Rc<RefCell<BOSNode>>,\n) -> Rc<RefCell<BOSNode>> {\n    let l = p\n        .borrow()\n        .left_child_node\n        .clone()\n        .expect(\"rotate_right requires P to have a left child\");\n    let p_parent = get_parent(p);\n\n    // Replace P with L in P's parent (or in root if P was root).\n    match &p_parent {\n        Some(pp) => {\n            let p_is_left = pp\n                .borrow()\n                .left_child_node\n                .as_ref()\n                .map_or(false, |c| Rc::ptr_eq(c, p));\n            if p_is_left {\n                pp.borrow_mut().left_child_node = Some(l.clone());\n            } else {\n                pp.borrow_mut().right_child_node = Some(l.clone());\n            }\n        }\n        None => {\n            *root = Some(l.clone());\n        }\n    }\n\n    // L's parent <- P's old parent\n    l.borrow_mut().parent_node = p_parent.as_ref().map(|pp| Rc::downgrade(pp));\n\n    // P->left = L->right (with count)\n    let l_right = l.borrow().right_child_node.clone();\n    let l_right_count = l.borrow().right_child_count;\n    p.borrow_mut().left_child_node = l_right.clone();\n    p.borrow_mut().left_child_count = l_right_count;\n\n    if let Some(ref lr) = l_right {\n        lr.borrow_mut().parent_node = Some(Rc::downgrade(p));\n    }\n\n    update_depth(p);\n\n    // L->right = P; P->parent = L\n    p.borrow_mut().parent_node = Some(Rc::downgrade(&l));\n    l.borrow_mut().right_child_node = Some(p.clone());\n\n    let pl = p.borrow().left_child_count;\n    let pr = p.borrow().right_child_count;\n    l.borrow_mut().right_child_count = pl + pr + 1;\n\n    update_depth(&l);\n\n    l\n}\n\n/// Rotate left around P. Returns the new top of the rotated subtree (formerly R).\nfn rotate_left(\n    root: &mut Option<Rc<RefCell<BOSNode>>>,\n    p: &Rc<RefCell<BOSNode>>,\n) -> Rc<RefCell<BOSNode>> {\n    let r = p\n        .borrow()\n        .right_child_node\n        .clone()\n        .expect(\"rotate_left requires P to have a right child\");\n    let p_parent = get_parent(p);\n\n    match &p_parent {\n        Some(pp) => {\n            let p_is_left = pp\n                .borrow()\n                .left_child_node\n                .as_ref()\n                .map_or(false, |c| Rc::ptr_eq(c, p));\n            if p_is_left {\n                pp.borrow_mut().left_child_node = Some(r.clone());\n            } else {\n                pp.borrow_mut().right_child_node = Some(r.clone());\n            }\n        }\n        None => {\n            *root = Some(r.clone());\n        }\n    }\n\n    r.borrow_mut().parent_node = p_parent.as_ref().map(|pp| Rc::downgrade(pp));\n\n    let r_left = r.borrow().left_child_node.clone();\n    let r_left_count = r.borrow().left_child_count;\n    p.borrow_mut().right_child_node = r_left.clone();\n    p.borrow_mut().right_child_count = r_left_count;\n\n    if let Some(ref rl) = r_left {\n        rl.borrow_mut().parent_node = Some(Rc::downgrade(p));\n    }\n\n    update_depth(p);\n\n    p.borrow_mut().parent_node = Some(Rc::downgrade(&r));\n    r.borrow_mut().left_child_node = Some(p.clone());\n\n    let pl = p.borrow().left_child_count;\n    let pr = p.borrow().right_child_count;\n    r.borrow_mut().left_child_count = pl + pr + 1;\n\n    update_depth(&r);\n\n    r\n}\n\nimpl BOSTree {\n    /// Create a new tree with a mandatory comparison function and an optional free function.\n    pub fn bostree_new(\n        cmp_function: BOSTreeCmpFunction,\n        free_function: Option<BOSTreeFreeFunction>,\n    ) -> Self {\n        BOSTree {\n            root_node: None,\n            cmp_function,\n            free_function,\n        }\n    }\n    /// Return the number of nodes in the tree.\n    pub fn bostree_node_count(&self) -> u32 {\n        match &self.root_node {\n            Some(n) => {\n                let nb = n.borrow();\n                nb.left_child_count + nb.right_child_count + 1\n            }\n            None => 0,\n        }\n    }\n    /// Insert a new member into the tree and return the associated node.\n    pub fn bostree_insert(&mut self, key: String, data: Option<String>) -> Rc<RefCell<BOSNode>> {\n        // Find tree position to insert new node.\n        let mut current = self.root_node.clone();\n        let mut parent_node: Option<Rc<RefCell<BOSNode>>> = None;\n        let mut go_left = false;\n\n        while let Some(n) = current {\n            parent_node = Some(n.clone());\n            let cmp = (self.cmp_function)(&key, &n.borrow().key);\n            if cmp < 0 {\n                n.borrow_mut().left_child_count += 1;\n                current = n.borrow().left_child_node.clone();\n                go_left = true;\n            } else {\n                n.borrow_mut().right_child_count += 1;\n                current = n.borrow().right_child_node.clone();\n                go_left = false;\n            }\n        }\n\n        let new_node = Rc::new(RefCell::new(BOSNode {\n            left_child_count: 0,\n            right_child_count: 0,\n            depth: 0,\n            left_child_node: None,\n            right_child_node: None,\n            parent_node: parent_node.as_ref().map(|p| Rc::downgrade(p)),\n            key,\n            data,\n            weak_ref_count: 1,\n            weak_ref_node_valid: 1,\n        }));\n\n        // No parent means this is the first node.\n        let parent = match parent_node {\n            None => {\n                self.root_node = Some(new_node.clone());\n                return new_node;\n            }\n            Some(p) => p,\n        };\n\n        if go_left {\n            parent.borrow_mut().left_child_node = Some(new_node.clone());\n        } else {\n            parent.borrow_mut().right_child_node = Some(new_node.clone());\n        }\n\n        // Check if the depth changed: only if the parent had no other child before.\n        let parent_has_one_child = {\n            let p = parent.borrow();\n            p.left_child_node.is_some() ^ p.right_child_node.is_some()\n        };\n\n        if parent_has_one_child {\n            parent.borrow_mut().depth += 1;\n            let mut p_node = parent;\n            while let Some(p_parent) = get_parent(&p_node) {\n                p_node = p_parent;\n\n                let new_left_depth = p_node\n                    .borrow()\n                    .left_child_node\n                    .as_ref()\n                    .map_or(0u32, |n| n.borrow().depth + 1);\n                let new_right_depth = p_node\n                    .borrow()\n                    .right_child_node\n                    .as_ref()\n                    .map_or(0u32, |n| n.borrow().depth + 1);\n                let max_depth = max(new_left_depth, new_right_depth);\n\n                let cur_depth = p_node.borrow().depth;\n                if cur_depth != max_depth {\n                    p_node.borrow_mut().depth = max_depth;\n                } else {\n                    // Depth unchanged here, propagation can stop.\n                    break;\n                }\n\n                let nld = new_left_depth as i64;\n                let nrd = new_right_depth as i64;\n                if nld - 2 == nrd {\n                    // Left-right case\n                    let left_child = p_node.borrow().left_child_node.clone().unwrap();\n                    if balance(&left_child) > 0 {\n                        rotate_left(&mut self.root_node, &left_child);\n                    }\n                    p_node = rotate_right(&mut self.root_node, &p_node);\n                } else if nld + 2 == nrd {\n                    // Right-left case\n                    let right_child = p_node.borrow().right_child_node.clone().unwrap();\n                    if balance(&right_child) < 0 {\n                        rotate_right(&mut self.root_node, &right_child);\n                    }\n                    p_node = rotate_left(&mut self.root_node, &p_node);\n                }\n            }\n        }\n\n        new_node\n    }\n    /// Remove a given node from the tree.\n    pub fn bostree_remove(&mut self, node: &Rc<RefCell<BOSNode>>) {\n        let bubble_up: Option<Rc<RefCell<BOSNode>>>;\n\n        let has_left = node.borrow().left_child_node.is_some();\n        let has_right = node.borrow().right_child_node.is_some();\n\n        if has_left && has_right {\n            // Two-children case.\n            let (candidate, lost_child) = {\n                let left_depth = node\n                    .borrow()\n                    .left_child_node\n                    .as_ref()\n                    .unwrap()\n                    .borrow()\n                    .depth;\n                let right_depth = node\n                    .borrow()\n                    .right_child_node\n                    .as_ref()\n                    .unwrap()\n                    .borrow()\n                    .depth;\n                let go_left = left_depth >= right_depth;\n\n                if go_left {\n                    node.borrow_mut().left_child_count -= 1;\n                    let mut cand = node.borrow().left_child_node.clone().unwrap();\n                    while cand.borrow().right_child_node.is_some() {\n                        cand.borrow_mut().right_child_count -= 1;\n                        let next = cand.borrow().right_child_node.clone().unwrap();\n                        cand = next;\n                    }\n                    let lc = cand.borrow().left_child_node.clone();\n                    (cand, lc)\n                } else {\n                    node.borrow_mut().right_child_count -= 1;\n                    let mut cand = node.borrow().right_child_node.clone().unwrap();\n                    while cand.borrow().left_child_node.is_some() {\n                        cand.borrow_mut().left_child_count -= 1;\n                        let next = cand.borrow().left_child_node.clone().unwrap();\n                        cand = next;\n                    }\n                    let lc = cand.borrow().right_child_node.clone();\n                    (cand, lc)\n                }\n            };\n\n            let bubble_start = get_parent(&candidate).expect(\"candidate must have a parent\");\n\n            // Splice out candidate, replacing it with lost_child in bubble_start.\n            let candidate_is_left = bubble_start\n                .borrow()\n                .left_child_node\n                .as_ref()\n                .map_or(false, |c| Rc::ptr_eq(c, &candidate));\n            if candidate_is_left {\n                bubble_start.borrow_mut().left_child_node = lost_child.clone();\n            } else {\n                bubble_start.borrow_mut().right_child_node = lost_child.clone();\n            }\n            if let Some(ref lc) = lost_child {\n                lc.borrow_mut().parent_node = Some(Rc::downgrade(&bubble_start));\n            }\n\n            // Anchor candidate where node was.\n            let node_parent = get_parent(node);\n            match &node_parent {\n                Some(np) => {\n                    let node_is_left = np\n                        .borrow()\n                        .left_child_node\n                        .as_ref()\n                        .map_or(false, |c| Rc::ptr_eq(c, node));\n                    if node_is_left {\n                        np.borrow_mut().left_child_node = Some(candidate.clone());\n                    } else {\n                        np.borrow_mut().right_child_node = Some(candidate.clone());\n                    }\n                }\n                None => {\n                    self.root_node = Some(candidate.clone());\n                }\n            }\n            candidate.borrow_mut().parent_node =\n                node_parent.as_ref().map(|p| Rc::downgrade(p));\n\n            // Move node's children to candidate. Note: read AFTER splice so that\n            // if candidate was directly under node, the changed node->[lr]_child_node\n            // is observed.\n            let node_left = node.borrow().left_child_node.clone();\n            let node_right = node.borrow().right_child_node.clone();\n            let node_left_count = node.borrow().left_child_count;\n            let node_right_count = node.borrow().right_child_count;\n\n            candidate.borrow_mut().left_child_node = node_left.clone();\n            candidate.borrow_mut().left_child_count = node_left_count;\n            candidate.borrow_mut().right_child_node = node_right.clone();\n            candidate.borrow_mut().right_child_count = node_right_count;\n\n            if let Some(ref lc) = node_left {\n                lc.borrow_mut().parent_node = Some(Rc::downgrade(&candidate));\n            }\n            if let Some(ref rc) = node_right {\n                rc.borrow_mut().parent_node = Some(Rc::downgrade(&candidate));\n            }\n\n            // Rebalance up to candidate.\n            if !Rc::ptr_eq(&bubble_start, node) {\n                let mut bs = bubble_start.clone();\n                while !Rc::ptr_eq(&bs, &candidate) {\n                    update_depth(&bs);\n                    let bal = balance(&bs);\n                    if bal > 1 {\n                        let right_child = bs.borrow().right_child_node.clone().unwrap();\n                        if balance(&right_child) < 0 {\n                            rotate_right(&mut self.root_node, &right_child);\n                        }\n                        bs = rotate_left(&mut self.root_node, &bs);\n                    } else if bal < -1 {\n                        let left_child = bs.borrow().left_child_node.clone().unwrap();\n                        if balance(&left_child) > 0 {\n                            rotate_left(&mut self.root_node, &left_child);\n                        }\n                        bs = rotate_right(&mut self.root_node, &bs);\n                    }\n                    let parent = get_parent(&bs).expect(\"walk should reach candidate\");\n                    bs = parent;\n                }\n            }\n\n            update_depth(&candidate);\n\n            bubble_up = get_parent(&candidate);\n\n            if let Some(ref bu) = bubble_up {\n                let candidate_is_left_of_bu = bu\n                    .borrow()\n                    .left_child_node\n                    .as_ref()\n                    .map_or(false, |c| Rc::ptr_eq(c, &candidate));\n                if candidate_is_left_of_bu {\n                    bu.borrow_mut().left_child_count -= 1;\n                } else {\n                    bu.borrow_mut().right_child_count -= 1;\n                }\n            }\n        } else {\n            // Zero or one child case.\n            let node_parent = get_parent(node);\n            match &node_parent {\n                None => {\n                    let new_root = if has_left {\n                        node.borrow().left_child_node.clone()\n                    } else {\n                        node.borrow().right_child_node.clone()\n                    };\n                    if let Some(ref nr) = new_root {\n                        nr.borrow_mut().parent_node = None;\n                    }\n                    self.root_node = new_root;\n                    bubble_up = None;\n                }\n                Some(np) => {\n                    let (candidate, candidate_count) =\n                        if let Some(rc) = node.borrow().right_child_node.clone() {\n                            let cc = node.borrow().right_child_count;\n                            (Some(rc), cc)\n                        } else {\n                            let cc = node.borrow().left_child_count;\n                            (node.borrow().left_child_node.clone(), cc)\n                        };\n\n                    let node_is_left = np\n                        .borrow()\n                        .left_child_node\n                        .as_ref()\n                        .map_or(false, |c| Rc::ptr_eq(c, node));\n                    if node_is_left {\n                        np.borrow_mut().left_child_node = candidate.clone();\n                        np.borrow_mut().left_child_count = candidate_count;\n                    } else {\n                        np.borrow_mut().right_child_node = candidate.clone();\n                        np.borrow_mut().right_child_count = candidate_count;\n                    }\n\n                    if let Some(ref c) = candidate {\n                        c.borrow_mut().parent_node = Some(Rc::downgrade(np));\n                    }\n\n                    bubble_up = Some(np.clone());\n                }\n            }\n        }\n\n        // Bubble up rebalancing.\n        let mut bubbling_finished = false;\n        let mut bu = bubble_up;\n        while let Some(node_bu) = bu {\n            let post_node = if !bubbling_finished {\n                let left_depth = node_bu\n                    .borrow()\n                    .left_child_node\n                    .as_ref()\n                    .map_or(0u32, |n| n.borrow().depth + 1);\n                let right_depth = node_bu\n                    .borrow()\n                    .right_child_node\n                    .as_ref()\n                    .map_or(0u32, |n| n.borrow().depth + 1);\n                let new_depth = max(left_depth, right_depth);\n                let cur_depth = node_bu.borrow().depth;\n                let depth_changed = new_depth != cur_depth;\n                node_bu.borrow_mut().depth = new_depth;\n\n                let bal = balance(&node_bu);\n                if bal < -1 {\n                    let left_child = node_bu.borrow().left_child_node.clone().unwrap();\n                    if balance(&left_child) > 0 {\n                        rotate_left(&mut self.root_node, &left_child);\n                    }\n                    rotate_right(&mut self.root_node, &node_bu)\n                } else if bal > 1 {\n                    let right_child = node_bu.borrow().right_child_node.clone().unwrap();\n                    if balance(&right_child) < 0 {\n                        rotate_right(&mut self.root_node, &right_child);\n                    }\n                    rotate_left(&mut self.root_node, &node_bu)\n                } else {\n                    if !depth_changed {\n                        bubbling_finished = true;\n                    }\n                    node_bu.clone()\n                }\n            } else {\n                node_bu.clone()\n            };\n\n            // Decrement parent's child count for the side that contains post_node.\n            let parent = get_parent(&post_node);\n            if let Some(ref p) = parent {\n                let post_is_left = p\n                    .borrow()\n                    .left_child_node\n                    .as_ref()\n                    .map_or(false, |c| Rc::ptr_eq(c, &post_node));\n                if post_is_left {\n                    p.borrow_mut().left_child_count -= 1;\n                } else {\n                    p.borrow_mut().right_child_count -= 1;\n                }\n            }\n            bu = parent;\n        }\n\n        node.borrow_mut().weak_ref_node_valid = 0;\n        self.bostree_node_weak_unref(node);\n    }\n    /// Decrease the weak reference count for a node; if that was the last reference,\n    /// free the node and return None; otherwise return the node.\n    pub fn bostree_node_weak_unref(\n        &mut self,\n        node: &Rc<RefCell<BOSNode>>,\n    ) -> Option<Rc<RefCell<BOSNode>>> {\n        let (count, valid) = {\n            let mut n = node.borrow_mut();\n            n.weak_ref_count = n.weak_ref_count.saturating_sub(1);\n            (n.weak_ref_count, n.weak_ref_node_valid)\n        };\n\n        if count == 0 {\n            if let Some(free_fn) = self.free_function {\n                free_fn(node);\n            }\n            None\n        } else if valid != 0 {\n            Some(node.clone())\n        } else {\n            None\n        }\n    }\n    /// Lookup a node in the tree by its key.\n    pub fn bostree_lookup(&self, key: &str) -> Option<Rc<RefCell<BOSNode>>> {\n        let mut current = self.root_node.clone();\n        while let Some(n) = current {\n            let cmp = (self.cmp_function)(key, &n.borrow().key);\n            if cmp == 0 {\n                return Some(n);\n            } else if cmp < 0 {\n                let next = n.borrow().left_child_node.clone();\n                current = next;\n            } else {\n                let next = n.borrow().right_child_node.clone();\n                current = next;\n            }\n        }\n        None\n    }\n    /// Return the node at the given in-order index (starting at 0).\n    pub fn bostree_select(&self, mut index: u32) -> Option<Rc<RefCell<BOSNode>>> {\n        let mut current = self.root_node.clone();\n        while let Some(n) = current {\n            let lcc = n.borrow().left_child_count;\n            if lcc <= index {\n                index -= lcc;\n                if index == 0 {\n                    return Some(n);\n                }\n                index -= 1;\n                let next = n.borrow().right_child_node.clone();\n                current = next;\n            } else {\n                let next = n.borrow().left_child_node.clone();\n                current = next;\n            }\n        }\n        None\n    }\n    /// Print the tree (only available in debug builds).\n    #[cfg(debug_assertions)]\n    pub fn bostree_print(&self) {\n        if let Some(root) = &self.root_node {\n            println!(\"digraph {{\\n  ordering = out;\");\n            print_helper(root);\n            println!(\"}}\");\n        }\n    }\n}\n\n#[cfg(debug_assertions)]\nfn print_helper(node: &Rc<RefCell<BOSNode>>) {\n    let (key_clone, lcc, rcc, dep, parent_key, lc, rc) = {\n        let nb = node.borrow();\n        (\n            nb.key.clone(),\n            nb.left_child_count,\n            nb.right_child_count,\n            nb.depth,\n            nb.parent_node\n                .as_ref()\n                .and_then(|w| w.upgrade())\n                .map(|p| p.borrow().key.clone()),\n            nb.left_child_node.clone(),\n            nb.right_child_node.clone(),\n        )\n    };\n    println!(\n        \"  {} [label=\\\"\\\\N ({},{},{})\\\"];\",\n        key_clone, lcc, rcc, dep\n    );\n    if let Some(pk) = parent_key {\n        println!(\"  {} -> {} [color=green];\", key_clone, pk);\n    }\n    if let Some(l) = lc {\n        println!(\"  {} -> {}\", key_clone, l.borrow().key);\n        print_helper(&l);\n    }\n    if let Some(r) = rc {\n        println!(\"  {} -> {}\", key_clone, r.borrow().key);\n        print_helper(&r);\n    }\n}\n\n/// Increase the weak reference count for a node and return the node.\npub fn bostree_node_weak_ref(node: &Rc<RefCell<BOSNode>>) -> Rc<RefCell<BOSNode>> {\n    {\n        let mut n = node.borrow_mut();\n        assert!(n.weak_ref_count < 127);\n        assert!(n.weak_ref_count > 0);\n        n.weak_ref_count += 1;\n    }\n    node.clone()\n}\n/// Return the next node in an in-order traversal.\npub fn bostree_next_node(node: &Rc<RefCell<BOSNode>>) -> Option<Rc<RefCell<BOSNode>>> {\n    let right = node.borrow().right_child_node.clone();\n    if let Some(r) = right {\n        let mut cur = r;\n        loop {\n            let next = cur.borrow().left_child_node.clone();\n            match next {\n                Some(n) => cur = n,\n                None => return Some(cur),\n            }\n        }\n    }\n    let mut cur = node.clone();\n    loop {\n        let parent = cur\n            .borrow()\n            .parent_node\n            .as_ref()\n            .and_then(|w| w.upgrade());\n        match parent {\n            Some(p) => {\n                let is_right = p\n                    .borrow()\n                    .right_child_node\n                    .as_ref()\n                    .map_or(false, |r| Rc::ptr_eq(r, &cur));\n                if is_right {\n                    cur = p;\n                } else {\n                    return Some(p);\n                }\n            }\n            None => return None,\n        }\n    }\n}\n/// Return the previous node in an in-order traversal.\npub fn bostree_previous_node(node: &Rc<RefCell<BOSNode>>) -> Option<Rc<RefCell<BOSNode>>> {\n    let left = node.borrow().left_child_node.clone();\n    if let Some(l) = left {\n        let mut cur = l;\n        loop {\n            let next = cur.borrow().right_child_node.clone();\n            match next {\n                Some(n) => cur = n,\n                None => return Some(cur),\n            }\n        }\n    }\n    let mut cur = node.clone();\n    loop {\n        let parent = cur\n            .borrow()\n            .parent_node\n            .as_ref()\n            .and_then(|w| w.upgrade());\n        match parent {\n            Some(p) => {\n                let is_left = p\n                    .borrow()\n                    .left_child_node\n                    .as_ref()\n                    .map_or(false, |l| Rc::ptr_eq(l, &cur));\n                if is_left {\n                    cur = p;\n                } else {\n                    return Some(p);\n                }\n            }\n            None => return None,\n        }\n    }\n}\n/// Return the rank (in-order index) of the given node.\npub fn bostree_rank(node: &Rc<RefCell<BOSNode>>) -> u32 {\n    let mut counter = node.borrow().left_child_count;\n    let mut cur = node.clone();\n    loop {\n        let parent = cur\n            .borrow()\n            .parent_node\n            .as_ref()\n            .and_then(|w| w.upgrade());\n        match parent {\n            Some(p) => {\n                let is_right = p\n                    .borrow()\n                    .right_child_node\n                    .as_ref()\n                    .map_or(false, |r| Rc::ptr_eq(r, &cur));\n                if is_right {\n                    counter += 1 + p.borrow().left_child_count;\n                }\n                cur = p;\n            }\n            None => break,\n        }\n    }\n    counter\n}\n","numLines":799,"startLine":1,"totalLines":799}}}
