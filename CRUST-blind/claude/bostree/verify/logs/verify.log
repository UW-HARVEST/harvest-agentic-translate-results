 {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"1\"), NULL);\n        bostree_insert(t, strdup(\"2\"), NULL);\n        bostree_insert(t, strdup(\"3\"), NULL);\n        print_inorder(t, \"1-2-3\");\n    }\n\n    // Scenario 7: insert that triggers left rotation (3,2,1)\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"3\"), NULL);\n        bostree_insert(t, strdup(\"2\"), NULL);\n        bostree_insert(t, strdup(\"1\"), NULL);\n        print_inorder(t, \"3-2-1\");\n    }\n\n    // Scenario 8: left-right case (3, 1, 2)\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"3\"), NULL);\n        bostree_insert(t, strdup(\"1\"), NULL);\n        bostree_insert(t, strdup(\"2\"), NULL);\n        print_inorder(t, \"3-1-2\");\n    }\n\n    // Scenario 9: right-left case (1,3,2)\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"1\"), NULL);\n        bostree_insert(t, strdup(\"3\"), NULL);\n        bostree_insert(t, strdup(\"2\"), NULL);\n        print_inorder(t, \"1-3-2\");\n    }\n\n    // Scenario 10: remove root with both children\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"B\"), NULL);\n        bostree_insert(t, strdup(\"A\"), NULL);\n        bostree_insert(t, strdup(\"C\"), NULL);\n        BOSNode *n = bostree_lookup(t, \"B\");\n        bostree_remove(t, n);\n        print_inorder(t, \"after remove root B\");\n    }\n\n    // Scenario 11: remove leaf\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"B\"), NULL);\n        bostree_insert(t, strdup(\"A\"), NULL);\n        bostree_insert(t, strdup(\"C\"), NULL);\n        BOSNode *n = bostree_lookup(t, \"C\");\n        bostree_remove(t, n);\n        print_inorder(t, \"after remove leaf C\");\n    }\n\n    // Scenario 12: remove root with only one child\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"B\"), NULL);\n        bostree_insert(t, strdup(\"A\"), NULL);\n        BOSNode *n = bostree_lookup(t, \"B\");\n        bostree_remove(t, n);\n        print_inorder(t, \"after remove root with one child\");\n    }\n\n    // Scenario 13: bug situation (a-y inserted)\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        for (char c = 'A'; c < 'Z'; c++) {\n            char *k = malloc(2); k[0]=c; k[1]=0;\n            bostree_insert(t, k, NULL);\n        }\n        bostree_remove(t, bostree_lookup(t, \"G\"));\n        bostree_remove(t, bostree_lookup(t, \"H\"));\n        print_inorder(t, \"A-Y minus G and H\");\n    }\n\n    // Scenario 14: insert then remove single node\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"only\"), NULL);\n        BOSNode *n = bostree_lookup(t, \"only\");\n        bostree_remove(t, n);\n        print_inorder(t, \"after removing only node\");\n    }\n\n    // Scenario 15: Test next/previous boundaries on a 5-node tree\n    {\n        BOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n        bostree_insert(t, strdup(\"c\"), NULL);\n        bostree_insert(t, strdup(\"a\"), NULL);\n        bostree_insert(t, strdup(\"b\"), NULL);\n        bostree_insert(t, strdup(\"d\"), NULL);\n        bostree_insert(t, strdup(\"e\"), NULL);\n        print_inorder(t, \"5 nodes c-a-b-d-e\");\n        BOSNode *first = bostree_select(t, 0);\n        BOSNode *last = bostree_select(t, 4);\n        printf(\"prev(first)=%s\\n\", bostree_previous_node(first) ? (char*)bostree_previous_node(first)->key : \"(null)\");\n        printf(\"next(last)=%s\\n\", bostree_next_node(last) ? (char*)bostree_next_node(last)->key : \"(null)\");\n    }\n\n    return 0;\n}\n","structuredPatch":[{"oldStart":23,"oldLines":8,"newStart":23,"newLines":13,"lines":["         printf(\" rc=%s\", node->right_child_node ? (char*)node->right_child_node->key : \"(null)\");","         printf(\"\\n\");","     }","-    if (t->root_node) {","-        printf(\"  root=%s\\n\", (char*)t->root_node->key);","+    BOSNode *root = bostree_select(t, n / 2);  // not real root, skip","+    (void)root;","+    if (n > 0) {","+        // Find root by walking up from any node","+        BOSNode *node = bostree_select(t, 0);","+        while (node->parent_node) node = node->parent_node;","+        printf(\"  root=%s\\n\", (char*)node->key);","     }"," }"," "]}],"userModified":false,"replaceAll":false}}
