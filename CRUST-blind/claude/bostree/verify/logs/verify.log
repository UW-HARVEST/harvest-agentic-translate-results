rs ---\n51\t\n52\tfn get_parent(node: &Rc<RefCell<BOSNode>>) -> Option<Rc<RefCell<BOSNode>>> {\n53\t    node.borrow().parent_node.as_ref().and_then(|w| w.upgrade())\n54\t}\n55\t\n56\tfn balance(node: &Rc<RefCell<BOSNode>>) -> i32 {\n57\t    let n = node.borrow();\n58\t    let left_depth = n\n59\t        .left_child_node\n60\t        .as_ref()\n61\t        .map_or(0i32, |c| c.borrow().depth as i32 + 1);\n62\t    let right_depth = n\n63\t        .right_child_node\n64\t        .as_ref()\n65\t        .map_or(0i32, |c| c.borrow().depth as i32 + 1);\n66\t    right_depth - left_depth\n67\t}\n68\t\n69\tfn update_depth(node: &Rc<RefCell<BOSNode>>) {\n70\t    let new_depth = {\n71\t        let n = node.borrow();\n72\t        let left = n\n73\t            .left_child_node\n74\t            .as_ref()\n75\t            .map_or(0u32, |c| c.borrow().depth + 1);\n76\t        let right = n\n77\t            .right_child_node\n78\t            .as_ref()\n79\t            .map_or(0u32, |c| c.borrow().depth + 1);\n80\t        max(left, right)\n81\t    };\n82\t    node.borrow_mut().depth = new_depth;\n83\t}\n84\t\n85\t/// Rotate right around P. Returns the new top of the rotated subtree (formerly L).\n86\tfn rotate_right(\n87\t    root: &mut Option<Rc<RefCell<BOSNode>>>,\n88\t    p: &Rc<RefCell<BOSNode>>,\n89\t) -> Rc<RefCell<BOSNode>> {\n90\t    let l = p\n91\t        .borrow()\n92\t        .left_child_node\n93\t        .clone()\n94\t        .expect(\"rotate_right requires P to have a left child\");\n95\t    let p_parent = get_parent(p);\n96\t\n97\t    // Replace P with L in P's parent (or in root if P was root).\n98\t    match &p_parent {\n99\t        Some(pp) => {\n100\t            let p_is_left = pp\n101\t                .borrow()\n102\t                .left_child_node\n103\t                .as_ref()\n104\t                .map_or(false, |c| Rc::ptr_eq(c, p));\n105\t            if p_is_left {\n106\t                pp.borrow_mut().left_child_node = Some(l.clone());\n107\t            } else