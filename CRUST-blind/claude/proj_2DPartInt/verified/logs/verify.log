>\n#include <stddef.h>\n#include \"data.h\"\n#include \"functions.h\"\n#include \"collisions.h\"\n\nextern int find_col(const double x, const int x_squares, const double square_length);\nextern int find_row(const double y, const int y_squares, const double square_length);\nextern int find_square(const double x, const double y, const int x_squares, const int y_squares, const double square_length);\n\nint main(void) {\n    // Test compute_distance\n    Particle p1 = {0, 0, 1.0, NULL, 0};\n    Particle p2 = {3, 4, 1.0, NULL, 1};\n    printf(\"compute_distance((0,0),(3,4)) = %.15f\\n\", compute_distance(&p1, &p2));\n\n    Particle p3 = {1.5, 2.5, 1.0, NULL, 0};\n    Particle p4 = {-3.5, 7.0, 1.0, NULL, 1};\n    printf(\"compute_distance((1.5,2.5),(-3.5,7.0)) = %.15f\\n\", compute_distance(&p3, &p4));\n\n    Particle p5 = {5, 5, 1.0, NULL, 0};\n    Particle p6 = {5, 5, 1.0, NULL, 1};\n    printf(\"compute_distance(same) = %.15f\\n\", compute_distance(&p5, &p6));\n\n    // Test compute_overlap\n    Particle q1 = {0, 0, 50, NULL, 0};\n    Particle q2 = {10, 0, 50, NULL, 1};\n    printf(\"compute_overlap_overlapping = %.15f\\n\", compute_overlap(&q1, &q2));\n\n    Particle q3 = {0, 0, 50, NULL, 0};\n    Particle q4 = {200, 0, 50, NULL, 1};\n    printf(\"compute_overlap_far = %.15f\\n\", compute_overlap(&q3, &q4));\n\n    Particle q5 = {0, 0, 50, NULL, 0};\n    Particle q6 = {100, 0, 50, NULL, 1};\n    printf(\"compute_overlap_touching = %.15f\\n\", compute_overlap(&q5, &q6));\n\n    // size_triangular_matrix not implemented in C source; skip.\n\n    // Test apply_gravity\n    {\n        size_t n = 3;\n        ParticleProperties props[3] = {{1.0, 0, 0}, {2.0, 0, 0}, {0.5, 0, 0}};\n        Vector forces[3] = {{1.0, 1.0}, {2.0, 2.0}, {3.0, 3.0}};\n        apply_gravity(n, props, forces);\n        for (size_t i = 0; i < n; ++i) {\n            printf(\"apply_gravity[%zu] = (%.15f, %.15f)\\n\", i, forces[i].x_component, forces[i].y_component);\n        }\n    }\n\n    // Test fix