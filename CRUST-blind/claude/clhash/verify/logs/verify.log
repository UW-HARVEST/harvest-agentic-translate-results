 clmul_pi64_si128(add1, add1, 0x01)\n392\t}\n393\t\n394\t// Build the final partial word by zero-padding the last `lengthbyte % 8` bytes.\n395\tfn create_last_word(lengthbyte: usize, lastw: &[u8]) -> u64 {\n396\t    let significantbytes = lengthbyte % 8;\n397\t    let mut bytes = [0u8; 8];\n398\t    bytes[..significantbytes].copy_from_slice(&lastw[..significantbytes]);\n399\t    u64::from_le_bytes(bytes)\n400\t}\n401\t\n402\t// ---------- public API ----------\n403\t\n404\tpub fn clhash(random: &[u8], stringbyte: &[u8]) -> u64 {\n405\t    const M_WORDS: usize = 128; // we process the data in chunks of 128 64-bit words\n406\t    const M128_NEEDED_PER_BLOCK: usize = M_WORDS / 2; // = 64\n407\t\n408\t    let poly_offset = M128_NEEDED_PER_BLOCK * 16; // 1024\n409\t    let mut polyvalue = m128_load(&random[poly_offset..poly_offset + 16]);\n410\t    // _mm_and_si128 with [0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0x3FFFFFFF] (epi32)\n411\t    // -> low = 0xFFFF_FFFF_FFFF_FFFF, high = 0x3FFF_FFFF_FFFF_FFFF\n412\t    polyvalue.hi &= 0x3FFF_FFFF_FFFF_FFFFu64;\n413\t\n414\t    let lengthbyte = stringbyte.len();\n415\t    let length = lengthbyte / 8; // # of complete 64-bit words\n416\t    let lengthinc = (lengthbyte + 7) / 8; // # of words including a partial one\n417\t\n418\t    let keylength_offset = (M128_NEEDED_PER_BLOCK + 2) * 16; // 1056\n419\t    let keylength = read_u64_le(&random[keylength_offset..keylength_offset + 8]);\n420\t\n421\t    if M_WORDS < lengthinc {\n422\t        // ---- long string path ----\n423\t        let mut acc =\n424\t            clmul_half_scalar_product_without_reduction(random, stringbyte, 0, M_WORDS);\n425\t        let mut t: usize = M_WORDS;\n426\t        while t + M_WORDS <= length {\n427\t            acc = mul128by128to128_lazymod127(polyvalue, acc);\n428\t            let h1 = clmul_half_scalar_product_without_reduction(\n429\t                random,\n430\t                stringbyte,\n431\t                t * 8,\n432\t                M_WORDS,\n433\t            );\n434\t            acc = acc.xor(h1);\n435\t            t += M_WORDS;\n436\t        }\n437\t        let remain = length - t;\n438\t\n439\t        if remain != 0 {\n440\t            acc = mul128by128to128_lazymod127(polyvalue, acc);\n441\t            if lengthbyte % 8 == 0 {\n442\t                let h1 = clmul_half_scalar_product_with_tail(\n443\t                    random,\n444\t                    stringbyte,\n445\t                    t * 8,\n446\t                    remain,\n447\t                );\n448\t                acc = acc.xor(h1);\n449\t            } else {\n450\t                let lastword = create_last_word(lengthbyte, &stringbyte[length * 8..]);\n451\t                let h1 = clmul_half_scalar_product_with_tail_extra(\n452\t                    random,\n453\t                    stringbyte,\n454\t                    t * 8,\n455\t                    remain,\n456\t                    lastword,\n457\t                );\n458\t                acc = acc.xor(h1);\n459\t            }\n460\t        } else if lengthbyte % 8 != 0 {\n461\t            // No completely filled words remaining, but a partial one exists.\n462\t            acc = mul128by128to128_lazymod127(polyvalue, acc);\n463\t            let lastword = create_last_word(lengthbyte, &stringbyte[length * 8..]);\n464\t            let h1 = clmul_only_extra(random, 0, lastword);\n465\t            acc = acc.xor(h1);\n466\t        }\n467\t\n468\t        let finalkey_offset = (M128_NEEDED_PER_BLOCK + 1) * 16; // 1040\n469\t        let finalkey = m128_load(&random[finalkey_offset..finalkey_offset + 16]);\n470\t        simple128to64hashwithlength(acc, finalkey, keylength, lengthbyte as u64)\n471\t    } else {\n472\t        // ---- short string path ----\n473\t        let mut acc = if lengthbyte % 8 == 0 {\n474\t            clmul_half_scalar_product_with_tail(random, stringbyte, 0, length)\n475\t        } else {\n476\t            let lastword = create_last_word(lengthbyte, &stringbyte[length * 8