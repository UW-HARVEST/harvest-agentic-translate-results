12 = _mm_clmulepi64_si128(add12, add12, 0x10);\n162\t        acc = _mm_xor_si128(clprod12, acc);\n163\t    }\n164\t    if (string + 1 < endstring) {\n165\t        if(CLHASH_DEBUG) assert(length != 128);\n166\t        const __m128i temp1 = _mm_load_si128(randomsource);\n167\t        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n168\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n169\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n170\t        acc = _mm_xor_si128(clprod1, acc);\n171\t        randomsource += 1;\n172\t        string += 2;\n173\t    }\n174\t    if (string < endstring) {\n175\t        if(CLHASH_DEBUG) assert(length != 128);\n176\t        const __m128i temp1 = _mm_load_si128(randomsource);\n177\t        const __m128i temp2 = _mm_loadl_epi64((__m128i const*)string);\n178\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n179\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n180\t        acc = _mm_xor_si128(clprod1, acc);\n181\t        if(CLHASH_DEBUG) ++string;\n182\t    }\n183\t    if(CLHASH_DEBUG) assert(string == endstring);\n184\t    return acc;\n185\t}\n186\t// the value length does not have to be divisible by 4\n187\tstatic __m128i __clmulhalfscalarproductwithtailwithoutreductionWithExtraWord(const __m128i * randomsource,\n188\t        const uint64_t * string, const size_t length, const uint64_t extraword) {\n189\t    assert(((uintptr_t) randomsource & 15) == 0);// we expect cache line alignment for the keys\n190\t    const uint64_t * const endstring = string + length;\n191\t    __m128i acc = _mm_setzero_si128();\n192\t    for (; string + 3 < endstring; randomsource += 2, string += 4) {\n193\t        const __m128i temp1 = _mm_load_si128(randomsource);\n194\t        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n195\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n196\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n197\