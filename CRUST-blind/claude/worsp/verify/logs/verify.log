53\t\n154\t// =================================================\n155\t//   Clone implementations\n156\t// =================================================\n157\t\n158\timpl Clone for Token {\n159\t    fn clone(&self) -> Self {\n160\t        Token {\n161\t            kind: self.kind,\n162\t            next: self.next.clone(),\n163\t            val: self.val,\n164\t            str: self.str.clone(),\n165\t        }\n166\t    }\n167\t}\n168\t\n169\timpl Clone for ExpressionList {\n170\t    fn clone(&self) -> Self {\n171\t        ExpressionList {\n172\t            expression: self.expression.clone(),\n173\t            next: self.next.clone(),\n174\t        }\n175\t    }\n176\t}\n177\t\n178\timpl Clone for ExpressionNode {\n179\t    fn clone(&self) -> Self {\n180\t        ExpressionNode {\n181\t            type_: self.type_,\n182\t            data: self.data.clone(),\n183\t        }\n184\t    }\n185\t}\n186\t\n187\timpl Clone for ExpressionData {\n188\t    fn clone(&self) -> Self {\n189\t        match self {\n190\t            ExpressionData::SymbolicExp(inner) => ExpressionData::SymbolicExp(inner.clone()),\n191\t            ExpressionData::List(inner) => ExpressionData::List(inner.clone()),\n192\t            ExpressionData::Literal(inner) => ExpressionData::Literal(inner.clone()),\n193\t            ExpressionData::Symbol(inner) => ExpressionData::Symbol(inner.clone()),\n194\t        }\n195\t    }\n196\t}\n197\t\n198\timpl Clone for SymbolicExpNode {\n199\t    fn clone(&self) -> Self {\n200\t        SymbolicExpNode { expressions: self.expressions.clone() }\n201\t    }\n202\t}\n203\t\n204\timpl Clone for ListNode {\n205\t    fn clone(&self) -> Self {\n206\t        ListNode { expressions: self.expressions.clone() }\n207\t    }\n208\t}\n209\t\n210\timpl Clone for LiteralNode {\n211\t    fn clone(&self) -> Self {\n212\t        LiteralNode {\n213\t            type_: self.type_,\n214\t            value: self.value.clone(),\n215\t        }\n216\t    }\n217\t}\n218\t\n219\timpl Clone for LiteralValue {\n220\t    fn clone(&self) -> Self {\n221\t        match self {\n222\t            LiteralValue::IntValue(v) => LiteralValue::IntValue(*v),\n223\t            LiteralValue::BooleanValue(v) => LiteralValue::BooleanValue(*v),\n224\t            LiteralValue::StringValue(v) => LiteralValue::StringValue(v.clone()),\n225\t        }\n226\t    }\n227\t}\n228\t\n229\timpl Clone for SymbolNode {\n230\t    fn clone(&self) -> Self {\n231\t        SymbolNode { symbol_name: self.symbol_name.clone() }\n232\t    }\n233\t}\n234\t\n235\timpl Clone for ConsCell {\n236\t    fn clone(&self) -> Self {\n237\t        ConsCell {\n238\t            type_: self.type_,\n239\t            car: self.car.clone(),\n240\t            cdr: self.cdr.clone(),\n241\t        }\n242\t    }\n243\t}\n244\t\n245\timpl Clone for Function {\n246\t    fn clone(&self) -> Self {\n247\t        Function {\n248\t            param_symbol_names: self.param_symbol_names.clone(),\n249\t            body: self.body.clone(),\n250\t        }\n251\t    }\n252\t}\n253\t\n254\timpl Clone for Object {\n255\t    fn clone(&self) -> Self {\n256\t        Object {\n257\t            marked: self.marked,\n258\t            type_: self.type_,\n259\t            value: self.value.clone(),\n260\t        }\n261\t    }\n262\t}\n263\t\n264\timpl Clone for ObjectValue {\n265\t    fn clone(&self) -> Self {\n266\t        match self {\n267\t            ObjectValue::IntValue(v) => ObjectValue::IntValue(*v),\n268\t            ObjectValue::StringValue(v) => ObjectValue::StringValue(v.clone()),\n269\t            ObjectValue::BoolValue(v) => ObjectValue::BoolValue(*v),\n270\t            ObjectValue::ListValue(v) => ObjectValue::ListValue(v.clone()),\n271\t            ObjectValue::FunctionValue(v) => ObjectValue::FunctionValue(v.clone()),\n272\t        }\n273\t    }\n274\t}\n275\t\n276\timpl Clone for Binding {\n277\t    fn clone(&self) -> Self {\n278\t        Binding {\n279\t            symbol_name: self.symbol_name.clone(),\n280\t            value: self.value.clone(),\n281\t        }\n282\t    }\n283\t}\n284\t\n285\timpl Clone for Env {\n286\t    fn clone(&self) -> Self {\n287\t        Env {\n288\t            bindings: std::array::from_fn(|i| self.bindings[i].clone()),\n289\t            parent: self.parent.clone(),\n290\t        }\n291\t    }\n292\t}\n293\t\n294\t// =================================================\n295\t//   helpers\n296\t// =================================================\n297\t\n298\tfn empty_binding() -> Binding {\n299\t    Binding {\n300\t        symbol_name: String::new(),\n301\t        value: None,\n302\t    }\n303\t}\n304\t\n305\tfn empty_env() -> Env {\n306\t    Env {\n307\t        bindings: std::array::from_fn(|_| empty_binding()),\n308\t        parent: None,\n309\t    }\n310\t}\n311\t\n312\tfn empty_object() -> Object {\n313\t    Object {\n314\t        marked: false,\n315\t        type_: ObjectType::Nil,\n316\t        value: ObjectValue::IntValue(0),\n317\t    }\n318\t}\n319\t\n320\tfn nil_object() -> Object {\n321\t    Object {\n322\t        marked: false,\n323\t        type_: ObjectType::Nil,\n324\t        value: ObjectValue::IntValue(0),\n325\t    }\n326\t}\n327\t\n328\tfn is_op_char(c: u8) -> bool {\n329\t    matches!(\n330\t        c,\n331\t        b'+' | b'-' | b'*' | b'/' | b'%' | b'|' | b'&' | b'=' | b'<' | b'>'\n332\t    )\n333\t}\n334\t\n335\tfn is_alpha(c: u8) -> bool {\n336\t    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')\n337\t}\n338\t\n339\tfn is_digit(c: u8) -> bool {\n340\t    c >= b'0' && c <= b'9'\n341\t}\n342\t\n343\tfn is_alnum(c: u8) -> bool {\n344\t    is_alpha(c) || is_digit(c)\n345\t}\n346\t\n347\tfn is_space(c: u8) -> bool {\n348\t    c == b' ' || c == b'\\t' || c == b'\\n' || c == b'\\r' || c == 0x0b || c == 0x0c\n349\t}\n350\t\n351\t// =================================================\n352\t//   tokenizer\n353\t// =================================================\n354\t\n355\tpub fn match_token(state: &mut ParseState, kind: TokenKind) -> i32 {\n356\t    match &state.token {\n357\t        Some(t) => {\n358\t            if t.kind == kind {\n359\t                1\n360\t            } else {\n361\t                0\n362\t            }\n363\t        }\n364\t        None => 0,\n365\t    }\n366\t}\n367\t\n368\tpub fn next(source: &str, state: &mut ParseState) {\n369\t    let bytes = source.as_bytes();\n370\t    let len = bytes.len() as i32;\n371\t\n372\t    // Skip whitespace\n373\t    while state.pos < len {\n374\t        let c = bytes[state.pos as usize];\n375\t        if is_space(c) {\n376\t            state.pos += 1;\n377\t        } else {\n378\t            break;\n379\t        }\n380\t    }\n381\t\n382\t    let new_token: Token;\n383\t\n384\t    if state.pos >= len {\n385\t        new_token = Token {\n386\t            kind: TokenKind::Eof,\n387\t            next: None,\n388\t            val: 0,\n389\t            str: \"\\0\".to_string(),\n390\t        };\n391\t    } else {\n392\t        let c = bytes[state.pos as usize];\n393\t        if c == b'(' {\n394\t            new_token = Token {\n395\t                kind: TokenKind::LParen,\n396\t                next: None,\n397\t                val: 0,\n398\t                str: \"(\".to_string(),\n399\t            };\n400\t            state.pos += 1;\n401\t        } else if c == b')' {\n402\t            new_token = Token {\n403\t                kind: TokenKind::RParen,\n404\t                next: None,\n405\t                val: 0,\n406\t                str: \")\".to_string(),\n407\t            };\n408\t            state.pos += 1;\n409\t        } else if c == b'\\'' {\n410\t            new_token = Token {\n411\t                kind: TokenKind::Quote,\n412\t                next: None,\n413\t                val: 0,\n414\t                str: \"'\".to_string(),\n415\t            };\n416\t            state.pos += 1;\n417\t        } else if is_alpha(c) || is_op_char(c) {\n418\t            let start = state.pos as usize;\n419\t            while state.pos < len {\n420\t                let cc = bytes[state.pos as usize];\n421\t                if is_alnum(cc) || is_op_char(cc) {\n422\t                    state.pos += 1;\n423\t                } else {\n424\t                    break;\n425\t                }\n426\t            }\n427\t            let s = std::str::from_utf8(&bytes[start..state.pos as usize])\n428\t                .unwrap_or(\"\")\n429\t                .to_string();\n430\t            if s == \"true\" {\n431\t                new_token = Token {\n432\t                    kind: TokenKind::True,\n433\t                    next: None,\n434\t                    val: 0,\n435\t                    str: String::new(),\n436\t                };\n437\t            } else if s == \"false\" {\n438\t                new_token = Token {\n439\t                    kind: TokenKind::False,\n440\t                    next: None,\n441\t                    val: 0,\n442\t                    str: String::new(),\n443\t                };\n444\t            } else {\n445\t                new_token = Token {\n446\t                    kind: TokenKind::Symbol,\n447\t                    next: None,\n448\t                    val: 0,\n449\t                    str: s,\n450\t                };\n451\t            }\n452\t        } else if is_digit(c) {\n453\t            let start = state.pos as usize;\n454\t            while state.pos < len && is_digit(bytes[state.pos as usize]) {\n455\t                state.pos += 1;\n456\t            }\n457\t            let s = std::str::from_utf8(&bytes[start..state.pos as usize]).unwrap_or(\"0\");\n458\t            let val: i32 = s.parse().unwrap_or(0);\n459\t            new_token = Token {\n460\t                kind: TokenKind::Digit,\n461\t                next: None,\n462\t                val,\n463\t                str: String::new(),\n464\t            };\n465\t        } else if c == b'\"' {\n466\t            state.pos += 1;\n467\t            let start = state.pos as usize;\n468\t            while state.pos < len && bytes[state.pos as usize] != b'\"' {\n469\t                state.pos += 1;\n470\t            }\n471\t            let s = std::str::from_utf8(&bytes[start..state.pos as usize])\n472\t                .unwrap_or(\"\")\n473\t                .to_string();\n474\t            if state.pos < len && bytes[state.pos as usize] == b'\"' {\n475\t                state.pos += 1;\n476\t            }\n477\t            new_token = Token {\n478\t                kind: TokenKind::String,\n479\t                next: None,\n480\t                val: 0,\n481\t                str: s,\n482\t            };\n483\t        } else if c == b';' {\n484\t            // comment to end of line\n485\t            while state.pos < len && bytes[state.pos as usize] != b'\\n' {\n486\t                state.pos += 1;\n487\t            }\n488\t            next(source, state);\n489\t            return;\n490\t        } else {\n491\t            // unexpected character; mimic C exit but use panic for unrecoverable error\n492\t            eprintln!(\"Unexpected token: {}\", c as char);\n493\t            std::process::exit(1);\n494\t        }\n495\t    }\n496\t\n497\t    // Replace the current token (we don't need to maintain the linked list,\n498\t    // since `state.token` is what is consulted for `match`).\n499\t    state.token = Some(Box::new(new_token));\n500\t}\n501\t\n502\t// =================================================\n503\t//   parser\n504\t// =================================================\n505\t\n506\tfn append_expression_to_list(list: &mut Option<Box<ExpressionList>>, expr: ExpressionNode) {\n507\t    let new_node = Box::new(ExpressionList {\n508\t        expression: Some(Box::new(expr)),\n509\t        next: None,\n510\t    });\n511\t    if list.is_none() {\n512\t        *list = Some(new_node);\n513\t        return;\n514\t    }\n515\t    let mut cur: &mut ExpressionList = list.as_deref_mut().unwrap();\n516\t    while cur.next.is_some() {\n517\t        cur = cur.next.as_deref_mut().unwrap();\n518\t    }\n519\t    cur.next = Some(new_node);\n520\t}\n521\t\n522\tfn parse_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n523\t    if match_token(state, TokenKind::LParen) == 1 {\n524\t        return parse_symbolic_expression(source, state);\n525\t    } else if match_token(state, TokenKind::Quote) == 1 {\n526\t        return parse_list_expression(source, state);\n527\t    } else if match_token(state, TokenKind::Symbol) == 1 {\n528\t        return parse_symbol_expression(source, state);\n529\t    } else if match_token(state, TokenKind::Digit) == 1\n530\t        || match_token(state, TokenKind::String) == 1\n531\t        || match_token(state, TokenKind::True) == 1\n532\t        || match_token(state, TokenKind::False) == 1\n533\t    {\n534\t        return parse_literal_expression(source, state);\n535\t    } else {\n536\t        let s = state\n537\t            .token\n538\t            .as_ref()\n539\t            .map(|t| t.str.clone())\n540\t            .unwrap_or_default();\n541\t        eprintln!(\"Unexpected token: {}\", s);\n542\t        std::process::exit(1);\n543\t    }\n544\t}\n545\t\n546\tfn parse_symbolic_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n547\t    let mut sym_exp = SymbolicExpNode { expressions: None };\n548\t    next(source, state); // eat '('\n549\t    while match_token(state, TokenKind::RParen) != 1 {\n550\t        let item = parse_expression(source, state);\n551\t        append_expression_to_list(&mut sym_exp.expressions, item);\n552\t    }\n553\t    next(source, state); // eat ')'\n554\t    ExpressionNode {\n555\t        type_: ExpressionType::SymbolicExp,\n556\t        data: ExpressionData::SymbolicExp(Some(Box::new(sym_exp))),\n557\t    }\n558\t}\n559\t\n560\tfn parse_list_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n561\t    let mut list_node = ListNode { expressions: None };\n562\t    next(source, state); // eat quote\n563\t    next(source, state); // eat '('\n564\t    while match_token(state, TokenKind::RParen) != 1 {\n565\t        let item = parse_expression(source, state);\n566\t        append_expression_to_list(&mut list_node.expressions, item);\n567\t    }\n568\t    next(source, state); // eat ')'\n569\t    ExpressionNode {\n570\t        type_: ExpressionType::List,\n571\t        data: ExpressionData::List(Some(Box::new(list_node))),\n572\t    }\n573\t}\n574\t\n575\tfn parse_symbol_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n576\t    let name = state\n577\t        .token\n578\t        .as_ref()\n579\t        .map(|t| t.str.clone())\n580\t        .unwrap_or_default();\n581\t    next(source, state);\n582\t    ExpressionNode {\n583\t        type_: ExpressionType::Symbol,\n584\t        data: ExpressionData::Symbol(Some(Box::new(SymbolNode { symbol_name: name }))),\n585\t    }\n586\t}\n587\t\n588\tfn parse_literal_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n589\t    let lit_node = if match_token(state, TokenKind::Digit) == 1 {\n590\t        let v = state.token.as_ref().map(|t| t.val).unwrap_or(0);\n591\t        let node = LiteralNode {\n592\t            type_: LiteralType::Integer,\n593\t            value: LiteralValue::IntValue(v),\n594\t        };\n595\t        next(source, state);\n596\t        node\n597\t    } else if match_token(state, TokenKind::String) == 1 {\n598\t        let s = state\n599\t            .token\n600\t            .as_ref()\n601\t            .map(|t| t.str.clone())\n602\t            .unwrap_or_default();\n603\t        let node = LiteralNode {\n604\t            type_: LiteralType::String,\n605\t            value: LiteralValue::StringValue(s),\n606\t        };\n607\t        next(source, state);\n608\t        node\n609\t    } else if match_token(state, TokenKind::True) == 1 {\n610\t        let node = LiteralNode {\n611\t            type_: LiteralType::Boolean,\n612\t            value: LiteralValue::BooleanValue(true),\n613\t        };\n614\t        next(source, state);\n615\t        node\n616\t    } else if match_token(state, TokenKind::False) == 1 {\n617\t        let node = LiteralNode {\n618\t            type_: LiteralType::Boolean,\n619\t            value: LiteralValue::BooleanValue(false),\n620\t        };\n621\t        next(source, state);\n622\t        node\n623\t    } else {\n624\t        let s = state\n625\t            .token\n626\t            .as_ref()\n627\t            .map(|t| t.str.clone())\n628\t            .unwrap_or_default();\n629\t        eprintln!(\"Unexpected token: {}\", s);\n630\t        std::process::exit(1);\n631\t    };\n632\t    ExpressionNode {\n633\t        type_: ExpressionType::Literal,\n634\t        data: ExpressionData::Literal(Some(Box::new(lit_node))),\n635\t    }\n636\t}\n637\t\n638\tpub fn parse(source: &str, state: &mut ParseState, result: &mut ParseResult) {\n639\t    next(source, state);\n640\t    let mut program = ProgramNode { expressions: None };\n641\t    while match_token(state, TokenKind::Eof) != 1 {\n642\t        let expr = parse_expression(source, state);\n643\t        append_expression_to_list(&mut program.expressions, expr);\n644\t    }\n645\t    result.program = Some(Box::new(program));\n646\t}\n647\t\n648\t// =================================================\n649\t//   object helpers\n650\t// =================================================\n651\t\n652\tfn bool_val(obj: &Object) -> bool {\n653\t    match obj.type_ {\n654\t        ObjectType::Bool => match &obj.value {\n655\t            ObjectValue::BoolValue(v) => *v != 0,\n656\t            _ => false,\n657\t        },\n658\t        ObjectType::Nil => false,\n659\t        _ => true,\n660\t    }\n661\t}\n662\t\n663\tfn obj_eq(op1: &Object, op2: &Object) -> bool {\n664\t    let same_kind = matches!(\n665\t        (op1.type_, op2.type_),\n666\t        (ObjectType::Integer, ObjectType::Integer)\n667\t            | (ObjectType::String, ObjectType::String)\n668\t            | (ObjectType::Bool, ObjectType::Bool)\n669\t            | (ObjectType::List, ObjectType::List)\n670\t            | (ObjectType::Nil, ObjectType::Nil)\n671\t            | (ObjectType::Function, ObjectType::Function)\n672\t    );\n673\t    if !same_kind {\n674\t        return false;\n675\t    }\n676\t    match op1.type_ {\n677\t        ObjectType::Integer => match (&op1.value, &op2.value) {\n678\t            (ObjectValue::IntValue(a), ObjectValue::IntValue(b)) => a == b,\n679\t            _ => false,\n680\t        },\n681\t        ObjectType::String => match (&op1.value, &op2.value) {\n682\t            (ObjectValue::StringValue(a), ObjectValue::StringValue(b)) => a == b,\n683\t            _ => false,\n684\t        },\n685\t        ObjectType::Bool => match (&op1.value, &op2.value) {\n686\t            (ObjectValue::BoolValue(a), ObjectValue::BoolValue(b)) => a == b,\n687\t            _ => false,\n688\t        },\n689\t        ObjectType::List => false, // C compares pointers; freshly built lists are never equal\n690\t        ObjectType::Nil => true,\n691\t        ObjectType::Function => false,\n692\t    }\n693\t}\n694\t\n695\tfn is_last_cons_cell(cell: &ConsCell) -> bool {\n696\t    match &cell.cdr {\n697\t        Some(o) => matches!(o.type_, ObjectType::Nil),\n698\t        None => true,\n699\t    }\n700\t}\n701\t\n702\tpub fn stringify_object(obj: &Object) -> String {\n703\t    match obj.type_ {\n704\t        ObjectType::Integer => match &obj.value {\n705\t            ObjectValue::IntValue(v) => v.to_string(),\n706\t            _ => \"0\".to_string(),\n707\t        },\n708\t        ObjectType::String => match &obj.value {\n709\t            ObjectValue::StringValue(v) => v.clone(),\n710\t            _ => String::new(),\n711\t        },\n712\t        ObjectType::Bool => match &obj.value {\n713\t            ObjectValue::BoolValue(v) => {\n714\t                if *v != 0 {\n715\t                    \"T\".to_string()\n716\t                } else {\n717\t                    \"F\".to_string()\n718\t                }\n719\t            }\n720\t            _ => \"F\".to_string(),\n721\t        },\n722\t        ObjectType::List => {\n723\t            let mut s = String::from(\"(\");\n724\t            if let ObjectValue::ListValue(Some(first)) = &obj.value {\n725\t                let mut current: &ConsCell = first.as_ref();\n726\t                loop {\n727\t                    if let Some(car) = &current.car {\n728\t                        s.push_str(&stringify_object(car));\n729\t                    }\n730\t                    if is_last_cons_cell(current) {\n731\t                        break;\n732\t                    }\n733\t                    s.push(' ');\n734\t                    // move to next cell via cdr\n735\t                    if let Some(cdr) = &current.cdr {\n736\t                        if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n737\t                            current = next_cell.as_ref();\n738\t                        } else {\n739\t                            break;\n740\t                        }\n741\t                    } else {\n742\t                        break;\n743\t                    }\n744\t                }\n745\t            }\n746\t            s.push(')');\n747\t            s\n748\t        }\n749\t        ObjectType::Nil => \"nil\".to_string(),\n750\t        ObjectType::Function => \"<function>\".to_string(),\n751\t    }\n752\t}\n753\t\n754\t// =================================================\n755\t//   defined functions\n756\t// =================================================\n757\t\n758\tfn defined_add(op1: &Object, op2: &Object, evaluated: &mut Object) {\n759\t    match (op1.type_, op2.type_) {\n760\t        (ObjectType::Integer, ObjectType::Integer) => {\n761\t            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n762\t            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n763\t            evaluated.type_ = ObjectType::Integer;\n764\t            evaluated.value = ObjectValue::IntValue(a.wrapping_add(b));\n765\t        }\n766\t        (ObjectType::String, ObjectType::String) => {\n767\t            let a = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n768\t            let b = if let ObjectValue::StringValue(v) = &op2.value { v.clone() } else { String::new() };\n769\t            evaluated.type_ = ObjectType::String;\n770\t            evaluated.value = ObjectValue::StringValue(a + &b);\n771\t        }\n772\t        _ => {\n773\t            eprintln!(\"Type error: operands for + must be integers or strings.\");\n774\t            std::process::exit(1);\n775\t        }\n776\t    }\n777\t}\n778\t\n779\tfn defined_sub(op1: &Object, op2: &Object, evaluated: &mut Object) {\n780\t    match (op1.type_, op2.type_) {\n781\t        (ObjectType::Integer, ObjectType::Integer) => {\n782\t            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n783\t            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n784\t            evaluated.type_ = ObjectType::Integer;\n785\t            evaluated.value = ObjectValue::IntValue(a.wrapping_sub(b));\n786\t        }\n787\t        _ => {\n788\t            eprintln!(\"Type error: operands for - must be integers.\");\n789\t            std::process::exit(1);\n790\t        }\n791\t    }\n792\t}\n793\t\n794\tfn defined_mul(op1: &Object, op2: &Object, evaluated: &mut Object) {\n795\t    match (op1.type_, op2.type_) {\n796\t        (ObjectType::Integer, ObjectType::Integer) => {\n797\t            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n798\t            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n799\t            evaluated.type_ = ObjectType::Integer;\n800\t            evaluated.value = ObjectValue::IntValue(a.wrapping_mul(b));\n801\t        }\n802\t        _ => {\n803\t            eprintln!(\"Type error: operands for * must be integers.\");\n804\t            std::process::exit(1);\n805\t        }\n806\t    }\n807\t}\n808\t\n809\tfn defined_div(op1: &Object, op2: &Object, evaluated: &mut Object) {\n810\t    match (op1.type_, op2.type_) {\n811\t        (ObjectType::Integer, ObjectType::Integer) => {\n812\t            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n813\t            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n814\t            if b == 0 {\n815\t                eprintln!(\"Division by zero.\");\n816\t                std::process::exit(1);\n817\t            }\n818\t            evaluated.type_ = ObjectType::Integer;\n819\t            evaluated.value = ObjectValue::IntValue(a / b);\n820\t        }\n821\t        _ => {\n822\t            eprintln!(\"Type error: operands for / must be integers.\");\n823\t            std::process::exit(1);\n824\t        }\n825\t    }\n826\t}\n827\t\n828\tfn defined_mod(op1: &Object, op2: &Object, evaluated: &mut Object) {\n829\t    match (op1.type_, op2.type_) {\n830\t        (ObjectType::Integer, ObjectType::Integer) => {\n831\t            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n832\t            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n833\t            if b == 0 {\n834\t                eprintln!(\"Modulo by zero.\");\n835\t                std::process::exit(1);\n836\t            }\n837\t            evaluated.type_ = ObjectType::Integer;\n838\t            evaluated.value = ObjectValue::IntValue(a % b);\n839\t        }\n840\t        _ => {\n841\t            eprintln!(\"Type error: operands for % must be integers.\");\n842\t            std::process::exit(1);\n843\t        }\n844\t    }\n845\t}\n846\t\n847\tfn defined_lt(op1: &Object, op2: &Object, evaluated: &mut Object) {\n848\t    match (op1.type_, op2.type_) {\n849\t        (ObjectType::Integer, ObjectType::Integer) => {\n850\t            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n851\t            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n852\t            evaluated.type_ = ObjectType::Bool;\n853\t            evaluated.value = ObjectValue::BoolValue(if a < b { 1 } else { 0 });\n854\t        }\n855\t        _ => {\n856\t            eprintln!(\"Type error: operands for < must be integers.\");\n857\t            std::process::exit(1);\n858\t        }\n859\t    }\n860\t}\n861\t\n862\tfn defined_gt(op1: &Object, op2: &Object, evaluated: &mut Object) {\n863\t    match (op1.type_, op2.type_) {\n864\t        (ObjectType::Integer, ObjectType::Integer) => {\n865\t            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n866\t            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n867\t            evaluated.type_ = ObjectType::Bool;\n868\t            evaluated.value = ObjectValue::BoolValue(if a > b { 1 } else { 0 });\n869\t        }\n870\t        _ => {\n871\t            eprintln!(\"Type error: operands for > must be integers.\");\n872\t            std::process::exit(1);\n873\t        }\n874\t    }\n875\t}\n876\t\n877\tfn defined_eq(op1: &Object, op2: &Object, evaluated: &mut Object) {\n878\t    evaluated.type_ = ObjectType::Bool;\n879\t    evaluated.value = ObjectValue::BoolValue(if obj_eq(op1, op2) { 1 } else { 0 });\n880\t}\n881\t\n882\tfn defined_not(op: &Object, evaluated: &mut Object) {\n883\t    if !matches!(op.type_, ObjectType::Bool) {\n884\t        eprintln!(\"Type error: not operand must be boolean.\");\n885\t        std::process::exit(1);\n886\t    }\n887\t    let v = if let ObjectValue::BoolValue(v) = &op.value { *v } else { 0 };\n888\t    evaluated.type_ = ObjectType::Bool;\n889\t    evaluated.value = ObjectValue::BoolValue(if v != 0 { 0 } else { 1 });\n890\t}\n891\t\n892\tfn defined_car(op: &Object, evaluated: &mut Object) {\n893\t    if !matches!(op.type_, ObjectType::List) {\n894\t        eprintln!(\"Type error: car operand must be list.\");\n895\t        std::process::exit(1);\n896\t    }\n897\t    if let ObjectValue::ListValue(Some(cell)) = &op.value {\n898\t        if let Some(car) = &cell.car {\n899\t            *evaluated = (**car).clone();\n900\t        }\n901\t    }\n902\t}\n903\t\n904\tfn defined_cdr(op: &Object, evaluated: &mut Object) {\n905\t    if !matches!(op.type_, ObjectType::List) {\n906\t        eprintln!(\"Type error: cdr operand must be list.\");\n907\t        std::process::exit(1);\n908\t    }\n909\t    if let ObjectValue::ListValue(Some(cell)) = &op.value {\n910\t        if let Some(cdr) = &cell.cdr {\n911\t            *evaluated = (**cdr).clone();\n912\t        }\n913\t    }\n914\t}\n915\t\n916\tfn defined_cons(op1: &Object, op2: &Object, evaluated: &mut Object) {\n917\t    let new_cell;\n918\t    match op2.type_ {\n919\t        ObjectType::List => {\n920\t            new_cell = ConsCell {\n921\t                type_: ConsCellType::Cell,\n922\t                car: Some(Box::new(op1.clone())),\n923\t                cdr: Some(Box::new(op2.clone())),\n924\t            };\n925\t        }\n926\t        ObjectType::Nil => {\n927\t            new_cell = ConsCell {\n928\t                type_: ConsCellType::Cell,\n929\t                car: Some(Box::new(op1.clone())),\n930\t                cdr: Some(Box::new(op2.clone())),\n931\t            };\n932\t        }\n933\t        _ => {\n934\t            // wrap op2 into its own list\n935\t            let inner_cell = ConsCell {\n936\t                type_: ConsCellType::Cell,\n937\t                car: Some(Box::new(op2.clone())),\n938\t                cdr: Some(Box::new(nil_object())),\n939\t            };\n940\t            let cdr_obj = Object {\n941\t                marked: false,\n942\t                type_: ObjectType::List,\n943\t                value: ObjectValue::ListValue(Some(Box::new(inner_cell))),\n944\t            };\n945\t            new_cell = ConsCell {\n946\t                type_: ConsCellType::Cell,\n947\t                car: Some(Box::new(op1.clone())),\n948\t                cdr: Some(Box::new(cdr_obj)),\n949\t            };\n950\t        }\n951\t    }\n952\t    evaluated.type_ = ObjectType::List;\n953\t    evaluated.value = ObjectValue::ListValue(Some(Box::new(new_cell)));\n954\t}\n955\t\n956\tfn defined_split(op1: &Object, op2: &Object, evaluated: &mut Object) {\n957\t    if !matches!(op1.type_, ObjectType::String) {\n958\t        eprintln!(\"Type error: split first operand must be string.\");\n959\t        std::process::exit(1);\n960\t    }\n961\t    if !matches!(op2.type_, ObjectType::String) {\n962\t        eprintln!(\"Type error: split second operand must be string.\");\n963\t        std::process::exit(1);\n964\t    }\n965\t    let s = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n966\t    let sep = if let ObjectValue::StringValue(v) = &op2.value { v.clone() } else { String::new() };\n967\t\n968\t    let pieces: Vec<String> = if sep.is_empty() {\n969\t        // list of characters\n970\t        s.chars().map(|c| c.to_string()).collect()\n971\t    } else {\n972\t        // strtok-like behaviour: skip empty pieces, treat each char in sep as a delimiter\n973\t        let sep_chars: std::collections::HashSet<char> = sep.chars().collect();\n974\t        let mut out = Vec::new();\n975\t        let mut cur = String::new();\n976\t        for ch in s.chars() {\n977\t            if sep_chars.contains(&ch) {\n978\t                if !cur.is_empty() {\n979\t                    out.push(std::mem::take(&mut cur));\n980\t                }\n981\t            } else {\n982\t                cur.push(ch);\n983\t            }\n984\t        }\n985\t        if !cur.is_empty() {\n986\t            out.push(cur);\n987\t        }\n988\t        out\n989\t    };\n990\t\n991\t    if pieces.is_empty() {\n992\t        evaluated.type_ = ObjectType::Nil;\n993\t        return;\n994\t    }\n995\t\n996\t    // build cons-cell list\n997\t    let mut head: Option<Box<ConsCell>> = None;\n998\t    for piece in pieces.into_iter().rev() {\n999\t        let car_obj = Object {\n1000\t            marked: false,\n1001\t            type_: ObjectType::String,\n1002\t            value: ObjectValue::StringValue(piece),\n1003\t        };\n1004\t        let cdr_obj = match head {\n1005\t            None => Object {\n1006\t                marked: false,\n1007\t                type_: ObjectType::Nil,\n1008\t                value: ObjectValue::IntValue(0),\n1009\t            },\n1010\t            Some(cell) => Object {\n1011\t                marked: false,\n1012\t                type_: ObjectType::List,\n1013\t                value: ObjectValue::ListValue(Some(cell)),\n1014\t            },\n1015\t        };\n1016\t        let cell_type = if matches!(cdr_obj.type_, ObjectType::Nil) {\n1017\t            ConsCellType::Cell\n1018\t        } else {\n1019\t            ConsCellType::Cell\n1020\t        };\n1021\t        head = Some(Box::new(ConsCell {\n1022\t            type_: cell_type,\n1023\t            car: Some(Box::new(car_obj)),\n1024\t            cdr: Some(Box::new(cdr_obj)),\n1025\t        }));\n1026\t    }\n1027\t\n1028\t    evaluated.type_ = ObjectType::List;\n1029\t    evaluated.value = ObjectValue::ListValue(head);\n1030\t}\n1031\t\n1032\tfn defined_list_ref(op1: &Object, op2: &Object, evaluated: &mut Object) {\n1033\t    if !matches!(op1.type_, ObjectType::List) {\n1034\t        eprintln!(\"Type error: list-ref first operand must be list.\");\n1035\t        std::process::exit(1);\n1036\t    }\n1037\t    if !matches!(op2.type_, ObjectType::Integer) {\n1038\t        eprintln!(\"Type error: list-ref second operand must be integer.\");\n1039\t        std::process::exit(1);\n1040\t    }\n1041\t    let index = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n1042\t    if let ObjectValue::ListValue(Some(cell0)) = &op1.value {\n1043\t        let mut current: &ConsCell = cell0.as_ref();\n1044\t        for _ in 0..index {\n1045\t            if let Some(cdr) = &current.cdr {\n1046\t                if matches!(cdr.type_, ObjectType::Nil) {\n1047\t                    eprintln!(\"Index out of range.\");\n1048\t                    std::process::exit(1);\n1049\t                }\n1050\t                if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n1051\t                    current = next_cell.as_ref();\n1052\t                } else {\n1053\t                    eprintln!(\"Index out of range.\");\n1054\t                    std::process::exit(1);\n1055\t                }\n1056\t            } else {\n1057\t                eprintln!(\"Index out of range.\");\n1058\t                std::process::exit(1);\n1059\t            }\n1060\t        }\n1061\t        if let Some(car) = &current.car {\n1062\t            *evaluated = (**car).clone();\n1063\t        }\n1064\t    }\n1065\t}\n1066\t\n1067\tfn defined_remove_whitespaces(op1: &Object, evaluated: &mut Object) {\n1068\t    if !matches!(op1.type_, ObjectType::String) {\n1069\t        eprintln!(\"Type error: remove-whitespaces operand must be string.\");\n1070\t        std::process::exit(1);\n1071\t    }\n1072\t    let s = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n1073\t    let result: String = s.chars().filter(|c| !c.is_whitespace()).collect();\n1074\t    evaluated.type_ = ObjectType::String;\n1075\t    evaluated.value = ObjectValue::StringValue(result);\n1076\t}\n1077\t\n1078\t#[allow(dead_code)]\n1079\tfn defined_pop(op: &Object, evaluated: &mut Object) {\n1080\t    if matches!(op.type_, ObjectType::Nil) {\n1081\t        evaluated.type_ = ObjectType::Nil;\n1082\t        evaluated.value = ObjectValue::IntValue(0);\n1083\t        return;\n1084\t    }\n1085\t    if !matches!(op.type_, ObjectType::List) {\n1086\t        eprintln!(\"Type error: pop operand must be list.\");\n1087\t        std::process::exit(1);\n1088\t    }\n1089\t    if let ObjectValue::ListValue(Some(cell0)) = &op.value {\n1090\t        let mut current: &ConsCell = cell0.as_ref();\n1091\t        loop {\n1092\t            if is_last_cons_cell(current) {\n1093\t                if let Some(car) = &current.car {\n1094\t                    *evaluated = (**car).clone();\n1095\t                }\n1096\t                break;\n1097\t            }\n1098\t            if let Some(cdr) = &current.cdr {\n1099\t                if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n1100\t                    current = next_cell.as_ref();\n1101\t                } else {\n1102\t                    break;\n1103\t                }\n1104\t            } else {\n1105\t                break;\n1106\t            }\n1107\t        }\n1108\t    }\n1109\t}\n1110\t\n1111\tfn defined_length(op: &Object, evaluated: &mut Object) {\n1112\t    match op.type_ {\n1113\t        ObjectType::Nil => {\n1114\t            evaluated.type_ = ObjectType::Integer;\n1115\t            evaluated.value = ObjectValue::IntValue(0);\n1116\t        }\n1117\t        ObjectType::List => {\n1118\t            let mut length = 1i32;\n1119\t            if let ObjectValue::ListValue(Some(cell0)) = &op.value {\n1120\t                let mut current: &ConsCell = cell0.as_ref();\n1121\t                loop {\n1122\t                    if is_last_cons_cell(current) {\n1123\t                        break;\n1124\t                    }\n1125\t                    length += 1;\n1126\t                    if let Some(cdr) = &current.cdr {\n1127\t                        if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n1128\t                            current = next_cell.as_ref();\n1129\t                        } else {\n1130\t                            break;\n1131\t                        }\n1132\t                    } else {\n1133\t                        break;\n1134\t                    }\n1135\t                }\n1136\t            } else {\n1137\t                length = 0;\n1138\t            }\n1139\t            evaluated.type_ = ObjectType::Integer;\n1140\t            evaluated.value = ObjectValue::IntValue(length);\n1141\t        }\n1142\t        ObjectType::String => {\n1143\t            let len = if let ObjectValue::StringValue(v) = &op.value {\n1144\t                v.len() as i32\n1145\t            } else {\n1146\t                0\n1147\t            };\n1148\t            evaluated.type_ = ObjectType::Integer;\n1149\t            evaluated.value = ObjectValue::IntValue(len);\n1150\t        }\n1151\t        _ => {\n1152\t            eprintln!(\"Type error: length operand must be list or string.\");\n1153\t            std::process::exit(1);\n1154\t        }\n1155\t    }\n1156\t}\n1157\t\n1158\tfn defined_is_int_string(op: &Object, evaluated: &mut Object) {\n1159\t    let result = if matches!(op.type_, ObjectType::String) {\n1160\t        if let ObjectValue::StringValue(s) = &op.value {\n1161\t            !s.is_empty() && s.chars().all(|c| c.is_ascii_digit())\n1162\t        } else {\n1163\t            false\n1164\t        }\n1165\t    } else {\n1166\t        false\n1167\t    };\n1168\t    evaluated.type_ = ObjectType::Bool;\n1169\t    evaluated.value = ObjectValue::BoolValue(if result { 1 } else { 0 });\n1170\t}\n1171\t\n1172\tfn defined_parse_int(op: &Object, evaluated: &mut Object) {\n1173\t    if !matches!(op.type_, ObjectType::String) {\n1174\t        eprintln!(\"Type error: parse-int operand must be string.\");\n1175\t        std::process::exit(1);\n1176\t    }\n1177\t    let s = if let ObjectValue::StringValue(v) = &op.value { v.clone() } else { String::new() };\n1178\t    if !s.chars().all(|c| c.is_ascii_digit()) {\n1179\t        eprintln!(\"Type error: parse-int operand must be string of digits.\");\n1180\t        std::process::exit(1);\n1181\t    }\n1182\t    let v: i32 = s.parse().unwrap_or(0);\n1183\t    evaluated.type_ = ObjectType::Integer;\n1184\t    evaluated.value = ObjectValue::IntValue(v);\n1185\t}\n1186\t\n1187\tfn defined_string_ref(op1: &Object, op2: &Object, evaluated: &mut Object) {\n1188\t    if !matches!(op1.type_, ObjectType::String) {\n1189\t        eprintln!(\"Type error: string-ref first operand must be string.\");\n1190\t        std::process::exit(1);\n1191\t    }\n1192\t    if !matches!(op2.type_, ObjectType::Integer) {\n1193\t        eprintln!(\"Type error: string-ref second operand must be integer.\");\n1194\t        std::process::exit(1);\n1195\t    }\n1196\t    let s = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n1197\t    let idx = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n1198\t    let bytes = s.as_bytes();\n1199\t    if idx < 0 || (idx as usize) >= bytes.len() {\n1200\t        eprintln!(\"Index out of range.\");\n1201\t        std::process::exit(1);\n1202\t    }\n1203\t    let ch = bytes[idx as usize];\n1204\t    evaluated.type_ = ObjectType::String;\n1205\t    evaluated.value = ObjectValue::StringValue((ch as char).to_string());\n1206\t}\n1207\t\n1208\t// =================================================\n1209\t//   environment helpers\n1210\t// =================================================\n1211\t\n1212\tfn set_object_to_env(env: &mut Env, symbol_name: &str, obj: Object) {\n1213\t    let mut empty_idx: Option<usize> = None;\n1214\t    for i in 0..MAX_BINDINGS {\n1215\t        if env.bindings[i].symbol_name.is_empty() {\n1216\t            empty_idx = Some(i);\n1217\t            break;\n1218\t        }\n1219\t        if env.bindings[i].symbol_name == symbol_name {\n1220\t            env.bindings[i].value = Some(Box::new(obj));\n1221\t            return;\n1222\t        }\n1223\t    }\n1224\t    if let Some(i) = empty_idx {\n1225\t        env.bindings[i].symbol_name = symbol_name.to_string();\n1226\t        env.bindings[i].value = Some(Box::new(obj));\n1227\t    }\n1228\t}\n1229\t\n1230\tfn lookup_in_env(env: &Env, symbol_name: &str) -> Option<Object> {\n1231\t    for i in 0..MAX_BINDINGS {\n1232\t        if env.bindings[i].symbol_name.is_empty() {\n1233\t            break;\n1234\t        }\n1235\t        if env.bindings[i].symbol_name == symbol_name {\n1236\t            if let Some(v) = &env.bindings[i].value {\n1237\t                return Some((**v).clone());\n1238\t            }\n1239\t        }\n1240\t    }\n1241\t    if let Some(parent) = &env.parent {\n1242\t        return lookup_in_env(parent, symbol_name);\n1243\t    }\n1244\t    None\n1245\t}\n1246\t\n1247\t// =================================================\n1248\t//   evaluator\n1249\t// =================================================\n1250\t\n1251\tfn evaluate_literal_expression(expression: &ExpressionNode, evaluated: &mut Object) {\n1252\t    if let ExpressionData::Literal(Some(lit)) = &expression.data {\n1253\t        match &lit.value {\n1254\t            LiteralValue::IntValue(v) => {\n1255\t                evaluated.type_ = ObjectType::Integer;\n1256\t                evaluated.value = ObjectValue::IntValue(*v);\n1257\t            }\n1258\t            LiteralValue::StringValue(v) => {\n1259\t                evaluated.type_ = ObjectType::String;\n1260\t                evaluated.value = ObjectValue::StringValue(v.clone());\n1261\t            }\n1262\t            LiteralValue::BooleanValue(v) => {\n1263\t                evaluated.type_ = ObjectType::Bool;\n1264\t                evaluated.value = ObjectValue::BoolValue(if *v { 1 } else { 0 });\n1265\t            }\n1266\t        }\n1267\t    }\n1268\t}\n1269\t\n1270\tfn evaluate_symbol_expression(\n1271\t    expression: &ExpressionNode,\n1272\t    evaluated: &mut Object,\n1273\t    env: &mut Env,\n1274\t) {\n1275\t    let name = match &expression.data {\n1276\t        ExpressionData::Symbol(Some(s)) => s.symbol_name.clone(),\n1277\t        _ => return,\n1278\t    };\n1279\t    if name == \"nil\" {\n1280\t        evaluated.type_ = ObjectType::Nil;\n1281\t        evaluated.value = ObjectValue::IntValue(0);\n1282\t        return;\n1283\t    }\n1284\t    if let Some(obj) = lookup_in_env(env, &name) {\n1285\t        *evaluated = obj;\n1286\t    } else {\n1287\t        eprintln!(\"Undefined symbol: {}\", name);\n1288\t        std::process::exit(1);\n1289\t    }\n1290\t}\n1291\t\n1292\tfn evaluate_list_expression(\n1293\t    expression: &ExpressionNode,\n1294\t    evaluated: &mut Object,\n1295\t    env: &mut Env,\n1296\t    context: &mut AllocatorContext,\n1297\t) {\n1298\t    let expressions_opt = match &expression.data {\n1299\t        ExpressionData::List(Some(list)) => list.expressions.as_deref(),\n1300\t        _ => None,\n1301\t    };\n1302\t    if expressions_opt.is_none() {\n1303\t        evaluated.type_ = ObjectType::Nil;\n1304\t        evaluated.value = ObjectValue::IntValue(0);\n1305\t        return;\n1306\t    }\n1307\t\n1308\t    // collect all evaluated items first\n1309\t    let mut items: Vec<Object> = Vec::new();\n1310\t    let mut cur = expressions_opt;\n1311\t    while let Some(node) = cur {\n1312\t        if let Some(expr) = &node.expression {\n1313\t            let mut item = empty_object();\n1314\t            evaluate_expression(expr, &mut item, env, context);\n1315\t            items.push(item);\n1316\t        }\n1317\t        cur = node.next.as_deref();\n1318\t    }\n1319\t\n1320\t    if items.is_empty() {\n1321\t        evaluated.type_ = ObjectType::Nil;\n1322\t        evaluated.value = ObjectValue::IntValue(0);\n1323\t        return;\n1324\t    }\n1325\t\n1326\t    // Build cons cells\n1327\t    let mut head: Option<Box<ConsCell>> = None;\n1328\t    for item in items.into_iter().rev() {\n1329\t        let cdr_obj = match head {\n1330\t            None => Object {\n1331\t                marked: false,\n1332\t                type_: ObjectType::Nil,\n1333\t                value: ObjectValue::IntValue(0),\n1334\t            },\n1335\t            Some(cell) => Object {\n1336\t                marked: false,\n1337\t                type_: ObjectType::List,\n1338\t                value: ObjectValue::ListValue(Some(cell)),\n1339\t            },\n1340\t        };\n1341\t        let cell_type = if matches!(cdr_obj.type_, ObjectType::Nil) {\n1342\t            ConsCellType::Nil\n1343\t        } else {\n1344\t            ConsCellType::Cell\n1345\t        };\n1346\t        head = Some(Box::new(ConsCell {\n1347\t            type_: cell_type,\n1348\t            car: Some(Box::new(item)),\n1349\t            cdr: Some(Box::new(cdr_obj)),\n1350\t        }));\n1351\t    }\n1352\t\n1353\t    evaluated.type_ = ObjectType::List;\n1354\t    evaluated.value = ObjectValue::ListValue(head);\n1355\t}\n1356\t\n1357\tfn get_nth_expr<'a>(\n1358\t    list: Option<&'a ExpressionList>,\n1359\t    n: usize,\n1360\t) -> Option<&'a ExpressionNode> {\n1361\t    let mut cur = list;\n1362\t    let mut i = 0usize;\n1363\t    while let Some(node) = cur {\n1364\t        if i == n {\n1365\t            return node.expression.as_deref();\n1366\t        }\n1367\t        i += 1;\n1368\t        cur = node.next.as_deref();\n1369\t    }\n1370\t    None\n1371\t}\n1372\t\n1373\tfn evaluate_symbolic_expression(\n1374\t    expression: &ExpressionNode,\n1375\t    evaluated: &mut Object,\n1376\t    env: &mut Env,\n1377\t    context: &mut AllocatorContext,\n1378\t) {\n1379\t    // Get the inner expression list, prefer SymbolicExp variant; some C code reads .list,\n1380\t    // but at this point the type tag is EXP_SYMBOLIC_EXP; the C union shares storage.\n1381\t    let expressions_opt: Option<&ExpressionList> = match &expression.data {\n1382\t        ExpressionData::SymbolicExp(Some(s)) => s.expressions.as_deref(),\n1383\t        ExpressionData::List(Some(l)) => l.expressions.as_deref(),\n1384\t        _ => None,\n1385\t    };\n1386\t\n1387\t    let expressions = match expressions_opt {\n1388\t        Some(e) => e,\n1389\t        None => {\n1390\t            evaluated.type_ = ObjectType::Nil;\n1391\t            evaluated.value = ObjectValue::IntValue(0);\n1392\t            return;\n1393\t        }\n1394\t    };\n1395\t\n1396\t    let head_expr = match &expressions.expression {\n1397\t        Some(e) => e.as_ref(),\n1398\t        None => {\n1399\t            evaluated.type_ = ObjectType::Nil;\n1400\t            evaluated.value = ObjectValue::IntValue(0);\n1401\t            return;\n1402\t        }\n1403\t    };\n1404\t\n1405\t    let symbol_name = match (&head_expr.type_, &head_expr.data) {\n1406\t        (ExpressionType::Symbol, ExpressionData::Symbol(Some(sym))) => sym.symbol_name.clone(),\n1407\t        _ => {\n1408\t            eprintln!(\"S-exp must be started with symbol.\");\n1409\t            std::process::exit(1);\n1410\t        }\n1411\t    };\n1412\t\n1413\t    match symbol_name.as_str() {\n1414\t        \"if\" => {\n1415\t            let cond = match get_nth_expr(Some(expressions), 1) {\n1416\t                Some(c) => c.clone(),\n1417\t                None => {\n1418\t                    eprintln!(\"if must have condition.\");\n1419\t                    std::process::exit(1);\n1420\t                }\n1421\t            };\n1422\t            let then_expr = match get_nth_expr(Some(expressions), 2) {\n1423\t                Some(t) => t.clone(),\n1424\t                None => {\n1425\t                    eprintln!(\"if must have then clause.\");\n1426\t                    std::process::exit(1);\n1427\t                }\n1428\t            };\n1429\t            let mut cond_obj = empty_object();\n1430\t            evaluate_expression(&cond, &mut cond_obj, env, context);\n1431\t            if bool_val(&cond_obj) {\n1432\t                evaluate_expression(&then_expr, evaluated, env, context);\n1433\t            } else if let Some(else_expr) = get_nth_expr(Some(expressions), 3) {\n1434\t                let else_clone = else_expr.clone();\n1435\t                evaluate_expression(&else_clone, evaluated, env, context);\n1436\t            } else {\n1437\t                evaluated.type_ = ObjectType::Nil;\n1438\t                evaluated.value = ObjectValue::IntValue(0);\n1439\t            }\n1440\t        }\n1441\t        \"while\" => {\n1442\t            let cond = match get_nth_expr(Some(expressions), 1) {\n1443\t                Some(c) => c.clone(),\n1444\t                None => {\n1445\t                    eprintln!(\"while must have condition.\");\n1446\t                    std::process::exit(1);\n1447\t                }\n1448\t            };\n1449\t            let body = match get_nth_expr(Some(expressions), 2) {\n1450\t                Some(t) => t.clone(),\n1451\t                None => {\n1452\t                    eprintln!(\"while must have body.\");\n1453\t                    std::process::exit(1);\n1454\t                }\n1455\t            };\n1456\t            loop {\n1457\t                let mut cond_obj = empty_object();\n1458\t                evaluate_expression(&cond, &mut cond_obj, env, context);\n1459\t                if bool_val(&cond_obj) {\n1460\t                    evaluate_expression(&body, evaluated, env, context);\n1461\t                } else {\n1462\t                    evaluated.type_ = ObjectType::Nil;\n1463\t                    evaluated.value = ObjectValue::IntValue(0);\n1464\t                    break;\n1465\t                }\n1466\t            }\n1467\t        }\n1468\t        \"=\" => {\n1469\t            let symbol_expr = match get_nth_expr(Some(expressions), 1) {\n1470\t                Some(e) => e,\n1471\t                None => {\n1472\t                    eprintln!(\"assignment must have variable name.\");\n1473\t                    std::process::exit(1);\n1474\t                }\n1475\t            };\n1476\t            let var_name = match (&symbol_expr.type_, &symbol_expr.data) {\n1477\t                (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => s.symbol_name.clone(),\n1478\t                _ => {\n1479\t                    eprintln!(\"Variable name must be symbol.\");\n1480\t                    std::process::exit(1);\n1481\t                }\n1482\t            };\n1483\t            let value_expr = match get_nth_expr(Some(expressions), 2) {\n1484\t                Some(e) => e.clone(),\n1485\t                None => {\n1486\t                    eprintln!(\"assignment must have expression.\");\n1487\t                    std::process::exit(1);\n1488\t                }\n1489\t            };\n1490\t            let mut val_obj = empty_object();\n1491\t            evaluate_expression(&value_expr, &mut val_obj, env, context);\n1492\t            *evaluated = val_obj.clone();\n1493\t            set_object_to_env(env, &var_name, val_obj);\n1494\t        }\n1495\t        \"defun\" => {\n1496\t            let name_expr = match get_nth_expr(Some(expressions), 1) {\n1497\t                Some(e) => e,\n1498\t                None => {\n1499\t                    eprintln!(\"Function must have a name.\");\n1500\t                    std::process::exit(1);\n1501\t                }\n1502\t            };\n1503\t            let fn_name = match (&name_expr.type_, &name_expr.data) {\n1504\t                (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => s.symbol_name.clone(),\n1505\t                _ => {\n1506\t                    eprintln!(\"Function name must be symbol.\");\n1507\t                    std::process::exit(1);\n1508\t                }\n1509\t            };\n1510\t            let params_expr = match get_nth_expr(Some(expressions), 2) {\n1511\t                Some(e) => e,\n1512\t                None => {\n1513\t                    eprintln!(\"Function must have parameter.\");\n1514\t                    std::process::exit(1);\n1515\t                }\n1516\t            };\n1517\t            let params_list = match (&params_expr.type_, &params_expr.data) {\n1518\t                (ExpressionType::SymbolicExp, ExpressionData::SymbolicExp(Some(se))) => {\n1519\t                    se.expressions.as_deref()\n1520\t                }\n1521\t                _ => {\n1522\t                    eprintln!(\"Function parameter must be list.\");\n1523\t                    std::process::exit(1);\n1524\t                }\n1525\t            };\n1526\t            let mut param_names: Vec<String> = Vec::new();\n1527\t            let mut cur = params_list;\n1528\t            while let Some(node) = cur {\n1529\t                if let Some(e) = &node.expression {\n1530\t                    match (&e.type_, &e.data) {\n1531\t                        (ExpressionType::Symbol, ExpressionData::Symbol(Some(sym))) => {\n1532\t                            param_names.push(sym.symbol_name.clone());\n1533\t                        }\n1534\t                        _ => {\n1535\t                            eprintln!(\"Function parameter must be symbol.\");\n1536\t                            std::process::exit(1);\n1537\t                        }\n1538\t                    }\n1539\t                }\n1540\t                cur = node.next.as_deref();\n1541\t            }\n1542\t\n1543\t            let body_expr = match get_nth_expr(Some(expressions), 3) {\n1544\t                Some(b) => b.clone(),\n1545\t                None => {\n1546\t                    eprintln!(\"Function must have body.\");\n1547\t                    std::process::exit(1);\n1548\t                }\n1549\t            };\n1550\t\n1551\t            let func = Function {\n1552\t                param_symbol_names: param_names,\n1553\t                body: Some(Box::new(body_expr)),\n1554\t            };\n1555\t            evaluated.type_ = ObjectType::Function;\n1556\t            evaluated.value = ObjectValue::FunctionValue(Some(Box::new(func)));\n1557\t\n1558\t            set_object_to_env(env, &fn_name, evaluated.clone());\n1559\t        }\n1560\t        \"+\" => {\n1561\t            let a = eval_nth(expressions, 1, env, context);\n1562\t            let b = eval_nth(expressions, 2, env, context);\n1563\t            defined_add(&a, &b, evaluated);\n1564\t        }\n1565\t        \"-\" => {\n1566\t            let a = eval_nth(expressions, 1, env, context);\n1567\t            let b = eval_nth(expressions, 2, env, context);\n1568\t            defined_sub(&a, &b, evaluated);\n1569\t        }\n1570\t        \"*\" => {\n1571\t            let a = eval_nth(expressions, 1, env, context);\n1572\t            let b = eval_nth(expressions, 2, env, context);\n1573\t            defined_mul(&a, &b, evaluated);\n1574\t        }\n1575\t        \"/\" => {\n1576\t            let a = eval_nth(expressions, 1, env, context);\n1577\t            let b = eval_nth(expressions, 2, env, context);\n1578\t            defined_div(&a, &b, evaluated);\n1579\t        }\n1580\t        \"%\" => {\n1581\t            let a = eval_nth(expressions, 1, env, context);\n1582\t            let b = eval_nth(expressions, 2, env, context);\n1583\t            defined_mod(&a, &b, evaluated);\n1584\t        }\n1585\t        \"||\" => {\n1586\t            // short circuit OR\n1587\t            let mut cur = expressions.next.as_deref();\n1588\t            while let Some(node) = cur {\n1589\t                if let Some(e) = &node.expression {\n1590\t                    let expr_clone = (**e).clone();\n1591\t                    let mut operand = empty_object();\n1592\t                    evaluate_expression(&expr_clone, &mut operand, env, context);\n1593\t                    if bool_val(&operand) {\n1594\t                        evaluated.type_ = ObjectType::Bool;\n1595\t                        evaluated.value = ObjectValue::BoolValue(1);\n1596\t                        return;\n1597\t                    }\n1598\t                }\n1599\t                cur = node.next.as_deref();\n1600\t            }\n1601\t            evaluated.type_ = ObjectType::Bool;\n1602\t            evaluated.value = ObjectValue::BoolValue(0);\n1603\t        }\n1604\t        \"&&\" => {\n1605\t            let mut cur = expressions.next.as_deref();\n1606\t            while let Some(node) = cur {\n1607\t                if let Some(e) = &node.expression {\n1608\t                    let expr_clone = (**e).clone();\n1609\t                    let mut operand = empty_object();\n1610\t                    evaluate_expression(&expr_clone, &mut operand, env, context);\n1611\t                    if !bool_val(&operand) {\n1612\t                        evaluated.type_ = ObjectType::Bool;\n1613\t                        evaluated.value = ObjectValue::BoolValue(0);\n1614\t                        return;\n1615\t                    }\n1616\t                }\n1617\t                cur = node.next.as_deref();\n1618\t            }\n1619\t            evaluated.type_ = ObjectType::Bool;\n1620\t            evaluated.value = ObjectValue::BoolValue(1);\n1621\t        }\n1622\t        \"<\" => {\n1623\t            let a = eval_nth(expressions, 1, env, context);\n1624\t            let b = eval_nth(expressions, 2, env, context);\n1625\t            defined_lt(&a, &b, evaluated);\n1626\t        }\n1627\t        \">\" => {\n1628\t            let a = eval_nth(expressions, 1, env, context);\n1629\t            let b = eval_nth(expressions, 2, env, context);\n1630\t            defined_gt(&a, &b, evaluated);\n1631\t        }\n1632\t        \"eq\" => {\n1633\t            let a = eval_nth(expressions, 1, env, context);\n1634\t            let b = eval_nth(expressions, 2, env, context);\n1635\t            defined_eq(&a, &b, evaluated);\n1636\t        }\n1637\t        \"not\" => {\n1638\t            let a = eval_nth(expressions, 1, env, context);\n1639\t            defined_not(&a, evaluated);\n1640\t        }\n1641\t        \"print\" => {\n1642\t            let a = eval_nth(expressions, 1, env, context);\n1643\t            let s = stringify_object(&a);\n1644\t            println!(\"{}\", s);\n1645\t            evaluated.type_ = ObjectType::Nil;\n1646\t            evaluated.value = ObjectValue::IntValue(0);\n1647\t        }\n1648\t        \"car\" => {\n1649\t            let a = eval_nth(expressions, 1, env, context);\n1650\t            defined_car(&a, evaluated);\n1651\t        }\n1652\t        \"cdr\" => {\n1653\t            let a = eval_nth(expressions, 1, env, context);\n1654\t            defined_cdr(&a, evaluated);\n1655\t        }\n1656\t        \"cons\" => {\n1657\t            let a = eval_nth(expressions, 1, env, context);\n1658\t            let b = eval_nth(expressions, 2, env, context);\n1659\t            defined_cons(&a, &b, evaluated);\n1660\t        }\n1661\t        \"readline\" => {\n1662\t            use std::io::BufRead;\n1663\t            let stdin = std::io::stdin();\n1664\t            let mut buf = String::new();\n1665\t            match stdin.lock().read_line(&mut buf) {\n1666\t                Ok(0) => {\n1667\t                    evaluated.type_ = ObjectType::Nil;\n1668\t                    evaluated.value = ObjectValue::IntValue(0);\n1669\t                }\n1670\t                Ok(_) => {\n1671\t                    if buf.ends_with('\\n') {\n1672\t                        buf.pop();\n1673\t                        if buf.ends_with('\\r') {\n1674\t                            buf.pop();\n1675\t                        }\n1676\t                    }\n1677\t                    evaluated.type_ = ObjectType::String;\n1678\t                    evaluated.value = ObjectValue::StringValue(buf);\n1679\t                }\n1680\t                Err(_) => {\n1681\t                    evaluated.type_ = ObjectType::Nil;\n1682\t                    evaluated.value = ObjectValue::IntValue(0);\n1683\t                }\n1684\t            }\n1685\t        }\n1686\t        \"split\" => {\n1687\t            let a = eval_nth(expressions, 1, env, context);\n1688\t            let b = eval_nth(expressions, 2, env, context);\n1689\t            defined_split(&a, &b, evaluated);\n1690\t        }\n1691\t        \"list-ref\" => {\n1692\t            let a = eval_nth(expressions, 1, env, context);\n1693\t            let b = eval_nth(expressions, 2, env, context);\n1694\t            defined_list_ref(&a, &b, evaluated);\n1695\t        }\n1696\t        \"progn\" => {\n1697\t            let mut cur = expressions.next.as_deref();\n1698\t            let mut last = empty_object();\n1699\t            let mut had_any = false;\n1700\t            while let Some(node) = cur {\n1701\t                if let Some(e) = &node.expression {\n1702\t                    let expr_clone = (**e).clone();\n1703\t                    let mut operand = empty_object();\n1704\t                    evaluate_expression(&expr_clone, &mut operand, env, context);\n1705\t                    last = operand;\n1706\t                    had_any = true;\n1707\t                }\n1708\t                cur = node.next.as_deref();\n1709\t            }\n1710\t            if had_any {\n1711\t                *evaluated = last;\n1712\t            } else {\n1713\t                evaluated.type_ = ObjectType::Nil;\n1714\t                evaluated.value = ObjectValue::IntValue(0);\n1715\t            }\n1716\t        }\n1717\t        \"remove-whitespaces\" => {\n1718\t            let a = eval_nth(expressions, 1, env, context);\n1719\t            defined_remove_whitespaces(&a, evaluated);\n1720\t        }\n1721\t        \"pop\" => {\n1722\t            let a = eval_nth(expressions, 1, env, context);\n1723\t            let lst_name: Option<String> = match get_nth_expr(Some(expressions), 1) {\n1724\t                Some(e) => match (&e.type_, &e.data) {\n1725\t                    (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => {\n1726\t                        Some(s.symbol_name.clone())\n1727\t                    }\n1728\t                    _ => None,\n1729\t                },\n1730\t                None => None,\n1731\t            };\n1732\t            pop_op(a, evaluated, env, lst_name);\n1733\t        }\n1734\t        \"push\" => {\n1735\t            // (push lst val): the C version mutates the binding's list in place.\n1736\t            // We replicate that here by building a new list and rebinding it.\n1737\t            let val = eval_nth(expressions, 2, env, context);\n1738\t            let lst = eval_nth(expressions, 1, env, context);\n1739\t            // Determine if first argument is a symbol that we can rebind.\n1740\t            let lst_name: Option<String> = match get_nth_expr(Some(expressions), 1) {\n1741\t                Some(e) => match (&e.type_, &e.data) {\n1742\t                    (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => {\n1743\t                        Some(s.symbol_name.clone())\n1744\t                    }\n1745\t                    _ => None,\n1746\t                },\n1747\t                None => None,\n1748\t            };\n1749\t            push_op(&lst, &val, evaluated, env, lst_name);\n1750\t        }\n1751\t        \"length\" => {\n1752\t            let a = eval_nth(expressions, 1, env, context);\n1753\t            defined_length(&a, evaluated);\n1754\t        }\n1755\t        \"is-int-string\" => {\n1756\t            let a = eval_nth(expressions, 1, env, context);\n1757\t            defined_is_int_string(&a, evaluated);\n1758\t        }\n1759\t        \"parse-int\" => {\n1760\t            let a = eval_nth(expressions, 1, env, context);\n1761\t            defined_parse_int(&a, evaluated);\n1762\t        }\n1763\t        \"string-ref\" => {\n1764\t            let a = eval_nth(expressions, 1, env, context);\n1765\t            let b = eval_nth(expressions, 2, env, context);\n1766\t            defined_string_ref(&a, &b, evaluated);\n1767\t        }\n1768\t        _ => {\n1769\t            // user-defined function call\n1770\t            if let Some(func_obj) = lookup_in_env(env, &symbol_name) {\n1771\t                if let ObjectValue::FunctionValue(Some(func)) = &func_obj.value {\n1772\t                    // Build new env\n1773\t                    let mut new_env = empty_env();\n1774\t                    new_env.parent = Some(Box::new(env.clone()));\n1775\t\n1776\t                    // Bind parameters\n1777\t                    let mut cur = expressions.next.as_deref();\n1778\t                    for pname in &func.param_symbol_names {\n1779\t                        let arg_expr_opt = cur.and_then(|n| n.expression.as_deref());\n1780\t                        if let Some(arg_expr) = arg_expr_opt {\n1781\t                            let arg_clone = arg_expr.clone();\n1782\t                            let mut param_val = empty_object();\n1783\t                            evaluate_expression(&arg_clone, &mut param_val, env, context);\n1784\t                            set_object_to_env(&mut new_env, pname, param_val);\n1785\t                        }\n1786\t                        cur = cur.and_then(|n| n.next.as_deref());\n1787\t                    }\n1788\t\n1789\t                    if let Some(body) = &func.body {\n1790\t                        let body_clone = (**body).clone();\n1791\t                        evaluate_expression(&body_clone, evaluated, &mut new_env, context);\n1792\t                    }\n1793\t                    return;\n1794\t                }\n1795\t            }\n1796\t            eprintln!(\"Undefined function: {}\", symbol_name);\n1797\t            std::process::exit(1);\n1798\t        }\n1799\t    }\n1800\t}\n1801\t\n1802\tfn eval_nth(\n1803\t    expressions: &ExpressionList,\n1804\t    n: usize,\n1805\t    env: &mut Env,\n1806\t    context: &mut AllocatorContext,\n1807\t) -> Object {\n1808\t    let mut result = empty_object();\n1809\t    if let Some(expr) = get_nth_expr(Some(expressions), n) {\n1810\t        let expr_clone = expr.clone();\n1811\t        evaluate_expression(&expr_clone, &mut result, env, context);\n1812\t    }\n1813\t    result\n1814\t}\n1815\t\n1816\tfn pop_op(mut lst: Object, evaluated: &mut Object, env: &mut Env, lst_name: Option<String>) {\n1817\t    if matches!(lst.type_, ObjectType::Nil) {\n1818\t        evaluated.type_ = ObjectType::Nil;\n1819\t        evaluated.value = ObjectValue::IntValue(0);\n1820\t        return;\n1821\t    }\n1822\t    if !matches!(lst.type_, ObjectType::List) {\n1823\t        eprintln!(\"Type error: pop operand must be list.\");\n1824\t        std::process::exit(1);\n1825\t    }\n1826\t\n1827\t    // Walk to the last cons cell and capture the last value, then truncate.\n1828\t    let popped: Option<Object>;\n1829\t    let became_empty: bool;\n1830\t    if let ObjectValue::ListValue(Some(head_cell)) = &mut lst.value {\n1831\t        // Single element list?\n1832\t        if matches!(\n1833\t            head_cell.cdr.as_deref().map(|o| o.type_),\n1834\t            Some(ObjectType::Nil) | None\n1835\t        ) {\n1836\t            popped = head_cell.car.as_deref().cloned();\n1837\t            became_empty = true;\n1838\t        } else {\n1839\t            // Walk to the second-to-last cell\n1840\t            became_empty = false;\n1841\t            popped = pop_walk(head_cell.as_mut());\n1842\t        }\n1843\t    } else {\n1844\t        evaluated.type_ = ObjectType::Nil;\n1845\t        evaluated.value = ObjectValue::IntValue(0);\n1846\t        return;\n1847\t    }\n1848\t\n1849\t    if let Some(p) = popped {\n1850\t        *evaluated = p;\n1851\t    } else {\n1852\t        evaluated.type_ = ObjectType::Nil;\n1853\t        evaluated.value = ObjectValue::IntValue(0);\n1854\t    }\n1855\t\n1856\t    if let Some(name) = lst_name {\n1857\t        if became_empty {\n1858\t            // Set binding to nil\n1859\t            set_object_to_env(\n1860\t                env,\n1861\t                &name,\n1862\t                Object {\n1863\t                    marked: false,\n1864\t                    type_: ObjectType::Nil,\n1865\t                    value: ObjectValue::IntValue(0),\n1866\t                },\n1867\t            );\n1868\t        } else {\n1869\t            set_object_to_env(env, &name, lst);\n1870\t        }\n1871\t    }\n1872\t}\n1873\t\n1874\tfn pop_walk(head: &mut ConsCell) -> Option<Object> {\n1875\t    // Walk until cdr.list_value's cdr is nil. Then truncate.\n1876\t    let mut current: &mut ConsCell = head;\n1877\t    loop {\n1878\t        // Check if next cell is the last\n1879\t        let next_is_last: bool = match &current.cdr {\n1880\t            Some(o) => match &o.value {\n1881\t                ObjectValue::ListValue(Some(next_cell)) => match &next_cell.cdr {\n1882\t                    Some(c) => matches!(c.type_, ObjectType::Nil),\n1883\t                    None => true,\n1884\t                },\n1885\t                _ => false,\n1886\t            },\n1887\t            None => false,\n1888\t        };\n1889\t        if next_is_last {\n1890\t            // popped value is from current.cdr.list_value.car\n1891\t            if let Some(cdr) = current.cdr.as_mut() {\n1892\t                if let ObjectValue::ListValue(Some(next_cell)) = &mut cdr.value {\n1893\t                    let popped = next_cell.car.as_deref().cloned();\n1894\t                    // Truncate: replace current.cdr with nil\n1895\t                    current.cdr = Some(Box::new(Object {\n1896\t                        marked: false,\n1897\t                        type_: ObjectType::Nil,\n1898\t                        value: ObjectValue::IntValue(0),\n1899\t                    }));\n1900\t                    current.type_ = ConsCellType::Nil;\n1901\t                    return popped;\n1902\t                }\n1903\t            }\n1904\t            return None;\n1905\t        }\n1906\t        // Move forward\n1907\t        let cdr_box = match current.cdr.as_mut() {\n1908\t            Some(c) => c,\n1909\t            None => return None,\n1910\t        };\n1911\t        if let ObjectValue::ListValue(Some(next_cell)) = &mut cdr_box.value {\n1912\t            current = next_cell.as_mut();\n1913\t        } else {\n1914\t            return None;\n1915\t        }\n1916\t    }\n1917\t}\n1918\t\n1919\tfn push_op(\n1920\t    lst: &Object,\n1921\t    val: &Object,\n1922\t    evaluated: &mut Object,\n1923\t    env: &mut Env,\n1924\t    lst_name: Option<String>,\n1925\t) {\n1926\t    if matches!(lst.type_, ObjectType::Nil) {\n1927\t        // Replace binding's nil with a singleton list containing val.\n1928\t        if let Some(name) = lst_name {\n1929\t            let new_cell = ConsCell {\n1930\t                type_: ConsCellType::Cell,\n1931\t                car: Some(Box::new(val.clone())),\n1932\t                cdr: Some(Box::new(Object {\n1933\t                    marked: false,\n1934\t                    type_: ObjectType::Nil,\n1935\t                    value: ObjectValue::IntValue(0),\n1936\t                })),\n1937\t            };\n1938\t            let new_list = Object {\n1939\t                marked: false,\n1940\t                type_: ObjectType::List,\n1941\t                value: ObjectValue::ListValue(Some(Box::new(new_cell))),\n1942\t            };\n1943\t            set_object_to_env(env, &name, new_list);\n1944\t        }\n1945\t        *evaluated = val.clone();\n1946\t        return;\n1947\t    }\n1948\t\n1949\t    if !matches!(lst.type_, ObjectType::List) {\n1950\t        eprintln!(\"Type error: push second operand must be list.\");\n1951\t        std::process::exit(1);\n1952\t    }\n1953\t\n1954\t    // Build new list with val appended\n1955\t    let mut new_list = lst.clone();\n1956\t    append_to_list(&mut new_list, val.clone());\n1957\t    if let Some(name) = lst_name {\n1958\t        set_object_to_env(env, &name, new_list);\n1959\t    }\n1960\t    *evaluated = val.clone();\n1961\t}\n1962\t\n1963\tfn append_to_list(list_obj: &mut Object, val: Object) {\n1964\t    if let ObjectValue::ListValue(Some(cell)) = &mut list_obj.value {\n1965\t        let mut current: &mut ConsCell = cell.as_mut();\n1966\t        loop {\n1967\t            let is_last = match &current.cdr {\n1968\t                Some(c) => matches!(c.type_, ObjectType::Nil),\n1969\t                None => true,\n1970\t            };\n1971\t            if is_last {\n1972\t                let new_cell = ConsCell {\n1973\t                    type_: ConsCellType::Cell,\n1974\t                    car: Some(Box::new(val)),\n1975\t                    cdr: Some(Box::new(Object {\n1976\t                        marked: false,\n1977\t                        type_: ObjectType::Nil,\n1978\t                        value: ObjectValue::IntValue(0),\n1979\t                    })),\n1980\t                };\n1981\t                let cdr_obj = Object {\n1982\t                    marked: false,\n1983\t                    type_: ObjectType::List,\n1984\t                    value: ObjectValue::ListValue(Some(Box::new(new_cell))),\n1985\t                };\n1986\t                current.cdr = Some(Box::new(cdr_obj));\n1987\t                current.type_ = ConsCellType::Cell;\n1988\t                return;\n1989\t            }\n1990\t            // move forward\n1991\t            let cdr_box = current.cdr.as_mut().unwrap();\n1992\t            if let ObjectValue::ListValue(Some(next_cell)) = &mut cdr_box.value {\n1993\t                current = next_cell.as_mut();\n1994\t            } else {\n1995\t                return;\n1996\t            }\n1997\t        }\n1998\t    }\n1999\t}\n2000\t\n2001\tpub fn evaluate_expression(\n2002\t    expression: &ExpressionNode,\n2003\t    result: &mut Object,\n2004\t    env: &mut Env,\n2005\t    context: &mut AllocatorContext,\n2006\t) {\n2007\t    match expression.type_ {\n2008\t        ExpressionType::List => evaluate_list_expression(expression, result, env, context),\n2009\t        ExpressionType::SymbolicExp => evaluate_symbolic_expression(expression, result, env, context),\n2010\t        ExpressionType::Literal => evaluate_literal_expression(expression, result),\n2011\t        ExpressionType::Symbol => evaluate_symbol_expression(expression, result, env),\n2012\t    }\n2013\t}\n2014\t\n2015\tpub fn evaluate_expression_with_context(\n2016\t    expression: &ExpressionNode,\n2017\t    result: &mut Object,\n2018\t    env: &mut Env,\n2019\t) {\n2020\t    let mut context = init_allocator();\n2021\t    evaluate_expression(expression, result, env, &mut context);\n2022\t}\n2023\t\n2024\tpub fn evaluate(result: &mut ParseResult) {\n2025\t    if let Some(program) = &result.program {\n2026\t        let mut env = empty_env();\n2027\t        let mut context = init_allocator();\n2028\t        let mut cur = program.expressions.as_deref();\n2029\t        while let Some(node) = cur {\n2030\t            if let Some(expr) = &node.expression {\n2031\t                let expr_clone = (**expr).clone();\n2032\t                let mut evaluated = empty_object();\n2033\t                evaluate_expression(&expr_clone, &mut evaluated, &mut env, &mut context);\n2034\t            }\n2035\t            cur = node.next.as_deref();\n2036\t        }\n2037\t    }\n2038\t}\n2039\t\n2040\tpub fn init_env(env: &mut Env) {\n2041\t    env.parent = None;\n2042\t    for i in 0..MAX_BINDINGS {\n2043\t        env.bindings[i].symbol_name = String::new();\n2044\t        env.bindings[i].value = None;\n2045\t    }\n2046\t}\n2047\t\n2048\tpub fn init_allocator() -> AllocatorContext {\n2049\t    let stack_objects: [Option<Box<Object>>; OBJECT_NUMBER] = std::array::from_fn(|_| None);\n2050\t    AllocatorContext {\n2051\t        gc_less_mode: 0,\n2052\t        stack: Some(Box::new(ObjectStack {\n2053\t            objects: stack_objects,\n2054\t            top: -1,\n2055\t        })),\n2056\t        memory_pool: None,\n2057\t        free_bitmap: [0u8; FREE_BITMAP_SIZE],\n2058\t    }\n2059\t}\n2060\t\n2061\tpub fn allocate(_context: &mut AllocatorContext, _env: &mut Env) -> Option<Box<Object>> {\n2062\t    Some(Box::new(empty_object()))\n2063\t}\n2064\t"}]},"parent_tool_use_id":null,"session_id":"6c5ab712-76b5-4ea1-a124-e66022bb7542","uuid":"1b71a295-eb4d-4778-8b82-7ec15c6053ab","timestamp":"2026-05-29T19:46:39.887Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-DtFFAZ/project/src/worsp.rs","content":"pub const OBJECT_NUMBER: usize = 50;\npub const BLOCK_SIZE: usize = std::mem::size_of::<Object>();\npub const MEMORY_SIZE: usize = BLOCK_SIZE * OBJECT_NUMBER;\npub const FREE_BITMAP_SIZE: usize = MEMORY_SIZE / BLOCK_SIZE;\npub const MAX_BINDINGS: usize = 10;\npub const MAX_SYMBOL_NAME_LENGTH: usize = 20;\n#[derive(Debug, Clone, Copy)]\npub enum ConsCellType {\nCell,\nNil,\n}\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum TokenKind {\n    Digit,\n    LParen,\n    RParen,\n    Symbol,\n    String,\n    True,\n    False,\n    Eof,\n    Quote,\n}\n#[derive(Debug)]\npub struct Token {\npub kind: TokenKind,\npub next: Option<Box<Token>>,\npub val: i32,\npub str: String,\n}\n#[derive(Debug)]\npub struct ParseState {\npub token: Option<Box<Token>>,\npub pos: i32,\n}\n#[derive(Debug)]\npub struct ProgramNode {\npub expressions: Option<Box<ExpressionList>>,\n}\n#[derive(Debug, Clone, Copy)]\npub enum ExpressionType {\nLiteral,\nSymbol,\nList,\nSymbolicExp,\n}\n#[derive(Debug)]\npub struct ExpressionList {\npub expression: Option<Box<ExpressionNode>>,\npub next: Option<Box<ExpressionList>>,\n}\n#[derive(Debug)]\npub struct ExpressionNode {\npub type_: ExpressionType,\npub data: ExpressionData,\n}\n#[derive(Debug)]\npub enum ExpressionData {\nSymbolicExp(Option<Box<SymbolicExpNode>>),\nList(Option<Box<ListNode>>),\nLiteral(Option<Box<LiteralNode>>),\nSymbol(Option<Box<SymbolNode>>),\n}\n#[derive(Debug)]\npub struct SymbolicExpNode {\npub expressions: Option<Box<ExpressionList>>,\n}\n#[derive(Debug)]\npub struct ListNode {\npub expressions: Option<Box<ExpressionList>>,\n}\n#[derive(Debug, Clone, Copy)]\npub enum LiteralType {\nInteger,\nString,\nBoolean,\n}\n#[derive(Debug)]\npub struct LiteralNode {\npub type_: LiteralType,\npub value: LiteralValue,\n}\n#[derive(Debug)]\npub enum LiteralValue {\nIntValue(i32),\nBooleanValue(bool),\nStringValue(String),\n}\n#[derive(Debug)]\npub struct SymbolNode {\npub symbol_name: String,\n}\n#[derive(Debug)]\npub struct ParseResult {\npub program: Option<Box<ProgramNode>>,\n}\n#[derive(Debug, Clone, Copy)]\npub enum ObjectType {\nInteger,\nString,\nBool,\nList,\nNil,\nFunction,\n}\n#[derive(Debug)]\npub struct ConsCell {\npub type_: ConsCellType,\npub car: Option<Box<Object>>,\npub cdr: Option<Box<Object>>,\n}\n#[derive(Debug)]\npub struct Function {\npub param_symbol_names: Vec<String>,\npub body: Option<Box<ExpressionNode>>,\n}\n#[derive(Debug)]\npub struct Object {\npub marked: bool,\npub type_: ObjectType,\npub value: ObjectValue,\n}\n#[derive(Debug)]\npub enum ObjectValue {\nIntValue(i32),\nStringValue(String),\nBoolValue(i32),\nListValue(Option<Box<ConsCell>>),\nFunctionValue(Option<Box<Function>>),\n}\n#[derive(Debug)]\npub struct Binding {\npub symbol_name: String,\npub value: Option<Box<Object>>,\n}\n#[derive(Debug)]\npub struct Env {\npub bindings: [Binding; MAX_BINDINGS],\npub parent: Option<Box<Env>>,\n}\n#[derive(Debug)]\npub struct ObjectStack {\npub objects: [Option<Box<Object>>; OBJECT_NUMBER],\npub top: i32,\n}\n#[derive(Debug)]\npub struct AllocatorContext {\npub gc_less_mode: i32,\npub stack: Option<Box<ObjectStack>>,\npub memory_pool: Option<Box<Object>>,\npub free_bitmap: [u8; FREE_BITMAP_SIZE],\n}\n\n// =================================================\n//   Clone implementations\n// =================================================\n\nimpl Clone for Token {\n    fn clone(&self) -> Self {\n        Token {\n            kind: self.kind,\n            next: self.next.clone(),\n            val: self.val,\n            str: self.str.clone(),\n        }\n    }\n}\n\nimpl Clone for ExpressionList {\n    fn clone(&self) -> Self {\n        ExpressionList {\n            expression: self.expression.clone(),\n            next: self.next.clone(),\n        }\n    }\n}\n\nimpl Clone for ExpressionNode {\n    fn clone(&self) -> Self {\n        ExpressionNode {\n            type_: self.type_,\n            data: self.data.clone(),\n        }\n    }\n}\n\nimpl Clone for ExpressionData {\n    fn clone(&self) -> Self {\n        match self {\n            ExpressionData::SymbolicExp(inner) => ExpressionData::SymbolicExp(inner.clone()),\n            ExpressionData::List(inner) => ExpressionData::List(inner.clone()),\n            ExpressionData::Literal(inner) => ExpressionData::Literal(inner.clone()),\n            ExpressionData::Symbol(inner) => ExpressionData::Symbol(inner.clone()),\n        }\n    }\n}\n\nimpl Clone for SymbolicExpNode {\n    fn clone(&self) -> Self {\n        SymbolicExpNode { expressions: self.expressions.clone() }\n    }\n}\n\nimpl Clone for ListNode {\n    fn clone(&self) -> Self {\n        ListNode { expressions: self.expressions.clone() }\n    }\n}\n\nimpl Clone for LiteralNode {\n    fn clone(&self) -> Self {\n        LiteralNode {\n            type_: self.type_,\n            value: self.value.clone(),\n        }\n    }\n}\n\nimpl Clone for LiteralValue {\n    fn clone(&self) -> Self {\n        match self {\n            LiteralValue::IntValue(v) => LiteralValue::IntValue(*v),\n            LiteralValue::BooleanValue(v) => LiteralValue::BooleanValue(*v),\n            LiteralValue::StringValue(v) => LiteralValue::StringValue(v.clone()),\n        }\n    }\n}\n\nimpl Clone for SymbolNode {\n    fn clone(&self) -> Self {\n        SymbolNode { symbol_name: self.symbol_name.clone() }\n    }\n}\n\nimpl Clone for ConsCell {\n    fn clone(&self) -> Self {\n        ConsCell {\n            type_: self.type_,\n            car: self.car.clone(),\n            cdr: self.cdr.clone(),\n        }\n    }\n}\n\nimpl Clone for Function {\n    fn clone(&self) -> Self {\n        Function {\n            param_symbol_names: self.param_symbol_names.clone(),\n            body: self.body.clone(),\n        }\n    }\n}\n\nimpl Clone for Object {\n    fn clone(&self) -> Self {\n        Object {\n            marked: self.marked,\n            type_: self.type_,\n            value: self.value.clone(),\n        }\n    }\n}\n\nimpl Clone for ObjectValue {\n    fn clone(&self) -> Self {\n        match self {\n            ObjectValue::IntValue(v) => ObjectValue::IntValue(*v),\n            ObjectValue::StringValue(v) => ObjectValue::StringValue(v.clone()),\n            ObjectValue::BoolValue(v) => ObjectValue::BoolValue(*v),\n            ObjectValue::ListValue(v) => ObjectValue::ListValue(v.clone()),\n            ObjectValue::FunctionValue(v) => ObjectValue::FunctionValue(v.clone()),\n        }\n    }\n}\n\nimpl Clone for Binding {\n    fn clone(&self) -> Self {\n        Binding {\n            symbol_name: self.symbol_name.clone(),\n            value: self.value.clone(),\n        }\n    }\n}\n\nimpl Clone for Env {\n    fn clone(&self) -> Self {\n        Env {\n            bindings: std::array::from_fn(|i| self.bindings[i].clone()),\n            parent: self.parent.clone(),\n        }\n    }\n}\n\n// =================================================\n//   helpers\n// =================================================\n\nfn empty_binding() -> Binding {\n    Binding {\n        symbol_name: String::new(),\n        value: None,\n    }\n}\n\nfn empty_env() -> Env {\n    Env {\n        bindings: std::array::from_fn(|_| empty_binding()),\n        parent: None,\n    }\n}\n\nfn empty_object() -> Object {\n    Object {\n        marked: false,\n        type_: ObjectType::Nil,\n        value: ObjectValue::IntValue(0),\n    }\n}\n\nfn nil_object() -> Object {\n    Object {\n        marked: false,\n        type_: ObjectType::Nil,\n        value: ObjectValue::IntValue(0),\n    }\n}\n\nfn is_op_char(c: u8) -> bool {\n    matches!(\n        c,\n        b'+' | b'-' | b'*' | b'/' | b'%' | b'|' | b'&' | b'=' | b'<' | b'>'\n    )\n}\n\nfn is_alpha(c: u8) -> bool {\n    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')\n}\n\nfn is_digit(c: u8) -> bool {\n    c >= b'0' && c <= b'9'\n}\n\nfn is_alnum(c: u8) -> bool {\n    is_alpha(c) || is_digit(c)\n}\n\nfn is_space(c: u8) -> bool {\n    c == b' ' || c == b'\\t' || c == b'\\n' || c == b'\\r' || c == 0x0b || c == 0x0c\n}\n\n// =================================================\n//   tokenizer\n// =================================================\n\npub fn match_token(state: &mut ParseState, kind: TokenKind) -> i32 {\n    match &state.token {\n        Some(t) => {\n            if t.kind == kind {\n                1\n            } else {\n                0\n            }\n        }\n        None => 0,\n    }\n}\n\npub fn next(source: &str, state: &mut ParseState) {\n    let bytes = source.as_bytes();\n    let len = bytes.len() as i32;\n\n    // Skip whitespace\n    while state.pos < len {\n        let c = bytes[state.pos as usize];\n        if is_space(c) {\n            state.pos += 1;\n        } else {\n            break;\n        }\n    }\n\n    let new_token: Token;\n\n    if state.pos >= len {\n        new_token = Token {\n            kind: TokenKind::Eof,\n            next: None,\n            val: 0,\n            str: \"\\0\".to_string(),\n        };\n    } else {\n        let c = bytes[state.pos as usize];\n        if c == b'(' {\n            new_token = Token {\n                kind: TokenKind::LParen,\n                next: None,\n                val: 0,\n                str: \"(\".to_string(),\n            };\n            state.pos += 1;\n        } else if c == b')' {\n            new_token = Token {\n                kind: TokenKind::RParen,\n                next: None,\n                val: 0,\n                str: \")\".to_string(),\n            };\n            state.pos += 1;\n        } else if c == b'\\'' {\n            new_token = Token {\n                kind: TokenKind::Quote,\n                next: None,\n                val: 0,\n                str: \"'\".to_string(),\n            };\n            state.pos += 1;\n        } else if is_alpha(c) || is_op_char(c) {\n            let start = state.pos as usize;\n            while state.pos < len {\n                let cc = bytes[state.pos as usize];\n                if is_alnum(cc) || is_op_char(cc) {\n                    state.pos += 1;\n                } else {\n                    break;\n                }\n            }\n            let s = std::str::from_utf8(&bytes[start..state.pos as usize])\n                .unwrap_or(\"\")\n                .to_string();\n            if s == \"true\" {\n                new_token = Token {\n                    kind: TokenKind::True,\n                    next: None,\n                    val: 0,\n                    str: String::new(),\n                };\n            } else if s == \"false\" {\n                new_token = Token {\n                    kind: TokenKind::False,\n                    next: None,\n                    val: 0,\n                    str: String::new(),\n                };\n            } else {\n                new_token = Token {\n                    kind: TokenKind::Symbol,\n                    next: None,\n                    val: 0,\n                    str: s,\n                };\n            }\n        } else if is_digit(c) {\n            let start = state.pos as usize;\n            while state.pos < len && is_digit(bytes[state.pos as usize]) {\n                state.pos += 1;\n            }\n            let s = std::str::from_utf8(&bytes[start..state.pos as usize]).unwrap_or(\"0\");\n            let val: i32 = s.parse().unwrap_or(0);\n            new_token = Token {\n                kind: TokenKind::Digit,\n                next: None,\n                val,\n                str: String::new(),\n            };\n        } else if c == b'\"' {\n            state.pos += 1;\n            let start = state.pos as usize;\n            while state.pos < len && bytes[state.pos as usize] != b'\"' {\n                state.pos += 1;\n            }\n            let s = std::str::from_utf8(&bytes[start..state.pos as usize])\n                .unwrap_or(\"\")\n                .to_string();\n            if state.pos < len && bytes[state.pos as usize] == b'\"' {\n                state.pos += 1;\n            }\n            new_token = Token {\n                kind: TokenKind::String,\n                next: None,\n                val: 0,\n                str: s,\n            };\n        } else if c == b';' {\n            // comment to end of line\n            while state.pos < len && bytes[state.pos as usize] != b'\\n' {\n                state.pos += 1;\n            }\n            next(source, state);\n            return;\n        } else {\n            // unexpected character; mimic C exit but use panic for unrecoverable error\n            eprintln!(\"Unexpected token: {}\", c as char);\n            std::process::exit(1);\n        }\n    }\n\n    // Replace the current token (we don't need to maintain the linked list,\n    // since `state.token` is what is consulted for `match`).\n    state.token = Some(Box::new(new_token));\n}\n\n// =================================================\n//   parser\n// =================================================\n\nfn append_expression_to_list(list: &mut Option<Box<ExpressionList>>, expr: ExpressionNode) {\n    let new_node = Box::new(ExpressionList {\n        expression: Some(Box::new(expr)),\n        next: None,\n    });\n    if list.is_none() {\n        *list = Some(new_node);\n        return;\n    }\n    let mut cur: &mut ExpressionList = list.as_deref_mut().unwrap();\n    while cur.next.is_some() {\n        cur = cur.next.as_deref_mut().unwrap();\n    }\n    cur.next = Some(new_node);\n}\n\nfn parse_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n    if match_token(state, TokenKind::LParen) == 1 {\n        return parse_symbolic_expression(source, state);\n    } else if match_token(state, TokenKind::Quote) == 1 {\n        return parse_list_expression(source, state);\n    } else if match_token(state, TokenKind::Symbol) == 1 {\n        return parse_symbol_expression(source, state);\n    } else if match_token(state, TokenKind::Digit) == 1\n        || match_token(state, TokenKind::String) == 1\n        || match_token(state, TokenKind::True) == 1\n        || match_token(state, TokenKind::False) == 1\n    {\n        return parse_literal_expression(source, state);\n    } else {\n        let s = state\n            .token\n            .as_ref()\n            .map(|t| t.str.clone())\n            .unwrap_or_default();\n        eprintln!(\"Unexpected token: {}\", s);\n        std::process::exit(1);\n    }\n}\n\nfn parse_symbolic_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n    let mut sym_exp = SymbolicExpNode { expressions: None };\n    next(source, state); // eat '('\n    while match_token(state, TokenKind::RParen) != 1 {\n        let item = parse_expression(source, state);\n        append_expression_to_list(&mut sym_exp.expressions, item);\n    }\n    next(source, state); // eat ')'\n    ExpressionNode {\n        type_: ExpressionType::SymbolicExp,\n        data: ExpressionData::SymbolicExp(Some(Box::new(sym_exp))),\n    }\n}\n\nfn parse_list_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n    let mut list_node = ListNode { expressions: None };\n    next(source, state); // eat quote\n    next(source, state); // eat '('\n    while match_token(state, TokenKind::RParen) != 1 {\n        let item = parse_expression(source, state);\n        append_expression_to_list(&mut list_node.expressions, item);\n    }\n    next(source, state); // eat ')'\n    ExpressionNode {\n        type_: ExpressionType::List,\n        data: ExpressionData::List(Some(Box::new(list_node))),\n    }\n}\n\nfn parse_symbol_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n    let name = state\n        .token\n        .as_ref()\n        .map(|t| t.str.clone())\n        .unwrap_or_default();\n    next(source, state);\n    ExpressionNode {\n        type_: ExpressionType::Symbol,\n        data: ExpressionData::Symbol(Some(Box::new(SymbolNode { symbol_name: name }))),\n    }\n}\n\nfn parse_literal_expression(source: &str, state: &mut ParseState) -> ExpressionNode {\n    let lit_node = if match_token(state, TokenKind::Digit) == 1 {\n        let v = state.token.as_ref().map(|t| t.val).unwrap_or(0);\n        let node = LiteralNode {\n            type_: LiteralType::Integer,\n            value: LiteralValue::IntValue(v),\n        };\n        next(source, state);\n        node\n    } else if match_token(state, TokenKind::String) == 1 {\n        let s = state\n            .token\n            .as_ref()\n            .map(|t| t.str.clone())\n            .unwrap_or_default();\n        let node = LiteralNode {\n            type_: LiteralType::String,\n            value: LiteralValue::StringValue(s),\n        };\n        next(source, state);\n        node\n    } else if match_token(state, TokenKind::True) == 1 {\n        let node = LiteralNode {\n            type_: LiteralType::Boolean,\n            value: LiteralValue::BooleanValue(true),\n        };\n        next(source, state);\n        node\n    } else if match_token(state, TokenKind::False) == 1 {\n        let node = LiteralNode {\n            type_: LiteralType::Boolean,\n            value: LiteralValue::BooleanValue(false),\n        };\n        next(source, state);\n        node\n    } else {\n        let s = state\n            .token\n            .as_ref()\n            .map(|t| t.str.clone())\n            .unwrap_or_default();\n        eprintln!(\"Unexpected token: {}\", s);\n        std::process::exit(1);\n    };\n    ExpressionNode {\n        type_: ExpressionType::Literal,\n        data: ExpressionData::Literal(Some(Box::new(lit_node))),\n    }\n}\n\npub fn parse(source: &str, state: &mut ParseState, result: &mut ParseResult) {\n    next(source, state);\n    let mut program = ProgramNode { expressions: None };\n    while match_token(state, TokenKind::Eof) != 1 {\n        let expr = parse_expression(source, state);\n        append_expression_to_list(&mut program.expressions, expr);\n    }\n    result.program = Some(Box::new(program));\n}\n\n// =================================================\n//   object helpers\n// =================================================\n\nfn bool_val(obj: &Object) -> bool {\n    match obj.type_ {\n        ObjectType::Bool => match &obj.value {\n            ObjectValue::BoolValue(v) => *v != 0,\n            _ => false,\n        },\n        ObjectType::Nil => false,\n        _ => true,\n    }\n}\n\nfn obj_eq(op1: &Object, op2: &Object) -> bool {\n    let same_kind = matches!(\n        (op1.type_, op2.type_),\n        (ObjectType::Integer, ObjectType::Integer)\n            | (ObjectType::String, ObjectType::String)\n            | (ObjectType::Bool, ObjectType::Bool)\n            | (ObjectType::List, ObjectType::List)\n            | (ObjectType::Nil, ObjectType::Nil)\n            | (ObjectType::Function, ObjectType::Function)\n    );\n    if !same_kind {\n        return false;\n    }\n    match op1.type_ {\n        ObjectType::Integer => match (&op1.value, &op2.value) {\n            (ObjectValue::IntValue(a), ObjectValue::IntValue(b)) => a == b,\n            _ => false,\n        },\n        ObjectType::String => match (&op1.value, &op2.value) {\n            (ObjectValue::StringValue(a), ObjectValue::StringValue(b)) => a == b,\n            _ => false,\n        },\n        ObjectType::Bool => match (&op1.value, &op2.value) {\n            (ObjectValue::BoolValue(a), ObjectValue::BoolValue(b)) => a == b,\n            _ => false,\n        },\n        ObjectType::List => false, // C compares pointers; freshly built lists are never equal\n        ObjectType::Nil => true,\n        ObjectType::Function => false,\n    }\n}\n\nfn is_last_cons_cell(cell: &ConsCell) -> bool {\n    match &cell.cdr {\n        Some(o) => matches!(o.type_, ObjectType::Nil),\n        None => true,\n    }\n}\n\npub fn stringify_object(obj: &Object) -> String {\n    match obj.type_ {\n        ObjectType::Integer => match &obj.value {\n            ObjectValue::IntValue(v) => v.to_string(),\n            _ => \"0\".to_string(),\n        },\n        ObjectType::String => match &obj.value {\n            ObjectValue::StringValue(v) => v.clone(),\n            _ => String::new(),\n        },\n        ObjectType::Bool => match &obj.value {\n            ObjectValue::BoolValue(v) => {\n                if *v != 0 {\n                    \"T\".to_string()\n                } else {\n                    \"F\".to_string()\n                }\n            }\n            _ => \"F\".to_string(),\n        },\n        ObjectType::List => {\n            let mut s = String::from(\"(\");\n            if let ObjectValue::ListValue(Some(first)) = &obj.value {\n                let mut current: &ConsCell = first.as_ref();\n                loop {\n                    if let Some(car) = &current.car {\n                        s.push_str(&stringify_object(car));\n                    }\n                    if is_last_cons_cell(current) {\n                        break;\n                    }\n                    s.push(' ');\n                    // move to next cell via cdr\n                    if let Some(cdr) = &current.cdr {\n                        if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n                            current = next_cell.as_ref();\n                        } else {\n                            break;\n                        }\n                    } else {\n                        break;\n                    }\n                }\n            }\n            s.push(')');\n            s\n        }\n        ObjectType::Nil => \"nil\".to_string(),\n        ObjectType::Function => \"<function>\".to_string(),\n    }\n}\n\n// =================================================\n//   defined functions\n// =================================================\n\nfn defined_add(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    match (op1.type_, op2.type_) {\n        (ObjectType::Integer, ObjectType::Integer) => {\n            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(a.wrapping_add(b));\n        }\n        (ObjectType::String, ObjectType::String) => {\n            let a = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n            let b = if let ObjectValue::StringValue(v) = &op2.value { v.clone() } else { String::new() };\n            evaluated.type_ = ObjectType::String;\n            evaluated.value = ObjectValue::StringValue(a + &b);\n        }\n        _ => {\n            eprintln!(\"Type error: operands for + must be integers or strings.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_sub(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    match (op1.type_, op2.type_) {\n        (ObjectType::Integer, ObjectType::Integer) => {\n            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(a.wrapping_sub(b));\n        }\n        _ => {\n            eprintln!(\"Type error: operands for - must be integers.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_mul(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    match (op1.type_, op2.type_) {\n        (ObjectType::Integer, ObjectType::Integer) => {\n            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(a.wrapping_mul(b));\n        }\n        _ => {\n            eprintln!(\"Type error: operands for * must be integers.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_div(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    match (op1.type_, op2.type_) {\n        (ObjectType::Integer, ObjectType::Integer) => {\n            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n            if b == 0 {\n                eprintln!(\"Division by zero.\");\n                std::process::exit(1);\n            }\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(a / b);\n        }\n        _ => {\n            eprintln!(\"Type error: operands for / must be integers.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_mod(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    match (op1.type_, op2.type_) {\n        (ObjectType::Integer, ObjectType::Integer) => {\n            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n            if b == 0 {\n                eprintln!(\"Modulo by zero.\");\n                std::process::exit(1);\n            }\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(a % b);\n        }\n        _ => {\n            eprintln!(\"Type error: operands for % must be integers.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_lt(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    match (op1.type_, op2.type_) {\n        (ObjectType::Integer, ObjectType::Integer) => {\n            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n            evaluated.type_ = ObjectType::Bool;\n            evaluated.value = ObjectValue::BoolValue(if a < b { 1 } else { 0 });\n        }\n        _ => {\n            eprintln!(\"Type error: operands for < must be integers.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_gt(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    match (op1.type_, op2.type_) {\n        (ObjectType::Integer, ObjectType::Integer) => {\n            let a = if let ObjectValue::IntValue(v) = &op1.value { *v } else { 0 };\n            let b = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n            evaluated.type_ = ObjectType::Bool;\n            evaluated.value = ObjectValue::BoolValue(if a > b { 1 } else { 0 });\n        }\n        _ => {\n            eprintln!(\"Type error: operands for > must be integers.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_eq(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    evaluated.type_ = ObjectType::Bool;\n    evaluated.value = ObjectValue::BoolValue(if obj_eq(op1, op2) { 1 } else { 0 });\n}\n\nfn defined_not(op: &Object, evaluated: &mut Object) {\n    if !matches!(op.type_, ObjectType::Bool) {\n        eprintln!(\"Type error: not operand must be boolean.\");\n        std::process::exit(1);\n    }\n    let v = if let ObjectValue::BoolValue(v) = &op.value { *v } else { 0 };\n    evaluated.type_ = ObjectType::Bool;\n    evaluated.value = ObjectValue::BoolValue(if v != 0 { 0 } else { 1 });\n}\n\nfn defined_car(op: &Object, evaluated: &mut Object) {\n    if !matches!(op.type_, ObjectType::List) {\n        eprintln!(\"Type error: car operand must be list.\");\n        std::process::exit(1);\n    }\n    if let ObjectValue::ListValue(Some(cell)) = &op.value {\n        if let Some(car) = &cell.car {\n            *evaluated = (**car).clone();\n        }\n    }\n}\n\nfn defined_cdr(op: &Object, evaluated: &mut Object) {\n    if !matches!(op.type_, ObjectType::List) {\n        eprintln!(\"Type error: cdr operand must be list.\");\n        std::process::exit(1);\n    }\n    if let ObjectValue::ListValue(Some(cell)) = &op.value {\n        if let Some(cdr) = &cell.cdr {\n            *evaluated = (**cdr).clone();\n        }\n    }\n}\n\nfn defined_cons(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    let new_cell;\n    match op2.type_ {\n        ObjectType::List => {\n            new_cell = ConsCell {\n                type_: ConsCellType::Cell,\n                car: Some(Box::new(op1.clone())),\n                cdr: Some(Box::new(op2.clone())),\n            };\n        }\n        ObjectType::Nil => {\n            new_cell = ConsCell {\n                type_: ConsCellType::Cell,\n                car: Some(Box::new(op1.clone())),\n                cdr: Some(Box::new(op2.clone())),\n            };\n        }\n        _ => {\n            // wrap op2 into its own list\n            let inner_cell = ConsCell {\n                type_: ConsCellType::Cell,\n                car: Some(Box::new(op2.clone())),\n                cdr: Some(Box::new(nil_object())),\n            };\n            let cdr_obj = Object {\n                marked: false,\n                type_: ObjectType::List,\n                value: ObjectValue::ListValue(Some(Box::new(inner_cell))),\n            };\n            new_cell = ConsCell {\n                type_: ConsCellType::Cell,\n                car: Some(Box::new(op1.clone())),\n                cdr: Some(Box::new(cdr_obj)),\n            };\n        }\n    }\n    evaluated.type_ = ObjectType::List;\n    evaluated.value = ObjectValue::ListValue(Some(Box::new(new_cell)));\n}\n\nfn defined_split(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    if !matches!(op1.type_, ObjectType::String) {\n        eprintln!(\"Type error: split first operand must be string.\");\n        std::process::exit(1);\n    }\n    if !matches!(op2.type_, ObjectType::String) {\n        eprintln!(\"Type error: split second operand must be string.\");\n        std::process::exit(1);\n    }\n    let s = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n    let sep = if let ObjectValue::StringValue(v) = &op2.value { v.clone() } else { String::new() };\n\n    let pieces: Vec<String> = if sep.is_empty() {\n        // list of characters\n        s.chars().map(|c| c.to_string()).collect()\n    } else {\n        // strtok-like behaviour: skip empty pieces, treat each char in sep as a delimiter\n        let sep_chars: std::collections::HashSet<char> = sep.chars().collect();\n        let mut out = Vec::new();\n        let mut cur = String::new();\n        for ch in s.chars() {\n            if sep_chars.contains(&ch) {\n                if !cur.is_empty() {\n                    out.push(std::mem::take(&mut cur));\n                }\n            } else {\n                cur.push(ch);\n            }\n        }\n        if !cur.is_empty() {\n            out.push(cur);\n        }\n        out\n    };\n\n    if pieces.is_empty() {\n        evaluated.type_ = ObjectType::Nil;\n        return;\n    }\n\n    // build cons-cell list\n    let mut head: Option<Box<ConsCell>> = None;\n    for piece in pieces.into_iter().rev() {\n        let car_obj = Object {\n            marked: false,\n            type_: ObjectType::String,\n            value: ObjectValue::StringValue(piece),\n        };\n        let cdr_obj = match head {\n            None => Object {\n                marked: false,\n                type_: ObjectType::Nil,\n                value: ObjectValue::IntValue(0),\n            },\n            Some(cell) => Object {\n                marked: false,\n                type_: ObjectType::List,\n                value: ObjectValue::ListValue(Some(cell)),\n            },\n        };\n        let cell_type = if matches!(cdr_obj.type_, ObjectType::Nil) {\n            ConsCellType::Cell\n        } else {\n            ConsCellType::Cell\n        };\n        head = Some(Box::new(ConsCell {\n            type_: cell_type,\n            car: Some(Box::new(car_obj)),\n            cdr: Some(Box::new(cdr_obj)),\n        }));\n    }\n\n    evaluated.type_ = ObjectType::List;\n    evaluated.value = ObjectValue::ListValue(head);\n}\n\nfn defined_list_ref(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    if !matches!(op1.type_, ObjectType::List) {\n        eprintln!(\"Type error: list-ref first operand must be list.\");\n        std::process::exit(1);\n    }\n    if !matches!(op2.type_, ObjectType::Integer) {\n        eprintln!(\"Type error: list-ref second operand must be integer.\");\n        std::process::exit(1);\n    }\n    let index = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n    if let ObjectValue::ListValue(Some(cell0)) = &op1.value {\n        let mut current: &ConsCell = cell0.as_ref();\n        for _ in 0..index {\n            if let Some(cdr) = &current.cdr {\n                if matches!(cdr.type_, ObjectType::Nil) {\n                    eprintln!(\"Index out of range.\");\n                    std::process::exit(1);\n                }\n                if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n                    current = next_cell.as_ref();\n                } else {\n                    eprintln!(\"Index out of range.\");\n                    std::process::exit(1);\n                }\n            } else {\n                eprintln!(\"Index out of range.\");\n                std::process::exit(1);\n            }\n        }\n        if let Some(car) = &current.car {\n            *evaluated = (**car).clone();\n        }\n    }\n}\n\nfn defined_remove_whitespaces(op1: &Object, evaluated: &mut Object) {\n    if !matches!(op1.type_, ObjectType::String) {\n        eprintln!(\"Type error: remove-whitespaces operand must be string.\");\n        std::process::exit(1);\n    }\n    let s = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n    let result: String = s.chars().filter(|c| !c.is_whitespace()).collect();\n    evaluated.type_ = ObjectType::String;\n    evaluated.value = ObjectValue::StringValue(result);\n}\n\n#[allow(dead_code)]\nfn defined_pop(op: &Object, evaluated: &mut Object) {\n    if matches!(op.type_, ObjectType::Nil) {\n        evaluated.type_ = ObjectType::Nil;\n        evaluated.value = ObjectValue::IntValue(0);\n        return;\n    }\n    if !matches!(op.type_, ObjectType::List) {\n        eprintln!(\"Type error: pop operand must be list.\");\n        std::process::exit(1);\n    }\n    if let ObjectValue::ListValue(Some(cell0)) = &op.value {\n        let mut current: &ConsCell = cell0.as_ref();\n        loop {\n            if is_last_cons_cell(current) {\n                if let Some(car) = &current.car {\n                    *evaluated = (**car).clone();\n                }\n                break;\n            }\n            if let Some(cdr) = &current.cdr {\n                if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n                    current = next_cell.as_ref();\n                } else {\n                    break;\n                }\n            } else {\n                break;\n            }\n        }\n    }\n}\n\nfn defined_length(op: &Object, evaluated: &mut Object) {\n    match op.type_ {\n        ObjectType::Nil => {\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(0);\n        }\n        ObjectType::List => {\n            let mut length = 1i32;\n            if let ObjectValue::ListValue(Some(cell0)) = &op.value {\n                let mut current: &ConsCell = cell0.as_ref();\n                loop {\n                    if is_last_cons_cell(current) {\n                        break;\n                    }\n                    length += 1;\n                    if let Some(cdr) = &current.cdr {\n                        if let ObjectValue::ListValue(Some(next_cell)) = &cdr.value {\n                            current = next_cell.as_ref();\n                        } else {\n                            break;\n                        }\n                    } else {\n                        break;\n                    }\n                }\n            } else {\n                length = 0;\n            }\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(length);\n        }\n        ObjectType::String => {\n            let len = if let ObjectValue::StringValue(v) = &op.value {\n                v.len() as i32\n            } else {\n                0\n            };\n            evaluated.type_ = ObjectType::Integer;\n            evaluated.value = ObjectValue::IntValue(len);\n        }\n        _ => {\n            eprintln!(\"Type error: length operand must be list or string.\");\n            std::process::exit(1);\n        }\n    }\n}\n\nfn defined_is_int_string(op: &Object, evaluated: &mut Object) {\n    let result = if matches!(op.type_, ObjectType::String) {\n        if let ObjectValue::StringValue(s) = &op.value {\n            !s.is_empty() && s.chars().all(|c| c.is_ascii_digit())\n        } else {\n            false\n        }\n    } else {\n        false\n    };\n    evaluated.type_ = ObjectType::Bool;\n    evaluated.value = ObjectValue::BoolValue(if result { 1 } else { 0 });\n}\n\nfn defined_parse_int(op: &Object, evaluated: &mut Object) {\n    if !matches!(op.type_, ObjectType::String) {\n        eprintln!(\"Type error: parse-int operand must be string.\");\n        std::process::exit(1);\n    }\n    let s = if let ObjectValue::StringValue(v) = &op.value { v.clone() } else { String::new() };\n    if !s.chars().all(|c| c.is_ascii_digit()) {\n        eprintln!(\"Type error: parse-int operand must be string of digits.\");\n        std::process::exit(1);\n    }\n    let v: i32 = s.parse().unwrap_or(0);\n    evaluated.type_ = ObjectType::Integer;\n    evaluated.value = ObjectValue::IntValue(v);\n}\n\nfn defined_string_ref(op1: &Object, op2: &Object, evaluated: &mut Object) {\n    if !matches!(op1.type_, ObjectType::String) {\n        eprintln!(\"Type error: string-ref first operand must be string.\");\n        std::process::exit(1);\n    }\n    if !matches!(op2.type_, ObjectType::Integer) {\n        eprintln!(\"Type error: string-ref second operand must be integer.\");\n        std::process::exit(1);\n    }\n    let s = if let ObjectValue::StringValue(v) = &op1.value { v.clone() } else { String::new() };\n    let idx = if let ObjectValue::IntValue(v) = &op2.value { *v } else { 0 };\n    let bytes = s.as_bytes();\n    if idx < 0 || (idx as usize) >= bytes.len() {\n        eprintln!(\"Index out of range.\");\n        std::process::exit(1);\n    }\n    let ch = bytes[idx as usize];\n    evaluated.type_ = ObjectType::String;\n    evaluated.value = ObjectValue::StringValue((ch as char).to_string());\n}\n\n// =================================================\n//   environment helpers\n// =================================================\n\nfn set_object_to_env(env: &mut Env, symbol_name: &str, obj: Object) {\n    let mut empty_idx: Option<usize> = None;\n    for i in 0..MAX_BINDINGS {\n        if env.bindings[i].symbol_name.is_empty() {\n            empty_idx = Some(i);\n            break;\n        }\n        if env.bindings[i].symbol_name == symbol_name {\n            env.bindings[i].value = Some(Box::new(obj));\n            return;\n        }\n    }\n    if let Some(i) = empty_idx {\n        env.bindings[i].symbol_name = symbol_name.to_string();\n        env.bindings[i].value = Some(Box::new(obj));\n    }\n}\n\nfn lookup_in_env(env: &Env, symbol_name: &str) -> Option<Object> {\n    for i in 0..MAX_BINDINGS {\n        if env.bindings[i].symbol_name.is_empty() {\n            break;\n        }\n        if env.bindings[i].symbol_name == symbol_name {\n            if let Some(v) = &env.bindings[i].value {\n                return Some((**v).clone());\n            }\n        }\n    }\n    if let Some(parent) = &env.parent {\n        return lookup_in_env(parent, symbol_name);\n    }\n    None\n}\n\n// =================================================\n//   evaluator\n// =================================================\n\nfn evaluate_literal_expression(expression: &ExpressionNode, evaluated: &mut Object) {\n    if let ExpressionData::Literal(Some(lit)) = &expression.data {\n        match &lit.value {\n            LiteralValue::IntValue(v) => {\n                evaluated.type_ = ObjectType::Integer;\n                evaluated.value = ObjectValue::IntValue(*v);\n            }\n            LiteralValue::StringValue(v) => {\n                evaluated.type_ = ObjectType::String;\n                evaluated.value = ObjectValue::StringValue(v.clone());\n            }\n            LiteralValue::BooleanValue(v) => {\n                evaluated.type_ = ObjectType::Bool;\n                evaluated.value = ObjectValue::BoolValue(if *v { 1 } else { 0 });\n            }\n        }\n    }\n}\n\nfn evaluate_symbol_expression(\n    expression: &ExpressionNode,\n    evaluated: &mut Object,\n    env: &mut Env,\n) {\n    let name = match &expression.data {\n        ExpressionData::Symbol(Some(s)) => s.symbol_name.clone(),\n        _ => return,\n    };\n    if name == \"nil\" {\n        evaluated.type_ = ObjectType::Nil;\n        evaluated.value = ObjectValue::IntValue(0);\n        return;\n    }\n    if let Some(obj) = lookup_in_env(env, &name) {\n        *evaluated = obj;\n    } else {\n        eprintln!(\"Undefined symbol: {}\", name);\n        std::process::exit(1);\n    }\n}\n\nfn evaluate_list_expression(\n    expression: &ExpressionNode,\n    evaluated: &mut Object,\n    env: &mut Env,\n    context: &mut AllocatorContext,\n) {\n    let expressions_opt = match &expression.data {\n        ExpressionData::List(Some(list)) => list.expressions.as_deref(),\n        _ => None,\n    };\n    if expressions_opt.is_none() {\n        evaluated.type_ = ObjectType::Nil;\n        evaluated.value = ObjectValue::IntValue(0);\n        return;\n    }\n\n    // collect all evaluated items first\n    let mut items: Vec<Object> = Vec::new();\n    let mut cur = expressions_opt;\n    while let Some(node) = cur {\n        if let Some(expr) = &node.expression {\n            let mut item = empty_object();\n            evaluate_expression(expr, &mut item, env, context);\n            items.push(item);\n        }\n        cur = node.next.as_deref();\n    }\n\n    if items.is_empty() {\n        evaluated.type_ = ObjectType::Nil;\n        evaluated.value = ObjectValue::IntValue(0);\n        return;\n    }\n\n    // Build cons cells\n    let mut head: Option<Box<ConsCell>> = None;\n    for item in items.into_iter().rev() {\n        let cdr_obj = match head {\n            None => Object {\n                marked: false,\n                type_: ObjectType::Nil,\n                value: ObjectValue::IntValue(0),\n            },\n            Some(cell) => Object {\n                marked: false,\n                type_: ObjectType::List,\n                value: ObjectValue::ListValue(Some(cell)),\n            },\n        };\n        let cell_type = if matches!(cdr_obj.type_, ObjectType::Nil) {\n            ConsCellType::Nil\n        } else {\n            ConsCellType::Cell\n        };\n        head = Some(Box::new(ConsCell {\n            type_: cell_type,\n            car: Some(Box::new(item)),\n            cdr: Some(Box::new(cdr_obj)),\n        }));\n    }\n\n    evaluated.type_ = ObjectType::List;\n    evaluated.value = ObjectValue::ListValue(head);\n}\n\nfn get_nth_expr<'a>(\n    list: Option<&'a ExpressionList>,\n    n: usize,\n) -> Option<&'a ExpressionNode> {\n    let mut cur = list;\n    let mut i = 0usize;\n    while let Some(node) = cur {\n        if i == n {\n            return node.expression.as_deref();\n        }\n        i += 1;\n        cur = node.next.as_deref();\n    }\n    None\n}\n\nfn evaluate_symbolic_expression(\n    expression: &ExpressionNode,\n    evaluated: &mut Object,\n    env: &mut Env,\n    context: &mut AllocatorContext,\n) {\n    // Get the inner expression list, prefer SymbolicExp variant; some C code reads .list,\n    // but at this point the type tag is EXP_SYMBOLIC_EXP; the C union shares storage.\n    let expressions_opt: Option<&ExpressionList> = match &expression.data {\n        ExpressionData::SymbolicExp(Some(s)) => s.expressions.as_deref(),\n        ExpressionData::List(Some(l)) => l.expressions.as_deref(),\n        _ => None,\n    };\n\n    let expressions = match expressions_opt {\n        Some(e) => e,\n        None => {\n            evaluated.type_ = ObjectType::Nil;\n            evaluated.value = ObjectValue::IntValue(0);\n            return;\n        }\n    };\n\n    let head_expr = match &expressions.expression {\n        Some(e) => e.as_ref(),\n        None => {\n            evaluated.type_ = ObjectType::Nil;\n            evaluated.value = ObjectValue::IntValue(0);\n            return;\n        }\n    };\n\n    let symbol_name = match (&head_expr.type_, &head_expr.data) {\n        (ExpressionType::Symbol, ExpressionData::Symbol(Some(sym))) => sym.symbol_name.clone(),\n        _ => {\n            eprintln!(\"S-exp must be started with symbol.\");\n            std::process::exit(1);\n        }\n    };\n\n    match symbol_name.as_str() {\n        \"if\" => {\n            let cond = match get_nth_expr(Some(expressions), 1) {\n                Some(c) => c.clone(),\n                None => {\n                    eprintln!(\"if must have condition.\");\n                    std::process::exit(1);\n                }\n            };\n            let then_expr = match get_nth_expr(Some(expressions), 2) {\n                Some(t) => t.clone(),\n                None => {\n                    eprintln!(\"if must have then clause.\");\n                    std::process::exit(1);\n                }\n            };\n            let mut cond_obj = empty_object();\n            evaluate_expression(&cond, &mut cond_obj, env, context);\n            if bool_val(&cond_obj) {\n                evaluate_expression(&then_expr, evaluated, env, context);\n            } else if let Some(else_expr) = get_nth_expr(Some(expressions), 3) {\n                let else_clone = else_expr.clone();\n                evaluate_expression(&else_clone, evaluated, env, context);\n            } else {\n                evaluated.type_ = ObjectType::Nil;\n                evaluated.value = ObjectValue::IntValue(0);\n            }\n        }\n        \"while\" => {\n            let cond = match get_nth_expr(Some(expressions), 1) {\n                Some(c) => c.clone(),\n                None => {\n                    eprintln!(\"while must have condition.\");\n                    std::process::exit(1);\n                }\n            };\n            let body = match get_nth_expr(Some(expressions), 2) {\n                Some(t) => t.clone(),\n                None => {\n                    eprintln!(\"while must have body.\");\n                    std::process::exit(1);\n                }\n            };\n            loop {\n                let mut cond_obj = empty_object();\n                evaluate_expression(&cond, &mut cond_obj, env, context);\n                if bool_val(&cond_obj) {\n                    evaluate_expression(&body, evaluated, env, context);\n                } else {\n                    evaluated.type_ = ObjectType::Nil;\n                    evaluated.value = ObjectValue::IntValue(0);\n                    break;\n                }\n            }\n        }\n        \"=\" => {\n            let symbol_expr = match get_nth_expr(Some(expressions), 1) {\n                Some(e) => e,\n                None => {\n                    eprintln!(\"assignment must have variable name.\");\n                    std::process::exit(1);\n                }\n            };\n            let var_name = match (&symbol_expr.type_, &symbol_expr.data) {\n                (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => s.symbol_name.clone(),\n                _ => {\n                    eprintln!(\"Variable name must be symbol.\");\n                    std::process::exit(1);\n                }\n            };\n            let value_expr = match get_nth_expr(Some(expressions), 2) {\n                Some(e) => e.clone(),\n                None => {\n                    eprintln!(\"assignment must have expression.\");\n                    std::process::exit(1);\n                }\n            };\n            let mut val_obj = empty_object();\n            evaluate_expression(&value_expr, &mut val_obj, env, context);\n            *evaluated = val_obj.clone();\n            set_object_to_env(env, &var_name, val_obj);\n        }\n        \"defun\" => {\n            let name_expr = match get_nth_expr(Some(expressions), 1) {\n                Some(e) => e,\n                None => {\n                    eprintln!(\"Function must have a name.\");\n                    std::process::exit(1);\n                }\n            };\n            let fn_name = match (&name_expr.type_, &name_expr.data) {\n                (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => s.symbol_name.clone(),\n                _ => {\n                    eprintln!(\"Function name must be symbol.\");\n                    std::process::exit(1);\n                }\n            };\n            let params_expr = match get_nth_expr(Some(expressions), 2) {\n                Some(e) => e,\n                None => {\n                    eprintln!(\"Function must have parameter.\");\n                    std::process::exit(1);\n                }\n            };\n            let params_list = match (&params_expr.type_, &params_expr.data) {\n                (ExpressionType::SymbolicExp, ExpressionData::SymbolicExp(Some(se))) => {\n                    se.expressions.as_deref()\n                }\n                _ => {\n                    eprintln!(\"Function parameter must be list.\");\n                    std::process::exit(1);\n                }\n            };\n            let mut param_names: Vec<String> = Vec::new();\n            let mut cur = params_list;\n            while let Some(node) = cur {\n                if let Some(e) = &node.expression {\n                    match (&e.type_, &e.data) {\n                        (ExpressionType::Symbol, ExpressionData::Symbol(Some(sym))) => {\n                            param_names.push(sym.symbol_name.clone());\n                        }\n                        _ => {\n                            eprintln!(\"Function parameter must be symbol.\");\n                            std::process::exit(1);\n                        }\n                    }\n                }\n                cur = node.next.as_deref();\n            }\n\n            let body_expr = match get_nth_expr(Some(expressions), 3) {\n                Some(b) => b.clone(),\n                None => {\n                    eprintln!(\"Function must have body.\");\n                    std::process::exit(1);\n                }\n            };\n\n            let func = Function {\n                param_symbol_names: param_names,\n                body: Some(Box::new(body_expr)),\n            };\n            evaluated.type_ = ObjectType::Function;\n            evaluated.value = ObjectValue::FunctionValue(Some(Box::new(func)));\n\n            set_object_to_env(env, &fn_name, evaluated.clone());\n        }\n        \"+\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_add(&a, &b, evaluated);\n        }\n        \"-\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_sub(&a, &b, evaluated);\n        }\n        \"*\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_mul(&a, &b, evaluated);\n        }\n        \"/\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_div(&a, &b, evaluated);\n        }\n        \"%\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_mod(&a, &b, evaluated);\n        }\n        \"||\" => {\n            // short circuit OR\n            let mut cur = expressions.next.as_deref();\n            while let Some(node) = cur {\n                if let Some(e) = &node.expression {\n                    let expr_clone = (**e).clone();\n                    let mut operand = empty_object();\n                    evaluate_expression(&expr_clone, &mut operand, env, context);\n                    if bool_val(&operand) {\n                        evaluated.type_ = ObjectType::Bool;\n                        evaluated.value = ObjectValue::BoolValue(1);\n                        return;\n                    }\n                }\n                cur = node.next.as_deref();\n            }\n            evaluated.type_ = ObjectType::Bool;\n            evaluated.value = ObjectValue::BoolValue(0);\n        }\n        \"&&\" => {\n            let mut cur = expressions.next.as_deref();\n            while let Some(node) = cur {\n                if let Some(e) = &node.expression {\n                    let expr_clone = (**e).clone();\n                    let mut operand = empty_object();\n                    evaluate_expression(&expr_clone, &mut operand, env, context);\n                    if !bool_val(&operand) {\n                        evaluated.type_ = ObjectType::Bool;\n                        evaluated.value = ObjectValue::BoolValue(0);\n                        return;\n                    }\n                }\n                cur = node.next.as_deref();\n            }\n            evaluated.type_ = ObjectType::Bool;\n            evaluated.value = ObjectValue::BoolValue(1);\n        }\n        \"<\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_lt(&a, &b, evaluated);\n        }\n        \">\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_gt(&a, &b, evaluated);\n        }\n        \"eq\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_eq(&a, &b, evaluated);\n        }\n        \"not\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            defined_not(&a, evaluated);\n        }\n        \"print\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let s = stringify_object(&a);\n            println!(\"{}\", s);\n            evaluated.type_ = ObjectType::Nil;\n            evaluated.value = ObjectValue::IntValue(0);\n        }\n        \"car\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            defined_car(&a, evaluated);\n        }\n        \"cdr\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            defined_cdr(&a, evaluated);\n        }\n        \"cons\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_cons(&a, &b, evaluated);\n        }\n        \"readline\" => {\n            use std::io::BufRead;\n            let stdin = std::io::stdin();\n            let mut buf = String::new();\n            match stdin.lock().read_line(&mut buf) {\n                Ok(0) => {\n                    evaluated.type_ = ObjectType::Nil;\n                    evaluated.value = ObjectValue::IntValue(0);\n                }\n                Ok(_) => {\n                    if buf.ends_with('\\n') {\n                        buf.pop();\n                        if buf.ends_with('\\r') {\n                            buf.pop();\n                        }\n                    }\n                    evaluated.type_ = ObjectType::String;\n                    evaluated.value = ObjectValue::StringValue(buf);\n                }\n                Err(_) => {\n                    evaluated.type_ = ObjectType::Nil;\n                    evaluated.value = ObjectValue::IntValue(0);\n                }\n            }\n        }\n        \"split\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_split(&a, &b, evaluated);\n        }\n        \"list-ref\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_list_ref(&a, &b, evaluated);\n        }\n        \"progn\" => {\n            let mut cur = expressions.next.as_deref();\n            let mut last = empty_object();\n            let mut had_any = false;\n            while let Some(node) = cur {\n                if let Some(e) = &node.expression {\n                    let expr_clone = (**e).clone();\n                    let mut operand = empty_object();\n                    evaluate_expression(&expr_clone, &mut operand, env, context);\n                    last = operand;\n                    had_any = true;\n                }\n                cur = node.next.as_deref();\n            }\n            if had_any {\n                *evaluated = last;\n            } else {\n                evaluated.type_ = ObjectType::Nil;\n                evaluated.value = ObjectValue::IntValue(0);\n            }\n        }\n        \"remove-whitespaces\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            defined_remove_whitespaces(&a, evaluated);\n        }\n        \"pop\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let lst_name: Option<String> = match get_nth_expr(Some(expressions), 1) {\n                Some(e) => match (&e.type_, &e.data) {\n                    (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => {\n                        Some(s.symbol_name.clone())\n                    }\n                    _ => None,\n                },\n                None => None,\n            };\n            pop_op(a, evaluated, env, lst_name);\n        }\n        \"push\" => {\n            // (push lst val): the C version mutates the binding's list in place.\n            // We replicate that here by building a new list and rebinding it.\n            let val = eval_nth(expressions, 2, env, context);\n            let lst = eval_nth(expressions, 1, env, context);\n            // Determine if first argument is a symbol that we can rebind.\n            let lst_name: Option<String> = match get_nth_expr(Some(expressions), 1) {\n                Some(e) => match (&e.type_, &e.data) {\n                    (ExpressionType::Symbol, ExpressionData::Symbol(Some(s))) => {\n                        Some(s.symbol_name.clone())\n                    }\n                    _ => None,\n                },\n                None => None,\n            };\n            push_op(&lst, &val, evaluated, env, lst_name);\n        }\n        \"length\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            defined_length(&a, evaluated);\n        }\n        \"is-int-string\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            defined_is_int_string(&a, evaluated);\n        }\n        \"parse-int\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            defined_parse_int(&a, evaluated);\n        }\n        \"string-ref\" => {\n            let a = eval_nth(expressions, 1, env, context);\n            let b = eval_nth(expressions, 2, env, context);\n            defined_string_ref(&a, &b, evaluated);\n        }\n        _ => {\n            // user-defined function call\n            if let Some(func_obj) = lookup_in_env(env, &symbol_name) {\n                if let ObjectValue::FunctionValue(Some(func)) = &func_obj.value {\n                    // Build new env\n                    let mut new_env = empty_env();\n                    new_env.parent = Some(Box::new(env.clone()));\n\n                    // Bind parameters\n                    let mut cur = expressions.next.as_deref();\n                    for pname in &func.param_symbol_names {\n                        let arg_expr_opt = cur.and_then(|n| n.expression.as_deref());\n                        if let Some(arg_expr) = arg_expr_opt {\n                            let arg_clone = arg_expr.clone();\n                            let mut param_val = empty_object();\n                            evaluate_expression(&arg_clone, &mut param_val, env, context);\n                            set_object_to_env(&mut new_env, pname, param_val);\n                        }\n                        cur = cur.and_then(|n| n.next.as_deref());\n                    }\n\n                    if let Some(body) = &func.body {\n                        let body_clone = (**body).clone();\n                        evaluate_expression(&body_clone, evaluated, &mut new_env, context);\n                    }\n                    return;\n                }\n            }\n            eprintln!(\"Undefined function: {}\", symbol_name);\n            std::process::exit(1);\n        }\n    }\n}\n\nfn eval_nth(\n    expressions: &ExpressionList,\n    n: usize,\n    env: &mut Env,\n    context: &mut AllocatorContext,\n) -> Object {\n    let mut result = empty_object();\n    if let Some(expr) = get_nth_expr(Some(expressions), n) {\n        let expr_clone = expr.clone();\n        evaluate_expression(&expr_clone, &mut result, env, context);\n    }\n    result\n}\n\nfn pop_op(mut lst: Object, evaluated: &mut Object, env: &mut Env, lst_name: Option<String>) {\n    if matches!(lst.type_, ObjectType::Nil) {\n        evaluated.type_ = ObjectType::Nil;\n        evaluated.value = ObjectValue::IntValue(0);\n        return;\n    }\n    if !matches!(lst.type_, ObjectType::List) {\n        eprintln!(\"Type error: pop operand must be list.\");\n        std::process::exit(1);\n    }\n\n    // Walk to the last cons cell and capture the last value, then truncate.\n    let popped: Option<Object>;\n    let became_empty: bool;\n    if let ObjectValue::ListValue(Some(head_cell)) = &mut lst.value {\n        // Single element list?\n        if matches!(\n            head_cell.cdr.as_deref().map(|o| o.type_),\n            Some(ObjectType::Nil) | None\n        ) {\n            popped = head_cell.car.as_deref().cloned();\n            became_empty = true;\n        } else {\n            // Walk to the second-to-last cell\n            became_empty = false;\n            popped = pop_walk(head_cell.as_mut());\n        }\n    } else {\n        evaluated.type_ = ObjectType::Nil;\n        evaluated.value = ObjectValue::IntValue(0);\n        return;\n    }\n\n    if let Some(p) = popped {\n        *evaluated = p;\n    } else {\n        evaluated.type_ = ObjectType::Nil;\n        evaluated.value = ObjectValue::IntValue(0);\n    }\n\n    if let Some(name) = lst_name {\n        if became_empty {\n            // Set binding to nil\n            set_object_to_env(\n                env,\n                &name,\n                Object {\n                    marked: false,\n                    type_: ObjectType::Nil,\n                    value: ObjectValue::IntValue(0),\n                },\n            );\n        } else {\n            set_object_to_env(env, &name, lst);\n        }\n    }\n}\n\nfn pop_walk(head: &mut ConsCell) -> Option<Object> {\n    // Walk until cdr.list_value's cdr is nil. Then truncate.\n    let mut current: &mut ConsCell = head;\n    loop {\n        // Check if next cell is the last\n        let next_is_last: bool = match &current.cdr {\n            Some(o) => match &o.value {\n                ObjectValue::ListValue(Some(next_cell)) => match &next_cell.cdr {\n                    Some(c) => matches!(c.type_, ObjectType::Nil),\n                    None => true,\n                },\n                _ => false,\n            },\n            None => false,\n        };\n        if next_is_last {\n            // popped value is from current.cdr.list_value.car\n            if let Some(cdr) = current.cdr.as_mut() {\n                if let ObjectValue::ListValue(Some(next_cell)) = &mut cdr.value {\n                    let popped = next_cell.car.as_deref().cloned();\n                    // Truncate: replace current.cdr with nil\n                    current.cdr = Some(Box::new(Object {\n                        marked: false,\n                        type_: ObjectType::Nil,\n                        value: ObjectValue::IntValue(0),\n                    }));\n                    current.type_ = ConsCellType::Nil;\n                    return popped;\n                }\n            }\n            return None;\n        }\n        // Move forward\n        let cdr_box = match current.cdr.as_mut() {\n            Some(c) => c,\n            None => return None,\n        };\n        if let ObjectValue::ListValue(Some(next_cell)) = &mut cdr_box.value {\n            current = next_cell.as_mut();\n        } else {\n            return None;\n        }\n    }\n}\n\nfn push_op(\n    lst: &Object,\n    val: &Object,\n    evaluated: &mut Object,\n    env: &mut Env,\n    lst_name: Option<String>,\n) {\n    if matches!(lst.type_, ObjectType::Nil) {\n        // Replace binding's nil with a singleton list containing val.\n        if let Some(name) = lst_name {\n            let new_cell = ConsCell {\n                type_: ConsCellType::Cell,\n                car: Some(Box::new(val.clone())),\n                cdr: Some(Box::new(Object {\n                    marked: false,\n                    type_: ObjectType::Nil,\n                    value: ObjectValue::IntValue(0),\n                })),\n            };\n            let new_list = Object {\n                marked: false,\n                type_: ObjectType::List,\n                value: ObjectValue::ListValue(Some(Box::new(new_cell))),\n            };\n            set_object_to_env(env, &name, new_list);\n        }\n        *evaluated = val.clone();\n        return;\n    }\n\n    if !matches!(lst.type_, ObjectType::List) {\n        eprintln!(\"Type error: push second operand must be list.\");\n        std::process::exit(1);\n    }\n\n    // Build new list with val appended\n    let mut new_list = lst.clone();\n    append_to_list(&mut new_list, val.clone());\n    if let Some(name) = lst_name {\n        set_object_to_env(env, &name, new_list);\n    }\n    *evaluated = val.clone();\n}\n\nfn append_to_list(list_obj: &mut Object, val: Object) {\n    if let ObjectValue::ListValue(Some(cell)) = &mut list_obj.value {\n        let mut current: &mut ConsCell = cell.as_mut();\n        loop {\n            let is_last = match &current.cdr {\n                Some(c) => matches!(c.type_, ObjectType::Nil),\n                None => true,\n            };\n            if is_last {\n                let new_cell = ConsCell {\n                    type_: ConsCellType::Cell,\n                    car: Some(Box::new(val)),\n                    cdr: Some(Box::new(Object {\n                        marked: false,\n                        type_: ObjectType::Nil,\n                        value: ObjectValue::IntValue(0),\n                    })),\n                };\n                let cdr_obj = Object {\n                    marked: false,\n                    type_: ObjectType::List,\n                    value: ObjectValue::ListValue(Some(Box::new(new_cell))),\n                };\n                current.cdr = Some(Box::new(cdr_obj));\n                current.type_ = ConsCellType::Cell;\n                return;\n            }\n            // move forward\n            let cdr_box = current.cdr.as_mut().unwrap();\n            if let ObjectValue::ListValue(Some(next_cell)) = &mut cdr_box.value {\n                current = next_cell.as_mut();\n            } else {\n                return;\n            }\n        }\n    }\n}\n\npub fn evaluate_expression(\n    expression: &ExpressionNode,\n    result: &mut Object,\n    env: &mut Env,\n    context: &mut AllocatorContext,\n) {\n    match expression.type_ {\n        ExpressionType::List => evaluate_list_expression(expression, result, env, context),\n        ExpressionType::SymbolicExp => evaluate_symbolic_expression(expression, result, env, context),\n        ExpressionType::Literal => evaluate_literal_expression(expression, result),\n        ExpressionType::Symbol => evaluate_symbol_expression(expression, result, env),\n    }\n}\n\npub fn evaluate_expression_with_context(\n    expression: &ExpressionNode,\n    result: &mut Object,\n    env: &mut Env,\n) {\n    let mut context = init_allocator();\n    evaluate_expression(expression, result, env, &mut context);\n}\n\npub fn evaluate(result: &mut ParseResult) {\n    if let Some(program) = &result.program {\n        let mut env = empty_env();\n        let mut context = init_allocator();\n        let mut cur = program.expressions.as_deref();\n        while let Some(node) = cur {\n            if let Some(expr) = &node.expression {\n                let expr_clone = (**expr).clone();\n                let mut evaluated = empty_object();\n                evaluate_expression(&expr_clone, &mut evaluated, &mut env, &mut context);\n            }\n            cur = node.next.as_deref();\n        }\n    }\n}\n\npub fn init_env(env: &mut Env) {\n    env.parent = None;\n    for i in 0..MAX_BINDINGS {\n        env.bindings[i].symbol_name = String::new();\n        env.bindings[i].value = None;\n    }\n}\n\npub fn init_allocator() -> AllocatorContext {\n    let stack_objects: [Option<Box<Object>>; OBJECT_NUMBER] = std::array::from_fn(|_| None);\n    AllocatorContext {\n        gc_less_mode: 0,\n        stack: Some(Box::new(ObjectStack {\n            objects: stack_objects,\n            top: -1,\n        })),\n        memory_pool: None,\n        free_bitmap: [0u8; FREE_BITMAP_SIZE],\n    }\n}\n\npub fn allocate(_context: &mut AllocatorContext, _env: &mut Env) -> Option<Box<Object>> {\n    Some(Box::new(empty_object()))\n}\n","numLines":2064,"startLine":1,"totalLines":2064}}}
