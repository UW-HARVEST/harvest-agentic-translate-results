sert!(r == BigInt::from_int(1), \"modinv failed: got {}\", r);\n\n    // Test fast_pow\n    let a = BigInt::from_int(745232);\n    let b = BigInt::from_int(67121);\n    let m = BigInt::from_int(1022117);\n    let r = a.fast_pow(&b, &m);\n    assert!(r == BigInt::from_int(97), \"fast_pow failed: got {}\", r);\n\n    // Factorial 100\n    let n = BigInt::from_int(100);\n    let mut result = BigInt::from_int(1);\n    let mut i = BigInt::from_int(1);\n    while le(&i, &n) {\n        result = result.mul(&i);\n        i.inc();\n    }\n    let expected = BigInt::from_str(\"93326215443944152681699238856266700490715968264381621468592963895217599993229915608941463976156518286253697920827223758251185210916864000000000000000000000000\");\n    assert!(result == expected, \"factorial(100) failed: got {}\", result);\n\n    // Test 30-digit large number operations: a < b\n    let a = BigInt::from_str(\"123456789012345678901234567890\");\n    let b = BigInt::from_str(\"987654321098765432109876543210\");\n    let c = a.add(&b);\n    let d = a.sub(&b);\n    let _e = a.mul(&b);\n    let f = a.div(&b);\n    let g = a.r#mod(&b);\n    println!(\"a+b = {}\", c);\n    println!(\"a-b = {}\", d);\n    println!(\"a/b = {}\", f);\n    println!(\"a mod b = {}\", g);\n\n    // sqrt of large\n    let a = BigInt::from_str(\"123412341\");\n    let s = a.sqrt();\n    println!(\"sqrt(123412341) = {}\", s);\n\n    println!(\"All sanity checks passed!\");\n}\nEOF\nmkdir -p /tmp/harvest-crust-4AQo6t/project/examples && cp /tmp/sanity_test.rs /tmp/harvest-crust-4AQo6t/project/examples/sanity_test.rs && cargo run --example sanity_test 2>&1 | tail -30","description":"Build and run a sanity test program"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":276,"cache_read_input_tokens":38837,"cache_creation":{"ephemeral_5m_input_tokens":276,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard"},"context_management":null},