        };\n193\t        result.remove_leading_zeros();\n194\t        result\n195\t    }\n196\t\n197\t    fn sub_internal(a: BigInt, b: BigInt) -> BigInt {\n198\t        if a.negative && b.negative {\n199\t            let mut a2 = a;\n200\t            a2.negative = false;\n201\t            let mut b2 = b;\n202\t            b2.negative = false;\n203\t            let mut result = BigInt::add_internal(b2, a2);\n204\t            result.negative = true;\n205\t            return result;\n206\t        }\n207\t\n208\t        if a.negative {\n209\t            // -a - b = -(a + b). C does: b.is_negative=true; add(a,b).\n210\t            let mut b2 = b;\n211\t            b2.negative = true;\n212\t            return BigInt::add_internal(a, b2);\n213\t        }\n214\t\n215\t        if b.negative {\n216\t            // a - (-b) = a + b\n217\t            let mut b2 = b;\n218\t            b2.negative = false;\n219\t            return BigInt::add_internal(a, b2);\n220\t        }\n221\t\n222\t        // Both non-negative.\n223\t        let size = a.digits.len().max(b.digits.len());\n224\t        let mut digits = vec![0u8; size];\n225\t\n226\t        let is_negative = lt(&a, &b);\n227\t\n228\t        let a_gt_b = gt(&a, &b);\n229\t        let (larger, smaller) = if a_gt_b { (&a, &b) } else { (&b, &a) };\n230\t\n231\t        let mut carry: i64 = 0;\n232\t        for i in 0..size {\n233\t            let mut diff = carry;\n234\t            if i < larger.digits.len() {\n235\t                diff += larger.digits[larger.digits.len() - i - 1] as i64;\n236\t            }\n237\t            if i < smaller.digits.len() {\n238\t                diff -= smaller.digits[smaller.digits.len() - i - 1] as i64;\n239\t            }\n240\t            if diff < 0 {\n241\t                diff += 10;\n242\t                carry = -1;\n243\t            } else {\n244\t                carry = 0;\n245\t            }\n246\t            digits[size - i - 1] = diff as u8;\n247\t        }\n248\t\n249\t        let mut result = BigInt {\n250\t            negative: false,\n251\t            digits,\n252\t        };\n253\t        result.remove_leading_zeros();\n254\t        result.negative = is_negative;\n255\t        result\n256\t    }\n257\t\n258\t    pub fn inc(&mut self) {\n259\t        let one = BigInt::from_str(\"1\");\n260\t        *self = self.add(&one);\n261\t    }\n262\t\n263\t    pub fn dec(&mut self) {\n264\t        let one = BigInt::from_str(\"1\");\n265\t        *self = self.sub(&one);\n266\t    }\n267\t\n268\t    pub fn mul(&self, other: &Self) -> Self {\n269\t        if self.is_64_bit() && other.is_64_bit() {\n270\t            return BigInt::from_int(self.to_int().wrapping_mul(other.to_int()));\n271\t        }\n272\t\n273\t        let a = self;\n274\t        let b = other;\n275\t        let size = a.digits.len() + b.digits.len();\n276\t        let mut buf = vec![0i64; size];\n277\t\n278\t        for i in 0..a.digits.len() {\n279\t            for j in 0..b.digits.len() {\n280\t                let idx = size - i - j - 1;\n281\t                buf[idx] += (a.digits[a.digits.len() - i - 1] as i64)\n282\t                    * (b.digits[b.digits.len() - j - 1] as i64);\n283\t            }\n284\t        }\n285\t\n286\t        // Normalize from right to left.\n287\t        let mut carry: i64 = 0;\n288\t        for i in 0..size {\n289\t            let idx = size - i - 1;\n290\t            let sum = buf[idx] + carry;\n291\t            buf[idx] = sum % 10;\n292\t            carry = sum / 10;\n293\t        }\n294\t\n295\t        let mut digits: Vec<u8> = buf.iter().map(|&v| v as u8).collect();\n296\t\n297\t        if carry > 0 {\n298\t            // For a*b, total digits <= a.size + b.size, so carry should be 0 here.\n299\t            // Match C behaviour anyway.\n300\t            digits.insert(0, carry as u8);\n301\t        }\n302\t\n303\t        let mut result = BigInt {\n304\t            negative: a.negative != b.negative,\n305\t            digits,\n306\t        };\n307\t        result.remove_leading_zeros();\n308\t        result\n309\t    }\n310\t\n311\t    pub fn divmod(&self, other: &Self) -> (Self, Self) {\n312\t        if self.is_64_bit() && other.is_64_bit() {\n313\t            let n = self.to_int();\n314\t            let d = other.to_int();\n315\t            let q = n / d;\n316\t            let r = n % d;\n317\t            return (BigInt::from_int(q), BigInt::from_int(r));\n318\t        }\n319\t\n320\t        let mut quotient = BigInt::from_str(\"0\");\n321\t        let negative = self.negative != other.negative;\n322\t\n323\t        let mut numerator = self.clone();\n324\t        numerator.negative = false;\n325\t        let mut denominator = other.clone();\n326\t        denominator.negative = false;\n327\t\n328\t        // Slow subtraction-based division to match C semantics exactly.\n329\t        while numerator.gt_zero() {\n330\t            numerator = numerator.sub(&denominator);\n331\t            if numerator.lt_zero() {\n332\t                break;\n333\t            }\n334\t            quotient.inc();\n335\t        }\n336\t        if numerator.lt_zero() {\n337\t            numerator = numerator.add(&denominator);\n338\t        }\n339\t\n340\t        let mut remainder = numerator;\n341\t        quotient.remove_leading_zeros();\n342\t\n343\t        if negative {\n344\t            quotient.negative = true;\n345\t            remainder.negative = true;\n346\t        }\n347\t\n348\t        (quotient, remainder)\n349\t    }\n350\t\n351\t    pub fn div(&self, other: &Self) -> Self {\n352\t        if self.is_64_bit() && other.is_64_bit() {\n353\t            return BigInt::from_int(self.to_int() / other.to_int());\n354\t        }\n355\t        let (q, _) = self.divmod(other);\n356\t        q\n357\t    }\n358\t\n359\t    pub fn r#mod(&self, other: &Self) -> Self {\n360\t        if self.is_64_bit() && other.is_64_bit() {\n361\t            return BigInt::from_int(self.to_int() % other.to_int());\n362\t        }\n363\t        let (_, r) = self.divmod(other);\n364\t        r\n365\t    }\n366\t\n367\t    pub fn pow(&self, exponent: &Self) -> Self {\n368\t        if exponent.negative {\n369\t            return BigInt::from_str(\"0\");\n370\t        }\n371\t        let mut result = BigInt::from_str(\"1\");\n372\t        if exponent.is_zero() {\n373\t            return result;\n374\t        }\n375\t        let mut b = exponent.clone();\n376\t        while !b.is_zero() {\n377\t            result = result.mul(self);\n378\t            b.dec();\n379\t        }\n380\t        result\n381\t    }\n382\t\n383\t    pub fn fast_pow(&self, exponent: &Self, modulo: &Self) -> Self {\n384\t        if self.is_64_bit() && exponent.is_64_bit() && modulo.is_64_bit() {\n385\t            let mut result: i64 = 1;\n386\t            let mut base = self.to_int();\n387\t            let mut exp = exponent.to_int();\n388\t            let m = modulo.to_int();\n389\t            base %= m;\n390\t            while exp > 0 {\n391\t                if exp % 2 == 1 {\n392\t                    result = (result * base) % m;\n393\t                }\n394\t                exp >>= 1;\n395\t                base = (base * base) % m;\n396\t            }\n397\t            return BigInt::from_int(result);\n398\t        }\n399\t\n400\t        if exponent.negative {\n401\t            return BigInt::from_str(\"0\");\n402\t        }\n403\t        if exponent.is_zero() {\n404\t            return BigInt::from_str(\"1\");\n405\t        }\n406\t\n407\t        let mut b = exponent.clone();\n408\t        let a = self.r#mod(modulo);\n409\t        let mut result = a.clone();\n410\t        let mut b_save = b.clone();\n411\t        b.dec();\n412\t\n413\t        let mut pow_acc = BigInt::from_str(\"1\");\n414\t        let two = BigInt::from_str(\"2\");\n415\t\n416\t        loop {\n417\t            let div2 = b.div(&two);\n418\t            if !div2.gt_zero() {\n419\t                break;\n420\t            }\n421\t\n422\t            let sq = result.mul(&result);\n423\t            result = sq.r#mod(modulo);\n424\t\n425\t            b = b.div(&two);\n426\t            pow_acc = pow_acc.add(&pow_acc);\n427\t        }\n428\t\n429\t        b_save = b_save.sub(&pow_acc);\n430\t\n431\t        if b_save.is_odd() {\n432\t            let prod = result.mul(&a);\n433\t            result = prod.r#mod(modulo);\n434\t            b_save.dec();\n435\t            pow_acc.inc();\n436\t        }\n437\t\n438\t        if lt(&b_save, &BigInt::from_int(5)) {\n439\t            while !b_save.is_zero() {\n440\t                let prod = result.mul(&a);\n441\t                result = prod.r#mod(modulo);\n442\t                b_save.dec();\n443\t                pow_acc.inc();\n444\t            }\n445\t            return result;\n446\t        }\n447\t\n448\t        let subpart = a.fast_pow(&b_save, modulo);\n449\t        let prod = result.mul(&subpart);\n450\t        result = prod.r#mod(modulo);\n451\t        result\n452\t    }\n453\t\n454\t    pub fn modinv(&self, modulo: &Self) -> Self {\n455\t        let m0 = modulo.clone();\n456\t        let mut y = BigInt::from_str(\"0\");\n457\t        let mut x = BigInt::from_str(\"1\");\n458\t        let one = BigInt::from_str(\"1\");\n459\t        let mut a = self.clone();\n460\t        let mut m = modulo.clone();\n461\t\n462\t        while !a.is_zero() {\n463\t            let q = m.div(&a);\n464\t\n465\t            // t = m - q*a\n466\t            let t1 = q.mul(&a);\n467\t            let t = m.sub(&t1);\n468\t\n469\t            // m = a; a = t\n470\t            m = a.clone();\n471\t            a = t.clone();\n472\t\n473\t            // t = y - q*x\n474\t            let t2 = q.mul(&x);\n475\t            let t = y.sub(&t2);\n476\t\n477\t            // y = x; x = t\n478\t            y = x.clone();\n479\t            x = t.clone();\n480\t        }\n481\t\n482\t        if m.lt_zero() {\n483\t            m = m.add(&m0);\n484\t        }\n485\t\n486\t        if m == one {\n487\t            let mut result = y.r#mod(&m0);\n488\t            if result.lt_zero() {\n489\t                result = result.add(&m0);\n490\t            }\n491\t            return result;\n492\t        }\n493\t        BigInt::from_int(0)\n494\t    }\n495\t\n496\t    pub fn sqrt(&self) -> Self {\n497\t        let one = BigInt::from_str(\"1\");\n498\t        let two = BigInt::from_str(\"2\");\n499\t        let mut low = BigInt::from_str(\"0\");\n500\t        let mut high = self.clone();\n501\t        while lt(&low, &high) {\n502\t            let mid = low.add(&high).div(&two);\n503\t            let sq = mid.mul(&mid);\n504\t            if lt(&sq, self) {\n505\t                low = mid.add(&one);\n506\t            } else {\n507\t                high = mid.clone();\n508\t            }\n509\t        }\n510\t        low\n511\t    }\n512\t\n513\t    pub fn is_even(&self) -> bool {\n514\t        if self.digits.is_empty() {\n515\t            return true;\n516\t        }\n517\t        self.digits[self.digits.len() - 1] % 2 == 0\n518\t    }\n519\t\n520\t    pub fn is_odd(&self) -> bool {\n521\t        if self.digits.is_empty() {\n522\t            return false;\n523\t        }\n524\t        self.digits[self.digits.len() - 1] % 2 == 1\n525\t    }\n526\t\n527\t    pub fn is_prime(&self) -> bool {\n528\t        if self.is_even() {\n529\t            return false;\n530\t        }\n531\t\n532\t        if self.digits.len() > 1 {\n533\t            let last = self.digits[self.digits.len() - 1];\n534\t            if last == 5 || last == 0 {\n535\t                return false;\n536\t            }\n537\t        }\n538\t\n539\t        // Sum of digits divisible by 3?\n540\t        let mut sum = BigInt::from_str(\"0\");\n541\t        for &d in &self.digits {\n542\t            let dig = BigInt::from_int(d as i64);\n543\t            sum = sum.add(&dig);\n544\t        }\n545\t        let three = BigInt::from_str(\"3\");\n546\t        if sum.r#mod(&three).is_zero() {\n547\t            return false;\n548\t        }\n549\t\n550\t        let sqrt_n = self.sqrt();\n551\t        let mut i = BigInt::from_str(\"2\");\n552\t        while le(&i, &sqrt_n) {\n553\t            if self.r#mod(&i).is_zero() {\n554\t                return false;\n555\t            }\n556\t            i.inc();\n557\t        }\n558\t        true\n559\t    }\n560\t}\n561\t\n562\tpub fn gt(a: &BigInt, b: &BigInt) -> bool {\n563\t    let ad = effective_slice(&a.digits);\n564\t    let bd = effective_slice(&b.digits);\n565\t    if ad.len() > bd.len() {\n566\t        return !a.negative;\n567\t    }\n568\t    if ad.len() < bd.len() {\n569\t        return a.negative;\n570\t    }\n571\t    for i in 0..ad.len() {\n572\t        if ad[i] > bd[i] {\n573\t            return !a.negative;\n574\t        }\n575\t        if ad[i] < bd[i] {\n576\t            return a.negative;\n577\t        }\n578\t    }\n579\t    false\n580\t}\n581\t\n582\tpub fn lt(a: &BigInt, b: &BigInt) -> bool {\n583\t    !ge(a, b)\n584\t}\n585\t\n586\tpub fn ge(a: &BigInt, b: &BigInt) -> bool {\n587\t    gt(a, b) || a == b\n588\t}\n589\t\n590\tpub fn le(a: &BigInt, b: &BigInt) -> bool {\n591\t    !gt(a, b)\n592\t}\n593\t\n594\tpub fn delete(a: &mut BigInt) {\n595\t    a.digits.clear();\n596\t    a.negative = false;\n597\t}\n598\t\n599\timpl std::ops::Neg for BigInt {\n600\t    type Output = BigInt;\n601\t    fn neg(mut self) -> BigInt {\n602\t        self.negative = !self.negative;\n603\t        self\n604\t    }\n605\t}\n606\t\n607\timpl PartialEq for BigInt {\n608\t    fn eq(&self, other: &Self) -> bool {\n609\t        let a = effective_slice(&self.digits);\n610\t        let b = effective_slice(&other.digits);\n611\t        if a.len() != b.len() {\n612\t            return false;\n613\t        }\n614\t        if self.negative != other.negative {\n615\t            return false;\n616\t        }\n617\t        a == b\n618\t    }\n619\t}\n620\t\n621\timpl Eq for BigInt {}\n622\t\n623\timpl PartialOrd for BigInt {\n624\t    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n625\t        if self == other {\n626\t            Some(Ordering::Equal)\n627\t        } else if gt(self, other) {\n628\t            Some(Ordering::Greater)\n629\t        } else {\n630\t            Some(Ordering::Less)\n631\t        }\n632\t    }\n633\t}\n634\t\n635\timpl fmt::Display for BigInt {\n636\t    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n637\t        if self.negative {\n638\t            write!(f, \"-\")?;\n639\t        }\n640\t        for &d in &self.digits {\n641\t            write!(f, \"{}\", d)?;\n642\t        }\n643\t        Ok(())\n644\t    }\n645\t}\n646\t"}]},"parent_tool_use_id":null,"session_id":"fd8ff8c2-aade-4ba8-849a-6288896b14fa","uuid":"82f7f199-10d5-43e6-b71d-81d1f4782321","timestamp":"2026-05-29T14:38:50.101Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-DWfpTK/project/src/bigint.rs","content":"use std::cmp::Ordering;\nuse std::fmt;\n\n#[derive(Clone, Debug)]\npub struct BigInt {\n    negative: bool,\n    digits: Vec<u8>,\n}\n\n// Helper: returns slice with leading zeros skipped, but always retaining at least one digit.\nfn effective_slice(d: &[u8]) -> &[u8] {\n    if d.is_empty() {\n        return d;\n    }\n    let mut i = 0;\n    while i + 1 < d.len() && d[i] == 0 {\n        i += 1;\n    }\n    &d[i..]\n}\n\nimpl BigInt {\n    pub fn zero() -> Self {\n        BigInt {\n            negative: false,\n            digits: vec![0],\n        }\n    }\n\n    pub fn is_64_bit(&self) -> bool {\n        // Match C semantics: returns true iff size < 10.\n        self.digits.len() < 10\n    }\n\n    pub fn remove_leading_zeros(&mut self) {\n        let mut leading = 0usize;\n        for &d in &self.digits {\n            if d == 0 {\n                leading += 1;\n            } else {\n                break;\n            }\n        }\n        if leading > 0 {\n            if leading >= self.digits.len() {\n                self.digits = vec![0];\n                return;\n            }\n            self.digits.drain(..leading);\n        }\n    }\n\n    pub fn from_int(n: i64) -> Self {\n        let negative = n < 0;\n        let m: u64 = if negative { n.unsigned_abs() } else { n as u64 };\n\n        // Match C: starts size=1, while (m > 0) { m/=10; size++; }\n        let mut size: usize = 1;\n        let mut tmp = m;\n        while tmp > 0 {\n            tmp /= 10;\n            size += 1;\n        }\n        let mut digits = vec![0u8; size];\n        tmp = m;\n        for i in 0..size {\n            digits[size - i - 1] = (tmp % 10) as u8;\n            tmp /= 10;\n        }\n        let mut result = BigInt { negative, digits };\n        result.remove_leading_zeros();\n        result\n    }\n\n    pub fn to_int(&self) -> i64 {\n        let mut result: i64 = 0;\n        for &d in &self.digits {\n            result = result.wrapping_mul(10).wrapping_add(d as i64);\n        }\n        if self.negative {\n            result = result.wrapping_neg();\n        }\n        result\n    }\n\n    pub fn from_str(s: &str) -> Self {\n        let bytes = s.as_bytes();\n        let (negative, rest) = if !bytes.is_empty() && bytes[0] == b'-' {\n            (true, &bytes[1..])\n        } else {\n            (false, bytes)\n        };\n        let digits: Vec<u8> = rest.iter().map(|&c| c.wrapping_sub(b'0')).collect();\n        BigInt { negative, digits }\n    }\n\n    pub fn copy(&self) -> BigInt {\n        self.clone()\n    }\n\n    pub fn print(&self) {\n        print!(\"{}\", self);\n    }\n\n    pub fn is_zero(&self) -> bool {\n        // After removing leading zeros, size==1 and digits[0]==0,\n        // equivalent to: all digits are zero.\n        self.digits.iter().all(|&d| d == 0)\n    }\n\n    pub fn lt_zero(&self) -> bool {\n        if self.is_zero() {\n            return false;\n        }\n        self.negative\n    }\n\n    pub fn gt_zero(&self) -> bool {\n        if self.is_zero() {\n            return false;\n        }\n        !self.negative\n    }\n\n    pub fn lezero(&self) -> bool {\n        if self.is_zero() {\n            return true;\n        }\n        self.negative\n    }\n\n    pub fn gezero(&self) -> bool {\n        if self.is_zero() {\n            return true;\n        }\n        !self.negative\n    }\n\n    pub fn abs(&self) -> Self {\n        BigInt {\n            negative: false,\n            digits: self.digits.clone(),\n        }\n    }\n\n    pub fn add(&self, other: &Self) -> Self {\n        BigInt::add_internal(self.clone(), other.clone())\n    }\n\n    pub fn sub(&self, other: &Self) -> Self {\n        BigInt::sub_internal(self.clone(), other.clone())\n    }\n\n    fn add_internal(a: BigInt, b: BigInt) -> BigInt {\n        // Match the C bigint_add control flow.\n        if a.negative && b.negative {\n            // both negative: take normal add, mark negative.\n        } else if a.negative {\n            let mut a2 = a;\n            a2.negative = false;\n            return BigInt::sub_internal(b, a2);\n        } else if b.negative {\n            let mut b2 = b;\n            b2.negative = false;\n            return BigInt::sub_internal(a, b2);\n        }\n\n        let result_negative = a.negative && b.negative;\n        let size = a.digits.len().max(b.digits.len());\n        let mut digits = vec![0u8; size];\n\n        let mut carry: i64 = 0;\n        for i in 0..size {\n            let mut sum = carry;\n            if i < a.digits.len() {\n                sum += a.digits[a.digits.len() - i - 1] as i64;\n            }\n            if i < b.digits.len() {\n                sum += b.digits[b.digits.len() - i - 1] as i64;\n            }\n            digits[size - i - 1] = (sum % 10) as u8;\n            carry = sum / 10;\n        }\n\n        if carry > 0 {\n            digits.insert(0, carry as u8);\n        }\n\n        let mut result = BigInt {\n            negative: result_negative,\n            digits,\n        };\n        result.remove_leading_zeros();\n        result\n    }\n\n    fn sub_internal(a: BigInt, b: BigInt) -> BigInt {\n        if a.negative && b.negative {\n            let mut a2 = a;\n            a2.negative = false;\n            let mut b2 = b;\n            b2.negative = false;\n            let mut result = BigInt::add_internal(b2, a2);\n            result.negative = true;\n            return result;\n        }\n\n        if a.negative {\n            // -a - b = -(a + b). C does: b.is_negative=true; add(a,b).\n            let mut b2 = b;\n            b2.negative = true;\n            return BigInt::add_internal(a, b2);\n        }\n\n        if b.negative {\n            // a - (-b) = a + b\n            let mut b2 = b;\n            b2.negative = false;\n            return BigInt::add_internal(a, b2);\n        }\n\n        // Both non-negative.\n        let size = a.digits.len().max(b.digits.len());\n        let mut digits = vec![0u8; size];\n\n        let is_negative = lt(&a, &b);\n\n        let a_gt_b = gt(&a, &b);\n        let (larger, smaller) = if a_gt_b { (&a, &b) } else { (&b, &a) };\n\n        let mut carry: i64 = 0;\n        for i in 0..size {\n            let mut diff = carry;\n            if i < larger.digits.len() {\n                diff += larger.digits[larger.digits.len() - i - 1] as i64;\n            }\n            if i < smaller.digits.len() {\n                diff -= smaller.digits[smaller.digits.len() - i - 1] as i64;\n            }\n            if diff < 0 {\n                diff += 10;\n                carry = -1;\n            } else {\n                carry = 0;\n            }\n            digits[size - i - 1] = diff as u8;\n        }\n\n        let mut result = BigInt {\n            negative: false,\n            digits,\n        };\n        result.remove_leading_zeros();\n        result.negative = is_negative;\n        result\n    }\n\n    pub fn inc(&mut self) {\n        let one = BigInt::from_str(\"1\");\n        *self = self.add(&one);\n    }\n\n    pub fn dec(&mut self) {\n        let one = BigInt::from_str(\"1\");\n        *self = self.sub(&one);\n    }\n\n    pub fn mul(&self, other: &Self) -> Self {\n        if self.is_64_bit() && other.is_64_bit() {\n            return BigInt::from_int(self.to_int().wrapping_mul(other.to_int()));\n        }\n\n        let a = self;\n        let b = other;\n        let size = a.digits.len() + b.digits.len();\n        let mut buf = vec![0i64; size];\n\n        for i in 0..a.digits.len() {\n            for j in 0..b.digits.len() {\n                let idx = size - i - j - 1;\n                buf[idx] += (a.digits[a.digits.len() - i - 1] as i64)\n                    * (b.digits[b.digits.len() - j - 1] as i64);\n            }\n        }\n\n        // Normalize from right to left.\n        let mut carry: i64 = 0;\n        for i in 0..size {\n            let idx = size - i - 1;\n            let sum = buf[idx] + carry;\n            buf[idx] = sum % 10;\n            carry = sum / 10;\n        }\n\n        let mut digits: Vec<u8> = buf.iter().map(|&v| v as u8).collect();\n\n        if carry > 0 {\n            // For a*b, total digits <= a.size + b.size, so carry should be 0 here.\n            // Match C behaviour anyway.\n            digits.insert(0, carry as u8);\n        }\n\n        let mut result = BigInt {\n            negative: a.negative != b.negative,\n            digits,\n        };\n        result.remove_leading_zeros();\n        result\n    }\n\n    pub fn divmod(&self, other: &Self) -> (Self, Self) {\n        if self.is_64_bit() && other.is_64_bit() {\n            let n = self.to_int();\n            let d = other.to_int();\n            let q = n / d;\n            let r = n % d;\n            return (BigInt::from_int(q), BigInt::from_int(r));\n        }\n\n        let mut quotient = BigInt::from_str(\"0\");\n        let negative = self.negative != other.negative;\n\n        let mut numerator = self.clone();\n        numerator.negative = false;\n        let mut denominator = other.clone();\n        denominator.negative = false;\n\n        // Slow subtraction-based division to match C semantics exactly.\n        while numerator.gt_zero() {\n            numerator = numerator.sub(&denominator);\n            if numerator.lt_zero() {\n                break;\n            }\n            quotient.inc();\n        }\n        if numerator.lt_zero() {\n            numerator = numerator.add(&denominator);\n        }\n\n        let mut remainder = numerator;\n        quotient.remove_leading_zeros();\n\n        if negative {\n            quotient.negative = true;\n            remainder.negative = true;\n        }\n\n        (quotient, remainder)\n    }\n\n    pub fn div(&self, other: &Self) -> Self {\n        if self.is_64_bit() && other.is_64_bit() {\n            return BigInt::from_int(self.to_int() / other.to_int());\n        }\n        let (q, _) = self.divmod(other);\n        q\n    }\n\n    pub fn r#mod(&self, other: &Self) -> Self {\n        if self.is_64_bit() && other.is_64_bit() {\n            return BigInt::from_int(self.to_int() % other.to_int());\n        }\n        let (_, r) = self.divmod(other);\n        r\n    }\n\n    pub fn pow(&self, exponent: &Self) -> Self {\n        if exponent.negative {\n            return BigInt::from_str(\"0\");\n        }\n        let mut result = BigInt::from_str(\"1\");\n        if exponent.is_zero() {\n            return result;\n        }\n        let mut b = exponent.clone();\n        while !b.is_zero() {\n            result = result.mul(self);\n            b.dec();\n        }\n        result\n    }\n\n    pub fn fast_pow(&self, exponent: &Self, modulo: &Self) -> Self {\n        if self.is_64_bit() && exponent.is_64_bit() && modulo.is_64_bit() {\n            let mut result: i64 = 1;\n            let mut base = self.to_int();\n            let mut exp = exponent.to_int();\n            let m = modulo.to_int();\n            base %= m;\n            while exp > 0 {\n                if exp % 2 == 1 {\n                    result = (result * base) % m;\n                }\n                exp >>= 1;\n                base = (base * base) % m;\n            }\n            return BigInt::from_int(result);\n        }\n\n        if exponent.negative {\n            return BigInt::from_str(\"0\");\n        }\n        if exponent.is_zero() {\n            return BigInt::from_str(\"1\");\n        }\n\n        let mut b = exponent.clone();\n        let a = self.r#mod(modulo);\n        let mut result = a.clone();\n        let mut b_save = b.clone();\n        b.dec();\n\n        let mut pow_acc = BigInt::from_str(\"1\");\n        let two = BigInt::from_str(\"2\");\n\n        loop {\n            let div2 = b.div(&two);\n            if !div2.gt_zero() {\n                break;\n            }\n\n            let sq = result.mul(&result);\n            result = sq.r#mod(modulo);\n\n            b = b.div(&two);\n            pow_acc = pow_acc.add(&pow_acc);\n        }\n\n        b_save = b_save.sub(&pow_acc);\n\n        if b_save.is_odd() {\n            let prod = result.mul(&a);\n            result = prod.r#mod(modulo);\n            b_save.dec();\n            pow_acc.inc();\n        }\n\n        if lt(&b_save, &BigInt::from_int(5)) {\n            while !b_save.is_zero() {\n                let prod = result.mul(&a);\n                result = prod.r#mod(modulo);\n                b_save.dec();\n                pow_acc.inc();\n            }\n            return result;\n        }\n\n        let subpart = a.fast_pow(&b_save, modulo);\n        let prod = result.mul(&subpart);\n        result = prod.r#mod(modulo);\n        result\n    }\n\n    pub fn modinv(&self, modulo: &Self) -> Self {\n        let m0 = modulo.clone();\n        let mut y = BigInt::from_str(\"0\");\n        let mut x = BigInt::from_str(\"1\");\n        let one = BigInt::from_str(\"1\");\n        let mut a = self.clone();\n        let mut m = modulo.clone();\n\n        while !a.is_zero() {\n            let q = m.div(&a);\n\n            // t = m - q*a\n            let t1 = q.mul(&a);\n            let t = m.sub(&t1);\n\n            // m = a; a = t\n            m = a.clone();\n            a = t.clone();\n\n            // t = y - q*x\n            let t2 = q.mul(&x);\n            let t = y.sub(&t2);\n\n            // y = x; x = t\n            y = x.clone();\n            x = t.clone();\n        }\n\n        if m.lt_zero() {\n            m = m.add(&m0);\n        }\n\n        if m == one {\n            let mut result = y.r#mod(&m0);\n            if result.lt_zero() {\n                result = result.add(&m0);\n            }\n            return result;\n        }\n        BigInt::from_int(0)\n    }\n\n    pub fn sqrt(&self) -> Self {\n        let one = BigInt::from_str(\"1\");\n        let two = BigInt::from_str(\"2\");\n        let mut low = BigInt::from_str(\"0\");\n        let mut high = self.clone();\n        while lt(&low, &high) {\n            let mid = low.add(&high).div(&two);\n            let sq = mid.mul(&mid);\n            if lt(&sq, self) {\n                low = mid.add(&one);\n            } else {\n                high = mid.clone();\n            }\n        }\n        low\n    }\n\n    pub fn is_even(&self) -> bool {\n        if self.digits.is_empty() {\n            return true;\n        }\n        self.digits[self.digits.len() - 1] % 2 == 0\n    }\n\n    pub fn is_odd(&self) -> bool {\n        if self.digits.is_empty() {\n            return false;\n        }\n        self.digits[self.digits.len() - 1] % 2 == 1\n    }\n\n    pub fn is_prime(&self) -> bool {\n        if self.is_even() {\n            return false;\n        }\n\n        if self.digits.len() > 1 {\n            let last = self.digits[self.digits.len() - 1];\n            if last == 5 || last == 0 {\n                return false;\n            }\n        }\n\n        // Sum of digits divisible by 3?\n        let mut sum = BigInt::from_str(\"0\");\n        for &d in &self.digits {\n            let dig = BigInt::from_int(d as i64);\n            sum = sum.add(&dig);\n        }\n        let three = BigInt::from_str(\"3\");\n        if sum.r#mod(&three).is_zero() {\n            return false;\n        }\n\n        let sqrt_n = self.sqrt();\n        let mut i = BigInt::from_str(\"2\");\n        while le(&i, &sqrt_n) {\n            if self.r#mod(&i).is_zero() {\n                return false;\n            }\n            i.inc();\n        }\n        true\n    }\n}\n\npub fn gt(a: &BigInt, b: &BigInt) -> bool {\n    let ad = effective_slice(&a.digits);\n    let bd = effective_slice(&b.digits);\n    if ad.len() > bd.len() {\n        return !a.negative;\n    }\n    if ad.len() < bd.len() {\n        return a.negative;\n    }\n    for i in 0..ad.len() {\n        if ad[i] > bd[i] {\n            return !a.negative;\n        }\n        if ad[i] < bd[i] {\n            return a.negative;\n        }\n    }\n    false\n}\n\npub fn lt(a: &BigInt, b: &BigInt) -> bool {\n    !ge(a, b)\n}\n\npub fn ge(a: &BigInt, b: &BigInt) -> bool {\n    gt(a, b) || a == b\n}\n\npub fn le(a: &BigInt, b: &BigInt) -> bool {\n    !gt(a, b)\n}\n\npub fn delete(a: &mut BigInt) {\n    a.digits.clear();\n    a.negative = false;\n}\n\nimpl std::ops::Neg for BigInt {\n    type Output = BigInt;\n    fn neg(mut self) -> BigInt {\n        self.negative = !self.negative;\n        self\n    }\n}\n\nimpl PartialEq for BigInt {\n    fn eq(&self, other: &Self) -> bool {\n        let a = effective_slice(&self.digits);\n        let b = effective_slice(&other.digits);\n        if a.len() != b.len() {\n            return false;\n        }\n        if self.negative != other.negative {\n            return false;\n        }\n        a == b\n    }\n}\n\nimpl Eq for BigInt {}\n\nimpl PartialOrd for BigInt {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        if self == other {\n            Some(Ordering::Equal)\n        } else if gt(self, other) {\n            Some(Ordering::Greater)\n        } else {\n            Some(Ordering::Less)\n        }\n    }\n}\n\nimpl fmt::Display for BigInt {\n    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n        if self.negative {\n            write!(f, \"-\")?;\n        }\n        for &d in &self.digits {\n            write!(f, \"{}\", d)?;\n        }\n        Ok(())\n    }\n}\n","numLines":646,"startLine":1,"totalLines":646}}}
