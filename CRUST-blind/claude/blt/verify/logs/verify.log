2 * (n - 1) * node_size.\n        blt_size + 2 * (n - 1) * node_size\n    }","new_string":"    /// Returns the number of bytes used by the tree (excluding key storage).\n    pub fn blt_overhead(&self) -> usize {\n        // Mirror C semantics: sizeof(BLT) plus 2*sizeof(blt_node_s) per pair\n        // of allocated nodes. Use the C struct sizes, not Rust struct sizes.\n        let blt_size = 24usize; // sizeof(struct BLT) on 64-bit C\n        if self.empty != 0 {\n            return blt_size;\n        }\n        let n = self.store().len();\n        let node_size = 16usize; // sizeof(struct blt_node_s) on 64-bit C\n        if n == 0 {\n            return blt_size;\n        }\n        // For n leaves, there are (n-1) pairs of nodes (each pair holds two\n        // siblings). In C `blt_overhead` adds 2*sizeof(blt_node_s) per recursion\n        // when crossing an internal node, accumulating 2*node_size*(n-1).\n        blt_size + 2 * (n - 1) * node_size\n    }"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":486,"cache_read_input_tokens":57829,"cache_creation":{"ephemeral_5m_input_tokens":486,"ephemeral_1h_input_tokens":0},"output_tokens":56,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"224fe0bb-2f1b-4c63-9cb4-30a1e2c588a5","uuid":"dbd13a3e-7440-47b9-868a-89c693fdea60"}
