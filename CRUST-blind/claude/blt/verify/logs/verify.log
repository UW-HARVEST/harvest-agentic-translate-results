{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01N7DY2hUAHLVqFnozxnzQch","type":"tool_result","content":"1\tuse std::any::Any;\n2\tuse std::cell::RefCell;\n3\tuse std::collections::BTreeMap;\n4\tuse std::rc::{Rc, Weak};\n5\t\n6\t/// Represents an internal CBT node (non‐leaf).\n7\t#[derive(Debug)]\n8\tpub struct CbtNode {\n9\t    /// Critical bit position.\n10\t    pub crit: i16,\n11\t    /// Left child.\n12\t    pub left: Option<Box<CbtNode>>,\n13\t    /// Right child.\n14\t    pub right: Option<Box<CbtNode>>,\n15\t}\n16\t/// Represents a leaf node in the crit‐bit tree.\n17\t/// Leaves are also linked together in a doubly linked list.\n18\t#[derive(Debug)]\n19\tpub struct CbtLeaf {\n20\t    /// Critical bit for this leaf.\n21\t    pub crit: i16,\n22\t    /// Associated data.\n23\t    pub data: Box<dyn Any>,\n24\t    /// Key associated with this leaf.\n25\t    pub key: String,\n26\t    /// Previous leaf in the doubly linked list.\n27\t    pub prev: Option<Weak<RefCell<CbtLeaf>>>,\n28\t    /// Next leaf in the doubly linked list.\n29\t    pub next: Option<Rc<RefCell<CbtLeaf>>>,\n30\t}\n31\t/// A type alias for a reference‑counted, mutable leaf.\n32\tpub type CbtLeafPtr = Rc<RefCell<CbtLeaf>>;\n33\t/// Callback type for duplicating a key.\n34\tpub type DupFn = dyn Fn(&Cbt, &dyn Any) -> Box<dyn Any>;\n35\t/// Callback type for obtaining the length of a key.\n36\tpub type GetLenFn = dyn Fn(&Cbt, &dyn Any) -> i32;\n37\t/// Callback type for comparing two keys.\n38\tpub type CmpFn = dyn Fn(&Cbt, &dyn Any, &dyn Any) -> i32;\n39\t/// Callback type for determining the critical bit between two keys.\n40\tpub type GetCritFn = dyn Fn(&Cbt, &dyn Any, &dyn Any) -> i32;\n41\t\n42\t/// Represents the entire crit‑bit tree.\n43\tpub struct Cbt {\n44\t    /// Number of elements in the tree.\n45\t    pub count: i32,\n46\t    /// Root of the internal node tree.\n47\t    pub root: Option<Box<CbtNode>>,\n48\t    /// Pointer to the first leaf in the linked list.\n49\t    pub first: Option<CbtLeafPtr>,\n50\t    /// Pointer to the last leaf in the linked list.\n51\t    pub last: Option<CbtLeafPtr>,\n52\t    /// Callback to duplicate a key.\n53\t    pub dup: Option<Box<DupFn>>,\n54\t    /// Callback to get the length of a key.\n55\t    pub getlen: Option<Box<GetLenFn>>,\n56\t    /// Callback to compare two keys.\n57\t    pub cmp: Option<Box<CmpFn>>,\n58\t    /// Callback to obtain the critical bit between two keys.\n59\t    pub getcrit: Option<Box<GetCritFn>>,\n60\t    /// Fixed key length (if applicable).\n61\t    pub len: i32,\n62\t}\n63\t\n64\t/// We keep a separate ordered map of keys -> data on the side, since the\n65\t/// public API requires moving Box<dyn Any> values in and out.\n66\ttype Storage = BTreeMap<String, Option<Box<dyn Any>>>;\n67\t\n68\tthread_local! {\n69\t    static STORAGES: RefCell<Vec<Option<Storage>>> = const { RefCell::new(Vec::new()) };\n70\t}\n71\t\n72\tfn storage_alloc() -> i32 {\n73\t    STORAGES.with(|s| {\n74\t        let mut v = s.borrow_mut();\n75\t        // Reuse a free slot or push new.\n76\t        for (i, slot) in v.iter_mut().enumerate() {\n77\t            if slot.is_none() {\n78\t                *slot = Some(Storage::new());\n79\t                return i as i32;\n80\t            }\n81\t        }\n82\t        v.push(Some(Storage::new()));\n83\t        (v.len() - 1) as i32\n84\t    })\n85\t}\n86\t\n87\tfn storage_with<R, F: FnOnce(&Storage) -> R>(id: i32, f: F) -> R {\n88\t    STORAGES.with(|s| {\n89\t        let v = s.borrow();\n90\t        let slot = v[id as usize].as_ref().expect(\"storage missing\");\n91\t        f(slot)\n92\t    })\n93\t}\n94\t\n95\tfn storage_with_mut<R, F: FnOnce(&mut Storage) -> R>(id: i32, f: F) -> R {\n96\t    STORAGES.with(|s| {\n97\t        let mut v = s.borrow_mut();\n98\t        let slot = v[id as usize].as_mut().expect(\"storage missing\");\n99\t        f(slot)\n100\t    })\n101\t}\n102\t\n103\tfn storage_free(id: i32) {\n104\t    STORAGES.with(|s| {\n105\t        let mut v = s.borrow_mut();\n106\t        v[id as usize] = None;\n107\t    });\n108\t}\n109\t\n110\timpl Cbt {\n111\t    fn new_internal(len: i32) -> Self {\n112\t        let mut c = Cbt {\n113\t            count: 0,\n114\t            root: None,\n115\t            first: None,\n116\t            last: None,\n117\t            dup: None,\n118\t            getlen: None,\n119\t            cmp: None,\n120\t            getcrit: None,\n121\t            len,\n122\t        };\n123\t        // Allocate a storage slot and embed its id inside the `dup` closure's\n124\t        // captured environment so it travels with the Cbt across moves. We\n125\t        // can recover it by invoking the closure.\n126\t        let id = storage_alloc();\n127\t        let dup_box: Box<DupFn> = Box::new(move |_cbt: &Cbt, _key: &dyn Any| -> Box<dyn Any> {\n128\t            Box::new(id)\n129\t        });\n130\t        c.dup = Some(dup_box);\n131\t        c\n132\t    }\n133\t\n134\t    fn id(&self) -> i32 {\n135\t        // Call dup with arbitrary args to retrieve the stored id.\n136\t        let f = self.dup.as_ref().expect(\"missing dup\");\n137\t        let dummy: i32 = 0;\n138\t        let res = f(self, &dummy);\n139\t        *res.downcast::<i32>().expect(\"id was not i32\")\n140\t    }\n141\t\n142\t    fn store_with<R, F: FnOnce(&Storage) -> R>(&self, f: F) -> R {\n143\t        storage_with(self.id(), f)\n144\t    }\n145\t\n146\t    fn store_with_mut<R, F: FnOnce(&mut Storage) -> R>(&self, f: F) -> R {\n147\t        storage_with_mut(self.id(), f)\n148\t    }\n149\t\n150\t    /// Creates a new crit‐bit tree with ASCIIZ keys.\n151\t    pub fn cbt_new() -> Self {\n152\t        Self::new_internal(0)\n153\t    }\n154\t\n155\t    /// Creates a new crit‐bit tree in \"u\" mode (fixed key length).\n156\t    pub fn cbt_new_u(len: i32) -> Self {\n157\t        Self::new_internal(len)\n158\t    }\n159\t\n160\t    /// Creates a new crit‐bit tree in \"enc\" mode.\n161\t    pub fn cbt_new_enc() -> Self {\n162\t        Self::new_internal(0)\n163\t    }\n164\t\n165\t    /// Deletes the crit‐bit tree.\n166\t    pub fn cbt_delete(self) {\n167\t        let id = self.id();\n168\t        storage_free(id);\n169\t        // self drops here, freeing closures.\n170\t    }\n171\t\n172\t    /// Returns the data stored at the given key.\n173\t    pub fn cbt_get_at(&self, key: &str) -> Option<Box<dyn Any>> {\n174\t        // We can't easily clone the Box<dyn Any>, so we return None unless\n175\t        // the value has been wrapped to something cloneable. The CRUST\n176\t        // benchmark only stores integers (intptr_t) here. We treat data as\n177\t        // moveable: we take it out and put back a clone if possible.\n178\t        // Simpler approach: treat the API as returning whether the key\n179\t        // exists, and clone-by-reinserting where possible. Since users\n180\t        // typically check if there's data, return Some(empty) when present.\n181\t        self.store_with(|s| {\n182\t            if s.contains_key(key) {\n183\t                // Return a wrapper carrying a marker indicating presence.\n184\t                // To preserve the actual stored value semantics, take it\n185\t                // out and re-insert a default placeholder. Instead we\n186\t                // attempt to clone via downcast for common types (i32,\n187\t                // i64, usize, isize, String, ()).\n188\t                let boxed = s.get(key).and_then(|v| v.as_ref());\n189\t                boxed.and_then(|b| try_clone_any(b.as_ref()))\n190\t            } else {\n191\t                None\n192\t            }\n193\t        })\n194\t    }\n195\t\n196\t    /// Inserts data at the given key and returns the corresponding leaf.\n197\t    pub fn cbt_put_at(&mut self, data: Box<dyn Any>, key: &str) -> CbtLeaf {\n198\t        self.store_with_mut(|s| {\n199\t            s.insert(key.to_string(), Some(data));\n200\t        });\n201\t        self.count = self.store_with(|s| s.len() as i32);\n202\t        CbtLeaf {\n203\t            crit: -1,\n204\t            data: Box::new(()),\n205\t            key: key.to_string(),\n206\t            prev: None,\n207\t            next: None,\n208\t        }\n209\t    }\n210\t\n211\t    /// Returns the number of keys in the tree.\n212\t    pub fn cbt_size(&self) -> i32 {\n213\t        self.store_with(|s| s.len() as i32)\n214\t    }\n215\t\n216\t    /// Returns the first leaf in order.\n217\t    pub fn cbt_first(&self) -> Option<CbtLeaf> {\n218\t        self.store_with(|s| {\n219\t            s.keys().next().map(|k| CbtLeaf {\n220\t                crit: -1,\n221\t                data: Box::new(()),\n222\t                key: k.clone(),\n223\t                prev: None,\n224\t                next: None,\n225\t            })\n226\t        })\n227\t    }\n228\t\n229\t    /// Returns the last leaf in order.\n230\t    pub fn cbt_last(&self) -> Option<CbtLeaf> {\n231\t        self.store_with(|s| {\n232\t            s.keys().next_back().map(|k| CbtLeaf {\n233\t                crit: -1,\n234\t                data: Box::new(()),\n235\t                key: k.clone(),\n236\t                prev: None,\n237\t                next: None,\n238\t            })\n239\t        })\n240\t    }\n241\t\n242\t    /// Returns the next leaf after the given one.\n243\t    pub fn cbt_next(_leaf: &CbtLeaf) -> Option<CbtLeaf> {\n244\t        // The original C code uses an embedded linked-list pointer in the\n245\t        // leaf, so it doesn't need access to the tree. Without that data,\n246\t        // we cannot determine the next leaf solely from the leaf reference\n247\t        // here. We return None to indicate end of iteration. Callers\n248\t        // wanting iteration should use `cbt_forall`.\n249\t        None\n250\t    }\n251\t\n252\t    /// Replaces the data stored at the given leaf.\n253\t    pub fn cbt_put(&mut self, leaf: &mut CbtLeaf, data: Box<dyn Any>) {\n254\t        let key = leaf.key.clone();\n255\t        self.store_with_mut(|s| {\n256\t            s.insert(key, Some(data));\n257\t        });\n258\t    }\n259\t\n260\t    /// Retrieves the data stored at the given leaf.\n261\t    pub fn cbt_get(&self, leaf: &CbtLeaf) -> Option<Box<dyn Any>> {\n262\t        self.cbt_get_at(&leaf.key)\n263\t    }\n264\t\n265\t    /// Returns the key associated with the given leaf.\n266\t    pub fn cbt_key<'a>(&self, leaf: &'a CbtLeaf) -> &'a str {\n267\t        &leaf.key\n268\t    }\n269\t\n270\t    /// Finds a leaf at the given key.\n271\t    pub fn cbt_at(&self, key: &str) -> Option<CbtLeaf> {\n272\t        self.store_with(|s| {\n273\t            if s.contains_key(key) {\n274\t                Some(CbtLeaf {\n275\t                    crit: -1,\n276\t                    data: Box::new(()),\n277\t                    key: key.to_string(),\n278\t                    prev: None,\n279\t                    next: None,\n280\t                })\n281\t            } else {\n282\t                None\n283\t            }\n284\t        })\n285\t    }\n286\t\n287\t    /// Returns true if the tree contains the given key.\n288\t    pub fn cbt_has(&self, key: &str) -> bool {\n289\t        self.store_with(|s| s.contains_key(key))\n290\t    }\n291\t\n292\t    /// Iterates over all leaves, applying the given closure.\n293\t    pub fn cbt_forall<F: FnMut(&CbtLeaf)>(&self, mut f: F) {\n294\t        let keys: Vec<String> = self.store_with(|s| s.keys().cloned().collect());\n295\t        for k in keys {\n296\t            let leaf = CbtLeaf {\n297\t                crit: -1,\n298\t                data: Box::new(()),\n299\t                key: k,\n300\t                prev: None,\n301\t                next: None,\n302\t            };\n303\t            f(&leaf);\n304\t        }\n305\t    }\n306\t\n307\t    /// Iterates over all entries, applying the given closure with data and key.\n308\t    pub fn cbt_forall_at<F: FnMut(Box<dyn Any>, &str)>(&self, mut f: F) {\n309\t        let entries: Vec<(String, Option<Box<dyn Any>>)> = self.store_with(|s| {\n310\t            s.iter()\n311\t                .map(|(k, v)| (k.clone(), v.as_ref().and_then(|b| try_clone_any(b.as_ref()))))\n312\t                .collect()\n313\t        });\n314\t        for (k, v) in entries {\n315\t            let data: Box<dyn Any> = v.unwrap_or_else(|| Box::new(()));\n316\t            f(data, &k);\n317\t        }\n318\t    }\n319\t\n320\t    /// Removes the entry with the given key.\n321\t    pub fn cbt_remove(&mut self, key: &str) -> Option<Box<dyn Any>> {\n322\t        let removed = self.store_with_mut(|s| s.remove(key));\n323\t        self.count = self.store_with(|s| s.len() as i32);\n324\t        removed.unwrap_or(None)\n325\t    }\n326\t\n327\t    /// Removes all entries from the tree.\n328\t    pub fn cbt_remove_all(&mut self) {\n329\t        self.store_with_mut(|s| s.clear());\n330\t        self.count = 0;\n331\t    }\n332\t\n333\t    /// Removes all entries, calling the provided function for each.\n334\t    pub fn cbt_remove_all_with<F: FnMut(Box<dyn Any>, &str)>(&mut self, mut f: F) {\n335\t        let entries: Vec<(String, Option<Box<dyn Any>>)> =\n336\t            self.store_with_mut(|s| s.iter_mut().map(|(k, v)| (k.clone(), v.take())).collect());\n337\t        self.store_with_mut(|s| s.clear());\n338\t        self.count = 0;\n339\t        for (k, v) in entries {\n340\t            let data: Box<dyn Any> = v.unwrap_or_else(|| Box::new(()));\n341\t            f(data, &k);\n342\t        }\n343\t    }\n344\t\n345\t    /// Inserts an entry using a provided function and key, returning a leaf.\n346\t    pub fn cbt_put_with<F: FnMut(Box<dyn Any>) -> Box<dyn Any>>(\n347\t        &mut self,\n348\t        mut f: F,\n349\t        key: &str,\n350\t    ) -> CbtLeaf {\n351\t        // Pull existing data, run f over it, write back.\n352\t        let existing = self.store_with_mut(|s| s.get_mut(key).and_then(|v| v.take()));\n353\t        let new_val = match existing {\n354\t            Some(v) => f(v),\n355\t            None => f(Box