{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QiJAPKBZNncqTdyjtJdA3d","type":"tool_result","content":"1\tuse std::any::Any;\n2\tuse std::collections::BTreeMap;\n3\tuse std::ops::Bound;\n4\t\n5\t/// The BLT tree structure.\n6\t#[derive(Debug)]\n7\tpub struct Blt {\n8\t    /// The root node.\n9\t    pub root: Box<BltNode>,\n10\t    /// Indicates whether the tree is empty.\n11\t    pub empty: i32,\n12\t}\n13\t/// A node in the BLT tree.\n14\t#[derive(Debug)]\n15\tpub enum BltNode {\n16\t    /// An internal node.\n17\t    Internal(InternalNode),\n18\t    /// A leaf node (external node).\n19\t    Leaf(BltIt),\n20\t}\n21\t/// Represents an internal node in the BLT tree.\n22\t#[derive(Debug)]\n23\tpub struct InternalNode {\n24\t    /// Byte number of difference (32 bits).\n25\t    pub byte: u32,\n26\t    /// Mask byte (8 bits).\n27\t    pub mask: u8,\n28\t    /// Padding (23 bits stored in a u32).\n29\t    pub padding: u32,\n30\t    /// The child node.\n31\t    pub kid: Box<BltNode>,\n32\t}\n33\t/// Represents a leaf node in the BLT tree.\n34\t#[derive(Debug)]\n35\tpub struct BltIt {\n36\t    /// The key associated with the leaf.\n37\t    pub key: String,\n38\t    /// Associated data.\n39\t    pub data: Option<Box<dyn Any>>,\n40\t}\n41\t\n42\t/// The actual storage container holding the keys and their associated data.\n43\t/// We use a `BTreeMap` to preserve sorted order semantics matching the C\n44\t/// crit-bit tree behaviour.\n45\ttype Store = BTreeMap<String, Option<Box<dyn Any>>>;\n46\t\n47\t/// A sentinel key used to identify the storage container leaf.\n48\tconst STORE_KEY: &str = \"__blt_internal_store__\";\n49\t\n50\timpl Blt {\n51\t    /// Helper that creates the storage container leaf.\n52\t    fn make_root(store: Store) -> Box<BltNode> {\n53\t        Box::new(BltNode::Leaf(BltIt {\n54\t            key: String::from(STORE_KEY),\n55\t            data: Some(Box::new(store)),\n56\t        }))\n57\t    }\n58\t\n59\t    /// Helper to access the store immutably.\n60\t    fn store(&self) -> &Store {\n61\t        match self.root.as_ref() {\n62\t            BltNode::Leaf(it) => it\n63\t                .data\n64\t                .as_ref()\n65\t                .and_then(|d| d.downcast_ref::<Store>())\n66\t                .expect(\"invalid blt root state\"),\n67\t            _ => panic!(\"invalid blt root state\"),\n68\t        }\n69\t    }\n70\t\n71\t    /// Helper to access the store mutably.\n72\t    fn store_mut(&mut self) -> &mut Store {\n73\t        match self.root.as_mut() {\n74\t            BltNode::Leaf(it) => it\n75\t                .data\n76\t                .as_mut()\n77\t                .and_then(|d| d.downcast_mut::<Store>())\n78\t                .expect(\"invalid blt root state\"),\n79\t            _ => panic!(\"invalid blt root state\"),\n80\t        }\n81\t    }\n82\t\n83\t    /// Creates a new BLT tree.\n84\t    pub fn blt_new() -> Self {\n85\t        Blt {\n86\t            root: Self::make_root(BTreeMap::new()),\n87\t            empty: 1,\n88\t        }\n89\t    }\n90\t\n91\t    /// Clears (destroys) the tree.\n92\t    pub fn blt_clear(&mut self) {\n93\t        self.root = Self::make_root(BTreeMap::new());\n94\t        self.empty = 1;\n95\t    }\n96\t\n97\t    /// Retrieves the leaf node at the given key.\n98\t    pub fn blt_get(&self, key: &str) -> Option<BltIt> {\n99\t        if self.empty != 0 {\n100\t            return None;\n101\t        }\n102\t        if self.store().contains_key(key) {\n103\t            Some(BltIt {\n104\t                key: key.to_string(),\n105\t                data: None,\n106\t            })\n107\t        } else {\n108\t            None\n109\t        }\n110\t    }\n111\t\n112\t    /// Creates or retrieves the leaf node at the given key.\n113\t    pub fn blt_set(&mut self, key: &str) -> BltIt {\n114\t        let (it, _is_new) = self.blt_setp(key);\n115\t        it\n116\t    }\n117\t\n118\t    /// Creates or retrieves the leaf node at the given key and returns a tuple (leaf, is_new).\n119\t    pub fn blt_setp(&mut self, key: &str) -> (BltIt, bool) {\n120\t        let is_new = !self.store().contains_key(key);\n121\t        if is_new {\n122\t            self.store_mut().insert(key.to_string(), None);\n123\t            self.empty = 0;\n124\t        }\n125\t        (\n126\t            BltIt {\n127\t                key: key.to_string(),\n128\t                data: None,\n129\t            },\n130\t            is_new,\n131\t        )\n132\t    }\n133\t\n134\t    /// Inserts the given key/data pair and returns the corresponding leaf.\n135\t    pub fn blt_put(&mut self, key: &str, data: Box<dyn Any>) -> BltIt {\n136\t        self.store_mut().insert(key.to_string(), Some(data));\n137\t        self.empty = 0;\n138\t        BltIt {\n139\t            key: key.to_string(),\n140\t            data: None,\n141\t        }\n142\t    }\n143\t\n144\t    /// Inserts the key/data pair only if the key is absent.\n145\t    /// Returns 0 on success or 1 if the key is already present.\n146\t    pub fn blt_put_if_absent(&mut self, key: &str, data: Box<dyn Any>) -> i32 {\n147\t        if self.store().contains_key(key) {\n148\t            1\n149\t        } else {\n150\t            self.store_mut().insert(key.to_string(), Some(data));\n151\t            self.empty = 0;\n152\t            0\n153\t        }\n154\t    }\n155\t\n156\t    /// Deletes the given key from the tree.\n157\t    /// Returns 1 if a key was deleted, 0 otherwise.\n158\t    pub fn blt_delete(&mut self, key: &str) -> i32 {\n159\t        if self.empty != 0 {\n160\t            return 0;\n161\t        }\n162\t        let removed = self.store_mut().remove(key).is_some();\n163\t        if self.store().is_empty() {\n164\t            self.empty = 1;\n165\t        }\n166\t        if removed {\n167\t            1\n168\t        } else {\n169\t            0\n170\t        }\n171\t    }\n172\t\n173\t    /// Iterates over all leaves with keys having the given prefix.\n174\t    /// The closure should return an i32; if it returns 0, iteration stops.\n175\t    pub fn blt_allprefixed<F: FnMut(&BltIt) -> i32>(&self, prefix: &str, mut fun: F) -> i32 {\n176\t        if self.empty != 0 {\n177\t            return 1;\n178\t        }\n179\t        // Collect keys that start with the prefix to avoid borrow issues.\n180\t        let keys: Vec<String> = self\n181\t            .store()\n182\t            .range::<str, _>((Bound::Included(prefix), Bound::Unbounded))\n183\t            .take_while(|(k, _)| k.starts_with(prefix))\n184\t            .map(|(k, _)| k.clone())\n185\t            .collect();\n186\t\n187\t        for k in keys {\n188\t            let it = BltIt {\n189\t                key: k,\n190\t                data: None,\n191\t            };\n192\t            let status = fun(&it);\n193\t            if status != 1 {\n194\t                return status;\n195\t            }\n196\t        }\n197\t        1\n198\t    }\n199\t\n200\t    /// Iterates through all leaves in order and calls the provided closure.\n201\t    pub fn blt_forall<F: FnMut(&BltIt)>(&self, mut fun: F) {\n202\t        let _ = self.blt_allprefixed(\"\", |it| {\n203\t            fun(it);\n204\t            1 // always continue iteration\n205\t        });\n206\t    }\n207\t\n208\t    /// Returns the leaf with the smallest key.\n209\t    pub fn blt_first(&self) -> Option<BltIt> {\n210\t        if self.empty != 0 {\n211\t            return None;\n212\t        }\n213\t        self.store().keys().next().map(|k| BltIt {\n214\t            key: k.clone(),\n215\t            data: None,\n216\t        })\n217\t    }\n218\t\n219\t    /// Returns the leaf with the largest key.\n220\t    pub fn blt_last(&self) -> Option<BltIt> {\n221\t        if self.empty != 0 {\n222\t            return None;\n223\t        }\n224\t        self.store().keys().next_back().map(|k| BltIt {\n225\t            key: k.clone(),\n226\t            data: None,\n227\t        })\n228\t    }\n229\t\n230\t    /// Returns the next leaf (in order) after the given one.\n231\t    pub fn blt_next(&self, it: &BltIt) -> Option<BltIt> {\n232\t        if self.empty != 0 {\n233\t            return None;\n234\t        }\n235\t        self.store()\n236\t            .range::<str, _>((Bound::Excluded(it.key.as_str()), Bound::Unbounded))\n237\t            .next()\n238\t            .map(|(k, _)| BltIt {\n239\t                key: k.clone(),\n240\t                data: None,\n241\t            })\n242\t    }\n243\t\n244\t    /// Returns the previous leaf (in order) before the given one.\n245\t    pub fn blt_prev(&self, it: &BltIt) -> Option<BltIt> {\n246\t        if self.empty != 0 {\n247\t            return None;\n248\t        }\n249\t        self.store()\n250\t            .range::<str, _>((Bound::Unbounded, Bound::Excluded(it.key.as_str())))\n251\t            .next_back()\n252\t            .map(|(k, _)| BltIt {\n253\t                key: k.clone(),\n254\t                data: None,\n255\t            })\n256\t    }\n257\t\n258\t    /// Returns the leaf with the smallest key ≥ the given key.\n259\t    pub fn blt_ceil(&self, key: &str) -> Option<BltIt> {\n260\t        if self.empty != 0 {\n261\t            return None;\n262\t        }\n263\t        self.store()\n264\t            .range::<str, _>((Bound::Included(key), Bound::Unbounded))\n265\t            .next()\n266\t            .map(|(k, _)| BltIt {\n267\t                key: k.clone(),\n268\t                data: None,\n269\t            })\n270\t    }\n271\t\n272\t    /// Returns the leaf with the largest key ≤ the given key.\n273\t    pub fn blt_floor(&self, key: &str) -> Option<BltIt> {\n274\t        if self.empty != 0 {\n275\t            return None;\n276\t        }\n277\t        self.store()\n278\t            .range::<str, _>((Bound::Unbounded, Bound::Included(key)))\n279\t            .next_back()\n280\t            .map(|(k, _)| BltIt {\n281\t                key: k.clone(),\n282\t                data: None,\n283\t            })\n284\t    }\n285\t\n286\t    /// Returns the number of bytes used by the tree (excluding key storage).\n287\t    pub fn blt_overhead(&self) -> usize {\n288\t        // sizeof(BLT) plus 2*sizeof(blt_node_s) per internal node.\n289\t        // Each `blt_node_s` is 16 bytes (4 bytes packed + 8 byte pointer + 4 padding).\n290\t        // With n leaves, there are n-1 pairs of internal nodes (if n >= 1), but\n291\t        // because each internal node points to a pair of nodes, the number of\n292\t        // internal nodes is n-1. We approximate this following the C semantics:\n293\t        //   - blt_overhead returns sizeof(BLT) for empty trees.\n294\t        //   - For n leaves, returns sizeof(BLT) + 2*sizeof(node) * (number of internal nodes).\n295\t        // In the C code, internal node pairs are allocated jointly so the number\n296\t        // of internal nodes counted is (n-1).\n297\t        let blt_size = std::mem::size_of::<Blt>();\n298\t        if self.empty != 0 {\n299\t            return blt_size;\n300\t        }\n301\t        let n = self.store().len();\n302\t        let node_size = 16usize; // size of blt_node_s in C\n303\t        if n == 0 {\n304\t            return blt_size;\n305\t        }\n306\t        // n-1 internal nodes; each counted with size 2*node_size in the C code\n307\t        // because internal node addition adds 2*sizeof(node) per recursion.\n308\t        // Actually in C: `add(p->kid)` and `add(p->kid + 1)` recursively. The\n309\t        // outermost call also adds 2*sizeof(node) for the immediate children.\n310\t        // For n leaves, total internal node count is (n-1), but pairs of\n311\t        // adjacent allocated nodes give 2*(n-1) blt_node_s slots (some are leaves\n312\t        // and some are internal). Simplest: return blt_size + 2 * (n - 1) * node_size.\n313\t        blt_size + 2 * (n - 1) * node_size\n314\t    }\n315\t\n316\t    /// Returns true if the tree is empty.\n317\t    pub fn blt_empty(&self) -> bool {\n318\t        self.empty != 0\n319\t    }\n320\t\n321\t    /// Returns the number of keys in the tree.\n322\t    pub fn blt_size(&self) -> i32 {\n323\t        if self.empty != 0 {\n324\t            return 0;\n325\t        }\n326\t        self.store().len() as i32\n327\t    }\n328\t}\n329\t"}]},"parent_tool_use_id":null,"session_id":"224fe0bb-2f1b-4c63-9cb4-30a1e2c588a5","uuid":"cf6b057d-f5e6-43e4-aaad-7d02432ddf03","timestamp":"2026-05-29T16:55:05.550Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-jI5I5Y/project/src/blt.rs","content":"use std::any::Any;\nuse std::collections::BTreeMap;\nuse std::ops::Bound;\n\n/// The BLT tree structure.\n#[derive(Debug)]\npub struct Blt {\n    /// The root node.\n    pub root: Box<BltNode>,\n    /// Indicates whether the tree is empty.\n    pub empty: i32,\n}\n/// A node in the BLT tree.\n#[derive(Debug)]\npub enum BltNode {\n    /// An internal node.\n    Internal(InternalNode),\n    /// A leaf node (external node).\n    Leaf(BltIt),\n}\n/// Represents an internal node in the BLT tree.\n#[derive(Debug)]\npub struct InternalNode {\n    /// Byte number of difference (32 bits).\n    pub byte: u32,\n    /// Mask byte (8 bits).\n    pub mask: u8,\n    /// Padding (23 bits stored in a u32).\n    pub padding: u32,\n    /// The child node.\n    pub kid: Box<BltNode>,\n}\n/// Represents a leaf node in the BLT tree.\n#[derive(Debug)]\npub struct BltIt {\n    /// The key associated with the leaf.\n    pub key: String,\n    /// Associated data.\n    pub data: Option<Box<dyn Any>>,\n}\n\n/// The actual storage container holding the keys and their associated data.\n/// We use a `BTreeMap` to preserve sorted order semantics matching the C\n/// crit-bit tree behaviour.\ntype Store = BTreeMap<String, Option<Box<dyn Any>>>;\n\n/// A sentinel key used to identify the storage container leaf.\nconst STORE_KEY: &str = \"__blt_internal_store__\";\n\nimpl Blt {\n    /// Helper that creates the storage container leaf.\n    fn make_root(store: Store) -> Box<BltNode> {\n        Box::new(BltNode::Leaf(BltIt {\n            key: String::from(STORE_KEY),\n            data: Some(Box::new(store)),\n        }))\n    }\n\n    /// Helper to access the store immutably.\n    fn store(&self) -> &Store {\n        match self.root.as_ref() {\n            BltNode::Leaf(it) => it\n                .data\n                .as_ref()\n                .and_then(|d| d.downcast_ref::<Store>())\n                .expect(\"invalid blt root state\"),\n            _ => panic!(\"invalid blt root state\"),\n        }\n    }\n\n    /// Helper to access the store mutably.\n    fn store_mut(&mut self) -> &mut Store {\n        match self.root.as_mut() {\n            BltNode::Leaf(it) => it\n                .data\n                .as_mut()\n                .and_then(|d| d.downcast_mut::<Store>())\n                .expect(\"invalid blt root state\"),\n            _ => panic!(\"invalid blt root state\"),\n        }\n    }\n\n    /// Creates a new BLT tree.\n    pub fn blt_new() -> Self {\n        Blt {\n            root: Self::make_root(BTreeMap::new()),\n            empty: 1,\n        }\n    }\n\n    /// Clears (destroys) the tree.\n    pub fn blt_clear(&mut self) {\n        self.root = Self::make_root(BTreeMap::new());\n        self.empty = 1;\n    }\n\n    /// Retrieves the leaf node at the given key.\n    pub fn blt_get(&self, key: &str) -> Option<BltIt> {\n        if self.empty != 0 {\n            return None;\n        }\n        if self.store().contains_key(key) {\n            Some(BltIt {\n                key: key.to_string(),\n                data: None,\n            })\n        } else {\n            None\n        }\n    }\n\n    /// Creates or retrieves the leaf node at the given key.\n    pub fn blt_set(&mut self, key: &str) -> BltIt {\n        let (it, _is_new) = self.blt_setp(key);\n        it\n    }\n\n    /// Creates or retrieves the leaf node at the given key and returns a tuple (leaf, is_new).\n    pub fn blt_setp(&mut self, key: &str) -> (BltIt, bool) {\n        let is_new = !self.store().contains_key(key);\n        if is_new {\n            self.store_mut().insert(key.to_string(), None);\n            self.empty = 0;\n        }\n        (\n            BltIt {\n                key: key.to_string(),\n                data: None,\n            },\n            is_new,\n        )\n    }\n\n    /// Inserts the given key/data pair and returns the corresponding leaf.\n    pub fn blt_put(&mut self, key: &str, data: Box<dyn Any>) -> BltIt {\n        self.store_mut().insert(key.to_string(), Some(data));\n        self.empty = 0;\n        BltIt {\n            key: key.to_string(),\n            data: None,\n        }\n    }\n\n    /// Inserts the key/data pair only if the key is absent.\n    /// Returns 0 on success or 1 if the key is already present.\n    pub fn blt_put_if_absent(&mut self, key: &str, data: Box<dyn Any>) -> i32 {\n        if self.store().contains_key(key) {\n            1\n        } else {\n            self.store_mut().insert(key.to_string(), Some(data));\n            self.empty = 0;\n            0\n        }\n    }\n\n    /// Deletes the given key from the tree.\n    /// Returns 1 if a key was deleted, 0 otherwise.\n    pub fn blt_delete(&mut self, key: &str) -> i32 {\n        if self.empty != 0 {\n            return 0;\n        }\n        let removed = self.store_mut().remove(key).is_some();\n        if self.store().is_empty() {\n            self.empty = 1;\n        }\n        if removed {\n            1\n        } else {\n            0\n        }\n    }\n\n    /// Iterates over all leaves with keys having the given prefix.\n    /// The closure should return an i32; if it returns 0, iteration stops.\n    pub fn blt_allprefixed<F: FnMut(&BltIt) -> i32>(&self, prefix: &str, mut fun: F) -> i32 {\n        if self.empty != 0 {\n            return 1;\n        }\n        // Collect keys that start with the prefix to avoid borrow issues.\n        let keys: Vec<String> = self\n            .store()\n            .range::<str, _>((Bound::Included(prefix), Bound::Unbounded))\n            .take_while(|(k, _)| k.starts_with(prefix))\n            .map(|(k, _)| k.clone())\n            .collect();\n\n        for k in keys {\n            let it = BltIt {\n                key: k,\n                data: None,\n            };\n            let status = fun(&it);\n            if status != 1 {\n                return status;\n            }\n        }\n        1\n    }\n\n    /// Iterates through all leaves in order and calls the provided closure.\n    pub fn blt_forall<F: FnMut(&BltIt)>(&self, mut fun: F) {\n        let _ = self.blt_allprefixed(\"\", |it| {\n            fun(it);\n            1 // always continue iteration\n        });\n    }\n\n    /// Returns the leaf with the smallest key.\n    pub fn blt_first(&self) -> Option<BltIt> {\n        if self.empty != 0 {\n            return None;\n        }\n        self.store().keys().next().map(|k| BltIt {\n            key: k.clone(),\n            data: None,\n        })\n    }\n\n    /// Returns the leaf with the largest key.\n    pub fn blt_last(&self) -> Option<BltIt> {\n        if self.empty != 0 {\n            return None;\n        }\n        self.store().keys().next_back().map(|k| BltIt {\n            key: k.clone(),\n            data: None,\n        })\n    }\n\n    /// Returns the next leaf (in order) after the given one.\n    pub fn blt_next(&self, it: &BltIt) -> Option<BltIt> {\n        if self.empty != 0 {\n            return None;\n        }\n        self.store()\n            .range::<str, _>((Bound::Excluded(it.key.as_str()), Bound::Unbounded))\n            .next()\n            .map(|(k, _)| BltIt {\n                key: k.clone(),\n                data: None,\n            })\n    }\n\n    /// Returns the previous leaf (in order) before the given one.\n    pub fn blt_prev(&self, it: &BltIt) -> Option<BltIt> {\n        if self.empty != 0 {\n            return None;\n        }\n        self.store()\n            .range::<str, _>((Bound::Unbounded, Bound::Excluded(it.key.as_str())))\n            .next_back()\n            .map(|(k, _)| BltIt {\n                key: k.clone(),\n                data: None,\n            })\n    }\n\n    /// Returns the leaf with the smallest key ≥ the given key.\n    pub fn blt_ceil(&self, key: &str) -> Option<BltIt> {\n        if self.empty != 0 {\n            return None;\n        }\n        self.store()\n            .range::<str, _>((Bound::Included(key), Bound::Unbounded))\n            .next()\n            .map(|(k, _)| BltIt {\n                key: k.clone(),\n                data: None,\n            })\n    }\n\n    /// Returns the leaf with the largest key ≤ the given key.\n    pub fn blt_floor(&self, key: &str) -> Option<BltIt> {\n        if self.empty != 0 {\n            return None;\n        }\n        self.store()\n            .range::<str, _>((Bound::Unbounded, Bound::Included(key)))\n            .next_back()\n            .map(|(k, _)| BltIt {\n                key: k.clone(),\n                data: None,\n            })\n    }\n\n    /// Returns the number of bytes used by the tree (excluding key storage).\n    pub fn blt_overhead(&self) -> usize {\n        // sizeof(BLT) plus 2*sizeof(blt_node_s) per internal node.\n        // Each `blt_node_s` is 16 bytes (4 bytes packed + 8 byte pointer + 4 padding).\n        // With n leaves, there are n-1 pairs of internal nodes (if n >= 1), but\n        // because each internal node points to a pair of nodes, the number of\n        // internal nodes is n-1. We approximate this following the C semantics:\n        //   - blt_overhead returns sizeof(BLT) for empty trees.\n        //   - For n leaves, returns sizeof(BLT) + 2*sizeof(node) * (number of internal nodes).\n        // In the C code, internal node pairs are allocated jointly so the number\n        // of internal nodes counted is (n-1).\n        let blt_size = std::mem::size_of::<Blt>();\n        if self.empty != 0 {\n            return blt_size;\n        }\n        let n = self.store().len();\n        let node_size = 16usize; // size of blt_node_s in C\n        if n == 0 {\n            return blt_size;\n        }\n        // n-1 internal nodes; each counted with size 2*node_size in the C code\n        // because internal node addition adds 2*sizeof(node) per recursion.\n        // Actually in C: `add(p->kid)` and `add(p->kid + 1)` recursively. The\n        // outermost call also adds 2*sizeof(node) for the immediate children.\n        // For n leaves, total internal node count is (n-1), but pairs of\n        // adjacent allocated nodes give 2*(n-1) blt_node_s slots (some are leaves\n        // and some are internal). Simplest: return blt_size + 2 * (n - 1) * node_size.\n        blt_size + 2 * (n - 1) * node_size\n    }\n\n    /// Returns true if the tree is empty.\n    pub fn blt_empty(&self) -> bool {\n        self.empty != 0\n    }\n\n    /// Returns the number of keys in the tree.\n    pub fn blt_size(&self) -> i32 {\n        if self.empty != 0 {\n            return 0;\n        }\n        self.store().len() as i32\n    }\n}\n","numLines":329,"startLine":1,"totalLines":329}}}
