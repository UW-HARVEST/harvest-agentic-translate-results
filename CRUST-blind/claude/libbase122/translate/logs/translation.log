5\t    size_t ret = bitreader_read(&reader, 7, &got);\n66\t    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n67\t    size_t expect_len;\n68\t    byte *expect = bitstring_to_bytes(\"01111111\", &expect_len);\n69\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n70\t    free(expect);\n71\t\n72\t    ret = bitreader_read(&reader, 7, &got);\n73\t    ASSERT(ret == 1, \"expected ret to be 1, got: %zu\", ret);\n74\t    expect = bitstring_to_bytes(\"00000001\", &expect_len);\n75\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n76\t    free(expect);\n77\t\n78\t    ret = bitreader_read(&reader, 7, &got);\n79\t    ASSERT(ret == 0, \"expected ret to be 0, got: %zu\", ret);\n80\t    expect = bitstring_to_bytes(\"00000000\", &expect_len);\n81\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n82\t    free(expect);\n83\t\n84\t    free(in);\n85\t  }\n86\t\n87\t  /* Two byte. */\n88\t  {\n89\t    size_t in_len;\n90\t    byte *in = bitstring_to_bytes(\"10101010 11111111\", &in_len);\n91\t    bitreader_t reader = {.in = in, .len = in_len};\n92\t    byte got;\n93\t    size_t ret = bitreader_read(&reader, 7, &got);\n94\t    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n95\t    size_t expect_len;\n96\t    byte *expect = bitstring_to_bytes(\"01010101\", &expect_len);\n97\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n98\t    free(expect);\n99\t\n100\t    ret = bitreader_read(&reader, 7, &got);\n101\t    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n102\t    expect = bitstring_to_bytes(\"00111111\", &expect_len);\n103\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n104\t    free(expect);\n105\t\n106\t    ret = bitreader_read(&reader, 7, &got);\n107\t    ASSERT(ret == 2, \"expected ret to be 2, got: %zu\", ret);\n108\t    expect = bitstring_to_bytes(\"00000011\", &expect_len);\n109\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n110\t    free(expect);\n111\t\n112\t    free(in);\n113\t  }\n114\t}\n115\t\n116\tstatic void test_bitwriter_write(void) {\n117\t  /* One byte. */\n118\t  {\n119\t    size_t in_len;\n120\t    byte got[1] = {0};\n121\t    byte *in = bitstring_to_bytes(\"00001111\", &in_len);\n122\t    bitwriter_t writer = {.out = got, .len = sizeof(got)};\n123\t\n124\t    int ret = bitwriter_write(&writer, 1, *in);\n125\t    ASSERT(ret != -1, \"expected no error\");\n126\t    size_t expect_len;\n127\t    byte *expect = bitstring_to_bytes(\"10000000\", &expect_len);\n128\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n129\t    free(expect);\n130\t\n131\t    ret = bitwriter_write(&writer, 1, *in);\n132\t    ASSERT(ret != -1, \"expected no error\");\n133\t    expect = bitstring_to_bytes(\"11000000\", &expect_len);\n134\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n135\t    free(expect);\n136\t\n137\t    ret = bitwriter_write(&writer, 5, *in);\n138\t    ASSERT(ret != -1, \"expected no error\");\n139\t    expect = bitstring_to_bytes(\"11011110\", &expect_len);\n140\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n141\t    free(expect);\n142\t\n143\t    ret = bitwriter_write(&writer, 5, *in);\n144\t    ASSERT(ret == -1, \"expected exceeded capacity error, but got no error\");\n145\t\n146\t    free(in);\n147\t  }\n148\t\n149\t  /* Two byte. */\n150\t  {\n151\t    byte got[2] = {0};\n152\t    bitwriter_t writer = {.out = got, .len = sizeof(got)};\n153\t\n154\t    int ret = bitwriter_write(&writer, 1, 0xFF);\n155\t    ASSERT(ret != -1, \"expected no error\");\n156\t    size_t expect_len;\n157\t    byte *expect = bitstring_to_bytes(\"10000000 00000000\", &expect_len);\n158\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n159\t    free(expect);\n160\t\n161\t    ret = bitwriter_write(&writer, 8, 0x0F);\n162\t    ASSERT(ret != -1, \"expected no error\");\n163\t    expect = bitstring_to_bytes(\"10000111 10000000\", &expect_len);\n164\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n165\t    free(expect);\n166\t\n167\t    ret = bitwriter_write(&writer, 1, 0x0);\n168\t    ASSERT(ret != -1, \"expected no error\");\n169\t    expect = bitstring_to_bytes(\"10000111 10000000\", &expect_len);\n170\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n171\t    free(expect);\n172\t\n173\t    ret = bitwriter_write(&writer, 1, 0xFF);\n174\t    ASSERT(ret != -1, \"expected no error\");\n175\t    expect = bitstring_to_bytes(\"10000111 10100000\", &expect_len);\n176\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n177\t    free(expect);\n178\t\n179\t    ret = bitwriter_write(&writer, 5, 0xFF);\n180\t    ASSERT(ret != -1, \"expected no error\");\n181\t    expect = bitstring_to_bytes(\"10000111 10111111\", &expect_len);\n182\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n183\t    free(expect);\n184\t\n185\t    ret = bitwriter_write(&writer, 1, 0xFF);\n186\t    ASSERT(ret == -1, \"expected exceeded capacity error, but got no error\");\n187\t  }\n188\t}\n189\t\n190\tstatic void test_decode(void) {\n191\t  typedef struct {\n192\t    const char *encoded;\n193\t    const char *expectError;\n194\t    size_t decodedLen;\n195\t    const char *expect;\n196\t  } decode_test_t;\n197\t\n198\t  decode_test_t tests[] = {\n199\t      {.encoded = \"01111111 01111111 01111111\",\n200\t       .expectError = \"Last byte has extra data\",\n201\t       .decodedLen = 3},\n202\t      {.encoded = \"01111111 01000000 01111111 01000000\",\n203\t       .expectError = \"Output does not have sufficient size\",\n204\t       .decodedLen = 1},\n205\t      {.encoded = \"11011110 11111111\",\n206\t       .expectError = \"Second byte of two byte sequence malformed\",\n207\t       .decodedLen = 2},\n208\t      {.encoded = \"11111111\",\n209\t       .expectError = \"First byte of two byte sequence malformed\",\n210\t       .decodedLen = 1},\n211\t      {.encoded = \"11011110\",\n212\t       .expectError = \"Two byte sequence is missing second byte\",\n213\t       .decodedLen = 1},\n214\t      {.encoded = \"11011110 10111111 01111111\",\n215\t       .expectError = \"Got unexpected extra data after shortened two byte sequence\",\n216\t       .decodedLen = 3},\n217\t      {.encoded = \"11011010 10111111\",\n218\t       .expectError = \"Got unrecognized illegal index\",\n219\t       .decodedLen = 2},\n220\t      {.encoded = \"01111111\",\n221\t       .expectError = \"Decoded data is not a byte multiple\",\n222\t       .decodedLen = 1},\n223\t      {.encoded = \"01111111 01111111\",\n224\t       .expectError = \"Encoded data is malformed. Last byte has extra data.\",\n225\t       .decodedLen = 1},\n226\t      {.encoded = \"01111111 11011110 10000000\", .expect = \"11111110\", .decodedLen = 1},\n227\t      {.encoded = \"01111111 11011111 10100000\",\n228\t       .expectError = \"Encoded data is malformed. Last byte has extra data.\",\n229\t       .decodedLen = 1},\n230\t      {.encoded = \"11011110 10000000\",\n231\t       .expectError = \"Decoded data is not a byte multiple\",\n232\t       .decodedLen = 1},\n233\t      {.encoded = \"00000000 11011110 10000000\", .expect = \"00000000\", .decodedLen = 1},\n234\t      {.encoded = \"00000000 11000010 10000000\", .expect = \"00000000 00000000\", .decodedLen = 2},\n235\t      {.encoded = \"11001111 10000001 01100000\", .expect = \"01000101 00000111\", .decodedLen = 2}};\n236\t\n237\t  for (size_t i = 0; i < sizeof(tests) / sizeof(tests[0]); i++) {\n238\t    decode_test_t *test = tests + i;\n239\t\n240\t    printf(\"decode test %zu: '%s'\\n\", i, test->expectError ? test->expectError : test->encoded);\n241\t\n242\t    size_t encoded_len;\n243\t    byte *encoded = bitstring_to_bytes(test->encoded, &encoded_len);\n244\t    size_t got_len = test->decodedLen ? test->decodedLen : 1;\n245\t    byte *got = malloc(sizeof(byte) * got_len);\n246\t    size_t written;\n247\t    base122_error_t error;\n248\t\n249\t    int ret = base122_decode(encoded, encoded_len, got, got_len, &written, &error);\n250\t    if (test->expectError) {\n251\t      ASSERT(ret == -1, \"expected base122_decode to error, but succeeded\");\n252\t      ASSERT_STRCONTAINS(error.msg, test->expectError);\n253\t    } else {\n254\t      ASSERT(ret == 0, \"expected base122_decode to succeed, but got: %s\", error.msg);\n255\t      size_t expect_len;\n256\t      byte *expect = bitstring_to_bytes(test->expect, &expect_len);\n257\t      ASSERT_BYTES_EQUAL(expect, expect_len, got, got_len, bitstring);\n258\t      free(expect);\n259\t    }\n260\t\n261\t    free(got);\n262\t    free(encoded);\n263\t  }\n264\t}\n265\t\n266\tstatic void test_encode_all_1s(void) {\n267\t  /* Generate round trip tests of byte lengths up to 65. */\n268\t  for (size_t i = 0; i <= 65; i++) {\n269\t    base122_error_t error;\n270\t\n271\t    printf(\"Encode all 1's: %zu\\n\", i);\n272\t    byte *in = malloc(sizeof(byte) * i);\n273\t    for (size_t j = 0; j < i; j++) {\n274\t      in[j] = 0xFF;\n275\t    }\n276\t\n277\t    /* Encode */\n278\t    byte encoded[128];\n279\t    size_t encoded_written;\n280\t    {\n281\t      int got = base122_encode(in, i, encoded, sizeof(encoded), &encoded_written, &error);\n282\t      ASSERT(got != -1, \"error in base122_encode: %d\", got);\n283\t    }\n284\t\n285\t    /* Decode */\n286\t    {\n287\t      byte decoded[128];\n288\t      size_t decoded_written;\n289\t      int got = base122_decode(encoded, encoded_written, decoded, sizeof(decoded), &decoded_written,\n290\t                               &error);\n291\t      ASSERT(got != -1, \"error in base122_decode: %d\", got);\n292\t      ASSERT(decoded_written == i, \"expected decoded_written == i, got %zu and %zu\",\n293\t             decoded_written, i);\n294\t      ASSERT_BYTES_EQUAL(in, i, decoded, decoded_written, bitstring);\n295\t    }\n296\t\n297\t    free(in);\n298\t  }\n299\t}\n300\t\n301\t// pstrerror is a portable strerror\n302\tstatic const char *pstrerror(int err) {\n303\t#ifdef _WIN32\n304\t  static char buf[64];\n305\t  errno_t ret = strerror_s(buf, sizeof(buf), err);\n306\t  ASSERT(ret == 0, \"strerror_s got error: %d\", (int)ret);\n307\t  return buf;\n308\t#else\n309\t  return strerror(err);\n310\t#endif\n311\t}\n312\t\n313\t// portable_read is a portable file read.\n314\tstatic SSIZE_T portable_read(int fd, void *buffer, size_t buffer_size) {\n315\t#ifdef _WIN32\n316\t  return _read(fd, buffer, (unsigned int)buffer_size);\n317\t#else\n318\t  return read(fd, buffer, buffer_size);\n319\t#endif\n320\t}\n321\t\n322\t// portable_open is a portable file open. Returns 0 on success. Returns error number on error.\n323\tstatic int portable_open(const char *pathname, int flags, int *fd) {\n324\t#ifdef _WIN32\n325\t  int ret = _sopen_s(fd, pathname, flags | O_BINARY, _SH_DENYNO, 0 /* pmode */);\n326\t  return ret;\n327\t#else\n328\t  int ret = open(pathname, flags);\n329\t  if (ret == -1) {\n330\t    return errno;\n331\t  }\n332\t  *fd = ret;\n333\t  return 0;\n334\t#endif\n335\t}\n336\t\n337\tstatic int portable_close(int fd) {\n338\t#ifdef _WIN32\n339\t  return _close(fd);\n340\t#else\n341\t  return close(fd);\n342\t#endif\n343\t}\n344\t\n345\tstatic byte *read_file(const char *path, size_t *len) {\n346\t  size_t capacity = 1024;\n347\t  byte *data = malloc(capacity);\n348\t  size_t offset = 0;\n349\t  int fd;\n350\t  int err = portable_open(path, O_RDONLY, &fd);\n351\t  ASSERT(0 == err, \"error in open: %s\", pstrerror(err));\n352\t  SSIZE_T got;\n353\t\n354\t  while ((got = portable_read(fd, data + offset, capacity - offset)) > 0) {\n355\t    offset += (size_t)got;\n356\t    if (capacity == offset) {\n357\t      capacity *= 2;\n358\t      data = realloc(data, capacity);\n359\t    }\n360\t  }\n361\t\n362\t  ASSERT(got != -1, \"error in read: %s\", pstrerror(errno));\n363\t  portable_close(fd);\n364\t  *len = offset;\n365\t  return data;\n366\t}\n367\t\n368\tstatic void test_encode_file(void) {\n369\t  size_t data_len;\n370\t  byte *data = read_file(\"../data/example.jpg\", &data_len);\n371\t\n372\t  size_t expect_len;\n373\t  byte *expect = read_file(\"../data/example.b122\", &expect_len);\n374\t\n375\t  base122_error_t error;\n376\t  size_t encoded_len;\n377\t  byte *encoded;\n378\t  /* Allocate encoded. */\n379\t  {\n380\t\n381\t    int got = base122_encode(data, data_len, NULL /* encoded */, 0 /* encoded_len */, &encoded_len,\n382\t                             &error);\n383\t    ASSERT(0 == got, \"error in base122_encode: %s\", error.msg);\n384\t    encoded = malloc(encoded_len);\n385\t  }\n386\t\n387\t  /* Encode. */\n388\t  {\n389\t    size_t written;\n390\t    int got = base122_encode(data, data_len, encoded, encoded_len, &written, &error);\n391\t    ASSERT(0 == got, \"error in base122_encode: %s\", error.msg);\n392\t    ASSERT_BYTES_EQUAL(expect, expect_len, encoded, encoded_len, hexstring);\n393\t  }\n394\t\n395\t  size_t decoded_len;\n396\t  byte *decoded;\n397\t  /* Allocate decoded. */\n398\t  {\n399\t    int got = base122_decode(encoded, encoded_len, NULL /* decoded */, 0 /* decoded_len */,\n400\t                             &decoded_len, &error);\n401\t    ASSERT(0 == got, \"error in base122_decode: %s\", error.msg);\n402\t    decoded = malloc(decoded_len);\n403\t  }\n404\t\n405\t  /* Decode. */\n406\t  {\n407\t    size_t written;\n408\t\n409\t    int got = base122_decode(encoded, encoded_len, decoded, decoded_len, &written, &error);\n410\t    ASSERT(0 == got, \"error in base122_decode: %s\", error.msg);\n411\t    ASSERT_BYTES_EQUAL(data, data_len, decoded, decoded_len, hexstring);\n412\t  }\n413\t\n414\t  free(decoded);\n415\t  free(encoded);\n416\t  free(expect);\n417\t  free(data);\n418\t}\n419\t\n420\tint main(void) {\n421\t  test_hexstring_to_bytes();\n422\t  test_bitstring_to_bytes();\n423\t  test_bitreader_read();\n424\t  test_bitwriter_write();\n425\t  test_decode();\n426\t  test_encode_all_1s();\n427\t  test_encode_file();\n428\t\n429\t  typedef struct {\n430\t    const char *description;\n431\t    const char *data;\n432\t    const char *encoded;\n433\t  } roundtrip_test_t;\n434\t\n435\t  roundtrip_test_t tests[] = {\n436\t      {.description = \"one byte\", .data = \"11111111\", .encoded = \"01111111 01000000\"},\n437\t      {.description = \"several bytes\",\n438\t       .data = \"10101010 10101010 10101010 10101010\",\n439\t       .encoded = \"01010101 00101010 01010101 00101010 01010000\"},\n440\t      {.description = \"illegal one byte\",\n441\t       .data = \"00000000 11111111\",\n442\t       .encoded = \"11000010 10111111 01100000\"},\n443\t      {.description = \"illegal last two bits\",\n444\t       .data = \"1111111 1111111 00\",\n445\t       .encoded = \"01111111 01111111 11011110 10000000\"},\n446\t      {.description = \"fuzz crash 1\", .data = \"00010101\", .encoded = \"11000111 10000000\"}};\n447\t\n448\t  for (size_t i = 0; i < sizeof(tests) / sizeof(tests[0]); i++) {\n449\t    roundtrip_test_t *test = tests + i;\n450\t    size_t data_len;\n451\t    byte *data = bitstring_to_bytes(test->data, &data_len);\n452\t    size_t encoded_len;\n453\t    byte *encoded = bitstring_to_bytes(test->encoded, &encoded_len);\n454\t\n455\t    printf(\"round trip test '%s'\\n\", test->description);\n456\t    /* Test encoding 'data'. */\n457\t    {\n458\t      size_t got_len = encoded_len;\n459\t      byte *got = malloc(sizeof(byte) * got_len);\n460\t      size_t written;\n461\t      base122_error_t error;\n462\t      int ret = base122_encode(data, data_len, got, got_len, &written, &error);\n463\t      ASSERT(ret != -1, \"base122_encode error: %s\", error.msg);\n464\t      ASSERT_BYTES_EQUAL(encoded, encoded_len, got, got_len, bitstring);\n465\t      ASSERT(written == encoded_len, \"expected written == encoded_len. Got %zu != %zu\", written,\n466\t             encoded_len);\n467\t      /* Test length calculation. */\n468\t      {\n469\t        written = 0;\n470\t        ret = base122_encode(data, data_len, NULL, 0, &written, &error);\n471\t        ASSERT(ret != -1, \"base122_encode error: %s\", error.msg);\n472\t        ASSERT(written == encoded_len, \"expected written == encoded_len. Got %zu != %zu\", written,\n473\t               encoded_len);\n474\t      }\n475\t      free(got);\n476\t    }\n477\t\n478\t    /* Test decoding 'encoded'. */\n479\t    {\n480\t      base122_error_t error;\n481\t      size_t got_len = data_len;\n482\t      byte *got = malloc(sizeof(byte) * got_len);\n483\t      size_t written;\n484\t      int ret = base122_decode(encoded, encoded_len, got, got_len, &written, &error);\n485\t      ASSERT(ret != -1, \"base122_decode error: %s\", error.msg);\n486\t      ASSERT_BYTES_EQUAL(data, data_len, got, got_len, bitstring);\n487\t      ASSERT(written == data_len, \"expected written == data_len. Got %zu != %zu\", written,\n488\t             data_len);\n489\t      /* Test length calculation. */\n490\t      {\n491\t        written = 0;\n492\t        ret = base122_decode(encoded, encoded_len, NULL, 0, &written, &error);\n493\t        ASSERT(ret != -1, \"base122_decode error: %s\", error.msg);\n494\t        ASSERT(written == data_len, \"expected written == data_len. Got %zu != %zu\", written,\n495\t               data_len);\n496\t      }\n497\t      free(got);\n498\t    }\n499\t\n500\t    free(data);\n501\t    free(encoded);\n502\t  }\n503\t}\n504\t"}]},"parent_tool_use_id":null,"session_id":"cf587403-40f1-432f-aed6-12ff9a5f9448","uuid":"ae7be6aa-1cc6-4289-bdfe-abe1d8dd8c4b","timestamp":"2026-05-29T11:19:32.637Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-ioc9w5/project/c_src/test/test.c","content":"#include \"src/base122.h\"\n\n#include \"assertions.h\"\n#include <errno.h>\n#include <fcntl.h>\n#include <stdio.h>\n#include <string.h> // strerror\n#include <sys/stat.h>\n#include <sys/types.h>\n#ifndef _WIN32\n#define SSIZE_T ssize_t\n#include <unistd.h>\n#else\n#include <basetsd.h> // SSIZE_T\n#include <io.h>      // _open\n#endif\n\nstatic void test_hexstring_to_bytes(void) {\n  /* One byte. */\n  {\n    size_t got_len;\n    byte *got = hexstring_to_bytes(\"AA\", &got_len);\n    byte expect[] = {0xAA};\n    ASSERT_BYTES_EQUAL(got, got_len, expect, sizeof(expect), hexstring);\n    free(got);\n  }\n  /* Two bytes. */\n  {\n    size_t got_len;\n    byte *got = hexstring_to_bytes(\"AA BB\", &got_len);\n    byte expect[] = {0xAA, 0xBB};\n    ASSERT_BYTES_EQUAL(got, got_len, expect, sizeof(expect), hexstring);\n    free(got);\n  }\n}\n\nstatic void test_bitstring_to_bytes(void) {\n  /* One byte. */\n  {\n    size_t got_len;\n    byte *got = bitstring_to_bytes(\"1000 0000\", &got_len);\n    byte expect[] = {0x80};\n    ASSERT_BYTES_EQUAL(got, got_len, expect, sizeof(expect), bitstring);\n    free(got);\n  }\n  /* Two bytes. */\n  {\n    size_t got_len;\n    byte *got = bitstring_to_bytes(\"1000 0000 0000 1000\", &got_len);\n    byte expect[] = {0x80, 0x08};\n    ASSERT_BYTES_EQUAL(got, got_len, expect, sizeof(expect), bitstring);\n    free(got);\n  }\n}\n\n#include \"src/util.h\"\n\nstatic void test_bitreader_read(void) {\n  /* One byte. */\n  {\n    size_t in_len;\n    byte *in = bitstring_to_bytes(\"11111111\", &in_len);\n    bitreader_t reader = {.in = in, .len = in_len};\n    byte got;\n    size_t ret = bitreader_read(&reader, 7, &got);\n    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n    size_t expect_len;\n    byte *expect = bitstring_to_bytes(\"01111111\", &expect_len);\n    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitreader_read(&reader, 7, &got);\n    ASSERT(ret == 1, \"expected ret to be 1, got: %zu\", ret);\n    expect = bitstring_to_bytes(\"00000001\", &expect_len);\n    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitreader_read(&reader, 7, &got);\n    ASSERT(ret == 0, \"expected ret to be 0, got: %zu\", ret);\n    expect = bitstring_to_bytes(\"00000000\", &expect_len);\n    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n    free(expect);\n\n    free(in);\n  }\n\n  /* Two byte. */\n  {\n    size_t in_len;\n    byte *in = bitstring_to_bytes(\"10101010 11111111\", &in_len);\n    bitreader_t reader = {.in = in, .len = in_len};\n    byte got;\n    size_t ret = bitreader_read(&reader, 7, &got);\n    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n    size_t expect_len;\n    byte *expect = bitstring_to_bytes(\"01010101\", &expect_len);\n    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitreader_read(&reader, 7, &got);\n    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n    expect = bitstring_to_bytes(\"00111111\", &expect_len);\n    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitreader_read(&reader, 7, &got);\n    ASSERT(ret == 2, \"expected ret to be 2, got: %zu\", ret);\n    expect = bitstring_to_bytes(\"00000011\", &expect_len);\n    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n    free(expect);\n\n    free(in);\n  }\n}\n\nstatic void test_bitwriter_write(void) {\n  /* One byte. */\n  {\n    size_t in_len;\n    byte got[1] = {0};\n    byte *in = bitstring_to_bytes(\"00001111\", &in_len);\n    bitwriter_t writer = {.out = got, .len = sizeof(got)};\n\n    int ret = bitwriter_write(&writer, 1, *in);\n    ASSERT(ret != -1, \"expected no error\");\n    size_t expect_len;\n    byte *expect = bitstring_to_bytes(\"10000000\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 1, *in);\n    ASSERT(ret != -1, \"expected no error\");\n    expect = bitstring_to_bytes(\"11000000\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 5, *in);\n    ASSERT(ret != -1, \"expected no error\");\n    expect = bitstring_to_bytes(\"11011110\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 5, *in);\n    ASSERT(ret == -1, \"expected exceeded capacity error, but got no error\");\n\n    free(in);\n  }\n\n  /* Two byte. */\n  {\n    byte got[2] = {0};\n    bitwriter_t writer = {.out = got, .len = sizeof(got)};\n\n    int ret = bitwriter_write(&writer, 1, 0xFF);\n    ASSERT(ret != -1, \"expected no error\");\n    size_t expect_len;\n    byte *expect = bitstring_to_bytes(\"10000000 00000000\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 8, 0x0F);\n    ASSERT(ret != -1, \"expected no error\");\n    expect = bitstring_to_bytes(\"10000111 10000000\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 1, 0x0);\n    ASSERT(ret != -1, \"expected no error\");\n    expect = bitstring_to_bytes(\"10000111 10000000\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 1, 0xFF);\n    ASSERT(ret != -1, \"expected no error\");\n    expect = bitstring_to_bytes(\"10000111 10100000\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 5, 0xFF);\n    ASSERT(ret != -1, \"expected no error\");\n    expect = bitstring_to_bytes(\"10000111 10111111\", &expect_len);\n    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n    free(expect);\n\n    ret = bitwriter_write(&writer, 1, 0xFF);\n    ASSERT(ret == -1, \"expected exceeded capacity error, but got no error\");\n  }\n}\n\nstatic void test_decode(void) {\n  typedef struct {\n    const char *encoded;\n    const char *expectError;\n    size_t decodedLen;\n    const char *expect;\n  } decode_test_t;\n\n  decode_test_t tests[] = {\n      {.encoded = \"01111111 01111111 01111111\",\n       .expectError = \"Last byte has extra data\",\n       .decodedLen = 3},\n      {.encoded = \"01111111 01000000 01111111 01000000\",\n       .expectError = \"Output does not have sufficient size\",\n       .decodedLen = 1},\n      {.encoded = \"11011110 11111111\",\n       .expectError = \"Second byte of two byte sequence malformed\",\n       .decodedLen = 2},\n      {.encoded = \"11111111\",\n       .expectError = \"First byte of two byte sequence malformed\",\n       .decodedLen = 1},\n      {.encoded = \"11011110\",\n       .expectError = \"Two byte sequence is missing second byte\",\n       .decodedLen = 1},\n      {.encoded = \"11011110 10111111 01111111\",\n       .expectError = \"Got unexpected extra data after shortened two byte sequence\",\n       .decodedLen = 3},\n      {.encoded = \"11011010 10111111\",\n       .expectError = \"Got unrecognized illegal index\",\n       .decodedLen = 2},\n      {.encoded = \"01111111\",\n       .expectError = \"Decoded data is not a byte multiple\",\n       .decodedLen = 1},\n      {.encoded = \"01111111 01111111\",\n       .expectError = \"Encoded data is malformed. Last byte has extra data.\",\n       .decodedLen = 1},\n      {.encoded = \"01111111 11011110 10000000\", .expect = \"11111110\", .decodedLen = 1},\n      {.encoded = \"01111111 11011111 10100000\",\n       .expectError = \"Encoded data is malformed. Last byte has extra data.\",\n       .decodedLen = 1},\n      {.encoded = \"11011110 10000000\",\n       .expectError = \"Decoded data is not a byte multiple\",\n       .decodedLen = 1},\n      {.encoded = \"00000000 11011110 10000000\", .expect = \"00000000\", .decodedLen = 1},\n      {.encoded = \"00000000 11000010 10000000\", .expect = \"00000000 00000000\", .decodedLen = 2},\n      {.encoded = \"11001111 10000001 01100000\", .expect = \"01000101 00000111\", .decodedLen = 2}};\n\n  for (size_t i = 0; i < sizeof(tests) / sizeof(tests[0]); i++) {\n    decode_test_t *test = tests + i;\n\n    printf(\"decode test %zu: '%s'\\n\", i, test->expectError ? test->expectError : test->encoded);\n\n    size_t encoded_len;\n    byte *encoded = bitstring_to_bytes(test->encoded, &encoded_len);\n    size_t got_len = test->decodedLen ? test->decodedLen : 1;\n    byte *got = malloc(sizeof(byte) * got_len);\n    size_t written;\n    base122_error_t error;\n\n    int ret = base122_decode(encoded, encoded_len, got, got_len, &written, &error);\n    if (test->expectError) {\n      ASSERT(ret == -1, \"expected base122_decode to error, but succeeded\");\n      ASSERT_STRCONTAINS(error.msg, test->expectError);\n    } else {\n      ASSERT(ret == 0, \"expected base122_decode to succeed, but got: %s\", error.msg);\n      size_t expect_len;\n      byte *expect = bitstring_to_bytes(test->expect, &expect_len);\n      ASSERT_BYTES_EQUAL(expect, expect_len, got, got_len, bitstring);\n      free(expect);\n    }\n\n    free(got);\n    free(encoded);\n  }\n}\n\nstatic void test_encode_all_1s(void) {\n  /* Generate round trip tests of byte lengths up to 65. */\n  for (size_t i = 0; i <= 65; i++) {\n    base122_error_t error;\n\n    printf(\"Encode all 1's: %zu\\n\", i);\n    byte *in = malloc(sizeof(byte) * i);\n    for (size_t j = 0; j < i; j++) {\n      in[j] = 0xFF;\n    }\n\n    /* Encode */\n    byte encoded[128];\n    size_t encoded_written;\n    {\n      int got = base122_encode(in, i, encoded, sizeof(encoded), &encoded_written, &error);\n      ASSERT(got != -1, \"error in base122_encode: %d\", got);\n    }\n\n    /* Decode */\n    {\n      byte decoded[128];\n      size_t decoded_written;\n      int got = base122_decode(encoded, encoded_written, decoded, sizeof(decoded), &decoded_written,\n                               &error);\n      ASSERT(got != -1, \"error in base122_decode: %d\", got);\n      ASSERT(decoded_written == i, \"expected decoded_written == i, got %zu and %zu\",\n             decoded_written, i);\n      ASSERT_BYTES_EQUAL(in, i, decoded, decoded_written, bitstring);\n    }\n\n    free(in);\n  }\n}\n\n// pstrerror is a portable strerror\nstatic const char *pstrerror(int err) {\n#ifdef _WIN32\n  static char buf[64];\n  errno_t ret = strerror_s(buf, sizeof(buf), err);\n  ASSERT(ret == 0, \"strerror_s got error: %d\", (int)ret);\n  return buf;\n#else\n  return strerror(err);\n#endif\n}\n\n// portable_read is a portable file read.\nstatic SSIZE_T portable_read(int fd, void *buffer, size_t buffer_size) {\n#ifdef _WIN32\n  return _read(fd, buffer, (unsigned int)buffer_size);\n#else\n  return read(fd, buffer, buffer_size);\n#endif\n}\n\n// portable_open is a portable file open. Returns 0 on success. Returns error number on error.\nstatic int portable_open(const char *pathname, int flags, int *fd) {\n#ifdef _WIN32\n  int ret = _sopen_s(fd, pathname, flags | O_BINARY, _SH_DENYNO, 0 /* pmode */);\n  return ret;\n#else\n  int ret = open(pathname, flags);\n  if (ret == -1) {\n    return errno;\n  }\n  *fd = ret;\n  return 0;\n#endif\n}\n\nstatic int portable_close(int fd) {\n#ifdef _WIN32\n  return _close(fd);\n#else\n  return close(fd);\n#endif\n}\n\nstatic byte *read_file(const char *path, size_t *len) {\n  size_t capacity = 1024;\n  byte *data = malloc(capacity);\n  size_t offset = 0;\n  int fd;\n  int err = portable_open(path, O_RDONLY, &fd);\n  ASSERT(0 == err, \"error in open: %s\", pstrerror(err));\n  SSIZE_T got;\n\n  while ((got = portable_read(fd, data + offset, capacity - offset)) > 0) {\n    offset += (size_t)got;\n    if (capacity == offset) {\n      capacity *= 2;\n      data = realloc(data, capacity);\n    }\n  }\n\n  ASSERT(got != -1, \"error in read: %s\", pstrerror(errno));\n  portable_close(fd);\n  *len = offset;\n  return data;\n}\n\nstatic void test_encode_file(void) {\n  size_t data_len;\n  byte *data = read_file(\"../data/example.jpg\", &data_len);\n\n  size_t expect_len;\n  byte *expect = read_file(\"../data/example.b122\", &expect_len);\n\n  base122_error_t error;\n  size_t encoded_len;\n  byte *encoded;\n  /* Allocate encoded. */\n  {\n\n    int got = base122_encode(data, data_len, NULL /* encoded */, 0 /* encoded_len */, &encoded_len,\n                             &error);\n    ASSERT(0 == got, \"error in base122_encode: %s\", error.msg);\n    encoded = malloc(encoded_len);\n  }\n\n  /* Encode. */\n  {\n    size_t written;\n    int got = base122_encode(data, data_len, encoded, encoded_len, &written, &error);\n    ASSERT(0 == got, \"error in base122_encode: %s\", error.msg);\n    ASSERT_BYTES_EQUAL(expect, expect_len, encoded, encoded_len, hexstring);\n  }\n\n  size_t decoded_len;\n  byte *decoded;\n  /* Allocate decoded. */\n  {\n    int got = base122_decode(encoded, encoded_len, NULL /* decoded */, 0 /* decoded_len */,\n                             &decoded_len, &error);\n    ASSERT(0 == got, \"error in base122_decode: %s\", error.msg);\n    decoded = malloc(decoded_len);\n  }\n\n  /* Decode. */\n  {\n    size_t written;\n\n    int got = base122_decode(encoded, encoded_len, decoded, decoded_len, &written, &error);\n    ASSERT(0 == got, \"error in base122_decode: %s\", error.msg);\n    ASSERT_BYTES_EQUAL(data, data_len, decoded, decoded_len, hexstring);\n  }\n\n  free(decoded);\n  free(encoded);\n  free(expect);\n  free(data);\n}\n\nint main(void) {\n  test_hexstring_to_bytes();\n  test_bitstring_to_bytes();\n  test_bitreader_read();\n  test_bitwriter_write();\n  test_decode();\n  test_encode_all_1s();\n  test_encode_file();\n\n  typedef struct {\n    const char *description;\n    const char *data;\n    const char *encoded;\n  } roundtrip_test_t;\n\n  roundtrip_test_t tests[] = {\n      {.description = \"one byte\", .data = \"11111111\", .encoded = \"01111111 01000000\"},\n      {.description = \"several bytes\",\n       .data = \"10101010 10101010 10101010 10101010\",\n       .encoded = \"01010101 00101010 01010101 00101010 01010000\"},\n      {.description = \"illegal one byte\",\n       .data = \"00000000 11111111\",\n       .encoded = \"11000010 10111111 01100000\"},\n      {.description = \"illegal last two bits\",\n       .data = \"1111111 1111111 00\",\n       .encoded = \"01111111 01111111 11011110 10000000\"},\n      {.description = \"fuzz crash 1\", .data = \"00010101\", .encoded = \"11000111 10000000\"}};\n\n  for (size_t i = 0; i < sizeof(tests) / sizeof(tests[0]); i++) {\n    roundtrip_test_t *test = tests + i;\n    size_t data_len;\n    byte *data = bitstring_to_bytes(test->data, &data_len);\n    size_t encoded_len;\n    byte *encoded = bitstring_to_bytes(test->encoded, &encoded_len);\n\n    printf(\"round trip test '%s'\\n\", test->description);\n    /* Test encoding 'data'. */\n    {\n      size_t got_len = encoded_len;\n      byte *got = malloc(sizeof(byte) * got_len);\n      size_t written;\n      base122_error_t error;\n      int ret = base122_encode(data, data_len, got, got_len, &written, &error);\n      ASSERT(ret != -1, \"base122_encode error: %s\", error.msg);\n      ASSERT_BYTES_EQUAL(encoded, encoded_len, got, got_len, bitstring);\n      ASSERT(written == encoded_len, \"expected written == encoded_len. Got %zu != %zu\", written,\n             encoded_len);\n      /* Test length calculation. */\n      {\n        written = 0;\n        ret = base122_encode(data, data_len, NULL, 0, &written, &error);\n        ASSERT(ret != -1, \"base122_encode error: %s\", error.msg);\n        ASSERT(written == encoded_len, \"expected written == encoded_len. Got %zu != %zu\", written,\n               encoded_len);\n      }\n      free(got);\n    }\n\n    /* Test decoding 'encoded'. */\n    {\n      base122_error_t error;\n      size_t got_len = data_len;\n      byte *got = malloc(sizeof(byte) * got_len);\n      size_t written;\n      int ret = base122_decode(encoded, encoded_len, got, got_len, &written, &error);\n      ASSERT(ret != -1, \"base122_decode error: %s\", error.msg);\n      ASSERT_BYTES_EQUAL(data, data_len, got, got_len, bitstring);\n      ASSERT(written == data_len, \"expected written == data_len. Got %zu != %zu\", written,\n             data_len);\n      /* Test length calculation. */\n      {\n        written = 0;\n        ret = base122_decode(encoded, encoded_len, NULL, 0, &written, &error);\n        ASSERT(ret != -1, \"base122_decode error: %s\", error.msg);\n        ASSERT(written == data_len, \"expected written == data_len. Got %zu != %zu\", written,\n               data_len);\n      }\n      free(got);\n    }\n\n    free(data);\n    free(encoded);\n  }\n}\n","numLines":504,"startLine":1,"totalLines":504}}}
