;\n        let encoded = encode(&data).unwrap();\n        let decoded = decode(&encoded).unwrap();\n        assert_eq!(decoded, data, \"failed for length {}\", i);\n    }\n}\n\n#[test]\nfn round_trip_empty() {\n    let data: Vec<u8> = vec![];\n    let encoded = encode(&data).unwrap();\n    assert_eq!(encoded, vec![]);\n    let decoded = decode(&encoded).unwrap();\n    assert_eq!(decoded, data);\n}\n\n#[test]\nfn decode_first_byte_two_byte_malformed() {\n    let result = decode(&[0xFF]);\n    assert!(result.is_err());\n    assert!(result.err().unwrap().message.contains(\"First byte of two byte sequence malformed\"));\n}\n\n#[test]\nfn decode_unrecognized_illegal_index() {\n    // 11011010 10111111 → illegal_index = 6 (invalid)\n    let result = decode(&[0xDA, 0xBF]);\n    assert!(result.is_err());\n    assert!(result.err().unwrap().message.contains(\"Got unrecognized illegal index\"));\n}\nEOF\nmkdir -p /tmp/harvest-crust-ioc9w5/project/tests 2>/dev/null\nls /tmp/harvest-crust-ioc9w5/project/tests/","description":"Create integration tests file"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":285,"cache_read_input_tokens":39608,"cache_creation":{"ephemeral_5m_input_tokens":285,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cf587403-40f1-432f-aed6-12ff9a5f9448","uuid":"5f34f849-c8bb-446c-a636-e11a72d61f2a"}
