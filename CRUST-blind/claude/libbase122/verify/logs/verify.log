{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VM46ws3sTo1ShEoNYdJRhP","type":"tool_result","content":"1\t//! Base122 encoder/decoder\n2\t//!\n3\t//! Base122 is a binary-to-text encoding scheme that avoids certain illegal characters\n4\t//! such as null, newline, carriage return, double quote, ampersand, and backslash.\n5\tuse std::error::Error;\n6\tuse std::fmt;\n7\t/// Error type for Base122 operations\n8\t#[derive(Debug, Clone)]\n9\tpub struct Base122Error {\n10\t    pub message: String,\n11\t}\n12\timpl Base122Error {\n13\t    fn new(message: &str) -> Self {\n14\t        Base122Error { message: message.to_string() }\n15\t    }\n16\t}\n17\t\n18\timpl fmt::Display for Base122Error {\n19\t    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n20\t        write!(f, \"{}\", self.message)\n21\t    }\n22\t}\n23\t\n24\timpl Error for Base122Error {}\n25\t\n26\t/// BitReader is used to read bits from a byte array\n27\tpub struct BitReader<'a> {\n28\t    pub input: &'a [u8],\n29\t    pub byte_pos: usize,\n30\t    pub bit_pos: usize,\n31\t}\n32\timpl<'a> BitReader<'a> {\n33\t    pub fn new(input: &'a [u8]) -> Self {\n34\t        BitReader { input, byte_pos: 0, bit_pos: 0 }\n35\t    }\n36\t    /// Read up to `nbits` from the input, returns (bits_read, value)\n37\t    pub fn read(&mut self, nbits: u8) -> (u8, u8) {\n38\t        assert!(nbits > 0);\n39\t        assert!(nbits <= 8);\n40\t\n41\t        let bit_len = self.input.len() * 8;\n42\t        let cur_bit = self.byte_pos * 8 + self.bit_pos;\n43\t        let max_nbits = bit_len.saturating_sub(cur_bit);\n44\t        let mut nbits_used = nbits as usize;\n45\t        if nbits_used > max_nbits {\n46\t            nbits_used = max_nbits;\n47\t        }\n48\t        if nbits_used == 0 {\n49\t            return (0, 0);\n50\t        }\n51\t\n52\t        let first_byte_index = cur_bit / 8;\n53\t        let first_byte_cur_bit = cur_bit % 8;\n54\t        let mut two_bytes: u16 = (self.input[first_byte_index] as u16) << 8;\n55\t        if first_byte_index + 1 < self.input.len() {\n56\t            two_bytes |= self.input[first_byte_index + 1] as u16;\n57\t        }\n58\t        let shift = (8 - first_byte_cur_bit) + (8 - nbits_used);\n59\t        two_bytes >>= shift;\n60\t        let mask: u16 = if nbits_used >= 16 {\n61\t            0xFFFF\n62\t        } else {\n63\t            (1u16 << nbits_used).wrapping_sub(1)\n64\t        };\n65\t        let result = (two_bytes & mask) as u8;\n66\t\n67\t        // Update positions\n68\t        let new_cur_bit = cur_bit + nbits_used;\n69\t        self.byte_pos = new_cur_bit / 8;\n70\t        self.bit_pos = new_cur_bit % 8;\n71\t\n72\t        (nbits_used as u8, result)\n73\t    }\n74\t}\n75\t/// BitWriter is used to write bits to a byte array\n76\tpub struct BitWriter<'a> {\n77\t    pub output: Option<&'a mut [u8]>,\n78\t    pub len: usize,\n79\t    pub cur_bit: usize,\n80\t    pub count_only: bool,\n81\t}\n82\timpl<'a> BitWriter<'a> {\n83\t    pub fn new(output: Option<&'a mut [u8]>, len: usize) -> Self {\n84\t        let count_only = output.is_none();\n85\t        BitWriter { output, len, cur_bit: 0, count_only }\n86\t    }\n87\t    /// Write `nbits` bits from `value` to the output\n88\t    /// Returns the number of bytes used so far or an error\n89\t    pub fn write(&mut self, nbits: u8, value: u8) -> Result<usize, Base122Error> {\n90\t        assert!(nbits > 0);\n91\t        assert!(nbits <= 8);\n92\t\n93\t        let nbits_usize = nbits as usize;\n94\t\n95\t        if self.count_only {\n96\t            self.cur_bit += nbits_usize;\n97\t            return Ok((self.cur_bit + 7) / 8);\n98\t        }\n99\t\n100\t        let bit_len = self.len * 8;\n101\t        if self.cur_bit + nbits_usize > bit_len {\n102\t            return Err(Base122Error::new(\"output does not have sufficient size\"));\n103\t        }\n104\t\n105\t        let first_byte_index = self.cur_bit / 8;\n106\t        let first_byte_cur_bit = self.cur_bit % 8;\n107\t\n108\t        let out = self.output.as_mut().unwrap();\n109\t\n110\t        // Mask to preserve the high (already-written) bits of the first byte.\n111\t        let preserve_mask: u8 = if first_byte_cur_bit == 0 {\n112\t            0\n113\t        } else {\n114\t            !(0xFFu8 >> first_byte_cur_bit)\n115\t        };\n116\t        let mut two_bytes: u16 = (out[first_byte_index] & preserve_mask) as u16;\n117\t        two_bytes <<= 8;\n118\t\n119\t        // Mask the value's nbits low bits.\n120\t        let val_mask: u8 = if nbits_usize >= 8 {\n121\t            0xFF\n122\t        } else {\n123\t            !(0xFFu8 << nbits_usize)\n124\t        };\n125\t        let shift = 8 + (8 - first_byte_cur_bit) - nbits_usize;\n126\t        two_bytes |= ((value & val_mask) as u16) << shift;\n127\t\n128\t        out[first_byte_index] = (two_bytes >> 8) as u8;\n129\t        if first_byte_cur_bit + nbits_usize > 8 {\n130\t            out[first_byte_index + 1] = (two_bytes & 0xFF) as u8;\n131\t        }\n132\t        self.cur_bit += nbits_usize;\n133\t        Ok((self.cur_bit + 7) / 8)\n134\t    }\n135\t}\n136\tconst ILLEGALS: [u8; 6] = [\n137\t    0,  // null\n138\t    10, // newline\n139\t    13, // carriage return\n140\t    34, // double quote\n141\t    38, // ampersand\n142\t    92, // backslash\n143\t];\n144\t/// Check if a byte value is one of the illegal characters\n145\tfn is_illegal(val: u8) -> bool {\n146\t    ILLEGALS.iter().any(|&x| x == val)\n147\t}\n148\t/// Get the index of an illegal character in the ILLEGALS array\n149\tfn get_illegal_index(val: u8) -> u8 {\n150\t    for (i, &v) in ILLEGALS.iter().enumerate() {\n151\t        if v == val {\n152\t            return i as u8;\n153\t        }\n154\t    }\n155\t    255\n156\t}\n157\t/// Encode binary data to Base122 encoding\n158\t///\n159\t/// # Arguments\n160\t///\n161\t/// * `input` - The binary data to encode\n162\t///\n163\t/// # Returns\n164\t///\n165\t/// * `Ok(Vec<u8>)` - The encoded data\n166\t/// * `Err(Base122Error)` - If there was an error during encoding\n167\tpub fn encode(input: &[u8]) -> Result<Vec<u8>, Base122Error> {\n168\t    // First pass: count required output size.\n169\t    let mut out_written = 0usize;\n170\t    encode_internal(input, None, &mut out_written)?;\n171\t\n172\t    // Allocate the output buffer.\n173\t    let mut buf = vec![0u8; out_written];\n174\t\n175\t    // Second pass: encode into the buffer.\n176\t    let mut written2 = 0usize;\n177\t    encode_internal(input, Some(buf.as_mut_slice()), &mut written2)?;\n178\t\n179\t    Ok(buf)\n180\t}\n181\t/// Internal function to perform the encoding\n182\tfn encode_internal(input: &[u8], mut output: Option<&mut [u8]>, out_written: &mut usize) -> Result<(), Base122Error> {\n183\t    let mut reader = BitReader::new(input);\n184\t    let count_only = output.is_none();\n185\t    *out_written = 0;\n186\t    let mut out_index = 0usize;\n187\t\n188\t    // Helper to write a single byte.\n189\t    fn write_byte(\n190\t        b: u8,\n191\t        output: &mut Option<&mut [u8]>,\n192\t        out_index: &mut usize,\n193\t        out_written: &mut usize,\n194\t        count_only: bool,\n195\t    ) -> Result<(), Base122Error> {\n196\t        if count_only {\n197\t            *out_written += 1;\n198\t        } else {\n199\t            let out_ref = output.as_mut().unwrap();\n200\t            if *out_index == out_ref.len() {\n201\t                return Err(Base122Error::new(\"output does not have sufficient size\"));\n202\t            }\n203\t            out_ref[*out_index] = b;\n204\t            *out_written += 1;\n205\t            *out_index += 1;\n206\t        }\n207\t        Ok(())\n208\t    }\n209\t\n210\t    loop {\n211\t        let (nbits, mut bits) = reader.read(7);\n212\t        if nbits == 0 {\n213\t            break;\n214\t        }\n215\t\n216\t        if nbits < 7 {\n217\t            // Align the first bit to start at position 6.\n218\t            bits = bits << (7 - nbits);\n219\t        }\n220\t\n221\t        if is_illegal(bits) {\n222\t            let illegal_index = get_illegal_index(bits);\n223\t            let mut b1: u8 = 0xC2; // 11000010\n224\t            let mut b2: u8 = 0x80; // 10000000\n225\t\n226\t            // Try to read the next 7 bits.\n227\t            let (next_nbits, mut next_bits) = reader.read(7);\n228\t            // Align (only if we got bits).\n229\t            if next_nbits > 0 && next_nbits < 7 {\n230\t                next_bits = next_bits << (7 - next_nbits);\n231\t            }\n232\t\n233\t            if next_nbits == 0 {\n234\t                // Shortened two-byte sequence: encode the original `bits` here.\n235\t                b1 |= 0x7 << 2; // 11100\n236\t                next_bits = bits;\n237\t            } else {\n238\t                b1 = b1 | (illegal_index << 2);\n239\t            }\n240\t\n241\t            // Push the first bit onto the first byte.\n242\t            let first_bit = (next_bits >> 6) & 1;\n243\t            b1 |= first_bit;\n244\t            b2 = b2 | (next_bits & 0x3F);\n245\t\n246\t            write_byte(b1, &mut output, &mut out_index, out_written, count_only)?;\n247\t            write_byte(b2, &mut output, &mut out_index, out_written, count_only)?;\n248\t        } else {\n249\t            write_byte(bits, &mut output, &mut out_index, out_written, count_only)?;\n250\t        }\n251\t    }\n252\t\n253\t    Ok(())\n254\t}\n255\t/// Write the last 7 bits of byteVal for decoding.\n256\t/// Returns an error if byteVal has 1 bits exceeding the last byte boundary.\n257\tfn write_last_7(writer: &mut BitWriter, byte_val: u8, _error: &mut Base122Error) -> Result<(), Base122Error> {\n258\t    // Compute number of bits remaining to the next byte boundary.\n259\t    let nbits = 8 - (writer.cur_bit % 8);\n260\t    if nbits == 8 {\n261\t        return Err(Base122Error::new(\"Decoded data is not a byte multiple\"));\n262\t    }\n263\t\n264\t    // Error if any bits beyond the boundary are 1.\n265\t    // mask = ~(0xFF << (7 - nbits))\n266\t    let shift = 7 - nbits;\n267\t    let mask: u8 = if shift >= 8 {\n268\t        0xFF\n269\t    } else {\n270\t        !(0xFFu8 << shift)\n271\t    };\n272\t    if (byte_val & mask) > 0 {\n273\t        return Err(Base122Error::new(\n274\t            \"Encoded data is malformed. Last byte has extra data.\",\n275\t        ));\n276\t    }\n277\t\n278\t    // Shift bits to write.\n279\t    let to_write = byte_val >> (7 - nbits);\n280\t    writer.write(nbits as u8, to_write).map_err(|_| {\n281\t        Base122Error::new(\"Output does not have sufficient size\")\n282\t    })?;\n283\t    Ok(())\n284\t}\n285\t/// Decode Base122 encoded data to binary\n286\t///\n287\t/// # Arguments\n288\t///\n289\t/// * `input` - The Base122 encoded data\n290\t///\n291\t/// # Returns\n292\t///\n293\t/// * `Ok(Vec<u8>)` - The decoded binary data\n294\t/// * `Err(Base122Error)` - If there was an error during decoding\n295\tpub fn decode(input: &[u8]) -> Result<Vec<u8>, Base122Error> {\n296\t    // First pass: count required output size.\n297\t    let mut count_writer = BitWriter::new(None, 0);\n298\t    let mut out_written = 0usize;\n299\t    decode_internal(input, &mut count_writer, &mut out_written)?;\n300\t\n301\t    // Allocate the output buffer.\n302\t    let mut buf = vec![0u8; out_written];\n303\t\n304\t    // Second pass: decode into the buffer.\n305\t    let len = buf.len();\n306\t    let mut writer = BitWriter::new(Some(buf.as_mut_slice()), len);\n307\t    let mut written2 = 0usize;\n308\t    decode_internal(input, &mut writer, &mut written2)?;\n309\t\n310\t    Ok(buf)\n311\t}\n312\t/// Internal function to perform the decoding\n313\tfn decode_internal(input: &[u8], writer: &mut BitWriter, out_written: &mut usize) -> Result<(), Base122Error> {\n314\t    let in_len = input.len();\n315\t    let mut cur_byte = 0usize;\n316\t    let mut error = Base122Error::new(\"\");\n317\t\n318\t    while cur_byte < in_len {\n319\t        let cur_byte_val = input[cur_byte];\n320\t        let is_last = cur_byte + 1 == in_len;\n321\t\n322\t        if cur_byte_val >> 7 == 0 {\n323\t            // One byte sequence.\n324\t            if is_last {\n325\t                write_last_7(writer, cur_byte_val, &mut error)?;\n326\t            } else {\n327\t                writer.write(7, cur_byte_val).map_err(|_| {\n328\t                    Base122Error::new(\"Output does not have sufficient size\")\n329\t                })?;\n330\t            }\n331\t        } else {\n332\t            // Two byte sequence.\n333\t            // Expect first byte to have form 110xxx1y (i.e. (curByteVal & 0xE2) == 0xC2).\n334\t            if (cur_byte_val & 0xE2) != 0xC2 {\n335\t                return Err(Base122Error::new(\n336\t                    \"First byte of two byte sequence malformed\",\n337\t                ));\n338\t            }\n339\t            if cur_byte + 1 == in_len {\n340\t                return Err(Base122Error::new(\n341\t                    \"Two byte sequence is missing second byte\",\n342\t                ));\n343\t            }\n344\t            cur_byte += 1;\n345\t            let next_byte_val = input[cur_byte];\n346\t            // Expect second byte to have form 10xxxxxx.\n347\t            if (next_byte_val & 0xC0) != 0x80 {\n348\t                return Err(Base122Error::new(\n349\t                    \"Second byte of two byte sequence malformed\",\n350\t                ));\n351\t            }\n352\t\n353\t            let illegal_index = (cur_byte_val & 0x1C) >> 2;\n354\t            let is_last_pair = cur_byte + 1 == in_len;\n355\t\n356\t            if illegal_index == 0x7 {\n357\t                // Shortened two byte sequence.\n358\t                if cur_byte + 1 != in_len {\n359\t                    return Err(Base122Error::new(\n360\t                        \"Got unexpected extra data after shortened two byte sequence\",\n361\t                    ));\n362\t                }\n363\t                let mut last_byte_val =