(0..self.max_nodes)\n61\t                .map(|_| {\n62\t                    Rc::new(RefCell::new(TreeNode {\n63\t                        left: None,\n64\t                        right: None,\n65\t                        split: 0.0,\n66\t                        idx: 0,\n67\t                    }))\n68\t                })\n69\t                .collect();\n70\t        } else {\n71\t            // Re-using existing storage; clear point list and reset nodes\n72\t            self.points.clear();\n73\t            for n in &self.node_data {\n74\t                let mut nb = n.borrow_mut();\n75\t                nb.left = None;\n76\t                nb.right = None;\n77\t                nb.split = 0.0;\n78\t                nb.idx = 0;\n79\t            }\n80\t        }\n81\t\n82\t        // reset control values\n83\t        self.next_node = 0;\n84\t        self.root = None;\n85\t\n86\t        // cache coordinates of each point and remember the original index\n87\t        for i in 0..count {\n88\t            self.points.push(DataPoint {\n89\t                idx: i,\n90\t                x: x[i],\n91\t                y: y[i],\n92\t                z: z[i],\n93\t            });\n94\t        }\n95\t\n96\t        // Detach points temporarily so we can pass a mutable slice to the\n97\t        // recursive builder (which also borrows &mut self).\n98\t        let mut points = std::mem::take(&mut self.points);\n99\t        self.build_kdtree(&mut points, 0);\n100\t        self.points = points;\n101\t    }\n102\t\n103\t    pub fn search(&self, iter: &mut Option<KDTreeIterator>, x: f64, y: f64, z: f64, apothem: f64) {\n104\t        assert!(apothem >= 0.0);\n105\t\n106\t        // The tree should have at least one branch node\n107\t        let root = match &self.root {\n108\t            Some(r) => r.clone(),\n109\t            None => return,\n110\t        };\n111\t        // Tree must contain more than one point (root must be a branch node)\n112\t        assert!(self.is_leaf(&root) == 0);\n1