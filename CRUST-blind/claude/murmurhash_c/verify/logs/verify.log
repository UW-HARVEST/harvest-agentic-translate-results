{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_rdxwyypvmpv7xozjmfimqi5g2hnshl2q6bsgewnlohpclpf6j6pa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01DYiwBut6NebLD3CWXmDqPw","name":"Write","input":{"file_path":"/tmp/harvest-crust-verify-qGB2Jl/project/src/bin/test_murmurhash.rs","content":"use murmurhash_c::murmurhash::{htole32, murmurhash, MURMURHASH_HAS_HTOLE32, MURMURHASH_VERSION};\n\n#[test]\nfn test_version_constant() {\n    assert_eq!(MURMURHASH_VERSION, \"0.2.0\");\n}\n\n#[test]\nfn test_has_htole32_constant() {\n    assert_eq!(MURMURHASH_HAS_HTOLE32, 1);\n}\n\n#[test]\nfn test_htole32_roundtrip() {\n    // On little-endian machines htole32 is the identity.\n    // The function is documented to perform the host-to-little-endian\n    // conversion. Either way, the value preserved when the host is LE.\n    assert_eq!(htole32(0), 0);\n    assert_eq!(htole32(1), 1);\n    assert_eq!(htole32(0xdeadbeef), 0xdeadbeef_u32.to_le());\n    assert_eq!(htole32(0xffffffff), 0xffffffff_u32.to_le());\n    assert_eq!(htole32(0x12345678), 0x12345678_u32.to_le());\n}\n\n// Reference values produced by running the C reference implementation\n// (c_src/test.c with MURMURHASH_WANTS_HTOLE32 defined).\n#[test]\nfn test_empty_seed_zero() {\n    assert_eq!(murmurhash(b\"\", 0), 0x00000000);\n}\n\n#[test]\nfn test_single_char_zero_seed() {\n    assert_eq!(murmurhash(b\"0\", 0), 0xd271c07f);\n    assert_eq!(murmurhash(b\"0\", 0), 3530670207);\n}\n\n#[test]\nfn test_two_chars() {\n    assert_eq!(murmurhash(b\"01\", 0), 0x61ec6600);\n    assert_eq!(murmurhash(b\"01\", 0), 1642882560);\n}\n\n#[test]\nfn test_three_chars() {\n    assert_eq!(murmurhash(b\"012\", 0), 0xec6cff8c);\n    assert_eq!(murmurhash(b\"012\", 0), 3966566284);\n}\n\n#[test]\nfn test_four_chars() {\n    assert_eq!(murmurhash(b\"0123\", 0), 0xd41994a0);\n    assert_eq!(murmurhash(b\"0123\", 0), 3558446240);\n}\n\n#[test]\nfn test_five_chars() {\n    assert_eq!(murmurhash(b\"01234\", 0), 0x19d02170);\n    assert_eq!(murmurhash(b\"01234\", 0), 433070448);\n}\n\n#[test]\nfn test_two_seed_zero() {\n    assert_eq!(murmurhash(b\"2\", 0), 0x0129e217);\n    assert_eq!(murmurhash(b\"2\", 0), 19522071);\n}\n\n#[test]\nfn test_eighty_eight() {\n    assert_eq!(murmurhash(b\"88\", 0), 0x7a0040a5);\n    assert_eq!(murmurhash(b\"88\", 0), 2046836901);\n}\n\n#[test]\nfn test_asdfqwer() {\n    assert_eq!(murmurhash(b\"asdfqwer\", 0), 0xa46b5209);\n    assert_eq!(murmurhash(b\"asdfqwer\", 0), 2758496777);\n}\n\n#[test]\nfn test_asdfqwerty() {\n    assert_eq!(murmurhash(b\"asdfqwerty\", 0), 0xa3cfe04b);\n    assert_eq!(murmurhash(b\"asdfqwerty\", 0), 2748309579);\n}\n\n#[test]\nfn test_asd() {\n    assert_eq!(murmurhash(b\"asd\", 0), 0x14570c6f);\n    assert_eq!(murmurhash(b\"asd\", 0), 341249135);\n}\n\n#[test]\nfn test_hello() {\n    assert_eq!(murmurhash(b\"Hello\", 0), 0x12da77c8);\n    assert_eq!(murmurhash(b\"Hello\", 0), 316307400);\n}\n\n#[test]\nfn test_hello_one() {\n    assert_eq!(murmurhash(b\"Hello1\", 0), 0x6357e0a6);\n    assert_eq!(murmurhash(b\"Hello1\", 0), 1666703526);\n}\n\n#[test]\nfn test_hello_two() {\n    assert_eq!(murmurhash(b\"Hello2\", 0), 0xe5ce223e);\n    assert_eq!(murmurhash(b\"Hello2\", 0), 3855491646);\n}\n\n#[test]\nfn test_hey() {\n    assert_eq!(murmurhash(b\"hey\", 0), 0x12f94418);\n    assert_eq!(murmurhash(b\"hey\", 0), 318325784);\n}\n\n#[test]\nfn test_dude() {\n    assert_eq!(murmurhash(b\"dude\", 0), 0xef0487f3);\n    assert_eq!(murmurhash(b\"dude\", 0), 4010051571);\n}\n\n#[test]\nfn test_test() {\n    assert_eq!(murmurhash(b\"test\", 0), 0xba6bd213);\n    assert_eq!(murmurhash(b\"test\", 0), 3127628307);\n}\n\n#[test]\nfn test_kinkajou() {\n    assert_eq!(murmurhash(b\"kinkajou\", 0), 0xb6d99cf8);\n    assert_eq!(murmurhash(b\"kinkajou\", 0), 3067714808);\n}\n\n#[test]\nfn test_empty_seed_one() {\n    assert_eq!(murmurhash(b\"\", 1), 0x514e28b7);\n    assert_eq!(murmurhash(b\"\", 1), 1364076727);\n}\n\n// Additional cases generated by running the C reference implementation\n// against various lengths, seeds, and embedded null bytes.\n#[test]\nfn test_ten_bytes_seed_zero() {\n    // murmurhash(\"abcdefghij\", 10, 0) -> 2291300241\n    assert_eq!(murmurhash(b\"abcdefghij\", 0), 2291300241);\n}\n\n#[test]\nfn test_ten_bytes_seed_42() {\n    // murmurhash(\"abcdefghij\", 10, 42) -> 2584585369\n    assert_eq!(murmurhash(b\"abcdefghij\", 42), 2584585369);\n}\n\n#[test]\nfn test_ten_bytes_seed_max_u32() {\n    // murmurhash(\"abcdefghij\", 10, 0xffffffff) -> 4126310922\n    assert_eq!(murmurhash(b\"abcdefghij\", 0xffffffff), 4126310922);\n}\n\n#[test]\nfn test_sixteen_bytes_seed_zero() {\n    // murmurhash(\"aaaabbbbccccdddd\", 16, 0) -> 3460348110\n    assert_eq!(murmurhash(b\"aaaabbbbccccdddd\", 0), 3460348110);\n}\n\n#[test]\nfn test_sixteen_bytes_seed_12345() {\n    // murmurhash(\"aaaabbbbccccdddd\", 16, 12345) -> 3988830935\n    assert_eq!(murmurhash(b\"aaaabbbbccccdddd\", 12345), 3988830935);\n}\n\n#[test]\nfn test_four_bytes_abcd_seed_zero() {\n    // murmurhash(\"abcd\", 4, 0) -> 1139631978\n    assert_eq!(murmurhash(b\"abcd\", 0), 1139631978);\n}\n\n#[test]\nfn test_four_bytes_abcd_seed_seven() {\n    // murmurhash(\"abcd\", 4, 7) -> 1425861819\n    assert_eq!(murmurhash(b\"abcd\", 7), 1425861819);\n}\n\n#[test]\nfn test_embedded_null_full() {\n    // murmurhash(\"ab\\0cd\", 5, 0) -> 1668721715\n    let key: &[u8] = &[b'a', b'b', 0u8, b'c', b'd'];\n    assert_eq!(murmurhash(key, 0), 1668721715);\n}\n\n#[test]\nfn test_embedded_null_partial() {\n    // murmurhash(\"ab\\0cd\", 2, 0) i.e. just first two bytes \"ab\" -> 2613040991\n    let key: &[u8] = &[b'a', b'b'];\n    assert_eq!(murmurhash(key, 0), 2613040991);\n}\n\n#[test]\nfn test_long_pangram_seed_zero() {\n    // murmurhash(\"The quick brown fox jumps over the lazy dog\", 43, 0) -> 776992547\n    assert_eq!(\n        murmurhash(b\"The quick brown fox jumps over the lazy dog\", 0),\n        776992547\n    );\n}\n\n#[test]\nfn test_long_pangram_seed_1234() {\n    // murmurhash(\"The quick brown fox jumps over the lazy dog\", 43, 1234) -> 662953101\n    assert_eq!(\n        murmurhash(b\"The quick brown fox jumps over the lazy dog\", 1234),\n        662953101\n    );\n}\n\n#[test]\nfn test_remainder_lengths_round_trip_consistency() {\n    // Hashing the same key/seed should always produce identical output.\n    let key = b\"reproducibility\";\n    let h1 = murmurhash(key, 99);\n    let h2 = murmurhash(key, 99);\n    assert_eq!(h1, h2);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":146,"cache_read_input_tokens":25563,"cache_creation":{"ephemeral_5m_input_tokens":146,"ephemeral_1h_input_tokens":0},"output_tokens":46,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8712adf8-b119-480e-a0d4-5f90921a441e","uuid":"02fa30ea-3fff-4d8c-833e-c04f2b5ecee6"}
