intln!(\"usage: murmur [-hV] [options]\");\n}\n\npub fn help() {\n    eprintln!();\n    eprintln!(\"options:\");\n    eprint!(\"\\n  --seed=[seed]  hash seed (optional)\");\n    eprintln!();\n}\n\npub fn read_stdin() -> Vec<u8> {\n    let stdin = io::stdin();\n    let mut handle = stdin.lock();\n    let mut line = String::new();\n    match handle.read_line(&mut line) {\n        Ok(0) => Vec::new(),\n        Ok(_) => line.into_bytes(),\n        Err(_) => Vec::new(),\n    }\n}\n\npub fn main() {\n    let args: Vec<String> = std::env::args().collect();\n    let mut seed: Option<String> = None;\n\n    // parse opts (skip argv[0])\n    let mut i = 1;\n    while i < args.len() {\n        let opt = &args[i];\n        if opt.starts_with('-') {\n            let rest = &opt[1..];\n            if rest.is_empty() {\n                i += 1;\n                continue;\n            }\n            let first = rest.as_bytes()[0] as char;\n            match first {\n                'h' => {\n                    usage();\n                    help();\n                    return;\n                }\n                'V' => {\n                    eprintln!(\"{}\", crate::murmurhash::MURMURHASH_VERSION);\n                    return;\n                }\n                '-' => {\n                    // long option; check for \"seed\"\n                    let long = &rest[1..];\n                    if long.starts_with(\"seed\") {\n                        // setopt advances past \"seed\", so the remainder\n                        // (typically \"=value\") is the seed value pointer.\n                        let after = &long[4..];\n                        seed = Some(after.to_string());\n                    }\n                }\n                _ => {\n                    eprintln!(\"unknown option: `{}'\", rest);\n                    usage();\n                    std::process::exit(1);\n                }\n            }\n        }\n        i += 1;\n    }\n\n    let seed_str = seed.unwrap_or_else(|| \"0\".to_string());\n    // The C code does atoi(seed); seed values often look like \"=N\", so\n    // strip a leading '=' and parse leading digits like atoi.\n    let seed_value = parse_atoi(&seed_str);\n\n    let stdin = io::stdin();\n    if stdin.is_terminal() {\n        std::process::exit(1);\n    }\n\n    let buf = read_stdin();\n    if buf.is_empty() {\n        // mimics: NULL == buf -> return 1\n        // empty read returns empty vec (treated as no input here)\n        std::process::exit(1);\n    }\n\n    // C uses strlen(buf) so it stops at first NUL; in Rust, just use the bytes.\n    let key_bytes = strip_nul(&buf);\n    let h = crate::murmurhash::murmurhash(key_bytes, seed_value);\n    let stdout = io::stdout();\n    let mut out = stdout.lock();\n    let _ = writeln!(out, \"{}\", h);\n\n    loop {\n        let key = read_stdin();\n        if key.is_empty() {\n            break;\n        }\n        let key_bytes = strip_nul(&key);\n        let h = crate::murmurhash::murmurhash(key_bytes, seed_value);\n        let _ = writeln!(out, \"{}\", h);\n    }\n}\n\nfn strip_nul(buf: &[u8]) -> &[u8] {\n    match buf.iter().position(|&b| b == 0) {\n        Some(idx) => &buf[..idx],\n        None => buf,\n    }\n}\n\nfn parse_atoi(s: &str) -> u32 {\n    // Mirror C atoi: skip leading whitespace, optional sign, then digits.\n    // The seed string passed via setopt may begin with '=' which atoi\n    // would treat as non-numeric (returning 0).\n    let trimmed = s.trim_start();\n    let bytes = trimmed.as_bytes();\n    let mut idx = 0;\n    let mut negative = false;\n    if idx < bytes.len() && (bytes[idx] == b'+' || bytes[idx] == b'-') {\n        negative = bytes[idx] == b'-';\n        idx += 1;\n    }\n    let mut val: i64 = 0;\n    while idx < bytes.len() && bytes[idx].is_ascii_digit() {\n        val = val\n            .saturating_mul(10)\n            .saturating_add((bytes[idx] - b'0') as i64);\n        idx += 1;\n    }\n    if negative {\n        val = -val;\n    }\n    val as u32\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"8712adf8-b119-480e-a0d4-5f90921a441e","uuid":"b4b36403-349c-4e9e-953a-b7f60dccb232","timestamp":"2026-05-29T18:55:39.405Z","tool_use_result":{"stdout":"c_src/:\ntotal 116\ndrwxr-xr-x 5 scheschb amazon 4096 May 29 18:55 .\ndrwxr-xr-x 4 scheschb amazon 4096 May 29 18:55 ..\n-rw------- 1 scheschb amazon  314 May 29 18:55 clib.json\n-rw------- 1 scheschb amazon  404 May 29 18:55 example.c\ndrwxr-xr-x 8 scheschb amazon 4096 May 29 18:55 .git\ndrwxr-xr-x 3 scheschb amazon 4096 May 29 18:55 .github\n-rw------- 1 scheschb amazon  198 May 29 18:55 .gitignore\n-rw------- 1 scheschb amazon 1276 May 29 18:55 libmurmurhash.so-murmurhash.gcno\n-rw------- 1 scheschb amazon 1078 May 29 18:55 LICENSE\n-rw------- 1 scheschb amazon 2687 May 29 18:55 main.c\n-rw------- 1 scheschb amazon 4845 May 29 18:55 main.c.gcov\n-rw------- 1 scheschb amazon  851 May 29 18:55 Makefile\ndrwxr-xr-x 2 scheschb amazon 4096 May 29 18:55 man\n-rw------- 1 scheschb amazon 1891 May 29 18:55 murmurhash.c\n-rw------- 1 scheschb amazon 4828 May 29 18:55 murmurhash.c.gcov\n-rw------- 1 scheschb amazon  440 May 29 18:55 murmurhash.h\n-rw------- 1 scheschb amazon 4268 May 29 18:55 murmur-main.gcno\n-rw------- 1 scheschb amazon 1276 May 29 18:55 murmur-murmurhash.gcno\n-rw------- 1 scheschb amazon 1171 May 29 18:55 README.md\n-rw------- 1 scheschb amazon 1332 May 29 18:55 test.c\n-rw------- 1 scheschb amazon 2258 May 29 18:55 test.c.gcov\n-rw------- 1 scheschb amazon  144 May 29 18:55 test-murmurhash.gcda\n-rw------- 1 scheschb amazon 1276 May 29 18:55 test-murmurhash.gcno\n-rw------- 1 scheschb amazon  676 May 29 18:55 test-test.gcda\n-rw------- 1 scheschb amazon 6568 May 29 18:55 test-test.gcno\n\nsrc/:\ntotal 16\ndrwxr-xr-x 2 scheschb amazon 4096 May 29 18:55 .\ndrwxr-xr-x 4 scheschb amazon 4096 May 29 18:55 ..\n-rw------- 1 scheschb amazon 3962 May 29 18:55 lib.rs\n-rw------- 1 scheschb amazon 1961 May 29 18:55 murmurhash.rs