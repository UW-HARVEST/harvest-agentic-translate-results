{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01A751SfuwZoqcG98fBxPrXk","type":"tool_result","content":"1\tuse std::cmp::Ordering;\n2\t/// Output information for a packed rectangle\n3\t#[derive(Debug, Clone, Copy)]\n4\tpub struct RectOutInfo {\n5\t    /// X coordinate in the packed layout\n6\t    pub x: i32,\n7\t    /// Y coordinate in the packed layout\n8\t    pub y: i32,\n9\t    /// Whether the rectangle was successfully packed\n10\t    pub packed: bool,\n11\t    /// The page number where the rectangle was packed (for multi-page packing)\n12\t    pub page: i32,\n13\t}\n14\timpl Default for RectOutInfo {\n15\t    fn default() -> Self {\n16\t        Self {\n17\t            x: 0,\n18\t            y: 0,\n19\t            packed: false,\n20\t            page: 0,\n21\t        }\n22\t    }\n23\t}\n24\t/// A rectangle to be packed\n25\t#[derive(Debug, Clone)]\n26\tpub struct Rect {\n27\t    /// Unique identifier for the rectangle\n28\t    pub id: i32,\n29\t    /// Width of the rectangle\n30\t    pub w: i32,\n31\t    /// Height of the rectangle\n32\t    pub h: i32,\n33\t    /// Output information after packing\n34\t    pub info: RectOutInfo,\n35\t}\n36\timpl Rect {\n37\t    /// Create a new rectangle with the given dimensions\n38\t    pub fn new(id: i32, width: i32, height: i32) -> Self {\n39\t        Self {\n40\t            id,\n41\t            w: width,\n42\t            h: height,\n43\t            info: RectOutInfo::default(),\n44\t        }\n45\t    }\n46\t}\n47\t/// Rectangle packer using a binary tree algorithm\n48\tpub struct RectPacker;\n49\timpl RectPacker {\n50\t    /// Pack rectangles into a bin of the given maximum dimensions\n51\t    ///\n52\t    /// # Arguments\n53\t    ///\n54\t    /// * `max_w` - Maximum width of the packing area\n55\t    /// * `max_h` - Maximum height of the packing area\n56\t    /// * `paging` - Whether to allow multiple pages for packing\n57\t    /// * `rects` - Mutable slice of rectangles to pack\n58\t    ///\n59\t    /// # Returns\n60\t    ///\n61\t    /// `true` if all rectangles were successfully packed, `false` otherwise\n62\t    pub fn pack(max_w: i32, max_h: i32, paging: bool, rects: &mut [Rect]) -> bool {\n63\t        if rects.is_empty() {\n64\t            return true;\n65\t        }\n66\t\n67\t        // Sort rectangles by max side (descending), then min side (descending)\n68\t        rects.sort_by(|a, b| {\n69\t            let max_a = a.w.max(a.h);\n70\t            let max_b = b.w.max(b.h);\n71\t            match max_b.cmp(&max_a) {\n72\t                Ordering::Equal => {\n73\t                    let min_a = a.w.min(a.h);\n74\t                    let min_b = b.w.min(b.h);\n75\t                    min_b.cmp(&min_a)\n76\t                }\n77\t                other => other,\n78\t            }\n79\t        });\n80\t\n81\t        // Reset all packing info before starting\n82\t        for r in rects.iter_mut() {\n83\t            r.info = RectOutInfo::default();\n84\t        }\n85\t\n86\t        let n = rects.len();\n87\t        let mut next: usize = 0;\n88\t        let mut last: usize = n - 1;\n89\t        let mut page: i32 = 0;\n90\t        let mut ok = false;\n91\t        let mut all_packed = false;\n92\t\n93\t        while !ok {\n94\t            let (all_fit, none_fit) =\n95\t                pack_bin_tree(rects, &mut next, &mut last, max_w, max_h, page);\n96\t            ok = all_fit;\n97\t            all_packed = all_packed || ok;\n98\t\n99\t            if !paging || none_fit {\n100\t                break;\n101\t            }\n102\t            page += 1;\n103\t        }\n104\t\n105\t        all_packed\n106\t    }\n107\t}\n108\t/// A node in the binary tree used for rectangle packing\n109\tstruct BinNode {\n110\t    x: i32,\n111\t    y: i32,\n112\t    w: i32,\n113\t    h: i32,\n114\t    used: bool,\n115\t    right: Option<Box<BinNode>>,\n116\t    down: Option<Box<BinNode>>,\n117\t}\n118\timpl BinNode {\n119\t    /// Create a new bin node with the given dimensions\n120\t    fn new(x: i32, y: i32, w: i32, h: i32) -> Self {\n121\t        Self {\n122\t            x,\n123\t            y,\n124\t            w,\n125\t            h,\n126\t            used: false,\n127\t            right: None,\n128\t            down: None,\n129\t        }\n130\t    }\n131\t    /// Find a node in the tree that can fit a rectangle of the given dimensions\n132\t    fn find(&self, w: i32, h: i32) -> Option<&BinNode> {\n133\t        if self.used {\n134\t            if let Some(ref right) = self.right {\n135\t                if let Some(found) = right.find(w, h) {\n136\t                    return Some(found);\n137\t                }\n138\t            }\n139\t            if let Some(ref down) = self.down {\n140\t                return down.find(w, h);\n141\t            }\n142\t            None\n143\t        } else if w <= self.w && h <= self.h {\n144\t            Some(self)\n145\t        } else {\n146\t            None\n147\t        }\n148\t    }\n149\t    /// Split this node after placing a rectangle of the given dimensions\n150\t    fn split(&mut self, w: i32, h: i32) -> &Self {\n151\t        self.used = true;\n152\t        self.down = Some(Box::new(BinNode::new(\n153\t            self.x,\n154\t            self.y + h,\n155\t            self.w,\n156\t            self.h - h,\n157\t        )));\n158\t        self.right = Some(Box::new(BinNode::new(\n159\t            self.x + w,\n160\t            self.y,\n161\t            self.w - w,\n162\t            h,\n163\t        )));\n164\t        self\n165\t    }\n166\t    /// Grow the bin to the right to accommodate a rectangle\n167\t    fn grow_right(&mut self, rect: &Rect, _max_w: i32, _max_h: i32) -> Option<&BinNode> {\n168\t        let old_w = self.w;\n169\t        let old_h = self.h;\n170\t        let old = Box::new(BinNode {\n171\t            x: self.x,\n172\t            y: self.y,\n173\t            w: self.w,\n174\t            h: self.h,\n175\t            used: self.used,\n176\t            right: self.right.take(),\n177\t            down: self.down.take(),\n178\t        });\n179\t        self.used = true;\n180\t        self.x = 0;\n181\t        self.y = 0;\n182\t        self.w = old_w + rect.w;\n183\t        self.h = old_h;\n184\t        self.down = Some(old);\n185\t        self.right = Some(Box::new(BinNode::new(old_w, 0, rect.w, old_h)));\n186\t\n187\t        let pos = find_and_split_pos(self, rect.w, rect.h);\n188\t        match pos {\n189\t            Some((x, y)) => find_split_node(self, x, y),\n190\t            None => None,\n191\t        }\n192\t    }\n193\t    /// Grow the bin downward to accommodate a rectangle\n194\t    fn grow_down(&mut self, rect: &Rect, _max_w: i32, _max_h: i32) -> Option<&BinNode> {\n195\t        let old_w = self.w;\n196\t        let old_h = self.h;\n197\t        let old = Box::new(BinNode {\n198\t            x: self.x,\n199\t            y: self.y,\n200\t            w: self.w,\n201\t            h: self.h,\n202\t            used: self.used,\n203\t            right: self.right.take(),\n204\t            down: self.down.take(),\n205\t        });\n206\t        self.used = true;\n207\t        self.x = 0;\n208\t        self.y = 0;\n209\t        self.w = old_w;\n210\t        self.h = old_h + rect.h;\n211\t        self.down = Some(Box::new(BinNode::new(0, old_h, old_w, rect.h)));\n212\t        self.right = Some(old);\n213\t\n214\t        let pos = find_and_split_pos(self, rect.w, rect.h);\n215\t        match pos {\n216\t            Some((x, y)) => find_split_node(self, x, y),\n217\t            None => None,\n218\t        }\n219\t    }\n220\t    /// Grow the bin in the optimal direction to fit a rectangle\n221\t    fn grow(&mut self, rect: &Rect, max_w: i32, max_h: i32) -> Option<&BinNode> {\n222\t        let can_grow_down = rect.w <= self.w && (rect.h + self.h) <= max_h;\n223\t        let can_grow_right = rect.h <= self.h && (rect.w + self.w) <= max_w;\n224\t\n225\t        let should_grow_right = can_grow_right && self.h >= (self.w + rect.w);\n226\t        let should_grow_down = can_grow_down && self.w >= (self.h + rect.h);\n227\t\n228\t        if should_grow_right {\n229\t            self.grow_right(rect, max_w, max_h)\n230\t        } else if should_grow_down {\n231\t            self.grow_down(rect, max_w, max_h)\n232\t        } else if can_grow_right {\n233\t            self.grow_right(rect, max_w, max_h)\n234\t        } else if can_grow_down {\n235\t            self.grow_down(rect, max_w, max_h)\n236\t        } else {\n237\t            None\n238\t        }\n239\t    }\n240\t}\n241\t\n242\t/// Helper that finds an unused node in the tree fitting (w, h), splits it,\n243\t/// and returns the (x, y) position where the rectangle was placed.\n244\tfn find_and_split_pos(node: &mut BinNode, w: i32, h: i32) -> Option<(i32, i32)> {\n245\t    if node.used {\n246\t        if let Some(ref mut right) = node.right {\n247\t            if let Some(pos) = find_and_split_pos(right, w, h) {\n248\t                return Some(pos);\n249\t            }\n250\t        }\n251\t        if let Some(ref mut down) = node.down {\n252\t            return find_and_split_pos(down, w, h);\n253\t        }\n254\t        None\n255\t    } else if w <= node.w && h <= node.h {\n256\t        let pos = (node.x, node.y);\n257\t        node.used = true;\n258\t        node.down = Some(Box::new(BinNode::new(\n259\t            node.x,\n260\t            node.y + h,\n261\t            node.w,\n262\t            node.h - h,\n263\t        )));\n264\t        node.right = Some(Box::new(BinNode::new(\n265\t            node.x + w,\n266\t            node.y,\n267\t            node.w - w,\n268\t            h,\n269\t        )));\n270\t        Some(pos)\n271\t    } else {\n272\t        None\n273\t    }\n274\t}\n275\t\n276\t/// Helper to locate a node in the tree at the given (x, y) that's been used\n277\t/// (i.e., has been split).\n278\tfn find_split_node(node: &BinNode, x: i32, y: i32) -> Option<&BinNode> {\n279\t    if node.used && node.x == x && node.y == y && node.right.is_some() && node.down.is_some() {\n280\t        return Some(node);\n281\t    }\n282\t    if let Some(ref r) = node.right {\n283\t        if let Some(found) = find_split_node(r, x, y) {\n284\t            return Some(found);\n285\t        }\n286\t    }\n287\t    if let Some(ref d) = node.down {\n288\t        return find_split_node(d, x, y);\n289\t    }\n290\t    None\n291\t}\n292\t\n293\t/// Try to grow the bin tree to accommodate a rectangle, returning the\n294\t/// position where the rectangle was placed (if successful).\n295\tfn grow_bin_tree_pos(\n296\t    root: &mut BinNode,\n297\t    rect: &Rect,\n298\t    max_w: i32,\n299\t    max_h: i32,\n300\t) -> Option<(i32, i32)> {\n301\t    let can_grow_down = rect.w <= root.w && (rect.h + root.h) <= max_h;\n302\t    let can_grow_right = rect.h <= root.h && (rect.w + root.w) <= max_w;\n303\t\n304\t    let should_grow_right = can_grow_right && root.h >= (root.w + rect.w);\n305\t    let should_grow_down = can_grow_down && root.w >= (root.h + rect.h);\n306\t\n307\t    if should_grow_right {\n308\t        return grow_right_pos(root, rect);\n309\t    } else if should_grow_down {\n310\t        return grow_down_pos(root, rect);\n311\t    }\n312\t\n313\t    if can_grow_right {\n314\t        return grow_right_pos(root, rect);\n315\t    } else if can_grow_down {\n316\t        return grow_down_pos(root, rect);\n317\t    }\n318\t\n319\t    None\n320\t}\n321\t\n322\tfn grow_right_pos(root: &mut BinNode, rect: &Rect) -> Option<(i32, i32)> {\n323\t    let old_w = root.w;\n324\t    let old_h = root.h;\n325\t    let old = Box::new(BinNode {\n326\t        x: root.x,\n327\t        y: root.y,\n328\t        w: root.w,\n329\t        h: root.h,\n330\t        used: root.used,\n331\t        right: root.right.take(),\n332\t        down: root.down.take(),\n333\t    });\n334\t    root.used = true;\n335\t    root.x = 0;\n336\t    root.y = 0;\n337\t    root.w = old_w + rect.w;\n338\t    root.h = old_h;\n339\t    root.down = Some(old);\n340\t    root.right = Some(Box::new(BinNode::new(old_w, 0, rect.w, old_h)));\n341\t\n342\t    find_and_split_pos(root, rect.w, rect.h)\n343\t}\n344\t\n345\tfn grow_down_pos(root: &mut BinNode, rect: &Rect) -> Option<(i32, i32)> {\n346\t    let old_w = root.w;\n347\t    let old_h = root.h;\n348\t    let old = Box::new(BinNode {\n349\t        x: root.x,\n350\t        y: root.y,\n351\t        w: root.w,\n352\t        h: root.h,\n353\t        used: root.used,\n354\t        right: root.right.take(),\n355\t        down: root.down.take(),\n356\t    });\n357\t    root.used = true;\n358\t    root.x = 0;\n359\t    root.y = 0;\n360\t    root.w = old_w;\n361\t    root.h = old_h + rect.h;\n362\t    root.down = Some(Box::new(BinNode::new(0, old_h, old_w, rect.h)));\n363\t    root.right = Some(old);\n364\t\n365\t    find_and_split_pos(root, rect.w, rect.h)\n366\t}\n367\t\n368\t/// Pack a contiguous range of rectangles into a single bin tree (one page).\n369\t/// Returns (all_fit, none_fit).\n370\tfn pack_bin_tree(\n371\t    rects: &mut [Rect],\n372\t    next: &mut usize,\n373\t    last: &mut usize,\n374\t    max_w: i32,\n375\t    max_h: i32,\n376\t    page: i32,\n377\t) -> (bool, bool) {\n378\t    let mut all_fit = true;\n379\t    let mut none_fit = true;\n380\t\n381\t    let start = *next;\n382\t    let end = *last;\n383\t\n384\t    if start > end || start >= rects.len() {\n385\t        return (all_fit, none_fit);\n386\t    }\n387\t\n388\t    let root_w = rects[start].w;\n389\t    let root_h = rects[start].h;\n390\t\n391\t    let mut root = BinNode::new(\n392\t        0,\n393\t        0,\n394\t        if root_w <= max_w { root_w } else { max_w },\n395\t        if root_h <= max_h { root_h } else { max_h },\n396\t    );\n397\t\n398\t    let mut contiguous = true;\n399\t    let mut new_last = end;\n400\t\n401\t    let mut i = start;\n402\t    loop {\n403\t        if !rects[i].info.packed {\n404\t            let pos = find_and_split_pos(&mut root, rects[i].w, rects[i].h);\n405\t            if let Some((x, y)) = pos {\n406\t                rects[i].info.x = x;\n407\t                rects[i].info.y = y;\n408\t                rects[i].info.packed = true;\n409\t                rects[i].info.page = page;\n410\t                none_fit = false;\n411\t            } else {\n412\t                let rect_copy = rects[i].clone();\n413\t                let pos2 = grow_bin_tree_pos(&mut root, &rect_copy, max_w, max_h);\n414\t                if let Some((x, y)) = pos2 {\n415\t                    rects[i].info.x = x;\n416\t                    rects[i].info.y = y;\n417\t                    rects[i].info.packed = true;\n418\t                    rects[i].info.page = page;\n419\t                    none_fit = false;\n420\t                } else {\n421\t                    rects[i].info.packed = false;\n422\t                    all_fit = false;\n423\t                    contiguous = false;\n424\t                    new_last = i;\n425\t                }\n426\t            }\n427\t        }\n428\t\n429\t        if contiguous {\n430\t            *next = i + 1;\n431\t        }\n432\t\n433\t        if i == end {\n434\t            break;\n435\t        }\n436\t        i += 1;\n437\t    }\n438\t\n439\t    *last = new_last;\n440\t    (all_fit, none_fit)\n441\t}\n442\t"}]},"parent_tool_use_id":null,"session_id":"181ab8e5-26ed-43cb-a1d8-6d91d1128912","uuid":"9feae035-e8e0-43db-ba5b-fcdbdd589b69","timestamp":"2026-05-29T19:11:31.006Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-nWU0j1/project/src/rect_pack.rs","content":"use std::cmp::Ordering;\n/// Output information for a packed rectangle\n#[derive(Debug, Clone, Copy)]\npub struct RectOutInfo {\n    /// X coordinate in the packed layout\n    pub x: i32,\n    /// Y coordinate in the packed layout\n    pub y: i32,\n    /// Whether the rectangle was successfully packed\n    pub packed: bool,\n    /// The page number where the rectangle was packed (for multi-page packing)\n    pub page: i32,\n}\nimpl Default for RectOutInfo {\n    fn default() -> Self {\n        Self {\n            x: 0,\n            y: 0,\n            packed: false,\n            page: 0,\n        }\n    }\n}\n/// A rectangle to be packed\n#[derive(Debug, Clone)]\npub struct Rect {\n    /// Unique identifier for the rectangle\n    pub id: i32,\n    /// Width of the rectangle\n    pub w: i32,\n    /// Height of the rectangle\n    pub h: i32,\n    /// Output information after packing\n    pub info: RectOutInfo,\n}\nimpl Rect {\n    /// Create a new rectangle with the given dimensions\n    pub fn new(id: i32, width: i32, height: i32) -> Self {\n        Self {\n            id,\n            w: width,\n            h: height,\n            info: RectOutInfo::default(),\n        }\n    }\n}\n/// Rectangle packer using a binary tree algorithm\npub struct RectPacker;\nimpl RectPacker {\n    /// Pack rectangles into a bin of the given maximum dimensions\n    ///\n    /// # Arguments\n    ///\n    /// * `max_w` - Maximum width of the packing area\n    /// * `max_h` - Maximum height of the packing area\n    /// * `paging` - Whether to allow multiple pages for packing\n    /// * `rects` - Mutable slice of rectangles to pack\n    ///\n    /// # Returns\n    ///\n    /// `true` if all rectangles were successfully packed, `false` otherwise\n    pub fn pack(max_w: i32, max_h: i32, paging: bool, rects: &mut [Rect]) -> bool {\n        if rects.is_empty() {\n            return true;\n        }\n\n        // Sort rectangles by max side (descending), then min side (descending)\n        rects.sort_by(|a, b| {\n            let max_a = a.w.max(a.h);\n            let max_b = b.w.max(b.h);\n            match max_b.cmp(&max_a) {\n                Ordering::Equal => {\n                    let min_a = a.w.min(a.h);\n                    let min_b = b.w.min(b.h);\n                    min_b.cmp(&min_a)\n                }\n                other => other,\n            }\n        });\n\n        // Reset all packing info before starting\n        for r in rects.iter_mut() {\n            r.info = RectOutInfo::default();\n        }\n\n        let n = rects.len();\n        let mut next: usize = 0;\n        let mut last: usize = n - 1;\n        let mut page: i32 = 0;\n        let mut ok = false;\n        let mut all_packed = false;\n\n        while !ok {\n            let (all_fit, none_fit) =\n                pack_bin_tree(rects, &mut next, &mut last, max_w, max_h, page);\n            ok = all_fit;\n            all_packed = all_packed || ok;\n\n            if !paging || none_fit {\n                break;\n            }\n            page += 1;\n        }\n\n        all_packed\n    }\n}\n/// A node in the binary tree used for rectangle packing\nstruct BinNode {\n    x: i32,\n    y: i32,\n    w: i32,\n    h: i32,\n    used: bool,\n    right: Option<Box<BinNode>>,\n    down: Option<Box<BinNode>>,\n}\nimpl BinNode {\n    /// Create a new bin node with the given dimensions\n    fn new(x: i32, y: i32, w: i32, h: i32) -> Self {\n        Self {\n            x,\n            y,\n            w,\n            h,\n            used: false,\n            right: None,\n            down: None,\n        }\n    }\n    /// Find a node in the tree that can fit a rectangle of the given dimensions\n    fn find(&self, w: i32, h: i32) -> Option<&BinNode> {\n        if self.used {\n            if let Some(ref right) = self.right {\n                if let Some(found) = right.find(w, h) {\n                    return Some(found);\n                }\n            }\n            if let Some(ref down) = self.down {\n                return down.find(w, h);\n            }\n            None\n        } else if w <= self.w && h <= self.h {\n            Some(self)\n        } else {\n            None\n        }\n    }\n    /// Split this node after placing a rectangle of the given dimensions\n    fn split(&mut self, w: i32, h: i32) -> &Self {\n        self.used = true;\n        self.down = Some(Box::new(BinNode::new(\n            self.x,\n            self.y + h,\n            self.w,\n            self.h - h,\n        )));\n        self.right = Some(Box::new(BinNode::new(\n            self.x + w,\n            self.y,\n            self.w - w,\n            h,\n        )));\n        self\n    }\n    /// Grow the bin to the right to accommodate a rectangle\n    fn grow_right(&mut self, rect: &Rect, _max_w: i32, _max_h: i32) -> Option<&BinNode> {\n        let old_w = self.w;\n        let old_h = self.h;\n        let old = Box::new(BinNode {\n            x: self.x,\n            y: self.y,\n            w: self.w,\n            h: self.h,\n            used: self.used,\n            right: self.right.take(),\n            down: self.down.take(),\n        });\n        self.used = true;\n        self.x = 0;\n        self.y = 0;\n        self.w = old_w + rect.w;\n        self.h = old_h;\n        self.down = Some(old);\n        self.right = Some(Box::new(BinNode::new(old_w, 0, rect.w, old_h)));\n\n        let pos = find_and_split_pos(self, rect.w, rect.h);\n        match pos {\n            Some((x, y)) => find_split_node(self, x, y),\n            None => None,\n        }\n    }\n    /// Grow the bin downward to accommodate a rectangle\n    fn grow_down(&mut self, rect: &Rect, _max_w: i32, _max_h: i32) -> Option<&BinNode> {\n        let old_w = self.w;\n        let old_h = self.h;\n        let old = Box::new(BinNode {\n            x: self.x,\n            y: self.y,\n            w: self.w,\n            h: self.h,\n            used: self.used,\n            right: self.right.take(),\n            down: self.down.take(),\n        });\n        self.used = true;\n        self.x = 0;\n        self.y = 0;\n        self.w = old_w;\n        self.h = old_h + rect.h;\n        self.down = Some(Box::new(BinNode::new(0, old_h, old_w, rect.h)));\n        self.right = Some(old);\n\n        let pos = find_and_split_pos(self, rect.w, rect.h);\n        match pos {\n            Some((x, y)) => find_split_node(self, x, y),\n            None => None,\n        }\n    }\n    /// Grow the bin in the optimal direction to fit a rectangle\n    fn grow(&mut self, rect: &Rect, max_w: i32, max_h: i32) -> Option<&BinNode> {\n        let can_grow_down = rect.w <= self.w && (rect.h + self.h) <= max_h;\n        let can_grow_right = rect.h <= self.h && (rect.w + self.w) <= max_w;\n\n        let should_grow_right = can_grow_right && self.h >= (self.w + rect.w);\n        let should_grow_down = can_grow_down && self.w >= (self.h + rect.h);\n\n        if should_grow_right {\n            self.grow_right(rect, max_w, max_h)\n        } else if should_grow_down {\n            self.grow_down(rect, max_w, max_h)\n        } else if can_grow_right {\n            self.grow_right(rect, max_w, max_h)\n        } else if can_grow_down {\n            self.grow_down(rect, max_w, max_h)\n        } else {\n            None\n        }\n    }\n}\n\n/// Helper that finds an unused node in the tree fitting (w, h), splits it,\n/// and returns the (x, y) position where the rectangle was placed.\nfn find_and_split_pos(node: &mut BinNode, w: i32, h: i32) -> Option<(i32, i32)> {\n    if node.used {\n        if let Some(ref mut right) = node.right {\n            if let Some(pos) = find_and_split_pos(right, w, h) {\n                return Some(pos);\n            }\n        }\n        if let Some(ref mut down) = node.down {\n            return find_and_split_pos(down, w, h);\n        }\n        None\n    } else if w <= node.w && h <= node.h {\n        let pos = (node.x, node.y);\n        node.used = true;\n        node.down = Some(Box::new(BinNode::new(\n            node.x,\n            node.y + h,\n            node.w,\n            node.h - h,\n        )));\n        node.right = Some(Box::new(BinNode::new(\n            node.x + w,\n            node.y,\n            node.w - w,\n            h,\n        )));\n        Some(pos)\n    } else {\n        None\n    }\n}\n\n/// Helper to locate a node in the tree at the given (x, y) that's been used\n/// (i.e., has been split).\nfn find_split_node(node: &BinNode, x: i32, y: i32) -> Option<&BinNode> {\n    if node.used && node.x == x && node.y == y && node.right.is_some() && node.down.is_some() {\n        return Some(node);\n    }\n    if let Some(ref r) = node.right {\n        if let Some(found) = find_split_node(r, x, y) {\n            return Some(found);\n        }\n    }\n    if let Some(ref d) = node.down {\n        return find_split_node(d, x, y);\n    }\n    None\n}\n\n/// Try to grow the bin tree to accommodate a rectangle, returning the\n/// position where the rectangle was placed (if successful).\nfn grow_bin_tree_pos(\n    root: &mut BinNode,\n    rect: &Rect,\n    max_w: i32,\n    max_h: i32,\n) -> Option<(i32, i32)> {\n    let can_grow_down = rect.w <= root.w && (rect.h + root.h) <= max_h;\n    let can_grow_right = rect.h <= root.h && (rect.w + root.w) <= max_w;\n\n    let should_grow_right = can_grow_right && root.h >= (root.w + rect.w);\n    let should_grow_down = can_grow_down && root.w >= (root.h + rect.h);\n\n    if should_grow_right {\n        return grow_right_pos(root, rect);\n    } else if should_grow_down {\n        return grow_down_pos(root, rect);\n    }\n\n    if can_grow_right {\n        return grow_right_pos(root, rect);\n    } else if can_grow_down {\n        return grow_down_pos(root, rect);\n    }\n\n    None\n}\n\nfn grow_right_pos(root: &mut BinNode, rect: &Rect) -> Option<(i32, i32)> {\n    let old_w = root.w;\n    let old_h = root.h;\n    let old = Box::new(BinNode {\n        x: root.x,\n        y: root.y,\n        w: root.w,\n        h: root.h,\n        used: root.used,\n        right: root.right.take(),\n        down: root.down.take(),\n    });\n    root.used = true;\n    root.x = 0;\n    root.y = 0;\n    root.w = old_w + rect.w;\n    root.h = old_h;\n    root.down = Some(old);\n    root.right = Some(Box::new(BinNode::new(old_w, 0, rect.w, old_h)));\n\n    find_and_split_pos(root, rect.w, rect.h)\n}\n\nfn grow_down_pos(root: &mut BinNode, rect: &Rect) -> Option<(i32, i32)> {\n    let old_w = root.w;\n    let old_h = root.h;\n    let old = Box::new(BinNode {\n        x: root.x,\n        y: root.y,\n        w: root.w,\n        h: root.h,\n        used: root.used,\n        right: root.right.take(),\n        down: root.down.take(),\n    });\n    root.used = true;\n    root.x = 0;\n    root.y = 0;\n    root.w = old_w;\n    root.h = old_h + rect.h;\n    root.down = Some(Box::new(BinNode::new(0, old_h, old_w, rect.h)));\n    root.right = Some(old);\n\n    find_and_split_pos(root, rect.w, rect.h)\n}\n\n/// Pack a contiguous range of rectangles into a single bin tree (one page).\n/// Returns (all_fit, none_fit).\nfn pack_bin_tree(\n    rects: &mut [Rect],\n    next: &mut usize,\n    last: &mut usize,\n    max_w: i32,\n    max_h: i32,\n    page: i32,\n) -> (bool, bool) {\n    let mut all_fit = true;\n    let mut none_fit = true;\n\n    let start = *next;\n    let end = *last;\n\n    if start > end || start >= rects.len() {\n        return (all_fit, none_fit);\n    }\n\n    let root_w = rects[start].w;\n    let root_h = rects[start].h;\n\n    let mut root = BinNode::new(\n        0,\n        0,\n        if root_w <= max_w { root_w } else { max_w },\n        if root_h <= max_h { root_h } else { max_h },\n    );\n\n    let mut contiguous = true;\n    let mut new_last = end;\n\n    let mut i = start;\n    loop {\n        if !rects[i].info.packed {\n            let pos = find_and_split_pos(&mut root, rects[i].w, rects[i].h);\n            if let Some((x, y)) = pos {\n                rects[i].info.x = x;\n                rects[i].info.y = y;\n                rects[i].info.packed = true;\n                rects[i].info.page = page;\n                none_fit = false;\n            } else {\n                let rect_copy = rects[i].clone();\n                let pos2 = grow_bin_tree_pos(&mut root, &rect_copy, max_w, max_h);\n                if let Some((x, y)) = pos2 {\n                    rects[i].info.x = x;\n                    rects[i].info.y = y;\n                    rects[i].info.packed = true;\n                    rects[i].info.page = page;\n                    none_fit = false;\n                } else {\n                    rects[i].info.packed = false;\n                    all_fit = false;\n                    contiguous = false;\n                    new_last = i;\n                }\n            }\n        }\n\n        if contiguous {\n            *next = i + 1;\n        }\n\n        if i == end {\n            break;\n        }\n        i += 1;\n    }\n\n    *last = new_last;\n    (all_fit, none_fit)\n}\n","numLines":442,"startLine":1,"totalLines":442}}}
