vec);\n216\t}\n217\t\n218\tvoid vector_restore(struct vector *vector)\n219\t{\n220\t    struct vector save_vec = *((struct vector *)(vector_back(vector->saves)));\n221\t    save_vec.saves = vector->saves;\n222\t    *vector = save_vec;\n223\t    vector_pop(vector->saves);\n224\t}\n225\t\n226\tvoid vector_save_purge(struct vector *vector)\n227\t{\n228\t    vector_pop(vector->saves);\n229\t}\n230\t\n231\tvoid vector_pop_last_peek(struct vector* vector)\n232\t{\n233\t    assert(vector->pindex >= 1);\n234\t    vector_pop_at(vector, vector->pindex-1);\n235\t}\n236\t\n237\tvoid vector_push(struct vector *vector, void *elem)\n238\t{\n239\t    void *ptr = vector_at(vector, vector->rindex);\n240\t    memcpy(ptr, elem, vector->esize);\n241\t\n242\t    vector->rindex++;\n243\t    vector->count++;\n244\t\n245\t    if (vector->rindex >= vector->mindex)\n246\t    {\n247\t        vector_resize(vector);\n248\t    }\n249\t}\n250\t\n251\tint vector_fread(struct vector *vector, int amount, FILE *fp)\n252\t{\n253\t    size_t read_amount = fread(vector->data, 1, 1, fp);\n254\t    while (read_amount)\n255\t    {\n256\t        vector_push(vector, &read_amount);\n257\t        read_amount = fread(vector->data, 1, 1, fp);\n258\t    }\n259\t\n260\t    return 0;\n261\t}\n262\t\n263\tconst char *vector_string(struct vector *vec)\n264\t{\n265\t    return vec->data;\n266\t}\n267\t\n268\tvoid *vector_data_end(struct vector *vector)\n269\t{\n270\t    return vector->data + vector->rindex * vector->esize;\n271\t}\n272\t\n273\tsize_t vector_elements_left(struct vector *vector, int index)\n274\t{\n275\t    return vector->count - index;\n276\t}\n277\t\n278\tint vector_elements_until_end(struct vector *vector, int index)\n279\t{\n280\t    return vector->count - index;\n281\t}\n282\t\n283\tvoid vector_shift_right_in_bounds_no_increment(struct vector *vector, int index, int amount)\n284\t{\n285\t    vector_resize_for_index(vector, index, amount);\n286\t    int eindex = (index + amount);\n287\t    size_t byt