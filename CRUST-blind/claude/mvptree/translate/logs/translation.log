{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016Z6SobNiARZhHHrDhdGuCz","type":"tool_result","content":"1\t/*\n2\t *  MVPTree c library\n3\t *  Copyright (C) 2008-2009 by D. Grant Starkweather.\n4\t *  All rights reserved.\n5\t *\n6\t *  This program is free software: you can redistribute it and/or modify\n7\t *  it under the terms of the GNU General Public License as published by\n8\t *  the Free Software Foundation, either version 3 of the License, or\n9\t *  (at your option) any later version.\n10\t *\n11\t *  This program is distributed in the hope that it will be useful,\n12\t *  but WITHOUT ANY WARRANTY; without even the implied warranty of\n13\t *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n14\t *  GNU General Public License for more details.\n15\t *\n16\t *  You should have received a copy of the GNU General Public License\n17\t *  along with this program.  If not, see <http://www.gnu.org/licenses/>.\n18\t *\n19\t *  D Grant Starkweather - starkd88@gmail.com\n20\t */\n21\t\n22\t#include <stdlib.h>\n23\t#include <stdio.h>\n24\t#include <string.h>\n25\t#include <stdint.h>\n26\t#include <math.h>\n27\t#include <sys/types.h>\n28\t#include <sys/stat.h>\n29\t#include <sys/mman.h>\n30\t#include <fcntl.h>\n31\t#include <unistd.h>\n32\t#include \"mvptree.h\"\n33\t\n34\t#define HEADER_SIZE 32\n35\t#define _FILE_OFFSET_BITS 64\n36\t#define _LARGEFILE64_SOURCE\n37\t\n38\tconst char *tag = \"phashmvp2010\";\n39\tconst int version = 0x01000000;\n40\t\n41\tconst char *error_msgs[] = {\n42\t    \"no error\",\n43\t    \"bad argument\",\n44\t    \"no distance function found\",\n45\t    \"mem alloc error\",\n46\t    \"no leaf node created\",\n47\t    \"no internal node created\",\n48\t    \"no path array alloc'd\",\n49\t    \"could not select vantage points\",\n50\t    \"could not calculate range from an sv1\",\n51\t    \"could not calculate range from an sv2\",\n52\t    \"points too compact\",\n53\t    \"could not sort points\",\n54\t    \"could not open file\",\n55\t    \"could not close file\",\n56\t    \"mmap error\",\n57\t    \"unmap eror\",\n58\t    \"no write\",\n59\t    \"could not extend file\",\n60\t    \"could not remap file\",\n61\t    \"datatypes in conflict\",\n62\t    \"no. retrieved exceeds k\",\n63\t    \"empty tree\",\n64\t    \"distance value either NaN or less than zero\",\n65\t    \"could not open file\",\n66\t    \"unrecognized node\" };\n67\t\n68\t\n69\tconst char* mvp_errstr(MVPError err) {\n70\t    return error_msgs[(int) err];\n71\t}\n72\t\n73\tMVPDP* dp_alloc(MVPDataType type) {\n74\t    MVPDP *newdp = (MVPDP*) malloc(sizeof(MVPDP));\n75\t    newdp->id = NULL;\n76\t    newdp->data = NULL;\n77\t    newdp->datalen = 0;\n78\t    newdp->type = type;\n79\t    newdp->path = NULL;\n80\t    return newdp;\n81\t}\n82\t\n83\tvoid dp_free(MVPDP *dp, MVPFreeFunc free_func) {\n84\t    if (dp) {\n85\t        if (dp->path) { free(dp->path); }\n86\t        if (free_func) {\n87\t            if (dp->id)    free_func(dp->id);\n88\t            if (dp->data) free_func(dp->data);\n89\t        }\n90\t        free(dp);\n91\t    }\n92\t}\n93\t\n94\tMVPTree* mvptree_alloc(MVPTree *tree, CmpFunc distance, unsigned int bf, unsigned int p,\n95\t                                                           unsigned int k) {\n96\t    if (distance == NULL) {\n97\t        return NULL;\n98\t    }\n99\t\n100\t    MVPTree *retTree;\n101\t    if (tree == NULL) {\n102\t        retTree = (MVPTree*) malloc(sizeof(MVPTree));\n103\t        if (retTree  == NULL) { return NULL; }\n104\t    } else {\n105\t        retTree = tree;\n106\t    }\n107\t\n108\t    retTree->branchfactor = bf;\n109\t    retTree->pathlength   = p;\n110\t    retTree->leafcap      = k;\n111\t    retTree->dist         = distance;\n112\t    retTree->datatype     = 0;\n113\t    retTree->node         = NULL;\n114\t    retTree->fd           = 0;\n115\t    retTree->k            = 0;\n116\t    retTree->size         = 0;\n117\t    retTree->pos          = 0;\n118\t    retTree->buf          = NULL;\n119\t    retTree->pgsize       = sysconf(_SC_PAGESIZE);\n120\t\n121\t    return retTree;\n122\t}\n123\t\n124\t/* custom isnan function */\n125\tstatic int is_nan(float x) {\n126\t    float var = x;\n127\t    return (var != var) ? 1 : 0;\n128\t}\n129\t\n130\tstatic Node* create_leaf(unsigned int leafcap) {\n131\t    Node *node = (Node*) malloc(sizeof(Node));\n132\t    node->leaf.sv1 = NULL;\n133\t    node->leaf.sv2 = NULL;\n134\t    node->leaf.points = (MVPDP**) calloc(leafcap, sizeof(MVPDP*));\n135\t    node->leaf.d1 = (float*) calloc(leafcap,sizeof(float));\n136\t    node->leaf.d2 = (float*) calloc(leafcap,sizeof(float));\n137\t    node->leaf.nbpoints = 0;\n138\t    node->leaf.type = LEAF_NODE;\n139\t\n140\t    return node;\n141\t}\n142\t\n143\tstatic Node* create_internal(unsigned int bf) {\n144\t    Node *node = (Node*) malloc(sizeof(Node));\n145\t    node->internal.sv1 = NULL;\n146\t    node->internal.sv2 = NULL;\n147\t    node->internal.M1 = (float*) calloc(bf-1, sizeof(float));\n148\t    node->internal.M2 = (float*) calloc(bf, sizeof(float));\n149\t    node->internal.child_nodes = calloc(bf*bf, sizeof(Node*));\n150\t    node->internal.type = INTERNAL_NODE;\n151\t\n152\t    return node;\n153\t}\n154\t\n155\tstatic void free_node(Node *node) {\n156\t    if (node) {\n157\t        if (node->leaf.type == LEAF_NODE) {\n158\t            free(node->leaf.points);\n159\t            free(node->leaf.d1);\n160\t            free(node->leaf.d2);\n161\t        } else if (node->internal.type == INTERNAL_NODE) {\n162\t            free(node->internal.M1);\n163\t            free(node->internal.M2);\n164\t            free(node->internal.child_nodes);\n165\t        }\n166\t        free(node);\n167\t    }\n168\t}\n169\t\n170\tstatic void _mvptree_clear(MVPTree *tree, Node *node, MVPFreeFunc free_func, int lvl) {\n171\t    if (!node) { return; }\n172\t\n173\t    int i;\n174\t    if (node->internal.type == INTERNAL_NODE) {\n175\t        int fanout = tree->branchfactor*tree->branchfactor;\n176\t        for (i = 0; i < fanout; i++) {\n177\t            _mvptree_clear(tree, node->internal.child_nodes[i], free_func, lvl+1);\n178\t        }\n179\t        dp_free(node->internal.sv1, free_func);\n180\t        dp_free(node->internal.sv2, free_func);\n181\t    } else {\n182\t        dp_free(node->leaf.sv1, free_func);\n183\t        dp_free(node->leaf.sv2, free_func);\n184\t\n185\t        for (i=0; i< node->leaf.nbpoints; i++) {\n186\t            dp_free(node->leaf.points[i], free_func);\n187\t        }\n188\t    }\n189\t    free_node(node);\n190\t}\n191\t\n192\tvoid mvptree_clear(MVPTree *tree, MVPFreeFunc free_func) {\n193\t    if (!tree || !tree->node) { return; }\n194\t    _mvptree_clear(tree, tree->node, free_func, 0);\n195\t}\n196\t\n197\t/*\n198\t   Select the two points at maximum distance from each other using the dist metric.\n199\t   Return the positions in list of points in sv1_pos and sv2_pos\n200\t*/\n201\t\n202\tstatic int select_vantage_points(MVPDP **points, unsigned int nb,int *sv1_pos, int *sv2_pos,\n203\t                                                      CmpFunc dist) {\n204\t    if (!points || !sv1_pos || !sv2_pos || !dist || nb == 0) { return -1; }\n205\t\n206\t    *sv1_pos = (nb >= 1) ? 0 : -1;\n207\t    *sv2_pos = -1;\n208\t\n209\t    float max_dist = 0.0f, d;\n210\t    int i, j;\n211\t    for (i = 0; i < nb; i++) {\n212\t        for (j = i+1; j < nb; j++) {\n213\t            d = dist(points[i], points[j]);\n214\t            if (is_nan(d) || d < 0.0f) {\n215\t                return -2;\n216\t            }\n217\t\n218\t            if (d > max_dist) {\n219\t                max_dist = d;\n220\t                *sv1_pos = i;\n221\t                *sv2_pos = j;\n222\t            }\n223\t        }\n224\t    }\n225\t\n226\t    return 0;\n227\t}\n228\t\n229\t\n230\tstatic int find_splits(MVPDP **points, unsigned int nb, MVPDP *vp, MVPTree *tree,\n231\t                                                     float *M, unsigned int lengthM) {\n232\t    if (!points || nb == 0 || !M || lengthM == 0) return -1;\n233\t\n234\t    CmpFunc distfunc = tree->dist;\n235\t    float *dist = (float*) malloc(nb*sizeof(float));\n236\t\n237\t    int i, j;\n238\t    for (i = 0; i < nb; i++) {\n239\t        dist[i] = distfunc(points[i], vp);\n240\t        if (is_nan(dist[i]) || dist[i] < 0.0f) {\n241\t            free(dist);\n242\t            return -2;\n243\t        }\n244\t    }\n245\t\n246\t    int min_pos;\n247\t    for (i = 0;i < nb-1;i++) {\n248\t        min_pos = i;\n249\t        for (j = i+1; j < nb; j++) {\n250\t            if (dist[j] < dist[min_pos]) {\n251\t                min_pos = j;\n252\t            }\n253\t        }\n254\t\n255\t        if (min_pos != i) {\n256\t            float tmp = dist[min_pos];\n257\t            dist[min_pos] = dist[i];\n258\t            dist[i] = tmp;\n259\t        }\n260\t    }\n261\t\n262\t    for (i = 0; i < lengthM; i++) {\n263\t        int index = (i+1)*nb/(lengthM+1);\n264\t        if (index <= 0) { index = 0; }\n265\t        if (index >= nb) { index = nb-1; }\n266\t        M[i] = dist[index];\n267\t    }\n268\t\n269\t    free(dist);\n270\t    return 0;\n271\t}\n272\t\n273\t/* Sort points into bins by distance(points[i], dp) for each i in list, skipping\n274\t * points[sv1_pos] and points[sv2_pos]. Use pivot[LengthM1] array as pivot points\n275\t * to determine which bins. */\n276\tstatic MVPDP*** sort_points(MVPDP **points, unsigned int nbpoints, int sv1_pos, int sv2_pos,\n277\t                         MVPDP *vp, MVPTree *tree, int **counts, float *pivots) {\n278\t    if (!points || !vp || !tree || !counts || !pivots || nbpoints == 0) { return NULL; }\n279\t\n280\t    CmpFunc distfunc = tree->dist;\n281\t    int bf = tree->branchfactor;\n282\t    int lengthM1 = bf-1;\n283\t\n284\t    MVPDP*** bins = (MVPDP***) malloc(bf*sizeof(MVPDP**));\n285\t    if (!bins) return NULL;\n286\t\n287\t    *counts = (int*) calloc(bf, sizeof(int));\n288\t    if (!counts) {\n289\t        free(bins);\n290\t        return NULL;\n291\t    }\n292\t\n293\t    int i, k;\n294\t    for (i=0; i < bf; i++) {\n295\t        bins[i] = (MVPDP**) malloc(nbpoints*sizeof(MVPDP*));\n296\t        if (!bins[i]) { return NULL; }\n297\t    }\n298\t\n299\t    for (i=0;i<nbpoints;i++) {\n300\t        if (i == sv1_pos || i == sv2_pos) { continue; }\n301\t\n302\t        float d = distfunc(vp, points[i]);\n303\t        if (is_nan(d) || d < 0.0f) {\n304\t            free(counts);\n305\t            free(bins);\n306\t            return NULL;\n307\t        }\n308\t\n309\t        for (k = 0; k < lengthM1; k++) {\n310\t            if (d <= pivots[k]) {\n311\t                bins[k][(*counts)[k]] = points[i];\n312\t                (*counts)[k]++;\n313\t                break;\n314\t            }\n315\t        }\n316\t\n317\t        if (d > pivots[lengthM1-1]) {\n318\t            bins[lengthM1][(*counts)[lengthM1]] = points[i];\n319\t            (*counts)[lengthM1]++;\n320\t        }\n321\t    }\n322\t\n323\t    return bins;\n324\t}\n325\t\n326\t/* Calculate distances for all points from given vantage point, vp, and\n327\t   assign that distance into each points path using the lvl parameter. */\n328\tstatic int find_distance_range_for_vp(MVPDP **points, unsigned int nbpoints, MVPDP *vp,\n329\t                                      MVPTree *tree, int lvl) {\n330\t    if (!points || nbpoints == 0 || !vp || !tree || !tree->dist) {\n331\t        return -1;\n332\t    }\n333\t\n334\t    CmpFunc func = tree->dist;\n335\t    int i, error = 0;\n336\t    for (i = 0; i < nbpoints; i++) {\n337\t        float d = func(vp, points[i]);\n338\t        if (is_nan(d) || d < 0.0f) {\n339\t            return -2;\n340\t        }\n341\t        if (lvl < tree->pathlength) {\n342\t            points[i]->path[lvl] = d;\n343\t        }\n344\t    }\n345\t\n346\t    return error;\n347\t}\n348\t\n349\tstatic Node* _mvptree_add(MVPTree *tree, Node *node, MVPDP **points, unsigned int nbpoints,\n350\t                                                               MVPError *error, int lvl) {\n351\t    Node *new_node = node;\n352\t    if (nbpoints == 0) { return new_node; }\n353\t    if (!tree || lvl < 0 || !points) {\n354\t        *error = MVP_ARGERR;\n355\t        return NULL;\n356\t    }\n357\t\n358\t    CmpFunc dist_fnc = tree->dist;\n359\t    int bf = tree->branchfactor, lengthM1 = bf-1;\n360\t\n361\t    if (new_node == NULL) { /* create new node */\n362\t        int sv1_pos, sv2_pos;\n363\t        if (nbpoints <= tree->leafcap + 2) {\n364\t            /* create leaf node */\n365\t            new_node = create_leaf(tree->leafcap);\n366\t            if (!new_node) {\n367\t                *error = MVP_NOLEAF;\n368\t                return NULL;\n369\t            }\n370\t\n371\t            if (select_vantage_points(points, nbpoints, &sv1_pos, &sv2_pos, tree->dist) < 0) {\n372\t                *error = MVP_VPNOSELECT;\n373\t                free_node(new_node);\n374\t                return NULL;\n375\t            }\n376\t\n377\t            new_node->leaf.sv1 = (sv1_pos >= 0) ? points[sv1_pos] : NULL;\n378\t            new_node->leaf.sv2 = (sv2_pos >= 0) ? points[sv2_pos] : NULL;\n379\t\n380\t            if (find_distance_range_for_vp(points, nbpoints, new_node->leaf.sv1,tree,lvl) < 0) {\n381\t                *error = MVP_NOSV1RANGE;\n382\t                free_node(new_node);\n383\t                return NULL;\n384\t            }\n385\t\n386\t            if (new_node->leaf.sv2) {\n387\t                if (find_distance_range_for_vp(points,nbpoints,new_node->leaf.sv2,tree,lvl+1) < 0) {\n388\t                    *error = MVP_NOSV2RANGE;\n389\t                    free_node(new_node);\n390\t                    return NULL;\n391\t                }\n392\t            }\n393\t\n394\t            /* add remaining points to leaf */\n395\t            int i, count = 0;\n396\t            for (i=0; i < nbpoints; i++) {\n397\t                if (i == sv1_pos || i == sv2_pos) { continue; }\n398\t                new_node->leaf.d1[count] = dist_fnc(points[i], new_node->leaf.sv1);\n399\t                new_node->leaf.d2[count] = dist_fnc(points[i], new_node->leaf.sv2);\n400\t                new_node->leaf.points[count++] = points[i];\n401\t            }\n402\t            new_node->leaf.nbpoints = count;\n403\t        } else { /* create internal node */\n404\t            new_node = create_internal(tree->branchfactor);\n405\t            if (!new_node) {\n406\t                *error = MVP_NOINTERNAL;\n407\t                return NULL;\n408\t            }\n409\t\n410\t            if (select_vantage_points(points, nbpoints, &sv1_pos, &sv2_pos, tree->dist) < 0) {\n411\t                *error = MVP_VPNOSELECT;\n412\t                free_node(new_node);\n413\t                return NULL;\n414\t            }\n415\t\n416\t            new_node->internal.sv1 = points[sv1_pos];\n417\t            new_node->internal.sv2 = points[sv2_pos];\n418\t\n419\t            if (find_distance_range_for_vp(points,nbpoints,new_node->internal.sv1,tree,lvl) < 0) {\n420\t                *error = MVP_NOSV1RANGE;\n421\t                free_node(new_node);\n422\t                return NULL;\n423\t            }\n424\t\n425\t            if (find_splits(points, nbpoints, new_node->internal.sv1, tree,\n426\t                    new_node->internal.M1,lengthM1) < 0) {\n427\t                *error = MVP_NOSPLITS;\n428\t                free_node(new_node);\n429\t                return NULL;\n430\t            }\n431\t\n432\t            int i, j;\n433\t            int *binlengths = NULL;\n434\t            MVPDP ***bins = sort_points(points, nbpoints, sv1_pos, sv2_pos,\n435\t                                     new_node->internal.sv1, tree, &binlengths, new_node->internal.M1);\n436\t            if (!bins) {\n437\t                *error = MVP_NOSORT;\n438\t                free_node(new_node);\n439\t                return NULL;\n440\t            }\n441\t\n442\t            for (i=0; i < tree->branchfactor; i++) {\n443\t                /* for each bin */\n444\t                if (find_distance_range_for_vp(bins[i], binlengths[i], new_node->internal.sv2,\n445\t                                   tree, lvl+1) < 0) {\n446\t                    *error = MVP_NOSV2RANGE;\n447\t                    free_node(new_node);\n448\t                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n449\t                    free(bins);\n450\t                    return NULL;\n451\t                }\n452\t\n453\t                if (find_splits(bins[i], binlengths[i], new_node->internal.sv2, tree,\n454\t                        new_node->internal.M2 + i*lengthM1,lengthM1) < 0) {\n455\t                    *error = MVP_NOSPLITS;\n456\t                    free_node(new_node);\n457\t                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n458\t                    free(bins);\n459\t                    return NULL;\n460\t                }\n461\t\n462\t                int *bin2lengths = NULL;\n463\t                MVPDP ***bins2 = sort_points(bins[i], binlengths[i], -1, -1, new_node->internal.sv2,\n464\t                                              tree, &bin2lengths, new_node->internal.M2 + i*lengthM1);\n465\t\n466\t                if (!bins2) {\n467\t                    *error = MVP_NOSORT;\n468\t                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n469\t                    free(bins);\n470\t                    free_node(new_node);\n471\t                    return NULL;\n472\t                }\n473\t\n474\t                int j;\n475\t                for (j=0; j < tree->branchfactor; j++) {\n476\t                    /* for each row of 2nd tier bins\n477\t                     * index into child node = i*branchfactor + j */\n478\t                    Node *child = _mvptree_add(tree, NULL, bins2[j], bin2lengths[j], error, lvl+2);\n479\t                    new_node->internal.child_nodes[i*tree->branchfactor+j] = child;\n480\t                }\n481\t\n482\t                free(bin2lengths);\n483\t                for (j = 0; j < tree->branchfactor; j++) { free(bins2[j]); }\n484\t                free(bins2);\n485\t            }\n486\t\n487\t            free(binlengths);\n488\t            for (i=0; i < tree->branchfactor; i++) { free(bins[i]); }\n489\t            free(bins);\n490\t        }\n491\t    } else { /* node already exists */\n492\t        if (new_node->leaf.type == LEAF_NODE) {\n493\t            if (new_node->leaf.nbpoints + nbpoints <= tree->leafcap) {\n494\t                /* add points into leaf - plenty of room */\n495\t                if (find_distance_range_for_vp(points,nbpoints,new_node->leaf.sv1,tree,lvl) < 0) {\n496\t                    *error = MVP_NOSV1RANGE;\n497\t                    return new_node;\n498\t                }\n499\t\n500\t                int pos = 0;\n501\t                if (new_node->leaf.sv2 == NULL) {\n502\t                    new_node->leaf.sv2 = points[0];\n503\t                    pos = 1;\n504\t                }\n505\t\n506\t                if (find_distance_range_for_vp(points,nbpoints,new_node->leaf.sv2,tree,lvl+1) < 0) {\n507\t                    *error = MVP_NOSV2RANGE;\n508\t                    return new_node;\n509\t                }\n510\t\n511\t                int count = new_node->leaf.nbpoints;\n512\t                for (; pos < nbpoints;pos++) {\n513\t                    new_node->leaf.d1[count] = tree->dist(points[pos], new_node->leaf.sv1);\n514\t                    new_node->leaf.d2[count] = tree->dist(points[pos], new_node->leaf.sv2);\n515\t                    new_node->leaf.points[count++] = points[pos];\n516\t                }\n517\t                new_node->leaf.nbpoints = count;\n518\t            } else {\n519\t                /* not enough room in current leaf - create new node */\n520\t                unsigned int new_nb = new_node->leaf.nbpoints + nbpoints;\n521\t                if (new_node->leaf.sv1) { new_nb++; }\n522\t                if (new_node->leaf.sv2) { new_nb++; }\n523\t\n524\t                MVPDP **tmp_pts = (MVPDP**) malloc(new_nb*sizeof(MVPDP*));\n525\t                if (!tmp_pts) {\n526\t                    *error = MVP_MEMALLOC;\n527\t                    return new_node;\n528\t                }\n529\t\n530\t                int i, index = 0;\n531\t                if (new_node->leaf.sv1) { tmp_pts[index++] = new_node->leaf.sv1; }\n532\t                if (new_node->leaf.sv2) { tmp_pts[index++] = new_node->leaf.sv2; }\n533\t                for (i=0; i < new_node->leaf.nbpoints; i++) {\n534\t                    tmp_pts[index++] = new_node->leaf.points[i];\n535\t                }\n536\t                for (i=0; i < nbpoints; i++) {\n537\t                    tmp_pts[index++] = points[i];\n538\t                }\n539\t                Node *old_node = new_node;\n540\t                free_node(old_node);\n541\t                new_node = _mvptree_add(tree, NULL, tmp_pts, new_nb, error, lvl);\n542\t\n543\t                free(tmp_pts);\n544\t            }\n545\t        } else { /* node is internal - must recurse on subnodes */\n546\t            if (find_distance_range_for_vp(points, nbpoints, new_node->internal.sv1,tree,lvl) < 0) {\n547\t                *error = MVP_NOSV1RANGE;\n548\t                return new_node;\n549\t            }\n550\t\n551\t            int *binlengths = NULL;\n552\t            MVPDP ***bins = sort_points(points, nbpoints, -1, -1, new_node->internal.sv1,\n553\t                                                      tree, &binlengths, new_node->internal.M1);\n554\t            int i;\n555\t            if (!bins) {\n556\t                *error = MVP_NOSORT;\n557\t                return new_node;\n558\t            }\n559\t\n560\t            for (i=0; i < tree->branchfactor; i++) {\n561\t                /* for each bin */\n562\t                if (binlengths[i] <= 0) {\n563\t                    continue;\n564\t                }\n565\t                int j;\n566\t                if (find_distance_range_for_vp(bins[i], binlengths[i],\n567\t                                                new_node->internal.sv2, tree, lvl+1) < 0) {\n568\t                    *error = MVP_NOSV2RANGE;\n569\t                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n570\t                    free(bins);\n571\t                    return new_node;\n572\t                }\n573\t\n574\t                int *bin2lengths = NULL;\n575\t                MVPDP ***bins2 = sort_points(bins[i], binlengths[i], -1, -1,new_node->internal.sv2,\\\n576\t                           tree, &bin2lengths, new_node->internal.M2 + i*lengthM1);\n577\t\n578\t                if (!bins2) {\n579\t                    *error = MVP_NOSORT;\n580\t                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n581\t                    free(bins);\n582\t                    return new_node;\n583\t                }\n584\t                for (j=0; j < tree->branchfactor; j++) {\n585\t                    /* for each row of 2nd tier bins */\n586\t                    /* index into child node = i*branchfactor + j      */\n587\t                    Node *child;\n588\t                    child = _mvptree_add(tree,\n589\t                                          new_node->internal.child_nodes[i*tree->branchfactor + j],\n590\t                                          bins2[j],  bin2lengths[j],error, lvl+2);\n591\t                    new_node->internal.child_nodes[i*tree->branchfactor+j] = child;\n592\t                    if (*error != MVP_SUCCESS) { break; }\n593\t                }\n594\t\n595\t                free(bin2lengths);\n596\t                for (j=0; j <tree->branchfactor;j++) { free(bins2[j]); }\n597\t                free(bins2);\n598\t            }\n599\t\n600\t            free(binlengths);\n601\t            for (i=0;i<tree->branchfactor;i++) { free(bins[i]); }\n602\t            free(bins);\n603\t        }\n604\t    }\n605\t    return new_node;\n606\t}\n607\t\n608\tMVPError mvptree_add(MVPTree *tree, MVPDP **points, unsigned int nbpoints) {\n609\t    MVPError err = MVP_SUCCESS;\n610\t    if (nbpoints == 0) { return err; }\n611\t\n612\t    if (tree && points) {\n613\t        if (tree->datatype == 0) {\n614\t            tree->datatype = points[0]->type;\n615\t        }\n616\t        if (tree->datatype != points[0]->type) {\n617\t            return MVP_TYPEMISMATCH;\n618\t        }\n619\t\n620\t        unsigned int i;\n621\t        for (i=0; i < nbpoints; i++) {\n622\t            points[i]->path = (float*) malloc(tree->pathlength*sizeof(float));\n623\t            if (points[i]->path == NULL) {\n624\t                return MVP_PATHALLOC;\n625\t            }\n626\t            memset(points[i]->path, 0, tree->pathlength*sizeof(float));\n627\t        }\n628\t        tree->node = _mvptree_add(tree, tree->node, points, nbpoints, &err, 0);\n629\t    } else {\n630\t        err = MVP_ARGERR;\n631\t    }\n632\t    return err;\n633\t}\n634\t\n635\t\n636\tstatic\n637\tMVPError _mvptree_retrieve(MVPTree *tree,Node *node,MVPDP *target, float radius, MVPDP** results,\n638\t                                                          unsigned int *nbresults, int lvl) {\n639\t    MVPError err = MVP_SUCCESS;\n640\t    int bf = tree->branchfactor;\n641\t    int lengthM1 = bf - 1;\n642\t    float d1, d2;\n643\t    if (node == NULL) return err;\n644\t\n645\t    CmpFunc distance = tree->dist;\n646\t    unsigned int i, j;\n647\t\n648\t    if (node->leaf.type == LEAF_NODE) {\n649\t        d1 = distance(target, node->leaf.sv1);\n650\t        if (is_nan(d1) || d1 < 0.0f) {\n651\t            return MVP_BADDISTVAL;\n652\t        }\n653\t\n654\t        if (lvl < tree->pathlength) { target->path[lvl] = d1; }\n655\t        if (d1 <= radius) {\n656\t            results[(*nbresults)++] = node->leaf.sv1;\n657\t            if (*nbresults >= tree->k) { return MVP_KNEARESTCAP; }\n658\t        }\n659\t        if (tree->node->leaf.sv2) {\n660\t            d2 = distance(target, node->leaf.sv2);\n661\t\n662\t            if (is_nan(d2) || d2 < 0.0f) {\n663\t                return MVP_BADDISTVAL;\n664\t            }\n665\t            if (d2 <= radius) {\n666\t                results[(*nbresults)++] = node->leaf.sv2;\n667\t                if (*nbresults >= tree->k) { return MVP_KNEARESTCAP; }\n668\t            }\n669\t            if (lvl+1 < tree->pathlength) { target->path[lvl+1] = d2; }\n670\t\n671\t            for (i=0; i < node->leaf.nbpoints; i++) {\n672\t                /* check all points\n673\t                float d = distance(target,node->leaf.points[i]);\n674\t                fprintf(stdout, \"pnt%d distance(Q,%s)=%f\\n\",i,node->leaf.points[i]->id, d);\n675\t                if (d <= radius) {\n676\t                    results[(*nbresults)++] = node->leaf.points[i];\n677\t                    if (*nbresults >= tree->k) {\n678\t                        return MVP_KNEARESTCAP;\n679\t                    }\n680\t                }\n681\t                */\n682\t\n683\t                /* filter points before checking */\n684\t                if (d1 - radius <= node->leaf.d1[i] && d1 + radius >= node->leaf.d1[i]) {\n685\t                    if (d2 - radius <= node->leaf.d2[i] && d2 + radius >= node->leaf.d2[i]) {\n686\t                        int endpath = (lvl+1 < tree->pathlength) ? lvl+1 : tree->pathlength;\n687\t                        int skip = 0;\n688\t                        for (j=0; j < endpath; j++) {\n689\t                            if (target->path[j] - radius <= node->leaf.points[i]->path[j] &&\n690\t                                target->path[j] + radius >= node->leaf.points[i]->path[j]) {\n691\t                                continue;\n692\t                            } else {\n693\t                                skip = 1;\n694\t                                break;\n695\t                            }\n696\t                        }\n697\t\n698\t                        if (!skip) {\n699\t                            float d = distance(target, node->leaf.points[i]);\n700\t                            if (is_nan(d) || d < 0.0) {\n701\t                                return MVP_BADDISTVAL;\n702\t                            }\n703\t                            if (d <= radius) {\n704\t                                results[(*nbresults)++] = node->leaf.points[i];\n705\t                                if (*nbresults >= tree->k) {\n706\t                                    return MVP_KNEARESTCAP;\n707\t                                }\n708\t                            }\n709\t                        }\n710\t                    }\n711\t                }\n712\t            }\n713\t        }\n714\t    } else if (node->internal.type == INTERNAL_NODE) {\n715\t        d1 = distance(target, node->internal.sv1);\n716\t        if (is_nan(d1) || d1 < 0.0f) {\n717\t            return MVP_BADDISTVAL;\n718\t        }\n719\t        if (d1 <= radius) {\n720\t            results[(*nbresults)++] = node->internal.sv1;\n721\t            if (*nbresults >= tree->k) return MVP_KNEARESTCAP;\n722\t        }\n723\t        if (lvl < tree->pathlength) target->path[lvl] = d1;\n724\t        d2 = distance(target, node->internal.sv2);\n725\t        if (is_nan(d2) || d2 < 0.0f) {\n726\t            return MVP_BADDISTVAL;\n727\t        }\n728\t        if (d2 <= radius) {\n729\t            results[(*nbresults)++] = node->internal.sv2;\n730\t            if (*nbresults >= tree->k) { return MVP_KNEARESTCAP; }\n731\t        }\n732\t        if (lvl+1 < tree->pathlength) { target->path[lvl+1] = d2; }\n733\t\n734\t        /* check <= each 1st level bins */\n735\t        for (i=0; i < lengthM1; i++) {\n736\t            if (d1 - radius <= node->internal.M1[i]) {\n737\t                /* check <= each 2nd level bins */\n738\t                for (j=0; j < lengthM1; j++) {\n739\t                    if (d2 - radius <= node->internal.M2[i*lengthM1+j]) {\n740\t\n741\t                        err = _mvptree_retrieve(tree,node->internal.child_nodes[i*bf+j],target,\n742\t                                                                        radius, results, nbresults, lvl+2);\n743\t\n744\t                        if (err != MVP_SUCCESS) { return err; }\n745\t                    }\n746\t                }\n747\t                /* check >= last 2nd level bin  */\n748\t                if (d2 + radius >= node->internal.M2[i*lengthM1+lengthM1-1]) {\n749\t\n750\t                    err = _mvptree_retrieve(tree,node->internal.child_nodes[i*bf+lengthM1],\n751\t                                                target, radius, results, nbresults, lvl+2);\n752\t                    if (err != MVP_SUCCESS) { return err; }\n753\t                }\n754\t            }\n755\t        }\n756\t\n757\t        /* check >= last 1st level bin */\n758\t        if (d1 + radius >= node->internal.M1[lengthM1-1]) {\n759\t            /* check <= each 2nd level bins */\n760\t            for (j=0; j < lengthM1; j++) {\n761\t                if (d2 - radius <= node->internal.M2[lengthM1*lengthM1+j]) {\n762\t                    err = _mvptree_retrieve(tree,node->internal.child_nodes[bf*lengthM1+j],\n763\t                                                    target, radius, results, nbresults, lvl+2);\n764\t                    if (err != MVP_SUCCESS) { return err; }\n765\t                }\n766\t            }\n767\t            /* check >= last 2nd level bin  */\n768\t\n769\t            if (d2 + radius >= node->internal.M2[lengthM1*lengthM1+lengthM1-1]) {\n770\t\n771\t                err = _mvptree_retrieve(tree,node->internal.child_nodes[bf*lengthM1+lengthM1],\n772\t                                                 target, radius, results, nbresults, lvl+2);\n773\t                if (err != MVP_SUCCESS) { return err; }\n774\t            }\n775\t        }\n776\t    } else {\n777\t        err = MVP_UNRECOGNIZED;\n778\t    }\n779\t\n780\t    return err;\n781\t}\n782\t\n783\tMVPDP** mvptree_retrieve(MVPTree *tree, MVPDP *target, unsigned int knearest, float radius,\n784\t                                                 unsigned int *nbresults,MVPError *error) {\n785\t    if (!tree || !target || !nbresults || knearest == 0 || radius < 0) {\n786\t        *error = MVP_ARGERR;\n787\t        return NULL;\n788\t    }\n789\t\n790\t    if (!tree->dist) {\n791\t        *error = MVP_NODISTANCEFUNC;\n792\t        return NULL;\n793\t    }\n794\t\n795\t    *nbresults = 0;\n796\t    *error = MVP_SUCCESS;\n797\t\n798\t    if (!tree->node) {\n799\t        *error = MVP_EMPTYTREE;\n800\t        return NULL;\n801\t    }\n802\t\n803\t    MVPDP **results = (MVPDP**) malloc(knearest*sizeof(MVPDP*));\n804\t    if (!results) {\n805\t        *error = MVP_MEMALLOC;\n806\t        return NULL;\n807\t    }\n808\t\n809\t    target->path = (float*) malloc(tree->pathlength*sizeof(float));\n810\t    if (target->path == NULL) {\n811\t        *error = MVP_MEMALLOC;\n812\t        free(results);\n813\t        return NULL;\n814\t    }\n815\t    tree->k = knearest;\n816\t\n817\t    *error = _mvptree_retrieve(tree, tree->node, target, radius, results, nbresults, 0);\n818\t\n819\t    free(target->path);\n820\t    target->path = NULL;\n821\t\n822\t    return results;\n823\t}\n824\t\n825\tstatic off_t write_datapoint(MVPDP *dp, MVPTree *tree) {\n826\t    off_t start = tree->pos;\n827\t    off_t pos = tree->pos;\n828\t    uint8_t active = 0;\n829\t    uint32_t bytelength = 0;\n830\t    char *buf = tree->buf;\n831\t\n832\t    if (dp == NULL) {\n833\t        memcpy(&buf[pos++], &active, 1);\n834\t        memcpy(&buf[pos], &bytelength, sizeof(uint32_t));\n835\t        pos += sizeof(uint32_t);\n836\t        tree->pos = pos;\n837\t        return start;\n838\t    }\n839\t    active = 1;\n840\t    uint8_t idlen = strlen(dp->id);\n841\t    uint32_t datalength = dp->datalen;\n842\t    uint8_t type = dp->type;\n843\t    bytelength = sizeof(uint8_t) + idlen + sizeof(uint32_t) +\n844\t                            datalength*type + (tree->pathlength)*sizeof(float);\n845\t\n846\t    memcpy(&buf[pos++], &active    , 1);\n847\t    memcpy(&buf[pos]  , &bytelength, sizeof(uint32_t));\n848\t    pos += sizeof(uint32_t);\n849\t    memcpy(&buf[pos++], &idlen     , 1);\n850\t    memcpy(&buf[pos]  , dp->id     , idlen);\n851\t    pos += idlen;\n852\t    memcpy(&buf[pos]  , &datalength, sizeof(uint32_t));\n853\t    pos += sizeof(uint32_t);\n854\t    memcpy(&buf[pos]  , dp->data   , datalength*type);\n855\t    pos += datalength*type;\n856\t    memcpy(&buf[pos]  , dp->path   , (tree->pathlength)*sizeof(float));\n857\t    pos += (tree->pathlength)*sizeof(float);\n858\t\n859\t    tree->pos = pos;\n860\t    return start;\n861\t}\n862\t\n863\tstatic int extend_mvpfile(MVPTree *tree) {\n864\t    if (munmap(tree->buf, tree->size) < 0) {\n865\t        return -1;\n866\t    }\n867\t    if (ftruncate(tree->fd, tree->size + tree->pgsize) < 0) {\n868\t        return -2;\n869\t    }\n870\t\n871\t    tree->size += tree->pgsize;\n872\t    char *buf = (char*) mmap(NULL, tree->size, PROT_READ|PROT_WRITE, MAP_SHARED, tree->fd, 0);\n873\t    if (buf == NULL) {\n874\t        return -3;\n875\t    }\n876\t    tree->buf = buf;\n877\t\n878\t    return 0;\n879\t}\n880\t\n881\tstatic off_t _mvptree_write(MVPTree *tree,Node *node,MVPError *error,int lvl) {\n882\t    off_t start_pos = tree->pos;\n883\t    if (node == NULL) { return 0; }\n884\t\n885\t    uint8_t node_type = (uint8_t) node->leaf.type;\n886\t    if (node->leaf.type == LEAF_NODE) {\n887\t        uint32_t nbpoints = node->leaf.nbpoints;\n888\t        if (tree->pos >= tree->size - tree->pgsize/2) {\n889\t            if (extend_mvpfile(tree) < 0) {\n890\t                *error = MVP_FILETRUNCATE;\n891\t                return start_pos;\n892\t            }\n893\t        }\n894\t\n895\t        /* save node */\n896\t        memcpy(&tree->buf[tree->pos++], &node_type, 1);\n897\t        write_datapoint(node->leaf.sv1, tree);\n898\t        write_datapoint(node->leaf.sv2, tree);\n899\t        memcpy(&tree->buf[tree->pos], &nbpoints, sizeof(uint32_t));\n900\t        tree->pos += sizeof(uint32_t);\n901\t\n902\t        /* write points */\n903\t        int i;\n904\t        off_t saved_pos = tree->pos;\n905\t        tree->pos += (tree->leafcap)*(2*sizeof(float)+sizeof(off_t));\n906\t        for (i=0; i < nbpoints; i++) {\n907\t            if (tree->pos >= tree->size - tree->pgsize/2) {\n908\t                if (extend_mvpfile(tree) < 0) {\n909\t                    *error = MVP_FILETRUNCATE;\n910\t                    break;\n911\t                }\n912\t            }\n913\t\n914\t            memcpy(&tree->buf[saved_pos], &(node->leaf.d1[i]), sizeof(float));\n915\t            saved_pos += sizeof(float);\n916\t            memcpy(&tree->buf[saved_pos], &(node->leaf.d2[i]), sizeof(float));\n917\t            saved_pos += sizeof(float);\n918\t\n919\t            off_t offset = write_datapoint(node->leaf.points[i], tree);\n920\t            memcpy(&tree->buf[saved_pos], &offset, sizeof(off_t));\n921\t            saved_pos += sizeof(off_t);\n922\t        }\n923\t    } else if (node->internal.type == INTERNAL_NODE) {\n924\t        const uint8_t fileno = 0;\n925\t        int bf = tree->branchfactor;\n926\t        int lengthM1 = bf - 1;\n927\t        int lengthM2 = (bf - 1)*bf;\n928\t        int fanout   = bf*bf;\n929\t\n930\t        memcpy(&tree->buf[tree->pos++], &node_type, 1);\n931\t        write_datapoint(node->internal.sv1, tree);\n932\t        write_datapoint(node->internal.sv2, tree);\n933\t        memcpy(&tree->buf[tree->pos], node->internal.M1, lengthM1*sizeof(float));\n934\t        tree->pos += lengthM1*sizeof(float);\n935\t        memcpy(&tree->buf[tree->pos], node->internal.M2, lengthM2*sizeof(float));\n936\t        tree->pos += lengthM2*sizeof(float);\n937\t\n938\t        off_t saved_pos = tree->pos;\n939\t        tree->pos += fanout*(sizeof(uint8_t) + sizeof(off_t));\n940\t        int i;\n941\t        for (i=0; i < fanout; i++) {\n942\t            if (tree->pos >= tree->size - tree->pgsize/2) {\n943\t                if (extend_mvpfile(tree) < 0) {\n944\t                    *error = MVP_FILETRUNCATE;\n945\t                    break;\n946\t                }\n947\t            }\n948\t            off_t offset = _mvptree_write(tree, node->internal.child_nodes[i], error, lvl+2);\n949\t            memcpy(&tree->buf[saved_pos++], &fileno, 1);\n950\t            memcpy(&tree->buf[saved_pos]  , &offset, sizeof(off_t));\n951\t            saved_pos += sizeof(off_t);\n952\t        }\n953\t    } else {\n954\t        *error = MVP_UNRECOGNIZED;\n955\t    }\n956\t\n957\t    /*    msync(tree->buf, tree->size, MS_ASYNC);   */\n958\t\n959\t    return start_pos;\n960\t}\n961\t\n962\tMVPError mvptree_write(MVPTree *tree, const char *filename, int mode) {\n963\t    if (!tree || !tree->dist || !tree->node || !filename) {\n964\t        return MVP_ARGERR;\n965\t    }\n966\t\n967\t    tree->fd = open(filename, O_CREAT|O_RDWR|O_TRUNC, mode);\n968\t    if (tree->fd < 0) {\n969\t        return MVP_FILEOPEN;\n970\t    }\n971\t    tree->pgsize = sysconf(_SC_PAGESIZE);\n972\t    if (ftruncate(tree->fd, tree->pgsize) < 0) {\n973\t        close(tree->fd);\n974\t        return MVP_FILETRUNCATE;\n975\t    }\n976\t    tree->size = tree->pgsize;\n977\t    char *buf  = (char*) mmap(NULL, tree->size, PROT_READ|PROT_WRITE, MAP_SHARED, tree->fd, 0);\n978\t    if (buf == NULL) {\n979\t        close(tree->fd);\n980\t        return MVP_MEMMAP;\n981\t    }\n982\t    off_t pos = 0;\n983\t\n984\t    uint8_t bf = tree->branchfactor;\n985\t    uint8_t pl = tree->pathlength;\n986\t    uint8_t lc = tree->leafcap;\n987\t    uint8_t ht = (uint8_t) tree->node->internal.sv1->type;\n988\t\n989\t    /* write header */\n990\t    memcpy(&buf[pos], tag, strlen(tag)+1);\n991\t    pos += strlen(tag)+1;\n992\t    memcpy(&buf[pos], &version, sizeof(version));\n993\t    pos += sizeof(version);\n994\t    memcpy(&buf[pos++], &bf, 1);\n995\t    memcpy(&buf[pos++], &pl, 1);\n996\t    memcpy(&buf[pos++], &lc, 1);\n997\t    memcpy(&buf[pos++], &ht, 1);\n998\t\n999\t    tree->buf = buf;\n1000\t    pos = HEADER_SIZE;\n1001\t    tree->pos = pos;\n1002\t\n1003\t    /* write nodes */\n1004\t    MVPError error = MVP_SUCCESS;\n1005\t    _mvptree_write(tree, tree->node, &error, 0);\n1006\t\n1007\t    /* cleanup */\n1008\t    if (msync(tree->buf, tree->size, MS_SYNC) < 0) {\n1009\t        error = MVP_MEMMAP;\n1010\t    }\n1011\t\n1012\t    if (munmap(tree->buf, tree->size) < 0) {\n1013\t        error = MVP_MUNMAP;\n1014\t    }\n1015\t    tree->buf = NULL;\n1016\t\n1017\t    if (close(tree->fd) < 0) {\n1018\t        error = MVP_FILECLOSE;\n1019\t    }\n1020\t\n1021\t    return error;\n1022\t}\n1023\t\n1024\tstatic MVPDP* read_datapoint(MVPTree *tree) {\n1025\t    uint8_t active, idlen;\n1026\t    uint32_t bytelength, datalength;\n1027\t\n1028\t    memcpy(&active, &tree->buf[tree->pos], sizeof(active));\n1029\t    tree->pos += sizeof(active);\n1030\t    memcpy(&bytelength, &tree->buf[tree->pos], sizeof(bytelength));\n1031\t    tree->pos += sizeof(bytelength);\n1032\t\n1033\t    if (active == 0 && bytelength == 0) return NULL;\n1034\t\n1035\t    MVPDP *dp = dp_alloc(tree->datatype);\n1036\t    if (!dp) { return NULL; }\n1037\t\n1038\t    dp->path = (float*) malloc(tree->pathlength*sizeof(float));\n1039\t    if (!dp->path) { return NULL; }\n1040\t\n1041\t    memcpy(&idlen, &tree->buf[tree->pos], sizeof(uint8_t));\n1042\t    tree->pos += sizeof(uint8_t);\n1043\t    dp->id = malloc(idlen+1);\n1044\t    memcpy(dp->id, &tree->buf[tree->pos], idlen);\n1045\t    tree->pos += idlen;\n1046\t    dp->id[idlen] = '\\0';\n1047\t    memcpy(&datalength, &tree->buf[tree->pos], sizeof(uint32_t));\n1048\t    tree->pos += sizeof(uint32_t);\n1049\t\n1050\t    dp->datalen = datalength;\n1051\t    dp->data = malloc(datalength*tree->datatype);\n1052\t    memcpy(dp->data, &tree->buf[tree->pos], datalength*tree->datatype);\n1053\t    tree->pos += datalength*tree->datatype;\n1054\t    memcpy(dp->path, &tree->buf[tree->pos], tree->pathlength*sizeof(float));\n1055\t    tree->pos += tree->pathlength*sizeof(float);\n1056\t\n1057\t    return dp;\n1058\t}\n1059\t\n1060\tstatic Node* _mvptree_read_node(MVPTree *tree, MVPError *error, int lvl) {\n1061\t    uint8_t node_type;\n1062\t    Node *node = NULL;\n1063\t    memcpy(&node_type, &tree->buf[tree->pos++], sizeof(uint8_t));\n1064\t\n1065\t    if (node_type == LEAF_NODE) {\n1066\t        uint32_t nbpoints;\n1067\t        node = create_leaf(tree->leafcap);\n1068\t        if (!node) {\n1069\t            *error = MVP_NOLEAF;\n1070\t            return node;\n1071\t        }\n1072\t        node->leaf.sv1 = read_datapoint(tree);\n1073\t        node->leaf.sv2 = read_datapoint(tree);\n1074\t\n1075\t        memcpy(&nbpoints,&tree->buf[tree->pos], sizeof(uint32_t));\n1076\t        tree->pos += sizeof(uint32_t);\n1077\t        node->leaf.nbpoints = nbpoints;\n1078\t\n1079\t        off_t saved_pos = tree->pos;\n1080\t        int i;\n1081\t        off_t offset;\n1082\t        for (i = 0; i < nbpoints; i++) {\n1083\t            memcpy(&(node->leaf.d1[i]), &tree->buf[saved_pos], sizeof(float));\n1084\t            saved_pos += sizeof(float);\n1085\t            memcpy(&(node->leaf.d2[i]), &tree->buf[saved_pos], sizeof(float));\n1086\t            saved_pos += sizeof(float);\n1087\t            memcpy(&offset, &tree->buf[saved_pos], sizeof(off_t));\n1088\t            saved_pos += sizeof(off_t);\n1089\t\n1090\t            tree->pos = offset;\n1091\t            node->leaf.points[i] = read_datapoint(tree);\n1092\t        }\n1093\t    } else if (node_type == INTERNAL_NODE) {\n1094\t        int bf = tree->branchfactor;\n1095\t        int lengthM1 = bf - 1;\n1096\t        int lengthM2 = (bf - 1)*bf;\n1097\t        int fanout   = bf*bf;\n1098\t        uint8_t fileno;\n1099\t\n1100\t        node = create_internal(bf);\n1101\t        if (node == NULL) {\n1102\t            *error = MVP_NOINTERNAL;\n1103\t            return node;\n1104\t        }\n1105\t        node->internal.sv1 = read_datapoint(tree);\n1106\t        node->internal.sv2 = read_datapoint(tree);\n1107\t\n1108\t        memcpy(node->internal.M1, &tree->buf[tree->pos], lengthM1*sizeof(float));\n1109\t        tree->pos += lengthM1*sizeof(float);\n1110\t        memcpy(node->internal.M2, &tree->buf[tree->pos], lengthM2*sizeof(float));\n1111\t        tree->pos += lengthM2*sizeof(float);\n1112\t\n1113\t        int i;\n1114\t        off_t offset, saved_pos = tree->pos;\n1115\t        for (i = 0;i < fanout; i++) {\n1116\t            memcpy(&fileno, &tree->buf[saved_pos], sizeof(fileno));\n1117\t            saved_pos += sizeof(fileno);\n1118\t            memcpy(&offset, &tree->buf[saved_pos], sizeof(offset));\n1119\t            saved_pos += sizeof(offset);\n1120\t\n1121\t            tree->pos = offset;\n1122\t            node->internal.child_nodes[i] = _mvptree_read_node(tree, error, lvl+2);\n1123\t            if (*error != MVP_SUCCESS) { break; }\n1124\t        }\n1125\t    } else {\n1126\t        *error = MVP_UNRECOGNIZED;\n1127\t    }\n1128\t    return node;\n1129\t}\n1130\t\n1131\tMVPTree* mvptree_read(const char *filename, CmpFunc fnc, int branchfactor, int pathlength,\n1132\t                               int leafcapacity,MVPError *error) {\n1133\t    if (!error) { return NULL; }\n1134\t    *error = MVP_SUCCESS;\n1135\t    if (!filename || !fnc) {\n1136\t        *error = MVP_ARGERR;\n1137\t        return NULL;\n1138\t    }\n1139\t    MVPTree *tree = NULL;\n1140\t\n1141\t    int fd = open(filename, O_RDONLY);\n1142\t    if (fd < 0) {\n1143\t        /* file not found return empty tree */\n1144\t        tree = mvptree_alloc(NULL, fnc, branchfactor, pathlength, leafcapacity);\n1145\t        *error = MVP_FILENOTFOUND;\n1146\t        return tree;\n1147\t    }\n1148\t\n1149\t    struct stat file_info;\n1150\t    if (fstat(fd, &file_info) < 0) {\n1151\t        *error = MVP_FILEOPEN;\n1152\t        return NULL;\n1153\t    }\n1154\t    off_t size = file_info.st_size;\n1155\t\n1156\t    char *buf = (char*) mmap(NULL, size, PROT_READ, MAP_SHARED, fd, 0);\n1157\t    if (buf == NULL) {\n1158\t        *error = MVP_MEMMAP;\n1159\t        close(fd);\n1160\t        return NULL;\n1161\t    }\n1162\t    off_t pos = 0;\n1163\t    char line[16];\n1164\t    int v;\n1165\t    uint8_t bf, pl, lc, ht;\n1166\t\n1167\t    memcpy(line, &buf[pos], strlen(tag)+1);\n1168\t    pos += strlen(tag)+1;\n1169\t    memcpy(&v, &buf[pos], sizeof(int));\n1170\t    pos += sizeof(int);\n1171\t    memcpy(&bf, &buf[pos++], 1);\n1172\t    memcpy(&pl, &buf[pos++], 1);\n1173\t    memcpy(&lc, &buf[pos++], 1);\n1174\t    memcpy(&ht, &buf[pos++], 1);\n1175\t\n1176\t    tree = mvptree_alloc(NULL, fnc, bf, pl, lc);\n1177\t    if (!tree) {\n1178\t        *error = MVP_MEMALLOC;\n1179\t        return NULL;\n1180\t    }\n1181\t    tree->pgsize = sysconf(_SC_PAGESIZE);\n1182\t    tree->size = size;\n1183\t    tree->buf = buf;\n1184\t    tree->pos = HEADER_SIZE;\n1185\t    tree->fd = fd;\n1186\t    tree->datatype = (MVPDataType) ht;\n1187\t    tree->dist = fnc;\n1188\t    tree->node = _mvptree_read_node(tree, error, 0);\n1189\t\n1190\t    if (munmap(buf, size) < 0) {\n1191\t        *error = MVP_MUNMAP;\n1192\t    }\n1193\t    tree->buf = NULL;\n1194\t\n1195\t    if (close(fd) < 0) {\n1196\t        *error = MVP_FILECLOSE;\n1197\t    }\n1198\t    tree->buf = NULL;\n1199\t    tree->pos = 0;\n1200\t    tree->fd  = 0;\n1201\t\n1202\t    return tree;\n1203\t}\n1204\t\n1205\tstatic MVPError _mvptree_print(FILE *stream, MVPTree *tree, Node *node, int lvl) {\n1206\t    MVPError error = MVP_SUCCESS;\n1207\t    Node *next_node = node;\n1208\t    int bf = tree->branchfactor, lengthM1 = bf-1, lengthM2 = bf, fanout = bf*bf;\n1209\t\n1210\t    if (next_node) {\n1211\t        if (next_node->leaf.type == LEAF_NODE) {\n1212\t            fprintf(stream, \"LEAF%d  (%d points)\\n\", lvl, next_node->leaf.nbpoints);\n1213\t            if (next_node->leaf.sv1) {\n1214\t                fprintf(stream, \"    sv1: %s\\n\", next_node->leaf.sv1->id);\n1215\t            }\n1216\t            if (next_node->leaf.sv2) {\n1217\t                fprintf(stream, \"    sv2: %s\\n\", next_node->leaf.sv2->id);\n1218\t            }\n1219\t\n1220\t            int i;\n1221\t            for (i = 0; i < next_node->leaf.nbpoints; i++) {\n1222\t                fprintf(stream, \"        point[%d]: %s\\n\", i, next_node->leaf.points[i]->id);\n1223\t            }\n1224\t        } else if (next_node->internal.type == INTERNAL_NODE) {\n1225\t            fprintf(stream, \"INTERNAL%d\\n\", lvl);\n1226\t            fprintf(stream, \"  sv1: %s\\n\", next_node->internal.sv1->id);\n1227\t            fprintf(stream, \"  sv2: %s\\n\", next_node->internal.sv2->id);\n1228\t\n1229\t            int i;\n1230\t            for (i=0; i < lengthM1; i++) {\n1231\t                fprintf(stream, \"  M1[%d] = %.4f;\", i, next_node->internal.M1[i]);\n1232\t            }\n1233\t            for (i=0; i < lengthM2; i++) {\n1234\t                fprintf(stream, \"  M2[%d] = %.4f;\", i, next_node->internal.M2[i]);\n1235\t            }\n1236\t            fprintf(stream, \"\\n\");\n1237\t\n1238\t            for (i=0; i < fanout; i++) {\n1239\t                error = _mvptree_print(stream, tree, node->internal.child_nodes[i], lvl+2);\n1240\t                if (error != MVP_SUCCESS) { break; }\n1241\t            }\n1242\t        } else {\n1243\t            error = MVP_UNRECOGNIZED;\n1244\t        }\n1245\t    } else {\n1246\t        fprintf(stream, \"NULL%d\\n\", lvl);\n1247\t    }\n1248\t\n1249\t    return error;\n1250\t}\n1251\t\n1252\tMVPError mvptree_print(FILE *stream, MVPTree *tree) {\n1253\t    if (stream == NULL || tree == NULL) {\n1254\t        return MVP_ARGERR;\n1255\t    }\n1256\t\n1257\t    MVPError err = _mvptree_print(stream, tree, tree->node, 0);\n1258\t    if (err != MVP_SUCCESS) {\n1259\t        fprintf(stream, \"malformed tree: %s\\n\", mvp_errstr(err));\n1260\t    }\n1261\t\n1262\t    return err;\n1263\t}\n1264\t"}]},"parent_tool_use_id":null,"session_id":"5e427b1c-adf1-40da-b66c-7c6416627add","uuid":"b22d212c-a6c5-429f-ac68-dbdbc0db0c3a","timestamp":"2026-05-29T12:58:49.988Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-4v1luP/project/c_src/mvptree.c","content":"/*\n *  MVPTree c library\n *  Copyright (C) 2008-2009 by D. Grant Starkweather.\n *  All rights reserved.\n *\n *  This program is free software: you can redistribute it and/or modify\n *  it under the terms of the GNU General Public License as published by\n *  the Free Software Foundation, either version 3 of the License, or\n *  (at your option) any later version.\n *\n *  This program is distributed in the hope that it will be useful,\n *  but WITHOUT ANY WARRANTY; without even the implied warranty of\n *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n *  GNU General Public License for more details.\n *\n *  You should have received a copy of the GNU General Public License\n *  along with this program.  If not, see <http://www.gnu.org/licenses/>.\n *\n *  D Grant Starkweather - starkd88@gmail.com\n */\n\n#include <stdlib.h>\n#include <stdio.h>\n#include <string.h>\n#include <stdint.h>\n#include <math.h>\n#include <sys/types.h>\n#include <sys/stat.h>\n#include <sys/mman.h>\n#include <fcntl.h>\n#include <unistd.h>\n#include \"mvptree.h\"\n\n#define HEADER_SIZE 32\n#define _FILE_OFFSET_BITS 64\n#define _LARGEFILE64_SOURCE\n\nconst char *tag = \"phashmvp2010\";\nconst int version = 0x01000000;\n\nconst char *error_msgs[] = {\n    \"no error\",\n    \"bad argument\",\n    \"no distance function found\",\n    \"mem alloc error\",\n    \"no leaf node created\",\n    \"no internal node created\",\n    \"no path array alloc'd\",\n    \"could not select vantage points\",\n    \"could not calculate range from an sv1\",\n    \"could not calculate range from an sv2\",\n    \"points too compact\",\n    \"could not sort points\",\n    \"could not open file\",\n    \"could not close file\",\n    \"mmap error\",\n    \"unmap eror\",\n    \"no write\",\n    \"could not extend file\",\n    \"could not remap file\",\n    \"datatypes in conflict\",\n    \"no. retrieved exceeds k\",\n    \"empty tree\",\n    \"distance value either NaN or less than zero\",\n    \"could not open file\",\n    \"unrecognized node\" };\n\n\nconst char* mvp_errstr(MVPError err) {\n    return error_msgs[(int) err];\n}\n\nMVPDP* dp_alloc(MVPDataType type) {\n    MVPDP *newdp = (MVPDP*) malloc(sizeof(MVPDP));\n    newdp->id = NULL;\n    newdp->data = NULL;\n    newdp->datalen = 0;\n    newdp->type = type;\n    newdp->path = NULL;\n    return newdp;\n}\n\nvoid dp_free(MVPDP *dp, MVPFreeFunc free_func) {\n    if (dp) {\n        if (dp->path) { free(dp->path); }\n        if (free_func) {\n            if (dp->id)    free_func(dp->id);\n            if (dp->data) free_func(dp->data);\n        }\n        free(dp);\n    }\n}\n\nMVPTree* mvptree_alloc(MVPTree *tree, CmpFunc distance, unsigned int bf, unsigned int p,\n                                                           unsigned int k) {\n    if (distance == NULL) {\n        return NULL;\n    }\n\n    MVPTree *retTree;\n    if (tree == NULL) {\n        retTree = (MVPTree*) malloc(sizeof(MVPTree));\n        if (retTree  == NULL) { return NULL; }\n    } else {\n        retTree = tree;\n    }\n\n    retTree->branchfactor = bf;\n    retTree->pathlength   = p;\n    retTree->leafcap      = k;\n    retTree->dist         = distance;\n    retTree->datatype     = 0;\n    retTree->node         = NULL;\n    retTree->fd           = 0;\n    retTree->k            = 0;\n    retTree->size         = 0;\n    retTree->pos          = 0;\n    retTree->buf          = NULL;\n    retTree->pgsize       = sysconf(_SC_PAGESIZE);\n\n    return retTree;\n}\n\n/* custom isnan function */\nstatic int is_nan(float x) {\n    float var = x;\n    return (var != var) ? 1 : 0;\n}\n\nstatic Node* create_leaf(unsigned int leafcap) {\n    Node *node = (Node*) malloc(sizeof(Node));\n    node->leaf.sv1 = NULL;\n    node->leaf.sv2 = NULL;\n    node->leaf.points = (MVPDP**) calloc(leafcap, sizeof(MVPDP*));\n    node->leaf.d1 = (float*) calloc(leafcap,sizeof(float));\n    node->leaf.d2 = (float*) calloc(leafcap,sizeof(float));\n    node->leaf.nbpoints = 0;\n    node->leaf.type = LEAF_NODE;\n\n    return node;\n}\n\nstatic Node* create_internal(unsigned int bf) {\n    Node *node = (Node*) malloc(sizeof(Node));\n    node->internal.sv1 = NULL;\n    node->internal.sv2 = NULL;\n    node->internal.M1 = (float*) calloc(bf-1, sizeof(float));\n    node->internal.M2 = (float*) calloc(bf, sizeof(float));\n    node->internal.child_nodes = calloc(bf*bf, sizeof(Node*));\n    node->internal.type = INTERNAL_NODE;\n\n    return node;\n}\n\nstatic void free_node(Node *node) {\n    if (node) {\n        if (node->leaf.type == LEAF_NODE) {\n            free(node->leaf.points);\n            free(node->leaf.d1);\n            free(node->leaf.d2);\n        } else if (node->internal.type == INTERNAL_NODE) {\n            free(node->internal.M1);\n            free(node->internal.M2);\n            free(node->internal.child_nodes);\n        }\n        free(node);\n    }\n}\n\nstatic void _mvptree_clear(MVPTree *tree, Node *node, MVPFreeFunc free_func, int lvl) {\n    if (!node) { return; }\n\n    int i;\n    if (node->internal.type == INTERNAL_NODE) {\n        int fanout = tree->branchfactor*tree->branchfactor;\n        for (i = 0; i < fanout; i++) {\n            _mvptree_clear(tree, node->internal.child_nodes[i], free_func, lvl+1);\n        }\n        dp_free(node->internal.sv1, free_func);\n        dp_free(node->internal.sv2, free_func);\n    } else {\n        dp_free(node->leaf.sv1, free_func);\n        dp_free(node->leaf.sv2, free_func);\n\n        for (i=0; i< node->leaf.nbpoints; i++) {\n            dp_free(node->leaf.points[i], free_func);\n        }\n    }\n    free_node(node);\n}\n\nvoid mvptree_clear(MVPTree *tree, MVPFreeFunc free_func) {\n    if (!tree || !tree->node) { return; }\n    _mvptree_clear(tree, tree->node, free_func, 0);\n}\n\n/*\n   Select the two points at maximum distance from each other using the dist metric.\n   Return the positions in list of points in sv1_pos and sv2_pos\n*/\n\nstatic int select_vantage_points(MVPDP **points, unsigned int nb,int *sv1_pos, int *sv2_pos,\n                                                      CmpFunc dist) {\n    if (!points || !sv1_pos || !sv2_pos || !dist || nb == 0) { return -1; }\n\n    *sv1_pos = (nb >= 1) ? 0 : -1;\n    *sv2_pos = -1;\n\n    float max_dist = 0.0f, d;\n    int i, j;\n    for (i = 0; i < nb; i++) {\n        for (j = i+1; j < nb; j++) {\n            d = dist(points[i], points[j]);\n            if (is_nan(d) || d < 0.0f) {\n                return -2;\n            }\n\n            if (d > max_dist) {\n                max_dist = d;\n                *sv1_pos = i;\n                *sv2_pos = j;\n            }\n        }\n    }\n\n    return 0;\n}\n\n\nstatic int find_splits(MVPDP **points, unsigned int nb, MVPDP *vp, MVPTree *tree,\n                                                     float *M, unsigned int lengthM) {\n    if (!points || nb == 0 || !M || lengthM == 0) return -1;\n\n    CmpFunc distfunc = tree->dist;\n    float *dist = (float*) malloc(nb*sizeof(float));\n\n    int i, j;\n    for (i = 0; i < nb; i++) {\n        dist[i] = distfunc(points[i], vp);\n        if (is_nan(dist[i]) || dist[i] < 0.0f) {\n            free(dist);\n            return -2;\n        }\n    }\n\n    int min_pos;\n    for (i = 0;i < nb-1;i++) {\n        min_pos = i;\n        for (j = i+1; j < nb; j++) {\n            if (dist[j] < dist[min_pos]) {\n                min_pos = j;\n            }\n        }\n\n        if (min_pos != i) {\n            float tmp = dist[min_pos];\n            dist[min_pos] = dist[i];\n            dist[i] = tmp;\n        }\n    }\n\n    for (i = 0; i < lengthM; i++) {\n        int index = (i+1)*nb/(lengthM+1);\n        if (index <= 0) { index = 0; }\n        if (index >= nb) { index = nb-1; }\n        M[i] = dist[index];\n    }\n\n    free(dist);\n    return 0;\n}\n\n/* Sort points into bins by distance(points[i], dp) for each i in list, skipping\n * points[sv1_pos] and points[sv2_pos]. Use pivot[LengthM1] array as pivot points\n * to determine which bins. */\nstatic MVPDP*** sort_points(MVPDP **points, unsigned int nbpoints, int sv1_pos, int sv2_pos,\n                         MVPDP *vp, MVPTree *tree, int **counts, float *pivots) {\n    if (!points || !vp || !tree || !counts || !pivots || nbpoints == 0) { return NULL; }\n\n    CmpFunc distfunc = tree->dist;\n    int bf = tree->branchfactor;\n    int lengthM1 = bf-1;\n\n    MVPDP*** bins = (MVPDP***) malloc(bf*sizeof(MVPDP**));\n    if (!bins) return NULL;\n\n    *counts = (int*) calloc(bf, sizeof(int));\n    if (!counts) {\n        free(bins);\n        return NULL;\n    }\n\n    int i, k;\n    for (i=0; i < bf; i++) {\n        bins[i] = (MVPDP**) malloc(nbpoints*sizeof(MVPDP*));\n        if (!bins[i]) { return NULL; }\n    }\n\n    for (i=0;i<nbpoints;i++) {\n        if (i == sv1_pos || i == sv2_pos) { continue; }\n\n        float d = distfunc(vp, points[i]);\n        if (is_nan(d) || d < 0.0f) {\n            free(counts);\n            free(bins);\n            return NULL;\n        }\n\n        for (k = 0; k < lengthM1; k++) {\n            if (d <= pivots[k]) {\n                bins[k][(*counts)[k]] = points[i];\n                (*counts)[k]++;\n                break;\n            }\n        }\n\n        if (d > pivots[lengthM1-1]) {\n            bins[lengthM1][(*counts)[lengthM1]] = points[i];\n            (*counts)[lengthM1]++;\n        }\n    }\n\n    return bins;\n}\n\n/* Calculate distances for all points from given vantage point, vp, and\n   assign that distance into each points path using the lvl parameter. */\nstatic int find_distance_range_for_vp(MVPDP **points, unsigned int nbpoints, MVPDP *vp,\n                                      MVPTree *tree, int lvl) {\n    if (!points || nbpoints == 0 || !vp || !tree || !tree->dist) {\n        return -1;\n    }\n\n    CmpFunc func = tree->dist;\n    int i, error = 0;\n    for (i = 0; i < nbpoints; i++) {\n        float d = func(vp, points[i]);\n        if (is_nan(d) || d < 0.0f) {\n            return -2;\n        }\n        if (lvl < tree->pathlength) {\n            points[i]->path[lvl] = d;\n        }\n    }\n\n    return error;\n}\n\nstatic Node* _mvptree_add(MVPTree *tree, Node *node, MVPDP **points, unsigned int nbpoints,\n                                                               MVPError *error, int lvl) {\n    Node *new_node = node;\n    if (nbpoints == 0) { return new_node; }\n    if (!tree || lvl < 0 || !points) {\n        *error = MVP_ARGERR;\n        return NULL;\n    }\n\n    CmpFunc dist_fnc = tree->dist;\n    int bf = tree->branchfactor, lengthM1 = bf-1;\n\n    if (new_node == NULL) { /* create new node */\n        int sv1_pos, sv2_pos;\n        if (nbpoints <= tree->leafcap + 2) {\n            /* create leaf node */\n            new_node = create_leaf(tree->leafcap);\n            if (!new_node) {\n                *error = MVP_NOLEAF;\n                return NULL;\n            }\n\n            if (select_vantage_points(points, nbpoints, &sv1_pos, &sv2_pos, tree->dist) < 0) {\n                *error = MVP_VPNOSELECT;\n                free_node(new_node);\n                return NULL;\n            }\n\n            new_node->leaf.sv1 = (sv1_pos >= 0) ? points[sv1_pos] : NULL;\n            new_node->leaf.sv2 = (sv2_pos >= 0) ? points[sv2_pos] : NULL;\n\n            if (find_distance_range_for_vp(points, nbpoints, new_node->leaf.sv1,tree,lvl) < 0) {\n                *error = MVP_NOSV1RANGE;\n                free_node(new_node);\n                return NULL;\n            }\n\n            if (new_node->leaf.sv2) {\n                if (find_distance_range_for_vp(points,nbpoints,new_node->leaf.sv2,tree,lvl+1) < 0) {\n                    *error = MVP_NOSV2RANGE;\n                    free_node(new_node);\n                    return NULL;\n                }\n            }\n\n            /* add remaining points to leaf */\n            int i, count = 0;\n            for (i=0; i < nbpoints; i++) {\n                if (i == sv1_pos || i == sv2_pos) { continue; }\n                new_node->leaf.d1[count] = dist_fnc(points[i], new_node->leaf.sv1);\n                new_node->leaf.d2[count] = dist_fnc(points[i], new_node->leaf.sv2);\n                new_node->leaf.points[count++] = points[i];\n            }\n            new_node->leaf.nbpoints = count;\n        } else { /* create internal node */\n            new_node = create_internal(tree->branchfactor);\n            if (!new_node) {\n                *error = MVP_NOINTERNAL;\n                return NULL;\n            }\n\n            if (select_vantage_points(points, nbpoints, &sv1_pos, &sv2_pos, tree->dist) < 0) {\n                *error = MVP_VPNOSELECT;\n                free_node(new_node);\n                return NULL;\n            }\n\n            new_node->internal.sv1 = points[sv1_pos];\n            new_node->internal.sv2 = points[sv2_pos];\n\n            if (find_distance_range_for_vp(points,nbpoints,new_node->internal.sv1,tree,lvl) < 0) {\n                *error = MVP_NOSV1RANGE;\n                free_node(new_node);\n                return NULL;\n            }\n\n            if (find_splits(points, nbpoints, new_node->internal.sv1, tree,\n                    new_node->internal.M1,lengthM1) < 0) {\n                *error = MVP_NOSPLITS;\n                free_node(new_node);\n                return NULL;\n            }\n\n            int i, j;\n            int *binlengths = NULL;\n            MVPDP ***bins = sort_points(points, nbpoints, sv1_pos, sv2_pos,\n                                     new_node->internal.sv1, tree, &binlengths, new_node->internal.M1);\n            if (!bins) {\n                *error = MVP_NOSORT;\n                free_node(new_node);\n                return NULL;\n            }\n\n            for (i=0; i < tree->branchfactor; i++) {\n                /* for each bin */\n                if (find_distance_range_for_vp(bins[i], binlengths[i], new_node->internal.sv2,\n                                   tree, lvl+1) < 0) {\n                    *error = MVP_NOSV2RANGE;\n                    free_node(new_node);\n                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n                    free(bins);\n                    return NULL;\n                }\n\n                if (find_splits(bins[i], binlengths[i], new_node->internal.sv2, tree,\n                        new_node->internal.M2 + i*lengthM1,lengthM1) < 0) {\n                    *error = MVP_NOSPLITS;\n                    free_node(new_node);\n                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n                    free(bins);\n                    return NULL;\n                }\n\n                int *bin2lengths = NULL;\n                MVPDP ***bins2 = sort_points(bins[i], binlengths[i], -1, -1, new_node->internal.sv2,\n                                              tree, &bin2lengths, new_node->internal.M2 + i*lengthM1);\n\n                if (!bins2) {\n                    *error = MVP_NOSORT;\n                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n                    free(bins);\n                    free_node(new_node);\n                    return NULL;\n                }\n\n                int j;\n                for (j=0; j < tree->branchfactor; j++) {\n                    /* for each row of 2nd tier bins\n                     * index into child node = i*branchfactor + j */\n                    Node *child = _mvptree_add(tree, NULL, bins2[j], bin2lengths[j], error, lvl+2);\n                    new_node->internal.child_nodes[i*tree->branchfactor+j] = child;\n                }\n\n                free(bin2lengths);\n                for (j = 0; j < tree->branchfactor; j++) { free(bins2[j]); }\n                free(bins2);\n            }\n\n            free(binlengths);\n            for (i=0; i < tree->branchfactor; i++) { free(bins[i]); }\n            free(bins);\n        }\n    } else { /* node already exists */\n        if (new_node->leaf.type == LEAF_NODE) {\n            if (new_node->leaf.nbpoints + nbpoints <= tree->leafcap) {\n                /* add points into leaf - plenty of room */\n                if (find_distance_range_for_vp(points,nbpoints,new_node->leaf.sv1,tree,lvl) < 0) {\n                    *error = MVP_NOSV1RANGE;\n                    return new_node;\n                }\n\n                int pos = 0;\n                if (new_node->leaf.sv2 == NULL) {\n                    new_node->leaf.sv2 = points[0];\n                    pos = 1;\n                }\n\n                if (find_distance_range_for_vp(points,nbpoints,new_node->leaf.sv2,tree,lvl+1) < 0) {\n                    *error = MVP_NOSV2RANGE;\n                    return new_node;\n                }\n\n                int count = new_node->leaf.nbpoints;\n                for (; pos < nbpoints;pos++) {\n                    new_node->leaf.d1[count] = tree->dist(points[pos], new_node->leaf.sv1);\n                    new_node->leaf.d2[count] = tree->dist(points[pos], new_node->leaf.sv2);\n                    new_node->leaf.points[count++] = points[pos];\n                }\n                new_node->leaf.nbpoints = count;\n            } else {\n                /* not enough room in current leaf - create new node */\n                unsigned int new_nb = new_node->leaf.nbpoints + nbpoints;\n                if (new_node->leaf.sv1) { new_nb++; }\n                if (new_node->leaf.sv2) { new_nb++; }\n\n                MVPDP **tmp_pts = (MVPDP**) malloc(new_nb*sizeof(MVPDP*));\n                if (!tmp_pts) {\n                    *error = MVP_MEMALLOC;\n                    return new_node;\n                }\n\n                int i, index = 0;\n                if (new_node->leaf.sv1) { tmp_pts[index++] = new_node->leaf.sv1; }\n                if (new_node->leaf.sv2) { tmp_pts[index++] = new_node->leaf.sv2; }\n                for (i=0; i < new_node->leaf.nbpoints; i++) {\n                    tmp_pts[index++] = new_node->leaf.points[i];\n                }\n                for (i=0; i < nbpoints; i++) {\n                    tmp_pts[index++] = points[i];\n                }\n                Node *old_node = new_node;\n                free_node(old_node);\n                new_node = _mvptree_add(tree, NULL, tmp_pts, new_nb, error, lvl);\n\n                free(tmp_pts);\n            }\n        } else { /* node is internal - must recurse on subnodes */\n            if (find_distance_range_for_vp(points, nbpoints, new_node->internal.sv1,tree,lvl) < 0) {\n                *error = MVP_NOSV1RANGE;\n                return new_node;\n            }\n\n            int *binlengths = NULL;\n            MVPDP ***bins = sort_points(points, nbpoints, -1, -1, new_node->internal.sv1,\n                                                      tree, &binlengths, new_node->internal.M1);\n            int i;\n            if (!bins) {\n                *error = MVP_NOSORT;\n                return new_node;\n            }\n\n            for (i=0; i < tree->branchfactor; i++) {\n                /* for each bin */\n                if (binlengths[i] <= 0) {\n                    continue;\n                }\n                int j;\n                if (find_distance_range_for_vp(bins[i], binlengths[i],\n                                                new_node->internal.sv2, tree, lvl+1) < 0) {\n                    *error = MVP_NOSV2RANGE;\n                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n                    free(bins);\n                    return new_node;\n                }\n\n                int *bin2lengths = NULL;\n                MVPDP ***bins2 = sort_points(bins[i], binlengths[i], -1, -1,new_node->internal.sv2,\\\n                           tree, &bin2lengths, new_node->internal.M2 + i*lengthM1);\n\n                if (!bins2) {\n                    *error = MVP_NOSORT;\n                    for (j=0; j < tree->branchfactor; j++) { free(bins[j]); }\n                    free(bins);\n                    return new_node;\n                }\n                for (j=0; j < tree->branchfactor; j++) {\n                    /* for each row of 2nd tier bins */\n                    /* index into child node = i*branchfactor + j      */\n                    Node *child;\n                    child = _mvptree_add(tree,\n                                          new_node->internal.child_nodes[i*tree->branchfactor + j],\n                                          bins2[j],  bin2lengths[j],error, lvl+2);\n                    new_node->internal.child_nodes[i*tree->branchfactor+j] = child;\n                    if (*error != MVP_SUCCESS) { break; }\n                }\n\n                free(bin2lengths);\n                for (j=0; j <tree->branchfactor;j++) { free(bins2[j]); }\n                free(bins2);\n            }\n\n            free(binlengths);\n            for (i=0;i<tree->branchfactor;i++) { free(bins[i]); }\n            free(bins);\n        }\n    }\n    return new_node;\n}\n\nMVPError mvptree_add(MVPTree *tree, MVPDP **points, unsigned int nbpoints) {\n    MVPError err = MVP_SUCCESS;\n    if (nbpoints == 0) { return err; }\n\n    if (tree && points) {\n        if (tree->datatype == 0) {\n            tree->datatype = points[0]->type;\n        }\n        if (tree->datatype != points[0]->type) {\n            return MVP_TYPEMISMATCH;\n        }\n\n        unsigned int i;\n        for (i=0; i < nbpoints; i++) {\n            points[i]->path = (float*) malloc(tree->pathlength*sizeof(float));\n            if (points[i]->path == NULL) {\n                return MVP_PATHALLOC;\n            }\n            memset(points[i]->path, 0, tree->pathlength*sizeof(float));\n        }\n        tree->node = _mvptree_add(tree, tree->node, points, nbpoints, &err, 0);\n    } else {\n        err = MVP_ARGERR;\n    }\n    return err;\n}\n\n\nstatic\nMVPError _mvptree_retrieve(MVPTree *tree,Node *node,MVPDP *target, float radius, MVPDP** results,\n                                                          unsigned int *nbresults, int lvl) {\n    MVPError err = MVP_SUCCESS;\n    int bf = tree->branchfactor;\n    int lengthM1 = bf - 1;\n    float d1, d2;\n    if (node == NULL) return err;\n\n    CmpFunc distance = tree->dist;\n    unsigned int i, j;\n\n    if (node->leaf.type == LEAF_NODE) {\n        d1 = distance(target, node->leaf.sv1);\n        if (is_nan(d1) || d1 < 0.0f) {\n            return MVP_BADDISTVAL;\n        }\n\n        if (lvl < tree->pathlength) { target->path[lvl] = d1; }\n        if (d1 <= radius) {\n            results[(*nbresults)++] = node->leaf.sv1;\n            if (*nbresults >= tree->k) { return MVP_KNEARESTCAP; }\n        }\n        if (tree->node->leaf.sv2) {\n            d2 = distance(target, node->leaf.sv2);\n\n            if (is_nan(d2) || d2 < 0.0f) {\n                return MVP_BADDISTVAL;\n            }\n            if (d2 <= radius) {\n                results[(*nbresults)++] = node->leaf.sv2;\n                if (*nbresults >= tree->k) { return MVP_KNEARESTCAP; }\n            }\n            if (lvl+1 < tree->pathlength) { target->path[lvl+1] = d2; }\n\n            for (i=0; i < node->leaf.nbpoints; i++) {\n                /* check all points\n                float d = distance(target,node->leaf.points[i]);\n                fprintf(stdout, \"pnt%d distance(Q,%s)=%f\\n\",i,node->leaf.points[i]->id, d);\n                if (d <= radius) {\n                    results[(*nbresults)++] = node->leaf.points[i];\n                    if (*nbresults >= tree->k) {\n                        return MVP_KNEARESTCAP;\n                    }\n                }\n                */\n\n                /* filter points before checking */\n                if (d1 - radius <= node->leaf.d1[i] && d1 + radius >= node->leaf.d1[i]) {\n                    if (d2 - radius <= node->leaf.d2[i] && d2 + radius >= node->leaf.d2[i]) {\n                        int endpath = (lvl+1 < tree->pathlength) ? lvl+1 : tree->pathlength;\n                        int skip = 0;\n                        for (j=0; j < endpath; j++) {\n                            if (target->path[j] - radius <= node->leaf.points[i]->path[j] &&\n                                target->path[j] + radius >= node->leaf.points[i]->path[j]) {\n                                continue;\n                            } else {\n                                skip = 1;\n                                break;\n                            }\n                        }\n\n                        if (!skip) {\n                            float d = distance(target, node->leaf.points[i]);\n                            if (is_nan(d) || d < 0.0) {\n                                return MVP_BADDISTVAL;\n                            }\n                            if (d <= radius) {\n                                results[(*nbresults)++] = node->leaf.points[i];\n                                if (*nbresults >= tree->k) {\n                                    return MVP_KNEARESTCAP;\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    } else if (node->internal.type == INTERNAL_NODE) {\n        d1 = distance(target, node->internal.sv1);\n        if (is_nan(d1) || d1 < 0.0f) {\n            return MVP_BADDISTVAL;\n        }\n        if (d1 <= radius) {\n            results[(*nbresults)++] = node->internal.sv1;\n            if (*nbresults >= tree->k) return MVP_KNEARESTCAP;\n        }\n        if (lvl < tree->pathlength) target->path[lvl] = d1;\n        d2 = distance(target, node->internal.sv2);\n        if (is_nan(d2) || d2 < 0.0f) {\n            return MVP_BADDISTVAL;\n        }\n        if (d2 <= radius) {\n            results[(*nbresults)++] = node->internal.sv2;\n            if (*nbresults >= tree->k) { return MVP_KNEARESTCAP; }\n        }\n        if (lvl+1 < tree->pathlength) { target->path[lvl+1] = d2; }\n\n        /* check <= each 1st level bins */\n        for (i=0; i < lengthM1; i++) {\n            if (d1 - radius <= node->internal.M1[i]) {\n                /* check <= each 2nd level bins */\n                for (j=0; j < lengthM1; j++) {\n                    if (d2 - radius <= node->internal.M2[i*lengthM1+j]) {\n\n                        err = _mvptree_retrieve(tree,node->internal.child_nodes[i*bf+j],target,\n                                                                        radius, results, nbresults, lvl+2);\n\n                        if (err != MVP_SUCCESS) { return err; }\n                    }\n                }\n                /* check >= last 2nd level bin  */\n                if (d2 + radius >= node->internal.M2[i*lengthM1+lengthM1-1]) {\n\n                    err = _mvptree_retrieve(tree,node->internal.child_nodes[i*bf+lengthM1],\n                                                target, radius, results, nbresults, lvl+2);\n                    if (err != MVP_SUCCESS) { return err; }\n                }\n            }\n        }\n\n        /* check >= last 1st level bin */\n        if (d1 + radius >= node->internal.M1[lengthM1-1]) {\n            /* check <= each 2nd level bins */\n            for (j=0; j < lengthM1; j++) {\n                if (d2 - radius <= node->internal.M2[lengthM1*lengthM1+j]) {\n                    err = _mvptree_retrieve(tree,node->internal.child_nodes[bf*lengthM1+j],\n                                                    target, radius, results, nbresults, lvl+2);\n                    if (err != MVP_SUCCESS) { return err; }\n                }\n            }\n            /* check >= last 2nd level bin  */\n\n            if (d2 + radius >= node->internal.M2[lengthM1*lengthM1+lengthM1-1]) {\n\n                err = _mvptree_retrieve(tree,node->internal.child_nodes[bf*lengthM1+lengthM1],\n                                                 target, radius, results, nbresults, lvl+2);\n                if (err != MVP_SUCCESS) { return err; }\n            }\n        }\n    } else {\n        err = MVP_UNRECOGNIZED;\n    }\n\n    return err;\n}\n\nMVPDP** mvptree_retrieve(MVPTree *tree, MVPDP *target, unsigned int knearest, float radius,\n                                                 unsigned int *nbresults,MVPError *error) {\n    if (!tree || !target || !nbresults || knearest == 0 || radius < 0) {\n        *error = MVP_ARGERR;\n        return NULL;\n    }\n\n    if (!tree->dist) {\n        *error = MVP_NODISTANCEFUNC;\n        return NULL;\n    }\n\n    *nbresults = 0;\n    *error = MVP_SUCCESS;\n\n    if (!tree->node) {\n        *error = MVP_EMPTYTREE;\n        return NULL;\n    }\n\n    MVPDP **results = (MVPDP**) malloc(knearest*sizeof(MVPDP*));\n    if (!results) {\n        *error = MVP_MEMALLOC;\n        return NULL;\n    }\n\n    target->path = (float*) malloc(tree->pathlength*sizeof(float));\n    if (target->path == NULL) {\n        *error = MVP_MEMALLOC;\n        free(results);\n        return NULL;\n    }\n    tree->k = knearest;\n\n    *error = _mvptree_retrieve(tree, tree->node, target, radius, results, nbresults, 0);\n\n    free(target->path);\n    target->path = NULL;\n\n    return results;\n}\n\nstatic off_t write_datapoint(MVPDP *dp, MVPTree *tree) {\n    off_t start = tree->pos;\n    off_t pos = tree->pos;\n    uint8_t active = 0;\n    uint32_t bytelength = 0;\n    char *buf = tree->buf;\n\n    if (dp == NULL) {\n        memcpy(&buf[pos++], &active, 1);\n        memcpy(&buf[pos], &bytelength, sizeof(uint32_t));\n        pos += sizeof(uint32_t);\n        tree->pos = pos;\n        return start;\n    }\n    active = 1;\n    uint8_t idlen = strlen(dp->id);\n    uint32_t datalength = dp->datalen;\n    uint8_t type = dp->type;\n    bytelength = sizeof(uint8_t) + idlen + sizeof(uint32_t) +\n                            datalength*type + (tree->pathlength)*sizeof(float);\n\n    memcpy(&buf[pos++], &active    , 1);\n    memcpy(&buf[pos]  , &bytelength, sizeof(uint32_t));\n    pos += sizeof(uint32_t);\n    memcpy(&buf[pos++], &idlen     , 1);\n    memcpy(&buf[pos]  , dp->id     , idlen);\n    pos += idlen;\n    memcpy(&buf[pos]  , &datalength, sizeof(uint32_t));\n    pos += sizeof(uint32_t);\n    memcpy(&buf[pos]  , dp->data   , datalength*type);\n    pos += datalength*type;\n    memcpy(&buf[pos]  , dp->path   , (tree->pathlength)*sizeof(float));\n    pos += (tree->pathlength)*sizeof(float);\n\n    tree->pos = pos;\n    return start;\n}\n\nstatic int extend_mvpfile(MVPTree *tree) {\n    if (munmap(tree->buf, tree->size) < 0) {\n        return -1;\n    }\n    if (ftruncate(tree->fd, tree->size + tree->pgsize) < 0) {\n        return -2;\n    }\n\n    tree->size += tree->pgsize;\n    char *buf = (char*) mmap(NULL, tree->size, PROT_READ|PROT_WRITE, MAP_SHARED, tree->fd, 0);\n    if (buf == NULL) {\n        return -3;\n    }\n    tree->buf = buf;\n\n    return 0;\n}\n\nstatic off_t _mvptree_write(MVPTree *tree,Node *node,MVPError *error,int lvl) {\n    off_t start_pos = tree->pos;\n    if (node == NULL) { return 0; }\n\n    uint8_t node_type = (uint8_t) node->leaf.type;\n    if (node->leaf.type == LEAF_NODE) {\n        uint32_t nbpoints = node->leaf.nbpoints;\n        if (tree->pos >= tree->size - tree->pgsize/2) {\n            if (extend_mvpfile(tree) < 0) {\n                *error = MVP_FILETRUNCATE;\n                return start_pos;\n            }\n        }\n\n        /* save node */\n        memcpy(&tree->buf[tree->pos++], &node_type, 1);\n        write_datapoint(node->leaf.sv1, tree);\n        write_datapoint(node->leaf.sv2, tree);\n        memcpy(&tree->buf[tree->pos], &nbpoints, sizeof(uint32_t));\n        tree->pos += sizeof(uint32_t);\n\n        /* write points */\n        int i;\n        off_t saved_pos = tree->pos;\n        tree->pos += (tree->leafcap)*(2*sizeof(float)+sizeof(off_t));\n        for (i=0; i < nbpoints; i++) {\n            if (tree->pos >= tree->size - tree->pgsize/2) {\n                if (extend_mvpfile(tree) < 0) {\n                    *error = MVP_FILETRUNCATE;\n                    break;\n                }\n            }\n\n            memcpy(&tree->buf[saved_pos], &(node->leaf.d1[i]), sizeof(float));\n            saved_pos += sizeof(float);\n            memcpy(&tree->buf[saved_pos], &(node->leaf.d2[i]), sizeof(float));\n            saved_pos += sizeof(float);\n\n            off_t offset = write_datapoint(node->leaf.points[i], tree);\n            memcpy(&tree->buf[saved_pos], &offset, sizeof(off_t));\n            saved_pos += sizeof(off_t);\n        }\n    } else if (node->internal.type == INTERNAL_NODE) {\n        const uint8_t fileno = 0;\n        int bf = tree->branchfactor;\n        int lengthM1 = bf - 1;\n        int lengthM2 = (bf - 1)*bf;\n        int fanout   = bf*bf;\n\n        memcpy(&tree->buf[tree->pos++], &node_type, 1);\n        write_datapoint(node->internal.sv1, tree);\n        write_datapoint(node->internal.sv2, tree);\n        memcpy(&tree->buf[tree->pos], node->internal.M1, lengthM1*sizeof(float));\n        tree->pos += lengthM1*sizeof(float);\n        memcpy(&tree->buf[tree->pos], node->internal.M2, lengthM2*sizeof(float));\n        tree->pos += lengthM2*sizeof(float);\n\n        off_t saved_pos = tree->pos;\n        tree->pos += fanout*(sizeof(uint8_t) + sizeof(off_t));\n        int i;\n        for (i=0; i < fanout; i++) {\n            if (tree->pos >= tree->size - tree->pgsize/2) {\n                if (extend_mvpfile(tree) < 0) {\n                    *error = MVP_FILETRUNCATE;\n                    break;\n                }\n            }\n            off_t offset = _mvptree_write(tree, node->internal.child_nodes[i], error, lvl+2);\n            memcpy(&tree->buf[saved_pos++], &fileno, 1);\n            memcpy(&tree->buf[saved_pos]  , &offset, sizeof(off_t));\n            saved_pos += sizeof(off_t);\n        }\n    } else {\n        *error = MVP_UNRECOGNIZED;\n    }\n\n    /*    msync(tree->buf, tree->size, MS_ASYNC);   */\n\n    return start_pos;\n}\n\nMVPError mvptree_write(MVPTree *tree, const char *filename, int mode) {\n    if (!tree || !tree->dist || !tree->node || !filename) {\n        return MVP_ARGERR;\n    }\n\n    tree->fd = open(filename, O_CREAT|O_RDWR|O_TRUNC, mode);\n    if (tree->fd < 0) {\n        return MVP_FILEOPEN;\n    }\n    tree->pgsize = sysconf(_SC_PAGESIZE);\n    if (ftruncate(tree->fd, tree->pgsize) < 0) {\n        close(tree->fd);\n        return MVP_FILETRUNCATE;\n    }\n    tree->size = tree->pgsize;\n    char *buf  = (char*) mmap(NULL, tree->size, PROT_READ|PROT_WRITE, MAP_SHARED, tree->fd, 0);\n    if (buf == NULL) {\n        close(tree->fd);\n        return MVP_MEMMAP;\n    }\n    off_t pos = 0;\n\n    uint8_t bf = tree->branchfactor;\n    uint8_t pl = tree->pathlength;\n    uint8_t lc = tree->leafcap;\n    uint8_t ht = (uint8_t) tree->node->internal.sv1->type;\n\n    /* write header */\n    memcpy(&buf[pos], tag, strlen(tag)+1);\n    pos += strlen(tag)+1;\n    memcpy(&buf[pos], &version, sizeof(version));\n    pos += sizeof(version);\n    memcpy(&buf[pos++], &bf, 1);\n    memcpy(&buf[pos++], &pl, 1);\n    memcpy(&buf[pos++], &lc, 1);\n    memcpy(&buf[pos++], &ht, 1);\n\n    tree->buf = buf;\n    pos = HEADER_SIZE;\n    tree->pos = pos;\n\n    /* write nodes */\n    MVPError error = MVP_SUCCESS;\n    _mvptree_write(tree, tree->node, &error, 0);\n\n    /* cleanup */\n    if (msync(tree->buf, tree->size, MS_SYNC) < 0) {\n        error = MVP_MEMMAP;\n    }\n\n    if (munmap(tree->buf, tree->size) < 0) {\n        error = MVP_MUNMAP;\n    }\n    tree->buf = NULL;\n\n    if (close(tree->fd) < 0) {\n        error = MVP_FILECLOSE;\n    }\n\n    return error;\n}\n\nstatic MVPDP* read_datapoint(MVPTree *tree) {\n    uint8_t active, idlen;\n    uint32_t bytelength, datalength;\n\n    memcpy(&active, &tree->buf[tree->pos], sizeof(active));\n    tree->pos += sizeof(active);\n    memcpy(&bytelength, &tree->buf[tree->pos], sizeof(bytelength));\n    tree->pos += sizeof(bytelength);\n\n    if (active == 0 && bytelength == 0) return NULL;\n\n    MVPDP *dp = dp_alloc(tree->datatype);\n    if (!dp) { return NULL; }\n\n    dp->path = (float*) malloc(tree->pathlength*sizeof(float));\n    if (!dp->path) { return NULL; }\n\n    memcpy(&idlen, &tree->buf[tree->pos], sizeof(uint8_t));\n    tree->pos += sizeof(uint8_t);\n    dp->id = malloc(idlen+1);\n    memcpy(dp->id, &tree->buf[tree->pos], idlen);\n    tree->pos += idlen;\n    dp->id[idlen] = '\\0';\n    memcpy(&datalength, &tree->buf[tree->pos], sizeof(uint32_t));\n    tree->pos += sizeof(uint32_t);\n\n    dp->datalen = datalength;\n    dp->data = malloc(datalength*tree->datatype);\n    memcpy(dp->data, &tree->buf[tree->pos], datalength*tree->datatype);\n    tree->pos += datalength*tree->datatype;\n    memcpy(dp->path, &tree->buf[tree->pos], tree->pathlength*sizeof(float));\n    tree->pos += tree->pathlength*sizeof(float);\n\n    return dp;\n}\n\nstatic Node* _mvptree_read_node(MVPTree *tree, MVPError *error, int lvl) {\n    uint8_t node_type;\n    Node *node = NULL;\n    memcpy(&node_type, &tree->buf[tree->pos++], sizeof(uint8_t));\n\n    if (node_type == LEAF_NODE) {\n        uint32_t nbpoints;\n        node = create_leaf(tree->leafcap);\n        if (!node) {\n            *error = MVP_NOLEAF;\n            return node;\n        }\n        node->leaf.sv1 = read_datapoint(tree);\n        node->leaf.sv2 = read_datapoint(tree);\n\n        memcpy(&nbpoints,&tree->buf[tree->pos], sizeof(uint32_t));\n        tree->pos += sizeof(uint32_t);\n        node->leaf.nbpoints = nbpoints;\n\n        off_t saved_pos = tree->pos;\n        int i;\n        off_t offset;\n        for (i = 0; i < nbpoints; i++) {\n            memcpy(&(node->leaf.d1[i]), &tree->buf[saved_pos], sizeof(float));\n            saved_pos += sizeof(float);\n            memcpy(&(node->leaf.d2[i]), &tree->buf[saved_pos], sizeof(float));\n            saved_pos += sizeof(float);\n            memcpy(&offset, &tree->buf[saved_pos], sizeof(off_t));\n            saved_pos += sizeof(off_t);\n\n            tree->pos = offset;\n            node->leaf.points[i] = read_datapoint(tree);\n        }\n    } else if (node_type == INTERNAL_NODE) {\n        int bf = tree->branchfactor;\n        int lengthM1 = bf - 1;\n        int lengthM2 = (bf - 1)*bf;\n        int fanout   = bf*bf;\n        uint8_t fileno;\n\n        node = create_internal(bf);\n        if (node == NULL) {\n            *error = MVP_NOINTERNAL;\n            return node;\n        }\n        node->internal.sv1 = read_datapoint(tree);\n        node->internal.sv2 = read_datapoint(tree);\n\n        memcpy(node->internal.M1, &tree->buf[tree->pos], lengthM1*sizeof(float));\n        tree->pos += lengthM1*sizeof(float);\n        memcpy(node->internal.M2, &tree->buf[tree->pos], lengthM2*sizeof(float));\n        tree->pos += lengthM2*sizeof(float);\n\n        int i;\n        off_t offset, saved_pos = tree->pos;\n        for (i = 0;i < fanout; i++) {\n            memcpy(&fileno, &tree->buf[saved_pos], sizeof(fileno));\n            saved_pos += sizeof(fileno);\n            memcpy(&offset, &tree->buf[saved_pos], sizeof(offset));\n            saved_pos += sizeof(offset);\n\n            tree->pos = offset;\n            node->internal.child_nodes[i] = _mvptree_read_node(tree, error, lvl+2);\n            if (*error != MVP_SUCCESS) { break; }\n        }\n    } else {\n        *error = MVP_UNRECOGNIZED;\n    }\n    return node;\n}\n\nMVPTree* mvptree_read(const char *filename, CmpFunc fnc, int branchfactor, int pathlength,\n                               int leafcapacity,MVPError *error) {\n    if (!error) { return NULL; }\n    *error = MVP_SUCCESS;\n    if (!filename || !fnc) {\n        *error = MVP_ARGERR;\n        return NULL;\n    }\n    MVPTree *tree = NULL;\n\n    int fd = open(filename, O_RDONLY);\n    if (fd < 0) {\n        /* file not found return empty tree */\n        tree = mvptree_alloc(NULL, fnc, branchfactor, pathlength, leafcapacity);\n        *error = MVP_FILENOTFOUND;\n        return tree;\n    }\n\n    struct stat file_info;\n    if (fstat(fd, &file_info) < 0) {\n        *error = MVP_FILEOPEN;\n        return NULL;\n    }\n    off_t size = file_info.st_size;\n\n    char *buf = (char*) mmap(NULL, size, PROT_READ, MAP_SHARED, fd, 0);\n    if (buf == NULL) {\n        *error = MVP_MEMMAP;\n        close(fd);\n        return NULL;\n    }\n    off_t pos = 0;\n    char line[16];\n    int v;\n    uint8_t bf, pl, lc, ht;\n\n    memcpy(line, &buf[pos], strlen(tag)+1);\n    pos += strlen(tag)+1;\n    memcpy(&v, &buf[pos], sizeof(int));\n    pos += sizeof(int);\n    memcpy(&bf, &buf[pos++], 1);\n    memcpy(&pl, &buf[pos++], 1);\n    memcpy(&lc, &buf[pos++], 1);\n    memcpy(&ht, &buf[pos++], 1);\n\n    tree = mvptree_alloc(NULL, fnc, bf, pl, lc);\n    if (!tree) {\n        *error = MVP_MEMALLOC;\n        return NULL;\n    }\n    tree->pgsize = sysconf(_SC_PAGESIZE);\n    tree->size = size;\n    tree->buf = buf;\n    tree->pos = HEADER_SIZE;\n    tree->fd = fd;\n    tree->datatype = (MVPDataType) ht;\n    tree->dist = fnc;\n    tree->node = _mvptree_read_node(tree, error, 0);\n\n    if (munmap(buf, size) < 0) {\n        *error = MVP_MUNMAP;\n    }\n    tree->buf = NULL;\n\n    if (close(fd) < 0) {\n        *error = MVP_FILECLOSE;\n    }\n    tree->buf = NULL;\n    tree->pos = 0;\n    tree->fd  = 0;\n\n    return tree;\n}\n\nstatic MVPError _mvptree_print(FILE *stream, MVPTree *tree, Node *node, int lvl) {\n    MVPError error = MVP_SUCCESS;\n    Node *next_node = node;\n    int bf = tree->branchfactor, lengthM1 = bf-1, lengthM2 = bf, fanout = bf*bf;\n\n    if (next_node) {\n        if (next_node->leaf.type == LEAF_NODE) {\n            fprintf(stream, \"LEAF%d  (%d points)\\n\", lvl, next_node->leaf.nbpoints);\n            if (next_node->leaf.sv1) {\n                fprintf(stream, \"    sv1: %s\\n\", next_node->leaf.sv1->id);\n            }\n            if (next_node->leaf.sv2) {\n                fprintf(stream, \"    sv2: %s\\n\", next_node->leaf.sv2->id);\n            }\n\n            int i;\n            for (i = 0; i < next_node->leaf.nbpoints; i++) {\n                fprintf(stream, \"        point[%d]: %s\\n\", i, next_node->leaf.points[i]->id);\n            }\n        } else if (next_node->internal.type == INTERNAL_NODE) {\n            fprintf(stream, \"INTERNAL%d\\n\", lvl);\n            fprintf(stream, \"  sv1: %s\\n\", next_node->internal.sv1->id);\n            fprintf(stream, \"  sv2: %s\\n\", next_node->internal.sv2->id);\n\n            int i;\n            for (i=0; i < lengthM1; i++) {\n                fprintf(stream, \"  M1[%d] = %.4f;\", i, next_node->internal.M1[i]);\n            }\n            for (i=0; i < lengthM2; i++) {\n                fprintf(stream, \"  M2[%d] = %.4f;\", i, next_node->internal.M2[i]);\n            }\n            fprintf(stream, \"\\n\");\n\n            for (i=0; i < fanout; i++) {\n                error = _mvptree_print(stream, tree, node->internal.child_nodes[i], lvl+2);\n                if (error != MVP_SUCCESS) { break; }\n            }\n        } else {\n            error = MVP_UNRECOGNIZED;\n        }\n    } else {\n        fprintf(stream, \"NULL%d\\n\", lvl);\n    }\n\n    return error;\n}\n\nMVPError mvptree_print(FILE *stream, MVPTree *tree) {\n    if (stream == NULL || tree == NULL) {\n        return MVP_ARGERR;\n    }\n\n    MVPError err = _mvptree_print(stream, tree, tree->node, 0);\n    if (err != MVP_SUCCESS) {\n        fprintf(stream, \"malformed tree: %s\\n\", mvp_errstr(err));\n    }\n\n    return err;\n}\n","numLines":1264,"startLine":1,"totalLines":1264}}}
