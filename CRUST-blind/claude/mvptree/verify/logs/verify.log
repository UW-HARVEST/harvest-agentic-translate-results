1548\t\n1549\t            for i in 0..fanout {\n1550\t                if let Some(child_rc) = internal.child_nodes.get(i) {\n1551\t                    let child_borrow = child_rc.borrow();\n1552\t                    let err = print_recursive(stream, tree, Some(&*child_borrow), lvl + 2);\n1553\t                    if err != MVPError::Success {\n1554\t                        return err;\n1555\t                    }\n1556\t                }\n1557\t            }\n1558\t            MVPError::Success\n1559\t        }\n1560\t        None => {\n1561\t            let _ = writeln!(stream, \"NULL{}\", lvl);\n1562\t            MVPError::Success\n1563\t        }\n1564\t    }\n1565\t}\n1566\t\n1567\t// ----------------- Public API -----------------\n1568\t\n1569\timpl MVPTree {\n1570\t    pub fn new(\n1571\t        branch_factor: usize,\n1572\t        path_length: usize,\n1573\t        leaf_capacity: usize,\n1574\t        datatype: MVPDataType,\n1575\t        distance_function: DistanceFunction,\n1576\t    ) -> Self {\n1577\t        MVPTree {\n1578\t            branch_factor,\n1579\t            path_length,\n1580\t            leaf_capacity,\n1581\t            datatype,\n1582\t            pos: 0,\n1583\t            size: 0,\n1584\t            pgsize: 4096,\n1585\t            buf: Vec::new(),\n1586\t            node: None,\n1587\t            distance_function,\n1588\t        }\n1589\t    }\n1590\t\n1591\t    pub fn add(&mut self, points: Vec<MVPDatapoint>) -> MVPError {\n1592\t        if points.is_empty() {\n1593\t            return MVPError::Success;\n1594\t        }\n1595\t        // Type-check\n1596\t        let first_type = points[0].data_type;\n1597\t        if self.datatype as u8 != first_type as u8 {\n1598\t            // datatype hasn't been set yet (0 in C). In our enum, default may match.\n1599\t            // We treat the very first add as \"set the datatype\".\n1600\t            // If branch_factor is 0 / tree.datatype must match. Let's just set if conflicting\n1601\t  