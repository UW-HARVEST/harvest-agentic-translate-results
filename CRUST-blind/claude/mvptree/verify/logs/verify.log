{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BqMe6MzJr7jGf9eEvbzTNN","type":"tool_result","content":"1\tuse std::fs::{File, OpenOptions};\n2\tuse std::io::{self, Read as IoRead, Write};\n3\tuse std::sync::Arc;\n4\tuse std::rc::Rc;\n5\tuse std::cell::RefCell;\n6\t\n7\tpub const TAG: &str = \"phashmvp2010\";\n8\tpub const VERSION: u32 = 0x01000000;\n9\tpub const HEADER_SIZE: usize = 32;\n10\tpub const FILE_OFFSET_BITS: usize = 64;\n11\tpub const ERROR_MSGS: [&str; 25] = [\n12\t    \"no error\",\n13\t    \"bad argument\",\n14\t    \"no distance function found\",\n15\t    \"mem alloc error\",\n16\t    \"no leaf node created\",\n17\t    \"no internal node created\",\n18\t    \"no path array alloc'd\",\n19\t    \"could not select vantage points\",\n20\t    \"could not calculate range from an sv1\",\n21\t    \"could not calculate range from an sv2\",\n22\t    \"points too compact\",\n23\t    \"could not sort points\",\n24\t    \"could not open file\",\n25\t    \"could not close file\",\n26\t    \"mmap error\",\n27\t    \"unmap error\",\n28\t    \"no write\",\n29\t    \"could not extend file\",\n30\t    \"could not remap file\",\n31\t    \"datatypes in conflict\",\n32\t    \"no. retrieved exceeds k\",\n33\t    \"empty tree\",\n34\t    \"distance value either NaN or less than zero\",\n35\t    \"could not open file\",\n36\t    \"unrecognized node\",\n37\t];\n38\t\n39\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n40\tpub enum MVPDataType {\n41\t    ByteArray = 1,\n42\t    UInt16Array = 2,\n43\t    UInt32Array = 4,\n44\t    UInt64Array = 8,\n45\t}\n46\t\n47\timpl MVPDataType {\n48\t    pub fn from_u8(v: u8) -> Option<Self> {\n49\t        match v {\n50\t            1 => Some(MVPDataType::ByteArray),\n51\t            2 => Some(MVPDataType::UInt16Array),\n52\t            4 => Some(MVPDataType::UInt32Array),\n53\t            8 => Some(MVPDataType::UInt64Array),\n54\t            _ => None,\n55\t        }\n56\t    }\n57\t\n58\t    pub fn byte_width(&self) -> usize {\n59\t        *self as usize\n60\t    }\n61\t}\n62\t\n63\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n64\tpub enum NodeType {\n65\t    InternalNode = 1,\n66\t    LeafNode,\n67\t}\n68\t\n69\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n70\tpub enum MVPError {\n71\t    Success,\n72\t    ArgErr,\n73\t    NoDistanceFunc,\n74\t    MemAlloc,\n75\t    NoLeaf,\n76\t    NoInternal,\n77\t    PathAlloc,\n78\t    VpNoSelect,\n79\t    NoSv1Range,\n80\t    NoSv2Range,\n81\t    NoSpace,\n82\t    NoSort,\n83\t    FileOpen,\n84\t    FileClose,\n85\t    MemMap,\n86\t    Munmap,\n87\t    NoWrite,\n88\t    FileTruncate,\n89\t    MremapFail,\n90\t    TypeMismatch,\n91\t    KNearestCap,\n92\t    EmptyTree,\n93\t    NoSplits,\n94\t    BadDistVal,\n95\t    FileNotFound,\n96\t    Unrecognized,\n97\t}\n98\t\n99\timpl MVPError {\n100\t    fn index(&self) -> usize {\n101\t        match self {\n102\t            MVPError::Success => 0,\n103\t            MVPError::ArgErr => 1,\n104\t            MVPError::NoDistanceFunc => 2,\n105\t            MVPError::MemAlloc => 3,\n106\t            MVPError::NoLeaf => 4,\n107\t            MVPError::NoInternal => 5,\n108\t            MVPError::PathAlloc => 6,\n109\t            MVPError::VpNoSelect => 7,\n110\t            MVPError::NoSv1Range => 8,\n111\t            MVPError::NoSv2Range => 9,\n112\t            MVPError::NoSpace => 10,\n113\t            MVPError::NoSort => 11,\n114\t            MVPError::FileOpen => 12,\n115\t            MVPError::FileClose => 13,\n116\t            MVPError::MemMap => 14,\n117\t            MVPError::Munmap => 15,\n118\t            MVPError::NoWrite => 16,\n119\t            MVPError::FileTruncate => 17,\n120\t            MVPError::MremapFail => 18,\n121\t            MVPError::TypeMismatch => 19,\n122\t            MVPError::KNearestCap => 20,\n123\t            MVPError::EmptyTree => 21,\n124\t            MVPError::NoSplits => 22,\n125\t            MVPError::BadDistVal => 23,\n126\t            MVPError::FileNotFound => 24,\n127\t            MVPError::Unrecognized => 24,\n128\t        }\n129\t    }\n130\t}\n131\t\n132\t#[derive(Debug, Clone)]\n133\tpub struct MVPDatapoint {\n134\t    pub id: String,\n135\t    pub data: Vec<u8>,\n136\t    pub path: Vec<f32>,\n137\t    pub datalen: usize,\n138\t    pub data_type: MVPDataType,\n139\t}\n140\t\n141\tpub type DistanceFunction = fn(&MVPDatapoint, &MVPDatapoint) -> f32;\n142\t\n143\tpub struct InternalNode {\n144\t    pub node_type: NodeType,\n145\t    pub sv1: Option<Arc<MVPDatapoint>>,\n146\t    pub sv2: Option<Arc<MVPDatapoint>>,\n147\t    pub m1: Vec<f32>,\n148\t    pub m2: Vec<f32>,\n149\t    pub child_nodes: Vec<Rc<RefCell<Node>>>,\n150\t}\n151\t\n152\timpl InternalNode {\n153\t    pub fn new(bf: u32) -> Self {\n154\t        let bf = bf as usize;\n155\t        let length_m1 = if bf > 0 { bf - 1 } else { 0 };\n156\t        let length_m2 = if bf > 0 { bf * length_m1 } else { 0 };\n157\t        InternalNode {\n158\t            node_type: NodeType::InternalNode,\n159\t            sv1: None,\n160\t            sv2: None,\n161\t            m1: vec![0.0f32; length_m1],\n162\t            m2: vec![0.0f32; length_m2],\n163\t            child_nodes: Vec::with_capacity(bf * bf),\n164\t        }\n165\t    }\n166\t}\n167\t\n168\tpub struct LeafNode {\n169\t    pub node_type: NodeType,\n170\t    pub sv1: Option<Arc<MVPDatapoint>>,\n171\t    pub sv2: Option<Arc<MVPDatapoint>>,\n172\t    pub points: Vec<Arc<MVPDatapoint>>,\n173\t    pub d1: Vec<f32>,\n174\t    pub d2: Vec<f32>,\n175\t    pub nbpoints: usize,\n176\t}\n177\t\n178\timpl LeafNode {\n179\t    pub fn new(bf: u32) -> Self {\n180\t        // bf here is leaf capacity\n181\t        let cap = bf as usize;\n182\t        LeafNode {\n183\t            node_type: NodeType::LeafNode,\n184\t            sv1: None,\n185\t            sv2: None,\n186\t            points: Vec::with_capacity(cap),\n187\t            d1: vec![0.0f32; cap],\n188\t            d2: vec![0.0f32; cap],\n189\t            nbpoints: 0,\n190\t        }\n191\t    }\n192\t}\n193\t\n194\tpub enum Node {\n195\t    Leaf(LeafNode),\n196\t    Internal(InternalNode),\n197\t}\n198\t\n199\tpub struct MVPTree {\n200\t    pub branch_factor: usize,\n201\t    pub path_length: usize,\n202\t    pub leaf_capacity: usize,\n203\t    pub datatype: MVPDataType,\n204\t    pub pos: i64,\n205\t    pub size: i64,\n206\t    pub pgsize: i64,\n207\t    pub buf: Vec<u8>,\n208\t    pub node: Option<Rc<RefCell<Node>>>,\n209\t    pub distance_function: DistanceFunction,\n210\t}\n211\t\n212\t// ----------------- helper functions -----------------\n213\t\n214\tfn is_bad_dist(d: f32) -> bool {\n215\t    d.is_nan() || d < 0.0\n216\t}\n217\t\n218\t/// Select two vantage points (indices) at maximum mutual distance.\n219\t/// Returns (sv1_pos, sv2_pos) or error code.\n220\tfn select_vps(points: &[MVPDatapoint], dist: DistanceFunction) -> Result<(i32, i32), i32> {\n221\t    let nb = points.len();\n222\t    if nb == 0 {\n223\t        return Err(-1);\n224\t    }\n225\t    let mut sv1_pos: i32 = 0;\n226\t    let mut sv2_pos: i32 = -1;\n227\t    let mut max_dist: f32 = 0.0;\n228\t    for i in 0..nb {\n229\t        for j in (i + 1)..nb {\n230\t            let d = dist(&points[i], &points[j]);\n231\t            if is_bad_dist(d) {\n232\t                return Err(-2);\n233\t            }\n234\t            if d > max_dist {\n235\t                max_dist = d;\n236\t                sv1_pos = i as i32;\n237\t                sv2_pos = j as i32;\n238\t            }\n239\t        }\n240\t    }\n241\t    Ok((sv1_pos, sv2_pos))\n242\t}\n243\t\n244\t/// Compute split points for `points` against vantage point `vp` and store\n245\t/// in `m_out` (length = length_m).\n246\tfn compute_splits(\n247\t    points: &[&MVPDatapoint],\n248\t    vp: &MVPDatapoint,\n249\t    dist: DistanceFunction,\n250\t    length_m: usize,\n251\t    m_out: &mut [f32],\n252\t) -> Result<(), i32> {\n253\t    let nb = points.len();\n254\t    if nb == 0 || length_m == 0 {\n255\t        return Err(-1);\n256\t    }\n257\t    let mut dists: Vec<f32> = Vec::with_capacity(nb);\n258\t    for p in points {\n259\t        let d = dist(p, vp);\n260\t        if is_bad_dist(d) {\n261\t            return Err(-2);\n262\t        }\n263\t        dists.push(d);\n264\t    }\n265\t    // sort ascending using selection sort (matches C, but stable doesn't matter for f32)\n266\t    dists.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));\n267\t\n268\t    for i in 0..length_m {\n269\t        let mut idx = (i + 1) * nb / (length_m + 1);\n270\t        if idx >= nb {\n271\t            idx = nb - 1;\n272\t        }\n273\t        m_out[i] = dists[idx];\n274\t    }\n275\t    Ok(())\n276\t}\n277\t\n278\t/// Sort `points` (excluding sv1_pos, sv2_pos if non-negative) into bins\n279\t/// based on distance to `vp` and pivot points.\n280\tfn sort_into_bins(\n281\t    points: Vec<MVPDatapoint>,\n282\t    sv1_pos: i32,\n283\t    sv2_pos: i32,\n284\t    vp: &MVPDatapoint,\n285\t    dist: DistanceFunction,\n286\t    branch_factor: usize,\n287\t    pivots: &[f32],\n288\t) -> Result<Vec<Vec<MVPDatapoint>>, MVPError> {\n289\t    let length_m1 = branch_factor.saturating_sub(1);\n290\t    let mut bins: Vec<Vec<MVPDatapoint>> = (0..branch_factor).map(|_| Vec::new()).collect();\n291\t\n292\t    for (i, p) in points.into_iter().enumerate() {\n293\t        if i as i32 == sv1_pos || i as i32 == sv2_pos {\n294\t            continue;\n295\t        }\n296\t        let d = dist(vp, &p);\n297\t        if is_bad_dist(d) {\n298\t            return Err(MVPError::NoSort);\n299\t        }\n300\t        let mut placed_idx: Option<usize> = None;\n301\t        for k in 0..length_m1 {\n302\t            if d <= pivots[k] {\n303\t                placed_idx = Some(k);\n304\t                break;\n305\t            }\n306\t        }\n307\t        match placed_idx {\n308\t            Some(k) => bins[k].push(p),\n309\t            None => {\n310\t                if length_m1 == 0 || d > pivots[length_m1 - 1] {\n311\t                    bins[length_m1].push(p);\n312\t                }\n313\t            }\n314\t        }\n315\t    }\n316\t\n317\t    Ok(bins)\n318\t}\n319\t\n320\t/// For each point, compute distance to vp and update its path slot at `lvl`\n321\t/// (if lvl < path_length).\n322\tfn update_path_with_vp(\n323\t    points: &mut [MVPDatapoint],\n324\t    vp: &MVPDatapoint,\n325\t    dist: DistanceFunction,\n326\t    path_length: usize,\n327\t    lvl: usize,\n328\t) -> Result<(), MVPError> {\n329\t    for p in points.iter_mut() {\n330\t        let d = dist(vp, p);\n331\t        if is_bad_dist(d) {\n332\t            return Err(MVPError::BadDistVal);\n333\t        }\n334\t        if lvl < path_length {\n335\t            if p.path.len() < path_length {\n336\t                p.path.resize(path_length, 0.0);\n337\t            }\n338\t            p.path[lvl] = d;\n339\t        }\n340\t    }\n341\t    Ok(())\n342\t}\n343\t\n344\t/// Recursive tree construction. Consumes points, returns either a Node or error.\n345\tfn build_node(\n346\t    tree_branch_factor: usize,\n347\t    tree_path_length: usize,\n348\t    tree_leaf_capacity: usize,\n349\t    distance_function: DistanceFunction,\n350\t    mut points: Vec<MVPDatapoint>,\n351\t    lvl: usize,\n352\t) -> Result<Option<Node>, MVPError> {\n353\t    if points.is_empty() {\n354\t        return Ok(None);\n355\t    }\n356\t    let nbpoints = points.len();\n357\t    let bf = tree_branch_factor;\n358\t    let length_m1 = bf.saturating_sub(1);\n359\t\n360\t    // Make sure all points have a path of size path_length\n361\t    for p in points.iter_mut() {\n362\t        if p.path.len() < tree_path_length {\n363\t            p.path.resize(tree_path_length, 0.0);\n364\t        }\n365\t    }\n366\t\n367\t    if nbpoints <= tree_leaf_capacity + 2 {\n368\t        // leaf node\n369\t        let (sv1_pos, sv2_pos) = select_vps(&points, distance_function)\n370\t            .map_err(|_| MVPError::VpNoSelect)?;\n371\t\n372\t        let mut leaf = LeafNode::new(tree_leaf_capacity as u32);\n373\t\n374\t        // Compute distances to sv1 and sv2 for path & d1/d2 updates.\n375\t        // Update path[lvl] = dist to sv1 for all points.\n376\t        if sv1_pos >= 0 {\n377\t            let sv1_clone = points[sv1_pos as usize].clone();\n378\t            update_path_with_vp(&mut points, &sv1_clone, distance_function, tree_path_length, lvl)\n379\t                .map_err(|_| MVPError::NoSv1Range)?;\n380\t        } else {\n381\t            return Ok(None);\n382\t        }\n383\t        if sv2_pos >= 0 {\n384\t            let sv2_clone = points[sv2_pos as usize].clone();\n385\t            update_path_with_vp(&mut points, &sv2_clone, distance_function, tree_path_length, lvl + 1)\n386\t                .map_err(|_| MVPError::NoSv2Range)?;\n387\t        }\n388\t\n389\t        // Now extract sv1, sv2 from points list and place remaining into leaf.\n390\t        // Indices may shift after removal; remove higher index first.\n391\t        let (sv1_dp, sv2_dp_opt, remaining): (MVPDatapoint, Option<MVPDatapoint>, Vec<MVPDatapoint>) = {\n392\t            let mut removed_sv1: Option<MVPDatapoint> = None;\n393\t            let mut removed_sv2: Option<MVPDatapoint> = None;\n394\t            let mut keep: Vec<(usize, MVPDatapoint)> = Vec::with_capacity(nbpoints);\n395\t            for (i, p) in points.into_iter().enumerate() {\n396\t                if i as i32 == sv1_pos {\n397\t                    removed_sv1 = Some(p);\n398\t                } else if i as i32 == sv2_pos {\n399\t                    removed_sv2 = Some(p);\n400\t                } else {\n401\t                    keep.push((i, p));\n402\t                }\n403\t            }\n404\t            let remaining: Vec<MVPDatapoint> = keep.into_iter().map(|(_, p)| p).collect();\n405\t            (removed_sv1.expect(\"sv1_pos selected but missing\"), removed_sv2, remaining)\n406\t        };\n407\t\n408\t        // Compute d1/d2 for remaining points using cloned copies as references.\n409\t        let sv1_ref = sv1_dp.clone();\n410\t        let sv2_ref_opt = sv2_dp_opt.clone();\n411\t\n412\t        let mut d1_vals: Vec<f32> = Vec::with_capacity(tree_leaf_capacity);\n413\t        let mut d2_vals: Vec<f32> = Vec::with_capacity(tree_leaf_capacity);\n414\t\n415\t        for p in &remaining {\n416\t            let d_a = distance_function(p, &sv1_ref);\n417\t            d1_vals.push(d_a);\n418\t            if let Some(ref s2) = sv2_ref_opt {\n419\t                let d_b = distance_function(p, s2);\n420\t                d2_vals.push(d_b);\n421\t            } else {\n422\t                d2_vals.push(0.0);\n423\t            }\n424\t        }\n425\t        // Pad to leaf_capacity\n426\t        while d1_vals.len() < tree_leaf_capacity {\n427\t            d1_vals.push(0.0);\n428\t        }\n429\t        while d2_vals.len() < tree_leaf_capacity {\n430\t            d2_vals.push(0.0);\n431\t        }\n432\t\n433\t        leaf.d1 = d1_vals;\n434\t        leaf.d2 = d2_vals;\n435\t        leaf.sv1 = Some(Arc::new(sv1_dp));\n436\t        leaf.sv2 = sv2_dp_opt.map(Arc::new);\n437\t        leaf.points = remaining.into_iter().map(Arc::new).collect();\n438\t        leaf.nbpoints = leaf.points.len();\n439\t        Ok(Some(Node::Leaf(leaf)))\n440\t    } else {\n441\t        // internal node\n442\t        let (sv1_pos, sv2_pos) = select_vps(&points, distance_function)\n443\t            .map_err(|_| MVPError::VpNoSelect)?;\n444\t        if sv1_pos < 0 || sv2_pos < 0 {\n445\t            return Err(MVPError::VpNoSelect);\n446\t        }\n447\t\n448\t        let mut internal = InternalNode::new(bf as u32);\n449\t\n450\t        // Update path with sv1\n451\t        let sv1_clone = points[sv1_pos as usize].clone();\n452\t        update_path_with_vp(&mut points, &sv1_clone, distance_function, tree_path_length, lvl)\n453\t            .map_err(|_| MVPError::NoSv1Range)?;\n454\t\n455\t        // Compute M1 splits\n456\t        if length_m1 > 0 {\n457\t            let pts_refs: Vec<&MVPDatapoint> = points\n458\t                .iter()\n459\t                .enumerate()\n460\t                .filter(|(i, _)| *i as i32 != sv1_pos && *i as i32 != sv2_pos)\n461\t                .map(|(_, p)| p)\n462\t                .collect();\n463\t            if pts_refs.is_empty() {\n464\t                return Err(MVPError::NoSplits);\n465\t            }\n466\t            let mut m1 = vec![0.0f32; length_m1];\n467\t            compute_splits(&pts_refs, &sv1_clone, distance_function, length_m1, &mut m1)\n468\t                .map_err(|_| MVPError::NoSplits)?;\n469\t            internal.m1 = m1;\n470\t        }\n471\t\n472\t        // Sort into bins by sv1 (excluding sv1_pos and sv2_pos)\n473\t        let sv2_clone = points[sv2_pos as usize].clone();\n474\t        let bins = sort_into_bins(\n475\t            points,\n476\t            sv1_pos,\n477\t            sv2_pos,\n478\t            &sv1_clone,\n479\t            distance_function,\n480\t            bf,\n481\t            &internal.m1,\n482\t        )?;\n483\t\n484\t        // For each bin: compute distance to sv2, M2 splits, sort into sub-bins, recurse\n485\t        let mut child_nodes: Vec<Option<Node>> = Vec::with_capacity(bf * bf);\n486\t\n487\t        for (bin_i, mut bin_points) in bins.into_iter().enumerate() {\n488\t            // Update path with sv2\n489\t            update_path_with_vp(\n490\t                &mut bin_points,\n491\t                &sv2_clone,\n492\t                distance_function,\n493\t                tree_path_length,\n494\t                lvl + 1,\n495\t            )\n496\t            .map_err(|_| MVPError::NoSv2Range)?;\n497\t\n498\t            // Compute M2 splits for this bin\n499\t            let m2_offset = bin_i * length_m1;\n500\t            if length_m1 > 0 {\n501\t                let pts_refs: Vec<&MVPDatapoint> = bin_points.iter().collect();\n502\t                if !pts_refs.is_empty() {\n503\t                    let mut m2_local = vec![0.0f32; length_m1];\n504\t                    if compute_splits(\n505\t                        &pts_refs,\n506\t                        &sv2_clone,\n507\t                        distance_function,\n508\t                        length_m1,\n509\t                        &mut m2_local,\n510\t                    )\n511\t                    .is_err()\n512\t                    {\n513\t                        // Use zeros - matches C path of returning NOSPLITS, but we'll be lenient\n514\t                        // Actually C returns error here. Let's return error.\n515\t                        return Err(MVPError::NoSplits);\n516\t                    }\n517\t                    for (k, v) in m2_local.iter().enumerate() {\n518\t                        if m2_offset + k < internal.m2.len() {\n519\t                            internal.m2[m2_offset + k] = *v;\n520\t                        }\n521\t                    }\n522\t                }\n523\t            }\n524\t\n525\t            // Sort into sub-bins\n526\t            let pivots_for_m2: Vec<f32> = if length_m1 > 0 {\n527\t                internal.m2[m2_offset..m2_offset + length_m1].to_vec()\n528\t            } else {\n529\t                Vec::new()\n530\t            };\n531\t            let sub_bins = sort_into_bins(\n532\t                bin_points,\n533\t                -1,\n534\t                -1,\n535\t                &sv2_clone,\n536\t                distance_function,\n537\t                bf,\n538\t                &pivots_for_m2,\n539\t            )?;\n540\t\n541\t            for sub_bin in sub_bins.into_iter() {\n542\t                let child = build_node(\n543\t                    tree_branch_factor,\n544\t                    tree_path_length,\n545\t                    tree_leaf_capacity,\n546\t                    distance_function,\n547\t                    sub_bin,\n548\t                    lvl + 2,\n549\t                )?;\n550\t                child_nodes.push(child);\n551\t            }\n552\t        }\n553\t\n554\t        internal.sv1 = Some(Arc::new(sv1_clone));\n555\t        internal.sv2 = Some(Arc::new(sv2_clone));\n556\t        internal.child_nodes = child_nodes\n557\t            .into_iter()\n558\t            .map(|opt| match opt {\n559\t                Some(n) => Rc::new(RefCell::new(n)),\n560\t                None => Rc::new(RefCell::new(Node::Leaf(LeafNode::new(tree_leaf_capacity as u32)))),\n561\t            })\n562\t            .collect();\n563\t        // Track which children are \"real\": we mark a freshly constructed empty leaf as a placeholder.\n564\t        // For correctness during retrieval we'll detect empty leaves (no sv1) and skip them.\n565\t        Ok(Some(Node::Internal(internal)))\n566\t    }\n567\t}\n568\t\n569\t/// Add points to an existing tree (`existing_node` is mutable in-place reference).\n570\t/// Returns updated node. May return None if existing node is None and no points.\n571\tfn add_to_existing_node(\n572\t    tree: &MVPTree,\n573\t    existing: Option<Rc<RefCell<Node>>>,\n574\t    mut points: Vec<MVPDatapoint>,\n575\t    lvl: usize,\n576\t) -> Result<Option<Rc<RefCell<Node>>>, MVPError> {\n577\t    if points.is_empty() {\n578\t        return Ok(existing);\n579\t    }\n580\t\n581\t    // Make sure all points have path allocated\n582\t    for p in points.iter_mut() {\n583\t        if p.path.len() < tree.path_length {\n584\t            p.path.resize(tree.path_length, 0.0);\n585\t        }\n586\t    }\n587\t\n588\t    let bf = tree.branch_factor;\n589\t    let length_m1 = bf.saturating_sub(1);\n590\t\n591\t    let existing = match existing {\n592\t        None => {\n593\t            // Create new node from scratch\n594\t            let node = build_node(\n595\t                tree.branch_factor,\n596\t                tree.path_length,\n597\t                tree.leaf_capacity,\n598\t                tree.distance_function,\n599\t                points,\n600\t                lvl,\n601\t            )?;\n602\t            return Ok(node.map(|n| Rc::new(RefCell::new(n))));\n603\t        }\n604\t        Some(e) => e,\n605\t    };\n606\t\n607\t    // Determine type of existing node\n608\t    let is_leaf = matches!(&*existing.borrow(), Node::Leaf(_));\n609\t    let is_internal = matches!(&*existing.borrow(), Node::Internal(_));\n610\t\n611\t    if is_leaf {\n612\t        // Read leaf info\n613\t        let (existing_nb, existing_sv1, existing_sv2, existing_points): (\n614\t            usize,\n615\t            Option<Arc<MVPDatapoint>>,\n616\t            Option<Arc<MVPDatapoint>>,\n617\t            Vec<Arc<MVPDatapoint>>,\n618\t        ) = {\n619\t            let leaf_ref = existing.borrow();\n620\t            if let Node::Leaf(leaf) = &*leaf_ref {\n621\t                (\n622\t                    leaf.nbpoints,\n623\t                    leaf.sv1.clone(),\n624\t                    leaf.sv2.clone(),\n625\t                    leaf.points.clone(),\n626\t                )\n627\t            } else {\n628\t                unreachable!()\n629\t            }\n630\t        };\n631\t\n632\t        if existing_nb + points.len() <= tree.leaf_capacity {\n633\t            // Plenty of room. Add to existing leaf.\n634\t            // Compute distances against existing sv1 and sv2 (or use first point as sv2)\n635\t            let sv1_dp = existing_sv1.as_ref().map(|a| (**a).clone());\n636\t            let sv2_dp = existing_sv2.as_ref().map(|a| (**a).clone());\n637\t\n638\t            let mut idx_start = 0;\n639\t            let sv2_chosen: Option<MVPDatapoint> = if sv2_dp.is_none() && !points.is_empty() {\n640\t                let s = points[0].clone();\n641\t                idx_start = 1;\n642\t                Some(s)\n643\t            } else {\n644\t                sv2_dp\n645\t            };\n646\t\n647\t            // Update path with sv1\n648\t            if let Some(ref s1) = sv1_dp {\n649\t                update_path_with_vp(\n650\t                    &mut points,\n651\t                    s1,\n652\t                    tree.distance_function,\n653\t                    tree.path_length,\n654\t                    lvl,\n655\t                )\n656\t                .map_err(|_| MVPError::NoSv1Range)?;\n657\t            }\n658\t            // Update path with sv2\n659\t            if let Some(ref s2) = sv2_chosen {\n660\t                update_path_with_vp(\n661\t                    &mut points,\n662\t                    s2,\n663\t                    tree.distance_function,\n664\t                    tree.path_length,\n665\t                    lvl + 1,\n666\t                )\n667\t                .map_err(|_| MVPError::NoSv2Range)?;\n668\t            }\n669\t\n670\t            // Compute d1/d2 distances for the new points to add\n671\t            let mut new_d1 = Vec::new();\n672\t            let mut new_d2 = Vec::new();\n673\t            let mut new_pts: Vec<Arc<MVPDatapoint>> = Vec::new();\n674\t            for (i, p) in points.into_iter().enumerate() {\n675\t                if i < idx_start {\n676\t                    continue;\n677\t                }\n678\t                let d_a = if let Some(ref s1) = sv1_dp {\n679\t                    (tree.distance_function)(&p, s1)\n680\t                } else {\n681\t                    0.0\n682\t                };\n683\t                let d_b = if let Some(ref s2) = sv2_chosen {\n684\t                    (tree.distance_function)(&p, s2)\n685\t                } else {\n686\t                    0.0\n687\t                };\n688\t                new_d1.push(d_a);\n689\t                new_d2.push(d_b);\n690\t                new_pts.push(Arc::new(p));\n691\t            }\n692\t\n693\t            // Mutate the leaf node\n694\t            let mut node_borrow = existing.borrow_mut();\n695\t            if let Node::Leaf(leaf) = &mut *node_borrow {\n696\t                if leaf.sv2.is_none() {\n697\t                    if let Some(s) = sv2_chosen {\n698\t                        leaf.sv2 = Some(Arc::new(s));\n699\t                    }\n700\t                }\n701\t                let cap = tree.leaf_capacity;\n702\t                if leaf.d1.len() < cap {\n703\t                    leaf.d1.resize(cap, 0.0);\n704\t                }\n705\t                if leaf.d2.len() < cap {\n706\t                    leaf.d2.resize(cap, 0.0);\n707\t                }\n708\t                let mut count = leaf.nbpoints;\n709\t                for ((dp, da), db) in new_pts.into_iter().zip(new_d1).zip(new_d2) {\n710\t                    if count < cap {\n711\t                        leaf.d1[count] = da;\n712\t                        leaf.d2[count] = db;\n713\t                        leaf.points.push(dp);\n714\t                        count += 1;\n715\t                    }\n716\t                }\n717\t                leaf.nbpoints = count;\n718\t            }\n719\t            drop(node_borrow);\n720\t            Ok(Some(existing))\n721\t        } else {\n722\t            // Not enough room. Rebuild.\n723\t            let mut combined: Vec<MVPDatapoint> = Vec::new();\n724\t            if let Some(s) = existing_sv1 {\n725\t                combined.push(arc_unwrap_or_clone(s));\n726\t            }\n727\t            if let Some(s) = existing_sv2 {\n728\t                combined.push(arc_unwrap_or_clone(s));\n729\t            }\n730\t            for p in existing_points {\n731\t                combined.push(arc_unwrap_or_clone(p));\n732\t            }\n733\t            for p in points {\n734\t                combined.push(p);\n735\t            }\n736\t            // Free old node by dropping Rc reference\n737\t            drop(existing);\n738\t            let new_node = build_node(\n739\t                tree.branch_factor,\n740\t                tree.path_length,\n741\t                tree.leaf_capacity,\n742\t                tree.distance_function,\n743\t                combined,\n744\t                lvl,\n745\t            )?;\n746\t            Ok(new_node.map(|n| Rc::new(RefCell::new(n))))\n747\t        }\n748\t    } else if is_internal {\n749\t        // Recurse into children\n750\t        let (sv1_clone_opt, sv2_clone_opt, m1_clone, m2_clone): (\n751\t            Option<MVPDatapoint>,\n752\t            Option<MVPDatapoint>,\n753\t            Vec<f32>,\n754\t            Vec<f32>,\n755\t        ) = {\n756\t            let nb = existing.borrow();\n757\t            if let Node::Internal(internal) = &*nb {\n758\t                (\n759\t                    internal.sv1.as_ref().map(|a| (**a).clone()),\n760\t                    internal.sv2.as_ref().map(|a| (**a).clone()),\n761\t                    internal.m1.clone(),\n762\t                    internal.m2.clone(),\n763\t                )\n764\t            } else {\n765\t                unreachable!()\n766\t            }\n767\t        };\n768\t\n769\t        let sv1_ref = sv1_clone_opt.as_ref().ok_or(MVPError::NoSv1Range)?;\n770\t        let sv2_ref = sv2_clone_opt.as_ref().ok_or(MVPError::NoSv2Range)?;\n771\t\n772\t        // Update path\n773\t        update_path_with_vp(\n774\t            &mut points,\n775\t            sv1_ref,\n776\t            tree.distance_function,\n777\t            tree.path_length,\n778\t            lvl,\n779\t        )\n780\t        .map_err(|_| MVPError::NoSv1Range)?;\n781\t\n782\t        // Sort into bf bins by sv1\n783\t        let bins = sort_into_bins(\n784\t            points,\n785\t            -1,\n786\t            -1,\n787\t            sv1_ref,\n788\t            tree.distance_function,\n789\t            bf,\n790\t            &m1_clone,\n791\t        )?;\n792\t\n793\t        for (bin_i, mut bin_points) in bins.into_iter().enumerate() {\n794\t            if bin_points.is_empty() {\n795\t                continue;\n796\t            }\n797\t            update_path_with_vp(\n798\t                &mut bin_points,\n799\t                sv2_ref,\n800\t                tree.distance_function,\n801\t                tree.path_length,\n802\t                lvl + 1,\n803\t            )\n804\t            .map_err(|_| MVPError::NoSv2Range)?;\n805\t\n806\t            // Get pivot slice\n807\t            let m2_offset = bin_i * length_m1;\n808\t            let pivots_local: Vec<f32> = if length_m1 > 0 && m2_offset + length_m1 <= m2_clone.len() {\n809\t                m2_clone[m2_offset..m2_offset + length_m1].to_vec()\n810\t            } else {\n811\t                Vec::new()\n812\t            };\n813\t\n814\t            let sub_bins = sort_into_bins(\n815\t                bin_points,\n816\t                -1,\n817\t                -1,\n818\t                sv2_ref,\n819\t                tree.distance_function,\n820\t                bf,\n821\t                &pivots_local,\n822\t            )?;\n823\t\n824\t            for (j, sub_bin) in sub_bins.into_iter().enumerate() {\n825\t                if sub_bin.is_empty() {\n826\t                    continue;\n827\t                }\n828\t                let child_idx = bin_i * bf + j;\n829\t\n830\t                // Get the existing child (or None if it's a placeholder empty leaf)\n831\t                let child_existing: Option<Rc<RefCell<Node>>> = {\n832\t                    let nb = existing.borrow();\n833\t                    if let Node::Internal(internal) = &*nb {\n834\t                        if child_idx < internal.child_nodes.len() {\n835\t                            // Check if the child is a placeholder empty leaf\n836\t                            let c = internal.child_nodes[child_idx].clone();\n837\t                            let is_placeholder = {\n838\t                                let cb = c.borrow();\n839\t                                matches!(&*cb, Node::Leaf(l) if l.sv1.is_none())\n840\t                            };\n841\t                            if is_placeholder {\n842\t                                None\n843\t                            } else {\n844\t                                Some(c)\n845\t                            }\n846\t                        } else {\n847\t                            None\n848\t                        }\n849\t                    } else {\n850\t                        None\n851\t                    }\n852\t                };\n853\t\n854\t                let new_child = add_to_existing_node(tree, child_existing, sub_bin, lvl + 2)?;\n855\t\n856\t                // Set the child\n857\t                let mut nb = existing.borrow_mut();\n858\t                if let Node::Internal(internal) = &mut *nb {\n859\t                    while internal.child_nodes.len() <= child_idx {\n860\t                        internal.child_nodes.push(Rc::new(RefCell::new(Node::Leaf(\n861\t                            LeafNode::new(tree.leaf_capacity as u32),\n862\t                        ))));\n863\t                    }\n864\t                    if let Some(nc) = new_child {\n865\t                        internal.child_nodes[child_idx] = nc;\n866\t                    }\n867\t                }\n868\t            }\n869\t        }\n870\t        Ok(Some(existing))\n871\t    } else {\n872\t        Err(MVPError::Unrecognized)\n873\t    }\n874\t}\n875\t\n876\tfn arc_unwrap_or_clone<T: Clone>(arc: Arc<T>) -> T {\n877\t    Arc::try_unwrap(arc).unwrap_or_else(|a| (*a).clone())\n878\t}\n879\t\n880\t// ----------------- retrieve -----------------\n881\t\n882\tfn retrieve_recursive(\n883\t    tree: &MVPTree,\n884\t    node: &Node,\n885\t    target: &mut MVPDatapoint,\n886\t    radius: f32,\n887\t    knearest: usize,\n888\t    results: &mut Vec<Arc<MVPDatapoint>>,\n889\t    lvl: usize,\n890\t) -> MVPError {\n891\t    let dist = tree.distance_function;\n892\t    let bf = tree.branch_factor;\n893\t    let length_m1 = bf.saturating_sub(1);\n894\t\n895\t    match node {\n896\t        Node::Leaf(leaf) => {\n897\t            let sv1 = match &leaf.sv1 {\n898\t                Some(s) => s,\n899\t                None => return MVPError::Success,\n900\t            };\n901\t            let d1 = dist(target, sv1);\n902\t            if is_bad_dist(d1) {\n903\t                return MVPError::BadDistVal;\n904\t            }\n905\t            if lvl < tree.path_length {\n906\t                if target.path.len() < tree.path_length {\n907\t                    target.path.resize(tree.path_length, 0.0);\n908\t                }\n909\t                target.path[lvl] = d1;\n910\t            }\n911\t            if d1 <= radius {\n912\t                results.push(sv1.clone());\n913\t                if results.len() >= knearest {\n914\t                    return MVPError::KNearestCap;\n915\t                }\n916\t            }\n917\t            if let Some(sv2) = &leaf.sv2 {\n918\t                let d2 = dist(target, sv2);\n919\t                if is_bad_dist(d2) {\n920\t                    return MVPError::BadDistVal;\n921\t                }\n922\t                if d2 <= radius {\n923\t                    results.push(sv2.clone());\n924\t                    if results.len() >= knearest {\n925\t                        return MVPError::KNearestCap;\n926\t                    }\n927\t                }\n928\t                if lvl + 1 < tree.path_length {\n929\t                    if target.path.len() < tree.path_length {\n930\t                        target.path.resize(tree.path_length, 0.0);\n931\t                    }\n932\t                    target.path[lvl + 1] = d2;\n933\t                }\n934\t\n935\t                for (i, p) in leaf.points.iter().enumerate() {\n936\t                    let pd1 = leaf.d1.get(i).copied().unwrap_or(0.0);\n937\t                    let pd2 = leaf.d2.get(i).copied().unwrap_or(0.0);\n938\t                    if d1 - radius <= pd1 && d1 + radius >= pd1 {\n939\t                        if d2 - radius <= pd2 && d2 + radius >= pd2 {\n940\t                            let endpath = if lvl + 1 < tree.path_length {\n941\t                                lvl + 1\n942\t                            } else {\n943\t                                tree.path_length\n944\t                            };\n945\t                            let mut skip = false;\n946\t                            for j in 0..endpath {\n947\t                                let tp = target.path.get(j).copied().unwrap_or(0.0);\n948\t                                let pp = p.path.get(j).copied().unwrap_or(0.0);\n949\t                                if tp - radius <= pp && tp + radius >= pp {\n950\t                                    continue;\n951\t                                } else {\n952\t                                    skip = true;\n953\t                                    break;\n954\t                                }\n955\t                            }\n956\t                            if !skip {\n957\t                                let d = dist(target, p);\n958\t                                if is_bad_dist(d) {\n959\t                                    return MVPError::BadDistVal;\n960\t                                }\n961\t                                if d <= radius {\n962\t                                    results.push(p.clone());\n963\t                                    if results.len() >= knearest {\n964\t                                        return MVPError::KNearestCap;\n965\t                                    }\n966\t                                }\n967\t                            }\n968\t                        }\n969\t                    }\n970\t                }\n971\t            }\n972\t            MVPError::Success\n973\t        }\n974\t        Node::Internal(internal) => {\n975\t            let sv1 = match &internal.sv1 {\n976\t                Some(s) => s,\n977\t                None => return MVPError::Success,\n978\t            };\n979\t            let sv2 = match &internal.sv2 {\n980\t                Some(s) => s,\n981\t                None => return MVPError::Success,\n982\t            };\n983\t            let d1 = dist(target, sv1);\n984\t            if is_bad_dist(d1) {\n985\t                return MVPError::BadDistVal;\n986\t            }\n987\t            if d1 <= radius {\n988\t                results.push(sv1.clone());\n989\t                if results.len() >= knearest {\n990\t                    return MVPError::KNearestCap;\n991\t                }\n992\t            }\n993\t            if lvl < tree.path_length {\n994\t                if target.path.len() < tree.path_length {\n995\t                    target.path.resize(tree.path_length, 0.0);\n996\t                }\n997\t                target.path[lvl] = d1;\n998\t            }\n999\t            let d2 = dist(target, sv2);\n1000\t            if is_bad_dist(d2) {\n1001\t                return MVPError::BadDistVal;\n1002\t            }\n1003\t            if d2 <= radius {\n1004\t                results.push(sv2.clone());\n1005\t                if results.len() >= knearest {\n1006\t                    return MVPError::KNearestCap;\n1007\t                }\n1008\t            }\n1009\t            if lvl + 1 < tree.path_length {\n1010\t                if target.path.len() < tree.path_length {\n1011\t                    target.path.resize(tree.path_length, 0.0);\n1012\t                }\n1013\t                target.path[lvl + 1] = d2;\n1014\t            }\n1015\t\n1016\t            for i in 0..length_m1 {\n1017\t                if d1 - radius <= internal.m1[i] {\n1018\t                    for j in 0..length_m1 {\n1019\t                        let m2_idx = i * length_m1 + j;\n1020\t                        if m2_idx < internal.m2.len()\n1021\t                            && d2 - radius <= internal.m2[m2_idx]\n1022\t                        {\n1023\t                            let child_idx = i * bf + j;\n1024\t                            if child_idx < internal.child_nodes.len() {\n1025\t                                let child = internal.child_nodes[child_idx].clone();\n1026\t                                let cb = child.borrow();\n1027\t                                let err = retrieve_recursive(\n1028\t                                    tree,\n1029\t                                    &*cb,\n1030\t                                    target,\n1031\t                                    radius,\n1032\t                                    knearest,\n1033\t                                    results,\n1034\t                                    lvl + 2,\n1035\t                                );\n1036\t                                if err != MVPError::Success {\n1037\t                                    return err;\n1038\t                                }\n1039\t                            }\n1040\t                        }\n1041\t                    }\n1042\t                    let last_m2 = i * length_m1 + length_m1 - 1;\n1043\t                    if length_m1 > 0\n1044\t                        && last_m2 < internal.m2.len()\n1045\t                        && d2 + radius >= internal.m2[last_m2]\n1046\t                    {\n1047\t                        let child_idx = i * bf + length_m1;\n1048\t                        if child_idx < internal.child_nodes.len() {\n1049\t                            let child = internal.child_nodes[child_idx].clone();\n1050\t                            let cb = child.borrow();\n1051\t                            let err = retrieve_recursive(\n1052\t                                tree,\n1053\t                                &*cb,\n1054\t                                target,\n1055\t                                radius,\n1056\t                                knearest,\n1057\t                                results,\n1058\t                                lvl + 2,\n1059\t                            );\n1060\t                            if err != MVPError::Success {\n1061\t                                return err;\n1062\t                            }\n1063\t                        }\n1064\t                    }\n1065\t                }\n1066\t            }\n1067\t\n1068\t            if length_m1 > 0\n1069\t                && length_m1 - 1 < internal.m1.len()\n1070\t                && d1 + radius >= internal.m1[length_m1 - 1]\n1071\t            {\n1072\t                for j in 0..length_m1 {\n1073\t                    let m2_idx = length_m1 * length_m1 + j;\n1074\t                    if m2_idx < internal.m2.len()\n1075\t                        && d2 - radius <= internal.m2[m2_idx]\n1076\t                    {\n1077\t                        let child_idx = bf * length_m1 + j;\n1078\t                        if child_idx < internal.child_nodes.len() {\n1079\t                            let child = internal.child_nodes[child_idx].clone();\n1080\t                            let cb = child.borrow();\n1081\t                            let err = retrieve_recursive(\n1082\t                                tree,\n1083\t                                &*cb,\n1084\t                                target,\n1085\t                                radius,\n1086\t                                knearest,\n1087\t                                results,\n1088\t                                lvl + 2,\n1089\t                            );\n1090\t                            if err != MVPError::Success {\n1091\t                                return err;\n1092\t                            }\n1093\t                        }\n1094\t                    }\n1095\t                }\n1096\t                let last_m2 = length_m1 * length_m1 + length_m1 - 1;\n1097\t                if last_m2 < internal.m2.len() && d2 + radius >= internal.m2[last_m2] {\n1098\t                    let child_idx = bf * length_m1 + length_m1;\n1099\t                    if child_idx < internal.child_nodes.len() {\n1100\t                        let child = internal.child_nodes[child_idx].clone();\n1101\t                        let cb = child.borrow();\n1102\t                        let err = retrieve_recursive(\n1103\t                            tree,\n1104\t                            &*cb,\n1105\t                            target,\n1106\t                            radius,\n1107\t                            knearest,\n1108\t                            results,\n1109\t                            lvl + 2,\n1110\t                        );\n1111\t                        if err != MVPError::Success {\n1112\t                            return err;\n1113\t                        }\n1114\t                    }\n1115\t                }\n1116\t            }\n1117\t\n1118\t            MVPError::Success\n1119\t        }\n1120\t    }\n1121\t}\n1122\t\n1123\t// ----------------- file I/O -----------------\n1124\t\n1125\tfn ensure_capacity(buf: &mut Vec<u8>, size: usize) {\n1126\t    if buf.len() < size {\n1127\t        buf.resize(size, 0);\n1128\t    }\n1129\t}\n1130\t\n1131\tfn write_u8(buf: &mut Vec<u8>, pos: &mut usize, v: u8) {\n1132\t    ensure_capacity(buf, *pos + 1);\n1133\t    buf[*pos] = v;\n1134\t    *pos += 1;\n1135\t}\n1136\t\n1137\tfn write_u32_le(buf: &mut Vec<u8>, pos: &mut usize, v: u32) {\n1138\t    ensure_capacity(buf, *pos + 4);\n1139\t    buf[*pos..*pos + 4].copy_from_slice(&v.to_le_bytes());\n1140\t    *pos += 4;\n1141\t}\n1142\t\n1143\t#[allow(dead_code)]\n1144\tfn write_i64_le(buf: &mut Vec<u8>, pos: &mut usize, v: i64) {\n1145\t    ensure_capacity(buf, *pos + 8);\n1146\t    buf[*pos..*pos + 8].copy_from_slice(&v.to_le_bytes());\n1147\t    *pos += 8;\n1148\t}\n1149\t\n1150\tfn write_f32_le(buf: &mut Vec<u8>, pos: &mut usize, v: f32) {\n1151\t    ensure_capacity(buf, *pos + 4);\n1152\t    buf[*pos..*pos + 4].copy_from_slice(&v.to_le_bytes());\n1153\t    *pos += 4;\n1154\t}\n1155\t\n1156\tfn write_bytes(buf: &mut Vec<u8>, pos: &mut usize, bytes: &[u8]) {\n1157\t    ensure_capacity(buf, *pos + bytes.len());\n1158\t    buf[*pos..*pos + bytes.len()].copy_from_slice(bytes);\n1159\t    *pos += bytes.len();\n1160\t}\n1161\t\n1162\tfn write_datapoint(\n1163\t    buf: &mut Vec<u8>,\n1164\t    pos: &mut usize,\n1165\t    dp: Option<&MVPDatapoint>,\n1166\t    path_length: usize,\n1167\t) -> i64 {\n1168\t    let start = *pos as i64;\n1169\t    match dp {\n1170\t        None => {\n1171\t            write_u8(buf, pos, 0);\n1172\t            write_u32_le(buf, pos, 0);\n1173\t            start\n1174\t        }\n1175\t        Some(dp) => {\n1176\t            let active: u8 = 1;\n1177\t            let id_bytes = dp.id.as_bytes();\n1178\t            let idlen: u8 = id_bytes.len().min(255) as u8;\n1179\t            let datalength: u32 = dp.datalen as u32;\n1180\t            let type_width = dp.data_type.byte_width();\n1181\t            let bytelength: u32 = (1 + idlen as u32 + 4 + datalength * (type_width as u32) + (path_length as u32) * 4) as u32;\n1182\t\n1183\t            write_u8(buf, pos, active);\n1184\t            write_u32_le(buf, pos, bytelength);\n1185\t            write_u8(buf, pos, idlen);\n1186\t            write_bytes(buf, pos, &id_bytes[..idlen as usize]);\n1187\t            write_u32_le(buf, pos, datalength);\n1188\t            // data\n1189\t            let data_bytes_needed = (datalength as usize) * type_width;\n1190\t            ensure_capacity(buf, *pos + data_bytes_needed);\n1191\t            let data_to_write = if dp.data.len() >= data_bytes_needed {\n1192\t                &dp.data[..data_bytes_needed]\n1193\t            } else {\n1194\t                &dp.data[..]\n1195\t            };\n1196\t            write_bytes(buf, pos, data_to_write);\n1197\t            // pad data if needed\n1198\t            let padding = data_bytes_needed.saturating_sub(dp.data.len());\n1199\t            if padding > 0 {\n1200\t                let zeros = vec![0u8; padding];\n1201\t                write_bytes(buf, pos, &zeros);\n1202\t            }\n1203\t            // path\n1204\t            for i in 0..path_length {\n1205\t                let v = dp.path.get(i).copied().unwrap_or(0.0);\n1206\t                write_f32_le(buf, pos, v);\n1207\t            }\n1208\t            start\n1209\t        }\n1210\t    }\n1211\t}\n1212\t\n1213\tfn write_node_recursive(\n1214\t    buf: &mut Vec<u8>,\n1215\t    pos: &mut usize,\n1216\t    node: &Node,\n1217\t    tree_branch_factor: usize,\n1218\t    tree_path_length: usize,\n1219\t    tree_leaf_capacity: usize,\n1220\t    error: &mut MVPError,\n1221\t) -> i64 {\n1222\t    let start_pos = *pos as i64;\n1223\t    match node {\n1224\t        Node::Leaf(leaf) => {\n1225\t            let nbpoints = leaf.nbpoints as u32;\n1226\t            let node_type: u8 = NodeType::LeafNode as u8;\n1227\t            write_u8(buf, pos, node_type);\n1228\t            write_datapoint(buf, pos, leaf.sv1.as_deref(), tree_path_length);\n1229\t            write_datapoint(buf, pos, leaf.sv2.as_deref(), tree_path_length);\n1230\t            write_u32_le(buf, pos, nbpoints);\n1231\t\n1232\t            let saved_pos_start = *pos;\n1233\t            // Reserve space for leafcap entries: 4 + 4 + 8 each\n1234\t            let entry_size = 4 + 4 + 8;\n1235\t            let reserved = tree_leaf_capacity * entry_size;\n1236\t            ensure_capacity(buf, *pos + reserved);\n1237\t            *pos += reserved;\n1238\t\n1239\t            let mut saved_pos = saved_pos_start;\n1240\t            for i in 0..(nbpoints as usize) {\n1241\t                let d1v = leaf.d1.get(i).copied().unwrap_or(0.0);\n1242\t                let d2v = leaf.d2.get(i).copied().unwrap_or(0.0);\n1243\t                // write d1\n1244\t                buf[saved_pos..saved_pos + 4].copy_from_slice(&d1v.to_le_bytes());\n1245\t                saved_pos += 4;\n1246\t                buf[saved_pos..saved_pos + 4].copy_from_slice(&d2v.to_le_bytes());\n1247\t                saved_pos += 4;\n1248\t                let offset = if let Some(p) = leaf.points.get(i) {\n1249\t                    write_datapoint(buf, pos, Some(p), tree_path_length)\n1250\t                } else {\n1251\t                    write_datapoint(buf, pos, None, tree_path_length)\n1252\t                };\n1253\t                buf[saved_pos..saved_pos + 8].copy_from_slice(&offset.to_le_bytes());\n1254\t                saved_pos += 8;\n1255\t            }\n1256\t        }\n1257\t        Node::Internal(internal) => {\n1258\t            let bf = tree_branch_factor;\n1259\t            let length_m1 = bf.saturating_sub(1);\n1260\t            let length_m2 = bf * length_m1;\n1261\t            let fanout = bf * bf;\n1262\t            let node_type: u8 = NodeType::InternalNode as u8;\n1263\t            write_u8(buf, pos, node_type);\n1264\t            write_datapoint(buf, pos, internal.sv1.as_deref(), tree_path_length);\n1265\t            write_datapoint(buf, pos, internal.sv2.as_deref(), tree_path_length);\n1266\t            // M1\n1267\t            for i in 0..length_m1 {\n1268\t                let v = internal.m1.get(i).copied().unwrap_or(0.0);\n1269\t                write_f32_le(buf, pos, v);\n1270\t            }\n1271\t            // M2\n1272\t            for i in 0..length_m2 {\n1273\t                let v = internal.m2.get(i).copied().unwrap_or(0.0);\n1274\t                write_f32_le(buf, pos, v);\n1275\t            }\n1276\t            // Reserve fanout entries: 1 + 8 each\n1277\t            let entry_size = 1 + 8;\n1278\t            let reserved = fanout * entry_size;\n1279\t            let saved_pos_start = *pos;\n1280\t            ensure_capacity(buf, *pos + reserved);\n1281\t            *pos += reserved;\n1282\t\n1283\t            let mut saved_pos = saved_pos_start;\n1284\t            for i in 0..fanout {\n1285\t                let offset = if let Some(child_rc) = internal.child_nodes.get(i) {\n1286\t                    let child_borrow = child_rc.borrow();\n1287\t                    // Check if child is \"real\" (not a placeholder empty leaf)\n1288\t                    let is_empty_placeholder = matches!(\n1289\t                        &*child_borrow,\n1290\t                        Node::Leaf(l) if l.sv1.is_none() && l.points.is_empty()\n1291\t                    );\n1292\t                    if is_empty_placeholder {\n1293\t                        0i64\n1294\t                    } else {\n1295\t                        write_node_recursive(\n1296\t                            buf,\n1297\t                            pos,\n1298\t                            &*child_borrow,\n1299\t                            tree_branch_factor,\n1300\t                            tree_path_length,\n1301\t                            tree_leaf_capacity,\n1302\t                            error,\n1303\t                        )\n1304\t                    }\n1305\t                } else {\n1306\t                    0i64\n1307\t                };\n1308\t                let fileno: u8 = 0;\n1309\t                buf[saved_pos] = fileno;\n1310\t                saved_pos += 1;\n1311\t                buf[saved_pos..saved_pos + 8].copy_from_slice(&offset.to_le_bytes());\n1312\t                saved_pos += 8;\n1313\t            }\n1314\t        }\n1315\t    }\n1316\t    start_pos\n1317\t}\n1318\t\n1319\tfn read_u8(buf: &[u8], pos: &mut usize) -> Result<u8, MVPError> {\n1320\t    if *pos >= buf.len() {\n1321\t        return Err(MVPError::MemMap);\n1322\t    }\n1323\t    let v = buf[*pos];\n1324\t    *pos += 1;\n1325\t    Ok(v)\n1326\t}\n1327\t\n1328\tfn read_u32_le(buf: &[u8], pos: &mut usize) -> Result<u32, MVPError> {\n1329\t    if *pos + 4 > buf.len() {\n1330\t        return Err(MVPError::MemMap);\n1331\t    }\n1332\t    let v = u32::from_le_bytes(buf[*pos..*pos + 4].try_into().unwrap());\n1333\t    *pos += 4;\n1334\t    Ok(v)\n1335\t}\n1336\t\n1337\tfn read_i64_le(buf: &[u8], pos: &mut usize) -> Result<i64, MVPError> {\n1338\t    if *pos + 8 > buf.len() {\n1339\t        return Err(MVPError::MemMap);\n1340\t    }\n1341\t    let v = i64::from_le_bytes(buf[*pos..*pos + 8].try_into().unwrap());\n1342\t    *pos += 8;\n1343\t    Ok(v)\n1344\t}\n1345\t\n1346\tfn read_f32_le(buf: &[u8], pos: &mut usize) -> Result<f32, MVPError> {\n1347\t    if *pos + 4 > buf.len() {\n1348\t        return Err(MVPError::MemMap);\n1349\t    }\n1350\t    let v = f32::from_le_bytes(buf[*pos..*pos + 4].try_into().unwrap());\n1351\t    *pos += 4;\n1352\t    Ok(v)\n1353\t}\n1354\t\n1355\tfn read_datapoint(\n1356\t    buf: &[u8],\n1357\t    pos: &mut usize,\n1358\t    datatype: MVPDataType,\n1359\t    path_length: usize,\n1360\t) -> Result<Option<MVPDatapoint>, MVPError> {\n1361\t    let active = read_u8(buf, pos)?;\n1362\t    let bytelength = read_u32_le(buf, pos)?;\n1363\t    if active == 0 && bytelength == 0 {\n1364\t        return Ok(None);\n1365\t    }\n1366\t    let idlen = read_u8(buf, pos)? as usize;\n1367\t    if *pos + idlen > buf.len() {\n1368\t        return Err(MVPError::MemMap);\n1369\t    }\n1370\t    let id = String::from_utf8_lossy(&buf[*pos..*pos + idlen]).to_string();\n1371\t    *pos += idlen;\n1372\t    let datalength = read_u32_le(buf, pos)? as usize;\n1373\t    let type_width = datatype.byte_width();\n1374\t    let data_bytes = datalength * type_width;\n1375\t    if *pos + data_bytes > buf.len() {\n1376\t        return Err(MVPError::MemMap);\n1377\t    }\n1378\t    let data: Vec<u8> = buf[*pos..*pos + data_bytes].to_vec();\n1379\t    *pos += data_bytes;\n1380\t    let mut path = Vec::with_capacity(path_length);\n1381\t    for _ in 0..path_length {\n1382\t        path.push(read_f32_le(buf, pos)?);\n1383\t    }\n1384\t    Ok(Some(MVPDatapoint {\n1385\t        id,\n1386\t        data,\n1387\t        path,\n1388\t        datalen: datalength,\n1389\t        data_type: datatype,\n1390\t    }))\n1391\t}\n1392\t\n1393\tfn read_node_recursive(\n1394\t    buf: &[u8],\n1395\t    pos: &mut usize,\n1396\t    branch_factor: usize,\n1397\t    path_length: usize,\n1398\t    leaf_capacity: usize,\n1399\t    datatype: MVPDataType,\n1400\t) -> Result<Option<Node>, MVPError> {\n1401\t    let node_type = read_u8(buf, pos)?;\n1402\t    let bf = branch_factor;\n1403\t    let length_m1 = bf.saturating_sub(1);\n1404\t    let length_m2 = bf * length_m1;\n1405\t    let fanout = bf * bf;\n1406\t\n1407\t    if node_type == NodeType::LeafNode as u8 {\n1408\t        let mut leaf = LeafNode::new(leaf_capacity as u32);\n1409\t        let sv1 = read_datapoint(buf, pos, datatype, path_length)?;\n1410\t        let sv2 = read_datapoint(buf, pos, datatype, path_length)?;\n1411\t        let nbpoints = read_u32_le(buf, pos)? as usize;\n1412\t        leaf.sv1 = sv1.map(Arc::new);\n1413\t        leaf.sv2 = sv2.map(Arc::new);\n1414\t        leaf.nbpoints = nbpoints;\n1415\t\n1416\t        let mut saved_pos = *pos;\n1417\t        // Skip past leafcap entries (4+4+8 each)\n1418\t        let entry_size = 4 + 4 + 8;\n1419\t        *pos += leaf_capacity * entry_size;\n1420\t\n1421\t        leaf.d1 = vec![0.0f32; leaf_capacity];\n1422\t        leaf.d2 = vec![0.0f32; leaf_capacity];\n1423\t        leaf.points = Vec::with_capacity(nbpoints);\n1424\t\n1425\t        for i in 0..nbpoints {\n1426\t            let d1v = read_f32_le(buf, &mut saved_pos)?;\n1427\t            let d2v = read_f32_le(buf, &mut saved_pos)?;\n1428\t            let offset = read_i64_le(buf, &mut saved_pos)? as usize;\n1429\t            leaf.d1[i] = d1v;\n1430\t            leaf.d2[i] = d2v;\n1431\t\n1432\t            let mut local_pos = offset;\n1433\t            let dp = read_datapoint(buf, &mut local_pos, datatype, path_length)?;\n1434\t            if let Some(dp) = dp {\n1435\t                leaf.points.push(Arc::new(dp));\n1436\t            } else {\n1437\t                // Push placeholder? We'll just stop reading\n1438\t                break;\n1439\t            }\n1440\t        }\n1441\t        Ok(Some(Node::Leaf(leaf)))\n1442\t    } else if node_type == NodeType::InternalNode as u8 {\n1443\t        let mut internal = InternalNode::new(bf as u32);\n1444\t        let sv1 = read_datapoint(buf, pos, datatype, path_length)?;\n1445\t        let sv2 = read_datapoint(buf, pos, datatype, path_length)?;\n1446\t        internal.sv1 = sv1.map(Arc::new);\n1447\t        internal.sv2 = sv2.map(Arc::new);\n1448\t\n1449\t        for i in 0..length_m1 {\n1450\t            internal.m1[i] = read_f32_le(buf, pos)?;\n1451\t        }\n1452\t        for i in 0..length_m2 {\n1453\t            if i < internal.m2.len() {\n1454\t                internal.m2[i] = read_f32_le(buf, pos)?;\n1455\t            } else {\n1456\t                let _ = read_f32_le(buf, pos)?;\n1457\t            }\n1458\t        }\n1459\t\n1460\t        let mut saved_pos = *pos;\n1461\t        // Skip past fanout entries (1+8)\n1462\t        *pos += fanout * (1 + 8);\n1463\t\n1464\t        internal.child_nodes = Vec::with_capacity(fanout);\n1465\t        for _ in 0..fanout {\n1466\t            let _fileno = read_u8(buf, &mut saved_pos)?;\n1467\t            let offset = read_i64_le(buf, &mut saved_pos)?;\n1468\t            if offset == 0 {\n1469\t                // Empty child - placeholder\n1470\t                internal\n1471\t                    .child_nodes\n1472\t                    .push(Rc::new(RefCell::new(Node::Leaf(LeafNode::new(\n1473\t                        leaf_capacity as u32,\n1474\t                    )))));\n1475\t            } else {\n1476\t                let mut local_pos = offset as usize;\n1477\t                let child = read_node_recursive(\n1478\t                    buf,\n1479\t                    &mut local_pos,\n1480\t                    branch_factor,\n1481\t                    path_length,\n1482\t                    leaf_capacity,\n1483\t                    datatype,\n1484\t                )?;\n1485\t                match child {\n1486\t                    Some(c) => internal\n1487\t                        .child_nodes\n1488\t                        .push(Rc::new(RefCell::new(c))),\n1489\t                    None => internal\n1490\t                        .child_nodes\n1491\t                        .push(Rc::new(RefCell::new(Node::Leaf(LeafNode::new(\n1492\t                            leaf_capacity as u32,\n1493\t                        ))))),\n1494\t                }\n1495\t            }\n1496\t        }\n1497\t\n1498\t        Ok(Some(Node::Internal(internal)))\n1499\t    } else {\n1500\t        Err(MVPError::