1);\n996\t    memcpy(&buf[pos++], &lc, 1);\n997\t    memcpy(&buf[pos++], &ht, 1);\n998\t\n999\t    tree->buf = buf;\n1000\t    pos = HEADER_SIZE;\n1001\t    tree->pos = pos;\n1002\t\n1003\t    /* write nodes */\n1004\t    MVPError error = MVP_SUCCESS;\n1005\t    _mvptree_write(tree, tree->node, &error, 0);\n1006\t\n1007\t    /* cleanup */\n1008\t    if (msync(tree->buf, tree->size, MS_SYNC) < 0) {\n1009\t        error = MVP_MEMMAP;\n1010\t    }\n1011\t\n1012\t    if (munmap(tree->buf, tree->size) < 0) {\n1013\t        error = MVP_MUNMAP;\n1014\t    }\n1015\t    tree->buf = NULL;\n1016\t\n1017\t    if (close(tree->fd) < 0) {\n1018\t        error = MVP_FILECLOSE;\n1019\t    }\n1020\t\n1021\t    return error;\n1022\t}\n1023\t\n1024\tstatic MVPDP* read_datapoint(MVPTree *tree) {\n1025\t    uint8_t active, idlen;\n1026\t    uint32_t bytelength, datalength;\n1027\t\n1028\t    memcpy(&active, &tree->buf[tree->pos], sizeof(active));\n1029\t    tree->pos += sizeof(active);\n1030\t    memcpy(&bytelength, &tree->buf[tree->pos], sizeof(bytelength));\n1031\t    tree->pos += sizeof(bytelength);\n1032\t\n1033\t    if (active == 0 && bytelength == 0) return NULL;\n1034\t\n1035\t    MVPDP *dp = dp_alloc(tree->datatype);\n1036\t    if (!dp) { return NULL; }\n1037\t\n1038\t    dp->path = (float*) malloc(tree->pathlength*sizeof(float));\n1039\t    if (!dp->path) { return NULL; }\n1040\t\n1041\t    memcpy(&idlen, &tree->buf[tree->pos], sizeof(uint8_t));\n1042\t    tree->pos += sizeof(uint8_t);\n1043\t    dp->id = malloc(idlen+1);\n1044\t    memcpy(dp->id, &tree->buf[tree->pos], idlen);\n1045\t    tree->pos += idlen;\n1046\t    dp->id[idlen] = '\\0';\n1047\t    memcpy(&datalength, &tree->buf[tree->pos], sizeof(uint32_t));\n1048\t    tree->pos += sizeof(uint32_t);\n1049\t\n1050\t    dp->datalen = datalength;\n1051\t    dp->data = malloc(datalength*tree->datatype);\n1052\t    memcpy(dp->data, &tree->buf[tree->pos], datalength*tree->datatype);\n1053\t    tree->pos += datalength*tree->dataty