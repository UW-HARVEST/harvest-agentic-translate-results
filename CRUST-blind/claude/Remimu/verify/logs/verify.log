t                    if n0 >= b'A' { n0 -= b'A' - 10; }\n265\t                    if n1 >= b'A' { n1 -= b'A' - 10; }\n266\t                    n0 -= b'0';\n267\t                    n1 -= b'0';\n268\t                    token.set_mask((n1 << 4) | n0);\n269\t                    i += 2;\n270\t                    state = State::Quant;\n271\t                } else if matches!(c,\n272\t                    b'{' | b'}' | b'[' | b']' | b'-' | b'(' | b')'\n273\t                    | b'|' | b'^' | b'$' | b'*' | b'+' | b'?' | b':'\n274\t                    | b'.' | b'/' | b'\\\\') {\n275\t                    token.set_mask(c);\n276\t                    state = State::Quant;\n277\t                } else if matches!(c, b'd' | b's' | b'w' | b'D' | b'S' | b'W') {\n278\t                    let is_upper = c <= b'Z';\n279\t                    let mut m = [0u16; 16];\n280\t                    let cc = if is_upper { c + 0x20 } else { c };\n281\t                    if cc == b'd' || cc == b'w' {\n282\t                        m[3] |= 0x03FF;\n283\t                    }\n284\t                    if cc == b's' {\n285\t                        m[0] |= 0x3E00;\n286\t                        m[2] |= 1;\n287\t                    }\n288\t                    if cc == b'w' {\n289\t                        m[4] |= 0xFFFE;\n290\t                        m[5] |= 0x87FF;\n291\t                        m[6] |= 0xFFFE;\n292\t                        m[7] |= 0x07FF;\n293\t                    }\n294\t                    for j in 0..16 {\n295\t                        token.mask[j] |= if is_upper { !m[j] } else { m[j] };\n296\t                    }\n297\t                    token.kind = REMIMU_KIND_NORMAL;\n298\t                    state = State::Quant;\n299\t                } else if c == b'b' {\n300\t                    token.kind = REMIMU_KIND_BOUND;\n301\t                    state = State::Normal;\n302\t                } else if c == b'B' {\n303\t                    token.kind = REMIMU_KIND_NBOUND;\n304\t     