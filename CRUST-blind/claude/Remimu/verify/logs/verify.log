- 1) as usize].pair_offset = (diff as i16) + 2;\n385\t                    }\n386\t                } else if c == b'?' || c == b'+' || c == b'*' || c == b'{' {\n387\t                    return Err(-1);\n388\t                } else if c == b'.' {\n389\t                    set_mask_all(&mut token);\n390\t                    if (flags & REMIMU_FLAG_DOT_NO_NEWLINES) != 0 {\n391\t                        token.mask[1] ^= 0x04;\n392\t                        token.mask[1] ^= 0x20;\n393\t                    }\n394\t                    state = State::Quant;\n395\t                } else if c == b'^' {\n396\t                    token.kind = REMIMU_KIND_CARET;\n397\t                    state = State::Normal;\n398\t                } else if c == b'$' {\n399\t                    token.kind = REMIMU_KIND_DOLLAR;\n400\t                    state = State::Normal;\n401\t                } else if c == b'|' {\n402\t                    token.kind = REMIMU_KIND_OR;\n403\t                    state = State::Normal;\n404\t                } else {\n405\t                    token.set_mask(c);\n406\t                    state = State::Quant;\n407\t                }\n408\t            }\n409\t        } else if matches!(state, State::CharClassInit | State::CharClassNormal | State::CharClassRange) {\n410\t            if c == b'\\\\' && esc_state == 0 {\n411\t                esc_state = 1;\n412\t                i += 1;\n413\t                continue;\n414\t            }\n415\t            let mut esc_c: u8 = 0;\n416\t            if esc_state == 1 {\n417\t                esc_state = 0;\n418\t                if c == b'n' { esc_c = b'\\n'; }\n419\t                else if c == b'r' { esc_c = b'\\r'; }\n420\t                else if c == b't' { esc_c = b'\\t'; }\n421\t                else if c == b'v' { esc_c = 0x0B; }\n422\t                else if c == b'f' { esc_c = 0x0C; }\n423\t                else if c == b'x' {\n424\t                    if i + 1 >= pattern_len || i + 2 >= pattern_len\n425\t                        || pattern_bytes[i + 1] == 0 || pattern_bytes[i + 2] == 0 {\n426\t                        return Err(-1);\n427\t                    }\n428\t                    let mut n0 = pattern_bytes[i + 1];\n429\t                    let mut n1 = pattern_bytes[i + 1]; // faithful to C source bug\n430\t                    if n0 < b'0' || n0 > b'f' || n1 < b'0' || n1 > b'f'\n431\t                        || (n0 > b'9' && n0 < b'A') || (n1 > b'9' && n1 < b'A') {\n432\t                        return Err(-1);\n433\t                    }\n434\t                    if n0 > b'F' { n0 -= 0x20; }\n435\t                    if n1 > b'F' { n1 -= 0x20; }\n436\t                    if n0 >= b'A' { n0 -= b'A' - 10; }\n437\t                    if n1 >= b'A' { n1 -= b'A' - 10; }\n438\t                    n0 -= b'0';\n439\t                    n1 -= b'0';\n440\t                    esc_c = (n1 << 4) | n0;\n441\t                    i += 2;\n442\t                } else if matches!(c,\n443\t                    b'{' | b'}' | b'[' | b']' | b'-' | b'(' | b')'\n444\t                    | b'|' | b'^' | b'$' | b'*' | b'+' | b'?' | b':'\n445\t                    | b'.' | b'/' | b'\\\\') {\n446\t                    esc_c = c;\n447\t                } else if matches!(c, b'd' | b's' | b'w' | b'D' | b'S' | b'W') {\n448\t                    if matches!(state, State::CharClassRange) {\n449\t                        return Err(-1);\n450\t                    }\n451\t                    let is_upper = c <= b'Z';\n452\t                    let mut m = [0u16; 16];\n453\t                    let cc = if is_upper { c + 0x20 } else { c };\n454\t                    if cc == b'd' || cc == b'w' {\n455\t                        m[3] |= 0x03FF;\n456\t                    }\n457\t                    if cc == b's' {\n458\t                        m[0] |= 0x3E00;\n459\t                        m[2] |= 1;\n460\t                    }\n461\t                    if cc == b'w' {\n462\t                        m[4] |= 0xFFFE;\n463\t                        m[5] |= 0x87FF;\n464\t                        m[6] |= 0xFFFE;\n465\t                        m[7] |= 0x07FF;\n466\t                    }\n467\t                    for j in 0..16 {\n468\t                        token.mask[j] |= if is_upper { !m[j] } else { m[j] };\n469\t                    }\n470\t                    char_class_mem = -1;\n471\t                    i += 1;\n472\t                    continue;\n473\t                } else {\n474\t                    return Err(-1);\n475\t                }\n476\t            }\n477\t\n478\t            if matches!(state, State::CharClassInit) {\n479\t                char_class_mem = c as i32;\n480\t                token.set_mask(c);\n481\t                state = State::CharClassNormal;\n482\t            } else if matches!(state, State::CharClassNormal) {\n483\t                if c == b']' && esc_c == 0 {\n484\t                    char_class_mem = -1;\n485\t                    state = State::Quant;\n486\t                    i += 1;\n487\t                    continue;\n488\t                } else if c == b'-' && esc_c == 0 && char_class_mem >= 0 {\n489\t                    state = State::CharClassRange;\n490\t                    i += 1;\n491\t                    continue;\n492\t                } else {\n493\t                    char_class_mem = c as i32;\n494\t                    token.set_mask(c);\n495\t                    state = State::CharClassNormal;\n496\t                }\n497\t            } else if matches!(state, State::CharClassRange) {\n498\t                if c == b']' && esc_c == 0 {\n499\t                    char_class_mem = -1;\n500\t                    token.set_mask(b'-');\n501\t                    state = State::Quant;\n502\t                    i += 1;\n503\t                    continue;\n504\t                } else {\n505\t                    if char_class_mem == -1 {\n506\t                        return Err(-1);\n507\t                    }\n508\t                    if (c as i32) < char_class_mem {\n509\t                        return Err(-1);\n510\t                    }\n511\t                    let start = char_class_mem as u8;\n512\t                    let end = c;\n513\t                    // for (uint8_t i = c; i > char_class_mem; i--) _REGEX_SET_MASK(i);\n514\t                    // Note: this excludes char_class_mem itself; that was already set previously.\n515\t                    let mut x = end;\n516\t                    while (x as i32) > (start as i32) {\n517\t                        token.set_mask(x);\n518\t                        if x == 0 { break; }\n519\t                        x = x.wrapping_sub(1);\n520\t                    }\n521\t                    state = State::CharClassNormal;\n522\t                    char_class_mem = -1;\n523\t                }\n524\t            }\n525\t        } else {\n526\t            // unreachable\n527\t        }\n528\t\n529\t        i += 1;\n530\t    }\n531\t\n532\t    if paren_count > 0 {\n533\t        return Err(-1);\n534\t    }\n535\t    if esc_state != 0 {\n536\t        return Err(-1);\n537\t    }\n538\t    if matches!(state, State::CharClassInit | State::CharClassNormal | State::CharClassRange) {\n539\t        return Err(-1);\n540\t    }\n541\t\n542\t    token.push_to_vec(tokens, max_len_usize)?;\n543\t\n544\t    // add invisible non-capturing group specifier\n545\t    token.kind = REMIMU_KIND_CLOSE;\n546\t    token.count_lo = 1;\n547\t    token.count_hi = 2;\n548\t    token.push_to_vec(tokens, max_len_usize)?;\n549\t\n550\t    // add end token\n551\t    token.kind = REMIMU_KIND_END;\n552\t    token.push_to_vec(tokens, max_len_usize)?;\n553\t\n554\t    let k = tokens.len() as i16;\n555\t    let k_minus_2 = k - 2;\n556\t    tokens[0].pair_offset = k_minus_2;\n557\t    tokens[(k - 2) as usize].pair_offset = -k_minus_2;\n558\t\n559\t    *token_count = k;\n560\t\n561\t    // copy quantifiers from )s to (s and number quantified groups\n562\t    let mut n: u64 = 0;\n563\t    let kk = tokens.len() as i16;\n564\t    let mut k2: i16 = 0;\n565\t    while k2 < kk {\n566\t        let k2u = k2 as usize;\n567\t        if tokens[k2u].kind == REMIMU_KIND_CLOSE {\n568\t            tokens[k2u].mask[0] = n as u16;\n569\t            n += 1;\n570\t\n571\t            let k3 = k2 + tokens[k2u].pair_offset;\n572\t            let k3u = k3 as usize;\n573\t            tokens[k3u].count_lo = tokens[k2u].count_lo;\n574\t            tokens[k3u].count_hi = tokens[k2u].count_hi;\n575\t            tokens[k3u].mask[0] = n as u16;\n576\t            tokens[k3u].mode = tokens[k2u].mode;\n577\t            n += 1;\n578\t\n579\t            if n > 1024 {\n580\t                return Err(-1);\n581\t            }\n582\t        } else if tokens[k2u].kind == REMIMU_KIND_OR\n583\t            || tokens[k2u].kind == REMIMU_KIND_OPEN\n584\t            || tokens[k2u].kind == REMIMU_KIND_NCOPEN\n585\t        {\n586\t            // find next | or ) and how far away it is\n587\t            let mut balance: i32 = 0;\n588\t            let mut found: i64 = -1;\n589\t            let mut l = (k2 + 1) as i64;\n590\t            let limit = tokens_len; // mirrors C: < tokens_len (the original max length)\n591\t            while l < limit && (l as usize) < tokens.len() {\n592\t                let kl = tokens[l as usize].kind;\n593\t                if kl == REMIMU_KIND_OR && balance == 0 {\n594\t                    found = l;\n595\t                    break;\n596\t                } else if kl == REMIMU_KIND_CLOSE {\n597\t                    if balance == 0 {\n598\t                        found = l;\n599\t                        break;\n600\t                    } else {\n601\t                        balance -= 1;\n602\t                    }\n603\t                } else if kl == REMIMU_KIND_NCOPEN || kl == REMIMU_KIND_OPEN {\n604\t                    balance += 1;\n605\t                }\n606\t                l += 1;\n607\t            }\n608\t            if found == -1 {\n609\t                return Err(-1);\n610\t            }\n611\t            let diff = found - (k2 as i64);\n612\t            if diff > 32767 {\n613\t                return Err(-1);\n614\t            }\n615\t            if tokens[k2u].kind == REMIMU_KIND_OR {\n616\t                tokens[k2u].pair_offset = diff as i16;\n617\t            } else {\n618\t                tokens[k2u].mask[15] = diff as u16;\n619\t            }\n620\t        }\n621\t        k2 += 1;\n622\t    }\n623\t\n624\t    Ok(())\n625\t}\n626\t#[derive(Debug, Clone, Copy)]\n627\tenum State {\n628\t    Normal,\n629\t    Quant,\n630\t    Mode,\n631\t    CharClassInit,\n632\t    CharClassNormal,\n633\t    CharClassRange,\n634\t}\n635\t\n636\tconst W_MASK: [u16; 16] = [\n637\t    0, 0, 0, 0x03FF, 0xFFFE, 0x87FF, 0xFFFE, 0x07FF,\n638\t    0, 0, 0, 0, 0, 0, 0, 0,\n639\t];\n640\t\n641\tfn check_is_w(byte: u8) -> bool {\n642\t    (W_MASK[(byte >> 4) as usize] & (1u16 << (byte & 0xF))) != 0\n643\t}\n644\t\n645\tfn check_token_mask(tokens: &[RegexToken], k: usize, byte: u8) -> bool {\n646\t    (tokens[k].mask[(byte >> 4) as usize] & (1u16 << (byte & 0xF))) != 0\n647\t}\n648\t\n649\tpub fn regex_match(tokens: &[RegexToken],\n650\t    text: &str,\n651\t    start_i: usize,\n652\t    cap_slots: u16,\n653\t    cap_pos: &mut [i64],\n654\t    cap_span: &mut [i64]) -> Option<usize> {\n655\t    let text_bytes = text.as_bytes();\n656\t    let stack_size_max: usize = 1024;\n657\t    let aux_stats_size: usize = 1024;\n658\t    let mut cap_slots = cap_slots as usize;\n659\t    if cap_slots > aux_stats_size {\n660\t        cap_slots = aux_stats_size;\n661\t    }\n662\t\n663\t    // Helper: read text byte (0 if past end)\n664\t    let text_byte = |i: u64| -> u8 {\n665\t        if (i as usize) < text_bytes.len() { text_bytes[i as usize] } else { 0 }\n666\t    };\n667\t\n668\t    let mut q_group_accepts_zero: Vec<u8> = vec![0; aux_stats_size];\n669\t    let mut q_group_state: Vec<u32> = vec![0; aux_stats_size];\n670\t    let mut q_group_stack: Vec<u32> = vec![0; aux_stats_size];\n671\t    let mut q_group_cap_index: Vec<u16> = vec![0xFFFF; aux_stats_size];\n672\t\n673\t    let tokens_len: u64;\n674\t    let mut k: u32 = 0;\n675\t    let mut caps: u16 = 0;\n676\t\n677\t    while tokens[k as usize].kind != REMIMU_KIND_END {\n678\t        let kk = tokens[k as usize].kind;\n679\t        if kk == REMIMU_KIND_OPEN && (caps as usize) < cap_slots {\n680\t            let idx_open = tokens[k as usize].mask[0] as usize;\n681\t            let pair_idx = (k as i32 + tokens[k as usize].pair_offset as i32) as usize;\n682\t            let idx_close = tokens[pair_idx].mask[0] as usize;\n683\t            if idx_open < q_group_cap_index.len() {\n684\t                q_group_cap_index[idx_open] = caps;\n685\t            }\n686\t            if idx_close < q_group_cap_index.len() {\n687\t                q_group_cap_index[idx_close] = caps;\n688\t            }\n689\t            cap_pos[caps as usize] = -1;\n690\t            cap_span[caps as usize] = -1;\n691\t            caps += 1;\n692\t        }\n693\t        k += 1;\n694\t        let kk2 = tokens[k as usize].kind;\n695\t        if kk2 == REMIMU_KIND_CLOSE || kk2 == REMIMU_KIND_OPEN || kk2 == REMIMU_KIND_NCOPEN {\n696\t            let m0 = tokens[k as usize].mask[0] as usize;\n697\t            if m0 >= aux_stats_size {\n698\t                return None;\n699\t            }\n700\t            q_group_state[m0] = 0;\n701\t            q_group_stack[m0] = 0;\n702\t            q_group_accepts_zero[m0] = 0;\n703\t        }\n704\t    }\n705\t\n706\t    tokens_len = k as u64;\n707\t\n708\t    let mut rewind_stack: Vec<RegexMatcherState> = Vec::with_capacity(stack_size_max);\n709\t    // We'll grow it as needed but cap at stack_size_max.\n710\t    // C uses fixed-size array, with stack_n as count. We use Vec, treat len as stack_n.\n711\t\n712\t    let mut i: u64 = start_i as u64;\n713\t    let mut range_min: u64 = 0;\n714\t    let mut range_max: u64 = 0;\n715\t    let mut just_rewinded: u8 = 0;\n716\t\n717\t    // Use a state machine. We need to be able to rewind k inside loop.\n718\t    // C uses for(k=0; k<tokens_len; k++) with manual k modifications.\n719\t    // Translate to a manual loop.\n720\t    k = 0;\n721\t    let limit_count: usize = 10000;\n722\t    let _ = limit_count; // C had this commented out (limit-- inside loop body)\n723\t\n724\t    let mut iteration_should_continue: bool;\n725\t    'main: loop {\n726\t        if k as u64 >= tokens_len {\n727\t            break;\n728\t        }\n729\t        iteration_should_continue = false;\n730\t\n731\t        let kind = tokens[k as usize].kind;\n732\t\n733\t        if kind == REMIMU_KIND_CARET {\n734\t            if i != 0 {\n735\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n736\t                    return None;\n737\t                }\n738\t            }\n739\t            // continue\n740\t            iteration_should_continue = true;\n741\t        } else if kind == REMIMU_KIND_DOLLAR {\n742\t            if text_byte(i) != 0 {\n743\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n744\t                    return None;\n745\t                }\n746\t            }\n747\t            iteration_should_continue = true;\n748\t        } else if kind == REMIMU_KIND_BOUND {\n749\t            let cur = text_byte(i);\n750\t            if i == 0 && !check_is_w(cur) {\n751\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n752\t                    return None;\n753\t                }\n754\t            } else if i != 0 && cur == 0 && !check_is_w(text_byte(i - 1)) {\n755\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n756\t                    return None;\n757\t                }\n758\t            } else if i != 0 && cur != 0 && check_is_w(text_byte(i - 1)) == check_is_w(cur) {\n759\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n760\t                    return None;\n761\t                }\n762\t            }\n763\t        } else if kind == REMIMU_KIND_NBOUND {\n764\t            let cur = text_byte(i);\n765\t            if i == 0 && check_is_w(cur) {\n766\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n767\t                    return None;\n768\t                }\n769\t            } else if i != 0 && cur == 0 && check_is_w(text_byte(i - 1)) {\n770\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n771\t                    return None;\n772\t                }\n773\t            } else if i != 0 && cur != 0 && check_is_w(text_byte(i - 1)) != check_is_w(cur) {\n774\t                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n775\t                    return None;\n776\t                }\n777\t            }\n778\t        } else {\n779\t            // deliberately unmatchable token (e.g. a{0}, a{0,0})\n780\t            if tokens[k as usize].count_hi == 1 {\n781\t                if kind == REMIMU_KIND_OPEN || kind == REMIMU_KIND_NCOPEN {\n782\t                    k = (k as i32 + tokens[k as usize].pair_offset as i32) as u32;\n783\t                } else {\n784\t                    k += 1;\n785\t                }\n786\t                iteration_should_continue = true;\n787\t            } else if kind == REMIMU_KIND_OPEN || kind == REMIMU_KIND_NCOPEN {\n788\t                if just_rewinded == 0 {\n789\t                    let pair_idx = (k as i32 + tokens[k as usize].pair_offset as i32) as usize;\n790\t                    let close_m0 = tokens[pair_idx].mask[0] as usize;\n791\t                    let lazy_branch = (tokens[k as usize].mode & REMIMU_MODE_LAZY) != 0\n792\t                        && (tokens[k as usize].count_lo == 0 || q_group_accepts_zero[close_m0] != 0);\n793\t                    if lazy_branch {\n794\t                        range_min = 0;\n795\t                        range_max = 0;\n796\t                        if !rewind_save(&mut rewind_stack, stack_size_max, k, i, range_min, range_max, false, tokens, &mut q_group_state, &mut q_group_stack) {\n797\t                            return None;\n798\t                        }\n799\t                        k = (k as i32 + tokens[k as usize].pair_offset as i32) as u32;\n800\t                    } else {\n801\t                        range_min = 1;\n802\t                        range_max = 0;\n803\t                        if !rewind_save(&mut rewind_stack, stack_size_max, k, i, range_min, range_max, false, tokens, &mut q_group_state, &mut q_group_stack) {\n804\t                            return None;\n805\t                        }\n806\t                    }\n807\t                } else {\n808\t                    just_rewinded = 0;\n809\t\n810\t                    let orig_k = k as i64;\n811\t\n812\t                    if range_min != 0 {\n813\t                        k = (k as u64 + range_min) as u32;\n814\t                        if k > 0 {\n815\t                            let prev_k = (k - 1) as usize;\n816\t                            let prev_kind = tokens[prev_k].kind;\n817\t                            if prev_kind == REMIMU_KIND_OR {\n818\t                                k = (k as i32 + tokens[prev_k].pair_offset as i32 - 1) as u32;\n819\t                            } else if prev_kind == REMIMU_KIND_OPEN || prev_kind == REMIMU_KIND_NCOPEN {\n820\t                                k = (k as i32 + tokens[prev_k].mask[15] as i32 - 1) as u32;\n821\t                            }\n822\t                        }\n823\t\n824\t                        if tokens[k as usize].kind == REMIMU_KIND_END {\n825\t                            return None; // -3\n826\t                        }\n827\t\n828\t                        if tokens[k as usize].kind == REMIMU_KIND_CLOSE {\n829\t                            let m0 = tokens[k as usize].mask[0] as usize;\n830\t                            if tokens[k as usize].count_lo == 0 || q_group_accepts_zero[m0] != 0 {\n831\t                                q_group_state[m0] = 0;\n832\t                                if (tokens[k as usize].mode & REMIMU_MODE_LAZY) == 0 {\n833\t                                    q_group_stack[m0] = 0;\n834\t                                }\n835\t                                iteration_should_continue = true;\n836\t                            } else {\n837\t                                if !rewind_or_abort(&mut rewind_stack, &mut just_rewinded, &mut range_min, &mut range_max, &mut i, &mut k, tokens, &mut q_group_state, &mut q_group_stack) {\n838\t                                    return None;\n839\t                                }\n840\t                                iteration_should_continue = true;\n841\t                            }\n842\t                        } else {\n843\t                            // assert tokens[k].kind == OR\n844\t                            // proceed below\n845\t                        }\n846\t                    }\n847\t\n848\t                    if !iteration_should_continue {\n849\t                        let k_diff = (k as i64) - orig_k;\n850\t                        range_min = (k_diff + 1) as u64;\n851\t\n852\t                        if !rewind_save(&mut rewind_stack, stack_size_max, (k as i64 - k_diff) as u32, i, range_min, range_max, false, tokens, &mut q_group_state, &mut q_group_stack) {\n853\t                            return None;\n854\t                        }\n855\t                    }\n856\t                }\n857\t            } else if kind == REMIMU_KIND_CLOSE {\n858\t                let m0 = tokens[k as usize].mask[0] as usize;\n859\t\n860\t                // unquantified\n861\t                if tokens[k as usize].count_lo == 1 && tokens[k as usize].count_hi == 2 {\n862\t                    let cap_index = q_group_cap_index[m0];\n863\t                    if cap_index != 0xFFFF {\n864\t                        if !rewind_save(&mut rewind_stack, stack_size_max, k, i, range_min, range_max, true, tokens, &mut q_group_state, &mut q_group_stack) {\n865\t                            return None;\n866\t                        }\n867\t                    }\n868\t                } else {\n869\t                    // quantified\n870\t                    if just_rewinded == 0 {\n871\t                        let prev = q_group_stack[m0];\n872\t\n873\t                        range_max = tokens[k as usize].count_hi as u64;\n874\t                        range_max = range_max.wrapping_sub(1);\n875\t                        range_min = if q_group_accepts_zero[m0] != 0 { 0 } else { tokens[k as usize].count_lo as u64 };\n876\t\n877\t                        // minimum requirement not yet met\n878\t                        if (q_group_state[m0] as u64) + 1 < range_min {\n879\t                            q_group_state[m0] += 1;\n880\t                            if !rewind_save(&mut rewind_stack, stack_size_max, k, i, range_min, range_max, false, tokens, &mut q_group_state, &mut q_group_stack) {\n881\t                                return None;\n882\t                            }\n883\t                            k = (k as i32 + tokens[k as usize].pair_offset as i32) as u32;\n884\t                            // k -= 1 to ensure we hit the group node next\n8