    assert_eq!(m, Some(6));\n    assert_eq!(cp[0], 0); assert_eq!(cs[0], 6);\n    assert_eq!(cp[1], 3); assert_eq!(cs[1], 3);\n\n    // ((a)|(b))++ - possessive: no inner capture data\n    let (m, cp, cs) = match_with_caps(\"((a)|(b))++\", \"aaaaaabbbabaqa\", 5);\n    assert_eq!(m, Some(12));\n    assert_eq!(cp[0], 0); assert_eq!(cs[0], 12); // whole match still captured\n    assert_eq!(cp[1], -1); assert_eq!(cs[1], -1); // possessive: no data\n    assert_eq!(cp[2], -1); assert_eq!(cs[2], -1);\n    assert_eq!(cp[3], -1); assert_eq!(cs[3], -1);\n    assert_eq!(cp[4], -1); assert_eq!(cs[4], -1);\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":484,"cache_read_input_tokens":131310,"cache_creation":{"ephemeral_5m_input_tokens":484,"ephemeral_1h_input_tokens":0},"output_tokens":23,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e298ebc4-2d7e-4a4f-8879-892213f222f9","uuid":"9e58bec9-d7ca-4c3f-88d4-545ec246816a"}
