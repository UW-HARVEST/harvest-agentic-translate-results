struction, \"var\") == 0) {\n115\t        if (*state == INSIDE_INNER_MODULES) {\n116\t            fscanf(file, \" %*[^\\n]\\n\");\n117\t            return true;\n118\t        }\n119\t\n120\t        signal_t *signal = &vcd->signals[vcd->signals_count];\n121\t        vcd->signals_count += 1;\n122\t\n123\t        char signal_id[VCD_NAME_SIZE];\n124\t        fscanf(file, \" %*s %zu %[^ ] %[^ $]%*[^$]\", &signal->size, signal_id, signal->name);\n125\t        int index = get_signal_index(signal_id);\n126\t\n127\t        /* This signal is an alias. */\n128\t        if (vcd->signals[index].size != 0)\n129\t            return true;\n130\t\n131\t        return true;\n132\t    }\n133\t\n134\t    if (strcmp(instruction, \"date\") == 0) {\n135\t        fscanf(file, \"\\n%[^$\\n]\", vcd->date);\n136\t        return true;\n137\t    }\n138\t\n139\t    if (strcmp(instruction, \"version\") == 0) {\n140\t        fscanf(file, \"\\n%[^$\\n]\", vcd->version);\n141\t        return true;\n142\t    }\n143\t\n144\t    if (strcmp(instruction, \"timescale\") == 0) {\n145\t        fscanf(file, \"\\n\\t%zu%[^$\\n]\", &vcd->timescale.scale, vcd->timescale.unit);\n146\t        return true;\n147\t    }\n148\t\n149\t    return false;\n150\t}\n151\t\n152\tbool parse_timestamp(FILE *file, timestamp_t *timestamp) {\n153\t    bool successful = fscanf(file, \"%u\", timestamp) == 1;\n154\t    return successful;\n155\t}\n156\t\n157\tbool parse_assignment(FILE *file, vcd_t *vcd, timestamp_t timestamp) {\n158\t    char buffer[BUFFER_LENGTH];\n159\t    char value[VCD_SIGNAL_SIZE];\n160\t    char signal_id[VCD_NAME_SIZE];\n161\t    fscanf(file, \"%[^\\n]\", buffer);\n162\t\n163\t    bool is_vector = strchr(\"01xXzZ\", buffer[0]) == NULL;\n164\t    char *assignment_format_string = is_vector ? \"%[^ ] %[^\\n]\" : \"%1s%[^\\n]\";\n165\t    if (sscanf(buffer, assignment_format_string, value, signal_id) != 2)\n166\t        return false;\n167\t\n168\t    /* For now, we ignore longer signal ids. */\n169\t    if (strl