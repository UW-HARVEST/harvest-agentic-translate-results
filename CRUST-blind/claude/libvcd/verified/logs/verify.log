   }\n277\t\n278\t            // Discard everything up to the next `$` (e.g., `[8:0] `).\n279\t            read_until_dollar(file);\n280\t\n281\t            // The C code allocates the signal at position `signals_count` and\n282\t            // then performs an alias check that is effectively a no-op (it\n283\t            // just returns true regardless). We mirror that by always pushing.\n284\t            let _ = signal_id;\n285\t\n286\t            let mut signal = Signal {\n287\t                name: [0u8; VCD_NAME_SIZE],\n288\t                size,\n289\t                value_changes: Vec::new(),\n290\t            };\n291\t            copy_into_fixed(&mut signal.name, name.as_bytes());\n292\t            vcd.signals.push(signal);\n293\t            Ok(())\n294\t        }\n295\t        \"date\" => {\n296\t            let date = read_field_until_dollar_or_newline(file);\n297\t            copy_into_fixed(&mut vcd.date, date.as_bytes());\n298\t            Ok(())\n299\t        }\n300\t        \"version\" => {\n301\t            let version = read_field_until_dollar_or_newline(file);\n302\t            copy_into_fixed(&mut vcd.version, version.as_bytes());\n303\t            Ok(())\n304\t        }\n305\t        \"timescale\" => {\n306\t            // Format: \" %zu%[^$\\n]\" — skip whitespace, parse a usize, then\n307\t            // capture the remaining unit string up to `$` or newline.\n308\t            let first = skip_whitespace(file).ok_or_else(|| io_err(\"timescale: empty\"))?;\n309\t            if !first.is_ascii_digit() {\n310\t                return Err(io_err(\"timescale: scale not a digit\"));\n311\t            }\n312\t            let mut digits = String::new();\n313\t            digits.push(first as char);\n314\t            while let Some(b) = read_byte(file) {\n315\t                if b.is_ascii_digit() {\n316\t                    digits.push(b as char);\n317\t                } else {\n318\t                    unget_byte(file);\n319\t                    break;