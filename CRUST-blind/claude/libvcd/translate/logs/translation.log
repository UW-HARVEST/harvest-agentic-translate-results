  let index = match get_signal_index(&signal_id) {","+        Some(i) => i,","+        None => return Ok(()),","+    };","+    if index >= vcd.signals.len() {","+        return Ok(());","+    }","+","+    let mut value_array = [0u8; VCD_SIGNAL_SIZE];","+    let value_bytes = value.as_bytes();","+    let copy_len = value_bytes.len().min(VCD_SIGNAL_SIZE);","+    value_array[..copy_len].copy_from_slice(&value_bytes[..copy_len]);","+","+    if vcd.signals[index].value_changes.len() < VCD_VALUE_CHANGE_COUNT {","+        vcd.signals[index].value_changes.push(ValueChange {","+            timestamp: *timestamp,","+            value: value_array,","+        });","+    }","+","+    Ok(())"," }"," pub fn get_signal_index(s: &str) -> Option<usize> {","-    unimplemented!()","-}","\\ No newline at end of file","+    let bytes = s.as_bytes();","+    if bytes.is_empty() {","+        return None;","+    }","+    let id = (bytes[0] as i32) - (b'!' as i32);","+    if id < 0 || id >= VCD_SIGNAL_COUNT as i32 {","+        return None;","+    }","+    Some(id as usize)","+}"]}],"originalFile":"use std::fs::File;\npub fn isexpression(c: char) -> bool {\n    match c {\n        '-' | '0'..='9' | 'z' | 'Z' | 'x' | 'X' | 'b' | 'U' => true,\n        _ => false,\n    }\n}\npub const VCD_SIGNAL_COUNT: usize = 32;\npub const VCD_VALUE_CHANGE_COUNT: usize = 4096;\npub const VCD_SIGNAL_SIZE: usize = 64;\npub const VCD_NAME_SIZE: usize = 32;\npub const VCD_TIME_UNIT_SIZE: usize = 8;\npub const VCD_VERSION_SIZE: usize = 64;\npub const VCD_DATE_SIZE: usize = 64;\npub type Timestamp = u32;\n#[derive(Debug, Clone, Copy)]\npub struct ValueChange {\n    pub timestamp: Timestamp,\n    pub value: [u8; VCD_SIGNAL_SIZE], // Fixed-size array instead of C char array\n}\n#[derive(Debug)]\npub struct Signal {\n    pub name: [u8; VCD_NAME_SIZE],\n    pub size: usize,\n    pub value_changes: Vec<ValueChange>,\n}\n#[derive(Debug)]\npub struct Timescale {\n    pub unit: [u8; VCD_TIME_UNIT_SIZE], // Fixed-size array r