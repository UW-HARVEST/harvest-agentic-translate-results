IT, true);\n    let bytes = tb.twobit_bases(\"chr1\", 75, 100, 0);\n    let cnts = parse_counts(&bytes);\n    assert_eq!(cnts, [6, 6, 7, 6]);\n}\n\n#[test]\nfn test_bases_chr2_0_50() {\n    let tb = TwoBit::twobit_open(FOO_2BIT, true);\n    let bytes = tb.twobit_bases(\"chr2\", 0, 50, 0);\n    let cnts = parse_counts(&bytes);\n    assert_eq!(cnts, [12, 12, 13, 13]);\n}\n\n#[test]\nfn test_bases_invalid_start_ge_end() {\n    let tb = TwoBit::twobit_open(FOO_2BIT, true);\n    let bytes = tb.twobit_bases(\"chr1\", 100, 50, 0);\n    assert!(bytes.is_empty());\n}\n\n#[test]\nfn test_bases_end_too_large() {\n    let tb = TwoBit::twobit_open(FOO_2BIT, true);\n    let bytes = tb.twobit_bases(\"chr1\", 0, 200, 0);\n    assert!(bytes.is_empty());\n}\n\n#[test]\nfn test_bases_missing_chrom() {\n    let tb = TwoBit::twobit_open(FOO_2BIT, true);\n    let bytes = tb.twobit_bases(\"chrX\", 0, 10, 0);\n    assert!(bytes.is_empty());\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3910,"cache_read_input_tokens":59438,"cache_creation":{"ephemeral_5m_input_tokens":3910,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f7411ccc-8d8d-466c-a330-9f64dad51e45","uuid":"72f6add0-e241-4621-81e5-4a7afd325ead"}
