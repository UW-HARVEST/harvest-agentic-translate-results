sk_block_start[tid_u][i];\n219\t            let block_size = self.idx.mask_block_sizes[tid_u][i];\n220\t            let mut block_end = block_start + block_size;\n221\t            if block_end <= start {\n222\t                continue;\n223\t            }\n224\t            if block_start >= end {\n225\t                break;\n226\t            }\n227\t            let pos: u32;\n228\t            let width: u32;\n229\t            if block_start < start {\n230\t                if block_end > end {\n231\t                    block_end = end;\n232\t                }\n233\t                pos = 0;\n234\t                width = block_end - start;\n235\t            } else {\n236\t                if block_end > end {\n237\t                    block_end = end;\n238\t                }\n239\t                pos = block_start - start;\n240\t                width = block_end - block_start;\n241\t            }\n242\t            let total = pos + width;\n243\t            let mut p = pos;\n244\t            while p < total {\n245\t                let idx = p as usize;\n246\t                if idx < seq.len() && seq[idx] != 'N' {\n247\t                    seq[idx] = seq[idx].to_ascii_lowercase();\n248\t                }\n249\t                p += 1;\n250\t            }\n251\t        }\n252\t    }\n253\t    pub fn constructSequence(&mut self, tid: u32, start: u32, end: u32) -> Vec<char> {\n254\t        self.construct_sequence_internal(tid, start, end)\n255\t    }\n256\t    pub fn getMask(&mut self, _tid: u32, _start: u32, _end: u32) -> (u32, u32, u32) {\n257\t        (U32_INVALID, U32_INVALID, U32_INVALID)\n258\t    }\n259\t    pub fn twoBitBasesWorker(&mut self, _tid: u32, _start: u32, _end: u32, _fraction: i32) {\n260\t        // The actual base counting is done internally via bases_worker_internal,\n261\t        // because the public signature returns () and cannot return the result.\n262\t    }\n263\t    pub fn twoBitIndexRead(&mut self, storeMasked: i32) {\n264\t        let n_chroms = self.hdr.n_chroms as usize;\n265\t        let mut size: Vec<u32> = Vec::with_capacity(n_chroms);\n266\t        let mut n_block_count: Vec<u32> = Vec::with_capacity(n_chroms);\n267\t        let mut n_block_start: Vec<Vec<u32>> = Vec::with_capacity(n_chroms);\n268\t        let mut n_block_sizes: Vec<Vec<u32>> = Vec::with_capacity(n_chroms);\n269\t        let mut mask_block_count: Vec<u32> = Vec::with_capacity(n_chroms);\n270\t        let mut mask_block_start: Vec<Vec<u32>> = Vec::with_capacity(n_chroms);\n271\t        let mut mask_block_sizes: Vec<Vec<u32>> = Vec::with_capacity(n_chroms);\n272\t        let mut offset_vec: Vec<u64> = Vec::with_capacity(n_chroms);\n273\t\n274\t        for i in 0..n_chroms {\n275\t            let chrom_off = self.cl.offset[i] as u64;\n276\t            self.offset = chrom_off;\n277\t            let sz = match self.read_u32() {\n278\t                Some(v) => v,\n279\t                None => return,\n280\t            };\n281\t            let nbc = match self.read_u32() {\n282\t                Some(v) => v,\n283\t                None => return,\n284\t            };\n285\t            size.push(sz);\n286\t            n_block_count.push(nbc);\n287\t            let nstart = match self.read_u32_n(nbc as usize) {\n288\t                Some(v) => v,\n289\t                None => return,\n290\t            };\n291\t            let nsizes = match self.read_u32_n(nbc as usize) {\n292\t                Some(v) => v,\n293\t                None => return,\n294\t            };\n295\t            n_block_start.push(nstart);\n296\t            n_block_sizes.push(nsizes);\n297\t\n298\t            let mbc = match self.read_u32() {\n299\t                Some(v) => v,\n300\t                None => return,\n301\t            };\n302\t            mask_block_count.push(mbc);\n303\t\n304\t            if storeMasked != 0 {\n305\t                let mstart = match self.read_u32_n(mbc as usize) {\n306\t                    Some(v) => v,\n307\t                    None => return,\n308\t                };\n309\t                let msizes = match self.read_u32_n(mbc as usize) {\n310\t                    Some(v) => v,\n311\t                    None => return,\n312\t                };\n313\t                mask_block_start.push(mstart);\n314\t                mask_block_sizes.push(msizes);\n315\t            } else {\n316\t                let new_off = self.offset + 8 * (mbc as u64);\n317\t                if new_off > self.sz {\n318\t                    return;\n319\t                }\n320\t                self.offset = new_off;\n321\t            }\n322\t\n323\t            // Reserved\n324\t            let _reserved = match self.read_u32() {\n325\t                Some(v) => v,\n326\t                None => return,\n327\t            };\n328\t            offset_vec.push(self.offset);\n329\t        }\n330\t\n331\t        self.idx = TwoBitMaskedIdx {\n332\t            size,\n333\t            n_block_count,\n334\t            n_block_start,\n335\t            n_block_sizes,\n336\t            mask_block_count,\n337\t            mask_block_start,\n338\t            mask_block_sizes,\n339\t            offset: offset_vec,\n340\t        };\n341\t    }\n342\t    pub fn twoBitIndexDestroy(&mut self) {\n343\t        self.idx.size.clear();\n344\t        self.idx.n_block_count.clear();\n345\t        self.idx.n_block_start.clear();\n346\t        self.idx.n_block_sizes.clear();\n347\t        self.idx.mask_block_count.clear();\n348\t        self.idx.mask_block_start.clear();\n349\t        self.idx.mask_block_sizes.clear();\n350\t        self.idx.offset.clear();\n351\t    }\n352\t    pub fn twobitChromListRead(&mut self) {\n353\t        let n_chroms = self.hdr.n_chroms as usize;\n354\t        let mut chroms: Vec<String> = Vec::with_capacity(n_chroms);\n355\t        let mut offsets: Vec<u32> = Vec::with_capacity(n_chroms);\n356\t        for _ in 0..n_chroms {\n357\t            let len = match self.read_u8() {\n358\t                Some(v) => v as usize,\n359\t                None => return,\n360\t            };\n361\t            let bytes = match self.read_bytes(len) {\n362\t                Some(v) => v,\n363\t                None => return,\n364\t            };\n365\t            let s = match String::from_utf8(bytes) {\n366\t                Ok(v) => v,\n367\t                Err(_) => return,\n368\t            };\n369\t            chroms.push(s);\n370\t            let off = match self.read_u32() {\n371\t                Some(v) => v,\n372\t                None => return,\n373\t            };\n374\t            offsets.push(off);\n375\t        }\n376\t        self.cl = TwoBitCL {\n377\t            chrom: chroms,\n378\t            offset: offsets,\n379\t        };\n380\t    }\n381\t    pub fn twobitChromListDestroy(&mut self) {\n382\t        self.cl.chrom.clear();\n383\t        self.cl.offset.clear();\n384\t    }\n385\t    pub fn twobitHdrRead(&mut self) {\n386\t        let magic = match self.read_u32() {\n387\t            Some(v) => v,\n388\t            None => return,\n389\t        };\n390\t        let version = match self.read_u32() {\n391\t            Some(v) => v,\n392\t            None => return,\n393\t        };\n394\t        let n_chroms = match self.read_u32() {\n395\t            Some(v) => v,\n396\t            None => return,\n397\t        };\n398\t        // 4th uint32 is reserved\n399\t        let _reserved = match self.read_u32() {\n400\t            Some(v) => v,\n401\t            None => return,\n402\t        };\n403\t\n404\t        if magic != 0x1A412743 {\n405\t            eprintln!(\n406\t                \"[twobitHdrRead] Received an invalid file magic number (0x{:x})!\",\n407\t                magic\n408\t            );\n409\t            return;\n410\t        }\n411\t        if version != 0 {\n412\t            eprintln!(\n413\t                \"[twobitHdrRead] The file version is {} while only version 0 is defined!\",\n414\t                version\n415\t            );\n416\t            return;\n417\t        }\n418\t        if n_chroms == 0 {\n419\t            eprintln!(\n420\t                \"[twobitHdrRead] There are apparently no chromosomes/contigs in this file!\"\n421\t            );\n422\t            return;\n423\t        }\n424\t\n425\t        self.hdr = TwoBitHeader {\n426\t            magic,\n427\t            version,\n428\t            n_chroms,\n429\t        };\n430\t    }\n431\t    pub fn twobitHdrDestroy(&mut self) {\n432\t        self.hdr.magic = 0;\n433\t        self.hdr.version = 0;\n434\t        self.hdr.n_chroms = 0;\n435\t    }\n436\t}\n437\t\n438\t// Private helper methods\n439\timpl TwoBit {\n440\t    fn read_u8(&mut self) -> Option<u8> {\n441\t        let off = self.offset as usize;\n442\t        if off >= self.data.len() {\n443\t            return None;\n444\t        }\n445\t        let v = self.data[off];\n446\t        self.offset += 1;\n447\t        Some(v)\n448\t    }\n449\t    fn read_u32(&mut self) -> Option<u32> {\n450\t        let off = self.offset as usize;\n451\t        if off + 4 > self.data.len() {\n452\t            return None;\n453\t        }\n454\t        let v = u32::from_le_bytes(self.data[off..off + 4].try_into().unwrap());\n455\t        self.offset += 4;\n456\t        Some(v)\n457\t    }\n458\t    fn read_u32_n(&mut self, n: usize) -> Option<Vec<u32>> {\n459\t        let mut out = Vec::with_capacity(n);\n460\t        for _ in 0..n {\n461\t            out.push(self.read_u32()?);\n462\t        }\n463\t        Some(out)\n464\t    }\n465\t    fn read_bytes(&mut self, n: usize) -> Option<Vec<u8>> {\n466\t        let off = self.offset as usize;\n467\t        if off + n > self.data.len() {\n468\t            return None;\n469\t        }\n470\t        let v = self.data[off..off + n].to_vec();\n471\t        self.offset += n as u64;\n472\t        Some(v)\n473\t    }\n474\t\n475\t    fn construct_sequence_internal(&self, tid: u32, start: u32, end: u32) -> Vec<char> {\n476\t        let tid_u = tid as usize;\n477\t        let sz = (end - start + 1) as usize;\n478\t        let mut seq: Vec<char> = vec!['\\0'; sz];\n479\t\n480\t        // 4 bases per byte\n481\t        let block_start = start / 4;\n482\t        let offset = (start % 4) as i32;\n483\t        let block_end = end / 4 + if end % 4 != 0 { 1 } else { 0 };\n484\t        let byte_count = (block_end - block_start) as usize;\n485\t        let read_off = (self.idx.offset[tid_u] + block_start as u64) as usize;\n486\t        if read_off + byte_count > self.data.len() {\n487\t            return Vec::new();\n488\t        }\n489\t        let mut bytes = self.data[read_off..read_off + byte_count].to_vec();\n490\t\n491\t        bytes2bases(&mut seq, &mut bytes, (sz - 1) as u32, offset);\n492\t        // null-terminator slot is the last char; we'll truncate before returning\n493\t\n494\t        // N-mask\n495\t        n_mask_static(&mut seq[..sz - 1], &self.idx, tid, start, end);\n496\t        // soft-mask\n497\t        soft_mask_static(&mut seq[..sz - 1], &self.idx, tid, start, end);\n498\t\n499\t        // Drop the trailing null char to give the caller a clean string-of-bases\n500\t        seq.truncate(sz - 1);\n501\t        seq\n502\t    }\n503\t\n504\t    fn bases_worker_internal(&self, tid: u32, start: u32, end: u32, fraction: i32) -> Vec<u8> {\n505\t        let tid_u = tid as usize;\n506\t        let mut tmp: [u32; 4] = [0; 4];\n507\t        let mut start = start;\n508\t        let len = end - start + (start % 4);\n509\t        let seq_len = end - start;\n510\t        let block_start = start / 4;\n511\t        let mut offset: u32 = start % 4;\n512\t        let block_end = end / 4 + if end % 4 != 0 { 1 } else { 0 };\n513\t        let byte_count = (block_end - block_start) as usize;\n514\t        let read_off = (self.idx.offset[tid_u] + block_start as u64) as usize;\n515\t        if read_off + byte_count > self.data.len() {\n516\t            return Vec::new();\n517\t        }\n518\t        let bytes = &self.data[read_off..read_off + byte_count];\n519\t\n520\t        let mut mask: u8 = get_byte_mask_from_offset_internal(offset as i32);\n521\t        start = 4 * block_start;\n522\t        offset = 0;\n523\t\n524\t        let mut mask_idx: u32 = U32_INVALID;\n525\t        let mut mask_start: u32 = U32_INVALID;\n526\t        let mut mask_end: u32 = U32_INVALID;\n527\t\n528\t        get_mask_static(\n529\t            &self.idx,\n530\t            tid,\n531\t            start,\n532\t            end,\n533\t            &mut mask_idx,\n534\t            &mut mask_start,\n535\t            &mut mask_end,\n536\t        );\n537\t\n538\t        let mut i: u32 = 0;\n539\t        let mut j: u32 = 0;\n540\t\n541\t        while i < len {\n542\t            // Check whether we need to jump\n543\t            if mask_idx != U32_INVALID && start + i + 4 >= mask_start {\n544\t                if start + i >= mask_start || start + i + 4 - offset > mask_start {\n545\t                    // Jump iff the whole byte is inside an N block\n546\t                    if start + i >= mask_start && start + i + 4 - offset < mask_end {\n547\t                        i = mask_end - start;\n548\t                        get_mask_static(\n549\t                            &self.idx,\n550\t                            tid,\n551\t                            i,\n552\t                            end,\n553\t                            &mut mask_idx,\n554\t                            &mut mask_start,\n555\t                            &mut mask_end,\n556\t                        );\n557\t                        offset = (start + i) % 4;\n558\t                        j = i / 4;\n559\t                        mask = get_byte_mask_from_offset_internal(offset as i32);\n560\t                        i = 4 * j;\n561\t                        offset = 0;\n562\t                        continue;\n563\t                    }\n564\t\n565\t                    // Set the mask, if appropriate\n566\t                    let foo = 4 * j + 4 * block_start;\n567\t                    if (mask & 1) != 0 && (foo + 3 >= mask_start && foo + 3 < mask_end) {\n568\t                        mask -= 1;\n569\t                    }\n570\t                    if (mask & 2) != 0 && (foo + 2 >= mask_start && foo + 2 < mask_end) {\n571\t                        mask -= 2;\n572\t                    }\n573\t                    if (mask & 4) != 0 && (foo + 1 >= mask_start && foo + 1 < mask_end) {\n574\t                        mask -= 4;\n575\t                    }\n576\t                    if (mask & 8) != 0 && (foo >= mask_start && foo < mask_end) {\n577\t                        mask -= 8;\n578\t                    }\n579\t                    if foo + 4 > mask_end {\n580\t                        get_mask_static(\n581\t                            &self.idx,\n582\t                            tid,\n583\t                            i,\n584\t                            end,\n585\t                            &mut mask_idx,\n586\t                            &mut mask_start,\n587\t                            &mut mask_end,\n588\t                        );\n589\t                        continue;\n590\t                    }\n591\t                }\n592\t            }\n593\t\n594\t            // Mask anything past the end\n595\t            if i + 4 >= len {\n596\t                if (mask & 1) != 0 && i + 3 >= len {\n597\t                    mask -= 1;\n598\t                }\n599\t                if (mask & 2) != 0 && i + 2 >= len {\n600\t                    mask -= 2;\n601\t                }\n602\t                if (mask & 4) != 0 && i + 1 >= len {\n603\t                    mask -= 4;\n604\t                }\n605\t                if (mask & 8) != 0 && i >= len {\n606\t                    mask -= 8;\n607\t                }\n608\t            }\n609\t\n610\t            let mut foo: u32 = bytes[j as usize] as u32;\n611\t            j += 1;\n612\t            // Offset 3\n613\t            if (mask & 1) != 0 {\n614\t                tmp[(foo & 3) as usize] += 1;\n615\t            }\n616\t            foo >>= 2;\n617\t            mask >>= 1;\n618\t            // Offset 2\n619\t            if (mask & 1) != 0 {\n620\t                tmp[(foo & 3) as usize] += 1;\n621\t            }\n622\t            foo >>= 2;\n623\t            mask >>= 1;\n624\t            // Offset 1\n625\t            if (mask & 1) != 0 {\n626\t                tmp[(foo & 3) as usize] += 1;\n627\t            }\n628\t            foo >>= 2;\n629\t            mask >>= 1;\n630\t            // Offset 0\n631\t            if (mask & 1) != 0 {\n632\t                tmp[(foo & 3) as usize] += 1;\n633\t            }\n634\t            i += 4;\n635\t            mask = 15;\n636\t        }\n637\t\n638\t        // 2bit storage order is TCAG, but the public API exposes ACTG.\n639\t        let mut out: Vec<u8> = Vec::new();\n640\t        if fraction != 0 {\n641\t            let seq_len_f = seq_len as f64;\n642\t            let a = (tmp[2] as f64) / seq_len_f;\n643\t            let c = (tmp[1] as f64) / seq_len_f;\n644\t            let t = (tmp[0] as f64) / seq_len_f;\n645\t            let g = (tmp[3] as f64) / seq_len_f;\n646\t            out.extend_from_slice(&a.to_le_bytes());\n647\t            out.extend_from_slice(&c.to_le_bytes());\n648\t            out.extend_from_slice(&t.to_le_bytes());\n649\t            out.extend_from_slice(&g.to_le_bytes());\n650\t        } else {\n651\t            out.extend_from_slice(&tmp[2].to_le_bytes());\n652\t            out.extend_from_slice(&tmp[1].to_le_bytes());\n653\t            out.extend_from_slice(&tmp[0].to_le_bytes());\n654\t            out.extend_from_slice(&tmp[3].to_le_bytes());\n655\t        }\n656\t        out\n657\t    }\n658\t}\n659\t\n660\t// --- helper functions (free / module-level) ---\n661\t\n662\tfn n_mask_static(seq: &mut [char], idx: &TwoBitMaskedIdx, tid: u32, start: u32, end: u32) {\n663\t    let tid_u = tid as usize;\n664\t    if tid_u >= idx.n_block_count.len() {\n665\t        return;\n666\t    }\n667\t    let count = idx.n_block_count[tid_u] as usize;\n668\t    for i in 0..count {\n669\t        let block_start = idx.n_block_start[tid_u][i];\n670\t        let block_size = idx.n_block_sizes[tid_u][i];\n671\t        let mut block_end = block_start + block_size;\n672\t        if block_end <= start {\n673\t            continue;\n674\t        }\n675\t        if block_start >= end {\n676\t            break;\n677\t        }\n678\t        let pos: u32;\n679\t        let width: u32;\n680\t        if block_start < start {\n681\t            if block_end > end {\n682\t                block_end = end;\n683\t            }\n684\t            pos = 0;\n685\t            width = block_end - start;\n686\t        } else {\n687\t            if block_end > end {\n688\t                block_end = end;\n689\t            }\n690\t            pos = block_start - start;\n691\t            width = block_end - block_start;\n692\t        }\n693\t        let total = pos + width;\n694\t        let mut p = pos;\n695\t        while p < total {\n696\t            let pi = p as usize;\n697\t            if pi < seq.len() {\n698\t                seq[pi] = 'N';\n699\t            }\n700\t            p += 1;\n701\t        }\n702\t    }\n703\t}\n704\t\n705\tfn soft_mask_static(seq: &mut [char], idx: &TwoBitMaskedIdx, tid: u32, start: u32, end: u32) {\n706\t    if idx.mask_block_start.is_empty() {\n707\t        return;\n708\t    }\n709\t    let tid_u = tid as usize;\n710\t    if tid_u >= idx.mask_block_count.len() || tid_u >= idx.mask_block_start.len() {\n711\t        return;\n712\t    }\n713\t    let count = idx.mask_block_count[tid_u] as usize;\n714\t    for i in 0..count {\n715\t        if i >= idx.mask_block_start[tid_u].len() {\n716\t            break;\n717\t        }\n718\t        let block_start = idx.mask_block_start[tid_u][i];\n719\t        let block_size = idx.mask_block_sizes[tid_u][i];\n720\t        let mut block_end = block_start + block_size;\n721\t        if block_end <= start {\n722\t            continue;\n723\t        }\n724\t        if block_start >= end {\n725\t            break;\n726\t        }\n727\t        let pos: u32;\n728\t        let width: u32;\n729\t        if block_start < start {\n730\t            if block_end > end {\n731\t                block_end = end;\n732\t            }\n733\t            pos = 0;\n734\t            width = block_end - start;\n735\t        } else {\n736\t            if block_end > end {\n737\t                block_end = end;\n738\t            }\n739\t            pos = block_start - start;\n740\t            width = block_end - block_start;\n741\t        }\n742\t        let total = pos + width;\n743\t        let mut p = pos;\n744\t        while p < total {\n745\t            let pi = p as usize;\n746\t            if pi < seq.len() && seq[pi] != 'N' {\n747\t                seq[pi] = seq[pi].to_ascii_lowercase();\n748\t            }\n749\t            p += 1;\n750\t        }\n751\t    }\n752\t}\n753\t\n754\tfn get_mask_static(\n755\t    idx: &TwoBitMaskedIdx,\n756\t    tid: u32,\n757\t    start: u32,\n758\t    end: u32,\n759\t    mask_idx: &mut u32,\n760\t    mask_start: &mut u32,\n761\t    mask_end: &mut u32,\n762\t) {\n763\t    let tid_u = tid as usize;\n764\t    let n_block_count = if tid_u < idx.n_block_count.len() {\n765\t        idx.n_block_count[tid_u]\n766\t    } else {\n767\t        0\n768\t    };\n769\t\n770\t    if *mask_idx == U32_INVALID {\n771\t        let mut mi: u32 = 0;\n772\t        while mi < n_block_count {\n773\t            *mask_start = idx.n_block_start[tid_u][mi as usize];\n774\t            *mask_end = *mask_start + idx.n_block_sizes[tid_u][mi as usize];\n775\t            if *mask_end < start {\n776\t                mi += 1;\n777\t                continue;\n778\t            }\n779\t            // *mask_end >= start\n780\t            *mask_idx = mi;\n781\t            break;\n782\t        }\n783\t        if mi >= n_block_count {\n784\t            *mask_idx = mi;\n785\t        }\n786\t    } else if *mask_idx >= n_block_count {\n787\t        *m