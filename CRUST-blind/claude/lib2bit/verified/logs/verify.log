ount: Vec::new(),\n62\t                n_block_start: Vec::new(),\n63\t                n_block_sizes: Vec::new(),\n64\t                mask_block_count: Vec::new(),\n65\t                mask_block_start: Vec::new(),\n66\t                mask_block_sizes: Vec::new(),\n67\t                offset: Vec::new(),\n68\t            },\n69\t        };\n70\t        tb.twobitHdrRead();\n71\t        tb.twobitChromListRead();\n72\t        tb.twoBitIndexRead(if store_masked { 1 } else { 0 });\n73\t        tb\n74\t    }\n75\t    pub fn twobit_close(&mut self) {\n76\t        self.twobitChromListDestroy();\n77\t        self.twoBitIndexDestroy();\n78\t        self.twobitHdrDestroy();\n79\t    }\n80\t    pub fn twobit_chrom_len(&self, chrom: &str) -> u32 {\n81\t        let n_chroms = self.hdr.n_chroms as usize;\n82\t        for i in 0..n_chroms {\n83\t            if i < self.cl.chrom.len() && self.cl.chrom[i] == chrom {\n84\t                if i < self.idx.size.len() {\n85\t                    return self.idx.size[i];\n86\t                }\n87\t                return 0;\n88\t            }\n89\t        }\n90\t        0\n91\t    }\n92\t    pub fn twobit_sequence(&self, chrom: &str, start: u32, end: u32) -> String {\n93\t        let mut tid: Option<u32> = None;\n94\t        for i in 0..self.hdr.n_chroms as usize {\n95\t            if i < self.cl.chrom.len() && self.cl.chrom[i] == chrom {\n96\t                tid = Some(i as u32);\n97\t                break;\n98\t            }\n99\t        }\n100\t        let tid = match tid {\n101\t            Some(t) => t,\n102\t            None => return String::new(),\n103\t        };\n104\t        let tid_u = tid as usize;\n105\t        let mut end = end;\n106\t        if start == 0 && end == 0 {\n107\t            end = self.idx.size[tid_u];\n108\t        }\n109\t        if end > self.idx.size[tid_u] {\n110\t            return String::new();\n111\t        }\n112\t        if start >= end {\n113\t            return String::new();\n114\t        }\n115\t