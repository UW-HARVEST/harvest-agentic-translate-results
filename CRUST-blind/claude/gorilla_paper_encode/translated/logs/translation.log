\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n32\t\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n33\t\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n34\t\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n35\t};\n36\tconst static u64 Nan = 0x7FF8000000000001;\n37\t\n38\tint bitwriter_init(bitwriter_t* w)\n39\t{\n40\t    assert(w);\n41\t    memset(w, 0, sizeof(*w));\n42\t    w->bit_count = 8;\n43\t    return 0;\n44\t}\n45\t\n46\tstatic int append_to_cache(bitwriter_t* w)\n47\t{\n48\t    if (w->pos > 1024 - 1)\n49\t            return -1;\n50\t    w->cache[w->pos] = w->byte;\n51\t    w->pos++;\n52\t    return 0;\n53\t}\n54\t\n55\tint write_bit(bitwriter_t* w, bool bit)\n56\t{\n57\t    if (bit) {\n58\t        w->byte |= 1 << (w->bit_count - 1);\n59\t    }\n60\t    w->bit_count--;\n61\t\n62\t    if (w->bit_count == 0) {\n63\t        if (append_to_cache(w) != 0)\n64\t                return -1;\n65\t        w->byte = 0;\n66\t        w->bit_count = 8;\n67\t    }\n68\t    return 0;\n69\t}\n70\t\n71\tint write_byte(bitwriter_t* w, u8 b) \n72\t{\n73\t    w->byte |= b >> (8 - w->bit_count);\n74\t    if (append_to_cache(w) != 0)\n75\t            return -1;\n76\t    w->byte = b << w->bit_count;\n77\t    return 0;\n78\t}\n79\t\n80\tint write_bits(bitwriter_t* w, u64 u, int nbits)\n81\t{\n82\t    if (nbits > 64 || nbits < 0)\n83\t        return -1;\n84\t\n85\t    u8 byte = 0;\n86\t    u <<= (64 - nbits);\n87\t    while (nbits >= 8) {\n88\t        byte = u >> 56;\n89\t        if (write_byte(w, byte) != 0)\n90\t            return -1;\n91\t        u <<= 8;\n92\t        nbits -= 8;\n93\t    }\n94\t\n95\t    while (nbits > 0) {\n96\t        if (write_bit(w, u >> 63) != 0)\n97\t            return -2;\n98\t        u <<= 1;\n99\t        nbits--;\n100\t    }\n101\t    return 0;\n102\t}\n103\t\n104\tint write_flush(bitwriter_t* w, bool bit)\n105\t{\n106\t    while (w->bit_count != 8) {\n107\t        if (write_bit(w, bit) != 0)\n108\t            return -1;\n109\t    }\n110\t    return 0;\n111\t}\n112\tint float_encoder_init(float_encoder_t* s)\n113\t{\n114\t    assert(s);\n115\t    memset(s, 0, sizeof(*s));\n116\t\n117\t    bitwriter_init(&s->w);\n118\t    s->first = true;\n119\t    s->leading = ~0;\n120\t    write_byte(&s->w, 0x10);\n121\t    return 0;\n122\t}\n123\t\n124\tint bitslen(u64 x) \n125\t{\n126\t    int n = 0;\n127\t    if (x >= ((u64)1<<32)) {\n128\t        x >>= 32;\n129\t        n = 32;\n130\t    }\n131\t    if (x >= 1<<16) {\n132\t        x >>= 16;\n133\t        n += 16;\n134\t    }\n135\t    if (x >= 1<<8) {\n136\t        x >>= 8;\n137\t        n += 8;\n138\t    }\n139\t    return n + len8_tab[x];   \n140\t}\n141\t\n142\tint leading_zero64(u64 u)\n143\t{\n144\t    return 64 - bitslen(u);\n145\t}\n146\t\n147\t\n148\tint trailing_zero64(u64 u)\n149\t{\n150\t    if (u == 0)\n151\t        return 64;\n152\t\n153\t    return de_bruijn64_tab[(u&-u)*de_bruijn64 >> (64 - 6)];\n154\t}\n155\t\n156\tint float_encode_write(float_encoder_t* s, f64 v)\n157\t{\n158\t    u64* vp = (u64*)&v;\n159\t    if (s->first) {\n160\t        s->val = *vp;\n161\t        s->first = false;\n162\t        write_bits(&s->w, *vp, 64);\n163\t        return 0;\n164\t    }\n165\t\n166\t    u64 vdelta = *vp ^ s->val;\n167\t\n168\t    if (vdelta == 0) {\n169\t        write_bit(&s->w, 0);\n170\t    }\n171\t    else {\n172\t        write_bit(&s->w, 1);\n173\t    }\n174\t\n175\t    u64 leading = leading_zero64(vdelta);\n176\t    u64 trailing = trailing_zero64(vdelta);\n177\t\n178\t    leading &= 0x1F;\n179\t    if (leading >= 32)\n180\t        leading = 31;\n181\t\n182\t    if (s->leading != ~0 && leading > s->leading &&\n183\t        trailing >= s->trailing) {\n184\t        write_bit(&s->w, 0);\n185\t        write_bits(&s->w, vdelta >> s->trailing, \n186\t        64 - s->leading - s->trailing);\n187\t    }\n188\t    else {\n189\t        s->leading = leading;\n190\t        s->trailing = trailing;\n191\t        write_bit(&s->w, 1);\n192\t        write_bits(&s->w, leading, 5);\n193\t\n194\t        u64 sigbits = 64 -leading - trailing;\n195\t        write_bits(&s->w, sigbits, 6);\n196\t        write_bits(&s->w, vdelta >> trailing, sigbits);\n197\t    }\n198\t\n199\t    s->val = *vp;\n200\t    return 0;\n201\t}\n202\t\n203\t\n204\tint float_encode_flush(float_encoder_t* s, u8* dst, u32* length)\n205\t{\n206\t    f64* na = (f64*)&Nan;\n207\t    \n208\t    if (!s->finished) {\n209\t        s->finished = true;\n210\t        float_encode_write(s, *na);\n211\t        write_flush(&s->w, 0);\n212\t    }\n213\t\n214\t    *length = s->w.pos + 1;\n215\t    memcpy(dst, s->w.cache, s->w.pos + 1);\n216\t    return *length;\n217\t}\n218\t\n219\tint float_cache_print(float_encoder_t* s)\n220\t{\n221\t    int i = 0;\n222\t    u8 *a = s->w.cache;\n223\t    \n224\t    for (i = 0; i < s->w.pos + 1; i++) {\n225\t        printf(\"%02x \", a[i]);\n226\t        if ((i+1) % 16 == 0)\n227\t                printf(\"\\n\");\n228\t        else if ((i + 1) % 8 == 0)\n229\t                printf(\"  \");\n230\t    }\n231\t    printf(\"\\n\");\n232\t}\n233\t\n234\tint bit_readbuf(bitreader_t* br)\n235\t{\n236\t    u32 i = 0;\n237\t    u32 byte_n = 8 - (br->n / 8);\n238\t\n239\t    if (br->len && byte_n > br->len) {\n240\t        byte_n = br->len;\n241\t    }\n242\t\n243\t    if (byte_n == 8) {\n244\t        br->v = (u64)(br->data[7]) | (u64)(br->data[6])<<8 |\n245\t                (u64)(br->data[5])<<16 | (u64)(br->data[4])<<24 |\n246\t                (u64)(br->data[3])<<32 | (u64)(br->data[2])<<40 |\n247\t                (u64)(br->data[1])<<48 | (u64)(br->data[0])<<56;\n248\t        br->n = 64;\n249\t        br->data = br->data + 8;\n250\t        br->len = br->len - 8;\n251\t        return 0;\n252\t    }\n253\t\n254\t    for (i = 0; i < byte_n; i++) {\n255\t        br->n += 8;\n256\t        br->v |= (u64)(br->data[i]) << (64 - br->n);\n257\t    }\n258\t\n259\t    br->data = br->data + byte_n;\n260\t    br->len = br->len - byte_n;\n261\t    return 0;\n262\t}\n263\t\n264\tint bitread_reset(bitreader_t* br, u8* data, u32 len) \n265\t{\n266\t    br->data = data;\n267\t    br->len = len;\n268\t    br->n = 0;\n269\t    br->v = 0;\n270\t    bit_readbuf(br);\n271\t    return 0;\n272\t}\n273\t\n274\tu64 read_bits(bitreader_t* br, u32 nbits)\n275\t{\n276\t    u64 v = 0, n = 0;\n277\t    if (br->n == 0) {\n278\t        return ~0;\n279\t    }\n280\t\n281\t    if (nbits <= br->n) {\n282\t        if (nbits == 64) {\n283\t            v = br->v;\n284\t            br->n = 0;\n285\t            br->v = 0;\n286\t            bit_readbuf(br);\n287\t            return v;\n288\t        }\n289\t\n290\t        v = br->v >> (64 - nbits);\n291\t        br->v = br->v << nbits;\n292\t        br->n = br->n - nbits;\n293\t        if (br->n == 0) {\n294\t            bit_readbuf(br);\n295\t        }\n296\t        return v;\n297\t    }\n298\t\n299\t    //read all available bits in current buffer.\n300\t    v = br->v;\n301\t    n = br->n;\n302\t\n303\t    br->v = 0;\n304\t    br->n = 0;\n305\t    bit_readbuf(br);\n306\t\n307\t    // Append new buffer to previous buffer and shift to remove unnecessary bits.\n308\t    v |= (br->v >> n);\n309\t    v >>= 64 - nbits;\n310\t\n311\t    // Remove used bits from new buffer.\n312\t    u32 buf_n = nbits - n;\n313\t    if (buf_n > br->n) {\n314\t        buf_n = br->n;\n315\t    }\n316\t    br->v <<= buf_n;\n317\t    br->n -= buf_n;\n318\t\n319\t    if (br->n == 0) {\n320\t        bit_readbuf(br);\n321\t    }\n322\t\n323\t    return v;\n324\t}\n325\t\n326\tu64  read_bit(bitreader_t* br)\n327\t{\n328\t    return read_bits(br, 1);\n329\t}\n330\t\n331\tbool can_read_bitfast(bitreader_t* br)\n332\t{\n333\t    if (br->n > 1)\n334\t        return true;\n335\t    else\n336\t        return false;\n337\t}\n338\t\n339\tbool read_bitfast(bitreader_t* br)\n340\t{\n341\t    bool v = ((br->v & ((u64)1<<63)) != 0);\n342\t    br->v <<= 1;\n343\t    br->n -= 1;\n344\t    return v;\n345\t}\n346\t\n347\t// Next returns true if there are remaining values to read.\n348\tbool read_next(float_decoder_t* s)\n349\t{\n350\t    u64 v = 0;\n351\t    u64 bits, mbits, vbits;\n352\t    if (s->finished || s->err) {\n353\t        return false;\n354\t    }\n355\t\n356\t    if (s->first) {\n357\t        s->first = false;\n358\t        // mark as finished if there were no values.\n359\t        if (s->val == Nan) { // IsNaN\n360\t            s->finished = true;\n361\t            return false;\n362\t        }\n363\t        return true;\n364\t    }\n365\t\n366\t    // read compressed value\n367\t    bool abit;\n368\t    if (can_read_bitfast(&s->br)) {\n369\t        abit = read_bitfast(&s->br);\n370\t    } else if (v = read_bit(&s->br) == ~0) {\n371\t        s->err = 1;\n372\t        return false;\n373\t    } else {\n374\t        abit = v;\n375\t    }\n376\t\n377\t    if (abit) {\n378\t        bool bit;\n379\t        if (can_read_bitfast(&s->br)) {\n380\t            bit = read_bitfast(&s->br);\n381\t        } else if (v = read_bit(&s->br) == ~0) {\n382\t            s->err = 1;\n383\t            return false;\n384\t        } else {\n385\t            bit = v;\n386\t        }\n387\t\n388\t        if (!bit) {\n389\t            // reuse leading/trailing zero bits\n390\t            // it.leading, it.trailing = it.leading, it.trailing\n391\t            ;\n392\t        } else {\n393\t            bits = read_bits(&s->br, 5);\n394\t            if (bits == ~0) {\n395\t                s->err = 1;\n396\t                return false;\n397\t            }\n398\t            s->leading = bits;\n399\t\n400\t            bits = read_bits(&s->br, 6);\n401\t            if (bits == ~0) {\n402\t                s->err = 1;\n403\t                return false;\n404\t            }\n405\t            mbits = bits;\n406\t            // 0 significant bits here means we overflowed and we actually need 64;\n407\t            //see comment in encoder\n408\t            if (mbits == 0) {\n409\t                mbits = 64;\n410\t            }\n411\t            s->trailing = 64 - s->leading - mbits;\n412\t        }\n413\t\n414\t        mbits = 64 - s->leading - s->trailing;\n415\t        bits = read_bits(&s->br, mbits);\n416\t        if (bits == ~0) {\n417\t            s->err = 1;\n418\t            return false;\n419\t        }\n420\t\n421\t        vbits = s->val;\n422\t        vbits ^= (bits << s->trailing);\n423\t\n424\t        if (vbits == Nan) { // IsNaN\n425\t            s->finished = true;\n426\t            return false;\n427\t        }\n428\t        s->val = vbits;\n429\t    }\n430\t\n431\t    return true;\n432\t}\n433\t\n434\tint float_decode_setbytes(float_decoder_t* s,u8* data, u32 data_len)\n435\t{\n436\t    memset(s->b, 0, sizeof(s->b));\n437\t    memcpy(s->b, data, data_len);\n438\t\n439\t    bitread_reset(&s->br, s->b + 1, data_len - 1);\n440\t    u64 v = read_bits(&s->br, 64);\n441\t    if (v == ~0) {\n442\t        return -1;\n443\t    }\n444\t    s->val = v;\n445\t    s->leading = 0;\n446\t    s->trailing = 0;\n447\t    s->first = true;\n448\t    s->finished = false;\n449\t    s->err = false;\n450\t\n451\t    return 0;\n452\t}\n453\t\n454\tint float_decode_block(float_decoder_t* s, u8* data, u32 len, f64* res, u32* res_len)\n455\t{\n456\t    u32 cnt = 0;\n457\t    f64 val = 0.0;\n458\t    int ret = float_decode_setbytes(s, data, len);\n459\t    if (ret != 0) {\n460\t        printf(\"Error\\n\");\n461\t        return ret;\n462\t    }\n463\t\n464\t    while(read_next(s)) {\n465\t        val = *(f64*)(&s->val);\n466\t        //printf(\"%f\\n\", val);\n467\t        res[cnt] = val;\n468\t        cnt++;\n469\t        if (cnt > 20) {\n470\t            break;\n471\t        }\n472\t    }\n473\t    *res_len = cnt;\n474\t    if (s->err) {\n475\t        printf(\"Error when decode\\n\");\n476\t        return -1;\n477\t    }\n478\t\n479\t    return 0;\n480\t}\n481\t"}]},"parent_tool_use_id":null,"session_id":"a0e5a632-8fae-4885-b8b1-497aee3aaf8c","uuid":"48229c2f-d529-41bf-a370-475cad03040e","timestamp":"2026-05-29T10:48:14.452Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-uGyxuA/project/c_src/gorilla.c","content":"/* Author: kun_tsai  GuangZhou 2019 */\n/* E-mail: jacicson1987@163.com  */\n\n#include <stdio.h>\n#include <assert.h>\n#include <string.h>\n\n#include \"gorilla.h\"\n\nconst static u64 de_bruijn64 = 0x03f79d71b4ca8b09;\n\nconst static u8 de_bruijn64_tab[64] = {\n\t0, 1, 56, 2, 57, 49, 28, 3, 61, 58, 42, 50, 38, 29, 17, 4,\n\t62, 47, 59, 36, 45, 43, 51, 22, 53, 39, 33, 30, 24, 18, 12, 5,\n\t63, 55, 48, 27, 60, 41, 37, 16, 46, 35, 44, 21, 52, 32, 23, 11,\n\t54, 26, 40, 15, 34, 20, 31, 10, 25, 14, 19, 9, 13, 8, 7, 6,\n};\nconst static u8 len8_tab[256] = {\n\t0x00, 0x01, 0x02, 0x02, 0x03, 0x03, 0x03, 0x03, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04,\n\t0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05, 0x05,\n\t0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06,\n\t0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06, 0x06,\n\t0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07,\n\t0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07,\n\t0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07,\n\t0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07, 0x07,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n\t0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08, 0x08,\n};\nconst static u64 Nan = 0x7FF8000000000001;\n\nint bitwriter_init(bitwriter_t* w)\n{\n    assert(w);\n    memset(w, 0, sizeof(*w));\n    w->bit_count = 8;\n    return 0;\n}\n\nstatic int append_to_cache(bitwriter_t* w)\n{\n    if (w->pos > 1024 - 1)\n            return -1;\n    w->cache[w->pos] = w->byte;\n    w->pos++;\n    return 0;\n}\n\nint write_bit(bitwriter_t* w, bool bit)\n{\n    if (bit) {\n        w->byte |= 1 << (w->bit_count - 1);\n    }\n    w->bit_count--;\n\n    if (w->bit_count == 0) {\n        if (append_to_cache(w) != 0)\n                return -1;\n        w->byte = 0;\n        w->bit_count = 8;\n    }\n    return 0;\n}\n\nint write_byte(bitwriter_t* w, u8 b) \n{\n    w->byte |= b >> (8 - w->bit_count);\n    if (append_to_cache(w) != 0)\n            return -1;\n    w->byte = b << w->bit_count;\n    return 0;\n}\n\nint write_bits(bitwriter_t* w, u64 u, int nbits)\n{\n    if (nbits > 64 || nbits < 0)\n        return -1;\n\n    u8 byte = 0;\n    u <<= (64 - nbits);\n    while (nbits >= 8) {\n        byte = u >> 56;\n        if (write_byte(w, byte) != 0)\n            return -1;\n        u <<= 8;\n        nbits -= 8;\n    }\n\n    while (nbits > 0) {\n        if (write_bit(w, u >> 63) != 0)\n            return -2;\n        u <<= 1;\n        nbits--;\n    }\n    return 0;\n}\n\nint write_flush(bitwriter_t* w, bool bit)\n{\n    while (w->bit_count != 8) {\n        if (write_bit(w, bit) != 0)\n            return -1;\n    }\n    return 0;\n}\nint float_encoder_init(float_encoder_t* s)\n{\n    assert(s);\n    memset(s, 0, sizeof(*s));\n\n    bitwriter_init(&s->w);\n    s->first = true;\n    s->leading = ~0;\n    write_byte(&s->w, 0x10);\n    return 0;\n}\n\nint bitslen(u64 x) \n{\n    int n = 0;\n    if (x >= ((u64)1<<32)) {\n        x >>= 32;\n        n = 32;\n    }\n    if (x >= 1<<16) {\n        x >>= 16;\n        n += 16;\n    }\n    if (x >= 1<<8) {\n        x >>= 8;\n        n += 8;\n    }\n    return n + len8_tab[x];   \n}\n\nint leading_zero64(u64 u)\n{\n    return 64 - bitslen(u);\n}\n\n\nint trailing_zero64(u64 u)\n{\n    if (u == 0)\n        return 64;\n\n    return de_bruijn64_tab[(u&-u)*de_bruijn64 >> (64 - 6)];\n}\n\nint float_encode_write(float_encoder_t* s, f64 v)\n{\n    u64* vp = (u64*)&v;\n    if (s->first) {\n        s->val = *vp;\n        s->first = false;\n        write_bits(&s->w, *vp, 64);\n        return 0;\n    }\n\n    u64 vdelta = *vp ^ s->val;\n\n    if (vdelta == 0) {\n        write_bit(&s->w, 0);\n    }\n    else {\n        write_bit(&s->w, 1);\n    }\n\n    u64 leading = leading_zero64(vdelta);\n    u64 trailing = trailing_zero64(vdelta);\n\n    leading &= 0x1F;\n    if (leading >= 32)\n        leading = 31;\n\n    if (s->leading != ~0 && leading > s->leading &&\n        trailing >= s->trailing) {\n        write_bit(&s->w, 0);\n        write_bits(&s->w, vdelta >> s->trailing, \n        64 - s->leading - s->trailing);\n    }\n    else {\n        s->leading = leading;\n        s->trailing = trailing;\n        write_bit(&s->w, 1);\n        write_bits(&s->w, leading, 5);\n\n        u64 sigbits = 64 -leading - trailing;\n        write_bits(&s->w, sigbits, 6);\n        write_bits(&s->w, vdelta >> trailing, sigbits);\n    }\n\n    s->val = *vp;\n    return 0;\n}\n\n\nint float_encode_flush(float_encoder_t* s, u8* dst, u32* length)\n{\n    f64* na = (f64*)&Nan;\n    \n    if (!s->finished) {\n        s->finished = true;\n        float_encode_write(s, *na);\n        write_flush(&s->w, 0);\n    }\n\n    *length = s->w.pos + 1;\n    memcpy(dst, s->w.cache, s->w.pos + 1);\n    return *length;\n}\n\nint float_cache_print(float_encoder_t* s)\n{\n    int i = 0;\n    u8 *a = s->w.cache;\n    \n    for (i = 0; i < s->w.pos + 1; i++) {\n        printf(\"%02x \", a[i]);\n        if ((i+1) % 16 == 0)\n                printf(\"\\n\");\n        else if ((i + 1) % 8 == 0)\n                printf(\"  \");\n    }\n    printf(\"\\n\");\n}\n\nint bit_readbuf(bitreader_t* br)\n{\n    u32 i = 0;\n    u32 byte_n = 8 - (br->n / 8);\n\n    if (br->len && byte_n > br->len) {\n        byte_n = br->len;\n    }\n\n    if (byte_n == 8) {\n        br->v = (u64)(br->data[7]) | (u64)(br->data[6])<<8 |\n                (u64)(br->data[5])<<16 | (u64)(br->data[4])<<24 |\n                (u64)(br->data[3])<<32 | (u64)(br->data[2])<<40 |\n                (u64)(br->data[1])<<48 | (u64)(br->data[0])<<56;\n        br->n = 64;\n        br->data = br->data + 8;\n        br->len = br->len - 8;\n        return 0;\n    }\n\n    for (i = 0; i < byte_n; i++) {\n        br->n += 8;\n        br->v |= (u64)(br->data[i]) << (64 - br->n);\n    }\n\n    br->data = br->data + byte_n;\n    br->len = br->len - byte_n;\n    return 0;\n}\n\nint bitread_reset(bitreader_t* br, u8* data, u32 len) \n{\n    br->data = data;\n    br->len = len;\n    br->n = 0;\n    br->v = 0;\n    bit_readbuf(br);\n    return 0;\n}\n\nu64 read_bits(bitreader_t* br, u32 nbits)\n{\n    u64 v = 0, n = 0;\n    if (br->n == 0) {\n        return ~0;\n    }\n\n    if (nbits <= br->n) {\n        if (nbits == 64) {\n            v = br->v;\n            br->n = 0;\n            br->v = 0;\n            bit_readbuf(br);\n            return v;\n        }\n\n        v = br->v >> (64 - nbits);\n        br->v = br->v << nbits;\n        br->n = br->n - nbits;\n        if (br->n == 0) {\n            bit_readbuf(br);\n        }\n        return v;\n    }\n\n    //read all available bits in current buffer.\n    v = br->v;\n    n = br->n;\n\n    br->v = 0;\n    br->n = 0;\n    bit_readbuf(br);\n\n    // Append new buffer to previous buffer and shift to remove unnecessary bits.\n    v |= (br->v >> n);\n    v >>= 64 - nbits;\n\n    // Remove used bits from new buffer.\n    u32 buf_n = nbits - n;\n    if (buf_n > br->n) {\n        buf_n = br->n;\n    }\n    br->v <<= buf_n;\n    br->n -= buf_n;\n\n    if (br->n == 0) {\n        bit_readbuf(br);\n    }\n\n    return v;\n}\n\nu64  read_bit(bitreader_t* br)\n{\n    return read_bits(br, 1);\n}\n\nbool can_read_bitfast(bitreader_t* br)\n{\n    if (br->n > 1)\n        return true;\n    else\n        return false;\n}\n\nbool read_bitfast(bitreader_t* br)\n{\n    bool v = ((br->v & ((u64)1<<63)) != 0);\n    br->v <<= 1;\n    br->n -= 1;\n    return v;\n}\n\n// Next returns true if there are remaining values to read.\nbool read_next(float_decoder_t* s)\n{\n    u64 v = 0;\n    u64 bits, mbits, vbits;\n    if (s->finished || s->err) {\n        return false;\n    }\n\n    if (s->first) {\n        s->first = false;\n        // mark as finished if there were no values.\n        if (s->val == Nan) { // IsNaN\n            s->finished = true;\n            return false;\n        }\n        return true;\n    }\n\n    // read compressed value\n    bool abit;\n    if (can_read_bitfast(&s->br)) {\n        abit = read_bitfast(&s->br);\n    } else if (v = read_bit(&s->br) == ~0) {\n        s->err = 1;\n        return false;\n    } else {\n        abit = v;\n    }\n\n    if (abit) {\n        bool bit;\n        if (can_read_bitfast(&s->br)) {\n            bit = read_bitfast(&s->br);\n        } else if (v = read_bit(&s->br) == ~0) {\n            s->err = 1;\n            return false;\n        } else {\n            bit = v;\n        }\n\n        if (!bit) {\n            // reuse leading/trailing zero bits\n            // it.leading, it.trailing = it.leading, it.trailing\n            ;\n        } else {\n            bits = read_bits(&s->br, 5);\n            if (bits == ~0) {\n                s->err = 1;\n                return false;\n            }\n            s->leading = bits;\n\n            bits = read_bits(&s->br, 6);\n            if (bits == ~0) {\n                s->err = 1;\n                return false;\n            }\n            mbits = bits;\n            // 0 significant bits here means we overflowed and we actually need 64;\n            //see comment in encoder\n            if (mbits == 0) {\n                mbits = 64;\n            }\n            s->trailing = 64 - s->leading - mbits;\n        }\n\n        mbits = 64 - s->leading - s->trailing;\n        bits = read_bits(&s->br, mbits);\n        if (bits == ~0) {\n            s->err = 1;\n            return false;\n        }\n\n        vbits = s->val;\n        vbits ^= (bits << s->trailing);\n\n        if (vbits == Nan) { // IsNaN\n            s->finished = true;\n            return false;\n        }\n        s->val = vbits;\n    }\n\n    return true;\n}\n\nint float_decode_setbytes(float_decoder_t* s,u8* data, u32 data_len)\n{\n    memset(s->b, 0, sizeof(s->b));\n    memcpy(s->b, data, data_len);\n\n    bitread_reset(&s->br, s->b + 1, data_len - 1);\n    u64 v = read_bits(&s->br, 64);\n    if (v == ~0) {\n        return -1;\n    }\n    s->val = v;\n    s->leading = 0;\n    s->trailing = 0;\n    s->first = true;\n    s->finished = false;\n    s->err = false;\n\n    return 0;\n}\n\nint float_decode_block(float_decoder_t* s, u8* data, u32 len, f64* res, u32* res_len)\n{\n    u32 cnt = 0;\n    f64 val = 0.0;\n    int ret = float_decode_setbytes(s, data, len);\n    if (ret != 0) {\n        printf(\"Error\\n\");\n        return ret;\n    }\n\n    while(read_next(s)) {\n        val = *(f64*)(&s->val);\n        //printf(\"%f\\n\", val);\n        res[cnt] = val;\n        cnt++;\n        if (cnt > 20) {\n            break;\n        }\n    }\n    *res_len = cnt;\n    if (s->err) {\n        printf(\"Error when decode\\n\");\n        return -1;\n    }\n\n    return 0;\n}\n","numLines":481,"startLine":1,"totalLines":481}}}
