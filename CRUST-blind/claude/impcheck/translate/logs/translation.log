\n            _ => {}\n        }\n\n        self.v3 ^= b;\n        for _ in 0..C_ROUNDS {\n            sipround(&mut self.v0, &mut self.v1, &mut self.v2, &mut self.v3);\n        }\n        self.v0 ^= b;\n\n        if OUTLEN == 16 {\n            self.v2 ^= 0xee;\n        } else {\n            self.v2 ^= 0xff;\n        }\n\n        for _ in 0..D_ROUNDS {\n            sipround(&mut self.v0, &mut self.v1, &mut self.v2, &mut self.v3);\n        }\n\n        let bb = self.v0 ^ self.v1 ^ self.v2 ^ self.v3;\n        u64to8_le(&mut self.out[0..8], bb);\n\n        self.v1 ^= 0xdd;\n        for _ in 0..D_ROUNDS {\n            sipround(&mut self.v0, &mut self.v1, &mut self.v2, &mut self.v3);\n        }\n\n        let bb = self.v0 ^ self.v1 ^ self.v2 ^ self.v3;\n        u64to8_le(&mut self.out[8..16], bb);\n    }\n\n    pub fn siphash_pad(&mut self, nb_bytes: u64) {\n        let c = [0u8];\n        for _ in 0..nb_bytes {\n            self.siphash_update(&c, 1);\n        }\n    }\n\n    pub fn siphash_init(key_128bit: &[u8]) -> Self {\n        let mut sh = SipHash {\n            kk: key_128bit.to_vec(),\n            out: vec![0u8; 16],\n            buf: vec![0u8; 8],\n            buflen: 0,\n            inlen: 0,\n            v0: 0,\n            v1: 0,\n            v2: 0,\n            v3: 0,\n            k0: 0,\n            k1: 0,\n        };\n        if !sh.kk.is_empty() {\n            sh.siphash_reset();\n        }\n        sh\n    }\n\n    pub fn siphash_reset(&mut self) {\n        self.v0 = 0x736f6d6570736575;\n        self.v1 = 0x646f72616e646f6d;\n        self.v2 = 0x6c7967656e657261;\n        self.v3 = 0x7465646279746573;\n        self.k0 = u8to64_le(&self.kk[..8.min(self.kk.len())]);\n        if self.kk.len() >= 16 {\n            self.k1 = u8to64_le(&self.kk[8..16]);\n        } else {\n            self.k1 = 0;\n        }\n        self.v3 ^= self.k1;\n        self.v2 ^= self.k0;\n        self.v1 ^= self.k1;\n        self.v0 ^= self.k0;\n        self.inlen = 0;\n        self