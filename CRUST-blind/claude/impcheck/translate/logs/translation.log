nd_int(\n                            &mut num,\n                            &mut sign_v,\n                            &mut nb_read_cls,\n                            &mut nb_vars,\n                            &mut nb_cls,\n                            &mut header,\n                            &mut began_num,\n                            &mut data,\n                            &mut hash_bytes,\n                            &mut self.f_out,\n                        );\n                    }\n                }\n                b'p' => {\n                    header = true;\n                }\n                b'c' => {\n                    if !header {\n                        comment = true;\n                    }\n                }\n                b' ' => {\n                    if began_num {\n                        append_int(\n                            &mut num,\n                            &mut sign_v,\n                            &mut nb_read_cls,\n                            &mut nb_vars,\n                            &mut nb_cls,\n                            &mut header,\n                            &mut began_num,\n                            &mut data,\n                            &mut hash_bytes,\n                            &mut self.f_out,\n                        );\n                    }\n                }\n                b'-' => {\n                    sign_v = -1;\n                    began_num = true;\n                }\n                b'0'..=b'9' => {\n                    num = num * 10 + (c - b'0') as i32;\n                    began_num = true;\n                }\n                _ => {}\n            }\n        }\n        // EOF reached\n        input_finished = true;\n\n        if began_num {\n            append_int(\n                &mut num,\n                &mut sign_v,\n                &mut nb_read_cls,\n                &mut nb_vars,\n                &mut nb_cls,\n                &mut header,\n                &mut began_num,\n                &mu