{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HuTmbWrTW6V9VvMKooZyDH","type":"tool_result","content":"1\tuse std::f32::consts::PI;\n2\tuse std::collections::HashMap;\n3\tuse std::sync::Arc;\n4\tuse lazy_static::lazy_static;\n5\t#[derive(Clone, Copy, Debug)]\n6\tpub enum MapperSignalValue {\n7\t    F(f32),\n8\t    I32(i32),\n9\t}\n10\timpl MapperSignalValue {\n11\t    pub fn as_f32(&self) -> Option<f32> {\n12\t        match self {\n13\t            MapperSignalValue::F(v) => Some(*v),\n14\t            MapperSignalValue::I32(v) => Some(*v as f32),\n15\t        }\n16\t    }\n17\t    pub fn as_i32(&self) -> Option<i32> {\n18\t        match self {\n19\t            MapperSignalValue::I32(v) => Some(*v),\n20\t            MapperSignalValue::F(v) => Some(*v as i32),\n21\t        }\n22\t    }\n23\t}\n24\tconst STACK_SIZE: usize = 256;\n25\tconst TRACING: bool = false;\n26\tmacro_rules! trace {\n27\t    ($($arg:tt)*) => {\n28\t        if TRACING {\n29\t            println!(\"-- {}\", format!($($arg)*));\n30\t        }\n31\t    };\n32\t}\n33\tmacro_rules! die_unless {\n34\t    ($cond:expr, $($arg:tt)*) => {\n35\t        if !$cond {\n36\t            println!(\"-- {}\", format!($($arg)*));\n37\t            assert!($cond);\n38\t        }\n39\t    };\n40\t}\n41\tfn minf(x: f32, y: f32) -> f32 {\n42\t    if y < x { y } else { x }\n43\t}\n44\tfn maxf(x: f32, y: f32) -> f32 {\n45\t    if y > x { y } else { x }\n46\t}\n47\tfn pif() -> f32 {\n48\t    PI\n49\t}\n50\t#[repr(i32)]\n51\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n52\tenum ExprFunc {\n53\t    Unknown = -1,\n54\t    Pow = 0,\n55\t    Sin,\n56\t    Cos,\n57\t    Tan,\n58\t    Abs,\n59\t    Sqrt,\n60\t    Log,\n61\t    Log10,\n62\t    Exp,\n63\t    Floor,\n64\t    Round,\n65\t    Ceil,\n66\t    Asin,\n67\t    Acos,\n68\t    Atan,\n69\t    Atan2,\n70\t    Sinh,\n71\t    Cosh,\n72\t    Tanh,\n73\t    Logb,\n74\t    Exp2,\n75\t    Log2,\n76\t    Hypot,\n77\t    Cbrt,\n78\t    Trunc,\n79\t    Min,\n80\t    Max,\n81\t    Pi,\n82\t    NFuncs,\n83\t}\n84\t#[derive(Debug, Clone, Copy)]\n85\tstruct FunctionEntry {\n86\t    name: &'static str,\n87\t    arity: u32,\n88\t    func: fn(f32, f32) -> f32,\n89\t}\n90\tlazy_static::lazy_static! {\n91\t    static ref FUNCTION_TABLE: HashMap<&'static str, FunctionEntry> = {\n92\t        let mut m = HashMap::new();\n93\t        m.insert(\"pow\", FunctionEntry { name: \"pow\", arity: 2, func: f32::powf });\n94\t        m.insert(\"sin\", FunctionEntry { name: \"sin\", arity: 1, func: |x, _| x.sin() });\n95\t        m.insert(\"cos\", FunctionEntry { name: \"cos\", arity: 1, func: |x, _| x.cos() });\n96\t        m.insert(\"tan\", FunctionEntry { name: \"tan\", arity: 1, func: |x, _| x.tan() });\n97\t        m.insert(\"abs\", FunctionEntry { name: \"abs\", arity: 1, func: |x, _| x.abs() });\n98\t        m.insert(\"sqrt\", FunctionEntry { name: \"sqrt\", arity: 1, func: |x, _| x.sqrt() });\n99\t        m.insert(\"log\", FunctionEntry { name: \"log\", arity: 1, func: |x, _| x.ln() });\n100\t        m.insert(\"log10\", FunctionEntry { name: \"log10\", arity: 1, func: |x, _| x.log10() });\n101\t        m.insert(\"exp\", FunctionEntry { name: \"exp\", arity: 1, func: |x, _| x.exp() });\n102\t        m.insert(\"floor\", FunctionEntry { name: \"floor\", arity: 1, func: |x, _| x.floor() });\n103\t        m.insert(\"round\", FunctionEntry { name: \"round\", arity: 1, func: |x, _| x.round() });\n104\t        m.insert(\"ceil\", FunctionEntry { name: \"ceil\", arity: 1, func: |x, _| x.ceil() });\n105\t        m.insert(\"asin\", FunctionEntry { name: \"asin\", arity: 1, func: |x, _| x.asin() });\n106\t        m.insert(\"acos\", FunctionEntry { name: \"acos\", arity: 1, func: |x, _| x.acos() });\n107\t        m.insert(\"atan\", FunctionEntry { name: \"atan\", arity: 1, func: |x, _| x.atan() });\n108\t        m.insert(\"atan2\", FunctionEntry { name: \"atan2\", arity: 2, func: f32::atan2 });\n109\t        m.insert(\"sinh\", FunctionEntry { name: \"sinh\", arity: 1, func: |x, _| x.sinh() });\n110\t        m.insert(\"cosh\", FunctionEntry { name: \"cosh\", arity: 1, func: |x, _| x.cosh() });\n111\t        m.insert(\"tanh\", FunctionEntry { name: \"tanh\", arity: 1, func: |x, _| x.tanh() });\n112\t        m.insert(\"logb\", FunctionEntry { name: \"logb\", arity: 1, func: |x, _| {\n113\t            if x == 0.0 { f32::NEG_INFINITY } else { x.abs().log2().floor() }\n114\t        }});\n115\t        m.insert(\"exp2\", FunctionEntry { name: \"exp2\", arity: 1, func: |x, _| x.exp2() });\n116\t        m.insert(\"log2\", FunctionEntry { name: \"log2\", arity: 1, func: |x, _| x.log2() });\n117\t        m.insert(\"hypot\", FunctionEntry { name: \"hypot\", arity: 2, func: f32::hypot });\n118\t        m.insert(\"cbrt\", FunctionEntry { name: \"cbrt\", arity: 1, func: |x, _| x.cbrt() });\n119\t        m.insert(\"trunc\", FunctionEntry { name: \"trunc\", arity: 1, func: |x, _| x.trunc() });\n120\t        m.insert(\"min\", FunctionEntry { name: \"min\", arity: 2, func: minf });\n121\t        m.insert(\"max\", FunctionEntry { name: \"max\", arity: 2, func: maxf });\n122\t        m.insert(\"pi\", FunctionEntry { name: \"pi\", arity: 0, func: |_, _| pif() });\n123\t        m\n124\t    };\n125\t\n126\t    // Stable index-based access. We store function indices in token's int_value field.\n127\t    static ref FUNCTION_LIST: Vec<(String, FunctionEntry)> = {\n128\t        let names = [\n129\t            \"pow\", \"sin\", \"cos\", \"tan\", \"abs\", \"sqrt\", \"log\", \"log10\", \"exp\",\n130\t            \"floor\", \"round\", \"ceil\", \"asin\", \"acos\", \"atan\", \"atan2\",\n131\t            \"sinh\", \"cosh\", \"tanh\", \"logb\", \"exp2\", \"log2\", \"hypot\", \"cbrt\",\n132\t            \"trunc\", \"min\", \"max\", \"pi\",\n133\t        ];\n134\t        names.iter().map(|n| (n.to_string(), *FUNCTION_TABLE.get(n).unwrap())).collect()\n135\t    };\n136\t}\n137\t\n138\tfn func_index_lookup(name: &str) -> Option<i32> {\n139\t    FUNCTION_LIST.iter().position(|(n, _)| n == name).map(|i| i as i32)\n140\t}\n141\t\n142\tfn func_by_index(idx: i32) -> Option<&'static FunctionEntry> {\n143\t    FUNCTION_LIST.get(idx as usize).map(|(_, e)| e)\n144\t}\n145\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n146\tenum TokenType {\n147\t    Float,\n148\t    Int,\n149\t    Op,\n150\t    OpenParen,\n151\t    CloseParen,\n152\t    Var,\n153\t    OpenSquare,\n154\t    CloseSquare,\n155\t    OpenCurly,\n156\t    CloseCurly,\n157\t    Func,\n158\t    Comma,\n159\t    End,\n160\t    ToFloat,\n161\t    ToInt32,\n162\t}\n163\t#[derive(Debug, Clone, Copy)]\n164\tstruct Token {\n165\t    token_type: TokenType,\n166\t    value: Option<f32>,\n167\t    int_value: Option<i32>,\n168\t    var: Option<char>,\n169\t    op: Option<char>,\n170\t}\n171\tfn function_lookup(s: &str) -> Option<&'static FunctionEntry> {\n172\t    FUNCTION_TABLE.get(s)\n173\t}\n174\t\n175\tfn func_arity(name: &str) -> u32 {\n176\t    FUNCTION_TABLE.get(name).map(|e| e.arity).unwrap_or(0)\n177\t}\n178\t\n179\tfn func_apply(name: &str, x: f32, y: f32) -> f32 {\n180\t    if let Some(e) = FUNCTION_TABLE.get(name) {\n181\t        (e.func)(x, y)\n182\t    } else {\n183\t        0.0\n184\t    }\n185\t}\n186\t\n187\tfn expr_lex(s: Vec<&str>) -> Vec<Token> {\n188\t    // Concatenate all input pieces, lex into tokens\n189\t    let joined: String = s.into_iter().collect::<Vec<_>>().join(\"\");\n190\t    let bytes: Vec<char> = joined.chars().collect();\n191\t    let mut tokens = Vec::new();\n192\t    let mut i = 0;\n193\t    while i < bytes.len() {\n194\t        let tok = lex_one(&bytes, &mut i);\n195\t        if let Some(t) = tok {\n196\t            let is_end = t.token_type == TokenType::End;\n197\t            tokens.push(t);\n198\t            if is_end {\n199\t                break;\n200\t            }\n201\t        } else {\n202\t            break;\n203\t        }\n204\t    }\n205\t    tokens\n206\t}\n207\t\n208\tfn lex_one(s: &[char], pos: &mut usize) -> Option<Token> {\n209\t    // Skip whitespace\n210\t    while *pos < s.len() {\n211\t        let c = s[*pos];\n212\t        if c == ' ' || c == '\\t' || c == '\\r' || c == '\\n' {\n213\t            *pos += 1;\n214\t        } else {\n215\t            break;\n216\t        }\n217\t    }\n218\t    if *pos >= s.len() {\n219\t        return Some(Token {\n220\t            token_type: TokenType::End,\n221\t            value: None,\n222\t            int_value: None,\n223\t            var: None,\n224\t            op: None,\n225\t        });\n226\t    }\n227\t    let c = s[*pos];\n228\t    let mut integer_found = false;\n229\t    let mut int_val: i32 = 0;\n230\t\n231\t    if c.is_ascii_digit() {\n232\t        let start = *pos;\n233\t        while *pos < s.len() && s[*pos].is_ascii_digit() {\n234\t            *pos += 1;\n235\t        }\n236\t        let int_str: String = s[start..*pos].iter().collect();\n237\t        int_val = int_str.parse::<i32>().unwrap_or(0);\n238\t        integer_found = true;\n239\t        let nc = if *pos < s.len() { s[*pos] } else { '\\0' };\n240\t        if nc != '.' {\n241\t            return Some(Token {\n242\t                token_type: TokenType::Int,\n243\t                value: None,\n244\t                int_value: Some(int_val),\n245\t                var: None,\n246\t                op: None,\n247\t            });\n248\t        }\n249\t    }\n250\t\n251\t    let c = if *pos < s.len() { s[*pos] } else { '\\0' };\n252\t    match c {\n253\t        '.' => {\n254\t            let start = *pos;\n255\t            *pos += 1;\n256\t            let nc = if *pos < s.len() { s[*pos] } else { '\\0' };\n257\t            if !nc.is_ascii_digit() && integer_found {\n258\t                return Some(Token {\n259\t                    token_type: TokenType::Float,\n260\t                    value: Some(int_val as f32),\n261\t                    int_value: None,\n262\t                    var: None,\n263\t                    op: None,\n264\t                });\n265\t            }\n266\t            if !nc.is_ascii_digit() {\n267\t                return None;\n268\t            }\n269\t            while *pos < s.len() && s[*pos].is_ascii_digit() {\n270\t                *pos += 1;\n271\t            }\n272\t            let float_str: String = s[start..*pos].iter().collect();\n273\t            let frac: f64 = float_str.parse::<f64>().unwrap_or(0.0);\n274\t            Some(Token {\n275\t                token_type: TokenType::Float,\n276\t                value: Some((int_val as f64 + frac) as f32),\n277\t                int_value: None,\n278\t                var: None,\n279\t                op: None,\n280\t            })\n281\t        }\n282\t        '+' | '-' | '/' | '*' | '=' => {\n283\t            *pos += 1;\n284\t            Some(Token {\n285\t                token_type: TokenType::Op,\n286\t                value: None,\n287\t                int_value: None,\n288\t                var: None,\n289\t                op: Some(c),\n290\t            })\n291\t        }\n292\t        '(' => {\n293\t            *pos += 1;\n294\t            Some(Token {\n295\t                token_type: TokenType::OpenParen,\n296\t                value: None,\n297\t                int_value: None,\n298\t                var: None,\n299\t                op: None,\n300\t            })\n301\t        }\n302\t        ')' => {\n303\t            *pos += 1;\n304\t            Some(Token {\n305\t                token_type: TokenType::CloseParen,\n306\t                value: None,\n307\t                int_value: None,\n308\t                var: None,\n309\t                op: None,\n310\t            })\n311\t        }\n312\t        'x' | 'y' => {\n313\t            *pos += 1;\n314\t            Some(Token {\n315\t                token_type: TokenType::Var,\n316\t                value: None,\n317\t                int_value: None,\n318\t                var: Some(c),\n319\t                op: None,\n320\t            })\n321\t        }\n322\t        '[' => {\n323\t            *pos += 1;\n324\t            Some(Token {\n325\t                token_type: TokenType::OpenSquare,\n326\t                value: None,\n327\t                int_value: None,\n328\t                var: None,\n329\t                op: None,\n330\t            })\n331\t        }\n332\t        ']' => {\n333\t            *pos += 1;\n334\t            Some(Token {\n335\t                token_type: TokenType::CloseSquare,\n336\t                value: None,\n337\t                int_value: None,\n338\t                var: None,\n339\t                op: None,\n340\t            })\n341\t        }\n342\t        '{' => {\n343\t            *pos += 1;\n344\t            Some(Token {\n345\t                token_type: TokenType::OpenCurly,\n346\t                value: None,\n347\t                int_value: None,\n348\t                var: None,\n349\t                op: None,\n350\t            })\n351\t        }\n352\t        '}' => {\n353\t            *pos += 1;\n354\t            Some(Token {\n355\t                token_type: TokenType::CloseCurly,\n356\t                value: None,\n357\t                int_value: None,\n358\t                var: None,\n359\t                op: None,\n360\t            })\n361\t        }\n362\t        ',' => {\n363\t            *pos += 1;\n364\t            Some(Token {\n365\t                token_type: TokenType::Comma,\n366\t                value: None,\n367\t                int_value: None,\n368\t                var: None,\n369\t                op: None,\n370\t            })\n371\t        }\n372\t        '\\0' => Some(Token {\n373\t            token_type: TokenType::End,\n374\t            value: None,\n375\t            int_value: None,\n376\t            var: None,\n377\t            op: None,\n378\t        }),\n379\t        _ => {\n380\t            if !c.is_ascii_alphabetic() {\n381\t                println!(\"unknown character '{}' in lexer\", c);\n382\t                return None;\n383\t            }\n384\t            let start = *pos;\n385\t            while *pos < s.len() {\n386\t                let cc = s[*pos];\n387\t                if cc.is_ascii_alphabetic() || cc.is_ascii_digit() {\n388\t                    *pos += 1;\n389\t                } else {\n390\t                    break;\n391\t                }\n392\t            }\n393\t            let name: String = s[start..*pos].iter().collect();\n394\t            // Store the function name in `var` field (we re-use char field for index hack);\n395\t            // Since Token only has Option<char>, we need different storage. Let's encode\n396\t            // the function as a TokenType::Func and put name into a separate global lookup.\n397\t            // Instead, we will encode by storing the function entry's char as None, and\n398\t            // we'll separately track the function name in a side table.\n399\t            // But we don't want side tables, so instead we store via a thread-local map.\n400\t            // Actually we need the name later — use a workaround: store a marker by op\n401\t            // and track in a global. To simplify, we will store the function name in\n402\t            // the parser's NodeData not Token.\n403\t            // For the lexer we need to know the function. We'll attach the name through\n404\t            // a parallel mechanism: a special Token variant with var=first char of name\n405\t            // is not enough. Use a thread-local registry mapping a token id to name.\n406\t            register_func_name(&name);\n407\t            // Encode function index in int_value (-1 if unknown)\n408\t            let idx = func_index_lookup(&name).unwrap_or(-1);\n409\t            Some(Token {\n410\t                token_type: TokenType::Func,\n411\t                value: None,\n412\t                int_value: Some(idx),\n413\t                var: None,\n414\t                op: None,\n415\t            })\n416\t        }\n417\t    }\n418\t}\n419\t\n420\tuse std::cell::RefCell;\n421\tthread_local! {\n422\t    static FUNC_NAME_QUEUE: RefCell<Vec<String>> = RefCell::new(Vec::new());\n423\t}\n424\t\n425\tfn register_func_name(name: &str) {\n426\t    FUNC_NAME_QUEUE.with(|q| q.borrow_mut().push(name.to_string()));\n427\t}\n428\t\n429\tfn pop_func_name() -> String {\n430\t    FUNC_NAME_QUEUE.with(|q| {\n431\t        let mut q = q.borrow_mut();\n432\t        if q.is_empty() {\n433\t            String::new()\n434\t        } else {\n435\t            q.remove(0)\n436\t        }\n437\t    })\n438\t}\n439\t\n440\tfn clear_func_names() {\n441\t    FUNC_NAME_QUEUE.with(|q| q.borrow_mut().clear());\n442\t}\n443\tpub struct ExprNode{\n444\t    pub tok: Token,\n445\t    pub is_float: i32,\n446\t    pub history_index: i32,\n447\t    pub vector_index: i32,\n448\t    pub next: Option<Arc<ExprNode>>,\n449\t}\n450\tpub struct MapperExpr{\n451\t    pub node: ExprNode,\n452\t    pub vector_size: i32,\n453\t    pub history_size: i32,\n454\t    pub history_pos: i32,\n455\t    pub input_history: Vec<MapperSignalValue>,\n456\t    pub output_history: Vec<MapperSignalValue>,\n457\t}\n458\tpub enum state_t{\n459\t    YEQUAL_Y,\n460\t    YEQUAL_EQ,\n461\t    EXPR,\n462\t    EXPR_RIGHT,\n463\t    TERM,\n464\t    TERM_RIGHT,\n465\t    VALUE,\n466\t    NEGATE,\n467\t    VAR_RIGHT,\n468\t    VAR_VECTINDEX,\n469\t    VAR_HISTINDEX,\n470\t    CLOSE_VECTINDEX,\n471\t    CLOSE_HISTINDEX,\n472\t    OPEN_PAREN,\n473\t    CLOSE_PAREN,\n474\t    COMMA,\n475\t    END,\n476\t}\n477\tenum stack_obj_t {\n478\t    State(state_t),\n479\t    Node(ExprNode),\n480\t}\n481\timpl ExprNode {\n482\t    pub fn new() -> ExprNode {\n483\t        ExprNode {\n484\t            tok: Token {\n485\t                token_type: TokenType::End,\n486\t                value: None,\n487\t                int_value: None,\n488\t                var: None,\n489\t                op: None,\n490\t            },\n491\t            is_float: 0,\n492\t            history_index: 0,\n493\t            vector_index: 0,\n494\t            next: None,\n495\t        }\n496\t    }\n497\t    pub fn expr_free(&self) {\n498\t        // Rust handles freeing automatically via Arc drop\n499\t    }\n500\t}\n501\t\n502\tfn printtoken(t: &Token) {\n503\t    match t.token_type {\n504\t        TokenType::Float => print!(\"{}\", t.value.unwrap_or(0.0)),\n505\t        TokenType::Int => print!(\"{}\", t.int_value.unwrap_or(0)),\n506\t        TokenType::Op => print!(\"{}\", t.op.unwrap_or(' ')),\n507\t        TokenType::OpenParen => print!(\"(\"),\n508\t        TokenType::CloseParen => print!(\")\"),\n509\t        TokenType::Var => print!(\"VAR({})\", t.var.unwrap_or(' ')),\n510\t        TokenType::OpenSquare => print!(\"[\"),\n511\t        TokenType::CloseSquare => print!(\"]\"),\n512\t        TokenType::OpenCurly => print!(\"{{\"),\n513\t        TokenType::CloseCurly => print!(\"}}\"),\n514\t        TokenType::Func => print!(\"FUNC()\"),\n515\t        TokenType::Comma => print!(\",\"),\n516\t        TokenType::End => print!(\"END\"),\n517\t        TokenType::ToFloat => print!(\"(float)\"),\n518\t        TokenType::ToInt32 => print!(\"(int32)\"),\n519\t    }\n520\t}\n521\t\n522\tfn printexprnode(s: &str, list: &ExprNode) {\n523\t    print!(\"{}\", s);\n524\t    let mut cur: Option<&ExprNode> = Some(list);\n525\t    while let Some(node) = cur {\n526\t        if node.is_float != 0\n527\t            && node.tok.token_type != TokenType::Float\n528\t            && node.tok.token_type != TokenType::ToFloat\n529\t        {\n530\t            print!(\".\");\n531\t        }\n532\t        printtoken(&node.tok);\n533\t        if node.tok.token_type == TokenType::Var {\n534\t            if node.history_index < 0 {\n535\t                print!(\"{{{}}}\", node.history_index);\n536\t            }\n537\t            if node.vector_index > -1 {\n538\t                print!(\"[{}]\", node.vector_index);\n539\t            }\n540\t        }\n541\t        cur = node.next.as_deref();\n542\t        if cur.is_some() {\n543\t            print!(\" \");\n544\t        }\n545\t    }\n546\t}\n547\t\n548\tfn printexpr(s: &str, list: &MapperExpr) {\n549\t    printexprnode(s, &list.node);\n550\t}\n551\t\n552\tfn printstack(_stack: &stack_obj_t, _stack_size: i32) {\n553\t    // Debug only\n554\t}\n555\t\n556\tfn collapse_expr_to_left(_plhs: &mut ExprNode, _constant_folding: i32) {\n557\t    // Implemented via internal arena in parser\n558\t}\n559\t// Internal arena-based representation for parsing.\n560\t#[derive(Clone)]\n561\tstruct NodeData {\n562\t    tok: Token,\n563\t    is_float: i32,\n564\t    history_index: i32,\n565\t    vector_index: i32,\n566\t    next: Option<usize>,\n567\t    func_name: Option<String>,\n568\t}\n569\t\n570\tstruct Arena {\n571\t    nodes: Vec<NodeData>,\n572\t}\n573\t\n574\timpl Arena {\n575\t    fn new() -> Self {\n576\t        Arena { nodes: Vec::new() }\n577\t    }\n578\t    fn alloc(&mut self, tok: Token, is_float: i32, func_name: Option<String>) -> usize {\n579\t        self.nodes.push(NodeData {\n580\t            tok,\n581\t            is_float,\n582\t            history_index: 0,\n583\t            vector_index: 0,\n584\t            next: None,\n585\t            func_name,\n586\t        });\n587\t        self.nodes.len() - 1\n588\t    }\n589\t    fn last_in_chain(&self, head: usize) -> usize {\n590\t        let mut cur = head;\n591\t        while let Some(n) = self.nodes[cur].next {\n592\t            cur = n;\n593\t        }\n594\t        cur\n595\t    }\n596\t    fn has_var(&self, head: usize) -> bool {\n597\t        let mut cur = Some(head);\n598\t        while let Some(idx) = cur {\n599\t            if self.nodes[idx].tok.token_type == TokenType::Var {\n600\t                return true;\n601\t            }\n602\t            cur = self.nodes[idx].next;\n603\t        }\n604\t        false\n605\t    }\n606\t}\n607\t\n608\t#[derive(Clone, Copy, Debug, PartialEq, Eq)]\n609\tenum InternalState {\n610\t    YEqualY,\n611\t    YEqualEq,\n612\t    Expr,\n613\t    ExprRight,\n614\t    Term,\n615\t    TermRight,\n616\t    Value,\n617\t    Negate,\n618\t    VarRight,\n619\t    VarVectIndex,\n620\t    VarHistIndex,\n621\t    CloseVectIndex,\n622\t    CloseHistIndex,\n623\t    OpenParen,\n624\t    CloseParen,\n625\t    Comma,\n626\t    End,\n627\t}\n628\t\n629\t#[derive(Clone, Copy, Debug)]\n630\tenum StackEntry {\n631\t    State(InternalState),\n632\t    Node(usize), // index into arena (head of chain)\n633\t}\n634\t\n635\t// Apply the same logic as collapse_expr_to_left in C.\n636\tfn arena_collapse(arena: &mut Arena, lhs_head: usize, rhs_head: usize, constant_folding: bool) -> usize {\n637\t    let mut refvar = arena.has_var(lhs_head) || arena.has_var(rhs_head);\n638\t    let _ = refvar;\n639\t    refvar = arena.has_var(lhs_head) || arena.has_var(rhs_head);\n640\t\n641\t    // Find lhs_last (index of last node in lhs chain)\n642\t    let mut lhs_prev: Option<usize> = None;\n643\t    let mut lhs_last = lhs_head;\n644\t    while let Some(n) = arena.nodes[lhs_last].next {\n645\t        lhs_prev = Some(lhs_last);\n646\t        lhs_last = n;\n647\t    }\n648\t    // Find rhs_last\n649\t    let mut rhs_last = rhs_head;\n650\t    while let Some(n) = arena.nodes[rhs_last].next {\n651\t        rhs_last = n;\n652\t    }\n653\t\n654\t    let lhs_last_is_float = arena.nodes[lhs_last].is_float != 0;\n655\t    let rhs_last_is_float = arena.nodes[rhs_last].is_float != 0;\n656\t    let is_float = lhs_last_is_float || rhs_last_is_float;\n657\t\n658\t    // Coerce types if disagree\n659\t    let mut new_lhs_head = lhs_head;\n660\t    let mut effective_lhs_last = lhs_last;\n661\t    let mut effective_lhs_prev = lhs_prev;\n662\t    let coerce_tok = Token {\n663\t        token_type: TokenType::ToFloat,\n664\t        value: None,\n665\t        int_value: None,\n666\t        var: None,\n667\t        op: None,\n668\t    };\n669\t\n670\t    if lhs_last_is_float && !rhs_last_is_float {\n671\t        // append a TOFLOAT to rhs end\n672\t        let cidx = arena.alloc(coerce_tok, 1, None);\n673\t        arena.nodes[rhs_last].next = Some(cidx);\n674\t        // rhs_last = cidx; (no longer used after this)\n675\t    } else if !lhs_last_is_float && rhs_last_is_float {\n676\t        // insert a TOFLOAT BEFORE lhs_last:\n677\t        // i.e. we replace what previously pointed to lhs_last with a new node 'e',\n678\t        // and e.next = lhs_last; mark lhs_last.is_float = 1\n679\t        let cidx = arena.alloc(coerce_tok, 1, None);\n680\t        arena.nodes[cidx].next = Some(lhs_last);\n681\t        if let Some(p) = lhs_prev {\n682\t            arena.nodes[p].next = Some(cidx);\n683\t        } else {\n684\t            // lhs was a single node; replace head\n685\t            new_lhs_head = cidx;\n686\t        }\n687\t        // mark lhs_last as is_float = 1 (matching e->next->is_float = 1)\n688\t        arena.nodes[lhs_last].is_float = 1;\n689\t        // Now plhs_last (the slot pointing to lhs_last) is &cidx.next\n690\t        effective_lhs_prev = Some(cidx);\n691\t        effective_lhs_last = lhs_last;\n692\t    }\n693\t\n694\t    // Insert rhs list before lhs_last (the trailing op):\n695\t    // rhs_last.next = lhs_last\n696\t    // *plhs_last (the slot that pointed to lhs_last) = rhs\n697\t    let _ = effective_lhs_last;\n698\t    // Find the actual rhs tail again (in case TOFLOAT was appended)\n699\t    let rhs_tail_now = arena.last_in_chain(rhs_head);\n700\t    arena.nodes[rhs_tail_now].next = Some(effective_lhs_last);\n701\t    if let Some(p) = effective_lhs_prev {\n702\t        arena.nodes[p].next = Some(rhs_head);\n703\t    } else {\n704\t        new_lhs_head = rhs_head;\n705\t    }\n706\t\n707\t    // Constant folding: evaluate expression now if no variables\n708\t    if constant_folding && !refvar {\n709\t        // Build a temporary MapperExpr-like environment and evaluate.\n710\t        if let Some(v) = evaluate_arena_chain(arena, new_lhs_head, None, 0, 0, &[]) {\n711\t            // Replace head with single literal node (and free chain).\n712\t            arena.nodes[new_lhs_head].next = None;\n713\t            arena.nodes[new_lhs_head].is_float = if is_float { 1 } else { 0 };\n714\t            if is_float {\n715\t                arena.nodes[new_lhs_head].tok = Token {\n716\t                    token_type: TokenType::Float,\n717\t                    value: Some(v.f),\n718\t                    int_value: None,\n719\t                    var: None,\n720\t                    op: None,\n721\t                };\n722\t            } else {\n723\t                arena.nodes[new_lhs_head].tok = Token {\n724\t                    token_type: TokenType::Int,\n725\t                    value: None,\n726\t                    int_value: Some(v.i32),\n727\t                    var: None,\n728\t                    op: None,\n729\t                };\n730\t            }\n731\t            arena.nodes[new_lhs_head].func_name = None;\n732\t        }\n733\t    }\n734\t\n735\t    new_lhs_head\n736\t}\n737\t\n738\t#[derive(Clone, Copy)]\n739\tstruct SignalUnion {\n740\t    f: f32,\n741\t    i32: i32,\n742\t}\n743\t\n744\tfn evaluate_arena_chain(\n745\t    arena: &Arena,\n746\t    head: usize,\n747\t    input: Option<&MapperSignalValue>,\n748\t    history_pos: i32,\n749\t    history_size: i32,\n750\t    input_history: &[MapperSignalValue],\n751\t) -> Option<SignalUnion> {\n752\t    let _ = (input, history_pos, history_size, input_history);\n753\t    // For constant folding, no vars. We can use a stack.\n754\t    let mut stack: Vec<SignalUnion> = Vec::with_capacity(STACK_SIZE);\n755\t    let mut cur = Some(head);\n756\t    while let Some(idx) = cur {\n757\t        let node = &arena.nodes[idx];\n758\t        match node.tok.token_type {\n759\t            TokenType::Int => {\n760\t                stack.push(SignalUnion {\n761\t                    f: 0.0,\n762\t                    i32: node.tok.int_value.unwrap_or(0),\n763\t                });\n764\t            }\n765\t            TokenType::Float => {\n766\t                stack.push(SignalUnion {\n767\t                    f: node.tok.value.unwrap_or(0.0),\n768\t                    i32: 0,\n769\t                });\n770\t            }\n771\t            TokenType::ToFloat => {\n772\t                let top = stack.last_mut()?;\n773\t                top.f = top.i32 as f32;\n774\t            }\n775\t            TokenType::ToInt32 => {\n776\t                let top = stack.last_mut()?;\n777\t                top.i32 = top.f as i32;\n778\t            }\n779\t            TokenType::Op => {\n780\t                let right = stack.pop()?;\n781\t                let left = stack.pop()?;\n782\t                let op = node.tok.op?;\n783\t                if node.is_float != 0 {\n784\t                    let r = match op {\n785\t                        '+' => left.f + right.f,\n786\t                        '-' => left.f - right.f,\n787\t                        '*' => left.f * right.f,\n788\t                        '/' => left.f / right.f,\n789\t                        _ => return None,\n790\t                    };\n791\t                    stack.push(SignalUnion { f: r, i32: 0 });\n792\t                } else {\n793\t                    let r = match op {\n794\t                        '+' => left.i32.wrapping_add(right.i32),\n795\t                        '-' => left.i32.wrapping_sub(right.i32),\n796\t                        '*' => left.i32.wrapping_mul(right.i32),\n797\t                        '/' => {\n798\t                            if right.i32 == 0 {\n799\t                                return None;\n800\t                            } else {\n801\t                                left.i32 / right.i32\n802\t                            }\n803\t                        }\n804\t                        _ => return None,\n805\t                    };\n806\t                    stack.push(SignalUnion { f: 0.0, i32: r });\n807\t                }\n808\t            }\n809\t            TokenType::Func => {\n810\t                let idx = node.tok.int_value.unwrap_or(-1);\n811\t                let entry = match func_by_index(idx) {\n812\t                    Some(e) => e,\n813\t                    None => return None,\n814\t                };\n815\t                match entry.arity {\n816\t                    0 => {\n817\t                        let v = (entry.func)(0.0, 0.0);\n818\t                        stack.push(SignalUnion { f: v, i32: 0 });\n819\t                    }\n820\t                    1 => {\n821\t                        let r = stack.pop()?;\n822\t                        let v = (entry.func)(r.f, 0.0);\n823\t                        stack.push(SignalUnion { f: v, i32: 0 });\n824\t                    }\n825\t                    2 => {\n826\t                        let right = stack.pop()?;\n827\t                        let left = stack.pop()?;\n828\t                        let v = (entry.func)(left.f, right.f);\n829\t                        stack.push(SignalUnion { f: v, i32: 0 });\n830\t                    }\n831\t                    _ => return None,\n832\t                }\n833\t            }\n834\t            _ => return None,\n835\t        }\n836\t        cur = node.next;\n837\t    }\n838\t    if stack.is_empty() {\n839\t        None\n840\t    } else {\n841\t        Some(stack[0])\n842\t    }\n843\t}\n844\t\n845\t// Convert an arena-based chain into an Arc<ExprNode> linked list (in reverse).\n846\tfn arena_to_arc_chain(arena: &Arena, head: usize) -> Option<Arc<ExprNode>> {\n847\t    // Collect all nodes in order.\n848\t    let mut indices = Vec::new();\n849\t    let mut cur = Some(head);\n850\t    while let Some(idx) = cur {\n851\t        indices.push(idx);\n852\t        cur = arena.nodes[idx].next;\n853\t    }\n854\t    // Build from the tail back.\n855\t    let mut next: Option<Arc<ExprNode>> = None;\n856\t    for &idx in indices.iter().rev() {\n857\t        let n = &arena.nodes[idx];\n858\t        let mut tok = n.tok;\n859\t        // Encode function name into Token's `var` field is impossible, so we\n860\t        // need to keep func name lookup somewhere — store it in a side map keyed\n861\t        // by the Arc identity. We'll handle this by attaching name via a separate\n862\t        // global registry keyed by ExprNode pointer. Simpler: store the func name\n863\t        // in token's var field as a single placeholder char and look up via a\n864\t        // node-pointer registry.\n865\t        let _ = tok;\n866\t        let func_name = n.func_name.clone();\n867\t        let node = Arc::new(ExprNode {\n868\t            tok: n.tok,\n869\t            is_float: n.is_float,\n870\t            history_index: n.history_index,\n871\t            vector_index: n.vector_index,\n872\t            next: next.clone(),\n873\t        });\n874\t        // Register func name (if any) with this node's pointer identity.\n875\t        if let Some(fname) = func_name {\n876\t            register_node_func(Arc::as_ptr(&node) as usize, fname);\n877\t        }\n878\t        next = Some(node);\n879\t    }\n880\t    next\n881\t}\n882\t\n883\tthread_local! {\n884\t    static NODE_FUNC_NAMES: RefCell<HashMap<usize, String>> = RefCell::new(HashMap::new());\n885\t}\n886\t\n887\tfn register_node_func(ptr: usize, name: String) {\n888\t    NODE_FUNC_NAMES.with(|m| {\n889\t        m.borrow_mut().insert(ptr, name);\n890\t    });\n891\t}\n892\t\n893\tfn lookup_node_func(node: &ExprNode) -> Option<String> {\n894\t    let ptr = node as *const ExprNode as usize;\n895\t    NODE_FUNC_NAMES.with(|m| m.borrow().get(&ptr).cloned())\n896\t}\n897\t\n898\tpub fn mapper_expr_new_from_string(\n899\t    s: &str,\n900\t    input_is_float: i32,\n901\t    _output_is_float: i32,\n902\t    vector_size: i32,\n903\t) -> MapperExpr {\n904\t    clear_func_names();\n905\t    let tokens = expr_lex(vec![s]);\n906\t    let mut tok_iter = TokenIter::new(tokens);\n907\t    let mut arena = Arena::new();\n908\t    let mut stack: Vec<StackEntry> = Vec::with_capacity(STACK_SIZE);\n909\t\n910\t    stack.push(StackEntry::State(InternalState::Expr));\n911\t    stack.push(StackEntry::State(InternalState::YEqualEq));\n912\t    stack.push(StackEntry::State(InternalState::YEqualY));\n913\t\n914\t    let mut next_token = true;\n915\t    let mut var_allowed = true;\n916\t    let mut oldest_samps: f32 = 0.0;\n917\t    let mut result_head: Option<usize> = None;\n918\t    let mut error: Option<&'static str> = None;\n919\t    let mut cur_tok = Token {\n920\t        token_type: TokenType::End,\n921\t        value: None,\n922\t        int_value: None,\n923\t        var: None,\n924\t        op: None,\n925\t    };\n926\t\n927\t    while !stack.is_empty() {\n928\t        if next_token {\n929\t            cur_tok = tok_iter.next();\n930\t            next_token = false;\n931\t        }\n932\t\n933\t        // If top is a node, do \"tail logic\"\n934\t        let top_idx = stack.len() - 1;\n935\t        match stack[top_idx] {\n936\t            StackEntry::Node(node_head) => {\n937\t                if top_idx == 0 {\n938\t                    result_head = Some(node_head);\n939\t                    break;\n940\t                }\n941\t                let below = stack[top_idx - 1];\n942\t                if let StackEntry::State(state) = below {\n943\t                    if top_idx >= 2 {\n944\t                        if let StackEntry::Node(below2) = stack[top_idx - 2] {\n945\t                            match state {\n946\t                                InternalState::ExprRight\n947\t                                | InternalState::TermRight\n948\t                                | InternalState::CloseParen => {\n949\t                                    let new_head = arena_collapse(&mut arena, below2, node_head, true);\n950\t                                    stack[top_idx - 2] = StackEntry::Node(new_head);\n951\t                                    stack.pop(); // remove top\n952\t                                }\n953\t                                InternalState::CloseHistIndex => {\n954\t                                    // expected VAR two-down\n955\t                                    let val_node = &arena.nodes[node_head];\n956\t                                    let hi = match val_node.tok.token_type {\n957\t                                        TokenType::Float => val_node.tok.value.unwrap_or(0.0) as i32,\n958\t                                        TokenType::Int => val_node.tok.int_value.unwrap_or(0),\n959\t                                        _ => 0,\n960\t                                    };\n961\t                                    arena.nodes[below2].history_index = hi;\n962\t                                    if (oldest_samps as i32) > hi {\n963\t                                        oldest_samps = hi as f32;\n964\t                                    }\n965\t                                    stack.pop();\n966\t                                }\n967\t                                InternalState::CloseVectIndex => {\n968\t                                    let val_node = &arena.nodes[node_head];\n969\t                                    let vi = match val_node.tok.token_type {\n970\t                                        TokenType::Float => val_node.tok.value.unwrap_or(0.0) as i32,\n971\t                                        TokenType::Int => val_node.tok.int_value.unwrap_or(0),\n972\t                                        _ => 0,\n973\t                                    };\n974\t                                    arena.nodes[below2].vector_index = vi;\n975\t                                    if vi > 0 {\n976\t                                        error = Some(\"Vector indexing not yet implemented.\");\n977\t                                        break;\n978\t                                    }\n979\t                                    if vi < 0 || vi >= vector_size {\n980\t                                        error = Some(\"Vector index outside input size.\");\n981\t                                        break;\n982\t                                    }\n983\t                                    stack.pop();\n984\t                                }\n985\t                                _ => {\n986\t                                    // swap node down: not applicable when below2 is also Node\n987\t                                    let tmp = stack[top_idx - 1];\n988\t                                    stack[top_idx - 1] = stack[top_idx];\n989\t                                    stack[top_idx] = tmp;\n990\t                                }\n991\t                            }\n992\t                        } else {\n993\t                            // swap node down\n994\t                            let tmp = stack[top_idx - 1];\n995\t                            stack[top_idx - 1] = stack[top_idx];\n996\t                            stack[top_idx] = tmp;\n997\t                        }\n998\t                    } else {\n999\t                        // top_idx == 1, below is state but no top-2; swap\n1000\t                        let tmp = stack[top_idx - 1];\n1001\t                        stack[top_idx - 1] = stack[top_idx];\n1002\t                        stack[top_idx] = tmp;\n1003\t                    }\n1004\t                } else {\n1005\t                    // below is also a node — shouldn't happen often.\n1006\t                }\n1007\t                continue;\n1008\t            }\n1009\t            StackEntry::State(state) => {\n1010\t                match state {\n1011\t                    InternalState::YEqualY => {\n1012\t                        if cur_tok.token_type == TokenType::Var && cur_tok.var == Some('y') {\n1013\t                            stack.pop();\n1014\t                        } else {\n1015\t                            error = Some(\"Error in y= prefix.\");\n1016\t                            break;\n1017\t                        }\n1018\t                        next_token = true;\n1019\t                    }\n1020\t                    InternalState::YEqualEq => {\n1021\t                        if cur_tok.token_type == TokenType::Op && cur_tok.op == Some('=') {\n1022\t                            stack.pop();\n1023\t                        } else {\n1024\t                            error = Some(\"Error in y= prefix.\");\n1025\t                            break;\n1026\t                        }\n1027\t                        next_token = true;\n1028\t                    }\n1029\t                    InternalState::Expr => {\n1030\t                        stack.pop();\n1031\t                        stack.push(StackEntry::State(InternalState::ExprRight));\n1032\t                        stack.push(StackEntry::State(InternalState::Term));\n1033\t                    }\n1034\t                    InternalState::ExprRight => {\n1035\t                        if cur_tok.token_type == TokenType::Op {\n1036\t                            stack.pop();\n1037\t                            let op = cur_tok.op.unwrap_or(' ');\n1038\t                            if op == '+' || op == '-' {\n1039\t                                // APPEND_OP\n1040\t                                if let Some(StackEntry::Node(head)) = stack.last().copied() {\n1041\t                                    let last = arena.last_in_chain(head);\n1042\t                                    let is_float_prev = arena.nodes[last].is_float;\n1043\t                                    let new_idx = arena.alloc(cur_tok, 0, None);\n1044\t                                    arena.nodes[new_idx].is_float = is_float_prev;\n1045\t                                    arena.nodes[last].next = Some(new_idx);\n1046\t                                }\n1047\t                                stack.push(StackEntry::State(InternalState::Expr));\n1048\t                                next_token = true;\n1049\t                            }\n1050\t                        } else {\n1051\t                            stack.pop();\n1052\t                        }\n1053\t                    }\n1054\t                    InternalState::Term => {\n1055\t                        stack.pop();\n1056\t                        stack.push(StackEntry::State(InternalState::TermRight));\n1057\t                        stack.push(StackEntry::State(InternalState::Value));\n1058\t                    }\n1059\t                    InternalState::TermRight => {\n1060\t                        if cur_tok.token_type == TokenType::Op {\n1061\t                            stack.pop();\n1062\t                            let op = cur_tok.op.unwrap_or(' ');\n1063\t                            if op == '*' || op == '/' {\n1064\t                                if let Some(StackEntry::Node(head)) = stack.last().copied() {\n1065\t                                    let last = arena.last_in_chain(head);\n1066\t                                    let is_float_prev = arena.nodes[last].is_float;\n1067\t                                    let new_idx = arena.alloc(cur_tok, 0, None);\n1068\t                                    arena.nodes[new_idx].is_float = is_float_prev;\n1069\t                                    arena.nodes[last].next = Some(new_idx);\n1070\t                                }\n1071\t                                stack.push(StackEntry::State(InternalState::Term));\n1072\t                                next_token = true;\n1073\t                            }\n1074\t                        } else {\n1075\t                            stack.pop();\n1076\t                        }\n1077\t                    }\n1078\t                    InternalState::Value => {\n1079\t                        match cur_tok.token_type {\n1080\t                            TokenType::Int => {\n1081\t                                stack.pop();\n1082\t                                let idx = arena.alloc(cur_tok, 0, None);\n1083\t                                stack.push(StackEntry::Node(idx));\n1084\t                                next_token = true;\n1085\t                            }\n1086\t                            TokenType::Float => {\n1087\t                                stack.pop();\n1088\t                                let idx = arena.alloc(cur_tok, 1, None);\n1089\t                                stack.push(StackEntry::Node(idx));\n1090\t                                next_token = true;\n1091\t                            }\n1092\t                            TokenType::Var => {\n1093\t                                if var_allowed {\n1094\t                                    stack.pop();\n1095\t                                    let idx = arena.alloc(cur_tok, input_is_float, None);\n1096\t                                    stack.push(StackEntry::Node(idx));\n1097\t                                    stack.push(StackEntry::State(InternalState::VarRight));\n1098\t                                    next_token = true;\n1099\t                                } else {\n1100\t                                    error = Some(\"Unexpected variable reference.\");\n1101\t                                    break;\n1102\t                                }\n1103\t                            }\n1104\t                            TokenType::OpenParen => {\n1105\t                                stack.pop();\n1106\t                                stack.push(StackEntry::State(InternalState::CloseParen));\n1107\t                                stack.push(StackEntry::State(InternalState::Expr));\n1108\t                                next_token = true;\n1109\t                            }\n1110\t                            TokenType::Func => {\n1111\t                                stack.pop();\n1112\t                                let _ = pop_func_name();\n1113\t                                let func_idx = cur_tok.int_value.unwrap_or(-1);\n1114\t                                let entry = func_by_index(func_idx);\n1115\t                                if entry.is_none() {\n1116\t                                    error = Some(\"Unknown function.\");\n1117\t                                    break;\n1118\t                                }\n1119\t                                let arity = entry.unwrap().arity;\n1120\t                                let idx = arena.alloc(cur_tok, 1, None);\n1121\t                                stack.push(StackEntry::Node(idx));\n1122\t                                if arity > 0 {\n1123\t                                    stack.push(StackEntry::State(InternalState::CloseParen));\n1124\t                                    stack.push(StackEntry::State(InternalState::Expr));\n1125\t                                    for _ in 1..arity {\n1126\t                                        stack.push(StackEntry::State(InternalState::Comma));\n1127\t                                        stack.push(StackEntry::State(InternalState::Expr));\n1128\t                                    }\n1129\t                                    stack.push(StackEntry::State(InternalState::OpenParen));\n1130\t                                }\n1131\t                                next_token = true;\n1132\t                            }\n1133\t                            TokenType::Op if cur_tok.op == Some('-') => {\n1134\t                                stack.pop();\n1135\t                                stack.push(StackEntry::State(InternalState::Negate));\n1136\t                                stack.push(StackEntry::State(InternalState::Value));\n1137\t                                next_token = true;\n1138\t                            }\n1139\t                            _ => {\n1140\t                                error = Some(\"Expected value.\");\n1141\t                                break;\n1142\t                            }\n1143\t                        }\n1144\t                    }\n1145\t                    InternalState::Negate => {\n1146\t                        stack.pop();\n1147\t                        if let Some(StackEntry::Node(head)) = stack.last().copied() {\n1148\t                            // create '0' node, then '-' op, then collapse with head\n1149\t                            let zero_tok = Token {\n1150\t                                token_type: TokenType::Int,\n1151\t                                value: None,\n1152\t                                int_value: Some(0),\n1153\t                                var: None,\n1154\t                                op: None,\n1155\t                            };\n1156\t                            let zero_idx = arena.alloc(zero_tok, 0, None);\n1157\t                            let minus_tok = Token {\n1158\t                                token_type: TokenType::Op,\n1159\t                                value: None,\n1160\t                                int_value: None,\n1161\t                                var: None,\n1162\t                                op: Some('-'),\n1163\t                            };\n1164\t                            let minus_idx = arena.alloc(minus_tok, 0, None);\n1165\t                            arena.nodes[zero_idx].next = Some(minus_idx);\n1166\t                            let new_head = arena_collapse(&mut arena, zero_idx, head, true);\n1167\t                            *stack.last_mut().unwrap() = StackEntry::Node(new_head);\n1168\t                        } else {\n1169\t                            error = Some(\"Expected to negate an expression.\");\n1170\t                            break;\n1171\t                        }\n1172\t                    }\n1173\t                    InternalState::VarRight => {\n1174\t                        if cur_tok.token_type == TokenType::OpenSquare {\n1175\t                            stack.pop();\n1176\t                            stack.push(StackEntry::State(InternalState::VarVectIndex));\n1177\t                        } else if cur_tok.token_type == TokenType::OpenCurly {\n1178\t                            stack.pop();\n1179\t                            stack.push(StackEntry::State(InternalState::VarHistIndex));\n1180\t                        } else {\n1181\t                            stack.pop();\n1182\t                        }\n1183\t                    }\n1184\t                    InternalState::VarVectIndex => {\n1185\t                        stack.pop();\n1186\t                        if cur_tok.token_type == TokenType::OpenSquare {\n1187\t                            var_allowed = false;\n1188\t                            stack.push(StackEntry::State(InternalState::CloseVectIndex));\n1189\t                            stack.push(StackEntry::State(InternalState::Expr));\n1190\t                            next_token = true;\n1191\t                        }\n1192\t                    }\n1193\t                    InternalState::VarHistIndex => {\n1194\t                        stack.pop();\n1195\t                        if cur_tok.token_type == TokenType::OpenCurly {\n1196\t                            var_allowed = false;\n1197\t                            stack.push(StackEntry::State(InternalState::CloseHistIndex));\n1198\t                            stack.push(StackEntry::State(InternalState::Expr));\n1199\t                            next_token = true;\n1200\t                        }\n1201\t                    }\n1202\t                    InternalState::CloseVectIndex => {\n1203\t                        if cur_tok.token_type == TokenType::CloseSquare {\n1204\t                            var_allowed = true;\n1205\t                            stack.pop();\n1206\t                            stack.push(StackEntry::State(InternalState::VarHistIndex));\n1207\t                            next_token = true;\n1208\t                        } else {\n1209\t                            error = Some(\"Expected ']'.\");\n1210\t                            break;\n1211\t                        }\n1212\t                    }\n1213\t                    InternalState::CloseHistIndex => {\n1214\t                        if cur_tok.token_type == TokenType::CloseCurly {\n1215\t                            var_allowed = true;\n1216\t                