d->rule);\n1305\t      mmz[slot]->nodes[cur_node++] = ast->nodes[ast->par[k]];\n1306\t    }\n1307\t  }\n1308\t}\n1309\t\n1310\tvoid skp_mmz_add(ast_t ast, ast_mmz_t *mmz)\n1311\t{\n1312\t  int32_t new_max;\n1313\t  ast_mmz_t  **new_mmz;\n1314\t  if (ast->mmz_cnt >= ast->mmz_max) {\n1315\t    new_max = ast->mmz_max;\n1316\t    new_max += new_max/2;\n1317\t    new_max += new_max&1;\n1318\t    new_mmz = realloc(ast->mmz,new_max * sizeof(ast_mmz_t *));\n1319\t    assert(new_mmz);\n1320\t    ast->mmz = new_mmz;\n1321\t    ast->mmz_max = new_max;\n1322\t  }\n1323\t  ast->mmz[ast->mmz_cnt++] = mmz;\n1324\t}\n1325\t\n1326\tvoid skp_mmz_clean(ast_t ast)\n1327\t{\n1328\t  ast_mmz_t *mmz;\n1329\t _skptrace(\"MMZ clean: %p (%d)\",(void *)ast->mmz,ast->mmz_cnt);\n1330\t  while (ast->mmz_cnt) {\n1331\t    mmz = ast->mmz[--ast->mmz_cnt];\n1332\t    for (int k=0; k<4; k++) {\n1333\t     _skptrace(\"MMZ clean: %p %p\",(void *)mmz,(void *)mmz[k]);\n1334\t      if (mmz[k]) free(mmz[k]); \n1335\t      mmz[k] = SKP_MMZ_NULL;\n1336\t    }\n1337\t  }\n1338\t  ast->mmz_cnt = 0;\n1339\t}\n1340\t\n1341\t#define SKP_DELTA_MAX INT32_MAX\n1342\tint skp_dememoize(ast_t ast, ast_mmz_t *mmz, char *rule)\n1343\t{\n1344\t _skptrace(\"MM?: '%s' %d\",rule,ast->pos);\n1345\t  if (mmz[0] == SKP_MMZ_NULL) {\n1346\t    skp_mmz_add(ast, mmz);\n1347\t    for (int k=0; k<4; k++) mmz[k] = NULL;\n1348\t   _skptrace(\"MM?: first mmz\");\n1349\t    return 0;\n1350\t  }\n1351\t  // Search for pos\n1352\t  int slot = 0;\n1353\t  while(1) {\n1354\t   _skptrace(\"MM?:   search %d\",slot);\n1355\t    if (mmz[slot] && (mmz[slot]->pos == ast->pos)) break;\n1356\t    if (++slot >= 4) return 0;\n1357\t  }\n1358\t  int32_t numnodes = mmz[slot]->numnodes;\n1359\t _skptrace(\"MM?: found at %d (nodes: %d)\",slot,numnodes);\n1360\t  int32_t cur_par, delta;\n1361\t  ast->fail = (numnodes < 0); // restore fail flag\n1362\t  ast->lastpos = ast->pos;\n1363\t  ast->pos = mmz[slot]->endpos;\n1364\t  ast->lastinfo = mmz[slot]->lasti