possibly with sign and exponent)\n111\t   X  hex number (possibly with leading 0x)\n112\t\n113\t   C  case sensitive (ASCII) comparison\n114\t   U  utf-8 encoding (or ASCII/ISO-8859)\n115\t\n116\t   *  zero or more match\n117\t   ?  zero or one match\n118\t   +  one or more match\n119\t   !  negate\n120\t\n121\t   &  set goal\n122\t   !& set negative goal\n123\t\n124\t   [...] set\n125\t  \n126\t   .  (any non \\0 character)\n127\t   !. (end of text)\n128\t\n129\t   >  skip to the start of pattern\n130\t\n131\t   & the character '&'\n132\t*/\n133\t\n134\tvolatile int skp_zero = 0;\n135\t\n136\tstatic uint32_t skp_next(char *s,char **end,int iso)\n137\t{\n138\t  uint32_t c = 0;\n139\t\n140\t  if (s && *s) {\n141\t    c = *s++;\n142\t    if (!iso) {\n143\t#if 1\n144\t      if ((*s & 0xC0) == 0x80) {\n145\t        c = (c << 8) | *s++;\n146\t        if ((*s & 0xC0) == 0x80) {\n147\t          c = (c << 8) | *s++;\n148\t          if ((*s & 0xC0) == 0x80) {\n149\t            c = (c << 8) | *s++;\n150\t          }\n151\t        }\n152\t      }\n153\t#else\n154\t      while ((*s & 0xC0) == 0x80) {\n155\t        c = (c << 8) | *s++;\n156\t      }\n157\t#endif\n158\t    }\n159\t    if (c == 0x0D && *s == 0x0A) {\n160\t      c = 0x0D0A; s++;\n161\t    }\n162\t  }\n163\t\n164\t  if (end) *end = s;\n165\t  return c;\n166\t}\n167\t\n168\tstatic int chr_cmp(uint32_t a, uint32_t b, int fold)\n169\t{ _skptrace(\"CMP: %d %c %c\",fold, a,b);\n170\t  if (fold && a <= 0x7F && b <= 0x7F) {\n171\t    a = tolower(a);\n172\t    b = tolower(b);\n173\t  }\n174\t  return (a == b);\n175\t}\n176\t\n177\tstatic int is_blank(uint32_t c)\n178\t{\n179\t#if 1  \n180\t\n181\t  if (c < 0xFF) return  (c == 0x20) || (c == 0x09);\n182\t\n183\t  switch ( c & 0xFFFFFF00) {\n184\t    case 0x00000000 : return c == 0xA0; \n185\t    case 0x0000C200 : return c == 0xC2A0;\n186\t\n187\t    case 0x00E19A00 : return c == 0xE19A80;\n188\t\n189\t    case 0x00E28000 : return ((0xE28080 <= c) && (c <= 0xE2808A))\n190\t                             || (c == 0xE280AF);\n191\t\n192\t    case 0x00E38080 : return c == 0xE38080;\n193\t  }\n194\t  return 0;\n195\t#else\n196\t  return (c == 0x20) || (c == 0x09)\n197\t      || (c == 0xA0) || (c == 0xC2A0)\n198\t      || (c == 0xE19A80)\n199\t      || ((0xE28080 <= c) && (c <= 0xE2808A))\n200\t      || (c == 0xE280AF)\n201\t      || (c == 0xE2819F)\n202\t      || (c == 0xE38080)\n203\t      ;\n204\t#endif\n205\t}\n206\t\n207\tstatic int is_break(uint32_t c)\n208\t{\n209\t#if 1\n210\t  if (c < 0x0F) return  (c == 0x0A)\n211\t                     || (c == 0x0C)\n212\t                     || (c == 0x0D);\n213\t\n214\t  if (c < 0xFF) return (c == 0x85);\n215\t\n216\t  return (c == 0x0D0A)    // CRLF (not a real UTF-8 CODEPOINT!!!)\n217\t      || (c == 0xC285)    // U+0085 NEL next line         \n218\t      || (c == 0xE280A8)  // U+2028 LS line separator     \n219\t      || (c == 0xE280A9)  // U+2029 PS paragraph separator\n220\t      ;\n221\t\n222\t#else\n223\t  return (c == 0x0A)      // U+000A LF line feed           \n224\t      || (c == 0x0C)      // U+000C FF form feed          \n225\t      || (c == 0x0D)      // U+000D CR carriage return     \n226\t      || (c == 0x85)      // U+0085 NEL next line   ISO-8859-15      \n227\t      || (c == 0x0D0A)    // CRLF (not a real UTF-8 CODEPOINT!!!)\n228\t      || (c == 0xC285)    // U+0085 NEL next line         \n229\t      || (c == 0xE280A8)  // U+2028 LS line separator     \n230\t      || (c == 0xE280A9)  // U+2029 PS paragraph separator\n231\t      ;\n232\t#endif\n233\t}\n234\t\n235\tstatic int is_space(uint32_t c)\n236\t{ return is_blank(c) || is_break(c); }\n237\t\n238\tstatic int is_digit(uint32_t c)\n239\t{ return ('0' <= c && c <= '9'); }\n240\t\n241\tstatic int is_xdigit(uint32_t c)\n242\t{\n243\t  return ('0' <= c && c <= '9')\n244\t      || ('A' <= c && c <= 'F')\n245\t      || ('a' <= c && c <= 'f');\n246\t}\n247\t\n248\tstatic int is_upper(uint32_t c)\n249\t{ return ('A' <= c && c <= 'Z'); }\n250\t\n251\tstatic int is_lower(uint32_t c)\n252\t{ return ('a' <= c && c <= 'z'); }\n253\t\n254\tstatic int is_alpha(uint32_t c)\n255\t{ return ('A' <= c && c <= 'Z')\n256\t      || ('a' <= c && c <= 'z'); }\n257\t\n258\tstatic int is_idchr(uint32_t c)\n259\t{ return ('A' <= c && c <= 'Z')\n260\t      || ('a' <= c && c <= 'z')\n261\t      || ('0' <= c && c <= '9')\n262\t      || (c == '_'); }\n263\t\n264\tstatic int is_alnum(uint32_t c)\n265\t{ return (is_alpha(c) || is_digit(c)); }\n266\t\n267\tstatic int is_ctrl(uint32_t c)\n268\t{ return (c < 0x20)\n269\t      || (0xC280 <= c && c < 0xC2A0)\n270\t      || (0x7F <= c && c < 0xA0);\n271\t}\n272\t\n273\tstatic int is_oneof(uint32_t ch, char *set, int iso)\n274\t{\n275\t  uint32_t p_ch,q_ch;\n276\t  char *s;\n277\t  if (ch == '\\0') return 0;\n278\t\n279\t _skptrace(\"set: <%s> chr: %c\",set,ch);\n280\t  p_ch = skp_next(set,&s,iso);\n281\t  \n282\t  if (p_ch == ']') {\n283\t    if (ch == ']') return 1 ;\n284\t    else p_ch = skp_next(s,&s,iso);\n285\t  }\n286\t\n287\t  while (p_ch != ']') {\n288\t    if (p_ch == ch) return 1;\n289\t    q_ch = p_ch;\n290\t    p_ch = skp_next(s,&s,iso);\n291\t    if ((p_ch == '-') && (*s != ']')) {\n292\t      p_ch = skp_next(s,&s,iso);\n293\t      if ((q_ch < ch) && (ch <= p_ch)) return 1;\n294\t      p_ch = skp_next(s,&s,iso);\n295\t    }\n296\t  }\n297\t  p_ch = skp_next(s,&s,iso);\n298\t  return 0;\n299\t}\n300\t\n301\tstatic int is_string(char *s, char *p, int len, int flg)\n302\t{\n303\t  char *start = s;\n304\t  uint32_t p_chr,s_chr;\n305\t  char *p_end, *s_end;\n306\t  int mlen = 0;\n307\t _skptrace(\"STR: %d '%s' '%.*s'\",len,s,len,p);\n308\t  while (len) {\n309\t   _skptrace(\"ALT: %d '%s' '%s'\",len, p,s);\n310\t    if (*p == '\\xE') return mlen;\n311\t\n312\t    p_chr = skp_next(p,&p_end,flg & 2);\n313\t    s_chr = skp_next(s,&s_end,flg & 2);\n314\t\n315\t    if (chr_cmp(s_chr,p_chr,flg & 1)) {\n316\t      mlen += (int)(s_end - s);\n317\t      len  -= (int)(p_end - p);\n318\t      //if (*s_end == '\\0') return mlen;\n319\t      p = p_end;  s = s_end;\n320\t    }\n321\t    else {\n322\t      while (len>0 && *p++ != '\\xE') len--; // search for an alternative\n323\t      if (len-- <= 0) return 0;\n324\t      s = start;\n325\t      mlen = 0;\n326\t     _skptrace(\"ALT2: %d p:'%.*s' s:'%s'\",len,len,p,s);\n327\t    }\n328\t  }\n329\t _skptrace(\"MRET: %d\",mlen);\n330\t  return mlen;\n331\t}\n332\t\n333\tstatic uint32_t get_close(uint32_t open)\n334\t{\n335\t   switch(open) {\n336\t     case '(': return ')';\n337\t     case '[': return ']';\n338\t     case '{': return '}';\n339\t     case '<': return '>';\n340\t   }\n341\t   return 0;\n342\t}\n343\t\n344\tstatic uint32_t get_qclose(uint32_t open)\n345\t{\n346\t   switch(open) {\n347\t     case '\\'':\n348\t     case '\"' :\n349\t     case '`' : return open;\n350\t   }\n351\t   return 0;\n352\t}\n353\t\n354\t#define MATCHED_FAIL    0 \n355\t#define MATCHED         1\n356\t#define MATCHED_GOAL    2\n357\t#define MATCHED_GOALNOT 3\n358\t\n359\tstatic int match(char *pat, char *src, char **pat_end, char **src_end,int *flg)\n360\t{\n361\t  uint32_t s_chr;\n362\t  char *p_end, *s_end;\n363\t  int ret = MATCHED_FAIL;\n364\t  uint32_t match_min = 1;\n365\t  uint32_t match_max = 1;\n366\t  uint32_t match_cnt = 0;\n367\t  uint32_t match_not = 0;\n368\t  int intnumber  = false;\n369\t  char *s_tmp = src;\n370\t  \n371\t  s_end = src;\n372\t  s_chr = skp_next(s_end, &s_tmp,*flg & 2);\n373\t\n374\t    if (*pat == '*') { match_min = 0;  match_max = UINT32_MAX; pat++; } \n375\t    else if (*pat == '+') { match_max = UINT32_MAX; pat++; } \n376\t    else if (*pat == '?') { match_min = 0; pat++; }\n377\t    \n378\t    if (*pat == '!') { match_not = 1; pat++; }\n379\t   _skptrace(\"min: %u max: %u not: %u\",match_min, match_max, match_not);\n380\t\n381\t    #define W(x)  \\\n382\t      do { \\\n383\t       _skptrace(\"matchedW: '%s' schr: %X test: %d (%s)\",s_end,s_chr,(x),#x); \\\n384\t        for (match_cnt = 0; \\\n385\t             (match_cnt < match_max) && (s_chr && (!!(x) != match_not)); \\\n386\t             match_cnt++) { \\\n387\t          s_end = s_tmp; s_chr = skp_next(s_end,&s_tmp,*flg & 2); \\\n388\t        } \\\n389\t        ret = (match_cnt >= match_min); \\\n390\t       _skptrace(\"cnt: %d ret: %d s: %c end: %c\",match_cnt,ret,*s_tmp, *s_end); \\\n391\t      } while (0)\n392\t\n393\t    #define get_next_s_chr() do {s_end = s_tmp; s_chr = *s_end ; s_tmp++;} while(0)\n394\t    \n395\t    intnumber = false;\n396\t    \n397\t    switch (*pat++) {\n398\t\n399\t      case '.' : if (match_not) ret = (s_chr == 0);\n400\t                 else W(s_chr != 0);\n401\t                 break;\n402\t\n403\t      case '$' : if (s_chr == 0) ret = 1; else \n404\t      case 'n' : W(is_break(s_chr));\n405\t                 break;\n406\t\n407\t      case 'd' : W(is_digit(s_chr));  break;\n408\t      case 'x' : W(is_xdigit(s_chr)); break;\n409\t      case 'a' : W(is_alpha(s_chr));  break;\n410\t      case 'u' : W(is_upper(s_chr));  break;\n411\t      case 'l' : W(is_lower(s_chr));  break;\n412\t      case 's' : W(is_space(s_chr));  break;\n413\t      case 'w' : W(is_blank(s_chr));  break;\n414\t      case 'c' : W(is_ctrl(s_chr));   break;\n415\t      case 'i' : W(is_idchr(s_chr));  break;\n416\t      case '@' : W(is_alnum(s_chr));  break;\n417\t      \n418\t      case '&' : ret = match_not? MATCHED_GOALNOT : MATCHED_GOAL;\n419\t                 break;\n420\t\n421\t      case '[' : W(is_oneof(s_chr,pat,*flg & 2));\n422\t                 if (*pat == ']') pat++;\n423\t                 while (*pat && *pat != ']') pat++;\n424\t                 pat++;\n425\t                 break;\n426\t\n427\t      case '\"' : case '\\'': case '`': {\n428\t                 int l = 0; int ml ; uint32_t quote = pat[-1];\n429\t                 while (pat[l] && pat[l] != quote) l++;\n430\t                 if (l>0 && ((ml=is_string(s_end,pat,l,*flg)) > 0)) {\n431\t                   if (!match_not) {\n432\t                     s_end += ml;\n433\t                     ret = MATCHED;\n434\t                   }\n435\t                 }\n436\t                 else if (match_min == 0 || match_not) ret = MATCHED;\n437\t                 pat += l+1;\n438\t                 break;  \n439\t               }\n440\t    \n441\t      case 'C' : *flg = (*flg & ~1) | match_not; ret = MATCHED;\n442\t                _skptrace(\"FOLD: %d\",*flg & 1);\n443\t                 break;\n444\t\n445\t      case 'U' : *flg = (*flg & ~2) | (match_not * 2); ret = MATCHED;\n446\t                 break;\n447\t\n448\t      case 'S' : while (is_space(s_chr)) get_next_s_chr();;\n449\t                 ret = MATCHED;\n450\t                 break;\n451\t\n452\t      case 'W' : while (is_blank(s_chr)) get_next_s_chr();;\n453\t                 ret = MATCHED;\n454\t                 break;\n455\t\n456\t      case 'N' : // Up to end of line\n457\t                 while(s_chr && !is_break(s_chr)) {\n458\t                    get_next_s_chr();\n459\t                 }\n460\t                 if (s_chr) get_next_s_chr();\n461\t                 ret = MATCHED;\n462\t                 break;\n463\t\n464\t      case 'I' : // Identifier\n465\t                 if (is_alpha(s_chr) || (s_chr == '_')) {\n466\t                   do {\n467\t                     get_next_s_chr();\n468\t                   } while (is_alnum(s_chr) || (s_chr == '_'));\n469\t                   ret = MATCHED;\n470\t                 } \n471\t                 break;\n472\t\n473\t      case '(' : if (*pat != ')' || s_chr != '(') break;\n474\t                 pat++;\n475\t\n476\t      case 'B' : // Balanced parenthesis\n477\t                 {\n478\t                   uint32_t open;\n479\t                   uint32_t close;\n480\t                   int32_t count;\n481\t                   open = s_chr;\n482\t                   close = get_close(open);\n483\t                   if (close != '\\0') {\n484\t                     count=1;\n485\t                     while (s_chr && count > 0) {\n486\t                       get_next_s_chr();\n487\t                       if (s_chr == open)  count++;\n488\t                       if (s_chr == close) count--;\n489\t                     }\n490\t                     if (count == 0) {\n491\t                       get_next_s_chr();\n492\t                       ret = MATCHED;\n493\t                     }\n494\t                   }\n495\t                 }\n496\t                 break;\n497\t\n498\t      case 'Q' : // Quoted string\n499\t                 {\n500\t                   uint32_t qclose;\n501\t                   qclose = get_qclose(s_chr);\n502\t                   if (qclose != '\\0') {\n503\t                     while (s_chr) {\n504\t                       get_next_s_chr();\n505\t                       if (s_chr == qclose) break;\n506\t                       if (s_chr == '\\\\')  get_next_s_chr();\n507\t                     }\n508\t                     if (s_chr) {\n509\t                       get_next_s_chr();\n510\t                       ret = MATCHED;\n511\t                     }\n512\t                   }\n513\t                 }\n514\t                 break;\n515\t\n516\t      case 'X' : // hex number\n517\t                 if (   (s_chr == '0')\n518\t                     && (s_end[1] == 'x' || s_end[1] == 'X') \n519\t                     && is_xdigit(s_end[2])\n520\t                    ) {\n521\t                   get_next_s_chr();\n522\t                   get_next_s_chr();\n523\t                   get_next_s_chr();\n524\t                   ret = MATCHED;\n525\t                 } \n526\t                 while (is_xdigit(s_chr)) {\n527\t                   ret = MATCHED;\n528\t                   get_next_s_chr();\n529\t                 }\n530\t                 break;\n531\t\n532\t      case 'D' : // Integer number \n533\t                intnumber = true;\n534\t\n535\t      case 'F' : // Floating point number\n536\t                 if (s_chr == '+' || s_chr == '-') { // sign\n537\t                   do {\n538\t                     get_next_s_chr();\n539\t                   } while (is_space(s_chr));\n540\t                 } \n541\t   \n542\t                 while (is_digit(s_chr)) {\n543\t                   ret = MATCHED;\n544\t                   get_next_s_chr();\n545\t                 }\n546\t \n547\t                 if (intnumber) break;\n548\t \n549\t                 if (s_chr == '.') {\n550\t                   get_next_s_chr();\n551\t                 }\n552\t \n553\t                 while (is_digit(s_chr)) {\n554\t                   ret = MATCHED;\n555\t                   get_next_s_chr();\n556\t                 }\n557\t   \n558\t                 if ((ret == MATCHED) && (s_chr == 'E' || s_chr == 'e')) {\n559\t                   get_next_s_chr();\n560\t                   if (s_chr == '+' || s_chr == '-')  get_next_s_chr();\n561\t                   while (is_digit(s_chr)) get_next_s_chr();\n562\t                   if (s_chr == '.') get_next_s_chr();\n563\t                   while (is_digit(s_chr)) get_next_s_chr();\n564\t                 }\n565\t \n566\t                 break;\n567\t\n568\t      default  : ret = MATCHED_FAIL; pat--; break;\n569\t    }\n570\t    p_end = pat;\n571\t\n572\t  if (ret != MATCHED_FAIL) {\n573\t    if (pat_end) *pat_end = p_end;\n574\t    if (src_end) *src_end = s_end;\n575\t  }\n576\t  return ret;\n577\t}\n578\t\n579\tint skp_(char *src, char *pat, char **to,char **end)\n580\t{\n581\t  char *start = src;\n582\t  char *s; char *p;\n583\t  char *s_end=NULL; char *p_end=NULL;\n584\t  int   skp_to = 0;\n585\t  int   matched = 0;\n586\t  int   ret = 0;\n587\t  char *goal = NULL;\n588\t  char *goalnot = NULL;\n589\t  int   flg = 0;\n590\t\n591\t  if (!pat || !src) { return 0; }\n592\t\n593\t _skptrace(\"SKP_: src:'%s' pat:'%s'\",src,pat);\n594\t\n595\t  if (*pat == '>') {\n596\t    skp_to = 1;\n597\t    pat++ ;\n598\t  }\n599\t _skptrace(\"SKP_: src:'%s' pat:'%s' skp_to:%d\",src,pat,skp_to);\n600\t\n601\t  p = pat;\n602\t  s = start;\n603\t  while (is_space(*p)) p++;\n604\t  while (*p > '\\7') {\n605\t    \n606\t    if ((matched = match(p,s,&p_end,&s_end,&flg))) {\n607\t     _skptrace(\"matched( '%s' '%s'\",s,p);\n608\t      s = s_end; p = p_end;\n609\t     _skptrace(\"matched) '%s' '%s'\",s,p);\n610\t      if (matched == MATCHED_GOAL && !goalnot) goal = s;\n611\t      else if (matched == MATCHED_GOALNOT) { goalnot = s; /* skptrace(\"!GOAL: %.4s\",s);*/ }\n612\t    }\n613\t    else {\n614\t     _skptrace(\"notmatched  '%s' '%s'\",s,p);\n615\t      while (*p > '\\7') p++;\n616\t     _skptrace(\"notmatched+ '%s' '%s'\",s,p);\n617\t      if ((*p > '\\0') && (p[1] > '\\0')) { // Try a new pattern\n618\t        s = start;\n619\t        p++;\n620\t       _skptrace(\"resume from: %s (%c)\", p,*s);\n621\t      }\n622\t      else if (skp_to) {\n623\t        goal = NULL;  goalnot = NULL;\n624\t        p = pat;\n625\t        s = ++start;\n626\t       _skptrace(\"retry '%s'\",s);\n627\t        if (*s == '\\0') break;\n628\t      }\n629\t      else break;\n630\t    }\n631\t    while (is_space(*p)) p++;\n632\t  }\n633\t\n634\t _skptrace(\"pat: '%s'\",p);\n635\t\n636\t  if (!matched && goalnot) {\n637\t    goal = goalnot;\n638\t    matched = MATCHED;\n639\t    p=\"\";\n640\t  }\n641\t\n642\t  if (goal) s = goal;\n643\t\n644\t  if (matched && (*p <= '\\7')) {\n645\t    ret = (*p > 0)? *p : 1;\n646\t\n647\t    if (to)  *to  = skp_to?start:s;\n648\t    if (end) *end = s;\n649\t    return ret;\n650\t  }\n651\t\n652\t  if (to)  *to  = src;\n653\t  if (end) *end = src;\n654\t  return 0;\n655\t}\n656\t\n657\t#endif // SKP_MAIN\n658\t\n659\t// ************************************************************ \n660\t// PARSE ******************************************************\n661\t// ************************************************************ \n662\t\n663\textern char *skp_N__STRING;\n664\t\n665\t/* \n666\t## Parsing\n667\t```\n668\t                ,-------,            ,-------,\n669\t  sourcefile -->| parse | --> AST -->| visit | --> output\n670\t                '-------'            '-------'\n671\t```\n672\t\n673\t## AST representation\n674\t\n675\t The basic idea is that a tree is represented in its \"parenthesized\" form.\n676\t For exampke, the `(()())` tree has three nodes: the root and its two child:\n677\t This is represented as an array of integers: non negative numbers indicate an \n678\topen parenthesis, negative numbers a close one.\n679\t For example the array `{0,1,-1,2,-1,-5}` represents the tree `(()())`.\n680\t To summarize:\n681\t ```\n682\t     O\n683\t    / \\  <-> (()()) <-> {0,1,-1,2,-1,-5}\n684\t   O   O\n685\t```\n686\t\n687\t  Negative numbers are used to point to the corresponding open parenthesis.\n688\tYou can check in the example above that this is the case. Not that a value\n689\tof `-1` indicates that this is the closing parenthesis of a leaf.\n690\t\n691\t  The information stored in the tree is kept in a separate array of type\n692\t`ast_node_t`. Elements of this array also contain a `delta` field which \n693\trepresent the distance between the open parenthesis and its closing one.\n694\t\n695\t  In the picture below:\n696\t    - the open parenthesis value is `i`\n697\t    - the `delta` field of the node in position `i` contains `n`\n698\t    - the close parenthesis is `n` element away from the open parenthesis\n699\t    - the close parenthesis value is `-n`.\n700\t\n701\t```\n702\t      i\n703\t  [ … n ───╮ … ]  ◄─── Array of ast_node_t\n704\t      ▲    │\n705\t      │    ▼ \n706\t      ( …… )       \n707\t  [ … i … -n … ]  ◄─── Array of int32_t\n708\t      ▲    │\n709\t      ╰────╯\n710\t  n is the delta between open and close parenthesis.\n711\t```\n712\t*/\n713\ttypedef int32_t astnode_t;\n714\t\n715\ttypedef struct ast_node_s {\n716\t  char   *rule;\n717\t  astnode_t from;\n718\t  astnode_t to;\n719\t  int32_t delta; // delta between parenthesis (>0)\n720\t  int32_t tag;  // on 64bit systems this would be allocated anyway.\n721\t} ast_node_t;\n722\t\n723\ttypedef struct ast_mmz_s {\n724\t  int32_t pos;\n725\t  int32_t endpos;\n726\t  int32_t numnodes;\n727\t  int32_t maxnodes;\n728\t  int32_t lastinfo;\n729\t  ast_node_t nodes[0];\n730\t} *ast_mmz_t;\n731\t\n732\t#define SKP_MMZ_NULL ((ast_mmz_t)-1)\n733\ttypedef struct ast_s *ast_t;\n734\t\n735\ttypedef struct ast_s {\n736\t  char       *start;\n737\t  char       *err_rule;\n738\t  char       *err_msg;\n739\t  char       *cur_rule;\n740\t  ast_node_t *nodes;\n741\t  ast_mmz_t **mmz;\n742\t  int32_t    *par;  // ≥ 0 ⇒ Open parenthesis (index into the nodes array)\n743\t                    // < 0 ⇒ Closed parenthesis (delta to the open par.)\n744\t  void       *auxptr;\n745\t  jmp_buf     jbuf;\n746\t  int32_t     nodes_cnt;\n747\t  int32_t     nodes_max;\n748\t  int32_t     par_cnt;\n749\t  int32_t     par_max;\n750\t  int32_t     mmz_cnt;\n751\t  int32_t     mmz_max;\n752\t  int32_t     pos;\n753\t  int32_t     lastpos;\n754\t  int32_t     err_pos;\n755\t  int32_t     cur_node;\n756\t  int32_t     lastinfo;\n757\t  int32_t     ret;\n758\t  uint16_t    depth;\n759\t  int8_t      fail;\n760\t  int8_t      flg;\n761\t} *ast_t;\n762\t\n763\t#define SKP_DEBUG     0x01\n764\t#define SKP_LEFTRECUR 0x02\n765\t#define SKP_MAXDEPTH  10000\n766\t\n767\t#define skpdebug(...) skp_vrg(skp_debug,__VA_ARGS__)\n768\t#define skp_debug(a)  skp_debug2(a,0xFF)\n769\tint skp_debug2(ast_t ast,uint8_t d);\n770\t\n771\t#define astfailed (astcur->fail)\n772\t#define astfail ((astcur->fail) = 1)\n773\t#define astmatch ((astcur->fail) = 0)\n774\t\n775\t#define astaux(a) ((a)->auxptr)\n776\t\n777\t//  Getting error infomration\n778\tchar   *asterrrule(ast_t ast);   // ◄── Which rule we got the error\n779\tchar   *asterrpos(ast_t ast);    // ◄── Where the error has been detected\n780\t\n781\t//  The error message set with skperror() \n782\t#define asterrmsg(a) ((a)->err_msg)\n783\t\n784\tchar *asterrline(ast_t ast);     // ◄── start of the line with the error\n785\t// asterrlinenum  Line number\n786\t\n787\tint32_t asterrcolnum(ast_t ast);  // ◄── column number\n788\t\n789\tast_t ast_new();\n790\tast_t astfree(ast_t ast);\n791\t\n792\tint32_t ast_open(ast_t ast, int32_t from, char *rule);\n793\tint32_t ast_close(ast_t ast, int32_t to, int32_t open);\n794\t\n795\ttypedef void (*skprule_t)(ast_t,int32_t *);\n796\t\n797\tast_t skp_parse(char *src, skprule_t rule,char *rulename, int debug);\n798\t\n799\t#define skpparse(...)    skp_vrg(skp_parse,__VA_ARGS__)\n800\t#define skp_parse2(s,r)      skp_parse3(s,r,0)\n801\t#define skp_parse3(s,r,d)    skp_parse(s, skp_R_ ## r, skp_N_ ## r,d)\n802\t\n803\t#define skpabort(...)    skp_abort(astcurrule, (char *)(__VA_ARGS__ + 0))\n804\t#define skp_abort(r,m)   skp__abort(astcur,m,r)\n805\t\n806\t#define astabort(...) skpabort(__VA_ARGS__)\n807\t\n808\tvoid skp__abort(ast_t ast, char *msg,char *rule);\n809\t\n810\t#define astretval(n) (skp_ret[0]=(n))\n811\t#define astret (skp_ret[0])\n812\t\n813\t#define astcurptr (astcur->start+astcur->pos)\n814\t#define astprevptr (astcur->start+astcur->lastpos)\n815\t\n816\t#define skpdef(rule) \\\n817\t    char *skp_N_ ## rule = #rule; \\\n818\t    ast_mmz_t skp_M_ ## rule [4] = {SKP_MMZ_NULL, SKP_MMZ_NULL, SKP_MMZ_NULL, SKP_MMZ_NULL}; \\\n819\t    void  skp_R_ ## rule (ast_t astcur, int32_t *skp_ret) \n820\t\n821\t#define skp_match(how) \\\n822\t    if (!astfailed) { \\\n823\t      char *from_ = astcur->start+astcur->pos; int32_t par;\\\n824\t      how;\\\n825\t      if (n==0) {astfailed = 1;} \\\n826\t      else { \\\n827\t        astcur->lastinfo = n; \\\n828\t        par = ast_open(astcur,astcur->pos,skp_N__STRING);\\\n829\t        astcur->lastpos = astcur->pos; \\\n830\t        astcur->pos += len; \\\n831\t        ast_close(astcur,astcur->pos,par); \\\n832\t        astcur->nodes[astcur->par[par]].tag = n; \\\n833\t        astcur->cur_node = par; \\\n834\t      } \\\n835\t      if (astcur->flg & SKP_DEBUG) skptrace(\"%s: %s @%d\