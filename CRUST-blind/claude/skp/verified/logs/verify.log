astsettag(ast,ast->lastinfo,0);\n1422\t    }\n1423\t  }\n1424\t  skp_mmz_clean(ast);\n1425\t  return ast;\n1426\t}\n1427\t\n1428\tint ast_lastnodeisempty(ast_t ast)\n1429\t{\n1430\t  astnode_t node;\n1431\t  ast_node_t *nd;\n1432\t  node = ast_lastnode(ast);\n1433\t  if (node == ASTNULL) return 0;\n1434\t  assert(ast->par[node]>=0);\n1435\t  nd = ast->nodes+ast->par[node];\n1436\t  return (nd->from == nd->to); \n1437\t} \n1438\t\n1439\t//ast_node_t *ast_lastnode(ast_t ast)\n1440\tint32_t ast_lastnode(ast_t ast)\n1441\t{\n1442\t  // get last node!\n1443\t  //    ,------- o1\n1444\t  //   /    ,--- c1\n1445\t  //  ( ... )\n1446\t#if 0 \n1447\t  int32_t o1, c1;\n1448\t\n1449\t  if (ast->fail || ast->par_cnt < 2) return NULL;\n1450\t  \n1451\t  c1 = ast->par_cnt-1;\n1452\t  if (c1<0 || ast->par[c1] >= 0) return NULL;\n1453\t\n1454\t  o1 = c1+ast->par[c1];\n1455\t  if (o1<0 || ast->par[o1] < 0) return NULL;\n1456\t\n1457\t  return (ast->nodes+ast->par[o1]);\n1458\t#endif\n1459\t  astnode_t o1, c1;\n1460\t\n1461\t  if (ast->fail || ast->par_cnt < 2) return ASTNULL;\n1462\t  \n1463\t  c1 = ast->par_cnt-1;\n1464\t  if (c1<0 || ast->par[c1] >= 0) return ASTNULL;\n1465\t\n1466\t  o1 = c1+ast->par[c1];\n1467\t  if (o1<0 || ast->par[o1] < 0) return ASTNULL;\n1468\t\n1469\t  return (o1);\n1470\t}\n1471\t\n1472\tvoid ast_swap(ast_t ast)\n1473\t{\n1474\t  // Swap the last two nodes in the AST (if they belong to the same subtree)\n1475\t  //          ,--- o1\n1476\t  //         / ,-- c1\n1477\t  //  (BBBB)(AA)\n1478\t  //   \\   '------ c2\n1479\t  //    '--------- o2   \n1480\t  //\n1481\t  //  (AA)(BBBB)\n1482\t  //   \\  '------- o2+(c1-o1+1)\n1483\t  //    '--------- o2   \n1484\t\n1485\t  astnode_t o1, c1, o2, c2;\n1486\t\n1487\t _skptrace(\"SWAP fail? %d\",ast->fail);\n1488\t  if (ast->fail || ast->par_cnt < 4) return;\n1489\t\n1490\t  c1 = ast->par_cnt-1;\n1491\t _skptrace(\"SWAP c1: %d (%d)\",c1,ast->par[c1]);\n1492\t  if (c1<0 || ast->par[c1] >= 0) return;\n1493\t\n1494\t 