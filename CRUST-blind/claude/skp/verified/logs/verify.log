{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SrM7egNwPiy8Psuvb82Uv4","type":"tool_result","content":"1\t/// SKP version information.\n2\tpub const SKP_VER: u32 = 0x0003001C;\n3\tpub const SKP_VER_STR: &str = \"0.3.1rc\";\n4\t/// A loop state used for scanning.\n5\t/// (In the C header this is defined only via macros; here we provide a Rust struct.)\n6\t#[derive(Debug, Default, Clone)]\n7\tpub struct SkpLoop {\n8\t    pub start: String,\n9\t    pub to: Option<String>,\n10\t    pub end: Option<String>,\n11\t    pub alt: i32,\n12\t}\n13\t/// Returns the “length” from start to to. (This mimics the inline function `skp_loop_len`.)\n14\tpub fn skp_loop_len(start: &str, to: &str) -> i32 {\n15\t    let s_ptr = start.as_ptr() as isize;\n16\t    let t_ptr = to.as_ptr() as isize;\n17\t    let ret = (t_ptr - s_ptr) as i32;\n18\t    if ret >= 0 && ret <= (1 << 16) {\n19\t        ret\n20\t    } else {\n21\t        0\n22\t    }\n23\t}\n24\t/// Global variable used in the C code.\n25\t/// (In C declared as `volatile int skp_zero;`—here we use a mutable static.)\n26\tpub static mut SKP_ZERO: i32 = 0;\n27\t/// Trace function (corresponds to the C macro skptrace).\n28\tpub fn skptrace(args: std::fmt::Arguments) {\n29\t    eprintln!(\"TRCE: {}\", args);\n30\t}\n31\t\n32\t// ==================================================================\n33\t// Helper utilities (byte-based, internal)\n34\t// ==================================================================\n35\t\n36\t/// Return the number of bytes in s up to (but not including) the first NUL byte,\n37\t/// or s.len() if no NUL byte is present.  Mirrors C's null-terminated semantics.\n38\tfn effective_len(s: &str) -> usize {\n39\t    let bytes = s.as_bytes();\n40\t    bytes.iter().position(|&b| b == 0).unwrap_or(bytes.len())\n41\t}\n42\t\n43\t/// Read the next packed UTF-8 codepoint at `idx` from byte slice `bytes`.\n44\t/// `iso` non-zero means treat each byte independently (no UTF-8 grouping).\n45\t/// Returns (codepoint_packed_into_u32, byte_index_just_after).\n46\tfn skp_next_idx(bytes: &[u8], idx: usize, iso: bool) -> (u32, usize) {\n47\t    if idx >= bytes.len() || bytes[idx] == 0 {\n48\t        return (0, idx);\n49\t    }\n50\t    let mut c: u32 = bytes[idx] as u32;\n51\t    let mut i = idx + 1;\n52\t    if !iso {\n53\t        // Read up to 3 continuation bytes\n54\t        for _ in 0..3 {\n55\t            if i < bytes.len() && (bytes[i] & 0xC0) == 0x80 {\n56\t                c = (c << 8) | (bytes[i] as u32);\n57\t                i += 1;\n58\t            } else {\n59\t                break;\n60\t            }\n61\t        }\n62\t    }\n63\t    if c == 0x0D && i < bytes.len() && bytes[i] == 0x0A {\n64\t        c = 0x0D0A;\n65\t        i += 1;\n66\t    }\n67\t    (c, i)\n68\t}\n69\t\n70\t// ==================================================================\n71\t// Public character helpers\n72\t// ==================================================================\n73\t\n74\t/// Returns the next Unicode code point from the string `s` (similar to `skp_next` in C).\n75\t/// Returns a tuple `(code_point, rest_of_string)`.\n76\tpub fn skp_next(s: &str, iso: i32) -> (u32, &str) {\n77\t    let bytes = s.as_bytes();\n78\t    let (c, i) = skp_next_idx(bytes, 0, iso != 0);\n79\t    let i = i.min(bytes.len());\n80\t    // Try to slice on a UTF-8 boundary.  If `i` lands inside a multi-byte\n81\t    // character (only possible for malformed input), fall back to ASCII view.\n82\t    let rest = if s.is_char_boundary(i) {\n83\t        &s[i..]\n84\t    } else {\n85\t        // Should not happen for valid UTF-8 inputs, but guard anyway.\n86\t        &s[bytes.len()..]\n87\t    };\n88\t    (c, rest)\n89\t}\n90\t\n91\t/// Compares two code points. If `fold` is nonzero, performs case‑insensitive comparison.\n92\tpub fn chr_cmp(a: u32, b: u32, fold: i32) -> bool {\n93\t    let mut a = a;\n94\t    let mut b = b;\n95\t    if fold != 0 && a <= 0x7F && b <= 0x7F {\n96\t        if (b'A' as u32..=b'Z' as u32).contains(&a) {\n97\t            a += 0x20;\n98\t        }\n99\t        if (b'A' as u32..=b'Z' as u32).contains(&b) {\n100\t            b += 0x20;\n101\t        }\n102\t    }\n103\t    a == b\n104\t}\n105\t\n106\t/// Returns true if `c` is a blank character.\n107\tpub fn is_blank(c: u32) -> bool {\n108\t    if c < 0xFF {\n109\t        return c == 0x20 || c == 0x09;\n110\t    }\n111\t    match c & 0xFFFFFF00 {\n112\t        0x00000000 => c == 0xA0,\n113\t        0x0000C200 => c == 0xC2A0,\n114\t        0x00E19A00 => c == 0xE19A80,\n115\t        0x00E28000 => (0xE28080..=0xE2808A).contains(&c) || c == 0xE280AF,\n116\t        0x00E38080 => c == 0xE38080,\n117\t        _ => false,\n118\t    }\n119\t}\n120\t\n121\t/// Returns true if `c` is a line-break character.\n122\tpub fn is_break(c: u32) -> bool {\n123\t    if c < 0x0F {\n124\t        return c == 0x0A || c == 0x0C || c == 0x0D;\n125\t    }\n126\t    if c < 0xFF {\n127\t        return c == 0x85;\n128\t    }\n129\t    c == 0x0D0A || c == 0xC285 || c == 0xE280A8 || c == 0xE280A9\n130\t}\n131\t\n132\t/// Returns true if `c` is a space (blank or break).\n133\tpub fn is_space(c: u32) -> bool {\n134\t    is_blank(c) || is_break(c)\n135\t}\n136\t\n137\t/// Returns true if `c` is a digit.\n138\tpub fn is_digit(c: u32) -> bool {\n139\t    (b'0' as u32..=b'9' as u32).contains(&c)\n140\t}\n141\t\n142\t/// Returns true if `c` is a hexadecimal digit.\n143\tpub fn is_xdigit(c: u32) -> bool {\n144\t    (b'0' as u32..=b'9' as u32).contains(&c)\n145\t        || (b'A' as u32..=b'F' as u32).contains(&c)\n146\t        || (b'a' as u32..=b'f' as u32).contains(&c)\n147\t}\n148\t\n149\t/// Returns true if `c` is an uppercase letter.\n150\tpub fn is_upper(c: u32) -> bool {\n151\t    (b'A' as u32..=b'Z' as u32).contains(&c)\n152\t}\n153\t\n154\t/// Returns true if `c` is a lowercase letter.\n155\tpub fn is_lower(c: u32) -> bool {\n156\t    (b'a' as u32..=b'z' as u32).contains(&c)\n157\t}\n158\t\n159\t/// Returns true if `c` is an alphabetic character.\n160\tpub fn is_alpha(c: u32) -> bool {\n161\t    is_upper(c) || is_lower(c)\n162\t}\n163\t\n164\t/// Returns true if `c` is a valid identifier character.\n165\tpub fn is_idchr(c: u32) -> bool {\n166\t    is_alpha(c) || is_digit(c) || c == b'_' as u32\n167\t}\n168\t\n169\t/// Returns true if `c` is alphanumeric.\n170\tpub fn is_alnum(c: u32) -> bool {\n171\t    is_alpha(c) || is_digit(c)\n172\t}\n173\t\n174\t/// Returns true if `c` is a control character.\n175\tpub fn is_ctrl(c: u32) -> bool {\n176\t    c < 0x20 || (0xC280..0xC2A0).contains(&c) || (0x7F..0xA0).contains(&c)\n177\t}\n178\t\n179\t/// Returns true if `ch` is one of the characters in `set`. The `iso` flag is used for encoding.\n180\tpub fn is_oneof(ch: u32, set: &str, iso: i32) -> bool {\n181\t    if ch == 0 {\n182\t        return false;\n183\t    }\n184\t    let bytes = set.as_bytes();\n185\t    let isob = iso != 0;\n186\t    let mut s_idx = 0;\n187\t    let (mut p_ch, ns) = skp_next_idx(bytes, s_idx, isob);\n188\t    s_idx = ns;\n189\t    if p_ch == b']' as u32 {\n190\t        if ch == b']' as u32 {\n191\t            return true;\n192\t        } else {\n193\t            let (np, ns2) = skp_next_idx(bytes, s_idx, isob);\n194\t            p_ch = np;\n195\t            s_idx = ns2;\n196\t        }\n197\t    }\n198\t    while p_ch != b']' as u32 && p_ch != 0 {\n199\t        if p_ch == ch {\n200\t            return true;\n201\t        }\n202\t        let q_ch = p_ch;\n203\t        let (np, ns2) = skp_next_idx(bytes, s_idx, isob);\n204\t        p_ch = np;\n205\t        s_idx = ns2;\n206\t        // peek next byte\n207\t        let next_byte = if s_idx < bytes.len() { bytes[s_idx] } else { 0 };\n208\t        if p_ch == b'-' as u32 && next_byte != b']' {\n209\t            let (np2, ns3) = skp_next_idx(bytes, s_idx, isob);\n210\t            p_ch = np2;\n211\t            s_idx = ns3;\n212\t            if q_ch < ch && ch <= p_ch {\n213\t                return true;\n214\t            }\n215\t            let (np3, ns4) = skp_next_idx(bytes, s_idx, isob);\n216\t            p_ch = np3;\n217\t            s_idx = ns4;\n218\t        }\n219\t    }\n220\t    false\n221\t}\n222\t\n223\t/// Checks if the string `s` starts with the pattern `p` for `len` characters, using flag `flg`.\n224\t/// Returns the number of bytes matched in s, or 0 on no match.\n225\tpub fn is_string(s: &str, p: &str, len: i32, flg: i32) -> i32 {\n226\t    is_string_idx(s.as_bytes(), 0, p.as_bytes(), 0, len, flg)\n227\t}\n228\t\n229\tfn is_string_idx(\n230\t    s_bytes: &[u8],\n231\t    s_start_idx: usize,\n232\t    p_bytes: &[u8],\n233\t    p_start_idx: usize,\n234\t    len: i32,\n235\t    flg: i32,\n236\t) -> i32 {\n237\t    let isob = (flg & 2) != 0;\n238\t    let fold = flg & 1;\n239\t    let start_s = s_start_idx;\n240\t    let mut s_idx = s_start_idx;\n241\t    let mut p_idx = p_start_idx;\n242\t    let mut len = len;\n243\t    let mut mlen: i32 = 0;\n244\t    while len > 0 {\n245\t        // Hitting the alternation marker '\\xE' (0x0E) means a successful alternative\n246\t        if p_idx < p_bytes.len() && p_bytes[p_idx] == 0x0E {\n247\t            return mlen;\n248\t        }\n249\t        let (p_chr, p_end_idx) = skp_next_idx(p_bytes, p_idx, isob);\n250\t        let (s_chr, s_end_idx) = skp_next_idx(s_bytes, s_idx, isob);\n251\t        if chr_cmp(s_chr, p_chr, fold) {\n252\t            mlen += (s_end_idx - s_idx) as i32;\n253\t            len -= (p_end_idx - p_idx) as i32;\n254\t            p_idx = p_end_idx;\n255\t            s_idx = s_end_idx;\n256\t        } else {\n257\t            // search for an alternative '\\xE'\n258\t            while len > 0 && p_idx < p_bytes.len() {\n259\t                let b = p_bytes[p_idx];\n260\t                p_idx += 1;\n261\t                if b == 0x0E {\n262\t                    break;\n263\t                }\n264\t                len -= 1;\n265\t            }\n266\t            len -= 1;\n267\t            if len < 0 {\n268\t                return 0;\n269\t            }\n270\t            s_idx = start_s;\n271\t            mlen = 0;\n272\t        }\n273\t    }\n274\t    mlen\n275\t}\n276\t\n277\t/// Given an opening parenthesis code point, returns the corresponding closing code point.\n278\tpub fn get_close(open: u32) -> u32 {\n279\t    match open as u8 as char {\n280\t        '(' => ')' as u32,\n281\t        '[' => ']' as u32,\n282\t        '{' => '}' as u32,\n283\t        '<' => '>' as u32,\n284\t        _ => 0,\n285\t    }\n286\t}\n287\t\n288\t/// Given a quote character, returns the corresponding closing quote.\n289\tpub fn get_qclose(open: u32) -> u32 {\n290\t    match open as u8 as char {\n291\t        '\\'' | '\"' | '`' => open,\n292\t        _ => 0,\n293\t    }\n294\t}\n295\t\n296\t/// Constants for match results.\n297\tpub const MATCHED_FAIL: i32 = 0;\n298\tpub const MATCHED: i32 = 1;\n299\tpub const MATCHED_GOAL: i32 = 2;\n300\tpub const MATCHED_GOALNOT: i32 = 3;\n301\t\n302\t/// Internal byte-index based match function.\n303\t/// Returns (match_result, src_end_idx, pat_end_idx).\n304\tfn match_idx(\n305\t    p_bytes: &[u8],\n306\t    p_start_idx: usize,\n307\t    s_bytes: &[u8],\n308\t    s_start_idx: usize,\n309\t    flg: &mut i32,\n310\t) -> (i32, usize, usize) {\n311\t    let mut p_idx = p_start_idx;\n312\t    let mut s_end_idx = s_start_idx;\n313\t    let isob = (*flg & 2) != 0;\n314\t    let (mut s_chr, mut s_tmp_idx) = skp_next_idx(s_bytes, s_end_idx, isob);\n315\t\n316\t    let mut match_min: u32 = 1;\n317\t    let mut match_max: u32 = 1;\n318\t    let mut match_not: u32 = 0;\n319\t    let mut match_cnt: u32;\n320\t    let mut intnumber = false;\n321\t    let mut ret: i32 = MATCHED_FAIL;\n322\t\n323\t    if p_idx < p_bytes.len() {\n324\t        match p_bytes[p_idx] {\n325\t            b'*' => {\n326\t                match_min = 0;\n327\t                match_max = u32::MAX;\n328\t                p_idx += 1;\n329\t            }\n330\t            b'+' => {\n331\t                match_max = u32::MAX;\n332\t                p_idx += 1;\n333\t            }\n334\t            b'?' => {\n335\t                match_min = 0;\n336\t                p_idx += 1;\n337\t            }\n338\t            _ => {}\n339\t        }\n340\t    }\n341\t\n342\t    if p_idx < p_bytes.len() && p_bytes[p_idx] == b'!' {\n343\t        match_not = 1;\n344\t        p_idx += 1;\n345\t    }\n346\t\n347\t    if p_idx >= p_bytes.len() {\n348\t        return (MATCHED_FAIL, s_start_idx, p_start_idx);\n349\t    }\n350\t\n351\t    let opcode = p_bytes[p_idx];\n352\t    p_idx += 1;\n353\t\n354\t    // Helper closure to repeat matching using skp_next-based advancement\n355\t    macro_rules! do_w {\n356\t        ($pred:expr) => {{\n357\t            let mut cnt: u32 = 0;\n358\t            while cnt < match_max && (s_chr != 0 && (($pred) != (match_not != 0))) {\n359\t                s_end_idx = s_tmp_idx;\n360\t                let (nc, nt) = skp_next_idx(s_bytes, s_end_idx, isob);\n361\t                s_chr = nc;\n362\t                s_tmp_idx = nt;\n363\t                cnt += 1;\n364\t            }\n365\t            match_cnt = cnt;\n366\t            ret = if match_cnt >= match_min { MATCHED } else { MATCHED_FAIL };\n367\t        }};\n368\t    }\n369\t\n370\t    // Helper to advance one byte (mirrors get_next_s_chr in C)\n371\t    macro_rules! get_next_s_chr_byte {\n372\t        () => {\n373\t            s_end_idx = s_tmp_idx;\n374\t            s_chr = if s_end_idx < s_bytes.len() {\n375\t                s_bytes[s_end_idx] as u32\n376\t            } else {\n377\t                0\n378\t            };\n379\t            s_tmp_idx = s_end_idx + 1;\n380\t        };\n381\t    }\n382\t\n383\t    match opcode {\n384\t        b'.' => {\n385\t            if match_not != 0 {\n386\t                ret = if s_chr == 0 { MATCHED } else { MATCHED_FAIL };\n387\t            } else {\n388\t                do_w!(s_chr != 0);\n389\t            }\n390\t        }\n391\t        b'$' | b'n' => {\n392\t            // For '$': if s_chr == 0, ret = 1, else fall through to 'n' handling\n393\t            // We replicate the fallthrough: for '$' if not zero, treat as 'n'\n394\t            if opcode == b'$' && s_chr == 0 {\n395\t                ret = MATCHED;\n396\t            } else {\n397\t                do_w!(is_break(s_chr));\n398\t            }\n399\t        }\n400\t        b'd' => {\n401\t            do_w!(is_digit(s_chr));\n402\t        }\n403\t        b'x' => {\n404\t            do_w!(is_xdigit(s_chr));\n405\t        }\n406\t        b'a' => {\n407\t            do_w!(is_alpha(s_chr));\n408\t        }\n409\t        b'u' => {\n410\t            do_w!(is_upper(s_chr));\n411\t        }\n412\t        b'l' => {\n413\t            do_w!(is_lower(s_chr));\n414\t        }\n415\t        b's' => {\n416\t            do_w!(is_space(s_chr));\n417\t        }\n418\t        b'w' => {\n419\t            do_w!(is_blank(s_chr));\n420\t        }\n421\t        b'c' => {\n422\t            do_w!(is_ctrl(s_chr));\n423\t        }\n424\t        b'i' => {\n425\t            do_w!(is_idchr(s_chr));\n426\t        }\n427\t        b'@' => {\n428\t            do_w!(is_alnum(s_chr));\n429\t        }\n430\t        b'&' => {\n431\t            ret = if match_not != 0 {\n432\t                MATCHED_GOALNOT\n433\t            } else {\n434\t                MATCHED_GOAL\n435\t            };\n436\t        }\n437\t        b'[' => {\n438\t            // Use a string-based slice into pat for is_oneof.\n439\t            // We can't construct &str from bytes directly without UTF-8 check, so\n440\t            // use a helper that operates on bytes.\n441\t            do_w!(is_oneof_bytes(s_chr, p_bytes, p_idx, isob));\n442\t            // advance past the set\n443\t            if p_idx < p_bytes.len() && p_bytes[p_idx] == b']' {\n444\t                p_idx += 1;\n445\t            }\n446\t            while p_idx < p_bytes.len() && p_bytes[p_idx] != 0 && p_bytes[p_idx] != b']' {\n447\t                p_idx += 1;\n448\t            }\n449\t            if p_idx < p_bytes.len() {\n450\t                p_idx += 1;\n451\t            }\n452\t        }\n453\t        b'\"' | b'\\'' | b'`' => {\n454\t            let quote = opcode;\n455\t            let mut l: i32 = 0;\n456\t            while p_idx + (l as usize) < p_bytes.len() && p_bytes[p_idx + l as usize] != 0 {\n457\t                if p_bytes[p_idx + l as usize] == quote {\n458\t                    break;\n459\t                }\n460\t                l += 1;\n461\t            }\n462\t            if l > 0 {\n463\t                let ml = is_string_idx(s_bytes, s_end_idx, p_bytes, p_idx, l, *flg);\n464\t                if ml > 0 {\n465\t                    if match_not == 0 {\n466\t                        s_end_idx += ml as usize;\n467\t                        ret = MATCHED;\n468\t                    }\n469\t                    // If match_not != 0 and matched, leave ret = FAIL (handled later)\n470\t                } else if match_min == 0 || match_not != 0 {\n471\t                    ret = MATCHED;\n472\t                }\n473\t            } else if match_min == 0 || match_not != 0 {\n474\t                ret = MATCHED;\n475\t            }\n476\t            // skip past the closing quote\n477\t            p_idx += l as usize + 1;\n478\t        }\n479\t        b'C' => {\n480\t            *flg = (*flg & !1) | (match_not as i32);\n481\t            ret = MATCHED;\n482\t        }\n483\t        b'U' => {\n484\t            *flg = (*flg & !2) | ((match_not as i32) * 2);\n485\t            ret = MATCHED;\n486\t        }\n487\t        b'S' => {\n488\t            while is_space(s_chr) {\n489\t                get_next_s_chr_byte!();\n490\t            }\n491\t            ret = MATCHED;\n492\t        }\n493\t        b'W' => {\n494\t            while is_blank(s_chr) {\n495\t                get_next_s_chr_byte!();\n496\t            }\n497\t            ret = MATCHED;\n498\t        }\n499\t        b'N' => {\n500\t            while s_chr != 0 && !is_break(s_chr) {\n501\t                get_next_s_chr_byte!();\n502\t            }\n503\t            if s_chr != 0 {\n504\t                get_next_s_chr_byte!();\n505\t            }\n506\t            ret = MATCHED;\n507\t        }\n508\t        b'I' => {\n509\t            if is_alpha(s_chr) || s_chr == b'_' as u32 {\n510\t                loop {\n511\t                    get_next_s_chr_byte!();\n512\t                    if !(is_alnum(s_chr) || s_chr == b'_' as u32) {\n513\t                        break;\n514\t                    }\n515\t                }\n516\t                ret = MATCHED;\n517\t            }\n518\t        }\n519\t        b'(' => {\n520\t            // ( ) means balanced parenthesis only with '()'\n521\t            if p_idx < p_bytes.len() && p_bytes[p_idx] == b')' && s_chr == b'(' as u32 {\n522\t                p_idx += 1;\n523\t                // fall through to balanced handling\n524\t                let open = s_chr;\n525\t                let close = get_close(open);\n526\t                if close != 0 {\n527\t                    let mut count: i32 = 1;\n528\t                    while s_chr != 0 && count > 0 {\n529\t                        get_next_s_chr_byte!();\n530\t                        if s_chr == open {\n531\t                            count += 1;\n532\t                        }\n533\t                        if s_chr == close {\n534\t                            count -= 1;\n535\t                        }\n536\t                    }\n537\t                    if count == 0 {\n538\t                        get_next_s_chr_byte!();\n539\t                        ret = MATCHED;\n540\t                    }\n541\t                }\n542\t            }\n543\t        }\n544\t        b'B' => {\n545\t            let open = s_chr;\n546\t            let close = get_close(open);\n547\t            if close != 0 {\n548\t                let mut count: i32 = 1;\n549\t                while s_chr != 0 && count > 0 {\n550\t                    get_next_s_chr_byte!();\n551\t                    if s_chr == open {\n552\t                        count += 1;\n553\t                    }\n554\t                    if s_chr == close {\n555\t                        count -= 1;\n556\t                    }\n557\t                }\n558\t                if count == 0 {\n559\t                    get_next_s_chr_byte!();\n560\t                    ret = MATCHED;\n561\t                }\n562\t            }\n563\t        }\n564\t        b'Q' => {\n565\t            let qclose = get_qclose(s_chr);\n566\t            if qclose != 0 {\n567\t                while s_chr != 0 {\n568\t                    get_next_s_chr_byte!();\n569\t                    if s_chr == qclose {\n570\t                        break;\n571\t                    }\n572\t                    if s_chr == b'\\\\' as u32 {\n573\t                        get_next_s_chr_byte!();\n574\t                    }\n575\t                }\n576\t                if s_chr != 0 {\n577\t                    get_next_s_chr_byte!();\n578\t                    ret = MATCHED;\n579\t                }\n580\t            }\n581\t        }\n582\t        b'X' => {\n583\t            // hex number\n584\t            if s_chr == b'0' as u32\n585\t                && s_end_idx + 2 < s_bytes.len()\n586\t                && (s_bytes[s_end_idx + 1] == b'x' || s_bytes[s_end_idx + 1] == b'X')\n587\t                && is_xdigit(s_bytes[s_end_idx + 2] as u32)\n588\t            {\n589\t                get_next_s_chr_byte!();\n590\t                get_next_s_chr_byte!();\n591\t                get_next_s_chr_byte!();\n592\t                ret = MATCHED;\n593\t            }\n594\t            while is_xdigit(s_chr) {\n595\t                ret = MATCHED;\n596\t                get_next_s_chr_byte!();\n597\t            }\n598\t        }\n599\t        b'D' => {\n600\t            intnumber = true;\n601\t            // fall through to F handling\n602\t            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n603\t                loop {\n604\t                    get_next_s_chr_byte!();\n605\t                    if !is_space(s_chr) {\n606\t                        break;\n607\t                    }\n608\t                }\n609\t            }\n610\t            while is_digit(s_chr) {\n611\t                ret = MATCHED;\n612\t                get_next_s_chr_byte!();\n613\t            }\n614\t            if !intnumber {\n615\t                if s_chr == b'.' as u32 {\n616\t                    get_next_s_chr_byte!();\n617\t                }\n618\t                while is_digit(s_chr) {\n619\t                    ret = MATCHED;\n620\t                    get_next_s_chr_byte!();\n621\t                }\n622\t                if ret == MATCHED && (s_chr == b'E' as u32 || s_chr == b'e' as u32) {\n623\t                    get_next_s_chr_byte!();\n624\t                    if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n625\t                        get_next_s_chr_byte!();\n626\t                    }\n627\t                    while is_digit(s_chr) {\n628\t                        get_next_s_chr_byte!();\n629\t                    }\n630\t                    if s_chr == b'.' as u32 {\n631\t                        get_next_s_chr_byte!();\n632\t                    }\n633\t                    while is_digit(s_chr) {\n634\t                        get_next_s_chr_byte!();\n635\t                    }\n636\t                }\n637\t            }\n638\t        }\n639\t        b'F' => {\n640\t            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n641\t                loop {\n642\t                    get_next_s_chr_byte!();\n643\t                    if !is_space(s_chr) {\n644\t                        break;\n645\t                    }\n646\t                }\n647\t            }\n648\t            while is_digit(s_chr) {\n649\t                ret = MATCHED;\n650\t                get_next_s_chr_byte!();\n651\t            }\n652\t            if s_chr == b'.' as u32 {\n653\t                get_next_s_chr_byte!();\n654\t            }\n655\t            while is_digit(s_chr) {\n656\t                ret = MATCHED;\n657\t                get_next_s_chr_byte!();\n658\t            }\n659\t            if ret == MATCHED && (s_chr == b'E' as u32 || s_chr == b'e' as u32) {\n660\t                get_next_s_chr_byte!();\n661\t                if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n662\t                    get_next_s_chr_byte!();\n663\t                }\n664\t                while is_digit(s_chr) {\n665\t                    get_next_s_chr_byte!();\n666\t                }\n667\t                if s_chr == b'.' as u32 {\n668\t                    get_next_s_chr_byte!();\n669\t                }\n670\t                while is_digit(s_chr) {\n671\t                    get_next_s_chr_byte!();\n672\t                }\n673\t            }\n674\t        }\n675\t        _ => {\n676\t            ret = MATCHED_FAIL;\n677\t            p_idx -= 1;\n678\t        }\n679\t    }\n680\t\n681\t    let _ = match_cnt; // suppress warning if unused\n682\t\n683\t    if ret != MATCHED_FAIL {\n684\t        (ret, s_end_idx, p_idx)\n685\t    } else {\n686\t        (MATCHED_FAIL, s_start_idx, p_start_idx)\n687\t    }\n688\t}\n689\t\n690\tfn is_oneof_bytes(ch: u32, set_bytes: &[u8], set_start_idx: usize, isob: bool) -> bool {\n691\t    if ch == 0 {\n692\t        return false;\n693\t    }\n694\t    let mut s_idx = set_start_idx;\n695\t    let (mut p_ch, ns) = skp_next_idx(set_bytes, s_idx, isob);\n696\t    s_idx = ns;\n697\t    if p_ch == b']' as u32 {\n698\t        if ch == b']' as u32 {\n699\t            return true;\n700\t        } else {\n701\t            let (np, ns2) = skp_next_idx(set_bytes, s_idx, isob);\n702\t            p_ch = np;\n703\t            s_idx = ns2;\n704\t        }\n705\t    }\n706\t    while p_ch != b']' as u32 && p_ch != 0 {\n707\t        if p_ch == ch {\n708\t            return true;\n709\t        }\n710\t        let q_ch = p_ch;\n711\t        let (np, ns2) = skp_next_idx(set_bytes, s_idx, isob);\n712\t        p_ch = np;\n713\t        s_idx = ns2;\n714\t        let next_byte = if s_idx < set_bytes.len() {\n715\t            set_bytes[s_idx]\n716\t        } else {\n717\t            0\n718\t        };\n719\t        if p_ch == b'-' as u32 && next_byte != b']' {\n720\t            let (np2, ns3) = skp_next_idx(set_bytes, s_idx, isob);\n721\t            p_ch = np2;\n722\t            s_idx = ns3;\n723\t            if q_ch < ch && ch <= p_ch {\n724\t                return true;\n725\t            }\n726\t            let (np3, ns4) = skp_next_idx(set_bytes, s_idx, isob);\n727\t            p_ch = np3;\n728\t            s_idx = ns4;\n729\t        }\n730\t    }\n731\t    false\n732\t}\n733\t\n734\t/// Matches the pattern `pat` against source `src` and returns a tuple:\n735\t/// `(match_result, src_end, pat_end)`. The flag parameter is passed by mutable reference.\n736\tpub fn match_pat<'a>(pat: &'a str, src: &'a str, flg: &mut i32) -> (i32, &'a str, &'a str) {\n737\t    let p_bytes = pat.as_bytes();\n738\t    let s_bytes = src.as_bytes();\n739\t    let (ret, s_end, p_end) = match_idx(p_bytes, 0, s_bytes, 0, flg);\n740\t    let s_end = s_end.min(s_bytes.len());\n741\t    let p_end = p_end.min(p_bytes.len());\n742\t    let src_out = if src.is_char_boundary(s_end) {\n743\t        &src[s_end..]\n744\t    } else {\n745\t        src\n746\t    };\n747\t    let pat_out = if pat.is_char_boundary(p_end) {\n748\t        &pat[p_end..]\n749\t    } else {\n750\t        pat\n751\t    };\n752\t    (ret, src_out, pat_out)\n753\t}\n754\t\n755\t/// Internal byte-based skp_ implementation.\n756\t/// Returns (alt, to_byte_idx, end_byte_idx)\n757\tfn skp_inner_idx(src: &str, pat: &str) -> (i32, usize, usize) {\n758\t    if pat.is_empty() {\n759\t        return (0, 0, 0);\n760\t    }\n761\t    let p_bytes = pat.as_bytes();\n762\t    let s_bytes = src.as_bytes();\n763\t    let mut p_pat_start_idx = 0usize;\n764\t    let mut skp_to = false;\n765\t    if p_pat_start_idx < p_bytes.len() && p_bytes[p_pat_start_idx] == b'>' {\n766\t        skp_to = true;\n767\t        p_pat_start_idx += 1;\n768\t    }\n769\t\n770\t    let mut start_idx: usize = 0;\n771\t    let mut s_idx: usize = start_idx;\n772\t    let mut p_idx = p_pat_start_idx;\n773\t\n774\t    let mut matched: i32 = 0;\n775\t    let mut goal: Option<usize> = None;\n776\t    let mut goalnot: Option<usize> = None;\n777\t    let mut flg: i32 = 0;\n778\t\n779\t    // Skip leading spaces\n780\t    while p_idx < p_bytes.len() && is_space(p_bytes[p_idx] as u32) {\n781\t        p_idx += 1;\n782\t    }\n783\t\n784\t    while p_idx < p_bytes.len() && p_bytes[p_idx] > 0x07 {\n785\t        let (m, s_end_idx, p_end_idx) = match_idx(p_bytes, p_idx, s_bytes, s_idx, &mut flg);\n786\t        matched = m;\n787\t        if matched != 0 {\n788\t            s_idx = s_end_idx;\n789\t            p_idx = p_end_idx;\n790\t            if matched == MATCHED_GOAL && goalnot.is_none() {\n791\t                goal = Some(s_idx);\n792\t            } else if matched == MATCHED_GOALNOT {\n793\t                goalnot = Some(s_idx);\n794\t            }\n795\t        } else {\n796\t            // Skip rest of current alternative\n797\t            while p_idx < p_bytes.len() && p_bytes[p_idx] > 0x07 {\n798\t                p_idx += 1;\n799\t            }\n800\t            // Try alternative pattern: separator > 0 and next byte > 0\n801\t            if p_idx < p_bytes.len()\n802\t                && p_bytes[p_idx] > 0\n803\t                && p_idx + 1 < p_bytes.len()\n804\t                && p_bytes[p_idx + 1] > 0\n805\t            {\n806\t                s_idx = start_idx;\n807\t                p_idx += 1;\n808\t            } else if skp_to {\n809\t                goal = None;\n810\t                goalnot = None;\n811\t                p_idx = p_pat_start_idx;\n812\t                start_idx += 1;\n813\t                s_idx = start_idx;\n814\t                if start_idx >= s_bytes.len() || s_bytes[start_idx] == 0 {\n815\t                    break;\n816\t                }\n817\t            } else {\n818\t                break;\n819\t            }\n820\t        }\n821\t        // Skip spaces in pattern\n822\t        while p_idx < p_bytes.len() && is_space(p_bytes[p_idx] as u32) {\n823\t            p_idx += 1;\n824\t        }\n825\t    }\n826\t\n827\t    if matched == 0 && goalnot.is_some() {\n828\t        goal = goalnot;\n829\t        matched = MATCHED;\n830\t        // Force end-of-pattern condition\n831\t        p_idx = p_bytes.len();\n832\t    }\n833\t\n834\t    if let Some(g) = goal {\n835\t        s_idx = g;\n836\t    }\n837\t\n838\t    let at_end = p_idx >= p_bytes.len() || p_bytes[p_idx] <= 0x07;\n839\t    if matched != 0 && at_end {\n840\t        let ret_val = if p_idx < p_bytes.len() && p_bytes[p_idx] > 0 {\n841\t            p_bytes[p_idx] as i32\n842\t        } else {\n843\t            1\n844\t        };\n845\t        let to_idx = if skp_to { start_idx } else { s_idx };\n846\t        let end_idx = s_idx;\n847\t        return (ret_val, to_idx, end_idx);\n848\t    }\n849\t\n850\t    (0, 0, 0)\n851\t}\n852\t\n853\t/// The core scanning function from the C header.\n854\tpub fn skp_<'a>(src: &'a str, pat: &'a str) -> (i32, &'a str, &'a str) {\n855\t    if pat.is_empty() || src.is_empty() && pat.is_empty() {\n856\t        // No pattern -> failure\n857\t    }\n858\t    if src.is_empty() && pat.is_empty() {\n859\t        return (0, src, src);\n860\t    }\n861\t    // Check null-equivalent: in C, null pat or null src returns 0\n862\t    let (alt, to_idx, end_idx) = skp_inner_idx(src, pat);\n863\t    if alt > 0 {\n864\t        let s_bytes = src.as_bytes();\n865\t        let to_idx = to_idx.min(s_bytes.len());\n866\t        let end_idx = end_idx.min(s_bytes.len());\n867\t        let to_str = if src.is_char_boundary(to_idx) {\n868\t            &src[to_idx..]\n869\t        } else {\n870\t            src\n871\t        };\n872\t        let end_str = if src.is_char_boundary(end_idx) {\n873\t            &src[end_idx..]\n874\t        } else {\n875\t            src\n876\t        };\n877\t        (alt, to_str, end_str)\n878\t    } else {\n879\t        (0, src, src)\n880\t    }\n881\t}\n882\t\n883\t/// Variant: skp_4(src, pat, to, end).\n884\tpub fn skp_4(src: &str, pat: &str, to: Option<&mut &str>, end: Option<&mut &str>) -> i32 {\n885\t    let (alt, to_idx, end_idx) = skp_inner_idx(src, pat);\n886\t    if alt > 0 {\n887\t        let s_bytes = src.as_bytes();\n888\t        let to_i = to_idx.min(s_bytes.len());\n889\t        let end_i = end_idx.min(s_bytes.len());\n890\t        let to_str: &str = if src.is_char_boundary(to_i) {\n891\t            &src[to_i..]\n892\t        } else {\n893\t            src\n894\t        };\n895\t        let end_str: &str = if src.is_char_boundary(end_i) {\n896\t            &src[end_i..]\n897\t        } else {\n898\t            src\n899\t        };\n900\t        // SAFETY: we assign references derived from `src` to slots that may\n901\t        // have been declared with a different lifetime.  Callers are expected\n902\t        // to ensure the supplied references outlive `src`.  This mirrors the\n903\t        // C API that simply writes through the pointer.\n904\t        if let Some(t) = to {\n905\t            unsafe {\n906\t                *t = std::mem::transmute::<&str, &str>(to_str);\n907\t            }\n908\t        }\n909\t        if let Some(e) = end {\n910\t            unsafe {\n911\t                *e = std::mem::transmute::<&str, &str>(end_str);\n912\t            }\n913\t        }\n914\t        alt\n915\t    } else {\n916\t        if let Some(t) = to {\n917\t            unsafe {\n918\t                *t = std::mem::transmute::<&str, &str>(src);\n919\t            }\n920\t        }\n921\t        if let Some(e) = end {\n922\t            unsafe {\n923\t                *e = std::mem::transmute::<&str, &str>(src);\n924\t            }\n925\t        }\n926\t        0\n927\t    }\n928\t}\n929\t\n930\t/// Variant: skp_3(src, pat, end). Note: maps to C's `to` slot (3rd arg).\n931\tpub fn skp_3(src: &str, pat: &str, end: Option<&mut &str>) -> i32 {\n932\t    let (alt, to_idx, _end_idx) = skp_inner_idx(src, pat);\n933\t    if alt > 0 {\n934\t        let s_bytes = src.as_bytes();\n935\t        let to_i = to_idx.min(s_bytes.len());\n936\t        let to_str: &str = if src.is_char_boundary(to_i) {\n937\t            &src[to_i..]\n938\t        } else {\n939\t            src\n940\t        };\n941\t        if let Some(e) = end {\n942\t            unsafe {\n943\t                *e = std::mem::transmute::<&str, &str>(to_str);\n944\t            }\n945\t        }\n946\t        alt\n947\t    } else {\n948\t        if let Some(e) = end {\n949\t            unsafe {\n950\t                *e = std::mem::transmute::<&str, &str>(src);\n951\t            }\n952\t        }\n953\t        0\n954\t    }\n955\t}\n956\t\n957\t/// Variant: skp_2(src, pat).\n958\tpub fn skp_2(src: &str, pat: &str) -> i32 {\n959\t    skp_inner_idx(src, pat).0\n960\t}\n961\t\n962\t// ==================================================================\n963\t// AST functions\n964\t// ==================================================================\n965\t\n966\tconst ASTNULL: i32 = -1;\n967\tconst SKP_DEBUG: i8 = 0x01;\n968\t#[allow(dead_code)]\n969\tconst SKP_LEFTRECUR: i8 = 0x02;\n970\t\n971\t/// In C: `typedef int32_t astnode_t;`\n972\tpub type AstNodeT = i32;\n973\t\n974\t/// Representation of an AST node.\n975\t#[derive(Debug, Default, Clone)]\n976\tpub struct AstNode {\n977\t    pub rule: String,\n978\t    pub from: AstNodeT,\n979\t    pub to: AstNodeT,\n980\t    pub delta: i32, // delta between open and close parenthesis (>0)\n981\t    pub tag: i32,\n982\t}\n983\t\n984\t/// AST memoization structure\n985\t#[derive(Debug, Default)]\n986\tpub struct AstMmz {\n987\t    pub pos: i32,\n988\t    pub endpos: i32,\n989\t    pub numnodes: i32,\n990\t    pub maxnodes: i32,\n991\t    pub lastinfo: i32,\n992\t    pub nodes: Vec<AstNode>,\n993\t}\n994\t\n995\t/// In C: `typedef struct ast_s *ast_t;`\n996\t#[derive(Debug, Default)]\n997\tpub struct Ast {\n998\t    pub start: String,\n999\t    pub err_rule: Option<String>,\n1000\t    pub err_msg: Option<String>,\n1001\t    pub cur_rule: Option<String>,\n1002\t    pub nodes: Vec<AstNode>,\n1003\t    pub mmz: Vec<AstMmz>,\n1004\t    pub par: Vec<i32>,\n1005\t    pub auxptr: Option<Box<dyn std::any::Any>>,\n1006\t    pub nodes_cnt: i32,\n1007\t    pub nodes_max: i32,\n1008\t    pub par_cnt: i32,\n1009\t    pub par_max: i32,\n1010\t    pub mmz_cnt: i32,\n1011\t    pub mmz_max: i32,\n1012\t    pub pos: i32,\n1013\t    pub lastpos: i32,\n1014\t    pub err_pos: i32,\n1015\t    pub cur_node: i32,\n1016\t    pub lastinfo: i32,\n1017\t    pub ret: i32,\n1018\t    pub depth: u16,\n1019\t    pub fail: i8,\n1020\t    pub flg: i8,\n1021\t}\n1022\t\n1023\tpub type SkpRule = fn(ast: &mut Ast, ret: &mut i32);\n1024\t\n1025\t/// Creates a new AST.\n1026\tpub fn ast_new() -> Option<Ast> {\n1027\t    Some(Ast {\n1028\t        start: String::new(),\n1029\t        err_rule: None,\n1030\t        err_msg: Some(String::new()),\n1031\t        cur_rule: None,\n1032\t        nodes: Vec::with_capacity(8),\n1033\t        mmz: Vec::new(),\n1034\t        par: Vec::with_capacity(16),\n1035\t        auxptr: None,\n1036\t        nodes_cnt: 0,\n1037\t        nodes_max: 8,\n1038\t        par_cnt: 0,\n1039\t        par_max: 16,\n1040\t        mmz_cnt: 0,\n1041\t        mmz_max: 64,\n1042\t        pos: 0,\n1043\t        lastpos: 0,\n1044\t        err_pos: -1,\n1045\t        cur_node: ASTNULL,\n1046\t        lastinfo: 0,\n1047\t        ret: 0,\n1048\t        depth: 0,\n1049\t        fail: 0,\n1050\t        flg: 0,\n1051\t    })\n1052\t}\n1053\t\n1054\t/// Frees an AST.\n1055\tpub fn astfree(_ast: Ast) -> Option<Ast> {\n1056\t    None\n1057\t}\n1058\t\n1059\t/// Parses the source string `src` using a given parsing rule.\n1060\tpub fn skp_parse(src: &str, rule: SkpRule, rulename: &str, debug: i32) -> Option<Ast> {\n1061\t    let mut ast = ast_new()?;\n1062\t    ast.start = src.to_string();\n1063\t    ast.flg = if debug != 0 { SKP_DEBUG } else { 0 };\n1064\t\n1065\t    let pos0 = ast.pos;\n1066\t    let open = ast_open(&mut ast, pos0, rulename);\n1067\t    if open >= 0 {\n1068\t        let mut ret = ast.ret;\n1069\t        rule(&mut ast, &mut ret);\n1070\t        ast.ret = ret;\n1071\t\n1072\t        if ast.fail != 0 && ast.err_pos < ast.pos {\n1073\t            ast.err_pos = ast.pos;\n1074\t            ast.err_rule = Some(rulename.to_string());\n1075\t        }\n1076\t\n1077\t        let pos = ast.pos;\n1078\t        ast_close(&mut ast, pos, open);\n1079\t        if ast.nodes_cnt > 0 {\n1080\t            ast.err_pos = -1;\n1081\t            let info = ast.lastinfo;\n1082\t            ast_setinfo(&mut ast, info, 0);\n1083\t        }\n1084\t    }\n1085\t    // mmz cleanup not strictly needed as Vec drops naturally\n1086\t    ast.mmz.clear();\n1087\t    ast.mmz_cnt = 0;\n1088\t    Some(ast)\n1089\t}\n1090\t\n1091\t/// Debug function for AST.\n1092\tpub fn skp_debug2(ast: &mut Ast, d: u8) -> i32 {\n1093\t    match d {\n1094\t        0 => ast.flg &= !SKP_DEBUG,\n1095\t        1 => ast.flg |= SKP_DEBUG,\n1096\t        _ => ast.flg ^= SKP_DEBUG,\n1097\t    }\n1098\t    (ast.flg & SKP_DEBUG) as i32\n1099\t}\n1100\t\n1101\tfn skp_par_makeroom(ast: &mut Ast, needed: i32) -> bool {\n1102\t    if ast.par_cnt + needed > ast.par_max {\n1103\t        let mut new_max = ast.par_max;\n1104\t        loop {\n1105\t            new_max += new_max / 2;\n1106\t            new_max += new_max & 1;\n1107\t            if ast.par_cnt + needed <= new_max {\n1108\t                break;\n1109\t            }\n1110\t        }\n1111\t        ast.par.resize(new_max as usize, 0);\n1112\t        ast.par_max = new_max;\n1113\t    } else {\n1114\t        // ensure underlying Vec has the capacity to be indexed\n1115\t        if (ast.par.len() as i32) < ast.par_cnt + needed {\n1116\t            ast.par.resize((ast.par_cnt + needed) as usize, 0);\n1117\t        }\n1118\t    }\n1119\t    true\n1120\t}\n1121\t\n1122\tfn skp_nodes_makeroom(ast: &mut Ast, needed: i32) -> bool {\n1123\t    if ast.nodes_cnt + needed > ast.nodes_max {\n1124\t        let mut new_max = ast.nodes_max;\n1125\t        loop {\n1126\t            new_max += new_max / 2;\n1127\t            new_max += new_max & 1;\n1128\t            if ast.nodes_cnt + needed <= new_max {\n1129\t                break;\n1130\t            }\n1131\t        }\n1132\t        ast.nodes\n1133\t            .resize(new_max as usize, AstNode::default());\n1134\t        ast.nodes_max = new_max;\n1135\t    } else if (ast.nodes.len() as i32) < ast.nodes_cnt + needed {\n1136\t        ast.nodes\n1137\t            .resize((ast.nodes_cnt + needed) as usize, AstNode::default());\n1138\t    }\n1139\t    true\n1140\t}\n1141\t\n1142\tfn ast_newpar(ast: &mut Ast) -> i32 {\n1143\t    if !skp_par_makeroom(ast, 1) {\n1144\t        return -1;\n1145\t    }\n1146\t    let p = ast.par_cnt;\n1147\t    ast.par_cnt += 1;\n1148\t    if (ast.par.len() as i32) <= p {\n1149\t        ast.par.resize((p + 1) as usize, 0);\n1150\t    }\n1151\t    p\n1152\t}\n1153\t\n1154\tfn ast_newnode(ast: &mut Ast) -> i32 {\n1155\t    if !skp_nodes_makeroom(ast, 1) {\n1156\t        return -1;\n1157\t    }\n1158\t    let n = ast.nodes_cnt;\n1159\t    ast.nodes_cnt += 1;\n1160\t    if (ast.nodes.len() as i32) <= n {\n1161\t        ast.nodes.resize((n + 1) as usize, AstNode::default());\n1162\t    }\n1163\t    n\n1164\t}\n1165\t\n1166\t/// Opens a new AST node starting at position `from` with the given rule.\n1167\tpub fn ast_open(ast: &mut Ast, from: i32, rule: &str) -> i32 {\n1168\t    if ast.fail != 0 {\n1169\t        return -1;\n1170\t    }\n1171\t    let par = ast_newpar(ast);\n1172\t    if par < 0 {\n1173\t        return -1;\n1174\t    }\n1175\t    let node = ast_newnode(ast);\n1176\t    if node < 0 {\n1177\t        return -1;\n1178\t    }\n1179\t    ast.par[par as usize] = node;\n1180\t    ast.nodes[node as usize] = AstNode {\n1181\t        rule: rule.to_string(),\n1182\t        from,\n1183\t        to: 0,\n1184\t        delta: 0,\n1185\t        tag: 0,\n1186\t    };\n1187\t    par\n1188\t}\n1189\t\n1190\t/// Closes the current AST node at position `to`, linking with the open node `open`.\n1191\tpub fn ast_close(ast: &mut Ast, to: i32, open: i32) -> i32 {\n1192\t    if open < 0 {\n1193\t        return -1;\n1194\t    }\n1195\t    let node_idx = ast.par[open as usize];\n1196\t    if ast.fail != 0 {\n1197\t        let from = ast.nodes[node_idx as usize].from;\n1198\t        ast.pos = from;\n1199\t        ast.nodes_cnt = node_idx;\n1200\t        ast.par_cnt = open;\n1201\t        return -1;\n1202\t    }\n1203\t    let par = ast_newpar(ast);\n1204\t    if par < 0 {\n1205\t        return -1;\n1206\t    }\n1207\t    let delta = par - open;\n1208\t    {\n1209\t        let nd = &mut ast.nodes[node_idx as usize];\n1210\t        nd.to = to;\n1211\t        nd.delta = delta;\n1212\t        nd.tag = 0;\n1213\t    }\n1214\t    ast.par[par as usize] = -delta;\n1215\t\n1216\t    let rule = ast.nodes[node_idx as usize].rule.clone();\n1217\t    ast.cur_node = par;\n1218\t    ast.cur_rule = Some(rule);\n1219\t    par\n1220\t}\n1221\t\n1222\t/// Aborts parsing with the given message and rule.\n1223\tpub fn skp__abort(ast: &mut Ast, msg: &str, rule: &str) {\n1224\t    if !msg.is_empty() {\n1225\t        ast.err_msg = Some(msg.to_string());\n1226\t    }\n1227\t    ast.err_pos = ast.pos;\n1228\t    ast.err_rule = Some(rule.to_string());\n1229\t    ast.fail = 1;\n1230\t    // Note: Rust does not use setjmp/longjmp.  Set the failure flag so the\n1231\t    // caller observes the abort condition.\n1232\t}\n1233\t\n1234\t/// Records memoization of AST nodes (for left recursion etc.).\n1235\tpub fn skp_memoize(ast: &mut Ast, mmz: &mut AstMmz, _rule: &str, old_pos: i32, start_par: i32) {\n1236\t    let end_par = ast.par_cnt;\n1237\t    let (start_par, end_par) = if ast.fail != 0 || end_par <= start_par {\n1238\t        (-1i32, -1i32)\n1239\t    } else {\n1240\t        (start_par, end_par)\n1241\t    };\n1242\t    let numnodes = if start_par < 0 || end_par < 0 {\n1243\t        0\n1244\t    } else {\n1245\t        (end_par - start_par) / 2\n1246\t    };\n1247\t\n1248\t    mmz.pos = old_pos;\n1249\t    mmz.endpos = ast.pos;\n1250\t    mmz.numnodes = if ast.fail != 0 { -1 } else { numnodes };\n1251\t    mmz.maxnodes = numnodes;\n1252\t    mmz.lastinfo = ast.lastinfo;\n1253\t\n1254\t    mmz.nodes.clear();\n1255\t    if start_par >= 0 && end_par >= 0 {\n1256\t        for k in start_par..end_par {\n1257\t            let p = ast.par[k as usize];\n1258\t            if p >= 0 {\n1259\t                mmz.nodes.push(ast.nodes[p as usize].clone());\n1260\t            }\n1261\t        }\n1262\t    }\n1263\t}\n1264\t\n1265\t/// Attempts to retrieve a memoized result.\n1266\tpub fn skp_dememoize(ast: &mut Ast, mmz: &mut AstMmz, _rule: &str) -> i32 {\n1267\t    if mmz.pos != ast.pos {\n1268\t        return 0;\n1269\t    }\n1270\t    let numnodes = mmz.numnodes;\n1271\t    ast.fail = if numnodes < 0 { 1 } else { 0 };\n1272\t    ast.lastpos = ast.pos;\n1273\t    ast.pos = mmz.endpos;\n1274\t    ast.lastinfo = mmz.lastinfo;\n1275\t    if numnodes > 0 {\n1276\t        skp_nodes_makeroom(ast, numnodes);\n1277\t        skp_par_makeroom(ast, 2 * numnodes);\n1278\t        let start_par = ast.par_cnt;\n1279\t        let total_par = (2 * numnodes) as usize;\n1280\t        for i in 0..total_par {\n1281\t            let idx = start_par as usize + i;\n1282\t            if ast.par.len() <= idx {\n1283\t                ast.par.resize(idx + 1, i32::MAX);\n1284\t            } else {\n1285\t                ast.par[idx] = i32::MAX;\n1286\t            }\n1287\t        }\n1288\t        let mut cur_par = start_par;\n1289\t        for k in 0..numnodes {\n1290\t            let n = ast.nodes_cnt;\n1291\t            if (ast.nodes.len() as i32) <= n {\n1292\t                ast.nodes.resize((n + 1) as usize, AstNode::default());\n1293\t            }\n1294\t            ast.nodes[n as usize] = mmz.nodes[k as usize].clone();\n1295\t            while cur_par < ast.par_max && ast.par[cur_par as usize] != i32::MAX {\n1296\t                cur_par += 1;\n1297\t            }\n1298\t            if cur_par >= ast.par_max {\n1299\t                break;\n1300\t            }\n1301\t            ast.par[cur_par as usize] = n;\n1302\t            let delta = mmz.nodes[k as usize].delta;\n1303\t            let close_idx = (cur_par + delta) as usize;\n1304\t            if close_idx < ast.par.len() {\n1305\t                ast.par[close_idx] = -delta;\n1306\t            }\n1307\t            ast.nodes_cnt += 1;\n1308\t        }\n1309\t        ast.par_cnt += 2 * numnodes;\n1310\t    }\n1311\t    1\n1312\t}\n1313\t\n1314\t/// Sets AST node information (tag).\n1315\tpub fn ast_setinfo(ast: &mut Ast, info: i32, node: AstNodeT) {\n1316\t    if ast.par_cnt <= node {\n1317\t        return;\n1318\t    }\n1319\t    let mut node = node;\n1320\t    if node == ASTNULL {\n1321\t        node = ast.par_cnt - 1;\n1322\t    }\n1323\t    if node < 0 || node >= ast.par_cnt {\n1324\t        return;\n1325\t    }\n1326\t    let mut idx = node;\n1327\t    if ast.par[idx as usize] < 0 {\n1328\t        idx += ast.par[idx as usize];\n1329\t    }\n1330\t    if idx < 0 {\n1331\t        return;\n1332\t    }\n1333\t    let pn = ast.par[idx as usize];\n1334\t    if pn >= 0 && (pn as usize) < ast.nodes.len() {\n1335\t        ast.nodes[pn as usize].tag = info;\n1336\t    }\n1337\t}\n1338\t\n1339\t/// Records a new AST info node.\n1340\tpub fn astnewinfo(ast: &mut Ast, info: i32) {\n1341\t    if ast.fail != 0 {\n1342\t        return;\n1343\t    }\n1344\t    let pos = ast.pos;\n1345\t    let par = ast_open(ast, pos, \"#\");\n1346\t    ast_close(ast, pos, par);\n1347\t    if par >= 0 && (par as usize) < ast.par.len() {\n1348\t        let pn = ast.par[par as usize];\n1349\t        if pn >= 0 && (pn as usize) < ast.nodes.len() {\n1350\t            ast.nodes[pn as usize].tag = info;\n1351\t        }\n1352\t    }\n1353\t    ast.lastinfo = info;\n1354\t}\n1355\t\n1356\t/// Retrieves the information associated with a node.\n1357\tpub fn astnodeinfo(ast: &Ast, node: AstNodeT) -> i32 {\n1358\t    if node < 0 || node >= ast.par_cnt {\n1359\t        return 0;\n1360\t    }\n1361\t    let mut idx = node;\n1362\t    if ast.par[idx as usize] < 0 {\n1363\t        idx += ast.par[idx as usize];\n1364\t    }\n1365\t    if idx < 0 {\n1366\t        return 0;\n1367\t    }\n1368\t    let pn = ast.par[idx as usize];\n1369\t    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n1370\t        return 0;\n1371\t    }\n1372\t    ast.nodes[pn as usize].tag\n1373\t}\n1374\t\n1375\t/// Swaps the last two AST nodes.\n1376\tpub fn ast_swap(ast: &mut Ast) {\n1377\t    if ast.fail != 0 || ast.par_cnt < 4 {\n1378\t        return;\n1379\t    }\n1380\t    let c1 = ast.par_cnt - 1;\n1381\t    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n1382\t        return;\n1383\t    }\n1384\t    let o1 = c1 + ast.par[c1 as usize];\n1385\t    if o1 < 0 || ast.par[o1 as usize] < 0 {\n1386\t        return;\n1387\t    }\n1388\t    let c2 = o1 - 1;\n1389\t    if c2 < 0 || ast.par[c2 as usize] >= 0 {\n1390\t        return;\n1391\t    }\n1392\t    let o2 = c2 + ast.par[c2 as usize];\n1393\t    if o2 < 0 || ast.par[o2 as usize] < 0 {\n1394\t        return;\n1395\t    }\n1396\t    let len2 = (c2 - o2 + 1) as usize;\n1397\t    let len1 = (c1 - o1 + 1) as usize;\n1398\t    let tmp: Vec<i32> = ast.par[o2 as usize..(o2 as usize + len2)].to_vec();\n1399\t    // Move first block to o2\n1400\t    for i in 0..len1 {\n1401\t        ast.par[o2 as usize + i] = ast.par[o1 as usize + i];\n1402\t    }\n1403\t    // Place tmp after the moved block\n1404\t    for i in 0..len2 {\n1405\t        ast.par[o2 as usize + len1 + i] = tmp[i];\n1406\t    }\n1407\t}\n1408\t\n1409\t/// Lowers a node (wraps a group of nodes into a new parent).\n1410\tpub fn ast_lower(ast: &mut Ast, rule: &str, lft: AstNodeT, rgt: AstNodeT) {\n1411\t    if ast.par_cnt <= lft || ast.par_cnt <= rgt || lft >= rgt {\n1412\t        return;\n1413\t    }\n1414\t    let mut lft = lft;\n1415\t    let mut rgt = rgt;\n1416\t    if ast.par[lft as usize] < 0 {\n1417\t        lft += ast.par[lft as usize];\n1418\t    }\n1419\t    if ast.par[rgt as usize] < 0 {\n1420\t        rgt += ast.par[rgt as usize];\n1421\t    }\n1422\t    let lft_node = ast.par[lft as usize];\n1423\t    let rgt_node = ast.par[rgt as usize];\n1424\t    let node_from = ast.nodes[lft_node as usize].from;\n1425\t    let node_to = ast.nodes[rgt_node as usize].to;\n1426\t    rgt += ast.nodes[rgt_node as usize].delta;\n1427\t\n1428\t    let new_node = ast_newnode(ast);\n1429\t    if new_node < 0 {\n1430\t        return;\n1431\t    }\n1432\t    let delta = rgt - lft + 2;\n1433\t    ast.nodes[new_node as usize] = AstNode {\n1434\t        rule: rule.to_string(),\n1435\t        from: node_from,\n1436\t        to: node_to,\n1437\t        delta,\n1438\t        tag: 0,\n1439\t    };\n1440\t    if ast_newpar(ast) < 0 {\n1441\t        return;\n1442\t    }\n1443\t    if ast_newpar(ast) < 0 {\n1444\t        return;\n1445\t    }\n1446\t\n1447\t    // Move nodes after rgt down by 2\n1448\t    if ast.par_cnt - 1 - rgt > 2 {\n1449\t        let count = (ast.par_cnt - 1 - rgt - 2) as usize;\n1450\t        for i in (0..count).rev() {\n1451\t            ast.par[(rgt + 3) as usize + i] = ast.par[(rgt + 1) as usize + i];\n1452\t        }\n1453\t    }\n1454\t    // Move block [lft..=rgt] right by 1\n1455\t    let block_len = (rgt - lft + 1) as usize;\n1456\t    for i in (0..block_len).rev() {\n1457\t        ast.par[(lft + 1) as usize + i] = ast.par[lft as usize + i];\n1458\t    }\n1459\t    ast.par[lft as usize] = new_node;\n1460\t    ast.par[(rgt + 2) as usize] = -delta;\n1461\t}\n1462\t\n1463\t/// Lifts a node (removes a level from the AST).\n1464\tpub fn ast_lift(ast: &mut Ast) {\n1465\t    if ast.fail != 0 || ast.par_cnt < 4 {\n1466\t        return;\n1467\t    }\n1468\t    let c1 = ast.par_cnt - 1;\n1469\t    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n1470\t        return;\n1471\t    }\n1472\t    let c2 = c1 - 1;\n1473\t    if c2 < 0 || ast.par[c2 as usize] >= 0 {\n1474\t        return;\n1475\t    }\n1476\t    let o1 = c1 + ast.par[c1 as usize];\n1477\t    if o1 < 0 || ast.par[o1 as usize] < 0 {\n1478\t        return;\n1479\t    }\n1480\t    let o2 = c2 + ast.par[c2 as usize];\n1481\t    if o2 < 0 || ast.par[o2 as usize] < 0 {\n1482\t        return;\n1483\t    }\n1484\t    if o2 != o1 + 1 {\n1485\t        return;\n1486\t    }\n1487\t    if ast.nodes[ast.par[o1 as usize] as usize].tag == 0 {\n1488\t        let span = (c2 - o2 + 1) as usize;\n1489\t        for i in 0..span {\n1490\t            ast.par[o1 as usize + i] = ast.par[o2 as usize + i];\n1491\t        }\n1492\t        ast.par_cnt -= 2;\n1493\t    }\n1494\t}\n1495\t\n1496\t/// Lifts all single-child nodes.\n1497\tpub fn ast_lift_all(ast: &mut Ast) {\n1498\t    loop {\n1499\t        let n = ast.par_cnt;\n1500\t        ast_lift(ast);\n1501\t        if n == ast.par_cnt {\n1502\t            break;\n1503\t        }\n1504\t    }\n1505\t}\n1506\t\n1507\t/// Removes the last leaf node.\n1508\tpub fn ast_noleaf(ast: &mut Ast) {\n1509\t    if ast.fail != 0 || ast.par_cnt < 2 {\n1510\t        return;\n1511\t    }\n1512\t    let c1 = ast.par_cnt - 1;\n1513\t    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n1514\t        return;\n1515\t    }\n1516\t    let o1 = c1 + ast.par[c1 as usize];\n1517\t    if o1 < 0 || ast.par[o1 as usize] < 0 {\n1518\t        return;\n1519\t    }\n1520\t    if c1 == o1 + 1 {\n1521\t        ast.par_cnt -= 2;\n1522\t    }\n1523\t}\n1524\t\n1525\t/// Removes the last empty leaf node.\n1526\tpub fn ast_noemptyleaf(ast: &mut Ast) {\n1527\t    if ast.fail != 0 || ast.par_cnt < 2 {\n1528\t        return;\n1529\t    }\n1530\t    let c1 = ast.par_cnt - 1;\n1531\t    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n1532\t        return;\n1533\t    }\n1534\t    let o1 = c1 + ast.par[c1 as usize];\n1535\t    if o1 < 0 || ast.par[o1 as usize] < 0 {\n1536\t        return;\n1537\t    }\n1538\t    if c1 != o1 + 1 {\n1539\t        return;\n1540\t    }\n1541\t    let pn = ast.par[o1 as usize];\n1542\t    if ast.nodes[pn as usize].from != ast.nodes[pn as usize].to {\n1543\t        return;\n1544\t    }\n1545\t    ast.par_cnt -= 2;\n1546\t}\n1547\t\n1548\t/// Returns the index of the last AST node.\n1549\tpub fn ast_lastnode(ast: &Ast) -> AstNodeT {\n1550\t    if ast.fail != 0 || ast.par_cnt < 2 {\n1551\t        return ASTNULL;\n1552\t    }\n1553\t    let c1 = ast.par_cnt - 1;\n1554\t    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n1555\t        return ASTNULL;\n1556\t    }\n1557\t    let o1 = c1 + ast.par[c1 as usize];\n1558\t    if o1 < 0 || ast.par[o1 as usize] < 0 {\n1559\t        return ASTNULL;\n1560\t    }\n1561\t    o1\n1562\t}\n1563\t\n1564\t/// Checks if the last node is empty.\n1565\tpub fn ast_lastnodeisempty(ast: &Ast) -> bool {\n1566\t    let node = ast_lastnode(ast);\n1567\t    if node == ASTNULL {\n1568\t        return false;\n1569\t    }\n1570\t    let pn = ast.par[node as usize];\n1571\t    if pn < 0 {\n1572\t        return false;\n1573\t    }\n1574\t    let nd = &ast.nodes[pn as usize];\n1575\t    nd.from == nd.to\n1576\t}\n1577\t\n1578\t/// Deletes the last node.\n1579\tpub fn ast_delete(ast: &mut Ast) {\n1580\t    if ast.fail != 0 || ast.par_cnt < 2 {\n1581\t        return;\n1582\t    }\n1583\t    let c1 = ast.par_cnt - 1;\n1584\t    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n1585\t        return;\n1586\t    }\n1587\t    let o1 = c1 + ast.par[c1 as usize];\n1588\t    if o1 < 0 || ast.par[o1 as usize] < 0 {\n1589\t        return;\n1590\t    }\n1591\t    ast.par_cnt -= c1 - o1 + 1;\n1592\t}\n1593\t\n1594\t/// Returns the “left” sibling of a node.\n1595\tpub fn astleft(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1596\t    if node <= 0 || ast.par_cnt <= node {\n1597\t        return ASTNULL;\n1598\t    }\n1599\t    let mut node = node;\n1600\t    if ast.par[node as usize] < 0 {\n1601\t        node += ast.par[node as usize];\n1602\t    }\n1603\t    node -= 1;\n1604\t    if node <= 0 || ast.par[node as usize] >= 0 {\n1605\t        return ASTNULL;\n1606\t    }\n1607\t    node += ast.par[node as usize];\n1608\t    node\n1609\t}\n1610\t\n1611\t/// Returns the “right” sibling of a node.\n1612\tpub fn astright(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1613\t    if node <= 0 || ast.par_cnt <= node {\n1614\t        return ASTNULL;\n1615\t    }\n1616\t    let mut node = node;\n1617\t    if ast.par[node as usize] > 0 {\n1618\t        let pn = ast.par[node as usize];\n1619\t        node += ast.nodes[pn as usize].delta;\n1620\t    }\n1621\t    node += 1;\n1622\t    if node >= ast.par_cnt || ast.par[node as usize] < 0 {\n1623\t        return ASTNULL;\n1624\t    }\n1625\t    node\n1626\t}\n1627\t\n1628\t/// Returns the parent of a node.\n1629\tpub fn astup(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1630\t    let node = astfirst(ast, node);\n1631\t    if node == ASTNULL {\n1632\t        return ASTNULL;\n1633\t    }\n1634\t    let n = node - 1;\n1635\t    if n < 0 || ast.par[n as usize] < 0 {\n1636\t        return ASTNULL;\n1637\t    }\n1638\t    n\n1639\t}\n1640\t\n1641\t/// Returns the first child of a node.\n1642\tpub fn astdown(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1643\t    if node < 0 || ast.par_cnt <= node {\n1644\t        return ASTNULL;\n1645\t    }\n1646\t    let n = node + 1;\n1647\t    if n >= ast.par_cnt || ast.par[n as usize] < 0 {\n1648\t        return ASTNULL;\n1649\t    }\n1650\t    n\n1651\t}\n1652\t\n1653\t/// Returns the leftmost sibling of a node.\n1654\tpub fn astfirst(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1655\t    if node < 0 || ast.par_cnt <= node {\n1656\t        return ASTNULL;\n1657\t    }\n1658\t    let mut cur = node;\n1659\t    loop {\n1660\t        let n = astleft(ast, cur);\n1661\t        if n == ASTNULL {\n1662\t            break;\n1663\t        }\n1664\t        cur = n;\n1665\t    }\n1666\t    cur\n1667\t}\n1668\t\n1669\t/// Returns the rightmost sibling of a node.\n1670\tpub fn astlast(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1671\t    if node < 0 || ast.par_cnt <= node {\n1672\t        return ASTNULL;\n1673\t    }\n1674\t    let mut cur = node;\n1675\t    loop {\n1676\t        let n = astright(ast, cur);\n1677\t        if n == ASTNULL {\n1678\t            break;\n1679\t        }\n1680\t        cur = n;\n1681\t    }\n1682\t    cur\n1683\t}\n1684\t\n1685\t/// Returns the next node in a depth-first traversal.\n1686\tpub fn astnextdf(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1687\t    let n = node + 1;\n1688\t    if n < 0 {\n1689\t        return 0;\n1690\t    }\n1691\t    if n >= ast.par_cnt {\n1692\t        return ASTNULL;\n1693\t    }\n1694\t    n\n1695\t}\n1696\t\n1697\t/// Checks if the given index is an entry (open parenthesis) node.\n1698\tpub fn astisnodeentry(ast: &Ast, node: AstNodeT) -> bool {\n1699\t    node < ast.par_cnt && node >= 0 && ast.par[node as usize] >= 0\n1700\t}\n1701\t\n1702\t/// Checks if the given index is an exit (closing parenthesis) node.\n1703\tpub fn astisnodeexit(ast: &Ast, node: AstNodeT) -> bool {\n1704\t    node < ast.par_cnt && node >= 0 && ast.par[node as usize] < 0\n1705\t}\n1706\t\n1707\t/// Returns the rule name associated with a node.\n1708\tpub fn astnoderule(ast: &Ast, node: AstNodeT) -> &str {\n1709\t    if node < 0 || node >= ast.par_cnt {\n1710\t        return \"\";\n1711\t    }\n1712\t    let mut idx = node;\n1713\t    if ast.par[idx as usize] < 0 {\n1714\t        idx += ast.par[idx as usize];\n1715\t    }\n1716\t    if idx < 0 {\n1717\t        return \"\";\n1718\t    }\n1719\t    let pn = ast.par[idx as usize];\n1720\t    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n1721\t        return \"\";\n1722\t    }\n1723\t    &ast.nodes[pn as usize].rule\n1724\t}\n1725\t\n1726\t/// Returns the source substring from the start of the node.\n1727\tpub fn astnodefrom(ast: &Ast, node: AstNodeT) -> &str {\n1728\t    if node < 0 || node >= ast.par_cnt {\n1729\t        return \"\";\n1730\t    }\n1731\t    let mut idx = node;\n1732\t    if ast.par[idx as usize] < 0 {\n1733\t        idx += ast.par[idx as usize];\n1734\t    }\n1735\t    if idx < 0 {\n1736\t        return \"\";\n1737\t    }\n1738\t    let pn = ast.par[idx as usize];\n1739\t    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n1740\t        return \"\";\n1741\t    }\n1742\t    let from = ast.nodes[pn as usize].from as usize;\n1743\t    let bytes = ast.start.as_bytes();\n1744\t    let f = from.min(bytes.len());\n1745\t    if ast.start.is_char_boundary(f) {\n1746\t        &ast.start[f..]\n1747\t    } else {\n1748\t        \"\"\n1749\t    }\n1750\t}\n1751\t\n1752\t/// Returns the source substring up to the end of the node.\n1753\tpub fn astnodeto(ast: &Ast, node: AstNodeT) -> &str {\n1754\t    if node < 0 || node >= ast.par_cnt {\n1755\t        return \"\";\n1756\t    }\n1757\t    let mut idx = node;\n1758\t    if ast.par[idx as usize] < 0 {\n1759\t        idx += ast.par[idx as usize];\n1760\t    }\n1761\t    if idx < 0 {\n1762\t        return \"\";\n1763\t    }\n1764\t    let pn = ast.par[idx as usize];\n1765\t    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n1766\t        return \"\";\n1767\t    }\n1768\t    let to = ast.nodes[pn as usize].to as usize;\n1769\t    let bytes = ast.start.as_bytes();\n1770\t    let t = to.min(bytes.len());\n1771\t    if ast.start.is_char_boundary(t) {\n1772\t        &ast.start[t..]\n1773\t    } else {\n1774\t        \"\"\n1775\t    }\n1776\t}\n1777\t\n1778\t/// Returns the length of the node.\n1779\tpub fn astnodelen(ast: &Ast, node: AstNodeT) -> i32 {\n1780\t    if node < 0 || node >= ast.par_cnt {\n1781\t        return 0;\n1782\t    }\n1783\t    let mut idx = node;\n1784\t    if ast.par[idx as usize] < 0 {\n1785\t        idx += ast.par[idx as usize];\n1786\t    }\n1787\t    if idx < 0 {\n1788\t        return 0;\n1789\t    }\n1790\t    let pn = ast.par[idx as usize];\n1791\t    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n1792\t        return 0;\n1793\t    }\n1794\t    ast.nodes[pn as usize].to - ast.nodes[pn as usize].from\n1795\t}\n1796\t\n1797\t/// Checks if a node is a leaf.\n1798\tpub fn astisleaf(ast: &Ast, node: AstNodeT) -> bool {\n1799\t    if node < 0 || node >= ast.par_cnt {\n1800\t        return false;\n1801\t    }\n1802\t    let mut idx = node;\n1803\t    if ast.par[idx as usize] < 0 {\n1804\t        idx += ast.par[idx as usize];\n1805\t    }\n1806\t    if idx < 0 {\n1807\t        return false;\n1808\t    }\n1809\t    let pn = ast.par[idx as usize];\n1810\t    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n1811\t        return false;\n1812\t    }\n1813\t    ast.nodes[pn as usize].delta == 1\n1814\t}\n1815\t\n1816\t/// Returns the next node in the AST (wrapper for astnextdf).\n1817\tpub fn astnext(ast: &Ast, node: AstNodeT) -> AstNodeT {\n1818\t    astnextdf(ast, node)\n1819\t}\n1820\t\n1821\t/// Returns a match code if the node’s rule is one of several provided.\n1822\tpub fn ast_isn(\n1823\t    ast: &Ast,\n1824\t    node: AstNodeT,\n1825\t    r1: &str,\n1826\t    r2: Option<&str>,\n1827\t    r3: Option<&str>,\n1828\t    r4: Option<&str>,\n1829\t    r5: Option<&str>,\n1830\t) -> i32 {\n1831\t    if ast_is(ast, node, r1) != 0 {\n1832\t        return 1;\n1833\t    }\n1834\t    if let Some(r) = r2 {\n1835\t        if ast_is(ast, node, r) != 0 {\n1836\t            return 1;\n1837\t        }\n1838\t    }\n1839\t    if let Some(r) = r3 {\n1840\t        if ast_is(ast, node, r) != 0 {\n1841\t            return 1;\n1842\t        }\n1843\t    }\n1844\t    if let Some(r) = r4 {\n1845\t        if ast_is(ast, node, r) != 0 {\n1846\t            return 1;\n1847\t        }\n1848\t    }\n1849\t    if let Some(r) = r5 {\n1850\t        if ast_is(ast, node, r) != 0 {\n1851\t            return 1;\n1852\t        }\n1853\t    }\n1854\t    0\n1855\t}\n1856\t\n1857\t/// Checks if a node’s rule matches a given rule.\n1858\tpub fn ast_is(ast: &Ast, node: AstNodeT, rulename: &str) -> i32 {\n1859\t    if node == ASTNULL || node >= ast.par_cnt || node < 0 {\n1860\t        return 0;\n1861\t    }\n1862\t    let mut idx = node;\n1863\t    if ast.par[idx as usize] < 0 {\n1864\t        idx += ast.par[idx as usize];\n1865\t    }\n1866\t    if idx < 0 {\n1867\t        return 0;\n1868\t    }\n1869\t    let pn = ast.par[idx as usize];\n1870\t    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n1871\t        return 0;\n1872\t    }\n1873\t    if ast.nodes[pn as usize].rule == rulename {\n1874\t        1\n1875\t    } else {\n1876\t        0\n1877\t    }\n1878\t}\n1879\t\n1880\t/// Checks if the AST contains an error.\n1881\tpub fn asthaserr(ast: &Ast) -> bool {\n1882\t    ast.err_pos >= 0\n1883\t}\n1884\t\n1885\t/// Returns the rule name at which an error occurred.\n1886\tpub fn asterrrule(ast: &Ast) -> Option<&str> {\n1887\t    if ast.err_pos < 0 {\n1888\t        return Some(\"\");\n1889\t    }\n1890\t    ast.err_rule.as_deref()\n1891\t}\n1892\t\n1893\t/// Returns the error position as a string pointer.\n1894\tpub fn asterrpos(ast: &Ast) -> Option<&str> {\n1895\t    if ast.err_pos < 0 {\n1896\t        return Some(\"\");\n1897\t    }\n1898\t    let p = ast.err_pos as usize;\n1899\t    let bytes = ast.start.as_bytes();\n1900\t    if p > bytes.len() || !ast.start.is_char_boundary(p) {\n1901\t        return Some(\"\");\n1902\t    }\n1903\t    Some(&ast.start[p..])\n1904\t}\n1905\t\n1906\t/// Returns the start of the error line.\n1907\tpub fn asterrline(ast: &Ast) -> &str {\n1908\t    if ast.err_pos < 0 {\n1909\t        return \"\";\n1910\t    }\n1911\t    let bytes = ast.start.as_bytes();\n1912\t    let mut p = (ast.err_pos as usize).min(bytes.len());\n1913\t    while p > 0 {\n1914\t        let prev = bytes[p - 1];\n1915\t        if prev == b'\\n' || prev == b'\\r' {\n1916\t            break;\n1917\t        }\n1918\t        p -= 1;\n1919\t    }\n1920\t    if ast.start.is_char_boundary(p) {\n1921\t        &ast.start[p..]\n1922\t    } else {\n1923\t        \"\"\n1924\t    }\n1925\t}\n1926\t\n1927\t/// Returns the error column number.\n1928\tpub fn asterrcolnum(ast: &Ast) -> i32 {\n1929\t    if ast.err_pos < 0 {\n1930\t        return 0;\n1931\t    }\n1932\t    let bytes = ast.start.as_bytes();\n1933\t    let mut p = (ast.err_pos as usize).min(bytes.len());\n1934\t    let err_pos = p;\n1935\t    while p > 0 {\n1936\t        let prev = bytes[p - 1];\n1937\t        if prev == b'\\n' || prev == b'\\r' {\n1938\t            break;\n1939\t        }\n1940\t        p -= 1;\n1941\t    }\n1942\t    (err_pos - p) as i32\n1943\t}\n1944\t\n1945\t/// Prints the AST in s-expression format.\n1946\tpub fn astprintsexpr(ast: &Ast, f: &mut dyn std::io::Write) {\n1947\t    let mut node: AstNodeT = ASTNULL;\n1948\t    loop {\n1949\t        node = astnextdf(ast, node);\n1950\t        if node == ASTNULL {\n1951\t            break;\n1952\t        }\n1953\t        if astisnodeentry(ast, node) {\n1954\t            let _ = write!(f, \"({} \", astnoderule(ast, node));\n1955\t            if astisleaf(ast, node) {\n1956\t                let _ = write!(f, \"'\");\n1957\t                if astnoderule(ast, node) == \"#\" {\n1958\t                    let _ = write!(f, \"{}\", astnodeinfo(ast, node));\n1959\t                } else {\n1960\t                    let from_s = astnodefrom(ast, node);\n1961\t                    let to_s = astnodeto(ast, node);\n1962\t                    let from_len = from_s.len();\n1963\t                    let to_len = to_s.len();\n1964\t                    let take = from_len.saturating_sub(to_len);\n1965\t                    let slice = &from_s[..take.min(from_len)];\n1966\t                    for ch in slice.chars() {\n1967\t                        if ch == '\\'' {\n1968\t                            let _ = write!(f, \"\\\\\");\n1969\t                        }\n1970\t                        let _ = write!(f, \"{}\", ch);\n1971\t                    }\n1972\t                }\n1973\t                let _ = write!(f, \"'\");\n1974\t            }\n1975\t        } else {\n1976\t            let _ = write!(f, \")\");\n1977\t        }\n1978\t    }\n1979\t}\n1980\t\n1981\t/// Prints the AST as a tree.\n1982\tpub fn astprinttree(ast: &Ast, f: &mut dyn std::io::Write) {\n1983\t    let mut node: AstNodeT = ASTNULL;\n1984\t    let mut levl: i32 = 0;\n1985\t    loop {\n1986\t        node = astnextdf(ast, node);\n1987\t        if node == ASTNULL {\n1988\t            break;\n1989\t        }\n1990\t        if astisnodeentry(ast, node) {\n1991\t            let mut k = 0;\n1992\t            while k < levl {\n1993\t                let _ = write!(f, \"    \");\n1994\t                k += 4;\n1995\t            }\n1996\t            let _ = write!(f, \"[{}\", astnoderule(ast, node));\n1997\t            let tag = astnodeinfo(ast, node);\n1998\t            if tag != 0 {\n1999\t                let _ = write!(f, \" ({})\", tag);\n2000\t            }\n2001\t            let _ = write!(f, \"]\");\n2002\t            levl += 4;\n2003\t            if astisleaf(ast, node) {\n2004\t                let _ = write!(f, \" '\");\n2005\t                let from_s = astnodefrom(ast, node);\n2006\t                let to_s = astnodeto(ast, node);\n2007\t                let from_len = from_s.len();\n2008\t                let to_len = to_s.len();\n2009\t                let take = from_len.saturating_sub(to_len);\n2010\t                let slice = &from_s[..take.min(from_len)];\n2011\t                for ch in slice.chars() {\n2012\t                    if ch == '\\'' {\n2013\t                        let _ = write!(f, \"\\\\\");\n2014\t                    }\n2015\t                    let _ = write!(f, \"{}\", ch);\n2016\t                }\n2017\t                let _ = write!(f, \"'\");\n2018\t            }\n2019\t            let _ = writeln!(f);\n2020\t        } else {\n2021\t            levl -= 4;\n2022\t        }\n2023\t    }\n2024\t}\n2025\t\n2026\t// effective_len is referenced by some helpers but currently unused; suppress warnings\n2027\t#[allow(dead_code)]\n2028\tfn _unused() {\n2029\t    let _ = effective_len(\"\");\n2030\t}\n2031\t"}]},"parent_tool_use_id":null,"session_id":"b141ccab-ee12-410c-99c6-10dd2e96d1c7","uuid":"79782e23-aac5-402c-93e9-30a07515e7e1","timestamp":"2026-05-29T19:27:05.045Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-NMToUg/project/src/skp.rs","content":"/// SKP version information.\npub const SKP_VER: u32 = 0x0003001C;\npub const SKP_VER_STR: &str = \"0.3.1rc\";\n/// A loop state used for scanning.\n/// (In the C header this is defined only via macros; here we provide a Rust struct.)\n#[derive(Debug, Default, Clone)]\npub struct SkpLoop {\n    pub start: String,\n    pub to: Option<String>,\n    pub end: Option<String>,\n    pub alt: i32,\n}\n/// Returns the “length” from start to to. (This mimics the inline function `skp_loop_len`.)\npub fn skp_loop_len(start: &str, to: &str) -> i32 {\n    let s_ptr = start.as_ptr() as isize;\n    let t_ptr = to.as_ptr() as isize;\n    let ret = (t_ptr - s_ptr) as i32;\n    if ret >= 0 && ret <= (1 << 16) {\n        ret\n    } else {\n        0\n    }\n}\n/// Global variable used in the C code.\n/// (In C declared as `volatile int skp_zero;`—here we use a mutable static.)\npub static mut SKP_ZERO: i32 = 0;\n/// Trace function (corresponds to the C macro skptrace).\npub fn skptrace(args: std::fmt::Arguments) {\n    eprintln!(\"TRCE: {}\", args);\n}\n\n// ==================================================================\n// Helper utilities (byte-based, internal)\n// ==================================================================\n\n/// Return the number of bytes in s up to (but not including) the first NUL byte,\n/// or s.len() if no NUL byte is present.  Mirrors C's null-terminated semantics.\nfn effective_len(s: &str) -> usize {\n    let bytes = s.as_bytes();\n    bytes.iter().position(|&b| b == 0).unwrap_or(bytes.len())\n}\n\n/// Read the next packed UTF-8 codepoint at `idx` from byte slice `bytes`.\n/// `iso` non-zero means treat each byte independently (no UTF-8 grouping).\n/// Returns (codepoint_packed_into_u32, byte_index_just_after).\nfn skp_next_idx(bytes: &[u8], idx: usize, iso: bool) -> (u32, usize) {\n    if idx >= bytes.len() || bytes[idx] == 0 {\n        return (0, idx);\n    }\n    let mut c: u32 = bytes[idx] as u32;\n    let mut i = idx + 1;\n    if !iso {\n        // Read up to 3 continuation bytes\n        for _ in 0..3 {\n            if i < bytes.len() && (bytes[i] & 0xC0) == 0x80 {\n                c = (c << 8) | (bytes[i] as u32);\n                i += 1;\n            } else {\n                break;\n            }\n        }\n    }\n    if c == 0x0D && i < bytes.len() && bytes[i] == 0x0A {\n        c = 0x0D0A;\n        i += 1;\n    }\n    (c, i)\n}\n\n// ==================================================================\n// Public character helpers\n// ==================================================================\n\n/// Returns the next Unicode code point from the string `s` (similar to `skp_next` in C).\n/// Returns a tuple `(code_point, rest_of_string)`.\npub fn skp_next(s: &str, iso: i32) -> (u32, &str) {\n    let bytes = s.as_bytes();\n    let (c, i) = skp_next_idx(bytes, 0, iso != 0);\n    let i = i.min(bytes.len());\n    // Try to slice on a UTF-8 boundary.  If `i` lands inside a multi-byte\n    // character (only possible for malformed input), fall back to ASCII view.\n    let rest = if s.is_char_boundary(i) {\n        &s[i..]\n    } else {\n        // Should not happen for valid UTF-8 inputs, but guard anyway.\n        &s[bytes.len()..]\n    };\n    (c, rest)\n}\n\n/// Compares two code points. If `fold` is nonzero, performs case‑insensitive comparison.\npub fn chr_cmp(a: u32, b: u32, fold: i32) -> bool {\n    let mut a = a;\n    let mut b = b;\n    if fold != 0 && a <= 0x7F && b <= 0x7F {\n        if (b'A' as u32..=b'Z' as u32).contains(&a) {\n            a += 0x20;\n        }\n        if (b'A' as u32..=b'Z' as u32).contains(&b) {\n            b += 0x20;\n        }\n    }\n    a == b\n}\n\n/// Returns true if `c` is a blank character.\npub fn is_blank(c: u32) -> bool {\n    if c < 0xFF {\n        return c == 0x20 || c == 0x09;\n    }\n    match c & 0xFFFFFF00 {\n        0x00000000 => c == 0xA0,\n        0x0000C200 => c == 0xC2A0,\n        0x00E19A00 => c == 0xE19A80,\n        0x00E28000 => (0xE28080..=0xE2808A).contains(&c) || c == 0xE280AF,\n        0x00E38080 => c == 0xE38080,\n        _ => false,\n    }\n}\n\n/// Returns true if `c` is a line-break character.\npub fn is_break(c: u32) -> bool {\n    if c < 0x0F {\n        return c == 0x0A || c == 0x0C || c == 0x0D;\n    }\n    if c < 0xFF {\n        return c == 0x85;\n    }\n    c == 0x0D0A || c == 0xC285 || c == 0xE280A8 || c == 0xE280A9\n}\n\n/// Returns true if `c` is a space (blank or break).\npub fn is_space(c: u32) -> bool {\n    is_blank(c) || is_break(c)\n}\n\n/// Returns true if `c` is a digit.\npub fn is_digit(c: u32) -> bool {\n    (b'0' as u32..=b'9' as u32).contains(&c)\n}\n\n/// Returns true if `c` is a hexadecimal digit.\npub fn is_xdigit(c: u32) -> bool {\n    (b'0' as u32..=b'9' as u32).contains(&c)\n        || (b'A' as u32..=b'F' as u32).contains(&c)\n        || (b'a' as u32..=b'f' as u32).contains(&c)\n}\n\n/// Returns true if `c` is an uppercase letter.\npub fn is_upper(c: u32) -> bool {\n    (b'A' as u32..=b'Z' as u32).contains(&c)\n}\n\n/// Returns true if `c` is a lowercase letter.\npub fn is_lower(c: u32) -> bool {\n    (b'a' as u32..=b'z' as u32).contains(&c)\n}\n\n/// Returns true if `c` is an alphabetic character.\npub fn is_alpha(c: u32) -> bool {\n    is_upper(c) || is_lower(c)\n}\n\n/// Returns true if `c` is a valid identifier character.\npub fn is_idchr(c: u32) -> bool {\n    is_alpha(c) || is_digit(c) || c == b'_' as u32\n}\n\n/// Returns true if `c` is alphanumeric.\npub fn is_alnum(c: u32) -> bool {\n    is_alpha(c) || is_digit(c)\n}\n\n/// Returns true if `c` is a control character.\npub fn is_ctrl(c: u32) -> bool {\n    c < 0x20 || (0xC280..0xC2A0).contains(&c) || (0x7F..0xA0).contains(&c)\n}\n\n/// Returns true if `ch` is one of the characters in `set`. The `iso` flag is used for encoding.\npub fn is_oneof(ch: u32, set: &str, iso: i32) -> bool {\n    if ch == 0 {\n        return false;\n    }\n    let bytes = set.as_bytes();\n    let isob = iso != 0;\n    let mut s_idx = 0;\n    let (mut p_ch, ns) = skp_next_idx(bytes, s_idx, isob);\n    s_idx = ns;\n    if p_ch == b']' as u32 {\n        if ch == b']' as u32 {\n            return true;\n        } else {\n            let (np, ns2) = skp_next_idx(bytes, s_idx, isob);\n            p_ch = np;\n            s_idx = ns2;\n        }\n    }\n    while p_ch != b']' as u32 && p_ch != 0 {\n        if p_ch == ch {\n            return true;\n        }\n        let q_ch = p_ch;\n        let (np, ns2) = skp_next_idx(bytes, s_idx, isob);\n        p_ch = np;\n        s_idx = ns2;\n        // peek next byte\n        let next_byte = if s_idx < bytes.len() { bytes[s_idx] } else { 0 };\n        if p_ch == b'-' as u32 && next_byte != b']' {\n            let (np2, ns3) = skp_next_idx(bytes, s_idx, isob);\n            p_ch = np2;\n            s_idx = ns3;\n            if q_ch < ch && ch <= p_ch {\n                return true;\n            }\n            let (np3, ns4) = skp_next_idx(bytes, s_idx, isob);\n            p_ch = np3;\n            s_idx = ns4;\n        }\n    }\n    false\n}\n\n/// Checks if the string `s` starts with the pattern `p` for `len` characters, using flag `flg`.\n/// Returns the number of bytes matched in s, or 0 on no match.\npub fn is_string(s: &str, p: &str, len: i32, flg: i32) -> i32 {\n    is_string_idx(s.as_bytes(), 0, p.as_bytes(), 0, len, flg)\n}\n\nfn is_string_idx(\n    s_bytes: &[u8],\n    s_start_idx: usize,\n    p_bytes: &[u8],\n    p_start_idx: usize,\n    len: i32,\n    flg: i32,\n) -> i32 {\n    let isob = (flg & 2) != 0;\n    let fold = flg & 1;\n    let start_s = s_start_idx;\n    let mut s_idx = s_start_idx;\n    let mut p_idx = p_start_idx;\n    let mut len = len;\n    let mut mlen: i32 = 0;\n    while len > 0 {\n        // Hitting the alternation marker '\\xE' (0x0E) means a successful alternative\n        if p_idx < p_bytes.len() && p_bytes[p_idx] == 0x0E {\n            return mlen;\n        }\n        let (p_chr, p_end_idx) = skp_next_idx(p_bytes, p_idx, isob);\n        let (s_chr, s_end_idx) = skp_next_idx(s_bytes, s_idx, isob);\n        if chr_cmp(s_chr, p_chr, fold) {\n            mlen += (s_end_idx - s_idx) as i32;\n            len -= (p_end_idx - p_idx) as i32;\n            p_idx = p_end_idx;\n            s_idx = s_end_idx;\n        } else {\n            // search for an alternative '\\xE'\n            while len > 0 && p_idx < p_bytes.len() {\n                let b = p_bytes[p_idx];\n                p_idx += 1;\n                if b == 0x0E {\n                    break;\n                }\n                len -= 1;\n            }\n            len -= 1;\n            if len < 0 {\n                return 0;\n            }\n            s_idx = start_s;\n            mlen = 0;\n        }\n    }\n    mlen\n}\n\n/// Given an opening parenthesis code point, returns the corresponding closing code point.\npub fn get_close(open: u32) -> u32 {\n    match open as u8 as char {\n        '(' => ')' as u32,\n        '[' => ']' as u32,\n        '{' => '}' as u32,\n        '<' => '>' as u32,\n        _ => 0,\n    }\n}\n\n/// Given a quote character, returns the corresponding closing quote.\npub fn get_qclose(open: u32) -> u32 {\n    match open as u8 as char {\n        '\\'' | '\"' | '`' => open,\n        _ => 0,\n    }\n}\n\n/// Constants for match results.\npub const MATCHED_FAIL: i32 = 0;\npub const MATCHED: i32 = 1;\npub const MATCHED_GOAL: i32 = 2;\npub const MATCHED_GOALNOT: i32 = 3;\n\n/// Internal byte-index based match function.\n/// Returns (match_result, src_end_idx, pat_end_idx).\nfn match_idx(\n    p_bytes: &[u8],\n    p_start_idx: usize,\n    s_bytes: &[u8],\n    s_start_idx: usize,\n    flg: &mut i32,\n) -> (i32, usize, usize) {\n    let mut p_idx = p_start_idx;\n    let mut s_end_idx = s_start_idx;\n    let isob = (*flg & 2) != 0;\n    let (mut s_chr, mut s_tmp_idx) = skp_next_idx(s_bytes, s_end_idx, isob);\n\n    let mut match_min: u32 = 1;\n    let mut match_max: u32 = 1;\n    let mut match_not: u32 = 0;\n    let mut match_cnt: u32;\n    let mut intnumber = false;\n    let mut ret: i32 = MATCHED_FAIL;\n\n    if p_idx < p_bytes.len() {\n        match p_bytes[p_idx] {\n            b'*' => {\n                match_min = 0;\n                match_max = u32::MAX;\n                p_idx += 1;\n            }\n            b'+' => {\n                match_max = u32::MAX;\n                p_idx += 1;\n            }\n            b'?' => {\n                match_min = 0;\n                p_idx += 1;\n            }\n            _ => {}\n        }\n    }\n\n    if p_idx < p_bytes.len() && p_bytes[p_idx] == b'!' {\n        match_not = 1;\n        p_idx += 1;\n    }\n\n    if p_idx >= p_bytes.len() {\n        return (MATCHED_FAIL, s_start_idx, p_start_idx);\n    }\n\n    let opcode = p_bytes[p_idx];\n    p_idx += 1;\n\n    // Helper closure to repeat matching using skp_next-based advancement\n    macro_rules! do_w {\n        ($pred:expr) => {{\n            let mut cnt: u32 = 0;\n            while cnt < match_max && (s_chr != 0 && (($pred) != (match_not != 0))) {\n                s_end_idx = s_tmp_idx;\n                let (nc, nt) = skp_next_idx(s_bytes, s_end_idx, isob);\n                s_chr = nc;\n                s_tmp_idx = nt;\n                cnt += 1;\n            }\n            match_cnt = cnt;\n            ret = if match_cnt >= match_min { MATCHED } else { MATCHED_FAIL };\n        }};\n    }\n\n    // Helper to advance one byte (mirrors get_next_s_chr in C)\n    macro_rules! get_next_s_chr_byte {\n        () => {\n            s_end_idx = s_tmp_idx;\n            s_chr = if s_end_idx < s_bytes.len() {\n                s_bytes[s_end_idx] as u32\n            } else {\n                0\n            };\n            s_tmp_idx = s_end_idx + 1;\n        };\n    }\n\n    match opcode {\n        b'.' => {\n            if match_not != 0 {\n                ret = if s_chr == 0 { MATCHED } else { MATCHED_FAIL };\n            } else {\n                do_w!(s_chr != 0);\n            }\n        }\n        b'$' | b'n' => {\n            // For '$': if s_chr == 0, ret = 1, else fall through to 'n' handling\n            // We replicate the fallthrough: for '$' if not zero, treat as 'n'\n            if opcode == b'$' && s_chr == 0 {\n                ret = MATCHED;\n            } else {\n                do_w!(is_break(s_chr));\n            }\n        }\n        b'd' => {\n            do_w!(is_digit(s_chr));\n        }\n        b'x' => {\n            do_w!(is_xdigit(s_chr));\n        }\n        b'a' => {\n            do_w!(is_alpha(s_chr));\n        }\n        b'u' => {\n            do_w!(is_upper(s_chr));\n        }\n        b'l' => {\n            do_w!(is_lower(s_chr));\n        }\n        b's' => {\n            do_w!(is_space(s_chr));\n        }\n        b'w' => {\n            do_w!(is_blank(s_chr));\n        }\n        b'c' => {\n            do_w!(is_ctrl(s_chr));\n        }\n        b'i' => {\n            do_w!(is_idchr(s_chr));\n        }\n        b'@' => {\n            do_w!(is_alnum(s_chr));\n        }\n        b'&' => {\n            ret = if match_not != 0 {\n                MATCHED_GOALNOT\n            } else {\n                MATCHED_GOAL\n            };\n        }\n        b'[' => {\n            // Use a string-based slice into pat for is_oneof.\n            // We can't construct &str from bytes directly without UTF-8 check, so\n            // use a helper that operates on bytes.\n            do_w!(is_oneof_bytes(s_chr, p_bytes, p_idx, isob));\n            // advance past the set\n            if p_idx < p_bytes.len() && p_bytes[p_idx] == b']' {\n                p_idx += 1;\n            }\n            while p_idx < p_bytes.len() && p_bytes[p_idx] != 0 && p_bytes[p_idx] != b']' {\n                p_idx += 1;\n            }\n            if p_idx < p_bytes.len() {\n                p_idx += 1;\n            }\n        }\n        b'\"' | b'\\'' | b'`' => {\n            let quote = opcode;\n            let mut l: i32 = 0;\n            while p_idx + (l as usize) < p_bytes.len() && p_bytes[p_idx + l as usize] != 0 {\n                if p_bytes[p_idx + l as usize] == quote {\n                    break;\n                }\n                l += 1;\n            }\n            if l > 0 {\n                let ml = is_string_idx(s_bytes, s_end_idx, p_bytes, p_idx, l, *flg);\n                if ml > 0 {\n                    if match_not == 0 {\n                        s_end_idx += ml as usize;\n                        ret = MATCHED;\n                    }\n                    // If match_not != 0 and matched, leave ret = FAIL (handled later)\n                } else if match_min == 0 || match_not != 0 {\n                    ret = MATCHED;\n                }\n            } else if match_min == 0 || match_not != 0 {\n                ret = MATCHED;\n            }\n            // skip past the closing quote\n            p_idx += l as usize + 1;\n        }\n        b'C' => {\n            *flg = (*flg & !1) | (match_not as i32);\n            ret = MATCHED;\n        }\n        b'U' => {\n            *flg = (*flg & !2) | ((match_not as i32) * 2);\n            ret = MATCHED;\n        }\n        b'S' => {\n            while is_space(s_chr) {\n                get_next_s_chr_byte!();\n            }\n            ret = MATCHED;\n        }\n        b'W' => {\n            while is_blank(s_chr) {\n                get_next_s_chr_byte!();\n            }\n            ret = MATCHED;\n        }\n        b'N' => {\n            while s_chr != 0 && !is_break(s_chr) {\n                get_next_s_chr_byte!();\n            }\n            if s_chr != 0 {\n                get_next_s_chr_byte!();\n            }\n            ret = MATCHED;\n        }\n        b'I' => {\n            if is_alpha(s_chr) || s_chr == b'_' as u32 {\n                loop {\n                    get_next_s_chr_byte!();\n                    if !(is_alnum(s_chr) || s_chr == b'_' as u32) {\n                        break;\n                    }\n                }\n                ret = MATCHED;\n            }\n        }\n        b'(' => {\n            // ( ) means balanced parenthesis only with '()'\n            if p_idx < p_bytes.len() && p_bytes[p_idx] == b')' && s_chr == b'(' as u32 {\n                p_idx += 1;\n                // fall through to balanced handling\n                let open = s_chr;\n                let close = get_close(open);\n                if close != 0 {\n                    let mut count: i32 = 1;\n                    while s_chr != 0 && count > 0 {\n                        get_next_s_chr_byte!();\n                        if s_chr == open {\n                            count += 1;\n                        }\n                        if s_chr == close {\n                            count -= 1;\n                        }\n                    }\n                    if count == 0 {\n                        get_next_s_chr_byte!();\n                        ret = MATCHED;\n                    }\n                }\n            }\n        }\n        b'B' => {\n            let open = s_chr;\n            let close = get_close(open);\n            if close != 0 {\n                let mut count: i32 = 1;\n                while s_chr != 0 && count > 0 {\n                    get_next_s_chr_byte!();\n                    if s_chr == open {\n                        count += 1;\n                    }\n                    if s_chr == close {\n                        count -= 1;\n                    }\n                }\n                if count == 0 {\n                    get_next_s_chr_byte!();\n                    ret = MATCHED;\n                }\n            }\n        }\n        b'Q' => {\n            let qclose = get_qclose(s_chr);\n            if qclose != 0 {\n                while s_chr != 0 {\n                    get_next_s_chr_byte!();\n                    if s_chr == qclose {\n                        break;\n                    }\n                    if s_chr == b'\\\\' as u32 {\n                        get_next_s_chr_byte!();\n                    }\n                }\n                if s_chr != 0 {\n                    get_next_s_chr_byte!();\n                    ret = MATCHED;\n                }\n            }\n        }\n        b'X' => {\n            // hex number\n            if s_chr == b'0' as u32\n                && s_end_idx + 2 < s_bytes.len()\n                && (s_bytes[s_end_idx + 1] == b'x' || s_bytes[s_end_idx + 1] == b'X')\n                && is_xdigit(s_bytes[s_end_idx + 2] as u32)\n            {\n                get_next_s_chr_byte!();\n                get_next_s_chr_byte!();\n                get_next_s_chr_byte!();\n                ret = MATCHED;\n            }\n            while is_xdigit(s_chr) {\n                ret = MATCHED;\n                get_next_s_chr_byte!();\n            }\n        }\n        b'D' => {\n            intnumber = true;\n            // fall through to F handling\n            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n                loop {\n                    get_next_s_chr_byte!();\n                    if !is_space(s_chr) {\n                        break;\n                    }\n                }\n            }\n            while is_digit(s_chr) {\n                ret = MATCHED;\n                get_next_s_chr_byte!();\n            }\n            if !intnumber {\n                if s_chr == b'.' as u32 {\n                    get_next_s_chr_byte!();\n                }\n                while is_digit(s_chr) {\n                    ret = MATCHED;\n                    get_next_s_chr_byte!();\n                }\n                if ret == MATCHED && (s_chr == b'E' as u32 || s_chr == b'e' as u32) {\n                    get_next_s_chr_byte!();\n                    if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n                        get_next_s_chr_byte!();\n                    }\n                    while is_digit(s_chr) {\n                        get_next_s_chr_byte!();\n                    }\n                    if s_chr == b'.' as u32 {\n                        get_next_s_chr_byte!();\n                    }\n                    while is_digit(s_chr) {\n                        get_next_s_chr_byte!();\n                    }\n                }\n            }\n        }\n        b'F' => {\n            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n                loop {\n                    get_next_s_chr_byte!();\n                    if !is_space(s_chr) {\n                        break;\n                    }\n                }\n            }\n            while is_digit(s_chr) {\n                ret = MATCHED;\n                get_next_s_chr_byte!();\n            }\n            if s_chr == b'.' as u32 {\n                get_next_s_chr_byte!();\n            }\n            while is_digit(s_chr) {\n                ret = MATCHED;\n                get_next_s_chr_byte!();\n            }\n            if ret == MATCHED && (s_chr == b'E' as u32 || s_chr == b'e' as u32) {\n                get_next_s_chr_byte!();\n                if s_chr == b'+' as u32 || s_chr == b'-' as u32 {\n                    get_next_s_chr_byte!();\n                }\n                while is_digit(s_chr) {\n                    get_next_s_chr_byte!();\n                }\n                if s_chr == b'.' as u32 {\n                    get_next_s_chr_byte!();\n                }\n                while is_digit(s_chr) {\n                    get_next_s_chr_byte!();\n                }\n            }\n        }\n        _ => {\n            ret = MATCHED_FAIL;\n            p_idx -= 1;\n        }\n    }\n\n    let _ = match_cnt; // suppress warning if unused\n\n    if ret != MATCHED_FAIL {\n        (ret, s_end_idx, p_idx)\n    } else {\n        (MATCHED_FAIL, s_start_idx, p_start_idx)\n    }\n}\n\nfn is_oneof_bytes(ch: u32, set_bytes: &[u8], set_start_idx: usize, isob: bool) -> bool {\n    if ch == 0 {\n        return false;\n    }\n    let mut s_idx = set_start_idx;\n    let (mut p_ch, ns) = skp_next_idx(set_bytes, s_idx, isob);\n    s_idx = ns;\n    if p_ch == b']' as u32 {\n        if ch == b']' as u32 {\n            return true;\n        } else {\n            let (np, ns2) = skp_next_idx(set_bytes, s_idx, isob);\n            p_ch = np;\n            s_idx = ns2;\n        }\n    }\n    while p_ch != b']' as u32 && p_ch != 0 {\n        if p_ch == ch {\n            return true;\n        }\n        let q_ch = p_ch;\n        let (np, ns2) = skp_next_idx(set_bytes, s_idx, isob);\n        p_ch = np;\n        s_idx = ns2;\n        let next_byte = if s_idx < set_bytes.len() {\n            set_bytes[s_idx]\n        } else {\n            0\n        };\n        if p_ch == b'-' as u32 && next_byte != b']' {\n            let (np2, ns3) = skp_next_idx(set_bytes, s_idx, isob);\n            p_ch = np2;\n            s_idx = ns3;\n            if q_ch < ch && ch <= p_ch {\n                return true;\n            }\n            let (np3, ns4) = skp_next_idx(set_bytes, s_idx, isob);\n            p_ch = np3;\n            s_idx = ns4;\n        }\n    }\n    false\n}\n\n/// Matches the pattern `pat` against source `src` and returns a tuple:\n/// `(match_result, src_end, pat_end)`. The flag parameter is passed by mutable reference.\npub fn match_pat<'a>(pat: &'a str, src: &'a str, flg: &mut i32) -> (i32, &'a str, &'a str) {\n    let p_bytes = pat.as_bytes();\n    let s_bytes = src.as_bytes();\n    let (ret, s_end, p_end) = match_idx(p_bytes, 0, s_bytes, 0, flg);\n    let s_end = s_end.min(s_bytes.len());\n    let p_end = p_end.min(p_bytes.len());\n    let src_out = if src.is_char_boundary(s_end) {\n        &src[s_end..]\n    } else {\n        src\n    };\n    let pat_out = if pat.is_char_boundary(p_end) {\n        &pat[p_end..]\n    } else {\n        pat\n    };\n    (ret, src_out, pat_out)\n}\n\n/// Internal byte-based skp_ implementation.\n/// Returns (alt, to_byte_idx, end_byte_idx)\nfn skp_inner_idx(src: &str, pat: &str) -> (i32, usize, usize) {\n    if pat.is_empty() {\n        return (0, 0, 0);\n    }\n    let p_bytes = pat.as_bytes();\n    let s_bytes = src.as_bytes();\n    let mut p_pat_start_idx = 0usize;\n    let mut skp_to = false;\n    if p_pat_start_idx < p_bytes.len() && p_bytes[p_pat_start_idx] == b'>' {\n        skp_to = true;\n        p_pat_start_idx += 1;\n    }\n\n    let mut start_idx: usize = 0;\n    let mut s_idx: usize = start_idx;\n    let mut p_idx = p_pat_start_idx;\n\n    let mut matched: i32 = 0;\n    let mut goal: Option<usize> = None;\n    let mut goalnot: Option<usize> = None;\n    let mut flg: i32 = 0;\n\n    // Skip leading spaces\n    while p_idx < p_bytes.len() && is_space(p_bytes[p_idx] as u32) {\n        p_idx += 1;\n    }\n\n    while p_idx < p_bytes.len() && p_bytes[p_idx] > 0x07 {\n        let (m, s_end_idx, p_end_idx) = match_idx(p_bytes, p_idx, s_bytes, s_idx, &mut flg);\n        matched = m;\n        if matched != 0 {\n            s_idx = s_end_idx;\n            p_idx = p_end_idx;\n            if matched == MATCHED_GOAL && goalnot.is_none() {\n                goal = Some(s_idx);\n            } else if matched == MATCHED_GOALNOT {\n                goalnot = Some(s_idx);\n            }\n        } else {\n            // Skip rest of current alternative\n            while p_idx < p_bytes.len() && p_bytes[p_idx] > 0x07 {\n                p_idx += 1;\n            }\n            // Try alternative pattern: separator > 0 and next byte > 0\n            if p_idx < p_bytes.len()\n                && p_bytes[p_idx] > 0\n                && p_idx + 1 < p_bytes.len()\n                && p_bytes[p_idx + 1] > 0\n            {\n                s_idx = start_idx;\n                p_idx += 1;\n            } else if skp_to {\n                goal = None;\n                goalnot = None;\n                p_idx = p_pat_start_idx;\n                start_idx += 1;\n                s_idx = start_idx;\n                if start_idx >= s_bytes.len() || s_bytes[start_idx] == 0 {\n                    break;\n                }\n            } else {\n                break;\n            }\n        }\n        // Skip spaces in pattern\n        while p_idx < p_bytes.len() && is_space(p_bytes[p_idx] as u32) {\n            p_idx += 1;\n        }\n    }\n\n    if matched == 0 && goalnot.is_some() {\n        goal = goalnot;\n        matched = MATCHED;\n        // Force end-of-pattern condition\n        p_idx = p_bytes.len();\n    }\n\n    if let Some(g) = goal {\n        s_idx = g;\n    }\n\n    let at_end = p_idx >= p_bytes.len() || p_bytes[p_idx] <= 0x07;\n    if matched != 0 && at_end {\n        let ret_val = if p_idx < p_bytes.len() && p_bytes[p_idx] > 0 {\n            p_bytes[p_idx] as i32\n        } else {\n            1\n        };\n        let to_idx = if skp_to { start_idx } else { s_idx };\n        let end_idx = s_idx;\n        return (ret_val, to_idx, end_idx);\n    }\n\n    (0, 0, 0)\n}\n\n/// The core scanning function from the C header.\npub fn skp_<'a>(src: &'a str, pat: &'a str) -> (i32, &'a str, &'a str) {\n    if pat.is_empty() || src.is_empty() && pat.is_empty() {\n        // No pattern -> failure\n    }\n    if src.is_empty() && pat.is_empty() {\n        return (0, src, src);\n    }\n    // Check null-equivalent: in C, null pat or null src returns 0\n    let (alt, to_idx, end_idx) = skp_inner_idx(src, pat);\n    if alt > 0 {\n        let s_bytes = src.as_bytes();\n        let to_idx = to_idx.min(s_bytes.len());\n        let end_idx = end_idx.min(s_bytes.len());\n        let to_str = if src.is_char_boundary(to_idx) {\n            &src[to_idx..]\n        } else {\n            src\n        };\n        let end_str = if src.is_char_boundary(end_idx) {\n            &src[end_idx..]\n        } else {\n            src\n        };\n        (alt, to_str, end_str)\n    } else {\n        (0, src, src)\n    }\n}\n\n/// Variant: skp_4(src, pat, to, end).\npub fn skp_4(src: &str, pat: &str, to: Option<&mut &str>, end: Option<&mut &str>) -> i32 {\n    let (alt, to_idx, end_idx) = skp_inner_idx(src, pat);\n    if alt > 0 {\n        let s_bytes = src.as_bytes();\n        let to_i = to_idx.min(s_bytes.len());\n        let end_i = end_idx.min(s_bytes.len());\n        let to_str: &str = if src.is_char_boundary(to_i) {\n            &src[to_i..]\n        } else {\n            src\n        };\n        let end_str: &str = if src.is_char_boundary(end_i) {\n            &src[end_i..]\n        } else {\n            src\n        };\n        // SAFETY: we assign references derived from `src` to slots that may\n        // have been declared with a different lifetime.  Callers are expected\n        // to ensure the supplied references outlive `src`.  This mirrors the\n        // C API that simply writes through the pointer.\n        if let Some(t) = to {\n            unsafe {\n                *t = std::mem::transmute::<&str, &str>(to_str);\n            }\n        }\n        if let Some(e) = end {\n            unsafe {\n                *e = std::mem::transmute::<&str, &str>(end_str);\n            }\n        }\n        alt\n    } else {\n        if let Some(t) = to {\n            unsafe {\n                *t = std::mem::transmute::<&str, &str>(src);\n            }\n        }\n        if let Some(e) = end {\n            unsafe {\n                *e = std::mem::transmute::<&str, &str>(src);\n            }\n        }\n        0\n    }\n}\n\n/// Variant: skp_3(src, pat, end). Note: maps to C's `to` slot (3rd arg).\npub fn skp_3(src: &str, pat: &str, end: Option<&mut &str>) -> i32 {\n    let (alt, to_idx, _end_idx) = skp_inner_idx(src, pat);\n    if alt > 0 {\n        let s_bytes = src.as_bytes();\n        let to_i = to_idx.min(s_bytes.len());\n        let to_str: &str = if src.is_char_boundary(to_i) {\n            &src[to_i..]\n        } else {\n            src\n        };\n        if let Some(e) = end {\n            unsafe {\n                *e = std::mem::transmute::<&str, &str>(to_str);\n            }\n        }\n        alt\n    } else {\n        if let Some(e) = end {\n            unsafe {\n                *e = std::mem::transmute::<&str, &str>(src);\n            }\n        }\n        0\n    }\n}\n\n/// Variant: skp_2(src, pat).\npub fn skp_2(src: &str, pat: &str) -> i32 {\n    skp_inner_idx(src, pat).0\n}\n\n// ==================================================================\n// AST functions\n// ==================================================================\n\nconst ASTNULL: i32 = -1;\nconst SKP_DEBUG: i8 = 0x01;\n#[allow(dead_code)]\nconst SKP_LEFTRECUR: i8 = 0x02;\n\n/// In C: `typedef int32_t astnode_t;`\npub type AstNodeT = i32;\n\n/// Representation of an AST node.\n#[derive(Debug, Default, Clone)]\npub struct AstNode {\n    pub rule: String,\n    pub from: AstNodeT,\n    pub to: AstNodeT,\n    pub delta: i32, // delta between open and close parenthesis (>0)\n    pub tag: i32,\n}\n\n/// AST memoization structure\n#[derive(Debug, Default)]\npub struct AstMmz {\n    pub pos: i32,\n    pub endpos: i32,\n    pub numnodes: i32,\n    pub maxnodes: i32,\n    pub lastinfo: i32,\n    pub nodes: Vec<AstNode>,\n}\n\n/// In C: `typedef struct ast_s *ast_t;`\n#[derive(Debug, Default)]\npub struct Ast {\n    pub start: String,\n    pub err_rule: Option<String>,\n    pub err_msg: Option<String>,\n    pub cur_rule: Option<String>,\n    pub nodes: Vec<AstNode>,\n    pub mmz: Vec<AstMmz>,\n    pub par: Vec<i32>,\n    pub auxptr: Option<Box<dyn std::any::Any>>,\n    pub nodes_cnt: i32,\n    pub nodes_max: i32,\n    pub par_cnt: i32,\n    pub par_max: i32,\n    pub mmz_cnt: i32,\n    pub mmz_max: i32,\n    pub pos: i32,\n    pub lastpos: i32,\n    pub err_pos: i32,\n    pub cur_node: i32,\n    pub lastinfo: i32,\n    pub ret: i32,\n    pub depth: u16,\n    pub fail: i8,\n    pub flg: i8,\n}\n\npub type SkpRule = fn(ast: &mut Ast, ret: &mut i32);\n\n/// Creates a new AST.\npub fn ast_new() -> Option<Ast> {\n    Some(Ast {\n        start: String::new(),\n        err_rule: None,\n        err_msg: Some(String::new()),\n        cur_rule: None,\n        nodes: Vec::with_capacity(8),\n        mmz: Vec::new(),\n        par: Vec::with_capacity(16),\n        auxptr: None,\n        nodes_cnt: 0,\n        nodes_max: 8,\n        par_cnt: 0,\n        par_max: 16,\n        mmz_cnt: 0,\n        mmz_max: 64,\n        pos: 0,\n        lastpos: 0,\n        err_pos: -1,\n        cur_node: ASTNULL,\n        lastinfo: 0,\n        ret: 0,\n        depth: 0,\n        fail: 0,\n        flg: 0,\n    })\n}\n\n/// Frees an AST.\npub fn astfree(_ast: Ast) -> Option<Ast> {\n    None\n}\n\n/// Parses the source string `src` using a given parsing rule.\npub fn skp_parse(src: &str, rule: SkpRule, rulename: &str, debug: i32) -> Option<Ast> {\n    let mut ast = ast_new()?;\n    ast.start = src.to_string();\n    ast.flg = if debug != 0 { SKP_DEBUG } else { 0 };\n\n    let pos0 = ast.pos;\n    let open = ast_open(&mut ast, pos0, rulename);\n    if open >= 0 {\n        let mut ret = ast.ret;\n        rule(&mut ast, &mut ret);\n        ast.ret = ret;\n\n        if ast.fail != 0 && ast.err_pos < ast.pos {\n            ast.err_pos = ast.pos;\n            ast.err_rule = Some(rulename.to_string());\n        }\n\n        let pos = ast.pos;\n        ast_close(&mut ast, pos, open);\n        if ast.nodes_cnt > 0 {\n            ast.err_pos = -1;\n            let info = ast.lastinfo;\n            ast_setinfo(&mut ast, info, 0);\n        }\n    }\n    // mmz cleanup not strictly needed as Vec drops naturally\n    ast.mmz.clear();\n    ast.mmz_cnt = 0;\n    Some(ast)\n}\n\n/// Debug function for AST.\npub fn skp_debug2(ast: &mut Ast, d: u8) -> i32 {\n    match d {\n        0 => ast.flg &= !SKP_DEBUG,\n        1 => ast.flg |= SKP_DEBUG,\n        _ => ast.flg ^= SKP_DEBUG,\n    }\n    (ast.flg & SKP_DEBUG) as i32\n}\n\nfn skp_par_makeroom(ast: &mut Ast, needed: i32) -> bool {\n    if ast.par_cnt + needed > ast.par_max {\n        let mut new_max = ast.par_max;\n        loop {\n            new_max += new_max / 2;\n            new_max += new_max & 1;\n            if ast.par_cnt + needed <= new_max {\n                break;\n            }\n        }\n        ast.par.resize(new_max as usize, 0);\n        ast.par_max = new_max;\n    } else {\n        // ensure underlying Vec has the capacity to be indexed\n        if (ast.par.len() as i32) < ast.par_cnt + needed {\n            ast.par.resize((ast.par_cnt + needed) as usize, 0);\n        }\n    }\n    true\n}\n\nfn skp_nodes_makeroom(ast: &mut Ast, needed: i32) -> bool {\n    if ast.nodes_cnt + needed > ast.nodes_max {\n        let mut new_max = ast.nodes_max;\n        loop {\n            new_max += new_max / 2;\n            new_max += new_max & 1;\n            if ast.nodes_cnt + needed <= new_max {\n                break;\n            }\n        }\n        ast.nodes\n            .resize(new_max as usize, AstNode::default());\n        ast.nodes_max = new_max;\n    } else if (ast.nodes.len() as i32) < ast.nodes_cnt + needed {\n        ast.nodes\n            .resize((ast.nodes_cnt + needed) as usize, AstNode::default());\n    }\n    true\n}\n\nfn ast_newpar(ast: &mut Ast) -> i32 {\n    if !skp_par_makeroom(ast, 1) {\n        return -1;\n    }\n    let p = ast.par_cnt;\n    ast.par_cnt += 1;\n    if (ast.par.len() as i32) <= p {\n        ast.par.resize((p + 1) as usize, 0);\n    }\n    p\n}\n\nfn ast_newnode(ast: &mut Ast) -> i32 {\n    if !skp_nodes_makeroom(ast, 1) {\n        return -1;\n    }\n    let n = ast.nodes_cnt;\n    ast.nodes_cnt += 1;\n    if (ast.nodes.len() as i32) <= n {\n        ast.nodes.resize((n + 1) as usize, AstNode::default());\n    }\n    n\n}\n\n/// Opens a new AST node starting at position `from` with the given rule.\npub fn ast_open(ast: &mut Ast, from: i32, rule: &str) -> i32 {\n    if ast.fail != 0 {\n        return -1;\n    }\n    let par = ast_newpar(ast);\n    if par < 0 {\n        return -1;\n    }\n    let node = ast_newnode(ast);\n    if node < 0 {\n        return -1;\n    }\n    ast.par[par as usize] = node;\n    ast.nodes[node as usize] = AstNode {\n        rule: rule.to_string(),\n        from,\n        to: 0,\n        delta: 0,\n        tag: 0,\n    };\n    par\n}\n\n/// Closes the current AST node at position `to`, linking with the open node `open`.\npub fn ast_close(ast: &mut Ast, to: i32, open: i32) -> i32 {\n    if open < 0 {\n        return -1;\n    }\n    let node_idx = ast.par[open as usize];\n    if ast.fail != 0 {\n        let from = ast.nodes[node_idx as usize].from;\n        ast.pos = from;\n        ast.nodes_cnt = node_idx;\n        ast.par_cnt = open;\n        return -1;\n    }\n    let par = ast_newpar(ast);\n    if par < 0 {\n        return -1;\n    }\n    let delta = par - open;\n    {\n        let nd = &mut ast.nodes[node_idx as usize];\n        nd.to = to;\n        nd.delta = delta;\n        nd.tag = 0;\n    }\n    ast.par[par as usize] = -delta;\n\n    let rule = ast.nodes[node_idx as usize].rule.clone();\n    ast.cur_node = par;\n    ast.cur_rule = Some(rule);\n    par\n}\n\n/// Aborts parsing with the given message and rule.\npub fn skp__abort(ast: &mut Ast, msg: &str, rule: &str) {\n    if !msg.is_empty() {\n        ast.err_msg = Some(msg.to_string());\n    }\n    ast.err_pos = ast.pos;\n    ast.err_rule = Some(rule.to_string());\n    ast.fail = 1;\n    // Note: Rust does not use setjmp/longjmp.  Set the failure flag so the\n    // caller observes the abort condition.\n}\n\n/// Records memoization of AST nodes (for left recursion etc.).\npub fn skp_memoize(ast: &mut Ast, mmz: &mut AstMmz, _rule: &str, old_pos: i32, start_par: i32) {\n    let end_par = ast.par_cnt;\n    let (start_par, end_par) = if ast.fail != 0 || end_par <= start_par {\n        (-1i32, -1i32)\n    } else {\n        (start_par, end_par)\n    };\n    let numnodes = if start_par < 0 || end_par < 0 {\n        0\n    } else {\n        (end_par - start_par) / 2\n    };\n\n    mmz.pos = old_pos;\n    mmz.endpos = ast.pos;\n    mmz.numnodes = if ast.fail != 0 { -1 } else { numnodes };\n    mmz.maxnodes = numnodes;\n    mmz.lastinfo = ast.lastinfo;\n\n    mmz.nodes.clear();\n    if start_par >= 0 && end_par >= 0 {\n        for k in start_par..end_par {\n            let p = ast.par[k as usize];\n            if p >= 0 {\n                mmz.nodes.push(ast.nodes[p as usize].clone());\n            }\n        }\n    }\n}\n\n/// Attempts to retrieve a memoized result.\npub fn skp_dememoize(ast: &mut Ast, mmz: &mut AstMmz, _rule: &str) -> i32 {\n    if mmz.pos != ast.pos {\n        return 0;\n    }\n    let numnodes = mmz.numnodes;\n    ast.fail = if numnodes < 0 { 1 } else { 0 };\n    ast.lastpos = ast.pos;\n    ast.pos = mmz.endpos;\n    ast.lastinfo = mmz.lastinfo;\n    if numnodes > 0 {\n        skp_nodes_makeroom(ast, numnodes);\n        skp_par_makeroom(ast, 2 * numnodes);\n        let start_par = ast.par_cnt;\n        let total_par = (2 * numnodes) as usize;\n        for i in 0..total_par {\n            let idx = start_par as usize + i;\n            if ast.par.len() <= idx {\n                ast.par.resize(idx + 1, i32::MAX);\n            } else {\n                ast.par[idx] = i32::MAX;\n            }\n        }\n        let mut cur_par = start_par;\n        for k in 0..numnodes {\n            let n = ast.nodes_cnt;\n            if (ast.nodes.len() as i32) <= n {\n                ast.nodes.resize((n + 1) as usize, AstNode::default());\n            }\n            ast.nodes[n as usize] = mmz.nodes[k as usize].clone();\n            while cur_par < ast.par_max && ast.par[cur_par as usize] != i32::MAX {\n                cur_par += 1;\n            }\n            if cur_par >= ast.par_max {\n                break;\n            }\n            ast.par[cur_par as usize] = n;\n            let delta = mmz.nodes[k as usize].delta;\n            let close_idx = (cur_par + delta) as usize;\n            if close_idx < ast.par.len() {\n                ast.par[close_idx] = -delta;\n            }\n            ast.nodes_cnt += 1;\n        }\n        ast.par_cnt += 2 * numnodes;\n    }\n    1\n}\n\n/// Sets AST node information (tag).\npub fn ast_setinfo(ast: &mut Ast, info: i32, node: AstNodeT) {\n    if ast.par_cnt <= node {\n        return;\n    }\n    let mut node = node;\n    if node == ASTNULL {\n        node = ast.par_cnt - 1;\n    }\n    if node < 0 || node >= ast.par_cnt {\n        return;\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return;\n    }\n    let pn = ast.par[idx as usize];\n    if pn >= 0 && (pn as usize) < ast.nodes.len() {\n        ast.nodes[pn as usize].tag = info;\n    }\n}\n\n/// Records a new AST info node.\npub fn astnewinfo(ast: &mut Ast, info: i32) {\n    if ast.fail != 0 {\n        return;\n    }\n    let pos = ast.pos;\n    let par = ast_open(ast, pos, \"#\");\n    ast_close(ast, pos, par);\n    if par >= 0 && (par as usize) < ast.par.len() {\n        let pn = ast.par[par as usize];\n        if pn >= 0 && (pn as usize) < ast.nodes.len() {\n            ast.nodes[pn as usize].tag = info;\n        }\n    }\n    ast.lastinfo = info;\n}\n\n/// Retrieves the information associated with a node.\npub fn astnodeinfo(ast: &Ast, node: AstNodeT) -> i32 {\n    if node < 0 || node >= ast.par_cnt {\n        return 0;\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return 0;\n    }\n    let pn = ast.par[idx as usize];\n    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n        return 0;\n    }\n    ast.nodes[pn as usize].tag\n}\n\n/// Swaps the last two AST nodes.\npub fn ast_swap(ast: &mut Ast) {\n    if ast.fail != 0 || ast.par_cnt < 4 {\n        return;\n    }\n    let c1 = ast.par_cnt - 1;\n    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n        return;\n    }\n    let o1 = c1 + ast.par[c1 as usize];\n    if o1 < 0 || ast.par[o1 as usize] < 0 {\n        return;\n    }\n    let c2 = o1 - 1;\n    if c2 < 0 || ast.par[c2 as usize] >= 0 {\n        return;\n    }\n    let o2 = c2 + ast.par[c2 as usize];\n    if o2 < 0 || ast.par[o2 as usize] < 0 {\n        return;\n    }\n    let len2 = (c2 - o2 + 1) as usize;\n    let len1 = (c1 - o1 + 1) as usize;\n    let tmp: Vec<i32> = ast.par[o2 as usize..(o2 as usize + len2)].to_vec();\n    // Move first block to o2\n    for i in 0..len1 {\n        ast.par[o2 as usize + i] = ast.par[o1 as usize + i];\n    }\n    // Place tmp after the moved block\n    for i in 0..len2 {\n        ast.par[o2 as usize + len1 + i] = tmp[i];\n    }\n}\n\n/// Lowers a node (wraps a group of nodes into a new parent).\npub fn ast_lower(ast: &mut Ast, rule: &str, lft: AstNodeT, rgt: AstNodeT) {\n    if ast.par_cnt <= lft || ast.par_cnt <= rgt || lft >= rgt {\n        return;\n    }\n    let mut lft = lft;\n    let mut rgt = rgt;\n    if ast.par[lft as usize] < 0 {\n        lft += ast.par[lft as usize];\n    }\n    if ast.par[rgt as usize] < 0 {\n        rgt += ast.par[rgt as usize];\n    }\n    let lft_node = ast.par[lft as usize];\n    let rgt_node = ast.par[rgt as usize];\n    let node_from = ast.nodes[lft_node as usize].from;\n    let node_to = ast.nodes[rgt_node as usize].to;\n    rgt += ast.nodes[rgt_node as usize].delta;\n\n    let new_node = ast_newnode(ast);\n    if new_node < 0 {\n        return;\n    }\n    let delta = rgt - lft + 2;\n    ast.nodes[new_node as usize] = AstNode {\n        rule: rule.to_string(),\n        from: node_from,\n        to: node_to,\n        delta,\n        tag: 0,\n    };\n    if ast_newpar(ast) < 0 {\n        return;\n    }\n    if ast_newpar(ast) < 0 {\n        return;\n    }\n\n    // Move nodes after rgt down by 2\n    if ast.par_cnt - 1 - rgt > 2 {\n        let count = (ast.par_cnt - 1 - rgt - 2) as usize;\n        for i in (0..count).rev() {\n            ast.par[(rgt + 3) as usize + i] = ast.par[(rgt + 1) as usize + i];\n        }\n    }\n    // Move block [lft..=rgt] right by 1\n    let block_len = (rgt - lft + 1) as usize;\n    for i in (0..block_len).rev() {\n        ast.par[(lft + 1) as usize + i] = ast.par[lft as usize + i];\n    }\n    ast.par[lft as usize] = new_node;\n    ast.par[(rgt + 2) as usize] = -delta;\n}\n\n/// Lifts a node (removes a level from the AST).\npub fn ast_lift(ast: &mut Ast) {\n    if ast.fail != 0 || ast.par_cnt < 4 {\n        return;\n    }\n    let c1 = ast.par_cnt - 1;\n    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n        return;\n    }\n    let c2 = c1 - 1;\n    if c2 < 0 || ast.par[c2 as usize] >= 0 {\n        return;\n    }\n    let o1 = c1 + ast.par[c1 as usize];\n    if o1 < 0 || ast.par[o1 as usize] < 0 {\n        return;\n    }\n    let o2 = c2 + ast.par[c2 as usize];\n    if o2 < 0 || ast.par[o2 as usize] < 0 {\n        return;\n    }\n    if o2 != o1 + 1 {\n        return;\n    }\n    if ast.nodes[ast.par[o1 as usize] as usize].tag == 0 {\n        let span = (c2 - o2 + 1) as usize;\n        for i in 0..span {\n            ast.par[o1 as usize + i] = ast.par[o2 as usize + i];\n        }\n        ast.par_cnt -= 2;\n    }\n}\n\n/// Lifts all single-child nodes.\npub fn ast_lift_all(ast: &mut Ast) {\n    loop {\n        let n = ast.par_cnt;\n        ast_lift(ast);\n        if n == ast.par_cnt {\n            break;\n        }\n    }\n}\n\n/// Removes the last leaf node.\npub fn ast_noleaf(ast: &mut Ast) {\n    if ast.fail != 0 || ast.par_cnt < 2 {\n        return;\n    }\n    let c1 = ast.par_cnt - 1;\n    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n        return;\n    }\n    let o1 = c1 + ast.par[c1 as usize];\n    if o1 < 0 || ast.par[o1 as usize] < 0 {\n        return;\n    }\n    if c1 == o1 + 1 {\n        ast.par_cnt -= 2;\n    }\n}\n\n/// Removes the last empty leaf node.\npub fn ast_noemptyleaf(ast: &mut Ast) {\n    if ast.fail != 0 || ast.par_cnt < 2 {\n        return;\n    }\n    let c1 = ast.par_cnt - 1;\n    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n        return;\n    }\n    let o1 = c1 + ast.par[c1 as usize];\n    if o1 < 0 || ast.par[o1 as usize] < 0 {\n        return;\n    }\n    if c1 != o1 + 1 {\n        return;\n    }\n    let pn = ast.par[o1 as usize];\n    if ast.nodes[pn as usize].from != ast.nodes[pn as usize].to {\n        return;\n    }\n    ast.par_cnt -= 2;\n}\n\n/// Returns the index of the last AST node.\npub fn ast_lastnode(ast: &Ast) -> AstNodeT {\n    if ast.fail != 0 || ast.par_cnt < 2 {\n        return ASTNULL;\n    }\n    let c1 = ast.par_cnt - 1;\n    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n        return ASTNULL;\n    }\n    let o1 = c1 + ast.par[c1 as usize];\n    if o1 < 0 || ast.par[o1 as usize] < 0 {\n        return ASTNULL;\n    }\n    o1\n}\n\n/// Checks if the last node is empty.\npub fn ast_lastnodeisempty(ast: &Ast) -> bool {\n    let node = ast_lastnode(ast);\n    if node == ASTNULL {\n        return false;\n    }\n    let pn = ast.par[node as usize];\n    if pn < 0 {\n        return false;\n    }\n    let nd = &ast.nodes[pn as usize];\n    nd.from == nd.to\n}\n\n/// Deletes the last node.\npub fn ast_delete(ast: &mut Ast) {\n    if ast.fail != 0 || ast.par_cnt < 2 {\n        return;\n    }\n    let c1 = ast.par_cnt - 1;\n    if c1 < 0 || ast.par[c1 as usize] >= 0 {\n        return;\n    }\n    let o1 = c1 + ast.par[c1 as usize];\n    if o1 < 0 || ast.par[o1 as usize] < 0 {\n        return;\n    }\n    ast.par_cnt -= c1 - o1 + 1;\n}\n\n/// Returns the “left” sibling of a node.\npub fn astleft(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    if node <= 0 || ast.par_cnt <= node {\n        return ASTNULL;\n    }\n    let mut node = node;\n    if ast.par[node as usize] < 0 {\n        node += ast.par[node as usize];\n    }\n    node -= 1;\n    if node <= 0 || ast.par[node as usize] >= 0 {\n        return ASTNULL;\n    }\n    node += ast.par[node as usize];\n    node\n}\n\n/// Returns the “right” sibling of a node.\npub fn astright(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    if node <= 0 || ast.par_cnt <= node {\n        return ASTNULL;\n    }\n    let mut node = node;\n    if ast.par[node as usize] > 0 {\n        let pn = ast.par[node as usize];\n        node += ast.nodes[pn as usize].delta;\n    }\n    node += 1;\n    if node >= ast.par_cnt || ast.par[node as usize] < 0 {\n        return ASTNULL;\n    }\n    node\n}\n\n/// Returns the parent of a node.\npub fn astup(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    let node = astfirst(ast, node);\n    if node == ASTNULL {\n        return ASTNULL;\n    }\n    let n = node - 1;\n    if n < 0 || ast.par[n as usize] < 0 {\n        return ASTNULL;\n    }\n    n\n}\n\n/// Returns the first child of a node.\npub fn astdown(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    if node < 0 || ast.par_cnt <= node {\n        return ASTNULL;\n    }\n    let n = node + 1;\n    if n >= ast.par_cnt || ast.par[n as usize] < 0 {\n        return ASTNULL;\n    }\n    n\n}\n\n/// Returns the leftmost sibling of a node.\npub fn astfirst(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    if node < 0 || ast.par_cnt <= node {\n        return ASTNULL;\n    }\n    let mut cur = node;\n    loop {\n        let n = astleft(ast, cur);\n        if n == ASTNULL {\n            break;\n        }\n        cur = n;\n    }\n    cur\n}\n\n/// Returns the rightmost sibling of a node.\npub fn astlast(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    if node < 0 || ast.par_cnt <= node {\n        return ASTNULL;\n    }\n    let mut cur = node;\n    loop {\n        let n = astright(ast, cur);\n        if n == ASTNULL {\n            break;\n        }\n        cur = n;\n    }\n    cur\n}\n\n/// Returns the next node in a depth-first traversal.\npub fn astnextdf(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    let n = node + 1;\n    if n < 0 {\n        return 0;\n    }\n    if n >= ast.par_cnt {\n        return ASTNULL;\n    }\n    n\n}\n\n/// Checks if the given index is an entry (open parenthesis) node.\npub fn astisnodeentry(ast: &Ast, node: AstNodeT) -> bool {\n    node < ast.par_cnt && node >= 0 && ast.par[node as usize] >= 0\n}\n\n/// Checks if the given index is an exit (closing parenthesis) node.\npub fn astisnodeexit(ast: &Ast, node: AstNodeT) -> bool {\n    node < ast.par_cnt && node >= 0 && ast.par[node as usize] < 0\n}\n\n/// Returns the rule name associated with a node.\npub fn astnoderule(ast: &Ast, node: AstNodeT) -> &str {\n    if node < 0 || node >= ast.par_cnt {\n        return \"\";\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return \"\";\n    }\n    let pn = ast.par[idx as usize];\n    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n        return \"\";\n    }\n    &ast.nodes[pn as usize].rule\n}\n\n/// Returns the source substring from the start of the node.\npub fn astnodefrom(ast: &Ast, node: AstNodeT) -> &str {\n    if node < 0 || node >= ast.par_cnt {\n        return \"\";\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return \"\";\n    }\n    let pn = ast.par[idx as usize];\n    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n        return \"\";\n    }\n    let from = ast.nodes[pn as usize].from as usize;\n    let bytes = ast.start.as_bytes();\n    let f = from.min(bytes.len());\n    if ast.start.is_char_boundary(f) {\n        &ast.start[f..]\n    } else {\n        \"\"\n    }\n}\n\n/// Returns the source substring up to the end of the node.\npub fn astnodeto(ast: &Ast, node: AstNodeT) -> &str {\n    if node < 0 || node >= ast.par_cnt {\n        return \"\";\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return \"\";\n    }\n    let pn = ast.par[idx as usize];\n    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n        return \"\";\n    }\n    let to = ast.nodes[pn as usize].to as usize;\n    let bytes = ast.start.as_bytes();\n    let t = to.min(bytes.len());\n    if ast.start.is_char_boundary(t) {\n        &ast.start[t..]\n    } else {\n        \"\"\n    }\n}\n\n/// Returns the length of the node.\npub fn astnodelen(ast: &Ast, node: AstNodeT) -> i32 {\n    if node < 0 || node >= ast.par_cnt {\n        return 0;\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return 0;\n    }\n    let pn = ast.par[idx as usize];\n    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n        return 0;\n    }\n    ast.nodes[pn as usize].to - ast.nodes[pn as usize].from\n}\n\n/// Checks if a node is a leaf.\npub fn astisleaf(ast: &Ast, node: AstNodeT) -> bool {\n    if node < 0 || node >= ast.par_cnt {\n        return false;\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return false;\n    }\n    let pn = ast.par[idx as usize];\n    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n        return false;\n    }\n    ast.nodes[pn as usize].delta == 1\n}\n\n/// Returns the next node in the AST (wrapper for astnextdf).\npub fn astnext(ast: &Ast, node: AstNodeT) -> AstNodeT {\n    astnextdf(ast, node)\n}\n\n/// Returns a match code if the node’s rule is one of several provided.\npub fn ast_isn(\n    ast: &Ast,\n    node: AstNodeT,\n    r1: &str,\n    r2: Option<&str>,\n    r3: Option<&str>,\n    r4: Option<&str>,\n    r5: Option<&str>,\n) -> i32 {\n    if ast_is(ast, node, r1) != 0 {\n        return 1;\n    }\n    if let Some(r) = r2 {\n        if ast_is(ast, node, r) != 0 {\n            return 1;\n        }\n    }\n    if let Some(r) = r3 {\n        if ast_is(ast, node, r) != 0 {\n            return 1;\n        }\n    }\n    if let Some(r) = r4 {\n        if ast_is(ast, node, r) != 0 {\n            return 1;\n        }\n    }\n    if let Some(r) = r5 {\n        if ast_is(ast, node, r) != 0 {\n            return 1;\n        }\n    }\n    0\n}\n\n/// Checks if a node’s rule matches a given rule.\npub fn ast_is(ast: &Ast, node: AstNodeT, rulename: &str) -> i32 {\n    if node == ASTNULL || node >= ast.par_cnt || node < 0 {\n        return 0;\n    }\n    let mut idx = node;\n    if ast.par[idx as usize] < 0 {\n        idx += ast.par[idx as usize];\n    }\n    if idx < 0 {\n        return 0;\n    }\n    let pn = ast.par[idx as usize];\n    if pn < 0 || (pn as usize) >= ast.nodes.len() {\n        return 0;\n    }\n    if ast.nodes[pn as usize].rule == rulename {\n        1\n    } else {\n        0\n    }\n}\n\n/// Checks if the AST contains an error.\npub fn asthaserr(ast: &Ast) -> bool {\n    ast.err_pos >= 0\n}\n\n/// Returns the rule name at which an error occurred.\npub fn asterrrule(ast: &Ast) -> Option<&str> {\n    if ast.err_pos < 0 {\n        return Some(\"\");\n    }\n    ast.err_rule.as_deref()\n}\n\n/// Returns the error position as a string pointer.\npub fn asterrpos(ast: &Ast) -> Option<&str> {\n    if ast.err_pos < 0 {\n        return Some(\"\");\n    }\n    let p = ast.err_pos as usize;\n    let bytes = ast.start.as_bytes();\n    if p > bytes.len() || !ast.start.is_char_boundary(p) {\n        return Some(\"\");\n    }\n    Some(&ast.start[p..])\n}\n\n/// Returns the start of the error line.\npub fn asterrline(ast: &Ast) -> &str {\n    if ast.err_pos < 0 {\n        return \"\";\n    }\n    let bytes = ast.start.as_bytes();\n    let mut p = (ast.err_pos as usize).min(bytes.len());\n    while p > 0 {\n        let prev = bytes[p - 1];\n        if prev == b'\\n' || prev == b'\\r' {\n            break;\n        }\n        p -= 1;\n    }\n    if ast.start.is_char_boundary(p) {\n        &ast.start[p..]\n    } else {\n        \"\"\n    }\n}\n\n/// Returns the error column number.\npub fn asterrcolnum(ast: &Ast) -> i32 {\n    if ast.err_pos < 0 {\n        return 0;\n    }\n    let bytes = ast.start.as_bytes();\n    let mut p = (ast.err_pos as usize).min(bytes.len());\n    let err_pos = p;\n    while p > 0 {\n        let prev = bytes[p - 1];\n        if prev == b'\\n' || prev == b'\\r' {\n            break;\n        }\n        p -= 1;\n    }\n    (err_pos - p) as i32\n}\n\n/// Prints the AST in s-expression format.\npub fn astprintsexpr(ast: &Ast, f: &mut dyn std::io::Write) {\n    let mut node: AstNodeT = ASTNULL;\n    loop {\n        node = astnextdf(ast, node);\n        if node == ASTNULL {\n            break;\n        }\n        if astisnodeentry(ast, node) {\n            let _ = write!(f, \"({} \", astnoderule(ast, node));\n            if astisleaf(ast, node) {\n                let _ = write!(f, \"'\");\n                if astnoderule(ast, node) == \"#\" {\n                    let _ = write!(f, \"{}\", astnodeinfo(ast, node));\n                } else {\n                    let from_s = astnodefrom(ast, node);\n                    let to_s = astnodeto(ast, node);\n                    let from_len = from_s.len();\n                    let to_len = to_s.len();\n                    let take = from_len.saturating_sub(to_len);\n                    let slice = &from_s[..take.min(from_len)];\n                    for ch in slice.chars() {\n                        if ch == '\\'' {\n                            let _ = write!(f, \"\\\\\");\n                        }\n                        let _ = write!(f, \"{}\", ch);\n                    }\n                }\n                let _ = write!(f, \"'\");\n            }\n        } else {\n            let _ = write!(f, \")\");\n        }\n    }\n}\n\n/// Prints the AST as a tree.\npub fn astprinttree(ast: &Ast, f: &mut dyn std::io::Write) {\n    let mut node: AstNodeT = ASTNULL;\n    let mut levl: i32 = 0;\n    loop {\n        node = astnextdf(ast, node);\n        if node == ASTNULL {\n            break;\n        }\n        if astisnodeentry(ast, node) {\n            let mut k = 0;\n            while k < levl {\n                let _ = write!(f, \"    \");\n                k += 4;\n            }\n            let _ = write!(f, \"[{}\", astnoderule(ast, node));\n            let tag = astnodeinfo(ast, node);\n            if tag != 0 {\n                let _ = write!(f, \" ({})\", tag);\n            }\n            let _ = write!(f, \"]\");\n            levl += 4;\n            if astisleaf(ast, node) {\n                let _ = write!(f, \" '\");\n                let from_s = astnodefrom(ast, node);\n                let to_s = astnodeto(ast, node);\n                let from_len = from_s.len();\n                let to_len = to_s.len();\n                let take = from_len.saturating_sub(to_len);\n                let slice = &from_s[..take.min(from_len)];\n                for ch in slice.chars() {\n                    if ch == '\\'' {\n                        let _ = write!(f, \"\\\\\");\n                    }\n                    let _ = write!(f, \"{}\", ch);\n                }\n                let _ = write!(f, \"'\");\n            }\n            let _ = writeln!(f);\n        } else {\n            levl -= 4;\n        }\n    }\n}\n\n// effective_len is referenced by some helpers but currently unused; suppress warnings\n#[allow(dead_code)]\nfn _unused() {\n    let _ = effective_len(\"\");\n}\n","numLines":2031,"startLine":1,"totalLines":2031}}}
