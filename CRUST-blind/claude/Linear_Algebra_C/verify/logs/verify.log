  // No-op in Rust, memory is released automatically.\n65\t}\n66\t\n67\tpub fn copy_matrix_impl(m: &Matrix) -> Matrix {\n68\t    assert_matrix_impl(m);\n69\t    let mut c = zero_matrix_impl(m.rows, m.cols);\n70\t    for i in 0..m.rows {\n71\t        for j in 0..m.cols {\n72\t            c.data[i * m.cols + j] = m.data[i * m.cols + j];\n73\t        }\n74\t    }\n75\t    c\n76\t}\n77\t\n78\tpub fn flatten_matrix_impl(m: &Matrix) -> Vector {\n79\t    assert_matrix_impl(m);\n80\t    let mut flat = null_vector_impl(m.rows * m.cols);\n81\t    let mut idx = 0;\n82\t    for i in 0..m.rows {\n83\t        for j in 0..m.cols {\n84\t            flat.data[idx] = m.data[i * m.cols + j];\n85\t            idx += 1;\n86\t        }\n87\t    }\n88\t    flat\n89\t}\n90\t\n91\tpub fn matrix_size_impl(m: &Matrix) -> usize {\n92\t    assert_matrix_impl(m);\n93\t    m.rows * m.cols\n94\t}\n95\t\n96\tpub fn matrix_size_bytes_impl(m: &Matrix) -> usize {\n97\t    std::mem::size_of::<f64>() * matrix_size_impl(m)\n98\t}\n99\t\n100\tpub fn set_matrix_element_impl(m: &mut Matrix, i: usize, j: usize, s: f64) {\n101\t    assert!(assert_matrix_impl(m) && i < m.rows && j < m.cols);\n102\t    let cols = m.cols;\n103\t    m.data[i * cols + j] = s;\n104\t}\n105\t\n106\tpub fn get_matrix_element_impl(m: &Matrix, i: usize, j: usize) -> f64 {\n107\t    assert!(assert_matrix_impl(m) && i < m.rows && j < m.cols);\n108\t    m.data[i * m.cols + j]\n109\t}\n110\t\n111\tpub fn set_row_vector_impl(m: &mut Matrix, i: usize, v: &Vector) {\n112\t    assert!(assert_matrix_impl(m) && assert_vector_impl(v) && i < m.rows);\n113\t    let cols = m.cols;\n114\t    for j in 0..v.cols {\n115\t        m.data[i * cols + j] = v.data[j];\n116\t    }\n117\t}\n118\t\n119\tpub fn get_row_vector_impl(m: &Matrix, i: usize) -> Vector {\n120\t    assert!(assert_matrix_impl(m) && i < m.rows);\n121\t    let mut row = vec![0.0; m.cols];\n122\t    for j in 0..m.cols {\n123\t        row[j] = m.data[i * m.cols + j];\n124\t    }\n125\t    new