rintf(\"%.4f \",getMatrixElement(invR,i,j));printf(\"\\n\");}\n    deleteMatrix(invR); deleteMatrix(tr); deleteMatrix(mr);\n\n    // hasZeroRow/Col in 1x1\n    double d11[1] = {0};\n    matrix* m11 = newMatrix(d11, 1, 1);\n    printf(\"hasZeroRow [0] (1x1) = %d\\n\", hasZeroRow(m11));\n    printf(\"hasZeroCol [0] (1x1) = %d\\n\", hasZeroCol(m11));\n    deleteMatrix(m11);\n\n    double d11b[1] = {5};\n    matrix* m11b = newMatrix(d11b, 1, 1);\n    printf(\"hasZeroRow [5] (1x1) = %d\\n\", hasZeroRow(m11b));\n    printf(\"hasZeroCol [5] (1x1) = %d\\n\", hasZeroCol(m11b));\n    deleteMatrix(m11b);\n\n    // Test getColVector/setColVector\n    double dc[6] = {1,2,3,4,5,6};\n    matrix* mc = newMatrix(dc, 3, 2);\n    vector* col0 = getColVector(mc, 0);\n    vector* col1 = getColVector(mc, 1);\n    printf(\"getColVector 0: %.0f %.0f %.0f\\n\", col0->data[0], col0->data[1], col0->data[2]);\n    printf(\"getColVector 1: %.0f %.0f %.0f\\n\", col1->data[0], col1->data[1], col1->data[2]);\n    deleteVector(col0); deleteVector(col1); deleteMatrix(mc);\n\n    // Test getRowVector\n    double dr2[6] = {1,2,3,4,5,6};\n    matrix* mr2 = newMatrix(dr2, 2, 3);\n    vector* r0 = getRowVector(mr2, 0);\n    vector* r1 = getRowVector(mr2, 1);\n    printf(\"getRowVector 0: %.0f %.0f %.0f\\n\", r0->data[0], r0->data[1], r0->data[2]);\n    printf(\"getRowVector 1: %.0f %.0f %.0f\\n\", r1->data[0], r1->data[1], r1->data[2]);\n    deleteVector(r0); deleteVector(r1); deleteMatrix(mr2);\n\n    // anti diagonal of 3x3\n    double dad[9] = {1,2,3,4,5,6,7,8,9};\n    matrix* mad = newMatrix(dad, 3, 3);\n    vector* ad = getAntiDiagonal(mad);\n    printf(\"antiDiagonal [1..9]: %.0f %.0f %.0f\\n\", ad->data[0], ad->data[1], ad->data[2]);\n    deleteVector(ad); deleteMatrix(mad);\n\n    // setAntiDiagonal of 3x3\n    matrix* sad = zeroMatrix(3, 3);\n    double dvad[3] = {10, 20, 30};\n    vector* vad = newVector(dvad, 3);\n    setAntiDiagonal(sad, vad);\n    printf(\"setAntiDiagonal:\\n\");\n    for(in