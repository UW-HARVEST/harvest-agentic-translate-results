 {\n183\t    assert!(is_square_matrix_impl(m) && assert_vector_impl(v) && m.rows == m.cols && m.cols == v.cols);\n184\t    let mut idx = 0;\n185\t    let rows = m.rows as i64;\n186\t    let cols_i = m.cols as i64;\n187\t    let cols = m.cols;\n188\t    let mrows = m.rows;\n189\t    'outer: for i in (0..rows).rev() {\n190\t        for j in (0..cols_i).rev() {\n191\t            if i + j == rows - 1 {\n192\t                m.data[(i as usize) * cols + (j as usize)] = v.data[idx];\n193\t                idx += 1;\n194\t                if idx == mrows {\n195\t                    break 'outer;\n196\t                }\n197\t            }\n198\t        }\n199\t    }\n200\t}\n201\t\n202\tpub fn diagonal_product_impl(m: &Matrix) -> f64 {\n203\t    let diagonal = get_main_diagonal_impl(m);\n204\t    let mut product = 1.0;\n205\t    for i in 0..diagonal.cols {\n206\t        product *= diagonal.data[i];\n207\t    }\n208\t    product\n209\t}\n210\t\n211\tpub fn is_matrix_equal_impl(m: &Matrix, n: &Matrix) -> bool {\n212\t    assert!(assert_matrix_impl(m) && assert_matrix_impl(n));\n213\t    if m.rows != n.rows || m.cols != n.cols {\n214\t        return false;\n215\t    }\n216\t    for i in 0..m.rows {\n217\t        for j in 0..m.cols {\n218\t            if m.data[i * m.cols + j] != n.data[i * n.cols + j] {\n219\t                return false;\n220\t            }\n221\t        }\n222\t    }\n223\t    true\n224\t}\n225\t\n226\tpub fn has_same_dimensions_impl(m: &Matrix, n: &Matrix) -> bool {\n227\t    assert!(assert_matrix_impl(m) && assert_matrix_impl(n));\n228\t    m.rows == n.rows && m.cols == n.cols\n229\t}\n230\t\n231\tpub fn is_zero_matrix_impl(m: &Matrix) -> bool {\n232\t    assert_matrix_impl(m);\n233\t    for i in 0..m.rows {\n234\t        for j in 0..m.cols {\n235\t            if m.data[i * m.cols + j] != 0.0 {\n236\t                return false;\n237\t            }\n238\t        }\n239\t    }\n240\t    true\n241\t}\n242\t\n243\tpub fn is_identity_matrix_impl(m: &Matrix) -> bool {\n244\t    if !is_square_matrix_impl(m) {\n245\t        return false;\n246\t    }\n247\t    for i in 0..m.rows {\n248\t        for j in 0..m.cols {\n249\t            if i == j && m.data[i * m.cols + j] != 1.0 {\n250\t                return false;\n251\t            } else if i != j && m.data[i * m.cols + j] != 0.0 {\n252\t                return false;\n253\t            }\n254\t        }\n255\t    }\n256\t    true\n257\t}\n258\t\n259\tpub fn is_square_matrix_impl(m: &Matrix) -> bool {\n260\t    assert_matrix_impl(m);\n261\t    m.rows == m.cols\n262\t}\n263\t\n264\tpub fn is_invertible_impl(m: &Matrix) -> bool {\n265\t    is_square_matrix_impl(m) && determinant_impl(m) != 0.0\n266\t}\n267\t\n268\tpub fn is_diagonal_matrix_impl(m: &Matrix) -> bool {\n269\t    assert!(is_square_matrix_impl(m));\n270\t    for i in 0..m.rows {\n271\t        for j in 0..m.cols {\n272\t            if i != j && m.data[i * m.cols + j] != 0.0 {\n273\t                return false;\n274\t            }\n275\t        }\n276\t    }\n277\t    true\n278\t}\n279\t\n280\tpub fn is_triangular_matrix_impl(m: &Matrix) -> bool {\n281\t    assert!(is_square_matrix_impl(m));\n282\t    exclusive_or(is_up_tri_matrix_impl(m), is_lo_tri_matrix_impl(m))\n283\t}\n284\t\n285\tpub fn is_up_tri_matrix_impl(m: &Matrix) -> bool {\n286\t    assert!(is_square_matrix_impl(m));\n287\t    for i in 0..m.rows {\n288\t        for j in 0..i {\n289\t            if m.data[i * m.cols + j] != 0.0 {\n290\t                return false;\n291\t            }\n292\t        }\n293\t    }\n294\t    true\n295\t}\n296\t\n297\tpub fn is_lo_tri_matrix_impl(m: &Matrix) -> bool {\n298\t    assert!(is_square_matrix_impl(m));\n299\t    for i in 0..m.rows {\n300\t        for j in (i + 1)..m.cols {\n301\t            if m.data[i * m.cols + j] != 0.0 {\n302\t                return false;\n303\t            }\n304\t        }\n305\t    }\n306\t    true\n307\t}\n308\t\n309\tpub fn is_matrix_symmetric_impl(m: &Matrix) -> bool {\n310\t    let t = transpose_matrix_impl(m);\n311\t    is_matrix_equal_impl(m, &t)\n312\t}\n313\t\n314\tpub fn has_zero_row_impl(m: &Matrix) -> bool {\n315\t    assert_matrix_impl(m);\n316\t    let mut all_zeroes = true;\n317\t    for i in 0..m.rows {\n318\t        for j in 0..m.cols {\n319\t            if m.data[i * m.cols + j] != 0.0 {\n320\t                all_zeroes = false;\n321\t            }\n322\t        }\n323\t        if all_zeroes {\n324\t            return true;\n325\t        }\n326\t        all_zeroes = true;\n327\t    }\n328\t    false\n329\t}\n330\t\n331\tpub fn has_zero_col_impl(m: &Matrix) -> bool {\n332\t    assert_matrix_impl(m);\n333\t    // Replicate the (slightly buggy) C-style logic:\n334\t    let mut all_zeroes = true;\n335\t    for j in 0..m.rows {\n336\t        for i in 0..m.cols {\n337\t            if m.data[i * m.cols + j] != 0.0 {\n338\t                all_zeroes = false;\n339\t            }\n340\t        }\n341\t        if all_zeroes {\n342\t            return true;\n343\t        }\n344\t        all_zeroes = true;\n345\t    }\n346\t    false\n347\t}\n348\t\n349\tpub fn transpose_matrix_impl(m: &Matrix) -> Matrix {\n350\t    assert_matrix_impl(m);\n351\t    let mut t = zero_matrix_impl(m.cols, m.rows);\n352\t    let tcols = t.cols;\n353\t    for i in 0..m.rows {\n354\t        for j in 0..m.cols {\n355\t            t.data[j * tcols + i] = m.data[i * m.cols + j];\n356\t        }\n357\t    }\n358\t    t\n359\t}\n360\t\n361\tpub fn trace_matrix_impl(m: &Matrix) -> f64 {\n362\t    assert!(is_square_matrix_impl(m));\n363\t    let mut trace = 0.0;\n364\t    for i in 0..m.rows {\n365\t        trace += m.data[i * m.cols + i];\n366\t    }\n367\t    trace\n368\t}\n369\t\n370\tpub fn add_matrices_impl(m: &Matrix, n: &Matrix) -> Matrix {\n371\t    assert!(has_same_dimensions_impl(m, n));\n372\t    let mut sum = null_matrix_impl(m.rows, m.cols);\n373\t    let mut idx = 0;\n374\t    for _i in 0..m.rows {\n375\t        for _j in 0..m.cols {\n376\t            sum.data[idx] = m.data[idx] + n.data[idx];\n377\t            idx += 1;\n378\t        }\n379\t    }\n380\t    sum\n381\t}\n382\t\n383\tpub fn pow_matrix_impl(m: &Matrix, k: f64) -> Matrix {\n384\t    assert_matrix_impl(m);\n385\t    let mut p = null_matrix_impl(m.rows, m.cols);\n386\t    for i in 0..m.rows {\n387\t        for j in 0..m.cols {\n388\t            p.data[i * m.cols + j] = m.data[i * m.cols + j].powf(k);\n389\t        }\n390\t    }\n391\t    p\n392\t}\n393\t\n394\tpub fn multiply_matrices_impl(m: &Matrix, n: &Matrix) -> Matrix {\n395\t    // Replicates the C signature: requires m->cols == n->cols && m->rows == n->rows\n396\t    assert!(assert_matrix_impl(m) && assert_matrix_impl(n) && m.cols == n.cols && m.rows == n.rows);\n397\t    let mut prod = null_matrix_impl(m.rows, m.cols);\n398\t    for j in 0..m.rows {\n399\t        for i in 0..m.cols {\n400\t            let mut val = 0.0;\n401\t            for k in 0..m.cols {\n402\t                val += m.data[i * m.cols + k] * n.data[k * m.cols + j];\n403\t            }\n404\t            prod.data[i * m.cols + j] = val;\n405\t        }\n406\t    }\n407\t    prod\n408\t}\n409\t\n410\tpub fn scale_matrix_impl(m: &Matrix, s: f64) -> Matrix {\n411\t    assert_matrix_impl(m);\n412\t    let mut scaled = null_matrix_impl(m.rows, m.cols);\n413\t    for i in 0..m.rows {\n414\t        for j in 0..m.cols {\n415\t            scaled.data[i * m.cols + j] = m.data[i * m.cols + j] * s;\n416\t        }\n417\t    }\n418\t    scaled\n419\t}\n420\t\n421\tpub fn sub_matrix_impl(m: &Matrix, i: usize, j: usize) -> Matrix {\n422\t    assert!(assert_matrix_impl(m) && i < m.rows && j < m.cols);\n423\t    let mut sm = null_matrix_impl(m.rows - 1, m.cols - 1);\n424\t    let mut idx = 0;\n425\t    for row in 0..m.rows {\n426\t        for col in 0..m.cols {\n427\t            if row != i && col != j {\n428\t                sm.data[idx] = m.data[row * m.cols + col];\n429\t                idx += 1;\n430\t            }\n431\t        }\n432\t    }\n433\t    sm\n434\t}\n435\t\n436\tpub fn element_minor_impl(m: &Matrix, i: usize, j: usize) -> f64 {\n437\t    let sm = sub_matrix_impl(m, i, j);\n438\t    determinant_impl(&sm)\n439\t}\n440\t\n441\tpub fn matrix_minor_impl(m: &Matrix) -> Matrix {\n442\t    assert_matrix_impl(m);\n443\t    let mut mm = null_matrix_impl(m.rows, m.cols);\n444\t    let mmcols = mm.cols;\n445\t    for i in 0..mm.rows {\n446\t        for j in 0..mmcols {\n447\t            mm.data[i * mmcols + j] = element_minor_impl(m, i, j);\n448\t        }\n449\t    }\n450\t    mm\n451\t}\n452\t\n453\tpub fn element_cofactor_impl(m: &Matrix, i: usize, j: usize) -> f64 {\n454\t    let sign = (-1f64).powi(((i + 1) + (j + 1)) as i32);\n455\t    sign * element_minor_impl(m, i, j)\n456\t}\n457\t\n458\tpub fn matrix_cofactor_impl(m: &Matrix) -> Matrix {\n459\t    assert_matrix_impl(m);\n460\t    let mut cfm = null_matrix_impl(m.rows, m.cols);\n461\t    let cfmcols = cfm.cols;\n462\t    for i in 0..cfm.rows {\n463\t        for j in 0..cfmcols {\n464\t            cfm.data[i * cfmcols + j] = element_cofactor_impl(m, i, j);\n465\t        }\n466\t    }\n467\t    cfm\n468\t}\n469\t\n470\tpub fn sign_matrix_impl(rows: usize, cols: usize) -> Matrix {\n471\t    assert!(rows > 0 && cols > 0);\n472\t    let mut sm = null_matrix_impl(rows, cols);\n473\t    fill_matrix_impl(&mut sm, 1.0);\n474\t    let smcols = sm.cols;\n475\t    for i in 0..sm.rows {\n476\t        for j in 0..smcols {\n477\t            // Replicate C: ((i*cols+j)+1) % 2 ? 1 : -1\n478\t            sm.data[i * smcols + j] = if ((i * smcols + j) + 1) % 2 != 0 {\n479\t                1.0\n480\t            } else {\n481\t                -1.0\n482\t            };\n483\t        }\n484\t    }\n485\t    sm\n486\t}\n487\t\n488\tpub fn adjugate_matrix_impl(m: &Matrix) -> Matrix {\n489\t    assert_matrix_impl(m);\n490\t    let mm = matrix_minor_impl(m);\n491\t    let sign = sign_matrix_impl(m.rows, m.cols);\n492\t    multiply_matrices_impl(&mm, &sign)\n493\t}\n494\t\n495\tpub fn lu_decomposition_impl(m: &Matrix) -> (Matrix, Matrix, Matrix, i32) {\n496\t    assert!(is_square_matrix_impl(m));\n497\t    let n = m.cols;\n498\t    let (p, swaps) = pivot_matrix_impl(m);\n499\t    let mut l = zero_matrix_impl(n, n);\n500\t    let mut u = zero_matrix_impl(n, n);\n501\t    let m2 = multiply_matrices_impl(&p, m);\n502\t    for j in 0..n {\n503\t        l.data[j * n + j] = 1.0;\n504\t        for i in 0..(j + 1) {\n505\t            let mut sum_u = 0.0;\n506\t            for k in 0..i {\n507\t                sum_u += u.data[k * n + j] * l.data[i * n + k];\n508\t            }\n509\t            u.data[i * n + j] = m2.data[i * n + j] - sum_u;\n510\t        }\n511\t        for i in j..n {\n512\t            let mut sum_l = 0.0;\n513\t            for k in 0..j {\n514\t                sum_l += u.data[k * n + j] * l.data[i * n + k];\n515\t            }\n516\t            l.data[i * n + j] = (m2.data[i * n + j] - sum_l) / u.data[j * n + j];\n517\t        }\n518\t    }\n519\t    (l, u, p, swaps)\n520\t}\n521\t\n522\tpub fn inverse_matrix_impl(m: &Matrix) -> Matrix {\n523\t    assert!(is_invertible_impl(m));\n524\t    let adj = adjugate_matrix_impl(m);\n525\t    let det = determinant_impl(m);\n526\t    scale_matrix_impl(&adj, 1.0 / det)\n527\t}\n528\t\n529\tpub fn pivot_matrix_impl(m: &Matrix) -> (Matrix, i32) {\n530\t    assert!(is_square_matrix_impl(m));\n531\t    let n = m.cols;\n532\t    let mut pivot = identity_matrix_impl(n);\n533\t    let mut swaps = 0i32;\n534\t    for i in 0..n {\n535\t        let mut max = m.data[i * n + i];\n536\t        let mut row = i;\n537\t        for j in i..n {\n538\t            if m.data[j * n + i] > max {\n539\t                max = m.data[j * n + i];\n540\t                row = j;\n541\t            }\n542\t        }\n543\t        if i != row {\n544\t            let v = get_row_vector_impl(&pivot, i);\n545\t            let w = get_row_vector_impl(&pivot, row);\n546\t            set_row_vector_impl(&mut pivot, i, &w);\n547\t            set_row_vector_impl(&mut pivot, row, &v);\n548\t            // Note: C's pivotMatrix increments local int* swaps (which is the int*+1, a pointer\n549\t            // bug). We follow the apparent intent of counting swaps.\n550\t            swaps += 1;\n551\t        }\n552\t    }\n553\t    (pivot, swaps)\n554\t}\n555\t\n556\tpub fn scale_n_space_impl(m: &Matrix, k: f64) -> Matrix {\n557\t    assert!(is_square_matrix_impl(m));\n558\t    let mut n = zero_matrix_impl(m.cols, m.cols);\n559\t    let mut v = zero_vector_impl(m.cols);\n560\t    fill_vector_impl(&mut v, k);\n561\t    set_main_diagonal_impl(&mut n, &v);\n562\t    multiply_matrices_impl(m, &n)\n563\t}\n564\t\n565\tpub fn reflect_axis_2d_impl(m: &Matrix, axis: i32) -> Matrix {\n566\t    assert!(is_square_matrix_impl(m) && m.cols == 2);\n567\t    let mut n = zero_matrix_impl(2, 2);\n568\t    set_matrix_element_impl(&mut n, 0, 0, if axis != 0 { 1.0 } else { -1.0 });\n569\t    set_matrix_element_impl(&mut n, 1, 1, if axis != 0 { -1.0 } else { 1.0 });\n570\t    multiply_matrices_impl(m, &n)\n571\t}\n572\t\n573\tpub fn reflect_axis_3d_impl(m: &Matrix, axis: i32) -> Matrix {\n574\t    // The C code is buggy (modifies m, leaves n uninitialized). We replicate the apparent\n575\t    // intent: build a reflection matrix n based on axis, then multiply m * n.\n576\t    assert!(is_square_matrix_impl(m) && m.cols == 3 && (0..=2).contains(&axis));\n577\t    let mut n = zero_matrix_impl(3, 3);\n578\t    let v = match axis {\n579\t        0 => new_vector_impl(&[1.0, 1.0, -1.0], 3),  // XY\n580\t        1 => new_vector_impl(&[1.0, -1.0, 1.0], 3),  // XZ\n581\t        _ => new_vector_impl(&[-1.0, 1.0, 1.0], 3),  // YZ\n582\t    };\n583\t    set_main_diagonal_impl(&mut n, &v);\n584\t    multiply_matrices_impl(m, &n)\n585\t}\n586\t\n587\tpub fn orth_proj_2d_impl(m: &Matrix, axis: i32) -> Matrix {\n588\t    assert!(is_square_matrix_impl(m) && m.cols == 2);\n589\t    let mut n = zero_matrix_impl(2, 2);\n590\t    set_matrix_element_impl(&mut n, axis as usize, axis as usize, 1.0);\n591\t    multiply_matrices_impl(m, &n)\n592\t}\n593\t\n594\tpub fn orth_proj_3d_impl(m: &Matrix, axis: i32) -> Matrix {\n595\t    assert!(is_square_matrix_impl(m) && m.cols == 3);\n596\t    let mut n = zero_matrix_impl(3, 3);\n597\t    match axis {\n598\t        0 => {\n599\t            // XY plane\n600\t            set_matrix_element_impl(&mut n, 0, 0, 1.0);\n601\t            set_matrix_element_impl(&mut n, 1, 1, 1.0);\n602\t        }\n603\t        1 => {\n604\t            // XZ plane\n605\t            set_matrix_element_impl(&mut n, 0, 0, 1.0);\n606\t            set_matrix_element_impl(&mut n, 2, 2, 1.0);\n607\t        }\n608\t        2 => {\n609\t            // YZ plane\n610\t            set_matrix_element_impl(&mut n, 1, 1, 1.0);\n611\t            set_matrix_element_impl(&mut n, 2, 2, 1.0);\n612\t        }\n613\t        _ => {}\n614\t    }\n615\t    multiply_matrices_impl(m, &n)\n616\t}\n617\t\n618\tpub fn shear_2d_impl(m: &Matrix, k: f64, axis: i32) -> Matrix {\n619\t    assert!(is_square_matrix_impl(m) && m.cols == 2);\n620\t    let mut n = zero_matrix_impl(2, 2);\n621\t    set_matrix_element_impl(&mut n, 0, 0, 1.0);\n622\t    set_matrix_element_impl(&mut n, 0, 1, if axis != 0 { k } else { 0.0 });\n623\t    set_matrix_element_impl(&mut n, 1, 0, if axis != 0 { 0.0 } else { k });\n624\t    set_matrix_element_impl(&mut n, 1, 1, 1.0);\n625\t    multiply_matrices_impl(m, &n)\n626\t}\n627\t\n628\t// --- Determinant helper ---\n629\tpub fn determinant_impl(m: &Matrix) -> f64 {\n630\t    assert!(is_square_matrix_impl(m));\n631\t    match m.rows {\n632\t        1 => m.data[0],\n633\t        2 => (m.data[0] * m.data[3]) - (m.data[1] * m.data[2]),\n634\t        3 => {\n635\t            (m.data[0] * ((m.data[4] * m.data[8]) - (m.data[5] * m.data[7])))\n636\t                - (m.data[1] * ((m.data[3] * m.data[8]) - (m.data[5] * m.data[6])))\n637\t                + (m.data[2] * ((m.data[3] * m.data[7]) - (m.data[4] * m.data[6])))\n638\t        }\n639\t        _ => {\n640\t            if is_triangular_matrix_impl(m) {\n641\t                return diagonal_product_impl(m);\n642\t            }\n643\t            let (l, u, _p, swaps) = lu_decomposition_impl(m);\n644\t            // det(P) = (-1)^swaps; in C it computes pow(-1, swaps - 1) * det(l)*det(u)\n645\t            let sign = (-1f64).powi(swaps - 1);\n646\t            sign * determinant_impl(&l) * determinant_impl(&u)\n647\t        }\n648\t    }\n649\t}\n650\t"}]},"parent_tool_use_id":null,"session_id":"51cfbdc2-928c-464f-aec4-6136cce82f3d","uuid":"0608617c-15a4-46ca-aeab-8daaf8e9a703","timestamp":"2026-05-29T13:39:17.522Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-CFajQQ/project/src/matrix.rs","content":"use crate::linear_algebra::{Matrix, Vector};\nuse crate::utils::exclusive_or;\nuse crate::vector::{\n    assert_vector_impl, new_vector_impl, null_vector_impl, zero_vector_impl, fill_vector_impl,\n};\n\npub fn assert_matrix_impl(_m: &Matrix) -> bool {\n    // In Rust, the Matrix struct always has valid data (Vec<f64>), so this is always true.\n    true\n}\n\npub fn new_matrix_impl(d: &[f64], rows: usize, cols: usize) -> Matrix {\n    assert!(rows > 0 && cols > 0);\n    let mut m = null_matrix_impl(rows, cols);\n    let mut idx = 0;\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            m.data[i * m.cols + j] = d[idx];\n            idx += 1;\n        }\n    }\n    m\n}\n\npub fn null_matrix_impl(rows: usize, cols: usize) -> Matrix {\n    assert!(rows > 0 && cols > 0);\n    Matrix {\n        rows,\n        cols,\n        data: vec![0.0; rows * cols],\n    }\n}\n\npub fn zero_matrix_impl(rows: usize, cols: usize) -> Matrix {\n    let mut m = null_matrix_impl(rows, cols);\n    fill_matrix_impl(&mut m, 0.0);\n    m\n}\n\npub fn fill_matrix_impl(m: &mut Matrix, n: f64) {\n    assert_matrix_impl(m);\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            let cols = m.cols;\n            m.data[i * cols + j] = n;\n        }\n    }\n}\n\npub fn identity_matrix_impl(n: usize) -> Matrix {\n    let mut m = zero_matrix_impl(n, n);\n    for i in 0..m.rows {\n        for j in 0..m.rows {\n            if i == j {\n                let cols = m.cols;\n                m.data[i * cols + j] = 1.0;\n            }\n        }\n    }\n    m\n}\n\npub fn delete_matrix_impl(_m: Matrix) {\n    // No-op in Rust, memory is released automatically.\n}\n\npub fn copy_matrix_impl(m: &Matrix) -> Matrix {\n    assert_matrix_impl(m);\n    let mut c = zero_matrix_impl(m.rows, m.cols);\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            c.data[i * m.cols + j] = m.data[i * m.cols + j];\n        }\n    }\n    c\n}\n\npub fn flatten_matrix_impl(m: &Matrix) -> Vector {\n    assert_matrix_impl(m);\n    let mut flat = null_vector_impl(m.rows * m.cols);\n    let mut idx = 0;\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            flat.data[idx] = m.data[i * m.cols + j];\n            idx += 1;\n        }\n    }\n    flat\n}\n\npub fn matrix_size_impl(m: &Matrix) -> usize {\n    assert_matrix_impl(m);\n    m.rows * m.cols\n}\n\npub fn matrix_size_bytes_impl(m: &Matrix) -> usize {\n    std::mem::size_of::<f64>() * matrix_size_impl(m)\n}\n\npub fn set_matrix_element_impl(m: &mut Matrix, i: usize, j: usize, s: f64) {\n    assert!(assert_matrix_impl(m) && i < m.rows && j < m.cols);\n    let cols = m.cols;\n    m.data[i * cols + j] = s;\n}\n\npub fn get_matrix_element_impl(m: &Matrix, i: usize, j: usize) -> f64 {\n    assert!(assert_matrix_impl(m) && i < m.rows && j < m.cols);\n    m.data[i * m.cols + j]\n}\n\npub fn set_row_vector_impl(m: &mut Matrix, i: usize, v: &Vector) {\n    assert!(assert_matrix_impl(m) && assert_vector_impl(v) && i < m.rows);\n    let cols = m.cols;\n    for j in 0..v.cols {\n        m.data[i * cols + j] = v.data[j];\n    }\n}\n\npub fn get_row_vector_impl(m: &Matrix, i: usize) -> Vector {\n    assert!(assert_matrix_impl(m) && i < m.rows);\n    let mut row = vec![0.0; m.cols];\n    for j in 0..m.cols {\n        row[j] = m.data[i * m.cols + j];\n    }\n    new_vector_impl(&row, m.cols)\n}\n\npub fn set_col_vector_impl(m: &mut Matrix, j: usize, v: &Vector) {\n    assert!(assert_matrix_impl(m) && assert_vector_impl(v) && j < m.cols);\n    let cols = m.cols;\n    for i in 0..v.cols {\n        m.data[i * cols + j] = v.data[i];\n    }\n}\n\npub fn get_col_vector_impl(m: &Matrix, j: usize) -> Vector {\n    assert!(assert_matrix_impl(m) && j < m.cols);\n    let mut col = vec![0.0; m.rows];\n    for i in 0..m.rows {\n        col[i] = m.data[i * m.cols + j];\n    }\n    new_vector_impl(&col, m.rows)\n}\n\npub fn get_main_diagonal_impl(m: &Matrix) -> Vector {\n    assert!(is_square_matrix_impl(m));\n    let mut diag = vec![0.0; m.rows];\n    for x in 0..m.rows {\n        diag[x] = m.data[x * m.cols + x];\n    }\n    new_vector_impl(&diag, m.rows)\n}\n\npub fn set_main_diagonal_impl(m: &mut Matrix, v: &Vector) {\n    assert!(is_square_matrix_impl(m) && assert_vector_impl(v) && m.rows == m.cols && m.cols == v.cols);\n    let cols = m.cols;\n    for x in 0..v.cols {\n        m.data[x * cols + x] = v.data[x];\n    }\n}\n\npub fn get_anti_diagonal_impl(m: &Matrix) -> Vector {\n    assert!(is_square_matrix_impl(m));\n    let mut x = 0;\n    let mut diag = vec![0.0; m.rows];\n    let rows = m.rows as i64;\n    let cols = m.cols as i64;\n    'outer: for i in (0..rows).rev() {\n        for j in (0..cols).rev() {\n            if i + j == rows - 1 {\n                diag[x] = m.data[(i as usize) * m.cols + (j as usize)];\n                x += 1;\n                if x == m.rows {\n                    break 'outer;\n                }\n            }\n        }\n    }\n    new_vector_impl(&diag, m.rows)\n}\n\npub fn set_anti_diagonal_impl(m: &mut Matrix, v: &Vector) {\n    assert!(is_square_matrix_impl(m) && assert_vector_impl(v) && m.rows == m.cols && m.cols == v.cols);\n    let mut idx = 0;\n    let rows = m.rows as i64;\n    let cols_i = m.cols as i64;\n    let cols = m.cols;\n    let mrows = m.rows;\n    'outer: for i in (0..rows).rev() {\n        for j in (0..cols_i).rev() {\n            if i + j == rows - 1 {\n                m.data[(i as usize) * cols + (j as usize)] = v.data[idx];\n                idx += 1;\n                if idx == mrows {\n                    break 'outer;\n                }\n            }\n        }\n    }\n}\n\npub fn diagonal_product_impl(m: &Matrix) -> f64 {\n    let diagonal = get_main_diagonal_impl(m);\n    let mut product = 1.0;\n    for i in 0..diagonal.cols {\n        product *= diagonal.data[i];\n    }\n    product\n}\n\npub fn is_matrix_equal_impl(m: &Matrix, n: &Matrix) -> bool {\n    assert!(assert_matrix_impl(m) && assert_matrix_impl(n));\n    if m.rows != n.rows || m.cols != n.cols {\n        return false;\n    }\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            if m.data[i * m.cols + j] != n.data[i * n.cols + j] {\n                return false;\n            }\n        }\n    }\n    true\n}\n\npub fn has_same_dimensions_impl(m: &Matrix, n: &Matrix) -> bool {\n    assert!(assert_matrix_impl(m) && assert_matrix_impl(n));\n    m.rows == n.rows && m.cols == n.cols\n}\n\npub fn is_zero_matrix_impl(m: &Matrix) -> bool {\n    assert_matrix_impl(m);\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            if m.data[i * m.cols + j] != 0.0 {\n                return false;\n            }\n        }\n    }\n    true\n}\n\npub fn is_identity_matrix_impl(m: &Matrix) -> bool {\n    if !is_square_matrix_impl(m) {\n        return false;\n    }\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            if i == j && m.data[i * m.cols + j] != 1.0 {\n                return false;\n            } else if i != j && m.data[i * m.cols + j] != 0.0 {\n                return false;\n            }\n        }\n    }\n    true\n}\n\npub fn is_square_matrix_impl(m: &Matrix) -> bool {\n    assert_matrix_impl(m);\n    m.rows == m.cols\n}\n\npub fn is_invertible_impl(m: &Matrix) -> bool {\n    is_square_matrix_impl(m) && determinant_impl(m) != 0.0\n}\n\npub fn is_diagonal_matrix_impl(m: &Matrix) -> bool {\n    assert!(is_square_matrix_impl(m));\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            if i != j && m.data[i * m.cols + j] != 0.0 {\n                return false;\n            }\n        }\n    }\n    true\n}\n\npub fn is_triangular_matrix_impl(m: &Matrix) -> bool {\n    assert!(is_square_matrix_impl(m));\n    exclusive_or(is_up_tri_matrix_impl(m), is_lo_tri_matrix_impl(m))\n}\n\npub fn is_up_tri_matrix_impl(m: &Matrix) -> bool {\n    assert!(is_square_matrix_impl(m));\n    for i in 0..m.rows {\n        for j in 0..i {\n            if m.data[i * m.cols + j] != 0.0 {\n                return false;\n            }\n        }\n    }\n    true\n}\n\npub fn is_lo_tri_matrix_impl(m: &Matrix) -> bool {\n    assert!(is_square_matrix_impl(m));\n    for i in 0..m.rows {\n        for j in (i + 1)..m.cols {\n            if m.data[i * m.cols + j] != 0.0 {\n                return false;\n            }\n        }\n    }\n    true\n}\n\npub fn is_matrix_symmetric_impl(m: &Matrix) -> bool {\n    let t = transpose_matrix_impl(m);\n    is_matrix_equal_impl(m, &t)\n}\n\npub fn has_zero_row_impl(m: &Matrix) -> bool {\n    assert_matrix_impl(m);\n    let mut all_zeroes = true;\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            if m.data[i * m.cols + j] != 0.0 {\n                all_zeroes = false;\n            }\n        }\n        if all_zeroes {\n            return true;\n        }\n        all_zeroes = true;\n    }\n    false\n}\n\npub fn has_zero_col_impl(m: &Matrix) -> bool {\n    assert_matrix_impl(m);\n    // Replicate the (slightly buggy) C-style logic:\n    let mut all_zeroes = true;\n    for j in 0..m.rows {\n        for i in 0..m.cols {\n            if m.data[i * m.cols + j] != 0.0 {\n                all_zeroes = false;\n            }\n        }\n        if all_zeroes {\n            return true;\n        }\n        all_zeroes = true;\n    }\n    false\n}\n\npub fn transpose_matrix_impl(m: &Matrix) -> Matrix {\n    assert_matrix_impl(m);\n    let mut t = zero_matrix_impl(m.cols, m.rows);\n    let tcols = t.cols;\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            t.data[j * tcols + i] = m.data[i * m.cols + j];\n        }\n    }\n    t\n}\n\npub fn trace_matrix_impl(m: &Matrix) -> f64 {\n    assert!(is_square_matrix_impl(m));\n    let mut trace = 0.0;\n    for i in 0..m.rows {\n        trace += m.data[i * m.cols + i];\n    }\n    trace\n}\n\npub fn add_matrices_impl(m: &Matrix, n: &Matrix) -> Matrix {\n    assert!(has_same_dimensions_impl(m, n));\n    let mut sum = null_matrix_impl(m.rows, m.cols);\n    let mut idx = 0;\n    for _i in 0..m.rows {\n        for _j in 0..m.cols {\n            sum.data[idx] = m.data[idx] + n.data[idx];\n            idx += 1;\n        }\n    }\n    sum\n}\n\npub fn pow_matrix_impl(m: &Matrix, k: f64) -> Matrix {\n    assert_matrix_impl(m);\n    let mut p = null_matrix_impl(m.rows, m.cols);\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            p.data[i * m.cols + j] = m.data[i * m.cols + j].powf(k);\n        }\n    }\n    p\n}\n\npub fn multiply_matrices_impl(m: &Matrix, n: &Matrix) -> Matrix {\n    // Replicates the C signature: requires m->cols == n->cols && m->rows == n->rows\n    assert!(assert_matrix_impl(m) && assert_matrix_impl(n) && m.cols == n.cols && m.rows == n.rows);\n    let mut prod = null_matrix_impl(m.rows, m.cols);\n    for j in 0..m.rows {\n        for i in 0..m.cols {\n            let mut val = 0.0;\n            for k in 0..m.cols {\n                val += m.data[i * m.cols + k] * n.data[k * m.cols + j];\n            }\n            prod.data[i * m.cols + j] = val;\n        }\n    }\n    prod\n}\n\npub fn scale_matrix_impl(m: &Matrix, s: f64) -> Matrix {\n    assert_matrix_impl(m);\n    let mut scaled = null_matrix_impl(m.rows, m.cols);\n    for i in 0..m.rows {\n        for j in 0..m.cols {\n            scaled.data[i * m.cols + j] = m.data[i * m.cols + j] * s;\n        }\n    }\n    scaled\n}\n\npub fn sub_matrix_impl(m: &Matrix, i: usize, j: usize) -> Matrix {\n    assert!(assert_matrix_impl(m) && i < m.rows && j < m.cols);\n    let mut sm = null_matrix_impl(m.rows - 1, m.cols - 1);\n    let mut idx = 0;\n    for row in 0..m.rows {\n        for col in 0..m.cols {\n            if row != i && col != j {\n                sm.data[idx] = m.data[row * m.cols + col];\n                idx += 1;\n            }\n        }\n    }\n    sm\n}\n\npub fn element_minor_impl(m: &Matrix, i: usize, j: usize) -> f64 {\n    let sm = sub_matrix_impl(m, i, j);\n    determinant_impl(&sm)\n}\n\npub fn matrix_minor_impl(m: &Matrix) -> Matrix {\n    assert_matrix_impl(m);\n    let mut mm = null_matrix_impl(m.rows, m.cols);\n    let mmcols = mm.cols;\n    for i in 0..mm.rows {\n        for j in 0..mmcols {\n            mm.data[i * mmcols + j] = element_minor_impl(m, i, j);\n        }\n    }\n    mm\n}\n\npub fn element_cofactor_impl(m: &Matrix, i: usize, j: usize) -> f64 {\n    let sign = (-1f64).powi(((i + 1) + (j + 1)) as i32);\n    sign * element_minor_impl(m, i, j)\n}\n\npub fn matrix_cofactor_impl(m: &Matrix) -> Matrix {\n    assert_matrix_impl(m);\n    let mut cfm = null_matrix_impl(m.rows, m.cols);\n    let cfmcols = cfm.cols;\n    for i in 0..cfm.rows {\n        for j in 0..cfmcols {\n            cfm.data[i * cfmcols + j] = element_cofactor_impl(m, i, j);\n        }\n    }\n    cfm\n}\n\npub fn sign_matrix_impl(rows: usize, cols: usize) -> Matrix {\n    assert!(rows > 0 && cols > 0);\n    let mut sm = null_matrix_impl(rows, cols);\n    fill_matrix_impl(&mut sm, 1.0);\n    let smcols = sm.cols;\n    for i in 0..sm.rows {\n        for j in 0..smcols {\n            // Replicate C: ((i*cols+j)+1) % 2 ? 1 : -1\n            sm.data[i * smcols + j] = if ((i * smcols + j) + 1) % 2 != 0 {\n                1.0\n            } else {\n                -1.0\n            };\n        }\n    }\n    sm\n}\n\npub fn adjugate_matrix_impl(m: &Matrix) -> Matrix {\n    assert_matrix_impl(m);\n    let mm = matrix_minor_impl(m);\n    let sign = sign_matrix_impl(m.rows, m.cols);\n    multiply_matrices_impl(&mm, &sign)\n}\n\npub fn lu_decomposition_impl(m: &Matrix) -> (Matrix, Matrix, Matrix, i32) {\n    assert!(is_square_matrix_impl(m));\n    let n = m.cols;\n    let (p, swaps) = pivot_matrix_impl(m);\n    let mut l = zero_matrix_impl(n, n);\n    let mut u = zero_matrix_impl(n, n);\n    let m2 = multiply_matrices_impl(&p, m);\n    for j in 0..n {\n        l.data[j * n + j] = 1.0;\n        for i in 0..(j + 1) {\n            let mut sum_u = 0.0;\n            for k in 0..i {\n                sum_u += u.data[k * n + j] * l.data[i * n + k];\n            }\n            u.data[i * n + j] = m2.data[i * n + j] - sum_u;\n        }\n        for i in j..n {\n            let mut sum_l = 0.0;\n            for k in 0..j {\n                sum_l += u.data[k * n + j] * l.data[i * n + k];\n            }\n            l.data[i * n + j] = (m2.data[i * n + j] - sum_l) / u.data[j * n + j];\n        }\n    }\n    (l, u, p, swaps)\n}\n\npub fn inverse_matrix_impl(m: &Matrix) -> Matrix {\n    assert!(is_invertible_impl(m));\n    let adj = adjugate_matrix_impl(m);\n    let det = determinant_impl(m);\n    scale_matrix_impl(&adj, 1.0 / det)\n}\n\npub fn pivot_matrix_impl(m: &Matrix) -> (Matrix, i32) {\n    assert!(is_square_matrix_impl(m));\n    let n = m.cols;\n    let mut pivot = identity_matrix_impl(n);\n    let mut swaps = 0i32;\n    for i in 0..n {\n        let mut max = m.data[i * n + i];\n        let mut row = i;\n        for j in i..n {\n            if m.data[j * n + i] > max {\n                max = m.data[j * n + i];\n                row = j;\n            }\n        }\n        if i != row {\n            let v = get_row_vector_impl(&pivot, i);\n            let w = get_row_vector_impl(&pivot, row);\n            set_row_vector_i