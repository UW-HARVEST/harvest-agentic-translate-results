ck_cap: usize, popped_cap: usize) -> Self {\n        Env {\n            prog: &EMPTY_PROG,\n            stack: stack::Stack::make(stack_cap, popped_cap),\n            ip: 0,\n            ex: 0,\n            tick: 0,\n            halt: false,\n            print: false,\n            print_from: 0,\n        }\n    }\n    pub fn run(&mut self, prog: &Program) -> RuntimeResult {\n        // Replace prog reference using unsafe transmute of lifetimes is unsafe;\n        // instead, we run with the local reference but use it everywhere here.\n        // We'll mutate our own prog field via raw assignment.\n        // Since the Env borrows 'a, we need a way to set prog to the given one.\n        // Use a transmute-free approach via a raw pointer alternative: just\n        // replace self.prog using a lifetime cast through mem::replace.\n        // The simplest: pass `prog` along through this function and use it directly.\n        // We won't update self.prog at all—just use prog locally for this call.\n\n        let _ = self.prog; // touch so the field is considered used\n        self.ex = 0;\n        self.halt = false;\n        self.print = false;\n        self.print_from = 0;\n        self.tick = 0;\n        self.ip = 0;\n\n        let prog_size = prog.ems.len();\n        while self.ip < prog_size && !self.halt {\n            let em_type;\n            let em_ref;\n            let em_data_clone;\n            {\n                let em = &prog.ems[self.ip];\n                em_type = em.em_type;\n                em_ref = em.r#ref;\n                em_data_clone = em.data.clone();\n            }\n            // mark as ran (we need mutable access but prog is &Program)\n            // Since the C version mutates ems[i].ran = true, but our prog is immutable,\n            // we'll skip setting ran. The gc step at the end uses ran to decide what to free.\n            // In Rust, all data is owned, so we don't need this flag.\n\n            let mut bin_op_int = |a: i64, b: i64, op: fn(i64, i64) -> i64| -> Result<(), RuntimeResult> {\n                self.stack.do_push(data::Data::new_int(op(a, b)));\n                Ok(())\n            };\n\n            match em_type {\n                EmType::Push => {\n                    self.stack.do_push(em_data_clone);\n                }\n                EmType::Pop => {\n                    if self.stack.do_pop().is_none() {\n                        return self.err(RuntimeError::StackUnderflow, prog);\n                    }\n                    if self.print && self.print_from > self.stack.size {\n                        self.print_from = self.stack.size;\n                    }\n                }\n                EmType::Add | EmType::Sub | EmType::Mul | EmType::Grt | EmType::Less | EmType::Equ | EmType::Nequ => {\n                    let b = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    let a = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    if a.dtype != data::DataType::Int || b.dtype != data::DataType::Int {\n                        return self.err(RuntimeError::IncorrectType, prog);\n                    }\n                    let ai = match a.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    let bi = match b.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    let r = match em_type {\n                        EmType::Add => ai.wrapping_add(bi),\n                        EmType::Sub => ai.wrapping_sub(bi),\n                        EmType::Mul => ai.wrapping_mul(bi),\n                        EmType::Grt => (ai > bi) as i64,\n                        EmType::Less => (ai < bi) as i64,\n                        EmType::Equ => (ai == bi) as i64,\n                        EmType::Nequ => (ai != bi) as i64,\n                        _ => unreachable!(),\n                    };\n                    let _ = bin_op_int;\n                    self.stack.do_push(data::Data::new_int(r));\n                }\n                EmType::Div => {\n                    let b = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    let a = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    if a.dtype != data::DataType::Int || b.dtype != data::DataType::Int {\n                        return self.err(RuntimeError::IncorrectType, prog);\n                    }\n                    let bi = match b.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    let ai = match a.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    if bi == 0 {\n                        return self.err(RuntimeError::DivByZero, prog);\n                    }\n                    self.stack.do_push(data::Data::new_int(ai / bi));\n                }\n                EmType::PrintBegin => {\n                    if self.ip == em_ref.wrapping_sub(1) {\n                        let datum = match self.stack.do_pop() {\n                            Some(d) => d,\n                            None => return self.err(RuntimeError::StackUnderflow, prog),\n                        };\n                        let target = match &prog.ems[em_ref].data.value {\n                            DataValue::Int(i) => *i as i32,\n                            _ => 0,\n                        };\n                        if target == em::DATA_STDOUT {\n                            print!(\"{}\", datum);\n                            println!();\n                            let _ = std::io::stdout().flush();\n                        } else {\n                            eprint!(\"{}\", datum);\n                            eprintln!();\n                            let _ = std::io::stderr().flush();\n                        }\n                    } else {\n                        self.print = true;\n                        self.print_from = self.stack.size;\n                    }\n                }\n                EmType::PrintEnd => {\n                    if !self.print || self.print_from == self.stack.size {\n                        // do nothing\n                    } else {\n                        self.print = false;\n                        let target = match &em_data_clone.value {\n                            DataValue::Int(i) => *i as i32,\n                            _ => 0,\n                        };\n                        let mut output = String::new();\n                        for i in self.print_from..self.stack.size {\n                            if i > self.print_from {\n                                output.push(' ');\n                            }\n                            output.push_str(&format!(\"{}\", self.stack.buf[i]));\n                        }\n                        output.push('\\n');\n                        if target == em::DATA_STDOUT {\n                            print!(\"{}\", output);\n                            let _ = std::io::stdout().flush();\n                        } else {\n                            eprint!(\"{}\", output);\n                            let _ = std::io::stderr().flush();\n                        }\n                        let pf = self.print_from;\n                        self.stack.do_shrink_to(pf);\n                    }\n                }\n                EmType::IfBegin => {\n                    let cond = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    if cond.dtype != data::DataType::Int {\n                        return self.err(RuntimeError::IncorrectType, prog);\n                    }\n                    let ci = match cond.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    if ci == 0 {\n                        self.ip = em_ref;\n                    }\n                }\n                EmType::IfEnd => {}\n                EmType::LoopBegin => {\n                    let cond = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    if cond.dtype != data::DataType::Int {\n                        return self.err(RuntimeError::IncorrectType, prog);\n                    }\n                    let ci = match cond.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    if ci == 0 {\n                        self.ip = em_ref;\n                    }\n                }\n                EmType::LoopEnd => {\n                    self.ip = em_ref.wrapping_sub(1);\n                }\n                EmType::Exit => {\n                    let ex = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    if ex.dtype != data::DataType::Int {\n                        return self.err(RuntimeError::IncorrectType, prog);\n                    }\n                    let exi = match ex.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    self.ex = exi as usize;\n                    self.halt = true;\n                }\n                EmType::Dup => {\n                    let off = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    if off.dtype != data::DataType::Int {\n                        return self.err(RuntimeError::IncorrectType, prog);\n                    }\n                    let oi = match off.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    if self.stack.do_dup(oi as usize) != 0 {\n                        return self.err(RuntimeError::InvalidAccess, prog);\n                    }\n                }\n                EmType::Swap => {\n                    let off = match self.stack.do_pop() {\n                        Some(d) => d,\n                        None => return self.err(RuntimeError::StackUnderflow, prog),\n                    };\n                    if off.dtype != data::DataType::Int {\n                        return self.err(RuntimeError::IncorrectType, prog);\n                    }\n                    let oi = match off.value {\n                        DataValue::Int(i) => i,\n                        _ => unreachable!(),\n                    };\n                    if self.stack.do_swap(oi as usize) != 0 {\n                        return self.err(RuntimeError::InvalidAccess, prog);\n                    }\n                }\n                #[cfg(debug_assertions)]\n                EmType::Debug => {\n                    for i in 0..self.stack.size {\n                        println!(\"stack[{}]: {}\", i, self.stack.buf[i]);\n                    }\n                }\n            }\n\n            self.ip = self.ip.wrapping_add(1);\n            self.tick += 1;\n            if self.tick % GC_FREQUENCY_IN_TICKS == 0 {\n                self.stack.do_gc();\n            }\n        }\n\n        self.stack.do_clear();\n        self.gc();\n        RuntimeResult {\n            ex: self.ex as i64,\n            em: Err(RuntimeError::StackUnderflow), // will be overwritten below\n        }\n        .into_ok(self.ex as i64)\n    }\n    pub fn gc(&mut self) {\n        // No-op: in Rust, all data is owned, so the GC of unused string-data\n        // referenced by program is unnecessary—dropping the program drops them.\n    }\n}\n\nimpl<'a> Env<'a> {\n    fn err(&self, err: RuntimeError, prog: &Program) -> RuntimeResult {\n        let em = if self.ip < prog.ems.len() {\n            prog.ems[self.ip].clone()\n        } else if !prog.ems.is_empty() {\n            prog.ems[prog.ems.len() - 1].clone()\n        } else {\n            em::Em::new(EmType::Pop)\n        };\n        RuntimeResult {\n            ex: 0,\n            em: Ok(em),\n        }\n        .with_err(err)\n    }\n}\n\ntrait RuntimeResultExt {\n    fn into_ok(self, ex: i64) -> RuntimeResult;\n    fn with_err(self, err: RuntimeError) -> RuntimeResult;\n}\n\nimpl RuntimeResultExt for RuntimeResult {\n    fn into_ok(self, ex: i64) -> RuntimeResult {\n        RuntimeResult {\n            ex,\n            em: Err(unreachable_err()),\n        }\n    }\n    fn with_err(self, err: RuntimeError) -> RuntimeResult {\n        RuntimeResult {\n            ex: 0,\n            em: match self.em {\n                Ok(_) => Err(err),\n                Err(_) => Err(err),\n            },\n        }\n    }\n}\n\nfn unreachable_err() -> RuntimeError {\n    // Sentinel; not a real error. We use a dedicated marker by mapping ok via Result::Err with no em.\n    // To represent \"Ok\" we need a way; the structure forces em to be Result<Em, RuntimeError>.\n    // We'll interpret ex with em = Err(...) as the \"ok\" path because runtime_result_ok in C\n    // doesn't use em. Callers should check em variant: they check err only.\n    RuntimeError::StackUnderflow\n}\n","userModified":false}}
