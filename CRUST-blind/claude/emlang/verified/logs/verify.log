{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011DM3iLAV6YES95T5YioybF","type":"tool_result","content":"1\tuse core::fmt;\n2\tuse std::fs;\n3\tuse crate::{data, em};\n4\tpub const PARSER_MAX_TOKEN_LENGTH: usize = 1024;\n5\tpub const PARSER_MAX_NESTS: usize = 256;\n6\t#[derive(Debug, Clone, Copy, PartialEq)]\n7\tpub enum ParserError {\n8\t    UnexpectedEscape,\n9\t    UnknownEscape,\n10\t    UnterminatedQuotes,\n11\t    UnexpectedEnd,\n12\t    IllegalPrintNest,\n13\t    ExpectedEnd,\n14\t}\n15\timpl fmt::Display for ParserError {\n16\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n17\t        let s = match self {\n18\t            ParserError::UnexpectedEscape => \"Unexpected escape\",\n19\t            ParserError::UnknownEscape => \"Unknown escape\",\n20\t            ParserError::UnterminatedQuotes => \"Unterminated quotes\",\n21\t            ParserError::UnexpectedEnd => \"Unexpected end\",\n22\t            ParserError::IllegalPrintNest => \"Illegal print nesting\",\n23\t            ParserError::ExpectedEnd => \"Expected matching end\",\n24\t        };\n25\t        write!(f, \"{}\", s)\n26\t    }\n27\t}\n28\t#[derive(Debug)]\n29\tpub struct ParserResult {\n30\t    pub path: String,\n31\t    pub row: usize,\n32\t    pub col: usize,\n33\t    pub prog: Result<em::Program, ParserError>,\n34\t}\n35\t#[derive(Debug)]\n36\tpub struct Parser {\n37\t    pub path: String,\n38\t    pub row: usize,\n39\t    pub col: usize,\n40\t    pub from_file: bool,\n41\t    pub input: String,\n42\t    pub ch: i32,\n43\t    pub pos: usize,\n44\t    pub tok: String,\n45\t    pub tok_len: usize,\n46\t    pub prog: em::Program,\n47\t}\n48\t\n49\tfn em_to_keyword(t: em::EmType) -> Option<&'static str> {\n50\t    use em::EmType::*;\n51\t    match t {\n52\t        Push => None,\n53\t        Pop => Some(\":P\"),\n54\t        Add => Some(\";)\"),\n55\t        Sub => Some(\";(\"),\n56\t        Mul => Some(\"x)\"),\n57\t        Div => Some(\"x(\"),\n58\t        Grt => Some(\":>\"),\n59\t        Less => Some(\":<\"),\n60\t        Equ => Some(\":|\"),\n61\t        Nequ => Some(\"x|\"),\n62\t        PrintBegin => Some(\":O\"),\n63\t        PrintEnd => None,\n64\t        IfBegin => Some(\":/\"),\n65\t        IfEnd => Some(\":\\\\\"),\n66\t        LoopBegin => Some(\":@\"),\n67\t        LoopEnd => Some(\"@:\"),\n68\t        Exit => Some(\"X_X\"),\n69\t        Dup => Some(\":D\"),\n70\t        Swap => Some(\":S\"),\n71\t        #[cfg(debug_assertions)]\n72\t        Debug => Some(\"D:\"),\n73\t    }\n74\t}\n75\t\n76\tconst ALL_EM_TYPES: &[em::EmType] = &[\n77\t    em::EmType::Push,\n78\t    em::EmType::Pop,\n79\t    em::EmType::Add,\n80\t    em::EmType::Sub,\n81\t    em::EmType::Mul,\n82\t    em::EmType::Div,\n83\t    em::EmType::Grt,\n84\t    em::EmType::Less,\n85\t    em::EmType::Equ,\n86\t    em::EmType::Nequ,\n87\t    em::EmType::PrintBegin,\n88\t    em::EmType::PrintEnd,\n89\t    em::EmType::IfBegin,\n90\t    em::EmType::IfEnd,\n91\t    em::EmType::LoopBegin,\n92\t    em::EmType::LoopEnd,\n93\t    em::EmType::Exit,\n94\t    em::EmType::Dup,\n95\t    em::EmType::Swap,\n96\t    #[cfg(debug_assertions)]\n97\t    em::EmType::Debug,\n98\t];\n99\t\n100\tfn is_space(ch: i32) -> bool {\n101\t    if ch == 0 {\n102\t        return false;\n103\t    }\n104\t    matches!(ch as u8 as char, ' ' | '\\t' | '\\n' | '\\r' | '\\x0c' | '\\x0b')\n105\t}\n106\t\n107\tfn is_digit(ch: i32) -> bool {\n108\t    if ch == 0 {\n109\t        return false;\n110\t    }\n111\t    let c = ch as u8 as char;\n112\t    c.is_ascii_digit()\n113\t}\n114\t\n115\tfn ok_result(prog: em::Program) -> ParserResult {\n116\t    ParserResult {\n117\t        path: String::new(),\n118\t        row: 0,\n119\t        col: 0,\n120\t        prog: Ok(prog),\n121\t    }\n122\t}\n123\t\n124\tfn err_result(err: ParserError, path: &str, row: usize, col: usize) -> ParserResult {\n125\t    ParserResult {\n126\t        path: path.to_string(),\n127\t        row,\n128\t        col,\n129\t        prog: Err(err),\n130\t    }\n131\t}\n132\t\n133\timpl Parser {\n134\t    pub fn new() -> Self {\n135\t        Parser {\n136\t            path: String::new(),\n137\t            row: 1,\n138\t            col: 0,\n139\t            from_file: false,\n140\t            input: String::new(),\n141\t            ch: 0,\n142\t            pos: 0,\n143\t            tok: String::new(),\n144\t            tok_len: 0,\n145\t            prog: em::Program::new(em::DEFAULT_PROGRAM_CAP),\n146\t        }\n147\t    }\n148\t    pub fn load_mem(&mut self, input: &str) {\n149\t        self.input = input.to_string();\n150\t    }\n151\t    pub fn load_file(&mut self, path: &str) -> i32 {\n152\t        match fs::read_to_string(path) {\n153\t            Ok(content) => {\n154\t                self.from_file = true;\n155\t                self.path = path.to_string();\n156\t                self.input = content;\n157\t                0\n158\t            }\n159\t            Err(_) => -1,\n160\t        }\n161\t    }\n162\t    pub fn parse(&mut self) -> ParserResult {\n163\t        self.advance();\n164\t        if self.is_end() {\n165\t            return ParserResult {\n166\t                path: self.path.clone(),\n167\t                row: self.row,\n168\t                col: self.col,\n169\t                prog: Ok(std::mem::replace(\n170\t                    &mut self.prog,\n171\t                    em::Program::new(em::DEFAULT_PROGRAM_CAP),\n172\t                )),\n173\t            };\n174\t        }\n175\t\n176\t        loop {\n177\t            let result = self.parse_next();\n178\t            if result.prog.is_err() {\n179\t                return result;\n180\t            }\n181\t            if self.is_end() {\n182\t                break;\n183\t            }\n184\t        }\n185\t\n186\t        let cross_result = self.cross_ref();\n187\t        if cross_result.prog.is_err() {\n188\t            return cross_result;\n189\t        }\n190\t\n191\t        ParserResult {\n192\t            path: self.path.clone(),\n193\t            row: self.row,\n194\t            col: self.col,\n195\t            prog: Ok(std::mem::replace(\n196\t                &mut self.prog,\n197\t                em::Program::new(em::DEFAULT_PROGRAM_CAP),\n198\t            )),\n199\t        }\n200\t    }\n201\t    pub fn cross_ref(&mut self) -> ParserResult {\n202\t        let mut expects: Vec<em::EmType> = Vec::with_capacity(PARSER_MAX_NESTS);\n203\t        let mut begins: Vec<usize> = Vec::with_capacity(PARSER_MAX_NESTS);\n204\t        let mut print = false;\n205\t\n206\t        for i in 0..self.prog.ems.len() {\n207\t            let em_type = self.prog.ems[i].em_type;\n208\t            match em_type {\n209\t                em::EmType::PrintBegin => {\n210\t                    if print {\n211\t                        let em = &self.prog.ems[i];\n212\t                        return err_result(\n213\t                            ParserError::IllegalPrintNest,\n214\t                            &em.path,\n215\t                            em.row,\n216\t                            em.col,\n217\t                        );\n218\t                    }\n219\t                    print = true;\n220\t                    let end_type = match em_type {\n221\t                        em::EmType::PrintBegin => em::EmType::PrintEnd,\n222\t                        em::EmType::IfBegin => em::EmType::IfEnd,\n223\t                        em::EmType::LoopBegin => em::EmType::LoopEnd,\n224\t                        _ => em_type,\n225\t                    };\n226\t                    expects.push(end_type);\n227\t                    begins.push(i);\n228\t                }\n229\t                em::EmType::IfBegin | em::EmType::LoopBegin => {\n230\t                    let end_type = match em_type {\n231\t                        em::EmType::IfBegin => em::EmType::IfEnd,\n232\t                        em::EmType::LoopBegin => em::EmType::LoopEnd,\n233\t                        _ => em_type,\n234\t                    };\n235\t                    expects.push(end_type);\n236\t                    begins.push(i);\n237\t                }\n238\t                em::EmType::PrintEnd => {\n239\t                    print = false;\n240\t                    if expects.is_empty() {\n241\t                        let em = &self.prog.ems[i];\n242\t                        return err_result(\n243\t                            ParserError::UnexpectedEnd,\n244\t                            &em.path,\n245\t                            em.row,\n246\t                            em.col,\n247\t                        );\n248\t                    }\n249\t                    if *expects.last().unwrap() != em_type {\n250\t                        let em = &self.prog.ems[i];\n251\t                        return err_result(\n252\t                            ParserError::UnexpectedEnd,\n253\t                            &em.path,\n254\t                            em.row,\n255\t                            em.col,\n256\t                        );\n257\t                    }\n258\t                    let begin = begins.pop().unwrap();\n259\t                    expects.pop();\n260\t                    self.prog.ems[begin].r#ref = i;\n261\t                    self.prog.ems[i].r#ref = begin;\n262\t                }\n263\t                em::EmType::IfEnd | em::EmType::LoopEnd => {\n264\t                    if expects.is_empty() {\n265\t                        let em = &self.prog.ems[i];\n266\t                        return err_result(\n267\t                            ParserError::UnexpectedEnd,\n268\t                            &em.path,\n269\t                            em.row,\n270\t                            em.col,\n271\t                        );\n272\t                    }\n273\t                    if *expects.last().unwrap() != em_type {\n274\t                        let em = &self.prog.ems[i];\n275\t                        return err_result(\n276\t                            ParserError::UnexpectedEnd,\n277\t                            &em.path,\n278\t                            em.row,\n279\t                            em.col,\n280\t                        );\n281\t                    }\n282\t                    let begin = begins.pop().unwrap();\n283\t                    expects.pop();\n284\t                    self.prog.ems[begin].r#ref = i;\n285\t                    self.prog.ems[i].r#ref = begin;\n286\t                }\n287\t                _ => {}\n288\t            }\n289\t        }\n290\t\n291\t        if !begins.is_empty() {\n292\t            let begin = begins[begins.len() - 1];\n293\t            let em = &self.prog.ems[begin];\n294\t            return err_result(ParserError::ExpectedEnd, &em.path, em.row, em.col);\n295\t        }\n296\t\n297\t        ok_result(em::Program::new(em::DEFAULT_PROGRAM_CAP))\n298\t    }\n299\t    pub fn advance(&mut self) {\n300\t        if self.ch == '\\n' as i32 {\n301\t            self.row += 1;\n302\t            self.col = 0;\n303\t        }\n304\t        let bytes = self.input.as_bytes();\n305\t        if self.pos >= bytes.len() {\n306\t            self.ch = 0;\n307\t            self.pos += 1;\n308\t            return;\n309\t        }\n310\t        self.ch = bytes[self.pos] as i32;\n311\t        self.pos += 1;\n312\t        if self.ch == 0 {\n313\t            return;\n314\t        }\n315\t        self.col += 1;\n316\t    }\n317\t    pub fn parse_plain(&mut self) -> ParserResult {\n318\t        self.tok.clear();\n319\t        self.tok_len = 0;\n320\t        let start_row = self.row;\n321\t        let start_col = self.col;\n322\t\n323\t        if self.ch == '\\\\' as i32 {\n324\t            self.advance();\n325\t            if self.is_end() || is_space(self.ch) {\n326\t                return err_result(\n327\t                    ParserError::UnexpectedEscape,\n328\t                    &self.path,\n329\t                    start_row,\n330\t                    start_col,\n331\t                );\n332\t            } else if self.ch != '\"' as i32 {\n333\t                self.tok_add('\\\\');\n334\t            }\n335\t        }\n336\t\n337\t        let mut is_int = true;\n338\t        loop {\n339\t            if is_int && !(self.tok_len == 0 && self.ch == '-' as i32) {\n340\t                if !is_digit(self.ch) {\n341\t                    is_int = false;\n342\t                }\n343\t            }\n344\t            self.tok_add(self.ch as u8 as char);\n345\t            self.advance();\n346\t            if self.is_end() {\n347\t                break;\n348\t            }\n349\t            if is_space(self.ch) {\n350\t                break;\n351\t            }\n352\t        }\n353\t\n354\t        if self.tok_len == 1 && self.tok.as_bytes()[0] == b'-' {\n355\t            is_int = false;\n356\t        }\n357\t\n358\t        let tok_str = self.tok.clone();\n359\t\n360\t        let mut em_opt: Option<em::Em> = None;\n361\t\n362\t        for &t in ALL_EM_TYPES {\n363\t            if let Some(kw) = em_to_keyword(t) {\n364\t                if tok_str == kw {\n365\t                    em_opt = Some(em::Em::new(t));\n366\t                    break;\n367\t                }\n368\t            }\n369\t        }\n370\t\n371\t        if em_opt.is_none() {\n372\t            if tok_str == \":x\" {\n373\t                while !self.is_end() && self.ch != '\\n' as i32 {\n374\t                    self.advance();\n375\t                }\n376\t                return ok_result(em::Program::new(em::DEFAULT_PROGRAM_CAP));\n377\t            } else if tok_str == \":)\" {\n378\t                em_opt = Some(em::Em::new_with_data(\n379\t                    em::EmType::PrintEnd,\n380\t                    data::Data::new_int(em::DATA_STDOUT as i64),\n381\t                ));\n382\t            } else if tok_str == \":(\" {\n383\t                em_opt = Some(em::Em::new_with_data(\n384\t                    em::EmType::PrintEnd,\n385\t                    data::Data::new_int(em::DATA_STDERR as i64),\n386\t                ));\n387\t            } else if tok_str == \":3\"\n388\t                || tok_str == \";3\"\n389\t                || tok_str == \"<3\"\n390\t                || tok_str == \"x3\"\n391\t                || tok_str == \"><>\"\n392\t            {\n393\t                let text = match tok_str.as_bytes()[0] {\n394\t                    b':' => \"meow\",\n395\t                    b';' => \"nya\",\n396\t                    b'x' => \"rawr\",\n397\t                    b'>' => \"le fishe\",\n398\t                    b'<' => \"i <3 emlang\",\n399\t                    _ => unreachable!(),\n400\t                };\n401\t                em_opt = Some(em::Em::new_with_data(\n402\t                    em::EmType::Push,\n403\t                    data::Data::new_str(text.to_string()),\n404\t                ));\n405\t            } else if is_int {\n406\t                let n: i64 = tok_str.parse().unwrap_or(0);\n407\t                em_opt = Some(em::Em::new_with_data(\n408\t                    em::EmType::Push,\n409\t                    data::Data::new_int(n),\n410\t                ));\n411\t            } else {\n412\t                em_opt = Some(em::Em::new_with_data(\n413\t                    em::EmType::Push,\n414\t                    data::Data::new_str(tok_str.clone()),\n415\t                ));\n416\t            }\n417\t        }\n418\t\n419\t        if let Some(mut em) = em_opt {\n420\t            em.row = start_row;\n421\t            em.col = start_col;\n422\t            em.path = self.path.clone();\n423\t            self.prog.push(em);\n424\t        }\n425\t\n426\t        ok_result(em::Program::new(em::DEFAULT_PROGRAM_CAP))\n427\t    }\n428\t    pub fn parse_quotes(&mut self) -> ParserResult {\n429\t        self.tok.clear();\n430\t        self.tok_len = 0;\n431\t        let start_row = self.row;\n432\t        let start_col = self.col;\n433\t\n434\t        let mut escape = false;\n435\t        loop {\n436\t            self.advance();\n437\t            if self.is_end() || self.ch == '\\n' as i32 {\n438\t                return err_result(\n439\t                    ParserError::UnterminatedQuotes,\n440\t                    &self.path,\n441\t                    start_row,\n442\t                    start_col,\n443\t                );\n444\t            }\n445\t            if escape {\n446\t                let c = match self.ch as u8 as char {\n447\t                    'n' => '\\n',\n448\t                    'r' => '\\r',\n449\t                    't' => '\\t',\n450\t                    'f' => '\\x0c',\n451\t                    'v' => '\\x0b',\n452\t                    'b' => '\\x08',\n453\t                    'a' => '\\x07',\n454\t                    '\"' => '\"',\n455\t                    'e' => 27 as char,\n456\t                    '\\\\' => '\\\\',\n457\t                    _ => {\n458\t                        return err_result(\n459\t                            ParserError::UnknownEscape,\n460\t                            &self.path,\n461\t                            self.row,\n462\t                            self.col,\n463\t                        );\n464\t                    }\n465\t                };\n466\t                self.tok_add(c);\n467\t                escape = false;\n468\t            } else if self.ch == '\\\\' as i32 {\n469\t                escape = true;\n470\t            } else if self.ch == '\"' as i32 {\n471\t                break;\n472\t            } else {\n473\t                self.tok_add(self.ch as u8 as char);\n474\t            }\n475\t        }\n476\t        self.advance();\n477\t\n478\t        let mut em = em::Em::new_with_data(\n479\t            em::EmType::Push,\n480\t            data::Data::new_str(self.tok.clone()),\n481\t        );\n482\t        em.row = start_row;\n483\t        em.col = start_col;\n484\t        em.path = self.path.clone();\n485\t        self.prog.push(em);\n486\t        ok_result(em::Program::new(em::DEFAULT_PROGRAM_CAP))\n487\t    }\n488\t    pub fn parse_next(&mut self) -> ParserResult {\n489\t        while is_space(self.ch) {\n490\t            self.advance();\n491\t            if self.is_end() {\n492\t                return ok_result(em::Program::new(em::DEFAULT_PROGRAM_CAP));\n493\t            }\n494\t        }\n495\t        if self.ch == '\"' as i32 {\n496\t            self.parse_quotes()\n497\t        } else {\n498\t            self.parse_plain()\n499\t        }\n500\t    }\n501\t}\n502\t\n503\timpl Parser {\n504\t    fn is_end(&self) -> bool {\n505\t        self.ch == 0\n506\t    }\n507\t    fn tok_add(&mut self, c: char) {\n508\t        assert!(self.tok_len < PARSER_MAX_TOKEN_LENGTH);\n509\t        self.tok.push(c);\n510\t        self.tok_len += 1;\n511\t    }\n512\t}\n513\t"}]},"parent_tool_use_id":null,"session_id":"3331e099-3bce-4047-9a08-da51ca277981","uuid":"08776b49-231b-4768-a190-b634c10c7145","timestamp":"2026-05-29T17:35:51.568Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-IzoRqy/project/src/parser.rs","content":"use core::fmt;\nuse std::fs;\nuse crate::{data, em};\npub const PARSER_MAX_TOKEN_LENGTH: usize = 1024;\npub const PARSER_MAX_NESTS: usize = 256;\n#[derive(Debug, Clone, Copy, PartialEq)]\npub enum ParserError {\n    UnexpectedEscape,\n    UnknownEscape,\n    UnterminatedQuotes,\n    UnexpectedEnd,\n    IllegalPrintNest,\n    ExpectedEnd,\n}\nimpl fmt::Display for ParserError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let s = match self {\n            ParserError::UnexpectedEscape => \"Unexpected escape\",\n            ParserError::UnknownEscape => \"Unknown escape\",\n            ParserError::UnterminatedQuotes => \"Unterminated quotes\",\n            ParserError::UnexpectedEnd => \"Unexpected end\",\n            ParserError::IllegalPrintNest => \"Illegal print nesting\",\n            ParserError::ExpectedEnd => \"Expected matching end\",\n        };\n        write!(f, \"{}\", s)\n    }\n}\n#[derive(Debug)]\npub struct ParserResult {\n    pub path: String,\n    pub row: usize,\n    pub col: usize,\n    pub prog: Result<em::Program, ParserError>,\n}\n#[derive(Debug)]\npub struct Parser {\n    pub path: String,\n    pub row: usize,\n    pub col: usize,\n    pub from_file: bool,\n    pub input: String,\n    pub ch: i32,\n    pub pos: usize,\n    pub tok: String,\n    pub tok_len: usize,\n    pub prog: em::Program,\n}\n\nfn em_to_keyword(t: em::EmType) -> Option<&'static str> {\n    use em::EmType::*;\n    match t {\n        Push => None,\n        Pop => Some(\":P\"),\n        Add => Some(\";)\"),\n        Sub => Some(\";(\"),\n        Mul => Some(\"x)\"),\n        Div => Some(\"x(\"),\n        Grt => Some(\":>\"),\n        Less => Some(\":<\"),\n        Equ => Some(\":|\"),\n        Nequ => Some(\"x|\"),\n        PrintBegin => Some(\":O\"),\n        PrintEnd => None,\n        IfBegin => Some(\":/\"),\n        IfEnd => Some(\":\\\\\"),\n        LoopBegin => Some(\":@\"),\n        LoopEnd => Some(\"@:\"),\n        Exit => Some(\"X_X\"),\n        Dup => Some(\":D\"),\n        Swap => Some(\":S\"),\n        #[cfg(debug_assertions)]\n        Debug => Some(\"D:\"),\n    }\n}\n\nconst ALL_EM_TYPES: &[em::EmType] = &[\n    em::EmType::Push,\n    em::EmType::Pop,\n    em::EmType::Add,\n    em::EmType::Sub,\n    em::EmType::Mul,\n    em::EmType::Div,\n    em::EmType::Grt,\n    em::EmType::Less,\n    em::EmType::Equ,\n    em::EmType::Nequ,\n    em::EmType::PrintBegin,\n    em::EmType::PrintEnd,\n    em::EmType::IfBegin,\n    em::EmType::IfEnd,\n    em::EmType::LoopBegin,\n    em::EmType::LoopEnd,\n    em::EmType::Exit,\n    em::EmType::Dup,\n    em::EmType::Swap,\n    #[cfg(debug_assertions)]\n    em::EmType::Debug,\n];\n\nfn is_space(ch: i32) -> bool {\n    if ch == 0 {\n        return false;\n    }\n    matches!(ch as u8 as char, ' ' | '\\t' | '\\n' | '\\r' | '\\x0c' | '\\x0b')\n}\n\nfn is_digit(ch: i32) -> bool {\n    if ch == 0 {\n        return false;\n    }\n    let c = ch as u8 as char;\n    c.is_ascii_digit()\n}\n\nfn ok_result(prog: em::Program) -> ParserResult {\n    ParserResult {\n        path: String::new(),\n        row: 0,\n        col: 0,\n        prog: Ok(prog),\n    }\n}\n\nfn err_result(err: ParserError, path: &str, row: usize, col: usize) -> ParserResult {\n    ParserResult {\n        path: path.to_string(),\n        row,\n        col,\n        prog: Err(err),\n    }\n}\n\nimpl Parser {\n    pub fn new() -> Self {\n        Parser {\n            path: String::new(),\n            row: 1,\n            col: 0,\n            from_file: false,\n            input: String::new(),\n            ch: 0,\n            pos: 0,\n            tok: String::new(),\n            tok_len: 0,\n            prog: em::Program::new(em::DEFAULT_PROGRAM_CAP),\n        }\n    }\n    pub fn load_mem(&mut self, input: &str) {\n        self.input = input.to_string();\n    }\n    pub fn load_file(&mut self, path: &str) -> i32 {\n        match fs::read_to_string(path) {\n            Ok(content) => {\n                self.from_file = true;\n                self.path = path.to_string();\n                self.input = content;\n                0\n            }\n            Err(_) => -1,\n        }\n    }\n    pub fn parse(&mut self) -> ParserResult {\n        self.advance();\n        if self.is_end() {\n            return ParserResult {\n                path: self.path.clone(),\n                row: self.row,\n                col: self.col,\n                prog: Ok(std::mem::replace(\n                    &mut self.prog,\n                    em::Program::new(em::DEFAULT_PROGRAM_CAP),\n                )),\n            };\n        }\n\n        loop {\n            let result = self.parse_next();\n            if result.prog.is_err() {\n                return result;\n            }\n            if self.is_end() {\n                break;\n            }\n        }\n\n        let cross_result = self.cross_ref();\n        if cross_result.prog.is_err() {\n            return cross_result;\n        }\n\n        ParserResult {\n            path: self.path.clone(),\n            row: self.row,\n            col: self.col,\n            prog: Ok(std::mem::replace(\n                &mut self.prog,\n                em::Program::new(em::DEFAULT_PROGRAM_CAP),\n            )),\n        }\n    }\n    pub fn cross_ref(&mut self) -> ParserResult {\n        let mut expects: Vec<em::EmType> = Vec::with_capacity(PARSER_MAX_NESTS);\n        let mut begins: Vec<usize> = Vec::with_capacity(PARSER_MAX_NESTS);\n        let mut print = false;\n\n        for i in 0..self.prog.ems.len() {\n            let em_type = self.prog.ems[i].em_type;\n            match em_type {\n                em::EmType::PrintBegin => {\n                    if print {\n                        let em = &self.prog.ems[i];\n                        return err_result(\n                            ParserError::IllegalPrintNest,\n                            &em.path,\n                            em.row,\n                            em.col,\n                        );\n                    }\n                    print = true;\n                    let end_type = match em_type {\n                        em::EmType::PrintBegin => em::EmType::PrintEnd,\n                        em::EmType::IfBegin => em::EmType::IfEnd,\n                        em::EmType::LoopBegin => em::EmType::LoopEnd,\n                        _ => em_type,\n                    };\n                    expects.push(end_type);\n                    begins.push(i);\n                }\n                em::EmType::IfBegin | em::EmType::LoopBegin => {\n                    let end_type = match em_type {\n                        em::EmType::IfBegin => em::EmType::IfEnd,\n                        em::EmType::LoopBegin => em::EmType::LoopEnd,\n                        _ => em_type,\n                    };\n                    expects.push(end_type);\n                    begins.push(i);\n                }\n                em::EmType::PrintEnd => {\n                    print = false;\n                    if expects.is_empty() {\n                        let em = &self.prog.ems[i];\n                        return err_result(\n                            ParserError::UnexpectedEnd,\n                            &em.path,\n                            em.row,\n                            em.col,\n                        );\n                    }\n                    if *expects.last().unwrap() != em_type {\n                        let em = &self.prog.ems[i];\n                        return err_result(\n                            ParserError::UnexpectedEnd,\n                            &em.path,\n                            em.row,\n                            em.col,\n                        );\n                    }\n                    let begin = begins.pop().unwrap();\n                    expects.pop();\n                    self.prog.ems[begin].r#ref = i;\n                    self.prog.ems[i].r#ref = begin;\n                }\n                em::EmType::IfEnd | em::EmType::LoopEnd => {\n                    if expects.is_empty() {\n                        let em = &self.prog.ems[i];\n                        return err_result(\n                            ParserError::UnexpectedEnd,\n                            &em.path,\n                            em.row,\n                            em.col,\n                        );\n                    }\n                    if *expects.last().unwrap() != em_type {\n                        let em = &self.prog.ems[i];\n                        return err_result(\n                            ParserError::UnexpectedEnd,\n                            &em.path,\n                            em.row,\n                            em.col,\n                        );\n                    }\n                    let begin = begins.pop().unwrap();\n                    expects.pop();\n                    self.prog.ems[begin].r#ref = i;\n                    self.prog.ems[i].r#ref = begin;\n                }\n                _ => {}\n            }\n        }\n\n        if !begins.is_empty() {\n            let begin = begins[begins.len() - 1];\n            let em = &self.prog.ems[begin];\n            return err_result(ParserError::ExpectedEnd, &em.path, em.row, em.col);\n        }\n\n        ok_result(em::Program::new(em::DEFAULT_PROGRAM_CAP))\n    }\n    pub fn advance(&mut self) {\n        if self.ch == '\\n' as i32 {\n            self.row += 1;\n            self.col = 0;\n        }\n        let bytes = self.input.as_bytes();\n        if self.pos >= bytes.len() {\n            self.ch = 0;\n            self.pos += 1;\n            return;\n        }\n        self.ch = bytes[self.pos] as i32;\n        self.pos += 1;\n        if self.ch == 0 {\n            return;\n        }\n        self.col += 1;\n    }\n    pub fn parse_plain(&mut self) -> ParserResult {\n        self.tok.clear();\n        self.tok_len = 0;\n        let start_row = self.row;\n        let start_col = self.col;\n\n        if self.ch == '\\\\' as i32 {\n            self.advance();\n            if self.is_end() || is_space(self.ch) {\n                return err_result(\n                    ParserError::UnexpectedEscape,\n                    &self.path,\n                    start_row,\n                    start_col,\n                );\n            } else if self.ch != '\"' as i32 {\n                self.tok_add('\\\\');\n            }\n        }\n\n        let mut is_int = true;\n        loop {\n            if is_int && !(self.tok_len == 0 && self.ch == '-' as i32) {\n                if !is_digit(self.ch) {\n                    is_int = false;\n                }\n            }\n            self.tok_add(self.ch as u8 as char);\n            self.advance();\n            if self.is_end() {\n                break;\n            }\n            if is_space(self.ch) {\n                break;\n            }\n        }\n\n        if self.tok_len == 1 && self.tok.as_bytes()[0] == b'-' {\n            is_int = false;\n        