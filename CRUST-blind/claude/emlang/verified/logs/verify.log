ype::IfBegin => \"if_begin\",\n            EmType::IfEnd => \"if_end\",\n            EmType::LoopBegin => \"loop_begin\",\n            EmType::LoopEnd => \"loop_end\",\n            EmType::Exit => \"exit\",\n            EmType::Dup => \"dup\",\n            EmType::Swap => \"swap\",\n            #[cfg(debug_assertions)]\n            EmType::Debug => \"debug\",\n        };\n        write!(f, \"{}\", s)\n    }\n}\n#[derive(Debug, Clone)]\npub struct Em {\n    pub data: data::Data,\n    pub em_type: EmType,\n    pub path: String,\n    pub row: usize,\n    pub col: usize,\n    pub r#ref: usize,\n    pub ran: bool,\n}\nimpl fmt::Display for Em {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"<{}\", self.em_type)?;\n        match self.em_type {\n            EmType::Push => {\n                write!(f, \" \")?;\n                write!(f, \"{}\", self.data)?;\n            }\n            EmType::PrintEnd => {\n                let target = match &self.data.value {\n                    data::DataValue::Int(i) => *i as i32,\n                    _ => 0,\n                };\n                write!(\n                    f,\n                    \" {}\",\n                    if target == DATA_STDOUT {\n                        \"stdout\"\n                    } else {\n                        \"stderr\"\n                    }\n                )?;\n            }\n            EmType::PrintBegin | EmType::IfBegin => {\n                write!(f, \" ref: {}\", self.r#ref)?;\n            }\n            _ => {}\n        }\n        write!(f, \" {}:{}:{}>\\n\", self.path, self.row, self.col)\n    }\n}\nimpl Em {\n    pub fn new(typ: EmType) -> Self {\n        Em {\n            data: data::Data::new(data::DataType::Int),\n            em_type: typ,\n            path: String::new(),\n            row: 0,\n            col: 0,\n            r#ref: 0,\n            ran: false,\n        }\n    }\n    pub fn new_with_data(typ: EmType, data: data::Data) -> Self {\n    