 vec_compact_(vec_unpack_(&v));\n        printf(\"compact_empty_post: len=%d cap=%d\\n\", v.length, v.capacity);\n        vec_deinit(&v);\n    }\n    \n    /* Test vec_swap with idx1==idx2 */\n    {\n        vec_int_t v;\n        vec_init(&v);\n        vec_push(&v, 10); vec_push(&v, 20); vec_push(&v, 30);\n        vec_swap_(vec_unpack_(&v), 1, 1);\n        printf(\"swap_same: %d %d %d\\n\", v.data[0], v.data[1], v.data[2]);\n        vec_deinit(&v);\n    }\n    \n    /* Test vec_splice count=0 */\n    {\n        vec_int_t v;\n        vec_init(&v);\n        vec_push(&v, 1); vec_push(&v, 2); vec_push(&v, 3);\n        vec_splice(&v, 1, 0);\n        printf(\"splice_0: len=%d %d %d %d\\n\", v.length, v.data[0], v.data[1], v.data[2]);\n        vec_deinit(&v);\n    }\n    \n    /* Test vec_insert at end */\n    {\n        vec_int_t v;\n        vec_init(&v);\n        vec_push(&v, 1); vec_push(&v, 2);\n        int r = vec_insert(&v, 2, 99);\n        printf(\"insert_end: r=%d len=%d %d %d %d\\n\", r, v.length, v.data[0], v.data[1], v.data[2]);\n        vec_deinit(&v);\n    }\n    \n    /* Test vec_swapsplice the standard test */\n    {\n        vec_int_t v;\n        vec_init(&v);\n        for (int i = 0; i < 10; i++) vec_push(&v, i);\n        vec_swapsplice(&v, 0, 3);\n        printf(\"swapsplice_0_3: len=%d\", v.length);\n        for (int i = 0; i < v.length; i++) printf(\" %d\", v.data[i]);\n        printf(\"\\n\");\n        vec_deinit(&v);\n    }\n    return 0;\n}\nEOF\ngcc -o /tmp/edge_test /tmp/edge_test.c src/vec.c -I src && /tmp/edge_test","description":"Probe edge cases in C"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":253,"cache_read_input_tokens":28726,"cache_creation":{"ephemeral_5m_input_tokens":253,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bad662d1-7c03-49e6-ad0c-f7c454b1544b","uuid":"a23d9