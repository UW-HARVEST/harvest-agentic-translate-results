{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01K92e9c45QkqT9zzVtFoZcg","type":"tool_result","content":"1\t#include <string.h>\n2\t#include <stdlib.h>\n3\t#include <stdio.h>\n4\t\n5\t#include \"tables.h\"\n6\t#include \"buffer_mgr.h\"\n7\t#include \"storage_mgr.h\"\n8\t#include \"record_mgr.h\"\n9\t#include \"dberror.h\"\n10\t\n11\t#define MAX_ATTR_NAME_LEN 15\n12\t\n13\textern int getAttrPos (Schema *schema, int attrNum);\n14\tstatic void prepareTableHeader(char **tableHeaderPtr, TableManager *tableManager, Schema *schema);\n15\tstatic void populateSchemaDetails(char **tableHeaderPtr, Schema *schema);\n16\tstatic void handleCleanup(BM_BufferPool *bufferPool, BM_PageHandle *pageHandle, TableManager *tableManager); \n17\t\n18\t\n19\tRC initRecordManager(void *mgmtData) {\n20\t\n21\t    printf(\"Initializing Record Manager...\\n\");\n22\t\n23\t    return RC_OK;\n24\t}\n25\t\n26\tRC shutdownRecordManager() {\n27\t\n28\t    printf(\"Shutting down Record Manager...\\n\");\n29\t\n30\t    printf(\"Record Manager shutdown successfully.\\n\");\n31\t    return RC_OK;\n32\t}\n33\t\n34\tvoid handleCleanup(BM_BufferPool *bufferPool, BM_PageHandle *pageHandle, TableManager *tableManager) {\n35\t    if (bufferPool != NULL) {\n36\t        shutdownBufferPool(bufferPool);\n37\t        free(bufferPool);\n38\t    }\n39\t    if (pageHandle != NULL) {\n40\t        free(pageHandle);\n41\t    }\n42\t    if (tableManager != NULL) {\n43\t        free(tableManager);\n44\t    }\n45\t}\n46\t\n47\tRC createTable(char *name, Schema *schema) {\n48\t    if (name == NULL || schema == NULL) return RC_GENERAL_ERROR;\n49\t\n50\t    BM_BufferPool *bufferPool = calloc(1, sizeof(BM_BufferPool));\n51\t    if (bufferPool == NULL) return RC_MEMORY_ALLOCATION_FAIL;\n52\t\n53\t    BM_PageHandle *pageHandle = calloc(1, sizeof(BM_PageHandle));\n54\t    if (pageHandle == NULL) {\n55\t        free(bufferPool);\n56\t        return RC_MEMORY_ALLOCATION_FAIL;\n57\t    }\n58\t\n59\t    TableManager *tableManager = calloc(1, sizeof(TableManager));\n60\t    if (tableManager == NULL) {\n61\t        free(pageHandle);\n62\t        free(bufferPool);\n63\t        return RC_MEMORY_ALLOCATION_FAIL;\n64\t    }\n65\t \n66\t    RC result = createPageFile(name);\n67\t    if (result != RC_OK) {\n68\t        handleCleanup(bufferPool, pageHandle, tableManager);\n69\t        return result;\n70\t    }\n71\t\n72\t    result = initBufferPool(bufferPool, name, 3, RS_FIFO, NULL);\n73\t    if (result != RC_OK) {\n74\t        handleCleanup(bufferPool, pageHandle, tableManager);\n75\t        return result;\n76\t    }\n77\t\n78\t    result = pinPage(bufferPool, pageHandle, 0);\n79\t    if (result != RC_OK) {\n80\t        handleCleanup(bufferPool, pageHandle, tableManager);\n81\t        return result;\n82\t    }\n83\t\n84\t    char *tableHeaderPtr = pageHandle->data;\n85\t    prepareTableHeader(&tableHeaderPtr, tableManager, schema);\n86\t\n87\t    result = markDirty(bufferPool, pageHandle);\n88\t    if (result != RC_OK) {\n89\t        handleCleanup(bufferPool, pageHandle, tableManager);\n90\t        return result;\n91\t    }\n92\t\n93\t    result = unpinPage(bufferPool, pageHandle);\n94\t    if (result != RC_OK) {\n95\t        handleCleanup(bufferPool, pageHandle, tableManager);\n96\t        return result;\n97\t    }\n98\t\n99\t    result = shutdownBufferPool(bufferPool);\n100\t    if (result != RC_OK) {\n101\t        handleCleanup(bufferPool, pageHandle, tableManager);\n102\t        return result;\n103\t    }\n104\t\n105\t    return RC_OK;\n106\t}\n107\t\n108\tvoid prepareTableHeader(char **tableHeaderPtr, TableManager *tableManager, Schema *schema) {\n109\t    int *headerInt = (int *)*tableHeaderPtr;\n110\t    \n111\t    tableManager->totalTuples = 0;\n112\t    tableManager->recSize = getRecordSize(schema);\n113\t    tableManager->firstFreePageNum = 1;\n114\t    tableManager->firstFreeSlotNum = 0;\n115\t    tableManager->firstDataPageNum = -1;\n116\t\n117\t    *headerInt