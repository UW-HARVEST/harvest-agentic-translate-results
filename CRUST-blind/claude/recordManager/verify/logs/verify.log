{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TTRZo4P5JU49fVPHbazSCw","type":"tool_result","content":"1\tuse crate::buffer_mgr::{\n2\t    init_buffer_pool, mark_dirty, pin_page, shutdown_buffer_pool, unpin_page, BM_BufferPool,\n3\t    BM_PageHandle, ReplacementStrategy,\n4\t};\n5\tuse crate::dberror::{PAGE_SIZE, RC};\n6\tuse crate::storage_mgr::{create_page_file, destroy_page_file};\n7\tuse crate::tables::{DataType, Record, Schema, Value, ValueUnion, RID, RM_TableData};\n8\tuse crate::expr::Expr;\n9\tuse std::cell::RefCell;\n10\t\n11\tpub struct RM_ScanHandle {\n12\t    pub rel: RM_TableData,\n13\t    pub mgmt_data: Option<Box<dyn std::any::Any>>,\n14\t}\n15\t\n16\tpub struct TableManager {\n17\t    pub total_tuples: i32,\n18\t    pub rec_size: i32,\n19\t    pub first_free_page_num: i32,\n20\t    pub first_free_slot_num: i32,\n21\t    pub first_data_page_num: i32,\n22\t    pub buffer_pool: Option<BM_BufferPool>,\n23\t    pub page_handler: Option<BM_PageHandle>,\n24\t}\n25\t\n26\tpub struct ScanManager {\n27\t    pub total_entries: i32,\n28\t    pub scan_index: i32,\n29\t    pub current_page_num: i32,\n30\t    pub current_slot_num: i32,\n31\t    pub condition_expression: Option<Expr>,\n32\t    pub scan_page_handle_ptr: Option<BM_PageHandle>,\n33\t}\n34\t\n35\tpub struct PageHeader {\n36\t    pub page_identifier: char,\n37\t    pub total_tuples: i32,\n38\t    pub free_slot_cnt: i32,\n39\t    pub next_free_slot_ind: i32,\n40\t    pub prev_free_page_index: i32,\n41\t    pub next_free_page_index: i32,\n42\t    pub prev_data_page_index: i32,\n43\t    pub next_data_page_index: i32,\n44\t}\n45\t\n46\tconst MAX_ATTR_NAME_LEN: usize = 15;\n47\tconst PAGE_HEADER_SIZE: usize = 32; // 1 char + 3 padding + 7 ints\n48\t\n49\tfn page_size() -> usize {\n50\t    PAGE_SIZE as usize\n51\t}\n52\t\n53\t// ---------- byte helpers ----------\n54\t\n55\tfn make_zero_str(n: usize) -> String {\n56\t    // SAFETY: zero bytes are valid UTF-8\n57\t    unsafe { String::from_utf8_unchecked(vec![0u8; n]) }\n58\t}\n59\t\n60\tfn write_i32(buf: &mut [u8], off: usize, val: i32) {\n61\t    let bytes = val.to_ne_bytes();\n62\t    buf[off..off + 4].copy_from_slice(&bytes);\n63\t}\n64\t\n65\tfn read_i32(buf: &[u8], off: usize) -> i32 {\n66\t    let mut b = [0u8; 4];\n67\t    let take = (buf.len().saturating_sub(off)).min(4);\n68\t    if take > 0 {\n69\t        b[..take].copy_from_slice(&buf[off..off + take]);\n70\t    }\n71\t    i32::from_ne_bytes(b)\n72\t}\n73\t\n74\tfn data_as_mut(page: &mut BM_PageHandle) -> &mut [u8] {\n75\t    // SAFETY: We treat the underlying buffer as binary bytes; the storage is\n76\t    // a fixed-size buffer for the page.\n77\t    unsafe {\n78\t        let v = page.data.as_mut_vec();\n79\t        if v.len() < page_size() {\n80\t            v.resize(page_size(), 0);\n81\t        }\n82\t        &mut v[..page_size()]\n83\t    }\n84\t}\n85\t\n86\tfn data_as(page: &BM_PageHandle) -> &[u8] {\n87\t    let bytes = page.data.as_bytes();\n88\t    if bytes.len() >= page_size() {\n89\t        &bytes[..page_size()]\n90\t    } else {\n91\t        bytes\n92\t    }\n93\t}\n94\t\n95\tfn ensure_page_capacity(page: &mut BM_PageHandle) {\n96\t    let bytes = page.data.as_bytes();\n97\t    if bytes.len() < page_size() {\n98\t        let mut v = std::mem::take(&mut page.data).into_bytes();\n99\t        v.resize(page_size(), 0);\n100\t        page.data = unsafe { String::from_utf8_unchecked(v) };\n101\t    }\n102\t}\n103\t\n104\t// Read/write page header from the first PAGE_HEADER_SIZE bytes of the page.\n105\tfn read_page_header(buf: &[u8]) -> PageHeader {\n106\t    PageHeader {\n107\t        page_identifier: buf[0] as char,\n108\t        total_tuples: read_i32(buf, 4),\n109\t        free_slot_cnt: read_i32(buf, 8),\n110\t        next_free_slot_ind: read_i32(buf, 12),\n111\t        prev_free_page_index: read_i32(buf, 16),\n112\t        next_free_page_index: read_i32(buf, 20),\n113\t        prev_data_page_index: read_i32(buf, 24),\n114\t        next_data_page_index: read_i32(buf, 28),\n115\t    }\n116\t}\n117\t\n118\tfn write_page_header(buf: &mut [u8], h: &PageHeader) {\n119\t    buf[0] = h.page_identifier as u8;\n120\t    // bytes 1..4 reserved as padding\n121\t    write_i32(buf, 4, h.total_tuples);\n122\t    write_i32(buf, 8, h.free_slot_cnt);\n123\t    write_i32(buf, 12, h.next_free_slot_ind);\n124\t    write_i32(buf, 16, h.prev_free_page_index);\n125\t    write_i32(buf, 20, h.next_free_page_index);\n126\t    write_i32(buf, 24, h.prev_data_page_index);\n127\t    write_i32(buf, 28, h.next_data_page_index);\n128\t}\n129\t\n130\t// ---------- public API ----------\n131\t\n132\tpub fn init_record_manager(_mgmt_data: Option<Box<dyn std::any::Any>>) -> RC {\n133\t    println!(\"Initializing Record Manager...\");\n134\t    RC::Ok\n135\t}\n136\t\n137\tpub fn shutdown_record_manager() -> RC {\n138\t    println!(\"Shutting down Record Manager...\");\n139\t    println!(\"Record Manager shutdown successfully.\");\n140\t    RC::Ok\n141\t}\n142\t\n143\tpub fn create_table(name: &str, schema: &Schema) -> RC {\n144\t    if name.is_empty() {\n145\t        return RC::GeneralError;\n146\t    }\n147\t    let rc = create_page_file(name);\n148\t    if rc != RC::Ok {\n149\t        return rc;\n150\t    }\n151\t    let mut bp = BM_BufferPool {\n152\t        page_file: String::new(),\n153\t        num_pages: 0,\n154\t        strategy: ReplacementStrategy::RsFifo,\n155\t        mgmt_data: None,\n156\t    };\n157\t    let rc = init_buffer_pool(&mut bp, name, 3, ReplacementStrategy::RsFifo, None);\n158\t    if rc != RC::Ok {\n159\t        return rc;\n160\t    }\n161\t    let mut page = BM_PageHandle {\n162\t        page_num: 0,\n163\t        data: make_zero_str(page_size()),\n164\t    };\n165\t    let rc = pin_page(&mut bp, &mut page, 0);\n166\t    if rc != RC::Ok {\n167\t        let _ = shutdown_buffer_pool(&mut bp);\n168\t        return rc;\n169\t    }\n170\t\n171\t    {\n172\t        let buf = data_as_mut(&mut page);\n173\t        // Header layout: 7 ints\n174\t        let total_tuples = 0i32;\n175\t        let rec_size = get_record_size(schema);\n176\t        let first_free_page_num = 1i32;\n177\t        let first_free_slot_num = 0i32;\n178\t        let first_data_page_num = -1i32;\n179\t\n180\t        write_i32(buf, 0, total_tuples);\n181\t        write_i32(buf, 4, rec_size);\n182\t        write_i32(buf, 8, first_free_page_num);\n183\t        write_i32(buf, 12, first_free_slot_num);\n184\t        write_i32(buf, 16, first_data_page_num);\n185\t        write_i32(buf, 20, schema.num_attr);\n186\t        write_i32(buf, 24, schema.key_size);\n187\t\n188\t        // Attribute info follows\n189\t        let mut off = 28usize;\n190\t        for i in 0..(schema.num_attr as usize) {\n191\t            let name_bytes = schema.attr_names[i].as_bytes();\n192\t            let copy_len = name_bytes.len().min(MAX_ATTR_NAME_LEN);\n193\t            // zero out region\n194\t            for j in 0..MAX_ATTR_NAME_LEN {\n195\t                buf[off + j] = 0;\n196\t            }\n197\t            buf[off..off + copy_len].copy_from_slice(&name_bytes[..copy_len]);\n198\t            off += MAX_ATTR_NAME_LEN;\n199\t            let dt_code = match schema.data_types[i] {\n200\t                DataType::DtInt => 0,\n201\t                DataType::DtString => 1,\n202\t                DataType::DtFloat => 2,\n203\t                DataType::DtBool => 3,\n204\t            };\n205\t            write_i32(buf, off, dt_code);\n206\t            off += 4;\n207\t            write_i32(buf, off, schema.type_length[i]);\n208\t            off += 4;\n209\t        }\n210\t        // Key attrs\n211\t        for i in 0..(schema.key_size as usize) {\n212\t            write_i32(buf, off, schema.key_attrs[i]);\n213\t            off += 4;\n214\t        }\n215\t    }\n216\t\n217\t    let rc = mark_dirty(&mut bp, &mut page);\n218\t    if rc != RC::Ok {\n219\t        let _ = shutdown_buffer_pool(&mut bp);\n220\t        return rc;\n221\t    }\n222\t    let rc = unpin_page(&mut bp, &mut page);\n223\t    if rc != RC::Ok {\n224\t        let _ = shutdown_buffer_pool(&mut bp);\n225\t        return rc;\n226\t    }\n227\t    let rc = shutdown_buffer_pool(&mut bp);\n228\t    if rc != RC::Ok {\n229\t        return rc;\n230\t    }\n231\t    RC::Ok\n232\t}\n233\t\n234\tpub fn open_table(rel: &mut RM_TableData, name: &str) -> RC {\n235\t    let mut bp = BM_BufferPool {\n236\t        page_file: String::new(),\n237\t        num_pages: 0,\n238\t        strategy: ReplacementStrategy::RsFifo,\n239\t        mgmt_data: None,\n240\t    };\n241\t    let rc = init_buffer_pool(&mut bp, name, 3, ReplacementStrategy::RsFifo, None);\n242\t    if rc != RC::Ok {\n243\t        return rc;\n244\t    }\n245\t    let mut page = BM_PageHandle {\n246\t        page_num: 0,\n247\t        data: make_zero_str(page_size()),\n248\t    };\n249\t    let rc = pin_page(&mut bp, &mut page, 0);\n250\t    if rc != RC::Ok {\n251\t        let _ = shutdown_buffer_pool(&mut bp);\n252\t        return rc;\n253\t    }\n254\t\n255\t    let (tm, schema) = {\n256\t        let buf = data_as(&page);\n257\t        let total_tuples = read_i32(buf, 0);\n258\t        let rec_size = read_i32(buf, 4);\n259\t        let first_free_page_num = read_i32(buf, 8);\n260\t        let first_free_slot_num = read_i32(buf, 12);\n261\t        let first_data_page_num = read_i32(buf, 16);\n262\t        let num_attr = read_i32(buf, 20);\n263\t        let key_size = read_i32(buf, 24);\n264\t\n265\t        let mut off = 28usize;\n266\t        let mut attr_names = Vec::with_capacity(num_attr as usize);\n267\t        let mut data_types = Vec::with_capacity(num_attr as usize);\n268\t        let mut type_length = Vec::with_capacity(num_attr as usize);\n269\t        for _ in 0..(num_attr as usize) {\n270\t            let raw = &buf[off..off + MAX_ATTR_NAME_LEN];\n271\t            let name_end = raw.iter().position(|&b| b == 0).unwrap_or(raw.len());\n272\t            let name = String::from_utf8_lossy(&raw[..name_end]).to_string();\n273\t            attr_names.push(name);\n274\t            off += MAX_ATTR_NAME_LEN;\n275\t            let dt_code = read_i32(buf, off);\n276\t            off += 4;\n277\t            let dt = match dt_code {\n278\t                0 => DataType::DtInt,\n279\t                1 => DataType::DtString,\n280\t                2 => DataType::DtFloat,\n281\t                _ => DataType::DtBool,\n282\t            };\n283\t            data_types.push(dt);\n284\t            type_length.push(read_i32(buf, off));\n285\t            off += 4;\n286\t        }\n287\t        let mut key_attrs = Vec::with_capacity(key_size as usize);\n288\t        for _ in 0..(key_size as usize) {\n289\t            key_attrs.push(read_i32(buf, off));\n290\t            off += 4;\n291\t        }\n292\t\n293\t        let schema = Schema {\n294\t            num_attr,\n295\t            attr_names,\n296\t            data_types,\n297\t            type_length,\n298\t            key_attrs,\n299\t            key_size,\n300\t        };\n301\t        let tm = TableManager {\n302\t            total_tuples,\n303\t            rec_size,\n304\t            first_free_page_num,\n305\t            first_free_slot_num,\n306\t            first_data_page_num,\n307\t            buffer_pool: Some(bp),\n308\t            page_handler: Some(page),\n309\t        };\n310\t        (tm, schema)\n311\t    };\n312\t\n313\t    // Need to take the page out of tm to unpin first\n314\t    let mut tm = tm;\n315\t    {\n316\t        let bp_mut = tm.buffer_pool.as_mut().unwrap();\n317\t        let ph_mut = tm.page_handler.as_mut().unwrap();\n318\t        let _ = unpin_page(bp_mut, ph_mut);\n319\t    }\n320\t\n321\t    rel.name = name.to_string();\n322\t    rel.schema = schema;\n323\t    rel.mgmt_data = Some(Box::new(RefCell::new(tm)));\n324\t    RC::Ok\n325\t}\n326\t\n327\tpub fn close_table(rel: &mut RM_TableData) -> RC {\n328\t    let cell: Box<RefCell<TableManager>> = match rel.mgmt_data.take() {\n329\t        Some(b) => match b.downcast::<RefCell<TableManager>>() {\n330\t            Ok(t) => t,\n331\t            Err(_) => return RC::Error,\n332\t        },\n333\t        None => return RC::Error,\n334\t    };\n335\t    let mut tm = cell.into_inner();\n336\t\n337\t    // Pin page 0, write back the table header integers\n338\t    {\n339\t        let bp = tm.buffer_pool.as_mut().unwrap();\n340\t        let mut local_page = BM_PageHandle {\n341\t            page_num: 0,\n342\t            data: make_zero_str(page_size()),\n343\t        };\n344\t        let rc = pin_page(bp, &mut local_page, 0);\n345\t        if rc == RC::Ok {\n346\t            {\n347\t                let buf = data_as_mut(&mut local_page);\n348\t                write_i32(buf, 0, tm.total_tuples);\n349\t                write_i32(buf, 4, tm.rec_size);\n350\t                write_i32(buf, 8, tm.first_free_page_num);\n351\t                write_i32(buf, 12, tm.first_free_slot_num);\n352\t                write_i32(buf, 16, tm.first_data_page_num);\n353\t            }\n354\t            let _ = mark_dirty(bp, &mut local_page);\n355\t            let _ = unpin_page(bp, &mut local_page);\n356\t        }\n357\t        let _ = shutdown_buffer_pool(bp);\n358\t    }\n359\t\n360\t    tm.buffer_pool = None;\n361\t    tm.page_handler = None;\n362\t    RC::Ok\n363\t}\n364\t\n365\tpub fn delete_table(name: &str) -> RC {\n366\t    if name.is_empty() {\n367\t        return RC::InvalidHeader;\n368\t    }\n369\t    destroy_page_file(name)\n370\t}\n371\t\n372\tfn tm_ref(rel: &RM_TableData) -> Option<&RefCell<TableManager>> {\n373\t    rel.mgmt_data\n374\t        .as_ref()\n375\t        .and_then(|b| b.downcast_ref::<RefCell<TableManager>>())\n376\t}\n377\t\n378\tpub fn get_num_tuples(rel: &RM_TableData) -> i32 {\n379\t    match tm_ref(rel) {\n380\t        Some(c) => c.borrow().total_tuples,\n381\t        None => -1,\n382\t    }\n383\t}\n384\t\n385\tfn slots_per_page(rec_size: i32) -> i32 {\n386\t    (page_size() as i32 - PAGE_HEADER_SIZE as i32) / (rec_size + 2)\n387\t}\n388\t\n389\tpub fn insert_record(rel: &mut RM_TableData, record: &Record) -> RC {\n390\t    let cell = match tm_ref(rel) {\n391\t        Some(c) => c,\n392\t        None => return RC::Error,\n393\t    };\n394\t    let mut tm = cell.borrow_mut();\n395\t    let rec_size = tm.rec_size;\n396\t    let slots = slots_per_page(rec_size);\n397\t\n398\t    let target_page = tm.first_free_page_num;\n399\t    let target_slot = tm.first_free_slot_num;\n400\t\n401\t    // Take owned page and bp temporarily.\n402\t    let mut bp = tm.buffer_pool.take().unwrap_or_else(|| BM_BufferPool {\n403\t        page_file: String::new(),\n404\t        num_pages: 0,\n405\t        strategy: ReplacementStrategy::RsFifo,\n406\t        mgmt_data: None,\n407\t    });\n408\t    let mut page = tm\n409\t        .page_handler\n410\t        .take()\n411\t        .unwrap_or_else(|| BM_PageHandle { page_num: 0, data: make_zero_str(page_size()) });\n412\t\n413\t    let rc = pin_page(&mut bp, &mut page, target_page);\n414\t    if rc != RC::Ok {\n415\t        tm.buffer_pool = Some(bp);\n416\t        tm.page_handler = Some(page);\n417\t        return RC::Error;\n418\t    }\n419\t\n420\t    {\n421\t        ensure_page_capacity(&mut page);\n422\t        let buf = data_as_mut(&mut page);\n423\t        let mut header = read_page_header(buf);\n424\t        if header.page_identifier != 'Y' {\n425\t            header.page_identifier = 'Y';\n426\t            header.total_tuples = 0;\n427\t            header.free_slot_cnt = slots - 1;\n428\t            header.next_free_slot_ind = 1;\n429\t            header.prev_free_page_index = -1;\n430\t            header.next_free_page_index = target_page + 1;\n431\t            header.prev_data_page_index = -1;\n432\t            header.next_data_page_index = 1;\n433\t        } else {\n434\t            header.total_tuples += 1;\n435\t            header.free_slot_cnt -= 1;\n436\t            if header.free_slot_cnt > 0 {\n437\t                header.next_free_slot_ind += 1;\n438\t            } else {\n439\t                header.next_free_slot_ind = -header.next_free_slot_ind;\n440\t            }\n441\t        }\n442\t        let pos = PAGE_HEADER_SIZE + (target_slot as usize) * (rec_size as usize + 2);\n443\t        buf[pos] = b'Y';\n444\t        let rd = record.data.as_bytes();\n445\t        let take = rd.len().min(rec_size as usize);\n446\t        buf[pos + 1..pos + 1 + take].copy_from_slice(&rd[..take]);\n447\t        // remaining bytes within record area zeroed (already are)\n448\t        buf[pos + rec_size as usize + 1] = b'|';\n449\t\n450\t        write_page_header(buf, &header);\n451\t\n452\t        if header.free_slot_cnt == 0 {\n453\t            tm.first_free_page_num += 1;\n454\t            tm.first_free_slot_num = 0;\n455\t        } else {\n456\t            tm.first_free_slot_num += 1;\n457\t        }\n458\t    }\n459\t\n460\t    tm.total_tuples += 1;\n461\t\n462\t    let dirty_status = mark_dirty(&mut bp, &mut page);\n463\t    let unpin_status = unpin_page(&mut bp, &mut page);\n464\t\n465\t    // Mirror C's behavior: insertRecord mutates the input record's id field\n466\t    // through a pointer. The Rust signature is `&Record`, so we need to update\n467\t    // through interior mutability. Since the public Record struct does not use\n468\t    // Cell, we use a raw-pointer cast. The caller is the unique owner during\n469\t    // this call, matching the C contract.\n470\t    #[allow(invalid_reference_casting)]\n471\t    unsafe {\n472\t        let r_mut = &record.id as *const RID as *mut RID;\n473\t        std::ptr::write(r_mut, RID { page: target_page, slot: target_slot });\n474\t    }\n475\t\n476\t    tm.buffer_pool = Some(bp);\n477\t    tm.page_handler = Some(page);\n478\t\n479\t    if dirty_status != RC::Ok || unpin_status != RC::Ok {\n480\t        return RC::Error;\n481\t    }\n482\t    RC::Ok\n483\t}\n484\t\n485\tpub fn delete_record(rel: &mut RM_TableData, id: &RID) -> RC {\n486\t    let cell = match tm_ref(rel) {\n487\t        Some(c) => c,\n488\t        None => return RC::Error,\n489\t    };\n490\t    let mut tm = cell.borrow_mut();\n491\t    let rec_size = tm.rec_size;\n492\t    let slots = slots_per_page(rec_size);\n493\t    if id.slot >= slots {\n494\t        return RC::RecordNotFound;\n495\t    }\n496\t    let mut bp = tm.buffer_pool.take().unwrap();\n497\t    let mut page = tm.page_handler.take().unwrap();\n498\t\n499\t    let rc = pin_page(&mut bp, &mut page, id.page);\n500\t    if rc != RC::Ok {\n501\t        tm.buffer_pool = Some(bp);\n502\t        tm.page_handler = Some(page);\n503\t        return rc;\n504\t    }\n505\t    let mut not_found = false;\n506\t    {\n507\t        ensure_page_capacity(&mut page);\n508\t        let buf = data_as_mut(&mut page);\n509\t        let pos = PAGE_HEADER_SIZE + (id.slot as usize) * (rec_size as usize + 2);\n510\t        if buf[pos] != b'Y' {\n511\t            not_found = true;\n512\t        } else {\n513\t            buf[pos] = b'N';\n514\t            let mut header = read_page_header(buf);\n515\t            header.total_tuples = (header.total_tuples - 1).max(0);\n516\t            header.free_slot_cnt += 1;\n517\t            write_page_header(buf, &header);\n518\t        }\n519\t    }\n520\t    if not_found {\n521\t        let _ = unpin_page(&mut bp, &mut page);\n522\t        tm.buffer_pool = Some(bp);\n523\t        tm.page_handler = Some(page);\n524\t        return RC::RecordNotFound;\n525\t    }\n526\t    tm.total_tuples = (tm.total_tuples - 1).max(0);\n527\t\n528\t    let dirty_rc = mark_dirty(&mut bp, &mut page);\n529\t    if dirty_rc != RC::Ok {\n530\t        let _ = unpin_page(&mut bp, &mut page);\n531\t        tm.buffer_pool = Some(bp);\n532\t        tm.page_handler = Some(page);\n533\t        return RC::Error;\n534\t    }\n535\t    let unpin_rc = unpin_page(&mut bp, &mut page);\n536\t    tm.buffer_pool = Some(bp);\n537\t    tm.page_handler = Some(page);\n538\t    if unpin_rc != RC::Ok {\n539\t        return unpin_rc;\n540\t    }\n541\t    RC::Ok\n542\t}\n543\t\n544\tpub fn update_record(rel: &mut RM_TableData, record: &Record) -> RC {\n545\t    let cell = match tm_ref(rel) {\n546\t        Some(c) => c,\n547\t        None => return RC::Error,\n548\t    };\n549\t    let mut tm = cell.borrow_mut();\n550\t    let rec_size = tm.rec_size;\n551\t    let slots = slots_per_page(rec_size);\n552\t    if record.id.slot >= slots {\n553\t        return RC::RecordNotFound;\n554\t    }\n555\t    let mut bp = tm.buffer_pool.take().unwrap();\n556\t    let mut page = tm.page_handler.take().unwrap();\n557\t\n558\t    let rc = pin_page(&mut bp, &mut page, record.id.page);\n559\t    if rc != RC::Ok {\n560\t        tm.buffer_pool = Some(bp);\n561\t        tm.page_handler = Some(page);\n562\t        return RC::Error;\n563\t    }\n564\t    let mut not_found = false;\n565\t    {\n566\t        ensure_page_capacity(&mut page);\n567\t        let buf = data_as_mut(&mut page);\n568\t        let pos = PAGE_HEADER_SIZE + (record.id.slot as usize) * (rec_size as usize + 2);\n569\t        if buf[pos] != b'Y' {\n570\t            not_found = true;\n571\t        } else {\n572\t            let rd = record.data.as_bytes();\n573\t            let take = rd.len().min(rec_size as usize);\n574\t            buf[pos + 1..pos + 1 + take].copy_from_slice(&rd[..take]);\n575\t        }\n576\t    }\n577\t    if not_found {\n578\t        let _ = unpin_page(&mut bp, &mut page);\n579\t        tm.buffer_pool = Some(bp);\n580\t        tm.page_handler = Some(page);\n581\t        return RC::RecordNotFound;\n582\t    }\n583\t    let dirty_rc = mark_dirty(&mut bp, &mut page);\n584\t    let unpin_rc = unpin_page(&mut bp, &mut page);\n585\t    tm.buffer_pool = Some(bp);\n586\t    tm.page_handler = Some(page);\n587\t    if dirty_rc != RC::Ok || unpin_rc != RC::Ok {\n588\t        return RC::Error;\n589\t    }\n590\t    RC::Ok\n591\t}\n592\t\n593\tpub fn get_record(rel: &RM_TableData, id: &RID, record: &mut Record) -> RC {\n594\t    let cell = match tm_ref(rel) {\n595\t        Some(c) => c,\n596\t        None => return RC::Error,\n597\t    };\n598\t    let mut tm = cell.borrow_mut();\n599\t    let rec_size = tm.rec_size;\n600\t    let slots = slots_per_page(rec_size);\n601\t    if id.slot >= slots {\n602\t        return RC::RecordNotFound;\n603\t    }\n604\t\n605\t    let mut bp = tm.buffer_pool.take().unwrap();\n606\t    let mut page = tm.page_handler.take().unwrap();\n607\t\n608\t    let rc = pin_page(&mut bp, &mut page, id.page);\n609\t    if rc != RC::Ok {\n610\t        tm.buffer_pool = Some(bp);\n611\t        tm.page_handler = Some(page);\n612\t        return RC::Error;\n613\t    }\n614\t    let mut not_found = false;\n615\t    {\n616\t        ensure_page_capacity(&mut page);\n617\t        let buf = data_as(&page);\n618\t        let pos = PAGE_HEADER_SIZE + (id.slot as usize) * (rec_size as usize + 2);\n619\t        if buf[pos] != b'Y' {\n620\t            not_found = true;\n621\t        } else {\n622\t            let src = &buf[pos + 1..pos + 1 + rec_size as usize];\n623\t            // Set record.data to be exactly rec_size bytes (or larger if pre-allocated)\n624\t            ensure_record_capacity(record, rec_size as usize);\n625\t            unsafe {\n626\t                let v = record.data.as_mut_vec();\n627\t                v[..rec_size as usize].copy_from_slice(src);\n628\t            }\n629\t            record.id = id.clone();\n630\t        }\n631\t    }\n632\t    let unpin_rc = unpin_page(&mut bp, &mut page);\n633\t    tm.buffer_pool = Some(bp);\n634\t    tm.page_handler = Some(page);\n635\t    if not_found {\n636\t        return RC::RecordNotFound;\n637\t    }\n638\t    unpin_rc\n639\t}\n640\t\n641\tfn ensure_record_capacity(record: &mut Record, n: usize) {\n642\t    let bytes = record.data.as_bytes();\n643\t    if bytes.len() < n {\n644\t        let mut v = std::mem::take(&mut record.data).into_bytes();\n645\t        v.resize(n, 0);\n646\t        record.data = unsafe { String::from_utf8_unchecked(v) };\n647\t    }\n648\t}\n649\t\n650\tpub fn start_scan(rel: &RM_TableData, scan: &mut RM_ScanHandle, cond: &Expr) -> RC {\n651\t    let cell = match tm_ref(rel) {\n652\t        Some(c) => c,\n653\t        None => return RC::Error,\n654\t    };\n655\t    let tm = cell.borrow();\n656\t    let total_entries = tm.total_tuples;\n657\t    let first_data_page_num = tm.first_data_page_num;\n658\t    drop(tm);\n659\t\n660\t    let scan_mgr = ScanManager {\n661\t        total_entries,\n662\t        scan_index: 0,\n663\t        current_page_num: first_data_page_num,\n664\t        current_slot_num: -1,\n665\t        condition_expression: Some(cond.clone()),\n666\t        scan_page_handle_ptr: None,\n667\t    };\n668\t    scan.mgmt_data = Some(Box::new(scan_mgr));\n669\t    // We need next() to access the original rel's TableManager state. Save a\n670\t    // pointer-as-usize to the original rel; the caller must keep rel alive for\n671\t    // the duration of the scan.\n672\t    let rel_ptr = rel as *const RM_TableData as usize;\n673\t    scan.rel = RM_TableData {\n674\t        name: rel.name.clone(),\n675\t        schema: rel.schema.clone(),\n676\t        mgmt_data: Some(Box::new(rel_ptr)),\n677\t    };\n678\t    RC::Ok\n679\t}\n680\t\n681\tpub fn next(scan: &mut RM_ScanHandle, record: &mut Record) -> RC {\n682\t    // Recover the original rel pointer\n683\t    let rel_ptr: usize = match scan\n684\t        .rel\n685\t        .mgmt_data\n686\t        .as_ref()\n687\t        .and_then(|b| b.downcast_ref::<usize>())\n688\t    {\n689\t        Some(p) => *p,\n690\t        None => return RC::Error,\n691\t    };\n692\t    let rel: &RM_TableData = unsafe { &*(rel_ptr as *const RM_TableData) };\n693\t    let cell = match tm_ref(rel) {\n694\t        Some(c) => c,\n695\t        None => return RC::Error,\n696\t    };\n697\t    let rec_size = cell.borrow().rec_size;\n698\t    let slots = slots_per_page(rec_size);\n699\t\n700\t    let scan_mgr = match scan\n701\t        .mgmt_data\n702\t        .as_mut()\n703\t        .and_then(|b| b.downcast_mut::<ScanManager>())\n704\t    {\n705\t        Some(s) => s,\n706\t        None => return RC::Error,\n707\t    };\n708\t    if scan_mgr.scan_index >= scan_mgr.total_entries {\n709\t        return RC::RmNoMoreTuples;\n710\t    }\n711\t\n712\t    let cond = scan_mgr.condition_expression.clone();\n713\t    let mut eval_result = Value {\n714\t        dt: DataType::DtInt,\n715\t        v: ValueUnion::IntV(-1),\n716\t    };\n717\t\n718\t    loop {\n719\t        scan_mgr.current_slot_num += 1;\n720\t        if scan_mgr.current_slot_num >= slots {\n721\t            scan_mgr.current_page_num += 1;\n722\t            scan_mgr.current_slot_num = 0;\n723\t        }\n724\t        let cur_id = RID {\n725\t            page: scan_mgr.current_page_num,\n726\t            slot: scan_mgr.current_slot_num,\n727\t        };\n728\t        let rc = get_record(rel, &cur_id, record);\n729\t        if rc == RC::Ok {\n730\t            scan_mgr.scan_index += 1;\n731\t            match &cond {\n732\t                Some(c) => {\n733\t                    // Treat the \"no condition\" sentinel: a const-true bool returns true.\n734\t                    let rc = crate::expr::eval_expr(record, &rel.schema, c, &mut eval_result);\n735\t                    if rc != RC::Ok {\n736\t                        return rc;\n737\t                    }\n738\t                    if let ValueUnion::BoolV(true) = eval_result.v {\n739\t                        return RC::Ok;\n740\t                    }\n741\t                }\n742\t                None => {\n743\t                    return RC::Ok;\n744\t                }\n745\t            }\n746\t        }\n747\t        if scan_mgr.scan_index >= scan_mgr.total_entries {\n748\t            return RC::RmNoMoreTuples;\n749\t        }\n750\t    }\n751\t}\n752\t\n753\tpub fn close_scan(scan: &mut RM_ScanHandle) -> RC {\n754\t    scan.mgmt_data = None;\n755\t    scan.rel.mgmt_data = None;\n756\t    RC::Ok\n757\t}\n758\t\n759\tpub fn get_record_size(schema: &Schema) -> i32 {\n760\t    let mut total = 0i32;\n761\t    for i in 0..(schema.num_attr as usize) {\n762\t        let dt = &schema.data_types[i];\n763\t        let len = schema.type_length[i];\n764\t        match dt {\n765\t            DataType::DtString => total += len,\n766\t            DataType::DtInt => total += std::mem::size_of::<i32>() as i32,\n767\t            DataType::DtFloat => total += std::mem::size_of::<f32>() as i32,\n768\t            DataType::DtBool => total += std::mem::size_of::<bool>() as i32,\n769\t        }\n770\t    }\n771\t    let pad = total % 4;\n772\t    if pad != 0 {\n773\t        total += 4 - pad;\n774\t    }\n775\t    total\n776\t}\n777\t\n778\tpub fn create_schema(\n779\t    num_attr: i32,\n780\t    attr_names: Vec<String>,\n781\t    data_types: Vec<DataType>,\n782\t    type_length: Vec<i32>,\n783\t    key_size: i32,\n784\t    keys: Vec<i32>,\n785\t) -> Schema {\n786\t    Schema {\n787\t        num_attr,\n788\t        attr_names,\n789\t        data_types,\n790\t        type_length,\n791\t        key_attrs: keys,\n792\t        key_size,\n793\t    }\n794\t}\n795\t\n796\tpub fn free_schema(_schema: &mut Schema) -> RC {\n797\t    RC::Ok\n798\t}\n799\t\n800\tpub fn create_record(record: &mut Option<Record>, schema: &Schema) -> RC {\n801\t    let rec_size = get_record_size(schema);\n802\t    let data = make_zero_str(rec_size as usize + 1);\n803\t    *record = Some(Record {\n804\t        id: RID { page: 0, slot: 0 },\n805\t        data,\n806\t    });\n807\t    RC::Ok\n808\t}\n809\t\n810\tpub fn free_record(_record: &mut Record) -> RC {\n811\t    RC::Ok\n812\t}\n813\t\n814\tpub fn get_attr(record: &Record, schema: &Schema, attr_num: i32, value: &mut Value) -> RC {\n815\t    let idx = attr_num as usize;\n816\t    let dt = &schema.data_types[idx];\n817\t    value.dt = dt.clone();\n818\t    let pos = get_attr_pos(schema, attr_num) as usize;\n819\t    let bytes = record.data.as_bytes();\n820\t    match dt {\n821\t        DataType::DtString => {\n822\t            let len = schema.type_length[idx] as usize;\n823\t            let end = (pos + len).min(bytes.len());\n824\t            let raw = if pos < bytes.len() {\n825\t                &bytes[pos..end]\n826\t            } else {\n827\t                &bytes[..0]\n828\t            };\n829\t            let truncated: Vec<u8> = raw.iter().cloned().take_while(|&b| b != 0).collect();\n830\t            // Pad with zero bytes if shorter than len? C uses strncpy then a zero-padded buffer.\n831\t            // For comparison purposes (memcmp), strncpy zero-fills the remaining bytes.\n832\t            // Here we keep the trimmed string for the Value.\n833\t            let s = String::from_utf8_lossy(&truncated).to_string();\n834\t            // Replicate strncpy padding behaviour by storing exactly len bytes\n835\t            // (zero-padded) inside the StringV.\n836\t            let mut padded = vec![0u8; len];\n837\t            let n = truncated.len().min(len);\n838\t            padded[..n].copy_from_slice(&truncated[..n]);\n839\t            // For test compatibility we keep just the trimmed text.\n840\t            let _ = s;\n841\t            value.v = ValueUnion::StringV(\n842\t                String::from_utf8_lossy(&padded[..n]).to_string(),\n843\t            );\n844\t        }\n845\t        DataType::DtInt => {\n846\t            value.v = ValueUnion::IntV(read_i32(bytes, pos));\n847\t        }\n848\t        DataType::DtFloat => {\n849\t            let mut b = [0u8; 4];\n850\t            let take = (bytes.len() - pos.min(bytes.len())).min(4);\n851\t            if take > 0 {\n852\t                b[..take].copy_from_slice(&bytes[pos..pos + take]);\n853\t            }\n854\t            value.v = ValueUnion::FloatV(f32::from_ne_bytes(b));\n855\t        }\n856\t        DataType::DtBool => {\n857\t            let v = if pos < bytes.len() { bytes[pos] != 0 } else { false };\n858\t            value.v = ValueUnion::BoolV(v);\n859\t        }\n860\t    }\n861\t    RC::Ok\n862\t}\n863\t\n864\tpub fn set_attr(record: &mut Record, schema: &Schema, attr_num: i32, value: &Value) -> RC {\n865\t    let idx = attr_num as usize;\n866\t    let pos = get_attr_pos(schema, attr_num) as usize;\n867\t    ensure_record_capacity(\n868\t        record,\n869\t        pos + match schema.data_types[idx] {\n870\t            DataType::DtString => schema.type_length[idx] as usize,\n871\t            DataType::DtInt | DataType::DtFloat => 4,\n872\t            DataType::DtBool => 1,\n873\t        },\n874\t    );\n875\t    let buf = unsafe { record.data.as_mut_vec() };\n876\t    match (&schema.data_types[idx], &value.v) {\n877\t        (DataType::DtInt, ValueUnion::IntV(i)) => {\n878\t            buf[pos..pos + 4].copy_from_slice(&i.to_ne_bytes());\n879\t        }\n880\t        (DataType::DtFloat, ValueUnion::FloatV(f)) => {\n881\t            buf[pos..pos + 4].copy_from_slice(&f.to_ne_bytes());\n882\t        }\n883\t        (DataType::DtBool, ValueUnion::BoolV(b)) => {\n884\t            buf[pos] = if *b { 1 } else { 0 };\n885\t        }\n886\t        (DataType::DtString, ValueUnion::StringV(s)) => {\n887\t            let len = schema.type_length[idx] as usize;\n888\t            // memcpy(target, value->v.stringV, schema->typeLength[attrNum]);\n889\t            let bytes = s.as_bytes();\n890\t            let take = bytes.len().min(len);\n891\t            buf[pos..pos + take].copy_from_slice(&bytes[..take]);\n892\t            // Zero remainder so the slot has consistent contents.\n893\t            for i in pos + take..pos + len {\n894\t                buf[i] = 0;\n895\t            }\n896\t        }\n897\t        _ => {}\n898\t    }\n899\t    RC::Ok\n900\t}\n901\t\n902\tpub fn get_attr_pos(schema: &Schema, attr_num: i32) -> i32 {\n903\t    let mut pos = 0i32;\n904\t    for i in 0..(attr_num as usize) {\n905\t        match schema.data_types[i] {\n906\t            DataType::DtString => pos += schema.type_length[i],\n907\t            DataType::DtInt => pos += std::mem::size_of::<i32>() as i32,\n908\t            DataType::DtFloat => pos += std::mem::size_of::<f32>() as i32,\n909\t            DataType::DtBool => pos += std::mem::size_of::<bool>() as i32,\n910\t        }\n911\t    }\n912\t    pos\n913\t}\n914\t"}]},"parent_tool_use_id":null,"session_id":"489ddf9c-27df-4653-aaa4-9f357fe2d584","uuid":"d0fba2ef-809b-49bb-9a4e-fc8f8aae3a5b","timestamp":"2026-05-29T19:10:41.694Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-UeD4I4/project/src/record_mgr.rs","content":"use crate::buffer_mgr::{\n    init_buffer_pool, mark_dirty, pin_page, shutdown_buffer_pool, unpin_page, BM_BufferPool,\n    BM_PageHandle, ReplacementStrategy,\n};\nuse crate::dberror::{PAGE_SIZE, RC};\nuse crate::storage_mgr::{create_page_file, destroy_page_file};\nuse crate::tables::{DataType, Record, Schema, Value, ValueUnion, RID, RM_TableData};\nuse crate::expr::Expr;\nuse std::cell::RefCell;\n\npub struct RM_ScanHandle {\n    pub rel: RM_TableData,\n    pub mgmt_data: Option<Box<dyn std::any::Any>>,\n}\n\npub struct TableManager {\n    pub total_tuples: i32,\n    pub rec_size: i32,\n    pub first_free_page_num: i32,\n    pub first_free_slot_num: i32,\n    pub first_data_page_num: i32,\n    pub buffer_pool: Option<BM_BufferPool>,\n    pub page_handler: Option<BM_PageHandle>,\n}\n\npub struct ScanManager {\n    pub total_entries: i32,\n    pub scan_index: i32,\n    pub current_page_num: i32,\n    pub current_slot_num: i32,\n    pub condition_expression: Option<Expr>,\n    pub scan_page_handle_ptr: Option<BM_PageHandle>,\n}\n\npub struct PageHeader {\n    pub page_identifier: char,\n    pub total_tuples: i32,\n    pub free_slot_cnt: i32,\n    pub next_free_slot_ind: i32,\n    pub prev_free_page_index: i32,\n    pub next_free_page_index: i32,\n    pub prev_data_page_index: i32,\n    pub next_data_page_index: i32,\n}\n\nconst MAX_ATTR_NAME_LEN: usize = 15;\nconst PAGE_HEADER_SIZE: usize = 32; // 1 char + 3 padding + 7 ints\n\nfn page_size() -> usize {\n    PAGE_SIZE as usize\n}\n\n// ---------- byte helpers ----------\n\nfn make_zero_str(n: usize) -> String {\n    // SAFETY: zero bytes are valid UTF-8\n    unsafe { String::from_utf8_unchecked(vec![0u8; n]) }\n}\n\nfn write_i32(buf: &mut [u8], off: usize, val: i32) {\n    let bytes = val.to_ne_bytes();\n    buf[off..off + 4].copy_from_slice(&bytes);\n}\n\nfn read_i32(buf: &[u8], off: usize) -> i32 {\n    let mut b = [0u8; 4];\n    let take = (buf.len().saturating_sub(off)).min(4);\n    if take > 0 {\n        b[..take].copy_from_slice(&buf[off..off + take]);\n    }\n    i32::from_ne_bytes(b)\n}\n\nfn data_as_mut(page: &mut BM_PageHandle) -> &mut [u8] {\n    // SAFETY: We treat the underlying buffer as binary bytes; the storage is\n    // a fixed-size buffer for the page.\n    unsafe {\n        let v = page.data.as_mut_vec();\n        if v.len() < page_size() {\n            v.resize(page_size(), 0);\n        }\n        &mut v[..page_size()]\n    }\n}\n\nfn data_as(page: &BM_PageHandle) -> &[u8] {\n    let bytes = page.data.as_bytes();\n    if bytes.len() >= page_size() {\n        &bytes[..page_size()]\n    } else {\n        bytes\n    }\n}\n\nfn ensure_page_capacity(page: &mut BM_PageHandle) {\n    let bytes = page.data.as_bytes();\n    if bytes.len() < page_size() {\n        let mut v = std::mem::take(&mut page.data).into_bytes();\n        v.resize(page_size(), 0);\n        page.data = unsafe { String::from_utf8_unchecked(v) };\n    }\n}\n\n// Read/write page header from the first PAGE_HEADER_SIZE bytes of the page.\nfn read_page_header(buf: &[u8]) -> PageHeader {\n    PageHeader {\n        page_identifier: buf[0] as char,\n        total_tuples: read_i32(buf, 4),\n        free_slot_cnt: read_i32(buf, 8),\n        next_free_slot_ind: read_i32(buf, 12),\n        prev_free_page_index: read_i32(buf, 16),\n        next_free_page_index: read_i32(buf, 20),\n        prev_data_page_index: read_i32(buf, 24),\n        next_data_page_index: read_i32(buf, 28),\n    }\n}\n\nfn write_page_header(buf: &mut [u8], h: &PageHeader) {\n    buf[0] = h.page_identifier as u8;\n    // bytes 1..4 reserved as padding\n    write_i32(buf, 4, h.total_tuples);\n    write_i32(buf, 8, h.free_slot_cnt);\n    write_i32(buf, 12, h.next_free_slot_ind);\n    write_i32(buf, 16, h.prev_free_page_index);\n    write_i32(buf, 20, h.next_free_page_index);\n    write_i32(buf, 24, h.prev_data_page_index);\n    write_i32(buf, 28, h.next_data_page_index);\n}\n\n// ---------- public API ----------\n\npub fn init_record_manager(_mgmt_data: Option<Box<dyn std::any::Any>>) -> RC {\n    println!(\"Initializing Record Manager...\");\n    RC::Ok\n}\n\npub fn shutdown_record_manager() -> RC {\n    println!(\"Shutting down Record Manager...\");\n    println!(\"Record Manager shutdown successfully.\");\n    RC::Ok\n}\n\npub fn create_table(name: &str, schema: &Schema) -> RC {\n    if name.is_empty() {\n        return RC::GeneralError;\n    }\n    let rc = create_page_file(name);\n    if rc != RC::Ok {\n        return rc;\n    }\n    let mut bp = BM_BufferPool {\n        page_file: String::new(),\n        num_pages: 0,\n        strategy: ReplacementStrategy::RsFifo,\n        mgmt_data: None,\n    };\n    let rc = init_buffer_pool(&mut bp, name, 3, ReplacementStrategy::RsFifo, None);\n    if rc != RC::Ok {\n        return rc;\n    }\n    let mut page = BM_PageHandle {\n        page_num: 0,\n        data: make_zero_str(page_size()),\n    };\n    let rc = pin_page(&mut bp, &mut page, 0);\n    if rc != RC::Ok {\n        let _ = shutdown_buffer_pool(&mut bp);\n        return rc;\n    }\n\n    {\n        let buf = data_as_mut(&mut page);\n        // Header layout: 7 ints\n        let total_tuples = 0i32;\n        let rec_size = get_record_size(schema);\n        let first_free_page_num = 1i32;\n        let first_free_slot_num = 0i32;\n        let first_data_page_num = -1i32;\n\n        write_i32(buf, 0, total_tuples);\n        write_i32(buf, 4, rec_size);\n        write_i32(buf, 8, first_free_page_num);\n        write_i32(buf, 12, first_free_slot_num);\n        write_i32(buf, 16, first_data_page_num);\n        write_i32(buf, 20, schema.num_attr);\n        write_i32(buf, 24, schema.key_size);\n\n        // Attribute info follows\n        let mut off = 28usize;\n        for i in 0..(schema.num_attr as usize) {\n            let name_bytes = schema.attr_names[i].as_bytes();\n            let copy_len = name_bytes.len().min(MAX_ATTR_NAME_LEN);\n            // zero out region\n            for j in 0..MAX_ATTR_NAME_LEN {\n                buf[off + j] = 0;\n            }\n            buf[off..off + copy_len].copy_from_slice(&name_bytes[..copy_len]);\n            off += MAX_ATTR_NAME_LEN;\n            let dt_code = match schema.data_types[i] {\n                DataType::DtInt => 0,\n                DataType::DtString => 1,\n                DataType::DtFloat => 2,\n                DataType::DtBool => 3,\n            };\n            write_i32(buf, off, dt_code);\n            off += 4;\n            write_i32(buf, off, schema.type_length[i]);\n            off += 4;\n        }\n        // Key attrs\n        for i in 0..(schema.key_size as usize) {\n            write_i32(buf, off, schema.key_attrs[i]);\n            off += 4;\n        }\n    }\n\n    let rc = mark_dirty(&mut bp, &mut page);\n    if rc != RC::Ok {\n        let _ = shutdown_buffer_pool(&mut bp);\n        return rc;\n    }\n    let rc = unpin_page(&mut bp, &mut page);\n    if rc != RC::Ok {\n        let _ = shutdown_buffer_pool(&mut bp);\n        return rc;\n    }\n    let rc = shutdown_buffer_pool(&mut bp);\n    if rc != RC::Ok {\n        return rc;\n    }\n    RC::Ok\n}\n\npub fn open_table(rel: &mut RM_TableData, name: &str) -> RC {\n    let mut bp = BM_BufferPool {\n        page_file: String::new(),\n        num_pages: 0,\n        strategy: ReplacementStrategy::RsFifo,\n        mgmt_data: None,\n    };\n    let rc = init_buffer_pool(&mut bp, name, 3, ReplacementStrategy::RsFifo, None);\n    if rc != RC::Ok {\n        return rc;\n    }\n    let mut page = BM_PageHandle {\n        page_num: 0,\n        data: make_zero_str(page_size()),\n    };\n    let rc = pin_page(&mut bp, &mut page, 0);\n    if rc != RC::Ok {\n        let _ = shutdown_buffer_pool(&mut bp);\n        return rc;\n    }\n\n    let (tm, schema) = {\n        let buf = data_as(&page);\n        let total_tuples = read_i32(buf, 0);\n        let rec_size = read_i32(buf, 4);\n        let first_free_page_num = read_i32(buf, 8);\n        let first_free_slot_num = read_i32(buf, 12);\n        let first_data_page_num = read_i32(buf, 16);\n        let num_attr = read_i32(buf, 20);\n        let key_size = read_i32(buf, 24);\n\n        let mut off = 28usize;\n        let mut attr_names = Vec::with_capacity(num_attr as usize);\n        let mut data_types = Vec::with_capacity(num_attr as usize);\n        let mut type_length = Vec::with_capacity(num_attr as usize);\n        for _ in 0..(num_attr as usize) {\n            let raw = &buf[off..off + MAX_ATTR_NAME_LEN];\n            let name_end = raw.iter().position(|&b| b == 0).unwrap_or(raw.len());\n            let name = String::from_utf8_lossy(&raw[..name_end]).to_string();\n            attr_names.push(name);\n            off += MAX_ATTR_NAME_LEN;\n            let dt_code = read_i32(buf, off);\n            off += 4;\n            let dt = match dt_code {\n                0 => DataType::DtInt,\n                1 => DataType::DtString,\n                2 => DataType::DtFloat,\n                _ => DataType::DtBool,\n            };\n            data_types.push(dt);\n            type_length.push(read_i32(buf, off));\n            off += 4;\n        }\n        let mut key_attrs = Vec::with_capacity(key_size as usize);\n        for _ in 0..(key_size as usize) {\n            key_attrs.push(read_i32(buf, off));\n            off += 4;\n        }\n\n        let schema = Schema {\n            num_attr,\n            attr_names,\n            data_types,\n            type_length,\n            key_attrs,\n            key_size,\n        };\n        let tm = TableManager {\n            total_tuples,\n            rec_size,\n            first_free_page_num,\n            first_free_slot_num,\n            first_data_page_num,\n            buffer_pool: Some(bp),\n            page_handler: Some(page),\n        };\n        (tm, schema)\n    };\n\n    // Need to take the page out of tm to unpin first\n    let mut tm = tm;\n    {\n        let bp_mut = tm.buffer_pool.as_mut().unwrap();\n        let ph_mut = tm.page_handler.as_mut().unwrap();\n        let _ = unpin_page(bp_mut, ph_mut);\n    }\n\n    rel.name = name.to_string();\n    rel.schema = schema;\n    rel.mgmt_data = Some(Box::new(RefCell::new(tm)));\n    RC::Ok\n}\n\npub fn close_table(rel: &mut RM_TableData) -> RC {\n    let cell: Box<RefCell<TableManager>> = match rel.mgmt_data.take() {\n        Some(b) => match b.downcast::<RefCell<TableManager>>() {\n            Ok(t) => t,\n            Err(_) => return RC::Error,\n        },\n        None => return RC::Error,\n    };\n    let mut tm = cell.into_inner();\n\n    // Pin page 0, write back the table header integers\n    {\n        let bp = tm.buffer_pool.as_mut().unwrap();\n        let mut local_page = BM_PageHandle {\n            page_num: 0,\n            data: make_zero_str(page_size()),\n        };\n        let rc = pin_page(bp, &mut local_page, 0);\n        if rc == RC::Ok {\n            {\n                let buf = data_as_mut(&mut local_page);\n                write_i32(buf, 0, tm.total_tuples);\n                write_i32(buf, 4, tm.rec_size);\n                write_i32(buf, 8, tm.first_free_page_num);\n                write_i32(buf, 12, tm.first_free_slot_num);\n                write_i32(buf, 16, tm.first_data_page_num);\n            }\n            let _ = mark_dirty(bp, &mut local_page);\n            let _ = unpin_page(bp, &mut local_page);\n        }\n        let _ = shutdown_buffer_pool(bp);\n    }\n\n    tm.buffer_pool = None;\n    tm.page_handler = None;\n    RC::Ok\n}\n\npub fn delete_table(name: &str) -> RC {\n    if name.is_empty() {\n        return RC::InvalidHeader;\n    }\n    destroy_page_file(name)\n}\n\nfn tm_ref(rel: &RM_TableData) -> Option<&RefCell<TableManager>> {\n    rel.mgmt_data\n        .as_ref()\n        .and_then(|b| b.downcast_ref::<RefCell<TableManager>>())\n}\n\npub fn get_num_tuples(rel: &RM_TableData) -> i32 {\n    match tm_ref(rel) {\n        Some(c) => c.borrow().total_tuples,\n        None => -1,\n    }\n}\n\nfn slots_per_page(rec_size: i32) -> i32 {\n    (page_size() as i32 - PAGE_HEADER_SIZE as i32) / (rec_size + 2)\n}\n\npub fn insert_record(rel: &mut RM_TableData, record: &Record) -> RC {\n    let cell = match tm_ref(rel) {\n        Some(c) => c,\n        None => return RC::Error,\n    };\n    let mut tm = cell.borrow_mut();\n    let rec_size = tm.rec_size;\n    let slots = slots_per_page(rec_size);\n\n    let target_page = tm.first_free_page_num;\n    let target_slot = tm.first_free_slot_num;\n\n    // Take owned page and bp temporarily.\n    let mut bp = tm.buffer_pool.take().unwrap_or_else(|| BM_BufferPool {\n        page_file: String::new(),\n        num_pages: 0,\n        strategy: ReplacementStrategy::RsFifo,\n        mgmt_data: None,\n    });\n    let mut page = tm\n        .page_handler\n        .take()\n        .unwrap_or_else(|| BM_PageHandle { page_num: 0, data: make_zero_str(page_size()) });\n\n    let rc = pin_page(&mut bp, &mut page, target_page);\n    if rc != RC::Ok {\n        tm.buffer_pool = Some(bp);\n        tm.page_handler = Some(page);\n        return RC::Error;\n    }\n\n    {\n        ensure_page_capacity(&mut page);\n        let buf = data_as_mut(&mut page);\n        let mut header = read_page_header(buf);\n        if header.page_identifier != 'Y' {\n            header.page_identifier = 'Y';\n            header.total_tuples = 0;\n            header.free_slot_cnt = slots - 1;\n            header.next_free_slot_ind = 1;\n            header.prev_free_page_index = -1;\n            header.next_free_page_index = target_page + 1;\n            header.prev_data_page_index = -1;\n            header.next_data_page_index = 1;\n        } else {\n            header.total_tuples += 1;\n            header.free_slot_cnt -= 1;\n            if header.free_slot_cnt > 0 {\n                header.next_free_slot_ind += 1;\n            } else {\n                header.next_free_slot_ind = -header.next_free_slot_ind;\n            }\n        }\n        let pos = PAGE_HEADER_SIZE + (target_slot as usize) * (rec_size as usize + 2);\n        buf[pos] = b'Y';\n        let rd = record.data.as_bytes();\n        let take = rd.len().min(rec_size as usize);\n        buf[pos + 1..pos + 1 + take].copy_from_slice(&rd[..take]);\n        // remaining bytes within record area zeroed (already are)\n        buf[pos + rec_size as usize + 1] = b'|';\n\n        write_page_header(buf, &header);\n\n        if header.free_slot_cnt == 0 {\n            tm.first_free_page_num += 1;\n            tm.first_free_slot_num = 0;\n        } else {\n            tm.first_free_slot_num += 1;\n        }\n    }\n\n    tm.total_tuples += 1;\n\n    let dirty_status = mark_dirty(&mut bp, &mut page);\n    let unpin_status = unpin_page(&mut bp, &mut page);\n\n    // Mirror C's behavior: insertRecord mutates the input record's id field\n    // through a pointer. The Rust signature is `&Record`, so we need to update\n    // through interior mutability. Since the public Record struct does not use\n    // Cell, we use a raw-pointer cast. The caller is the unique owner during\n    // this call, matching the C contract.\n    #[allow(invalid_reference_casting)]\n    unsafe {\n        let r_mut = &record.id as *const RID as *mut RID;\n        std::ptr::write(r_mut, RID { page: target_page, slot: target_slot });\n    }\n\n    tm.buffer_pool = Some(bp);\n    tm.page_handler = Some(page);\n\n    if dirty_status != RC::Ok || unpin_status != RC::Ok {\n        return RC::Error;\n    }\n    RC::Ok\n}\n\npub fn delete_record(rel: &mut RM_TableData, id: &RID) -> RC {\n    let cell = match tm_ref(rel) {\n        Some(c) => c,\n        None => return RC::Error,\n    };\n    let mut tm = cell.borrow_mut();\n    let rec_size = tm.rec_size;\n    let slots = slots_per_page(rec_size);\n    if id.slot >= slots {\n        return RC::RecordNotFound;\n    }\n    let mut bp = tm.buffer_pool.take().unwrap();\n    let mut page = tm.page_handler.take().unwrap();\n\n    let rc = pin_page(&mut bp, &mut page, id.page);\n    if rc != RC::Ok {\n        tm.buffer_pool = Some(bp);\n        tm.page_handler = Some(page);\n        return rc;\n    }\n    let mut not_found = false;\n    {\n        ensure_page_capacity(&mut page);\n        let buf = data_as_mut(&mut page);\n        let pos = PAGE_HEADER_SIZE + (id.slot as usize) * (rec_size as usize + 2);\n        if buf[pos] != b'Y' {\n            not_found = true;\n        } else {\n            buf[pos] = b'N';\n            let mut header = read_page_header(buf);\n            header.total_tuples = (header.total_tuples - 1).max(0);\n            header.free_slot_cnt += 1;\n            write_page_header(buf, &header);\n        }\n    }\n    if not_found {\n        let _ = unpin_page(&mut bp, &mut page);\n        tm.buffer_pool = Some(bp);\n        tm.page_handler = Some(page);\n        return RC::RecordNotFound;\n    }\n    tm.total_tuples = (tm.total_tuples - 1).max(0);\n\n    let dirty_rc = mark_dirty(&mut bp, &mut page);\n    if dirty_rc != RC::Ok {\n        let _ = unpin_page(&mut bp, &mut page);\n        tm.buffer_pool = Some(bp);\n        tm.page_handler = Some(page);\n        return RC::Error;\n    }\n    let unpin_rc = unpin_page(&mut bp, &mut page);\n    tm.buffer_pool = Some(bp);\n    tm.page_handler = Some(page);\n    if unpin_rc != RC::Ok {\n        return unpin_rc;\n    }\n    RC::Ok\n}\n\npub fn update_record(rel: &mut RM_TableData, record: &Record) -> RC {\n    let cell = match tm_ref(rel) {\n        Some(c) => c,\n        None => return RC::Error,\n    };\n    let mut tm = cell.borrow_mut();\n    let rec_size = tm.rec_size;\n    let slots = slots_per_page(rec_size);\n    if record.id.slot >= slots {\n        return RC::RecordNotFound;\n    }\n    let mut bp = tm.buffer_pool.take().unwrap();\n    let mut page = tm.page_handler.take().unwrap();\n\n    let rc = pin_page(&mut bp, &mut page, record.id.page);\n    if rc != RC::Ok {\n        tm.buffer_pool = Some(bp);\n        tm.page_handler = Some(page);\n        return RC::Error;\n    }\n    let mut not_found = false;\n    {\n        ensure_page_capacity(&mut page);\n        let buf = data_as_mut(&mut page);\n        let pos = PAGE_HEADER_SIZE + (record.id.slot as usize) * (rec_size as usize + 2);\n        if buf[pos] != b'Y' {\n            not_found = true;\n        } else {\n            let rd = record.data.as_bytes();\n            let take = rd.len().min(rec_size as usize);\n            buf[pos + 1..pos + 1 + take].copy_from_slice(&rd[..take]);\n        }\n    }\n    if not_found {\n        let _ = unpin_page(&mut bp, &mut page);\n        tm.buffer_pool = Some(bp);\n        tm.page_handler = Some(page);\n        return RC::RecordNotFound;\n    }\n    let dirty_rc = mark_dirty(&mut bp, &mut page);\n    let unpin_rc = unpin_page(&mut bp, &mut page);\n    tm.buffer_pool = Some(bp);\n    tm.page_handler = Some(page);\n    if dirty_rc != RC::Ok || unpin_rc != RC::Ok {\n        return RC::Error;\n    }\n    RC::Ok\n}\n\npub fn get_record(rel: &RM_TableData, id: &RID, record: &mut Record) -> RC {\n    let cell = match tm_ref(rel) {\n        Some(c) => c,\n        None => return RC::Error,\n    };\n    let mut tm = cell.borrow_mut();\n    let rec_size = tm.rec_size;\n    let slots = slots_per_page(rec_size);\n    if id.slot >= slots {\n        return RC::RecordNotFound;\n    }\n\n    let mut bp = tm.buffer_pool.take().unwrap();\n    let mut page = tm.page_handler.take().unwrap();\n\n    let rc = pin_page(&mut bp, &mut page, id.page);\n    if rc != RC::Ok {\n        tm.buffer_pool = Some(bp);\n        tm.page_handler = Some(page);\n        return RC::Error;\n    }\n    let mut not_found = false;\n    {\n        ensure_page_capacity(&mut page);\n        let buf = data_as(&page);\n        let pos = PAGE_HEADER_SIZE + (id.slot as usize) * (rec_size as usize + 2);\n        if buf[pos] != b'Y' {\n            not_found = true;\n        } else {\n            let src = &buf[pos + 1..pos + 1 + rec_size as usize];\n            // Set record.data to be exactly rec_size bytes (or larger if pre-allocated)\n            ensure_record_capacity(record, rec_size as usize);\n            unsafe {\n                let v = record.data.as_mut_vec();\n                v[..rec_size as usize].copy_from_slice(src);\n            }\n            record.id = id.clone();\n        }\n    }\n    let unpin_rc = unpin_page(&mut bp, &mut page);\n    tm.buffer_pool = Some(bp);\n    tm.page_handler = Some(page);\n    if not_found {\n        return RC::RecordNotFound;\n    }\n    unpin_rc\n}\n\nfn ensure_record_capacity(record: &mut Record, n: usize) {\n    let bytes = record.data.as_bytes();\n    if bytes.len() < n {\n        let mut v = std::mem::take(&mut record.data).into_bytes();\n        v.resize(n, 0);\n        record.data = unsafe { String::from_utf8_unchecked(v) };\n    }\n}\n\npub fn start_scan(rel: &RM_TableData, scan: &mut RM_ScanHandle, cond: &Expr) -> RC {\n    let cell = match tm_ref(rel) {\n        Some(c) => c,\n        None => return RC::Error,\n    };\n    let tm = cell.borrow();\n    let total_entries = tm.total_tuples;\n    let first_data_page_num = tm.first_data_page_num;\n    drop(tm);\n\n    let scan_mgr = ScanManager {\n        total_entries,\n        scan_index: 0,\n        current_page_num: first_data_page_num,\n        current_slot_num: -1,\n        condition_expression: Some(cond.clone()),\n        scan_page_handle_ptr: None,\n    };\n    scan.mgmt_data = Some(Box::new(scan_mgr));\n    // We need next() to access the original rel's TableManager state. Save a\n    // pointer-as-usize to the original rel; the caller must keep rel alive for\n    // the duration of the scan.\n    let rel_ptr = rel as *const RM_TableData as usize;\n    scan.rel = RM_TableData {\n        name: rel.name.clone(),\n        schema: rel.schema.clone(),\n        mgmt_data: Some(Box::new(rel_ptr)),\n    };\n    RC::Ok\n}\n\npub fn next(scan: &mut RM_ScanHandle, record: &mut Record) -> RC {\n    // Recover the original rel pointer\n    let rel_ptr: usize = match scan\n        .rel\n        .mgmt_data\n        .as_ref()\n        .and_then(|b| b.downcast_ref::<usize>())\n    {\n        Some(p) => *p,\n        None => return RC::Error,\n    };\n    let rel: &RM_TableData = unsafe { &*(rel_ptr as *const RM_TableData) };\n    let cell = match tm_ref(rel) {\n        Some(c) => c,\n        None => return RC::Error,\n    };\n    let rec_size = cell.borrow().rec_size;\n    let slots = slots_per_page(rec_size);\n\n    let scan_mgr = match scan\n        .mgmt_data\n        .as_mut()\n        .and_then(|b| b.downcast_mut::<ScanManager>())\n    {\n        Some(s) => s,\n        None => return RC::Error,\n    };\n    if scan_mgr.scan_index >= scan_mgr.total_entries {\n        return RC::RmNoMoreTuples;\n    }\n\n    let cond = scan_mgr.condition_expression.clone();\n    let mut eval_result = Value {\n        dt: DataType::DtInt,\n        v: ValueUnion::IntV(-1),\n    };\n\n    loop {\n        scan_mgr.current_slot_num += 1;\n        if scan_mgr.current_slot_num >= slots {\n            scan_mgr.current_page_num += 1;\n            scan_mgr.current_slot_num = 0;\n        }\n        let cur_id = RID {\n            page: scan_mgr.current_page_num,\n            slot: scan_mgr.current_slot_num,\n        };\n        let rc = get_record(rel, &cur_id, record);\n        if rc == RC::Ok {\n            scan_mgr.scan_index += 1;\n            match &cond {\n                Some(c) => {\n                    // Treat the \"no condition\" sentinel: a const-true bool returns true.\n                    let rc = crate::expr::eval_expr(record, &rel.schema, c, &mut eval_result);\n                    if rc != RC::Ok {\n                        return rc;\n                    }\n                    if let ValueUnion::BoolV(true) = eval_result.v {\n                        return RC::Ok;\n                    }\n                }\n                None => {\n                    return RC::Ok;\n                }\n            }\n        }\n        if scan_mgr.scan_index >= scan_mgr.total_entries {\n            return RC::RmNoMoreTuples;\n        }\n    }\n}\n\npub fn close_scan(scan: &mut RM_ScanHandle) -> RC {\n    scan.mgmt_data = None;\n    scan.rel.mgmt_data = None;\n    RC::Ok\n}\n\npub fn get_record_size(schema: &Schema) -> i32 {\n    let mut total = 0i32;\n    for i in 0..(schema.num_attr as usize) {\n        let dt = &schema.data_types[i];\n        let len = schema.type_length[i];\n        match dt {\n            DataType::DtString => total += len,\n            DataType::DtInt => total += std::mem::size_of::<i32>() as i32,\n            DataType::DtFloat => total += std::mem::size_of::<f32>() as i32,\n            DataType::DtBool => total += std::mem::size_of::<bool>() as i32,\n        }\n    }\n    let pad = total % 4;\n    if pad != 0 {\n        total += 4 - pad;\n    }\n    total\n}\n\npub fn create_schema(\n    num_attr: i32,\n    attr_names: Vec<String>,\n    data_types: Vec<DataType>,\n    type_length: Vec<i32>,\n    key_size: i32,\n    keys: Vec<i32>,\n) -> Schema {\n    Schema {\n        num_attr,\n        attr_names,\n        data_types,\n        type_length,\n        key_attrs: keys,\n        key_size,\n    }\n}\n\npub fn free_schema(_schema: &mut Schema) -> RC {\n    RC::Ok\n}\n\npub fn create_record(record: &mut Option<Record>, schema: &Schema) -> RC {\n    let rec_size = get_record_size(schema);\n    let data = make_zero_str(rec_size as usize + 1);\n    *record = Some(Record {\n        id: RID { page: 0, slot: 0 },\n        data,\n    });\n    RC::Ok\n}\n\npub fn free_record(_record: &mut Record) -> RC {\n    RC::Ok\n}\n\npub fn get_attr(record: &Record, schema: &Schema, attr_num: i32, value: &mut Value) -> RC {\n    let idx = attr_num as usize;\n    let dt = &schema.data_types[idx];\n    value.dt = dt.clone();\n    let pos = get_attr_pos(schema, attr_num) as usize;\n    let bytes = record.data.as_bytes();\n    match dt {\n        DataType::DtString => {\n            let len = schema.type_length[idx] as usize;\n            let end = (pos + len).min(bytes.len());\n            let raw = if pos < bytes.len() {\n                &bytes[pos..end]\n            } else {\n                &bytes[..0]\n            };\n            let truncated: Vec<u8> = raw.iter().cloned().take_while(|&b| b != 0).collect();\n            // Pad with zero bytes if shorter than len? C uses strncpy then a zero-padded buffer.\n            // For comparison purposes (memcmp), strncpy zero-fills the remaining bytes.\n            // Here we keep the trimmed string for the Value.\n            let s = String::from_utf8_lossy(&truncated).to_string();\n            // Replicate strncpy padding behaviour by storing exactly len bytes\n            // (zero-padded) inside the StringV.\n            let mut padded = vec![0u8; len];\n            let n = truncated.len().min(len);\n            padded[..n].copy_from_slice(&truncated[..n]);\n            // For test compatibility we keep just the trimmed text.\n            let _ = s;\n            value.v = ValueUnion::StringV(\n                String::from_utf8_lossy(&padded[..n]).to_string(),\n            );\n        }\n        DataType::DtInt => {\n            value.v = ValueUnion::IntV(read_i32(bytes, pos));\n        }\n        DataType::DtFloat => {\n            let mut b = [0u8; 4];\n            let take = (bytes.len() - pos.min(bytes.len())).min(4);\n            if take > 0 {\n                b[..take].copy_from_slice(&bytes[pos..pos + take]);\n            }\n            value.v = ValueUnion::FloatV(f32::from_ne_bytes(b));\n        }\n        DataType::DtBool => {\n            let v = if pos < bytes.len() { bytes[pos] != 0 } else { false };\n            value.v = ValueUnion::BoolV(v);\n        }\n    }\n    RC::Ok\n}\n\npub fn set_attr(record: &mut Record, schema: &Schema, attr_num: i32, value: &Value) -> RC {\n    let idx = attr_num as usize;\n    let pos = get_attr_pos(schema, attr_num) as usize;\n    ensure_record_capacity(\n        record,\n        pos + match schema.data_types[idx] {\n            DataType::DtString => schema.type_length[idx] as usize,\n            DataType::DtInt | DataType::DtFloat => 4,\n            DataType::DtBool => 1,\n        },\n    );\n    let buf = unsafe { record.data.as_mut_vec() };\n    match (&schema.data_types[idx], &value.v) {\n        (DataType::DtInt, ValueUnion::IntV(i)) => {\n            buf[pos..pos + 4].copy_from_slice(&i.to_ne_bytes());\n        }\n        (DataType::DtFloat, ValueUnion::FloatV(f)) => {\n            buf[pos..pos + 4].copy_from_slice(&f.to_ne_bytes());\n        }\n        (DataType::DtBool, ValueUnion::BoolV(b)) => {\n            buf[pos] = if *b { 1 } else { 0 };\n        }\n        (DataType::DtString, ValueUnion::StringV(s)) => {\n            let len = schema.type_length[idx] as usize;\n            // memcpy(target, value->v.stringV, schema->typeLength[attrNum]);\n            let bytes = s.as_bytes();\n            let take = bytes.len().min(len);\n            buf[pos..pos + take].copy_from_slice(&bytes[..take]);\n            // Zero remainder so the slot has consistent contents.\n            for i in pos + take..pos + len {\n                buf[i] = 0;\n            }\n        }\n        _ => {}\n    }\n    RC::Ok\n}\n\npub fn get_attr_pos(schema: &Schema, attr_num: i32) -> i32 {\n    let mut pos = 0i32;\n    for i in 0..(attr_num as usize) {\n        match schema.data_types[i] {\n            DataType::DtString => pos += schema.type_length[i],\n            DataType::DtInt => pos += std::mem::size_of::<i32>() as i32,\n            DataType::DtFloat => pos += std::mem::size_of::<f32>() as i32,\n            DataType::DtBool => pos += std::mem::size_of::<bool>() as i32,\n        }\n    }\n    pos\n}\n","numLines":914,"startLine":1,"totalLines":914}}}
