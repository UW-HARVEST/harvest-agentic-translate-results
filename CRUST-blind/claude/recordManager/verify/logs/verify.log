{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FqvMq4KWB9MUHbsEMbP6x2","type":"tool_result","content":"1\tuse crate::dberror::{PAGE_SIZE, RC};\n2\tuse crate::storage_mgr::{\n3\t    close_page_file, ensure_capacity, open_page_file, read_block, write_block, SM_FileHandle,\n4\t};\n5\tuse std::cell::RefCell;\n6\t\n7\tpub struct Bufferpool {\n8\t    pub num_read: i32,\n9\t    pub num_write: i32,\n10\t    pub total_pages: i32,\n11\t    pub updated_strategy: i32,\n12\t    pub free_space: i32,\n13\t    pub updated_order: Vec<i32>,\n14\t    pub bitdirty: Vec<bool>,\n15\t    pub fix_count: Vec<i32>,\n16\t    pub access_time: Vec<i32>,\n17\t    pub pagenum: Vec<i32>,\n18\t    pub pagedata: String,\n19\t    pub fhl: SM_FileHandle,\n20\t}\n21\t\n22\tpub struct BM_PageHandle {\n23\t    pub page_num: PageNumber,\n24\t    pub data: String,\n25\t}\n26\t\n27\tpub type PageNumber = i32;\n28\tpub const NO_PAGE: PageNumber = -1;\n29\t\n30\t#[derive(Clone, Copy, PartialEq, Eq)]\n31\tpub enum ReplacementStrategy {\n32\t    RsFifo = 0,\n33\t    RsLru = 1,\n34\t    RsClock = 2,\n35\t    RsLfu = 3,\n36\t    RsLruK = 4,\n37\t}\n38\t\n39\tpub struct BM_BufferPool {\n40\t    pub page_file: String,\n41\t    pub num_pages: i32,\n42\t    pub strategy: ReplacementStrategy,\n43\t    pub mgmt_data: Option<Box<dyn std::any::Any>>,\n44\t}\n45\t\n46\tfn page_size() -> usize {\n47\t    PAGE_SIZE as usize\n48\t}\n49\t\n50\tfn make_zero_str(n: usize) -> String {\n51\t    // SAFETY: All-zero bytes form valid UTF-8.\n52\t    unsafe { String::from_utf8_unchecked(vec![0u8; n]) }\n53\t}\n54\t\n55\tfn write_bytes_into(dst: &mut String, dst_off: usize, src: &[u8]) {\n56\t    // SAFETY: We are writing arbitrary bytes into the String's heap storage,\n57\t    // which may produce non-UTF-8 content. The internal buffer is sized\n58\t    // correctly by the caller.\n59\t    unsafe {\n60\t        let v = dst.as_mut_vec();\n61\t        if dst_off + src.len() > v.len() {\n62\t            v.resize(dst_off + src.len(), 0);\n63\t        }\n64\t        v[dst_off..dst_off + src.len()].copy_from_slice(src);\n65\t    }\n66\t}\n67\t\n68\tfn read_bytes_from(src: &str, off: usize, len: usize) -> Vec<u8> {\n69\t    let bytes = src.as_bytes();\n70\t    let end = (off + len).min(bytes.len());\n71\t    let mut out = vec![0u8; len];\n72\t    if off < bytes.len() {\n73\t        let avail = end - off;\n74\t        out[..avail].copy_from_slice(&bytes[off..end]);\n75\t    }\n76\t    out\n77\t}\n78\t\n79\tfn with_pool<R>(bm: &BM_BufferPool, f: impl FnOnce(&Bufferpool) -> R) -> Option<R> {\n80\t    bm.mgmt_data\n81\t        .as_ref()\n82\t        .and_then(|b| b.downcast_ref::<RefCell<Bufferpool>>())\n83\t        .map(|cell| f(&cell.borrow()))\n84\t}\n85\t\n86\tfn with_pool_mut<R>(bm: &mut BM_BufferPool, f: impl FnOnce(&mut Bufferpool) -> R) -> Option<R> {\n87\t    bm.mgmt_data\n88\t        .as_mut()\n89\t        .and_then(|b| b.downcast_mut::<RefCell<Bufferpool>>())\n90\t        .map(|cell| f(cell.get_mut()))\n91\t}\n92\t\n93\tpub fn init_buffer_pool(\n94\t    bm: &mut BM_BufferPool,\n95\t    page_file_name: &str,\n96\t    num_pages: i32,\n97\t    strategy: ReplacementStrategy,\n98\t    _strat_data: Option<Box<dyn std::any::Any>>,\n99\t) -> RC {\n100\t    let mut fh = SM_FileHandle {\n101\t        file_name: String::new(),\n102\t        total_num_pages: 0,\n103\t        cur_page_pos: 0,\n104\t        mgmt_info: None,\n105\t    };\n106\t    let rc = open_page_file(page_file_name, &mut fh);\n107\t    if rc != RC::Ok {\n108\t        return rc;\n109\t    }\n110\t    let n = num_pages as usize;\n111\t    let bp = Bufferpool {\n112\t        num_read: 0,\n113\t        num_write: 0,\n114\t        total_pages: num_pages,\n115\t        updated_strategy: strategy as i32,\n116\t        free_space: num_pages,\n117\t        updated_order: vec![NO_PAGE; n],\n118\t        bitdirty: vec![false; n],\n119\t        fix_count: vec![0; n],\n120\t        access_time: vec![0; n],\n121\t        pagenum: vec![NO_PAGE; n],\n122\t        pagedata: make_zero_str(n * page_size()),\n123\t        fhl: fh,\n124\t    };\n125\t    bm.page_file = page_file_name.to_string();\n126\t    bm.num_pages = num_pages;\n127\t    bm.strategy = strategy;\n128\t    bm.mgmt_data = Some(Box::new(RefCell::new(bp)));\n129\t    RC::Ok\n130\t}\n131\t\n132\tfn write_dirty_pages(bp: &mut Bufferpool) -> RC {\n133\t    for j in 0..(bp.total_pages as usize) {\n134\t        if bp.bitdirty[j] {\n135\t            let record_pointer = j * page_size();\n136\t            let rc = ensure_capacity(bp.pagenum[j] + 1, &mut bp.fhl);\n137\t            if rc != RC::Ok {\n138\t                return rc;\n139\t            }\n140\t            let data = read_bytes_from(&bp.pagedata, record_pointer, page_size());\n141\t            let buf_str = unsafe { String::from_utf8_unchecked(data) };\n142\t            let rc = write_block(bp.pagenum[j], &mut bp.fhl, &buf_str);\n143\t            if rc != RC::Ok {\n144\t                return RC::WriteFailed;\n145\t            }\n146\t            bp.num_write += 1;\n147\t        }\n148\t    }\n149\t    RC::Ok\n150\t}\n151\t\n152\tpub fn shutdown_buffer_pool(bm: &mut BM_BufferPool) -> RC {\n153\t    let rc_pool = with_pool_mut(bm, |bp| {\n154\t        for i in 0..(bp.total_pages as usize) {\n155\t            if bp.fix_count[i] != 0 {\n156\t                return RC::BufferpoolInUse;\n157\t            }\n158\t        }\n159\t        let rc = write_dirty_pages(bp);\n160\t        if rc != RC::Ok {\n161\t            return rc;\n162\t        }\n163\t        if close_page_file(&mut bp.fhl) != RC::Ok {\n164\t            return RC::CloseFailed;\n165\t        }\n166\t        RC::Ok\n167\t    });\n168\t    let rc = match rc_pool {\n169\t        Some(r) => r,\n170\t        None => return RC::Error,\n171\t    };\n172\t    if rc != RC::Ok {\n173\t        return rc;\n174\t    }\n175\t    bm.mgmt_data = None;\n176\t    RC::Ok\n177\t}\n178\t\n179\tpub fn force_flush_pool(bm: &mut BM_BufferPool) -> RC {\n180\t    with_pool_mut(bm, |bp| {\n181\t        for i in 0..(bp.total_pages as usize) {\n182\t            if bp.fix_count[i] == 0 && bp.bitdirty[i] {\n183\t                let record_pointer = i * page_size();\n184\t                let rc = ensure_capacity(bp.pagenum[i] + 1, &mut bp.fhl);\n185\t                if rc != RC::Ok {\n186\t                    return rc;\n187\t                }\n188\t                let data = read_bytes_from(&bp.pagedata, record_pointer, page_size());\n189\t                let buf_str = unsafe { String::from_utf8_unchecked(data) };\n190\t                let rc = write_block(bp.pagenum[i], &mut bp.fhl, &buf_str);\n191\t                if rc != RC::Ok {\n192\t                    return RC::WriteFailed;\n193\t                }\n194\t                bp.bitdirty[i] = false;\n195\t                bp.num_write += 1;\n196\t            }\n197\t        }\n198\t        RC::Ok\n199\t    })\n200\t    .unwrap_or(RC::Error)\n201\t}\n202\t\n203\t/// Sync the local page handle's data back into the buffer pool's cache.\n204\t/// This emulates C's pointer-aliased page data semantics where edits to the\n205\t/// page handle directly modify the buffer pool's storage.\n206\tfn sync_page_to_cache(bp: &mut Bufferpool, page: &BM_PageHandle) {\n207\t    for i in 0..(bp.total_pages as usize) {\n208\t        if bp.pagenum[i] == page.page_num {\n209\t            let off = i * page_size();\n210\t            let bytes = page.data.as_bytes();\n211\t            let n = page_size().min(bytes.len());\n212\t            // SAFETY: write raw bytes into the pre-sized cache buffer.\n213\t            unsafe {\n214\t                let v = bp.pagedata.as_mut_vec();\n215\t                if v.len() < off + page_size() {\n216\t                    v.resize(off + page_size(), 0);\n217\t                }\n218\t                v[off..off + n].copy_from_slice(&bytes[..n]);\n219\t                if n < page_size() {\n220\t                    for j in off + n..off + page_size() {\n221\t                        v[j] = 0;\n222\t                    }\n223\t                }\n224\t            }\n225\t            break;\n226\t        }\n227\t    }\n228\t}\n229\t\n230\tpub fn mark_dirty(bm: &mut BM_BufferPool, page: &mut BM_PageHandle) -> RC {\n231\t    with_pool_mut(bm, |bp| {\n232\t        sync_page_to_cache(bp, page);\n233\t        for i in 0..(bp.total_pages as usize) {\n234\t            if bp.pagenum[i] == page.page_num {\n235\t                bp.bitdirty[i] = true;\n236\t                break;\n237\t            }\n238\t        }\n239\t        RC::Ok\n240\t    })\n241\t    .unwrap_or(RC::Error)\n242\t}\n243\t\n244\tpub fn unpin_page(bm: &mut BM_BufferPool, page: &mut BM_PageHandle) -> RC {\n245\t    with_pool_mut(bm, |bp| {\n246\t        sync_page_to_cache(bp, page);\n247\t        for i in 0..(bp.total_pages as usize) {\n248\t            if bp.pagenum[i] == page.page_num {\n249\t                if bp.fix_count[i] > 0 {\n250\t                    bp.fix_count[i] -= 1;\n251\t                }\n252\t                break;\n253\t            }\n254\t        }\n255\t        RC::Ok\n256\t    })\n257\t    .unwrap_or(RC::Error)\n258\t}\n259\t\n260\tpub fn force_page(bm: &mut BM_BufferPool, page: &mut BM_PageHandle) -> RC {\n261\t    with_pool_mut(bm, |bp| {\n262\t        sync_page_to_cache(bp, page);\n263\t        let mut found = false;\n264\t        for i in 0..(bp.total_pages as usize) {\n265\t            if bp.pagenum[i] == page.page_num {\n266\t                bp.bitdirty[i] = false;\n267\t                bp.num_write += 1;\n268\t                found = true;\n269\t                break;\n270\t            }\n271\t        }\n272\t        if found {\n273\t            RC::Ok\n274\t        } else {\n275\t            RC::WriteFailed\n276\t        }\n277\t    })\n278\t    .unwrap_or(RC::Error)\n279\t}\n280\t\n281\tpub fn pin_page(bm: &mut BM_BufferPool, page: &mut BM_PageHandle, page_num: PageNumber) -> RC {\n282\t    with_pool_mut(bm, |bp| pin_page_inner(bp, page, page_num)).unwrap_or(RC::Error)\n283\t}\n284\t\n285\tfn pin_page_inner(bp: &mut Bufferpool, page: &mut BM_PageHandle, page_num: PageNumber) -> RC {\n286\t    let void_page = bp.free_space == bp.total_pages;\n287\t    // Search if the page is already in the buffer pool\n288\t    if !void_page {\n289\t        let used = (bp.total_pages - bp.free_space) as usize;\n290\t        for i in 0..used {\n291\t            if bp.pagenum[i] == page_num {\n292\t                page.page_num = page_num;\n293\t                bp.fix_count[i] += 1;\n294\t                let off = i * page_size();\n295\t                let data = read_bytes_from(&bp.pagedata, off, page_size());\n296\t                page.data = unsafe { String::from_utf8_unchecked(data) };\n297\t\n298\t                if bp.updated_strategy == ReplacementStrategy::RsLru as i32 {\n299\t                    let last_pos = (bp.total_pages - bp.free_space - 1) as usize;\n300\t                    let mut swap_loc: Option<usize> = None;\n301\t                    for j in 0..=last_pos {\n302\t                        if bp.updated_order[j] == page_num {\n303\t                            swap_loc = Some(j);\n304\t                            break;\n305\t                        }\n306\t                    }\n307\t                    if let Some(swap) = swap_loc {\n308\t                        for k in swap..last_pos {\n309\t                            bp.updated_order[k] = bp.updated_order[k + 1];\n310\t                        }\n311\t                        bp.updated_order[last_pos] = page_num;\n312\t                    }\n313\t                }\n314\t                return RC::Ok;\n315\t            }\n316\t        }\n317\t    }\n318\t\n319\t    // Free space available -- read into next slot\n320\t    if void_page || bp.free_space > 0 {\n321\t        let memory_address = (bp.total_pages - bp.free_space) as usize;\n322\t        let record_pointer = memory_address * page_size();\n323\t        let mut handl