225\t    let pn = f_handle.cur_page_pos;\n226\t    if pn < 0 || pn >= f_handle.total_num_pages {\n227\t        return RC::ReadNonExistingPage;\n228\t    }\n229\t    read_block(pn, f_handle, mem_page)\n230\t}\n231\t\n232\tpub fn read_next_block(f_handle: &mut SM_FileHandle, mem_page: &mut SM_PageHandle) -> RC {\n233\t    let page_num = f_handle.cur_page_pos + 1;\n234\t    read_block(page_num, f_handle, mem_page)\n235\t}\n236\t\n237\tpub fn read_last_block(f_handle: &mut SM_FileHandle, mem_page: &mut SM_PageHandle) -> RC {\n238\t    let pn = f_handle.total_num_pages - 1;\n239\t    if pn < 0 {\n240\t        return RC::ReadNonExistingPage;\n241\t    }\n242\t    read_block(pn, f_handle, mem_page)\n243\t}\n244\t\n245\tpub fn write_block(page_num: i32, f_handle: &mut SM_FileHandle, mem_page: &SM_PageHandle) -> RC {\n246\t    if page_num < 0 {\n247\t        return RC::WriteFailed;\n248\t    }\n249\t    if f_handle.mgmt_info.is_none() {\n250\t        return RC::FileNotFound;\n251\t    }\n252\t    let offset = (page_num as u64 + 1) * page_size() as u64;\n253\t    let mut increment_pages = false;\n254\t    {\n255\t        let mgmt = match get_file_mut(f_handle) {\n256\t            Some(m) => m,\n257\t            None => return RC::FileNotFound,\n258\t        };\n259\t        let mut file = mgmt.file.borrow_mut();\n260\t        let file_size = match file.seek(SeekFrom::End(0)) {\n261\t            Ok(p) => p,\n262\t            Err(_) => return RC::SeekFailed,\n263\t        };\n264\t        if offset > file_size {\n265\t            if page_num == f_handle.total_num_pages {\n266\t                if file.seek(SeekFrom::Start(file_size)).is_err() {\n267\t                    return RC::SeekFailed;\n268\t                }\n269\t                let pad = vec![0u8; (offset - file_size) as usize];\n270\t                if file.write_all(&pad).is_err() {\n271\t                    return RC::WriteFailed;\n272\t                }\n273\t                increment_pages = true;\n274\t          