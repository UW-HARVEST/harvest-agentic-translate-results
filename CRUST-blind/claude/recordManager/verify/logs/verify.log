nt);\n\t\t\tbreak;\n\t\tcase DT_FLOAT:\n\t\t\toffset += sizeof(float);\n\t\t\tbreak;\n\t\tcase DT_BOOL:\n\t\t\toffset += sizeof(bool);\n\t\t\tbreak;\n\t\t}\n\n\t*result = offset;\n\treturn RC_OK;\n}\n","numLines":312,"startLine":1,"totalLines":312}}}
