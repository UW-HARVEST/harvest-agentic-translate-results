T requires boolean input\");\n66\t\tresult->dt = DT_BOOL;\n67\t\tresult->v.boolV = !(input->v.boolV);\n68\t\n69\t\treturn RC_OK;\n70\t}\n71\t\n72\tRC\n73\tboolAnd (Value *left, Value *right, Value *result)\n74\t{\n75\t\tif (left->dt != DT_BOOL || right->dt != DT_BOOL)\n76\t\t\tTHROW(RC_RM_BOOLEAN_EXPR_ARG_IS_NOT_BOOLEAN, \"boolean AND requires boolean inputs\");\n77\t\tresult->v.boolV = (left->v.boolV && right->v.boolV);\n78\t\n79\t\treturn RC_OK;\n80\t}\n81\t\n82\tRC\n83\tboolOr (Value *left, Value *right, Value *result)\n84\t{\n85\t\tif (left->dt != DT_BOOL || right->dt != DT_BOOL)\n86\t\t\tTHROW(RC_RM_BOOLEAN_EXPR_ARG_IS_NOT_BOOLEAN, \"boolean OR requires boolean inputs\");\n87\t\tresult->v.boolV = (left->v.boolV || right->v.boolV);\n88\t\n89\t\treturn RC_OK;\n90\t}\n91\t\n92\tRC\n93\tevalExpr (Record *record, Schema *schema, Expr *expr, Value **result)\n94\t{\n95\t\tValue *lIn;\n96\t\tValue *rIn;\n97\t\tMAKE_VALUE(*result, DT_INT, -1);\n98\t\n99\t\tswitch(expr->type)\n100\t\t{\n101\t\tcase EXPR_OP:\n102\t\t{\n103\t\t\tOperator *op = expr->expr.op;\n104\t\t\tbool twoArgs = (op->type != OP_BOOL_NOT);\n105\t\t\t//      lIn = (Value *) malloc(sizeof(Value));\n106\t\t\t//    rIn = (Value *) malloc(sizeof(Value));\n107\t\n108\t\t\tCHECK(evalExpr(record, schema, op->args[0], &lIn));\n109\t\t\tif (twoArgs)\n110\t\t\t\tCHECK(evalExpr(record, schema, op->args[1], &rIn));\n111\t\n112\t\t\tswitch(op->type)\n113\t\t\t{\n114\t\t\tcase OP_BOOL_NOT:\n115\t\t\t\tCHECK(boolNot(lIn, *result));\n116\t\t\t\tbreak;\n117\t\t\tcase OP_BOOL_AND:\n118\t\t\t\tCHECK(boolAnd(lIn, rIn, *result));\n119\t\t\t\tbreak;\n120\t\t\tcase OP_BOOL_OR:\n121\t\t\t\tCHECK(boolOr(lIn, rIn, *result));\n122\t\t\t\tbreak;\n123\t\t\tcase OP_COMP_EQUAL:\n124\t\t\t\tCHECK(valueEquals(lIn, rIn, *result));\n125\t\t\t\tbreak;\n126\t\t\tcase OP_COMP_SMALLER:\n127\t\t\t\tCHECK(valueSmaller(lIn, rIn, *result));\n128\t\t\t\tbreak;\n129\t\t\tdefault:\n130\t\t\t\tbreak;\n131\t\t\t}\n132\t\n133\t\t\t// cleanup\n134\t\t\t