{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019jqfLWLYYH2DWzMSkrsipS","type":"tool_result","content":"1\tuse crate::dberror::{PAGE_SIZE, RC};\n2\t#[allow(unused_imports)]\n3\tuse crate::tables::{Schema, Value};\n4\tuse std::cell::RefCell;\n5\tuse std::fs::{File, OpenOptions};\n6\tuse std::io::{Read, Seek, SeekFrom, Write};\n7\t\n8\tpub struct SM_FileHandle {\n9\t    pub file_name: String,\n10\t    pub total_num_pages: i32,\n11\t    pub cur_page_pos: i32,\n12\t    pub mgmt_info: Option<Box<dyn std::any::Any>>,\n13\t}\n14\t\n15\tpub type SM_PageHandle = String;\n16\t\n17\tpub(crate) struct FileMgmt {\n18\t    pub file: RefCell<File>,\n19\t}\n20\t\n21\tfn page_size() -> usize {\n22\t    PAGE_SIZE as usize\n23\t}\n24\t\n25\t/// Helper: construct a String of the given length filled with NUL bytes\n26\t#[allow(dead_code)]\n27\tpub(crate) fn make_zero_page() -> String {\n28\t    // SAFETY: All-zero bytes are valid UTF-8.\n29\t    String::from_utf8(vec![0u8; page_size()]).unwrap()\n30\t}\n31\t\n32\t/// Helper: convert an arbitrary byte slice to String. Uses unsafe because the\n33\t/// C interface stores arbitrary binary page data inside the SM_PageHandle\n34\t/// (typed `String`), which would not generally be valid UTF-8. The signature\n35\t/// of the public Rust API forces us to use String here.\n36\tpub(crate) fn bytes_to_handle_string(bytes: Vec<u8>) -> String {\n37\t    // SAFETY: String layout matches Vec<u8>; we accept the trade-off of\n38\t    // potentially non-UTF-8 content because the public API mandates String.\n39\t    unsafe { String::from_utf8_unchecked(bytes) }\n40\t}\n41\t\n42\tpub(crate) fn handle_string_as_bytes_mut(s: &mut String) -> &mut [u8] {\n43\t    // SAFETY: We may write non-UTF-8 binary data here. The String storage\n44\t    // is just a heap buffer of bytes.\n45\t    unsafe { s.as_mut_vec().as_mut_slice() }\n46\t}\n47\t\n48\tpub fn init_storage_manager() {\n49\t    // No-op: the C version sets a global pageFile to NULL.\n50\t}\n51\t\n52\tpub fn create_page_file(file_name: &str) -> RC {\n53\t    let file = match OpenOptions::new()\n54\t        .create(true)\n55\t        .read(true)\n56\t        .write(true)\n57\t        .truncate(true)\n58\t        .open(file_name)\n59\t    {\n60\t        Ok(f) => f,\n61\t        Err(_) => return RC::FileNotFound,\n62\t    };\n63\t    let empty = vec![0u8; page_size()];\n64\t    let mut f = file;\n65\t    if f.write_all(&empty).is_err() {\n66\t        return RC::WriteFailed;\n67\t    }\n68\t    if f.flush().is_err() {\n69\t        return RC::WriteFailed;\n70\t    }\n71\t    RC::Ok\n72\t}\n73\t\n74\tpub fn open_page_file(file_name: &str, f_handle: &mut SM_FileHandle) -> RC {\n75\t    let file = match OpenOptions::new().read(true).write(true).open(file_name) {\n76\t        Ok(f) => f,\n77\t        Err(_) => return RC::FileNotFound,\n78\t    };\n79\t    let mut f = file;\n80\t    let mut header = vec![0u8; page_size()];\n81\t    if f.read_exact(&mut header).is_err() {\n82\t        return RC::ReadFailed;\n83\t    }\n84\t    // Parse total num pages from the header (atoi-like behavior).\n85\t    let header_str: String = header\n86\t        .iter()\n87\t        .take_while(|&&b| b != 0)\n88\t        .map(|&b| b as char)\n89\t        .collect();\n90\t    let total_num_pages: i32 = parse_atoi(&header_str);\n91\t\n92\t    f_handle.file_name = file_name.to_string();\n93\t    f_handle.total_num_pages = total_num_pages;\n94\t    f_handle.cur_page_pos = 0;\n95\t    f_handle.mgmt_info = Some(Box::new(FileMgmt {\n96\t        file: RefCell::new(f),\n97\t    }));\n98\t    RC::Ok\n99\t}\n100\t\n101\tfn parse_atoi(s: &str) -> i32 {\n102\t    let s = s.trim_start();\n103\t    let mut chars = s.chars().peekable();\n104\t    let mut sign = 1i64;\n105\t    if let Some(&c) = chars.peek() {\n106\t        if c == '-' {\n107\t            sign = -1;\n108\t            chars.next();\n109\t        } else if c == '+' {\n110\t            chars.next();\n111\t        }\n112\t    }\n113\t    let mut n: i64 = 0;\n114\t    for c in chars {\n115\t        if let Some(d) = c.to_digit(10) {\n116\t            n = n.saturating_mul(10).saturating_add(d as i64);\n117\t        } else {\n118\t            break;\n119\t        }\n120\t    }\n121\t    (sign * n) as i32\n122\t}\n123\t\n124\tfn get_file_mut<'a>(f_handle: &'a SM_FileHandle) -> Option<&'a FileMgmt> {\n125\t    f_handle\n126\t        .mgmt_info\n127\t        .as_ref()\n128\t        .and_then(|b| b.downcast_ref::<FileMgmt>())\n129\t}\n130\t\n131\tpub fn close_page_file(f_handle: &mut SM_FileHandle) -> RC {\n132\t    let mgmt = match f_handle.mgmt_info.as_ref() {\n133\t        Some(b) => match b.downcast_ref::<FileMgmt>() {\n134\t            Some(m) => m,\n135\t            None => return RC::FileHandleNotInit,\n136\t        },\n137\t        None => return RC::FileHandleNotInit,\n138\t    };\n139\t\n140\t    // Write the header containing the total number of pages.\n141\t    let mut header = vec![0u8; page_size()];\n142\t    let total_str = f_handle.total_num_pages.to_string();\n143\t    let bytes = total_str.as_bytes();\n144\t    let n = bytes.len().min(header.len());\n145\t    header[..n].copy_from_slice(&bytes[..n]);\n146\t\n147\t    {\n148\t        let mut file = mgmt.file.borrow_mut();\n149\t        if file.seek(SeekFrom::Start(0)).is_err() {\n150\t            return RC::SeekFailed;\n151\t        }\n152\t        if file.write_all(&header).is_err() {\n153\t            return RC::WriteFailed;\n154\t        }\n155\t        if file.flush().is_err() {\n156\t            return RC::WriteFailed;\n157\t        }\n158\t    }\n159\t    f_handle.mgmt_info = None;\n160\t    RC::Ok\n161\t}\n162\t\n163\tpub fn destroy_page_file(file_name: &str) -> RC {\n164\t    for _ in 0..3 {\n165\t        if std::fs::remove_file(file_name).is_ok() {\n166\t            return RC::Ok;\n167\t        }\n168\t    }\n169\t    RC::DestroyFailed\n170\t}\n171\t\n172\tfn ensure_handle_capacity(mem_page: &mut SM_PageHandle) {\n1