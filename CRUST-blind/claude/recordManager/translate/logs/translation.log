pt, &schema);\n    let mut r = r_opt.unwrap();\n    let mut count = 0;\n    loop {\n        let rc = next(&mut scan, &mut r);\n        if rc != RC::Ok {\n            break;\n        }\n        let mut val = Value { dt: DataType::DtInt, v: ValueUnion::IntV(0) };\n        get_attr(&r, &schema, 2, &mut val);\n        if let ValueUnion::IntV(v) = val.v {\n            assert_eq!(v, 1);\n        }\n        count += 1;\n    }\n    assert_eq!(count, 2, \"should find 2 records with c=1\");\n    assert_eq!(close_scan(&mut scan), RC::Ok);\n\n    assert_eq!(close_table(&mut rel), RC::Ok);\n    assert_eq!(delete_table(\"test_rt_scan\"), RC::Ok);\n    shutdown_record_manager();\n}\n\n#[test]\nfn test_value_serialize() {"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":764,"cache_read_input_tokens":161268,"cache_creation":{"ephemeral_5m_input_tokens":764,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b56e94b9-71d8-4e9b-996f-5bb9f9cbab5e","uuid":"545c4fde-e126-4c41-b80c-1e31d22b5dac"}
