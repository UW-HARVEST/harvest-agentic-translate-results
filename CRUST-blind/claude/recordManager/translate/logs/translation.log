         mgmt_data: None,\n        },\n        mgmt_data: None,\n    };\n    assert_eq!(start_scan(&rel, &mut scan, &sel), RC::Ok);\n    let mut r_opt: Option<Record> = None;\n    create_record(&mut r_opt, &schema);\n    let mut r = r_opt.unwrap();\n    let mut count = 0;\n    loop {\n        let rc = next(&mut scan, &mut r);\n        if rc != RC::Ok {\n            break;\n        }\n        let mut val = Value { dt: DataType::DtInt, v: ValueUnion::IntV(0) };\n        get_attr(&r, &schema, 2, &mut val);\n        if let ValueUnion::IntV(v) = val.v {\n            assert_eq!(v, 1);\n        }\n        count += 1;\n    }\n    assert_eq!(count, 2, \"should find 2 records with c=1\");\n    assert_eq!(close_scan(&mut scan), RC::Ok);\n\n    assert_eq!(close_table(&mut rel), RC::Ok);\n    assert_eq!(delete_table(\"test_rt_scan\"), RC::Ok);\n    shutdown_record_manager();\n}\n\n#[test]\nfn test_value_serialize() {","originalFile":"use recordManager::dberror::RC;\nuse recordManager::expr::*;\nuse recordManager::record_mgr::*;\nuse recordManager::tables::*;\n\nfn build_schema() -> Schema {\n    create_schema(\n        3,\n        vec![\"a\".into(), \"b\".into(), \"c\".into()],\n        vec![DataType::DtInt, DataType::DtString, DataType::DtInt],\n        vec![0, 4, 0],\n        1,\n        vec![0],\n    )\n}\n\nfn make_record(schema: &Schema, a: i32, b: &str, c: i32) -> Record {\n    let mut r_opt: Option<Record> = None;\n    create_record(&mut r_opt, schema);\n    let mut r = r_opt.unwrap();\n    let v = Value { dt: DataType::DtInt, v: ValueUnion::IntV(a) };\n    set_attr(&mut r, schema, 0, &v);\n    let v2 = Value { dt: DataType::DtString, v: ValueUnion::StringV(b.into()) };\n    set_attr(&mut r, schema, 1, &v2);\n    let v3 = Value { dt: DataType::DtInt, v: ValueUnion::IntV(c) };\n    set_attr(&mut r, schema, 2, &v3);\n    r\n}\n\n#[test]\nfn create_and_insert_many() {\n    let schema = build_schema();\n    let _ = std::fs::remove_file(\"test_rt_many\");\n    init_record_manager(None);\n    assert_eq!(create_table(\"test_rt_many\", &schema), RC::Ok);\n\n    let mut rel = RM_TableData {\n        name: String::new(),\n        schema: schema.clone(),\n        mgmt_data: None,\n    };\n    assert_eq!(open_table(&mut rel, \"test_rt_many\"), RC::Ok);\n\n    let inserts = [\n        (1, \"aaaa\", 3),\n        (2, \"bbbb\", 2),\n        (3, \"cccc\", 1),\n        (4, \"dddd\", 3),\n        (5, \"eeee\", 5),\n        (6, \"ffff\", 1),\n        (7, \"gggg\", 3),\n        (8, \"hhhh\", 3),\n        (9, \"iiii\", 2),\n    ];\n    let mut rids = Vec::new();\n    for (a, b, c) in inserts.iter() {\n        let r = make_record(&schema, *a, b, *c);\n        assert_eq!(insert_record(&mut rel, &r), RC::Ok);\n        rids.push(r.id.clone());\n    }\n\n    assert_eq!(close_table(&mut rel), RC::Ok);\n    assert_eq!(open_table(&mut rel, \"test_rt_many\"), RC::Ok);\n\n    // Read back\n    for (i, rid) in rids.iter().enumerate() {\n        let mut r_opt: Option<Record> = None;\n        create_record(&mut r_opt, &schema);\n        let mut r = r_opt.unwrap();\n        assert_eq!(get_record(&rel, rid, &mut r), RC::Ok);\n        let mut val = Value { dt: DataType::DtInt, v: ValueUnion::IntV(0) };\n        get_attr(&r, &schema, 0, &mut val);\n        if let ValueUnion::IntV(v) = val.v {\n            assert_eq!(v, inserts[i].0, \"attr a mismatch at index {}\", i);\n        }\n        get_attr(&r, &schema, 1, &mut val);\n        if let ValueUnion::StringV(ref s) = val.v {\n            assert_eq!(s, inserts[i].1, \"attr b mismatch at index {}\", i);\n        }\n        get_attr(&r, &schema, 2, &mut val);\n        if let ValueUnion::IntV(v) = val.v {\n            assert_eq!(v, inserts[i].2, \"attr c mismatch at index {}\", i);\n        }\n    }\n\n    assert_eq!(close_table(&mut rel), RC::Ok);\n    assert_eq!(delete_table(\"test_rt_many\"), RC::Ok);\n    shutdown_record_manager();\n}\n\n#[test]\nfn test_value_serialize() {\n    assert_eq!(serialize_value(&string_to_value(\"i10\")), \"10\");\n    assert_eq!(serialize_value(&string_to_value(\"f5.3\")), \"5.300000\");\n    assert_eq!(serialize_value(&string_to_value(\"sHello World\")), \"Hello World\");\n    assert_eq!(serialize_value(&string_to_value(\"bt\")), \"true\");\n    assert_eq!(serialize_value(&string_to_value(\"btrue\")), \"true\");\n}\n\n#[test]\nfn test_operators() {\n    let mut result = Value { dt: DataType::DtInt, v: ValueUnion::IntV(0) };\n    let l = string_to_value(\"i10\");\n    let r = string_to_value(\"i10\");\n    assert_eq!(value_equals(&l, &r, &mut result), RC::Ok);\n    assert!(matches!(result.v, ValueUnion::BoolV(true)));\n\n    let l = string_to_value(\"i9\");\n    let r = string_to_value(\"i10\");\n    value_equals(&l, &r, &mut result);\n    assert!(matches!(result.v, ValueUnion::BoolV(false)));\n\n    let l = string_to_value(\"i3\");\n    let r = string_to_value(\"i10\");\n    value_smaller(&l, &r, &mut result);\n    assert!(matches!(result.v, ValueUnion::BoolV(true)));\n\n    let l = string_to_value(\"bt\");\n    let r = string_to_value(\"bt\");\n    bool_and(&l, &r, &mut result);\n    assert!(matches!(result.v, ValueUnion::BoolV(true)));\n\n    let l = string_to_value(\"bt\");\n    let r = string_to_value(\"bf\");\n    bool_or(&l, &r, &mut result);\n    assert!(matches!(result.v, ValueUnion::BoolV(true)));\n\n    let l = string_to_value(\"bf\");\n    bool_not(&l, &mut result);\n    assert!(matches!(result.v, ValueUnion::BoolV(true)));\n}\n","structuredPatch":[{"oldStart":89,"oldLines":6,"newStart":89,"newLines":83,"lines":[" }"," "," #[test]","+fn scan_with_condition() {","+    let schema = build_schema();","+    let _ = std::fs::remove_file(\"test_rt_scan\");","+    init_record_manager(None);","+    assert_eq!(create_table(\"test_rt_scan\", &schema), RC::Ok);","+","+    let mut rel = RM_TableData {","+        name: String::new(),","+        schema: schema.clone(),","+        mgmt_data: None,","+    };","+    assert_eq!(open_table(&mut rel, \"test_rt_