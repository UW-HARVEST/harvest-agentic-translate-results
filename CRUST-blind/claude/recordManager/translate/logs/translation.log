handler = Some(page);\n    if not_found {\n        return RC::RecordNotFound;\n    }\n    unpin_rc\n}\n\nfn ensure_record_capacity(record: &mut Record, n: usize) {\n    let bytes = record.data.as_bytes();\n    if bytes.len() < n {\n        let mut v = std::mem::take(&mut record.data).into_bytes();\n        v.resize(n, 0);\n        record.data = unsafe { String::from_utf8_unchecked(v) };\n    }\n}\n\npub fn start_scan(rel: &RM_TableData, scan: &mut RM_ScanHandle, cond: &Expr) -> RC {\n    let cell = match tm_ref(rel) {\n        Some(c) => c,\n        None => return RC::Error,\n    };\n    let tm = cell.borrow();\n    let total_entries = tm.total_tuples;\n    let first_data_page_num = tm.first_data_page_num;\n    drop(tm);\n\n    let scan_mgr = ScanManager {\n        total_entries,\n        scan_index: 0,\n        current_page_num: first_data_page_num,\n        current_slot_num: -1,\n        condition_expression: Some(cond.clone()),\n        scan_page_handle_ptr: None,\n    };\n    scan.mgmt_data = Some(Box::new(scan_mgr));\n    // rel can be reused as a clone: we only use schema and the mgmt_data shared via the\n    // user's outer table. To properly access table data during next(), the caller must\n    // keep rel valid. We stash a pointer-compatible structure: a clone of rel without\n    // taking ownership of mgmt_data is impossible. Instead the caller passes the\n    // original mut table to next() by keeping it alive.\n    scan.rel = RM_TableData {\n        name: rel.name.clone(),\n        schema: rel.schema.clone(),\n        mgmt_data: None,\n    };\n    // Save a pointer to the original rel for next() to use.\n    let rel_ptr = rel as *const RM_TableData as usize;\n    if let Some(boxed) = scan.mgmt_data.as_mut() {\n        if let Some(sm) = boxed.downcast_mut::<ScanManager>() {\n            // Re-pack the pointer as a stash on scan.rel.mgmt_data for cross-call access.\n            scan.rel.mgmt_data = Some(Box::new(rel_ptr));\n        }\n    }\n    RC::Ok\n}\