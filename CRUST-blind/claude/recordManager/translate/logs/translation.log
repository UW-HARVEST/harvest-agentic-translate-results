else {\n        printf(\"Returning fix counts for pages in use.\\n\");\n        return bpl->fix_count;\n    }\n}\n\n// Define the number of pages that have been read \nint getNumReadIO (BM_BufferPool *const bm)\n{\n    if (bm == NULL) {\n        return 0;\n    }\n    Bufferpool *bpl;\n    bpl = bm->mgmtData;\n    if (bpl == NULL) {\n        return 0;\n    }\n    int readCount = bpl->numRead;\n    return readCount;\n}\n\n// Define the number of pages written \nint getNumWriteIO(BM_BufferPool *const bm) {\n    if (bm == NULL) {\n        return 0;\n    } else {\n        Bufferpool *bpl;\n        bpl = bm->mgmtData;\n        if (bpl == NULL) {\n            return 0;\n        } else {\n            int writeCount = bpl->numWrite;\n            return writeCount;\n        }\n    }\n}\n\n// Define the page numbers as an array \nPageNumber *getFrameContents(BM_BufferPool *const bm)\n{\n    Bufferpool *bpl;\n    bpl = bm->mgmtData;\n    bool isFull = (bpl->free_space == bpl->totalPages);\n    PageNumber *result = NULL;\n    if (isFull)\n    {\n        result = 0;\n    }\n    else\n    {\n        result = bpl->pagenum;\n    }\n    if (result != NULL)\n    {\n        return result;\n    }\n    else\n    {\n        return 0; \n    }\n}\n\n// Define array of dirty page \nbool *getDirtyFlags(BM_BufferPool *const bm)\n{\n    if (bm == NULL) {\n        return NULL;\n    }\n    Bufferpool *bpl;\n    bpl = bm->mgmtData;\n    if (bpl == NULL) {\n        return NULL;\n    }\n    bool *dirtyFlags = bpl->bitdirty;\n    if (dirtyFlags == NULL) {\n        return NULL;\n    }\n    return dirtyFlags;\n}\n        \n","numLines":548,"startLine":1,"totalLines":548}}}
