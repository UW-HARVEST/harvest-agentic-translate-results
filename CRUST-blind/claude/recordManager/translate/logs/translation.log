,"+    scan.mgmt_data = Some(Box::new(scan_mgr));","+    // rel can be reused as a clone: we only use schema and the mgmt_data shared via the","+    // user's outer table. To properly access table data during next(), the caller must","+    // keep rel valid. We stash a pointer-compatible structure: a clone of rel without","+    // taking ownership of mgmt_data is impossible. Instead the caller passes the","+    // original mut table to next() by keeping it alive.","+    scan.rel = RM_TableData {","+        name: rel.name.clone(),","+        schema: rel.schema.clone(),","+        mgmt_data: None,","+    };","+    // Save a pointer to the original rel for next() to use.","+    let rel_ptr = rel as *const RM_TableData as usize;","+    if let Some(boxed) = scan.mgmt_data.as_mut() {","+        if let Some(sm) = boxed.downcast_mut::<ScanManager>() {","+            // Re-pack the pointer as a stash on scan.rel.mgmt_data for cross-call access.","+            scan.rel.mgmt_data = Some(Box::new(rel_ptr));","+        }","+    }","+    RC::Ok"," }","+"," pub fn next(scan: &mut RM_ScanHandle, record: &mut Record) -> RC {","-unimplemented!()","+    // Recover the original rel pointer","+    let rel_ptr: usize = match scan","+        .rel","+        .mgmt_data","+        .as_ref()","+        .and_then(|b| b.downcast_ref::<usize>())","+    {","+        Some(p) => *p,","+        None => return RC::Error,","+    };","+    let rel: &RM_TableData = unsafe { &*(rel_ptr as *const RM_TableData) };","+    let tm = match rel","+        .mgmt_data","+        .as_ref()","+        .and_then(|b| b.downcast_ref::<TableManager>())","+    {","+        Some(t) => t,","+        None => return RC::Error,","+    };","+    let rec_size = tm.rec_size;","+    let slots = slots_per_page(rec_size);","+","+    let scan_mgr = match scan","+        .mgmt_data","+        .as_mut()","+        .and_then(|b| b.downcast_mut::<ScanManager>())","+    {","+        Some(s) => s,","+        None => return RC::Error,","