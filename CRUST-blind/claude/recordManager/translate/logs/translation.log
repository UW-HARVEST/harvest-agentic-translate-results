 fHandle->totalNumPages = atoi(pageData);\n69\t        fHandle->curPagePos = 0;\n70\t        fHandle->mgmtInfo = fp;\n71\t        free(pageData); \n72\t    } else {\n73\t        fclose(fp);\n74\t        free(pageData); \n75\t        return RC_INVALID_HEADER;\n76\t    }\n77\t    return RC_OK;\n78\t}\n79\t\n80\t// Define Close a Page file \n81\tRC closePageFile(SM_FileHandle *fHandle) {\n82\t    int FILE_RC;\n83\t    char *pageData;\n84\t    long offset;\n85\t    int Action, maxTrial = 1;\n86\t\n87\t    pageData = (char *) calloc(PAGE_SIZE, sizeof(char));\n88\t    if (pageData == NULL) {\n89\t        return RC_MEMORY_ALLOCATION_FAIL;\n90\t    }\n91\t    offset = 0;\n92\t    FILE_RC = fseek(fHandle->mgmtInfo, offset, SEEK_SET);\n93\t    if (FILE_RC != 0) {\n94\t        free(pageData);\n95\t        return RC_SEEK_FAILED;\n96\t    }\n97\t    sprintf(pageData, \"%d\", fHandle->totalNumPages);\n98\t    for (Action = 0; Action < maxTrial; Action++) {\n99\t        FILE_RC = fwrite(pageData, PAGE_SIZE, 1, fHandle->mgmtInfo);\n100\t        if (FILE_RC != 1) {\n101\t        free(pageData);\n102\t        return RC_WRITE_FAILED;\n103\t        } \n104\t        else {\n105\t        // Close the file\n106\t        FILE_RC = fclose(fHandle->mgmtInfo);\n107\t        if (FILE_RC != 0) {\n108\t            free(pageData);\n109\t            return RC_CLOSE_FAILED;\n110\t        }\n111\t         }\n112\t    free(pageData);\n113\t    return RC_OK;\n114\t    }\n115\t}\n116\t\n117\t// Define destroy a Page file \n118\tRC destroyPageFile(char *fileName) {\n119\t    int FILE_RC;\n120\t    int Trial = 0;\n121\t    const int maxTrial = 3; \n122\t    while (Trial < maxTrial) {\n123\t        FILE_RC = remove(fileName);\n124\t        if (FILE_RC == 0) {\n125\t            return RC_OK;\n126\t        } else {\n127\t            Trial++;\n128\t        }\n129\t    }\n130\t    if (FILE_RC != 0) {\n131\t        return RC_DESTROY_FAILED;\n132\t    }\n133\t    return RC_OK;\n134\t}\n135\t\n136\t//  Define Read a block \n137\tRC readBlock(int pageNum, SM_FileHandle *fHandle, SM_PageHandle memPage) {\n138\t    long offset;\n139\t    int FILE_RC;\n140\t    int Action, maxTrial = 1; \n141\t    if (pageNum < 0 || pageNum >= fHandle->totalNumPages) {\n142\t        return RC_READ_NON_EXISTING_PAGE;\n143\t    }\n144\t    offset = (pageNum + 1) * PAGE_SIZE;\n145\t    FILE_RC = fseek(fHandle->mgmtInfo, offset, SEEK_SET);\n146\t    if (FILE_RC != 0) {\n147\t        return RC_SEEK_FAILED;\n148\t    }\n149\t    for (Action = 0; Action < maxTrial; Action++) {\n150\t        FILE_RC = fread(memPage, PAGE_SIZE, 1, fHandle->mgmtInfo);\n151\t        if (FILE_RC == 1) {\n152\t            break;\n153\t        }\n154\t    }\n155\t    if (FILE_RC != 1) {\n156\t        return RC_READ_FAILED;\n157\t    }\n158\t    fHandle->curPagePos = pageNum;\n159\t    return RC_OK;\n160\t}\n161\t\n162\t// Define Read first block \n163\tRC readFirstBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n164\t    int read_code;\n165\t    const int maxTrial = 3; \n166\t    int Action = 0;\n167\t    for (Action = 0; Action < maxTrial; Action++) {\n168\t        read_code = readBlock(0, fHandle, memPage);\n169\t        if (read_code == RC_OK) {\n170\t            break;\n171\t        } else {\n172\t            printf(\"Action %d to read the first block failed. Retrying...\\n\", Action + 1);\n173\t        }\n174\t    }\n175\t    return read_code;\n176\t}\n177\t\n178\t// Define Read Last block\n179\tRC readLastBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n180\t    int read_code;\n181\t    int pageNum;\n182\t    const int maxTrial = 3; \n183\t    int Action = 0;\n184\t    pageNum = fHandle->totalNumPages - 1;\n185\t    if (pageNum < 0) {\n186\t        return RC_READ_NON_EXISTING_PAGE;\n187\t    }\n188\t    for (Action = 0; Action < maxTrial; Action++) {\n189\t        read_code = readBlock(pageNum, fHandle, memPage);\n190\t        if (read_code == RC_OK) {\n191\t            break;\n192\t        } \n193\t    }\n194\t    return read_code;\n195\t}\n196\t\n197\t// Define read previous block\n198\tRC readPreviousBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n199\t    int read_code;\n200\t    int pageNum;\n201\t    const int maxTrial = 2;\n202\t    int Action = 0;\n203\t    pageNum = fHandle->curPagePos - 1;\n204\t    if (pageNum < 0) {\n205\t        return RC_READ_NON_EXISTING_PAGE; \n206\t    }\n207\t    for (Action = 0; Action < maxTrial; Action++) {\n208\t        read_code = readBlock(pageNum, fHandle, memPage);\n209\t        if (read_code == RC_OK) {\n210\t            break;\n211\t        }\n212\t    }\n213\t    return read_code;\n214\t}\n215\t\n216\t// Define read current block\n217\tRC readCurrentBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n218\t    if (fHandle == NULL || fHandle->mgmtInfo == NULL) {\n219\t        return RC_FILE_HANDLE_NOT_INIT;\n220\t    }\n221\t    int pageNum = fHandle->curPagePos;\n222\t    if (pageNum < 0 || pageNum >= fHandle->totalNumPages) {\n223\t        return RC_READ_NON_EXISTING_PAGE;\n224\t    }\n225\t    int read_code = RC_READ_NON_EXISTING_PAGE;\n226\t    const int maxReadTrial = 3; \n227\t    for (int Action = 0; Action < maxReadTrial; Action++) {\n228\t        read_code = readBlock(pageNum, fHandle, memPage);\n229\t        if (read_code == RC_OK) {\n230\t            break; \n231\t        }\n232\t    }\n233\t    return read_code;\n234\t}\n235\t\n236\t// Define read next block\n237\tRC readNextBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n238\t    int read_code;\n239\t    int pageNum;\n240\t    const int maxTrial = 2; \n241\t    int Action = 0;\n242\t    pageNum = fHandle->curPagePos + 1;\n243\t    for (Action = 0; Action < maxTrial; Action++) {\n244\t        read_code = readBlock(pageNum, fHandle, memPage);\n245\t        if (read_code == RC_OK) {\n246\t            break;\n247\t        }\n248\t    }\n249\t    if (read_code == RC_READ_NON_EXISTING_PAGE) {\n250\t    }\n251\t    return read_code;\n252\t}\n253\t\n254\t// Define write block\n255\tRC writeBlock(int pageNum, SM_FileHandle *fHandle, SM_PageHandle memPage) {\n256\t    FILE *fp = fHandle->mgmtInfo;\n257\t    long int offset;\n258\t    if (fp == NULL) {\n259\t        return RC_FILE_NOT_FOUND; \n260\t    }\n261\t    if (pageNum < 0) {\n262\t        return RC_WRITE_FAILED; \n263\t    }\n264\t    offset = (pageNum + 1) * PAGE_SIZE;\n265\t    fseek(fp, 0, SEEK_END);\n266\t    long fileSize = ftell(fp);\n267\t    if (offset > fileSize) {\n268\t        if (pageNum == fHandle->totalNumPages) {\n269\t            fseek(fp, fileSize, SEEK_SET);\n270\t            for (long i = fileSize; i < offset; i++) {\n271\t                fputc('\\0', fp);\n272\t            }\n273\t            fHandle->totalNumPages++; \n274\t        } else {\n275\t            return RC_WRITE_FAILED; \n276\t        }\n277\t    }\n278\t        if (lseek(fileno(fp), offset, SEEK_SET) == -1) {\n279\t            return RC_SEEK_FAILED;\n280\t            }\n281\t            ssize_t bytes_written = write(fileno(fp), memPage, PAGE_SIZE);\n282\t            if (bytes_written != PAGE_SIZE) {\n283\t                return RC_WRITE_FAILED;\n284\t            }\n285\t            fHandle->curPagePos = pageNum;\n286\t\n287\t            return RC_OK;\n288\t}\n289\t\n290\t// Define write current block \n291\tRC writeCurrentBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n292\t    int read_code;\n293\t    int pageNum;\n294\t    const int maxWriteTrial = 3; \n295\t    int writeAction;\n296\t    int SuccessStatus = 0;\n297\t    pageNum = fHandle->curPagePos; \n298\t    if (pageNum < 0 || pageNum >= fHandle->totalNumPages) {\n299\t        return RC_WRITE_FAILED; \n300\t    }\n301\t    for (writeAction = 0; writeAction < maxWriteTrial; writeAction++) {\n302\t        read_code = writeBlock(pageNum, fHandle, memPage);\n303\t        if (read_code == RC_OK) {\n304\t            SuccessStatus = 1; \n305\t            break; \n306\t        } \n307\t    }\n308\t    if (!SuccessStatus) {\n309\t        return RC_WRITE_FAILED; \n310\t    }\n311\t    return RC_OK;\n312\t}\n313\t\n314\t// Define append and empty block\n315\tRC appendEmptyBlock(SM_FileHandle *fHandle) {\n316\t    FILE *fp = fHandle->mgmtInfo;\n317\t    char *pageData;\n318\t    int FILE_RC;\n319\t    const int maxWriteTrial = 2;\n320\t    int Action = 0;\n321\t    int SuccessStatus = 0;\n322\t    pageData = (char *)calloc(PAGE_SIZE, sizeof(char));\n323\t    if (pageData == NULL) {\n324\t        return RC_MEMORY_ALLOCATION_FAIL;\n325\t    }\n326\t    if (fp == NULL) {\n327\t        free(pageData);\n328\t        return RC_FILE_HANDLE_NOT_INIT;\n329\t    }\n330\t    FILE_RC = fseek(fp, 0, SEEK_END);\n331\t    if (FILE_RC != 0) {\n332\t        free(pageData);\n333\t        return RC_SEEK_FAILED;\n334\t    }\n335\t    for (Action = 0; Action < maxWriteTrial; Action++) {\n336\t        FILE_RC = fwrite(pageData, PAGE_SIZE, 1, fp);\n337\t        if (FILE_RC == 1) {\n338\t            SuccessStatus = 1;\n339\t            break;\n340\t        }\n341\t    }\n342\t    free(pageData);\n343\t    if (!SuccessStatus) {\n344\t        return RC_WRITE_FAILED;\n345\t    }\n346\t    fHandle->totalNumPages += 1;\n347\t    fHandle->curPagePos = fHandle->totalNumPages - 1;\n348\t    return RC_OK;\n349\t}\n350\t\n351\t// Define ensureCapacity\n352\tRC ensureCapacity(int allPagesCount, SM_FileHandle *fHandle) {\n353\t    if (fHandle == NULL || fHandle->mgmtInfo == NULL) {\n354\t        return RC_FILE_HANDLE_NOT_INIT;\n355\t    }\n356\t    int activePageCount = fHandle->totalNumPages;\n357\t    if (allPagesCount <= activePageCount) {\n358\t        return RC_OK;\n359\t    }\n360\t    int IncrementPageCount = allPagesCount - activePageCount;\n361\t    int FILE_RC, i;\n362\t    for (i = 0; i < IncrementPageCount; i++) {\n363\t        FILE_RC = appendEmptyBlock(fHandle);\n364\t        if (FILE_RC != RC_OK) {\n365\t            return FILE_RC;\n366\t        }\n367\t    }\n368\t    return RC_OK;\n369\t}\n370\t\n