ntln!(\"attr 0: {:?}\", val.v);\n    if let ValueUnion::IntV(i) = val.v { assert_eq!(i, 42); }\n    get_attr(&rec2, &schema, 1, &mut val);\n    println!(\"attr 1: {:?}\", val.v);\n    if let ValueUnion::StringV(ref s) = val.v { assert_eq!(s, \"test\"); }\n    get_attr(&rec2, &schema, 2, &mut val);\n    println!(\"attr 2: {:?}\", val.v);\n    if let ValueUnion::IntV(i) = val.v { assert_eq!(i, 7); }\n\n    let _ = close_table(&mut rel);\n    let _ = delete_table(\"test_rt_basic\");\n    shutdown_record_manager();\n}\n","userModified":false}}
