{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01XB4QNh1dA8U8U7Ns7APAZP","type":"tool_result","content":"1\t#ifndef CIRC_ARRAY_H_\n2\t#define CIRC_ARRAY_H_\n3\t\n4\t#include <stdlib.h>\n5\t#include <string.h>\n6\t#include <assert.h>\n7\t\n8\t#include \"carrays.h\"\n9\t\n10\t//\n11\t// Generic circular array\n12\t//\n13\t\n14\t#ifndef roundup64\n15\t  #define roundup64(x) roundup64(x)\n16\t  static inline uint64_t roundup64(uint64_t x) {\n17\t    return (--x, x|=x>>1, x|=x>>2, x|=x>>4, x|=x>>8, x|=x>>16, x|=x>>32, ++x);\n18\t  }\n19\t#endif\n20\t\n21\ttypedef struct\n22\t{\n23\t  const size_t el; // element size in bytes\n24\t  size_t start, n, size, mask; // n<=size, mask=size-1\n25\t  void *b;\n26\t} CircBuf;\n27\t\n28\tstatic inline void circa_alloc(CircBuf *l, size_t el, size_t size) __attribute__((unused));\n29\tstatic inline void circa_dealloc(CircBuf *l) __attribute__((unused));\n30\tstatic inline void circa_capacity(CircBuf *l, size_t s) __attribute__((unused));\n31\tstatic inline void* circa_push(CircBuf *l) __attribute__((unused));\n32\tstatic inline void* circa_pop(CircBuf *l) __attribute__((unused));\n33\tstatic inline void* circa_unshift(CircBuf *l) __attribute__((unused));\n34\tstatic inline void* circa_shift(CircBuf *l) __attribute__((unused));\n35\tstatic inline void circa_norm(CircBuf *l) __attribute__((unused));\n36\t\n37\tstatic inline void circa_alloc(CircBuf *l, size_t el, size_t size)\n38\t{\n39\t  size = roundup64(size);\n40\t  CircBuf tmp = {.el = el, .start = 0, .n = 0,\n41\t                   .size = size, .mask = size-1,\n42\t                   .b = malloc(size * el)};\n43\t  memcpy(l, &tmp, sizeof(CircBuf));\n44\t}\n45\t\n46\tstatic inline void circa_dealloc(CircBuf *l)\n47\t{\n48\t  free(l->b);\n49\t}\n50\t\n51\tstatic inline void circa_resize(CircBuf *l, size_t size)\n52\t{\n53\t  // resize is only for growing array and new size must be a power of two\n54\t  assert(size > l->size && (size & (size-1)) == 0);\n55\t\n56\t  l->b = realloc(l->b, l->el*size);\n57\t  if(l->start + l->n > l->size) {\n58\t    // nend is the num items at the end of the b, nbeg is at the beginning\n59\t    size_t nend = l->size-l->start, nbeg = (l->start+l->n) & l->mask;\n60\t    if(nend < nbeg) memmove(l->b+size-nend, l->b+l->size-nend, l->el*nend);\n61\t    else            memmove(l->b+l->size, l->b, l->el*nbeg);\n62\t  }\n63\t  l->size = size;\n64\t  l->mask = size-1;\n65\t}\n66\t\n67\tstatic inline void circa_capacity(CircBuf *l, size_t size)\n68\t{\n69\t  if(size > l->size) circa_resize(l, roundup64(size));\n70\t}\n71\t\n72\t#define circa_pos(l,idx) (((l)->start + (idx)) & (l)->mask)\n73\t#define circa_get(l,idx) ((l)->b + (l)->el * circa_pos(l,idx))\n74\t\n75\t// Add to start\n76\t// Returns a pointer to the item added (zero'd)\n77\tstatic inline void* circa_push(CircBuf *l)\n78\t{\n79\t  if(l->n == l->size) circa_resize(l, l->size*2);\n80\t  l->start = l->start ? l->start-1 : l->size-1;\n81\t  l->n++;\n82\t  void *ptr = circa_get(l, 0);\n83\t  memset(ptr, 0, l->el);\n84\t  return ptr;\n85\t}\n86\t\n87\t// Remove from start\n88\t// Returns a pointer to the item removed\n89\tstatic inline void* circa_pop(CircBuf *l)\n90\t{\n91\t  assert(l->n > 0);\n92\t  size_t old = l->start;\n93\t  l->start = (l->start+1) & l->mask;\n94\t  l->n--;\n95\t  return l->b + l->el*old;\n96\t}\n97\t\n98\t// Add to end\n99\t// Returns a pointer to the item added (zero'd)\n100\tstatic inline void* circa_unshift(CircBuf *l)\n101\t{\n102\t  if(l->n == l->size) circa_resize(l, l->size*2);\n103\t  void *ptr = circa_get(l, l->n);\n104\t  memset(ptr, 0, l->el);\n105\t  l->n++;\n106\t  return ptr;\n107\t}\n108\t\n109\t// Remove from end\n110\t// Returns a pointer to the item removed\n111\tstatic inline void* circa_shift(CircBuf *l)\n112\t{\n113\t  assert(l->n > 0);\n114\t  void *ptr = circa_get(l, l->n);\n115\t  l->n--;\n116\t  return ptr;\n117\t}\n118\t\n119\t// Stop circular array from wrapping around\n120\tstatic inlin