w_total, 0);\n76\t        *size = rounded;\n77\t    }\n78\t    Some(ptr)\n79\t}\n80\t\n81\tpub fn gca_swapm(a: &mut [u8], b: &mut [u8]) {\n82\t    let len = a.len().min(b.len());\n83\t    for i in 0..len {\n84\t        mem::swap(&mut a[i], &mut b[i]);\n85\t    }\n86\t}\n87\t\n88\tpub fn gca_cycle_left(ptr: &mut [u8], n: usize, es: usize, shift: usize) {\n89\t    if n <= 1 || shift == 0 {\n90\t        return;\n91\t    }\n92\t    let shift = shift % n;\n93\t    if shift == 0 {\n94\t        return;\n95\t    }\n96\t    let gcd = gca_calc_gcd(n as u32, shift as u32) as usize;\n97\t    let mut tmp = vec![0u8; es];\n98\t\n99\t    for i in 0..gcd {\n100\t        tmp.copy_from_slice(&ptr[i * es..(i + 1) * es]);\n101\t        let mut j = i;\n102\t        loop {\n103\t            let mut k = j + shift;\n104\t            if k >= n {\n105\t                k -= n;\n106\t            }\n107\t            if k == i {\n108\t                break;\n109\t            }\n110\t            // arr[j] = arr[k]\n111\t            ptr.copy_within(k * es..(k + 1) * es, j * es);\n112\t            j = k;\n113\t        }\n114\t        // arr[j] = tmp\n115\t        ptr[j * es..(j + 1) * es].copy_from_slice(&tmp);\n116\t    }\n117\t}\n118\t\n119\tpub fn gca_cycle_right(ptr: &mut [u8], n: usize, es: usize, shift: usize) {\n120\t    if n == 0 || shift == 0 {\n121\t        return;\n122\t    }\n123\t    let shift = shift % n;\n124\t    if shift == 0 {\n125\t        return;\n126\t    }\n127\t    gca_cycle_left(ptr, n, es, n - shift);\n128\t}\n129\t\n130\tpub fn gca_reverse(ptr: &mut [u8], n: usize, es: usize) {\n131\t    if n <= 1 || es == 0 {\n132\t        return;\n133\t    }\n134\t    let mut a = 0usize;\n135\t    let mut b = (n - 1) * es;\n136\t    while a < b {\n137\t        // swap es bytes at positions a and b\n138\t        for i in 0..es {\n139\t            ptr.swap(a + i, b + i);\n140\t        }\n141\t        a += es;\n142\t        b -= es;\n143\t    }\n144\t}\n145\t\n146\tpub fn gca_is_sorted<T, F