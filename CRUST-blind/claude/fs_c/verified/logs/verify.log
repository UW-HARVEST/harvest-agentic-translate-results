  fclose(file);\n179\t  return data;\n180\t}\n181\t\n182\t\n183\tchar *\n184\tfs_nread (const char *path, int len) {\n185\t  FILE *file = fs_open(path, FS_OPEN_READ);\n186\t  if (NULL == file) return NULL;\n187\t  char *buffer = fs_fnread(file, len);\n188\t  fs_close(file);\n189\t  return buffer;\n190\t}\n191\t\n192\t\n193\tchar *\n194\tfs_fread (FILE *file) {\n195\t  size_t fsize = fs_fsize(file);\n196\t  return fs_fnread(file, fsize);\n197\t}\n198\t\n199\t\n200\tchar *\n201\tfs_fnread (FILE *file, int len) {\n202\t  char *buffer = (char*) malloc(sizeof(char) * (len + 1));\n203\t  size_t n = fread(buffer, 1, len, file);\n204\t  buffer[n] = '\\0';\n205\t  return buffer;\n206\t}\n207\t\n208\t\n209\tint\n210\tfs_write (const char *path, const char *buffer) {\n211\t  return fs_nwrite(path, buffer, strlen(buffer));\n212\t}\n213\t\n214\t\n215\tint\n216\tfs_nwrite (const char *path, const char *buffer, int len) {\n217\t  FILE *file = fs_open(path, FS_OPEN_WRITE);\n218\t  if (NULL == file) return -1;\n219\t  int result = fs_fnwrite(file, buffer, len);\n220\t  fclose(file);\n221\t  return result;\n222\t}\n223\t\n224\t\n225\tint\n226\tfs_fwrite (FILE *file, const char *buffer) {\n227\t  return fs_fnwrite(file, buffer, strlen(buffer));\n228\t}\n229\t\n230\t\n231\tint\n232\tfs_fnwrite (FILE *file, const char *buffer, int len) {\n233\t  return (int) fwrite(buffer, 1, len, file);\n234\t}\n235\t\n236\t\n237\tint\n238\tfs_mkdir (const char *path, int mode) {\n239\t#ifdef _WIN32\n240\t  return mkdir(path);\n241\t#else\n242\t  return mkdir(path, (mode_t) mode);\n243\t#endif\n244\t}\n245\t\n246\t\n247\tint\n248\tfs_rmdir (const char *path) {\n249\t  return rmdir(path);\n250\t}\n251\t\n252\t\n253\tint\n254\tfs_exists (const char *path) {\n255\t  struct stat b;\n256\t  return stat(path, &b);\n257\t}\n258\t"}]},"parent_tool_use_id":null,"session_id":"79a8cc2d-b14d-4fac-8c16-29ea19cd4605","uuid":"529973b6-3096-44fc-8952-959744fbc55f","timestamp":"2026-05-29T17:41:36.699Z","tool_use_resul