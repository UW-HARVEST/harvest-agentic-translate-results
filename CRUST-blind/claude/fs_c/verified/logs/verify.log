{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01U5WkxhK9L5TdANuSS1GEJW","type":"tool_result","content":"1\t\n2\t/**\n3\t * fs.c\n4\t *\n5\t * copyright 2013 - joseph werle <joseph.werle@gmail.com>\n6\t */\n7\t\n8\t#define _POSIX_C_SOURCE 200809L\n9\t#include <stdlib.h>\n10\t#include <stdio.h>\n11\t#include <dirent.h>\n12\t#include <string.h>\n13\t#include <errno.h>\n14\t#include <sys/types.h>\n15\t#include <sys/stat.h>\n16\t#include <unistd.h>\n17\t#include <fcntl.h>\n18\t#include \"fs.h\"\n19\t\n20\tvoid\n21\tfs_error (const char *prefix) {\n22\t  char fmt[256];\n23\t  sprintf(fmt, \"fs: %s: error\", prefix);\n24\t  perror(fmt);\n25\t}\n26\t\n27\t\n28\tFILE *\n29\tfs_open (const char *path, const char *flags) {\n30\t  return fopen(path, flags);\n31\t}\n32\t\n33\t\n34\tint\n35\tfs_close (FILE *file) {\n36\t  return fclose(file);\n37\t}\n38\t\n39\t\n40\tint\n41\tfs_rename (const char *from, const char *to) {\n42\t  return rename(from, to);\n43\t}\n44\t\n45\t\n46\tfs_stats *\n47\tfs_stat (const char *path) {\n48\t  fs_stats *stats = (fs_stats*) malloc(sizeof(fs_stats));\n49\t  #ifndef _WIN32\n50\t    int e = stat(path, stats);\n51\t  #else\n52\t    int e = _stat(path, stats);\n53\t  #endif\n54\t  if (-1 == e) {\n55\t    free(stats);\n56\t    return NULL;\n57\t  }\n58\t  return stats;\n59\t}\n60\t\n61\t\n62\tfs_stats *\n63\tfs_fstat (FILE *file) {\n64\t  if (NULL == file) return NULL;\n65\t  fs_stats *stats = (fs_stats*) malloc(sizeof(fs_stats));\n66\t  int fd = fileno(file);\n67\t  int e = fstat(fd, stats);\n68\t  if (-1 == e) {\n69\t    free(stats);\n70\t    return NULL;\n71\t  }\n72\t  return stats;\n73\t}\n74\t\n75\t\n76\tfs_stats *\n77\tfs_lstat (const char *path) {\n78\t  fs_stats *stats = (fs_stats*) malloc(sizeof(fs_stats));\n79\t#ifdef _WIN32\n80\t  int e = stat(path, stats);\n81\t#else\n82\t  int e = lstat(path, stats);\n83\t#endif\n84\t  if (-1 == e) {\n85\t    free(stats);\n86\t    return NULL;\n87\t  }\n88\t  return stats;\n