o_array(t, curr->right, arr, n, count);\n\n}\n\nint rbtree_to_array(const rbtree *t, key_t *arr, const size_t n) {\n  // TODO: implement to_array\n  if (t->root == t->nil) {\n    return 0;\n  }\n\n  size_t cnt = 0;\n  subtree_to_array(t, t->root, arr, n, &cnt); \n  \n  return 0;\n}","numLines":389,"startLine":1,"totalLines":389}}}
