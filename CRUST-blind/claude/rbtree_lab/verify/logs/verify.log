>root == t->nil);\n67\t#else\n68\t  assert(t->root == NULL);\n69\t#endif\n70\t\n71\t  delete_rbtree(t);\n72\t}\n73\t\n74\tstatic void insert_arr(rbtree *t, const key_t *arr, const size_t n) {\n75\t  for (size_t i = 0; i < n; i++) {\n76\t    rbtree_insert(t, arr[i]);\n77\t  }\n78\t}\n79\t\n80\tstatic int comp(const void *p1, const void *p2) {\n81\t  const key_t *e1 = (const key_t *)p1;\n82\t  const key_t *e2 = (const key_t *)p2;\n83\t  if (*e1 < *e2) {\n84\t    return -1;\n85\t  } else if (*e1 > *e2) {\n86\t    return 1;\n87\t  } else {\n88\t    return 0;\n89\t  }\n90\t};\n91\t\n92\t// min/max should return the min/max value of the tree\n93\tvoid test_minmax(key_t *arr, const size_t n) {\n94\t  // null array is not allowed\n95\t  assert(n > 0 && arr != NULL);\n96\t\n97\t  rbtree *t = new_rbtree();\n98\t  assert(t != NULL);\n99\t\n100\t  insert_arr(t, arr, n);\n101\t  assert(t->root != NULL);\n102\t#ifdef SENTINEL\n103\t  assert(t->root != t->nil);\n104\t#endif\n105\t\n106\t  qsort((void *)arr, n, sizeof(key_t), comp);\n107\t  node_t *p = rbtree_min(t);\n108\t  assert(p != NULL);\n109\t  assert(p->key == arr[0]);\n110\t\n111\t  node_t *q = rbtree_max(t);\n112\t  assert(q != NULL);\n113\t  assert(q->key == arr[n - 1]);\n114\t\n115\t  rbtree_erase(t, p);\n116\t  p = rbtree_min(t);\n117\t  assert(p != NULL);\n118\t  assert(p->key == arr[1]);\n119\t\n120\t  if (n >= 2) {\n121\t    rbtree_erase(t, q);\n122\t    q = rbtree_max(t);\n123\t    assert(q != NULL);\n124\t    assert(q->key == arr[n - 2]);\n125\t  }\n126\t\n127\t  delete_rbtree(t);\n128\t}\n129\t\n130\tvoid test_to_array(rbtree *t, const key_t *arr, const size_t n) {\n131\t  assert(t != NULL);\n132\t\n133\t  insert_arr(t, arr, n);\n134\t  qsort((void *)arr, n, sizeof(key_t), comp);\n135\t\n136\t  key_t *res = calloc(n, sizeof(key_t));\n137\t  rbtree_to_array(t, res, n);\n138\t  for (int i = 0; i < n; i++) {\n139\t    assert(arr[i] == res[i]);\n140\t  }\n141\t  free(res);\n142\t}\n143\t\n144\tvoid test_multi_instance() {\n145\t  rbtree *t1 = new_rbtree();\n146\t  assert(t1 != NULL);\n147\t  rbtree *t2 = new_rbtree();\n148\t  assert(t2 != NULL);\n149\t\n150\t  key_t arr1[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12, 24, 36, 990, 25};\n151\t  const size_t n1 = sizeof(arr1) / sizeof(arr1[0]);\n152\t  insert_arr(t1, arr1, n1);\n153\t  qsort((void *)arr1, n1, sizeof(key_t), comp);\n154\t\n155\t  key_t arr2[] = {4, 8, 10, 5, 3};\n156\t  const size_t n2 = sizeof(arr2) / sizeof(arr2[0]);\n157\t  insert_arr(t2, arr2, n2);\n158\t  qsort((void *)arr2, n2, sizeof(key_t), comp);\n159\t\n160\t  key_t *res1 = calloc(n1, sizeof(key_t));\n161\t  rbtree_to_array(t1, res1, n1);\n162\t  for (int i = 0; i < n1; i++) {\n163\t    assert(arr1[i] == res1[i]);\n164\t  }\n165\t\n166\t  key_t *res2 = calloc(n2, sizeof(key_t));\n167\t  rbtree_to_array(t2, res2, n2);\n168\t  for (int i = 0; i < n2; i++) {\n169\t    assert(arr2[i] == res2[i]);\n170\t  }\n171\t\n172\t  delete_rbtree(t2);\n173\t  delete_rbtree(t1);\n174\t  free(res1);\n175\t  free(res2);\n176\t}\n177\t\n178\t// Search tree constraint\n179\t// The values of left subtree should be less than or equal to the current node\n180\t// The values of right subtree should be greater than or equal to the current\n181\t// node\n182\t\n183\tstatic bool search_traverse(const node_t *p, key_t *min, key_t *max,\n184\t                            node_t *nil) {\n185\t  if (p == nil) {\n186\t    return true;\n187\t  }\n188\t\n189\t  *min = *max = p->key;\n190\t\n191\t  key_t l_min, l_max, r_min, r_max;\n192\t  l_min = l_max = r_min = r_max = p->key;\n193\t\n194\t  const bool lr = search_traverse(p->left, &l_min, &l_max, nil);\n195\t  if (!lr || l_max > p->key) {\n196\t    return false;\n197\t  }\n198\t  const bool rr = search_traverse(p->right, &r_min, &r_max, nil);\n199\t  if (!rr || r_min < p->key) {\n200\t    return false;\n201\t  }\n202\t\n203\t  *min = l_min;\n204\t  *max = r_max;\n205\t  return true;\n206\t}\n207\t\n208\tvoid test_search_constraint(const rbtre