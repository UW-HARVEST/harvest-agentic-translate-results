{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01De51K5NPpFq9E3tUC52Fs1","type":"tool_result","content":"1\tuse std::cell::RefCell;\n2\tuse std::rc::Rc;\n3\t\n4\t#[derive(Debug, PartialEq, Clone)]\n5\tpub enum Color {\n6\t    Red,\n7\t    Black,\n8\t}\n9\t\n10\tpub type Key = i32;\n11\tpub type NodeRef = Rc<RefCell<Node>>;\n12\t\n13\t#[derive(Debug, Clone)]\n14\tpub struct Node {\n15\t    pub key: Key,\n16\t    pub color: Color,\n17\t    pub left: Option<NodeRef>,   // None == NIL\n18\t    pub right: Option<NodeRef>,  // None == NIL\n19\t    pub parent: Option<NodeRef>, // None == NIL / root parent\n20\t}\n21\t\n22\t#[derive(Debug, Clone)]\n23\tpub struct RBTree {\n24\t    /// Root of the tree. `None` means the tree is empty (NIL).\n25\t    pub root: Option<NodeRef>,\n26\t}\n27\t\n28\timpl RBTree {\n29\t    pub fn new() -> Self {\n30\t        RBTree { root: None }\n31\t    }\n32\t\n33\t    /// Performs a right rotation around non-NIL node `x`.\n34\t    pub fn right_rotate(&mut self, x: NodeRef) {\n35\t        // y = x.left  (must be non-NIL)\n36\t        let y = x.borrow().left.clone().expect(\"right_rotate: x.left must be non-NIL\");\n37\t\n38\t        // x.left = y.right\n39\t        let y_right = y.borrow().right.clone();\n40\t        x.borrow_mut().left = y_right.clone();\n41\t\n42\t        // if y.right != NIL: y.right.parent = x\n43\t        if let Some(yr) = &y_right {\n44\t            yr.borrow_mut().parent = Some(x.clone());\n45\t        }\n46\t\n47\t        // y.parent = x.parent\n48\t        let x_parent = x.borrow().parent.clone();\n49\t        y.borrow_mut().parent = x_parent.clone();\n50\t\n51\t        // Update x's old parent's pointer (or set root)\n52\t        match &x_parent {\n53\t            None => self.root = Some(y.clone()),\n54\t            Some(xp) => {\n55\t                let xp_left = xp.borrow().left.clone();\n56\t                let x_is_left = match xp_left {\n57\t                    Some(ref ln) => Rc::ptr_eq(ln, &x),\n58\t                    None => false,\n59\t                };\n60\t                if x_is_left {\n61\t                    xp.borrow_mut().left = Some(y.clone());\n62\t                } else {\n63\t                    xp.borrow_mut().right = Some(y.clone());\n64\t                }\n65\t            }\n66\t        }\n67\t\n68\t        // y.right = x; x.parent = y\n69\t        y.borrow_mut().right = Some(x.clone());\n70\t        x.borrow_mut().parent = Some(y);\n71\t    }\n72\t\n73\t    /// Performs a left rotation around non-NIL node `x`.\n74\t    pub fn left_rotate(&mut self, x: NodeRef) {\n75\t        // y = x.right  (must be non-NIL)\n76\t        let y = x.borrow().right.clone().expect(\"left_rotate: x.right must be non-NIL\");\n77\t\n78\t        // x.right = y.left\n79\t        let y_left = y.borrow().left.clone();\n80\t        x.borrow_mut().right = y_left.clone();\n81\t\n82\t        // if y.left != NIL: y.left.parent = x\n83\t        if let Some(yl) = &y_left {\n84\t            yl.borrow_mut().parent = Some(x.clone());\n85\t        }\n86\t\n87\t        // y.parent = x.parent\n88\t        let x_parent = x.borrow().parent.clone();\n89\t        y.borrow_mut().parent = x_parent.clone();\n90\t\n91\t        // Update x's old parent's pointer (or set root)\n92\t        match &x_parent {\n93\t            None => self.root = Some(y.clone()),\n94\t            Some(xp) => {\n95\t                let xp_left = xp.borrow().left.clone();\n96\t                let x_is_left = match xp_left {\n97\t                    Some(ref ln) => Rc::ptr_eq(ln, &x),\n98\t                    None => false,\n99\t                };\n100\t                if x_is_left {\n101\t                    xp.borrow_mut().left = Some(y.clone());\n102\t                } else {\n103\t                    xp.borrow_mut().right = Some(y.clone());\n104\t                }\n105\t            }\n106\t        }\n107\t\n108\t        // y.left = x; x.parent = y\n109\t        y.borrow_mut().left = Some(x.clone());\n110\t        x.borrow_mut().parent = Some(y);\n111\t    }\n112\t\n113\t    /// Recursively drops a subtree. `None` is treated as NIL.\n114\t    pub fn free_node(node: Option<NodeRef>) {\n115\t        if let Some(n) = node {\n116\t            let left = n.borrow_mut().left.take();\n117\t            let right = n.borrow_mut().right.take();\n118\t            Self::free_node(left);\n119\t            Self::free_node(right);\n120\t            // Break parent cycle\n121\t            n.borrow_mut().parent = None;\n122\t        }\n123\t    }\n124\t\n125\t    /// Deletes the Red-Black Tree safely.\n126\t    pub fn delete_rbtree(mut self) {\n127\t        Self::free_node(self.root.take());\n128\t        // self drops here\n129\t    }\n130\t\n131\t    /// Fixes the Red-Black Tree after insertion (z must be non-NIL).\n132\t    pub fn rbtree_insert_fixup(&mut self, z: NodeRef) {\n133\t        let mut z = z;\n134\t        loop {\n135\t            // Read z's parent\n136\t            let zp = match z.borrow().parent.clone() {\n137\t                Some(p) => p,\n138\t                None => break,\n139\t            };\n140\t            // Check parent's color\n141\t            if zp.borrow().color != Color::Red {\n142\t                break;\n143\t            }\n144\t            // Get grandparent (z's parent is red, so it's not the root, so grandparent exists)\n145\t            let zpp = match zp.borrow().parent.clone() {\n146\t                Some(p) => p,\n147\t                None => break,\n148\t            };\n149\t\n150\t            // Determine if zp is the left child of zpp\n151\t            let zpp_left = zpp.borrow().left.clone();\n152\t            let zp_is_left = match zpp_left {\n153\t                Some(ref ln) => Rc::ptr_eq(ln, &zp),\n154\t                None => false,\n155\t            };\n156\t\n157\t            if zp_is_left {\n158\t                let y = zpp.borrow().right.clone();\n159\t                let y_color = match &y {\n160\t                    Some(yn) => yn.borrow().color.clone(),\n161\t                    None => Color::Black,\n162\t                };\n163\t\n164\t                if y_color == Color::Red {\n165\t                    // Case 1: uncle is red\n166\t                    zp.borrow_mut().color = Color::Black;\n167\t                    if let Some(yn) = y {\n168\t                        yn.borrow_mut().color = Color::Black;\n169\t                    }\n170\t                    zpp.borrow_mut().color = Color::Red;\n171\t                    z = zpp;\n172\t                } else {\n173\t                    // Determine if z is right child of zp\n174\t                    let zp_right = zp.borrow().right.clone();\n175\t                    let z_is_right = match zp_right {\n176\t                        Some(ref rn) => Rc::ptr_eq(rn, &z),\n177\t                        None => false,\n178\t                    };\n179\t\n180\t                    if z_is_right {\n181\t                        // Case 2: z is a right child -> rotate left around parent\n182\t                        z = zp.clone();\n183\t                        self.left_rotate(z.clone());\n184\t                    }\n185\t\n186\t                    // Case 3\n187\t                    let zp_now = z.borrow().parent.clone().expect(\"z must have parent in case 3\");\n188\t                    zp_now.borrow_mut().color = Color::Black;\n189\t                    let zpp_now = zp_now.borrow().parent.clone().expect(\"z must have grandparent in case 3\");\n190\t                    zpp_now.borrow_mut().color = Color::Red;\n191\t                    self.right_rotate(zpp_now);\n192\t                }\n193\t            } else {\n194\t                // Symmetric: zp is the right child of zpp\n195\t                let y = zpp.borrow().left.clone();\n196\t                let y_color = match &y {\n197\t                    Some(yn) => yn.borrow().color.clone(),\n198\t                    None => Color::Black,\n199\t                };\n200\t\n201\t                if y_color == Color::Red {\n202\t                    zp.borrow_mut().color = Color::Black;\n203\t                    if let Some(yn) = y {\n204\t                        yn.borrow_mut().color = Color::Black;\n205\t                    }\n206\t                    zpp.borrow_mut().color = Color::Red;\n207\t                    z = zpp;\n208\t                } else {\n209\t                    let zp_left = zp.borrow().left.clone();\n210\t                    let z_is_left = match zp_left {\n211\t                        Some(ref ln) => Rc::ptr_eq(ln, &z),\n212\t                        None => false,\n213\t                    };\n214\t\n215\t                    if z_is_left {\n216\t                        z = zp.clone();\n217\t                        self.right_rotate(z.clone());\n218\t                    }\n219\t\n220\t                    let zp_now = z.borrow().parent.clone().expect(\"z must have parent in case 3\");\n221\t                    zp_now.borrow_mut().color = Color::Black;\n222\t                    let zpp_now = zp_now.borrow().parent.clone().expect(\"z must have grandparent in case 3\");\n223\t                    zpp_now.borrow_mut().color = Color::Red;\n224\t                    self.left_rotate(zpp_now);\n225\t                }\n226\t            }\n227\t        }\n228\t\n229\t        // Root must be black\n230\t        if let Some(root) = &self.root {\n231\t            root.borrow_mut().color = Color::Black;\n232\t        }\n233\t    }\n234\t\n235\t    /// Inserts a new key and returns the inserted node.\n236\t    pub fn rbtree_insert(&mut self, key: Key) -> Option<NodeRef> {\n237\t        let z = Rc::new(RefCell::new(Node {\n238\t            key,\n239\t            color: Color::Red,\n240\t            left: None,\n241\t            right: None,\n242\t            parent: None,\n243\t        }));\n244\t\n245\t        let mut y: Option<NodeRef> = None;\n246\t        let mut x = self.root.clone();\n247\t\n248\t        while let Some(xn) = x {\n249\t            y = Some(xn.clone());\n250\t            let xkey = xn.borrow().key;\n251\t            x = if key < xkey {\n252\t                xn.borrow().left.clone()\n253\t            } else {\n254\t                xn.borrow().right.clone()\n255\t            };\n256\t        }\n257\t\n258\t        z.borrow_mut().parent = y.clone();\n259\t\n260\t        match y {\n261\t            None => self.root = Some(z.clone()),\n262\t            Some(yn) => {\n263\t                let ykey = yn.borrow().key;\n264\t                if key < ykey {\n265\t                    yn.borrow_mut().left = Some(z.clone());\n266\t                } else {\n267\t                    yn.borrow_mut().right = Some(z.clone());\n268\t                }\n269\t            }\n270\t        }\n271\t\n272\t        // z.left = NIL, z.right = NIL, z.color = RED already set above\n273\t        self.rbtree_insert_fixup(z.clone());\n274\t\n275\t        Some(z)\n276\t    }\n277\t\n278\t    /// Finds a node by key. Returns `None` if not found.\n279\t    pub fn rbtree_find(&self, key: Key) -> Option<NodeRef> {\n280\t        let mut current = self.root.clone();\n281\t        while let Some(c) = current {\n282\t            let ckey = c.borrow().key;\n283\t            if ckey == key {\n284\t                return Some(c);\n285\t            }\n286\t            current = if ckey < key {\n287\t                c.borrow().right.clone()\n288\t            } else {\n289\t                c.borrow().left.clone()\n290\t            };\n291\t        }\n292\t        None\n293\t    }\n294\t\n295\t    /// Returns the minimum node, or `None` if the tree is empty.\n296\t    pub fn rbtree_min(&self) -> Option<NodeRef> {\n297\t        let mut curr = self.root.clone()?;\n298\t        loop {\n299\t            let next = curr.borrow().left.clone();\n300\t            match next {\n301\t                Some(n) => curr = n,\n302\t                None => return Some(curr),\n303\t            }\n304\t        }\n305\t    }\n306\t\n307\t    /// Returns the maximum node, or `None` if the tree is empty.\n308\t    pub fn rbtree_max(&self) -> Option<NodeRef> {\n309\t        let mut curr = self.root.clone()?;\n310\t        loop {\n311\t            let next = curr.borrow().right.clone();\n312\t            match next {\n313\t                Some(n) => curr = n,\n314\t                None => return Some(curr),\n315\t            }\n316\t        }\n317\t    }\n318\t\n319\t    /// Replaces subtree rooted at `u` with subtree rooted at `v` (`None` == NIL).\n320\t    pub fn transplant(&mut self, u: NodeRef, v: Option<NodeRef>) {\n321\t        let u_parent = u.borrow().parent.clone();\n322\t        match &u_parent {\n323\t            None => self.root = v.clone(),\n324\t            Some(up) => {\n325\t                let up_left = up.borrow().left.clone();\n326\t                let u_is_left = match up_left {\n327\t                    Some(ref ln) => Rc::ptr_eq(ln, &u),\n328\t                    None => false,\n329\t                };\n330\t                if u_is_left {\n331\t                    up.borrow_mut().left = v.clone();\n332\t                } else {\n333\t                    up.borrow_mut().right = v.clone();\n334\t                }\n335\t            }\n336\t        }\n337\t\n338\t        if let Some(vn) = &v {\n339\t            vn.borrow_mut().parent = u_parent;\n340\t        }\n341\t    }\n342\t\n343\t    /// Fixes up after deletion starting from node `x` (`None` == NIL).\n344\t    pub fn delete_fixup(&mut self, x: Option<NodeRef>) {\n345\t        // Read x's parent for the initial call. If x is None we have no way to\n346\t        // know its parent through this public API, so default to None.\n347\t        let x_parent = match &x {\n348\t            Some(n) => n.borrow().parent.clone(),\n349\t            None => None,\n350\t        };\n351\t        self.delete_fixup_internal(x, x_parent);\n352\t    }\n353\t\n354\t    /// Internal delete-fixup that tracks parent explicitly so it works correctly\n355\t    /// when `x` is NIL (`None`).\n356\t    fn delete_fixup_internal(&mut self, mut x: Option<NodeRef>, mut x_parent: Option<NodeRef>) {\n357\t        loop {\n358\t            // x != root?\n359\t            let is_root = match (&x, &self.root) {\n360\t                (Some(xn), Some(rn)) => Rc::ptr_eq(xn, rn),\n361\t                (None, None) => true,\n362\t                _ => false,\n363\t            };\n364\t            if is_root {\n365\t                break;\n366\t            }\n367\t\n368\t            // x.color != BLACK?\n369\t            let x_color = match &x {\n370\t                Some(xn) => xn.borrow().color.clone(),\n371\t                None => Color::Black,\n372\t            };\n373\t            if x_color != Color::Black {\n374\t                break;\n375\t            }\n376\t\n377\t            let xp = match &x_parent {\n378\t                Some(p) => p.clone(),\n379\t                None => break, // shouldn't happen if invariants hold\n380\t            };\n381\t\n382\t            // Determine if x is the left child of xp\n383\t            let xp_left = xp.borrow().left.clone();\n384\t            let is_left = match (&x, &xp_left) {\n385\t                (Some(xn), Some(ln)) => Rc::ptr_eq(xn, ln),\n386\t                (None, None) => true,\n387\t                _ => false,\n388\t            };\n389\t\n390\t            if is_left {\n391\t                // Sibling w must exist (otherwise black-height invariant violated)\n392\t                let mut w = xp.borrow().right.clone().expect(\"sibling must exist\");\n393\t\n394\t                // CASE 1: w is red\n395\t                if w.borrow().color == Color::Red {\n396\t                    w.borrow_mut().color = Color::Black;\n397\t                    xp.borrow_mut().color = Color::Red;\n398\t                    self.left_rotate(xp.clone());\n399\t                    w = xp.borrow().right.clone().expect(\"sibling must exist after rotation\");\n400\t                }\n401\t\n402\t                // Children colors of w\n403\t                let w_left_color = match w.borrow().left.clone() {\n404\t                    Some(n) => n.borrow().color.clone(),\n405\t                    None => Color::Black,\n406\t                };\n407\t                let w_right_color = match w.borrow().right.clone() {\n408\t                    Some(n) => n.borrow().color.clone(),\n409\t                    None => Color::Black,\n410\t                };\n411\t\n412\t                if w_left_color == Color::Black && w_right_color == Color::Black {\n413\t                    // CASE 2: both w's children are black\n414\t                    w.borrow_mut().color = Color::Red;\n415\t                    let new_x_parent = xp.borrow().parent.clone();\n416\t                    x = Some(xp.clone());\n417\t                    x_parent = new_x_parent;\n418\t                } else {\n419\t                    // CASE 3: w right child is black (so w left child is red)\n420\t                    if w_right_color == Color::Black {\n421\t                        if let Some(wl) = w.borrow().left.clone() {\n422\t                            wl.borrow_mut().color = Color::Black;\n423\t                        }\n424\t                        w.borrow_mut().color = Color::Red;\n425\t                        self.right_rotate(w.clone());\n426\t                        w = xp.borrow().right.clone().expect(\"sibling must exist after rotation\");\n427\t                    }\n428\t\n429\t                    // CASE 4: w right child is red\n430\t                    let xp_color = xp.borrow().color.clone();\n431\t                    w.borrow_mut().color = xp_color;\n432\t                    xp.borrow_mut().color = Color::Black;\n433\t                    if let Some(wr) = w.borrow().right.clone() {\n434\t                        wr.borrow_mut().color = Color::Black;\n435\t                    }\n436\t                    self.left_rotate(xp.clone());\n437\t                    x = self.root.clone();\n438\t                    x_parent = None;\n439\t                }\n440\t            } else {\n441\t                // Symmetric case: x is right child\n442\t                let mut w = xp.borrow().left.clone().expect(\"sibling must exist\");\n443\t\n444\t                // CASE 5: w is red\n445\t                if w.borrow().color == Color::Red {\n446\t                    w.borrow_mut().color = Color::Black;\n447\t                    xp.borrow_mut().color = Color::Red;\n448\t                    self.right_rotate(xp.clone());\n449\t                    w = xp.borrow().left.clone().expect(\"sibling must exist after rotation\");\n450\t                }\n451\t\n452\t                let w_left_color = match w.borrow().left.clone() {\n453\t                    Some(n) => n.borrow().color.clone(),\n454\t                    None => Color::Black,\n455\t                };\n456\t                let w_right_color = match w.borrow().right.clone() {\n457\t                    Some(n) => n.borrow().color.clone(),\n458\t                    None => Color::Black,\n459\t                };\n460\t\n461\t                if w_left_color == Color::Black && w_right_color == Color::Black {\n462\t                    // CASE 6\n463\t                    w.borrow_mut().color = Color::Red;\n464\t                    let new_x_parent = xp.borrow().parent.clone();\n465\t                    x = Some(xp.clone());\n466\t                    x_parent = new_x_parent;\n467\t                } else {\n468\t                    // CASE 7: w left child is black (so w right child is red)\n469\t                    if w_left_color == Color::Black {\n470\t                        if let Some(wr) = w.borrow().right.clone() {\n471\t                            wr.borrow_mut().color = Color::Black;\n472\t                        }\n473\t                        w.borrow_mut().color = Color::Red;\n474\t                        self.left_rotate(w.clone());\n475\t                        w = xp.borrow().left.clone().expect(\"sibling must exist after rotation\");\n476\t                    }\n477\t\n478\t                    // CASE 8: w left child is red\n479\t                    let xp_color = xp.borrow().color.clone();\n480\t                    w.borrow_mut().color = xp_color;\n481\t                    xp.borrow_mut().color = Color::Black;\n482\t                    if let Some(wl) = w.borrow().left.clone() {\n483\t                        wl.borrow_mut().color = Color::Black;\n484\t                    }\n485\t                    self.right_rotate(xp.clone());\n486\t                    x = self.root.clone();\n487\t                    x_parent = None;\n488\t                }\n489\t            }\n490\t        }\n491\t\n492\t        if let Some(xn) = &x {\n493\t            xn.borrow_mut().color = Color::Black;\n494\t        }\n495\t    }\n496\t\n497\t    /// Erases node `p` (must be a valid non-NIL node in the tree).\n498\t    pub fn erase(&mut self, p: NodeRef) {\n499\t        let mut y = p.clone();\n500\t        let mut y_original_color = y.borrow().color.clone();\n501\t\n502\t        let p_left = p.borrow().left.clone();\n503\t        let p_right = p.borrow().right.clone();\n504\t\n505\t        let x: Option<NodeRef>;\n506\t        let x_parent: Option<NodeRef>;\n507\t\n508\t        if p_left.is_none() {\n509\t            // p has no left child\n510\t            x = p_right.clone();\n511\t            let pp = p.borrow().parent.clone();\n512\t            self.transplant(p.clone(), p_right);\n513\t            x_parent = pp;\n514\t        } else if p_right.is_none() {\n515\t            // p has no right child\n516\t            x = p_left.clone();\n517\t            let pp = p.borrow().parent.clone();\n518\t            self.transplant(p.clone(), p_left);\n519\t            x_parent = pp;\n520\t        } else {\n521\t            // p has both children: find successor\n522\t            let mut yt = p.borrow().right.clone().expect(\"right child exists\");\n523\t            loop {\n524\t                let next = yt.borrow().left.clone();\n525\t                match next {\n526\t                    Some(n) => yt = n,\n527\t                    None => break,\n528\t                }\n529\t            }\n530\t            y = yt;\n531\t            y_original_color = y.borrow().color.clone();\n532\t            x = y.borrow().right.clone();\n533\t\n534\t            let y_parent = y.borrow().parent.clone();\n535\t            let yp_eq_p = match &y_parent {\n536\t                Some(yp) => Rc::ptr_eq(yp, &p),\n537\t                None => false,\n538\t            };\n539\t\n540\t            if yp_eq_p {\n541\t                // y is direct child of p\n542\t                if let Some(ref xn) = x {\n543\t                    xn.borrow_mut().parent = Some(y.clone());\n544\t                }\n545\t                x_parent = Some(y.clone());\n546\t            } else {\n547\t                // y is deeper; transplant y with y.right (== x)\n548\t                let y_right = y.borrow().right.clone();\n549\t                self.transplant(y.clone(), y_right);\n550\t                // After transplant: x's parent (if Some) is now y_parent.\n551\t                // We track x_parent as y_parent for the case x is None too.\n552\t                x_parent = y_parent;\n553\t\n554\t                // y.right = p.right; y.right.parent = y\n555\t                let pr = p.borrow().right.clone();\n556\t                y.borrow_mut().right = pr.clone();\n557\t                if let Some(pr) = pr {\n558\t                    pr.borrow_mut().parent = Some(y.clone());\n559\t                }\n560\t            }\n561\t\n562\t            // transplant(p, y)\n563\t            self.transplant(p.clone(), Some(y.clone()));\n564\t            // y.left = p.left; p.left.parent = y\n565\t            let pl = p.borrow().left.clone();\n566\t            y.borrow_mut().left = pl.clone();\n567\t            if let Some(pl) = pl {\n568\t                pl.borrow_mut().parent = Some(y.clone());\n569\t            }\n570\t            let p_color = p.borrow().color.clone();\n571\t            y.borrow_mut().color = p_color;\n572\t        }\n573\t\n574\t        // Detach p from the tree to break cycles and free its memory\n575\t        {\n576\t            let mut pb = p.borrow_mut();\n577\t            pb.parent = None;\n578\t            pb.left = None;\n579\t            pb.right = None;\n580\t        }\n581\t\n582\t        if y_original_color == Color::Black {\n583\t            self.delete_fixup_internal(x, x_parent);\n584\t        }\n585\t    }\n586\t\n587\t    /// In-order traversal of `curr` into `arr` until `n` elements (`None` == NIL).\n588\t    pub fn subtree_to_array(\n589\t        &self,\n590\t        curr: Option<NodeRef>,\n591\t        arr: &mut Vec<Key>,\n592\t        n: usize,\n593\t        count: &mut usize,\n594\t    ) {\n595\t        if let Some(c) = curr {\n596\t            let left = c.borrow().left.clone();\n597\t            self.subtree_to_array(left, arr, n, count);\n598\t            if *count < n {\n599\t                arr.push(c.borrow().key);\n600\t                *count += 1;\n601\t            } else {\n602\t                return;\n603\t            }\n604\t            let right = c.borrow().right.clone();\n605\t            self.subtree_to_array(right, arr, n, count);\n606\t        }\n607\t    }\n608\t\n609\t    /// Returns up to `n` keys from the tree in-order.\n610\t    pub fn to_array(&self, n: usize) -> Vec<Key> {\n611\t        let mut arr: Vec<Key> = Vec::with_capacity(n);\n612\t        if self.root.is_none() {\n613\t            return arr;\n614\t        }\n615\t        let mut count: usize = 0;\n616\t        self.subtree_to_array(self.root.clone(), &mut arr, n, &mut count);\n617\t        arr\n618\t    }\n619\t}\n620\t\n621\timpl Default for RBTree {\n622\t    fn default() -> Self {\n623\t        Self::new()\n624\t    }\n625\t}\n626\t\n627\timpl Drop for RBTree {\n628\t    fn drop(&mut self) {\n629\t        // Break parent cycles so nodes can be freed\n630\t        Self::free_node(self.root.take());\n631\t    }\n632\t}\n633\t"}]},"parent_tool_use_id":null,"session_id":"46022bb6-f4f1-4832-ba95-1bf4a7849988","uuid":"237765bf-6c3d-44a8-814f-1e3da591815c","timestamp":"2026-05-29T19:07:53.358Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-Cko1ZA/project/src/rbtree.rs","content":"use std::cell::RefCell;\nuse std::rc::Rc;\n\n#[derive(Debug, PartialEq, Clone)]\npub enum Color {\n    Red,\n    Black,\n}\n\npub type Key = i32;\npub type NodeRef = Rc<RefCell<Node>>;\n\n#[derive(Debug, Clone)]\npub struct Node {\n    pub key: Key,\n    pub color: Color,\n    pub left: Option<NodeRef>,   // None == NIL\n    pub right: Option<NodeRef>,  // None == NIL\n    pub parent: Option<NodeRef>, // None == NIL / root parent\n}\n\n#[derive(Debug, Clone)]\npub struct RBTree {\n    /// Root of the tree. `None` means the tree is empty (NIL).\n    pub root: Option<NodeRef>,\n}\n\nimpl RBTree {\n    pub fn new() -> Self {\n        RBTree { root: None }\n    }\n\n    /// Performs a right rotation around non-NIL node `x`.\n    pub fn right_rotate(&mut self, x: NodeRef) {\n        // y = x.left  (must be non-NIL)\n        let y = x.borrow().left.clone().expect(\"right_rotate: x.left must be non-NIL\");\n\n        // x.left = y.right\n        let y_right = y.borrow().right.clone();\n        x.borrow_mut().left = y_right.clone();\n\n        // if y.right != NIL: y.right.parent = x\n        if let Some(yr) = &y_right {\n            yr.borrow_mut().parent = Some(x.clone());\n        }\n\n        // y.parent = x.parent\n        let x_parent = x.borrow().parent.clone();\n        y.borrow_mut().parent = x_parent.clone();\n\n        // Update x's old parent's pointer (or set root)\n        match &x_parent {\n            None => self.root = Some(y.clone()),\n            Some(xp) => {\n                let xp_left = xp.borrow().left.clone();\n                let x_is_left = match xp_left {\n                    Some(ref ln) => Rc::ptr_eq(ln, &x),\n                    None => false,\n                };\n                if x_is_left {\n                    xp.borrow_mut().left = Some(y.clone());\n                } else {\n                    xp.borrow_mut().right = Some(y.clone());\n                }\n            }\n        }\n\n        // y.right = x; x.parent = y\n        y.borrow_mut().right = Some(x.clone());\n        x.borrow_mut().parent = Some(y);\n    }\n\n    /// Performs a left rotation around non-NIL node `x`.\n    pub fn left_rotate(&mut self, x: NodeRef) {\n        // y = x.right  (must be non-NIL)\n        let y = x.borrow().right.clone().expect(\"left_rotate: x.right must be non-NIL\");\n\n        // x.right = y.left\n        let y_left = y.borrow().left.clone();\n        x.borrow_mut().right = y_left.clone();\n\n        // if y.left != NIL: y.left.parent = x\n        if let Some(yl) = &y_left {\n            yl.borrow_mut().parent = Some(x.clone());\n        }\n\n        // y.parent = x.parent\n        let x_parent = x.borrow().parent.clone();\n        y.borrow_mut().parent = x_parent.clone();\n\n        // Update x's old parent's pointer (or set root)\n        match &x_parent {\n            None => self.root = Some(y.clone()),\n            Some(xp) => {\n                let xp_left = xp.borrow().left.clone();\n                let x_is_left = match xp_left {\n                    Some(ref ln) => Rc::ptr_eq(ln, &x),\n                    None => false,\n                };\n                if x_is_left {\n                    xp.borrow_mut().left = Some(y.clone());\n                } else {\n                    xp.borrow_mut().right = Some(y.clone());\n                }\n            }\n        }\n\n        // y.left = x; x.parent = y\n        y.borrow_mut().left = Some(x.clone());\n        x.borrow_mut().parent = Some(y);\n    }\n\n    /// Recursively drops a subtree. `None` is treated as NIL.\n    pub fn free_node(node: Option<NodeRef>) {\n        if let Some(n) = node {\n            let left = n.borrow_mut().left.take();\n            let right = n.borrow_mut().right.take();\n            Self::free_node(left);\n            Self::free_node(right);\n            // Break parent cycle\n            n.borrow_mut().parent = None;\n        }\n    }\n\n    /// Deletes the Red-Black Tree safely.\n    pub fn delete_rbtree(mut self) {\n        Self::free_node(self.root.take());\n        // self drops here\n    }\n\n    /// Fixes the Red-Black Tree after insertion (z must be non-NIL).\n    pub fn rbtree_insert_fixup(&mut self, z: NodeRef) {\n        let mut z = z;\n        loop {\n            // Read z's parent\n            let zp = match z.borrow().parent.clone() {\n                Some(p) => p,\n                None => break,\n            };\n            // Check parent's color\n            if zp.borrow().color != Color::Red {\n                break;\n            }\n            // Get grandparent (z's parent is red, so it's not the root, so grandparent exists)\n            let zpp = match zp.borrow().parent.clone() {\n                Some(p) => p,\n                None => break,\n            };\n\n            // Determine if zp is the left child of zpp\n            let zpp_left = zpp.borrow().left.clone();\n            let zp_is_left = match zpp_left {\n                Some(ref ln) => Rc::ptr_eq(ln, &zp),\n                None => false,\n            };\n\n            if zp_is_left {\n                let y = zpp.borrow().right.clone();\n                let y_color = match &y {\n                    Some(yn) => yn.borrow().color.clone(),\n                    None => Color::Black,\n                };\n\n                if y_color == Color::Red {\n                    // Case 1: uncle is red\n                    zp.borrow_mut().color = Color::Black;\n                    if let Some(yn) = y {\n                        yn.borrow_mut().color = Color::Black;\n                    }\n                    zpp.borrow_mut().color = Color::Red;\n                    z = zpp;\n                } else {\n                    // Determine if z is right child of zp\n                    let zp_right = zp.borrow().right.clone();\n                    let z_is_right = match zp_right {\n                        Some(ref rn) => Rc::ptr_eq(rn, &z),\n                        None => false,\n                    };\n\n                    if z_is_right {\n                        // Case 2: z is a right child -> rotate left around parent\n                        z = zp.clone();\n                        self.left_rotate(z.clone());\n                    }\n\n                    // Case 3\n                    let zp_now = z.borrow().parent.clone().expect(\"z must have parent in case 3\");\n                    zp_now.borrow_mut().color = Color::Black;\n                    let zpp_now = zp_now.borrow().parent.clone().expect(\"z must have grandparent in case 3\");\n                    zpp_now.borrow_mut().color = Color::Red;\n                    self.right_rotate(zpp_now);\n                }\n            } else {\n                // Symmetric: zp is the right child of zpp\n                let y = zpp.borrow().left.clone();\n                let y_color = match &y {\n                    Some(yn) => yn.borrow().color.clone(),\n                    None => Color::Black,\n                };\n\n                if y_color == Color::Red {\n                    zp.borrow_mut().color = Color::Black;\n                    if let Some(yn) = y {\n                        yn.borrow_mut().color = Color::Black;\n                    }\n                    zpp.borrow_mut().color = Color::Red;\n                    z = zpp;\n                } else {\n                    let zp_left = zp.borrow().left.clone();\n                    let z_is_left = match zp_left {\n                        Some(ref ln) => Rc::ptr_eq(ln, &z),\n                        None => false,\n                    };\n\n                    if z_is_left {\n                        z = zp.clone();\n                        self.right_rotate(z.clone());\n                    }\n\n                    let zp_now = z.borrow().parent.clone().expect(\"z must have parent in case 3\");\n                    zp_now.borrow_mut().color = Color::Black;\n                    let zpp_now = zp_now.borrow().parent.clone().expect(\"z must have grandparent in case 3\");\n                    zpp_now.borrow_mut().color = Color::Red;\n                    self.left_rotate(zpp_now);\n                }\n            }\n        }\n\n        // Root must be black\n        if let Some(root) = &self.root {\n            root.borrow_mut().color = Color::Black;\n        }\n    }\n\n    /// Inserts a new key and returns the inserted node.\n    pub fn rbtree_insert(&mut self, key: Key) -> Option<NodeRef> {\n        let z = Rc::new(RefCell::new(Node {\n            key,\n            color: Color::Red,\n            left: None,\n            right: None,\n            parent: None,\n        }));\n\n        let mut y: Option<NodeRef> = None;\n        let mut x = self.root.clone();\n\n        while let Some(xn) = x {\n            y = Some(xn.clone());\n            let xkey = xn.borrow().key;\n            x = if key < xkey {\n                xn.borrow().left.clone()\n            } else {\n                xn.borrow().right.clone()\n            };\n        }\n\n        z.borrow_mut().parent = y.clone();\n\n        match y {\n            None => self.root = Some(z.clone()),\n            Some(yn) => {\n                let ykey = yn.borrow().key;\n                if key < ykey {\n                    yn.borrow_mut().left = Some(z.clone());\n                } else {\n                    yn.borrow_mut().right = Some(z.clone());\n                }\n            }\n        }\n\n        // z.left = NIL, z.right = NIL, z.color = RED already set above\n        self.rbtree_insert_fixup(z.clone());\n\n        Some(z)\n    }\n\n    /// Finds a node by key. Returns `None` if not found.\n    pub fn rbtree_find(&self, key: Key) -> Option<NodeRef> {\n        let mut current = self.root.clone();\n        while let Some(c) = current {\n            let ckey = c.borrow().key;\n            if ckey == key {\n                return Some(c);\n            }\n            current = if ckey < key {\n                c.borrow().right.clone()\n            } else {\n                c.borrow().left.clone()\n            };\n        }\n        None\n    }\n\n    /// Returns the minimum node, or `None` if the tree is empty.\n    pub fn rbtree_min(&self) -> Option<NodeRef> {\n        let mut curr = self.root.clone()?;\n        loop {\n            let next = curr.borrow().left.clone();\n            match next {\n                Some(n) => curr = n,\n                None => return Some(curr),\n            }\n        }\n    }\n\n    /// Returns the maximum node, or `None` if the tree is empty.\n    pub fn rbtree_max(&self) -> Option<NodeRef> {\n        let mut curr = self.root.clone()?;\n        loop {\n            let next = curr.borrow().right.clone();\n            match next {\n                Some(n) => curr = n,\n                None => return Some(curr),\n            }\n        }\n    }\n\n    /// Replaces subtree rooted at `u` with subtree rooted at `v` (`None` == NIL).\n    pub fn transplant(&mut self, u: NodeRef, v: Option<NodeRef>) {\n        let u_parent = u.borrow().parent.clone();\n        match &u_parent {\n            None => self.root = v.clone(),\n            Some(up) => {\n                let up_left = up.borrow().left.clone();\n                let u_is_left = match up_left {\n                    Some(ref ln) => Rc::ptr_eq(ln, &u),\n                    None => false,\n                };\n                if u_is_left {\n                    up.borrow_mut().left = v.clone();\n                } else {\n                    up.borrow_mut().right = v.clone();\n                }\n            }\n        }\n\n        if let Some(vn) = &v {\n            vn.borrow_mut().parent = u_parent;\n        }\n    }\n\n    /// Fixes up after deletion starting from node `x` (`None` == NIL).\n    pub fn delete_fixup(&mut self, x: Option<NodeRef>) {\n        // Read x's parent for the initial call. If x is None we have no way to\n        // know its parent through this public API, so default to None.\n        let x_parent = match &x {\n            Some(n) => n.borrow().parent.clone(),\n            None => None,\n        };\n        self.delete_fixup_internal(x, x_parent);\n    }\n\n    /// Internal delete-fixup that tracks parent explicitly so it works correctly\n    /// when `x` is NIL (`None`).\n    fn delete_fixup_internal(&mut self, mut x: Option<NodeRef>, mut x_parent: Option<NodeRef>) {\n        loop {\n            // x != root?\n            let is_root = match (&x, &self.root) {\n                (Some(xn), Some(rn)) => Rc::ptr_eq(xn, rn),\n                (None, None) => true,\n                _ => false,\n            };\n            if is_root {\n                break;\n            }\n\n            // x.color != BLACK?\n            let x_color = match &x {\n                Some(xn) => xn.borrow().color.clone(),\n                None => Color::Black,\n            };\n            if x_color != Color::Black {\n                break;\n            }\n\n            let xp = match &x_parent {\n                Some(p) => p.clone(),\n                None => break, // shouldn't happen if invariants hold\n            };\n\n            // Determine if x is the left child of xp\n            let xp_left = xp.borrow().left.clone();\n            let is_left = match (&x, &xp_left) {\n                (Some(xn), Some(ln)) => Rc::ptr_eq(xn, ln),\n                (None, None) => true,\n                _ => false,\n            };\n\n            if is_left {\n                // Sibling w must exist (otherwise black-height invariant violated)\n                let mut w = xp.borrow().right.clone().expect(\"sibling must exist\");\n\n                // CASE 1: w is red\n                if w.borrow().color == Color::Red {\n                    w.borrow_mut().color = Color::Black;\n                    xp.borrow_mut().color = Color::Red;\n                    self.left_rotate(xp.clone());\n                    w = xp.borrow().right.clone().expect(\"sibling must exist after rotation\");\n                }\n\n                // Children colors of w\n                let w_left_color = match w.borrow().left.clone() {\n                    Some(n) => n.borrow().color.clone(),\n                    None => Color::Black,\n                };\n                let w_right_color = match w.borrow().right.clone() {\n                    Some(n) => n.borrow().color.clone(),\n                    None => Color::Black,\n                };\n\n                if w_left_color == Color::Black && w_right_color == Color::Black {\n                    // CASE 2: both w's children are black\n                    w.borrow_mut().color = Color::Red;\n                    let new_x_parent = xp.borrow().parent.clone();\n                    x = Some(xp.clone());\n                    x_parent = new_x_parent;\n                } else {\n                    // CASE 3: w right child is black (so w left child is red)\n                    if w_right_color == Color::Black {\n                        if let Some(wl) = w.borrow().left.clone() {\n                            wl.borrow_mut().color = Color::Black;\n                        }\n                        w.borrow_mut().color = Color::Red;\n                        self.right_rotate(w.clone());\n                        w = xp.borrow().right.clone().expect(\"sibling must exist after rotation\");\n                    }\n\n                    // CASE 4: w right child is red\n                    let xp_color = xp.borrow().color.clone();\n                    w.borrow_mut().color = xp_color;\n                    xp.borrow_mut().color = Color::Black;\n                    if let Some(wr) = w.borrow().right.clone() {\n                        wr.borrow_mut().color = Color::Black;\n                    }\n                    self.left_rotate(xp.clone());\n                    x = self.root.clone();\n                    x_parent = None;\n                }\n            } else {\n                // Symmetric case: x is right child\n                let mut w = xp.borrow().left.clone().expect(\"sibling must exist\");\n\n                // CASE 5: w is red\n                if w.borrow().color == Color::Red {\n                    w.borrow_mut().color = Color::Black;\n                    xp.borrow_mut().color = Color::Red;\n                    self.right_rotate(xp.clone());\n                    w = xp.borrow().left.clone().expect(\"sibling must exist after rotation\");\n                }\n\n                let w_left_color = match w.borrow().left.clone() {\n                    Some(n) => n.borrow().color.clone(),\n                    None => Color::Black,\n                };\n                let w_right_color = match w.borrow().right.clone() {\n                    Some(n) => n.borrow().color.clone(),\n                    None => Color::Black,\n                };\n\n                if w_left_color == Color::Black && w_right_color == Color::Black {\n                    // CASE 6\n                    w.borrow_mut().color = Color::Red;\n                    let new_x_parent = xp.borrow().parent.clone();\n                    x = Some(xp.clone());\n                    x_parent = new_x_parent;\n                } else {\n                    // CASE 7: w left child is black (so w right child is red)\n                    if w_left_color == Color::Black {\n                        if let Some(wr) = w.borrow().right.clone() {\n                            wr.borrow_mut().color = Color::Black;\n                        }\n                        w.borrow_mut().color = Color::Red;\n                        self.left_rotate(w.clone());\n                        w = xp.borrow().left.clone().expect(\"sibling must exist after rotation\");\n                    }\n\n                    // CASE 8: w left child is red\n                    let xp_color = xp.borrow().color.clone();\n                    w.borrow_mut().color = xp_color;\n                    xp.borrow_mut().color = Color::Black;\n                    if let Some(wl) = w.borrow().left.clone() {\n                        wl.borrow_mut().color = Color::Black;\n                    }\n                    self.right_rotate(xp.clone());\n                    x = self.root.clone();\n                    x_parent = None;\n                }\n            }\n        }\n\n        if let Some(xn) = &x {\n            xn.borrow_mut().color = Color::Black;\n        }\n    }\n\n    /// Erases node `p` (must be a valid non-NIL node in the tree).\n    pub fn erase(&mut self, p: NodeRef) {\n        let mut y = p.clone();\n        let mut y_original_color = y.borrow().color.clone();\n\n        let p_left = p.borrow().left.clone();\n        let p_right = p.borrow().right.clone();\n\n        let x: Option<NodeRef>;\n        let x_parent: Option<NodeRef>;\n\n        if p_left.is_none() {\n            // p has no left child\n            x = p_right.clone();\n            let pp = p.borrow().parent.clone();\n            self.transplant(p.clone(), p_right);\n            x_parent = pp;\n        } else if p_right.is_none() {\n            // p has no right child\n            x = p_left.clone();\n            let pp = p.borrow().parent.clone();\n            self.transplant(p.clone(), p_left);\n            x_parent = pp;\n        } else {\n            // p has both children: find successor\n            let mut yt = p.borrow().right.clone().expect(\"right child exists\");\n            loop {\n                let next = yt.borrow().left.clone();\n                match next {\n                    Some(n) => yt = n,\n                    None => break,\n                }\n            }\n            y = yt;\n            y_original_color = y.borrow().color.clone();\n            x = y.borrow().right.clone();\n\n            let y_parent = y.borrow().parent.clone();\n            let yp_eq_p = match &y_parent {\n                Some(yp) => Rc::ptr_eq(yp, &p),\n                None => false,\n            };\n\n            if yp_eq_p {\n                // y is direct child of p\n                if let Some(ref xn) = x {\n                    xn.borrow_mut().parent = Some(y.clone());\n                }\n                x_parent = Some(y.clone());\n            } else {\n                // y is deeper; transplant y with y.right (== x)\n                let y_right = y.borrow().right.clone();\n                self.transplant(y.clone(), y_right);\n                // After transplant: x's parent (if Some) is now y_parent.\n                // We track x_parent as y_parent for the case x is None too.\n                x_parent = y_parent;\n\n                // y.right = p.right; y.right.parent = y\n                let pr = p.borrow().right.clone();\n                y.borrow_mut().right = pr.clone();\n                if let Some(pr) = pr {\n                    pr.borrow_mut().parent = Some(y.clone());\n                }\n            }\n\n            // transplant(p, y)\n            self.transplant(p.clone(), Some(y.clone()));\n            // y.left = p.left; p.left.parent = y\n            let pl = p.borrow().left.clone();\n            y.borrow_mut().left = pl.clone();\n            if let Some(pl) = pl {\n                pl.borrow_mut().parent = Some(y.clone());\n            }\n            let p_color = p.borrow().color.clone();\n            y.borrow_mut().color = p_color;\n        }\n\n        // Detach p from the tree to break cycles and free its memory\n        {\n            let mut pb = p.borrow_mut();\n            pb.parent = None;\n            pb.left = None;\n            pb.right = None;\n        }\n\n        if y_original_color == Color::Black {\n            self.delete_fixup_internal(x, x_parent);\n        }\n    }\n\n    /// In-order traversal of `curr` into `arr` until `n` elements (`None` == NIL).\n    pub fn subtree_to_array(\n        &self,\n        curr: Option<NodeRef>,\n        arr: &mut Vec<Key>,\n        n: usize,\n        count: &mut usize,\n    ) {\n        if let Some(c) = curr {\n            let left = c.borrow().left.clone();\n            self.subtree_to_array(left, arr, n, count);\n            if *count < n {\n                arr.push(c.borrow().key);\n                *count += 1;\n            } else {\n                return;\n            }\n            let right = c.borrow().right.clone();\n            self.subtree_to_array(right, arr, n, count);\n        }\n    }\n\n    /// Returns up to `n` keys from the tree in-order.\n    pub fn to_array(&self, n: usize) -> Vec<Key> {\n        let mut arr: Vec<Key> = Vec::with_capacity(n);\n        if self.root.is_none() {\n            return arr;\n        }\n        let mut count: usize = 0;\n        self.subtree_to_array(self.root.clone(), &mut arr, n, &mut count);\n        arr\n    }\n}\n\nimpl Default for RBTree {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n\nimpl Drop for RBTree {\n    fn drop(&mut self) {\n        // Break parent cycles so nodes can be freed\n        Self::free_node(self.root.take());\n    }\n}\n","numLines":633,"startLine":1,"totalLines":633}}}
