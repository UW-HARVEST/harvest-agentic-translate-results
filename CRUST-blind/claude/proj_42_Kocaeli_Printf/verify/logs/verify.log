adbeef\");","-}","-","-// ---------------- format ----------------","-","-#[test]","-fn test_format_percent() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![];","-    let (rv, out) = capture_stdout(|| format(&args, '%', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 1);","-    assert_eq!(out, b\"%\");","-}","-","-#[test]","-fn test_format_char_with_char() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new('Q')];","-    let (rv, out) = capture_stdout(|| format(&args, 'c', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 1);","-    assert_eq!(out, b\"Q\");","-}","-","-#[test]","-fn test_format_char_with_i32() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(65i32)];","-    let (rv, out) = capture_stdout(|| format(&args, 'c', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 1);","-    assert_eq!(out, b\"A\");","-}","-","-#[test]","-fn test_format_string() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(\"Hello\")];","-    let (rv, out) = capture_stdout(|| format(&args, 's', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 5);","-    assert_eq!(out, b\"Hello\");","-}","-","-#[test]","-fn test_format_string_owned() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(String::from(\"Owned\"))];","-    let (rv, out) = capture_stdout(|| format(&args, 's', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 5);","-    assert_eq!(out, b\"Owned\");","-}","-","-#[test]","-fn test_format_d() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(-123i32)];","-    let (rv, out) = capture_stdout(|| format(&args, 'd', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 4);","-    assert_eq!(out, b\"-123\");","-}","-","-#[test]","-fn test_format_i() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(42i32)];","-    let (rv, out) = capture_stdout(|| format(&args, 'i', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 2);","-    assert_eq!(out, b\"42\");","-}","-","-#[test]","-fn test_format_u() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(42u32)];","-    let (rv, out) = capture_stdout(|| format(&args, 'u', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 2);","-    assert_eq!(out, b\"42\");","-}","-","-#[test]","-fn test_format_x_lower() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(255u32)];","-    let (rv, out) = capture_stdout(|| format(&args, 'x', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 2);","-    assert_eq!(out, b\"ff\");","-}","-","-#[test]","-fn test_format_x_upper() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(255u32)];","-    let (rv, out) = capture_stdout(|| format(&args, 'X', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 2);","-    assert_eq!(out, b\"FF\");","-}","-","-#[test]","-fn test_format_p_usize() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(0x1234usize)];","-    let (rv, out) = capture_stdout(|| format(&args, 'p', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 6);","-    assert_eq!(out, b\"0x1234\");","-}","-","-#[test]","-fn test_format_p_null_const_ptr() {","-    let mut len: i32 = 0;","-    let null_ptr: *const std::ffi::c_void = std::ptr::null();","-    let args: Vec<Box<dyn Any>> = vec![Box::new(null_ptr)];","-    let (rv, out) = capture_stdout(|| format(&args, 'p', &mut len));","-    assert_eq!(rv, 1);","-    assert_eq!(len, 5);","-    assert_eq!(out, b\"(nil)\");","-}","-","-#[test]","-fn test_format_unknown_specifier_returns_minus_one() {","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(42i32)];","-    // 'z' is not a recognized specifier; format should return -1.","-    let (rv, _out) = capture_stdout(|| format(&args, 'z', &mut len));","-    assert_eq!(rv, -1);","-}","-","-// ---------------- Combined / multi-call sequences ----------------","-","-#[test]","-fn test_writeint_then_writestring_accumulates_len() {","-    let mut len: i32 = 0;","-    let (_rv1, out1) = capture_stdout(|| writeint(42, &mut len));","-    assert_eq!(len, 2);","-    assert_eq!(out1, b\"42\");","-    let (_rv2, out2) = capture_stdout(|| writestring(\" + \", &mut len));","-    assert_eq!(len, 5);","-    assert_eq!(out2, b\" + \");","-    let (_rv3, out3) = capture_stdout(|| writeint(-1, &mut len));","-    assert_eq!(len, 7);","-    assert_eq!(out3, b\"-1\");","-}","-","-#[test]","-fn test_format_consumes_args_in_order() {","-    // Each call to format() consumes the next argument from the slice","-    // (when the specifier is not '%').","-    let mut len: i32 = 0;","-    let args: Vec<Box<dyn Any>> = vec![Box::new(\"World\"), Box::new(42i32)];","-    let (rv1, out1) = capture_stdout(|| format(&args, 's', &mut len));","-    assert_eq!(rv1, 1);","-    assert_eq!(len, 5);","-    assert_eq!(out1, b\"World\");","-    let (rv2, out2) = capture_stdout(|| format(&args, 'd', &mut len));","-    assert_eq!(rv2, 1);","-    assert_eq!(len, 7);","-    assert_eq!(out2, b\"42\");","-}","-"," fn main() {}"]}],"originalFile":"use proj_42_Kocaeli_Printf::ft_printf::{\n    format, writechar, writehex, writeint, writepoint, writestring, writeuint, DECIMAL, HEXALOW,\n    HEXAUP, LOCATION,\n};\nuse std::any::Any;\nuse std::fs::{File, OpenOptions};\nuse std::io::{Read, Write};\nuse std::os::unix::io::AsRawFd;\nuse std::sync::Mutex;\n\nextern \"C\" {\n    fn dup(oldfd: i32) -> i32;\n    fn dup2(oldfd: i32, newfd: i32) -> i32;\n    fn close(fd: i32) -> i32;\n}\n\n// Serialize stdout-capturing tests across threads since cargo test runs\n// tests in parallel by default and we are mutating fd 1 globally.\nstatic STDOUT_LOCK: Mutex<()> = Mutex::new(());\n\nfn capture_stdout<F: FnOnce() -> R, R>(f: F) -> (R, Vec<u8>) {\n    let guard = STDOUT_LOCK.lock().unwrap_or_else(|e| e.into_inner());\n    // Make sure any pending Rust stdout buffering is flushed before redirect.\n    let _ = std::io::stdout().flush();\n\n    // Use a unique temp file name so concurrent tests can't collide.\n    let pid = std::process::id();\n    let nanos = std::time::SystemTime::now()\n        .duration_since(std::time::UNIX_EPOCH)\n        .map(|d| d.as_nanos())\n        .unwrap_or(0);\n    let counter: usize = COUNTER.fetch_add(1, std::sync::atomic::Ordering::SeqCst);\n    let path = format!(\"/tmp/ftprintf_capture_{}_{}_{}.tmp\", pid, nanos, counter);\n\n    let file = OpenOptions::new()\n        .read(true)\n        .write(true)\n        .create(true)\n        .truncate(true)\n        .open(&path)\n        .expect(\"create temp file\");\n    let file_fd = file.as_raw_fd();\n\n    let saved = unsafe { dup(1) };\n    assert!(saved >= 0, \"dup failed\");\n    unsafe {\n        let r = dup2(file_fd, 1);\n        assert!(r >= 0, \"dup2 failed\");\n    }\n\n    let result = f();\n\n    // Flush any buffered Rust output to the redirected fd before restore.\n    let _ = std::io::stdout().flush();\n    unsafe {\n        let r = dup2(saved, 1);\n        assert!(r >= 0, \"restore dup2 failed\");\n        close(saved);\n    }\n    drop(file);\n\n    // Read the captured bytes.\n    let mut buf = Vec::new();\n    File::open(&path)\n        .and_then(|mut f| f.read_to_end(&mut buf))\n        .expect(\"read captured file\");\n    let _ = std::fs::remove_file(&path);\n\n    drop(guard);\n    (result, buf)\n}\n\nstatic COUNTER: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);\n\n// ---------------- Constants tests ----------------\n\n#[test]\nfn test_constants() {\n    assert_eq!(DECIMAL, \"0123456789\");\n    assert_eq!(HEXALOW, \"0123456789abcdef\");\n    assert_eq!(HEXAUP, \"0123456789ABCDEF\");\n    assert_eq!(LOCATION, 2);\n}\n\n// ---------------- writechar ----------------\n\n#[test]\nfn test_writechar_basic_a() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writechar('A', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"A\");\n}\n\n#[test]\nfn test_writechar_basic_b() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writechar('B', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"B\");\n}\n\n#[test]\nfn test_writechar_lowercase_z() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writechar('z', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"z\");\n}\n\n#[test]\nfn test_writechar_increments_existing_len() {\n    let mut len: i32 = 5;\n    let (rv, out) = capture_stdout(|| writechar('B', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 6);\n    assert_eq!(out, b\"B\");\n}\n\n#[test]\nfn test_writechar_newline() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writechar('\\n', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"\\n\");\n}\n\n#[test]\nfn test_writechar_null_byte() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writechar('\\0', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, &[0u8]);\n}\n\n// ---------------- writestring ----------------\n\n#[test]\nfn test_writestring_hello() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writestring(\"Hello\", &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 5);\n    assert_eq!(out, b\"Hello\");\n}\n\n#[test]\nfn test_writestring_world_bang() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writestring(\"World!\", &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 6);\n    assert_eq!(out, b\"World!\");\n}\n\n#[test]\nfn test_writestring_empty() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writestring(\"\", &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 0);\n    assert_eq!(out, b\"\");\n}\n\n#[test]\nfn test_writestring_long_digits() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writestring(\"1234567890\", &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 10);\n    assert_eq!(out, b\"1234567890\");\n}\n\n#[test]\nfn test_writestring_increments_existing_len() {\n    let mut len: i32 = 10;\n    let (rv, out) = capture_stdout(|| writestring(\"World!\", &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 16);\n    assert_eq!(out, b\"World!\");\n}\n\n// ---------------- writeint ----------------\n\n#[test]\nfn test_writeint_zero() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(0, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"0\");\n}\n\n#[test]\nfn test_writeint_positive_small() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(42, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"42\");\n}\n\n#[test]\nfn test_writeint_negative_small() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(-42, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 3);\n    assert_eq!(out, b\"-42\");\n}\n\n#[test]\nfn test_writeint_one() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(1, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"1\");\n}\n\n#[test]\nfn test_writeint_neg_one() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(-1, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"-1\");\n}\n\n#[test]\nfn test_writeint_large_positive() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(123456, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 6);\n    assert_eq!(out, b\"123456\");\n}\n\n#[test]\nfn test_writeint_max_i32() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(2147483647, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 10);\n    assert_eq!(out, b\"2147483647\");\n}\n\n#[test]\nfn test_writeint_min_i32() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeint(i32::MIN, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 11);\n    assert_eq!(out, b\"-2147483648\");\n}\n\n// ---------------- writeuint ----------------\n\n#[test]\nfn test_writeuint_zero() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeuint(0, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"0\");\n}\n\n#[test]\nfn test_writeuint_42() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeuint(42, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"42\");\n}\n\n#[test]\nfn test_writeuint_uint_max() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeuint(4294967295, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 10);\n    assert_eq!(out, b\"4294967295\");\n}\n\n#[test]\nfn test_writeuint_123456789() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writeuint(123456789, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 9);\n    assert_eq!(out, b\"123456789\");\n}\n\n// ---------------- writehex ----------------\n\n#[test]\nfn test_writehex_zero_lower() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(0, 'x', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"0\");\n}\n\n#[test]\nfn test_writehex_zero_upper() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(0, 'X', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"0\");\n}\n\n#[test]\nfn test_writehex_42_lower() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(42, 'x', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"2a\");\n}\n\n#[test]\nfn test_writehex_42_upper() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(42, 'X', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"2A\");\n}\n\n#[test]\nfn test_writehex_255_lower() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(255, 'x', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"ff\");\n}\n\n#[test]\nfn test_writehex_255_upper() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(255, 'X', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"FF\");\n}\n\n#[test]\nfn test_writehex_15_lower() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(15, 'x', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"f\");\n}\n\n#[test]\nfn test_writehex_large_lower() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(0x1234abcd, 'x', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 8);\n    assert_eq!(out, b\"1234abcd\");\n}\n\n#[test]\nfn test_writehex_large_upper() {\n    let mut len: i32 = 0;\n    let (rv, out) = capture_stdout(|| writehex(0x1234ABCD, 'X', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 8);\n    assert_eq!(out, b\"1234ABCD\");\n}\n\n// ---------------- writepoint ----------------\n\n#[test]\nfn test_writepoint_basic() {\n    let mut len: i32 = 0;\n    let ptr = 0x1234usize as *const std::ffi::c_void;\n    let (rv, out) = capture_stdout(|| writepoint(ptr, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 6);\n    assert_eq!(out, b\"0x1234\");\n}\n\n#[test]\nfn test_writepoint_null() {\n    let mut len: i32 = 0;\n    let ptr: *const std::ffi::c_void = std::ptr::null();\n    let (rv, out) = capture_stdout(|| writepoint(ptr, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 5);\n    assert_eq!(out, b\"(nil)\");\n}\n\n#[test]\nfn test_writepoint_one() {\n    let mut len: i32 = 0;\n    let ptr = 0x1usize as *const std::ffi::c_void;\n    let (rv, out) = capture_stdout(|| writepoint(ptr, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 3);\n    assert_eq!(out, b\"0x1\");\n}\n\n#[test]\nfn test_writepoint_deadbeef() {\n    let mut len: i32 = 0;\n    let ptr = 0xDEADBEEFusize as *const std::ffi::c_void;\n    let (rv, out) = capture_stdout(|| writepoint(ptr, &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 10);\n    assert_eq!(out, b\"0xdeadbeef\");\n}\n\n// ---------------- format ----------------\n\n#[test]\nfn test_format_percent() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![];\n    let (rv, out) = capture_stdout(|| format(&args, '%', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"%\");\n}\n\n#[test]\nfn test_format_char_with_char() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new('Q')];\n    let (rv, out) = capture_stdout(|| format(&args, 'c', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"Q\");\n}\n\n#[test]\nfn test_format_char_with_i32() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(65i32)];\n    let (rv, out) = capture_stdout(|| format(&args, 'c', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 1);\n    assert_eq!(out, b\"A\");\n}\n\n#[test]\nfn test_format_string() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(\"Hello\")];\n    let (rv, out) = capture_stdout(|| format(&args, 's', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 5);\n    assert_eq!(out, b\"Hello\");\n}\n\n#[test]\nfn test_format_string_owned() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(String::from(\"Owned\"))];\n    let (rv, out) = capture_stdout(|| format(&args, 's', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 5);\n    assert_eq!(out, b\"Owned\");\n}\n\n#[test]\nfn test_format_d() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(-123i32)];\n    let (rv, out) = capture_stdout(|| format(&args, 'd', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 4);\n    assert_eq!(out, b\"-123\");\n}\n\n#[test]\nfn test_format_i() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(42i32)];\n    let (rv, out) = capture_stdout(|| format(&args, 'i', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"42\");\n}\n\n#[test]\nfn test_format_u() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(42u32)];\n    let (rv, out) = capture_stdout(|| format(&args, 'u', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"42\");\n}\n\n#[test]\nfn test_format_x_lower() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(255u32)];\n    let (rv, out) = capture_stdout(|| format(&args, 'x', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"ff\");\n}\n\n#[test]\nfn test_format_x_upper() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(255u32)];\n    let (rv, out) = capture_stdout(|| format(&args, 'X', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 2);\n    assert_eq!(out, b\"FF\");\n}\n\n#[test]\nfn test_format_p_usize() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(0x1234usize)];\n    let (rv, out) = capture_stdout(|| format(&args, 'p', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 6);\n    assert_eq!(out, b\"0x1234\");\n}\n\n#[test]\nfn test_format_p_null_const_ptr() {\n    let mut len: i32 = 0;\n    let null_ptr: *const std::ffi::c_void = std::ptr::null();\n    let args: Vec<Box<dyn Any>> = vec![Box::new(null_ptr)];\n    let (rv, out) = capture_stdout(|| format(&args, 'p', &mut len));\n    assert_eq!(rv, 1);\n    assert_eq!(len, 5);\n    assert_eq!(out, b\"(nil)\");\n}\n\n#[test]\nfn test_format_unknown_specifier_returns_minus_one() {\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(42i32)];\n    // 'z' is not a recognized specifier; format should return -1.\n    let (rv, _out) = capture_stdout(|| format(&args, 'z', &mut len));\n    assert_eq!(rv, -1);\n}\n\n// ---------------- Combined / multi-call sequences ----------------\n\n#[test]\nfn test_writeint_then_writestring_accumulates_len() {\n    let mut len: i32 = 0;\n    let (_rv1, out1) = capture_stdout(|| writeint(42, &mut len));\n    assert_eq!(len, 2);\n    assert_eq!(out1, b\"42\");\n    let (_rv2, out2) = capture_stdout(|| writestring(\" + \", &mut len));\n    assert_eq!(len, 5);\n    assert_eq!(out2, b\" + \");\n    let (_rv3, out3) = capture_stdout(|| writeint(-1, &mut len));\n    assert_eq!(len, 7);\n    assert_eq!(out3, b\"-1\");\n}\n\n#[test]\nfn test_format_consumes_args_in_order() {\n    // Each call to format() consumes the next argument from the slice\n    // (when the specifier is not '%').\n    let mut len: i32 = 0;\n    let args: Vec<Box<dyn Any>> = vec![Box::new(\"World\"), Box::new(42i32)];\n    let (rv1, out1) = capture_stdout(|| format(&args, 's', &mut len));\n    assert_eq!(rv1, 1);\n    assert_eq!(len, 5);\n    assert_eq!(out1, b\"World\");\n    let (rv2, out2) = capture_stdout(|| format(&args, 'd', &mut len));\n    assert_eq!(rv2, 1);\n    assert_eq!(len, 7);\n    assert_eq!(out2, b\"42\");\n}\n\nfn main() {}\n","userModified":false}}
