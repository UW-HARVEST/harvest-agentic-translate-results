{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019rMgnqwSyL1viVMFqgvzXz","type":"tool_result","content":"1\tuse std::any::Any;\n2\tuse std::cell::RefCell;\n3\tuse std::io::{self, Write};\n4\t// Constants\n5\tpub const HEXALOW: &str = \"0123456789abcdef\";\n6\tpub const DECIMAL: &str = \"0123456789\";\n7\tpub const HEXAUP: &str = \"0123456789ABCDEF\";\n8\tpub const LOCATION: i32 = 2;\n9\t\n10\t// Thread-local state used by the `format` function to track which argument\n11\t// from the slice supplied by the `ft_printf!` macro is currently being\n12\t// consumed. Because the macro hands the entire `&[Box<dyn Any>]` slice to\n13\t// `format` on every call, we need an external counter to walk through the\n14\t// arguments in order. The state stores `(slice_pointer, index)` so that we\n15\t// can detect when a new `ft_printf!` invocation begins (different slice\n16\t// pointer) and reset the index.\n17\tthread_local! {\n18\t    static ARG_STATE: RefCell<(usize, usize)> = RefCell::new((0, 0));\n19\t}\n20\t\n21\tfn next_arg_index(args: &[Box<dyn Any>]) -> usize {\n22\t    ARG_STATE.with(|s| {\n23\t        let mut state = s.borrow_mut();\n24\t        let ptr = args.as_ptr() as usize;\n25\t        // Reset the counter if we appear to be in a fresh invocation, or if\n26\t        // we have already consumed every argument.\n27\t        if state.0 != ptr || state.1 >= args.len() {\n28\t            state.0 = ptr;\n29\t            state.1 = 0;\n30\t        }\n31\t        let idx = state.1;\n32\t        state.1 += 1;\n33\t        idx\n34\t    })\n35\t}\n36\t\n37\t// Function Declarations\n38\tpub fn writeuint(n: u64, len: &mut i32) -> i32 {\n39\t    if n == 0 {\n40\t        return writechar('0', len);\n41\t    }\n42\t    let dec = DECIMAL.as_bytes();\n43\t    let mut arr = [0u8; 32];\n44\t    let mut i: usize = 0;\n45\t    let mut n = n;\n46\t    while n != 0 {\n47\t        arr[i] = dec[(n % 10) as usize];\n48\t        i += 1;\n49\t        n /= 10;\n50\t    }\n51\t    while i > 0 {\n52\t        i -= 1;\n53\t        if writechar(arr[i] as char, len) == -1 {\n54\t            return -1;\n55\t        }\n56\t    }\n57\t    1\n58\t}\n59\t\n60\tpub fn format(args: &[Box<dyn Any>], c: char, len: &mut i32) -> i32 {\n61\t    // '%' does not consume an argument.\n62\t    if c == '%' {\n63\t        return writechar('%', len);\n64\t    }\n65\t\n66\t    let idx = next_arg_index(args);\n67\t    if idx >= args.len() {\n68\t        return -1;\n69\t    }\n70\t    let arg: &dyn Any = args[idx].as_ref();\n71\t\n72\t    if c == 'c' {\n73\t        if let Some(ch) = arg.downcast_ref::<char>() {\n74\t            return writechar(*ch, len);\n75\t        }\n76\t        if let Some(b) = arg.downcast_ref::<u8>() {\n77\t            return writechar(*b as char, len);\n78\t        }\n79\t        if let Some(i) = arg.downcast_ref::<i32>() {\n80\t            return writechar((*i as u8) as char, len);\n81\t        }\n82\t        if let Some(u) = arg.downcast_ref::<u32>() {\n83\t            return writechar((*u as u8) as char, len);\n84\t        }\n85\t        return -1;\n86\t    }\n87\t    if c == 's' {\n88\t        if let Some(s) = arg.downcast_ref::<&str>() {\n89\t            return writestring(s, len);\n90\t        }\n91\t        if let Some(s) = arg.downcast_ref::<String>() {\n92\t            return writestring(s.as_str(), len);\n93\t        }\n94\t        return -1;\n95\t    }\n96\t    if c == 'd' || c == 'i' {\n97\t        if let Some(n) = arg.downcast_ref::<i32>() {\n98\t            return writeint(*n, len);\n99\t        }\n100\t        if let Some(n) = arg.downcast_ref::<i64>() {\n101\t            return writeint(*n as i32, len);\n102\t        }\n103\t        if let Some(n) = arg.downcast_ref::<isize>() {\n104\t            return writeint(*n as i32, len);\n105\t        }\n106\t        return -1;\n107\t    }\n108\t    if c == 'u' {\n109\t        if let Some(n) = arg.downcast_ref::<u32>() {\n110\t            return writeuint(*n as u64, len