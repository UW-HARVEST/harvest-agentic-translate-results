{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CSEt3KkrAfTaLF7qimkpHG","type":"tool_result","content":"1\t#ifndef AVALANCHE_H\n2\t#define AVALANCHE_H\n3\t#include <stdio.h>\n4\t#include <stdint.h>\n5\t#include <stddef.h>\n6\t\n7\t/** Protypical hash function: converts a `key` of bytes to a hash value,\n8\t represented as an array of 32-bit blocks.\n9\t */\n10\ttypedef void (* hash_f)(char* key, size_t key_len, uint32_t* hash_value);\n11\t\n12\t/** Simple matrix structure.\n13\t */\n14\ttypedef struct {\n15\t    size_t n_rows, n_cols;\n16\t    double* vals;\n17\t} matrix_t;\n18\t\n19\t// macros for enforcing row-major layout of matrix\n20\t#define MATRIX_GET(M, ROW, COL) ((M)->vals[(ROW) * (M)->n_cols + (COL)])\n21\t#define MATRIX_SET(M, ROW, COL, VAL) ((M)->vals[(ROW) * (M)->n_cols + (COL)] = (VAL))\n22\t\n23\t/** Avalanche test for hash function.\n24\t\n25\t All test keys are read successively from the stream `ins`, and the probability\n26\t that flipping i-th input bit affects the j-th output bit is recorded as the\n27\t ij-th entry of the matrix.\n28\t\n29\t All keys read have the same length, so that the key length and size of the\n30\t hash value (in words) are parameterized by the row and columns of the mattrix.\n31\t */\n32\tvoid avalanche(hash_f hash, FILE* ins, uint64_t max_iter, matrix_t* results);\n33\t\n34\tmatrix_t* matrix_alloc(size_t n_rows, size_t n_cols);\n35\tvoid matrix_free(matrix_t*);\n36\tvoid matrix_fprintf(FILE* fout, const char* format, const matrix_t*);\n37\t\n38\t#endif // AVALANCHE_H\n39\t"}]},"parent_tool_use_id":null,"session_id":"35f3bdfe-463b-4c46-9e7c-3c36e6b976ed","uuid":"293e49c0-b451-4af7-a1a8-08b063f9ae1f","timestamp":"2026-05-29T14:05:49.045Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-JYOzVc/project/c_src/src/avalanche.h","content":"#ifndef AVALANCHE_H\n#define AVALANCHE_H\n#include <stdio.h>\n#include <stdint.h>\n#include <stddef.h>\n\n/** Protypical hash function: converts a `key` of bytes to a hash value,\n represented as an array of 32-bit blocks.\n */\ntypedef void (* hash_f)(char* key, size_t key_len, uint32_t* hash_value);\n\n/** Simple matrix structure.\n */\ntypedef struct {\n    size_t n_rows, n_cols;\n    double* vals;\n} matrix_t;\n\n// macros for enforcing row-major layout of matrix\n#define MATRIX_GET(M, ROW, COL) ((M)->vals[(ROW) * (M)->n_cols + (COL)])\n#define MATRIX_SET(M, ROW, COL, VAL) ((M)->vals[(ROW) * (M)->n_cols + (COL)] = (VAL))\n\n/** Avalanche test for hash function.\n\n All test keys are read successively from the stream `ins`, and the probability\n that flipping i-th input bit affects the j-th output bit is recorded as the\n ij-th entry of the matrix.\n\n All keys read have the same length, so that the key length and size of the\n hash value (in words) are parameterized by the row and columns of the mattrix.\n */\nvoid avalanche(hash_f hash, FILE* ins, uint64_t max_iter, matrix_t* results);\n\nmatrix_t* matrix_alloc(size_t n_rows, size_t n_cols);\nvoid matrix_free(matrix_t*);\nvoid matrix_fprintf(FILE* fout, const char* format, const matrix_t*);\n\n#endif // AVALANCHE_H\n","numLines":39,"startLine":1,"totalLines":39}}}
