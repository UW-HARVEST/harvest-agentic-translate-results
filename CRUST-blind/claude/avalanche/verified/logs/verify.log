{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Xpf7rV17yrp9mUPWWHBJEQ","type":"tool_result","content":"1\tuse std::io::{Read, Write};\n2\t/// Prototypical hash function: converts a key of bytes to a hash value,\n3\t/// represented as an array of 32-bit blocks.\n4\tpub type HashFn = fn(key: &[u8], hash_value: &mut [u32]);\n5\t/// Simple matrix structure.\n6\tpub struct Matrix {\n7\t    pub n_rows: usize,\n8\t    pub n_cols: usize,\n9\t    pub vals: Vec<f64>,\n10\t}\n11\t/// Avalanche test for hash function.\n12\t///\n13\t/// All test keys are read successively from the stream `ins`, and the probability\n14\t/// that flipping i-th input bit affects the j-th output bit is recorded as the\n15\t/// ij-th entry of the matrix.\n16\t///\n17\t/// All keys read have the same length, so that the key length and size of the\n18\t/// hash value (in words) are parameterized by the row and columns of the matrix.\n19\tpub fn avalanche(hash: HashFn, ins: &mut dyn Read, max_iter: u64, results: &mut Matrix) {\n20\t    let key_size = results.n_rows / 8;\n21\t    let hash_words = results.n_cols / 32;\n22\t\n23\t    let mut key: Vec<u8> = vec![0u8; key_size];\n24\t    let mut hvalue: Vec<u32> = vec![0u32; hash_words];\n25\t    let mut htemp: Vec<u32> = vec![0u32; hash_words];\n26\t\n27\t    let mut key_count: u64 = 0;\n28\t    while key_count < max_iter {\n29\t        // Read exactly key_size bytes; if fewer are available, break (matches fread behavior).\n30\t        let mut total_read = 0usize;\n31\t        let mut read_failed = false;\n32\t        while total_read < key_size {\n33\t            match ins.read(&mut key[total_read..]) {\n34\t                Ok(0) => {\n35\t                    read_failed = true;\n36\t                    break;\n37\t                }\n38\t                Ok(n) => total_read += n,\n39\t                Err(_) => {\n40\t                    read_failed = true;\n41\t                    break;\n42\t                }\n43\t            }\n44\t        }\n45\t        if read_failed || total_read < key_size {\n46\t            break;\n47\t        }\n48\t\n49\t        hash(&key, &mut hvalue);\n50\t        key_count += 1;\n51\t\n52\t        for i_byte in 0..key_size {\n53\t            for i_bit in 0..8usize {\n54\t                let row = i_byte * 8 + i_bit;\n55\t\n56\t                // flip the i-th bit of this byte and re-hash\n57\t                let i_mask: u8 = 0x80u8 >> i_bit;\n58\t                key[i_byte] ^= i_mask;\n59\t                hash(&key, &mut htemp);\n60\t                key[i_byte] ^= i_mask;\n61\t\n62\t                for j_word in 0..hash_words {\n63\t                    for j_bit in 0..32usize {\n64\t                        let col = j_word * 32 + j_bit;\n65\t\n66\t                        // test whether hvalue & htemp differ at j-th bit.\n67\t                        let j_mask: u32 = 0x80000000u32 >> j_bit;\n68\t                        if (hvalue[j_word] ^ htemp[j_word]) & j_mask != 0 {\n69\t                            let curr = results.matrix_get(row, col);\n70\t                            results.matrix_set(row, col, curr + 1.0);\n71\t                        }\n72\t                    }\n73\t                }\n74\t            }\n75\t        }\n76\t    }\n77\t\n78\t    if key_count > 0 {\n79\t        let n_vals = results.n_cols * results.n_rows;\n80\t        let kc = key_count as f64;\n81\t        for k in 0..n_vals {\n82\t            results.vals[k] /= kc;\n83\t        }\n84\t    }\n85\t}\n86\timpl Matrix {\n87\t    /// Allocate a matrix with the given number of rows and columns.\n88\t    pub fn matrix_alloc(n_rows: usize, n_cols: usize) -> Self {\n89\t        Matrix {\n90\t            n_rows,\n91\t            n_cols,\n92\t            vals: vec![0.0f64; n_rows * n_cols],\n93\t        }\n94\t    }\n95\t    /// Print the matrix to the given writer using the specified format.\n96\t    pub fn matrix_fprintf(&self, fout: &mut dyn Write, format: &str) {\n97\t        for r in 0..self.n_rows {\n98\t            for c in 0..self.n_cols {\n99\t                let v = self.matrix_get(r, c);\n100\t                let s = format_f64_printf(format, v);\n101\t                let _ = fout.write_all(s.as_bytes());\n102\t            }\n103\t            let _ = fout.write_all(b\"\\n\");\n104\t        }\n105\t    }\n106\t    /// Get value from the matrix at (row, col).\n107\t    pub fn matrix_get(&self, row: usize, col: usize) -> f64 {\n108\t        self.vals[row * self.n_cols + col]\n109\t    }\n110\t    /// Set value in the matrix at (row, col).\n111\t    pub fn matrix_set(&mut self, row: usize, col: usize, val: f64) {\n112\t        self.vals[row * self.n_cols + col] = val;\n113\t    }\n114\t}\n115\t\n116\t/// A minimal printf-style formatter for `f64` values. Supports the format\n117\t/// specifiers used by this project: `%[flags][width][.precision]<conv>` where\n118\t/// `conv` is one of `f`, `e`, `E`, `g`, `G`. Flags handled: `-`, `+`, ` `, `0`, `#`.\n119\tfn format_f64_printf(format: &str, value: f64) -> String {\n120\t    let bytes = format.as_bytes();\n121\t    let mut out = String::new();\n122\t    let mut i = 0;\n123\t    while i < bytes.len() {\n124\t        let b = bytes[i];\n125\t        if b != b'%' {\n126\t            out.push(b as char);\n127\t            i += 1;\n128\t            continue;\n129\t        }\n130\t        // we have a '%'\n131\t        i += 1;\n132\t        if i < bytes.len() && bytes[i] == b'%' {\n133\t            out.push('%');\n134\t            i += 1;\n135\t            continue;\n136\t        }\n137\t        // parse flags\n138\t        let mut flag_minus = false;\n139\t        let mut flag_plus = false;\n140\t        let mut flag_space = false;\n141\t        let mut flag_zero = false;\n142\t        let mut flag_hash = false;\n143\t        while i < bytes.len() {\n144\t            match bytes[i] {\n145\t                b'-' => {\n146\t                    flag_minus = true;\n147\t                    i += 1;\n148\t                }\n149\t                b'+' => {\n150\t                    flag_plus = true;\n151\t                    i += 1;\n152\t                }\n153\t                b' ' => {\n154\t                    flag_space = true;\n155\t                    i += 1;\n156\t                }\n157\t                b'0' => {\n158\t                    flag_zero = true;\n159\t                    i += 1;\n160\t                }\n161\t                b'#' => {\n162\t                    flag_hash = true;\n163\t                    i += 1;\n164\t                }\n165\t                _ => break,\n166\t            }\n167\t        }\n168\t        // parse width\n169\t        let mut width: Option<usize> = None;\n170\t        while i < bytes.len() && bytes[i].is_ascii_digit() {\n171\t            let d = (bytes[i] - b'0') as usize;\n172\t            width = Some(width.unwrap_or(0) * 10 + d);\n173\t            i += 1;\n174\t        }\n175\t        // parse precision\n176\t        let mut precision: Option<usize> = None;\n177\t        if i < bytes.len() && bytes[i] == b'.' {\n178\t            i += 1;\n179\t            let mut p: usize = 0;\n180\t            let mut has_digits = false;\n181\t            while i < bytes.len() && bytes[i].is_ascii_digit() {\n182\t                p = p * 10 + (bytes[i] - b'0') as usize;\n183\t                has_digits = true;\n184\t                i += 1;\n185\t            }\n186\t            precision = Some(if has_digits { p } else { 0 });\n187\t        }\n188\t        // skip length modifiers (l, h, L, etc.) — not relevant for f64\n189\t        while i < bytes.len()\n190\t            && (bytes[i] == b'l' || bytes[i] == b'h' || bytes[i] == b'L')\n191\t        {\n192\t            i += 1;\n193\t        }\n194\t        if i >= bytes.len() {\n195\t            break;\n196\t        }\n197\t        let conv = bytes[i];\n198\t        i += 1;\n199\t        let body = match conv {\n200\t            b'f' | b'F' => format_fixed(value, precision.unwrap_or(6), flag_plus, flag_space, flag_hash),\n201\t            b'e' => format_exp(value, precision.unwrap_or(6), flag_plus, flag_space, flag_hash, false),\n202\t            b'E' => format_exp(value, precision.unwrap_or(6), flag_plus, flag_space, flag_hash, true),\n203\t            b'g' => format_general(value, precision.unwrap_or(6), flag_plus, flag_space, flag_hash, false),\n204\t            b'G' => format_general(value, precision.unwrap_or(6), flag_plus, flag_space, flag_hash, true),\n205\t            b'd' | b'i' => {\n206\t                let v = value as i64;\n207\t                let mut s = if v < 0 {\n208\t                    format!(\"-{}\", -v)\n209\t                } else if flag_plus {\n210\t                    format!(\"+{}\", v)\n211\t                } else if flag_space {\n212\t                    format!(\" {}\", v)\n213\t                } else {\n214\t                    format!(\"{}\", v)\n215\t                };\n216\t                if let Some(p) = precision {\n217\t                    let digits_only: String = s.trim_start_matches(|c: char| c == '+' || c == '-' || c == ' ').to_string();\n218\t                    let sign: String = s[..s.len() - digits_only.len()].to_string();\n219\t                    if digits_only.len() < p {\n220\t                        let pad = \"0\".repeat(p - digits_only.len());\n221\t                        s = format!(\"{}{}{}\", sign, pad, digits_only);\n222\t                    }\n223\t                }\n224\t                s\n225\t            }\n226\t            _ => {\n227\t                // Unsupported conversion — emit raw.\n228\t                let mut s = String::from(\"%\");\n229\t                s.push(conv as char);\n230\t                s\n231\t            }\n232\t        };\n233\t        // apply width\n234\t        let result = apply_width(&body, width, flag_minus, flag_zero, conv);\n235\t        out.push_str(&result);\n236\t    }\n237\t    out\n238\t}\n239\t\n240\tfn apply_width(body: &str, width: Option<usize>, left: bool, zero: bool, conv: u8) -> String {\n241\t    let w = match width {\n242\t        Some(w) => w,\n243\t        None => return body.to_string(),\n244\t    };\n245\t    if body.len() >= w {\n246\t        return body.to_string();\n247\t    }\n248\t    let pad = w - body.len();\n249\t    if left {\n250\t        let mut s = String::with_capacity(w);\n251\t        s.push_str(body);\n252\t        s.push_str(&\" \".repeat(pad));\n253\t        s\n254\t    } else if zero\n255\t        && (conv == b'f'\n256\t            || conv == b'F'\n257\t            || conv == b'e'\n258\t            || conv == b'E'\n259\t            || conv == b'g'\n260\t            || conv == b'G'\n261\t            || conv == b'd'\n262\t            || conv == b'i')\n263\t    {\n264\t        // zero-pad after the sign character if there is one\n265\t        let bytes = body.as_bytes();\n266\t        if !bytes.is_empty() && (bytes[0] == b'+' || bytes[0] == b'-' || bytes[0] == b' ') {\n267\t            let mut s = String::with_capacity(w);\n268\t            s.push(bytes[0] as char);\n269\t            s.push_str(&\"0\".repeat(pad));\n270\t            s.push_str(&body[1..]);\n271\t            s\n272\t        } else {\n273\t            let mut s = String::with_capacity(w);\n274\t            s.push_str(&\"0\".repeat(pad));\n275\t            s.push_str(body);\n276\t            s\n277\t        }\n278\t    } else {\n279\t        let mut s = String::with_capacity(w);\n280\t        s.push_str(&\" \".repeat(pad));\n281\t        s.push_str(body);\n282\t        s\n283\t    }\n284\t}\n285\t\n286\tfn sign_prefix(value: f64, flag_plus: bool, flag_space: bool) -> &'static str {\n287\t    if value.is_sign_negative() && !value.is_nan() {\n288\t        \"-\"\n289\t    } else if flag_plus {\n290\t        \"+\"\n291\t    } else if flag_space {\n292\t        \" \"\n293\t    } else {\n294\t        \"\"\n295\t    }\n296\t}\n297\t\n298\tfn format_fixed(\n299\t    value: f64,\n300\t    precision: usize,\n301\t    flag_plus: bool,\n302\t    flag_space: bool,\n303\t    flag_hash: bool,\n304\t) -> String {\n305\t    if value.is_nan() {\n306\t        return \"nan\".to_string();\n307\t    }\n308\t    if value.is_infinite() {\n309\t        let mut s = String::new();\n310\t        s.push_str(sign_prefix(value, flag_plus, flag_space));\n311\t        s.push_str(\"inf\");\n312\t        return s;\n313\t    }\n314\t    let absv = value.abs();\n315\t    let body = format!(\"{:.*}\", precision, absv);\n316\t    let body = if flag_hash && precision == 0 && !body.contains('.') {\n317\t        format!(\"{}.\", body)\n318\t    } else {\n319\t        body\n320\t    };\n321\t    let mut s = String::new();\n322\t    s.push_str(sign_prefix(value, flag_plus, flag_space));\n323\t    s.push_str(&body);\n324\t    s\n325\t}\n326\t\n327\tfn format_exp(\n328\t    value: f64,\n329\t    precision: usize,\n330\t    flag_plus: bool,\n331\t    flag_space: bool,\n332\t    flag_hash: bool,\n333\t    upper: bool,\n334\t) -> String {\n335\t    if value.is_nan() {\n336\t        return if upper { \"NAN\".into() } else { \"nan\".into() };\n337\t    }\n338\t    if value.is_infinite() {\n339\t        let mut s = String::new();\n340\t        s.push_str(sign_prefix(value, flag_plus, flag_space));\n341\t        s.push_str(if upper { \"INF\" } else { \"inf\" });\n342\t        return s;\n343\t    }\n344\t    let absv = value.abs();\n345\t    // Determine mantissa and exponent in base 10.\n346\t    let (mantissa, exp) = if absv == 0.0 {\n347\t        (0.0_f64, 0_i32)\n348\t    } else {\n349\t        let exp = absv.log10().floor() as i32;\n350\t        let mant = absv / 10f64.powi(exp);\n351\t        // round mantissa to required precision\n352\t        let factor = 10f64.powi(precision as i32);\n353\t        let rounded = (mant * factor).round() / factor;\n354\t        // adjust if rounding pushed mantissa to 10\n355\t        if rounded >= 10.0 {\n356\t            (rounded / 10.0, exp + 1)\n357\t        } else if rounded < 1.0 && rounded > 0.0