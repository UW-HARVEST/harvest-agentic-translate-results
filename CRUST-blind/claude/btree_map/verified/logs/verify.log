rl\", sizeof(\"charl\"), \"CCC\", sizeof(\"CCC\"));\n    printf(\"count=%zu\\n\", get_entry_count(btree));\n\n    // Update existing key\n    add_entry(btree, \"alpha\", sizeof(\"alpha\"), \"AAX\", sizeof(\"AAX\"));\n    value_t* v = find_entry(btree, \"alpha\", sizeof(\"alpha\"));\n    printf(\"alpha after update: len=%zu str='%.*s'\\n\", v->len, (int)v->len, v->value);\n\n    // Remove\n    remove_entry(btree, \"bravo\", sizeof(\"bravo\"));\n    printf(\"count after remove bravo=%zu\\n\", get_entry_count(btree));\n\n    // Remove non-existent\n    remove_entry(btree, \"zzz\", sizeof(\"zzz\"));\n    printf(\"count after remove zzz=%zu\\n\", get_entry_count(btree));\n\n    // List\n    entry_list_t* list = list_entries(btree);\n    for (size_t i=0; i<list->len; i++) {\n        printf(\"idx=%zu key_len=%zu key='%.*s' val_len=%zu val='%.*s'\\n\",\n               i,\n               list->entries[i].key.len,\n               (int)list->entries[i].key.len, list->entries[i].key.key,\n               list->entries[i].value.len,\n               (int)list->entries[i].value.len, list->entries[i].value.value);\n    }\n    free_entry_list(&list);\n    free_tree(&btree);\n\n    // Test find on missing\n    btree = new_btree();\n    add_entry(btree, \"x\", sizeof(\"x\"), \"X\", sizeof(\"X\"));\n    v = find_entry(btree, \"y\", sizeof(\"y\"));\n    printf(\"find missing: %s\\n\", v == NULL ? \"null\" : \"not-null\");\n    free_tree(&btree);\n\n    // Test empty tree find\n    btree = new_btree();\n    v = find_entry(btree, \"any\", sizeof(\"any\"));\n    printf(\"empty tree find: %s\\n\", v == NULL ? \"null\" : \"not-null\");\n    printf(\"empty tree count: %zu\\n\", get_entry_count(btree));\n    list = list_entries(btree);\n    printf(\"empty tree list len: %zu cap: %zu\\n\", list->len, list->cap);\n    free_entry_list(&list);\n    free_tree(&btree);\n\n    // Test long key - past BTREE_KEY_SIZE\n    btree = new_btree();\n    add_entry(btree, \"0123456789ABC\", sizeof(\"0123456789ABC\"), \"VLONG\", sizeof(\"VLONG\"));\n    // Find with same long key\n    v = find_entry(btree, \"0123456789ABC\", sizeof(\"0123456789ABC\"));\n    printf(\"long key find: %s len=%zu\\n\", v == NULL ? \"null\" : \"found\", v ? v->len : 0);\n    // Find with key that has same first 10 chars\n    v = find_entry(btree, \"0123456789XYZ\", sizeof(\"0123456789XYZ\"));\n    printf(\"long key find with diff suffix: %s\\n\", v == NULL ? \"null\" : \"found-(equal-because-truncated)\");\n    free_tree(&btree);\n\n    // Test 2-children deletion\n    btree = new_btree();\n    add_entry(btree, \"entry_1\", sizeof(\"entry_1\"), \"value_1\", sizeof(\"value_1\"));\n    add_entry(btree, \"entry_2\", sizeof(\"entry_2\"), \"value_2\", sizeof(\"value_2\"));\n    add_entry(btree, \"entry_3\", sizeof(\"entry_3\"), \"value_3\", sizeof(\"value_3\"));\n    add_entry(btree, \"entry_4\", sizeof(\"entry_4\"), \"value_4\", sizeof(\"value_4\"));\n    add_entry(btree, \"entry_5\", sizeof(\"entry_5\"), \"value_5\", sizeof(\"value_5\"));\n    remove_entry(btree, \"entry_3\", sizeof(\"entry_3\"));\n    list = list_entries(btree);\n    printf(\"after-remove-3 len=%zu\\n\", list->len);\n    for (size_t i=0; i<list->len; i++) {\n        printf(\"  idx=%zu key='%.*s' val='%.*s'\\n\", i,\n               (int)list->entries[i].key.len, list->entries[i].key.key,\n               (int)list->entries[i].value.len, list->entries[i].value.value);\n    }\n    free_entry_list(&list);\n    free_tree(&btree);\n\n    return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":389,"cache_read_input_tokens":28132,"cache_creation":{"ephemeral_5m_input_tokens":389,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"622d9a2e-3cd0-4523-925c-cc47e498510a","uuid":"90b2162d-aed1-4cf6-9546-4288a35a091e"}
