len: %zu cap: %zu\\n\", list->len, list->cap);\n    free_entry_list(&list);\n    free_tree(&btree);\n\n    // Test long key - past BTREE_KEY_SIZE\n    btree = new_btree();\n    add_entry(btree, \"0123456789ABC\", sizeof(\"0123456789ABC\"), \"VLONG\", sizeof(\"VLONG\"));\n    // Find with same long key\n    v = find_entry(btree, \"0123456789ABC\", sizeof(\"0123456789ABC\"));\n    printf(\"long key find: %s len=%zu\\n\", v == NULL ? \"null\" : \"found\", v ? v->len : 0);\n    // Find with key that has same first 10 chars\n    v = find_entry(btree, \"0123456789XYZ\", sizeof(\"0123456789XYZ\"));\n    printf(\"long key find with diff suffix: %s\\n\", v == NULL ? \"null\" : \"found-(equal-because-truncated)\");\n    free_tree(&btree);\n\n    // Test 2-children deletion\n    btree = new_btree();\n    add_entry(btree, \"entry_1\", sizeof(\"entry_1\"), \"value_1\", sizeof(\"value_1\"));\n    add_entry(btree, \"entry_2\", sizeof(\"entry_2\"), \"value_2\", sizeof(\"value_2\"));\n    add_entry(btree, \"entry_3\", sizeof(\"entry_3\"), \"value_3\", sizeof(\"value_3\"));\n    add_entry(btree, \"entry_4\", sizeof(\"entry_4\"), \"value_4\", sizeof(\"value_4\"));\n    add_entry(btree, \"entry_5\", sizeof(\"entry_5\"), \"value_5\", sizeof(\"value_5\"));\n    remove_entry(btree, \"entry_3\", sizeof(\"entry_3\"));\n    list = list_entries(btree);\n    printf(\"after-remove-3 len=%zu\\n\", list->len);\n    for (size_t i=0; i<list->len; i++) {\n        printf(\"  idx=%zu key='%.*s' val='%.*s'\\n\", i,\n               (int)list->entries[i].key.len, list->entries[i].key.key,\n               (int)list->entries[i].value.len, list->entries[i].value.value);\n    }\n    free_entry_list(&list);\n    free_tree(&btree);\n\n    return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
