y(btree, &int_key, sizeof(int_key), \"value_2\", sizeof(\"value_2\"));\n67\t    uint64_t long_key = 10;\n68\t    add_entry(btree, &long_key, sizeof(long_key), \"value_3\", sizeof(\"value_3\"));\n69\t    uint8_t byte_key = 9;\n70\t    add_entry(btree, &byte_key, sizeof(byte_key), \"value_4\", sizeof(\"value_4\"));\n71\t\n72\t    value_t* value = find_entry(btree, \"entry_1\", sizeof(\"entry_1\"));\n73\t    assert(value != NULL);\n74\t    assert(memcmp(value->value, \"value_1\", sizeof(\"value_1\")) == 0);\n75\t\n76\t    value = find_entry(btree, &int_key, sizeof(int_key));\n77\t    assert(value != NULL);\n78\t    assert(memcmp(value->value, \"value_2\", sizeof(\"value_2\")) == 0);\n79\t\n80\t    value = find_entry(btree, &long_key, sizeof(long_key));\n81\t    assert(value != NULL);\n82\t    assert(memcmp(value->value, \"value_3\", sizeof(\"value_3\")) == 0);\n83\t\n84\t    value = find_entry(btree, &byte_key, sizeof(byte_key));\n85\t    assert(value != NULL);\n86\t    assert(memcmp(value->value, \"value_4\", sizeof(\"value_4\")) == 0);\n87\t\n88\t    free_tree(&btree);\n89\t}\n90\t\n91\tvoid test_add_custom_struct() {\n92\t    btree_t* btree = new_btree();\n93\t    typedef struct custom_key {\n94\t        uint32_t key;\n95\t        uint32_t key2;\n96\t    }custom_key_t;\n97\t\n98\t    custom_key_t key = {1, 2};\n99\t    add_entry(btree, &key, sizeof(key), \"value_1\", sizeof(\"value_1\"));\n100\t    value_t* value = find_entry(btree, &key, sizeof(key));\n101\t    assert(value != NULL);\n102\t    assert(memcmp(value->value, \"value_1\", sizeof(\"value_1\")) == 0);\n103\t    free_tree(&btree);\n104\t}\n105\t\n106\tvoid test_add_custom_struct_to_value() {\n107\t    btree_t* btree = new_btree();\n108\t    typedef struct custom_value {\n109\t        uint32_t value;\n110\t        uint32_t value2;\n111\t    }custom_value_t;\n112\t\n113\t    custom_value_t c_value = {1, 2};\n114\t    add_entry(btree, \"key_1\", sizeof(\"key_1\"), &c_value, sizeof(c_value));\n115\t    value_t