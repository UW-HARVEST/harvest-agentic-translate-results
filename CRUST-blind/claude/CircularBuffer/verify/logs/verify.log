        else\n127\t            cBuf->dataSize = cBuf->size - (cBuf->headOffset - cBuf->tailOffset - 1);\n128\t    }\n129\t}\n130\t\n131\tsize_t inter_circularBuffer_read(CircularBuffer cBuf, size_t length, void *dataOut, bool resetHead)\n132\t{\n133\t    if(cBuf->dataSize == 0 || length == 0)\n134\t        return 0;\n135\t    \n136\t    size_t rdLen = length;\n137\t    \n138\t    if(cBuf->dataSize < rdLen)\n139\t        rdLen = cBuf->dataSize;\n140\t    \n141\t    \n142\t    if(cBuf->headOffset <= cBuf->tailOffset)\n143\t    {\n144\t        if(dataOut)\n145\t            memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n146\t        \n147\t        if(resetHead)\n148\t        {\n149\t            cBuf->headOffset += rdLen;\n150\t            if(cBuf->headOffset > cBuf->tailOffset)\n151\t            {\n152\t                cBuf->headOffset = -1;\n153\t                cBuf->tailOffset = -1;\n154\t            }\n155\t        }\n156\t    }\n157\t    else\n158\t    {\n159\t        if(cBuf->headOffset+rdLen <= cBuf->size)\n160\t        {\n161\t            if(dataOut)\n162\t                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n163\t            \n164\t            if(resetHead)\n165\t            {\n166\t                cBuf->headOffset += rdLen;\n167\t                if(cBuf->headOffset == cBuf->size)\n168\t                    cBuf->headOffset = 0;\n169\t            }\n170\t        }\n171\t        else\n172\t        {\n173\t            size_t frg1Len = cBuf->size - cBuf->headOffset;\n174\t            if(dataOut)\n175\t                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], frg1Len);\n176\t            \n177\t            size_t frg2len = rdLen - frg1Len;\n178\t            if(dataOut)\n179\t                memcpy(dataOut+frg1Len, cBuf->buffer, frg2len);\n180\t            \n181\t            if(resetHead)\n182\t            {\n183\t                cBuf->headOffset = frg2len;\n184\t                if(cBuf->headOffset > cBuf->tailOffset)\n185\t      