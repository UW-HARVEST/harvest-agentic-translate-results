{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01S2pyyE9neLWxNrYGSWE3dE","type":"tool_result","content":"1\t//\n2\t//  CircularBuffer.c\n3\t//\n4\t//  Created by 罗亮富(Roen zxllf23@163.com) on 14-1-14.\n5\t//  Copyright (c) 2014年 All rights reserved.\n6\t//\n7\t\n8\t\n9\t#include \"circular_buffer.h\"\n10\t#include <string.h>\n11\t\n12\tstruct s_circularBuffer{\n13\t    \n14\t    size_t size; //capacity bytes size\n15\t    size_t dataSize; //occupied data size\n16\t    size_t tailOffset; //head offset, the oldest byte position offset\n17\t    size_t headOffset; //tail offset, the lastest byte position offset\n18\t    void *buffer;\n19\t\n20\t};\n21\t\n22\textern CircularBuffer CircularBufferCreate(size_t size)\n23\t{\n24\t    size_t totalSize = sizeof(struct s_circularBuffer) + size;\n25\t    void *p = malloc(totalSize);\n26\t    CircularBuffer buffer = (CircularBuffer)p;\n27\t    buffer->buffer = p + sizeof(struct s_circularBuffer);\n28\t    buffer->size = size;\n29\t    CircularBufferReset(buffer);\n30\t    return buffer;\n31\t}\n32\t\n33\tvoid CircularBufferFree(CircularBuffer cBuf)\n34\t{\n35\t    CircularBufferReset(cBuf);\n36\t    cBuf->size = 0;\n37\t    cBuf->dataSize = 0;\n38\t    cBuf->buffer = NULL;\n39\t    free(cBuf);\n40\t}\n41\t\n42\tvoid CircularBufferReset(CircularBuffer cBuf)\n43\t{\n44\t    cBuf->headOffset = -1;\n45\t    cBuf->tailOffset = -1;\n46\t    cBuf->dataSize = 0;\n47\t}\n48\t\n49\tsize_t CircularBufferGetCapacity(CircularBuffer cBuf) {\n50\t    \n51\t    return cBuf->size;\n52\t}\n53\t\n54\tsize_t CircularBufferGetSize(CircularBuffer cBuf)\n55\t{\n56\t    return cBuf->size;\n57\t}\n58\t\n59\tsize_t CircularBufferGetDataSize(CircularBuffer cBuf)\n60\t{\n61\t    return cBuf->dataSize;\n62\t}\n63\t\n64\tvoid CircularBufferPush(CircularBuffer cBuf,void *src, size_t length)\n65\t{\n66\t    if(length == 0)\n67\t        return;\n68\t\n69\t    size_t writableLen = length;\n70\t    void *pSrc = src;\n71\t    \n72\t   