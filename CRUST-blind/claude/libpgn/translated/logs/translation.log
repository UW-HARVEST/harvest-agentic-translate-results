    true\n}\n\n/// Skip a single `\\n` or `\\r\\n` sequence. Returns true on success.\npub fn pgn_cursor_skip_newline(s: &str, cursor: &mut usize) -> bool {\n    let bytes = s.as_bytes();\n\n    if *cursor < bytes.len() && bytes[*cursor] == b'\\r' {\n        // The C code asserts both characters - we preserve that behavior with debug_assert.\n        debug_assert_eq!(bytes[*cursor], b'\\r');\n        *cursor += 1;\n        debug_assert!(*cursor < bytes.len() && bytes[*cursor] == b'\\n');\n        *cursor += 1;\n        return true;\n    }\n\n    debug_assert!(*cursor < bytes.len() && bytes[*cursor] == b'\\n');\n    *cursor += 1;\n    true\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1030,"cache_read_input_tokens":57137,"cache_creation":{"ephemeral_5m_input_tokens":1030,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"39eb130b-d442-47af-8b11-f74707a8caa1","uuid":"78eceb77-ed0b-44f3-975e-0bdfb3ebe0c9"}
