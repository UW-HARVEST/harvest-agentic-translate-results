       if mv.annotation != PgnAnnotation::Unknown {\n190\t                debug_assert!(skipped_whitespace_after_ep);\n191\t            }\n192\t        }\n193\t\n194\t        pgn_cursor_revisit_whitespace(s, &mut cursor);\n195\t\n196\t        let notation_len = cursor.min(PGN_MOVE_NOTATION_SIZE.saturating_sub(1));\n197\t        let raw_bytes = &bytes[..notation_len];\n198\t        mv.notation = String::from_utf8_lossy(raw_bytes).into_owned();\n199\t\n200\t        *consumed += cursor;\n201\t        mv\n202\t    }\n203\t}\n204\t\n205\timpl From<&str> for PgnMove {\n206\t    fn from(s: &str) -> Self {\n207\t        let mut consumed = 0usize;\n208\t        PgnMove::from_string_with_consumption(s, &mut consumed)\n209\t    }\n210\t}\n211\t\n212\timpl Display for PgnMove {\n213\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n214\t        let mut had_pre_check = false;\n215\t        match self.castles {\n216\t            PGN_CASTLING_NONE => {}\n217\t            PGN_CASTLING_KINGSIDE => {\n218\t                f.write_str(\"O-O\")?;\n219\t                had_pre_check = true;\n220\t            }\n221\t            PGN_CASTLING_QUEENSIDE => {\n222\t                f.write_str(\"O-O-O\")?;\n223\t                had_pre_check = true;\n224\t            }\n225\t            _ => {}\n226\t        }\n227\t\n228\t        if !had_pre_check {\n229\t            if self.piece != PgnPiece::Pawn && self.piece != PgnPiece::Unknown {\n230\t                let ch = match self.piece {\n231\t                    PgnPiece::Rook => 'R',\n232\t                    PgnPiece::Knight => 'N',\n233\t                    PgnPiece::Bishop => 'B',\n234\t                    PgnPiece::Queen => 'Q',\n235\t                    PgnPiece::King => 'K',\n236\t                    _ => ' ',\n237\t                };\n238\t                f.write_fmt(format_args!(\"{}\", ch))?;\n239\t            }\n240\t            if let Some(file) = self.from.file {\n241\t                f.write_fmt(format_args!(\"{}\", file))?;\n242\t            }\n243\t            if let Some(rank) = self.from.rank {\n244\t                f.write_fmt(format_args!(\"{}\", rank))?;\n245\t            }\n246\t            if self.captures {\n247\t                f.write_str(\"x\")?;\n248\t            }\n249\t            if let Some(file) = self.dest.file {\n250\t                f.write_fmt(format_args!(\"{}\", file))?;\n251\t            }\n252\t            if let Some(rank) = self.dest.rank {\n253\t                f.write_fmt(format_args!(\"{}\", rank))?;\n254\t            }\n255\t            if self.promoted_to != PgnPiece::Unknown {\n256\t                let ch = match self.promoted_to {\n257\t                    PgnPiece::Rook => 'R',\n258\t                    PgnPiece::Knight => 'N',\n259\t                    PgnPiece::Bishop => 'B',\n260\t                    PgnPiece::Queen => 'Q',\n261\t                    PgnPiece::King => 'K',\n262\t                    PgnPiece::Pawn => 'P',\n263\t                    _ => ' ',\n264\t                };\n265\t                f.write_str(\"=\")?;\n266\t                f.write_fmt(format_args!(\"{}\", ch))?;\n267\t            }\n268\t        }\n269\t\n270\t        match self.check {\n271\t            PgnCheck::None => {}\n272\t            PgnCheck::Mate => f.write_str(\"#\")?,\n273\t            PgnCheck::Single => f.write_str(\"+\")?,\n274\t            PgnCheck::Double => f.write_str(\"++\")?,\n275\t        }\n276\t\n277\t        if matches!(\n278\t            self.annotation,\n279\t            PgnAnnotation::GoodMove\n280\t                | PgnAnnotation::Mistake\n281\t                | PgnAnnotation::BrilliantMove\n282\t                | PgnAnnotation::Blunder\n283\t                | PgnAnnotation::InterestingMove\n284\t                | PgnAnnotation::DubiousMove\n285\t        ) {\n286\t            f.write_fmt(format_args!(\"{}\", self.annotation))?;\n287\t        }\n288\t\n289\t        if self.en_passant {\n290\t            f.write_str(\" e.p.\")?;\n291\t        }\n292\t\n293\t        // Trailing NAG annotation for unsupported single-symbol annotations\n294\t        if matches!(self.annotation, PgnAnnotation::Null) {\n295\t            // PGN_ANNOTATION_NULL means $0 trailing\n296\t            f.write_str(\" $0\")?;\n297\t        }\n298\t\n299\t        Ok(())\n300\t    }\n301\t}\n302\t\n303\t#[derive(Debug)]\n304\tpub struct PgnMoves {\n305\t    pub values: Vec<PgnMovesItem>,\n306\t}\n307\t\n308\timpl From<&str> for PgnMoves {\n309\t    fn from(s: &str) -> Self {\n310\t        let mut consumed = 0usize;\n311\t        PgnMoves::from_string_with_consumption(s, &mut consumed)\n312\t    }\n313\t}\n314\t\n315\timpl PgnMoves {\n316\t    pub fn new() -> Self {\n317\t        PgnMoves {\n318\t            values: Vec::with_capacity(PGN_MOVES_INITIAL_SIZE),\n319\t        }\n320\t    }\n321\t\n322\t    pub fn from_string_with_consumption(s: &str, consumed: &mut usize) -> Self {\n323\t        let mut moves = PgnMoves::new();\n324\t        let used = parse_moves_recurse(s, &mut moves, EXPECT_WHITE);\n325\t        *consumed += used;\n326\t        moves\n327\t    }\n328\t\n329\t    pub fn push(&mut self, moves: PgnMovesItem) {\n330\t        self.values.push(moves);\n331\t    }\n332\t}\n333\t\n334\timpl Default for PgnMoves {\n335\t    fn default() -> Self {\n336\t        Self::new()\n337\t    }\n338\t}\n339\t\n340\t#[derive(Debug)]\n341\tpub struct PgnMovesItem {\n342\t    pub white: PgnMove,\n343\t    pub black: PgnMove,\n344\t}\n345\t\n346\timpl Default for PgnMovesItem {\n347\t    fn default() -> Self {\n348\t        Self {\n349\t            white: PgnMove::default(),\n350\t            black: PgnMove::default(),\n351\t        }\n352\t    }\n353\t}\n354\t\n355\t#[derive(Debug)]\n356\tpub struct PgnAlternativeMoves {\n357\t    pub values: Vec<Box<PgnMoves>>,\n358\t}\n359\t\n360\timpl PgnAlternativeMoves {\n361\t    pub fn new() -> Self {\n362\t        PgnAlternativeMoves {\n363\t            values: Vec::with_capacity(PGN_ALTERNATIVE_MOVES_INITIAL_SIZE),\n364\t        }\n365\t    }\n366\t\n367\t    pub fn poll(\n368\t        alt: &mut Option<Self>,\n369\t        placeholder: &mut Option<PgnComments>,\n370\t        s: &str,\n371\t        expect: i32,\n372\t    ) -> usize {\n373\t        let bytes = s.as_bytes();\n374\t        let mut cursor = 0usize;\n375\t\n376\t        while cursor < bytes.len() && bytes[cursor] == b'(' {\n377\t            cursor += 1;\n378\t\n379\t            if alt.is_none() {\n380\t                *alt = Some(PgnAlternativeMoves::new());\n381\t            }\n382\t\n383\t            pgn_cursor_skip_whitespace(s, &mut cursor);\n384\t\n385\t            let mut sub_moves = PgnMoves::new();\n386\t            let used = parse_moves_recurse(&s[cursor..], &mut sub_moves, expect);\n387\t            cursor += used;\n388\t            alt.as_mut().unwrap().push(sub_moves);\n389\t\n390\t            pgn_cursor_skip_whitespace(s, &mut cursor);\n391\t            debug_assert!(cursor < bytes.len() && bytes[cursor] == b')');\n392\t            cursor += 1;\n393\t\n394\t            pgn_cursor_skip_whitespace(s, &mut cursor);\n395\t            poll_comments_into(\n396\t                placeholder,\n397\t                PgnCommentPosition::AfterAlternative,\n398\t                &s[cursor..],\n399\t                &mut cursor,\n400\t            );\n401\t        }\n402\t\n403\t        cursor\n404\t    }\n405\t\n406\t    pub fn push(&mut self, moves: PgnMoves) {\n407\t        self.values.push(Box::new(moves));\n408\t    }\n409\t}\n410\t\n411\timpl Default for PgnAlternativeMoves {\n412\t    fn default() -> Self {\n413\t        Self::new()\n414\t    }\n415\t}\n416\t\n417\t/// Helper: poll comments into an `Option<PgnComments>`. If the input string starts with\n418\t/// `{`, we (lazily) initialise `placeholder` and extend it. Otherwise no allocation occurs.\n419\tfn poll_comments_into(\n420\t    placeholder: &mut Option<PgnComments>,\n421\t    pos: PgnCommentPosition,\n422\t    s: &str,\n423\t    cursor: &mut usize,\n424\t) {\n425\t    let bytes = s.as_bytes();\n426\t    if bytes.is_empty() || bytes[0] != b'{' {\n427\t        return;\n428\t    }\n429\t\n430\t    if placeholder.is_none() {\n431\t        *placeholder = Some(PgnComments::new());\n432\t    }\n433\t    let inner = placeholder.as_mut().unwrap();\n434\t    let consumed = inner.poll(pos, s);\n435\t    *cursor += consumed;\n436\t}\n437\t\n438\t/// Recursively parse moves until we hit a terminator (`)`, `\\0`, or end-of-string).\n439\t/// Returns the total number of bytes consumed.\n440\tfn parse_moves_recurse(s: &str, moves: &mut PgnMoves, expect: i32) -> usize {\n441\t    let bytes = s.as_bytes();\n442\t\n443\t    if bytes.is_empty() || bytes[0] == b')' || bytes[0] == 0 {\n444\t        return 0;\n445\t    }\n446\t\n447\t    let mut cursor = 0usize;\n448\t    let mut item = PgnMovesItem::default();\n449\t\n450\t    let mut comments: Option<PgnComments> = None;\n451\t\n452\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n453\t    poll_comments_into(\n454\t        &mut comments,\n455\t        PgnCommentPosition::BeforeMove,\n456\t        &s[cursor..],\n457\t        &mut cursor,\n458\t    );\n459\t\n460\t    if cursor >= bytes.len() {\n461\t        return cursor;\n462\t    }\n463\t\n464\t    debug_assert!((bytes[cursor] as char).is_ascii_digit());\n465\t    while cursor < bytes.len() && (bytes[cursor] as char).is_ascii_digit() {\n466\t        cursor += 1;\n467\t    }\n468\t\n469\t    let mut dots_count = 0;\n470\t    debug_assert!(cursor < bytes.len() && bytes[cursor] == b'.');\n471\t    while cursor < bytes.len() && bytes[cursor] == b'.' {\n472\t        cursor += 1;\n473\t        dots_count += 1;\n474\t    }\n475\t\n476\t    if expect == EXPECT_WHITE {\n477\t        debug_assert_eq!(dots_count, 1);\n478\t    }\n479\t    if expect == EXPECT_BLACK {\n480\t        debug_assert_eq!(dots_count, 3);\n481\t    }\n482\t\n483\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n484\t    poll_comments_into(\n485\t        &mut comments,\n486\t        PgnCommentPosition::BetweenMove,\n487\t        &s[cursor..],\n488\t        &mut cursor,\n489\t    );\n490\t\n491\t    if dots_count == 3 {\n492\t        item.black = PgnMove::from_string_with_consumption(&s[cursor..], &mut cursor);\n493\t        pgn_cursor_skip_whitespace(s, &mut cursor);\n494\t        poll_comments_into(\n495\t            &mut comments,\n496\t            PgnCommentPosition::AfterMove,\n497\t            &s[cursor..],\n498\t            &mut cursor,\n499\t        );\n500\t        cursor += PgnAlternativeMoves::poll(\n501\t            &mut item.black.alternatives,\n502\t            &mut comments,\n503\t            &s[cursor..],\n504\t            EXPECT_BLACK,\n505\t        );\n506\t        pgn_cursor_skip_whitespace(s, &mut cursor);\n507\t        poll_comments_into(\n508\t            &mut comments,\n509\t            PgnCommentPosition::AfterMove,\n510\t            &s[cursor..],\n511\t            &mut cursor,\n512\t        );\n513\t\n514\t        if comments.is_some() {\n515\t            item.black.comments = comments.take();\n516\t        }\n517\t\n518\t        moves.push(item);\n519\t        let used = parse_moves_recurse(&s[cursor..], moves, EXPECT_WHITE);\n520\t        cursor += used;\n521\t        return cursor;\n522\t    }\n523\t\n524\t    item.white = PgnMove::from_string_with_consumption(&s[cursor..], &mut cursor);\n525\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n526\t    poll_comments_into(\n527\t        &mut comments,\n528\t        PgnCommentPosition::AfterMove,\n529\t        &s[cursor..],\n530\t        &mut cursor,\n531\t    );\n532\t    cursor += PgnAlternativeMoves::poll(\n533\t        &mut item.white.alternatives,\n534\t        &mut comments,\n535\t        &s[cursor..],\n536\t        EXPECT_WHITE,\n537\t    );\n538\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n539\t    poll_comments_into(\n540\t        &mut comments,\n541\t        PgnCommentPosition::AfterMove,\n542\t        &s[cursor..],\n543\t        &mut cursor,\n544\t    );\n545\t\n546\t    if comments.is_some() {\n547\t        item.white.comments = comments.take();\n548\t    }\n549\t\n550\t    if !matches!(PgnScore::from(&s[cursor..]), PgnScore::Unknown) {\n551\t        moves.push(item);\n552\t        return cursor;\n553\t    }\n554\t\n555\t    if cursor >= bytes.len() || bytes[cursor] == b')' || bytes[cursor] == 0 {\n556\t        moves.push(item);\n557\t        return cursor;\n558\t    }\n559\t\n560\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n561\t    poll_comments_into(\n562\t        &mut comments,\n563\t        PgnCommentPosition::BeforeMove,\n564\t        &s[cursor..],\n565\t        &mut cursor,\n566\t    );\n567\t\n568\t    if cursor < bytes.len() && (bytes[cursor] as char).is_ascii_digit() {\n569\t        while cursor < bytes.len() && (bytes[cursor] as char).is_ascii_digit() {\n570\t            cursor += 1;\n571\t        }\n572\t        for _ in 0..3 {\n573\t            debug_assert!(cursor < bytes.len() && bytes[cursor] == b'.');\n574\t            cursor += 1;\n575\t        }\n576\t    }\n577\t\n578\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n579\t    poll_comments_into(\n580\t        &mut comments,\n581\t        PgnCommentPosition::BetweenMove,\n582\t        &s[cursor..],\n583\t        &mut cursor,\n584\t    );\n585\t\n586\t    item.black = PgnMove::from_string_with_consumption(&s[cursor..], &mut cursor);\n587\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n588\t    poll_comments_into(\n589\t        &mut comments,\n590\t        PgnCommentPosition::AfterMove,\n591\t        &s[cursor..],\n592\t        &mut cursor,\n593\t    );\n594\t    cursor += PgnAlternativeMoves::poll(\n595\t        &mut item.black.alternatives,\n596\t        &mut comments,\n597\t        &s[cursor..],\n598\t        EXPECT_BLACK,\n599\t    );\n600\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n601\t    poll_comments_into(\n602\t        &mut comments,\n603\t        PgnCommentPosition::AfterMove,\n604\t