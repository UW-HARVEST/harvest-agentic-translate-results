(str + cursor, &cursor);\n58\t    if ((int)white == -1) return PGN_SCORE_UNKNOWN;\n59\t\n60\t    if (str[cursor++] != '-') return PGN_SCORE_UNKNOWN;\n61\t\n62\t    pgn_score_single_t black = __pgn_score_single_from_string(str + cursor, &cursor);\n63\t    if ((int)black == -1) return PGN_SCORE_UNKNOWN;\n64\t\n65\t    *consumed += cursor;\n66\t\n67\t    if (white == HALF && black == HALF)   return PGN_SCORE_DRAW;\n68\t    else if (white == 1 && black == 0)    return PGN_SCORE_WHITE_WON;\n69\t    else if (white == 0 && black == 1)    return PGN_SCORE_BLACK_WON;\n70\t    else if (white == 0 && black == 0)    return PGN_SCORE_FORFEIT;\n71\t    else if (white == 0 && black == HALF) return PGN_SCORE_WHITE_FORFEIT;\n72\t    else if (white == HALF && black == 0) return PGN_SCORE_BLACK_FORFEIT;\n73\t    else                                  return PGN_SCORE_UNKNOWN;\n74\t}\n75\t\n76\tpgn_score_t pgn_score_from_string(char *str)\n77\t{\n78\t    size_t consumed = 0;\n79\t    return __pgn_score_from_string(str, &consumed);\n80\t}\n81\t\n82\tchar *pgn_score_to_string(pgn_score_t score)\n83\t{\n84\t    switch (score) {\n85\t    case PGN_SCORE_UNKNOWN:       break;\n86\t    case PGN_SCORE_ONGOING:       return \"*\";\n87\t    case PGN_SCORE_DRAW:          return \"1/2-1/2\";\n88\t    case PGN_SCORE_WHITE_WON:     return \"1-0\";\n89\t    case PGN_SCORE_BLACK_WON:     return \"0-1\";\n90\t    case PGN_SCORE_FORFEIT:       return \"0-0\";\n91\t    case PGN_SCORE_WHITE_FORFEIT: return \"0-1/2\";\n92\t    case PGN_SCORE_BLACK_FORFEIT: return \"1/2-0\";\n93\t    }\n94\t\n95\t    return \"\";\n96\t}\n97\t"}]},"parent_tool_use_id":null,"session_id":"dde47fb5-252b-4b3d-bfcb-2b8a4337ad06","uuid":"2de78451-32b6-4fb9-bf3a-e092a3d5442e","timestamp":"2026-05-29T18:30:10.032Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-Lsm3gY/project/c_src/score.c","content":"/* libpgn - PGN file parser.\n * Copyright (C) 2024 youkwhd <lolywk@tutanota.com>\n *\n * This program is free software; you can redistribute it and/or modify\n * it under the terms of the GNU General Public License as published by\n * the Free Software Foundation; either version 2 of the License, or\n * (at your option) any later version.\n *\n * This program is distributed in the hope that it will be useful,\n * but WITHOUT ANY WARRANTY; without even the implied warranty of\n * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n * GNU General Public License for more details.\n *\n * You should have received a copy of the GNU General Public License along\n * with this program; if not, write to the Free Software Foundation, Inc.,\n * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n */\n\n#include <string.h>\n\n#include \"score.h\"\n\ntypedef enum pgn_score_single_t {\n    ZERO = 0,\n    ONE,\n    HALF,\n} pgn_score_single_t;\n\n/* only parses the score one sided\n */\npgn_score_single_t __pgn_score_single_from_string(char *str, size_t *consumed)\n{\n    if (strncmp(str, \"1/2\", 3) == 0) {\n        *consumed += 3;\n        return HALF;\n    } else if (*str == '0') {\n        *consumed += 1;\n        return ZERO;\n    } else if (*str == '1') {\n        *consumed += 1;\n        return ONE;\n    }\n\n    return -1;\n}\n\npgn_score_t __pgn_score_from_string(char *str, size_t *consumed)\n{\n    size_t cursor = 0;\n\n    if (str[cursor] == '*') {\n        cursor++;\n        *consumed += cursor;\n        return PGN_SCORE_ONGOING;\n    }\n\n    pgn_score_single_t white = __pgn_score_single_from_string(str + cursor, &cursor);\n    if ((int)white == -1) return PGN_SCORE_UNKNOWN;\n\n    if (str[cursor++] != '-') return PGN_SCORE_UNKNOWN;\n\n    pgn_score_single_t black = __pgn_score_single_from_string(str + cursor, &cursor);\n    if ((int)black == -1) return PGN_SCORE_UNKNOWN;\n\n    *consumed += cursor;\n\n    if (white == HALF && black == HALF)   return PGN_SCORE_DRAW;\n    else if (white == 1 && black == 0)    return PGN_SCORE_WHITE_WON;\n    else if (white == 0 && black == 1)    return PGN_SCORE_BLACK_WON;\n    else if (white == 0 && black == 0)    return PGN_SCORE_FORFEIT;\n    else if (white == 0 && black == HALF) return PGN_SCORE_WHITE_FORFEIT;\n    else if (white == HALF && black == 0) return PGN_SCORE_BLACK_FORFEIT;\n    else                                  return PGN_SCORE_UNKNOWN;\n}\n\npgn_score_t pgn_score_from_string(char *str)\n{\n    size_t consumed = 0;\n    return __pgn_score_from_string(str, &consumed);\n}\n\nchar *pgn_score_to_string(pgn_score_t score)\n{\n    switch (score) {\n    case PGN_SCORE_UNKNOWN:       break;\n    case PGN_SCORE_ONGOING:       return \"*\";\n    case PGN_SCORE_DRAW:          return \"1/2-1/2\";\n    case PGN_SCORE_WHITE_WON:     return \"1-0\";\n    case PGN_SCORE_BLACK_WON:     return \"0-1\";\n    case PGN_SCORE_FORFEIT:       return \"0-0\";\n    case PGN_SCORE_WHITE_FORFEIT: return \"0-1/2\";\n    case PGN_SCORE_BLACK_FORFEIT: return \"1/2-0\";\n    }\n\n    return \"\";\n}\n","numLines":97,"startLine":1,"totalLines":97}}}
