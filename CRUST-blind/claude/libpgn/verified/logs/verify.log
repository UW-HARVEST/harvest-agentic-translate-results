moves->values[0].white.dest.file == 'e');\n357\t    suite6_assert(moves->values[0].white.dest.rank == 1);\n358\t    pgn_moves_cleanup(moves);\n359\t}\n360\t\n361\tvoid test_dump_move()\n362\t{\n363\t    pgn_move_t move = {0};\n364\t    size_t written = 0;\n365\t\n366\t    move = (pgn_move_t){0};\n367\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n368\t    move.piece = PGN_PIECE_PAWN;\n369\t    move.dest.file = 'e';\n370\t    move.dest.rank = 4;\n371\t    written = pgn_move_to_string(&move, move.notation);\n372\t    suite6_assert(strlen(move.notation) == written);\n373\t    suite6_assert(!strcmp(move.notation, \"e4\"));\n374\t\n375\t    move = (pgn_move_t){0};\n376\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n377\t    move.piece = PGN_PIECE_ROOK;\n378\t    move.dest.file = 'e';\n379\t    move.dest.rank = 4;\n380\t    written = pgn_move_to_string(&move, move.notation);\n381\t    suite6_assert(strlen(move.notation) == written);\n382\t    suite6_assert(!strcmp(move.notation, \"Re4\"));\n383\t\n384\t    move = (pgn_move_t){0};\n385\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n386\t    move.piece = PGN_PIECE_ROOK;\n387\t    move.check = PGN_CHECK_MATE;\n388\t    move.dest.file = 'e';\n389\t    move.dest.rank = 4;\n390\t    written = pgn_move_to_string(&move, move.notation);\n391\t    suite6_assert(strlen(move.notation) == written);\n392\t    suite6_assert(!strcmp(move.notation, \"Re4#\"));\n393\t\n394\t    move = (pgn_move_t){0};\n395\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n396\t    move.castles = PGN_CASTLING_KINGSIDE;\n397\t    move.check = PGN_CHECK_MATE;\n398\t    written = pgn_move_to_string(&move, move.notation);\n399\t    suite6_assert(strlen(move.notation) == written);\n400\t    suite6_assert(!strcmp(move.notation, \"O-O#\"));\n401\t\n402\t    move = (pgn_move_t){0};\n403\t    move.annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n404\t    move.piece = PGN_PIECE_ROOK;\n405\t    move.dest.file = 'a';\n406\t    move.dest.rank = 3;\n407\t    written = pgn_