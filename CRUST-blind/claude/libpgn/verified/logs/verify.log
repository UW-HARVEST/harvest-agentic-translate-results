ck.comments = comments;\n323\t        comments = NULL;\n324\t    }\n325\t\n326\t    pgn_moves_push(moves, move);\n327\t\n328\t    if (pgn_score_from_string(str + cursor)) {\n329\t        *consumed += cursor;\n330\t        return moves;\n331\t    }\n332\t\n333\t    __pgn_moves_from_string_recurse(str + cursor, &cursor, moves, PGN_EXPECT_WHITE);\n334\t    *consumed += cursor;\n335\t    return moves;\n336\t}\n337\t\n338\tpgn_moves_t *__pgn_moves_from_string(char *str, size_t *consumed)\n339\t{\n340\t    return __pgn_moves_from_string_recurse(str, consumed, pgn_moves_init(), PGN_EXPECT_WHITE);\n341\t}\n342\t\n343\tpgn_moves_t *pgn_moves_from_string(char *str)\n344\t{\n345\t    size_t consumed = 0;\n346\t    return __pgn_moves_from_string(str, &consumed);\n347\t}\n348\t\n349\tpgn_alternative_moves_t *pgn_alternative_moves_init(void)\n350\t{\n351\t    pgn_alternative_moves_t *alt = malloc(sizeof *alt);\n352\t    alt->values = malloc(sizeof *alt->values * PGN_ALTERNATIVE_MOVES_INITIAL_SIZE);\n353\t    alt->size = PGN_ALTERNATIVE_MOVES_INITIAL_SIZE;\n354\t    alt->length = 0;\n355\t    return alt;\n356\t}\n357\t\n358\tsize_t pgn_alternative_moves_poll(pgn_alternative_moves_t **alt, pgn_comments_t **placeholder, char *str, int expect)\n359\t{\n360\t    size_t cursor = 0;\n361\t\n362\t    while (str[cursor] == '(') {\n363\t        cursor++;\n364\t\n365\t        if (!*alt)\n366\t            *alt = pgn_alternative_moves_init();\n367\t\n368\t        pgn_cursor_skip_whitespace(str, &cursor);\n369\t        pgn_alternative_moves_push(*alt, __pgn_moves_from_string_recurse(str + cursor, &cursor, pgn_moves_init(), expect));\n370\t        pgn_cursor_skip_whitespace(str, &cursor);\n371\t        assert(str[cursor++] == ')');\n372\t\n373\t        pgn_cursor_skip_whitespace(str, &cursor);\n374\t        cursor += pgn_comments_poll(placeholder, PGN_COMMENT_POSITION_AFTER_ALTERNATIVE, str + cursor);\n375\t    }\n376\t\n377\t    return cursor;\n378\t}\n379\t\n380\tvoid pgn_alternative_moves_pu