t comment = comments->values[i];\n70\t\n71\t        if (comment.position == PGN_COMMENT_POSITION_AFTER_MOVE) {\n72\t            printf(\" {%s}\", comment.value->buf);\n73\t        }\n74\t\n75\t        printed = true;\n76\t    }\n77\t\n78\t    return printed;\n79\t}\n80\t\n81\tbool __fmt_print_white(pgn_move_t *move, size_t depth, size_t number)\n82\t{\n83\t    bool printed = false;\n84\t\n85\t    if (move->notation[0]) {\n86\t        if (move->comments) {\n87\t            __fmt_print_comment_before(move->comments);\n88\t        }\n89\t\n90\t        printf(\"%zu. %s\", number, move->notation);\n91\t\n92\t        if (move->comments) {\n93\t            __fmt_print_comment_after(move->comments);\n94\t        }\n95\t\n96\t        if (move->alternatives) {\n97\t            fmt_print_alternative_moves(move->alternatives, depth + 1, number);\n98\t        }\n99\t\n100\t        printed = true;\n101\t    }\n102\t\n103\t    return printed;\n104\t}\n105\t\n106\tbool __fmt_print_black(pgn_move_t *move, size_t depth, size_t number, bool white_printed)\n107\t{\n108\t    bool printed = false;\n109\t\n110\t    if (move->notation[0]) {\n111\t        if (white_printed) {\n112\t            printf(\" \");\n113\t        }\n114\t\n115\t        if (move->comments) {\n116\t            __fmt_print_comment_before(move->comments);\n117\t        }\n118\t\n119\t        if (!white_printed) {\n120\t            printf(\"%zu... \", number);\n121\t        }\n122\t\n123\t        printf(\"%s\", move->notation);\n124\t\n125\t        if (move->comments) {\n126\t            __fmt_print_comment_after(move->comments);\n127\t        }\n128\t\n129\t        if (move->alternatives) {\n130\t            fmt_print_alternative_moves(move->alternatives, depth + 1, number);\n131\t        }\n132\t\n133\t        printed = true;\n134\t    }\n135\t\n136\t    return printed;\n137\t}\n138\t\n139\tbool fmt_print_moves(pgn_moves_t *moves, int depth, size_t last_number, bool root)\n140\t{\n141\t    bool printed = false;\n142\t