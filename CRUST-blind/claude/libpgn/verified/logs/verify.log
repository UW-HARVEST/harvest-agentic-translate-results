suite6_assert(moves->length == 1);\n301\t    suite6_assert(moves->values[0].white.alternatives->length == 1);\n302\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n303\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n304\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n305\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n306\t    pgn_moves_cleanup(moves);\n307\t\n308\t    moves = pgn_moves_from_string(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) (1. e4 f6? 2. d4 g5?? 3. Qh5#) e5\");\n309\t    suite6_assert(moves->length == 1);\n310\t    suite6_assert(moves->values[0].white.alternatives->length == 2);\n311\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n312\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n313\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n314\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n315\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[0].white.notation, \"e4\"));\n316\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[0].black.notation, \"f6?\"));\n317\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[1].white.notation, \"d4\"));\n318\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[1].black.notation, \"g5??\"));\n319\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[2].white.notation, \"Qh5#\"));\n320\t    pgn_moves_cleanup(moves);\n321\t\n322\t    moves = pgn_moves_from_string(\"1. e4