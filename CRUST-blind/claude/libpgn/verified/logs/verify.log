{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PfiJPos4oWUHHc4XGF2FCK","type":"tool_result","content":"1\tuse std::fmt::Display;\n2\tuse crate::utils::cursor::{pgn_cursor_revisit_whitespace, pgn_cursor_skip_whitespace};\n3\t\n4\t#[repr(i8)] // Ensures the enum has a fixed representation like in C\n5\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n6\tpub enum PgnAnnotation {\n7\t    Unknown = -1,\n8\t    Null = 0,\n9\t    GoodMove,        // !\n10\t    Mistake,         // ?\n11\t    BrilliantMove,   // !!\n12\t    Blunder,         // ??\n13\t    InterestingMove, // !?\n14\t    DubiousMove,     // ?!\n15\t}\n16\t\n17\timpl From<i8> for PgnAnnotation {\n18\t    fn from(value: i8) -> Self {\n19\t        match value {\n20\t            -1 => PgnAnnotation::Unknown,\n21\t            0 => PgnAnnotation::Null,\n22\t            1 => PgnAnnotation::GoodMove,\n23\t            2 => PgnAnnotation::Mistake,\n24\t            3 => PgnAnnotation::BrilliantMove,\n25\t            4 => PgnAnnotation::Blunder,\n26\t            5 => PgnAnnotation::InterestingMove,\n27\t            6 => PgnAnnotation::DubiousMove,\n28\t            _ => PgnAnnotation::Unknown,\n29\t        }\n30\t    }\n31\t}\n32\t\n33\timpl PgnAnnotation {\n34\t    /// Parses a PGN annotation from a string, consuming characters as needed.\n35\t    pub fn pgn_annotation_nag_from_string(str: &str, consumed: &mut usize) -> Self {\n36\t        let bytes = str.as_bytes();\n37\t        let mut annotation = PgnAnnotation::Unknown;\n38\t        let mut cursor = 0usize;\n39\t\n40\t        if cursor >= bytes.len() || bytes[cursor] != b'$' {\n41\t            return annotation;\n42\t        }\n43\t\n44\t        while cursor < bytes.len() && bytes[cursor] == b'$' {\n45\t            cursor += 1;\n46\t            // expect a digit\n47\t            debug_assert!(cursor < bytes.len() && (bytes[cursor] as char).is_ascii_digit());\n48\t\n49\t            // parse number\n50\t            let start = cursor;\n51\