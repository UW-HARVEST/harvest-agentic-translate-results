{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CPZtF8UmbhgGuWgHwkWgBx","type":"tool_result","content":"1\t#include <libgen.h>\n2\t#include <string.h>\n3\t#include <stdio.h>\n4\t#include <stdlib.h>\n5\t#include <unistd.h>\n6\t#include <termios.h>\n7\t#include <sys/ioctl.h>\n8\t#include <sys/errno.h>\n9\t#include <stdbool.h>\n10\t#include \"../buffer/buffer.h\"\n11\t#include \"defs.h\"\n12\t\n13\t#include \"visual.c\"\n14\t\n15\t/* Constants */\n16\tenum specialKeys {\n17\t    BACKSPACE = 127,\n18\t    ARROW_UP = 1000,\n19\t    ARROW_DOWN,\n20\t    ARROW_LEFT,\n21\t    ARROW_RIGHT,\n22\t    PAGE_UP,\n23\t    PAGE_DOWN,\n24\t    HOME_KEY,\n25\t    END_KEY,\n26\t    DEL_KEY\n27\t};\n28\t\n29\t/* structs */\n30\t\n31\t// Main state & buffers\n32\tstruct EditorState {\n33\t\n34\t    // configuration states\n35\t    struct termios orig_termios;\n36\t\n37\t    // File states\n38\t    char* file_name;\n39\t    char* file_path;         // path to file.\n40\t    bool flushed;             // was the most recent changes flushed to disk\n41\t\n42\t    // buffer states\n43\t    TextBuffer* current_buffer;\n44\t\n45\t    // Window states\n46\t    struct VirtualScreen screen;\n47\t};\n48\t\n49\t/* global editor state */\n50\tstruct EditorState editor_state;\n51\t\n52\t\n53\t/* prototypes */\n54\t\n55\t/* System and Configuration */\n56\tvoid initialize(int argc, char* argv[]);\n57\tvoid cleanup();\n58\tvoid set_window_size();\n59\tvoid disableRawMode();\n60\tvoid enableRawMode();\n61\t\n62\t/* Screen Manipulation */\n63\tvoid render_screen();\n64\tvoid draw_screen();\n65\tvoid draw_status_line(int line_size);\n66\t\n67\t\n68\t/* Cursor Movement */\n69\tvoid up_arrow();\n70\tvoid down_arrow();\n71\tvoid right_arrow();\n72\tvoid left_arrow();\n73\t\n74\t/* Input */\n75\tint read_char();\n76\tvoid process_keypress();\n77\t\n78\t/* File Manipulation*/\n79\tint flush_buffer_to_file();\n80\tint load_file_and_initialize_buffer();\n81\t\n82\t\n83\t/* Main */\n84\tint main(int argc, char* argv[]) {\n85\t    initialize(argc, argv);\n86\t\n87\t    while (1) {\n88\t        draw_screen();\n89\t        render_screen();\n90\t        process_keypress();\n91\t    }\n92\t}\n93\t\n94\t\n95\t/******************************* Implementations *********************************/\n96\t\n97\tvoid initialize(int argc, char* argv[]){\n98\t\n99\t    // Get file path information\n100\t    // TODO: Dont attempt to load file if no path is given.\n101\t    if (argc >= 2){\n102\t        editor_state.file_path = argv[1];\n103\t    }\n104\t    else {\n105\t        editor_state.file_path = \"Empty Buffer\";\n106\t    }\n107\t    editor_state.file_name = basename(editor_state.file_path);\n108\t\n109\t    // Loads the file and initialize the textbuffer\n110\t    load_file_and_initialize_buffer();\n111\t\n112\t    // initialize screen\n113\t    enableRawMode();\n114\t    set_window_size();\n115\t\n116\t    // double the buffer for the screen to allow escape codes to be sent without overflowing\n117\t    editor_state.screen.len = editor_state.screen.height * editor_state.screen.width * sizeof(char) * 2;\n118\t    editor_state.screen.buffer = malloc(editor_state.screen.len);\n119\t    editor_state.screen.buf_pos = 0;\n120\t\n121\t    // the line the screen starts printing from\n122\t    editor_state.screen.render_start_line = 0;\n123\t\n124\t    editor_state.flushed = true;\n125\t}\n126\t\n127\t/*\n128\t * Returns:\n129\t * -1: If there was an issue with opening the file; the buffer is still initialized as a blank buffer\n130\t * MEM_ERROR if it wasn't successfully loaded, or there was an issue resizing/manipulating/initializing the TextBuffer.\n131\t * */\n132\tint load_file_and_initialize_buffer() {\n133\t\n134\t    // We'll open all files in read mode. If there's no file, we'll just have a blank buffer.\n135\t    // Only when writing to file, will we rewrite or create + write to the file.\n136\t    FILE* fp = fopen(editor_state.file_path, \"r\");\n137\t\n138\t    // CreateTextBufferFromFile handles NULL values so we can just pass editor_state.fp and check the return\n139\t    editor_state.current_buffer = CreateTextBufferFromFile(fp);\n140\t\n141\t    if (editor_state.current_buffer == NULL){\n142\t        return MEM_ERROR;\n143\t    }\n144\t\n145\t    if (fp == NULL){\n146\t        return -1;\n147\t    }\n148\t\n149\t    fclose(fp);\n150\t    return 0;\n151\t}\n152\t\n153\tvoid cleanup(){\n154\t\n155\t    // Clear screen\n156\t    write(STDOUT_FILENO, \"\\x1b[2J\", 4);\n157\t    write(STDOUT_FILENO, \"\\x1b[H\", 3);\n158\t\n159\t    // free memory for screen\n160\t    free(editor_state.screen.buffer);\n161\t\n162\t    // Free the text buffer\n163\t    DestroyTextBuffer(editor_state.current_buffer);\n164\t}\n165\t\n166\tvoid panic(const char* message){\n167\t    // Clear screen\n168\t    write(STDOUT_FILENO, \"\\x1b[2J\", 4);\n169\t    write(STDOUT_FILENO, \"\\x1b[H\", 3);\n170\t    // Enable cursor\n171\t    write(STDOUT_FILENO,\"\\x1b[?25h\", 6);\n172\t    perror(message);\n173\t    exit(1);\n174\t}\n175\t\n176\tvoid set_window_size() {\n177\t    struct winsize ws;\n178\t\n179\t    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == -1 || ws.ws_col == 0) {\n180\t        // panic(\"Failed to get window size\");\n181\t\n182\t        // manually get window size\n183\t        if (write(STDOUT_FILENO, \"\\x1b[999C\\x1b[999B\", 12) != 12) {\n184\t            panic(\"Failed to get window size\");\n185\t        }\n186\t\n187\t        // read the response\n188\t        char buf[32];\n189\t        for (int i = 0; i < sizeof(buf); i++) {\n190\t            if (read(STDIN_FILENO, &buf[i], 1) != 1) {\n191\t                panic(\"Failed to get window size\");\n192\t            }\n193\t\n194\t            if (buf[i] == 'R') {\n195\t                buf[i + 1] = '\\0';\n196\t                break;\n197\t            }\n198\t        }\n199\t\n200\t        // parse the response and set the windows size\n201\t        if (sscanf(buf, \"%d;%d\", &editor_state.screen.height, &editor_state.screen.width) != 2) {\n202\t            panic(\"Failed to get windows size\");\n203\t        }\n204\t\n205\t    } else {\n206\t        editor_state.screen.height = ws.ws_row;\n207\t        editor_state.screen.width = ws.ws_col;\n208\t    }\n209\t}\n210\t\n211\tvoid disableRawMode() {\n212\t    if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &editor_state.orig_termios) == -1) {\n213\t        panic(\"tcsetattr\");\n214\t    }\n215\t}\n216\t\n217\t// Test raw mode\n218\tvoid enableRawMode(){\n219\t\n220\t    if(tcgetattr(STDIN_FILENO, &editor_state.orig_termios) == -1) {\n221\t        panic(\"tcgetattr\");\n222\t    }\n223\t\n224\t    atexit(disableRawMode);\n225\t\n226\t    struct termios raw = editor_state.orig_termios;\n227\t\n228\t    /*\n229\t     * Local modes:\n230\t     * Here we are disabling:\n231\t     * ECHO: don't echo input characters back to the screen.\n232\t     * ICANON: canonical mode. Now each character is read as soon as it is typed.\n233\t     * ISIG: SIGINT/SIGSTOP signal interpretation. Now Ctrl-C/Ctrl-Z won't send signals to the process.\n234\t     * IEXTEN: extended input processing. Now Ctrl-V/Ctrl-C/Ctrl-D won't be interpreted as special characters.\n235\t     *\n236\t     * | - logic OR\n237\t     * & - logic AND\n238\t     * ~ - logic XOR\n239\t     */\n240\t    raw.c_lflag &= ~(ECHO | ICANON | ISIG | IEXTEN);\n241\t\n242\t    /*\n243\t     * Input modes:\n244\t     * Here we're disabling:\n245\t     * IXON: disable software flow control.\n246\t     * ICRNL: maps CR to NL (otherwise, it will be CR+NL). Now Ctrl-M will be ignored.\n247\t     * BRKINT: disable break processing. Now break condition will be ignored.\n248\t     * INPCK: disable parity checking. Now parity errors will be ignored. (This doesn't matter anymore)\n249\t     * ISTRIP: disable stripping of eighth bit. Now eighth bit will be ignored. (This probably doesn't matter)\n250\t     **/\n251\t    raw.c_iflag &= ~(ICRNL | IXON | BRKINT | INPCK);\n252\t\n253\t    /*\n254\t     * Output modes:\n255\t     * Here we're disabling:\n256\t     * OPOST: output processing. Now output processing is disabled.\n257\t     *\n258\t     **/\n259\t    raw.c_oflag &= ~(OPOST);\n260\t\n261\t    /*\n262\t     * Control modes:\n263\t     * Here we're disabling:\n264\t     * CS8: 8-bit characters. Now 8-bit characters will be used.\n265\t     **/\n266\t    raw.c_cflag |= (CS8);\n267\t\n268\t    /*\n269\t     * c_cc - control characters.\n270\t     * VMIN: minimum number of characters to read. Set to 0 so that we can read whatever is available.\n271\t     * VTIME: time to wait for characters to be available. Set to 1 (100ms).\n272\t     **/\n273\t    raw.c_cc[VMIN] = 0;\n274\t    raw.c_cc[VTIME] = 1;\n275\t\n276\t    if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw) == -1) {\n277\t        panic(\"tcsetattr\");\n278\t    }\n279\t}\n280\t\n281\t\n282\tvoid screen_append(const char *str, int size) {\n283\t\n284\t    if (editor_state.screen.buffer != NULL && (editor_state.screen.len - editor_state.screen.buf_pos) > size) {\n285\t        memcpy(editor_state.screen.buffer + editor_state.screen.buf_pos, str, size);\n286\t        editor_state.screen.buf_pos += size;\n287\t    }\n288\t}\n289\t\n290\t\n291\t/* Display */\n292\tvoid render_screen() {\n293\t\n294\t    // flush internal screen to display\n295\t    write(STDOUT_FILENO, editor_state.screen.buffer, strlen(editor_state.screen.buffer));\n296\t}\n297\t\n298\t\n299\tvoid draw_screen(){\n300\t\n301\t    editor_state.screen.buf_pos = 0; // reset the screen\n302\t\n303\t    // Disable cursor\n304\t    screen_append(\"\\x1b[?25l\", 6);\n305\t\n306\t    // Clear screen\n307\t    screen_append(\"\\x1b[2J\", 4);\n308\t\n309\t    // Move cursor to the top\n310\t    screen_append(\"\\x1b[H\", 3);\n311\t\n312\t    move_cursor_in_view(editor_state.current_buffer, &editor_state.screen);\n313\t    draw_editor_window(editor_state.current_buffer, &editor_state.screen);\n314\t    draw_status_line(editor_state.screen.width);\n315\t\n316\t    set_virtual_cursor_position(editor_state.current_buffer, &editor_state.screen);\n317\t\n318\t    int row = editor_state.screen.cursor.x;\n319\t    int col = editor_state.screen.cursor.y;\n320\t\n321\t    char buf[32];\n322\t    sprintf(buf, \"\\x1b[%d;%dH\", row, col);\n323\t\n324\t    screen_append(buf, strlen(buf));\n325\t\n326\t    // Enable cursor\n327\t    screen_append(\"\\x1b[?25h\", 6);\n328\t\n329\t    // End the string (so we can get strlen)\n330\t    screen_append(\"\\0\", 1);\n331\t}\n332\t\n333\t\n334\tvoid draw_status_line(int line_size) {\n335\t\n336\t    const char commands[] = \"Ctrl+Q-quit Ctrl+S-Save\";\n337\t    unsigned int commands_len = sizeof commands-1;\n338\t\n339\t    const char modified[] = \"changed\";\n340\t    int modified_len = sizeof modified-1;\n341\t\n342\t    /*\n343\t     * {|file cursor space| |modified len|    |       controls       |\n344\t     * [filename.c | 5,50   changed           Ctrl+Q-quit Ctrl+S-Save]\n345\t     * */\n346\t\n347\t    // Calculate space for each part of the status line\n348\t    int file_cursor_space = line_size - (commands_len + modified_len);\n349\t    int cur_col_digits = snprintf(NULL, 0, \"%d\", editor_state.current_buffer->cursorCol);\n350\t    int cur_row_digits = snprintf(NULL, 0, \"%d\", editor_state.current_buffer->cursorRow);\n351\t\n352\t    int f_name_space = file_cursor_space - (cur_col_digits + cur_row_digits + 5);\n353\t    int file_name_size = strlen(editor_state.file_name);\n354\t\n355\t    int cursor_info_buffer_size = file_cursor_space - f_name_space;\n356\t    char cursor_info_buffer[cursor_info_buffer_size];\n357\t\n358\t\n359\t    // invert the colours\n360\t    screen_append(INVERT_COLOUR, INVERT_COLOUR_SIZE);\n361\t\n362\t    // Write file name. If its longer than available space, we'll cut it short with ellipsis\n363\t    if (file_name_size > f_name_space){\n364\t        screen_append(editor_state.file_name, f_name_space - 4);\n365\t\n366\t        screen_append(\"... \", 4);\n367\t\n368\t    } else {\n369\t        screen_append(editor_state.file_name, file_name_size);\n370\t    }\n371\t\n372\t    // Write col and row info\n373\t    sprintf(cursor_info_buffer,\n374\t            \" | %d,%d \",\n375\t            editor_state.current_buffer->cursorRow, editor_state.current_buffer->cursorCol);\n376\t\n377\t    screen_append(cursor_info_buffer, strlen(cursor_info_buffer));\n378\t\n379\t    // Indicate if buffer was modified since last write.\n380\t    if (!editor_state.flushed) {\n381\t        screen_append(modified, modified_len);\n382\t    }\n383\t    else {\n384\t        memset(editor_state.screen.buffer + editor_state.screen.buf_pos, ' ', modified_len);\n385\t        editor_state.screen.buf_pos += modified_len;\n386\t    }\n387\t\n388\t    // Fill with whitespace\n389\t    memset(editor_state.screen.buffer + editor_state.screen.buf_pos, ' ', f_name_space - file_name_size);\n390\t    editor_state.screen.buf_pos += f_name_space - file_name_size;\n391\t\n392\t    // print help\n393\t    screen_append(commands, commands_len);\n394\t\n395\t    // Finally reset the colour and style\n396\t    screen_append(RESET_STYLE_COLOUR, INVERT_COLOUR_SIZE);\n397\t}\n398\t\n399\t\n400\t\n401\t/*\n402\t * Returns -1 when unable to open the file, -2 on write error, 0 on success\n403\t * */\n404\tint flush_buffer_to_file(){\n405\t\n406\t    FILE* fp = fopen(editor_state.file_path, \"w\");\n407\t    char* line = NULL;\n408\t\n409\t    if (fp == NULL){\n410\t        return -1;\n411\t    }\n412\t\n413\t    for (int i=0; i<=editor_state.current_buffer->last_line_loc; i++){\n414\t        line = TextBufferGetLine(editor_state.current_buffer, i);\n415\t\n416\t        if (line == NULL){\n417\t            fclose(fp);\n418\t            return -2;\n419\t        }\n420\t\n421\t\n422\t        if (fputs(line, fp) < strlen(line)){\n423\t            fclose(fp);\n424\t            return -2;\n425\t        }\n426\t    }\n427\t\n428\t    fclose(fp);\n429\t    return 0;\n430\t}\n431\t\n432\t\n433\t/* Input */\n434\t/*\n435\t * read_char is heavily motivated by this tutorial: https://viewsourcecode.org/snaptoken/kilo/03.rawInputAndOutput.html\n436\t * whose code comes from kilo: http://antirez.com/news/108\n437\t * */\n438\tint read_char(){\n439\t    char c;\n440\t    ssize_t err;\n441\t\n442\t    while((err = read(STDIN_FILENO, &c, 1)) != 1) {\n443\t        if (err == EAGAIN) {\n444\t            panic(\"read_char: read() returned EAGAIN\");\n445\t        }\n446\t    }\n447\t\n448\t    // Handle escape sequences\n449\t    if (c == ESC){\n450\t        char seq[3];\n451\t\n452\t        if (read(STDIN_FILENO, &seq[0], 1) != 1) return ESC;\n453\t        if (read(STDIN_FILENO, &seq[1], 1) != 1) return ESC;\n454\t\n455\t        if (seq[0] == '[') {\n456\t            if (seq[1] >= '0' && seq[1] <= '9') {\n457\t                if (read(STDIN_FILENO, &seq[2], 1) != 1) return ESC;\n458\t                if (seq[2] == '~') {\n459\t                    switch (seq[2]) {\n460\t                        case '1': return HOME_KEY;\n461\t                        case '3': return DEL_KEY;\n462\t                        case '4': return END_KEY;\n463\t                        case '5': return PAGE_UP;\n464\t                        case '6': return PAGE_DOWN;\n465\t                        case '7': return HOME_KEY;\n466\t                        case '8': return END_KEY;\n467\t                    }\n468\t                }\n469\t            } else {\n470\t                switch (seq[1]) {\n471\t                    case 'A': return ARROW_UP;\n472\t                    case 'B': return ARROW_DOWN;\n473\t                    case 'C': return ARROW_RIGHT;\n474\t                    case 'D': return ARROW_LEFT;\n475\t                    case 'H': return HOME_KEY;\n476\t                    case 'F': return END_KEY;\n477\t                }\n478\t            }\n479\t        }\n480\t        else if (seq[0] == 'O') {\n481\t            switch (seq[1]){\n482\t                case 'H': return HOME_KEY;\n483\t                case 'F': return END_KEY;\n484\t            }\n485\t        }\n486\t\n487\t        return ESC;\n488\t\n489\t    } else {\n490\t        return c;\n491\t    }\n492\t}\n493\t\n494\t\n495\tvoid process_keypress(){\n496\t\n497\t    int c = read_char();\n498\t    int err;\n499\t\n500\t    switch (c) {\n501\t\n502\t        case '\\r':\n503\t            TextBufferNewLine(editor_state.current_buffer);\n504\t            break;\n505\t\n506\t        case ARROW_UP: up_arrow(); break;\n507\t        case ARROW_DOWN: down_arrow(); break;\n508\t        case ARROW_LEFT: left_arrow(); break;\n509\t        case ARROW_RIGHT: right_arrow(); break;\n510\t\n511\t            // We wont use these keys for now\n512\t        case PAGE_UP:\n513\t        case PAGE_DOWN:\n514\t        case HOME_KEY:\n515\t        case END_KEY:\n516\t        case DEL_KEY:\n517\t            break;\n518\t\n519\t        case CTRL_KEY('l'):\n520\t        case '\\x1b':\n521\t            break;\n522\t\n523\t            // Save buffer state to file\n524\t        case CTRL_KEY('s'):\n525\t            err = flush_buffer_to_file();\n526\t            editor_state.flushed = true;\n527\t            break;\n528\t\n529\t        case CTRL_KEY('q'):\n530\t            cleanup();\n531\t            exit(0);\n532\t            break;\n533\t\n534\t            // Backspace\n535\t        case BACKSPACE:\n536\t        case CTRL_KEY('h'):\n537\t            TextBufferBackspace(editor_state.current_buffer);\n538\t            editor_state.flushed = false;\n539\t            break;\n540\t        default:\n541\t            TextBufferInsert(editor_state.current_buffer, c);\n542\t            editor_state.flushed = false;\n543\t            break;\n544\t    }\n545\t}\n546\t\n547\t\n548\tvoid up_arrow() {\n549\t\n550\t    int col = editor_state.current_buffer->cursorCol;\n551\t    int row = editor_state.current_buffer->cursorRow;\n552\t\n553\t    if (row > 0){\n554\t        row--;\n555\t\n556\t        TextBufferMoveCursor(editor_state.current_buffer, row, col);\n557\t    }\n558\t\n559\t    // ding the terminal if you figure out how to\n560\t}\n561\t\n562\tvoid down_arrow() {\n563\t\n564\t    int col = editor_state.current_buffer->cursorCol;\n565\t    int row = editor_state.current_buffer->cursorRow;\n566\t\n567\t    if (row < editor_state.current_buffer->last_line_loc){\n568\t        row++;\n569\t\n570\t        TextBufferMoveCursor(editor_state.current_buffer, row, col);\n571\t    }\n572\t\n573\t    // ding terminal\n574\t}\n575\t\n576\tvoid left_arrow() {\n577\t    int row = editor_state.current_buffer->cursorRow;\n578\t    int col = editor_state.current_buffer->cursorCol - 1;\n579\t    TextBufferMoveCursor(editor_state.current_buffer, row, col);\n580\t}\n581\t\n582\tvoid right_arrow() {\n583\t    int row = editor_state.current_buffer->cursorRow;\n584\t    int col = editor_state.current_buffer->cursorCol + 1;\n585\t    TextBufferMoveCursor(editor_state.current_buffer, row, col);\n586\t}"}]},"parent_tool_use_id":null,"session_id":"8ad59fdc-7fe5-4314-bcde-882cd48045e4","uuid":"7e8806f3-9735-4c1d-999b-249226477d84","timestamp":"2026-05-29T19:35:21.281Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-5H5xT0/project/c_src/app/main.c","content":"#include <libgen.h>\n#include <string.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <unistd.h>\n#include <termios.h>\n#include <sys/ioctl.h>\n#include <sys/errno.h>\n#include <stdbool.h>\n#include \"../buffer/buffer.h\"\n#include \"defs.h\"\n\n#include \"visual.c\"\n\n/* Constants */\nenum specialKeys {\n    BACKSPACE = 127,\n    ARROW_UP = 1000,\n    ARROW_DOWN,\n    ARROW_LEFT,\n    ARROW_RIGHT,\n    PAGE_UP,\n    PAGE_DOWN,\n    HOME_KEY,\n    END_KEY,\n    DEL_KEY\n};\n\n/* structs */\n\n// Main state & buffers\nstruct EditorState {\n\n    // configuration states\n    struct termios orig_termios;\n\n    // File states\n    char* file_name;\n    char* file_path;         // path to file.\n    bool flushed;             // was the most recent changes flushed to disk\n\n    // buffer states\n    TextBuffer* current_buffer;\n\n    // Window states\n    struct VirtualScreen screen;\n};\n\n/* global editor state */\nstruct EditorState editor_state;\n\n\n/* prototypes */\n\n/* System and Configuration */\nvoid initialize(int argc, char* argv[]);\nvoid cleanup();\nvoid set_window_size();\nvoid disableRawMode();\nvoid enableRawMode();\n\n/* Screen Manipulation */\nvoid render_screen();\nvoid draw_screen();\nvoid draw_status_line(int line_size);\n\n\n/* Cursor Movement */\nvoid up_arrow();\nvoid down_arrow();\nvoid right_arrow();\nvoid left_arrow();\n\n/* Input */\nint read_char();\nvoid process_keypress();\n\n/* File Manipulation*/\nint flush_buffer_to_file();\nint load_file_and_initialize_buffer();\n\n\n/* Main */\nint main(int argc, char* argv[]) {\n    initialize(argc, argv);\n\n    while (1) {\n        draw_screen();\n        render_screen();\n        process_keypress();\n    }\n}\n\n\n/******************************* Implementations *********************************/\n\nvoid initialize(int argc, char* argv[]){\n\n    // Get file path information\n    // TODO: Dont attempt to load file if no path is given.\n    if (argc >= 2){\n        editor_state.file_path = argv[1];\n    }\n    else {\n        editor_state.file_path = \"Empty Buffer\";\n    }\n    editor_state.file_name = basename(editor_state.file_path);\n\n    // Loads the file and initialize the textbuffer\n    load_file_and_initialize_buffer();\n\n    // initialize screen\n    enableRawMode();\n    set_window_size();\n\n    // double the buffer for the screen to allow escape codes to be sent without overflowing\n    editor_state.screen.len = editor_state.screen.height * editor_state.screen.width * sizeof(char) * 2;\n    editor_state.screen.buffer = malloc(editor_state.screen.len);\n    editor_state.screen.buf_pos = 0;\n\n    // the line the screen starts printing from\n    editor_state.screen.render_start_line = 0;\n\n    editor_state.flushed = true;\n}\n\n/*\n * Returns:\n * -1: If there was an issue with opening the file; the buffer is still initialized as a blank buffer\n * MEM_ERROR if it wasn't successfully loaded, or there was an issue resizing/manipulating/initializing the TextBuffer.\n * */\nint load_file_and_initialize_buffer() {\n\n    // We'll open all files in read mode. If there's no file, we'll just have a blank buffer.\n    // Only when writing to file, will we rewrite or create + write to the file.\n    FILE* fp = fopen(editor_state.file_path, \"r\");\n\n    // CreateTextBufferFromFile handles NULL values so we can just pass editor_state.fp and check the return\n    editor_state.current_buffer = CreateTextBufferFromFile(fp);\n\n    if (editor_state.current_buffer == NULL){\n        return MEM_ERROR;\n    }\n\n    if (fp == NULL){\n        return -1;\n    }\n\n    fclose(fp);\n    return 0;\n}\n\nvoid cleanup(){\n\n    // Clear screen\n    write(STDOUT_FILENO, \"\\x1b[2J\", 4);\n    write(STDOUT_FILENO, \"\\x1b[H\", 3);\n\n    // free memory for screen\n    free(editor_state.screen.buffer);\n\n    // Free the text buffer\n    DestroyTextBuffer(editor_state.current_buffer);\n}\n\nvoid panic(const char* message){\n    // Clear screen\n    write(STDOUT_FILENO, \"\\x1b[2J\", 4);\n    write(STDOUT_FILENO, \"\\x1b[H\", 3);\n    // Enable cursor\n    write(STDOUT_FILENO,\"\\x1b[?25h\", 6);\n    perror(message);\n    exit(1);\n}\n\nvoid set_window_size() {\n    struct winsize ws;\n\n    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == -1 || ws.ws_col == 0) {\n        // panic(\"Failed to get window size\");\n\n        // manually get window size\n        if (write(STDOUT_FILENO, \"\\x1b[999C\\x1b[999B\", 12) != 12) {\n            panic(\"Failed to get window size\");\n        }\n\n        // read the response\n        char buf[32];\n        for (int i = 0; i < sizeof(buf); i++) {\n            if (read(STDIN_FILENO, &buf[i], 1) != 1) {\n                panic(\"Failed to get window size\");\n            }\n\n            if (buf[i] == 'R') {\n                buf[i + 1] = '\\0';\n                break;\n            }\n        }\n\n        // parse the response and set the windows size\n        if (sscanf(buf, \"%d;%d\", &editor_state.screen.height, &editor_state.screen.width) != 2) {\n            panic(\"Failed to get windows size\");\n        }\n\n    } else {\n        editor_state.screen.height = ws.ws_row;\n        editor_state.screen.width = ws.ws_col;\n    }\n}\n\nvoid disableRawMode() {\n    if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &editor_state.orig_termios) == -1) {\n        panic(\"tcsetattr\");\n    }\n}\n\n// Test raw mode\nvoid enableRawMode(){\n\n    if(tcgetattr(STDIN_FILENO, &editor_state.orig_termios) == -1) {\n        panic(\"tcgetattr\");\n    }\n\n    atexit(disableRawMode);\n\n    struct termios raw = editor_state.orig_termios;\n\n    /*\n     * Local modes:\n     * Here we are disabling:\n     * ECHO: don't echo input characters back to the screen.\n     * ICANON: canonical mode. Now each character is read as soon as it is typed.\n     * ISIG: SIGINT/SIGSTOP signal interpretation. Now Ctrl-C/Ctrl-Z won't send signals to the process.\n     * IEXTEN: extended input processing. Now Ctrl-V/Ctrl-C/Ctrl-D won't be interpreted as special characters.\n     *\n     * | - logic OR\n     * & - logic AND\n     * ~ - logic XOR\n     */\n    raw.c_lflag &= ~(ECHO | ICANON | ISIG | IEXTEN);\n\n    /*\n     * Input modes:\n     * Here we're disabling:\n     * IXON: disable software flow control.\n     * ICRNL: maps CR to NL (otherwise, it will be CR+NL). Now Ctrl-M will be ignored.\n     * BRKINT: disable break processing. Now break condition will be ignored.\n     * INPCK: disable parity checking. Now parity errors will be ignored. (This doesn't matter anymore)\n     * ISTRIP: disable stripping of eighth bit. Now eighth bit will be ignored. (This probably doesn't matter)\n     **/\n    raw.c_iflag &= ~(ICRNL | IXON | BRKINT | INPCK);\n\n    /*\n     * Output modes:\n     * Here we're disabling:\n     * OPOST: output processing. Now output processing is disabled.\n     *\n     **/\n    raw.c_oflag &= ~(OPOST);\n\n    /*\n     * Control modes:\n     * Here we're disabling:\n     * CS8: 8-bit characters. Now 8-bit characters will be used.\n     **/\n    raw.c_cflag |= (CS8);\n\n    /*\n     * c_cc - control characters.\n     * VMIN: minimum number of characters to read. Set to 0 so that we can read whatever is available.\n     * VTIME: time to wait for characters to be available. Set to 1 (100ms).\n     **/\n    raw.c_cc[VMIN] = 0;\n    raw.c_cc[VTIME] = 1;\n\n    if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw) == -1) {\n        panic(\"tcsetattr\");\n    }\n}\n\n\nvoid screen_append(const char *str, int size) {\n\n    if (editor_state.screen.buffer != NULL && (editor_state.screen.len - editor_state.screen.buf_pos) > size) {\n        memcpy(editor_state.screen.buffer + editor_state.screen.buf_pos, str, size);\n        editor_state.screen.buf_pos += size;\n    }\n}\n\n\n/* Display */\nvoid render_screen() {\n\n    // flush internal screen to display\n    write(STDOUT_FILENO, editor_state.screen.buffer, strlen(editor_state.screen.buffer));\n}\n\n\nvoid draw_screen(){\n\n    editor_state.screen.buf_pos = 0; // reset the screen\n\n    // Disable cursor\n    screen_append(\"\\x1b[?25l\", 6);\n\n    // Clear screen\n    screen_append(\"\\x1b[2J\", 4);\n\n    // Move cursor to the top\n    screen_append(\"\\x1b[H\", 3);\n\n    move_cursor_in_view(editor_state.current_buffer, &editor_state.screen);\n    draw_editor_window(editor_state.current_buffer, &editor_state.screen);\n    draw_status_line(editor_state.screen.width);\n\n    set_virtual_cursor_position(editor_state.current_buffer, &editor_state.screen);\n\n    int row = editor_state.screen.cursor.x;\n    int col = editor_state.screen.cursor.y;\n\n    char buf[32];\n    sprintf(buf, \"\\x1b[%d;%dH\", row, col);\n\n    screen_append(buf, strlen(buf));\n\n    // Enable cursor\n    screen_append(\"\\x1b[?25h\", 6);\n\n    // End the string (so we can get strlen)\n    screen_append(\"\\0\", 1);\n}\n\n\nvoid draw_status_line(int line_size) {\n\n    const char commands[] = \"Ctrl+Q-quit Ctrl+S-Save\";\n    unsigned int commands_len = sizeof commands-1;\n\n    const char modified[] = \"changed\";\n    int modified_len = sizeof modified-1;\n\n    /*\n     * {|file cursor space| |modified len|    |       controls       |\n     * [filename.c | 5,50   changed           Ctrl+Q-quit Ctrl+S-Save]\n     * */\n\n    // Calculate space for each part of the status line\n    int file_cursor_space = line_size - (commands_len + modified_len);\n    int cur_col_digits = snprintf(NULL, 0, \"%d\", editor_state.current_buffer->cursorCol);\n    int cur_row_digits = snprintf(NULL, 0, \"%d\", editor_state.current_buffer->cursorRow);\n\n    int f_name_space = file_cursor_space - (cur_col_digits + cur_row_digits + 5);\n    int file_name_size = strlen(editor_state.file_name);\n\n    int cursor_info_buffer_size = file_cursor_space - f_name_space;\n    char cursor_info_buffer[cursor_info_buffer_size];\n\n\n    // invert the colours\n    screen_append(INVERT_COLOUR, INVERT_COLOUR_SIZE);\n\n    // Write file name. If its longer than available space, we'll cut it short with ellipsis\n    if (file_name_size > f_name_space){\n        screen_append(editor_state.file_name, f_name_space - 4);\n\n        screen_append(\"... \", 4);\n\n    } else {\n        screen_append(editor_state.file_name, file_name_size);\n    }\n\n    // Write col and row info\n    sprintf(cursor_info_buffer,\n            \" | %d,%d \",\n            editor_state.current_buffer->cursorRow, editor_state.current_buffer->cursorCol);\n\n    screen_append(cursor_info_buffer, strlen(cursor_info_buffer));\n\n    // Indicate if buffer was modified since last write.\n    if (!editor_state.flushed) {\n        screen_append(modified, modified_len);\n    }\n    else {\n        memset(editor_state.screen.buffer + editor_state.screen.buf_pos, ' ', modified_len);\n        editor_state.screen.buf_pos += modified_len;\n    }\n\n    // Fill with whitespace\n    memset(editor_state.screen.buffer + editor_state.screen.buf_pos, ' ', f_name_space - file_name_size);\n    editor_state.screen.buf_pos += f_name_space - file_name_size;\n\n    // print help\n    screen_append(commands, commands_len);\n\n    // Finally reset the colour and style\n    screen_append(RESET_STYLE_COLOUR, INVERT_COLOUR_SIZE);\n}\n\n\n\n/*\n * Returns -1 when unable to open the file, -2 on write error, 0 on success\n * */\nint flush_buffer_to_file(){\n\n    FILE* fp = fopen(editor_state.file_path, \"w\");\n    char* line = NULL;\n\n    if (fp == NULL){\n        return -1;\n    }\n\n    for (int i=0; i<=editor_state.current_buffer->last_line_loc; i++){\n        line = TextBufferGetLine(editor_state.current_buffer, i);\n\n        if (line == NULL){\n            fclose(fp);\n            return -2;\n        }\n\n\n        if (fputs(line, fp) < strlen(line)){\n            fclose(fp);\n            return -2;\n        }\n    }\n\n    fclose(fp);\n    return 0;\n}\n\n\n/* Input */\n/*\n * read_char is heavily motivated by this tutorial: https://viewsourcecode.org/snaptoken/kilo/03.rawInputAndOutput.html\n * whose code comes from kilo: http://antirez.com/news/108\n * */\nint read_char(){\n    char c;\n    ssize_t err;\n\n    while((err = read(STDIN_FILENO, &c, 1)) != 1) {\n        if (err == EAGAIN) {\n            panic(\"read_char: read() returned EAGAIN\");\n        }\n    }\n\n    // Handle escape sequences\n    if (c == ESC){\n        char seq[3];\n\n        if (read(STDIN_FILENO, &seq[0], 1) != 1) return ESC;\n        if (read(STDIN_FILENO, &seq[1], 1) != 1) return ESC;\n\n        if (seq[0] == '[') {\n            if (seq[1] >= '0' && seq[1] <= '9') {\n                if (read(STDIN_FILENO, &seq[2], 1) != 1) return ESC;\n                if (seq[2] == '~') {\n                    switch (seq[2]) {\n                        case '1': return HOME_KEY;\n                        case '3': return DEL_KEY;\n                        case '4': return END_KEY;\n                        case '5': return PAGE_UP;\n                        case '6': return PAGE_DOWN;\n                        case '7': return HOME_KEY;\n                        case '8': return END_KEY;\n                    }\n                }\n            } else {\n                switch (seq[1]) {\n                    case 'A': return ARROW_UP;\n                    case 'B': return ARROW_DOWN;\n                    case 'C': return ARROW_RIGHT;\n                    case 'D': return ARROW_LEFT;\n                    case 'H': return HOME_KEY;\n                    case 'F': return END_KEY;\n                }\n            }\n        }\n        else if (seq[0] == 'O') {\n            switch (seq[1]){\n                case 'H': return HOME_KEY;\n                case 'F': return END_KEY;\n            }\n        }\n\n        return ESC;\n\n    } else {\n        return c;\n    }\n}\n\n\nvoid process_keypress(){\n\n    int c = read_char();\n    int err;\n\n    switch (c) {\n\n        case '\\r':\n            TextBufferNewLine(editor_state.current_buffer);\n            break;\n\n        case ARROW_UP: up_arrow(); break;\n        case ARROW_DOWN: down_arrow(); break;\n        case ARROW_LEFT: left_arrow(); break;\n        case ARROW_RIGHT: right_arrow(); break;\n\n            // We wont use these keys for now\n        case PAGE_UP:\n        case PAGE_DOWN:\n        case HOME_KEY:\n        case END_KEY:\n        case DEL_KEY:\n            break;\n\n        case CTRL_KEY('l'):\n        case '\\x1b':\n            break;\n\n            // Save buffer state to file\n        case CTRL_KEY('s'):\n            err = flush_buffer_to_file();\n            editor_state.flushed = true;\n            break;\n\n        case CTRL_KEY('q'):\n            cleanup();\n            exit(0);\n            break;\n\n            // Backspace\n        case BACKSPACE:\n        case CTRL_KEY('h'):\n            TextBufferBackspace(editor_state.current_buffer);\n            editor_state.flushed = false;\n            break;\n        default:\n            TextBufferInsert(editor_state.current_buffer, c);\n            editor_state.flushed = false;\n            break;\n    }\n}\n\n\nvoid up_arrow() {\n\n    int col = editor_state.current_buffer->cursorCol;\n    int row = editor_state.current_buffer->cursorRow;\n\n    if (row > 0){\n        row--;\n\n        TextBufferMoveCursor(editor_state.current_buffer, row, col);\n    }\n\n    // ding the terminal if you figure out how to\n}\n\nvoid down_arrow() {\n\n    int col = editor_state.current_buffer->cursorCol;\n    int row = editor_state.current_buffer->cursorRow;\n\n    if (row < editor_state.current_buffer->last_line_loc){\n        row++;\n\n        TextBufferMoveCursor(editor_state.current_buffer, row, col);\n    }\n\n    // ding terminal\n}\n\nvoid left_arrow() {\n    int row = editor_state.current_buffer->cursorRow;\n    int col = editor_state.current_buffer->cursorCol - 1;\n    TextBufferMoveCursor(editor_state.current_buffer, row, col);\n}\n\nvoid right_arrow() {\n    int row = editor_state.current_buffer->cursorRow;\n    int col = editor_state.current_buffer->cursorCol + 1;\n    TextBufferMoveCursor(editor_state.current_buffer, row, col);\n}","numLines":586,"startLine":1,"totalLines":586}}}
