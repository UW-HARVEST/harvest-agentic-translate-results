             screen.screen_append(\"\\x1b[K\", 3);\n143\t                    i += len_to_write;\n144\t                    lines_written += 1;\n145\t\n146\t                    // Screen full\n147\t                    if lines_written + 2 == screen_height {\n148\t                        break;\n149\t                    }\n150\t\n151\t                    if i + 1 >= chars.len() {\n152\t                        break;\n153\t                    }\n154\t                }\n155\t            } else {\n156\t                screen.screen_append(&line, line_len);\n157\t                screen.screen_append(\"\\r\\n\", 2);\n158\t                lines_written += 1;\n159\t            }\n160\t\n161\t            cur_line += 1;\n162\t        }\n163\t\n164\t        // Fill remaining with blank lines\n165\t        while lines_written + 2 < screen_height {\n166\t            screen.screen_append(\"\\r\\n\", 2);\n167\t            lines_written += 1;\n168\t        }\n169\t    }\n170\t\n171\t    pub fn set_virtual_cursor_position(buffer: &TextBuffer, screen: &mut VirtualScreen) {\n172\t        let mut current_line = screen.render_start_line;\n173\t        let mut virtual_cursor_row: i32 = 1;\n174\t        let mut required_rows: i32;\n175\t\n176\t        while current_line != buffer.cursor_row {\n177\t            let str_len = match &buffer.lines[current_line] {\n178\t                Some(gb) => gb.str_len,\n179\t                None => 0,\n180\t            };\n181\t            required_rows =\n182\t                VirtualScreen::required_screen_rows(str_len, screen.width);\n183\t            virtual_cursor_row += required_rows;\n184\t            current_line += 1;\n185\t        }\n186\t\n187\t        // Cursor wrap\n188\t        if screen.width > 0 {\n189\t            virtual_cursor_row += (buffer.cursor_col / screen.width) as i32;\n190\t            screen.cursor.x = virtual_cursor_row as usize;\n191\t            screen.cursor.y = (buffer.cursor_col % screen.width) + 1;\n192\t        } else {\