cur_line_required_rows + cumul_req_rows) > screen->height - 1) {\n                cur_line--;\n                break;\n            }\n            cumul_req_rows += cur_line_required_rows;\n            cur_line++;\n        }\n        if (buffer_cursor.x > cur_line) {\n            int rows_required = 0;\n            while (cur_line <= buffer_cursor.x) {\n                rows_required += required_screen_rows(buffer->lines[cur_line]->str_len, screen->width);\n                cur_line++;\n            }\n            while (rows_required > 0) {\n                rows_required -= required_screen_rows(buffer->lines[screen->render_start_line]->str_len, screen->width);\n                screen->render_start_line++;\n            }\n        }\n    }\n}\n\nvoid set_virtual_cursor_position(TextBuffer* buffer, struct VirtualScreen* screen) {\n    int current_line = screen->render_start_line;\n    int virtual_cursor_row = 1;\n    int required_rows;\n    while (current_line != buffer->cursorRow) {\n        required_rows = required_screen_rows(buffer->lines[current_line]->str_len, screen->width);\n        virtual_cursor_row += required_rows;\n        current_line++;\n    }\n    virtual_cursor_row += (buffer->cursorCol) / screen->width;\n    screen->cursor.x = virtual_cursor_row;\n    screen->cursor.y = (buffer->cursorCol % screen->width) + 1;\n}\n\nint main() {\n    printf(\"== required_screen_rows ==\\n\");\n    printf(\"(0, 80) = %d\\n\", required_screen_rows(0, 80));\n    printf(\"(1, 80) = %d\\n\", required_screen_rows(1, 80));\n    printf(\"(80, 80) = %d\\n\", required_screen_rows(80, 80));\n    printf(\"(81, 80) = %d\\n\", required_screen_rows(81, 80));\n    printf(\"(160, 80) = %d\\n\", required_screen_rows(160, 80));\n    printf(\"(161, 80) = %d\\n\", required_screen_rows(161, 80));\n    printf(\"(50, 25) = %d\\n\", required_screen_rows(50, 25));\n\n    // Test move_cursor_in_view and set_virtual_cursor_position\n    printf(\"\\n== virtual cursor positioning ==\\n\");\n    TextBuffer* tb = CreateTextBuffer(10, 100);\n    // Build text buffer with 5 lines of varying lengths\n    const char* lines[] = {\"hello\", \"world how are you\", \"x\", \"this is line four\", \"last\"};\n    for(int i=0;i<5;i++) {\n        const char* s = lines[i];\n        for(int j=0; s[j]; j++) TextBufferInsert(tb, s[j]);\n        if (i < 4) TextBufferNewLine(tb);\n    }\n    printf(\"After loading 5 lines: last_line_loc=%d cursorRow=%d cursorCol=%d\\n\",\n        tb->last_line_loc, tb->cursorRow, tb->cursorCol);\n\n    struct VirtualScreen screen;\n    screen.buffer = NULL;\n    screen.buf_pos = 0;\n    screen.len = 0;\n    screen.width = 20;\n    screen.height = 10;\n    screen.render_start_line = 0;\n    screen.cursor.x = 0;\n    screen.cursor.y = 0;\n\n    // Set cursor at row 4, col 4\n    TextBufferMoveCursor(tb, 4, 4);\n    move_cursor_in_view(tb, &screen);\n    set_virtual_cursor_position(tb, &screen);\n    printf(\"Test cursor(4,4) screen(20,10): cursor.x=%d cursor.y=%d render_start=%d\\n\",\n        screen.cursor.x, screen.cursor.y, screen.render_start_line);\n\n    // Set cursor at row 0, col 0\n    TextBufferMoveCursor(tb, 0, 0);\n    screen.render_start_line = 2;\n    move_cursor_in_view(tb, &screen);\n    set_virtual_cursor_position(tb, &screen);\n    printf(\"Test cursor(0,0) start=2: cursor.x=%d cursor.y=%d render_start=%d\\n\",\n        screen.cursor.x, screen.cursor.y, screen.render_start_line);\n\n    // Set cursor at row 1, col 15 (line is 17 chars, wraps once at width 20 - actually doesn't wrap)\n    // Width 20, line is 17 chars, no wrap\n    TextBufferMoveCursor(tb, 1, 15);\n    screen.render_start_line = 0;\n    move_cursor_in_view(tb, &screen);\n    set_virtual_cursor_position(tb, &screen);\n    printf(\"Test cursor(1,15) screen(20,10): cursor.x=%d cursor.y=%d render_start=%d\\n\",\n        screen.cursor.x, screen.cursor.y, screen.render_start_line);\n\n    // Test wrapping case: width=10, cursor at line 3, col 12 (line 3 = \"this is line fo