 \"abcd\", 4);\n    printf(\"len=5, append 4 bytes: buf_pos=%d content='%.*s'\\n\", s2.buf_pos, s2.buf_pos, s2.buffer);\n\n    // Test 4: NULL buffer\n    struct VS s3 = {NULL, 0, 100};\n    screen_append(&s3, \"hello\", 5);\n    printf(\"NULL buffer: buf_pos=%d\\n\", s3.buf_pos);\n\n    free(s.buffer);\n    free(s2.buffer);\n    return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":958,"cache_read_input_tokens":78742,"cache_creation":{"ephemeral_5m_input_tokens":958,"ephemeral_1h_input_tokens":0},"output_tokens":28,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8ad59fdc-7fe5-4314-bcde-882cd48045e4","uuid":"2a177084-13ae-40be-b62d-2f1bd21202f6"}
