{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011f4gkksPGEFbqPTYrN2Vkg","type":"tool_result","content":"1\t//\n2\t// Created by Anfernee Jervis on 6/29/22.\n3\t//\n4\t\n5\t#include <stdlib.h>\n6\t#include <string.h>\n7\t\n8\t#include \"gap.h\"\n9\t\n10\t\n11\t/*\n12\t * TODO: Consider rewriting this using realloc and memmove.\n13\t * helper function for copying the contents of a GapBuffer.buffer to a new buffer, with/without\n14\t * resizing the gap. This method is useful when moving the 'cursor' or when resizing a filled buffer.\n15\t * instance: GapBuffer instance\n16\t * new_capacity: The new size of the buffer. If <= original capacity, the same capacity will be used.\n17\t *\n18\t * return 0 on success or MEM_ERROR\n19\t * */\n20\tint resizeBuffer(GapBuffer* instance, int new_capacity){\n21\t\n22\t    int buffer_size = instance->str_len + instance->gap_len;\n23\t\n24\t    if (new_capacity < buffer_size){\n25\t        new_capacity = buffer_size;\n26\t    }\n27\t\n28\t    // If we increase the capacity, all the new space should go to the gap.\n29\t    int gap_size = instance->gap_len + (new_capacity - buffer_size);\n30\t\n31\t    // First malloc new buffer\n32\t    char* new_buffer = malloc(sizeof(char) * new_capacity);\n33\t\n34\t    if (new_buffer == NULL){\n35\t        return MEM_ERROR;\n36\t    }\n37\t\n38\t    // first, copy up to the start of the gap\n39\t    memcpy(new_buffer, instance->buffer, sizeof(char) * (instance->gap_loc));\n40\t\n41\t    // Copy the rest of the buffer, starting from the suffix of the gap\n42\t    memcpy(\n43\t            (new_buffer + instance->gap_loc + gap_size),                // [a, a, a, a, _, _, _, starts here>a, a, a, a]\n44\t            (instance->buffer + instance->gap_loc + instance->gap_len), // [a, a, a, a, _, starts here>a, a, a, a]\n45\t            instance->str_len - instance->gap_loc);  //  now we copy the remaining str_len - gap_loc characters\n46\t\n47\t    free(instance->buffer);\n48\t    instance->buffer = new_buffer;\n49\t    instance->gap_len = gap_size;\n50\t\n51\t    return 0;\n52\t}\n53\t\n54\t\n55\tGapBuffer* CreateGapBuffer(int capacity){\n56\t\n57\t    GapBuffer* gap_buffer = malloc(sizeof(GapBuffer));\n58\t\n59\t    if (gap_buffer == NULL){\n60\t        return NULL;\n61\t    }\n62\t\n63\t    gap_buffer->buffer = malloc(sizeof(char) * capacity);\n64\t\n65\t    if (gap_buffer->buffer == NULL){\n66\t        free(gap_buffer);\n67\t        return NULL;\n68\t    }\n69\t\n70\t    gap_buffer->gap_loc = 0;\n71\t    gap_buffer->gap_len = capacity;\n72\t    gap_buffer->str_len = 0;\n73\t\n74\t    return gap_buffer;\n75\t}\n76\t\n77\t\n78\tvoid DestroyGapBuffer(GapBuffer * instance){\n79\t    free(instance->buffer);\n80\t    free(instance);\n81\t}\n82\t\n83\t\n84\tint GapBufferInsertChar(GapBuffer* instance, char ch){\n85\t\n86\t    int errno;\n87\t\n88\t    // If the gap is about to close, resize it.\n89\t    if (instance->gap_len <= 1){\n90\t        int current_cap = instance->gap_len + instance->str_len;\n91\t        if ((errno = resizeBuffer(instance, current_cap * 2)) != 0){\n92\t            return errno;\n93\t        }\n94\t    }\n95\t\n96\t    instance->buffer[instance->gap_loc] = ch;\n97\t    instance->str_len++;\n98\t    instance->gap_loc++;\n99\t    instance->gap_len--;\n100\t\n101\t    return 0;\n102\t}\n103\t\n104\t\n105\tvoid GapBufferBackSpace(GapBuffer* instance){\n106\t\n107\t    if (instance->gap_loc > 0){\n108\t        instance->gap_loc--;\n109\t        instance->gap_len++;\n110\t        instance->str_len--;\n111\t    }\n112\t}\n113\t\n114\t\n115\tint GapBufferMoveGap(GapBuffer* instance, int location){\n116\t    if (location > instance->str_len){\n117\t        location = instance->str_len;\n118\t    }\n119\t\n120\t    if (location < 0){\n121\t        location = 0;\n122\t    }\n123\t\n124\t    int capacity = instance->gap_len + instance->str_len;\n125\t    char* new_buffer = malloc(sizeof(char) * capacity);\n126\t\n127\t    if (new_buffer == NULL){\n128\t        return MEM_ERROR;\n129\t    }\n130\t\n131\t    if (location < instance->gap_loc){\n132\t\n133\t        // here the new location is before the current gap location\n134\t        // copy up to location\n135\t        memcpy(new_buffer, instance->buffer, sizeof(char) * (location));\n136\t\n137\t        // then copy what remains up to instance.gap_loc, to the position after the gap in the new buffer\n138\t        memcpy(new_buffer + location + instance->gap_len,\n139\t               instance->buffer + location,\n140\t               sizeof(char) * (instance->gap_loc-location));\n141\t\n142\t        // copy the rest of the string\n143\t        memcpy((new_buffer + location + instance->gap_len + (instance->gap_loc-location)),\n144\t                (instance->buffer + instance->gap_loc + instance->gap_len),\n145\t               sizeof(char) * instance->str_len - instance->gap_loc);  //  now we copy the remaining str_len - gap_loc characters\n146\t    } else {\n147\t\n148\t        // here the new location is further after the current gap location\n149\t        // copy upto original gap\n150\t        memcpy(new_buffer, instance->buffer, sizeof(char) * (instance->gap_loc));\n151\t\n152\t        // copy what's left before the new location\n153\t        memcpy(new_buffer+instance->gap_loc,\n154\t               instance->buffer + instance->gap_loc + instance->gap_len,\n155\t               sizeof(char) * (location - instance->gap_loc));\n156\t\n157\t        // now copy the remaining string after the gap\n158\t        memcpy(new_buffer + location + instance->gap_len,\n159\t               instance->buffer + instance->gap_loc + instance->gap_len + (location - instance->gap_loc),\n160\t               sizeof(char) * instance->str_len - location);\n161\t    }\n162\t\n163\t    free(instance->buffer);\n164\t    instance->buffer = new_buffer;\n165\t    instance->gap_loc = location;\n166\t    return 0;\n167\t}\n168\t\n169\tchar* GapBufferGetString(GapBuffer* instance){\n170\t    char* buffer = malloc(1 + (sizeof(char) * instance->str_len));\n171\t\n172\t    if (buffer == NULL){\n173\t        return NULL;\n174\t    }\n175\t\n176\t    // Copy before gap\n177\t    memcpy(buffer, instance->buffer, instance->gap_loc);\n178\t\n179\t    // Copy after gap\n180\t    memcpy(buffer + instance->gap_loc,\n181\t           instance->buffer + instance->gap_loc + instance->gap_len,\n182\t           instance->str_len - instance->gap_loc);\n183\t\n184\t    buffer[instance->str_len] = '\\0';\n185\t\n186\t    return buffer;\n187\t}\n188\t\n189\t\n190\t\n191\t#pragma clang diagnostic push\n192\t#pragma ide diagnostic ignored \"DanglingPointer\"  // Ignore because CreateGapBuffer never returns a deallocated pointer.\n193\tGapBuffer* GapBufferSplit(GapBuffer *instance) {\n194\t    // split the current GapBuffer where the gap is.\n195\t    // Create a new GapBuffer and copy the second half of the string to the new GapBuffer\n196\t\n197\t    int capacity = instance->gap_len + instance->str_len;\n198\t    int second_half_of_str_len = instance->str_len - instance->gap_loc;\n199\t\n200\t    GapBuffer* new_gap_buffer = CreateGapBuffer(capacity);\n201\t\n202\t    if (new_gap_buffer == NULL){\n203\t        return NULL;\n204\t    }\n205\t\n206\t    // copy the second half of the string to the new GapBuffer\n207\t    // The string is copied to the location at the end of the gap in the new GapBuffer\n208\t    // |           gap             |second half of string\n209\t    memcpy(new_gap_buffer->buffer + (capacity - second_half_of_str_len),\n210\t           instance->buffer + instance->gap_loc + instance->gap_len,\n211\t           second_half_of_str_len);\n212\t\n213\t    // set str_len, gap_loc and gap_len of the new GapBuffer\n214\t    new_gap_buffer->str_len = second_half_of_str_len;\n215\t    new_gap_buffer->gap_loc = 0;\n216\t    new_gap_buffer->gap_len = capacity - second_half_of_str_len;\n217\t\n218\t\n219\t    // set str_len, gap_len of the old