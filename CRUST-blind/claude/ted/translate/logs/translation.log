{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UZ7u8qacMgqyQfhTb4rV5u","type":"tool_result","content":"1\t//\n2\t// Created by Anfernee Jervis on 8/27/22.\n3\t//\n4\t\n5\t\n6\tvoid screen_append(const char *str, int size);\n7\t\n8\t\n9\ttypedef struct Cursor {\n10\t    int x;\n11\t    int y;\n12\t} Cursor;\n13\t\n14\t\n15\tstruct VirtualScreen {\n16\t    char* buffer;           // Contents on the screen (text & escape codes)\n17\t    int buf_pos;\n18\t    int len;\n19\t    Cursor cursor;\n20\t    int width;\n21\t    int height;\n22\t    int render_start_line;\n23\t};\n24\t\n25\t/*\n26\t * Returns the number of screen rows required to print a line of the given length.\n27\t * undefined for line_length < 0\n28\t * */\n29\tint required_screen_rows(int line_length, int screen_width) {\n30\t\n31\t    // lines required is the number of times the screen width is filled len/width + 1 if there's a remainder\n32\t    if (line_length == 0) {\n33\t        return 1;\n34\t\n35\t    } else {\n36\t        return (line_length / screen_width) + ((line_length % screen_width) > 0);\n37\t    }\n38\t}\n39\t\n40\t/*\n41\t * TODO: I can retroactively calculate this in the logic in the function that moves the cursor.\n42\t * TODO: If i want to jump to file lines, I can then just call the function that moves the cursor x times\n43\t *\n44\t * TODO: After the cursor is moved to a new line, I can calculate what position the render start line needs\n45\t * to be to keep the cursor visible. If cursor is above it, shift upwards. If below, shift downwards, ensuring enough\n46\t * space for the cursor to be visible.\n47\t *\n48\t * Determines whether the cursor is off the screen, if so, shifts the display part of the buffer until\n49\t * the cursor is back in view.\n50\t * */\n51\tvoid move_cursor_in_view(TextBuffer* buffer, struct VirtualScreen* screen){\n52\t\n53\t    Cursor buffer_cursor = {buffer->cursorRow, buffer->cursorCol};\n54\t\n55\t    int cumul_req_rows = 0;\n56\t    int cur_line_required_rows;\n57\t    int cur_line = screen->render_start_line;\n58\t\n59\t\n60\t    // The entire render_start_line is guaranteed to be rendered (except the corner case where\n61\t    // its larger than the screen dimensions; a case we'll ignore for now)\n62\t    if (buffer_cursor.x < screen->render_start_line){\n63\t        screen->render_start_line = buffer_cursor.x;\n64\t    }\n65\t\n66\t    // We'll calculate the current range in the buffer that is visible\n67\t    else {\n68\t        while (cur_line <= buffer->last_line_loc) {\n69\t\n70\t            cur_line_required_rows = required_screen_rows(buffer->lines[cur_line]->str_len, screen->width);\n71\t\n72\t            if ((cur_line_required_rows + cumul_req_rows) > screen->height - 1) {\n73\t                cur_line--;\n74\t                break;\n75\t            }\n76\t\n77\t            cumul_req_rows += cur_line_required_rows;\n78\t            cur_line++;\n79\t        }\n80\t\n81\t        // If the cursor is not in view, shift the text displayed until it is\n82\t        if (buffer_cursor.x > cur_line) {\n83\t\n84\t            int rows_required = 0;\n85\t\n86\t            // Calculate required space\n87\t            while(cur_line <= buffer_cursor.x){\n88\t                rows_required += required_screen_rows(buffer->lines[cur_line]->str_len, screen->width);\n89\t                cur_line++;\n90\t            }\n91\t\n92\t\n93\t            // shift the render start line down until we've made enough room\n94\t            while (rows_required > 0){\n95\t                rows_required -= required_screen_rows(buffer->lines[screen->render_start_line]->str_len, screen->width);\n96\t                screen->render_start_line++;\n97\t\n98\t            }\n99\t        }\n100\t    }\n101\t}\n102\t\n103\t\n104\tvoid draw_editor_window(TextBuffer* buffer, struct VirtualScreen* screen){\n105\t    char* line = NULL;\n106\t    int cur_line = screen->render_start_line;\n107\t    int lines_written = 0;\n108\t    int screen_cols;\n109\t\n110\t    while (cur_line <= buffer->last_line_loc && lines_written < screen->height - 1){\n111\t\n112\t        screen_cols = screen->width;\n113\t\n114\t        // Let's draw cur_line using as many screen rows as needed.\n115\t        line = TextBufferGetLine(buffer, cur_line);\n116\t\n117\t        if (line == NULL){\n118\t            panic(\"draw editor cant get text of current line in buffer\");\n119\t        }\n120\t\n121\t        // Draw the line\n122\t        if (strlen(line) > screen_cols) {\n123\t            // Here we need multiple screen rows to draw 'line' we'll use whatever is available to draw it\n124\t\n125\t            int i=0;\n126\t            int len_to_write;\n127\t\n128\t            do {\n129\t                // if remaining line can fit in screen space, write the remaining line, else fill the remaining space\n130\t                len_to_write = screen_cols < strlen(&line[i]) ? screen_cols : strlen(&line[i]);\n131\t\n132\t                screen_append(&line[i], len_to_write);\n133\t                screen_append(\"\\r\\n\", 2); screen_append(\"\\x1b[K\", 3);\n134\t                i += len_to_write;\n135\t                lines_written++;\n136\t\n137\t                // Screen is full, lets stop\n138\t                if (lines_written == screen->height - 2){\n139\t                    break;\n140\t                }\n141\t\n142\t            } while (i < strlen(line) - 1);\n143\t\n144\t        } else {\n145\t            screen_append(line, strlen(line));\n146\t            screen_append(\"\\r\\n\", 2);\n147\t            lines_written++;\n148\t        }\n149\t\n150\t        free(line);\n151\t        cur_line++;\n152\t    }\n153\t\n154\t    // If there's remaining space, fill with blanks\n155\t    for (; lines_written < screen->height-2; lines_written++){\n156\t        screen_append(\"\\r\\n\", 2);\n157\t    }\n158\t}\n159\t\n160\t\n161\tvoid set_virtual_cursor_position(TextBuffer* buffer, struct VirtualScreen* screen){\n162\t\n163\t    int current_line = screen->render_start_line;\n164\t    int virtual_cursor_row = 1;\n165\t    int required_rows;\n166\t\n167\t    while (current_line != buffer->cursorRow){\n168\t        required_rows = required_screen_rows(buffer->lines[current_line]->str_len, screen->width);\n169\t\n170\t        virtual_cursor_row += required_rows;\n171\t        current_line++;\n172\t    }\n173\t\n174\t    // if the cursor line wraps, we need to shift the cursor down the number of times it wraps\n175\t    virtual_cursor_row += (buffer->cursorCol) / screen->width;\n176\t\n177\t    // now lets set the screen cursor x and y position\n178\t    screen->cursor.x = virtual_cursor_row;\n179\t    screen->cursor.y = (buffer->cursorCol % screen->width) + 1;\n180\t}\n181\t"}]},"parent_tool_use_id":null,"session_id":"40fecfc8-f4a6-4f0e-989a-245e461cb9f5","uuid":"2af2ac58-5e40-4471-8983-6f8cc07e6f28","timestamp":"2026-05-29T12:39:04.797Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-S5t9uV/project/c_src/app/visual.c","content":"//\n// Created by Anfernee Jervis on 8/27/22.\n//\n\n\nvoid screen_append(const char *str, int size);\n\n\ntypedef struct Cursor {\n    int x;\n    int y;\n} Cursor;\n\n\nstruct VirtualScreen {\n    char* buffer;           // Contents on the screen (text & escape codes)\n    int buf_pos;\n    int len;\n    Cursor cursor;\n    int width;\n    int height;\n    int render_start_line;\n};\n\n/*\n * Returns the number of screen rows required to print a line of the given length.\n * undefined for line_length < 0\n * */\nint required_screen_rows(int line_length, int screen_width) {\n\n    // lines required is the number of times the screen width is filled len/width + 1 if there's a remainder\n    if (line_length == 0) {\n        return 1;\n\n    } else {\n        return (line_length / screen_width) + ((line_length % screen_width) > 0);\n    }\n}\n\n/*\n * TODO: I can retroactively calculate this in the logic in the function that moves the cursor.\n * TODO: If i want to jump to file lines, I can then just call the function that moves the cursor x times\n *\n * TODO: After the cursor is moved to a new line, I can calculate what position the render start line needs\n * to be to keep the cursor visible. If cursor is above it, shift upwards. If below, shift downwards, ensuring enough\n * space for the cursor to be visible.\n *\n * Determines whether the cursor is off the screen, if so, shifts the display part of the buffer until\n * the cursor is back in view.\n * */\nvoid move_cursor_in_view(TextBuffer* buffer, struct VirtualScreen* screen){\n\n    Cursor buffer_cursor = {buffer->cursorRow, buffer->cursorCol};\n\n    int cumul_req_rows = 0;\n    int cur_line_required_rows;\n    int cur_line = screen->render_start_line;\n\n\n    // The entire render_start_line is guaranteed to be rendered (except the corner case where\n    // its larger than the screen dimensions; a case we'll ignore for now)\n    if (buffer_cursor.x < screen->render_start_line){\n        screen->render_start_line = buffer_cursor.x;\n    }\n\n    // We'll calculate the current range in the buffer that is visible\n    else {\n        while (cur_line <= buffer->last_line_loc) {\n\n            cur_line_required_rows = required_screen_rows(buffer->lines[cur_line]->str_len, screen->width);\n\n            if ((cur_line_required_rows + cumul_req_rows) > screen->height - 1) {\n                cur_line--;\n                break;\n            }\n\n            cumul_req_rows += cur_line_required_rows;\n            cur_line++;\n        }\n\n        // If the cursor is not in view, shift the text displayed until it is\n        if (buffer_cursor.x > cur_line) {\n\n            int rows_required = 0;\n\n            // Calculate required space\n            while(cur_line <= buffer_cursor.x){\n                rows_required += required_screen_rows(buffer->lines[cur_line]->str_len, screen->width);\n                cur_line++;\n            }\n\n\n            // shift the render start line down until we've made enough room\n            while (rows_required > 0){\n                rows_required -= required_screen_rows(buffer->lines[screen->render_start_line]->str_len, screen->width);\n                screen->render_start_line++;\n\n            }\n        }\n    }\n}\n\n\nvoid draw_editor_window(TextBuffer* buffer, struct VirtualScreen* screen){\n    char* line = NULL;\n    int cur_line = screen->render_start_line;\n    int lines_written = 0;\n    int screen_cols;\n\n    while (cur_line <= buffer->last_line_loc && lines_written < screen->height - 1){\n\n        screen_cols = screen->width;\n\n        // Let's draw cur_line using as many screen rows as needed.\n        line = TextBufferGetLine(buffer, cur_line);\n\n        if (line == NULL){\n            panic(\"draw editor cant get text of current line in buffer\");\n        }\n\n        // Draw the line\n        if (strlen(line) > screen_cols) {\n            // Here we need multiple screen rows to draw 'line' we'll use whatever is available to draw it\n\n            int i=0;\n            int len_to_write;\n\n            do {\n                // if remaining line can fit in screen space, write the remaining line, else fill the remaining space\n                len_to_write = screen_cols < strlen(&line[i]) ? screen_cols : strlen(&line[i]);\n\n                screen_append(&line[i], len_to_write);\n                screen_append(\"\\r\\n\", 2); screen_append(\"\\x1b[K\", 3);\n                i += len_to_write;\n                lines_written++;\n\n                // Screen is full, lets stop\n                if (lines_written == screen->height - 2){\n                    break;\n                }\n\n            } while (i < strlen(line) - 1);\n\n        } else {\n            screen_append(line, strlen(line));\n            screen_append(\"\\r\\n\", 2);\n            lines_written++;\n        }\n\n        free(line);\n        cur_line++;\n    }\n\n    // If there's remaining space, fill with blanks\n    for (; lines_written < screen->height-2; lines_written++){\n        screen_append(\"\\r\\n\", 2);\n    }\n}\n\n\nvoid set_virtual_cursor_position(TextBuffer* buffer, struct VirtualScreen* screen){\n\n    int current_line = screen->render_start_line;\n    int virtual_cursor_row = 1;\n    int required_rows;\n\n    while (current_line != buffer->cursorRow){\n        required_rows = required_screen_rows(buffer->lines[current_line]->str_len, screen->width);\n\n        virtual_cursor_row += required_rows;\n        current_line++;\n    }\n\n    // if the cursor line wraps, we need to shift the cursor down the number of times it wraps\n    virtual_cursor_row += (buffer->cursorCol) / screen->width;\n\n    // now lets set the screen cursor x and y position\n    screen->cursor.x = virtual_cursor_row;\n    screen->cursor.y = (buffer->cursorCol % screen->width) + 1;\n}\n","numLines":181,"startLine":1,"totalLines":181}}}
