    uint8_t buf[10] = {0x07, 0x00, 'm', 'f', 'a', 'b', 'c', 0x00, 0xAA, 0xBB};\n        TFVarHeader vh = {0};\n        uint8_t vd[16] = {0};\n        uint8_t *ep = NULL;\n        TFError err = TFVarHeader_read(buf, 10, &vh, vd, 16, &ep);\n        printf(\"=== TFVarHeader valid with vd ===\\n\");\n        printf(\"err=%d size=%u id=%c%c\\n\", err, vh.size, vh.id[0], vh.id[1]);\n        print_bytes(\"vd_first_3\", vd, 3);\n        printf(\"ep_offset=%ld\\n\", (long)(ep - buf));\n    }\n\n    // Test 11: TFVarHeader_read - vd NULL\n    {\n        uint8_t buf[6] = {0x05, 0x00, 'm', 'f', 'X', 0xCC};\n        TFVarHeader vh = {0};\n        uint8_t *ep = NULL;\n        TFError err = TFVarHeader_read(buf, 6, &vh, NULL, 0, &ep);\n        printf(\"=== TFVarHeader vd NULL ===\\n\");\n        printf(\"err=%d size=%u id=%c%c ep_offset=%ld\\n\",\n               err, vh.size, vh.id[0], vh.id[1], (long)(ep - buf));\n    }\n\n    // Test 12: TFVarHeader_read - bs <= 4\n    {\n        uint8_t buf[4] = {0, 0, 0, 0};\n        TFVarHeader vh = {0};\n        TFError err = TFVarHeader_read(buf, 4, &vh, NULL, 0, NULL);\n        printf(\"=== TFVarHeader bs == 4 ===\\n\");\n        printf(\"err=%d\\n\", err);\n    }\n\n    // Test 13: TFVarHeader_read - size <= 4\n    {\n        uint8_t buf[10] = {0x04, 0x00, 'm', 'f', 'a', 'b', 'c', 0x00, 0xAA, 0xBB};\n        TFVarHeader vh = {0};\n        TFError err = TFVarHeader_read(buf, 10, &vh, NULL, 0, NULL);\n        printf(\"=== TFVarHeader size == 4 ===\\n\");\n        printf(\"err=%d\\n\", err);\n    }\n\n    // Test 14: TFVarHeader_read - bs < size with vd\n    {\n        uint8_t buf[6] = {0x0A, 0x00, 'm', 'f', 'a', 'b'};\n        TFVarHeader vh = {0};\n        uint8_t vd[16] = {0};\n        TFError err = TFVarHeader_read(buf, 6, &vh, vd, 16, NULL);\n        printf(\"=== TFVarHeader bs < size ===\\n\");\n        printf(\"err=%d\\n\", err);\n    }\n\n    // Test 15: TFVarHeader_read - vs too small\n    {\n        uint8_t buf[10] = {0x08, 0x00, 'm', 'f', 1, 2, 3, 4, 0xAA, 0xBB};\n        TFVarHeader vh = {0};\n        uint8_t vd[2] = {0};\n        TFError err = TFVarHeader_read(buf, 10, &vh, vd, 2, NULL);\n        printf(\"=== TFVarHeader vs too small ===\\n\");\n        printf(\"err=%d\\n\", err);\n    }\n\n    // Test 16: TFChannelRange_read\n    {\n        uint8_t buf[8] = {0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0xFF, 0xFF};\n        TFChannelRange cr = {0};\n        uint8_t *ep = NULL;\n        TFError err = TFChannelRange_read(buf, 8, &cr, &ep);\n        printf(\"=== TFChannelRange valid ===\\n\");\n        printf(\"err=%d firstChannelNumber=0x%x channelCount=0x%x ep_offset=%ld\\n\",\n               err, cr.firstChannelNumber, cr.channelCount, (long)(ep - buf));\n    }\n\n    // Test 17: TFChannelRange_read small\n    {\n        uint8_t buf[5] = {0};\n        TFChannelRange cr = {0};\n        TFError err = TFChannelRange_read(buf, 5, &cr, NULL);\n        printf(\"=== TFChannelRange small ===\\n\");\n        printf(\"err=%d\\n\", err);\n    }\n\n    // Test 18: TFCompressionBlock_read - NULL ep\n    {\n        uint8_t buf[8] = {1,0,0,0,2,0,0,0};\n        TFCompressionBlock b = {0};\n        TFError err = TFCompressionBlock_read(buf, 8, &b, NULL);\n        printf(\"=== TFCompressionBlock null ep ===\\n\");\n        printf(\"err=%d firstFrameId=%u size=%u\\n\", err, b.firstFrameId, b.size);\n    }\n\n    return 0;\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
