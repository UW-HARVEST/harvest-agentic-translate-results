{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NxWraxofQY675mnZYt2WLE","type":"tool_result","content":"1\t/**\n2\t * libtinyfseq v3.2.0 (2024-05-19)\n3\t * https://github.com/Cryptkeeper/libtinyfseq\n4\t * MIT License\n5\t *\n6\t * `TINYFSEQ_IMPLEMENTATION` should be defined in a SINGLE C/C++ source code file to include the function implementations.\n7\t * More information on using single-file libraries: https://github.com/nothings/stb#how-do-i-use-these-libraries\n8\t */\n9\t#ifndef TINYFSEQ_H\n10\t#define TINYFSEQ_H\n11\t\n12\t#include <stdint.h>\n13\t\n14\t#define TINYFSEQ_VERSION \"3.2.0\"\n15\t\n16\ttypedef enum tf_err_t {\n17\t    TF_OK = 0,\n18\t    TF_EINVALID_MAGIC,\n19\t    TF_EINVALID_COMPRESSION_TYPE,\n20\t    TF_EINVALID_BUFFER_SIZE,\n21\t    TF_EINVALID_VAR_SIZE,\n22\t} TFError;\n23\t\n24\t/**\n25\t * `TFError_string` returns a string version of the enum name, including a comment with additional error context.\n26\t * `TFError_string` does not allocate, its return values should not be freed.\n27\t *\n28\t * @param err Unknown/invalid values will default to returning \"unknown TFError value\"\n29\t * @return A string version of the given value, never NULL\n30\t */\n31\tconst char *TFError_string(TFError err);\n32\t\n33\ttypedef enum tf_compression_type_t {\n34\t    TF_COMPRESSION_NONE,\n35\t    TF_COMPRESSION_ZSTD,\n36\t    TF_COMPRESSION_ZLIB,\n37\t} TFCompressionType;\n38\t\n39\ttypedef struct tf_header_t {\n40\t    uint16_t channelDataOffset;\n41\t    uint8_t minorVersion;\n42\t    uint8_t majorVersion;\n43\t    uint16_t variableDataOffset;\n44\t    uint32_t channelCount;\n45\t    uint32_t frameCount;\n46\t    uint8_t frameStepTimeMillis;\n47\t    enum tf_compression_type_t compressionType;\n48\t    uint8_t compressionBlockCount;\n49\t    uint8_t channelRangeCount;\n50\t    uint64_t sequenceUid;\n51\t} TFHeader;\n52\t\n53\t/**\n54\t * `TFHeader_read` selectively decodes the fields available within `TFHeader` from a given data buffer.\n55\t * The buffer should be at least 32 bytes in length (the minimum size of a FSEQ v2.0+ header).\n56\t *\n57\t * @param bd Data buffer to decode into the given `TFHeader` pointer\n58\t * @param bs Size of the data buffer (>=32)\n59\t * @param header `TFHeader` instance to decode data buffer fields into\n60\t * @param ep End pointer which upon a successful return will point to the end of the structure within `bd` (may be NULL)\n61\t * @return A `TFError` value indicating an error, if any, otherwise `TF_OK`\n62\t */\n63\tTFError\n64\tTFHeader_read(const uint8_t *bd, int bs, TFHeader *header, uint8_t **ep);\n65\t\n66\ttypedef struct tf_compression_block_t {\n67\t    uint32_t firstFrameId;\n68\t    uint32_t size;\n69\t} TFCompressionBlock;\n70\t\n71\t/**\n72\t * `TFCompressionBlock_read` decodes the fields available within `TFCompressionBlock` from a given data buffer.\n73\t * The buffer should be at least 8 bytes in length (the fixed size of an encoded compression block).\n74\t *\n75\t * @param bd Data buffer to decode into the given `TFCompressionBlock` pointer\n76\t * @param bs Size of the data buffer (>=8)\n77\t * @param block `TFCompressionBlock` instance to decode data buffer fields into\n78\t * @param ep End pointer which upon a successful return will point to the end of the structure within `bd` (may be NULL)\n79\t * @return A `TFError` value indicating an error, if any, otherwise `TF_OK`\n80\t */\n81\tTFError TFCompressionBlock_read(const uint8_t *bd,\n82\t                                int bs,\n83\t                                TFCompressionBlock *block,\n84\t                                uint8_t **ep);\n85\t\n86\ttypedef struct tf_var_header_t {\n87\t    uint16_t size;\n88\t    uint8_t id[2];\n89\t} TFVarHeader;\n90\t\n91\t/**\n92\t * `TFVarHeader_read` decodes the fields available within `TFVarHeader` from a given data buffer.\n93\t * The buffer should be at least 5 bytes in length (the minimum size of an encoded variable header).\n94\t *\n95\t * An additional data buffer (`vd`) is used to store the decoded variable value (compared to `TFVarHeader` which\n96\t * only contains the header fields). A NULL `vd` value will skip this decoding step.\n97\t *\n98\t * @param bd Data buffer to decode into the given `TFVarHeader` pointer\n99\t * @param bs Size of the data buffer (>=6)\n100\t * @param varHeader `TFVarHeader` instance to decode data buffer fields into\n101\t * @param vd Optional data buffer for storing the corresponding value of the variable header (may be NULL)\n102\t * @param vs Size of the optional data buffer\n103\t * @param ep End pointer which upon a successful return will point to the end of the structure within `bd` (may be NULL)\n104\t * @return A `TFError` value indicating an error, if any, otherwise `TF_OK`\n105\t */\n106\tTFError TFVarHeader_read(const uint8_t *bd,\n107\t                         int bs,\n108\t                         TFVarHeader *varHeader,\n109\t                         uint8_t *vd,\n110\t                         int vs,\n111\t                         uint8_t **ep);\n112\t\n113\ttypedef struct tf_channel_range_t {\n114\t    uint32_t firstChannelNumber;\n115\t    uint32_t channelCount;\n116\t} TFChannelRange;\n117\t\n118\t/**\n119\t * `TFChannelRange_Read` decodes the fields available within `TFChannelRange` from a given data buffer.\n120\t * The buffer should be at least 6 bytes in length (the fixed size of an encoded channel range).\n121\t *\n122\t * @param bd Data buffer to decode into the given `TFChannelRange` pointer\n123\t * @param bs Size of the data buffer (>=6)\n124\t * @param channelRange `TFChannelRange` instance to decode data buffer fields into\n125\t * @param ep End pointer which upon a successful return will point to the end of the structure within `bd` (may be NULL)\n126\t * @return A `TFError` value indicating an error, if any, otherwise `TF_OK`\n127\t */\n128\tTFError TFChannelRange_read(const uint8_t *bd,\n129\t                            int bs,\n130\t                            TFChannelRange *channelRange,\n131\t                            uint8_t **ep);\n132\t\n133\t#endif//TINYFSEQ_H\n134\t\n135\t#ifdef TINYFSEQ_IMPLEMENTATION\n136\t\n137\tconst char *TFError_string(const TFError err) {\n138\t    switch (err) {\n139\t        case TF_OK:\n140\t            return \"TF_OK (ok)\";\n141\t        case TF_EINVALID_MAGIC:\n142\t            return \"TF_EINVALID_MAGIC (invalid magic file signature)\";\n143\t        case TF_EINVALID_COMPRESSION_TYPE:\n144\t            return \"TF_EINVALID_COMPRESSION_TYPE (unknown compression \"\n145\t                   \"identifier)\";\n146\t        case TF_EINVALID_BUFFER_SIZE:\n147\t            return \"TF_EINVALID_BUFFER_SIZE (undersized data decoding buffer \"\n148\t                   \"argument)\";\n149\t        case TF_EINVALID_VAR_SIZE:\n150\t            return \"TF_EINVALID_VAR_SIZE (invalid variable size in header)\";\n151\t        default:\n152\t            return \"unknown TFError value\";\n153\t    }\n154\t}\n155\t\n156\tstatic int TFCompressionType_valid(const uint8_t b) {\n157\t    switch (b) {\n158\t        case TF_COMPRESSION_NONE:\n159\t        case TF_COMPRESSION_ZSTD:\n160\t        case TF_COMPRESSION_ZLIB:\n161\t            return 1;\n162\t        default:\n163\t            return 0;\n164\t    }\n165\t}\n166\t\n167\tTFError TFHeader_read(const uint8_t *const bd,\n168\t                      const int bs,\n169\t                      TFHeader *const header,\n170\t                      uint8_t **const ep) {\n171\t    // header structure is a fixed 32 byte size according to schema\n172\t    // https://github.com/Cryptkeeper/fseq-file-format#header\n173\t    const int HEADER_SIZE = 32;\n174\t\n175\t    if (bs < HEADER_SIZE) return TF_EINVALID_BUFFER_SIZE;\n176\t\n177\t    if (bd[0] != 'P' || bd[1] != 'S' || bd[2] != 'E' || bd[3] != 'Q')\n178\t        return TF_EINVALID_MAGIC;\n179\t\n180\t    __builtin_memcpy(&header->channelDataOffset, &bd[4],\n181\t           