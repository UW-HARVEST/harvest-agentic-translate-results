{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01273D7WvNAZ4SxAJURtqa4m","type":"tool_result","content":"1\t// Import necessary modules\n2\tuse crate::{string_t};\n3\t// Constants\n4\tpub const STRING_T_INDEXES_BUFFER_SIZE: usize = 512;\n5\tpub const STRING_T_SPACE_CHARS_ARR: &str = \" \\t\\n\\r\";\n6\t// Type Definitions\n7\tpub type BoolT = bool;\n8\t#[derive(Clone)]\n9\tpub struct StringT {\n10\t    pub bytes: Vec<u8>,\n11\t    pub size: usize,\n12\t}\n13\tpub type StringTArray = Vec<StringT>;\n14\t// Function Declarations\n15\tpub fn new_string(size: usize) -> StringT {\n16\t    StringT {\n17\t        bytes: vec![0u8; size],\n18\t        size,\n19\t    }\n20\t}\n21\tpub fn new_string_from_bytes(bytes: &str) -> StringT {\n22\t    let b = bytes.as_bytes().to_vec();\n23\t    let size = b.len();\n24\t    StringT { bytes: b, size }\n25\t}\n26\tpub fn string_free(_str: StringT) {\n27\t    // In Rust, dropping handles deallocation automatically.\n28\t}\n29\tpub fn string_len(str: &StringT) -> usize {\n30\t    str.size\n31\t}\n32\tpub fn string_bytes(str: &StringT) -> &str {\n33\t    let end = str.size.min(str.bytes.len());\n34\t    std::str::from_utf8(&str.bytes[..end]).unwrap_or(\"\")\n35\t}\n36\tpub fn string_eq(left: &StringT, right: &StringT) -> BoolT {\n37\t    if left.size != right.size {\n38\t        return false;\n39\t    }\n40\t    let l_end = left.size.min(left.bytes.len());\n41\t    let r_end = right.size.min(right.bytes.len());\n42\t    left.bytes[..l_end] == right.bytes[..r_end]\n43\t}\n44\tpub fn string_copy(str: &StringT) -> StringT {\n45\t    let mut copied = new_string(str.size);\n46\t    let end = str.size.min(str.bytes.len());\n47\t    copied.bytes[..end].copy_from_slice(&str.bytes[..end]);\n48\t    copied\n49\t}\n50\tpub fn string_concat(first: &StringT, second: &StringT) -> StringT {\n51\t    let total = first.size + second.size;\n52\t    let mut new_str = new_string(total);\n53\t    let f_end = first.size.min(first.bytes.len());\n54\t    let s_end = second.size.min(second.bytes.len());\n55\t    new_str.bytes[..f_end].copy_from_slice(&first.bytes[..f_end]);\n56\t    new_str.bytes[first.size..first.size + s_end].copy_from_slice(&second.bytes[..s_end]);\n57\t    new_str\n58\t}\n59\tpub fn string_substr(str: &StringT, pos: usize, len: usize) -> StringT {\n60\t    let mut sub = new_string(len);\n61\t    for idx in 0..len {\n62\t        let src_idx = pos + idx;\n63\t        if src_idx < str.bytes.len() {\n64\t            sub.bytes[idx] = str.bytes[src_idx];\n65\t        } else {\n66\t            sub.bytes[idx] = 0;\n67\t        }\n68\t    }\n69\t    sub\n70\t}\n71\tpub fn string_startswith(str: &StringT, prefix: &str) -> BoolT {\n72\t    let prefix_bytes = prefix.as_bytes();\n73\t    if str.size < prefix_bytes.len() {\n74\t        return false;\n75\t    }\n76\t    let exp_prefix = new_string_from_bytes(prefix);\n77\t    let str_prefix = string_substr(str, 0, exp_prefix.size);\n78\t    string_eq(&str_prefix, &exp_prefix)\n79\t}\n80\tpub fn string_endswith(str: &StringT, suffix: &str) -> BoolT {\n81\t    let suffix_bytes = suffix.as_bytes();\n82\t    if str.size < suffix_bytes.len() {\n83\t        return false;\n84\t    }\n85\t    let exp_suffix = new_string_from_bytes(suffix);\n86\t    let str_suffix = string_substr(str, str.size - exp_suffix.size, exp_suffix.size);\n87\t    string_eq(&str_suffix, &exp_suffix)\n88\t}\n89\tpub fn string_find(str: &StringT, chars: &str) -> Option<usize> {\n90\t    let chars_str = new_string_from_bytes(chars);\n91\t    if chars_str.size == 0 {\n92\t        return Some(0);\n93\t    }\n94\t    if chars_str.size > str.size {\n95\t        return None;\n96\t    }\n97\t    for pos in 0..=(str.size - chars_str.size) {\n98\t        let sub_str = string_substr(str, pos, chars_str.size);\n99\t        if string_eq(&sub_str, &chars_str) {\n100\t            return Some(pos);\n101\t        }\n102\t    }\n103\t    None\n104\t}\n105\tpub fn string_strip(str: &StringT) -