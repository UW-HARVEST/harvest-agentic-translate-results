{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012Ak41vWUApqvZzbgAEthyc","type":"tool_result","content":"1\t/*\n2\t    MIT License\n3\t\n4\t    Copyright (c) 2023 Ivan Korotaev <vnkrtv@yandex.ru>\n5\t\n6\t    Permission is hereby granted, free of charge, to any person obtaining a copy\n7\t    of this software and associated documentation files (the \"Software\"), to deal\n8\t    in the Software without restriction, including without limitation the rights\n9\t    to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n10\t    copies of the Software, and to permit persons to whom the Software is\n11\t    furnished to do so, subject to the following conditions:\n12\t\n13\t    The above copyright notice and this permission notice shall be included in all\n14\t    copies or substantial portions of the Software.\n15\t\n16\t    THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n17\t    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n18\t    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n19\t    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n20\t    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n21\t    OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n22\t    SOFTWARE.\n23\t */\n24\t#include <stdio.h>\n25\t#include <assert.h>\n26\t\n27\t\n28\t#include \"../src/string_t.h\"\n29\t\n30\t#define DUMP_STRING(str) \\\n31\t    fprintf(stderr, \"string_t(bytes=\\\"%s\\\", size=%zu)\", str->bytes, str->size)\n32\t#define LOG_STRING(arg, str) \\\n33\t    fprintf(stderr, \"%s=\", arg); \\\n34\t    DUMP_STRING(str); \\\n35\t    fprintf(stderr, \"\\n\")\n36\t\n37\t/* Simple linked list C implementation. */\n38\ttypedef struct node_t {\n39\t    struct node_t *next;\n40\t    void *value;\n41\t} node_t;\n42\t\n43\tnode_t *new_node(void *);\n44\t\n45\tnode_t *add_node(node_t *, void *);\n46\t\n47\tnode_t *new_node(void *value) {\n48\t    node_t *created_node = malloc(sizeof(node_t));\n49\t    created_node->next = NULL;\n50\t    created_node->value = value;\n51\t    return created_node;\n52\t}\n53\t\n54\tnode_t *add_node(node_t *node, void *value) {\n55\t    node_t *created_node = new_node(value);\n56\t    created_node->next = NULL;\n57\t    created_node->value = value;\n58\t\n59\t    node->next = created_node;\n60\t    return created_node;\n61\t}\n62\t\n63\tvoid node_free(node_t *node) {\n64\t    if (node->value != NULL) {\n65\t        free(node->value);\n66\t    }\n67\t    free(node);\n68\t}\n69\t\n70\t/*\n71\t * Test structures\n72\t */\n73\ttypedef void (*test_func_t)(void);\n74\t\n75\t/* Test struct. */\n76\ttypedef struct test_t {\n77\t    test_func_t test;\n78\t    char *description;\n79\t} test_t;\n80\t\n81\tvoid test_free(test_t *test) {\n82\t    free(test->description);\n83\t}\n84\t\n85\t/* Struct for organizing test running. */\n86\ttypedef struct test_runner_t {\n87\t    node_t *first_test;\n88\t    node_t *last_test;\n89\t} test_runner_t;\n90\t\n91\t/* Create new test runner. */\n92\ttest_runner_t new_runner();\n93\t\n94\t/* Register test for test runner. */\n95\tvoid register_test(test_runner_t *, test_func_t, char *);\n96\t\n97\t/* Run registered tests. */\n98\tint run_tests(test_runner_t *);\n99\t\n100\t/* Free test runner. */\n101\tvoid runner_free(test_runner_t *);\n102\t\n103\ttest_runner_t new_runner() {\n104\t    test_runner_t runner;\n105\t    runner.first_test = NULL;\n106\t    runner.last_test = NULL;\n107\t    return runner;\n108\t}\n109\t\n110\tvoid register_test(test_runner_t *test_runner, test_func_t test, char *description) {\n111\t    test_t *new_test = malloc(sizeof(test_t));\n112\t    new_test->test = test;\n113\t    new_test->description = malloc(strlen(description));\n114\t    strcpy(new_test->description, description);\n115\t    if (test_runner->first_test == NULL) {\n116\t        test_runner->first_test = new_node(new_test);\n117\t        test_runner->last_test = test_runner->first_test;\n118\t    } else {\n119\t        test_runner->last_test = add_node(test_runner->last_test, new_test);\n120\t    }\n121\t}\n122\t\n123\tint run_tests(test_runner_t *test_runner) {\n124\t    node_t *cur_test = test_runner->first_test;\n125\t    while (cur_test != NULL) {\n126\t        test_t *test = (test_t *) cur_test->value;\n127\t        test->test();\n128\t        printf(\"%s: OK\\n\", test->description);\n129\t        cur_test = cur_test->next;\n130\t    }\n131\t    return 0;\n132\t}\n133\t\n134\tvoid runner_free(test_runner_t *test_runner) {\n135\t    node_t *cur_test = test_runner->first_test;\n136\t    while (cur_test != NULL) {\n137\t        test_t *test = (test_t *) cur_test->value;\n138\t        test_free(test);\n139\t        node_t *node = cur_test;\n140\t        cur_test = cur_test->next;\n141\t        node_free(node);\n142\t    }\n143\t}\n144\t\n145\t/*\n146\t * string_t tests\n147\t */\n148\tvoid string_arr_free(STRING_T_ARRAY str_arr, size_t size) {\n149\t    for (size_t idx = 0; idx < size; ++idx) {\n150\t        string_free(str_arr[idx]);\n151\t    }\n152\t}\n153\t\n154\tvoid test_new_string(void) {\n155\t    size_t sizes[] = {0, 1, 2, 3, 12, 100};\n156\t    for (size_t idx = 0; idx < 5; ++idx) {\n157\t        string_t *str = new_string(sizes[idx]);\n158\t        assert(str->size == sizes[idx]);\n159\t        string_free(str);\n160\t    }\n161\t}\n162\t\n163\tvoid test_new_string_from_bytes(void) {\n164\t    char *bytes[] = {\"\", \"test\", \"some another test\"};\n165\t    for (size_t idx = 0; idx < 3; ++idx) {\n166\t        string_t *str = new_string_from_bytes(bytes[idx]);\n167\t        assert(str->size == strlen(bytes[idx]));\n168\t        assert(strcmp(str->bytes, bytes[idx]) == 0);\n169\t        string_free(str);\n170\t    }\n171\t}\n172\t\n173\tvoid test_string_len(void) {\n174\t    char *bytes[] = {\"\", \"test\", \"some another test\"};\n175\t    size_t len[] = {0, 4, 17};\n176\t    for (size_t idx = 0; idx < 3; ++idx) {\n177\t        string_t *str = new_string_from_bytes(bytes[idx]);\n178\t        assert(str->size == strlen(bytes[idx]));\n179\t        assert(string_len(str) == len[idx]);\n180\t        string_free(str);\n181\t    }\n182\t}\n183\t\n184\tvoid test_string_bytes(void) {\n185\t    char *bytes[] = {\"\", \"test\", \"some another test\"};\n186\t    for (size_t idx = 0; idx < 3; ++idx) {\n187\t        string_t *str = new_string_from_bytes(bytes[idx]);\n188\t        char *str_bytes = string_bytes(str);\n189\t        assert(strcmp(str_bytes, bytes[idx]) == 0);\n190\t        string_free(str);\n191\t        free(str_bytes);\n192\t    }\n193\t}\n194\t\n195\tvoid test_string_eq(void) {\n196\t    char *left_bytes[] = {\"\", \"\\n\\n\", \"test\", \"some another test\"};\n197\t    char *right_bytes[] = {\"\", \"\\n\\n\", \"test\", \"some another test\"};\n198\t\n199\t    for (size_t idx = 0; idx < 4; ++idx) {\n200\t        string_t *left_str = new_string_from_bytes(left_bytes[idx]);\n201\t        string_t *right_str = new_string_from_bytes(right_bytes[idx]);\n202\t\n203\t        assert(left_str->size == right_str->size);\n204\t        assert(strcmp(left_str->bytes, right_str->bytes) == 0);\n205\t\n206\t        string_free(left_str);\n207\t        string_free(right_str);\n208\t    }\n209\t}\n210\t\n211\tvoid test_string_copy(void) {\n212\t    char *bytes[] = {\"\", \"test\", \"some another test\"};\n213\t    for (size_t idx = 0; idx < 3; ++idx) {\n214\t        string_t *str = new_string_from_bytes(bytes[idx]);\n215\t        string_t *str_copy = string_copy(str);\n216\t\n217\t        assert(string_eq(str, str_copy) == true);\n218\t\n219\t        string_free(str);\n220\t        string_free(str_copy);\n221\t    }\n222\t}\n223\t\n224\tvoid test_string_concat(void) {\n225\t    char *first[] = {\"\", \"first\", \"some another\"};\n226\t    char *second[] = {\"\", \"second\", \" test\"};\n227\t    char *res[] = {\"\", \"firstsecond\", \"some another test\"};\n228\t    for (size_t idx = 0; idx < 3; ++idx) {\n229\t        string_t *first_str = new_string_from_bytes(first[idx]);\n230\t        string_t *second_str = new_string_from_bytes(second[idx]);\n231\t        string_t *res_str = new_string_from_bytes(res[idx]);\n232\t        string_t *concat_str = string_concat(first_str, second_str);\n233\t\n234\t        assert(string_eq(concat_str, res_str) == true);\n235\t\n236\t        string_free(first_str);\n237\t        string_free(second_str);\n238\t        string_free(res_str);\n239\t        string_free(concat_str);\n240\t    }\n241\t}\n242\t\n243\tvoid test_string_strip(void) {\n244\t    char *bytes[] = {\"\", \"vfv\\n\\n\", \"  test\\t\", \" some another test  \"};\n245\t    char *stripped_bytes[] = {\"\", \"vfv\", \"test\", \"some another test\"};\n246\t\n247\t    for (size_t idx = 0; idx < 4; ++idx) {\n248\t        string_t *str = new_string_from_bytes(bytes[idx]);\n249\t        string_t *stripped_str =  string_strip(str);\n250\t        string_t *exp_stripped_str = new_string_from_bytes(stripped_bytes[idx]);\n251\t\n252\t        assert(string_eq(stripped_str, exp_stripped_str) == true);\n253\t\n254\t        string_free(str);\n255\t        string_free(stripped_str);\n256\t        string_free(exp_stripped_str);\n257\t    }\n258\t}\n259\t\n260\tvoid test_string_substr(void) {\n261\t    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \" some another test  \"};\n262\t    size_t substr_start_pos[] = {0, 1, 5, 0};\n263\t    size_t substr_len[] = {0, 2, 3, 5};\n264\t    char *substr_bytes[] = {\"\", \"fv\", \"str\", \" some\"};\n265\t\n266\t    for (size_t idx = 0; idx < 4; ++idx) {\n267\t        string_t *str = new_string_from_bytes(bytes[idx]);\n268\t        string_t *substr_str = string_substr(str, substr_start_pos[idx], substr_len[idx]);\n269\t        string_t *expected_substr_str = new_string_from_bytes(substr_bytes[idx]);\n270\t\n271\t        assert(string_eq(substr_str, expected_substr_str) == true);\n272\t\n273\t        string_free(str);\n274\t        string_free(substr_str);\n275\t        string_free(expected_substr_str);\n276\t    }\n277\t}\n278\t\n279\tvoid test_string_startswith(void) {\n280\t    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \" some another test  \", \"1234\"};\n281\t    char *startswith_bytes[] = {\"\", \"vfv\", \"test string\", \" some\", \"2\"};\n282\t    bool_t res[] = {true, true, true, true, false};\n283\t\n284\t    for (size_t idx = 0; idx < 5; ++idx) {\n285\t        string_t *str = new_string_from_bytes(bytes[idx]);\n286\t        assert(string_startswith(str, startswith_bytes[idx]) == res[idx]);\n287\t        string_free(str);\n288\t    }\n289\t}\n290\t\n291\tvoid test_string_endswith(void) {\n292\t    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \" some another test  \", \"1234\"};\n293\t    char *endswith_bytes[] = {\"\", \"fv\\n\\n\", \"test string\", \"test  \", \"2\"};\n294\t    bool_t res[] = {true, true, true, true, false};\n295\t\n296\t    for (size_t idx = 0; idx < 5; ++idx) {\n297\t        string_t *str = new_string_from_bytes(bytes[idx]);\n298\t        assert(string_endswith(str, endswith_bytes[idx]) == res[idx]);\n299\t        string_free(str);\n300\t    }\n301\t}\n302\t\n303\tvoid test_string_find(void) {\n304\t    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \"test string\", \" some another test  \"};\n305\t    char *chars[] = {\"\", \"\\n\", \"no\", \"\", \"another\"};\n306\t    int expected_pos[] = {0, 3, -1, 0, 6};\n307\t\n308\t    for (size_t idx = 0; idx < 5; ++idx) {\n309\t        string_t *str = new_string_from_bytes(bytes[idx]);\n310\t        assert(string_find(str, chars[idx]) == expected_pos[idx]);\n311\t        string_free(str);\n312\t    }\n313\t}\n314\t\n315\t#ifndef _WIN32\n316\t\n317\tvoid test_string_split(void) {\n318\t    char *bytes[] = {\n319\t            \"\",\n320\t            \"1\",\n321\t            \"some\",\n322\t            \" some string 124!\",\n323\t            \"Some github account: vnkrtv\"\n324\t    };\n325\t    size_t expected_arr_size[] = {\n326\t            1,\n327\t            1,\n328\t            1,\n329\t            4,\n330\t            4\n331\t    };\n332\t\n333\t    string_t *first_arr[] = {\n334\t            new_string_from_bytes(\"\")\n335\t    };\n336\t    string_t *second_arr[] = {\n337\t            new_string_from_bytes(\"1\")\n338\t    };\n339\t    string_t *third_arr[] = {\n340\t            new_string_from_bytes(\"some\")\n341\t    };\n342\t    string_t *fourth_arr[] = {\n343\t            new_string_from_bytes(\"\"),\n344\t            new_string_from_bytes(\"some\"),\n345\t            new_string_from_bytes(\"string\"),\n346\t            new_string_from_bytes(\"124!\")\n347\t    };\n348\t    string_t *fifth_arr[] = {\n349\t            new_string_from_bytes(\"Some\"),\n350\t            new_string_from_bytes(\"github\"),\n351\t            new_string_from_bytes(\"account:\"),\n352\t            new_string_from_bytes(\"vnkrtv\")\n353\t    };\n354\t    STRING_T_ARRAY arr_expected[] = {first_arr, second_arr, third_arr, fourth_arr, fifth_arr};\n355\t\n356\t    for (size_t idx = 0; idx < 5; ++idx) {\n357\t        string_t *str = new_string_from_bytes(bytes[idx]);\n358\t\n359\t        size_t arr_size = 0;\n360\t        STRING_T_ARRAY str_arr = string_split(str, &arr_size);\n361\t        STRING_T_ARRAY expected_str_arr = arr_expected[idx];\n362\t\n363\t        assert(arr_size == expected_arr_size[idx]);\n364\t        for (size_t arr_idx = 0; arr_idx < expected_arr_size[idx]; ++arr_idx) {\n365\t            if (string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) != true) {\n366\t                LOG_STRING(\"str_arr[arr_idx]\", str_arr[arr_idx]);\n367\t                LOG_STRING(\"expected_str_arr[arr_idx]\", expected_str_arr[arr_idx]);\n368\t                assert(string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) == true);\n369\t            }\n370\t        }\n371\t        string_free(str);\n372\t        string_arr_free(str_arr, arr_size);\n373\t        free(str_arr);\n374\t    }\n375\t\n376\t    string_arr_free(first_arr, 1);\n377\t    string_arr_free(second_arr, 1);\n378\t    string_arr_free(third_arr, 1);\n379\t    string_arr_free(fourth_arr, 4);\n380\t    string_arr_free(fifth_arr, 4);\n381\t}\n382\t\n383\tvoid test_string_split_by(void) {\n384\t    const char split_by_chars[] = \"W\";\n385\t    char *bytes[] = {\n386\t            \"\",\n387\t            \"1\",\n388\t            \"some\",\n389\t            \"WsomeWstringW124!\",\n390\t            \"SomeWgithubWaccount:Wvnkrtv\"\n391\t    };\n392\t    size_t expected_arr_size[] = {\n393\t            1,\n394\t            1,\n395\t            1,\n396\t            4,\n397\t            4\n398\t    };\n399\t\n400\t    string_t *first_arr[] = {\n401\t            new_string_from_bytes(\"\")\n402\t    };\n403\t    string_t *second_arr[] = {\n404\t            new_string_from_bytes(\"1\")\n405\t    };\n406\t    string_t *third_arr[] = {\n407\t            new_string_from_bytes(\"some\")\n408\t    };\n409\t    string_t *fourth_arr[] = {\n410\t            new_string_from_bytes(\"\"),\n411\t            new_string_from_bytes(\"some\"),\n412\t            new_string_from_bytes(\"string\"),\n413\t            new_string_from_bytes(\"124!\")\n414\t    };\n415\t    string_t *fifth_arr[] = {\n416\t            new_string_from_bytes(\"Some\"),\n417\t            new_string_from_bytes(\"github\"),\n418\t            new_string_from_bytes(\"account:\"),\n419\t            new_string_from_bytes(\"vnkrtv\")\n420\t    };\n421\t    string_t **arr_expected[] = {first_arr, second_arr, third_arr, fourth_arr, fifth_arr};\n422\t\n423\t    for (size_t idx = 0; idx < 5; ++idx) {\n424\t        string_t *str = new_string_from_bytes(bytes[idx]);\n425\t\n426\t        size_t arr_size = 0;\n427\t        STRING_T_ARRAY str_arr = string_split_by(str, &arr_size, split_by_chars);\n428\t        STRING_T_ARRAY expected_str_arr = arr_expected[idx];\n429\t\n430\t        assert(arr_size == expected_arr_size[idx]);\n431\t        for (size_t arr_idx = 0; arr_idx < expected_arr_size[idx]; ++arr_idx) {\n432\t            if (string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) != true) {\n433\t                LOG_STRING(\"str_arr[arr_idx]\", str_arr[arr_idx]);\n434\t                LOG_STRING(\"expected_str_arr[arr_idx]\", expected_str_arr[arr_idx]);\n435\t                assert(string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) == true);\n436\t            }\n437\t        }\n438\t\n439\t        string_free(str);\n440\t        string_arr_free(str_arr, arr_size);\n441\t        free(str_arr);\n442\t    }\n443\t\n444\t    string_arr_free(first_arr, 1);\n445\t    string_arr_free(second_arr, 1);\n446\t    string_arr_free(third_arr, 1);\n447\t    string_arr_free(fourth_arr, 4);\n448\t    string_arr_free(fifth_arr, 4);\n449\t}\n450\t\n451\t#endif\n452\t\n453\tvoid test_string_join_arr(void) {\n454\t    string_t *first_arr[] = {\n455\t            new_string_from_bytes(\"\")\n456\t    };\n457\t    string_t *second_arr[] = {\n458\t            new_string_from_bytes(\"1\")\n459\t    };\n460\t    string_t *third_arr[] = {\n461\t            new_string_from_bytes(\"some\"),\n462\t            new_string_from_bytes(\"string\")\n463\t    };\n464\t    string_t *fourth_arr[] = {\n465\t            new_string_from_bytes(\"\"),\n466\t            new_string_from_bytes(\"some\"),\n467\t            new_string_from_bytes(\"string\")\n468\t    };\n469\t    string_t *fifth_arr[] = {\n470\t            new_string_from_bytes(\"some\"),\n471\t            new_string_from_bytes(\"string\")\n472\t    };\n473\t    STRING_T_ARRAY str_arr[] = {first_arr, second_arr, third_arr, fourth_arr, fifth_arr};\n474\t    size_t arr_size[] = {1, 1, 2, 3, 2};\n475\t\n476\t    char *space_chars[] = {\n477\t            \" \",\n478\t            \" \",\n479\t            \" \",\n480\t            \"\\n\",\n481\t            \"SOME\"\n482\t    };\n483\t    string_t *expected_res_str[] = {\n484\t            new_string_from_bytes(\"\"),\n485\t            new_string_from_bytes(\"1\"),\n486\t            new_string_from_bytes(\"some string\"),\n487\t            new_string_from_bytes(\"\\nsome\\nstring\"),\n488\t            new_string_from_bytes(\"someSOMEstring\")\n489\t    };\n490\t\n491\t\n492\t    for (size_t idx = 0; idx < 5; ++idx) {\n493\t        const STRING_T_ARRAY arr = (const STRING_T_ARRAY) str_arr[idx];\n494\t        string_t *res_str = string_join_arr(arr, arr_size[idx], space_chars[idx]);\n495\t\n496\t        assert(string_eq(res_str, expected_res_str[idx]) == true);\n497\t\n498\t        string_free(res_str);\n499\t    }\n500\t\n501\t    string_arr_free(first_arr, 1);\n502\t    string_arr_free(second_arr, 1);\n503\t    string_arr_free(third_arr, 2);\n504\t    string_arr_free(fourth_arr, 3);\n505\t    string_arr_free(fifth_arr, 2);\n506\t    string_arr_free(expected_res_str, 5);\n507\t}\n508\t\n509\tint main() {\n510\t    test_runner_t runner = new_runner();\n511\t\n512\t    register_test(&runner, &test_new_string, \"Test new_string\");\n513\t    register_test(&runner, &test_new_string_from_bytes, \"Test new_string_from_bytes\");\n514\t    register_test(&runner, &test_string_len, \"Test string_len\");\n515\t    register_test(&runner, &test_string_bytes, \"Test string_bytes\");\n516\t    register_test(&runner, &test_string_eq, \"Test string_eq\");\n517\t    register_test(&runner, &test_string_copy, \"Test string_copy\");\n518\t    register_test(&runner, &test_string_concat, \"Test string_concat\");\n519\t    register_test(&runner, &test_string_substr, \"Test string_substr\");\n520\t    register_test(&runner, &test_string_startswith, \"Test string_startswith\");\n521\t    register_test(&runner, &test_string_endswith, \"Test string_endswith\");\n522\t    register_test(&runner, &test_string_find, \"Test string_find\");\n523\t    register_test(&runner, &test_string_strip, \"Test string_strip\");\n524\t#ifndef _WIN32\n525\t    register_test(&runner, &test_string_split, \"Test string_split\");\n526\t    register_test(&runner, &test_string_split_by, \"Test string_split_by\");\n527\t#endif\n528\t    register_test(&runner, &test_string_join_arr, \"Test test_string_join_arr\");\n529\t\n530\t    run_tests(&runner);\n531\t    runner_free(&runner);\n532\t\n533\t    return 0;\n534\t}"}]},"parent_tool_use_id":null,"session_id":"de680243-d2ff-4de6-8d8d-29227dc834db","uuid":"e0f59e7f-dd38-4777-812c-287b979eb26b","timestamp":"2026-05-29T09:46:40.013Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-B53dQt/project/c_src/tests/test_string_t.c","content":"/*\n    MIT License\n\n    Copyright (c) 2023 Ivan Korotaev <vnkrtv@yandex.ru>\n\n    Permission is hereby granted, free of charge, to any person obtaining a copy\n    of this software and associated documentation files (the \"Software\"), to deal\n    in the Software without restriction, including without limitation the rights\n    to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n    copies of the Software, and to permit persons to whom the Software is\n    furnished to do so, subject to the following conditions:\n\n    The above copyright notice and this permission notice shall be included in all\n    copies or substantial portions of the Software.\n\n    THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n    OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n    SOFTWARE.\n */\n#include <stdio.h>\n#include <assert.h>\n\n\n#include \"../src/string_t.h\"\n\n#define DUMP_STRING(str) \\\n    fprintf(stderr, \"string_t(bytes=\\\"%s\\\", size=%zu)\", str->bytes, str->size)\n#define LOG_STRING(arg, str) \\\n    fprintf(stderr, \"%s=\", arg); \\\n    DUMP_STRING(str); \\\n    fprintf(stderr, \"\\n\")\n\n/* Simple linked list C implementation. */\ntypedef struct node_t {\n    struct node_t *next;\n    void *value;\n} node_t;\n\nnode_t *new_node(void *);\n\nnode_t *add_node(node_t *, void *);\n\nnode_t *new_node(void *value) {\n    node_t *created_node = malloc(sizeof(node_t));\n    created_node->next = NULL;\n    created_node->value = value;\n    return created_node;\n}\n\nnode_t *add_node(node_t *node, void *value) {\n    node_t *created_node = new_node(value);\n    created_node->next = NULL;\n    created_node->value = value;\n\n    node->next = created_node;\n    return created_node;\n}\n\nvoid node_free(node_t *node) {\n    if (node->value != NULL) {\n        free(node->value);\n    }\n    free(node);\n}\n\n/*\n * Test structures\n */\ntypedef void (*test_func_t)(void);\n\n/* Test struct. */\ntypedef struct test_t {\n    test_func_t test;\n    char *description;\n} test_t;\n\nvoid test_free(test_t *test) {\n    free(test->description);\n}\n\n/* Struct for organizing test running. */\ntypedef struct test_runner_t {\n    node_t *first_test;\n    node_t *last_test;\n} test_runner_t;\n\n/* Create new test runner. */\ntest_runner_t new_runner();\n\n/* Register test for test runner. */\nvoid register_test(test_runner_t *, test_func_t, char *);\n\n/* Run registered tests. */\nint run_tests(test_runner_t *);\n\n/* Free test runner. */\nvoid runner_free(test_runner_t *);\n\ntest_runner_t new_runner() {\n    test_runner_t runner;\n    runner.first_test = NULL;\n    runner.last_test = NULL;\n    return runner;\n}\n\nvoid register_test(test_runner_t *test_runner, test_func_t test, char *description) {\n    test_t *new_test = malloc(sizeof(test_t));\n    new_test->test = test;\n    new_test->description = malloc(strlen(description));\n    strcpy(new_test->description, description);\n    if (test_runner->first_test == NULL) {\n        test_runner->first_test = new_node(new_test);\n        test_runner->last_test = test_runner->first_test;\n    } else {\n        test_runner->last_test = add_node(test_runner->last_test, new_test);\n    }\n}\n\nint run_tests(test_runner_t *test_runner) {\n    node_t *cur_test = test_runner->first_test;\n    while (cur_test != NULL) {\n        test_t *test = (test_t *) cur_test->value;\n        test->test();\n        printf(\"%s: OK\\n\", test->description);\n        cur_test = cur_test->next;\n    }\n    return 0;\n}\n\nvoid runner_free(test_runner_t *test_runner) {\n    node_t *cur_test = test_runner->first_test;\n    while (cur_test != NULL) {\n        test_t *test = (test_t *) cur_test->value;\n        test_free(test);\n        node_t *node = cur_test;\n        cur_test = cur_test->next;\n        node_free(node);\n    }\n}\n\n/*\n * string_t tests\n */\nvoid string_arr_free(STRING_T_ARRAY str_arr, size_t size) {\n    for (size_t idx = 0; idx < size; ++idx) {\n        string_free(str_arr[idx]);\n    }\n}\n\nvoid test_new_string(void) {\n    size_t sizes[] = {0, 1, 2, 3, 12, 100};\n    for (size_t idx = 0; idx < 5; ++idx) {\n        string_t *str = new_string(sizes[idx]);\n        assert(str->size == sizes[idx]);\n        string_free(str);\n    }\n}\n\nvoid test_new_string_from_bytes(void) {\n    char *bytes[] = {\"\", \"test\", \"some another test\"};\n    for (size_t idx = 0; idx < 3; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        assert(str->size == strlen(bytes[idx]));\n        assert(strcmp(str->bytes, bytes[idx]) == 0);\n        string_free(str);\n    }\n}\n\nvoid test_string_len(void) {\n    char *bytes[] = {\"\", \"test\", \"some another test\"};\n    size_t len[] = {0, 4, 17};\n    for (size_t idx = 0; idx < 3; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        assert(str->size == strlen(bytes[idx]));\n        assert(string_len(str) == len[idx]);\n        string_free(str);\n    }\n}\n\nvoid test_string_bytes(void) {\n    char *bytes[] = {\"\", \"test\", \"some another test\"};\n    for (size_t idx = 0; idx < 3; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        char *str_bytes = string_bytes(str);\n        assert(strcmp(str_bytes, bytes[idx]) == 0);\n        string_free(str);\n        free(str_bytes);\n    }\n}\n\nvoid test_string_eq(void) {\n    char *left_bytes[] = {\"\", \"\\n\\n\", \"test\", \"some another test\"};\n    char *right_bytes[] = {\"\", \"\\n\\n\", \"test\", \"some another test\"};\n\n    for (size_t idx = 0; idx < 4; ++idx) {\n        string_t *left_str = new_string_from_bytes(left_bytes[idx]);\n        string_t *right_str = new_string_from_bytes(right_bytes[idx]);\n\n        assert(left_str->size == right_str->size);\n        assert(strcmp(left_str->bytes, right_str->bytes) == 0);\n\n        string_free(left_str);\n        string_free(right_str);\n    }\n}\n\nvoid test_string_copy(void) {\n    char *bytes[] = {\"\", \"test\", \"some another test\"};\n    for (size_t idx = 0; idx < 3; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        string_t *str_copy = string_copy(str);\n\n        assert(string_eq(str, str_copy) == true);\n\n        string_free(str);\n        string_free(str_copy);\n    }\n}\n\nvoid test_string_concat(void) {\n    char *first[] = {\"\", \"first\", \"some another\"};\n    char *second[] = {\"\", \"second\", \" test\"};\n    char *res[] = {\"\", \"firstsecond\", \"some another test\"};\n    for (size_t idx = 0; idx < 3; ++idx) {\n        string_t *first_str = new_string_from_bytes(first[idx]);\n        string_t *second_str = new_string_from_bytes(second[idx]);\n        string_t *res_str = new_string_from_bytes(res[idx]);\n        string_t *concat_str = string_concat(first_str, second_str);\n\n        assert(string_eq(concat_str, res_str) == true);\n\n        string_free(first_str);\n        string_free(second_str);\n        string_free(res_str);\n        string_free(concat_str);\n    }\n}\n\nvoid test_string_strip(void) {\n    char *bytes[] = {\"\", \"vfv\\n\\n\", \"  test\\t\", \" some another test  \"};\n    char *stripped_bytes[] = {\"\", \"vfv\", \"test\", \"some another test\"};\n\n    for (size_t idx = 0; idx < 4; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        string_t *stripped_str =  string_strip(str);\n        string_t *exp_stripped_str = new_string_from_bytes(stripped_bytes[idx]);\n\n        assert(string_eq(stripped_str, exp_stripped_str) == true);\n\n        string_free(str);\n        string_free(stripped_str);\n        string_free(exp_stripped_str);\n    }\n}\n\nvoid test_string_substr(void) {\n    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \" some another test  \"};\n    size_t substr_start_pos[] = {0, 1, 5, 0};\n    size_t substr_len[] = {0, 2, 3, 5};\n    char *substr_bytes[] = {\"\", \"fv\", \"str\", \" some\"};\n\n    for (size_t idx = 0; idx < 4; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        string_t *substr_str = string_substr(str, substr_start_pos[idx], substr_len[idx]);\n        string_t *expected_substr_str = new_string_from_bytes(substr_bytes[idx]);\n\n        assert(string_eq(substr_str, expected_substr_str) == true);\n\n        string_free(str);\n        string_free(substr_str);\n        string_free(expected_substr_str);\n    }\n}\n\nvoid test_string_startswith(void) {\n    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \" some another test  \", \"1234\"};\n    char *startswith_bytes[] = {\"\", \"vfv\", \"test string\", \" some\", \"2\"};\n    bool_t res[] = {true, true, true, true, false};\n\n    for (size_t idx = 0; idx < 5; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        assert(string_startswith(str, startswith_bytes[idx]) == res[idx]);\n        string_free(str);\n    }\n}\n\nvoid test_string_endswith(void) {\n    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \" some another test  \", \"1234\"};\n    char *endswith_bytes[] = {\"\", \"fv\\n\\n\", \"test string\", \"test  \", \"2\"};\n    bool_t res[] = {true, true, true, true, false};\n\n    for (size_t idx = 0; idx < 5; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        assert(string_endswith(str, endswith_bytes[idx]) == res[idx]);\n        string_free(str);\n    }\n}\n\nvoid test_string_find(void) {\n    char *bytes[] = {\"\", \"vfv\\n\\n\", \"test string\", \"test string\", \" some another test  \"};\n    char *chars[] = {\"\", \"\\n\", \"no\", \"\", \"another\"};\n    int expected_pos[] = {0, 3, -1, 0, 6};\n\n    for (size_t idx = 0; idx < 5; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n        assert(string_find(str, chars[idx]) == expected_pos[idx]);\n        string_free(str);\n    }\n}\n\n#ifndef _WIN32\n\nvoid test_string_split(void) {\n    char *bytes[] = {\n            \"\",\n            \"1\",\n            \"some\",\n            \" some string 124!\",\n            \"Some github account: vnkrtv\"\n    };\n    size_t expected_arr_size[] = {\n            1,\n            1,\n            1,\n            4,\n            4\n    };\n\n    string_t *first_arr[] = {\n            new_string_from_bytes(\"\")\n    };\n    string_t *second_arr[] = {\n            new_string_from_bytes(\"1\")\n    };\n    string_t *third_arr[] = {\n            new_string_from_bytes(\"some\")\n    };\n    string_t *fourth_arr[] = {\n            new_string_from_bytes(\"\"),\n            new_string_from_bytes(\"some\"),\n            new_string_from_bytes(\"string\"),\n            new_string_from_bytes(\"124!\")\n    };\n    string_t *fifth_arr[] = {\n            new_string_from_bytes(\"Some\"),\n            new_string_from_bytes(\"github\"),\n            new_string_from_bytes(\"account:\"),\n            new_string_from_bytes(\"vnkrtv\")\n    };\n    STRING_T_ARRAY arr_expected[] = {first_arr, second_arr, third_arr, fourth_arr, fifth_arr};\n\n    for (size_t idx = 0; idx < 5; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n\n        size_t arr_size = 0;\n        STRING_T_ARRAY str_arr = string_split(str, &arr_size);\n        STRING_T_ARRAY expected_str_arr = arr_expected[idx];\n\n        assert(arr_size == expected_arr_size[idx]);\n        for (size_t arr_idx = 0; arr_idx < expected_arr_size[idx]; ++arr_idx) {\n            if (string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) != true) {\n                LOG_STRING(\"str_arr[arr_idx]\", str_arr[arr_idx]);\n                LOG_STRING(\"expected_str_arr[arr_idx]\", expected_str_arr[arr_idx]);\n                assert(string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) == true);\n            }\n        }\n        string_free(str);\n        string_arr_free(str_arr, arr_size);\n        free(str_arr);\n    }\n\n    string_arr_free(first_arr, 1);\n    string_arr_free(second_arr, 1);\n    string_arr_free(third_arr, 1);\n    string_arr_free(fourth_arr, 4);\n    string_arr_free(fifth_arr, 4);\n}\n\nvoid test_string_split_by(void) {\n    const char split_by_chars[] = \"W\";\n    char *bytes[] = {\n            \"\",\n            \"1\",\n            \"some\",\n            \"WsomeWstringW124!\",\n            \"SomeWgithubWaccount:Wvnkrtv\"\n    };\n    size_t expected_arr_size[] = {\n            1,\n            1,\n            1,\n            4,\n            4\n    };\n\n    string_t *first_arr[] = {\n            new_string_from_bytes(\"\")\n    };\n    string_t *second_arr[] = {\n            new_string_from_bytes(\"1\")\n    };\n    string_t *third_arr[] = {\n            new_string_from_bytes(\"some\")\n    };\n    string_t *fourth_arr[] = {\n            new_string_from_bytes(\"\"),\n            new_string_from_bytes(\"some\"),\n            new_string_from_bytes(\"string\"),\n            new_string_from_bytes(\"124!\")\n    };\n    string_t *fifth_arr[] = {\n            new_string_from_bytes(\"Some\"),\n            new_string_from_bytes(\"github\"),\n            new_string_from_bytes(\"account:\"),\n            new_string_from_bytes(\"vnkrtv\")\n    };\n    string_t **arr_expected[] = {first_arr, second_arr, third_arr, fourth_arr, fifth_arr};\n\n    for (size_t idx = 0; idx < 5; ++idx) {\n        string_t *str = new_string_from_bytes(bytes[idx]);\n\n        size_t arr_size = 0;\n        STRING_T_ARRAY str_arr = string_split_by(str, &arr_size, split_by_chars);\n        STRING_T_ARRAY expected_str_arr = arr_expected[idx];\n\n        assert(arr_size == expected_arr_size[idx]);\n        for (size_t arr_idx = 0; arr_idx < expected_arr_size[idx]; ++arr_idx) {\n            if (string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) != true) {\n                LOG_STRING(\"str_arr[arr_idx]\", str_arr[arr_idx]);\n                LOG_STRING(\"expected_str_arr[arr_idx]\", expected_str_arr[arr_idx]);\n                assert(string_eq(str_arr[arr_idx], expected_str_arr[arr_idx]) == true);\n            }\n        }\n\n        string_free(str);\n        string_arr_free(str_arr, arr_size);\n        free(str_arr);\n    }\n\n    string_arr_free(first_arr, 1);\n    string_arr_free(second_arr, 1);\n    string_arr_free(third_arr, 1);\n    string_arr_free(fourth_arr, 4);\n    string_arr_free(fifth_arr, 4);\n}\n\n#endif\n\nvoid test_string_join_arr(void) {\n    string_t *first_arr[] = {\n            new_string_from_bytes(\"\")\n    };\n    string_t *second_arr[] = {\n            new_string_from_bytes(\"1\")\n    };\n    string_t *third_arr[] = {\n            new_string_from_bytes(\"some\"),\n            new_string_from_bytes(\"string\")\n    };\n    string_t *fourth_arr[] = {\n            new_string_from_bytes(\"\"),\n            new_string_from_bytes(\"some\"),\n            new_string_from_bytes(\"string\")\n    };\n    string_t *fifth_arr[] = {\n            new_string_from_bytes(\"some\"),\n            new_string_from_bytes(\"string\")\n    };\n    STRING_T_ARRAY str_arr[] = {first_arr, second_arr, third_arr, fourth_arr, fifth_arr};\n    size_t arr_size[] = {1, 1, 2, 3, 2};\n\n    char *space_chars[] = {\n            \" \",\n            \" \",\n            \" \",\n            \"\\n\",\n            \"SOME\"\n    };\n    string_t *expected_res_str[] = {\n            new_string_from_bytes(\"\"),\n            new_string_from_bytes(\"1\"),\n            new_string_from_bytes(\"some string\"),\n            new_string_from_bytes(\"\\nsome\\nstring\"),\n            new_string_from_bytes(\"someSOMEstring\")\n    };\n\n\n    for (size_t idx = 0; idx < 5; ++idx) {\n        const STRING_T_ARRAY arr = (const STRING_T_ARRAY) str_arr[idx];\n        string_t *res_str = string_join_arr(arr, arr_size[idx], space_chars[idx]);\n\n        assert(string_eq(res_str, expected_res_str[idx]) == true);\n\n        string_free(res_str);\n    }\n\n    string_arr_free(first_arr, 1);\n    string_arr_free(second_arr, 1);\n    string_arr_free(third_arr, 2);\n    string_arr_free(fourth_arr, 3);\n    string_arr_free(fifth_arr, 2);\n    string_arr_free(expected_res_str, 5);\n}\n\nint main() {\n    test_runner_t runner = new_runner();\n\n    register_test(&runner, &test_new_string, \"Test new_string\");\n    register_test(&runner, &test_new_string_from_bytes, \"Test new_string_from_bytes\");\n    register_test(&runner, &test_string_len, \"Test string_len\");\n    register_test(&runner, &test_string_bytes, \"Test string_bytes\");\n    register_test(&runner, &test_string_eq, \"Test string_eq\");\n    register_test(&runner, &test_string_copy, \"Test string_copy\");\n    register_test(&runner, &test_string_concat, \"Test string_concat\");\n    register_test(&runner, &test_string_substr, \"Test string_substr\");\n    register_test(&runner, &test_string_startswith, \"Test string_startswith\");\n    register_test(&runner, &test_string_endswith, \"Test string_endswith\");\n    register_test(&runner, &test_string_find, \"Test string_find\");\n    register_test(&runner, &test_string_strip, \"Test string_strip\");\n#ifndef _WIN32\n    register_test(&runner, &test_string_split, \"Test string_split\");\n    register_test(&runner, &test_string_split_by, \"Test string_split_by\");\n#endif\n    register_test(&runner, &test_string_join_arr, \"Test test_string_join_arr\");\n\n    run_tests(&runner);\n    runner_free(&runner);\n\n    return 0;\n}","numLines":534,"startLine":1,"totalLines":534}}}
