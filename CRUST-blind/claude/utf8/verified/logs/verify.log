07FF, U+0800, U+FFFF, U+10000, U+10FFFF), and via iterator integration.\n\nExpected values were taken from running the C test binary (`./test_prog`), which passed all 25 reference cases. The Rust API matched the C behavior on all expectations — no Rust source changes were required."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3891,"cache_read_input_tokens":49074,"cache_creation":{"ephemeral_5m_input_tokens":3891,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"2b6d90a8-611c-49da-8de7-4c3c2346631a","uuid":"fac45d57-b9c8-40eb-b5b6-c92e7036f4b2"}
