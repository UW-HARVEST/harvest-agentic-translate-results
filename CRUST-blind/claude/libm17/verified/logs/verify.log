 PreambleType::Lsf);\n    assert_ne!(PreambleType::Lsf, PreambleType::Bert);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1986,"cache_read_input_tokens":147050,"cache_creation":{"ephemeral_5m_input_tokens":1986,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f569a2af-11b3-4b9d-98ff-be64e8afe6cc","uuid":"b9b71c8b-f1cb-4c64-ba25-8e0a5b15cd3b"}
