{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TrF71oRSbXdkq5qzxCjpN6","type":"tool_result","content":"1\t//--------------------------------------------------------------------\n2\t// M17 C library - payload/call.c\n3\t//\n4\t// This file contains:\n5\t// - callsign encoders and decoders\n6\t//\n7\t// Wojciech Kaczmarski, SP5WWP\n8\t// M17 Project, 24 September 2024\n9\t//--------------------------------------------------------------------\n10\t#include <stdio.h>\n11\t#include <string.h>\n12\t#include <m17.h>\n13\t\n14\t/**\n15\t * @brief Decode a 48-bit value (stored as uint64_t) into callsign string.\n16\t * \n17\t * @param outp Decoded callsign string.\n18\t * @param inp Encoded value.\n19\t */\n20\tvoid decode_callsign_value(uint8_t *outp, const uint64_t inp)\n21\t{\n22\t    uint64_t encoded=inp;\n23\t    uint8_t start=0; //where to put the first decoded, non-# character\n24\t\n25\t\t//address range check\n26\t\tif(encoded>=U40_9)\n27\t\t{\n28\t        if(encoded==0xFFFFFFFFFFFF) //broadcast special address\n29\t        {\n30\t            sprintf((char*)outp, \"@ALL\");\n31\t            return;\n32\t        }\n33\t        else if(encoded<=U40_9_8) //#-address range\n34\t        {\n35\t            start=1;\n36\t            encoded-=U40_9;\n37\t            outp[0]='#';\n38\t        }\n39\t        else //reserved address range\n40\t        {\n41\t            return;\n42\t        }\n43\t\t}\n44\t\n45\t\t//decode the callsign\n46\t\tuint8_t i=start;\n47\t\twhile(encoded>0)\n48\t\t{\n49\t\t\toutp[i]=CHAR_MAP[encoded%40];\n50\t\t\tencoded/=40;\n51\t\t\ti++;\n52\t\t}\n53\t\toutp[i]=0;\n54\t}\n55\t\n56\t/**\n57\t * @brief Decode a 6-byte long array (big-endian) into callsign string.\n58\t * \n59\t * @param outp Decoded callsign string.\n60\t * @param inp Pointer to a byte array holding the encoded value (big-endian).\n61\t */\n62\tvoid decode_callsign_bytes(uint8_t *outp, const uint8_t inp[6])\n63\t{\n64\t\tuint64_t encoded=0;\n65\t\n66\t\t//repack the data to a uint64_t\n67\t\tfor(uint8_t i=0; i<6; i++)\n68\t\t\tencoded|=(uint64_t)inp[5-i]<<(8*i);\n69\t\n70\t\tdecode_callsign_value(outp, encoded);\n71\t}\n72\t\n73\t/**\n74\t * @brief Encode callsign string into a 48-bit value, stored as uint64_t.\n75\t * \n76\t * @param out Pointer to a uint64_t variable for the encoded value.\n77\t * @param inp Callsign string.\n78\t * @return int8_t Return value, 0 -> OK.\n79\t */\n80\tint8_t encode_callsign_value(uint64_t *out, const uint8_t *inp)\n81\t{\n82\t    //assert inp length\n83\t    if(strlen((const char*)inp)>9)\n84\t        return -1;\n85\t\n86\t    const uint8_t charMap[40]=CHAR_MAP;\n87\t\n88\t    uint64_t tmp=0;\n89\t    uint8_t start=0; //where's the first char of the address? this excludes the leading #, if present\n90\t\n91\t    //a special address that's encoded differently\n92\t    if(strcmp((const char*)inp, \"@ALL\")==0)\n93\t    {\n94\t        *out=0xFFFFFFFFFFFF;\n95\t        return 0;\n96\t    }\n97\t\n98\t    //check if the address is in the hash-space\n99\t    if(inp[0]=='#')\n100\t        start=1;\n101\t\n102\t    for(int8_t i=strlen((const char*)inp)-1; i>=start; i--)\n103\t    {\n104\t        for(uint8_t j=0; j<40; j++)\n105\t        {\n106\t            if(inp[i]==charMap[j])\n107\t            {\n108\t                tmp=tmp*40+j;\n109\t                break;\n110\t            }\n111\t        }\n112\t    }\n113\t\n114\t    if(start) //starts with a hash?\n115\t        tmp+=U40_9; //40^9\n116\t\n117\t    *out=tmp;\n118\t    return 0;\n119\t}\n120\t\n121\t/**\n122\t * @brief Encode callsign string and store in a 6-byte array (big-endian)\n123\t * \n124\t * @param out Pointer to a byte array for the encoded value (big-endian).\n125\t * @param inp Callsign string.\n126\t * @return int8_t Return value, 0 -> OK.\n127\t */\n128\tint8_t encode_callsign_bytes(uint8_t out[6], const uint8_t *inp)\n129\t{\n130\t    uint64_t tmp=0;\n131\t\n132\t    if(encode_callsign_value(&tmp, inp))\n133\t    {\n134\t        return -1;\n135\t    }\n136\t\n137\t\tfor(uint8_t i=0; i<6; i++)\n138\t    \tout[5-i]=(tmp>>(8*i))&0xFF;\n139\t    \t\n140\t    return 0;\n141\t}\n142\t\n143\t\n144\t//--------------------------------------------------------------------\n145\t// M17 C library - payload/crc.c\n146\t//\n147\t// This file contains:\n148\t// - CRC calculating functions (arbitrary length)\n149\t//\n150\t// Wojciech Kaczmarski, SP5WWP\n151\t// M17 Project, 29 December 2023\n152\t//--------------------------------------------------------------------\n153\t\n154\t\n155\t//M17 CRC polynomial\n156\tconst uint16_t M17_CRC_POLY = 0x5935;\n157\t\n158\t/**\n159\t * @brief Calculate CRC value.\n160\t *\n161\t * @param in Pointer to the input byte array.\n162\t * @param len Input's length.\n163\t * @return uint16_t CRC value.\n164\t */\n165\tuint16_t CRC_M17(const uint8_t* in, const uint16_t len)\n166\t{\n167\t\tuint32_t crc=0xFFFF; //init val\n168\t\n169\t\tfor(uint16_t i=0; i<len; i++)\n170\t\t{\n171\t\t\tcrc^=in[i]<<8;\n172\t\t\tfor(uint8_t j=0; j<8; j++)\n173\t\t\t{\n174\t\t\t\tcrc<<=1;\n175\t\t\t\tif(crc&0x10000)\n176\t\t\t\t\tcrc=(crc^M17_CRC_POLY)&0xFFFF;\n177\t\t\t}\n178\t\t}\n179\t\n180\t\treturn crc&(0xFFFF);\n181\t}\n182\t\n183\t/**\n184\t * @brief Calculate CRC value for the Link Setup Frame.\n185\t *\n186\t * @param in Pointer to an LSF struct.\n187\t * @return uint16_t CRC value.\n188\t */\n189\tuint16_t LSF_CRC(const lsf_t* in)\n190\t{\n191\t    uint8_t d[28];\n192\t\n193\t    memcpy(&d[0], in->dst, 6);\n194\t    memcpy(&d[6], in->src, 6);\n195\t    memcpy(&d[12], in->type, 2);\n196\t    memcpy(&d[14], in->meta, 14);\n197\t\n198\t    return CRC_M17(d, 28);\n199\t}\n200\t\n201\t//--------------------------------------------------------------------\n202\t// M17 C library - payload/lich.c\n203\t//\n204\t// This file contains:\n205\t// - Link Information CHannel (LICH) repacking functions\n206\t//\n207\t// Wojciech Kaczmarski, SP5WWP\n208\t// M17 Project, 8 January 2024\n209\t//--------------------------------------------------------------------\n210\t\n211\t/**\n212\t * @brief Extract LICH from the whole LSF.\n213\t * \n214\t * @param outp 6-byte array for the LICH.\n215\t * @param cnt LICH counter (0 to 5)\n216\t * @param inp Pointer to an LSF struct.\n217\t */\n218\tvoid extract_LICH(uint8_t outp[6], const uint8_t cnt, const lsf_t* inp)\n219\t{\n220\t    switch(cnt)\n221\t    {\n222\t        case 0:\n223\t            outp[0]=inp->dst[0];\n224\t            outp[1]=inp->dst[1];\n225\t            outp[2]=inp->dst[2];\n226\t            outp[3]=inp->dst[3];\n227\t            outp[4]=inp->dst[4];\n228\t        break;\n229\t\n230\t        case 1:\n231\t            outp[0]=inp->dst[5];\n232\t            outp[1]=inp->src[0];\n233\t            outp[2]=inp->src[1];\n234\t            outp[3]=inp->src[2];\n235\t            outp[4]=inp->src[3];\n236\t        break;\n237\t\n238\t        case 2:\n239\t            outp[0]=inp->src[4];\n240\t            outp[1]=inp->src[5];\n241\t            outp[2]=inp->type[0];\n242\t            outp[3]=inp->type[1];\n243\t            outp[4]=inp->meta[0];\n244\t        break;\n245\t\n246\t        case 3:\n247\t            outp[0]=inp->meta[1];\n248\t            outp[1]=inp->meta[2];\n249\t            outp[2]=inp->meta[3];\n250\t            outp[3]=inp->meta[4];\n251\t            outp[4]=inp->meta[5];\n252\t        break;\n253\t\n254\t        case 4:\n255\t            outp[0]=inp->meta[6];\n256\t            outp[1]=inp->meta[7];\n257\t            outp[2]=inp->meta[8];\n258\t            outp[3]=inp->meta[9];\n259\t            outp[4]=inp->meta[10];\n260\t        break;\n261\t\n262\t        case 5:\n263\t            outp[0]=inp->meta[11];\n264\t            outp[1]=inp->meta[12];\n265\t            outp[2]=inp->meta[13];\n266\t            outp[3]=inp->crc[0];\n267\t            outp[4]=inp->crc[1];\n268\t        break;\n269\t\n270\t        default:\n271\t            ;\n272\t        break;\n273\t    }\n274\t\n275\t    outp[5]=cnt<<5;\n276\t}\n277\t\n278\t/**\n279\t * @brief Unpack LICH bytes.\n280\t * \n281\t * @param out Unpacked, encoded LICH bits (array of at least 96 bytes).\n282\t * @param in 12-byte (96 bits) encoded LICH, packed.\n283\t */\n284\tvoid unpack_LICH(uint8_t *out, const uint8_t in[12])\n285\t{\n286\t    for(uint8_t i=0; i<12; i++)\n287\t    {\n288\t        for(uint8_t j=0; j<8; j++)\n289\t            out[i*8+j]=(in[i]>>(7-j))&1;\n290\t    }\n291\t}\n292\t"}]},"parent_tool_use_id":null,"session_id":"f569a2af-11b3-4b9d-98ff-be64e8afe6cc","uuid":"0af1e53c-48c2-436e-9d01-111b909955a2","timestamp":"2026-05-29T18:25:52.928Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-TAFvTY/project/c_src/payload/payload.c","content":"//--------------------------------------------------------------------\n// M17 C library - payload/call.c\n//\n// This file contains:\n// - callsign encoders and decoders\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 24 September 2024\n//--------------------------------------------------------------------\n#include <stdio.h>\n#include <string.h>\n#include <m17.h>\n\n/**\n * @brief Decode a 48-bit value (stored as uint64_t) into callsign string.\n * \n * @param outp Decoded callsign string.\n * @param inp Encoded value.\n */\nvoid decode_callsign_value(uint8_t *outp, const uint64_t inp)\n{\n    uint64_t encoded=inp;\n    uint8_t start=0; //where to put the first decoded, non-# character\n\n\t//address range check\n\tif(encoded>=U40_9)\n\t{\n        if(encoded==0xFFFFFFFFFFFF) //broadcast special address\n        {\n            sprintf((char*)outp, \"@ALL\");\n            return;\n        }\n        else if(encoded<=U40_9_8) //#-address range\n        {\n            start=1;\n            encoded-=U40_9;\n            outp[0]='#';\n        }\n        else //reserved address range\n        {\n            return;\n        }\n\t}\n\n\t//decode the callsign\n\tuint8_t i=start;\n\twhile(encoded>0)\n\t{\n\t\toutp[i]=CHAR_MAP[encoded%40];\n\t\tencoded/=40;\n\t\ti++;\n\t}\n\toutp[i]=0;\n}\n\n/**\n * @brief Decode a 6-byte long array (big-endian) into callsign string.\n * \n * @param outp Decoded callsign string.\n * @param inp Pointer to a byte array holding the encoded value (big-endian).\n */\nvoid decode_callsign_bytes(uint8_t *outp, const uint8_t inp[6])\n{\n\tuint64_t encoded=0;\n\n\t//repack the data to a uint64_t\n\tfor(uint8_t i=0; i<6; i++)\n\t\tencoded|=(uint64_t)inp[5-i]<<(8*i);\n\n\tdecode_callsign_value(outp, encoded);\n}\n\n/**\n * @brief Encode callsign string into a 48-bit value, stored as uint64_t.\n * \n * @param out Pointer to a uint64_t variable for the encoded value.\n * @param inp Callsign string.\n * @return int8_t Return value, 0 -> OK.\n */\nint8_t encode_callsign_value(uint64_t *out, const uint8_t *inp)\n{\n    //assert inp length\n    if(strlen((const char*)inp)>9)\n        return -1;\n\n    const uint8_t charMap[40]=CHAR_MAP;\n\n    uint64_t tmp=0;\n    uint8_t start=0; //where's the first char of the address? this excludes the leading #, if present\n\n    //a special address that's encoded differently\n    if(strcmp((const char*)inp, \"@ALL\")==0)\n    {\n        *out=0xFFFFFFFFFFFF;\n        return 0;\n    }\n\n    //check if the address is in the hash-space\n    if(inp[0]=='#')\n        start=1;\n\n    for(int8_t i=strlen((const char*)inp)-1; i>=start; i--)\n    {\n        for(uint8_t j=0; j<40; j++)\n        {\n            if(inp[i]==charMap[j])\n            {\n                tmp=tmp*40+j;\n                break;\n            }\n        }\n    }\n\n    if(start) //starts with a hash?\n        tmp+=U40_9; //40^9\n\n    *out=tmp;\n    return 0;\n}\n\n/**\n * @brief Encode callsign string and store in a 6-byte array (big-endian)\n * \n * @param out Pointer to a byte array for the encoded value (big-endian).\n * @param inp Callsign string.\n * @return int8_t Return value, 0 -> OK.\n */\nint8_t encode_callsign_bytes(uint8_t out[6], const uint8_t *inp)\n{\n    uint64_t tmp=0;\n\n    if(encode_callsign_value(&tmp, inp))\n    {\n        return -1;\n    }\n\n\tfor(uint8_t i=0; i<6; i++)\n    \tout[5-i]=(tmp>>(8*i))&0xFF;\n    \t\n    return 0;\n}\n\n\n//--------------------------------------------------------------------\n// M17 C library - payload/crc.c\n//\n// This file contains:\n// - CRC calculating functions (arbitrary length)\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 29 December 2023\n//--------------------------------------------------------------------\n\n\n//M17 CRC polynomial\nconst uint16_t M17_CRC_POLY = 0x5935;\n\n/**\n * @brief Calculate CRC value.\n *\n * @param in Pointer to the input byte array.\n * @param len Input's length.\n * @return uint16_t CRC value.\n */\nuint16_t CRC_M17(const uint8_t* in, const uint16_t len)\n{\n\tuint32_t crc=0xFFFF; //init val\n\n\tfor(uint16_t i=0; i<len; i++)\n\t{\n\t\tcrc^=in[i]<<8;\n\t\tfor(uint8_t j=0; j<8; j++)\n\t\t{\n\t\t\tcrc<<=1;\n\t\t\tif(crc&0x10000)\n\t\t\t\tcrc=(crc^M17_CRC_POLY)&0xFFFF;\n\t\t}\n\t}\n\n\treturn crc&(0xFFFF);\n}\n\n/**\n * @brief Calculate CRC value for the Link Setup Frame.\n *\n * @param in Pointer to an LSF struct.\n * @return uint16_t CRC value.\n */\nuint16_t LSF_CRC(const lsf_t* in)\n{\n    uint8_t d[28];\n\n    memcpy(&d[0], in->dst, 6);\n    memcpy(&d[6], in->src, 6);\n    memcpy(&d[12], in->type, 2);\n    memcpy(&d[14], in->meta, 14);\n\n    return CRC_M17(d, 28);\n}\n\n//--------------------------------------------------------------------\n// M17 C library - payload/lich.c\n//\n// This file contains:\n// - Link Information CHannel (LICH) repacking functions\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 8 January 2024\n//--------------------------------------------------------------------\n\n/**\n * @brief Extract LICH from the whole LSF.\n * \n * @param outp 6-byte array for the LICH.\n * @param cnt LICH counter (0 to 5)\n * @param inp Pointer to an LSF struct.\n */\nvoid extract_LICH(uint8_t outp[6], const uint8_t cnt, const lsf_t* inp)\n{\n    switch(cnt)\n    {\n        case 0:\n            outp[0]=inp->dst[0];\n            outp[1]=inp->dst[1];\n            outp[2]=inp->dst[2];\n            outp[3]=inp->dst[3];\n            outp[4]=inp->dst[4];\n        break;\n\n        case 1:\n            outp[0]=inp->dst[5];\n            outp[1]=inp->src[0];\n            outp[2]=inp->src[1];\n            outp[3]=inp->src[2];\n            outp[4]=inp->src[3];\n        break;\n\n        case 2:\n            outp[0]=inp->src[4];\n            outp[1]=inp->src[5];\n            outp[2]=inp->type[0];\n            outp[3]=inp->type[1];\n            outp[4]=inp->meta[0];\n        break;\n\n        case 3:\n            outp[0]=inp->meta[1];\n            outp[1]=inp->meta[2];\n            outp[2]=inp->meta[3];\n            outp[3]=inp->meta[4];\n            outp[4]=inp->meta[5];\n        break;\n\n        case 4:\n            outp[0]=inp->meta[6];\n            outp[1]=inp->meta[7];\n            outp[2]=inp->meta[8];\n            outp[3]=inp->meta[9];\n            outp[4]=inp->meta[10];\n        break;\n\n        case 5:\n            outp[0]=inp->meta[11];\n            outp[1]=inp->meta[12];\n            outp[2]=inp->meta[13];\n            outp[3]=inp->crc[0];\n            outp[4]=inp->crc[1];\n        break;\n\n        default:\n            ;\n        break;\n    }\n\n    outp[5]=cnt<<5;\n}\n\n/**\n * @brief Unpack LICH bytes.\n * \n * @param out Unpacked, encoded LICH bits (array of at least 96 bytes).\n * @param in 12-byte (96 bits) encoded LICH, packed.\n */\nvoid unpack_LICH(uint8_t *out, const uint8_t in[12])\n{\n    for(uint8_t i=0; i<12; i++)\n    {\n        for(uint8_t j=0; j<8; j++)\n            out[i*8+j]=(in[i]>>(7-j))&1;\n    }\n}\n","numLines":292,"startLine":1,"totalLines":292}}}
