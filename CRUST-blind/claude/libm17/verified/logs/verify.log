+ 2] + ud[i + 0]) % 2;\n        enc_bits[idx] = g1;\n        idx += 1;\n        enc_bits[idx] = g2;\n        idx += 1;\n    }\n    let mut soft_v = [0u16; 24];\n    hard_to_soft(&mut soft_v, &enc_bits);\n    let mut out_v = [0u8; 4];\n    let cost = viterbi_decode(&mut out_v, &soft_v, 24);\n    assert_eq!(cost, 0);\n    // For input_bits = {1,0,1,1,0,0,1,0, ...trail}, C outputs out = [0x00, 0xB2]\n    // (the data bits packed MSB-first into the high byte).\n    assert_eq!(out_v[0], 0x00);\n    assert_eq!(out_v[1], 0xB2);\n\n    // ---- Test 7: a single bit input ----\n    let mut ud = [0u8; 16];\n    ud[4] = 1; // first data bit = 1\n    let mut enc_bits = [0u8; 24];\n    let mut idx = 0;\n    for i in 0..12 {\n        let g1 = (ud[i + 4] + ud[i + 1] + ud[i + 0]) % 2;\n        let g2 = (ud[i + 4] + ud[i + 3] + ud[i + 2] + ud[i + 0]) % 2;\n        enc_bits[idx] = g1;\n        idx += 1;\n        enc_bits[idx] = g2;\n        idx += 1;\n    }\n    let mut soft_v = [0u16; 24];\n    hard_to_soft(&mut soft_v, &enc_bits);\n    let mut out_v = [0u8; 4];\n    let cost = viterbi_decode(&mut out_v, &soft_v, 24);\n    assert_eq!(cost, 0);\n    // From C: out: 00 80\n    assert_eq!(out_v[0], 0x00);\n    assert_eq!(out_v[1], 0x80);\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":420,"cache_read_input_tokens":144816,"cache_creation":{"ephemeral_5m_input_tokens":420,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f569a2af-11b3-4b9d-98ff-be64e8afe6cc","uuid":"543ceea2-f506-4fd3-91f1-80f926d0054a"}
