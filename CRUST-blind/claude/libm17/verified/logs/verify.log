  exit(1);\n149\t    }\n150\t\n151\t    uint16_t val=roundf((float)0xFFFF*sum_errs/num_errs);\n152\t    uint32_t err_loc=0;\n153\t\n154\t    for(uint8_t i=0; i<num_errs; i++)\n155\t    {\n156\t        //assure we didnt select the same bit more than once\n157\t        do\n158\t        {\n159\t            bit_pos=start_pos+(rand()%num_bits);\n160\t        }\n161\t        while(err_loc&(1<<bit_pos));\n162\t        \n163\t        vect[bit_pos]^=val; //apply error\n164\t        err_loc|=(1<<bit_pos);\n165\t    }\n166\t}\n167\t\n168\tvoid golay_encode(void)\n169\t{\n170\t    uint16_t data=0x0800;\n171\t\n172\t    //single-bit data\n173\t    for(uint8_t i=sizeof(encode_matrix)/sizeof(uint16_t)-1; i>0; i--)\n174\t    {\n175\t        TEST_ASSERT_EQUAL(((uint32_t)data<<12)|encode_matrix[i], golay24_encode(data));\n176\t        data>>=1;\n177\t    }\n178\t\n179\t    //test data vector\n180\t    data=0x0D78;\n181\t    TEST_ASSERT_EQUAL(0x0D7880FU, golay24_encode(data));\n182\t}\n183\t\n184\t/**\n185\t * @brief Golay soft-decode one known codeword.\n186\t * \n187\t */\n188\tvoid golay_soft_decode_clean(void)\n189\t{\n190\t    uint16_t vector[24];\n191\t\n192\t    //clean D78|80F\n193\t    for(uint8_t i=0; i<24; i++)\n194\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n195\t\n196\t    TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n197\t}\n198\t\n199\tvoid golay_soft_decode_flipped_parity_1(void)\n200\t{\n201\t    uint16_t vector[24]; //soft-logic 24-bit vector\n202\t\n203\t    //clean D78|80F to soft-logic data\n204\t    for(uint8_t i=0; i<24; i++)\n205\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n206\t\n207\t    for(uint16_t j=0; j<1000; j++)\n208\t    {\n209\t        apply_errors(vector, 0, 11, 1, 1.0);\n210\t        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n211\t        for(uint8_t i=0; i<24; i++)\n212\t            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n213\t    }\n214\t}\n215\t\n216\tvoid golay_soft_decode_erased_parity_1(void)\n217\t{\n218\t    uint