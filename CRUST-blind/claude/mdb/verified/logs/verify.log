{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VTT5To2h6WNsFvUh9ECEaJ","type":"tool_result","content":"1\tuse std::fs::{File, OpenOptions};\n2\tuse std::io::{self, Read, Seek, SeekFrom, Write};\n3\tuse std::path::{Path, PathBuf};\n4\tconst DB_NAME_MAX: usize = 128; // Assuming a reasonable maximum length\n5\ttype MdbPtr = u32;\n6\ttype MdbSize = u32;\n7\tconst MDB_PTR_SIZE: usize = std::mem::size_of::<MdbPtr>();\n8\tconst MDB_DATALEN_SIZE: usize = std::mem::size_of::<MdbSize>();\n9\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n10\tpub enum MdbStatusCode {\n11\t    MDB_OK = 0,\n12\t    MDB_NO_KEY,\n13\t    MDB_ERR_CRITICAL,\n14\t    MDB_ERR_LOGIC,\n15\t    MDB_ERR_FLUSH,\n16\t    MDB_ERR_OPEN_FILE,\n17\t    MDB_ERR_READ,\n18\t    MDB_ERR_WRITE,\n19\t    MDB_ERR_ALLOC,\n20\t    MDB_ERR_SEEK,\n21\t    MDB_ERR_BUFSIZ,\n22\t    MDB_ERR_KEY_SIZE,\n23\t    MDB_ERR_VALUE_SIZE,\n24\t    MDB_ERR_UNIMPLEMENTED = 100,\n25\t}\n26\t#[derive(Debug, Clone)]\n27\tpub struct MdbOptions {\n28\t    pub db_name: String,\n29\t    pub key_size_max: u16,\n30\t    pub data_size_max: u32,\n31\t    pub hash_buckets: u32,\n32\t    pub items_max: u32,\n33\t}\n34\t#[derive(Debug)]\n35\tpub struct MdbStatus{\n36\t    pub code: u8,\n37\t    pub desc: String,\n38\t}\n39\t#[derive(Debug)]\n40\tpub enum MdbError {\n41\t    Io(io::Error),\n42\t    AllocationFailed,\n43\t    BufferSizeTooSmall,\n44\t    KeyNotFound,\n45\t    KeySizeTooLarge,\n46\t    ValueSizeTooLarge,\n47\t}\n48\timpl From<io::Error> for MdbError {\n49\t    fn from(error: io::Error) -> Self {\n50\t        MdbError::Io(error)\n51\t    }\n52\t}\n53\tpub type Result<T> = std::result::Result<T, MdbError>;\n54\tstruct MdbIndex {\n55\t    next_ptr: MdbPtr,\n56\t    value_ptr: MdbPtr,\n57\t    value_size: MdbSize,\n58\t    key: Vec<u8>,\n59\t}\n60\tpub struct Mdb {\n61\t    db_name: String,\n62\t    fp_superblock: File,\n63\t    fp_index: File,\n64\t    fp_data: File,\n65\t    options: MdbOptions,\n66\t    index_record_size: u32,\n67\t}\n68\t\n69\tfn build_path<P: AsRef<Path>>(base: P, suffix: &str) -> PathBuf {\n70\t    let mut s = base.as_ref().as_os_str().to_owned();\n71\t    s.push(suffix);\n72\t    PathBuf::from(s)\n73\t}\n74\t\n75\timpl Mdb {\n76\t    pub fn open<P: AsRef<Path>>(path: P) -> Result<Self> {\n77\t        let super_path = build_path(&path, \".db.super\");\n78\t        let index_path = build_path(&path, \".db.index\");\n79\t        let data_path = build_path(&path, \".db.data\");\n80\t\n81\t        let mut fp_super = File::open(&super_path)?;\n82\t        let mut content = String::new();\n83\t        fp_super.read_to_string(&mut content)?;\n84\t\n85\t        let mut tokens = content.split_whitespace();\n86\t        let invalid_data = || io::Error::new(io::ErrorKind::InvalidData, \"invalid superblock\");\n87\t        let db_name = tokens\n88\t            .next()\n89\t            .ok_or_else(invalid_data)?\n90\t            .to_string();\n91\t        // Limit db_name to DB_NAME_MAX as a safety measure (mirrors C's allocation).\n92\t        let db_name = if db_name.len() > DB_NAME_MAX {\n93\t            db_name[..DB_NAME_MAX].to_string()\n94\t        } else {\n95\t            db_name\n96\t        };\n97\t        let key_size_max: u16 = tokens\n98\t            .next()\n99\t            .ok_or_else(invalid_data)?\n100\t            .parse()\n101\t            .map_err(|_| MdbError::Io(invalid_data()))?;\n102\t        let data_size_max: u32 = tokens\n103\t            .next()\n104\t            .ok_or_else(invalid_data)?\n105\t            .parse()\n106\t            .map_err(|_| MdbError::Io(invalid_data()))?;\n107\t        let hash_buckets: u32 = tokens\n108\t            .next()\n109\t            .ok_or_else(invalid_data)?\n110\t            .parse()\n111\t            .map_err(|_| MdbError::Io(invalid_data()))?;\n112\t        let items_max: u32 = tokens\n113\t            .next()\n114\t            .ok_or_else(invalid_data)?\n115\t            .parse()\n116\t            .map_err(|_| MdbError::Io(invalid_data()))?;\n117\t\n118\t        let options = MdbOptions {\n119\t            db_name: db_name.clone(),\n120\t            key_size_max,\n121\t            data_size_max,\n122\t            hash_buckets,\n123\t            items_max,\n124\t        };\n125\t\n126\t        let index_record_size = (key_size_max as u32)\n127\t            + (MDB_PTR_SIZE as u32) * 2\n128\t            + (MDB_DATALEN_SIZE as u32);\n129\t\n130\t        let fp_index = OpenOptions::new()\n131\t            .read(true)\n132\t            .write(true)\n133\t            .open(&index_path)?;\n134\t        let fp_data = OpenOptions::new()\n135\t            .read(true)\n136\t            .write(true)\n137\t            .open(&data_path)?;\n138\t\n139\t        Ok(Self {\n140\t            db_name,\n141\t            fp_superblock: fp_super,\n142\t            fp_index,\n143\t            fp_data,\n144\t            options,\n145\t            index_record_size,\n146\t        })\n147\t    }\n148\t\n149\t    pub fn create<P: AsRef<Path>>(path: P, options: MdbOptions) -> Result<Self> {\n150\t        let super_path = build_path(&path, \".db.super\");\n151\t        let index_path = build_path(&path, \".db.index\");\n152\t        let data_path = build_path(&path, \".db.data\");\n153\t\n154\t        let mut fp_super = OpenOptions::new()\n155\t            .read(true)\n156\t            .write(true)\n157\t            .create(true)\n158\t            .truncate(true)\n159\t            .open(&super_path)?;\n160\t\n161\t        // Write superblock metadata as whitespace-separated tokens.\n162\t        write!(\n163\t            fp_super,\n164\t            \"{}\\n{}\\n{}\\n{}\\n{}\\n\",\n165\t            options.db_name,\n166\t            options.key_size_max,\n167\t            options.data_size_max,\n168\t            options.hash_buckets,\n169\t            options.items_max\n170\t        )?;\n171\t        fp_super.flush()?;\n172\t\n173\t        let mut fp_index = OpenOptions::new()\n174\t            .read(true)\n175\t            .write(true)\n176\t            .create(true)\n177\t            .truncate(true)\n178\t            .open(&index_path)?;\n179\t\n180\t        // Write zero free pointer + zero hash buckets.\n181\t        let zero_ptr: MdbPtr = 0;\n182\t        fp_index.write_all(&zero_ptr.to_le_bytes())?;\n183\t        let zero_bucket = vec![0u8; MDB_PTR_SIZE];\n184\t        for _ in 0..options.hash_buckets {\n185\t            fp_index.write_all(&zero_bucket)?;\n186\t        }\n187\t        fp_index.flush()?;\n188\t\n189\t        let fp_data = OpenOptions::new()\n190\t            .read(true)\n191\t            .write(true)\n192\t            .create(true)\n193\t            .truncate(true)\n194\t            .open(&data_path)?;\n195\t\n196\t        let index_record_size = (options.key_size_max as u32)\n197\t            + (MDB_PTR_SIZE as u32) * 2\n198\t            + (MDB_DATALEN_SIZE as u32);\n199\t        let db_name = options.db_name.clone();\n200\t\n201\t        Ok(Self {\n202\t            db_name,\n203\t            fp_superblock: fp_super,\n204\t            fp_index,\n205\t            fp_data,\n206\t            options,\n207\t            index_record_size,\n208\t        })\n209\t    }\n210\t\n211\t    pub fn read(&mut self, key: &str, buf: &mut [u8]) -> Result<usize> {\n212\t        if self.options.hash_buckets == 0 {\n213\t            return Err(MdbError::KeyNotFound);\n214\t        }\n215\t        let bucket = self.hash(key) % self.options.hash_buckets;\n216\t        let mut ptr = self.read_bucket(bucket)?;\n217\t\n218\t        while ptr != 0 {\n219\t            let index = self.read_index(ptr)?;\n220\t            if Self::key_matches(&index.key, key.as_bytes()) {\n221\t                return self.read_data(index.value_ptr, index.value_size, buf);\n222\t            }\n223\t            ptr = index.next_ptr;\n224\t        }\n225\t\n226\t        Err(MdbError::KeyNotFound)\n227\t    }\n228\t\n229\t    pub fn write(&mut self, key: &str, value: &str) -> Result<()> {\n230\t        if key.len() > self.options.key_size_max as usize {\n231\t            return Err(MdbError::KeySizeTooLarge);\n232\t        }\n233\t        if value.len() > self.options.data_size_max as usize {\n234\t            return Err(MdbError::ValueSizeTooLarge);\n235\t        }\n236\t        if self.options.hash_buckets == 0 {\n237\t            // Without hash buckets there is nowhere to chain entries.\n238\t            return Err(MdbError::AllocationFailed);\n239\t        }\n240\t\n241\t        let bucket = self.hash(key) % self.options.hash_buckets;\n242\t        let value_size = value.len() as MdbSize;\n243\t\n244\t        let mut save_ptr: MdbPtr =\n245\t            (MDB_PTR_SIZE as MdbPtr).wrapping_mul(bucket.wrapping_add(1));\n246\t        let mut ptr = self.read_bucket(bucket)?;\n247\t        let mut existing: Option<MdbIndex> = None;\n248\t\n249\t        while ptr != 0 {\n250\t            let index = self.read_index(ptr)?;\n251\t            if Self::key_matches(&index.key, key.as_bytes()) {\n252\t                existing = Some(index);\n253\t                break;\n254\t            }\n255\t            save_ptr = ptr;\n256\t            ptr = index.next_ptr;\n257\t        }\n258\t\n259\t        if ptr == 0 {\n260\t            // New entry path.\n261\t            let mut index_ptr: MdbPtr = 0;\n262\t            self.index_alloc(&mut index_ptr)?;\n263\t\n264\t            let mut value_ptr: MdbPtr = 0;\n265\t            if let Err(e) = self.data_alloc(value_size, &mut value_ptr) {\n266\t                let _ = self.index_free(index_ptr);\n267\t                return Err(e);\n268\t            }\n269\t\n270\t            if let Err(e) = self.write_data(value_ptr, value.as_bytes(), value_size) {\n271\t                let _ = self.data_free(value_ptr, value_size);\n272\t                let _ = self.index_free(index_ptr);\n273\t                return Err(e);\n274\t            }\n275\t\n276\t            if let Err(e) =\n277\t                self.write_index(index_ptr, key.as_bytes(), value_ptr, value_size)\n278\t            {\n279\t                let _ = self.data_free(value_ptr, value_size);\n280\t                let _ = self.index_free(index_ptr);\n281\t                return Err(e);\n282\t            }\n283\t\n284\t            if let Err(e) = self.write_nextptr(save_ptr, index_ptr) {\n285\t                let _ = self.data_free(value_ptr, value_size);\n286\t                let _ = self.index_free(index_ptr);\n287\t                return Err(e);\n288\t            }\n289\t            Ok(())\n290\t        } else {\n291\t            // Update path: free old data, allocate new, rewrite index.\n292\t            let existing = existing.expect(\"existing index must be set\");\n293\t            self.data_free(existing.value_ptr, existing.value_size)?;\n294\t\n295\t            let mut value_ptr: MdbPtr = 0;\n296\t            self.data_alloc(value_size, &mut value_ptr)?;\n297\t            self.write_data(value_ptr, value.as_bytes(), value_size)?;\n298\t            self.write_index(ptr, key.as_bytes(), value_ptr, value_size)?;\n299\t            Ok(())\n300\t        }\n301\t    }\n302\t\n303\t    pub fn delete(&mut self, key: &str) -> Result<()> {\n304\t        if self.options.hash_buckets == 0 {\n305\t            return Err(MdbError::KeyNotFound);\n306\t        }\n307\t        let bucket = self.hash(key) % self.options.hash_buckets;\n308\t        let mut save_ptr: MdbPtr =\n309\t            (MDB_PTR_SIZE as MdbPtr).wrapping_mul(bucket.wrapping_add(1));\n310\t        let mut ptr = self.read_bucket(bucket)?;\n311\t        let mut found: Option<(MdbPtr, MdbIndex)> = None;\n312\t\n313\t        while ptr != 0 {\n314\t            let index = self.read_index(ptr)?;\n315\t            if Self::key_matches(&index.key, key.as_bytes()) {\n316\t                found = Some((ptr, index));\n317\t                break;\n318\t            }\n319\t            save_ptr = ptr;\n320\t            ptr = index.next_ptr;\n321\t        }\n322\t\n323\t        let (found_ptr, index) = match found {\n324\t            Some(x) => x,\n325\t            None => return Err(MdbError::KeyNotFound),\n326\t        };\n327\t\n328\t        self.data_free(index.value_ptr, index.value_size)?;\n329\t        self.index_free(found_ptr)?;\n330\t        self.write_nextptr(save_ptr, index.next_ptr)?;\n331\t\n332\t        Ok(())\n333\t    }\n334\t\n335\t    pub fn get_options(&self) -> &MdbOptions {\n336\t        &self.options\n337\t    }\n338\t\n339\t    pub fn index_size(&mut self) -> Result<u64> {\n340\t        let pos = self.fp_index.seek(SeekFrom::End(0))?;\n341\t        Ok(pos)\n342\t    }\n343\t\n344\t    pub fn data_size(&mut self) -> Result<u64> {\n345\t        let pos = self.fp_data.seek(SeekFrom::End(0))?;\n346\t        Ok(pos)\n347\t    }\n348\t\n349\t    // Private helper methods\n350\t    fn read_bucket(&mut self, bucket: u32) -> Result<MdbPtr> {\n351\t        let offset = (MDB_PTR_SIZE as u64) * ((bucket as u64) + 1);\n352\t        self.fp_index.seek(SeekFrom::Start(offset))?;\n353\t        let mut buf = [0u8; MDB_PTR_SIZE];\n354\t        self.fp_index.read_exact(&mut buf)?;\n355\t        Ok(MdbPtr::from_le_bytes(buf))\n356\t    }\n357\t\n358\t    fn read_index(&mut self, idxptr: MdbPtr) -> Result<MdbIndex> {\n359\t        self.fp_index.seek(SeekFrom::Start(idxptr as u64))?;\n360\t\n361\t        let mut next_buf = [0u8; MDB_PTR_SIZE];\n362\t        self.fp_index.read_exact(&mut next_buf)?;\n363\t        let next_ptr = MdbPtr::from_le_bytes(next_buf);\n364\t\n365\t        let key_max = self.options.key_size_max as usize;\n366\t        let mut key = vec![0u8; key_max + 1];\n367\t        self.fp_index.read_exact(&mut key[..key_max])?;\n368\t        // The trailing slot key[key_max] stays 0 to act as a null terminator.\n369\t\n370\t        let mut vp_buf = [0u8; MDB_PTR_SIZE];\n371\t        self.fp_index.read_exact(&mut vp_buf)?;\n372\t        let value_ptr = MdbPtr::from_le_bytes(vp_buf);\n373\t\n374\t        let mut vs_buf = [0u8; MDB_DATALEN_SIZE];\n375\t        self.fp_index.read_exact(&mut vs_buf)?;\n376\t        let value_size = MdbSize::from_le_bytes(vs_buf);\n377\t\n378\t        Ok(MdbIndex {\n379\t            next_ptr,\n380\t            value_ptr,\n381\t            value_size,\n382\t            key,\n383\t        })\n384\t    }\n385\t\n386\t    fn write_bucket(&mut self, bucket: u32, ptr: MdbPtr) -> Result<()> {\n387\t        let offset = (MDB_PTR_SIZE as u64) * ((bucket as u64) + 1);\n388\t        self.fp_index.seek(SeekFrom::Start(offset))?;\n389\t        self.fp_index.write_all(&ptr.to_le_bytes())?;\n390\t        self.fp_index.flush()?;\n391\t        Ok(())\n392\t    }\n393\t\n394\t    fn write_index(\n395\t        &mut self,\n396\t        idxptr: MdbPtr,\n397\t        key: &[u8],\n398\t        value_ptr: MdbPtr,\n399\t        value_size: MdbSize,\n400\t    ) -> Result<()> {\n401\t        // Skip past next_ptr.\n402\t        let key_offset = (idxptr as u64) + (MDB_PTR_SIZE as u64);\n403\t        self.fp_index.seek(SeekFrom::Start(key_offset))?;\n404\t        // Mirror C: write strlen(key) bytes for the key, leaving any extra\n405\t        // bytes already present (which will be zero from index_alloc).\n406\t        let key_max = self.options.key_size_max as usize;\n407\t        let key_len = key.len().min(key_max);\n408\t        self.fp_index.write_all(&key[..key_len])?;\n409\t\n410\t        let value_ptr_pos = key_offset + key_max as u64;\n411\t        self.fp_index.seek(SeekFrom::Start(value_ptr_pos))?;\n412\t        self.fp_index.write_all(&value_ptr.to_le_bytes())?;\n413\t        self.fp_index.write_all(&value_size.to_le_bytes())?;\n414\t        self.fp_index.flush()?;\n415\t        Ok(())\n416\t    }\n417\t\n418\t    fn read_nextptr(&mut self, idxptr: MdbPtr) -> Result<MdbPtr> {\n419\t        self.fp_index.seek(SeekFrom::Start(idxptr as u64))?;\n420\t        let mut buf = [0u8; MDB_PTR_SIZE];\n421\t        self.fp_index.read_exact(&mut buf)?;\n422\t        Ok(MdbPtr::from_le_bytes(buf))\n423\t    }\n424\t\n425\t    fn write_nextptr(&mut self, ptr: MdbPtr, nextptr: MdbPtr) -> Result<()> {\n426\t        self.fp_index.seek(SeekFrom::Start(ptr as u64))?;\n427\t        self.fp_index.write_all(&nextptr.to_le_bytes())?;\n428\t        self.fp_index.flush()?;\n429\t        Ok(())\n430\t    }\n431\t\n432\t    fn read_data(\n433\t        &mut self,\n434\t        valptr: MdbPtr,\n435\t        valsize: MdbSize,\n436\t        buf: &mut [u8],\n437\t    ) -> Result<usize> {\n438\t        if (buf.len() as u64) < (valsize as u64) + 1 {\n439\t            return Err(MdbError::BufferSizeTooSmall);\n440\t        }\n441\t        self.fp_data.seek(SeekFrom::Start(valptr as u64))?;\n442\t        self.fp_data.read_exact(&mut buf[..valsize as usize])?;\n443\t        if (valsize as usize) < buf.len() {\n444\t            buf[valsize as usize] = 0;\n445\t        }\n446\t        Ok(valsize as usize)\n447\t    }\n448\t\n449\t    fn write_data(\n450\t        &mut self,\n451\t        valptr: MdbPtr,\n452\t        value: &[u8],\n453\t        valsize: MdbSize,\n454\t    ) -> Result<()> {\n455\t        let n = valsize as usize;\n456\t        if value.len() < n {\n457\t            return Err(MdbError::Io(io::Error::new(\n458\t                io::ErrorKind::InvalidInput,\n459\t                \"value buffer too small for declared size\",\n460\t            )));\n461\t        }\n462\t        self.fp_data.seek(SeekFrom::Start(valptr as u64))?;\n463\t        self.fp_data.write_all(&value[..n])?;\n464\t        self.fp_data.flush()?;\n465\t        Ok(())\n466\t    }\n467\t\n468\t    fn stretch_index_file(&mut self, ptr: &mut MdbPtr) -> Result<()> {\n469\t        let pos = self.fp_index.seek(SeekFrom::End(0))?;\n470\t        *ptr = pos as MdbPtr;\n471\t        let zeros = vec![0u8; self.index_record_size as usize];\n472\t        self.fp_index.write_all(&zeros)?;\n473\t        self.fp_index.flush()?;\n474\t        Ok(())\n475\t    }\n476\t\n477\t    fn index_alloc(&mut self, ptr: &mut MdbPtr) -> Result<()> {\n478\t        let freeptr = self.read_nextptr(0)?;\n479\t        if freeptr != 0 {\n480\t            let new_freeptr = self.read_nextptr(freeptr)?;\n481\t            self.write_nextptr(0, new_freeptr)?;\n482\t            self.write_nextptr(freeptr, 0)?;\n483\t            *ptr = freeptr;\n484\t            Ok(())\n485\t        } else {\n486\t            self.stretch_index_file(ptr)\n487\t        }\n488\t    }\n489\t\n490\t    fn data_alloc(&mut self, size: MdbSize, ptr: &mut MdbPtr) -> Result<()> {\n491\t        self.fp_data.seek(SeekFrom::Start(0))?;\n492\t        let mut byte = [0u8; 1];\n493\t        let mut at_eof = false;\n494\t\n495\t        loop {\n496\t            // Initial read of one byte for this iteration.\n497\t            let n = self.fp_data.read(&mut byte)?;\n498\t            if n == 0 {\n499\t                at_eof = true;\n500\t            }\n501\t\n502\t            // Skip non-zero bytes.\n503\t            while !at_eof && byte[0] != 0 {\n504\t                let n = self.fp_data.read(&mut byte)?;\n505\t                if n == 0 {\n506\t                    at_eof = true;\n507\t                }\n508\t            }\n509\t\n510\t            let start_ptr = self.fp_data.stream_position()? as MdbPtr;\n511\t\n512\t            // Skip zero bytes.\n513\t            while !at_eof && byte[0] == 0 {\n514\t                let n = self.fp_data.read(&mut byte)?;\n515\t                if n == 0 {\n516\t                    at_eof = true;\n517\t                }\n518\t            }\n519\t\n520\t            let end_ptr = self.fp_data.stream_position()? as MdbPtr;\n521\t\n522\t            let span = end_ptr.wrapping_sub(start_ptr);\n523\t            let needed = size.wrapping_add(2);\n524\t            if span >= needed {\n525\t                *ptr = start_ptr.wrapping_add(1);\n526\t                return Ok(());\n527\t            }\n528\t\n529\t            if at_eof {\n530\t                break;\n531\t            }\n532\t        }\n533\t\n534\t        // No suitable free run found; extend the file.\n535\t        let end_ptr = self.fp_data.stream_position()? as MdbPtr;\n536\t        let zeros = vec![0u8; size as usize];\n537\t        self.fp_data.write_all(&zeros)?;\n538\t        self.fp_data.flush()?;\n539\t        *ptr = end_ptr;\n540\t        Ok(())\n541\t    }\n542\t\n543\t    fn index_free(&mut self, ptr: MdbPtr) -> Result<()> {\n544\t        // Read current freeptr from start of index file.\n545\t        self.fp_index.seek(SeekFrom::Start(0))?;\n546\t        let mut freeptr_buf = [0u8; MDB_PTR_SIZE];\n547\t        self.fp_index.read_exact(&mut freeptr_buf)?;\n548\t        let freeptr = MdbPtr::from_le_bytes(freeptr_buf);\n549\t\n550\t        // Set freeptr to the freed slot.\n551\t        self.fp_index.seek(SeekFrom::Start(0))?;\n552\t        self.fp_index.write_all(&ptr.to_le_bytes())?;\n553\t\n554\t        // The freed slot's next_ptr links to old freeptr.\n555\t        self.fp_index.seek(SeekFrom::Start(ptr as u64))?;\n556\t        self.fp_index.write_all(&freeptr.to_le_bytes())?;\n557\t\n558\t        // Zero out the key region of the freed slot.\n559\t        let zeros = vec![0u8; self.options.key_size_max as usize];\n560\t        self.fp_index.write_all(&zeros)?;\n561\t\n562\t        self.fp_index.flush()?;\n563\t        Ok(())\n564\t    }\n565\t\n566\t    fn data_free(&mut self, ptr: MdbPtr, size: MdbSize) -> Result<()> {\n567\t        self.fp_data.seek(SeekFrom::Start(ptr as u64))?;\n568\t        let zeros = vec![0u8; size as usize];\n569\t        self.fp_data.write_all(&zeros)?;\n570\t        self.fp_data.flush()?;\n571\t        Ok(())\n572\t    }\n573\t\n574\t    fn alloc() -> Result<()> {\n575\t        // Memory allocation happens automatically via Rust's RAII; nothing to do.\n576\t        Ok(())\n577\t    }\n578\t\n579\t    fn free() -> Result<()> {\n580\t        // Memory is reclaimed via Drop; nothing explicit to do.\n581\t        Ok(())\n582\t    }\n583\t\n584\t    fn hash(&self, key: &str) -> u32 {\n585\t        let mut ret: u32 = 0;\n586\t        for (i, b) in key.as_bytes().iter().enumerate() {\n587\t            // Match the C semantics where `char` is signed on common platforms:\n588\t            // (uint32_t)*key sign-extends the byte before promotion.\n589\t            let c = ((*b as i8) as i32) as u32;\n590\t            ret = ret.wrapping_add(c.wrapping_mul(i as u32));\n591\t        }\n592\t        ret\n593\t    }\n594\t\n595\t    fn close(&mut self) -> Result<()> {\n596\t        self.fp_superblock.flush()?;\n597\t        self.fp_index.flush()?;\n598\t        self.fp_data.flush()?;\n599\t        Ok(())\n600\t    }\n601\t\n602\t    fn key_matches(stored_key: &[u8], target: &[u8]) -> bool {\n603\t        // The stored key is null-terminated; compare up to the first 0 byte.\n604\t        let end = stored_key.iter().position(|&b| b == 0).unwrap_or(stored_key.len());\n605\t        &stored_key[..end] == target\n606\t    }\n607\t}\n608\t// impl Mdb\n609\tpub fn mdb_status() -> Result<MdbStatus> {\n610\t    Ok(MdbStatus {\n611\t        code: MdbStatusCode::MDB_OK as u8,\n612\t        desc: String::new(),\n613\t    })\n614\t}\n615\t"}]},"parent_tool_use_id":null,"session_id":"d058e1b6-7d59-4928-a138-fe59de849fb5","uuid":"1a3608c3-49ef-4905-a2dc-560b326201d9","timestamp":"2026-05-29T18:50:15.326Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-DU4ozK/project/src/mdb.rs","content":"use std::fs::{File, OpenOptions};\nuse std::io::{self, Read, Seek, SeekFrom, Write};\nuse std::path::{Path, PathBuf};\nconst DB_NAME_MAX: usize = 128; // Assuming a reasonable maximum length\ntype MdbPtr = u32;\ntype MdbSize = u32;\nconst MDB_PTR_SIZE: usize = std::mem::size_of::<MdbPtr>();\nconst MDB_DATALEN_SIZE: usize = std::mem::size_of::<MdbSize>();\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\npub enum MdbStatusCode {\n    MDB_OK = 0,\n    MDB_NO_KEY,\n    MDB_ERR_CRITICAL,\n    MDB_ERR_LOGIC,\n    MDB_ERR_FLUSH,\n    MDB_ERR_OPEN_FILE,\n    MDB_ERR_READ,\n    MDB_ERR_WRITE,\n    MDB_ERR_ALLOC,\n    MDB_ERR_SEEK,\n    MDB_ERR_BUFSIZ,\n    MDB_ERR_KEY_SIZE,\n    MDB_ERR_VALUE_SIZE,\n    MDB_ERR_UNIMPLEMENTED = 100,\n}\n#[derive(Debug, Clone)]\npub struct MdbOptions {\n    pub db_name: String,\n    pub key_size_max: u16,\n    pub data_size_max: u32,\n    pub hash_buckets: u32,\n    pub items_max: u32,\n}\n#[derive(Debug)]\npub struct MdbStatus{\n    pub code: u8,\n    pub desc: String,\n}\n#[derive(Debug)]\npub enum MdbError {\n    Io(io::Error),\n    AllocationFailed,\n    BufferSizeTooSmall,\n    KeyNotFound,\n    KeySizeTooLarge,\n    ValueSizeTooLarge,\n}\nimpl From<io::Error> for MdbError {\n    fn from(error: io::Error) -> Self {\n        MdbError::Io(error)\n    }\n}\npub type Result<T> = std::result::Result<T, MdbError>;\nstruct MdbIndex {\n    next_ptr: MdbPtr,\n    value_ptr: MdbPtr,\n    value_size: MdbSize,\n    key: Vec<u8>,\n}\npub struct Mdb {\n    db_name: String,\n    fp_superblock: File,\n    fp_index: File,\n    fp_data: File,\n    options: MdbOptions,\n    index_record_size: u32,\n}\n\nfn build_path<P: AsRef<Path>>(base: P, suffix: &str) -> PathBuf {\n    let mut s = base.as_ref().as_os_str().to_owned();\n    s.push(suffix);\n    PathBuf::from(s)\n}\n\nimpl Mdb {\n    pub fn open<P: AsRef<Path>>(path: P) -> Result<Self> {\n        let super_path = build_path(&path, \".db.super\");\n        let index_path = build_path(&path, \".db.index\");\n        let data_path = build_path(&path, \".db.data\");\n\n        let mut fp_super = File::open(&super_path)?;\n        let mut content = String::new();\n        fp_super.read_to_string(&mut content)?;\n\n        let mut tokens = content.split_whitespace();\n        let invalid_data = || io::Error::new(io::ErrorKind::InvalidData, \"invalid superblock\");\n        let db_name = tokens\n            .next()\n            .ok_or_else(invalid_data)?\n            .to_string();\n        // Limit db_name to DB_NAME_MAX as a safety measure (mirrors C's allocation).\n        let db_name = if db_name.len() > DB_NAME_MAX {\n            db_name[..DB_NAME_MAX].to_string()\n        } else {\n            db_name\n        };\n        let key_size_max: u16 = tokens\n            .next()\n            .ok_or_else(invalid_data)?\n            .parse()\n            .map_err(|_| MdbError::Io(invalid_data()))?;\n        let data_size_max: u32 = tokens\n            .next()\n            .ok_or_else(invalid_data)?\n            .parse()\n            .map_err(|_| MdbError::Io(invalid_data()))?;\n        let hash_buckets: u32 = tokens\n            .next()\n            .ok_or_else(invalid_data)?\n            .parse()\n            .map_err(|_| MdbError::Io(invalid_data()))?;\n        let items_max: u32 = tokens\n            .next()\n            .ok_or_else(invalid_data)?\n            .parse()\n            .map_err(|_| MdbError::Io(invalid_data()))?;\n\n        let options = MdbOptions {\n            db_name: db_name.clone(),\n            key_size_max,\n            data_size_max,\n            hash_buckets,\n            items_max,\n        };\n\n        let index_record_size = (key_size_max as u32)\n            + (MDB_PTR_SIZE as u32) * 2\n            + (MDB_DATALEN_SIZE as u32);\n\n        let fp_index = OpenOptions::new()\n            .read(true)\n            .write(true)\n            .open(&index_path)?;\n        let fp_data = OpenOptions::new()\n            .read(true)\n            .write(true)\n            .open(&data_path)?;\n\n        Ok(Self {\n            db_name,\n            fp_superblock: fp_super,\n            fp_index,\n            fp_data,\n            options,\n            index_record_size,\n        })\n    }\n\n    pub fn create<P: AsRef<Path>>(path: P, options: MdbOptions) -> Result<Self> {\n        let super_path = build_path(&path, \".db.super\");\n        let index_path = build_path(&path, \".db.index\");\n        let data_path = build_path(&path, \".db.data\");\n\n        let mut fp_super = OpenOptions::new()\n            .read(true)\n            .write(true)\n            .create(true)\n            .truncate(true)\n            .open(&super_path)?;\n\n        // Write superblock metadata as whitespace-separated tokens.\n        write!(\n            fp_super,\n            \"{}\\n{}\\n{}\\n{}\\n{}\\n\",\n            options.db_name,\n            options.key_size_max,\n            options.data_size_max,\n            options.hash_buckets,\n            options.items_max\n        )?;\n        fp_super.flush()?;\n\n        let mut fp_index = OpenOptions::new()\n            .read(true)\n            .write(true)\n            .create(true)\n            .truncate(true)\n            .open(&index_path)?;\n\n        // Write zero free pointer + zero hash buckets.\n        let zero_ptr: MdbPtr = 0;\n        fp_index.write_all(&zero_ptr.to_le_bytes())?;\n        let zero_bucket = vec![0u8; MDB_PTR_SIZE];\n        for _ in 0..options.hash_buckets {\n            fp_index.write_all(&zero_bucket)?;\n        }\n        fp_index.flush()?;\n\n        let fp_data = OpenOptions::new()\n            .read(true)\n            .write(true)\n            .create(true)\n            .truncate(true)\n            .open(&data_path)?;\n\n        let index_record_size = (options.key_size_max as u32)\n            + (MDB_PTR_SIZE as u32) * 2\n            + (MDB_DATALEN_SIZE as u32);\n        let db_name = options.db_name.clone();\n\n        Ok(Self {\n            db_name,\n            fp_superblock: fp_super,\n            fp_index,\n            fp_data,\n            options,\n            index_record_size,\n        })\n    }\n\n    pub fn read(&mut self, key: &str, buf: &mut [u8]) -> Result<usize> {\n        if self.options.hash_buckets == 0 {\n            return Err(MdbError::KeyNotFound);\n        }\n        let bucket = self.hash(key) % self.options.hash_buckets;\n        let mut ptr = self.read_bucket(bucket)?;\n\n        while ptr != 0 {\n            let index = self.read_index(ptr)?;\n            if Self::key_matches(&index.key, key.as_bytes()) {\n                return self.read_data(index.value_ptr, index.value_size, buf);\n            }\n            ptr = index.next_ptr;\n        }\n\n        Err(MdbError::KeyNotFound)\n    }\n\n    pub fn write(&mut self, key: &str, value: &str) -> Result<()> {\n        if key.len() > self.options.key_size_max as usize {\n            return Err(MdbError::KeySizeTooLarge);\n        }\n        if value.len() > self.options.data_size_max as usize {\n            return Err(MdbError::ValueSizeTooLarge);\n        }\n        if self.options.hash_buckets == 0 {\n            // Without hash buckets there is nowhere to chain entries.\n            return Err(MdbError::AllocationFailed);\n        }\n\n        let bucket = self.hash(key) % self.options.hash_buckets;\n        let value_size = value.len() as MdbSize;\n\n        let mut save_ptr: MdbPtr =\n            (MDB_PTR_SIZE as MdbPtr).wrapping_mul(bucket.wrapping_add(1));\n        let mut ptr = self.read_bucket(bucket)?;\n        let mut existing: Option<MdbIndex> = None;\n\n        while ptr != 0 {\n            let index = self.read_index(ptr)?;\n            if Self::key_matches(&index.key, key.as_bytes()) {\n                existing = Some(index);\n                break;\n            }\n            save_ptr = ptr;\n            ptr = index.next_ptr;\n        }\n\n        if ptr == 0 {\n            // New entry path.\n            let mut index_ptr: MdbPtr = 0;\n            self.index_alloc(&mut index_ptr)?;\n\n            let mut value_ptr: MdbPtr = 0;\n            if let Err(e) = self.data_alloc(value_size, &mut value_ptr) {\n                let _ = self.index_free(index_ptr);\n                return Err(e);\n            }\n\n            if let Err(e) = self.write_data(value_ptr, value.as_bytes(), value_size) {\n                let _ = self.data_free(value_ptr, value_size);\n                let _ = self.index_free(index_ptr);\n                return Err(e);\n            }\n\n            if let Err(e) =\n                self.write_index(index_ptr, key.as_bytes(), value_ptr, value_size)\n            {\n                let _ = self.data_free(value_ptr, value_size);\n                let _ = self.index_free(index_ptr);\n                return Err(e);\n            }\n\n            if let Err(e) = self.write_nextptr(save_ptr, index_ptr) {\n                let _ = self.data_free(value_ptr, value_size);\n                let _ = self.index_free(index_ptr);\n                return Err(e);\n            }\n            Ok(())\n        } else {\n            // Update path: free old data, allocate new, rewrite index.\n            let existing = existing.expect(\"existing index must be set\");\n            self.data_free(existing.value_ptr, existing.value_size)?;\n\n            let mut value_ptr: MdbPtr = 0;\n            self.data_alloc(value_size, &mut value_ptr)?;\n            self.write_data(value_ptr, value.as_bytes(), value_size)?;\n            self.write_index(ptr, key.as_bytes(), value_ptr, value_size)?;\n            Ok(())\n        }\n    }\n\n    pub fn delete(&mut self, key: &str) -> Result<()> {\n        if self.options.hash_buckets == 0 {\n            return Err(MdbError::KeyNotFound);\n        }\n        let bucket = self.hash(key) % self.options.hash_buckets;\n        let mut save_ptr: MdbPtr =\n            (MDB_PTR_SIZE as MdbPtr).wrapping_mul(bucket.wrapping_add(1));\n        let mut ptr = self.read_bucket(bucket)?;\n        let mut found: Option<(MdbPtr, MdbIndex)> = None;\n\n        while ptr != 0 {\n            let index = self.read_index(ptr)?;\n            if Self::key_matches(&index.key, key.as_bytes()) {\n                found = Some((ptr, index));\n                break;\n            }\n            save_ptr = ptr;\n            ptr = index.next_ptr;\n        }\n\n        let (found_ptr, index) = match found {\n            Some(x) => x,\n            None => return Err(MdbError::KeyNotFound),\n        };\n\n        self.data_free(index.value_ptr, index.value_size)?;\n        self.index_free(found_ptr)?;\n        self.write_nextptr(save_ptr, index.next_ptr)?;\n\n        Ok(())\n    }\n\n    pub fn get_options(&self) -> &MdbOptions {\n        &self.options\n    }\n\n    pub fn index_size(&mut self) -> Result<u64> {\n        let pos = self.fp_index.seek(SeekFrom::End(0))?;\n        Ok(pos)\n    }\n\n    pub fn data_size(&mut self) -> Result<u64> {\n        let pos = self.fp_data.seek(SeekFrom::End(0))?;\n        Ok(pos)\n    }\n\n    // Private helper methods\n    fn read_bucket(&mut self, bucket: u32) -> Result<MdbPtr> {\n        let offset = (MDB_PTR_SIZE as u64) * ((bucket as u64) + 1);\n        self.fp_index.seek(SeekFrom::Start(offset))?;\n        let mut buf = [0u8; MDB_PTR_SIZE];\n        self.fp_index.read_exact(&mut buf)?;\n        Ok(MdbPtr::from_le_bytes(buf))\n    }\n\n    fn read_index(&mut self, idxptr: MdbPtr) -> Result<MdbIndex> {\n        self.fp_index.seek(SeekFrom::Start(idxptr as u64))?;\n\n        let mut next_buf = [0u8; MDB_PTR_SIZE];\n        self.fp_index.read_exact(&mut next_buf)?;\n        let next_ptr = MdbPtr::from_le_bytes(next_buf);\n\n        let key_max = self.options.key_size_max as usize;\n        let mut key = vec![0u8; key_max + 1];\n        self.fp_index.read_exact(&mut key[..key_max])?;\n        // The trailing slot key[key_max] stays 0 to act as a null terminator.\n\n        let mut vp_buf = [0u8; MDB_PTR_SIZE];\n        self.fp_index.read_exact(&mut vp_buf)?;\n        let value_ptr = MdbPtr::from_le_bytes(vp_buf);\n\n        let mut vs_buf = [0u8; MDB_DATALEN_SIZE];\n        self.fp_index.read_exact(&mut vs_buf)?;\n        let value_size = MdbSize::from_le_bytes(vs_buf);\n\n        Ok(MdbIndex {\n            next_ptr,\n            value_ptr,\n            value_size,\n            key,\n        })\n    }\n\n    fn write_bucket(&mut self, bucket: u32, ptr: MdbPtr) -> Result<()> {\n        let offset = (MDB_PTR_SIZE as u64) * ((bucket as u64) + 1);\n        self.fp_index.seek(SeekFrom::Start(offset))?;\n        self.fp_index.write_all(&ptr.to_le_bytes())?;\n        self.fp_index.flush()?;\n        Ok(())\n    }\n\n    fn write_index(\n        &mut self,\n        idxptr: MdbPtr,\n        key: &[u8],\n        value_ptr: MdbPtr,\n        value_size: MdbSize,\n    ) -> Result<()> {\n        // Skip past next_ptr.\n        let key_offset = (idxptr as u64) + (MDB_PTR_SIZE as u64);\n        self.fp_index.seek(SeekFrom::Start(key_offset))?;\n        // Mirror C: write strlen(key) bytes for the key, leaving any extra\n        // bytes already present (which will be zero from index_alloc).\n        let key_max = self.options.key_size_max as usize;\n        let key_len = key.len().min(key_max);\n        self.fp_index.write_all(&key[..key_len])?;\n\n        let value_ptr_pos = key_offset + key_max as u64;\n        self.fp_index.seek(SeekFrom::Start(value_ptr_pos))?;\n        self.fp_index.write_all(&value_ptr.to_le_bytes())?;\n        self.fp_index.write_all(&value_size.to_le_bytes())?;\n        self.fp_index.flush()?;\n        Ok(())\n    }\n\n    fn read_nextptr(&mut self, idxptr: MdbPtr) -> Result<MdbPtr> {\n        self.fp_index.seek(SeekFrom::Start(idxptr as u64))?;\n        let mut buf = [0u8; MDB_PTR_SIZE];\n        self.fp_index.read_exact(&mut buf)?;\n        Ok(MdbPtr::from_le_bytes(buf))\n    }\n\n    fn write_nextptr(&mut self, ptr: MdbPtr, nextptr: MdbPtr) -> Result<()> {\n        self.fp_index.seek(SeekFrom::Start(ptr as u64))?;\n        self.fp_index.write_all(&nextptr.to_le_bytes())?;\n        self.fp_index.flush()?;\n        Ok(())\n    }\n\n    fn read_data(\n        &mut self,\n        valptr: MdbPtr,\n        valsize: MdbSize,\n        buf: &mut [u8],\n    ) -> Result<usize> {\n        if (buf.len() as u64) < (valsize as u64) + 1 {\n            return Err(MdbError::BufferSizeTooSmall);\n        }\n        self.fp_data.seek(SeekFrom::Start(valptr as u64))?;\n        self.fp_data.read_exact(&mut buf[..valsize as usize])?;\n        if (valsize as usize) < buf.len() {\n            buf[valsize as usize] = 0;\n        }\n        Ok(valsize as usize)\n    }\n\n    fn write_data(\n        &mut self,\n        valptr: MdbPtr,\n        value: &[u8],\n        valsize: MdbSize,\n    ) -> Result<()> {\n        let n = valsize as usize;\n        if value.len() < n {\n            return Err(MdbError::Io(io::Error::new(\n                io::ErrorKind::InvalidInput,\n                \"value buffer too small for declared size\",\n            )));\n        }\n        self.fp_data.seek(SeekFrom::Start(valptr as u64))?;\n        self.fp_data.write_all(&value[..n])?;\n        self.fp_data.flush()?;\n        Ok(())\n    }\n\n    fn stretch_index_file(&mut self, ptr: &mut MdbPtr) -> Result<()> {\n        let pos = self.fp_index.seek(SeekFrom::End(0))?;\n        *ptr = pos as MdbPtr;\n        let zeros = vec![0u8; self.index_record_size as usize];\n        self.fp_index.write_all(&zeros)?;\n        self.fp_index.flush()?;\n        Ok(())\n    }\n\n    fn index_alloc(&mut self, ptr: &mut MdbPtr) -> Result<()> {\n        let freeptr = self.read_nextptr(0)?;\n        if freeptr != 0 {\n            let new_freeptr = self.read_nextptr(freeptr)?;\n            self.write_nextptr(0, new_freeptr)?;\n            self.write_nextptr(freeptr, 0)?;\n            *ptr = freeptr;\n            Ok(())\n        } else {\n            self.stretch_index_file(ptr)\n        }\n    }\n\n    fn data_alloc(&mut self, size: MdbSize, ptr: &mut MdbPtr) -> Result<()> {\n        self.fp_data.seek(SeekFrom::Start(0))?;\n        let mut byte = [0u8; 1];\n        let mut at_eof = false;\n\n        loop {\n            // Initial read of one byte for this iteration.\n            let n = self.fp_data.read(&mut byte)?;\n            if n == 0 {\n                at_eof = true;\n            }\n\n            // Skip non-zero bytes.\n            while !at_eof && byte[0] != 0 {\n                let n = self.fp_data.read(&mut byte)?;\n                if n == 0 {\n                    at_eof = true;\n                }\n            }\n\n            let start_ptr = self.fp_data.stream_position()? as MdbPtr;\n\n            // Skip zero bytes.\n            while !at_eof && byte[0] == 0 {\n                let n = self.fp_data.read(&mut byte)?;\n                if n == 0 {\n                    at_eof = true;\n                }\n            }\n\n            let end_ptr = self.fp_data.stream_position()? as MdbPtr;\n\n            let span = end_ptr.wrapping_sub(start_ptr);\n            let needed = size.wrapping_add(2);\n            if span >= needed {\n                *ptr = start_ptr.wrapping_add(1);\n                return Ok(());\n            }\n\n            if at_eof {\n                break;\n            }\n        }\n\n        // No suitable free run found; extend the file.\n        let end_ptr = self.fp_data.stream_position()? as MdbPtr;\n        let zeros = vec![0u8; size as usize];\n        self.fp_data.write_all(&zeros)?;\n        self.fp_data.flush()?;\n        *ptr = end_ptr;\n        Ok(())\n    }\n\n    fn index_free(&mut self, ptr: MdbPtr) -> Result<()> {\n        // Read current freeptr from start of index file.\n        self.fp_index.seek(SeekFrom::Start(0))?;\n        let mut freeptr_buf = [0u8; MDB_PTR_SIZE];\n        self.fp_index.read_exact(&mut freeptr_buf)?;\n        let freeptr = MdbPtr::from_le_bytes(freeptr_buf);\n\n        // Set freeptr to the freed slot.\n        self.fp_index.seek(SeekFrom::Start(0))?;\n        self.fp_index.write_all(&ptr.to_le_bytes())?;\n\n        // The freed slot's next_ptr links to old freeptr.\n        self.fp_index.seek(SeekFrom::Start(ptr as u64))?;\n        self.fp_index.write_all(&freeptr.to_le_bytes())?;\n\n        // Zero out the key region of the freed slot.\n        let zeros = vec![0u8; self.options.key_size_max as usize];\n        self.fp_index.write_all(&zeros)?;\n\n        self.fp_index.flush()?;\n        Ok(())\n    }\n\n    fn data_free(&mut self, ptr: MdbPtr, size: MdbSize) -> Result<()> {\n        self.fp_data.seek(SeekFrom::Start(ptr as u64))?;\n        let zeros = vec![0u8; size as usize];\n        self.fp_data.write_all(&zeros)?;\n        self.fp_data.flush()?;\n        Ok(())\n    }\n\n    fn alloc() -> Result<()> {\n        // Memory allocation happens automatically via Rust's RAII; nothing to do.\n        Ok(())\n    }\n\n    fn free() -> Result<()> {\n        // Memory is reclaimed via Drop; nothing explicit to do.\n        Ok(())\n    }\n\n    fn hash(&self, key: &str) -> u32 {\n        let mut ret: u32 = 0;\n        for (i, b) in key.as_bytes().iter().enumerate() {\n            // Match the C semantics where `char` is signed on common platforms:\n            // (uint32_t)*key sign-extends the byte before promotion.\n            let c = ((*b as i8) as i32) as u32;\n            ret = ret.wrapping_add(c.wrapping_mul(i as u32));\n        }\n        ret\n    }\n\n    fn close(&mut self) -> Result<()> {\n        self.fp_superblock.flush()?;\n        self.fp_index.flush()?;\n        self.fp_data.flush()?;\n        Ok(())\n    }\n\n    fn key_matches(stored_key: &[u8], target: &[u8]) -> bool {\n        // The stored key is null-terminated; compare up to the first 0 byte.\n        let end = stored_key.iter().position(|&b| b == 0).unwrap_or(stored_key.len());\n        &stored_key[..end] == target\n    }\n}\n// impl Mdb\npub fn mdb_status() -> Result<MdbStatus> {\n    Ok(MdbStatus {\n        code: MdbStatusCode::MDB_OK as u8,\n        desc: String::new(),\n    })\n}\n","numLines":615,"startLine":1,"totalLines":615}}}
