  s = mdb_write(db, bigkey, \"x\");\n  printf(\"write_bigkey_status=%d\\n\", s.code);\n\n  // value too long\n  char bigval[300];\n  memset(bigval, 'b', 299);\n  bigval[299] = 0;\n  s = mdb_write(db, \"key2\", bigval);\n  printf(\"write_bigval_status=%d\\n\", s.code);\n\n  // key length exactly key_size_max=64 should be allowed (strlen returns 64, > 64 fails. So 64 is ok? It's strictly greater)\n  // C: if (key_size > db->options.key_size_max) — strict\n  char keymax[65];\n  memset(keymax, 'k', 64);\n  keymax[64] = 0;\n  s = mdb_write(db, keymax, \"vmax\");\n  printf(\"write_keymax_status=%d\\n\", s.code);\n\n  // write update\n  s = mdb_write(db, \"hello\", \"everyone\");\n  printf(\"write_update_status=%d\\n\", s.code);\n\n  s = mdb_read(db, \"hello\", buf, 300);\n  printf(\"read_update_status=%d val=%s\\n\", s.code, buf);\n\n  // delete\n  s = mdb_delete(db, \"hello\");\n  printf(\"delete_status=%d\\n\", s.code);\n\n  // delete non-existent\n  s = mdb_delete(db, \"hello\");\n  printf(\"delete_missing_status=%d\\n\", s.code);\n\n  // After delete read\n  s = mdb_read(db, \"hello\", buf, 300);\n  printf(\"read_after_delete_status=%d\\n\", s.code);\n\n  printf(\"after_all_index_size=%zu\\n\", mdb_index_size(&db));\n  printf(\"after_all_data_size=%zu\\n\", mdb_data_size(&db));\n\n  mdb_close(db);\n  return 0;\n}\n","userModified":false}}
