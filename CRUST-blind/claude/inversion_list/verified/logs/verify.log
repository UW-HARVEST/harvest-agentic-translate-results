ric_difference(&c);\n    assert_eq!(sd.to_str(), \"[1, 2, 4]\");\n    assert_eq!(sd.support(), 3);\n}\n\n#[test]\nfn test_symmetric_difference_disjoint() {\n    // C: sym_diff(a={1,2,3}, b={5,6,7}) = \"[]\"\n    // The C buggy implementation: difference(union, intersection)\n    // intersection={}, union={1,2,3,5,6,7}, then diff(union, empty)\n    // But in C, intersection is empty -> set2 size=0, while loop doesn't enter,\n    // returns inversion_list_create with j=0, so empty.\n    // diff(union, empty): set2 size=0, while loop doesn't enter, j=0, empty.\n    // So returns empty. C output confirmed: \"[]\"\n    let a = InversionList::new(20, &[1, 2, 3]).unwrap();\n    let b = InversionList::new(20, &[5, 6, 7]).unwrap();\n    let sd = a.symmetric_difference(&b);\n    assert_eq!(sd.to_str(), \"[]\");\n}\n\n#[test]\nfn test_symmetric_difference_a_minus_b_only() {\n    // C: sym_diff({1,2,3}, {2}) = \"[1, 3]\"\n    // u = {1,2,3}, i = {2}, sd = u - i = {1, 3}\n    let a = InversionList::new(20, &[1, 2, 3]).unwrap();\n    let b = InversionList::new(20, &[2]).unwrap();\n    let sd = a.symmetric_difference(&b);\n    assert_eq!(sd.to_str(), \"[1, 3]\");\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1188,"cache_read_input_tokens":74765,"cache_creation":{"ephemeral_5m_input_tokens":1188,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9a82304b-c2e5-4488-ad94-2b5550e13dd1","uuid":"2f0992c3-0d0b-40d7-b544-010dd68765e9"}
