RONOI_REGION 0\n227\t/** Denotes a right voronoi region, for polygon collision detection. */\n228\t#define SATC_RIGHT_VORONOI_REGION 1\n229\t\n230\t/** The index of the double array which contains the `x` value.. */\n231\t#define SATC_POINT_X 0\n232\t/** The index of the double array which contains the `y` value.. */\n233\t#define SATC_POINT_Y 1\n234\t\n235\t/**\n236\t * Get the `x` value from an array of doubles (a point).\n237\t *\n238\t * @param p the array of doubles (point) to fetch from.\n239\t * @return the `x` value as a double.\n240\t */\n241\t#define satc_point_get_x(p) p[SATC_POINT_X]\n242\t/**\n243\t * Set the `x` value in an array of doubles (a point).\n244\t *\n245\t * This macro is considered a statement.\n246\t *\n247\t * @param p the array of doubles (point) whose value should change.\n248\t * @param v the `x` value to change.\n249\t */\n250\t#define satc_point_set_x(p, v) p[SATC_POINT_X] = v;\n251\t/**\n252\t * Get the `y` value from an array of doubles (a point).\n253\t *\n254\t * @param p the array of doubles (point) to fetch from.\n255\t * @return the `y` value as a double.\n256\t */\n257\t#define satc_point_get_y(p) p[SATC_POINT_Y]\n258\t/**\n259\t * Set the `y` value in an array of doubles (a point).\n260\t *\n261\t * This macro is considered a statement.\n262\t *\n263\t * @param p the array of doubles (point) whose value should change.\n264\t * @param v the `y` value to change.\n265\t */\n266\t#define satc_point_set_y(p, v) p[SATC_POINT_Y] = v;\n267\t/**\n268\t * Set both the `x` and `y` values in an array of doubles (a point).\n269\t *\n270\t * This macro is considered a statement.\n271\t *\n272\t * @param p the array of doubles (point) whose value should change.\n273\t * @param x the `x` value to change.\n274\t * @param y the `y` value to change.\n275\t */\n276\t#define satc_point_set_xy(p, x, y) \\\n277\t  p[SATC_POINT_X] = x; \\\n278\t  p[SATC_POINT_Y] = y;\n279\t/**\n280\t * Given a point, allocate a separate array of doubles (a point) w