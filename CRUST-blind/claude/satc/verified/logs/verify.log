{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AP3W2KSN97xK3DxiAWGa6B","type":"tool_result","content":"1\tuse std::f64::MAX;\n2\tuse std::f64::consts::PI;\n3\t#[derive(Debug, Clone)]\n4\tpub struct SatcCircle {\n5\tpub pos: [f64; 2],\n6\tpub r: f64,\n7\t}\n8\t#[derive(Debug, Clone)]\n9\tpub struct SatcPolygon {\n10\tpub pos: [f64; 2],\n11\tpub num_points: usize,\n12\tpub points: Vec<[f64; 2]>,\n13\tpub angle: f64,\n14\tpub offset: [f64; 2],\n15\tpub calc_points: Vec<[f64; 2]>,\n16\tpub edges: Vec<[f64; 2]>,\n17\tpub normals: Vec<[f64; 2]>,\n18\t}\n19\t#[derive(Debug, Clone)]\n20\tpub struct SatcBox {\n21\tpub pos: [f64; 2],\n22\tpub w: f64,\n23\tpub h: f64,\n24\t}\n25\t#[derive(Debug, Clone)]\n26\tpub struct SatcResponse {\n27\tpub overlap: f64,\n28\tpub overlap_n: [f64; 2],\n29\tpub overlap_v: [f64; 2],\n30\tpub a_in_b: bool,\n31\tpub b_in_a: bool,\n32\t}\n33\tpub const SATC_TYPE_NONE: i32 = 0;\n34\tpub const SATC_TYPE_CIRCLE: i32 = 1;\n35\tpub const SATC_TYPE_POLYGON: i32 = 2;\n36\tpub const SATC_TYPE_BOX: i32 = 3;\n37\tpub const SATC_LEFT_VORONOI_REGION: i32 = -1;\n38\tpub const SATC_MIDDLE_VORONOI_REGION: i32 = 0;\n39\tpub const SATC_RIGHT_VORONOI_REGION: i32 = 1;\n40\timpl SatcCircle {\n41\tpub fn new(pos: [f64; 2], r: f64) -> Self {\n42\tSatcCircle { pos, r }\n43\t}\n44\t}\n45\timpl SatcPolygon {\n46\tpub fn new(pos: [f64; 2], points: Vec<[f64; 2]>) -> Self {\n47\t    let mut polygon = SatcPolygon {\n48\t        pos,\n49\t        num_points: 0,\n50\t        points: Vec::new(),\n51\t        angle: 0.0,\n52\t        offset: [0.0, 0.0],\n53\t        calc_points: Vec::new(),\n54\t        edges: Vec::new(),\n55\t        normals: Vec::new(),\n56\t    };\n57\t    satc_polygon_set_points(&mut polygon, points);\n58\t    polygon\n59\t}\n60\t}\n61\timpl SatcBox {\n62\tpub fn new(pos: [f64; 2], w: f64, h: f64) -> Self {\n63\t    SatcBox { pos, w, h }\n64\t}\n65\t}\n66\timpl SatcResponse {\n67\tpub fn new() -> Self {\n68\t    SatcResponse {\n69\t        overlap: f64::MAX,\n70\t        overlap_n: [0.0, 0.0],\n71\t        overlap_v: [0.0, 0.0],\n72\t        a_in_b: true,\n73\t        b_in_a: true,\n74\t    }\n75\t}\n76\t}\n77\t\n78\tfn polygon_recalc(polygon: &mut SatcPolygon) {\n79\t    let num_points = polygon.num_points;\n80\t    let offset = polygon.offset;\n81\t    let angle = polygon.angle;\n82\t\n83\t    for i in 0..num_points {\n84\t        let mut calc = polygon.points[i];\n85\t        calc[0] += offset[0];\n86\t        calc[1] += offset[1];\n87\t        if angle != 0.0 {\n88\t            let x = calc[0];\n89\t            let y = calc[1];\n90\t            // Match the C implementation's rotate (note: matches C source semantics).\n91\t            calc[0] = x * angle.cos() - y * angle.sin();\n92\t            calc[1] = x * angle.sin() - y * angle.cos();\n93\t        }\n94\t        polygon.calc_points[i] = calc;\n95\t    }\n96\t\n97\t    for i in 0..num_points {\n98\t        let p1 = polygon.calc_points[i];\n99\t        let p2 = if i < num_points - 1 {\n100\t            polygon.calc_points[i + 1]\n101\t        } else {\n102\t            polygon.calc_points[0]\n103\t        };\n104\t        let edge = [p2[0] - p1[0], p2[1] - p1[1]];\n105\t        polygon.edges[i] = edge;\n106\t        // perp(edge) then normalize\n107\t        let perp_x = edge[1];\n108\t        let perp_y = -edge[0];\n109\t        let len = (perp_x * perp_x + perp_y * perp_y).sqrt();\n110\t        if len > 0.0 {\n111\t            polygon.normals[i] = [perp_x / len, perp_y / len];\n112\t        } else {\n113\t            polygon.normals[i] = [perp_x, perp_y];\n114\t        }\n115\t    }\n116\t}\n117\t\n118\tpub fn satc_polygon_set_points(polygon: &mut SatcPolygon, points: Vec<[f64; 2]>) {\n119\t    let num_points = points.len();\n120\t    polygon.num_points = num_points;\n121\t    polygon.points = points;\n122\t    polygon.calc_points = vec![[0.0, 0.0]; num_points];\n123\t    polygon.edges = vec![[0.0, 0.0]; num_points];\n124\t    polygon.normals = vec![[0.0, 0.0]; num_points];\n125\t    polygon_recalc(polygon);\n126\t}\n127\tpub fn satc_box_create(pos: [f64; 2], w: f64, h: f64) -> SatcBox {\n128\t    SatcBox::new(pos, w, h)\n129\t}\n130\tpub fn satc_box_to_polygon(box_: &SatcBox) -> SatcPolygon {\n131\t    let w = box_.w;\n132\t    let h = box_.h;\n133\t    let points = vec![\n134\t        [0.0, 0.0],\n135\t        [w, 0.0],\n136\t        [w, h],\n137\t        [0.0, h],\n138\t    ];\n139\t    satc_polygon_create(box_.pos, points)\n140\t}\n141\tpub fn satc_test_polygon_polygon(a: &SatcPolygon, b: &SatcPolygon, response: &mut SatcResponse) -> bool {\n142\t    let a_len = a.num_points;\n143\t    let b_len = b.num_points;\n144\t\n145\t    for i in 0..a_len {\n146\t        let axis = a.normals[i];\n147\t        if satc_is_separating_axis(\n148\t            &a.pos, &b.pos,\n149\t            a_len, &a.points,\n150\t            b_len, &b.points,\n151\t            &axis, response,\n152\t        ) {\n153\t            return false;\n154\t        }\n155\t    }\n156\t\n157\t    for i in 0..b_len {\n158\t        let axis = b.normals[i];\n159\t        if satc_is_separating_axis(\n160\t            &a.pos, &b.pos,\n161\t            a_len, &a.points,\n162\t            b_len, &b.points,\n163\t            &axis, response,\n164\t        ) {\n165\t            return false;\n166\t        }\n167\t    }\n168\t\n169\t    response.overlap_v = [\n170\t        response.overlap_n[0] * response.overlap,\n171\t        response.overlap_n[1] * response.overlap,\n172\t    ];\n173\t    true\n174\t}\n175\tpub fn satc_point_copy(_p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n176\t    [q[0], q[1]]\n177\t}\n178\tpub fn satc_point_perp(p: &[f64; 2]) -> [f64; 2] {\n179\t    [p[1], -p[0]]\n180\t}\n181\tpub fn satc_point_reverse(p: &[f64; 2]) -> [f64; 2] {\n182\t    [-p[0], -p[1]]\n183\t}\n184\tpub fn satc_point_add(p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n185\t    [p[0] + q[0], p[1] + q[1]]\n186\t}\n187\tpub fn satc_point_sub(p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n188\t    [p[0] - q[0], p[1] - q[1]]\n189\t}\n190\tpub fn satc_point_scale_xy(p: &[f64; 2], x: f64, y: f64) -> [f64; 2] {\n191\t    [p[0] * x, p[1] * y]\n192\t}\n193\tpub fn satc_point_scale_x(p: &[f64; 2], x: f64) -> [f64; 2] {\n194\t    [p[0] * x, p[1] * x]\n195\t}\n196\tpub fn satc_point_create(x: f64, y: f64) -> [f64; 2] {\n197\t    [x, y]\n198\t}\n199\tpub fn satc_point_rotate(p: &[f64; 2], angle: f64) -> [f64; 2] {\n200\t    let x = p[0];\n201\t    let y = p[1];\n202\t    [\n203\t        x * angle.cos() - y * angle.sin(),\n204\t        x * angle.sin() - y * angle.cos(),\n205\t    ]\n206\t}\n207\tpub fn satc_point_normalize(p: &[f64; 2]) -> [f64; 2] {\n208\t    let d = (p[0] * p[0] + p[1] * p[1]).sqrt();\n209\t    if d > 0.0 {\n210\t        [p[0] / d, p[1] / d]\n211\t    } else {\n212\t        [p[0], p[1]]\n213\t    }\n214\t}\n215\tpub fn satc_point_project(p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n216\t    let dot = p[0] * q[0] + p[1] * q[1];\n217\t    let len2 = q[0] * q[0] + q[1] * q[1];\n218\t    let amt = dot / len2;\n219\t    [amt * p[0], amt * p[1]]\n220\t}\n221\tpub fn satc_point_reflect(p: &[f64; 2], axis: &[f64; 2]) -> [f64; 2] {\n222\t    let x = p[0];\n223\t    let y = p[1];\n224\t    let projected = satc_point_project(p, axis);\n225\t    let scaled = [projected[0] * 2.0, projected[1] * 2.0];\n226\t    [scaled[0] - x, scaled[1] - y]\n227\t}\n228\tpub fn satc_circle_create(pos: [f64; 2], r: f64) -> SatcCircle {\n229\t    SatcCircle::new(pos, r)\n230\t}\n231\tpub fn satc_circle_get_aabb(circle: &SatcCircle) -> SatcPolygon {\n232\t    let r = circle.r;\n233\t    let corner = [circle.pos[0] - r, circle.pos[1] - r];\n234\t    let box_ = satc_box_create(corner, r * 2.0, r * 2.0);\n235\t    satc_box_to_polygon(&box_)\n236\t}\n237\tpub fn satc_polygon_create(pos: [f64; 2], points: Vec<[f64; 2]>) -> SatcPolygon {\n238\t    SatcPolygon::new(pos, points)\n239\t}\n240\tpub fn satc_polygon_get_aabb(polygon: &SatcPolygon) -> SatcPolygon {\n241\t    let mut x_min = polygon.points[0][0];\n242\t    let mut y_min = polygon.points[0][1];\n243\t    let mut x_max = x_min;\n244\t    let mut y_max = x_max;\n245\t    for i in 1..polygon.num_points {\n246\t        let x = polygon.points[i][0];\n247\t        let y = polygon.points[i][1];\n248\t        if x < x_min { x_min = x; }\n249\t        if x > x_max { x_max = x; }\n250\t        if y < y_min { y_min = y; }\n251\t        if y > y_max { y_max = y; }\n252\t    }\n253\t    let pos = [x_min, y_min];\n254\t    let box_ = satc_box_create(pos, x_max - x_min, y_max - y_min);\n255\t    satc_box_to_polygon(&box_)\n256\t}\n257\tpub fn satc_polygon_get_centroid(polygon: &SatcPolygon) -> [f64; 2] {\n258\t    let len = polygon.calc_points.len();\n259\t    let mut cx = 0.0_f64;\n260\t    let mut cy = 0.0_f64;\n261\t    let mut ar = 0.0_f64;\n262\t    for i in 0..len {\n263\t        let p1 = polygon.calc_points[i];\n264\t        let p2 = if i == len - 1 {\n265\t            polygon.calc_points[0]\n266\t        } else {\n267\t            polygon.calc_points[i + 1]\n268\t        };\n269\t        let a = p1[0] * p2[1] - p2[0] * p1[1];\n270\t        cx += (p1[0] + p2[0]) * a;\n271\t        cy += (p1[1] + p2[1]) * a;\n272\t        ar += a;\n273\t    }\n274\t    let ar3 = ar * 3.0;\n275\t    [cx / ar3, cy / ar3]\n276\t}\n277\tpub fn satc_response_create() -> SatcResponse {\n278\t    SatcResponse::new()\n279\t}\n280\tpub fn satc_flatten_points_on(len: usize, points: &[[f64; 2]], normal: &[f64; 2], result: &mut [f64; 2]) {\n281\t    let mut min = f64::MAX;\n282\t    let mut max = -f64::MAX;\n283\t    for i in 0..len {\n284\t        let dot = points[i][0] * normal[0] + points[i][1] * normal[1];\n285\t        if dot < min { min = dot; }\n286\t        if dot > max { max = dot; }\n287\t    }\n288\t    result[0] = min;\n289\t    result[1] = max;\n290\t}\n291\tpub fn satc_is_separating_axis(\n292\ta_pos: &[f64; 2],\n293\tb_pos: &[f64; 2],\n294\ta_len: usize,\n295\ta_points: &[[f64; 2]],\n296\tb_len: usize,\n297\tb_points: &[[f64; 2]],\n298\taxis: &[f64; 2],\n299\tresponse: &mut SatcResponse,\n300\t) -> bool {\n301\t    let mut range_a = [0.0_f64, 0.0_f64];\n302\t    let mut range_b = [0.0_f64, 0.0_f64];\n303\t    let offset_v = [b_pos[0] - a_pos[0], b_pos[1] - a_pos[1]];\n304\t    let projected_offset = offset_v[0] * axis[0] + offset_v[1] * axis[1];\n305\t\n306\t    satc_flatten_points_on(a_len, a_points, axis, &mut range_a);\n307\t    satc_flatten_points_on(b_len, b_points, axis, &mut range_b);\n308\t\n309\t    range_b[0] += projected_offset;\n310\t    range_b[1] += projected_offset;\n311\t\n312\t    if range_a[0] > range_b[1] || range_b[0] > range_a[1] {\n313\t        return true;\n314\t    }\n315\t\n316\t    let overlap;\n317\t    if range_a[0] < range_b[0] {\n318\t        response.a_in_b = false;\n319\t        if range_a[1] < range_b[1] {\n320\t            overlap = range_a[1] - range_b[1];\n321\t            response.b_in_a = false;\n322\t        } else {\n323\t            let option_1 = range_a[1] - range_b[0];\n324\t            let option_2 = range_b[1] - range_a[0];\n325\t            overlap = if option_1 < option_2 { option_1 } else { -option_2 };\n326\t        }\n327\t    } else {\n328\t        response.b_in_a = false;\n329\t        if range_a[1] > range_b[1] {\n330\t            overlap = range_a[0] - range_b[1];\n331\t            response.a_in_b = false;\n332\t        } else {\n333\t            let option_1 = range_a[1] - range_b[0];\n334\t            let option_2 = range_b[1] - range_a[0];\n335\t            overlap = if option_1 < option_2 { option_1 } else { -option_2 };\n336\t        }\n337\t    }\n338\t\n339\t    let abs_overlap = overlap.abs();\n340\t    if abs_overlap < response.overlap {\n341\t        response.overlap = abs_overlap;\n342\t        response.overlap_n = *axis;\n343\t        if overlap < 0.0 {\n344\t            response.overlap_n = [-response.overlap_n[0], -response.overlap_n[1]];\n345\t        }\n346\t    }\n347\t\n348\t    false\n349\t}\n350\tpub fn satc_voronoi_region(line: &[f64; 2], point: &[f64; 2]) -> i32 {\n351\t    let len_2 = line[0] * line[0] + line[1] * line[1];\n352\t    let dp = point[0] * line[0] + point[1] * line[1];\n353\t    if dp < 0.0 { return SATC_LEFT_VORONOI_REGION; }\n354\t    if dp > len_2 { return SATC_RIGHT_VORONOI_REGION; }\n355\t    SATC_MIDDLE_VORONOI_REGION\n356\t}\n357\tpub fn satc_point_in_circle(point: &[f64; 2], circle: &SatcCircle) -> bool {\n358\t    let dx = point[0] - circle.pos[0];\n359\t    let dy = point[1] - circle.pos[1];\n360\t    let radius_sq = circle.r * circle.r;\n361\t    let distance_sq = dx * dx + dy * dy;\n362\t    distance_sq <= radius_sq\n363\t}\n364\tpub fn satc_point_in_polygon(point: &[f64; 2], polygon: &SatcPolygon) -> bool {\n365\t    // Build a tiny test polygon at the point.\n366\t    let test_box = satc_box_create([0.0, 0.0], 0.000001, 0.000001);\n367\t    let mut test_polygon = satc_box_to_polygon(&test_box);\n368\t    test_polygon.pos = *point;\n369\t\n370\t    let mut response = satc_response_create();\n371\t    let result = satc_test_polygon_polygon(&test_polygon, polygon, &mut response);\n372\t    if result { response.a_in_b } else { false }\n373\t}\n374\tpub fn satc_test_circle_circle(a: &SatcCircle, b: &SatcCircle, response: &mut SatcResponse) -> bool {\n375\t    let dx = b.pos[0] - a.pos[0];\n376\t    let dy = b.pos[1] - a.pos[1];\n377\t    let total_radius = a.r + b.r;\n378\t    let total_radius_sq = total_radius * total_radius;\n379\t    let distance_sq = dx * dx + dy * dy;\n380\t    if distance_sq > total_radius_sq {\n381\t        return false;\n382\t    }\n383\t    let distance = distance_sq.sqrt();\n384\t    response.overlap = total_radius - distance;\n385\t    let mut diff = [dx, dy];\n386\t    if distance > 0.0 {\n387\t        diff[0] /= distance;\n388\t        diff[1] /= distance;\n389\t    }\n390\t    response.overlap_n = diff;\n391\t    response.overlap_v = [diff[0] * response.overlap, diff[1] * response.overlap];\n392\t    response.a_in_b = (a.r <= b.r) && (distance <= b.r - a.r);\n393\t    response.b_in_a = (b.r <= a.r) && (distance <= a.r - b.r);\n394\t    true\n395\t}\n396\tpub fn satc_test_polygon_circle(polygon: &SatcPolygon, circle: &SatcCircle, response: &mut SatcResponse) -> bool {\n397\t    let circle_pos = [\n398\t        circle.pos[0] - polygon.pos[0],\n399\t        circle.pos[1] - polygon.pos[1],\n400\t    ];\n401\t    let radius = circle.r;\n402\t    let radius2 = radius * radius;\n403\t    let points = &polygon.calc_points;\n404\t    let len = polygon.calc_points.len();\n405\t\n406\t    for i in 0..len {\n407\t        let next = if i == len - 1 { 0 } else { i + 1 };\n408\t        let prev = if i == 0 { len - 1 } else { i - 1 };\n409\t        let mut overlap = 0.0_f64;\n410\t        let mut overlap_n: Option<[f64; 2]> = None;\n411\t\n412\t        let edge = polygon.edges[i];\n413\t        let point = [\n414\t            circle_pos[0] - points[i][0],\n415\t            circle_pos[1] - points[i][1],\n416\t        ];\n417\t\n418\t        let point_len2 = point[0] * point[0] + point[1] * point[1];\n419\t        if point_len2 > radius2 {\n420\t            response.a_in_b = false;\n421\t        }\n422\t\n423\t        let region = satc_voronoi_region(&edge, &point);\n424\t        if region == SATC_LEFT_VORONOI_REGION {\n425\t            let edge_prev = polygon.edges[prev];\n426\t            let point2 = [\n427\t                circle_pos[0] - points[prev][0],\n428\t                circle_pos[1] - points[prev][1],\n429\t            ];\n430\t            let region2 = satc_voronoi_region(&edge_prev, &point2);\n431\t            if region2 == SATC_RIGHT_VORONOI_REGION {\n432\t                let dist = point_len2.sqrt();\n433\t                if dist > radius {\n434\t                    return false;\n435\t                }\n436\t                response.b_in_a = false;\n437\t                let n = if dist > 0.0 {\n438\t                    [point[0] / dist, point[1] / dist]\n439\t                } else {\n440\t                    [point[0], point[1]]\n441\t                };\n442\t                overlap_n = Some(n);\n443\t                overlap = radius - dist;\n444\t            }\n445\t        } else if region == SATC_RIGHT_VORONOI_REGION {\n446\t            let edge_next = polygon.edges[next];\n447\t            let point_next = [\n448\t                circle_pos[0] - points[next][0],\n449\t                circle_pos[1] - points[next][1],\n450\t            ];\n451\t            let region2 = satc_voronoi_region(&edge_next, &point_next);\n452\t            if region2 == SATC_LEFT_VORONOI_REGION {\n453\t                let dist_sq = point_next[0] * point_next[0] + point_next[1] * point_next[1];\n454\t                let dist = dist_sq.sqrt();\n455\t                if dist > radius {\n456\t                    return false;\n457\t                }\n458\t                response.b_in_a = false;\n459\t                let n = if dist > 0.0 {\n460\t                    [point_next[0] / dist, point_next[1] / dist]\n461\t                } else {\n462\t                    [point_next[0], point_next[1]]\n463\t                };\n464\t                overlap_n = Some(n);\n465\t                overlap = radius - dist;\n466\t            }\n467\t        } else {\n468\t            // Middle voronoi region.\n469\t            // Compute the unit normal of the edge: perp(edge) normalized.\n470\t            let perp = [edge[1], -edge[0]];\n471\t            let plen = (perp[0] * perp[0] + perp[1] * perp[1]).sqrt();\n472\t            let normal = if plen > 0.0 {\n473\t                [perp[0] / plen, perp[1] / plen]\n474\t            } else {\n475\t                perp\n476\t            };\n477\t            let dist = point[0] * normal[0] + point[1] * normal[1];\n478\t            let dist_abs = dist.abs();\n479\t            if dist > 0.0 && dist_abs > radius {\n480\t                return false;\n481\t            }\n482\t            overlap_n = Some(normal);\n483\t            overlap = radius - dist;\n484\t            if dist >= 0.0 || overlap < 2.0 * radius {\n485\t                response.b_in_a = false;\n486\t            }\n487\t        }\n488\t\n489\t        if let Some(n) = overlap_n {\n490\t            if overlap.abs() < response.overlap.abs() {\n491\t                response.overlap = overlap;\n492\t                response.overlap_n = n;\n493\t            }\n494\t        }\n495\t    }\n496\t\n497\t    response.overlap_v = [\n498\t        response.overlap_n[0] * response.overlap,\n499\t        response.overlap_n[1] * response.overlap,\n500\t    ];\n501\t\n502\t    true\n503\t}\n504\tpub fn satc_test_circle_polygon(circle: &SatcCircle, polygon: &SatcPolygon, response: &mut SatcResponse) -> bool {\n505\t    let result = satc_test_polygon_circle(polygon, circle, response);\n506\t    if result {\n507\t        let a_in_b = response.a_in_b;\n508\t        response.overlap_n = [-response.overlap_n[0], -response.overlap_n[1]];\n509\t        response.overlap_v = [-response.overlap_v[0], -response.overlap_v[1]];\n510\t        response.a_in_b = response.b_in_a;\n511\t        response.b_in_a = a_in_b;\n512\t    }\n513\t    result\n514\t}\n515\t"}]},"parent_tool_use_id":null,"session_id":"e3fb11be-d7b2-47b9-9cea-83d8e346ff0f","uuid":"80d2f239-da46-40f6-a3e1-ee189df5aae9","timestamp":"2026-05-29T19:21:27.686Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-BnUX6A/project/src/satc.rs","content":"use std::f64::MAX;\nuse std::f64::consts::PI;\n#[derive(Debug, Clone)]\npub struct SatcCircle {\npub pos: [f64; 2],\npub r: f64,\n}\n#[derive(Debug, Clone)]\npub struct SatcPolygon {\npub pos: [f64; 2],\npub num_points: usize,\npub points: Vec<[f64; 2]>,\npub angle: f64,\npub offset: [f64; 2],\npub calc_points: Vec<[f64; 2]>,\npub edges: Vec<[f64; 2]>,\npub normals: Vec<[f64; 2]>,\n}\n#[derive(Debug, Clone)]\npub struct SatcBox {\npub pos: [f64; 2],\npub w: f64,\npub h: f64,\n}\n#[derive(Debug, Clone)]\npub struct SatcResponse {\npub overlap: f64,\npub overlap_n: [f64; 2],\npub overlap_v: [f64; 2],\npub a_in_b: bool,\npub b_in_a: bool,\n}\npub const SATC_TYPE_NONE: i32 = 0;\npub const SATC_TYPE_CIRCLE: i32 = 1;\npub const SATC_TYPE_POLYGON: i32 = 2;\npub const SATC_TYPE_BOX: i32 = 3;\npub const SATC_LEFT_VORONOI_REGION: i32 = -1;\npub const SATC_MIDDLE_VORONOI_REGION: i32 = 0;\npub const SATC_RIGHT_VORONOI_REGION: i32 = 1;\nimpl SatcCircle {\npub fn new(pos: [f64; 2], r: f64) -> Self {\nSatcCircle { pos, r }\n}\n}\nimpl SatcPolygon {\npub fn new(pos: [f64; 2], points: Vec<[f64; 2]>) -> Self {\n    let mut polygon = SatcPolygon {\n        pos,\n        num_points: 0,\n        points: Vec::new(),\n        angle: 0.0,\n        offset: [0.0, 0.0],\n        calc_points: Vec::new(),\n        edges: Vec::new(),\n        normals: Vec::new(),\n    };\n    satc_polygon_set_points(&mut polygon, points);\n    polygon\n}\n}\nimpl SatcBox {\npub fn new(pos: [f64; 2], w: f64, h: f64) -> Self {\n    SatcBox { pos, w, h }\n}\n}\nimpl SatcResponse {\npub fn new() -> Self {\n    SatcResponse {\n        overlap: f64::MAX,\n        overlap_n: [0.0, 0.0],\n        overlap_v: [0.0, 0.0],\n        a_in_b: true,\n        b_in_a: true,\n    }\n}\n}\n\nfn polygon_recalc(polygon: &mut SatcPolygon) {\n    let num_points = polygon.num_points;\n    let offset = polygon.offset;\n    let angle = polygon.angle;\n\n    for i in 0..num_points {\n        let mut calc = polygon.points[i];\n        calc[0] += offset[0];\n        calc[1] += offset[1];\n        if angle != 0.0 {\n            let x = calc[0];\n            let y = calc[1];\n            // Match the C implementation's rotate (note: matches C source semantics).\n            calc[0] = x * angle.cos() - y * angle.sin();\n            calc[1] = x * angle.sin() - y * angle.cos();\n        }\n        polygon.calc_points[i] = calc;\n    }\n\n    for i in 0..num_points {\n        let p1 = polygon.calc_points[i];\n        let p2 = if i < num_points - 1 {\n            polygon.calc_points[i + 1]\n        } else {\n            polygon.calc_points[0]\n        };\n        let edge = [p2[0] - p1[0], p2[1] - p1[1]];\n        polygon.edges[i] = edge;\n        // perp(edge) then normalize\n        let perp_x = edge[1];\n        let perp_y = -edge[0];\n        let len = (perp_x * perp_x + perp_y * perp_y).sqrt();\n        if len > 0.0 {\n            polygon.normals[i] = [perp_x / len, perp_y / len];\n        } else {\n            polygon.normals[i] = [perp_x, perp_y];\n        }\n    }\n}\n\npub fn satc_polygon_set_points(polygon: &mut SatcPolygon, points: Vec<[f64; 2]>) {\n    let num_points = points.len();\n    polygon.num_points = num_points;\n    polygon.points = points;\n    polygon.calc_points = vec![[0.0, 0.0]; num_points];\n    polygon.edges = vec![[0.0, 0.0]; num_points];\n    polygon.normals = vec![[0.0, 0.0]; num_points];\n    polygon_recalc(polygon);\n}\npub fn satc_box_create(pos: [f64; 2], w: f64, h: f64) -> SatcBox {\n    SatcBox::new(pos, w, h)\n}\npub fn satc_box_to_polygon(box_: &SatcBox) -> SatcPolygon {\n    let w = box_.w;\n    let h = box_.h;\n    let points = vec![\n        [0.0, 0.0],\n        [w, 0.0],\n        [w, h],\n        [0.0, h],\n    ];\n    satc_polygon_create(box_.pos, points)\n}\npub fn satc_test_polygon_polygon(a: &SatcPolygon, b: &SatcPolygon, response: &mut SatcResponse) -> bool {\n    let a_len = a.num_points;\n    let b_len = b.num_points;\n\n    for i in 0..a_len {\n        let axis = a.normals[i];\n        if satc_is_separating_axis(\n            &a.pos, &b.pos,\n            a_len, &a.points,\n            b_len, &b.points,\n            &axis, response,\n        ) {\n            return false;\n        }\n    }\n\n    for i in 0..b_len {\n        let axis = b.normals[i];\n        if satc_is_separating_axis(\n            &a.pos, &b.pos,\n            a_len, &a.points,\n            b_len, &b.points,\n            &axis, response,\n        ) {\n            return false;\n        }\n    }\n\n    response.overlap_v = [\n        response.overlap_n[0] * response.overlap,\n        response.overlap_n[1] * response.overlap,\n    ];\n    true\n}\npub fn satc_point_copy(_p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n    [q[0], q[1]]\n}\npub fn satc_point_perp(p: &[f64; 2]) -> [f64; 2] {\n    [p[1], -p[0]]\n}\npub fn satc_point_reverse(p: &[f64; 2]) -> [f64; 2] {\n    [-p[0], -p[1]]\n}\npub fn satc_point_add(p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n    [p[0] + q[0], p[1] + q[1]]\n}\npub fn satc_point_sub(p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n    [p[0] - q[0], p[1] - q[1]]\n}\npub fn satc_point_scale_xy(p: &[f64; 2], x: f64, y: f64) -> [f64; 2] {\n    [p[0] * x, p[1] * y]\n}\npub fn satc_point_scale_x(p: &[f64; 2], x: f64) -> [f64; 2] {\n    [p[0] * x, p[1] * x]\n}\npub fn satc_point_create(x: f64, y: f64) -> [f64; 2] {\n    [x, y]\n}\npub fn satc_point_rotate(p: &[f64; 2], angle: f64) -> [f64; 2] {\n    let x = p[0];\n    let y = p[1];\n    [\n        x * angle.cos() - y * angle.sin(),\n        x * angle.sin() - y * angle.cos(),\n    ]\n}\npub fn satc_point_normalize(p: &[f64; 2]) -> [f64; 2] {\n    let d = (p[0] * p[0] + p[1] * p[1]).sqrt();\n    if d > 0.0 {\n        [p[0] / d, p[1] / d]\n    } else {\n        [p[0], p[1]]\n    }\n}\npub fn satc_point_project(p: &[f64; 2], q: &[f64; 2]) -> [f64; 2] {\n    let dot = p[0] * q[0] + p[1] * q[1];\n    let len2 = q[0] * q[0] + q[1] * q[1];\n    let amt = dot / len2;\n    [amt * p[0], amt * p[1]]\n}\npub fn satc_point_reflect(p: &[f64; 2], axis: &[f64; 2]) -> [f64; 2] {\n    let x = p[0];\n    let y = p[1];\n    let projected = satc_point_project(p, axis);\n    let scaled = [projected[0] * 2.0, projected[1] * 2.0];\n    [scaled[0] - x, scaled[1] - y]\n}\npub fn satc_circle_create(pos: [f64; 2], r: f64) -> SatcCircle {\n    SatcCircle::new(pos, r)\n}\npub fn satc_circle_get_aabb(circle: &SatcCircle) -> SatcPolygon {\n    let r = circle.r;\n    let corner = [circle.pos[0] - r, circle.pos[1] - r];\n    let box_ = satc_box_create(corner, r * 2.0, r * 2.0);\n    satc_box_to_polygon(&box_)\n}\npub fn satc_polygon_create(pos: [f64; 2], points: Vec<[f64; 2]>) -> SatcPolygon {\n    SatcPolygon::new(pos, points)\n}\npub fn satc_polygon_get_aabb(polygon: &SatcPolygon) -> SatcPolygon {\n    let mut x_min = polygon.points[0][0];\n    let mut y_min = polygon.points[0][1];\n    let mut x_max = x_min;\n    let mut y_max = x_max;\n    for i in 1..polygon.num_points {\n        let x = polygon.points[i][0];\n        let y = polygon.points[i][1];\n        if x < x_min { x_min = x; }\n        if x > x_max { x_max = x; }\n        if y < y_min { y_min = y; }\n        if y > y_max { y_max = y; }\n    }\n    let pos = [x_min, y_min];\n    let box_ = satc_box_create(pos, x_max - x_min, y_max - y_min);\n    satc_box_to_polygon(&box_)\n}\npub fn satc_polygon_get_centroid(polygon: &SatcPolygon) -> [f64; 2] {\n    let len = polygon.calc_points.len();\n    let mut cx = 0.0_f64;\n    let mut cy = 0.0_f64;\n    let mut ar = 0.0_f64;\n    for i in 0..len {\n        let p1 = polygon.calc_points[i];\n        let p2 = if i == len - 1 {\n            polygon.calc_points[0]\n        } else {\n            polygon.calc_points[i + 1]\n        };\n        let a = p1[0] * p2[1] - p2[0] * p1[1];\n        cx += (p1[0] + p2[0]) * a;\n        cy += (p1[1] + p2[1]) * a;\n        ar += a;\n    }\n    let ar3 = ar * 3.0;\n    [cx / ar3, cy / ar3]\n}\npub fn satc_response_create() -> SatcResponse {\n    SatcResponse::new()\n}\npub fn satc_flatten_points_on(len: usize, points: &[[f64; 2]], normal: &[f64; 2], result: &mut [f64; 2]) {\n    let mut min = f64::MAX;\n    let mut max = -f64::MAX;\n    for i in 0..len {\n        let dot = points[i][0] * normal[0] + points[i][1] * normal[1];\n        if dot < min { min = dot; }\n        if dot > max { max = dot; }\n    }\n    result[0] = min;\n    result[1] = max;\n}\npub fn satc_is_separating_axis(\na_pos: &[f64; 2],\nb_pos: &[f64; 2],\na_len: usize,\na_points: &[[f64; 2]],\nb_len: usize,\nb_points: &[[f64; 2]],\naxis: &[f64; 2],\nresponse: &mut SatcResponse,\n) -> bool {\n    let mut range_a = [0.0_f64, 0.0_f64];\n    let mut range_b = [0.0_f64, 0.0_f64];\n    let offset_v = [b_pos[0] - a_pos[0], b_pos[1] - a_pos[1]];\n    let projected_offset = offset_v[0] * axis[0] + offset_v[1] * axis[1];\n\n    satc_flatten_points_on(a_len, a_points, axis, &mut range_a);\n    satc_flatten_points_on(b_len, b_points, axis, &mut range_b);\n\n    range_b[0] += projected_offset;\n    range_b[1] += projected_offset;\n\n    if range_a[0] > range_b[1] || range_b[0] > range_a[1] {\n        return true;\n    }\n\n    let overlap;\n    if range_a[0] < range_b[0] {\n        response.a_in_b = false;\n        if range_a[1] < range_b[1] {\n            overlap = range_a[1] - range_b[1];\n            response.b_in_a = false;\n        } else {\n            let option_1 = range_a[1] - range_b[0];\n            let option_2 = range_b[1] - range_a[0];\n            overlap = if option_1 < option_2 { option_1 } else { -option_2 };\n        }\n    } else {\n        response.b_in_a = false;\n        if range_a[1] > range_b[1] {\n            overlap = range_a[0] - range_b[1];\n            response.a_in_b = false;\n        } else {\n            let option_1 = range_a[1] - range_b[0];\n            let option_2 = range_b[1] - range_a[0];\n            overlap = if option_1 < option_2 { option_1 } else { -option_2 };\n        }\n    }\n\n    let abs_overlap = overlap.abs();\n    if abs_overlap < response.overlap {\n        response.overlap = abs_overlap;\n        response.overlap_n = *axis;\n        if overlap < 0.0 {\n            response.overlap_n = [-response.overlap_n[0], -response.overlap_n[1]];\n        }\n    }\n\n    false\n}\npub fn satc_voronoi_region(line: &[f64; 2], point: &[f64; 2]) -> i32 {\n    let len_2 = line[0] * line[0] + line[1] * line[1];\n    let dp = point[0] * line[0] + point[1] * line[1];\n    if dp < 0.0 { return SATC_LEFT_VORONOI_REGION; }\n    if dp > len_2 { return SATC_RIGHT_VORONOI_REGION; }\n    SATC_MIDDLE_VORONOI_REGION\n}\npub fn satc_point_in_circle(point: &[f64; 2], circle: &SatcCircle) -> bool {\n    let dx = point[0] - circle.pos[0];\n    let dy = point[1] - circle.pos[1];\n    let radius_sq = circle.r * circle.r;\n    let distance_sq = dx * dx + dy * dy;\n    distance_sq <= radius_sq\n}\npub fn satc_point_in_polygon(point: &[f64; 2], polygon: &SatcPolygon) -> bool {\n    // Build a tiny test polygon at the point.\n    let test_box = satc_box_create([0.0, 0.0], 0.000001, 0.000001);\n    let mut test_polygon = satc_box_to_polygon(&test_box);\n    test_polygon.pos = *point;\n\n    let mut response = satc_response_create();\n    let result = satc_test_polygon_polygon(&test_polygon, polygon, &mut response);\n    if result { response.a_in_b } else { false }\n}\npub fn satc_test_circle_circle(a: &SatcCircle, b: &SatcCircle, response: &mut SatcResponse) -> bool {\n    let dx = b.pos[0] - a.pos[0];\n    let dy = b.pos[1] - a.pos[1];\n    let total_radius = a.r + b.r;\n    let total_radius_sq = total_radius * total_radius;\n    let distance_sq = dx * dx + dy * dy;\n    if distance_sq > total_radius_sq {\n        return false;\n    }\n    let distance = distance_sq.sqrt();\n    response.overlap = total_radius - distance;\n    let mut diff = [dx, dy];\n    if distance > 0.0 {\n        diff[0] /= distance;\n        diff[1] /= distance;\n    }\n    response.overlap_n = diff;\n    response.overlap_v = [diff[0] * response.overlap, diff[1] * response.overlap];\n    response.a_in_b = (a.r <= b.r) && (distance <= b.r - a.r);\n    response.b_in_a = (b.r <= a.r) && (distance <= a.r - b.r);\n    true\n}\npub fn satc_test_polygon_circle(polygon: &SatcPolygon, circle: &SatcCircle, response: &mut SatcResponse) -> bool {\n    let circle_pos = [\n        circle.pos[0] - polygon.pos[0],\n        circle.pos[1] - polygon.pos[1],\n    ];\n    let radius = circle.r;\n    let radius2 = radius * radius;\n    let points = &polygon.calc_points;\n    let len = polygon.calc_points.len();\n\n    for i in 0..len {\n        let next = if i == len - 1 { 0 } else { i + 1 };\n        let prev = if i == 0 { len - 1 } else { i - 1 };\n        let mut overlap = 0.0_f64;\n        let mut overlap_n: Option<[f64; 2]> = None;\n\n        let edge = polygon.edges[i];\n        let point = [\n            circle_pos[0] - points[i][0],\n            circle_pos[1] - points[i][1],\n        ];\n\n        let point_len2 = point[0] * point[0] + point[1] * point[1];\n        if point_len2 > radius2 {\n            response.a_in_b = false;\n        }\n\n        let region = satc_voronoi_region(&edge, &point);\n        if region == SATC_LEFT_VORONOI_REGION {\n            let edge_prev = polygon.edges[prev];\n            let point2 = [\n                circle_pos[0] - points[prev][0],\n                circle_pos[1] - points[prev][1],\n            ];\n            let region2 = satc_voronoi_region(&edge_prev, &point2);\n            if region2 == SATC_RIGHT_VORONOI_REGION {\n                let dist = point_len2.sqrt();\n                if dist > radius {\n                    return false;\n                }\n                response.b_in_a = false;\n                let n = if dist > 0.0 {\n                    [point[0] / dist, point[1] / dist]\n                } else {\n                    [point[0], point[1]]\n                };\n                overlap_n = Some(n);\n                overlap = radius - dist;\n            }\n        } else if region == SATC_RIGHT_VORONOI_REGION {\n            let edge_next = polygon.edges[next];\n            let point_next = [\n                circle_pos[0] - points[next][0],\n                circle_pos[1] - points[next][1],\n            ];\n            let region2 = satc_voronoi_region(&edge_next, &point_next);\n            if region2 == SATC_LEFT_VORONOI_REGION {\n                let dist_sq = point_next[0] * point_next[0] + point_next[1] * point_next[1];\n                let dist = dist_sq.sqrt();\n                if dist > radius {\n                    return false;\n                }\n                response.b_in_a = false;\n                let n = if dist > 0.0 {\n                    [point_next[0] / dist, point_next[1] / dist]\n                } else {\n                    [point_next[0], point_next[1]]\n                };\n                overlap_n = Some(n);\n                overlap = radius - dist;\n            }\n        } else {\n            // Middle voronoi region.\n            // Compute the unit normal of the edge: perp(edge) normalized.\n            let perp = [edge[1], -edge[0]];\n            let plen = (perp[0] * perp[0] + perp[1] * perp[1]).sqrt();\n            let normal = if plen > 0.0 {\n                [perp[0] / plen, perp[1] / plen]\n            } else {\n                perp\n            };\n            let dist = point[0] * normal[0] + point[1] * normal[1];\n            let dist_abs = dist.abs();\n            if dist > 0.0 && dist_abs > radius {\n                return false;\n            }\n            overlap_n = Some(normal);\n            overlap = radius - dist;\n            if dist >= 0.0 || overlap < 2.0 * radius {\n                response.b_in_a = false;\n            }\n        }\n\n        if let Some(n) = overlap_n {\n            if overlap.abs() < response.overlap.abs() {\n                response.overlap = overlap;\n                response.overlap_n = n;\n            }\n        }\n    }\n\n    response.overlap_v = [\n        response.overlap_n[0] * response.overlap,\n        response.overlap_n[1] * response.overlap,\n    ];\n\n    true\n}\npub fn satc_test_circle_polygon(circle: &SatcCircle, polygon: &SatcPolygon, response: &mut SatcResponse) -> bool {\n    let result = satc_test_polygon_circle(polygon, circle, response);\n    if result {\n        let a_in_b = response.a_in_b;\n        response.overlap_n = [-response.overlap_n[0], -response.overlap_n[1]];\n        response.overlap_v = [-response.