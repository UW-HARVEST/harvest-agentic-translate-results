int_alloca(p);\n    satc_point_set_xy(p, 3.0, 4.0);\n    satc_point_scale_x(p, 2.5);\n    print_pt(\"scale_x(3,4)*2.5\", p);\n  }\n\n  // satc_point_rotate (note: C rotation has unusual formula y*sin - y*cos)\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 1.0, 0.0);\n    satc_point_rotate(p, M_PI / 2.0);\n    print_pt(\"rotate(1,0,pi/2)\", p);\n  }\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 1.0, 1.0);\n    satc_point_rotate(p, M_PI / 4.0);\n    print_pt(\"rotate(1,1,pi/4)\", p);\n  }\n\n  // satc_point_normalize\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 3.0, 4.0);\n    satc_point_normalize(p);\n    print_pt(\"normalize(3,4)\", p);\n  }\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 0.0, 0.0);\n    satc_point_normalize(p);\n    print_pt(\"normalize(0,0)\", p);\n  }\n\n  // satc_point_project\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 2.0, 3.0);\n    satc_point_alloca(q);\n    satc_point_set_xy(q, 1.0, 0.0);\n    satc_point_project(p, q);\n    print_pt(\"project(2,3) onto (1,0)\", p);\n  }\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 4.0, 2.0);\n    satc_point_alloca(q);\n    satc_point_set_xy(q, 1.0, 1.0);\n    satc_point_project(p, q);\n    print_pt(\"project(4,2) onto (1,1)\", p);\n  }\n\n  // satc_point_reflect\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 2.0, 3.0);\n    satc_point_alloca(axis);\n    satc_point_set_xy(axis, 1.0, 0.0);\n    satc_point_reflect(p, axis);\n    print_pt(\"reflect(2,3) along (1,0)\", p);\n  }\n  {\n    satc_point_alloca(p);\n    satc_point_set_xy(p, 1.0, 2.0);\n    satc_point_alloca(axis);\n    satc_point_set_xy(axis, 1.0, 1.0);\n    satc_point_reflect(p, axis);\n    print_pt(\"reflect(1,2) along (1,1)\", p);\n  }\n\n  // ========== Voronoi region ==========\n  {\n    satc_point_alloca(line);\n    satc_point_set_xy(line, 10.0, 0.0);\n    satc_point_alloca(p1);\n    satc_point_set_xy(p1, -5.0, 1.0);\n    satc_point_alloca(p2);\n    satc_point_set_xy(p2, 5.0, 1.0);\n    satc_point_alloca(p3);\n    satc_point_set_xy(p3, 15.0, 1.0);\n    printf(\"voronoi(10,0,-5,1): %d\\n\", satc_voronoi_region(line, p1));\n    printf(\"voronoi(10,0,5,1): %d\\n\", satc_voronoi_region(line, p2));\n    printf(\"voronoi(10,0,15,1): %d\\n\", satc_voronoi_region(line, p3));\n  }\n\n  // ========== flatten_points_on ==========\n  {\n    satc_point_array_alloca(points, 4);\n    satc_point_alloca_xy(p1, 0.0, 0.0);\n    satc_point_alloca_xy(p2, 10.0, 0.0);\n    satc_point_alloca_xy(p3, 10.0, 5.0);\n    satc_point_alloca_xy(p4, 0.0, 5.0);\n    points[0] = p1; points[1] = p2; points[2] = p3; points[3] = p4;\n    satc_double_array_alloca(result, 2);\n    satc_point_alloca_xy(axis, 1.0, 0.0);\n    satc_flatten_points_on(4, points, axis, result);\n    printf(\"flatten on x-axis: min=%.20g max=%.20g\\n\", result[0], result[1]);\n    satc_point_alloca_xy(axis2, 0.0, 1.0);\n    satc_flatten_points_on(4, points, axis2, result);\n    printf(\"flatten on y-axis: min=%.20g max=%.20g\\n\", result[0], result[1]);\n  }\n\n  // ========== Polygon centroid ==========\n  {\n    satc_point_array_alloca(points, 4);\n    satc_point_alloca_xy(pos, 0.0, 0.0);\n    satc_point_alloca_xy(a, 0.0, 0.0);\n    satc_point_alloca_xy(b, 40.0, 0.0);\n    satc_point_alloca_xy(c, 40.0, 40.0);\n    satc_point_alloca_xy(d, 0.0, 40.0);\n    points[0] = a; points[1] = b; points[2] = c; points[3] = d;\n    satc_polygon_t *polygon = satc_polygon_create(pos, 4, points);\n    double *centroid = satc_polygon_get_centroid(polygon);\n    print_pt(\"centroid square 40x40\", centroid);\n    satc_point_destroy(centroid);\n    satc_polygon_destroy(polygon);\n  }\n\n  // ========== Polygon AABB ==========\n  {\n    satc_point_array_alloca(points, 3);\n    satc_point_alloca_xy(pos, 50.0, 60.0);\n    satc_point_alloca_xy(a, 1.0, -2.0);\n    satc_point_alloca_xy(b, 4.0, 5.0);\n    satc_point_alloca_xy(c, -3.0, 7.0);\n    points[0] = a; points[1] = b; points[2] = c;\n    satc_polygon_t *polygon = satc_polygon_create(pos, 3, points);\n    satc_polygon_t *aabb = satc_polygon_get_aabb(polygon);\n    print_pt(\"aabb pos\", aabb->pos);\n    printf(\"aabb num_points: %zu\\n\", aabb->num_points);\n    for (size_t i = 0; i < aabb->num_points; i++) {\n      printf(\"aabb point[%zu]: %.20g %.20g\\n\", i, aabb->points[i][0], aabb->points[i][1]);\n    }\n    satc_polygon_destroy(aabb);\n    satc_polygon_destroy(polygon);\n  }\n\n  // ========== Circle AABB ==========\n  {\n    satc_point_alloca_xy(pos, 5.0, 7.0);\n    satc_circle_t *circle = satc_circle_create(pos, 3.0);\n    satc_polygon_t *aabb = satc_circle_get_aabb(circle);\n    print_pt(\"circle aabb pos\", aabb->pos);\n    printf(\"circle aabb num_points: %zu\\n\", aabb->num_points);\n    for (size_t i = 0; i < aabb->num_points; i++) {\n      printf(\"circle aabb point[%zu]: %.20g %.20g\\n\", i, aabb->points[i][0], aabb->points[i][1]);\n    }\n    satc_polygon_destroy(aabb);\n    satc_circle_destroy(circle);\n  }\n\n  // ========== Box to polygon ==========\n  {\n    satc_point_alloca_xy(pos, 1.0, 2.0);\n    satc_box_t *box = satc_box_create(pos, 10.0, 5.0);\n    satc_polygon_t *polygon = satc_box_to_polygon(box);\n    print_pt(\"box poly pos\", polygon->pos);\n    printf(\"box poly num_points: %zu\\n\", polygon->num_points);\n    for (size_t i = 0; i < polygon->num_points; i++) {\n      printf(\"box poly point[%zu]: %.20g %.20g\\n\", i, polygon->points[i][0], polygon->points[i][1]);\n    }\n    for (size_t i = 0; i < polygon->num_points; i++) {\n      printf(\"box poly normal[%zu]: %.20g %.20g\\n\", i, polygon->normals[i][0], polygon->normals[i][1]);\n    }\n    for (size_t i = 0; i < polygon->num_points; i++) {\n      printf(\"box poly edge[%zu]: %.20g %.20g\\n\", i, polygon->edges[i][0], polygon->edges[i][1]);\n    }\n    satc_polygon_destroy(polygon);\n    satc_box_destroy(box);\n  }\n\n  // ========== test_circle_circle ==========\n  {\n    satc_point_alloca_xy(p1, 0.0, 0.0);\n    satc_point_alloca_xy