n.size());\n    assert_eq!(elem.children.size(), 2);\n\n    let child1 = elem.children.get_element_at(0).unwrap();\n    println!(\"child1: tag={}, value={}\", child1.tag_name, child1.value);\n    assert_eq!(child1.tag_name, \"name\");\n    assert_eq!(child1.value, \"Kien Nguyen Trung\");\n    assert_eq!(child1.children.size(), 0);\n\n    let child2 = elem.children.get_element_at(1).unwrap();\n    println!(\"child2: tag={}, value={:?}, children={}\", child2.tag_name, child2.value, child2.children.size());\n    assert_eq!(child2.tag_name, \"languages\");\n    assert_eq!(child2.children.size(), 10);\n\n    let langs = [\"C\", \"C++\", \"Python\", \"Ruby\", \"Objective C\", \"Java\", \"Javascript\", \"Lua\", \"C#\", \"PHP\"];\n    for i in 0..10 {\n        let c = child2.children.get_element_at(i).unwrap();\n        assert_eq!(c.tag_name, \"language\");\n        assert_eq!(c.value, langs[i]);\n    }\n\n    println!(\"PASSED Test parser xml\");\n}\nEOF\nmkdir -p /tmp/harvest-crust-CKouR0/project/examples\ncp /tmp/test_xml.rs /tmp/harvest-crust-CKouR0/project/examples/test_xml.rs\ncargo run --example test_xml 2>&1 | tail -30","description":"Run XML test example"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":398,"cache_read_input_tokens":35187,"cache_creation":{"ephemeral_5m_input_tokens":398,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ef78c4b6-4ce7-46d6-b97b-89b95c9b71c0","uuid":"fff07a26-7a1f-4d87-a339-79fdb4198356"}
