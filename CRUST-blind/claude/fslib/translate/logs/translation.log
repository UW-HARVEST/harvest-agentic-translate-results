ates; ++s) {\n67\t        state = &orig->states[s];         \n68\t\n69\t        for(arc_t a=0; a < state->n_arcs; ++a) { \n70\t            arc = &state->arcs[a];\n71\t            fst_add_arc(    fst, \n72\t                            arc->state, \n73\t                            s, \n74\t                            arc->ilabel, \n75\t                            arc->olabel, \n76\t                            arc->weight);\n77\t        }\n78\t    }\n79\t\n80\t    fst_remove(orig);\n81\t}\n82\t\n83\tstruct _fst * fst_rm_states(struct _fst * fst, struct _bitset * mask) {\n84\t    struct _state * state;\n85\t    struct _arc * arc;\n86\t\n87\t    state_t idx[sizeof(state_t) * fst->n_states];\n88\t\n89\t    state_t shift = 0;\n90\t\n91\t    for(state_t s=0; s < fst->n_states; ++s) {\n92\t        if (bitset_get(mask, s) ) {\n93\t            ++shift;\n94\t        }\n95\t        else {\n96\t            idx[s] = shift;\n97\t            fst->states[s - shift] = fst->states[s];\n98\t        }\n99\t    } \n100\t\n101\t    fst->n_states -= shift;\n102\t\n103\t    // TODO: do not forget to clean up arcs of removed states\n104\t\n105\t    // fix arc's destination state id\n106\t    for(state_t s=0; s < fst->n_states; ++s) {\n107\t        state = &fst->states[s];\n108\t\n109\t        arc_t sh = 0;\n110\t        \n111\t        for(arc_t a=0; a < state->n_arcs; ++a) {\n112\t            arc = &state->arcs[a];\n113\t            arc->state -= idx[arc->state];\n114\t\n115\t            // found link to non-existing state\n116\t            if (arc->state >= fst->n_states) {\n117\t                ++sh;\n118\t            } else {\n119\t                state->arcs[a - sh] = state->arcs[a];\n120\t            }\n121\t        }\n122\t        \n123\t        state->n_arcs -= sh;\n124\t    }\n125\t\n126\t    return fst;\n127\t}\n128\t\n129\tstatic void fst_get_finals(struct _fst * fst, struct _queue * finals) {\n130\t    struct _state * state;\n131\t\n132\t    for (state_t s=0; s < fst->n_states; ++s