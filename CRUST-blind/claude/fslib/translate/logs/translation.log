{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_3swvz5ukzqhvluvd5mdze2ra2nmwltqd7wuendnemhs7gnhxcnwa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01PRpPpS3duvR53kmTp8JVfU","name":"Write","input":{"file_path":"/tmp/harvest-crust-Vge9FG/project/src/hash.rs","content":"use std::collections::LinkedList;\nuse std::hash::Hash;\nuse std::marker::PhantomData;\n\npub struct Bucket<K, V> {\n    pub items: LinkedList<HashItem<K, V>>,\n}\n\nimpl<K, V> Default for Bucket<K, V> {\n    fn default() -> Self {\n        Bucket {\n            items: LinkedList::new(),\n        }\n    }\n}\n\npub struct HashItem<K, V> {\n    pub key: K,\n    pub value: V,\n}\n\npub struct HashTable<K, V, F>\nwhere\n    K: Eq + Hash,\n    F: Fn(&K) -> usize,\n{\n    pub buckets: Vec<Bucket<K, V>>,\n    pub hash_f: F,\n    pub n_items: usize,\n    pub _marker: PhantomData<K>,\n}\nimpl<K, V, F> HashTable<K, V, F>\nwhere\n    K: Eq + Hash,\n    F: Fn(&K) -> usize,\n{\n    pub fn new(hash_f: F, size: usize) -> Self {\n        let mut buckets = Vec::with_capacity(size);\n        for _ in 0..size {\n            buckets.push(Bucket {\n                items: LinkedList::new(),\n            });\n        }\n        Self {\n            buckets,\n            hash_f,\n            n_items: 0,\n            _marker: PhantomData,\n        }\n    }\n    pub fn insert(&mut self, key: K, value: V) {\n        let size = self.buckets.len();\n        if size == 0 {\n            return;\n        }\n        let bnum = (self.hash_f)(&key) % size;\n        let bucket = &mut self.buckets[bnum];\n\n        // Check if key already exists; update if so\n        for item in bucket.items.iter_mut() {\n            if item.key == key {\n                item.value = value;\n                return;\n            }\n        }\n\n        bucket.items.push_back(HashItem { key, value });\n        self.n_items += 1;\n\n        // resize when load factor exceeded\n        let load_factor = self.n_items as f32 / size as f32;\n        if load_factor > 0.75 {\n            self.resize();\n        }\n    }\n    pub fn get(&self, key: &K) -> Option<&V> {\n        let size = self.buckets.len();\n        if size == 0 {\n            return None;\n        }\n        let bnum = (self.hash_f)(key) % size;\n        let bucket = &self.buckets[bnum];\n        for item in bucket.items.iter() {\n            if &item.key == key {\n                return Some(&item.value);\n            }\n        }\n        None\n    }\n    pub fn remove(&mut self, key: &K) {\n        let size = self.buckets.len();\n        if size == 0 {\n            return;\n        }\n        let bnum = (self.hash_f)(key) % size;\n        let bucket = &mut self.buckets[bnum];\n\n        let mut new_list = LinkedList::new();\n        let mut removed = false;\n        while let Some(item) = bucket.items.pop_front() {\n            if !removed && &item.key == key {\n                removed = true;\n            } else {\n                new_list.push_back(item);\n            }\n        }\n        bucket.items = new_list;\n        if removed {\n            self.n_items -= 1;\n        }\n    }\n    pub fn resize(&mut self) {\n        let new_size = self.buckets.len() * 2;\n        let mut new_buckets: Vec<Bucket<K, V>> = Vec::with_capacity(new_size);\n        for _ in 0..new_size {\n            new_buckets.push(Bucket {\n                items: LinkedList::new(),\n            });\n        }\n\n        let old_buckets = std::mem::replace(&mut self.buckets, new_buckets);\n        for bucket in old_buckets.into_iter() {\n            for item in bucket.items.into_iter() {\n                let bnum = (self.hash_f)(&item.key) % new_size;\n                self.buckets[bnum].items.push_back(item);\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1704,"cache_read_input_tokens":71770,"cache_creation":{"ep