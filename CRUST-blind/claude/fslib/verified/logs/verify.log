ap->items = malloc(heap->item_size * heap->n_max); \n69\t\n70\t    // create lookup hash table to track indexes\n71\t    heap->ht = NULL;\n72\t    \n73\t    return heap;\n74\t}\n75\t\n76\tstruct _hash * heap_index(struct _heap * heap, hash_func hsh, cmp_func hcmp) {\n77\t    if (heap->ht != NULL)\n78\t        hash_remove(heap->ht);\n79\t    \n80\t    heap->ht = hash_create( hsh, \n81\t                            hcmp, \n82\t                            heap->item_size,    // key size\n83\t                            sizeof(size_t),     // item size\n84\t                            heap->n_max         // init size\n85\t                        ); \n86\t    \n87\t    // lets index all the items \n88\t    for (size_t i = 0;  i < heap->n_items; ++i)\n89\t        hash_add(heap->ht, heap->items + i*heap->item_size, &i);\n90\t    \n91\t    return heap->ht;\n92\t}  \n93\t\n94\tvoid heap_remove(struct _heap * heap) {\n95\t    assert( heap != NULL ); \n96\t    assert( heap->items != NULL );\n97\t\n98\t    if (heap->ht != NULL) {\n99\t        hash_remove(heap->ht);\n100\t    }\n101\t\n102\t    free(heap->items);\n103\t    free(heap); \n104\t}\n105\t\n106\t/*\n107\t\n108\tPushing min element from heap.  When invoked the min element is\n109\tthe first element in array.\n110\t\n111\tTo safely remove the element (to keep the heap property) we have to\n112\tplace the last element to first position and invoke heapify method.\n113\t\n114\t*/\n115\tvoid * heap_pop(struct _heap * heap, void * item) {\n116\t    char * items = heap->items;\n117\t    size_t s = heap->item_size;\n118\t\n119\t    if (heap->n_items == 0)\n120\t        return NULL; \n121\t\n122\t    // get top node \n123\t    memcpy(item, items, s);\n124\t    --heap->n_items;\n125\t\n126\t    // if still not empty - move tail to head\n127\t    if (heap->n_items > 0) {\n128\t        memcpy(items, items + heap->n_items * s, s);\n129\t        // index\n130\t        size_t i=0;\n131\t        if (heap->ht != NULL)  \n132\t            hash_add(heap->ht, items, &i);\n133\t    }\n134\t\n135\t    // heapify if more than 1\n136\t    if (heap->n_items > 1)\n137\t        heap_heapify(heap, 0);\n138\t\n139\t    return item;\n140\t}\n141\t\n142\t/* Methods keep the heap property (see Cormen et al) */\n143\t\n144\tvoid heap_heapify(struct _heap * heap, size_t i) {\n145\t    char * items = heap->items;\n146\t    size_t s = heap->item_size;\n147\t\n148\t    size_t l, r, mx;\n149\t    int done = 0;\n150\t\n151\t    assert( i < heap->n_items );\n152\t\n153\t    while (!done) {\n154\t        l = HEAP_LEFT(i);\n155\t        r = HEAP_RIGHT(i);\n156\t\n157\t        mx = ( l < heap->n_items && heap->cmp(items + l*s, items + i*s)) \n158\t            ?  l : i;  \n159\t        mx = ( r < heap->n_items && heap->cmp(items + r*s, items + mx*s)) \n160\t            ? r : mx;\n161\t        \n162\t        if (mx != i) {\n163\t            heap_items_swap(heap, i, mx);\n164\t            i = mx;\n165\t        } else {\n166\t            done=1;\n167\t        }\n168\t    }\n169\t}\n170\t\n171\tstatic void heap_delete_max(struct _heap * heap) {\n172\t    // using linear search to find max element\n173\t    char * items = heap->items; \n174\t    size_t s = heap->item_size;\n175\t\n176\t    size_t m = 0; \n177\t    for (size_t i = 1; i < heap->n_items + 1; ++i) {\n178\t        if ( heap->cmp(items +m*s, items + i*s))  m = i;\n179\t    }\n180\t\n181\t    // replace with the last element \n182\t    if (m != heap->n_items) {  // is already the last, do nothing\n183\t        memcpy(items + m*s, items + heap->n_items*s, s); \n184\t\n185\t        // index \n186\t        if (heap->ht != NULL) \n187\t            hash_add(heap->ht, items + m*s, &m);\n188\t\n189\t        heap_update(heap, NULL, m);\n190\t    }\n191\t}\n192\t\n193\tvoid heap_insert(struct _heap * heap, void * item) {\n194\t    size_t s = heap->item_size;\n195\t\n196\t    if (heap->limit == 0 && heap->n_max == heap->n_items) {\n197\t        heap->n_max *= HEAP_RESIZE_FACTOR;\n198\t        heap->items = realloc(heap->items, heap->n_max * s);\n199\t    }\n200\t\n201\t    // move to tail\n202\t    memcpy(heap->items + heap->n_items * s, item, s);\n203\t\n204\t    // index\n205\t    if (heap->ht != NULL) \n206\t        hash_add(heap->ht, item, &heap->n_items);\n207\t\n208\t    /* \n209\t\n210\t    A little trick here:\n211\t    we invoke heap_update with NULL to specify\n212\t    that we don't need an assignment and value check.\n213\t\n214\t    */\n215\t\n216\t    if (heap->limit == 0 || heap->n_items < heap->limit) {\n217\t        heap_update(heap, NULL, heap->n_items++);\n218\t    } else {\n219\t        heap_delete_max(heap);\n220\t    }\n221\t}\n222\t\n223\t/* \n224\t\n225\tUpdating the i-th heap element \n226\tNote: it is possible only to\n227\t    -  decrease weight for MIN HEAP\n228\t    -  increase weight for MAX HEAP\n229\t\n230\t*/\n231\t\n232\tvoid heap_update(struct _heap * heap, void * item, size_t i) { \n233\t    char * items = heap->items;\n234\t    size_t s = heap->item_size;\n235\t    size_t j;\n236\t    \n237\t    // remove assertion for equality\n238\t    assert ( i < heap->n_items );\n239\t\n240\t    if (item != NULL) {  // if invoked directly\n241\t        // check if we reducing the priority and \n242\t        // not increasing it\n243\t        assert( heap->cmp(item, items + i*s) );\n244\t        memcpy(items + i*s, item, s);\n245\t\n246\t        // index\n247\t        if (heap->ht != NULL) \n248\t            hash_add(heap->ht, item, &i);\n249\t    }\n250\t\n251\t    while (i > 0 && heap->cmp(items + i*s, items + HEAP_PARENT(i)*s)) {\n252\t        j = HEAP_PARENT(i);\n253\t        heap_items_swap(heap, i, j);\n254\t\n255\t        i = j;\n256\t    }\n257\t}\n258\t\n259\t// hash\n260\tvoid * heap_find(struct _heap * heap, void * item, size_t * pi) {\n261\t    assert( heap->ht != NULL );\n262\t\n263\t    return  hash_get(heap->ht, item, pi);\n264\t}\n265\t\n266\t\n267\t"}]},"parent_tool_use_id":null,"session_id":"7fa0c9