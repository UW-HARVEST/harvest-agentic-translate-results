\n}\n\n#[test]\nfn test_sort_multiple_states() {\n    let mut f = Fst::new();\n    for _ in 0..3 {\n        f.add_state();\n    }\n    f.add_arc(0, 1, 3, 0, 0.0);\n    f.add_arc(0, 1, 1, 0, 0.0);\n    f.add_arc(0, 1, 2, 0, 0.0);\n    f.add_arc(1, 2, 5, 0, 0.0);\n    f.add_arc(1, 2, 4, 0, 0.0);\n    fst_arc_sort(&mut f, false);\n    let s0 = &f.states[0].arcs;\n    assert_eq!(s0[0].ilabel, 1);\n    assert_eq!(s0[1].ilabel, 2);\n    assert_eq!(s0[2].ilabel, 3);\n    let s1 = &f.states[1].arcs;\n    assert_eq!(s1[0].ilabel, 4);\n    assert_eq!(s1[1].ilabel, 5);\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1568,"cache_read_input_tokens":142367,"cache_creation":{"ephemeral_5m_input_tokens":1568,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7fa0c99d-4e20-4d9f-a320-9f716e415628","uuid":"f28fcc80-4aa6-44b2-b6c3-0999b703cfd7"}
