n233\t}\n234\t\n235\tpub fn compile_internal(\n236\t    fst: &mut fst::Fst,\n237\t    fin: &mut dyn BufRead,\n238\t    ist: Option<&SymTable>,\n239\t    ost: Option<&SymTable>,\n240\t    sst: Option<&SymTable>,\n241\t    is_acc: bool,\n242\t) -> io::Result<()> {\n243\t    let mut buf = String::new();\n244\t    let mut line: usize = 1;\n245\t    loop {\n246\t        buf.clear();\n247\t        let n = fin.read_line(&mut buf)?;\n248\t        if n == 0 {\n249\t            break;\n250\t        }\n251\t        line += 1;\n252\t        let res = if !is_acc {\n253\t            parse_line_sym(fst, &buf, ist, ost, sst)\n254\t        } else {\n255\t            parse_line_sym_acc(fst, &buf, ist, sst)\n256\t        };\n257\t        if res != 0 {\n258\t            return Err(io::Error::new(\n259\t                io::ErrorKind::InvalidData,\n260\t                format!(\"Invalid input line {}: {}\", line, buf),\n261\t            ));\n262\t        }\n263\t    }\n264\t    if let Some(sst) = sst {\n265\t        if let Some(start) = sst.getr(fst::START_STATE) {\n266\t            if start >= 0 {\n267\t                fst.start = start as fst::State;\n268\t            }\n269\t        }\n270\t    }\n271\t    Ok(())\n272\t}\n273\t\n274\tpub fn compile_str_internal(fst: &mut fst::Fst, s: &str) {\n275\t    for line in s.split('\\n') {\n276\t        if line.is_empty() {\n277\t            continue;\n278\t        }\n279\t        let _ = parse_line(fst, line);\n280\t    }\n281\t}\n282\t\n283\t#[allow(dead_code)]\n284\tfn fst_compile(\n285\t    fst: &mut fst::Fst,\n286\t    fin: &mut dyn BufRead,\n287\t    ist: &SymTable,\n288\t    ost: &SymTable,\n289\t    sst: &SymTable,\n290\t    is_acc: bool,\n291\t) -> fst::Fst {\n292\t    let _ = compile_internal(fst, fin, Some(ist), Some(ost), Some(sst), is_acc);\n293\t    std::mem::replace(fst, fst::Fst::new())\n294\t}\n295\t\n296\t#[allow(dead_code)]\n297\tfn fst_compile_str(fst: &mut fst::Fst, s: &str) -> fst::Fst {\n298\t    compile_str_internal(fst,