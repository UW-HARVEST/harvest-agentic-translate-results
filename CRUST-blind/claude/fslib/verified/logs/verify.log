n                    });\n                }\n                t += 1;\n            }\n            i += 1;\n        }\n    }\n    out\n}\n\nfn match_half_sorted<W: Semiring>(arcs_a: &[Arc<W>], arcs_b: &[Arc<W>]) -> Vec<ArcPair<W>> {\n    let m = arcs_a.len();\n    let n = arcs_b.len();\n    let mut out = Vec::new();\n    if n == 0 {\n        return out;\n    }\n    for i in 0..m {\n        let mut l: usize = 0;\n        let mut h: usize = n - 1;\n        loop {\n            if l > h {\n                break;\n            }\n            let mid = (l + h) >> 1;\n            if arcs_a[i].olabel > arcs_b[mid].ilabel {\n                l = mid + 1;\n            } else if arcs_a[i].olabel < arcs_b[mid].ilabel {\n                if mid == 0 {\n                    break;\n                }\n                h = mid - 1;\n            } else {\n                let mut ll = mid;\n                let mut hh = mid;\n                while ll > l && arcs_a[i].olabel == arcs_b[ll - 1].ilabel {\n                    ll -= 1;\n                }\n                while hh < h && arcs_a[i].olabel == arcs_b[hh + 1].ilabel {\n                    hh += 1;\n                }\n                while ll <= hh {\n                    if arc_match(arcs_a, arcs_b, i, ll) {\n                        out.push(ArcPair {\n                            a: arcs_a[i].clone(),\n                            b: arcs_b[ll].clone(),\n                        });\n                    }\n                    ll += 1;\n                }\n                break;\n            }\n        }\n    }\n    out\n}\n\nfn match_half_sorted_rev<W: Semiring>(arcs_a: &[Arc<W>], arcs_b: &[Arc<W>]) -> Vec<ArcPair<W>> {\n    let m = arcs_a.len();\n    let n = arcs_b.len();\n    let mut out = Vec::new();\n    if m == 0 {\n        return out;\n    }\n    for i in 0..n {\n        let mut l: usize = 0;\n        let mut h: usize = m - 1;\n        loop {\n            if l > h {\n                break;\n            }\n            let mid = (l + h