   fst_set_final(fst, 3, 0.9);\n        fst_trim(fst);\n        printf(\"n_states=%u start=%u\\n\", fst->n_states, fst->start);\n        for (state_t s = 0; s < fst->n_states; ++s) {\n            struct _state * st = &fst->states[s];\n            printf(\"state %u: final=%d w=%g\\n\", s, st->final, st->weight);\n            for (arc_t a = 0; a < st->n_arcs; ++a) {\n                struct _arc * ar = &st->arcs[a];\n                printf(\"  -> %u il=%u ol=%u w=%g\\n\", ar->state, ar->ilabel, ar->olabel, ar->weight);\n            }\n        }\n        fst_remove(fst);\n    } else if (strcmp(t, \"compose_eps\") == 0) {\n        // A: 0 -> 1 (a:eps), 1 -> 2 (b:c), 2 final\n        struct _fst * a = fst_create();\n        for (int i=0;i<3;++i) fst_add_state(a);\n        fst_add_arc(a, 0, 1, 1, 0, 0);\n        fst_add_arc(a, 1, 2, 2, 3, 0);\n        fst_set_final(a, 2, 0);\n        // B: 0 -> 1 (eps:x), 1 -> 2 (c:d), 2 final\n        struct _fst * b = fst_create();\n        for (int i=0;i<3;++i) fst_add_state(b);\n        fst_add_arc(b, 0, 1, 0, 5, 0);\n        fst_add_arc(b, 1, 2, 3, 4, 0);\n        fst_set_final(b, 2, 0);\n        struct _fst * c = fst_create();\n        fst_compose(a, b, c);\n        printf(\"n_states=%u\\n\", c->n_states);\n        for (state_t s = 0; s < c->n_states; ++s) {\n            struct _state * st = &c->states[s];\n            printf(\"state %u final=%d:\\n\", s, st->final);\n            for (arc_t aa = 0; aa < st->n_arcs; ++aa) {\n                struct _arc * ar = &st->arcs[aa];\n                printf(\"  -> %u il=%u ol=%u w=%g\\n\", ar->state, ar->ilabel, ar->olabel, ar->weight);\n            }\n        }\n        fst_remove(a); fst_remove(b); fst_remove(c);\n    }\n    return 0;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":626,"cache_read_input_tokens":106373,"cache_creation":{"ephemeral_5m_input_tokens":626,"ephemeral_1h_input_tokens":0},"output_tokens":37,