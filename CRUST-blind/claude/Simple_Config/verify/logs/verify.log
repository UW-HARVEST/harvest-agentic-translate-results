{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0131dR3iKNf32JcegK5snTT7","type":"tool_result","content":"1\tuse std::{fmt::Display, fs::File, io::Write as IoWrite};\n2\t// Constants\n3\tpub const CFG_FILE_EXT: &str = \".cfg\";\n4\tpub const CFG_MAX_KEY: usize = 32;\n5\tpub const CFG_MAX_VAL: usize = 64;\n6\tpub const CFG_MAX_ERR: usize = 64;\n7\t// Structures and Enums\n8\t#[derive(Clone, Copy, PartialEq, Debug)]\n9\tpub struct CfgColor {\n10\t    pub r: u8,\n11\t    pub g: u8,\n12\t    pub b: u8,\n13\t    pub a: u8,\n14\t}\n15\t#[derive(Clone, Debug, PartialEq)]\n16\tpub struct CfgError {\n17\t    pub off: i32,\n18\t    pub col: i32,\n19\t    pub row: i32,\n20\t    pub msg: String,\n21\t}\n22\timpl Default for CfgError {\n23\t    fn default() -> Self {\n24\t        CfgError {\n25\t            off: 0,\n26\t            col: 0,\n27\t            row: 0,\n28\t            msg: String::new(),\n29\t        }\n30\t    }\n31\t}\n32\t#[derive(Clone, PartialEq, Debug)]\n33\tpub enum CfgVal {\n34\t    String(String),\n35\t    Boolean(bool),\n36\t    Int(i32),\n37\t    Float(f32),\n38\t    Color(CfgColor),\n39\t}\n40\timpl From<&str> for CfgVal {\n41\t    fn from(s: &str) -> Self {\n42\t        CfgVal::String(s.to_string())\n43\t    }\n44\t}\n45\timpl From<String> for CfgVal {\n46\t    fn from(s: String) -> Self {\n47\t        CfgVal::String(s)\n48\t    }\n49\t}\n50\timpl From<bool> for CfgVal {\n51\t    fn from(b: bool) -> Self {\n52\t        CfgVal::Boolean(b)\n53\t    }\n54\t}\n55\timpl From<i32> for CfgVal {\n56\t    fn from(i: i32) -> Self {\n57\t        CfgVal::Int(i)\n58\t    }\n59\t}\n60\timpl From<f32> for CfgVal {\n61\t    fn from(f: f32) -> Self {\n62\t        CfgVal::Float(f)\n63\t    }\n64\t}\n65\timpl From<CfgColor> for CfgVal {\n66\t    fn from(c: CfgColor) -> Self {\n67\t        CfgVal::Color(c)\n68\t    }\n69\t}\n70\timpl From<(u8, u8, u8, u8)> for CfgColor {\n71\t    fn from((r, g, b, a): (u8, u8, u8, u8)) -> Self {\n72\t        CfgColor { r, g, b, a }\n73\t    }\n74\t}\n75\t#[derive(Clone, PartialEq, Debug)]\n76\tpub struct CfgEntry {\n77\t    pub key: String,\n78\t    pub val: CfgVal,\n79\t}\n80\t#[derive(Clone, PartialEq, Debug)]\n81\tpub struct Cfg {\n82\t    pub entries: Vec<CfgEntry>,\n83\t    pub count: i32,\n84\t    pub capacity: usize,\n85\t}\n86\timpl Display for CfgError {\n87\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n88\t        if self.row == -1 && self.col == -1 {\n89\t            write!(f, \"Error: {}\", self.msg)\n90\t        } else {\n91\t            write!(f, \"Error at {}:{} :: {}\", self.row, self.col, self.msg)\n92\t        }\n93\t    }\n94\t}\n95\timpl Display for CfgColor {\n96\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n97\t        write!(f, \"rgba({}, {}, {}, {})\", self.r, self.g, self.b, self.a)\n98\t    }\n99\t}\n100\timpl Display for CfgVal {\n101\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n102\t        match self {\n103\t            CfgVal::String(s) => write!(f, \"\\\"{}\\\"\", s),\n104\t            CfgVal::Boolean(b) => {\n105\t                write!(f, \"{}\", if *b { \"true\" } else { \"false\" })\n106\t            }\n107\t            CfgVal::Int(i) => write!(f, \"{}\", i),\n108\t            CfgVal::Float(fl) => write!(f, \"{:.6}\", fl),\n109\t            CfgVal::Color(c) => write!(f, \"{}\", c),\n110\t        }\n111\t    }\n112\t}\n113\timpl Display for CfgEntry {\n114\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n115\t        write!(f, \"{}: {}\", self.key, self.val)\n116\t    }\n117\t}\n118\timpl Display for Cfg {\n119\t    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n120\t        let n = (self.count.max(0) as usize).min(self.entries.len());\n121\t        for i in 0..n {\n122\t            writeln!(f, \"{}\", self.entries[i])?;\n123\t        }\n124\t        Ok(())\n125\t    }\n126\t}\n127\tpub struct Scanner {\n128\t    pub src: String,\n129\t    pub len: i32,\n130\t    pub cur: i32,\n131\t}\n132\t\n133\t// ===== Internal parser helpers =====\n134\t\n135\tstruct ParseScanner<'a> {\n136\t    src: &'a [u8],\n137\t    cur: usize,\n138\t}\n139\t\n140\timpl<'a> ParseScanner<'a> {\n141\t    fn new(src: &'a str) -> Self {\n142\t        Self {\n143\t            src: src.as_bytes(),\n144\t            cur: 0,\n145\t        }\n146\t    }\n147\t\n148\t    fn is_at_end(&self) -> bool {\n149\t        self.cur >= self.src.len()\n150\t    }\n151\t\n152\t    fn peek(&self) -> u8 {\n153\t        if self.cur < self.src.len() {\n154\t            self.src[self.cur]\n155\t        } else {\n156\t            0\n157\t        }\n158\t    }\n159\t\n160\t    fn peek_next(&self) -> u8 {\n161\t        if self.cur + 1 >= self.src.len() {\n162\t            0\n163\t        } else {\n164\t            self.src[self.cur + 1]\n165\t        }\n166\t    }\n167\t\n168\t    fn advance(&mut self) -> u8 {\n169\t        let c = self.peek();\n170\t        self.cur += 1;\n171\t        c\n172\t    }\n173\t\n174\t    fn set_cur(&mut self, n: usize) {\n175\t        self.cur = n;\n176\t    }\n177\t}\n178\t\n179\tfn is_space_byte(c: u8) -> bool {\n180\t    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0B | 0x0C | b'\\r')\n181\t}\n182\t\n183\tfn is_blank_byte(c: u8) -> bool {\n184\t    matches!(c, b' ' | b'\\t')\n185\t}\n186\t\n187\tfn is_alpha_byte(c: u8) -> bool {\n188\t    c.is_ascii_alphabetic()\n189\t}\n190\t\n191\tfn is_digit_byte(c: u8) -> bool {\n192\t    c.is_ascii_digit()\n193\t}\n194\t\n195\tfn is_alnum_byte(c: u8) -> bool {\n196\t    c.is_ascii_alphanumeric()\n197\t}\n198\t\n199\tfn is_punct_byte(c: u8) -> bool {\n200\t    c.is_ascii_punctuation()\n201\t}\n202\t\n203\tfn is_key_byte(c: u8) -> bool {\n204\t    is_alpha_byte(c) || c == b'.' || c == b'_'\n205\t}\n206\t\n207\tfn is_string_byte(c: u8) -> bool {\n208\t    is_alnum_byte(c) || is_blank_byte(c) || (is_punct_byte(c) && c != b'\"')\n209\t}\n210\t\n211\tfn skip_whitespace(s: &mut ParseScanner) {\n212\t    while !s.is_at_end() && is_space_byte(s.peek()) {\n213\t        s.advance();\n214\t    }\n215\t}\n216\t\n217\tfn skip_blank(s: &mut ParseScanner) {\n218\t    while !s.is_at_end() && is_space_byte(s.peek()) && s.peek() != b'\\n' {\n219\t        s.advance();\n220\t    }\n221\t}\n222\t\n223\tfn skip_comment(s: &mut ParseScanner) {\n224\t    while !s.is_at_end() && s.peek() == b'#' {\n225\t        loop {\n226\t            s.advance();\n227\t            if s.is_at_end() || s.peek() == b'\\n' {\n228\t                break;\n229\t            }\n230\t        }\n231\t    }\n232\t}\n233\t\n234\tfn skip_whitespace_and_comments(s: &mut ParseScanner) {\n235\t    while !s.is_at_end() && (is_space_byte(s.peek()) || s.peek() == b'#') {\n236\t        skip_whitespace(s);\n237\t        skip_comment(s);\n238\t    }\n239\t}\n240\t\n241\tfn match_literal(s: &ParseScanner, offset: usize, literal: &str) -> bool {\n242\t    let lit = literal.as_bytes();\n243\t    if offset + lit.len() > s.src.len() {\n244\t        return false;\n245\t    }\n246\t    &s.src[offset..offset + lit.len()] == lit\n247\t}\n248\t\n249\tfn consume_literal(s: &mut ParseScanner, offset: usize, literal: &str) -> bool {\n250\t    if match_literal(s, offset, literal) {\n251\t        s.cur += literal.len();\n252\t        true\n253\t    } else {\n254\t        false\n255\t    }\n256\t}\n257\t\n258\tfn make_error(s: &ParseScanner, msg: &str) -> CfgError {\n259\t    let mut row = 1i32;\n260\t    let mut col = 1i32;\n261\t    let upto = s.cur.min(s.src.len());\n262\t    for i in 0..upto {\n263\t        col += 1;\n264\t        if s.src[i] == b'\\n' {\n265\t            row += 1;\n266\t            col = 1;\n267\t        }\n268\t    }\n269\t    // Truncate to CFG_MAX_ERR - 1 (matching snprintf semantics)\n270\t    let mut truncated = msg.to_string();\n271\t    if truncated.len() > CFG_MAX_ERR - 1 {\n272\t        let mut end = CFG_MAX_ERR - 1;\n273\t        while end > 0 && !truncated.is_char_boundary(end) {\n274\t            end -= 1;\n275\t        }\n276\t        truncated.truncate(end);\n277\t    }\n278\t    CfgError {\n279\t        off: s.cur as i32,\n280\t        col,\n281\t        row,\n282\t        msg: truncated,\n283\t    }\n284\t}\n285\t\n286\tfn slice_to_string(s: &ParseScanner, offset: usize, len: usize) -> String {\n287\t    std::str::from_utf8(&s.src[offset..offset + len])\n288\t        .unwrap_or(\"\")\n289\t        .to_string()\n290\t}\n291\t\n292\tfn parse_string(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n293\t    // Consume opening '\"'\n294\t    s.advance();\n295\t\n296\t    let val_offset = s.cur;\n297\t    while !s.is_at_end() && is_string_byte(s.peek()) {\n298\t        s.advance();\n299\t    }\n300\t\n301\t    if s.is_at_end() || s.peek() != b'\"' {\n302\t        return Err(make_error(s, \"closing '\\\"' expected\"));\n303\t    }\n304\t\n305\t    let val_len = s.cur - val_offset;\n306\t    if val_len > CFG_MAX_VAL {\n307\t        return Err(make_error(s, \"value too long\"));\n308\t    }\n309\t\n310\t    // Consume closing '\"'\n311\t    s.advance();\n312\t\n313\t    Ok(CfgVal::String(slice_to_string(s, val_offset, val_len)))\n314\t}\n315\t\n316\tfn consume_int(s: &mut ParseScanner) -> Result<i32, CfgError> {\n317\t    let mut sign: i32 = 1;\n318\t    let mut num: i32 = 0;\n319\t\n320\t    if !s.is_at_end() && s.peek() == b'-' && is_digit_byte(s.peek_next()) {\n321\t        s.advance();\n322\t        sign = -1;\n323\t    }\n324\t\n325\t    if !s.is_at_end() && !is_digit_byte(s.peek()) {\n326\t        return Err(make_error(s, \"number expected\"));\n327\t    }\n328\t\n329\t    while !s.is_at_end() && is_digit_byte(s.peek()) {\n330\t        let digit = (s.advance() - b'0') as i32;\n331\t        if num > (i32::MAX - digit) / 10 {\n332\t            return Err(make_error(s, \"number too large\"));\n333\t        }\n334\t        num = num * 10 + digit;\n335\t    }\n336\t\n337\t    Ok(sign * num)\n338\t}\n339\t\n340\tfn consume_float(s: &mut ParseScanner) -> Result<f32, CfgError> {\n341\t    let mut sign: i32 = 1;\n342\t    let mut int_part: i32 = 0;\n343\t    let mut fract_part: i32 = 0;\n344\t\n345\t    if !s.is_at_end() && s.peek() == b'-' && is_digit_byte(s.peek_next()) {\n346\t        s.advance();\n347\t        sign = -1;\n348\t    }\n349\t\n350\t    if !s.is_at_end() && !is_digit_byte(s.peek()) {\n351\t        return Err(make_error(s, \"number expected\"));\n352\t    }\n353\t\n354\t    while !s.is_at_end() && is_digit_byte(s.peek()) {\n355\t        let digit = (s.advance() - b'0') as i32;\n356\t        if int_part > (i32::MAX - digit) / 10 {\n357\t            return Err(make_error(s, \"number too large\"));\n358\t        }\n359\t        int_part = int_part * 10 + digit;\n360\t    }\n361\t\n362\t    if !s.is_at_end() && s.peek() != b'.' {\n363\t        return Err(make_error(s, \"float expected\"));\n364\t    }\n365\t\n366\t    // Consume '.'\n367\t    if !s.is_at_end() {\n368\t        s.advance();\n369\t    }\n370\t\n371\t    let mut div: i32 = 1;\n372\t    while !s.is_at_end() && is_digit_byte(s.peek()) {\n373\t        let digit = (s.advance() - b'0') as i32;\n374\t        if fract_part > (i32::MAX - digit) / 10 {\n375\t            return Err(make_error(s, \"number too large\"));\n376\t        }\n377\t        fract_part = fract_part * 10 + digit;\n378\t        if div > i32::MAX / 10 {\n379\t            return Err(make_error(s, \"number too large\"));\n380\t        }\n381\t        div *= 10;\n382\t    }\n383\t\n384\t    let floating = int_part as f32 + (fract_part as f32 / div as f32);\n385\t    Ok(sign as f32 * floating)\n386\t}\n387\t\n388\tfn match_float(s: &mut ParseScanner) -> bool {\n389\t    let restore = s.cur;\n390\t    let mut is_float = false;\n391\t\n392\t    if !s.is_at_end() && s.peek() == b'-' && is_digit_byte(s.peek_next()) {\n393\t        s.advance();\n394\t    }\n395\t\n396\t    while !s.is_at_end() && is_digit_byte(s.peek()) {\n397\t        s.advance();\n398\t    }\n399\t\n400\t    if !s.is_at_end() && s.peek() == b'.' {\n401\t        is_float = true;\n402\t    }\n403\t\n404\t    s.set_cur(restore);\n405\t    is_float\n406\t}\n407\t\n408\tfn parse_number(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n409\t    if match_float(s) {\n410\t        let number = consume_float(s)?;\n411\t        Ok(CfgVal::Float(number))\n412\t    } else {\n413\t        let number = consume_int(s)?;\n414\t        Ok(CfgVal::Int(number))\n415\t    }\n416\t}\n417\t\n418\tfn parse_rgba(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n419\t    if !consume_literal(s, s.cur, \"rgba\") {\n420\t        return Err(make_error(s, \"invalid literal\"));\n421\t    }\n422\t\n423\t    skip_blank(s);\n424\t\n425\t    if s.is_at_end() || s.peek() != b'(' {\n426\t        return Err(make_error(s, \"'(' expected\"));\n427\t    }\n428\t\n429\t    // Consume '('\n430\t    s.advance();\n431\t\n432\t    let mut rgb = [0u8; 3];\n433\t    for i in 0..3 {\n434\t        skip_blank(s);\n435\t\n436\t        if match_float(s) {\n437\t            return Err(make_error(\n438\t                s,\n439\t                \"red, blue and green must be integers in range [0, 255]\",\n440\t            ));\n441\t        }\n442\t\n443\t        let number = consume_int(s)?;\n444\t\n445\t        if !(0..=255).contains(&number) {\n446\t            return Err(make_error(\n447\t                s,\n448\t                \"red, blue and green must be integers in range [0, 255]\",\n449\t            ));\n450\t        }\n451\t\n452\t        rgb[i] = number as u8;\n453\t\n454\t        skip_blank(s);\n455\t\n456\t        if s.is_at_end() || s.peek() != b',' {\n457\t            return Err(make_error(s, \"',' expected\"));\n458\t        }\n459\t\n460\t        s.advance();\n461\t    }\n462\t\n463\t    skip_blank(s);\n464\t\n465\t    let alpha: u8;\n466\t    if match_float(s) {\n467\t        let number = consume_float(s)?;\n468\t        if !(0.0..=1.0).contains(&number) {\n469\t            return Err(make_error(s, \"alpha must be in range [0, 1]\"));\n470\t        }\n471\t        alpha = (number * 255.0) as u8;\n472\t    } else {\n473\t        let number = consume_int(s)?;\n474\t        if !(0..=1).contains(&number) {\n475\t            return Err(make_error(s, \"alpha must be in range [0, 1]\"));\n476\t        }\n477\t        alpha = (number * 255) as u8;\n478\t    }\n479\t\n480\t    skip_blank(s);\n481\t\n482\t    if s.is_at_end() || s.peek() != b')' {\n483\t        return Err(make_error(s, \"')' expected\"));\n484\t    }\n485\t\n486\t    s.advance();\n487\t\n488\t    Ok(CfgVal::Color(CfgColor {\n489\t        r: rgb[0],\n490\t        g: rgb[1],\n491\t        b: rgb[2],\n492\t        a: alpha,\n493\t    }))\n494\t}\n495\t\n496\tfn parse_true(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n497\t    if !consume_literal(s, s.cur, \"true\") {\n498\t        return Err(make_error(s, \"invalid literal\"));\n499\t    }\n500\t    Ok(CfgVal::Boolean(true))\n501\t}\n502\t\n503\tfn parse_false(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n504\t    if !consume_literal(s, s.cur, \"false\") {\n505\t        return Err(make_error(s, \"invalid literal\"));\n506\t    }\n507\t    Ok(CfgVal::Boolean(false))\n508\t}\n509\t\n510\tfn parse_literal(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n511\t    match s.peek() {\n512\t        b't' => parse_true(s),\n513\t        b'f' => parse_false(s),\n514\t        b'r' => parse_rgba(s),\n515\t        _ => Err(make_error(s, \"invalid literal\")),\n516\t    }\n517\t}\n518\t\n519\tfn parse_value(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n520\t    // Skip blank space between ':' and the value\n521\t    skip_blank(s);\n522\t\n523\t    if s.is_at_end() || s.peek() == b'\\n' {\n524\t        return Err(make_error(s, \"missing value\"));\n525\t    }\n526\t\n527\t    let c = s.peek();\n528\t\n529\t    if c == b'\"' {\n530\t        parse_string(s)\n531\t    } else if is_alpha_byte(c) {\n532\t        parse_literal(s)\n533\t    } else if is_digit_byte(c) || (c == b'-' && is_digit_byte(s.peek_next())) {\n534\t        parse_number(s)\n535\t    } else {\n536\t        Err(make_error(s, \"invalid value\"))\n537\t    }\n538\t}\n539\t\n540\tfn parse_key(s: &mut ParseScanner) -> Result<String, CfgError> {\n541\t    if s.is_at_end() || !is_key_byte(s.peek()) {\n542\t        return Err(make_error(s, \"missing key\"));\n543\t    }\n544\t\n545\t    let key_offset = s.cur;\n546\t    s.advance();\n547\t    while !s.is_at_end() && is_key_byte(s.peek()) {\n548\t        s.advance();\n549\t    }\n550\t    let key_len = s.cur - key_offset;\n551\t\n552\t    if key_len > CFG_MAX_KEY {\n553\t        return Err(make_error(s, \"key too long\"));\n554\t    }\n555\t\n556\t    Ok(slice_to_string(s, key_offset, key_len))\n557\t}\n558\t\n559\tfn consume_colon(s: &mut ParseScanner) -> Result<(), CfgError> {\n560\t    skip_blank(s);\n561\t\n562\t    if s.is_at_end() || s.peek() != b':' {\n563\t        return Err(make_error(s, \"':' expected\"));\n564\t    }\n565\t\n566\t    s.advance();\n567\t    Ok(())\n568\t}\n569\t\n570\tfn parse_entry(s: &mut ParseScanner) -> Result<CfgEntry, CfgError> {\n571\t    let key = parse_key(s)?;\n572\t    consume_colon(s)?;\n573\t    let val = parse_value(s)?;\n574\t\n575\t    skip_blank(s);\n576\t\n577\t    if !s.is_at_end() && s.peek() == b'#' {\n578\t        skip_comment(s);\n579\t    }\n580\t\n581\t    if !s.is_at_end() && s.peek() != b'\\n' {\n582\t        let ch = s.peek() as char;\n583\t        return Err(make_error(s, &format!(\"unexpected character '{}'\", ch)));\n584\t    }\n585\t\n586\t    if !s.is_at_end() {\n587\t        s.advance();\n588\t    }\n589\t\n590\t    Ok(CfgEntry { key, val })\n591\t}\n592\t\n593\t// Public Functions\n594\tpub fn cfg_parse(src: &str) -> Result<Cfg, CfgError> {\n595\t    let mut s = ParseScanner::new(src);\n596\t    let mut entries: Vec<CfgEntry> = Vec::new();\n597\t\n598\t    skip_whitespace_and_comments(&mut s);\n599\t\n600\t    while !s.is_at_end() {\n601\t        let entry = parse_entry(&mut s)?;\n602\t        entries.push(entry);\n603\t        skip_whitespace_and_comments(&mut s);\n604\t    }\n605\t\n606\t    let count = entries.len() as i32;\n607\t    let capacity = entries.len();\n608\t    Ok(Cfg {\n609\t        entries,\n610\t        count,\n611\t        capacity,\n612\t    })\n613\t}\n614\t\n615\tpub fn cfg_parse_file(filename: &str) -> Result<Cfg, CfgError> {\n616\t    let len = filename.len();\n617\t    if len < 5 {\n618\t        return Err(CfgError {\n619\t            off: -1,\n620\t            col: -1,\n621\t            row: -1,\n622\t            msg: \"invalid filename\".to_string(),\n623\t        });\n624\t    }\n625\t\n626\t    let ext_start = len - CFG_FILE_EXT.len();\n627\t    // Ensure char boundary (filename is &str so safe at byte boundary for ASCII)\n628\t    let ext = if filename.is_char_boundary(ext_start) {\n629\t        &filename[ext_start..]\n630\t    } else {\n631\t        \"\"\n632\t    };\n633\t    if ext != CFG_FILE_EXT {\n634\t        return Err(CfgError {\n635\t            off: -1,\n636\t            col: -1,\n637\t            row: -1,\n638\t            msg: \"invalid file extension\".to_string(),\n639\t        });\n640\t    }\n641\t\n642\t    let src = match std::fs::read_to_string(filename) {\n643\t        Ok(s) => s,\n644\t        Err(_) => {\n645\t            return Err(CfgError {\n646\t                off: -1,\n647\t                col: -1,\n648\t                row: -1,\n649\t                msg: \"failed to open file\".to_string(),\n650\t            });\n651\t        }\n652\t    };\n653\t\n654\t    cfg_parse(&src)\n655\t}\n656\t\n657\tpub fn cfg_get_string<'a>(cfg: &Cfg, key: &str, fallback: &'a str) -> &'a str {\n658\t    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n659\t    for i in (0..n).rev() {\n660\t        let entry = &cfg.entries[i];\n661\t        if entry.key == key {\n662\t            if let CfgVal::String(s) = &entry.val {\n663\t                // SAFETY: We extend the lifetime of the string slice from cfg\n664\t                // to match the fallback's lifetime 'a. The caller is responsible\n665\t                // for ensuring cfg outlives the returned reference.\n666\t                return unsafe {\n667\t                    std::mem::transmute::<&str, &'a str>(s.as_str())\n668\t                };\n669\t            }\n670\t        }\n671\t    }\n672\t    fallback\n673\t}\n674\t\n675\tpub fn cfg_get_bool(cfg: &Cfg, key: &str, fallback: bool) -> bool {\n676\t    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n677\t    for i in (0..n).rev() {\n678\t        let entry = &cfg.entries[i];\n679\t        if entry.key == key {\n680\t            if let CfgVal::Boolean(b) = entry.val {\n681\t                return b;\n682\t            }\n683\t        }\n684\t    }\n685\t    fallback\n686\t}\n687\t\n688\tpub fn cfg_get_int(cfg: &Cfg, key: &str, fallback: i32) -> i32 {\n689\t    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n690\t    for i in (0..n).rev() {\n691\t        let entry = &cfg.entries[i];\n692\t        if entry.key == key {\n693\t            if let CfgVal::Int(v) = entry.val {\n694\t                return v;\n695\t            }\n696\t        }\n697\t    }\n698\t    fallback\n699\t}\n700\t\n701\tpub fn cfg_get_float(cfg: &Cfg, key: &str, fallback: f32) -> f32 {\n702\t    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n703\t    for i in (0..n).rev() {\n704\t        let entry = &cfg.entries[i];\n705\t        if entry.key == key {\n706\t            if let CfgVal::Float(v) = entry.val {\n707\t                return v;\n708\t            }\n709\t        }\n710\t    }\n711\t    fallback\n712\t}\n713\t\n714\tpub fn cfg_get_color(cfg: &Cfg, key: &str, fallback: CfgColor) -> CfgColor {\n715\t    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n716\t    for i in (0..n).rev() {\n717\t        let entry = &cfg.entries[i];\n718\t        if entry.key == key {\n719\t            if let CfgVal::Color(c) = entry.val {\n720\t                return c;\n721\t            }\n722\t        }\n723\t    }\n724\t    fallback\n725\t}\n726\t\n727\tpub fn cfg_get_int_min(cfg: &Cfg, key: &str, fallback: i32, min: i32) -> i32 {\n728\t    let value = cfg_get_int(cfg, key, fallback);\n729\t    if value < min {\n730\t        fallback\n731\t    } else {\n732\t        value\n733\t    }\n734\t}\n735\t\n736\tpub fn cfg_get_int_max(cfg: &Cfg, key: &str, fallback: i32, max: i32) -> i32 {\n737\t    let value = cfg_get_int(cfg, key, fallback);\n738\t    if value > max {\n739\t        fallback\n740\t    } else {\n741\t        value\n742\t    }\n743\t}\n744\t\n745\tpub fn cfg_get_int_range(cfg: &Cfg, key: &str, fallback: i32, min: i32, max: i32) -> i32 {\n746\t    let value = cfg_get_int(cfg, key, fallback);\n747\t    if value < min || value > max {\n748\t        fallback\n749\t    } else {\n750\t        value\n751\t    }\n752\t}\n753\t\n754\tpub fn cfg_get_float_min(cfg: &Cfg, key: &str, fallback: f32, min: f32) -> f32 {\n755\t    let value = cfg_get_float(cfg, key, fallback);\n756\t    if value < min {\n757\t        fallback\n758\t    } else {\n759\t        value\n760\t    }\n761\t}\n762\t\n763\tpub fn cfg_get_float_max(cfg: &Cfg, key: &str, fallback: f32, max: f32) -> f32 {\n764\t    let value = cfg_get_float(cfg, key, fallback);\n765\t    if value > max {\n766\t        fallback\n767\t    } else {\n768\t        value\n769\t    }\n770\t}\n771\t\n772\tpub fn cfg_get_float_range(cfg: &Cfg, key: &str, fallback: f32, min: f32, max: f32) -> f32 {\n773\t    let value = cfg_get_float(cfg, key, fallback);\n774\t    if value < min || value > max {\n775\t        fallback\n776\t    } else {\n777\t        value\n778\t    }\n779\t}\n780\t\n781\tpub fn cfg_fprint(file: &mut File, cfg: &Cfg) {\n782\t    let _ = write!(file, \"{}\", cfg);\n783\t}\n784\t\n785\tpub fn cfg_fprint_error(file: &mut File, err: &CfgError) {\n786\t    let _ = writeln!(file, \"{}\", err);\n787\t}\n788\t"}]},"parent_tool_use_id":null,"session_id":"98f80e93-d97a-4716-93b1-1881fbb7aa7b","uuid":"0bd2f18c-7ce6-4bc2-bd43-4942857035c2","timestamp":"2026-05-29T13:57:31.355Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-yxQy7x/project/src/simple_config.rs","content":"use std::{fmt::Display, fs::File, io::Write as IoWrite};\n// Constants\npub const CFG_FILE_EXT: &str = \".cfg\";\npub const CFG_MAX_KEY: usize = 32;\npub const CFG_MAX_VAL: usize = 64;\npub const CFG_MAX_ERR: usize = 64;\n// Structures and Enums\n#[derive(Clone, Copy, PartialEq, Debug)]\npub struct CfgColor {\n    pub r: u8,\n    pub g: u8,\n    pub b: u8,\n    pub a: u8,\n}\n#[derive(Clone, Debug, PartialEq)]\npub struct CfgError {\n    pub off: i32,\n    pub col: i32,\n    pub row: i32,\n    pub msg: String,\n}\nimpl Default for CfgError {\n    fn default() -> Self {\n        CfgError {\n            off: 0,\n            col: 0,\n            row: 0,\n            msg: String::new(),\n        }\n    }\n}\n#[derive(Clone, PartialEq, Debug)]\npub enum CfgVal {\n    String(String),\n    Boolean(bool),\n    Int(i32),\n    Float(f32),\n    Color(CfgColor),\n}\nimpl From<&str> for CfgVal {\n    fn from(s: &str) -> Self {\n        CfgVal::String(s.to_string())\n    }\n}\nimpl From<String> for CfgVal {\n    fn from(s: String) -> Self {\n        CfgVal::String(s)\n    }\n}\nimpl From<bool> for CfgVal {\n    fn from(b: bool) -> Self {\n        CfgVal::Boolean(b)\n    }\n}\nimpl From<i32> for CfgVal {\n    fn from(i: i32) -> Self {\n        CfgVal::Int(i)\n    }\n}\nimpl From<f32> for CfgVal {\n    fn from(f: f32) -> Self {\n        CfgVal::Float(f)\n    }\n}\nimpl From<CfgColor> for CfgVal {\n    fn from(c: CfgColor) -> Self {\n        CfgVal::Color(c)\n    }\n}\nimpl From<(u8, u8, u8, u8)> for CfgColor {\n    fn from((r, g, b, a): (u8, u8, u8, u8)) -> Self {\n        CfgColor { r, g, b, a }\n    }\n}\n#[derive(Clone, PartialEq, Debug)]\npub struct CfgEntry {\n    pub key: String,\n    pub val: CfgVal,\n}\n#[derive(Clone, PartialEq, Debug)]\npub struct Cfg {\n    pub entries: Vec<CfgEntry>,\n    pub count: i32,\n    pub capacity: usize,\n}\nimpl Display for CfgError {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        if self.row == -1 && self.col == -1 {\n            write!(f, \"Error: {}\", self.msg)\n        } else {\n            write!(f, \"Error at {}:{} :: {}\", self.row, self.col, self.msg)\n        }\n    }\n}\nimpl Display for CfgColor {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"rgba({}, {}, {}, {})\", self.r, self.g, self.b, self.a)\n    }\n}\nimpl Display for CfgVal {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        match self {\n            CfgVal::String(s) => write!(f, \"\\\"{}\\\"\", s),\n            CfgVal::Boolean(b) => {\n                write!(f, \"{}\", if *b { \"true\" } else { \"false\" })\n            }\n            CfgVal::Int(i) => write!(f, \"{}\", i),\n            CfgVal::Float(fl) => write!(f, \"{:.6}\", fl),\n            CfgVal::Color(c) => write!(f, \"{}\", c),\n        }\n    }\n}\nimpl Display for CfgEntry {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        write!(f, \"{}: {}\", self.key, self.val)\n    }\n}\nimpl Display for Cfg {\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\n        let n = (self.count.max(0) as usize).min(self.entries.len());\n        for i in 0..n {\n            writeln!(f, \"{}\", self.entries[i])?;\n        }\n        Ok(())\n    }\n}\npub struct Scanner {\n    pub src: String,\n    pub len: i32,\n    pub cur: i32,\n}\n\n// ===== Internal parser helpers =====\n\nstruct ParseScanner<'a> {\n    src: &'a [u8],\n    cur: usize,\n}\n\nimpl<'a> ParseScanner<'a> {\n    fn new(src: &'a str) -> Self {\n        Self {\n            src: src.as_bytes(),\n            cur: 0,\n        }\n    }\n\n    fn is_at_end(&self) -> bool {\n        self.cur >= self.src.len()\n    }\n\n    fn peek(&self) -> u8 {\n        if self.cur < self.src.len() {\n            self.src[self.cur]\n        } else {\n            0\n        }\n    }\n\n    fn peek_next(&self) -> u8 {\n        if self.cur + 1 >= self.src.len() {\n            0\n        } else {\n            self.src[self.cur + 1]\n        }\n    }\n\n    fn advance(&mut self) -> u8 {\n        let c = self.peek();\n        self.cur += 1;\n        c\n    }\n\n    fn set_cur(&mut self, n: usize) {\n        self.cur = n;\n    }\n}\n\nfn is_space_byte(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t' | b'\\n' | 0x0B | 0x0C | b'\\r')\n}\n\nfn is_blank_byte(c: u8) -> bool {\n    matches!(c, b' ' | b'\\t')\n}\n\nfn is_alpha_byte(c: u8) -> bool {\n    c.is_ascii_alphabetic()\n}\n\nfn is_digit_byte(c: u8) -> bool {\n    c.is_ascii_digit()\n}\n\nfn is_alnum_byte(c: u8) -> bool {\n    c.is_ascii_alphanumeric()\n}\n\nfn is_punct_byte(c: u8) -> bool {\n    c.is_ascii_punctuation()\n}\n\nfn is_key_byte(c: u8) -> bool {\n    is_alpha_byte(c) || c == b'.' || c == b'_'\n}\n\nfn is_string_byte(c: u8) -> bool {\n    is_alnum_byte(c) || is_blank_byte(c) || (is_punct_byte(c) && c != b'\"')\n}\n\nfn skip_whitespace(s: &mut ParseScanner) {\n    while !s.is_at_end() && is_space_byte(s.peek()) {\n        s.advance();\n    }\n}\n\nfn skip_blank(s: &mut ParseScanner) {\n    while !s.is_at_end() && is_space_byte(s.peek()) && s.peek() != b'\\n' {\n        s.advance();\n    }\n}\n\nfn skip_comment(s: &mut ParseScanner) {\n    while !s.is_at_end() && s.peek() == b'#' {\n        loop {\n            s.advance();\n            if s.is_at_end() || s.peek() == b'\\n' {\n                break;\n            }\n        }\n    }\n}\n\nfn skip_whitespace_and_comments(s: &mut ParseScanner) {\n    while !s.is_at_end() && (is_space_byte(s.peek()) || s.peek() == b'#') {\n        skip_whitespace(s);\n        skip_comment(s);\n    }\n}\n\nfn match_literal(s: &ParseScanner, offset: usize, literal: &str) -> bool {\n    let lit = literal.as_bytes();\n    if offset + lit.len() > s.src.len() {\n        return false;\n    }\n    &s.src[offset..offset + lit.len()] == lit\n}\n\nfn consume_literal(s: &mut ParseScanner, offset: usize, literal: &str) -> bool {\n    if match_literal(s, offset, literal) {\n        s.cur += literal.len();\n        true\n    } else {\n        false\n    }\n}\n\nfn make_error(s: &ParseScanner, msg: &str) -> CfgError {\n    let mut row = 1i32;\n    let mut col = 1i32;\n    let upto = s.cur.min(s.src.len());\n    for i in 0..upto {\n        col += 1;\n        if s.src[i] == b'\\n' {\n            row += 1;\n            col = 1;\n        }\n    }\n    // Truncate to CFG_MAX_ERR - 1 (matching snprintf semantics)\n    let mut truncated = msg.to_string();\n    if truncated.len() > CFG_MAX_ERR - 1 {\n        let mut end = CFG_MAX_ERR - 1;\n        while end > 0 && !truncated.is_char_boundary(end) {\n            end -= 1;\n        }\n        truncated.truncate(end);\n    }\n    CfgError {\n        off: s.cur as i32,\n        col,\n        row,\n        msg: truncated,\n    }\n}\n\nfn slice_to_string(s: &ParseScanner, offset: usize, len: usize) -> String {\n    std::str::from_utf8(&s.src[offset..offset + len])\n        .unwrap_or(\"\")\n        .to_string()\n}\n\nfn parse_string(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n    // Consume opening '\"'\n    s.advance();\n\n    let val_offset = s.cur;\n    while !s.is_at_end() && is_string_byte(s.peek()) {\n        s.advance();\n    }\n\n    if s.is_at_end() || s.peek() != b'\"' {\n        return Err(make_error(s, \"closing '\\\"' expected\"));\n    }\n\n    let val_len = s.cur - val_offset;\n    if val_len > CFG_MAX_VAL {\n        return Err(make_error(s, \"value too long\"));\n    }\n\n    // Consume closing '\"'\n    s.advance();\n\n    Ok(CfgVal::String(slice_to_string(s, val_offset, val_len)))\n}\n\nfn consume_int(s: &mut ParseScanner) -> Result<i32, CfgError> {\n    let mut sign: i32 = 1;\n    let mut num: i32 = 0;\n\n    if !s.is_at_end() && s.peek() == b'-' && is_digit_byte(s.peek_next()) {\n        s.advance();\n        sign = -1;\n    }\n\n    if !s.is_at_end() && !is_digit_byte(s.peek()) {\n        return Err(make_error(s, \"number expected\"));\n    }\n\n    while !s.is_at_end() && is_digit_byte(s.peek()) {\n        let digit = (s.advance() - b'0') as i32;\n        if num > (i32::MAX - digit) / 10 {\n            return Err(make_error(s, \"number too large\"));\n        }\n        num = num * 10 + digit;\n    }\n\n    Ok(sign * num)\n}\n\nfn consume_float(s: &mut ParseScanner) -> Result<f32, CfgError> {\n    let mut sign: i32 = 1;\n    let mut int_part: i32 = 0;\n    let mut fract_part: i32 = 0;\n\n    if !s.is_at_end() && s.peek() == b'-' && is_digit_byte(s.peek_next()) {\n        s.advance();\n        sign = -1;\n    }\n\n    if !s.is_at_end() && !is_digit_byte(s.peek()) {\n        return Err(make_error(s, \"number expected\"));\n    }\n\n    while !s.is_at_end() && is_digit_byte(s.peek()) {\n        let digit = (s.advance() - b'0') as i32;\n        if int_part > (i32::MAX - digit) / 10 {\n            return Err(make_error(s, \"number too large\"));\n        }\n        int_part = int_part * 10 + digit;\n    }\n\n    if !s.is_at_end() && s.peek() != b'.' {\n        return Err(make_error(s, \"float expected\"));\n    }\n\n    // Consume '.'\n    if !s.is_at_end() {\n        s.advance();\n    }\n\n    let mut div: i32 = 1;\n    while !s.is_at_end() && is_digit_byte(s.peek()) {\n        let digit = (s.advance() - b'0') as i32;\n        if fract_part > (i32::MAX - digit) / 10 {\n            return Err(make_error(s, \"number too large\"));\n        }\n        fract_part = fract_part * 10 + digit;\n        if div > i32::MAX / 10 {\n            return Err(make_error(s, \"number too large\"));\n        }\n        div *= 10;\n    }\n\n    let floating = int_part as f32 + (fract_part as f32 / div as f32);\n    Ok(sign as f32 * floating)\n}\n\nfn match_float(s: &mut ParseScanner) -> bool {\n    let restore = s.cur;\n    let mut is_float = false;\n\n    if !s.is_at_end() && s.peek() == b'-' && is_digit_byte(s.peek_next()) {\n        s.advance();\n    }\n\n    while !s.is_at_end() && is_digit_byte(s.peek()) {\n        s.advance();\n    }\n\n    if !s.is_at_end() && s.peek() == b'.' {\n        is_float = true;\n    }\n\n    s.set_cur(restore);\n    is_float\n}\n\nfn parse_number(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n    if match_float(s) {\n        let number = consume_float(s)?;\n        Ok(CfgVal::Float(number))\n    } else {\n        let number = consume_int(s)?;\n        Ok(CfgVal::Int(number))\n    }\n}\n\nfn parse_rgba(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n    if !consume_literal(s, s.cur, \"rgba\") {\n        return Err(make_error(s, \"invalid literal\"));\n    }\n\n    skip_blank(s);\n\n    if s.is_at_end() || s.peek() != b'(' {\n        return Err(make_error(s, \"'(' expected\"));\n    }\n\n    // Consume '('\n    s.advance();\n\n    let mut rgb = [0u8; 3];\n    for i in 0..3 {\n        skip_blank(s);\n\n        if match_float(s) {\n            return Err(make_error(\n                s,\n                \"red, blue and green must be integers in range [0, 255]\",\n            ));\n        }\n\n        let number = consume_int(s)?;\n\n        if !(0..=255).contains(&number) {\n            return Err(make_error(\n                s,\n                \"red, blue and green must be integers in range [0, 255]\",\n            ));\n        }\n\n        rgb[i] = number as u8;\n\n        skip_blank(s);\n\n        if s.is_at_end() || s.peek() != b',' {\n            return Err(make_error(s, \"',' expected\"));\n        }\n\n        s.advance();\n    }\n\n    skip_blank(s);\n\n    let alpha: u8;\n    if match_float(s) {\n        let number = consume_float(s)?;\n        if !(0.0..=1.0).contains(&number) {\n            return Err(make_error(s, \"alpha must be in range [0, 1]\"));\n        }\n        alpha = (number * 255.0) as u8;\n    } else {\n        let number = consume_int(s)?;\n        if !(0..=1).contains(&number) {\n            return Err(make_error(s, \"alpha must be in range [0, 1]\"));\n        }\n        alpha = (number * 255) as u8;\n    }\n\n    skip_blank(s);\n\n    if s.is_at_end() || s.peek() != b')' {\n        return Err(make_error(s, \"')' expected\"));\n    }\n\n    s.advance();\n\n    Ok(CfgVal::Color(CfgColor {\n        r: rgb[0],\n        g: rgb[1],\n        b: rgb[2],\n        a: alpha,\n    }))\n}\n\nfn parse_true(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n    if !consume_literal(s, s.cur, \"true\") {\n        return Err(make_error(s, \"invalid literal\"));\n    }\n    Ok(CfgVal::Boolean(true))\n}\n\nfn parse_false(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n    if !consume_literal(s, s.cur, \"false\") {\n        return Err(make_error(s, \"invalid literal\"));\n    }\n    Ok(CfgVal::Boolean(false))\n}\n\nfn parse_literal(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n    match s.peek() {\n        b't' => parse_true(s),\n        b'f' => parse_false(s),\n        b'r' => parse_rgba(s),\n        _ => Err(make_error(s, \"invalid literal\")),\n    }\n}\n\nfn parse_value(s: &mut ParseScanner) -> Result<CfgVal, CfgError> {\n    // Skip blank space between ':' and the value\n    skip_blank(s);\n\n    if s.is_at_end() || s.peek() == b'\\n' {\n        return Err(make_error(s, \"missing value\"));\n    }\n\n    let c = s.peek();\n\n    if c == b'\"' {\n        parse_string(s)\n    } else if is_alpha_byte(c) {\n        parse_literal(s)\n    } else if is_digit_byte(c) || (c == b'-' && is_digit_byte(s.peek_next())) {\n        parse_number(s)\n    } else {\n        Err(make_error(s, \"invalid value\"))\n    }\n}\n\nfn parse_key(s: &mut ParseScanner) -> Result<String, CfgError> {\n    if s.is_at_end() || !is_key_byte(s.peek()) {\n        return Err(make_error(s, \"missing key\"));\n    }\n\n    let key_offset = s.cur;\n    s.advance();\n    while !s.is_at_end() && is_key_byte(s.peek()) {\n        s.advance();\n    }\n    let key_len = s.cur - key_offset;\n\n    if key_len > CFG_MAX_KEY {\n        return Err(make_error(s, \"key too long\"));\n    }\n\n    Ok(slice_to_string(s, key_offset, key_len))\n}\n\nfn consume_colon(s: &mut ParseScanner) -> Result<(), CfgError> {\n    skip_blank(s);\n\n    if s.is_at_end() || s.peek() != b':' {\n        return Err(make_error(s, \"':' expected\"));\n    }\n\n    s.advance();\n    Ok(())\n}\n\nfn parse_entry(s: &mut ParseScanner) -> Result<CfgEntry, CfgError> {\n    let key = parse_key(s)?;\n    consume_colon(s)?;\n    let val = parse_value(s)?;\n\n    skip_blank(s);\n\n    if !s.is_at_end() && s.peek() == b'#' {\n        skip_comment(s);\n    }\n\n    if !s.is_at_end() && s.peek() != b'\\n' {\n        let ch = s.peek() as char;\n        return Err(make_error(s, &format!(\"unexpected character '{}'\", ch)));\n    }\n\n    if !s.is_at_end() {\n        s.advance();\n    }\n\n    Ok(CfgEntry { key, val })\n}\n\n// Public Functions\npub fn cfg_parse(src: &str) -> Result<Cfg, CfgError> {\n    let mut s = ParseScanner::new(src);\n    let mut entries: Vec<CfgEntry> = Vec::new();\n\n    skip_whitespace_and_comments(&mut s);\n\n    while !s.is_at_end() {\n        let entry = parse_entry(&mut s)?;\n        entries.push(entry);\n        skip_whitespace_and_comments(&mut s);\n    }\n\n    let count = entries.len() as i32;\n    let capacity = entries.len();\n    Ok(Cfg {\n        entries,\n        count,\n        capacity,\n    })\n}\n\npub fn cfg_parse_file(filename: &str) -> Result<Cfg, CfgError> {\n    let len = filename.len();\n    if len < 5 {\n        return Err(CfgError {\n            off: -1,\n            col: -1,\n            row: -1,\n            msg: \"invalid filename\".to_string(),\n        });\n    }\n\n    let ext_start = len - CFG_FILE_EXT.len();\n    // Ensure char boundary (filename is &str so safe at byte boundary for ASCII)\n    let ext = if filename.is_char_boundary(ext_start) {\n        &filename[ext_start..]\n    } else {\n        \"\"\n    };\n    if ext != CFG_FILE_EXT {\n        return Err(CfgError {\n            off: -1,\n            col: -1,\n            row: -1,\n            msg: \"invalid file extension\".to_string(),\n        });\n    }\n\n    let src = match std::fs::read_to_string(filename) {\n        Ok(s) => s,\n        Err(_) => {\n            return Err(CfgError {\n                off: -1,\n                col: -1,\n                row: -1,\n                msg: \"failed to open file\".to_string(),\n            });\n        }\n    };\n\n    cfg_parse(&src)\n}\n\npub fn cfg_get_string<'a>(cfg: &Cfg, key: &str, fallback: &'a str) -> &'a str {\n    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n    for i in (0..n).rev() {\n        let entry = &cfg.entries[i];\n        if entry.key == key {\n            if let CfgVal::String(s) = &entry.val {\n                // SAFETY: We extend the lifetime of the string slice from cfg\n                // to match the fallback's lifetime 'a. The caller is responsible\n                // for ensuring cfg outlives the returned reference.\n                return unsafe {\n                    std::mem::transmute::<&str, &'a str>(s.as_str())\n                };\n            }\n        }\n    }\n    fallback\n}\n\npub fn cfg_get_bool(cfg: &Cfg, key: &str, fallback: bool) -> bool {\n    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n    for i in (0..n).rev() {\n        let entry = &cfg.entries[i];\n        if entry.key == key {\n            if let CfgVal::Boolean(b) = entry.val {\n                return b;\n            }\n        }\n    }\n    fallback\n}\n\npub fn cfg_get_int(cfg: &Cfg, key: &str, fallback: i32) -> i32 {\n    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n    for i in (0..n).rev() {\n        let entry = &cfg.entries[i];\n        if entry.key == key {\n            if let CfgVal::Int(v) = entry.val {\n                return v;\n            }\n        }\n    }\n    fallback\n}\n\npub fn cfg_get_float(cfg: &Cfg, key: &str, fallback: f32) -> f32 {\n    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n    for i in (0..n).rev() {\n        let entry = &cfg.entries[i];\n        if entry.key == key {\n            if let CfgVal::Float(v) = entry.val {\n                return v;\n            }\n        }\n    }\n    fallback\n}\n\npub fn cfg_get_color(cfg: &Cfg, key: &str, fallback: CfgColor) -> CfgColor {\n    let n = (cfg.count.max(0) as usize).min(cfg.entries.len());\n    for i in (0..n).rev() {\n        let entry = &cfg.entries[i];\n        if entry.key == key {\n            if let CfgVal::Color(c) = entry.val {\n                return c;\n            }\n        }\n    }\n    fallback\n}\n\npub fn cfg_get_int_min(cfg: &Cfg, key: &str, fallback: i32, min: i32) -> i32 {\n    let value = cfg_get_int(cfg, key, fallback);\n    if value < min {\n        fallback\n    } else {\n        value\n    }\n}\n\npub fn cfg_get_int_max(cfg: &Cfg, key: &str, fallback: i32, max: i32) -> i32 {\n    let value = cfg_get_int(cfg, key, fallback);\n    if value > max {\n        fallback\n    } else {\n        value\n    }\n}\n\npub fn cfg_get_int_range(cfg: &Cfg, key: &str, fallback: i32, min: i32, max: i32) -> i32 {\n    let value = cfg_get_int(cfg, key, fallback);\n    if value < min || value > max {\n        fallback\n    } else {\n        value\n    }\n}\n\npub fn cfg_get_float_min(cfg: &Cfg, key: &str, fallback: f32, min: f32) -> f32 {\n    let value = cfg_get_float(cfg, key, fallback);\n    if value < min {\n        fallback\n    } else {\n        value\n    }\n}\n\npub fn cfg_get_float_max(cfg: &Cfg, key: &str, fallback: f32, max: f32) -> f32 {\n    let value = cfg_get_float(cfg, key, fallback);\n    if value > max {\n        fallback\n    } else {\n        value\n    }\n}\n\npub fn cfg_get_float_range(cfg: &Cfg, key: &str, fallback: f32, min: f32, max: f32) -> f32 {\n    let value = cfg_get_float(cfg, key, fallback);\n    if value < min || value > max {\n        fallback\n    } else {\n        value\n    }\n}\n\npub fn cfg_fprint(file: &mut File, cfg: &Cfg) {\n    let _ = write!(file, \"{}\", cfg);\n}\n\npub fn cfg_fprint_error(file: &mut File, err: &CfgError) {\n    let _ = writeln!(file, \"{}\", err);\n}\n","numLines":788,"startLine":1,"totalLines":788}}}
