.src = \"key: rgba(255 x\",\n431\t        .capacity = TEST_CAPACITY,\n432\t        .expected_error = \"',' expected\",\n433\t    },\n434\t    {\n435\t        .type = TC_ERR,\n436\t        .line = __LINE__,\n437\t        .src = \"key: rgba(255, 255, 255, 1 x\",\n438\t        .capacity = TEST_CAPACITY,\n439\t        .expected_error = \"')' expected\",\n440\t    },\n441\t    {\n442\t        .type = TC_ERR,\n443\t        .line = __LINE__,\n444\t        .src = \"key: 2147483648\",\n445\t        .capacity = TEST_CAPACITY,\n446\t        .expected_error = \"number too large\",\n447\t    },\n448\t    {\n449\t        .type = TC_ERR,\n450\t        .line = __LINE__,\n451\t        .src = \"key: 0.0000000000\",\n452\t        .capacity = TEST_CAPACITY,\n453\t        .expected_error = \"number too large\",\n454\t    },\n455\t    {\n456\t        .type = TC_ERR,\n457\t        .line = __LINE__,\n458\t        .src = \"key: 1.33333333333333333\",\n459\t        .capacity = TEST_CAPACITY,\n460\t        .expected_error = \"number too large\",\n461\t    },\n462\t    {\n463\t        .type = TC_ERR,\n464\t        .line = __LINE__,\n465\t        .src = \"key: rgba(255, 255, 255, -0.5)\",\n466\t        .capacity = TEST_CAPACITY,\n467\t        .expected_error = \"alpha must be in range [0, 1]\",\n468\t    },\n469\t    {\n470\t        .type = TC_ERR,\n471\t        .line = __LINE__,\n472\t        .src = \"key: rgba(255, 255, 255, -)\",\n473\t        .capacity = TEST_CAPACITY,\n474\t        .expected_error = \"number expected\",\n475\t    },\n476\t    {\n477\t        .type = TC_ERR,\n478\t        .line = __LINE__,\n479\t        .src = \"key: rgba(255, 255, 255, 1.5)\",\n480\t        .capacity = TEST_CAPACITY,\n481\t        .expected_error = \"alpha must be in range [0, 1]\",\n482\t    },\n483\t};\n484\t\n485\tstatic TestResult\n486\tassert_eq_entry(const CfgEntry *expected, const CfgEntry *actual)\n487\t{\n488\t    ASSERT(expected->type == actual->type);\n489\t    ASSERT(0 == strcmp(expected->key, actual->key));\n490\t\n491\t    switch (expected->type) {\n492\t    case CFG_TYPE_STRING:\n493\t        ASSERT(0 == strcmp(expected->val.string, actual->val.string));\n494\t        break;\n495\t\n496\t    case CFG_TYPE_INT:\n497\t        ASSERT(expected->val.integer == actual->val.integer);\n498\t        break;\n499\t\n500\t    case CFG_TYPE_FLOAT:\n501\t        ASSERT(expected->val.floating == actual->val.floating);\n502\t        break;\n503\t\n504\t    case CFG_TYPE_BOOL:\n505\t        ASSERT(expected->val.boolean == actual->val.boolean);\n506\t        break;\n507\t\n508\t    case CFG_TYPE_COLOR:\n509\t        ASSERT(0 == memcmp(&expected->val.color, &actual->val.color,\n510\t                           sizeof(CfgColor)));\n511\t        break;\n512\t    }\n513\t\n514\t    return OK;\n515\t}\n516\t\n517\tstatic TestResult\n518\tassert_eq_entries(const TestCase tc, const CfgEntry *actual_entries)\n519\t{\n520\t    for (int i = 0; i < tc.expected_count; i++) {\n521\t        TestResult result =\n522\t            assert_eq_entry(&tc.expected_entries[i], &actual_entries[i]);\n523\t        if (result.type != TEST_PASSED)\n524\t            return result;\n525\t    }\n526\t    return OK;\n527\t}\n528\t\n529\tstatic TestResult\n530\trun_test_case(TestCase tc)\n531\t{\n532\t    assert(tc.capacity <= TEST_CAPACITY);\n533\t\n534\t    CfgError err;\n535\t    CfgEntry entries[TEST_CAPACITY];\n536\t    Cfg cfg = {.entries = entries, .capacity = tc.capacity};\n537\t\n538\t    int res = cfg_parse(tc.src, strlen(tc.src), &cfg, &err);\n539\t\n540\t    // printf(\"%s:%d\\n\", __FILE__, tc.line);\n541\t    // cfg_fprint(stdout, &cfg);\n542\t    // cfg_fprint_error(stdout, &err);\n543\t\n544\t    switch (tc.type) {\n545\t    case TC_SUCC:\n546\t        ASSERT(res == 0);\n547\t        ASSERT(tc.expected_count == cfg.count);\n548\t        return assert_eq_entries(tc, cfg.entries);\n549\t\n550\t    case TC_ERR:\n551\t        ASSERT(res != 0);\n552\t        ASSERT(0 == strcmp(tc.expected_error, err.msg));\n553\t        break;\n554\t    }\n555\t\n556\t    return OK;\n557\t}\n558\t\n559\tvoid\n560\trun_parse_tests(Scoreboard *sb, FILE *stream)\n561\t{\n562\t    TestResult result;\n563\t    int total = COUNT_OF(test_cases);\n564\t\n565\t    for (int i = 0; i < total; i++) {\n566\t        result = run_test_case(test_cases[i]);\n567\t        update_scoreboard(sb, result);\n568\t        log_result(result, stream);\n569\t    }\n570\t}\n571\t"}]},"parent_tool_use_id":null,"session_id":"c8e7c930-d6b4-4e15-a4f0-6c086c6afd3f","uuid":"514ac582-3cb0-460f-9cbd-3b60067509e2","timestamp":"2026-05-29T08:32:26.377Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-FekWvq/project/c_src/test/test_parse.c","content":"#include <assert.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"../config.h\"\n#include \"test_parse.h\"\n\ntypedef struct {\n    enum { TC_SUCC, TC_ERR } type;\n    int line;\n    const char *src;\n    int capacity;\n    // TC_SUCC\n    CfgEntry *expected_entries;\n    int expected_count;\n    // TC_ERR\n    const char *expected_error;\n} TestCase;\n\nstatic const TestCase test_cases[] = {\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries = (CfgEntry[]){},\n        .expected_count = 0,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \" \",\n        .capacity = TEST_CAPACITY,\n        .expected_entries = (CfgEntry[]){},\n        .expected_count = 0,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"#\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries = (CfgEntry[]){},\n        .expected_count = 0,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"#\\n\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries = (CfgEntry[]){},\n        .expected_count = 0,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"x\",\n        .capacity = 0,\n        .expected_entries = (CfgEntry[]){},\n        .expected_count = 0,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"key: \\\"hello, world!\\\"\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries =\n            (CfgEntry[]){\n                {.key = \"key\",\n                 .type = CFG_TYPE_STRING,\n                 .val.string = \"hello, world!\"},\n            },\n        .expected_count = 1,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"key: 10 # Inline comment\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries =\n            (CfgEntry[]){\n                {.key = \"key\", .type = CFG_TYPE_INT, .val.integer = 10},\n            },\n        .expected_count = 1,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"key: -1\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries =\n            (CfgEntry[]){\n                {.key = \"key\", .type = CFG_TYPE_INT, .val.integer = -1},\n            },\n        .expected_count = 1,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"key: true\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries =\n            (CfgEntry[]){\n                {.key = \"key\", .type = CFG_TYPE_BOOL, .val.boolean = true},\n            },\n        .expected_count = 1,\n    },\n    {\n        .type = TC_SUCC,\n        .line = __LINE__,\n        .src = \"key: false\",\n        .capacity = TEST_CAPACITY,\n        .expected_entries =\n            (CfgEntry[]){\n                {.key = \"key\", .type = CFG_TYPE_BOOL, .val.boolean = false},\n            },\n        .expected_count = 1,\n    },\n    // {\n    //     .type = TC_SUCC,\n    //     .line = __LINE__,\n    //     .src = \"key: rgba(255, 255, 255, 0.5)\",\n    //     .capacity = TEST_CAPACITY,\n    //     .expected_entries =\n