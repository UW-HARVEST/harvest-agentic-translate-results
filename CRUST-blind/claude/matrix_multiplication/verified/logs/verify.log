); free_my(&m2, x2); free_my(&r, x1);\n}\n\nvoid test_alg3(int x1, int y1, int x2, int y2) {\n    ARRAY_TYPE **m1, **m2, **r;\n    alloc_matrix(&m1, x1, y1);\n    alloc_matrix(&m2, x2, y2);\n    alloc_matrix(&r, x1, y2);\n    for (int i = 0; i < x1; ++i)\n        for (int j = 0; j < y1; ++j)\n            m1[i][j] = (ARRAY_TYPE)(i + j + 1);\n    for (int i = 0; i < x2; ++i)\n        for (int j = 0; j < y2; ++j)\n            m2[i][j] = (ARRAY_TYPE)((i + 1) * (j + 1));\n    algorithm3(m1, m2, r, x1, y1, x2, y2);\n    printf(\"alg3(%d,%d,%d,%d):\\n\", x1, y1, x2, y2);\n    for (int i = 0; i < x1; ++i) {\n        for (int j = 0; j < y2; ++j) {\n            printf(\"%.6f \", r[i][j]);\n        }\n        printf(\"\\n\");\n    }\n    free_my(&m1, x1); free_my(&m2, x2); free_my(&r, x1);\n}\n\nvoid test_alg2(int size) {\n    ARRAY_TYPE **m1, **m2, **r;\n    alloc_matrix(&m1, size, size);\n    alloc_matrix(&m2, size, size);\n    alloc_matrix(&r, size, size);\n    for (int i = 0; i < size; ++i)\n        for (int j = 0; j < size; ++j) {\n            m1[i][j] = (ARRAY_TYPE)(i + j + 1);\n            m2[i][j] = (ARRAY_TYPE)((i + 1) * (j + 1));\n        }\n    algorithm2(m1, m2, r, size);\n    printf(\"alg2(%d):\\n\", size);\n    for (int i = 0; i < size; ++i) {\n        for (int j = 0; j < size; ++j) {\n            printf(\"%.6f \", r[i][j]);\n        }\n        printf(\"\\n\");\n    }\n    free_my(&m1, size); free_my(&m2, size); free_my(&r, size);\n}\n\nvoid test_multiply_alg1(int x1, int y1, int x2, int y2) {\n    ARRAY_TYPE **m1, **m2, **r;\n    alloc_matrix(&m1, x1, y1);\n    alloc_matrix(&m2, x2, y2);\n    alloc_matrix(&r, x1, y2);\n    for (int i = 0; i < x1; ++i)\n        for (int j = 0; j < y1; ++j)\n            m1[i][j] = (ARRAY_TYPE)(i + j + 1);\n    for (int i = 0; i < x2; ++i)\n        for (int j = 0; j < y2; ++j)\n            m2[i][j] = (ARRAY_TYPE)((i + 1) * (j + 1));\n    int rc = multiply(m1, m2, r, x1, y1, x2, y2, 1);\n    printf(\"multiply method=1 (%d,%d)x(%d,%d