{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QNCoFx8npJffJz5meMVbdU","type":"tool_result","content":"1\t/* zlib License\n2\t *\n3\t * Copyright (c) 2017-2025 Ed van Bruggen\n4\t *\n5\t * This software is provided 'as-is', without any express or implied\n6\t * warranty.  In no event will the authors be held liable for any damages\n7\t * arising from the use of this software.\n8\t *\n9\t * Permission is granted to anyone to use this software for any purpose,\n10\t * including commercial applications, and to alter it and redistribute it\n11\t * freely, subject to the following restrictions:\n12\t *\n13\t * 1. The origin of this software must not be misrepresented; you must not\n14\t *    claim that you wrote the original software. If you use this software\n15\t *    in a product, an acknowledgment in the product documentation would be\n16\t *    appreciated but is not required.\n17\t * 2. Altered source versions must be plainly marked as such, and must not be\n18\t *    misrepresented as being the original software.\n19\t * 3. This notice may not be removed or altered from any source distribution.\n20\t */\n21\t#include <dlfcn.h>\n22\t#include <fcntl.h>\n23\t#include <limits.h>\n24\t#include <unistd.h>\n25\t\n26\t/* count number of parenthesis, brackets, and curly braces */\n27\t/* FIXME makes reading O(2N) replace w/ better counting sys */\n28\tstatic int\n29\tcount_parens(char *s, int len)\n30\t{\n31\t\tint pcount = 0, bcount = 0, ccount = 0;\n32\t\tfor (int i = 0; i < len && s[i]; i++) {\n33\t\t\tswitch (s[i]) {\n34\t\t\t\tcase '(': pcount++; break;\n35\t\t\t\tcase '[': bcount++; break;\n36\t\t\t\tcase '{': ccount++; break;\n37\t\t\t\tcase ')': pcount--; break;\n38\t\t\t\tcase ']': bcount--; break;\n39\t\t\t\tcase '}': ccount--; break;\n40\t\t\t}\n41\t\t}\n42\t\tif (pcount)\n43\t\t\treturn pcount;\n44\t\tif (bcount)\n45\t\t\treturn bcount;\n46\t\treturn ccount;\n47\t}\n48\t\n49\t/* return string containing contents of file name */\n50\tstatic char *\n51\tread_file(char *fname)\n52\t{\n53\t\tchar buf[BUFSIZ], *file = NULL;\n54\t\tint len = 0, n, fd, parens = 0;\n55\t\tif (!fname) /* read from stdin if no file given */\n56\t\t\tfd = 0;\n57\t\telse if ((fd = open(fname, O_RDONLY)) < 0)\n58\t\t\ttsp_warnf(\"could not find file '%s'\", fname);\n59\t\twhile ((n = read(fd, buf, sizeof(buf))) > 0) {\n60\t\t\tfile = realloc(file, len + n + 1);\n61\t\t\tif (!file) perror(\"; realloc\"), exit(1);\n62\t\t\tmemcpy(file + len, buf, n);\n63\t\t\tlen += n;\n64\t\t\tfile[len] = '\\0';\n65\t\t\tif (fd == 0 && (parens += count_parens(buf, n)) <= 0)\n66\t\t\t\tbreak;\n67\t\t}\n68\t\tif (fd) /* close file if not stdin */\n69\t\t\tclose(fd);\n70\t\tif (n < 0)\n71\t\t\ttsp_warnf(\"could not read file '%s'\", fname);\n72\t\treturn file;\n73\t}\n74\t\n75\t/* write all arguemnts to given file, or stdout/stderr, without newline */\n76\t/* first argument is file name, second is option to append file */\n77\tstatic Val\n78\tprim_write(Tsp st, Rec env, Val args)\n79\t{\n80\t\tFILE *f;\n81\t\tconst char *mode = \"w\";\n82\t\ttsp_arg_min(args, \"write\", 2);\n83\t\n84\t\t/* if second argument is true, append file don't write over */\n85\t\tif (!nilp(cadr(args)))\n86\t\t\tmode = \"a\";\n87\t\t/* first argument can either be the symbol stdout or stderr, or the file as a string */\n88\t\tif (car(args)->t == TSP_SYM)\n89\t\t\tf = !strncmp(car(args)->v.s, \"stdout\", 7) ? stdout : stderr;\n90\t\telse if (car(args)->t != TSP_STR)\n91\t\t\ttsp_warnf(\"write: expected file name as string, received %s\",\n92\t\t\t           tsp_type_str(car(args)->t));\n93\t\telse if (!(f = fopen(car(args)->v.s, mode)))\n94\t\t\ttsp_warnf(\"write: could not load file '%s'\", car(args)->v.s);\n95\t\tif (f == stderr && strncmp(car(args)->v.s, \"stderr\", 7)) /* validate stderr symbol */\n96\t\t\ttsp_warn(\"write: expected file name as string, or symbol stdout/stderr\");\n97\t\n98\t\tfor (args = cddr(args); !nilp(args); args = cdr(args))\n99\t\t\ttisp_print(f, car(args));\n100\t\n101\t\tif (f == stdout || f == stderr) /* clean up */\n102\t\t\tfflush(f);\n103\t\telse\n104\t\t\tfclose(f);\n105\t\treturn st->none;\n106\t}\n107\t\n108\t/* return string of given file or read from stdin */\n109\tstatic Val\n110\tprim_read(Tsp st, Rec env, Val args)\n111\t{\n112\t\tchar *file, *fname = NULL; /* read from stdin by default */\n113\t\ttsp_arg_max(args, \"read\", 1);\n114\t\tif (tsp_lstlen(args) == 1) { /* if file name given as string, read it */\n115\t\t\ttsp_arg_type(car(args), \"read\", TSP_STR);\n116\t\t\tfname = car(args)->v.s;\n117\t\t}\n118\t\tif (!(file = read_file(fname)))\n119\t\t\treturn st->nil;\n120\t\treturn mk_str(st, file);\n121\t}\n122\t\n123\t/* parse string as tisp expression, return 'quit if given no arguments */\n124\tstatic Val\n125\tprim_parse(Tsp st, Rec env, Val args)\n126\t{\n127\t\tVal ret, expr;\n128\t\tchar *file = st->file;\n129\t\tsize_t filec = st->filec;\n130\t\ttsp_arg_num(args, \"parse\", 1);\n131\t\texpr = car(args);\n132\t\tif (nilp(expr))\n133\t\t\treturn mk_sym(st, \"quit\");\n134\t\ttsp_arg_type(expr, \"parse\", TSP_STR);\n135\t\tst->file = expr->v.s;\n136\t\tst->filec = 0;\n137\t\tret = mk_pair(mk_sym(st, \"do\"), st->nil);\n138\t\tfor (Val pos = ret; tsp_fget(st) && (expr = tisp_read_line(st, 0)); pos = cdr(pos))\n139\t\t\tcdr(pos) = mk_pair(expr, st->nil);\n140\t\tst->file = file;\n141\t\tst->filec = filec;\n142\t\tif (cdr(ret)->t == TSP_PAIR && nilp(cddr(ret)))\n143\t\t\treturn cadr(ret); /* if only 1 expression parsed, return just it */\n144\t\treturn ret;\n145\t}\n146\t\n147\t/* loads tisp file or C dynamic library */\n148\tstatic Val\n149\tprim_load(Tsp st, Rec env, Val args)\n150\t{\n151\t\tVal tib;\n152\t\tvoid (*tibenv)(Tsp);\n153\t\tchar name[PATH_MAX];\n154\t\tconst char *paths[] = {\n155\t\t\t\"/usr/local/lib/tisp/pkgs/\", \"/usr/lib/tisp/pkgs/\", \"./\", NULL\n156\t\t};\n157\t\n158\t\ttsp_arg_num(args, \"load\", 1);\n159\t\ttib = car(args);\n160\t\ttsp_arg_type(tib, \"load\", TSP_STR);\n161\t\n162\t\tfor (int i = 0; paths[i]; i++) {\n163\t\t\tstrcpy(name, paths[i]);\n164\t\t\tstrcat(name, tib->v.s);\n165\t\t\tstrcat(name, \".tsp\");\n166\t\t\tif (access(name, R_OK) != -1) {\n167\t\t\t\tchar *file = read_file(name);\n168\t\t\t\tVal body = prim_parse(st, env, mk_pair(mk_sym(st, file), st->nil));\n169\t\t\t\ttisp_eval_body(st, env, body);\n170\t\t\t\treturn st->none;\n171\t\t\t}\n172\t\t}\n173\t\n174\t\t/* If not tisp file, try loading shared object library */\n175\t\tif (!(st->libh = realloc(st->libh, (st->libhc+1)*sizeof(void*))))\n176\t\t\tperror(\"; realloc\"), exit(1);\n177\t\n178\t\tmemset(name, 0, sizeof(name));\n179\t\tstrcpy(name, \"libtib\");\n180\t\tstrcat(name, tib->v.s);\n181\t\tstrcat(name, \".so\");\n182\t\tif (!(st->libh[st->libhc] = dlopen(name, RTLD_LAZY)))\n183\t\t\ttsp_warnf(\"load: could not load '%s':\\n; %s\", tib->v.s, dlerror());\n184\t\tdlerror();\n185\t\n186\t\tmemset(name, 0, sizeof(name));\n187\t\tstrcpy(name, \"tib_env_\");\n188\t\tstrcat(name, tib->v.s);\n189\t\ttibenv = dlsym(st->libh[st->libhc], name);\n190\t\tif (dlerror())\n191\t\t\ttsp_warnf(\"load: could not run '%s':\\n; %s\", tib->v.s, dlerror());\n192\t\t(*tibenv)(st);\n193\t\n194\t\tst->libhc++;\n195\t\treturn st->none;\n196\t}\n197\t\n198\tvoid\n199\ttib_env_io(Tsp st)\n200\t{\n201\t\ttsp_env_prim(write);\n202\t\ttsp_env_prim(read);\n203\t\ttsp_env_prim(parse);\n204\t\ttsp_env_prim(load);\n205\t}\n206\t"}]},"parent_tool_use_id":null,"session_id":"2bd966c9-4f09-4f25-aa17-302dc496b096","uuid":"dfa49705-3fc0-4231-9eaf-6f27917d5cf5","timestamp":"2026-05-29T19:36:49.463Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-oVdv05/project/c_src/tib/io.c","content":"/* zlib License\n *\n * Copyright (c) 2017-2025 Ed van Bruggen\n *\n * This software is provided 'as-is', without any express or implied\n * warranty.  In no event will the authors be held liable for any damages\n * arising from the use of this software.\n *\n * Permission is granted to anyone to use this software for any purpose,\n * including commercial applications, and to alter it and redistribute it\n * freely, subject to the following restrictions:\n *\n * 1. The origin of this software must not be misrepresented; you must not\n *    claim that you wrote the original software. If you use this software\n *    in a product, an acknowledgment in the product documentation would be\n *    appreciated but is not required.\n * 2. Altered source versions must be plainly marked as such, and must not be\n *    misrepresented as being the original software.\n * 3. This notice may not be removed or altered from any source distribution.\n */\n#include <dlfcn.h>\n#include <fcntl.h>\n#include <limits.h>\n#include <unistd.h>\n\n/* count number of parenthesis, brackets, and curly braces */\n/* FIXME makes reading O(2N) replace w/ better counting sys */\nstatic int\ncount_parens(char *s, int len)\n{\n\tint pcount = 0, bcount = 0, ccount = 0;\n\tfor (int i = 0; i < len && s[i]; i++) {\n\t\tswitch (s[i]) {\n\t\t\tcase '(': pcount++; break;\n\t\t\tcase '[': bcount++; break;\n\t\t\tcase '{': ccount++; break;\n\t\t\tcase ')': pcount--; break;\n\t\t\tcase ']': bcount--; break;\n\t\t\tcase '}': ccount--; break;\n\t\t}\n\t}\n\tif (pcount)\n\t\treturn pcount;\n\tif (bcount)\n\t\treturn bcount;\n\treturn ccount;\n}\n\n/* return string containing contents of file name */\nstatic char *\nread_file(char *fname)\n{\n\tchar buf[BUFSIZ], *file = NULL;\n\tint len = 0, n, fd, parens = 0;\n\tif (!fname) /* read from stdin if no file given */\n\t\tfd = 0;\n\telse if ((fd = open(fname, O_RDONLY)) < 0)\n\t\ttsp_warnf(\"could not find file '%s'\", fname);\n\twhile ((n = read(fd, buf, sizeof(buf))) > 0) {\n\t\tfile = realloc(file, len + n + 1);\n\t\tif (!file) perror(\"; realloc\"), exit(1);\n\t\tmemcpy(file + len, buf, n);\n\t\tlen += n;\n\t\tfile[len] = '\\0';\n\t\tif (fd == 0 && (parens += count_parens(buf, n)) <= 0)\n\t\t\tbreak;\n\t}\n\tif (fd) /* close file if not stdin */\n\t\tclose(fd);\n\tif (n < 0)\n\t\ttsp_warnf(\"could not read file '%s'\", fname);\n\treturn file;\n}\n\n/* write all arguemnts to given file, or stdout/stderr, without newline */\n/* first argument is file name, second is option to append file */\nstatic Val\nprim_write(Tsp st, Rec env, Val args)\n{\n\tFILE *f;\n\tconst char *mode = \"w\";\n\ttsp_arg_min(args, \"write\", 2);\n\n\t/* if second argument is true, append file don't write over */\n\tif (!nilp(cadr(args)))\n\t\tmode = \"a\";\n\t/* first argument can either be the symbol stdout or stderr, or the file as a string */\n\tif (car(args)->t == TSP_SYM)\n\t\tf = !strncmp(car(args)->v.s, \"stdout\", 7) ? stdout : stderr;\n\telse if (car(args)->t != TSP_STR)\n\t\ttsp_warnf(\"write: expected file name as string, received %s\",\n\t\t           tsp_type_str(car(args)->t));\n\telse if (!(f = fopen(car(args)->v.s, mode)))\n\t\ttsp_warnf(\"write: could not load file '%s'\", car(args)->v.s);\n\tif (f == stderr && strncmp(car(args)->v.s, \"stderr\", 7)) /* validate stderr symbol */\n\t\ttsp_warn(\"write: expected file name as string, or symbol stdout/stderr\");\n\n\tfor (args = cddr(args); !nilp(args); args = cdr(args))\n\t\ttisp_print(f, car(args));\n\n\tif (f == stdout || f == stderr) /* clean up */\n\t\tfflush(f);\n\telse\n\t\tfclose(f);\n\treturn st->none;\n}\n\n/* return string of given file or read from stdin */\nstatic Val\nprim_read(Tsp st, Rec env, Val args)\n{\n\tchar *file, *fname = NULL; /* read from stdin by default */\n\ttsp_arg_max(args, \"read\", 1);\n\tif (tsp_lstlen(args) == 1) { /* if file name given as string, read it */\n\t\ttsp_arg_type(car(args), \"read\", TSP_STR);\n\t\tfname = car(args)->v.s;\n\t}\n\tif (!(file = read_file(fname)))\n\t\treturn st->nil;\n\treturn mk_str(st, file);\n}\n\n/* parse string as tisp expression, return 'quit if given no arguments */\nstatic Val\nprim_parse(Tsp st, Rec env, Val args)\n{\n\tVal ret, expr;\n\tchar *file = st->file;\n\tsize_t filec = st->filec;\n\ttsp_arg_num(args, \"parse\", 1);\n\texpr = car(args);\n\tif (nilp(expr))\n\t\treturn mk_sym(st, \"quit\");\n\ttsp_arg_type(expr, \"parse\", TSP_STR);\n\tst->file = expr->v.s;\n\tst->filec = 0;\n\tret = mk_pair(mk_sym(st, \"do\"), st->nil);\n\tfor (Val pos = ret; tsp_fget(st) && (expr = tisp_read_line(st, 0)); pos = cdr(pos))\n\t\tcdr(pos) = mk_pair(expr, st->nil);\n\tst->file = file;\n\tst->filec = filec;\n\tif (cdr(ret)->t == TSP_PAIR && nilp(cddr(ret)))\n\t\treturn cadr(ret); /* if only 1 expression parsed, return just it */\n\treturn ret;\n}\n\n/* loads tisp file or C dynamic library */\nstatic Val\nprim_load(Tsp st, Rec env, Val args)\n{\n\tVal tib;\n\tvoid (*tibenv)(Tsp);\n\tchar name[PATH_MAX];\n\tconst char *paths[] = {\n\t\t\"/usr/local/lib/tisp/pkgs/\", \"/usr/lib/tisp/pkgs/\", \"./\", NULL\n\t};\n\n\ttsp_arg_num(args, \"load\", 1);\n\ttib = car(args);\n\ttsp_arg_type(tib, \"load\", TSP_STR);\n\n\tfor (int i = 0; paths[i]; i++) {\n\t\tstrcpy(name, paths[i]);\n\t\tstrcat(name, tib->v.s);\n\t\tstrcat(name, \".tsp\");\n\t\tif (access(name, R_OK) != -1) {\n\t\t\tchar *file = read_file(name);\n\t\t\tVal body = prim_parse(st, env, mk_pair(mk_sym(st, file), st->nil));\n\t\t\ttisp_eval_body(st, env, body);\n\t\t\treturn st->none;\n\t\t}\n\t}\n\n\t/* If not tisp file, try loading shared object library */\n\tif (!(st->libh = realloc(st->libh, (st->libhc+1)*sizeof(void*))))\n\t\tperror(\"; realloc\"), exit(1);\n\n\tmemset(name, 0, sizeof(name));\n\tstrcpy(name, \"libtib\");\n\tstrcat(name, tib->v.s);\n\tstrcat(name, \".so\");\n\tif (!(st->libh[st->libhc] = dlopen(name, RTLD_LAZY)))\n\t\ttsp_warnf(\"load: could not load '%s':\\n; %s\", tib->v.s, dlerror());\n\tdlerror();\n\n\tmemset(name, 0, sizeof(name));\n\tstrcpy(name, \"tib_env_\");\n\tstrcat(name, tib->v.s);\n\ttibenv = dlsym(st->libh[st->libhc], name);\n\tif (dlerror())\n\t\ttsp_warnf(\"load: could not run '%s':\\n; %s\", tib->v.s, dlerror());\n\t(*tibenv)(st);\n\n\tst->libhc++;\n\treturn st->none;\n}\n\nvoid\ntib_env_io(Tsp st)\n{\n\ttsp_env_prim(write);\n\ttsp_env_prim(read);\n\ttsp_env_prim(parse);\n\ttsp_env_prim(load);\n}\n","numLines":206,"startLine":1,"totalLines":206}}}
