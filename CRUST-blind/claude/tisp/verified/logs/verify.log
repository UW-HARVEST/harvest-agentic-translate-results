        }\n439\t        items.push(v);\n440\t        skip_ws(st, skipnl);\n441\t    }\n442\t    skip_ws(st, skipnl);\n443\t    let bytes = st.file.as_bytes();\n444\t    if skipnl != 0 {\n445\t        let cur = if st.filec < bytes.len() {\n446\t            bytes[st.filec] as char\n447\t        } else {\n448\t            '\\0'\n449\t        };\n450\t        if cur != endchar {\n451\t            return None;\n452\t        }\n453\t    }\n454\t    if st.filec < bytes.len() {\n455\t        st.filec += 1;\n456\t    }\n457\t    // Build linked list\n458\t    let nil_val = Val {\n459\t        t: TspType::TspNil,\n460\t        v: ValUnion::N { num: 0.0, den: 1.0 },\n461\t    };\n462\t    let mut acc = tail.unwrap_or(nil_val);\n463\t    for v in items.into_iter().rev() {\n464\t        acc = mk_pair(v, acc)?;\n465\t    }\n466\t    Some(acc)\n467\t}\n468\t\n469\tpub fn tisp_read_sexpr(st: &mut Tsp) -> Option<Val> {\n470\t    skip_ws(st, 1);\n471\t    let bytes = st.file.as_bytes();\n472\t    if st.filec >= bytes.len() {\n473\t        return Some(val_clone(&st.none));\n474\t    }\n475\t    let rest = &st.file[st.filec..];\n476\t    if rest.is_empty() {\n477\t        return Some(val_clone(&st.none));\n478\t    }\n479\t    if isnum(rest) {\n480\t        return Some(read_num(st));\n481\t    }\n482\t    let c = bytes[st.filec] as char;\n483\t    if c == '\"' {\n484\t        return read_str(st, |st, s| mk_str(st, s).unwrap_or_else(|| val_clone(&st.none)));\n485\t    }\n486\t    if c == '~' {\n487\t        return read_str(st, |st, s| mk_sym(st, s).unwrap_or_else(|| val_clone(&st.none)));\n488\t    }\n489\t    let prefix: &[(&str, &str)] = &[\n490\t        (\"'\", \"quote\"),\n491\t        (\"`\", \"quasiquote\"),\n492\t        (\",@\", \"unquote-splice\"),\n493\t        (\",\", \"unquote\"),\n494\t        (\"@\", \"Func\"),\n495\t        (\"f\\\"\", \"strformat\"),\n496\t    ];\n497\t    for (pre, sym) in prefix {\n498\t        if rest.starts_with(pre) {\n499\t            let strip = if pre.ends_with('\"') { 1 } else { 0 };\n500\t            st.filec += pre.len() - strip;\n501\t            let v = tisp_read(st)?;\n502\t            let symv = mk_sym(st, sym)?;\n503\t            return mk_list(st, 2, vec![symv, v]);\n504\t        }\n505\t    }\n506\t    if is_op(c) {\n507\t        return read_sym(st, is_op);\n508\t    }\n509\t    if is_sym(c) {\n510\t        return read_sym(st, is_sym);\n511\t    }\n512\t    if c == '(' {\n513\t        st.filec += 1;\n514\t        return read_pair(st, ')');\n515\t    }\n516\t    if c == '[' {\n517\t        st.filec += 1;\n518\t        let lst = read_pair(st, ']')?;\n519\t        let s = mk_sym(st, \"list\")?;\n520\t        return mk_pair(s, lst);\n521\t    }\n522\t    if c == '{' {\n523\t        st.filec += 1;\n524\t        let v = read_pair(st, '}')?;\n525\t        let s = mk_sym(st, \"Rec\")?;\n526\t        return mk_pair(s, v);\n527\t    }\n528\t    None\n529\t}\n530\t\n531\tpub fn is_sym(c: char) -> bool {\n532\t    c.is_ascii_alphanumeric() || TSP_SYM_CHARS.contains(c)\n533\t}\n534\t\n535\tpub fn mk_sym(st: &mut Tsp, s: &str) -> Option<Val> {\n536\t    if let Some(v) = rec_get(&st.syms, s) {\n537\t        return Some(v);\n538\t    }\n539\t    let v = Val {\n540\t        t: TspType::TspSym,\n541\t        v: ValUnion::S(s.to_string()),\n542\t    };\n543\t    rec_add(&mut st.syms, s, val_clone(&v));\n544\t    Some(v)\n545\t}\n546\t\n547\tpub fn frac_reduce(num: &mut i32, den: &mut i32) {\n548\t    if *den == 0 {\n549\t        return;\n550\t    }\n551\t    let mut a = num.unsigned_abs() as i32;\n552\t    let mut b = den.unsigned_abs() as i32;\n553\t    if b == 0 {\n554\t        return;\n555\t    }\n556\t    let mut c = a % b;\n557\t    while c > 0 {\n558\t        a = b;\n559\t        b = c;\n560\t        c = a % b;\n561\t    }\n562\t    if b != 0 {\n563\t        *num /= b;\n564\t        *den /= b;\n565\t    }\n566\t}\n567\t\n568\tpub fn tisp_read_line(st: &mut Tsp, level: i32) -> Option<Val> {\n569\t    let ret = read_pair(st, '\\n')?;\n570\t    let mut ret = if !matches!(ret.t, TspType::TspPair) {\n571\t        let nil_val = val_clone(&st.nil);\n572\t        mk_pair(ret, nil_val)?\n573\t    } else {\n574\t        ret\n575\t    };\n576\t    // Walk to last pair where cdr is pair, then conditionally read sub-expressions.\n577\t    // We collect tail extensions in a vec and rebuild for safety.\n578\t    let mut tail_exprs: Vec<Val> = Vec::new();\n579\t    loop {\n580\t        let bytes = st.file.as_bytes();\n581\t        if st.filec >= bytes.len() {\n582\t            break;\n583\t        }\n584\t        // Count tabs/spaces\n585\t        let mut newlevel = 0i32;\n586\t        let mut i = st.filec;\n587\t        while i < bytes.len() && (bytes[i] == b'\\t' || bytes[i] == b' ') {\n588\t            newlevel += 1;\n589\t            i += 1;\n590\t        }\n591\t        if newlevel <= level {\n592\t            break;\n593\t        }\n594\t        st.filec += newlevel as usize;\n595\t        let sub = tisp_read_line(st, newlevel)?;\n596\t        tail_exprs.push(sub);\n597\t    }\n598\t    // append tail_exprs to the end of ret list\n599\t    if !tail_exprs.is_empty() {\n600\t        ret = append_to_list(ret, tail_exprs, val_clone(&st.nil));\n601\t    }\n602\t    // if only 1 element, return car\n603\t    if let ValUnion::P { car, cdr } = &ret.v {\n604\t        if nilp(cdr) {\n605\t            return Some(val_clone(car));\n606\t        }\n607\t    }\n608\t    Some(ret)\n609\t}\n610\t\n611\tfn append_to_list(list: Val, exprs: Vec<Val>, nil: Val) -> Val {\n612\t    // walks list pairs, when cdr is nil, replace with (expr . next)\n613\t    fn rec(v: Val, exprs: &mut Vec<Val>, nil: &Val) -> Val {\n614\t        match v.v {\n615\t            ValUnion::P { car, cdr } => {\n616\t                let new_cdr = rec(*cdr, exprs, nil);\n617\t                Val {\n618\t                    t: TspType::TspPair,\n619\t                    v: ValUnion::P {\n620\t                        car,\n621\t                        cdr: Box::new(new_cdr),\n622\t                    },\n623\t                }\n624\t            }\n625\t            _ => {\n626\t                if nilp(&v) {\n627\t                    // build a list from exprs\n628\t                    let mut acc = val_clone(nil);\n629\t                    while let Some(e) = exprs.pop() {\n630\t                        acc = Val {\n631\t                            t: TspType::TspPair,\n632\t                            v: ValUnion::P {\n633\t                                car: Box::new(e),\n634\t                                cdr: Box::new(acc),\n635\t                            },\n636\t                        };\n637\t                    }\n638\t                    acc\n639\t                } else {\n640\t                    v\n641\t                }\n642\t            }\n643\t        }\n644\t    }\n645\t    let mut exprs = exprs;\n646\t    rec(list, &mut exprs, &nil)\n647\t}\n648\t\n649\tpub fn mk_prim(t: TspType, pr: Prim, name: &str) -> Option<Val> {\n650\t    Some(Val {\n651\t        t,\n652\t        v: ValUnion::Pr {\n653\t            name: name.to_string(),\n654\t            pr,\n655\t        },\n656\t    })\n657\t}\n658\t\n659\tpub fn isnum(s: &str) -> bool {\n660\t    let bytes = s.as_bytes();\n661\t    if bytes.is_empty() {\n662\t        return false;\n663\t    }\n664\t    let c0 = bytes[0];\n665\t    let c1 = if bytes.len() > 1 { bytes[1] } else { 0 };\n666\t    if c0.is_ascii_digit() {\n667\t        return true;\n668\t    }\n669\t    if c0 == b'.' && c1.is_ascii_digit() {\n670\t        return true;\n671\t    }\n672\t    if (c0 == b'-' || c0 == b'+') && (c1.is_ascii_digit() || c1 == b'.') {\n673\t        return true;\n674\t    }\n675\t    false\n676\t}\n677\t\n678\tpub fn tsp_type_str(t: TspType) -> &'static str {\n679\t    match t {\n680\t        TspType::TspNone => \"Void\",\n681\t        TspType::TspNil => \"Nil\",\n682\t        TspType::TspInt => \"Int\",\n683\t        TspType::TspDec => \"Dec\",\n684\t        TspType::TspRatio => \"Ratio\",\n685\t        TspType::TspStr => \"Str\",\n686\t        TspType::TspSym => \"Sym\",\n687\t        TspType::TspPrim => \"Prim\",\n688\t        TspType::TspForm => \"Form\",\n689\t        TspType::TspFunc => \"Func\",\n690\t        TspType::TspMacro => \"Macro\",\n691\t        TspType::TspPair => \"Pair\",\n692\t        TspType::TspRec => \"Rec\",\n693\t    }\n694\t}\n695\t\n696\tpub fn mk_str(st: &mut Tsp, s: &str) -> Option<Val> {\n697\t    if let Some(v) = rec_get(&st.strs, s) {\n698\t        return Some(v);\n699\t    }\n700\t    let v = Val {\n701\t        t: TspType::TspStr,\n702\t        v: ValUnion::S(s.to_string()),\n703\t    };\n704\t    rec_add(&mut st.strs, s, val_clone(&v));\n705\t    Some(v)\n706\t}\n707\t\n708\tpub fn is_op(c: char) -> bool {\n709\t    TSP_OP_CHARS.contains(c)\n710\t}\n711\t\n712\tpub fn esc_str(s: &str, len: i32, do_esc: i32) -> String {\n713\t    let bytes = s.as_bytes();\n714\t    let n = (len.max(0) as usize).min(bytes.len());\n715\t    let mut out = String::with_capacity(n);\n716\t    let mut i = 0;\n717\t    let mut count = 0;\n718\t    while count < n {\n719\t        let c = bytes[i];\n720\t        if c == b'\\\\' && do_esc != 0 {\n721\t            i += 1;\n722\t            if i < bytes.len() {\n723\t                out.push(esc_char(bytes[i] as char));\n724\t            }\n725\t        } else {\n726\t            out.push(c as char);\n727\t        }\n728\t        i += 1;\n729\t        count += 1;\n730\t    }\n731\t    out\n732\t}\n733\t\n734\tpub fn tib_env_core(st: &mut Tsp) {\n735\t    crate::core::tib_env_core(st)\n736\t}\n737\t\n738\tpub fn skip_ws(st: &mut Tsp, skipnl: i32) {\n739\t    let s: &[u8] = if skipnl != 0 {\n740\t        b\" \\t\\n\\r\"\n741\t    } else {\n742\t        b\" \\t\"\n743\t    };\n744\t    let bytes = st.file.as_bytes();\n745\t    loop {\n746\t        if st.filec >= bytes.len() {\n747\t            return;\n748\t        }\n749\t        let c = bytes[st.filec];\n750\t        if c == 0 {\n751\t            return;\n752\t        }\n753\t        if !s.contains(&c) && c != b';' {\n754\t            return;\n755\t        }\n756\t        // skip whitespace\n757\t        while st.filec < bytes.len() && s.contains(&bytes[st.filec]) {\n758\t            st.filec += 1;\n759\t        }\n760\t        // skip comments\n761\t        while st.filec < bytes.len() && bytes[st.filec] == b';' {\n762\t            // skip until newline\n763\t            while st.filec < bytes.len() && bytes[st.filec] != b'\\n' {\n764\t                st.filec += 1;\n765\t            }\n766\t            if skipnl == 0 {\n767\t                // stop at newline (don't consume it)\n768\t                break;\n769\t            }\n770\t            // skip the newline\n771\t            if st.filec < bytes.len() {\n772\t                st.filec += 1;\n773\t            }\n774\t        }\n775\t    }\n776\t}\n777\t\n778\tpub fn rec_extend(rec: &mut Rec, args: Val, vals: Val) -> Rec {\n779\t    let argnum = TSP_REC_FACTOR as i32 * tsp_lstlen(&args);\n780\t    let cap = if argnum > 0 { argnum } else { -argnum + 1 };\n781\t    let mut ret = rec_new(cap as usize, Some(Box::new(rec_clone(rec))));\n782\t    let mut a = args;\n783\t    let mut v = vals;\n784\t    loop {\n785\t        if nilp(&a) {\n786\t            break;\n787\t        }\n788\t        let (arg, val, more_a, more_v) = match (a.t, v.t) {\n789\t            (TspType::TspPair, TspType::TspPair) => {\n790\t                if let (ValUnion::P { car: ac, cdr: ad }, ValUnion::P { car: vc, cdr: vd }) =\n791\t                    (a.v, v.v)\n792\t                {\n793\t                    (*ac, *vc, *ad, *vd)\n794\t                } else {\n795\t                    return ret;\n796\t                }\n797\t            }\n798\t            _ => (a, v, val_make_nil(), val_make_nil()),\n799\t        };\n800\t        let key = match &arg.v {\n801\t            ValUnion::S(s) => s.clone(),\n802\t            _ => return ret,\n803\t        };\n804\t        rec_add(&mut ret, &key, val);\n805\t        if !matches!(more_a.t, TspType::TspPair) {\n806\t            break;\n807\t        }\n808\t        a = more_a;\n809\t        v = more_v;\n810\t    }\n811\t    ret\n812\t}\n813\t\n814\tfn val_make_nil() -> Val {\n815\t    Val {\n816\t        t: TspType::TspNil,\n817\t        v: ValUnion::N { num: 0.0, den: 1.0 },\n818\t    }\n819\t}\n820\t\n821\tpub fn hash(key: &str) -> u32 {\n822\t    let mut h: u32 = 0;\n823\t    for c in key.bytes() {\n824\t        h = h.wrapping_mul(33).wrapping_add(c as u32);\n825\t    }\n826\t    h\n827\t}\n828\t\n829\tpub fn mk_rec(st: &mut Tsp, env: Rec, assoc: Val) -> Option<Val> {\n830\t    // If assoc is \"missing\" (we use nil to mean missing), return rec wrapping env.\n831\t    if nilp(&assoc) {\n832\t        return Some(Val {\n833\t            t: TspType::TspRec,\n834\t            v: ValUnion::R(env),\n835\t        });\n836\t    }\n837\t    let cap = TSP_REC_FACTOR as i32 * tsp_lstlen(&assoc);\n838\t    let cap = if cap > 0 { cap } else { -cap + 1 };\n839\t    let r = rec_new(cap as usize, None);\n840\t    let ret = Val {\n841\t        t: TspType::TspRec,\n842\t        v: ValUnion::R(r),\n843\t    };\n844\t    let mut outer = rec_new(4, Some(Box::new(env)));\n845\t    rec_add(&mut outer, \"this\", val_clone(&ret));\n846\t\n847\t    let mut ret = ret;\n848\t    let mut cur = assoc;\n849\t    while matches!(cur.t, TspType::TspPair) {\n850\t        let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = cur.v {\n851\t            (*car, *cdr)\n852\t        } else {\n853\t            break;\n854\t        };\n855\t        match car_v.t {\n856\t            TspType::TspPair => {\n857\t                if let ValUnion::P { car: caar, cdr: cdar } = car_v.v {\n858\t                    if matches!(caar.t, TspType::TspSym | TspType::TspStr) {\n859\t                        let key = match &caar.v {\n860\t                            ValUnion::S(s) => s.clone(),\n861\t                            _ => String::new(),\n862\t                        };\n863\t                        // cdar should be a pair, take its car\n864\t                        if let ValUnion::P { car: c2, .. } = cdar.v {\n865\t                            let v = tisp_eval(st, *c2)?;\n866\t                            if let ValUnion::R(rr) = &mut ret.v {\n867\t                                rec_add(rr, &key, v);\n868\t                            }\n869\t                        }\n870\t                    } else {\n871\t                        return None;\n872\t                    }\n873\t                }\n874\t            }\n875\t            TspType::TspSym => {\n876\t                let key = if let ValUnion::S(ref s) = car_v.v {\n877\t                    s.clone()\n878\t                } else {\n879\t                    String::new()\n880\t                };\n881\t                let v = tisp_eval(st, car_v)?;\n882\t                if let ValUnion::R(rr) = &mut ret.v {\n883\t                    rec_add(rr, &key, v);\n884\t                }\n885\t            }\n886\t            _ => return None,\n887\t        }\n888\t        cur = cdr_v;\n889\t    }\n890\t    Some(ret)\n891\t}\n892\t\n893\tpub fn tisp_read(st: &mut Tsp) -> Option<Val> {\n894\t    let mut v = tisp_read_sexpr(st)?;\n895\t    loop {\n896\t        let bytes = st.file.as_bytes();\n897\t        if st.filec >= bytes.len() {\n898\t            break;\n899\t        }\n900\t        let c = bytes[st.filec] as char;\n901\t        if c == '(' || c == ':' || c == '>' || c == '{' {\n902\t            v = tisp_read_sugar(st, v)?;\n903\t        } else {\n904\t            break;\n905\t        }\n906\t    }\n907\t    Some(v)\n908\t}\n909\t\n910\tpub fn mk_int(i: i32) -> Val {\n911\t    Val {\n912\t        t: TspType::TspInt,\n913\t        v: ValUnion::N {\n914\t            num: i as f64,\n915\t            den: 1.0,\n916\t        },\n917\t    }\n918\t}\n919\t\n920\tpub fn tib_env_math(st: &mut Tsp) {\n921\t    crate::math::tib_env_math(st)\n922\t}\n923\t\n924\tpub fn tisp_eval_list(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> {\n925\t    let mut items: Vec<Val> = Vec::new();\n926\t    let mut cur = v;\n927\t    loop {\n928\t        if nilp(&cur) {\n929\t            // build nil-terminated list\n930\t            let mut acc = val_clone(&st.nil);\n931\t            for it in items.into_iter().rev() {\n932\t                acc = mk_pair(it, acc)?;\n933\t            }\n934\t            return Some(acc);\n935\t        }\n936\t        match cur.t {\n937\t            TspType::TspPair => {\n938\t                let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = cur.v {\n939\t                    (*car, *cdr)\n940\t                } else {\n941\t                    return None;\n942\t                };\n943\t                let _ = env; // env parameter unused due to single-env eval\n944\t                let ev = tisp_eval(st, car_v)?;\n945\t                items.push(ev);\n946\t                cur = cdr_v;\n947\t            }\n948\t            _ => {\n949\t                // improper list — eval the tail and append\n950\t                let ev = tisp_eval(st, cur)?;\n951\t                let mut acc = ev;\n952\t                for it in items.into_iter().rev() {\n953\t                    acc = mk_pair(it, acc)?;\n954\t                }\n955\t                return Some(acc);\n956\t            }\n957\t        }\n958\t    }\n959\t}\n960\t\n961\tpub fn read_sci(st: &mut Tsp, val: f64, isint: i32) -> Option<Val> {\n962\t    let bytes = st.file.as_bytes();\n963\t    let mut val = val;\n964\t    let mut isint = isint;\n965\t    if st.filec < bytes.len() {\n966\t        let c = (bytes[st.filec] as char).to_ascii_lowercase();\n967\t        if c == 'e' {\n968\t            st.filec += 1;\n969\t            let sign = if read_sign(st) == 1 { 10.0 } else { 0.1 };\n970\t            let mut expo = read_int(st);\n971\t            // If expo > 0 and sign is 0.1, it produces fraction. Match C semantics.\n972\t            while expo > 0 {\n973\t                val *= sign;\n974\t                expo -= 1;\n975\t            }\n976\t            isint = 0;\n977\t        }\n978\t    }\n979\t    if isint != 0 {\n980\t        Some(mk_int(val as i32))\n981\t    } else {\n982\t        mk_dec(val)\n983\t    }\n984\t}\n985\t\n986\tpub fn read_int(st: &mut Tsp) -> i32 {\n987\t    let bytes = st.file.as_bytes();\n988\t    let mut ret: i32 = 0;\n989\t    while st.filec < bytes.len() {\n990\t        let c = bytes[st.filec];\n991\t        if !c.is_ascii_digit() {\n992\t            break;\n993\t        }\n994\t        ret = ret.wrapping_mul(10).wrapping_add((c - b'0') as i32);\n995\t        st.filec += 1;\n996\t    }\n997\t    ret\n998\t}\n999\t\n1000\tpub fn rec_new(cap: usize, next: Option<Box<Rec>>) -> Rec {\n1001\t    let cap = cap.max(1);\n1002\t    let mut items = Vec::with_capacity(cap);\n1003\t    for _ in 0..cap {\n1004\t        items.push(Entry {\n1005\t            key: String::new(),\n1006\t            val: val_make_nil(),\n1007\t        });\n1008\t    }\n1009\t    Rec {\n1010\t        size: 0,\n1011\t        cap: cap as i32,\n1012\t        items,\n1013\t        next,\n1014\t    }\n1015\t}\n1016\t\n1017\tpub fn read_str(st: &mut Tsp, mk_fn: fn(&mut Tsp, &str) -> Val) -> Option<Val> {\n1018\t    // skip starting open quote\n1019\t    st.filec += 1;\n1020\t    let bytes = st.file.as_bytes();\n1021\t    let start = st.filec;\n1022\t    // determine end char by sentinel: we look at character at position start-1\n1023\t    let endchar = bytes[start - 1] as char;\n1024\t    let endchar_byte = endchar as u8;\n1025\t    let mut len = 0i32;\n1026\t    while st.filec < bytes.len() && bytes[st.filec] != endchar_byte {\n1027\t        if bytes[st.filec] == b'\\\\'\n1028\t            && st.filec > 0\n1029\t            && (st.filec == 0 || bytes[st.filec - 1] != b'\\\\')\n1030\t        {\n1031\t            st.filec += 1;\n1032\t        }\n1033\t        if st.filec >= bytes.len() {\n1034\t            return None;\n1035\t        }\n1036\t        st.filec += 1;\n1037\t        len += 1;\n1038\t    }\n1039\t    if st.filec >= bytes.len() {\n1040\t        return None;\n1041\t    }\n1042\t    st.filec += 1; // skip closing quote\n1043\t    let do_esc = if endchar == '\"' { 1 } else { 0 };\n1044\t    let raw = &st.file[start..start + len as usize].to_string();\n1045\t    let unescaped = esc_str(raw, len, do_esc);\n1046\t    Some(mk_fn(st, &unescaped))\n1047\t}\n1048\t\n1049\tpub fn read_sym(st: &mut Tsp, is_char: fn(char) -> bool) -> Option<Val> {\n1050\t    let bytes = st.file.as_bytes();\n1051\t    let start = st.filec;\n1052\t    let mut len = 0i32;\n1053\t    while st.filec < bytes.len() {\n1054\t        let c = bytes[st.filec] as char;\n1055\t        if c == '\\0' {\n1056\t            break;\n1057\t        }\n1058\t        if !is_char(c) {\n1059\t            break;\n1060\t        }\n1061\t        st.filec += 1;\n1062\t        len += 1;\n1063\t    }\n1064\t    let raw = st.file[start..start + len as usize].to_string();\n1065\t    let s = esc_str(&raw, len, 0);\n1066\t    mk_sym(st, &s)\n1067\t}\n1068\t\n1069\tpub fn mk_dec(d: f64) -> Option<Val> {\n1070\t    Some(Val {\n1071\t        t: TspType::TspDec,\n1072\t        v: ValUnion::N { num: d, den: 1.0 },\n1073\t    })\n1074\t}\n1075\t\n1076\tpub fn tisp_eval_body(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> {\n1077\t    let mut ret = val_clone(&st.none);\n1078\t    let mut cur = v;\n1079\t    loop {\n1080\t        match cur.t {\n1081\t            TspType::TspPair => {\n1082\t                let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = cur.v {\n1083\t                    (*car, *cdr)\n1084\t                } else {\n1085\t                    break;\n1086\t                };\n1087\t                ret = tisp_eval(st, car_v)?;\n1088\t                cur = cdr_v;\n1089\t            }\n1090\t            _ => break,\n1091\t        }\n1092\t        let _ = env; // env parameter is mostly unused due to global env\n1093\t    }\n1094\t    Some(ret)\n1095\t}\n1096\t\n1097\tpub fn tib_env_io(st: &mut Tsp) {\n1098\t    crate::io::tib_env_io(st)\n1099\t}\n1100\t\n1101\tpub fn tisp_read_sugar(st: &mut Tsp, v: Val) -> Option<Val> {\n1102\t    let bytes = st.file.as_bytes();\n1103\t    if st.filec >= bytes.len() {\n1104\t        return Some(v);\n1105\t    }\n1106\t    let c = bytes[st.filec] as char;\n1107\t    if c == '(' {\n1108\t        st.filec += 1;\n1109\t        let lst = read_pair(st, ')')?;\n1110\t        return mk_pair(v, lst);\n1111\t    }\n1112\t    if c == '{' {\n1113\t        st.filec += 1;\n1114\t        let lst = read_pair(st, '}')?;\n1115\t        let recmerge = mk_sym(st, \"recmerge\")?;\n1116\t        let recsym = mk_sym(st, \"Rec\")?;\n1117\t        let inner = mk_pair(recsym, lst)?;\n1118\t        return mk_list(st, 3, vec![recmerge, v, inner]);\n1119\t    }\n1120\t    if c == ':' {\n1121\t        st.filec += 1;\n1122\t        let next = if st.filec < bytes.len() {\n1123\t            bytes[st.filec] as char\n1124\t        } else {\n1125\t            '\\0'\n1126\t        };\n1127\t        match next {\n1128\t            '(' => {\n1129\t                st.filec += 1;\n1130\t                let w = read_pair(st, ')')?;\n1131\t                let mapsym = mk_sym(st, \"map\")?;\n1132\t                let inner = mk_pair(v, w)?;\n1133\t                return mk_pair(mapsym, inner);\n1134\t            }\n1135\t            ':' => {\n1136\t                st.filec += 1;\n1137\t                let w = read_sym(st, is_sym)?;\n1138\t                let qsym = mk_sym(st, \"quote\")?;\n1139\t                let qw = mk_list(st, 2, vec![qsym, w])?;\n1140\t                return mk_list(st, 2, vec![v, qw]);\n1141\t            }\n1142\t            _ => {\n1143\t                skip_ws(st, 1);\n1144\t                let w = tisp_read(st)?;\n1145\t                return mk_list(st, 2, vec![v, w]);\n1146\t            }\n1147\t        }\n1148\t    }\n1149\t    if c == '>' {\n1150\t        let next = if st.filec + 1 < bytes.len() {\n1151\t            bytes[st.filec + 1] as char\n1152\t        } else {\n1153\t            '\\0'\n1154\t        };\n1155\t        if next == '>' {\n1156\t            st.filec += 2;\n1157\t            let w = tisp_read(st)?;\n1158\t            if !matches!(w.t, TspType::TspPair) {\n1159\t                return None;\n1160\t            }\n1161\t            if let ValUnion::P { car, cdr } = w.v {\n1162\t                let inner = mk_pair(v, *cdr)?;\n1163\t                return mk_pair(*car, inner);\n1164\t            }\n1165\t        }\n1166\t    }\n1167\t    Some(v)\n1168\t}\n1169\t\n1170\tpub fn tisp_env_lib(st: &mut Tsp, lib: &str) {\n1171\t    let file = std::mem::take(&mut st.file);\n1172\t    let filec = st.filec;\n1173\t    st.file = lib.to_string();\n1174\t    st.filec = 0;\n1175\t    skip_ws(st, 1);\n1176\t    if let Some(v) = tisp_read(st) {\n1177\t        let mut env = rec_clone(&st.env);\n1178\t        let _ = tisp_eval_body(st, &mut env, v);\n1179\t    }\n1180\t    st.file = file;\n1181\t    st.filec = filec;\n1182\t}\n1183\t\n1184\tpub fn mk_list(st: &mut Tsp, n: i32, args: Vec<Val>) -> Option<Val> {\n1185\t    let mut acc = val_clone(&st.nil);\n1186\t    let take = if n < 0 { 0 } else { n as usize };\n1187\t    let mut items: Vec<Val> = args.into_iter().take(take).collect();\n1188\t    while let Some(v) = items.pop() {\n1189\t        acc = mk_pair(v, acc)?;\n1190\t    }\n1191\t    Some(acc)\n1192\t}\n1193\t\n1194\tpub fn vals_eq(a: &Val, b: &Val) -> bool {\n1195\t    let a_num = type_matches(a.t, TSP_NUM);\n1196\t    let b_num = type_matches(b.t, TSP_NUM);\n1197\t    if a_num && b_num {\n1198\t        let (an, ad) = val_num(a);\n1199\t        let (bn, bd) = val_num(b);\n1200\t        return an == bn && ad == bd;\n1201\t    }\n1202\t    if type_bits(a.t) != type_bits(b.t) {\n1203\t        return false;\n1204\t    }\n1205\t    match (&a.v, &b.v) {\n1206\t        (ValUnion::P { car: ac, cdr: ad }, ValUnion::P { car: bc, cdr: bd }) => {\n1207\t            vals_eq(ac, bc) && vals_eq(ad, bd)\n1208\t        }\n1209\t        (\n1210\t            ValUnion::F {\n1211\t                args: a_args,\n1212\t                body: a_body,\n1213\t                ..\n1214\t            },\n1215\t            ValUnion::F {\n1216\t                args: b_args,\n1217\t                body: b_body,\n1218\t                ..\n1219\t            },\n1220\t        ) => vals_eq(a_args, b_args) && vals_eq(a_body, b_body),\n1221\t        (ValUnion::S(s1), ValUnion::S(s2)) => s1 == s2,\n1222\t        (ValUnion::N { num: n1, den: d1 }, ValUnion::N { num: n2, den: d2 }) => {\n1223\t            n1 == n2 && d1 == d2\n1224\t        }\n1225\t        (ValUnion::Pr { name: n1, .. }, ValUnion::Pr { name: n2, .. }) => n1 == n2,\n1226\t        (ValUnion::R(_), ValUnion::R(_)) => false,\n1227\t        _ => matches!(a.t, TspType::TspNil | TspType::TspNone),\n1228\t    }\n1229\t}\n1230\t\n1231\tpub fn esc_char(c: char) -> char {\n1232\t    match c {\n1233\t        'n' => '\\n',\n1234\t        'r' => '\\r',\n1235\t        't' => '\\t',\n1236\t        '\\n' => ' ',\n1237\t        _ => c,\n1238\t    }\n1239\t}\n1240\t\n1241\tpub fn read_sign(st: &mut Tsp) -> i32 {\n1242\t    let bytes = st.file.as_bytes();\n1243\t    if st.filec >= bytes.len() {\n1244\t        return 1;\n1245\t    }\n1246\t    match bytes[st.filec] {\n1247\t        b'-' => {\n1248\t            st.filec += 1;\n1249\t            -1\n1250\t        }\n1251\t        b'+' => {\n1252\t            st.filec += 1;\n1253\t            1\n1254\t        }\n1255\t        _ => 1,\n1256\t    }\n1257\t}\n1258\t\n1259\tpub fn tisp_print(f: &mut std::fs::File, v: &Val) {\n1260\t    use std::io::Write;\n1261\t    let s = print_to_string(v);\n1262\t    let _ = f.write_all(s.as_bytes());\n1263\t}\n1264\t\n1265\tfn print_to_string(v: &Val) -> String {\n1266\t    match v.t {\n1267\t        TspType::TspNone => \"Void\".to_string(),\n1268\t        TspType::TspNil => \"Nil\".to_string(),\n1269\t        TspType::TspInt => {\n1270\t            let (n, _) = val_num(v);\n1271\t            format!(\"{}\", n as i32)\n1272\t        }\n1273\t        TspType::TspDec => {\n1274\t            let (n, _) = val_num(v);\n1275\t            let s = format!(\"{:.15e}\", n);\n1276\t            // approximate \"%.15g\" — fallback to default formatting\n1277\t            let mut out = format!(\"{}\", n);\n1278\t            if n == (n as i32) as f64 {\n1279\t                out.push_str(\".0\");\n1280\t            }\n1281\t            // suppress unused warn\n1282\t            let _ = s;\n1283\t            out\n1284\t        }\n1285\t        TspType::TspRatio => {\n1286\t            let (n, d) = val_num(v);\n1287\t            format!(\"{}/{}\", n as i32, d as i32)\n1288\t        }\n1289\t        TspType::TspStr | TspType::TspSym => match &v.v {\n1290\t            ValUnion::S(s) => s.clone(),\n1291\t            _ => String::new(),\n1292\t        },\n1293\t        TspType::TspFunc | TspType::TspMacro => {\n1294\t            let kind = if matches!(v.t, TspType::TspFunc) {\n1295\t                \"function\"\n1296\t            } else {\n1297\t                \"macro\"\n1298\t            };\n1299\t            if let ValUnion::F { name, .. } = &v.v {\n1300\t                if name.is_empty() {\n1301\t                    format!(\"#<{}>\", kind)\n1302\t                } else {\n1303\t                    format!(\"#<{}:{}>\", kind, name)\n1304\t                }\n1305\t            } else {\n1306\t                format!(\"#<{}>\", kind)\n1307\t            }\n1308\t        }\n1309\t        TspType::TspPrim => match &v.v {\n1310\t            ValUnion::Pr { name, .. } => format!(\"#<primitive:{}>\", name),\n1311\t            _ => \"#<primitive>\".to_string(),\n1312\t        },\n1313\t        TspType::TspForm => match &v.v {\n1314\t            ValUnion::Pr { name, .. } => format!(\"#<form:{}>\", name),\n1315\t            _ => \"#<form>\".to_string(),\n1316\t        },\n1317\t        TspType::TspRec => {\n1318\t            let mut s = String::from(\"{\");\n1319\t            if let ValUnion::R(r) = &v.v {\n1320\t                let mut cur = Some(r);\n1321\t                while let Some(rec) = cur {\n1322\t                    let mut c = 0;\n1323\t                    for it in rec.items.iter() {\n1324\t                        if !it.key.is_empty() {\n1325\t                            c += 1;\n1326\t                            s.push_str(&format!(\" {}: {}\", it.key, print_to_string(&it.val)));\n1327\t                            if c == TSP_REC_MAX_PRINT {\n1328\t                                s.push_str(\" ...\");\n1329\t                                break;\n1330\t                            }\n1331\t                        }\n1332\t                    }\n1333\t                    cur = rec.next.as_deref();\n1334\t                }\n1335\t            }\n1336\t            s.push_str(\" }\");\n1337\t            s\n1338\t        }\n1339\t        TspType::TspPair => {\n1340\t            let mut s = String::from(\"(\");\n1341\t            if let ValUnion::P { car, cdr } = &v.v {\n1342\t                s.push_str(&print_to_string(car));\n1343\t                let mut cur: &Val = cdr;\n1344\t                while !nilp(cur) {\n1345\t                    if matches!(cur.t, TspType::TspPair) {\n1346\t                        if let ValUnion::P { car: c2, cdr: c3 } = &cur.v {\n1347\t                            s.push(' ');\n1348\t                            s.push_str(&print_to_string(c2));\n1349\t                            cur = c3;\n1350\t                        } else {\n1351\t                            break;\n1352\t                        }\n1353\t                    } else {\n1354\t                        s.push_str(\" . \");\n1355\t                        s.push_str(&print_to_string(cur));\n1356\t                        break;\n1357\t                    }\n1358\t                }\n1359\t            }\n1360\t            s.push(')');\n1361\t            s\n1362\t        }\n1363\t    }\n1364\t}\n1365\t\n1366\tpub fn eval_proc(st: &mut Tsp, env: &mut Rec, f: Val, args: Val) -> Option<Val> {\n1367\t    match f.t {\n1368\t        TspType::TspPrim => {\n1369\t            let evaled = tisp_eval_list(st, env, args)?;\n1370\t            if let ValUnion::Pr { name, .. } = f.v {\n1371\t                let r = dispatch_named(st, env, &name, evaled)?;\n1372\t                return Some(r);\n1373\t            }\n1374\t            None\n1375\t        }\n1376\t        TspType::TspForm => {\n1377\t            if let ValUnion::Pr { name, .. } = f.v {\n1378\t                let r = dispatch_named(st, env, &name, args)?;\n1379\t                return Some(r);\n1380\t            }\n1381\t            None\n1382\t        }\n1383\t        TspType::TspFunc => {\n1384\t            let evaled = tisp_eval_list(st, env, args)?;\n1385\t            if let ValUnion::F {\n1386\t                args: f_args,\n1387\t                body,\n1388\t                env: f_env,\n1389\t                ..\n1390\t            } = f.v\n1391\t            {\n1392\t                let mut new_env = rec_extend(&mut rec_clone(&f_env), *f_args, evaled);\n1393\t                return tisp_eval_body(st, &mut new_env, *body);\n1394\t            }\n1395\t            None\n1396\t        }\n1397\t        TspType::TspMacro => {\n1398\t            if let ValUnion::F {\n1399\t                args: f_args,\n1400\t                body,\n1401\t                env: f_env,\n1402\t                ..\n1403\t            } = f.v\n1404\t            {\n1405\t                let mut new_env = rec_extend(&mut rec_clone(&f_env), *f_args, args);\n1406\t                let r = tisp_eval_body(st, &mut new_env, *body)?;\n1407\t                return tisp_eval(st, r);\n1408\t            }\n1409\t            None\n1410\t        }\n1411\t        TspType::TspRec => {\n1412\t            let evaled = tisp_eval_list(st, env, args)?;\n1413\t            // first arg should be sym\n1414\t            if let ValUnion::P { car, .. } = &evaled.v {\n1415\t                if let ValUnion::S(key) = &car.v {\n1416\t                    if let ValUnion::R(r) = &f.v {\n1417\t                        if let Some(v) = rec_get(r, key) {\n1418\t                            return Some(v);\n1419\t                        }\n1420\t                        if let Some(v) = rec_get(r, \"else\") {\n1421\t                            return Some(v);\n1422\t                        }\n1423\t                    }\n1424\t                }\n1425\t            }\n1426\t            None\n1427\t        }\n1428\t        _ => None,\n1429\t    }\n1430\t}\n1431\t\n1432\tfn dispatch_named(st: &mut Tsp, env: &mut Rec, name: &str, args: Val) -> Option<Val> {\n1433\t    use crate::core::*;\n1434\t    use crate::io::*;\n1435\t    use crate::math::*;\n1436\t    use crate::os::*;\n1437\t    use crate::string::*;\n1438\t    let r = match name {\n1439\t        \"car\" => prim_car(st, env, args),\n1440\t        \"cdr\" => prim_cdr(st, env, args),\n1441\t        \"cons\" => prim_cons(st, env, args),\n1442\t        \"quote\" => form_quote(st, env, args),\n1443\t        \"eval\" => prim_eval(st, env, args),\n1444\t        \"=\" => prim_eq(st, env, args),\n1445\t        \"cond\" => form_cond(st, env, args),\n1446\t        \"do\" => return tisp_eval_body(st, env, args),\n1447\t        \"typeof\" => prim_typeof(st, env, args),\n1448\t        \"procprops\" => prim_procprops(st, env, args),\n1449\t        \"Func\" => form_Func(st, env, args),\n1450\t        \"Macro\" => form_Macro(st, env, args),\n1451\t        \"error\" => prim_error(st, env, args),\n1452\t        \"Rec\" => match mk_rec(st, rec_clone(env), args) {\n1453\t            Some(v) => v,\n1454\t            None => return None,\n1455\t        },\n1456\t        \"recmerge\" => prim_recmerge(st, env, args),\n1457\t        \"records\" => prim_records(st, env, args),\n1458\t        \"def\" => form_def(st, env, args),\n1459\t        \"undefine!\" => form_undefine(st, env, args),\n1460\t        \"defined?\" => form_definedp(st, env, args),\n1461\t\n1462\t        // string\n1463\t        \"Str\" => prim_Str(st, env, args),\n1464\t        \"Sym\" => prim_Sym(st, env, args),\n1465\t        \"strlen\" => prim_strlen(st, env, args),\n1466\t        \"strformat\" => form_strformat(st, env, args),\n1467\t\n1468\t        // math\n1469\t        \"+\" => prim_add(st, env, args),\n1470\t        \"-\" => prim_sub(st, env, args),\n1471\t        \"*\" => prim_mul(st, env, args),\n1472\t        \"/\" => prim_div(st, env, args),\n1473\t        \"mod\" => prim_mod(st, env, args),\n1474\t        \"^\" => prim_pow(st, env, args),\n1475\t        \"Int\" => prim_int(st, env, args),\n1476\t        \"Dec\" => prim_dec(st, env, args),\n1477\t        \"round\" => prim_round(st, env, args),\n1478\t        \"floor\" => prim_floor(st, env, args),\n1479\t        \"ceil\" => prim_ceil(st, env, args),\n1480\t        \"numerator\" => prim_numerator(st, env, args),\n1481\t        \"denominator\" => prim_denominator(st, env, args),\n1482\t        \"<\" => prim_lt(st, env, args),\n1483\t        \">\" => prim_gt(st, env, args),\n1484\t        \"<=\" => prim_lte(st, env, args),\n1485\t        \">=\" => prim_gte(st, env, args),\n1486\t        \"sin\" => prim_sin(st, env, args),\n1487\t        \"cos\" => prim_cos(st, env, args),\n1488\t        \"tan\" => prim_tan(st, env, args),\n1489\t        \"sinh\" => prim_sinh(st, env, args),\n1490\t        \"cosh\" => prim_cosh(st, env, args),\n1491\t        \"tanh\" => prim_tanh(st, env, args),\n1492\t        \"arcsin\" => prim_asin(st, env, args),\n1493\t        \"arccos\" => prim_acos(st, env, args),\n1494\t        \"arctan\" => prim_atan(st, env, args),\n1495\t        \"arcsinh\" => prim_asinh(st, env, args),\n1496\t        \"arccosh\" => prim_acosh(st, env, args),\n1497\t        \"arctanh\" => prim_atanh(st, env, args),\n1498\t        \"exp\" => prim_exp(st, env, args),\n1499\t        \"log\" => prim_log(st, env, args),\n1500\t\n1501\t        // io\n1502\t        \"write\" => prim_write(st, env, args),\n1503\t        \"read\" => prim_read(st, env, args),\n1504\t        \"parse\" => prim_parse(st, env, args),\n1505\t        \"load\" => prim_load(st, env, args),\n1506\t\n1507\t        // os\n1508\t        \"cd!\" => prim_cd(st, env, args),\n1509\t        \"pwd\" => prim_pwd(st, env, args),\n1510\t        \"exit!\" => prim_exit(st, env, args),\n1511\t        \"now\" => prim_now(st, env, args),\n1512\t        \"time\" => form_time(st, env, args),\n1513\t\n1514\t        _ => return None,\n1515\t    };\n1516\t    Some(r)\n1517\t}\n1518\t\n1519\t#[allow(dead_code)]\n1520\tfn clone_tsp(st: &Tsp) -> Tsp {\n1521\t    Tsp {\n1522\t        file: st.file.clone(),\n1523\t        filec: st.filec,\n1524\t        none: val_clone(&st.none),\n1525\t        nil: val_clone(&st.nil),\n1526\t        t: val_clone(&st.t),\n1527\t        env: rec_clone(&st.env),\n1528\t        strs: rec_clone(&st.strs),\n1529\t        syms: rec_clone(&st.syms),\n1530\t        libh: Vec::new(),\n1531\t        libhc: st.libhc,\n1532\t    }\n1533\t}\n1534\t\n1535\tpub fn tisp_eval(st: &mut Tsp, v: Val) -> Option<Val> {\n1536\t    match v.t {\n1537\t        TspType::TspSym => {\n1538\t            let key = if let ValUnion::S(ref s) = v.v {\n1539\t                s.clone()\n1540\t            } else {\n1541\t                return None;\n1542\t            };\n1543\t            rec_get(&st.env, &key)\n1544\t        }\n1545\t        TspType::TspPair => {\n1546\t            let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = v.v {\n1547\t                (*car, *cdr)\n1548\t            } else {\n1549\t                return None;\n1550\t            };\n1551\t            let f = tisp_eval(st, car_v)?;\n1552\t            let mut env = rec_clone(&st.env);\n1553\t            eval_proc(st, &mut env, f, cdr_v)\n1554\t        }\n1555\t        _ => Some(v),\n1556\t    }\n1557\t}\n1558\t\n1559\tpub fn mk_func(t: TspType, name: &str, args: Val, body: Val, env: Rec) -> Option<Val> {\n1560\t    Some(Val {\n1561\t        t,\n1562\t        v: ValUnion::F {\n1563\t            name: name.to_string(),\n1564\t            args: Box::new(args),\n1565\t            body: Box::new(body),\n1566\t            env,\n1567\t        },\n1568\t    })\n1569\t}\n1570\t\n1571\tpub fn rec_grow(rec: &mut Rec) {\n1572\t    let ocap = rec.cap as usize;\n1573\t    let new_cap = ocap.saturating_mul(TSP_REC_FACTOR).max(1);\n1574\t    let mut new_items: Vec<Entry> = Vec::with_capacity(new_cap);\n1575\t    for _ in 0..new_cap {\n1576\t        new_items.push(Entry {\n1577\t            key: String::new(),\n1578\t            val: val_make_nil(),\n1579\t        });\n1580\t    }\n1581\t    let old_items = std::mem::replace(&mut rec.items, new_items);\n1582\t    rec.cap = new_cap as i32;\n1583\t    rec.size = 0;\n1584\t    for e in old_items {\n1585\t        if !e.key.is_empty() {\n1586\t            rec_add(rec, &e.key.clone(), e.val);\n1587\t        }\n1588\t    }\n1589\t}\n1590\t"}]},"parent_tool_use_id":null,"session_id":"2bd966c9-4f09-4f25-aa17-302dc496b096","uuid":"ea535414-0130-46a7-8a1d-74b372f32446","timestamp":"2026-05-29T19:34:07.846Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-oVdv05/project/src/tisp.rs","content":"pub const TSP_REC_MAX_PRINT: usize = 64;\npub const TSP_SYM_CHARS: &str = \"_!?@#$%&~*-\";\npub const TSP_REC_FACTOR: usize = 2;\n#[derive(Debug, Clone, Copy)]\npub enum TspType {\nTspNone = 1 << 0,\nTspNil = 1 << 1,\nTspInt = 1 << 2,\nTspDec = 1 << 3,\nTspRatio = 1 << 4,\nTspStr = 1 << 5,\nTspSym = 1 << 6,\nTspPrim = 1 << 7,\nTspForm = 1 << 8,\nTspFunc = 1 << 9,\nTspMacro = 1 << 10,\nTspPair = 1 << 11,\nTspRec = 1 << 12,\n}\npub const TSP_EXPR: u32 = TSP_NUM | TspType::TspSym as u32 | TspType::TspPair as u32;\npub const TSP_RATIONAL: u32 = TspType::TspInt as u32 | TspType::TspRatio as u32;\npub const TSP_OP_CHARS: &str = \"_+-*/\\\\|=^<>.:\";\npub const TSP_NUM: u32 = TSP_RATIONAL | TspType::TspDec as u32;\npub struct Entry {\npub key: String,\npub val: Val,\n}\npub type Prim = fn(Tsp, Rec, Val) -> Val;\npub struct Rec {\npub size: i32,\npub cap: i32,\npub items: Vec<Entry>,\npub next: Option<Box<Rec>>,\n}\npub struct Tsp {\npub file: String,\npub filec: usize,\npub none: Val,\npub nil: Val,\npub t: Val,\npub env: Rec,\npub strs: Rec,\npub syms: Rec,\npub libh: Vec<*mut std::ffi::c_void>,\npub libhc: usize,\n}\npub struct Val {\npub t: TspType,\npub v: ValUnion,\n}\npub enum ValUnion {\nS(String),\nN { num: f64, den: f64 },\nPr { name: String, pr: Prim },\nF { name: String, args: Box<Val>, body: Box<Val>, env: Rec },\nP { car: Box<Val>, cdr: Box<Val> },\nR(Rec),\n}\n\n// ======================== Helpers ========================\n\nfn type_bits(t: TspType) -> u32 {\n    t as u32\n}\n\nfn type_matches(t: TspType, mask: u32) -> bool {\n    (type_bits(t) & mask) != 0\n}\n\npub(crate) fn val_clone(v: &Val) -> Val {\n    Val {\n        t: v.t,\n        v: match &v.v {\n            ValUnion::S(s) => ValUnion::S(s.clone()),\n            ValUnion::N { num, den } => ValUnion::N { num: *num, den: *den },\n            ValUnion::Pr { name, pr } => ValUnion::Pr { name: name.clone(), pr: *pr },\n            ValUnion::F { name, args, body, env } => ValUnion::F {\n                name: name.clone(),\n                args: Box::new(val_clone(args)),\n                body: Box::new(val_clone(body)),\n                env: rec_clone(env),\n            },\n            ValUnion::P { car, cdr } => ValUnion::P {\n                car: Box::new(val_clone(car)),\n                cdr: Box::new(val_clone(cdr)),\n            },\n            ValUnion::R(r) => ValUnion::R(rec_clone(r)),\n        },\n    }\n}\n\npub(crate) fn rec_clone(r: &Rec) -> Rec {\n    Rec {\n        size: r.size,\n        cap: r.cap,\n        items: r\n            .items\n            .iter()\n            .map(|e| Entry {\n                key: e.key.clone(),\n                val: val_clone(&e.val),\n            })\n            .collect(),\n        next: r.next.as_ref().map(|n| Box::new(rec_clone(n))),\n    }\n}\n\npub(crate) fn nilp(v: &Val) -> bool {\n    matches!(v.t, TspType::TspNil)\n}\n\npub(crate) fn val_num(v: &Val) -> (f64, f64) {\n    match &v.v {\n        ValUnion::N { num, den } => (*num, *den),\n        _ => (0.0, 1.0),\n    }\n}\n\n#[allow(dead_code)]\npub(crate) fn val_str(v: &Val) -> String {\n    match &v.v {\n        ValUnion::S(s) => s.clone(),\n        _ => String::new(),\n    }\n}\n\n#[allow(dead_code)]\npub(crate) fn pair_car(v: &Val) -> Option<&Val> {\n    if let ValUnion::P { car, .. } = &v.v {\n        Some(car)\n    } else {\n        None\n    }\n}\n\n#[allow(dead_code)]\npub(crate) fn pair_cdr(v: &Val) -> Option<&Val> {\n    if let ValUnion::P { cdr, .. } = &v.v {\n        Some(cdr)\n    } else {\n        None\n    }\n}\n\n// Empty placeholder Prim function used for constructing Val::Prim where\n// the source-level signatures preclude wiring in the actual handlers.\n// Actual dispatch is by-name (see `dispatch_named`).\npub fn stub_prim(_st: Tsp, _env: Rec, _args: Val) -> Val {\n    Val {\n        t: TspType::TspNone,\n        v: ValUnion::N { num: 0.0, den: 1.0 },\n    }\n}\n\n// ======================== Constructors ========================\n\npub fn rec_add(rec: &mut Rec, key: &str, val: Val) {\n    let i = find_slot(rec, key);\n    if rec.items[i].key.is_empty() && key.is_empty() {\n        // overwrite empty key with empty key — degenerate\n        rec.items[i].val = val;\n        return;\n    }\n    if rec.items[i].key == key {\n        rec.items[i].val = val;\n    } else {\n        rec.items[i] = Entry {\n            key: key.to_string(),\n            val,\n        };\n        rec.size += 1;\n        if rec.size > rec.cap / TSP_REC_FACTOR as i32 {\n            rec_grow(rec);\n        }\n    }\n}\n\nfn find_slot(rec: &Rec, key: &str) -> usize {\n    if rec.cap <= 0 || rec.items.is_empty() {\n        return 0;\n    }\n    let cap = rec.cap as usize;\n    let mut i = (hash(key) as usize) % cap;\n    loop {\n        if rec.items[i].key.is_empty() {\n            return i;\n        }\n        if rec.items[i].key == key {\n            return i;\n        }\n        i += 1;\n        if i == cap {\n            i = 0;\n        }\n    }\n}\n\npub fn mk_rat(num: i32, den: i32) -> Option<Val> {\n    if den == 0 {\n        return None;\n    }\n    let mut num = num;\n    let mut den = den;\n    frac_reduce(&mut num, &mut den);\n    if den < 0 {\n        den = den.abs();\n        num = -num;\n    }\n    if den == 1 {\n        return Some(mk_int(num));\n    }\n    Some(Val {\n        t: TspType::TspRatio,\n        v: ValUnion::N {\n            num: num as f64,\n            den: den as f64,\n        },\n    })\n}\n\npub fn mk_val(t: TspType) -> Val {\n    let v = match t {\n        TspType::TspStr | TspType::TspSym => ValUnion::S(String::new()),\n        TspType::TspInt | TspType::TspDec | TspType::TspRatio => ValUnion::N { num: 0.0, den: 1.0 },\n        TspType::TspPrim | TspType::TspForm => ValUnion::Pr {\n            name: String::new(),\n            pr: stub_prim,\n        },\n        TspType::TspFunc | TspType::TspMacro => ValUnion::F {\n            name: String::new(),\n            args: Box::new(Val {\n                t: TspType::TspNil,\n                v: ValUnion::N { num: 0.0, den: 1.0 },\n            }),\n            body: Box::new(Val {\n                t: TspType::TspNil,\n                v: ValUnion::N { num: 0.0, den: 1.0 },\n            }),\n            env: rec_new(4, None),\n        },\n        TspType::TspPair => ValUnion::P {\n            car: Box::new(Val {\n                t: TspType::TspNil,\n                v: ValUnion::N { num: 0.0, den: 1.0 },\n            }),\n            cdr: Box::new(Val {\n                t: TspType::TspNil,\n                v: ValUnion::N { num: 0.0, den: 1.0 },\n            }),\n        },\n        TspType::TspRec => ValUnion::R(rec_new(4, None)),\n        TspType::TspNone | TspType::TspNil => ValUnion::N { num: 0.0, den: 1.0 },\n    };\n    Val { t, v }\n}\n\npub fn tsp_lstlen(v: &Val) -> i32 {\n    let mut len = 0i32;\n    let mut cur = v;\n    loop {\n        match cur.t {\n            TspType::TspPair => {\n                len += 1;\n                if let ValUnion::P { cdr, .. } = &cur.v {\n                    cur = cdr;\n                } else {\n                    break;\n                }\n            }\n            _ => break,\n        }\n    }\n    if nilp(cur) {\n        len\n    } else {\n        -(len + 1)\n    }\n}\n\npub fn tisp_env_init(cap: usize) -> Tsp {\n    let nil = Val {\n        t: TspType::TspNil,\n        v: ValUnion::N { num: 0.0, den: 1.0 },\n    };\n    let none = Val {\n        t: TspType::TspNone,\n        v: ValUnion::N { num: 0.0, den: 1.0 },\n    };\n    let t = Val {\n        t: TspType::TspSym,\n        v: ValUnion::S(\"True\".to_string()),\n    };\n    let t_clone = val_clone(&t);\n    let nil_clone = val_clone(&nil);\n    let none_clone = val_clone(&none);\n    let nil_clone2 = val_clone(&nil);\n    let mut st = Tsp {\n        file: String::new(),\n        filec: 0,\n        none,\n        nil,\n        t,\n        env: rec_new(cap, None),\n        strs: rec_new(cap, None),\n        syms: rec_new(cap, None),\n        libh: Vec::new(),\n        libhc: 0,\n    };\n    tisp_env_add(&mut st, \"True\", t_clone);\n    tisp_env_add(&mut st, \"Nil\", nil_clone);\n    tisp_env_add(&mut st, \"Void\", none_clone);\n    tisp_env_add(&mut st, \"bt\", nil_clone2);\n    let ver = Val {\n        t: TspType::TspStr,\n        v: ValUnion::S(\"0.1\".to_string()),\n    };\n    tisp_env_add(&mut st, \"version\", ver);\n    st\n}\n\npub fn tib_env_os(st: &mut Tsp) {\n    crate::os::tib_env_os(st)\n}\n\npub fn read_num(st: &mut Tsp) -> Val {\n    let sign = read_sign(st);\n    let n = read_int(st);\n    let bytes = st.file.as_bytes();\n    let c = if st.filec < bytes.len() {\n        bytes[st.filec] as char\n    } else {\n        '\\0'\n    };\n    match c {\n        '/' => {\n            st.filec += 1;\n            // Parse denominator; must be a number, else fall back to int\n            if st.filec < bytes.len() && isnum(&st.file[st.filec..]) {\n                let s2 = read_sign(st);\n                let d = read_int(st);\n                if let Some(v) = mk_rat(sign * n, s2 * d) {\n                    return v;\n                }\n            }\n            mk_int(sign * n)\n        }\n        '.' => {\n            st.filec += 1;\n            let oldc = st.filec;\n            let mut d = read_int(st) as f64;\n            let size = st.filec - oldc;\n            for _ in 0..size {\n                d /= 10.0;\n            }\n            match read_sci(st, sign as f64 * (n as f64 + d), 0) {\n                Some(v) => v,\n                None => mk_dec(sign as f64 * (n as f64 + d)).unwrap_or_else(|| mk_int(0)),\n            }\n        }\n        _ => match read_sci(st, sign as f64 * n as f64, 1) {\n            Some(v) => v,\n            None => mk_int(sign * n),\n        },\n    }\n}\n\npub fn entry_get<'a>(rec: &'a Rec, key: &'a str) -> Option<&'a Entry> {\n    if rec.cap <= 0 || rec.items.is_empty() {\n        return None;\n    }\n    let i = find_slot(rec, key);\n    if rec.items[i].key == key && !key.is_empty() {\n        Some(&rec.items[i])\n    } else {\n        None\n    }\n}\n\npub fn tib_env_string(st: &mut Tsp) {\n    crate::string::tib_env_string(st)\n}\n\npub fn prepend_bt(_st: &mut Tsp, _env: &mut Rec, _f: Val) {\n    // Backtrace recording — best-effort no-op. The base \"bt\" var is initialised\n    // to nil in tisp_env_init.\n}\n\npub fn rec_get(rec: &Rec, key: &str) -> Option<Val> {\n    let mut cur = Some(rec);\n    while let Some(r) = cur {\n        if let Some(e) = entry_get(r, key) {\n            return Some(val_clone(&e.val));\n        }\n        cur = r.next.as_deref();\n    }\n    None\n}\n\npub fn tisp_env_add(st: &mut Tsp, key: &str, v: Val) {\n    rec_add(&mut st.env, key, v);\n}\n\npub fn mk_pair(a: Val, b: Val) -> Option<Val> {\n    Some(Val {\n        t: TspType::TspPair,\n        v: ValUnion::P {\n            car: Box::new(a),\n            cdr: Box::new(b),\n        },\n    })\n}\n\npub fn read_pair(st: &mut Tsp, endchar: char) -> Option<Val> {\n    let skipnl = if endchar != '\\n' { 1 } else { 0 };\n    skip_ws(st, skipnl);\n    let mut items: Vec<Val> = Vec::new();\n    let mut tail: Option<Val> = None;\n    loop {\n        let bytes = st.file.as_bytes();\n        if st.filec >= bytes.len() {\n            break;\n        }\n        let c = bytes[st.filec] as char;\n        if c == endchar {\n            break;\n        }\n        let v = tisp_read(st)?;\n        // Detect \".\" dotted pair marker\n        if matches!(v.t, TspType::TspSym) {\n            if let ValUnion::S(s) = &v.v {\n                if s == \".\" {\n                    skip_ws(st, skipnl);\n                    let v2 = tisp_read(st)?;\n                    tail = Some(v2);\n                    break;\n                }\n            }\n        }\n        items.push(v);\n        skip_ws(st, skipnl);\n    }\n    skip_ws(st, skipnl);\n    let bytes = st.file.as_bytes();\n    if skipnl != 0 {\n        let cur = if st.filec < bytes.len() {\n            bytes[st.filec] as char\n        } else {\n            '\\0'\n        };\n        if cur != endchar {\n            return None;\n        }\n    }\n    if st.filec < bytes.len() {\n        st.filec += 1;\n    }\n    // Build linked list\n    let nil_val = Val {\n        t: TspType::TspNil,\n        v: ValUnion::N { num: 0.0, den: 1.0 },\n    };\n    let mut acc = tail.unwrap_or(nil_val);\n    for v in items.into_iter().rev() {\n        acc = mk_pair(v, acc)?;\n    }\n    Some(acc)\n}\n\npub fn tisp_read_sexpr(st: &mut Tsp) -> Option<Val> {\n    skip_ws(st, 1);\n    let bytes = st.file.as_bytes();\n    if st.filec >= bytes.len() {\n        return Some(val_clone(&st.none));\n    }\n    let rest = &st.file[st.filec..];\n    if rest.is_empty() {\n        return Some(val_clone(&st.none));\n    }\n    if isnum(rest) {\n        return Some(read_num(st));\n    }\n    let c = bytes[st.filec] as char;\n    if c == '\"' {\n        return read_str(st, |st, s| mk_str(st, s).unwrap_or_else(|| val_clone(&st.none)));\n    }\n    if c == '~' {\n        return read_str(st, |st, s| mk_sym(st, s).unwrap_or_else(|| val_clone(&st.none)));\n    }\n    let prefix: &[(&str, &str)] = &[\n        (\"'\", \"quote\"),\n        (\"`\", \"quasiquote\"),\n        (\",@\", \"unquote-splice\"),\n        (\",\", \"unquote\"),\n        (\"@\", \"Func\"),\n        (\"f\\\"\", \"strformat\"),\n    ];\n    for (pre, sym) in prefix {\n        if rest.starts_with(pre) {\n            let strip = if pre.ends_with('\"') { 1 } else { 0 };\n            st.filec += pre.len() - strip;\n            let v = tisp_read(st)?;\n            let symv = mk_sym(st, sym)?;\n            return mk_list(st, 2, vec![symv, v]);\n        }\n    }\n    if is_op(c) {\n        return read_sym(st, is_op);\n    }\n    if is_sym(c) {\n        return read_sym(st, is_sym);\n    }\n    if c == '(' {\n        st.filec += 1;\n        return read_pair(st, ')');\n    }\n    if c == '[' {\n        st.filec += 1;\n        let lst = read_pair(st, ']')?;\n        let s = mk_sym(st, \"list\")?;\n        return mk_pair(s, lst);\n    }\n    if c == '{' {\n        st.filec += 1;\n        let v = read_pair(st, '}')?;\n        let s = mk_sym(st, \"Rec\")?;\n        return mk_pair(s, v);\n    }\n    None\n}\n\npub fn is_sym(c: char) -> bool {\n    c.is_ascii_alphanumeric() || TSP_SYM_CHARS.contains(c)\n}\n\npub fn mk_sym(st: &mut Tsp, s: &str) -> Option<Val> {\n    if let Some(v) = rec_get(&st.syms, s) {\n        return Some(v);\n    }\n    let v = Val {\n        t: TspType::TspSym,\n        v: ValUnion::S(s.to_string()),\n    };\n    rec_add(&mut st.syms, s, val_clone(&v));\n    Some(v)\n}\n\npub fn frac_reduce(num: &mut i32, den: &mut i32) {\n    if *den == 0 {\n        return;\n    }\n    let mut a = num.unsigned_abs() as i32;\n    let mut b = den.unsigned_abs() as i32;\n    if b == 0 {\n        return;\n    }\n    let mut c = a % b;\n    while c > 0 {\n        a = b;\n        b = c;\n        c = a % b;\n    }\n    if b != 0 {\n        *num /= b;\n        *den /= b;\n    }\n}\n\npub fn tisp_read_line(st: &mut Tsp, level: i32) -> Option<Val> {\n    let ret = read_pair(st, '\\n')?;\n    let mut ret = if !matches!(ret.t, TspType::TspPair) {\n        let nil_val = val_clone(&st.nil);\n        mk_pair(ret, nil_val)?\n    } else {\n        ret\n    };\n    // Walk to last pair where cdr is pair, then conditionally read sub-expressions.\n    // We collect tail extensions in a vec and rebuild for safety.\n    let mut tail_exprs: Vec<Val> = Vec::new();\n    loop {\n        let bytes = st.file.as_bytes();\n        if st.filec >= bytes.len() {\n            break;\n        }\n        // Count tabs/spaces\n        let mut newlevel = 0i32;\n        let mut i = st.filec;\n        while i < bytes.len() && (bytes[i] == b'\\t' || bytes[i] == b' ') {\n            newlevel += 1;\n            i += 1;\n        }\n        if newlevel <= level {\n            break;\n        }\n        st.filec += newlevel as usize;\n        let sub = tisp_read_line(st, newlevel)?;\n        tail_exprs.push(sub);\n    }\n    // append tail_exprs to the end of ret list\n    if !tail_exprs.is_empty() {\n        ret = append_to_list(ret, tail_exprs, val_clone(&st.nil));\n    }\n    // if only 1 element, return car\n    if let ValUnion::P { car, cdr } = &ret.v {\n        if nilp(cdr) {\n            return Some(val_clone(car));\n        }\n    }\n    Some(ret)\n}\n\nfn append_to_list(list: Val, exprs: Vec<Val>, nil: Val) -> Val {\n    // walks list pairs, when cdr is nil, replace with (expr . next)\n    fn rec(v: Val, exprs: &mut Vec<Val>, nil: &Val) -> Val {\n        match v.v {\n            ValUnion::P { car, cdr } => {\n                let new_cdr = rec(*cdr, exprs, nil);\n                Val {\n                    t: TspType::TspPair,\n                    v: ValUnion::P {\n                        car,\n                        cdr: Box::new(new_cdr),\n                    },\n                }\n            }\n            _ => {\n                if nilp(&v) {\n                    // build a list from exprs\n                    let mut acc = val_clone(nil);\n                    while let Some(e) = exprs.pop() {\n                        acc = Val {\n                            t: TspType::TspPair,\n                            v: ValUnion::P {\n                                car: Box::new(e),\n                                cdr: Box::new(acc),\n                            },\n                        };\n                    }\n                    acc\n                } else {\n                    v\n                }\n            }\n        }\n    }\n    let mut exprs = exprs;\n    rec(list, &mut exprs, &nil)\n}\n\npub fn mk_prim(t: TspType, pr: Prim, name: &str) -> Option<Val> {\n    Some(Val {\n        t,\n        v: ValUnion::Pr {\n            name: name.to_string(),\n            pr,\n        },\n    })\n}\n\npub fn isnum(s: &str) -> bool {\n    let bytes = s.as_bytes();\n    if bytes.is_empty() {\n        return false;\n    }\n    let c0 = bytes[0];\n    let c1 = if bytes.len() > 1 { bytes[1] } else { 0 };\n    if c0.is_ascii_digit() {\n        return true;\n    }\n    if c0 == b'.' && c1.is_ascii_digit() {\n        return true;\n    }\n    if (c0 == b'-' || c0 == b'+') && (c1.is_ascii_digit() || c1 == b'.') {\n        return true;\n    }\n    false\n}\n\npub fn tsp_type_str(t: TspType) -> &'static str {\n    match t {\n        TspType::TspNone => \"Void\",\n        TspType::TspNil => \"Nil\",\n        TspType::TspInt => \"Int\",\n        TspType::TspDec => \"Dec\",\n        TspType::TspRatio => \"Ratio\",\n        TspType::TspStr => \"Str\",\n        TspType::TspSym => \"Sym\",\n        TspType::TspPrim => \"Prim\",\n        TspType::TspForm => \"Form\",\n        TspType::TspFunc => \"Func\",\n        TspType::TspMacro => \"Macro\",\n        TspType::TspPair => \"Pair\",\n        TspType::TspRec => \"Rec\",\n    }\n}\n\npub fn mk_str(st: &mut Tsp, s: &str) -> Option<Val> {\n    if let Some(v) = rec_get(&st.strs, s) {\n        return Some(v);\n    }\n    let v = Val {\n        t: TspType::TspStr,\n        v: ValUnion::S(s.to_string()),\n    };\n    rec_add(&mut st.strs, s, val_clone(&v));\n    Some(v)\n}\n\npub fn is_op(c: char) -> bool {\n    TSP_OP_CHARS.contains(c)\n}\n\npub fn esc_str(s: &str, len: i32, do_esc: i32) -> String {\n    let bytes = s.as_bytes();\n    let n = (len.max(0) as usize).min(bytes.len());\n    let mut out = String::with_capacity(n);\n    let mut i = 0;\n    let mut count = 0;\n    while count < n {\n        let c = bytes[i];\n        if c == b'\\\\' && do_esc != 0 {\n            i += 1;\n            if i < bytes.len() {\n                out.push(esc_char(bytes[i] as char));\n            }\n        } else {\n            out.push(c as char);\n        }\n        i += 1;\n        count += 1;\n    }\n    out\n}\n\npub fn tib_env_core(st: &mut Tsp) {\n    crate::core::tib_env_core(st)\n}\n\npub fn skip_ws(st: &mut Tsp, skipnl: i32) {\n    let s: &[u8] = if skipnl != 0 {\n        b\" \\t\\n\\r\"\n    } else {\n        b\" \\t\"\n    };\n    let bytes = st.file.as_bytes();\n    loop {\n        if st.filec >= bytes.len() {\n            return;\n        }\n        let c = bytes[st.filec];\n        if c == 0 {\n            return;\n        }\n        if !s.contains(&c) && c != b';' {\n            return;\n        }\n        // skip whitespace\n        while st.filec < bytes.len() && s.contains(&bytes[st.filec]) {\n            st.filec += 1;\n        }\n        // skip comments\n        while st.filec < bytes.len() && bytes[st.filec] == b';' {\n            // skip until newline\n            while st.filec < bytes.len() && bytes[st.filec] != b'\\n' {\n                st.filec += 1;\n            }\n            if skipnl == 0 {\n                // stop at newline (don't consume it)\n                break;\n            }\n            // skip the newline\n            if st.filec < bytes.len() {\n                st.filec += 1;\n            }\n        }\n    }\n}\n\npub fn rec_extend(rec: &mut Rec, args: Val, vals: Val) -> Rec {\n    let argnum = TSP_REC_FACTOR as i32 * tsp_lstlen(&args);\n    let cap = if argnum > 0 { argnum } else { -argnum + 1 };\n    let mut ret = rec_new(cap as usize, Some(Box::new(rec_clone(rec))));\n    let mut a = args;\n    let mut v = vals;\n    loop {\n        if nilp(&a) {\n            break;\n        }\n        let (arg, val, more_a, more_v) = match (a.t, v.t) {\n            (TspType::TspPair, TspType::TspPair) => {\n                if let (ValUnion::P { car: ac, cdr: ad }, ValUnion::P { car: vc, cdr: vd }) =\n                    (a.v, v.v)\n                {\n                    (*ac, *vc, *ad, *vd)\n                } else {\n                    return ret;\n                }\n            }\n            _ => (a, v, val_make_nil(), val_make_nil()),\n        };\n        let key = match &arg.v {\n            ValUnion::S(s) => s.clone(),\n            _ => return ret,\n        };\n        rec_add(&mut ret, &key, val);\n        if !matches!(more_a.t, TspType::TspPair) {\n            break;\n        }\n        a = more_a;\n        v = more_v;\n    }\n    ret\n}\n\nfn val_make_nil() -> Val {\n    Val {\n        t: TspType::TspNil,\n        v: ValUnion::N { num: 0.0, den: 1.0 },\n    }\n}\n\npub fn hash(key: &str) -> u32 {\n    let mut h: u32 = 0;\n    for c in key.bytes() {\n        h = h.wrapping_mul(33).wrapping_add(c as u32);\n    }\n    h\n}\n\npub fn mk_rec(st: &mut Tsp, env: Rec, assoc: Val) -> Option<Val> {\n    // If assoc is \"missing\" (we use nil to mean missing), return rec wrapping env.\n    if nilp(&assoc) {\n        return Some(Val {\n            t: TspType::TspRec,\n            v: ValUnion::R(env),\n        });\n    }\n    let cap = TSP_REC_FACTOR as i32 * tsp_lstlen(&assoc);\n    let cap = if cap > 0 { cap } else { -cap + 1 };\n    let r = rec_new(cap as usize, None);\n    let ret = Val {\n        t: TspType::TspRec,\n        v: ValUnion::R(r),\n    };\n    let mut outer = rec_new(4, Some(Box::new(env)));\n    rec_add(&mut outer, \"this\", val_clone(&ret));\n\n    let mut ret = ret;\n    let mut cur = assoc;\n    while matches!(cur.t, TspType::TspPair) {\n        let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = cur.v {\n            (*car, *cdr)\n        } else {\n            break;\n        };\n        match car_v.t {\n            TspType::TspPair => {\n                if let ValUnion::P { car: caar, cdr: cdar } = car_v.v {\n                    if matches!(caar.t, TspType::TspSym | TspType::TspStr) {\n                        let key = match &caar.v {\n                            ValUnion::S(s) => s.clone(),\n                            _ => String::new(),\n                        };\n                        // cdar should be a pair, take its car\n                        if let ValUnion::P { car: c2, .. } = cdar.v {\n                            let v = tisp_eval(st, *c2)?;\n                            if let ValUnion::R(rr) = &mut ret.v {\n                                rec_add(rr, &key, v);\n                            }\n                        }\n                    } else {\n                        return None;\n                    }\n                }\n            }\n            TspType::TspSym => {\n                let key = if let ValUnion::S(ref s) = car_v.v {\n                    s.clone()\n                } else {\n                    String::new()\n                };\n                let v = tisp_eval(st, car_v)?;\n                if let ValUnion::R(rr) = &mut ret.v {\n                    rec_add(rr, &key, v);\n                }\n            }\n            _ => return None,\n        }\n        cur = cdr_v;\n    }\n    Some(ret)\n}\n\npub fn tisp_read(st: &mut Tsp) -> Option<Val> {\n    let mut v = tisp_read_sexpr(st)?;\n    loop {\n        let bytes = st.file.as_bytes();\n        if st.filec >= bytes.len() {\n            break;\n        }\n        let c = bytes[st.filec] as char;\n        if c == '(' || c == ':' || c == '>' || c == '{' {\n            v = tisp_read_sugar(st, v)?;\n        } else {\n            break;\n        }\n    }\n    Some(v)\n}\n\npub fn mk_int(i: i32) -> Val {\n    Val {\n        t: TspType::TspInt,\n        v: ValUnion::N {\n            num: i as f64,\n            den: 1.0,\n        },\n    }\n}\n\npub fn tib_env_math(st: &mut Tsp) {\n    crate::math::tib_env_math(st)\n}\n\npub fn tisp_eval_list(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> {\n    let mut items: Vec<Val> = Vec::new();\n    let mut cur = v;\n    loop {\n        if nilp(&cur) {\n            // build nil-terminated list\n            let mut acc = val_clone(&st.nil);\n            for it in items.into_iter().rev() {\n                acc = mk_pair(it, acc)?;\n            }\n            return Some(acc);\n        }\n        match cur.t {\n            TspType::TspPair => {\n                let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = cur.v {\n                    (*car, *cdr)\n                } else {\n                    return None;\n                };\n                let _ = env; // env parameter unused due to single-env eval\n                let ev = tisp_eval(st, car_v)?;\n                items.push(ev);\n                cur = cdr_v;\n            }\n            _ => {\n                // improper list — eval the tail and append\n                let ev = tisp_eval(st, cur)?;\n                let mut acc = ev;\n                for it in items.into_iter().rev() {\n                    acc = mk_pair(it, acc)?;\n                }\n                return Some(acc);\n            }\n        }\n    }\n}\n\npub fn read_sci(st: &mut Tsp, val: f64, isint: i32) -> Option<Val> {\n    let bytes = st.file.as_bytes();\n    let mut val = val;\n    let mut isint = isint;\n    if st.filec < bytes.len() {\n        let c = (bytes[st.filec] as char).to_ascii_lowercase();\n        if c == 'e' {\n            st.filec += 1;\n            let sign = if read_sign(st) == 1 { 10.0 } else { 0.1 };\n            let mut expo = read_int(st);\n            // If expo > 0 and sign is 0.1, it produces fraction. Match C semantics.\n            while expo > 0 {\n                val *= sign;\n                expo -= 1;\n            }\n            isint = 0;\n        }\n    }\n    if isint != 0 {\n        Some(mk_int(val as i32))\n    } else {\n        mk_dec(val)\n    }\n}\n\npub fn read_int(st: &mut Tsp) -> i32 {\n    let bytes = st.file.as_bytes();\n    let mut ret: i32 = 0;\n    while st.filec < bytes.len() {\n        let c = bytes[st.filec];\n        if !c.is_ascii_digit() {\n            break;\n        }\n        ret = ret.wrapping_mul(10).wrapping_add((c - b'0') as i32);\n        st.filec += 1;\n    }\n    ret\n}\n\npub fn rec_new(cap: usize, next: Option<Box<Rec>>) -> Rec {\n    let cap = cap.max(1);\n    let mut items = Vec::with_capacity(cap);\n    for _ in 0..cap {\n        items.push(Entry {\n            key: String::new(),\n            val: val_make_nil(),\n        });\n    }\n    Rec {\n        size: 0,\n        cap: cap as i32,\n        items,\n        next,\n    }\n}\n\npub fn read_str(st: &mut Tsp, mk_fn: fn(&mut Tsp, &str) -> Val) -> Option<Val> {\n    // skip starting open quote\n    st.filec += 1;\n    let bytes = st.file.as_bytes();\n    let start = st.filec;\n    // determine end char by sentinel: we look at character at position start-1\n    let endchar = bytes[start - 1] as char;\n    let endchar_byte = endchar as u8;\n    let mut len = 0i32;\n    while st.filec < bytes.len() && bytes[st.filec] != endchar_byte {\n        if bytes[st.filec] == b'\\\\'\n            && st.filec > 0\n            && (st.filec == 0 || bytes[st.filec - 1] != b'\\\\')\n        {\n            st.filec += 1;\n        }\n        if st.filec >= bytes.len() {\n            return None;\n        }\n        st.filec += 1;\n        len += 1;\n    }\n    if st.filec >= bytes.len() {\n        return None;\n    }\n    st.filec += 1; // skip closing quote\n    let do_esc = if endchar == '\"' { 1 } else { 0 };\n    let raw = &st.file[start..start + len as usize].to_string();\n    let unescaped = esc_str(raw, len, do_esc);\n    Some(mk_fn(st, &unescaped))\n}\n\npub fn read_sym(st: &mut Tsp, is_char: fn(char) -> bool) -> Option<Val> {\n    let bytes = st.file.as_bytes();\n    let start = st.filec;\n    let mut len = 0i32;\n    while st.filec < bytes.len() {\n        let c = bytes[st.filec] as char;\n        if c == '\\0' {\n            break;\n        }\n        if !is_char(c) {\n            break;\n        }\n        st.filec += 1;\n        len += 1;\n    }\n    let raw = st.file[start..start + len as usize].to_string();\n    let s = esc_str(&raw, len, 0);\n    mk_sym(st, &s)\n}\n\npub fn mk_dec(d: f64) -> Option<Val> {\n    Some(Val {\n        t: TspType::TspDec,\n        v: ValUnion::N { num: d, den: 1.0 },\n    })\n}\n\npub fn tisp_eval_body(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> {\n    let mut ret = val_clone(&st.none);\n    let mut cur = v;\n    loop {\n        match cur.t {\n            TspType::TspPair => {\n                let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = cur.v {\n                    (*car, *cdr)\n                } else {\n                    break;\n                };\n                ret = tisp_eval(st, car_v)?;\n                cur = cdr_v;\n            }\n            _ => break,\n        }\n        let _ = env; // env parameter is mostly unused due to global env\n    }\n    Some(ret)\n}\n\npub fn tib_env_io(st: &mut Tsp) {\n    crate::io::tib_env_io(st)\n}\n\npub fn tisp_read_sugar(st: &mut Tsp, v: Val) -> Option<Val> {\n    let bytes = st.file.as_bytes();\n    if st.filec >= bytes.len() {\n        return Some(v);\n    }\n    let c = bytes[st.filec] as char;\n    if c == '(' {\n        st.filec += 1;\n        let lst = read_pair(st, ')')?;\n        return mk_pair(v, lst);\n    }\n    if c == '{' {\n        st.filec += 1;\n        let lst = read_pair(st, '}')?;\n        let recmerge = mk_sym(st, \"recmerge\")?;\n        let recsym = mk_sym(st, \"Rec\")?;\n        let inner = mk_pair(recsym, lst)?;\n        return mk_list(st, 3, vec![recmerge, v, inner]);\n    }\n    if c == ':' {\n        st.filec += 1;\n        let next = if st.filec < bytes.len() {\n            bytes[st.filec] as char\n        } else {\n            '\\0'\n        };\n        match next {\n            '(' => {\n                st.filec += 1;\n                let w = read_pair(st, ')')?;\n                let mapsym = mk_sym(st, \"map\")?;\n                let inner = mk_pair(v, w)?;\n                return mk_pair(mapsym, inner);\n            }\n            ':' => {\n                st.filec += 1;\n                let w = read_sym(st, is_sym)?;\n                let qsym = mk_sym(st, \"quote\")?;\n                let qw = mk_list(st, 2, vec![qsym, w])?;\n                return mk_list(st, 2, vec![v, qw]);\n            }\n            _ => {\n                skip_ws(st, 1);\n                let w = tisp_read(st)?;\n                return mk_list(st, 2, vec![v, w]);\n            }\n        }\n    }\n    if c == '>' {\n        let next = if st.filec + 1 < bytes.len() {\n            bytes[st.filec + 1] as char\n        } else {\n            '\\0'\n        };\n        if next == '>' {\n            st.filec += 2;\n            let w = tisp_read(st)?;\n            if !matches!(w.t, TspType::TspPair) {\n                return None;\n            }\n            if let ValUnion::P { car, cdr } = w.v {\n                let inner = mk_pair(v, *cdr)?;\n                return mk_pair(*car, inner);\n            }\n        }\n    }\n    Some(v)\n}\n\npub fn tisp_env_lib(st: &mut Tsp, lib: &str) {\n    let file = std::mem::take(&mut st.file);\n    let filec = st.filec;\n    st.file = lib.to_string();\n    st.filec = 0;\n    skip_ws(st, 1);\n    if let Some(v) = tisp_read(st) {\n        let mut env = rec_clone(&st.env);\n        let _ = tisp_eval_body(st, &mut env, v);\n    }\n    st.file = file;\n    st.filec = filec;\n}\n\npub fn mk_list(st: &mut Tsp, n: i32, args: Vec<Val>) -> Option<Val> {\n    let mut acc = val_clone(&st.nil);\n    let take = if n < 0 { 0 } else { n as usize };\n    let mut items: Vec<Val> = args.into_iter().take(take).collect();\n    while let Some(v) = items.pop() {\n        acc = mk_pair(v, acc)?;\n    }\n    Some(acc)\n}\n\npub fn vals_eq(a: &Val, b: &Val) -> bool {\n    let a_num = type_matches(a.t, TSP_NUM);\n    let b_num = type_matches(b.t, TSP_NUM);\n    if a_num && b_num {\n        let (an, ad) = val_num(a);\n        let (bn, bd) = val_num(b);\n        return an == bn && ad == bd;\n    }\n    if type_bits(a.t) != type_bits(b.t) {\n        return false;\n    }\n    match (&a.v, &b.v) {\n        (ValUnion::P { car: ac, cdr: ad }, ValUnion::P { car: bc, cdr: bd }) => {\n            vals_eq(ac, bc) && vals_eq(ad, bd)\n        }\n        (\n            ValUnion::F {\n                args: a_args,\n                body: a_body,\n                ..\n            },\n            ValUnion::F {\n                args: b_args,\n                body: b_body,\n                ..\n            },\n        ) => vals_eq(a_args, b_args) && vals_eq(a_body, b_body),\n        (ValUnion::S(s1), ValUnion::S(s2)) => s1 == s2,\n        (ValUnion::N { num: n1, den: d1 }, ValUnion::N { num: n2, den: d2 }) => {\n            n1 == n2 && d1 == d2\n        }\n        (ValUnion::Pr { name: n1, .. }, ValUnion::Pr { name: n2, .. }) => n1 == n2,\n        (ValUnion::R(_), ValUnion::R(_)) => false,\n        _ => matches!(a.t, TspType::TspNil | TspType::TspNone),\n    }\n}\n\npub fn esc_char(c: char) -> char {\n    match c {\n        'n' => '\\n',\n        'r' => '\\r',\n        't' => '\\t',\n        '\\n' => ' ',\n        _ => c,\n    }\n}\n\npub fn read_sign(st: &mut Tsp) -> i32 {\n    let bytes = st.file.as_bytes();\n    if st.filec >= bytes.len() {\n        return 1;\n    }\n    match bytes[st.filec] {\n        b'-' => {\n            st.filec += 1;\n            -1\n        }\n        b'+' => {\n            st.filec += 1;\n            1\n        }\n        _ => 1,\n    }\n}\n\npub fn tisp_print(f: &mut std::fs::File, v: &Val) {\n    use std::io::Write;\n    let s = print_to_string(v);\n    let _ = f.write_all(s.as_bytes());\n}\n\nfn print_to_string(v: &Val) -> String {\n    match v.t {\n        TspType::TspNone => \"Void\".to_string(),\n        TspType::TspNil => \"Nil\".to_string(),\n        TspType::TspInt => {\n            let (n, _) = val_num(v);\n            format!(\"{}\", n as i32)\n        }\n        TspType::TspDec => {\n            let (n, _) = val_num(v);\n            let s = format!(\"{:.15e}\", n);\n            // approximate \"%.15g\" — fallback to default formatting\n            let mut out = format!(\"{}\", n);\n            if n == (n as i32) as f64 {\n                out.push_str(\".0\");\n            }\n            // suppress unused warn\n            let _ = s;\n            out\n        }\n        TspType::TspRatio => {\n            let (n, d) = val_num(v);\n            format!(\"{}/{}\", n as i32, d as i32)\n        }\n        TspType::TspStr | TspType::TspSym => match &v.v {\n            ValUnion::S(s) => s.clone(),\n            _ => String::new(),\n        },\n        TspType::TspFunc | TspType::TspMacro => {\n            let kind = if matches!(v.t, TspType::TspFunc) {\n                \"function\"\n            } else {\n                \"macro\"\n            };\n            if let ValUnion::F { name, .. } = &v.v {\n                if name.is_empty() {\n                    format!(\"#<{}>\", kind)\n                } else {\n                    format!(\"#<{}:{}>\", kind, name)\n                }\n            } else {\n                format!(\"#<{}>\", kind)\n            }\n        }\n        TspType::TspPrim => match &v.v {\n            ValUnion::Pr { name, .. } => format!(\"#<primitive:{}>\", name),\n            _ => \"#<primitive>\".to_string(),\n        },\n        TspType::TspForm => match &v.v {\n            ValUnion::Pr { name, .. } => format!(\"#<form:{}>\", name),\n            _ => \"#<form>\".to_string(),\n        },\n        TspType::TspRec => {\n            let mut s = String::from(\"{\");\n            if let ValUnion::R(r) = &v.v {\n                let mut cur = Some(r);\n                while let Some(rec) = cur {\n                    let mut c = 0;\n                    for it in rec.items.iter() {\n                        if !it.key.is_empty() {\n                            c += 1;\n                            s.push_str(&format!(\" {}: {}\", it.key, print_to_string(&it.val)));\n                            if c == TSP_REC_MAX_PRINT {\n                                s.push_str(\" ...\");\n                                break;\n                            }\n                        }\n                    }\n                    cur = rec.next.as_deref();\n                }\n            }\n            s.push_str(\" }\");\n            s\n        }\n        TspType::TspPair => {\n            let mut s = String::from(\"(\");\n            if let ValUnion::P { car, cdr } = &v.v {\n                s.push_str(&print_to_string(car));\n                let mut cur: &Val = cdr;\n                while !nilp(cur) {\n                    if matches!(cur.t, TspType::TspPair) {\n                        if let ValUnion::P { car: c2, cdr: c3 } = &cur.v {\n                            s.push(' ');\n                            s.push_str(&print_to_string(c2));\n                            cur = c3;\n                        } else {\n                            break;\n                        }\n                    } else {\n                        s.push_str(\" . \");\n                        s.push_str(&print_to_string(cur));\n                        break;\n                    }\n                }\n            }\n            s.push(')');\n            s\n        }\n    }\n}\n\npub fn eval_proc(st: &mut Tsp, env: &mut Rec, f: Val, args: Val) -> Option<Val> {\n    match f.t {\n        TspType::TspPrim => {\n            let evaled = tisp_eval_list(st, env, args)?;\n            if let ValUnion::Pr { name, .. } = f.v {\n                let r = dispatch_named(st, env, &name, evaled)?;\n                return Some(r);\n            }\n            None\n        }\n        TspType::TspForm => {\n            if let ValUnion::Pr { name, .. } = f.v {\n                let r = dispatch_named(st, env, &name, args)?;\n                return Some(r);\n            }\n            None\n        }\n        TspType::TspFunc => {\n            let evaled = tisp_eval_list(st, env, args)?;\n            if let ValUnion::F {\n                args: f_args,\n                body,\n                env: f_env,\n                ..\n            } = f.v\n            {\n                let mut new_env = rec_extend(&mut rec_clone(&f_env), *f_args, evaled);\n                return tisp_eval_body(st, &mut new_env, *body);\n            }\n            None\n        }\n        TspType::TspMacro => {\n            if let ValUnion::F {\n                args: f_args,\n                body,\n                env: f_env,\n                ..\n            } = f.v\n            {\n                let mut new_env = rec_extend(&mut rec_clone(&f_env), *f_args, args);\n                let r = tisp_eval_body(st, &mut new_env, *body)?;\n                return tisp_eval(st, r);\n            }\n            None\n        }\n        TspType::TspRec => {\n            let evaled = tisp_eval_list(st, env, args)?;\n            // first arg should be sym\n            if let ValUnion::P { car, .. } = &evaled.v {\n                if let ValUnion::S(key) = &car.v {\n                    if let ValUnion::R(r) = &f.v {\n                        if let Some(v) = rec_get(r, key) {\n                            return Some(v);\n                        }\n                        if let Some(v) = rec_get(r, \"else\") {\n                            return Some(v);\n                        }\n                    }\n                }\n            }\n            None\n        }\n        _ => None,\n    }\n}\n\nfn dispatch_named(st: &mut Tsp, env: &mut Rec, name: &str, args: Val) -> Option<Val> {\n    use crate::core::*;\n    use crate::io::*;\n    use crate::math::*;\n    use crate::os::*;\n    use crate::string::*;\n    let r = match name {\n        \"car\" => prim_car(st, env, args),\n        \"cdr\" => prim_cdr(st, env, args),\n        \"cons\" => prim_cons(st, env, args),\n        \"quote\" => form_quote(st, env, args),\n        \"eval\" => prim_eval(st, env, args),\n        \"=\" => prim_eq(st, env, args),\n        \"cond\" => form_cond(st, env, args),\n        \"do\" => return tisp_eval_body(st, env, args),\n        \"typeof\" => prim_typeof(st, env, args),\n        \"procprops\" => prim_procprops(st, env, args),\n        \"Func\" => form_Func(st, env, args),\n        \"Macro\" => form_Macro(st, env, args),\n        \"error\" => prim_error(st, env, args),\n        \"Rec\" => match mk_rec(st, rec_clone(env), args) {\n            Some(v) => v,\n            None => return None,\n        },\n        \"recmerge\" => prim_recmerge(st, env, args),\n        \"records\" => prim_records(st, env, args),\n        \"def\" => form_def(st, env, args),\n        \"undefine!\" => form_undefine(st, env, args),\n        \"defined?\" => form_definedp(st, env, args),\n\n        // string\n        \"Str\" => prim_Str(st, env, args),\n        \"Sym\" => prim_Sym(st, env, args),\n        \"strlen\" => prim_strlen(st, env, args),\n        \"strformat\" => form_strformat(st, env, args),\n\n        // math\n        \"+\" => prim_add(st, env, args),\n        \"-\" => prim_sub(st, env, args),\n        \"*\" => prim_mul(st, env, args),\n        \"/\" => prim_div(st, env, args),\n        \"mod\" => prim_mod(st, env, args),\n        \"^\" => prim_pow(st, env, args),\n        \"Int\" => prim_int(st, env, args),\n        \"Dec\" => prim_dec(st, env, args),\n        \"round\" => prim_round(st, env, args),\n        \"floor\" => prim_floor(st, env, args),\n        \"ceil\" => prim_ceil(st, env, args),\n        \"numerator\" => prim_numerator(st, env, args),\n        \"denominator\" => prim_denominator(st, env, args),\n        \"<\" => prim_lt(st, env, args),\n        \">\" => prim_gt(st, env, args),\n        \"<=\" => prim_lte(st, env, args),\n        \">=\" => prim_gte(st, env, args),\n        \"sin\" => prim_sin(st, env, args),\n        \"cos\" => prim_cos(st, env, args),\n        \"tan\" => prim_tan(st, env, args),\n        \"sinh\" => prim_sinh(st, env, args),\n        \"cosh\" => prim_cosh(st, env, args),\n        \"tanh\" => prim_tanh(st, env, args),\n        \"arcsin\" => prim_asin(st, env, args),\n        \"arccos\" => prim_acos(st, env, args),\n        \"arctan\" => prim_atan(st, env, args),\n        \"arcsinh\" => prim_asinh(st, env, args),\n        \"arccosh\" => prim_acosh(st, env, args),\n        \"arctanh\" => prim_atanh(st, env, args),\n        \"exp\" => prim_exp(st, env, args),\n        \"log\" => prim_log(st, env, args),\n\n        // io\n        \"write\" => prim_write(st, env, args),\n        \"read\" => prim_read(st, env, args),\n        \"parse\" => prim_parse(st, env, args),\n        \"load\" => prim_load(st, env, args),\n\n        // os\n        \"cd!\" => prim_cd(st, env, args),\n        \"pwd\" => prim_pwd(st, env, args),\n        \"exit!\" => prim_exit(st, env, args),\n        \"now\" => prim_now(st, env, args),\n        \"time\" => form_time(st, env, args),\n\n        _ => return None,\n    };\n    Some(r)\n}\n\n#[allow(dead_code)]\nfn clone_tsp(st: &Tsp) -> Tsp {\n    Tsp {\n        file: st.file.clone(),\n        filec: st.filec,\n        none: val_clone(&st.none),\n        nil: val_clone(&st.nil),\n        t: val_clone(&st.t),\n        env: rec_clone(&st.env),\n        strs: rec_clone(&st.strs),\n        syms: rec_clone(&st.syms),\n        libh: Vec::new(),\n        libhc: st.libhc,\n    }\n}\n\npub fn tisp_eval(st: &mut Tsp, v: Val) -> Option<Val> {\n    match v.t {\n        TspType::TspSym => {\n            let key = if let ValUnion::S(ref s) = v.v {\n                s.clone()\n            } else {\n                return None;\n            };\n            rec_get(&st.env, &key)\n        }\n        TspType::TspPair => {\n            let (car_v, cdr_v) = if let ValUnion::P { car, cdr } = v.v {\n                (*car, *cdr)\n            } else {\n                return None;\n            };\n            let f = tisp_eval(st, car_v)?;\n            let mut env = rec_clone(&st.env);\n            eval_proc(st, &mut env, f, cdr_v)\n        }\n        _ => Some(v),\n    }\n}\n\npub fn mk_func(t: TspType, name: &str, args: Val, body: Val, env: Rec) -> Option<Val> {\n    Some(Val {\n        t,\n        v: ValUnion::F {\n            name: name.to_string(),\n            args: Box::new(args),\n            body: Box::new(body),\n            env,\n        },\n    })\n}\n\npub fn rec_grow(rec: &mut Rec) {\n    let ocap = rec.cap as usize;\n    let new_cap = ocap.saturating_mul(TSP_REC_FACTOR).max(1);\n    let mut new_items: Vec<Entry> = Vec::with_capacity(new_cap);\n    for _ in 0..new_cap {\n        new_items.push(Entry {\n            key: String::new(),\n            val: val_make_nil(),\n        });\n    }\n    let old_items = std::mem::replace(&mut rec.items, new_items);\n    rec.cap = new_cap as i32;\n    rec.size = 0;\n    for e in old_items {\n        if !e.key.is_empty() {\n            rec_add(rec, &e.key.clone(), e.val);\n        }\n    }\n}\n","numLines":1590,"startLine":1,"totalLines":1590}}}
