     return CardRank::InvalidRank;\n53\t        }\n54\t\n55\t        hand.iterate_hand(length_trimmer);\n56\t        hand.get_max_rank_of_hand()\n57\t    }\n58\t\n59\t    pub fn simulate_razz_game<T>(decided_cards: &DecidedCards, game_count: u64, arg: &mut T, listener: RankListener<T>) -> i32 {\n60\t        let mut my_hand = match CardHand::create_hand(RAZZ_CARD_IN_HAND_COUNT, sort_card_by_rank) {\n61\t            Some(h) => h,\n62\t            None => return 1,\n63\t        };\n64\t\n65\t        for _ in 0..game_count {\n66\t            let mut deck = match CardDeck::create_shuffled_deck() {\n67\t                Some(d) => d,\n68\t                None => return 1,\n69\t            };\n70\t            strip_deck(&mut deck, decided_cards);\n71\t            complete_hand(&mut my_hand, decided_cards, &mut deck);\n72\t            let r = get_razz_rank(&mut my_hand);\n73\t            listener(arg, r);\n74\t            my_hand.reset_hand();\n75\t        }\n76\t        0\n77\t    }\n78\t\n79\t    pub fn strip_deck(deck: &mut CardDeck, decided_cards: &DecidedCards) {\n80\t        let end = decided_cards.my_card_count as usize;\n81\t        for i in 0..end {\n82\t            if let Some(card) = decided_cards.my_cards[i].as_ref() {\n83\t                deck.strip_card_from_deck(card.get_card_suit_rank());\n84\t            }\n85\t        }\n86\t        let end = decided_cards.opponent_card_count as usize;\n87\t        for i in 0..end {\n88\t            if let Some(card) = decided_cards.opponent_cards[i].as_ref() {\n89\t                deck.strip_card_from_deck(card.get_card_suit_rank());\n90\t            }\n91\t        }\n92\t    }\n93\t\n94\t    pub fn complete_hand(my_hand: &mut CardHand, decided_cards: &DecidedCards, deck: &mut CardDeck) {\n95\t        let end = decided_cards.my_card_count as usize;\n96\t        for i in 0..end {\n97\t            my_hand.insert_into_hand(&decided_cards.my_cards[i]);\n98\t        }\n99\t        let end = (RAZZ_CARD_IN_HAND_COUNT as usize) - end;\n100\t        for _ in 0..end {\n101\t            let dealt = deck.deal_from_deck();\n102\t            my_hand.insert_into_hand(&dealt);\n103\t        }\n104\t    }\n105\t}\n106\t"}]},"parent_tool_use_id":null,"session_id":"0efaac39-4bbc-40bb-a5d7-f1ad2c3a8ce3","uuid":"2db99f30-cb84-4761-a0e6-23203e59555f","timestamp":"2026-05-29T19:05:11.867Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-J46LBx/project/src/razz_simulation.rs","content":"use crate::card::card::{Card, CardDeck, CardHand, CardRank};\npub mod razz_simulation {\n    use super::*;\n    use crate::card::card::{sort_card_by_rank, ItrAction};\n    use std::cell::Cell;\n\n    pub struct DecidedCards {\n        pub my_card_count: u8,\n        pub my_cards: [Option<Card>; 3],\n        pub opponent_card_count: u8,\n        pub opponent_cards: [Option<Card>; 7],\n    }\n    pub type RankListener<T> = fn(&mut T, CardRank);\n\n    const RAZZ_CARD_IN_HAND_COUNT: u8 = 7;\n\n    thread_local! {\n        static PREV_RANK: Cell<CardRank> = Cell::new(CardRank::InvalidRank);\n    }\n\n    fn duplicated_rank_remover(_len: u64, pos: u64, c: &Option<Card>) -> ItrAction {\n        let curr_rank = match c {\n            Some(card) => card.get_card_rank(),\n            None => return ItrAction::Continue,\n        };\n        if pos == 0 {\n            PREV_RANK.with(|p| p.set(curr_rank));\n            return ItrAction::Continue;\n        }\n        let prev = PREV_RANK.with(|p| p.get());\n        if prev == curr_rank {\n            return ItrAction::RemoveAndContinue;\n        }\n        PREV_RANK.with(|p| p.set(curr_rank));\n        ItrAction::Continue\n    }\n\n    fn length_trimmer(_len: u64, pos: u64, _c: &Option<Card>) -> ItrAction {\n        if pos >= 5 {\n            ItrAction::RemoveAndContinue\n        } else {\n            ItrAction::Continue\n        }\n    }\n\n    fn get_razz_rank(hand: &mut CardHand) -> CardRank {\n        PREV_RANK.with(|p| p.set(CardRank::InvalidRank));\n        hand.iterate_hand(duplicated_rank_remover);\n\n        let cards_count = hand.count_cards_in_hand();\n        if cards_count < 5 {\n            return CardRank::InvalidRank;\n        }\n\n        hand.iterate_hand(length_trimmer);\n        hand.get_max_rank_of_hand()\n    }\n\n    pub fn simulate_razz_game<T>(decided_cards: &DecidedCards, game_count: u64, arg: &mut T, listener: RankListener<T>) -> i32 {\n        let mut my_hand = match CardHand::create_hand(RAZZ_CARD_IN_HAND_COUNT, sort_card_by_rank) {\n            Some(h) => h,\n            None => return 1,\n        };\n\n        for _ in 0..game_count {\n            let mut deck = match CardDeck::create_shuffled_deck() {\n                Some(d) => d,\n                None => return 1,\n            };\n            strip_deck(&mut deck, decided_cards);\n            complete_hand(&mut my_hand, decided_cards, &mut deck);\n            let r = get_razz_rank(&mut my_hand);\n            listener(arg, r);\n            my_hand.reset_hand();\n        }\n        0\n    }\n\n    pub fn strip_deck(deck: &mut CardDeck, decided_cards: &DecidedCards) {\n        let end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            if let Some(card) = decided_cards.my_cards[i].as_ref() {\n                deck.strip_card_from_deck(card.get_card_suit_rank());\n            }\n        }\n        let end = decided_cards.opponent_card_count as usize;\n        for i in 0..end {\n            if let Some(card) = decided_cards.opponent_cards[i].as_ref() {\n                deck.strip_card_from_deck(card.get_card_suit_rank());\n            }\n        }\n    }\n\n    pub fn complete_hand(my_hand: &mut CardHand, decided_cards: &DecidedCards, deck: &mut CardDeck) {\n        let end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            my_hand.insert_into_hand(&decided_cards.my_cards[i]);\n        }\n        let end = (RAZZ_CARD_IN_HAND_COUNT as usize) - end;\n        for _ in 0..end {\n            let dealt = deck.deal_from_deck();\n            my_hand.insert_into_hand(&dealt);\n        }\n    }\n}\n","numLines":106,"startLine":1,"totalLines":106}}}
