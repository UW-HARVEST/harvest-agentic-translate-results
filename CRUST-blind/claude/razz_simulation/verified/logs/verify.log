               &mut self.cards,\n382\t                CardCollection { prev: None, next: None, c: None },\n383\t            );\n384\t            let mut cards: Vec<Card> = collection_to_vec(old);\n385\t\n386\t            let mut pos: u64 = 0;\n387\t            let mut i: usize = 0;\n388\t            let mut stopped = false;\n389\t            while !stopped && i < cards.len() {\n390\t                let len = cards.len() as u64;\n391\t                let c_opt: Option<Card> = Some(cards[i]);\n392\t                let action = itr_fn(len, pos, &c_opt);\n393\t                match action {\n394\t                    ItrAction::Continue => {\n395\t                        i += 1;\n396\t                        pos += 1;\n397\t                    }\n398\t                    ItrAction::Break => {\n399\t                        stopped = true;\n400\t                        pos += 1;\n401\t                    }\n402\t                    ItrAction::RemoveAndContinue => {\n403\t                        cards.remove(i);\n404\t                        // pos stays the same per the C semantics.\n405\t                        pos += 1;\n406\t                        // i stays the same — next element shifts into place.\n407\t                    }\n408\t                    ItrAction::RemoveAndBreak => {\n409\t                        cards.remove(i);\n410\t                        stopped = true;\n411\t                        pos += 1;\n412\t                    }\n413\t                }\n414\t            }\n415\t\n416\t            self.len = cards.len() as u8;\n417\t            self.cards = vec_to_collection(cards);\n418\t        }\n419\t        pub fn remove_from_hand(&mut self, c: CardSuitRank) {\n420\t            let old = std::mem::replace(\n421\t                &mut self.cards,\n422\t                CardCollection { prev: None, next: None, c: None },\n423\t            );\n424\t            let cards = collection_to_vec(old);\n425\t            let filtered: Vec<Card> = cards\n426\t      