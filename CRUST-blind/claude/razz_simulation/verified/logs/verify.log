dSuitRank::InvalidCard;\n141\t            }\n142\t            let suit_index = match cs {\n143\t                CardSuit::Spade => 0usize,\n144\t                CardSuit::Heart => 1,\n145\t                CardSuit::Diamond => 2,\n146\t                CardSuit::Club => 3,\n147\t                _ => return CardSuitRank::InvalidCard,\n148\t            };\n149\t            let rank_index = rank_index(cr);\n150\t            csr_from_index(suit_index * 13 + rank_index)\n151\t        }\n152\t        pub fn get_card_rank(&self) -> CardRank {\n153\t            let r = (self.card as u32) & RANK_BITS;\n154\t            if r < ACE_BITS || r > K_BITS {\n155\t                return CardRank::InvalidRank;\n156\t            }\n157\t            rank_from_index((r - 1) as usize)\n158\t        }\n159\t        pub fn get_card_suit(&self) -> CardSuit {\n160\t            let s = (self.card as u32) & SUIT_BITS;\n161\t            if s < SPADE_BITS || s > CLUB_BITS {\n162\t                return CardSuit::InvalidSuit;\n163\t            }\n164\t            match (s >> 5) - 1 {\n165\t                0 => CardSuit::Spade,\n166\t                1 => CardSuit::Heart,\n167\t                2 => CardSuit::Diamond,\n168\t                3 => CardSuit::Club,\n169\t                _ => CardSuit::InvalidSuit,\n170\t            }\n171\t        }\n172\t        pub fn create_card(csr: CardSuitRank) -> Option<Self> {\n173\t            let c = Card::write_card(csr);\n174\t            if (c.card as u32) == INVALID_CARD_BITS {\n175\t                return None;\n176\t            }\n177\t            Some(c)\n178\t        }\n179\t        pub fn strtocard(str: &str) -> Option<Self> {\n180\t            let bytes = str.as_bytes();\n181\t            if bytes.len() != 2 {\n182\t                return None;\n183\t            }\n184\t            let suit_base: usize = match (bytes[0] as char).to_ascii_uppercase() {\n185\t                'S' => 0,\n186\t                'H' => 13,\n187\t                'D' => 26,\n188\