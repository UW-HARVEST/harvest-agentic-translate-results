{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019gHo7wA2vGXSbexZU9BWxY","type":"tool_result","content":"1\t/// A custom binary heap that stores elements in a Vec and uses a custom comparator.\n2\tpub struct Heap<T> {\n3\t    data: Vec<T>,\n4\t    comparator: Box<dyn Fn(&T, &T) -> bool>,\n5\t}\n6\timpl<T> Heap<T> {\n7\t    /// Creates a new heap with the given initial capacity and comparator.\n8\t    pub fn new(init_size: usize, comparator: impl Fn(&T, &T) -> bool + 'static) -> Self {\n9\t        Self {\n10\t            data: Vec::with_capacity(init_size),\n11\t            comparator: Box::new(comparator),\n12\t        }\n13\t    }\n14\t    /// Returns true if the heap is empty.\n15\t    pub fn is_empty(&self) -> bool {\n16\t        self.data.is_empty()\n17\t    }\n18\t    /// Returns a reference to the minimum element (if any).\n19\t    pub fn find_min(&self) -> Option<&T> {\n20\t        self.data.first()\n21\t    }\n22\t    /// Inserts an element into the heap.\n23\t    pub fn insert(&mut self, element: T) {\n24\t        self.data.push(element);\n25\t        let mut son = self.data.len() - 1;\n26\t        while son > 0 {\n27\t            let parent = (son - 1) / 2;\n28\t            if (self.comparator)(&self.data[son], &self.data[parent]) {\n29\t                self.data.swap(son, parent);\n30\t                son = parent;\n31\t            } else {\n32\t                break;\n33\t            }\n34\t        }\n35\t    }\n36\t    /// Removes and returns the minimum element, or None if empty.\n37\t    pub fn delete_min(&mut self) -> Option<T> {\n38\t        if self.data.is_empty() {\n39\t            return None;\n40\t        }\n41\t        let last = self.data.len() - 1;\n42\t        self.data.swap(0, last);\n43\t        let min = self.data.pop();\n44\t        // Sift down from the root\n45\t        let n = self.data.len();\n46\t        if n > 0 {\n47\t            let mut parent = 0usize;\n48\t            loop {\n49\t                let son1 = 2 * parent + 1;\n50\t                let son2 = 2 * parent + 2;\n51\t                if son1 >= n {\n52\t                    break;\n53\t                }\n54\t                let son = if son2 < n {\n55\t                    if (self.comparator)(&self.data[son1], &self.data[son2]) {\n56\t                        son1\n57\t                    } else {\n58\t                        son2\n59\t                    }\n60\t                } else {\n61\t                    son1\n62\t                };\n63\t                if (self.comparator)(&self.data[son], &self.data[parent]) {\n64\t                    self.data.swap(parent, son);\n65\t                }\n66\t                parent = son;\n67\t            }\n68\t        }\n69\t        min\n70\t    }\n71\t}\n72\t"}]},"parent_tool_use_id":null,"session_id":"1bf0065a-75ed-4a52-851a-af56010fb3aa","uuid":"9e118cbd-d889-4139-9398-99225d98fc72","timestamp":"2026-05-29T19:20:55.131Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-X3feK2/project/src/heap.rs","content":"/// A custom binary heap that stores elements in a Vec and uses a custom comparator.\npub struct Heap<T> {\n    data: Vec<T>,\n    comparator: Box<dyn Fn(&T, &T) -> bool>,\n}\nimpl<T> Heap<T> {\n    /// Creates a new heap with the given initial capacity and comparator.\n    pub fn new(init_size: usize, comparator: impl Fn(&T, &T) -> bool + 'static) -> Self {\n        Self {\n            data: Vec::with_capacity(init_size),\n            comparator: Box::new(comparator),\n        }\n    }\n    /// Returns true if the heap is empty.\n    pub fn is_empty(&self) -> bool {\n        self.data.is_empty()\n    }\n    /// Returns a reference to the minimum element (if any).\n    pub fn find_min(&self) -> Option<&T> {\n        self.data.first()\n    }\n    /// Inserts an element into the heap.\n    pub fn insert(&mut self, element: T) {\n        self.data.push(element);\n        let mut son = self.data.len() - 1;\n        while son > 0 {\n            let parent = (son - 1) / 2;\n            if (self.comparator)(&self.data[son], &self.data[parent]) {\n                self.data.swap(son, parent);\n                son = parent;\n            } else {\n                break;\n            }\n        }\n    }\n    /// Removes and returns the minimum element, or None if empty.\n    pub fn delete_min(&mut self) -> Option<T> {\n        if self.data.is_empty() {\n            return None;\n        }\n        let last = self.data.len() - 1;\n        self.data.swap(0, last);\n        let min = self.data.pop();\n        // Sift down from the root\n        let n = self.data.len();\n        if n > 0 {\n            let mut parent = 0usize;\n            loop {\n                let son1 = 2 * parent + 1;\n                let son2 = 2 * parent + 2;\n                if son1 >= n {\n                    break;\n                }\n                let son = if son2 < n {\n                    if (self.comparator)(&self.data[son1], &self.data[son2]) {\n                        son1\n                    } else {\n                        son2\n                    }\n                } else {\n                    son1\n                };\n                if (self.comparator)(&self.data[son], &self.data[parent]) {\n                    self.data.swap(parent, son);\n                }\n                parent = son;\n            }\n        }\n        min\n    }\n}\n","numLines":72,"startLine":1,"totalLines":72}}}
