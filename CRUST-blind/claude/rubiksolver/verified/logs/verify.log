acent_cw(%d,%d)=%d\\n\", f, a, adjacent_cw2(f, a));\n    }\n  }\n  // ----- adjacent_ccw -----\n  printf(\"=== adjacent_ccw ===\\n\");\n  for(color f = 0; f <= 5; f++) {\n    for(color a = 0; a <= 5; a++) {\n      if(a == REAR(f)) continue;\n      printf(\"adjacent_ccw(%d,%d)=%d\\n\", f, a, adjacent_ccw2(f, a));\n    }\n  }\n  // ----- adjacent_left/right -----\n  printf(\"=== adjacent_left ===\\n\");\n  for(color f = 0; f <= 5; f++) {\n    for(color a = 0; a <= 5; a++) {\n      printf(\"adjacent_left(%d,%d)=%d\\n\", f, a, adjacent_left2(f, a));\n    }\n  }\n  printf(\"=== adjacent_right ===\\n\");\n  for(color f = 0; f <= 5; f++) {\n    for(color a = 0; a <= 5; a++) {\n      printf(\"adjacent_right(%d,%d)=%d\\n\", f, a, adjacent_right2(f, a));\n    }\n  }\n\n  // ----- populate_initial -----\n  cube_t solved = populate_initial();\n  print_cube_data(solved, \"populate_initial\");\n  printf(\"solved.entropy=%d hash=%u\\n\", find_entropy(solved), cube_hash(solved));\n\n  // ----- ecube_init -----\n  ecube_t ecube = ecube_init(populate_initial());\n  printf(\"ecube solved entropy=%d hash=%d\\n\", ecube->entropy, ecube->hash);\n\n  // ----- rotate_face on solved cube, every face / direction -----\n  for(color f = 0; f <= 5; f++) {\n    for(int dir = 0; dir <= 1; dir++) {\n      cube_t c = new_cube_rotate_face(solved, f, dir);\n      printf(\"rotate face=%d dir=%d entropy=%d hash=%u\\n\", f, dir, find_entropy(c), cube_hash(c));\n      char label[100];\n      sprintf(label, \"rotate_face=%d dir=%d\", f, dir);\n      print_cube_data(c, label);\n      cube_free(c);\n    }\n  }\n\n  // ----- 4x same direction = identity for each face -----\n  for(color f = 0; f <= 5; f++) {\n    cube_t c = cube_clone(solved);\n    rotate_face(c, f, CW);\n    rotate_face(c, f, CW);\n    rotate_face(c, f, CW);\n    rotate_face(c, f, CW);\n    printf(\"4xCW face=%d equal_solved=%d\\n\", f, cube_compare_equal(c, solved));\n    cube_free(c);\n    c = cube_clone(solved);\n    rotate_face(c, f, CCW