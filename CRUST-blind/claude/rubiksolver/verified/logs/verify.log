{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015cSzyS7SaamTkK7FJn8KQG","type":"tool_result","content":"1\t/// A simple hash table using a vector of buckets.\n2\t/// The table uses a provided hash function (which returns a u32)\n3\t/// and a caller‑supplied equality function for comparing elements.\n4\tpub struct Hash<T> {\n5\t    buckets: Vec<Vec<T>>,\n6\t    hash_function: Box<dyn Fn(&T) -> u32>,\n7\t    max_key: u32,\n8\t}\n9\timpl<T> Hash<T> {\n10\t    /// Create a new hash table with `max_key` buckets.\n11\t    /// The `hash_function` is used to compute a hash for each element.\n12\t    pub fn new(max_key: u32, hash_function: impl Fn(&T) -> u32 + 'static) -> Self {\n13\t        let mut buckets: Vec<Vec<T>> = Vec::with_capacity((max_key as usize) + 1);\n14\t        for _ in 0..=(max_key as usize) {\n15\t            buckets.push(Vec::new());\n16\t        }\n17\t        Hash {\n18\t            buckets,\n19\t            hash_function: Box::new(hash_function),\n20\t            max_key,\n21\t        }\n22\t    }\n23\t    /// Inserts an element if no equal element exists (using the provided compare_equal).\n24\t    /// Returns true if the element was inserted.\n25\t    pub fn insert(&mut self, element: T, _compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n26\t        let ix = (self.hash_function)(&element);\n27\t        assert!(ix <= self.max_key);\n28\t        self.buckets[ix as usize].push(element);\n29\t        true\n30\t    }\n31\t    /// Returns true if an element equal (per compare_equal) to `element` exists.\n32\t    pub fn element_exists(&self, element: &T, compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n33\t        let ix = (self.hash_function)(element);\n34\t        assert!(ix <= self.max_key);\n35\t        for e in &self.buckets[ix as usize] {\n36\t            if compare_equal(e, element) {\n37\t                return true;\n38\t            }\n39\t        }\n40\t        false\n41\t    }\n42\t    /// Deletes an element (using compare_equal) from the hash table.\n43\t    /// Returns true if the element was found and removed.\n44\t    pub fn delete(&mut self, element: &T, compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n45\t        let ix = (self.hash_function)(element);\n46\t        assert!(ix <= self.max_key);\n47\t        let bucket = &mut self.buckets[ix as usize];\n48\t        for i in 0..bucket.len() {\n49\t            if compare_equal(&bucket[i], element) {\n50\t                bucket.remove(i);\n51\t                return true;\n52\t            }\n53\t        }\n54\t        false\n55\t    }\n56\t}\n57\t"}]},"parent_tool_use_id":null,"session_id":"1bf0065a-75ed-4a52-851a-af56010fb3aa","uuid":"f7b2560e-1e05-4973-8365-b9a8b62484c4","timestamp":"2026-05-29T19:20:47.586Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-X3feK2/project/src/hash.rs","content":"/// A simple hash table using a vector of buckets.\n/// The table uses a provided hash function (which returns a u32)\n/// and a caller‑supplied equality function for comparing elements.\npub struct Hash<T> {\n    buckets: Vec<Vec<T>>,\n    hash_function: Box<dyn Fn(&T) -> u32>,\n    max_key: u32,\n}\nimpl<T> Hash<T> {\n    /// Create a new hash table with `max_key` buckets.\n    /// The `hash_function` is used to compute a hash for each element.\n    pub fn new(max_key: u32, hash_function: impl Fn(&T) -> u32 + 'static) -> Self {\n        let mut buckets: Vec<Vec<T>> = Vec::with_capacity((max_key as usize) + 1);\n        for _ in 0..=(max_key as usize) {\n            buckets.push(Vec::new());\n        }\n        Hash {\n            buckets,\n            hash_function: Box::new(hash_function),\n            max_key,\n        }\n    }\n    /// Inserts an element if no equal element exists (using the provided compare_equal).\n    /// Returns true if the element was inserted.\n    pub fn insert(&mut self, element: T, _compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n        let ix = (self.hash_function)(&element);\n        assert!(ix <= self.max_key);\n        self.buckets[ix as usize].push(element);\n        true\n    }\n    /// Returns true if an element equal (per compare_equal) to `element` exists.\n    pub fn element_exists(&self, element: &T, compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n        let ix = (self.hash_function)(element);\n        assert!(ix <= self.max_key);\n        for e in &self.buckets[ix as usize] {\n            if compare_equal(e, element) {\n                return true;\n            }\n        }\n        false\n    }\n    /// Deletes an element (using compare_equal) from the hash table.\n    /// Returns true if the element was found and removed.\n    pub fn delete(&mut self, element: &T, compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n        let ix = (self.hash_function)(element);\n        assert!(ix <= self.max_key);\n        let bucket = &mut self.buckets[ix as usize];\n        for i in 0..bucket.len() {\n            if compare_equal(&bucket[i], element) {\n                bucket.remove(i);\n                return true;\n            }\n        }\n        false\n    }\n}\n","numLines":57,"startLine":1,"totalLines":57}}}
