teger_part * castom_exp((exp - (div as f64)) * castom_log(b)) * flag\n    }\n}\n\npub fn castom_abs(x: i32) -> i32 {\n    if x > 0 {\n        x\n    } else {\n        -x\n    }\n}\n\npub fn castom_log(x: f64) -> f64 {\n    let mut a: u32 = 0;\n    let mut b: f64 = 0.0;\n    if x > 0.0 {\n        let mut c: f64 = if x < 1.0 { 1.0 / x } else { x };\n        loop {\n            c /= S21_M_E;\n            if c <= 1.0 {\n                break;\n            }\n            a += 1;\n        }\n        // After the loop in C, c has been divided one extra time\n        // C: for (c = ((x < 1.0) ? 1 / x : x); (c /= S21_M_E) > 1; ++a) {}\n        // This: divides c, checks if > 1, if so increments a, then loops.\n        // When the check fails (c <= 1), it has divided c but not incremented a.\n        c = 1.0 / (c * S21_M_E - 1.0);\n        c = c + c + 1.0;\n        let f = c * c;\n        b = 0.0;\n        let mut d: u32 = 1;\n        c /= 2.0;\n        loop {\n            let e = b;\n            b += 1.0 / ((d as f64) * c);\n            if b - e == 0.0 {\n                break;\n            }\n            d += 2;\n            c *= f;\n        }\n    } else {\n        // x <= 0\n        if x == 0.0 {\n            b = f64::NEG_INFINITY;\n        } else {\n            b = f64::NAN;\n        }\n    }\n    if x < 1.0 {\n        -((a as f64) + b)\n    } else {\n        (a as f64) + b\n    }\n}\n\npub fn castom_sin(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut sum: f64 = 0.0;\n    for i in 0..=20i32 {\n        let mut fa: f64 = 1.0;\n        let mut pw: f64 = 1.0;\n        let limit = 2 * i + 1;\n        for j in 1..=limit {\n            fa *= j as f64;\n            pw *= x;\n        }\n        let sign = if i % 2 != 0 { -1.0 } else { 1.0 };\n        sum += (sign / fa) * pw;\n    }\n    sum\n}\n\npub fn castom_cos(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut t_s: f64 = 0.0;\n    let mut last: f64 = 1.0;\n    let mut k: i32 