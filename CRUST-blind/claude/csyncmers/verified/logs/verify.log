mer_position, (unsigned long long)results[i].minimizer_hash);\n50\t        }\n51\t\n52\t        // Compute closed syncmers using the naive method\n53\t        int num_naive_results;\n54\t        MinimizerResult naive_results[10000];\n55\t        compute_closed_syncmers_naive(sequence, strlen(sequence), a, b, naive_results, &num_naive_results);\n56\t\n57\t        printf(\"\\nClosed Syncmers (Naive):\\n\");\n58\t        printf(\"%-20s %-20s\\n\", \"Position\", \"Minimizer Hash\");\n59\t        for (int i = 0; i < num_naive_results; i++) {\n60\t            printf(\"%-20zu %-20llu\\n\", naive_results[i].kmer_position, (unsigned long long)naive_results[i].minimizer_hash);\n61\t        }\n62\t\n63\t        // Compare the results\n64\t        if (num_results != num_naive_results) {\n65\t            printf(\"\\nMismatch in number of closed syncmers: %d (original) vs %d (naive)\\n\", num_results, num_naive_results);\n66\t            return 1;\n67\t        } else {\n68\t            printf(\"\\nNumber of closed syncmers matches: %d\\n\", num_results);\n69\t        }\n70\t\n71\t        // Compare each result\n72\t        int mismatch = 0;\n73\t        for (int i = 0; i < num_results; i++) {\n74\t            if (results[i].kmer_position != naive_results[i].kmer_position ||\n75\t                results[i].minimizer_hash != naive_results[i].minimizer_hash) {\n76\t                printf(\"Mismatch at index %d:\\n\", i);\n77\t                printf(\"  Original -> Position: %zu, Hash: %llu\\n\",\n78\t                       results[i].kmer_position, (unsigned long long)results[i].minimizer_hash);\n79\t                printf(\"  Naive    -> Position: %zu, Hash: %llu\\n\",\n80\t                       naive_results[i].kmer_position, (unsigned long long)naive_results[i].minimizer_hash);\n81\t                mismatch = 1;\n82\t                break;\n83\t            }\n84\t        }\n85\t        if (mismatch) {\n86\t            printf(\"Test %d failed.\\n\", test);\n87\t            return