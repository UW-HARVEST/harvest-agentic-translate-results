{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0177V3b6rLzCyin3K1tAu8Kf","type":"tool_result","content":"1\tuse crate::{common, config, hash_table};\n2\tuse std::cell::RefCell;\n3\t\n4\tpub const SIZE: usize = 122;\n5\t\n6\tthread_local! {\n7\t    static REDUCTION_ORDER: RefCell<config::reduction_order_t> =\n8\t        RefCell::new(config::reduction_order_t::APPLICATIVE);\n9\t}\n10\t\n11\tfn current_order() -> config::reduction_order_t {\n12\t    REDUCTION_ORDER.with(|c| match *c.borrow() {\n13\t        config::reduction_order_t::APPLICATIVE => {\n14\t            config::reduction_order_t::APPLICATIVE\n15\t        }\n16\t        config::reduction_order_t::NORMAL => config::reduction_order_t::NORMAL,\n17\t    })\n18\t}\n19\t\n20\tfn is_applicative() -> bool {\n21\t    REDUCTION_ORDER.with(|c| {\n22\t        matches!(*c.borrow(), config::reduction_order_t::APPLICATIVE)\n23\t    })\n24\t}\n25\t\n26\tpub fn set_reduction_order(t: config::reduction_order_t) {\n27\t    REDUCTION_ORDER.with(|c| {\n28\t        *c.borrow_mut() = t;\n29\t    });\n30\t}\n31\t\n32\tpub fn print_reduction_order(t: config::reduction_order_t) {\n33\t    match t {\n34\t        config::reduction_order_t::APPLICATIVE => print!(\"Applicative\"),\n35\t        config::reduction_order_t::NORMAL => print!(\"Normal\"),\n36\t    }\n37\t    println!();\n38\t}\n39\t\n40\tpub fn reduce(\n41\t    table: &mut hash_table::HashTable,\n42\t    n: &common::AstNode,\n43\t) -> common::AstNode {\n44\t    let mut copy = deepcopy(n);\n45\t    expand_definitions(table, &mut copy);\n46\t    reduce_ast(table, &copy)\n47\t}\n48\t\n49\tpub fn expand_definitions(\n50\t    table: &mut hash_table::HashTable,\n51\t    n: &mut common::AstNode,\n52\t) {\n53\t    match &mut n.node {\n54\t        common::AstNodeUnion::LambdaExpr(lambda) => {\n55\t            if let Some(body) = &mut lambda.body {\n56\t                expand_definitions(table, body);\n57\t            }\n58\t        }\n59\t        common::AstNodeUnion::Application(app) => {\n60\t            if let Some(f) = &mut app.function {\n61\t                expand_definitions(table, f);\n62\t            }\n63\t            if let Some(a) = &mut app.argument {\n64\t                expand_definitions(table, a);\n65\t            }\n66\t        }\n67\t        common::AstNodeUnion::Variable(_) => {\n68\t            if matches!(n.type_, common::AstNodeType::DEFINITION) {\n69\t                let def_name = match &n.node {\n70\t                    common::AstNodeUnion::Variable(v) => v.name.clone(),\n71\t                    _ => String::new(),\n72\t                };\n73\t                if let Some(expanded_def) = table.search(&def_name) {\n74\t                    let copied = deepcopy(expanded_def);\n75\t                    *n = copied;\n76\t                } else {\n77\t                    let msg = format!(\n78\t                        \"ERROR: Could not expand definition for {}\",\n79\t                        def_name\n80\t                    );\n81\t                    common::error(\n82\t                        &msg,\n83\t                        file!(),\n84\t                        line!() as i32,\n85\t                        \"expand_definitions\",\n86\t                    );\n87\t                }\n88\t            }\n89\t        }\n90\t    }\n91\t}\n92\t\n93\tpub fn replace(n: &mut common::AstNode, old: &str, new_name: &str) {\n94\t    match &mut n.node {\n95\t        common::AstNodeUnion::LambdaExpr(lambda) => {\n96\t            if lambda.parameter == old {\n97\t                lambda.parameter = new_name.to_string();\n98\t            }\n99\t            if let Some(body) = &mut lambda.body {\n100\t                replace(body, old, new_name);\n101\t            }\n102\t        }\n103\t        common::AstNodeUnion::Application(app) => {\n104\t            if let Some(f) = &mut app.function {\n105\t                replace(f, old, new_name);\n106\t            }\n107\t            if let Some(a) = &mut app.argument {\n108\t                replace(a, old, new_name);\n109\t            }\n110\t        }\n111\t        common::AstNodeUnion::Variable(var) => {\n112\t            if matches!(n.type_, common::AstNodeType::VAR) && var.name == old {\n113\t                var.name = new_name.to_string();\n114\t            }\n115\t        }\n116\t    }\n117\t}\n118\t\n119\tpub fn reduce_ast(\n120\t    table: &mut hash_table::HashTable,\n121\t    n: &common::AstNode,\n122\t) -> common::AstNode {\n123\t    match &n.node {\n124\t        common::AstNodeUnion::LambdaExpr(lambda) => {\n125\t            // Recursively reduce the body if applicative\n126\t            let new_body = if is_applicative() {\n127\t                if let Some(body) = &lambda.body {\n128\t                    Some(Box::new(reduce_ast(table, body)))\n129\t                } else {\n130\t                    None\n131\t                }\n132\t            } else if let Some(body) = &lambda.body {\n133\t                Some(Box::new(deepcopy(body)))\n134\t            } else {\n135\t                None\n136\t            };\n137\t            common::AstNode {\n138\t                type_: common::AstNodeType::LAMBDA_EXPR,\n139\t                node: common::AstNodeUnion::LambdaExpr(\n140\t                    common::LambdaExpression {\n141\t                        parameter: lambda.parameter.clone(),\n142\t                        type_: lambda.type_.clone(),\n143\t                        body: new_body,\n144\t                    },\n145\t                ),\n146\t            }\n147\t        }\n148\t        common::AstNodeUnion::Application(app) => {\n149\t            let function_default = common::AstNode::default();\n150\t            let argument_default = common::AstNode::default();\n151\t            let function_ref = app\n152\t                .function\n153\t                .as_deref()\n154\t                .unwrap_or(&function_default);\n155\t            let argument_ref = app\n156\t                .argument\n157\t                .as_deref()\n158\t                .unwrap_or(&argument_default);\n159\t\n160\t            let reduced_function = reduce_ast(table, function_ref);\n161\t\n162\t            let reduced_argument = if is_applicative() {\n163\t                reduce_ast(table, argument_ref)\n164\t            } else {\n165\t                deepcopy(argument_ref)\n166\t            };\n167\t\n168\t            if matches!(reduced_function.type_, common::AstNodeType::LAMBDA_EXPR) {\n169\t                if let common::AstNodeUnion::LambdaExpr(lambda) =\n170\t                    &reduced_function.node\n171\t                {\n172\t                    let param = lambda.parameter.clone();\n173\t                    let body_default = common::AstNode::default();\n174\t                    let body_ref =\n175\t                        lambda.body.as_deref().unwrap_or(&body_default);\n176\t                    let reduced =\n177\t                        substitute(body_ref, &param, &reduced_argument);\n178\t                    if is_applicative() {\n179\t                        return reduced;\n180\t                    }\n181\t                    return reduce_ast(table, &reduced);\n182\t                }\n183\t            }\n184\t            common::AstNode {\n185\t                type_: common::AstNodeType::APPLICATION,\n186\t                node: common::AstNodeUnion::Application(common::Application {\n187\t                    function: Some(Box::new(reduced_function)),\n188\t                    argument: Some(Box::new(reduced_argument)),\n189\t                }),\n190\t            }\n191\t        }\n192\t        common::AstNodeUnion::Variable(_) => deepcopy(n),\n193\t    }\n194\t}\n195\t\n196\tpub fn substitute(\n197\t    expression: &common::AstNode,\n198\t    variable: &str,\n199\t    replacement: &common::AstNode,\n200\t) -> common::AstNode {\n201\t    match &expression.node {\n202\t        common::AstNodeUnion::Variable(var) => {\n203\t            if matches!(expression.type_, common::AstNodeType::VAR)\n204\t                && var.name == variable\n205\t            {\n206\t                deepcopy(replacement)\n207\t            } else {\n208\t                deepcopy(expression)\n209\t            }\n210\t        }\n211\t        common::AstNodeUnion::LambdaExpr(lambda) => {\n212\t            let body_default = common::AstNode::default();\n213\t            let body_ref = lambda.body.as_deref().unwrap_or(&body_default);\n214\t            let new_body = substitute(body_ref, variable, replacement);\n215\t            if lambda.parameter != variable {\n216\t                common::AstNode {\n217\t                    type_: common::AstNodeType::LAMBDA_EXPR,\n218\t                    node: common::AstNodeUnion::LambdaExpr(\n219\t                        common::LambdaExpression {\n220\t                            parameter: lambda.parameter.clone(),\n221\t                            type_: lambda.type_.clone(),\n222\t                            body: Some(Box::new(new_body)),\n223\t                        },\n224\t                    ),\n225\t                }\n226\t            } else {\n227\t                // Strip the lambda - the parameter is being substituted away.\n228\t                new_body\n229\t            }\n230\t        }\n231\t        common::AstNodeUnion::Application(app) => {\n232\t            let function_default = common::AstNode::default();\n233\t            let argument_default = common::AstNode::default();\n234\t            let function_ref =\n235\t                app.function.as_deref().unwrap_or(&function_default);\n236\t            let argument_ref =\n237\t                app.argument.as_deref().unwrap_or(&argument_default);\n238\t            let new_function = substitute(function_ref, variable, replacement);\n239\t            let new_argument = substitute(argument_ref, variable, replacement);\n240\t            common::AstNode {\n241\t                type_: common::AstNodeType::APPLICATION,\n242\t                node: common::AstNodeUnion::Application(common::Application {\n243\t                    function: Some(Box::new(new_function)),\n244\t                    argument: Some(Box::new(new_argument)),\n245\t                }),\n246\t            }\n247\t        }\n248\t    }\n249\t}\n250\t\n251\tpub fn deepcopy(n: &common::AstNode) -> common::AstNode {\n252\t    match &n.node {\n253\t        common::AstNodeUnion::Variable(var) => {\n254\t            let mut copy = deepcopy_var(&var.name, &var.type_);\n255\t            // Preserve DEFINITION marker if present.\n256\t            if matches!(n.type_, common::AstNodeType::DEFINITION) {\n257\t                copy.type_ = common::AstNodeType::DEFINITION;\n258\t            }\n259\t            copy\n260\t        }\n261\t        common::AstNodeUnion::LambdaExpr(lambda) => {\n262\t            let body_default = common::AstNode::default();\n263\t            let body_ref = lambda.body.as_deref().unwrap_or(&body_default);\n264\t            deepcopy_lambda_expr(&lambda.parameter, body_ref, &lambda.type_)\n265\t        }\n266\t        common::AstNodeUnion::Application(app) => {\n267\t            let function_default = common::AstNode::default();\n268\t            let argument_default = common::AstNode::default();\n269\t            let function_ref =\n270\t                app.function.as_deref().unwrap_or(&function_default);\n271\t            let argument_ref =\n272\t                app.argument.as_deref().unwrap_or(&argument_default);\n273\t            deepcopy_application(function_ref, argument_ref)\n274\t        }\n275\t    }\n276\t}\n277\t\n278\tpub fn deepcopy_application(\n279\t    function: &common::AstNode,\n280\t    argument: &common::AstNode,\n281\t) -> common::AstNode {\n282\t    common::AstNode {\n283\t        type_: common::AstNodeType::APPLICATION,\n284\t        node: common::AstNodeUnion::Application(common::Application {\n285\t            function: Some(Box::new(deepcopy(function))),\n286\t            argument: Some(Box::new(deepcopy(argument))),\n287\t        }),\n288\t    }\n289\t}\n290\t\n291\tpub fn deepcopy_lambda_expr(\n292\t    parameter: &str,\n293\t    body: &common::AstNode,\n294\t    type_: &str,\n295\t) -> common::AstNode {\n296\t    common::AstNode {\n297\t        type_: common::AstNodeType::LAMBDA_EXPR,\n298\t        node: common::AstNodeUnion::LambdaExpr(common::LambdaExpression {\n299\t            parameter: parameter.to_string(),\n300\t            type_: type_.to_string(),\n301\t            body: Some(Box::new(deepcopy(body))),\n302\t        }),\n303\t    }\n304\t}\n305\t\n306\tpub fn deepcopy_var(name: &str, type_: &str) -> common::AstNode {\n307\t    common::AstNode {\n308\t        type_: common::AstNodeType::VAR,\n309\t        node: common::AstNodeUnion::Variable(common::Variable {\n310\t            name: name.to_string(),\n311\t            type_: type_.to_string(),\n312\t        }),\n313\t    }\n314\t}\n315\t\n316\t// `current_order` is unused publicly but useful for callers; suppress warnings.\n317\t#[allow(dead_code)]\n318\tfn _use_current_order() -> config::reduction_order_t {\n319\t    current_order()\n320\t}\n321\t"}]},"parent_tool_use_id":null,"session_id":"e1eef4ca-d0e7-4181-92e4-a94c7e6dba4b","uuid":"a3370058-7e3d-431c-843d-4deccb34aaf3","timestamp":"2026-05-29T18:16:20.370Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-PjQdnV/project/src/reducer.rs","content":"use crate::{common, config, hash_table};\nuse std::cell::RefCell;\n\npub const SIZE: usize = 122;\n\nthread_local! {\n    static REDUCTION_ORDER: RefCell<config::reduction_order_t> =\n        RefCell::new(config::reduction_order_t::APPLICATIVE);\n}\n\nfn current_order() -> config::reduction_order_t {\n    REDUCTION_ORDER.with(|c| match *c.borrow() {\n        config::reduction_order_t::APPLICATIVE => {\n            config::reduction_order_t::APPLICATIVE\n        }\n        config::reduction_order_t::NORMAL => config::reduction_order_t::NORMAL,\n    })\n}\n\nfn is_applicative() -> bool {\n    REDUCTION_ORDER.with(|c| {\n        matches!(*c.borrow(), config::reduction_order_t::APPLICATIVE)\n    })\n}\n\npub fn set_reduction_order(t: config::reduction_order_t) {\n    REDUCTION_ORDER.with(|c| {\n        *c.borrow_mut() = t;\n    });\n}\n\npub fn print_reduction_order(t: config::reduction_order_t) {\n    match t {\n        config::reduction_order_t::APPLICATIVE => print!(\"Applicative\"),\n        config::reduction_order_t::NORMAL => print!(\"Normal\"),\n    }\n    println!();\n}\n\npub fn reduce(\n    table: &mut hash_table::HashTable,\n    n: &common::AstNode,\n) -> common::AstNode {\n    let mut copy = deepcopy(n);\n    expand_definitions(table, &mut copy);\n    reduce_ast(table, &copy)\n}\n\npub fn expand_definitions(\n    table: &mut hash_table::HashTable,\n    n: &mut common::AstNode,\n) {\n    match &mut n.node {\n        common::AstNodeUnion::LambdaExpr(lambda) => {\n            if let Some(body) = &mut lambda.body {\n                expand_definitions(table, body);\n            }\n        }\n        common::AstNodeUnion::Application(app) => {\n            if let Some(f) = &mut app.function {\n                expand_definitions(table, f);\n            }\n            if let Some(a) = &mut app.argument {\n                expand_definitions(table, a);\n            }\n        }\n        common::AstNodeUnion::Variable(_) => {\n            if matches!(n.type_, common::AstNodeType::DEFINITION) {\n                let def_name = match &n.node {\n                    common::AstNodeUnion::Variable(v) => v.name.clone(),\n                    _ => String::new(),\n                };\n                if let Some(expanded_def) = table.search(&def_name) {\n                    let copied = deepcopy(expanded_def);\n                    *n = copied;\n                } else {\n                    let msg = format!(\n                        \"ERROR: Could not expand definition for {}\",\n                        def_name\n                    );\n                    common::error(\n                        &msg,\n                        file!(),\n                        line!() as i32,\n                        \"expand_definitions\",\n                    );\n                }\n            }\n        }\n    }\n}\n\npub fn replace(n: &mut common::AstNode, old: &str, new_name: &str) {\n    match &mut n.node {\n        common::AstNodeUnion::LambdaExpr(lambda) => {\n            if lambda.parameter == old {\n                lambda.parameter = new_name.to_string();\n            }\n            if let Some(body) = &mut lambda.body {\n                replace(body, old, new_name);\n            }\n        }\n        common::AstNodeUnion::Application(app) => {\n            if let Some(f) = &mut app.function {\n                replace(f, old, new_name);\n            }\n            if let Some(a) = &mut app.argument {\n                replace(a, old, new_name);\n            }\n        }\n        common::AstNodeUnion::Variable(var) => {\n            if matches!(n.type_, common::AstNodeType::VAR) && var.name == old {\n                var.name = new_name.to_string();\n            }\n        }\n    }\n}\n\npub fn reduce_ast(\n    table: &mut hash_table::HashTable,\n    n: &common::AstNode,\n) -> common::AstNode {\n    match &n.node {\n        common::AstNodeUnion::LambdaExpr(lambda) => {\n            // Recursively reduce the body if applicative\n            let new_body = if is_applicative() {\n                if let Some(body) = &lambda.body {\n                    Some(Box::new(reduce_ast(table, body)))\n                } else {\n                    None\n                }\n            } else if let Some(body) = &lambda.body {\n                Some(Box::new(deepcopy(body)))\n            } else {\n                None\n            };\n            common::AstNode {\n                type_: common::AstNodeType::LAMBDA_EXPR,\n                node: common::AstNodeUnion::LambdaExpr(\n                    common::LambdaExpression {\n                        parameter: lambda.parameter.clone(),\n                        type_: lambda.type_.clone(),\n                        body: new_body,\n                    },\n                ),\n            }\n        }\n        common::AstNodeUnion::Application(app) => {\n            let function_default = common::AstNode::default();\n            let argument_default = common::AstNode::default();\n            let function_ref = app\n                .function\n                .as_deref()\n                .unwrap_or(&function_default);\n            let argument_ref = app\n                .argument\n                .as_deref()\n                .unwrap_or(&argument_default);\n\n            let reduced_function = reduce_ast(table, function_ref);\n\n            let reduced_argument = if is_applicative() {\n                reduce_ast(table, argument_ref)\n            } else {\n                deepcopy(argument_ref)\n            };\n\n            if matches!(reduced_function.type_, common::AstNodeType::LAMBDA_EXPR) {\n                if let common::AstNodeUnion::LambdaExpr(lambda) =\n                    &reduced_function.node\n                {\n                    let param = lambda.parameter.clone();\n                    let body_default = common::AstNode::default();\n                    let body_ref =\n                        lambda.body.as_deref().unwrap_or(&body_default);\n                    let reduced =\n                        substitute(body_ref, &param, &reduced_argument);\n                    if is_applicative() {\n                        return reduced;\n                    }\n                    return reduce_ast(table, &reduced);\n                }\n            }\n            common::AstNode {\n                type_: common::AstNodeType::APPLICATION,\n                node: common::AstNodeUnion::Application(common::Application {\n                    function: Some(Box::new(reduced_function)),\n                    argument: Some(Box::new(reduced_argument)),\n                }),\n            }\n        }\n        common::AstNodeUnion::Variable(_) => deepcopy(n),\n    }\n}\n\npub fn substitute(\n    expression: &common::AstNode,\n    variable: &str,\n    replacement: &common::AstNode,\n) -> common::AstNode {\n    match &expression.node {\n        common::AstNodeUnion::Variable(var) => {\n            if matches!(expression.type_, common::AstNodeType::VAR)\n                && var.name == variable\n            {\n                deepcopy(replacement)\n            } else {\n                deepcopy(expression)\n            }\n        }\n        common::AstNodeUnion::LambdaExpr(lambda) => {\n            let body_default = common::AstNode::default();\n            let body_ref = lambda.body.as_deref().unwrap_or(&body_default);\n            let new_body = substitute(body_ref, variable, replacement);\n            if lambda.parameter != variable {\n                common::AstNode {\n                    type_: common::AstNodeType::LAMBDA_EXPR,\n                    node: common::AstNodeUnion::LambdaExpr(\n                        common::LambdaExpression {\n                            parameter: lambda.parameter.clone(),\n                            type_: lambda.type_.clone(),\n                            body: Some(Box::new(new_body)),\n                        },\n                    ),\n                }\n            } else {\n                // Strip the lambda - the parameter is being substituted away.\n                new_body\n            }\n        }\n        common::AstNodeUnion::Application(app) => {\n            let function_default = common::AstNode::default();\n            let argument_default = common::AstNode::default();\n            let function_ref =\n                app.function.as_deref().unwrap_or(&function_default);\n            let argument_ref =\n                app.argument.as_deref().unwrap_or(&argument_default);\n            let new_function = substitute(function_ref, variable, replacement);\n            let new_argument = substitute(argument_ref, variable, replacement);\n            common::AstNode {\n                type_: common::AstNodeType::APPLICATION,\n                node: common::AstNodeUnion::Application(common::Application {\n                    function: Some(Box::new(new_function)),\n                    argument: Some(Box::new(new_argument)),\n                }),\n            }\n        }\n    }\n}\n\npub fn deepcopy(n: &common::AstNode) -> common::AstNode {\n    match &n.node {\n        common::AstNodeUnion::Variable(var) => {\n            let mut copy = deepcopy_var(&var.name, &var.type_);\n            // Preserve DEFINITION marker if present.\n            if matches!(n.type_, common::AstNodeType::DEFINITION) {\n                copy.type_ = common::AstNodeType::DEFINITION;\n            }\n            copy\n        }\n        common::AstNodeUnion::LambdaExpr(lambda) => {\n            let body_default = common::AstNode::default();\n            let body_ref = lambda.body.as_deref().unwrap_or(&body_default);\n            deepcopy_lambda_expr(&lambda.parameter, body_ref, &lambda.type_)\n        }\n        common::AstNodeUnion::Application(app) => {\n            let function_default = common::AstNode::default();\n            let argument_default = common::AstNode::default();\n            let function_ref =\n                app.function.as_deref().unwrap_or(&function_default);\n            let argument_ref =\n                app.argument.as_deref().unwrap_or(&argument_default);\n            deepcopy_application(function_ref, argument_ref)\n        }\n    }\n}\n\npub fn deepcopy_application(\n    function: &common::AstNode,\n    argument: &common::AstNode,\n) -> common::AstNode {\n    common::AstNode {\n        type_: common::AstNodeType::APPLICATION,\n        node: common::AstNodeUnion::Application(common::Application {\n            function: Some(Box::new(deepcopy(function))),\n            argument: Some(Box::new(deepcopy(argument))),\n        }),\n    }\n}\n\npub fn deepcopy_lambda_expr(\n    parameter: &str,\n    body: &common::AstNode,\n    type_: &str,\n) -> common::AstNode {\n    common::AstNode {\n        type_: common::AstNodeType::LAMBDA_EXPR,\n        node: common::AstNodeUnion::LambdaExpr(common::LambdaExpression {\n            parameter: parameter.to_string(),\n            type_: type_.to_string(),\n            body: Some(Box::new(deepcopy(body))),\n        }),\n    }\n}\n\npub fn deepcopy_var(name: &str, type_: &str) -> common::AstNode {\n    common::AstNode {\n        type_: common::AstNodeType::VAR,\n        node: common::AstNodeUnion::Variable(common::Variable {\n            name: name.to_string(),\n            type_: type_.to_string(),\n        }),\n    }\n}\n\n// `current_order` is unused publicly but useful for callers; suppress warnings.\n#[allow(dead_code)]\nfn _use_current_order() -> config::reduction_order_t {\n    current_order()\n}\n","numLines":321,"startLine":1,"totalLines":321}}}
