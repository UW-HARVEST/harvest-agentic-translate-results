::new();\n    parse_config(line, &mut key, &mut value);\n    assert_eq!(key, \"key\");\n    assert_eq!(value, \"value\");\n}\n\n#[test]\nfn test_parse_config_step_reduction() {\n    let line = \"step_by_step_reduction=true\";\n    let mut key = String::new();\n    let mut value = String::new();\n    parse_config(line, &mut key, &mut value);\n    assert_eq!(key, \"step_by_step_reduction\");\n    assert_eq!(value, \"true\");\n}\n\nfn main() {}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2100,"cache_read_input_tokens":81268,"cache_creation":{"ephemeral_5m_input_tokens":2100,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e1eef4ca-d0e7-4181-92e4-a94c7e6dba4b","uuid":"4c892a50-bbe5-4047-8043-d122330d9295"}
