{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015jSjBpK6upWWxyP2gJHPyN","type":"tool_result","content":"1\tuse crate::{common, hash_table, reducer};\n2\tuse std::cell::Cell;\n3\tuse std::fs::File;\n4\tuse std::io::{Read, Seek, SeekFrom};\n5\t\n6\tthread_local! {\n7\t    static ALPHA_COUNTER: Cell<i32> = Cell::new(1);\n8\t}\n9\t\n10\tpub fn parse_token(token: char) -> common::tokens_t {\n11\t    if token == '(' {\n12\t        common::tokens_t::L_PAREN\n13\t    } else if token == ')' {\n14\t        common::tokens_t::R_PAREN\n15\t    } else if token == '@' {\n16\t        common::tokens_t::LAMBDA\n17\t    } else if token == '.' {\n18\t        common::tokens_t::DOT\n19\t    } else if is_variable(token) {\n20\t        common::tokens_t::VARIABLE\n21\t    } else if token == ' ' {\n22\t        common::tokens_t::WHITESPACE\n23\t    } else if token == '\\n' {\n24\t        common::tokens_t::NEWLINE\n25\t    } else if token == '=' {\n26\t        common::tokens_t::EQ\n27\t    } else if token == '\"' {\n28\t        common::tokens_t::QUOTE\n29\t    } else if token == ':' {\n30\t        common::tokens_t::COLON\n31\t    } else {\n32\t        common::tokens_t::ERROR\n33\t    }\n34\t}\n35\t\n36\tpub fn p_print_token(token: common::tokens_t) {\n37\t    match token {\n38\t        common::tokens_t::L_PAREN => print!(\"( \"),\n39\t        common::tokens_t::R_PAREN => print!(\") \"),\n40\t        common::tokens_t::LAMBDA => print!(\"@ \"),\n41\t        common::tokens_t::DOT => print!(\". \"),\n42\t        common::tokens_t::VARIABLE => print!(\"VARIABLE \"),\n43\t        common::tokens_t::WHITESPACE => print!(\"WHITESPACE \"),\n44\t        common::tokens_t::NEWLINE => print!(\"NEWLINE \"),\n45\t        common::tokens_t::EQ => print!(\"= \"),\n46\t        _ => print!(\"ERROR \"),\n47\t    }\n48\t}\n49\t\n50\tpub fn p_print_astNode_type(n: &common::AstNode) {\n51\t    match n.type_ {\n52\t        common::AstNodeType::LAMBDA_EXPR => println!(\"AstNode Type: LAMBDA_EXPR\"),\n53\t        common::AstNodeType::APPLICATION => println!(\"AstNode Type: APPLICATION\"),\n54\t        common::AstNodeType::VAR => println!(\"AstNode Type: VAR\"),\n55\t        common::AstNodeType::DEFINITION => println!(\"AstNode Type: DEFINITION\"),\n56\t    }\n57\t}\n58\t\n59\tpub fn print_ast(node: &common::AstNode) {\n60\t    match &node.node {\n61\t        common::AstNodeUnion::LambdaExpr(lambda) => {\n62\t            print!(\"(LAMBDA {} : {}\", lambda.parameter, lambda.type_);\n63\t            if let Some(body) = &lambda.body {\n64\t                print_ast(body);\n65\t            }\n66\t            print!(\") \");\n67\t        }\n68\t        common::AstNodeUnion::Application(app) => {\n69\t            print!(\"(APP \");\n70\t            if let Some(f) = &app.function {\n71\t                print_ast(f);\n72\t            }\n73\t            if let Some(a) = &app.argument {\n74\t                print_ast(a);\n75\t            }\n76\t            print!(\") \");\n77\t        }\n78\t        common::AstNodeUnion::Variable(var) => match node.type_ {\n79\t            common::AstNodeType::DEFINITION => {\n80\t                print!(\"(DEFINITION {}) \", var.name);\n81\t            }\n82\t            _ => {\n83\t                print!(\"(VAR {} \", var.name);\n84\t                if !var.type_.is_empty() {\n85\t                    print!(\": {}\", var.type_);\n86\t                }\n87\t                print!(\")\");\n88\t            }\n89\t        },\n90\t    }\n91\t}\n92\t\n93\tpub fn is_variable(token: char) -> bool {\n94\t    let cmp = token as u32;\n95\t    if cmp == ('_' as u32) {\n96\t        return true;\n97\t    }\n98\t    (cmp >= 97 && cmp <= 122) || (cmp >= 65 && cmp <= 90)\n99\t}\n100\t\n101\t/// Read a byte from `in_` and return it as a `char`. Returns `\\u{FFFF}` to\n102\t/// indicate EOF (matching the sentinel used by `io::next`).\n103\tfn read_char(in_: &mut File) -> char {\n104\t    let mut buf = [0u8; 1];\n105\t    match in_.read(&mut buf) {\n106\t        Ok(1) => buf[0] as char,\n107\t        _ => '\\u{FFFF}',\n108\t    }\n109\t}\n110\t\n111\tpub fn peek(in_: &mut File) -> char {\n112\t    let mut buf = [0u8; 1];\n113\t    match in_.read(&mut buf) {\n114\t        Ok(1) => {\n115\t            // Seek back so the byte is \"ungotten\"\n116\t            let _ = in_.seek(SeekFrom::Current(-1));\n117\t            buf[0] as char\n118\t        }\n119\t        _ => '\\u{FFFF}',\n120\t    }\n121\t}\n122\t\n123\tpub fn peek_print(in_: &mut File, n: usize) {\n124\t    let mut buf = vec![0u8; n];\n125\t    let read = match in_.read(&mut buf) {\n126\t        Ok(r) => r,\n127\t        Err(_) => 0,\n128\t    };\n129\t    let s = String::from_utf8_lossy(&buf[..read]).into_owned();\n130\t    print!(\"{}\", s);\n131\t    if read > 0 {\n132\t        let _ = in_.seek(SeekFrom::Current(-(read as i64)));\n133\t    }\n134\t}\n135\t\n136\tpub fn consume(t: common::tokens_t, in_: &mut File, expected: &str) {\n137\t    let c = read_char(in_);\n138\t    let p = parse_token(c);\n139\t    if p != t {\n140\t        expect(expected, c);\n141\t    }\n142\t}\n143\t\n144\tpub fn create_variable(name: &str, type_: &str) -> common::AstNode {\n145\t    common::AstNode {\n146\t        type_: common::AstNodeType::VAR,\n147\t        node: common::AstNodeUnion::Variable(common::Variable {\n148\t            name: name.to_string(),\n149\t            type_: type_.to_string(),\n150\t        }),\n151\t    }\n152\t}\n153\t\n154\tpub fn create_application(\n155\t    function: &common::AstNode,\n156\t    argument: &common::AstNode,\n157\t) -> common::AstNode {\n158\t    common::AstNode {\n159\t        type_: common::AstNodeType::APPLICATION,\n160\t        node: common::AstNodeUnion::Application(common::Application {\n161\t            function: Some(Box::new(reducer::deepcopy(function))),\n162\t            argument: Some(Box::new(reducer::deepcopy(argument))),\n163\t        }),\n164\t    }\n165\t}\n166\t\n167\tpub fn create_lambda(\n168\t    variable: &str,\n169\t    body: &common::AstNode,\n170\t    type_: &str,\n171\t) -> common::AstNode {\n172\t    common::AstNode {\n173\t        type_: common::AstNodeType::LAMBDA_EXPR,\n174\t        node: common::AstNodeUnion::LambdaExpr(common::LambdaExpression {\n175\t            parameter: variable.to_string(),\n176\t            type_: type_.to_string(),\n177\t            body: Some(Box::new(reducer::deepcopy(body))),\n178\t        }),\n179\t    }\n180\t}\n181\t\n182\tpub fn alpha_convert(old: &str) -> String {\n183\t    let n = ALPHA_COUNTER.with(|c| {\n184\t        let v = c.get();\n185\t        c.set(v + 1);\n186\t        v\n187\t    });\n188\t    format!(\"{}_{}\", old, n)\n189\t}\n190\t\n191\tpub fn is_used(table: &hash_table::HashTable, variable: &str) -> bool {\n192\t    table.table_exists(variable)\n193\t}\n194\t\n195\tpub fn parse_space_chars(in_: &mut File) {\n196\t    let mut c = peek(in_);\n197\t    while c == ' ' || c == '\\n' || c == '\\t' {\n198\t        let _ = read_char(in_);\n199\t        c = peek(in_);\n200\t    }\n201\t}\n202\t\n203\tpub fn parse_lambda(\n204\t    table: &mut hash_table::HashTable,\n205\t    in_: &mut File,\n206\t) -> common::AstNode {\n207\t    if parse_token(peek(in_)) != common::tokens_t::VARIABLE {\n208\t        expect(\"A variable\", peek(in_));\n209\t    }\n210\t\n211\t    let var = parse_variable(in_);\n212\t    let mut new_var: Option<String> = None;\n213\t    if is_used(table, &var) {\n214\t        if table.search(&var).is_some() {\n215\t            let msg = format!(\n216\t                \"A definition with name {} already exists. Cannot use same name for lambda abstraction.\\n\",\n217\t                var\n218\t            );\n219\t            common::error(&msg, file!(), line!() as i32, \"parse_lambda\");\n220\t        }\n221\t        let nv = alpha_convert(&var);\n222\t        table.insert(&nv, hash_table::null_marker());\n223\t        new_var = Some(nv);\n224\t    } else {\n225\t        table.insert(&var, hash_table::null_marker());\n226\t    }\n227\t\n228\t    parse_space_chars(in_);\n229\t\n230\t    consume(common::tokens_t::COLON, in_, \":\");\n231\t\n232\t    parse_space_chars(in_);\n233\t\n234\t    if parse_token(peek(in_)) != common::tokens_t::VARIABLE {\n235\t        common::error(\n236\t            \"Lambda abstractions should be typed.\",\n237\t            file!(),\n238\t            line!() as i32,\n239\t            \"parse_lambda\",\n240\t        );\n241\t    }\n242\t    let type_ = parse_type(table, in_);\n243\t\n244\t    consume(common::tokens_t::DOT, in_, \".\");\n245\t\n246\t    let mut body = parse_expression(table, in_);\n247\t\n248\t    if let Some(ref nv) = new_var {\n249\t        reducer::replace(&mut body, &var, nv);\n250\t        return create_lambda(nv, &body, &type_);\n251\t    }\n252\t    create_lambda(&var, &body, &type_)\n253\t}\n254\t\n255\tpub fn parse_expression(\n256\t    table: &mut hash_table::HashTable,\n257\t    in_: &mut File,\n258\t) -> common::AstNode {\n259\t    while parse_token(peek(in_)) == common::tokens_t::WHITESPACE\n260\t        || parse_token(peek(in_)) == common::tokens_t::NEWLINE\n261\t    {\n262\t        let _ = read_char(in_);\n263\t    }\n264\t    let scanned = parse_token(peek(in_));\n265\t\n266\t    if scanned == common::tokens_t::ERROR {\n267\t        // EOF or other unrecognized; mirror C behavior by exiting on real ERROR\n268\t        // unless we're at EOF (in which case return a default node).\n269\t        let p = peek(in_);\n270\t        if p == '\\u{FFFF}' {\n271\t            return common::AstNode::default();\n272\t        }\n273\t        println!(\"Error: {} is  a valid token\", p);\n274\t        std::process::exit(1);\n275\t    }\n276\t\n277\t    if scanned == common::tokens_t::LAMBDA {\n278\t        let _ = read_char(in_);\n279\t        return parse_lambda(table, in_);\n280\t    } else if scanned == common::tokens_t::L_PAREN {\n281\t        let _ = read_char(in_);\n282\t        let expr = parse_expression(table, in_);\n283\t        print_ast(&expr);\n284\t        let next_token = parse_token(peek(in_));\n285\t\n286\t        if next_token == common::tokens_t::WHITESPACE {\n287\t            let expr_2 = parse_expression(table, in_);\n288\t            let application = common::AstNode {\n289\t                type_: common::AstNodeType::APPLICATION,\n290\t                node: common::AstNodeUnion::Application(common::Application {\n291\t                    function: Some(Box::new(expr)),\n292\t                    argument: Some(Box::new(expr_2)),\n293\t                }),\n294\t            };\n295\t            consume(common::tokens_t::R_PAREN, in_, \")\");\n296\t            return application;\n297\t        }\n298\t        consume(common::tokens_t::R_PAREN, in_, \")\");\n299\t        return expr;\n300\t    } else if scanned == common::tokens_t::VARIABLE {\n301\t        let var_name = parse_variable(in_);\n302\t\n303\t        if var_name == \"def\" {\n304\t            parse_definition(table, in_);\n305\t            if peek(in_) != '\\u{FFFF}' {\n306\t                return parse_expression(table, in_);\n307\t            }\n308\t            return common::AstNode::default();\n309\t        } else if var_name == \"import\" {\n310\t            parse_import(table, in_);\n311\t            if peek(in_) != '\\u{FFFF}' {\n312\t                return parse_expression(table, in_);\n313\t            }\n314\t            return common::AstNode::default();\n315\t        } else if var_name == \"type\" {\n316\t            parse_type_definition(table, in_);\n317\t            if peek(in_) != '\\u{FFFF}' {\n318\t                return parse_expression(table, in_);\n319\t            }\n320\t            return common::AstNode::default();\n321\t        }\n322\t\n323\t        let mut type_ = String::new();\n324\t\n325\t        parse_space_chars(in_);\n326\t        if !table.table_exists(&var_name) {\n327\t            if parse_token(peek(in_)) != common::tokens_t::COLON {\n328\t                let msg = format!(\n329\t                    \"Constant Variable {} is not typed. Please provide a type.\\n\",\n330\t                    var_name\n331\t                );\n332\t                common::error(\n333\t                    &msg,\n334\t                    file!(),\n335\t                    line!() as i32,\n336\t                    \"parse_expression\",\n337\t                );\n338\t            }\n339\t            consume(common::tokens_t::COLON, in_, \":\");\n340\t            parse_space_chars(in_);\n341\t            type_ = parse_type(table, in_);\n342\t        }\n343\t\n344\t        let mut variable = create_variable(&var_name, &type_);\n345\t        if table.search(&var_name).is_some() {\n346\t            variable.type_ = common::AstNodeType::DEFINITION;\n347\t        }\n348\t        return variable;\n349\t    }\n350\t    common::AstNode::default()\n351\t}\n352\t\n353\tpub fn parse_import(table: &mut hash_table::HashTable, in_: &mut File) {\n354\t    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n355\t    consume(common::tokens_t::QUOTE, in_, \"\\\"\");\n356\t\n357\t    let mut file_path = String::new();\n358\t    let mut next_token = read_char(in_);\n359\t    let mut n = parse_token(next_token);\n360\t\n361\t    while n != common::tokens_t::QUOTE {\n362\t        if file_path.len() < 99 {\n363\t            file_path.push(next_token);\n364\t        } else {\n365\t            common::error(\n366\t                \"File path is too long. Please make sure it is less than 100 characters.\",\n367\t                file!(),\n368\t                line!() as i32,\n369\t                \"parse_import\",\n370\t            );\n371\t        }\n372\t        next_token = read_char(in_);\n373\t        n = parse_token(next_token);\n374\t    }\n375\t\n376\t    let mut imported_file = match crate::io::get_file(&file_path, \"r\") {\n377\t        Ok(f) => f,\n378\t        Err(_) => {\n379\t            let msg = format!(\"Could not open imported file {}\", file_path);\n380\t            common::error(&msg, file!(), line!() as i32, \"parse_import\");\n381\t            return;\n382\t        }\n383\t    };\n384\t\n385\t    while peek(&mut imported_file) != '\\u{FFFF}' {\n386\t        let imported_tkn = peek(&mut imported_file);\n387\t        let scanned = parse_token(imported_tkn);\n388\t        parse_space_chars(&mut imported_file);\n389\t        if scanned == common::tokens_t::VARIABLE {\n390\t            let var_name = parse_variable(&mut imported_file);\n391\t            if var_name == \"def\" {\n392\t                parse_definition(table, &mut imported_file);\n393\t            } else if var_name == \"type\" {\n394\t                parse_type_definition(table, &mut imported_file);\n395\t            } else {\n396\t                let msg = format!(\n397\t                    \"Expected a definition in the imported file, but got {}\\n\",\n398\t                    var_name\n399\t                );\n400\t                common::error(\n401\t                    &msg,\n402\t                    file!(),\n403\t                    line!() as i32,\n404\t                    \"parse_import\",\n405\t                );\n406\t            }\n407\t        } else {\n408\t            // skip unrecognized characters\n409\t            let _ = read_char(&mut imported_file);\n410\t        }\n411\t    }\n412\t}\n413\t\n414\tpub fn parse_definition(table: &mut hash_table::HashTable, in_: &mut File) {\n415\t    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n416\t\n417\t    if parse_token(peek(in_)) != common::tokens_t::VARIABLE {\n418\t        expect(\"a variable\", peek(in_));\n419\t    }\n420\t\n421\t    let def_name = parse_variable(in_);\n422\t\n423\t    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n424\t    consume(common::tokens_t::EQ, in_, \"=\");\n425\t    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n426\t\n427\t    let definition = parse_expression(table, in_);\n428\t    table.insert(&def_name, definition);\n429\t}\n430\t\n431\tpub fn is_uppercase(c: char) -> bool {\n432\t    c >= 'A' && c <= 'Z'\n433\t}\n434\t\n435\tpub fn parse_type_definition(\n436\t    types_table: &mut hash_table::HashTable,\n437\t    in_: &mut File,\n438\t) {\n439\t    let next_token = read_char(in_);\n440\t    let n = parse_token(next_token);\n441\t    if n != common::tokens_t::WHITESPACE {\n442\t        expect(\" \", next_token);\n443\t    }\n444\t\n445\t    let next_token2 = peek(in_);\n446\t    let n2 = parse_token(next_token2);\n447\t    if n2 != common::tokens_t::VARIABLE {\n448\t        expect(\"a type definition\", next_token2);\n449\t    }\n450\t\n451\t    if !is_uppercase(next_token2) {\n452\t        common::error(\n453\t            \"Type names must start with an uppercase letter\",\n454\t            file!(),\n455\t            line!() as i32,\n456\t            \"parse_type_definition\",\n457\t        );\n458\t    }\n459\t\n460\t    let type_name = parse_variable(in_);\n461\t    if types_table.table_exists(&type_name) {\n462\t        let msg = format!(\"Type {} was already defined.\\n\", type_name);\n463\t        common::error(&msg, file!(), line!() as i32, \"parse_type_definition\");\n464\t    }\n465\t    types_table.insert(&type_name, hash_table::null_marker());\n466\t}\n467\t\n468\tpub fn parse_type(\n469\t    types_table: &mut hash_table::HashTable,\n470\t    in_: &mut File,\n471\t) -> String {\n472\t    let token = read_char(in_);\n473\t\n474\t    if !is_uppercase(token) {\n475\t        common::error(\n476\t            \"Types should start with an uppercase letter.\",\n477\t            file!(),\n478\t            line!() as i32,\n479\t            \"parse_type\",\n480\t        );\n481\t    }\n482\t\n483\t    let mut type_name = String::new();\n484\t    type_name.push(token);\n485\t\n486\t    while is_variable(peek(in_)) {\n487\t        type_name.push(read_char(in_));\n488\t    }\n489\t\n490\t    if !types_table.table_exists(&type_name) {\n491\t        let msg = format!(\"Type {} was not defined.\\n\", type_name);\n492\t        common::error(&msg, file!(), line!() as i32, \"parse_type\");\n493\t    }\n494\t    type_name\n495\t}\n496\t\n497\tpub fn parse_variable(in_: &mut File) -> String {\n498\t    let mut variable_name = String::new();\n499\t    while is_variable(peek(in_)) {\n500\t        variable_name.push(read_char(in_));\n501\t    }\n502\t    variable_name\n503\t}\n504\t\n505\tpub fn expect(expected: &str, received: char) {\n506\t    println!(\n507\t        \"Syntax Error: Expected {} , received {} \",\n508\t        expected, received\n509\t    );\n510\t    std::process::exit(1);\n511\t}\n512\t\n513\tpub fn free_ast(_node: &mut common::AstNode) {\n514\t    // Rust handles memory management automatically; nothing to do.\n515\t}\n516\t"}]},"parent_tool_use_id":null,"session_id":"e1eef4ca-d0e7-4181-92e4-a94c7e6dba4b","uuid":"82178f17-3251-469b-b65c-c317bacea300","timestamp":"2026-05-29T18:16:15.154Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-PjQdnV/project/src/parser.rs","content":"use crate::{common, hash_table, reducer};\nuse std::cell::Cell;\nuse std::fs::File;\nuse std::io::{Read, Seek, SeekFrom};\n\nthread_local! {\n    static ALPHA_COUNTER: Cell<i32> = Cell::new(1);\n}\n\npub fn parse_token(token: char) -> common::tokens_t {\n    if token == '(' {\n        common::tokens_t::L_PAREN\n    } else if token == ')' {\n        common::tokens_t::R_PAREN\n    } else if token == '@' {\n        common::tokens_t::LAMBDA\n    } else if token == '.' {\n        common::tokens_t::DOT\n    } else if is_variable(token) {\n        common::tokens_t::VARIABLE\n    } else if token == ' ' {\n        common::tokens_t::WHITESPACE\n    } else if token == '\\n' {\n        common::tokens_t::NEWLINE\n    } else if token == '=' {\n        common::tokens_t::EQ\n    } else if token == '\"' {\n        common::tokens_t::QUOTE\n    } else if token == ':' {\n        common::tokens_t::COLON\n    } else {\n        common::tokens_t::ERROR\n    }\n}\n\npub fn p_print_token(token: common::tokens_t) {\n    match token {\n        common::tokens_t::L_PAREN => print!(\"( \"),\n        common::tokens_t::R_PAREN => print!(\") \"),\n        common::tokens_t::LAMBDA => print!(\"@ \"),\n        common::tokens_t::DOT => print!(\". \"),\n        common::tokens_t::VARIABLE => print!(\"VARIABLE \"),\n        common::tokens_t::WHITESPACE => print!(\"WHITESPACE \"),\n        common::tokens_t::NEWLINE => print!(\"NEWLINE \"),\n        common::tokens_t::EQ => print!(\"= \"),\n        _ => print!(\"ERROR \"),\n    }\n}\n\npub fn p_print_astNode_type(n: &common::AstNode) {\n    match n.type_ {\n        common::AstNodeType::LAMBDA_EXPR => println!(\"AstNode Type: LAMBDA_EXPR\"),\n        common::AstNodeType::APPLICATION => println!(\"AstNode Type: APPLICATION\"),\n        common::AstNodeType::VAR => println!(\"AstNode Type: VAR\"),\n        common::AstNodeType::DEFINITION => println!(\"AstNode Type: DEFINITION\"),\n    }\n}\n\npub fn print_ast(node: &common::AstNode) {\n    match &node.node {\n        common::AstNodeUnion::LambdaExpr(lambda) => {\n            print!(\"(LAMBDA {} : {}\", lambda.parameter, lambda.type_);\n            if let Some(body) = &lambda.body {\n                print_ast(body);\n            }\n            print!(\") \");\n        }\n        common::AstNodeUnion::Application(app) => {\n            print!(\"(APP \");\n            if let Some(f) = &app.function {\n                print_ast(f);\n            }\n            if let Some(a) = &app.argument {\n                print_ast(a);\n            }\n            print!(\") \");\n        }\n        common::AstNodeUnion::Variable(var) => match node.type_ {\n            common::AstNodeType::DEFINITION => {\n                print!(\"(DEFINITION {}) \", var.name);\n            }\n            _ => {\n                print!(\"(VAR {} \", var.name);\n                if !var.type_.is_empty() {\n                    print!(\": {}\", var.type_);\n                }\n                print!(\")\");\n            }\n        },\n    }\n}\n\npub fn is_variable(token: char) -> bool {\n    let cmp = token as u32;\n    if cmp == ('_' as u32) {\n        return true;\n    }\n    (cmp >= 97 && cmp <= 122) || (cmp >= 65 && cmp <= 90)\n}\n\n/// Read a byte from `in_` and return it as a `char`. Returns `\\u{FFFF}` to\n/// indicate EOF (matching the sentinel used by `io::next`).\nfn read_char(in_: &mut File) -> char {\n    let mut buf = [0u8; 1];\n    match in_.read(&mut buf) {\n        Ok(1) => buf[0] as char,\n        _ => '\\u{FFFF}',\n    }\n}\n\npub fn peek(in_: &mut File) -> char {\n    let mut buf = [0u8; 1];\n    match in_.read(&mut buf) {\n        Ok(1) => {\n            // Seek back so the byte is \"ungotten\"\n            let _ = in_.seek(SeekFrom::Current(-1));\n            buf[0] as char\n        }\n        _ => '\\u{FFFF}',\n    }\n}\n\npub fn peek_print(in_: &mut File, n: usize) {\n    let mut buf = vec![0u8; n];\n    let read = match in_.read(&mut buf) {\n        Ok(r) => r,\n        Err(_) => 0,\n    };\n    let s = String::from_utf8_lossy(&buf[..read]).into_owned();\n    print!(\"{}\", s);\n    if read > 0 {\n        let _ = in_.seek(SeekFrom::Current(-(read as i64)));\n    }\n}\n\npub fn consume(t: common::tokens_t, in_: &mut File, expected: &str) {\n    let c = read_char(in_);\n    let p = parse_token(c);\n    if p != t {\n        expect(expected, c);\n    }\n}\n\npub fn create_variable(name: &str, type_: &str) -> common::AstNode {\n    common::AstNode {\n        type_: common::AstNodeType::VAR,\n        node: common::AstNodeUnion::Variable(common::Variable {\n            name: name.to_string(),\n            type_: type_.to_string(),\n        }),\n    }\n}\n\npub fn create_application(\n    function: &common::AstNode,\n    argument: &common::AstNode,\n) -> common::AstNode {\n    common::AstNode {\n        type_: common::AstNodeType::APPLICATION,\n        node: common::AstNodeUnion::Application(common::Application {\n            function: Some(Box::new(reducer::deepcopy(function))),\n            argument: Some(Box::new(reducer::deepcopy(argument))),\n        }),\n    }\n}\n\npub fn create_lambda(\n    variable: &str,\n    body: &common::AstNode,\n    type_: &str,\n) -> common::AstNode {\n    common::AstNode {\n        type_: common::AstNodeType::LAMBDA_EXPR,\n        node: common::AstNodeUnion::LambdaExpr(common::LambdaExpression {\n            parameter: variable.to_string(),\n            type_: type_.to_string(),\n            body: Some(Box::new(reducer::deepcopy(body))),\n        }),\n    }\n}\n\npub fn alpha_convert(old: &str) -> String {\n    let n = ALPHA_COUNTER.with(|c| {\n        let v = c.get();\n        c.set(v + 1);\n        v\n    });\n    format!(\"{}_{}\", old, n)\n}\n\npub fn is_used(table: &hash_table::HashTable, variable: &str) -> bool {\n    table.table_exists(variable)\n}\n\npub fn parse_space_chars(in_: &mut File) {\n    let mut c = peek(in_);\n    while c == ' ' || c == '\\n' || c == '\\t' {\n        let _ = read_char(in_);\n        c = peek(in_);\n    }\n}\n\npub fn parse_lambda(\n    table: &mut hash_table::HashTable,\n    in_: &mut File,\n) -> common::AstNode {\n    if parse_token(peek(in_)) != common::tokens_t::VARIABLE {\n        expect(\"A variable\", peek(in_));\n    }\n\n    let var = parse_variable(in_);\n    let mut new_var: Option<String> = None;\n    if is_used(table, &var) {\n        if table.search(&var).is_some() {\n            let msg = format!(\n                \"A definition with name {} already exists. Cannot use same name for lambda abstraction.\\n\",\n                var\n            );\n            common::error(&msg, file!(), line!() as i32, \"parse_lambda\");\n        }\n        let nv = alpha_convert(&var);\n        table.insert(&nv, hash_table::null_marker());\n        new_var = Some(nv);\n    } else {\n        table.insert(&var, hash_table::null_marker());\n    }\n\n    parse_space_chars(in_);\n\n    consume(common::tokens_t::COLON, in_, \":\");\n\n    parse_space_chars(in_);\n\n    if parse_token(peek(in_)) != common::tokens_t::VARIABLE {\n        common::error(\n            \"Lambda abstractions should be typed.\",\n            file!(),\n            line!() as i32,\n            \"parse_lambda\",\n        );\n    }\n    let type_ = parse_type(table, in_);\n\n    consume(common::tokens_t::DOT, in_, \".\");\n\n    let mut body = parse_expression(table, in_);\n\n    if let Some(ref nv) = new_var {\n        reducer::replace(&mut body, &var, nv);\n        return create_lambda(nv, &body, &type_);\n    }\n    create_lambda(&var, &body, &type_)\n}\n\npub fn parse_expression(\n    table: &mut hash_table::HashTable,\n    in_: &mut File,\n) -> common::AstNode {\n    while parse_token(peek(in_)) == common::tokens_t::WHITESPACE\n        || parse_token(peek(in_)) == common::tokens_t::NEWLINE\n    {\n        let _ = read_char(in_);\n    }\n    let scanned = parse_token(peek(in_));\n\n    if scanned == common::tokens_t::ERROR {\n        // EOF or other unrecognized; mirror C behavior by exiting on real ERROR\n        // unless we're at EOF (in which case return a default node).\n        let p = peek(in_);\n        if p == '\\u{FFFF}' {\n            return common::AstNode::default();\n        }\n        println!(\"Error: {} is  a valid token\", p);\n        std::process::exit(1);\n    }\n\n    if scanned == common::tokens_t::LAMBDA {\n        let _ = read_char(in_);\n        return parse_lambda(table, in_);\n    } else if scanned == common::tokens_t::L_PAREN {\n        let _ = read_char(in_);\n        let expr = parse_expression(table, in_);\n        print_ast(&expr);\n        let next_token = parse_token(peek(in_));\n\n        if next_token == common::tokens_t::WHITESPACE {\n            let expr_2 = parse_expression(table, in_);\n            let application = common::AstNode {\n                type_: common::AstNodeType::APPLICATION,\n                node: common::AstNodeUnion::Application(common::Application {\n                    function: Some(Box::new(expr)),\n                    argument: Some(Box::new(expr_2)),\n                }),\n            };\n            consume(common::tokens_t::R_PAREN, in_, \")\");\n            return application;\n        }\n        consume(common::tokens_t::R_PAREN, in_, \")\");\n        return expr;\n    } else if scanned == common::tokens_t::VARIABLE {\n        let var_name = parse_variable(in_);\n\n        if var_name == \"def\" {\n            parse_definition(table, in_);\n            if peek(in_) != '\\u{FFFF}' {\n                return parse_expression(table, in_);\n            }\n            return common::AstNode::default();\n        } else if var_name == \"import\" {\n            parse_import(table, in_);\n            if peek(in_) != '\\u{FFFF}' {\n                return parse_expression(table, in_);\n            }\n            return common::AstNode::default();\n        } else if var_name == \"type\" {\n            parse_type_definition(table, in_);\n            if peek(in_) != '\\u{FFFF}' {\n                return parse_expression(table, in_);\n            }\n            return common::AstNode::default();\n        }\n\n        let mut type_ = String::new();\n\n        parse_space_chars(in_);\n        if !table.table_exists(&var_name) {\n            if parse_token(peek(in_)) != common::tokens_t::COLON {\n                let msg = format!(\n                    \"Constant Variable {} is not typed. Please provide a type.\\n\",\n                    var_name\n                );\n                common::error(\n                    &msg,\n                    file!(),\n                    line!() as i32,\n                    \"parse_expression\",\n                );\n            }\n            consume(common::tokens_t::COLON, in_, \":\");\n            parse_space_chars(in_);\n            type_ = parse_type(table, in_);\n        }\n\n        let mut variable = create_variable(&var_name, &type_);\n        if table.search(&var_name).is_some() {\n            variable.type_ = common::AstNodeType::DEFINITION;\n        }\n        return variable;\n    }\n    common::AstNode::default()\n}\n\npub fn parse_import(table: &mut hash_table::HashTable, in_: &mut File) {\n    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n    consume(common::tokens_t::QUOTE, in_, \"\\\"\");\n\n    let mut file_path = String::new();\n    let mut next_token = read_char(in_);\n    let mut n = parse_token(next_token);\n\n    while n != common::tokens_t::QUOTE {\n        if file_path.len() < 99 {\n            file_path.push(next_token);\n        } else {\n            common::error(\n                \"File path is too long. Please make sure it is less than 100 characters.\",\n                file!(),\n                line!() as i32,\n                \"parse_import\",\n            );\n        }\n        next_token = read_char(in_);\n        n = parse_token(next_token);\n    }\n\n    let mut imported_file = match crate::io::get_file(&file_path, \"r\") {\n        Ok(f) => f,\n        Err(_) => {\n            let msg = format!(\"Could not open imported file {}\", file_path);\n            common::error(&msg, file!(), line!() as i32, \"parse_import\");\n            return;\n        }\n    };\n\n    while peek(&mut imported_file) != '\\u{FFFF}' {\n        let imported_tkn = peek(&mut imported_file);\n        let scanned = parse_token(imported_tkn);\n        parse_space_chars(&mut imported_file);\n        if scanned == common::tokens_t::VARIABLE {\n            let var_name = parse_variable(&mut imported_file);\n            if var_name == \"def\" {\n                parse_definition(table, &mut imported_file);\n            } else if var_name == \"type\" {\n                parse_type_definition(table, &mut imported_file);\n            } else {\n                let msg = format!(\n                    \"Expected a definition in the imported file, but got {}\\n\",\n                    var_name\n                );\n                common::error(\n                    &msg,\n                    file!(),\n                    line!() as i32,\n                    \"parse_import\",\n                );\n            }\n        } else {\n            // skip unrecognized characters\n            let _ = read_char(&mut imported_file);\n        }\n    }\n}\n\npub fn parse_definition(table: &mut hash_table::HashTable, in_: &mut File) {\n    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n\n    if parse_token(peek(in_)) != common::tokens_t::VARIABLE {\n        expect(\"a variable\", peek(in_));\n    }\n\n    let def_name = parse_variable(in_);\n\n    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n    consume(common::tokens_t::EQ, in_, \"=\");\n    consume(common::tokens_t::WHITESPACE, in_, \"a whitespace\");\n\n    let definition = parse_expression(table, in_);\n    table.insert(&def_name, definition);\n}\n\npub fn is_uppercase(c: char) -> bool {\n    c >= 'A' && c <= 'Z'\n}\n\npub fn parse_type_definition(\n    types_table: &mut hash_table::HashTable,\n    in_: &mut File,\n) {\n    let next_token = read_char(in_);\n    let n = parse_token(next_token);\n    if n != common::tokens_t::WHITESPACE {\n        expect(\" \", next_token);\n    }\n\n    let next_token2 = peek(in_);\n    let n2 = parse_token(next_token2);\n    if n2 != common::tokens_t::VARIABLE {\n        expect(\"a type definition\", next_token2);\n    }\n\n    if !is_uppercase(next_token2) {\n        common::error(\n            \"Type names must start with an uppercase letter\",\n            file!(),\n            line!() as i32,\n            \"parse_type_definition\",\n        );\n    }\n\n    let type_name = parse_variable(in_);\n    if types_table.table_exists(&type_name) {\n        let msg = format!(\"Type {} was already defined.\\n\", type_name);\n        common::error(&msg, file!(), line!() as i32, \"parse_type_definition\");\n    }\n    types_table.insert(&type_name, hash_table::null_marker());\n}\n\npub fn parse_type(\n    types_table: &mut hash_table::HashTable,\n    in_: &mut File,\n) -> String {\n    let token = read_char(in_);\n\n    if !is_uppercase(token) {\n        common::error(\n            \"Types should start with an uppercase letter.\",\n            file!(),\n            line!() as i32,\n            \"parse_type\",\n        );\n    }\n\n    let mut type_name = String::new();\n    type_name.push(token);\n\n    while is_variable(peek(in_)) {\n        type_name.push(read_char(in_));\n    }\n\n    if !types_table.table_exists(&type_name) {\n        let msg = format!(\"Type {} was not defined.\\n\", type_name);\n        common::error(&msg, file!(), line!() as i32, \"parse_type\");\n    }\n    type_name\n}\n\npub fn parse_variable(in_: &mut File) -> String {\n    let mut variable_name = String::new();\n    while is_variable(peek(in_)) {\n        variable_name.push(read_char(in_));\n    }\n    variable_name\n}\n\npub fn expect(expected: &str, received: char) {\n    println!(\n        \"Syntax Error: Expected {} , received {} \",\n        expected, received\n    );\n    std::process::exit(1);\n}\n\npub fn free_ast(_node: &mut common::AstNode) {\n    // Rust handles memory management automatically; nothing to do.\n}\n","numLines":516,"startLine":1,"totalLines":516}}}
