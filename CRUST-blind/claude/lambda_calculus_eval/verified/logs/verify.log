{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YNzvnrsjaDu2NDqvmLxPxu","type":"tool_result","content":"1\t#include \"reducer.h\"\n2\t#include \"common.h\"\n3\t#include \"../hash-table/hash_table.h\"\n4\t#include <stdarg.h>\n5\t#include \"config.h\"\n6\t\n7\tstatic reduction_order_t reduction_order = APPLICATIVE;\n8\t\n9\tvoid set_reduction_order(reduction_order_t t) {\n10\t  reduction_order = t;\n11\t}\n12\t\n13\tvoid print_reduction_order(reduction_order_t t) {\n14\t  switch (t) {\n15\t    case APPLICATIVE:\n16\t      printf(\"Applicative\");\n17\t      break;\n18\t    case NORMAL:\n19\t      printf(\"Normal\");\n20\t      break;\n21\t  }\n22\t  printf(\"\\n\");\n23\t}\n24\t\n25\tAstNode *reduce(HashTable *table, AstNode *n) {\n26\t  print_verbose(\"Order of reduction is: \");\n27\t  print_reduction_order(reduction_order);\n28\t  print_verbose(\"-------------------------------------------\\n\");\n29\t  expand_definitions(table, n);\n30\t  print_verbose(\"Expanded expression:\\n\");\n31\t  print_ast_verbose(n);\n32\t  AstNode *reduced = reduce_ast(table, n);\n33\t  print_verbose(\"Final reduced expression:\\n\");\n34\t  print_ast_verbose(reduced);\n35\t  print_verbose(\"-------------------------------------------\\n\");\n36\t  return reduced;\n37\t}\n38\t\n39\tvoid expand_definitions(HashTable *table, AstNode *n) {\n40\t  if (n->type == LAMBDA_EXPR) {\n41\t    expand_definitions(table, n->node.lambda_expr->body);\n42\t  } else if (n->type == APPLICATION) {\n43\t    expand_definitions(table, n->node.application->function);\n44\t    expand_definitions(table, n->node.application->argument);\n45\t  } else if (n->type == DEFINITION) {\n46\t    char *def_name = n->node.variable->name;\n47\t    AstNode *expanded_def = search(table, def_name);\n48\t    HANDLE_NULL(expanded_def);\n49\t    print_verbose(\"Expanding definition of: %s . Term expanded to:\\n\", def_name);\n50\t    print_ast_verbose(expanded_def);\n51\t\n52\t    n->type = expanded_def->type;\n53\t    n->node.variable = expanded_def->node.variable;\n54\t    n->node.lambda_expr = expanded_def->node.lambda_expr;\n55\t    n->node.application = expanded_def->node.application;\n56\t  }\n57\t}\n58\t\n59\tvoid replace(AstNode *n, char *old, char *new_name) {\n60\t  if (n->type == LAMBDA_EXPR) {\n61\t    if (strcmp(n->node.lambda_expr->parameter, old) == 0) {\n62\t      n->node.lambda_expr->parameter = new_name;\n63\t    }\n64\t    replace(n->node.lambda_expr->body, old, new_name);\n65\t  }\n66\t\n67\t  else if (n->type == APPLICATION) {\n68\t    replace(n->node.application->function, old, new_name);\n69\t    replace(n->node.application->argument, old, new_name);\n70\t  }\n71\t\n72\t  else if (n->type == VAR) {\n73\t    if (strcmp(n->node.variable->name, old) == 0) {\n74\t      n->node.variable->name = new_name;\n75\t    }\n76\t  }\n77\t}\n78\t\n79\tAstNode *reduce_ast(HashTable *table, AstNode *n) {\n80\t  if (n->type == LAMBDA_EXPR) {\n81\t    AstNode *body = n->node.lambda_expr->body;\n82\t\n83\t    // recursively reduce the body\n84\t    // if order is applicative, reduce the body right now\n85\t    if (reduction_order == APPLICATIVE) {\n86\t      n->node.lambda_expr->body = reduce_ast(table, body);\n87\t    }\n88\t    return n;\n89\t  }\n90\t\n91\t  else if (n->type == APPLICATION) {\n92\t    // apply reduce rules\n93\t    AstNode *function = n->node.application->function;\n94\t    AstNode *argument = n->node.application->argument;\n95\t\n96\t    n->node.application->function = reduce_ast(table, function);\n97\t\n98\t    if (reduction_order == APPLICATIVE) {\n99\t      n->node.application->argument = reduce_ast(table, argument);\n100\t    }\n101\t\n102\t    if (n->node.application->function->type == LAMBDA_EXPR) {\n103\t      char *param = n->node.application->function->node.lambda_expr->parameter;\n104\t      AstNode *reduced = substitute(\n105\t          n->node.application->function->node.lambda_expr->body,\n106\t          param,\n107\t          n->node.application->argument);\n108\t      print_verbose(\"Applied substitution to lambda expr of parameter <%s> and resulted in:\\n\", param);\n109\t      print_ast_verbose(reduced);\n110\t\n111\t      if (reduction_order == APPLICATIVE) {\n112\t        return reduced;\n113\t      }\n114\t      return reduce_ast(table, reduced);\n115\t    }\n116\t    return n;\n117\t  }\n118\t\n119\t  // base case leaf node or variable, nothing to reduce\n120\t  return n;\n121\t}\n122\t\n123\tAstNode *substitute(AstNode *expression, char *variable, AstNode *replacement) {\n124\t  if (expression->type == VAR) {\n125\t    if (strcmp(expression->node.variable->name, variable) == 0) {\n126\t      return deepcopy(replacement);\n127\t    }\n128\t    return expression;\n129\t  }\n130\t\n131\t  else if (expression->type == LAMBDA_EXPR) {\n132\t    // ex: @x.(x y) -> if variable is equal to @x (x), we should then replace\n133\t    // all x in the body of expression with replacement\n134\t    expression->node.lambda_expr->body =\n135\t        substitute(expression->node.lambda_expr->body, variable, replacement);\n136\t    if (expression->node.lambda_expr->parameter != variable) {\n137\t      // if @x.(x y) and we're substituting for y, for example, we do not want\n138\t      // to remove the lambda term\n139\t      return expression;\n140\t    }\n141\t    return expression->node.lambda_expr->body;\n142\t\n143\t  }\n144\t\n145\t  else if (expression->type == APPLICATION) {\n146\t    expression->node.application->function = substitute(\n147\t        expression->node.application->function, variable, replacement);\n148\t    expression->node.application->argument = substitute(\n149\t        expression->node.application->argument, variable, replacement);\n150\t    return expression;\n151\t  }\n152\t  return expression;\n153\t}\n154\t\n155\tAstNode *deepcopy(AstNode *n) {\n156\t  if (n->type == VAR) {\n157\t    return deepcopy_var(n->node.variable->name, n->node.variable->type);\n158\t  }\n159\t\n160\t  else if (n->type == LAMBDA_EXPR) {\n161\t    return deepcopy_lambda_expr(n->node.lambda_expr->parameter,\n162\t                                n->node.lambda_expr->body, n->node.lambda_expr->type);\n163\t  }\n164\t\n165\t  else if (n->type == APPLICATION) {\n166\t    return deepcopy_application(n->node.application->function,\n167\t                                n->node.application->argument);\n168\t  }\n169\t  return NULL;\n170\t}\n171\t\n172\tAstNode *deepcopy_application(AstNode *function, AstNode *argument) {\n173\t  AstNode *application = (AstNode *)malloc(sizeof(AstNode));\n174\t  application->type = APPLICATION;\n175\t  application->node.application = (Application *)malloc(sizeof(Application));\n176\t  application->node.application->function = deepcopy(function);\n177\t  application->node.application->argument = deepcopy(argument);\n178\t  return application;\n179\t}\n180\t\n181\tAstNode *deepcopy_lambda_expr(char *parameter, AstNode *body, char *type) {\n182\t  AstNode *lambda = (AstNode *)malloc(sizeof(AstNode));\n183\t  lambda->type = LAMBDA_EXPR;\n184\t  lambda->node.lambda_expr =\n185\t      (LambdaExpression *)malloc(sizeof(LambdaExpression));\n186\t  lambda->node.lambda_expr->parameter = parameter;\n187\t  lambda->node.lambda_expr->type = type;\n188\t  lambda->node.lambda_expr->body = deepcopy(body);\n189\t  return lambda;\n190\t}\n191\t\n192\tAstNode *deepcopy_var(char *name, char *type) {\n193\t  AstNode *variable = (AstNode *)malloc(sizeof(AstNode));\n194\t  variable->type = VAR;\n195\t  variable->node.variable = (Variable *)malloc(sizeof(Variable));\n196\t  variable->node.variable->name = name;\n197\t  variable->node.variable->type = type;\n198\t  return variable;\n199\t}\n200\t"}]},"parent_tool_use_id":null,"session_id":"e1eef4ca-d0e7-4181-92e4-a94c7e6dba4b","uuid":"7a799ce5-2d0f-4c8a-acdd-1cf082cf9e28","timestamp":"2026-05-29T18:16:42.531Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-PjQdnV/project/c_src/src/reducer.c","content":"#include \"reducer.h\"\n#include \"common.h\"\n#include \"../hash-table/hash_table.h\"\n#include <stdarg.h>\n#include \"config.h\"\n\nstatic reduction_order_t reduction_order = APPLICATIVE;\n\nvoid set_reduction_order(reduction_order_t t) {\n  reduction_order = t;\n}\n\nvoid print_reduction_order(reduction_order_t t) {\n  switch (t) {\n    case APPLICATIVE:\n      printf(\"Applicative\");\n      break;\n    case NORMAL:\n      printf(\"Normal\");\n      break;\n  }\n  printf(\"\\n\");\n}\n\nAstNode *reduce(HashTable *table, AstNode *n) {\n  print_verbose(\"Order of reduction is: \");\n  print_reduction_order(reduction_order);\n  print_verbose(\"-------------------------------------------\\n\");\n  expand_definitions(table, n);\n  print_verbose(\"Expanded expression:\\n\");\n  print_ast_verbose(n);\n  AstNode *reduced = reduce_ast(table, n);\n  print_verbose(\"Final reduced expression:\\n\");\n  print_ast_verbose(reduced);\n  print_verbose(\"-------------------------------------------\\n\");\n  return reduced;\n}\n\nvoid expand_definitions(HashTable *table, AstNode *n) {\n  if (n->type == LAMBDA_EXPR) {\n    expand_definitions(table, n->node.lambda_expr->body);\n  } else if (n->type == APPLICATION) {\n    expand_definitions(table, n->node.application->function);\n    expand_definitions(table, n->node.application->argument);\n  } else if (n->type == DEFINITION) {\n    char *def_name = n->node.variable->name;\n    AstNode *expanded_def = search(table, def_name);\n    HANDLE_NULL(expanded_def);\n    print_verbose(\"Expanding definition of: %s . Term expanded to:\\n\", def_name);\n    print_ast_verbose(expanded_def);\n\n    n->type = expanded_def->type;\n    n->node.variable = expanded_def->node.variable;\n    n->node.lambda_expr = expanded_def->node.lambda_expr;\n    n->node.application = expanded_def->node.application;\n  }\n}\n\nvoid replace(AstNode *n, char *old, char *new_name) {\n  if (n->type == LAMBDA_EXPR) {\n    if (strcmp(n->node.lambda_expr->parameter, old) == 0) {\n      n->node.lambda_expr->parameter = new_name;\n    }\n    replace(n->node.lambda_expr->body, old, new_name);\n  }\n\n  else if (n->type == APPLICATION) {\n    replace(n->node.application->function, old, new_name);\n    replace(n->node.application->argument, old, new_name);\n  }\n\n  else if (n->type == VAR) {\n    if (strcmp(n->node.variable->name, old) == 0) {\n      n->node.variable->name = new_name;\n    }\n  }\n}\n\nAstNode *reduce_ast(HashTable *table, AstNode *n) {\n  if (n->type == LAMBDA_EXPR) {\n    AstNode *body = n->node.lambda_expr->body;\n\n    // recursively reduce the body\n    // if order is applicative, reduce the body right now\n    if (reduction_order == APPLICATIVE) {\n      n->node.lambda_expr->body = reduce_ast(table, body);\n    }\n    return n;\n  }\n\n  else if (n->type == APPLICATION) {\n    // apply reduce rules\n    AstNode *function = n->node.application->function;\n    AstNode *argument = n->node.application->argument;\n\n    n->node.application->function = reduce_ast(table, function);\n\n    if (reduction_order == APPLICATIVE) {\n      n->node.application->argument = reduce_ast(table, argument);\n    }\n\n    if (n->node.application->function->type == LAMBDA_EXPR) {\n      char *param = n->node.application->function->node.lambda_expr->parameter;\n      AstNode *reduced = substitute(\n          n->node.application->function->node.lambda_expr->body,\n          param,\n          n->node.application->argument);\n      print_verbose(\"Applied substitution to lambda expr of parameter <%s> and resulted in:\\n\", param);\n      print_ast_verbose(reduced);\n\n      if (reduction_order == APPLICATIVE) {\n        return reduced;\n      }\n      return reduce_ast(table, reduced);\n    }\n    return n;\n  }\n\n  // base case leaf node or variable, nothing to reduce\n  return n;\n}\n\nAstNode *substitute(AstNode *expression, char *variable, AstNode *replacement) {\n  if (expression->type == VAR) {\n    if (strcmp(expression->node.variable->name, variable) == 0) {\n      return deepcopy(replacement);\n    }\n    return expression;\n  }\n\n  else if (expression->type == LAMBDA_EXPR) {\n    // ex: @x.(x y) -> if variable is equal to @x (x), we should then replace\n    // all x in the body of expression with replacement\n    expression->node.lambda_expr->body =\n        substitute(expression->node.lambda_expr->body, variable, replacement);\n    if (expression->node.lambda_expr->parameter != variable) {\n      // if @x.(x y) and we're substituting for y, for example, we do not want\n      // to remove the lambda term\n      return expression;\n    }\n    return expression->node.lambda_expr->body;\n\n  }\n\n  else if (expression->type == APPLICATION) {\n    expression->node.application->function = substitute(\n        expression->node.application->function, variable, replacement);\n    expression->node.application->argument = substitute(\n        expression->node.application->argument, variable, replacement);\n    return expression;\n  }\n  return expression;\n}\n\nAstNode *deepcopy(AstNode *n) {\n  if (n->type == VAR) {\n    return deepcopy_var(n->node.variable->name, n->node.variable->type);\n  }\n\n  else if (n->type == LAMBDA_EXPR) {\n    return deepcopy_lambda_expr(n->node.lambda_expr->parameter,\n                                n->node.lambda_expr->body, n->node.lambda_expr->type);\n  }\n\n  else if (n->type == APPLICATION) {\n    return deepcopy_application(n->node.application->function,\n                                n->node.application->argument);\n  }\n  return NULL;\n}\n\nAstNode *deepcopy_application(AstNode *function, AstNode *argument) {\n  AstNode *application = (AstNode *)malloc(sizeof(AstNode));\n  application->type = APPLICATION;\n  application->node.application = (Application *)malloc(sizeof(Application));\n  application->node.application->function = deepcopy(function);\n  application->node.application->argument = deepcopy(argument);\n  return application;\n}\n\nAstNode *deepcopy_lambda_expr(char *parameter, AstNode *body, char *type) {\n  AstNode *lambda = (AstNode *)malloc(sizeof(AstNode));\n  lambda->type = LAMBDA_EXPR;\n  lambda->node.lambda_expr =\n      (LambdaExpression *)malloc(sizeof(LambdaExpression));\n  lambda->node.lambda_expr->parameter = parameter;\n  lambda->node.lambda_expr->type = type;\n  lambda->node.lambda_expr->body = deepcopy(body);\n  return lambda;\n}\n\nAstNode *deepcopy_var(char *name, char *type) {\n  AstNode *variable = (AstNode *)malloc(sizeof(AstNode));\n  variable->type = VAR;\n  variable->node.variable = (Variable *)malloc(sizeof(Variable));\n  variable->node.variable->name = name;\n  variable->node.variable->type = type;\n  return variable;\n}\n","numLines":200,"startLine":1,"totalLines":200}}}
