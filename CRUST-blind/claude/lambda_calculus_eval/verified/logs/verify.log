{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01F3n46ZEPHGQcHvAJvM5GPu","type":"tool_result","content":"1\tuse crate::common;\n2\tuse crate::reducer;\n3\t\n4\tpub struct Type {\n5\t    pub expr: common::AstNode,\n6\t    pub type_: String,\n7\t    pub return_type: String,\n8\t}\n9\t\n10\tpub struct TypeEnv {\n11\t    pub type_: Type,\n12\t    pub next: Option<Box<TypeEnv>>,\n13\t}\n14\t\n15\tpub fn assert_(expr: bool, error_msg: &str) {\n16\t    if expr {\n17\t        return;\n18\t    }\n19\t    common::error(error_msg, file!(), line!() as i32, \"assert_\");\n20\t}\n21\t\n22\tpub fn typecheck(expr: &common::AstNode, env: Option<&TypeEnv>) -> Type {\n23\t    match expr.type_ {\n24\t        common::AstNodeType::VAR => {\n25\t            let type_str = get_type_from_expr(expr);\n26\t            create_type(&type_str, \"\", expr)\n27\t        }\n28\t        common::AstNodeType::APPLICATION => {\n29\t            if let common::AstNodeUnion::Application(app) = &expr.node {\n30\t                let function_default = common::AstNode::default();\n31\t                let argument_default = common::AstNode::default();\n32\t                let func_ref =\n33\t                    app.function.as_deref().unwrap_or(&function_default);\n34\t                let arg_ref =\n35\t                    app.argument.as_deref().unwrap_or(&argument_default);\n36\t                let func_type = typecheck(func_ref, env);\n37\t                let arg_type = typecheck(arg_ref, env);\n38\t                assert_(type_equal(&func_type, &arg_type), \"Type mismatch.\");\n39\t                func_type\n40\t            } else {\n41\t                create_type(\"\", \"\", expr)\n42\t            }\n43\t        }\n44\t        common::AstNodeType::LAMBDA_EXPR => {\n45\t            let type_str = get_type_from_expr(expr);\n46\t            create_type(&type_str, \"\", expr)\n47\t        }\n48\t        common::AstNodeType::DEFINITION => create_type(\"\", \"\", expr),\n49\t    }\n50\t}\n51\t\n52\tpub fn type_equal(a: &Type, b: &Type) -> bool {\n53\t    let type_eql = a.type_ == b.type_;\n54\t    let return_eql = a.return_type == b.return_type;\n55\t    type_eql && return_eql\n56\t}\n57\t\n58\tpub fn get_type_from_expr(expr: &common::AstNode) -> String {\n59\t    match &expr.node {\n60\t        common::AstNodeUnion::Variable(v) => v.type_.clone(),\n61\t        common::AstNodeUnion::LambdaExpr(l) => l.type_.clone(),\n62\t        _ => String::new(),\n63\t    }\n64\t}\n65\t\n66\tpub fn p_print_type(t: &Type) {\n67\t    if !t.type_.is_empty() {\n68\t        println!(\"Type: {}\", t.type_);\n69\t    }\n70\t    if !t.return_type.is_empty() {\n71\t        println!(\"Return type: {}\", t.return_type);\n72\t    }\n73\t}\n74\t\n75\tpub fn create_type(\n76\t    type_: &str,\n77\t    return_type: &str,\n78\t    expr: &common::AstNode,\n79\t) -> Type {\n80\t    Type {\n81\t        type_: type_.to_string(),\n82\t        return_type: return_type.to_string(),\n83\t        expr: reducer::deepcopy(expr),\n84\t    }\n85\t}\n86\t\n87\tpub fn parse_function_type(type_: &str) -> Type {\n88\t    Type {\n89\t        type_: type_.to_string(),\n90\t        return_type: String::new(),\n91\t        expr: common::AstNode::default(),\n92\t    }\n93\t}\n94\t\n95\tpub fn expr_type_equal(t: &Type, expr: &common::AstNode) -> bool {\n96\t    // The C version compares pointer identity for `t->expr != expr`. Since we\n97\t    // can't compare pointers in safe Rust, we compare structurally on the\n98\t    // string representation.\n99\t    if common::ast_to_string(&t.expr) != common::ast_to_string(expr) {\n100\t        return false;\n101\t    }\n102\t\n103\t    let type_str = get_type_from_expr(expr);\n104\t    if type_str.is_empty() {\n105\t        // The C version aborts on null type; replicate the abort.\n106\t        common::error(\n107\t            \"ERROR: Null pointer encountered\",\n108\t            file!(),\n109\t            line!() as i32,\n110\t            \"expr_type_equal\",\n111\t        );\n112\t    }\n113\t\n114\t    let parsed_type = parse_function_type(&type_str);\n115\t\n116\t    if t.type_ != parsed_type.type_ {\n117\t        return false;\n118\t    }\n119\t\n120\t    if parsed_type.return_type.is_empty() {\n121\t        return t.return_type.is_empty();\n122\t    }\n123\t\n124\t    t.return_type == parsed_type.return_type\n125\t}\n126\t\n127\tpub fn add_to_env(env: &mut Option<Box<TypeEnv>>, type_: Type) {\n128\t    let prev = env.take();\n129\t    let new_env = Box::new(TypeEnv {\n130\t        type_,\n131\t        next: prev,\n132\t    });\n133\t    *env = Some(new_env);\n134\t}\n135\t\n136\tpub fn lookup_type(env: &TypeEnv, expr: &common::AstNode) -> Type {\n137\t    let mut current: Option<&TypeEnv> = Some(env);\n138\t    while let Some(node) = current {\n139\t        if expr_type_equal(&node.type_, expr) {\n140\t            return create_type(\n141\t                &node.type_.type_,\n142\t                &node.type_.return_type,\n143\t                &node.type_.expr,\n144\t            );\n145\t        }\n146\t        current = node.next.as_deref();\n147\t    }\n148\t    create_type(\"\", \"\", expr)\n149\t}\n150\t"}]},"parent_tool_use_id":null,"session_id":"e1eef4ca-d0e7-4181-92e4-a94c7e6dba4b","uuid":"677d2af3-452e-44c6-a128-171dccb7d0d4","timestamp":"2026-05-29T18:16:23.339Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-PjQdnV/project/src/typechecker.rs","content":"use crate::common;\nuse crate::reducer;\n\npub struct Type {\n    pub expr: common::AstNode,\n    pub type_: String,\n    pub return_type: String,\n}\n\npub struct TypeEnv {\n    pub type_: Type,\n    pub next: Option<Box<TypeEnv>>,\n}\n\npub fn assert_(expr: bool, error_msg: &str) {\n    if expr {\n        return;\n    }\n    common::error(error_msg, file!(), line!() as i32, \"assert_\");\n}\n\npub fn typecheck(expr: &common::AstNode, env: Option<&TypeEnv>) -> Type {\n    match expr.type_ {\n        common::AstNodeType::VAR => {\n            let type_str = get_type_from_expr(expr);\n            create_type(&type_str, \"\", expr)\n        }\n        common::AstNodeType::APPLICATION => {\n            if let common::AstNodeUnion::Application(app) = &expr.node {\n                let function_default = common::AstNode::default();\n                let argument_default = common::AstNode::default();\n                let func_ref =\n                    app.function.as_deref().unwrap_or(&function_default);\n                let arg_ref =\n                    app.argument.as_deref().unwrap_or(&argument_default);\n                let func_type = typecheck(func_ref, env);\n                let arg_type = typecheck(arg_ref, env);\n                assert_(type_equal(&func_type, &arg_type), \"Type mismatch.\");\n                func_type\n            } else {\n                create_type(\"\", \"\", expr)\n            }\n        }\n        common::AstNodeType::LAMBDA_EXPR => {\n            let type_str = get_type_from_expr(expr);\n            create_type(&type_str, \"\", expr)\n        }\n        common::AstNodeType::DEFINITION => create_type(\"\", \"\", expr),\n    }\n}\n\npub fn type_equal(a: &Type, b: &Type) -> bool {\n    let type_eql = a.type_ == b.type_;\n    let return_eql = a.return_type == b.return_type;\n    type_eql && return_eql\n}\n\npub fn get_type_from_expr(expr: &common::AstNode) -> String {\n    match &expr.node {\n        common::AstNodeUnion::Variable(v) => v.type_.clone(),\n        common::AstNodeUnion::LambdaExpr(l) => l.type_.clone(),\n        _ => String::new(),\n    }\n}\n\npub fn p_print_type(t: &Type) {\n    if !t.type_.is_empty() {\n        println!(\"Type: {}\", t.type_);\n    }\n    if !t.return_type.is_empty() {\n        println!(\"Return type: {}\", t.return_type);\n    }\n}\n\npub fn create_type(\n    type_: &str,\n    return_type: &str,\n    expr: &common::AstNode,\n) -> Type {\n    Type {\n        type_: type_.to_string(),\n        return_type: return_type.to_string(),\n        expr: reducer::deepcopy(expr),\n    }\n}\n\npub fn parse_function_type(type_: &str) -> Type {\n    Type {\n        type_: type_.to_string(),\n        return_type: String::new(),\n        expr: common::AstNode::default(),\n    }\n}\n\npub fn expr_type_equal(t: &Type, expr: &common::AstNode) -> bool {\n    // The C version compares pointer identity for `t->expr != expr`. Since we\n    // can't compare pointers in safe Rust, we compare structurally on the\n    // string representation.\n    if common::ast_to_string(&t.expr) != common::ast_to_string(expr) {\n        return false;\n    }\n\n    let type_str = get_type_from_expr(expr);\n    if type_str.is_empty() {\n        // The C version aborts on null type; replicate the abort.\n        common::error(\n            \"ERROR: Null pointer encountered\",\n            file!(),\n            line!() as i32,\n            \"expr_type_equal\",\n        );\n    }\n\n    let parsed_type = parse_function_type(&type_str);\n\n    if t.type_ != parsed_type.type_ {\n        return false;\n    }\n\n    if parsed_type.return_type.is_empty() {\n        return t.return_type.is_empty();\n    }\n\n    t.return_type == parsed_type.return_type\n}\n\npub fn add_to_env(env: &mut Option<Box<TypeEnv>>, type_: Type) {\n    let prev = env.take();\n    let new_env = Box::new(TypeEnv {\n        type_,\n        next: prev,\n    });\n    *env = Some(new_env);\n}\n\npub fn lookup_type(env: &TypeEnv, expr: &common::AstNode) -> Type {\n    let mut current: Option<&TypeEnv> = Some(env);\n    while let Some(node) = current {\n        if expr_type_equal(&node.type_, expr) {\n            return create_type(\n                &node.type_.type_,\n                &node.type_.return_type,\n                &node.type_.expr,\n            );\n        }\n        current = node.next.as_deref();\n    }\n    create_type(\"\", \"\", expr)\n}\n","numLines":150,"startLine":1,"totalLines":150}}}
