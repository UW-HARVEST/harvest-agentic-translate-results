node.lambda_expr->parameter, cp->node.lambda_expr->type,\n        cp->node.lambda_expr->body->type, cp->node.lambda_expr->body->node.variable->name);\n\n    // Test type_equal\n    Type *a = create_type(strdup(\"Nat\"), NULL, NULL);\n    Type *b = create_type(strdup(\"Nat\"), NULL, NULL);\n    Type *c = create_type(strdup(\"Bool\"), NULL, NULL);\n    printf(\"type_equal(a,b)=%d type_equal(a,c)=%d\\n\", type_equal(a, b), type_equal(a, c));\n\n    // Test get_type_from_expr\n    AstNode *vv = create_variable(strdup(\"test\"), strdup(\"Nat\"));\n    AstNode *vl = create_lambda(strdup(\"test\"), NULL, strdup(\"Bool\"));\n    printf(\"get_type_from_expr var=%s lambda=%s\\n\",\n        get_type_from_expr(vv), get_type_from_expr(vl));\n\n    // Test hash table search/insert\n    HashTable *ht = createHashTable();\n    AstNode *val = create_variable(strdup(\"v1\"), NULL);\n    insert(ht, \"key1\", val);\n    AstNode *found = search(ht, \"key1\");\n    printf(\"found name=%s\\n\", found ? found->node.variable->name : \"NULL\");\n    AstNode *not_found = search(ht, \"missing\");\n    printf(\"not_found=%p\\n\", (void*)not_found);\n    printf(\"table_exists(key1)=%d table_exists(missing)=%d\\n\",\n        table_exists(ht, \"key1\"), table_exists(ht, \"missing\"));\n\n    // null inserted\n    insert(ht, \"null_key\", NULL);\n    printf(\"table_exists(null_key)=%d search(null_key)=%p\\n\",\n        table_exists(ht, \"null_key\"), (void*)search(ht, \"null_key\"));\n\n    // Test replace\n    AstNode *rv = create_variable(strdup(\"test\"), NULL);\n    AstNode *rl = create_lambda(strdup(\"test\"), rv, strdup(\"Nat\"));\n    replace(rl, \"test\", \"replaced\");\n    printf(\"replace: lambda param=%s body name=%s\\n\",\n        rl->node.lambda_expr->parameter,\n        rl->node.lambda_expr->body->node.variable->name);\n\n    // Test reduce_ast for lambda only (no app)\n    HashTable *table = createHashTable();\n    AstNode *lbody = create_variable(strdup(\"x\"), NULL);\n    AstNode 