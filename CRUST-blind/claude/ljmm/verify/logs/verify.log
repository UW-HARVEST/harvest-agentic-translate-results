{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_015r1YmUEBQemtD64WYNVKbp","type":"tool_result","content":"1\t#include <sys/mman.h>\n2\t#include <unistd.h>\n3\t#include <stdint.h>\n4\t#include <fcntl.h>  /* for open(2) */\n5\t#include <stdio.h>  /* for snprintf */\n6\t#include <string.h>\n7\t\n8\t#ifdef DEBUG\n9\t    #include <stdlib.h>\n10\t    #define ASSERT(c) if (!(c))\\\n11\t        { fprintf(stderr, \"%s:%d Assert: %s\\n\", __FILE__, __LINE__, #c); abort(); }\n12\t#else\n13\t    #define ASSERT(c) ((void)0)\n14\t#endif\n15\t\n16\t#define unlikely(x) __builtin_expect((x),0)\n17\t#define likely(x)   __builtin_expect((x),1)\n18\t\n19\t#define REAL_MMAP __real_mmap64\n20\t#define WRAP_MMAP __wrap_mmap64\n21\t\n22\textern void * REAL_MMAP(void *addr, size_t length, int prot, int flags,\n23\t                        int fd, off_t offset);\n24\t\n25\ttypedef struct {\n26\t    uintptr_t   page_size;\n27\t    uintptr_t   page_mask;\n28\t\n29\t    uintptr_t   addr_upbound;\n30\t    uintptr_t   addr_lowbound;\n31\t\n32\t    char        *dummy_blk;\n33\t\n34\t    const char  *map_file; /* \"/proc/$PID/maps\" */\n35\t\n36\t    char        *buffer;   /* the buffer to read /proc/$PID/maps */\n37\t    int          buf_len;\n38\t\n39\t    /* it is up to OS to take care the 1G..2G space */\n40\t    char         OS_take_care_1G_2G;\n41\t    char         init_succ;\n42\t} ljmm_t;\n43\t\n44\tstatic ljmm_t ljmm;\n45\t\n46\tenum {\n47\t    BUFFER_SZ           = 8192,\n48\t    DUMMY_BLK_SZ        = 12,\n49\t    ADDR_2G             = 0x80000000,\n50\t    ADDR_1G             = 0x40000000,\n51\t};\n52\t\n53\t/* Initialize before the main() is entered */\n54\t__attribute__((constructor)) static void\n55\tljmm_init(void) {\n56\t    ljmm.OS_take_care_1G_2G =\n57\t#if defined(STRESS_TEST)\n58\t    0\n59\t#else\n60\t    1\n61\t#endif\n62\t    ;\n63\t\n64\t    ljmm.addr_lowbound = (uintptr_t)sbrk(0);\n65\t    ljmm.addr_upbound  = ADDR_2G;\n66\t\n67\t    ljmm.page_size = sysconf(_SC_PAGESIZE);\n68\t    ljmm.page_mask = ljmm.page_size - 1;\n69\t\n70\t    /* step 1: mmap() a tiny block to prevent heap from growing, whichby we\n71\t     *   reserve the space [sbrk(0) - 2G].\n72\t     */\n73\t    char* p = REAL_MMAP(sbrk(0), DUMMY_BLK_SZ, PROT_READ|PROT_WRITE,\n74\t                        MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);\n75\t    if (unlikely(p == MAP_FAILED)) {\n76\t        return;\n77\t    }\n78\t    ljmm.dummy_blk = p;\n79\t\n80\t    ljmm.map_file = \"/proc/self/maps\";\n81\t\n82\t    /* step 2: create buffer for reading content from /proc/$PID/maps */\n83\t    p = REAL_MMAP(NULL, BUFFER_SZ, PROT_READ|PROT_WRITE,\n84\t                  MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);\n85\t    if (unlikely(p == MAP_FAILED)) {\n86\t        return;\n87\t    }\n88\t    ljmm.buffer = p;\n89\t\n90\t    ljmm.init_succ = 1;\n91\t}\n92\t\n93\t/* This function will be called when the process exit normally.*/\n94\t__attribute__((destructor)) static void\n95\tljmm_finalize(void) {\n96\t    if (ljmm.dummy_blk && ljmm.dummy_blk != MAP_FAILED) {\n97\t        munmap(ljmm.dummy_blk, DUMMY_BLK_SZ);\n98\t        ljmm.dummy_blk = NULL;\n99\t        ljmm.map_file = NULL;\n100\t    }\n101\t\n102\t    if (ljmm.buffer && ljmm.buffer != MAP_FAILED) {\n103\t        munmap(ljmm.buffer, BUFFER_SZ);\n104\t    }\n105\t\n106\t    ljmm.init_succ = 0;\n107\t}\n108\t\n109\t/* Read the first \"BUFFER_SZ - 1\" bytes from the given files into ljmm.buffer. */\n110\tstatic int\n111\tread_maps_to_buffer(void) {\n112\t    int fd = open(ljmm.map_file, 0);\n113\t    if (fd == -1) {\n114\t        return -1;\n115\t    }\n116\t\n117\t    int len = read(fd, ljmm.buffer, BUFFER_SZ - 1);\n118\t    if (len >= 0 && ljmm.buffer[len-1] != '\\n') {\n119\t        ljmm.buffer[len++] = '\\n';\n120\t    }\n121\t\n122\t    close(fd);\n123\t\n124\t    ljmm.buf_len = len;\n125\t    return len;\n126\t}\n127\t\n128\t\n129\tstatic inline uintptr_t\n130\tpage_align_addr(uintptr_t addr) {\n131\t    return (addr + ljmm.page_size - 1) & ~ljmm.page_mask;\n132\t}\n133\t\n134\t\n135\t/* Parse the addr-string, stop at a char which is neither '0'-'9' nor\n136\t * 'a'-'f', nor ['A'-'F'].  The resulting address is saved to <addr_val>,\n137\t * and the number of char the address spans is returned to the called.\n138\t */\n139\tstatic int\n140\tparse_addr(const char* addr_str, uintptr_t *addr_val) {\n141\t    uintptr_t addr = 0;\n142\t    const char* p = addr_str;\n143\t    while (1) {\n144\t        char c = *p++;\n145\t        if (c >= '0' && c <= '9') {\n146\t            addr = addr * 16 + c - '0';\n147\t            continue;\n148\t        }\n149\t\n150\t        c |= 0x20;\n151\t        if (c >= 'a' && c <= 'f') {\n152\t            addr = addr * 16 + 10 + c - 'a';\n153\t            continue;\n154\t        }\n155\t\n156\t        *addr_val = addr;\n157\t        return p - 1 - addr_str;\n158\t    }\n159\t\n160\t    return 0;\n161\t}\n162\t\n163\t\n164\ttypedef struct {\n165\t    uintptr_t start;\n166\t    size_t size;\n167\t} mem_blk_t;\n168\t\n169\t\n170\t/* Going through the /proc/$PID/map in an attempt to find an unallocated hole\n171\t * that tightly/best fit the allocation request. Return the best-fit address\n172\t * if it prevailed, or NULL otherwise.\n173\t */\n174\tstatic uintptr_t\n175\tfind_best_fit(size_t length) {\n176\t    /* read the /proc/$PID/maps into the in-memory buffer */\n177\t    if (read_maps_to_buffer() < 0) {\n178\t        return 0;\n179\t    }\n180\t\n181\t    length = page_align_addr(length);\n182\t\n183\t    mem_blk_t best_fit, prev_blk;\n184\t    const char* buffer;\n185\t    int ofst, buf_len;\n186\t    uintptr_t upbound, lowbound;\n187\t\n188\t    lowbound = ljmm.addr_lowbound;\n189\t    upbound = ljmm.addr_upbound;\n190\t    best_fit.size = -1;\n191\t    best_fit.start = upbound;\n192\t    prev_blk.size = prev_blk.start = 0;\n193\t    ofst = 0;\n194\t    buffer = ljmm.buffer;\n195\t    buf_len = ljmm.buf_len;\n196\t\n197\t    /* iterate the /proc/$PID/maps, the fields of each line are:\n198\t     *   - address range:\n199\t     *   - permission\n200\t     *   - offset    : The offset of the file being mmapped. If it's not file\n201\t     *                 mapping, this column must take value 0.\n202\t     *   - dev       :\n203\t     *   - inode     : inode of file being mmapped or empty otherwise\n204\t     *   - pathname  : path of the file being mmaped or empty otherwise\n205\t     *\n206\t     * e.g\n207\t     * ...\n208\t     * 00618000-00619000 rw-p 00018000 08:02 13505427    /usr/lib/thunderbird/thunderbird\n209\t     * 7f2b4b200000-7f2b4b300000 rw-p 00000000 00:00 0\n210\t     * 7f2b4b400000-7f2b4ca00000 rw-p 00000000 00:00 0\n211\t     * ...\n212\t     *\n213\t     *  We only care about the address-ranges.\n214\t     */\n215\t    ASSERT(buffer[buf_len-1] == '\\n');\n216\t    while (ofst < buf_len) {\n217\t        uintptr_t start_addr, end_addr;\n218\t\n219\t        /* step 1: get the lower-bound of the address range */\n220\t        int advance = parse_addr(ljmm.buffer + ofst, &start_addr);\n221\t        if (advance && (buffer[ofst + advance] == '-')) {\n222\t            ofst += advance + 1;\n223\t        } else {\n224\t            /* the buffer is not large enough to accommodate /proc/$PID/map */\n225\t            break;\n226\t        }\n227\t\n228\t        /* step 2: get the upper bound of the address range */\n229\t        advance = parse_addr(buffer + ofst , &end_addr);\n230\t        if (advance && buffer[ofst + advance] == ' ') {\n231\t            ofst += advance + 1;\n232\t            ASSERT(ofst < buf_len);\n233\t            /* skip the rest of the line. */\n234\t            while (buffer[ofst++] != '\\n') {}\n235\t        } else {\n236\t            /* we can move on with incomplete up-bound address */\n237\t            end_addr = upbound >= start_addr ? upbound : start_addr;\n238\t        }\n239\t\n240\t        end_addr = page_align_addr(end_addr);\n241\t\n242\t        /* step 3: get the u