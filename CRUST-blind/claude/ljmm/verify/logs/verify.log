ng_sub(1);\n68\t\n69\t    // Allocate a buffer for reading /proc/self/maps content.\n70\t    state.buffer = vec![0u8; BUFFER_SZ];\n71\t    state.buf_len = 0;\n72\t\n73\t    // Reserve the equivalent of the dummy block (no-op in pure Rust).\n74\t    let _ = DUMMY_BLK_SZ;\n75\t\n76\t    state.map_file = Some(String::from(\"/proc/self/maps\"));\n77\t\n78\t    state.init_succ = true;\n79\t    0\n80\t}\n81\t\n82\t/// Instructs the OS to take care of the [1G..2G] space.\n83\t///\n84\t/// # Parameters\n85\t/// - `turn_on`: If non-zero, the OS should manage the space.\n86\tpub fn ljmm_let_os_take_care_1g_2g(turn_on: i32) {\n87\t    if let Ok(mut state) = LJMM.lock() {\n88\t        state.os_take_care_1g_2g = turn_on != 0;\n89\t    }\n90\t}\n91\t\n92\t/// Sets test parameters for the ljmm system.\n93\t///\n94\t/// # Parameters\n95\t/// - `map_file`: The mapping file name.\n96\t/// - `sbrk0`: An address representing the current program break (as a safe usize).\n97\t/// - `page_size`: The system's page size.\n98\tpub fn ljmm_test_set_test_param(map_file: &str, sbrk0: usize, page_size: i32) {\n99\t    if let Ok(mut state) = LJMM.lock() {\n100\t        state.map_file = Some(map_file.to_string());\n101\t        state.addr_lowbound = sbrk0;\n102\t\n103\t        // page-size must be a power-of-two\n104\t        debug_assert!(page_size > 0 && (page_size & (page_size - 1)) == 0);\n105\t        let ps = page_size as usize;\n106\t        state.page_size = ps;\n107\t        state.page_mask = ps.wrapping_sub(1);\n108\t    }\n109\t}\n110\t"}]},"parent_tool_use_id":null,"session_id":"1b634101-0ce7-48c0-9bd9-4244f131d6bf","uuid":"a6076cd4-1e9b-4c6c-9a23-e04e54904857","timestamp":"2026-05-29T18:50:11.379Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-Onye81/project/src/ljmm.rs","content":"use std::sync::Mutex;\n\nconst BUFFER_SZ: usize = 8192;\nconst DUMMY_BLK_SZ: usize = 12;\nconst ADDR_2G: usize = 0x80000000;\n#[allow(dead_code)]\nconst ADDR_1G: usize = 0x40000000;\n\nstruct LjmmState {\n    page_size: usize,\n    page_mask: usize,\n\n    addr_upbound: usize,\n    addr_lowbound: usize,\n\n    map_file: Option<String>,\n\n    buffer: Vec<u8>,\n    buf_len: usize,\n\n    /// it is up to OS to take care the 1G..2G space\n    os_take_care_1g_2g: bool,\n    init_succ: bool,\n}\n\nimpl LjmmState {\n    const fn new() -> Self {\n        LjmmState {\n            page_size: 0,\n            page_mask: 0,\n            addr_upbound: 0,\n            addr_lowbound: 0,\n            map_file: None,\n            buffer: Vec::new(),\n            buf_len: 0,\n            os_take_care_1g_2g: true,\n            init_succ: false,\n        }\n    }\n}\n\nfn get_page_size() -> usize {\n    // Default page size; in pure-Rust context without libc/FFI we assume 4096.\n    4096\n}\n\nstatic LJMM: Mutex<LjmmState> = Mutex::new(LjmmState::new());\n\n/// Initializes the ljmm system.\n///\n/// # Returns\n/// An integer status code.\npub fn ljmm_init() -> i32 {\n    let mut state = match LJMM.lock() {\n        Ok(s) => s,\n        Err(_) => return -1,\n    };\n\n    // STRESS_TEST is not defined in the build, so default to managed by OS.\n    state.os_take_care_1g_2g = true;\n\n    // We cannot call sbrk in safe Rust without FFI; default to 0.\n    state.addr_lowbound = 0;\n    state.addr_upbound = ADDR_2G;\n\n    state.page_size = get_page_size();\n    state.page_mask = state.page_size.wrapping_sub(1);\n\n    // Allocate a buffer for reading /proc/self/maps content.\n    state.buffer = vec![0u8; BUFFER_SZ];\n    state.buf_len = 0;\n\n    // Reserve the equivalent of the dummy block (no-op in pure Rust).\n    let _ = DUMMY_BLK_SZ;\n\n    state.map_file = Some(String::from(\"/proc/self/maps\"));\n\n    state.init_succ = true;\n    0\n}\n\n/// Instructs the OS to take care of the [1G..2G] space.\n///\n/// # Parameters\n/// - `turn_on`: If non-zero, the OS should manage the space.\npub fn ljmm_let_os_take_care_1g_2g(turn_on: i32) {\n    if let Ok(mut state) = LJMM.lock() {\n        state.os_take_care_1g_2g = turn_on != 0;\n    }\n}\n\n/// Sets test parameters for the ljmm system.\n///\n/// # Parameters\n/// - `map_file`: The mapping file name.\n/// - `sbrk0`: An address representing the current program break (as a safe usize).\n/// - `page_size`: The system's page size.\npub fn ljmm_test_set_test_param(map_file: &str, sbrk0: usize, page_size: i32) {\n    if let Ok(mut state) = LJMM.lock() {\n        state.map_file = Some(map_file.to_string());\n        state.addr_lowbound = sbrk0;\n\n        // page-size must be a power-of-two\n        debug_assert!(page_size > 0 && (page_size & (page_size - 1)) == 0);\n        let ps = page_size as usize;\n        state.page_size = ps;\n        state.page_mask = ps.wrapping_sub(1);\n    }\n}\n","numLines":110,"startLine":1,"totalLines":110}}}
