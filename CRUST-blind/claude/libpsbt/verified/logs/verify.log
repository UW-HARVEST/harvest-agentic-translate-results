{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01K46NVm3j4mgLpEFzSn8orc","type":"tool_result","content":"1\tuse crate::psbt::{PsbtResult, MAX_SERIALIZE_SIZE};\n2\t\n3\t/// Read a Bitcoin \"compact size\" integer from `data`. The slice must contain\n4\t/// at least the number of bytes returned by `compactsize_peek_length`.\n5\tpub fn compactsize_read(_data: &[u8]) -> (u64, PsbtResult) {\n6\t    if _data.is_empty() {\n7\t        return (0, PsbtResult::CompactReadError);\n8\t    }\n9\t\n10\t    let chsize = _data[0];\n11\t    let ret_size: u64;\n12\t\n13\t    if chsize < 253 {\n14\t        ret_size = chsize as u64;\n15\t    } else if chsize == 253 {\n16\t        if _data.len() < 1 + 2 {\n17\t            return (0, PsbtResult::CompactReadError);\n18\t        }\n19\t        ret_size = u16::from_le_bytes([_data[1], _data[2]]) as u64;\n20\t        if ret_size < 253 {\n21\t            return (0, PsbtResult::CompactReadError);\n22\t        }\n23\t    } else if chsize == 254 {\n24\t        if _data.len() < 1 + 4 {\n25\t            return (0, PsbtResult::CompactReadError);\n26\t        }\n27\t        ret_size = u32::from_le_bytes([_data[1], _data[2], _data[3], _data[4]]) as u64;\n28\t        if ret_size < 0x10000 {\n29\t            return (0, PsbtResult::CompactReadError);\n30\t        }\n31\t    } else {\n32\t        if _data.len() < 1 + 8 {\n33\t            return (0, PsbtResult::CompactReadError);\n34\t        }\n35\t        ret_size = u64::from_le_bytes([\n36\t            _data[1], _data[2], _data[3], _data[4], _data[5], _data[6], _data[7], _data[8],\n37\t        ]);\n38\t        if ret_size < 0x100000000 {\n39\t            return (0, PsbtResult::CompactReadError);\n40\t        }\n41\t    }\n42\t\n43\t    if ret_size > MAX_SERIALIZE_SIZE as u64 {\n44\t        return (0, PsbtResult::CompactReadError);\n45\t    }\n46\t\n47\t    (ret_size, PsbtResult::Ok)\n48\t}\n49\t\n50\t/// Return the number of bytes needed to encode a value of size `data` as