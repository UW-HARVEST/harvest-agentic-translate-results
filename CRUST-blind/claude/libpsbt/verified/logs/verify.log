em, user_data: &mut dyn std::any::Any) {\n132\t    if let Some(counter) = user_data.downcast_mut::<PsbtTxCounter>() {\n133\t        match elem {\n134\t            PsbtTxElem::TxIn(_) => counter.inputs += 1,\n135\t            PsbtTxElem::TxOut(_) => counter.outputs += 1,\n136\t            _ => {}\n137\t        }\n138\t    }\n139\t}\n140\t\n141\tfn psbt_close_records(psbt: &mut Psbt) -> PsbtResult {\n142\t    if psbt.write_pos + 1 > psbt.data_capacity {\n143\t        return PsbtResult::OobWrite;\n144\t    }\n145\t    psbt.data.push(0);\n146\t    psbt.write_pos += 1;\n147\t    PsbtResult::Ok\n148\t}\n149\t\n150\tfn psbt_write_header(psbt: &mut Psbt) -> PsbtResult {\n151\t    if psbt.write_pos + PSBT_MAGIC.len() > psbt.data_capacity {\n152\t        return PsbtResult::OobWrite;\n153\t    }\n154\t    psbt.data.extend_from_slice(&PSBT_MAGIC);\n155\t    psbt.write_pos += PSBT_MAGIC.len();\n156\t\n157\t    if psbt.write_pos + 1 > psbt.data_capacity {\n158\t        return PsbtResult::OobWrite;\n159\t    }\n160\t    psbt.data.push(0xff);\n161\t    psbt.write_pos += 1;\n162\t\n163\t    psbt.state = PsbtState::Global;\n164\t    PsbtResult::Ok\n165\t}\n166\t\n167\tfn psbt_write_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n168\t    let key_size_with_type = rec.key.len() as u64 + 1;\n169\t\n170\t    // write key length\n171\t    let size = compactsize_length(key_size_with_type) as usize;\n172\t    if psbt.write_pos + size > psbt.data_capacity {\n173\t        return PsbtResult::OobWrite;\n174\t    }\n175\t    let mut buf = [0u8; 9];\n176\t    compactsize_write(&mut buf, key_size_with_type);\n177\t    psbt.data.extend_from_slice(&buf[..size]);\n178\t    psbt.write_pos += size;\n179\t\n180\t    // write type\n181\t    if psbt.write_pos + 1 > psbt.data_capacity {\n182\t        return PsbtResult::OobWrite;\n183\t    }\n184\t    psbt.data.push(rec.record_type);\n185\t    psbt.write_pos += 1;\n186\t\n187\t    // write key\n188\t    if psbt.write_pos + rec.key.len() > psbt.data_capacity {\n189\t        return PsbtResult::OobWrite;\n190\t    }\n191\t    psbt.data.extend_from_slice(&rec.key);\n192\t    psbt.write_pos += rec.key.len();\n193\t\n194\t    // write value length\n195\t    let size = compactsize_length(rec.val.len() as u64) as usize;\n196\t    if psbt.write_pos + size > psbt.data_capacity {\n197\t        return PsbtResult::OobWrite;\n198\t    }\n199\t    let mut buf = [0u8; 9];\n200\t    compactsize_write(&mut buf, rec.val.len() as u64);\n201\t    psbt.data.extend_from_slice(&buf[..size]);\n202\t    psbt.write_pos += size;\n203\t\n204\t    // write value\n205\t    if psbt.write_pos + rec.val.len() > psbt.data_capacity {\n206\t        return PsbtResult::OobWrite;\n207\t    }\n208\t    psbt.data.extend_from_slice(&rec.val);\n209\t    psbt.write_pos += rec.val.len();\n210\t\n211\t    PsbtResult::Ok\n212\t}\n213\t\n214\tfn psbt_read_header(psbt: &mut Psbt) -> PsbtResult {\n215\t    if psbt.write_pos + 4 > psbt.data.len() {\n216\t        return PsbtResult::ReadError;\n217\t    }\n218\t    if psbt.data[psbt.write_pos..psbt.write_pos + 4] != PSBT_MAGIC {\n219\t        return PsbtResult::ReadError;\n220\t    }\n221\t    psbt.write_pos += 4;\n222\t\n223\t    if psbt.write_pos >= psbt.data.len() {\n224\t        return PsbtResult::ReadError;\n225\t    }\n226\t    if psbt.data[psbt.write_pos] != 0xff {\n227\t        return PsbtResult::ReadError;\n228\t    }\n229\t    psbt.write_pos += 1;\n230\t\n231\t    psbt.state = PsbtState::Global;\n232\t    PsbtResult::Ok\n233\t}\n234\t\n235\tfn psbt_read_record(psbt: &mut Psbt, src_size: usize) -> Result<PsbtRecord, PsbtResult> {\n236\t    if psbt.write_pos >= psbt.data.len() {\n237\t        return Err(PsbtResult::ReadError);\n238\t    }\n239\t    let size_len = compactsize_peek_length(psbt.data[psbt.write_pos]) as usize;\n240\t    if psbt.write_pos + size_len > psbt.data_capacity {\n241\t        return Err(PsbtResult::ReadError);\n242\t    }\n243\t    let (size, res) = compactsize_read(&psbt.data[psbt.write_pos..]);\n244\t    if res != PsbtResult::Ok {\n245\t        return Err(res);\n246\t    }\n247\t    psbt.write_pos += size_len;\n248\t\n249\t    if psbt.write_pos + size as usize > psbt.data.len()\n250\t        || psbt.write_pos + size as usize > src_size\n251\t    {\n252\t        return Err(PsbtResult::ReadError);\n253\t    }\n254\t    if psbt.write_pos + size as usize > psbt.data_capacity {\n255\t        return Err(PsbtResult::ReadError);\n256\t    }\n257\t\n258\t    let key_size = (size - 1) as usize;\n259\t    let record_type = psbt.data[psbt.write_pos];\n260\t    let key = psbt.data[psbt.write_pos + 1..psbt.write_pos + 1 + key_size].to_vec();\n261\t    psbt.write_pos += size as usize;\n262\t\n263\t    let scope = match psbt.state {\n264\t        PsbtState::Global => PsbtScope::Global,\n265\t        PsbtState::Inputs => PsbtScope::Inputs,\n266\t        PsbtState::Outputs => PsbtScope::Outputs,\n267\t        _ => return Err(PsbtResult::InvalidState),\n268\t    };\n269\t\n270\t    if psbt.write_pos >= psbt.data.len() {\n271\t        return Err(PsbtResult::ReadError);\n272\t    }\n273\t    let size_len = compactsize_peek_length(psbt.data[psbt.write_pos]) as usize;\n274\t    if psbt.write_pos + size_len > psbt.data_capacity {\n275\t        return Err(PsbtResult::ReadError);\n276\t    }\n277\t    let (val_size, res) = compactsize_read(&psbt.data[psbt.write_pos..]);\n278\t    if res != PsbtResult::Ok {\n279\t        return Err(res);\n280\t    }\n281\t    psbt.write_pos += size_len;\n282\t\n283\t    if psbt.write_pos + val_size as usize > psbt.data.len()\n284\t        || psbt.write_pos + val_size as usize > src_size\n285\t    {\n286\t        return Err(PsbtResult::ReadError);\n287\t    }\n288\t    if psbt.write_pos + val_size as usize > psbt.data_capacity {\n289\t        return Err(PsbtResult::ReadError);\n290\t    }\n291\t\n292\t    let val = psbt.data[psbt.write_pos..psbt.write_pos + val_size as usize].to_vec();\n293\t    psbt.write_pos += val_size as usize;\n294\t\n295\t    Ok(PsbtRecord {\n296\t        record_type,\n297\t        key,\n298\t        val,\n299\t        scope,\n300\t    })\n301\t}\n302\t\n303\tfn hexchar(val: u8) -> u8 {\n304\t    if val < 10 {\n305\t        b'0' + val\n306\t    } else {\n307\t        b'a' + val - 10\n308\t    }\n309\t}\n310\t\n311\tfn hexdigit(c: u8) -> u8 {\n312\t    if c <= b'9' {\n313\t        c - b'0'\n314\t    } else {\n315\t        c.to_ascii_uppercase() - b'A' + 10\n316\t    }\n317\t}\n318\t\n319\tfn psbt_hex_decode(src: &[u8], dest: &mut [u8], dest_size: usize) -> PsbtResult {\n320\t    if src.len() % 2 != 0 {\n321\t        return PsbtResult::ReadError;\n322\t    }\n323\t    if dest_size < src.len() / 2 {\n324\t        return PsbtResult::ReadError;\n325\t    }\n326\t    if dest.len() < src.len() / 2 {\n327\t        return PsbtResult::ReadError;\n328\t    }\n329\t    for i in 0..(src.len() / 2) {\n330\t        let c1 = src[i * 2];\n331\t        let c2 = src[i * 2 + 1];\n332\t        if !c1.is_ascii_hexdigit() || !c2.is_ascii_hexdigit() {\n333\t            return PsbtResult::ReadError;\n334\t        }\n335\t        dest[i] = (hexdigit(c1) << 4) | hexdigit(c2);\n336\t    }\n337\t    PsbtResult::Ok\n338\t}\n339\t\n340\tfn hex_encode(src: &[u8], dest: &mut [u8], dest_size: usize) -> PsbtResult {\n341\t    if dest_size < src.len() * 2 + 1 {\n342\t        return PsbtResult::OobWrite;\n343\t    }\n344\t    if dest.len() < src.len() * 2 + 1 {\n345\t        return PsbtResult::OobWrite;\n346\t    }\n347\t    for (i, &c) in src.iter().enumerate() {\n348\t        dest[i * 2] = hexchar(c >> 4);\n349\t        dest[i * 2 + 1] = hexchar(c & 0xF);\n350\t    }\n351\t    dest[src.len() * 2] = 0;\n352\t    PsbtResult::Ok\n353\t}\n354\t\n355\t// ---- Public API ----\n356\t\n357\t/// Return the number of bytes stored in the PSBT.\n358\tpub fn psbt_size(tx: &Psbt) -> usize {\n359\t    tx.data.len()\n360\t}\n361\t\n362\t/// Parse a PSBT from `src` into `psbt`, optionally invoking `elem_handler`\n363\t/// for each record encountered.\n364\tpub fn psbt_read(\n365\t    src: &[u8],\n366\t    _src_size: usize,\n367\t    psbt: &mut Psbt,\n368\t    elem_handler: Option<PsbtElemHandler>,\n369\t    user_data: &mut dyn std::any::Any,\n370\t) -> PsbtResult {\n371\t    if psbt.state != PsbtState::Init {\n372\t        return PsbtResult::InvalidState;\n373\t    }\n374\t    if src.len() > psbt.data_capacity {\n375\t        return PsbtResult::OobWrite;\n376\t    }\n377\t\n378\t    psbt.data.clear();\n379\t    psbt.data.extend_from_slice(src);\n380\t    psbt.write_pos = 0;\n381\t    psbt.state = PsbtState::Init;\n382\t    psbt.data_capacity = src.len();\n383\t\n384\t    let src_size = src.len();\n385\t    let mut counter = PsbtTxCounter {\n386\t        inputs: 0,\n387\t        outputs: 0,\n388\t    };\n389\t    let mut kvs: i32 = 0;\n390\t\n391\t    while psbt.state != PsbtState::Finalized && psbt.write_pos <= src_size {\n392\t        match psbt.state {\n393\t            PsbtState::Init => {\n394\t                let res = psbt_read_header(psbt);\n395\t                if res != PsbtResult::Ok {\n396\t                    return res;\n397\t                }\n398\t            }\n399\t            PsbtState::Global | PsbtState::Inputs | PsbtState::Outputs => {\n400\t                if psbt.write_pos >= psbt.data.len() {\n401\t                    return PsbtResult::ReadError;\n402\t                }\n403\t                if psbt.data[psbt.write_pos] == 0 {\n404\t                    let new_state = match psbt.state {\n405\t                        PsbtState::Global => PsbtState::InputsNew,\n406\t                        PsbtState::Inputs => {\n407\t                            kvs += 1;\n408\t                            if kvs >= counter.inputs {\n409\t                                kvs = 0;\n410\t                                PsbtState::OutputsNew\n411\t                            } else {\n412\t                                PsbtState::InputsNew\n413\t                            }\n414\t                        }\n415\t                        PsbtState::Outputs => {\n416\t                            kvs += 1;\n417\t                            if kvs >= counter.outputs {\n418\t                                PsbtState::Finalized\n419\t                            } else {\n420\t                                PsbtState::OutputsNew\n421\t                            }\n422\t                        }\n423\t                        _ => unreachable!(),\n424\t                    };\n425\t                    psbt.state = new_state;\n426\t                } else {\n427\t                    let rec = match psbt_read_record(psbt, src_size) {\n428\t                        Ok(r) => r,\n429\t                        Err(e) => return e,\n430\t                    };\n431\t\n432\t                    if psbt.state == PsbtState::Global\n433\t                        && rec.record_type == PsbtGlobalType::UnsignedTx as u8\n434\t                    {\n435\t                        let val_len = rec.val.len();\n436\t                        let res = psbt_btc_tx_parse(\n437\t                            &rec.val,\n438\t                            val_len,\n439\t                            &mut counter,\n440\t                            Some(tx_counter_handler),\n441\t                        );\n442\t                        if res != PsbtResult::Ok {\n443\t                            return res;\n444\t                        }\n445\t                    }\n446\t\n447\t                    if let Some(handler) = elem_handler {\n448\t                        let mut elem = PsbtElem::Record {\n449\t                            index: kvs,\n450\t                            record: rec,\n451\t                        };\n452\t                        handler(&mut elem, user_data);\n453\t                    }\n454\t                }\n455\t            }\n456\t            PsbtState::OutputsNew => {\n457\t                if psbt.write_pos >= psbt.data.len() || psbt.data[psbt.write_pos] != 0 {\n458\t                    return PsbtResult::ReadError;\n459\t                }\n460\t                psbt.write_pos += 1;\n461\t                psbt.state = PsbtState::Outputs;\n462\t            }\n463\t            PsbtState::InputsNew => {\n464\t                if psbt.write_pos >= psbt.data.len() || psbt.data[psbt.write_pos] != 0 {\n465\t                    return PsbtResult::ReadError;\n466\t                }\n467\t                psbt.write_pos += 1;\n468\t                psbt.state = PsbtState::Inputs;\n469\t            }\n470\t            PsbtState::Finalized => break,\n471\t        }\n472\t    }\n473\t\n474\t    if psbt.state != PsbtState::Finalized {\n475\t        return PsbtResult::InvalidState;\n476\t    }\n477\t    if psbt.write_pos < psbt.data.len() && psbt.data[psbt.write_pos] != 0 {\n478\t        return PsbtResult::ReadError;\n479\t    }\n480\t    psbt.write_pos += 1;\n481\t\n482\t    PsbtResult::Ok\n483\t}\n484\t\n485\t/// Decode a PSBT (either base64 or hex) into `dest`.\n486\tpub fn psbt_decode(\n487\t    src: &str,\n488\t    _src_size: usize,\n489\t    dest: &mut [u8],\n490\t    dest_size: usize,\n491\t    psbt_len: &mut usize,\n492\t) -> PsbtResult {\n493\t    let bytes = src.as_bytes();\n494\t    let b64_magic = b\"cHNid\";\n495\t\n496\t    if bytes.len() < b64_magic.len() {\n497\t        return PsbtResult::ReadError;\n498\t    }\n499\t\n500\t    if &bytes[..b64_magic.len()] == b64_magic {\n501\t        match base64_decode(bytes, dest) {\n502\t            Some(n) => {\n503\t                *psbt_len = n;\n504\t                PsbtResult::Ok\n505\t            }\n506\t            None => PsbtResult::ReadError,\n507\t        }\n508\t    } else {\n509\t        *psbt_len = bytes.len() / 2;\n510\t        psbt_hex_decode(bytes, dest, dest_size)\n511\t    }\n512\t}\n513\t\n514\t/// Encode the PSBT data into a destination buffer using the requested encoding.\n515\tpub fn psbt_encode(\n516\t    psbt: &Psbt,\n517\t    encoding: PsbtEncoding,\n518\t    dest: &mut [u8],\n519\t    dest_size: usize,\n520\t    out_len: &mut usize,\n521\t) -> PsbtResult {\n522\t    if psbt.state != PsbtState::Finalized {\n523\t        return PsbtResult::WriteError;\n524\t    }\n525\t    psbt_encode_raw(&psbt.data, psbt.data.len(), encoding, dest, dest_size, out_len)\n526\t}\n527\t\n528\t/// Encode raw PSBT data into dest using the requested encoding.\n529\tpub fn psbt_encode_raw(\n530\t    psbt_data: &[u8],\n531\t    _psbt_len: usize,\n532\t    encoding: PsbtEncoding,\n533\t    dest: &mut [u8],\n534\t    dest_size: usize,\n535\t    out_len: &mut usize,\n536\t) -> PsbtResult {\n537\t    match encoding {\n538\t        PsbtEncoding::Hex => {\n539\t            let res = hex_encode(psbt_data, dest, dest_size);\n540\t            *out_len = psbt_data.len() * 2 + 1;\n541\t            res\n542\t        }\n543\t        PsbtEncoding::Base64 => match base64_encode(psbt_data, dest) {\n544\t            Some(n) => {\n545\t                *out_len = n;\n546\t                PsbtResult::Ok\n547\t            }\n548\t            None => PsbtResult::WriteError,\n549\t        },\n550\t        PsbtEncoding::Base62 => match base62_encode(psbt_data, dest) {\n551\t            Some(n) => {\n552\t                *out_len = n;\n553\t                PsbtResult::Ok\n554\t            }\n555\t            None => PsbtResult::WriteError,\n556\t        },\n557\t        PsbtEncoding::Protobuf => PsbtResult::NotImplemented,\n558\t    }\n559\t}\n560\t\n561\t/// Return the last error message.\n562\tpub fn psbt_geterr() -> &'static str {\n563\t    PSBT_ERRMSG\n564\t}\n565\t\n566\t/// Convert a PSBT state to a human–readable string.\n567\tpub fn psbt_state_tostr(state: PsbtState) -> &'static str {\n568\t    match state {\n569\t        PsbtState::Init => \"INIT\",\n570\t        PsbtState::Global => \"GLOBAL\",\n571\t        PsbtState::Inputs => \"INPUTS\",\n572\t        PsbtState::InputsNew => \"INPUTS_NEW\",\n573\t        PsbtState::Outputs => \"OUTPUTS\",\n574\t        PsbtState::OutputsNew => \"OUTPUTS_NEW\",\n575\t        PsbtState::Finalized => \"FINALIZED\",\n576\t    }\n577\t}\n578\t\n579\t/// Return a string for a record type and scope.\n580\tpub fn psbt_type_tostr(record_type: u8, scope: PsbtScope) -> &'static str {\n581\t    match scope {\n582\t        PsbtScope::Global => match record_type {\n583\t            0 => psbt_global_type_tostr(PsbtGlobalType::UnsignedTx),\n584\t            _ => \"UNKNOWN_GLOBAL_TYPE\",\n585\t        },\n586\t        PsbtScope::Inputs => match record_type {\n587\t            0 => psbt_input_type_tostr(PsbtInputType::NonWitnessUtxo),\n588\t            1 => psbt_input_type_tostr(PsbtInputType::WitnessUtxo),\n589\t            2 => psbt_input_type_tostr(PsbtInputType::PartialSig),\n590\t            3 => psbt_input_type_tostr(PsbtInputType::SighashType),\n591\t            4 => psbt_input_type_tostr(PsbtInputType::RedeemScript),\n592\t            5 => psbt_input_type_tostr(PsbtInputType::WitnessScript),\n593\t            6 => psbt_input_type_tostr(PsbtInputType::Bip32Derivation),\n594\t            7 => psbt_input_type_tostr(PsbtInputType::FinalScriptSig),\n595\t            8 => psbt_input_type_tostr(PsbtInputType::FinalScriptWitness),\n596\t            _ => \"UNKNOWN_INPUT_TYPE\",\n597\t        },\n598\t        PsbtScope::Outputs => match record_type {\n599\t            0 => psbt_output_type_tostr(PsbtOutputType::RedeemScript),\n600\t            1 => psbt_output_type_tostr(PsbtOutputType::WitnessScript),\n601\t            2 => psbt_output_type_tostr(PsbtOutputType::Bip32Derivation),\n602\t            _ => \"UNKNOWN_OUTPUT_TYPE\",\n603\t        },\n604\t    }\n605\t}\n606\t\n607\t/// Return a string for a psbt_txelem type.\n608\tpub fn psbt_txelem_type_tostr(txelem_type: PsbtTxElemType) -> &'static str {\n609\t    match txelem_type {\n610\t        PsbtTxElemType::Tx => \"TX\",\n611\t        PsbtTxElemType::TxIn => \"TXIN\",\n612\t        PsbtTxElemType::TxOut => \"TXOUT\",\n613\t        PsbtTxElemType::WitnessItem => \"WITNESS_ITEM\",\n614\t    }\n615\t}\n616\t\n617\tpub fn psbt_global_type_tostr(gt: PsbtGlobalType) -> &'static str {\n618\t    match gt {\n619\t        PsbtGlobalType::UnsignedTx => \"GLOBAL_UNSIGNED_TX\",\n620\t    }\n621\t}\n622\t\n623\tpub fn psbt_output_type_tostr(ot: PsbtOutputType) -> &'static str {\n624\t    match ot {\n625\t        PsbtOutputType::RedeemScript => \"OUT_REDEEM_SCRIPT\",\n626\t        PsbtOutputType::WitnessScript => \"OUT_WITNESS_SCRIPT\",\n627\t        PsbtOutputType::Bip32Derivation => \"OUT_BIP32_DERIVATION\",\n628\t    }\n629\t}\n630\t\n631\tpub fn psbt_input_type_tostr(it: PsbtInputType) -> &'static str {\n632\t    match it {\n633\t        PsbtInputType::NonWitnessUtxo => \"IN_NON_WITNESS_UTXO\",\n634\t        PsbtInputType::WitnessUtxo => \"IN_WITNESS_UTXO\",\n635\t        PsbtInputType::PartialSig => \"IN_PARTIAL_SIG\",\n636\t        PsbtInputType::SighashType => \"IN_SIGHASH_TYPE\",\n637\t        PsbtInputType::RedeemScript => \"IN_REDEEM_SCRIPT\",\n638\t        PsbtInputType::WitnessScript => \"IN_WITNESS_SCRIPT\",\n639\t        PsbtInputType::Bip32Derivation => \"IN_BIP32_DERIVATION\",\n640\t        PsbtInputType::FinalScriptSig => \"IN_FINAL_SCRIPTSIG\",\n641\t        PsbtInputType::FinalScriptWitness => \"IN_FINAL_SCRIPTWITNESS\",\n642\t    }\n643\t}\n644\t\n645\t/// Write a global record into the PSBT.\n646\tpub fn psbt_write_global_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n647\t    if psbt.state == PsbtState::Init {\n648\t        let res = psbt_write_header(psbt);\n649\t        if res != PsbtResult::Ok {\n650\t            return res;\n651\t        }\n652\t        psbt.state = PsbtState::Global;\n653\t    } else if psbt.state != PsbtState::Global {\n654\t        return PsbtResult::InvalidState;\n655\t    }\n656\t    psbt_write_record(psbt, rec)\n657\t}\n658\t\n659\t/// Write an input record into the PSBT.\n660\tpub fn psbt_write_input_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n661\t    if psbt.state == PsbtState::Global {\n662\t        let res = psbt_close_records(psbt);\n663\t        if res != PsbtResult::Ok {\n664\t            return res;\n665\t        }\n666\t        psbt.state = PsbtState::Inputs;\n667\t    } else if psbt.state != PsbtState::Inputs && psbt.state != PsbtState::InputsNew {\n668\t        return PsbtResult::InvalidState;\n669\t    }\n670\t    psbt_write_record(psbt, rec)\n671\t}\n672\t\n673\t/// Write an output record into the PSBT.\n674\tpub fn psbt_write_output_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n675\t    if psbt.state == PsbtState::Inputs {\n676\t        let res = psbt_close_records(psbt);\n677\t        if res != PsbtResult::Ok {\n678\t            return res;\n679\t        }\n680\t        psbt.state = PsbtState::Outputs;\n681\t    } else if psbt.state != PsbtState::Outputs && psbt.state != PsbtState::OutputsNew {\n682\t        return PsbtResult::InvalidState;\n683\t    }\n684\t    psbt_write_record(psbt, rec)\n685\t}\n686\t\n687\t/// Create a new input record set.\n688\tpub fn psbt_new_input_record_set(_psbt: &mut Psbt) -> PsbtResult {\n689\t    if matches!(\n690\t        _psbt.state,\n691\t        PsbtState::Global | PsbtState::InputsNew | PsbtState::Inputs\n692\t    ) {\n693\t        let res = psbt_close_records(_psbt);\n694\t        if res != PsbtResult::Ok {\n695\t            return res;\n696\t        }\n697\t        _psbt.state = PsbtState::InputsNew;\n698\t        PsbtResult::Ok\n699\t    } else {\n700\t        PsbtResult::InvalidState\n701\t    }\n702\t}\n703\t\n704\t/// Create a new output record set.\n705\tpub fn psbt_new_output_record_set(psbt: &mut Psbt) -> PsbtResult {\n706\t    if matches!(\n707\t        psbt.state,\n708\t        PsbtState::Inputs | PsbtState::InputsNew | PsbtState::OutputsNew | PsbtState::Outputs\n709\t    ) {\n710\t        let res = psbt_close_records(psbt);\n711\t        if res != PsbtResult::Ok {\n712\t            return res;\n713\t        }\n714\t        psbt.state = PsbtState::OutputsNew;\n715\t        PsbtResult::Ok\n716\t    } else {\n717\t        PsbtResult::InvalidState\n718\t    }\n719\t}\n720\t\n721\t/// Initialize a PSBT using the given destination buffer.\n722\tpub fn psbt_init(psbt: &mut Psbt, _dest: &mut [u8], dest_size: usize) -> PsbtResult {\n723\t    psbt.data.clear();\n724\t    psbt.write_pos = 0;\n725\t    psbt.data_capacity = dest_size;\n726\t    psbt.state = PsbtState::Init;\n727\t    psbt.records.clear();\n728\t    PsbtResult::Ok\n729\t}\n730\t\n731\t/// Print the PSBT (only succeeds after finalization).\n732\tpub fn psbt_print(psbt: &Psbt, stream: &mut dyn std::io::Write) -> PsbtResult {\n733\t    if psbt.state != PsbtState::Finalized {\n734\t        return PsbtResult::InvalidState;\n735\t    }\n736\t    let size = psbt_size(psbt);\n737\t    for i in 0..size {\n738\t        let _ = write!(stream, \"{:02x}\", psbt.data[i]);\n739\t    }\n740\t    let _ = writeln!(stream);\n741\t    PsbtResult::Ok\n742\t}\n743\t\n744\t/// Finalize the PSBT.\n745\tpub fn psbt_finalize(psbt: &mut Psbt) -> PsbtResult {\n746\t    if psbt.state != PsbtState::OutputsNew && psbt.state != PsbtState::Outputs {\n747\t        return PsbtResult::InvalidState;\n748\t    }\n749\t    let res = psbt_close_records(psbt);\n750\t    if res != PsbtResult::Ok {\n751\t        return res;\n752\t    }\n753\t    psbt.state = PsbtState::Finalized;\n754\t    PsbtResult::Ok\n755\t}\n756\t"}]},"parent_tool_use_id":null,"session_id":"89f34a1e-00a2-4f57-bae4-f2b5305ef99b","uuid":"a8fceaa3-dfc6-44a5-9f5d-11f748a104d8","timestamp":"2026-05-29T18:30:35.877Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-s2UdjO/project/src/psbt.rs","content":"use crate::base64::{base62_encode, base64_decode, base64_encode};\nuse crate::compactsize::{\n    compactsize_length, compactsize_peek_length, compactsize_read, compactsize_write,\n};\nuse crate::tx::*;\nuse std::fmt;\n// Common constant from common.h\npub const MAX_SERIALIZE_SIZE: u32 = 0x02000000;\n// --- Enum definitions ---\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtResult {\n    Ok,\n    CompactReadError,\n    ReadError,\n    WriteError,\n    InvalidState,\n    NotImplemented,\n    OobWrite,\n}\nimpl fmt::Display for PsbtResult {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"{:?}\", self)\n    }\n}\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtGlobalType {\n    UnsignedTx = 0,\n}\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtEncoding {\n    Hex,\n    Base64,\n    Base62,\n    Protobuf,\n}\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtInputType {\n    NonWitnessUtxo = 0,\n    WitnessUtxo = 1,\n    PartialSig = 2,\n    SighashType = 3,\n    RedeemScript = 4,\n    WitnessScript = 5,\n    Bip32Derivation = 6,\n    FinalScriptSig = 7,\n    FinalScriptWitness = 8,\n}\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtOutputType {\n    RedeemScript = 0,\n    WitnessScript = 1,\n    Bip32Derivation = 2,\n}\n#[derive(Debug, PartialEq, Eq, Clone)]\npub enum PsbtScope {\n    Global,\n    Inputs,\n    Outputs,\n}\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtState {\n    Init = 2,\n    Global,\n    Inputs,\n    InputsNew,\n    Outputs,\n    OutputsNew,\n    Finalized,\n}\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtElemType {\n    Record,\n    TxElem,\n}\n#[derive(Debug, PartialEq, Eq)]\npub enum PsbtTxElemType {\n    TxIn,\n    TxOut,\n    Tx,\n    WitnessItem,\n}\n// --- Struct definitions ---\n/// Translates the C struct psbt.\n/// (Here we use a Vec<u8> to hold the PSBT data and a write position index.)\npub struct Psbt {\n    pub state: PsbtState,\n    pub data: Vec<u8>,\n    pub write_pos: usize,\n    pub data_capacity: usize,\n    // For simulation purposes we keep a list of records.\n    pub records: Vec<PsbtRecord>,\n}\nimpl Psbt {\n    pub fn new(capacity: usize) -> Self {\n        Self {\n            state: PsbtState::Init,\n            data: Vec::with_capacity(capacity),\n            write_pos: 0,\n            data_capacity: capacity,\n            records: Vec::new(),\n        }\n    }\n}\n/// Translates the C struct psbt_record.\npub struct PsbtRecord {\n    /// (The C field “type” is renamed to avoid conflict with the Rust keyword.)\n    pub record_type: u8,\n    pub key: Vec<u8>,\n    pub val: Vec<u8>,\n    pub scope: PsbtScope,\n}\n/// Translates the C union (record/txelem) in psbt_elem into an enum.\npub enum PsbtElem {\n    Record { index: i32, record: PsbtRecord },\n    TxElem { index: i32, txelem: PsbtTxElem },\n}\n/// The C typedef for a handler function.\npub type PsbtElemHandler = fn(elem: &mut PsbtElem, user_data: &mut dyn std::any::Any);\n// External constants\npub const PSBT_MAGIC: [u8; 4] = [0x70, 0x73, 0x62, 0x74]; // \"psbt\"\npub static PSBT_ERRMSG: &str = \"psbt error\";\n\n// ---- Internal helpers ----\n\n/// State carried while psbt_read is parsing the unsigned transaction record.\nstruct PsbtTxCounter {\n    inputs: i32,\n    outputs: i32,\n}\n\nfn tx_counter_handler(elem: &mut PsbtTxElem, user_data: &mut dyn std::any::Any) {\n    if let Some(counter) = user_data.downcast_mut::<PsbtTxCounter>() {\n        match elem {\n            PsbtTxElem::TxIn(_) => counter.inputs += 1,\n            PsbtTxElem::TxOut(_) => counter.outputs += 1,\n            _ => {}\n        }\n    }\n}\n\nfn psbt_close_records(psbt: &mut Psbt) -> PsbtResult {\n    if psbt.write_pos + 1 > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    psbt.data.push(0);\n    psbt.write_pos += 1;\n    PsbtResult::Ok\n}\n\nfn psbt_write_header(psbt: &mut Psbt) -> PsbtResult {\n    if psbt.write_pos + PSBT_MAGIC.len() > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    psbt.data.extend_from_slice(&PSBT_MAGIC);\n    psbt.write_pos += PSBT_MAGIC.len();\n\n    if psbt.write_pos + 1 > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    psbt.data.push(0xff);\n    psbt.write_pos += 1;\n\n    psbt.state = PsbtState::Global;\n    PsbtResult::Ok\n}\n\nfn psbt_write_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n    let key_size_with_type = rec.key.len() as u64 + 1;\n\n    // write key length\n    let size = compactsize_length(key_size_with_type) as usize;\n    if psbt.write_pos + size > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    let mut buf = [0u8; 9];\n    compactsize_write(&mut buf, key_size_with_type);\n    psbt.data.extend_from_slice(&buf[..size]);\n    psbt.write_pos += size;\n\n    // write type\n    if psbt.write_pos + 1 > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    psbt.data.push(rec.record_type);\n    psbt.write_pos += 1;\n\n    // write key\n    if psbt.write_pos + rec.key.len() > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    psbt.data.extend_from_slice(&rec.key);\n    psbt.write_pos += rec.key.len();\n\n    // write value length\n    let size = compactsize_length(rec.val.len() as u64) as usize;\n    if psbt.write_pos + size > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    let mut buf = [0u8; 9];\n    compactsize_write(&mut buf, rec.val.len() as u64);\n    psbt.data.extend_from_slice(&buf[..size]);\n    psbt.write_pos += size;\n\n    // write value\n    if psbt.write_pos + rec.val.len() > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n    psbt.data.extend_from_slice(&rec.val);\n    psbt.write_pos += rec.val.len();\n\n    PsbtResult::Ok\n}\n\nfn psbt_read_header(psbt: &mut Psbt) -> PsbtResult {\n    if psbt.write_pos + 4 > psbt.data.len() {\n        return PsbtResult::ReadError;\n    }\n    if psbt.data[psbt.write_pos..psbt.write_pos + 4] != PSBT_MAGIC {\n        return PsbtResult::ReadError;\n    }\n    psbt.write_pos += 4;\n\n    if psbt.write_pos >= psbt.data.len() {\n        return PsbtResult::ReadError;\n    }\n    if psbt.data[psbt.write_pos] != 0xff {\n        return PsbtResult::ReadError;\n    }\n    psbt.write_pos += 1;\n\n    psbt.state = PsbtState::Global;\n    PsbtResult::Ok\n}\n\nfn psbt_read_record(psbt: &mut Psbt, src_size: usize) -> Result<PsbtRecord, PsbtResult> {\n    if psbt.write_pos >= psbt.data.len() {\n        return Err(PsbtResult::ReadError);\n    }\n    let size_len = compactsize_peek_length(psbt.data[psbt.write_pos]) as usize;\n    if psbt.write_pos + size_len > psbt.data_capacity {\n        return Err(PsbtResult::ReadError);\n    }\n    let (size, res) = compactsize_read(&psbt.data[psbt.write_pos..]);\n    if res != PsbtResult::Ok {\n        return Err(res);\n    }\n    psbt.write_pos += size_len;\n\n    if psbt.write_pos + size as usize > psbt.data.len()\n        || psbt.write_pos + size as usize > src_size\n    {\n        return Err(PsbtResult::ReadError);\n    }\n    if psbt.write_pos + size as usize > psbt.data_capacity {\n        return Err(PsbtResult::ReadError);\n    }\n\n    let key_size = (size - 1) as usize;\n    let record_type = psbt.data[psbt.write_pos];\n    let key = psbt.data[psbt.write_pos + 1..psbt.write_pos + 1 + key_size].to_vec();\n    psbt.write_pos += size as usize;\n\n    let scope = match psbt.state {\n        PsbtState::Global => PsbtScope::Global,\n        PsbtState::Inputs => PsbtScope::Inputs,\n        PsbtState::Outputs => PsbtScope::Outputs,\n        _ => return Err(PsbtResult::InvalidState),\n    };\n\n    if psbt.write_pos >= psbt.data.len() {\n        return Err(PsbtResult::ReadError);\n    }\n    let size_len = compactsize_peek_length(psbt.data[psbt.write_pos]) as usize;\n    if psbt.write_pos + size_len > psbt.data_capacity {\n        return Err(PsbtResult::ReadError);\n    }\n    let (val_size, res) = compactsize_read(&psbt.data[psbt.write_pos..]);\n    if res != PsbtResult::Ok {\n        return Err(res);\n    }\n    psbt.write_pos += size_len;\n\n    if psbt.write_pos + val_size as usize > psbt.data.len()\n        || psbt.write_pos + val_size as usize > src_size\n    {\n        return Err(PsbtResult::ReadError);\n    }\n    if psbt.write_pos + val_size as usize > psbt.data_capacity {\n        return Err(PsbtResult::ReadError);\n    }\n\n    let val = psbt.data[psbt.write_pos..psbt.write_pos + val_size as usize].to_vec();\n    psbt.write_pos += val_size as usize;\n\n    Ok(PsbtRecord {\n        record_type,\n        key,\n        val,\n        scope,\n    })\n}\n\nfn hexchar(val: u8) -> u8 {\n    if val < 10 {\n        b'0' + val\n    } else {\n        b'a' + val - 10\n    }\n}\n\nfn hexdigit(c: u8) -> u8 {\n    if c <= b'9' {\n        c - b'0'\n    } else {\n        c.to_ascii_uppercase() - b'A' + 10\n    }\n}\n\nfn psbt_hex_decode(src: &[u8], dest: &mut [u8], dest_size: usize) -> PsbtResult {\n    if src.len() % 2 != 0 {\n        return PsbtResult::ReadError;\n    }\n    if dest_size < src.len() / 2 {\n        return PsbtResult::ReadError;\n    }\n    if dest.len() < src.len() / 2 {\n        return PsbtResult::ReadError;\n    }\n    for i in 0..(src.len() / 2) {\n        let c1 = src[i * 2];\n        let c2 = src[i * 2 + 1];\n        if !c1.is_ascii_hexdigit() || !c2.is_ascii_hexdigit() {\n            return PsbtResult::ReadError;\n        }\n        dest[i] = (hexdigit(c1) << 4) | hexdigit(c2);\n    }\n    PsbtResult::Ok\n}\n\nfn hex_encode(src: &[u8], dest: &mut [u8], dest_size: usize) -> PsbtResult {\n    if dest_size < src.len() * 2 + 1 {\n        return PsbtResult::OobWrite;\n    }\n    if dest.len() < src.len() * 2 + 1 {\n        return PsbtResult::OobWrite;\n    }\n    for (i, &c) in src.iter().enumerate() {\n        dest[i * 2] = hexchar(c >> 4);\n        dest[i * 2 + 1] = hexchar(c & 0xF);\n    }\n    dest[src.len() * 2] = 0;\n    PsbtResult::Ok\n}\n\n// ---- Public API ----\n\n/// Return the number of bytes stored in the PSBT.\npub fn psbt_size(tx: &Psbt) -> usize {\n    tx.data.len()\n}\n\n/// Parse a PSBT from `src` into `psbt`, optionally invoking `elem_handler`\n/// for each record encountered.\npub fn psbt_read(\n    src: &[u8],\n    _src_size: usize,\n    psbt: &mut Psbt,\n    elem_handler: Option<PsbtElemHandler>,\n    user_data: &mut dyn std::any::Any,\n) -> PsbtResult {\n    if psbt.state != PsbtState::Init {\n        return PsbtResult::InvalidState;\n    }\n    if src.len() > psbt.data_capacity {\n        return PsbtResult::OobWrite;\n    }\n\n    psbt.data.clear();\n    psbt.data.extend_from_slice(src);\n    psbt.write_pos = 0;\n    psbt.state = PsbtState::Init;\n    psbt.data_capacity = src.len();\n\n    let src_size = src.len();\n    let mut counter = PsbtTxCounter {\n        inputs: 0,\n        outputs: 0,\n    };\n    let mut kvs: i32 = 0;\n\n    while psbt.state != PsbtState::Finalized && psbt.write_pos <= src_size {\n        match psbt.state {\n            PsbtState::Init => {\n                let res = psbt_read_header(psbt);\n                if res != PsbtResult::Ok {\n                    return res;\n                }\n            }\n            PsbtState::Global | PsbtState::Inputs | PsbtState::Outputs => {\n                if psbt.write_pos >= psbt.data.len() {\n                    return PsbtResult::ReadError;\n                }\n                if psbt.data[psbt.write_pos] == 0 {\n                    let new_state = match psbt.state {\n                        PsbtState::Global => PsbtState::InputsNew,\n                        PsbtState::Inputs => {\n                            kvs += 1;\n                            if kvs >= counter.inputs {\n                                kvs = 0;\n                                PsbtState::OutputsNew\n                            } else {\n                                PsbtState::InputsNew\n                            }\n                        }\n                        PsbtState::Outputs => {\n                            kvs += 1;\n                            if kvs >= counter.outputs {\n                                PsbtState::Finalized\n                            } else {\n                                PsbtState::OutputsNew\n                            }\n                        }\n                        _ => unreachable!(),\n                    };\n                    psbt.state = new_state;\n                } else {\n                    let rec = match psbt_read_record(psbt, src_size) {\n                        Ok(r) => r,\n                        Err(e) => return e,\n                    };\n\n                    if psbt.state == PsbtState::Global\n                        && rec.record_type == PsbtGlobalType::UnsignedTx as u8\n                    {\n                        let val_len = rec.val.len();\n                        let res = psbt_btc_tx_parse(\n                            &rec.val,\n                            val_len,\n                            &mut counter,\n                            Some(tx_counter_handler),\n                        );\n                        if res != PsbtResult::Ok {\n                            return res;\n                        }\n                    }\n\n                    if let Some(handler) = elem_handler {\n                        let mut elem = PsbtElem::Record {\n                            index: kvs,\n                            record: rec,\n                        };\n                        handler(&mut elem, user_data);\n                    }\n                }\n            }\n            PsbtState::OutputsNew => {\n                if psbt.write_pos >= psbt.data.len() || psbt.data[psbt.write_pos] != 0 {\n                    return PsbtResult::ReadError;\n                }\n                psbt.write_pos += 1;\n                psbt.state = PsbtState::Outputs;\n            }\n            PsbtState::InputsNew => {\n                if psbt.write_pos >= psbt.data.len() || psbt.data[psbt.write_pos] != 0 {\n                    return PsbtResult::ReadError;\n                }\n                psbt.write_pos += 1;\n                psbt.state = PsbtState::Inputs;\n            }\n            PsbtState::Finalized => break,\n        }\n    }\n\n    if psbt.state != PsbtState::Finalized {\n        return PsbtResult::InvalidState;\n    }\n    if psbt.write_pos < psbt.data.len() && psbt.data[psbt.write_pos] != 0 {\n        return PsbtResult::ReadError;\n    }\n    psbt.write_pos += 1;\n\n    PsbtResult::Ok\n}\n\n/// Decode a PSBT (either base64 or hex) into `dest`.\npub fn psbt_decode(\n    src: &str,\n    _src_size: usize,\n    dest: &mut [u8],\n    dest_size: usize,\n    psbt_len: &mut usize,\n) -> PsbtResult {\n    let bytes = src.as_bytes();\n    let b64_magic = b\"cHNid\";\n\n    if bytes.len() < b64_magic.len() {\n        return PsbtResult::ReadError;\n    }\n\n    if &bytes[..b64_magic.len()] == b64_magic {\n        match base64_decode(bytes, dest) {\n            Some(n) => {\n                *psbt_len = n;\n                PsbtResult::Ok\n            }\n            None => PsbtResult::ReadError,\n        }\n    } else {\n        *psbt_len = bytes.len() / 2;\n        psbt_hex_decode(bytes, dest, dest_size)\n    }\n}\n\n/// Encode the PSBT data into a destination buffer using the requested encoding.\npub fn psbt_encode(\n    psbt: &Psbt,\n    encoding: PsbtEncoding,\n    dest: &mut [u8],\n    dest_size: usize,\n    out_len: &mut usize,\n) -> PsbtResult {\n    if psbt.state != PsbtState::Finalized {\n        return PsbtResult::WriteError;\n    }\n    psbt_encode_raw(&psbt.data, psbt.data.len(), encoding, dest, dest_size, out_len)\n}\n\n/// Encode raw PSBT data into dest using the requested encoding.\npub fn psbt_encode_raw(\n    psbt_data: &[u8],\n    _psbt_len: usize,\n    encoding: PsbtEncoding,\n    dest: &mut [u8],\n    dest_size: usize,\n    out_len: &mut usize,\n) -> PsbtResult {\n    match encoding {\n        PsbtEncoding::Hex => {\n            let res = hex_encode(psbt_data, dest, dest_size);\n            *out_len = psbt_data.len() * 2 + 1;\n            res\n        }\n        PsbtEncoding::Base64 => match base64_encode(psbt_data, dest) {\n            Some(n) => {\n                *out_len = n;\n                PsbtResult::Ok\n            }\n            None => PsbtResult::WriteError,\n        },\n        PsbtEncoding::Base62 => match base62_encode(psbt_data, dest) {\n            Some(n) => {\n                *out_len = n;\n                PsbtResult::Ok\n            }\n            None => PsbtResult::WriteError,\n        },\n        PsbtEncoding::Protobuf => PsbtResult::NotImplemented,\n    }\n}\n\n/// Return the last error message.\npub fn psbt_geterr() -> &'static str {\n    PSBT_ERRMSG\n}\n\n/// Convert a PSBT state to a human–readable string.\npub fn psbt_state_tostr(state: PsbtState) -> &'static str {\n    match state {\n        PsbtState::Init => \"INIT\",\n        PsbtState::Global => \"GLOBAL\",\n        PsbtState::Inputs => \"INPUTS\",\n        PsbtState::InputsNew => \"INPUTS_NEW\",\n        PsbtState::Outputs => \"OUTPUTS\",\n        PsbtState::OutputsNew => \"OUTPUTS_NEW\",\n        PsbtState::Finalized => \"FINALIZED\",\n    }\n}\n\n/// Return a string for a record type and scope.\npub fn psbt_type_tostr(record_type: u8, scope: PsbtScope) -> &'static str {\n    match scope {\n        PsbtScope::Global => match record_type {\n            0 => psbt_global_type_tostr(PsbtGlobalType::UnsignedTx),\n            _ => \"UNKNOWN_GLOBAL_TYPE\",\n        },\n        PsbtScope::Inputs => match record_type {\n            0 => psbt_input_type_tostr(PsbtInputType::NonWitnessUtxo),\n            1 => psbt_input_type_tostr(PsbtInputType::WitnessUtxo),\n            2 => psbt_input_type_tostr(PsbtInputType::PartialSig),\n            3 => psbt_input_type_tostr(PsbtInputType::SighashType),\n            4 => psbt_input_type_tostr(PsbtInputType::RedeemScript),\n            5 => psbt_input_type_tostr(PsbtInputType::WitnessScript),\n            6 => psbt_input_type_tostr(PsbtInputType::Bip32Derivation),\n            7 => psbt_input_type_tostr(PsbtInputType::FinalScriptSig),\n            8 => psbt_input_type_tostr(PsbtInputType::FinalScriptWitness),\n            _ => \"UNKNOWN_INPUT_TYPE\",\n        },\n        PsbtScope::Outputs => match record_type {\n            0 => psbt_output_type_tostr(PsbtOutputType::RedeemScript),\n            1 => psbt_output_type_tostr(PsbtOutputType::WitnessScript),\n            2 => psbt_output_type_tostr(PsbtOutputType::Bip32Derivation),\n            _ => \"UNKNOWN_OUTPUT_TYPE\",\n        },\n    }\n}\n\n/// Return a string for a psbt_txelem type.\npub fn psbt_txelem_type_tostr(txelem_type: PsbtTxElemType) -> &'static str {\n    match txelem_type {\n        PsbtTxElemType::Tx => \"TX\",\n        PsbtTxElemType::TxIn => \"TXIN\",\n        PsbtTxElemType::TxOut => \"TXOUT\",\n        PsbtTxElemType::WitnessItem => \"WITNESS_ITEM\",\n    }\n}\n\npub fn psbt_global_type_tostr(gt: PsbtGlobalType) -> &'static str {\n    match gt {\n        PsbtGlobalType::UnsignedTx => \"GLOBAL_UNSIGNED_TX\",\n    }\n}\n\npub fn psbt_output_type_tostr(ot: PsbtOutputType) -> &'static str {\n    match ot {\n        PsbtOutputType::RedeemScript => \"OUT_REDEEM_SCRIPT\",\n        PsbtOutputType::WitnessScript => \"OUT_WITNESS_SCRIPT\",\n        PsbtOutputType::Bip32Derivation => \"OUT_BIP32_DERIVATION\",\n    }\n}\n\npub fn psbt_input_type_tostr(it: PsbtInputType) -> &'static str {\n    match it {\n        PsbtInputType::NonWitnessUtxo => \"IN_NON_WITNESS_UTXO\",\n        PsbtInputType::WitnessUtxo => \"IN_WITNESS_UTXO\",\n        PsbtInputType::PartialSig => \"IN_PARTIAL_SIG\",\n        PsbtInputType::SighashType => \"IN_SIGHASH_TYPE\",\n        PsbtInputType::RedeemScript => \"IN_REDEEM_SCRIPT\",\n        PsbtInputType::WitnessScript => \"IN_WITNESS_SCRIPT\",\n        PsbtInputType::Bip32Derivation => \"IN_BIP32_DERIVATION\",\n        PsbtInputType::FinalScriptSig => \"IN_FINAL_SCRIPTSIG\",\n        PsbtInputType::FinalScriptWitness => \"IN_FINAL_SCRIPTWITNESS\",\n    }\n}\n\n/// Write a global record into the PSBT.\npub fn psbt_write_global_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n    if psbt.state == PsbtState::Init {\n        let res = psbt_write_header(psbt);\n        if res != PsbtResult::Ok {\n            return res;\n        }\n        psbt.state = PsbtState::Global;\n    } else if psbt.state != PsbtState::Global {\n        return PsbtResult::InvalidState;\n    }\n    psbt_write_record(psbt, rec)\n}\n\n/// Write an input record into the PSBT.\npub fn psbt_write_input_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n    if psbt.state == PsbtState::Global {\n        let res = psbt_close_records(psbt);\n        if res != PsbtResult::Ok {\n            return res;\n        }\n        psbt.state = PsbtState::Inputs;\n    } else if psbt.state != PsbtState::Inputs && psbt.state != PsbtState::InputsNew {\n        return PsbtResult::InvalidState;\n    }\n    psbt_write_record(psbt, rec)\n}\n\n/// Write an output record into the PSBT.\npub fn psbt_write_output_record(psbt: &mut Psbt, rec: &PsbtRecord) -> PsbtResult {\n    if psbt.state == PsbtState::Inputs {\n        let res = psbt_close_records(psbt);\n        if res != PsbtResult::Ok {\n            return res;\n        }\n        psbt.state = PsbtState::Outputs;\n    } else if psbt.state != PsbtState::Outputs && psbt.state != PsbtState::OutputsNew {\n        return PsbtResult::InvalidState;\n    }\n    psbt_write_record(psbt, rec)\n}\n\n/// Create a new input record set.\npub fn psbt_new_input_record_set(_psbt: &mut Psbt) -> PsbtResult {\n    if matches!(\n        _psbt.state,\n        PsbtState::Global | PsbtState::InputsNew | PsbtState::Inputs\n    ) {\n        let res = psbt_close_records(_psbt);\n        if res != PsbtResult::Ok {\n            return res;\n        }\n        _psbt.state = PsbtState::InputsNew;\n        PsbtResult::Ok\n    } else {\n        PsbtResult::InvalidState\n    }\n}\n\n/// Create a new output record set.\npub fn psbt_new_output_record_set(psbt: &mut Psbt) -> PsbtResult {\n    if matches!(\n        psbt.state,\n        PsbtState::Inputs | PsbtState::InputsNew | PsbtState::OutputsNew | PsbtState::Outputs\n    ) {\n        let res = psbt_close_records(psbt);\n        if res != PsbtResult::Ok {\n            return res;\n        }\n        psbt.state = PsbtState::OutputsNew;\n        PsbtResult::Ok\n    } else {\n        PsbtResult::InvalidState\n    }\n}\n\n/// Initialize a PSBT using the given destination buffer.\npub fn psbt_init(psbt: &mut Psbt, _dest: &mut [u8], dest_size: usize) -> PsbtResult {\n    psbt.data.clear();\n    psbt.write_pos = 0;\n    psbt.data_capacity = dest_size;\n    psbt.state = PsbtState::Init;\n    psbt.records.clear();\n    PsbtResult::Ok\n}\n\n/// Print the PSBT (only succeeds after finalization).\npub fn psbt_print(psbt: &Psbt, stream: &mut dyn std::io::Write) -> PsbtResult {\n    if psbt.state != PsbtState::Finalized {\n        return PsbtResult::InvalidState;\n    }\n    let size = psbt_size(psbt);\n    for i in 0..size {\n        let _ = write!(stream, \"{:02x}\", psbt.data[i]);\n    }\n    let _ = writeln!(stream);\n    PsbtResult::Ok\n}\n\n/// Finalize the PSBT.\npub fn psbt_finalize(psbt: &mut Psbt) -> PsbtResult {\n    if psbt.state != PsbtState::OutputsNew && psbt.state != PsbtState::Outputs {\n        return PsbtResult::InvalidState;\n    }\n    let res = psbt_close_records(psbt);\n    if res != PsbtResult::Ok {\n        return res;\n    }\n    psbt.state = PsbtState::Finalized;\n    PsbtResult::Ok\n}\n","numLines":756,"startLine":1,"totalLines":756}}}
