r i in 0..100u64 {\n        let e = g.encrypt(i);\n        assert!(e < 100, \"encrypt({}) = {} out of range\", i, e);\n        assert!(!seen[e as usize], \"duplicate output {}\", e);\n        seen[e as usize] = true;\n    }\n    for (i, &b) in seen.iter().enumerate() {\n        assert!(b, \"value {} not produced\", i);\n    }\n}\n\n#[test]\nfn test_encrypt_decrypt_roundtrip_range100() {\n    let g = GFC::new(100, 6, 42);\n    for i in 0..100u64 {\n        let e = g.encrypt(i);\n        let d = g.decrypt(e);\n        assert_eq!(d, i, \"decrypt(encrypt({})) = {}\", i, d);\n    }\n}\n\n#[test]\nfn test_encrypt_decrypt_roundtrip_range10_various_rounds() {\n    for &rounds in &[1u64, 2, 3, 4, 5, 6, 7, 8, 10] {\n        let g = GFC::new(10, rounds, 42);\n        for i in 0..10u64 {\n            let e = g.encrypt(i);\n            let d = g.decrypt(e);\n            assert_eq!(d, i, \"rounds={}, decrypt(encrypt({})) = {}\", rounds, i, d);\n            assert!(e < 10, \"rounds={}, encrypt({}) = {} out of range\", rounds, i, e);\n        }\n    }\n}\n\n#[test]\nfn test_encrypt_range_one() {\n    // Range = 1 — only value is 0, must map to 0.\n    let g = GFC::new(1, 1, 42);\n    assert_eq!(g.encrypt(0), 0);\n    assert_eq!(g.decrypt(0), 0);\n}\n\n#[test]\nfn test_encrypt_rounds0_is_identity() {\n    // With 0 rounds, fe(m) returns m unchanged because the loop never runs\n    // and the final formula reduces to a*0 + (m/a) ... wait, let's check what\n    // C produces:\n    //   L = m % a, R = m / a, no loop iterations\n    //   r is even (0), so return a*R + L = a*(m/a) + (m%a) = m\n    let g = GFC::new(100, 0, 42);\n    for i in 0..100u64 {\n        assert_eq!(g.encrypt(i), i, \"rounds=0 encrypt({}) should be identity\", i);\n        assert_eq!(g.decrypt(i), i, \"rounds=0 decrypt({}) should be identity\", i);\n    }\n}\n\n#[test]\nfn test_encrypt_perfect_square_range16() {\n    // Full mapping for range=16, rounds=6, seed=42 from the C implementation.\n    let expected: [u64; 16] = [1, 2, 12, 4, 13, 15, 10, 11, 0, 3, 5, 8, 9, 7, 6, 14];\n    let g = GFC::new(16, 6, 42);\n    for i in 0..16u64 {\n        assert_eq!(g.encrypt(i), expected[i as usize], \"encrypt({}) range=16\", i);\n    }\n}\n\n#[test]\nfn test_encrypt_range4_rounds6_seed42() {\n    // Full mapping for range=4 (smallest non-trivial perfect square > 1).\n    let expected = [3u64, 2, 1, 0];\n    let g = GFC::new(4, 6, 42);\n    for i in 0..4u64 {\n        assert_eq!(g.encrypt(i), expected[i as usize], \"encrypt({}) range=4\", i);\n    }\n    // Round-trip check.\n    for i in 0..4u64 {\n        assert_eq!(g.decrypt(g.encrypt(i)), i);\n    }\n}\n\n#[test]\nfn test_encrypt_large_range_spot_checks() {\n    // range = 65536 (perfect square), rounds=6, seed=42\n    let g = GFC::new(65536, 6, 42);\n    let cases = [\n        (0u64, 20852u64),\n        (1, 19695),\n        (100, 30245),\n        (1000, 15473),\n        (65535, 20558),\n        (32768, 3631),\n    ];\n    for &(m, exp) in cases.iter() {\n        assert_eq!(g.encrypt(m), exp, \"encrypt({}) range=65536 r=6 s=42\", m);\n    }\n}\n\n#[test]\nfn test_encrypt_range65536_rounds1_spot_checks() {\n    let g = GFC::new(65536, 1, 42);\n    assert_eq!(g.encrypt(32768), 32891);\n}\n\n#[test]\nfn test_encrypt_range65536_rounds1_seed0() {\n    let g = GFC::new(65536, 1, 0);\n    assert_eq!(g.encrypt(0), 44);\n}\n\n#[test]\nfn test_encrypt_range1000000_spot_checks() {\n    // range=1_000_000, rounds=6, seed=42\n    let g = GFC::new(1_000_000, 6, 42);\n    assert_eq!(g.encrypt(0), 916516);\n    assert_eq!(g.encrypt(999_999), 776754);\n    assert_eq!(g.encrypt(500_000), 306589);\n}\n\n#[test]\nfn test_encrypt_seed_max_u64() {\n    // Test with seed = u64::MAX (18446744073709551615)\n    let g = GFC::new(100, 6, u64::MAX);\n    assert_eq!(g.encrypt(42), 59);\n}\n\n#[test]\nfn test_encrypt_seed_variants_range100_m42() {\n    // seed=0,1,100,1000,99999,u64::MAX with range=100 rounds=6 m=42\n    let cases = [\n        (0u64, 97u64),\n        (1, 65),\n        (100, 12),\n        (1000, 24),\n        (99999, 92),\n        (u64::MAX, 59),\n    ];\n    for &(seed, exp) in cases.iter() {\n        let g = GFC::new(100, 6, seed);\n        assert_eq!(g.encrypt(42), exp, \"seed={} range=100 r=6 m=42\", seed);\n    }\n}\n\n#[test]\nfn test_encrypt_rounds_variants_range100_m5() {\n    // seed=42, range=100, m=5, with rounds 2..=10\n    let cases = [\n        (2u64, 45u64),\n        (3, 44),\n        (4, 84),\n        (5, 85),\n        (6, 25),\n        (7, 26),\n        (8, 76),\n        (9, 71),\n        (10, 91),\n    ];\n    for &(rounds, exp) in cases.iter() {\n        let g = GFC::new(100, rounds, 42);\n        assert_eq!(g.encrypt(5), exp, \"rounds={} range=100 s=42 m=5\", rounds);\n    }\n}\n\n#[test]\nfn test_encrypt_range100_rounds1_endpoints() {\n    let g = GFC::new(100, 1, 42);\n    assert_eq!(g.encrypt(0), 0);\n    assert_eq!(g.encrypt(50), 57);\n    assert_eq!(g.encrypt(99), 90);\n}\n\n#[test]\nfn test_full_bijection_range_500() {\n    // Ensure bijection over a larger non-perfect-square range.\n    let range = 500u64;\n    let g = GFC::new(range, 6, 42);\n    let mut seen = vec![false; range as usize];\n    for i in 0..range {\n        let e = g.encrypt(i);\n        assert!(e < range, \"encrypt({}) = {} out of range\", i, e);\n        assert!(!seen[e as usize], \"duplicate output {}\", e);\n        seen[e as usize] = true;\n        // round-trip\n        let d = g.decrypt(e);\n        assert_eq!(d, i, \"decrypt(encrypt({})) = {}\", i, d);\n    }\n    for (i, &b) in seen.iter().enumerate() {\n        assert!(b, \"value {} not produced\", i);\n    }\n}\n\n#[test]\nfn test_full_bijection_range_256_perfect_square() {\n    // range=256 is a perfect square (a=b=16, a*b=256=range).\n    let range = 256u64;\n    let g = GFC::new(range, 6, 42);\n    let mut seen = vec![false; range as usize];\n    for i in 0..range {\n        let e = g.encrypt(i);\n        assert!(e < range);\n        assert!(!seen[e as usize]);\n        seen[e as usize] = true;\n        assert_eq!(g.decrypt(e), i);\n    }\n    for &b in seen.iter() {\n        assert!(b);\n    }\n    // Also assert specific values.\n    assert_eq!(g.encrypt(0), 85);\n    assert_eq!(g.encrypt(100), 155);\n    assert_eq!(g.encrypt(255), 192);\n}\n\nfn main() {}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
