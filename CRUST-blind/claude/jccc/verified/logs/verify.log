{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UXQvvKcWoqW1ikmBV8Y1nk","type":"tool_result","content":"1\tuse crate::token::{Token, TokenType, TOKEN_LENGTH};\n2\tuse std::io::{Read, Seek, SeekFrom};\n3\t\n4\tpub const TOKEN_PUTBACKS: usize = 5;\n5\t\n6\t/// Represents a lexer for tokenizing input.\n7\t#[derive(Debug)]\n8\tpub struct Lexer {\n9\t    /// An optional file; in C this would be a FILE*, here we keep it as a File for demonstration.\n10\t    pub fp: Option<std::fs::File>,\n11\t    pub current_file: String,\n12\t    pub buffer: [u8; 1],\n13\t    pub position: i64,\n14\t    pub last_column: i32,\n15\t    pub column: i32,\n16\t    pub line: i32,\n17\t    pub unlexed: [Token; TOKEN_PUTBACKS],\n18\t    pub unlexed_count: u32,\n19\t}\n20\t\n21\tconst EOF_MARKER: i32 = -1;\n22\t\n23\tfn make_empty_token() -> Token {\n24\t    Token {\n25\t        token_type: TokenType::TT_NO_TOKEN,\n26\t        contents: String::new(),\n27\t        length: 0,\n28\t        source_file: String::new(),\n29\t        line: 0,\n30\t        column: 0,\n31\t    }\n32\t}\n33\t\n34\t/// Gets the next character from the lexer.\n35\tpub fn lexer_getchar(l: &mut Lexer) -> i32 {\n36\t    l.position += 1;\n37\t    l.last_column = l.column;\n38\t    let mut buf = [0u8; 1];\n39\t    let read = match l.fp.as_mut() {\n40\t        Some(fp) => fp.read(&mut buf).unwrap_or(0),\n41\t        None => 0,\n42\t    };\n43\t    if read == 0 {\n44\t        // EOF\n45\t        l.buffer[0] = 0;\n46\t        // For tracking, increment column as the C version always increments\n47\t        l.column += 1;\n48\t        return EOF_MARKER;\n49\t    }\n50\t    l.buffer[0] = buf[0];\n51\t    if buf[0] == b'\\n' {\n52\t        l.line += 1;\n53\t        l.column = 0;\n54\t    } else {\n55\t        l.column += 1;\n56\t    }\n57\t    buf[0] as i32\n58\t}\n59\t\n60\t/// Un-gets (pushes back) the last character.\n61\tpub fn lexer_ungetchar(l: &mut Lexer) -> i32 {\n62\t    if l.position < 0 {\n63\t        return -1;\n64\t    }\n65\t    l.position -= 1;\n66\t    l.column = l.last_column;\n67\t    if l.buffer[0] == b'\\n' {\n68\t        l.line -= 1;\n69\t    }\n70\t    if let Some(fp) = l.fp.as_mut() {\n71\t        let _ = fp.seek(SeekFrom::Current(-1));\n72\t    }\n73\t    1\n74\t}\n75\t\n76\t/// Determines a token type from a multi-character sequence.\n77\tpub fn ttype_many_chars(contents: &str) -> TokenType {\n78\t    match contents {\n79\t        \"auto\" => return TokenType::TT_AUTO,\n80\t        \"break\" => return TokenType::TT_BREAK,\n81\t        \"continue\" => return TokenType::TT_CONTINUE,\n82\t        \"const\" => return TokenType::TT_CONST,\n83\t        \"case\" => return TokenType::TT_CASE,\n84\t        \"char\" => return TokenType::TT_CHAR,\n85\t        \"do\" => return TokenType::TT_DO,\n86\t        \"double\" => return TokenType::TT_DOUBLE,\n87\t        \"default\" => return TokenType::TT_DEFAULT,\n88\t        \"enum\" => return TokenType::TT_ENUM,\n89\t        \"else\" => return TokenType::TT_ELSE,\n90\t        \"extern\" => return TokenType::TT_EXTERN,\n91\t        \"float\" => return TokenType::TT_FLOAT,\n92\t        \"for\" => return TokenType::TT_FOR,\n93\t        \"goto\" => return TokenType::TT_GOTO,\n94\t        \"int\" => return TokenType::TT_INT,\n95\t        \"if\" => return TokenType::TT_IF,\n96\t        \"long\" => return TokenType::TT_LONG,\n97\t        \"return\" => return TokenType::TT_RETURN,\n98\t        \"register\" => return TokenType::TT_REGISTER,\n99\t        \"struct\" => return TokenType::TT_STRUCT,\n100\t        \"signed\" => return TokenType::TT_SIGNED,\n101\t        \"sizeof\" => return TokenType::TT_SIZEOF,\n102\t        \"static\" => return TokenType::TT_STATIC,\n103\t        \"short\" => return TokenType::TT_SHORT,\n104\t        \"switch\" => return TokenType::TT_SWITCH,\n105\t        \"typedef\" => return TokenType::TT_TYPEDEF,\n106\t        \"union\" => return TokenType::TT_UNION,\n107\t        \"unsigned\" => return TokenType::TT_UNSIGNED,\n108\t        \"void\" => return TokenType::TT_VOID,\n109\t        \"volatile\" => return TokenType::TT_VOLATILE,\n110\t        \"while\" => return TokenType::TT_WHILE,\n111\t        \"&&\" => return TokenType::TT_LAND,\n112\t        \"||\" => return TokenType::TT_LOR,\n113\t        \"-=\" => return TokenType::TT_DEC,\n114\t        \"+=\" => return TokenType::TT_INC,\n115\t        \"++\" => return TokenType::TT_PLUSPLUS,\n116\t        \"--\" => return TokenType::TT_MINUSMINUS,\n117\t        \"/=\" => return TokenType::TT_DIVEQ,\n118\t        \"*=\" => return TokenType::TT_MULEQ,\n119\t        \"%=\" => return TokenType::TT_MODEQ,\n120\t        \"&=\" => return TokenType::TT_BANDEQ,\n121\t        \"|=\" => return TokenType::TT_BOREQ,\n122\t        \"&&=\" => return TokenType::TT_LANDEQ,\n123\t        \"||=\" => return TokenType::TT_LOREQ,\n124\t        \"<=\" => return TokenType::TT_LESSEQ,\n125\t        \">=\" => return TokenType::TT_GREATEREQ,\n126\t        \"<<\" => return TokenType::TT_LEFTSHIFT,\n127\t        \">>\" => return TokenType::TT_RIGHTSHIFT,\n128\t        \"==\" => return TokenType::TT_EQUALS,\n129\t        \"^=\" => return TokenType::TT_XOREQ,\n130\t        \"->\" => return TokenType::TT_POINT,\n131\t        \"<<=\" => return TokenType::TT_LEFTSHIFTEQUALS,\n132\t        \">>=\" => return TokenType::TT_RIGHTSHIFTEQUALS,\n133\t        \"!=\" => return TokenType::TT_NOTEQ,\n134\t        _ => {}\n135\t    }\n136\t\n137\t    if contents.is_empty() {\n138\t        return TokenType::TT_NO_TOKEN;\n139\t    }\n140\t\n141\t    let mut all_numeric = true;\n142\t    let mut count_us = 0;\n143\t    let bytes = contents.as_bytes();\n144\t\n145\t    for &c in bytes {\n146\t        if c == b'.' {\n147\t            return TokenType::TT_LITERAL;\n148\t        }\n149\t        if c == b'u' {\n150\t            count_us += 1;\n151\t        }\n152\t        if (c > b'9' || c < b'0') && c != b'u' {\n153\t            all_numeric = false;\n154\t        }\n155\t        if c == b'\\'' || c == b'\"' {\n156\t            return TokenType::TT_LITERAL;\n157\t        }\n158\t    }\n159\t\n160\t    if all_numeric {\n161\t        let last = bytes[bytes.len() - 1];\n162\t        if count_us == 1 && last == b'u' {\n163\t            return TokenType::TT_LITERAL;\n164\t        }\n165\t        if count_us == 0 {\n166\t            return TokenType::TT_LITERAL;\n167\t        }\n168\t    }\n169\t\n170\t    TokenType::TT_IDENTIFIER\n171\t}\n172\t\n173\t/// Tests the function that identifies token types by name.\n174\tpub fn test_ttype_name() -> i32 {\n175\t    if ttype_name(TokenType::TT_LITERAL) != \"literal\" {\n176\t        return 1;\n177\t    }\n178\t    if ttype_name(TokenType::TT_PLUS) != \"+\" {\n179\t        return 1;\n180\t    }\n181\t    if ttype_name(TokenType::TT_SIZEOF) != \"sizeof\" {\n182\t        return 1;\n183\t    }\n184\t    if ttype_name(TokenType::TT_WHILE) != \"while\" {\n185\t        return 1;\n186\t    }\n187\t    0\n188\t}\n189\t\n190\t/// Determines a token type from a single character.\n191\tpub fn ttype_one_char(c: char) -> TokenType {\n192\t    match c {\n193\t        '(' => TokenType::TT_OPAREN,\n194\t        ')' => TokenType::TT_CPAREN,\n195\t        '{' => TokenType::TT_OBRACE,\n196\t        '}' => TokenType::TT_CBRACE,\n197\t        '[' => TokenType::TT_OBRACKET,\n198\t        ']' => TokenType::TT_CBRACKET,\n199\t        ';' => TokenType::TT_SEMI,\n200\t        '.' => TokenType::TT_PERIOD,\n201\t        ',' => TokenType::TT_COMMA,\n202\t        '-' => TokenType::TT_MINUS,\n203\t        '+' => TokenType::TT_PLUS,\n204\t        '*' => TokenType::TT_STAR,\n205\t        '/' => TokenType::TT_SLASH,\n206\t        '=' => TokenType::TT_ASSIGN,\n207\t        ':' => TokenType::TT_COLON,\n208\t        '%' => TokenType::TT_MOD,\n209\t        '&' => TokenType::TT_BAND,\n210\t        '|' => TokenType::TT_BOR,\n211\t        '>' => TokenType::TT_GREATER,\n212\t        '<' => TokenType::TT_LESS,\n213\t        '!' => TokenType::TT_LNOT,\n214\t        '~' => TokenType::TT_BNOT,\n215\t        '^' => TokenType::TT_XOR,\n216\t        '#' => TokenType::TT_POUND,\n217\t        '?' => TokenType::TT_QMARK,\n218\t        _ => {\n219\t            if c.is_ascii_digit() {\n220\t                TokenType::TT_LITERAL\n221\t            } else {\n222\t                TokenType::TT_IDENTIFIER\n223\t            }\n224\t        }\n225\t    }\n226\t}\n227\t\n228\t/// Returns the name of a token type as a string.\n229\tpub fn ttype_name(tt: TokenType) -> String {\n230\t    match tt {\n231\t        TokenType::TT_LITERAL => \"literal\",\n232\t        TokenType::TT_IDENTIFIER => \"identifier\",\n233\t        TokenType::TT_OPAREN => \"open paren\",\n234\t        TokenType::TT_CPAREN => \"close paren\",\n235\t        TokenType::TT_OBRACE => \"open brace\",\n236\t        TokenType::TT_CBRACE => \"close brace\",\n237\t        TokenType::TT_OBRACKET => \"open bracket\",\n238\t        TokenType::TT_CBRACKET => \"close bracket\",\n239\t        TokenType::TT_SEMI => \"semicolon\",\n240\t        TokenType::TT_NO_TOKEN => \"no token\",\n241\t        TokenType::TT_EOF => \"end of file\",\n242\t        TokenType::TT_NEWLINE => \"newline\",\n243\t        TokenType::TT_POUND => \"pound\",\n244\t        TokenType::TT_PERIOD => \".\",\n245\t        TokenType::TT_COMMA => \",\",\n246\t        TokenType::TT_QMARK => \"?\",\n247\t        TokenType::TT_MINUS => \"-\",\n248\t        TokenType::TT_PLUS => \"+\",\n249\t        TokenType::TT_STAR => \"*\",\n250\t        TokenType::TT_SLASH => \"/\",\n251\t        TokenType::TT_ASSIGN => \"=\",\n252\t        TokenType::TT_COLON => \":\",\n253\t        TokenType::TT_MOD => \"%\",\n254\t        TokenType::TT_BAND => \"&\",\n255\t        TokenType::TT_LAND => \"&&\",\n256\t        TokenType::TT_BOR => \"|\",\n257\t        TokenType::TT_LOR => \"||\",\n258\t        TokenType::TT_DEC => \"-=\",\n259\t        TokenType::TT_INC => \"+=\",\n260\t        TokenType::TT_PLUSPLUS => \"++\",\n261\t        TokenType::TT_MINUSMINUS => \"--\",\n262\t        TokenType::TT_DIVEQ => \"/=\",\n263\t        TokenType::TT_MULEQ => \"*=\",\n264\t        TokenType::TT_MODEQ => \"%=\",\n265\t        TokenType::TT_BANDEQ => \"&=\",\n266\t        TokenType::TT_BOREQ => \"|=\",\n267\t        TokenType::TT_LANDEQ => \"&&=\",\n268\t        TokenType::TT_LOREQ => \"||=\",\n269\t        TokenType::TT_GREATER => \">\",\n270\t        TokenType::TT_LESS => \"<\",\n271\t        TokenType::TT_LESSEQ => \"<=\",\n272\t        TokenType::TT_GREATEREQ => \">=\",\n273\t        TokenType::TT_LEFTSHIFT => \"<<\",\n274\t        TokenType::TT_RIGHTSHIFT => \">>\",\n275\t        TokenType::TT_LNOT => \"!\",\n276\t        TokenType::TT_BNOT => \"~\",\n277\t        TokenType::TT_EQUALS => \"==\",\n278\t        TokenType::TT_NOTEQ => \"!=\",\n279\t        TokenType::TT_XOR => \"^\",\n280\t        TokenType::TT_XOREQ => \"^=\",\n281\t        TokenType::TT_POINT => \"->\",\n282\t        TokenType::TT_LEFTSHIFTEQUALS => \"<<=\",\n283\t        TokenType::TT_RIGHTSHIFTEQUALS => \">>=\",\n284\t        TokenType::TT_AUTO => \"auto\",\n285\t        TokenType::TT_BREAK => \"break\",\n286\t        TokenType::TT_CHAR => \"char\",\n287\t        TokenType::TT_CONST => \"const\",\n288\t        TokenType::TT_CASE => \"case\",\n289\t        TokenType::TT_CONTINUE => \"continue\",\n290\t        TokenType::TT_DOUBLE => \"double\",\n291\t        TokenType::TT_DO => \"do\",\n292\t        TokenType::TT_DEFAULT => \"default\",\n293\t        TokenType::TT_ENUM => \"enum\",\n294\t        TokenType::TT_ELSE => \"else\",\n295\t        TokenType::TT_EXTERN => \"extern\",\n296\t        TokenType::TT_FLOAT => \"float\",\n297\t        TokenType::TT_FOR => \"for\",\n298\t        TokenType::TT_GOTO => \"goto\",\n299\t        TokenType::TT_IF => \"if\",\n300\t        TokenType::TT_INT => \"int\",\n301\t        TokenType::TT_LONG => \"long\",\n302\t        TokenType::TT_RETURN => \"return\",\n303\t        TokenType::TT_REGISTER => \"register\",\n304\t        TokenType::TT_STATIC => \"static\",\n305\t        TokenType::TT_SWITCH => \"switch\",\n306\t        TokenType::TT_SHORT => \"short\",\n307\t        TokenType::TT_SIGNED => \"signed\",\n308\t        TokenType::TT_STRUCT => \"struct\",\n309\t        TokenType::TT_SIZEOF => \"sizeof\",\n310\t        TokenType::TT_TYPEDEF => \"typedef\",\n311\t        TokenType::TT_UNSIGNED => \"unsigned\",\n312\t        TokenType::TT_UNION => \"union\",\n313\t        TokenType::TT_VOID => \"void\",\n314\t        TokenType::TT_VOLATILE => \"volatile\",\n315\t        TokenType::TT_WHILE => \"while\",\n316\t    }\n317\t    .to_string()\n318\t}\n319\t\n320\t/// Checks if the provided operator sequence is valid.\n321\tpub fn valid_operator_sequence(op: &str) -> i32 {\n322\t    let operators = [\n323\t        \"-\", \"+\", \"*\", \"/\", \"=\", \":\", \"%\", \"&\", \"&&\", \"|\", \"||\", \"-=\", \"+=\", \"++\", \"--\", \"/=\",\n324\t        \"*=\", \"%=\", \"&=\", \"|=\", \"&&=\", \"||=\", \">\", \"<\", \"<=\", \">=\", \"<<\", \">>\", \"!\", \"==\", \"!=\",\n325\t        \"^\", \"^=\", \"->\", \"<<=\", \">>=\",\n326\t    ];\n327\t    for o in &operators {\n328\t        if *o == op {\n329\t            return 1;\n330\t        }\n331\t    }\n332\t    0\n333\t}\n334\t\n335\t/// Main lex function to tokenize input into a given Token.\n336\tpub fn lex(l: &mut Lexer, token: &mut Token) -> i32 {\n337\t    loop {\n338\t        let r = real_lex(l, token);\n339\t        if r != 0 {\n340\t            return r;\n341\t        }\n342\t        if !matches!(token.token_type, TokenType::TT_NEWLINE) {\n343\t            break;\n344\t        }\n345\t    }\n346\t    0\n347\t}\n348\t\n349\t/// Retrieves the next token from the lexer.\n350\tpub fn real_lex(l: &mut Lexer, t: &mut Token) -> i32 {\n351\t    // If there are any tokens waiting in the putback buffer, read from there\n352\t    if l.unlexed_count > 0 {\n353\t        l.unlexed_count -= 1;\n354\t        let idx = l.unlexed_count as usize;\n355\t        // Move the token out using std::mem::replace\n356\t        let placeholder = make_empty_token();\n357\t        let pulled = std::mem::replace(&mut l.unlexed[idx], placeholder);\n358\t        *t = pulled;\n359\t        return 0;\n360\t    }\n361\t\n362\t    skip_to_token(l);\n363\t    let init = lexer_getchar(l);\n364\t\n365\t    t.contents.clear();\n366\t    t.source_file = l.current_file.clone();\n367\t\n368\t    if init == EOF_MARKER {\n369\t        t.contents = String::from(\"[end of file]\");\n370\t        t.length = t.contents.len();\n371\t        t.token_type = TokenType::TT_EOF;\n372\t        t.line = l.line;\n373\t        t.column = l.column;\n374\t        return 0;\n375\t    }\n376\t\n377\t    if init == b' ' as i32 || init == b'\\t' as i32 {\n378\t        eprintln!(\"Error: jccc: internal error: did not skip whitespace correctly\");\n379\t        return -1;\n380\t    }\n381\t\n382\t    if init == b'\\n' as i32 {\n383\t        t.contents = String::from(\"[newline]\");\n384\t        t.length = t.contents.len();\n385\t        t.token_type = TokenType::TT_NEWLINE;\n386\t        t.line = l.line;\n387\t        t.column = l.column;\n388\t        return 0;\n389\t    }\n390\t\n391\t    let init_char = init as u8 as char;\n392\t    let mut pos: usize = 0;\n393\t    t.contents.push(init_char);\n394\t    pos += 1;\n395\t\n396\t    // Single-character tokens.\n397\t    let single_char_tokens = \"(){}[];~#,.:?~\";\n398\t    if in_string(init_char, single_char_tokens) != 0 {\n399\t        t.length = pos;\n400\t        t.token_type = ttype_one_char(init_char);\n401\t        t.line = l.line;\n402\t        t.column = l.column;\n403\t        return 0;\n404\t    }\n405\t\n406\t    // Numeric literal or identifier\n407\t    if is_valid_numeric_or_id_char(init_char) != 0 {\n408\t        let starting_line = l.line;\n409\t        let starting_col = l.column;\n410\t        loop {\n411\t            let c = lexer_getchar(l);\n412\t            if c == EOF_MARKER {\n413\t                break;\n414\t            }\n415\t            let cc = c as u8 as char;\n416\t            if is_valid_numeric_or_id_char(cc) == 0 {\n417\t                break;\n418\t            }\n419\t            if pos >= TOKEN_LENGTH - 1 {\n420\t                eprintln!(\n421\t                    \"Error: jccc: identifier too long, over {} characters\",\n422\t                    TOKEN_LENGTH\n423\t                );\n424\t                return -1;\n425\t            }\n426\t            t.contents.push(cc);\n427\t            pos += 1;\n428\t        }\n429\t        lexer_ungetchar(l);\n430\t        t.token_type = ttype_many_chars(&t.contents);\n431\t        t.length = pos;\n432\t        t.line = starting_line;\n433\t        t.column = starting_col;\n434\t        return 0;\n435\t    }\n436\t\n437\t    // Operator\n438\t    if starts_operator(init_char) != 0 {\n439\t        // Mimic the C behavior: keep reading while contents is a valid operator\n440\t        // sequence; the loop will overshoot by one then strip.\n441\t        while valid_operator_sequence(&t.contents) != 0 {\n442\t            let c = lexer_getchar(l);\n443\t            if c == EOF_MARKER {\n444\t                t.contents.push('\\0');\n445\t                pos += 1;\n446\t                break;\n447\t            }\n448\t            let cc = c as u8 as char;\n449\t            t.contents.push(cc);\n450\t            pos += 1;\n451\t        }\n452\t        lexer_ungetchar(l);\n453\t        // Drop the last character (the one that broke the sequence).\n454\t        if !t.contents.is_empty() {\n455\t            t.contents.pop();\n456\t        }\n457\t        t.token_type = ttype_from_string(&t.contents);\n458\t        t.length = pos;\n459\t        return 0;\n460\t    }\n461\t\n462\t    eprintln!(\n463\t        \"Error: jccc: lexer unable to identify token starting with: {}\",\n464\t        init_char\n465\t    );\n466\t    0\n467\t}\n468\t\n469\t/// Tests the function that determines token types for a single character.\n470\tpub fn test_ttype_one_char() -> i32 {\n471\t    if !matches!(ttype_one_char('a'), TokenType::TT_IDENTIFIER) {\n472\t        return 1;\n473\t    }\n474\t    if !matches!(ttype_one_char('1'), TokenType::TT_LITERAL) {\n475\t        return 1;\n476\t    }\n477\t    if !matches!(ttype_one_char('+'), TokenType::TT_PLUS) {\n478\t        return 1;\n479\t    }\n480\t    if !matches!(ttype_one_char('-'), TokenType::TT_MINUS) {\n481\t        return 1;\n482\t    }\n483\t    if !matches!(ttype_one_char('>'), TokenType::TT_GREATER) {\n484\t        return 1;\n485\t    }\n486\t    if !matches!(ttype_one_char('~'), TokenType::TT_BNOT) {\n487\t        return 1;\n488\t    }\n489\t    0\n490\t}\n491\t\n492\t/// Checks if a character starts an operator sequence.\n493\tpub fn starts_operator(c: char) -> i32 {\n494\t    match c {\n495\t        '-' | '+' | '*' | '/' | '=' | ':' | '%' | '&' | '|' | '<' | '>' | '!' | '~' | '^' => 1,\n496\t        _ => 0,\n497\t    }\n498\t}\n499\t\n500\t/// Tests the function that determines token types from a string.\n501\tpub fn test_ttype_from_string() -> i32 {\n502\t    if !matches!(ttype_from_string(\"+\"), TokenType::TT_PLUS) {\n503\t        return 1;\n504\t    }\n505\t    if !matches!(ttype_from_string(\"=\"), TokenType::TT_ASSIGN) {\n506\t        return 1;\n507\t    }\n508\t    if !matches!(ttype_from_string(\"1\"), TokenType::TT_LITERAL) {\n509\t        return 1;\n510\t    }\n511\t    if !matches!(ttype_from_string(\"1.2\"), TokenType::TT_LITERAL) {\n512\t        return 1;\n513\t    }\n514\t    if !matches!(ttype_from_string(\"1u\"), TokenType::TT_LITERAL) {\n515\t        return 1;\n516\t    }\n517\t    if !matches!(ttype_from_string(\"1.2f\"), TokenType::TT_LITERAL) {\n518\t        return 1;\n519\t    }\n520\t    if !matches!(ttype_from_string(\"1.f\"), TokenType::TT_LITERAL) {\n521\t        return 1;\n522\t    }\n523\t    if !matches!(ttype_from_string(\"\\\"Planck\\\"\"), TokenType::TT_LITERAL) {\n524\t        return 1;\n525\t    }\n526\t    if !matches!(ttype_from_string(\"'Language'\"), TokenType::TT_LITERAL) {\n527\t        return 1;\n528\t    }\n529\t    if !matches!(ttype_from_string(\"Jaba\"), TokenType::TT_IDENTIFIER) {\n530\t        return 1;\n531\t    }\n532\t    if !matches!(ttype_from_string(\"cat_\"), TokenType::TT_IDENTIFIER) {\n533\t        return 1;\n534\t    }\n535\t    if !matches!(ttype_from_string(\"(\"), TokenType::TT_OPAREN) {\n536\t        return 1;\n537\t    }\n538\t    if !matches!(ttype_from_string(\"}\"), TokenType::TT_CBRACE) {\n539\t        return 1;\n540\t    }\n541\t    if !matches!(ttype_from_string(\";\"), TokenType::TT_SEMI) {\n542\t        return 1;\n543\t    }\n544\t    0\n545\t}\n546\t\n547\t/// Derives a TokenType from a string input.\n548\tpub fn ttype_from_string(contents: &str) -> TokenType {\n549\t    let len = contents.chars().count();\n550\t    if len == 1 {\n551\t        return ttype_one_char(contents.chars().next().unwrap());\n552\t    }\n553\t    ttype_many_chars(contents)\n554\t}\n555\t\n556\t/// Checks if character c is in the string s.\n557\tpub fn in_string(c: char, s: &str) -> i32 {\n558\t    if s.contains(c) {\n559\t        1\n560\t    } else {\n561\t        0\n562\t    }\n563\t}\n564\t\n565\t/// Tests the function that determines token types from multiple characters.\n566\tpub fn test_ttype_many_chars() -> i32 {\n567\t    if !matches!(ttype_many_chars(\"foo\"), TokenType::TT_IDENTIFIER) {\n568\t        return 1;\n569\t    }\n570\t    if !matches!(ttype_many_chars(\"struct\"), TokenType::TT_STRUCT) {\n571\t        return 1;\n572\t    }\n573\t    if !matches!(ttype_many_chars(\"while\"), TokenType::TT_WHILE) {\n574\t        return 1;\n575\t    }\n576\t    0\n577\t}\n578\t\n579\t/// Skips characters until the next token is found.\n580\tpub fn skip_to_token(l: &mut Lexer) -> i32 {\n581\t    let cur = lexer_getchar(l);\n582\t    if cur == EOF_MARKER {\n583\t        return -1;\n584\t    }\n585\t    let mut prev = cur as u8 as char;\n586\t    if !(prev == ' ' || prev == '\\t' || prev == '/') {\n587\t        lexer_ungetchar(l);\n588\t        return 0;\n589\t    }\n590\t\n591\t    let mut in_block: i32 = 0;\n592\t    let mut pass: i32 = 0;\n593\t\n594\t    loop {\n595\t        let c = lexer_getchar(l);\n596\t        if c == EOF_MARKER {\n597\t            return -1;\n598\t        }\n599\t        let cur_char = c as u8 as char;\n600\t\n601\t        if cur_char == '/' && prev == '/' && in_block == 0 {\n602\t            in_block = 1; // Single line comment\n603\t        } else if cur_char == '*' && prev == '/' && in_block == 0 {\n604\t            in_block = 2;\n605\t            pass = 2;\n606\t        } else if (in_block == 1 && cur_char == '\\n')\n607\t            || (in_block == 2 && cur_char == '/' && prev == '*' && pass <= 0)\n608\t        {\n609\t            in_block = 0;\n610\t        } else if prev == '/' && !(cur_char == '*' || cur_char == '/') && in_block == 0 {\n611\t            lexer_ungetchar(l);\n612\t            return 0;\n613\t        }\n614\t        if !(cur_char == ' ' || cur_char == '\\t' || cur_char == '/') && in_block == 0 {\n615\t            lexer_ungetchar(l);\n616\t            return 0;\n617\t        }\n618\t        pass -= 1;\n619\t        prev = cur_char;\n620\t    }\n621\t}\n622\t\n623\t/// Pushes a token back into the lexer's buffer.\n624\tpub fn unlex(l: &mut Lexer, t: &Token) -> i32 {\n625\t    if l.unlexed_count as usize >= TOKEN_PUTBACKS {\n626\t        eprintln!(\n627\t            \"Error: jccc: internal: tried to unlex more than {} tokens at a time\",\n628\t            TOKEN_PUTBACKS\n629\t        );\n630\t        return -1;\n631\t    }\n632\t    let idx = l.unlexed_count as usize;\n633\t    l.unlexed[idx] = Token {\n634\t        token_type: clone_token_type(&t.token_type),\n635\t        contents: t.contents.clone(),\n636\t        length: t.length,\n637\t        source_file: t.source_file.clone(),\n638\t        line: t.line,\n639\t        column: t.