{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01DGJ57B6Q3kcSFiMrvEi8AH","type":"tool_result","content":"1\tuse std::any::Any;\n2\tuse std::fmt;\n3\t\n4\t/// Represents a node in the bucket chain.\n5\t#[derive(Debug)]\n6\tpub struct BucketNode {\n7\t    pub key: String,\n8\t    pub value: Box<dyn Any>,\n9\t    pub next: Option<Box<BucketNode>>,\n10\t}\n11\t\n12\t/// Represents a simple Hashmap structure.\n13\tpub struct Hashmap {\n14\t    pub buckets: Vec<Option<Box<BucketNode>>>,\n15\t    pub size: i32,\n16\t    pub cap: i32,\n17\t    pub hash: fn(&str) -> u32,\n18\t    /// An equality function taking two &str and returning a bool (true if equal).\n19\t    pub equals: fn(&str, &str) -> bool,\n20\t}\n21\t\n22\timpl fmt::Debug for Hashmap {\n23\t    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n24\t        f.debug_struct(\"Hashmap\")\n25\t            .field(\"buckets\", &self.buckets)\n26\t            .field(\"size\", &self.size)\n27\t            .field(\"cap\", &self.cap)\n28\t            .finish()\n29\t    }\n30\t}\n31\t\n32\tpub fn create_hashmap(cap: i32) -> Hashmap {\n33\t    let mut buckets = Vec::with_capacity(cap.max(0) as usize);\n34\t    for _ in 0..cap.max(0) {\n35\t        buckets.push(None);\n36\t    }\n37\t    Hashmap {\n38\t        buckets,\n39\t        size: 0,\n40\t        cap,\n41\t        hash: fnva1,\n42\t        equals: equal_key,\n43\t    }\n44\t}\n45\t\n46\t/// Gets a value from the Hashmap.\n47\tpub fn hm_get<'a>(h: &'a Hashmap, key: &'a str) -> Option<&'a BucketNode> {\n48\t    if h.cap <= 0 {\n49\t        return None;\n50\t    }\n51\t    let a = ((h.hash)(key) as usize) % (h.cap as usize);\n52\t    match &h.buckets[a] {\n53\t        Some(b) => {\n54\t            if (h.equals)(b.key.as_str(), key) {\n55\t                Some(b.as_ref())\n56\t            } else {\n57\t                None\n58\t            }\n59\t        }\n60\t        None => None,\n61\t    }\n62\t}\n63\t\n64\t/// Sets a key-value pair in the Hashmap.\n65\tpub fn hm_set(h: &mut Hashmap, key: &str, value: Box<dyn Any>) -> i32 {\n66\t    if h.cap <= 0 {\n67\t        return -1;\n68\t    }\n69\t    let a = ((h.hash)(key) as usize) % (h.cap as usize);\n70\t    if h.buckets[a].is_none() {\n71\t        if h.size == h.cap {\n72\t            double_cap(h);\n73\t        }\n74\t        h.size += 1;\n75\t        let node = BucketNode {\n76\t            key: key.to_string(),\n77\t            value,\n78\t            next: None,\n79\t        };\n80\t        // Recompute index after potential double_cap\n81\t        let a = ((h.hash)(key) as usize) % (h.cap as usize);\n82\t        h.buckets[a] = Some(Box::new(node));\n83\t        0\n84\t    } else {\n85\t        // Handle linear probing -- not yet implemented in C either\n86\t        -1\n87\t    }\n88\t}\n89\t\n90\t/// Tests setting and getting a value in the Hashmap.\n91\tpub fn test_hash_set_and_get() -> i32 {\n92\t    let mut h = create_hashmap(100);\n93\t    let ret = hm_set(&mut h, \"test\", Box::new(String::from(\"jake\")));\n94\t    if ret == -1 {\n95\t        return 1;\n96\t    }\n97\t    match hm_get(&h, \"test\") {\n98\t        Some(node) => {\n99\t            if let Some(s) = node.value.downcast_ref::<String>() {\n100\t                if s != \"jake\" {\n101\t                    return 1;\n102\t                }\n103\t            } else {\n104\t                return 1;\n105\t            }\n106\t        }\n107\t        None => return 1,\n108\t    }\n109\t    0\n110\t}\n111\t\n112\t/// Doubles the capacity of the Hashmap.\n113\tpub fn double_cap(h: &mut Hashmap) {\n114\t    let new_cap = h.cap * 2;\n115\t    let mut new_buckets: Vec<Option<Box<BucketNode>>> = Vec::with_capacity(new_cap.max(0) as usize);\n116\t    for _ in 0..new_cap.max(0) {\n117\t        new_buckets.push(None);\n118\t    }\n119\t    let old_buckets = std::mem::take(&mut h.buckets);\n120\t    let old_cap = h.cap;\n121\t    for bucket in old_buckets.into_iter().flatten() {\n122\t    