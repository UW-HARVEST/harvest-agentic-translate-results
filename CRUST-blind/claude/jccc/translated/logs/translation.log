rn 0;\n}\n\nint literate(List* l, int (*fn)(void*)) {\n    ListBlock* lb = l->head;\n    int acc = 0;\n    while (lb != NULL) {\n        for (int i = 0; i < lb->full; ++i) {\n            acc += fn(lb->array[i]);\n        }\n        lb = lb->next;\n    }\n    return acc;\n}\n","numLines":138,"startLine":1,"totalLines":138}}}
