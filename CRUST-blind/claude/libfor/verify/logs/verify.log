;\n        for (int i = 0; i < 17; i++) in[i] = 33 + i;\n        uint8_t out[256] = {0};\n        uint32_t tmp[32];\n        uint32_t s = for_compress_sorted(in, out, 17);\n        uint32_t s2 = for_uncompress(out, tmp, 17);\n        uint32_t s3 = for_compressed_size_sorted(in, 17);\n        printf(\"compress_size=%u uncompress_size=%u expected_size=%u\\n\", s, s2, s3);\n        for (uint32_t i = 0; i < 17; i++)\n            printf(\"select(%u)=%u in[%u]=%u\\n\", i, for_select(out, i), i, in[i]);\n        for (uint32_t i = 0; i < 17; i++)\n            printf(\"linear_search(%u)=%u\\n\", in[i], for_linear_search(out, 17, in[i]));\n        for (uint32_t i = 0; i < 17; i++) {\n            uint32_t actual = 99999;\n            uint32_t idx = for_lower_bound_search(out, 17, in[i], &actual);\n            printf(\"lower_bound(%u): idx=%u actual=%u\\n\", in[i], idx, actual);\n        }\n    }\n\n    /* Test: required_bits via compressed_size_unsorted */\n    printf(\"\\n=== compressed_size_unsorted ===\\n\");\n    {\n        uint32_t a[] = {5};\n        printf(\"[5]: %u\\n\", for_compressed_size_unsorted(a, 1));\n    }\n    {\n        uint32_t a[] = {1, 2, 3};\n        printf(\"[1,2,3]: %u\\n\", for_compressed_size_unsorted(a, 3));\n    }\n    {\n        uint32_t a[] = {100, 5, 50, 1, 200};\n        printf(\"[100,5,50,1,200]: %u\\n\", for_compressed_size_unsorted(a, 5));\n    }\n    {\n        uint32_t a[] = {0, 0, 0, 0};\n        printf(\"[0,0,0,0]: %u\\n\", for_compressed_size_unsorted(a, 4));\n    }\n\n    /* Test: append sorted */\n    printf(\"\\n=== append sorted ===\\n\");\n    {\n        uint8_t out[2048] = {0};\n        for (int i = 0; i < 50; i++) {\n            uint32_t s = for_append_sorted(out, i, i * 2);\n            printf(\"after append %d (val=%d): size=%u\\n\", i, i*2, s);\n        }\n        /* Now select all values and confirm */\n        for (uint32_t i = 0; i < 50; i++)\n            printf(\"select(%u)=%u\\n\", i, for_select(out, i));\n    }\n\n    /* Test: append unsorted with re-encode */\n    printf(\"\\n=== append unsorted re-encode ===\\n\");\n    {\n        uint8_t out[2048] = {0};\n        uint32_t vals[] = {10, 12, 11, 13, 100};\n        for (int i = 0; i < 5; i++) {\n            uint32_t s = for_append_unsorted(out, i, vals[i]);\n            printf(\"after append %d val=%u: size=%u\\n\", i, vals[i], s);\n        }\n        for (uint32_t i = 0; i < 5; i++)\n            printf(\"select(%u)=%u\\n\", i, for_select(out, i));\n    }\n\n    /* Test: linear_search_bits when value is not found */\n    printf(\"\\n=== linear_search not found ===\\n\");\n    {\n        uint32_t in[] = {10, 20, 30, 40, 50};\n        uint8_t out[64] = {0};\n        for_compress_sorted(in, out, 5);\n        printf(\"search 25: %u (expect 5)\\n\", for_linear_search(out, 5, 25));\n        printf(\"search 30: %u (expect 2)\\n\", for_linear_search(out, 5, 30));\n        printf(\"search 99: %u (expect 5)\\n\", for_linear_search(out, 5, 99));\n    }\n\n    /* Test: bits=0 case */\n    printf(\"\\n=== bits=0 (all same value) ===\\n\");\n    {\n        uint32_t in[] = {42, 42, 42, 42};\n        uint8_t out[64] = {0};\n        uint32_t tmp[8];\n        uint32_t s = for_compress_sorted(in, out, 4);\n        uint32_t s2 = for_uncompress(out, tmp, 4);\n        printf(\"size=%u un_size=%u\\n\", s, s2);\n        printf(\"bits stored=%u\\n\", out[4]);\n        for (uint32_t i = 0; i < 4; i++) printf(\"tmp[%u]=%u\\n\", i, tmp[i]);\n        printf(\"linear_search(42)=%u (expect 0)\\n\", for_linear_search(out, 4, 42));\n        printf(\"linear_search(99)=%u (expect 4)\\n\", for_linear_search(out, 4, 99));\n        uint32_t actual = 0;\n        uint32_t idx = for_lower_bound_search(out, 4, 42, &actual);\n        printf(\"lower_bound(42)=%u actual=%u\\n\", idx, actual);\n    }\n\n    /* Test: lower_bound_search edge cases */\n    printf(\"\\n=== lower_bound edge cases ===\\n\");\n    {\n        uint32_t in[] = {10, 20, 30, 40, 50};\n        uint8_t out[6