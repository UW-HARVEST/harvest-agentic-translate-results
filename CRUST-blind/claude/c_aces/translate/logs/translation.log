{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CFm6ZGjboiJvQ3uggCppTv","type":"tool_result","content":"1\t#ifndef POLYNOMIAL_H\n2\t#define POLYNOMIAL_H\n3\t\n4\t#ifdef __cplusplus\n5\textern \"C\" {\n6\t#endif\n7\t\n8\t#include <stddef.h>\n9\t#include <stdint.h>\n10\t\n11\t/// Typedef for coefficient in polynomial representation.\n12\ttypedef int64_t Coeff;\n13\t\n14\t/**\n15\t * @brief Represents a polynomial.\n16\t *\n17\t * This structure encapsulates the coefficients of a polynomial and its size,\n18\t * providing a convenient way to work with polynomial data in algorithms\n19\t * and cryptographic operations.\n20\t *\n21\t * The coeffs field holds a pointer to an array of coefficients representing the\n22\t * polynomial terms, while the size field indicates the size of the coefficients\n23\t * array, corresponding to the degree of the polynomial plus one.\n24\t */\n25\ttypedef struct {\n26\t  Coeff *coeffs; //!< Pointer to array of coefficients\n27\t  size_t size;   //!< Size of the coefficients array\n28\t} Polynomial;\n29\t\n30\t/**\n31\t * @brief Represents an array of polynomials.\n32\t *\n33\t * This structure encapsulates an array of Polynomial structs and its size,\n34\t * providing a convenient way to work with multiple polynomials collectively.\n35\t *\n36\t * The polies field holds a pointer to an array of Polynomial structs,\n37\t * while the size field indicates the number of polynomials in the array.\n38\t */\n39\ttypedef struct {\n40\t  Polynomial *polies; //!< Pointer to array of Polynomial structs\n41\t  size_t size;        //!< Number of polynomials in the array\n42\t} PolyArray;\n43\t\n44\t/**\n45\t * @brief Check equality between two polynomials.\n46\t *\n47\t * This function compares two polynomial structures to determine if they are\n48\t * equal.\n49\t *\n50\t * @param p1 Pointer to the first polynomial.\n51\t * @param p2 Pointer to the second polynomial.\n52\t *\n53\t * @return 1 if the polynomials are equal, 0 otherwise.\n54\t */\n55\tint poly_equal(const Polynomial *, const Polynomial *);\n56\t\n57\t/**\n58\t * @brief Free memory allocated for a polynomial.\n59\t *\n60\t * This function releases the memory allocated for the coefficients array of a\n61\t * polynomial.\n62\t *\n63\t * @param poly Pointer to the polynomial to be freed.\n64\t */\n65\tvoid poly_free(Polynomial *poly);\n66\t\n67\t/**\n68\t * @brief Set coefficients for a polynomial.\n69\t *\n70\t * This function sets the coefficients for a given polynomial structure.\n71\t *\n72\t * @param p Pointer to the polynomial structure.\n73\t * @param coeffs Pointer to an array of coefficients.\n74\t * @param size Size of the coefficients array.\n75\t *\n76\t * @return 0 if successful, -1 if an error occurred.\n77\t */\n78\tint set_polynomial(Polynomial *p, Coeff *coeffs, size_t size);\n79\t\n80\t/**\n81\t * @brief Allocate memory for a polynomial using malloc.\n82\t *\n83\t * This function allocates memory for a polynomial structure using malloc.\n84\t *\n85\t * @param p Pointer to the polynomial structure.\n86\t * @param size Size of the polynomial.\n87\t *\n88\t * @return 0 if successful, -1 if an error occurred.\n89\t */\n90\tint get_polynomial(Polynomial *p, size_t size);\n91\t\n92\tint get_polyarray(PolyArray *p, size_t size);\n93\t\n94\t/**\n95\t * @brief Set all coefficients of a polynomial to zero.\n96\t *\n97\t * This function sets all coefficients of a given polynomial to zero.\n98\t *\n99\t * @param p Pointer to the polynomial structure.\n100\t *\n101\t * @return 0 if successful, -1 if an error occurred.\n102\t */\n103\tint set_zero(const Polynomial *p);\n104\t\n105\t/**\n106\t * @brief Calculate the sum of coefficients in a polynomial.\n107\t *\n108\t * This function calculates the sum of all coefficients in the given polynomial.\n109\t *\n110\t * @param poly Pointer to the polynomial structure.\n111\t *\n112\t * @return The sum of coefficients in the polynomial.\n113\t */\n114\tint64_t coef_sum(const Polynomial *poly);\n115\t\n116\t/**\n117\t * @brief Calculate the degree of a polynomial.\n118\t *\n119\t * This function calculates the degree of the given polynomial.\n120\t *\n121\t * @param poly Pointer to the polynomial structure.\n122\t *\n123\t * @return The degree of the polynomial.\n124\t */\n125\tuint64_t poly_degree(const Polynomial *poly);\n126\t\n127\t/**\n128\t * @brief Fit polynomial to a specified modulus and remove leading zeros.\n129\t *\n130\t * This function adjusts the coefficients of the polynomial to fit within the\n131\t * specified modulus and removes leading zeros from the highest degrees (left of\n132\t * array).\n133\t *\n134\t * @param poly Pointer to the polynomial structure.\n135\t * @param mod The modulus to fit the coefficients within.\n136\t *\n137\t * @return 0 if successful, -1 if an error occurred.\n138\t */\n139\tint poly_fit(Polynomial *poly, uint64_t mod);\n140\t\n141\t/**\n142\t * @brief Multiply two polynomials and store the result.\n143\t *\n144\t * This function multiplies two polynomials and stores the result in the\n145\t * provided result polynomial, applying the specified modulus to each\n146\t * coefficient.\n147\t *\n148\t * @param poly1 Pointer to the first polynomial.\n149\t * @param poly2 Pointer to the second polynomial.\n150\t * @param result Pointer to the polynomial structure to store the result.\n151\t * @param mod The modulus to apply to each coefficient.\n152\t *\n153\t * @return 0 if successful, -1 if an error occurred.\n154\t */\n155\tint poly_mul(const Polynomial *poly1, const Polynomial *poly2,\n156\t             Polynomial *result, uint64_t mod);\n157\t\n158\t/**\n159\t * @brief Add two polynomials and store the result.\n160\t *\n161\t * This function adds two polynomials and stores the result in the provided\n162\t * result polynomial, applying the specified modulus to each coefficient.\n163\t *\n164\t * @param poly1 Pointer to the first polynomial.\n165\t * @param poly2 Pointer to the second polyno