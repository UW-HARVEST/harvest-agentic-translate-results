7\t        }\n58\t        Matrix3D { data }\n59\t    }\n60\t    pub fn get_mut(&mut self, idx: usize) -> Option<&mut Matrix2D> {\n61\t        if idx >= self.data.len() {\n62\t            return None;\n63\t        }\n64\t        Some(&mut self.data[idx])\n65\t    }\n66\t}\n67\tpub fn matrix2d_multiply(m: &Matrix2D, invm: &Matrix2D, modulus: u64) -> Result<Matrix2D> {\n68\t    if m.dim != invm.dim {\n69\t        return Err(AcesError::GenericError(\n70\t            \"matrix dimensions do not match\".to_string(),\n71\t        ));\n72\t    }\n73\t    if modulus == 0 {\n74\t        return Err(AcesError::GenericError(\"modulus is zero\".to_string()));\n75\t    }\n76\t    let dim = m.dim;\n77\t    let mut result = Matrix2D::new(dim);\n78\t    for i in 0..dim {\n79\t        for j in 0..dim {\n80\t            let mut sum: u64 = 0;\n81\t            for k in 0..dim {\n82\t                let a = m.data[i * dim + k];\n83\t                let b = invm.data[k * dim + j];\n84\t                sum = sum.wrapping_add(a.wrapping_mul(b));\n85\t            }\n86\t            result.data[i * dim + j] = sum % modulus;\n87\t        }\n88\t    }\n89\t    Ok(result)\n90\t}\n91\tpub fn swap_transform(m: &mut Matrix2D, invm: &mut Matrix2D, _modulus: u64) -> Result<()> {\n92\t    let dim = m.dim;\n93\t    if dim < 2 {\n94\t        return Ok(());\n95\t    }\n96\t    let source = randrange(1, (dim - 1) as u64) as usize;\n97\t    let target = randrange(0, (source - 1) as u64) as usize;\n98\t\n99\t    // Swap columns `source` and `target` in m.\n100\t    for row in 0..dim {\n101\t        let a = m.data[row * dim + source];\n102\t        let b = m.data[row * dim + target];\n103\t        m.data[row * dim + source] = b;\n104\t        m.data[row * dim + target] = a;\n105\t    }\n106\t    // Swap rows `source` and `target` in invm.\n107\t    for col in 0..dim {\n108\t        let a = invm.data[source * dim + col];\n109\t        let b = invm.data[target * dim + col];\n110\t        invm.data[source * dim +