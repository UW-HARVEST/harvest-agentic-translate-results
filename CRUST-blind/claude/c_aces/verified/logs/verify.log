{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GE3PStkqij7mAjcy9X2wDx","type":"tool_result","content":"1\tuse crate::channel::{Channel, Parameters};\n2\tuse crate::common::{clamp, normal_rand, randrange};\n3\tuse crate::error::Result;\n4\tuse crate::matrix::{fill_random_invertible_pairs, matrix2d_multiply, Matrix2D, Matrix3D};\n5\tuse crate::polynomial::{Coeff, PolyArray, Polynomial};\n6\t\n7\tconst EPROB: f64 = 0.5;\n8\t\n9\tfn coeff_modulo(value: i64, modulus: u64) -> i64 {\n10\t    if modulus == 0 {\n11\t        return value;\n12\t    }\n13\t    let m = modulus as i64;\n14\t    let r = value % m;\n15\t    if r < 0 {\n16\t        r + m\n17\t    } else {\n18\t        r\n19\t    }\n20\t}\n21\t\n22\t/// Generate an error element `rm` over Zq[X]₍u₎.\n23\tpub fn generate_error(q: u64, message: u64, rm: &mut Polynomial) -> Result<()> {\n24\t    if rm.coeffs.is_empty() {\n25\t        return Ok(());\n26\t    }\n27\t    let size = rm.coeffs.len();\n28\t    for i in 0..size {\n29\t        rm.coeffs[i] = randrange(0, q.saturating_sub(1)) as i64;\n30\t    }\n31\t    let last = rm.coeffs[size - 1];\n32\t    let csum = rm.coef_sum();\n33\t    let shift = coeff_modulo(last + (message as i64) - csum, q);\n34\t    rm.coeffs[size - 1] = if shift > 0 { shift } else { shift + q as i64 };\n35\t    Ok(())\n36\t}\n37\t\n38\t/// Generate a vanisher vector `e` over Zq[X]₍u₎.\n39\tpub fn generate_vanisher(p: u64, q: u64, e: &mut Polynomial) -> Result<()> {\n40\t    if e.coeffs.is_empty() {\n41\t        return Ok(());\n42\t    }\n43\t    // Mirror C: int64_t k = randrange(0, 1) < EPROB ? 0 : 1;\n44\t    // randrange(0, 1) returns u64 (0 or 1), comparing < 0.5: if 0 -> true, if 1 -> false\n45\t    let k: i64 = if (randrange(0, 1) as f64) < EPROB { 0 } else { 1 };\n46\t    let size = e.coeffs.len();\n47\t    for i in 0..size {\n48\t        e.coeffs[i] = randrange(0, q.saturating_sub(1)) as i64;\n49\t    }\n50\t    let last = e.coeffs[size - 1];\n51\t    let csum = e.coef_sum();\n52\t    let shift = coeff_modulo(last + (p as i64) * k - csum, q);\n53\t    e.coeffs[size - 1] = if shift > 0 { shift } else { shift + q as i64 };\n54\t    Ok(())\n55\t}\n56\t\n57\t/// Generate a linear vector `b` over Zq[X]₍u₎.\n58\tpub fn generate_linear(p: u64, q: u64, b: &mut Polynomial) -> Result<()> {\n59\t    if b.coeffs.is_empty() {\n60\t        return Ok(());\n61\t    }\n62\t    let k: i64 = randrange(0, p) as i64;\n63\t    let size = b.coeffs.len();\n64\t    for i in 0..size {\n65\t        b.coeffs[i] = randrange(0, q.saturating_sub(1)) as i64;\n66\t    }\n67\t    let last = b.coeffs[size - 1];\n68\t    let csum = b.coef_sum();\n69\t    let shift = coeff_modulo(last + k - csum, q);\n70\t    b.coeffs[size - 1] = if shift > 0 { shift } else { shift + q as i64 };\n71\t    Ok(())\n72\t}\n73\t\n74\t/// Generate the polynomial `u` for the arithmetic channel.\n75\tpub fn generate_u(channel: &Channel, param: &Parameters, u: &mut Polynomial) -> Result<()> {\n76\t    let dim = param.dim as usize;\n77\t    if u.coeffs.len() < dim + 1 {\n78\t        u.coeffs.resize(dim + 1, 0);\n79\t    }\n80\t    // Reset\n81\t    for c in u.coeffs.iter_mut() {\n82\t        *c = 0;\n83\t    }\n84\t\n85\t    if dim == 0 {\n86\t        return Ok(());\n87\t    }\n88\t    if dim == 1 {\n89\t        u.coeffs[0] = 1;\n90\t        u.coeffs[1] = (channel.q as i64) - u.coef_sum();\n91\t        return Ok(());\n92\t    }\n93\t\n94\t    // Mimic randrange(dim/2, dim - 1)\n95\t    let lower = (param.dim / 2) as u64;\n96\t    let upper = (param.dim - 1) as u64;\n97\t    let mut nonzeros = randrange(lower, upper);\n98\t    let mut zeroes = (param.dim as u64) - nonzeros;\n99\t    u.coeffs[0] = 1;\n100\t\n101\t    let mut i: usize = 1;\n102\t    while i < dim {\n103\t        if nonzeros > 1 {\n104\t            u.coeffs[i] = randrange(0, channel.q.saturating_sub(1)) as i64;\n105\t            i += 1;\n106\t            nonzeros -= 1;\n107\t        } else {\n108\t            break;\n109\t        }\n110\t\n111\t        if zeroes > 0 {\n112\t            let mid = (zeroes / 2) as f64;\n113\t            let sample = normal_rand(mid, mid);\n114\t            // C casts double->uint64_t. Negative doubles produce undefined behavior in C\n115\t            // but typically end up as 0 / large. Use clamp(0, zeroes, sample) where sample\n116\t            // is interpreted as if cast to u64. Negative values -> 0.\n117\t            let sample_u64 = if sample.is_nan() || sample < 0.0 {\n118\t                0\n119\t            } else {\n120\t                sample as u64\n121\t            };\n122\t            let samp = clamp(0, zeroes, sample_u64);\n123\t            let zero = randrange(0, samp);\n124\t            for _ in 0..zero {\n125\t                if i >= dim {\n126\t                    break;\n127\t                }\n128\t                u.coeffs[i] = 0;\n129\t                i += 1;\n130\t            }\n131\t            zeroes -= zero;\n132\t        }\n133\t    }\n134\t\n135\t    u.coeffs[dim] = 0;\n136\t    u.coeffs[dim] = (channel.q as i64) - u.coef_sum();\n137\t    Ok(())\n138\t}\n139\t\n140\t/// Generate the secret key for the arithmetic channel.\n141\tpub fn generate_secret(\n142\t    channel: &Channel,\n143\t    param: &Parameters,\n144\t    u: &Polynomial,\n145\t    secret: &mut PolyArray,\n146\t    lambda: &mut Matrix3D,\n147\t) -> Result<()> {\n148\t    let dim = param.dim as usize;\n149\t\n150\t    let mut m = Matrix2D::new(dim);\n151\t    let mut invm = Matrix2D::new(dim);\n152\t    fill_random_invertible_pairs(&mut m, &mut invm, channel.q, 600)?;\n153\t\n154\t    // Ensure secret has appropriate size.\n155\t    if secret.polies.len() < dim {\n156\t        secret\n157\t            .polies\n158\t            .resize(dim, Polynomial { coeffs: vec![0; dim] });\n159\t    }\n160\t    for i in 0..dim {\n161\t        if secret.polies[i].coeffs.len() < dim {\n162\t            secret.polies[i].coeffs.resize(dim, 0);\n163\t        }\n164\t        for j in 0..dim {\n165\t            secret.polies[i].coeffs[j] = m.data[j * dim + i] as i64;\n166\t        }\n167\t    }\n168\t\n169\t    // Ensure lambda has dim 2D matrices of dim x dim.\n170\t    if lambda.data.len() < dim {\n171\t        lambda.data.resize(dim, Matrix2D::new(dim));\n172\t    }\n173\t    for k in 0..dim {\n174\t        if lambda.data[k].dim != dim {\n175\t            lambda.data[k] = Matrix2D::new(dim);\n176\t        }\n177\t    }\n178\t\n179\t    // Reuse `m` as `arr` to hold per-column polynomial coefficients.\n180\t    let mut arr = Matrix2D::new(dim);\n181\t\n182\t    for i in 0..dim {\n183\t        for j in 0..dim {\n184\t            // a_ij = secret[i] * secret[j] mod u\n185\t            let mut a_ij_poly = secret.polies[i].mul(&secret.polies[j], channel.q)?;\n186\t            a_ij_poly.poly_mod(u, channel.q)?;\n187\t\n188\t            // The C version writes a_ij_poly.coeffs[arr->dim - row - 1] into arr.\n189\t            // After poly_mod, a_ij_poly may have a smaller size; pad with zeros at the\n190\t            // high end to length `dim` for indexing.\n191\t            let mut padded: Vec<Coeff> = vec![0; dim];\n192\t            let csize = a_ij_poly.coeffs.len();\n193\t            // Polynomial layout has highest degree at index 0. Right-align (low degree\n194\t            // at the end) so coeffs[size-1] is constant term.\n195\t            if csize <= dim {\n196\t                let offset = dim - csize;\n197\t                for (k, &c) in a_ij_poly.coeffs.iter().enumerate() {\n198\t                    padded[offset + k] = c;\n199\t                }\n200\t            } else {\n201\t                // Should not happen after mod, but truncate in case.\n202\t                let offset = csize - dim;\n203\t                for k in 0..dim {\n204\t                    padded[k] = a_ij_poly.coeffs[offset + k];\n205\t                }\n206\t            }\n207\t\n208\t            for row in 0..dim {\n209\t                let val = padded[dim - row - 1] as u64;\n210\t                arr.data[row * dim + j] = val;\n211\t            }\n212\t        }\n213\t\n214\t        // lambda[i] = invm * arr (mod q)\n215\t        let result = matrix2d_multiply(&invm, &arr, channel.q)?;\n216\t        lambda.data[i] = result;\n217\t    }\n218\t\n219\t    Ok(())\n220\t}\n221\t\n222\t/// Generate the polynomial array `f0` for the public key.\n223\tpub fn generate_f0(channel: &Channel, _param: &Parameters, f0: &mut PolyArray) -> Result<()> {\n224\t    // randrange(0, q - 1) yields the range [0, q-1] inclusive.\n225\t    let upper = channel.q.saturating_sub(1);\n226\t    for i in 0..f0.polies.len() {\n227\t        let len = f0.polies[i].coeffs.len();\n228\t        for j in 0..len {\n229\t            f0.polies[i].coeffs[j] = randrange(0, upper) as i64;\n230\t        }\n231\t    }\n232\t    Ok(())\n233\t}\n234\t\n235\t/// Generate the polynomial `f1` for the public key.\n236\tpub fn generate_f1(\n237\t    channel: &Channel,\n238\t    param: &Parameters,\n239\t    f0: &PolyArray,\n240\t    x: &PolyArray,\n241\t    u: &Polynomial,\n242\t    f1: &mut Polynomial,\n243\t) -> Result<()> {\n244\t    let dim = param.dim as usize;\n245\t    let mut f_pre = Polynomial {\n246\t        coeffs: vec![0i64; dim * 2],\n247\t    };\n248\t\n249\t    for i in 0..dim {\n250\t        let tmp = f0.polies[i].mul(&x.polies[i], channel.q)?;\n251\t        f_pre = f_pre.add(&tmp, channel.q)?;\n252\t    }\n253\t    f_pre.poly_mod(u, channel.q)?;\n254\t\n255\t    // Replace f1 contents with f_pre.\n256\t    f1.coeffs = f_pre.coeffs;\n257\t    Ok(())\n258\t}\n259\t"}]},"parent_tool_use_id":null,"session_id":"d60e8fb7-2c6b-49b9-a6a3-fe9a86fd3fda","uuid":"f8a59dcd-fcb8-4013-a309-e8bf61b2ab30","timestamp":"2026-05-29T17:07:33.519Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-ngxgQC/project/src/aces_internal.rs","content":"use crate::channel::{Channel, Parameters};\nuse crate::common::{clamp, normal_rand, randrange};\nuse crate::error::Result;\nuse crate::matrix::{fill_random_invertible_pairs, matrix2d_multiply, Matrix2D, Matrix3D};\nuse crate::polynomial::{Coeff, PolyArray, Polynomial};\n\nconst EPROB: f64 = 0.5;\n\nfn coeff_modulo(value: i64, modulus: u64) -> i64 {\n    if modulus == 0 {\n        return value;\n    }\n    let m = modulus as i64;\n    let r = value % m;\n    if r < 0 {\n        r + m\n    } else {\n        r\n    }\n}\n\n/// Generate an error element `rm` over Zq[X]₍u₎.\npub fn generate_error(q: u64, message: u64, rm: &mut Polynomial) -> Result<()> {\n    if rm.coeffs.is_empty() {\n        return Ok(());\n    }\n    let size = rm.coeffs.len();\n    for i in 0..size {\n        rm.coeffs[i] = randrange(0, q.saturating_sub(1)) as i64;\n    }\n    let last = rm.coeffs[size - 1];\n    let csum = rm.coef_sum();\n    let shift = coeff_modulo(last + (message as i64) - csum, q);\n    rm.coeffs[size - 1] = if shift > 0 { shift } else { shift + q as i64 };\n    Ok(())\n}\n\n/// Generate a vanisher vector `e` over Zq[X]₍u₎.\npub fn generate_vanisher(p: u64, q: u64, e: &mut Polynomial) -> Result<()> {\n    if e.coeffs.is_empty() {\n        return Ok(());\n    }\n    // Mirror C: int64_t k = randrange(0, 1) < EPROB ? 0 : 1;\n    // randrange(0, 1) returns u64 (0 or 1), comparing < 0.5: if 0 -> true, if 1 -> false\n    let k: i64 = if (randrange(0, 1) as f64) < EPROB { 0 } else { 1 };\n    let size = e.coeffs.len();\n    for i in 0..size {\n        e.coeffs[i] = randrange(0, q.saturating_sub(1)) as i64;\n    }\n    let last = e.coeffs[size - 1];\n    let csum = e.coef_sum();\n    let shift = coeff_modulo(last + (p as i64) * k - csum, q);\n    e.coeffs[size - 1] = if shift > 0 { shift } else { shift + q as i64 };\n    Ok(())\n}\n\n/// Generate a linear vector `b` over Zq[X]₍u₎.\npub fn generate_linear(p: u64, q: u64, b: &mut Polynomial) -> Result<()> {\n    if b.coeffs.is_empty() {\n        return Ok(());\n    }\n    let k: i64 = randrange(0, p) as i64;\n    let size = b.coeffs.len();\n    for i in 0..size {\n        b.coeffs[i] = randrange(0, q.saturating_sub(1)) as i64;\n    }\n    let last = b.coeffs[size - 1];\n    let csum = b.coef_sum();\n    let shift = coeff_modulo(last + k - csum, q);\n    b.coeffs[size - 1] = if shift > 0 { shift } else { shift + q as i64 };\n    Ok(())\n}\n\n/// Generate the polynomial `u` for the arithmetic channel.\npub fn generate_u(channel: &Channel, param: &Parameters, u: &mut Polynomial) -> Result<()> {\n    let dim = param.dim as usize;\n    if u.coeffs.len() < dim + 1 {\n        u.coeffs.resize(dim + 1, 0);\n    }\n    // Reset\n    for c in u.coeffs.iter_mut() {\n        *c = 0;\n    }\n\n    if dim == 0 {\n        return Ok(());\n    }\n    if dim == 1 {\n        u.coeffs[0] = 1;\n        u.coeffs[1] = (channel.q as i64) - u.coef_sum();\n        return Ok(());\n    }\n\n    // Mimic randrange(dim/2, dim - 1)\n    let lower = (param.dim / 2) as u64;\n    let upper = (param.dim - 1) as u64;\n    let mut nonzeros = randrange(lower, upper);\n    let mut zeroes = (param.dim as u64) - nonzeros;\n    u.coeffs[0] = 1;\n\n    let mut i: usize = 1;\n    while i < dim {\n        if nonzeros > 1 {\n            u.coeffs[i] = randrange(0, channel.q.saturating_sub(1)) as i64;\n            i += 1;\n            nonzeros -= 1;\n        } else {\n            break;\n        }\n\n        if zeroes > 0 {\n            let mid = (zeroes / 2) as f64;\n            let sample = normal_rand(mid, mid);\n            // C casts double->uint64_t. Negative doubles produce undefined behavior in C\n            // but typically end up as 0 / large. Use clamp(0, zeroes, sample) where sample\n            // is interpreted as if cast to u64. Negative values -> 0.\n            let sample_u64 = if sample.is_nan() || sample < 0.0 {\n                0\n            } else {\n                sample as u64\n            };\n            let samp = clamp(0, zeroes, sample_u64);\n            let zero = randrange(0, samp);\n            for _ in 0..zero {\n                if i >= dim {\n                    break;\n                }\n                u.coeffs[i] = 0;\n                i += 1;\n            }\n            zeroes -= zero;\n        }\n    }\n\n    u.coeffs[dim] = 0;\n    u.coeffs[dim] = (channel.q as i64) - u.coef_sum();\n    Ok(())\n}\n\n/// Generate the secret key for the arithmetic channel.\npub fn generate_secret(\n    channel: &Channel,\n    param: &Parameters,\n    u: &Polynomial,\n    secret: &mut PolyArray,\n    lambda: &mut Matrix3D,\n) -> Result<()> {\n    let dim = param.dim as usize;\n\n    let mut m = Matrix2D::new(dim);\n    let mut invm = Matrix2D::new(dim);\n    fill_random_invertible_pairs(&mut m, &mut invm, channel.q, 600)?;\n\n    // Ensure secret has appropriate size.\n    if secret.polies.len() < dim {\n        secret\n            .polies\n            .resize(dim, Polynomial { coeffs: vec![0; dim] });\n    }\n    for i in 0..dim {\n        if secret.polies[i].coeffs.len() < dim {\n            secret.polies[i].coeffs.resize(dim, 0);\n        }\n        for j in 0..dim {\n            secret.polies[i].coeffs[j] = m.data[j * dim + i] as i64;\n        }\n    }\n\n    // Ensure lambda has dim 2D matrices of dim x dim.\n    if lambda.data.len() < dim {\n        lambda.data.resize(dim, Matrix2D::new(dim));\n    }\n    for k in 0..dim {\n        if lambda.data[k].dim != dim {\n            lambda.data[k] = Matrix2D::new(dim);\n        }\n    }\n\n    // Reuse `m` as `arr` to hold per-column polynomial coefficients.\n    let mut arr = Matrix2D::new(dim);\n\n    for i in 0..dim {\n        for j in 0..dim {\n            // a_ij = secret[i] * secret[j] mod u\n            let mut a_ij_poly = secret.polies[i].mul(&secret.polies[j], channel.q)?;\n            a_ij_poly.poly_mod(u, channel.q)?;\n\n            // The C version writes a_ij_poly.coeffs[arr->dim - row - 1] into arr.\n            // After poly_mod, a_ij_poly may have a smaller size; pad with zeros at the\n            // high end to length `dim` for indexing.\n            let mut padded: Vec<Coeff> = vec![0; dim];\n            let csize = a_ij_poly.coeffs.len();\n            // Polynomial layout has highest degree at index 0. Right-align (low degree\n            // at the end) so coeffs[size-1] is constant term.\n            if csize <= dim {\n                let offset = dim - csize;\n                for (k, &c) in a_ij_poly.coeffs.iter().enumerate() {\n                    padded[offset + k] = c;\n                }\n            } else {\n                // Should not happen after mod, but truncate in case.\n                let offset = csize - dim;\n                for k in 0..dim {\n                    padded[k] = a_ij_poly.coeffs[offset + k];\n                }\n            }\n\n            for row in 0..dim {\n                let val = padded[dim - row - 1] as u64;\n                arr.data[row * dim + j] = val;\n            }\n        }\n\n        // lambda[i] = invm * arr (mod q)\n        let result = matrix2d_multiply(&invm, &arr, channel.q)?;\n        lambda.data[i] = result;\n    }\n\n    Ok(())\n}\n\n/// Generate the polynomial array `f0` for the public key.\npub fn generate_f0(channel: &Channel, _param: &Parameters, f0: &mut PolyArray) -> Result<()> {\n    // randrange(0, q - 1) yields the range [0, q-1] inclusive.\n    let upper = channel.q.saturating_sub(1);\n    for i in 0..f0.polies.len() {\n        let len = f0.polies[i].coeffs.len();\n        for j in 0..len {\n            f0.polies[i].coeffs[j] = randrange(0, upper) as i64;\n        }\n    }\n    Ok(())\n}\n\n/// Generate the polynomial `f1` for the public key.\npub fn generate_f1(\n    channel: &Channel,\n    param: &Parameters,\n    f0: &PolyArray,\n    x: &PolyArray,\n    u: &Polynomial,\n    f1: &mut Polynomial,\n) -> Result<()> {\n    let dim = param.dim as usize;\n    let mut f_pre = Polynomial {\n        coeffs: vec![0i64; dim * 2],\n    };\n\n    for i in 0..dim {\n        let tmp = f0.polies[i].mul(&x.polies[i], channel.q)?;\n        f_pre = f_pre.add(&tmp, channel.q)?;\n    }\n    f_pre.poly_mod(u, channel.q)?;\n\n    // Replace f1 contents with f_pre.\n    f1.coeffs = f_pre.coeffs;\n    Ok(())\n}\n","numLines":259,"startLine":1,"totalLines":259}}}
