{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AhBL8gCr3LKjcZPq3yfHaX","type":"tool_result","content":"1\t#ifndef MATRIX_H\n2\t#define MATRIX_H\n3\t\n4\t#ifdef __cplusplus\n5\textern \"C\" {\n6\t#endif\n7\t\n8\t#include <stddef.h>\n9\t#include <stdint.h>\n10\t\n11\t#define TRANSFORM_COUNT 3\n12\t\n13\t/**\n14\t * @brief Represents a square 2D matrix.\n15\t *\n16\t * This structure encapsulates a 2D matrix with its dimensions and data.\n17\t *\n18\t * @param dim The dimension (number of rows/columns) of the matrix.\n19\t * @param data Pointer to the array storing the matrix elements in row-major\n20\t * order.\n21\t */\n22\ttypedef struct {\n23\t  size_t dim;     //!< The dimension (number of rows/columns) of the matrix.\n24\t  uint64_t *data; //!< Pointer to the array storing the matrix elements in\n25\t                  //!< row-major order.\n26\t} Matrix2D;\n27\t\n28\ttypedef int (*Transformer)(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n29\t\n30\t/**\n31\t * @brief Represents a 3D matrix.\n32\t *\n33\t * This structure encapsulates a 3D matrix with its dimensions and data.\n34\t *\n35\t * @param data Pointer to the array storing the 2D matrices.\n36\t * @param size The size (number of 2D matrices) in the 3D matrix.\n37\t */\n38\ttypedef struct {\n39\t  Matrix2D *data; //!< Pointer to the array storing the 2D matrices.\n40\t  size_t size;    //!< The size (number of 2D matrices) in the 3D matrix.\n41\t} Matrix3D;\n42\t\n43\t/**\n44\t * @brief Get a 2D matrix from a 3D matrix.\n45\t *\n46\t * This function retrieves a pointer to a 2D matrix from the specified index of\n47\t * the 3D matrix.\n48\t *\n49\t * @param lambda Pointer to the 3D matrix.\n50\t * @param idx The index of the desired 2D matrix.\n51\t *\n52\t * @return Pointer to the specified 2D matrix.\n53\t */\n54\tMatrix2D *matrix3d_get(Matrix3D *lambda, size_t idx);\n55\t\n56\t/**\n57\t * @brief Get a pointer to a specific row in a 2D matrix.\n58\t *\n59\t * This function returns a pointer to the specified row in the given 2D matrix.\n60\t *\n61\t * @param matrix Pointer to the 2D matrix.\n62\t * @param row The index of the desired row.\n63\t *\n64\t * @return Pointer to the specified row.\n65\t */\n66\tstatic inline uint64_t *matrix2d_row(Matrix2D *matrix, size_t row) {\n67\t  return matrix->data + row * matrix->dim;\n68\t}\n69\t\n70\t/**\n71\t * @brief Get the value at a specific position in a 2D matrix.\n72\t *\n73\t * This function returns the value at the specified row and column in the given\n74\t * 2D matrix.\n75\t *\n76\t * @param matrix Pointer to the 2D matrix.\n77\t * @param row The index of the desired row.\n78\t * @param col The index of the desired column.\n79\t *\n80\t * @return The value at the specified position.\n81\t */\n82\tstatic inline uint64_t matrix2d_get(Matrix2D *matrix, size_t row, size_t col) {\n83\t  size_t dim = matrix->dim;\n84\t  return matrix->data[row * dim + col];\n85\t}\n86\t\n87\t/**\n88\t * @brief Set the value at a specific position in a 2D matrix.\n89\t *\n90\t * This function sets the value at the specified row and column in the given 2D\n91\t * matrix.\n92\t *\n93\t * @param matrix Pointer to the 2D matrix.\n94\t * @param row The index of the desired row.\n95\t * @param col The index of the desired column.\n96\t * @param value The value to set at the specified position.\n97\t */\n98\tstatic inline void matrix2d_set(Matrix2D *matrix, size_t row, size_t col,\n99\t                                uint64_t value) {\n100\t  size_t dim = matrix->dim;\n101\t  matrix->data[row * dim + col] = value;\n102\t}\n103\t\n104\t/**\n105\t * @brief Multiply two 2D matrices and store the result.\n106\t *\n107\t * This function multiplies two 2D matrices and stores the result in the\n108\t * provided result matrix, applying the specified modulus to each element.\n109\t *\n110\t * @param m Pointer to the first matrix.\n111\t * @param invm Pointer to the second matrix.\n112\t * @param result Pointer to the matrix structure to store the result.\n113\t * @param mod The modulus to apply to each element.\n114\t *\n115\t * @return 0 if successful, -1 if an error occurred.\n116\t */\n117\tint matrix2d_multiply(Matrix2D *m, Matrix2D *invm, Matrix2D *result,\n118\t                      uint64_t mod);\n119\t\n120\t/**\n121\t * @brief Perform a random swap of rows and corresponding columns between two\n122\t * matrices.\n123\t *\n124\t * This function randomly selects two rows in the matrix `m` and swaps their\n125\t * positions, simultaneously swapping the corresponding columns in the matrix\n126\t * `invm`.\n127\t *\n128\t * @param m Pointer to the first matrix.\n129\t * @param invm Pointer to the second matrix.\n130\t * @param mod The modulus to apply to each element.\n131\t *\n132\t * @return 0 if successful.\n133\t */\n134\tint swap_transform(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n135\t\n136\t/**\n137\t * @brief Apply a linear mixing transformation between two matrices.\n138\t *\n139\t * This function applies a linear mixing transformation between two matrices `m`\n140\t * and `invm`. It randomly selects two columns in matrix `m`, and for each row,\n141\t * it adds a scaled value from the source column to the target column, where the\n142\t * scale factor is randomly chosen. The operation is performed modulo `mod`.\n143\t *\n144\t * Additionally, the corresponding rows in matrix `invm` are adjusted to\n145\t * maintain the inverse relationship with matrix `m`.\n146\t *\n147\t * @param m Pointer to the first matrix.\n148\t * @param invm Pointer to the second matrix.\n149\t * @param mod The modulus to apply to each element.\n150\t *\n151\t * @return 0 if successful.\n152\t */\n153\tint linear_mix_transform(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n154\t\n155\t/**\n156\t * @brief Apply a scaling transformation to two matrices.\n157\t *\n158\t * This function applies a scaling transformation to the elements of two\n159\t * matrices `m` and `invm`. It randomly selects a scaling factor and its modular\n160\t * inverse, and then scales each element of both matrices by their respective\n161\t * factors. The operation is performed modulo `mod`.\n162\t *\n163\t * @param m Pointer to the first matrix.\n164\t * @param invm Pointer to the second matrix.\n165\t * @param mod The modulus to apply to each element.\n166\t *\n167\t * @return 1 if successful (typo correction: should be 0 if successful).\n168\t */\n169\tint scale_transform(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n170\t\n171\t/**\n172\t * @brief Set the given matrix to the identity matrix.\n173\t *\n174\t * This function sets the elements of the given matrix `m` to form an identity\n175\t * matrix. An identity matrix is a square matrix in which all elements are zero\n176\t * except for the diagonal elements, which are set to one.\n177\t *\n178\t * @param m Pointer to the matrix to be set to the identity matrix.\n179\t *\n180\t * @return 0 if successful.\n181\t */\n182\tint matrix2d_eye(Matrix2D *m);\n183\t\n184\t/**\n185\t * @brief Fill randomly generated invertible matrix pairs using a set of simple\n186\t * linear transformations.\n187\t *\n188\t * This function fills randomly generated invertible matrix pairs `m` and `invm`\n189\t * using a set of simple linear transformations. For each iteration, it randomly\n190\t * selects a transformation from the available set of transformations and\n191\t * applies it to both matrices `m` and `invm`.\n192\t *\n193\t * The set of available transformations includes swapping rows and columns,\n194\t * scaling each element by a random factor, and applying a linear mixing\n195\t * transformation.\n196\t *\n197\t * @param m Pointer to the first matrix.\n198\t * @param invm Pointer to the second matrix.\n199\t * @param mod The modulus to apply to each element.\n200\t * @param iterations The number of iterations to perform, each representing an\n201\t * application of a transformation.\n202\t */\n203\tint fill_random_invertible_pairs(Matrix2D *m, Matrix2D *invm, uint64_t mod,\n204\t                                 size_t iterations);\n205\t\n206\t#ifdef __cplusplus\n207\t}\n208\t#endif\n209\t\n210\t#endif\n211\t"}]},"parent_tool_use_id":null,"session_id":"d60e8fb7-2c6b-49b9-a6a3-fe9a86fd3fda","uuid":"a28167f3-28ab-4495-a612-3c0737d1a3e2","timestamp":"2026-05-29T17:06:40.565Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-verify-ngxgQC/project/c_src/src/include/Matrix.h","content":"#ifndef MATRIX_H\n#define MATRIX_H\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n#include <stddef.h>\n#include <stdint.h>\n\n#define TRANSFORM_COUNT 3\n\n/**\n * @brief Represents a square 2D matrix.\n *\n * This structure encapsulates a 2D matrix with its dimensions and data.\n *\n * @param dim The dimension (number of rows/columns) of the matrix.\n * @param data Pointer to the array storing the matrix elements in row-major\n * order.\n */\ntypedef struct {\n  size_t dim;     //!< The dimension (number of rows/columns) of the matrix.\n  uint64_t *data; //!< Pointer to the array storing the matrix elements in\n                  //!< row-major order.\n} Matrix2D;\n\ntypedef int (*Transformer)(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n\n/**\n * @brief Represents a 3D matrix.\n *\n * This structure encapsulates a 3D matrix with its dimensions and data.\n *\n * @param data Pointer to the array storing the 2D matrices.\n * @param size The size (number of 2D matrices) in the 3D matrix.\n */\ntypedef struct {\n  Matrix2D *data; //!< Pointer to the array storing the 2D matrices.\n  size_t size;    //!< The size (number of 2D matrices) in the 3D matrix.\n} Matrix3D;\n\n/**\n * @brief Get a 2D matrix from a 3D matrix.\n *\n * This function retrieves a pointer to a 2D matrix from the specified index of\n * the 3D matrix.\n *\n * @param lambda Pointer to the 3D matrix.\n * @param idx The index of the desired 2D matrix.\n *\n * @return Pointer to the specified 2D matrix.\n */\nMatrix2D *matrix3d_get(Matrix3D *lambda, size_t idx);\n\n/**\n * @brief Get a pointer to a specific row in a 2D matrix.\n *\n * This function returns a pointer to the specified row in the given 2D matrix.\n *\n * @param matrix Pointer to the 2D matrix.\n * @param row The index of the desired row.\n *\n * @return Pointer to the specified row.\n */\nstatic inline uint64_t *matrix2d_row(Matrix2D *matrix, size_t row) {\n  return matrix->data + row * matrix->dim;\n}\n\n/**\n * @brief Get the value at a specific position in a 2D matrix.\n *\n * This function returns the value at the specified row and column in the given\n * 2D matrix.\n *\n * @param matrix Pointer to the 2D matrix.\n * @param row The index of the desired row.\n * @param col The index of the desired column.\n *\n * @return The value at the specified position.\n */\nstatic inline uint64_t matrix2d_get(Matrix2D *matrix, size_t row, size_t col) {\n  size_t dim = matrix->dim;\n  return matrix->data[row * dim + col];\n}\n\n/**\n * @brief Set the value at a specific position in a 2D matrix.\n *\n * This function sets the value at the specified row and column in the given 2D\n * matrix.\n *\n * @param matrix Pointer to the 2D matrix.\n * @param row The index of the desired row.\n * @param col The index of the desired column.\n * @param value The value to set at the specified position.\n */\nstatic inline void matrix2d_set(Matrix2D *matrix, size_t row, size_t col,\n                                uint64_t value) {\n  size_t dim = matrix->dim;\n  matrix->data[row * dim + col] = value;\n}\n\n/**\n * @brief Multiply two 2D matrices and store the result.\n *\n * This function multiplies two 2D matrices and stores the result in the\n * provided result matrix, applying the specified modulus to each element.\n *\n * @param m Pointer to the first matrix.\n * @param invm Pointer to the second matrix.\n * @param result Pointer to the matrix structure to store the result.\n * @param mod The modulus to apply to each element.\n *\n * @return 0 if successful, -1 if an error occurred.\n */\nint matrix2d_multiply(Matrix2D *m, Matrix2D *invm, Matrix2D *result,\n                      uint64_t mod);\n\n/**\n * @brief Perform a random swap of rows and corresponding columns between two\n * matrices.\n *\n * This function randomly selects two rows in the matrix `m` and swaps their\n * positions, simultaneously swapping the corresponding columns in the matrix\n * `invm`.\n *\n * @param m Pointer to the first matrix.\n * @param invm Pointer to the second matrix.\n * @param mod The modulus to apply to each element.\n *\n * @return 0 if successful.\n */\nint swap_transform(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n\n/**\n * @brief Apply a linear mixing transformation between two matrices.\n *\n * This function applies a linear mixing transformation between two matrices `m`\n * and `invm`. It randomly selects two columns in matrix `m`, and for each row,\n * it adds a scaled value from the source column to the target column, where the\n * scale factor is randomly chosen. The operation is performed modulo `mod`.\n *\n * Additionally, the corresponding rows in matrix `invm` are adjusted to\n * maintain the inverse relationship with matrix `m`.\n *\n * @param m Pointer to the first matrix.\n * @param invm Pointer to the second matrix.\n * @param mod The modulus to apply to each element.\n *\n * @return 0 if successful.\n */\nint linear_mix_transform(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n\n/**\n * @brief Apply a scaling transformation to two matrices.\n *\n * This function applies a scaling transformation to the elements of two\n * matrices `m` and `invm`. It randomly selects a scaling factor and its modular\n * inverse, and then scales each element of both matrices by their respective\n * factors. The operation is performed modulo `mod`.\n *\n * @param m Pointer to the first matrix.\n * @param invm Pointer to the second matrix.\n * @param mod The modulus to apply to each element.\n *\n * @return 1 if successful (typo correction: should be 0 if successful).\n */\nint scale_transform(Matrix2D *m, Matrix2D *invm, uint64_t mod);\n\n/**\n * @brief Set the given matrix to the identity matrix.\n *\n * This function sets the elements of the given matrix `m` to form an identity\n * matrix. An identity matrix is a square matrix in which all elements are zero\n * except for the diagonal elements, which are set to one.\n *\n * @param m Pointer to the matrix to be set to the identity matrix.\n *\n * @return 0 if successful.\n */\nint matrix2d_eye(Matrix2D *m);\n\n/**\n * @brief Fill randomly generated invertible matrix pairs using a set of simple\n * linear transformations.\n *\n * This function fills randomly generated invertible matrix pairs `m` and `invm`\n * using a set of simple linear transformations. For each iteration, it randomly\n * selects a transformation from the available set of transformations and\n * applies it to both matrices `m` and `invm`.\n *\n * The set of available transformations includes swapping rows and columns,\n * scaling each element by a random factor, and applying a linear mixing\n * transformation.\n *\n * @param m Pointer to the first matrix.\n * @param invm Pointer to the second matrix.\n * @param mod The modulus to apply to each element.\n * @param iterations The number of iterations to perform, each representing an\n * application of a transformation.\n */\nint fill_random_invertible_pairs(Matrix2D *m, Matrix2D *invm, uint64_t mod,\n                                 size_t iterations);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n","numLines":211,"startLine":1,"totalLines":211}}}
