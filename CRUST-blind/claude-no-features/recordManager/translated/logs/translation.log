Status) {\n309\t        return RC_WRITE_FAILED; \n310\t    }\n311\t    return RC_OK;\n312\t}\n313\t\n314\t// Define append and empty block\n315\tRC appendEmptyBlock(SM_FileHandle *fHandle) {\n316\t    FILE *fp = fHandle->mgmtInfo;\n317\t    char *pageData;\n318\t    int FILE_RC;\n319\t    const int maxWriteTrial = 2;\n320\t    int Action = 0;\n321\t    int SuccessStatus = 0;\n322\t    pageData = (char *)calloc(PAGE_SIZE, sizeof(char));\n323\t    if (pageData == NULL) {\n324\t        return RC_MEMORY_ALLOCATION_FAIL;\n325\t    }\n326\t    if (fp == NULL) {\n327\t        free(pageData);\n328\t        return RC_FILE_HANDLE_NOT_INIT;\n329\t    }\n330\t    FILE_RC = fseek(fp, 0, SEEK_END);\n331\t    if (FILE_RC != 0) {\n332\t        free(pageData);\n333\t        return RC_SEEK_FAILED;\n334\t    }\n335\t    for (Action = 0; Action < maxWriteTrial; Action++) {\n336\t        FILE_RC = fwrite(pageData, PAGE_SIZE, 1, fp);\n337\t        if (FILE_RC == 1) {\n338\t            SuccessStatus = 1;\n339\t            break;\n340\t        }\n341\t    }\n342\t    free(pageData);\n343\t    if (!SuccessStatus) {\n344\t        return RC_WRITE_FAILED;\n345\t    }\n346\t    fHandle->totalNumPages += 1;\n347\t    fHandle->curPagePos = fHandle->totalNumPages - 1;\n348\t    return RC_OK;\n349\t}\n350\t\n351\t// Define ensureCapacity\n352\tRC ensureCapacity(int allPagesCount, SM_FileHandle *fHandle) {\n353\t    if (fHandle == NULL || fHandle->mgmtInfo == NULL) {\n354\t        return RC_FILE_HANDLE_NOT_INIT;\n355\t    }\n356\t    int activePageCount = fHandle->totalNumPages;\n357\t    if (allPagesCount <= activePageCount) {\n358\t        return RC_OK;\n359\t    }\n360\t    int IncrementPageCount = allPagesCount - activePageCount;\n361\t    int FILE_RC, i;\n362\t    for (i = 0; i < IncrementPageCount; i++) {\n363\t        FILE_RC = appendEmptyBlock(fHandle);\n364\t        if (FILE_RC != RC_OK) {\n365\t            return FILE_RC;\n366\t        }\n367\t    }\n368\t    return RC_OK;\n369\t}\n370\t\n