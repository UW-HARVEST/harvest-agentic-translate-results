city before writing\n125\t                RC rc = ensureCapacity(bpl->pagenum[j] + 1, &bpl->fhl);\n126\t                if (rc != RC_OK) {\n127\t                    return rc;\n128\t                }\n129\t                // Write block\n130\t                rc = writeBlock(bpl->pagenum[j], &bpl->fhl, (bpl->pagedata + record_pointer));\n131\t                if (rc != RC_OK) {\n132\t                    return RC_WRITE_FAILED;\n133\t                }\n134\t                bpl->numWrite++;\n135\t            }\n136\t        }\n137\t        return RC_OK;\n138\t    }\n139\t\n140\t    // Helper function\n141\t    static RC freeBufferPoolMemory(BM_BufferPool *const bm)\n142\t                \n143\t            {\n144\t        if (bm != NULL) {\n145\t            Bufferpool *bpl = bm->mgmtData;\n146\t            if (bpl != NULL) {\n147\t                if (bpl->updatedOrder != NULL) {\n148\t                    free(bpl->updatedOrder);\n149\t                    bpl->updatedOrder = NULL; \n150\t                }\n151\t                if (bpl->pagenum != NULL) {\n152\t                    free(bpl->pagenum);\n153\t                    bpl->pagenum = NULL; \n154\t                }\n155\t                if (bpl->bitdirty != NULL) {\n156\t                    free(bpl->bitdirty);\n157\t                    bpl->bitdirty = NULL; \n158\t                }\n159\t                if (bpl->fix_count != NULL) {\n160\t                    free(bpl->fix_count);\n161\t                    bpl->fix_count = NULL;\n162\t                }\n163\t                if (bpl->pagedata != NULL) {\n164\t                    free(bpl->pagedata);\n165\t                    bpl->pagedata = NULL; \n166\t                }\n167\t                free(bpl);\n168\t                bm->mgmtData = NULL;\n169\t            } else {\n170\t            }\n171\t            return RC_OK;\n172\t        } else {\n173\t            return RC_ERROR; \n174\t        }\n175\t\n176\t        return RC_OK;\n177\t}\n178\t    // Define flush the