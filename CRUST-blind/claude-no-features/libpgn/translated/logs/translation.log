51\t\n52\t        pgn_cursor_skip_whitespace(str, &cursor);\n53\t    }\n54\t    pgn_cursor_revisit_whitespace(str, &cursor);\n55\t\n56\t    *consumed += cursor;\n57\t    return annotation;\n58\t}\n59\t\n60\tpgn_annotation_t __pgn_annotation_from_string(char *str, size_t *consumed)\n61\t{\n62\t    /* TODO: maybe refactor using strcmp()?\n63\t     */\n64\t    pgn_annotation_t annotation = PGN_ANNOTATION_UNKNOWN;\n65\t\n66\t    if (str[0] == '\\0')\n67\t        return annotation;\n68\t\n69\t    if (str[0] == '!') {\n70\t        (*consumed)++;\n71\t        annotation = PGN_ANNOTATION_GOOD_MOVE;\n72\t    }\n73\t\n74\t    if (str[0] == '?') {\n75\t        (*consumed)++;\n76\t        annotation = PGN_ANNOTATION_MISTAKE;\n77\t    }\n78\t\n79\t    if (str[1] == '\\0')\n80\t        return annotation;\n81\t\n82\t    if (str[0] == '!' && str[1] == '!') {\n83\t        (*consumed)++;\n84\t        annotation = PGN_ANNOTATION_BRILLIANT_MOVE;\n85\t    }\n86\t\n87\t    if (str[0] == '!' && str[1] == '?') {\n88\t        (*consumed)++;\n89\t        annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n90\t    }\n91\t\n92\t    if (str[0] == '?' && str[1] == '!') {\n93\t        (*consumed)++;\n94\t        annotation = PGN_ANNOTATION_DUBIOUS_MOVE;\n95\t    }\n96\t\n97\t    if (str[0] == '?' && str[1] == '?') {\n98\t        (*consumed)++;\n99\t        annotation = PGN_ANNOTATION_BLUNDER;\n100\t    }\n101\t\n102\t    return annotation;\n103\t}\n104\t\n105\tpgn_annotation_t pgn_annotation_from_string(char *str)\n106\t{\n107\t    size_t consumed = 0;\n108\t    return __pgn_annotation_from_string(str, &consumed);\n109\t}\n110\t\n111\tsize_t pgn_annotation_to_string(pgn_annotation_t annotation, char *dest)\n112\t{\n113\t    switch (annotation) {\n114\t    case PGN_ANNOTATION_UNKNOWN: return 0;\n115\t    case PGN_ANNOTATION_NULL: break;\n116\t    case PGN_ANNOTATION_GOOD_MOVE:\n117\t        strcpy(dest, \"!\");\n118\t        return 1;\n119\t    case PGN_ANNOTATION_MISTAKE:\n120\t        strcpy(dest, \"?