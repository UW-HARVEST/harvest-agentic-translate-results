}\n56\t\n57\t    move.piece = pgn_piece_from_char(str[cursor++]);\n58\t    if (move.piece == PGN_PIECE_UNKNOWN) {\n59\t        move.piece = PGN_PIECE_PAWN;\n60\t        cursor--;\n61\t    }\n62\t\n63\t    /* NOTE: can be refactored using a stack\n64\t     */\n65\t    if (islower(str[cursor]) && str[cursor] != 'x') move.from.file = str[cursor++];\n66\t    if (isdigit(str[cursor])) move.from.rank = str[cursor++] - '0';\n67\t\n68\t    move.captures = str[cursor] == 'x' || str[cursor] == ':';\n69\t    cursor += move.captures;\n70\t\n71\t    if (islower(str[cursor])) {\n72\t        assert(islower(str[cursor]));\n73\t        move.dest.file = str[cursor++];\n74\t        assert(isdigit(str[cursor]));\n75\t        move.dest.rank = str[cursor++] - '0';\n76\t    } else {\n77\t        move.dest = move.from;\n78\t        move.from = (pgn_coordinate_t){0};\n79\t    }\n80\t\n81\t    move.promoted_to = pgn_piece_from_char(str[cursor]);\n82\t    if (move.promoted_to == PGN_PIECE_UNKNOWN) {\n83\t        switch (str[cursor]) {\n84\t        case '(':\n85\t            move.promoted_to = pgn_piece_from_char(str[++cursor]);\n86\t            assert(move.promoted_to != PGN_PIECE_UNKNOWN);\n87\t            assert(str[++cursor] == ')');\n88\t            cursor++;\n89\t            break;\n90\t        case '=':\n91\t        case '/':\n92\t            move.promoted_to = pgn_piece_from_char(str[++cursor]);\n93\t            assert(move.promoted_to != PGN_PIECE_UNKNOWN);\n94\t            cursor++;\n95\t            break;\n96\t        }\n97\t    }\n98\t\n99\t    assert(move.dest.file != 0);\n100\t    assert(move.dest.rank != 0);\n101\t\n102\tcheck:\n103\t    move.check = __pgn_check_from_string(str + cursor, &cursor);\n104\t    move.annotation = __pgn_annotation_from_string(str + cursor, &cursor);\n105\t\n106\t    bool skipped_whitespace_before_ep = pgn_cursor_skip_whitespace(str, &cursor);\n107\t\n108\t    /* could be en passant */\n109\t    if (str[cursor] == 'e' && str[cursor + 1] == '.') {\n110\