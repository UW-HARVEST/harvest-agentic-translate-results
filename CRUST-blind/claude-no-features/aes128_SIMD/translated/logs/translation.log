;\n            for j in 0..4 {\n                temp_bytes[j] = SBOX[temp_bytes[j] as usize];\n            }\n            temp = temp_bytes;\n        }\n\n        // Load w[4*(i-Nk) ..]\n        let mut w_i_nk = [0u8; 16];\n        let src = 4 * (i - NK);\n        for k in 0..16 {\n            let idx = src + k;\n            if idx < total_len {\n                w_i_nk[k] = w[idx];\n            }\n        }\n\n        // XOR\n        for k in 0..16 {\n            temp[k] ^= w_i_nk[k];\n        }\n\n        // Store 16 bytes at w[4*i ..]\n        let dst = 4 * i;\n        for k in 0..16 {\n            let idx = dst + k;\n            if idx < total_len {\n                w[idx] = temp[k];\n            }\n        }\n\n        i += 4;\n    }\n}\n","structuredPatch":[{"oldStart":54,"oldLines":21,"newStart":54,"newLines":16,"lines":["             shuffled[12..16].copy_from_slice(&temp[12..16]);","             temp = shuffled;"," ","-            // Persist the previous temp_bytes contents and overwrite from temp.","-            temp_bytes = temp;","             // SubWord on the first 4 bytes only (matches C inner loop).","             for j in 0..4 {","-                temp_bytes[j] = SBOX[temp_bytes[j] as usize];","+                temp[j] = SBOX[temp[j] as usize];","             }","-            temp_bytes[0] ^= RCON[i / NK];","-            temp = temp_bytes;","+            temp[0] ^= RCON[i / NK];","         } else if NK > 6 && i % NK == 4 {","             // Dead code for NK = 4 but kept for fidelity.","-            temp_bytes = temp;","             for j in 0..4 {","-                temp_bytes[j] = SBOX[temp_bytes[j] as usize];","+                temp[j] = SBOX[temp[j] as usize];","             }","-            temp = temp_bytes;","         }"," ","         // Load w[4*(i-Nk) ..]"]}],"userModified":false,"replaceAll":false}}
