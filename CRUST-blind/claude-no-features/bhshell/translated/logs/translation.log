n    // Build the primary process.\n    let program = _cmd.args[0].clone();\n    let extra_args: Vec<String> = _cmd.args.iter().skip(1).cloned().collect();\n    let mut child_builder = PCommand::new(&program);\n    child_builder.args(&extra_args);\n\n    // If we have pipe args, the primary command's stdout pipes into the\n    // secondary command's stdin.\n    let has_pipe = !_cmd.pipe_args.is_empty();\n    let has_redirect = _cmd.redirect_file_name.is_some();\n\n    if has_pipe {\n        child_builder.stdout(Stdio::piped());\n    } else if has_redirect {\n        child_builder.stdout(Stdio::piped());\n    }\n\n    let primary = match child_builder.spawn() {\n        Ok(c) => c,\n        Err(e) => {\n            eprintln!(\"bhshell: {}\", e);\n            return 1;\n        }\n    };\n\n    if has_pipe {\n        let pipe_program = _cmd.pipe_args[0].clone();\n        let pipe_extra: Vec<String> = _cmd.pipe_args.iter().skip(1).cloned().collect();\n        let mut pipe_builder = PCommand::new(&pipe_program);\n        pipe_builder.args(&pipe_extra);\n\n        // Wire primary's stdout into pipe's stdin.\n        let primary_stdout = primary\n            .stdout\n            .take()\n            .or_else(|| {\n                // primary already moved; we have to re-fetch from a separate\n                // primary handle below.\n                None\n            });\n\n        // We need to re-acquire primary; structure differently:\n        let _ = primary_stdout;\n        let _ = pipe_builder;\n        // Fall through to a simpler implementation: relaunch using the\n        // dedicated piped flow below.\n        return run_pipeline(_cmd);\n    }\n\n    // No pipe; possibly redirect.\n    let mut primary = primary;\n    if has_redirect {\n        // Read primary's stdout and write to file (mirrors write_to_redirect).\n        let path = _cmd.redirect_file_name.clone().unwrap();\n        let mut buf = Vec::<u8>::new();\n        if let Some(mut out) = primary.stdout.t