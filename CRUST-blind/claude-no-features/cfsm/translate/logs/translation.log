UAL_INT(state_A.enterCalls, 1);\n203\t    TEST_ASSERT_EQUAL_INT(state_A.leaveCalls, 1);\n204\t    TEST_ASSERT_EQUAL_INT(state_A.processCalls, 0);\n205\t    TEST_ASSERT_EQUAL_INT(state_A.eventCalls, 0);\n206\t\n207\t    TEST_ASSERT_EQUAL_INT(state_B.enterCalls, 1);\n208\t    TEST_ASSERT_EQUAL_INT(state_B.leaveCalls, 0);\n209\t    TEST_ASSERT_EQUAL_INT(state_B.processCalls, 0);\n210\t    TEST_ASSERT_EQUAL_INT(state_B.eventCalls, 0);\n211\t\n212\t    cfsm_transition(&fsmInstance, State_A_onEnter);\n213\t\n214\t    TEST_ASSERT_EQUAL_PTR(fsmInstance.onEvent, State_A_onEvent);\n215\t    TEST_ASSERT_EQUAL_PTR(fsmInstance.onProcess, State_A_onProcess);\n216\t    TEST_ASSERT_EQUAL_PTR(fsmInstance.onLeave, State_A_onLeave);\n217\t\n218\t    TEST_ASSERT_EQUAL_INT(state_A.enterCalls, 2);\n219\t    TEST_ASSERT_EQUAL_INT(state_A.leaveCalls, 1);\n220\t    TEST_ASSERT_EQUAL_INT(state_A.processCalls, 0);\n221\t    TEST_ASSERT_EQUAL_INT(state_A.eventCalls, 0);\n222\t\n223\t    TEST_ASSERT_EQUAL_INT(state_B.enterCalls, 1);\n224\t    TEST_ASSERT_EQUAL_INT(state_B.leaveCalls, 1);\n225\t    TEST_ASSERT_EQUAL_INT(state_B.processCalls, 0);\n226\t    TEST_ASSERT_EQUAL_INT(state_B.eventCalls, 0);\n227\t}\n228\t\n229\tint main(void)\n230\t{\n231\t    UNITY_BEGIN();\n232\t\n233\t    RUN_TEST(test_cfsm_init_is_safe_to_use);\n234\t    RUN_TEST(test_cfsm_init_should_clear_handler);\n235\t    RUN_TEST(test_cfsm_transition_should_set_enter_handler_only);\n236\t    RUN_TEST(test_cfs_transition_A_B_A);\n237\t\n238\t    return UNITY_END();\n239\t}\n240\t\n241\t/******************************************************************************\n242\t * Local functions\n243\t *****************************************************************************/\n244\tstatic void State_only_onEnter(cfsm_Ctx * fsm)\n245\t{\n246\t    (void)fsm;\n247\t}\n248\t\n249\tstatic void State_A_onEnter(cfsm_Ctx * fsm)\n250\t{\n251\t    fsm->onEvent = State_A_onEvent;\n252\t    fsm->onLeave = State_A_onLeave;\n253\t    fsm->onProcess = State_A_onProcess;\n254\t\n255\t    state_A.enterCalls++;\n256\t}\n257\t\n258\tstatic void State_A_onEvent(cfsm_Ctx * fsm, int eventId)\n259\t{\n260\t    (void)fsm;\n261\t    (void)eventId;\n262\t\n263\t    state_A.eventCalls++;\n264\t}\n265\t\n266\tstatic void State_A_onProcess(cfsm_Ctx * fsm)\n267\t{\n268\t    (void)fsm;\n269\t\n270\t    state_A.processCalls++;\n271\t}\n272\t\n273\tstatic void State_A_onLeave(cfsm_Ctx * fsm)\n274\t{\n275\t    (void)fsm;\n276\t\n277\t    state_A.leaveCalls++;\n278\t}\n279\t\n280\tstatic void State_B_onEnter(cfsm_Ctx * fsm)\n281\t{\n282\t    fsm->onEvent = State_B_onEvent;\n283\t    fsm->onLeave = State_B_onLeave;\n284\t    fsm->onProcess = State_B_onProcess;\n285\t    state_B.enterCalls++;\n286\t}\n287\t\n288\tstatic void State_B_onEvent(cfsm_Ctx * fsm, int eventId)\n289\t{\n290\t    (void)fsm;\n291\t    (void)eventId;\n292\t\n293\t    state_B.eventCalls++;\n294\t}\n295\t\n296\tstatic void State_B_onProcess(cfsm_Ctx * fsm)\n297\t{\n298\t    (void)fsm;\n299\t\n300\t    state_B.processCalls++;\n301\t}\n302\t\n303\tstatic void State_B_onLeave(cfsm_Ctx * fsm)\n304\t{\n305\t    (void)fsm;\n306\t\n307\t    state_B.leaveCalls++;\n308\t}\n309\t"}]},"parent_tool_use_id":null,"session_id":"1fad9e3c-cafb-442d-9025-c0dfce3dad31","uuid":"392fe9ab-61b2-4bf8-9c75-ecac1597c906","timestamp":"2026-06-06T03:27:37.528Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-OMdqhz/project/c_src/tests/test_c_fsm.c","content":"/* MIT License\n *\n * Copyright (C) 2024  Haju Schulz <haju@schulznorbert.de>\n *\n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished 