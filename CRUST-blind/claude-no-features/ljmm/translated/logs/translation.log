c/$PID/maps, the fields of each line are:\n198\t     *   - address range:\n199\t     *   - permission\n200\t     *   - offset    : The offset of the file being mmapped. If it's not file\n201\t     *                 mapping, this column must take value 0.\n202\t     *   - dev       :\n203\t     *   - inode     : inode of file being mmapped or empty otherwise\n204\t     *   - pathname  : path of the file being mmaped or empty otherwise\n205\t     *\n206\t     * e.g\n207\t     * ...\n208\t     * 00618000-00619000 rw-p 00018000 08:02 13505427    /usr/lib/thunderbird/thunderbird\n209\t     * 7f2b4b200000-7f2b4b300000 rw-p 00000000 00:00 0\n210\t     * 7f2b4b400000-7f2b4ca00000 rw-p 00000000 00:00 0\n211\t     * ...\n212\t     *\n213\t     *  We only care about the address-ranges.\n214\t     */\n215\t    ASSERT(buffer[buf_len-1] == '\\n');\n216\t    while (ofst < buf_len) {\n217\t        uintptr_t start_addr, end_addr;\n218\t\n219\t        /* step 1: get the lower-bound of the address range */\n220\t        int advance = parse_addr(ljmm.buffer + ofst, &start_addr);\n221\t        if (advance && (buffer[ofst + advance] == '-')) {\n222\t            ofst += advance + 1;\n223\t        } else {\n224\t            /* the buffer is not large enough to accommodate /proc/$PID/map */\n225\t            break;\n226\t        }\n227\t\n228\t        /* step 2: get the upper bound of the address range */\n229\t        advance = parse_addr(buffer + ofst , &end_addr);\n230\t        if (advance && buffer[ofst + advance] == ' ') {\n231\t            ofst += advance + 1;\n232\t            ASSERT(ofst < buf_len);\n233\t            /* skip the rest of the line. */\n234\t            while (buffer[ofst++] != '\\n') {}\n235\t        } else {\n236\t            /* we can move on with incomplete up-bound address */\n237\t            end_addr = upbound >= start_addr ? upbound : start_addr;\n238\t        }\n239\t\n240\t        end_addr = page_align_addr(end_addr);\n241\t\n242\t        /* step 3: get the u