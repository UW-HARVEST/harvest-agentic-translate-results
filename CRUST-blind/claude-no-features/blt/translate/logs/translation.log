 let start = cell.borrow().unwrap_or(now);\n        now.duration_since(start)\n    });\n    let secs = elapsed.as_secs();\n    let nanos = elapsed.subsec_nanos();\n    println!(\"{}: {}.{:09}s\", msg, secs, nanos);\n    BM_START.with(|cell| {\n        *cell.borrow_mut() = Some(Instant::now());\n    });\n}\n\n/// Reads keys and calls the provided callback with a slice of keys and an integer.\n/// The callback receives a slice of string slices (`&[&str]`) and an `i32`.\npub fn bm_read_keys<F>(mut cb: F)\nwhere\n    F: FnMut(&[&str], i32),\n{\n    let stdin = io::stdin();\n    let mut keys: Vec<String> = Vec::new();\n    for line in stdin.lock().lines() {\n        match line {\n            Ok(s) => keys.push(s),\n            Err(_) => break,\n        }\n    }\n\n    // Randomize the order using rand crate\n    use rand::seq::SliceRandom;\n    let mut rng = rand::rng();\n    // Mimic the C loop which only shuffles indices [2..m-1] effectively.\n    // The C code: for (int i = m-1; i>1; i--) { int j = random() % i; swap(key[i], key[j]); }\n    // We'll do the equivalent.\n    let m = keys.len();\n    if m > 2 {\n        for i in (2..m).rev() {\n            let j = (rand::random::<u32>() as usize) % i;\n            keys.swap(i, j);\n        }\n    }\n    let _ = &mut rng; // silence unused warning if not used\n\n    let refs: Vec<&str> = keys.iter().map(|s| s.as_str()).collect();\n    cb(&refs, m as i32);\n}\n","structuredPatch":[{"oldStart":43,"oldLines":12,"newStart":43,"newLines":9,"lines":["         }","     }"," ","-    // Randomize the order using rand crate","-    use rand::seq::SliceRandom;","-    let mut rng = rand::rng();","-    // Mimic the C loop which only shuffles indices [2..m-1] effectively.","-    // The C code: for (int i = m-1; i>1; i--) { int j = random() % i; swap(key[i], key[j]); }","-    // We'll do the equivalent.","+    // Randomize the order. Mirrors the C loop which only shuffles indices","+    // [2..m-1] effectively:","+    //   for (int i = m