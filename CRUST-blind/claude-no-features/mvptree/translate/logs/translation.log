2_t *data2 = (int32_t*)pointB->data;\n60\t    for (i = 0; i < pointA->datalen; i++){\n61\t\tdouble diff = (double)data1[i] - (double)data2[i];\n62\t\tsum = sum + abs(diff);\n63\t    }\n64\t    nbcalcs++;\n65\t    return (float)sum/(float)pointA->datalen;\n66\t}\n67\t\n68\tfloat point_l2_distance(MVPDP *pointA, MVPDP *pointB){\n69\t    /* L2 distance */\n70\t    if (!pointA || !pointB || pointA->datalen != pointB->datalen) return -1.0f;\n71\t    int i;\n72\t    double sum = 0.0;\n73\t    int32_t *data1 = (int32_t*)pointA->data;\n74\t    int32_t *data2 = (int32_t*)pointB->data;\n75\t    for (i=0;i<pointA->datalen;i++){\n76\t\tdouble diff =  (double)data1[i] - (double)data2[i];\n77\t\tsum = sum + pow(diff,2.0f) ;\n78\t    }\n79\t    nbcalcs++;\n80\t    float result = (float)(sqrt(sum)/(float)pointA->datalen);\n81\t    return result;\n82\t}\n83\t\n84\t\n85\tMVPDP* mvpdp_dup(MVPDP *dp){\n86\t    MVPDP *newpnt = dp_alloc(dp->type);\n87\t    if (!newpnt) return NULL;\n88\t    newpnt->datalen = dp->datalen;\n89\t    newpnt->data = malloc(dp->datalen*dp->type);\n90\t    memcpy(newpnt->data, dp->data, dp->datalen*dp->type);\n91\t    newpnt->id = strdup(dp->id);\n92\t    return newpnt;\n93\t}\n94\t\n95\tMVPDP* generate_point(const unsigned int dp_length){\n96\t    /* generate one datapoint with UINT32ARRAY type data of length dp_length */\n97\t    static unsigned long long uid = 0;\n98\t    char scratch[32];\n99\t\n100\t    MVPDP *newpnt = dp_alloc(UINT32ARRAY);\n101\t    if (newpnt == NULL) return NULL;\n102\t\n103\t    newpnt->datalen = dp_length;\n104\t    newpnt->data = malloc(dp_length*sizeof(int32_t));\n105\t    if (newpnt->data == NULL) {\n106\t\tfree (newpnt);\n107\t\treturn NULL;\n108\t    }\n109\t    int32_t *row = (int32_t*)newpnt->data;\n110\t\n111\t    int i;\n112\t    for (i=0;i<dp_length;i++){\n113\t\trow[i] = rand()%1024;\n114\t    }\n115\t    snprintf(scratch, 32, \"point%llu\", ++uid);\n116\t    newpnt->id = strdup(scratch);\n117\t    if (newpnt->id == NULL){\n118\t\tfree(newpnt);\n119\t\tfree(newpnt->data);\n120\t\treturn NULL;\n121\t    }\n122\t\n123\t    return newpnt;\n124\t}\n125\t\n126\t/* generate random data points for a tree */\n127\tMVPDP** generate_uniform_points(const unsigned int nbpoints, const unsigned int dp_length){\n128\t    /* generate nbpoints uniformly distributed points all of dp_length UINT32ARRA */\n129\t    MVPDP **pointlist = (MVPDP**)malloc(nbpoints*sizeof(MVPDP*));\n130\t    if (pointlist == NULL){\n131\t\treturn NULL;\n132\t    }\n133\t    unsigned int i;\n134\t    for (i=0;i < nbpoints;i++){\n135\t\tpointlist[i] = generate_point(dp_length);\n136\t\tif (!pointlist[i]) return NULL;\n137\t    }\n138\t\n139\t    return pointlist;\n140\t}\n141\t\n142\tMVPDP** generate_cluster(unsigned int nbpoints, unsigned int dplength, int var, CmpFunc dist){\n143\t    /* generate nbpoints cluster with data of type UINT32ARRAY and dplength long */\n144\t\n145\t    MVPDP **points = (MVPDP**)malloc(nbpoints*sizeof(MVPDP*));\n146\t    if (!points)return NULL;\n147\t\n148\t    /* generate first point around which all other points shall cluster */\n149\t    points[0] = generate_point(dplength);\n150\t    if (points[0] == NULL){\n151\t\tfree(points);\n152\t\treturn NULL;\n153\t    }\n154\t\n155\t    /* generate the other points */\n156\t    int i, j;\n157\t    int32_t *orig_row = (int32_t*)points[0]->data;\n158\t    float max_distance = 0.0f, d;\n159\t    for (i=1;i<nbpoints;i++){\n160\t\tpoints[i] = generate_point(dplength);\n161\t\tif (!points[i]){\n162\t\t    free(points);\n163\t\t    return NULL;\n164\t\t}\n165\t\t\n166\t\tint32_t *new_row  = (int32_t*)points[i]->data;\n167\t\tfor (j=0;j<dplength;j++){\n168\t\t    int diff = next_poisson_int(var);\n169\t\t    float toss = (float)rand()/((float)RAND_MAX-1);\n170\t\t    new_row[j] = (toss > 0.5) ? orig_row[j] + diff : orig_row[j] - diff;\n171\t\t}\n172\t\n173\t\td = dist(points[0], points[i]);\n174\t\tif (d > max_distance) {\n175\t\t    max_distance = d;\n176\t\t}\n177\t    }\n178\t\n179\t    return points;\n180\t}\n181\t\n182\tint main(int argc, char **argv){\n183\t    if (argc < 3){\n184\t\tfprintf(stdout,\"not enough input args\\n\");\n185\t\tfprintf(stdout,\"prog <nbpoints> <radius>\\n\");\n186\t\treturn 0;\n187\t    }\n188\t\n189\t    const unsigned int nbpoints = atoi(argv[1]);\n190\t    const float radius = atof(argv[2]);\n191\t    const unsigned int nbcluster1 = nbpoints/10;\n192\t    const unsigned int knearest = nbpoints/2;\n193\t    const unsigned int dplength = 10;\n194\t    const int var = 10;\n195\t    const char *testfile = \"testfile.mvp\";\n196\t    CmpFunc distance_func = point_l2_distance;\n197\t\n198\t    srand(98293928);\n199\t\n200\t    /* generate points */\n201\t    MVPDP  **pointlist = generate_uniform_points(nbpoints, dplength);\n202\t    assert(pointlist);\n203\t\n204\t\n205\t    MVPDP **cluster1 = generate_cluster(nbcluster1, dplength, var, distance_func);\n206\t    assert(cluster1);\n207\t\n208\t\n209\t    MVPTree *tree = mvptree_alloc(NULL, distance_func,  MVP_BRANCHFACTOR, MVP_PATHLENGTH, MVP_LEAFCAP);\n210\t    assert(tree);\n211\t\n212\t    printf(\"Add %d points to tree.\\n\", nbpoints);\n213\t\n214\t    /* add points to tree */\n215\t    MVPError err = mvptree_add(tree, pointlist, nbpoints);\n216\t    assert(err == MVP_SUCCESS);\n217\t\n218\t    printf(\"Add cluster of %d points to tree.\\n\", nbcluster1);\n219\t\n220\t    /* add cluster to tree */\n221\t    err = mvptree_add(tree, cluster1, nbcluster1);\n222\t    assert(err == MVP_SUCCESS);\n223\t \n224\t\n225\t    /* save the cluster center for later retrieval */\n226\t    MVPDP *cluster_center = mvpdp_dup(cluster1[0]);\n227\t\n228\t    /* free the list of points but not the points themselves */\n229\t    /* the tree takes ownership of the points  */\n230\t    free(pointlist);\n231\t    free(cluster1);\n232\t\n233\t\n234\t    printf(\"Write the tree to file, %s.\\n\", testfile);\n235\t\n236\t    /* write the tree out */\n237\t    err = mv