nt = 0usize;\n            loop {\n                let son1 = 2 * parent + 1;\n                let son2 = 2 * parent + 2;\n                let son = if son1 < len {\n                    if son2 < len {\n                        if (self.comparator)(&self.data[son1], &self.data[son2]) {\n                            son1\n                        } else {\n                            son2\n                        }\n                    } else {\n                        son1\n                    }\n                } else {\n                    break;\n                };\n                if (self.comparator)(&self.data[son], &self.data[parent]) {\n                    self.data.swap(parent, son);\n                }\n                parent = son;\n            }\n        }\n        min\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1134,"cache_read_input_tokens":34163,"cache_creation":{"ephemeral_5m_input_tokens":1134,"ephemeral_1h_input_tokens":0},"output_tokens":46,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ae72d091-0d2e-46bb-98ab-593c7e3878d1","uuid":"87849276-f09c-4912-8d0b-2ae8a507fbba"}
