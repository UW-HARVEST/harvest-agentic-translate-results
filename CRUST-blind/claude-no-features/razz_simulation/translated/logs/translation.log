assert (HEART_K < CLUB_K);\n101\t  assert (ACE < R3);\n102\t\n103\t  /* Card */\n104\t  c = create_card (SPADE_ACE);\n105\t  assert (c != NULL);\n106\t  assert (get_card_suit_rank (c) == SPADE_ACE);\n107\t  assert (get_card_rank (c) == ACE);\n108\t  assert (get_card_suit (c) == SPADE);\n109\t  destroy_card (&c);\n110\t  assert (c == NULL);\n111\t\n112\t  assert (c == NULL);\n113\t  destroy_card (&c);\n114\t  assert (c == NULL);\n115\t\n116\t  c = create_card (CARD_COUNT);\n117\t  assert (c == NULL);\n118\t\n119\t  c = create_card (CLUB_8);\n120\t  assert (c != NULL);\n121\t  assert (get_card_suit_rank (c) == CLUB_8);\n122\t  assert (get_card_rank (c) == R8);\n123\t  assert (get_card_suit (c) == CLUB);\n124\t  destroy_card (&c);\n125\t  assert (c == NULL);\n126\t\n127\t  c = strtocard (\"S8\");\n128\t  assert (c != NULL);\n129\t  assert (get_card_suit_rank (c) == SPADE_8);\n130\t  assert (get_card_rank (c) == R8);\n131\t  assert (get_card_suit (c) == SPADE);\n132\t  destroy_card (&c);\n133\t  assert (c == NULL);\n134\t\n135\t  c = strtocard (\"dk\");\n136\t  assert (c != NULL);\n137\t  assert (get_card_suit_rank (c) == DIAMOND_K);\n138\t  assert (get_card_rank (c) == K);\n139\t  assert (get_card_suit (c) == DIAMOND);\n140\t  destroy_card (&c);\n141\t  assert (c == NULL);\n142\t\n143\t  c = strtocard (\"Ca\");\n144\t  assert (c != NULL);\n145\t  assert (get_card_suit_rank (c) == CLUB_ACE);\n146\t  assert (get_card_rank (c) == ACE);\n147\t  assert (get_card_suit (c) == CLUB);\n148\t  destroy_card (&c);\n149\t  assert (c == NULL);\n150\t\n151\t  c = strtocard (\"hJ\");\n152\t  assert (c != NULL);\n153\t  assert (get_card_suit_rank (c) == HEART_J);\n154\t  assert (get_card_rank (c) == J);\n155\t  assert (get_card_suit (c) == HEART);\n156\t  destroy_card (&c);\n157\t  assert (c == NULL);\n158\t\n159\t  c = strtocard (\"SQ\");\n160\t  assert (c != NULL);\n161\t  assert (get_card_suit_rank (c) == SPADE_Q);\n162\t  assert (get_card_rank (c) == Q);\n163\t  assert (get_card_suit (c) == SPADE);\n164\t  destroy_card (&c);\n165\t  assert (c == NULL);\n166\t\n167\t  c = strtocard (\"SS\");\n168\t  assert (c == NULL);\n169\t  c = strtocard (\"S0\");\n170\t  assert (c == NULL);\n171\t  c = strtocard (\"S1\");\n172\t  assert (c == NULL);\n173\t  c = strtocard (\"a2\");\n174\t  assert (c == NULL);\n175\t\n176\t  /* Rank */\n177\t  assert (strtorank (\"ace\") == ACE);\n178\t  assert (strtorank (\"8\") == R8);\n179\t  assert (strtorank (\"K\") == K);\n180\t  assert (strtorank (\"10\") == R10);\n181\t  assert (strtorank (\"1\") == INVALID_RANK);\n182\t\n183\t  /* Card to string */\n184\t  assert (strcmp (cardtostr (SPADE_8), \"S8\") == 0);\n185\t  assert (strcmp (cardtostr (CLUB_10), \"C10\") == 0);\n186\t  assert (strcmp (cardtostr (SPADE_ACE), \"SA\") == 0);\n187\t  assert (strcmp (cardtostr (CLUB_K), \"CK\") == 0);\n188\t  assert (cardtostr (CARD_COUNT) == NULL);\n189\t\n190\t  /* Rank to string */\n191\t  assert (strcmp (ranktostr (R8), \"8\") == 0);\n192\t  assert (strcmp (ranktostr (R10), \"10\") == 0);\n193\t  assert (strcmp (ranktostr (ACE), \"A\") == 0);\n194\t  assert (strcmp (ranktostr (K), \"K\") == 0);\n195\t  assert (ranktostr (INVALID_RANK) == NULL);\n196\t\n197\t  /* Deck */\n198\t  srand48 (3);\n199\t  d = create_shuffled_deck ();\n200\t  assert (d != NULL);\n201\t  assert (is_card_in_deck (HEART_K, d));\n202\t  strip_card_from_deck (HEART_K, d);\n203\t  assert (!is_card_in_deck (HEART_K, d));\n204\t  strip_card_from_deck (HEART_9, d);\n205\t  assert (!is_card_in_deck (HEART_9, d));\n206\t  for (i = 1; i <= 50; i++)\n207\t    {\n208\t      c = deal_from_deck (d);\n209\t      assert (c != NULL);\n210\t      assert (!is_card_in_deck (get_card_suit_rank (c), d));\n211\t    }\n212\t  c = deal_from_deck (d);\n213\t  assert (c == NULL);\n214\t  destroy_deck (&d);\n215\t  assert (d == NULL);\n216\t\n217\t  /* Hand */\n218\t  srand48 (3);\n219\t  d = create_shuffled_deck ();\n220\t  assert (d != NULL);\n221\t  h = create_hand (7, sort_card