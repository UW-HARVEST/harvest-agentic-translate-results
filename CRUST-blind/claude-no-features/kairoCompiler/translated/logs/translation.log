have finished  lexical analysis on the file\n604\t        break;\n605\t\n606\t    default:\n607\t        token = read_special_token();\n608\t        if (!token)\n609\t            compiler_error(lex_process->compiler, \"Unexpected token\\n\");\n610\t    }\n611\t\n612\t    return token;\n613\t}\n614\tint lex(struct lex_process *process)\n615\t{\n616\t    process->current_expression_count = 0;\n617\t    process->parentheses_buffer = NULL;\n618\t    lex_process = process;\n619\t    process->pos.filename = process->compiler->cfile.abs_path;\n620\t\n621\t    struct token *token = read_next_token();\n622\t    while (token)\n623\t    {\n624\t        vector_push(process->token_vec, token);\n625\t        token = read_next_token();\n626\t    }\n627\t    return LEXICAL_ANALYSIS_ALL_OK;\n628\t}\n629\t\n630\tchar lexer_string_buffer_next_char(struct lex_process* process)\n631\t{\n632\t    struct buffer* buf = lex_process_private(process);\n633\t    return buffer_read(buf);\n634\t}\n635\t\n636\tchar lexer_string_buffer_peek_char(struct lex_process* process)\n637\t{\n638\t    struct buffer* buf = lex_process_private(process);\n639\t    return buffer_peek(buf);\n640\t}\n641\t\n642\tvoid lexer_string_buffer_push_char(struct lex_process* process,char c)\n643\t{\n644\t    struct buffer* buf = lex_process_private(process);\n645\t    buffer_write(buf,c);\n646\t}\n647\t\n648\tstruct lex_process_functions lexer_string_buffer_functions = {\n649\t    .next_char = lexer_string_buffer_next_char,\n650\t    .peek_char = lexer_string_buffer_peek_char,\n651\t    .push_char = lexer_string_buffer_push_char\n652\t};\n653\t// build token for input string\n654\tstruct lex_process* tokens_build_for_string(struct compile_process* compiler,const char* str)\n655\t{\n656\t    struct buffer* buffer = buffer_create();\n657\t    buffer_printf(buffer,str);\n658\t    struct lex_process* lex_process = lex_process_create(compiler,&lexer_string_buffer_functions,buffer);\n659\t    if(!lex_process)\n660\t    {\n661\t