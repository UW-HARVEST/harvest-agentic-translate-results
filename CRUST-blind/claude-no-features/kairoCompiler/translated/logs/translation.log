struct vector *vec = vector_create_no_saves(esize);\n63\t    vec->saves = vector_create_no_saves(sizeof(struct vector));\n64\t    return vec;\n65\t}\n66\t\n67\tvoid vector_free(struct vector *vector)\n68\t{\n69\t    free(vector->data);\n70\t    free(vector);\n71\t}\n72\t\n73\tint vector_current_index(struct vector *vector)\n74\t{\n75\t    return vector->rindex;\n76\t}\n77\t\n78\tvoid vector_resize_for_index(struct vector *vector, int start_index, int total_elements)\n79\t{\n80\t    if (start_index + total_elements < vector->mindex)\n81\t    {\n82\t        // Nothing to resize\n83\t        return;\n84\t    }\n85\t\n86\t    vector->data = realloc(vector->data, ((start_index + total_elements + VECTOR_ELEMENT_INCREMENT) * vector->esize));\n87\t    assert(vector->data);\n88\t    vector->mindex = start_index + total_elements;\n89\t}\n90\t\n91\tvoid vector_resize_for(struct vector *vector, int total_elements)\n92\t{\n93\t    vector_resize_for_index(vector, vector->rindex, total_elements);\n94\t}\n95\t\n96\tvoid vector_resize(struct vector *vector)\n97\t{\n98\t    // Zero elements as we want to see if we have already overflowed the index\n99\t    vector_resize_for(vector, 0);\n100\t}\n101\t\n102\tvoid *vector_at(struct vector *vector, int index)\n103\t{\n104\t    return vector->data + (index * vector->esize);\n105\t}\n106\t\n107\tvoid vector_set_peek_pointer(struct vector *vector, int index)\n108\t{\n109\t    vector->pindex = index;\n110\t}\n111\t\n112\tvoid vector_set_peek_pointer_end(struct vector *vector)\n113\t{\n114\t    vector_set_peek_pointer(vector, vector->rindex - 1);\n115\t}\n116\t\n117\tvoid *vector_peek_at(struct vector *vector, int index)\n118\t{\n119\t    if (!vector_in_bounds_for_at(vector, index))\n120\t    {\n121\t        return NULL;\n122\t    }\n123\t\n124\t    void* ptr = vector_at(vector, index);\n125\t    return ptr;\n126\t}\n127\t\n128\tvoid *vector_peek_no_increment(struct vector *vector)\n129\t{\n130\t    if (!vector_in_bounds_for_at(vector, vector