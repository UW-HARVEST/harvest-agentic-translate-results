{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_cdepkmg6nfaglrmg5ont44cwodqxiqgq2c4ttkkrt244jwrmnwfa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016pVSh76td16XNsouptxjeh","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-POAQ8d/project/src/gfc.rs","content":"use std::f64::consts::SQRT_2;\n/// Constants for Speck encryption\nconst SPECK_ROUNDS: usize = 27;\nconst SPECK_KEY_LEN: usize = 4;\nfn ror(x: u32, r: u32) -> u32 {\n    (x >> r) | (x << (32 - r))\n}\nfn rol(x: u32, r: u32) -> u32 {\n    (x << r) | (x >> (32 - r))\n}\nfn round(x: &mut u32, y: &mut u32, k: u32) {\n    *x = ror(*x, 8);\n    *x = x.wrapping_add(*y);\n    *x ^= k;\n    *y = rol(*y, 3);\n    *y ^= *x;\n}\n#[derive(Debug)]\npub struct GFC {\n    m: u64,       // Range\n    r: u64,       // Number of Feistel rounds\n    a: u64,\n    b: u64,\n    speck_exp: Vec<u32>,\n}\nimpl GFC {\n    /// Initialize the GFC structure\n    pub fn new(range: u64, rounds: u64, seed: u64) -> Self {\n        // Compute a = b = ceil(sqrt(range))\n        let tmp = (range as f64).sqrt().ceil();\n        let a = tmp as u64;\n        let b = tmp as u64;\n\n        // Precompute Speck round keys: r * SPECK_ROUNDS u32s\n        let total = (rounds as usize).checked_mul(SPECK_ROUNDS).unwrap_or(0);\n        let mut speck_exp = vec![0u32; total];\n        for i in 0..rounds {\n            // C code: const uint64_t key[2] = {seed, i};\n            // Cast to uint32_t*: on little endian -> [seed_lo, seed_hi, i_lo, i_hi]\n            let key: [u32; SPECK_KEY_LEN] = [\n                (seed & 0xFFFF_FFFF) as u32,\n                (seed >> 32) as u32,\n                (i & 0xFFFF_FFFF) as u32,\n                (i >> 32) as u32,\n            ];\n            let start = (i as usize) * SPECK_ROUNDS;\n            let end = start + SPECK_ROUNDS;\n            speck_expand(&key, &mut speck_exp[start..end]);\n        }\n\n        GFC {\n            m: range,\n            r: rounds,\n            a,\n            b,\n            speck_exp,\n        }\n    }\n    /// Encrypt using the Feistel cipher\n    pub fn encrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe(m);\n        while c >= self.m {\n            c = self.fe(c);\n        }\n        c\n    }\n    /// Decrypt using the Feistel cipher\n    pub fn decrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe_inv(m);\n        while c >= self.m {\n            c = self.fe_inv(c);\n        }\n        c\n    }\n    /// Function F for Feistel cipher using Speck encryption\n    fn f(&self, j: u64, r: u64) -> u64 {\n        // Treat R as two u32 (little endian)\n        let pt: [u32; 2] = [(r & 0xFFFF_FFFF) as u32, (r >> 32) as u32];\n        let mut ct: [u32; 2] = [0, 0];\n        let start = ((j - 1) as usize) * SPECK_ROUNDS;\n        let end = start + SPECK_ROUNDS;\n        let key = &self.speck_exp[start..end];\n        speck_encrypt(&pt, &mut ct, key);\n        (ct[0] as u64) | ((ct[1] as u64) << 32)\n    }\n    /// Function fe[r, a, b] for encryption\n    fn fe(&self, m: u64) -> u64 {\n        let mut l = m % self.a;\n        let mut r = m / self.a;\n\n        for j in 1..=self.r {\n            let tmp = if j & 1 == 1 {\n                (l + self.f(j, r)) % self.a\n            } else {\n                (l + self.f(j, r)) % self.b\n            };\n            l = r;\n            r = tmp;\n        }\n\n        if self.r & 1 == 1 {\n            self.a * l + r\n        } else {\n            self.a * r + l\n        }\n    }\n    /// Function fe^-1[r, a, b] for decryption\n    fn fe_inv(&self, m: u64) -> u64 {\n        let (mut l, mut r);\n        if self.r & 1 == 1 {\n            r = m % self.a;\n            l = m / self.a;\n        } else {\n            l = m % self.a;\n            r = m / self.a;\n        }\n\n        let mut j = self.r;\n        while j >= 1 {\n            let tmp = if j & 1 == 1 {\n                (r + self.a - (self.f(j, l) % self.a)) % self.a\n            } else {\n                (r + self.b - (self.f(j, l) % self.b)) % self.b\n            };\n            r = l;\n            l = tmp;\n            j -= 1;\n        }\n\n        self.a * r + l\n    }\n}\n/// Speck key expansion\nfn speck_expand(key: &[u32; SPECK_KEY_LEN], round_keys: &mut [u32]) {\n    let mut b = key[0];\n    let mut a = [0u32; SPECK_KEY_LEN - 1];\n    for i in 0..(SPECK_KEY_LEN - 1) {\n        a[i] = key[i + 1];\n    }\n    round_keys[0] = b;\n    for i in 0..(SPECK_ROUNDS - 1) {\n        let idx = i % (SPECK_KEY_LEN - 1);\n        let mut x = a[idx];\n        round(&mut x, &mut b, i as u32);\n        a[idx] = x;\n        round_keys[i + 1] = b;\n    }\n}\n/// Speck encryption function\nfn speck_encrypt(pt: &[u32; 2], ct: &mut [u32; 2], key: &[u32]) {\n    ct[0] = pt[0];\n    ct[1] = pt[1];\n    for i in 0..SPECK_ROUNDS {\n        // R(ct[1], ct[0], K[i]) - mutates both ct[1] and ct[0]\n        let (left, right) = ct.split_at_mut(1);\n        round(&mut right[0], &mut left[0], key[i]);\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":884,"cache_read_input_tokens":20917,"cache_creation":{"ephemeral_5m_input_tokens":884,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"eb46edcb-f054-4056-bca2-c6c23cb3dfc3","uuid":"9c5256f0-cfb1-471f-85bd-94419cf7b345"}
