2) -> Matrix {\n    mx::orth_proj_2d_impl(m, axis)\n}\npub fn orth_proj_3d(m: &Matrix, axis: i32) -> Matrix {\n    mx::orth_proj_3d_impl(m, axis)\n}\npub fn rotate_2d(m: &Matrix, theta: f64) -> Matrix {\n    assert!(is_square_matrix(m) && m.cols == 2);\n    let mut n = zero_matrix(2, 2);\n    set_matrix_element(&mut n, 0, 0, theta.cos());\n    set_matrix_element(&mut n, 0, 1, -theta.sin());\n    set_matrix_element(&mut n, 1, 0, theta.sin());\n    set_matrix_element(&mut n, 1, 1, theta.cos());\n    multiply_matrices(m, &n)\n}\npub fn scale_n_space(m: &Matrix, k: f64) -> Matrix {\n    mx::scale_n_space_impl(m, k)\n}\npub fn shear_2d(m: &Matrix, k: f64, axis: i32) -> Matrix {\n    mx::shear_2d_impl(m, k, axis)\n}\n/// Returns the determinant of a matrix.\npub fn determinant(m: &Matrix) -> f64 {\n    mx::determinant_impl(m)\n}\n/// Performs LU decomposition. Returns (L, U, P, swaps).\npub fn lu_decomposition(m: &Matrix) -> (Matrix, Matrix, Matrix, i32) {\n    mx::lu_decomposition_impl(m)\n}\n/// Returns the submatrix of m excluding row i and column j.\npub fn sub_matrix(m: &Matrix, i: usize, j: usize) -> Matrix {\n    mx::sub_matrix_impl(m, i, j)\n}\n/// Returns the minor of m at (i,j).\npub fn element_minor(m: &Matrix, i: usize, j: usize) -> f64 {\n    mx::element_minor_impl(m, i, j)\n}\n/// Returns the matrix of minors of m.\npub fn matrix_minor(m: &Matrix) -> Matrix {\n    mx::matrix_minor_impl(m)\n}\n/// Returns the cofactor of element (i,j) in m.\npub fn element_cofactor(m: &Matrix, i: usize, j: usize) -> f64 {\n    mx::element_cofactor_impl(m, i, j)\n}\n/// Returns the matrix of cofactors of m.\npub fn matrix_cofactor(m: &Matrix) -> Matrix {\n    mx::matrix_cofactor_impl(m)\n}\n/// Returns a sign matrix of the given dimensions.\npub fn sign_matrix(rows: usize, cols: usize) -> Matrix {\n    mx::sign_matrix_impl(rows, cols)\n}\n/// Returns the adjugate matrix of m.\npub fn adjugate_matrix(m: &Matrix) -> Matrix {\n    mx::adjugate_matrix_impl(m)\n}\n/// Returns the inverse of m.\npub fn inverse_matrix(m: &Matrix) -> Matrix {\n    mx::inverse_matrix_impl(m)\n}\n/// Returns the pivot matrix of m along with the number of swaps.\npub fn pivot_matrix(m: &Matrix) -> (Matrix, i32) {\n    mx::pivot_matrix_impl(m)\n}\n","structuredPatch":[{"oldStart":1,"oldLines":3,"newStart":1,"newLines":6,"lines":["+use crate::matrix as mx;","+use crate::vector as vx;","+"," #[derive(Debug, Clone, PartialEq)]"," pub struct Matrix {","     pub rows: usize,"]},{"oldStart":11,"oldLines":282,"newStart":14,"newLines":294,"lines":[" }"," // --- Helper assertion functions ---"," pub fn assert_matrix(m: &Matrix) -> bool {","-    unimplemented!()","+    mx::assert_matrix_impl(m)"," }"," pub fn assert_vector(v: &Vector) -> bool {","-    unimplemented!()","+    vx::assert_vector_impl(v)"," }"," // --- Creation functions ---"," pub fn new_matrix(d: &[f64], rows: usize, cols: usize) -> Matrix {","-    unimplemented!()","+    mx::new_matrix_impl(d, rows, cols)"," }"," pub fn new_vector(d: &[f64], cols: usize) -> Vector {","-    unimplemented!()","+    vx::new_vector_impl(d, cols)"," }"," pub fn null_matrix(rows: usize, cols: usize) -> Matrix {","-    unimplemented!()","+    mx::null_matrix_impl(rows, cols)"," }"," pub fn null_vector(cols: usize) -> Vector {","-    unimplemented!()","+    vx::null_vector_impl(cols)"," }"," pub fn zero_matrix(rows: usize, cols: usize) -> Matrix {","-    unimplemented!()","+    mx::zero_matrix_impl(rows, cols)"," }"," pub fn zero_vector(cols: usize) -> Vector {","-    unimplemented!()","+    vx::zero_vector_impl(cols)"," }"," // --- Fill functions ---"," pub fn fill_matrix(m: &mut Matrix, n: f64) {","-    unimplemented!()","+    mx::fill_matrix_impl(m, n)"," }"," pub fn fill_vector(v: &mut Vector, n: f64) {","-    unimplemented!()","+    vx::fill_vector_impl(v, n)"," }"," /// Returns an identity matrix of size n."," pub fn identity_matrix(n: usize) -> Matrix {","-    unimplemented!()","+    mx::identity_matrix_impl(n)"," }"," /// “Rel