{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01XeoD7nhri7ubAVVnrSFtva","type":"tool_result","content":"1\t#include <math.h>\n2\t#include <stdio.h>\n3\t#include \"linear-algebra.h\"\n4\t\n5\tvoid testCreate();\n6\tvoid testCopy();\n7\tvoid testFlatten();\n8\tvoid testElem();\n9\tvoid testRowVector();\n10\tvoid testColVector();\n11\tvoid testMainDiagonal();\n12\tvoid testAntiDiagonal();\n13\t\n14\tvoid testIsEqual();\n15\tvoid testIsZeroMatrix();\n16\tvoid testIsIdentityMatrix();\n17\tvoid testIsSquareMatrix();\n18\tvoid testIsDiagonal();\n19\tvoid testIsTriangular();\n20\tvoid testIsSymmetric();\n21\t\n22\tvoid testTranspose();\n23\tvoid testTrace();\n24\tvoid testAddMatrices();\n25\tvoid testMultiplyMatrices();\n26\tvoid testScaleMatrix();\n27\tvoid testSubMatrix();\n28\tvoid testDeterminant();\n29\tvoid testInverse();\n30\t\n31\tvoid testVectorOperations();\n32\t\n33\t\n34\tint main(){\n35\t    testCreate();\n36\t    testCopy();\n37\t    testFlatten();\n38\t    testElem();\n39\t    testRowVector();\n40\t    testColVector();\n41\t    testMainDiagonal();\n42\t    testAntiDiagonal();\n43\t\n44\t    testIsEqual();\n45\t    testIsZeroMatrix();\n46\t    testIsIdentityMatrix();\n47\t    testIsSquareMatrix();\n48\t    testIsDiagonal();\n49\t    testIsTriangular();\n50\t    testIsSymmetric();\n51\t\n52\t    testTranspose();\n53\t    testTrace();\n54\t    testAddMatrices();\n55\t    testMultiplyMatrices();\n56\t    testScaleMatrix();\n57\t    testSubMatrix();\n58\t    testDeterminant();\n59\t    testInverse();\n60\t\n61\t    testVectorOperations();\n62\t\n63\t    return 0;\n64\t}\n65\t\n66\tvoid testCreate(){\n67\t    printf(\"\\nTest create matrix and vector from array...\\n\");\n68\t    double data[4] = {1, 2, 3, 4};\n69\t    matrix* m = newMatrix(data, 2, 2);\n70\t    assert(\n71\t      getMatrixElement(m,0,0) == 1 && getMatrixElement(m,0,1) == 2 && \n72\t      getMatrixElement(m,1,0) == 3 && getMatrixElement(m,1,1) == 4 &&\n73\t      matrixSize(m) == 4 && matrixSizeBytes(m) == 32\n74\t    );\n75\t    deleteMatrix(m);\n76\t\n77\t    double data2[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };\n78\t    vector* v = newVector(data2, 8);\n79\t    assert(vectorSizeBytes(v) == 64);\n80\t    deleteVector(v);\n81\t}\n82\t\n83\tvoid testCopy(){\n84\t    printf(\"\\nTest matrix and vector copying...\\n\");\n85\t    matrix* m = zeroMatrix(2,2);\n86\t    setMatrixElement(m,0,1,5);\n87\t    matrix* n = copyMatrix(m);\n88\t    assert(\n89\t      getMatrixElement(m,0,0) == getMatrixElement(n,0,0) && \n90\t      getMatrixElement(m,0,1) == getMatrixElement(n,0,1) &&\n91\t      getMatrixElement(m,1,0) == getMatrixElement(n,1,0) && \n92\t      getMatrixElement(m,1,1) == getMatrixElement(n,1,1)\n93\t    );\n94\t    deleteMatrix(n);\n95\t    deleteMatrix(m);\n96\t\n97\t    vector* v = zeroVector(4);\n98\t    setVectorElement(v, 2, 2);\n99\t    vector* v2 = copyVector(v);\n100\t    assert(getVectorElement(v2, 2) == 2);\n101\t    deleteVector(v2);\n102\t    deleteVector(v);\n103\t}\n104\t\n105\tvoid testFlatten(){\n106\t    printf(\"\\nTest flatten...\\n\");\n107\t    double data[6] = { 1, 2, 3, 4, 5, 6 };\n108\t    matrix* m = newMatrix(data, 2, 3);\n109\t    vector* flat = flattenMatrix(m);\n110\t    assert(getVectorElement(flat,0) == 1 && getVectorElement(flat,5) == 6);\n111\t    deleteVector(flat);\n112\t    deleteMatrix(m);\n113\t}\n114\t\n115\tvoid testElem(){\n116\t    printf(\"\\nTest element accessor and mutator...\\n\");\n117\t    matrix* m = zeroMatrix(2,2);\n118\t    setMatrixElement(m,0,0,4);\n119\t    assert(\n120\t      getMatrixElement(m,0,0) == 4 && getMatrixElement(m,0,1) == 0 &&\n121\t      getMatrixElement(m,1,0) == 0 && getMatrixElement(m,1,1) == 0\n122\t    );\n123\t    deleteMatrix(m);\n124\t\n125\t    vector* v = zeroVector(2);\n126\t    setVectorElement(v,1,10);\n127\t    assert(getVectorElement(v,1) == 10);\n128\t    deleteVector(v);\n129\t}\n130\t\n131\tvoid testRowVector(){\n132\t    printf(\"\\nTest accessor/mutator for row vectors...\\n\");\n133\t    matrix* m = zeroMatrix(3,2);\n134\t    vector* row = getRowVector(m,1);\n135\t    setVectorElement(row,0,123);\n136\t    assert(getVectorElement(row,0) == 123 && getVectorElement(row,1) == 0);\n137\t    double data[2] = {1, 4};\n138\t    vector* v = newVector(data,2);\n139\t    setRowVector(m, 1, v);\n140\t    assert(\n141\t      getMatrixElement(m,0,0) == 0 &&\n142\t      getMatrixElement(m,0,1) == 0 &&\n143\t      getMatrixElement(m,1,0) == 1 &&\n144\t      getMatrixElement(m,1,1) == 4\n145\t    );\n146\t\n147\t    deleteVector(v);\n148\t    deleteVector(row);\n149\t    deleteMatrix(m);\n150\t}\n151\t\n152\tvoid testColVector(){\n153\t    printf(\"\\nTest accessor/mutator for column vectors...\\n\");\n154\t    matrix* m = zeroMatrix(3, 2);\n155\t    vector* col = getColVector(m, 0);\n156\t    setVectorElement(col,0,5);\n157\t    setVectorElement(col,1,10);\n158\t    setVectorElement(col,2,15);\n159\t    assert(getVectorElement(col,0) == 5 && getVectorElement(col,1) == 10);\n160\t    double data[2] = {10, 3};\n161\t    vector* v = newVector(data,2);\n162\t    setColVector(m, 0, v);\n163\t\n164\t    deleteVector(v);\n165\t    deleteVector(col);\n166\t    deleteMatrix(m);\n167\t}\n168\t\n169\tvoid testMainDiagonal(){\n170\t    printf(\"\\nTest accessor/mutator for main diagonal...\\n\");\n171\t    matrix* m = zeroMatrix(2,2);\n172\t    setMatrixElement(m,0,0,34);\n173\t    setMatrixElement(m,1,1,56);\n174\t    vector* v = getMainDiagonal(m);\n175\t    assert(getVectorElement(v,0) == 34 && getVectorElement(v,1) == 56);\n176\t    deleteVector(v);\n177\t    deleteMatrix(m);\n178\t\n179\t    matrix* n = zeroMatrix(2,2);\n180\t    vector* w = zeroVector(2);\n181\t    setVectorElement(w,0,100);\n182\t    setVectorElement(w,1,4);\n183\t    setMainDiagonal(n,w);\n184\t    assert(getMatrixElement(n,0,0) == 100 && getMatrixElement(n,1,1) == 4);\n185\t    deleteMatrix(n);\n186\t    deleteVector(w);\n187\t}\n188\t\n189\tvoid testAntiDiagonal(){\n190\t    printf(\"\\nTest accessor/mutator for anti diagonal...\\n\");\n191\t    matrix* m = zeroMatrix(2,2);\n192\t    setMatrixElement(m,0,1,100);\n193\t    setMatrixElement(m,1,0,250);\n194\t    vector* d = getAntiDiagonal(m);\n195\t    assert(getVectorElement(d,0) == 250 && getVectorElement(d,1) == 100);\n196\t    deleteVector(d);\n197\t    deleteMatrix(m);\n198\t\n199\t    matrix* n = zeroMatrix(2,2);\n200\t    vector* e = zeroVector(2);\n201\t    setVectorElement(e,0,9);\n202\t    setVectorElement(e,1,8);\n203\t    setAntiDiagonal(n,e);\n204\t    assert(getMatrixElement(n,1,0) == 9 && getMatrixElement(n,0,1) == 8);\n205\t    deleteMatrix(n);\n206\t    deleteVector(e);\n207\t}\n208\t\n209\tvoid testIsEqual(){\n210\t    printf(\"\\nTest vector and matrix equal...\\n\");\n211\t    matrix* m = zeroMatrix(2, 2);\n212\t    matrix* n = zeroMatrix(2, 2);\n213\t    matrix* o = zeroMatrix(3, 3);\n214\t    assert(!isMatrixEqual(m,o));\n215\t    assert(isMatrixEqual(m,n));\n216\t    setMatrixElement(m,0,0,1);\n217\t    assert(!isMatrixEqual(m,n));\n218\t    deleteMatrix(o);\n219\t    deleteMatrix(n);\n220\t    deleteMatrix(m);\n221\t\n222\t    vector* v = zeroVector(3);\n223\t    vector* w = zeroVector(3);\n224\t    assert(isVectorEqual(v, w));\n225\t    deleteVector(w);\n226\t    deleteVector(v);\n227\t}\n228\t\n229\tvoid testIsZeroMatrix(){\n230\t    printf(\"\\nTest isZeroMatrix...\\n\");\n231\t    matrix* m = zeroMatrix(1,3);\n232\t    matrix* n = zeroMatrix(2,2);\n233\t    setMatrixElement(n,0,0,1);\n234\t    assert(isZeroMatrix(m));\n235\t    assert(!isZeroMatrix(n));\n236\t    deleteMatrix(n);\n237\t    deleteMatrix(m);\n238\t}\n239\t\n240\tvoid testIsIdentityMatrix(){\n241\t    printf(\"\\nTest isIdentityMatrix...\\n\");\n242\t\n243\t    matrix* m = zeroMatrix(2,2);\n244\t    setMatrixElement(m,0,0,1);\n245\t    setMatrixElement(m,1,1,1);\n246\t    assert(isIdentityMatrix(m));\n247\t    deleteMatrix(m);\n248\t\n249\t    matrix* n = zeroMatrix(1,3);\n250\t    assert(!isIdentityMatrix(n));\n251\t    deleteMatrix(n);\n252\t\n253\t    matrix* o = zeroMatrix(3,3);\n254\t    setMatrixElement(o,0,0,1);\n255\t    setMatrixElement(o,1,1,1);\n256\t    setMatrixElement(o,2,2,1);\n257\t    setMatrixElement(o,1,2,-4);\n258\t    assert(!isIdentityMatrix(o));\n259\t    deleteMatrix(o);\n260\t    \n261\t    matrix* p = identityMatrix(2);\n262\t    assert(isIdentityMatrix(p));\n263\t    deleteMatrix(p);\n264\t}\n265\t\n266\tvoid testIsSquareMatrix(){\n267\t    printf(\"\\nTest isSquareMatrix...\\n\");\n268\t    matrix* m = zeroMatrix(2, 2);\n269\t    assert(isSquareMatrix(m));\n270\t    deleteMatrix(m);\n271\t\n272\t    matrix* n = zeroMatrix(1, 3);\n273\t    assert(!isSquareMatrix(n));\n274\t    deleteMatrix(n);\n275\t}\n276\t\n277\tvoid testIsDiagonal(){\n278\t    printf(\"\\nTest isDiagonal...\\n\");\n279\t    double data1[9] = { 1, 2, 3,  0, 5, 6,  0, 0, 9 };\n280\t    matrix* m1 = newMatrix(data1, 3, 3);\n281\t    assert(!isDiagonalMatrix(m1));\n282\t    deleteMatrix(m1);\n283\t\n284\t    double data2[9] = { 1, 0, 0, 0, 2, 0, 0, 0, 3 };\n285\t    matrix* m2 = newMatrix(data2, 3, 3);\n286\t    assert(isDiagonalMatrix(m2));\n287\t    deleteMatrix(m2);\n288\t}\n289\t\n290\tvoid testIsTriangular(){\n291\t    printf(\"\\nTest isTriangular, isLoTriMatrix, isUpTriMatrix...\\n\");\n292\t    \n293\t    double data1[9] = { 1, 2, 3,  0, 5, 6,  0, 0, 9 };\n294\t    matrix* m1 = newMatrix(data1, 3, 3);\n295\t    assert(isUpTriMatrix(m1));\n296\t    deleteMatrix(m1);\n297\t\n298\t    double data2[9] = { 1, 0, 0,  4, 5, 0,  7, 8, 9 };\n299\t    matrix* m2 = newMatrix(data2, 3, 3);\n300\t    assert(isLoTriMatrix(m2));\n301\t    deleteMatrix(m2);\n302\t\n303\t    double data3[9] = { 1, 0, 0,  4, 5, 0,  7, 8, 9 };\n304\t    matrix* m3 = newMatrix(data3, 3, 3);\n305\t    assert(isTriangularMatrix(m3));\n306\t    deleteMatrix(m3);\n307\t}\n308\t\n309\tvoid testIsSymmetric(){\n310\t    printf(\"\\nTest isSymmetric...\\n\");\n311\t    double data[6] = { 1, 2, 3, 4, 5, 6 };\n312\t    matrix* m = newMatrix(data, 2, 3);\n313\t    assert(!isMatrixSymmetric(m));\n314\t    deleteMatrix(m);\n315\t    matrix* n = zeroMatrix(2,2);\n316\t    assert(isMatrixSymmetric(n));\n317\t    deleteMatrix(n);\n318\t}\n319\t\n320\tvoid testTranspose(){\n321\t    printf(\"\\nTest transposeMatrix...\\n\");\n322\t    double data[6] = { 1, 2, 3, 4, 5, 6 };\n323\t    matrix* m = newMatrix(data, 2, 3);\n324\t    matrix* t = transposeMatrix(m);\n325\t    assert( \n326\t      getMatrixElement(t,0,0) == 1 && getMatrixElement(t,1,0) == 2 && getMatrixElement(t,2,0) == 3 &&\n327\t      getMatrixElement(t,0,1) == 4 && getMatrixElement(t,1,1) == 5 && getMatrixElement(t,2,1) == 6\n328\t    );\n329\t    deleteMatrix(t);\n330\t    deleteMatrix(m);\n331\t}\n332\t\n333\tvoid testTrace(){\n334\t    printf(\"\\nTest trace...\\n\");\n335\t    double data[9] = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };\n336\t    matrix* m = newMatrix(data, 3, 3);\n337\t    assert(traceMatrix(m) == 15);\n338\t    deleteMatrix(m);\n339\t}\n340\t\n341\tvoid testAddMatrices(){\n342\t    printf(\"\\nTest adding matrices...\\n\");\n343\t    double data1[4] = { 4, 6, 3, 8 };\n344\t    double data2[4] = { 6, 4, 7, 2 };\n345\t    matrix* m1 = newMatrix(data1, 2, 2);\n346\t    matrix* m2 = newMatrix(data2, 2, 2);\n347\t    matrix* sum = addMatrices(m1, m2);\n348\t    assert(\n349\t      getMatrixElement(sum,0,0) == 10 && getMatrixElement(sum,0,1) == 10 &&\n350\t      getMatrixElement(sum,1,0) == 10 && getMatrixElement(sum,1,1) == 10\n351\t    );\n352\t    deleteMatrix(sum);\n353\t    deleteMatrix(m2);\n354\t    deleteMatrix(m1);\n355\t}\n356\t\n357\tvoid testMultiplyMatrices(){\n358\t    printf(\"\\nTest multiplying matrices...\\n\");\n359\t    double data1[4] = { 1, 2, 3, 4 };\n360\t    double data2[4] = { 1, 1, 1, 1 };\n361\t    matrix* m1 = newMatrix(data1, 2, 2);\n362\t    matrix* m2 = newMatrix(data2, 2, 2);\n363\t    matrix* prod = multiplyMatrices(m1, m2);\n364\t    assert(\n365\t      getMatrixElement(prod,0,0) == 3 && getMatrixElement(prod,0,1) == 3 &&\n366\t      getMatrixElement(prod,1,0) == 7 && getMatrixElement(prod,1,1) == 7\n367\t    );\n368\t    deleteMatrix(prod);\n369\t    deleteMatrix(m2);\n370\t    deleteMatrix(m1);\n371\t}\n372\t\n373\tvoid testScaleMatrix(){\n374\t    printf(\"\\nTest scaling matrices...\\n\");\n375\t    double data[6] = { 1, 2, 3, 4, 5, 6 };\n376\t    matrix* m = newMatrix(data, 3, 2);\n377\t    matrix* scaled = scaleMatrix(m, 10);\n378\t    assert(\n379\t      getMatrixElement(scaled,0,0) == 10 && getMatrixElement(scaled,0,1) == 20 &&\n380\t      getMatrixElement(scaled,1,0) == 30 && getMatrixElement(scaled,1,1) == 40 &&\n381\t      getMatrixElement(scaled,2,0) == 50 && getMatrixElement(scaled,2,1) == 60\n382\t    );\n383\t    deleteMatrix(scaled);\n384\t    deleteMatrix(m);\n385\t}\n386\t\n387\tvoid testSubMatrix(){\n388\t    printf(\"\\nTest sub matrix...\\n\");\n389\t    double data[9] = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };\n390\t    matrix* m = newMatrix(data, 3, 3);\n391\t    matrix* sub = subMatrix(m, 2, 2);\n392\t    assert(\n393\t      getMatrixElement(sub,0,0) == 1 && getMatrixElement(sub,0,1) == 2 &&\n394\t      getMatrixElement(sub,1,0) == 4 && getMatrixElement(sub,1,1) == 5\n395\t    );\n396\t    deleteMatrix(sub);\n397\t    deleteMatrix(m);\n398\t}\n399\t\n400\tvoid testDeterminant(){\n401\t    printf(\"\\nTest determinant...\\n\");\n402\t    \n403\t    double data1[1] = { 10 };\n404\t    matrix* m1 = newMatrix(data1, 1, 1);\n405\t    assert(determinant(m1) == 10);\n406\t    deleteMatrix(m1);\n407\t\n408\t    double data2[4] = { 4, 6, 3, 8 };\n409\t    matrix* m2 = newMatrix(data2, 2, 2);\n410\t    assert(determinant(m2) == 14);\n411\t    deleteMatrix(m2);\n412\t\n413\t    double data3[9] = { 6, 1, 1, 4, -2, 5, 2, 8, 7 };\n414\t    matrix* m3 = newMatrix(data3, 3, 3);\n415\t    assert(determinant(m3) == -306);\n416\t    deleteMatrix(m3);\n417\t\n418\t    double data4[16] = { 11, 9, 24, 2, 1, 5, 2, 6, 3, 17, 18, 1, 2, 5, 7, 1 };\n419\t    matrix* m4 = newMatrix(data4, 4, 4);\n420\t    double det = determinant(m4);\n421\t    assert(284 == roundn(det, 1));\n422\t    deleteMatrix(m4);\n423\t}\n424\t\n425\tvoid testInverse(){\n426\t    printf(\"\\nTest inverse matrix...\\n\");\n427\t\n428\t    double data[9] = { 3, 0, 2, 2, 0, -2, 0, 1, 1 };\n429\t    matrix* m = newMatrix(data, 3, 3);\n430\t    matrix* inv = inverseMatrix(m);\n431\t\n432\t    printf(\"\\nInv(m)\\n\");\n433\t    printMatrix(inv, false);\n434\t\n435\t    deleteMatrix(inv);\n436\t    deleteMatrix(m);\n437\t}\n438\t\n439\tvoid testVectorOperations(){\n440\t    printf(\"\\nTest vector operations...\\n\");\n441\t    double data1[3] = { 2, 4, 3 };\n442\t    double data2[3] = { 5, 10, 15};\n443\t    double data3[3] = { 1, 0, 0};\n444\t    double data4[3] = { 0, 1, 0};\n445\t    vector* v  = newVector(data1, 3);\n446\t    vector* w  = newVector(data2, 3);\n447\t    vector* u1 = newVector(data3, 3);\n448\t    vector* u2 = newVector(data4, 3);\n449\t    \n450\t    assert(roundn(vectorMagnitude(v),3) == 5.385);\n451\t    assert(!isUnitVector(v) && isUnitVector(u1));\n452\t    assert(dotProduct(v,w) == 95);\n453\t    assert(isVectorOrthogonal(u1,u2));\n454\t    assert(roundn(vectorDistance(v,w),3) == 13.748);\n455\t\n456\t    vector* cross = crossProduct(v, w);\n457\t    assert(\n458\t      getVectorElement(cross,0) == 30 && \n459\t      getVectorElement(cross,1) == 15 && \n460\t      getVectorElement(cross,2) == 0\n461\t    );\n462\t    deleteVector(cross);\n463\t    deleteVector(u2);\n464\t    deleteVector(u1);\n465\t    deleteVector(w);\n466\t    deleteVector(v);\n467\t}\n468\t"}]},"parent_tool_use_id":null,"session_id":"5f14d19d-4456-4d60-878c-237ad95d8153","uuid":"38767ef8-0950-484c-94bc-ff6dc0f2f321","timestamp":"2026-06-06T03:31:10.000Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-J6m450/project/c_src/test.c","content":"#include <math.h>\n#include <stdio.h>\n#include \"linear-algebra.h\"\n\nvoid testCreate();\nvoid testCopy();\nvoid testFlatten();\nvoid testElem();\nvoid testRowVector();\nvoid testColVector();\nvoid testMainDiagonal();\nvoid testAntiDiagonal();\n\nvoid testIsEqual();\nvoid testIsZeroMatrix();\nvoid testIsIdentityMatrix();\nvoid testIsSquareMatrix();\nvoid testIsDiagonal();\nvoid testIsTriangular();\nvoid testIsSymmetric();\n\nvoid testTranspose();\nvoid testTrace();\nvoid testAddMatrices();\nvoid testMultiplyMatrices();\nvoid testScaleMatrix();\nvoid testSubMatrix();\nvoid testDeterminant();\nvoid testInverse();\n\nvoid testVectorOperations();\n\n\nint main(){\n    testCreate();\n    testCopy();\n    testFlatten();\n    testElem();\n    testRowVector();\n    testColVector();\n    testMainDiagonal();\n    testAntiDiagonal();\n\n    testIsEqual();\n    testIsZeroMatrix();\n    testIsIdentityMatrix();\n    testIsSquareMatrix();\n    testIsDiagonal();\n    testIsTriangular();\n    testIsSymmetric();\n\n    testTranspose();\n    testTrace();\n    testAddMatrices();\n    testMultiplyMatrices();\n    testScaleMatrix();\n    testSubMatrix();\n    testDeterminant();\n    testInverse();\n\n    testVectorOperations();\n\n    return 0;\n}\n\nvoid testCreate(){\n    printf(\"\\nTest create matrix and vector from array...\\n\");\n    double data[4] = {1, 2, 3, 4};\n    matrix* m = newMatrix(data, 2, 2);\n    assert(\n      getMatrixElement(m,0,0) == 1 && getMatrixElement(m,0,1) == 2 && \n      getMatrixElement(m,1,0) == 3 && getMatrixElement(m,1,1) == 4 &&\n      matrixSize(m) == 4 && matrixSizeBytes(m) == 32\n    );\n    deleteMatrix(m);\n\n    double data2[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };\n    vector* v = newVector(data2, 8);\n    assert(vectorSizeBytes(v) == 64);\n    deleteVector(v);\n}\n\nvoid testCopy(){\n    printf(\"\\nTest matrix and vector copying...\\n\");\n    matrix* m = zeroMatrix(2,2);\n    setMatrixElement(m,0,1,5);\n    matrix* n = copyMatrix(m);\n    assert(\n      getMatrixElement(m,0,0) == getMatrixElement(n,0,0) && \n      getMatrixElement(m,0,1) == getMatrixElement(n,0,1) &&\n      getMatrixElement(m,1,0) == getMatrixElement(n,1,0) && \n      getMatrixElement(m,1,1) == getMatrixElement(n,1,1)\n    );\n    deleteMatrix(n);\n    deleteMatrix(m);\n\n    vector* v = zeroVector(4);\n    setVectorElement(v, 2, 2);\n    vector* v2 = copyVector(v);\n    assert(getVectorElement(v2, 2) == 2);\n    deleteVector(v2);\n    deleteVector(v);\n}\n\nvoid testFlatten(){\n    printf(\"\\nTest flatten...\\n\");\n    double data[6] = { 1, 2, 3, 4, 5, 6 };\n    matrix* m = newMatrix(data, 2, 3);\n    vector* flat = flattenMatrix(m);\n    assert(getVectorElement(flat,0) == 1 && getVectorElement(flat,5) == 6);\n    deleteVector(flat);\n    deleteMatrix(m);\n}\n\nvoid testElem(){\n    printf(\"\\nTest element accessor and mutator...\\n\");\n    matrix* m = zeroMatrix(2,2);\n    setMatrixElement(m,0,0,4);\n    assert(\n      getMatrixElement(m,0,0) == 4 && getMatrixElement(m,0,1) == 0 &&\n      getMatrixElement(m,1,0) == 0 && getMatrixElement(m,1,1) == 0\n    );\n    deleteMatrix(m);\n\n    vector* v = zeroVector(2);\n    setVectorElement(v,1,10);\n    assert(getVectorElement(v,1) == 10);\n    deleteVector(v);\n}\n\nvoid testRowVector(){\n    printf(\"\\nTest accessor/mutator for row vectors...\\n\");\n    matrix* m = zeroMatrix(3,2);\n    vector* row = getRowVector(m,1);\n    setVectorElement(row,0,123);\n    assert(getVectorElement(row,0) == 123 && getVectorElement(row,1) == 0);\n    double data[2] = {1, 4};\n    vector* v = newVector(data,2);\n    setRowVector(m, 1, v);\n    assert(\n      getMatrixElement(m,0,0) == 0 &&\n      getMatrixElement(m,0,1) == 0 &&\n      getMatrixElement(m,1,0) == 1 &&\n      getMatrixElement(m,1,1) == 4\n    );\n\n    deleteVector(v);\n    deleteVector(row);\n    deleteMatrix(m);\n}\n\nvoid testColVector(){\n    printf(\"\\nTest accessor/mutator for column vectors...\\n\");\n    matrix* m = zeroMatrix(3, 2);\n    vector* col = getColVector(m, 0);\n    setVectorElement(col,0,5);\n    setVectorElement(col,1,10);\n    setVectorElement(col,2,15);\n    assert(getVectorElement(col,0) == 5 && getVectorElement(col,1) == 10);\n    double data[2] = {10, 3};\n    vector* v = newVector(data,2);\n    setColVector(m, 0, v);\n\n    deleteVector(v);\n    deleteVector(col);\n    deleteMatrix(m);\n}\n\nvoid testMainDiagonal(){\n    printf(\"\\nTest accessor/mutator for main diagonal...\\n\");\n    matrix* m = zeroMatrix(2,2);\n    setMatrixElement(m,0,0,34);\n    setMatrixElement(m,1,1,56);\n    vector* v = getMainDiagonal(m);\n    assert(getVectorElement(v,0) == 34 && getVectorElement(v,1) == 56);\n    deleteVector(v);\n    deleteMatrix(m);\n\n    matrix* n = zeroMatrix(2,2);\n    vector* w = zeroVector(2);\n    setVectorElement(w,0,100);\n    setVectorElement(w,1,4);\n    setMainDiagonal(n,w);\n    assert(getMatrixElement(n,0,0) == 100 && getMatrixElement(n,1,1) == 4);\n    deleteMatrix(n);\n    deleteVector(w);\n}\n\nvoid testAntiDiagonal(){\n    printf(\"\\nTest accessor/mutator for anti diagonal...\\n\");\n    matrix* m = zeroMatrix(2,2);\n    setMatrixElement(m,0,1,100);\n    setMatrixElement(m,1,0,250);\n    vector* d = getAntiDiagonal(m);\n    assert(getVectorElement(d,0) == 250 && getVectorElement(d,1) == 100);\n    deleteVector(d);\n    deleteMatrix(m);\n\n    matrix* n = zeroMatrix(2,2);\n    vector* e = zeroVector(2);\n    setVectorElement(e,0,9);\n    setVectorElement(e,1,8);\n    setAntiDiagonal(n,e);\n    assert(getMatrixElement(n,1,0) == 9 && getMatrixElement(n,0,1) == 8);\n    deleteMatrix(n);\n    deleteVector(e);\n}\n\nvoid testIsEqual(){\n    printf(\"\\nTest vector and matrix equal...\\n\");\n    matrix* m = zeroMatrix(2, 2);\n    matrix* n = zeroMatrix(2, 2);\n    matrix* o = zeroMatrix(3, 3);\n    assert(!isMatrixEqual(m,o));\n    assert(isMatrixEqual(m,n));\n    setMatrixElement(m,0,0,1);\n    assert(!isMatrixEqual(m,n));\n    deleteMatrix(o);\n    deleteMatrix(n);\n    deleteMatrix(m);\n\n    vector* v = zeroVector(3);\n    vector* w = zeroVector(3);\n    assert(isVectorEqual(v, w));\n    deleteVector(w);\n    deleteVector(v);\n}\n\nvoid testIsZeroMatrix(){\n    printf(\"\\nTest isZeroMatrix...\\n\");\n    matrix* m = zeroMatrix(1,3);\n    matrix* n = zeroMatrix(2,2);\n    setMatrixElement(n,0,0,1);\n    assert(isZeroMatrix(m));\n    assert(!isZeroMatrix(n));\n    deleteMatrix(n);\n    deleteMatrix(m);\n}\n\nvoid testIsIdentityMatrix(){\n    printf(\"\\nTest isIdentityMatrix...\\n\");\n\n    matrix* m = zeroMatrix(2,2);\n    setMatrixElement(m,0,0,1);\n    setMatrixElement(m,1,1,1);\n    assert(isIdentityMatrix(m));\n    deleteMatrix(m);\n\n    matrix* n = zeroMatrix(1,3);\n    assert(!isIdentityMatrix(n));\n    deleteMatrix(n);\n\n    matrix* o = zeroMatrix(3,3);\n    setMatrixElement(o,0,0,1);\n    setMatrixElement(o,1,1,1);\n    setMatrixElement(o,2,2,1);\n    setMatrixElement(o,1,2,-4);\n    assert(!isIdentityMatrix(o));\n    deleteMatrix(o);\n    \n    matrix* p = identityMatrix(2);\n    assert(isIdentityMatrix(p));\n    deleteMatrix(p);\n}\n\nvoid testIsSquareMatrix(){\n    printf(\"\\nTest isSquareMatrix...\\n\");\n    matrix* m = zeroMatrix(2, 2);\n    assert(isSquareMatrix(m));\n    deleteMatrix(m);\n\n    matrix* n = zeroMatrix(1, 3);\n    assert(!isSquareMatrix(n));\n    deleteMatrix(n);\n}\n\nvoid testIsDiagonal(){\n    printf(\"\\nTest isDiagonal...\\n\");\n    double data1[9] = { 1, 2, 3,  0, 5, 6,  0, 0, 9 };\n    matrix* m1 = newMatrix(data1, 3, 3);\n    assert(!isDiagonalMatrix(m1));\n    deleteMatrix(m1);\n\n    double data2[9] = { 1, 0, 0, 0, 2, 0, 0, 0, 3 };\n    matrix* m2 = newMatrix(data2, 3, 3);\n    assert(isDiagonalMatrix(m2));\n    deleteMatrix(m2);\n}\n\nvoid testIsTriangular(){\n    printf(\"\\nTest isTriangular, isLoTriMatrix, isUpTriMatrix...\\n\");\n    \n    double data1[9] = { 1, 2, 3,  0, 5, 6,  0, 0, 9 };\n    matrix* m1 = newMatrix(data1, 3, 3);\n    assert(isUpTriMatrix(m1));\n    deleteMatrix(m1);\n\n    double data2[9] = { 1, 0, 0,  4, 5, 0,  7, 8, 9 };\n    matrix* m2 = newMatrix(data2, 3, 3);\n    assert(isLoTriMatrix(m2));\n    deleteMatrix(m2);\n\n    double data3[9] = { 1, 0, 0,  4, 5, 0,  7, 8, 9 };\n    matrix* m3 = newMatrix(data3, 3, 3);\n    assert(isTriangularMatrix(m3));\n    deleteMatrix(m3);\n}\n\nvoid testIsSymmetric(){\n    printf(\"\\nTest isSymmetric...\\n\");\n    double data[6] = { 1, 2, 3, 4, 5, 6 };\n    matrix* m = newMatrix(data, 2, 3);\n    assert(!isMatrixSymmetric(m));\n    deleteMatrix(m);\n    matrix* n = zeroMatrix(2,2);\n    assert(isMatrixSymmetric(n));\n    deleteMatrix(n);\n}\n\nvoid testTranspose(){\n    printf(\"\\nTest transposeMatrix...\\n\");\n    double data[6] = { 1, 2, 3, 4, 5, 6 };\n    matrix* m = newMatrix(data, 2, 3);\n    matrix* t = transposeMatrix(m);\n    assert( \n      getMatrixElement(t,0,0) == 1 && getMatrixElement(t,1,0) == 2 && getMatrixElement(t,2,0) == 3 &&\n      getMatrixElement(t,0,1) == 4 && getMatrixElement(t,1,1) == 5 && getMatrixElement(t,2,1) == 6\n    );\n    deleteMatrix(t);\n    deleteMatrix(m);\n}\n\nvoid testTrace(){\n    printf(\"\\nTest trace...\\n\");\n    double data[9] = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };\n    matrix* m = newMatrix(data, 3, 3);\n    assert(traceMatrix(m) == 15);\n    deleteMatrix(m);\n}\n\nvoid testAddMatrices(){\n    printf(\"\\nTest adding matrices...\\n\");\n    double data1[4] = { 4, 6, 3, 8 };\n    double data2[4] = { 6, 4, 7, 2 };\n    matrix* m1 = newMatrix(data1, 2, 2);\n    matrix* m2 = newMatrix(data2, 2, 2);\n    matrix* sum = addMatrices(m1, m2);\n    assert(\n      getMatrixElement(sum,0,0) == 10 && getMatrixElement(sum,0,1) == 10 &&\n      getMatrixElement(sum,1,0) == 10 && getMatrixElement(sum,1,1) == 10\n    );\n    deleteMatrix(sum);\n    deleteMatrix(m2);\n    deleteMatrix(m1);\n}\n\nvoid testMultiplyMatrices(){\n    printf(\"\\nTest multiplying matrices...\\n\");\n    double data1[4] = { 1, 2, 3, 4 };\n    double data2[4] = { 1, 1, 1, 1 };\n    matrix* m1 = newMatrix(data1, 2, 2);\n    matrix* m2 = newMatrix(data2, 2, 2);\n    matrix* prod = multiplyMatrices(m1, m2);\n    assert(\n      getMatrixElement(prod,0,0) == 3 && getMatrixElement(prod,0,1) == 3 &&\n      getMatrixElement(prod,1,0) == 7 && getMatrixElement(prod,1,1) == 7\n    );\n    deleteMatrix(prod);\n    deleteMatrix(m2);\n    deleteMatrix(m1);\n}\n\nvoid testScaleMatrix(){\n    printf(\"\\nTest scaling matrices...\\n\");\n    double data[6] = { 1, 2, 3, 4, 5, 6 };\n    matrix* m = newMatrix(data, 3, 2);\n    matrix* scaled = scaleMatrix(m, 10);\n    assert(\n      getMatrixElement(scaled,0,0) == 10 && getMatrixElement(scaled,0,1) == 20 &&\n      getMatrixElement(scaled,1,0) == 30 && getMatrixElement(scaled,1,1) == 40 &&\n      getMatrixElement(scaled,2,0) == 50 && getMatrixElement(scaled,2,1) == 60\n    );\n    deleteMatrix(scaled);\n    deleteMatrix(m);\n}\n\nvoid testSubMatrix(){\n    printf(\"\\nTest sub matrix...\\n\");\n    double data[9] = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };\n    matrix* m = newMatrix(data, 3, 3);\n    matrix* sub = subMatrix(m, 2, 2);\n    assert(\n      getMatrixElement(sub,0,0) == 1 && getMatrixElement(sub,0,1) == 2 &&\n      getMatrixElement(sub,1,0) == 4 && getMatrixElement(sub,1,1) == 5\n    );\n    deleteMatrix(sub);\n    deleteMatrix(m);\n}\n\nvoid testDeterminant(){\n    printf(\"\\nTest determinant...\\n\");\n    \n    double data1[1] = { 10 };\n    matrix* m1 = newMatrix(data1, 1, 1);\n    assert(determinant(m1) == 10);\n    deleteMatrix(m1);\n\n    double data2[4] = { 4, 6, 3, 8 };\n    matrix* m2 = newMatrix(data2, 2, 2);\n    assert(determinant(m2) == 14);\n    deleteMatrix(m2);\n\n    double data3[9] = { 6, 1, 1, 4, -2, 5, 2, 8, 7 };\n    matrix* m3 = newMatrix(data3, 3, 3);\n    assert(determinant(m3) == -306);\n    deleteMatrix(m3);\n\n    double data4[16] = { 11, 9, 24, 2, 1, 5, 2, 6, 3, 17, 18, 1, 2, 5, 7, 1 };\n    matrix* m4 = newMatrix(data4, 4, 4);\n    double det = determinant(m4);\n    assert(284 == roundn(det, 1));\n    deleteMatrix(m4);\n}\n\nvoid testInverse(){\n    printf(\"\\nTest inverse matrix...\\n\");\n\n    double data[9] = { 3, 0, 2, 2, 0, -2, 0, 1, 1 };\n    matrix* m = newMatrix(data, 3, 3);\n    matrix* inv = inverseMatrix(m);\n\n    printf(\"\\nInv(m)\\n\");\n    printMatrix(inv, false);\n\n    deleteMatrix(inv);\n    deleteMatrix(m);\n}\n\nvoid testVectorOperations(){\n    printf(\"\\nTest vector operations...\\n\");\n    double data1[3] = { 2, 4, 3 };\n    double data2[3] = { 5, 10, 15};\n    double data3[3] = { 1, 0, 0};\n    double data4[3] = { 0, 1, 0};\n    vector* v  = newVector(data1, 3);\n    vector* w  = newVector(data2, 3);\n    vector* u1 = newVector(data3, 3);\n    vector* u2 = newVector(data4, 3);\n    \n    assert(roundn(vectorMagnitude(v),3) == 5.385);\n    assert(!isUnitVector(v) && isUnitVector(u1));\n    assert(dotProduct(v,w) == 95);\n    assert(isVectorOrthogonal(u1,u2));\n    assert(roundn(vectorDistance(v,w),3) == 13.748);\n\n    vector* cross = crossProduct(v, w);\n    assert(\n      getVectorElement(cross,0) == 30 && \n      getVectorElement(cross,1) == 15 && \n      getVectorElement(cross,2) == 0\n    );\n    deleteVector(cross);\n    deleteVector(u2);\n    deleteVector(u1);\n    deleteVector(w);\n    deleteVector(v);\n}\n","numLines":468,"startLine":1,"totalLines":468}}}
