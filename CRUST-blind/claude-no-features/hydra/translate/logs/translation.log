eded by `tree_add_command`. Build is clean (`cargo build` and `cargo build --release` both succeed with no warnings)."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":218,"cache_read_input_tokens":26299,"cache_creation":{"ephemeral_5m_input_tokens":218,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"98e4dfdb-cded-40f0-a19c-12a02e4a8652","uuid":"35da96c0-05d6-4304-90a8-ff78c217dde4"}
