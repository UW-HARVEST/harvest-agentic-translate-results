ge(0, samp);\n54\t      for (size_t j = 0; j < zero; ++j)\n55\t        u->coeffs[i++] = 0;\n56\t      zeroes -= zero;\n57\t    }\n58\t  }\n59\t\n60\t  u->coeffs[param->dim] = 0;\n61\t  u->coeffs[param->dim] = (int64_t)channel->q - (int64_t)coef_sum(u);\n62\t  return 0;\n63\t}\n64\t\n65\tint generate_secret(const Channel *channel, const Parameters *param,\n66\t                    const Polynomial *u, PolyArray *secret, Matrix3D *lambda) {\n67\t  Matrix2D m;\n68\t  Matrix2D invm;\n69\t\n70\t  m.dim = param->dim;\n71\t  invm.dim = param->dim;\n72\t\n73\t  size_t required_mem = m.dim * m.dim;\n74\t  uint64_t mem[2 * required_mem];\n75\t  m.data = mem;\n76\t  invm.data = mem + required_mem;\n77\t\n78\t  fill_random_invertible_pairs(&m, &invm, channel->q, 600);\n79\t\n80\t  secret->size = m.dim;\n81\t  for (size_t i = 0; i < m.dim; ++i) {\n82\t    for (size_t j = 0; j < m.dim; ++j) {\n83\t      secret->polies[i].coeffs[j] = matrix2d_get(&m, j, i);\n84\t    }\n85\t  }\n86\t\n87\t  Matrix2D *arr = &m;\n88\t  Polynomial a_ij_poly;\n89\t\n90\t  Coeff miim[2 * secret->size];\n91\t\n92\t  for (size_t i = 0; i < secret->size; ++i) {\n93\t    for (size_t j = 0; j < secret->size; ++j) {\n94\t      set_polynomial(&a_ij_poly, miim, 2 * secret->size);\n95\t      poly_mul(&secret->polies[i], &secret->polies[j], &a_ij_poly, channel->q);\n96\t      poly_mod(&a_ij_poly, u, channel->q);\n97\t\n98\t      for (size_t row = 0; row < arr->dim; row++) {\n99\t        matrix2d_set(arr, row, j, a_ij_poly.coeffs[arr->dim - row - 1]);\n100\t      }\n101\t    }\n102\t\n103\t    matrix2d_multiply(&invm, arr, matrix3d_get(lambda, i), channel->q);\n104\t  }\n105\t\n106\t  return 0;\n107\t}\n108\t\n109\tint generate_f0(const Channel *channel, const Parameters *param,\n110\t                PolyArray *f0) {\n111\t  (void)param; // TODO: we need to consider N\n112\t  for (size_t i = 0; i < f0->size; ++i) {\n113\t    for (size_t j = 0; j < f0->polies[i].size; j++)\n114\t      f0->polies[i].coeffs[j] = randr