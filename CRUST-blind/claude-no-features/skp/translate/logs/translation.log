"'a' . 'i'\", 1, 4);\n    run(\"t2.7\", from, \". [èì] .\", 1, 4);\n    run(\"t2.8\", from, \"'aè'\\x02 .\", 2, 3);\n\n    // > test - skp_to\n    let mut to: &str = \"\";\n    let mut end: &str = \"\";\n    let alt = skp_4(from, \"> 'è'\", Some(&mut to), Some(&mut end));\n    let len = to.len() - end.len();\n    println!(\n        \"t2.9 : alt={} len={} (expected: alt=1 len=2) {}\",\n        alt,\n        len,\n        if alt == 1 && len == 2 { \"PASS\" } else { \"FAIL\" }\n    );\n\n    // ut_test3.c\n    let from = \"ABC\";\n    run(\"t3.1\", from, \"'AB'\", 1, 2);\n    run(\"t3.2\", from, \"'XB'\", 0, 0);\n    run(\"t3.3\", from, \"'XB\\x0EAB'\", 1, 2);\n    run(\"t3.4\", from, \"'AB\\x0EXB'\", 1, 2);\n\n    let from = \"12cm\";\n    run(\"t3.5\", from, \"D @ 'cm\\x0Emm\\x0Ept'\", 1, 2);\n    let from = \"12mm\";\n    run(\"t3.6\", from, \"D @ 'cm\\x0Emm\\x0Ept'\", 1, 2);\n    let from = \"12XX\";\n    run(\"t3.7\", from, \"D @ 'cm\\x0Emm\\x0Ept'\", 0, 0);\n    let from = \"12ptcm\";\n    run(\"t3.8\", from, \"D @ 'cm\\x0Emm\\x0Ept'\", 1, 2);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1182,"cache_read_input_tokens":103522,"cache_creation":{"ephemeral_5m_input_tokens":1182,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a8267341-8824-4c1e-80d6-88cfb7e5d351","uuid":"d159acba-487f-427a-8d25-70fbd1d79f22"}
