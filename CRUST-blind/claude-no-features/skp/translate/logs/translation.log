                }\n                let _ = write!(f, \"'\");\n            }\n            let _ = writeln!(f);\n        } else {\n            levl -= 4;\n        }\n    }\n}\n\n// Suppress unused warnings for SKP_MAXDEPTH which is referenced by macros not implemented here.\n#[allow(dead_code)]\nfn _unused() {\n    let _ = SKP_MAXDEPTH;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1133,"cache_read_input_tokens":62228,"cache_creation":{"ephemeral_5m_input_tokens":1133,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a8267341-8824-4c1e-80d6-88cfb7e5d351","uuid":"36376e32-dae9-4b10-8bf4-faf99577a403"}
