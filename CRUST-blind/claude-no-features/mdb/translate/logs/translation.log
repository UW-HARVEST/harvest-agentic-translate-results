ar *valbuf, mdb_size_t valsize);\n56\tstatic mdb_status_t mdb_read_nextptr(mdb_int_t *db, mdb_ptr_t idxptr,\n57\t                                     mdb_ptr_t *nextptr);\n58\tstatic mdb_status_t mdb_write_nextptr(mdb_int_t *db, mdb_ptr_t ptr,\n59\t                                      mdb_ptr_t nextptr);\n60\tstatic mdb_status_t mdb_stretch_index_file(mdb_int_t *db, mdb_ptr_t *ptr);\n61\tstatic mdb_status_t mdb_index_alloc(mdb_int_t *db, mdb_ptr_t *ptr);\n62\tstatic mdb_status_t mdb_data_alloc(mdb_int_t *db, mdb_size_t valsize,\n63\t                                   mdb_ptr_t *ptr);\n64\tstatic mdb_status_t mdb_index_free(mdb_int_t *db, mdb_ptr_t ptr);\n65\tstatic mdb_status_t mdb_data_free(mdb_int_t *db, mdb_ptr_t valptr,\n66\t                                  mdb_size_t valsize);\n67\t\n68\tstatic char pathbuf[4096];\n69\t\n70\tmdb_status_t mdb_open(mdb_t *handle, const char *path) {\n71\t  mdb_int_t *db = mdb_alloc();\n72\t  if (db == NULL) {\n73\t    return mdb_status(MDB_ERR_ALLOC,\n74\t                      \"failed allocating memory buffer for database\");\n75\t  }\n76\t\n77\t  strcpy(pathbuf, path);\n78\t  strcat(pathbuf, \".db.super\");\n79\t  db->fp_superblock = fopen(pathbuf, \"r\");\n80\t  if (db->fp_superblock == NULL) {\n81\t    mdb_free(db);\n82\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open superblock file as read\");\n83\t  }\n84\t\n85\t  fscanf(db->fp_superblock, \"%s\", db->db_name);\n86\t  fscanf(db->fp_superblock, \"%hu\", &(db->options.key_size_max));\n87\t  fscanf(db->fp_superblock, \"%u\", &(db->options.data_size_max));\n88\t  fscanf(db->fp_superblock, \"%u\", &(db->options.hash_buckets));\n89\t  fscanf(db->fp_superblock, \"%u\", &(db->options.items_max));\n90\t\n91\t  db->index_record_size = db->options.key_size_max\n92\t                          + MDB_PTR_SIZE * 2\n93\t                          + MDB_DATALEN_SIZE;\n94\t\n95\t  if (ferror(db->fp_superblock)) {\n96\t    mdb_free(db);\n97\t    return mdb_status(MDB_ERR_READ, \"read error when parsing superblock\");\n98\t  }\n99\t\n100\t  strcpy(pathbuf, path);\n101\t  strcat(pathbuf, \".db.index\");\n102\t  db->fp_index = fopen(pathbuf, \"rb+\");\n103\t  if (db->fp_index == NULL) {\n104\t    mdb_free(db);\n105\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open index file as readwrite\");\n106\t  }\n107\t\n108\t  strcpy(pathbuf, path);\n109\t  strcat(pathbuf, \".db.data\");\n110\t  db->fp_data = fopen(pathbuf, \"rb+\");\n111\t  if (db->fp_data == NULL) {\n112\t    mdb_free(db);\n113\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open data file as readwrite\");\n114\t  }\n115\t\n116\t  if (fflush(NULL) != 0) {\n117\t    mdb_free(db);\n118\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n119\t  }\n120\t\n121\t  *handle = (mdb_t)db;\n122\t  return mdb_status(MDB_OK, NULL);\n123\t}\n124\t\n125\tmdb_status_t mdb_create(mdb_t *handle, mdb_options_t options) {\n126\t  mdb_int_t *db = mdb_alloc();\n127\t  if (db == NULL) {\n128\t    return mdb_status(MDB_ERR_ALLOC,\n129\t                      \"failed allocating memory buffer for database\");\n130\t  }\n131\t\n132\t  strcpy(db->options.db_name, options.db_name);\n133\t  db->options.items_max = options.items_max;\n134\t  db->options.hash_buckets = options.hash_buckets;\n135\t  db->options.key_size_max = options.key_size_max;\n136\t  db->options.data_size_max = options.data_size_max;\n137\t\n138\t  db->index_record_size = db->options.key_size_max\n139\t                          + MDB_PTR_SIZE * 2\n140\t                          + MDB_DATALEN_SIZE;\n141\t\n142\t  strcpy(pathbuf, options.db_name);\n143\t  strcat(pathbuf, \".db.super\");\n144\t  db->fp_superblock = fopen(pathbuf, \"w\");\n145\t  if (db->fp_superblock == NULL) {\n146\t    mdb_free(db);\n147\t    return mdb_status(MDB_ERR_OPEN_FILE,\n148\t                      \"cannot open superblock file as write\");\n149\t  }\n150\t\n151\t  fprintf(db->fp_superblock, \"%s\\n\", db->db_name);\n152\t  fprintf(db->fp_superblock, \"%hu\\n\", db->options.key_size_max);\n153\t  fprintf(db->fp_superblock, \"%u\\n\", db->options.data_size_max);\n154\t  fprintf(db->fp_superblock, \"%u\\n\", db->options.hash_buckets);\n155\t  fprintf(db->fp_superblock, \"%u\\n\", db->options.items_max);\n156\t\n157\t  if (ferror(db->fp_superblock)) {\n158\t    mdb_free(db);\n159\t    return mdb_status(MDB_ERR_WRITE, \"write error when writing superblock\");\n160\t  }\n161\t\n162\t  strcpy(pathbuf, options.db_name);\n163\t  strcat(pathbuf, \".db.index\");\n164\t  db->fp_index = fopen(pathbuf, \"wb+\");\n165\t  if (db->fp_index == NULL) {\n166\t    mdb_free(db);\n167\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open index file as readwrite\");\n168\t  }\n169\t\n170\t  mdb_ptr_t zero_ptr = 0;\n171\t  if (fwrite(&zero_ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n172\t    mdb_free(db);\n173\t    return mdb_status(MDB_ERR_WRITE, \"write error when writing freeptr\");\n174\t  }\n175\t  for (size_t i = 0; i < options.hash_buckets; i++) {\n176\t    if (fwrite(&zero_ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n177\t      mdb_free(db);\n178\t      return mdb_status(MDB_ERR_WRITE, \"write error when writing hash buckets\");\n179\t    }\n180\t  }\n181\t\n182\t  strcpy(pathbuf, options.db_name);\n183\t  strcat(pathbuf, \".db.data\");\n184\t  db->fp_data = fopen(pathbuf, \"wb+\");\n185\t  if (db->fp_data == NULL) {\n186\t    mdb_free(db);\n187\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open data file as readwrite\");\n188\t  }\n189\t\n190\t  if (fflush(NULL) != 0) {\n191\t    mdb_free(db);\n192\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n193\t  }\n194\t\n195\t  *handle = (mdb_t)db;\n196\t  return mdb_status(MDB_OK, NULL);\n197\t}\n198\t\n199\tmdb_status_t mdb_read(mdb_t handle, const char *key, char *buf, size_t bufsiz) {\n200\t  mdb_int_t *db = (mdb_int_t*)handle;\n201\t  mdb_size_t bucket = mdb_hash(key) % db->options.hash_buckets;\n202\t\n203\t  mdb_ptr_t ptr;\n204\t  mdb_status_t bucket_read_status = mdb_read_bucket(db, bucket, &ptr);\n205\t  STAT_CHECK_RET(bucket_read_status, {;});\n206\t\n207\t  mdb_index_t *index =\n208\t      alloca(sizeof(mdb_index_t) + db->options.key_size_max + 1);\n209\t\n210\t  while (ptr != 0) {\n211\t    mdb_status_t read_status = mdb_read_index(db, ptr, index);\n212\t    STAT_CHECK_RET(read_status, {;});\n213\t    if (strcmp(index->key, key) == 0) {\n214\t      return mdb_read_data(db, index->value_ptr, index->value_size, buf,\n215\t                           bufsiz);\n216\t    }\n217\t    ptr = index->next_ptr;\n218\t  }\n219\t\n220\t  return mdb_status(MDB_NO_KEY, \"Key not found\");\n221\t}\n222\t\n223\tmdb_status_t mdb_write(mdb_t handle, const char *key, const char *value) {\n224\t  mdb_int_t *db = (mdb_int_t*)handle;\n225\t  mdb_size_t bucket = mdb_hash(key) % db->options.hash_buckets;\n226\t  mdb_size_t key_size = strlen(key);\n227\t  if (key_size > db->options.key_size_max) {\n228\t    return mdb_status(MDB_ERR_KEY_SIZE, \"key size too large\");\n229\t  }\n230\t  mdb_size_t value_size = strlen(value);\n231\t  if (value_size > db->options.data_size_max) {\n232\t    return mdb_status(MDB_ERR_VALUE_SIZE, \"value size too large\");\n233\t  }\n234\t\n235\t  mdb_ptr_t save_ptr = MDB_PTR_SIZE * (bucket + 1);\n236\t  mdb_ptr_t ptr;\n237\t  mdb_status_t bucket_read_status = mdb_read_bucket(db, bucket, &ptr);\n238\t  STAT_CHECK_RET(bucket_read_status, {;});\n239\t\n240\t  mdb_index_t *index = alloca(sizeof(mdb_index_t)\n241\t                              + db->options.key_size_max + 1);\n242\t  while (ptr != 0) {\n243\t    mdb_status_t index_read_status = mdb_read_index(db, ptr, index);\n244\t    STAT_CHECK_RET(index_read_status, {;});\n245\t    if (strcmp(index->key, key) == 0) {\n246\t      break;\n247\t    }\n248\t    save_ptr = ptr;\n249\t    ptr = index->next_ptr;\n250\t  }\n251\t\n252\t  if (ptr == 0) {\n253\t    mdb_ptr_t index_ptr;\n254\t    mdb_status_t index_alloc_status = mdb_index_alloc(db, &index_ptr);\n255\t    STAT_CHECK_RET(index_alloc_status, {;});\n256\t    mdb_ptr_t value_ptr;\n257\t    mdb_status_t data_alloc_status = mdb_data_alloc(db, value_size, &value_ptr);\n258\t    STAT_CHECK_RET(data_alloc_status, {\n259\t                     (void)mdb_index_free(db, index_ptr);\n260\t                   });\n261\t    mdb_status_t data_write_status = mdb_write_data(db, value_ptr, value,\n262\t                                                    value_size);\n263\t    STAT_CHECK_RET(data_write_status, {\n264\t                     (void)mdb_data_free(db, value_ptr, value_size);\n265\t                     (void)mdb_index_free(db, index_ptr);\n266\t                   });\n267\t    mdb_status_t index_write_status = mdb_write_index(db, index_ptr, key,\n268\t                                                      value_ptr, value_size);\n269\t    STAT_CHECK_RET(index_write_status, {\n270\t                     (void)mdb_data_free(db, value_ptr, value_size);\n271\t                     (void)mdb_index_free(db, index_ptr);\n272\t                   });\n273\t    mdb_status_t ptr_update_status = mdb_write_nextptr(db, save_ptr, index_ptr);\n274\t    STAT_CHECK_RET(ptr_update_status, {\n275\t                     (void)mdb_data_free(db, value_ptr, value_size);\n276\t                     (void)mdb_index_free(db, index_ptr);\n277\t                   });\n278\t    return mdb_status(MDB_OK, NULL);\n279\t  } else {\n280\t    /// @todo errors are only handled roughly here, needs refinement\n281\t    mdb_status_t data_free_status = mdb_data_free(db, index->value_ptr,\n282\t                                                  index->value_size);\n283\t    STAT_CHECK_RET(data_free_status, {;});\n284\t    mdb_ptr_t value_ptr;\n285\t    mdb_status_t data_alloc_status = mdb_data_alloc(db, value_size, &value_ptr);\n286\t    STAT_CHECK_RET(data_alloc_status, {;});\n287\t    mdb_status_t data_write_status = mdb_write_data(db, value_ptr, value,\n288\t                                                    value_size);\n289\t    STAT_CHECK_RET(data_write_status, {;});\n290\t    mdb_status_t index_write_status = mdb_write_index(db, ptr, key, value_ptr,\n291\t                                                      value_size);\n292\t    STAT_CHECK_RET(index_write_status, {;});\n293\t    return mdb_status(MDB_OK, NULL);\n294\t  }\n295\t}\n296\t\n297\tmdb_status_t mdb_delete(mdb_t handle, const char *key) {\n298\t  mdb_int_t *db = (mdb_int_t*)handle;\n299\t  mdb_size_t bucket = mdb_hash(key) % db->options.hash_buckets;\n300\t\n301\t  mdb_ptr_t save_ptr = MDB_PTR_SIZE * (bucket + 1);\n302\t  mdb_ptr_t ptr;\n303\t  mdb_status_t bucket_read_status = mdb_read_bucket(db, bucket, &ptr);\n304\t  STAT_CHECK_RET(bucket_read_status, {;});\n305\t\n306\t  mdb_index_t *index = alloca(sizeof(mdb_index_t)\n307\t                              + db->options.key_size_max + 1);\n308\t  while (ptr != 0) {\n309\t    mdb_status_t index_read_status = mdb_read_index(db, ptr, index);\n310\t    STAT_CHECK_RET(index_read_status, {;});\n311\t    if (strcmp(index->key, key) == 0) {\n312\t      break;\n313\t    }\n314\t    save_ptr = ptr;\n315\t    ptr = index->next_ptr;\n316\t  }\n317\t\n318\t  if (ptr == 0) {\n319\t    return mdb_status(MDB_NO_KEY, NULL);\n320\t  }\n321\t\n322\t  mdb_status_t data_free_status = mdb_data_free(db, index->value_ptr,\n323\t                                                index->value_size);\n324\t  STAT_CHECK_RET(data_free_status, {;});\n325\t  mdb_status_t index_free_status = mdb_index_free(db, ptr);\n326\t  STAT_CHECK_RET(index_free_status, {;});\n327\t  mdb_status_t nextptr_update_status = mdb_write_nextptr(db, save_ptr,\n328\t                                                         index->next_ptr);\n329\t  STAT_CHECK_RET(nextptr_update_status, {;});\n330\t\n331\t  return mdb_status(MDB_OK, NULL);\n332\t}\n333\t\n334\tmdb_options_t mdb_get_options(mdb_t handle) {\n335\t  mdb_int_t *db = (mdb_int_t*)handle;\n336\t  return db->options;\n337\t}\n338\t\n339\tsize_t mdb_index_size(mdb_t *handle) {\n340\t  mdb_int_t *db = (mdb_int_t*)handle;\n341\t  (void)fseek(db->fp_index, 0, SEEK_END);\n342\t  return ftell(db->fp_index);\n343\t}\n344\t\n345\tsize_t mdb_data_size(mdb_t *handle) {\n346\t  mdb_int_t *db = (mdb_int_t*)handle;\n347\t  (void)fseek(db->fp_data, 0, SEEK_END);\n348\t  return ftell(db->fp_data);\n349\t}\n350\t\n351\tstatic mdb_status_t mdb_read_bucket(mdb_int_t *db, uint32_t bucket,\n352\t                                    mdb_ptr_t *ptr) {\n353\t  if (fseek(db->fp_index, (long)(MDB_PTR_SIZE * (bucket + 1)), SEEK_SET) != 0) {\n354\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to bucket\");\n355\t  }\n356\t  if (fread(ptr, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n357\t    return mdb_status(MDB_ERR_READ, \"cannot read bucket\");\n358\t  }\n359\t  return mdb_status(MDB_OK, NULL);\n360\t}\n361\t\n362\tstatic mdb_status_t mdb_read_index(mdb_int_t *db, mdb_ptr_t idxptr,\n363\t                                   mdb_index_t *index) {\n364\t  if (fseek(db->fp_index, (long)idxptr, SEEK_SET) != 0) {\n365\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n366\t  }\n367\t  if (fread(&(index->next_ptr), MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n368\t    return mdb_status(MDB_ERR_READ, \"cannot read next ptr\");\n369\t  }\n370\t  if (fread(index->key, 1, db->options.key_size_max, db->fp_index)\n371\t      != db->options.key_size_max) {\n372\t    return mdb_status(MDB_ERR_READ, \"cannot read key\");\n373\t  }\n374\t  index->key[db->options.key_size_max] = '\\0';\n375\t  if (fread(&(index->value_ptr), MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n376\t    return mdb_status(MDB_ERR_READ, \"cannot read value ptr\");\n377\t  }\n378\t  if (fread(&(index->value_size), MDB_DATALEN_SIZE, 1, db->fp_index) != 1) {\n379\t    return mdb_status(MDB_ERR_READ, \"cannot read value length\");\n380\t  }\n381\t  return mdb_status(MDB_OK, NULL);\n382\t}\n383\t\n384\tstatic mdb_status_t mdb_write_bucket(mdb_int_t *db, mdb_ptr_t bucket,\n385\t                                     mdb_ptr_t value) {\n386\t  if (fseek(db->fp_index, (long)(MDB_PTR_SIZE * (bucket + 1)), SEEK_SET) != 0) {\n387\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to bucket\");\n388\t  }\n389\t  if (fwrite(&value, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n390\t    return mdb_status(MDB_ERR_WRITE, \"cannot write bucket\");\n391\t  }\n392\t  if (fflush(db->fp_index) != 0) {\n393\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n394\t  }\n395\t  return mdb_status(MDB_OK, NULL);\n396\t}\n397\t\n398\tstatic mdb_status_t mdb_write_index(mdb_int_t *db, mdb_ptr_t idxptr,\n399\t                                    const char *keybuf, mdb_ptr_t valptr,\n400\t                                    mdb_size_t valsize) {\n401\t  if (fseek(db->fp_index, (long)(idxptr + MDB_PTR_SIZE), SEEK_SET) != 0) {\n402\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n403\t  }\n404\t  size_t key_len = strlen(keybuf);\n405\t  if (fwrite(keybuf, 1, key_len, db->fp_index) < key_len) {\n406\t    return mdb_status(MDB_ERR_WRITE, \"cannot write key part of index\");\n407\t  }\n408\t  size_t value_ptr_pos = idxptr + MDB_PTR_SIZE + db->options.key_size_max;\n409\t  if (fseek(db->fp_index, (long)value_ptr_pos, SEEK_SET) != 0) {\n410\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to value part of index\");\n411\t  }\n412\t  if (fwrite(&valptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n413\t    return mdb_status(MDB_ERR_WRITE, \"cannot write to value part of index\");\n414\t  }\n415\t  if (fwrite(&valsize, MDB_DATALEN_SIZE, 1, db->fp_index) < 1) {\n416\t    return mdb_status(MDB_ERR_WRITE, \"cannot write to value part of index\");\n417\t  }\n418\t  if (fflush(db->fp_index) != 0) {\n419\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n420\t  }\n421\t  return mdb_status(MDB_OK, NULL);\n422\t}\n423\t\n424\tstatic mdb_status_t mdb_read_nextptr(mdb_int_t *db, mdb_ptr_t idxptr,\n425\t                                     mdb_ptr_t *nextptr) {\n426\t  if (fseek(db->fp_index, (long)idxptr, SEEK_SET) != 0) {\n427\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n428\t  }\n429\t  if (fread(nextptr, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n430\t    return mdb_status(MDB_ERR_READ, \"cannot read next ptr\");\n431\t  }\n432\t  return mdb_status(MDB_OK, NULL);\n433\t}\n434\t\n435\tstatic mdb_status_t mdb_read_data(mdb_int_t *db, mdb_ptr_t valptr,\n436\t                                  mdb_size_t valsize, char *valbuf,\n437\t                                  mdb_size_t bufsiz) {\n438\t  if (bufsiz < valsize + 1) {\n439\t    return mdb_status(MDB_ERR_BUFSIZ, \"value buffer size too small\");\n440\t  }\n441\t  if (fseek(db->fp_data, (long)valptr, SEEK_SET) != 0) {\n442\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to value\");\n443\t  }\n444\t  if (fread(valbuf, 1, valsize, db->fp_data) != valsize) {\n445\t    return mdb_status(MDB_ERR_READ, \"cannot read data\");\n446\t  }\n447\t  valbuf[valsize] = '\\0';\n448\t  return mdb_status(MDB_OK, NULL);\n449\t}\n450\t\n451\tstatic mdb_status_t mdb_write_nextptr(mdb_int_t *db, mdb_ptr_t ptr,\n452\t                                      mdb_ptr_t nextptr) {\n453\t  if (fseek(db->fp_index, (long)ptr, SEEK_SET) != 0) {\n454\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of index file\");\n455\t  }\n456\t  if (fwrite(&nextptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n457\t    return mdb_status(MDB_ERR_WRITE, \"cannot write to head of index file\");\n458\t  }\n459\t  if (fflush(db->fp_index) != 0) {\n460\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n461\t  }\n462\t  return mdb_status(MDB_OK, NULL);\n463\t}\n464\t\n465\tstatic mdb_status_t mdb_write_data(mdb_int_t *db, mdb_ptr_t valptr,\n466\t                                   const char *valbuf, mdb_size_t valsize) {\n467\t  if (fseek(db->fp_data, (long)valptr, SEEK_SET) != 0) {\n468\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to value\");\n469\t  }\n470\t  if (fwrite(valbuf, 1, valsize, db->fp_data) < valsize) {\n471\t    return mdb_status(MDB_ERR_WRITE, \"cannot write data\");\n472\t  }\n473\t  if (fflush(db->fp_data) != 0) {\n474\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n475\t  }\n476\t  return mdb_status(MDB_OK, NULL);\n477\t}\n478\t\n479\tstatic mdb_status_t mdb_stretch_index_file(mdb_int_t *db, mdb_ptr_t *ptr) {\n480\t  if (fseek(db->fp_index, 0, SEEK_END) != 0) {\n481\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to end of index file\");\n482\t  }\n483\t  *ptr = (mdb_ptr_t)ftell(db->fp_index);\n484\t\n485\t  unsigned char zero = '\\0';\n486\t  for (size_t i = 0; i < db->index_record_size; i++) {\n487\t    if (fwrite(&zero, 1, 1, db->fp_index) < 1) {\n488\t      return mdb_status(MDB_ERR_WRITE, \"cannot stretch index file\");\n489\t    }\n490\t  }\n491\t  if (fflush(db->fp_index) != 0) {\n492\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n493\t  }\n494\t  return mdb_status(MDB_OK, NULL);\n495\t}\n496\t\n497\tstatic mdb_status_t mdb_index_alloc(mdb_int_t *db, mdb_ptr_t *ptr) {\n498\t  mdb_ptr_t freeptr;\n499\t  mdb_status_t freeptr_read_status = mdb_read_nextptr(db, 0, &freeptr);\n500\t  STAT_CHECK_RET(freeptr_read_status, {;});\n501\t\n502\t  if (freeptr != 0) {\n503\t    mdb_ptr_t new_freeptr;\n504\t    mdb_status_t nextptr_read_stat =\n505\t        mdb_read_nextptr(db, freeptr, &new_freeptr);\n506\t    STAT_CHECK_RET(nextptr_read_stat, {;});\n507\t    mdb_status_t freeptr_update_stat = mdb_write_nextptr(db, 0, new_freeptr);\n508\t    STAT_CHECK_RET(freeptr_update_stat, {;});\n509\t    mdb_status_t freeptr_cleanup_stat = mdb_write_nextptr(db, freeptr, 0);\n510\t    STAT_CHECK_RET(freeptr_cleanup_stat, {;});\n511\t    *ptr = freeptr;\n512\t    return mdb_status(MDB_OK, NULL);\n513\t  } else {\n514\t    return mdb_stretch_index_file(db, ptr);\n515\t  }\n516\t}\n517\t\n518\tstatic mdb_status_t mdb_data_alloc(mdb_int_t *db, mdb_size_t valsize,\n519\t                                   mdb_ptr_t *ptr) {\n520\t  if (fseek(db->fp_data, 0, SEEK_SET) != 0) {\n521\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of data file\");\n522\t  }\n523\t  while (!feof(db->fp_data)) {\n524\t    uint8_t byte;\n525\t    if (fread(&byte, 1, 1, db->fp_data) != 1 && !feof(db->fp_data)) {\n526\t      return mdb_status(MDB_ERR_READ, \"cannot read data file\");\n527\t    }\n528\t    while (!feof(db->fp_data) && byte != '\\0') {\n529\t      if (fread(&byte, 1, 1, db->fp_data) != 1 && !feof(db->fp_data)) {\n530\t        return mdb_status(MDB_ERR_READ, \"cannot read data file\");\n531\t      }\n532\t    }\n533\t    \n534\t    mdb_ptr_t start_ptr = (mdb_ptr_t)ftell(db->fp_data);\n535\t    while (!feof(db->fp_data) && byte == '\\0') {\n536\t      if (fread(&byte, 1, 1, db->fp_data) != 1 && !feof(db->fp_data)) {\n537\t        return mdb_status(MDB_ERR_READ, \"cannot read data file\");\n538\t      }\n539\t    }\n540\t    mdb_ptr_t end_ptr = (mdb_ptr_t)ftell(db->fp_data);\n541\t\n542\t    /// @todo currently we rely on the extra padding to keep correct results.\n543\t    /// refactor and remove this padding sometime.\n544\t    if (end_ptr - start_ptr >= valsize + 2) {\n545\t      *ptr = start_ptr + 1;\n546\t      return mdb_status(MDB_OK, NULL);\n547\t    }\n548\t  }\n549\t\n550\t  mdb_ptr_t end_ptr = (mdb_ptr_t)ftell(db->fp_data);\n551\t  unsigned char zero = '\\0';\n552\t  for (size_t i = 0; i < valsize; i++) {\n553\t    if (fwrite(&zero, 1, 1, db->fp_data) < 1) {\n554\t      return mdb_status(MDB_ERR_WRITE, \"cannot stretch data file\");\n555\t    }\n556\t  }\n557\t  if (fflush(db->fp_data) != 0) {\n558\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n559\t  }\n560\t  *ptr = end_ptr;\n561\t  return mdb_status(MDB_OK, NULL);\n562\t}\n563\t\n564\tstatic mdb_status_t mdb_index_free(mdb_int_t *db, mdb_ptr_t ptr) {\n565\t  if (fseek(db->fp_index, 0, SEEK_SET) != 0) {\n566\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of index file\");\n567\t  }\n568\t  mdb_t freeptr;\n569\t  if (fread(&freeptr, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n570\t    return mdb_status(MDB_ERR_READ, \"cannot read free ptr\");\n571\t  }\n572\t\n573\t  if (fseek(db->fp_index, 0, SEEK_SET) != 0) {\n574\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of index file\");\n575\t  }\n576\t  if (fwrite(&ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n577\t    return mdb_status(MDB_ERR_WRITE, \"cannot write to head of index file\");\n578\t  }\n579\t\n580\t  if (fseek(db->fp_index, (long)ptr, SEEK_SET) != 0) {\n581\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n582\t  }\n583\t\n584\t  if (fwrite(&freeptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n585\t    return mdb_status(MDB_ERR_WRITE, \"cannot write to ptr\");\n586\t  }\n587\t\n588\t  for (size_t i = 0; i < db->options.key_size_max; i++) {\n589\t    char zero = '\\0';\n590\t    if (fwrite(&zero, 1, 1, db->fp_index) < 1) {\n591\t      return mdb_status(MDB_ERR_WRITE, \"cannot clean key part of index\");\n592\t    }\n593\t  }\n594\t\n595\t  if (fflush(db->fp_index) != 0) {\n596\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n597\t  }\n598\t\n599\t  return mdb_status(MDB_OK, NULL);\n600\t}\n601\t\n602\tstatic mdb_status_t mdb_data_free(mdb_int_t *db, mdb_ptr_t valptr,\n603\t                                  mdb_size_t valsize) {\n604\t  if (fseek(db->fp_data, (long)valptr, SEEK_SET)) {\n605\t    return mdb_status(MDB_ERR_SEEK, \"cannot seek to data record\");\n606\t  }\n607\t  uint8_t zero = '\\0';\n608\t  for (size_t i = 0; i < valsize; i++) {\n609\t    if (fwrite(&zero, 1, 1, db->fp_data) != 1) {\n610\t      return mdb_status(MDB_ERR_WRITE, \"cannot write empty data\");\n611\t    }\n612\t  }\n613\t  if (fflush(db->fp_data) != 0) {\n614\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n615\t  }\n616\t  return mdb_status(MDB_OK, NULL);\n617\t}\n618\t\n619\tstatic mdb_status_t mdb_status(uint8_t code, const char *desc) {\n620\t  mdb_status_t s;\n621\t  s.code = code;\n622\t  s.desc = desc;\n623\t  return s;\n624\t}\n625\t\n626\tstatic mdb_int_t *mdb_alloc() {\n627\t  mdb_int_t *ret = (mdb_int_t*)malloc(sizeof(mdb_int_t));\n628\t  if (!ret) {\n629\t    return NULL;\n630\t  }\n631\t  ret->db_name = (char*)malloc(DB_NAME_MAX + 1);\n632\t  if (!ret->db_name) {\n633\t    free(ret);\n634\t    return NULL;\n635\t  }\n636\t  ret->options.db_name = ret->db_name;\n637\t  return ret;\n638\t}\n639\t\n640\tstatic void mdb_free(mdb_int_t *db) {\n641\t  if (db->fp_superblock != NULL) {\n642\t    fclose(db->fp_superblock);\n643\t  }\n644\t  if (db->fp_index != NULL) {\n645\t    fclose(db->fp_index);\n646\t  }\n647\t  if (db->fp_data != NULL) {\n648\t    fclose(db->fp_data);\n649\t  }\n650\t  free(db->db_name);\n651\t  free(db);\n652\t}\n653\t\n654\tstatic uint32_t mdb_hash(const char *key) {\n655\t  uint32_t ret = 0;\n656\t  for (uint32_t i = 0; *key != '\\0'; ++key, ++i) {\n657\t    ret += (uint32_t)*key * i;\n658\t  }\n659\t  return ret;\n660\t}\n661\t\n662\tvoid mdb_close(mdb_t handle) {\n663\t  mdb_int_t *db = (mdb_int_t*)handle;\n664\t  fclose(db->fp_superblock);\n665\t  fclose(db->fp_index);\n666\t  fclose(db->fp_data);\n667\t  free(db->db_name);\n668\t  free(db);\n669\t}\n670\t"}]},"parent_tool_use_id":null,"session_id":"db98e599-fc61-43bb-821d-a39cb2e4b759","uuid":"7ce4b558-90be-4941-b027-a2d4f5479f78","timestamp":"2026-06-06T03:50:43.234Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-e9KRBy/project/c_src/mdb.c","content":"#include \"mdb.h\"\n\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <inttypes.h>\n\n#include <errno.h>\n\ntypedef uint32_t mdb_size_t;\ntypedef uint32_t mdb_ptr_t;\n\nenum {\n  MDB_PTR_SIZE = sizeof(mdb_ptr_t),\n  MDB_DATALEN_SIZE = sizeof(mdb_size_t)\n};\n\ntypedef struct {\n  char *db_name;\n\n  FILE *fp_superblock;\n  FILE *fp_index;\n  FILE *fp_data;\n\n  mdb_options_t options;\n\n  uint32_t index_record_size;\n} mdb_int_t;\n\ntypedef struct {\n  mdb_ptr_t next_ptr;\n  mdb_ptr_t value_ptr;\n  mdb_size_t value_size;\n  char key[0];\n} mdb_index_t;\n\nstatic mdb_status_t mdb_status(uint8_t code, const char *desc);\nstatic mdb_int_t *mdb_alloc(void);\nstatic void mdb_free(mdb_int_t *db);\nstatic uint32_t mdb_hash(const char *key);\n\nstatic mdb_status_t mdb_read_bucket(mdb_int_t *db, uint32_t bucket,\n                                    mdb_ptr_t *ptr);\nstatic mdb_status_t mdb_read_index(mdb_int_t *db, mdb_ptr_t idxptr,\n                                   mdb_index_t *index);\nstatic mdb_status_t mdb_write_bucket(mdb_int_t *db, mdb_ptr_t bucket,\n                                     mdb_ptr_t value);\nstatic mdb_status_t mdb_write_index(mdb_int_t *db, mdb_ptr_t idxptr,\n                                    const char *keybuf, mdb_ptr_t valptr,\n                                    mdb_size_t valsize);\nstatic mdb_status_t mdb_read_data(mdb_int_t *db, mdb_ptr_t valptr,\n                                  mdb_size_t valsize, char *valbuf,\n                                  mdb_size_t bufsiz);\nstatic mdb_status_t mdb_write_data(mdb_int_t *db, mdb_ptr_t valptr,\n                                   const char *valbuf, mdb_size_t valsize);\nstatic mdb_status_t mdb_read_nextptr(mdb_int_t *db, mdb_ptr_t idxptr,\n                                     mdb_ptr_t *nextptr);\nstatic mdb_status_t mdb_write_nextptr(mdb_int_t *db, mdb_ptr_t ptr,\n                                      mdb_ptr_t nextptr);\nstatic mdb_status_t mdb_stretch_index_file(mdb_int_t *db, mdb_ptr_t *ptr);\nstatic mdb_status_t mdb_index_alloc(mdb_int_t *db, mdb_ptr_t *ptr);\nstatic mdb_status_t mdb_data_alloc(mdb_int_t *db, mdb_size_t valsize,\n                                   mdb_ptr_t *ptr);\nstatic mdb_status_t mdb_index_free(mdb_int_t *db, mdb_ptr_t ptr);\nstatic mdb_status_t mdb_data_free(mdb_int_t *db, mdb_ptr_t valptr,\n                                  mdb_size_t valsize);\n\nstatic char pathbuf[4096];\n\nmdb_status_t mdb_open(mdb_t *handle, const char *path) {\n  mdb_int_t *db = mdb_alloc();\n  if (db == NULL) {\n    return mdb_status(MDB_ERR_ALLOC,\n                      \"failed allocating memory buffer for database\");\n  }\n\n  strcpy(pathbuf, path);\n  strcat(pathbuf, \".db.super\");\n  db->fp_superblock = fopen(pathbuf, \"r\");\n  if (db->fp_superblock == NULL) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open superblock file as read\");\n  }\n\n  fscanf(db->fp_superblock, \"%s\", db->db_name);\n  fscanf(db->fp_superblock, \"%hu\", &(db->options.key_size_max));\n  fscanf(db->fp_superblock, \"%u\", &(db->options.data_size_max));\n  fscanf(db->fp_superblock, \"%u\", &(db->options.hash_buckets));\n  fscanf(db->fp_superblock, \"%u\", &(db->options.items_max));\n\n  db->index_record_size = db->options.key_size_max\n                          + MDB_PTR_SIZE * 2\n                          + MDB_DATALEN_SIZE;\n\n  if (ferror(db->fp_superblock)) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_READ, \"read error when parsing superblock\");\n  }\n\n  strcpy(pathbuf, path);\n  strcat(pathbuf, \".db.index\");\n  db->fp_index = fopen(pathbuf, \"rb+\");\n  if (db->fp_index == NULL) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open index file as readwrite\");\n  }\n\n  strcpy(pathbuf, path);\n  strcat(pathbuf, \".db.data\");\n  db->fp_data = fopen(pathbuf, \"rb+\");\n  if (db->fp_data == NULL) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open data file as readwrite\");\n  }\n\n  if (fflush(NULL) != 0) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n\n  *handle = (mdb_t)db;\n  return mdb_status(MDB_OK, NULL);\n}\n\nmdb_status_t mdb_create(mdb_t *handle, mdb_options_t options) {\n  mdb_int_t *db = mdb_alloc();\n  if (db == NULL) {\n    return mdb_status(MDB_ERR_ALLOC,\n                      \"failed allocating memory buffer for database\");\n  }\n\n  strcpy(db->options.db_name, options.db_name);\n  db->options.items_max = options.items_max;\n  db->options.hash_buckets = options.hash_buckets;\n  db->options.key_size_max = options.key_size_max;\n  db->options.data_size_max = options.data_size_max;\n\n  db->index_record_size = db->options.key_size_max\n                          + MDB_PTR_SIZE * 2\n                          + MDB_DATALEN_SIZE;\n\n  strcpy(pathbuf, options.db_name);\n  strcat(pathbuf, \".db.super\");\n  db->fp_superblock = fopen(pathbuf, \"w\");\n  if (db->fp_superblock == NULL) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_OPEN_FILE,\n                      \"cannot open superblock file as write\");\n  }\n\n  fprintf(db->fp_superblock, \"%s\\n\", db->db_name);\n  fprintf(db->fp_superblock, \"%hu\\n\", db->options.key_size_max);\n  fprintf(db->fp_superblock, \"%u\\n\", db->options.data_size_max);\n  fprintf(db->fp_superblock, \"%u\\n\", db->options.hash_buckets);\n  fprintf(db->fp_superblock, \"%u\\n\", db->options.items_max);\n\n  if (ferror(db->fp_superblock)) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_WRITE, \"write error when writing superblock\");\n  }\n\n  strcpy(pathbuf, options.db_name);\n  strcat(pathbuf, \".db.index\");\n  db->fp_index = fopen(pathbuf, \"wb+\");\n  if (db->fp_index == NULL) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open index file as readwrite\");\n  }\n\n  mdb_ptr_t zero_ptr = 0;\n  if (fwrite(&zero_ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_WRITE, \"write error when writing freeptr\");\n  }\n  for (size_t i = 0; i < options.hash_buckets; i++) {\n    if (fwrite(&zero_ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n      mdb_free(db);\n      return mdb_status(MDB_ERR_WRITE, \"write error when writing hash buckets\");\n    }\n  }\n\n  strcpy(pathbuf, options.db_name);\n  strcat(pathbuf, \".db.data\");\n  db->fp_data = fopen(pathbuf, \"wb+\");\n  if (db->fp_data == NULL) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open data file as readwrite\");\n  }\n\n  if (fflush(NULL) != 0) {\n    mdb_free(db);\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n\n  *handle = (mdb_t)db;\n  return mdb_status(MDB_OK, NULL);\n}\n\nmdb_status_t mdb_read(mdb_t handle, const char *key, char *buf, size_t bufsiz) {\n  mdb_int_t *db = (mdb_int_t*)handle;\n  mdb_size_t bucket = mdb_hash(key) % db->options.hash_buckets;\n\n  mdb_ptr_t ptr;\n  mdb_status_t bucket_read_status = mdb_read_bucket(db, bucket, &ptr);\n  STAT_CHECK_RET(bucket_read_status, {;});\n\n  mdb_index_t *index =\n      alloca(sizeof(mdb_index_t) + db->options.key_size_max + 1);\n\n  while (ptr != 0) {\n    mdb_status_t read_status = mdb_read_index(db, ptr, index);\n    STAT_CHECK_RET(read_status, {;});\n    if (strcmp(index->key, key) == 0) {\n      return mdb_read_data(db, index->value_ptr, index->value_size, buf,\n                           bufsiz);\n    }\n    ptr = index->next_ptr;\n  }\n\n  return mdb_status(MDB_NO_KEY, \"Key not found\");\n}\n\nmdb_status_t mdb_write(mdb_t handle, const char *key, const char *value) {\n  mdb_int_t *db = (mdb_int_t*)handle;\n  mdb_size_t bucket = mdb_hash(key) % db->options.hash_buckets;\n  mdb_size_t key_size = strlen(key);\n  if (key_size > db->options.key_size_max) {\n    return mdb_status(MDB_ERR_KEY_SIZE, \"key size too large\");\n  }\n  mdb_size_t value_size = strlen(value);\n  if (value_size > db->options.data_size_max) {\n    return mdb_status(MDB_ERR_VALUE_SIZE, \"value size too large\");\n  }\n\n  mdb_ptr_t save_ptr = MDB_PTR_SIZE * (bucket + 1);\n  mdb_ptr_t ptr;\n  mdb_status_t bucket_read_status = mdb_read_bucket(db, bucket, &ptr);\n  STAT_CHECK_RET(bucket_read_status, {;});\n\n  mdb_index_t *index = alloca(sizeof(mdb_index_t)\n                              + db->options.key_size_max + 1);\n  while (ptr != 0) {\n    mdb_status_t index_read_status = mdb_read_index(db, ptr, index);\n    STAT_CHECK_RET(index_read_status, {;});\n    if (strcmp(index->key, key) == 0) {\n      break;\n    }\n    save_ptr = ptr;\n    ptr = index->next_ptr;\n  }\n\n  if (ptr == 0) {\n    mdb_ptr_t index_ptr;\n    mdb_status_t index_alloc_status = mdb_index_alloc(db, &index_ptr);\n    STAT_CHECK_RET(index_alloc_status, {;});\n    mdb_ptr_t value_ptr;\n    mdb_status_t data_alloc_status = mdb_data_alloc(db, value_size, &value_ptr);\n    STAT_CHECK_RET(data_alloc_status, {\n                     (void)mdb_index_free(db, index_ptr);\n                   });\n    mdb_status_t data_write_status = mdb_write_data(db, value_ptr, value,\n                                                    value_size);\n    STAT_CHECK_RET(data_write_status, {\n                     (void)mdb_data_free(db, value_ptr, value_size);\n                     (void)mdb_index_free(db, index_ptr);\n                   });\n    mdb_status_t index_write_status = mdb_write_index(db, index_ptr, key,\n                                                      value_ptr, value_size);\n    STAT_CHECK_RET(index_write_status, {\n                     (void)mdb_data_free(db, value_ptr, value_size);\n                     (void)mdb_index_free(db, index_ptr);\n                   });\n    mdb_status_t ptr_update_status = mdb_write_nextptr(db, save_ptr, index_ptr);\n    STAT_CHECK_RET(ptr_update_status, {\n                     (void)mdb_data_free(db, value_ptr, value_size);\n                     (void)mdb_index_free(db, index_ptr);\n                   });\n    return mdb_status(MDB_OK, NULL);\n  } else {\n    /// @todo errors are only handled roughly here, needs refinement\n    mdb_status_t data_free_status = mdb_data_free(db, index->value_ptr,\n                                                  index->value_size);\n    STAT_CHECK_RET(data_free_status, {;});\n    mdb_ptr_t value_ptr;\n    mdb_status_t data_alloc_status = mdb_data_alloc(db, value_size, &value_ptr);\n    STAT_CHECK_RET(data_alloc_status, {;});\n    mdb_status_t data_write_status = mdb_write_data(db, value_ptr, value,\n                                                    value_size);\n    STAT_CHECK_RET(data_write_status, {;});\n    mdb_status_t index_write_status = mdb_write_index(db, ptr, key, value_ptr,\n                                                      value_size);\n    STAT_CHECK_RET(index_write_status, {;});\n    return mdb_status(MDB_OK, NULL);\n  }\n}\n\nmdb_status_t mdb_delete(mdb_t handle, const char *key) {\n  mdb_int_t *db = (mdb_int_t*)handle;\n  mdb_size_t bucket = mdb_hash(key) % db->options.hash_buckets;\n\n  mdb_ptr_t save_ptr = MDB_PTR_SIZE * (bucket + 1);\n  mdb_ptr_t ptr;\n  mdb_status_t bucket_read_status = mdb_read_bucket(db, bucket, &ptr);\n  STAT_CHECK_RET(bucket_read_status, {;});\n\n  mdb_index_t *index = alloca(sizeof(mdb_index_t)\n                              + db->options.key_size_max + 1);\n  while (ptr != 0) {\n    mdb_status_t index_read_status = mdb_read_index(db, ptr, index);\n    STAT_CHECK_RET(index_read_status, {;});\n    if (strcmp(index->key, key) == 0) {\n      break;\n    }\n    save_ptr = ptr;\n    ptr = index->next_ptr;\n  }\n\n  if (ptr == 0) {\n    return mdb_status(MDB_NO_KEY, NULL);\n  }\n\n  mdb_status_t data_free_status = mdb_data_free(db, index->value_ptr,\n                                                index->value_size);\n  STAT_CHECK_RET(data_free_status, {;});\n  mdb_status_t index_free_status = mdb_index_free(db, ptr);\n  STAT_CHECK_RET(index_free_status, {;});\n  mdb_status_t nextptr_update_status = mdb_write_nextptr(db, save_ptr,\n                                                         index->next_ptr);\n  STAT_CHECK_RET(nextptr_update_status, {;});\n\n  return mdb_status(MDB_OK, NULL);\n}\n\nmdb_options_t mdb_get_options(mdb_t handle) {\n  mdb_int_t *db = (mdb_int_t*)handle;\n  return db->options;\n}\n\nsize_t mdb_index_size(mdb_t *handle) {\n  mdb_int_t *db = (mdb_int_t*)handle;\n  (void)fseek(db->fp_index, 0, SEEK_END);\n  return ftell(db->fp_index);\n}\n\nsize_t mdb_data_size(mdb_t *handle) {\n  mdb_int_t *db = (mdb_int_t*)handle;\n  (void)fseek(db->fp_data, 0, SEEK_END);\n  return ftell(db->fp_data);\n}\n\nstatic mdb_status_t mdb_read_bucket(mdb_int_t *db, uint32_t bucket,\n                                    mdb_ptr_t *ptr) {\n  if (fseek(db->fp_index, (long)(MDB_PTR_SIZE * (bucket + 1)), SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to bucket\");\n  }\n  if (fread(ptr, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n    return mdb_status(MDB_ERR_READ, \"cannot read bucket\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_read_index(mdb_int_t *db, mdb_ptr_t idxptr,\n                                   mdb_index_t *index) {\n  if (fseek(db->fp_index, (long)idxptr, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n  }\n  if (fread(&(index->next_ptr), MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n    return mdb_status(MDB_ERR_READ, \"cannot read next ptr\");\n  }\n  if (fread(index->key, 1, db->options.key_size_max, db->fp_index)\n      != db->options.key_size_max) {\n    return mdb_status(MDB_ERR_READ, \"cannot read key\");\n  }\n  index->key[db->options.key_size_max] = '\\0';\n  if (fread(&(index->value_ptr), MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n    return mdb_status(MDB_ERR_READ, \"cannot read value ptr\");\n  }\n  if (fread(&(index->value_size), MDB_DATALEN_SIZE, 1, db->fp_index) != 1) {\n    return mdb_status(MDB_ERR_READ, \"cannot read value length\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_write_bucket(mdb_int_t *db, mdb_ptr_t bucket,\n                                     mdb_ptr_t value) {\n  if (fseek(db->fp_index, (long)(MDB_PTR_SIZE * (bucket + 1)), SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to bucket\");\n  }\n  if (fwrite(&value, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write bucket\");\n  }\n  if (fflush(db->fp_index) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_write_index(mdb_int_t *db, mdb_ptr_t idxptr,\n                                    const char *keybuf, mdb_ptr_t valptr,\n                                    mdb_size_t valsize) {\n  if (fseek(db->fp_index, (long)(idxptr + MDB_PTR_SIZE), SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n  }\n  size_t key_len = strlen(keybuf);\n  if (fwrite(keybuf, 1, key_len, db->fp_index) < key_len) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write key part of index\");\n  }\n  size_t value_ptr_pos = idxptr + MDB_PTR_SIZE + db->options.key_size_max;\n  if (fseek(db->fp_index, (long)value_ptr_pos, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to value part of index\");\n  }\n  if (fwrite(&valptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write to value part of index\");\n  }\n  if (fwrite(&valsize, MDB_DATALEN_SIZE, 1, db->fp_index) < 1) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write to value part of index\");\n  }\n  if (fflush(db->fp_index) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_read_nextptr(mdb_int_t *db, mdb_ptr_t idxptr,\n                                     mdb_ptr_t *nextptr) {\n  if (fseek(db->fp_index, (long)idxptr, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n  }\n  if (fread(nextptr, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n    return mdb_status(MDB_ERR_READ, \"cannot read next ptr\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_read_data(mdb_int_t *db, mdb_ptr_t valptr,\n                                  mdb_size_t valsize, char *valbuf,\n                                  mdb_size_t bufsiz) {\n  if (bufsiz < valsize + 1) {\n    return mdb_status(MDB_ERR_BUFSIZ, \"value buffer size too small\");\n  }\n  if (fseek(db->fp_data, (long)valptr, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to value\");\n  }\n  if (fread(valbuf, 1, valsize, db->fp_data) != valsize) {\n    return mdb_status(MDB_ERR_READ, \"cannot read data\");\n  }\n  valbuf[valsize] = '\\0';\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_write_nextptr(mdb_int_t *db, mdb_ptr_t ptr,\n                                      mdb_ptr_t nextptr) {\n  if (fseek(db->fp_index, (long)ptr, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of index file\");\n  }\n  if (fwrite(&nextptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write to head of index file\");\n  }\n  if (fflush(db->fp_index) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_write_data(mdb_int_t *db, mdb_ptr_t valptr,\n                                   const char *valbuf, mdb_size_t valsize) {\n  if (fseek(db->fp_data, (long)valptr, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to value\");\n  }\n  if (fwrite(valbuf, 1, valsize, db->fp_data) < valsize) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write data\");\n  }\n  if (fflush(db->fp_data) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_stretch_index_file(mdb_int_t *db, mdb_ptr_t *ptr) {\n  if (fseek(db->fp_index, 0, SEEK_END) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to end of index file\");\n  }\n  *ptr = (mdb_ptr_t)ftell(db->fp_index);\n\n  unsigned char zero = '\\0';\n  for (size_t i = 0; i < db->index_record_size; i++) {\n    if (fwrite(&zero, 1, 1, db->fp_index) < 1) {\n      return mdb_status(MDB_ERR_WRITE, \"cannot stretch index file\");\n    }\n  }\n  if (fflush(db->fp_index) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_index_alloc(mdb_int_t *db, mdb_ptr_t *ptr) {\n  mdb_ptr_t freeptr;\n  mdb_status_t freeptr_read_status = mdb_read_nextptr(db, 0, &freeptr);\n  STAT_CHECK_RET(freeptr_read_status, {;});\n\n  if (freeptr != 0) {\n    mdb_ptr_t new_freeptr;\n    mdb_status_t nextptr_read_stat =\n        mdb_read_nextptr(db, freeptr, &new_freeptr);\n    STAT_CHECK_RET(nextptr_read_stat, {;});\n    mdb_status_t freeptr_update_stat = mdb_write_nextptr(db, 0, new_freeptr);\n    STAT_CHECK_RET(freeptr_update_stat, {;});\n    mdb_status_t freeptr_cleanup_stat = mdb_write_nextptr(db, freeptr, 0);\n    STAT_CHECK_RET(freeptr_cleanup_stat, {;});\n    *ptr = freeptr;\n    return mdb_status(MDB_OK, NULL);\n  } else {\n    return mdb_stretch_index_file(db, ptr);\n  }\n}\n\nstatic mdb_status_t mdb_data_alloc(mdb_int_t *db, mdb_size_t valsize,\n                                   mdb_ptr_t *ptr) {\n  if (fseek(db->fp_data, 0, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of data file\");\n  }\n  while (!feof(db->fp_data)) {\n    uint8_t byte;\n    if (fread(&byte, 1, 1, db->fp_data) != 1 && !feof(db->fp_data)) {\n      return mdb_status(MDB_ERR_READ, \"cannot read data file\");\n    }\n    while (!feof(db->fp_data) && byte != '\\0') {\n      if (fread(&byte, 1, 1, db->fp_data) != 1 && !feof(db->fp_data)) {\n        return mdb_status(MDB_ERR_READ, \"cannot read data file\");\n      }\n    }\n    \n    mdb_ptr_t start_ptr = (mdb_ptr_t)ftell(db->fp_data);\n    while (!feof(db->fp_data) && byte == '\\0') {\n      if (fread(&byte, 1, 1, db->fp_data) != 1 && !feof(db->fp_data)) {\n        return mdb_status(MDB_ERR_READ, \"cannot read data file\");\n      }\n    }\n    mdb_ptr_t end_ptr = (mdb_ptr_t)ftell(db->fp_data);\n\n    /// @todo currently we rely on the extra padding to keep correct results.\n    /// refactor and remove this padding sometime.\n    if (end_ptr - start_ptr >= valsize + 2) {\n      *ptr = start_ptr + 1;\n      return mdb_status(MDB_OK, NULL);\n    }\n  }\n\n  mdb_ptr_t end_ptr = (mdb_ptr_t)ftell(db->fp_data);\n  unsigned char zero = '\\0';\n  for (size_t i = 0; i < valsize; i++) {\n    if (fwrite(&zero, 1, 1, db->fp_data) < 1) {\n      return mdb_status(MDB_ERR_WRITE, \"cannot stretch data file\");\n    }\n  }\n  if (fflush(db->fp_data) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n  *ptr = end_ptr;\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_index_free(mdb_int_t *db, mdb_ptr_t ptr) {\n  if (fseek(db->fp_index, 0, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of index file\");\n  }\n  mdb_t freeptr;\n  if (fread(&freeptr, MDB_PTR_SIZE, 1, db->fp_index) != 1) {\n    return mdb_status(MDB_ERR_READ, \"cannot read free ptr\");\n  }\n\n  if (fseek(db->fp_index, 0, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to head of index file\");\n  }\n  if (fwrite(&ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write to head of index file\");\n  }\n\n  if (fseek(db->fp_index, (long)ptr, SEEK_SET) != 0) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to ptr\");\n  }\n\n  if (fwrite(&freeptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n    return mdb_status(MDB_ERR_WRITE, \"cannot write to ptr\");\n  }\n\n  for (size_t i = 0; i < db->options.key_size_max; i++) {\n    char zero = '\\0';\n    if (fwrite(&zero, 1, 1, db->fp_index) < 1) {\n      return mdb_status(MDB_ERR_WRITE, \"cannot clean key part of index\");\n    }\n  }\n\n  if (fflush(db->fp_index) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_data_free(mdb_int_t *db, mdb_ptr_t valptr,\n                                  mdb_size_t valsize) {\n  if (fseek(db->fp_data, (long)valptr, SEEK_SET)) {\n    return mdb_status(MDB_ERR_SEEK, \"cannot seek to data record\");\n  }\n  uint8_t zero = '\\0';\n  for (size_t i = 0; i < valsize; i++) {\n    if (fwrite(&zero, 1, 1, db->fp_data) != 1) {\n      return mdb_status(MDB_ERR_WRITE, \"cannot write empty data\");\n    }\n  }\n  if (fflush(db->fp_data) != 0) {\n    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n  }\n  return mdb_status(MDB_OK, NULL);\n}\n\nstatic mdb_status_t mdb_status(uint8_t code, const char *desc) {\n  mdb_status_t s;\n  s.code = code;\n  s.desc = desc;\n  return s;\n}\n\nstatic mdb_int_t *mdb_alloc() {\n  mdb_int_t *ret = (mdb_int_t*)malloc(sizeof(mdb_int_t));\n  if (!ret) {\n    return NULL;\n  }\n  ret->db_name = (char*)malloc(DB_NAME_MAX + 1);\n  if (!ret->db_name) {\n    free(ret);\n    return NULL;\n  }\n  ret->options.db_name = ret->db_name;\n  return ret;\n}\n\nstatic void mdb_free(mdb_int_t *db) {\n  if (db->fp_superblock != NULL) {\n    fclose(db->fp_superblock);\n  }\n  if (db->fp_index != NULL) {\n    fclose(db->fp_index);\n  }\n  if (db->fp_data != NULL) {\n    fclose(db->fp_data);\n  }\n  free(db->db_name);\n  free(db);\n}\n\nstatic uint32_t mdb_hash(const char *key) {\n  uint32_t ret = 0;\n  for (uint32_t i = 0; *key != '\\0'; ++key, ++i) {\n    ret += (uint32_t)*key * i;\n  }\n  return ret;\n}\n\nvoid mdb_close(mdb_t handle) {\n  mdb_int_t *db = (mdb_int_t*)handle;\n  fclose(db->fp_superblock);\n  fclose(db->fp_index);\n  fclose(db->fp_data);\n  free(db->db_name);\n  free(db);\n}\n","numLines":670,"startLine":1,"totalLines":670}}}
