{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_ky2hup3bq75dspmv5qn255eh7t2e2iwe42ihaz7pinaqadxzr53a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_014vd2H5SBSMX6RRLbcbdSdp","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-gRP5rs/project/src/closed_syncmers.rs","content":"// Import necessary modules\nuse std::collections::HashMap;\n// Struct Definitions\n#[derive(Debug, Clone)]\npub struct MinimizerResult {\n    pub minimizer_hash: u128,\n    pub kmer_position: usize,\n    pub smer_position: usize,\n}\n// Function Declarations\npub fn compute_closed_syncmers(sequence_input: &str, len: i32, k: i32, s: i32, results: &mut Vec<MinimizerResult>, num_results: &mut i32) {\n    *num_results = 0;\n    results.clear();\n\n    if len < k {\n        eprintln!(\"Sequence length is less than K\");\n        return;\n    }\n\n    if s <= 0 || k <= 0 || len <= 0 {\n        return;\n    }\n\n    let len_us = len as usize;\n    let k_us = k as usize;\n    let s_us = s as usize;\n    let bytes = sequence_input.as_bytes();\n\n    if bytes.len() < len_us {\n        // Defensive: if input is shorter than reported length, clamp.\n        return;\n    }\n\n    let num_s_mers = len_us - s_us + 1;\n    let mut s_mer_hashes: Vec<u128> = vec![0u128; num_s_mers];\n\n    // Precompute all s-mer hashes.\n    let mask: u128 = if 2 * s_us >= 128 {\n        u128::MAX\n    } else {\n        (1u128 << (2 * s_us)) - 1\n    };\n    let mut hash_fwd: u128 = 0;\n    let mut hash_rev: u128 = 0;\n    let rc_shift: u32 = (2 * (s_us - 1)) as u32;\n\n    for i in 0..len_us {\n        let base = base_to_bits(bytes[i] as char);\n        hash_fwd = ((hash_fwd << 2) | base as u128) & mask;\n        let comp_base = complement_base(base);\n        hash_rev = ((hash_rev >> 2) | ((comp_base as u128) << rc_shift)) & mask;\n        if i + 1 >= s_us {\n            let s_mer_pos = i - s_us + 1;\n            let canonical_hash = if hash_fwd < hash_rev { hash_fwd } else { hash_rev };\n            s_mer_hashes[s_mer_pos] = canonical_hash;\n        }\n    }\n\n    // Initialize deque to find minimal s-mers in O(N).\n    let window_size = k_us - s_us + 1;\n    let mut deque: Vec<usize> = vec![0usize; num_s_mers];\n    let mut front: usize = 0;\n    let mut back: usize = 0;\n\n    for i in 0..num_s_mers {\n        while back > front && s_mer_hashes[deque[back - 1]] > s_mer_hashes[i] {\n            back -= 1;\n        }\n        deque[back] = i;\n        back += 1;\n        if i >= window_size && deque[front] + window_size <= i {\n            front += 1;\n        }\n\n        // Check for closed syncmer condition.\n        if i + 1 >= window_size {\n            let min_pos = deque[front];\n            let kmer_pos = i - window_size + 1;\n            if min_pos == kmer_pos || min_pos == kmer_pos + k_us - s_us {\n                add_minimizer(results, num_results, s_mer_hashes[min_pos], kmer_pos, min_pos);\n            }\n        }\n    }\n\n    // Suppress unused import warning when HashMap isn't otherwise referenced.\n    let _ = std::marker::PhantomData::<HashMap<u8, u8>>;\n}\n\npub fn base_to_bits(base: char) -> u8 {\n    match base {\n        'A' | 'a' => 0,\n        'C' | 'c' => 1,\n        'G' | 'g' => 2,\n        'T' | 't' => 3,\n        _ => 0, // Treat unknown as 'A'\n    }\n}\n\npub fn complement_base(base: u8) -> u8 {\n    3u8.wrapping_sub(base)\n}\n\npub fn add_minimizer(results: &mut Vec<MinimizerResult>, size: &mut i32, minimizer_hash: u128, kmer_position: usize, smer_position: usize) {\n    let entry = MinimizerResult {\n        minimizer_hash,\n        kmer_position,\n        smer_position,\n    };\n    let idx = if *size < 0 { 0usize } else { *size as usize };\n    if idx < results.len() {\n        results[idx] = entry;\n    } else {\n        results.push(entry);\n    }\n    *size += 1;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creat