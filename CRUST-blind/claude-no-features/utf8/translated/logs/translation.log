{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Avqwo7FEn3Fn99cy3EoU5V","type":"tool_result","content":"1\t/**\n2\t * @file utf8.h\n3\t * @brief simple library for working with UTF-8 encoded strings\n4\t *\n5\t * @code\n6\t * #include \"utf8.h\"\n7\t * #include <stdio.h>\n8\t *\n9\t * int main() {\n10\t *     const char* str = \"Hello, こんにちは, Здравствуйте\";\n11\t *     utf8_string ustr = make_utf8_string(str);\n12\t *     utf8_string_slice slice = make_utf8_string_slice(ustr, 2, 11);\n13\t *     utf8_char_iter iter = make_utf8_char_iter(ustr);\n14\t *\n15\t *     printf(\"string: %s\\n\", ustr.str);\n16\t *     printf(\"slice: %.*s\\n\", (int)slice.byte_len, slice.str);\n17\t *\n18\t *     utf8_char ch;\n19\t *     while ((ch = next_utf8_char(&iter)).byte_len > 0) {\n20\t *         printf(\"character: %.*s\\t\", (int)ch.byte_len, ch.str);\n21\t *         printf(\"unicode code point: U+%04X\\n\", unicode_code_point(ch));\n22\t *     }\n23\t *\n24\t *     return 0;\n25\t * }\n26\t * @endcode\n27\t */\n28\t\n29\t#ifndef ZAHASH_UTF8_H\n30\t#define ZAHASH_UTF8_H\n31\t\n32\t#include <stdbool.h>\n33\t#include <stddef.h>\n34\t#include <stdint.h>\n35\t\n36\t/**\n37\t * @brief Represents the validity of a UTF-8 encoded string.\n38\t *\n39\t * @details The `utf8_validity` struct indicates whether a given UTF-8 encoded string is valid or not,\n40\t * along with the position up to which it is valid.\n41\t *\n42\t * - Invalid case: \"hello\\xC0\\xC0\" => { .valid = false, .valid_upto = 5  }\n43\t * - Valid case:   \"hello world\"   => { .valid = true,  .valid_upto = 11 }\n44\t */\n45\ttypedef struct {\n46\t    bool valid;          ///< Flag indicating the validity of the UTF-8 string.\n47\t    size_t valid_upto;   ///< The position up to which the string is valid.\n48\t} utf8_validity;\n49\t\n50\t/**\n51\t * @brief Represents a non-owning UTF-8 encoded string. (just a wrapper type).\n52\t *\n53\t * @details The `utf8_string` struct holds a pointer to a UTF-8 encoded string along with its byte length,\n54\t */\n55\ttypedef struct {\n56\t    const char* str;     ///< Pointer to the UTF-8 encoded string.\n57\t    size_t byte_len;     ///< Byte length of the UTF-8 string ('\\0' not counted).\n58\t} utf8_string;\n59\t\n60\t/**\n61\t * @brief Represents a UTF-8 encoded string that fully owns its data.\n62\t *\n63\t * @details The `owned_utf8_string` struct holds a pointer to a UTF-8 encoded string that is dynamically allocated\n64\t *          and therefore is owned by the struct, which means the caller is responsible for freeing the memory when\n65\t *          it is no longer needed using the `free_owned_utf8_string` function.\n66\t */\n67\ttypedef struct {\n68\t    char* str;          ///< Pointer to the UTF-8 encoded string (owned). This memory is dynamically allocated.\n69\t    size_t byte_len;    ///< Byte length of the UTF-8 string ('\\0' not counted).\n70\t} owned_utf8_string;\n71\t\n72\t/**\n73\t * @brief Represents an iterator for traversing UTF-8 characters in a string.\n74\t *\n75\t * @details The `utf8_char_iter` struct serves as an iterator for traversing UTF-8 characters\n76\t * within a UTF-8 encoded string.\n77\t */\n78\ttypedef struct {\n79\t    const char* str;     ///< Pointer to the current position of the iterator.\n80\t} utf8_char_iter;\n81\t\n82\t/**\n83\t * @brief Represents a UTF-8 character.\n84\t *\n85\t * @details The `utf8_char` struct encapsulates a UTF-8 character, including its pointer and byte length.\n86\t * The byte length represents the number of bytes occupied by the UTF-8 character.\n87\t */\n88\ttypedef struct {\n89\t    const char* str;     ///< Pointer to the UTF-8 character.\n90\t    uint8_t byte_len;    ///< Byte length of the UTF-8 character.\n91\t} utf8_char;\n92\t\n93\t/**\n94\t * @brief Validates whether a given string is UTF-8 compliant in O(n) time.\n95\t *\n96\t * @param str The input string to validate.\n97\t * @return The validity of the UTF-8 string along with the position up to which it is valid.\n98\t */\n99\tutf8_validity validate_utf8(const char* str);\n100\t\n101\t/**\n102\t * @brief Wraps a C-style string in a UTF-8 string structure after verifying its UTF-8 compliance.\n103\t *\n104\t * @param str The input C-style string to wrap.\n105\t * @return A UTF-8 string structure containing the wrapped string if valid; otherwise, a structure with NULL string pointer.\n106\t *\n107\t * @code\n108\t * // Example usage:\n109\t * const char *str = \"definitely utf8 string こんにちは नमस्ते Здравствуйте\";\n110\t * utf8_string ustr = make_utf8_string(str);\n111\t * assert( ustr.str != NULL );\n112\t *\n113\t * const char *s = \"non-utf8 sequence \\xC0\\xC0\";\n114\t * utf8_string ustr = make_utf8_string(str);\n115\t * assert( ustr.str == NULL );\n116\t * @endcode\n117\t */\n118\tutf8_string make_utf8_string(const char* str);\n119\t\n120\t/**\n121\t * @brief Converts a C-style string to a UTF-8 string, replacing invalid sequences with U+FFFD REPLACEMENT CHARACTER (�).\n122\t *\n123\t * @details It takes a C-style string as input and converts it to a UTF-8 encoded string.\n124\t *          Any invalid UTF-8 sequences in the input string are replaced with the U+FFFD REPLACEMENT CHARACTER (�) to ensure\n125\t *          that the resulting string is valid UTF-8. The resulting string is dynamically allocated and the caller\n126\t *          is responsible for freeing the memory when no longer needed using `free_owned_utf8_string`.\n127\t *\n128\t * @param str The input C-style string to convert. The string can contain invalid UTF-8 sequences.\n129\t * @return An `owned_utf8_string` structure containing the resulting UTF-8 string. If memory allocation fails, the structure\n130\t *         will contain a `NULL` pointer and a `byte_len` of 0.\n131\t *\n132\t * @code\n133\t * // Example usage:\n134\t * const char* str = \"hello\\xC0\\xC0 world!\";\n135\t * owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n136\t * @endcode\n137\t */\n138\towned_utf8_string make_utf8_string_lossy(const char* str);\n139\t\n140\t/**\n141\t * @brief Creates the non-owning UTF-8 encoded string `utf8_string` from an `owned_utf8_string`.\n142\t *\n143\t * @details The resulting `utf8_string` will point to the same underlying string without taking ownership.\n144\t *          The caller must ensure the original `owned_utf8_string` remains valid as long as the reference is used.\n145\t *\n146\t * @param owned_str The owned UTF-8 string from which to create a non-owning reference.\n147\t * @return utf8_string A non-owning UTF-8 string reference (`utf8_string`) pointing to the same data.\n148\t *\n149\t * @note This function does not free or transfer ownership of the `owned_utf8_string`.\n150\t *       The caller is responsible for managing the lifetime of the owned string.\n151\t */\n152\tutf8_string as_utf8_string(const owned_utf8_string* owned_str);\n153\t\n154\t/**\n155\t * @brief Frees the memory allocated for an `owned_utf8_string`.\n156\t *\n157\t * @details The `free_owned_utf8_string` function deallocates the memory used by an `owned_utf8_string`\n158\t *          and sets the `str` pointer to `NULL` and `byte_len` to 0.\n159\t *\n160\t * @param owned_str A pointer to the `owned_utf8_string` structure to be freed.\n161\t *\n162\t * @code\n163\t * // Example usage:\n164\t * owned_utf8_string owned_ustr = make_utf8_string_lossy(\"hello\\xC0\\xC0 world!\");\n165\t * free_owned_utf8_string(&owned_ustr);\n166\t * @endcode\n167\t */\n168\tvoid free_owned_utf8_string(owned_utf8_string* owned_str);\n169\t\n170\t/**\n171\t * @brief Creates a UTF-8 string slice from a specified range of bytes in the original string.\n172\t *\n173\t * @param ustr The original UTF-8 string.\n174\t * @param byte_index The starting byte index of the slice.\n175\t * @param byte_len The byte length of the slice.\n176\t * @return A UTF-8 string representing the specified byte range [offset, offset + byte_len) if valid (range between UTF-8 char boundaries);\n177\t * otherwise { .str = NULL, .byte_len = 0 }\n178\t *\n179\t * @note if `byte_index` >= strlen(ustr.str) then returns terminating '\\0' of ustr.str { .str = '\\0', .byte_len = 0 }\n180\t * @note if `byte_index` + `byte_len` >= strlen(ustr.str) then only chars till terminating '\\0' are considered.\n181\t */\n182\tutf8_string slice_utf8_string(utf8_string ustr, size_t byte_index, size_t byte_len);\n183\t\n184\t/**\n185\t * @brief Creates an iterator for traversing UTF-8 characters within a string. (see next_utf8_char( .. ) for traversal)\n186\t *\n187\t * @param ustr The UTF-8 string to iterate over.\n188\t * @return An iterator structure initialized to the start of the string.\n189\t */\n190\tutf8_char_iter make_utf8_char_iter(utf8_string ustr);\n191\t\n192\t/**\n193\t * @brief Retrieves the next UTF-8 character from the iterator.\n194\t *\n195\t * @param iter Pointer to the UTF-8 character iterator.\n196\t * @return The next UTF-8 character from the iterator.\n197\t * @note If the iterator reaches the end, it keeps returning terminating '\\0' of iter.str { .str = '\\0', .byte_len = 0 }\n198\t */\n199\tutf8_char next_utf8_char(utf8_char_iter* iter);\n200\t\n201\t/**\n202\t * @brief Retrieves the UTF-8 character at the specified character index within a UTF-8 string in O(n) time.\n203\t *\n204\t * @details The `nth_utf8_char` function returns the UTF-8 character located at the specified character index\n205\t * within the given UTF-8 string. The character index is zero-based, indicating the position of\n206\t * the character in the string. If the index is out of bounds or invalid, the function returns\n207\t * { .str = NULL, .byte_len = 0 }\n208\t *\n209\t * @param ustr The UTF-8 string from which to retrieve the character.\n210\t * @param char_index The zero-based index of the character to retrieve.\n211\t * @return The UTF-8 character at the specified index within the string.\n212\t *\n213\t * @code\n214\t * // Example usage:\n215\t * utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは\");\n216\t * utf8_char char_at_index = nth_utf8_char(str, 7);    // д\n217\t * @endcode\n218\t */\n219\tutf8_char nth_utf8_char(utf8_string ustr, size_t char_index);\n220\t\n221\t/**\n222\t * @brief Counts the number of UTF-8 characters in the given utf8_string.\n223\t *\n224\t * @param ustr The UTF-8 string whose characters are to be counted.\n225\t * @return The total number of characters in the UTF-8 string.\n226\t */\n227\tsize_t utf8_char_count(utf8_string ustr);\n228\t\n229\t/**\n230\t * @brief Checks if a given byte is the start of a UTF-8 character. ('\\0' is also a valid character boundary)\n231\t *\n232\t * @param str Pointer to the byte to check.\n233\t * @return `true` if the byte is the start of a UTF-8 character; otherwise, `false`.\n234\t */\n235\tbool is_utf8_char_boundary(const char* str);\n236\t\n237\t/**\n238\t * @brief Converts a UTF-8 character to its corresponding Unicode code point (which is the same as a UTF-32 value).\n239\t *\n240\t * @param uchar The UTF-8 character to convert.\n241\t * @return The Unicode code point.\n242\t */\n243\tuint32_t unicode_code_point(utf8_char uchar);\n244\t\n245\t#endif\n246\t"}]},"parent_tool_use_id":null,"session_id":"1a9ce886-61c9-4507-b7b0-ef0dd10152be","uuid":"427b2422-2a92-4f5e-9b31-d6516137941b","timestamp":"2026-06-06T05:55:53.525Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-8FLyl9/project/c_src/src/utf8.h","content":"/**\n * @file utf8.h\n * @brief simple library for working with UTF-8 encoded strings\n *\n * @code\n * #include \"utf8.h\"\n * #include <stdio.h>\n *\n * int main() {\n *     const char* str = \"Hello, こんにちは, Здравствуйте\";\n *     utf8_string ustr = make_utf8_string(str);\n *     utf8_string_slice slice = make_utf8_string_slice(ustr, 2, 11);\n *     utf8_char_iter iter = make_utf8_char_iter(ustr);\n *\n *     printf(\"string: %s\\n\", ustr.str);\n *     printf(\"slice: %.*s\\n\", (int)slice.byte_len, slice.str);\n *\n *     utf8_char ch;\n *     while ((ch = next_utf8_char(&iter)).byte_len > 0) {\n *         printf(\"character: %.*s\\t\", (int)ch.byte_len, ch.str);\n *         printf(\"unicode code point: U+%04X\\n\", unicode_code_point(ch));\n *     }\n *\n *     return 0;\n * }\n * @endcode\n */\n\n#ifndef ZAHASH_UTF8_H\n#define ZAHASH_UTF8_H\n\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n/**\n * @brief Represents the validity of a UTF-8 encoded string.\n *\n * @details The `utf8_validity` struct indicates whether a given UTF-8 encoded string is valid or not,\n * along with the position up to which it is valid.\n *\n * - Invalid case: \"hello\\xC0\\xC0\" => { .valid = false, .valid_upto = 5  }\n * - Valid case:   \"hello world\"   => { .valid = true,  .valid_upto = 11 }\n */\ntypedef struct {\n    bool valid;          ///< Flag indicating the validity of the UTF-8 string.\n    size_t valid_upto;   ///< The position up to which the string is valid.\n} utf8_validity;\n\n/**\n * @brief Represents a non-owning UTF-8 encoded string. (just a wrapper type).\n *\n * @details The `utf8_string` struct holds a pointer to a UTF-8 encoded string along with its byte length,\n */\ntypedef struct {\n    const char* str;     ///< Pointer to the UTF-8 encoded string.\n    size_t byte_len;     ///< Byte length of the UTF-8 string ('\\0' not counted).\n} utf8_string;\n\n/**\n * @brief Represents a UTF-8 encoded string that fully owns its data.\n *\n * @details The `owned_utf8_string` struct holds a pointer to a UTF-8 encoded string that is dynamically allocated\n *          and therefore is owned by the struct, which means the caller is responsible for freeing the memory when\n *          it is no longer needed using the `free_owned_utf8_string` function.\n */\ntypedef struct {\n    char* str;          ///< Pointer to the UTF-8 encoded string (owned). This memory is dynamically allocated.\n    size_t byte_len;    ///< Byte length of the UTF-8 string ('\\0' not counted).\n} owned_utf8_string;\n\n/**\n * @brief Represents an iterator for traversing UTF-8 characters in a string.\n *\n * @details The `utf8_char_iter` struct serves as an iterator for traversing UTF-8 characters\n * within a UTF-8 encoded string.\n */\ntypedef struct {\n    const char* str;     ///< Pointer to the current position of the iterator.\n} utf8_char_iter;\n\n/**\n * @brief Represents a UTF-8 character.\n *\n * @details The `utf8_char` struct encapsulates a UTF-8 character, including its pointer and byte length.\n * The byte length represents the number of bytes occupied by the UTF-8 character.\n */\ntypedef struct {\n    const char* str;     ///< Pointer to the UTF-8 character.\n    uint8_t byte_len;    ///< Byte length of the UTF-8 character.\n} utf8_char;\n\n/**\n * @brief Validates whether a given string is UTF-8 compliant in O(n) time.\n *\n * @param str The input string to validate.\n * @return The validity of the UTF-8 string along with the position up to which it is valid.\n */\nutf8_validity validate_utf8(const char* str);\n\n/**\n * @brief Wraps a C-style string in a UTF-8 string structure after verifying its UTF-8 compliance.\n *\n * @param str The input C-style string to wrap.\n * @return A UTF-8 string structure containing the wrapped string if valid; otherwise, a structure with NULL string pointer.\n *\n * @code\n * // Example usage:\n * const char *str = \"definitely utf8 string こんにちは नमस्ते Здравствуйте\";\n * utf8_string ustr = make_utf8_string(str);\n * assert( ustr.str != NULL );\n *\n * const char *s = \"non-utf8 sequence \\xC0\\xC0\";\n * utf8_string ustr = make_utf8_string(str);\n * assert( ustr.str == NULL );\n * @endcode\n */\nutf8_string make_utf8_string(const char* str);\n\n/**\n * @brief Converts a C-style string to a UTF-8 string, replacing invalid sequences with U+FFFD REPLACEMENT CHARACTER (�).\n *\n * @details It takes a C-style string as input and converts it to a UTF-8 encoded string.\n *          Any invalid UTF-8 sequences in the input string are replaced with the U+FFFD REPLACEMENT CHARACTER (�) to ensure\n *          that the resulting string is valid UTF-8. The resulting string is dynamically allocated and the caller\n *          is responsible for freeing the memory when no longer needed using `free_owned_utf8_string`.\n *\n * @param str The input C-style string to convert. The string can contain invalid UTF-8 sequences.\n * @return An `owned_utf8_string` structure containing the resulting UTF-8 string. If memory allocation fails, the structure\n *         will contain a `NULL` pointer and a `byte_len` of 0.\n *\n * @code\n * // Example usage:\n * const char* str = \"hello\\xC0\\xC0 world!\";\n * owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n * @endcode\n */\nowned_utf8_string make_utf8_string_lossy(const char* str);\n\n/**\n * @brief Creates the non-owning UTF-8 encoded string `utf8_string` from an `owned_utf8_string`.\n *\n * @details The resulting `utf8_string` will point to the same underlying string without taking ownership.\n *          The caller must ensure the original `owned_utf8_string` remains valid as long as the reference is used.\n *\n * @param owned_str The owned UTF-8 string from which to create a non-owning reference.\n * @return utf8_string A non-owning UTF-8 string reference (`utf8_string`) pointing to the same data.\n *\n * @note This function does not free or transfer ownership of the `owned_utf8_string`.\n *       The caller is responsible for managing the lifetime of the owned string.\n */\nutf8_string as_utf8_string(const owned_utf8_string* owned_str);\n\n/**\n * @brief Frees the memory allocated for an `owned_utf8_string`.\n *\n * @details The `free_owned_utf8_string` function deallocates the memory used by an `owned_utf8_string`\n *          and sets the `str` pointer to `NULL` and `byte_len` to 0.\n *\n * @param owned_str A pointer to the `owned_utf8_string` structure to be freed.\n *\n * @code\n * // Example usage:\n * owned_utf8_string owned_ustr = make_utf8_string_lossy(\"hello\\xC0\\xC0 world!\");\n * free_owned_utf8_string(&owned_ustr);\n * @endcode\n */\nvoid free_owned_utf8_string(owned_utf8_string* owned_str);\n\n/**\n * @brief Creates a UTF-8 string slice from a specified range of bytes in the original string.\n *\n * @param ustr The original UTF-8 string.\n * @param byte_index The starting byte index of the slice.\n * @param byte_len The byte length of the slice.\n * @return A UTF-8 string representing the specified byte range [offset, offset + byte_len) if valid (range between UTF-8 char boundaries);\n * otherwise { .str = NULL, .byte_len = 0 }\n *\n * @note if `byte_index` >= strlen(ustr.str) then returns terminating '\\0' of ustr.str { .str = '\\0', .byte_len = 0 }\n * @note if `byte_index` + `byte_len` >= strlen(ustr.str) then only chars till terminating '\\0' are considered.\n */\nutf8_string slice_utf8_string(utf8_string ustr, size_t byte_index, size_t byte_len);\n\n/**\n * @brief Creates an iterator for traversing UTF-8 characters within a string. (see next_utf8_char( .. ) for traversal)\n *\n * @param ustr The UTF-8 string to iterate over.\n * @return An iterator structure initialized to the start of the string.\n */\nutf8_char_iter make_utf8_char_iter(utf8_string ustr);\n\n/**\n * @brief Retrieves the next UTF-8 character from the iterator.\n *\n * @param iter Pointer to the UTF-8 character iterator.\n * @return The next UTF-8 character from the iterator.\n * @note If the iterator reaches the end, it keeps returning terminating '\\0' of iter.str { .str = '\\0', .byte_len = 0 }\n */\nutf8_char next_utf8_char(utf8_char_iter* iter);\n\n/**\n * @brief Retrieves the UTF-8 character at the specified character index within a UTF-8 string in O(n) time.\n *\n * @details The `nth_utf8_char` function returns the UTF-8 character located at the specified character index\n * within the given UTF-8 string. The character index is zero-based, indicating the position of\n * the cha