      return false;\n65\t    }\n66\t  }\n67\t}\n68\t\n69\treduction_order_t get_reduction_order() {\n70\t  int option;\n71\t  while (true) {\n72\t    printf(\"Choose: \\n[1] Normal order\\n[2] Applicative Order\\n\");\n73\t    scanf(\"%d\", &option);\n74\t    while (getchar() != '\\n')\n75\t      ;\n76\t    switch (option) {\n77\t    case 1: {\n78\t      return NORMAL;\n79\t    }\n80\t    case 2: {\n81\t      return APPLICATIVE;\n82\t    }\n83\t    }\n84\t  }\n85\t}\n86\t\n87\tbool exists(char *path) {\n88\t  FILE *file;\n89\t  if ((file = fopen(path, \"r\")) != NULL) {\n90\t    fclose(file);\n91\t    return true;\n92\t  }\n93\t  return false;\n94\t}\n95\t\n96\t\n97\tOptions cli() {\n98\t  FILE *f;\n99\t  int option;\n100\t  bool valid_option = false;\n101\t  bool step_by_step_reduction = get_reduction_step_option();\n102\t  reduction_order_t reduction_order = get_reduction_order();\n103\t\n104\t  while (!valid_option) {\n105\t\n106\t    printf(\"Choose your option:\\n[1] Write input\\n[2] File input\\n\");\n107\t\n108\t    scanf(\"%d\", &option);\n109\t\n110\t    while (getchar() != '\\n')\n111\t      ;\n112\t    switch (option) {\n113\t    case 1: {\n114\t      char *path = get_lambda_expr_input();\n115\t      f = get_file(path, \"r\");\n116\t      valid_option = true;\n117\t      break;\n118\t    }\n119\t    case 2: {\n120\t      char *path = get_file_path_input();\n121\t      f = get_file(path, \"r\");\n122\t      free(path);\n123\t      valid_option = true;\n124\t      break;\n125\t    }\n126\t    default:\n127\t      printf(\"Invalid input. Try again\\n\");\n128\t      break;\n129\t    }\n130\t  }\n131\t  Options opt;\n132\t  opt.file = f;\n133\t  opt.step_by_step_reduction = step_by_step_reduction;\n134\t  opt.reduction_order = reduction_order;\n135\t  return opt;\n136\t}\n137\t\n138\tint main(void) {\n139\t  Options opt;\n140\t  if (exists(CONFIG_PATH)) {\n141\t    opt = get_config_from_file();\n142\t  } else {\n143\t    opt = cli();\n144\t  }\n145\t  set_ve