unt: usize,\n    bits: usize,\n) -> u32 {\n    if bits == 0 {\n        for i in 0..count {\n            output[i] = base;\n        }\n        return 0;\n    }\n    let total_bytes = (count * bits + 7) / 8;\n    if bits == 32 {\n        for i in 0..count {\n            let v = u32::from_le_bytes([\n                input[i * 4],\n                input[i * 4 + 1],\n                input[i * 4 + 2],\n                input[i * 4 + 3],\n            ]);\n            output[i] = base.wrapping_add(v);\n        }\n        return total_bytes as u32;\n    }\n\n    let mask: u64 = (1u64 << bits) - 1;\n    for i in 0..count {\n        let bit_pos = i * bits;\n        let byte_off = bit_pos / 8;\n        let bit_off = bit_pos % 8;\n        let n_bytes = (bit_off + bits + 7) / 8;\n        let mut v64: u64 = 0;\n        for k in 0..n_bytes {\n            v64 |= (input[byte_off + k] as u64) << (k * 8);\n        }\n        let v = ((v64 >> bit_off) & mask) as u32;\n        output[i] = base.wrapping_add(v);\n    }\n    total_bytes as u32\n}\n\n#[inline(always)]\nfn linsearch_block_generic(\n    base: u32,\n    input: &[u8],\n    value: u32,\n    found: &mut i32,\n    count: usize,\n    bits: usize,\n) -> u32 {\n    if bits == 0 {\n        if base == value {\n            *found = 0;\n        }\n        return 0;\n    }\n    let target = value.wrapping_sub(base);\n    if bits == 32 {\n        for i in 0..count {\n            let v = u32::from_le_bytes([\n                input[i * 4],\n                input[i * 4 + 1],\n                input[i * 4 + 2],\n                input[i * 4 + 3],\n            ]);\n            if v == target {\n                *found = i as i32;\n                // C returns 0 on found in the bits==32 special path\n                return 0;\n            }\n        }\n        return (count * 4) as u32;\n    }\n\n    let mask: u64 = (1u64 << bits) - 1;\n    for i in 0..count {\n        let bit_pos = i * bits;\n        let byte_off = bit_pos / 8;\n        let bit_off 