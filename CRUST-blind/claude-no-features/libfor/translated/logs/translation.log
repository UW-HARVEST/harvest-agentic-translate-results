   let mut in_data: Vec<u32> = vec![0u32; max];\n\n    for i in 0..max {\n        in_data[i] = 1u32 << (17 + i);\n        let s1 = for_append_sorted(&mut out1, i as u32, in_data[i]);\n        let s2 = for_compress_sorted(&in_data[..(i + 1)], &mut out2, (i + 1) as u32);\n        assert_eq!(s1, s2, \"size mismatch at i={}\", i);\n        for j in 0..s1 as usize {\n            assert_eq!(out1[j], out2[j], \"byte mismatch at i={} j={}\", i, j);\n        }\n    }\n}\n\n#[test]\nfn test_append_unsorted() {\n    let max: usize = 100;\n    let mut out1: Vec<u8> = vec![0u8; max * 8];\n    let mut out2: Vec<u8> = vec![0u8; max * 8];\n    let mut in_data: Vec<u32> = vec![0u32; max];\n\n    for i in 0..max {\n        in_data[i] = 7u32.wrapping_add(rnd().wrapping_sub(7));\n        let s1 = for_append_unsorted(&mut out1, i as u32, in_data[i]);\n        let s2 = for_compress_unsorted(&in_data[..(i + 1)], &mut out2, (i + 1) as u32);\n        assert_eq!(s1, s2, \"size mismatch at i={}\", i);\n        for j in 0..s1 as usize {\n            assert_eq!(out1[j], out2[j], \"byte mismatch at i={} j={}\", i, j);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":143,"oldLines":6,"newStart":143,"newLines":24,"lines":[" }"," "," #[test]","+fn test_append_sorted_big() {","+    let max: usize = 1000;","+    let mut out1: Vec<u8> = vec![0u8; max * 8];","+    let mut out2: Vec<u8> = vec![0u8; max * 8];","+    let mut in_data: Vec<u32> = vec![0u32; max];","+","+    for i in 0..max {","+        in_data[i] = i as u32;","+        let s1 = for_append_sorted(&mut out1, i as u32, in_data[i]);","+        let s2 = for_compress_sorted(&in_data[..(i + 1)], &mut out2, (i + 1) as u32);","+        assert_eq!(s1, s2, \"size mismatch at i={}\", i);","+        for j in 0..s1 as usize {","+            assert_eq!(out1[j], out2[j], \"byte mismatch at i={} j={}\", i, j);","+        }","+    }","+}","+","+#[test]"," fn test_append_unsorted() {","     let max: usize = 100;","     let mut out1: Vec<u8> = vec![0u8; 