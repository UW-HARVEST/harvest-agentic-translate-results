+ 64];\n    let mut tmp: Vec<u32> = vec![0u32; length_us + 16];\n\n    let s3 = for_compressed_size_unsorted(&in_data, length);\n    let s1 = for_compress_unsorted(&in_data, &mut out, length);\n    let s2 = for_uncompress(&out, &mut tmp, length);\n    assert_eq!(s1, s2, \"unsorted size s1!=s2 length={}\", length);\n    assert_eq!(s2, s3, \"unsorted size s2!=s3 length={}\", length);\n    for i in 0..length_us {\n        assert_eq!(in_data[i], tmp[i], \"data mismatch at {} length={}\", i, length);\n    }\n    for i in 0..length_us {\n        assert_eq!(in_data[i], for_select(&out, i as u32));\n    }\n    for i in 0..length_us {\n        let idx = for_linear_search(&out, length, in_data[i]);\n        assert_eq!(in_data[idx as usize], in_data[i],\n            \"linsearch unsorted mismatch length={} i={}\", length, i);\n    }\n}\n\n#[test]\nfn test_highlevel_unsorted_various_lengths() {\n    for &n in &[1u32, 2, 3, 8, 16, 17, 32, 33, 64, 65, 128, 129, 256, 257, 1024, 1025, 1333] {\n        highlevel_unsorted(n);\n    }\n}\n\n#[test]\nfn test_append_sorted() {\n    let max: usize = 100;\n    let mut out1: Vec<u8> = vec![0u8; max * 8];\n    let mut out2: Vec<u8> = vec![0u8; max * 8];\n    let mut in_data: Vec<u32> = vec![0u32; max];\n\n    for i in 0..max {\n        in_data[i] = i as u32;\n        // append\n        let s1 = for_append_sorted(&mut out1, i as u32, in_data[i]);\n        // full compress\n        let s2 = for_compress_sorted(&in_data[..(i + 1)], &mut out2, (i + 1) as u32);\n        assert_eq!(s1, s2, \"size mismatch at i={}\", i);\n        for j in 0..s1 as usize {\n            assert_eq!(out1[j], out2[j], \"byte mismatch at i={} j={}\", i, j);\n        }\n    }\n}\n","structuredPatch":[{"oldStart":123,"oldLines":3,"newStart":123,"newLines":39,"lines":["         }","     }"," }","+","+#[test]","+fn test_append_sorted_bignum() {","+    let max: usize = 10;","+    let mut out1: Vec<u8> = vec![0u8; max * 8];","+    let mut out2: Vec<u8> = vec![0u8; max * 8];","+