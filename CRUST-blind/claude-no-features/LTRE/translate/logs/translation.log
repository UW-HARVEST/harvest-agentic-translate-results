1187\t    if (min_degree == INT_MAX)\n1188\t      break; // all states have been processed\n1189\t\n1190\t    // iterate through all pairs of inbound and outbound transitions, including\n1191\t    // those to and from the auxiliary state\n1192\t    for (int id1 = 0; id1 <= dfa_size; id1++) {\n1193\t      if (id1 == best_fit)\n1194\t        continue; // inbound transition must not be a self-loop\n1195\t      for (int id2 = 0; id2 <= dfa_size; id2++) {\n1196\t        if (id2 == best_fit)\n1197\t          continue; // outbound transition must not be a self-loop\n1198\t        struct arrow in = arrows[id1][best_fit];  // current inbound transition\n1199\t        struct arrow out = arrows[best_fit][id2]; // current outbout transition\n1200\t        struct arrow self = arrows[best_fit][best_fit]; // self-transition\n1201\t        struct arrow existing = arrows[id1][id2]; // existing bypass transition\n1202\t\n1203\t        // (existing)|[](self)(out) == (existing)|(in)(self)[] == (existing)\n1204\t        if (!in.label || !out.label)\n1205\t          continue;\n1206\t\n1207\t        // get rid of the self-transition by concatenating it either onto the\n1208\t        // the inbound or outbound transition\n1209\t        struct arrow first, second;\n1210\t\n1211\t        ptrdiff_t diff;\n1212\t        if (!self.label || !*self.label) {\n1213\t          // (in)[]*(out) == (in)()*(out) == (in)(out)\n1214\t          first = in, second = out;\n1215\t        } else if (in.prec >= CONCAT && self.prec >= CONCAT &&\n1216\t                   (diff = strlen(in.label) - strlen(self.label)) >= 0 &&\n1217\t                   strcmp(in.label + diff, self.label) == 0) {\n1218\t          // hackily try to avoid breaking apart symsets in the inbound arrow\n1219\t          if (diff >= 1 && strchr(\"^-\\\\\", in.label[diff - 1]) &&\n1220\t              (diff == 1 || in.label[diff - 2] != '\\\\'))\n1221\t            goto nevermind; // preserve ^aa* a-zz* \\^a^a* but not \\^aa* \\-aa*\n1222\t   