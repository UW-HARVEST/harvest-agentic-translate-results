mSet {\n    unimplemented!()\n}\nfn not_wordchar_set() -> SymSet {\n    unimplemented!()\n}\nfn parse_natural(ctx: &mut ParseContext) -> Result<u32, String> {\n    unimplemented!()\n}\nfn shift_option(opt: &mut Option<usize>, offset: usize) {\n    unimplemented!()\n}","userModified":false}}
