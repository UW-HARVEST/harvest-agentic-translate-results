{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013khKpm1d4NrCiPeNNH2PDH","type":"tool_result","content":"1\t//--------------------------------------------------------------------\n2\t// M17 C library - decode/symbols.c\n3\t//\n4\t// Wojciech Kaczmarski, SP5WWP\n5\t// M17 Project, 29 December 2023\n6\t//--------------------------------------------------------------------\n7\t#include <m17.h>\n8\t#include <stdio.h>\n9\t#include <string.h>\n10\t\n11\t// Adapted from symbols.c\n12\t// syncword patterns (RX)\n13\t// TODO: Compute those at runtime from the consts below\n14\tconst int8_t lsf_sync_symbols[8]={+3, +3, +3, +3, -3, -3, +3, -3};\n15\tconst int8_t str_sync_symbols[8]={-3, -3, -3, -3, +3, +3, -3, +3};\n16\tconst int8_t pkt_sync_symbols[8]={+3, -3, +3, +3, -3, -3, -3, -3};\n17\t\n18\t// symbol levels (RX)\n19\tconst float symbol_levels[4]={-3.0, -1.0, +1.0, +3.0};\n20\t\n21\t//--------------------------------------------------------------------\n22\t// M17 C library - decode/viterbi.c\n23\t//\n24\t// This file contains:\n25\t// - the Viterbi decoder\n26\t//\n27\t// Wojciech Kaczmarski, SP5WWP\n28\t// M17 Project, 29 December 2023\n29\t//--------------------------------------------------------------------\n30\t\n31\t\n32\tstatic uint32_t prevMetrics[NUM_STATES];\n33\tstatic uint32_t currMetrics[NUM_STATES];\n34\tstatic uint32_t prevMetricsData[NUM_STATES];\n35\tstatic uint32_t currMetricsData[NUM_STATES];\n36\tstatic uint16_t viterbi_history[244];\n37\t\n38\t/**\n39\t * @brief Decode unpunctured convolutionally encoded data.\n40\t *\n41\t * @param out Destination array where decoded data is written.\n42\t * @param in Input data.\n43\t * @param len Input length in bits.\n44\t * @return Number of bit errors corrected.\n45\t */\n46\tuint32_t viterbi_decode(uint8_t* out, const uint16_t* in, const uint16_t len)\n47\t{\n48\t    if(len > 244*2)\n49\t\t\tfprintf(stderr, \"Input size exceeds max history\\n\");\n50\t\n51\t    viterbi_reset();\n52\t\n53\t    size_t pos = 0;\n54\t    for(size_t i = 0; i < len; i += 2)\n55\t    {\n56\t        uint16_t s0 = in[i];\n57\t        uint16_t s1 = in[i + 1];\n58\t\n59\t        viterbi_decode_bit(s0, s1, pos);\n60\t        pos++;\n61\t    }\n62\t\n63\t    return viterbi_chainback(out, pos, len/2);\n64\t}\n65\t\n66\t/**\n67\t * @brief Decode punctured convolutionally encoded data.\n68\t *\n69\t * @param out Destination array where decoded data is written.\n70\t * @param in Input data.\n71\t * @param punct Puncturing matrix.\n72\t * @param in_len Input data length.\n73\t * @param p_len Puncturing matrix length (entries).\n74\t * @return Number of bit errors corrected.\n75\t */\n76\tuint32_t viterbi_decode_punctured(uint8_t* out, const uint16_t* in, const uint8_t* punct, const uint16_t in_len, const uint16_t p_len)\n77\t{\n78\t    if(in_len > 244*2)\n79\t\t\tfprintf(stderr, \"Input size exceeds max history\\n\");\n80\t\n81\t\tuint16_t umsg[244*2];           //unpunctured message\n82\t\tuint8_t p=0;\t\t            //puncturer matrix entry\n83\t\tuint16_t u=0;\t\t            //bits count - unpunctured message\n84\t    uint16_t i=0;                   //bits read from the input message\n85\t\n86\t\twhile(i<in_len)\n87\t\t{\n88\t\t\tif(punct[p])\n89\t\t\t{\n90\t\t\t\tumsg[u]=in[i];\n91\t\t\t\ti++;\n92\t\t\t}\n93\t\t\telse\n94\t\t\t{\n95\t\t\t\tumsg[u]=0x7FFF;\n96\t\t\t}\n97\t\n98\t\t\tu++;\n99\t\t\tp++;\n100\t\t\tp%=p_len;\n101\t\t}\n102\t\n103\t    return viterbi_decode(out, umsg, u) - (u-in_len)*0x7FFF;\n104\t}\n105\t\n106\t/**\n107\t * @brief Decode one bit and update trellis.\n108\t *\n109\t * @param s0 Cost of the first symbol.\n110\t * @param s1 Cost of the second symbol.\n111\t * @param pos Bit position in history.\n112\t */\n113\tvoid viterbi_decode_bit(uint16_t s0, uint16_t s1, const size_t pos)\n114\t{\n115\t    static const uint16_t COST_TABLE_0[] = {0, 0, 0, 0, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF};\n116\t    static const uint16_t COST_TABLE_1[] = {0, 0xFFFF, 0xFFFF, 0, 0, 0xFFFF, 0xFFFF, 0};\n117\t\n118\t    for(uint8_t i = 0; i < NUM_STATES/2; i++)\n119\t    {\n120\t        uint32_t metric = q_abs_diff(COST_TABLE_0[i], s0)\n121\t                        + q_abs_diff(COST_TABLE_1[i], s1);\n122\t\n123\t\n124\t        uint32_t m0 = prevMetrics[i] + metric;\n125\t        uint32_t m1 = prevMetrics[i + NUM_STATES/2] + (0x1FFFE - metric);\n126\t\n127\t        uint32_t m2 = prevMetrics[i] + (0x1FFFE - metric);\n128\t        uint32_t m3 = prevMetrics[i + NUM_STATES/2] + metric;\n129\t\n130\t        uint8_t i0 = 2 * i;\n131\t        uint8_t i1 = i0 + 1;\n132\t\n133\t        if(m0 >= m1)\n134\t        {\n135\t            viterbi_history[pos]|=(1<<i0);\n136\t            currMetrics[i0] = m1;\n137\t        }\n138\t        else\n139\t        {\n140\t            viterbi_history[pos]&=~(1<<i0);\n141\t            currMetrics[i0] = m0;\n142\t        }\n143\t\n144\t        if(m2 >= m3)\n145\t        {\n146\t            viterbi_history[pos]|=(1<<i1);\n147\t            currMetrics[i1] = m3;\n148\t        }\n149\t        else\n150\t        {\n151\t            viterbi_history[pos]&=~(1<<i1);\n152\t            currMetrics[i1] = m2;\n153\t        }\n154\t    }\n155\t\n156\t    //swap\n157\t    uint32_t tmp[NUM_STATES];\n158\t    for(uint8_t i=0; i<NUM_STATES; i++)\n159\t    {\n160\t    \ttmp[i]=currMetrics[i];\n161\t\t}\n162\t\tfor(uint8_t i=0; i<NUM_STATES; i++)\n163\t    {\n164\t    \tcurrMetrics[i]=prevMetrics[i];\n165\t    \tprevMetrics[i]=tmp[i];\n166\t\t}\n167\t}\n168\t\n169\t/**\n170\t * @brief History chainback to obtain final byte array.\n171\t *\n172\t * @param out Destination byte array for decoded data.\n173\t * @param pos Starting position for the chainback.\n174\t * @param len Length of the output in bits.\n175\t * @return Minimum Viterbi cost at the end of the decode sequence.\n176\t */\n177\tuint32_t viterbi_chainback(uint8_t* out, size_t pos, uint16_t len)\n178\t{\n179\t    uint8_t state = 0;\n180\t    size_t bitPos = len+4;\n181\t\n182\t    memset(out, 0, (len-1)/8+1);\n183\t\n184\t    while(pos > 0)\n185\t    {\n186\t        bitPos--;\n187\t        pos--;\n188\t        uint16_t bit = viterbi_history[pos]&((1<<(state>>4)));\n189\t        state >>= 1;\n190\t        if(bit)\n191\t        {\n192\t        \tstate |= 0x80;\n193\t        \tout[bitPos/8]|=1<<(7-(bitPos%8));\n194\t\t\t}\n195\t    }\n196\t\n197\t    uint32_t cost = prevMetrics[0];\n198\t\n199\t    for(size_t i = 0; i < NUM_STATES; i++)\n200\t    {\n201\t        uint32_t m = prevMetrics[i];\n202\t        if(m < cost) cost = m;\n203\t    }\n204\t\n205\t    return cost;\n206\t}\n207\t\n208\t/**\n209\t * @brief Reset the decoder state. No args.\n210\t *\n211\t */\n212\tvoid viterbi_reset(void)\n213\t{\n214\t\tmemset((uint8_t*)viterbi_history, 0, 2*244);\n215\t\tmemset((uint8_t*)currMetrics, 0, 4*NUM_STATES);\n216\t    memset((uint8_t*)prevMetrics, 0, 4*NUM_STATES);\n217\t    memset((uint8_t*)currMetricsData, 0, 4*NUM_STATES);\n218\t    memset((uint8_t*)prevMetricsData, 0, 4*NUM_STATES);\n219\t}\n220\t"}]},"parent_tool_use_id":null,"session_id":"d657be59-9195-4e1f-9a57-6e7a656a5ac5","uuid":"5347d6d9-d280-4c68-ab84-972109888f29","timestamp":"2026-06-06T03:49:10.898Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-c9sH1L/project/c_src/decode/decode.c","content":"//--------------------------------------------------------------------\n// M17 C library - decode/symbols.c\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 29 December 2023\n//--------------------------------------------------------------------\n#include <m17.h>\n#include <stdio.h>\n#include <string.h>\n\n// Adapted from symbols.c\n// syncword patterns (RX)\n// TODO: Compute those at runtime from the consts below\nconst int8_t lsf_sync_symbols[8]={+3, +3, +3, +3, -3, -3, +3, -3};\nconst int8_t str_sync_symbols[8]={-3, -3, -3, -3, +3, +3, -3, +3};\nconst int8_t pkt_sync_symbols[8]={+3, -3, +3, +3, -3, -3, -3, -3};\n\n// symbol levels (RX)\nconst float symbol_levels[4]={-3.0, -1.0, +1.0, +3.0};\n\n//--------------------------------------------------------------------\n// M17 C library - decode/viterbi.c\n//\n// This file contains:\n// - the Viterbi decoder\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 29 December 2023\n//--------------------------------------------------------------------\n\n\nstatic uint32_t prevMetrics[NUM_STATES];\nstatic uint32_t currMetrics[NUM_STATES];\nstatic uint32_t prevMetricsData[NUM_STATES];\nstatic uint32_t currMetricsData[NUM_STATES];\nstatic uint16_t viterbi_history[244];\n\n/**\n * @brief Decode unpunctured convolutionally encoded data.\n *\n * @param out Destination array where decoded data is written.\n * @param in Input data.\n * @param len Input length in bits.\n * @return Number of bit errors corrected.\n */\nuint32_t viterbi_decode(uint8_t* out, const uint16_t* in, const uint16_t len)\n{\n    if(len > 244*2)\n\t\tfprintf(stderr, \"Input size exceeds max history\\n\");\n\n    viterbi_reset();\n\n    size_t pos = 0;\n    for(size_t i = 0; i < len; i += 2)\n    {\n        uint16_t s0 = in[i];\n        uint16_t s1 = in[i + 1];\n\n        viterbi_decode_bit(s0, s1, pos);\n        pos++;\n    }\n\n    return viterbi_chainback(out, pos, len/2);\n}\n\n/**\n * @brief Decode punctured convolutionally encoded data.\n *\n * @param out Destination array where decoded data is written.\n * @param in Input data.\n * @param punct Puncturing matrix.\n * @param in_len Input data length.\n * @param p_len Puncturing matrix length (entries).\n * @return Number of bit errors corrected.\n */\nuint32_t viterbi_decode_punctured(uint8_t* out, const uint16_t* in, const uint8_t* punct, const uint16_t in_len, const uint16_t p_len)\n{\n    if(in_len > 244*2)\n\t\tfprintf(stderr, \"Input size exceeds max history\\n\");\n\n\tuint16_t umsg[244*2];           //unpunctured message\n\tuint8_t p=0;\t\t            //puncturer matrix entry\n\tuint16_t u=0;\t\t            //bits count - unpunctured message\n    uint16_t i=0;                   //bits read from the input message\n\n\twhile(i<in_len)\n\t{\n\t\tif(punct[p])\n\t\t{\n\t\t\tumsg[u]=in[i];\n\t\t\ti++;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tumsg[u]=0x7FFF;\n\t\t}\n\n\t\tu++;\n\t\tp++;\n\t\tp%=p_len;\n\t}\n\n    return viterbi_decode(out, umsg, u) - (u-in_len)*0x7FFF;\n}\n\n/**\n * @brief Decode one bit and update trellis.\n *\n * @param s0 Cost of the first symbol.\n * @param s1 Cost of the second symbol.\n * @param pos Bit position in history.\n */\nvoid viterbi_decode_bit(uint16_t s0, uint16_t s1, const size_t pos)\n{\n    static const uint16_t COST_TABLE_0[] = {0, 0, 0, 0, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF};\n    static const uint16_t COST_TABLE_1[] = {0, 0xFFFF, 0xFFFF, 0, 0, 0xFFFF, 0xFFFF, 0};\n\n    for(uint8_t i = 0; i < NUM_STATES/2; i++)\n    {\n        uint32_t metric = q_abs_diff(COST_TABLE_0[i], s0)\n                        + q_abs_diff(COST_TABLE_1[i], s1);\n\n\n        uint32_t m0 = prevMetrics[i] + metric;\n        uint32_t m1 = prevMetrics[i + NUM_STATES/2] + (0x1FFFE - metric);\n\n        uint32_t m2 = prevMetrics[i] + (0x1FFFE - metric);\n        uint32_t m3 = prevMetrics[i + NUM_STATES/2] + metric;\n\n        uint8_t i0 = 2 * i;\n        uint8_t i1 = i0 + 1;\n\n        if(m0 >= m1)\n        {\n            viterbi_history[pos]|=(1<<i0);\n            currMetrics[i0] = m1;\n        }\n        else\n        {\n            viterbi_history[pos]&=~(1<<i0);\n            currMetrics[i0] = m0;\n        }\n\n        if(m2 >= m3)\n        {\n            viterbi_history[pos]|=(1<<i1);\n            currMetrics[i1] = m3;\n        }\n        else\n        {\n            viterbi_history[pos]&=~(1<<i1);\n            currMetrics[i1] = m2;\n        }\n    }\n\n    //swap\n    uint32_t tmp[NUM_STATES];\n    for(uint8_t i=0; i<NUM_STATES; i++)\n    {\n    \ttmp[i]=currMetrics[i];\n\t}\n\tfor(uint8_t i=0; i<NUM_STATES; i++)\n    {\n    \tcurrMetrics[i]=prevMetrics[i];\n    \tprevMetrics[i]=tmp[i];\n\t}\n}\n\n/**\n * @brief History chainback to obtain final byte array.\n *\n * @param out Destination byte array for decoded data.\n * @param pos Starting position for the chainback.\n * @param len Length of the output in bits.\n * @return Minimum Viterbi cost at the end of the decode sequence.\n */\nuint32_t viterbi_chainback(uint8_t* out, size_t pos, uint16_t len)\n{\n    uint8_t state = 0;\n    size_t bitPos = len+4;\n\n    memset(out, 0, (len-1)/8+1);\n\n    while(pos > 0)\n    {\n        bitPos--;\n        pos--;\n        uint16_t bit = viterbi_history[pos]&((1<<(state>>4)));\n        state >>= 1;\n        if(bit)\n        {\n        \tstate |= 0x80;\n        \tout[bitPos/8]|=1<<(7-(bitPos%8));\n\t\t}\n    }\n\n    uint32_t cost = prevMetrics[0];\n\n    for(size_t i = 0; i < NUM_STATES; i++)\n    {\n        uint32_t m = prevMetrics[i];\n        if(m < cost) cost = m;\n    }\n\n    return cost;\n}\n\n/**\n * @brief Reset the decoder state. No args.\n *\n */\nvoid viterbi_reset(void)\n{\n\tmemset((uint8_t*)viterbi_history, 0, 2*244);\n\tmemset((uint8_t*)currMetrics, 0, 4*NUM_STATES);\n    memset((uint8_t*)prevMetrics, 0, 4*NUM_STATES);\n    memset((uint8_t*)currMetricsData, 0, 4*NUM_STATES);\n    memset((uint8_t*)prevMetricsData, 0, 4*NUM_STATES);\n}\n","numLines":220,"startLine":1,"totalLines":220}}}
