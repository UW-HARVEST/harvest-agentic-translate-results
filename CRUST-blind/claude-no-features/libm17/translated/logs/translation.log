{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01F7YQ2bQxzsCK4NjaVc6dBS","type":"tool_result","content":"1\t//--------------------------------------------------------------------\n2\t// M17 C library - m17.h\n3\t//\n4\t// Wojciech Kaczmarski, SP5WWP\n5\t// M17 Project, 24 September 2024\n6\t//--------------------------------------------------------------------\n7\t#pragma once\n8\t\n9\t#ifdef __cplusplus\n10\textern \"C\" {\n11\t#endif\n12\t#include <stdint.h>\n13\t#include <stddef.h>\n14\t\n15\t// M17 C library - lib/lib.c\n16\t#define BSB_SPS             10                      //samples per symbol\n17\t#define FLT_SPAN            8                       //baseband RRC filter span in symbols\n18\t#define SYM_PER_SWD         8                       //symbols per syncword\n19\t#define SW_LEN              (BSB_SPS*SYM_PER_SWD)   //syncword detector length\n20\t#define SYM_PER_PLD         184                     //symbols per payload in a frame\n21\t#define SYM_PER_FRA         192                     //symbols per whole 40 ms frame\n22\t#define RRC_DEV             7168.0f                 //.rrc file deviation for +1.0 symbol\n23\t\n24\t// M17 C library - lib/payload/call.c\n25\t#define CHAR_MAP\t\" ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-/.\"\n26\t#define U40_9\t\t(262144000000000UL)\t//40^9\n27\t#define U40_9_8\t\t(268697600000000UL) //40^9+40^8\n28\t\n29\tvoid decode_callsign_bytes(uint8_t *outp, const uint8_t inp[6]);\n30\tvoid decode_callsign_value(uint8_t *outp, const uint64_t inp);\n31\tint8_t encode_callsign_bytes(uint8_t out[6], const uint8_t *inp);\n32\tint8_t encode_callsign_value(uint64_t *out, const uint8_t *inp);\n33\t\n34\t// M17 C library - preamble\n35\t/**\n36\t * @brief Preamble type (0 for LSF, 1 for BERT).\n37\t */\n38\ttypedef enum\n39\t{\n40\t\tPREAM_LSF,\n41\t\tPREAM_BERT\n42\t} pream_t;\n43\t\n44\t// M17 C library - frame type\n45\t/**\n46\t * @brief Frame type (0 - LSF, 1 - stream, 2 - packet).\n47\t */\n48\ttypedef