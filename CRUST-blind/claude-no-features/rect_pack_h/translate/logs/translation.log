 == 3).unwrap();\n        assert!(r0.info.packed, \"id=3 (largest) should pack first\");\n        for r in &rects {\n            if r.id != 3 {\n                assert!(!r.info.packed, \"id={} should not be packed\", r.id);\n            }\n        }\n        println!(\"test_rect_pack_no_paging: OK\");\n    }\n\n    // test_rect_pack_fail_paging\n    {\n        let mut rects = vec![Rect::new(0, 900, 900), Rect::new(1, 1100, 1100)];\n        assert!(!RectPacker::pack(1000, 1000, true, &mut rects));\n        let r0 = rects.iter().find(|r| r.id == 0).unwrap();\n        let r1 = rects.iter().find(|r| r.id == 1).unwrap();\n        assert!(!r0.info.packed);\n        assert!(r1.info.packed);\n        println!(\"test_rect_pack_fail_paging: OK\");\n    }\n\n    println!(\"All tests passed!\");\n}\nEOF\nmkdir -p tmp_test_pack/src\ncp -r /tmp/claude-31062124/harvest-crust-riYuDG/project/src tmp_test_pack/lib\necho \"Test code prepared\"","description":"Prepare verification test"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":684,"cache_read_input_tokens":32290,"cache_creation":{"ephemeral_5m_input_tokens":684,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a8c7ccaa-2f6e-4843-9166-a0e238fbc46a","uuid":"8ee4b0e1-31ff-4175-8341-0eb3e558e1fb"}
