e {","+                    out.push_str(\"#<macro>\");","+                }","+            }","+        }","+        TspType::TspPrim => {","+            if let ValUnion::Pr { name, .. } = &v.v {","+                out.push_str(&format!(\"#<primitive:{}>\", name));","+            }","+        }","+        TspType::TspForm => {","+            if let ValUnion::Pr { name, .. } = &v.v {","+                out.push_str(&format!(\"#<form:{}>\", name));","+            }","+        }","+        TspType::TspRec => {","+            out.push('{');","+            if let ValUnion::R(r) = &v.v {","+                let mut current: Option<&Rec> = Some(r);","+                while let Some(rec) = current {","+                    let mut count = 0;","+                    let mut printed = 0;","+                    for entry in rec.items.iter() {","+                        if !entry.key.is_empty() {","+                            count += 1;","+                            if count > TSP_REC_MAX_PRINT as i32 {","+                                out.push_str(\" ...\");","+                                break;","+                            }","+                            out.push_str(&format!(\" {}: \", entry.key));","+                            print_val(out, &entry.val);","+                            printed += 1;","+                            if printed >= rec.size {","+                                break;","+                            }","+                        }","+                    }","+                    current = rec.next.as_deref();","+                }","+            }","+            out.push_str(\" }\");","+        }","+        TspType::TspPair => {","+            out.push('(');","+            if let Some(car) = val_car(v) {","+                print_val(out, car);","+            }","+            let mut cur = val_cdr(v);","+            while let Some(c) = cur {","+                if pairp(c) {","+                    out.push(' ');","+                    if let S