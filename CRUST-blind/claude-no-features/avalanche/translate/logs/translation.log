{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01W1oHxTm9c97bYP1Rb7nLg3","type":"tool_result","content":"1\t/* avalanche.c\n2\t */\n3\t#include \"avalanche.h\"\n4\t#include <stdio.h>\n5\t#include <stdlib.h>\n6\t\n7\tvoid avalanche(hash_f hash, FILE* ins, uint64_t max_iter, matrix_t* results)\n8\t{\n9\t    size_t key_size = results->n_rows / 8;\n10\t    size_t hash_words = results->n_cols / 32;\n11\t\n12\t    char* key = malloc(key_size);\n13\t    uint32_t* hvalue = malloc(4 * hash_words);\n14\t    uint32_t* htemp = malloc(4 * hash_words);\n15\t\n16\t    uint64_t key_count = 0;\n17\t    while (key_count < max_iter) {\n18\t        size_t n_in = fread(key, 1, key_size, ins);\n19\t        if (n_in < key_size)\n20\t            break;\n21\t\n22\t        hash(key, key_size, hvalue);\n23\t        ++key_count;\n24\t\n25\t        for (size_t i_byte = 0; i_byte < key_size; ++i_byte) {\n26\t            for (size_t i_bit = 0; i_bit < 8; ++i_bit) {\n27\t                size_t row = i_byte * 8 + i_bit;\n28\t\n29\t                // flip the i-th bit of this byte and re-hash\n30\t                char i_mask = 0x80 >> i_bit;\n31\t                key[i_byte] ^= i_mask;\n32\t                hash(key, key_size, htemp);\n33\t                key[i_byte] ^= i_mask;\n34\t\n35\t                for (size_t j_word = 0; j_word < hash_words; ++j_word) {\n36\t                    for (size_t j_bit = 0; j_bit < 32; ++j_bit) {\n37\t                        size_t col = j_word * 32 + j_bit;\n38\t\n39\t                        // test whether hvalue & htemp differ at j-th bit.\n40\t                        uint32_t j_mask = 0x80000000 >> j_bit;\n41\t                        if ((hvalue[j_word] ^ htemp[j_word]) & j_mask) {\n42\t                            double curr = MATRIX_GET(results, row, col);\n43\t                            MATRIX_SET(results, row, col, curr + 1);\n44\t                        }\n45\t                    }\n46\t                }\n47\t            }\n48\t        }\n49\t    }\n50\t\n51\t    free(key);\n52\t    free(hvalue);\n53\t    free(htemp);\n54\t\n55\t    if (key_count) {\n56\t        // convert matrix entries to the mean values\n57\t        size_t n_vals = results->n_cols * results->n_rows;\n58\t        for (size_t k = 0; k < n_vals; ++k)\n59\t            results->vals[k] /= key_count;\n60\t    }\n61\t}\n62\t\n63\tmatrix_t* matrix_alloc(size_t n_rows, size_t n_cols) {\n64\t    matrix_t* M = malloc(sizeof(matrix_t));\n65\t    M->n_rows = n_rows;\n66\t    M->n_cols = n_cols;\n67\t    M->vals = calloc(sizeof(double), n_cols * n_rows);\n68\t    return M;\n69\t}\n70\t\n71\tvoid matrix_free(matrix_t* M) {\n72\t    if (M == NULL)\n73\t        return;\n74\t    free(M->vals);\n75\t    free(M);\n76\t    M = NULL;\n77\t}\n78\t\n79\tvoid matrix_fprintf(FILE* fout, const char* format, const matrix_t* M) {\n80\t    if (M == NULL)\n81\t        return;\n82\t\n83\t    for (size_t r = 0; r < M->n_rows; ++r) {\n84\t        for (size_t c = 0; c < M->n_cols; ++c) {\n85\t            fprintf(fout, format, MATRIX_GET(M, r, c));\n86\t        }\n87\t        fprintf(fout, \"\\n\");\n88\t    }\n89\t}\n90\t"}]},"parent_tool_use_id":null,"session_id":"42a4b48a-aea3-4f67-9f6c-bca263b36df5","uuid":"e5a137d7-f7b3-480d-b69b-59f92ab0da10","timestamp":"2026-06-06T04:28:36.876Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-7M8Dd8/project/c_src/src/avalanche.c","content":"/* avalanche.c\n */\n#include \"avalanche.h\"\n#include <stdio.h>\n#include <stdlib.h>\n\nvoid avalanche(hash_f hash, FILE* ins, uint64_t max_iter, matrix_t* results)\n{\n    size_t key_size = results->n_rows / 8;\n    size_t hash_words = results->n_cols / 32;\n\n    char* key = malloc(key_size);\n    uint32_t* hvalue = malloc(4 * hash_words);\n    uint32_t* htemp = malloc(4 * hash_words);\n\n    uint64_t key_count = 0;\n    while (key_count < max_iter) {\n        size_t n_in = fread(key, 1, key_size, ins);\n        if (n_in < key_size)\n            break;\n\n        hash(key, key_size, hvalue);\n        ++key_count;\n\n        for (size_t i_byte = 0; i_byte < key_size; ++i_byte) {\n            for (size_t i_bit = 0; i_bit < 8; ++i_bit) {\n                size_t row = i_byte * 8 + i_bit;\n\n                // flip the i-th bit of this byte and re-hash\n                char i_mask = 0x80 >> i_bit;\n                key[i_byte] ^= i_mask;\n                hash(key, key_size, htemp);\n                key[i_byte] ^= i_mask;\n\n                for (size_t j_word = 0; j_word < hash_words; ++j_word) {\n                    for (size_t j_bit = 0; j_bit < 32; ++j_bit) {\n                        size_t col = j_word * 32 + j_bit;\n\n                        // test whether hvalue & htemp differ at j-th bit.\n                        uint32_t j_mask = 0x80000000 >> j_bit;\n                        if ((hvalue[j_word] ^ htemp[j_word]) & j_mask) {\n                            double curr = MATRIX_GET(results, row, col);\n                            MATRIX_SET(results, row, col, curr + 1);\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    free(key);\n    free(hvalue);\n    free(htemp);\n\n    if (key_count) {\n        // convert matrix entries to the mean values\n        size_t n_vals = results->n_cols * results->n_rows;\n        for (size_t k = 0; k < n_vals; ++k)\n            results->vals[k] /= key_count;\n    }\n}\n\nmatrix_t* matrix_alloc(size_t n_rows, size_t n_cols) {\n    matrix_t* M = malloc(sizeof(matrix_t));\n    M->n_rows = n_rows;\n    M->n_cols = n_cols;\n    M->vals = calloc(sizeof(double), n_cols * n_rows);\n    return M;\n}\n\nvoid matrix_free(matrix_t* M) {\n    if (M == NULL)\n        return;\n    free(M->vals);\n    free(M);\n    M = NULL;\n}\n\nvoid matrix_fprintf(FILE* fout, const char* format, const matrix_t* M) {\n    if (M == NULL)\n        return;\n\n    for (size_t r = 0; r < M->n_rows; ++r) {\n        for (size_t c = 0; c < M->n_cols; ++c) {\n            fprintf(fout, format, MATRIX_GET(M, r, c));\n        }\n        fprintf(fout, \"\\n\");\n    }\n}\n","numLines":90,"startLine":1,"totalLines":90}}}
