matrix to the given writer using the specified format.\n    pub fn matrix_fprintf(&self, fout: &mut dyn Write, format: &str) {\n        for r in 0..self.n_rows {\n            for c in 0..self.n_cols {\n                let val = self.matrix_get(r, c);\n                let formatted = match sprintf::sprintf!(format, val) {\n                    Ok(s) => s,\n                    Err(_) => format!(\"{}\", val),\n                };\n                let _ = fout.write_all(formatted.as_bytes());\n            }\n            let _ = fout.write_all(b\"\\n\");\n        }\n    }\n    /// Get value from the matrix at (row, col).\n    pub fn matrix_get(&self, row: usize, col: usize) -> f64 {\n        self.vals[row * self.n_cols + col]\n    }\n    /// Set value in the matrix at (row, col).\n    pub fn matrix_set(&mut self, row: usize, col: usize, val: f64) {\n        self.vals[row * self.n_cols + col] = val;\n    }\n}\n","structuredPatch":[{"oldStart":17,"oldLines":23,"newStart":17,"newLines":103,"lines":[" /// All keys read have the same length, so that the key length and size of the"," /// hash value (in words) are parameterized by the row and columns of the matrix."," pub fn avalanche(hash: HashFn, ins: &mut dyn Read, max_iter: u64, results: &mut Matrix) {","-    unimplemented!()","+    let key_size = results.n_rows / 8;","+    let hash_words = results.n_cols / 32;","+","+    let mut key: Vec<u8> = vec![0u8; key_size];","+    let mut hvalue: Vec<u32> = vec![0u32; hash_words];","+    let mut htemp: Vec<u32> = vec![0u32; hash_words];","+","+    let mut key_count: u64 = 0;","+    while key_count < max_iter {","+        // Try to read exactly `key_size` bytes; emulate fread which returns the","+        // number of bytes successfully read, and break if fewer than requested.","+        let mut total_read = 0usize;","+        let mut eof = false;","+        while total_read < key_size {","+            match ins.read(&mut key[total_read..]) {","+                Ok(0) => {","+           