ate_scoreboard(sb, result);\n    log_result(result, stream);\n\n    result = run_error_test_1();\n    update_scoreboard(sb, result);\n    log_result(result, stream);\n\n    result = run_error_test_2();\n    update_scoreboard(sb, result);\n    log_result(result, stream);\n}\n","numLines":102,"startLine":1,"totalLines":102}}}
