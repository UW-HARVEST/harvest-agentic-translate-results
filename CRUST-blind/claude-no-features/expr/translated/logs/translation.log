91\t    FUNC_CBRT,\n92\t    FUNC_TRUNC,\n93\t    FUNC_MIN,\n94\t    FUNC_MAX,\n95\t    FUNC_PI,\n96\t    N_FUNCS\n97\t} expr_func_t;\n98\t\n99\tstatic struct {\n100\t    const char *name;\n101\t    unsigned int arity;\n102\t    void *func;\n103\t} function_table[] = {\n104\t    { \"pow\", 2, powf },\n105\t    { \"sin\", 1, sinf },\n106\t    { \"cos\", 1, cosf },\n107\t    { \"tan\", 1, tanf },\n108\t    { \"abs\", 1, fabsf },\n109\t    { \"sqrt\", 1, sqrtf },\n110\t    { \"log\", 1, logf },\n111\t    { \"log10\", 1, log10f },\n112\t    { \"exp\", 1, expf },\n113\t    { \"floor\", 1, floorf },\n114\t    { \"round\", 1, roundf },\n115\t    { \"ceil\", 1, ceilf },\n116\t    { \"asin\", 1, asinf },\n117\t    { \"acos\", 1, acosf },\n118\t    { \"atan\", 1, atanf },\n119\t    { \"atan2\", 2, atan2f },\n120\t    { \"sinh\", 1, sinhf },\n121\t    { \"cosh\", 1, coshf },\n122\t    { \"tanh\", 1, tanhf },\n123\t    { \"logb\", 1, logbf },\n124\t    { \"exp2\", 1, exp2f },\n125\t    { \"log2\", 1, log2f },\n126\t    { \"hypot\", 2, hypotf },\n127\t    { \"cbrt\", 1, cbrtf },\n128\t    { \"trunc\", 1, truncf },\n129\t    { \"min\", 2, minf },\n130\t    { \"max\", 2, maxf },\n131\t    { \"pi\", 0, pif },\n132\t};\n133\t\n134\ttypedef float func_float_arity0();\n135\ttypedef float func_float_arity1(float);\n136\ttypedef float func_float_arity2(float,float);\n137\t\n138\ttypedef struct _token {\n139\t    enum {\n140\t        TOK_FLOAT,\n141\t        TOK_INT,\n142\t        TOK_OP,\n143\t        TOK_OPEN_PAREN,\n144\t        TOK_CLOSE_PAREN,\n145\t        TOK_VAR,\n146\t        TOK_OPEN_SQUARE,\n147\t        TOK_CLOSE_SQUARE,\n148\t        TOK_OPEN_CURLY,\n149\t        TOK_CLOSE_CURLY,\n150\t        TOK_FUNC,\n151\t        TOK_COMMA,\n152\t        TOK_END,\n153\t        TOK_TOFLOAT,\n154\t        TOK_TOINT32,\n155\t    } type;\n156\t    union {\n157\t        float f;\n158\t        int i;\n159\t        char var;\n160\t        char op;\n161\t        expr_func_t func;\n162\t    };\n163\t} token_t;\n164\t\n165\tstatic expr_func_t function_lookup(const char *s, int len)\n166\t{\n167\t    int i;\n168\t    for (i=0; i<N_FUNCS; i++) {\n169\t        if (strncmp(s, function_table[i].name, len)==0)\n170\t            return i;\n171\t    }\n172\t    return FUNC_UNKNOWN;\n173\t}\n174\t\n175\tstatic int expr_lex(const char **str, token_t *tok)\n176\t{\n177\t    int n=0;\n178\t    char c = **str;\n179\t    const char *s;\n180\t    int integer_found = 0;\n181\t\n182\t    if (c==0) {\n183\t        tok->type = TOK_END;\n184\t        return 0;\n185\t    }\n186\t\n187\t  again:\n188\t\n189\t    if (isdigit(c)) {\n190\t        s = *str;\n191\t        do {\n192\t            c = (*(++*str));\n193\t        } while (c && isdigit(c));\n194\t        n = atoi(s);\n195\t        integer_found = 1;\n196\t        if (c!='.') {\n197\t            tok->i = n;\n198\t            tok->type = TOK_INT;\n199\t            return 0;\n200\t        }\n201\t    }\n202\t\n203\t    switch (c) {\n204\t    case '.':\n205\t        s = *str;\n206\t        c = (*(++*str));\n207\t        if (!isdigit(c) && integer_found) {\n208\t            tok->type = TOK_FLOAT;\n209\t            tok->f = (float)n;\n210\t            return 0;\n211\t        }\n212\t        if (!isdigit(c))\n213\t            break;\n214\t        do {\n215\t            c = (*(++*str));\n216\t        } while (c && isdigit(c));\n217\t        tok->f = (float)n + atof(s);\n218\t        tok->type = TOK_FLOAT;\n219\t        return 0;\n220\t    case '+':\n221\t    case '-':\n222\t    case '/':\n223\t    case '*':\n224\t    case '=':\n225\t        tok->type = TOK_OP;\n226\t        tok->op = c;\n227\t        ++*str;\n228\t        return 0;\n229\t    case '(':\n230\t        tok->type = TOK_OPEN_PAREN;\n231\t        ++*str;\n232\t        return 0;\n233\t    case ')':\n234\t        tok->type = TOK_CLOSE_PAREN;\n235\t        ++*str;\n236\t        return 0;\n237\t    case 'x':\n238\t    case 'y':\n239\t        tok->type = TOK_VAR;\n240\t        tok->var = c;\n241\t        ++*str;\n242\t        return 0;\n243\t    case '[':\n244\t        tok->type = TOK_OPEN_SQUARE;\n245\t        ++*str;\n246\t        return 0;\n247\t    case ']':\n248\t        tok->type = TOK_CLOSE_SQUARE;\n249\t        ++*str;\n250\t        return 0;\n251\t    case '{':\n252\t        tok->type = TOK_OPEN_CURLY;\n253\t        ++*str;\n254\t        return 0;\n255\t    case '}':\n256\t        tok->type = TOK_CLOSE_CURLY;\n257\t        ++*str;\n258\t        return 0;\n259\t    case ' ':\n260\t    case '\\t':\n261\t    case '\\r':\n262\t    case '\\n':\n263\t        c = (*(++*str));\n264\t        goto again;\n265\t    case ',':\n266\t        tok->type = TOK_COMMA;\n267\t        ++*str;\n268\t        return 0;\n269\t    default:\n270\t        if (!isalpha(c)) {\n271\t            printf(\"unknown character '%c' in lexer\\n\", c);\n272\t            break;\n273\t        }\n274\t        s = *str;\n275\t        while (c && (isalpha(c) || isdigit(c)))\n276\t            c = (*(++*str));\n277\t        tok->type = TOK_FUNC;\n278\t        tok->func = function_lookup(s, *str-s);\n279\t        return 0;\n280\t    }\n281\t\n282\t    return 1;\n283\t}\n284\t\n285\ttypedef struct _exprnode\n286\t{\n287\t    token_t tok;\n288\t    int is_float;\n289\t    int history_index;  // when tok.type==TOK_VAR\n290\t    int vector_index;   // when tok.type==TOK_VAR\n291\t    struct _exprnode *next;\n292\t} *exprnode;\n293\t\n294\tstruct _mapper_expr\n295\t{\n296\t    exprnode node;\n297\t    int vector_size;\n298\t    int history_size;\n299\t    int history_pos;\n300\t    mapper_signal_value_t *input_history;\n301\t    mapper_signal_value_t *output_history;\n302\t};\n303\t\n304\ttypedef enum {\n305\t    YEQUAL_Y,\n306\t    YEQUAL_EQ,\n307\t    EXPR,\n308\t    EXPR_RIGHT,\n309\t    TERM,\n310\t    TERM_RIGHT,\n311\t    VALUE,\n312\t    NEGATE,\n313\t    VAR_RIGHT,\n314\t    VAR_VECTINDEX,\n315\t    VAR_HISTINDEX,\n316\t    CLOSE_VECTINDEX,\n317\t    CLOSE_HISTINDEX,\n318\t    OPEN_PAREN,\n319\t    CLOSE_PAREN,\n320\t    COMMA,\n321\t    END,\n322\t} state_t;\n323\t\n324\ttypedef struct _stack_obj\n325\t{\n326\t    union {\n327\t        state_t state;\n328\t        exprnode node;\n329\t    };\n330\t    enum {\n331\t        ST_STATE,\n332\t        ST_NODE,\n333\t    } type;\n334\t} stack_obj_t;\n335\t\n336\tstatic exprnode exprnode_new(token_t *tok, int is_float)\n337\t{\n338\t    exprnode t = (exprnode)\n339\t        malloc(sizeof(struct _exprnode));\n340\t    t->tok = *tok;\n341\t    t->is_float = is_float;\n342\t    t->history_index = 0;\n343\t    t->vector_index = 0;\n344\t    t->next = 0;\n345\t    return t;\n346\t}\n347\t\n348\tstatic void exprnode_free(exprnode e)\n349\t{\n350\t    while (e) {\n351\t        exprnode tmp = e;\n352\t        e = e->next;\n353\t        free(tmp);\n354\t    }\n355\t}\n356\t\n357\tvoid mapper_expr_free(mapper_expr expr)\n358\t{\n359\t    exprnode_free(expr->node);\n360\t    free(expr->input_history);\n361\t    free(expr->output_history);\n362\t    free(expr);\n363\t}\n364\t\n365\t#ifdef DEBUG\n366\tvoid printtoken(token_t *tok)\n367\t{\n368\t    switch (tok->type) {\n369\t    case TOK_FLOAT:        printf(\"%f\", tok->f);          break;\n370\t    case TOK_INT:          printf(\"%d\", tok->i);          break;\n371\t    case TOK_OP:           printf(\"%c\", tok->op);         break;\n372\t    case TOK_OPEN_PAREN:   printf(\"(\");                   break;\n373\t    case TOK_CLOSE_PAREN:  printf(\")\");                   break;\n374\t    case TOK_VAR:          printf(\"VAR(%c)\", tok->var);   break;\n375\t    case TOK_OPEN_SQUARE:  printf(\"[\");                   break;\n376\t    case TOK_CLOSE_SQUARE: printf(\"]\");                   break;\n377\t    case TOK_OPEN_CURLY:   printf(\"{\");                   break;\n378\t    case TOK_CLOSE_CURLY:  printf(\"}\");                   break;\n379\t    case TOK_FUNC:         printf(\"FUNC(%s)\",\n380\t                                  function_table[tok->func].name);\n381\t        break;\n382\t    case TOK_COMMA:        printf(\",\");                   break;\n383\t    case TOK_END:          printf(\"END\");                 break;\n384\t    case TOK_TOFLOAT:      printf(\"(float)\");             break;\n385\t    case TOK_TOINT32:      printf(\"(int32)\");             break;\n386\t    default:               printf(\"(unknown token)\");     break;\n387\t    }\n388\t}\n389\t\n390\tvoid printexprnode(const char *s, exprnode list)\n391\t{\n392\t    printf(\"%s\", s);\n393\t    while (list) {\n394\t        if (list->is_float\n395\t            && list->tok.type != TOK_FLOAT\n396\t            && list->tok.type != TOK_TOFLOAT)\n397\t            printf(\".\");\n398\t        printtoken(&list->tok);\n399\t        if (list->tok.type == TOK_VAR) {\n400\t            if (list->history_index < 0)\n401\t                printf(\"{%d}\", list->history_index);\n402\t            if (list->vector_index > -1)\n403\t                printf(\"[%d]\", list->vector_index);\n404\t        }\n405\t        list = list->next;\n406\t        if (list) printf(\" \");\n407\t    }\n408\t}\n409\t\n410\tvoid printexpr(const char*s, mapper_expr e)\n411\t{\n412\t    printexprnode(s, e->node);\n413\t}\n414\t\n415\tvoid printstack(stack_obj_t *stack, int top)\n416\t{\n417\t    const char *state_name[] = {\n418\t        \"YEQUAL_Y\", \"YEQUAL_EQ\", \"EXPR\", \"EXPR_RIGHT\", \"TERM\",\n419\t        \"TERM_RIGHT\", \"VALUE\", \"NEGATE\", \"VAR_RIGHT\",\n420\t        \"VAR_VECTINDEX\", \"VAR_HISTINDEX\", \"CLOSE_VECTINDEX\",\n421\t        \"CLOSE_HISTINDEX\", \"OPEN_PAREN\", \"CLOSE_PAREN\",\n422\t        \"COMMA\", \"END\" };\n423\t\n424\t    int i;\n425\t    printf(\"Stack: \");\n426\t    for (i=0; i<=top; i++) {\n427\t        if (stack[i].type == ST_NODE) {\n428\t            printf(\"[\");\n429\t            printexprnode(\"\", stack[i].node);\n430\t            printf(\"] \");\n431\t            continue;\n432\t        }\n433\t        printf(\"%s \", state_name[stack[i].state]);\n434\t    }\n435\t    printf(\"\\n\");\n436\t}\n437\t#endif\n438\t\n439\tstatic void collapse_expr_to_left(exprnode* plhs, exprnode rhs,\n440\t                                  int constant_folding)\n441\t{\n442\t    // track whether any variable references\n443\t    int refvar = 0;\n444\t    int is_float = 0;\n445\t\n446\t    // find trailing operator on right hand side\n447\t    exprnode rhs_last = rhs;\n448\t    if (rhs->tok.type == TOK_VAR)\n449\t        refvar = 1;\n450\t    while (rhs_last->next) {\n451\t        if (rhs_last->tok.type == TOK_VAR)\n452\t            refvar = 1;\n453\t        rhs_last = rhs_last->next;\n454\t    }\n455\t\n456\t    // find pointer to insertion place:\n457\t    // - could be a function that needs args,\n458\t    // - otherwise assume it's before the trailing operator\n459\t    exprnode *plhs_last = plhs;\n460\t    if ((*plhs_last)->tok.type == TOK_VAR)\n461\t        refvar = 1;\n462\t    while ((*plhs_last)->next) {\n463\t        if ((*plhs_last)->tok.type == TOK_VAR)\n464\t            refvar = 1;\n465\t        plhs_last = &(*plhs_last)->next;\n466\t    }\n467\t\n468\t    // insert float coersion if sides disagree on type\n469\t    token_t coerce;\n470\t    coerce.type = TOK_TOFLOAT;\n471\t    is_float = (*plhs_last)->is_float || rhs_last->is_float;\n472\t    if ((*plhs_last)->is_float && !rhs_last->is_float) {\n473\t        rhs_last = rhs_last->next = exprnode_new(&coerce, 1);\n474\t    } else if (!(*plhs_last)->is_float && rhs_last->is_float) {\n475\t        exprnode e = exprnode_new(&coerce, 1);\n476\t        e->next = (*plhs_last);\n477\t        (*plhs_last) = e;\n478\t        plhs_last = &e->next;\n479\t        e->next->is_float = 1;\n480\t    }\n481\t\n482\t    // insert the list before the trailing op of left hand side\n483\t    rhs_last->next = (*plhs_last);\n484\t    (*plhs_last) = rhs;\n485\t\n486\t    // if there were no variable references, then expression is\n487\t    // constant, so evaluate it immediately\n488\t    if (constant_folding && !refvar) {\n489\t        struct _mapper_expr e;\n490\t        e.node = *plhs;\n491\t        mapper_signal_value_t v;\n492\t        mapper_expr_evaluate(&e, 0, &v);\n493\t\n494\t        exprnode_free((*plhs)->next);\n495\t        (*plhs)->next = 0;\n496\t        (*plhs)->is_float = is_float;\n497\t\n498\t        if (is_float) {\n499\t            (*plhs)->tok.type = TOK_FLOAT;\n500\t            (*plhs)->tok.f = v.f;\n501\t        }\n502\t        else {\n503\t            (*plhs)->tok.type = TOK_INT;\n504\t            (*plhs)->tok.i = v.i32;\n505\t        }\n506\t    }\n507\t}\n508\t\n509\t/* Macros to help express stack operations in parser. */\n510\t#define PUSHSTATE(x) { top++; stack[top].state = x; stack[top].type = ST_STATE; }\n511\t#define PUSHEXPR(x, f) { top++; stack[top].node = exprnode_new(&x, f); stack[top].type = ST_NODE; }\n512\t#define POP() (top--)\n513\t#define TOPSTATE_IS(x) (stack[top].type == ST_STATE && stack[top].state == x)\n514\t#define APPEND_OP(x)                                                    \\\n515\t    if (stack[top].type == ST_NODE) {                                   \\\n516\t        exprnode e = stack[top].node;                                   \\\n517\t        while (e->next) e = e->next;                                    \\\n518\t        e->next = exprnode_new(&tok, 0);                                \\\n519\t        e->next->is_float = e->is_float;                                \\\n520\t    }\n521\t#define SUCCESS(x) { result = x; goto done; }\n522\t#define FAIL(msg) { error_message = msg; result = 0; goto done; }\n523\t\n524\t/*! Create a new expression by parsing the given string. */\n525\tmapper_expr mapper_expr_new_from_string(const char *str,\n526\t                                        int input_is_float,\n527\t                                        int output_is_float,\n528\t                                        int vector_size)\n529\t{\n530\t    const char *s = str;\n531\t    if (!str) return 0;\n532\t    stack_obj_t stack[STACK_SIZE];\n533\t    int top = -1;\n534\t    exprnode result = 0;\n535\t    const char *error_message = 0;\n536\t\n537\t    token_t tok;\n538\t    int i, next_token = 1;\n539\t\n540\t    int var_allowed = 1;\n541\t    float oldest_samps = 0;\n542\t\n543\t    PUSHSTATE(EXPR);\n544\t    PUSHSTATE(YEQUAL_EQ);\n545\t    PUSHSTATE(YEQUAL_Y);\n546\t\n547\t    while (top >= 0) {\n548\t        if (next_token && expr_lex(&s, &tok))\n549\t            {FAIL(\"Error in lexical analysis.\");}\n550\t        next_token = 0;\n551\t\n552\t        if (stack[top].type == ST_NODE) {\n553\t            if (top==0)\n554\t                SUCCESS(stack[top].node);\n555\t            if (stack[top-1].type == ST_STATE) {\n556\t                if (top >= 2 && stack[top-2].type == ST_NODE) {\n557\t                    if (stack[top-1].type == ST_STATE\n558\t                        && (stack[top-1].state == EXPR_RIGHT\n559\t                            || stack[top-1].state == TERM_RIGHT\n560\t                            || stack[top-1].state == CLOSE_PAREN))\n561\t                    {\n562\t                        collapse_expr_to_left(&stack[top-2].node,\n563\t                                              stack[top].node, 1);\n564\t                        POP();\n565\t                    }\n566\t                    else if (stack[top-1].type == ST_STATE\n567\t                             && stack[top-1].state == CLOSE_HISTINDEX)\n568\t                    {\n569\t                        die_unless(stack[top-2].node->tok.type == TOK_VAR,\n570\t                                   \"expected VAR two-down on the stack.\\n\");\n571\t                        die_unless(!stack[top].node->next && (stack[top].node->tok.type == TOK_INT\n572\t                                                              || stack[top].node->tok.type == TOK_FLOAT),\n573\t                                   \"expected lonely INT or FLOAT expression on the stack.\\n\");\n574\t                        if (stack[top].node->tok.type == TOK_FLOAT)\n575\t                            stack[top-2].node->history_index = (int)stack[top].node->tok.f;\n576\t                        else\n577\t                            stack[top-2].node->history_index = stack[top].node->tok.i;\n578\t\n579\t                        /* Track the oldest history reference in order\n580\t                         * to know how much buffer needs to be\n581\t                         * allocated for this expression. */\n582\t                        if (oldest_samps > stack[top-2].node->history_index)\n583\t                            oldest_samps = stack[top-2].node->history_index;\n584\t\n585\t                        exprnode_free(stack[top].node);\n586\t                        POP();\n587\t                    }\n588\t                    else if (stack[top-1].type == ST_STATE\n589\t                             && stack[top-1].state == CLOSE_VECTINDEX)\n590\t                    {\n591\t                        die_unless(stack[top-2].node->tok.type == TOK_VAR,\n592\t                                   \"expected VAR two-down on the stack.\\n\");\n593\t                        die_unless(!stack[top].node->next && (stack[top].node->tok.type == TOK_INT\n594\t                                                              || stack[top].node->tok.type == TOK_FLOAT),\n595\t                                   \"expected lonely INT or FLOAT expression on the stack.\\n\");\n596\t                        if (stack[top].node->tok.type == TOK_FLOAT)\n597\t                            stack[top-2].node->vector_index = (int)stack[top].node->tok.f;\n598\t                        else\n599\t                            stack[top-2].node->vector_index = stack[top].node->tok.i;\n600\t                        if (stack[top-2].node->vector_index > 0)\n601\t                            {FAIL(\"Vector indexing not yet implemented.\");}\n602\t                        if (stack[top-2].node->vector_index < 0\n603\t                            || stack[top-2].node->vector_index >= vector_size)\n604\t                            {FAIL(\"Vector index outside input size.\");}\n605\t\n606\t                        exprnode_free(stack[top].node);\n607\t                        POP();\n608\t                    }\n609\t                }\n610\t                else {\n611\t                    // swap the expression down the stack\n612\t                    stack_obj_t tmp = stack[top-1];\n613\t                    stack[top-1] = stack[top];\n614\t                    stack[top] = tmp;\n615\t                }\n616\t            }\n617\t\n618\t#if TRACING\n619\t            printstack(&stack[0], top);\n620\t#endif\n621\t            continue;\n622\t        }\n623\t\n624\t        switch (stack[top].state) {\n625\t        case YEQUAL_Y:\n626\t            if (tok.type == TOK_VAR && tok.var == 'y')\n627\t                POP();\n628\t            else\n629\t                {FAIL(\"Error in y= prefix.\");}\n630\t            next_token = 1;\n631\t            break;\n632\t        case YEQUAL_EQ:\n633\t            if (tok.type == TOK_OP && tok.op == '=') {\n634\t                POP();\n635\t            } else {\n636\t                {FAIL(\"Error in y= prefix.\");}\n637\t            }\n638\t            next_token = 1;\n639\t            break;\n640\t        case EXPR:\n641\t            POP();\n642\t            PUSHSTATE(EXPR_RIGHT);\n643\t            PUSHSTATE(TERM);\n644\t            break;\n645\t        case EXPR_RIGHT:\n646\t            if (tok.type == TOK_OP) {\n647\t                POP();\n648\t                if (tok.op == '+' || tok.op == '-') {\n649\t                    APPEND_OP(tok);\n650\t                    PUSHSTATE(EXPR);\n651\t                    next_token = 1;\n652\t                }\n653\t            }\n654\t            else POP();\n655\t            break;\n656\t        case TERM:\n657\t            POP();\n658\t            PUSHSTATE(TERM_RIGHT);\n659\t            PUSHSTATE(VALUE);\n660\t            break;\n661\t        case TERM_RIGHT:\n662\t            if (tok.type == TOK_OP) {\n663\t                POP();\n664\t                if (tok.op == '*' || tok.op == '/') {\n665\t                    APPEND_OP(tok);\n666\t                    PUSHSTATE(TERM);\n667\t                    next_token = 1;\n668\t                }\n669\t            }\n670\t            else POP();\n671\t            break;\n672\t        case VALUE:\n673\t            if (tok.type == TOK_INT) {\n674\t                POP();\n675\t                PUSHEXPR(tok, 0);\n676\t                next_token = 1;\n677\t            } else if (tok.type == TOK_FLOAT) {\n678\t                POP();\n679\t                PUSHEXPR(tok, 1);\n680\t                next_token = 1;\n681\t            } else if (tok.type == TOK_VAR) {\n682\t                if (var_allowed) {\n683\t                    POP();\n684\t                    PUSHEXPR(tok, input_is_float);\n685\t                    PUSHSTATE(VAR_RIGHT);\n686\t                    next_token = 1;\n687\t                }\n688\t                else\n689\t                    {FAIL(\"Unexpected variable reference.\");}\n690\t            } else if (tok.type == TOK_OPEN_PAREN) {\n691\t                POP();\n692\t                PUSHSTATE(CLOSE_PAREN);\n693\t                PUSHSTATE(EXPR);\n694\t                next_token = 1;\n695\t            } else if (tok.type == TOK_FUNC) {\n696\t                POP();\n697\t                if (tok.func == FUNC_UNKNOWN)\n698\t                    {FAIL(\"Unknown function.\");}\n699\t                else {\n700\t                    PUSHEXPR(tok, 1);\n701\t                    int arity = function_table[tok.func].arity;\n702\t                    if (arity > 0) {\n703\t                        PUSHSTATE(CLOSE_PAREN);\n704\t                        PUSHSTATE(EXPR);\n705\t                        for (i=1; i < arity; i++) {\n706\t                            PUSHSTATE(COMMA);\n707\t                            PUSHSTATE(EXPR);\n708\t                