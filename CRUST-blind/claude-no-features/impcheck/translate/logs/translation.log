ze = (u64) (ht->growth_factor * ht->max_size);\n54\t    ht->capacity = new_capacity;\n55\t    for (u64 i = 0; i < old_capacity; i++) {\n56\t        struct hash_table_entry* cell = &old_data[i];\n57\t        if (!cell_empty(cell)) {\n58\t            if (!hash_table_insert(ht, cell->key, cell->val))\n59\t                return false;\n60\t        }\n61\t    }\n62\t    free(old_data);\n63\t    return true;\n64\t}\n65\t\n66\tbool handle_gap(struct hash_table* ht, u64 idx_of_gap) {\n67\t\n68\t    u64 i = idx_of_gap;\n69\t    u64 j = i;\n70\t    while (true) {\n71\t        // search forward through the following cells of the table\n72\t        // until finding either another empty cell or a key that\n73\t        // can be moved to cell i (that is, a key whose hash value\n74\t        // is equal to or earlier than i)\n75\t\n76\t        j = (j+1) & (ht->capacity-1);\n77\t        if (cell_empty(&ht->data[j])) {\n78\t            // empty cell found!\n79\t            // When an empty cell is found, then emptying cell i\n80\t            // is safe and the deletion process terminates.\n81\t            struct hash_table_entry* entry = &ht->data[i];\n82\t            entry->key = 0;\n83\t            entry->val = 0;\n84\t            return true;\n85\t        }\n86\t\n87\t        u64 k = compute_idx(ht, ht->data[j].key);\n88\t        if ((j > i && (k <= i || k > j)) \n89\t            || (j < i && k <= i && k > j)) {\n90\t\n91\t            // movable cell found!\n92\t            // when the search finds a key that can be moved to cell i, it performs this move.\n93\t            struct hash_table_entry* entry_at_deletion = &ht->data[i];\n94\t            struct hash_table_entry* entry2move = &ht->data[j];\n95\t            *entry_at_deletion = *entry2move;\n96\t            entry2move->key = 0;\n97\t            entry2move->val = 0;\n98\t\n99\t            // This empties out another cell, later in the same block of occupied cells.\n100\t            // The search for a movable key continues 