  growth_factor: 2.0,\n            capacity,\n            data,\n            last_found_idx: 0,\n        }\n    }\n\n    pub fn realloc_table(&mut self) -> bool {\n        let new_capacity = (self.growth_factor * self.capacity as f32) as u64;\n        if new_capacity <= self.capacity {\n            return false;\n        }\n        let mut new_entries: Vec<HashTableEntry<'a, T>> = Vec::with_capacity(new_capacity as usize);\n        for _ in 0..new_capacity {\n            new_entries.push(make_empty_entry::<'a, T>());\n        }\n        let leaked: &'static mut [HashTableEntry<'static, T>] =\n            Box::leak(new_entries.into_boxed_slice());\n        let new_data: &'a mut [HashTableEntry<'a, T>] = unsafe { std::mem::transmute(leaked) };\n\n        // Re-insert old entries into new_data using their keys.\n        let old_capacity = self.capacity;\n        let old_data = std::mem::replace(&mut self.data, new_data);\n        self.capacity = new_capacity;\n        self.size = 0;\n        self.max_size = (self.growth_factor * self.max_size as f32) as u64;\n\n        for i in 0..(old_capacity as usize) {\n            // SAFETY: we drop the old leaked box at the end, so we briefly\n            // access old entries by index via raw pointer.\n            let ptr: *const HashTableEntry<'a, T> = old_data.as_ptr();\n            let key = unsafe { (*ptr.add(i)).key };\n            if key != 0 {\n                let mut idx: u64 = 0;\n                if !self.find_entry(key, &mut idx) {\n                    self.data[idx as usize].key = key;\n                    self.size += 1;\n                }\n            }\n        }\n\n        // Reclaim the old leaked slice\n        let old_ptr = old_data.as_mut_ptr();\n        let old_len = old_data.len();\n        unsafe {\n            let _ = Box::from_raw(std::slice::from_raw_parts_mut(old_ptr, old_len));\n        }\n        true\n    }\n\n    pub fn hash_table_find(&self, _key: u64) -> Option<&Box<dyn std::any::Any>> {\n        