 fn siphash_init(key_128bit: &[u8]) -> Self {","+        let mut s = SipHash {","+            kk: key_128bit.to_vec(),","+            out: vec![0u8; OUTLEN],","+            buf: vec![0u8; 8],","+            v0: 0,","+            v1: 0,","+            v2: 0,","+            v3: 0,","+            inlen: 0,","+            buflen: 0,","+        };","+        if !s.kk.is_empty() {","+            s.siphash_reset();","+        }","+        s","+    }","+","+    pub fn siphash_reset(&mut self) {","+        self.v0 = 0x736f6d6570736575u64;","+        self.v1 = 0x646f72616e646f6du64;","+        self.v2 = 0x6c7967656e657261u64;","+        self.v3 = 0x7465646279746573u64;","+        let k0 = u8to64_le(&self.kk[0..8]);","+        let k1 = u8to64_le(&self.kk[8..16]);","+        self.v3 ^= k1;","+        self.v2 ^= k0;","+        self.v1 ^= k1;","+        self.v0 ^= k0;","+        self.inlen = 0;","+        self.buflen = 0;","+        if OUTLEN == 16 {","+            self.v1 ^= 0xee;","+        }","+    }","+","+    pub fn siphash_digest(&self) -> Vec<u8> {","+        // Compute the final block on a clone, since digest() takes &self.","+        let mut copy = SipHash {","+            kk: self.kk.clone(),","+            out: self.out.clone(),","+            buf: self.buf.clone(),","+            v0: self.v0,","+            v1: self.v1,","+            v2: self.v2,","+            v3: self.v3,","+            inlen: self.inlen,","+            buflen: self.buflen,","+        };","+        copy.process_final_block();","+        copy.out","+    }","+","+    pub fn siphash_free(&mut self) {","+        self.buf.clear();","+        self.out.clear();","+        self.kk.clear();","+    }"," }","-pub fn siphash_init(key_128bit: &[u8]) -> Self {","-unimplemented!()","-}","-pub fn siphash_reset(&mut self) {","-unimplemented!()","-}","-pub fn siphash_digest(&self) -> Vec<u8> {","-unimplemented!()","-}","-pub fn siphash_free(&mut self) {","-unimplemented!()","-}","-}","\\ No newline at end of file"]}