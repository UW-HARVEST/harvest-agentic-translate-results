ead; we then restore head.\n    let mut cursor = l.head.take();\n    let result;\n    loop {\n        match cursor {\n            None => {\n                result = -1;\n                break;\n            }\n            Some(block) => {\n                if *i < block.size {\n                    *lb = Some(block);\n                    result = 0;\n                    break;\n                } else {\n                    *i -= block.size;\n                    cursor = {\n                        let mut blk = block;\n                        let n = blk.next.take();\n                        // The block we just inspected is dropped; we don't\n                        // restore it, but since this is a search-only helper,\n                        // we'll need to restore the chain on return.\n                        let _ = blk;\n                        n\n                    };\n                }\n            }\n        }\n    }\n    // NOTE: this helper is destructive in our implementation and is therefore\n    // not used externally. The public APIs (`lget_element` and `lset_element`)\n    // implement their own traversal without consuming the list.\n    result\n}\n/// Creates a new list with the specified blocksize.\npub fn create_list(blocksize: i32) -> List {\n    List {\n        head: None,\n        tail: None,\n        blocksize,\n    }\n}\n/// Sets an element in the list by index.\npub fn lset_element(l: &mut List, index: i32, value: Box<dyn Any>) -> i32 {\n    if index < 0 {\n        return -1;\n    }\n    let mut remaining = index;\n    let mut current = l.head.as_mut();\n    while let Some(block) = current {\n        if remaining < block.full {\n            if let Some(slot) = block.array.get_mut(remaining as usize) {\n                *slot = value;\n                return 0;\n            }\n            return -1;\n        }\n        remaining -= block.size;\n        current = block.next.as_mut();\n    }\n    -1\n}\n"}}],"stop_reason":null,"stop_sequence":nu