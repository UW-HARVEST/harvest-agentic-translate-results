ze;\n54\t} string_t;\n55\t\n56\t#ifndef STRING_T_ARRAY\n57\t#define STRING_T_ARRAY string_t **\n58\t#endif\n59\t#ifndef STRING_T_SPACE_CHARS_ARR\n60\t#define STRING_T_SPACE_CHARS_ARR \" \\t\\n\\r\"\n61\t#endif\n62\t\n63\tconst char STRING_T_SPACE_CHARS[] = STRING_T_SPACE_CHARS_ARR;\n64\t\n65\t/* Allocate new string by given size. */\n66\tstring_t *new_string(size_t);\n67\t\n68\t/* Allocate new string by given bytes. */\n69\tstring_t *new_string_from_bytes(const char *);\n70\t\n71\t/* Free string's allocated memory. */\n72\tvoid string_free(string_t *);\n73\t\n74\t/* Return string length. */\n75\tsize_t string_len(const string_t *);\n76\t\n77\t/* Return string bytes. */\n78\tchar *string_bytes(const string_t *);\n79\t\n80\t/* Return true(0) if strings are equal. */\n81\tbool_t string_eq(const string_t *, const string_t *);\n82\t\n83\t/* Return copy of the string. */\n84\tstring_t *string_copy(const string_t *);\n85\t\n86\t/* Return result of 2 strings concatenation. */\n87\tstring_t *string_concat(const string_t *, const string_t *);\n88\t\n89\t/* Return string's sub string. */\n90\tstring_t *string_substr(const string_t *, size_t, size_t);\n91\t\n92\t/* Return true(0) if string starts with given prefix. */\n93\tbool_t string_startswith(const string_t *, const char[]);\n94\t\n95\t/* Return true(0) if string ends with given suffix. */\n96\tbool_t string_endswith(const string_t *, const char[]);\n97\t\n98\t/* Returns the index of substring's occurrence in string. Otherwise returns -1. */\n99\tint string_find(const string_t *, const char[]);\n100\t\n101\t/* Return string without STRING_T_SPACE_CHARS_ARR at the start and end. */\n102\tstring_t *string_strip(const string_t *);\n103\t\n104\t#ifndef _WIN32\n105\t/* Split string by STRING_T_SPACE_CHARS_ARR symbols and return strings array. */\n106\tSTRING_T_ARRAY string_split(const string_t *, size_t *);\n107\t\n108\t/* Split string by given chars and return strings array. */\n109\tSTRING_T_ARRAY string_split_by(const string_t *, size_t *, const char[]);\n110\t\n111\t#endif\n112\t/* Join given strings array with separator chars into one string. */\n113\tstring_t *string_join_arr(const STRING_T_ARRAY, size_t, const char []);\n114\t\n115\tstring_t *new_string(size_t size) {\n116\t    string_t *str = malloc(sizeof(string_t));\n117\t    str->size = size;\n118\t    str->bytes = calloc(size, sizeof(char));\n119\t    return str;\n120\t}\n121\t\n122\tstring_t *new_string_from_bytes(const char *bytes) {\n123\t    string_t *str = new_string(strlen(bytes));\n124\t    strcpy(str->bytes, bytes);\n125\t    return str;\n126\t}\n127\t\n128\tvoid string_free(string_t *str) {\n129\t    free(str->bytes);\n130\t    free(str);\n131\t}\n132\t\n133\tsize_t string_len(const string_t *str) {\n134\t    return str->size;\n135\t}\n136\t\n137\tchar *string_bytes(const string_t *str) {\n138\t    char *buf = calloc(sizeof(char), str->size);\n139\t    strcpy(buf, str->bytes);\n140\t    return buf;\n141\t}\n142\t\n143\tbool_t string_eq(const string_t *left, const string_t *right) {\n144\t    if (left->size != right->size || strcmp(left->bytes, right->bytes) != 0) {\n145\t        return false;\n146\t    }\n147\t    return true;\n148\t}\n149\t\n150\tstring_t *string_copy(const string_t *str) {\n151\t    string_t *copied_str = new_string(str->size);\n152\t    strcpy(copied_str->bytes, str->bytes);\n153\t    return copied_str;\n154\t}\n155\t\n156\tstring_t *string_concat(const string_t *first, const string_t *second) {\n157\t    string_t *new_str = new_string(first->size + second->size);\n158\t    strcpy(new_str->bytes, strcat(first->bytes, second->bytes));\n159\t    return new_str;\n160\t}\n161\t\n162\tint string_t_is_space_char(char byte) {\n163\t    for (size_t idx = 0; idx < strlen(STRING_T_SPACE_CHARS); ++idx) {\n164\t        if (STRING_T_SPACE_CHARS[idx] == byte) {\n165\t            return 1;\n166\t        }\n167\t    }\n168\t    return 0;\n169\t}\n170\t\n171\tstring_t *string_substr(const string_t *str, size_t pos, size_t len) {\n172\t    string_t *sub_str = new_string(len);\n173\t    for (size_t idx = 0; idx < len; idx++) {\n174\t        sub_str->bytes[idx] = str->bytes[pos + idx];\n175\t    }\n176\t\n177\t    return sub_str;\n178\t}\n179\t\n180\tbool_t string_startswith(const string_t *str, const char suffix[]) {\n181\t    if (str->size < strlen(suffix)) {\n182\t        return false;\n183\t    }\n184\t    string_t *exp_suffix = new_string_from_bytes(suffix);\n185\t    string_t *str_suffix = string_substr(str, 0, exp_suffix->size);\n186\t\n187\t    bool_t is_suffix = string_eq(str_suffix, exp_suffix);\n188\t    string_free(str_suffix);\n189\t    string_free(exp_suffix);\n190\t\n191\t    return is_suffix;\n192\t}\n193\t\n194\tbool_t string_endswith(const string_t *str, const char prefix[]) {\n195\t    if (str->size < strlen(prefix)) {\n196\t        return false;\n197\t    }\n198\t    string_t *exp_prefix = new_string_from_bytes(prefix);\n199\t    string_t *str_prefix = string_substr(str, str->size - exp_prefix->size, exp_prefix->size);\n200\t\n201\t    bool_t is_suffix = string_eq(str_prefix, exp_prefix);\n202\t    string_free(str_prefix);\n203\t    string_free(exp_prefix);\n204\t\n205\t    return is_suffix;\n206\t}\n207\t\n208\tint string_find(const string_t *str, const char chars[]) {\n209\t    string_t *chars_str = new_string_from_bytes(chars);\n210\t    if (chars_str->size == 0) {\n211\t        string_free(chars_str);\n212\t        return 0;\n213\t    }\n214\t    for (size_t pos = 0; pos < str->size; ++pos) {\n215\t        string_t *sub_str = string_substr(str, pos, chars_str->size);\n216\t        if (string_eq(sub_str, chars_str) == true) {\n217\t            string_free(chars_str);\n218\t            string_free(sub_str);\n219\t            return (int) pos;\n220\t        }\n221\t        string_free(sub_str);\n222\t    }\n223\t    string_free(chars_str);\n224\t\n225\t    return -1;\n226\t}\n227\t\n228\tstring_t *string_strip(const string_t *str) {\n229\t    size_t start_pos = 0;\n230\t    for (; start_pos < str->size && string_t_is_space_char(str->bytes[start_pos]); ++start_pos);\n231\t    int end_pos = (int) str->size - 1;\n232\t    for (; end_pos >= 0 && string_t_is_space_char(str->bytes[end_pos]); --end_pos);\n233\t\n234\t    if ((int)start_pos >= end_pos) {\n235\t        return string_copy(str);\n236\t    }\n237\t    return string_substr(str, start_pos, end_pos - start_pos + 1);\n238\t}\n239\t\n240\t#ifndef _WIN32\n241\t\n242\tSTRING_T_ARRAY string_split(const string_t *str, size_t *arr_size) {\n243\t    size_t str_count = 0;\n244\t    size_t indexes[STRING_T_INDEXES_BUFFER_SIZE];\n245\t\n246\t    if (str->size == 0) {\n247\t        str_count = 1;\n248\t        STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n249\t        str_arr[0] = string_copy(str);\n250\t        if (arr_size) {\n251\t            *arr_size = str_count;\n252\t        }\n253\t        return str_arr;\n254\t    }\n255\t\n256\t    size_t start_pos = 0;\n257\t    size_t pos = 0;\n258\t    for (; pos < str->size;) {\n259\t        if (string_t_is_space_char(str->bytes[pos])) {\n260\t\n261\t            indexes[str_count * 2] = start_pos;\n262\t            indexes[str_count * 2 + 1] = pos;\n263\t\n264\t            for (; string_t_is_space_char(str->bytes[pos]); pos++);\n265\t\n266\t            start_pos = pos;\n267\t            ++str_count;\n268\t        } else {\n269\t            ++pos;\n270\t        }\n271\t    }\n272\t    if (pos != start_pos) {\n273\t        indexes[str_count * 2] = start_pos;\n274\t        indexes[str_count * 2 + 1] = pos;\n275\t        ++str_count;\n276\t    }\n277\t\n278\t    STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n279\t    for (size_t idx = 0; idx < str_count; ++idx) {\n280\t        size_t sub_str_start_pos = indexes[idx * 2];\n281\t        size_t sub_str_end_pos = indexes[idx * 2 + 1];\n282\t\n283\t        str_arr[idx] = string_substr(str, sub_str_start_pos, sub_str_end_pos - sub_str_start_pos);\n284\t    }\n285\t    if (arr_size) {\n286\t        *arr_size = str_count;\n287\t    }\n288\t\n289\t    return str_arr;\n290\t}\n291\t\n292\tSTRING_T_ARRAY string_split_by(const string_t *str, size_t *arr_size, const char split_chars[]) {\n293\t    size_t str_count = 0;\n294\t    size_t indexes[STRING_T_INDEXES_BUFFER_SIZE];\n295\t\n296\t    string_t *split_str = new_string_from_bytes(split_chars);\n297\t    if (str->size <= split_str->size) {\n298\t        str_count = 1;\n299\t        STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n300\t        str_arr[0] = string_copy(str);\n301\t        if (arr_size) {\n302\t            *arr_size = str_count;\n303\t        }\n304\t        string_free(split_str);\n305\t        return str_arr;\n306\t    }\n307\t\n308\t    size_t start_pos = 0;\n309\t    size_t pos = 0;\n310\t    for (; pos < str->size - split_str->size;) {\n311\t        string_t *sub_str = string_substr(str, pos, split_str->size);\n312\t        if (string_eq(sub_str, split_str) == true) {\n313\t\n314\t            indexes[str_count * 2] = start_pos;\n315\t            indexes[str_count * 2 + 1] = pos;\n316\t            start_pos = pos + split_str->size;\n317\t\n318\t            ++str_count;\n319\t            pos += split_str->size;\n320\t        } else {\n321\t            ++pos;\n322\t        }\n323\t        string_free(sub_str);\n324\t    }\n325\t    if (pos != start_pos) {\n326\t        indexes[str_count * 2] = start_pos;\n327\t        indexes[str_count * 2 + 1] = pos + 1;\n328\t        ++str_count;\n329\t    }\n330\t\n331\t    string_t **str_arr = calloc(str_count, sizeof(string_t *));\n332\t    for (size_t idx = 0; idx < str_count; ++idx) {\n333\t        size_t sub_str_start_pos = indexes[idx * 2];\n334\t        size_t sub_str_end_pos = indexes[idx * 2 + 1];\n335\t\n336\t        str_arr[idx] = string_substr(str, sub_str_start_pos, sub_str_end_pos - sub_str_start_pos);\n337\t    }\n338\t    if (arr_size) {\n339\t        *arr_size = str_count;\n340\t    }\n341\t    string_free(split_str);\n342\t\n343\t    return str_arr;\n344\t}\n345\t#endif\n346\t\n347\tstring_t *string_join_arr(const STRING_T_ARRAY str_arr, size_t arr_size, const char space_chars[]) {\n348\t    size_t str_size = strlen(space_chars) * (arr_size - 1);  // for space chars\n349\t    for (size_t idx = 0; idx < arr_size; ++idx) {\n350\t        str_size += str_arr[idx]->size;\n351\t    }\n352\t\n353\t    string_t *join_str = new_string(str_size);\n354\t    size_t offset = 0;\n355\t    for (size_t idx = 0; idx < arr_size; ++idx) {\n356\t        strcpy(join_str->bytes + offset, str_arr[idx]->bytes);\n357\t        offset += str_arr[idx]->size;\n358\t        if (idx != arr_size - 1) {\n359\t            strcpy(join_str->bytes + offset, space_chars);\n360\t            offset += strlen(space_chars);\n361\t        }\n362\t    }\n363\t\n364\t    return join_str;\n365\t}\n366\t#endif //STRING_T_H\n367\t"}]},"parent_tool_use_id":null,"session_id":"24010582-7e22-43eb-827b-5d1b41f4f688","uuid":"7e8ef268-9ebf-47a0-9d3b-f196e814711b","timestamp":"2026-06-06T06:02:27.343Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-DKYgYf/project/c_src/src/string_t.h","content":"/*\n    MIT License\n\n    Copyright (c) 2023 Ivan Korotaev <vnkrtv@yandex.ru>\n\n    Permission is hereby granted, free of charge, to any person obtaining a copy\n    of this software and associated documentation files (the \"Software\"), to deal\n    in the Software without restriction, including without limitation the rights\n    to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n    copies of the Software, and to permit persons to whom the Software is\n    furnished to do so, subject to the following conditions:\n\n    The above copyright notice and this permission notice shall be included in all\n    copies or substantial portions of the Software.\n\n    THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n    AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n    OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\n    SOFTWARE.\n */\n#ifndef STRING_T_H\n#define STRING_T_H\n\n#include <string.h>\n#include <stdlib.h>\n\n/*\n * Custom types\n */\n#ifndef size_t\n#define size_t unsigned long\n#endif\n#ifndef bool_t\n#define bool_t int\n#endif\n#ifndef true\n#define true 1\n#endif\n#ifndef false\n#define false 0\n#endif\n\n#ifndef STRING_T_INDEXES_BUFFER_SIZE\n#define STRING_T_INDEXES_BUFFER_SIZE 512\n#endif\n\n/* C string implementation. */\ntypedef struct string_t {\n    char *bytes;\n    size_t size;\n} string_t;\n\n#ifndef STRING_T_ARRAY\n#define STRING_T_ARRAY string_t **\n#endif\n#ifndef STRING_T_SPACE_CHARS_ARR\n#define STRING_T_SPACE_CHARS_ARR \" \\t\\n\\r\"\n#endif\n\nconst char STRING_T_SPACE_CHARS[] = STRING_T_SPACE_CHARS_ARR;\n\n/* Allocate new string by given size. */\nstring_t *new_string(size_t);\n\n/* Allocate new string by given bytes. */\nstring_t *new_string_from_bytes(const char *);\n\n/* Free string's allocated memory. */\nvoid string_free(string_t *);\n\n/* Return string length. */\nsize_t string_len(const string_t *);\n\n/* Return string bytes. */\nchar *string_bytes(const string_t *);\n\n/* Return true(0) if strings are equal. */\nbool_t string_eq(const string_t *, const string_t *);\n\n/* Return copy of the string. */\nstring_t *string_copy(const string_t *);\n\n/* Return result of 2 strings concatenation. */\nstring_t *string_concat(const string_t *, const string_t *);\n\n/* Return string's sub string. */\nstring_t *string_substr(const string_t *, size_t, size_t);\n\n/* Return true(0) if string starts with given prefix. */\nbool_t string_startswith(const string_t *, const char[]);\n\n/* Return true(0) if string ends with given suffix. */\nbool_t string_endswith(const string_t *, const char[]);\n\n/* Returns the index of substring's occurrence in string. Otherwise returns -1. */\nint string_find(const string_t *, const char[]);\n\n/* Return string without STRING_T_SPACE_CHARS_ARR at the start and end. */\nstring_t *string_strip(const string_t *);\n\n#ifndef _WIN32\n/* Split string by STRING_T_SPACE_CHARS_ARR symbols and return strings array. */\nSTRING_T_ARRAY string_split(const string_t *, size_t *);\n\n/* Split string by given chars and return strings array. */\nSTRING_T_ARRAY string_split_by(const string_t *, size_t *, const char[]);\n\n#endif\n/* Join given strings array with separator chars into one string. */\nstring_t *string_join_arr(const STRING_T_ARRAY, size_t, const char []);\n\nstring_t *new_string(size_t size) {\n    string_t *str = malloc(sizeof(string_t));\n    str->size = size;\n    str->bytes = calloc(size, sizeof(char));\n    return str;\n}\n\nstring_t *new_string_from_bytes(const char *bytes) {\n    string_t *str = new_string(strlen(bytes));\n    strcpy(str->bytes, bytes);\n    return str;\n}\n\nvoid string_free(string_t *str) {\n    free(str->bytes);\n    free(str);\n}\n\nsize_t string_len(const string_t *str) {\n    return str->size;\n}\n\nchar *string_bytes(const string_t *str) {\n    char *buf = calloc(sizeof(char), str->size);\n    strcpy(buf, str->bytes);\n    return buf;\n}\n\nbool_t string_eq(const string_t *left, const string_t *right) {\n    if (left->size != right->size || strcmp(left->bytes, right->bytes) != 0) {\n        return false;\n    }\n    return true;\n}\n\nstring_t *string_copy(const string_t *str) {\n    string_t *copied_str = new_string(str->size);\n    strcpy(copied_str->bytes, str->bytes);\n    return copied_str;\n}\n\nstring_t *string_concat(const string_t *first, const string_t *second) {\n    string_t *new_str = new_string(first->size + second->size);\n    strcpy(new_str->bytes, strcat(first->bytes, second->bytes));\n    return new_str;\n}\n\nint string_t_is_space_char(char byte) {\n    for (size_t idx = 0; idx < strlen(STRING_T_SPACE_CHARS); ++idx) {\n        if (STRING_T_SPACE_CHARS[idx] == byte) {\n            return 1;\n        }\n    }\n    return 0;\n}\n\nstring_t *string_substr(const string_t *str, size_t pos, size_t len) {\n    string_t *sub_str = new_string(len);\n    for (size_t idx = 0; idx < len; idx++) {\n        sub_str->bytes[idx] = str->bytes[pos + idx];\n    }\n\n    return sub_str;\n}\n\nbool_t string_startswith(const string_t *str, const char suffix[]) {\n    if (str->size < strlen(suffix)) {\n        return false;\n    }\n    string_t *exp_suffix = new_string_from_bytes(suffix);\n    string_t *str_suffix = string_substr(str, 0, exp_suffix->size);\n\n    bool_t is_suffix = string_eq(str_suffix, exp_suffix);\n    string_free(str_suffix);\n    string_free(exp_suffix);\n\n    return is_suffix;\n}\n\nbool_t string_endswith(const string_t *str, const char prefix[]) {\n    if (str->size < strlen(prefix)) {\n        return false;\n    }\n    string_t *exp_prefix = new_string_from_bytes(prefix);\n    string_t *str_prefix = string_substr(str, str->size - exp_prefix->size, exp_prefix->size);\n\n    bool_t is_suffix = string_eq(str_prefix, exp_prefix);\n    string_free(str_prefix);\n    string_free(exp_prefix);\n\n    return is_suffix;\n}\n\nint string_find(const string_t *str, const char chars[]) {\n    string_t *chars_str = new_string_from_bytes(chars);\n    if (chars_str->size == 0) {\n        string_free(chars_str);\n        return 0;\n    }\n    for (size_t pos = 0; pos < str->size; ++pos) {\n        string_t *sub_str = string_substr(str, pos, chars_str->size);\n        if (string_eq(sub_str, chars_str) == true) {\n            string_free(chars_str);\n            string_free(sub_str);\n            return (int) pos;\n        }\n        string_free(sub_str);\n    }\n    string_free(chars_str);\n\n    return -1;\n}\n\nstring_t *string_strip(const string_t *str) {\n    size_t start_pos = 0;\n    for (; start_pos < str->size && string_t_is_space_char(str->bytes[start_pos]); ++start_pos);\n    int end_pos = (int) str->size - 1;\n    for (; end_pos >= 0 && string_t_is_space_char(str->bytes[end_pos]); --end_pos);\n\n    if ((int)start_pos >= end_pos) {\n        return string_copy(str);\n    }\n    return string_substr(str, start_pos, end_pos - start_pos + 1);\n}\n\n#ifndef _WIN32\n\nSTRING_T_ARRAY string_split(const string_t *str, size_t *arr_size) {\n    size_t str_count = 0;\n    size_t indexes[STRING_T_INDEXES_BUFFER_SIZE];\n\n    if (str->size == 0) {\n        str_count = 1;\n        STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n        str_arr[0] = string_copy(str);\n        if (arr_size) {\n            *arr_size = str_count;\n        }\n        return str_arr;\n    }\n\n    size_t start_pos = 0;\n    size_t pos = 0;\n    for (; pos < str->size;) {\n        if (string_t_is_space_char(str->bytes[pos])) {\n\n            indexes[str_count * 2] = start_pos;\n            indexes[str_count * 2 + 1] = pos;\n\n            for (; string_t_is_space_char(str->bytes[pos]); pos++);\n\n            start_pos = pos;\n            ++str_count;\n        } else {\n            ++pos;\n        }\n    }\n    if (pos != start_pos) {\n        indexes[str_count * 2] = start_pos;\n        indexes[str_count * 2 + 1] = pos;\n        ++str_count;\n    }\n\n    STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n    for (size_t idx = 0; idx < str_count; ++idx) {\n        size_t sub_str_start_pos = indexes[idx * 2];\n        size_t sub_str_end_pos = indexes[idx * 2 + 1];\n\n        str_arr[idx] = string_substr(str, sub_str_start_pos, sub_str_end_pos - sub_str_start_pos);\n    }\n    if (arr_size) {\n        *arr_size = str_count;\n    }\n\n    return str_arr;\n}\n\nSTRING_T_ARRAY string_split_by(const string_t *str, size_t *arr_size, const char split_chars[]) {\n    size_t str_count = 0;\n    size_t indexes[STRING_T_INDEXES_BUFFER_SIZE];\n\n    string_t *split_str = new_string_from_bytes(split_chars);\n    if (str->size <= split_str->size) {\n        str_count = 1;\n        STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n        str_arr[0] = string_copy(str);\n        if (arr_size) {\n            *arr_size = str_count;\n        }\n        string_free(split_str);\n        return str_arr;\n    }\n\n    size_t start_pos = 0;\n    size_t pos = 0;\n    for (; pos < str->size - split_str->size;) {\n        string_t *sub_str = string_substr(str, pos, split_str->size);\n        if (string_eq(sub_str, split_str) == true) {\n\n            indexes[str_count * 2] = start_pos;\n            indexes[str_count * 2 + 1] = pos;\n            start_pos = pos + split_str->size;\n\n            ++str_count;\n            pos += split_str->size;\n        } else {\n            ++pos;\n        }\n        string_free(sub_str);\n    }\n    if (pos != start_pos) {\n        indexes[str_count * 2] = start_pos;\n        indexes[str_count * 2 + 1] = pos + 1;\n        ++str_count;\n    }\n\n    string_t **str_arr = calloc(str_count, sizeof(string_t *));\n    for (size_t idx = 0; idx < str_count; ++idx) {\n        size_t sub_str_start_pos = indexes[idx * 2];\n        size_t sub_str_end_pos = indexes[idx * 2 + 1];\n\n        str_arr[idx] = string_substr(str, sub_str_start_pos, sub_str_end_pos - sub_str_start_pos);\n    }\n    if (arr_size) {\n        *arr_size = str_count;\n    }\n    string_free(split_str);\n\n    return str_arr;\n}\n#endif\n\nstring_t *string_join_arr(const STRING_T_ARRAY str_arr, size_t arr_size, const char space_chars[]) {\n    size_t str_size = strlen(space_chars) * (arr_size - 1);  // for space chars\n    for (size_t idx = 0; idx < arr_size; ++idx) {\n        str_size += str_arr[idx]->size;\n    }\n\n    string_t *join_str = new_string(str_size);\n    size_t offset = 0;\n    for (size_t idx = 0; idx < arr_size; ++idx) {\n        strcpy(join_str->bytes + offset, str_arr[idx]->bytes);\n        offset += str_arr[idx]->size;\n        if (idx != arr_size - 1) {\n            strcpy(join_str->bytes + offset, space_chars);\n            offset += strlen(space_chars);\n        }\n    }\n\n    return join_str;\n}\n#endif //STRING_T_H\n","numLines":367,"startLine":1,"totalLines":367}}}
