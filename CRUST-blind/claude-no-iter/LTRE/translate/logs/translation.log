) % 8);\n    }\n    pub fn invert(&mut self) {\n        for b in self.bits.iter_mut() {\n            *b = !*b;\n        }\n    }\n    pub fn union_with(&mut self, other: &SymSet) {\n        for i in 0..32 {\n            self.bits[i] |= other.bits[i];\n        }\n    }\n    pub fn intersect_with(&mut self, other: &SymSet) {\n        for i in 0..32 {\n            self.bits[i] &= other.bits[i];\n        }\n    }\n    pub fn is_empty(&self) -> bool {\n        self.bits.iter().all(|&b| b == 0)\n    }\n}\n\npub fn symset_fmt(set: &SymSet) -> String {\n    // Build a buf and nbuf; emit characters and ranges; pick the shorter form\n    let mut buf: Vec<u8> = Vec::new();\n    let mut nbuf: Vec<u8> = Vec::new();\n    let mut nsym: i32 = 0;\n    let mut nnsym: i32 = 0;\n    nbuf.push(b'^');\n    buf.push(b'[');\n    nbuf.push(b'[');\n\n    let mut chr: i32 = 0;\n    while chr < 256 {\n        let c = chr as u8;\n        let in_set = set.contains(c);\n        if in_set { nsym += 1; } else { nnsym += 1; }\n        let is_meta = is_metachar(c);\n        let target = if in_set { &mut buf } else { &mut nbuf };\n        if !is_print(c) && !is_meta {\n            target.extend_from_slice(format!(\"\\\\x{:02x}\", c).as_bytes());\n        } else {\n            if is_meta {\n                target.push(b'\\\\');\n            }\n            target.push(c);\n        }\n\n        // make character ranges\n        let start = chr;\n        while chr < 255 && set.contains(chr as u8) == set.contains((chr + 1) as u8) {\n            chr += 1;\n        }\n        if chr - start >= 2 {\n            let target = if set.contains(chr as u8) { &mut buf } else { &mut nbuf };\n            target.push(b'-');\n            if set.contains(chr as u8) { nsym -= 1; } else { nnsym -= 1; }\n        }\n        if chr - start >= 1 {\n            // re-emit the end char (like the goto append_chr)\n            let c2 = chr as u8;\n            let in_set2 = set.contains(c2);\n            if in_set2 { nsym += 1; } else { nnsym += 1; }\n            let is_meta2 = is_metachar(c2);\n            let target = if in_set2 { &mut buf } else { &mut nbuf };\n            if !is_print(c2) && !is_meta2 {\n                target.extend_from_slice(format!(\"\\\\x{:02x}\", c2).as_bytes());\n            } else {\n                if is_meta2 {\n                    target.push(b'\\\\');\n                }\n                target.push(c2);\n            }\n            // run-finalizer iteration: re-enter the run-extension logic\n            let start2 = chr;\n            while chr < 255 && set.contains(chr as u8) == set.contains((chr + 1) as u8) {\n                chr += 1;\n            }\n            if chr - start2 >= 2 {\n                let target = if set.contains(chr as u8) { &mut buf } else { &mut nbuf };\n                target.push(b'-');\n                if set.contains(chr as u8) { nsym -= 1; } else { nnsym -= 1; }\n            }\n            // Loop the \"append_chr\" if the range is still extending. We approximate\n            // the goto by simulating until chr - start2 < 1.\n            let mut cur_start = start2;\n            while chr - cur_start >= 1 {\n                let c3 = chr as u8;\n                let in_set3 = set.contains(c3);\n                if in_set3 { nsym += 1; } else { nnsym += 1; }\n                let is_meta3 = is_metachar(c3);\n                let target = if in_set3 { &mut buf } else { &mut nbuf };\n                if !is_print(c3) && !is_meta3 {\n                    target.extend_from_slice(format!(\"\\\\x{:02x}\", c3).as_bytes());\n                } else {\n                    if is_meta3 {\n                        target.push(b'\\\\');\n                    }\n                    target.push(c3);\n                }\n                let s = chr;\n                while chr < 255 && set.contains(chr as u8) == set.contains((chr + 1) as u8) {\n                    chr += 1;\n                }\n                if chr - s >= 2 {\n                    let target = if set.contains(chr as u8) { &mut buf } else { &mut nbuf };\n                    target.push(b'-');\n                    if set.contains(chr as u8) { nsym -= 1; } else { nnsym -= 1; }\n                }\n                cur_start = s;\n                if chr - s < 1 {\n                    break;\n                }\n            }\n        }\n        chr += 1;\n    }\n\n    buf.push(b']');\n    nbuf.push(b']');\n\n    // empty set: all bits zero -> nnsym == 1 (one big complement range)\n    // full set: nsym == 1 (one big range)\n    if nnsym == 0 {\n        return \"<>\".to_string();\n    } else if nsym == 1 {\n        // Strip leading '[' and trailing ']'\n        let s = &buf[1..buf.len() - 1];\n        return String::from_utf8_lossy(s).into_owned();\n    } else if nnsym == 1 {\n        // Strip the leading '^[' part... C does nbuf[1] = '^' and returns nbuf+1\n        // and nbufp[-2] = '\\0'. Effectively: \"^\" + nbuf[2..nbuf.len()-1]\n        // Original nbuf starts with ['^','[', ...content..., ']']. Set nbuf[1]='^'\n        // and trim trailing ']'. Return from index 1 onwards. So the returned\n        // string is \"^\" + content (without leading '['/'^' and without trailing ']').\n        let mut nb = nbuf.clone();\n        nb[1] = b'^';\n        // trim trailing ']'\n        let trimmed = &nb[1..nb.len() - 1];\n        return String::from_utf8_lossy(trimmed).into_owned();\n    }\n\n    if buf.len() < nbuf.len() {\n        String::from_utf8_lossy(&buf).into_owned()\n    } else {\n        String::from_utf8_lossy(&nbuf).into_owned()\n    }\n}\n\n#[derive(Clone, Debug)]\npub struct NState {\n    pub label: SymSet,\n    pub target: Option<usize>,\n    pub epsilon0: Option<usize>,\n    pub epsilon1: Option<usize>,\n}\nimpl NState {\n    pub fn new() -> Self {\n        NState {\n            label: SymSet::empty(),\n            target: None,\n            epsilon0: None,\n            epsilon1: None,\n        }\n    }\n}\n#[derive(Clone, Debug)]\npub struct Nfa {\n    pub states: Vec<NState>,\n    pub initial: usize,\n    pub final_: usize,\n    pub complemented: bool,\n}\nimpl Nfa {\n    pub fn new_single() -> Self {\n        // Single state at index 0; initial == final == 0\n        let mut states = Vec::new();\n        states.push(NState::new());\n        Nfa { states, initial: 0, final_: 0, complemented: false }\n    }\n    pub fn len(&self) -> usize {\n        self.states.len()\n    }\n}\npub fn nfa_free(_nfa: Nfa) {}\npub fn dfa_free(_dfa: Dfa) {}\npub fn nfa_clone(orig: &Nfa) -> Nfa {\n    orig.clone()\n}\n\nfn shift_option(opt: &mut Option<usize>, offset: usize) {\n    if let Some(v) = opt.as_mut() {\n        *v += offset;\n    }\n}\n\npub fn nfa_concat(nfa1: &mut Nfa, mut nfa2: Nfa) {\n    // Concat semantics from C: memcpy nfa2.initial into nfa1.final, free nfa2.initial,\n    // and set nfa1.final = nfa2.final. If nfa1.initial == nfa1.final, replace nfa1\n    // wholesale with nfa2. If nfa2.initial == nfa2.final, do nothing (it's empty).\n    if nfa1.initial == nfa1.final_ && nfa1.states.len() == 1 {\n        // nfa1 is a \"fresh\" single-state NFA; replace by nfa2\n        *nfa1 = nfa2;\n        return;\n    }\n    if nfa2.initial == nfa2.final_ && nfa2.states.len() == 1 {\n        // nfa2 is empty - nothing to do\n        return;\n    }\n    // We need to merge nfa2.initial INTO nfa1.final_. The way to do this with\n    // index-based representation: shift nfa2's indices, but skip its initial\n    // state (since we copy its contents to nfa1.final_).\n    let offset = nfa1.states.len();\n    let nfa2_initial = nfa2.initial;\n    // First copy the contents of nfa2.initial into nfa1.final_:\n    // Adjust the references in nfa2.initial to use the future shifted indices.\n    let mut copy_state = nfa2.states[nfa2_initial].clone();\n    shift_option(&mut copy_state.target, offset);\n    shift_option(&mut copy_state.epsilon0, offset);\n    shift_option(&mut copy_state.epsilon1, offset);\n    // We'll need a remap: nfa2_initial maps to nfa1.final_ (existing index).\n    // Other nfa2 indices are appended at offset, but shifted to skip the slot\n    // for nfa2_initial.\n    // To make remapping clean, append nfa2 states (all of them) and remap any\n    // index pointing to nfa2_initial to nfa1.final_.\n    let final_idx_old = nfa1.final_;\n    // Replace nfa1.final_ with nfa2's initial-state contents\n    nfa1.states[final_idx_old] = copy_state;\n\n    // Now append every other state from nfa2 (excluding the initial slot,\n    // but easier: append all and skip initial; remap accordingly).\n    // We'll create a mapping from old nfa2 index to new index in nfa1.states.\n    let mut mapping = vec![0usize; nfa2.states.len()];\n    mapping[nfa2_initial] = final_idx_old;\n    for (i, st) in nfa2.states.iter_mut().enumerate() {\n        if i == nfa2_initial {\n            continue;\n        }\n        mapping[i] = nfa1.states.len();\n        // Push a placeholder; we'll fix references below\n        let s = st.clone();\n        nfa1.states.push(s);\n    }\n    // Now fix references in newly-appended states (and the copied-initial state)\n    // Re-examine the copied initial-state references: the initial we already\n    // shifted by offset, which is wrong. Redo it using mapping.\n    // Reset and recompute references properly.\n    // Restore from original:\n    {\n        let init_state = nfa2.states[nfa2_initial].clone();\n        let mut s = init_state;\n        if let Some(v) = s.target { s.target = Some(mapping[v]); }\n        if let Some(v) = s.epsilon0 { s.epsilon0 = Some(mapping[v]); }\n        if let Some(v) = s.epsilon1 { s.epsilon1 = Some(mapping[v]); }\n        nfa1.states[final_idx_old] = s;\n    }\n    // Fix the appended states\n    for (i, _) in nfa2.states.iter().enumerate() {\n        if i == nfa2_initial { continue; }\n        let new_idx = mapping[i];\n        let mut s = nfa2.states[i].clone();\n        if let Some(v) = s.target { s.target = Some(mapping[v]); }\n        if let Some(v) = s.epsilon0 { s.epsilon0 = Some(mapping[v]); }\n        if let Some(v) = s.epsilon1 { s.epsilon1 = Some(mapping[v]); }\n        nfa1.states[new_idx] = s;\n    }\n    nfa1.final_ = mapping[nfa2.final_];\n}\n\npub fn nfa_pad_initial(nfa: &mut Nfa) {\n    let mut new_state = NState::new();\n    new_state.epsilon0 = Some(nfa.initial);\n    let new_idx = nfa.states.len();\n    nfa.states.push(new_state);\n    nfa.initial = new_idx;\n}\npub fn nfa_pad_final(nfa: &mut Nfa) {\n    let new_idx = nfa.states.len();\n    nfa.states.push(NState::new());\n    nfa.states[nfa.final_].epsilon0 = Some(new_idx);\n    nfa.final_ = new_idx;\n}\n\npub fn nfa_uncomplement(nfa: &mut Nfa) -> Result<(), String> {\n    if !nfa.complemented {\n        return Ok(());\n    }\n    let cloned = nfa.clone();\n    let dfa = ltre_compile(cloned);\n    let uncomplemented = ltre_uncompile(&dfa);\n    *nfa = uncomplemented;\n    Ok(())\n}\n\npub fn nfa_dump(_nfa: &Nfa) {\n    // Stub: implementation not required by tests\n}\n","structuredPatch":[{"oldStart":1,"oldLines":36,"newStart":1,"newLines":207,"lines":["+const METACHARS: &[u8] = b\"\\\\.-^$*+?{}[]<>()|&~\";","+","+fn is_metachar(c: u8) -> bool {","+    c != 0 && METACHARS.contains(&c)","+}","+","+fn is_print(c: u8) -> bool {","+    // C isprint: printable including space (0x20..=0x7e)","+    c >= 0x20 && c <= 0x7e","+}","+","+fn is_digit(c: u8) -> bool {","+    c >= b'0' && c <= b'9'","+}","+","+fn is_xdigit(c: u8) -> bool {","+    is_digit(c) || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')","+}","+","+fn is_alpha(c: u8) -> bool {","+    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')","+}","+","+fn is_alnum(c: u8) -> bool {","+    is_alpha(c) || is_digit(c)","+}","+","+fn is_space(c: u8) -> bool {","+    // C isspace: space, tab, LF, VT, FF, CR","+    c == b' ' || c == b'\\t' || c == b'\\n' || c == 0x0b || c == 0x0c || c == b'\\r'","+}","+","+fn to_lower(c: u8) -> u8 {","+    if c >= b'A' && c <= b'Z' { c + 32 } els