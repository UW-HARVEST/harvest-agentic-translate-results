;\n    let r2 = ltre_matches_lazy(&mut ldfa, &nfa2, t.input.as_bytes());\n    if r2 != t.matches {\n        return Err(format!(\n            \"lazy /{}/ on {:?} expected {} got {}\",\n            t.regex, t.input, t.matches, r2\n        ));\n    }\n\n    if !t.quick {\n        let re = ltre_decompile(&dfa3);\n        let nfa3 = ltre_parse(&re).map_err(|e| format!(\"decompile parse failed for /{}/: {} -> /{}/\", t.regex, e, re))?;\n        let dfa4 = ltre_compile(nfa3);\n        let r3 = ltre_matches(&dfa4, t.input.as_bytes());\n        if r3 != t.matches {\n            return Err(format!(\n                \"decompile /{}/ -> /{}/ on {:?} expected {} got {}\",\n                t.regex, re, t.input, t.matches, r3\n            ));\n        }\n    }\n    Ok(())\n}\n\nfn t1(re: &str, inp: &str, m: bool) -> Test {\n    Test { regex: re.to_string(), input: inp.to_string(), matches: m, ..Default::default() }\n}\n\nfn main() {\n    let mut tests: Vec<Test> = Vec::new();\n\n    tests.push(t1(\"(a*)*c\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", false));\n    tests.push(t1(\"(x+x+)+y\", \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\", false));\n    let mut tt = t1(\"[01]*1[01]{8}\", \"11011100011100\", true); tt.quick = true; tests.push(tt);\n    let mut tt = t1(\"[01]*1[01]{8}\", \"01010010010010\", false); tt.quick = true; tests.push(tt);\n    tests.push(t1(\".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", \"\", false));\n    tests.push(t1(\".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", \"123\", true));\n    tests.push(t1(\"abba\", \"abba\", true));\n    tests.push(t1(\"[ab]+\", \"abba\", true));\n    tests.push(t1(\"[ab]+\", \"abc\", false));\n    tests.push(t1(\".*\", \"abba\", true));\n    tests.push(t1(\"(a|b+){3}\", \"abbba\", true));\n    tests.push(t1(\"(a|b+){3}\", \"abbab\", false));\n    tests.push(t1(\"\\\\x61\\\\+\", \"a+\", true));\n    tests.push(t1(\"\", \"\", true));\n    tests.push(t1(\"[]\", \"\", false));\n    tests.push(t1(\"[]*\", \"\", true));\n    tests.push(t1(\"[]+\", \"\", false));\n