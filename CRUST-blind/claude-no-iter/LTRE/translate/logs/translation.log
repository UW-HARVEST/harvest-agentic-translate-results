\t  test(\"<>\", \" \", true);\n260\t  test(\"^<>\", \" \", false);\n261\t  test(\"9-0*\", \"abc\", true);\n262\t  test(\"9-0*\", \"18\", false);\n263\t  test(\"9-0*\", \"09\", true);\n264\t  test(\"9-0*\", \"/:\", true);\n265\t  test(\"b-a*\", \"ab\", true);\n266\t  test(\"a-b*\", \"ab\", true);\n267\t  test(\"a-a*\", \"ab\", false);\n268\t  test(\"a-a*\", \"aa\", true);\n269\t  test(\"a{,2}\", \"\", true);\n270\t  test(\"a{,2}\", \"a\", true);\n271\t  test(\"a{,2}\", \"aa\", true);\n272\t  test(\"a{,2}\", \"aaa\", false);\n273\t  test(\"a{}\", \"\", true);\n274\t  test(\"a{}\", \"a\", false);\n275\t  test(\"a{,}\", \"\", true);\n276\t  test(\"a{,}\", \"a\", true);\n277\t  test(\"~0*\", \"\", false);\n278\t  test(\"~0*\", \"0\", false);\n279\t  test(\"~0*\", \"00\", false);\n280\t  test(\"~0*\", \"001\", true);\n281\t  test(\"ab&cd\", \"\", false);\n282\t  test(\"ab&cd\", \"ab\", false);\n283\t  test(\"ab&cd\", \"cd\", false);\n284\t  test(\"\\\\w+&~\\\\d+\", \"\", false);\n285\t  test(\"\\\\w+&~\\\\d+\", \"abc\", true);\n286\t  test(\"\\\\w+&~\\\\d+\", \"abc123\", true);\n287\t  test(\"\\\\w+&~\\\\d+\", \"1a2b3c\", true);\n288\t  test(\"\\\\w+&~\\\\d+\", \"123\", false);\n289\t  test(\"0x(~[0-9a-f]+)\", \"0yz\", false);\n290\t  test(\"0x(~[0-9a-f]+)\", \"0x12\", false);\n291\t  test(\"0x(~[0-9a-f]+)\", \"0x\", true);\n292\t  test(\"0x(~[0-9a-f]+)\", \"0xy\", true);\n293\t  test(\"0x(~[0-9a-f]+)\", \"0xyz\", true);\n294\t  test(\"b(~a*)\", \"\", false);\n295\t  test(\"b(~a*)\", \"b\", false);\n296\t  test(\"b(~a*)\", \"ba\", false);\n297\t  test(\"b(~a*)\", \"bbaa\", true);\n298\t  test(\"abc>\", .errors = true);\n299\t  test(\"<abc\", .errors = true);\n300\t  test(\"[a?b]\", .errors = true);\n301\t  test(\"[a-]\", .errors = true);\n302\t  test(\"[--]\", .errors = true);\n303\t  test(\"[-]\", .errors = true);\n304\t  test(\"-\", .errors = true);\n305\t  test(\"a-\", .errors = true);\n306\t  test(\"a*{}\", .errors = true);\n307\t  test(\"a+{}\", .errors = true);\n308\t  test(\"a?{}\", .errors = true);\n309\t  test(\"a{}*\", .errors = true);\n310\t  test(\"a{}+\", .errors = true);\n311\t  test(\"a{}?\", .errors = true);\n312\t  test(\"a{}{}\", .errors = true);\n313\t  test(\"a{2,1}\", .errors = true);\n314\t  test(\"a{1 2}\", .errors = true);\n315\t  test(\"a{1, 2}\", .errors = true);\n316\t  test(\"a{a}\", .errors = true);\n317\t  test(\"a~b\", .errors = true);\n318\t\n319\t  // realistic regexes\n320\t#define HEX_RGB \"#([0-9a-fA-F]{3}){1,2}\"\n321\t  test(HEX_RGB, \"000\", false);\n322\t  test(HEX_RGB, \"#0aA\", true);\n323\t  test(HEX_RGB, \"#00ff\", false);\n324\t  test(HEX_RGB, \"#abcdef\", true);\n325\t  test(HEX_RGB, \"#abcdeff\", false);\n326\t  // ISO/IEC 9899:TC3, $7.19.6.1 'The fprintf function'.\n327\t  // see also gcc-14/gcc/c-family/c-format.cc:713 'print_char_table'\n328\t  // and gcc-14/gcc/c-family/c-format.h:25 'enum format_lengths'\n329\t#define FIELD_WIDTH \"(\\\\*|1-90-9*)?\"\n330\t#define PRECISION \"(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?\"\n331\t#define DI \"[\\\\-\\\\+ 0]*\" FIELD_WIDTH PRECISION \"([hljzt]|hh|ll)?[di]\"\n332\t#define U \"[\\\\-0]*\" FIELD_WIDTH PRECISION \"([hljzt]|hh|ll)?u\"\n333\t#define OX \"[\\\\-#0]*\" FIELD_WIDTH PRECISION \"([hljzt]|hh|ll)?[oxX]\"\n334\t#define FEGA \"[\\\\-\\\\+ #0]*\" FIELD_WIDTH PRECISION \"[lL]?[fFeEgGaA]\"\n335\t#define C \"\\\\-*\" FIELD_WIDTH \"l?c\"\n336\t#define S \"\\\\-*\" FIELD_WIDTH PRECISION \"l?s\"\n337\t#define P \"\\\\-*\" FIELD_WIDTH \"p\"\n338\t#define N FIELD_WIDTH \"([hljzt]|hh|ll)?n\"\n339\t#define CONV_SPEC \"%(\" DI \"|\" U \"|\" OX \"|\" FEGA \"|\" C \"|\" S \"|\" P \"|\" N \"|%)\"\n340\t  test(CONV_SPEC, \"%\", false);\n341\t  test(CONV_SPEC, \"%*\", false);\n342\t  test(CONV_SPEC, \"%%\", true);\n343\t  test(CONV_SPEC, \"%5%\", false);\n344\t  test(CONV_SPEC, \"%p\", true);\n345\t  test(CONV_SPEC, \"%*p\", true);\n346\t  test(CONV_SPEC, \"% *p\", false);\n347\t  test(CONV_SPEC, \"%5p\", true);\n348\t  test(CONV_SPEC, \"d\", false);\n349\t  test(CONV_SPEC, \"%d\", true);\n350\t  test(CONV_SPEC, \"%.16s\", true);\n351\t  test(CONV_SPEC, \"% 5.3f\", true);\n352\t  test(CONV_SPEC, \"%*32.4g\", false);\n353\t  test(CONV_SPEC, \"%-#65.4g\", true);\n354\t  test(CONV_SPEC, \"%03c\", false);\n355\t  test(CONV_SPEC, \"%06i\", true);\n356\t  test(CONV_SPEC, \"%lu\", true);\n357\t  test(CONV_SPEC, \"%hhu\", true);\n358\t  test(CONV_SPEC, \"%Lu\", false);\n359\t  test(CONV_SPEC, \"%-*p\", true);\n360\t  test(CONV_SPEC, \"%-.*p\", false);\n361\t  test(CONV_SPEC, \"%id\", false);\n362\t  test(CONV_SPEC, \"%%d\", false);\n363\t  test(CONV_SPEC, \"i%d\", false);\n364\t  test(CONV_SPEC, \"%c%s\", false);\n365\t  test(CONV_SPEC, \"%0n\", false);\n366\t  test(CONV_SPEC, \"% u\", false);\n367\t  test(CONV_SPEC, \"%+c\", false);\n368\t  test(CONV_SPEC, \"%0-++ 0i\", true);\n369\t  test(CONV_SPEC, \"%30c\", true);\n370\t  test(CONV_SPEC, \"%03c\", false);\n371\t#define PRINTF_FMT \"(^%|\" CONV_SPEC \")*\"\n372\t  test(PRINTF_FMT, \"%\", false, .quick = true);\n373\t  test(PRINTF_FMT, \"%*\", false, .quick = true);\n374\t  test(PRINTF_FMT, \"%%\", true, .quick = true);\n375\t  test(PRINTF_FMT, \"%5%\", false, .quick = true);\n376\t  test(PRINTF_FMT, \"%id\", true, .quick = true);\n377\t  test(PRINTF_FMT, \"%%d\", true, .quick = true);\n378\t  test(PRINTF_FMT, \"i%d\", true, .quick = true);\n379\t  test(PRINTF_FMT, \"%c%s\", true, .quick = true);\n380\t  test(PRINTF_FMT, \"%u + %d\", true, .quick = true);\n381\t  test(PRINTF_FMT, \"%d:\", true, .quick = true);\n382\t  // ISO/IEC 9899:TC3, $6.4.1 'Keywords', $6.4.2 'Identifiers' and $6.4.3\n383\t  // 'Universal character names'. does not uphold $6.4.3 paragraph 2\n384\t#define KEYWORD                                                                \\\n385\t  \"(auto|break|case|char|const|continue|default|do|double|else|enum|extern|\"   \\\n386\t  \"float|for|goto|if|inline|int|long|register|restrict|return|short|signed|\"   \\\n387\t  \"sizeof|static|struct|switch|typedef|union|unsigned|void|volatile|while|\"    \\\n388\t  \"_Bool|_Complex|_Imaginary)\"\n389\t#define HEX_QUAD \"[0-9a-fA-F]{4}\"\n390\t#define IDENTIFIER                                                             \\\n391\t  \"(\\\\w|\\\\\\\\u\" HEX_QUAD \"|\\\\\\\\U\" HEX_QUAD HEX_QUAD \")*&~\\\\d.*&~\" KEYWORD\n392\t  test(IDENTIFIER, \"_\", true);\n393\t  test(IDENTIFIER, \"_foo\", true);\n394\t  test(IDENTIFIER, \"_Bool\", false);\n395\t  test(IDENTIFIER, \"a1\", true);\n396\t  test(IDENTIFIER, \"5b\", false);\n397\t  test(IDENTIFIER, \"if\", false);\n398\t  test(IDENTIFIER, \"ifa\", true);\n399\t  test(IDENTIFIER, \"bif\", true);\n400\t  test(IDENTIFIER, \"if2\", true);\n401\t  test(IDENTIFIER, \"1if\", false);\n402\t  test(IDENTIFIER, \"\\\\u12\", false);\n403\t  test(IDENTIFIER, \"\\\\u1A2b\", true);\n404\t  test(IDENTIFIER, \"\\\\u1234\", true);\n405\t  test(IDENTIFIER, \"\\\\u123x\", false);\n406\t  test(IDENTIFIER, \"\\\\u1234x\", true);\n407\t  test(IDENTIFIER, \"\\\\U12345678\", true);\n408\t  test(IDENTIFIER, \"\\\\U1234567y\", false);\n409\t  test(IDENTIFIER, \"\\\\U12345678y\", true);\n410\t  // RFC 8259, $7 'Strings'. the RFC requires that UTF-8 be used for open\n411\t  // exchange of JSON; this regex lets through any byte outside 7-bit ASCII,\n412\t  // and so really accepts a superset of UTF-8-encoded JSON strings. also, the\n413\t  // RFC points out that the grammar would allow string values that are invalid\n414\t  // Unicode, but doesn't elaborate, so I guess we can let those through too?\n415\t#define HEX_QUAD \"[0-9a-fA-F]{4}\"\n416\t#define JSON_STR                                                               \\\n417\t  \"\\\"(^[\\\\x00-\\\\x1f\\\"\\\\\\\\]|\\\\\\\\[\\\"\\\\\\\\/bfnrt]|\\\\\\\\u\" HEX_QUAD \")*\\\"\"\n418\t  test(JSON_STR, \"foo\", false);\n419\t  test(JSON_STR, \"\\\"foo\", false);\n420\t  test(JSON_STR, \"foo \\\"bar\\\"\", false);\n421\t  test(JSON_STR, \"\\\"foo\\\\\\\"\", false);\n422\t  test(JSON_STR, \"\\\"\\\\\\\"\", false);\n423\t  test(JSON_STR, \"\\\"\\\"\\\"\", false);\n424\t  test(JSON_STR, \"\\\"\\\"\", true);\n425\t  test(JSON_STR, \"\\\"foo\\\"\", true);\n426\t  test(JSON_STR, \"\\\"foo\\\\\\\"\\\"\", true);\n427\t  test(JSON_STR, \"\\\"foo\\\\\\\\\\\"\", true);\n428\t  test(JSON_STR, \"\\\"\\\\nbar\\\"\", true);\n429\t  test(JSON_STR, \"\\\"\\nbar\\\"\", false);\n430\t  test(JSON_STR, \"\\\"\\\\abar\\\"\", false);\n431\t  test(JSON_STR, \"\\\"foo\\\\v\\\"\", false);\n432\t  test(JSON_STR, \"\\\"\\\\u1A2b\\\"\", true);\n433\t  test(JSON_STR, \"\\\"\\\\uDEAD\\\"\", true);\n434\t  test(JSON_STR, \"\\\"\\\\uF00\\\"\", false);\n435\t  test(JSON_STR, \"\\\"\\\\uF00BAR\\\"\", true);\n436\t  test(JSON_STR, \"\\\"foo\\\\/\\\"\", true);\n437\t  test(JSON_STR, \"\\\"\\xcf\\x84\\\"\", true);\n438\t  test(JSON_STR, \"\\\"\\x80\\\"\", true);\n439\t  test(JSON_STR, \"\\\"\\x88x/\\\"\", true);\n440\t  // RFC 8259, $6 'Numbers'\n441\t#define JSON_NUM \"\\\\-?(0|1-90-9*)(\\\\.0-9+)?([eE][\\\\+\\\\-]?0-9+)?\"\n442\t  test(JSON_NUM, \"e\", false);\n443\t  test(JSON_NUM, \"1\", true);\n444\t  test(JSON_NUM, \"10\", true);\n445\t  test(JSON_NUM, \"01\", false);\n446\t  test(JSON_NUM, \"-5\", true);\n447\t  test(JSON_NUM, \"+5\", false);\n448\t  test(JSON_NUM, \".3\", false);\n449\t  test(JSON_NUM, \"2.\", false);\n450\t  test(JSON_NUM, \"2.3\", true);\n451\t  test(JSON_NUM, \"1e\", false);\n452\t  test(JSON_NUM, \"1e0\", true);\n453\t  test(JSON_NUM, \"1E+0\", true);\n454\t  test(JSON_NUM, \"1e-0\", true);\n455\t  test(JSON_NUM, \"1E10\", true);\n456\t  test(JSON_NUM, \"1e+00\", true);\n457\t#define JSON_BOOL \"true|false\"\n458\t#define JSON_NULL \"null\"\n459\t#define JSON_PRIM JSON_STR \"|\" JSON_NUM \"|\" JSON_BOOL \"|\" JSON_NULL\n460\t  test(JSON_PRIM, \"nul\", false);\n461\t  test(JSON_PRIM, \"null\", true);\n462\t  test(JSON_PRIM, \"nulll\", false);\n463\t  test(JSON_PRIM, \"true\", true);\n464\t  test(JSON_PRIM, \"false\", true);\n465\t  test(JSON_PRIM, \"{}\", false);\n466\t  test(JSON_PRIM, \"[]\", false);\n467\t  test(JSON_PRIM, \"1,\", false);\n468\t  test(JSON_PRIM, \"-5.6e2\", true);\n469\t  test(JSON_PRIM, \"\\\"1a\\\\n\\\"\", true);\n470\t  test(JSON_PRIM, \"\\\"1a\\\\n\\\" \", false);\n471\t  // RFC 3629, $3 'UTF-8 definition'. derived from the plain English definition\n472\t#define TAIL \"\\\\x80-\\\\xbf\"\n473\t#define BYTE_PAT                                                               \\\n474\t  \"(\\\\x00-\\\\x7f|\\\\xc0-\\\\xdf\" TAIL \"|\\\\xe0-\\\\xef\" TAIL TAIL                     \\\n475\t  \"|\\\\xf0-\\\\xf7\" TAIL TAIL TAIL \")\"\n476\t#define OVERLONG \"(\\\\xc0-\\\\xc1<>|\\\\xe0\\\\x80-\\\\x9f<>|\\\\xf0\\\\x80-\\\\x8f<><>)\"\n477\t#define SURROGATE \"\\\\xed\\\\xa0-\\\\xbf<>\"\n478\t#define TOO_BIG \"(\\\\xf4\\\\x90-\\\\xff\" TAIL TAIL \"|\\\\xf5-\\\\xff\" TAIL TAIL TAIL \")\"\n479\t#define UTF8_CHAR_1 \"(\" BYTE_PAT \"&~\" OVERLONG \"&~\" SURROGATE \"&~\" TOO_BIG \")\"\n480\t  // RFC 3629, $4 'Syntax of UTF-8 Byte Sequences'. direct transcription of ABNF\n481\t#define TAIL \"\\\\x80-\\\\xbf\"\n482\t#define UTF8_1 \"\\\\x00-\\\\x7f\"\n483\t#define UTF8_2 \"\\\\xc2-\\\\xdf\" TAIL\n484\t#define UTF8_3                                                                 \\\n485\t  \"\\\\xe0\\\\xa0-\\\\xbf\" TAIL \"|\\\\xe1-\\\\xec\" TAIL TAIL \"|\\\\xed\\\\x80-\\\\x9f\" TAIL    \\\n486\t  \"|\\\\xee-\\\\xef\" TAIL TAIL\n487\t#define UTF8_4                                                                 \\\n488\t  \"\\\\xf0\\\\x90-\\\\xbf\" TAIL TAIL \"|\\\\xf1-\\\\xf3\" TAIL TAIL TAIL                   \\\n489\t  \"|\\\\xf4\\\\x80-\\\\x8f\" TAIL TAIL\n490\t#define UTF8_CHAR_2 \"(\" UTF8_1 \"|\" UTF8_2 \"|\" UTF8_3 \"|\" UTF8_4 \")\"\n491\t  // generated by `ltre_decompile` then tweaked manually to minimize length\n492\t#define UTF8_CHAR_3                                                            \\\n493\t  \"(\\\\x00-\\\\x7f|(\\\\xc2-\\\\xdf|\\\\xe0\\\\xa0-\\\\xbf|\\\\xed\\\\x80-\\\\x9f|\"               \\\n494\t  \"([\\\\xe1-\\\\xec\\\\xee\\\\xef]|\\\\xf0\\\\x90-\\\\xbf|\\\\xf4\\\\x80-\\\\x8f|\"                \\\n495\t  \"\\\\xf1-\\\\xf3\\\\x80-\\\\xbf)\\\\x80-\\\\xbf)\\\\x80-\\\\xbf)\"\n496\t  // all three regular expressions above should accept the same language\n497\t#define UTF8_CHAR_ALL UTF8_CHAR_1 \"&\" UTF8_CHAR_2 \"&\" UTF8_CHAR_3\n498\t#define UTF8_CHARS_ALL UTF8_CHAR_1 \"*&\" UTF8_CHAR_2 \"*&\" UTF8_CHAR_3 \"*\"\n499\t#define UTF8_CHAR_SOME UTF8_CHAR_1 \"|\" UTF8_CHAR_2 \"|\" UTF8_CHAR_3\n500\t#define UTF8_CHARS_SOME UTF8_CHAR_1 \"*|\" UTF8_CHAR_2 \"*|\" UTF8_CHAR_3 \"*\"\n501\t  test(UTF8_CHAR_SOME, \"ab\", false);\n502\t  test(UTF8_CHAR_SOME, \"\\x80x\", false);\n503\t  test(UTF8_CHAR_SOME, \"\\x80\", false);\n504\t  test(UTF8_CHAR_SOME, \"\\xbf\", false);\n505\t  test(UTF8_CHAR_SOME, \"\\xc0\", false);\n506\t  test(UTF8_CHAR_SOME, \"\\xc1\", false);\n507\t  test(UTF8_CHAR_SOME, \"\\xff\", false);\n508\t  test(UTF8_CHAR_SOME, \"\\xed\\xa1\\x8c\", false); // RFC ex. (surrogate)\n509\t  test(UTF8_CHAR_SOME, \"\\xed\\xbe\\xb4\", false); // RFC ex. (surrogate)\n510\t  test(UTF8_CHAR_SOME, \"\\xed\\xa0\\x80\", false); // d800, first surrogate\n511\t  test(UTF8_CHAR_SOME, \"\\xc0\\x80\", false);     // RFC ex. (overlong nul)\n512\t  test(UTF8_CHAR_ALL, \"\\x7f\", true);\n513\t  test(UTF8_CHAR_ALL, \"\\xF0\\x9E\\x84\\x93\", true);\n514\t  test(UTF8_CHAR_ALL, \"\\x2f\", true);               // solidus\n515\t  test(UTF8_CHAR_SOME, \"\\xc0\\xaf\", false);         // overlong solidus\n516\t  test(UTF8_CHAR_SOME, \"\\xe0\\x80\\xaf\", false);     // overlong solidus\n517\t  test(UTF8_CHAR_SOME, \"\\xf0\\x80\\x80\\xaf\", false); // overlong solidus\n518\t  test(UTF8_CHAR_SOME, \"\\xf7\\xbf\\xbf\\xbf\", false); // 1fffff, too big\n519\t  test(UTF8_CHARS_ALL, \"\\x41\\xe2\\x89\\xa2\\xce\\x91\\x2e\", true);         // RFC ex.\n520\t  test(UTF8_CHARS_ALL, \"\\xed\\x95\\x9c\\xea\\xb5\\xad\\xec\\x96\\xb4\", true); // RFC ex.\n521\t  test(UTF8_CHARS_ALL, \"\\xe6\\x97\\xa5\\xe6\\x9c\\xac\\xe8\\xaa\\x9e