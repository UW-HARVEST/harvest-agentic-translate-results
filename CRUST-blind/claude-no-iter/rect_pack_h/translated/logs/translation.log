sort.\n    assert!(rects[0].info.packed);\n    assert!(!rects[1].info.packed);\n    assert!(!rects[2].info.packed);\n    assert!(!rects[3].info.packed);\n    println!(\"no_paging: OK\");\n\n    // test_rect_pack_fail_paging\n    let mut rects = vec![Rect::new(0, 900, 900), Rect::new(1, 1100, 1100)];\n    let r = RectPacker::pack(1000, 1000, true, &mut rects);\n    assert!(!r);\n    // After sort: rects[0] = id 1 (1100x1100, doesn't fit), rects[1] = id 0 (900x900)\n    // Test in C asserts: rects[0].packed = false, rects[1].packed = true\n    assert!(!rects[0].info.packed);\n    assert!(rects[1].info.packed);\n    println!(\"fail_paging: OK\");\n\n    println!(\"All tests passed!\");\n}\nEOF\ncp /tmp/test_rect_pack.rs examples/test_rect_pack.rs 2>/dev/null\nmkdir -p examples && cp /tmp/test_rect_pack.rs examples/test_rect_pack.rs\nls examples/","description":"Create example test file"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":507,"cache_read_input_tokens":30504,"cache_creation":{"ephemeral_5m_input_tokens":507,"ephemeral_1h_input_tokens":0},"output_tokens":30,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d6b760f1-ef43-4e57-83ba-a9b0f7a0157f","uuid":"7db8394a-12b9-48b2-be42-6fcf08c131b7"}
