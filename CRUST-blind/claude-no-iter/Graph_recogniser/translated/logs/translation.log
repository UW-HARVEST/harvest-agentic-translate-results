ssert_eq!(r, 718841);\n}\n\n#[test]\nfn test_logger() {\n    use Graph_recogniser::log::{Logger, LogType};\n    let logger = Logger::new();\n    let old = logger.change_log_priority(LogType::OpenHash, 5);\n    assert_eq!(old, 0);\n    let old = logger.change_log_priority(LogType::OpenHash, 10);\n    assert_eq!(old, 5);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":210,"cache_read_input_tokens":65683,"cache_creation":{"ephemeral_5m_input_tokens":210,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a6a7b539-a18b-4136-a935-1189efa1fa30","uuid":"cf4bde16-73b6-446b-8960-962fcdbd66e4"}
