f.cur_size = 0;\n        self.max_size = 0;\n    }\n}\n\n#[cfg(debug_assertions)]\nconst EPS_OR_ZERO: f32 = EPS;\n#[cfg(not(debug_assertions))]\nconst EPS_OR_ZERO: f32 = 0.0;\n","structuredPatch":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":5,"lines":[" use std::sync::{Arc, RwLock};","-use crate::hash::{hash, rehash, compare_keys, POWER, REHASHER};","+use crate::hash::{rehash, compare_keys, POWER, REHASHER};"," "," const LOAD_FACTOR: f32 = 0.6;"," #[cfg(debug_assertions)]"]}],"userModified":false,"replaceAll":false}}
