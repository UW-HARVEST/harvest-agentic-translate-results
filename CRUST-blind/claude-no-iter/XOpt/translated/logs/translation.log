struct xoptOption *option,          /* detected option */\n46\t\tbool                    longArg,          /* true if the long-arg version\n47\t\t                                             was used */\n48\t\tconst char              **err);           /* err output */\n49\t\n50\tenum xoptOptionFlag {\n51\t\tXOPT_TYPE_STRING          = 0x1,          /* const char* type */\n52\t\tXOPT_TYPE_INT             = 0x2,          /* int type */\n53\t\tXOPT_TYPE_LONG            = 0x4,          /* long type */\n54\t\tXOPT_TYPE_FLOAT           = 0x8,          /* float type */\n55\t\tXOPT_TYPE_DOUBLE          = 0x10,         /* double type */\n56\t\tXOPT_TYPE_BOOL            = 0x20,         /* boolean (int) type */\n57\t\n58\t\tXOPT_OPTIONAL             = 0x40          /* whether the argument value is\n59\t\t                                             optional */\n60\t};\n61\t\n62\tenum xoptContextFlag {\n63\t\tXOPT_CTX_KEEPFIRST        = 0x1,          /* don't ignore argv[0] */\n64\t\tXOPT_CTX_POSIXMEHARDER    = 0x2,          /* options cannot come after\n65\t\t                                             extra arguments */\n66\t\tXOPT_CTX_NOCONDENSE       = 0x4,          /* don't allow short args to be\n67\t\t                                             condensed (i.e. `ls -laF') */\n68\t\tXOPT_CTX_SLOPPYSHORTS     = 0x8 | 0x4,    /* allow short arg values to be\n69\t\t                                             directly after the character\n70\t\t                                             (implies NOCONDENSE) */\n71\t\tXOPT_CTX_STRICT           = 0x10          /* fails on invalid arguments */\n72\t};\n73\t\n74\ttypedef struct xoptOption {\n75\t\tconst char                *longArg;       /* --long-arg-name, or 0 for short\n76\t\t                                             arg only */\n77\t\tconst char                shortArg;       /* -s hort arg character, or '\\0'\n78\t\t                                             for long arg only */\n79\t\tsize_t                    offset;         /* offsetof(type, property) for\n80\t\t                                             automatic configuration handler */\n81\t\txoptCallback              callback;       /* callback for resolved option\n82\t\t                                             handling */\n83\t\tlong                      options;        /* xoptOptionFlag options */\n84\t\tconst char                *argDescrip;    /* --argument=argDescrip (autohelp) */\n85\t\tconst char                *descrip;       /* argument explanation (autohelp) */\n86\t} xoptOption;\n87\t\n88\t/* option list terminator */\n89\t#define XOPT_NULLOPTION {0, 0, 0, 0, 0, 0, 0}\n90\t\n91\ttypedef struct xoptContext xoptContext;\n92\t\n93\ttypedef struct xoptAutohelpOptions {\n94\t\tconst char                *usage;         /* usage string, or null */\n95\t\tconst char                *prefix;        /* printed before options, or null */\n96\t\tconst char                *suffix;        /* printed after options, or null */\n97\t\tsize_t                    spacer;         /* number of spaces between option and\n98\t\t                                             description */\n99\t} xoptAutohelpOptions;\n100\t\n101\t#ifdef __cplusplus\n102\textern \"C\" {\n103\t#endif\n104\t\n105\t/**\n106\t * Creates an XOpt context to be used with\n107\t * subsequent calls to XOpt functions\n108\t */\n109\txoptContext*\n110\txopt_context(\n111\t\tconst char              *name,            /* name of the argument set (usually\n112\t\t                                             name of the cli binary file/cmd */\n113\t\tconst xoptOption        *options,         /* list of xoptOption objects,\n114\t\t                                             terminated with XOPT_NULLOPTION */\n115\t\tlong                    flags,            /* xoptContextFlag flags */\n116\t\tconst char              **err);           /* pointer to a const char* that\n117\t\t                                             receives an err should one occur -\n118\t\t                                             set to 0 if command completed\n119\t\t                                             successfully */\n120\t\n121\t/**\n122\t * Parses the command line of a program\n123\t * and returns the number of non-options\n124\t * returned to the `extras' pointer (see\n125\t * below)\n126\t */\n127\tint\n128\txopt_parse(\n129\t\txoptContext             *ctx,             /* previously created XOpt context */\n130\t\tint                     argc,             /* argc, from int main() */\n131\t\tconst char              **argv,           /* argv, from int main() */\n132\t\tvoid                    *data,            /* a custom data object whos type\n133\t\t                                             corresponds to `.offset' values\n134\t\t                                             specified in the options list;\n135\t\t                                             populated with values interpreted\n136\t\t                                             from the command line */\n137\t\tconst char              ***extras,        /* receives a list of extra non-option\n138\t\t                                             arguments (i.e. files, subcommands,\n139\t\t                                             etc.) - length of which is returned\n140\t\t                                             by the function call */\n141\t\tconst char              **err);           /* pointer to a const char* that\n142\t\t                                             receives an err should one occur -\n143\t\t                                             set to 0 if command completed\n144\t\t                                             successfully */\n145\t\n146\t/**\n147\t * Generates and prints a help message\n148\t * and prints it to a FILE stream.\n149\t * If `defaults' is supplied, uses\n150\t * offsets (values) defined by the options\n151\t * list to show default options\n152\t */\n153\tvoid\n154\txopt_autohelp(\n155\t\txoptContext                 *ctx,         /* previously created XOpt context */\n156\t\tFILE                        *stream,      /* a stream to print to - if 0,\n157\t\t                                             defaults to `stderr'. */\n158\t\tconst xoptAutohelpOptions   *options,     /* configuration options to tailor\n159\t\t                                             autohelp output */\n160\t\tconst char                  **err);       /* pointer to a const char* that\n161\t\t                                             receives an err should one occur -\n162\t\t                                             set to 0 if command completed\n163\t\t                                             successfully */\n164\t\n165\t/**\n166\t * Generates a default option parser that's sane for most cases.\n167\t *\n168\t * Assumes there's a `help` property that is boolean-checkable that exists on the\n169\t * config pointer passed to `config_ptr` (i.e. does a lookup of `config_ptr->help`).\n170\t *\n171\t * In the event help is invoked, xopt will `goto xopt_help`. It is up to you to define such\n172\t * a label in order to recover. In this case, extrav will still be allocated and will still need to be\n173\t * freed.\n174\t *\n175\t * To be extra clear, you need to free `extrav_ptr` is if `*err_ptr` is not `NULL`.\n176\t *\n177\t * `name` is the name of the binary you'd like to pass to the context (welcome to use `argv[0]` here),\n178\t * `options` is a reference to the xoptOptions array you've specified,\n179\t * `config_ptr` is a *pointer* to your configuration instance,\n180\t * `argc` and `argv` are the int/const char ** passed into main,\n181\t * `extrac_ptr` and `extrav_ptr` are pointers to an `int`/`const char **`\n182\t *    (so `int*` and `const char ***`, respectively) that receive the parsed extra args\n183\t *    (note that, unless there is an error, `extrav_ptr` is owned by your program and must\n184\t *    be `free()`'d when you're done using it, even if there are zero extra arguments),\n185\t *  and `err_ptr` is a pointer to a `const char *` (so a `const char **`) that receives any error\n186\t *    strings in the event of a problem. These errors are statically allocated so no need to\n187\t *    free them. This variable should be initialized to NULL and checked after calling\n188\t *    `XOPT_SIMPLE_PARSE()`.\n189\t *\n190\t *  `autohelp_file`, `autohelp_usage`, `autohelp_prefix`, `autohelp_suffix` and `autohelp_spacer` are all\n191\t *  parameters to the `xoptAutohelpOptions` struct (with the exception of `autohelp_file`, which must be a\n192\t *  `FILE*` reference (e.g. `stdout` or `stderr`) which receives the rendered autohelp text). Consult the\n193\t *  `xoptAutohelpOptions` struct above for documentation as to valid values for each of these properties.\n194\t */\n195\t#define XOPT_SIMPLE_PARSE(name, options, config_ptr, argc, argv, extrac_ptr, extrav_ptr, err_ptr, autohelp_file, autohelp_usage, autohelp_prefix, autohelp_suffix, autohelp_spacer) do { \\\n196\t\t\txoptContext *_xopt_ctx; \\\n197\t\t\t\\\n198\t\t\t*(err_ptr) = NULL; \\\n199\t\t\t\\\n200\t\t\t_xopt_ctx = xopt_context((name), (options), XOPT_CTX_POSIXMEHARDER | XOPT_CTX_STRICT, (err_ptr)); \\\n201\t\t\tif (*(err_ptr)) break; \\\n202\t\t\t\\\n203\t\t\t*extrac_ptr = xopt_parse(_xopt_ctx, (argc), (argv), (config_ptr), (extrav_ptr), (err_ptr)); \\\n204\t\t\tif (*(err_ptr)) goto __xopt_end_free_ctx; \\\n205\t\t\t\\\n206\t\t\tif ((config_ptr)->help) { \\\n207\t\t\t\txoptAutohelpOptions __xopt_autohelp_opts; \\\n208\t\t\t\t__xopt_autohelp_opts.usage = (autohelp_usage); \\\n209\t\t\t\t__xopt_autohelp_opts.prefix = (autohelp_prefix); \\\n210\t\t\t\t__xopt_autohelp_opts.suffix = (autohelp_suffix); \\\n211\t\t\t\t__xopt_autohelp_opts.spacer = (autohelp_spacer); \\\n212\t\t\t\txopt_autohelp(_xopt_ctx, (autohelp_file), &__xopt_autohelp_opts, (err_ptr)); \\\n213\t\t\t\tif (*(err_ptr)) goto __xopt_end_free_extrav; \\\n214\t\t\t\tgoto xopt_help; \\\n215\t\t\t} \\\n216\t\t\\\n217\t\t__xopt_end_free_ctx: \\\n218\t\t\tfree(_xopt_ctx); \\\n219\t\t\tbreak; \\\n220\t\t__xopt_end_free_extrav: \\\n221\t\t\tfree(*(extrav_ptr)); \\\n222\t\t\tfree(_xopt_ctx); \\\n223\t\t\tbreak; \\\n224\t\t} while (false)\n225\t\n226\t#ifdef __cplusplus\n227\t}\n228\t#endif\n229\t#endif\n230\t"}]},"parent_tool_use_id":null,"session_id":"291e235b-487c-45d5-8bf2-1373d268a969","uuid":"0ddbf4b0-eab1-4f42-ac75-025f0f50d45c","timestamp":"2026-06-03T11:15:02.100Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-BvHVHU/project/c_src/xopt.h","content":"/**\n * XOpt - command line parsing library\n *\n * Copyright (c) 2015 Josh Junon.\n *\n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n *\n * The above copyright notice and this permission notice shall be included in\n * all copies or substantial portions of the Software.\n *\n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n * THE SOFTWARE.\n */\n#ifndef XOPT_H__\n#define XOPT_H__\n#pragma once\n\n#include <stdio.h>\n#include <stdbool.h>\n\nstruct xoptOption;\n\n#ifndef offsetof\n#\tdefine offsetof(T, member) (size_t)(&(((T*)0)->member))\n#endif\n\n/**\n * Callback type for handling values.\n *  Called when a command line argument has been\n *  processed.\n */\ntypedef void (*xoptCallback)(\n\tconst char              *value,           /* string cmd line option */\n\tvoid                    *data,            /* custom data structure */\n\tconst struct xoptOption *option,          /* detected option */\n\tbool                    longArg,          /* true if the long-arg version\n\t                                             was used */\n\tconst char              **err);           /* err output */\n\nenum xoptOptionFlag {\n\tXOPT_TYPE_STRING          = 0x1,          /* const char* type */\n\tXOPT_TYPE_INT             = 0x2,          /* int type */\n\tXOPT_TYPE_LONG            = 0x4,          /* long type */\n\tXOPT_TYPE_FLOAT           = 0x8,          /* float type */\n\tXOPT_TYPE_DOUBLE          = 0x10,         /* double type */\n\tXOPT_TYPE_BOOL            = 0x20,         /* boolean (int) type */\n\n\tXOPT_OPTIONAL             = 0x40          /* whether the argument value is\n\t                                             optional */\n};\n\nenum xoptContextFlag {\n\tXOPT_CTX_KEEPFIRST        = 0x1,          /* don't ignore argv[0] */\n\tXOPT_CTX_POSIXMEHARDER    = 0x2,          /* options cannot come after\n\t                                             extra arguments */\n\tXOPT_CTX_NOCONDENSE       = 0x4,          /* don't allow short args to be\n\t                                             condensed (i.e. `ls -laF') */\n\tXOPT_CTX_SLOPPYSHORTS     = 0x8 | 0x4,    /* allow short arg values to be\n\t                                             directly after the character\n\t                                             (implies NOCONDENSE) */\n\tXOPT_CTX_STRICT           = 0x10          /* fails on invalid arguments */\n};\n\ntypedef struct xoptOption {\n\tconst char                *longArg;       /* --long-arg-name, or 0 for short\n\t                                             arg only */\n\tconst char                shortArg;       /* -s hort arg character, or '\\0'\n\t                                             for long arg only */\n\tsize_t                    offset;         /* offsetof(type, property) for\n\t                                             automatic configuration handler */\n\txoptCallback              callback;       /* callback for resolved option\n\t                                             handling */\n\tlong                      options;        /* xoptOptionFlag options */\n\tconst char                *argDescrip;    /* --argument=argDescrip (autohelp) */\n\tconst char                *descrip;       /* argument explanation (autohelp) */\n} xoptOption;\n\n/* option list terminator */\n#define XOPT_NULLOPTION {0, 0, 0, 0, 0, 0, 0}\n\ntypedef struct xoptContext xoptContext;\n\ntypedef struct xoptAutohelpOptions {\n\tconst char                *usage;         /* usage string, or null */\n\tconst char                *prefix;        /* printed before options, or null */\n\tconst char                *suffix;        /* printed after options, or null */\n\tsize_t                    spacer;         /* number of spaces between option and\n\t                                             description */\n} xoptAutohelpOptions;\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n/**\n * Creates an XOpt context to be used with\n * subsequent calls to XOpt functions\n */\nxoptContext*\nxopt_context(\n\tconst char              *name,            /* name of the argument set (usually\n\t                                             name of the cli binary file/cmd */\n\tconst xoptOption        *options,         /* list of xoptOption objects,\n\t                                             terminated with XOPT_NULLOPTION */\n\tlong                    flags,            /* xoptContextFlag flags */\n\tconst char              **err);           /* pointer to a const char* that\n\t                                             receives an err should one occur -\n\t                                             set to 0 if command completed\n\t                                             successfully */\n\n/**\n * Parses the command line of a program\n * and returns the number of non-options\n * returned to the `extras' pointer (see\n * below)\n */\nint\nxopt_parse(\n\txoptContext             *ctx,             /* previously created XOpt context */\n\tint                     argc,             /* argc, from int main() */\n\tconst char              **argv,           /* argv, from int main() */\n\tvoid                    *data,            /* a custom data object whos type\n\t                                             corresponds to `.offset' values\n\t                                             specified in the options list;\n\t                                             populated with values interpreted\n\t                                             from the command line */\n\tconst char              ***extras,        /* receives a list of extra non-option\n\t                                             arguments (i.e. files, subcommands,\n\t                                             etc.) - length of which is returned\n\t                                             by the function call */\n\tconst char              **err);           /* pointer to a const char* that\n\t                                             receives an err should one occur -\n\t                                             set to 0 if command completed\n\t                                             successfully */\n\n/**\n * Generates and prints a help message\n * and prints it to a FILE stream.\n * If `defaults' is supplied, uses\n * offsets (values) defined by the options\n * list to show default options\n */\nvoid\nxopt_autohelp(\n\txoptContext                 *ctx,         /* previously created XOpt context */\n\tFILE                        *stream,      /* a stream to print to - if 0,\n\t                                             defaults to `stderr'. */\n\tconst xoptAutohelpOptions   *options,     /* configuration options to tailor\n\t                                             autohelp output */\n\tconst char                  **err);       /* pointer to a const char* that\n\t                                             receives an err should one occur -\n\t                                             set to 0 if command completed\n\t                                             successfully */\n\n/**\n * Generates a default option parser that's sane for most cases.\n *\n * Assumes there's a `help` property that is boolean-checkable that exists on the\n * config pointer passed to `config_ptr` (i.e. does a lookup of `config_ptr->help`).\n *\n * In the event help is invoked, xopt will `goto xopt_help`. It is up to you to define such\n * a label in order to recover. In this case, extrav will still be allocated and will still need to be\n * freed.\n *\n * To be extra clear, you need to free `extrav_ptr` is if `*err_ptr` is not `NULL`.\n *\n * `name` is the name of the binary you'd like to pass to the context (welcome to use `argv[0]` here),\n * `options` is a reference to the xoptOptions array you've specified,\n * `config_ptr` is a *pointer* to your configuration instance,\n * `argc` and `argv` are the int/const char ** passed into main,\n * `extrac_ptr` and `extrav_ptr` are pointers to an `int`/`const char **`\n *    (so `int*` and `const char ***`, respectively) that receive the parsed extra args\n *    (note that, unless there is an error, `extrav_ptr` is owned by your program and must\n *    be `free()`'d when you're done using it, even if there are zero extra arguments),\n *  and `err_ptr` is a pointer to a `const char *` (so a `const char **`) that receives any error\n *    strings in the event of a problem. These errors are statically allocated so no need to\n *    free them. This variable should be initialized to NULL and checked after calling\n *    `XOPT_SIMPLE_PARSE()`.\n *\n *  `autohelp_file`, `autohelp_usage`, `autohelp_prefix`, `autohelp_suffix` and `autohelp_spacer` are all\n *  parameters to the `xoptAutohelpOptions` struct (with the exception of `autohelp_file`, which must be a\n *  `FILE*` reference (e.g. `stdout` or `stderr`) which receives the rendered autohelp text). Consult the\n *  `xoptAutohelpOptions` struct above for documentation as to valid values for each of these properties.\n */\n#define XOPT_SIMPLE_PARSE(name, options, config_ptr, argc, argv, extrac_ptr, extrav_ptr, err_ptr, autohelp_file, autohelp_usage, autohelp_prefix, autohelp_suffix, autohelp_spacer) do { \\\n\t\txoptContext *_xopt_ctx; \\\n\t\t\\\n\t\t*(err_ptr) = NULL; \\\n\t\t\\\n\t\t_xopt_ctx = xopt_context((name), (options), XOPT_CTX_POSIXMEHARDER | XOPT_CTX_STRICT, (err_ptr)); \\\n\t\tif (*(err_ptr)) break; \\\n\t\t\\\n\t\t*extrac_ptr = xopt_parse(_xopt_ctx, (argc), (argv), (config_ptr), (extrav_ptr), (err_ptr)); \\\n\t\tif (*(err_ptr)) goto __xopt_end_free_ctx; \\\n\t\t\\\n\t\tif ((config_ptr)->help) { \\\n\t\t\txoptAutohelpOptions __xopt_autohelp_opts; \\\n\t\t\t__xopt_autohelp_opts.usage = (autohelp_usage); \\\n\t\t\t__xopt_autohelp_opts.prefix = (autohelp_prefix); \\\n\t\t\t__xopt_autohelp_opts.suffix = (autohelp_suffix); \\\n\t\t\t__xopt_autohelp_opts.spacer = (autohelp_spacer); \\\n\t\t\txopt_autohelp(_xopt_ctx, (autohelp_file), &__xopt_autohelp_opts, (err_ptr)); \\\n\t\t\tif (*(err_ptr)) goto __xopt_end_free_extrav; \\\n\t\t\tgoto xopt_help; \\\n\t\t} \\\n\t\\\n\t__xopt_end_free_ctx: \\\n\t\tfree(_xopt_ctx); \\\n\t\tbreak; \\\n\t__xopt_end_free_extrav: \\\n\t\tfree(*(extrav_ptr)); \\\n\t\tfree(_xopt_ctx); \\\n\t\tbreak; \\\n\t} while (false)\n\n#ifdef __cplusplus\n}\n#endif\n#endif\n","numLines":230,"startLine":1,"totalLines":230}}}
