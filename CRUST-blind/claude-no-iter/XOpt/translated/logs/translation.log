nted before the options list, or `None`.\n    pub prefix: Option<String>,\n    /// Printed after the options list, or `None`.\n    pub suffix: Option<String>,\n    /// Number of spaces between option and description.\n    pub spacer: usize,\n}\npub fn xopt_context(\n    name: Option<&str>,\n    options: &[XoptOption],\n    flags: i64,\n    err: &mut Option<String>,\n) -> Option<Box<XoptContext>> {\n    unimplemented!()\n}\npub fn xopt_parse(\n    ctx: &mut XoptContext,\n    argc: i32,\n    argv: &[&str],\n    data: *mut u8,\n    extras: &mut Option<Vec<String>>,\n    err: &mut Option<String>,\n) -> i32 {\n    unimplemented!()\n}\npub fn xopt_autohelp(\n    ctx: &mut XoptContext,\n    stream: &mut dyn std::io::Write,\n    options: Option<&XoptAutohelpOptions>,\n    err: &mut Option<String>,\n) {\n    unimplemented!()\n}\n#[macro_export]\nmacro_rules! XOPT_SIMPLE_PARSE {\n    ( \n      $name:expr,\n      $options:expr,\n      $config_ptr:expr,\n      $argc:expr,\n      $argv:expr,\n      $extrac_ptr:expr,\n      $extrav_ptr:expr,\n      $err_ptr:expr,\n      $autohelp_file:expr,\n      $autohelp_usage:expr,\n      $autohelp_prefix:expr,\n      $autohelp_suffix:expr,\n      $autohelp_spacer:expr\n    ) => {\n        unimplemented!();\n    };\n}","userModified":false}}
