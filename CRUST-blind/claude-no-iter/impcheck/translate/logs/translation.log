{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Tt6nKDsWxsuBV4ZZMVqDmr","type":"tool_result","content":"1\t\n2\t#include <stdio.h>\n3\t#include <stdlib.h>\n4\t#include <unistd.h>\n5\t#include <sys/types.h>\n6\t#include <sys/stat.h>\n7\t#include <sys/wait.h>\n8\t\n9\t// contains the definitions of constants for our checker interface\n10\t#include \"../src/trusted/checker_interface.h\"\n11\t\n12\t// other imports from this project - just for convenience, not strictly needed\n13\t#include \"test.h\"\n14\t#include \"../src/trusted/trusted_utils.h\"\n15\t// Instantiate int_vec (poor man's template programming in C)\n16\t#define TYPE int\n17\t#define TYPED(THING) int_ ## THING\n18\t#include \"../src/trusted/vec.h\"\n19\t#undef TYPED\n20\t#undef TYPE\n21\t\n22\t\n23\t\n24\t// We only use this to create unique names for the named pipes\n25\t// for cases where multiple checkers|parsers run at once.\n26\tu64 checker_instance_id = 1;\n27\t\n28\t// Fork the process into a parent and a child.\n29\tbool do_fork() {\n30\t    pid_t child_pid = fork();\n31\t    do_assert(child_pid >= 0);\n32\t    return child_pid == 0;\n33\t}\n34\t\n35\t// Set up a \"named pipe\" special file at the specified location.\n36\tvoid create_pipe(const char* path) {\n37\t    remove(path);\n38\t    int res = mkfifo(path, 0777);\n39\t    do_assert(res == 0);\n40\t}\n41\t\n42\t// Flush the output (pipe), wait until an 'OK' arrives from the input (pipe)\n43\tvoid await_ok(FILE* out, FILE* in) {\n44\t    fflush(out);\n45\t    bool ok = trusted_utils_read_char(in);\n46\t    do_assert(ok);\n47\t}\n48\t\n49\t// Set up a ready-to-go trusted checker process.\n50\t// - create all named pipes needed for inter-process communication\n51\t// - run a trusted parser instance and read the parsed formula\n52\t//   together with its signature\n53\t// - launch a trusted checker instance and forward the formula\n54\t//   with its signature\n55\t// - return an ID which is needed for the corresponding clean_up() below\n56\t// - return the file handles for writing directives and for reading\n57\t//   feedback via the two out params\n58\tu64 setup(const char* cnfInput, FILE** f_directives_out, FILE** f_feedback_out) {\n59\t\n60\t    char charbuf[1024]; // to construct some strings\n61\t\n62\t    // create pipes (delete old ones, if still present)\n63\t    char pipeParsed[64], pipeDirectives[64], pipeFeedback[64];\n64\t    snprintf(pipeParsed, 64, \".parsed.%lu.pipe\", checker_instance_id);\n65\t    snprintf(pipeDirectives, 64, \".directives.%lu.pipe\", checker_instance_id);\n66\t    snprintf(pipeFeedback, 64, \".feedback.%lu.pipe\", checker_instance_id);\n67\t    create_pipe(pipeParsed);\n68\t    create_pipe(pipeDirectives);\n69\t    create_pipe(pipeFeedback);\n70\t\n71\t    // Fork off a parser process.\n72\t    if (do_fork()) {\n73\t        // child: parser process\n74\t        snprintf(charbuf, 1024, \"build/impcheck_parse -formula-input=%s -fifo-parsed-formula=%s\",\n75\t            cnfInput, pipeParsed);\n76\t        int res = system(charbuf);\n77\t        do_assert(res == 0);\n78\t        exit(0); // child process done\n79\t    } // -- parent\n80\t\n81\t    // read parsed formula\n82\t    FILE* in_parsed = fopen(pipeParsed, \"r\");\n83\t    const int nb_vars = trusted_utils_read_int(in_parsed);\n84\t    /*const int nb_clauses = */trusted_utils_read_int(in_parsed);\n85\t    struct int_vec* fvec = int_vec_init(1<<14);\n86\t    while (true) {\n87\t        // (note: cannot use trusted_utils_read_int here since EOF makes it terminate)\n88\t        int lit;\n89\t        const int nb_read = fread(&lit, sizeof(int), 1, in_parsed);\n90\t        if (nb_read == 0) break;\n91\t        int_vec_push(fvec, lit);\n92\t    }\n93\t    const int* f = fvec->data;\n94\t    // the last SIG_SIZE_BYTES bytes of the \"formula\" are actually its signature\n95\t    const u8* fsig = ((u8*) (fvec->data + fvec->size)) - SIG_SIZE_BYTES;\n96\t    const u64 fsize = fvec->size - (SIG_SIZE_BYTES / sizeof(int));\n97\t    // wait for parser process to exit (equivalent to \"join\")\n98\t    wait(0);\n99\t    fclose(in_parsed);\n100\t\n101\t    // Fork off a checker process.\n102\t    if (do_fork()) {\n103\t        // child: checker process\n104\t        snprintf(charbuf, 1024, \"build/impcheck_check -fifo-directives=%s -fifo-feedback=%s -check-model\",\n105\t            pipeDirectives, pipeFeedback);\n106\t        int res = system(charbuf);\n107\t        do_assert(res == 0);\n108\t        exit(0); // child process done\n109\t    } // -- parent\n110\t\n111\t    // open communication channels with checker process\n112\t    FILE* out_directives = fopen(pipeDirectives, \"w\");\n113\t    FILE* in_feedback = fopen(pipeFeedback, \"r\");\n114\t\n115\t    // Directive \"BEGIN\"\n116\t    trusted_utils_write_char(TRUSTED_CHK_INIT, out_directives);\n117\t    trusted_utils_write_int(nb_vars, out_directives);\n118\t    trusted_utils_write_sig(fsig, out_directives);\n119\t    await_ok(out_directives, in_feedback);\n120\t\n121\t    // Directive \"LOAD\"\n122\t    trusted_utils_write_char(TRUSTED_CHK_LOAD, out_directives);\n123\t    trusted_utils_write_int(fsize, out_directives);\n124\t    trusted_utils_write_ints(f, fsize, out_directives);\n125\t    // (no feedback)\n126\t\n127\t    // Directive \"END_LOAD\"\n128\t    trusted_utils_write_char(TRUSTED_CHK_END_LOAD, out_directives);\n129\t    await_ok(out_directives, in_feedback);\n130\t\n131\t    // The checker process is now in a state where it can take\n132\t    // individual derivations, imports, deletions and such.\n133\t\n134\t    // clean up formula vector\n135\t    int_vec_free(fvec);\n136\t\n137\t    // return file handles\n138\t    *f_directives_out = out_directives;\n139\t    *f_feedback_out = in_feedback;\n140\t\n141\t    // increment our checker ID for the next call\n142\t    return checker_instance_id++;\n143\t}\n144\t\n145\tbool confirm(const char* cnfInput, int result, const u8* sig) {\n146\t\n147\t    // Convert result signature to a string\n148\t    char sigstr[2*SIG_SIZE_BYTES+1];\n149\t    trusted_utils_sig_to_str(sig, sigstr);\n150\t\n151\t    // Execute confirmer sub-process\n152\t    char charbuf[1024];\n153\t    snprintf(charbuf, 1024, \"build/impcheck_confirm -formula-input=%s -result=%i -result-sig=%s\",\n154\t        cnfInput, result, sigstr);\n155\t    const int res = system(charbuf);\n156\t\n157\t    return res == 0;\n158\t}\n159\t\n160\t// Clean up a checker process previously opened via \"setup\". The checker must already\n161\t// have received and responded to a TERMINATE directive beforehand.\n162\tvoid clean_up(u64 checker_id, FILE* out_directives, FILE* in_feedback) {\n163\t\n164\t    // \"TERMINATE\" directive\n165\t    trusted_utils_write_char(TRUSTED_CHK_TERMINATE, out_directives);\n166\t    await_ok(out_directives, in_feedback);\n167\t\n168\t    // close pipes\n169\t    fclose(out_directives);\n170\t    fclose(in_feedback);\n171\t\n172\t    // remove pipe files\n173\t    char pipeParsed[64], pipeDirectives[64], pipeFeedback[64];\n174\t    snprintf(pipeParsed, 64, \".parsed.%lu.pipe\", checker_id);\n175\t    snprintf(pipeDirectives, 64, \".directives.%lu.pipe\", checker_id);\n176\t    snprintf(pipeFeedback, 64, \".feedback.%lu.pipe\", checker_id);\n177\t    remove(pipeParsed);\n178\t    remove(pipeDirectives);\n179\t    remove(pipeFeedback);\n180\t\n181\t    // \"join\" checker process\n182\t    // NOTE: This wait() does not necessarily match the intended process.\n183\t    // Since all resources are cleaned up before a sub-process' termination anyway,\n184\t    // all we really want is to call wait() as often as there are sub-processes.\n185\t    wait(0);\n186\t}\n187\t\n188\t// Helper method to add and check a single clause derivation.\n189\tvoid produce_cls(FILE* out_directives, FILE* in_feedback,\n190\t    u64 id, int clslen, const int* lits, int hintlen, const u64* hints, u8* sig_or_null) {\n191\t\n192\t    trusted_utils_write_char(TRUSTED_CHK_CLS_PRODUCE, out_directives); // PRODUCE (\"add\") directive\n193\t    trusted_utils_write_ul(id, out_directives); // clause ID\n194\t    trusted_utils_write_int(clslen, out_directives); // clause length\n195\t    trusted_utils_write_ints(lits, clslen, out_directives); // literals\n196\t    trusted_utils_write_int(hintlen, out_directives); // # hints\n197\t    trusted_utils_write_uls(hints, hintlen, out_directives); // hints\n198\t    trusted_utils_write_bool(sig_or_null!=0, out_directives); // share / produce signature?\n199\t    await_ok(out_directives, in_feedback);\n200\t    if (sig_or_null != 0) {\n201\t        trusted_utils_read_sig(sig_or_null, in_feedback);\n202\t    }\n203\t}\n204\t\n205\t// Helper method to import a single clause.\n206\tvoid import_cls(FILE* out_directives, FILE* in_feedback,\n207\t    u64 id, int clslen, const int* lits, u8* signature) {\n208\t\n209\t    trusted_utils_write_char(TRUSTED_CHK_CLS_IMPORT, out_directives); // IMPORT directive\n210\t    trusted_utils_write_ul(id, out_directives); // clause ID\n211\t    trusted_utils_write_int(clslen, out_directives); // clause length\n212\t    trusted_utils_write_ints(lits, clslen, out_directives); // literals\n213\t    trusted_utils_write_sig(signature, out_directives); // signature\n214\t    await_ok(out_directives, in_feedback);\n215\t}\n216\t\n217\t// Helper method to delete a set of clauses (specified by IDs).\n218\tvoid delete_cls(FILE* out_directives, FILE* in_feedback, const u64* ids, int nb_ids) {\n219\t\n220\t    trusted_utils_write_char(TRUSTED_CHK_CLS_DELETE, out_directives);\n221\t    trusted_utils_write_int(nb_ids, out_directives);\n222\t    trusted_utils_write_uls(ids, nb_ids, out_directives);\n223\t    await_ok(out_directives, in_feedback);\n224\t}\n225\t\n226\t\n227\t\n228\t\n229\t/*\n230\tFull \"trusted solving\" run on a trivial satisfiable formula.\n231\t*/\n232\tvoid test_trivial_sat() {\n233\t    printf(\"[TEST] --- begin test_trivial_sat() ---\\n\");\n234\t\n235\t    // Parse formula and set up trusted checker process\n236\t    const char* cnf = \"cnf/trivial-sat.cnf\";\n237\t    FILE *out_directives, *in_feedback;\n238\t    u64 chkid = setup(cnf, &out_directives, &in_feedback);\n239\t\n240\t    // VALIDATE_SAT\n241\t    trusted_utils_write_char(TRUSTED_CHK_VALIDATE_SAT, out_directives);\n242\t    trusted_utils_write_int(2, out_directives);\n243\t    int model[2] = {1, -2};\n244\t    trusted_utils_write_ints(model, 2, out_directives);\n245\t    await_ok(out_directives, in_feedback);\n246\t    u8 sat_sig[SIG_SIZE_BYTES];\n247\t    trusted_utils_read_sig(sat_sig, in_feedback);\n248\t\n249\t    // (optional) confirm with \"confirmer\" module\n250\t    bool ok = confirm(cnf, 10, sat_sig);\n251\t    do_assert(ok);\n252\t\n253\t    // TERMINATE\n254\t    clean_up(chkid, out_directives, in_feedback);\n255\t    printf(\"[TEST] ---  end  test_trivial_sat() ---\\n\\n\");\n256\t}\n257\t\n258\t/*\n259\tFull \"trusted solving\" run on a tiny unsatisfiable formula:\n260\t(id) p cnf 2 4\n261\t(1)  1 2 0\n262\t(2)  1 -2 0\n263\t(3)  -1 2 0\n264\t(4)  -1 -2 0\n265\t--- proof:\n266\t5  1  0  1 2 0\n267\t6  -1 0  3 4 0\n268\t7     0  5 6 0\n269\t*/\n270\tvoid test_trivial_unsat() {\n271\t    printf(\"[TEST] --- begin test_trivial_unsat() ---\\n\");\n272\t\n273\t    // Parse formula and set up trusted checker process\n274\t    const char* cnf = \"cnf/trivial-unsat.cnf\";\n275\t    FILE *out_directives, *in_feedback;\n276\t    u64 chkid = setup(cnf, &out_directives, &in_feedback);\n277\t\n278\t    // PRODUCE\n279\t    const int cls_5[1] = {1}; const u64 hints_5[2] = {1, 2};\n280\t    produce_cls(out_directives, in_feedback, 5, 1, cls_5, 2, hints_5, 0);\n281\t    const int cls_6[1] = {-1}; const u64 hints_6[2] = {3, 4};\n282\t    produce_cls(out_directives, in_feedback, 6, 1, cls_6, 2, hints_6, 0);\n283\t    const u64 hints_7[2] = {5, 6};\n284\t    produce_cls(out_directives, in_feedback, 7, 0, 0, 2, hints_7, 0);\n285\t\n286\t    // VALIDATE_UNSAT\n287\t    trusted_utils_write_char(TRUSTED_CHK_VALIDATE_UNSAT, out_directives);\n288\t    await_ok(out_directives, in_feedback);\n289\t    u8 unsat_sig[SIG_SIZE_BYTES];\n290\t    trusted_utils_read_sig(unsat_sig, in_feedback);\n291\t\n292\t    // (optional) confirm with \"confirmer\" module\n293\t    bool ok = confirm(cnf, 20, unsat_sig);\n294\t    do_assert(ok);\n295\t\n296\t    // TERMINATE\n297\t    clean_up(chkid, out_directives, in_feedback);\n298\t    printf(\"[TEST] ---  end  test_trivial_unsat() ---\\n\\n\");\n299\t}\n300\t\n301\t/*\n302\tFull \"trusted solving\" run on the same formula as in test_trivial_unsat()\n303\tbut now with two checker sub-processes at once.\n304\t*/\n305\tvoid test_trivial_unsat_x2() {\n306\t    printf(\"[TEST] --- begin test_trivial_unsat_x2() ---\\n\");\n307\t\n308\t    // Parse formula and set up trusted checker processes.\n309\t    // (NOTE: We run a parser process for each checker process we initialize.\n310\t    // In actual solvers, you probably want to only run a single parser process\n311\t    // and use its output for all solvers and checkers.)\n312\t    const char* cnf = \"cnf/trivial-unsat.cnf\";\n313\t    FILE *out_directives_1, *in_feedback_1;\n314\t    u64 chkid_1 = setup(cnf, &out_directives_1, &in_feedback_1);\n315\t    FILE *out_directives_2, *in_feedback_2;\n316\t    u64 chkid_2 = setup(cnf, &out_directives_2, &in_feedback_2);\n317\t\n318\t    // PRODUCE\n319\t    const int cls_5[1] = {1}; const u64 hints_5[2] = {1, 2}; u8 sig_5[SIG_SIZE_BYTES];\n320\t    produce_cls(out_directives_1, in_feedback_1, 5, 1, cls_5, 2, hints_5, sig_5);\n321\t    const int cls_6[1] = {-1}; const u64 hints_6[2] = {3, 4}; u8 sig_6[SIG_SIZE_BYTES];\n322\t    produce_cls(out_directives_2, in_feedback_2, 6, 1, cls_6, 2, hints_6, sig_6);\n323\t\n324\t    // DELETE\n325\t    const u64 del_ids[4] = {3, 4};\n326\t    delete_cls(out_directives_2, in_feedback_2, del_ids, 2);\n327\t\n328\t    // IMPORT\n329\t    import_cls(out_directives_1, in_feedback_1, 6, 1, cls_6, sig_6);\n330\t    import_cls(out_directives_2, in_feedback_2, 5, 1, cls_5, sig_5);\n331\t\n332\t    // PRODUCE\n333\t    const u64 hints_7[2] = {5, 6};\n334\t    produce_cls(out_directives_1, in_feedback_1, 7, 0, 0, 2, hints_7, false);\n335\t\n336\t    // VALIDATE_UNSAT\n337\t    trusted_utils_write_char(TRUSTED_CHK_VALIDATE_UNSAT, out_directives_1);\n338\t    await_ok(out_directives_1, in_feedback_1);\n339\t    u8 unsat_sig[SIG_SIZE_BYTES];\n340\t    trusted_utils_read_sig(unsat_sig, in_feedback_1);\n341\t\n342\t    // (optional) confirm with \"confirmer\" module\n343\t    bool ok = confirm(cnf, 20, unsat_sig);\n344\t    do_assert(ok);\n345\t    \n346\t    // TERMINATE\n347\t    clean_up(chkid_1, out_directives_1, in_feedback_1);\n348\t    clean_up(chkid_2, out_directives_2, in_feedback_2);\n349\t    printf(\"[TEST] ---  end  test_trivial_unsat_x2() ---\\n\\n\");\n350\t}\n351\t\n352\tint main() {\n353\t    test_trivial_sat();\n354\t    test_trivial_unsat();\n355\t    test_trivial_unsat_x2();\n356\t}\n357\t"}]},"parent_tool_use_id":null,"session_id":"9f9343fd-160d-4715-94c7-039e791f5235","uuid":"90395200-bb98-4e4f-8385-a719197d9b46","timestamp":"2026-06-03T09:36:07.569Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-L8rL0D/project/c_src/test/test_full.c","content":"\n#include <stdio.h>\n#include <stdlib.h>\n#include <unistd.h>\n#include <sys/types.h>\n#include <sys/stat.h>\n#include <sys/wait.h>\n\n// contains the definitions of constants for our checker interface\n#include \"../src/trusted/checker_interface.h\"\n\n// other imports from this project - just for convenience, not strictly needed\n#include \"test.h\"\n#include \"../src/trusted/trusted_utils.h\"\n// Instantiate int_vec (poor man's template programming in C)\n#define TYPE int\n#define TYPED(THING) int_ ## THING\n#include \"../src/trusted/vec.h\"\n#undef TYPED\n#undef TYPE\n\n\n\n// We only use this to create unique names for the named pipes\n// for cases where multiple checkers|parsers run at once.\nu64 checker_instance_id = 1;\n\n// Fork the process into a parent and a child.\nbool do_fork() {\n    pid_t child_pid = fork();\n    do_assert(child_pid >= 0);\n    return child_pid == 0;\n}\n\n// Set up a \"named pipe\" special file at the specified location.\nvoid create_pipe(const char* path) {\n    remove(path);\n    int res = mkfifo(path, 0777);\n    do_assert(res == 0);\n}\n\n// Flush the output (pipe), wait until an 'OK' arrives from the input (pipe)\nvoid await_ok(FILE* out, FILE* in) {\n    fflush(out);\n    bool ok = trusted_utils_read_char(in);\n    do_assert(ok);\n}\n\n// Set up a ready-to-go trusted checker process.\n// - create all named pipes needed for inter-process communication\n// - run a trusted parser instance and read the parsed formula\n//   together with its signature\n// - launch a trusted checker instance and forward the formula\n//   with its signature\n// - return an ID which is needed for the corresponding clean_up() below\n// - return the file handles for writing directives and for reading\n//   feedback via the two out params\nu64 setup(const char* cnfInput, FILE** f_directives_out, FILE** f_feedback_out) {\n\n    char charbuf[1024]; // to construct some strings\n\n    // create pipes (delete old ones, if still present)\n    char pipeParsed[64], pipeDirectives[64], pipeFeedback[64];\n    snprintf(pipeParsed, 64, \".parsed.%lu.pipe\", checker_instance_id);\n    snprintf(pipeDirectives, 64, \".directives.%lu.pipe\", checker_instance_id);\n    snprintf(pipeFeedback, 64, \".feedback.%lu.pipe\", checker_instance_id);\n    create_pipe(pipeParsed);\n    create_pipe(pipeDirectives);\n    create_pipe(pipeFeedback);\n\n    // Fork off a parser process.\n    if (do_fork()) {\n        // child: parser process\n        snprintf(charbuf, 1024, \"build/impcheck_parse -formula-input=%s -fifo-parsed-formula=%s\",\n            cnfInput, pipeParsed);\n        int res = system(charbuf);\n        do_assert(res == 0);\n        exit(0); // child process done\n    } // -- parent\n\n    // read parsed formula\n    FILE* in_parsed = fopen(pipeParsed, \"r\");\n    const int nb_vars = trusted_utils_read_int(in_parsed);\n    /*const int nb_clauses = */trusted_utils_read_int(in_parsed);\n    struct int_vec* fvec = int_vec_init(1<<14);\n    while (true) {\n        // (note: cannot use trusted_utils_read_int here since EOF makes it terminate)\n        int lit;\n        const int nb_read = fread(&lit, sizeof(int), 1, in_parsed);\n        if (nb_read == 0) break;\n        int_vec_push(fvec, lit);\n    }\n    const int* f = fvec->data;\n    // the last SIG_SIZE_BYTES bytes of the \"formula\" are actually its signature\n    const u8* fsig = ((u8*) (fvec->data + fvec->size)) - SIG_SIZE_BYTES;\n    const u64 fsize = fvec->size - (SIG_SIZE_BYTES / sizeof(int));\n    // wait for parser process to exit (equivalent to \"join\")\n    wait(0);\n    fclose(in_parsed);\n\n    // Fork off a checker process.\n    if (do_fork()) {\n        // child: checker process\n        snprintf(charbuf, 1024, \"build/impcheck_check -fifo-directives=%s -fifo-feedback=%s -check-model\",\n            pipeDirectives, pipeFeedback);\n        int res = system(charbuf);\n        do_assert(res == 0);\n        exit(0); // child process done\n    } // -- parent\n\n    // open communication channels with checker process\n    FILE* out_directives = fopen(pipeDirectives, \"w\");\n    FILE* in_feedback = fopen(pipeFeedback, \"r\");\n\n    // Directive \"BEGIN\"\n    trusted_utils_write_char(TRUSTED_CHK_INIT, out_directives);\n    trusted_utils_write_int(nb_vars, out_directives);\n    trusted_utils_write_sig(fsig, out_directives);\n    await_ok(out_directives, in_feedback);\n\n    // Directive \"LOAD\"\n    trusted_utils_write_char(TRUSTED_CHK_LOAD, out_directives);\n    trusted_utils_write_int(fsize, out_directives);\n    trusted_utils_write_ints(f, fsize, out_directives);\n    // (no feedback)\n\n    // Directive \"END_LOAD\"\n    trusted_utils_write_char(TRUSTED_CHK_END_LOAD, out_directives);\n    await_ok(out_directives, in_feedback);\n\n    // The checker process is now in a state where it can take\n    // individual derivations, imports, deletions and such.\n\n    // clean up formula vector\n    int_vec_free(fvec);\n\n    // return file handles\n    *f_directives_out = out_directives;\n    *f_feedback_out = in_feedback;\n\n    // increment our checker ID for the next call\n    return checker_instance_id++;\n}\n\nbool confirm(const char* cnfInput, int result, const u8* sig) {\n\n    // Convert result signature to a string\n    char sigstr[2*SIG_SIZE_BYTES+1];\n    trusted_utils_sig_to_str(sig, sigstr);\n\n    // Execute confirmer sub-process\n    char charbuf[1024];\n    snprintf(charbuf, 1024, \"build/impcheck_confirm -formula-input=%s -result=%i -result-sig=%s\",\n        cnfInput, result, sigstr);\n    const int res = system(charbuf);\n\n    return res == 0;\n}\n\n// Clean up a checker process previously opened via \"setup\". The checker must already\n// have received and responded to a TERMINATE directive beforehand.\nvoid clean_up(u64 checker_id, FILE* out_directives, FILE* in_feedback) {\n\n    // \"TERMINATE\" directive\n    trusted_utils_write_char(TRUSTED_CHK_TERMINATE, out_directives);\n    await_ok(out_directives, in_feedback);\n\n    // close pipes\n    fclose(out_directives);\n    fclose(in_feedback);\n\n    // remove pipe files\n    char pipeParsed[64], pipeDirectives[64], pipeFeedback[64];\n    snprintf(pipeParsed, 64, \".parsed.%lu.pipe\", checker_id);\n    snprintf(pipeDirectives, 64, \".directives.%lu.pipe\", checker_id);\n    snprintf(pipeFeedback, 64, \".feedback.%lu.pipe\", checker_id);\n    remove(pipeParsed);\n    remove(pipeDirectives);\n    remove(pipeFeedback);\n\n    // \"join\" checker process\n    // NOTE: This wait() does not necessarily match the intended process.\n    // Since all resources are cleaned up before a sub-process' termination anyway,\n    // all we really want is to call wait() as often as there are sub-processes.\n    wait(0);\n}\n\n// Helper method to add and check a single clause derivation.\nvoid produce_cls(FILE* out_directives, FILE* in_feedback,\n    u64 id, int clslen, const int* lits, int hintlen, const u64* hints, u8* sig_or_null) {\n\n    trusted_utils_write_char(TRUSTED_CHK_CLS_PRODUCE, out_directives); // PRODUCE (\"add\") directive\n    trusted_utils_write_ul(id, out_directives); // clause ID\n    trusted_utils_write_int(clslen, out_directives); // clause length\n    trusted_utils_write_ints(lits, clslen, out_directives); // literals\n    trusted_utils_write_int(hintlen, out_directives); // # hints\n    trusted_utils_write_uls(hints, hintlen, out_directives); // hints\n    trusted_utils_write_bool(sig_or_null!=0, out_directives); // share / produce signature?\n    await_ok(out_directives, in_feedback);\n    if (sig_or_null != 0) {\n        trusted_utils_read_sig(sig_or_null, in_feedback);\n    }\n}\n\n// Helper method to import a single clause.\nvoid import_cls(FILE* out_directives, FILE* in_feedback,\n    u64 id, int clslen, const int* lits, u8* signature) {\n\n    trusted_utils_write_char(TRUSTED_CHK_CLS_IMPORT, out_directives); // IMPORT directive\n    trusted_utils_write_ul(id, out_directives); // clause ID\n    trusted_utils_write_int(clslen, out_directives); // clause length\n    trusted_utils_write_ints(lits, clslen, out_directives); // literals\n    trusted_utils_write_sig(signature, out_directives); // signature\n    await_ok(out_directives, in_feedback);\n}\n\n// Helper method to delete a set of clauses (specified by IDs).\nvoid delete_cls(FILE* out_directives, FILE* in_feedback, const u64* ids, int nb_ids) {\n\n    trusted_utils_write_char(TRUSTED_CHK_CLS_DELETE, out_directives);\n    trusted_utils_write_int(nb_ids, out_directives);\n    trusted_utils_write_uls(ids, nb_ids, out_directives);\n    await_ok(out_directives, in_feedback);\n}\n\n\n\n\n/*\nFull \"trusted solving\" run on a trivial satisfiable formula.\n*/\nvoid test_trivial_sat() {\n    printf(\"[TEST] --- begin test_trivial_sat() ---\\n\");\n\n    // Parse formula and set up trusted checker process\n    const char* cnf = \"cnf/trivial-sat.cnf\";\n    FILE *out_directives, *in_feedback;\n    u64 chkid = setup(cnf, &out_directives, &in_feedback);\n\n    // VALIDATE_SAT\n    trusted_utils_write_char(TRUSTED_CHK_VALIDATE_SAT, out_directives);\n    trusted_utils_write_int(2, out_directives);\n    int model[2] = {1, -2};\n    trusted_utils_write_ints(model, 2, out_directives);\n    await_ok(out_directives, in_feedback);\n    u8 sat_sig[SIG_SIZE_BYTES];\n    trusted_utils_read_sig(sat_sig, in_feedback);\n\n    // (optional) confirm with \"confirmer\" module\n    bool ok = confirm(cnf, 10, sat_sig);\n    do_assert(ok);\n\n    // TERMINATE\n    clean_up(chkid, out_directives, in_feedback);\n    printf(\"[TEST] ---  end  test_trivial_sat() ---\\n\\n\");\n}\n\n/*\nFull \"trusted solving\" run on a tiny unsatisfiable formula:\n(id) p cnf 2 4\n(1)  1 2 0\n(2)  1 -2 0\n(3)  -1 2 0\n(4)  -1 -2 0\n--- proof:\n5  1  0  1 2 0\n6  -1 0  3 4 0\n7     0  5 6 0\n*/\nvoid test_trivial_unsat() {\n    printf(\"[TEST] --- begin test_trivial_unsat() ---\\n\");\n\n    // Parse formula and set up trusted checker process\n    const char* cnf = \"cnf/trivial-unsat.cnf\";\n    FILE *out_directives, *in_feedback;\n    u64 chkid = setup(cnf, &out_directives, &in_feedback);\n\n    // PRODUCE\n    const int cls_5[1] = {1}; const u64 hints_5[2] = {1, 2};\n    produce_cls(out_directives, in_feedback, 5, 1, cls_5, 2, hints_5, 0);\n    const int cls_6[1] = {-1}; const u64 hints_6[2] = {3, 4};\n    produce_cls(out_directives, in_feedback, 6, 1, cls_6, 2, hints_6, 0);\n    const u64 hints_7[2] = {5, 6};\n    produce_cls(out_directives, in_feedback, 7, 0, 0, 2, hints_7, 0);\n\n    // VALIDATE_UNSAT\n    trusted_utils_write_char(TRUSTED_CHK_VALIDATE_UNSAT, out_directives);\n    await_ok(out_directives, in_feedback);\n    u8 unsat_sig[SIG_SIZE_BYTES];\n    trusted_utils_read_sig(unsat_sig, in_feedback);\n\n    // (optional) confirm with \"confirmer\" module\n    bool ok = confirm(cnf, 20, unsat_sig);\n    do_assert(ok);\n\n    // TERMINATE\n    clean_up(chkid, out_directives, in_feedback);\n    printf(\"[TEST] ---  end  test_trivial_unsat() ---\\n\\n\");\n}\n\n/*\nFull \"trusted solving\" run on the same formula as in test_trivial_unsat()\nbut now with two checker sub-processes at once.\n*/\nvoid test_trivial_unsat_x2() {\n    printf(\"[TEST] --- begin test_trivial_unsat_x2() ---\\n\");\n\n    // Parse formula and set up trusted checker processes.\n    // (NOTE: We run a parser process for each checker process we initialize.\n    // In actual solvers, you probably want to only run a single parser process\n    // and use its output for all solvers and checkers.)\n    const char* cnf = \"cnf/trivial-unsat.cnf\";\n    FILE *out_directives_1, *in_feedback_1;\n    u64 chkid_1 = setup(cnf, &out_directives_1, &in_feedback_1);\n    FILE *out_directives_2, *in_feedback_2;\n    u64 chkid_2 = setup(cnf, &out_directives_2, &in_feedback_2);\n\n    // PRODUCE\n    const int cls_5[1] = {1}; const u64 hints_5[2] = {1, 2}; u8 sig_5[SIG_SIZE_BYTES];\n    produce_cls(out_directives_1, in_feedback_1, 5, 1, cls_5, 2, hints_5, sig_5);\n    const int cls_6[1] = {-1}; const u64 hints_6[2] = {3, 4}; u8 sig_6[SIG_SIZE_BYTES];\n    produce_cls(out_directives_2, in_feedback_2, 6, 1, cls_6, 2, hints_6, sig_6);\n\n    // DELETE\n    const u64 del_ids[4] = {3, 4};\n    delete_cls(out_directives_2, in_feedback_2, del_ids, 2);\n\n    // IMPORT\n    import_cls(out_directives_1, in_feedback_1, 6, 1, cls_6, sig_6);\n    import_cls(out_directives_2, in_feedback_2, 5, 1, cls_5, sig_5);\n\n    // PRODUCE\n    const u64 hints_7[2] = {5, 6};\n    produce_cls(out_directives_1, in_feedback_1, 7, 0, 0, 2, hints_7, false);\n\n    // VALIDATE_UNSAT\n    trusted_utils_write_char(TRUSTED_CHK_VALIDATE_UNSAT, out_directives_1);\n    await_ok(out_directives_1, in_feedback_1);\n    u8 unsat_sig[SIG_SIZE_BYTES];\n    trusted_utils_read_sig(unsat_sig, in_feedback_1);\n\n    // (optional) confirm with \"confirmer\" module\n    bool ok = confirm(cnf, 20, unsat_sig);\n    do_assert(ok);\n    \n    // TERMINATE\n    clean_up(chkid_1, out_directives_1, in_feedback_1);\n    clean_up(chkid_2, out_directives_2, in_feedback_2);\n    printf(\"[TEST] ---  end  test_trivial_unsat_x2() ---\\n\\n\");\n}\n\nint main() {\n    test_trivial_sat();\n    test_trivial_unsat();\n    test_trivial_unsat_x2();\n}\n","numLines":357,"startLine":1,"totalLines":357}}}
