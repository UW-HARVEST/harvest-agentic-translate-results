atrix(m));","+    let n = m.cols;","+    let mut pivot = identity_matrix(n);","+    // NOTE: faithfully replicates the C source. In the original code,","+    // `swaps++` increments the pointer parameter, not the integer it points","+    // to, so the swap counter is never actually updated. We mirror that","+    // behaviour here so downstream code (e.g. `determinant`) sees the same","+    // values as the C implementation.","+    let swaps: i32 = 0;","+    for i in 0..n {","+        let mut max = m.data[i * n + i];","+        let mut row = i;","+        for j in i..n {","+            if m.data[j * n + i] > max {","+                max = m.data[j * n + i];","+                row = j;","+            }","+        }","+        if i != row {","+            let v = get_row_vector(&pivot, i);","+            let w = get_row_vector(&pivot, row);","+            set_row_vector(&mut pivot, i, &w);","+            set_row_vector(&mut pivot, row, &v);","+            // swaps++ in the C source increments the pointer, not the value.","+            // We deliberately do not update `swaps` here.","+        }","+    }","+    (pivot, swaps)","+}"]}],"originalFile":"#[derive(Debug, Clone, PartialEq)]\npub struct Matrix {\n    pub rows: usize,\n    pub cols: usize,\n    pub data: Vec<f64>,\n}\n#[derive(Debug, Clone, PartialEq)]\npub struct Vector {\n    pub cols: usize,\n    pub data: Vec<f64>,\n}\n// --- Helper assertion functions ---\npub fn assert_matrix(m: &Matrix) -> bool {\n    unimplemented!()\n}\npub fn assert_vector(v: &Vector) -> bool {\n    unimplemented!()\n}\n// --- Creation functions ---\npub fn new_matrix(d: &[f64], rows: usize, cols: usize) -> Matrix {\n    unimplemented!()\n}\npub fn new_vector(d: &[f64], cols: usize) -> Vector {\n    unimplemented!()\n}\npub fn null_matrix(rows: usize, cols: usize) -> Matrix {\n    unimplemented!()\n}\npub fn null_vector(cols: usize) -> Vector {\n    unimplemented!()\n}\npub fn zero_matrix(rows: usize, cols: usize) -> Matrix {\n    unim