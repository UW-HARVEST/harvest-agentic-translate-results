ree() {\n\tBOSTree *t = bostree_new((BOSTree_cmp_function)strcmp, NULL);\n\tchar i;\n\tfor(i='A'; i<'Z'; i++) {\n\t\tchar *key = malloc(2);\n\t\tkey[0] = i; key[1] = 0;\n\t\tbostree_insert(t, key, NULL);\n\t}\n\n\treturn t;\n}\n\nint main() {\n\t// Prepare the situation from above\n\tBOSTree *t = test_tree();\n\tbostree_remove(t, bostree_lookup(t, strdup(\"G\")));\n\tbostree_remove(t, bostree_lookup(t, strdup(\"H\")));\n\n\ttest_tree_sanity(t);\n\tif(bostree_lookup(t, strdup(\"E\")) == NULL) {\n\t\tprintf(\"Nodes missing after removing another one\\n\");\n\t\texit(1);\n\t}\n\n\treturn 0;\n}\n","numLines":48,"startLine":1,"totalLines":48}}}
{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_k6lsicjrzmjtzkgy7fnvyu3qjd3i44w277cecjbiur2edsf74qzq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016FfBDaRZicncETDsrdr4Bu","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-QYFbhB/project/examples/sanity.rs","content":"use Bostree::bostree::BOSTree;\nuse Bostree::test_tree_sanity;\n\nfn cmp(a: &str, b: &str) -> i32 {\n    if a < b { -1 } else if a > b { 1 } else { 0 }\n}\n\nfn main() {\n    let mut tree = BOSTree::bostree_new(cmp, None);\n    println!(\"Insert test:\");\n    for c in b'A'..=b'Z' {\n        let s = format!(\"{}\", c as char);\n        print!(\"Insert {}, \", s);\n        tree.bostree_insert(s, Some(\"Value\".to_string()));\n        test_tree_sanity(&tree);\n    }\n    println!();\n\n    println!(\"Remove test:\");\n    for c in b'A'..=b'Z' {\n        let s = format!(\"{}\", c as char);\n        print!(\"Remove {}, \", s);\n        let node = tree.bostree_lookup(&s).expect(\"not found\");\n        tree.bostree_remove(&node);\n        test_tree_sanity(&tree);\n    }\n    println!();\n\n    // remove_bug.c style test\n    println!(\"remove_bug test:\");\n    for r in b'A'..b'Z' {\n        let mut t = BOSTree::bostree_new(cmp, None);\n        for c in b'A'..b'Z' {\n            t.bostree_insert(format!(\"{}\", c as char), None);\n        }\n        let key = format!(\"{}\", r as char);\n        let n = t.bostree_lookup(&key).expect(\"not found\");\n        t.bostree_remove(&n);\n        test_tree_sanity(&t);\n        if t.bostree_node_count() != (b'Z' - b'A' - 1) as u32 {\n            panic!(\"node count wrong\");\n        }\n    }\n    println!(\"remove_bug passed\");\n\n    // remove_bug_2.c style\n    let mut t = BOSTree::bostree_new(cmp, None);\n    for c in b'A'..b'Z' {\n        t.bostree_insert(format!(\"{}\", c as char), None);\n    }\n    let g = t.bostree_lookup(\"G\").unwrap();\n    t.bostree_remove(&g);\n    let h = t.bostree_lookup(\"H\").unwrap();\n    t.bostree_remove(&h);\n    test_tree_sanity(&t);\n    assert!(t.bostree_lookup(\"E\").is_some());\n    println!(\"remove_bug_2 passed\");\n\n    // Random insertions & removals\n    use rand::seq::SliceRandom;\n    let mut rng = rand::rng();\n    for _trial in 0..20 {\n        let mut t = BOSTree::bostree_new(cmp, None);\n        let mut keys: Vec<String> = (0..100).map(|i| format!(\"k{:04}\", i)).collect();\n        keys.shuffle(&mut rng);\n        for k in &keys {\n            t.bostree_insert(k.clone(), None);\n            test_tree_sanity(&t);\n        }\n        let mut remove_order = keys.clone();\n        remove_order.shuffle(&mut rng);\n        for k in &remove_order {\n            let n = t.bostree_lookup(k).unwrap();\n            t.bostree_remove(&n);\n            test_tree_sanity(&t);\n        }\n    }\n    println!(\"Random tests passed\");\n\n    println!(\"All tests passed\");\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":641,"cache_read_input_tokens":44765,"cache_creation":{"ephemeral_5m_input_tokens":641,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e7cf16e2-51f7-4304-90fc-74fbb899c4d3","uuid":"475a05f7-4a29-4cf2-adce-d745416e7e39"}
