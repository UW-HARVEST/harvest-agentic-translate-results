         if (params->expression->type != EXP_SYMBOL) {\n1172\t            printf(\"Function parameter must be symbol.\\n\");\n1173\t            exit(1);\n1174\t          }\n1175\t          param_symbol_names[i] = params->expression->data.symbol->symbol_name;\n1176\t          i++;\n1177\t          params = params->next;\n1178\t        }\n1179\t\n1180\t        struct ExpressionNode *bodyExpr =\n1181\t            expressions->next->next->next->expression;\n1182\t        if (bodyExpr == NULL) {\n1183\t          printf(\"Function must have body.\\n\");\n1184\t          exit(1);\n1185\t        }\n1186\t\n1187\t        struct Function *function = malloc(sizeof(struct Function));\n1188\t        function->param_symbol_names = param_symbol_names;\n1189\t        function->body = bodyExpr;\n1190\t\n1191\t        evaluated->type = OBJ_FUNCTION;\n1192\t        evaluated->function_value = function;\n1193\t\n1194\t        setObjectToEnv(env, symbol_name, evaluated);\n1195\t      } else {\n1196\t        // function call\n1197\t        if (strcmp(expr->data.symbol->symbol_name, \"+\") == 0) {\n1198\t          // +\n1199\t          struct Object *operand1 = allocate(context, env);\n1200\t          struct Object *operand2 = allocate(context, env);\n1201\t          evaluateExpression(expressions->next->expression, operand1, env,\n1202\t                             context);\n1203\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1204\t                             context);\n1205\t          definedFunctionAdd(operand1, operand2, evaluated);\n1206\t        } else if (strcmp(expr->data.symbol->symbol_name, \"-\") == 0) {\n1207\t          // -\n1208\t          struct Object *operand1 = allocate(context, env);\n1209\t          struct Object *operand2 = allocate(context, env);\n1210\t          evaluateExpression(expressions->next->expression, operand1, env,\n1211\t                             context);\n1212\t          evaluateExpression(expressions->next->nex