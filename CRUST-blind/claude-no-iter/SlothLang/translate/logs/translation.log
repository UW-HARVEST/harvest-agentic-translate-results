Some(lossy)\n        }\n    }\n}\n\npub fn prog_len(file: &std::fs::File) -> usize {\n    let mut file = file;\n    // Save current position so we can restore it (C uses fseek to SEEK_SET).\n    let original = file.stream_position().unwrap_or(0);\n    let _ = file.seek(SeekFrom::Start(0));\n\n    let mut count: usize = 0;\n    let mut byte = [0u8; 1];\n    loop {\n        match file.read(&mut byte) {\n            Ok(0) => break,\n            Ok(_) => {\n                if byte[0] == b'\\n' {\n                    count += 1;\n                }\n            }\n            Err(_) => break,\n        }\n    }\n\n    // Reset to the position the C code expected (start of file).\n    let _ = file.seek(SeekFrom::Start(original));\n    let _ = file.seek(SeekFrom::Start(0));\n\n    count * 3\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2319,"cache_read_input_tokens":30438,"cache_creation":{"ephemeral_5m_input_tokens":2319,"ephemeral_1h_input_tokens":0},"output_tokens":31,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0eebed29-c1b4-439c-a05c-0ddfcaf22c28","uuid":"ae8c2948-eee8-43f1-8dcf-fc910d135eb7"}
