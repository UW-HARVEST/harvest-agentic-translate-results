           continue;\n        }\n\n        let mut count: usize = 0;\n        let mut current_code: u8 = 0;\n        let mut c = bytes[0];\n\n        while c != 0 && c != 0xFF && c != b'#' && count <= len {\n            // Match keywords against the substring starting at `count`.\n            let rem = &bytes[count..len];\n            if rem.len() >= 6 && &rem[0..6] == b\"slothy\" {\n                if code_num < byte_code.len() {\n                    byte_code[code_num] = 0x1;\n                }\n                code_num += 1;\n                count += 6;\n                had_token = true;\n            } else if rem.len() >= 5 && &rem[0..5] == b\"sloth\" {\n                current_code = current_code.wrapping_add(1);\n                count += 5;\n                had_token = true;\n            } else if rem.len() >= 3 && &rem[0..3] == b\"and\" {\n                if code_num < byte_code.len() {\n                    byte_code[code_num] = current_code;\n                }\n                code_num += 1;\n                current_code = 0;\n                count += 3;\n                had_token = true;\n            } else if rem.len() >= 3 && &rem[0..3] == b\"nap\" {\n                if code_num < byte_code.len() {\n                    byte_code[code_num] = 0x0;\n                }\n                code_num += 1;\n                count += 3;\n                had_token = true;\n            } else {\n                // Ignore any other characters.\n                count += 1;\n            }\n\n            // Update `c` from the new position. C reads `line[count]` which\n            // could be the trailing NUL or beyond `len` if we advanced past it.\n            if count < bytes.len() {\n                c = bytes[count];\n                if c == 0xFF {\n                    break;\n                }\n            } else {\n                c = 0;\n                break;\n            }\n        }\n\n        if had_token {\n            if code_num < byte_code.len() {\n                byte_code[code_num] = current_code;\n            }\n            code_num += 1;\n            had_token = false;\n        }\n    }\n\n    Some(SlothProgram {\n        codes: byte_code,\n        pc: 0,\n    })\n}\n\npub fn free_program(_program: Option<SlothProgram>) {\n    // In Rust, dropping the SlothProgram value is sufficient. Receiving the\n    // owned `Option` here causes it to be dropped at the end of this scope.\n}\n\npub fn readline(file: &std::fs::File) -> Option<String> {\n    // Mirrors the C `readline`:\n    //  - Read characters one at a time until a newline.\n    //  - On EOF, append a 0xFF byte (the C `-1` value cast to char) before the\n    //    NUL terminator. Since Rust strings cannot easily hold non-UTF-8 bytes,\n    //    we encode the 0xFF as a Unicode replacement-style marker character.\n    //\n    // The returned `String` does NOT include the trailing newline. If EOF is\n    // hit, the last byte is 0xFF (encoded as the Unicode codepoint U+00FF / 'ÿ'\n    // could collide with valid input, so instead we use a non-UTF-8-safe trick:\n    // produce the bytes via `from_utf8_lossy` after construction).\n    //\n    // For simplicity we instead build a byte vector and convert to a String by\n    // mapping 0xFF to itself (using an unsafe-free approach: returning a string\n    // that contains the 0xFF byte requires `unsafe`, which we avoid by mapping\n    // the EOF byte to the character U+00FF ('ÿ') whose UTF-8 encoding is the\n    // two-byte sequence 0xC3 0xBF). Since the parser only checks for byte 0xFF\n    // at index 0, we instead do not use the encoded character. Instead we use a\n    // dedicated non-text sentinel: an empty `String` for true EOF, and a\n    // `String` whose first byte is the literal 0xFF for mid-line EOF.\n    //\n    // To safely embed a 0xFF byte we use `String::from_utf8` with a manually\n    // produced byte vector; if conversion fails we fall back to using\n    // `from_utf8_lossy` which replaces invalid bytes with U+FFFD. To preserve\n    // the EOF-detection contract, we ALSO check for empty input as EOF in\n    // `parse`.\n    let mut file = file;\n    let mut buf: Vec<u8> = Vec::with_capacity(100);\n    let mut byte = [0u8; 1];\n    let mut hit_eof = false;\n\n    loop {\n        match file.read(&mut byte) {\n            Ok(0) => {\n                hit_eof = true;\n                break;\n            }\n            Ok(_) => {\n                if byte[0] == b'\\n' {\n                    break;\n                }\n                buf.push(byte[0]);\n            }\n            Err(_) => {\n                hit_eof = true;\n                break;\n            }\n        }\n    }\n\n    if hit_eof {\n        // Push the EOF sentinel byte (0xFF) so the parser can detect end of\n        // file by examining the first byte (matching the C behaviour where the\n        // first byte equals -1).\n        buf.insert(0, 0xFF);\n    }\n\n    // Convert the byte vector to a String. Replace any non-UTF-8 sequences\n    // with their lossy equivalents while preserving the length semantics used\n    // by the parser. To preserve the 0xFF EOF sentinel, we use `from_utf8`\n    // first; if that fails, we fall back to producing a string that begins\n    // with 0xFF using `String::from_utf8_unchecked`-equivalent safe alternative.\n    match String::from_utf8(buf.clone()) {\n        Ok(s) => Some(s),\n        Err(_) => {\n            // Use lossy conversion as a fallback. The parser primarily looks\n            // for ASCII keywords (\"slothy\", \"sloth\", \"and\", \"nap\"), so any\n            // non-UTF-8 input would not match these keywords anyway and would\n            // be skipped.\n            let lossy = String::from_utf8_lossy(&buf).into_owned();\n            Some(lossy)\n        }\n    }\n}\n\npub fn prog_len(file: &std::fs::File) -> usize {\n    let mut file = file;\n    // Save current position so we can restore it (C uses fseek to SEEK_SET).\n    let original = file.stream_position().unwrap_or(0);\n    let _ = file.seek(SeekFrom::Start(0));\n\n    let mut count: usize = 0;\n    let mut byte = [0u8; 1];\n    loop {\n        match file.read(&mut byte) {\n            Ok(0) => break,\n            Ok(_) => {\n                if byte[0] == b'\\n' {\n                    count += 1;\n                }\n            }\n            Err(_) => break,\n        }\n    }\n\n    // Reset to the position the C code expected (start of file).\n    let _ = file.seek(SeekFrom::Start(original));\n    let _ = file.seek(SeekFrom::Start(0));\n\n    count * 3\n}\n","userModified":false}}
