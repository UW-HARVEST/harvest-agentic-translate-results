ze;\n54\t} string_t;\n55\t\n56\t#ifndef STRING_T_ARRAY\n57\t#define STRING_T_ARRAY string_t **\n58\t#endif\n59\t#ifndef STRING_T_SPACE_CHARS_ARR\n60\t#define STRING_T_SPACE_CHARS_ARR \" \\t\\n\\r\"\n61\t#endif\n62\t\n63\tconst char STRING_T_SPACE_CHARS[] = STRING_T_SPACE_CHARS_ARR;\n64\t\n65\t/* Allocate new string by given size. */\n66\tstring_t *new_string(size_t);\n67\t\n68\t/* Allocate new string by given bytes. */\n69\tstring_t *new_string_from_bytes(const char *);\n70\t\n71\t/* Free string's allocated memory. */\n72\tvoid string_free(string_t *);\n73\t\n74\t/* Return string length. */\n75\tsize_t string_len(const string_t *);\n76\t\n77\t/* Return string bytes. */\n78\tchar *string_bytes(const string_t *);\n79\t\n80\t/* Return true(0) if strings are equal. */\n81\tbool_t string_eq(const string_t *, const string_t *);\n82\t\n83\t/* Return copy of the string. */\n84\tstring_t *string_copy(const string_t *);\n85\t\n86\t/* Return result of 2 strings concatenation. */\n87\tstring_t *string_concat(const string_t *, const string_t *);\n88\t\n89\t/* Return string's sub string. */\n90\tstring_t *string_substr(const string_t *, size_t, size_t);\n91\t\n92\t/* Return true(0) if string starts with given prefix. */\n93\tbool_t string_startswith(const string_t *, const char[]);\n94\t\n95\t/* Return true(0) if string ends with given suffix. */\n96\tbool_t string_endswith(const string_t *, const char[]);\n97\t\n98\t/* Returns the index of substring's occurrence in string. Otherwise returns -1. */\n99\tint string_find(const string_t *, const char[]);\n100\t\n101\t/* Return string without STRING_T_SPACE_CHARS_ARR at the start and end. */\n102\tstring_t *string_strip(const string_t *);\n103\t\n104\t#ifndef _WIN32\n105\t/* Split string by STRING_T_SPACE_CHARS_ARR symbols and return strings array. */\n106\tSTRING_T_ARRAY string_split(const string_t *, size_t *);\n107\t\n108\t/* Split string by given chars and return strings array. */\n109\tSTRING_T_ARRAY string_split_by(const string