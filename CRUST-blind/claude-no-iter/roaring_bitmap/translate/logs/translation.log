{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QyRvrcAw4iN4GX2C54kxgW","type":"tool_result","content":"1\t#include <stdlib.h>\n2\t#include <string.h>\n3\t#include <smmintrin.h>\n4\t\n5\t#include \"rset.h\"\n6\t\n7\t#define NOINLINE __attribute__ ((noinline))\n8\t#define INLINE __attribute__ ((always_inline))\n9\t#define UNLIKELY(x) __builtin_expect((x), 0)\n10\t#define MAX(a, b) ((a > b) ? (a) : (b))\n11\t\n12\tconst static unsigned default_size = 8;\n13\tconst static unsigned growth_factor = 2;\n14\t\n15\tconst static unsigned max_cardinality = 1 << 16;\n16\tconst static unsigned low_cutoff = 1 << 12;\n17\tconst static unsigned high_cutoff = max_cardinality - low_cutoff;\n18\tconst static unsigned max_item = 0xFFFF;\n19\tconst static unsigned max_size = low_cutoff;\n20\t\n21\tstatic bool INLINE rset_is_empty(const rset_t *set)\n22\t{\n23\t    // There are 65536 possible items in the set (0-65535 inclusive) and then\n24\t    // the set can be empty, so there are 65537 (2^16+1) possible states. Since\n25\t    // the cardinality is stored in a uint16_t field with only 2^16 possible\n26\t    // states, it's necessary to use some other means of representing either an\n27\t    // empty set or a full set.\n28\t    //\n29\t    // An empty set is represented in 32-bits by storing a cardinality of two\n30\t    // and then storing the maximum item in the first slot. Since the set uses\n31\t    // a sorted array when cardinality < low_cutoff, there is no possible\n32\t    // second item that could be greater than the item in the first slot, i.e.\n33\t    // the state is invalid.\n34\t\n35\t    return set->buffer[0] == 2 && set->buffer[1] == max_item;\n36\t}\n37\t\n38\tstatic bool INLINE rset_is_full(const rset_t *set)\n39\t{\n40\t    return set->buffer[0] == 0;\n41\t}\n42\t\n43\tstatic bool INLINE rset_is_bitset(const rset_t *set)\n44\t{\n45\t    unsigned cardinality = *set->buffer;\n46\t    return cardinality > low_cutoff && cardinality <= high_cutoff;\n47\t}\n48\t\n49\tstatic bool INLINE rset_is_array(const rset_t *set)\n50\t{\n51\t    unsigned cardinality = *set->buffer;\n52\t    return cardinality <= low_cutoff;\n53\t}\n54\t\n55\tstatic bool INLINE rset_is_inverted_array(const rset_t *set)\n56\t{\n57\t    unsigned cardinality = *set->buffer;\n58\t    return cardinality > high_cutoff;\n59\t}\n60\t\n61\tunsigned rset_cardinality(const rset_t *set)\n62\t{\n63\t    if (rset_is_full(set))\n64\t        return max_cardinality;\n65\t    if (rset_is_empty(set))\n66\t        return 0;\n67\t    return *set->buffer;\n68\t}\n69\t\n70\tbool rset_truncate(rset_t *set)\n71\t{\n72\t    set->buffer[0] = 2;\n73\t    set->buffer[1] = max_item;\n74\t    return true;\n75\t}\n76\t\n77\tbool rset_fill(rset_t *set)\n78\t{\n79\t    set->buffer[0] = 0;\n80\t    return true;\n81\t}\n82\t\n83\trset_t *rset_import(const void *buffer, unsigned length)\n84\t{\n85\t    rset_t *set = malloc(sizeof(rset_t));\n86\t    if (!set)\n87\t        return NULL;\n88\t    unsigned size = length ? length : 1;\n89\t    if (size > max_size)\n90\t        size = max_size;\n91\t    set->buffer = malloc(sizeof(uint16_t) * (1 + size));\n92\t    if (!set->buffer) {\n93\t        free(set);\n94\t        return NULL;\n95\t    }\n96\t    set->size = size;\n97\t    if (buffer && length)\n98\t        memcpy(set->buffer, buffer, length);\n99\t    else\n100\t        rset_truncate(set);\n101\t    return set;\n102\t}\n103\t\n104\trset_t *rset_new()\n105\t{\n106\t    return rset_import(NULL, default_size);\n107\t}\n108\t\n109\tvoid rset_free(rset_t *set)\n110\t{\n111\t    free(set->buffer);\n112\t    free(set);\n113\t}\n114\t\n115\tconst void *rset_export(const rset_t *set)\n116\t{\n117\t    return set->buffer;\n118\t}\n119\t\n120\trset_t *rset_copy(const rset_t *set)\n121\t{\n122\t    return rset_import(rset_export(set), rset_length(set));\n123\t}\n124\t\n125\tstatic unsigned INLINE rset_length_for(unsigned cardinality)\n126\t{\n127\t    if (!cardinality)\n128\t   