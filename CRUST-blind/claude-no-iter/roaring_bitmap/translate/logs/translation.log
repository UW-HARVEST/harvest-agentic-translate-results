245\t}\n246\t\n247\tstatic bool INLINE rset_contains_array(const rset_t *set, uint16_t item)\n248\t{\n249\t    unsigned cardinality = *set->buffer;\n250\t    if (cardinality > high_cutoff)\n251\t        cardinality = max_cardinality - cardinality;\n252\t    uint16_t *array = set->buffer + 1;\n253\t    int first = 0, last = cardinality - 1, middle = (first + last) / 2;\n254\t    while (first <= last) {\n255\t        if (array[middle] == item)\n256\t            return true;\n257\t        if (array[middle] < item)\n258\t            first = middle + 1;\n259\t        else\n260\t            last = middle - 1;\n261\t        middle = (first + last) / 2;\n262\t    }\n263\t    return false;\n264\t}\n265\t\n266\tstatic bool INLINE rset_contains_bitset(const rset_t *set, uint16_t item)\n267\t{\n268\t    return set->buffer[(item >> 4) + 1] & (1 << (item & 0xF));\n269\t}\n270\t\n271\tbool rset_add(rset_t *set, uint16_t item)\n272\t{\n273\t    if (UNLIKELY(rset_is_full(set)))\n274\t        return true;\n275\t\n276\t    if (UNLIKELY(rset_is_empty(set)))\n277\t        *set->buffer = 0;\n278\t\n279\t    unsigned cardinality = *set->buffer;\n280\t    if (UNLIKELY(cardinality == low_cutoff)) {\n281\t        if (rset_contains_array(set, item))\n282\t            return true;\n283\t        if (!rset_convert_array_to_bitset(set))\n284\t            return false;\n285\t    } else if (UNLIKELY(cardinality == high_cutoff)) {\n286\t        if (rset_contains_bitset(set, item))\n287\t            return true;\n288\t        if (!rset_convert_bitset_to_inverted_array(set))\n289\t            return false;\n290\t    }\n291\t\n292\t    if (cardinality < low_cutoff) {\n293\t        if (!rset_add_array(set, item))\n294\t            return false;\n295\t    } else if (cardinality >= high_cutoff) {\n296\t        if (!rset_add_inverted_array(set, item))\n297\t            return false;\n298\t    } else if (!rset_add_bitset(set, item))\n299\t        return false;\n300\t\n301\t    return true;\n302\t}\n303\t\n3