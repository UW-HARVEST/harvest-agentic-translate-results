{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Dnzjd8A7DTn2BNHvFkzaqc","type":"tool_result","content":"1\t/*\n2\t * CLHash is a very fast hashing function that uses the\n3\t * carry-less multiplication and SSE instructions.\n4\t *\n5\t * Daniel Lemire, Owen Kaser, Faster 64-bit universal hashing\n6\t * using carry-less multiplications, Journal of Cryptographic Engineering (to appear)\n7\t *\n8\t * Best used on recent x64 processors (Haswell or better).\n9\t *\n10\t * Compile option: if you define BITMIX during compilation, extra work is done to\n11\t * pass smhasher's avalanche test succesfully. Disabled by default.\n12\t **/\n13\t\n14\t#ifndef INCLUDE_CLHASH_H_\n15\t#define INCLUDE_CLHASH_H_\n16\t\n17\t\n18\t#include <stdlib.h>\n19\t#include <stdint.h> // life is short, please use a C99-compliant compiler\n20\t#include <stddef.h>\n21\t\n22\t#ifdef __cplusplus\n23\textern \"C\" {\n24\t#endif\n25\t\n26\tenum {RANDOM_64BITWORDS_NEEDED_FOR_CLHASH=133,RANDOM_BYTES_NEEDED_FOR_CLHASH=133*8};\n27\t\n28\t\n29\t\n30\t/**\n31\t *  random : the random data source (should contain at least\n32\t *  RANDOM_BYTES_NEEDED_FOR_CLHASH random bytes), it should\n33\t *  also be aligned on 16-byte boundaries so that (((uintptr_t) random & 15) == 0)\n34\t *  for performance reasons. This is usually generated once and reused with many\n35\t *  inputs.\n36\t *\n37\t *\n38\t * stringbyte : the input data source, could be anything you want to has\n39\t *\n40\t *\n41\t * length : number of bytes in the string\n42\t */\n43\tuint64_t clhash(const void* random, const char * stringbyte,\n44\t                const size_t lengthbyte);\n45\t\n46\t\n47\t\n48\t/**\n49\t * Convenience method. Will generate a random key from two 64-bit seeds.\n50\t * Caller is responsible to call \"free\" on the result.\n51\t */\n52\tvoid * get_random_key_for_clhash(uint64_t seed1, uint64_t seed2);\n53\t\n54\t#ifdef __cplusplus\n55\t} // extern \"C\"\n56\t#endif\n57\t\n58\t#ifdef __cplusplus\n59\t#include <vector>\n60\t#include <string>\n61\t#include <cstring> // For std::strlen\n62\t\n63\tstruct clhasher {\n64\t    const void *random_data_;\n65\t    clhasher(uint64_t seed1=137, uint64_t seed2=777): random_data_(get_random_key_for_clhash(seed1, seed2)) {}\n66\t    template<typename T>\n67\t    uint64_t operator()(const T *data, const size_t len) const {\n68\t        return clhash(random_data_, (const char *)data, len * sizeof(T));\n69\t    }\n70\t    uint64_t operator()(const char *str) const {return operator()(str, std::strlen(str));}\n71\t    template<typename T>\n72\t    uint64_t operator()(const T &input) const {\n73\t        return operator()((const char *)&input, sizeof(T));\n74\t    }\n75\t    template<typename T>\n76\t    uint64_t operator()(const std::vector<T> &input) const {\n77\t        return operator()((const char *)input.data(), sizeof(T) * input.size());\n78\t    }\n79\t    uint64_t operator()(const std::string &str) const {\n80\t        return operator()(str.data(), str.size());\n81\t    }\n82\t    ~clhasher() {\n83\t        std::free((void *)random_data_);\n84\t    }\n85\t};\n86\t#endif // #ifdef __cplusplus\n87\t\n88\t#endif /* INCLUDE_CLHASH_H_ */\n89\t"}]},"parent_tool_use_id":null,"session_id":"a3f0fe80-c874-458b-ba42-b92f8bf00f04","uuid":"3e1d0bec-0c35-4bec-baf3-0f227c41c122","timestamp":"2026-06-03T10:35:33.674Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-nPFoNb/project/c_src/src/include/clhash.h","content":"/*\n * CLHash is a very fast hashing function that uses the\n * carry-less multiplication and SSE instructions.\n *\n * Daniel Lemire, Owen Kaser, Faster 64-bit universal hashing\n * using carry-less multiplications, Journal of Cryptographic Engineering (to appear)\n *\n * Best used on recent x64 processors (Haswell or better).\n *\n * Compile option: if you define BITMIX during compilation, extra work is done to\n * pass smhasher's avalanche test succesfully. Disabled by default.\n **/\n\n#ifndef INCLUDE_CLHASH_H_\n#define INCLUDE_CLHASH_H_\n\n\n#include <stdlib.h>\n#include <stdint.h> // life is short, please use a C99-compliant compiler\n#include <stddef.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\nenum {RANDOM_64BITWORDS_NEEDED_FOR_CLHASH=133,RANDOM_BYTES_NEEDED_FOR_CLHASH=133*8};\n\n\n\n/**\n *  random : the random data source (should contain at least\n *  RANDOM_BYTES_NEEDED_FOR_CLHASH random bytes), it should\n *  also be aligned on 16-byte boundaries so that (((uintptr_t) random & 15) == 0)\n *  for performance reasons. This is usually generated once and reused with many\n *  inputs.\n *\n *\n * stringbyte : the input data source, could be anything you want to has\n *\n *\n * length : number of bytes in the string\n */\nuint64_t clhash(const void* random, const char * stringbyte,\n                const size_t lengthbyte);\n\n\n\n/**\n * Convenience method. Will generate a random key from two 64-bit seeds.\n * Caller is responsible to call \"free\" on the result.\n */\nvoid * get_random_key_for_clhash(uint64_t seed1, uint64_t seed2);\n\n#ifdef __cplusplus\n} // extern \"C\"\n#endif\n\n#ifdef __cplusplus\n#include <vector>\n#include <string>\n#include <cstring> // For std::strlen\n\nstruct clhasher {\n    const void *random_data_;\n    clhasher(uint64_t seed1=137, uint64_t seed2=777): random_data_(get_random_key_for_clhash(seed1, seed2)) {}\n    template<typename T>\n    uint64_t operator()(const T *data, const size_t len) const {\n        return clhash(random_data_, (const char *)data, len * sizeof(T));\n    }\n    uint64_t operator()(const char *str) const {return operator()(str, std::strlen(str));}\n    template<typename T>\n    uint64_t operator()(const T &input) const {\n        return operator()((const char *)&input, sizeof(T));\n    }\n    template<typename T>\n    uint64_t operator()(const std::vector<T> &input) const {\n        return operator()((const char *)input.data(), sizeof(T) * input.size());\n    }\n    uint64_t operator()(const std::string &str) const {\n        return operator()(str.data(), str.size());\n    }\n    ~clhasher() {\n        std::free((void *)random_data_);\n    }\n};\n#endif // #ifdef __cplusplus\n\n#endif /* INCLUDE_CLHASH_H_ */\n","numLines":89,"startLine":1,"totalLines":89}}}
