ath":"/tmp/claude-31062124/harvest-crust-nPFoNb/project/examples/smoke.rs","content":"use clhash::clhash::{clhash, get_random_key_for_clhash, ClHasher};\n\nfn main() {\n    let key = get_random_key_for_clhash(0x23a23cf5033c3c81, 0xb3816f6a2c68e530);\n    assert_eq!(key.len(), 1064);\n    let h1 = clhash(&key, b\"my dog\");\n    let h2 = clhash(&key, b\"my cat\");\n    let h3 = clhash(&key, b\"my dog\");\n    assert_eq!(h1, h3);\n    assert_ne!(h1, h2);\n    println!(\"h1 = {:#x}\", h1);\n    println!(\"h2 = {:#x}\", h2);\n\n    // Test ClHasher\n    let h = ClHasher::new(1, 4);\n    let r1 = h.hash(b\"o hai wurld\".as_ref());\n    let r2 = h.hash(\"o hai wurld\".as_bytes());\n    assert_eq!(r1, r2);\n    println!(\"hasher test ok: {:#x}\", r1);\n\n    // Test empty string\n    let _h0 = clhash(&key, b\"\");\n    println!(\"empty hash = {:#x}\", _h0);\n\n    // Test short string of various lengths\n    for length in 1..=64 {\n        let s = vec![0xABu8; length];\n        let h = clhash(&key, &s);\n        // Just ensure no panic\n        let _ = h;\n    }\n    println!(\"length tests ok\");\n\n    // Long string\n    let long_data = vec![0xCDu8; 4096];\n    let lh = clhash(&key, &long_data);\n    println!(\"long hash = {:#x}\", lh);\n\n    // Avalanche-ish test\n    let mut a = [0u8; 8];\n    let orig = clhash(&key, &a);\n    a[0] ^= 1;\n    let flip = clhash(&key, &a);\n    assert_ne!(orig, flip);\n    a[0] ^= 1;\n    let back = clhash(&key, &a);\n    assert_eq!(orig, back);\n    println!(\"avalanche basic ok\");\n}\n","numLines":50,"startLine":1,"totalLines":50}}}
