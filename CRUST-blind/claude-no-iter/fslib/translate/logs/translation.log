{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_u4rmxwof4vwvj73g35qffjv3k2hmbj3eiht3tl2bdfhgps2kclpa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01BaicYQgvF44W4Me4vUTrmj","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-6Xywia/project/src/trim.rs","content":"use crate::queue::Queue;\nuse crate::fst::{ArcData, Fst, EPS};\nuse crate::bitset::BitSet;\nuse crate::sr::sr_get;\nuse crate::iter::FstIter;\npub fn fst_close(fst: &mut Fst, finals: &mut Queue<u32>) {\n    if finals.len() < 2 {\n        return;\n    }\n    let sr = sr_get(fst.sr_type);\n    let final_state = fst.add_state();\n    fst.set_final(final_state, sr.one);\n    while let Some(s) = finals.dequeue() {\n        let weight = fst.states[s as usize].weight;\n        fst.states[s as usize].final_state = false;\n        fst.add_arc(s, final_state, EPS, EPS, weight);\n    }\n}\npub fn fst_reverse(fst: &mut Fst) {\n    fst.reverse();\n}\npub fn fst_rm_states(fst: &mut Fst, mask: &BitSet) {\n    let n = fst.n_states as usize;\n    let mut idx: Vec<u32> = vec![0; n];\n    let mut shift: u32 = 0;\n    // Compactify states\n    for s in 0..n {\n        if mask.get(s) {\n            shift += 1;\n        } else {\n            idx[s] = shift;\n            // Move state at index `s` to position `s - shift` (no-op if shift=0)\n            if shift > 0 {\n                fst.states.swap(s - shift as usize, s);\n            }\n        }\n    }\n    fst.n_states -= shift;\n    fst.states.truncate(fst.n_states as usize);\n    // Fix arc destinations\n    let n_after = fst.n_states;\n    for s in 0..(n_after as usize) {\n        let state = &mut fst.states[s];\n        let mut new_arcs: Vec<ArcData> = Vec::new();\n        for arc in state.arcs.iter() {\n            let orig_dst = arc.state as usize;\n            if orig_dst < idx.len() {\n                let new_dst = arc.state - idx[orig_dst];\n                if new_dst < n_after {\n                    new_arcs.push(ArcData {\n                        state: new_dst,\n                        weight: arc.weight,\n                        ilabel: arc.ilabel,\n                        olabel: arc.olabel,\n                    });\n                }\n            }\n        }\n        state.n_arcs = new_arcs.len() as u32;\n        state.arcs = new_arcs;\n    }\n}\npub fn fst_get_finals(fst: &mut Fst, finals: &mut Queue<u32>) {\n    for s in 0..fst.n_states {\n        if fst.states[s as usize].final_state {\n            finals.enqueue(s);\n        }\n    }\n}\npub fn fst_trim(fst: &mut Fst) {\n    let mut finals: Queue<u32> = Queue::new();\n    fst_get_finals(fst, &mut finals);\n    if finals.len() == 0 {\n        fst.empty();\n        return;\n    }\n    if finals.len() > 1 {\n        fst_close(fst, &mut finals);\n    }\n    // Forward traversal\n    let mut forward_marked = {\n        let mut iter = FstIter::<u32>::new(fst);\n        while iter.next().is_some() {}\n        iter.marked\n    };\n    // Reverse and traverse from finals\n    fst_reverse(fst);\n    let reverse_marked = {\n        let mut iter = FstIter::<u32>::new(fst);\n        while iter.next().is_some() {}\n        iter.marked\n    };\n    // Reverse back\n    fst_reverse(fst);\n    // Compute mask: states to remove are those NOT in (forward AND reverse)\n    forward_marked.intersect(&reverse_marked);\n    let mask = forward_marked.toggle_all();\n    fst_rm_states(fst, &mask);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2809,"cache_read_input_tokens":101125,"cache_creation":{"ephemeral_5m_input_tokens":2809,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"458e36d7-feb6-4352-8a4e-d92994ee30a0","uuid":"c5cac7cc-6db6-4a89-bedc-98cf32d9aafa"}
