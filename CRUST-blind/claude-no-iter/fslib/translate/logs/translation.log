\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2033,"cache_read_input_tokens":68945,"cache_creation":{"ephemeral_5m_input_tokens":2033,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"458e36d7-feb6-4352-8a4e-d92994ee30a0","uuid":"8f8a6543-ddb3-4f14-9993-837d24ed4fdb"}
