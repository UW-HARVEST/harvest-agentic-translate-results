{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RMRYBqHmv5AduAJKjbHWK5","type":"tool_result","content":"1\t#include <stdlib.h>\n2\t#include <assert.h>\n3\t#include <string.h>\n4\t#include \"queue.h\"\n5\t\n6\t/*\n7\tFIFO queue implementation based on a cyclic unidirected likedlist.\n8\t\n9\t*/\n10\t\n11\tstruct _queue * queue_create(size_t item_size) {\n12\t    struct _queue * q;\n13\t\n14\t    q = (struct _queue *) malloc(sizeof(struct _queue));\n15\t    q->item_size = item_size;\n16\t\n17\t    q->n_items = 0;\n18\t\n19\t    q->head = NULL;\n20\t    q->tail = NULL;\n21\t\n22\t    return q;\n23\t}\n24\t\n25\tvoid queue_enque(struct _queue * q, void * item) {\n26\t    struct _qnode * node;\n27\t\n28\t    assert ( q != NULL);\n29\t\n30\t    node = (struct _qnode *)malloc(sizeof(struct _qnode) - 1 + q->item_size);\n31\t    node->next = NULL;\n32\t\n33\t    memcpy(node->item, item, q->item_size);\n34\t\n35\t    if (q->head == NULL)\n36\t        q->head = q->tail = node;\n37\t    else {\n38\t        q->tail->next = node;  \n39\t        q->tail = node;\n40\t    }\n41\t\n42\t    ++q->n_items;\n43\t}\n44\t\n45\tvoid * queue_deque(struct _queue * q, void * item) {\n46\t    struct _qnode * t_node;\n47\t\n48\t    assert ( q != NULL );\n49\t\n50\t    if (q->head == NULL)\n51\t        return NULL;    // Return NULL in case of empty queue\n52\t    \n53\t    t_node = q->head; \n54\t    memcpy(item, t_node->item, q->item_size);\n55\t\n56\t    q->head = t_node->next;\n57\t    free(t_node);\n58\t\n59\t    --q->n_items;\n60\t\n61\t    return item;\n62\t}    \n63\t\n64\tvoid queue_empty(struct _queue * q) {\n65\t    void * item = malloc(q->item_size);\n66\t\n67\t    while( queue_deque(q, item) != NULL );\n68\t\n69\t    q->n_items = 0;\n70\t    free (item);\n71\t}\n72\t\n73\tvoid queue_remove(struct _queue * q) {\n74\t    queue_empty(q);\n75\t    free (q);\n76\t}\n77\t\n78\t"}]},"parent_tool_use_id":null,"session_id":"458e36d7-feb6-4352-8a4e-d92994ee30a0","uuid":"0c5b0021-86f2-42f0-9973-253f1a39e0c3","timestamp":"2026-06-03T11:04:59.098Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-6Xywia/project/c_src/src/queue.c","content":"#include <stdlib.h>\n#include <assert.h>\n#include <string.h>\n#include \"queue.h\"\n\n/*\nFIFO queue implementation based on a cyclic unidirected likedlist.\n\n*/\n\nstruct _queue * queue_create(size_t item_size) {\n    struct _queue * q;\n\n    q = (struct _queue *) malloc(sizeof(struct _queue));\n    q->item_size = item_size;\n\n    q->n_items = 0;\n\n    q->head = NULL;\n    q->tail = NULL;\n\n    return q;\n}\n\nvoid queue_enque(struct _queue * q, void * item) {\n    struct _qnode * node;\n\n    assert ( q != NULL);\n\n    node = (struct _qnode *)malloc(sizeof(struct _qnode) - 1 + q->item_size);\n    node->next = NULL;\n\n    memcpy(node->item, item, q->item_size);\n\n    if (q->head == NULL)\n        q->head = q->tail = node;\n    else {\n        q->tail->next = node;  \n        q->tail = node;\n    }\n\n    ++q->n_items;\n}\n\nvoid * queue_deque(struct _queue * q, void * item) {\n    struct _qnode * t_node;\n\n    assert ( q != NULL );\n\n    if (q->head == NULL)\n        return NULL;    // Return NULL in case of empty queue\n    \n    t_node = q->head; \n    memcpy(item, t_node->item, q->item_size);\n\n    q->head = t_node->next;\n    free(t_node);\n\n    --q->n_items;\n\n    return item;\n}    \n\nvoid queue_empty(struct _queue * q) {\n    void * item = malloc(q->item_size);\n\n    while( queue_deque(q, item) != NULL );\n\n    q->n_items = 0;\n    free (item);\n}\n\nvoid queue_remove(struct _queue * q) {\n    queue_empty(q);\n    free (q);\n}\n\n","numLines":78,"startLine":1,"totalLines":78}}}
