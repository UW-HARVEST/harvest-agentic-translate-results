            printf(\"Invalid input line %zd: %s\", line, p);\n67\t                    exit(EXIT_FAILURE);\n68\t            }\n69\t        }\n70\t        ++line;\n71\t    } while (tok);\n72\t\n73\t    return st;\n74\t}    \n75\t\n76\tstruct _symt * symt_fread(struct _symt * st, const char * filename) {\n77\t    FILE * fin = NULL;\n78\t    if (( fin = fopen(filename, \"r\")) == NULL ) {\n79\t        fprintf(stderr, \"Error opening file: %s\\n\", filename);\n80\t        exit(EXIT_FAILURE);\n81\t    }\n82\t\n83\t    st = symt_read(st, fin);\n84\t    if (fin != NULL)\n85\t        fclose(fin);\n86\t    return st;\n87\t}   \n88\t\n89\tstruct _symt * symt_create() {\n90\t    struct _symt * st = malloc(sizeof(struct _symt));\n91\t\n92\t    st->rev = NULL;\n93\t    st->sym = malloc(SYM_INIT_SIZE * sizeof(char *));\n94\t\n95\t    st->n_items = 0;\n96\t    st->n_max = SYM_INIT_SIZE;\n97\t\n98\t    for(size_t i=0; i < st->n_max; ++i)\n99\t        st->sym[i] = NULL;\n100\t\n101\t    return st;\n102\t}\n103\t\n104\tvoid symt_remove(struct _symt * st) {\n105\t    for(size_t i=0; i < st->n_max; ++i) \n106\t        if(st->sym[i] != NULL)  \n107\t            free(st->sym[i]);\n108\t\n109\t    if (st->rev != NULL)\n110\t        hash_remove(st->rev);\n111\t\n112\t    free(st->sym);\n113\t    free(st);\n114\t}\n115\t\n116\tchar * symt_add(\n117\t                        struct _symt * st, \n118\t                        size_t id, \n119\t                        const char * token) {\n120\t\n121\t    // Token should be a C-string\n122\t    size_t s = st->n_max;\n123\t    char ** p;\n124\t\n125\t    assert(st->sym != NULL);\n126\t    assert(st->n_max != 0);\n127\t\n128\t    while (st->n_max <= id) {\n129\t        st->n_max *= 2;\n130\t    }\n131\t\n132\t    if( st->n_max > s) {\n133\t        p = realloc(st->sym, st->n_max * sizeof(char *)); \n134\t        st->sym = p;\n135\t    }\n136\t\n137\t    for(size_t i = s; i < st->n_max; ++i)\n138\t        st->sym[i] = NULL;\n139\t\n140\t    char * t