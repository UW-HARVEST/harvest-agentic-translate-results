n\npub fn gca_swapm(a: &mut [u8], b: &mut [u8]) {\n    let len = a.len().min(b.len());\n    a[..len].swap_with_slice(&mut b[..len]);\n}\n\npub fn gca_cycle_left(ptr: &mut [u8], n: usize, es: usize, mut shift: usize) {\n    if n <= 1 || shift == 0 {\n        return; // cannot mod by zero\n    }\n    shift %= n; // shift cannot be greater than n\n\n    // Using GCD\n    let gcd = gca_calc_gcd(n as u32, shift as u32) as usize;\n    let mut tmp = vec![0u8; es];\n\n    // i is initial starting position\n    // Copy from k -> j, stop if k == i, since arr[i] already overwritten\n    for i in 0..gcd {\n        tmp.copy_from_slice(&ptr[i * es..(i + 1) * es]);\n        let mut j = i;\n        loop {\n            let mut k = j + shift;\n            if k >= n {\n                k -= n;\n            }\n            if k == i {\n                break;\n            }\n            ptr.copy_within(k * es..(k + 1) * es, j * es);\n            j = k;\n        }\n        ptr[j * es..(j + 1) * es].copy_from_slice(&tmp);\n    }\n}\n\npub fn gca_cycle_right(ptr: &mut [u8], n: usize, es: usize, mut shift: usize) {\n    if n == 0 || shift == 0 {\n        return; // cannot mod by zero\n    }\n    shift %= n; // shift cannot be greater than n\n    // cycle right by `s` is equivalent to cycle left by `n - s`\n    gca_cycle_left(ptr, n, es, n - shift);\n}\n\npub fn gca_reverse(ptr: &mut [u8], n: usize, es: usize) {\n    if n <= 1 || es == 0 {\n        return;\n    }\n    let mut a: usize = 0;\n    let mut b: usize = es * (n - 1);\n    while a < b {\n        // swap es bytes between [a..a+es] and [b..b+es]\n        for i in 0..es {\n            ptr.swap(a + i, b + i);\n        }\n        a += es;\n        b -= es;\n    }\n}\n\npub fn gca_is_sorted<T, F>(base: &[T], compar: F) -> bool\nwhere\n    F: Fn(&T, &T) -> Ordering,\n{\n    for w in base.windows(2) {\n        if compar(&w[0], &w[1]) == Ordering::Greater {\n            return false;\n        }\n    }\n    true\n}\n\npub fn gca_is_rsorted<T, F>(base: &[T], compar: F) -> bool\nwhere\n    F: Fn(&T, &T) -> Ordering,\n{\n    for w in base.windows(2) {\n        if compar(&w[0], &w[1]) == Ordering::Less {\n            return false;\n        }\n    }\n    true\n}\n\npub fn gca_max<T, F>(base: &[T], compar: F) -> Option<&T>\nwhere\n    F: Fn(&T, &T) -> Ordering,\n{\n    let mut iter = base.iter();\n    let mut max = iter.next()?;\n    for cur in iter {\n        if compar(max, cur) == Ordering::Less {\n            max = cur;\n        }\n    }\n    Some(max)\n}\n\npub fn gca_min<T, F>(base: &[T], compar: F) -> Option<&T>\nwhere\n    F: Fn(&T, &T) -> Ordering,\n{\n    let mut iter = base.iter();\n    let mut min = iter.next()?;\n    for cur in iter {\n        if compar(min, cur) == Ordering::Greater {\n            min = cur;\n        }\n    }\n    Some(min)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2194,"cache_read_input_tokens":49433,"cache_creation":{"ephemeral_5m_input_tokens":2194,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d58b48dc-baf6-43c4-ab20-2ab7d9480ead","uuid":"e6b1dcd3-c054-4b04-9a5c-59afd51ab9ec"}
