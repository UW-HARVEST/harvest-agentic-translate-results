es_to_move = vector_elements_until_end(vector, index) * vector->esize;\n288\t    memcpy(vector_at(vector, eindex), vector_at(vector, index), bytes_to_move);\n289\t    memset(vector_at(vector, index), 0x00, amount * vector->esize);\n290\t}\n291\t\n292\tvoid vector_shift_right_in_bounds(struct vector *vector, int index, int amount)\n293\t{\n294\t    vector_shift_right_in_bounds_no_increment(vector, index, amount);\n295\t    vector->rindex += amount;\n296\t    vector->count += amount;\n297\t}\n298\t\n299\tvoid vector_stretch(struct vector *vector, int index)\n300\t{\n301\t    if (index < vector->rindex)\n302\t        return;\n303\t\n304\t    vector_resize_for_index(vector, index, 0);\n305\t    vector->count = index;\n306\t    vector->rindex = index;\n307\t}\n308\t\n309\tint vector_pop_value(struct vector* vector, void* val)\n310\t{\n311\t    int old_pp = vector->pindex;\n312\t    vector_set_peek_pointer(vector, 0);\n313\t    void* ptr = vector_peek_ptr(vector);\n314\t    int index = 0;\n315\t    while(ptr)\n316\t    {\n317\t        if (ptr == val)\n318\t        {\n319\t            vector_pop_at(vector, index);\n320\t            break;\n321\t        }\n322\t        ptr = vector_peek_ptr(vector);\n323\t        index++;\n324\t    }\n325\t\n326\t    vector_set_peek_pointer(vector, old_pp);\n327\t}\n328\t\n329\tint vector_pop_at_data_address(struct vector *vector, void *address)\n330\t{\n331\t    int index = (address - vector->data) / vector->esize;\n332\t    vector_pop_at(vector, index);\n333\t    return index;\n334\t}\n335\t\n336\tvoid vector_shift_right(struct vector *vector, int index, int amount)\n337\t{\n338\t    if (index < vector->rindex)\n339\t    {\n340\t        vector_shift_right_in_bounds(vector, index, amount);\n341\t        return;\n342\t    }\n343\t\n344\t    // We don't need to shift anything because we are out of bounds\n345\t    // lets stretch the vector up to index+amount\n346\t    vector_stretch(vector, index + amount);\n347\t    vector_shift_right_in_b