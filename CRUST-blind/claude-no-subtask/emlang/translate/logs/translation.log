lf.size {\n            return -1;\n        }\n        let a = self.size - off - 1;\n        let b = self.size - 1;\n        self.buf.swap(a, b);\n        0\n    }\n    pub fn shrink_to(&mut self, size: usize) {\n        if size == self.size {\n            return;\n        }\n        assert!(size < self.size);\n        for i in size..self.size {\n            if let data::DataValue::Str(s) = &self.buf[i].value {\n                let s_clone = s.clone();\n                self.add_popped(s_clone);\n            }\n        }\n        self.size = size;\n    }\n    pub fn clear(&mut self) {\n        self.shrink_to(0);\n        self.gc();\n    }\n    pub fn gc(&mut self) {\n        if self.popped_size == 0 {\n            return;\n        }\n        // In Rust, since we use String (heap-allocated and owned), GC doesn't\n        // need to free anything explicitly. But we still need to clear the\n        // popped buffer to match the C semantics.\n        self.popped.clear();\n        self.popped_size = 0;\n    }\n    fn add_popped(&mut self, s: String) {\n        if self.popped_size >= self.popped_cap {\n            self.popped_cap *= 2;\n        }\n        self.popped.push(Popped {\n            str: s,\n            marked: false,\n        });\n        self.popped_size += 1;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2707,"cache_read_input_tokens":42726,"cache_creation":{"ephemeral_5m_input_tokens":2707,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6e699b83-b969-440a-8f3d-feab4b89afb2","uuid":"dfb6889a-d0d0-4971-9e68-6a49ad240e5d"}
