r (GCD) of two numbers along with the coefficients (a and b) such that\n62\t * gcd = ax + by.\n63\t *\n64\t * @param a The first number.\n65\t * @param b The second number.\n66\t *\n67\t * @return The extended greatest common divisor (xgcd) result.\n68\t */\n69\tXgcd xgcd(uint64_t a, uint64_t b);\n70\t\n71\t/**\n72\t * @brief Check if two numbers are coprime.\n73\t *\n74\t * This function checks if two unsigned 64-bit integers are coprime,\n75\t * meaning their greatest common divisor (GCD) is equal to 1.\n76\t *\n77\t * @param x The first number.\n78\t * @param y The second number.\n79\t *\n80\t * @return 1 if the numbers are coprime, 0 otherwise.\n81\t */\n82\tint are_coprime(uint64_t x, uint64_t y);\n83\t\n84\t/**\n85\t * @brief Generate a random pair of inverses.\n86\t *\n87\t * This function generates a random pair of inverses for a given value.\n88\t * It selects a random number 'a' within the range [2, value - 1], ensuring\n89\t * that 'a' is coprime with the given value. Then, it computes the modular\n90\t * inverse of 'a' with respect to the given value and returns a pair consisting\n91\t * of 'a' and its modular inverse.\n92\t *\n93\t * @param value The value for which inverses are generated.\n94\t *\n95\t * @return A pair containing 'a' and its modular inverse.\n96\t */\n97\tPair randinverse(uint64_t value);\n98\t\n99\t/**\n100\t * @brief Generate a random number within a specified range.\n101\t *\n102\t * This function generates a random unsigned 64-bit integer within the specified\n103\t * range [lower, upper].\n104\t *\n105\t * @param lower The lower bound of the range.\n106\t * @param upper The upper bound of the range.\n107\t *\n108\t * @return A random number within the specified range.\n109\t */\n110\tuint64_t randrange(uint64_t lower, uint64_t upper);\n111\t\n112\t/**\n113\t * @brief Generate a random number from a normal distribution.\n114\t *\n115\t * This function generates a random number from a normal distribution\n116\t * with the specified mean and standard deviation.\n117\t *\n118\t * @param mean The mean (average) of the normal distribution.\n119\t * @param stddev The standard deviation of the normal distribution.\n120\t *\n121\t * @return A random number from the normal distribution.\n122\t */\n123\tdouble normal_rand(double mean, double stddev);\n124\t\n125\tstatic inline uint64_t max(uint64_t a, uint64_t b) { return a > b ? a : b; }\n126\t\n127\tstatic inline uint64_t min(uint64_t a, uint64_t b) { return a < b ? a : b; }\n128\t\n129\t/**\n130\t * @brief Clamp a value within a specified range.\n131\t *\n132\t * This function clamps a value within a specified range defined by the minimum\n133\t * and maximum values. If the given value is less than the minimum value, it\n134\t * returns the minimum value. If the given value is greater than the maximum\n135\t * value, it returns the maximum value. Otherwise, it returns the given value.\n136\t *\n137\t * @param min_value The minimum value of the range.\n138\t * @param max_value The maximum value of the range.\n139\t * @param value The value to clamp.\n140\t *\n141\t * @return The clamped value within the specified range.\n142\t */\n143\tstatic inline uint64_t clamp(uint64_t min_value, uint64_t max_value,\n144\t                             uint64_t value) {\n145\t  return max(min_value, min(max_value, value));\n146\t}\n147\t\n148\t#ifdef __cplusplus\n149\t}\n150\t#endif\n151\t\n152\t#endif\n153\t"}]},"parent_tool_use_id":null,"session_id":"69139358-3306-4859-9265-775e9f9b2c66","uuid":"b26b455e-c4ee-4d21-bc39-05942b580e9e","timestamp":"2026-06-06T04:08:10.361Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-629Wre/project/c_src/src/include/Common.h","content":"#ifndef COMMON_H\n#define COMMON_H\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n#include <stddef.h>\n#include <stdint.h>\n\n#define MAYBE_UNUSED __attribute__((unused))\n\n/**\n * @brief Extended Euclidean Algorithm result.\n *\n * This structure represents the result of the Extended Euclidean Algorithm,\n * which computes the greatest common divisor (GCD) of two numbers along with\n * the coefficients (a and b) such that gcd = ax + by.\n *\n * @param gcd The greatest common divisor of the two numbers.\n * @param a The coefficient of the first number in the equation.\n * @param b The coefficient of the second number in the equation.\n */\ntypedef struct {\n  uint64_t gcd;\n  int64_t a;\n  int64_t b;\n} Xgcd;\n\n/**\n * @brief Represents a pair of unsigned 64-bit integers.\n *\n * This structure encapsulates a pair of unsigned 64-bit integers.\n *\n * @param first The first value in the pair.\n * @param second The second value in the pair.\n */\ntypedef struct {\n  uint64_t first;\n  uint64_t second;\n} Pair;\n\n/**\n * @brief Compute the greatest common divisor (GCD) of two numbers.\n *\n * This function computes the greatest common divisor (GCD) of two unsigned\n * 64-bit integers.\n *\n * @param x The first number.\n * @param y The second number.\n *\n * @return The greatest common divisor of x and y.\n */\nuint64_t gcd(uint64_t x, uint64_t y);\n\n/**\n * @brief Compute the extended greatest common divisor (xgcd) of two numbers.\n *\n * This function computes the extended greatest common divisor (xgcd) of two\n * unsigned 64-bit integers. The xgcd algorithm computes the greatest common\n * divisor (GCD) of two numbers along with the coefficients (a and b) such that\n * gcd = ax + by.\n *\n * @param a The first number.\n * @param b The second number.\n *\n * @return The extended greatest common divisor (xgcd) result.\n */\nXgcd xgcd(uint64_t a, uint64_t b);\n\n/**\n * @brief Check if two numbers are coprime.\n *\n * This function checks if two unsigned 64-bit integers are coprime,\n * meaning their greatest common divisor (GCD) is equal to 1.\n *\n * @param x The first number.\n * @param y The second number.\n *\n * @return 1 if the numbers are coprime, 0 otherwise.\n */\nint are_coprime(uint64_t x, uint64_t y);\