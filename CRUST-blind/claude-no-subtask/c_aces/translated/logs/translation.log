n73\t  return 0;\n74\t}\n75\t\n76\tint poly_mul(const Polynomial *poly1, const Polynomial *poly2,\n77\t             Polynomial *result, uint64_t mod) {\n78\t  set_zero(result);\n79\t  uint64_t deg1 = poly1->size - 1;\n80\t  uint64_t deg2 = poly2->size - 1;\n81\t  uint64_t res_deg = result->size - deg2 - deg1 - 1;\n82\t\n83\t  for (size_t i = 0; i < poly1->size; i++) {\n84\t    for (size_t j = 0; j < poly2->size; j++) {\n85\t      result->coeffs[res_deg + i + j] +=\n86\t          (poly1->coeffs[i] * poly2->coeffs[j]) % mod;\n87\t    }\n88\t  }\n89\t\n90\t  poly_fit(result, mod);\n91\t  return 0;\n92\t}\n93\t\n94\tint poly_equal(const Polynomial *poly1, const Polynomial *poly2) {\n95\t  if (poly1->size != poly2->size)\n96\t    return 0;\n97\t\n98\t  return 0 == memcmp(poly1->coeffs, poly2->coeffs, poly1->size * sizeof(Coeff));\n99\t}\n100\t\n101\tint poly_add(const Polynomial *poly1, const Polynomial *poly2,\n102\t             Polynomial *result, uint64_t mod) {\n103\t  if (poly1->size > result->size || poly2->size > result->size || mod == 0)\n104\t    return -1;\n105\t\n106\t  if (poly1->size != poly2->size) {\n107\t    size_t size = result->size;\n108\t    size_t diff1 = size - poly1->size;\n109\t    size_t diff2 = size - poly2->size;\n110\t\n111\t    for (size_t i = 0; i < size; ++i) {\n112\t      result->coeffs[i] = ((i >= diff1 ? poly1->coeffs[i - diff1] : 0) +\n113\t                           (i >= diff2 ? poly2->coeffs[i - diff2] : 0)) %\n114\t                          mod;\n115\t    }\n116\t    return 0;\n117\t  }\n118\t\n119\t  for (size_t i = 0; i < poly1->size; ++i)\n120\t    result->coeffs[i] = (poly1->coeffs[i] + poly2->coeffs[i]) % mod;\n121\t  return 0;\n122\t}\n123\t\n124\tint poly_sub(const Polynomial *poly1, const Polynomial *poly2,\n125\t             Polynomial *result, uint64_t mod) {\n126\t  if (poly1->size > result->size || poly2->size > result->size || mod == 0)\n127\t    return -1;\n128\t\n129\t  if (poly1->size != poly2->size) {\n130\t    size