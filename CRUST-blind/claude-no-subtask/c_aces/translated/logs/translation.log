mial.\n166\t * @param result Pointer to the polynomial structure to store the result.\n167\t * @param mod The modulus to apply to each coefficient.\n168\t *\n169\t * @return 0 if successful, -1 if an error occurred.\n170\t */\n171\tint poly_add(const Polynomial *poly1, const Polynomial *poly2,\n172\t             Polynomial *result, uint64_t mod);\n173\t\n174\t/**\n175\t * @brief Subtract one polynomial from another and store the result.\n176\t *\n177\t * This function subtracts the second polynomial from the first polynomial and\n178\t * stores the result in the provided result polynomial, applying the specified\n179\t * modulus to each coefficient.\n180\t *\n181\t * @param poly1 Pointer to the first polynomial.\n182\t * @param poly2 Pointer to the second polynomial.\n183\t * @param result Pointer to the polynomial structure to store the result.\n184\t * @param mod The modulus to apply to each coefficient.\n185\t *\n186\t * @return 0 if successful, -1 if an error occurred.\n187\t */\n188\tint poly_sub(const Polynomial *poly1, const Polynomial *poly2,\n189\t             Polynomial *result, uint64_t mod);\n190\t\n191\t/**\n192\t * @brief Left shift one polynomial by another and store the result.\n193\t *\n194\t * This function left shifts the first polynomial by the second polynomial and\n195\t * stores the result in the provided result polynomial, applying the specified\n196\t * modulus to each coefficient.\n197\t *\n198\t * @param poly1 Pointer to the first polynomial.\n199\t * @param poly2 Pointer to the second polynomial.\n200\t * @param result Pointer to the polynomial structure to store the result.\n201\t * @param mod The modulus to apply to each coefficient.\n202\t *\n203\t * @return 0 if successful, -1 if an error occurred.\n204\t */\n205\tint poly_lshift(const Polynomial *poly1, const Polynomial *poly2,\n206\t                Polynomial *result, uint64_t mod);\n207\t\n208\t/**\n209\t * @brief Compute the modulus of a polynomial.\n210\t *\n211\t * This function