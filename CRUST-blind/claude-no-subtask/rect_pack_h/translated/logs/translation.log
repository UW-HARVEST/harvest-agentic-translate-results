{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_xzvdrmaavhfmptcwo7r3yskn65srtnlfrqu6xfafovfsk4woax6q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01KZnb6Aomh8hMToWzdsgnL5","name":"Bash","input":{"command":"cat > /tmp/test_rect.rs << 'EOF'\nuse rect_pack_h::rect_pack::*;\n\nfn main() {\n    // test_rect_pack_uniform_paging\n    let mut rects: Vec<Rect> = (0..100).map(|i| Rect::new(i, i + 1, i + 1)).collect();\n    assert!(RectPacker::pack(512, 512, true, &mut rects));\n    println!(\"test_rect_pack_uniform_paging passed\");\n\n    // test_rect_pack_one_rect_per_page_paging\n    let mut rects = vec![\n        Rect::new(0, 6, 7),\n        Rect::new(1, 8, 7),\n        Rect::new(2, 8, 9),\n        Rect::new(3, 10, 9),\n    ];\n    assert!(RectPacker::pack(10, 10, true, &mut rects));\n    for (i, r) in rects.iter().enumerate() {\n        assert!(r.info.packed);\n        assert_eq!(r.info.page, i as i32);\n    }\n    println!(\"test_rect_pack_one_rect_per_page_paging passed\");\n\n    // test_rect_pack_fill\n    let mut rects: Vec<Rect> = (0..100).map(|i| Rect::new(i, 1, 1)).collect();\n    assert!(RectPacker::pack(10, 10, false, &mut rects));\n    for r in &rects {\n        assert!(r.info.packed);\n        assert_eq!(r.info.page, 0);\n    }\n    println!(\"test_rect_pack_fill passed\");\n\n    // test_rect_pack_no_paging\n    let mut rects = vec![\n        Rect::new(0, 6, 7),\n        Rect::new(1, 8, 7),\n        Rect::new(2, 8, 9),\n        Rect::new(3, 10, 9),\n    ];\n    assert!(!RectPacker::pack(10, 10, false, &mut rects));\n    // After sort they should be: largest first. The sorted order is\n    // {10,9}, {8,9}, {8,7}, {6,7}, with the {10,9} packed first.\n    // The first one should be packed; others not.\n    assert!(rects[0].info.packed);\n    assert!(!rects[1].info.packed);\n    assert!(!rects[2].info.packed);\n    assert!(!rects[3].info.packed);\n    println!(\"test_rect_pack_no_paging passed\");\n\n    // test_rect_pack_fail_paging\n    let mut rects = vec![Rect::new(0, 900, 900), Rect::new(1, 1100, 1100)];\n    assert!(!RectPacker::pack(1000, 1000, true, &mut rects));\n    // After sorting: {1100,1100} first, {900,900} second.\n    // Find by id.\n    let r0 = rects.iter().find(|r| r.id == 0).unwrap();\n    let r1 = rects.iter().find(|r| r.id == 1).unwrap();\n    assert!(!r0.info.packed);\n    assert!(r1.info.packed);\n    println!(\"test_rect_pack_fail_paging passed\");\n\n    println!(\"All tests passed!\");\n}\nEOF\ncp /tmp/test_rect.rs /tmp/claude-31062124/harvest-crust-b54kOT/project/examples/test_rect.rs 2>/dev/null || mkdir -p /tmp/claude-31062124/harvest-crust-b54kOT/project/examples && cp /tmp/test_rect.rs /tmp/claude-31062124/harvest-crust-b54kOT/project/examples/test_rect.rs\nls /tmp/claude-31062124/harvest-crust-b54kOT/project/examples/","description":"Create a test program"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":759,"cache_read_input_tokens":33772,"cache_creation":{"ephemeral_5m_input_tokens":759,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cf10908e-1407-43c1-b437-a2f45bd28d17","uuid":"ecd55e24-b336-4b2f-9806-8f14a6942adf"}
