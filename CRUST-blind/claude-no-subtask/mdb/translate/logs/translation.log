ests++; \\\n56\t      __g_passing_tests_section++; \\\n57\t    } \\\n58\t    else { \\\n59\t      fprintf(stderr, \"Failing\\n\"); \\\n60\t      __vk_maybe_terminate(); \\\n61\t    } \\\n62\t  }\n63\t\n64\t#define VK_ASSERT_NOT(condition) \\\n65\t  { \\\n66\t    __g_all_tests++; \\\n67\t    __g_all_tests_section++; \\\n68\t    fprintf(stderr, \"[%u] Testing AssertNot(%s)... \", __g_all_tests_section, \\\n69\t            #condition); \\\n70\t    if (!condition) { \\\n71\t      fprintf(stderr, \"Passing\\n\"); \\\n72\t      __g_passing_tests++; \\\n73\t      __g_passing_tests_section++; \\\n74\t    } \\\n75\t    else { \\\n76\t      fprintf(stderr, \"Failing\\n\"); \\\n77\t      __vk_maybe_terminate(); \\\n78\t    } \\\n79\t  }\n80\t\n81\t#define VK_ASSERT_EQUALS(standard, expr) \\\n82\t  { \\\n83\t    __g_all_tests++; \\\n84\t    __g_all_tests_section++; \\\n85\t    fprintf(stderr, \"[%u] Testing AssertEquals(%s, %s)... \", \\\n86\t            __g_all_tests_section, \\\n87\t            #standard, #expr); \\\n88\t    if ((standard) == (expr)) { \\\n89\t      fprintf(stderr, \"Passing\\n\"); \\\n90\t      __g_passing_tests++; \\\n91\t      __g_passing_tests_section++; \\\n92\t    } \\\n93\t    else { \\\n94\t      fprintf(stderr, \"Failing\\n\"); \\\n95\t      __vk_maybe_terminate(); \\\n96\t    } \\\n97\t  }\n98\t\n99\t#define VK_ASSERT_EQUALS_S(standard, expr) \\\n100\t  { \\\n101\t    __g_all_tests++; \\\n102\t    __g_all_tests_section++; \\\n103\t    fprintf(stderr, \"[%u] Testing AssertEquals(\\\"%s\\\", \\\"%s\\\")... \",\\\n104\t            __g_all_tests_section, \\\n105\t            standard, expr); \\\n106\t    if (!strcmp(standard, expr)) { \\\n107\t      fprintf(stderr, \"Passing\\n\"); \\\n108\t      __g_passing_tests++; \\\n109\t      __g_passing_tests_section++; \\\n110\t    } \\\n111\t    else { \\\n112\t      fprintf(stderr, \"Failing\\n\"); \\\n113\t      __vk_maybe_terminate(); \\\n114\t    } \\\n115\t  }\n116\t\n117\t#define VK_EPSILON 1e-5\n118\t\n1