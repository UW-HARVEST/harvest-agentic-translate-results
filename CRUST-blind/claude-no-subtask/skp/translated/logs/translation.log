    assert!(alt == 2 && len == 4);\n\n    let (alt, to, _) = skp_(from, \"'1' . . a\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 2 && len == 4);\n}\n\n#[test]\nfn test2_unicode_and_options() {\n    let from = \"A&B\";\n    let (alt, to, _) = skp_(&from[1..], \"&\\x03\");\n    let len = from[1..].len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"A&&B\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let from = \"abCD\";\n    let (alt, to, _) = skp_(from, \"'abCD'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 4);\n\n    let (alt, to, _) = skp_(from, \"'abcd'\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"!C'abcd'\");\n    let len = from.len() - to.len();\n    println!(\"test2-5: alt={} len={} (want alt=1 len=4)\", alt, len);\n    assert!(alt == 1 && len == 4);\n\n    let from = \"aèi\";\n    let (alt, to, _) = skp_(from, \"'a' . 'i'\");\n    let len = from.len() - to.len();\n    println!(\"test2-6: alt={} len={} (want alt=1 len=4)\", alt, len);\n    assert!(alt == 1 && len == 4);\n\n    let (alt, to, _) = skp_(from, \". [èì] .\");\n    let len = from.len() - to.len();\n    println!(\"test2-7: alt={} len={} (want alt=1 len=4)\", alt, len);\n    assert!(alt == 1 && len == 4);\n\n    let (alt, to, _) = skp_(from, \"'aè'\\x02 .\");\n    let len = from.len() - to.len();\n    println!(\"test2-8: alt={} len={} (want alt=2 len=3)\", alt, len);\n    assert!(alt == 2 && len == 3);\n\n    let (alt, to, end) = skp_(from, \"> 'è'\");\n    let len = to.len() - end.len();\n    println!(\"test2-9: alt={} len={} (want alt=1 len=2)\", alt, len);\n    assert!(alt == 1 && len == 2);\n}\n\n#[test]\nfn test3_alternatives() {\n    let from = \"ABC\";\n    let (alt, to, _) = skp_(from, \"'AB'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 2);\n\n    let (alt, to, _) = skp_(from, \"'XB'\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"'XB\\x0EAB'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 2);\n\n    let (alt, to, _) = skp_(from, \"'AB\\x0EXB'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 2);\n\n    let from = \"12cm\";\n    let (alt, to, _) = skp_(from, \"D @ 'cm\\x0Emm\\x0Ept'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 2);\n\n    let from = \"12mm\";\n    let (alt, to, _) = skp_(from, \"D @ 'cm\\x0Emm\\x0Ept'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 2);\n\n    let from = \"12XX\";\n    let (alt, to, _) = skp_(from, \"D @ 'cm\\x0Emm\\x0Ept'\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let from = \"12ptcm\";\n    let (alt, to, _) = skp_(from, \"D @ 'cm\\x0Emm\\x0Ept'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 2);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":944,"cache_read_input_tokens":96047,"cache_creation":{"ephemeral_5m_input_tokens":944,"ephemeral_1h_input_tokens":0},"output_tokens":30,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"87b1dae6-2a38-4215-9d2a-3b42dcc9c7e7","uuid":"be9c076c-8256-4d9e-b5d0-eaa4abc85ea0"}
