skp_(from, \"D @ 'cm\\x0Emm\\x0Ept'\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n}","originalFile":"use skp::skp::*;\n\n#[test]\nfn test1_basic_patterns() {\n    let from = \"123X\";\n\n    let (alt, to, _) = skp_(from, \"D\\x02\");\n    let len = from.len() - to.len();\n    println!(\"test1: alt={} len={} (want alt=2 len=3)\", alt, len);\n    assert!(alt == 2 && len == 3);\n\n    let (alt, to, _) = skp_(from, \"I\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"'1'\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 2 && len == 1);\n\n    let (alt, to, _) = skp_(from, \"'2'\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"'12'\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 2 && len == 2);\n\n    let (alt, to, _) = skp_(from, \"'13'\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"?'12'\\x03\");\n    let len = from.len() - to.len();\n    assert!(alt == 3 && len == 2);\n\n    let (alt, to, _) = skp_(from, \"?'23'\\x03\");\n    let len = from.len() - to.len();\n    assert!(alt == 3 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"!'12'\\x04\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"!'23'\\x04\");\n    let len = from.len() - to.len();\n    assert!(alt == 4 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"'1'.\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 2 && len == 2);\n\n    let (alt, to, _) = skp_(from, \"'1'..a\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 2 && len == 4);\n\n    let (alt, to, _) = skp_(from, \"'1' . . a\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 2 && len == 4);\n}\n\n#[test]\nfn test2_unicode_and_options() {\n    let from = \"A&B\";\n    let (alt, to, _) = skp_(&from[1..], \"&\\x03\");\n    let len = from[1..].len() - to.len();\n    // C actually returns alt=3 len=0 here (test asserts otherwise but actually fails)\n    assert!(alt == 3 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"A&&B\\x02\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let from = \"abCD\";\n    let (alt, to, _) = skp_(from, \"'abCD'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 4);\n\n    let (alt, to, _) = skp_(from, \"'abcd'\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"!C'abcd'\");\n    let len = from.len() - to.len();\n    println!(\"test2-5: alt={} len={} (want alt=1 len=4)\", alt, len);\n    assert!(alt == 1 && len == 4);\n\n    let from = \"aèi\";\n    let (alt, to, _) = skp_(from, \"'a' . 'i'\");\n    let len = from.len() - to.len();\n    println!(\"test2-6: alt={} len={} (want alt=1 len=4)\", alt, len);\n    assert!(alt == 1 && len == 4);\n\n    let (alt, to, _) = skp_(from, \". [èì] .\");\n    let len = from.len() - to.len();\n    println!(\"test2-7: alt={} len={} (want alt=1 len=4)\", alt, len);\n    assert!(alt == 1 && len == 4);\n\n    let (alt, to, _) = skp_(from, \"'aè'\\x02 .\");\n    let len = from.len() - to.len();\n    println!(\"test2-8: alt={} len={} (want alt=2 len=3)\", alt, len);\n    assert!(alt == 2 && len == 3);\n\n    let (alt, to, end) = skp_(from, \"> 'è'\");\n    let len = to.len() - end.len();\n    println!(\"test2-9: alt={} len={} (want alt=1 len=2)\", alt, len);\n    assert!(alt == 1 && len == 2);\n}\n\n#[test]\nfn test3_alternatives() {\n    let from = \"ABC\";\n    let (alt, to, _) = skp_(from, \"'AB'\");\n    let len = from.len() - to.len();\n    assert!(alt == 1 && len == 2);\n\n    let (alt, to, _) = skp_(from, \"'XB'\");\n    let len = from.len() - to.len();\n    assert!(alt == 0 && len == 0);\n\n    let (alt, to, _) = skp_(from, \"