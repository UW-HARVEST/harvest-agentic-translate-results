ze;\n54\t} string_t;\n55\t\n56\t#ifndef STRING_T_ARRAY\n57\t#define STRING_T_ARRAY string_t **\n58\t#endif\n59\t#ifndef STRING_T_SPACE_CHARS_ARR\n60\t#define STRING_T_SPACE_CHARS_ARR \" \\t\\n\\r\"\n61\t#endif\n62\t\n63\tconst char STRING_T_SPACE_CHARS[] = STRING_T_SPACE_CHARS_ARR;\n64\t\n65\t/* Allocate new string by given size. */\n66\tstring_t *new_string(size_t);\n67\t\n68\t/* Allocate new string by given bytes. */\n69\tstring_t *new_string_from_bytes(const char *);\n70\t\n71\t/* Free string's allocated memory. */\n72\tvoid string_free(string_t *);\n73\t\n74\t/* Return string length. */\n75\tsize_t string_len(const string_t *);\n76\t\n77\t/* Return string bytes. */\n78\tchar *string_bytes(const string_t *);\n79\t\n80\t/* Return true(0) if strings are equal. */\n81\tbool_t string_eq(const string_t *, const string_t *);\n82\t\n83\t/* Return copy of the string. */\n84\tstring_t *string_copy(const string_t *);\n85\t\n86\t/* Return result of 2 strings concatenation. */\n87\tstring_t *string_concat(const string_t *, const string_t *);\n88\t\n89\t/* Return string's sub string. */\n90\tstring_t *string_substr(const string_t *, size_t, size_t);\n91\t\n92\t/* Return true(0) if string starts with given prefix. */\n93\tbool_t string_startswith(const string_t *, const char[]);\n94\t\n95\t/* Return true(0) if string ends with given suffix. */\n96\tbool_t string_endswith(const string_t *, const char[]);\n97\t\n98\t/* Returns the index of substring's occurrence in string. Otherwise returns -1. */\n99\tint string_find(const string_t *, const char[]);\n100\t\n101\t/* Return string without STRING_T_SPACE_CHARS_ARR at the start and end. */\n102\tstring_t *string_strip(const string_t *);\n103\t\n104\t#ifndef _WIN32\n105\t/* Split string by STRING_T_SPACE_CHARS_ARR symbols and return strings array. */\n106\tSTRING_T_ARRAY string_split(const string_t *, size_t *);\n107\t\n108\t/* Split string by given chars and return strings array. */\n109\tSTRING_T_ARRAY string_split_by(const string_t *, size_t *, const char[]);\n110\t\n111\t#endif\n112\t/* Join given strings array with separator chars into one string. */\n113\tstring_t *string_join_arr(const STRING_T_ARRAY, size_t, const char []);\n114\t\n115\tstring_t *new_string(size_t size) {\n116\t    string_t *str = malloc(sizeof(string_t));\n117\t    str->size = size;\n118\t    str->bytes = calloc(size, sizeof(char));\n119\t    return str;\n120\t}\n121\t\n122\tstring_t *new_string_from_bytes(const char *bytes) {\n123\t    string_t *str = new_string(strlen(bytes));\n124\t    strcpy(str->bytes, bytes);\n125\t    return str;\n126\t}\n127\t\n128\tvoid string_free(string_t *str) {\n129\t    free(str->bytes);\n130\t    free(str);\n131\t}\n132\t\n133\tsize_t string_len(const string_t *str) {\n134\t    return str->size;\n135\t}\n136\t\n137\tchar *string_bytes(const string_t *str) {\n138\t    char *buf = calloc(sizeof(char), str->size);\n139\t    strcpy(buf, str->bytes);\n140\t    return buf;\n141\t}\n142\t\n143\tbool_t string_eq(const string_t *left, const string_t *right) {\n144\t    if (left->size != right->size || strcmp(left->bytes, right->bytes) != 0) {\n145\t        return false;\n146\t    }\n147\t    return true;\n148\t}\n149\t\n150\tstring_t *string_copy(const string_t *str) {\n151\t    string_t *copied_str = new_string(str->size);\n152\t    strcpy(copied_str->bytes, str->bytes);\n153\t    return copied_str;\n154\t}\n155\t\n156\tstring_t *string_concat(const string_t *first, const string_t *second) {\n157\t    string_t *new_str = new_string(first->size + second->size);\n158\t    strcpy(new_str->bytes, strcat(first->bytes, second->bytes));\n159\t    return new_str;\n160\t}\n161\t\n162\tint string_t_is_space_char(char byte) {\n163\t    for (size_t idx = 0; idx < strlen(STRING_T_SPACE_CHARS); ++idx) {\n164\t        if (STRING_T_SPACE_CHARS[idx] == byte) {\n165\t            return 1;\n166\t        }\n167\t    }\n168\t    return 0;\n169\t}\n170\t\n171\tstring_t *string_substr(const string_t *str, size_t pos,