s = 0;\n230\t    for (; start_pos < str->size && string_t_is_space_char(str->bytes[start_pos]); ++start_pos);\n231\t    int end_pos = (int) str->size - 1;\n232\t    for (; end_pos >= 0 && string_t_is_space_char(str->bytes[end_pos]); --end_pos);\n233\t\n234\t    if ((int)start_pos >= end_pos) {\n235\t        return string_copy(str);\n236\t    }\n237\t    return string_substr(str, start_pos, end_pos - start_pos + 1);\n238\t}\n239\t\n240\t#ifndef _WIN32\n241\t\n242\tSTRING_T_ARRAY string_split(const string_t *str, size_t *arr_size) {\n243\t    size_t str_count = 0;\n244\t    size_t indexes[STRING_T_INDEXES_BUFFER_SIZE];\n245\t\n246\t    if (str->size == 0) {\n247\t        str_count = 1;\n248\t        STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n249\t        str_arr[0] = string_copy(str);\n250\t        if (arr_size) {\n251\t            *arr_size = str_count;\n252\t        }\n253\t        return str_arr;\n254\t    }\n255\t\n256\t    size_t start_pos = 0;\n257\t    size_t pos = 0;\n258\t    for (; pos < str->size;) {\n259\t        if (string_t_is_space_char(str->bytes[pos])) {\n260\t\n261\t            indexes[str_count * 2] = start_pos;\n262\t            indexes[str_count * 2 + 1] = pos;\n263\t\n264\t            for (; string_t_is_space_char(str->bytes[pos]); pos++);\n265\t\n266\t            start_pos = pos;\n267\t            ++str_count;\n268\t        } else {\n269\t            ++pos;\n270\t        }\n271\t    }\n272\t    if (pos != start_pos) {\n273\t        indexes[str_count * 2] = start_pos;\n274\t        indexes[str_count * 2 + 1] = pos;\n275\t        ++str_count;\n276\t    }\n277\t\n278\t    STRING_T_ARRAY str_arr = calloc(str_count, sizeof(string_t));\n279\t    for (size_t idx = 0; idx < str_count; ++idx) {\n280\t        size_t sub_str_start_pos = indexes[idx * 2];\n281\t        size_t sub_str_end_pos = indexes[idx * 2 + 1];\n282\t\n283\t        str_arr[idx] = string_substr(str, sub_str_start_pos, sub_str_end_pos - sub_str_start_pos);\n284\t    }\