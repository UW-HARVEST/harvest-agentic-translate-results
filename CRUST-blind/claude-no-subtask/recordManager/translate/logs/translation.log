 2021\n174\t\t\tint pos = rand() % numInserts;\n175\t\t\tRID rid = rids[pos];\n176\t\t\tTEST_CHECK(getRecord(table, rid, r));\n177\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, inserts[pos]), r, schema, \"compare records\");\n178\t        freeRecord (r);  // Added: Summer 2021\n179\t\t}\n180\t\n181\t\tTEST_CHECK(closeTable(table));\n182\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n183\t\tTEST_CHECK(shutdownRecordManager());\n184\t\n185\t\tfree(rids);\n186\t\tfree(table);\n187\t    freeSchema(schema);   // Added: Summer 2021\n188\t\tTEST_DONE();\n189\t}\n190\t\n191\tvoid\n192\ttestMultipleScans(void)\n193\t{\n194\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n195\t\tTestRecord inserts[] = {\n196\t\t\t\t{1, \"aaaa\", 3},\n197\t\t\t\t{2, \"bbbb\", 2},\n198\t\t\t\t{3, \"cccc\", 1},\n199\t\t\t\t{4, \"dddd\", 3},\n200\t\t\t\t{5, \"eeee\", 5},\n201\t\t\t\t{6, \"ffff\", 1},\n202\t\t\t\t{7, \"gggg\", 3},\n203\t\t\t\t{8, \"hhhh\", 3},\n204\t\t\t\t{9, \"iiii\", 2},\n205\t\t\t\t{10, \"jjjj\", 5},\n206\t\t};\n207\t\tint numInserts = 10, i, scanOne=0, scanTwo=0;\n208\t\tRecord *r;\n209\t\tRID *rids;\n210\t\tSchema *schema;\n211\t\ttestName = \"test running muliple scans \";\n212\t\tschema = testSchema();\n213\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n214\t\tRM_ScanHandle *sc1 = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n215\t\tRM_ScanHandle *sc2 = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n216\t\tExpr *se1, *left, *right;\n217\t\tint rc,rc2;\n218\t\n219\t\tTEST_CHECK(initRecordManager(NULL));\n220\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n221\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n222\t\n223\t\t// insert rows into table\n224\t\tfor(i = 0; i < numInserts; i++)\n225\t\t{\n226\t\t\tr = fromTestRecord(schema, inserts[i]);\n227\t\t\tTEST_CHECK(insertRecord(table,r));\n228\t\t\trids[i] = r->id;\n229\t        freeRecord(r);  // Added: Summer 2021\n230\t\t}\n231\t\n232\t\t// Mix 2 scans with c=3 as condition\n233\t\tMAKE_CONS(left, stringToValue(\"i3\"));\n234\t\tMAKE_ATTRREF(right, 2);\n235\t\tMAKE_BINOP_EXPR(se1, left, right, OP_COMP_EQUAL);\n236\t\tcreateRecord(&r, schema);\n237\t\tTEST_CHECK(startScan(table, sc1, se1));\n238\t\tTEST_CHECK(startScan(table, sc2, se1));\n239\t\tif ((rc2 = next(sc2, r)) == RC_OK)\n240\t\t\tscanTwo++;\n241\t\ti = 0;\n242\t\twhile((rc = next(sc1, r)) == RC_OK)\n243\t\t{\n244\t\t\tscanOne++;\n245\t\t\ti++;\n246\t\t\tif (i % 3 == 0)\n247\t\t\t\tif ((rc2 = next(sc2, r)) == RC_OK)\n248\t\t\t\t\tscanTwo++;\n249\t\t}\n250\t\twhile((rc2 = next(sc2, r)) == RC_OK)\n251\t\t\tscanTwo++;\n252\t\n253\t\tASSERT_TRUE(scanOne == scanTwo, \"scans returned same number of tuples\");\n254\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n255\t\t\tTEST_CHECK(rc);\n256\t\tTEST_CHECK(closeScan(sc1));\n257\t\tTEST_CHECK(closeScan(sc2));\n258\t\n259\t\tTEST_CHECK(closeTable(table));\n260\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n261\t\tTEST_CHECK(shutdownRecordManager());\n262\t\n263\t\tfree(rids);\n264\t\tfree(table);\n265\t// ****** Added Summer 2021\n266\t    freeRecord(r);\n267\t    free(sc1);\n268\t    free(sc2);\n269\t    freeExpr(se1);\n270\t    freeSchema(schema);\n271\t// *******\n272\t\tTEST_DONE();\n273\t}\n274\t\n275\tvoid \n276\ttestUpdateTable (void)\n277\t{\n278\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n279\t\tTestRecord inserts[] = {\n280\t\t\t\t{1, \"aaaa\", 3},\n281\t\t\t\t{2, \"bbbb\", 2},\n282\t\t\t\t{3, \"cccc\", 1},\n283\t\t\t\t{4, \"dddd\", 3},\n284\t\t\t\t{5, \"eeee\", 5},\n285\t\t\t\t{6, \"ffff\", 1},\n286\t\t\t\t{7, \"gggg\", 3},\n287\t\t\t\t{8, \"hhhh\", 3},\n288\t\t\t\t{9, \"iiii\", 2},\n289\t\t\t\t{10, \"jjjj\", 5},\n290\t\t};\n291\t\tTestRecord updates[] = {\n292\t\t\t\t{1, \"iiii\", 6},\n293\t\t\t\t{2, \"iiii\", 6},\n294\t\t\t\t{3, \"iiii\", 6}\n295\t\t};\n296\t\tint deletes[] = {\n297\t\t\t\t9,\n298\t\t\t\t6,\n299\t\t\t\t7,\n300\t\t\t\t8,\n301\t\t\t\t5\n302\t\t};\n303\t\tTestRecord finalR[] = {\n304\t\t\t\t{1, \"iiii\", 6},\n305\t\t\t\t{2, \"iiii\", 6},\n306\t\t\t\t{3, \"iiii\", 6},\n307\t\t\t\t{4, \"dddd\", 3},\n308\t\t\t\t{5, \"eeee\", 5},\n309\t\t};\n310\t\tint numInserts = 10, numUpdates = 3, numDeletes = 5, numFinal = 5, i;\n311\t\tRecord *r;\n312\t\tRID *rids;\n313\t\tSchema *schema;\n314\t\ttestName = \"test creating a new table and insert,update,delete tuples\";\n315\t\tschema = testSchema();\n316\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n317\t\n318\t\tTEST_CHECK(initRecordManager(NULL));\n319\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n320\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n321\t\n322\t\t// insert rows into table\n323\t\tfor(i = 0; i < numInserts; i++)\n324\t\t{\n325\t\t\tr = fromTestRecord(schema, inserts[i]);\n326\t\t\tTEST_CHECK(insertRecord(table,r));\n327\t\t\trids[i] = r->id;\n328\t        freeRecord(r);   // Added Summer 2021\n329\t\t}\n330\t\n331\t\t// delete rows from table\n332\t    TEST_CHECK(createRecord(&r, schema)); // added Fall 2021\n333\t\tfor(i = 0; i < numDeletes; i++)\n334\t\t{\n335\t\t\tTEST_CHECK(deleteRecord(table,rids[deletes[i]]));\n336\t        ASSERT_ERROR(getRecord(table, rids[deletes[i]], r), \"try to access record after you delete it\");   // Added Summer 2021\n337\t\t}\n338\t    freeRecord(r);   // Added Summer 2021\n339\t    \n340\t\t// update rows into table\n341\t\tfor(i = 0; i < numUpdates; i++)\n342\t\t{\n343\t\t\tr = fromTestRecord(schema, updates[i]);\n344\t\t\tr->id = rids[i];\n345\t\t\tTEST_CHECK(updateRecord(table,r));\n346\t        freeRecord(r);   // Added Summer 2021\n347\t\t}\n348\t\n349\t\tTEST_CHECK(closeTable(table));\n350\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n351\t\n352\t\t// retrieve records from the table and compare to expected final stage\n353\t    TEST_CHECK(createRecord(&r, schema));    // Added Summer 2021\n354\t\tfor(i = 0; i < numFinal; i++)\n355\t\t{\n356\t\t\tRID rid = rids[i];\n357\t\t\tTEST_CHECK(getRecord(table, rid, r));\n358\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, finalR[i]), r, schema, \"compare records\");\n359\t\t}\n360\t\n361\t\tTEST_CHECK(closeTable(table));\n362\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n363\t\tTEST_CHECK(shutdownRecordManager());\n364\t\n365\t\tfree(table);\n366\t// ***** Added Summer 2021\n367\t    free(rids);\n368\t    freeRecord(r);\n369\t    freeSchema(schema);\n370\t // *****\n371\t\tTEST_DONE();\n372\t}\n373\t\n374\tvoid \n375\ttestInsertManyRecords(void)\n376\t{\n377\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n378\t\tTestRecord inserts[] = {\n379\t\t\t\t{1, \"aaaa\", 3},\n380\t\t\t\t{2, \"bbbb\", 2},\n381\t\t\t\t{3, \"cccc\", 1},\n382\t\t\t\t{4, \"dddd\", 3},\n383\t\t\t\t{5, \"eeee\", 5},\n384\t\t\t\t{6, \"ffff\", 1},\n385\t\t\t\t{7, \"gggg\", 3},\n386\t\t\t\t{8, \"hhhh\", 3},\n387\t\t\t\t{9, \"iiii\", 2},\n388\t\t\t\t{10, \"jjjj\", 5},\n389\t\t};\n390\t\tTestRecord realInserts[10000];\n391\t\tTestRecord updates[] = {\n392\t\t\t\t{3333, \"iiii\", 6}\n393\t\t};\n394\t\tint numInserts = 10000, i;\n395\t\tint randomRec = 3333;\n396\t\tRecord *r;\n397\t\tRID *rids;\n398\t\tSchema *schema;\n399\t\ttestName = \"test creating a new table and inserting 10000 records then updating record from rids[3333]\";\n400\t\tschema = testSchema();\n401\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n402\t\n403\t\tTEST_CHECK(initRecordManager(NULL));\n404\t\tTEST_CHECK(createTable(\"test_table_t\",schema));\n405\t\tTEST_CHECK(openTable(table, \"test_table_t\"));\n406\t\n407\t\t// insert rows into table\n408\t\tfor(i = 0; i < numInserts; i++)\n409\t\t{\n410\t\t\trealInserts[i] = inserts[i%10];\n411\t\t\trealInserts[i].a = i;\n412\t\t\tr = fromTestRecord(schema, realInserts[i]);\n413\t\t\tTEST_CHECK(insertRecord(table,r));\n414\t\t\trids[i] = r->id;\n415\t        freeRecord(r);   // Added Summer 2021\n416\t\t}\n417\t\tTEST_CHECK(closeTable(table));\n418\t\tTEST_CHECK(openTable(table, \"test_table_t\"));\n419\t\n420\t\t// retrieve records from the table and compare to expected final stage\n421\t    TEST_CHECK(createRecord(&r, schema));    // Added Summer 2021\n422\t\tfor(i = 0; i < numInserts; i++)\n423\t\t{\n424\t\t\tRID rid = rids[i];\n425\t\t\tTEST_CHECK(getRecord(table, rid, r));\n426\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, realInserts[i]), r, schema, \"compare records\");\n427\t\t}\n428\t    freeRecord(r);   // Added Summer 2021\n429\t\n430\t\tr = fromTestRecord(schema, updates[0]);\n431\t\tr->id = rids[randomRec];\n432\t\tTEST_CHECK(updateRecord(table,r));\n433\t\tTEST_CHECK(getRecord(table, rids[randomRec], r));\n434\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, updates[0]), r, schema, \"compare records\");\n435\t\n436\t\tTEST_CHECK(closeTable(table));\n437\t\tTEST_CHECK(deleteTable(\"test_table_t\"));\n438\t\tTEST_CHECK(shutdownRecordManager());\n439\t\n440\t\tfreeRecord(r);\n441\t\tfree(table);\n442\t// ***** Added Summer 2021\n443\t    free(rids);\n444\t    freeSchema(schema);\n445\t// *****\n446\t\tTEST_DONE();\n447\t}\n448\t\n449\tvoid testScans (void)\n450\t{\n451\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n452\t\tTestRecord inserts[] = {\n453\t\t\t\t{1, \"aaaa\", 3},\n454\t\t\t\t{2, \"bbbb\", 2},\n455\t\t\t\t{3, \"cccc\", 1},\n456\t\t\t\t{4, \"dddd\", 3},\n457\t\t\t\t{5, \"eeee\", 5},\n458\t\t\t\t{6, \"ffff\", 1},\n459\t\t\t\t{7, \"gggg\", 3},\n460\t\t\t\t{8, \"hhhh\", 3},\n461\t\t\t\t{9, \"iiii\", 2},\n462\t\t\t\t{10, \"jjjj\", 5},\n463\t\t};\n464\t\tTestRecord scanOneResult[] = {\n465\t\t\t\t{3, \"cccc\", 1},\n466\t\t\t\t{6, \"ffff\", 1},\n467\t\t};\n468\t\tbool foundScan[] = {\n469\t\t\t\tFALSE,\n470\t\t\t\tFALSE\n471\t\t};\n472\t\tint numInserts = 10, scanSizeOne = 2, i;\n473\t\tRecord *r;\n474\t\tRID *rids;\n475\t\tSchema *schema;\n476\t\tRM_ScanHandle *sc = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n477\t\tExpr *sel, *left, *right;\n478\t\tint rc;\n479\t\n480\t\ttestName = \"test creating a new table and inserting tuples\";\n481\t\tschema = testSchema();\n482\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n483\t\n484\t\tTEST_CHECK(initRecordManager(NULL));\n485\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n486\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n487\t\n488\t\t// insert rows into table\n489\t\tfor(i = 0; i < numInserts; i++)\n490\t\t{\n491\t\t\tr = fromTestRecord(schema, inserts[i]);\n492\t\t\tTEST_CHECK(insertRecord(table,r));\n493\t\t\trids[i] = r->id;\n494\t        freeRecord(r);   // Added Summer 2021\n495\t\t}\n496\t\n497\t\tTEST_CHECK(closeTable(table));\n498\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n499\t\n500\t\t// run some scans\n501\t\tMAKE_CONS(left, stringToValue(\"i1\"));\n502\t\tMAKE_ATTRREF(right, 2);\n503\t\tMAKE_BINOP_EXPR(sel, left, right, OP_COMP_EQUAL);\n504\t\n505\t\tTEST_CHECK(startScan(table, sc, sel));\n506\t    TEST_CHECK(createRecord(&r, schema));  // Added Summer 2021\n507\t\twhile((rc = next(sc, r)) == RC_OK)\n508\t\t{\n509\t\t\tfor(i = 0; i < scanSizeOne; i++)\n510\t\t\t{\n511\t\t\t\tif (memcmp(fromTestRecord(schema, scanOneResult[i])->data,r->data,getRecordSize(schema)) == 0)\n512\t\t\t\t\tfoundScan[i] = TRUE;\n513\t\t\t}\n514\t\t}\n515\t    freeRecord(r);   // Added Summer 2021\n516\t\n517\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n518\t\t\tTEST_CHECK(rc);\n519\t\tTEST_CHECK(closeScan(sc));\n520\t\tfor(i = 0; i < scanSizeOne; i++)\n521\t\t\tASSERT_TRUE(foundScan[i], \"check for scan result\");\n522\t\n523\t\t// clean up\n524\t\tTEST_CHECK(closeTable(table));\n525\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n526\t\tTEST_CHECK(shutdownRecordManager());\n527\t\n528\t\tfree(table);\n529\t\tfree(sc);\n530\t// ***** Added Summer 2021\n531\t    free(rids);\n532\t    freeSchema(schema);\n533\t// *****\n534\t\tfreeExpr(sel);\n535\t\tTEST_DONE();\n536\t}\n537\t\n538\t\n539\tvoid testScansTwo (void)\n540\t{\n541\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n542\t\tTestRecord inserts[] = {\n543\t\t\t\t{1, \"aaaa\", 3},\n544\t\t\t\t{2, \"bbbb\", 2},\n545\t\t\t\t{3, \"cccc\", 1},\n546\t\t\t\t{4, \"dddd\", 3},\n547\t\t\t\t{5, \"eeee\", 5},\n548\t\t\t\t{6, \"ffff\", 1},\n549\t\t\t\t{7, \"gggg\", 3},\n550\t\t\t\t{8, \"hhhh\", 3},\n551\t\t\t\t{9, \"iiii\", 2},\n552\t\t\t\t{10, \"jjjj\", 5},\n553\t\t};\n554\t\tbool foundScan[] = {\n555\t\t\t\tFALSE,\n556\t\t\t\tFALSE,\n557\t\t\t\tFALSE,\n558\t\t\t\tFALSE,\n559\t\t\t\tFALSE,\n560\t\t\t\tFALSE,\n561\t\t\t\tFALSE,\n562\t\t\t\tFALSE,\n563\t\t\t\tFALSE,\n564\t\t\t\tFALSE\n565\t\t};\n566\t\tint numInserts = 10, i;\n567\t\tRecord *r;\n568\t\tRID *rids;\n569\t\tSchema *schema;\n570\t\tRM_ScanHandle *sc = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n571\t\tExpr *sel, *left, *right, *first, *se;\n572\t\tint rc;\n573\t\n574\t\ttestName = \"test creating a new table and inserting tuples\";\n575\t\tschema = testSchema();\n576\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n577\t\n578\t\tTEST_CHECK(initRecordManager(NULL));\n579\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n580\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n581\t\n582\t\t// insert rows into table\n583\t\tfor(i = 0; i < numInserts; i++)\n584\t\t{\n585\t\t\tr = fromTestRecord(schema, inserts[i]);\n586\t\t\tTEST_CHECK(insertRecord(table,r));\n587\t\t\trids[i] = r->id;\n588\t        freeRecord(r);   // Added Summer 2021\n589\t\t}\n590\t\n591\t\tTEST_CHECK(closeTable(table));\n592\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n593\t\n594\t\t// Select 1 record with INT in condition a=2.\n595\t\tMAKE_CONS(left, stringToValue(\"i2\"));\n596\t\tMAKE_ATTRREF(right, 0);\n597\t\tMAKE_BINOP_EXPR(sel, left, right, OP_COMP_EQUAL);\n598\t\tcreateRecord(&r, schema);\n599\t\tTEST_CHECK(startScan(table, sc, sel));\n600\t\twhile((rc = next(sc, r)) == RC_OK)\n601\t\t{\n602\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, inserts[1]), r, schema, \"compare records\");\n603\t\t}\n604\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n605\t\t\tTEST_CHECK(rc);\n606\t\tTEST_CHECK(closeScan(sc));\n607\t\n608\t\t// Select 1 record with STRING in condition b='ffff'.\n609\t\tMAKE_CONS(left, stringToValue(\"sffff\"));\n610\t\tMAKE_ATTRREF(right, 1);\n611\t\tMAKE_BINOP_EXPR(sel, left, right, OP_COMP_EQUAL);\n612\t\tcreateRecord(&r, schema);\n613\t\tTEST_CHECK(startScan(table, sc, sel));\n614\t\twhile((rc = next(sc, r)) == RC_OK)\n615\t\t{\n616\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, inserts[5]), r, schema, \"compare records\");\n617\t\t\tserializeRecord(r, schema);\n618\t\t}\n619\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n620\t\t\tTEST_CHECK(rc);\n621\t\tTEST_CHECK(closeScan(sc));\n622\t\n623\t\t// Select all records, with condition being false\n624\t\tMAKE_CONS(left, stringToValue(\"i4\"));\n625\t\tMAKE_ATTRREF(right, 2);\n626\t\tMAKE_BINOP_EXPR(first, right, left, OP_COMP_SMALLER);\n627\t\tMAKE_UNOP_EXPR(se, first, OP_BOOL_NOT);\n628\t\tTEST_CHECK(startScan(table, sc, se));\n629\t\twhile((rc = next(sc, r)) == RC_OK)\n630\t\t{\n631\t\t\tserializeRecord(r, schema);\n632\t\t\tfor(i = 0; i < numInserts; i++)\n633\t\t\t{\n634\t\t\t\tif (memcmp(fromTestRecord(schema, inserts[i])->data,r->data,getRecordSize(schema)) == 0)\n635\t\t\t\t\tfoundScan[i] = TRUE;\n636\t\t\t}\n637\t\t}\n638\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n639\t\t\tTEST_CHECK(rc);\n640\t\tTEST_CHECK(closeScan(sc));\n641\t\n642\t\tASSERT_TRUE(!foundScan[0], \"not greater than four\");\n643\t\tASSERT_TRUE(foundScan[4], \"greater than four\");\n644\t\tASSERT_TRUE(foundScan[9], \"greater than four\");\n645\t\n646\t\t// clean up\n647\t\tTEST_CHECK(closeTable(table));\n648\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n649\t\tTEST_CHECK(shutdownRecordManager());\n650\t\n651\t\tfreeRecord(r);\n652\t\tfree(table);\n653\t\tfree(sc);\n654\t    freeSchema(schema);   // Added Summer 2021\n655\t\tfreeExpr(sel);\n656\t\tTEST_DONE();\n657\t}\n658\t\n659\t\n660\tSchema *\n661\ttestSchema (void)\n662\t{\n663\t\tSchema *result;\n664\t\tchar *names[] = { \"a\", \"b\", \"c\" };\n665\t\tDataType dt[] = { DT_INT, DT_STRING, DT_INT };\n666\t\tint sizes[] = { 0, 4, 0 };\n667\t\tint keys[] = {0};\n668\t\tint i;\n669\t\tchar **cpNames = (char **) malloc(sizeof(char*) * 3);\n670\t\tDataType *cpDt = (DataType *) malloc(sizeof(DataType) * 3);\n671\t\tint *cpSizes = (int *) malloc(sizeof(int) * 3);\n672\t\tint *cpKeys = (int *) malloc(sizeof(int));\n673\t\n674\t\tfor(i = 0; i < 3; i++)\n675\t\t{\n676\t\t\tcpNames[i] = (char *) malloc(2);\n677\t\t\tstrcpy(cpNames[i], names[i]);\n678\t\t}\n679\t\tmemcpy(cpDt, dt, sizeof(DataType) * 3);\n680\t\tmemcpy(cpSizes, sizes, sizeof(int) * 3);\n681\t\tmemcpy(cpKeys, keys, sizeof(int));\n682\t\n683\t\tresult = createSchema(3, cpNames, cpDt, cpSizes, 1, cpKeys);\n684\t\n685\t\treturn result;\n686\t}\n687\t\n688\tRecord *\n689\tfromTestRecord (Schema *schema, TestRecord in)\n690\t{\n691\t\treturn testRecord(schema, in.a, in.b, in.c);\n692\t}\n693\t\n694\tRecord *\n695\ttestRecord(Schema *schema, int a, char *b, int c)\n696\t{\n697\t\tRecord *result;\n698\t\tValue *value;\n699\t\n700\t\tTEST_CHECK(createRecord(&result, schema));\n701\t\n702\t\tMAKE_VALUE(value, DT_INT, a);\n703\t\tTEST_CHECK(setAttr(result, schema, 0, value));\n704\t\tfreeVal(value);\n705\t\n706\t\tMAKE_STRING_VALUE(value, b);\n707\t\tTEST_CHECK(setAttr(result, schema, 1, value));\n708\t\tfreeVal(value);\n709\t\n710\t\tMAKE_VALUE(value, DT_INT, c);\n711\t\tTEST_CHECK(setAttr(result, schema, 2, value));\n712\t\tfreeVal(value);\n713\t\n714\t\treturn result;\n715\t}"}]},"parent_tool_use_id":null,"session_id":"903d3472-6d4e-4540-8f23-7e47bf94ceaf","uuid":"fc641879-2c1d-4616-847a-e53e42376b4f","timestamp":"2026-06-06T06:50:30.758Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-xUoRn0/project/c_src/test_assign3_1.c","content":"#include <stdlib.h>\n#include \"dberror.h\"\n#include \"expr.h\"\n#include \"record_mgr.h\"\n#include \"tables.h\"\n#include \"test_helper.h\"\n\n\n#define ASSERT_EQUALS_RECORDS(_l,_r, schema, message)\t\t\t\\\n\t\tdo {\t\t\t\t\t\t\t\t\t\\\n\t\t\tRecord *_lR = _l;                                                   \\\n\t\t\tRecord *_rR = _r;                                                   \\\n\t\t\tASSERT_TRUE(memcmp(_lR->data,_rR->data,getRecordSize(schema)) == 0, message); \\\n\t\t\tint i;\t\t\t\t\t\t\t\t\\\n\t\t\tfor(i = 0; i < schema->numAttr; i++)\t\t\t\t\\\n\t\t\t{\t\t\t\t\t\t\t\t\t\\\n\t\t\t\tValue *lVal, *rVal;                                             \\\n\t\t\t\tchar *lSer, *rSer; \\\n\t\t\t\tgetAttr(_lR, schema, i, &lVal);                                  \\\n\t\t\t\tgetAttr(_rR, schema, i, &rVal);                                  \\\n\t\t\t\tlSer = serializeValue(lVal); \\\n\t\t\t\trSer = serializeValue(rVal); \\\n\t\t\t\tASSERT_EQUALS_STRING(lSer, rSer, \"attr same\");\t\\\n\t\t\t\tfree(lVal); \\\n\t\t\t\tfree(rVal); \\\n\t\t\t\tfree(lSer); \\\n\t\t\t\tfree(rSer); \\\n\t\t\t}\t\t\t\t\t\t\t\t\t\\\n\t\t} while(0)\n\n#define ASSERT_EQUALS_RECORD_IN(_l,_r, rSize, schema, message)\t\t\\\n\t\tdo {\t\t\t\t\t\t\t\t\t\\\n\t\t\tint i;\t\t\t\t\t\t\t\t\\\n\t\t\tboolean found = false;\t\t\t\t\t\t\\\n\t\t\tfor(i = 0; i < rSize; i++)\t\t\t\t\t\t\\\n\t\t\tif (memcmp(_l->data,_r[i]->data,getRecordSize(schema)) == 0)\t\\\n\t\t\tfound = true;\t\t\t\t\t\t\t\\\n\t\t\tASSERT_TRUE(0, message);\t\t\t\t\t\t\\\n\t\t} while(0)\n\n#define OP_TRUE(left, right, op, message)\t\t\\\n\t\tdo {\t\t\t\t\t\t\t\\\n\t\t\tValue *result = (Value *) malloc(sizeof(Value));\t\\\n\t\t\top(left, right, result);\t\t\t\t\\\n\t\t\tbool b = result->v.boolV;\t\t\t\t\\\n\t\t\tfree(result);\t\t\t\t\t\\\n\t\t\tASSERT_TRUE(b,message);\t\t\t\t\\\n\t\t} while (0)\n\n// test methods\nstatic void testRecords (void);\nstatic void testCreateTableAndInsert (void);\nstatic void testUpdateTable (void);\nstatic void testScans (void);\nstatic void testScansTwo (void);\nstatic void testInsertManyRecords(void);\nstatic void testMultipleScans(void);\n\n// struct for test records\ntypedef struct TestRecord {\n\tint a;\n\tchar *b;\n\tint c;\n} TestRecord;\n\n// helper methods\nRecord *testRecord(Schema *schema, int a, char *b, int c);\nSchema *testSchema (void);\nRecord *fromTestRecord (Schema *schema, TestRecord in);\n\n// test name\nchar *testName;\n\n// main method\nint \nmain (void) \n{\n\ttestName = \"\";\n\n\ttestInsertManyRecords();\n\ttestRecords();\n\ttestCreateTableAndInsert();\n\ttestUpdateTable();\n\ttestScans();\n\ttestScansTwo();\n\ttestMultipleScans();\n  \tprintf(\"\\033[1;32mSuccessfully All Tests Completed!\\033[0m\\n\");\n\n\treturn 0;\n}\n\n// ************************************************************ \nvoid\ntestRecords (void)\n{\n\tTestRecord expected[] = {\n\t\t\t{1, \"aaaa\", 3},\n\t};\n\tSchema *schema;\n\tRecord *r;\n\tValue *value;\n\ttestName = \"test creating records and manipulating attributes\";\n\n\t// check attributes of created record\n\tschema = testSchema();\n\tr = fromTestRecord(schema, expected[0]);\n\n\tgetAttr(r, schema, 0, &value);\n\tOP_TRUE(stringToValue(\"i1\"), value, valueEquals, \"first attr\");\n\tfreeVal(value);\n\n\tgetAttr(r, schema, 1, &value);\n\tOP_TRUE(stringToValue(\"saaaa\"), value, valueEquals, \"second attr\");\n\tfreeVal(value);\n\n\tgetAttr(r, schema, 2, &value);\n\tOP_TRUE(stringToValue(\"i3\"), value, valueEquals, \"third attr\");\n\tfreeVal(value);\n\n\t//modify attrs\n\tsetAttr(r, schema, 2, stringToValue(\"i4\"));\n\tgetAttr(r, schema, 2, &value);\n\tOP_TRUE(stringToValue(\"i4\"), value, valueEquals, \"third attr after setting\");\n\tfreeVal(value);\n\n\tfreeRecord(r);\n    freeSchema(schema);   // added Summer 2021\n\tTEST_DONE();\n}\n\n// ************************************************************ \nvoid\ntestCreateTableAndInsert (void)\n{\n\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n\tTestRecord inserts[] = {\n\t\t\t{1, \"aaaa\", 3},\n\t\t\t{2, \"bbbb\", 2},\n\t\t\t{3, \"cccc\", 1},\n\t\t\t{4, \"dddd\", 3},\n\t\t\t{5, \"eeee\", 5},\n\t\t\t{6, \"ffff\", 1},\n\t\t\t{7, \"gggg\", 3},\n\t\t\t{8, \"hhhh\", 3},\n\t\t\t{9, \"iiii\", 2}\n\t};\n\tint numInserts = 9, i;\n\tRecord *r;\n\tRID *rids;\n\tSchema *schema;\n\ttestName = \"test creating a new table and inserting tuples\";\n\tschema = testSchema();\n\trids = (RID *) malloc(sizeof(RID) * numInserts);\n\n\tTEST_CHECK(initRecordManager(NULL));\n\tTEST_CHECK(createTable(\"test_table_r\",schema));\n\tTEST_CHECK(openTable(table, \"test_table_r\"));\n\n\t// insert rows into table\n\tfor(i = 0; i < numInserts; i++)\n    {\n\t\tr = fromTestRecord(schema, inserts[i]);\n\t\tTEST_CHECK(insertRecord(table,r));\n\t\trids[i] = r->id;\n        freeRecord(r);    // added Fall 2021\n    }\n\n\tTEST_CHECK(closeTable(table));\n\tTEST_CHECK(openTable(table, \"test_table_r\"));\n\n\t// randomly retrieve records from the table and compare to inserted ones\n\tfor(i = 0; i < 1000; i++)\n\t{   TEST_CHECK(createRecord(&r, schema));  // added Fall 2021\n\t\tint pos = rand() % numInserts;\n\t\tRID rid = rids[pos];\n\t\tTEST_CHECK(getRecord(table, rid, r));\n\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, inserts[pos]), r, schema, \"compare records\");\n        freeRecord (r);  // Added: Summer 2021\n\t}\n\n\tTEST_CHECK(closeTable(table));\n\tTEST_CHECK(deleteTable(\"test_table_r\"));\n\tTEST_CHECK(shutdownRecordManager());\n\n\tfree(rids);\n\tfree(table);\n    freeSchema(schema);   // Added: Summer 2021\n\tTEST_DONE();\n}\n\nvoid\ntestMultipleScans(void)\n{\n\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n\tTestRecord inserts[] = {\n\t\t\t{1, \"aaaa\", 3},\n\t\t\t{2, \"bbbb\", 2},\n\t\t\t{3, \"cccc\", 1},\n\t\t\t{4, \"dddd\", 3},\n\t\t\t{5, \"eeee\", 5},\n\t\t\t{6, \"ffff\", 1},\n\t\t\t{7, \"gggg\", 3},\n\t\t\t{8, \"hhhh\", 3},\n\t\t\t{9, \"iiii\", 2},\n\t\t\t{10, \"jjjj\", 5},\n\t};\n\tint numInserts = 10, i, scanOne=0, scanTwo=0;\n\tRecord *r;\n\tRID *rids;\n\tSchema *schema;\n\ttestName = \"test running muliple scans \";\n\tschema = testSchema();\n\trids = (RID *) malloc(sizeof(RID) * numInserts);\n\tRM_ScanHandle *sc1 = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n\tRM_ScanHandle *sc2 = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n\tExpr *se1, *left, *right;\n\tint rc,rc2;\n\n\tTEST_CHECK(initRecordManager(NULL));\n\tTEST_CHECK(createTable(\"test_table_r\",schema));\n\tTEST_CHECK(openTable(table, \"test_table_r\"));\n\n\t// insert rows into table\n\tfor(i = 0; i < numInserts; i++)\n\t{\n\t\tr = fromTestRecord(schema, inserts[i]);\n\t\tTEST_CHECK(insertRecord(table,r));\n\t\trids[i] = r->id;\n        freeRecord(r);  // Added: Summer 2021\n\t}\n\n\t// Mix 2 scans with c=3 as condition\n\tMAKE_CONS(left, stringToValue(\"i3\"));\n\tMAKE_ATTRREF(right, 2);\n\tMAKE_BINOP_EXPR(se1, left, right, OP_COMP_EQUAL);\n\tcreateRecord(&r, schema);\n\tTEST_CHECK(startScan(table, sc1, se1));\n\tTEST_CHECK(startScan(table, sc2, se1));\n\tif ((rc2 = next(sc2, r)) == RC_OK)\n\t\tscanTwo++;\n\ti = 0;\n\twhile((rc = next(sc1, r)) == RC_OK)\n\t{\n\t\tscanOne++;\n\t\ti++;\n\t\tif (i % 3 == 0)\n\t\t\tif ((rc2 = next(sc2, r)) == RC_OK)\n\t\t\t\tscanTwo++;\n\t}\n\twhile((rc2 = next(sc2, r)) == RC_OK)\n\t\tscanTwo++;\n\n\tASSERT_TRUE(scanOne == scanTwo, \"scans returned same number of tuples\");\n\tif (rc != RC_RM_NO_MORE_TUPLES)\n\t\tTEST_CHECK(rc);\n\tTEST_CHECK(closeScan(sc1));\n\tTEST_CHECK(closeScan(sc2));\n\n\tTEST_CHECK(closeTable(table));\n\tTEST_CHECK(deleteTable(\"test_table_r\"));\n\tTEST_CHECK(shutdownRecordManager());\n\n\tfree(rids);\n\tfree(table);\n// ****** Added Summer 2021\n    freeRecord(r);\n    free(sc1);\n    free(sc2);\n    freeExpr(se1);\n    freeSchema(schema);\n// *******\n\tTEST_DONE();\n}\n\nvoid \ntestUpdateTable (void)\n{\n\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n\tTestRecord inserts[] = {\n\t\t\t{1, \"aaaa\", 3},\n\t\t\t{2, \"bbbb\", 2},\n\t\t\t{3, \"cccc\", 1},\n\t\t\t{4, \"dddd\", 3},\n\t\t\t{5, \"eeee\", 5},\n\t\t\t{6, \"ffff\", 1},\n\t\t\t{7, \"gggg\", 3},\n\t\t\t{8, \"hhhh\", 3},\n\t\t\t{9, \"iiii\", 2},\n\t\t\t{10, \"jjjj\", 5},\n\t};\n\tTestRecor