{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Q7ps9vGFCZK2hhYMstZseK","type":"tool_result","content":"1\t/**\n2\t * @file queue.h\n3\t * @brief Entry header file to the library.\n4\t *\n5\t * @author Saurav Pal (resyfer)\n6\t * @bug No known bugs\n7\t */\n8\t\n9\t#ifndef __LIBQUEUE_H\n10\t#define __LIBQUEUE_H\n11\t\n12\t/* libc */\n13\t#include <stdbool.h>\n14\t#include <sys/types.h>\n15\t\n16\t/**\n17\t * @mainpage\n18\t * A queue data structure to which elements of any data type can be pushed\n19\t * and popped from in a first in first out basis.\n20\t */\n21\t\n22\t/**\n23\t * @brief Nodes in the queue.\n24\t *\n25\t * The building blocks of queue\n26\t */\n27\ttypedef struct queue_node_t {\n28\t\tvoid* value; /*!< Value stored in the node */\n29\t\tstruct queue_node_t* next; /*!< Next node in the linked list */\n30\t} queue_node_t;\n31\t\n32\t/**\n33\t * @brief Queue instance\n34\t *\n35\t * Implemented as a singly linked list, such that elements get pushed behind\n36\t * the tail, while elements get popped from head.\n37\t */\n38\ttypedef struct {\n39\t\tu_int32_t size; /*!< Size of the queue */\n40\t\tqueue_node_t* head; /*!< First node in the linked list */\n41\t\tqueue_node_t* tail; /*!< Last node in the linked list */\n42\t} queue_t;\n43\t\n44\t/**\n45\t * @brief Initialize a queue\n46\t *\n47\t * @param queue A queue instance to initialize\n48\t */\n49\tvoid queue_new(queue_t *queue);\n50\t\n51\t/* CRUD */\n52\t\n53\t/**\n54\t * @brief Push elements to the back of the queue.\n55\t *\n56\t * @param queue Queue instance\n57\t * @param value Value to push\n58\t */\n59\tvoid queue_push(queue_t *queue, void *value);\n60\t\n61\t/**\n62\t * @brief Pop elements from the front of the queue.\n63\t *\n64\t * @param queue Queue instance\n65\t * @return void* Value of the element popped.\n66\t */\n67\tvoid* queue_pop(queue_t *queue);\n68\t\n69\t/**\n70\t * @brief Peek the front element of the queue.\n71\t *\n72\t * @param queue Queue I