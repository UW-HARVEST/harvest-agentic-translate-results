older = GapBufferGetString(buffer3);\n185\t    string_comp_assert(string_holder, sample12);\n186\t\n187\t    printf(\"Test 6.1 Create From string\\n\");\n188\t\n189\t    err = GapBufferInsertChar(buffer3, 'p');\n190\t    assert(err == 0);\n191\t\n192\t    string_holder = GapBufferGetString(buffer3);\n193\t    string_comp_assert(string_holder, sample13);\n194\t\n195\t    printf(\"Test 7 Backspace\\n\");\n196\t    for (int i=0; i<7; i++){\n197\t        GapBufferBackSpace(buffer);\n198\t    }\n199\t\n200\t    string_holder = GapBufferGetString(buffer);\n201\t    string_comp_assert(string_holder, sample1);\n202\t\n203\t\n204\t    printf(\"Cleanup...\\n\");\n205\t    DestroyGapBuffer(buffer);\n206\t    DestroyGapBuffer(buffer2);\n207\t    DestroyGapBuffer(buffer3);\n208\t\n209\t    printf(\"GapBuffer Tests Passed.\");\n210\t}\n211\t\n212\t\n213\t\n214\t\n215\t\n216\tvoid TestTextBuffer(){\n217\t\n218\t    printf(\"\\n\\nTesting TextBuffer\\n\");\n219\t\n220\t    TextBuffer* texBuffer = CreateTextBuffer(10, 20);\n221\t    assert(texBuffer != NULL);\n222\t\n223\t    int errno;\n224\t    char* string_holder = NULL;\n225\t\n226\t    const char sample1[] = \"\";\n227\t    const char sample2[] = \"a\";\n228\t    const char sample3[] = \"aaaaaaaaaaa\";  // 11 characters\n229\t    const char sample4[] = \"aaaaaaaaaa\";  // 10 characters\n230\t    const char sample5[] = \"aaaaaaaaa\";  // 9 characters\n231\t\n232\t\n233\t    printf(\"Test 1, empty string\\n\");\n234\t\n235\t    string_holder = TextBufferGetLine(texBuffer, texBuffer->cursorRow);\n236\t    string_comp_assert(string_holder, sample1);\n237\t\n238\t    printf(\"Test 2 insert char\\n\");\n239\t    errno = TextBufferInsert(texBuffer, 'a');\n240\t    assert(errno == 0);\n241\t\n242\t    string_holder = TextBufferGetLine(texBuffer, texBuffer->cursorRow);\n243\t    string_comp_assert(string_holder, sample2);\n244\t\n245\t    printf(\"Test 2.1 insert char\\n\");\n246\t    for (int i=0; i<10; i++){\n247\t        errno = Text