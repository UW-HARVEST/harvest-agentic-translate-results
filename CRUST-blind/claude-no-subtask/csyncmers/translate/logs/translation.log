{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_lbgznpfcuqi3k5hwlprqs34jdfjkcfl4stxwpotuaj7fu47sjlfa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01HyDLSDk5aTQgANChmj89fr","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-X1UCqL/project/src/closed_syncmers.rs","content":"// Import necessary modules\nuse std::collections::HashMap;\n// Struct Definitions\n#[derive(Debug, Clone)]\npub struct MinimizerResult {\n    pub minimizer_hash: u128,\n    pub kmer_position: usize,\n    pub smer_position: usize,\n}\n// Function Declarations\npub fn compute_closed_syncmers(sequence_input: &str, len: i32, k: i32, s: i32, results: &mut Vec<MinimizerResult>, num_results: &mut i32) {\n    *num_results = 0;\n    results.clear();\n    if len < k {\n        eprintln!(\"Sequence length is less than K\");\n        return;\n    }\n\n    let len_us = len as usize;\n    let k_us = k as usize;\n    let s_us = s as usize;\n    let bytes = sequence_input.as_bytes();\n\n    if len_us < s_us {\n        return;\n    }\n\n    let num_s_mers = len_us - s_us + 1;\n    let mut s_mer_hashes: Vec<u128> = vec![0u128; num_s_mers];\n\n    // Build the mask for 2*S bits\n    let bits = 2usize * s_us;\n    let mask: u128 = if bits >= 128 { !0u128 } else { (1u128 << bits) - 1 };\n    let mut hash_fwd: u128 = 0;\n    let mut hash_rev: u128 = 0;\n    let rc_shift: u32 = (2 * (s_us as i64 - 1)).max(0) as u32;\n\n    for i in 0..len_us {\n        let base = base_to_bits(bytes[i] as char);\n        hash_fwd = ((hash_fwd << 2) | (base as u128)) & mask;\n        let comp_base = complement_base(base);\n        hash_rev = ((hash_rev >> 2) | ((comp_base as u128) << rc_shift)) & mask;\n        if i + 1 >= s_us {\n            let s_mer_pos = i - s_us + 1;\n            let canonical_hash = if hash_fwd < hash_rev { hash_fwd } else { hash_rev };\n            s_mer_hashes[s_mer_pos] = canonical_hash;\n        }\n    }\n\n    // Initialize deque (k - s + 1 == window size)\n    if k_us < s_us {\n        return;\n    }\n    let window_size = k_us - s_us + 1;\n    let mut deque: Vec<usize> = vec![0usize; num_s_mers];\n    let mut front: usize = 0;\n    let mut back: usize = 0;\n\n    for i in 0..num_s_mers {\n        while back > front && s_mer_hashes[deque[back - 1]] > s_mer_hashes[i] {\n            back -= 1;\n        }\n        deque[back] = i;\n        back += 1;\n        if i >= window_size && deque[front] <= i - window_size {\n            front += 1;\n        }\n\n        // Check for closed syncmer condition\n        if i + 1 >= window_size {\n            let min_pos = deque[front];\n            let kmer_pos = i + 1 - window_size;\n            if min_pos == kmer_pos || min_pos == kmer_pos + k_us - s_us {\n                add_minimizer(results, num_results, s_mer_hashes[min_pos], kmer_pos, min_pos);\n            }\n        }\n    }\n\n    // Suppress unused-import warning\n    let _ = std::mem::size_of::<HashMap<u8, u8>>();\n}\npub fn base_to_bits(base: char) -> u8 {\n    match base {\n        'A' | 'a' => 0,\n        'C' | 'c' => 1,\n        'G' | 'g' => 2,\n        'T' | 't' => 3,\n        _ => 0,\n    }\n}\npub fn complement_base(base: u8) -> u8 {\n    3 - base\n}\npub fn add_minimizer(results: &mut Vec<MinimizerResult>, size: &mut i32, minimizer_hash: u128, kmer_position: usize, smer_position: usize) {\n    results.push(MinimizerResult {\n        minimizer_hash,\n        kmer_position,\n        smer_position,\n    });\n    *size += 1;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1246,"cache_read_input_tokens":23395,"cache_creation":{"ephemeral_5m_input_tokens":1246,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e74a2c45-427c-49cf-b231-1246d2500795","uuid":"a3236851-4d99-4e19-a56f-4349997b6b5b"}
