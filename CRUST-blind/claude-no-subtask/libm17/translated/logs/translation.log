    0x0000\n        } else if v >= symbol_list[1] as f32 {\n            (0x7FFFu32 as f32 - v * (0xFFFFu32 as f32) / ((symbol_list[2] - symbol_list[1]) as f32))\n                as u16\n        } else {\n            0xFFFF\n        };\n\n        // Truncate to u8 (high byte) since the Rust signature uses u8\n        out[i * 2] = (b1_u16 >> 8) as u8;\n        out[i * 2 + 1] = (b0_u16 >> 8) as u8;\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":6,"lines":["+use crate::math::soft_bit_not;"," use crate::types::SYM_PER_PLD;","+"," pub const SYNC_LSF: u16 = 0x55F7;"," pub const SYNC_STR: u16 = 0xFF5D;"," pub const SYNC_PKT: u16 = 0x75FF;"]},{"oldStart":30,"oldLines":18,"newStart":32,"newLines":87,"lines":["     0x0C, 0xC8, 0x52, 0x43, 0x91, 0x1D, 0xF8, 0x6E, 0x68, 0x2F, 0x35, 0xDA, 0x14, 0xEA, 0xCD, 0x76,","     0x19, 0x8D, 0xD5, 0x80, 0xD1, 0x33, 0x87, 0x13, 0x57, 0x18, 0x2D, 0x29, 0x78, 0xC3,"," ];","+"," pub fn reorder_bits(out: &mut [u8; SYM_PER_PLD * 2], inp: &[u8; SYM_PER_PLD * 2]) {","-    unimplemented!()","+    for i in 0..(SYM_PER_PLD * 2) {","+        out[i] = inp[INTRL_SEQ[i]];","+    }"," }","+"," pub fn reorder_soft_bits(out: &mut [u8; SYM_PER_PLD * 2], inp: &[u8; SYM_PER_PLD * 2]) {","-    unimplemented!()","+    for i in 0..(SYM_PER_PLD * 2) {","+        out[i] = inp[INTRL_SEQ[i]];","+    }"," }","+"," pub fn randomize_bits(inp: &mut [u8; SYM_PER_PLD * 2]) {","-    unimplemented!()","+    for i in 0..(SYM_PER_PLD * 2) {","+        if (RAND_SEQ[i / 8] >> (7 - (i % 8))) & 1 != 0 {","+            if inp[i] != 0 {","+                inp[i] = 0;","+            } else {","+                inp[i] = 1;","+            }","+        }","+    }"," }","+"," pub fn randomize_soft_bits(inp: &mut [u8; SYM_PER_PLD * 2]) {","-    unimplemented!()","+    // Even though the C version uses uint16_t (soft bits), the Rust signature","+    // here uses u8. We follow the pattern of randomize_bits but use soft_bit_NOT","+    // semantics: 0 -> 0xF