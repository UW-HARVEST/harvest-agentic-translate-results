{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01N7XDtKa5njWCUSJA4T36Dy","type":"tool_result","content":"1\t//--------------------------------------------------------------------\n2\t// M17 C library - m17.c\n3\t//\n4\t// Wojciech Kaczmarski, SP5WWP\n5\t// M17 Project, 5 January 2024\n6\t//--------------------------------------------------------------------\n7\t#include <m17.h>\n8\t\n9\t/**\n10\t * @brief Generate symbol stream for a preamble.\n11\t * \n12\t * @param out Frame buffer (192 floats).\n13\t * @param cnt Pointer to a variable holding the number of written symbols.\n14\t * @param type Preamble type (pre-BERT or pre-LSF).\n15\t */\n16\tvoid send_preamble(float out[SYM_PER_FRA], uint32_t *cnt, const pream_t type)\n17\t{\n18\t    if(type==PREAM_BERT) //pre-BERT\n19\t    {\n20\t        for(uint16_t i=0; i<SYM_PER_FRA/2; i++) //40ms * 4800 = 192\n21\t        {\n22\t            out[(*cnt)++]=-3.0;\n23\t            out[(*cnt)++]=+3.0;\n24\t        }\n25\t    }\n26\t    else// if(type==PREAM_LSF) //pre-LSF\n27\t    {\n28\t        for(uint16_t i=0; i<SYM_PER_FRA/2; i++) //40ms * 4800 = 192\n29\t        {\n30\t            out[(*cnt)++]=+3.0;\n31\t            out[(*cnt)++]=-3.0;\n32\t        }\n33\t    }\n34\t}\n35\t\n36\t/**\n37\t * @brief Generate symbol stream for a syncword.\n38\t * \n39\t * @param out Output buffer (8 floats).\n40\t * @param cnt Pointer to a variable holding the number of written symbols.\n41\t * @param syncword Syncword.\n42\t */\n43\tvoid send_syncword(float out[SYM_PER_SWD], uint32_t *cnt, const uint16_t syncword)\n44\t{\n45\t    for(uint8_t i=0; i<SYM_PER_SWD*2; i+=2)\n46\t    {\n47\t        out[(*cnt)++]=symbol_map[(syncword>>(14-i))&3];\n48\t    }\n49\t}\n50\t\n51\t/**\n52\t * @brief Generate symbol stream for frame contents (without the syncword).\n53\t * Can be used for both LSF and data frames.\n54\t * \n55\t * @param out Output buffer (184 floats).\n56\t * @param cnt Pointer to a variable holding the number of written symbols.\n57\t * @param in Data input - unpacked bits (1 bit per byte).\n58\t */\n59\tvoid send_data(float out[SYM_PER_PLD], uint32_t *cnt, const uint8_t* in)\n60\t{\n61\t    for(uint16_t i=0; i<SYM_PER_PLD; i++) //40ms * 4800 - 8 (syncword)\n62\t    {\n63\t        out[(*cnt)++]=symbol_map[in[2*i]*2+in[2*i+1]];\n64\t    }\n65\t}\n66\t\n67\t/**\n68\t * @brief Generate symbol stream for the End of Transmission marker.\n69\t * \n70\t * @param out Output buffer (192 floats).\n71\t * @param cnt Pointer to a variable holding the number of written symbols.\n72\t */\n73\tvoid send_eot(float out[SYM_PER_FRA], uint32_t *cnt)\n74\t{\n75\t    for(uint16_t i=0; i<SYM_PER_FRA; i++) //40ms * 4800 = 192\n76\t    {\n77\t        out[(*cnt)++]=eot_symbols[i%8];\n78\t    }\n79\t}\n80\t\n81\t/**\n82\t * @brief Generate frame symbols.\n83\t * \n84\t * @param out Output buffer for symbols (192 symbols).\n85\t * @param data Payload (16 or 25 bytes).\n86\t * @param type Frame type (LSF, Stream, Packet).\n87\t * @param lsf Pointer to a structure holding Link Setup Frame data.\n88\t * @param lich_cnt LICH counter (0..5).\n89\t * @param fn Frame number.\n90\t */\n91\tvoid send_frame(float out[SYM_PER_FRA], const uint8_t* data, const frame_t type, const lsf_t* lsf, const uint8_t lich_cnt, const uint16_t fn)\n92\t{\n93\t    uint8_t lich[6];                    //48 bits packed raw, unencoded LICH\n94\t    uint8_t lich_encoded[12];           //96 bits packed, encoded LICH\n95\t    uint8_t enc_bits[SYM_PER_PLD*2];    //type-2 bits, unpacked\n96\t    uint8_t rf_bits[SYM_PER_PLD*2];     //type-4 bits, unpacked\n97\t    uint32_t sym_cnt=0;                 //symbols written counter\n98\t\n99\t    if(type==FRAME_LSF)\n100\t    {\n101\t        send_syncword(out, &sym_cnt, SYNC_LSF);\n102\t        conv_encode_LSF(enc_bits, lsf);\n103\t    }\n104\t    else if(type==FRAME_STR)\n105\t    {\n106\t        send_syncword(out, &sym_cnt, SYNC_STR);\n107\t        extract_LICH(lich, lich_cnt, lsf);\n108\t        encode_LICH(lich_encoded, lich);\n109\t        unpack_LICH(enc_bits, lich_encoded);\n110\t        conv_encode_stream_frame(&enc_bits[96], data, fn); //stream frames require 16-byte payloads\n111\t    }\n112\t    else if(type==FRAME_PKT)\n113\t    {\n114\t        send_syncword(out, &sym_cnt, SYNC_PKT);\n115\t        conv_encode_packet_frame(enc_bits, data); //packet frames require 200-bit payload chunks plus a 6-bit counter\n116\t    }\n117\t\n118\t    //common stuff\n119\t    reorder_bits(rf_bits, enc_bits);\n120\t    randomize_bits(rf_bits);\n121\t    send_data(out, &sym_cnt, rf_bits);\n122\t}\n123\t"}]},"parent_tool_use_id":null,"session_id":"a033309e-faba-4b1e-9dde-929a02d317d5","uuid":"c4f87d19-dd8f-4974-9ffb-838591fb0d93","timestamp":"2026-06-06T05:31:12.115Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-EEHytx/project/c_src/m17.c","content":"//--------------------------------------------------------------------\n// M17 C library - m17.c\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 5 January 2024\n//--------------------------------------------------------------------\n#include <m17.h>\n\n/**\n * @brief Generate symbol stream for a preamble.\n * \n * @param out Frame buffer (192 floats).\n * @param cnt Pointer to a variable holding the number of written symbols.\n * @param type Preamble type (pre-BERT or pre-LSF).\n */\nvoid send_preamble(float out[SYM_PER_FRA], uint32_t *cnt, const pream_t type)\n{\n    if(type==PREAM_BERT) //pre-BERT\n    {\n        for(uint16_t i=0; i<SYM_PER_FRA/2; i++) //40ms * 4800 = 192\n        {\n            out[(*cnt)++]=-3.0;\n            out[(*cnt)++]=+3.0;\n        }\n    }\n    else// if(type==PREAM_LSF) //pre-LSF\n    {\n        for(uint16_t i=0; i<SYM_PER_FRA/2; i++) //40ms * 4800 = 192\n        {\n            out[(*cnt)++]=+3.0;\n            out[(*cnt)++]=-3.0;\n        }\n    }\n}\n\n/**\n * @brief Generate symbol stream for a syncword.\n * \n * @param out Output buffer (8 floats).\n * @param cnt Pointer to a variable holding the number of written symbols.\n * @param syncword Syncword.\n */\nvoid send_syncword(float out[SYM_PER_SWD], uint32_t *cnt, const uint16_t syncword)\n{\n    for(uint8_t i=0; i<SYM_PER_SWD*2; i+=2)\n    {\n        out[(*cnt)++]=symbol_map[(syncword>>(14-i))&3];\n    }\n}\n\n/**\n * @brief Generate symbol stream for frame contents (without the syncword).\n * Can be used for both LSF and data frames.\n * \n * @param out Output buffer (184 floats).\n * @param cnt Pointer to a variable holding the number of written symbols.\n * @param in Data input - unpacked bits (1 bit per byte).\n */\nvoid send_data(float out[SYM_PER_PLD], uint32_t *cnt, const uint8_t* in)\n{\n    for(uint16_t i=0; i<SYM_PER_PLD; i++) //40ms * 4800 - 8 (syncword)\n    {\n        out[(*cnt)++]=symbol_map[in[2*i]*2+in[2*i+1]];\n    }\n}\n\n/**\n * @brief Generate symbol stream for the End of Transmission marker.\n * \n * @param out Output buffer (192 floats).\n * @param cnt Pointer to a variable holding the number of written symbols.\n */\nvoid send_eot(float out[SYM_PER_FRA], uint32_t *cnt)\n{\n    for(uint16_t i=0; i<SYM_PER_FRA; i++) //40ms * 4800 = 192\n    {\n        out[(*cnt)++]=eot_symbols[i%8];\n    }\n}\n\n/**\n * @brief Generate frame symbols.\n * \n * @param out Output buffer for symbols (192 symbols).\n * @param data Payload (16 or 25 bytes).\n * @param type Frame type (LSF, Stream, Packet).\n * @param lsf Pointer to a structure holding Link Setup Frame data.\n * @param lich_cnt LICH counter (0..5).\n * @param fn Frame number.\n */\nvoid send_frame(float out[SYM_PER_FRA], const uint8_t* data, const frame_t type, const lsf_t* lsf, const uint8_t lich_cnt, const uint16_t fn)\n{\n    uint8_t lich[6];                    //48 bits packed raw, unencoded LICH\n    uint8_t lich_encoded[12];           //96 bits packed, encoded LICH\n    uint8_t enc_bits[SYM_PER_PLD*2];    //type-2 bits, unpacked\n    uint8_t rf_bits[SYM_PER_PLD*2];     //type-4 bits, unpacked\n    uint32_t sym_cnt=0;                 //symbols written counter\n\n    if(type==FRAME_LSF)\n    {\n        send_syncword(out, &sym_cnt, SYNC_LSF);\n        conv_encode_LSF(enc_bits, lsf);\n    }\n    else if(type==FRAME_STR)\n    {\n        send_syncword(out, &sym_cnt, SYNC_STR);\n        extract_LICH(lich, lich_cnt, lsf);\n        encode_LICH(lich_encoded, lich);\n        unpack_LICH(enc_bits, lich_encoded);\n        conv_encode_stream_frame(&enc_bits[96], data, fn); //stream frames require 16-byte payloads\n    }\n    else if(type==FRAME_PKT)\n    {\n        send_syncword(out, &sym_cnt, SYNC_PKT);\n        conv_encode_packet_frame(enc_bits, data); //packet frames require 200-bit payload chunks plus a 6-bit counter\n    }\n\n    //common stuff\n    reorder_bits(rf_bits, enc_bits);\n    randomize_bits(rf_bits);\n    send_data(out, &sym_cnt, rf_bits);\n}\n","numLines":123,"startLine":1,"totalLines":123}}}
