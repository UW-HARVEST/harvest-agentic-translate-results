_block = [0u8; 16];\n    temp_block.copy_from_slice(&key[0..16]);\n    // store at 0, 4, 8, 12 -- in the C code, the writes go beyond the buffer\n    // but only for the unused garbage area that gets overwritten later.\n    // We'll just copy key into w[0..16].\n    w[0..16].copy_from_slice(&temp_block);\n\n    // Then the main expansion\n    let mut i = NK;\n    while i < NB * (NR + 1) {\n        // Load temp = w[4*(i-1) .. 4*(i-1)+16]; only the first 4 bytes are\n        // used in subsequent operations (since we'll XOR with w[i-Nk] taking\n        // only 4 bytes too, and store 4 bytes). However, the C code uses\n        // 16-byte SIMD operations. Since we only really store at w[4*i..4*i+4]\n        // in effect (because of overlap with later iterations), we just need the\n        // first 4 bytes to match correctly.\n        //\n        // Wait — looking again at the C code: it stores 16 bytes (`_mm_storeu_si128`)\n        // at w[4*i]. But each iteration moves i by 4, so the next iteration\n        // overwrites w[4*(i+4)..] = w[4i+16..]. The intermediate bytes w[4i+4..4i+16]\n        // get overwritten in subsequent iterations. So the only bytes that\n        // permanently remain are w[4i..4i+4].\n        //\n        // Therefore, we can implement this as a simple 4-byte word XOR.\n\n        let mut temp = [0u8; 4];\n        temp.copy_from_slice(&w[4 * (i - 1)..4 * (i - 1) + 4]);\n\n        if i % NK == 0 {\n            // RotWord (which in the C code is _mm_shuffle_epi32(temp, _MM_SHUFFLE(3,0,1,2)))\n            // _MM_SHUFFLE(3, 0, 1, 2) means the 32-bit lanes of the result are\n            // arranged as [src[2], src[1], src[0], src[3]].\n            // We only care about the first 32-bit lane, which becomes src[2].\n            //\n            // Let's load temp as a full 16-byte block to mirror the C semantics.\n            let mut temp_full = [0u8; 16];\n            // Read up to 16 bytes from w starting at 4*(i-1). For positions near\n            // t