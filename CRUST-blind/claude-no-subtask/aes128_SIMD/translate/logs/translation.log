xt iteration\n        // overwrites w[4*(i+4)..] = w[4i+16..]. The intermediate bytes w[4i+4..4i+16]\n        // get overwritten in subsequent iterations. So the only bytes that\n        // permanently remain are w[4i..4i+4].\n        //\n        // Therefore, we can implement this as a simple 4-byte word XOR.\n\n        let mut temp = [0u8; 4];\n        temp.copy_from_slice(&w[4 * (i - 1)..4 * (i - 1) + 4]);\n\n        if i % NK == 0 {\n            // RotWord (which in the C code is _mm_shuffle_epi32(temp, _MM_SHUFFLE(3,0,1,2)))\n            // _MM_SHUFFLE(3, 0, 1, 2) means the 32-bit lanes of the result are\n            // arranged as [src[2], src[1], src[0], src[3]].\n            // We only care about the first 32-bit lane, which becomes src[2].\n            //\n            // Let's load temp as a full 16-byte block to mirror the C semantics.\n            let mut temp_full = [0u8; 16];\n            // Read up to 16 bytes from w starting at 4*(i-1). For positions near\n            // the end of w, we'd be reading beyond the buffer in the C code (UB),\n            // but in practice we only need lanes 0..3 for the algorithm.\n            let start = 4 * (i - 1);\n            let end = (start + 16).min(w.len());\n            temp_full[0..end - start].copy_from_slice(&w[start..end]);\n\n            // After shuffle, lane 0 = old lane 2 (bytes 8..12 of temp_full).\n            let mut shuffled = [0u8; 16];\n            shuffled[0..4].copy_from_slice(&temp_full[8..12]);\n            shuffled[4..8].copy_from_slice(&temp_full[4..8]);\n            shuffled[8..12].copy_from_slice(&temp_full[0..4]);\n            shuffled[12..16].copy_from_slice(&temp_full[12..16]);\n\n            // SubWord on the first 4 bytes\n            for j in 0..4 {\n                shuffled[j] = SBOX[shuffled[j] as usize];\n            }\n            // XOR Rcon\n            shuffled[0] ^= RCON[i / NK];\n\n            temp.copy_from_slice(&shuffled[0..4]);\n        } else if NK > 6 && (i % NK == 4) 