\t    return vector_back_or_null(lex_process->token_vec);\n71\t}\n72\t\n73\tstatic struct token *handle_whitespace()\n74\t{\n75\t    struct token *last_token = lexer_last_token();\n76\t    if (last_token)\n77\t    {\n78\t        last_token->whitespace = true;\n79\t    }\n80\t    nextc();\n81\t    return read_next_token();\n82\t}\n83\t\n84\tconst char *read_number_str()\n85\t{\n86\t    const char *num = NULL;\n87\t    struct buffer *buffer = buffer_create();\n88\t    char c = peekc();\n89\t\n90\t    LEX_GETC_IF(buffer, c, (c >= '0' && c <= '9'))\n91\t\n92\t    buffer_write(buffer, 0x00);\n93\t    return buffer_ptr(buffer);\n94\t}\n95\t\n96\tunsigned long long read_number()\n97\t{\n98\t    const char *s = read_number_str();\n99\t    return atoll(s);\n100\t}\n101\t\n102\t int lexer_number_type(char c)\n103\t {\n104\t    int res = NUMBER_TYPE_NORMAL;\n105\t    if(c == 'L')\n106\t        res = NUMBER_TYPE_LONG;\n107\t    else if (c == 'f')\n108\t        res = NUMBER_TYPE_FLOAT;\n109\t    return res;\n110\t }\n111\tstruct token *token_make_number_for_value(unsigned long number)\n112\t{\n113\t    int number_type = lexer_number_type(peekc());\n114\t    if(number_type != NUMBER_TYPE_NORMAL)\n115\t    {\n116\t        nextc();\n117\t    }\n118\t    return token_create(&(struct token){.type = TOKEN_TYPE_NUMBER, .llnum = number,.num.type=number_type});\n119\t}\n120\t\n121\tstruct token *token_make_number()\n122\t{\n123\t    return token_make_number_for_value(read_number());\n124\t}\n125\t\n126\tstruct token *token_make_string(char start_delim, char end_delim)\n127\t{\n128\t    struct buffer *buf = buffer_create();\n129\t    assert(nextc() == start_delim);\n130\t    char c = nextc();\n131\t    for (; c != end_delim && c != EOF; c = nextc())\n132\t    {\n133\t        if (c == '\\\\')\n134\t        {\n135\t            continue;\n136\t        }\n137\t        buffer_write(buf, c);\n138\t    }\n139\t    buffer_write(buf, 0x00);\n140\t    return token_create(&(struct token){.type = TOKEN_TYPE_STRING, .sval = buffer_ptr(buf)});\n141\t}\n142\t\n143\tstatic bool op_treated_as_one(char op)\n144\t{\n145\t    return op == '(' || op == '[' || op == ',' || op == '.' || op == '*' || op == '?';\n146\t}\n147\t\n148\tstatic bool is_single_operator(char op)\n149\t{\n150\t    return op == '+' || op == '-' || op == '/' || op == '*' || op == '=' ||\n151\t           op == '>' || op == '<' || op == '|' || op == '&' || op == '^' ||\n152\t           op == '%' || op == '~' || op == '!' || op == '(' || op == '[' ||\n153\t           op == ',' || op == '.' || op == '?';\n154\t}\n155\t\n156\tbool op_valid(char *op)\n157\t{\n158\t    return S_EQ(op, \"+\") ||\n159\t           S_EQ(op, \"-\") ||\n160\t           S_EQ(op, \"*\") ||\n161\t           S_EQ(op, \"/\") ||\n162\t           S_EQ(op, \"!\") ||\n163\t           S_EQ(op, \"^\") ||\n164\t           S_EQ(op, \"+=\") ||\n165\t           S_EQ(op, \"-=\") ||\n166\t           S_EQ(op, \"*=\") ||\n167\t           S_EQ(op, \"/=\") ||\n168\t           S_EQ(op, \">>\") ||\n169\t           S_EQ(op, \"<<\") ||\n170\t           S_EQ(op, \">=\") ||\n171\t           S_EQ(op, \"<=\") ||\n172\t           S_EQ(op, \">\") ||\n173\t           S_EQ(op, \"<\") ||\n174\t           S_EQ(op, \"||\") ||\n175\t           S_EQ(op, \"&&\") ||\n176\t           S_EQ(op, \"|\") ||\n177\t           S_EQ(op, \"&\") ||\n178\t           S_EQ(op, \"++\") ||\n179\t           S_EQ(op, \"--\") ||\n180\t           S_EQ(op, \"= \") ||\n181\t           S_EQ(op, \"!=\") ||\n182\t           S_EQ(op, \"==\") ||\n183\t           S_EQ(op, \"->\") ||\n184\t           S_EQ(op, \"(\") ||\n185\t           S_EQ(op, \"[\") ||\n186\t           S_EQ(op, \",\") ||\n187\t           S_EQ(op, \".\") ||\n188\t           S_EQ(op, \"...\") ||\n189\t           S_EQ(op, \"~\") ||\n190\t           S_EQ(op, \"?\") ||\n191\t           S_EQ(op, \"%\");\n192\t}\n193\t\n194\tvoid read_op_flush_back_keep_first(struct buffer *buffer)\n195\t{\n196\t    //+*\n197\t    const char *data = buffer_ptr(buffer);\n198\t    int len = buffer->len;\n199\t    for (int i = len - 1; i >= 1; i--)\n200\t    {\n201\t        if (data[i] == 0x00)\n202\t        {\n203\t            continue;\n204\t        }\n205\t\n206\t        pushc(data[i]); // * is pushed back and only + remains\n207\t    }\n208\t}\n209\tconst char *read_op()\n210\t{\n211\t    bool single_operator = true; // eg : ++\n212\t    char op = nextc();           // +\n213\t    struct buffer *buffer = buffer_create();\n214\t    buffer_write(buffer, op); //=+\n215\t\n216\t    if (!op_treated_as_one(op))\n217\t    {\n218\t        op = peekc(); // 2nd +\n219\t        if (is_single_operator(op))\n220\t        {\n221\t            buffer_write(buffer, op); // =++\n222\t            nextc();                  // after 2nd +\n223\t            single_operator = false;\n224\t        }\n225\t    }\n226\t    buffer_write(buffer, 0x00);\n227\t    char *ptr = buffer_ptr(buffer);\n228\t\n229\t    // check if its valid like ++ and its not like +-\n230\t    if (!single_operator)\n231\t    {\n232\t        if (!op_valid(ptr))\n233\t        {\n234\t            read_op_flush_back_keep_first(buffer);\n235\t            ptr[1] = 0x00;\n236\t        }\n237\t    }\n238\t    else if (!op_valid)\n239\t    {\n240\t        compiler_error(lex_process->compiler, \"The operator %s is not valid\\n\", ptr);\n241\t    }\n242\t}\n243\t\n244\tstatic void lex_new_expression()\n245\t{\n246\t    lex_process->current_expression_count++;\n247\t    if (lex_process->current_expression_count == 1)\n248\t    {\n249\t        lex_process->parentheses_buffer = buffer_create();\n250\t    }\n251\t}\n252\t\n253\tstatic void lex_finish_expression()\n254\t{\n255\t    lex_process->current_expression_count--;\n256\t    if (lex_process->current_expression_count < 0)\n257\t    {\n258\t        compiler_error(lex_process->compiler, \"You closed an expression that you never opened\\n\");\n259\t    }\n260\t}\n261\t\n262\tbool lex_is_in_expression()\n263\t{\n264\t    return lex_process->current_expression_count > 0;\n265\t}\n266\t\n267\tbool is_keyword(const char *str)\n268\t{\n269\t    return S_EQ(str, \"auto\") ||\n270\t           S_EQ(str, \"break\") ||\n271\t           S_EQ(str, \"case\") ||\n272\t           S_EQ(str, \"char\") ||\n273\t           S_EQ(str, \"const\") ||\n274\t           S_EQ(str, \"continue\") ||\n275\t           S_EQ(str, \"default\") ||\n276\t           S_EQ(str, \"do\") ||\n277\t           S_EQ(str, \"double\") ||\n278\t           S_EQ(str, \"else\") ||\n279\t           S_EQ(str, \"enum\") ||\n280\t           S_EQ(str, \"extern\") ||\n281\t           S_EQ(str, \"float\") ||\n282\t           S_EQ(str, \"for\") ||\n283\t           S_EQ(str, \"goto\") ||\n284\t           S_EQ(str, \"if\") ||\n285\t           S_EQ(str, \"inline\") ||\n286\t           S_EQ(str, \"int\") ||\n287\t           S_EQ(str, \"long\") ||\n288\t           S_EQ(str, \"register\") ||\n289\t           S_EQ(str, \"restrict\") ||\n290\t           S_EQ(str, \"return\") ||\n291\t           S_EQ(str, \"short\") ||\n292\t           S_EQ(str, \"signed\") ||\n293\t           S_EQ(str, \"sizeof\") ||\n294\t           S_EQ(str, \"static\") ||\n295\t           S_EQ(str, \"struct\") ||\n296\t           S_EQ(str, \"switch\") ||\n297\t           S_EQ(str, \"typedef\") ||\n298\t           S_EQ(str, \"union\") ||\n299\t           S_EQ(str, \"unsigned\") ||\n300\t           S_EQ(str, \"void\") ||\n301\t           S_EQ(str, \"volatile\") ||\n302\t           S_EQ(str, \"while\") ||\n303\t           S_EQ(str, \"_Alignas\") ||\n304\t           S_EQ(str, \"_Alignof\") ||\n305\t           S_EQ(str, \"_Atomic\") ||\n306\t           S_EQ(str, \"_Bool\") ||\n307\t           S_EQ(str, \"_Complex\") ||\n308\t           S_EQ(str, \"_Generic\") ||\n309\t           S_EQ(str, \"_Imaginary\") ||\n310\t           S_EQ(str, \"_Noreturn\") ||\n311\t           S_EQ(str, \"_Static_assert\") ||\n312\t           S_EQ(str, \"_Thread_local\") ||\n313\t           S_EQ(str,\"__ignore_typecheck\");\n314\t}\n315\tstatic struct token *token_make_operator_or_string()\n316\t{\n317\t    char op = peekc();\n318\t    if (op == '<') // <stdio.h>\n319\t    {\n320\t        struct token *last_token = lexer_last_token();\n321\t        if (token_is_keyword(last_token, \"include\"))\n322\t        {\n323\t            return token_make_string('<', '>');\n324\t        }\n325\t    }\n326\t    struct token *token = token_create(&(struct token){.type = TOKEN_TYPE_OPERATOR, .sval = read_op()});\n327\t    if (op == '(')\n328\t    {\n329\t        lex_new_expression();\n330\t    }\n331\t\n332\t    return token;\n333\t}\n334\t\n335\tstatic struct token *token_make_symbol()\n336\t{\n337\t    char c = nextc();\n338\t    if (c == ')')\n339\t    {\n340\t        lex_finish_expression();\n341\t    }\n342\t\n343\t    struct token *token = token_create(&(struct token){.type = TOKEN_TYPE_SYMBOL, .cval = c});\n344\t    return token;\n345\t}\n346\t\n347\tstatic struct token *token_make_identifier_or_keyword()\n348\t{\n349\t    struct buffer *buffer = buffer_create();\n350\t    char c = 0;\n351\t    LEX_GETC_IF(buffer, c, (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_');\n352\t\n353\t    buffer_write(buffer, 0x00);\n354\t\n355\t    // check if keyword\n356\t    if(is_keyword(buffer_ptr(buffer)))\n357\t    {\n358\t        return token_create(&(struct token){.type=TOKEN_TYPE_KEYWORD,.sval=buffer_ptr(buffer)});\n359\t    }\n360\t    return token_create(&(struct token){.type = TOKEN_TYPE_IDENTIFIER, .sval = buffer_ptr(buffer)});\n361\t}\n362\t\n363\tstruct token *read_special_token()\n364\t{\n365\t    char c = peekc();\n366\t    if (isalpha(c) || c == '_')\n367\t    {\n368\t        return token_make_identifier_or_keyword();\n369\t    }\n370\t\n371\t    return NULL;\n372\t}\n373\t\n374\tstruct token* token_make_newline()\n375\t{\n376\t    nextc();\n377\t    return token_create(&(struct token){.type=TOKEN_TYPE_NEWLINE});\n378\t}\n379\t\n380\tstruct token* token_make_one_line_comment()\n381\t{\n382\t    struct buffer* buffer=buffer_create();\n383\t    char c=0;\n384\t    LEX_GETC_IF(buffer,c,(c!='\\n' && c!=EOF));\n385\t\n386\t    return token_create(&(struct token){.type=TOKEN_TYPE_COMMENT});\n387\t}\n388\t\n389\tstruct token* token_make_multiline_comment()\n390\t{\n391\t    struct buffer* buffer=buffer_create();\n392\t    char c=0;\n393\t    while (1)\n394\t    {\n395\t        LEX_GETC_IF(buffer,c,(c!='*' && c!=EOF));\n396\t        if(c==EOF)\n397\t        {\n398\t            compiler_error(lex_process->compiler,\"You did not close this multiline comment\\n\");\n399\t        }\n400\t        else if(c=='*')\n401\t        {\n402\t            nextc();\n403\t            if(peekc()=='/')\n404\t            {\n405\t                nextc();\n406\t                break; \n407\t            }\n408\t        }\n409\t    }\n410\t    return token_create(&(struct token){.type=TOKEN_TYPE_COMMENT,.sval=buffer_ptr(buffer)});\n411\t}\n412\t\n413\tstruct token* handle_comment()\n414\t{\n415\t    char c = peekc();\n416\t    if(c == '/')\n417\t    {\n418\t        nextc();\n419\t        if(peekc() == '/')\n420\t        {\n421\t            nextc();\n422\t            return token_make_one_line_comment();\n423\t        }\n424\t        else if(peekc() == '*')\n425\t        {\n426\t            nextc();\n427\t            return token_make_multiline_comment();\n428\t        }\n429\t        pushc('/');\n430\t        return token_make_operator_or_string();\n431\t    }\n432\t    return NULL;\n433\t}\n434\tchar lex_get_escaped_char(char c)\n435\t{\n436\t    char co = 0;\n437\t    switch (c)\n438\t    {\n439\t    case 'n':\n440\t        co = '\\n';\n441\t        break;\n442\t    \n443\t    case '\\\\':\n444\t        co = '\\\\';\n445\t        break;\n446\t    \n447\t    case 't':\n448\t        co = '\\t';\n449\t        break;\n450\t    \n451\t    case 'b':\n452\t        co = '\\b';\n453\t        break;\n454\t\n455\t    case '\\'':\n456\t        co = '\\'';\n457\t        break;\n458\t    }\n459\t    return co;\n460\t}\n461\t\n462\tvoid lexer_pop_token()\n463\t{\n464\t    vector_pop(lex_process->token_vec);\n465\t}\n466\t\n467\tbool is_hex_char(char c)\n468\t{\n469\t     c = tolower(c);\n470\t    return (c>='0' && c<='9') || (c>='a' && c<='f');\n471\t}\n472\t\n473\tconst char* read_hex_number_str()\n474\t{\n475\t    struct buffer* buffer = buffer_create();\n476\t    char c = peekc(); \n477\t    LEX_GETC_IF(buffer,c,is_hex_char(c));\n478\t    buffer_write(buffer,0x00);\n479\t    return buffer_ptr(buffer);\n480\t}\n481\t\n482\tstruct token* token_make_special_number_hexadecimal()\n483\t{\n484\t    //skip the x\n485\t    nextc();\n486\t    unsigned long number = 0;\n487\t    const char* number_str = read_hex_number_str();\n488\t    number = strtol(number_str,0,16);\n489\t    return token_make_number_for_value(number);\n490\t}\n491\t\n492\tvoid lexer_validate_binary_string(const char* str)\n493\t{\n494\t    size_t len = strlen(str);\n495\t    for(int i=0;i<len;i++)\n496\t    {\n497\t        if(str[i]!='0' && str[i]!='1')\n498\t        {\n499\t            compiler_error(lex_process->compiler,\"Invalid Binary number\\n\");\n500\t        }\n501\t    }\n502\t}\n503\tstruct token* token_make_special_number_binary()\n504\t{\n505\t    //skip the b\n506\t    nextc();\n507\t    unsigned long number = 0;\n508\t    const char* number_str = read_number_str();\n509\t    lexer_validate_binary_string(number_str);\n510\t    number = strtol(number_str,0,2);\n511\t\n512\t    return token_make_number_for_value(number);\n513\t}\n514\tstruct token* token_make_special_number()\n515\t{\n516\t     struct token* token =NULL;\n517\t     struct token* last_token = lexer_last_token(); \n518\t    if(!last_token || !(last_token->type=TOKEN_TYPE_NUMBER && last_token->llnum == 0))\n519\t    {\n520\t        return token_make_identifier_or_keyword();\n521\t    }\n522\t     lexer_pop_token();\n523\t     char c = peekc();\n524\t     if(c == 'x')\n525\t     {\n526\t        token = token_make_special_number_hexadecimal();\n527\t     }\n528\t     else if(c == 'b')\n529\t     {\n530\t        token = token_make_special_number_binary();\n531\t     }\n532\t\n533\t     return token;\n534\t}\n535\tstruct token* token_make_quote()\n536\t{\n537\t     assert_next_char('\\'');\n538\t    char c = nextc();\n539\t    if(c=='\\\\')\n540\t    {\n541\t        c = nextc();\n542\t        c = lex_get_escaped_char(c);\n543\t    }\n544\t\n545\t    if(nextc()!='\\'')\n546\t    {\n547\t        compiler_error(lex_process->compiler,\"You opened a quote ' but did not close it\\n\");\n548\t    }\n549\t\n550\t    return token_create(&(struct token){.type=TOKEN_TYPE_NUMBER,.cval=c});\n551\t}\n552\t\n553\tstruct token *read_next_token()\n554\t{\n555\t    struct token *token = NULL;\n556\t    char c = peekc();\n557\t    // printf(\"Read character: '%c'\\n\", c);\n558\t\n559\t    token = handle_comment();\n560\t    if(token)\n561\t    {\n562\t        return token;\n563\t    }\n564\t    switch (c)\n565\t    {\n566\t    NUMERIC_CASE:\n567\t        token = token_make_number();\n568\t        break;\n569\t\n570\t    OPERATOR_CASE_EXCLUDING_DIVISION:\n571\t        token = token_make_operator_or_string();\n572\t        break;\n573\t\n574\t    SYMBOL_CASE:\n575\t        token = token_make_symbol();\n576\t        break;\n577\t\n578\t    case 'b':\n579\t        token = token_make_special_number();\n580\t        break;\n581\t\n582\t    case 'x':\n583\t        token = token_make_special_number();\n584\t        break;\n585\t\n586\t    case '\\'':\n587\t        token = token_make_quote();\n588\t        break;\n589\t    \n590\t    case '\"':\n591\t        token = token_make_string('\"', '\"');\n592\t        break;\n593\t    \n594\t    case ' ':\n595\t    case '\\t':\n596\t        token = handle_whitespace();\n597\t        break;\n598\t\n599\t    case '\\n':\n600\t        token = token_make_newline();\n601\t        break;\n602\t    case '$':\n603\t        // we have finished  lexical analysis on the file\n604\t        break;\n605\t\n606\t    default:\n607\t        token = read_special_token();\n608\t        if (!token)\n609\t            compiler_error(lex_process->compiler, \"Unexpected token\\n\");\n610\t    }\n611\t\n612\t    return token;\n613\t}\n614\tint lex(struct lex_process *process)\n615\t{\n616\t    process->current_expression_count = 0;\n617\t    process->parentheses_buffer = NULL;\n618\t    lex_process = process;\n619\t    process->pos.filename = process->compiler->cfile.abs_path;\n620\t\n621\t    struct token *token = read_next_token();\n622\t    while (token)\n623\t    {\n624\t        vector_push(process->token_vec, token);\n625\t        token = read_next_token();\n626\t    }\n627\t    return LEXICAL_ANALYSIS_ALL_OK;\n628\t}\n629\t\n630\tchar lexer_string_buffer_next_char(struct lex_process* process)\n631\t{\n632\t    struct buffer* buf = lex_process_private(process);\n633\t    return buffer_read(buf);\n634\t}\n635\t\n636\tchar lexer_string_buffer_peek_char(struct lex_process* process)\n637\t{\n638\t    struct buffer* buf = lex_process_private(process);\n639\t    return buffer_peek(buf);\n640\t}\n641\t\n642\tvoid lexer_string_buffer_push_char(struct lex_process* process,char c)\n643\t{\n644\t    struct buffer* buf = lex_process_private(process);\n645\t    buffer_write(buf,c);\n646\t}\n647\t\n648\tstruct lex_process_functions lexer_string_buffer_functions = {\n649\t    .next_char = lexer_string_buffer_next_char,\n650\t    .peek_char = lexer_string_buffer_peek_char,\n651\t    .push_char = lexer_string_buffer_push_char\n652\t};\n653\t// build token for input string\n654\tstruct lex_process* tokens_build_for_string(struct compile_process* compiler,const char* str)\n655\t{\n656\t    struct buffer* buffer = buffer_create();\n657\t    buffer_printf(buffer,str);\n658\t    struct lex_process* lex_process = lex_process_create(compiler,&lexer_string_buffer_functions,buffer);\n659\t    if(!lex_process)\n660\t    {\n661\t