es_to_move = vector_elements_until_end(vector, index) * vector->esize;\n288\t    memcpy(vector_at(vector, eindex), vector_at(vector, index), bytes_to_move);\n289\t    memset(vector_at(vector, index), 0x00, amount * vector->esize);\n290\t}\n291\t\n292\tvoid vector_shift_right_in_bounds(struct vector *vector, int index, int amount)\n293\t{\n294\t    vector_shift_right_in_bounds_no_increment(vector, index, amount);\n295\t    vector->rindex += amount;\n296\t    vector->count += amount;\n297\t}\n298\t\n299\tvoid vector_stretch(struct vector *vector, int index)\n300\t{\n301\t    if (index < vector->rindex)\n302\t        return;\n303\t\n304\t    vector_resize_for_index(vector, index, 0);\n305\t    vector->count = index;\n306\t    vector->rindex = index;\n307\t}\n308\t\n309\tint vector_pop_value(struct vector* vector, void* val)\n310\t{\n311\t    int old_pp = vector->pindex;\n312\t    vector_set_peek_pointer(vector, 0);\n313\t    void* ptr = vector_peek_ptr(vector);\n314\t    int index = 0;\n315\t    while(ptr)\n316\t    {\n317\t        if (ptr == val)\n318\t        {\n319\t            vector_pop_at(vector, index);\n320\t            break;\n321\t        }\n322\t        ptr = vector_peek_ptr(vector);\n323\t        index++;\n324\t    }\n325\t\n326\t    vector_set_peek_pointer(vector, old_pp);\n327\t}\n328\t\n329\tint vector_pop_at_data_address(struct vector *vector, void *address)\n330\t{\n331\t    int index = (address - vector->data) / vector->esize;\n332\t    vector_pop_at(vector, index);\n333\t    return index;\n334\t}\n335\t\n336\tvoid vector_shift_right(struct vector *vector, int index, int amount)\n337\t{\n338\t    if (index < vector->rindex)\n339\t    {\n340\t        vector_shift_right_in_bounds(vector, index, amount);\n341\t        return;\n342\t    }\n343\t\n344\t    // We don't need to shift anything because we are out of bounds\n345\t    // lets stretch the vector up to index+amount\n346\t    vector_stretch(vector, index + amount);\n347\t    vector_shift_right_in_bounds_no_increment(vector, index, amount);\n348\t}\n349\t\n350\tvoid vector_pop_at(struct vector *vector, int index)\n351\t{\n352\t    void *dst_pos = vector_at(vector, index);\n353\t    void *next_element_pos = dst_pos + vector->esize;\n354\t    void *end_pos = vector_data_end(vector);\n355\t    size_t total = (size_t)end_pos - (size_t)next_element_pos;\n356\t    memcpy(dst_pos, next_element_pos, total);\n357\t    vector->count -= 1;\n358\t    vector->rindex -= 1;\n359\t}\n360\t\n361\tvoid vector_peek_pop(struct vector *vector)\n362\t{\n363\t    // Popping at a peek is an akward one\n364\t    // we will need to shift all the elements to the left, annoying...\n365\t    // This will also invalidate any pointers pointing directly to the vector data\n366\t    vector_pop_at(vector, vector->pindex);\n367\t}\n368\t\n369\tvoid vector_push_multiple_at(struct vector *vector, int dst_index, void *ptr, int total)\n370\t{\n371\t    vector_shift_right(vector, dst_index, total);\n372\t    void *dst_ptr = vector_at(vector, dst_index);\n373\t    size_t total_bytes = total * vector->esize;\n374\t    memcpy(dst_ptr, ptr, total_bytes);\n375\t}\n376\t\n377\tvoid vector_push_at(struct vector *vector, int index, void *ptr)\n378\t{\n379\t    vector_shift_right(vector, index, 1);\n380\t\n381\t    void *data_ptr = vector_at(vector, index);\n382\t    memcpy(data_ptr, ptr, vector->esize);\n383\t}\n384\t\n385\tint vector_insert(struct vector *vector_dst, struct vector *vector_src, int dst_index)\n386\t{\n387\t    if (vector_dst->esize != vector_src->esize)\n388\t    {\n389\t        return -1;\n390\t    }\n391\t\n392\t    vector_push_multiple_at(vector_dst, dst_index, vector_at(vector_src, 0), vector_count(vector_src));\n393\t\n394\t    return 0;\n395\t}\n396\t\n397\tvoid vector_pop(struct vector *vector)\n398\t{\n399\t\n400\t    // Popping from the vector will just decrement the index, no need to free memory\n401\t    // the next push will overwrite it.\n402\t    vector->rindex -= 1;\n403\t   