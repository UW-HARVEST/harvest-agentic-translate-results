A, 0, sizeof(state_A));\n93\t    memset(&state_B, 0, sizeof(state_A));\n94\t}\n95\t\n96\tvoid tearDown(void)\n97\t{\n98\t}\n99\t\n100\tvoid test_cfsm_version()\n101\t{\n102\t    TEST_ASSERT_EQUAL(0, CFSM_VER_MAJOR);\n103\t    TEST_ASSERT_EQUAL(2, CFSM_VER_MINOR);\n104\t    TEST_ASSERT_EQUAL(0, CFSM_VER_PATCH);\n105\t}\n106\t\n107\tvoid test_cfsm_init_should_clear_handler(void)\n108\t{\n109\t    memset(&fsmInstance, -1, sizeof(fsmInstance));  /* corrupt content */\n110\t\n111\t    cfsm_init(&fsmInstance, &dummyInstanceData);\n112\t\n113\t    TEST_ASSERT_EQUAL_PTR(NULL, fsmInstance.onEvent);\n114\t    TEST_ASSERT_EQUAL_PTR(NULL, fsmInstance.onProcess);\n115\t    TEST_ASSERT_EQUAL_PTR(NULL, fsmInstance.onLeave);\n116\t\n117\t    TEST_ASSERT_EQUAL_PTR(&dummyInstanceData, fsmInstance.ctxPtr);\n118\t\n119\t}\n120\t\n121\tvoid test_cfsm_init_is_safe_to_use(void)\n122\t{\n123\t    cfsm_init(&fsmInstance, NULL);\n124\t\n125\t    /* should not crash */\n126\t    cfsm_process(&fsmInstance);\n127\t    cfsm_event(&fsmInstance, 0x12345678);\n128\t}\n129\t\n130\tvoid test_cfsm_transition_should_set_enter_handler_only(void)\n131\t{\n132\t    cfsm_transition(&fsmInstance, State_only_onEnter);\n133\t    TEST_ASSERT_EQUAL_PTR(fsmInstance.onEvent, NULL);\n134\t    TEST_ASSERT_EQUAL_PTR(fsmInstance.onProcess, NULL);\n135\t    TEST_ASSERT_EQUAL_PTR(fsmInstance.onLeave, NULL);\n136\t}\n137\t\n138\tvoid test_cfs_process()\n139\t{\n140\t    cfsm_transition(&fsmInstance, State_A_onEnter);\n141\t\n142\t    TEST_ASSERT_EQUAL_INT(state_A.enterCalls, 1);\n143\t    TEST_ASSERT_EQUAL_INT(state_A.leaveCalls, 0);\n144\t    TEST_ASSERT_EQUAL_INT(state_A.processCalls, 0);\n145\t    TEST_ASSERT_EQUAL_INT(state_A.eventCalls, 0);\n146\t    TEST_ASSERT_EQUAL_INT(state_A.lastEventId, 0);\n147\t\n148\t    for (int i = 0; i < 10; ++i)\n149\t    {\n150\t        cfsm_process(&fsmInstance);\n151\t        TEST_ASSERT_EQUAL_INT(state_A.lastEventId, i);\n152\t    }\n153\t    TEST_ASSERT_EQUAL_INT(state_A.enterCall