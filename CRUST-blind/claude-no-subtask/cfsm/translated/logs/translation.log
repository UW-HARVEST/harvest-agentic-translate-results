ocess = State_A_onProcess;\n254\t\n255\t    state_A.enterCalls++;\n256\t}\n257\t\n258\tstatic void State_A_onEvent(cfsm_Ctx * fsm, int eventId)\n259\t{\n260\t    (void)fsm;\n261\t    (void)eventId;\n262\t\n263\t    state_A.eventCalls++;\n264\t}\n265\t\n266\tstatic void State_A_onProcess(cfsm_Ctx * fsm)\n267\t{\n268\t    (void)fsm;\n269\t\n270\t    state_A.processCalls++;\n271\t}\n272\t\n273\tstatic void State_A_onLeave(cfsm_Ctx * fsm)\n274\t{\n275\t    (void)fsm;\n276\t\n277\t    state_A.leaveCalls++;\n278\t}\n279\t\n280\tstatic void State_B_onEnter(cfsm_Ctx * fsm)\n281\t{\n282\t    fsm->onEvent = State_B_onEvent;\n283\t    fsm->onLeave = State_B_onLeave;\n284\t    fsm->onProcess = State_B_onProcess;\n285\t    state_B.enterCalls++;\n286\t}\n287\t\n288\tstatic void State_B_onEvent(cfsm_Ctx * fsm, int eventId)\n289\t{\n290\t    (void)fsm;\n291\t    (void)eventId;\n292\t\n293\t    state_B.eventCalls++;\n294\t}\n295\t\n296\tstatic void State_B_onProcess(cfsm_Ctx * fsm)\n297\t{\n298\t    (void)fsm;\n299\t\n300\t    state_B.processCalls++;\n301\t}\n302\t\n303\tstatic void State_B_onLeave(cfsm_Ctx * fsm)\n304\t{\n305\t    (void)fsm;\n306\t\n307\t    state_B.leaveCalls++;\n308\t}\n309\t"}]},"parent_tool_use_id":null,"session_id":"0c67fec2-a74a-4742-9ef3-5eee74b01fc6","uuid":"afacd793-a75b-4e66-a24a-71399ef6a0c1","timestamp":"2026-06-06T04:13:04.682Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-raOhRy/project/c_src/tests/test_c_fsm.c","content":"/* MIT License\n *\n * Copyright (C) 2024  Haju Schulz <haju@schulznorbert.de>\n *\n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished 