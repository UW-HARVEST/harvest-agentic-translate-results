   bytes.extend_from_slice(&w.to_le_bytes());\n    }\n    bytes\n}\n\npub struct ClHasher {\n    random_data: Vec<u8>,\n}\n\nimpl ClHasher {\n    pub fn new(seed1: u64, seed2: u64) -> Self {\n        ClHasher {\n            random_data: get_random_key_for_clhash(seed1, seed2),\n        }\n    }\n    pub fn hash<T: AsRef<[u8]>>(&self, data: T) -> u64 {\n        clhash(&self.random_data, data.as_ref())\n    }\n}\n\nimpl Drop for ClHasher {\n    fn drop(&mut self) {\n        // The Vec frees its own memory; nothing additional to do.\n        // Zeroize the buffer to mirror \"free\" disposal of secret key material.\n        for b in self.random_data.iter_mut() {\n            *b = 0;\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2732,"cache_read_input_tokens":30053,"cache_creation":{"ephemeral_5m_input_tokens":2732,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"63b04ea6-dddc-4f2d-9828-a7746dea5f15","uuid":"32a18b3a-edfc-4019-a7cc-79d8214f1f79"}
