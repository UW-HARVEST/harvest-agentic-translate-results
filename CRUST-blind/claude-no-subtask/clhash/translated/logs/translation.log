12 = _mm_clmulepi64_si128(add12, add12, 0x10);\n162\t        acc = _mm_xor_si128(clprod12, acc);\n163\t    }\n164\t    if (string + 1 < endstring) {\n165\t        if(CLHASH_DEBUG) assert(length != 128);\n166\t        const __m128i temp1 = _mm_load_si128(randomsource);\n167\t        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n168\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n169\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n170\t        acc = _mm_xor_si128(clprod1, acc);\n171\t        randomsource += 1;\n172\t        string += 2;\n173\t    }\n174\t    if (string < endstring) {\n175\t        if(CLHASH_DEBUG) assert(length != 128);\n176\t        const __m128i temp1 = _mm_load_si128(randomsource);\n177\t        const __m128i temp2 = _mm_loadl_epi64((__m128i const*)string);\n178\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n179\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n180\t        acc = _mm_xor_si128(clprod1, acc);\n181\t        if(CLHASH_DEBUG) ++string;\n182\t    }\n183\t    if(CLHASH_DEBUG) assert(string == endstring);\n184\t    return acc;\n185\t}\n186\t// the value length does not have to be divisible by 4\n187\tstatic __m128i __clmulhalfscalarproductwithtailwithoutreductionWithExtraWord(const __m128i * randomsource,\n188\t        const uint64_t * string, const size_t length, const uint64_t extraword) {\n189\t    assert(((uintptr_t) randomsource & 15) == 0);// we expect cache line alignment for the keys\n190\t    const uint64_t * const endstring = string + length;\n191\t    __m128i acc = _mm_setzero_si128();\n192\t    for (; string + 3 < endstring; randomsource += 2, string += 4) {\n193\t        const __m128i temp1 = _mm_load_si128(randomsource);\n194\t        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n195\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n196\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n197\t        acc = _mm_xor_si128(clprod1, acc);\n198\t        const __m128i temp12 = _mm_load_si128(randomsource+1);\n199\t        const __m128i temp22 = _mm_lddqu_si128((__m128i *) (string + 2));\n200\t        const __m128i add12 = _mm_xor_si128(temp12, temp22);\n201\t        const __m128i clprod12 = _mm_clmulepi64_si128(add12, add12, 0x10);\n202\t        acc = _mm_xor_si128(clprod12, acc);\n203\t    }\n204\t    if (string + 1 < endstring) {\n205\t        const __m128i temp1 = _mm_load_si128(randomsource);\n206\t        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n207\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n208\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n209\t        acc = _mm_xor_si128(clprod1, acc);\n210\t        randomsource += 1;\n211\t        string += 2;\n212\t    }\n213\t    // we have to append an extra 1\n214\t    if (string < endstring) {\n215\t        const __m128i temp1 = _mm_load_si128(randomsource);\n216\t        const __m128i temp2 = _mm_set_epi64x(extraword,*string);\n217\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n218\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n219\t        acc = _mm_xor_si128(clprod1, acc);\n220\t    } else {\n221\t        const __m128i temp1 = _mm_load_si128(randomsource);\n222\t        const __m128i temp2 = _mm_loadl_epi64((__m128i const*)&extraword);\n223\t        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n224\t        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x01);\n225\t        acc = _mm_xor_si128(clprod1, acc);\n226\t    }\n227\t    return acc;\n228\t}\n229\t\n230\t\n231\tstatic __m128i __clmulhalfscalarproductOnlyExtraWord(const __m128i * randomsource,\n232\t        const uint64_t extraword) {\n233\t    const __m128i temp1 = _mm_load_si128(randomsource);\n234\t    const __m128i temp2 = _mm_loadl_epi64((__m128i const*)&extraword);\n235\t    const __m128i add1 = _mm_xor_si128(temp1, temp2);\n236\t    const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x01);\n237\t    return clprod1;\n238\t}\n239\t\n240\t\n241\t\n242\t\n243\t#ifdef BITMIX\n244\t////////\n245\t// an invertible function used to mix the bits\n246\t// borrowed directly from murmurhash\n247\t////////\n248\tinline uint64_t fmix64 ( uint64_t k ) {\n249\t    k ^= k >> 33;\n250\t    k *= 0xff51afd7ed558ccdULL;\n251\t    k ^= k >> 33;\n252\t    k *= 0xc4ceb9fe1a85ec53ULL;\n253\t    k ^= k >> 33;\n254\t    return k;\n255\t}\n256\t#endif\n257\t\n258\t\n259\t\n260\t// there always remain an incomplete word that has 1,2, 3, 4, 5, 6, 7 used bytes.\n261\t// we append 0s to it\n262\tstatic inline uint64_t createLastWord(const size_t lengthbyte, const uint64_t * lastw) {\n263\t    const int significantbytes = lengthbyte % sizeof(uint64_t);\n264\t    uint64_t lastword = 0;\n265\t    memcpy(&lastword,lastw,significantbytes); // could possibly be faster?\n266\t    return lastword;\n267\t}\n268\t\n269\t\n270\t\n271\t\n272\tuint64_t clhash(const void* random, const char * stringbyte,\n273\t                const size_t lengthbyte) {\n274\t    assert(sizeof(size_t)<=sizeof(uint64_t));// otherwise, we need to worry\n275\t    assert(((uintptr_t) random & 15) == 0);// we expect cache line alignment for the keys\n276\t    const unsigned int  m = 128;// we process the data in chunks of 16 cache lines\n277\t    if(CLHASH_DEBUG) assert((m  & 3) == 0); //m should be divisible by 4\n278\t    const int m128neededperblock = m / 2;// that is how many 128-bit words of random bits we use per block\n279\t    const __m128i * rs64 = (__m128i *) random;\n280\t    __m128i polyvalue =  _mm_load_si128(rs64 + m128neededperblock); // to preserve alignment on cache lines for main loop, we pick random bits at the end\n281\t    polyvalue = _mm_and_si128(polyvalue,_mm_setr_epi32(0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0x3fffffff));// setting two highest bits to zero\n282\t    // we should check that polyvalue is non-zero, though this is best done outside the function and highly unlikely\n283\t    const size_t length = lengthbyte / sizeof(uint64_t); // # of complete words\n284\t    const size_t lengthinc = (lengthbyte + sizeof(uint64_t) - 1) / sizeof(uint64_t); // # of words, including partial ones\n285\t\n286\t    const uint64_t * string = (const uint64_t *)  stringbyte;\n287\t    if (m < lengthinc) { // long strings // modified from length to lengthinc to address issue #3 raised by Eik List\n288\t        __m128i  acc =  __clmulhalfscalarproductwithoutreduction(rs64, string,m);\n289\t        size_t t = m;\n290\t        for (; t +  m <= length; t +=  m) {\n291\t            // we compute something like\n292\t            // acc+= polyvalue * acc + h1\n293\t            acc =  mul128by128to128_lazymod127(polyvalue,acc);\n294\t            const __m128i h1 =  __clmulhalfscalarproductwithoutreduction(rs64, string+t,m);\n295\t            acc = _mm_xor_si128(acc,h1);\n296\t        }\n297\t        const int remain = length - t;  // number of completely filled words\n298\t\n299\t        if (remain != 0) {\n300\t            // we compute something like\n301\t            // acc+= polyvalue * acc + h1\n302\t            acc = mul128by128to128_lazymod127(polyvalue, acc);\n303\t            if (lengthbyte % sizeof(uint64_t) == 0) {\n304\t                const __m128i h1 =\n305\t                    __clmulhalfscalarproductwithtailwithoutreduction(rs64,\n306\t                            string + t, remain);\n307\t                acc = _mm_xor_si128(acc, h1);\n308\t            } else {\n309\t                const uint64_t lastword = createLastWord(lengthbyte,\n310\t                                          (string + length));\n311\t                const __m128i h1 =\n312\t                    __clmulhalfscalarproductwithtailwithoutreductionWithExtraWord(\n313\t                        rs64, string + t, remain, lastword);\n314\t                acc = _mm_xor_si128(acc, h1);\n315\t            }\n316\t        } else if (lengthbyte % sizeof(uint64_t) != 0) {// added to address issue #2 raised by Eik List\n317\t            // there are no completely filled words left, but there is one partial word.\n318\t            acc = mul128by128to128_lazymod127(polyvalue, acc);\n319\t            const uint64_t lastword = createLastWord(lengthbyte, (string + length));\n320\t            const __m128i h1 = __clmulhalfscalarproductOnlyExtraWord( rs64, lastword);\n321\t            acc = _mm_xor_si128(acc, h1);\n322\t        }\n323\t\n324\t        const __m128i finalkey = _mm_load_si128(rs64 + m128neededperblock + 1);\n325\t        const uint64_t keylength = *(const uint64_t *)(rs64 + m128neededperblock + 2);\n326\t        return simple128to64hashwithlength(acc,finalkey,keylength, (uint64_t)lengthbyte);\n327\t    } else { // short strings\n328\t        if(lengthbyte % sizeof(uint64_t) == 0) {\n329\t            __m128i  acc = __clmulhalfscalarproductwithtailwithoutreduction(rs64, string, length);\n330\t            const uint64_t keylength = *(const uint64_t *)(rs64 + m128neededperblock + 2);\n331\t            acc = _mm_xor_si128(acc,lazyLengthHash(keylength, (uint64_t)lengthbyte));\n332\t#ifdef BITMIX\n333\t            return fmix64(precompReduction64(acc)) ;\n334\t#else\n335\t            return precompReduction64(acc) ;\n336\t#endif\n337\t        }\n338\t        const uint64_t lastword = createLastWord(lengthbyte, (string + length));\n339\t        __m128i acc = __clmulhalfscalarproductwithtailwithoutreductionWithExtraWord(\n340\t                          rs64, string, length, lastword);\n341\t        const uint64_t keylength =  *(const uint64_t *)(rs64 + m128neededperblock + 2);\n342\t        acc = _mm_xor_si128(acc,lazyLengthHash(keylength, (uint64_t)lengthbyte));\n343\t#ifdef BITMIX\n344\t        return fmix64(precompReduction64(acc)) ;\n345\t#else\n346\t        return precompReduction64(acc) ;\n347\t#endif\n348\t    }\n349\t}\n350\t\n351\t\n352\t/***************************\n353\t * Rest is optional random-number generation stuff\n354\t */\n355\t\n356\t\n357\t/* Keys for scalar xorshift128. Must be non-zero\n358\tThese are modified by xorshift128plus.\n359\t */\n360\tstruct xorshift128plus_key_s {\n361\t    uint64_t part1;\n362\t    uint64_t part2;\n363\t};\n364\t\n365\ttypedef struct xorshift128plus_key_s xorshift128plus_key_t;\n366\t\n367\t\n368\t\n369\t/**\n370\t*\n371\t* You can create a new key like so...\n372\t*   xorshift128plus_key_t mykey;\n373\t*   xorshift128plus_init(324, 4444,&mykey);\n374\t*\n375\t* or directly if you prefer:\n376\t*  xorshift128plus_key_t mykey = {.part1=324,.part2=4444}\n377\t*\n378\t*  Then you can generate random numbers like so...\n379\t*      xorshift128plus(&mykey);\n380\t* If your application is threaded, each thread should have its own\n381\t* key.\n382\t*\n383\t*\n384\t* The seeds (key1 and key2) should be non-zero. You are responsible for\n385\t* checking that they are non-zero.\n386\t*\n387\t*/\n388\tstatic inline void xorshift128plus_init(uint64_t key1, uint64_t key2, xorshift128plus_key_t *key) {\n389\t    key->part1 = key1;\n390\t    key->part2 = key2;\n391\t}\n392\t\n393\t\n394\t/*\n395\tReturn a new 64-bit random number\n396\t*/\n397\tuint64_t xorshift128plus(xorshift128plus_key_t * key) {\n398\t    uint64_t s1 = key->part1;\n399\t    const uint64_t s0 = key->part2;\n400\t    key->part1 = s0;\n401\t    s1 ^= s1 << 23; // a\n402\t    key->part2 = s1 ^ s0 ^ (s1 >> 18) ^ (s0 >> 5); // b, c\n403\t    return key->part2 + s0;\n404\t}\n405\t\n406\tvoid * get_random_key_for_clhash(uint64_t seed1, uint64_t seed2) {\n407\t    xorshift128plus_key_t k;\n408\t    xorshift128plus_init(seed1, seed2, &k);\n409\t    void * answer;\n410\t    if (posix_memalign(&answer, sizeof(__m128i),\n411\t                       RANDOM_BYTES_NEEDED_FOR_CLHASH)) {\n412\t        return NULL;\n413\t    }\n414\t    uint64_t * a64 = (uint64_t *) answer;\n415\t    for(uint32_t i = 0; i < RANDOM_64BITWORDS_NEEDED_FOR_CLHASH; ++i) {\n416\t        a64[i] =  xorshift128plus(&k);\n417\t    }\n418\t    while((a64[128]==0) && (a64[129]==1)) {\n419\t        a64[128] =  xorshift128plus(&k);\n420\t        a64[129] =  xorshift128plus(&k);\n421\t    }\n422\t    return answer;\n423\t\n424\t\n425\t}\n426\t\n427\t\n428\t\n429\t"}]},"parent_tool_use_id":null,"session_id":"63b04ea6-dddc-4f2d-9828-a7746dea5f15","uuid":"f552b077-c933-4461-8153-bb02d62b7060","timestamp":"2026-06-06T04:17:29.598Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-RVthCN/project/c_src/src/clhash.c","content":"#include \"include/clhash.h\"\n\n#include <assert.h>\n#include <string.h>\n#include <x86intrin.h>\n\n#ifdef __WIN32\n#define posix_memalign(p, a, s) (((*(p)) = _aligned_malloc((s), (a))), *(p) ?0 :errno)\n#endif\n\n\n\n// computes a << 1\nstatic inline __m128i leftshift1(__m128i a) {\n    const int x = 1;\n    __m128i u64shift =  _mm_slli_epi64(a,x);\n    __m128i topbits =  _mm_slli_si128(_mm_srli_epi64(a,64 - x),sizeof(uint64_t));\n    return _mm_or_si128(u64shift, topbits);\n}\n\n// computes a << 2\nstatic inline __m128i leftshift2(__m128i a) {\n    const int x = 2;\n    __m128i u64shift =  _mm_slli_epi64(a,x);\n    __m128i topbits =  _mm_slli_si128(_mm_srli_epi64(a,64 - x),sizeof(uint64_t));\n    return _mm_or_si128(u64shift, topbits);\n}\n\n//////////////////\n// compute the \"lazy\" modulo with 2^127 + 2 + 1, actually we compute the\n// modulo with (2^128 + 4 + 2) = 2 * (2^127 + 2 + 1) ,\n// though  (2^128 + 4 + 2) is not\n// irreducible, we have that\n//     (x mod (2^128 + 4 + 2)) mod (2^127 + 2 + 1) == x mod (2^127 + 2 + 1)\n// That's true because, in general ( x mod k y ) mod y = x mod y.\n//\n// Precondition:  given that Ahigh|Alow represents a 254-bit value\n//                  (two highest bits of Ahigh must be zero)\n//////////////////\nstatic inline __m128i lazymod127(__m128i Alow, __m128i Ahigh) {\n    ///////////////////////////////////////////////////\n    // CHECKING THE PRECONDITION:\n    // Important: we are assuming that the two highest bits of Ahigh\n    // are zero. This could be checked by adding a line such as this one:\n    // if(_mm_extract_epi64(Ahigh,1) >= (1ULL<<62)){printf(\"bug\\n\");abort();}\n    //                       (this assumes SSE4.1 support)\n    ///////////////////////////////////////////////////\n    // The answer is Alow XOR  (  Ahigh <<1 ) XOR (  Ahigh <<2 )\n    // This is correct because the two highest bits of Ahigh are\n    // assumed to be zero.\n    ///////////////////////////////////////////////////\n    // credit for simplified implementation : Jan Wassenberg\n    __m128i shift1 = leftshift1(Ahigh);\n    __m128i shift2 = leftshift2(Ahigh);\n    __m128i final =  _mm_xor_si128(_mm_xor_si128(Alow, shift1),shift2);\n    return final;\n}\n\n\n// multiplication with lazy reduction\n// assumes that the two highest bits of the 256-bit multiplication are zeros\n// returns a lazy reduction\nstatic inline  __m128i mul128by128to128_lazymod127( __m128i A, __m128i B) {\n    __m128i Amix1 = _mm_clmulepi64_si128(A,B,0x01);\n    __m128i Amix2 = _mm_clmulepi64_si128(A,B,0x10);\n    __m128i Alow = _mm_clmulepi64_si128(A,B,0x00);\n    __m128i Ahigh = _mm_clmulepi64_si128(A,B,0x11);\n    __m128i Amix = _mm_xor_si128(Amix1,Amix2);\n    Amix1 = _mm_slli_si128(Amix,8);\n    Amix2 = _mm_srli_si128(Amix,8);\n    Alow = _mm_xor_si128(Alow,Amix1);\n    Ahigh = _mm_xor_si128(Ahigh,Amix2);\n    return lazymod127(Alow, Ahigh);\n}\n\n\n\n\n// multiply the length and the some key, no modulo\nstatic __m128i lazyLengthHash(uint64_t keylength, uint64_t length) {\n    const __m128i lengthvector = _mm_set_epi64x(keylength,length);\n    const __m128i clprod1  = _mm_clmulepi64_si128( lengthvector, lengthvector, 0x10);\n    return clprod1;\n}\n\n\n// modulo reduction to 64-bit value. The high 64 bits contain garbage, see precompReduction64\nstatic inline __m128i precompReduction64_si128( __m128i A) {\n\n    //const __m128i C = _mm_set_epi64x(1U,(1U<<4)+(1U<<3)+(1U<<1)+(1U<<0)); // C is the irreducible poly. (64,4,3,1,0)\n    const __m128i C = _mm_cvtsi64_si128((1U<<4)+(1U<<3)+(1U<<1)+(1U<<0));\n    __m128i Q2 = _mm_clmulepi64_si128( A, C, 0x01);\n    __m128i Q3 = _mm_shuffle_epi8(_mm_setr_epi8(0, 27, 54, 45, 108, 119, 90, 65, (char)216, (char)195, (char)238, (char)245, (char)180, (char)175, (char)130, (char)153),\n                                  _mm_srli_si128(Q2,8));\n    __m128i Q4 = _mm_xor_si128(Q2,A);\n    const __m128i final = _mm_xor_si128(Q3,Q4);\n    return final;/// WARNING: HIGH 64 BITS CONTAIN GARBAGE\n}\n\n\nstatic inline uint64_t precompReduction64( __m128i A) {\n    return _mm_cvtsi128_si64(precompReduction64_si128(A));\n}\n\n\n// hashing the bits in value using the keys key1 and key2 (only the first 64 bits of key2 are used).\n// This is basically (a xor k1) * (b xor k2) mod p with length component\nstatic uint64_t simple128to64hashwithlength( const __m128i value, const __m128i key, uint64_t keylength, uint64_t length) {\n    const __m128i add =  _mm_xor_si128 (value,key);\n    const __m128i clprod1  = _mm_clmulepi64_si128( add, add, 0x10);\n    const __m128i total = _mm_xor_si128 (clprod1,lazyLengthHash(keylength, length));\n    return precompReduction64(total);\n}\n\n\nenum {CLHASH_DEBUG=0};\n\n// For use with CLHASH\n// we expect length to have value 128 or, at least, to be divisible by 4.\nstatic __m128i __clmulhalfscalarproductwithoutreduction(const __m128i * randomsource, const uint64_t * string,\n        const size_t length) {\n    assert(((uintptr_t) randomsource & 15) == 0);// we expect cache line alignment for the keys\n    // we expect length = 128, so we need  16 cache lines of keys and 16 cache lines of strings.\n    if(CLHASH_DEBUG) assert((length & 3) == 0); // if not, we need special handling (omitted)\n    const uint64_t * const endstring = string + length;\n    __m128i acc = _mm_setzero_si128();\n    // we expect length = 128\n    for (; string + 3 < endstring; randomsource += 2, string += 4) {\n        const __m128i temp1 = _mm_load_si128( randomsource);\n        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n        acc = _mm_xor_si128(clprod1, acc);\n        const __m128i temp12 = _mm_load_si128(randomsource + 1);\n        const __m128i temp22 = _mm_lddqu_si128((__m128i *) (string + 2));\n        const __m128i add12 = _mm_xor_si128(temp12, temp22);\n        const __m128i clprod12 = _mm_clmulepi64_si128(add12, add12, 0x10);\n        acc = _mm_xor_si128(clprod12, acc);\n    }\n    if(CLHASH_DEBUG) assert(string == endstring);\n    return acc;\n}\n\n\n\n// the value length does not have to be divisible by 4\nstatic __m128i __clmulhalfscalarproductwithtailwithoutreduction(const __m128i * randomsource,\n        const uint64_t * string, const size_t length) {\n    assert(((uintptr_t) randomsource & 15) == 0);// we expect cache line alignment for the keys\n    const uint64_t * const endstring = string + length;\n    __m128i acc = _mm_setzero_si128();\n    for (; string + 3 < endstring; randomsource += 2, string += 4) {\n        const __m128i temp1 = _mm_load_si128(randomsource);\n        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n        acc = _mm_xor_si128(clprod1, acc);\n        const __m128i temp12 = _mm_load_si128(randomsource+1);\n        const __m128i temp22 = _mm_lddqu_si128((__m128i *) (string + 2));\n        const __m128i add12 = _mm_xor_si128(temp12, temp22);\n        const __m128i clprod12 = _mm_clmulepi64_si128(add12, add12, 0x10);\n        acc = _mm_xor_si128(clprod12, acc);\n    }\n    if (string + 1 < endstring) {\n        if(CLHASH_DEBUG) assert(length != 128);\n        const __m128i temp1 = _mm_load_si128(randomsource);\n        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n        acc = _mm_xor_si128(clprod1, acc);\n        randomsource += 1;\n        string += 2;\n    }\n    if (string < endstring) {\n        if(CLHASH_DEBUG) assert(length != 128);\n        const __m128i temp1 = _mm_load_si128(randomsource);\n        const __m128i temp2 = _mm_loadl_epi64((__m128i const*)string);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n        acc = _mm_xor_si128(clprod1, acc);\n        if(CLHASH_DEBUG) ++string;\n    }\n    if(CLHASH_DEBUG) assert(string == endstring);\n    return acc;\n}\n// the value length does not have to be divisible by 4\nstatic __m128i __clmulhalfscalarproductwithtailwithoutreductionWithExtraWord(const __m128i * randomsource,\n        const uint64_t * string, const size_t length, const uint64_t extraword) {\n    assert(((uintptr_t) randomsource & 15) == 0);// we expect cache line alignment for the keys\n    const uint64_t * const endstring = string + length;\n    __m128i acc = _mm_setzero_si128();\n    for (; string + 3 < endstring; randomsource += 2, string += 4) {\n        const __m128i temp1 = _mm_load_si128(randomsource);\n        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n        acc = _mm_xor_si128(clprod1, acc);\n        const __m128i temp12 = _mm_load_si128(randomsource+1);\n        const __m128i temp22 = _mm_lddqu_si128((__m128i *) (string + 2));\n        const __m128i add12 = _mm_xor_si128(temp12, temp22);\n        const __m128i clprod12 = _mm_clmulepi64_si128(add12, add12, 0x10);\n        acc = _mm_xor_si128(clprod12, acc);\n    }\n    if (string + 1 < endstring) {\n        const __m128i temp1 = _mm_load_si128(randomsource);\n        const __m128i temp2 = _mm_lddqu_si128((__m128i *) string);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n        acc = _mm_xor_si128(clprod1, acc);\n        randomsource += 1;\n        string += 2;\n    }\n    // we have to append an extra 1\n    if (string < endstring) {\n        const __m128i temp1 = _mm_load_si128(randomsource);\n        const __m128i temp2 = _mm_set_epi64x(extraword,*string);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x10);\n        acc = _mm_xor_si128(clprod1, acc);\n    } else {\n        const __m128i temp1 = _mm_load_si128(randomsource);\n        const __m128i temp2 = _mm_loadl_epi64((__m128i const*)&extraword);\n        const __m128i add1 = _mm_xor_si128(temp1, temp2);\n        const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x01);\n        acc = _mm_xor_si128(clprod1, acc);\n    }\n    return acc;\n}\n\n\nstatic __m128i __clmulhalfscalarproductOnlyExtraWord(const __m128i * randomsource,\n        const uint64_t extraword) {\n    const __m128i temp1 = _mm_load_si128(randomsource);\n    const __m128i temp2 = _mm_loadl_epi64((__m128i const*)&extraword);\n    const __m128i add1 = _mm_xor_si128(temp1, temp2);\n    const __m128i clprod1 = _mm_clmulepi64_si128(add1, add1, 0x01);\n    return clprod1;\n}\n\n\n\n\n#ifdef BITMIX\n////////\n// an invertible function used to mix the bits\n// borrowed directly from murmurhash\n////////\ninline uint64_t fmix64 ( uint64_t k ) {\n    k ^= k >> 33;\n    k *= 0xff51afd7ed558ccdULL;\n    k ^= k >> 33;\n    k *= 0xc4ceb9fe1a85ec53ULL;\n    k ^= k >> 33;\n    return k;\n}\n#endif\n\n\n\n// there always remain an incomplete word that has 1,2, 3, 4, 5, 6, 7 used bytes.\n// we append 0s to it\nstatic inline uint64_t createLastWord(const size_t lengthbyte, const uint64_t * lastw) {\n    const int significantbytes = lengthbyte % sizeof(uint64_t);\n    uint64_t lastword = 0;\n    memcpy(&lastword,lastw,significantbytes); // could possibly be faster?\n    return lastword;\n}\n\n\n\n\nuint64_t clhash(const void* random, const char * stringbyte,\n                const size_t lengthbyte) {\n    assert(sizeof(size_t)<=sizeof(uint64_t));// otherwise, we need to worry\n    assert(((uintptr_t) random & 15) == 0);// we expect cache line alignment for the keys\n    const unsigned int  m = 128;// we process the data in chunks of 16 cache lines\n    if(CLHASH_DEBUG) assert((m  & 3) == 0); //m should be divisible by 4\n    const int m128neededperblock = m / 2;// that is how many 128-bit words of random bits we use per block\n    const __m128i * rs64 = (__m128i *) random;\n    __m128i polyvalue =  _mm_load_si128(rs64 + m128neededperblock); // to preserve alignment on cache lines for main loop, we pick random bits at the end\n    polyvalue = _mm_and_si128(polyvalue,_mm_setr_epi32(0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0x3fffffff));// setting two highest bits to zero\n    // we should check that polyvalue is non-zero, though this is best done outside the function and highly unlikely\n    const size_t length = lengthbyte / sizeof(uint64_t); // # of complete words\n    const size_t lengthinc = (lengthbyte + sizeof(uint64_t) - 1) / sizeof(uint64_t); // # of words, including partial ones\n\n    const uint64_t * string = (const uint64_t *)  stringbyte;\n    if (m < lengthinc) { // long strings // modified from length to lengthinc to address issue #3 raised by Eik List\n        __m128i  acc =  __clmulhalfscalarproductwithoutreduction(rs64, string,m);\n        size_t t = m;\n        for (; t +  m <= length; t +=  m) {\n            // we compute something like\n            // acc+= polyvalue * acc + h1\n            acc =  mul128by128to128_lazymod127(polyvalue,acc);\n            const __m128i h1 =  __clmulhalfscalarproductwithoutreduction(rs64, string+t,m);\n            acc = _mm_xor_si128(acc,h1);\n        }\n        const int remain = length - t;  // number of completely filled words\n\n        if (remain != 0) {\n            // we compute something like\n            // acc+= polyvalue * acc + h1\n            acc = mul128by128to128_lazymod127(polyvalue, acc);\n            if (lengthbyte % sizeof(uint64_t) == 0) {\n                const __m128i h1 =\n                    __clmulhalfscalarproductwithtailwithoutreduction(rs64,\n                            string + t, remain);\n                acc = _mm_xor_si128(acc, h1);\n            } else {\n                const uint64_t lastword = createLastWord(lengthbyte,\n                                          (string + length));\n                const __m128i h1 =\n                    __clmulhalfscalarproductwithtailwithoutreductionWithExtraWord(\n                        rs64, string + t, remain, lastword);\n                acc = _mm_xor_si128(acc, h1);\n            }\n        } else if (lengthbyte % sizeof(uint64_t) != 0) {// added to address issue #2 raised by Eik List\n            // there are no completely filled words left, but there is one partial word.\n            acc = mul128by128to128_lazymod127(polyvalue, acc);\n            const uint64_t lastword = createLastWord(lengthbyte, (string + length));\n            const __m128i h1 = __clmulhalfscalarproductOnlyExtraWord( rs64, lastword);\n            acc = _mm_xor_si128(acc, h1);\n        }\n\n        const __m128i finalkey = _mm_load_si128(rs64 + m128neededperblock + 1);\n        const uint64_t keylength = *(const uint64_t *)(rs64 + m128neededperblock + 2);\n        return simple128to64hashwithlength(acc,finalkey,keylength, (uint64_t)lengthbyte);\n    } else { // short strings\n        if(lengthbyte % sizeof(uint64_t) == 0) {\n            __m128i  acc = __clmulhalfscalarproductwithtailwithoutreduction(rs64, string, length);\n            const uint64_t keylength = *(const uint64_t *)(rs64 + m128neededperblock + 2);\n            acc = _mm_xor_si128(acc,lazyLengthHash(keylength, (uint64_t)lengthbyte));\n#ifdef BITMIX\n            return fmix64(precompReduction64(acc)) ;\n#else\n            return precompReduction64(acc) ;\n#endif\n        }\n        const uint64_t lastword = createLastWord(lengthbyte, (string + length));\n        __m128i acc = __clmulhalfscalarproductwithtailwithoutreductionWithExtraWord(\n                          rs64, string, length, lastword);\n        const uint64_t keylength =  *(const uint64_t *)(rs64 + m128neededperblock + 2);\n        acc = _mm_xor_si128(acc,lazyLengthHash(keylength, (uint64_t)lengthbyte));\n#ifdef BITMIX\n        return fmix64(precompReduction64(acc)) ;\n#else\n        return precompReduction64(acc) ;\n#endif\n    }\n}\n\n\n/***************************\n * Rest is optional random-number generation stuff\n */\n\n\n/* Keys for scalar xorshift128. Must be non-zero\nThese are modified by xorshift128plus.\n */\nstruct xorshift128plus_key_s {\n    uint64_t part1;\n    uint64_t part2;\n};\n\ntypedef struct xorshift128plus_key_s xorshift128plus_key_t;\n\n\n\n/**\n*\n* You can create a new key like so...\n*   xorshift128plus_key_t mykey;\n*   xorshift128plus_init(324, 4444,&mykey);\n*\n* or directly if you prefer:\n*  xorshift128plus_key_t mykey = {.part1=324,.part2=4444}\n*\n*  Then you can generate random numbers like so...\n*      xorshift128plus(&mykey);\n* If your application is threaded, each thread should have its own\n* key.\n*\n*\n* The seeds (key1 and key2) should be non-zero. You are responsible for\n* checking that they are non-zero.\n*\n*/\nstatic inline void xorshift128plus_init(uint64_t key1, uint64_t key2, xorshift128plus_key_t *key) {\n    key->part1 = key1;\n    key->part2 = key2;\n}\n\n\n/*\nReturn a new 64-bit random number\n*/\nuint64_t xorshift128plus(xorshift128plus_key_t * key) {\n    uint64_t s1 = key->part1;\n    const uint64_t s0 = key->part2;\n    key->part1 = s0;\n    s1 ^= s1 << 23; // a\n    key->part2 = s1 ^ s0 ^ (s1 >> 18) ^ (s0 >> 5); // b, c\n    return key->part2 + s0