t                switch (node->tok.op) {\n969\t                case '+': stack[++top].i32 = left.i32 + right.i32; break;\n970\t                case '-': stack[++top].i32 = left.i32 - right.i32; break;\n971\t                case '*': stack[++top].i32 = left.i32 * right.i32; break;\n972\t                case '/': stack[++top].i32 = left.i32 / right.i32; break;\n973\t                default: goto error;\n974\t                }\n975\t                trace_eval(\"%d\\n\", stack[top].i32);\n976\t            }\n977\t            break;\n978\t        case TOK_FUNC:\n979\t            switch (function_table[node->tok.func].arity) {\n980\t            case 0:\n981\t                stack[++top].f = ((func_float_arity0*)function_table[node->tok.func].func)();\n982\t                trace_eval(\"%s = %f\\n\", function_table[node->tok.func].name,\n983\t                           stack[top].f);\n984\t                break;\n985\t            case 1:\n986\t                right = stack[top--];\n987\t                trace_eval(\"%s(%f) = \", function_table[node->tok.func].name, right.f);\n988\t                right.f = ((func_float_arity1*)function_table[node->tok.func].func)(right.f);\n989\t                trace_eval(\"%f\\n\", right.f);\n990\t                stack[++top].f = right.f;\n991\t                break;\n992\t            case 2:\n993\t                right = stack[top--];\n994\t                left = stack[top--];\n995\t                trace_eval(\"%s(%f,%f) = \", function_table[node->tok.func].name, left.f, right.f);\n996\t                right.f = ((func_float_arity2*)function_table[node->tok.func].func)(left.f, right.f);\n997\t                trace_eval(\"%f\\n\", right.f);\n998\t                stack[++top].f = right.f;\n999\t                break;\n1000\t            default: goto error;\n1001\t            }\n1002\t            break;\n1003\t        default: goto error;\n1004\t        }\n1005\t        node = node->next;\n1006\t    }\n1007\t\n1008\t    if (input_vector)\n100