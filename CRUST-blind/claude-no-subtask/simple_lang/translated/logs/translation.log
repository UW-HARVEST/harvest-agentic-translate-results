          exit(1);\n70\t        }\n71\t        ASTNode* expr = parse_expression();\n72\t        if (consume()->type != TOKEN_SEMICOLON) {\n73\t            fprintf(stderr, \"Expected ';' at end of statement\\n\");\n74\t            exit(1);\n75\t        }\n76\t        ASTNode* node = new_ast_node(TOKEN_LET, identifier->value);\n77\t        node->left = expr;\n78\t        return node;\n79\t    }\n80\t    else if (token->type == TOKEN_IDENTIFIER) {\n81\t        Token* identifier = token;\n82\t        if (consume()->type != TOKEN_ASSIGN) {\n83\t            fprintf(stderr, \"Expected '=' after identifier\\n\");\n84\t            exit(1);\n85\t        }\n86\t        ASTNode* expr = parse_expression();\n87\t        if (consume()->type != TOKEN_SEMICOLON) {\n88\t            fprintf(stderr, \"Expected ';' at end of statement\\n\");\n89\t            exit(1);\n90\t        }\n91\t        ASTNode* node = new_ast_node(TOKEN_ASSIGN, identifier->value);\n92\t        node->left = expr;\n93\t        return node;\n94\t    }\n95\t    else if (token->type == TOKEN_DIS){\n96\t        ASTNode * expr = parse_expression();\n97\t        ASTNode * node = new_ast_node(TOKEN_DIS, NULL);\n98\t        if (consume()->type != TOKEN_SEMICOLON) {\n99\t            fprintf(stderr, \"Expected ';' at end of statement\\n\");\n100\t            exit(1);\n101\t        }\n102\t        node -> left = expr;\n103\t        return node;\n104\t    }\n105\t    else {\n106\t        fprintf(stderr, \"Unexpected token: %s\\n\", token->value);\n107\t        exit(1);\n108\t    }\n109\t}\n110\t\n111\tASTNode**\n112\tparse(Token* tokens_array)\n113\t{\n114\t    tokens = tokens_array;\n115\t    pos = 0;\n116\t\n117\t\n118\t    ASTNode** ast_nodes = (ASTNode**)malloc(sizeof(ASTNode*) * MAX_STATEMENT);\n119\t    int count = 0;\n120\t\n121\t    while (tokens[pos].type != TOKEN_EOF) {\n122\t        ast_nodes[count++] = parse_statement();\n123\t    }\n124\t\n125\t    ast_nodes[count] = NULL; // Marking the end of an AST array with