and `err_ptr` is a pointer to a `const char *` (so a `const char **`) that receives any error\n186\t *    strings in the event of a problem. These errors are statically allocated so no need to\n187\t *    free them. This variable should be initialized to NULL and checked after calling\n188\t *    `XOPT_SIMPLE_PARSE()`.\n189\t *\n190\t *  `autohelp_file`, `autohelp_usage`, `autohelp_prefix`, `autohelp_suffix` and `autohelp_spacer` are all\n191\t *  parameters to the `xoptAutohelpOptions` struct (with the exception of `autohelp_file`, which must be a\n192\t *  `FILE*` reference (e.g. `stdout` or `stderr`) which receives the rendered autohelp text). Consult the\n193\t *  `xoptAutohelpOptions` struct above for documentation as to valid values for each of these properties.\n194\t */\n195\t#define XOPT_SIMPLE_PARSE(name, options, config_ptr, argc, argv, extrac_ptr, extrav_ptr, err_ptr, autohelp_file, autohelp_usage, autohelp_prefix, autohelp_suffix, autohelp_spacer) do { \\\n196\t\t\txoptContext *_xopt_ctx; \\\n197\t\t\t\\\n198\t\t\t*(err_ptr) = NULL; \\\n199\t\t\t\\\n200\t\t\t_xopt_ctx = xopt_context((name), (options), XOPT_CTX_POSIXMEHARDER | XOPT_CTX_STRICT, (err_ptr)); \\\n201\t\t\tif (*(err_ptr)) break; \\\n202\t\t\t\\\n203\t\t\t*extrac_ptr = xopt_parse(_xopt_ctx, (argc), (argv), (config_ptr), (extrav_ptr), (err_ptr)); \\\n204\t\t\tif (*(err_ptr)) goto __xopt_end_free_ctx; \\\n205\t\t\t\\\n206\t\t\tif ((config_ptr)->help) { \\\n207\t\t\t\txoptAutohelpOptions __xopt_autohelp_opts; \\\n208\t\t\t\t__xopt_autohelp_opts.usage = (autohelp_usage); \\\n209\t\t\t\t__xopt_autohelp_opts.prefix = (autohelp_prefix); \\\n210\t\t\t\t__xopt_autohelp_opts.suffix = (autohelp_suffix); \\\n211\t\t\t\t__xopt_autohelp_opts.spacer = (autohelp_spacer); \\\n212\t\t\t\txopt_autohelp(_xopt_ctx, (autohelp_file), &__xopt_autohelp_opts, (err_ptr)); \\\n213\t\t\t\tif (*(err_ptr)) goto __xopt_end_free_extrav; \\\n214\t\t\t\tgoto xopt_help; \\\n215\t\t\t} \\\n216\t\t\\\n217\t\t__xopt_end_free_ctx: \