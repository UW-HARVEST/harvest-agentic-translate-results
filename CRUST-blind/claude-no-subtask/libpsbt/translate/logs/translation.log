no-padded\n\nOBJS += psbt.o\nOBJS += base64.o\nOBJS += tx.o\nOBJS += compactsize.o\n\nSRCS=$(OBJS:.o=.c)\n\nall: $(SHLIB) $(STATICLIB) $(BIN)\n\ninclude $(OBJS:.o=.d)\n\n%.d: %.c\n\t$(CC) -MM $(CFLAGS) $< > $@\n\n$(BIN): $(OBJS) cli.c\n\t$(CC) $(CFLAGS) cli.c $(OBJS) -o $@\n\n$(STATICLIB): $(OBJS)\n\tar rcs $@ $(OBJS)\n\n$(SHLIB): $(OBJS)\n\t$(CC) -shared -o $@ $(OBJS)\n\ninstall: $(STATICLIB) $(SHLIB)\n\tinstall -d $(PREFIX)/lib $(PREFIX)/include\n\tinstall $(STATICLIB) $(SHLIB) $(PREFIX)/lib\n\tinstall psbt.h $(PREFIX)/include\n\ncheck: test\n\t./test\n\ntest: test.c $(STATICLIB)\n\t$(CC) $(CFLAGS) test.c $(OBJS) -o $@\n\nTAGS:\n\tetags *.c\n\nclean:\n\trm -f $(OBJS) $(SHLIB) $(BIN) $(STATICLIB) *.d*\n\n.PHONY: TAGS\n","numLines":55,"startLine":1,"totalLines":55}}}
