{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BatnNQmELeW6GiE5hqF6ih","type":"tool_result","content":"1\t\n2\t#define _DEFAULT_SOURCE\n3\t\n4\t#include <stdio.h>\n5\t#include <ctype.h>\n6\t#include <string.h>\n7\t#include <endian.h>\n8\t#include <assert.h>\n9\t#include <inttypes.h>\n10\t#include \"compactsize.h\"\n11\t#include \"tx.h\"\n12\t#include \"base64.h\"\n13\t\n14\t#ifdef DEBUG\n15\t  #define debug(...) fprintf(stderr, __VA_ARGS__)\n16\t#else\n17\t  #define debug(...)\n18\t#endif\n19\t\n20\tchar *psbt_errmsg = NULL;\n21\t\n22\tconst unsigned char PSBT_MAGIC[4] = {0x70, 0x73, 0x62, 0x74};\n23\t\n24\t#define ASSERT_SPACE(s) \\\n25\t\tif (tx->write_pos+(s) > tx->data + tx->data_capacity) { \\\n26\t\t\tpsbt_errmsg = \"write out of bounds \" __FILE__ \":\" STRINGIZE(__LINE__); \\\n27\t\t\treturn PSBT_OOB_WRITE; \\\n28\t\t}\n29\t\n30\tsize_t psbt_size(struct psbt *tx) {\n31\t\treturn tx->write_pos - tx->data;\n32\t}\n33\t\n34\tstatic void hex_print(unsigned char *data, size_t len) {\n35\t\tfor (size_t i = 0; i < len; ++i)\n36\t\t\tprintf(\"%02x\", data[i]);\n37\t}\n38\t\n39\t\n40\t\n41\tstatic enum psbt_result\n42\tpsbt_write_header(struct psbt *tx) {\n43\t\tASSERT_SPACE(sizeof(PSBT_MAGIC));\n44\t\tmemcpy(tx->write_pos, PSBT_MAGIC, sizeof(PSBT_MAGIC));\n45\t\ttx->write_pos += sizeof(PSBT_MAGIC);\n46\t\n47\t\tASSERT_SPACE(1);\n48\t\t*tx->write_pos = 0xff;\n49\t\ttx->write_pos++;\n50\t\n51\t\ttx->state = PSBT_ST_GLOBAL;\n52\t\n53\t\treturn PSBT_OK;\n54\t}\n55\t\n56\t\n57\tenum psbt_result\n58\tpsbt_init(struct psbt *tx, unsigned char *dest, size_t dest_size) {\n59\t\ttx->write_pos = dest;\n60\t\ttx->data = dest;\n61\t\ttx->data_capacity = dest_size;\n62\t\ttx->state = PSBT_ST_INIT;\n63\t\treturn PSBT_OK;\n64\t}\n65\t\n66\t/* enum psbt_result */\n67\t/* psbt_end_transaction(char *dest, size_t dest_len) */\n68\t/* { */\n69\t/* \tASSERT_SPACE(1); */\n70\t/* \t*dest =  */\n71\t/* } */\n72\t\n73\t\n74\tenum psbt_result\n75\tpsbt_close_records(struct psbt *tx) {\n76\t\tASSERT_SPACE(1);\n77\t\t*tx->write_pos = '\\0';\n78\t\ttx->write_pos++;\n79\t\treturn PSBT_OK;\n80\t}\n81\t\n82\t\n83\tenum psbt_result\n84\tpsbt_finalize(struct psbt *tx) {\n85\t\tenum psbt_result res;\n86\t\n87\t\tif (tx->state != PSBT_ST_OUTPUTS_NEW && tx->state != PSBT_ST_OUTPUTS) {\n88\t\t\tpsbt_errmsg = \"psbt_finalize: no output records found\";\n89\t\t\treturn PSBT_INVALID_STATE;\n90\t\t}\n91\t\n92\t\tres = psbt_close_records(tx);\n93\t\tif (res != PSBT_OK)\n94\t\t\treturn res;\n95\t\n96\t\ttx->state = PSBT_ST_FINALIZED;\n97\t\n98\t\treturn PSBT_OK;\n99\t}\n100\t\n101\tstatic enum psbt_result\n102\tpsbt_write_record(struct psbt *tx, struct psbt_record *rec) {\n103\t\tu32 size;\n104\t\tu32 key_size_with_type = rec->key_size + 1;\n105\t\n106\t\t// write key length\n107\t\tsize = compactsize_length(key_size_with_type);\n108\t\tASSERT_SPACE(size);\n109\t\tcompactsize_write((u8*)tx->write_pos, key_size_with_type);\n110\t\ttx->write_pos += size;\n111\t\n112\t\t// write type\n113\t\tASSERT_SPACE(1);\n114\t\t*tx->write_pos++ = rec->type;\n115\t\n116\t\t// write key\n117\t\tASSERT_SPACE(rec->key_size);\n118\t\tmemcpy(tx->write_pos, rec->key, rec->key_size);\n119\t\ttx->write_pos += rec->key_size;\n120\t\n121\t\t// write value length\n122\t\tsize = compactsize_length(rec->val_size);\n123\t\tASSERT_SPACE(size);\n124\t\tcompactsize_write((u8*)tx->write_pos, rec->val_size);\n125\t\ttx->write_pos += size;\n126\t\n127\t\t// write value\n128\t\tASSERT_SPACE(rec->val_size);\n129\t\tmemcpy(tx->write_pos, rec->val, rec->val_size);\n130\t\ttx->write_pos += rec->val_size;\n131\t\n132\t\treturn PSBT_OK;\n133\t}\n134\t\n135\tstatic enum psbt_result\n136\tpsbt_read_header(struct psbt *tx) {\n137\t\tASSERT_SPACE(4);\n138\t\n139\t\tdebug(\"magic %02X %02X %02X %02X\\n\",\n140\t\t\t*tx->write_pos,\n141\t\t\t*(tx->write_pos+1),\n142\t\t\t*(tx->write_pos+2),\n143\t\t\t*(tx->write_pos+3));\n144\t\n145\t\tif (memcmp(tx->write_pos, PSBT_MAGIC, sizeof(PSBT_MAGIC)) != 0) {\n146\t\t\tpsbt_errmsg = \"psbt_read: invalid magic header\";\n147\t\t\treturn PSBT_READ_ERROR;\n148\t\t}\n149\t\n150\t\ttx->write_pos += 4;\n151\t\n152\t\tif (*tx->write_pos++ != 0xff) {\n153\t\t\tpsbt_errmsg = \"psbt_read: no 0xff found after magic\";\n154\t\t\treturn PSBT_READ_ERROR;\n155\t\t}\n156\t\n157\t\ttx->state = PSBT_ST_GLOBAL;\n158\t\n159\t\treturn PSBT_OK;\n160\t}\n161\t\n162\tconst char *\n163\tpsbt_input_type_tostr(enum psbt_input_type type) {\n164\t\tswitch (type) {\n165\t\tcase PSBT_IN_NON_WITNESS_UTXO:\n166\t\t\treturn \"IN_NON_WITNESS_UTXO\";\n167\t\tcase PSBT_IN_WITNESS_UTXO:\n168\t\t\treturn \"IN_WITNESS_UTXO\";\n169\t\tcase PSBT_IN_PARTIAL_SIG:\n170\t\t\treturn \"IN_PARTIAL_SIG\";\n171\t\tcase PSBT_IN_SIGHASH_TYPE:\n172\t\t\treturn \"IN_SIGHASH_TYPE\";\n173\t\tcase PSBT_IN_REDEEM_SCRIPT:\n174\t\t\treturn \"IN_REDEEM_SCRIPT\";\n175\t\tcase PSBT_IN_WITNESS_SCRIPT:\n176\t\t\treturn \"IN_WITNESS_SCRIPT\";\n177\t\tcase PSBT_IN_BIP32_DERIVATION:\n178\t\t\treturn \"IN_BIP32_DERIVATION\";\n179\t\tcase PSBT_IN_FINAL_SCRIPTSIG:\n180\t\t\treturn \"IN_FINAL_SCRIPTSIG\";\n181\t\tcase PSBT_IN_FINAL_SCRIPTWITNESS:\n182\t\t\treturn \"IN_FINAL_SCRIPTWITNESS\";\n183\t\t}\n184\t\n185\t\treturn \"UNKNOWN_INPUT_TYPE\";\n186\t}\n187\t\n188\tconst char *\n189\tpsbt_state_tostr(enum psbt_state state) {\n190\t\tswitch (state) {\n191\t\tcase PSBT_ST_INIT:\n192\t\t\treturn \"INIT\";\n193\t\tcase PSBT_ST_GLOBAL:\n194\t\t\treturn \"GLOBAL\";\n195\t\tcase PSBT_ST_INPUTS:\n196\t\t\treturn \"INPUTS\";\n197\t\tcase PSBT_ST_INPUTS_NEW:\n198\t\t\treturn \"INPUTS_NEW\";\n199\t\tcase PSBT_ST_OUTPUTS:\n200\t\t\treturn \"OUTPUTS\";\n201\t\tcase PSBT_ST_OUTPUTS_NEW:\n202\t\t\treturn \"OUTPUTS_NEW\";\n203\t\tcase PSBT_ST_FINALIZED:\n204\t\t\treturn \"FINALIZED\";\n205\t\t}\n206\t\n207\t\treturn \"UNKNOWN_STATE\";\n208\t}\n209\t\n210\tconst char *\n211\tpsbt_output_type_tostr(enum psbt_output_type type) {\n212\t\tswitch (type) {\n213\t\tcase PSBT_OUT_REDEEM_SCRIPT:\n214\t\t\treturn \"OUT_REDEEM_SCRIPT\";\n215\t\tcase PSBT_OUT_WITNESS_SCRIPT:\n216\t\t\treturn \"OUT_WITNESS_SCRIPT\";\n217\t\tcase PSBT_OUT_BIP32_DERIVATION:\n218\t\t\treturn \"OUT_BIP32_DERIVATION\";\n219\t\t}\n220\t\n221\t\treturn \"UNKNOWN_OUTPUT_TYPE\";\n222\t}\n223\t\n224\tconst char *\n225\tpsbt_global_type_tostr(enum psbt_global_type type) {\n226\t\tswitch (type) {\n227\t\tcase PSBT_GLOBAL_UNSIGNED_TX: return \"GLOBAL_UNSIGNED_TX\";\n228\t\t}\n229\t\n230\t\treturn \"UNKNOWN_GLOBAL_TYPE\";\n231\t}\n232\t\n233\tconst char *\n234\tpsbt_txelem_type_tostr(enum psbt_txelem_type txelem_type) {\n235\t\tswitch (txelem_type) {\n236\t\tcase PSBT_TXELEM_TX:\n237\t\t\treturn \"TX\";\n238\t\tcase PSBT_TXELEM_TXIN:\n239\t\t\treturn \"TXIN\";\n240\t\tcase PSBT_TXELEM_TXOUT:\n241\t\t\treturn \"TXOUT\";\n242\t\tcase PSBT_TXELEM_WITNESS_ITEM:\n243\t\t\treturn \"WITNESS_ITEM\";\n244\t\t}\n245\t\n246\t\treturn \"UNKNOWN_TXELEM\";\n247\t}\n248\t\n249\tconst char *\n250\tpsbt_type_tostr(unsigned char type, enum psbt_scope scope) {\n251\t\tswitch (scope) {\n252\t\tcase PSBT_SCOPE_GLOBAL:\n253\t\t\treturn psbt_global_type_tostr((enum psbt_global_type)type);\n254\t\tcase PSBT_SCOPE_INPUTS:\n255\t\t\treturn psbt_input_type_tostr((enum psbt_input_type)type);\n256\t\tcase PSBT_SCOPE_OUTPUTS:\n257\t\t\treturn psbt_output_type_tostr((enum psbt_output_type)type);\n258\t\t}\n259\t\n260\t\treturn \"UNKNOWN_SCOPE\";\n261\t}\n262\t\n263\tstatic enum psbt_result\n264\tpsbt_read_record(struct psbt *tx, size_t src_size, struct psbt_record *rec)\n265\t{\n266\t\tenum psbt_result res = PSBT_OK;\n267\t\tu64 size;\n268\t\tu32 size_len;\n269\t\n270\t\tsize_len = compactsize_peek_length(*tx->write_pos);\n271\t\tASSERT_SPACE(size_len);\n272\t\tsize = compactsize_read(tx->write_pos, &res);\n273\t\tassert(size > 0);\n274\t\n275\t\ttx->write_pos += size_len;\n276\t\n277\t\tdebug(\"record pos %zu size_len %d size %\"PRIu64\"\\n\",\n278\t\t      tx->write_pos - tx->data, size_len, size);\n279\t\n280\t\tif (res != PSBT_OK)\n281\t\t\treturn res;\n282\t\n283\t\tif (tx->write_pos + size > tx->data + src_size) {\n284\t\t\tpsbt_errmsg = \"psbt_read: record key size too large\";\n285\t\t\treturn PSBT_READ_ERROR;\n286\t\t}\n287\t\n288\t\tASSERT_SPACE(size);\n289\t\n290\t\trec->key_size = size - 1; // don't include type in key size\n291\t\trec->type = *tx->write_pos;\n292\t\trec->key = tx->write_pos + 1;\n293\t\n294\t\ttx->write_pos += size;\n295\t\tdebug(\"%02x %02x %02x %02x %02x\\n\", *(tx->write_pos-2), *(tx->write_pos-1),\n296\t\t      *tx->write_pos, *(tx->write_pos+1), *(tx->write_pos+2));\n297\t\n298\t\tdebug(\"record pos %zu size_len %d size %\"PRIu64\"\\n\",\n299\t\t      tx->write_pos - tx->data, size_len, size);\n300\t\n301\t\tswitch (tx->state) {\n302\t\t\tcase PSBT_ST_GLOBAL:\n303\t\t\t\trec->scope = PSBT_SCOPE_GLOBAL;\n304\t\t\t\tbreak;\n305\t\n306\t\t\tcase PSBT_ST_INPUTS:\n307\t\t\t\trec->scope = PSBT_SCOPE_INPUTS;\n308\t\t\t\tbreak;\n309\t\n310\t\t\tcase PSBT_ST_OUTPUTS:\n311\t\t\t\trec->scope = PSBT_SCOPE_OUTPUTS;\n312\t\t\t\tbreak;\n313\t\n314\t\t\tdefault:\n315\t\t\t\tpsbt_errmsg = \"psbt_read_record: invalid record state\";\n316\t\t\t\treturn PSBT_INVALID_STATE;\n317\t\t}\n318\t\n319\t\tsize_len = compactsize_peek_length(*tx->write_pos);\n320\t\n321\t\tASSERT_SPACE(size_len);\n322\t\tsize = compactsize_read(tx->write_pos, &res);\n323\t\n324\t\tif (res != PSBT_OK)\n325\t\t\treturn res;\n326\t\n327\t\ttx->write_pos += size_len;\n328\t\n329\t\tif (tx->write_pos + size > tx->data + src_size) {\n330\t\t\tpsbt_errmsg = \"psbt_read: record value size too large\";\n331\t\t\treturn PSBT_READ_ERROR;\n332\t\t}\n333\t\n334\t\trec->val_size = size;\n335\t\trec->val = tx->write_pos;\n336\t\n337\t\tASSERT_SPACE(size);\n338\t\ttx->write_pos += size;\n339\t\n340\t\treturn PSBT_OK;\n341\t}\n342\t\n343\tstruct psbt_tx_counter {\n344\t\tint inputs;\n345\t\tint outputs;\n346\t\tvoid *user_data;\n347\t\tpsbt_elem_handler *handler;\n348\t} counter;\n349\t\n350\tstatic void tx_counter(struct psbt_txelem *elem) {\n351\t\tstruct psbt_elem psbt_elem;\n352\t\tstruct psbt_tx_counter *counter =\n353\t\t\t(struct psbt_tx_counter *)elem->user_data;\n354\t\n355\t\tpsbt_elem.user_data = counter->user_data;\n356\t\tpsbt_elem.type = PSBT_ELEM_TXELEM;\n357\t\tpsbt_elem.elem.txelem = elem;\n358\t\n359\t\t// forward txelem events to user\n360\t\tif (counter->handler)\n361\t\t\tcounter->handler(&psbt_elem);\n362\t\n363\t\tswitch (elem->elem_type) {\n364\t\tcase PSBT_TXELEM_TXIN:\n365\t\t\tcounter->inputs++;\n366\t\t\treturn;\n367\t\tcase PSBT_TXELEM_TXOUT:\n368\t\t\tcounter->outputs++;\n369\t\t\treturn;\n370\t\tdefault:\n371\t\t\treturn;\n372\t\t}\n373\t}\n374\t\n375\tenum psbt_result\n376\tpsbt_read(const unsigned char *src, size_t src_size, struct psbt *tx,\n377\t\t  psbt_elem_handler *elem_handler, void* user_data)\n378\t{\n379\t\tstruct psbt_record rec;\n380\t\tenum psbt_result res;\n381\t\n382\t\tstruct psbt_elem elem;\n383\t\telem.type = PSBT_ELEM_RECORD;\n384\t\telem.user_data = user_data;\n385\t\n386\t\tint kvs = 0;\n387\t\tu8 *end;\n388\t\n389\t\tstruct psbt_tx_counter counter = {\n390\t\t\t.inputs = 0,\n391\t\t\t.outputs = 0,\n392\t\t\t.user_data = user_data,\n393\t\t\t.handler = elem_handler,\n394\t\t};\n395\t\n396\t\tif (tx->state != PSBT_ST_INIT) {\n397\t\t\tpsbt_errmsg = \"psbt_read: psbt not initialized, use psbt_init first\";\n398\t\t\treturn PSBT_INVALID_STATE;\n399\t\t}\n400\t\n401\t\tif (src_size > tx->data_capacity) {\n402\t\t\tpsbt_errmsg = \"psbt_read: read buffer is larger than psbt capacity\";\n403\t\t\treturn PSBT_OOB_WRITE;\n404\t\t}\n405\t\n406\t\tif (src != tx->data)\n407\t\t\tmemcpy(tx->data, src, src_size);\n408\t\n409\t\t// parsing should try to get this to the finalized state,\n410\t\t// otherwise it's an invalid psbt\n411\t\ttx->state = PSBT_ST_INIT;\n412\t\ttx->write_pos = tx->data;\n413\t\n414\t\t// XXX: needed so that the asserts work properly. this is probably fine...\n415\t\ttx->data_capacity = src_size;\n416\t\n417\t\tend = tx->data + src_size;\n418\t\n419\t\twhile (tx->state != PSBT_ST_FINALIZED && tx->write_pos <= end) {\n420\t\t\tswitch(tx->state) {\n421\t\t\tcase PSBT_ST_INIT:\n422\t\t\t\tdebug(\"reading header at %zu\\n\", tx->write_pos - tx->data);\n423\t\t\t\tres = psbt_read_header(tx);\n424\t\t\t\tif (res != PSBT_OK)\n425\t\t\t\t\treturn res;\n426\t\t\t\tbreak;\n427\t\n428\t\t\tcase PSBT_ST_GLOBAL:\n429\t\t\tcase PSBT_ST_INPUTS:\n430\t\t\tcase PSBT_ST_OUTPUTS:\n431\t\n432\t\t\t\tif (*tx->write_pos == 0) {\n433\t\t\t\t\tswitch (tx->state) {\n434\t\t\t\t\tcase PSBT_ST_GLOBAL:\n435\t\t\t\t\t\ttx->state = PSBT_ST_INPUTS_NEW;\n436\t\t\t\t\t\tbreak;\n437\t\n438\t\t\t\t\tcase PSBT_ST_INPUTS:\n439\t\t\t\t\t\tif (++kvs >= counter.inputs) {\n440\t\t\t\t\t\t\ttx->state = PSBT_ST_OUTPUTS_NEW;\n441\t\t\t\t\t\t\tkvs = 0;\n442\t\t\t\t\t\t} else\n443\t\t\t\t\t\t\ttx->state = PSBT_ST_INPUTS_NEW;\n444\t\t\t\t\t\tbreak;\n445\t\n446\t\t\t\t\tcase PSBT_ST_OUTPUTS:\n447\t\t\t\t\t\tif (++kvs >= counter.outputs)\n448\t\t\t\t\t\t\ttx->state = PSBT_ST_FINALIZED;\n449\t\t\t\t\t\telse\n450\t\t\t\t\t\t\ttx->state = PSBT_ST_OUTPUTS_NEW;\n451\t\t\t\t\t\tbreak;\n452\t\n453\t\t\t\t\tdefault:\n454\t\t\t\t\t\tassert(!\"psbt_read: invalid state at null byte\");\n455\t\t\t\t\t}\n456\t\t\t\t}\n457\t\t\t\telse {\n458\t\t\t\t\tdebug(\"reading record @ %zu\\n\", tx->write_pos - tx->data);\n459\t\t\t\t\tres = psbt_read_record(tx, src_size, &rec);\n460\t\n461\t\t\t\t\tif (res != PSBT_OK)\n462\t\t\t\t\t\treturn res;\n463\t\n464\t\t\t\t\tif (tx->state == PSBT_ST_GLOBAL &&\n465\t\t\t\t\t    rec.type == PSBT_GLOBAL_UNSIGNED_TX) {\n466\t\t\t\t\t\t// parse transaction for number of inputs/outputs\n467\t\t\t\t\t\tres = psbt_btc_tx_parse(rec.val,\n468\t\t\t\t\t\t\t\t\trec.val_size,\n469\t\t\t\t\t\t\t\t\t(void*)&counter,\n470\t\t\t\t\t\t\t\t\ttx_counter);\n471\t\n472\t\t\t\t\t\tif (res != PSBT_OK)\n473\t\t\t\t\t\t\treturn res;\n474\t\t\t\t\t}\n475\t\n476\t\t\t\t\t// record callback\n477\t\t\t\t\tif (elem_handler) {\n478\t\t\t\t\t\telem.type = PSBT_ELEM_RECORD;\n479\t\t\t\t\t\telem.index = kvs;\n480\t\t\t\t\t\telem.elem.rec = &rec;\n481\t\t\t\t\t\telem_handler(&elem);\n482\t\t\t\t\t}\n483\t\t\t\t}\n484\t\n485\t\n486\t\t\t\tbreak;\n487\t\n488\t\t\tcase PSBT_ST_OUTPUTS_NEW:\n489\t\t\t\tassert(*tx->write_pos == 0);\n490\t\t\t\ttx->write_pos++;\n491\t\t\t\ttx->state = PSBT_ST_OUTPUTS;\n492\t\t\t\tbreak;\n493\t\n494\t\t\tcase PSBT_ST_INPUTS_NEW:\n495\t\t\t\tassert(*tx->write_pos == 0);\n496\t\t\t\ttx->write_pos++;\n497\t\t\t\ttx->state = PSBT_ST_INPUTS;\n498\t\t\t\tbreak;\n499\t\n500\t\t\tcase PSBT_ST_FINALIZED:\n501\t\t\t\tassert(!\"impossible\");\n502\t\t\t\tbreak;\n503\t\t\t}\n504\t\t}\n505\t\n506\t\tif (tx->state != PSBT_ST_FINALIZED) {\n507\t\t\tpsbt_errmsg = \"psbt_read: invalid psbt\";\n508\t\t\treturn PSBT_INVALID_STATE;\n509\t\t}\n510\t\telse if (tx->state == PSBT_ST_FINALIZED && *tx->write_pos != 0) {\n511\t\t\tpsbt_errmsg = \"psbt_read: expected null byte at end of psbt\";\n512\t\t\treturn PSBT_READ_ERROR;\n513\t\t}\n514\t\n515\t\ttx->write_pos++;\n516\t\n517\t\treturn PSBT_OK;\n518\t}\n519\t\n520\tenum psbt_result\n521\tpsbt_write_global_record(struct psbt *tx, struct psbt_record *rec) {\n522\t\tif (tx->state == PSBT_ST_INIT) {\n523\t\t\t// write header if we haven't yet\n524\t\t\tpsbt_write_header(tx);\n525\t\t\ttx->state = PSBT_ST_GLOBAL;\n526\t\t}\n527\t\telse if (tx->state != PSBT_ST_GLOBAL) {\n528\t\t\tpsbt_errmsg = \"psbt_write_global_record: you can only write a \"\n529\t\t\t\t\"global record after psbt_init and before \"\n530\t\t\t\t\"psbt_write_input_record\";\n531\t\t\treturn PSBT_INVALID_STATE;\n532\t\t}\n533\t\n534\t\treturn psbt_write_record(tx, rec);\n535\t}\n536\t\n537\tenum psbt_result\n538\tpsbt_new_input_record_set(struct psbt *tx) {\n539\t\tenum psbt_result res;\n540\t\tif (tx->state == PSBT_ST_GLOBAL\n541\t\t || tx->state == PSBT_ST_INPUTS_NEW\n542\t\t || tx->state == PSBT_ST_INPUTS) {\n543\t\t\tres = psbt_close_records(tx);\n544\t\t\tif (res != PSBT_OK)\n545\t\t\t\treturn res;\n546\t\t\ttx->state = PSBT_ST_INPUTS_NEW;\n547\t\t\treturn PSBT_OK;\n548\t\t}\n549\t\telse if (tx->state != PSBT_ST_INPUTS) {\n550\t\t\tpsbt_errmsg = \"psbt_new_input_record_set: \"\n551\t\t\t\t\"this can only be called after psbt_write_global_record, \"\n552\t                        \"psbt_new_input_record_set, \"\n553\t\t\t\t\"or psbt_write_input_record\";\n554\t\t\treturn PSBT_INVALID_STATE;\n555\t\t}\n556\t\n557\t\treturn psbt_close_records(tx);\n558\t}\n559\t\n560\t\n561\tenum psbt_result\n562\tpsbt_new_output_record_set(struct psbt *tx) {\n563\t\tenum psbt_result res;\n564\t\tif (tx->state == PSBT_ST_INPUTS\n565\t\t    || tx->state == PSBT_ST_INPUTS_NEW\n566\t\t    || tx->state == PSBT_ST_OUTPUTS_NEW\n567\t\t    || tx->state == PSBT_ST_OUTPUTS)\n568\t\t{\n569\t\t\tres = psbt_close_records(tx);\n570\t\t\tif (res != PSBT_OK)\n571\t\t\t\treturn res;\n572\t\t\ttx->state = PSBT_ST_OUTPUTS_NEW;\n573\t\t\treturn PSBT_OK;\n574\t\t}\n575\t\telse if (tx->state != PSBT_ST_OUTPUTS) {\n576\t\t\tpsbt_errmsg = \"psbt_new_output_record_set: \"\n577\t\t\t\t\"this can only be called after writing input records\";\n578\t\t\treturn PSBT_INVALID_STATE;\n579\t\t}\n580\t\n581\t\treturn psbt_close_records(tx);\n582\t}\n583\t\n584\t\n585\tenum psbt_result\n586\tpsbt_print(struct psbt *tx, FILE *stream) {\n587\t\tif (tx->state != PSBT_ST_FINALIZED) {\n588\t\t\tpsbt_errmsg = \"psbt_print: transaction is not finished\";\n589\t\t\treturn PSBT_INVALID_STATE;\n590\t\t}\n591\t\n592\t\tsize_t size = psbt_size(tx);\n593\t\tfor (size_t i = 0; i < size; ++i)\n594\t\t\tfprintf(stream, \"%02x\", tx->data[i]);\n595\t\tprintf(\"\\n\");\n596\t\n597\t\treturn PSBT_OK;\n598\t}\n599\t\n600\tenum psbt_result\n601\tpsbt_write_input_record(struct psbt *tx, struct psbt_record *rec) {\n602\t\tenum psbt_result res;\n603\t\tif (tx->state == PSBT_ST_GLOBAL) {\n604\t\t\t// close global records\n605\t\t\tif ((res = psbt_close_records(tx)) != PSBT_OK)\n606\t\t\t\treturn res;\n607\t\t\ttx->state = PSBT_ST_INPUTS;\n608\t\t}\n609\t\telse if (tx->state != PSBT_ST_INPUTS && tx->state != PSBT_ST_INPUTS_NEW) {\n610\t\t\tpsbt_errmsg = \"psbt_write_input_record: attempting to write an \"\n611\t\t\t\t\"input record before any global records have been written.\"\n612\t\t\t\t\" use psbt_write_global_record first\";\n613\t\t\treturn PSBT_INVALID_STATE;\n614\t\t}\n615\t\n616\t\treturn psbt_write_record(tx, rec);\n617\t}\n618\t\n619\t\n620\tenum psbt_result\n621\tpsbt_write_output_record(struct psbt *tx, struct psbt_record *rec) {\n622\t\tenum psbt_result res;\n623\t\tif (tx->state == PSBT_ST_INPUTS) {\n624\t\t\t// close global records\n625\t\t\tif ((res = psbt_close_records(tx)) != PSBT_OK)\n626\t\t\t\treturn res;\n627\t\t\ttx->state = PSBT_ST_OUTPUTS;\n628\t\t}\n629\t\telse if (tx->state != PSBT_ST_OUTPUTS && tx->state != PSBT_ST_OUTPUTS_NEW) {\n630\t\t\tpsbt_errmsg = \"psbt_write_input_record: attempting to write an \"\n631\t\t\t\t\"input record before any global records have been written.\"\n632\t\t\t\t\" use psbt_write_global_record first\";\n633\t\t\treturn PSBT_INVALID_STATE;\n634\t\t}\n635\t\n636\t\treturn psbt_write_record(tx, rec);\n637\t}\n638\t\n639\t\n640\tstatic inline u8 hexdigit( char hex ) {\n641\t\treturn (hex <= '9') ? hex - '0' : toupper(hex) - 'A' + 10 ;\n642\t}\n643\t\n644\tenum psbt_result\n645\tpsbt_hex_decode(const char *src, size_t src_size, unsigned char *dest,\n646\t\t        size_t dest_size) {\n647\t\n648\t\tenum psbt_result res = PSBT_OK;\n649\t\n650\t\tif (src_size % 2 != 0) {\n651\t\t\tpsbt_errmsg = \"psbt_decode: invalid hex string\";\n652\t\t\treturn PSBT_READ_ERROR;\n653\t\t}\n654\t\n655\t\tif (dest_size < src_size / 2) {\n656\t\t\tpsbt_errmsg = \"psbt_decode: dest_size must be at least half the\"\n657\t\t\t\t\" size of src_size\";\n658\t\t\treturn PSBT_READ_ERROR;\n659\t\t}\n660\t\n661\t\tif (res != PSBT_OK)\n662\t\t\treturn res;\n663\t\n664\t\tfor (size_t i = 0; i < src_size; i += 2) {\n665\t\t\tu8 c1 = src[i];\n666\t\t\tu8 c2 = src[i+1];\n667\t\t\tif (!isxdigit(c1) || !isxdigit(c2)) {\n668\t\t\t\tpsbt_errmsg = \"psbt_decode: invalid hex string\";\n669\t\t\t\treturn PSBT_READ_ERROR;\n670\t\t\t}\n671\t\n672\t\t\t*dest++ = hexdigit(c1) << 4 | hexdigit(c2);\n673\t\t}\n674\t\n675\t\treturn PSBT_OK;\n676\t}\n677\t\n678\tenum psbt_result\n679\tpsbt_decode(const char *src, size_t src_size, unsigned char *dest,\n680\t\t    size_t dest_size, size_t *psbt_size) {\n681\t\tenum psbt_result res;\n682\t\t// TODO: detect base64 or hex encoding\n683\t\t// default is hex encoding for now\n684\t\n685\t\tsize_t b64_magic_size = sizeof(\"cHNid\") - 1;\n686\t\n687\t\t// simple sanity check before we look for base64 encoding\n688\t\tif (src_size < b64_magic_size) {\n689\t\t\tpsbt_errmsg = \"psbt_decode: psbt too small\";\n690\t\t\treturn PSBT_READ_ERROR;\n691\t\t}\n692\t\n693\t\t// base64 detection\n694\t\tif (memcmp(src, \"cHNid\", b64_magic_size) == 0) {\n695\t\t\tu8 *c = base64_decode((unsigned char*)src, src_size, dest,\n696\t\t\t\t\t\tdest_size, psbt_size);\n697\t\t\treturn c == NULL ? PSBT_READ_ERROR : PSBT_OK;\n698\t\t}\n699\t\n700\t\t*psbt_size = src_size / 2;\n701\t\treturn psbt_hex_decode(src, src_size, dest, dest_size);\n702\t}\n703\t\n704\tstatic char hexchar(unsigned int val)\n705\t{\n706\t\tif (val < 10)\n707\t\t\treturn '0' + val;\n708\t\tif (val < 16)\n709\t\t\treturn 'a' + val - 10;\n710\t\tassert(!\"hexchar invalid val\");\n711\t}\n712\t\n713\tstatic enum psbt_result\n714\thex_encode(u8 *buf, size_t bufsize, u8 *dest, size_t dest_size) {\n715\t\tsize_t i;\n716\t\n717\t\tif (dest_size < bufsize * 2 + 1)\n718\t\t\treturn PSBT_OOB_WRITE;\n719\t\n720\t\tfor (i = 0; i < bufsize; i++) {\n721\t\t\tunsigned int c = buf[i];\n722\t\t\t*(dest++) = hexchar(c >> 4);\n723\t\t\t*(dest++) = hexchar(c & 0xF);\n724\t\t}\n725\t\t*dest = '\\0';\n726\t\n727\t\treturn PSBT_OK;\n728\t}\n729\t\n730\t/* static enum psbt_result */\n731\t/* base64_encode(u8 *psbt, size_t psbt_size, u8 *dest, size_t dest_size) { */\n732\t/* \treturn PSBT_NOT_IMPLEMENTED; */\n733\t/* } */\n734\t\n735\tstatic enum psbt_result\n736\tprotobuf_encode(u8 *psbt, size_t psbt_size, u8 *dest, size_t dest_size) {\n737\t\treturn PSBT_NOT_IMPLEMENTED;\n738\t}\n739\t\n740\tenum psbt_result\n741\tpsbt_encode_raw(unsigned char *psbt_data, size_t psbt_len,\n742\t\t\tenum psbt_encoding encoding, unsigned char *dest,\n743\t\t\tsize_t dest_size, size_t* out_len)\n744\t{\n745\t\tu8 *c;\n746\t\tenum psbt_result res;\n747\t\n748\t\tswitch (encoding) {\n749\t\tcase PSBT_ENCODING_HEX:\n750\t\t\tres = hex_encode(psbt_data, psbt_len, dest, dest_size);\n751\t\t\t*out_len = psbt_len * 2 + 1;\n752\t\t\treturn res;\n753\t\tcase PSBT_ENCODING_BASE64:\n754\t\t\tc = base64_encode(psbt_data, psbt_len, dest, dest_size, out_len);\n755\t\t\tif (c == NULL) {\n756\t\t\t\tpsbt_errmsg = \"psbt_encode: base64 encode failure\";\n757\t\t\t\treturn PSBT_WRITE_ERROR;\n758\t\t\t}\n759\t\t\treturn PSBT_OK;\n760\t\tcase PSBT_ENCODING_BASE62:\n761\t\t\tc = base62_encode(psbt_data, psbt_len, dest, dest_size, out_len);\n762\t\t\tif (c == NULL) {\n763\t\t\t\tpsbt_errmsg = \"psbt_encode: base62 encode failure\";\n764\t\t\t\treturn PSBT_WRITE_ERROR;\n765\t\t\t}\n766\t\t\treturn PSBT_OK;\n767\t\tcase PSBT_ENCODING_PROTOBUF:\n768\t\t\treturn protobuf_encode(psbt_data, psbt_len, dest, dest_size);\n769\t\t}\n770\t\n771\t\tpsbt_errmsg = \"psbt_encode: invalid psbt_encoding enum value\";\n772\t\treturn PSBT_NOT_IMPLEMENTED;\n773\t}\n774\t\n775\tenum psbt_result\n776\tpsbt_encode(struct psbt *psbt, enum psbt_encoding encoding, unsigned char *dest,\n777\t\t    size_t dest_size, size_t *out_len)\n778\t{\n779\t\tif (psbt->state != PSBT_ST_FINALIZED) {\n780\t\t\tpsbt_errmsg = \"psbt_encode: psbt not in finalized state. \"\n781\t\t\t\t\"use psbt_read to parse an existing psbt, or the \"\n782\t\t\t\t\"psbt_write functions to create one.\";\n783\t\n784\t\t\treturn PSBT_WRITE_ERROR;\n785\t\t}\n786\t\n787\t\treturn psbt_encode_raw(psbt->data, psbt_size(psbt), encoding, dest,\n788\t\t\t\t       dest_size, out_len);\n789\t}\n790\t\n791\t\n792\tconst char *\n793\tpsbt_geterr() {\n794\t\treturn psbt_errmsg;\n795\t}\n796\t"}]},"parent_tool_use_id":null,"session_id":"e8aa6589-65c1-4bb0-b0d4-bf0e3554d148","uuid":"564d40d7-e4c4-4f96-ad74-c0499c15647c","timestamp":"2026-06-06T05:42:08.330Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-aiZ14w/project/c_src/psbt.c","content":"\n#define _DEFAULT_SOURCE\n\n#include <stdio.h>\n#include <ctype.h>\n#include <string.h>\n#include <endian.h>\n#include <assert.h>\n#include <inttypes.h>\n#include \"compactsize.h\"\n#include \"tx.h\"\n#include \"base64.h\"\n\n#ifdef DEBUG\n  #define debug(...) fprintf(stderr, __VA_ARGS__)\n#else\n  #define debug(...)\n#endif\n\nchar *psbt_errmsg = NULL;\n\nconst unsigned char PSBT_MAGIC[4] = {0x70, 0x73, 0x62, 0x74};\n\n#define ASSERT_SPACE(s) \\\n\tif (tx->write_pos+(s) > tx->data + tx->data_capacity) { \\\n\t\tpsbt_errmsg = \"write out of bounds \" __FILE__ \":\" STRINGIZE(__LINE__); \\\n\t\treturn PSBT_OOB_WRITE; \\\n\t}\n\nsize_t psbt_size(struct psbt *tx) {\n\treturn tx->write_pos - tx->data;\n}\n\nstatic void hex_print(unsigned char *data, size_t len) {\n\tfor (size_t i = 0; i < len; ++i)\n\t\tprintf(\"%02x\", data[i]);\n}\n\n\n\nstatic enum psbt_result\npsbt_write_header(struct psbt *tx) {\n\tASSERT_SPACE(sizeof(PSBT_MAGIC));\n\tmemcpy(tx->write_pos, PSBT_MAGIC, sizeof(PSBT_MAGIC));\n\ttx->write_pos += sizeof(PSBT_MAGIC);\n\n\tASSERT_SPACE(1);\n\t*tx->write_pos = 0xff;\n\ttx->write_pos++;\n\n\ttx->state = PSBT_ST_GLOBAL;\n\n\treturn PSBT_OK;\n}\n\n\nenum psbt_result\npsbt_init(struct psbt *tx, unsigned char *dest, size_t dest_size) {\n\ttx->write_pos = dest;\n\ttx->data = dest;\n\ttx->data_capacity = dest_size;\n\ttx->state = PSBT_ST_INIT;\n\treturn PSBT_OK;\n}\n\n/* enum psbt_result */\n/* psbt_end_transaction(char *dest, size_t dest_len) */\n/* { */\n/* \tASSERT_SPACE(1); */\n/* \t*dest =  */\n/* } */\n\n\nenum psbt_result\npsbt_close_records(struct psbt *tx) {\n\tASSERT_SPACE(1);\n\t*tx->write_pos = '\\0';\n\ttx->write_pos++;\n\treturn PSBT_OK;\n}\n\n\nenum psbt_result\npsbt_finalize(struct psbt *tx) {\n\tenum psbt_result res;\n\n\tif (tx->state != PSBT_ST_OUTPUTS_NEW && tx->state != PSBT_ST_OUTPUTS) {\n\t\tpsbt_errmsg = \"psbt_finalize: no output records found\";\n\t\treturn PSBT_INVALID_STATE;\n\t}\n\n\tres = psbt_close_records(tx);\n\tif (res != PSBT_OK)\n\t\treturn res;\n\n\ttx->state = PSBT_ST_FINALIZED;\n\n\treturn PSBT_OK;\n}\n\nstatic enum psbt_result\npsbt_write_record(struct psbt *tx, struct psbt_record *rec) {\n\tu32 size;\n\tu32 key_size_with_type = rec->key_size + 1;\n\n\t// write key length\n\tsize = compactsize_length(key_size_with_type);\n\tASSERT_SPACE(size);\n\tcompactsize_write((u8*)tx->write_pos, key_size_with_type);\n\ttx->write_pos += size;\n\n\t// write type\n\tASSERT_SPACE(1);\n\t*tx->write_pos++ = rec->type;\n\n\t// write key\n\tASSERT_SPACE(rec->key_size);\n\tmemcpy(tx->write_pos, rec->key, rec->key_size);\n\ttx->write_pos += rec->key_size;\n\n\t// write value length\n\tsize = compactsize_length(rec->val_size);\n\tASSERT_SPACE(size);\n\tcompactsize_write((u8*)tx->write_pos, rec->val_size);\n\ttx->write_pos += size;\n\n\t// write value\n\tASSERT_SPACE(rec->val_size);\n\tmemcpy(tx->write_pos, rec->val, rec->val_size);\n\ttx->write_pos += rec->val_size;\n\n\treturn PSBT_OK;\n}\n\nstatic enum psbt_result\npsbt_read_header(struct psbt *tx) {\n\tASSERT_SPACE(4);\n\n\tdebug(\"magic %02X %02X %02X %02X\\n\",\n\t\t*tx->write_pos,\n\t\t*(tx->write_pos+1),\n\t\t*(tx->write_pos+2),\n\t\t*(tx->write_pos+3));\n\n\tif (memcmp(tx->write_pos, PSBT_MAGIC, sizeof(PSBT_MAGIC)) != 0) {\n\t\tpsbt_errmsg = \"psbt_read: invalid magic header\";\n\t\treturn PSBT_READ_ERROR;\n\t}\n\n\ttx->write_pos += 4;\n\n\tif (*tx->write_pos++ != 0xff) {\n\t\tpsbt_errmsg = \"psbt_read: no 0xff found after magic\";\n\t\treturn PSBT_READ_ERROR;\n\t}\n\n\ttx->state = PSBT_ST_GLOBAL;\n\n\treturn PSBT_OK;\n}\n\nconst char *\npsbt_input_type_tostr(enum psbt_input_type type) {\n\tswitch (type) {\n\tcase PSBT_IN_NON_WITNESS_UTXO:\n\t\treturn \"IN_NON_WITNESS_UTXO\";\n\tcase PSBT_IN_WITNESS_UTXO:\n\t\treturn \"IN_WITNESS_UTXO\";\n\tcase PSBT_IN_PARTIAL_SIG:\n\t\treturn \"IN_PARTIAL_SIG\";\n\tcase PSBT_IN_SIGHASH_TYPE:\n\t\treturn \"IN_SIGHASH_TYPE\";\n\tcase PSBT_IN_REDEEM_SCRIPT:\n\t\treturn \"IN_REDEEM_SCRIPT\";\n\tcase PSBT_IN_WITNESS_SCRIPT:\n\t\treturn \"IN_WITNESS_SCRIPT\";\n\tcase PSBT_IN_BIP32_DERIVATION:\n\t\treturn \"IN_BIP32_DERIVATION\";\n\tcase PSBT_IN_FINAL_SCRIPTSIG:\n\t\treturn \"IN_FINAL_SCRIPTSIG\";\n\tcase PSBT_IN_FINAL_SCRIPTWITNESS:\n\t\treturn \"IN_FINAL_SCRIPTWITNESS\";\n\t}\n\n\treturn \"UNKNOWN_INPUT_TYPE\";\n}\n\nconst char *\npsbt_state_tostr(enum psbt_state state) {\n\tswitch (state) {\n\tcase PSBT_ST_INIT:\n\t\treturn \"INIT\";\n\tcase PSBT_ST_GLOBAL:\n\t\treturn \"GLOBAL\";\n\tcase PSBT_ST_INPUTS:\n\t\treturn \"INPUTS\";\n\tcase PSBT_ST_INPUTS_NEW:\n\t\treturn \"INPUTS_NEW\";\n\tcase PSBT_ST_OUTPUTS:\n\t\treturn \"OUTPUTS\";\n\tcase PSBT_ST_OUTPUTS_NEW:\n\t\treturn \"OUTPUTS_NEW\";\n\tcase PSBT_ST_FINALIZED:\n\t\treturn \"FINALIZED\";\n\t}\n\n\treturn \"UNKNOWN_STATE\";\n}\n\nconst char *\npsbt_output_type_tostr(enum psbt_output_type type) {\n\tswitch (type) {\n\tcase PSBT_OUT_REDEEM_SCRIPT:\n\t\treturn \"OUT_REDEEM_SCRIPT\";\n\tcase PSBT_OUT_WITNESS_SCRIPT:\n\t\treturn \"OUT_WITNESS_SCRIPT\";\n\tcase PSBT_OUT_BIP32_DERIVATION:\n\t\treturn \"OUT_BIP32_DERIVATION\";\n\t}\n\n\treturn \"UNKNOWN_OUTPUT_TYPE\";\n}\n\nconst char *\npsbt_global_type_tostr(enum psbt_global_type type) {\n\tswitch (type) {\n\tcase PSBT_GLOBAL_UNSIGNED_TX: return \"GLOBAL_UNSIGNED_TX\";\n\t}\n\n\treturn \"UNKNOWN_GLOBAL_TYPE\";\n}\n\nconst char *\npsbt_txelem_type_tostr(enum psbt_txelem_type txelem_type) {\n\tswitch (txelem_type) {\n\tcase PSBT_TXELEM_TX:\n\t\treturn \"TX\";\n\tcase PSBT_TXELEM_TXIN:\n\t\treturn \"TXIN\";\n\tcase PSBT_TXELEM_TXOUT:\n\t\treturn \"TXOUT\";\n\tcase PSBT_TXELEM_WITNESS_ITEM:\n\t\treturn \"WITNESS_ITEM\";\n\t}\n\n\treturn \"UNKNOWN_TXELEM\";\n}\n\nconst char *\npsbt_type_tostr(unsigned char type, enum psbt_scope scope) {\n\tswitch (scope) {\n\tcase PSBT_SCOPE_GLOBAL:\n\t\treturn psbt_global_type_tostr((enum psbt_global_type)type);\n\tcase PSBT_SCOPE_INPUTS:\n\t\treturn psbt_input_type_tostr((enum psbt_input_type)type);\n\tcase PSBT_SCOPE_OUTPUTS:\n\t\treturn psbt_output_type_tostr((enum psbt_output_type)type);\n\t}\n\n\treturn \"UNKNOWN_SCOPE\";\n}\n\nstatic enum psbt_result\npsbt_read_record(struct psbt *tx, size_t src_size, struct psbt_record *rec)\n{\n\tenum psbt_result res = PSBT_OK;\n\tu64 size;\n\tu32 size_len;\n\n\tsize_len = compactsize_peek_length(*tx->write_pos);\n\tASSERT_SPACE(size_len);\n\tsize = compactsize_read(tx->write_pos, &res);\n\tassert(size > 0);\n\n\ttx->write_pos += size_len;\n\n\tdebug(\"record pos %zu size_len %d size %\"PRIu64\"\\n\",\n\t      tx->write_pos - tx->data, size_len, size);\n\n\tif (res != PSBT_OK)\n\t\treturn res;\n\n\tif (tx->write_pos + size > tx->data + src_size) {\n\t\tpsbt_errmsg = \"psbt_read: record key size too large\";\n\t\treturn PSBT_READ_ERROR;\n\t}\n\n\tASSERT_SPACE(size);\n\n\trec->key_size = size - 1; // don't include type in key size\n\trec->type = *tx->write_pos;\n\trec->key = tx->write_pos + 1;\n\n\ttx->write_pos += size;\n\tdebug(\"%02x %02x %02x %02x %02x\\n\", *(tx->write_pos-2), *(tx->write_pos-1),\n\t      *tx->write_pos, *(tx->write_pos+1), *(tx->write_pos+2));\n\n\tdebug(\"record pos %zu size_len %d size %\"PRIu64\"\\n\",\n\t      tx->write_pos - tx->data, size_len, size);\n\n\tswitch (tx->state) {\n\t\tcase PSBT_ST_GLOBAL:\n\t\t\trec->scope = PSBT_SCOPE_GLOBAL;\n\t\t\tbreak;\n\n\t\tcase PSBT_ST_INPUTS:\n\t\t\trec->scope = PSBT_SCOPE_INPUTS;\n\t\t\tbreak;\n\n\t\tcase PSBT_ST_OUTPUTS:\n\t\t\trec->scope = PSBT_SCOPE_OUTPUTS;\n\t\t\tbreak;\n\n\t\tdefault:\n\t\t\tpsbt_errmsg = \"psbt_read_record: invalid record state\";\n\t\t\treturn PSBT_INVALID_STATE;\n\t}\n\n\tsize_len = compactsize_peek_length(*tx->write_pos);\n\n\tASSERT_SPACE(size_len);\n\tsize = compactsize_read(tx->write_pos, &res);\n\n\tif (res != PSBT_OK)\n\t\treturn res;\n\n\ttx->write_pos += size_len;\n\n\tif (tx->write_pos + size > tx->data + src_size) {\n\t\tpsbt_errmsg = \"psbt_read: record value size too large\";\n\t\treturn PSBT_READ_ERROR;\n\t}\n\n\trec->val_size = size;\n\trec->val = tx->write_pos;\n\n\tASSERT_SPACE(size);\n\ttx->write_pos += size;\n\n\treturn PSBT_OK;\n}\n\nstruct psbt_tx_counter {\n\tint inputs;\n\tint outputs;\n\tvoid *user_data;\n\tpsbt_elem_handler *handler;\n} counter;\n\nstatic void tx_counter(struct psbt_txelem *elem) {\n\tstruct psbt_elem psbt_elem;\n\tstruct psbt_tx_counter *counter =\n\t\t(struct psbt_tx_counter *)elem->user_data;\n\n\tpsbt_elem.user_data = counter->user_data;\n\tpsbt_elem.type = PSBT_ELEM_TXELEM;\n\tpsbt_elem.elem.txelem = elem;\n\n\t// forward txelem events to user\n\tif (counter->handler)\n\t\tcounter->handler(&psbt_elem);\n\n\tswitch (elem->elem_type) {\n\tcase PSBT_TXELEM_TXIN:\n\t\tcounter->inputs++;\n\t\treturn;\n\tcase PSBT_TXELEM_TXOUT:\n\t\tcounter->outputs++;\n\t\treturn;\n\tdefault:\n\t\treturn;\n\t}\n}\n\nenum psbt_result\npsbt_read(const unsigned char *src, size_t src_size, struct psbt *tx,\n\t  psbt_elem_handler *elem_handler, void* user_data)\n{\n\tstruct psbt_record rec;\n\tenum psbt_result res;\n\n\tstruct psbt_elem elem;\n\telem.type = PSBT_ELEM_RECORD;\n\telem.user_data = user_data;\n\n\tint kvs = 0;\n\tu8 *end;\n\n\tstruct psbt_tx_counter counter = {\n\t\t.inputs = 0,\n\t\t.outputs = 0,\n\t\t.user_data = user_data,\n\t\t.handler = elem_handler,\n\t};\n\n\tif (tx->state != PSBT_ST_INIT) {\n\t\tpsbt_errmsg = \"psbt_read: psbt not initialized, use psbt_init first\";\n\t\treturn PSBT_INVALID_STATE;\n\t}\n\n\tif (src_size > tx->data_capacity) {\n\t\tpsbt_errmsg = \"psbt_read: read buffer is larger than psbt capacity\";\n\t\treturn PSBT_OOB_WRITE;\n\t}\n\n\tif (src != tx->data)\n\t\tmemcpy(tx->data, src, src_size);\n\n\t// parsing should try to get this to the finalized state,\n\t// otherwise it's an invalid psbt\n\ttx->state = PSBT_ST_INIT;\n\ttx->write_pos = tx->data;\n\n\t// XXX: needed so that the asserts work properly. this is probably fine...\n\ttx->data_capacity = src_size;\n\n\tend = tx->data + src_size;\n\n\twhile (tx->state != PSBT_ST_FINALIZED && tx->write_pos <= end) {\n\t\tswitch(tx->state) {\n\t\tcase PSBT_ST_INIT:\n\t\t\tdebug(\"reading header at %zu\\n\", tx->write_pos - tx->data);\n\t\t\tres = psbt_read_header(tx);\n\t\t\tif (res != PSBT_OK)\n\t\t\t\treturn res;\n\t\t\tbreak;\n\n\t\tcase PSBT_ST_GLOBAL:\n\t\tcase PSBT_ST_INPUTS:\n\t\tcase PSBT_ST_OUTPUTS:\n\n\t\t\tif (*tx->write_pos == 0) {\n\t\t\t\tswitch (tx->state) {\n\t\t\t\tcase PSBT_ST_GLOBAL:\n\t\t\t\t\ttx->state = PSBT_ST_INPUTS_NEW;\n\t\t\t\t\tbreak;\n\n\t\t\t\tcase PSBT_ST_INPUTS:\n\t\t\t\t\tif (++kvs >= counter.inputs) {\n\t\t\t\t\t\ttx->state = PSBT_ST_OUTPUTS_NEW;\n\t\t\t\t\t\tkvs = 0;\n\t\t\t\t\t} else\n\t\t\t\t\t\ttx->state = PSBT_ST_INPUTS_NEW;\n\t\t\t\t\tbreak;\n\n\t\t\t\tcase PSBT_ST_OUTPUTS:\n\t\t\t\t\tif (++kvs >= counter.outputs)\n\t\t\t\t\t\ttx->state = PSBT_ST_FINALIZED;\n\t\t\t\t\telse\n\t\t\t\t\t\ttx->state = PSBT_ST_OUTPUTS_NEW;\n\t\t\t\t\tbreak;\n\n\t\t\t\tdefault:\n\t\t\t\t\tassert(!\"psbt_read: invalid state at null byte\");\n\t\t\t\t}\n\t\t\t}\n\t\t\telse {\n\t\t\t\tdebug(\"reading record @ %zu\\n\", tx->write_pos - tx->data);\n\t\t\t\tres = psbt_read_record(tx, src_size, &rec);\n\n\t\t\t\tif (res != PSBT_OK)\n\t\t\t\t\treturn res;\n\n\t\t\t\tif (tx->state == PSBT_ST_GLOBAL &&\n\t\t\t\t    rec.type == PSBT_GLOBAL_UNSIGNED_TX) {\n\t\t\t\t\t// parse transaction for number of inputs/outputs\n\t\t\t\t\tres = psbt_btc_tx_parse(rec.val,\n\t\t\t\t\t\t\t\trec.val_size,\n\t\t\t\t\t\t\t\t(void*)&counter,\n\t\t\t\t\t\t\t\ttx_counter);\n\n\t\t\t\t\tif (res != PSBT_OK)\n\t\t\t\t\t\treturn res;\n\t\t\t\t}\n\n\t\t\t\t// record callback\n\t\t\t\tif (elem_handler) {\n\t\t\t\t\telem.type = PSBT_ELEM_RECORD;\n\t\t\t\t\telem.index = kvs;\n\t\t\t\t\telem.elem.rec = &rec;\n\t\t\t\t\telem_handler(&elem);\n\t\t\t\t}\n\t\t\t}\n\n\n\t\t\tbreak;\n\n\t\tcase PSBT_ST_OUTPUTS_NEW:\n\t\t\tassert(*tx->write_pos == 0);\n\t\t\ttx->write_pos++;\n\t\t\ttx->state = PSBT_ST_OUTPUTS;\n\t\t\tbreak;\n\n\t\tcase PSBT_ST_INPUTS_NEW:\n\t\t\tassert(*tx->write_pos == 0);\n\t\t\ttx->write_pos++;\n\t\t\ttx->state = PSBT_ST_INPUTS;\n\t\t\tbreak;\n\n\t\tcase PSBT_ST_FINALIZED:\n\t\t\tassert(!\"impossible\");\n\t\t\tbreak;\n\t\t}\n\t}\n\n\tif (tx->state != PSBT_ST_FINALIZED) {\n\t\tpsbt_errmsg = \"psbt_read: invalid psbt\";\n\t\treturn PSBT_INVALID_STATE;\n\t}\n\telse if (tx->state == PSBT_ST_FINALIZED && *tx->write_pos != 0) {\n\t\tpsbt_errmsg = \"psbt_read: expected null byte at end of psbt\";\n\t\treturn PSBT_READ_ERROR;\n\t}\n\n\ttx->write_pos++;\n\n\treturn PSBT_OK;\n}\n\nenum psbt_result\npsbt_write_global_record(struct psbt *tx, struct psbt_record *rec) {\n\tif (tx->state == PSBT_ST_INIT) {\n\t\t// write header if we haven't yet\n\t\tpsbt_write_header(tx);\n\t\ttx->state = PSBT_ST_GLOBAL;\n\t}\n\telse if (tx->state != PSBT_ST_GLOBAL) {\n\t\tpsbt_errmsg = \"psbt_write_global_record: you can only write a \"\n\t\t\t\"global record after psbt_init and before \"\n\t\t\t\"psbt_write_input_record\";\n\t\treturn PSBT_INVALID_STATE;\n\t}\n\n\treturn psbt_write_record(tx, rec);\n}\n\nenum psbt_result\npsbt_new_input_record_set(struct psbt *tx) {\n\tenum psbt_result res;\n\tif (tx->state == PSBT_ST_GLOBAL\n\t || tx->state == PSBT_ST_INPUTS_NEW\n\t || tx->state == PSBT_ST_INPUTS) {\n\t\tres = psbt_close_records(tx);\n\t\tif (res != PSBT_OK)\n\t\t\treturn res;\n\t\ttx->state = PSBT_ST_INPUTS_NEW;\n\t\treturn PSBT_OK;\n\t}\n\telse if (tx->state != PSBT_ST_INPUTS) {\n\t\tpsbt_errmsg = \"psbt_new_input_record_set: \"\n\t\t\t\"this can only be called after psbt_write_global_record, \"\n                        \"psbt_new_input_record_set, \"\n\t\t\t\"or psbt_wr