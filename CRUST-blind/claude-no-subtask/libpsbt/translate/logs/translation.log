 out_buf, 4096, &mut out_len);\n    assert_eq!(res, PsbtResult::Ok);\n    assert_eq!(out_len, psbt_hex.len() + 1);\n    let encoded_hex = std::str::from_utf8(&out_buf[..psbt_hex.len()]).unwrap();\n    assert_eq!(encoded_hex, psbt_hex);\n}\n\n#[test]\nfn test_empty_input_base64_decode() {\n    let empty_inputs = \"cHNidP8BACoCAAAAAAGA8PoCAAAAABepFCufG2xKKzFR7+3XGjiAZPO/VDBkhwAAAAAAAA==\";\n    let mut buf = vec![0u8; 2048];\n    let mut psbt_len: usize = 0;\n    let res = psbt_decode(empty_inputs, empty_inputs.len(), &mut buf, 2048, &mut psbt_len);\n    assert_eq!(res, PsbtResult::Ok);\n\n    let mut psbt = Psbt::new(psbt_len);\n    let mut buf2 = vec![0u8; psbt_len];\n    psbt_init(&mut psbt, &mut buf2, psbt_len);\n\n    let mut user_data: i32 = 0;\n    let res = psbt_read(&buf[..psbt_len], psbt_len, &mut psbt, None, &mut user_data);\n    assert_eq!(res, PsbtResult::Ok, \"psbt_read failed with {:?}\", res);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":185,"cache_read_input_tokens":82595,"cache_creation":{"ephemeral_5m_input_tokens":185,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e8aa6589-65c1-4bb0-b0d4-bf0e3554d148","uuid":"8b377e8f-01bf-4ffa-bd36-133d738c478c"}
