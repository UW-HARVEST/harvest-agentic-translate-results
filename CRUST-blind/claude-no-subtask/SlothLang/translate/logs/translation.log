          had_token = true;\n            } else if rest.len() >= 5 && &rest[..5] == b\"sloth\" {\n                current_code = current_code.wrapping_add(1);\n                count += 5;\n                had_token = true;\n            } else if rest.len() >= 3 && &rest[..3] == b\"and\" {\n                byte_code.push(current_code);\n                current_code = 0;\n                count += 3;\n                had_token = true;\n            } else if rest.len() >= 3 && &rest[..3] == b\"nap\" {\n                byte_code.push(0x0);\n                count += 3;\n                had_token = true;\n            } else {\n                count += 1;\n            }\n        }\n\n        if had_token {\n            byte_code.push(current_code);\n        }\n    }\n\n    Some(SlothProgram {\n        codes: byte_code,\n        pc: 0,\n    })\n}\n\npub fn free_program(_program: Option<SlothProgram>) {\n    // Rust drops the program automatically when it goes out of scope.\n}\n\npub fn readline(file: &std::fs::File) -> Option<String> {\n    // Read one byte at a time until newline or EOF.\n    // On EOF, append a 0xFF sentinel byte (mirrors the C convention of -1).\n    let mut file_ref = file;\n    let mut bytes: Vec<u8> = Vec::with_capacity(100);\n    let mut buf = [0u8; 1];\n    let mut hit_eof = false;\n    loop {\n        match file_ref.read(&mut buf) {\n            Ok(0) => {\n                hit_eof = true;\n                break;\n            }\n            Ok(_) => {\n                if buf[0] == b'\\n' {\n                    break;\n                }\n                bytes.push(buf[0]);\n            }\n            Err(_) => {\n                hit_eof = true;\n                break;\n            }\n        }\n    }\n    if hit_eof {\n        bytes.push(0xFF);\n    }\n    // Convert raw bytes into a String, mapping each byte to its char value\n    // (Latin-1 style) so all values round-trip via String::as_bytes().\n    let s: String = bytes.iter().map(|&b| b as char).collect();\n    Some(s)\n}\n\npub fn prog_len(file: &std::fs::File) -> usize {\n    let mut file_ref = file;\n    let _ = file_ref.seek(SeekFrom::Start(0));\n    let mut count: usize = 0;\n    let mut buf = [0u8; 1];\n    loop {\n        match file_ref.read(&mut buf) {\n            Ok(0) => break,\n            Ok(_) => {\n                if buf[0] == b'\\n' {\n                    count += 1;\n                }\n            }\n            Err(_) => break,\n        }\n    }\n    let _ = file_ref.seek(SeekFrom::Start(0));\n    count * 3\n}\n","userModified":false}}
