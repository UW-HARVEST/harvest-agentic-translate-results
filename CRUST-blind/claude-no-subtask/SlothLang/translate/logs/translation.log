tion<SlothProgram>) {\n    // Rust drops the program automatically when it goes out of scope.\n    // The Option is consumed by this function and freed at the end.\n}\n\npub fn readline(file: &std::fs::File) -> Option<String> {\n    // Read one byte at a time until newline or EOF, mimicking the C function.\n    // The returned String contains raw bytes (interpreted as Latin-1) up to,\n    // but not including, the newline. If EOF is reached, a 0xFF byte is\n    // appended at the end (mirroring the C convention of writing -1).\n    use std::io::Read;\n    let mut file_ref = file;\n    let mut bytes: Vec<u8> = Vec::with_capacity(100);\n    let mut buf = [0u8; 1];\n    let mut hit_eof = false;\n    loop {\n        match file_ref.read(&mut buf) {\n            Ok(0) => {\n                hit_eof = true;\n                break;\n            }\n            Ok(_) => {\n                if buf[0] == b'\\n' {\n                    break;\n                }\n                bytes.push(buf[0]);\n            }\n            Err(_) => {\n                hit_eof = true;\n                break;\n            }\n        }\n    }\n    if hit_eof {\n        bytes.push(0xFF);\n    }\n    // Use from_utf8_lossy fallback; but we need exact bytes preserved.\n    // Convert directly assuming bytes correspond to chars (latin-1 mapping).\n    // To preserve every byte we use unsafe-free conversion via iterator of chars.\n    let s: String = bytes.iter().map(|&b| b as char).collect();\n    Some(s)\n}\n\npub fn prog_len(file: &std::fs::File) -> usize {\n    let mut file_ref = file;\n    let _ = file_ref.seek(SeekFrom::Start(0));\n    let mut count: usize = 0;\n    let mut buf = [0u8; 1];\n    loop {\n        match file_ref.read(&mut buf) {\n            Ok(0) => break,\n            Ok(_) => {\n                if buf[0] == b'\\n' {\n                    count += 1;\n                }\n            }\n            Err(_) => break,\n        }\n    }\n    let _ = file_ref.seek(SeekFrom::Start(0));\n    c