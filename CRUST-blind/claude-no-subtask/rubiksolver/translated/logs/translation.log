ement, bool(*compare_equal)(const void *e1, const void *e2))\n62\t{\n63\t  assert(hash != NULL);\n64\t  int ix = hash->hash_function(element);\n65\t  assert(ix <= hash->max_key);\n66\t  bucket_element_t curr = hash->buckets[ix];\n67\t  PDEBUG(\"Checking hash_element_exists at index %d\\n\", ix);\n68\t  if((unsigned int)curr == 0x3)\n69\t    printf(\"Target acquired\\n\");\n70\t  while(curr != NULL)\n71\t  {\n72\t    if(compare_equal(curr->element, element))\n73\t    {\n74\t      return true;\n75\t    }\n76\t    curr = curr->next;\n77\t  }\n78\t  return false;\n79\t}\n80\tbool hash_delete(hash_t hash, const void *element, bool(*compare_equal)(const void *e1, const void *e2))\n81\t{\n82\t  assert(hash != NULL);\n83\t  int ix = hash->hash_function(element);\n84\t  assert(ix <= hash->max_key);\n85\t  bucket_element_t curr = hash->buckets[ix];\n86\t  if(curr != NULL)\n87\t  {\n88\t    if(compare_equal(curr->element, element))\n89\t    {\n90\t      // Remove first element in a bucket\n91\t      if(curr->next == NULL)\n92\t      {\n93\t        PDEBUG(\"Freeing memory of curr(0x%x)\\n\", (unsigned int)curr);\n94\t        hash->buckets[ix] = NULL;\n95\t      }\n96\t      else\n97\t      {\n98\t        hash->buckets[ix] = curr->next;\n99\t      }\n100\t      free(curr);\n101\t      PDEBUG(\"Element deleted from hash(%x) at index %d (first element of bucket)\\n\", (unsigned int)hash, ix);\n102\t      return true;\n103\t    }\n104\t  }\n105\t  else\n106\t  {\n107\t    PDEBUG(\"Failed to delete element from hash(%x) at index %d (first element of bucket). Reason: curr is NULL\\n\", (unsigned int)hash, ix);\n108\t    return false;\n109\t  }\n110\t  while(curr != NULL && curr->next != NULL)\n111\t  {\n112\t    if(compare_equal(curr->next->element, element))\n113\t    {\n114\t      bucket_element_t del = curr->next;\n115\t      curr->next = del->next;\n116\t      PDEBUG(\"Freeing memory of del(0x%x)\\n\", (unsigned int)del);\n117\t      free(del);\n118\t      PDEBUG(\"Element delete