n\"));\n36\t    pgn_moves_cleanup(moves);\n37\t\n38\t    moves = pgn_moves_from_string(\"1.e4 e5 ({hello2} 1... g5)\");\n39\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.comments->length == 1);\n40\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.comments->values[0].position == PGN_COMMENT_POSITION_BEFORE_MOVE);\n41\t    suite6_assert(!strcmp(moves->values[0].black.alternatives->values[0]->values[0].black.comments->values[0].value->buf, \"hello2\"));\n42\t    pgn_moves_cleanup(moves);\n43\t\n44\t    moves = pgn_moves_from_string(\"1.e4 e5 ({hello} {libpgn} 1... g5)\");\n45\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.comments->length == 2);\n46\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.comments->values[0].position == PGN_COMMENT_POSITION_BEFORE_MOVE);\n47\t    suite6_assert(!strcmp(moves->values[0].black.alternatives->values[0]->values[0].black.comments->values[0].value->buf, \"hello\"));\n48\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.comments->values[1].position == PGN_COMMENT_POSITION_BEFORE_MOVE);\n49\t    suite6_assert(!strcmp(moves->values[0].black.alternatives->values[0]->values[0].black.comments->values[1].value->buf, \"libpgn\"));\n50\t    pgn_moves_cleanup(moves);\n51\t}\n52\t\n53\tvoid test_parsing_comments_on_position_between(void)\n54\t{\n55\t    pgn_moves_t *moves;\n56\t\n57\t    moves = pgn_moves_from_string(\"1. {jackalope:w} e4 e5\");\n58\t    suite6_assert(moves->values[0].white.comments != NULL);\n59\t    suite6_assert(moves->values[0].white.comments->length == 1);\n60\t    suite6_assert(moves->values[0].white.comments->values[0].position == PGN_COMMENT_POSITION_BETWEEN_MOVE);\n61\t    suite6_assert(!strcmp(moves->values[0].white.comments->values[0].value->buf, \"jackalope:w\"));\n62\t    pgn_moves_cleanup(moves);\n63\t\n64\t    moves = pgn_moves_from_string(\"1