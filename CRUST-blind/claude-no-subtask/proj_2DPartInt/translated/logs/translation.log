rts.next() {\n                Some(k) => k.trim(),\n                None => continue,\n            };\n            let value = match parts.next() {\n                Some(v) => v.trim(),\n                None => continue,\n            };\n            match key {\n                \"time\" => {\n                    if let Ok(v) = value.parse::<f64>() {\n                        config.simulation_time = v;\n                    }\n                }\n                \"dt\" => {\n                    if let Ok(v) = value.parse::<f64>() {\n                        config.dt = v;\n                    }\n                }\n                \"x_particles\" => {\n                    if let Ok(v) = value.parse::<i32>() {\n                        config.x_particles = v;\n                    }\n                }\n                \"y_particles\" => {\n                    if let Ok(v) = value.parse::<i32>() {\n                        config.y_particles = v;\n                    }\n                }\n                \"x_squares\" => {\n                    if let Ok(v) = value.parse::<i32>() {\n                        config.x_squares = v;\n                    }\n                }\n                \"y_squares\" => {\n                    if let Ok(v) = value.parse::<i32>() {\n                        config.y_squares = v;\n                    }\n                }\n                \"square_in_grid_length\" => {\n                    if let Ok(v) = value.parse::<f64>() {\n                        config.square_in_grid_length = v;\n                    }\n                }\n                \"radius\" => {\n                    if let Ok(v) = value.parse::<f64>() {\n                        config.radius = v;\n                    }\n                }\n                \"kn\" => {\n                    if let Ok(v) = value.parse::<f64>() {\n                        config.kn = v;\n                    }\n                }\n                \"ks\" => {\n                    if let Ok(v) = value.parse::<f64>