a*)*c\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", false);\n    check(\"[01]*1[01]{8}\", \"11011100011100\", true);\n    check(\"[01]*1[01]{8}\", \"01010010010010\", false);\n    check_err(\"abc]\");\n    check_err(\"[abc\");\n    check_err(\"a**\");\n    println!(\"Done\");\n}\nEOF\nrustc --edition 2021 --extern LTRE=$(find target -name 'libLTRE*.rlib' | head -1) -L target/debug/deps /tmp/test_ltre.rs -o /tmp/test_ltre 2>&1 | tail -20","description":"Build smoke test"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":577,"cache_read_input_tokens":83573,"cache_creation":{"ephemeral_5m_input_tokens":577,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8f551a8a-1273-4968-800d-235ebb515685","uuid":"6ec65614-a4b0-4795-9e9a-871cb0ee2fc4"}
