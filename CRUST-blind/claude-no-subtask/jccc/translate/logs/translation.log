{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014pgvehfHEYusMiHogJUUfQ","type":"tool_result","content":"1\t#include \"list.h\"\n2\t\n3\t#include <stdlib.h> // memory\n4\t\n5\t#include <util/out.h>\n6\t\n7\ttypedef struct ListBlock {\n8\t    void* * array;\n9\t    int size, full;\n10\t    struct ListBlock* next;\n11\t} ListBlock;\n12\t\n13\tstruct List {\n14\t    ListBlock *head, *tail;\n15\t    int blocksize;\n16\t};\n17\t\n18\tList* create_list(int blocksize) {\n19\t    List* l = malloc(sizeof(List));\n20\t    if (!l) {\n21\t        PRINT_ERROR(\"internal: failed to allocate memory\");\n22\t        return NULL;\n23\t    }\n24\t    l->blocksize = blocksize;\n25\t    l->head = l->tail = NULL;\n26\t    return l;\n27\t}\n28\t\n29\tint destroy_list(List* l) {\n30\t    // Free all blocks.\n31\t    ListBlock *lb = l->head, *next;\n32\t    while (lb) {\n33\t        next = lb->next;\n34\t        free(lb->array);\n35\t        free(lb);\n36\t        lb = next;\n37\t    }\n38\t    free(l);\n39\t    return 0;\n40\t}\n41\t\n42\t// Internal -- given a list and an index, produce the list block which that\n43\t// index references, and the index with respect to said list block.\n44\tstatic int lfind_index(List* l, ListBlock** lb, int* i) {\n45\t    *lb = l->head;\n46\t    if (*i < 0) {\n47\t        PRINT_ERROR(\"internal: list index was negative (%d)\", *i);\n48\t        return -1;\n49\t    }\n50\t    // We see if the index is in range of the current block length. If not,\n51\t    // repeat with the next block.\n52\t    while (*i >= (*lb)->size) {\n53\t        if (lb) {\n54\t            *lb = (*lb)->next;\n55\t            *i -= (*lb)->size;\n56\t        } else {\n57\t            PRINT_ERROR(\"internal: list index %d out of bounds\", *i);\n58\t            return -1;\n59\t        }\n60\t    }\n61\t    return 0;\n62\t}\n63\t\n64\tvoid* lget_element(List* l, int index) {\n65\t    int i = index;\n66\t    ListBlock* lb;\n67\t    lfind_index(l, &lb, &i);\n68\t    // Now the index is in range and we are at the list block we wish to access.\n69\t    if (i >= lb->full) {\n70\t        PRINT_ERROR(\"internal: list index %d out of bounds\", index);\n71\t        return NULL;\n72\t    }\n73\t    return lb->array[i];\n74\t}\n75\t\n76\tint lset_element(List* l, int index, void* value) {\n77\t    int i = index, ret;\n78\t    ListBlock* lb;\n79\t    if ((ret = lfind_index(l, &lb, &i))) return ret;\n80\t    // Now the index is in range and we are at the list block we wish to access.\n81\t    if (i >= lb->full) {\n82\t        PRINT_ERROR(\"internal: list index %d out of bounds\", index);\n83\t        return -1;\n84\t    }\n85\t    lb->array[i] = value;\n86\t    return 0;\n87\t}\n88\t\n89\t// Helper function -- make a new array.\n90\tstatic ListBlock* new_block(List* l) {\n91\t    ListBlock* lb = malloc(sizeof(ListBlock));\n92\t    if (lb == NULL) return NULL;\n93\t    lb->array = malloc(l->blocksize * sizeof(void *));\n94\t    if (lb->array == NULL) {\n95\t        free(lb);\n96\t        return NULL;\n97\t    }\n98\t    lb->full = 0;\n99\t    lb->size = l->blocksize;\n100\t    lb->next = NULL;\n101\t    return lb;\n102\t}\n103\t\n104\t// Add an element.\n105\t// We do this by finding the location of the next free slot. If the last array\n106\t// is full then we allocate a new one.\n107\tint ladd_element(List* l, void* element) {\n108\t    // First of all, if the list is empty, make a new array.\n109\t    if (l->head == NULL) {\n110\t        l->tail = new_block(l);\n111\t        l->head = l->tail;\n112\t    }\n113\t    // The last block is always where the free slots are.\n114\t    ListBlock* lb = l->tail;\n115\t    if (lb->full < lb->size) {\n116\t        lb->array[lb->full++] = element;\n117\t    } else {\n118\t        // Make a new block and put the element in there.\n119\t        l->tail = new_block(l);\n120\t        lb->next = l->tail;\n121\t        lb = lb->next;\n122\t        lb->array[lb->full++] = element;\n123\t    }\n124\t    return 0;\n125\t}\n126\t\n127\tint literate(List* l, int (*fn)(void*)) {\n128\t    ListBlock* lb = l->head;\n129\t    int acc = 0;\n130\t    while (lb != NULL) {\n131\t        for (int i = 0; i < lb->full; ++i) {\n132\t            acc += fn(lb->array[i]);\n133\t        }\n134\t        lb = lb->next;\n135\t    }\n136\t    return acc;\n137\t}\n138\t"}]},"parent_tool_use_id":null,"session_id":"af0da2a6-abd6-4fc5-816b-59e3d097d94e","uuid":"392b84b7-d381-467c-bea0-3e0d918d344f","timestamp":"2026-06-06T04:52:16.621Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-mlRLhL/project/c_src/src/util/list.c","content":"#include \"list.h\"\n\n#include <stdlib.h> // memory\n\n#include <util/out.h>\n\ntypedef struct ListBlock {\n    void* * array;\n    int size, full;\n    struct ListBlock* next;\n} ListBlock;\n\nstruct List {\n    ListBlock *head, *tail;\n    int blocksize;\n};\n\nList* create_list(int blocksize) {\n    List* l = malloc(sizeof(List));\n    if (!l) {\n        PRINT_ERROR(\"internal: failed to allocate memory\");\n        return NULL;\n    }\n    l->blocksize = blocksize;\n    l->head = l->tail = NULL;\n    return l;\n}\n\nint destroy_list(List* l) {\n    // Free all blocks.\n    ListBlock *lb = l->head, *next;\n    while (lb) {\n        next = lb->next;\n        free(lb->array);\n        free(lb);\n        lb = next;\n    }\n    free(l);\n    return 0;\n}\n\n// Internal -- given a list and an index, produce the list block which that\n// index references, and the index with respect to said list block.\nstatic int lfind_index(List* l, ListBlock** lb, int* i) {\n    *lb = l->head;\n    if (*i < 0) {\n        PRINT_ERROR(\"internal: list index was negative (%d)\", *i);\n        return -1;\n    }\n    // We see if the index is in range of the current block length. If not,\n    // repeat with the next block.\n    while (*i >= (*lb)->size) {\n        if (lb) {\n            *lb = (*lb)->next;\n            *i -= (*lb)->size;\n        } else {\n            PRINT_ERROR(\"internal: list index %d out of bounds\", *i);\n            return -1;\n        }\n    }\n    return 0;\n}\n\nvoid* lget_element(List* l, int index) {\n    int i = index;\n    ListBlock* lb;\n    lfind_index(l, &lb, &i);\n    // Now the index is in range and we are at the list block we wish to access.\n    if (i >= lb->full) {\n        PRINT_ERROR(\"internal: list index %d out of bounds\", index);\n        return NULL;\n    }\n    return lb->array[i];\n}\n\nint lset_element(List* l, int index, void* value) {\n    int i = index, ret;\n    ListBlock* lb;\n    if ((ret = lfind_index(l, &lb, &i))) return ret;\n    // Now the index is in range and we are at the list block we wish to access.\n    if (i >= lb->full) {\n        PRINT_ERROR(\"internal: list index %d out of bounds\", index);\n        return -1;\n    }\n    lb->array[i] = value;\n    return 0;\n}\n\n// Helper function -- make a new array.\nstatic ListBlock* new_block(List* l) {\n    ListBlock* lb = malloc(sizeof(ListBlock));\n    if (lb == NULL) return NULL;\n    lb->array = malloc(l->blocksize * sizeof(void *));\n    if (lb->array == NULL) {\n        free(lb);\n        return NULL;\n    }\n    lb->full = 0;\n    lb->size = l->blocksize;\n    lb->next = NULL;\n    return lb;\n}\n\n// Add an element.\n// We do this by finding the location of the next free slot. If the last array\n// is full then we allocate a new one.\nint ladd_element(List* l, void* element) {\n    // First of all, if the list is empty, make a new array.\n    if (l->head == NULL) {\n        l->tail = new_block(l);\n        l->head = l->tail;\n    }\n    // The last block is always where the free slots are.\n    ListBlock* lb = l->tail;\n    if (lb->full < lb->size) {\n        lb->array[lb->full++] = element;\n    } else {\n        // Make a new block and put the element in there.\n        l->tail = new_block(l);\n        lb->next = l->tail;\n        lb = lb->next;\n        lb->array[lb->full++] = element;\n    }\n    return 0;\n}\n\nint literate(List* l, int (*fn)(void*)) {\n    ListBlock* lb = l->head;\n    int acc = 0;\n    while (lb != NULL) {\n        for (int i = 0; i < lb->full; ++i) {\n            acc += fn(lb->array[i]);\n        }\n        lb = lb->next;\n    }\n    return acc;\n}\n","numLines":138,"startLine":1,"totalLines":138}}}
