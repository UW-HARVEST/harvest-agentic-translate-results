 = x;\n68\t    x->parent = y;\n69\t}\n70\t\n71\tvoid free_node(rbtree *t, node_t *x) {\n72\t  // 후위 순회 방식으로 RB Tree 내의 노드 메모리 반환\n73\t  if (x->left != t->nil) \n74\t    free_node(t, x->left);\n75\t  if (x->right != t->nil)\n76\t    free_node(t, x->right);\n77\t  free(x);\n78\t  x = NULL;\n79\t}\n80\t\n81\tvoid delete_rbtree(rbtree *t) {\n82\t  // TODO: reclaim the tree nodes's memory\n83\t  if (t->root != t->nil)\n84\t    free_node(t, t->root);\n85\t  free(t->nil);\n86\t  free(t);\n87\t}\n88\t\n89\tvoid rbtree_insert_fixup(rbtree *t, node_t *z) {\n90\t  node_t *y;\n91\t  \n92\t  while (z->parent->color == RBTREE_RED) {\n93\t    // z의 부모가 조부모의 왼쪽 서브 트리일 경우\n94\t    if (z->parent == z->parent->parent->left) {\n95\t      y = z->parent->parent->right;\n96\t      \n97\t      // CASE 1 : 노드 z의 삼촌 y가 적색인 경우\n98\t      if (y->color == RBTREE_RED) {\n99\t        z->parent->color = RBTREE_BLACK;\n100\t        y->color = RBTREE_BLACK;\n101\t        z->parent->parent->color = RBTREE_RED;\n102\t        z = z->parent->parent;\n103\t      }\n104\t      // CASE 2 : z의 삼촌 y가 흑색이며의 z가 오른쪽 자식인 경우\n105\t      else {\n106\t        if (z == z->parent->right) {\n107\t          z = z->parent;\n108\t          left_rotation(t, z);\n109\t        }\n110\t        // CASE 3 : z의 삼촌 y가 흑색이며의 z가 오른쪽 자식인 경우\n111\t        z->parent->color = RBTREE_BLACK;\n112\t        z->parent->parent->color = RBTREE_RED;\n113\t        right_rotation(t, z->parent->parent);\n114\t      }\n115\t    }\n116\t    // z의 부모가 조부모의 왼쪽 서브 트리일 경우\n117\t    else {\n118\t      y = z->parent->parent->left;\n119\t\n120\t      // CASE 4 : 노드 z의 삼촌 y가 적색인 경우\n121\t      if (y->color == RBTREE_RED) {\n122\t        z->parent->color = RBTREE_BLACK;\n123\t        y->color = RBTREE_BLACK;\n124\t        z->parent->parent->color = RBTREE_RED;\n125\t        z = z->parent->parent;\n126\t      }\n127\t      // CASE 5 : z의 삼촌 y가 흑색이며의 z가 오른쪽 자식인 경우\n128\t      else {\n129\t        if (z == z->parent->left) {\n130\t          z = z->parent;\n13