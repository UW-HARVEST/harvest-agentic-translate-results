{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KwxQhR4gwpjaKSmPBEFPLr","type":"tool_result","content":"1\t#include <assert.h>\n2\t#include <rbtree.h>\n3\t#include <stdbool.h>\n4\t#include <stdio.h>\n5\t#include <stdlib.h>\n6\t\n7\t// new_rbtree should return rbtree struct with null root node\n8\tvoid test_init(void) {\n9\t  rbtree *t = new_rbtree();\n10\t  assert(t != NULL);\n11\t#ifdef SENTINEL\n12\t  assert(t->nil != NULL);\n13\t  assert(t->root == t->nil);\n14\t#else\n15\t  assert(t->root == NULL);\n16\t#endif\n17\t  delete_rbtree(t);\n18\t}\n19\t\n20\t// root node should have proper values and pointers\n21\tvoid test_insert_single(const key_t key) {\n22\t  rbtree *t = new_rbtree();\n23\t  node_t *p = rbtree_insert(t, key);\n24\t  assert(p != NULL);\n25\t  assert(t->root == p);\n26\t  assert(p->key == key);\n27\t  // assert(p->color == RBTREE_BLACK);  // color of root node should be black\n28\t#ifdef SENTINEL\n29\t  assert(p->left == t->nil);\n30\t  assert(p->right == t->nil);\n31\t  assert(p->parent == t->nil);\n32\t#else\n33\t  assert(p->left == NULL);\n34\t  assert(p->right == NULL);\n35\t  assert(p->parent == NULL);\n36\t#endif\n37\t  delete_rbtree(t);\n38\t}\n39\t\n40\t// find should return the node with the key or NULL if no such node exists\n41\tvoid test_find_single(const key_t key, const key_t wrong_key) {\n42\t  rbtree *t = new_rbtree();\n43\t  node_t *p = rbtree_insert(t, key);\n44\t\n45\t  node_t *q = rbtree_find(t, key);\n46\t  assert(q != NULL);\n47\t  assert(q->key == key);\n48\t  assert(q == p);\n49\t\n50\t  q = rbtree_find(t, wrong_key);\n51\t  assert(q == NULL);\n52\t\n53\t  delete_rbtree(t);\n54\t}\n55\t\n56\t// erase should delete root node\n57\tvoid test_erase_root(const key_t key) {\n58\t  rbtree *t = new_rbtree();\n59\t  node_t *p = rbtree_insert(t, key);\n60\t  assert(p != NULL);\n61\t  assert(t->root == p);\n62\t  assert(p->key == key);\n63\t\n64\t  rbtree_erase(t, p);\n65\t#ifdef SENTINEL\n66\t  assert(t->root == t->nil);\n67\t#else\n68\t  assert(t->root == NULL);\n69\t#endif\n70\t\n71\t  delete_rbtree(t);\n72\t}\n73\t\n74\tstatic void insert_arr(rbtree *t, const key_t *arr, const size_t n) {\n75\t  for (size_t i = 0; i < n; i++) {\n76\t    rbtree_insert(t, arr[i]);\n77\t  }\n78\t}\n79\t\n80\tstatic int comp(const void *p1, const void *p2) {\n81\t  const key_t *e1 = (const key_t *)p1;\n82\t  const key_t *e2 = (const key_t *)p2;\n83\t  if (*e1 < *e2) {\n84\t    return -1;\n85\t  } else if (*e1 > *e2) {\n86\t    return 1;\n87\t  } else {\n88\t    return 0;\n89\t  }\n90\t};\n91\t\n92\t// min/max should return the min/max value of the tree\n93\tvoid test_minmax(key_t *arr, const size_t n) {\n94\t  // null array is not allowed\n95\t  assert(n > 0 && arr != NULL);\n96\t\n97\t  rbtree *t = new_rbtree();\n98\t  assert(t != NULL);\n99\t\n100\t  insert_arr(t, arr, n);\n101\t  assert(t->root != NULL);\n102\t#ifdef SENTINEL\n103\t  assert(t->root != t->nil);\n104\t#endif\n105\t\n106\t  qsort((void *)arr, n, sizeof(key_t), comp);\n107\t  node_t *p = rbtree_min(t);\n108\t  assert(p != NULL);\n109\t  assert(p->key == arr[0]);\n110\t\n111\t  node_t *q = rbtree_max(t);\n112\t  assert(q != NULL);\n113\t  assert(q->key == arr[n - 1]);\n114\t\n115\t  rbtree_erase(t, p);\n116\t  p = rbtree_min(t);\n117\t  assert(p != NULL);\n118\t  assert(p->key == arr[1]);\n119\t\n120\t  if (n >= 2) {\n121\t    rbtree_erase(t, q);\n122\t    q = rbtree_max(t);\n123\t    assert(q != NULL);\n124\t    assert(q->key == arr[n - 2]);\n125\t  }\n126\t\n127\t  delete_rbtree(t);\n128\t}\n129\t\n130\tvoid test_to_array(rbtree *t, const key_t *arr, const size_t n) {\n131\t  assert(t != NULL);\n132\t\n133\t  insert_arr(t, arr, n);\n134\t  qsort((void *)arr, n, sizeof(key_t), comp);\n135\t\n136\t  key_t *res = calloc(n, sizeof(key_t));\n137\t  rbtree_to_array(t, res, n);\n138\t  for (int i = 0; i < n; i++) {\n139\t    assert(arr[i] == res[i]);\n140\t  }\n141\t  free(res);\n142\t}\n143\t\n144\tvoid test_multi_instance() {\n145\t  rbtree *t1 = new_rbtree();\n146\t  assert(t1 != NULL);\n147\t  rbtree *t2 = new_rbtree();\n148\t  assert(t2 != NULL);\n149\t\n150\t  key_t arr1[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12, 24, 36, 990, 25};\n151\t  const size_t n1 = sizeof(arr1) / sizeof(arr1[0]);\n152\t  insert_arr(t1, arr1, n1);\n153\t  qsort((void *)arr1, n1, sizeof(key_t), comp);\n154\t\n155\t  key_t arr2[] = {4, 8, 10, 5, 3};\n156\t  const size_t n2 = sizeof(arr2) / sizeof(arr2[0]);\n157\t  insert_arr(t2, arr2, n2);\n158\t  qsort((void *)arr2, n2, sizeof(key_t), comp);\n159\t\n160\t  key_t *res1 = calloc(n1, sizeof(key_t));\n161\t  rbtree_to_array(t1, res1, n1);\n162\t  for (int i = 0; i < n1; i++) {\n163\t    assert(arr1[i] == res1[i]);\n164\t  }\n165\t\n166\t  key_t *res2 = calloc(n2, sizeof(key_t));\n167\t  rbtree_to_array(t2, res2, n2);\n168\t  for (int i = 0; i < n2; i++) {\n169\t    assert(arr2[i] == res2[i]);\n170\t  }\n171\t\n172\t  delete_rbtree(t2);\n173\t  delete_rbtree(t1);\n174\t  free(res1);\n175\t  free(res2);\n176\t}\n177\t\n178\t// Search tree constraint\n179\t// The values of left subtree should be less than or equal to the current node\n180\t// The values of right subtree should be greater than or equal to the current\n181\t// node\n182\t\n183\tstatic bool search_traverse(const node_t *p, key_t *min, key_t *max,\n184\t                            node_t *nil) {\n185\t  if (p == nil) {\n186\t    return true;\n187\t  }\n188\t\n189\t  *min = *max = p->key;\n190\t\n191\t  key_t l_min, l_max, r_min, r_max;\n192\t  l_min = l_max = r_min = r_max = p->key;\n193\t\n194\t  const bool lr = search_traverse(p->left, &l_min, &l_max, nil);\n195\t  if (!lr || l_max > p->key) {\n196\t    return false;\n197\t  }\n198\t  const bool rr = search_traverse(p->right, &r_min, &r_max, nil);\n199\t  if (!rr || r_min < p->key) {\n200\t    return false;\n201\t  }\n202\t\n203\t  *min = l_min;\n204\t  *max = r_max;\n205\t  return true;\n206\t}\n207\t\n208\tvoid test_search_constraint(const rbtree *t) {\n209\t  assert(t != NULL);\n210\t  node_t *p = t->root;\n211\t  key_t min, max;\n212\t#ifdef SENTINEL\n213\t  node_t *nil = t->nil;\n214\t#else\n215\t  node_t *nil = NULL;\n216\t#endif\n217\t  assert(search_traverse(p, &min, &max, nil));\n218\t}\n219\t\n220\t// Color constraint\n221\t// 1. Each node is either red or black. (by definition)\n222\t// 2. All NIL nodes are considered black.\n223\t// 3. A red node does not have a red child.\n224\t// 4. Every path from a given node to any of its descendant NIL nodes goes\n225\t// through the same number of black nodes.\n226\t\n227\tbool touch_nil = false;\n228\tint max_black_depth = 0;\n229\t\n230\tstatic void init_color_traverse(void) {\n231\t  touch_nil = false;\n232\t  max_black_depth = 0;\n233\t}\n234\t\n235\tstatic bool color_traverse(const node_t *p, const color_t parent_color,\n236\t                           const int black_depth, node_t *nil) {\n237\t  if (p == nil) {\n238\t    if (!touch_nil) {\n239\t      touch_nil = true;\n240\t      max_black_depth = black_depth;\n241\t    } else if (black_depth != max_black_depth) {\n242\t      return false;\n243\t    }\n244\t    return true;\n245\t  }\n246\t  if (parent_color == RBTREE_RED && p->color == RBTREE_RED) {\n247\t    return false;\n248\t  }\n249\t  int next_depth = ((p->color == RBTREE_BLACK) ? 1 : 0) + black_depth;\n250\t  return color_traverse(p->left, p->color, next_depth, nil) &&\n251\t         color_traverse(p->right, p->color, next_depth, nil);\n252\t}\n253\t\n254\tvoid test_color_constraint(const rbtree *t) {\n255\t  assert(t != NULL);\n256\t#ifdef SENTINEL\n257\t  node_t *nil = t->nil;\n258\t#else\n259\t  node_t *nil = NULL;\n260\t#endif\n261\t  node_t *p = t->root;\n262\t  assert(p == nil || p->color == RBTREE_BLACK);\n263\t\n264\t  init_color_traverse();\n265\t  assert(color_traverse(p, RBTREE_BLACK, 0, nil));\n266\t}\n267\t\n268\t// rbtree should keep search tree and color constraints\n269\tvoid test_rb_constraints(const key_t arr[], const size_t n) {\n270\t  rbtree *t = new_rbtree();\n271\t  assert(t != NULL);\n272\t\n273\t  insert_arr(t, arr, n);\n274\t  assert(t->root != NULL);\n275\t\n276\t  test_color_constraint(t);\n277\t  test_search_constraint(t);\n278\t\n279\t  delete_rbtree(t);\n280\t}\n281\t\n282\t// rbtree should manage distinct values\n283\tvoid test_distinct_values() {\n284\t  const key_t entries[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12};\n285\t  const size_t n = sizeof(entries) / sizeof(entries[0]);\n286\t  test_rb_constraints(entries, n);\n287\t}\n288\t\n289\t// rbtree should manage values with duplicate\n290\tvoid test_duplicate_values() {\n291\t  const key_t entries[] = {10, 5, 5, 34, 6, 23, 12, 12, 6, 12};\n292\t  const size_t n = sizeof(entries) / sizeof(entries[0]);\n293\t  test_rb_constraints(entries, n);\n294\t}\n295\t\n296\tvoid test_minmax_suite() {\n297\t  key_t entries[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12};\n298\t  const size_t n = sizeof(entries) / sizeof(entries[0]);\n299\t  test_minmax(entries, n);\n300\t}\n301\t\n302\tvoid test_to_array_suite() {\n303\t  rbtree *t = new_rbtree();\n304\t  assert(t != NULL);\n305\t\n306\t  key_t entries[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12, 24, 36, 990, 25};\n307\t  const size_t n = sizeof(entries) / sizeof(entries[0]);\n308\t  test_to_array(t, entries, n);\n309\t\n310\t  delete_rbtree(t);\n311\t}\n312\t\n313\tint main(void) {\n314\t  test_init();\n315\t  test_insert_single(1024);\n316\t  test_find_single(512, 1024);\n317\t  test_erase_root(128);\n318\t  test_minmax_suite();\n319\t  test_to_array_suite();\n320\t  test_distinct_values();\n321\t  test_duplicate_values();\n322\t  test_multi_instance();\n323\t  printf(\"Passed all tests!\\n\");\n324\t}"}]},"parent_tool_use_id":null,"session_id":"e289ceb7-b750-4428-b602-9d292d0dc2d2","uuid":"7ea07726-b673-40cd-bf4c-5583a17221ac","timestamp":"2026-06-06T06:44:30.996Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-TRKqcT/project/c_src/test/test-rbtree.c","content":"#include <assert.h>\n#include <rbtree.h>\n#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n// new_rbtree should return rbtree struct with null root node\nvoid test_init(void) {\n  rbtree *t = new_rbtree();\n  assert(t != NULL);\n#ifdef SENTINEL\n  assert(t->nil != NULL);\n  assert(t->root == t->nil);\n#else\n  assert(t->root == NULL);\n#endif\n  delete_rbtree(t);\n}\n\n// root node should have proper values and pointers\nvoid test_insert_single(const key_t key) {\n  rbtree *t = new_rbtree();\n  node_t *p = rbtree_insert(t, key);\n  assert(p != NULL);\n  assert(t->root == p);\n  assert(p->key == key);\n  // assert(p->color == RBTREE_BLACK);  // color of root node should be black\n#ifdef SENTINEL\n  assert(p->left == t->nil);\n  assert(p->right == t->nil);\n  assert(p->parent == t->nil);\n#else\n  assert(p->left == NULL);\n  assert(p->right == NULL);\n  assert(p->parent == NULL);\n#endif\n  delete_rbtree(t);\n}\n\n// find should return the node with the key or NULL if no such node exists\nvoid test_find_single(const key_t key, const key_t wrong_key) {\n  rbtree *t = new_rbtree();\n  node_t *p = rbtree_insert(t, key);\n\n  node_t *q = rbtree_find(t, key);\n  assert(q != NULL);\n  assert(q->key == key);\n  assert(q == p);\n\n  q = rbtree_find(t, wrong_key);\n  assert(q == NULL);\n\n  delete_rbtree(t);\n}\n\n// erase should delete root node\nvoid test_erase_root(const key_t key) {\n  rbtree *t = new_rbtree();\n  node_t *p = rbtree_insert(t, key);\n  assert(p != NULL);\n  assert(t->root == p);\n  assert(p->key == key);\n\n  rbtree_erase(t, p);\n#ifdef SENTINEL\n  assert(t->root == t->nil);\n#else\n  assert(t->root == NULL);\n#endif\n\n  delete_rbtree(t);\n}\n\nstatic void insert_arr(rbtree *t, const key_t *arr, const size_t n) {\n  for (size_t i = 0; i < n; i++) {\n    rbtree_insert(t, arr[i]);\n  }\n}\n\nstatic int comp(const void *p1, const void *p2) {\n  const key_t *e1 = (const key_t *)p1;\n  const key_t *e2 = (const key_t *)p2;\n  if (*e1 < *e2) {\n    return -1;\n  } else if (*e1 > *e2) {\n    return 1;\n  } else {\n    return 0;\n  }\n};\n\n// min/max should return the min/max value of the tree\nvoid test_minmax(key_t *arr, const size_t n) {\n  // null array is not allowed\n  assert(n > 0 && arr != NULL);\n\n  rbtree *t = new_rbtree();\n  assert(t != NULL);\n\n  insert_arr(t, arr, n);\n  assert(t->root != NULL);\n#ifdef SENTINEL\n  assert(t->root != t->nil);\n#endif\n\n  qsort((void *)arr, n, sizeof(key_t), comp);\n  node_t *p = rbtree_min(t);\n  assert(p != NULL);\n  assert(p->key == arr[0]);\n\n  node_t *q = rbtree_max(t);\n  assert(q != NULL);\n  assert(q->key == arr[n - 1]);\n\n  rbtree_erase(t, p);\n  p = rbtree_min(t);\n  assert(p != NULL);\n  assert(p->key == arr[1]);\n\n  if (n >= 2) {\n    rbtree_erase(t, q);\n    q = rbtree_max(t);\n    assert(q != NULL);\n    assert(q->key == arr[n - 2]);\n  }\n\n  delete_rbtree(t);\n}\n\nvoid test_to_array(rbtree *t, const key_t *arr, const size_t n) {\n  assert(t != NULL);\n\n  insert_arr(t, arr, n);\n  qsort((void *)arr, n, sizeof(key_t), comp);\n\n  key_t *res = calloc(n, sizeof(key_t));\n  rbtree_to_array(t, res, n);\n  for (int i = 0; i < n; i++) {\n    assert(arr[i] == res[i]);\n  }\n  free(res);\n}\n\nvoid test_multi_instance() {\n  rbtree *t1 = new_rbtree();\n  assert(t1 != NULL);\n  rbtree *t2 = new_rbtree();\n  assert(t2 != NULL);\n\n  key_t arr1[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12, 24, 36, 990, 25};\n  const size_t n1 = sizeof(arr1) / sizeof(arr1[0]);\n  insert_arr(t1, arr1, n1);\n  qsort((void *)arr1, n1, sizeof(key_t), comp);\n\n  key_t arr2[] = {4, 8, 10, 5, 3};\n  const size_t n2 = sizeof(arr2) / sizeof(arr2[0]);\n  insert_arr(t2, arr2, n2);\n  qsort((void *)arr2, n2, sizeof(key_t), comp);\n\n  key_t *res1 = calloc(n1, sizeof(key_t));\n  rbtree_to_array(t1, res1, n1);\n  for (int i = 0; i < n1; i++) {\n    assert(arr1[i] == res1[i]);\n  }\n\n  key_t *res2 = calloc(n2, sizeof(key_t));\n  rbtree_to_array(t2, res2, n2);\n  for (int i = 0; i < n2; i++) {\n    assert(arr2[i] == res2[i]);\n  }\n\n  delete_rbtree(t2);\n  delete_rbtree(t1);\n  free(res1);\n  free(res2);\n}\n\n// Search tree constraint\n// The values of left subtree should be less than or equal to the current node\n// The values of right subtree should be greater than or equal to the current\n// node\n\nstatic bool search_traverse(const node_t *p, key_t *min, key_t *max,\n                            node_t *nil) {\n  if (p == nil) {\n    return true;\n  }\n\n  *min = *max = p->key;\n\n  key_t l_min, l_max, r_min, r_max;\n  l_min = l_max = r_min = r_max = p->key;\n\n  const bool lr = search_traverse(p->left, &l_min, &l_max, nil);\n  if (!lr || l_max > p->key) {\n    return false;\n  }\n  const bool rr = search_traverse(p->right, &r_min, &r_max, nil);\n  if (!rr || r_min < p->key) {\n    return false;\n  }\n\n  *min = l_min;\n  *max = r_max;\n  return true;\n}\n\nvoid test_search_constraint(const rbtree *t) {\n  assert(t != NULL);\n  node_t *p = t->root;\n  key_t min, max;\n#ifdef SENTINEL\n  node_t *nil = t->nil;\n#else\n  node_t *nil = NULL;\n#endif\n  assert(search_traverse(p, &min, &max, nil));\n}\n\n// Color constraint\n// 1. Each node is either red or black. (by definition)\n// 2. All NIL nodes are considered black.\n// 3. A red node does not have a red child.\n// 4. Every path from a given node to any of its descendant NIL nodes goes\n// through the same number of black nodes.\n\nbool touch_nil = false;\nint max_black_depth = 0;\n\nstatic void init_color_traverse(void) {\n  touch_nil = false;\n  max_black_depth = 0;\n}\n\nstatic bool color_traverse(const node_t *p, const color_t parent_color,\n                           const int black_depth, node_t *nil) {\n  if (p == nil) {\n    if (!touch_nil) {\n      touch_nil = true;\n      max_black_depth = black_depth;\n    } else if (black_depth != max_black_depth) {\n      return false;\n    }\n    return true;\n  }\n  if (parent_color == RBTREE_RED && p->color == RBTREE_RED) {\n    return false;\n  }\n  int next_depth = ((p->color == RBTREE_BLACK) ? 1 : 0) + black_depth;\n  return color_traverse(p->left, p->color, next_depth, nil) &&\n         color_traverse(p->right, p->color, next_depth, nil);\n}\n\nvoid test_color_constraint(const rbtree *t) {\n  assert(t != NULL);\n#ifdef SENTINEL\n  node_t *nil = t->nil;\n#else\n  node_t *nil = NULL;\n#endif\n  node_t *p = t->root;\n  assert(p == nil || p->color == RBTREE_BLACK);\n\n  init_color_traverse();\n  assert(color_traverse(p, RBTREE_BLACK, 0, nil));\n}\n\n// rbtree should keep search tree and color constraints\nvoid test_rb_constraints(const key_t arr[], const size_t n) {\n  rbtree *t = new_rbtree();\n  assert(t != NULL);\n\n  insert_arr(t, arr, n);\n  assert(t->root != NULL);\n\n  test_color_constraint(t);\n  test_search_constraint(t);\n\n  delete_rbtree(t);\n}\n\n// rbtree should manage distinct values\nvoid test_distinct_values() {\n  const key_t entries[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12};\n  const size_t n = sizeof(entries) / sizeof(entries[0]);\n  test_rb_constraints(entries, n);\n}\n\n// rbtree should manage values with duplicate\nvoid test_duplicate_values() {\n  const key_t entries[] = {10, 5, 5, 34, 6, 23, 12, 12, 6, 12};\n  const size_t n = sizeof(entries) / sizeof(entries[0]);\n  test_rb_constraints(entries, n);\n}\n\nvoid test_minmax_suite() {\n  key_t entries[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12};\n  const size_t n = sizeof(entries) / sizeof(entries[0]);\n  test_minmax(entries, n);\n}\n\nvoid test_to_array_suite() {\n  rbtree *t = new_rbtree();\n  assert(t != NULL);\n\n  key_t entries[] = {10, 5, 8, 34, 67, 23, 156, 24, 2, 12, 24, 36, 990, 25};\n  const size_t n = sizeof(entries) / sizeof(entries[0]);\n  test_to_array(t, entries, n);\n\n  delete_rbtree(t);\n}\n\nint main(void) {\n  test_init();\n  test_insert_single(1024);\n  test_find_single(512, 1024);\n  test_erase_root(128);\n  test_minmax_suite();\n  test_to_array_suite();\n  test_distinct_values();\n  test_duplicate_values();\n  test_multi_instance();\n  printf(\"Passed all tests!\\n\");\n}","numLines":324,"startLine":1,"totalLines":324}}}
