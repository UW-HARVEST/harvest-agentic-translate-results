{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019NGFrqaDGQyekmgemJpb9j","type":"tool_result","content":"1\t/*\n2\t *  MVPTree c library\n3\t *  Copyright (C) 2008-2009 by D. Grant Starkweather.\n4\t *  All rights reserved.\n5\t *\n6\t *  This program is free software: you can redistribute it and/or modify\n7\t *  it under the terms of the GNU General Public License as published by\n8\t *  the Free Software Foundation, either version 3 of the License, or\n9\t *  (at your option) any later version.\n10\t *\n11\t *  This program is distributed in the hope that it will be useful,\n12\t *  but WITHOUT ANY WARRANTY; without even the implied warranty of\n13\t *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n14\t *  GNU General Public License for more details.\n15\t *\n16\t *  You should have received a copy of the GNU General Public License\n17\t *  along with this program.  If not, see <http://www.gnu.org/licenses/>.\n18\t *\n19\t *  D Grant Starkweather - starkd88@gmail.com\n20\t */\n21\t\n22\t#ifndef _MVPTREE_H\n23\t#define _MVPTREE_H\n24\t\n25\t/*data type for a datapoint - refers to the bitwidth of each element */\n26\ttypedef enum mvp_datatype_t { \n27\t    BYTEARRAY = 1, \n28\t    UINT16ARRAY = 2, \n29\t    UINT32ARRAY = 4, \n30\t    UINT64ARRAY = 8 \n31\t} MVPDataType;\n32\t\n33\ttypedef enum nodetype_t { \n34\t    INTERNAL_NODE = 1, \n35\t    LEAF_NODE \n36\t} NodeType;\n37\t\n38\t/* error codes */\n39\ttypedef enum mvp_error_t {\n40\t    MVP_SUCCESS,            /* no error */\n41\t    MVP_ARGERR,             /* argument error */\n42\t    MVP_NODISTANCEFUNC,     /* no distance function found */\n43\t    MVP_MEMALLOC,           /* mem alloc error */\n44\t    MVP_NOLEAF,             /* could not alloc leaf node */\n45\t    MVP_NOINTERNAL,         /* could not alloc internal node */\n46\t    MVP_PATHALLOC,          /* path alloc error */\n47\t    MVP_VPNOSELECT,         /* could not select vantage points */\n48\t    MVP_NOSV1RANGE,         /* could not calculate range of points from sv1 */\n49\t    MVP_NOSV2RANGE,         /* could not calculate range of points from sv2 */\n50\t    MVP_NOSPACE,            /* points too close to one another, too compact */\n51\t    MVP_NOSORT,             /* unable to sort points */\n52\t    MVP_FILEOPEN,           /* trouble opening file */\n53\t    MVP_FILECLOSE,          /* trouble closing file */\n54\t    MVP_MEMMAP,             /* mem map trouble */\n55\t    MVP_MUNMAP,             /* mem unmap trouble */\n56\t    MVP_NOWRITE,            /* could not write to file */\n57\t    MVP_FILETRUNCATE,       /* could not extend file */\n58\t    MVP_MREMAPFAIL,         /* unable to map/unmap file */\n59\t    MVP_TYPEMISMATCH,       /* trying to add datapoints of one datatype */\n60\t                            /* to tree that already contains another type */\n61\t    MVP_KNEARESTCAP,        /* number results found reaches knearest limit */\n62\t    MVP_EMPTYTREE,\n63\t    MVP_NOSPLITS,           /* unable to calculate split points */\n64\t    MVP_BADDISTVAL,         /* val from distance function either NaN or less than 0 */\n65\t    MVP_FILENOTFOUND,       /* file not found */\n66\t    MVP_UNRECOGNIZED,       /* unrecognized node */\n67\t} MVPError;\n68\t\n69\ttypedef struct mvp_datapoint_t {\n70\t    char *id;               /* null-terminated id string */\n71\t    void *data;             /* data for this data point */\n72\t    float *path;            /* path of distances of data point from all vantage points down tree*/\n73\t    unsigned int datalen;   /* length of data in the type designated */    \n74\t    MVPDataType type;       /* type of data (the bitwidth of each data element) */\n75\t} MVPDP;\n76\t\n77\t/* call back function for mvp tree functions - to performa distance calc.'s*/\n78\ttypedef float (*CmpFunc)(MVPDP *pointA, MVPDP *pointB);\n79\t\n80\t/* Callback function to pass to mvp_clear() to free id and data members of the datapoints, */\n81\t/* since the id and data arrays are allocated by user, not by dp_alloc() function. */\n82\ttypedef void (*MVPFreeFunc)(void *ptr);\n83\t\n84\ttypedef struct node_internal_t {\n85\t    NodeType type;\n86\t    MVPDP *sv1, *sv2;\n87\t    float *M1, *M2;\n88\t    void **child_nodes;\n89\t} InternalNode;\n90\t\n91\ttypedef struct node_leaf_t {\n92\t    NodeType type;\n93\t    MVPDP *sv1, *sv2;\n94\t    MVPDP **points;\n95\t    float *d1, *d2;\n96\t    unsigned int nbpoints;\n97\t} LeafNode;\n98\t   \n99\t\n100\ttypedef union node_t {\n101\t    LeafNode leaf;\n102\t    InternalNode internal;\n103\t} Node;\n104\t\n105\t\n106\ttypedef struct mvptree_t {\n107\t    int branchfactor;      /* branch factor of tree, e.g. 2                           */\n108\t    int pathlength;        /* number distances stored for a datapoint's distance      */\n109\t                           /* from each vantage point going down the tree.            */\n110\t                           /* Refers to the array of float's stored in each datapoint.*/\n111\t    int leafcap;           /* capacity of leaf nodes  (number datapoints)             */\n112\t    int fd;                /* internal use                                            */\n113\t    int k;                 /* internal use for retrieve function (knearest)           */\n114\t    MVPDataType datatype;  /* internal use                                            */  \n115\t    off_t pos;             /* internal use for mvp_read() and mvp_write()             */\n116\t    off_t size;            /* internal use for mvp_read() and mvp_write()             */\n117\t    off_t pgsize;          /* system page size (interal use)                          */\n118\t    char *buf;             /* internal use                                            */\n119\t    Node *node;            /* reference to top of tree                                */\n120\t    CmpFunc dist;          /* distance function - e.g. L1 or L2                       */\n121\t} MVPTree;\n122\t\n123\t\n124\t/*   DP* dp_alloc\n125\t *\n126\t *   DESCRIPTION:\n127\t *\n128\t *   allocate a datapoint on the heap\n129\t *\n130\t *   ARGUMENTS:\n131\t *\n132\t *   type - DataType value to indicate the type of data the datapoint represents.\n133\t *\n134\t *   RETURN:\n135\t *   \n136\t *   pointer to DP structure, NULL for error.    \n137\t *\n138\t */\n139\tMVPDP* dp_alloc(MVPDataType type);\n140\t\n141\t/*   dp_free\n142\t *\n143\t *   DESCRIPTION:\n144\t *\n145\t *   free a datapoint\n146\t *\n147\t *   ARGUMENTS:\n148\t *\n149\t *   dp - pointer to datapoint to be free'd.\n150\t *\n151\t *   free_func - callback function that will be used to free the id and data parts of a DP \n152\t *\n153\t *   RETURN: \n154\t *\n155\t *   void\n156\t */\n157\tvoid dp_free(MVPDP *dp, MVPFreeFunc free_func);\n158\t\n159\t/*   mvptree_alloc\n160\t * \n161\t *   DESCRIPTION:\n162\t *\n163\t *   ARGUMENTS:\n164\t *\n165\t *   tree - ptr to MVPTree to initialize (NULL to allocate one on the heap \n166\t *\n167\t *   distance - callback function (the distance function to use in the mvp tree\n168\t *   \n169\t *    bf - int value for the tree branch factor - e.g. 2\n170\t *\n171\t *    p  - int value for the path length to use for each data point\n172\t *\n173\t *    k  - int value for leaf capacity of each leaf node - maximum number of datapoints \n174\t *\n175\t *   RETURN:\n176\t *\n177\t *   MVPTree* ptr, NULL for error\n178\t *    \n179\t */\n180\tMVPTree* mvptree_alloc(MVPTree *tree,CmpFunc distance,\n181\t                                       unsigned int bf,unsigned int p,unsigned int k);\n182\t\n183\t/*\n184\t *  mvptree_clear\n185\t *  \n186\t *  DESCRIPTION:\n187\t *\n188\t *  Clear out the tree. All the datapoints that have been added to the tree\n189\t *  are also free'd with dp_free(). You can specify a free function to free\n190\t *  the portions of the DP struct which are user allocated (e.g. the id and \n191\t *  data fields).\n192\t *\n193\t *  ARGUMENTS:\n194\t *\n195\t *  tree - ptr to tree to clear out\n196\t *\n197\t *  free_func - ptr to function to free the datapoint's id and data fields\n198\t *\n199\t *  RETURN \n200\t *\n201\t *  void\n202\t */\n203\tvoid mvptree_clear(MVPTree *tree, MVPFreeFunc free_func);\n204\t\n205\t/*\n206\t *   mvptree_add\n207\t *\n208\t *   DESCRIPTION:\n209\t *\n210\t *   Add a list of datapoints to a tree. Note: the datapoints are subsequently\n211\t *   owned by the tree, and a call to mvptree_clear() will invoke dp_free() on\n212\t *   all its datapoints. (See mvptree_clear()). However, it does not own the array\n213\t *   containing the pointers to the datapoints.  This must still be free'd by the user.\n214\t *\n215\t *   ARGUMENTS:\n216\t *\n217\t *   tree - ptr to MVPTree a previously allocated tree.\n218\t *\n219\t *   points - array of DP ptrs to add to the tree\n220\t *\n221\t *   nbpoints - unsigned int for the number of datapoint ptrs in points array\n222\t *\n223\t *   RETURN \n224\t *\n225\t *   MVPError error code\n226\t */\n227\tMVPError mvptree_add(MVPTree *tree, MVPDP **points, unsigned int nbpoints);\n228\t\n229\t/*\n230\t *   mvptree_retrieve\n231\t *  \n232\t *   DESCRIPTION:\n233\t *   \n234\t *   retrieve knearest neighbors from the tree\n235\t *\n236\t *   ARGUMENTS:\n237\t *\n238\t *   tree - ptr to the MVPTree\n239\t *\n240\t *   target - target datapoint\n241\t *\n242\t *   knearest - maximum number of datapoints to return\n243\t *\n244\t *   radius   -  distance from the target to include in returned list.\n245\t *\n246\t *   nbresults - ptr to int to contain the number of results returned to user.\n247\t *\n248\t *   error - ptr to error value to return error to user\n249\t *\n250\t *   RETURN:\n251\t *\n252\t *   MVPDP** array of ptrs to datapoints. (The user must free the array, but not the datapoints\n253\t *           They are still owned by the tree.)\n254\t *\n255\t */\n256\tMVPDP** mvptree_retrieve(MVPTree *tree, MVPDP *target, unsigned int knearest, float radius,\n257\t                                       unsigned int *nbresults, MVPError *error);\n258\t\n259\t/*\n260\t *   mvptree_write\n261\t *\n262\t *   DESCRIPTION:\n263\t *\n264\t *   write out a tree to a file\n265\t *\n266\t *   ARGUMENTS:\n267\t *\n268\t *   tree - ptr to MVPTree struct\n269\t *\n270\t *   filename - null-terminated char array\n271\t *\n272\t *   mode - int value for mode for file open.\n273\t *\n274\t *   RETURN\n275\t *\n276\t *   MVPError code\n277\t *\n278\t */\n279\tMVPError mvptree_write(MVPTree *tree, const char *filename, int mode);\n280\t\n281\t/*   mvptree_read\n282\t *\n283\t *   DESCRIPTION:\n284\t *\n285\t *   read a tree from a previously written file into MVPTree struct\n286\t *\n287\t *   ARGUMENTS:\n288\t *\n289\t *   filename - null-terminated char array\n290\t *\n291\t *   fnc - callback function for distance function to use \n292\t *\n293\t *   error - pointer to MVPError code enum\n294\t *\n295\t *   RETURN\n296\t *\n297\t *   MVPTree ptr, or NULL on error (and error is set to error code)\n298\t *\n299\t */\n300\tMVPTree* mvptree_read(const char *filename, CmpFunc fnc, int branchfactor, int pathlength,\\\n301\t                                                  int leafcapacity, MVPError *error);\n302\t\n303\t/*   mvptree_print\n304\t *\n305\t *   DESCRIPTION:\n306\t *\n307\t *   print out a tree\n308\t *\n309\t *   ARGUMENT:\n310\t *\n311\t *   stream - pointer to FILE stream to which to print.\n312\t *\n313\t *   tree   - ptr to the MVPTree struct to print.\n314\t *\n315\t *   RETURN:\n316\t *\n317\t *   MVPERror code\n318\t *\n319\t */\n320\tMVPError mvptree_print(FILE *stream, MVPTree *tree);\n321\t\n322\t/*   mvp_error\n323\t *\n324\t *   DESCRIPTION:\n325\t *\n326\t *   convenience function to return human readable string of error code\n327\t *\n328\t *   ARGUMENTS:\n329\t *\n330\t *   err - MVPError code\n331\t *\n332\t *   RETURN:\n333\t *\n334\t *   string value for error\n335\t *\n336\t */\n337\t\n338\tconst char* mvp_errstr(MVPError err);\n339\t\n340\t#endif /* _MVPTREE_H */\n341\t"}]},"parent_tool_use_id":null,"session_id":"6ea41f0f-9bfd-4f2d-a574-f92c8c54f3ac","uuid":"4e71fe1e-43fa-4316-a240-6fb3c3b7f2b7","timestamp":"2026-06-06T06:24:03.439Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-AWVUPZ/project/c_src/mvptree.h","content":"/*\n *  MVPTree c library\n *  Copyright (C) 2008-2009 by D. Grant Starkweather.\n *  All rights reserved.\n *\n *  This program is free software: you can redistribute it and/or modify\n *  it under the terms of the GNU General Public License as published by\n *  the Free Software Foundation, either version 3 of the License, or\n *  (at your option) any later version.\n *\n *  This program is distributed in the hope that it will be useful,\n *  but WITHOUT ANY WARRANTY; without even the implied warranty of\n *  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n *  GNU General Public License for more details.\n *\n *  You should have received a copy of the GNU General Public License\n *  along with this program.  If not, see <http://www.gnu.org/licenses/>.\n *\n *  D Grant Starkweather - starkd88@gmail.com\n */\n\n#ifndef _MVPTREE_H\n#define _MVPTREE_H\n\n/*data type for a datapoint - refers to the bitwidth of each element */\ntypedef enum mvp_datatype_t { \n    BYTEARRAY = 1, \n    UINT16ARRAY = 2, \n    UINT32ARRAY = 4, \n    UINT64ARRAY = 8 \n} MVPDataType;\n\ntypedef enum nodetype_t { \n    INTERNAL_NODE = 1, \n    LEAF_NODE \n} NodeType;\n\n/* error codes */\ntypedef enum mvp_error_t {\n    MVP_SUCCESS,            /* no error */\n    MVP_ARGERR,             /* argument error */\n    MVP_NODISTANCEFUNC,     /* no distance function found */\n    MVP_MEMALLOC,           /* mem alloc error */\n    MVP_NOLEAF,             /* could not alloc leaf node */\n    MVP_NOINTERNAL,         /* could not alloc internal node */\n    MVP_PATHALLOC,          /* path alloc error */\n    MVP_VPNOSELECT,         /* could not select vantage points */\n    MVP_NOSV1RANGE,         /* could not calculate range of points from sv1 */\n    MVP_NOSV2RANGE,         /* could not calculate range of points from sv2 */\n    MVP_NOSPACE,            /* points too close to one another, too compact */\n    MVP_NOSORT,             /* unable to sort points */\n    MVP_FILEOPEN,           /* trouble opening file */\n    MVP_FILECLOSE,          /* trouble closing file */\n    MVP_MEMMAP,             /* mem map trouble */\n    MVP_MUNMAP,             /* mem unmap trouble */\n    MVP_NOWRITE,            /* could not write to file */\n    MVP_FILETRUNCATE,       /* could not extend file */\n    MVP_MREMAPFAIL,         /* unable to map/unmap file */\n    MVP_TYPEMISMATCH,       /* trying to add datapoints of one datatype */\n                            /* to tree that already contains another type */\n    MVP_KNEARESTCAP,        /* number results found reaches knearest limit */\n    MVP_EMPTYTREE,\n    MVP_NOSPLITS,           /* unable to calculate split points */\n    MVP_BADDISTVAL,         /* val from distance function either NaN or less than 0 */\n    MVP_FILENOTFOUND,       /* file not found */\n    MVP_UNRECOGNIZED,       /* unrecognized node */\n} MVPError;\n\ntypedef struct mvp_datapoint_t {\n    char *id;               /* null-terminated id string */\n    void *data;             /* data for this data point */\n    float *path;            /* path of distances of data point from all vantage points down tree*/\n    unsigned int datalen;   /* length of data in the type designated */    \n    MVPDataType type;       /* type of data (the bitwidth of each data element) */\n} MVPDP;\n\n/* call back function for mvp tree functions - to performa distance calc.'s*/\ntypedef float (*CmpFunc)(MVPDP *pointA, MVPDP *pointB);\n\n/* Callback function to pass to mvp_clear() to free id and data members of the datapoints, */\n/* since the id and data arrays are allocated by user, not by dp_alloc() function. */\ntypedef void (*MVPFreeFunc)(void *ptr);\n\ntypedef struct node_internal_t {\n    NodeType type;\n    MVPDP *sv1, *sv2;\n    float *M1, *M2;\n    void **child_nodes;\n} InternalNode;\n\ntypedef struct node_leaf_t {\n    NodeType type;\n    MVPDP *sv1, *sv2;\n    MVPDP **points;\n    float *d1, *d2;\n    unsigned int nbpoints;\n} LeafNode;\n   \n\ntypedef union node_t {\n    LeafNode leaf;\n    InternalNode internal;\n} Node;\n\n\ntypedef struct mvptree_t {\n    int branchfactor;      /* branch factor of tree, e.g. 2                           */\n    int pathlength;        /* number distances stored for a datapoint's distance      */\n                           /* from each vantage point going down the tree.            */\n                           /* Refers to the array of float's stored in each datapoint.*/\n    int leafcap;           /* capacity of leaf nodes  (number datapoints)             */\n    int fd;                /* internal use                                            */\n    int k;                 /* internal use for retrieve function (knearest)           */\n    MVPDataType datatype;  /* internal use                                            */  \n    off_t pos;             /* internal use for mvp_read() and mvp_write()             */\n    off_t size;            /* internal use for mvp_read() and mvp_write()             */\n    off_t pgsize;          /* system page size (interal use)                          */\n    char *buf;             /* internal use                                            */\n    Node *node;            /* reference to top of tree                                */\n    CmpFunc dist;          /* distance function - e.g. L1 or L2                       */\n} MVPTree;\n\n\n/*   DP* dp_alloc\n *\n *   DESCRIPTION:\n *\n *   allocate a datapoint on the heap\n *\n *   ARGUMENTS:\n *\n *   type - DataType value to indicate the type of data the datapoint represents.\n *\n *   RETURN:\n *   \n *   pointer to DP structure, NULL for error.    \n *\n */\nMVPDP* dp_alloc(MVPDataType type);\n\n/*   dp_free\n *\n *   DESCRIPTION:\n *\n *   free a datapoint\n *\n *   ARGUMENTS:\n *\n *   dp - pointer to datapoint to be free'd.\n *\n *   free_func - callback function that will be used to free the id and data parts of a DP \n *\n *   RETURN: \n *\n *   void\n */\nvoid dp_free(MVPDP *dp, MVPFreeFunc free_func);\n\n/*   mvptree_alloc\n * \n *   DESCRIPTION:\n *\n *   ARGUMENTS:\n *\n *   tree - ptr to MVPTree to initialize (NULL to allocate one on the heap \n *\n *   distance - callback function (the distance function to use in the mvp tree\n *   \n *    bf - int value for the tree branch factor - e.g. 2\n *\n *    p  - int value for the path length to use for each data point\n *\n *    k  - int value for leaf capacity of each leaf node - maximum number of datapoints \n *\n *   RETURN:\n *\n *   MVPTree* ptr, NULL for error\n *    \n */\nMVPTree* mvptree_alloc(MVPTree *tree,CmpFunc distance,\n                                       unsigned int bf,unsigned int p,unsigned int k);\n\n/*\n *  mvptree_clear\n *  \n *  DESCRIPTION:\n *\n *  Clear out the tree. All the datapoints that have been added to the tree\n *  are also free'd with dp_free(). You can specify a free function to free\n *  the portions of the DP struct which are user allocated (e.g. the id and \n *  data fields).\n *\n *  ARGUMENTS:\n *\n *  tree - ptr to tree to clear out\n *\n *  free_func - ptr to function to free the datapoint's id and data fields\n *\n *  RETURN \n *\n *  void\n */\nvoid mvptree_clear(MVPTree *tree, MVPFreeFunc free_func);\n\n/*\n *   mvptree_add\n *\n *   DESCRIPTION:\n *\n *   Add a list of datapoints to a tree. Note: the datapoints are subsequently\n *   owned by the tree, and a call to mvptree_clear() will invoke dp_free() on\n *   all its datapoints. (See mvptree_clear()). However, it does not own the array\n *   containing the pointers to the datapoints.  This must still be free'd by the user.\n *\n *   ARGUMENTS:\n *\n *   tree - ptr to MVPTree a previously allocated tree.\n *\n *   points - array of DP ptrs to add to the tree\n *\n *   nbpoints - unsigned int for the number of datapoint ptrs in points array\n *\n *   RETURN \n *\n *   MVPError error code\n */\nMVPError mvptree_add(MVPTree *tree, MVPDP **points, unsigned int nbpoints);\n\n/*\n *   mvptree_retrieve\n *  \n *   DESCRIPTION:\n *   \n *   retrieve knearest neighbors from the tree\n *\n *   ARGUMENTS:\n *\n *   tree - ptr to the MVPTree\n *\n *   target - target datapoint\n *\n *   knearest - maximum number of datapoints to return\n *\n *   radius   -  distance from the target to include in returned list.\n *\n *   nbresults - ptr to int to contain the number of results returned to user.\n *\n *   error - ptr to error value to return error to user\n *\n *   RETURN:\n *\n *   MVPDP** array of ptrs to datapoints. (The user must free the array, but not the datapoints\n *           They are still owned by the tree.)\n *\n */\nMVPDP** mvptree_retrieve(MVPTree *tree, MVPDP *target, unsigned int knearest, float radius,\n                                       unsigned int *nbresults, MVPError *error);\n\n/*\n *   mvptree_write\n *\n *   DESCRIPTION:\n *\n *   write out a tree to a file\n *\n *   ARGUMENTS:\n *\n *   tree - ptr to MVPTree struct\n *\n *   filename - null-terminated char array\n *\n *   mode - int value for mode for file open.\n *\n *   RETURN\n *\n *   MVPError code\n *\n */\nMVPError mvptree_write(MVPTree *tree, const char *filename, int mode);\n\n/*   mvptree_read\n *\n *   DESCRIPTION:\n *\n *   read a tree from a previously written file into MVPTree struct\n *\n *   ARGUMENTS:\n *\n *   filename - null-terminated char array\n *\n *   fnc - callback function for distance function to use \n *\n *   error - pointer to MVPError code enum\n *\n *   RETURN\n *\n *   MVPTree ptr, or NULL on error (and error is set to error code)\n *\n */\nMVPTree* mvptree_read(const char *filename, CmpFunc fnc, int branchfactor, int pathlength,\\\n                                                  int leafcapacity, MVPError *error);\n\n/*   mvptree_print\n *\n *   DESCRIPTION:\n *\n *   print out a tree\n *\n *   ARGUMENT:\n *\n *   stream - pointer to FILE stream to which to print.\n *\n *   tree   - ptr to the MVPTree struct to print.\n *\n *   RETURN:\n *\n *   MVPERror code\n *\n */\nMVPError mvptree_print(FILE *stream, MVPTree *tree);\n\n/*   mvp_error\n *\n *   DESCRIPTION:\n *\n *   convenience function to return human readable string of error code\n *\n *   ARGUMENTS:\n *\n *   err - MVPError code\n *\n *   RETURN:\n *\n *   string value for error\n *\n */\n\nconst char* mvp_errstr(MVPError err);\n\n#endif /* _MVPTREE_H */\n","numLines":341,"startLine":1,"totalLines":341}}}
