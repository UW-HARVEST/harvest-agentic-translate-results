ze = sysconf(_SC_PAGESIZE);\n68\t    ljmm.page_mask = ljmm.page_size - 1;\n69\t\n70\t    /* step 1: mmap() a tiny block to prevent heap from growing, whichby we\n71\t     *   reserve the space [sbrk(0) - 2G].\n72\t     */\n73\t    char* p = REAL_MMAP(sbrk(0), DUMMY_BLK_SZ, PROT_READ|PROT_WRITE,\n74\t                        MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);\n75\t    if (unlikely(p == MAP_FAILED)) {\n76\t        return;\n77\t    }\n78\t    ljmm.dummy_blk = p;\n79\t\n80\t    ljmm.map_file = \"/proc/self/maps\";\n81\t\n82\t    /* step 2: create buffer for reading content from /proc/$PID/maps */\n83\t    p = REAL_MMAP(NULL, BUFFER_SZ, PROT_READ|PROT_WRITE,\n84\t                  MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);\n85\t    if (unlikely(p == MAP_FAILED)) {\n86\t        return;\n87\t    }\n88\t    ljmm.buffer = p;\n89\t\n90\t    ljmm.init_succ = 1;\n91\t}\n92\t\n93\t/* This function will be called when the process exit normally.*/\n94\t__attribute__((destructor)) static void\n95\tljmm_finalize(void) {\n96\t    if (ljmm.dummy_blk && ljmm.dummy_blk != MAP_FAILED) {\n97\t        munmap(ljmm.dummy_blk, DUMMY_BLK_SZ);\n98\t        ljmm.dummy_blk = NULL;\n99\t        ljmm.map_file = NULL;\n100\t    }\n101\t\n102\t    if (ljmm.buffer && ljmm.buffer != MAP_FAILED) {\n103\t        munmap(ljmm.buffer, BUFFER_SZ);\n104\t    }\n105\t\n106\t    ljmm.init_succ = 0;\n107\t}\n108\t\n109\t/* Read the first \"BUFFER_SZ - 1\" bytes from the given files into ljmm.buffer. */\n110\tstatic int\n111\tread_maps_to_buffer(void) {\n112\t    int fd = open(ljmm.map_file, 0);\n113\t    if (fd == -1) {\n114\t        return -1;\n115\t    }\n116\t\n117\t    int len = read(fd, ljmm.buffer, BUFFER_SZ - 1);\n118\t    if (len >= 0 && ljmm.buffer[len-1] != '\\n') {\n119\t        ljmm.buffer[len++] = '\\n';\n120\t    }\n121\t\n122\t    close(fd);\n123\t\n124\t    ljmm.buf_len = len;\n125\t    return len;\n126\t}\n127\t\n128\t\n129\tstatic inline uintptr_t\n130\tpage_align_addr(uintptr_t addr) {\n131\t    return