\n        InversionList {\n            capacity,\n            support,\n            intervals: merged,\n        }\n    }\n    pub fn intersection(&self, other: &Self) -> Self {\n        let capacity = self.capacity.max(other.capacity);\n        let mut result: Vec<(u32, u32)> = Vec::new();\n        let mut i = 0usize;\n        let mut j = 0usize;\n        while i < self.intervals.len() && j < other.intervals.len() {\n            let (a_lo, a_hi) = self.intervals[i];\n            let (b_lo, b_hi) = other.intervals[j];\n            let lo = a_lo.max(b_lo);\n            let hi = a_hi.min(b_hi);\n            if lo < hi {\n                result.push((lo, hi));\n            }\n            if a_hi < b_hi {\n                i += 1;\n            } else if a_hi > b_hi {\n                j += 1;\n            } else {\n                i += 1;\n                j += 1;\n            }\n        }\n        let support: u32 = result.iter().map(|&(lo, hi)| hi - lo).sum();\n        InversionList {\n            capacity,\n            support,\n            intervals: result,\n        }\n    }\n    pub fn difference(&self, other: &Self) -> Self {\n        let capacity = self.capacity.max(other.capacity);\n        let mut result: Vec<(u32, u32)> = Vec::new();\n        for &(a_lo, a_hi) in &self.intervals {\n            let mut current_lo = a_lo;\n            for &(b_lo, b_hi) in &other.intervals {\n                if b_hi <= current_lo {\n                    continue;\n                }\n                if b_lo >= a_hi {\n                    break;\n                }\n                if b_lo > current_lo {\n                    let upper = b_lo.min(a_hi);\n                    if upper > current_lo {\n                        result.push((current_lo, upper));\n                    }\n                }\n                if b_hi > current_lo {\n                    current_lo = b_hi;\n                }\n                if current_lo >= a_hi {\n                    break;\n                }\n      