 return parse_expression(table, in);\n345\t      }\n346\t    } else if (strcmp(var_name, \"type\") == 0) {\n347\t      parse_type_definition(table, in);\n348\t      if (peek(in) != EOF) {\n349\t        return parse_expression(table, in);\n350\t      }\n351\t    }\n352\t\n353\t    // parse variable type\n354\t    char *type = NULL;\n355\t\n356\t    parse_space_chars(in);\n357\t    // if a variable is in our table, it means its used as a bound in lambda abstraction\n358\t    // therefore should not be typed (because the lambda already type it)\n359\t    // so if it does not exist, it is a constant and should be typed\n360\t    if (!table_exists(table, var_name)) {\n361\t      if (parse_token(peek(in)) != COLON) {\n362\t        const char *error_msg = format(\"Constant Variable %s is not typed. Please provide a type.\\n\", var_name);\n363\t        error(error_msg, __FILE__, __LINE__, __func__);\n364\t      }\n365\t      consume(COLON, in, \":\");\n366\t      parse_space_chars(in);\n367\t      type = parse_type(table, in);\n368\t    }\n369\t\n370\t    AstNode *variable = create_variable(var_name, type);\n371\t    if (search(table, var_name) != NULL) {\n372\t      variable->type = DEFINITION;\n373\t    }\n374\t    return variable;\n375\t  }\n376\t  return NULL;\n377\t}\n378\t\n379\tvoid parse_import(HashTable *table, FILE *in) {\n380\t    // in this step we already parsed the string \"import\"\n381\t    char next_token;\n382\t    tokens_t n;\n383\t\n384\t    consume(WHITESPACE, in, \"a whitespace\");\n385\t\n386\t    consume(QUOTE, in, \"\\\"\");\n387\t\n388\t    char *file_path = malloc(100 * sizeof(char));\n389\t    HANDLE_NULL(file_path);\n390\t\n391\t    next_token = next(in);\n392\t    n = parse_token(next_token);\n393\t\n394\t    file_path[0] = '\\0';\n395\t    int current_length = 0;\n396\t\n397\t    while (n != QUOTE) {\n398\t      // parse the file path\n399\t      if (current_length < 100 - 1) {\n400\t        file_path[current_length] = next_token;\n401\t      