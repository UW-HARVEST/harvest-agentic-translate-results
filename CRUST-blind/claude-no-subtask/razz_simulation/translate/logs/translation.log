\n40\t  *game_count = atoi (*argv++);\n41\t\n42\t  deck = create_shuffled_deck ();\n43\t  if (deck == NULL)\n44\t    {\n45\t      fprintf (stderr, \"Cannot create a shuffled deck\\n\");\n46\t      return 1;\n47\t    }\n48\t  end = 3;\n49\t  decided_cards->my_card_count = end;\n50\t  for (i = 0; i < end; i++)\n51\t    {\n52\t      enum card_rank my_rank;\n53\t      enum card_suit cs = SPADE;\n54\t      const card *my_card;\n55\t\n56\t      if ((my_rank = strtorank (*argv++)) == INVALID_RANK)\n57\t\t{\n58\t\t  fprintf (stderr, \"Invalid my rank specification #%d\\n\", i + 1);\n59\t\t  destroy_deck (&deck);  \n60\t\t  return 1;\n61\t\t}\n62\t\n63\t      csr = cs * RANK_COUNT + my_rank;\n64\t      while (!is_card_in_deck (csr, deck))\n65\t\t{\n66\t\t  if (++cs == SUIT_COUNT)\n67\t\t    {\n68\t\t      break;\n69\t\t    }\n70\t\n71\t\t  csr = cs * RANK_COUNT + my_rank;\n72\t\t}\n73\t\n74\t      if (cs == SUIT_COUNT)\n75\t\t{\n76\t\t  fprintf (stderr, \"Duplicated my rank specification #%d\\n\", i + 1);\n77\t\t  destroy_deck (&deck);  \n78\t\t  return 1;\n79\t\t}\n80\t\n81\t      strip_card_from_deck (csr, deck);\n82\t\n83\t      if ((my_card = create_card (csr)) == NULL)\n84\t\t{\n85\t\t  fprintf (stderr, \"Cannot create my card #%d\\n\", i + 1);\n86\t\t  destroy_deck (&deck);  \n87\t\t  return 1;\n88\t\t}\n89\t      decided_cards->my_cards[i] = my_card;\n90\t    }\n91\t\n92\t  i = 0;\n93\t  while (*argv != NULL)\n94\t    {\n95\t      enum card_rank opponent_rank;\n96\t      enum card_suit cs = SPADE;\n97\t      const card *opponent_card;\n98\t\n99\t      if ((opponent_rank = strtorank (*argv++)) == INVALID_RANK)\n100\t\t{\n101\t\t  fprintf (stderr, \"Invalid opponent rank specification #%d\\n\", i + 1);\n102\t\t  destroy_deck (&deck);  \n103\t\t  return 1;\n104\t\t}\n105\t\n106\t      csr = cs * RANK_COUNT + opponent_rank;\n107\t      while (!is_card_in_deck (csr, deck))\n108\t\t{\n109\t\t  if (++cs == SUIT_COUNT)\n110\t\t    {\n111\t\t      break;\n112\t\t    }\n113\t\n