rintf(\"\\n\");\n113\t\n114\t\tfor (size_t i = 0; i < data_size; i++) {\n115\t\t\t//if there is still space, just insert\n116\t\t\tif (backing_store.data_count < backing_store.data_size) {\n117\t\t\t\tsize_t pos = backing_store.data_count++;\n118\t\t\t\tbacking_store.data[pos] = data[i];\n119\t\t\t\tmax_heap_insert(heap, pos);\n120\t\t\t\tcontinue;\n121\t\t\t}\n122\t\t\t//otherwise, we must compare with the maximum and replace if needed\n123\t\t\tunsigned maximum;\n124\t\t\tTEST_ASSERT(max_heap_maximum(heap, &maximum), \"Could not get heap maximum!\");\n125\t\t\tif (data[i] < backing_store.data[maximum]) {\n126\t\t\t\tbacking_store.data[maximum] = data[i];\n127\t\t\t\tmax_heap_update_maximum(heap);\n128\t\t\t}\n129\t\t}\n130\t\n131\t\tprintf(\"top %ld data: \", heap_size);\n132\t\tfor (size_t i = 0; i < heap_size; i++) {\n133\t\t\tunsigned value = 0;\n134\t\t\tunsigned expected_value = heap_size - i - 1;\n135\t\t\tTEST_ASSERT(max_heap_maximum(heap, &value), \"Could not get heap maximum!\");\n136\t\t\tTEST_ASSERT(value < backing_store.data_size, \"Maximum value exceeds backing_store data size!\");\n137\t\t\tTEST_ASSERT_EQ(backing_store.data[value], expected_value, \"Maximum value in heap unexpected! expected: %d, got %d\");\n138\t\t\tTEST_ASSERT(max_heap_remove_maximum(heap), \"Could not pop heap!\");\n139\t\t\tprintf(\"%d \", backing_store.data[value]);\n140\t\t}\n141\t\tprintf(\"\\n\");\n142\t\n143\t\tfree(backing_store.data);\n144\t\tmax_heap_free(heap);\n145\t}\n146\t\n147\tvoid max_heap_test()\n148\t{\n149\t\tPRETTY_PRINT_TEST_NAME();\n150\t\n151\t\tmax_heap_sort_test();\n152\t\tmax_heap_top_k_test();\n153\t}\n154\t"}]},"parent_tool_use_id":null,"session_id":"7e118838-a39e-4e35-b17e-bd293e3ada1e","uuid":"1d98b388-154d-4cc5-b02a-38fa037cb247","timestamp":"2026-06-06T04:54:57.754Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-jq8lNj/project/c_src/tests/max_heap_test.c","content":"#include \"max_heap_test.h\"\n#include \".