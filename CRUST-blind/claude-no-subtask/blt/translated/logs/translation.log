    }\n                        let dir = if n.mask & key_byte(key, n.byte) != 0 {\n                            1\n                        } else {\n                            0\n                        };\n                        if dir == way {\n                            other = Some(if way == 0 { &n.right } else { &n.left });\n                        }\n                        p = if dir == 1 { &n.right } else { &n.left };\n                    }\n                }\n            }\n            let ndir = if xm & key_byte(key, byte) != 0 { 1 } else { 0 };\n            if ndir == way {\n                other = Some(p);\n            }\n            return other.map(|o| {\n                let l = first_last_in(o, way);\n                BltIt {\n                    key: l.key.clone(),\n                    data: None,\n                }\n            });\n        }\n        if c == 0 {\n            // Equal — return the leaf.\n            return Some(BltIt {\n                key: p_leaf.key.clone(),\n                data: None,\n            });\n        }\n    }\n    None\n}\n","structuredPatch":[{"oldStart":67,"oldLines":12,"newStart":67,"newLines":6,"lines":["     right: Box<InnerNode>,"," }"," ","-impl InnerNode {","-    fn is_internal(&self) -> bool {","-        matches!(self, InnerNode::Internal(_))","-    }","-}","-"," // Returns the byte where each bit is 1 except for the bit corresponding to"," // the leading bit of x."," fn to_mask(x: u8) -> u8 {"]},{"oldStart":83,"oldLines":15,"newStart":77,"newLines":6,"lines":["     x & !(x >> 1)"," }"," ","-// Direction-following predicate: 1 (right) if bit is set, else 0 (left).","-fn direction(byte_at: u8, mask: u8) -> usize {","-    if byte_at & mask != 0 {","-        1","-    } else {","-        0","-    }","-}","-"," fn key_byte(key: &str, idx: usize) -> u8 {","     let bytes = key.as_bytes();","     if idx < bytes.len() {"]}],"userModified":false,"replaceAll":false}}
