    }","+    }","+}","+"," impl Cbt {","+    fn new_with_mode(mode: Mode, len: i32) -> Self {","+        let state = Rc::new(RefCell::new(CbtState::new()));","+        Cbt {","+            count: 0,","+            root: None,","+            first: None,","+            last: None,","+            dup: Some(make_dup_fn(state)),","+            getlen: Some(make_getlen_fn(mode)),","+            cmp: Some(make_cmp_fn(mode)),","+            getcrit: Some(make_getcrit_fn(mode)),","+            len,","+        }","+    }","+","     /// Creates a new crit‐bit tree with ASCIIZ keys.","     pub fn cbt_new() -> Self {","-        unimplemented!();","+        Self::new_with_mode(Mode::Asciiz, 0)","     }","+","     /// Creates a new crit‐bit tree in \"u\" mode (fixed key length).","     pub fn cbt_new_u(len: i32) -> Self {","-        unimplemented!();","+        Self::new_with_mode(Mode::U, len)","     }","+","     /// Creates a new crit‐bit tree in \"enc\" mode.","     pub fn cbt_new_enc() -> Self {","-        unimplemented!();","+        Self::new_with_mode(Mode::Enc, 0)","     }","+","     /// Deletes the crit‐bit tree.","     pub fn cbt_delete(self) {","-        unimplemented!();","+        // Drop happens automatically.","+        drop(self);","     }","+","     /// Returns the data stored at the given key.","     pub fn cbt_get_at(&self, key: &str) -> Option<Box<dyn Any>> {","-        unimplemented!();","+        let state = state_of(self);","+        let s = state.borrow();","+        if s.root.is_none() {","+            return None;","+        }","+        let idx = descend_to_leaf(&s, key);","+        let leaf = &s.leaves[idx];","+        if !leaf.alive {","+            return None;","+        }","+        if leaf.key != key {","+            return None;","+        }","+        // We need to clone the value somehow — but `Box<dyn Any>` isn't","+        // generally Clone.  We try a few well-known concrete types.","+        clone_any(leaf.data.as_ref()?)","     }","+","   