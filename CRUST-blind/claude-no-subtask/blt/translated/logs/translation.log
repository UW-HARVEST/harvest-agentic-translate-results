eq!(f.key, \"blink\");\n    let f = t.blt_floor(\"blink182\").expect(\"floor\");\n    assert_eq!(f.key, \"blink\");\n\n    // Test first/last\n    let first = t.blt_first().expect(\"first\");\n    assert_eq!(first.key, \"a\");\n    let last = t.blt_last().expect(\"last\");\n    assert_eq!(last.key, \"blynn\");\n\n    // Test delete\n    assert_eq!(t.blt_delete(\"ben\"), 1);\n    assert_eq!(t.blt_size(), 7);\n    assert_eq!(t.blt_delete(\"ben\"), 0);\n    assert!(t.blt_get(\"ben\").is_none());\n    assert!(t.blt_get(\"blink\").is_some());\n}\n\n#[test]\nfn next_prev() {\n    let mut t = Blt::blt_new();\n    let words = [\"a\", \"aardvark\", \"b\", \"ben\", \"blink\", \"bliss\", \"blt\", \"blynn\"];\n    for w in &words {\n        t.blt_set(w);\n    }\n    let mut keys = Vec::new();\n    let mut cur = t.blt_first();\n    while let Some(it) = cur {\n        keys.push(it.key.clone());\n        cur = t.blt_next(&it);\n    }\n    let mut sorted: Vec<&str> = words.iter().copied().collect();\n    sorted.sort();\n    assert_eq!(keys, sorted);\n\n    let mut keys = Vec::new();\n    let mut cur = t.blt_last();\n    while let Some(it) = cur {\n        keys.push(it.key.clone());\n        cur = t.blt_prev(&it);\n    }\n    let mut sorted: Vec<&str> = words.iter().copied().collect();\n    sorted.sort();\n    sorted.reverse();\n    assert_eq!(keys, sorted);\n}\nEOF\ncargo test --test test_blt 2>&1 | tail -30","description":"Test BLT"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":325,"cache_read_input_tokens":79620,"cache_creation":{"ephemeral_5m_input_tokens":325,"ephemeral_1h_input_tokens":0},"output_tokens":23,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b715a6ac-ab48-4ab4-9f88-304827c25dba","uuid":"50f7e4e9-bcda-4e71-8b84-12c6ea6f3c54"}
