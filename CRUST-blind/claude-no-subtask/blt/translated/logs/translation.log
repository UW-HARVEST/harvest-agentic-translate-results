blink\");\n    let f = t.blt_floor(\"blink182\").expect(\"floor\");\n    assert_eq!(f.key, \"blink\");\n\n    // Test next/prev\n    let first = t.blt_first().expect(\"first\");\n    assert_eq!(first.key, \"a\");\n    let last = t.blt_last().expect(\"last\");\n    assert_eq!(last.key, \"blynn\");\n\n    // Test delete\n    assert_eq!(t.blt_delete(\"ben\"), 1);\n    assert_eq!(t.blt_size(), 7);\n    assert_eq!(t.blt_delete(\"ben\"), 0);\n    assert!(t.blt_get(\"ben\").is_none());\n    assert!(t.blt_get(\"blink\").is_some());\n\n    println!(\"All BLT tests passed!\");\n}\nEOF\necho \"test prog ready\"","description":"Create blt test"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":190,"cache_read_input_tokens":78270,"cache_creation":{"ephemeral_5m_input_tokens":190,"ephemeral_1h_input_tokens":0},"output_tokens":23,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b715a6ac-ab48-4ab4-9f88-304827c25dba","uuid":"54dc11f7-5701-453d-9f07-14e06e5daa89"}
