),","+    }","+}","+","+fn delete_internal(n: InnerInternal, key: &str) -> (Option<Box<InnerNode>>, bool) {","+    let keylen = key.len();","+    if n.byte > keylen {","+        return (Some(Box::new(InnerNode::Internal(n))), false);","+    }","+    let go_right = key_byte(key, n.byte) & n.mask != 0;","+    let InnerInternal {","+        byte,","+        mask,","+        left,","+        right,","+    } = n;","+    if go_right {","+        // Recurse into right.","+        let (new_right, removed_leaf) = delete_child(right, key);","+        if removed_leaf {","+            // Promote left as our replacement.","+            (Some(left), true)","+        } else if let Some(rr) = new_right {","+            (","+                Some(Box::new(InnerNode::Internal(InnerInternal {","+                    byte,","+                    mask,","+                    left,","+                    right: rr,","+                }))),","+                true,","+            )","+        } else {","+            // Not removed","+            (","+                Some(Box::new(InnerNode::Internal(InnerInternal {","+                    byte,","+                    mask,","+                    left,","+                    right: Box::new(InnerNode::Leaf(InnerLeaf {","+                        key: String::new(),","+                    })), // dummy unreachable","+                }))),","+                false,","+            )","+        }","+    } else {","+        let (new_left, removed_leaf) = delete_child(left, key);","+        if removed_leaf {","+            (Some(right), true)","+        } else if let Some(ll) = new_left {","+            (","+                Some(Box::new(InnerNode::Internal(InnerInternal {","+                    byte,","+                    mask,","+                    left: ll,","+                    right,","+                }))),","+                true,","+            )","+        } else {","+            (","+                Some(Box::new(InnerNode::Internal(InnerInternal {","+                    byte,","+                    mask,","+                    left: Box::new(InnerNode::Leaf(InnerLeaf {","+                        key: String::new(),","+                    })),","+                    right,","+                }))),","+                false,","+            )","+        }","+    }","+}","+","+// Returns (Some(new_subtree), removed_leaf_at_this_position) or","+// (None, false) if the deletion was not performed (key absent).","+//","+// We need three-state results: not found vs found with new subtree vs the","+// child *was* the leaf to delete (in which case the parent must promote","+// the sibling).  Encode as:","+//   (None, true)  → child was the leaf and it was deleted (parent should","+//                   promote the sibling — caller handles).","+//   (Some(x), true) → child was an internal node, and x is the rebuilt","+//                     subtree after removal (deletion successful below).","+//   (Some(x), false) → key not found; x is the unchanged subtree.","+fn delete_child(child: Box<InnerNode>, key: &str) -> (Option<Box<InnerNode>>, bool) {","+    match *child {","+        InnerNode::Leaf(l) => {","+            if l.key == key {","+                (None, true)","+            } else {","+                (Some(Box::new(InnerNode::Leaf(l))), false)","+            }","+        }","+        InnerNode::Internal(n) => {","+            let (new_sub, removed) = delete_internal(n, key);","+            if removed {","+                (new_sub, true)","+            } else {","+                (new_sub, false)","+            }","+        }","+    }","+}","+","+fn ceil_floor(blt: &Blt, key: &str, way: usize) -> Option<BltIt> {","+    let s = blt.storage();","+    let root = s.inner.as_deref()?;","+    let p_leaf = confident_descend(root, key);","+    let key_bytes = key.as_bytes();","+    let pkey_bytes = p_leaf.key.as_bytes();","+    let max_len = key_bytes.len().max(pkey_bytes.len()) + 1;","+    for i in 0..max_len {","+        let c = if i < key_bytes.len() { key_bytes[i] } else { 0 };","+        let pc = if i < pkey_bytes.len() {","+            pkey_bytes[i]","+        } else {","+            0","+        };","+        let x = c ^ pc;","+        if x != 0 {","+            let byte = i;","+            let xm = to_mask(x);","+            // Walk down the tree until external or higher crit-bit.","+            let mut p: &InnerNode = root;","+            let mut other: Option<&InnerNode> = None;","+            loop {","+                match p {","+                    InnerNode::Leaf(_) => break,","+                    InnerNode::Internal(n) => {","+                        let cur = (byte << 8) + (n.mask as usize);","+                        let target = (n.byte << 8) + (xm as usize);","+                        if cur < target {","+                            break;","+                        }","+                        let dir = if n.mask & key_byte(key, n.byte) != 0 {","+                            1","+                        } else {","+                            0","+                        };","+                        if dir == way {","+                            other = Some(if way == 0 { &n.right } else { &n.left });","+                        }","+                        p = if dir == 1 { &n.right } else { &n.left };","+                    }","+                }","+            }","+            let ndir = if xm & key_byte(key, byte) != 0 { 1 } else { 0 };","+            if ndir == way {","+                other = Some(p);","+            }","+            return other.map(|o| {","+                let l = first_last_in(o, way);","+                BltIt {","+                    key: l.key.clone(),","+                    data: None,","+                }","+            });","+        }","+        if c == 0 {","+            // Equal — return the leaf.","+            return Some(BltIt {","+                key: p_leaf.key.clone(),","+                data: None,","+            });","+        }","+    }","+    None","+}"]}],"originalFile":"use std::any::Any;\n/// The BLT tree structure.\n#[derive(Debug)]\npub struct Blt {\n    /// The root node.\n    pub root: Box<BltNode>,\n    /// Indicates whether the tree is empty.\n    pub empty: i32,\n}\n/// A node in the BLT tree.\n#[derive(Debug)]\npub enum BltNode {\n    /// An internal node.\n    Internal(InternalNode),\n    /// A leaf node (external node).\n    Leaf(BltIt),\n}\n/// Represents an internal node in the BLT tree.\n#[derive(Debug)]\npub struct InternalNode {\n    /// Byte number of difference (32 bits).\n    pub byte: u32,\n    /// Mask byte (8 bits).\n    pub mask: u8,\n    /// Padding (23 bits stored in a u32).\n    pub padding: u32,\n    /// The child node.\n    pub kid: Box<BltNode>,\n}\n/// Represents a leaf node in the BLT tree.\n#[derive(Debug)]\npub struct BltIt {\n    /// The key associated with the leaf.\n    pub key: String,\n    /// Associated data.\n    pub data: Option<Box<dyn Any>>,\n}\nimpl Blt {\n    /// Creates a new BLT tree.\n    pub fn blt_new() -> Self {\n        unimplemented!();\n    }\n    /// Clears (destroys) the tree.\n    pub fn blt_clear(&mut self) {\n        unimplemented!();\n    }\n    /// Retrieves the leaf node at the given key.\n    pub fn blt_get(&self, key: &str) -> Option<BltIt> {\n        unimplemented!();\n    }\n    /// Creates or retrieves the leaf node at the given key.\n    pub fn blt_set(&mut self, key: &str) -> BltIt {\n        unimplemented!();\n    }\n    /// Creates or retrieves the leaf node at the given key and returns a tuple (leaf, is_new).\n    pub fn blt_setp(&mut self, key: &str) -> (BltIt, bool) {\n        unimplemented!();\n    }\n    /// Inserts the given key/data pair and returns the corresponding leaf.\n    pub fn blt_put(&mut self, key: &str, data: Box<dyn Any>) -> BltIt {\n        unimplemented!();\n    }\n    /// Inserts the key/data pair only if the key is absent.\n    /// Returns 0 on success or 1 if the key is alrea