    /*\n     * Non-linear section.\n     */\n    t2 = y12 & y15;\n    t3 = y3 & y6;\n    t4 = t3 ^ t2;\n    t5 = y4 & x7;\n    t6 = t5 ^ t2;\n    t7 = y13 & y16;\n    t8 = y5 & y1;\n    t9 = t8 ^ t7;\n    t10 = y2 & y7;\n    t11 = t10 ^ t7;\n    t12 = y9 & y11;\n    t13 = y14 & y17;\n    t14 = t13 ^ t12;\n    t15 = y8 & y10;\n    t16 = t15 ^ t12;\n    t17 = t4 ^ t14;\n    t18 = t6 ^ t16;\n    t19 = t9 ^ t14;\n    t20 = t11 ^ t16;\n    t21 = t17 ^ y20;\n    t22 = t18 ^ y19;\n    t23 = t19 ^ y21;\n    t24 = t20 ^ y18;\n\n    t25 = t21 ^ t22;\n    t26 = t21 & t23;\n    t27 = t24 ^ t26;\n    t28 = t25 & t27;\n    t29 = t28 ^ t22;\n    t30 = t23 ^ t24;\n    t31 = t22 ^ t26;\n    t32 = t31 & t30;\n    t33 = t32 ^ t24;\n    t34 = t23 ^ t33;\n    t35 = t27 ^ t33;\n    t36 = t24 & t35;\n    t37 = t36 ^ t34;\n    t38 = t27 ^ t36;\n    t39 = t29 & t38;\n    t40 = t25 ^ t39;\n\n    t41 = t40 ^ t37;\n    t42 = t29 ^ t33;\n    t43 = t29 ^ t40;\n    t44 = t33 ^ t37;\n    t45 = t42 ^ t41;\n    z0 = t44 & y15;\n    z1 = t37 & y6;\n    z2 = t33 & x7;\n    z3 = t43 & y16;\n    z4 = t40 & y1;\n    z5 = t29 & y7;\n    z6 = t42 & y11;\n    z7 = t45 & y17;\n    z8 = t41 & y10;\n    z9 = t44 & y12;\n    z10 = t37 & y3;\n    z11 = t33 & y4;\n    z12 = t43 & y13;\n    z13 = t40 & y5;\n    z14 = t29 & y2;\n    z15 = t42 & y9;\n    z16 = t45 & y14;\n    z17 = t41 & y8;\n\n    /*\n     * Bottom linear transformation.\n     */\n    t46 = z15 ^ z16;\n    t47 = z10 ^ z11;\n    t48 = z5 ^ z13;\n    t49 = z9 ^ z10;\n    t50 = z2 ^ z12;\n    t51 = z2 ^ z5;\n    t52 = z7 ^ z8;\n    t53 = z0 ^ z3;\n    t54 = z6 ^ z7;\n    t55 = z16 ^ z17;\n    t56 = z12 ^ t48;\n    t57 = t50 ^ t53;\n    t58 = z4 ^ t46;\n    t59 = z3 ^ t54;\n    t60 = t46 ^ t57;\n    t61 = z14 ^ t57;\n    t62 = t52 ^ t58;\n    t63 = t49 ^ t58;\n    t64 = z4 ^ t59;\n    t65 = t61 ^ t62;\n    t66 = z1 ^ t63;\n    s0 = t59 ^ t63;\n    s6 = t56 ^ !t62;\n    s7 = t48 ^ !t60;\n    t67 = t64 ^ t65;\n    s3 = t53 ^ t66;\n    s4 = t51 ^ t66;\n  