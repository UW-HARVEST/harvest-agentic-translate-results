", \"simple\");\n}\n\n#[test]\nfn test_kat_haraka_256f_robust() {\n    run_kat_comparison(\"haraka\", \"256f\", \"robust\");\n}\n\n#[test]\nfn test_kat_haraka_256s_simple() {\n    run_kat_comparison(\"haraka\", \"256s\", \"simple\");\n}\n\n#[test]\nfn test_kat_haraka_256s_robust() {\n    run_kat_comparison(\"haraka\", \"256s\", \"robust\");\n}\n\n/// Test that C .so functions can be loaded and called\n#[test]\nfn test_load_c_libs_blake_128f() {\n    test_seed_keypair_via_libs(\"blake\", \"128f\", \"simple\");\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":776,"cache_read_input_tokens":129171,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":776},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"40cff8f1-55c4-4312-944f-3a5007119e9f","uuid":"3da547b3-55c1-462c-8661-c67828ef2a44"}
