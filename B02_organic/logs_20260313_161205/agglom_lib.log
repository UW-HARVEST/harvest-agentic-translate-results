// ---- Floor division (f3) ----

fn f3_impl(v1: i32, v2: i32) -> i32 {
    if v2 == 0 {
        return 0;
    }
    let int_min: i32 = -0x7fffffffi32 - 1;
    let q: i32;
    let r: i32;
    if v1 >= 0 {
