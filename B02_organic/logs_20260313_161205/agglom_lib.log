    let d1 = (a.max.x < b.min.x) as i32;
    let d2 = (b.max.y < a.min.y) as i32;
    let d3 = (a.max.y < b.min.y) as i32;
    ((d0 | d1 | d2 | d3) == 0) as i32
}

fn f2_impl(a: *const u8, type_a: i32, b: *const u8, type_b: i32) -> i32 {
