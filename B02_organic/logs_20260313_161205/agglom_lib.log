import re

with open('lib.c') as f:
    content = f.read()

# Extract CRC16 tables
crc_match = re.search(r'static const tflac_u16 tflac_crc16_tables\[8\]\[256\] = \{(.*?)\};', content, re.DOTALL)
crc_text = crc_match.group(1)
sub_arrays = re.findall(r'\{([^}]+)\}', crc_text)

# Extract m__mantissa
m = re.search(r'static uint32_t m__mantissa\[2048\] = \{([^}]+)\}', content)
mantissa_vals = [v.strip() for v in m.group(1).split(',') if v.strip()]

# Extract m__offset
m2 = re.search(r'static uint16_t m__offset\[64\] = \{([^}]+)\}', content)
offset_vals = [v.strip() for v in m2.group(1).split(',') if v.strip()]

# Extract m__exponent
m3 = re.search(r'static uint32_t m__exponent\[64\] = \{([^}]+)\}', content)
exponent_vals = [v.strip() for v in m3.group(1).split(',') if v.strip()]

def fmt_array(vals, per_line, indent="    "):
    lines = []
    for i in range(0, len(vals), per_line):
        chunk = ", ".join(vals[i:i+per_line])
        lines.append(f"{indent}{chunk},")
    return "\n".join(lines)

# Build CRC16 table string
crc_lines = []
for i, sa in enumerate(sub_arrays):
    vals = [v.strip() for v in sa.split(',') if v.strip()]
    crc_lines.append("    [")
    crc_lines.append(fmt_array(vals, 8, "        "))
    crc_lines.append("    ],")

crc_str = "\n".join(crc_lines)
