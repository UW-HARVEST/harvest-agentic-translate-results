// ---- RNG (f4) ----

#[repr(C)]
struct CnRnd {
    state: [u64; 2],
}

fn cn_rnd_next(rnd: &mut CnRnd) -> u64 {
    let mut x = rnd.state[0];
    let y = rnd.state[1];
    rnd.state[0] = y;
    x ^= x << 23;
    x ^= x >> 17;
    x ^= y ^ (y >> 26);
    rnd.state[1] = x;
    x.wrapping_add(y)
}

fn f4_impl(rnd: &mut CnRnd) -> f64 {
    let value = cn_rnd_next(rnd);
    let exponent: u64 = 1023;
    let mantissa = value >> 12;
    let result = (exponent << 52) | mantissa;
