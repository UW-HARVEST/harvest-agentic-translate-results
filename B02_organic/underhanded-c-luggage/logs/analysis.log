        while pos < len(text) and text[pos] in ' \t\n\r':
            pos += 1
            
        # scanf('%6[A-Z0-9]', flight_id)
        start = pos
        while pos < len(text) and pos - start < 6 and (text[pos].isupper() or text[pos].isdigit()):
            pos += 1
        if pos == start:
