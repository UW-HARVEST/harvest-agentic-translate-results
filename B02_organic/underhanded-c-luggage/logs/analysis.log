        flight_id = text[start:pos]
        
        # Skip whitespace
        while pos < len(text) and text[pos] in ' \t\n\r':
            pos += 1
            
        # scanf('%3[A-Z]', departure)
        start = pos
        while pos < len(text) and pos - start < 3 and text[pos].isupper():
            pos += 1
        if pos == start:
            break
        departure = text[start:pos]
        
        # NO whitespace skip between departure and arrival in C!
