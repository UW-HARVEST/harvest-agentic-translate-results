        start = pos
        while pos < len(text) and pos - start < 3 and text[pos].isupper():
            pos += 1
        if pos == start:
            break
        arrival = text[start:pos]
        
        # scanf('%80[^\n]', comments) - up to 80 non-newline chars
        start = pos
        end = min(pos + 80, len(text))
        while pos < end and text[pos] != '\n':
            pos += 1
        comments = text[start:pos]
        
        directives.append((time_stamp, luggage_id, flight_id, departure, arrival, comments))
    
    return directives

