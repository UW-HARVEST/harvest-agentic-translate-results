+     6: pub unsafe extern "C" fn tool_basename(path: *mut c_char) -> *mut c_char {
+     7:     unsafe {
+     8:         let s1 = libc::strrchr(path, b'/' as i32);
+     9:         let s2 = libc::strrchr(path, b'\\' as i32);
+    10: 
+    11:         if !s1.is_null() && !s2.is_null() {
