+    258:     } else if uAB <= 0.0 && vBC <= 0.0 {
+    259:         s.a = s.b; s.a.u = 1.0; s.div = 1.0; s.count = 1;
+    260:     } else if uBC <= 0.0 && vCA <= 0.0 {
+    261:         s.a = s.c; s.a.u = 1.0; s.div = 1.0; s.count = 1;
+    262:     } else if uAB > 0.0 && vAB > 0.0 && wABC <= 0.0 {
+    263:         s.a.u = uAB; s.b.u = vAB; s.div = uAB + vAB; s.count = 2;
+    264:     } else if uBC > 0.0 && vBC > 0.0 && uABC <= 0.0 {
+    265:         s.a = s.b; s.b = s.c;
+    266:         s.a.u = uBC; s.b.u = vBC; s.div = uBC + vBC; s.count = 2;
+    267:     } else if uCA > 0.0 && vCA > 0.0 && vABC <= 0.0 {
+    268:         s.b = s.a; s.a = s.c;
+    269:         s.a.u = uCA; s.b.u = vCA; s.div = uCA + vCA; s.count = 2;
+    270:     } else {
