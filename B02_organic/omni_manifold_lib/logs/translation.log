+    272:         s.div = uABC + vABC + wABC; s.count = 3;
+    273:     }
+    274: }
+    275: 
+    276: fn c2D(s: &c2Simplex) -> c2v {
+    277:     match s.count {
+    278:         1 => c2Neg(s.a.p),
+    279:         2 => {
+    280:             let ab = c2Sub(s.b.p, s.a.p);
+    281:             if c2Det2(ab, c2Neg(s.a.p)) > 0.0 { c2Skew(ab) } else { c2CCW90(ab) }
+    282:         }
+    283:         _ => c2V(0.0, 0.0),
+    284:     }
+    285: }
+    286: 
+    287: fn c2Witness(s: &c2Simplex, a: &mut c2v, b: &mut c2v) {
+    288:     let den = 1.0f32 / s.div;
+    289:     match s.count {
+    290:         1 => { *a = s.a.sA; *b = s.a.sB; }
+    291:         2 => {
+    292:             *a = c2Add(c2Mulvs(s.a.sA, den * s.a.u), c2Mulvs(s.b.sA, den * s.b.u));
+    293:             *b = c2Add(c2Mulvs(s.a.sB, den * s.a.u), c2Mulvs(s.b.sB, den * s.b.u));
+    294:         }
+    295:         3 => {
+    296:             *a = c2Add(c2Add(c2Mulvs(s.a.sA, den * s.a.u), c2Mulvs(s.b.sA, den * s.b.u)),
+    297:                        c2Mulvs(s.c.sA, den * s.c.u));
+    298:             *b = c2Add(c2Add(c2Mulvs(s.a.sB, den * s.a.u), c2Mulvs(s.b.sB, den * s.b.u)),
+    299:                        c2Mulvs(s.c.sB, den * s.c.u));
+    300:         }
+    301:         _ => { *a = c2V(0.0, 0.0); *b = c2V(0.0, 0.0); }
+    302:     }
+    303: }
+    304: 
+    305: fn c2L(s: &c2Simplex) -> c2v {
+    306:     let den = 1.0f32 / s.div;
+    307:     match s.count {
+    308:         1 => s.a.p,
+    309:         2 => c2Add(c2Mulvs(s.a.p, den * s.a.u), c2Mulvs(s.b.p, den * s.b.u)),
+    310:         _ => c2V(0.0, 0.0),
+    311:     }
+    312: }

