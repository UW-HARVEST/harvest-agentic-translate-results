+    316: fn c2Clip(seg: &mut [c2v; 2], h: c2h) -> i32 {
+    317:     let mut out = [c2V(0.0, 0.0); 2];
+    318:     let mut sp = 0usize;
+    319:     let d0 = c2Dist_h(h, seg[0]);
+    320:     let d1 = c2Dist_h(h, seg[1]);
+    321:     if d0 < 0.0 { out[sp] = seg[0]; sp += 1; }
+    322:     if d1 < 0.0 { out[sp] = seg[1]; sp += 1; }
+    323:     if d0 == 0.0 && d1 == 0.0 {
+    324:         out[sp] = seg[0]; sp += 1;
+    325:         out[sp] = seg[1]; sp += 1;
+    326:     } else if d0 * d1 <= 0.0 {
+    327:         out[sp] = c2Intersect(seg[0], seg[1], d0, d1); sp += 1;
+    328:     }
+    329:     seg[0] = out[0];
+    330:     seg[1] = out[1];
+    331:     sp as i32
+    332: }
+    333: 
+    334: fn c2SidePlanes(seg: &mut [c2v; 2], ra: c2v, rb: c2v, h: Option<&mut c2h>) -> bool {
+    335:     let inv = c2Norm(c2Sub(rb, ra));
+    336:     let left = c2h { n: c2Neg(inv), d: c2Dot(c2Neg(inv), ra) };
+    337:     let right = c2h { n: inv, d: c2Dot(inv, rb) };
+    338:     if c2Clip(seg, left) < 2 { return false; }
+    339:     if c2Clip(seg, right) < 2 { return false; }
+    340:     if let Some(h) = h {
+    341:         h.n = c2CCW90(inv);
+    342:         h.d = c2Dot(c2CCW90(inv), ra);
+    343:     }
+    344:     true
+    345: }
+    346: 
+    347: fn c2SidePlanesFromPoly(seg: &mut [c2v; 2], x: c2x, p: &c2Poly, e: i32, h: Option<&mut c2h>) -> bool {
+    348:     let ra = c2Mulxv(x, p.verts[e as usize]);
+    349:     let next = if e + 1 == p.count { 0 } else { (e + 1) as usize };
+    350:     let rb = c2Mulxv(x, p.verts[next]);
+    351:     c2SidePlanes(seg, ra, rb, h)
+    352: }
