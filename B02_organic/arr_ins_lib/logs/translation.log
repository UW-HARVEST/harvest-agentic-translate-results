+    154: // stbds_arrgrowf
+    155: // ============================================================
+    156: #[unsafe(no_mangle)]
+    157: pub unsafe extern "C" fn stbds_arrgrowf(
+    158:     a: *mut u8,
+    159:     elemsize: usize,
+    160:     addlen: usize,
+    161:     min_cap: usize,
+    162: ) -> *mut u8 {
+    163:     let mut min_cap = min_cap;
+    164:     let min_len = (stbds_arrlen(a) as usize).wrapping_add(addlen);
+    165: 
+    166:     if min_len > min_cap {
+    167:         min_cap = min_len;
+    168:     }
+    169: 
+    170:     if min_cap <= stbds_arrcap(a) {
+    171:         return a;
+    172:     }
+    173: 
+    174:     if min_cap < 2 * stbds_arrcap(a) {
+    175:         min_cap = 2 * stbds_arrcap(a);
+    176:     } else if min_cap < 4 {
+    177:         min_cap = 4;
+    178:     }
+    179: 
+    180:     let alloc_size = elemsize * min_cap + std::mem::size_of::<stbds_array_header>();
+    181:     let old_ptr = if !a.is_null() {
+    182:         stbds_header(a) as *mut u8
+    183:     } else {
+    184:         ptr::null_mut()
+    185:     };
+    186:     let b_raw = stbds_realloc(old_ptr, alloc_size);
+    187:     let b = b_raw.add(std::mem::size_of::<stbds_array_header>());
+    188: 
+    189:     if a.is_null() {
+    190:         (*stbds_header(b)).length = 0;
+    191:         (*stbds_header(b)).hash_table = ptr::null_mut();
+    192:         (*stbds_header(b)).temp = 0;
+    193:     }
+    194: 
+    195:     (*stbds_header(b)).capacity = min_cap;
+    196:     b
+    197: }
