+    114: }
+    115: 
+    116: unsafe fn cp_ptr(s: *mut cp_state_t) -> *mut u8 {
+    117:     ((*s).words.add((*s).word_index as usize) as *mut u8).offset(-((*s).count / 8) as isize)
+    118: }
+    119: 
+    120: unsafe fn cp_peak_bits(s: *mut cp_state_t, num_bits_to_read: i32) -> u64 {
+    121:     if (*s).count < num_bits_to_read {
+    122:         if (*s).word_index < (*s).word_count {
+    123:             let word = *(*s).words.add((*s).word_index as usize);
+    124:             (*s).word_index += 1;
+    125:             (*s).bits |= (word as u64) << (*s).count;
+    126:             (*s).count += 32;
+    127:         } else if (*s).final_word_available != 0 {
+    128:             let word = (*s).final_word;
+    129:             (*s).bits |= (word as u64) << (*s).count;
+    130:             (*s).count += (*s).bits_left;
+    131:             (*s).final_word_available = 0;
+    132:         }
+    133:     }
+    134:     (*s).bits
+    135: }
+    136: 
