+    284: pub fn blake256_update(s: &mut BlakeState256, data: &[u8], mut datalen: u64) {
+    285:     let mut data_off: usize = 0;
+    286:     let mut left = (s.buflen >> 3) as usize;
+    287:     let fill = 64 - left;
+    288: 
+    289:     if left != 0 && ((datalen >> 3) & 0x3F) >= fill as u64 {
+    290:         s.buf[left..left + fill].copy_from_slice(&data[data_off..data_off + fill]);
+    291:         s.t[0] = s.t[0].wrapping_add(512);
+    292:         if s.t[0] == 0 {
+    293:             s.t[1] = s.t[1].wrapping_add(1);
+    294:         }
+    295:         blake256_compress(s, &s.buf.clone());
+    296:         data_off += fill;
+    297:         datalen -= (fill as u64) << 3;
+    298:         left = 0;
+    299:     }
+    300: 
+    301:     while datalen >= 512 {
+    302:         s.t[0] = s.t[0].wrapping_add(512);
+    303:         if s.t[0] == 0 {
+    304:             s.t[1] = s.t[1].wrapping_add(1);
+    305:         }
+    306:         blake256_compress(s, &data[data_off..]);
+    307:         data_off += 64;
+    308:         datalen -= 512;
+    309:     }
+    310: 
+    311:     if datalen > 0 {
+    312:         let bytes = (datalen >> 3) as usize;
+    313:         s.buf[left..left + bytes].copy_from_slice(&data[data_off..data_off + bytes]);
+    314:         s.buflen = ((left << 3) as u64 + datalen) as i32;
+    315:     } else {
+    316:         s.buflen = 0;
+    317:     }
+    318: }
