+    306:         padded[120] = (bytes >> 53) as u8;
+    307:         padded[121] = (bytes >> 45) as u8;
+    308:         padded[122] = (bytes >> 37) as u8;
+    309:         padded[123] = (bytes >> 29) as u8;
+    310:         padded[124] = (bytes >> 21) as u8;
+    311:         padded[125] = (bytes >> 13) as u8;
+    312:         padded[126] = (bytes >> 5) as u8;
+    313:         padded[127] = (bytes << 3) as u8;
+    314:         crypto_hashblocks_sha512(state, &padded, 128);
+    315:     } else {
+    316:         for i in (remaining + 1)..247 { padded[i] = 0; }
+    317:         padded[247] = (bytes >> 61) as u8;
+    318:         padded[248] = (bytes >> 53) as u8;
+    319:         padded[249] = (bytes >> 45) as u8;
+    320:         padded[250] = (bytes >> 37) as u8;
+    321:         padded[251] = (bytes >> 29) as u8;
+    322:         padded[252] = (bytes >> 21) as u8;
+    323:         padded[253] = (bytes >> 13) as u8;
+    324:         padded[254] = (bytes >> 5) as u8;
+    325:         padded[255] = (bytes << 3) as u8;
+    326:         crypto_hashblocks_sha512(state, &padded, 256);
+    327:     }
+    328: 
+    329:     out[..64].copy_from_slice(&state[..64]);
+    330: }
