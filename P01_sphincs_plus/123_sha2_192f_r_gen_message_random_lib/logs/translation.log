+    240: pub fn sha256_inc_blocks(state: &mut [u8], data: &[u8], inblocks: usize) {
+    241:     let mut bytes = load_bigendian_64(&state[32..]);
+    242:     crypto_hashblocks_sha256(state, data, 64 * inblocks);
+    243:     bytes += (64 * inblocks) as u64;
+    244:     store_bigendian_64(&mut state[32..], bytes);
+    245: }
+    246: 
+    247: pub fn sha512_inc_blocks(state: &mut [u8], data: &[u8], inblocks: usize) {
+    248:     let mut bytes = load_bigendian_64(&state[64..]);
+    249:     crypto_hashblocks_sha512(state, data, 128 * inblocks);
+    250:     bytes += (128 * inblocks) as u64;
+    251:     store_bigendian_64(&mut state[64..], bytes);
+    252: }
