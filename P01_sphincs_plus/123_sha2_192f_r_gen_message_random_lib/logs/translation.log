+    254: pub fn sha256_inc_finalize(out: &mut [u8], state: &mut [u8], data: &[u8], inlen: usize) {
+    255:     let mut padded = [0u8; 128];
+    256:     let bytes = load_bigendian_64(&state[32..]) + inlen as u64;
+    257: 
+    258:     crypto_hashblocks_sha256(state, data, inlen);
+    259:     let remaining = inlen & 63;
+    260:     let start = inlen - remaining;
+    261: 
+    262:     padded[..remaining].copy_from_slice(&data[start..start + remaining]);
+    263:     padded[remaining] = 0x80;
+    264: 
+    265:     if remaining < 56 {
+    266:         for i in (remaining + 1)..56 { padded[i] = 0; }
+    267:         padded[56] = (bytes >> 53) as u8;
+    268:         padded[57] = (bytes >> 45) as u8;
+    269:         padded[58] = (bytes >> 37) as u8;
+    270:         padded[59] = (bytes >> 29) as u8;
+    271:         padded[60] = (bytes >> 21) as u8;
+    272:         padded[61] = (bytes >> 13) as u8;
+    273:         padded[62] = (bytes >> 5) as u8;
+    274:         padded[63] = (bytes << 3) as u8;
+    275:         crypto_hashblocks_sha256(state, &padded, 64);
+    276:     } else {
+    277:         for i in (remaining + 1)..120 { padded[i] = 0; }
+    278:         padded[120] = (bytes >> 53) as u8;
+    279:         padded[121] = (bytes >> 45) as u8;
+    280:         padded[122] = (bytes >> 37) as u8;
+    281:         padded[123] = (bytes >> 29) as u8;
+    282:         padded[124] = (bytes >> 21) as u8;
+    283:         padded[125] = (bytes >> 13) as u8;
+    284:         padded[126] = (bytes >> 5) as u8;
+    285:         padded[127] = (bytes << 3) as u8;
+    286:         crypto_hashblocks_sha256(state, &padded, 128);
+    287:     }
+    288: 
+    289:     out[..32].copy_from_slice(&state[..32]);
+    290: }
