+    332: pub fn sha256(out: &mut [u8], data: &[u8], inlen: usize) {
+    333:     let mut state = [0u8; 40];
+    334:     sha256_inc_init(&mut state);
+    335:     sha256_inc_finalize(out, &mut state, data, inlen);
