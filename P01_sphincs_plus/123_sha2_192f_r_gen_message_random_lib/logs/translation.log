+    344: pub fn mgf1_256(out: &mut [u8], outlen: usize, inp: &[u8], inlen: usize) {
+    345:     let mut inbuf = vec![0u8; inlen + 4];
+    346:     inbuf[..inlen].copy_from_slice(&inp[..inlen]);
+    347:     let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];
+    348:     let mut i: usize = 0;
+    349:     let mut off = 0usize;
+    350:     while (i + 1) * SPX_SHA256_OUTPUT_BYTES <= outlen {
+    351:         u32_to_bytes(&mut inbuf[inlen..], i as u32);
+    352:         sha256(&mut out[off..], &inbuf, inlen + 4);
+    353:         off += SPX_SHA256_OUTPUT_BYTES;
+    354:         i += 1;
+    355:     }
+    356:     if outlen > i * SPX_SHA256_OUTPUT_BYTES {
+    357:         u32_to_bytes(&mut inbuf[inlen..], i as u32);
+    358:         sha256(&mut outbuf, &inbuf, inlen + 4);
+    359:         let rem = outlen - i * SPX_SHA256_OUTPUT_BYTES;
+    360:         out[off..off + rem].copy_from_slice(&outbuf[..rem]);
+    361:     }
+    362: }
