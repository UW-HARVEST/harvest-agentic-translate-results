+    292: pub fn sha512_inc_finalize(out: &mut [u8], state: &mut [u8], data: &[u8], inlen: usize) {
+    293:     let mut padded = [0u8; 256];
+    294:     let bytes = load_bigendian_64(&state[64..]) + inlen as u64;
+    295: 
+    296:     crypto_hashblocks_sha512(state, data, inlen);
+    297:     let remaining = inlen & 127;
+    298:     let start = inlen - remaining;
+    299: 
+    300:     padded[..remaining].copy_from_slice(&data[start..start + remaining]);
+    301:     padded[remaining] = 0x80;
+    302: 
+    303:     if remaining < 112 {
+    304:         for i in (remaining + 1)..119 { padded[i] = 0; }
