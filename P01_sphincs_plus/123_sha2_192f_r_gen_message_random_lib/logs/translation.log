+    115: fn crypto_hashblocks_sha256(statebytes: &mut [u8], data: &[u8], mut inlen: usize) -> usize {
+    116:     let mut state = [0u32; 8];
+    117:     for i in 0..8 {
+    118:         state[i] = load_bigendian_32(&statebytes[4 * i..]);
+    119:     }
+    120:     let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut h) =
+    121:         (state[0], state[1], state[2], state[3], state[4], state[5], state[6], state[7]);
+    122: 
+    123:     let mut off = 0usize;
+    124:     while inlen >= 64 {
+    125:         let inp = &data[off..];
+    126:         let mut w = [0u32; 16];
+    127:         for i in 0..16 {
+    128:             w[i] = load_bigendian_32(&inp[4 * i..]);
+    129:         }
+    130: 
+    131:         for round in 0..4 {
+    132:             for i in 0..16 {
+    133:                 let t1 = h.wrapping_add(sigma1_32(e))
+    134:                     .wrapping_add(ch32(e, f, g))
+    135:                     .wrapping_add(K256[round * 16 + i])
+    136:                     .wrapping_add(w[i]);
+    137:                 let t2 = sigma0_32(a).wrapping_add(maj32(a, b, c));
+    138:                 h = g; g = f; f = e;
+    139:                 e = d.wrapping_add(t1);
+    140:                 d = c; c = b; b = a;
+    141:                 a = t1.wrapping_add(t2);
+    142:             }
+    143:             if round < 3 {
+    144:                 // EXPAND
+    145:                 for i in 0..16 {
+    146:                     w[i] = w[i]
+    147:                         .wrapping_add(lsigma1_32(w[(i + 14) % 16]))
+    148:                         .wrapping_add(w[(i + 9) % 16])
+    149:                         .wrapping_add(lsigma0_32(w[(i + 1) % 16]));
+    150:                 }
+    151:             }
+    152:         }
+    153: 
+    154:         a = a.wrapping_add(state[0]); state[0] = a;
+    155:         b = b.wrapping_add(state[1]); state[1] = b;
+    156:         c = c.wrapping_add(state[2]); state[2] = c;
+    157:         d = d.wrapping_add(state[3]); state[3] = d;
+    158:         e = e.wrapping_add(state[4]); state[4] = e;
+    159:         f = f.wrapping_add(state[5]); state[5] = f;
+    160:         g = g.wrapping_add(state[6]); state[6] = g;
+    161:         h = h.wrapping_add(state[7]); state[7] = h;
+    162: 
+    163:         off += 64;
+    164:         inlen -= 64;
+    165:     }
+    166: 
+    167:     for i in 0..8 {
+    168:         store_bigendian_32(&mut statebytes[4 * i..], state[i] as u64);
+    169:     }
+    170:     inlen
+    171: }
