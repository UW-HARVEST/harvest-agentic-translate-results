+     29:     x[6] = u as u8; u >>= 8;
+     30:     x[5] = u as u8; u >>= 8;
+     31:     x[4] = u as u8; u >>= 8;
+     32:     x[3] = u as u8; u >>= 8;
+     33:     x[2] = u as u8; u >>= 8;
+     34:     x[1] = u as u8; u >>= 8;
+     35:     x[0] = u as u8;
+     36: }
