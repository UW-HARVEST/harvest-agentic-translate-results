+    173: fn crypto_hashblocks_sha512(statebytes: &mut [u8], data: &[u8], mut inlen: usize) -> usize {
+    174:     let mut state = [0u64; 8];
+    175:     for i in 0..8 {
+    176:         state[i] = load_bigendian_64(&statebytes[8 * i..]);
+    177:     }
+    178:     let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut h) =
+    179:         (state[0], state[1], state[2], state[3], state[4], state[5], state[6], state[7]);
+    180: 
+    181:     let mut off = 0usize;
+    182:     while inlen >= 128 {
+    183:         let inp = &data[off..];
+    184:         let mut w = [0u64; 16];
+    185:         for i in 0..16 {
+    186:             w[i] = load_bigendian_64(&inp[8 * i..]);
+    187:         }
+    188: 
+    189:         for round in 0..5 {
+    190:             for i in 0..16 {
+    191:                 let t1 = h.wrapping_add(sigma1_64(e))
+    192:                     .wrapping_add(ch64(e, f, g))
+    193:                     .wrapping_add(K512[round * 16 + i])
+    194:                     .wrapping_add(w[i]);
+    195:                 let t2 = sigma0_64(a).wrapping_add(maj64(a, b, c));
+    196:                 h = g; g = f; f = e;
+    197:                 e = d.wrapping_add(t1);
+    198:                 d = c; c = b; b = a;
+    199:                 a = t1.wrapping_add(t2);
+    200:             }
+    201:             if round < 4 {
+    202:                 for i in 0..16 {
+    203:                     w[i] = w[i]
+    204:                         .wrapping_add(lsigma1_64(w[(i + 14) % 16]))
+    205:                         .wrapping_add(w[(i + 9) % 16])
+    206:                         .wrapping_add(lsigma0_64(w[(i + 1) % 16]));
+    207:                 }
+    208:             }
+    209:         }
+    210: 
+    211:         a = a.wrapping_add(state[0]); state[0] = a;
+    212:         b = b.wrapping_add(state[1]); state[1] = b;
+    213:         c = c.wrapping_add(state[2]); state[2] = c;
+    214:         d = d.wrapping_add(state[3]); state[3] = d;
+    215:         e = e.wrapping_add(state[4]); state[4] = e;
+    216:         f = f.wrapping_add(state[5]); state[5] = f;
+    217:         g = g.wrapping_add(state[6]); state[6] = g;
+    218:         h = h.wrapping_add(state[7]); state[7] = h;
+    219: 
+    220:         off += 128;
+    221:         inlen -= 128;
+    222:     }
+    223: 
+    224:     for i in 0..8 {
+    225:         store_bigendian_64(&mut statebytes[8 * i..], state[i]);
+    226:     }
+    227:     inlen
+    228: }
