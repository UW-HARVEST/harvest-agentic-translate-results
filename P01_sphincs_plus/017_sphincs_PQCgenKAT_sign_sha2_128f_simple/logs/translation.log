+    564: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    565:     let mut in_idx = 0usize;
+    566:     let mut out_idx = 0usize;
+    567:     let mut total: u8 = 0;
+    568:     let mut bits: i32 = 0;
+    569:     for _ in 0..out_len {
+    570:         if bits == 0 {
+    571:             total = input[in_idx];
+    572:             in_idx += 1;
+    573:             bits += 8;
+    574:         }
+    575:         bits -= SPX_WOTS_LOGW as i32;
+    576:         output[out_idx] = ((total >> bits) as u32) & (SPX_WOTS_W as u32 - 1);
+    577:         out_idx += 1;
+    578:     }
+    579: }
