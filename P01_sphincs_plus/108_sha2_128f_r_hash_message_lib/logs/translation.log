+    724: fn wots_gen_leafx1(dest: &mut [u8], ctx: &SpxCtx, leaf_idx: u32, info: &mut LeafInfoX1) {
+    725:     let mut pk_buffer = [0u8; SPX_WOTS_BYTES];
+    726: 
+    727:     let wots_k_mask: u32 = if leaf_idx == info.wots_sign_leaf {
+    728:         0
+    729:     } else {
+    730:         !0u32
+    731:     };
+    732: 
+    733:     set_keypair_addr(&mut info.leaf_addr, leaf_idx);
+    734:     set_keypair_addr(&mut info.pk_addr, leaf_idx);
+    735: 
+    736:     for i in 0..SPX_WOTS_LEN {
+    737:         let wots_k = unsafe { *info.wots_steps.add(i) } | wots_k_mask;
+    738:         let buffer = &mut pk_buffer[i * SPX_N..(i + 1) * SPX_N];
+    739: 
+    740:         set_chain_addr(&mut info.leaf_addr, i as u32);
+    741:         set_hash_addr(&mut info.leaf_addr, 0);
