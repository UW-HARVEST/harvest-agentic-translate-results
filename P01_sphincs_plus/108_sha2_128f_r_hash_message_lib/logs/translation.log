+    601: // ============================================================
+    602: // thash (robust, SHA-256 only since SPX_SHA512=0)
+    603: // ============================================================
+    604: fn thash(out: &mut [u8], input: &[u8], inblocks: usize, ctx: &SpxCtx, addr: &mut [u32; 8]) {
+    605:     let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];
+    606:     let mut bitmask = vec![0u8; inblocks * SPX_N];
+    607:     let mut buf = vec![0u8; SPX_N + SPX_SHA256_OUTPUT_BYTES + inblocks * SPX_N];
+    608:     let mut sha2_state = [0u8; 40];
+    609: 
+    610:     buf[..SPX_N].copy_from_slice(&ctx.pub_seed);
+    611:     let addr_bytes = addr_as_bytes(addr);
+    612:     buf[SPX_N..SPX_N + SPX_SHA256_ADDR_BYTES]
+    613:         .copy_from_slice(&addr_bytes[..SPX_SHA256_ADDR_BYTES]);
+    614:     mgf1_256(
+    615:         &mut bitmask,
+    616:         inblocks * SPX_N,
+    617:         &buf,
+    618:         SPX_N + SPX_SHA256_ADDR_BYTES,
+    619:     );
+    620: 
+    621:     sha2_state.copy_from_slice(&ctx.state_seeded);
+    622: 
+    623:     for i in 0..inblocks * SPX_N {
+    624:         buf[SPX_N + SPX_SHA256_ADDR_BYTES + i] = input[i] ^ bitmask[i];
+    625:     }
+    626: 
+    627:     sha256_inc_finalize(
+    628:         &mut outbuf,
+    629:         &mut sha2_state,
+    630:         &buf[SPX_N..],
+    631:         SPX_SHA256_ADDR_BYTES + inblocks * SPX_N,
+    632:     );
+    633:     out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);
+    634: }
