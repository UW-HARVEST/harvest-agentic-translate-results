+    755:                             SPX_N,
+    756:                         );
+    757:                     }
+    758:                 }
+    759:             }
+    760:             if k == (SPX_WOTS_W as u32) - 1 {
+    761:                 break;
+    762:             }
+    763:             set_hash_addr(&mut info.leaf_addr, k);
+    764:             let mut tmp = [0u8; SPX_N];
