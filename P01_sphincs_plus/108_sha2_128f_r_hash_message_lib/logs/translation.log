+    636: // ============================================================
+    637: // WOTS
+    638: // ============================================================
+    639: fn gen_chain(
+    640:     out: &mut [u8],
+    641:     input: &[u8],
+    642:     start: u32,
+    643:     steps: u32,
+    644:     ctx: &SpxCtx,
+    645:     addr: &mut [u32; 8],
+    646: ) {
+    647:     out[..SPX_N].copy_from_slice(&input[..SPX_N]);
+    648:     let mut i = start;
+    649:     while i < start + steps && i < SPX_WOTS_W as u32 {
+    650:         set_hash_addr(addr, i);
+    651:         let mut tmp = [0u8; SPX_N];
+    652:         tmp.copy_from_slice(&out[..SPX_N]);
+    653:         thash(out, &tmp, 1, ctx, addr);
+    654:         i += 1;
+    655:     }
+    656: }
+    657: 
+    658: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    659:     let mut in_idx = 0usize;
+    660:     let mut out_idx = 0usize;
+    661:     let mut total: u8 = 0;
+    662:     let mut bits: i32 = 0;
+    663: 
+    664:     for _ in 0..out_len {
+    665:         if bits == 0 {
+    666:             total = input[in_idx];
+    667:             in_idx += 1;
+    668:             bits += 8;
+    669:         }
+    670:         bits -= SPX_WOTS_LOGW as i32;
+    671:         output[out_idx] = ((total >> bits) & (SPX_WOTS_W as u8 - 1)) as u32;
+    672:         out_idx += 1;
+    673:     }
+    674: }
+    675: 
+    676: fn wots_checksum(csum_base_w: &mut [u32], msg_base_w: &[u32]) {
+    677:     let mut csum: u32 = 0;
+    678:     let csum_bytes_len = (SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8;
+    679:     let mut csum_bytes = [0u8; 4]; // enough for our params
+    680: 
+    681:     for i in 0..SPX_WOTS_LEN1 {
+    682:         csum += (SPX_WOTS_W as u32) - 1 - msg_base_w[i];
+    683:     }
+    684: 
+    685:     csum <<= (8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8;
+    686:     ull_to_bytes(&mut csum_bytes, csum_bytes_len, csum as u64);
+    687:     base_w(csum_base_w, SPX_WOTS_LEN2, &csum_bytes);
+    688: }
+    689: 
+    690: fn chain_lengths(lengths: &mut [u32; SPX_WOTS_LEN], msg: &[u8]) {
+    691:     base_w(&mut lengths[..], SPX_WOTS_LEN1, msg);
+    692:     let (msg_part, csum_part) = lengths.split_at_mut(SPX_WOTS_LEN1);
+    693:     wots_checksum(csum_part, msg_part);
+    694: }
+    695: 
+    696: fn wots_pk_from_sig(pk: &mut [u8], sig: &[u8], msg: &[u8], ctx: &SpxCtx, addr: &mut [u32; 8]) {
+    697:     let mut lengths = [0u32; SPX_WOTS_LEN];
+    698:     chain_lengths(&mut lengths, msg);
+    699: 
+    700:     for i in 0..SPX_WOTS_LEN {
+    701:         set_chain_addr(addr, i as u32);
+    702:         gen_chain(
+    703:             &mut pk[i * SPX_N..],
+    704:             &sig[i * SPX_N..],
+    705:             lengths[i],
+    706:             (SPX_WOTS_W as u32) - 1 - lengths[i],
+    707:             ctx,
+    708:             addr,
+    709:         );
+    710:     }
+    711: }
