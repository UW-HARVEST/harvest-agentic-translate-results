+     918:     leaf: &[u8],
+     919:     mut leaf_idx: u32,
+     920:     mut idx_offset: u32,
+     921:     auth_path: &[u8],
+     922:     tree_height: u32,
+     923:     ctx: &SpxCtx,
+     924:     addr: &mut [u32; 8],
