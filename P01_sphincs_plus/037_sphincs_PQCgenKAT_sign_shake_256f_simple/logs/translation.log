+    196:     t[..mlen].copy_from_slice(&m[off..off + mlen]);
+    197:     t[mlen] = p;
+    198:     t[r - 1] |= 128;
+    199:     for i in 0..(r / 8) {
+    200:         s[i] ^= load64(&t[8 * i..]);
+    201:     }
+    202: }
