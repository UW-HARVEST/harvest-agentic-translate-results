+    746:     let csum_bytes_len = (SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8;
+    747:     let mut csum_bytes = [0u8; 4]; // max needed
+    748:     ull_to_bytes_internal(&mut csum_bytes, csum_bytes_len, csum as u64);
+    749:     base_w(csum_base_w, SPX_WOTS_LEN2, &csum_bytes);
+    750: }
+    751: 
+    752: fn chain_lengths_internal(lengths: &mut [u32; SPX_WOTS_LEN], msg: &[u8]) {
+    753:     base_w(&mut lengths[..SPX_WOTS_LEN1], SPX_WOTS_LEN1, msg);
+    754:     let mut csum = [0u32; SPX_WOTS_LEN2];
+    755:     wots_checksum(&mut csum, &lengths[..SPX_WOTS_LEN1]);
+    756:     lengths[SPX_WOTS_LEN1..SPX_WOTS_LEN].copy_from_slice(&csum);
+    757: }
+    758: 
+    759: fn wots_pk_from_sig_internal(pk: &mut [u8], sig: &[u8], msg: &[u8], ctx: &SpxCtx, addr: &mut [u32; 8]) {
