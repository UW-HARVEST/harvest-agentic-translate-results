+    915:         stack[off..off + SPX_N].copy_from_slice(&current[SPX_N..SPX_N * 2]);
+    916:         idx += 1;
+    917:     }
+    918: }
+    919: 
+    920: fn fors_treehashx1(root: &mut [u8], auth_path: &mut [u8], ctx: &SpxCtx,
+    921:                    leaf_idx: u32, idx_offset: u32, tree_height: u32,
+    922:                    tree_addr: &mut [u32; 8], info: &mut ForsGenLeafInfo) {
+    923:     let mut stack = vec![0u8; tree_height as usize * SPX_N];
+    924:     let max_idx = (1u32 << tree_height) - 1;
+    925:     let mut idx: u32 = 0;
+    926:     loop {
+    927:         let mut current = [0u8; 2 * SPX_N];
+    928:         fors_gen_leafx1(&mut current[SPX_N..], ctx, idx.wrapping_add(idx_offset), info);
+    929: 
+    930:         let mut internal_idx_offset = idx_offset;
+    931:         let mut internal_idx = idx;
+    932:         let mut internal_leaf = leaf_idx;
+    933:         let mut h: u32 = 0;
+    934:         loop {
+    935:             if h == tree_height {
+    936:                 root[..SPX_N].copy_from_slice(&current[SPX_N..SPX_N * 2]);
+    937:                 return;
+    938:             }
+    939:             if (internal_idx ^ internal_leaf) == 0x01 {
+    940:                 auth_path[h as usize * SPX_N..(h as usize + 1) * SPX_N]
+    941:                     .copy_from_slice(&current[SPX_N..SPX_N * 2]);
+    942:             }
+    943:             if (internal_idx & 1) == 0 && idx < max_idx { break; }
+    944: 
+    945:             internal_idx_offset >>= 1;
+    946:             set_tree_height(tree_addr, h + 1);
+    947:             set_tree_index(tree_addr, internal_idx / 2 + internal_idx_offset);
+    948: 
+    949:             let left_off = h as usize * SPX_N;
+    950:             current[..SPX_N].copy_from_slice(&stack[left_off..left_off + SPX_N]);
+    951:             let tmp = current;
+    952:             thash_internal(&mut current[SPX_N..], &tmp, 2, ctx, tree_addr);
+    953: 
+    954:             h += 1;
+    955:             internal_idx >>= 1;
+    956:             internal_leaf >>= 1;
+    957:         }
+    958:         let off = h as usize * SPX_N;
+    959:         stack[off..off + SPX_N].copy_from_slice(&current[SPX_N..SPX_N * 2]);
+    960:         idx += 1;
+    961:     }
+    962: }

