+    460: fn mgf1_256(out: &mut [u8], outlen: usize, inp: &[u8], inlen: usize) {
+    461:     let mut inbuf = vec![0u8; inlen + 4];
+    462:     inbuf[..inlen].copy_from_slice(&inp[..inlen]);
+    463:     let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];
+    464:     let mut i: usize = 0;
