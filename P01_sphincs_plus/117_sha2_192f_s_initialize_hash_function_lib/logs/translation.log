+    715: fn gen_chain(out: &mut [u8], inp: &[u8], start: u32, steps: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {
+    716:     out[..SPX_N].copy_from_slice(&inp[..SPX_N]);
+    717:     for i in start..std::cmp::min(start + steps, SPX_WOTS_W as u32) {
+    718:         set_hash_addr(addr, i);
