+    467:         u32_to_bytes_internal(&mut inbuf[inlen..], i as u32);
+    468:         sha256(&mut out[off..], &inbuf, inlen + 4);
+    469:         off += SPX_SHA256_OUTPUT_BYTES;
+    470:         i += 1;
+    471:     }
