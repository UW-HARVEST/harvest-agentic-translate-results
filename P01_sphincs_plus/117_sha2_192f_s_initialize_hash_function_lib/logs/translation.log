+    1066: fn aes256_ecb(key: &[u8], ctr: &[u8], buffer: &mut [u8]) {
+    1067:     use openssl::symm::{Cipher, Crypter, Mode};
+    1068:     let cipher = Cipher::aes_256_ecb();
+    1069:     let mut c = Crypter::new(cipher, Mode::Encrypt, key, None).unwrap();
+    1070:     c.pad(false);
+    1071:     let mut out = [0u8; 32]; // ECB block + possible padding
+    1072:     let count = c.update(ctr, &mut out).unwrap();
+    1073:     // We only need 16 bytes
+    1074:     buffer[..16].copy_from_slice(&out[..16]);
+    1075:     let _ = count;
+    1076: }
+    1077: 
+    1078: fn aes256_ctr_drbg_update(provided_data: *const u8, key: &mut [u8], v: &mut [u8]) {
+    1079:     let mut temp = [0u8; 48];
+    1080:     for i in 0..3 {
+    1081:         // increment V
+    1082:         for j in (0..=15).rev() {
+    1083:             if v[j] == 0xff {
+    1084:                 v[j] = 0x00;
+    1085:             } else {
+    1086:                 v[j] += 1;
+    1087:                 break;
+    1088:             }
+    1089:         }
+    1090:         aes256_ecb(key, v, &mut temp[16 * i..]);
+    1091:     }
+    1092:     if !provided_data.is_null() {
+    1093:         for i in 0..48 {
+    1094:             temp[i] ^= unsafe { *provided_data.add(i) };
+    1095:         }
+    1096:     }
+    1097:     key[..32].copy_from_slice(&temp[..32]);
+    1098:     v[..16].copy_from_slice(&temp[32..48]);
+    1099: }
