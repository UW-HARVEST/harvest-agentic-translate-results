+    725: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    726:     let mut in_idx = 0usize;
+    727:     let mut bits = 0i32;
+    728:     let mut total = 0u8;
+    729:     for consumed in 0..out_len {
+    730:         if bits == 0 {
+    731:             total = input[in_idx];
+    732:             in_idx += 1;
+    733:             bits += 8;
+    734:         }
+    735:         bits -= SPX_WOTS_LOGW as i32;
+    736:         output[consumed] = ((total >> bits) & (SPX_WOTS_W as u8 - 1)) as u32;
+    737:     }
+    738: }
+    739: 
+    740: fn wots_checksum(csum_base_w: &mut [u32], msg_base_w: &[u32]) {
+    741:     let mut csum: u32 = 0;
+    742:     for i in 0..SPX_WOTS_LEN1 {
+    743:         csum += SPX_WOTS_W as u32 - 1 - msg_base_w[i];
+    744:     }
