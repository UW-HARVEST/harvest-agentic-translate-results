+    738:         if bits == 0 {
+    739:             total = input[inp_idx];
+    740:             inp_idx += 1;
+    741:             bits += 8;
+    742:         }
+    743:         bits -= SPX_WOTS_LOGW as i32;
+    744:         output[out_idx] = ((total >> bits) as u32) & (SPX_WOTS_W as u32 - 1);
+    745:         out_idx += 1;
+    746:     }
+    747: }
