+    486:         g512!(3, 7, 11, 15, 6, 7);
+    487:         g512!(0, 5, 10, 15, 8, 9);
+    488:         g512!(1, 6, 11, 12, 10, 11);
+    489:         g512!(2, 7, 8, 13, 12, 13);
+    490:         g512!(3, 4, 9, 14, 14, 15);
+    491:     }
+    492: 
+    493:     for i in 0..8 { v[i] ^= v[i + 8]; }
+    494:     for i in 0..4 { v[i] ^= st.s[i]; v[i + 4] ^= st.s[i]; }
+    495:     for i in 0..8 { st.h[i] ^= v[i]; }
+    496: }
+    497: 
+    498: fn blake512_init(s: &mut BlakeState512) {
+    499:     s.h = [0x6A09E667F3BCC908, 0xBB67AE8584CAA73B,
+    500:            0x3C6EF372FE94F82B, 0xA54FF53A5F1D36F1,
+    501:            0x510E527FADE682D1, 0x9B05688C2B3E6C1F,
+    502:            0x1F83D9ABFB41BD6B, 0x5BE0CD19137E2179];
+    503:     s.t = [0; 2]; s.buflen = 0; s.nullt = 0; s.s = [0; 4];
+    504:     s.buf = [0; 128];
+    505: }
+    506: 
+    507: fn blake512_update(s: &mut BlakeState512, data: &[u8], datalen: u64) {
+    508:     let mut data = data;
+    509:     let mut datalen = datalen;
+    510:     let mut left = (s.buflen >> 3) as usize;
+    511:     let fill = 128 - left;
+    512: 
+    513:     if left != 0 && ((datalen >> 3) & 0x7F) >= fill as u64 {
+    514:         s.buf[left..left + fill].copy_from_slice(&data[..fill]);
+    515:         s.t[0] = s.t[0].wrapping_add(1024);
+    516:         let buf_copy = s.buf;
+    517:         blake512_compress(s, &buf_copy);
+    518:         data = &data[fill..];
+    519:         datalen -= (fill as u64) << 3;
+    520:         left = 0;
+    521:     }
+    522: 
+    523:     while datalen >= 1024 {
+    524:         s.t[0] = s.t[0].wrapping_add(1024);
+    525:         blake512_compress(s, data);
+    526:         data = &data[128..];
+    527:         datalen -= 1024;
+    528:     }
+    529: 
+    530:     if datalen > 0 {
+    531:         let bytes = ((datalen >> 3) & 0x7F) as usize;
+    532:         s.buf[left..left + bytes].copy_from_slice(&data[..bytes]);
+    533:         s.buflen = ((left << 3) as u64 + datalen) as i32;
+    534:     } else {
+    535:         s.buflen = 0;
+    536:     }
+    537: }
+    538: 
+    539: fn blake512_final(s: &mut BlakeState512, digest: &mut [u8]) {
+    540:     let mut msglen = [0u8; 16];
+    541:     let lo = s.t[0].wrapping_add(s.buflen as u64);
+    542:     let mut hi = s.t[1];
+    543:     if lo < s.buflen as u64 { hi = hi.wrapping_add(1); }
+    544:     u64to8(&mut msglen[0..8], hi);
+    545:     u64to8(&mut msglen[8..16], lo);
+    546: 
+    547:     if s.buflen == 888 {
+    548:         s.t[0] = s.t[0].wrapping_sub(8);
+    549:         let oo: u8 = 0x81;
+    550:         blake512_update(s, &[oo], 8);
+    551:     } else {
+    552:         if s.buflen < 888 {
+    553:             if s.buflen == 0 { s.nullt = 1; }
+    554:             s.t[0] = s.t[0].wrapping_sub((888 - s.buflen) as u64);
+    555:             blake512_update(s, &PADDING512, (888 - s.buflen) as u64);
+    556:         } else {
+    557:             s.t[0] = s.t[0].wrapping_sub((1024 - s.buflen) as u64);
+    558:             blake512_update(s, &PADDING512, (1024 - s.buflen) as u64);
+    559:             s.t[0] = s.t[0].wrapping_sub(888);
+    560:             blake512_update(s, &PADDING512[1..], 888);
+    561:             s.nullt = 1;
+    562:         }
+    563:         let zo: u8 = 0x01;
+    564:         blake512_update(s, &[zo], 8);
+    565:         s.t[0] = s.t[0].wrapping_sub(8);
+    566:     }
+    567:     s.t[0] = s.t[0].wrapping_sub(128);
+    568:     blake512_update(s, &msglen, 128);
+    569: 
+    570:     for i in 0..8 {
+    571:         u64to8(&mut digest[i * 8..], s.h[i]);
+    572:     }
+    573: }
+    574: 
+    575: fn blake512(out: &mut [u8], inp: &[u8], inlen: u64) {
+    576:     let mut s = BlakeState512 {
+    577:         h: [0; 8], s: [0; 4], t: [0; 2], buflen: 0, nullt: 0, buf: [0; 128],
+    578:     };
+    579:     blake512_init(&mut s);
+    580:     blake512_update(&mut s, inp, inlen.wrapping_mul(8));
+    581:     blake512_final(&mut s, out);
+    582: }
+    583: 
+    584: fn blake512_mgf1(out: &mut [u8], outlen: usize, inp: &[u8], inlen: usize) {
+    585:     let mut inbuf = vec![0u8; inlen + 4];
+    586:     inbuf[..inlen].copy_from_slice(&inp[..inlen]);
+    587:     let mut outbuf = [0u8; SPX_BLAKE512_OUTPUT_BYTES];
+    588:     let mut i: usize = 0;
+    589:     let mut off = 0usize;
+    590:     while (i + 1) * SPX_BLAKE512_OUTPUT_BYTES <= outlen {
+    591:         u32_to_bytes_slice(&mut inbuf[inlen..inlen + 4], i as u32);
+    592:         blake512(&mut out[off..], &inbuf, (inlen + 4) as u64);
+    593:         off += SPX_BLAKE512_OUTPUT_BYTES;
+    594:         i += 1;
+    595:     }
+    596:     if outlen > i * SPX_BLAKE512_OUTPUT_BYTES {
+    597:         u32_to_bytes_slice(&mut inbuf[inlen..inlen + 4], i as u32);
+    598:         blake512(&mut outbuf, &inbuf, (inlen + 4) as u64);
+    599:         let rem = outlen - i * SPX_BLAKE512_OUTPUT_BYTES;
+    600:         out[off..off + rem].copy_from_slice(&outbuf[..rem]);
+    601:     }
+    602: }

