+    732: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    733:     let mut inp_idx = 0usize;
+    734:     let mut out_idx = 0usize;
+    735:     let mut total: u8 = 0;
+    736:     let mut bits: i32 = 0;
