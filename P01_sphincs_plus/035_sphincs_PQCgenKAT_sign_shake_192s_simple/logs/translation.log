+    246: fn keccak_inc_absorb(s_inc: &mut [u64; 26], r: usize, m: &[u8]) {
+    247:     let mut off = 0usize;
+    248:     let mut mlen = m.len();
+    249:     while mlen + (s_inc[25] as usize) >= r {
+    250:         let to_absorb = r - s_inc[25] as usize;
+    251:         for i in 0..to_absorb {
+    252:             let pos = s_inc[25] as usize + i;
+    253:             s_inc[pos >> 3] ^= (m[off + i] as u64) << (8 * (pos & 0x07));
+    254:         }
+    255:         mlen -= to_absorb;
+    256:         off += to_absorb;
+    257:         s_inc[25] = 0;
+    258:         let state: &mut [u64; 25] = (&mut s_inc[..25]).try_into().unwrap();
+    259:         keccak_f1600(state);
+    260:     }
+    261:     for i in 0..mlen {
+    262:         let pos = s_inc[25] as usize + i;
+    263:         s_inc[pos >> 3] ^= (m[off + i] as u64) << (8 * (pos & 0x07));
+    264:     }
+    265:     s_inc[25] += mlen as u64;
+    266: }
+    267: 
+    268: fn keccak_inc_finalize(s_inc: &mut [u64; 26], r: usize, p: u8) {
+    269:     let pos = s_inc[25] as usize;
+    270:     s_inc[pos >> 3] ^= (p as u64) << (8 * (pos & 0x07));
+    271:     s_inc[(r - 1) >> 3] ^= 128u64 << (8 * ((r - 1) & 0x07));
+    272:     s_inc[25] = 0;
+    273: }
