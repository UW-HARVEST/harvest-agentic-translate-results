+    277:     let mut hoff = 0usize;
+    278: 
+    279:     // First consume leftover bytes
+    280:     let mut i = 0usize;
+    281:     while i < outlen && i < s_inc[25] as usize {
+    282:         let pos = r - s_inc[25] as usize + i;
+    283:         h[hoff + i] = (s_inc[pos >> 3] >> (8 * (pos & 0x07))) as u8;
+    284:         i += 1;
+    285:     }
+    286:     hoff += i;
+    287:     outlen -= i;
+    288:     s_inc[25] -= i as u64;
+    289: 
+    290:     while outlen > 0 {
+    291:         let state: &mut [u64; 25] = (&mut s_inc[..25]).try_into().unwrap();
+    292:         keccak_f1600(state);
+    293:         i = 0;
+    294:         while i < outlen && i < r {
+    295:             h[hoff + i] = (s_inc[i >> 3] >> (8 * (i & 0x07))) as u8;
+    296:             i += 1;
+    297:         }
+    298:         hoff += i;
+    299:         outlen -= i;
+    300:         s_inc[25] = (r - i) as u64;
+    301:     }
+    302: }

