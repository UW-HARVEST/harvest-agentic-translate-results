+    250: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    251:     let mut inp = 0usize;
+    252:     let mut bits = 0i32;
+    253:     let mut total = 0u8;
+    254:     for o in 0..out_len {
+    255:         if bits == 0 {
+    256:             total = input[inp];
+    257:             inp += 1;
+    258:             bits += 8;
+    259:         }
+    260:         bits -= SPX_WOTS_LOGW as i32;
+    261:         output[o] = ((total >> bits) & (SPX_WOTS_W as u8 - 1)) as u32;
+    262:     }
+    263: }
+    264: 
+    265: fn wots_checksum(csum_base_w: &mut [u32], msg_base_w: &[u32]) {
+    266:     let mut csum = 0u32;
+    267:     for i in 0..SPX_WOTS_LEN1 {
+    268:         csum += SPX_WOTS_W as u32 - 1 - msg_base_w[i];
+    269:     }
+    270:     csum <<= (8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8;
+    271:     let csum_bytes_len = (SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8;
+    272:     let mut csum_bytes = [0u8; 4]; // max needed
+    273:     ull_to_bytes(&mut csum_bytes, csum_bytes_len, csum as u64);
+    274:     base_w(csum_base_w, SPX_WOTS_LEN2, &csum_bytes);
+    275: }
+    276: 
+    277: pub fn chain_lengths(lengths: &mut [u32; SPX_WOTS_LEN], msg: &[u8]) {
+    278:     base_w(&mut lengths[..SPX_WOTS_LEN1], SPX_WOTS_LEN1, msg);
+    279:     let mut csum = [0u32; SPX_WOTS_LEN2];
+    280:     wots_checksum(&mut csum, &lengths[..SPX_WOTS_LEN1]);
+    281:     lengths[SPX_WOTS_LEN1..].copy_from_slice(&csum);
+    282: }
