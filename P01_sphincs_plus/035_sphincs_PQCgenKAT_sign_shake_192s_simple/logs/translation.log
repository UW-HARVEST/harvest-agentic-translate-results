+    242: fn gen_chain(out: &mut [u8], inp: &[u8], start: u32, steps: u32, ctx: &SpxCtx, addr: &mut Addr) {
+    243:     out[..SPX_N].copy_from_slice(&inp[..SPX_N]);
+    244:     for i in start..std::cmp::min(start + steps, SPX_WOTS_W as u32) {
+    245:         set_hash_addr(addr, i);
+    246:         thash(out, &out.to_vec(), 1, ctx, addr);
+    247:     }
+    248: }
