+    571: fn blake512_final(s: &mut BlakeState512, digest: &mut [u8]) {
+    572:     let zo: u8 = 0x01;
+    573:     let oo: u8 = 0x81;
+    574:     let lo = s.t[0].wrapping_add(s.buflen as u64);
+    575:     let mut hi = s.t[1];
+    576:     if lo < s.buflen as u64 { hi = hi.wrapping_add(1); }
+    577:     let mut msglen = [0u8; 16];
+    578:     u64to8(&mut msglen[0..], hi);
+    579:     u64to8(&mut msglen[8..], lo);
+    580: 
+    581:     if s.buflen == 888 {
+    582:         s.t[0] = s.t[0].wrapping_sub(8);
+    583:         blake512_update(s, &[oo], 8);
+    584:     } else {
+    585:         if s.buflen < 888 {
+    586:             if s.buflen == 0 { s.nullt = 1; }
+    587:             s.t[0] = s.t[0].wrapping_sub((888 - s.buflen) as u64);
+    588:             blake512_update(s, &PADDING512[..(888 - s.buflen) as usize / 8], (888 - s.buflen) as u64);
+    589:         } else {
+    590:             s.t[0] = s.t[0].wrapping_sub((1024 - s.buflen) as u64);
+    591:             blake512_update(s, &PADDING512[..(1024 - s.buflen) as usize / 8], (1024 - s.buflen) as u64);
+    592:             s.t[0] = s.t[0].wrapping_sub(888);
+    593:             blake512_update(s, &PADDING512[1..1 + 888 / 8], 888);
+    594:             s.nullt = 1;
+    595:         }
+    596:         blake512_update(s, &[zo], 8);
+    597:         s.t[0] = s.t[0].wrapping_sub(8);
+    598:     }
+    599:     s.t[0] = s.t[0].wrapping_sub(128);
+    600:     blake512_update(s, &msglen, 128);
+    601: 
+    602:     u64to8(&mut digest[0..], s.h[0]); u64to8(&mut digest[8..], s.h[1]);
+    603:     u64to8(&mut digest[16..], s.h[2]); u64to8(&mut digest[24..], s.h[3]);
+    604:     u64to8(&mut digest[32..], s.h[4]); u64to8(&mut digest[40..], s.h[5]);
+    605:     u64to8(&mut digest[48..], s.h[6]); u64to8(&mut digest[56..], s.h[7]);
+    606: }
+    607: 
+    608: fn blake512_hash(out: &mut [u8], inp: &[u8], inlen: u64) {
+    609:     let mut s = BlakeState512 { h: [0;8], s: [0;4], t: [0;2], buflen: 0, nullt: 0, buf: [0;128] };
+    610:     blake512_init(&mut s);
+    611:     blake512_update(&mut s, inp, inlen.wrapping_mul(8));
+    612:     blake512_final(&mut s, out);
+    613: }
+    614: 
+    615: fn blake512_mgf1(out: &mut [u8], outlen: usize, inp: &[u8], inlen: usize) {
+    616:     let mut inbuf = vec![0u8; inlen + 4];
+    617:     inbuf[..inlen].copy_from_slice(&inp[..inlen]);
+    618:     let mut outbuf = [0u8; SPX_BLAKE512_OUTPUT_BYTES];
+    619:     let mut i: usize = 0;
+    620:     let mut off = 0usize;
+    621: 
+    622:     while (i + 1) * SPX_BLAKE512_OUTPUT_BYTES <= outlen {
+    623:         u32_to_bytes(&mut inbuf[inlen..], i as u32);
+    624:         blake512_hash(&mut out[off..], &inbuf, (inlen + 4) as u64);
+    625:         off += SPX_BLAKE512_OUTPUT_BYTES;
+    626:         i += 1;
+    627:     }
+    628:     if outlen > i * SPX_BLAKE512_OUTPUT_BYTES {
+    629:         u32_to_bytes(&mut inbuf[inlen..], i as u32);
+    630:         blake512_hash(&mut outbuf, &inbuf, (inlen + 4) as u64);
+    631:         let rem = outlen - i * SPX_BLAKE512_OUTPUT_BYTES;
+    632:         out[off..off + rem].copy_from_slice(&outbuf[..rem]);
+    633:     }
+    634: }

