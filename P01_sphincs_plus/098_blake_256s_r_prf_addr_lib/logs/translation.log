+    744: fn gen_chain(out: &mut [u8], inp: &[u8], start: u32, steps: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {
+    745:     out[..SPX_N].copy_from_slice(&inp[..SPX_N]);
