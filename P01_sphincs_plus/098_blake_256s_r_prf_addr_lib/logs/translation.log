+    700: fn thash_512(out: &mut [u8], inp: &[u8], inblocks: usize, ctx: &SpxCtx, addr: &mut [u32; 8]) {
+    701:     let mut outbuf = [0u8; SPX_BLAKE512_OUTPUT_BYTES];
+    702:     let mut bitmask = vec![0u8; inblocks * SPX_N];
+    703:     let mut buf = vec![0u8; SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N];
+    704: 
+    705:     buf[..SPX_N].copy_from_slice(&ctx.pub_seed);
+    706:     buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(addr_bytes(addr));
+    707: 
+    708:     blake512_mgf1(&mut bitmask, inblocks * SPX_N, &buf, SPX_N + SPX_ADDR_BYTES);
+    709: 
+    710:     for i in 0..inblocks * SPX_N {
+    711:         buf[SPX_N + SPX_ADDR_BYTES + i] = inp[i] ^ bitmask[i];
+    712:     }
+    713: 
+    714:     blake512_hash(&mut outbuf, &buf[SPX_N..], (SPX_ADDR_BYTES + inblocks * SPX_N) as u64);
+    715:     out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);
+    716: }
