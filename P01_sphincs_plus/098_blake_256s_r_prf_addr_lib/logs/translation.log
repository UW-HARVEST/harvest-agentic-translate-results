+    539: 
+    540: fn blake512_update(s: &mut BlakeState512, data: &[u8], mut datalen: u64) {
+    541:     let mut offset = 0usize;
+    542:     let mut left = (s.buflen >> 3) as usize;
+    543:     let fill = 128 - left;
+    544: 
+    545:     if left != 0 && ((datalen >> 3) & 0x7F) >= fill as u64 {
+    546:         s.buf[left..left + fill].copy_from_slice(&data[offset..offset + fill]);
+    547:         s.t[0] = s.t[0].wrapping_add(1024);
+    548:         let buf_copy = s.buf;
+    549:         blake512_compress(s, &buf_copy);
+    550:         offset += fill;
+    551:         datalen -= (fill as u64) << 3;
+    552:         left = 0;
+    553:     }
+    554: 
+    555:     while datalen >= 1024 {
+    556:         s.t[0] = s.t[0].wrapping_add(1024);
+    557:         blake512_compress(s, &data[offset..]);
+    558:         offset += 128;
+    559:         datalen -= 1024;
+    560:     }
+    561: 
+    562:     if datalen > 0 {
+    563:         let bytes = ((datalen >> 3) & 0x7F) as usize;
+    564:         s.buf[left..left + bytes].copy_from_slice(&data[offset..offset + bytes]);
+    565:         s.buflen = ((left << 3) as u64 + datalen) as i32;
+    566:     } else {
+    567:         s.buflen = 0;
+    568:     }
+    569: }
