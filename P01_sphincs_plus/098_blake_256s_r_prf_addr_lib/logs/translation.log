+    755: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    756:     let mut in_idx = 0usize;
+    757:     let mut out_idx = 0usize;
+    758:     let mut total: u8 = 0;
+    759:     let mut bits: i32 = 0;
+    760: 
+    761:     for _ in 0..out_len {
+    762:         if bits == 0 {
+    763:             total = input[in_idx];
+    764:             in_idx += 1;
+    765:             bits += 8;
+    766:         }
+    767:         bits -= SPX_WOTS_LOGW as i32;
+    768:         output[out_idx] = ((total >> bits) & (SPX_WOTS_W as u8 - 1)) as u32;
+    769:         out_idx += 1;
+    770:     }
+    771: }
