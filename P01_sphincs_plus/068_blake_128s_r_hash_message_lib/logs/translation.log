+    316: pub fn blake256_final(s: &mut Blakestate256, digest: &mut [u8]) {
+    317:     let mut msglen = [0u8; 8];
+    318:     let zo: u8 = 0x01;
+    319:     let oo: u8 = 0x81;
+    320:     let lo = s.t[0].wrapping_add(s.buflen as u32);
+    321:     let mut hi = s.t[1];
+    322:     if lo < s.buflen as u32 {
+    323:         hi = hi.wrapping_add(1);
+    324:     }
+    325:     u32to8(&mut msglen[0..4], hi);
+    326:     u32to8(&mut msglen[4..8], lo);
+    327: 
+    328:     if s.buflen == 440 {
+    329:         s.t[0] = s.t[0].wrapping_sub(8);
+    330:         blake256_update(s, &[oo], 8);
+    331:     } else {
+    332:         if s.buflen < 440 {
+    333:             if s.buflen == 0 {
+    334:                 s.nullt = 1;
+    335:             }
+    336:             s.t[0] = s.t[0].wrapping_sub((440 - s.buflen) as u32);
+    337:             blake256_update(s, &PADDING[..(((440 - s.buflen) >> 3) as usize).max(1)], (440 - s.buflen) as u64);
+    338:         } else {
+    339:             s.t[0] = s.t[0].wrapping_sub((512 - s.buflen) as u32);
+    340:             blake256_update(s, &PADDING[..((512 - s.buflen) >> 3) as usize], (512 - s.buflen) as u64);
+    341:             s.t[0] = s.t[0].wrapping_sub(440);
+    342:             blake256_update(s, &PADDING[1..1 + (440 >> 3)], 440);
+    343:             s.nullt = 1;
+    344:         }
+    345:         blake256_update(s, &[zo], 8);
+    346:         s.t[0] = s.t[0].wrapping_sub(8);
+    347:     }
+    348:     s.t[0] = s.t[0].wrapping_sub(64);
+    349:     blake256_update(s, &msglen, 64);
+    350: 
+    351:     u32to8(&mut digest[0..4], s.h[0]);
+    352:     u32to8(&mut digest[4..8], s.h[1]);
+    353:     u32to8(&mut digest[8..12], s.h[2]);
+    354:     u32to8(&mut digest[12..16], s.h[3]);
+    355:     u32to8(&mut digest[16..20], s.h[4]);
+    356:     u32to8(&mut digest[20..24], s.h[5]);
+    357:     u32to8(&mut digest[24..28], s.h[6]);
+    358:     u32to8(&mut digest[28..32], s.h[7]);
+    359: }
