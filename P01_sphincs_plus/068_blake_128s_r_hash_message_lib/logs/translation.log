+    279: pub fn blake256_update(s: &mut Blakestate256, data: &[u8], mut datalen: u64) {
+    280:     let mut data_off = 0usize;
+    281:     let mut left = (s.buflen >> 3) as usize;
+    282:     let fill = 64 - left;
+    283: 
+    284:     if left != 0 && ((datalen >> 3) & 0x3F) >= fill as u64 {
+    285:         s.buf[left..left + fill].copy_from_slice(&data[data_off..data_off + fill]);
+    286:         s.t[0] = s.t[0].wrapping_add(512);
+    287:         if s.t[0] == 0 {
+    288:             s.t[1] = s.t[1].wrapping_add(1);
+    289:         }
+    290:         let buf_copy = s.buf;
+    291:         blake256_compress(s, &buf_copy);
+    292:         data_off += fill;
+    293:         datalen -= (fill as u64) << 3;
+    294:         left = 0;
+    295:     }
+    296: 
+    297:     while datalen >= 512 {
+    298:         s.t[0] = s.t[0].wrapping_add(512);
+    299:         if s.t[0] == 0 {
+    300:             s.t[1] = s.t[1].wrapping_add(1);
+    301:         }
+    302:         blake256_compress(s, &data[data_off..]);
+    303:         data_off += 64;
+    304:         datalen -= 512;
+    305:     }
+    306: 
+    307:     if datalen > 0 {
+    308:         let bytes = (datalen >> 3) as usize;
+    309:         s.buf[left..left + bytes].copy_from_slice(&data[data_off..data_off + bytes]);
+    310:         s.buflen = ((left << 3) as u64 + datalen) as i32;
+    311:     } else {
+    312:         s.buflen = 0;
+    313:     }
+    314: }
