+    283: pub fn blake256_update(s: &mut Blakestate256, data: &[u8], mut datalen: u64) {
+    284:     let mut data_off = 0usize;
+    285:     let mut left = (s.buflen >> 3) as usize;
+    286:     let fill = 64 - left;
+    287: 
+    288:     if left != 0 && ((datalen >> 3) & 0x3F) >= fill as u64 {
+    289:         s.buf[left..left + fill].copy_from_slice(&data[data_off..data_off + fill]);
+    290:         s.t[0] = s.t[0].wrapping_add(512);
+    291:         if s.t[0] == 0 {
+    292:             s.t[1] = s.t[1].wrapping_add(1);
+    293:         }
+    294:         blake256_compress(s, &s.buf.clone());
+    295:         data_off += fill;
+    296:         datalen -= (fill as u64) << 3;
+    297:         left = 0;
+    298:     }
+    299: 
+    300:     while datalen >= 512 {
+    301:         s.t[0] = s.t[0].wrapping_add(512);
+    302:         if s.t[0] == 0 {
+    303:             s.t[1] = s.t[1].wrapping_add(1);
+    304:         }
+    305:         blake256_compress(s, &data[data_off..]);
+    306:         data_off += 64;
+    307:         datalen -= 512;
+    308:     }
+    309: 
+    310:     if datalen > 0 {
+    311:         let bytes = (datalen >> 3) as usize;
+    312:         s.buf[left..left + bytes].copy_from_slice(&data[data_off..data_off + bytes]);
+    313:         s.buflen = ((left << 3) as u64 + datalen) as i32;
+    314:     } else {
+    315:         s.buflen = 0;
+    316:     }
+    317: }
