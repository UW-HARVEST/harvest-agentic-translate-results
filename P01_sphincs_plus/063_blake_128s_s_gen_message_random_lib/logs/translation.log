+    324:     let mut hi = s.t[1];
+    325:     if lo < s.buflen as u32 {
+    326:         hi = hi.wrapping_add(1);
+    327:     }
+    328:     u32to8(&mut msglen[0..4], hi);
+    329:     u32to8(&mut msglen[4..8], lo);
