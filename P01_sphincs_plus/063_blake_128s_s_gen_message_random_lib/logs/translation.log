+    340:             blake256_update(s, &PADDING, (440 - s.buflen) as u64);
+    341:         } else {
+    342:             s.t[0] = s.t[0].wrapping_sub((512 - s.buflen) as u32);
+    343:             blake256_update(s, &PADDING, (512 - s.buflen) as u64);
+    344:             s.t[0] = s.t[0].wrapping_sub(440);
+    345:             blake256_update(s, &PADDING[1..], 440);
+    346:             s.nullt = 1;
+    347:         }
+    348:         blake256_update(s, &[zo], 8);
+    349:         s.t[0] = s.t[0].wrapping_sub(8);
+    350:     }
