+     89:         (state[0], state[1], state[2], state[3], state[4], state[5], state[6], state[7]);
+     90: 
+     91:     let mut pos = 0usize;
+     92:     while inlen >= 64 {
+     93:         let mut w = [0u32; 16];
+     94:         for i in 0..16 {
