pub fn mgf1_512_rs(out: &mut [u8], inp: &[u8]) {
    let outlen = out.len();
    let inlen = inp.len();
    let mut inbuf = vec![0u8; inlen + 4];
    inbuf[..inlen].copy_from_slice(inp);
    let mut i = 0u64;
