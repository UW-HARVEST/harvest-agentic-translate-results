use crate::sha2::*;
use crate::utils::{u32_to_bytes, bytes_to_ull_rs};

#[repr(C)]
pub struct SpxCtx {
    pub pub_seed: [u8; SPX_N],
    pub sk_seed: [u8; SPX_N],
    pub state_seeded: [u8; 40],
}

#[unsafe(no_mangle)]
