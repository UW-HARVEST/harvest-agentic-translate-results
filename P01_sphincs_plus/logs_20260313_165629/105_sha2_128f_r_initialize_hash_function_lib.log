        u32_to_bytes(&mut inbuf[inlen..], i as u32);
        let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];
        sha256_rs(&mut outbuf, &inbuf);
        let rem = outlen - (i as usize) * SPX_SHA256_OUTPUT_BYTES;
        out[pos..pos + rem].copy_from_slice(&outbuf[..rem]);
    }
}

#[unsafe(no_mangle)]
pub extern "C" fn SPX_mgf1_512(out: *mut u8, outlen: u64, inp: *const u8, inlen: u64) {
    let out = unsafe { std::slice::from_raw_parts_mut(out, outlen as usize) };
    let inp = unsafe { std::slice::from_raw_parts(inp, inlen as usize) };
