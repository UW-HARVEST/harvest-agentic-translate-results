        sha512_rs(&mut out[pos..pos + SPX_SHA512_OUTPUT_BYTES], &inbuf);
        pos += SPX_SHA512_OUTPUT_BYTES;
        i += 1;
    }
    if outlen > (i as usize) * SPX_SHA512_OUTPUT_BYTES {
        u32_to_bytes(&mut inbuf[inlen..], i as u32);
        let mut outbuf = [0u8; SPX_SHA512_OUTPUT_BYTES];
        sha512_rs(&mut outbuf, &inbuf);
        let rem = outlen - (i as usize) * SPX_SHA512_OUTPUT_BYTES;
        out[pos..pos + rem].copy_from_slice(&outbuf[..rem]);
    }
}

