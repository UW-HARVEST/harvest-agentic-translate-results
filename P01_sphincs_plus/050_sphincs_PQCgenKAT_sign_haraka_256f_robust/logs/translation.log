        moff += avail;
        s_inc[64] = 0;

        let mut tmp = [0u8; 64];
        let mut s64 = [0u8; 64];
        s64.copy_from_slice(&s_inc[..64]);
        haraka512_perm(&mut tmp, &s64, ctx);
        s_inc[..64].copy_from_slice(&tmp);
    }

    for i in 0..mlen {
        s_inc[s_inc[64] as usize + i] ^= m[moff + i];
    }
    s_inc[64] = s_inc[64].wrapping_add(mlen as u8);
}

pub fn haraka_s_inc_finalize(s_inc: &mut [u8; 65]) {
    s_inc[s_inc[64] as usize] ^= 0x1F;
    s_inc[HARAKAS_RATE - 1] ^= 128;
    s_inc[64] = 0;
}

pub fn haraka_s_inc_squeeze(out: &mut [u8], s_inc: &mut [u8; 65], ctx: &SpxCtx) {
    let mut outlen = out.len();
    let mut out_off = 0usize;

    // First consume leftover bytes
    let mut i = 0usize;
    while i < outlen && i < s_inc[64] as usize {
        out[out_off] = s_inc[HARAKAS_RATE - s_inc[64] as usize + i];
        out_off += 1;
        i += 1;
    }
    outlen -= i;
    s_inc[64] = s_inc[64].wrapping_sub(i as u8);

    while outlen > 0 {
        let mut tmp = [0u8; 64];
        let mut s64 = [0u8; 64];
        s64.copy_from_slice(&s_inc[..64]);
        haraka512_perm(&mut tmp, &s64, ctx);
        s_inc[..64].copy_from_slice(&tmp);

        let mut j = 0usize;
        while j < outlen && j < HARAKAS_RATE {
            out[out_off] = s_inc[j];
            out_off += 1;
            j += 1;
        }
        outlen -= j;
        s_inc[64] = (HARAKAS_RATE - j) as u8;
    }
}
