            internal_leaf >>= 1;
        }

        // Save current to stack - find h from the loop
        let mut h = 0u32;
        { let mut ti = idx; while ti & 1 != 0 || idx >= max_idx { ti >>= 1; h += 1; if h >= tree_height { break; } } }
        // Actually we need to figure out h properly. Let me redo this.
        // The C code breaks out of the for(h) loop, so h is the value at break.
        // Let's recompute: h is the number of trailing 1-bits of idx (unless idx==max_idx)
        let save_h = {
            let mut ti = idx;
            let mut hh = 0u32;
            loop {
                if hh == tree_height { break; }
                if (ti & 1) == 0 && idx < max_idx { break; }
