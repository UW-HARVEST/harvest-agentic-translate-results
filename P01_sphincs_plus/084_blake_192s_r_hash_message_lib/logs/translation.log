+    797: fn thash(out: &mut [u8], inp: &[u8], inblocks: usize, ctx: &SpxCtx, addr: &mut [u32; 8]) {
+    798:     if inblocks > 1 {
+    799:         thash_512(out, inp, inblocks, ctx, addr);
+    800:         return;
+    801:     }
+    802:     let mut outbuf = [0u8; SPX_BLAKE256_OUTPUT_BYTES];
+    803:     let mut bitmask = vec![0u8; inblocks * SPX_N];
+    804:     let buf_len = SPX_N + SPX_ADDR_BYTES + inblocks * SPX_N;
+    805:     let mut buf = vec![0u8; buf_len];
+    806: 
+    807:     buf[..SPX_N].copy_from_slice(&ctx.pub_seed);
+    808:     buf[SPX_N..SPX_N + SPX_ADDR_BYTES].copy_from_slice(addr_as_bytes(addr));
+    809:     blake256_mgf1(&mut bitmask, inblocks * SPX_N, &buf, SPX_N + SPX_ADDR_BYTES);
+    810: 
