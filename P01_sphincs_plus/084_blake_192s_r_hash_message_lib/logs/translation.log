+    641:         state.buf[left..left + fill].copy_from_slice(&data[offset..offset + fill]);
+    642:         state.t[0] = state.t[0].wrapping_add(1024);
+    643:         let buf_copy = state.buf;
+    644:         blake512_compress(state, &buf_copy);
+    645:         offset += fill;
+    646:         datalen -= (fill as u64) << 3;
+    647:         left = 0;
+    648:     }
+    649: 
+    650:     while datalen >= 1024 {
+    651:         state.t[0] = state.t[0].wrapping_add(1024);
+    652:         blake512_compress(state, &data[offset..]);
+    653:         offset += 128;
+    654:         datalen -= 1024;
+    655:     }
