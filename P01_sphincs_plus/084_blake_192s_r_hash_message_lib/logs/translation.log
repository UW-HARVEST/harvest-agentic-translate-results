+    1327:         (*ctx).ctr[10] = (ml % 256) as u8; ml >>= 8;
+    1328:         (*ctx).ctr[9] = (ml % 256) as u8; ml >>= 8;
+    1329:         (*ctx).ctr[8] = (ml % 256) as u8;
+    1330:         (*ctx).ctr[12..16].fill(0);
+    1331:         (*ctx).buffer_pos = 16;
+    1332:         (*ctx).buffer.fill(0);
