+    869: fn wots_checksum(csum_base_w: &mut [u32], msg_base_w: &[u32]) {
+    870:     let mut csum: u32 = 0;
+    871:     let csum_bytes_len = (SPX_WOTS_LEN2 * SPX_WOTS_LOGW + 7) / 8;
+    872:     let mut csum_bytes = vec![0u8; csum_bytes_len];
+    873:     for i in 0..SPX_WOTS_LEN1 {
+    874:         csum += (SPX_WOTS_W as u32) - 1 - msg_base_w[i];
+    875:     }
+    876:     csum <<= (8 - ((SPX_WOTS_LEN2 * SPX_WOTS_LOGW) % 8)) % 8;
+    877:     ull_to_bytes(&mut csum_bytes, csum_bytes_len, csum as u64);
+    878:     base_w(csum_base_w, SPX_WOTS_LEN2, &csum_bytes);
+    879: }
+    880: 
+    881: fn chain_lengths(lengths: &mut [u32; SPX_WOTS_LEN], msg: &[u8]) {
+    882:     base_w(&mut lengths[..SPX_WOTS_LEN1], SPX_WOTS_LEN1, msg);
+    883:     let (left, right) = lengths.split_at_mut(SPX_WOTS_LEN1);
+    884:     wots_checksum(right, left);
+    885: }
+    886: 
+    887: fn wots_pk_from_sig(pk: &mut [u8], sig: &[u8], msg: &[u8], ctx: &SpxCtx, addr: &mut [u32; 8]) {
