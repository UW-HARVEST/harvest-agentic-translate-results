+    840: fn gen_chain(out: &mut [u8], inp: &[u8], start: u32, steps: u32, ctx: &SpxCtx, addr: &mut [u32; 8]) {
+    841:     out[..SPX_N].copy_from_slice(&inp[..SPX_N]);
+    842:     let mut i = start;
+    843:     while i < start + steps && i < SPX_WOTS_W as u32 {
+    844:         set_hash_addr(addr, i);
+    845:         let mut tmp = [0u8; SPX_N];
+    846:         tmp.copy_from_slice(&out[..SPX_N]);
+    847:         thash(out, &tmp, 1, ctx, addr);
+    848:         i += 1;
+    849:     }
+    850: }
+    851: 
+    852: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    853:     let mut in_idx = 0usize;
+    854:     let mut out_idx = 0usize;
+    855:     let mut total: u8 = 0;
+    856:     let mut bits: i32 = 0;
+    857:     for _ in 0..out_len {
+    858:         if bits == 0 {
+    859:             total = input[in_idx];
+    860:             in_idx += 1;
+    861:             bits += 8;
+    862:         }
+    863:         bits -= SPX_WOTS_LOGW as i32;
+    864:         output[out_idx] = ((total >> bits) & (SPX_WOTS_W as u8 - 1)) as u32;
+    865:         out_idx += 1;
+    866:     }
+    867: }
