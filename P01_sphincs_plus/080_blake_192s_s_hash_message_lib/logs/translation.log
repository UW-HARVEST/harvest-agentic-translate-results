+    384: pub fn blake256_mgf1(out: &mut [u8], outlen: usize, inp: &[u8], inlen: usize) {
+    385:     let mut inbuf = vec![0u8; inlen + 4];
+    386:     let mut outbuf = [0u8; SPX_BLAKE256_OUTPUT_BYTES];
+    387: 
+    388:     inbuf[..inlen].copy_from_slice(&inp[..inlen]);
+    389: 
+    390:     let mut i: usize = 0;
+    391:     let mut out_off = 0usize;
+    392:     while (i + 1) * SPX_BLAKE256_OUTPUT_BYTES <= outlen {
+    393:         u32_to_bytes(&mut inbuf[inlen..inlen + 4], i as u32);
+    394:         blake256(&mut out[out_off..], &inbuf, (inlen + 4) as u64);
+    395:         out_off += SPX_BLAKE256_OUTPUT_BYTES;
+    396:         i += 1;
