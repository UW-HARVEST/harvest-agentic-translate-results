+    377: pub fn blake256(out: &mut [u8], inp: &[u8], inlen: u64) -> i32 {
+    378:     let mut s = Blake256State::new();
+    379:     blake256_update(&mut s, inp, inlen.wrapping_mul(8));
+    380:     blake256_final(&mut s, out);
+    381:     0
+    382: }
