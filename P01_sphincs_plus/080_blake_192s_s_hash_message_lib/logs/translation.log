+    295: pub fn blake256_update(s: &mut Blake256State, data: &[u8], mut datalen: u64) {
+    296:     let mut data_off = 0usize;
+    297:     let mut left = (s.buflen >> 3) as usize;
+    298:     let fill = 64 - left;
+    299: 
+    300:     if left != 0 && ((datalen >> 3) & 0x3F) as usize >= fill {
+    301:         s.buf[left..left + fill].copy_from_slice(&data[data_off..data_off + fill]);
+    302:         s.t[0] = s.t[0].wrapping_add(512);
+    303:         if s.t[0] == 0 {
+    304:             s.t[1] = s.t[1].wrapping_add(1);
+    305:         }
+    306:         let buf_copy = s.buf;
+    307:         blake256_compress(s, &buf_copy);
+    308:         data_off += fill;
+    309:         datalen -= (fill as u64) << 3;
+    310:         left = 0;
+    311:     }
+    312: 
+    313:     while datalen >= 512 {
+    314:         s.t[0] = s.t[0].wrapping_add(512);
+    315:         if s.t[0] == 0 {
+    316:             s.t[1] = s.t[1].wrapping_add(1);
+    317:         }
+    318:         blake256_compress(s, &data[data_off..]);
+    319:         data_off += 64;
+    320:         datalen -= 512;
+    321:     }
+    322: 
+    323:     if datalen > 0 {
+    324:         let bytes = (datalen >> 3) as usize;
+    325:         s.buf[left..left + bytes].copy_from_slice(&data[data_off..data_off + bytes]);
+    326:         s.buflen = ((left << 3) as u64 + datalen) as i32;
+    327:     } else {
+    328:         s.buflen = 0;
+    329:     }
+    330: }
+    331: 
+    332: pub fn blake256_final(s: &mut Blake256State, digest: &mut [u8]) {
+    333:     let mut msglen = [0u8; 8];
+    334:     let zo: u8 = 0x01;
+    335:     let oo: u8 = 0x81;
+    336:     let lo = s.t[0].wrapping_add(s.buflen as u32);
+    337:     let mut hi = s.t[1];
+    338:     if lo < s.buflen as u32 {
+    339:         hi = hi.wrapping_add(1);
+    340:     }
+    341:     u32to8(&mut msglen[0..4], hi);
+    342:     u32to8(&mut msglen[4..8], lo);
+    343: 
+    344:     if s.buflen == 440 {
+    345:         s.t[0] = s.t[0].wrapping_sub(8);
+    346:         blake256_update(s, &[oo], 8);
+    347:     } else {
+    348:         if s.buflen < 440 {
+    349:             if s.buflen == 0 {
+    350:                 s.nullt = 1;
+    351:             }
+    352:             s.t[0] = s.t[0].wrapping_sub((440 - s.buflen) as u32);
+    353:             blake256_update(s, &PADDING[..(440 - s.buflen) as usize / 8], (440 - s.buflen) as u64);
+    354:         } else {
+    355:             s.t[0] = s.t[0].wrapping_sub((512 - s.buflen) as u32);
+    356:             blake256_update(s, &PADDING[..(512 - s.buflen) as usize / 8], (512 - s.buflen) as u64);
+    357:             s.t[0] = s.t[0].wrapping_sub(440);
+    358:             blake256_update(s, &PADDING[1..1 + 440 / 8], 440);
+    359:             s.nullt = 1;
+    360:         }
+    361:         blake256_update(s, &[zo], 8);
+    362:         s.t[0] = s.t[0].wrapping_sub(8);
+    363:     }
+    364:     s.t[0] = s.t[0].wrapping_sub(64);
+    365:     blake256_update(s, &msglen, 64);
+    366: 
+    367:     u32to8(&mut digest[0..4], s.h[0]);
+    368:     u32to8(&mut digest[4..8], s.h[1]);
+    369:     u32to8(&mut digest[8..12], s.h[2]);
+    370:     u32to8(&mut digest[12..16], s.h[3]);
+    371:     u32to8(&mut digest[16..20], s.h[4]);
+    372:     u32to8(&mut digest[20..24], s.h[5]);
+    373:     u32to8(&mut digest[24..28], s.h[6]);
+    374:     u32to8(&mut digest[28..32], s.h[7]);
+    375: }
