+    1092:         wots_sign_leaf: idx_leaf,
+    1093:         wots_steps: [0u32; SPX_WOTS_LEN],
+    1094:         leaf_addr: [0u32; 8],
+    1095:         pk_addr: [0u32; 8],
+    1096:     };
+    1097: 
+    1098:     // wots_sig points into sig
+    1099:     info.wots_sig = vec![0u8; SPX_WOTS_BYTES]; // will copy back
+    1100: 
+    1101:     let mut steps = [0u32; SPX_WOTS_LEN];
+    1102:     chain_lengths_internal(&mut steps, root);
+    1103:     info.wots_steps = steps;
+    1104: 
+    1105:     set_type(tree_addr, SPX_ADDR_TYPE_HASHTREE);
+    1106:     set_type(&mut info.pk_addr, SPX_ADDR_TYPE_WOTSPK);
