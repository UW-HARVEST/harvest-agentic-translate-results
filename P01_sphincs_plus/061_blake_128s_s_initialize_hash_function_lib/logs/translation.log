+    1283:             }
+    1284:         }
+    1285:         aes256_ctr_drbg_update(None, &mut DRBG_CTX.key, &mut DRBG_CTX.v);
+    1286:         DRBG_CTX.reseed_counter += 1;
+    1287:     }
+    1288:     RNG_SUCCESS
+    1289: }

