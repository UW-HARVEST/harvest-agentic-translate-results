+    1164: fn aes256_ecb(key: &[u8], ctr: &[u8], buffer: &mut [u8]) {
+    1165:     let cipher = Cipher::aes_256_ecb();
+    1166:     let mut crypter = Crypter::new(cipher, Mode::Encrypt, key, None).unwrap();
+    1167:     crypter.pad(false);
+    1168:     let count = crypter.update(ctr, buffer).unwrap();
+    1169:     let _ = crypter.finalize(&mut buffer[count..]).unwrap();
+    1170: }
+    1171: 
+    1172: fn seedexpander_init(ctx: &mut AesXofStruct, seed: &[u8], diversifier: &[u8], maxlen: u64) -> i32 {
+    1173:     if maxlen >= 0x100000000 {
+    1174:         return RNG_BAD_MAXLEN;
+    1175:     }
+    1176:     ctx.length_remaining = maxlen;
+    1177:     ctx.key.copy_from_slice(&seed[..32]);
+    1178:     ctx.ctr[..8].copy_from_slice(&diversifier[..8]);
+    1179:     let mut ml = maxlen;
+    1180:     ctx.ctr[11] = (ml % 256) as u8; ml >>= 8;
+    1181:     ctx.ctr[10] = (ml % 256) as u8; ml >>= 8;
+    1182:     ctx.ctr[9] = (ml % 256) as u8; ml >>= 8;
+    1183:     ctx.ctr[8] = (ml % 256) as u8;
+    1184:     ctx.ctr[12..16].fill(0);
+    1185:     ctx.buffer_pos = 16;
+    1186:     ctx.buffer.fill(0);
+    1187:     RNG_SUCCESS
+    1188: }
+    1189: 
+    1190: fn seedexpander(ctx: &mut AesXofStruct, x: &mut [u8], mut xlen: usize) -> i32 {
+    1191:     if xlen as u64 >= ctx.length_remaining {
+    1192:         return RNG_BAD_REQ_LEN;
+    1193:     }
+    1194:     ctx.length_remaining -= xlen as u64;
+    1195:     let mut offset = 0usize;
+    1196: 
+    1197:     while xlen > 0 {
+    1198:         if xlen <= 16 - ctx.buffer_pos {
+    1199:             x[offset..offset + xlen].copy_from_slice(&ctx.buffer[ctx.buffer_pos..ctx.buffer_pos + xlen]);
+    1200:             ctx.buffer_pos += xlen;
+    1201:             return RNG_SUCCESS;
+    1202:         }
+    1203:         let take = 16 - ctx.buffer_pos;
+    1204:         x[offset..offset + take].copy_from_slice(&ctx.buffer[ctx.buffer_pos..16]);
+    1205:         xlen -= take;
+    1206:         offset += take;
+    1207: 
+    1208:         aes256_ecb(&ctx.key, &ctx.ctr, &mut ctx.buffer);
+    1209:         ctx.buffer_pos = 0;
+    1210: 
+    1211:         for i in (12..=15).rev() {
+    1212:             if ctx.ctr[i] == 0xff {
+    1213:                 ctx.ctr[i] = 0x00;
+    1214:             } else {
+    1215:                 ctx.ctr[i] += 1;
+    1216:                 break;
+    1217:             }
+    1218:         }
+    1219:     }
+    1220:     RNG_SUCCESS
+    1221: }
+    1222: 
+    1223: fn aes256_ctr_drbg_update(provided_data: Option<&[u8]>, key: &mut [u8; 32], v: &mut [u8; 16]) {
+    1224:     let mut temp = [0u8; 48];
+    1225:     for i in 0..3 {
+    1226:         for j in (0..=15).rev() {
+    1227:             if v[j] == 0xff {
+    1228:                 v[j] = 0x00;
+    1229:             } else {
+    1230:                 v[j] += 1;
+    1231:                 break;
+    1232:             }
+    1233:         }
+    1234:         aes256_ecb(key, v, &mut temp[16 * i..16 * i + 16]);
+    1235:     }
+    1236:     if let Some(pd) = provided_data {
+    1237:         for i in 0..48 {
+    1238:             temp[i] ^= pd[i];
+    1239:         }
+    1240:     }
+    1241:     key.copy_from_slice(&temp[..32]);
+    1242:     v.copy_from_slice(&temp[32..48]);
+    1243: }
+    1244: 
+    1245: fn randombytes_init_internal(entropy_input: &[u8], personalization_string: Option<&[u8]>) {
+    1246:     let mut seed_material = [0u8; 48];
+    1247:     seed_material.copy_from_slice(&entropy_input[..48]);
+    1248:     if let Some(ps) = personalization_string {
+    1249:         for i in 0..48 {
+    1250:             seed_material[i] ^= ps[i];
+    1251:         }
+    1252:     }
+    1253:     unsafe {
+    1254:         DRBG_CTX.key.fill(0);
+    1255:         DRBG_CTX.v.fill(0);
+    1256:         aes256_ctr_drbg_update(Some(&seed_material), &mut DRBG_CTX.key, &mut DRBG_CTX.v);
+    1257:         DRBG_CTX.reseed_counter = 1;
+    1258:     }
+    1259: }
+    1260: 
+    1261: fn randombytes_internal(x: &mut [u8], mut xlen: u64) -> i32 {
+    1262:     let mut block = [0u8; 16];
+    1263:     let mut i: usize = 0;
+    1264: 
+    1265:     unsafe {
+    1266:         while xlen > 0 {
+    1267:             for j in (0..=15).rev() {
+    1268:                 if DRBG_CTX.v[j] == 0xff {
+    1269:                     DRBG_CTX.v[j] = 0x00;
+    1270:                 } else {
+    1271:                     DRBG_CTX.v[j] += 1;
+    1272:                     break;
+    1273:                 }
+    1274:             }
+    1275:             aes256_ecb(&DRBG_CTX.key, &DRBG_CTX.v, &mut block);
+    1276:             if xlen > 15 {
+    1277:                 x[i..i + 16].copy_from_slice(&block);
+    1278:                 i += 16;
+    1279:                 xlen -= 16;
