+    1108:     copy_subtree_addr(&mut info.pk_addr, wots_addr);
+    1109: 
+    1110:     let mut auth_buf = vec![0u8; SPX_TREE_HEIGHT * SPX_N];
+    1111:     wots_treehashx1(root, &mut auth_buf, ctx, idx_leaf, 0, SPX_TREE_HEIGHT as u32, tree_addr, &mut info);
+    1112: 
+    1113:     // Copy wots_sig into sig
+    1114:     sig[..SPX_WOTS_BYTES].copy_from_slice(&info.wots_sig);
+    1115:     // Copy auth_path
+    1116:     sig[auth_path_offset..auth_path_offset + SPX_TREE_HEIGHT * SPX_N].copy_from_slice(&auth_buf);
+    1117: }
