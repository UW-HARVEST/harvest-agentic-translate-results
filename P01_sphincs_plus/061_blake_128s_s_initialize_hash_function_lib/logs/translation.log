+    1152: #[derive(Clone)]
+    1153: struct AES256CtrDrbg {
+    1154:     key: [u8; 32],
+    1155:     v: [u8; 16],
+    1156:     reseed_counter: i32,
+    1157: }
+    1158: 
+    1159: const RNG_SUCCESS: i32 = 0;
+    1160: const RNG_BAD_MAXLEN: i32 = -1;
+    1161: const RNG_BAD_OUTBUF: i32 = -2;
+    1162: const RNG_BAD_REQ_LEN: i32 = -3;
