+    1027: // ============================================================
+    1028: // utilsx1.c - wots_treehashx1
+    1029: // ============================================================
+    1030: fn wots_treehashx1(
+    1031:     root: &mut [u8], auth_path: &mut [u8], ctx: &SpxCtx,
+    1032:     leaf_idx: u32, idx_offset: u32, tree_height: u32,
+    1033:     tree_addr: &mut [u32; 8], info: &mut LeafInfoX1,
+    1034: ) {
+    1035:     let th = tree_height as usize;
+    1036:     let mut stack = vec![0u8; th * SPX_N];
+    1037:     let max_idx = (1u32 << tree_height) - 1;
+    1038: 
+    1039:     let mut idx: u32 = 0;
+    1040:     loop {
+    1041:         let mut current = [0u8; 2 * SPX_N];
+    1042:         wots_gen_leafx1(&mut current[SPX_N..], ctx, idx + idx_offset, info);
+    1043: 
+    1044:         let mut internal_idx_offset = idx_offset;
+    1045:         let mut internal_idx = idx;
+    1046:         let mut internal_leaf = leaf_idx;
+    1047: 
+    1048:         let mut h: u32 = 0;
+    1049:         loop {
+    1050:             if h == tree_height {
+    1051:                 root[..SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);
+    1052:                 return;
+    1053:             }
+    1054:             if (internal_idx ^ internal_leaf) == 0x01 {
+    1055:                 let ap_off = (h as usize) * SPX_N;
+    1056:                 auth_path[ap_off..ap_off + SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);
+    1057:             }
+    1058:             if (internal_idx & 1) == 0 && idx < max_idx {
+    1059:                 break;
+    1060:             }
+    1061:             internal_idx_offset >>= 1;
+    1062:             set_tree_height(tree_addr, h + 1);
+    1063:             set_tree_index(tree_addr, internal_idx / 2 + internal_idx_offset);
+    1064: 
+    1065:             let stack_off = (h as usize) * SPX_N;
+    1066:             current[..SPX_N].copy_from_slice(&stack[stack_off..stack_off + SPX_N]);
+    1067:             let mut tmp = [0u8; 2 * SPX_N];
+    1068:             tmp.copy_from_slice(&current);
+    1069:             thash_internal(&mut current[SPX_N..], &tmp, 2, ctx, tree_addr);
+    1070: 
+    1071:             h += 1;
+    1072:             internal_idx >>= 1;
+    1073:             internal_leaf >>= 1;
+    1074:         }
+    1075: 
+    1076:         let stack_off = (h as usize) * SPX_N;
+    1077:         stack[stack_off..stack_off + SPX_N].copy_from_slice(&current[SPX_N..2 * SPX_N]);
+    1078:         idx += 1;
+    1079:     }
+    1080: }
