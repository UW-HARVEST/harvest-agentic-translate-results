+    1082: // ============================================================
+    1083: // Merkle (merkle.c)
+    1084: // ============================================================
+    1085: fn merkle_sign_internal(
+    1086:     sig: &mut [u8], root: &mut [u8], ctx: &SpxCtx,
+    1087:     wots_addr: &mut [u32; 8], tree_addr: &mut [u32; 8], idx_leaf: u32,
+    1088: ) {
+    1089:     let auth_path_offset = SPX_WOTS_BYTES;
+    1090:     let mut info = LeafInfoX1 {
