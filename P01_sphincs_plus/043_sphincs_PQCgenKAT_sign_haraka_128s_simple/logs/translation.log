fn haraka_s_absorb(s: &mut [u8; 64], m: &[u8], p: u8, ctx: &SpxCtx) {
    let mut off = 0usize;
    let mlen = m.len();
    while off + HARAKAS_RATE <= mlen {
        for i in 0..HARAKAS_RATE { s[i] ^= m[off + i]; }
        haraka512_perm(s, &s.clone(), ctx);
        off += HARAKAS_RATE;
    }
    let mut t = [0u8; HARAKAS_RATE];
    let rem = mlen - off;
    t[..rem].copy_from_slice(&m[off..]);
    t[rem] = p;
    t[HARAKAS_RATE - 1] |= 128;
    for i in 0..HARAKAS_RATE { s[i] ^= t[i]; }
}

fn haraka_s_squeezeblocks(h: &mut [u8], nblocks: usize, s: &mut [u8; 64], ctx: &SpxCtx) {
    for i in 0..nblocks {
        haraka512_perm(s, &s.clone(), ctx);
        h[i * HARAKAS_RATE..i * HARAKAS_RATE + HARAKAS_RATE].copy_from_slice(&s[..HARAKAS_RATE]);
    }
}

pub fn haraka_s_inc_init(s_inc: &mut [u8; 65]) {
    for i in 0..65 { s_inc[i] = 0; }
}

pub fn haraka_s_inc_absorb(s_inc: &mut [u8; 65], m: &[u8], ctx: &SpxCtx) {
    let mut moff = 0usize;
    let mut mlen = m.len();
    while mlen + s_inc[64] as usize >= HARAKAS_RATE {
        let take = HARAKAS_RATE - s_inc[64] as usize;
        for i in 0..take {
            s_inc[s_inc[64] as usize + i] ^= m[moff + i];
        }
        mlen -= take;
        moff += take;
        s_inc[64] = 0;
        let mut tmp = [0u8; 64];
        tmp.copy_from_slice(&s_inc[..64]);
        haraka512_perm(&mut tmp, &tmp.clone(), ctx);
        s_inc[..64].copy_from_slice(&tmp);
    }
    for i in 0..mlen {
        s_inc[s_inc[64] as usize + i] ^= m[moff + i];
    }
    s_inc[64] = s_inc[64].wrapping_add(mlen as u8);
}

pub fn haraka_s_inc_finalize(s_inc: &mut [u8; 65]) {
    s_inc[s_inc[64] as usize] ^= 0x1F;
    s_inc[HARAKAS_RATE - 1] ^= 128;
    s_inc[64] = 0;
}

pub fn haraka_s_inc_squeeze(out: &mut [u8], mut outlen: usize, s_inc: &mut [u8; 65], ctx: &SpxCtx) {
    let mut outoff = 0usize;
    let mut i = 0usize;
    while i < outlen && i < s_inc[64] as usize {
        out[outoff] = s_inc[HARAKAS_RATE - s_inc[64] as usize + i];
        outoff += 1;
        i += 1;
    }
    outlen -= i;
    s_inc[64] = s_inc[64].wrapping_sub(i as u8);
    while outlen > 0 {
        let mut tmp = [0u8; 64];
        tmp.copy_from_slice(&s_inc[..64]);
        haraka512_perm(&mut tmp, &tmp.clone(), ctx);
        s_inc[..64].copy_from_slice(&tmp);
        i = 0;
        while i < outlen && i < HARAKAS_RATE {
            out[outoff] = s_inc[i];
            outoff += 1;
            i += 1;
        }
        outlen -= i;
        s_inc[64] = (HARAKAS_RATE - i) as u8;
    }
}

pub fn haraka_s(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {
    let outlen = out.len();
    let mut s = [0u8; 64];
    haraka_s_absorb(&mut s, inp, 0x1F, ctx);
    let full_blocks = outlen / 32;
    if full_blocks > 0 {
        haraka_s_squeezeblocks(&mut out[..full_blocks * 32], full_blocks, &mut s, ctx);
    }
    if outlen % 32 != 0 {
        let mut d = [0u8; 32];
        haraka_s_squeezeblocks(&mut d, 1, &mut s, ctx);
        out[full_blocks * 32..].copy_from_slice(&d[..outlen % 32]);
    }
}
