    let max_idx = (1u32 << tree_height) - 1;
    for idx in 0u32.. {
        let mut current = [0u8; 2 * SPX_N];
        fors_gen_leafx1(&mut current[SPX_N..], ctx, idx + idx_offset, fors_leaf_addr);
        let mut iio = idx_offset;
        let mut ii = idx;
