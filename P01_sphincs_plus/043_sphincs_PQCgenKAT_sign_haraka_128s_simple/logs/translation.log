            q[j] = (t & 0x81818181)
                 | (t & 0x02020202) << 1
                 | (t & 0x04040404) << 2
                 | (t & 0x08080808) << 3
                 | (t & 0x10101010) >> 3
                 | (t & 0x20202020) >> 2
                 | (t & 0x40404040) >> 1;
        }
