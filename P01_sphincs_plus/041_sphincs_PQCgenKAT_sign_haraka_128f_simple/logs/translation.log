+    698: fn haraka_S_inc_finalize(s_inc: &mut [u8; 65]) {
+    699:     s_inc[s_inc[64] as usize] ^= 0x1F;
+    700:     s_inc[HARAKAS_RATE - 1] ^= 128;
+    701:     s_inc[64] = 0;
+    702: }
+    703: 
+    704: fn haraka_S_inc_squeeze(out: &mut [u8], mut outlen: usize, s_inc: &mut [u8; 65], ctx: &SpxCtx) {
+    705:     let mut out_off = 0usize;
+    706:     // consume leftover
+    707:     let avail = s_inc[64] as usize;
+    708:     let take = outlen.min(avail);
+    709:     for i in 0..take {
+    710:         out[out_off + i] = s_inc[HARAKAS_RATE - avail + i];
+    711:     }
+    712:     out_off += take;
+    713:     outlen -= take;
+    714:     s_inc[64] -= take as u8;
