+    637:         let mut tmp = [0u8; 64];
+    638:         tmp.copy_from_slice(s);
+    639:         haraka512_perm(s, &tmp, ctx);
+    640:         off += r;
+    641:     }
+    642:     let rem = mlen - off;
+    643:     let mut t = [0u8; 64]; // >= HARAKAS_RATE
+    644:     for i in 0..rem { t[i] = m[off + i]; }
+    645:     t[rem] = p;
+    646:     t[r - 1] |= 128;
+    647:     for i in 0..r { s[i] ^= t[i]; }
+    648: }
