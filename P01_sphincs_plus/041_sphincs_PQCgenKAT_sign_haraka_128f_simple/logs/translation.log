+    675: fn haraka_S_inc_absorb(s_inc: &mut [u8; 65], m: &[u8], mlen: usize, ctx: &SpxCtx) {
+    676:     let mut off = 0usize;
+    677:     let mut remaining = mlen;
+    678:     while remaining + (s_inc[64] as usize) >= HARAKAS_RATE {
+    679:         let take = HARAKAS_RATE - s_inc[64] as usize;
+    680:         for i in 0..take {
+    681:             s_inc[s_inc[64] as usize + i] ^= m[off + i];
+    682:         }
+    683:         remaining -= take;
+    684:         off += take;
+    685:         s_inc[64] = 0;
+    686:         let mut tmp = [0u8; 64];
+    687:         tmp.copy_from_slice(&s_inc[..64]);
+    688:         let mut out64 = [0u8; 64];
