+    609:             q[j] = (tmp_q & 0x81818181)
+    610:                 | (tmp_q & 0x02020202) << 1
+    611:                 | (tmp_q & 0x04040404) << 2
+    612:                 | (tmp_q & 0x08080808) << 3
+    613:                 | (tmp_q & 0x10101010) >> 3
+    614:                 | (tmp_q & 0x20202020) >> 2
+    615:                 | (tmp_q & 0x40404040) >> 1;
+    616:         }
+    617:     }
+    618:     br_aes_ct_ortho(&mut q);
