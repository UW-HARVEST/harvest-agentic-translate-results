+    650: fn haraka_S(out: &mut [u8], outlen: usize, inp: &[u8], ctx: &SpxCtx) {
+    651:     let mut s = [0u8; 64];
+    652:     haraka_S_absorb(&mut s, inp, 0x1F, ctx);
+    653:     let mut produced = 0usize;
