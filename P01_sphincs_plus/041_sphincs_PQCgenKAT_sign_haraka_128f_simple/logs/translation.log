+    723:         out[out_off..out_off + take].copy_from_slice(&s_inc[..take]);
+    724:         out_off += take;
+    725:         outlen -= take;
+    726:         s_inc[64] = (HARAKAS_RATE - take) as u8;
+    727:     }
+    728: }
