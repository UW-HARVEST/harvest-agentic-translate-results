+    656:         tmp.copy_from_slice(&s);
+    657:         haraka512_perm(&mut s, &tmp, ctx);
+    658:         out[produced..produced + 32].copy_from_slice(&s[..32]);
+    659:         produced += 32;
+    660:     }
