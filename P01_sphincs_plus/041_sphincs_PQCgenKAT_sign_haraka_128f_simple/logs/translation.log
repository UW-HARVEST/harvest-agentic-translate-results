+    622:         br_enc32le(&mut result[4 * i + 16..], q[2 * i + 1]);
+    623:     }
+    624:     for i in 0..32 { result[i] ^= inp[i]; }
+    625:     out[..32].copy_from_slice(&result);
+    626: }
