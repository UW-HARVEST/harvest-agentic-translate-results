+    184: fn keccak_absorb(s: &mut [u64; 25], r: usize, m: &[u8], p: u8) {
+    185:     for i in 0..25 { s[i] = 0; }
+    186:     let mut off = 0usize;
+    187:     let mut mlen = m.len();
+    188:     while mlen >= r {
+    189:         for i in 0..(r / 8) {
+    190:             s[i] ^= load64(&m[off + 8 * i..]);
+    191:         }
+    192:         keccak_f1600(s);
+    193:         mlen -= r;
+    194:         off += r;
+    195:     }
+    196:     let mut t = [0u8; 200];
+    197:     t[..mlen].copy_from_slice(&m[off..off + mlen]);
+    198:     t[mlen] = p;
+    199:     t[r - 1] |= 128;
+    200:     for i in 0..(r / 8) {
+    201:         s[i] ^= load64(&t[8 * i..]);
+    202:     }
+    203: }
