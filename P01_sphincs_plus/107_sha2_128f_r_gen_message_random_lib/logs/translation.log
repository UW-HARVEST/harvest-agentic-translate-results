+    23:         let chunk = if xlen < 1048576 { xlen } else { 1048576 };
+    24:         match f.read(&mut x[off..off + chunk]) {
+    25:             Ok(0) | Err(_) => {
+    26:                 std::thread::sleep(std::time::Duration::from_secs(1));
+    27:                 continue;
+    28:             }
+    29:             Ok(n) => {
+    30:                 off += n;
+    31:                 xlen -= n;
+    32:             }
+    33:         }
+    34:     }
+    35: }

