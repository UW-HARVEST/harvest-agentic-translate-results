+     9: pub fn randombytes(x: &mut [u8], mut xlen: usize) {
+    10:     let mut guard = FD.lock().unwrap();
+    11:     if guard.is_none() {
+    12:         loop {
+    13:             if let Ok(f) = File::open("/dev/urandom") {
