+    279: fn blake256_init(s: &mut Blakestate256) {
+    280:     s.h[0] = 0x6A09E667;
+    281:     s.h[1] = 0xBB67AE85;
+    282:     s.h[2] = 0x3C6EF372;
+    283:     s.h[3] = 0xA54FF53A;
+    284:     s.h[4] = 0x510E527F;
+    285:     s.h[5] = 0x9B05688C;
+    286:     s.h[6] = 0x1F83D9AB;
+    287:     s.h[7] = 0x5BE0CD19;
+    288:     s.t[0] = 0;
+    289:     s.t[1] = 0;
+    290:     s.buflen = 0;
+    291:     s.nullt = 0;
+    292:     s.s[0] = 0;
+    293:     s.s[1] = 0;
+    294:     s.s[2] = 0;
+    295:     s.s[3] = 0;
+    296: }
+    297: 
+    298: // datalen is in BITS (matching C code)
+    299: fn blake256_update(s: &mut Blakestate256, data: &[u8], mut datalen: u64) {
+    300:     let mut left = (s.buflen >> 3) as usize;
+    301:     let fill = 64 - left;
+    302:     let mut offset = 0usize;
+    303: 
+    304:     if left != 0 && (((datalen >> 3) as usize) & 0x3F) >= fill {
+    305:         s.buf[left..left + fill].copy_from_slice(&data[offset..offset + fill]);
+    306:         s.t[0] = s.t[0].wrapping_add(512);
+    307:         if s.t[0] == 0 {
+    308:             s.t[1] = s.t[1].wrapping_add(1);
+    309:         }
+    310:         let buf_copy = s.buf;
+    311:         blake256_compress(s, &buf_copy);
+    312:         offset += fill;
+    313:         datalen -= (fill as u64) << 3;
+    314:         left = 0;
+    315:     }
+    316: 
+    317:     while datalen >= 512 {
+    318:         s.t[0] = s.t[0].wrapping_add(512);
+    319:         if s.t[0] == 0 {
+    320:             s.t[1] = s.t[1].wrapping_add(1);
+    321:         }
+    322:         blake256_compress(s, &data[offset..]);
+    323:         offset += 64;
+    324:         datalen -= 512;
+    325:     }
+    326: 
+    327:     if datalen > 0 {
+    328:         let bytes = (datalen >> 3) as usize;
+    329:         s.buf[left..left + bytes].copy_from_slice(&data[offset..offset + bytes]);
+    330:         s.buflen = ((left << 3) as u64 + datalen) as i32;
+    331:     } else {
+    332:         s.buflen = 0;
+    333:     }
+    334: }
+    335: 
+    336: fn blake256_final(s: &mut Blakestate256, digest: &mut [u8]) {
+    337:     let mut msglen = [0u8; 8];
+    338:     let zo: u8 = 0x01;
+    339:     let oo: u8 = 0x81;
+    340:     let lo = s.t[0].wrapping_add(s.buflen as u32);
+    341:     let mut hi = s.t[1];
+    342:     if lo < s.buflen as u32 {
+    343:         hi = hi.wrapping_add(1);
+    344:     }
+    345:     u32to8(&mut msglen[0..4], hi);
+    346:     u32to8(&mut msglen[4..8], lo);
+    347: 
+    348:     if s.buflen == 440 {
+    349:         s.t[0] = s.t[0].wrapping_sub(8);
+    350:         blake256_update(s, &[oo], 8);
+    351:     } else {
+    352:         if s.buflen < 440 {
+    353:             if s.buflen == 0 {
+    354:                 s.nullt = 1;
+    355:             }
+    356:             s.t[0] = s.t[0].wrapping_sub((440 - s.buflen) as u32);
+    357:             let pad_len = (440 - s.buflen) as u64;
+    358:             // Need to pass enough padding bytes
+    359:             let pad_bytes = (pad_len / 8) as usize;
+    360:             // PADDING is 64 bytes, but we may need up to 55 bytes (440/8)
+    361:             blake256_update(s, &PADDING[..pad_bytes], pad_len);
+    362:         } else {
+    363:             s.t[0] = s.t[0].wrapping_sub((512 - s.buflen) as u32);
+    364:             let pad_len = (512 - s.buflen) as u64;
+    365:             let pad_bytes = (pad_len / 8) as usize;
+    366:             blake256_update(s, &PADDING[..pad_bytes], pad_len);
+    367:             s.t[0] = s.t[0].wrapping_sub(440);
+    368:             blake256_update(s, &PADDING[1..1 + 55], 440);
+    369:             s.nullt = 1;
+    370:         }
+    371:         blake256_update(s, &[zo], 8);
+    372:         s.t[0] = s.t[0].wrapping_sub(8);
+    373:     }
+    374:     s.t[0] = s.t[0].wrapping_sub(64);
+    375:     blake256_update(s, &msglen, 64);
+    376: 
+    377:     u32to8(&mut digest[0..4], s.h[0]);
+    378:     u32to8(&mut digest[4..8], s.h[1]);
+    379:     u32to8(&mut digest[8..12], s.h[2]);
+    380:     u32to8(&mut digest[12..16], s.h[3]);
+    381:     u32to8(&mut digest[16..20], s.h[4]);
+    382:     u32to8(&mut digest[20..24], s.h[5]);
+    383:     u32to8(&mut digest[24..28], s.h[6]);
+    384:     u32to8(&mut digest[28..32], s.h[7]);
+    385: }
+    386: 
+    387: fn blake256(out: &mut [u8], input: &[u8], inlen: u64) -> i32 {
+    388:     let mut s = Blakestate256 {
+    389:         h: [0; 8],
+    390:         s: [0; 4],
+    391:         t: [0; 2],
+    392:         buflen: 0,
+    393:         nullt: 0,
+    394:         buf: [0; 64],
+    395:     };
+    396:     blake256_init(&mut s);
+    397:     blake256_update(&mut s, input, inlen.wrapping_mul(8));
+    398:     blake256_final(&mut s, out);
+    399:     0
+    400: }
