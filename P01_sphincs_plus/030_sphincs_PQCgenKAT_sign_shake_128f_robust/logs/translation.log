+    206: fn keccak_squeezeblocks(h: &mut [u8], nblocks: usize, s: &mut [u64; 25], r: usize) {
+    207:     let mut off = 0;
+    208:     for _ in 0..nblocks {
+    209:         keccak_f1600(s);
+    210:         for i in 0..(r >> 3) {
+    211:             store64(&mut h[off + 8 * i..], s[i]);
+    212:         }
+    213:         off += r;
+    214:     }
+    215: }
