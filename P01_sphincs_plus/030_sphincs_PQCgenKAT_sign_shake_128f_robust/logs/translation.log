+    185: fn keccak_absorb(s: &mut [u64; 25], r: usize, m: &[u8], p: u8) {
+    186:     for i in 0..25 { s[i] = 0; }
+    187:     let mut off = 0usize;
+    188:     let mut mlen = m.len();
+    189:     while mlen >= r {
+    190:         for i in 0..(r / 8) {
+    191:             s[i] ^= load64(&m[off + 8 * i..]);
+    192:         }
+    193:         keccak_f1600(s);
+    194:         mlen -= r;
+    195:         off += r;
+    196:     }
+    197:     let mut t = [0u8; 200];
+    198:     t[..mlen].copy_from_slice(&m[off..off + mlen]);
+    199:     t[mlen] = p;
+    200:     t[r - 1] |= 128;
+    201:     for i in 0..(r / 8) {
+    202:         s[i] ^= load64(&t[8 * i..]);
+    203:     }
+    204: }
