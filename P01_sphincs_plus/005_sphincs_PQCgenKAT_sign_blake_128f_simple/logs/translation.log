+    175:     sig_off += SPX_FORS_BYTES;
+    176: 
+    177:     let mut wots_pk = [0u8; SPX_WOTS_BYTES];
+    178:     let mut leaf = [0u8; SPX_N];
+    179: 
+    180:     for i in 0..SPX_D {
+    181:         set_layer_addr(&mut tree_addr, i as u32);
+    182:         set_tree_addr(&mut tree_addr, tree);
+    183: 
+    184:         copy_subtree_addr(&mut wots_addr, &tree_addr);
+    185:         set_keypair_addr(&mut wots_addr, idx_leaf);
+    186:         copy_keypair_addr(&mut wots_pk_addr, &wots_addr);
+    187: 
+    188:         wots_pk_from_sig(&mut wots_pk, &sig[sig_off..], &root, &ctx, &mut wots_addr);
+    189:         sig_off += SPX_WOTS_BYTES;
+    190: 
+    191:         thash(&mut leaf, &wots_pk, SPX_WOTS_LEN, &ctx, &wots_pk_addr);
