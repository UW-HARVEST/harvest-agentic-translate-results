C_SRC="$RUST_DIR/c_src"

test_config() {
  local hash=$1 secpar=$2 thash=$3
  local CONFIG="${hash}_${secpar}_${thash}"
  
  local BUILD_DIR="$C_SRC/build_${CONFIG}"
  rm -rf "$BUILD_DIR"
  mkdir -p "$BUILD_DIR"
  cd "$BUILD_DIR"
  timeout 120 cmake "$C_SRC" -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DHASH_BACKEND="$hash" -DSECPAR="$secpar" -DTHASH="$thash" > /dev/null 2>&1 || { echo "CMAKE_FAIL $CONFIG"; return 1; }
  timeout 120 cmake --build . > /dev/null 2>&1 || { echo "C_BUILD_FAIL $CONFIG"; return 1; }
  
  export LD_LIBRARY_PATH="$BUILD_DIR/app:$BUILD_DIR/lib/$hash"
  local C_OUT=$(timeout 600 "$BUILD_DIR/app/driver" 2>&1)
  local C_DIG=$(echo "$C_OUT" | grep -oP '[0-9A-F]{64}')
  
  cd "$RUST_DIR"
  local FEATURES="${hash},${thash},${secpar}"
  timeout 300 cargo build --release --no-default-features --features "$FEATURES" --bin driver > /dev/null 2>&1 || { echo "RUST_BUILD_FAIL $CONFIG"; return 1; }
  local R_OUT=$(timeout 600 "$RUST_DIR/target/release/driver" 2>&1)
  local R_DIG=$(echo "$R_OUT" | grep -oP '[0-9A-F]{64}')
  
  if [ "$C_DIG" = "$R_DIG" ]; then
    echo "PASS $CONFIG ($C_DIG)"
  else
    echo "FAIL $CONFIG C=$C_DIG Rust=$R_DIG"
  fi
}

