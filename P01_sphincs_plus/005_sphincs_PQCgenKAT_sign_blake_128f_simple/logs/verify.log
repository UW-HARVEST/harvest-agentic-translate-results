use libloading::{Library, Symbol};
use std::path::PathBuf;

fn main() {
    let base = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("c_src/build_sha2_128f_simple");
    
    unsafe {
        let crypto_cpath = std::ffi::CString::new("libcrypto.so").unwrap();
        libc::dlopen(crypto_cpath.as_ptr(), libc::RTLD_LAZY | libc::RTLD_GLOBAL);
        
        let core_path = base.join("app/libsphincs_core_det.so");
        let core_cpath = std::ffi::CString::new(core_path.to_str().unwrap()).unwrap();
        libc::dlopen(core_cpath.as_ptr(), libc::RTLD_LAZY | libc::RTLD_GLOBAL);
        
        let sha2_path = base.join("lib/sha2/libsha2.so");
        let sha2_cpath = std::ffi::CString::new(sha2_path.to_str().unwrap()).unwrap();
        libc::dlopen(sha2_cpath.as_ptr(), libc::RTLD_LAZY | libc::RTLD_GLOBAL);
        
        let core = Library::new(&core_path).unwrap();
        
        // Test seed_keypair
        let c_fn: Symbol<unsafe extern "C" fn(*mut u8, *mut u8, *const u8) -> i32> =
            core.get(b"crypto_sign_seed_keypair").unwrap();
        
        let seed = [0x42u8; 48]; // 3*SPX_N = 48
        let mut c_pk = [0u8; 32];
        let mut c_sk = [0u8; 64];
        let mut r_pk = [0u8; 32];
        let mut r_sk = [0u8; 64];
        
        c_fn(c_pk.as_mut_ptr(), c_sk.as_mut_ptr(), seed.as_ptr());
        sphincsplus::sign::crypto_sign_seed_keypair(r_pk.as_mut_ptr(), r_sk.as_mut_ptr(), seed.as_ptr());
        
        println!("C pk:  {:02X?}", &c_pk[..]);
        println!("R pk:  {:02X?}", &r_pk[..]);
        println!("Match: {}", c_pk == r_pk);
    }
}
EOF

