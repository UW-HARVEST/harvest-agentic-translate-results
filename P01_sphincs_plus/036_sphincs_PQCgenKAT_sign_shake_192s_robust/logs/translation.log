+    178: fn keccak_absorb(s: &mut [u64; 25], r: usize, m: &[u8], p: u8) {
+    179:     for i in 0..25 { s[i] = 0; }
+    180:     let mut off = 0;
+    181:     let mut mlen = m.len();
+    182:     while mlen >= r {
+    183:         for i in 0..(r / 8) {
+    184:             s[i] ^= load64(&m[off + 8 * i..]);
+    185:         }
+    186:         keccak_f1600(s);
+    187:         mlen -= r;
+    188:         off += r;
+    189:     }
+    190:     let mut t = [0u8; 200];
+    191:     t[..mlen].copy_from_slice(&m[off..off + mlen]);
+    192:     t[mlen] = p;
+    193:     t[r - 1] |= 128;
+    194:     for i in 0..(r / 8) {
+    195:         s[i] ^= load64(&t[8 * i..]);
+    196:     }
+    197: }
