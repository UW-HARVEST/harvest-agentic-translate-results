+    199: fn keccak_squeezeblocks(h: &mut [u8], nblocks: usize, s: &mut [u64; 25], r: usize) {
+    200:     for b in 0..nblocks {
+    201:         keccak_f1600(s);
+    202:         for i in 0..(r >> 3) {
+    203:             store64(&mut h[b * r + 8 * i..], s[i]);
+    204:         }
+    205:     }
+    206: }
