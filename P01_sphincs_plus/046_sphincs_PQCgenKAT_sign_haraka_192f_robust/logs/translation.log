+    165:                 i += 16;
+    166:                 xlen -= 16;
+    167:             } else {
+    168:                 x[i..i + xlen as usize].copy_from_slice(&block[..xlen as usize]);
+    169:                 xlen = 0;
+    170:             }
+    171:         }
+    172:         aes256_ctr_drbg_update(None, &mut DRBG_CTX.key, &mut DRBG_CTX.v);
+    173:         DRBG_CTX.reseed_counter += 1;
+    174:     }
+    175: }
