+    132: fn randombytes_init(entropy_input: &[u8], personalization_string: Option<&[u8]>) {
+    133:     let mut seed_material = [0u8; 48];
+    134:     seed_material.copy_from_slice(&entropy_input[..48]);
+    135:     if let Some(ps) = personalization_string {
+    136:         for i in 0..48 {
+    137:             seed_material[i] ^= ps[i];
+    138:         }
+    139:     }
+    140:     unsafe {
+    141:         DRBG_CTX.key = [0u8; 32];
+    142:         DRBG_CTX.v = [0u8; 16];
+    143:         aes256_ctr_drbg_update(Some(&seed_material), &mut DRBG_CTX.key, &mut DRBG_CTX.v);
+    144:         DRBG_CTX.reseed_counter = 1;
+    145:     }
+    146: }
