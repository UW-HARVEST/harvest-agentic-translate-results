+    106: // ============ RNG ============
+    107: fn aes256_ctr_drbg_update(provided_data: Option<&[u8]>, key: &mut [u8; 32], v: &mut [u8; 16]) {
+    108:     let mut temp = [0u8; 48];
+    109:     for i in 0..3 {
+    110:         // increment V
+    111:         for j in (0..16).rev() {
+    112:             if v[j] == 0xff {
+    113:                 v[j] = 0x00;
+    114:             } else {
+    115:                 v[j] += 1;
+    116:                 break;
+    117:             }
+    118:         }
+    119:         let mut block = [0u8; 16];
+    120:         aes256_ecb(key, v, &mut block);
+    121:         temp[16 * i..16 * i + 16].copy_from_slice(&block);
+    122:     }
+    123:     if let Some(pd) = provided_data {
+    124:         for i in 0..48 {
+    125:             temp[i] ^= pd[i];
+    126:         }
+    127:     }
+    128:     key.copy_from_slice(&temp[..32]);
+    129:     v.copy_from_slice(&temp[32..48]);
+    130: }
