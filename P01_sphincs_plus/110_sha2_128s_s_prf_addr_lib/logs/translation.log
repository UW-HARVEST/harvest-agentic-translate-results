+     42: #[unsafe(no_mangle)]
+     43: pub extern "C" fn crypto_sign_seed_keypair(
+     44:     pk: *mut u8,
+     45:     sk: *mut u8,
+     46:     seed: *const u8,
+     47: ) -> i32 {
+     48:     unsafe {
+     49:         let pk_s = std::slice::from_raw_parts_mut(pk, SPX_PK_BYTES);
+     50:         let sk_s = std::slice::from_raw_parts_mut(sk, SPX_SK_BYTES);
+     51:         let seed_s = std::slice::from_raw_parts(seed, CRYPTO_SEEDBYTES);
+     52:         sign::crypto_sign_seed_keypair(pk_s, sk_s, seed_s)
+     53:     }
+     54: }
+     55: 
+     56: #[unsafe(no_mangle)]
+     57: pub extern "C" fn crypto_sign_keypair(pk: *mut u8, sk: *mut u8) -> i32 {
+     58:     unsafe {
+     59:         let pk_s = std::slice::from_raw_parts_mut(pk, SPX_PK_BYTES);
+     60:         let sk_s = std::slice::from_raw_parts_mut(sk, SPX_SK_BYTES);
+     61:         sign::crypto_sign_keypair(pk_s, sk_s)
+     62:     }
+     63: }
+     64: 
+     65: #[unsafe(no_mangle)]
+     66: pub extern "C" fn crypto_sign_signature(
+     67:     sig: *mut u8,
+     68:     siglen: *mut usize,
+     69:     m: *const u8,
+     70:     mlen: usize,
+     71:     sk: *const u8,
+     72: ) -> i32 {
+     73:     unsafe {
+     74:         let sig_s = std::slice::from_raw_parts_mut(sig, SPX_BYTES);
+     75:         let m_s = std::slice::from_raw_parts(m, mlen);
+     76:         let sk_s = std::slice::from_raw_parts(sk, SPX_SK_BYTES);
+     77:         sign::crypto_sign_signature(sig_s, &mut *siglen, m_s, mlen, sk_s)
+     78:     }
+     79: }
+     80: 
+     81: #[unsafe(no_mangle)]
+     82: pub extern "C" fn crypto_sign_verify(
+     83:     sig: *const u8,
+     84:     siglen: usize,
+     85:     m: *const u8,
+     86:     mlen: usize,
+     87:     pk: *const u8,
+     88: ) -> i32 {
+     89:     unsafe {
+     90:         let sig_s = std::slice::from_raw_parts(sig, if siglen > SPX_BYTES { siglen } else { SPX_BYTES });
+     91:         let m_s = std::slice::from_raw_parts(m, mlen);
+     92:         let pk_s = std::slice::from_raw_parts(pk, SPX_PK_BYTES);
+     93:         sign::crypto_sign_verify(sig_s, siglen, m_s, mlen, pk_s)
+     94:     }
+     95: }
+     96: 
+     97: #[unsafe(no_mangle)]
+     98: pub extern "C" fn crypto_sign(
+     99:     sm: *mut u8,
+    100:     smlen: *mut u64,
+    101:     m: *const u8,
+    102:     mlen: u64,
+    103:     sk: *const u8,
+    104: ) -> i32 {
+    105:     unsafe {
+    106:         let sm_s = std::slice::from_raw_parts_mut(sm, SPX_BYTES + mlen as usize);
+    107:         let m_s = std::slice::from_raw_parts(m, mlen as usize);
+    108:         let sk_s = std::slice::from_raw_parts(sk, SPX_SK_BYTES);
+    109: 
+    110:         let mut siglen: usize = 0;
+    111:         sign::crypto_sign_signature(sm_s, &mut siglen, m_s, mlen as usize, sk_s);
+    112: 
+    113:         // memmove sm + SPX_BYTES <- m
+    114:         std::ptr::copy(m, sm.add(SPX_BYTES), mlen as usize);
+    115:         *smlen = (siglen as u64) + mlen;
+    116:         0
+    117:     }
+    118: }
+    119: 
+    120: #[unsafe(no_mangle)]
+    121: pub extern "C" fn crypto_sign_open(
+    122:     m: *mut u8,
+    123:     mlen: *mut u64,
+    124:     sm: *const u8,
+    125:     smlen: u64,
+    126:     pk: *const u8,
+    127: ) -> i32 {
+    128:     unsafe {
+    129:         let smlen_usize = smlen as usize;
+    130:         if smlen_usize < SPX_BYTES {
+    131:             std::ptr::write_bytes(m, 0, smlen_usize);
+    132:             *mlen = 0;
+    133:             return -1;
+    134:         }
+    135: 
+    136:         let msg_len = smlen_usize - SPX_BYTES;
+    137:         *mlen = msg_len as u64;
+    138: 
+    139:         let sm_s = std::slice::from_raw_parts(sm, smlen_usize);
+    140:         let pk_s = std::slice::from_raw_parts(pk, SPX_PK_BYTES);
+    141: 
+    142:         if sign::crypto_sign_verify(&sm_s[..SPX_BYTES], SPX_BYTES, &sm_s[SPX_BYTES..], msg_len, pk_s) != 0 {
+    143:             std::ptr::write_bytes(m, 0, smlen_usize);
+    144:             *mlen = 0;
+    145:             return -1;
+    146:         }
+    147: 
+    148:         std::ptr::copy(sm.add(SPX_BYTES), m, msg_len);
+    149:         0
+    150:     }
+    151: }
