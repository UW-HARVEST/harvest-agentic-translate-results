+    492: 
+    493: #[unsafe(no_mangle)]
+    494: pub extern "C" fn SPX_fors_pk_from_sig(
+    495:     pk: *mut u8,
+    496:     sig: *const u8,
+    497:     m: *const u8,
+    498:     ctx: *const SpxCtx,
+    499:     fors_addr: *const u32,
