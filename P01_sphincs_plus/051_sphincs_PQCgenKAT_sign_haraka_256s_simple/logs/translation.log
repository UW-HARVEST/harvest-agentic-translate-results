+    826: fn hash_message(digest: &mut [u8], tree: &mut u64, leaf_idx: &mut u32,
+    827:                 r: &[u8], pk: &[u8], m: &[u8], mlen: u64, ctx: &SpxCtx) {
+    828:     const SPX_TREE_BITS: usize = SPX_TREE_HEIGHT * (SPX_D - 1);
+    829:     const SPX_TREE_BYTES: usize = (SPX_TREE_BITS + 7) / 8;
+    830:     const SPX_LEAF_BITS: usize = SPX_TREE_HEIGHT;
+    831:     const SPX_LEAF_BYTES: usize = (SPX_LEAF_BITS + 7) / 8;
+    832:     const SPX_DGST_BYTES: usize = SPX_FORS_MSG_BYTES + SPX_TREE_BYTES + SPX_LEAF_BYTES;
+    833: 
+    834:     let mut buf = [0u8; SPX_DGST_BYTES];
