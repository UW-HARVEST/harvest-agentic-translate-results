+    860: fn thash(out: &mut [u8], inp: &[u8], inblocks: usize, ctx: &SpxCtx, addr: &[u32; 8]) {
+    861:     let ab = addr_bytes(addr);
+    862:     if inblocks == 1 {
+    863:         let mut buf_tmp = [0u8; 64];
+    864:         buf_tmp[..32].copy_from_slice(&ab);
+    865:         buf_tmp[SPX_ADDR_BYTES..SPX_ADDR_BYTES + SPX_N].copy_from_slice(&inp[..SPX_N]);
+    866:         let mut outbuf = [0u8; 32];
+    867:         haraka512(&mut outbuf, &buf_tmp, ctx);
+    868:         out[..SPX_N].copy_from_slice(&outbuf[..SPX_N]);
+    869:     } else {
+    870:         let total = SPX_ADDR_BYTES + inblocks * SPX_N;
+    871:         let mut buf = vec![0u8; total];
+    872:         buf[..32].copy_from_slice(&ab);
+    873:         buf[SPX_ADDR_BYTES..SPX_ADDR_BYTES + inblocks * SPX_N].copy_from_slice(&inp[..inblocks * SPX_N]);
+    874:         haraka_s(out, SPX_N, &buf, total, ctx);
+    875:     }
+    876: }

