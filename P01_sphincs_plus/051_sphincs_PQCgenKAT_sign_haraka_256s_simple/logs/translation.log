+    569: fn tweak_constants(ctx: &mut SpxCtx) {
+    570:     // Copy standard constants
+    571:     ctx.tweaked512_rc64 = HARAKA512_RC64;
+    572: 
+    573:     // Generate tweaked constants from pub_seed
+    574:     let mut buf = [0u8; 40 * 16];
+    575:     haraka_s(&mut buf, 40 * 16, &ctx.pub_seed[..SPX_N], SPX_N, ctx);
+    576:     // Now overwrite with tweaked
+    577:     let ctx_clone = ctx.clone();
+    578:     let _ = ctx_clone; // just used haraka_s above with old constants
+    579:     // Re-generate: we need to use the result of haraka_s with the original constants
+    580:     // Actually the C code calls haraka_S with ctx which has the original rc64 copied.
+    581:     // The buf is already computed. Now interleave.
+    582:     for i in 0..10 {
+    583:         interleave_constant32(&mut ctx.tweaked256_rc32[i], &buf[32 * i..]);
+    584:         interleave_constant(&mut ctx.tweaked512_rc64[i], &buf[64 * i..]);
+    585:     }
+    586: }
+    587: 
+    588: fn haraka512_perm(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {
+    589:     let mut w = [0u32; 16];
+    590:     let mut q = [0u64; 8];
+    591:     br_range_dec32le(&mut w, &inp[..64]);
+    592:     for i in 0..4 {
+    593:         br_aes_ct64_interleave_in(&mut q[i], &mut q[i + 4], &w[i * 4..]);
+    594:     }
+    595:     br_aes_ct64_ortho(&mut q);
+    596: 
+    597:     for i in 0..5 {
+    598:         for j in 0..2 {
+    599:             br_aes_ct64_bitslice_sbox(&mut q);
+    600:             shift_rows(&mut q);
+    601:             mix_columns(&mut q);
+    602:             // add_round_key
+    603:             for k in 0..8 {
+    604:                 q[k] ^= ctx.tweaked512_rc64[2 * i + j][k];
+    605:             }
+    606:         }
+    607:         // Mix states
+    608:         for j in 0..8 {
+    609:             let tmp_q = q[j];
+    610:             q[j] = (tmp_q & 0x0001000100010001) << 5
+    611:                 | (tmp_q & 0x0002000200020002) << 12
+    612:                 | (tmp_q & 0x0004000400040004) >> 1
+    613:                 | (tmp_q & 0x0008000800080008) << 6
+    614:                 | (tmp_q & 0x0020002000200020) << 9
+    615:                 | (tmp_q & 0x0040004000400040) >> 4
+    616:                 | (tmp_q & 0x0080008000800080) << 3
+    617:                 | (tmp_q & 0x2100210021002100) >> 5
+    618:                 | (tmp_q & 0x0210021002100210) << 2
+    619:                 | (tmp_q & 0x0800080008000800) << 4
+    620:                 | (tmp_q & 0x1000100010001000) >> 12
+    621:                 | (tmp_q & 0x4000400040004000) >> 10
+    622:                 | (tmp_q & 0x8400840084008400) >> 3;
+    623:         }
+    624:     }
+    625: 
+    626:     br_aes_ct64_ortho(&mut q);
+    627:     for i in 0..4 {
+    628:         br_aes_ct64_interleave_out(&mut w[i * 4..], q[i], q[i + 4]);
+    629:     }
+    630:     br_range_enc32le(&mut out[..64], &w);
+    631: }
+    632: 
+    633: fn haraka512(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {
+    634:     let mut buf = [0u8; 64];
+    635:     haraka512_perm(&mut buf, inp, ctx);
+    636:     // Feed-forward
+    637:     for i in 0..64 {
+    638:         buf[i] ^= inp[i];
+    639:     }
+    640:     // Truncated
+    641:     out[..8].copy_from_slice(&buf[8..16]);
+    642:     out[8..16].copy_from_slice(&buf[24..32]);
+    643:     out[16..24].copy_from_slice(&buf[32..40]);
+    644:     out[24..32].copy_from_slice(&buf[48..56]);
+    645: }
+    646: 
+    647: fn haraka256(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {
+    648:     let mut q = [0u32; 8];
+    649:     for i in 0..4 {
+    650:         q[2 * i] = br_dec32le(&inp[4 * i..]);
+    651:         q[2 * i + 1] = br_dec32le(&inp[4 * i + 16..]);
+    652:     }
+    653:     br_aes_ct_ortho(&mut q);
+    654: 
+    655:     for i in 0..5 {
+    656:         for j in 0..2 {
+    657:             br_aes_ct_bitslice_sbox(&mut q);
+    658:             shift_rows32(&mut q);
+    659:             mix_columns32(&mut q);
