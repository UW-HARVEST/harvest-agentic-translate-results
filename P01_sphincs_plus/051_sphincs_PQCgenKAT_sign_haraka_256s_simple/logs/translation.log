+    552: fn interleave_constant(out: &mut [u64; 8], inp: &[u8]) {
+    553:     let mut tmp = [0u32; 16];
+    554:     br_range_dec32le(&mut tmp, inp);
+    555:     for i in 0..4 {
+    556:         br_aes_ct64_interleave_in(&mut out[i], &mut out[i + 4], &tmp[i * 4..]);
+    557:     }
+    558:     br_aes_ct64_ortho(out);
+    559: }
+    560: 
+    561: fn interleave_constant32(out: &mut [u32; 8], inp: &[u8]) {
+    562:     for i in 0..4 {
+    563:         out[2 * i] = br_dec32le(&inp[4 * i..]);
+    564:         out[2 * i + 1] = br_dec32le(&inp[4 * i + 16..]);
+    565:     }
+    566:     br_aes_ct_ortho(out);
+    567: }
