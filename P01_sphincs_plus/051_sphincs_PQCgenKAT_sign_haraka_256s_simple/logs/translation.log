+    661:             for k in 0..8 {
+    662:                 q[k] ^= ctx.tweaked256_rc32[2 * i + j][k];
+    663:             }
+    664:         }
+    665:         // Mix states
+    666:         for j in 0..8 {
+    667:             let tmp_q = q[j];
+    668:             q[j] = (tmp_q & 0x81818181)
+    669:                 | (tmp_q & 0x02020202) << 1
+    670:                 | (tmp_q & 0x04040404) << 2
+    671:                 | (tmp_q & 0x08080808) << 3
+    672:                 | (tmp_q & 0x10101010) >> 3
+    673:                 | (tmp_q & 0x20202020) >> 2
+    674:                 | (tmp_q & 0x40404040) >> 1;
+    675:         }
+    676:     }
+    677: 
+    678:     br_aes_ct_ortho(&mut q);
+    679:     for i in 0..4 {
+    680:         br_enc32le(&mut out[4 * i..], q[2 * i]);
+    681:         br_enc32le(&mut out[4 * i + 16..], q[2 * i + 1]);
+    682:     }
+    683:     for i in 0..32 {
+    684:         out[i] ^= inp[i];
+    685:     }
+    686: }

