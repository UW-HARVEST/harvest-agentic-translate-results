+    688: // ============================================================
+    689: // haraka sponge
+    690: // ============================================================
+    691: fn haraka_s_absorb(s: &mut [u8; 64], m: &[u8], mlen: usize, p: u8, ctx: &SpxCtx) {
+    692:     let r = HARAKAS_RATE;
+    693:     let mut offset = 0;
+    694:     let mut remaining = mlen;
+    695:     while remaining >= r {
+    696:         for i in 0..r {
+    697:             s[i] ^= m[offset + i];
+    698:         }
+    699:         let mut tmp = [0u8; 64];
+    700:         tmp.copy_from_slice(s);
+    701:         haraka512_perm(s, &tmp, ctx);
+    702:         remaining -= r;
+    703:         offset += r;
+    704:     }
+    705:     let mut t = vec![0u8; r];
+    706:     for i in 0..remaining {
+    707:         t[i] = m[offset + i];
+    708:     }
+    709:     t[remaining] = p;
+    710:     t[r - 1] |= 128;
+    711:     for i in 0..r {
+    712:         s[i] ^= t[i];
+    713:     }
+    714: }
+    715: 
+    716: fn haraka_s(out: &mut [u8], outlen: usize, inp: &[u8], inlen: usize, ctx: &SpxCtx) {
+    717:     let mut s = [0u8; 64];
+    718:     haraka_s_absorb(&mut s, inp, inlen, 0x1F, ctx);
+    719: 
+    720:     let full_blocks = outlen / 32;
+    721:     for b in 0..full_blocks {
+    722:         let mut tmp = [0u8; 64];
+    723:         tmp.copy_from_slice(&s);
+    724:         haraka512_perm(&mut s, &tmp, ctx);
+    725:         out[b * 32..(b + 1) * 32].copy_from_slice(&s[..HARAKAS_RATE]);
+    726:     }
+    727: 
+    728:     if outlen % 32 != 0 {
+    729:         let mut tmp = [0u8; 64];
+    730:         tmp.copy_from_slice(&s);
+    731:         haraka512_perm(&mut s, &tmp, ctx);
+    732:         let rem = outlen % 32;
+    733:         out[full_blocks * 32..full_blocks * 32 + rem].copy_from_slice(&s[..rem]);
+    734:     }
+    735: }
+    736: 
+    737: fn haraka_s_inc_init(s_inc: &mut [u8; 65]) {
+    738:     for i in 0..64 {
+    739:         s_inc[i] = 0;
+    740:     }
+    741:     s_inc[64] = 0;
+    742: }
+    743: 
+    744: fn haraka_s_inc_absorb(s_inc: &mut [u8; 65], m: &[u8], mut mlen: usize, ctx: &SpxCtx) {
+    745:     let mut m_off = 0;
+    746:     while mlen + s_inc[64] as usize >= HARAKAS_RATE {
+    747:         let avail = HARAKAS_RATE - s_inc[64] as usize;
+    748:         for i in 0..avail {
+    749:             s_inc[s_inc[64] as usize + i] ^= m[m_off + i];
+    750:         }
+    751:         mlen -= avail;
+    752:         m_off += avail;
+    753:         s_inc[64] = 0;
+    754:         let mut tmp = [0u8; 64];
+    755:         tmp.copy_from_slice(&s_inc[..64]);
+    756:         let mut out = [0u8; 64];
+    757:         haraka512_perm(&mut out, &tmp, ctx);
+    758:         s_inc[..64].copy_from_slice(&out);
+    759:     }
+    760:     for i in 0..mlen {
+    761:         s_inc[s_inc[64] as usize + i] ^= m[m_off + i];
+    762:     }
+    763:     s_inc[64] = s_inc[64].wrapping_add(mlen as u8);
+    764: }
+    765: 
+    766: fn haraka_s_inc_finalize(s_inc: &mut [u8; 65]) {
+    767:     s_inc[s_inc[64] as usize] ^= 0x1F;
+    768:     s_inc[HARAKAS_RATE - 1] ^= 128;
+    769:     s_inc[64] = 0;
+    770: }
+    771: 
+    772: fn haraka_s_inc_squeeze(out: &mut [u8], mut outlen: usize, s_inc: &mut [u8; 65], ctx: &SpxCtx) {
+    773:     let mut out_off = 0;
+    774:     // First consume leftover bytes
+    775:     let mut i = 0;
+    776:     while i < outlen && i < s_inc[64] as usize {
+    777:         out[out_off] = s_inc[HARAKAS_RATE - s_inc[64] as usize + i];
+    778:         out_off += 1;
+    779:         i += 1;
+    780:     }
+    781:     outlen -= i;
+    782:     s_inc[64] = s_inc[64].wrapping_sub(i as u8);
+    783: 
+    784:     while outlen > 0 {
+    785:         let mut tmp = [0u8; 64];
+    786:         tmp.copy_from_slice(&s_inc[..64]);
+    787:         let mut perm_out = [0u8; 64];
+    788:         haraka512_perm(&mut perm_out, &tmp, ctx);
+    789:         s_inc[..64].copy_from_slice(&perm_out);
+    790: 
+    791:         let take = outlen.min(HARAKAS_RATE);
+    792:         out[out_off..out_off + take].copy_from_slice(&s_inc[..take]);
+    793:         out_off += take;
+    794:         outlen -= take;
+    795:         s_inc[64] = (HARAKAS_RATE - take) as u8;
+    796:     }
+    797: }

