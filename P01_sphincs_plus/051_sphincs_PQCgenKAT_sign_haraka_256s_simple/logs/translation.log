+    836:     haraka_s_inc_init(&mut s_inc);
+    837:     haraka_s_inc_absorb(&mut s_inc, &r[..SPX_N], SPX_N, ctx);
+    838:     haraka_s_inc_absorb(&mut s_inc, &pk[SPX_N..2 * SPX_N], SPX_N, ctx);
+    839:     haraka_s_inc_absorb(&mut s_inc, &m[..mlen as usize], mlen as usize, ctx);
+    840:     haraka_s_inc_finalize(&mut s_inc);
+    841:     haraka_s_inc_squeeze(&mut buf, SPX_DGST_BYTES, &mut s_inc, ctx);
+    842: 
+    843:     digest[..SPX_FORS_MSG_BYTES].copy_from_slice(&buf[..SPX_FORS_MSG_BYTES]);
