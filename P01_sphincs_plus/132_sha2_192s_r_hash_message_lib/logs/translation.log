+    758: fn base_w(output: &mut [u32], out_len: usize, input: &[u8]) {
+    759:     let mut in_idx = 0usize;
+    760:     let mut out_idx = 0usize;
+    761:     let mut total: u8 = 0;
+    762:     let mut bits: i32 = 0;
+    763: 
+    764:     for _ in 0..out_len {
+    765:         if bits == 0 {
+    766:             total = input[in_idx];
+    767:             in_idx += 1;
+    768:             bits += 8;
+    769:         }
+    770:         bits -= SPX_WOTS_LOGW as i32;
+    771:         output[out_idx] = ((total >> bits) & (SPX_WOTS_W as u8 - 1)) as u32;
+    772:         out_idx += 1;
+    773:     }
+    774: }
