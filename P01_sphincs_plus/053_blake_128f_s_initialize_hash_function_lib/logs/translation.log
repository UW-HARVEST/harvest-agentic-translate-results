+    158:         let buf_copy = s.buf;
+    159:         blake512_compress(s, &buf_copy);
+    160:         data_off += fill;
+    161:         datalen -= (fill as u64) << 3;
+    162:         left = 0;
+    163:     }
+    164: 
+    165:     while datalen >= 1024 {
+    166:         s.t[0] = s.t[0].wrapping_add(1024);
+    167:         blake512_compress(s, &data[data_off..]);
+    168:         data_off += 128;
+    169:         datalen -= 1024;
+    170:     }
+    171: 
