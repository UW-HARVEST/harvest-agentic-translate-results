+    280:                 return;
+    281:             }
+    282:             if (internal_idx ^ internal_leaf) == 0x01 {
+    283:                 auth_path[h as usize * SPX_N..(h as usize + 1) * SPX_N]
+    284:                     .copy_from_slice(&current[SPX_N..2 * SPX_N]);
+    285:             }
+    286:             if (internal_idx & 1) == 0 && idx < max_idx {
+    287:                 break;
+    288:             }
+    289:             internal_idx_offset >>= 1;
+    290:             set_tree_height(tree_addr, h + 1);
