pub fn mgf1_256_rs(out: &mut [u8], inp: &[u8]) {
    let outlen = out.len();
    let inlen = inp.len();
    let mut inbuf = vec![0u8; inlen + 4];
    inbuf[..inlen].copy_from_slice(inp);
    let mut i = 0u64;
    let mut pos = 0;
    while (i + 1) * SPX_SHA256_OUTPUT_BYTES as u64 <= outlen as u64 {
        u32_to_bytes(&mut inbuf[inlen..], i as u32);
        sha256_rs(&mut out[pos..pos + SPX_SHA256_OUTPUT_BYTES], &inbuf);
        pos += SPX_SHA256_OUTPUT_BYTES;
        i += 1;
    }
    if outlen > (i as usize) * SPX_SHA256_OUTPUT_BYTES {
        u32_to_bytes(&mut inbuf[inlen..], i as u32);
        let mut outbuf = [0u8; SPX_SHA256_OUTPUT_BYTES];
        sha256_rs(&mut outbuf, &inbuf);
        let rem = outlen - (i as usize) * SPX_SHA256_OUTPUT_BYTES;
        out[pos..pos + rem].copy_from_slice(&outbuf[..rem]);
    }
}

