    copy_keypair_addr_rs(&mut fors_pk_addr, fors_addr);
    set_type_rs(&mut fors_tree_addr, SPX_ADDR_TYPE_FORSTREE);
    set_type_rs(&mut fors_pk_addr, SPX_ADDR_TYPE_FORSPK);

