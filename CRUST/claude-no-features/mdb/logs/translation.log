{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FuNo9555Z4GnnR6oXZq9U7","type":"tool_result","content":"1\tuse std::fs;\n2\tuse std::path::Path;\n3\tuse std::collections::HashMap;\n4\tuse mdb::mdb::{Mdb, MdbOptions, MdbError, MdbStatusCode};\n5\t\n6\tconst MDB_OK: MdbStatusCode = MdbStatusCode::MDB_OK;\n7\tconst MDB_NO_KEY: MdbStatusCode = MdbStatusCode::MDB_NO_KEY;\n8\t\n9\tuse rand::Rng;\n10\t\n11\t// Helper function to clean up test databases before/after tests\n12\tfn cleanup_db(db_name: &str) {\n13\t    let paths = [\n14\t        format!(\"{}.super\", db_name),\n15\t        format!(\"{}.index\", db_name),\n16\t        format!(\"{}.data\", db_name)\n17\t    ];\n18\t    \n19\t    for path in paths.iter() {\n20\t        if Path::new(path).exists() {\n21\t            let _ = fs::remove_file(path);\n22\t        }\n23\t    }\n24\t}\n25\t\n26\t#[test]\n27\tfn happy_test0() {\n28\t    println!(\"Starting misakawa happy test\");\n29\t    \n30\t    // Clean up any existing test files\n31\t    cleanup_db(\"misakawa\");\n32\t    \n33\t    let options = MdbOptions {\n34\t        db_name: \"misakawa\".to_string(),\n35\t        key_size_max: 64,\n36\t        data_size_max: 256,\n37\t        hash_buckets: 128,\n38\t        items_max: 166716,\n39\t    };\n40\t    \n41\t    // Create database\n42\t    let mut db = Mdb::create(\"misakawa\", options).expect(\"Failed to create database\");\n43\t    \n44\t    // Write a key-value pair\n45\t    db.write(\"misakawa\", \"mikoto\").expect(\"Failed to write key-value\");\n46\t    \n47\t    // Read the value back\n48\t    let mut buffer = vec![0u8; 257];\n49\t    let read_size = db.read(\"misakawa\", &mut buffer).expect(\"Failed to read value\");\n50\t    \n51\t    // Convert bytes to string for comparison\n52\t    let read_str = String::from_utf8_lossy(&buffer[0..read_size]).to_string();\n53\t    println!(\"\\\"misakawa\\\" => \\\"{}\\\"\", read_str);\n54\t    assert_eq!(\"mikoto\", read_str);\n55\t    \n56\t    // Delete the key\n57\t    db.delete(\"misakawa\").expect(\"Failed to delete key\");\n58\t    \n59\t    // Try to read the deleted key - should fail with KeyNotFound\n60\t    match db.read(\"misakawa\", &mut buffer) {\n61\t        Err(MdbError::KeyNotFound) => (), // Expected error\n62\t        _ => panic!(\"Expected KeyNotFound error when reading deleted key\"),\n63\t    }\n64\t    \n65\t    // Close the database (implicitly through drop)\n66\t    drop(db);\n67\t    \n68\t    println!(\"Finished misakawa happy test\");\n69\t    \n70\t    // Clean up\n71\t    cleanup_db(\"misakawa\");\n72\t}\n73\t\n74\t#[test]\n75\tfn reopen_test1() {\n76\t    println!(\"Starting lambda re-open test\");\n77\t    \n78\t    // Clean up any existing test files\n79\t    cleanup_db(\"lambda\");\n80\t    \n81\t    let options = MdbOptions {\n82\t        db_name: \"lambda\".to_string(),\n83\t        key_size_max: 64,\n84\t        data_size_max: 256,\n85\t        hash_buckets: 128,\n86\t        items_max: 166716,\n87\t    };\n88\t    \n89\t    // Create database and write data\n90\t    {\n91\t        let mut db = Mdb::create(\"lambda\", options.clone()).expect(\"Failed to create database\");\n92\t        db.write(\"Lisp\", \"LambdaExpression\").expect(\"Failed to write key-value\");\n93\t        // Database closed when db goes out of scope\n94\t    }\n95\t    \n96\t    // Re-open the database\n97\t    let mut db1 = Mdb::open(\"lambda\").expect(\"Failed to open existing database\");\n98\t    \n99\t    // Verify options were preserved\n100\t    let db1_options = db1.get_options();\n101\t    assert_eq!(options.db_name, db1_options.db_name);\n102\t    assert_eq!(options.key_size_max, db1_options.key_size_max);\n103\t    assert_eq!(options.data_size_max, db1_options.data_size_max);\n104\t    assert_eq!(options.hash_buckets, db1_options.hash_buckets);\n105\t    assert_eq!(options.items_max, db1_options.items_max);\n106\t    \n107\t    // Read the previously written value\n108\t    let mut buffer = vec![0u8; 257];\n109\t    let read_size = db1.read(\"Lisp\", &mut buffer).expect(\"Failed to read value\");\n110\t    let read_str = String::from_utf8_lossy(&buffer[0..read_size]).to_string();\n111\t    assert_eq!(\"LambdaExpression\", read_str);\n112\t    \n113\t    // Close the database (implicitly through drop)\n114\t    drop(db1);\n115\t    \n116\t    println!(\"Finished lambda re-open test\");\n117\t    \n118\t    // Clean up\n119\t    cleanup_db(\"lambda\");\n120\t}\n121\t\n122\t#[test]\n123\tfn load_test2() {\n124\t    println!(\"Starting accelerator load test\");\n125\t    \n126\t    // Clean up any existing test files\n127\t    cleanup_db(\"accelerator\");\n128\t    \n129\t    let preset_values = [\n130\t        \"misakawa\", \"kamijou\", \"accelerator\", \"index\", \"lyzh\", \"chuigda\",\n131\t        \"de_nuke\", \"de_mirage\", \"de_cache\", \"de_vertigo\", \"de_inferno\", \"de_cbble\",\n132\t        \"de_dust2\", \"fy_iceworld\", \"cs_assault\", \"komakan\", \"scarlet\", \"flandre\"\n133\t    ];\n134\t    \n135\t    let mut values = Vec::with_capacity(1000);\n136\t    let mut rng = rand::thread_rng();\n137\t    \n138\t    let options = MdbOptions {\n139\t        db_name: \"accelerator\".to_string(),\n140\t        key_size_max: 8,\n141\t        data_size_max: 256,\n142\t        hash_buckets: 128,\n143\t        items_max: 166716,\n144\t    };\n145\t    \n146\t    let mut db = Mdb::create(\"accelerator\", options).expect(\"Failed to create database\");\n147\t    \n148\t    // Write 1000 key-value pairs\n149\t    let mut i = 0;\n150\t    for c1 in '0'..='9' {\n151\t        for c2 in '0'..='9' {\n152\t            for c3 in '0'..='9' {\n153\t                let key = format!(\"{}{}{}\", c1, c2, c3);\n154\t                let value_idx = rng.gen_range(0..18);\n155\t                let value = preset_values[value_idx];\n156\t                values.push(value.to_string());\n157\t                \n158\t                db.write(&key, value).expect(\"Failed to write key-value\");\n159\t                i += 1;\n160\t            }\n161\t        }\n162\t    }\n163\t    \n164\t    // Read all values back and verify\n165\t    i = 0;\n166\t    let mut buffer = vec![0u8; 257];\n167\t    for c1 in '0'..='9' {\n168\t        for c2 in '0'..='9' {\n169\t            for c3 in '0'..='9' {\n170\t                let key = format!(\"{}{}{}\", c1, c2, c3);\n171\t                let read_size = db.read(&key, &mut buffer).expect(\"Failed to read value\");\n172\t                let read_str = String::from_utf8_lossy(&buffer[0..read_size]).to_string();\n173\t                \n174\t                assert_eq!(values[i], read_str);\n175\t                i += 1;\n176\t            }\n177\t        }\n178\t    }\n179\t    \n180\t    // Close the database (implicitly through drop)\n181\t    drop(db);\n182\t    \n183\t    println!(\"Finished accelerator load test\");\n184\t    \n185\t    // Clean up\n186\t    cleanup_db(\"accelerator\");\n187\t}\n188\t\n189\t#[test]\n190\tfn load_test3() {\n191\t    println!(\"Starting gabriel load test\");\n192\t    \n193\t    // Clean up any existing test files\n194\t    cleanup_db(\"gabriel\");\n195\t    \n196\t    let preset_values = [\n197\t        \"misakawa\", \"kamijou\", \"accelerator\", \"index\", \"lyzh\", \"chuigda\",\n198\t        \"de_nuke\", \"de_mirage\", \"de_cache\", \"de_vertigo\", \"de_inferno\", \"de_cbble\",\n199\t        \"de_dust2\", \"fy_iceworld\", \"cs_assault\", \"komakan\", \"scarlet\", \"flandre\"\n200\t    ];\n201\t    \n202\t    let mut values = vec![None; 1000];\n203\t    let mut values2 = vec![String::new(); 260];\n204\t    let mut deleted_entries = Vec::new();\n205\t    let mut rng = rand::thread_rng();\n206\t    \n207\t    let options = MdbOptions {\n208\t        db_name: \"gabriel\".to_string(),\n209\t        key_size_max: 8,\n210\t        data_size_max: 256,\n211\t        hash_buckets: 128,\n212\t        items_max: 166716,\n213\t    };\n214\t    \n215\t    let mut db = Mdb::create(\"gabriel\", options).expect(\"Failed to create database\");\n216\t    \n217\t    // Write 1000 key-value pairs with numeric keys\n218\t    let mut i = 0;\n219\t    for c1 in '0'..='9' {\n220\t        for c2 in '0'..='9' {\n221\t            for c3 in '0'..='9' {\n222\t                let key = format!(\"{}{}{}\", c1, c2, c3);\n223\t                let value_idx = rng.gen_range(0..18);\n224\t                let value = preset_values[value_idx].to_string();\n225\t                values[i] = Some(value.clone());\n226\t                \n227\t                db.write(&key, &value).expect(\"Failed to write key-value\");\n228\t                i += 1;\n229\t            }\n230\t        }\n231\t    }\n232\t    \n233\t    // Delete approximately 10% of entries (up to 128 max)\n234\t    let mut deleted_entries_cnt = 0;\n235\t    i = 0;\n236\t    for c1 in '0'..='9' {\n237\t        if deleted_entries_cnt >= 128 {\n238\t            break;\n239\t        }\n240\t        \n241\t        for c2 in '0'..='9' {\n242\t            if deleted_entries_cnt >= 128 {\n243\t                break;\n244\t            }\n245\t            \n246\t            for c3 in '0'..='9' {\n247\t                if deleted_entries_cnt >= 128 {\n248\t                    break;\n249\t                }\n250\t                \n251\t                if rng.gen_range(0..10) == 0 {\n252\t                    let key = format!(\"{}{}{}\", c1, c2, c3);\n253\t                    db.delete(&key).expect(\"Failed to delete key\");\n254\t                    values[i] = None;\n255\t                    deleted_entries.push(i);\n256\t                    deleted_entries_cnt += 1;\n257\t                }\n258\t                i += 1;\n259\t            }\n260\t        }\n261\t    }\n262\t    \n263\t    // Write 260 more key-value pairs with alphanumeric keys\n264\t    i = 0;\n265\t    for c1 in '0'..='9' {\n266\t        for c2 in 'A'..='Z' {\n267\t            let key = format!(\"{}{}\", c1, c2);\n268\t            let value_idx = rng.gen_range(0..18);\n269\t            let value = preset_values[value_idx].to_string();\n270\t            values2[i] = value.clone();\n271\t            \n272\t            db.write(&key, &value).expect(\"Failed to write key-value\");\n273\t            i += 1;\n274\t        }\n275\t    }\n276\t    \n277\t    // Verify all numeric keys\n278\t    i = 0;\n279\t    let mut buffer = vec![0u8; 257];\n280\t    for c1 in '0'..='9' {\n281\t        for c2 in '0'..='9' {\n282\t            for c3 in '0'..='9' {\n283\t                let key = format!(\"{}{}{}\", c1, c2, c3);\n284\t                match values[i] {\n285\t                    None => {\n286\t                        // This key was deleted, should get KeyNotFound\n287\t                        match db.read(&key, &mut buffer) {\n288\t                            Err(MdbError::KeyNotFound) => (), // Expected\n289\t                            Ok(_) => panic!(\"Expected KeyNotFound for deleted key {}\", key),\n290\t                            Err(e) => panic!(\"Unexpected error: {:?}\", e),\n291\t                        }\n292\t                    },\n293\t                    Some(ref expected_value) => {\n294\t                        // Should be able to read this key\n295\t                        let read_size = db.read(&key, &mut buffer).expect(\"Failed to read value\");\n296\t                        let read_str = String::from_utf8_lossy(&buffer[0..read_size]).to_string();\n297\t                        assert_eq!(expected_value, &read_str);\n298\t                    }\n299\t                }\n300\t                i += 1;\n301\t            }\n302\t        }\n303\t    }\n304\t    \n305\t    // Verify all alphanumeric keys\n306\t    i = 0;\n307\t    for c1 in '0'..='9' {\n308\t        for c2 in 'A'..='Z' {\n309\t            let key = format!(\"{}{}\", c1, c2);\n310\t            let read_size = db.read(&key, &mut buffer).expect(\"Failed to read value\");\n311\t            let read_str = String::from_utf8_lossy(&buffer