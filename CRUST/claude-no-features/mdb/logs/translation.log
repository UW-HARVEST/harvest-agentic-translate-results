ar *valbuf, mdb_size_t valsize);\n56\tstatic mdb_status_t mdb_read_nextptr(mdb_int_t *db, mdb_ptr_t idxptr,\n57\t                                     mdb_ptr_t *nextptr);\n58\tstatic mdb_status_t mdb_write_nextptr(mdb_int_t *db, mdb_ptr_t ptr,\n59\t                                      mdb_ptr_t nextptr);\n60\tstatic mdb_status_t mdb_stretch_index_file(mdb_int_t *db, mdb_ptr_t *ptr);\n61\tstatic mdb_status_t mdb_index_alloc(mdb_int_t *db, mdb_ptr_t *ptr);\n62\tstatic mdb_status_t mdb_data_alloc(mdb_int_t *db, mdb_size_t valsize,\n63\t                                   mdb_ptr_t *ptr);\n64\tstatic mdb_status_t mdb_index_free(mdb_int_t *db, mdb_ptr_t ptr);\n65\tstatic mdb_status_t mdb_data_free(mdb_int_t *db, mdb_ptr_t valptr,\n66\t                                  mdb_size_t valsize);\n67\t\n68\tstatic char pathbuf[4096];\n69\t\n70\tmdb_status_t mdb_open(mdb_t *handle, const char *path) {\n71\t  mdb_int_t *db = mdb_alloc();\n72\t  if (db == NULL) {\n73\t    return mdb_status(MDB_ERR_ALLOC,\n74\t                      \"failed allocating memory buffer for database\");\n75\t  }\n76\t\n77\t  strcpy(pathbuf, path);\n78\t  strcat(pathbuf, \".db.super\");\n79\t  db->fp_superblock = fopen(pathbuf, \"r\");\n80\t  if (db->fp_superblock == NULL) {\n81\t    mdb_free(db);\n82\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open superblock file as read\");\n83\t  }\n84\t\n85\t  fscanf(db->fp_superblock, \"%s\", db->db_name);\n86\t  fscanf(db->fp_superblock, \"%hu\", &(db->options.key_size_max));\n87\t  fscanf(db->fp_superblock, \"%u\", &(db->options.data_size_max));\n88\t  fscanf(db->fp_superblock, \"%u\", &(db->options.hash_buckets));\n89\t  fscanf(db->fp_superblock, \"%u\", &(db->options.items_max));\n90\t\n91\t  db->index_record_size = db->options.key_size_max\n92\t                          + MDB_PTR_SIZE * 2\n93\t                          + MDB_DATALEN_SIZE;\n94\t\n95\t  if (ferror(db->fp_superblock)) {\n96\t    mdb_free(db);\n97\t    return mdb_status(MDB_ERR_READ, \"read error when parsing superblock\");\n98\t  }\n99\t\n100\t  strcpy(pathbuf, path);\n101\t  strcat(pathbuf, \".db.index\");\n102\t  db->fp_index = fopen(pathbuf, \"rb+\");\n103\t  if (db->fp_index == NULL) {\n104\t    mdb_free(db);\n105\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open index file as readwrite\");\n106\t  }\n107\t\n108\t  strcpy(pathbuf, path);\n109\t  strcat(pathbuf, \".db.data\");\n110\t  db->fp_data = fopen(pathbuf, \"rb+\");\n111\t  if (db->fp_data == NULL) {\n112\t    mdb_free(db);\n113\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open data file as readwrite\");\n114\t  }\n115\t\n116\t  if (fflush(NULL) != 0) {\n117\t    mdb_free(db);\n118\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n119\t  }\n120\t\n121\t  *handle = (mdb_t)db;\n122\t  return mdb_status(MDB_OK, NULL);\n123\t}\n124\t\n125\tmdb_status_t mdb_create(mdb_t *handle, mdb_options_t options) {\n126\t  mdb_int_t *db = mdb_alloc();\n127\t  if (db == NULL) {\n128\t    return mdb_status(MDB_ERR_ALLOC,\n129\t                      \"failed allocating memory buffer for database\");\n130\t  }\n131\t\n132\t  strcpy(db->options.db_name, options.db_name);\n133\t  db->options.items_max = options.items_max;\n134\t  db->options.hash_buckets = options.hash_buckets;\n135\t  db->options.key_size_max = options.key_size_max;\n136\t  db->options.data_size_max = options.data_size_max;\n137\t\n138\t  db->index_record_size = db->options.key_size_max\n139\t                          + MDB_PTR_SIZE * 2\n140\t                          + MDB_DATALEN_SIZE;\n141\t\n142\t  strcpy(pathbuf, options.db_name);\n143\t  strcat(pathbuf, \".db.super\");\n144\t  db->fp_superblock = fopen(pathbuf, \"w\");\n145\t  if (db->fp_superblock == NULL) {\n146\t    mdb_free(db);\n147\t    return mdb_status(MDB_ERR_OPEN_FILE,\n148\t                      \"cannot open superblock file as write\");\n149\t  }\n150\t\n151\t  fprintf(db->fp_superblock, \"%s\\n\", db->db_name);\n152\t  fprintf(db->fp_superblock, \"%hu\\n\", db->options.key_size_max);\n153\t  fprintf(db->fp_superblock, \"%u\\n\", db->options.data_size_max);\n154\t  fprintf(db->fp_superblock, \"%u\\n\", db->options.hash_buckets);\n155\t  fprintf(db->fp_superblock, \"%u\\n\", db->options.items_max);\n156\t\n157\t  if (ferror(db->fp_superblock)) {\n158\t    mdb_free(db);\n159\t    return mdb_status(MDB_ERR_WRITE, \"write error when writing superblock\");\n160\t  }\n161\t\n162\t  strcpy(pathbuf, options.db_name);\n163\t  strcat(pathbuf, \".db.index\");\n164\t  db->fp_index = fopen(pathbuf, \"wb+\");\n165\t  if (db->fp_index == NULL) {\n166\t    mdb_free(db);\n167\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open index file as readwrite\");\n168\t  }\n169\t\n170\t  mdb_ptr_t zero_ptr = 0;\n171\t  if (fwrite(&zero_ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n172\t    mdb_free(db);\n173\t    return mdb_status(MDB_ERR_WRITE, \"write error when writing freeptr\");\n174\t  }\n175\t  for (size_t i = 0; i < options.hash_buckets; i++) {\n176\t    if (fwrite(&zero_ptr, MDB_PTR_SIZE, 1, db->fp_index) < 1) {\n177\t      mdb_free(db);\n178\t      return mdb_status(MDB_ERR_WRITE, \"write error when writing hash buckets\");\n179\t    }\n180\t  }\n181\t\n182\t  strcpy(pathbuf, options.db_name);\n183\t  strcat(pathbuf, \".db.data\");\n184\t  db->fp_data = fopen(pathbuf, \"wb+\");\n185\t  if (db->fp_data == NULL) {\n186\t    mdb_free(db);\n187\t    return mdb_status(MDB_ERR_OPEN_FILE, \"cannot open data file as readwrite\");\n188\t  }\n189\t\n190\t  if (fflush(NULL) != 0) {\n191\t    mdb_free(db);\n192\t    return mdb_status(MDB_ERR_FLUSH, \"fflush failed\");\n193\t  }\n194\t\n195\t  *handle = (mdb_t)db;\n196\t  return mdb_status(MDB_OK, NULL);\n197\t}\n198\t\n199\tmdb_status_t mdb_read(mdb_t handle, const char *key, char *buf, size_t bufsiz) {\n200\t  mdb_int_t *db = (mdb_int_t*)handle;\n201\t  mdb_size_t bucket = mdb_hash(key) % db->options.hash_buckets;\n202\t\n203\t  mdb_ptr_t ptr;\n204\t  mdb_status_t bucket_read_status = mdb_read