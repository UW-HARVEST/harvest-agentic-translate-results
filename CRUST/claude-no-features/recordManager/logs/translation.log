 pinPage (BM_BufferPool *const bm, BM_PageHandle *const page, \n227\t            const PageNumber pageNum)\n228\t    {\n229\t        Bufferpool *buffer_pool;\n230\t        bool void_page=FALSE;\n231\t        bool foundedPage=FALSE;\n232\t        bool UpdatedStra_found=FALSE;\n233\t        int read_code;\n234\t        int record_pointer;\n235\t        int memory_address;\n236\t        int swap_location;\n237\t        \n238\t        SM_PageHandle page_handle;\n239\t        buffer_pool=bm->mgmtData;\n240\t        buffer_pool = bm->mgmtData;\n241\t        \n242\t        void_page = (buffer_pool->free_space == buffer_pool->totalPages) ? TRUE : void_page;\n243\t       if (!void_page) {\n244\t        int totalPages = buffer_pool->totalPages - buffer_pool->free_space;\n245\t        for (int i = 0; i < totalPages; i++) {\n246\t\n247\t            if (buffer_pool->pagenum[i] == pageNum) {\n248\t                page->pageNum = pageNum;\n249\t                int memory_address = i;\n250\t                buffer_pool->fix_count[memory_address]++;\n251\t                page->data = &buffer_pool->pagedata[memory_address * PAGE_SIZE];\n252\t                foundedPage = TRUE;\n253\t                if (buffer_pool->updatedStrategy == RS_LRU) {\n254\t                        int lastPosition = buffer_pool->totalPages - buffer_pool->free_space - 1; \n255\t                        swap_location = -1; \n256\t                        for (int j = 0; j <= lastPosition; j++) \n257\t                            if (buffer_pool->updatedOrder[j] != pageNum) {\n258\t                                if (j == buffer_pool->totalPages - 1) {\n259\t                                    swap_location = -1;\n260\t                                }\n261\t                             } else {\n262\t                                swap_location = j;\n263\t                                break;\n264\t                            }\n265\t                            if (swap_location != -1) {\n266\t                  