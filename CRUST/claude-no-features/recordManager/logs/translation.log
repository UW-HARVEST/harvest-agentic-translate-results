chema();\n482\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n483\t\n484\t\tTEST_CHECK(initRecordManager(NULL));\n485\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n486\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n487\t\n488\t\t// insert rows into table\n489\t\tfor(i = 0; i < numInserts; i++)\n490\t\t{\n491\t\t\tr = fromTestRecord(schema, inserts[i]);\n492\t\t\tTEST_CHECK(insertRecord(table,r));\n493\t\t\trids[i] = r->id;\n494\t        freeRecord(r);   // Added Summer 2021\n495\t\t}\n496\t\n497\t\tTEST_CHECK(closeTable(table));\n498\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n499\t\n500\t\t// run some scans\n501\t\tMAKE_CONS(left, stringToValue(\"i1\"));\n502\t\tMAKE_ATTRREF(right, 2);\n503\t\tMAKE_BINOP_EXPR(sel, left, right, OP_COMP_EQUAL);\n504\t\n505\t\tTEST_CHECK(startScan(table, sc, sel));\n506\t    TEST_CHECK(createRecord(&r, schema));  // Added Summer 2021\n507\t\twhile((rc = next(sc, r)) == RC_OK)\n508\t\t{\n509\t\t\tfor(i = 0; i < scanSizeOne; i++)\n510\t\t\t{\n511\t\t\t\tif (memcmp(fromTestRecord(schema, scanOneResult[i])->data,r->data,getRecordSize(schema)) == 0)\n512\t\t\t\t\tfoundScan[i] = TRUE;\n513\t\t\t}\n514\t\t}\n515\t    freeRecord(r);   // Added Summer 2021\n516\t\n517\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n518\t\t\tTEST_CHECK(rc);\n519\t\tTEST_CHECK(closeScan(sc));\n520\t\tfor(i = 0; i < scanSizeOne; i++)\n521\t\t\tASSERT_TRUE(foundScan[i], \"check for scan result\");\n522\t\n523\t\t// clean up\n524\t\tTEST_CHECK(closeTable(table));\n525\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n526\t\tTEST_CHECK(shutdownRecordManager());\n527\t\n528\t\tfree(table);\n529\t\tfree(sc);\n530\t// ***** Added Summer 2021\n531\t    free(rids);\n532\t    freeSchema(schema);\n533\t// *****\n534\t\tfreeExpr(sel);\n535\t\tTEST_DONE();\n536\t}\n537\t\n538\t\n539\tvoid testScansTwo (void)\n540\t{\n541\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n542\t\tTestRecord inserts[] = {\n543\t\t\t\t{1, \"aaaa\", 3},\n544\t\t\t\t{2, \"bbbb\", 2},\n545\t\t\t\t{3, \"cccc\", 1},\n546\t\t\t\t{4, \"dddd\", 3},\n547\t\t\t\t{5, \"eeee\", 5},\n548\t\t\t\t{6, \"ffff\", 1},\n549\t\t\t\t{7, \"gggg\", 3},\n550\t\t\t\t{8, \"hhhh\", 3},\n551\t\t\t\t{9, \"iiii\", 2},\n552\t\t\t\t{10, \"jjjj\", 5},\n553\t\t};\n554\t\tbool foundScan[] = {\n555\t\t\t\tFALSE,\n556\t\t\t\tFALSE,\n557\t\t\t\tFALSE,\n558\t\t\t\tFALSE,\n559\t\t\t\tFALSE,\n560\t\t\t\tFALSE,\n561\t\t\t\tFALSE,\n562\t\t\t\tFALSE,\n563\t\t\t\tFALSE,\n564\t\t\t\tFALSE\n565\t\t};\n566\t\tint numInserts = 10, i;\n567\t\tRecord *r;\n568\t\tRID *rids;\n569\t\tSchema *schema;\n570\t\tRM_ScanHandle *sc = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n571\t\tExpr *sel, *left, *right, *first, *se;\n572\t\tint rc;\n573\t\n574\t\ttestName = \"test creating a new table and inserting tuples\";\n575\t\tschema = testSchema();\n576\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n577\t\n578\t\tTEST_CHECK(initRecordManager(NULL));\n579\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n580\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n581\t\n582\t\t// insert rows into table\n583\t\tfor(i = 0; i < numInserts; i++)\n584\t\t{\n585\t\t\tr = fromTestRecord(schema, inserts[i]);\n586\t\t\tTEST_CHECK(insertRecord(table,r));\n587\t\t\trids[i] = r->id;\n588\t        freeRecord(r);   // Added Summer 2021\n589\t\t}\n590\t\n591\t\tTEST_CHECK(closeTable(table));\n592\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n593\t\n594\t\t// Select 1 record with INT in condition a=2.\n595\t\tMAKE_CONS(left, stringToValue(\"i2\"));\n596\t\tMAKE_ATTRREF(right, 0);\n597\t\tMAKE_BINOP_EXPR(sel, left, right, OP_COMP_EQUAL);\n598\t\tcreateRecord(&r, schema);\n599\t\tTEST_CHECK(startScan(table, sc, sel));\n600\t\twhile((rc = next(sc, r)) == RC_OK)\n601\t\t{\n602\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, inserts[1]), r, schema, \"compare records\");\n603\t\t}\n604\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n605\t\t\tTEST_CHECK(rc);\n606\t\tTEST_CHECK(closeScan(sc));\n607\t\n608\t\t// Select 1 record with STRING in condition b='ffff'.\n609\t\tMAKE_CONS(left, stringToValue(\"sffff\"));\n610\t\tMAKE_ATTRREF(right, 1);\n611\t\tMAKE_BINOP_EXPR(sel, left, right, OP_COMP_EQUAL);\n612\t\tcreateRecord(&r, schema);\n613\t\tTEST_CHECK(startScan(table, sc, sel));\n614\t\twhile((rc = next(sc, r)) == RC_OK)\n615\t\t{\n616\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, inserts[5]), r, schema, \"compare records\");\n617\t\t\tserializeRecord(r, schema);\n618\t\t}\n619\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n620\t\t\tTEST_CHECK(rc);\n621\t\tTEST_CHECK(closeScan(sc));\n622\t\n623\t\t// Select all records, with condition being false\n624\t\tMAKE_CONS(left, stringToValue(\"i4\"));\n625\t\tMAKE_ATTRREF(right, 2);\n626\t\tMAKE_BINOP_EXPR(first, right, left, OP_COMP_SMALLER);\n627\t\tMAKE_UNOP_EXPR(se, first, OP_BOOL_NOT);\n628\t\tTEST_CHECK(startScan(table, sc, se));\n629\t\twhile((rc = next(sc, r)) == RC_OK)\n630\t\t{\n631\t\t\tserializeRecord(r, schema);\n632\t\t\tfor(i = 0; i < numInserts; i++)\n633\t\t\t{\n634\t\t\t\tif (memcmp(fromTestRecord(schema, inserts[i])->data,r->data,getRecordSize(schema)) == 0)\n635\t\t\t\t\tfoundScan[i] = TRUE;\n636\t\t\t}\n637\t\t}\n638\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n639\t\t\tTEST_CHECK(rc);\n640\t\tTEST_CHECK(closeScan(sc));\n641\t\n642\t\tASSERT_TRUE(!foundScan[0], \"not greater than four\");\n643\t\tASSERT_TRUE(foundScan[4], \"greater than four\");\n644\t\tASSERT_TRUE(foundScan[9], \"greater than four\");\n645\t\n646\t\t// clean up\n647\t\tTEST_CHECK(closeTable(table));\n648\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n649\t\tTEST_CHECK(shutdownRecordManager());\n650\t\n651\t\tfreeRecord(r);\n652\t\tfree(table);\n653\t\tfree(sc);\n654\t    freeSchema(schema);   // Added Summer 2021\n655\t\tfreeExpr(sel);\n656\t\tTEST_DONE();\n657\t}\n658\t\n659\t\n660\tSchema *\n661\ttestSchema (void)\n662\t{\n663\t\tSchema *result;\n664\t\tchar *names[] = { \"a\", \"b\", \"c\" };\n665\t\tDataType dt[] = { DT_INT, DT_STRING, DT_INT };\n