\t\n116\t\tgetAttr(r, schema, 2, &value);\n117\t\tOP_TRUE(stringToValue(\"i3\"), value, valueEquals, \"third attr\");\n118\t\tfreeVal(value);\n119\t\n120\t\t//modify attrs\n121\t\tsetAttr(r, schema, 2, stringToValue(\"i4\"));\n122\t\tgetAttr(r, schema, 2, &value);\n123\t\tOP_TRUE(stringToValue(\"i4\"), value, valueEquals, \"third attr after setting\");\n124\t\tfreeVal(value);\n125\t\n126\t\tfreeRecord(r);\n127\t    freeSchema(schema);   // added Summer 2021\n128\t\tTEST_DONE();\n129\t}\n130\t\n131\t// ************************************************************ \n132\tvoid\n133\ttestCreateTableAndInsert (void)\n134\t{\n135\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n136\t\tTestRecord inserts[] = {\n137\t\t\t\t{1, \"aaaa\", 3},\n138\t\t\t\t{2, \"bbbb\", 2},\n139\t\t\t\t{3, \"cccc\", 1},\n140\t\t\t\t{4, \"dddd\", 3},\n141\t\t\t\t{5, \"eeee\", 5},\n142\t\t\t\t{6, \"ffff\", 1},\n143\t\t\t\t{7, \"gggg\", 3},\n144\t\t\t\t{8, \"hhhh\", 3},\n145\t\t\t\t{9, \"iiii\", 2}\n146\t\t};\n147\t\tint numInserts = 9, i;\n148\t\tRecord *r;\n149\t\tRID *rids;\n150\t\tSchema *schema;\n151\t\ttestName = \"test creating a new table and inserting tuples\";\n152\t\tschema = testSchema();\n153\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n154\t\n155\t\tTEST_CHECK(initRecordManager(NULL));\n156\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n157\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n158\t\n159\t\t// insert rows into table\n160\t\tfor(i = 0; i < numInserts; i++)\n161\t    {\n162\t\t\tr = fromTestRecord(schema, inserts[i]);\n163\t\t\tTEST_CHECK(insertRecord(table,r));\n164\t\t\trids[i] = r->id;\n165\t        freeRecord(r);    // added Fall 2021\n166\t    }\n167\t\n168\t\tTEST_CHECK(closeTable(table));\n169\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n170\t\n171\t\t// randomly retrieve records from the table and compare to inserted ones\n172\t\tfor(i = 0; i < 1000; i++)\n173\t\t{   TEST_CHECK(createRecord(&r, schema));  // added Fall