eof(int));\n57\t\n58\t    int arraySize = numPages * sizeof(int);\n59\t    bool boolArraySize = numPages * sizeof(bool);\n60\t    bp->fix_count = (int *)calloc(numPages, sizeof(int));\n61\t    bp->updatedStrategy = strategy;\n62\t\n63\t   \n64\t\n65\t    for (i = 0; i < numPages; i++) {\n66\t        bp->bitdirty[i] = FALSE;\n67\t    }\n68\t\n69\t    for (i = 0; i < numPages; i++) {\n70\t      bp->fix_count[i] = 0;\n71\t    }\n72\t\n73\t    for (i = 0; i < numPages; i++) {\n74\t        bp->pagenum[i] = NO_PAGE;\n75\t    }\n76\t\n77\t    for (i = 0; i < numPages; i++) {\n78\t        bp->updatedOrder[i] = NO_PAGE;\n79\t    }\n80\t\n81\t    if (bm != NULL) {\n82\t        if (pageFileName != NULL) {\n83\t            bm->pageFile = strdup(pageFileName); \n84\t        } else {\n85\t            bm->pageFile = NULL;\n86\t        }\n87\t        bm->numPages = numPages;\n88\t        bm->strategy = strategy;\n89\t        bm->mgmtData = bp;\n90\t        if (bp != NULL) {\n91\t        } \n92\t        } \n93\t        return RC_OK;\n94\t    }\n95\t\n96\t// Define shutdown the buffer pool\n97\tRC shutdownBufferPool(BM_BufferPool *const bm) {\n98\t    Bufferpool *bpl = bm->mgmtData;\n99\t    \n100\t    for (int i = 0; i < bpl->totalPages; i++) {\n101\t        if (bpl->fix_count[i] != 0) {\n102\t            return RC_BUFFERPOOL_IN_USE;\n103\t        }\n104\t    }\n105\t    RC rc = writeDirtyPages(bm);\n106\t    if (rc != RC_OK) {\n107\t        return rc; \n108\t    }\n109\t \n110\t    if (closePageFile(&bpl->fhl) != RC_OK) {\n111\t        return RC_CLOSE_FAILED;\n112\t    }\n113\t    \n114\t    freeBufferPoolMemory(bm);\n115\t    return RC_OK;\n116\t}\n117\t\n118\t    // Helper function\n119\t    static RC writeDirtyPages(BM_BufferPool *const bm) {\n120\t        Bufferpool *bpl = bm->mgmtData;\n121\t        for (int j = 0; j < bpl->totalPages; j++) {\n122\t            if (bpl->bitdirty[j]) {\n123\t                int record_pointer = j * PAGE_SIZE;\n124\t                // Ensure capacity before writing\n125\t                RC rc = ensureCapacity(bpl->pagenum[j] + 1, &bpl->fhl);\n126\t                if (rc != RC_OK) {\n127\t                    return rc;\n128\t                }\n129\t                // Write block\n130\t                rc = writeBlock(bpl->pagenum[j], &bpl->fhl, (bpl->pagedata + record_pointer));\n131\t                if (rc != RC_OK) {\n132\t                    return RC_WRITE_FAILED;\n133\t                }\n134\t                bpl->numWrite++;\n135\t            }\n136\t        }\n137\t        return RC_OK;\n138\t    }\n139\t\n140\t    // Helper function\n141\t    static RC freeBufferPoolMemory(BM_BufferPool *const bm)\n142\t                \n143\t            {\n144\t        if (bm != NULL) {\n145\t            Bufferpool *bpl = bm->mgmtData;\n146\t            if (bpl != NULL) {\n147\t                if (bpl->updatedOrder != NULL) {\n148\t                    free(bpl->updatedOrder);\n149\t                    bpl->updatedOrder = NULL; \n150\t                }\n151\t                if (bpl->pagenum != NULL) {\n152\t                    free(bpl->pagenum);\n153\t                    bpl->pagenum = NULL; \n154\t                }\n155\t                if (bpl->bitdirty != NULL) {\n156\t                    free(bpl->bitdirty);\n157\t                    bpl->bitdirty = NULL; \n158\t                }\n159\t                if (bpl->fix_count != NULL) {\n160\t                    free(bpl->fix_count);\n161\t                    bpl->fix_count = NULL;\n162\t                }\n163\t                if (bpl->pagedata != NULL) {\n164\t                    free(bpl->pagedata);\n165\t                    bpl->pagedata = NULL; \n166\t                }\n167\t                free(bpl);\n168\t                bm->mgmtData = NULL;\n169\t            } else {\n170\t            }\n171\t            return RC_OK;\n172\t        } else {\n173\t            return RC_ERROR; \n174\t        }\n175\t\n176\t        return RC_OK;\n177\t}\n178\t    // Define flush the