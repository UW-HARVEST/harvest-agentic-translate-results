bound: u32 = (self.range >> NUM_BIT_MODEL_TOTAL_BITS) * (prob as u32);\n        if bit {\n            self.low += new_bound as u64;\n            self.range -= new_bound;\n        } else {\n            self.range = new_bound;\n        }\n        while (self.range & TOP_MASK) == 0 {\n            self.range <<= 8;\n            self.shift_low();\n        }\n    }\n\n    fn encode_direct_bits(&mut self, bits: u32, num_bits: u32) {\n        let mut num_bits = num_bits;\n        loop {\n            let bit = (bits & (1 << (num_bits - 1))) != 0;\n            self.range >>= 1;\n            if bit {\n                self.low += self.range as u64;\n            }\n            if (self.range & TOP_MASK) == 0 {\n                self.range <<= 8;\n                self.shift_low();\n            }\n            num_bits -= 1;\n            if num_bits == 0 {\n                break;\n            }\n        }\n    }\n}\n\n/// API-compatible helpers. Callers should use `RangeEncoder::new` directly.\npub fn range_encoder_new(_enc: &mut dyn EncoderInterface, _output: &mut dyn OutputInterface) {\n    // no-op — use `RangeEncoder::new(...)` instead.\n}\npub fn range_encoder_free(_enc: &mut dyn EncoderInterface) {\n    // no-op — drop the `RangeEncoder` to free its resources.\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1096,"cache_read_input_tokens":94537,"cache_creation":{"ephemeral_5m_input_tokens":1096,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3ec0714-02c4-47c7-994e-fba880b0349a","uuid":"806cbe8e-0e6a-47b4-8067-0b526dc5a6b7"}
