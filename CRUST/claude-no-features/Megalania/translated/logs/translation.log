 let new_idx = self.data.len();\n        self.data.push(value);\n        self.heapify_up(new_idx);\n        true\n    }\n    pub fn maximum(&self) -> Option<u32> {\n        self.data.first().copied()\n    }\n    pub fn remove_maximum(&mut self) -> bool {\n        if self.data.is_empty() {\n            return false;\n        }\n        let last = self.data.pop().unwrap();\n        if !self.data.is_empty() {\n            self.data[0] = last;\n            self.heapify_down(0);\n        }\n        true\n    }\n    /// Assumes that the element at index 0 may have changed.\n    pub fn update_maximum(&mut self) -> bool {\n        if self.data.is_empty() {\n            return false;\n        }\n        self.heapify_down(0);\n        true\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4808,"cache_read_input_tokens":76028,"cache_creation":{"ephemeral_5m_input_tokens":4808,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3ec0714-02c4-47c7-994e-fba880b0349a","uuid":"1eff50cd-091f-4e4a-acf5-058b43060364"}
