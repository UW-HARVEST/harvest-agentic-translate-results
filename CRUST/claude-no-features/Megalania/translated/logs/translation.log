{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_z4gwqkqbtxkhddtzwvt4fxqitwhld6d4ulw6jmzkt6rjlrvk2eeq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_015zrH4pCydrY2hJrQhGUES6","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-HABbjk/project/src/lzma_packet_encoder.rs","content":"use crate::encoder_interface::EncoderInterface;\nuse crate::lzma_packet::{LZMAPacket, LZMAPacketType};\nuse crate::lzma_state::{\n    lzma_state_promote_distance_at, lzma_state_push_distance, lzma_state_update_ctx_state,\n    LZMAState, LengthProbabilityModel, ALIGN_BITS, END_POS_MODEL_INDEX, HIGH_CODER_BITS,\n    LOW_CODER_BITS, LOW_CODER_SYMBOLS, MID_CODER_BITS, MID_CODER_SYMBOLS, NUM_LEN_TO_POS_STATES,\n    NUM_POS_BITS_MAX, POS_SLOT_BITS,\n};\nuse crate::probability_model::{encode_bit, encode_bit_tree, encode_bit_tree_reverse, encode_direct_bits};\n\n#[derive(Default, Clone, Copy)]\nstruct LZMAPacketHeader {\n    matched: bool,\n    rep: bool,\n    b3: bool,\n    b4: bool,\n    b5: bool,\n}\n\nfn lzma_encode_packet_header(\n    lzma_state: &mut LZMAState,\n    enc: &mut dyn EncoderInterface,\n    head: &LZMAPacketHeader,\n) {\n    let ctx_pos_bits: usize = 0; // position context bits currently unsupported\n    let ctx_state = lzma_state.ctx_state as usize;\n    let ctx_pos_state = (ctx_state << NUM_POS_BITS_MAX) + ctx_pos_bits;\n\n    encode_bit(\n        head.matched,\n        &mut lzma_state.probs.ctx_state.is_match[ctx_pos_state],\n        enc,\n    );\n    if !head.matched {\n        return;\n    }\n\n    encode_bit(\n        head.rep,\n        &mut lzma_state.probs.ctx_state.is_rep[ctx_state],\n        enc,\n    );\n    if !head.rep {\n        return;\n    }\n\n    encode_bit(\n        head.b3,\n        &mut lzma_state.probs.ctx_state.is_rep_g0[ctx_state],\n        enc,\n    );\n    if head.b3 {\n        encode_bit(\n            head.b4,\n            &mut lzma_state.probs.ctx_state.is_rep_g1[ctx_state],\n            enc,\n        );\n        if head.b4 {\n            encode_bit(\n                head.b5,\n                &mut lzma_state.probs.ctx_state.is_rep_g2[ctx_state],\n                enc,\n            );\n        }\n    } else {\n        encode_bit(\n            head.b4,\n            &mut lzma_state.probs.ctx_state.is_rep0_long[ctx_pos_state],\n            enc,\n        );\n    }\n}\n\nfn lzma_encode_length(\n    probs: &mut LengthProbabilityModel,\n    enc: &mut dyn EncoderInterface,\n    len: u32,\n) {\n    let ctx_pos_bits: usize = 0;\n    assert!(len >= 2);\n    let mut len = len - 2;\n\n    if (len as usize) < LOW_CODER_SYMBOLS {\n        encode_bit(false, &mut probs.choice_1, enc);\n        encode_bit_tree(len, &mut probs.low_coder[ctx_pos_bits], LOW_CODER_BITS, enc);\n    } else {\n        len -= LOW_CODER_SYMBOLS as u32;\n        encode_bit(true, &mut probs.choice_1, enc);\n        if (len as usize) < MID_CODER_SYMBOLS {\n            encode_bit(false, &mut probs.choice_2, enc);\n            encode_bit_tree(len, &mut probs.mid_coder[ctx_pos_bits], MID_CODER_BITS, enc);\n        } else {\n            len -= MID_CODER_SYMBOLS as u32;\n            encode_bit(true, &mut probs.choice_2, enc);\n            encode_bit_tree(len, &mut probs.high_coder, HIGH_CODER_BITS, enc);\n        }\n    }\n}\n\nfn get_msb32(val: u32) -> u32 {\n    32 - val.leading_zeros()\n}\n\nfn lzma_encode_distance(\n    lzma_state: &mut LZMAState,\n    enc: &mut dyn EncoderInterface,\n    dist: u32,\n    len: u32,\n) {\n    let mut len_ctx = (len as i64) - 2;\n    if len_ctx >= NUM_LEN_TO_POS_STATES as i64 {\n        len_ctx = NUM_LEN_TO_POS_STATES as i64 - 1;\n    }\n    let len_ctx = len_ctx as usize;\n\n    if dist < 4 {\n        encode_bit_tree(\n            dist,\n            &mut lzma_state.probs.dist.pos_slot_coder[len_ctx],\n            POS_SLOT_BITS,\n            enc,\n        );\n        return;\n    }\n\n    let mut num_low_bits = get_msb32(dist) - 2;\n    let mut low_bits = dist & ((1u32 << num_low_bits) - 1);\n    let high_bits = dist >> num_low_bits;\n    let pos_slot = num_low_bits * 2 + high_bits;\n    encode_bit_tree(\n        pos_slot,\n        &mut lzma_state.probs.dist.pos_slot_coder[len_ctx],\n        POS_SLOT_BITS,\n        enc,\n    );\n\n    if (pos_slot as usize) < END_POS_MODEL_INDEX {\n        let pos_coder_ctx = ((high_bits << num_low_bits) as i64) - pos_slot as i64;\n        let start = pos_coder_ctx as usize;\n        encode_bit_tree_reverse(\n            low_bits,\n            &mut lzma_state.probs.dist.pos_coder[start..],\n            num_low_bits as usize,\n            enc,\n        );\n        return;\n    }\n\n    let num_direct_bits = num_low_bits - ALIGN_BITS as u32;\n    num_low_bits = ALIGN_BITS as u32;\n    let direct_bits = low_bits >> ALIGN_BITS;\n    low_bits &= (1u32 << num_low_bits) - 1;\n\n    encode_direct_bits(direct_bits, num_direct_bits as usize, enc);\n    encode_bit_tree_reverse(\n        low_bits,\n        &mut lzma_state.probs.dist.align_coder,\n        num_low_bits as usize,\n        enc,\n    );\n}\n\nfn lzma_encode_literal(lzma_state: &mut LZMAState, enc: &mut dyn EncoderInterface) {\n    let head = LZMAPacketHeader {\n        matched: false,\n        ..Default::default()\n    };\n    lzma_encode_packet_header(lzma_state, enc, &head);\n\n    let mut symbol: u32 = 1;\n    let lit_ctx: usize = 0; // literal context bits currently unsupported\n\n    let lit = lzma_state.data[lzma_state.position];\n    let mut matched = lzma_state.ctx_state >= 7;\n    let mut match_byte: u8 = 0;\n    if matched {\n        let pos = lzma_state.position;\n        let dist = lzma_state.dists[0] as usize;\n        match_byte = lzma_state.data[pos - dist - 1];\n    }\n\n    let lit_probs_start = 0x300 * lit_ctx;\n    for i in (0..=7i32).rev() {\n        let bit = ((lit >> i) & 1) != 0;\n        let mut context = symbol;\n        if matched {\n            let match_bit = (((match_byte >> i) & 1) as u32) != 0;\n            context += (1 + match_bit as u32) << 8;\n            matched = match_bit == bit;\n        }\n        encode_bit(\n            bit,\n            &mut lzma_state.probs.lit[lit_probs_start + context as usize],\n            enc,\n        );\n        symbol = (symbol << 1) | (bit as u32);\n    }\n}\n\nfn lzma_encode_match(\n    lzma_state: &mut LZMAState,\n    enc: &mut dyn EncoderInterface,\n    dist: u32,\n    len: u32,\n) {\n    let head = LZMAPacketHeader {\n        matched: true,\n        rep: false,\n        ..Default::default()\n    };\n    lzma_encode_packet_header(lzma_state, enc, &head);\n\n    lzma_state_push_distance(lzma_state, dist);\n    // Encode length and distance using the length/distance models.\n    // We need to split the borrow on lzma_state.probs.len.\n    {\n        // SAFETY: We're not violating aliasing — `lzma_encode_length` only\n        // touches probs.len, while `lzma_encode_distance` touches probs.dist.\n        // We work around the borrow checker via indexed access, because the\n        // closures take &mut lzma_state.\n        let len_probs_ptr: *mut LengthProbabilityModel = &mut lzma_state.probs.len;\n        // Write the length first.\n        // We need a mutable borrow of len_probs without holding a borrow of lzma_state.\n        // Since `lzma_state` is later passed into encode_distance, we must\n        // sequence these accesses carefully.\n        let len_probs = unsafe { &mut *len_probs_ptr };\n        lzma_encode_length(len_probs, enc, len);\n    }\n    lzma_encode_distance(lzma_state, enc, dist, len);\n}\n\nfn lzma_encode_short_rep(lzma_state: &mut LZMAState, enc: &mut dyn EncoderInterface) {\n    let head = LZMAPacketHeader {\n        matched: true,\n        rep: true,\n        b3: false,\n        b4: false,\n        b5: false,\n    };\n    lzma_encode_packet_header(lzma_state, enc, &head);\n}\n\nfn lzma_encode_long_rep(\n    lzma_state: &mut LZMAState,\n    enc: &mut dyn EncoderInterface,\n    dist_index: u32,\n    len: u32,\n) {\n    let head = LZMAPacketHeader {\n        matched: true,\n        rep: true,\n        b3: dist_index != 0,\n        b4: dist_index != 1,\n        b5: dist_index != 2,\n    };\n    lzma_encode_packet_header(lzma_state, enc, &head);\n\n    lzma_state_promote_distance_at(lzma_state, dist_index);\n    lzma_encode_length(&mut lzma_state.probs.rep_len, enc, len);\n}\n\npub fn lzma_encode_packet(\n    lzma_state: &mut LZMAState,\n    enc: &mut dyn EncoderInterface,\n    packet: LZMAPacket,\n) {\n    let packet_type = packet.packet_type;\n    let len = packet.len as u32;\n    let dist = packet.dist;\n    match packet_type {\n        LZMAPacketType::Literal => lzma_encode_literal(lzma_state, enc),\n        LZMAPacketType::Match => lzma_encode_match(lzma_state, enc, dist, len),\n        LZMAPacketType::ShortRep => lzma_encode_short_rep(lzma_state, enc),\n        LZMAPacketType::LongRep => lzma_encode_long_rep(lzma_state, enc, dist, len),\n        LZMAPacketType::Invalid => panic!(\"Invalid packet type\"),\n    }\n    lzma_state_update_ctx_state(lzma_state, packet_type as u32);\n    lzma_state.position += len as usize;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":957,"cache_read_input_tokens":97343,"cache_creation":{"ephemeral_5m_input_tokens":957,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f3ec0714-02c4-47c7-994e-fba880b0349a","uuid":"31c44415-70ae-45eb-8d63-e751a1cda23f"}
