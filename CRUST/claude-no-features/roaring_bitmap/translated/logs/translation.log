0\t    const uint16_t* const restrict a_end = a + a_size;\n361\t    const uint16_t* const restrict b_end = b + b_size;\n362\t    while (a < a_end && b < b_end) {\n363\t        if (*a < *b) {\n364\t            a++;\n365\t        } else if (*b < *a) {\n366\t            b++;\n367\t        } else {\n368\t            *result++ = *a++;\n369\t            b++;\n370\t        }\n371\t    }\n372\t    return result;\n373\t}\n374\t\n375\tstatic inline const uint16_t*\n376\tsse_intersection(const uint16_t* restrict a, size_t a_size,\n377\t                 const uint16_t* restrict b, size_t b_size,\n378\t                 uint16_t* restrict result)\n379\t{\n380\t    // from https://highlyscalable.wordpress.com/2012/06/05/fast-intersection-sorted-lists-sse/\n381\t    size_t count = 0;\n382\t    static __m128i shuffle_mask16[256];\n383\t    static int built_shuffle_mask = 0;\n384\t    if (!built_shuffle_mask) {\n385\t        built_shuffle_mask = 1;\n386\t        for (int i = 0; i < 256; i++) {\n387\t            uint8_t mask[16];\n388\t            memset(mask, 0xFF, sizeof(mask));\n389\t            int counter = 0;\n390\t            for (int j = 0; j < 16; j++) {\n391\t                if (i & (1 << j)) {\n392\t                    mask[counter++] = 2 * j;\n393\t                    mask[counter++] = 2 * j + 1;\n394\t                }\n395\t            }\n396\t            __m128i v_mask = _mm_loadu_si128((const __m128i *)mask);\n397\t            shuffle_mask16[i] = v_mask;\n398\t        }\n399\t    }\n400\t    size_t i_a = 0, i_b = 0;\n401\t    size_t st_a = (a_size / 8) * 8;\n402\t    size_t st_b = (b_size / 8) * 8;\n403\t\n404\t    while(i_a < st_a && i_b < st_b) {\n405\t        __m128i v_a = _mm_loadu_si128((__m128i *)&a[i_a]);\n406\t        __m128i v_b = _mm_loadu_si128((__m128i *)&b[i_b]);\n407\t        __m128i v_cmp = _mm_cmpestrm(v_a, 8, v_b, 8,\n408\t            _SIDD_UWORD_OPS|_SIDD_CMP_EQUAL_ANY|_SIDD_BIT_MASK);\n409\t        int r = _mm_extract_epi32(v_cmp, 0);\n410\t        _