+= term;\n        n += 1;\n        if n > 100 {\n            break;\n        }\n    }\n\n    // Multiply by 2^k (exact when k is in range).\n    if k > 1023 {\n        return f64::INFINITY;\n    }\n    if k < -1074 {\n        return 0.0;\n    }\n    let two_pow_k = if k >= -1022 {\n        f64::from_bits(((k + 1023) as u64) << 52)\n    } else {\n        // Subnormal range\n        f64::from_bits(1u64 << ((k + 1074) as u32))\n    };\n\n    sum * two_pow_k\n}","originalFile":"// Constants\npub const S21_NAN: f64 = f64::NAN;\npub const EPS_6: f64 = 1e-06;\npub const S21_M_E: f64 = 2.71828182845904523536028747135266250;\npub const S21_INFINITY: f64 = f64::INFINITY;\npub const EPS_10: f64 = 1e-10;\npub const S21_M_PI: f64 = 3.14159265358979323846264338327950288;\n\n// Function Declarations\n\npub fn castom_abs(x: i32) -> i32 {\n    if x > 0 { x } else { -x }\n}\n\npub fn castom_fabs(x: f64) -> f64 {\n    if x > 0.0 { x } else { -x }\n}\n\npub fn castom_floor(x: f64) -> f64 {\n    if x.is_nan() {\n        return x;\n    }\n    // If outside i64 range, return as-is (matching C behavior with LLONG_MAX/LLONG_MIN).\n    if x >= i64::MAX as f64 || x <= i64::MIN as f64 {\n        return x;\n    }\n    let truncation = (x as i64) as f64;\n    if truncation > x {\n        truncation - 1.0\n    } else {\n        truncation\n    }\n}\n\npub fn castom_ceil(x: f64) -> f64 {\n    if x.is_nan() {\n        return x;\n    }\n    if x >= i64::MAX as f64 || x <= i64::MIN as f64 {\n        return x;\n    }\n    let truncation = (x as i64) as f64;\n    if truncation < x {\n        truncation + 1.0\n    } else {\n        truncation\n    }\n}\n\npub fn castom_trunc(x: f64) -> f64 {\n    if x > 0.0 {\n        castom_floor(x)\n    } else {\n        castom_ceil(x)\n    }\n}\n\npub fn castom_fmod(x: f64, y: f64) -> f64 {\n    x - castom_trunc(x / y) * y\n}\n\npub fn castom_sqrt(x: f64) -> f64 {\n    if x.is_nan() || x < 0.0 {\n        return f64::NAN;\n    }\n    if x == 0.0 {\n        return 0.0;\n    }\n    let mut sqrt = x / 2.0;\n    let mut temp = 0.0;\n    while sqrt != temp {\n        temp = sqrt;\n        sqrt = (x / temp + temp) / 2.0;\n    }\n    sqrt\n}\n\npub fn castom_exp(x: f64) -> f64 {\n    let mut sum: f64 = 1.0;\n    let mut cur: f64 = 1.0;\n    let mut n: u32 = 1;\n    while castom_fabs(cur) > EPS_10 {\n        cur *= x / (n as f64);\n        sum += cur;\n        n += 1;\n        // Safety guard against infinite loops on extreme inputs.\n        if n > 10_000 {\n            break;\n        }\n    }\n    sum\n}\n\npub fn castom_log(x: f64) -> f64 {\n    if x.is_nan() || x < 0.0 {\n        return f64::NAN;\n    }\n    if x == 0.0 {\n        return f64::NEG_INFINITY;\n    }\n    if x == 1.0 {\n        return 0.0;\n    }\n\n    let mut a: i64 = 0;\n    let mut c = if x < 1.0 { 1.0 / x } else { x };\n\n    // Reduce c such that final c is in (1/E, 1].\n    loop {\n        c /= S21_M_E;\n        if c <= 1.0 {\n            break;\n        }\n        a += 1;\n    }\n\n    // c is now in (1/E, 1]. Let v = c * E in (1, E].\n    // log(v) = 2 * (z + z^3/3 + z^5/5 + ...) where z = (v-1)/(v+1).\n    // log(c_initial) = log(c_final) + (a + 1) = (log(v) - 1) + (a + 1) = log(v) + a.\n    let v = c * S21_M_E;\n    let z = (v - 1.0) / (v + 1.0);\n    let z2 = z * z;\n    let mut sum = 0.0;\n    let mut term = 2.0 * z;\n    let mut k: f64 = 1.0;\n    let mut prev = sum + 1.0;\n    while sum != prev {\n        prev = sum;\n        sum += term / k;\n        term *= z2;\n        k += 2.0;\n    }\n\n    let total = a as f64 + sum;\n    if x < 1.0 {\n        -total\n    } else {\n        total\n    }\n}\n\npub fn castom_pow(base: f64, exp: f64) -> f64 {\n    if base == 0.0 && exp != 0.0 {\n        return 0.0;\n    }\n    if exp < 0.0 {\n        return castom_pow(1.0 / base, -exp);\n    }\n    let exp_int = exp as i64;\n    if base < 0.0 && exp != exp_int as f64 {\n        return f64::NAN;\n    }\n    if exp == 0.0 {\n        return 1.0;\n    }\n    let mut flag = 1.0;\n    if base < 0.0 && exp_int % 2 != 0 {\n        flag = -1.0;\n    }\n    let mut b = base;\n    if b < 0.0 {\n        b = -b;\n    }\n    let div = exp_int;\n    let mut integer_part: f64 = 1.0;\n    for _ in 0..div {\n        integer_part *= b;\n    }\n    integer_part * castom_exp((exp - div as f64) * castom_log(b)) * flag\n}\n\npub fn castom_sin(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut sum: f64 = 0.0;\n    for i in 0..=20i32 {\n        let mut fa: f64 = 1.0;\n        let mut p: f64 = 1.0;\n        for j in 1..=(2 * i + 1) {\n            fa *= j as f64;\n            p *= x;\n        }\n        let sign = if i % 2 != 0 { -1.0 } else { 1.0 };\n        sum += (sign / fa) * p;\n    }\n    sum\n}\n\npub fn castom_cos(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut t_s: f64 = 0.0;\n    let mut last: f64 = 1.0;\n    let mut k: f64 = 1.0;\n    while castom_fabs(last) > EPS_10 {\n        t_s += last;\n        last *= -x * x / (2.0 * k - 1.0) / (2.0 * k);\n        k += 1.0;\n    }\n    t_s\n}\n\npub fn castom_tan(x: f64) -> f64 {\n    if x == 0.0 {\n        0.0\n    } else if S21_M_PI / 6.0 == x {\n        1.0 / castom_sqrt(3.0)\n    } else if S21_M_PI / 4.0 == x {\n        1.0\n    } else if S21_M_PI / 3.0 == x {\n        castom_sqrt(3.0)\n    } else if S21_M_PI / 2.0 == x {\n        S21_INFINITY\n    } else if S21_M_PI == x {\n        0.0\n    } else if 3.0 * S21_M_PI / 2.0 == x {\n        S21_INFINITY\n    } else if 2.0 * S21_M_PI == x {\n        0.0\n    } else {\n        castom_sin(x) / castom_cos(x)\n    }\n}\n\npub fn castom_asin(x: f64) -> f64 {\n    if x == 1.0 {\n        return S21_M_PI / 2.0;\n    }\n    if x == -1.0 {\n        return -S21_M_PI / 2.0;\n    }\n    if !(-1.0 < x && x < 1.0) {\n        return f64::NAN;\n    }\n    let mut term: f64 = x;\n    let mut sum: f64 = term;\n    let x2 = x * x;\n    let mut k: f64 = 1.0;\n    while castom_fabs(term) > EPS_10 {\n        term *= x2 * k / (k + 1.0);\n        sum += term / (k + 2.0);\n        k += 2.0;\n    }\n    sum\n}\n\npub fn castom_acos(x: f64) -> f64 {\n    S21_M_PI / 2.0 - castom_asin(x)\n}\n\npub fn castom_atan(x: f64) -> f64 {\n    castom_asin(x / castom_sqrt(1.0 + x * x))\n}\n\npub fn castom_factorial(n: u64) -> u64 {\n    let mut result: u64 = 1;\n    let mut i: u64 = 1;\n    while i <= n {\n        result = result.wrapping_mul(i);\n        i += 1;\n    }\n    result\n}\n","structuredPatch":[{"oldStart":76,"oldLines":19,"newStart":76,"newLines":58,"lines":[" }"," "," pub fn castom_exp(x: f64) -> f64 {","+    if x.is_nan() {","+        return f64::NAN;","+    }","+    if x == f64::INFINITY {","+        return f64::INFINITY;","+    }","+    if x == f64::NEG_INFINITY || x < -745.0 {","+        return 0.0;","+    }","+    if x > 710.0 {","+        return f64::INFINITY;","+    }","+","+    // Range reduction: x = k*ln2 + r where |r| <= ln2/2.","+    // Use the standard fdlibm two-part split of ln2 so that kf * LN2_HI is","+    // exactly representable for small kf, avoiding catastrophic cancellation.","+    const LN2_HI: f64 = 6.93147180369123816490e-01;","+    const LN2_LO: f64 = 1.90821492927058770002e-10;","+    const INV_LN2: f64 = 1.44269504088896338700e+00;","+","+    let kf = (x * INV_LN2).round();","+    let k = kf as i64;","+    let r = (x - kf * LN2_HI) - kf * LN2_LO;","+","+    // exp(r) via Taylor series — r is small (|r| <= ln2/2 ≈ 0.347).","     let mut sum: f64 = 1.0;","-    let mut cur: f64 = 1.0;","+    let mut term: f64 = 1.0;","     let mut n: u32 = 1;","-    while castom_fabs(cur) > EPS_10 {","-        cur *= x / (n as f64);","-        sum += cur;","+    while castom_fabs(term) > EPS_10 * 1e-6 {","+        term *= r / (n as f64);","+        sum += term;","         n += 1;","-        // Safety guard against infinite loops on extreme inputs.","-        if n > 10_000 {","+        if n > 100 {","             break;","         }","     }","-    sum","+","+    // Multiply by 2^k (exa