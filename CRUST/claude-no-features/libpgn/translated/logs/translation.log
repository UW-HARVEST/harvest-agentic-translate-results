wn);\n47\t    assert_eq!(mv.captures, true);\n48\t    assert_eq!(mv.from.file, Some('b'));\n49\t    assert_eq!(mv.from.rank, None);\n50\t    assert_eq!(mv.dest.file, Some('a'));\n51\t    assert_eq!(mv.dest.rank, Some(8));\n52\t    assert_eq!(mv.check, PgnCheck::None);\n53\t    assert_eq!(mv.promoted_to, PgnPiece::Queen);\n54\t    assert_eq!(mv.notation, \"bxa8=Q??\");\n55\t    assert_eq!(mv.annotation, PgnAnnotation::Blunder);\n56\t\n57\t    mv = PgnMove::from(\"Bxg2\");\n58\t    assert_eq!(mv.piece, PgnPiece::Bishop);\n59\t    assert_eq!(mv.captures, true);\n60\t    assert_eq!(mv.from.file, None);\n61\t    assert_eq!(mv.from.rank, None);\n62\t    assert_eq!(mv.dest.file, Some('g'));\n63\t    assert_eq!(mv.dest.rank, Some(2));\n64\t    assert_eq!(mv.check, PgnCheck::None);\n65\t    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n66\t    assert_eq!(mv.notation, \"Bxg2\");\n67\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n68\t\n69\t    mv = PgnMove::from(\"exf2+!\");\n70\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n71\t    assert_eq!(mv.captures, true);\n72\t    assert_eq!(mv.from.file, Some('e'));\n73\t    assert_eq!(mv.from.rank, None);\n74\t    assert_eq!(mv.dest.file, Some('f'));\n75\t    assert_eq!(mv.dest.rank, Some(2));\n76\t    assert_eq!(mv.check, PgnCheck::Single);\n77\t    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n78\t    assert_eq!(mv.notation, \"exf2+!\");\n79\t    assert_eq!(mv.annotation, PgnAnnotation::GoodMove);\n80\t\n81\t    mv = PgnMove::from(\"O-O+!!\");\n82\t    assert_eq!(mv.castles, PGN_CASTLING_KINGSIDE);\n83\t    assert_eq!(mv.check, PgnCheck::Single);\n84\t    assert_eq!(mv.notation, \"O-O+!!\");\n85\t    assert_eq!(mv.annotation, PgnAnnotation::BrilliantMove);\n86\t\n87\t    mv = PgnMove::from(\"O-O-O\");\n88\t    assert_eq!(mv.castles, PGN_CASTLING_QUEENSIDE);\n89\t    assert_eq!(mv.check, PgnCheck::None);\n90\t    assert_eq!(mv.notation, \"O-O-O\");\n91\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n92\t}\n93\t\n