\n415\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n416\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n417\t    assert_eq!(moves.values[1].white.dest.rank, Some(4));\n418\t    assert_eq!(moves.values[1].white.notation, \"Nc4\");\n419\t    assert!(!moves.values[1].white.en_passant);\n420\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n421\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n422\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n423\t    assert_eq!(moves.values[1].black.notation, \"Nc6\");\n424\t    assert!(!moves.values[1].black.en_passant);\n425\t\n426\t    assert_eq!(moves.values[2].white.piece, PgnPiece::Pawn);\n427\t    assert_eq!(moves.values[2].white.from.file, Some('c'));\n428\t    assert_eq!(moves.values[2].white.dest.file, Some('b'));\n429\t    assert_eq!(moves.values[2].white.dest.rank, Some(3));\n430\t    assert_eq!(moves.values[2].white.notation, \"cxb3 e.p.\");\n431\t    assert!(moves.values[2].white.en_passant);\n432\t    assert_eq!(moves.values[2].black.piece, PgnPiece::Bishop);\n433\t    assert_eq!(moves.values[2].black.dest.file, Some('e'));\n434\t    assert_eq!(moves.values[2].black.dest.rank, Some(4));\n435\t    assert_eq!(moves.values[2].black.notation, \"Be4\");\n436\t    assert!(!moves.values[2].black.en_passant);\n437\t}\n438\t\n439\t#[test]\n440\tfn test_parsing_moves_with_alternatives() {\n441\t    let mut moves: PgnMoves;\n442\t\n443\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5\");\n444\t    assert_eq!(moves.values.len(), 1);\n445\t    assert_eq!(\n446\t        moves.values[0]\n447\t            .white\n448\t            .alternatives\n449\t            .as_ref()\n450\t            .unwrap()\n451\t            .values\n452\t            .len(),\n453\t        1\n454\t    );\n455\t    assert_eq!(\n456\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n457\t            .white\n458\t            .notation,\n459\t        \"f4?\"\n460\t    );\n461\t    assert_eq!(\n462\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n463\t            .black\n464\t            .notation,\n465\t        \"e5!\"\n466\t    );\n467\t    assert_eq!(\n468\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n469\t            .white\n470\t            .notation,\n471\t        \"g4??\"\n472\t    );\n473\t    assert_eq!(\n474\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n475\t            .black\n476\t            .notation,\n477\t        \"Qh4#\"\n478\t    );\n479\t\n480\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) (1. e4 f6? 2. d4 g5?? 3. Qh5#) e5\");\n481\t    assert_eq!(moves.values.len(), 1);\n482\t    assert_eq!(\n483\t        moves.values[0]\n484\t            .white\n485\t            .alternatives\n486\t            .as_ref()\n487\t            .unwrap()\n488\t            .values\n489\t            .len(),\n490\t        2\n491\t    );\n492\t    assert_eq!(\n493\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n494\t            .white\n495\t            .notation,\n496\t        \"f4?\"\n497\t    );\n498\t    assert_eq!(\n499\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n500\t            .black\n501\t            .notation,\n502\t        \"e5!\"\n503\t    );\n504\t    assert_eq!(\n505\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n506\t            .white\n507\t            .notation,\n508\t        \"g4??\"\n509\t    );\n510\t    assert_eq!(\n511\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n512\t            .black\n513\t            .notation,\n514\t        \"Qh4#\"\n515\t    );\n516\t    assert_eq!(\n517\t        moves.values[0].white.alternatives.as_ref().unwrap().values[1].values[0]\n518\t            .white\n519\t            .notation,\n520\t        \"e4\