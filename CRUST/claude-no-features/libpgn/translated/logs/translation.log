t_eq!(moves.values[1].white.notation, \"Nc6\");\n584\t    assert_eq!(moves.values[1].black.notation, \"Nf4\");\n585\t}\n586\t\n587\t#[test]\n588\tfn test_parsing_ambiguate_moves() {\n589\t    let mut moves: PgnMoves;\n590\t\n591\t    moves = PgnMoves::from(\"1. Rdf8 R1a3\");\n592\t    assert_eq!(moves.values[0].white.notation, \"Rdf8\");\n593\t    assert_eq!(moves.values[0].white.from.file, Some('d'));\n594\t    assert_eq!(moves.values[0].white.from.rank, None);\n595\t    assert_eq!(moves.values[0].white.dest.file, Some('f'));\n596\t    assert_eq!(moves.values[0].white.dest.rank, Some(8));\n597\t\n598\t    assert_eq!(moves.values[0].black.notation, \"R1a3\");\n599\t    assert_eq!(moves.values[0].black.from.file, None);\n600\t    assert_eq!(moves.values[0].black.from.rank, Some(1));\n601\t    assert_eq!(moves.values[0].black.dest.file, Some('a'));\n602\t    assert_eq!(moves.values[0].black.dest.rank, Some(3));\n603\t\n604\t    moves = PgnMoves::from(\"1. Qh4e1\");\n605\t    assert_eq!(moves.values[0].white.notation, \"Qh4e1\");\n606\t    assert_eq!(moves.values[0].white.from.file, Some('h'));\n607\t    assert_eq!(moves.values[0].white.from.rank, Some(4));\n608\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n609\t    assert_eq!(moves.values[0].white.dest.rank, Some(1));\n610\t}\n611\t\n612\t#[test]\n613\tfn test_dump_move() {\n614\t    let mut mv: PgnMove;\n615\t    let mut written: usize;\n616\t\n617\t    mv = PgnMove {\n618\t        annotation: PgnAnnotation::Unknown,\n619\t        piece: PgnPiece::Pawn,\n620\t        dest: PgnCoordinate {\n621\t            file: Some('e'),\n622\t            rank: Some(4),\n623\t        },\n624\t        ..Default::default()\n625\t    };\n626\t    assert_eq!(mv.to_string(), \"e4\");\n627\t\n628\t    mv = PgnMove {\n629\t        annotation: PgnAnnotation::Unknown,\n630\t        piece: PgnPiece::Rook,\n631\t        dest: PgnCoordinate {\n632\t            file: Some('e'),\n633\t            rank: Some(4),\n634\t        },\n