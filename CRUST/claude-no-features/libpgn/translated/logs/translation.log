{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FKG62zfKWfRFBkzWYo6gfg","type":"tool_result","content":"1\t#include \"extra/suite6.h\"\n2\t\n3\t#include <pgn.h>\n4\t#include <string.h>\n5\t\n6\tvoid test_parsing_moves_with_annotation()\n7\t{\n8\t    pgn_moves_t *moves;\n9\t\n10\t    moves = pgn_moves_from_string(\"1. a4?? a5!\");\n11\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_BLUNDER);\n12\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_GOOD_MOVE);\n13\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4??\"));\n14\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5!\"));\n15\t    pgn_moves_cleanup(moves);\n16\t\n17\t    moves = pgn_moves_from_string(\"1. a4!! a5?!\");\n18\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_BRILLIANT_MOVE);\n19\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_DUBIOUS_MOVE);\n20\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4!!\"));\n21\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5?!\"));\n22\t    pgn_moves_cleanup(moves);\n23\t}\n24\t\n25\tvoid test_parsing_moves_with_NAG_annotation()\n26\t{\n27\t    pgn_moves_t *moves;\n28\t\n29\t    moves = pgn_moves_from_string(\"1. a4 $4 a5 $1\");\n30\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_BLUNDER);\n31\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_GOOD_MOVE);\n32\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4 $4\"));\n33\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5 $1\"));\n34\t    pgn_moves_cleanup(moves);\n35\t\n36\t    moves = pgn_moves_from_string(\"1. a4 $69 a5 $420\");\n37\t    suite6_assert(moves->values[0].white.annotation == 69);\n38\t    suite6_assert(moves->values[0].black.annotation == 420);\n39\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4 $69\"));\n40\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5 $420\"));\n41\t    pgn_moves_cleanup(moves);\n42\t\n43\t    moves = pgn_moves_from_string(\"6. Nce2 $2 e5 $0 $19 {}\");\n44\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_MISTAKE);\n45\t    suite6_assert(moves->values[0].black.annotation == 19);\n46\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"Nce2 $2\"));\n47\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"e5 $0 $19\"));\n48\t    pgn_moves_cleanup(moves);\n49\t}\n50\t\n51\tint main(void)\n52\t{\n53\t    test_parsing_moves_with_annotation();\n54\t    test_parsing_moves_with_NAG_annotation();\n55\t    return 0;\n56\t}\n57\t"}]},"parent_tool_use_id":null,"session_id":"d062af76-af63-42c4-bd64-d4aad1691c3b","uuid":"fca60e97-31d2-4d98-ade6-0a4c40dd4883","timestamp":"2026-06-06T02:37:33.601Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-Q9CrkX/project/c_src/tests/annotation.c","content":"#include \"extra/suite6.h\"\n\n#include <pgn.h>\n#include <string.h>\n\nvoid test_parsing_moves_with_annotation()\n{\n    pgn_moves_t *moves;\n\n    moves = pgn_moves_from_string(\"1. a4?? a5!\");\n    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_BLUNDER);\n    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_GOOD_MOVE);\n    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4??\"));\n    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5!\"));\n    pgn_moves_cleanup(moves);\n\n    moves = pgn_moves_from_string(\"1. a4!! a5?!\");\n    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_BRILLIANT_MOVE);\n    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_DUBIOUS_MOVE);\n    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4!!\"));\n    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5?!\"));\n    pgn_moves_cleanup(moves);\n}\n\nvoid test_parsing_moves_with_NAG_annotation()\n{\n    pgn_moves_t *moves;\n\n    moves = pgn_moves_from_string(\"1. a4 $4 a5 $1\");\n    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_BLUNDER);\n    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_GOOD_MOVE);\n    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4 $4\"));\n    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5 $1\"));\n    pgn_moves_cleanup(moves);\n\n    moves = pgn_moves_from_string(\"1. a4 $69 a5 $420\");\n    suite6_assert(moves->values[0].white.annotation == 69);\n    suite6_assert(moves->values[0].black.annotation == 420);\n    suite6_assert(!strcmp(moves->values[0].white.notation, \"a4 $69\"));\n    suite6_assert(!strcmp(moves->values[0].black.notation, \"a5 $420\"));\n    pgn_moves_cleanup(moves);\n\n    moves = pgn_moves_from_string(\"6. Nce2 $2 e5 $0 $19 {}\");\n    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_MISTAKE);\n    suite6_assert(moves->values[0].black.annotation == 19);\n    suite6_assert(!strcmp(moves->values[0].white.notation, \"Nce2 $2\"));\n    suite6_assert(!strcmp(moves->values[0].black.notation, \"e5 $0 $19\"));\n    pgn_moves_cleanup(moves);\n}\n\nint main(void)\n{\n    test_parsing_moves_with_annotation();\n    test_parsing_moves_with_NAG_annotation();\n    return 0;\n}\n","numLines":57,"startLine":1,"totalLines":57}}}
