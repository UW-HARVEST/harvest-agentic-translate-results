, lex::test_ttype_one_char\n36\t//       - list::{create_list, ladd_element, lget_element, destroy_list}\n37\t//       - hashmap::{test_hash_init, test_hash_init_and_store, test_hash_set_and_get, test_hash_set_and_double_get}\n38\t//\n39\t// 8) We also replicate the test “setup” and “cleanup” prints, corresponding to testing_module_setup()\n40\t//    and testing_module_cleanup(). In C, these were macros that print a message; in Rust, we'll\n41\t//    define simple helper functions.\n42\t//\n43\t// 9) We place all of these tests into a single Rust file test_main.rs (enclosed here) with the\n44\t//    required “use jccc::filename;” format, strictly converting the logic from C to Rust.\n45\t//\n46\t// 10) The resulting Rust code (below) compiles into an executable that runs the same test\n47\t//     sequence as the original C code.\n48\t//\n49\t// -----------------------------------------------------------------------------\n50\t\n51\tuse jccc::codegen;\n52\tuse jccc::lex::{ttype_many_chars, ttype_one_char, ttype_name, ttype_from_string};\n53\tuse jccc::token::TokenType;\n54\tuse jccc::list;\n55\tuse jccc::hashmap;\n56\t/// Tests initializing the Hashmap.\n57\tpub fn test_hash_init() -> i32 {\n58\tlet h = hashmap::create_hashmap(100);\n59\tassert_eq!(h.size, 0);\n60\tassert_eq!(h.cap, 100);\n61\t0\n62\t}\n63\t    \n64\t/// Tests initializing the Hashmap and storing a value.\n65\tpub fn test_hash_init_and_store() -> i32 {\n66\tlet mut h = hashmap::create_hashmap(100);\n67\tassert_eq!(h.size, 0);\n68\tassert_eq!(h.cap, 100);\n69\tlet name = \"jake\".to_string();\n70\tlet key = \"test\".to_string();\n71\t\n72\tlet ret = hashmap::hm_set(&mut h, &key, Box::new(name.clone()));\n73\tassert_ne!(ret, -1);\n74\t\n75\tlet ind = ((h.hash)(&key) % (h.cap as u32)) as usize;\n76\tlet b = h.buckets[ind].as_ref().unwrap();\n77\tassert_eq!(b.key, key);\n78\tassert_eq!(h.size, 1);\n79\tassert_eq!(h.cap, 100);\n80\t0\n81\t}\n82\t\n83\t/// Tests setting and then getting a value in the Hash