{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014w9V6t1Rr7GidThJibNp8S","type":"tool_result","content":"1\t/*\n2\t FVN-1a and multi-word variant.\n3\t <http://www.isthe.com/chongo/tech/comp/fnv/#FNV-1a>\n4\t\n5\t Compile with `-DMULTI_WORD` argument the experimental version.\n6\t\n7\t The driver program takes the following arguments:\n8\t $ ./a.out input_src [key_len] [num_iter]\n9\t\n10\t The \"avalanche\" matrix is dumped to stdout as a whitespace-delimited table.\n11\t */\n12\t\n13\t#include \"avalanche.h\"\n14\t#include <stdlib.h>\n15\t\n16\t#ifndef MULTI_WORD\n17\t\n18\tconst size_t hash_words = 1;\n19\t\n20\tvoid fnv_1a(char *key, size_t key_len, uint32_t* value)\n21\t{\n22\t    uint32_t hash = 0x811c9dc5;\n23\t    for (size_t i = 0; i < key_len; ++i) {\n24\t        hash ^= key[i];\n25\t        hash *= 0x01000193;\n26\t    }\n27\t    *value = hash;\n28\t}\n29\t\n30\t#else\n31\t\n32\tconst size_t hash_words = 4;\n33\t\n34\tvoid fnv_1a(char* key, size_t key_len, uint32_t* value)\n35\t{\n36\t    uint32_t hash[4] = {\n37\t        0x6295c58d, 0x62b82175, 0x07bb0142, 0x6c62272e\n38\t    };\n39\t\n40\t    for (size_t i = 0; i < key_len; ++i) {\n41\t        hash[i % 4] ^= key[i];\n42\t        hash[i % 4] *= 0x01000193;\n43\t    }\n44\t    value[0] = hash[0];\n45\t    value[1] = hash[1];\n46\t    value[2] = hash[2];\n47\t    value[3] = hash[3];\n48\t}\n49\t\n50\t#endif // MULTI_WORD\n51\t\n52\tint main(int argc, char** argv)\n53\t{\n54\t    if (argc == 1) {\n55\t        fprintf(stderr, \"must specify data source; see README\\n\");\n56\t        return 0;\n57\t    }\n58\t    char* in_name = argv[1];\n59\t    size_t key_len = (argc > 2) ? atoi(argv[2]) : 16;\n60\t    size_t max_iter = (argc > 3) ? atoi(argv[3]) : 10000;\n61\t    FILE* ins = fopen(in_name, \"r\");\n62\t\n63\t    if (ins == NULL) {\n64\t        fprintf(stderr, \"cannot open %s\\n\", in_name);\n65\t        return 1;\n66\t    }\n67\t\n68\t    matrix_t* results = matrix_alloc(key_len * 8, hash_words * 32);\n69\t\n70\t    avalanche(&fnv_1a, ins, max_iter, results);\n71\t    fclose(ins);\n72\t    \n73\t    matrix_fprintf(stdout, \"% 6.4g\", results);\n74\t\n75\t    matrix_free(results);\n76\t    return 0;\n77\t}\n78\t"}]},"parent_tool_use_id":null,"session_id":"665b7bf4-abff-4cd6-a872-b9276b9f1e6d","uuid":"40f96802-e409-48a2-a8f3-1890b0c44f23","timestamp":"2026-06-05T21:16:51.147Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-rdr7ww/project/c_src/tests/fnv_1a.c","content":"/*\n FVN-1a and multi-word variant.\n <http://www.isthe.com/chongo/tech/comp/fnv/#FNV-1a>\n\n Compile with `-DMULTI_WORD` argument the experimental version.\n\n The driver program takes the following arguments:\n $ ./a.out input_src [key_len] [num_iter]\n\n The \"avalanche\" matrix is dumped to stdout as a whitespace-delimited table.\n */\n\n#include \"avalanche.h\"\n#include <stdlib.h>\n\n#ifndef MULTI_WORD\n\nconst size_t hash_words = 1;\n\nvoid fnv_1a(char *key, size_t key_len, uint32_t* value)\n{\n    uint32_t hash = 0x811c9dc5;\n    for (size_t i = 0; i < key_len; ++i) {\n        hash ^= key[i];\n        hash *= 0x01000193;\n    }\n    *value = hash;\n}\n\n#else\n\nconst size_t hash_words = 4;\n\nvoid fnv_1a(char* key, size_t key_len, uint32_t* value)\n{\n    uint32_t hash[4] = {\n        0x6295c58d, 0x62b82175, 0x07bb0142, 0x6c62272e\n    };\n\n    for (size_t i = 0; i < key_len; ++i) {\n        hash[i % 4] ^= key[i];\n        hash[i % 4] *= 0x01000193;\n    }\n    value[0] = hash[0];\n    value[1] = hash[1];\n    value[2] = hash[2];\n    value[3] = hash[3];\n}\n\n#endif // MULTI_WORD\n\nint main(int argc, char** argv)\n{\n    if (argc == 1) {\n        fprintf(stderr, \"must specify data source; see README\\n\");\n        return 0;\n    }\n    char* in_name = argv[1];\n    size_t key_len = (argc > 2) ? atoi(argv[2]) : 16;\n    size_t max_iter = (argc > 3) ? atoi(argv[3]) : 10000;\n    FILE* ins = fopen(in_name, \"r\");\n\n    if (ins == NULL) {\n        fprintf(stderr, \"cannot open %s\\n\", in_name);\n        return 1;\n    }\n\n    matrix_t* results = matrix_alloc(key_len * 8, hash_words * 32);\n\n    avalanche(&fnv_1a, ins, max_iter, results);\n    fclose(ins);\n    \n    matrix_fprintf(stdout, \"% 6.4g\", results);\n\n    matrix_free(results);\n    return 0;\n}\n","numLines":78,"startLine":1,"totalLines":78}}}
