{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01THvjKN9ZcxxzECSEAFfVh4","type":"tool_result","content":"1\t#ifndef CB_MERKLE_TREE_H_\n2\t#define CB_MERKLE_TREE_H_\n3\t\n4\t#include <stdbool.h>\n5\t#include <string.h>\n6\t#include <stdint.h>\n7\t\n8\t/* CBMT_NODE_I32 is for test purpose */\n9\t#ifdef CBMT_NODE_I32\n10\t#define CBMT_NODE_SIZE 4\n11\t#else\n12\t#define CBMT_NODE_SIZE 32\n13\t#endif\n14\t\n15\t#define CBMT_ERROR_OVER_CAPACITY -1\n16\t#define CBMT_ERROR_QUEUE_EMPTY -2\n17\t#define CBMT_ERROR_PROOF_ROOT -3\n18\t#define CBMT_ERROR_BUILD_PROOF -4\n19\t#define CBMT_ERROR_INVALID_CAPACITY -5\n20\t#define CBMT_ERROR_VERIFY_FAILED -6\n21\t/* This happend only when have bug */\n22\t#define CBMT_FATAL_BUILD_PROOF -99\n23\t\n24\t#define cbmt_is_left(index)  (((index) & 1) == 1)\n25\t#define cbmt_parent(index)   ((index) == 0 ? 0 : ((index) - 1) >> 1)\n26\t#define cbmt_sibling(index)  ((index) == 0 ? 0 : ((index + 1) ^ 1) - 1)\n27\t\n28\ttypedef int (*cbmt_cmp_fn)(const void *, const void *);\n29\t\n30\tvoid cbmt_universal_swap(void *left, void *right, size_t width) {\n31\t  uint8_t tmp[128];\n32\t  size_t length;\n33\t  while (width) {\n34\t    length = sizeof(tmp) < width ? sizeof(tmp) : width;\n35\t    memcpy(tmp, left, length);\n36\t    memcpy(left, right, length);\n37\t    memcpy(right, tmp, length);\n38\t    left += length;\n39\t    right += length;\n40\t    width -= length;\n41\t  }\n42\t}\n43\tvoid cbmt_simple_bubble_sort(void *base, size_t length, size_t width, cbmt_cmp_fn cmp) {\n44\t  for (size_t i = 0; i < length - 1; i++) {\n45\t    for (size_t j = i + 1; j < length; j++) {\n46\t      void *left = base + (i * width);\n47\t      void *right = base + (j * width);\n48\t      if (cmp(left, right) > 0) {\n49\t        cbmt_universal_swap(left, right, width);\n50\t      }\n51\t    }\n52\t  }\n53\t}\n54\tint cbmt_uint32_reverse_cmp(const void *void_left, const void *void_right) {\n55\t  const uint32_t left = *((const uint32_t *)void_left);\n56\t  const uint32_t right = *((const uint32_t *)void_right);\n57\t  /* reverse order */\n58\t  return right - left;\n59\t}\n60\t\n61\ttypedef struct {\n62\t  void *data;\n63\t  size_t capacity;\n64\t} cbmt_buffer;\n65\t\n66\ttypedef struct {\n67\t  uint8_t bytes[CBMT_NODE_SIZE];\n68\t} cbmt_node;\n69\t\n70\ttypedef struct {\n71\t  uint32_t *values;\n72\t  size_t length;\n73\t  size_t capacity;\n74\t} cbmt_indices;\n75\t\n76\ttypedef struct {\n77\t  cbmt_indices indices;\n78\t  cbmt_node *lemmas;\n79\t  size_t lemmas_length;\n80\t} cbmt_proof;\n81\t\n82\ttypedef struct {\n83\t  cbmt_node *nodes;\n84\t  /* nodes length */\n85\t  size_t length;\n86\t  size_t capacity;\n87\t} cbmt_tree;\n88\t\n89\ttypedef struct {\n90\t  cbmt_node *nodes;\n91\t  size_t length;\n92\t  /* size_t capacity; */\n93\t} cbmt_leaves;\n94\t\n95\t\n96\ttypedef struct {\n97\t  cbmt_buffer buffer;\n98\t  size_t width;\n99\t  size_t length;\n100\t  size_t capacity;\n101\t  /* tail index */\n102\t  size_t tail;\n103\t  /* head index */\n104\t  size_t head;\n105\t} cbmt_queue;\n106\t\n107\ttypedef struct {\n108\t  uint32_t index;\n109\t  cbmt_node node;\n110\t} cbmt_node_pair;\n111\t\n112\t\n113\ttypedef cbmt_node (*cbmt_node_merge_fn)(void *merge_ctx, cbmt_node *left, cbmt_node *right);\n114\t\n115\tvoid cbmt_buffer_init(cbmt_buffer *buffer, void *data, size_t capacity) {\n116\t  buffer->data = data;\n117\t  buffer->capacity = capacity;\n118\t}\n119\tvoid cbmt_leaves_init(cbmt_leaves *leaves, cbmt_node *nodes, size_t length) {\n120\t  leaves->length = length;\n121\t  leaves->nodes = nodes;\n122\t}\n123\tvoid cbmt_indices_init(cbmt_indices *indices, uint32_t *values, size_t length, size_t capacity) {\n124\t  indices->values = values;\n125\t  indices->length = length;\n126\t  indices->capacity = capacity;\n127\t}\n128\t\n129\tint cbmt_queue_init(cbmt_queue *queue,\n130\t                   cbmt_buffer buffer,\n131\t                   size_t width,\n132\t                   size_t capacity) {\n133\t  if (capacity * width > buffer.capacity) {\n134\t    return CBMT_ERROR_OVER_CAPACITY;\n135\t  }\n136\t  if (buffer.capacity % width != 0) {\n137\t    return CBMT_ERROR_INVALID_CAPACITY;\n138\t  }\n139\t  queue->buffer = buffer;\n140\t  queue->capacity = capacity;\n141\t  queue->width = width;\n142\t  queue->length = 0;\n143\t  queue->head = 0;\n144\t  queue->tail = 0;\n145\t  return 0;\n146\t}\n147\t\n148\tint cbmt_queue_push_back(cbmt_queue *queue, void *item) {\n149\t  if (queue->length >= queue->capacity) {\n150\t    return CBMT_ERROR_OVER_CAPACITY;\n151\t  }\n152\t  void *head = queue->buffer.data + (queue->head * queue->width);\n153\t  memcpy(head, item, queue->width);\n154\t  queue->head = (queue->head + 1) % queue->capacity;\n155\t  queue->length += 1;\n156\t  return 0;\n157\t}\n158\t\n159\tint cbmt_queue_push_front(cbmt_queue *queue, void *item) {\n160\t  if (queue->length >= queue->capacity) {\n161\t    return CBMT_ERROR_OVER_CAPACITY;\n162\t  }\n163\t  queue->tail = (queue->tail + queue->capacity - 1) % queue -> capacity;\n164\t  void *tail = queue->buffer.data + (queue->tail * queue->width);\n165\t  memcpy(tail, item, queue->width);\n166\t  queue->length += 1;\n167\t  return 0;\n168\t}\n169\t\n170\tint cbmt_queue_pop_front(cbmt_queue *queue, void *item) {\n171\t  if (queue->length == 0) {\n172\t    return CBMT_ERROR_QUEUE_EMPTY;\n173\t  }\n174\t  void *current_tail = queue->buffer.data + (queue->tail * queue->width);\n175\t  memcpy(item, current_tail, queue->width);\n176\t  queue->tail = (queue->tail + 1) % queue->capacity;\n177\t  queue->length -= 1;\n178\t  return 0;\n179\t}\n180\tvoid* cbmt_queue_front(cbmt_queue *queue) {\n181\t  if (queue->length == 0) {\n182\t    return NULL;\n183\t  }\n184\t  return queue->buffer.data + (queue->tail * queue->width);\n185\t}\n186\t\n187\tvoid cbmt_node_copy(cbmt_node *dest, cbmt_node *src) {\n188\t  memcpy(dest->bytes, src->bytes, CBMT_NODE_SIZE);\n189\t}\n190\tint cbmt_node_cmp(const void *void_left, const void *void_right) {\n191\t  const cbmt_node *left = (const cbmt_node *)void_left;\n192\t  const cbmt_node *right = (const cbmt_node *)void_right;\n193\t#ifdef CBMT_NODE_I32\n194\t  int32_t left_value = *((int32_t *)left->bytes);\n195\t  int32_t right_value = *((int32_t *)right->bytes);\n196\t  return left_value - right_value;\n197\t#else\n198\t  for (int i = 0; i < CBMT_NODE_SIZE; i++) {\n199\t    int cmp_result = left->bytes[i] - right->bytes[i];\n200\t    if (cmp_result != 0) {\n201\t      return cmp_result;\n202\t    }\n203\t  }\n204\t  return 0;\n205\t#endif\n206\t}\n207\t\n208\tint cbmt_node_pair_reverse_cmp(const void *void_left, const void *void_right) {\n209\t  const cbmt_node_pair *left = (const cbmt_node_pair *)void_left;\n210\t  const cbmt_node_pair *right = (const cbmt_node_pair *)void_right;\n211\t  /* reverse order */\n212\t  return right->index - left->index;\n213\t}\n214\t\n215\t\n216\tint cbmt_tree_build_proof(cbmt_proof *proof,\n217\t                          cbmt_tree *tree,\n218\t                          cbmt_indices *leaf_indices,\n219\t                          /* for saving indices in proof */\n220\t                          cbmt_buffer indices_buffer,\n221\t                          /* for saving lemmas in proof */\n222\t                          cbmt_buffer lemmas_buffer) {\n223\t  if (leaf_indices->length * sizeof(uint32_t) > indices_buffer.capacity) {\n224\t    return CBMT_ERROR_OVER_CAPACITY;\n225\t  }\n226\t  if (tree->length == 0 || leaf_indices->length == 0) {\n227\t    return CBMT_ERROR_BUILD_PROOF;\n228\t  }\n229\t  int ret;\n230\t  const uint32_t leaves_count = (uint32_t)((tree->length >> 1) + 1);\n231\t\n232\t  cbmt_queue queue;\n233\t  ret = cbmt_queue_init(&queue,\n234\t                        indices_buffer,\n235\t                        sizeof(uint32_t),\n236\t                        indices_buffer.capacity / sizeof(uint32_t));\n237\t  if (ret != 0) {\n238\t    return ret;\n239\t  }\n240\t  for (size_t i = 0; i < leaf_indices->length; i++) {\n241\t    uint32_t value = leaf_indices->values[i] + (leaves_count - 1);\n242\t    ret = cbmt_queue_push_back(&queue, &value);\n243\t    if (ret != 0) {\n244\t      return ret;\n245\t    }\n246\t  }\n247\t  cbmt_simple_bubble_sort(queue.buffer.data,\n248\t                          leaf_indices->length,\n249\t                          sizeof(uint32_t),\n250\t                          cbmt_uint32_reverse_cmp);\n251\t  uint32_t first_value = *((uint32_t *)cbmt_queue_front(&queue));\n252\t  if (first_value >= ((leaves_count << 1) - 1)) {\n253\t    return CBMT_ERROR_BUILD_PROOF;\n254\t  }\n255\t\n256\t  proof->lemmas = (cbmt_node *)lemmas_buffer.data;\n257\t  proof->lemmas_length = 0;\n258\t  uint32_t index;\n259\t  while (queue.length > 0) {\n260\t    ret = cbmt_queue_pop_front(&queue, &index);\n261\t    if (ret != 0) {\n262\t      return ret;\n263\t    }\n264\t    if (index == 0) {\n265\t      if (queue.length != 0) {\n266\t        return CBMT_FATAL_BUILD_PROOF;\n267\t      }\n268\t      break;\n269\t    }\n270\t\n271\t    uint32_t sibling = cbmt_sibling(index);\n272\t    uint32_t *front = (uint32_t *)cbmt_queue_front(&queue);\n273\t    if (front != NULL && *front == sibling) {\n274\t      uint32_t tmp;\n275\t      ret = cbmt_queue_pop_front(&queue, &tmp);\n276\t      if (ret != 0) {\n277\t        return ret;\n278\t      }\n279\t    } else {\n280\t      cbmt_node *dest_lemma = proof->lemmas + proof->lemmas_length;\n281\t      cbmt_node *src_lemma = tree->nodes + sibling;\n282\t      cbmt_node_copy(dest_lemma, src_lemma);\n283\t      proof->lemmas_length += 1;\n284\t    }\n285\t\n286\t    uint32_t parent = cbmt_parent(index);\n287\t    if (parent != 0) {\n288\t      ret = cbmt_queue_push_back(&queue, &parent);\n289\t      if (ret != 0) {\n290\t        return ret;\n291\t      }\n292\t    }\n293\t  }\n294\t\n295\t  cbmt_indices indices;\n296\t  indices.values = (uint32_t *)indices_buffer.data;\n297\t  indices.length = leaf_indices->length;\n298\t  indices.capacity = indices_buffer.capacity / sizeof(uint32_t);\n299\t  for (size_t i = 0; i < indices.length; i++) {\n300\t    indices.values[i] = leaf_indices->values[i] + (leaves_count - 1);\n301\t  }\n302\t\n303\t  for (size_t i = 0; i < indices.length - 1; i++) {\n304\t    for (size_t j = i + 1; j < indices.length; j++) {\n305\t      uint32_t left_index = indices.values[i];\n306\t      uint32_t right_index = indices.values[j];\n307\t      int order = cbmt_node_cmp(tree->nodes + left_index, tree->nodes + right_index);\n308\t      if (order > 0) {\n309\t        indices.values[i] = right_index;\n310\t        indices.values[j] = left_index;\n311\t      }\n312\t    }\n313\t  }\n314\t  proof->indices = indices;\n315\t  return 0;\n316\t}\n317\t\n318\tcbmt_node cbmt_tree_root(cbmt_tree *tree) {\n319\t  cbmt_node node;\n320\t  if (tree->length == 0) {\n321\t    memset(node.bytes, 0, CBMT_NODE_SIZE);\n322\t  } else {\n323\t    cbmt_node_copy(&node, tree->nodes);\n324\t  }\n325\t  return node;\n326\t}\n327\t\n328\tint cbmt_proof_root(cbmt_proof *proof,\n329\t                    cbmt_node *root,\n330\t                    cbmt_leaves *leaves,\n331\t                    cbmt_node_merge_fn merge,\n332\t                    void *merge_ctx,\n333\t                    /* for saving nodes in cloned leaves */\n334\t                    cbmt_buffer nodes_buffer,\n335\t                    /* for saving (index, node) pairs */\n336\t                    cbmt_buffer pairs_buffer) {\n337\t  if (leaves->length * sizeof(cbmt_node) > nodes_buffer.capacity) {\n338\t    return CBMT_ERROR_OVER_CAPACITY;\n339\t  }\n340\t  if (leaves->length * sizeof(cbmt_node_pair) > pairs_buffer.capacity) {\n341\t    return CBMT_ERROR_OVER_CAPACITY;\n342\t  }\n343\t  if (leaves->length != proof->indices.length || leaves->length == 0) {\n344\t    return CBMT_ERROR_PROOF_ROOT;\n345\t  }\n346\t\n347\t  cbmt_leaves leaves_clone;\n348\t  leaves_clone.nodes = (cbmt_node *)nodes_buffer.data;\n349\t  leaves_clone.length = leaves->length;\n350\t  for (size_t i = 0; i < leaves->length; i++) {\n351\t    cbmt_node_copy(leaves_clone.nodes + i, leaves->nodes + i);\n352\t  }\n353\t  /* sort to align with indices */\n354\t  cbmt_simple_bubble_sort(leaves_clone.nodes,\n355\t                          leaves_clone.length,\n356\t                          sizeof(cbmt_node),\n357\t                          cbmt_node_cmp);\n358\t\n359\t  int ret;\n360\t  cbmt_queue queue;\n361\t  ret = cbmt_queue_init(&queue, pairs_buffer, sizeof(cbmt_node_pair), leaves->length);\n362\t  if (ret != 0) {\n363\t    return ret;\n364\t  }\n365\t  for (size_t i = 0; i < leaves->length; i++) {\n366\t    cbmt_node_pair pair;\n367\t    pair.index = proof->indices.values[i];\n368\t    cbmt_node_copy(&pair.node, leaves_clone.nodes + i);\n369\t    ret = cbmt_queue_push_back(&queue, &pair);\n370\t    if (ret != 0) {\n371\t      return ret;\n372\t    }\n373\t  }\n374\t  cbmt_simple_bubble_sort(queue.buffer.data,\n375\t                          queue.length,\n376\t                          sizeof(cbmt_node_pair),\n377\t                          cbmt_node_pair_reverse_cmp);\n378\t  size_t lemmas_offset = 0;\n379\t  cbmt_node_pair pair_current;\n380\t  cbmt_node_pair pair_sibling;\n381\t  uint32_t index;\n382\t  cbmt_node *node;\n383\t  while (queue.length > 0) {\n384\t    ret = cbmt_queue_pop_front(&queue, &pair_current);\n385\t    if (ret != 0) {\n386\t      return ret;\n387\t    }\n388\t    index = pair_current.index;\n389\t    node = &pair_current.node;\n390\t\n391\t    if (index == 0) {\n392\t      if (proof->lemmas_length == lemmas_offset && queue.length == 0) {\n393\t        cbmt_node_copy(root, node);\n394\t        return 0;\n395\t      } else {\n396\t        return CBMT_ERROR_PROOF_ROOT;\n397\t      }\n398\t    }\n399\t\n400\t    cbmt_node_pair *pair_front = (cbmt_node_pair *)cbmt_queue_front(&queue);\n401\t    cbmt_node *sibling = NULL;\n402\t    if (pair_front != NULL && pair_front->index == cbmt_sibling(index)) {\n403\t      ret = cbmt_queue_pop_front(&queue, &pair_sibling);\n404\t      if (ret != 0) {\n405\t        return ret;\n406\t      }\n407\t      sibling = &pair_sibling.node;\n408\t    } else {\n409\t      if (lemmas_offset < proof->lemmas_length) {\n410\t        sibling = proof->lemmas + lemmas_offset;\n411\t        lemmas_offset += 1;\n412\t      }\n413\t    }\n414\t    if (sibling != NULL) {\n415\t      cbmt_node parent = cbmt_is_left(index)\n416\t        ? merge(merge_ctx, node, sibling)\n417\t        : merge(merge_ctx, sibling, node);\n418\t      cbmt_node_pair pair_parent;\n419\t      pair_parent.index = cbmt_parent(index);\n420\t      pair_parent.node = parent;\n421\t      ret = cbmt_queue_push_back(&queue, &pair_parent);\n422\t      if (ret != 0) {\n423\t        return ret;\n424\t      }\n425\t    }\n426\t  }\n427\t  return 0;\n428\t}\n429\t\n430\tint cbmt_proof_verify(cbmt_proof *proof,\n431\t                      cbmt_node *root,\n432\t                      cbmt_leaves *leaves,\n433\t                      cbmt_node_merge_fn merge,\n434\t                      void *merge_ctx,\n435\t                      /* for saving nodes in cloned leaves */\n436\t                      cbmt_buffer nodes_buffer,\n437\t                      /* for saving (index, node) pairs */\n438\t                      cbmt_buffer pairs_buffer) {\n439\t  cbmt_node target_root;\n440\t  int ret = cbmt_proof_root(proof, &target_root, leaves, merge, merge_ctx, nodes_buffer, pairs_buffer);\n441\t  if (ret != 0) {\n442\t    return ret;\n443\t  }\n444\t  if (memcmp(target_root.bytes, root->bytes, CBMT_NODE_SIZE) != 0) {\n445\t    return CBMT_ERROR_VERIFY_FAILED;\n446\t  }\n447\t  return 0;\n448\t}\n449\t\n450\tint cbmt_build_merkle_root(cbmt_node *root,\n451\t                           cbmt_leaves *leaves,\n452\t                           cbmt_node_merge_fn merge,\n453\t                           void *merge_ctx,\n454\t                           /* for saving nodes in queue */\n455\t                           cbmt_buffer nodes_buffer) {\n456\t  size_t length = leaves->length;\n457\t  if (length == 0) {\n458\t    memset(root->bytes, 0, CBMT_NODE_SIZE);\n459\t    return 0;\n460\t  }\n461\t\n462\t  size_t capacity = (length + 1) >> 1;\n463\t  if (capacity > nodes_buffer.capacity) {\n464\t    return CBMT_ERROR_OVER_CAPACITY;\n465\t  }\n466\t  int ret;\n467\t  cbmt_queue queue;\n468\t  ret = cbmt_queue_init(&queue, nodes_buffer, sizeof(cbmt_node), capacity);\n469\t  if (ret != 0) {\n470\t    return ret;\n471\t  }\n472\t  for (int i = length - 1; i > 0; i -= 2) {\n473\t    cbmt_node *left = leaves->nodes + i - 1;\n474\t    cbmt_node *right = leaves->nodes + i;\n475\t    cbmt_node merged = merge(merge_ctx, left, right);\n476\t    ret = cbmt_queue_push_back(&queue, &merged);\n477\t    if (ret != 0) {\n478\t      return ret;\n479\t    }\n480\t  }\n481\t  if (length % 2 == 1) {\n482\t    ret = cbmt_queue_push_front(&queue, leaves->nodes);\n483\t    if (ret != 0) {\n484\t      return ret;\n485\t    }\n486\t  }\n487\t\n488\t  while (queue.length > 1) {\n489\t    cbmt_node left;\n490\t    cbmt_node right;\n491\t    ret = cbmt_queue_pop_front(&queue, &right);\n492\t    if (ret != 0) {\n493\t      return ret;\n494\t    }\n495\t    ret = cbmt_queue_pop_front(&queue, &left);\n496\t    if (ret != 0) {\n497\t      return ret;\n498\t    }\n499\t    cbmt_node merged = merge(merge_ctx, &left, &right);\n500\t    ret = cbmt_queue_push_back(&queue, &merged);\n501\t    if (ret != 0) {\n502\t      return ret;\n503\t    }\n504\t  }\n505\t  ret = cbmt_queue_pop_front(&queue, root);\n506\t  if (ret != 0) {\n507\t    return ret;\n508\t  }\n509\t  return 0;\n510\t}\n511\t\n512\tint cbmt_build_merkle_tree(cbmt_tree *tree,\n513\t                           cbmt_leaves *leaves,\n514\t                           cbmt_node_merge_fn merge,\n515\t                           void *merge_ctx,\n516\t                           /* for saving nodes in tree */\n517\t                           cbmt_buffer nodes_buffer) {\n518\t  tree->nodes = (cbmt_node *)nodes_buffer.data;\n519\t  tree->capacity = nodes_buffer.capacity / sizeof(cbmt_node);\n520\t  if (leaves->length > 0) {\n521\t    size_t length = leaves->length * 2 - 1;\n522\t    if (length > tree->capacity) {\n523\t      return CBMT_ERROR_OVER_CAPACITY;\n524\t    }\n525\t    tree->length = length;\n526\t\n527\t    size_t offset = leaves->length - 1;\n528\t    for (size_t i = 0; i < leaves->length; i++) {\n529\t      cbmt_node *dest_node = tree->nodes + offset + i;\n530\t      cbmt_node *src_node = leaves->nodes + i;\n531\t      cbmt_node_copy(dest_node, src_node);\n532\t    }\n533\t\n534\t    for (size_t i = 0; i < leaves->length - 1; i++) {\n535\t      size_t rev_idx = leaves->length - 2 - i;\n536\t      cbmt_node *target_node = tree->nodes + rev_idx;\n537\t      cbmt_node *left = tree->nodes + ((rev_idx << 1) + 1);\n538\t      cbmt_node *right = tree->nodes + ((rev_idx << 1) + 2);\n539\t      *target_node = merge(merge_ctx, left, right);\n540\t    }\n541\t  } else {\n542\t    tree->length = 0;\n543\t  }\n544\t  return 0;\n545\t}\n546\t\n547\t/* Allocate memory yourself */\n548\tint cbmt_build_merkle_proof(cbmt_proof *proof,\n549\t                            cbmt_leaves *leaves,\n550\t                            cbmt_indices *leaf_indices,\n551\t                            cbmt_node_merge_fn merge,\n552\t                            void *merge_ctx,\n553\t                            /* for saving nodes in tree */\n554\t                            cbmt_buffer nodes_buffer,\n555\t                            /* for saving indices in proof */\n556\t                            cbmt_buffer indices_buffer,\n557\t                            /* for saving lemmas in proof */\n558\t                            cbmt_buffer lemmas_buffer) {\n559\t  cbmt_tree tree;\n560\t  int ret = cbmt_build_merkle_tree(&tree, leaves, merge, merge_ctx, nodes_buffer);\n561\t  if (ret != 0) {\n562\t    return ret;\n563\t  } else {\n564\t    return cbmt_tree_build_proof(proof, &tree, leaf_indices, indices_buffer, lemmas_buffer);\n565\t  }\n566\t}\n567\t\n568\t#endif /* CB_MERKLE_TREE_H_ */\n569\t"}]},"parent_tool_use_id":null,"session_id":"d0133e68-38d2-4b3d-9a93-0db5e0bf09a7","uuid":"dd612a1b-9037-44ff-ab7e-4c992b34af15","timestamp":"2026-06-06T00:48:00.668Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-yiO6G1/project/c_src/merkle_tree.h","content":"#ifndef CB_MERKLE_TREE_H_\n#define CB_MERKLE_TREE_H_\n\n#include <stdbool.h>\n#include <string.h>\n#include <stdint.h>\n\n/* CBMT_NODE_I32 is for test purpose */\n#ifdef CBMT_NODE_I32\n#define CBMT_NODE_SIZE 4\n#else\n#define CBMT_NODE_SIZE 32\n#endif\n\n#define CBMT_ERROR_OVER_CAPACITY -1\n#define CBMT_ERROR_QUEUE_EMPTY -2\n#define CBMT_ERROR_PROOF_ROOT -3\n#define CBMT_ERROR_BUILD_PROOF -4\n#define CBMT_ERROR_INVALID_CAPACITY -5\n#define CBMT_ERROR_VERIFY_FAILED -6\n/* This happend only when have bug */\n#define CBMT_FATAL_BUILD_PROOF -99\n\n#define cbmt_is_left(index)  (((index) & 1) == 1)\n#define cbmt_parent(index)   ((index) == 0 ? 0 : ((index) - 1) >> 1)\n#define cbmt_sibling(index)  ((index) == 0 ? 0 : ((index + 1) ^ 1) - 1)\n\ntypedef int (*cbmt_cmp_fn)(const void *, const void *);\n\nvoid cbmt_universal_swap(void *left, void *right, size_t width) {\n  uint8_t tmp[128];\n  size_t length;\n  while (width) {\n    length = sizeof(tmp) < width ? sizeof(tmp) : width;\n    memcpy(tmp, left, length);\n    memcpy(left, right, length);\n    memcpy(right, tmp, length);\n    left += length;\n    right += length;\n    width -= length;\n  }\n}\nvoid cbmt_simple_bubble_sort(void *base, size_t length, size_t width, cbmt_cmp_fn cmp) {\n  for (size_t i = 0; i < length - 1; i++) {\n    for (size_t j = i + 1; j < length; j++) {\n      void *left = base + (i * width);\n      void *right = base + (j * width);\n      if (cmp(left, right) > 0) {\n        cbmt_universal_swap(left, right, width);\n      }\n    }\n  }\n}\nint cbmt_uint32_reverse_cmp(const void *void_left, const void *void_right) {\n  const uint32_t left = *((const uint32_t *)void_left);\n  const uint32_t right = *((const uint32_t *)void_right);\n  /* reverse order */\n  return right - left;\n}\n\ntypedef struct {\n  void *data;\n  size_t capacity;\n} cbmt_buffer;\n\ntypedef struct {\n  uint8_t bytes[CBMT_NODE_SIZE];\n} cbmt_node;\n\ntypedef struct {\n  uint32_t *values;\n  size_t length;\n  size_t capacity;\n} cbmt_indices;\n\ntypedef struct {\n  cbmt_indices indices;\n  cbmt_node *lemmas;\n  size_t lemmas_length;\n} cbmt_proof;\n\ntypedef struct {\n  cbmt_node *nodes;\n  /* nodes length */\n  size_t length;\n  size_t capacity;\n} cbmt_tree;\n\ntypedef struct {\n  cbmt_node *nodes;\n  size_t length;\n  /* size_t capacity; */\n} cbmt_leaves;\n\n\ntypedef struct {\n  cbmt_buffer buffer;\n  size_t width;\n  size_t length;\n  size_t capacity;\n  /* tail index */\n  size_t tail;\n  /* head index */\n  size_t head;\n} cbmt_queue;\n\ntypedef struct {\n  uint32_t index;\n  cbmt_node node;\n} cbmt_node_pair;\n\n\ntypedef cbmt_node (*cbmt_node_merge_fn)(void *merge_ctx, cbmt_node *left, cbmt_node *right);\n\nvoid cbmt_buffer_init(cbmt_buffer *buffer, void *data, size_t capacity) {\n  buffer->data = data;\n  buffer->capacity = capacity;\n}\nvoid cbmt_leaves_init(cbmt_leaves *leaves, cbmt_node *nodes, size_t length) {\n  leaves->length = length;\n  leaves->nodes = nodes;\n}\nvoid cbmt_indices_init(cbmt_indices *indices, uint32_t *values, size_t length, size_t capacity) {\n  indices->values = values;\n  indices->length = length;\n  indices->capacity = capacity;\n}\n\nint cbmt_queue_init(cbmt_queue *queue,\n                   cbmt_buffer buffer,\n                   size_t width,\n                   size_t capacity) {\n  if (capacity * width > buffer.capacity) {\n    return CBMT_ERROR_OVER_CAPACITY;\n  }\n  if (buffer.capacity % width != 0) {\n    return CBMT_ERROR_INVALID_CAPACITY;\n  }\n  queue->buffer = buffer;\n  queue->capacity = capacity;\n  queue->width = width;\n  queue->length = 0;\n  queue->head = 0;\n  queue->tail = 0;\n  return 0;\n}\n\nint cbmt_queue_push_back(cbmt_queue *queue, void *item) {\n  if (queue->length >= queue->capacity) {\n    return CBMT_ERROR_OVER_CAPACITY;\n  }\n  void *head = queue->buffer.data + (queue->head * queue->width);\n  memcpy(head, item, queue->width);\n  queue->head = (queue->head + 1) % queue->capacity;\n  queue->length += 1;\n  return 0;\n}\n\nint cbmt_queue_push_front(cbmt_queue *queue, void *item) {\n  if (queue->length >= queue->capacity) {\n    return CBMT_ERROR_OVER_CAPACITY;\n  }\n  queue->tail = (queue->tail + queue->capacity - 1) % queue -> capacity;\n  void *tail = queue->buffer.data + (queue->tail * queue->width);\n  memcpy(tail, item, queue->width);\n  queue->length += 1;\n  return 0;\n}\n\nint cbmt_queue_pop_front(cbmt_queue *queue, void *item) {\n  if (queue->length == 0) {\n    return CBMT_ERROR_QUEUE_EMPTY;\n  }\n  void *current_tail = queue->buffer.data + (queue->tail * queue->width);\n  memcpy(item, current_tail, queue->width);\n  queue->tail = (queue->tail + 1) % queue->capacity;\n  queue->length -= 1;\n  return 0;\n}\nvoid* cbmt_queue_front(cbmt_queue *queue) {\n  if (queue->length == 0) {\n    return NULL;\n  }\n  return queue->buffer.data + (queue->tail * queue->width);\n}\n\nvoid cbmt_node_copy(cbmt_node *dest, cbmt_node *src) {\n  memcpy(dest->bytes, src->bytes, CBMT_NODE_SIZE);\n}\nint cbmt_node_cmp(const void *void_left, const void *void_right) {\n  const cbmt_node *left = (const cbmt_node *)void_left;\n  const cbmt_node *right = (const cbmt_node *)void_right;\n#ifdef CBMT_NODE_I32\n  int32_t left_value = *((int32_t *)left->bytes);\n  int32_t right_value = *((int32_t *)right->bytes);\n  return left_value - right_value;\n#else\n  for (int i = 0; i < CBMT_NODE_SIZE; i++) {\n    int cmp_result = left->bytes[i] - right->bytes[i];\n    if (cmp_result != 0) {\n      return cmp_result;\n    }\n  }\n  return 0;\n#endif\n}\n\nint cbmt_node_pair_reverse_cmp(const void *void_left, const void *void_right) {\n  const cbmt_node_pair *left = (const cbmt_node_pair *)void_left;\n  const cbmt_node_pair *right = (const cbmt_node_pair *)void_right;\n  /* reverse order */\n  return right->index - left->index;\n}\n\n\nint cbmt_tree_build_proof(cbmt_proof *proof,\n                          cbmt_tree *tree,\n                          cbmt_indices *leaf_indices,\n                          /* for saving indices in proof */\n                          cbmt_buffer indices_buffer,\n                          /* for saving lemmas in proof */\n                          cbmt_buffer lemmas_buffer) {\n  if (leaf_indices->length * sizeof(uint32_t) > indices_buffer.capacity) {\n    return CBMT_ERROR_OVER_CAPACITY;\n  }\n  if (tree->length == 0 || leaf_indices->length == 0) {\n    return CBMT_ERROR_BUILD_PROOF;\n  }\n  int ret;\n  const uint32_t leaves_count = (uint32_t)((tree->length >> 1) + 1);\n\n  cbmt_queue queue;\n  ret = cbmt_queue_init(&queue,\n                        indices_buffer,\n                        sizeof(uint32_t),\n                        indices_buffer.capacity / sizeof(uint32_t));\n  if (ret != 0) {\n    return ret;\n  }\n  for (size_t i = 0; i < leaf_indices->length; i++) {\n    uint32_t value = leaf_indices->values[i] + (leaves_count - 1);\n    ret = cbmt_queue_push_back(&queue, &value);\n    if (ret != 0) {\n      return ret;\n    }\n  }\n  cbmt_simple_bubble_sort(queue.buffer.data,\n                          leaf_indices->length,\n                          sizeof(uint32_t),\n                          cbmt_uint32_reverse_cmp);\n  uint32_t first_value = *((uint32_t *)cbmt_queue_front(&queue));\n  if (first_value >= ((leaves_count << 1) - 1)) {\n    return CBMT_ERROR_BUILD_PROOF;\n  }\n\n  proof->lemmas = (cbmt_node *)lemmas_buffer.data;\n  proof->lemmas_length = 0;\n  uint32_t index;\n  while (queue.length > 0) {\n    ret = cbmt_queue_pop_front(&queue, &index);\n    if (ret != 0) {\n      return ret;\n    }\n    if (index == 0) {\n      if (queue.length != 0) {\n        return CBMT_FATAL_BUILD_PROOF;\n      }\n      break;\n    }\n\n    uint32_t sibling = cbmt_sibling(index);\n    uint32_t *front = (uint32_t *)cbmt_queue_front(&queue);\n    if (front != NULL && *front == sibling) {\n      uint32_t tmp;\n      ret = cbmt_queue_pop_front(&queue, &tmp);\n      if (ret != 0) {\n        return ret;\n      }\n    } else {\n      cbmt_node *dest_lemma = proof->lemmas + proof->lemmas_length;\n      cbmt_node *src_lemma = tree->nodes + sibling;\n      cbmt_node_copy(dest_lemma, src_lemma);\n      proof->lemmas_length += 1;\n    }\n\n    uint32_t parent = cbmt_parent(index);\n    if (parent != 0) {\n      ret = cbmt_queue_push_back(&queue, &parent);\n      if (ret != 0) {\n        return ret;\n      }\n    }\n  }\n\n  cbmt_indices indices;\n  indices.values = (uint32_t *)indices_buffer.data;\n  indices.length = leaf_indices->length;\n  indices.capacity = indices_buffer.capacity / sizeof(uint32_t);\n  for (size_t i = 0; i < indices.length; i++) {\n    indices.values[i] = leaf_indices->values[i] + (leaves_count - 1);\n  }\n\n  for (size_t i = 0; i < indices.length - 1; i++) {\n    for (size_t j = i + 1; j < indices.length; j++) {\n      uint32_t left_index = indices.values[i];\n      uint32_t right_index = indices.values[j];\n      int order = cbmt_node_cmp(tree->nodes + left_index, tree->nodes + right_index);\n      if (order > 0) {\n        indices.values[i] = right_index;\n        indices.values[j] = left_index;\n      }\n    }\n  }\n  proof->indices = indices;\n  return 0;\n}\n\ncbmt_node cbmt_tree_root(cbmt_tree *tree) {\n  cbmt_node node;\n  if (tree->length == 0) {\n    memset(node.bytes, 0, CBMT_NODE_SIZE);\n  } else {\n    cbmt_node_copy(&node, tree->nodes);\n  }\n  return node;\n}\n\nint cbmt_proof_root(cbmt_proof *proof,\n                    cbmt_node *root,\n                    cbmt_leaves *leaves,\n                    cbmt_node_merge_fn merge,\n                    void *merge_ctx,\n                    /* for saving nodes in cloned leaves */\n                    cbmt_buffer nodes_buffer,\n                    /* for saving (index, node) pairs */\n                    cbmt_buffer pairs_buffer) {\n  if (leaves->length * sizeof(cbmt_node) > nodes_buffer.capacity) {\n    return CBMT_ERROR_OVER_CAPACITY;\n  }\n  if (leaves->length * sizeof(cbmt_node_pair) > pairs_buffer.capacity) {\n    return CBMT_ERROR_OVER_CAPACITY;\n  }\n  if (leaves->length != proof->indices.length || leaves->length == 0) {\n    return CBMT_ERROR_PROOF_ROOT;\n  }\n\n  cbmt_leaves leaves_clone;\n  leaves_clone.nodes = (cbmt_node *)nodes_buffer.data;\n  leaves_clone.length = leaves->length;\n  for (size_t i = 0; i < leaves->length; i++) {\n    cbmt_node_copy(leaves_clone.nodes + i, leaves->nodes + i);\n  }\n  /* sort to align with indices */\n  cbmt_simple_bubble_sort(leaves_clone.nodes,\n                          leaves_clone.length,\n                          sizeof(cbmt_node),\n                          cbmt_node_cmp);\n\n  int ret;\n  cbmt_queue queue;\n  ret = cbmt_queue_init(&queue, pairs_buffer, sizeof(cbmt_node_pair), leaves->length);\n  if (ret != 0) {\n    return ret;\n  }\n  for (size_t i = 0; i < leaves->length; i++) {\n    cbmt_node_pair pair;\n    pair.index = proof->indices.values[i];\n    cbmt_node_copy(&pair.node, leaves_clone.nodes + i);\n    ret = cbmt_queue_push_back(&queue, &pair);\n    if (ret != 0) {\n      return ret;\n    }\n  }\n  cbmt_simple_bubble_sort(queue.buffer.data,\n                          queue.length,\n                          sizeof(cbmt_node_pair),\n                          cbmt_node_pair_reverse_cmp);\n  size_t lemmas_offset = 0;\n  cbmt_node_pair pair_current;\n  cbmt_node_pair pair_sibling;\n  uint32_t index;\n  cbmt_node *node;\n  while (queue.length > 0) {\n    ret = cbmt_queue_pop_front(&queue, &pair_current);\n    if (ret != 0) {\n      return ret;\n    }\n    index = pair_current.index;\n    node = &pair_current.node;\n\n    if (index == 0) {\n      if (proof->lemmas_length == lemmas_offset && queue.length == 0) {\n        cbmt_node_copy(root, node);\n        return 0;\n      } else {\n        return CBMT_ERROR_PROOF_ROOT;\n      }\n    }\n\n    cbmt_node_pair *pair_front = (cbmt_node_pair *)cbmt_queue_front(&queue);\n    cbmt_node *sibling = NULL;\n    if (pair_front != NULL && pair_front->index == cbmt_sibling(index)) {\n      ret = cbmt_queue_pop_front(&queue, &pair_sibling);\n      if (ret != 0) {\n        return ret;\n      }\n      sibling = &pair_sibling.node;\n    } else {\n      if (lemmas_offset < proof->lemmas_length) {\n        sibling = proof->lemmas + lemmas_offset;\n        lemmas_offset += 1;\n      }\n    }\n    if (sibling != NULL) {\n      cbmt_node parent = cbmt_is_left(index)\n        ? merge(merge_ctx, node, sibling)\n        : merge(merge_ctx, sibling, node);\n      cbmt_node_pair pair_parent;\n      pair_parent.index = cbmt_parent(index);\n      pair_parent.node = parent;\n      ret = cbmt_queue_push_back(&queue, &pair_parent);\n      if (ret != 0) {\n        return ret;\n      }\n    }\n  }\n  return 0;\n}\n\nint cbmt_proof_verify(cbmt_proof *proof,\n                      cbmt_node *root,\n                      cbmt_leaves *leaves,\n                      cbmt_node_merge_fn merge,\n                      void *merge_ctx,\n                      /* for saving nodes in cloned leaves */\n                      cbmt_buffer nodes_buffer,\n                      /* for saving (index, node) pairs */\n                      cbmt_buffer pairs_buffer) {\n  cbmt_node target_root;\n  int ret = cbmt_proof_root(proof, &target_root, leaves, merge, merge_ctx, nodes_buffer, pairs_buffer);\n  if (ret != 0) {\n    return ret;\n  }\n  if (memcmp(target_root.bytes, root->bytes, CBMT_NODE_SIZE) != 0) {\n    return CBMT_ERROR_VERIFY_FAILED;\n  }\n  return 0;\n}\n\nint cbmt_build_merkle_root(cbmt_node *root,\n                           cbmt_leaves *leaves,\n                           cbmt_node_merge_fn merge,\n                           void *merge_ctx,\n                           /* for saving nodes in queue */\n                           cbmt_buffer nodes_buffer) {\n  size_t length = leaves->length;\n  if (length == 0) {\n    memset(root->bytes, 0, CBMT_NODE_SIZE);\n    return 0;\n  }\n\n  size_t capacity = (length + 1) >> 1;\n  if (capacity > nodes_buffer.capacity) {\n    return CBMT_ERROR_OVER_CAPACITY;\n  }\n  int ret;\n  cbmt_queue queue;\n  ret = cbmt_queue_init(&queue, nodes_buffer, sizeof(cbmt_node), capacity);\n  if (ret != 0) {\n    return ret;\n  }\n  for (int i = length - 1; i > 0; i -= 2) {\n    cbmt_node *left = leaves->nodes + i - 1;\n    cbmt_node *right = leaves->nodes + i;\n    cbmt_node merged = merge(merge_ctx, left, right);\n    ret = cbmt_queue_push_back(&queue, &merged);\n    if (ret != 0) {\n      return ret;\n    }\n  }\n  if (length % 2 == 1) {\n    ret = cbmt_queue_push_front(&queue, leaves->nodes);\n    if (ret != 0) {\n      return ret;\n    }\n  }\n\n  while (queue.length > 1) {\n    cbmt_node left;\n    cbmt_node right;\n    ret = cbmt_queue_pop_front(&queue, &right);\n    if (ret != 0) {\n      return ret;\n    }\n    ret = cbmt_queue_pop_front(&queue, &left);\n    if (ret != 0) {\n      return ret;\n    }\n    cbmt_node merged = merge(merge_ctx, &left, &right);\n    ret = cbmt_queue_push_back(&queue, &merged);\n    if (ret != 0) {\n      return ret;\n    }\n  }\n  ret = cbmt_queue_pop_front(&queue, root);\n  if (ret != 0) {\n    return ret;\n  }\n  return 0;\n}\n\nint cbmt_build_merkle_tree(cbmt_tree *tree,\n                           cbmt_leaves *leaves,\n                           cbmt_node_merge_fn merge,\n                           void *merge_ctx,\n                           /* for saving nodes in tree */\n                           cbmt_buffer nodes_buffer) {\n  tree->nodes = (cbmt_node *)nodes_buffer.data;\n  tree->capacity = nodes_buffer.capacity / sizeof(cbmt_node);\n  if (leaves->length > 0) {\n    size_t length = leaves->length * 2 - 1;\n    if (length > tree->capacity) {\n      return CBMT_ERROR_OVER_CAPACITY;\n    }\n    tree->length = length;\n\n    size_t offset = leaves->length - 1;\n    for (size_t i = 0; i < leaves->length; i++) {\n      cbmt_node *dest_node = tree->nodes + offset + i;\n      cbmt_node *src_node = leaves->nodes + i;\n      cbmt_node_copy(dest_node, src_node);\n    }\n\n    for (size_t i = 0; i < leaves->length - 1; i++) {\n      size_t rev_idx = leaves->length - 2 - i;\n      cbmt_node *target_node = tree->nodes + rev_idx;\n      cbmt_node *left = tree->nodes + ((rev_idx << 1) + 1);\n      cbmt_node *right = tree->nodes + ((rev_idx << 1) + 2);\n      *target_node = merge(merge_ctx, left, right);\n    }\n  } else {\n    tree->length = 0;\n  }\n  return 0;\n}\n\n/* Allocate memory yourself */\nint cbmt_build_merkle_proof(cbmt_proof *proof,\n                            cbmt_leaves *leaves,\n                            cbmt_indices *leaf_indices,\n                            cbmt_node_merge_fn merge,\n                            void *merge_ctx,\n                            /* for saving nodes in tree */\n                            cbmt_buffer nodes_buffer,\n                            /* for saving indices in proof */\n                            cbmt_buffer indices_buffer,\n                            /* for saving lemmas in proof */\n                            cbmt_buffer lemmas_buffer) {\n  cbmt_tree tree;\n  int ret = cbmt_build_merkle_tree(&tree, leaves, merge, merge_ctx, nodes_buffer);\n  if (ret != 0) {\n    return ret;\n  } else {\n    return cbmt_tree_build_proof(proof, &tree, leaf_indices, indices_buffer, lemmas_buffer);\n  }\n}\n\n#endif /* CB_MERKLE_TREE_H_ */\n","numLines":569,"startLine":1,"totalLines":569}}}
