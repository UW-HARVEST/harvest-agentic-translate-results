n            mlen = 0;\n        }\n    }\n    mlen\n}\n\npub fn is_string(s: &str, p: &str, len: i32, flg: i32) -> i32 {\n    is_string_bytes(s.as_bytes(), p.as_bytes(), len, flg)\n}\n\npub fn get_close(open: u32) -> u32 {\n    match open {\n        x if x == b'(' as u32 => b')' as u32,\n        x if x == b'[' as u32 => b']' as u32,\n        x if x == b'{' as u32 => b'}' as u32,\n        x if x == b'<' as u32 => b'>' as u32,\n        _ => 0,\n    }\n}\n\npub fn get_qclose(open: u32) -> u32 {\n    match open {\n        x if x == b'\\'' as u32 || x == b'\"' as u32 || x == b'`' as u32 => open,\n        _ => 0,\n    }\n}\n\npub const MATCHED_FAIL: i32 = 0;\npub const MATCHED: i32 = 1;\npub const MATCHED_GOAL: i32 = 2;\npub const MATCHED_GOALNOT: i32 = 3;\nEOF\necho done","description":"Append helpers"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2014,"cache_read_input_tokens":72633,"cache_creation":{"ephemeral_5m_input_tokens":2014,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6e5bcb13-e2c3-42dd-b4eb-2c53091ca91c","uuid":"1aceb8c4-0d33-4531-bde7-49a11870015c"}
