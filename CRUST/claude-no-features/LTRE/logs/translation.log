ccepting) {\n1142\t      arrows[ds1->id][dfa_size].label = malloc(1);\n1143\t      *arrows[ds1->id][dfa_size].label = '\\0';\n1144\t      arrows[ds1->id][dfa_size].prec = SYMSET;\n1145\t    }\n1146\t\n1147\t    for (struct dstate *ds2 = dfa; ds2; ds2 = ds2->next) {\n1148\t      bool empty = true;\n1149\t      symset_t transitions = {0};\n1150\t      for (int chr = 0; chr < 256; chr++)\n1151\t        if (ds1->transitions[chr] == ds2)\n1152\t          bitset_set(transitions, chr), empty = false;\n1153\t\n1154\t      arrows[ds1->id][ds2->id].label = NULL;\n1155\t\n1156\t      if (empty)\n1157\t        continue;\n1158\t\n1159\t      char *fmt = symset_fmt(transitions);\n1160\t      arrows[ds1->id][ds2->id].label = malloc(strlen(fmt) + 1);\n1161\t      strcpy(arrows[ds1->id][ds2->id].label, fmt);\n1162\t      arrows[ds1->id][ds2->id].prec = SYMSET;\n1163\t    }\n1164\t  }\n1165\t\n1166\t  // iteratively select one state according to some heuristic and reroute all\n1167\t  // its inbound and outbound transitions so as to bypass that state, while also\n1168\t  // taking care of self-loops. don't ever select the auxiliary state, so that\n1169\t  // when we're done the final regular expression ends up as a self-loop on the\n1170\t  // auxiliary state. choosing the state with minimal vertex degree seems to\n1171\t  // work okay, sa that's the heuristic we're using\n1172\t  while (1) {\n1173\t    int best_fit;\n1174\t    int min_degree = INT_MAX;\n1175\t    for (int id1 = 0; id1 < dfa_size; id1++) {\n1176\t      int degree = 0;\n1177\t      // double-counts self-loops, which penalizes them, which is probably good\n1178\t      for (int id2 = 0; id2 < dfa_size; id2++)\n1179\t        degree +=\n1180\t            (arrows[id1][id2].label != NULL) + (arrows[id2][id1].label != NULL);\n1181\t      if (degree == 0)\n1182\t        continue; // state has already been processed\n1183\t      if (degree < min_degree)\n1184\t        min_degree = degree, best_fit = id1;\n1185\t    }\n1186\t\n1187\t    if (min_degree == INT_MAX)\n1188\t      break; // all states have been processed\n1189\t\n1190\t    // iterate through all pairs of inbound and outbound transitions, including\n1191\t    // those to and from the auxiliary state\n1192\t    for (int id1 = 0; id1 <= dfa_size; id1++) {\n1193\t      if (id1 == best_fit)\n1194\t        continue; // inbound transition must not be a self-loop\n1195\t      for (int id2 = 0; id2 <= dfa_size; id2++) {\n1196\t        if (id2 == best_fit)\n1197\t          continue; // outbound transition must not be a self-loop\n1198\t        struct arrow in = arrows[id1][best_fit];  // current inbound transition\n1199\t        struct arrow out = arrows[best_fit][id2]; // current outbout transition\n1200\t        struct arrow self = arrows[best_fit][best_fit]; // self-transition\n1201\t        struct arrow existing = arrows[id1][id2]; // existing bypass transition\n1202\t\n1203\t        // (existing)|[](self)(out) == (existing)|(in)(self)[] == (existing)\n1204\t        if (!in.label || !out.label)\n1205\t          continue;\n1206\t\n1207\t        // get rid of the self-transition by concatenating it either onto the\n1208\t        // the inbound or outbound transition\n1209\t        struct arrow first, second;\n1210\t\n1211\t        ptrdiff_t diff;\n1212\t        if (!self.label || !*self.label) {\n1213\t          // (in)[]*(out) == (in)()*(out) == (in)(out)\n1214\t          first = in, second = out;\n1215\t        } else if (in.prec >= CONCAT && self.prec >= CONCAT &&\n1216\t                   (diff = strlen(in.label) - strlen(self.label)) >= 0 &&\n1217\t                   strcmp(in.label + diff, self.label) == 0) {\n1218\t          // hackily try to avoid breaking apart symsets in the inbound arrow\n1219\t          if (diff >= 1 && strchr(\"^-\\\\\", in.label[diff - 1]) &&\n1220\t              (diff == 1 || in.label[diff - 2] != '\\\\'))\n1221\t            goto nevermind; // preserve ^aa* a-zz* \\^a^a* but not \\^aa* \\-aa*\n1222\t   