"\", false);\n198\t    test!(\"a{1,}\", \"a\", true);\n199\t    test!(\"a{1,}\", \"aa\", true);\n200\t    test!(\"a{1,}\", \"aaa\", true);\n201\t    test!(\"a{3,}\", \"aa\", false);\n202\t    test!(\"a{3,}\", \"aaa\", true);\n203\t    test!(\"a{3,}\", \"aaaa\", true);\n204\t    test!(\"a{3,}\", \"aaaaa\", true);\n205\t    test!(\"a{0,2}\", \"\", true);\n206\t    test!(\"a{0,2}\", \"a\", true);\n207\t    test!(\"a{0,2}\", \"aa\", true);\n208\t    test!(\"a{0,2}\", \"aaa\", false);\n209\t    test!(\"a{2}\", \"a\", false);\n210\t    test!(\"a{2}\", \"aa\", true);\n211\t    test!(\"a{2}\", \"aaa\", false);\n212\t    test!(\"a{0}\", \"\", true);\n213\t    test!(\"a{0}\", \"a\", false);\n214\t\n215\t    // partial, ignorecase, complement\n216\t    run_test(&Test {\n217\t        regex: \"\",\n218\t        input: \"\",\n219\t        matches: true,\n220\t        errors: false,\n221\t        partial: true,\n222\t        ignorecase: false,\n223\t        complement: false,\n224\t        quick: false,\n225\t    });\n226\t    run_test(&Test {\n227\t        regex: \"\",\n228\t        input: \"abc\",\n229\t        matches: true,\n230\t        errors: false,\n231\t        partial: true,\n232\t        ignorecase: false,\n233\t        complement: false,\n234\t        quick: false,\n235\t    });\n236\t    run_test(&Test {\n237\t        regex: \"b\",\n238\t        input: \"abc\",\n239\t        matches: true,\n240\t        errors: false,\n241\t        partial: true,\n242\t        ignorecase: false,\n243\t        complement: false,\n244\t        quick: false,\n245\t    });\n246\t    run_test(&Test {\n247\t        regex: \"ba\",\n248\t        input: \"abc\",\n249\t        matches: false,\n250\t        errors: false,\n251\t        partial: true,\n252\t        ignorecase: false,\n253\t        complement: false,\n254\t        quick: false,\n255\t    });\n256\t    run_test(&Test {\n257\t        regex: \"abc\",\n258\t        input: \"abc\",\n259\t        matches: true,\n260\t        errors: fal