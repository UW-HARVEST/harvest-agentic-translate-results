d = !re.complemented;\n        }\n        let _ = alt_states_len;\n    }\n    Ok(re)\n}\n\nfn union_inplace(a: &mut SymSet, b: &SymSet) {\n    a.union_with(b);\n}\nfn intersect_inplace(a: &mut SymSet, b: &SymSet) {\n    a.intersect_with(b);\n}\n","structuredPatch":[{"oldStart":1103,"oldLines":14,"newStart":1103,"newLines":14,"lines":[" }"," "," fn compute_first_second(","-    in_arrow: &(impl ArrowLike),","-    out_arrow: &(impl ArrowLike),","-    self_arrow: &(impl ArrowLike),","+    in_arrow: &DecArrow,","+    out_arrow: &DecArrow,","+    self_arrow: &DecArrow,"," ) -> (DecArrow, DecArrow) {","     // Mirror the C logic for first/second computation in decompile.","-    let in_label = in_arrow.label_str();","-    let out_label = out_arrow.label_str();","-    let self_label_opt = self_arrow.label_opt();","+    let in_label = in_arrow.label.as_deref().unwrap_or(\"\");","+    let out_label = out_arrow.label.as_deref().unwrap_or(\"\");","+    let self_label_opt = self_arrow.label.as_deref();"," ","     if self_label_opt.is_none() || self_label_opt.unwrap().is_empty() {","         return ("]}],"userModified":false,"replaceAll":false}}
