lse,\n    });\n    run_test(&Test {\n        regex: \"a+{}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a?{}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a{}*\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a{}+\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a{}?\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a{}{}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a{2,1}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a{1 2}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a{1, 2}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        par