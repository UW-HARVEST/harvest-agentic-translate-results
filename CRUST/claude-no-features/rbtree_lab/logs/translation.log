(`None` == NIL).\n    pub fn subtree_to_array(\n        &self,\n        curr: Option<NodeRef>,\n        arr: &mut Vec<Key>,\n        n: usize,\n        count: &mut usize,\n    ) {\n        let curr = match curr {\n            Some(c) => c,\n            None => return,\n        };\n\n        let left = curr.borrow().left.clone();\n        self.subtree_to_array(left, arr, n, count);\n\n        if *count < n {\n            arr.push(curr.borrow().key);\n            *count += 1;\n        } else {\n            return;\n        }\n\n        let right = curr.borrow().right.clone();\n        self.subtree_to_array(right, arr, n, count);\n    }\n\n    /// Returns up to `n` keys from the tree in-order.\n    pub fn to_array(&self, n: usize) -> Vec<Key> {\n        let mut arr: Vec<Key> = Vec::new();\n        if self.root.is_none() {\n            return arr;\n        }\n        let mut count: usize = 0;\n        let root = self.root.clone();\n        self.subtree_to_array(root, &mut arr, n, &mut count);\n        arr\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":841,"cache_read_input_tokens":26422,"cache_creation":{"ephemeral_5m_input_tokens":841,"ephemeral_1h_input_tokens":0},"output_tokens":42,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1da5218c-2104-4946-b58a-074f9b42fda7","uuid":"8f84c0f5-0844-4e38-a0ef-d75ae706ba59"}
