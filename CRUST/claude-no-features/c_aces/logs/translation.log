al, 0 otherwise.\n54\t */\n55\tint poly_equal(const Polynomial *, const Polynomial *);\n56\t\n57\t/**\n58\t * @brief Free memory allocated for a polynomial.\n59\t *\n60\t * This function releases the memory allocated for the coefficients array of a\n61\t * polynomial.\n62\t *\n63\t * @param poly Pointer to the polynomial to be freed.\n64\t */\n65\tvoid poly_free(Polynomial *poly);\n66\t\n67\t/**\n68\t * @brief Set coefficients for a polynomial.\n69\t *\n70\t * This function sets the coefficients for a given polynomial structure.\n71\t *\n72\t * @param p Pointer to the polynomial structure.\n73\t * @param coeffs Pointer to an array of coefficients.\n74\t * @param size Size of the coefficients array.\n75\t *\n76\t * @return 0 if successful, -1 if an error occurred.\n77\t */\n78\tint set_polynomial(Polynomial *p, Coeff *coeffs, size_t size);\n79\t\n80\t/**\n81\t * @brief Allocate memory for a polynomial using malloc.\n82\t *\n83\t * This function allocates memory for a polynomial structure using malloc.\n84\t *\n85\t * @param p Pointer to the polynomial structure.\n86\t * @param size Size of the polynomial.\n87\t *\n88\t * @return 0 if successful, -1 if an error occurred.\n89\t */\n90\tint get_polynomial(Polynomial *p, size_t size);\n91\t\n92\tint get_polyarray(PolyArray *p, size_t size);\n93\t\n94\t/**\n95\t * @brief Set all coefficients of a polynomial to zero.\n96\t *\n97\t * This function sets all coefficients of a given polynomial to zero.\n98\t *\n99\t * @param p Pointer to the polynomial structure.\n100\t *\n101\t * @return 0 if successful, -1 if an error occurred.\n102\t */\n103\tint set_zero(const Polynomial *p);\n104\t\n105\t/**\n106\t * @brief Calculate the sum of coefficients in a polynomial.\n107\t *\n108\t * This function calculates the sum of all coefficients in the given polynomial.\n109\t *\n110\t * @param poly Pointer to the polynomial structure.\n111\t *\n112\t * @return The sum of coefficients in the polynomial.\n113\t */\n114\tint64_t coef_sum(cons