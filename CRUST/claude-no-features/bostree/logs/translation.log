8\t\t\t\tprintf(\"Next node is %s, but select (i+1) is %s\\n\", (char*)bostree_next_node(node)->key, (char*)bostree_select(tree, i + 1)->key);\n49\t\t\t\terror = 1;\n50\t\t\t}\n51\t\t\tif(bostree_previous_node(node) != bostree_select(tree, i - 1)) {\n52\t\t\t\tprintf(\"Next node is %s, but select (i+1) is %s\\n\", (char*)bostree_next_node(node)->key, (char*)bostree_select(tree, i + 1)->key);\n53\t\t\t\terror = 1;\n54\t\t\t}\n55\t\t\tif(node->parent_node != NULL) {\n56\t\t\t\tif(node->parent_node->left_child_node != node && node->parent_node->right_child_node != node) {\n57\t\t\t\t\tprintf(\"Node %s has a parent, %s, but is not one of its children.\\n\", (char*)node->key, (char*)node->parent_node->key);\n58\t\t\t\t\terror = 1;\n59\t\t\t\t}\n60\t\t\t}\n61\t\t\tunsigned int depth = _actual_depth(node);\n62\t\t\tif(depth != node->depth) {\n63\t\t\t\tprintf(\"Node %s reports depth %d when the actual depth is %d\\n\", (char *)node->key, node->depth, depth);\n64\t\t\t\terror = 1;\n65\t\t\t}\n66\t\t\tif(node->left_child_node) {\n67\t\t\t\tunsigned left_count = _actual_count(node->left_child_node);\n68\t\t\t\tif(left_count != node->left_child_count) {\n69\t\t\t\t\tprintf(\"Node %s reports %d left children when there are %d\\n\", (char *)node->key, node->left_child_count, left_count);\n70\t\t\t\t\terror = 1;\n71\t\t\t\t}\n72\t\t\t}\n73\t\t\tif(node->right_child_node) {\n74\t\t\t\tunsigned right_count = _actual_count(node->right_child_node);\n75\t\t\t\tif(right_count != node->right_child_count) {\n76\t\t\t\t\tprintf(\"Node %s reports %d right children when there are %d\\n\", (char *)node->key, node->right_child_count, right_count);\n77\t\t\t\t\terror = 1;\n78\t\t\t\t}\n79\t\t\t}\n80\t\t\tunsigned left_depth = node->left_child_node != NULL ? node->left_child_node->depth + 1 : 0;\n81\t\t\tunsigned right_depth = node->right_child_node != NULL ? node->right_child_node->depth + 1 : 0;\n82\t\t\tif(abs((int)left_depth - right_depth) > 1) {\n83\t\t\t\tprintf(\"Node %s violates the bal