ree mutations needed by `tree_add_command`. No `unsafe`, no FFI, no external crates added."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":510,"cache_read_input_tokens":26190,"cache_creation":{"ephemeral_5m_input_tokens":510,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"c330b874-784e-4c9f-b83a-78d7a6bee038","uuid":"3307cdda-0b62-49e0-8247-6a407cd1ed4a"}
