{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PvND9i2BforM7GSqffAeCq","type":"tool_result","content":"1\tuse impcheck::writer;\n2\tuse impcheck::vec;\n3\tuse impcheck::hash;\n4\tuse impcheck::trusted_utils;\n5\tuse impcheck::checker_interface;\n6\t\n7\tuse libc::*;\n8\tuse std::{fs::File, io::{Read, Write}};\n9\tuse crate::trusted_utils::*;\n10\tuse std::process::Command;\n11\tuse std::fs::OpenOptions;\n12\tuse crate::checker_interface::*;\n13\tuse std::thread;\n14\tuse std::time::Duration;\n15\t\n16\tfn do_assert(cond: bool) {\n17\tassert!(cond, \"Assertion failed!\");\n18\t}\n19\t\n20\t#[test]    \n21\tfn test_small() {\n22\tprintln!(\"[TEST] --- begin test_small() ---\");\n23\tlet mut ht = hash::HashTable::<[i32; 128]>::new(7);\n24\tdo_assert(ht.size == 0);\n25\tdo_assert(ht.capacity == 1 << 7);\n26\tlet mut arr = [0; 128];\n27\tlet cap = ht.capacity;\n28\tfor i in 1..=63 {\n29\tlet ok = ht.hash_table_insert(i, Box::new(arr[i as usize]));\n30\tdo_assert(ok);\n31\tdo_assert(ht.size == i);\n32\tdo_assert(ht.capacity == cap);\n33\tdo_assert(ht.hash_table_find(i).is_some());\n34\t}\n35\tdo_assert(ht.size == 63);\n36\tdo_assert(ht.capacity == 128);\n37\tfor i in 1..=63 {\n38\tdo_assert(ht.hash_table_find(i).is_some());\n39\t}\n40\tlet ok = ht.hash_table_insert(64, Box::new(arr[64]));\n41\tdo_assert(ok);\n42\tdo_assert(ht.size == 64);\n43\tdo_assert(ht.capacity == 128);\n44\tlet ok = ht.hash_table_insert(65, Box::new(arr[65]));\n45\tdo_assert(ok);\n46\tdo_assert(ht.size == 65);\n47\tdo_assert(ht.capacity == 256);\n48\tfor i in 1..=65 {\n49\tif i == 40 {\n50\tcontinue;\n51\t}\n52\tdo_assert(ht.hash_table_find(i).is_some());\n53\tdo_assert(ht.hash_table_delete(i));\n54\tdo_assert(ht.hash_table_find(i).is_none());\n55\t}\n56\tdo_assert(ht.size == 1);\n57\tdo_assert(ht.hash_table_find(40).is_some());\n58\tdo_assert(ht.hash_table_delete_last_found());\n59\tdo_assert(ht.size == 0);\n60\tdo_assert(ht.hash_table_find(40).is_none());\n61\tht.hash_table_free();\n62\tprintln!(\"[TEST] ---  end  test_small() ---\\n\");\n63\t}\n64\t\n65\t#[test]\n66\tfn test_big() {\n67\tprintln!(\"[TEST] --- begin test_big() ---\");\n68\tlet mut ht = hash::HashTable::<i32>::new(7);\n69\tdo_assert(ht.size == 0);\n70\tlet obj = 0;\n71\tlet nb_elems = (1 << 20) + 3;\n72\tfor i in 1..=nb_elems {\n73\tdo_assert(ht.hash_table_find(i).is_none());\n74\tlet ok = ht.hash_table_insert(i, Box::new(obj + i as i32));\n75\tdo_assert(ok);\n76\tlet val = ht.hash_table_find(i);\n77\tdo_assert(val.is_some());\n78\t}\n79\tdo_assert(ht.size == nb_elems);\n80\tfor i in 1..=nb_elems {\n81\tdo_assert(ht.size == nb_elems - i + 1);\n82\tlet val = ht.hash_table_find(i);\n83\tdo_assert(val.is_some());\n84\tlet ok = ht.hash_table_delete_last_found();\n85\tdo_assert(ok);\n86\tdo_assert(ht.hash_table_find(i).is_none());\n87\t}\n88\tdo_assert(ht.size == 0);\n89\tht.hash_table_free();\n90\tprintln!(\"[TEST] ---  end  test_big() ---\\n\");\n91\t}\n92\t\n93\t#[test]\n94\tfn test_alternate() {\n95\tprintln!(\"[TEST] --- begin test_alternate() ---\");\n96\tlet mut ht = hash::HashTable::<u64>::new(7);\n97\tdo_assert(ht.size == 0);\n98\tlet obj = 0;\n99\t\n100\tconst BLOCK_SIZE: u64 = 256;\n101\tconst NB_ITERATIONS: i32 = 9999;\n102\tlet mut counter = 1;\n103\tfor _ in 0..NB_ITERATIONS {\n104\tfor _ in 0..BLOCK_SIZE {\n105\tdo_assert(ht.hash_table_find(counter).is_none());\n106\tlet ok = ht.hash_table_insert(counter, Box::new(obj + counter));\n107\tdo_assert(ok);\n108\tlet val = ht.hash_table_find(counter);\n109\tdo_assert(val.is_some());\n110\tcounter += 1;\n111\t}\n112\tfor delcounter in (counter - BLOCK_SIZE..counter).step_by(2) {\n113\tlet val = ht.hash_table_find(delcounter);\n114\tdo_assert(val.is_some());\n115\tlet ok = ht.hash_table_delete_last_found();\n116\tdo_assert(ok);\n117\tdo_assert(ht.hash_table_find(delcounter).is_none());\n118\t}\n119\t}\n120\t\n121\tprintln!(\"size={} counter={}\", ht.size, counter);\n122\tfor i in 1..=counter {\n123\tif i % 2 == 1 {\n124\tdo_assert(ht.hash_table_find(i).is_none());\n125\t} else {\n126\tlet val = ht.hash_table_find(i);\n127\tdo_assert(val.is_some());\n128\t}\n129\t}\n130\tdo_assert(ht.size == counter / 2);\n131\tprintln!(\"[TEST] ---  end  test_alternate() ---\\n\");\n132\t}\n133\t\n134\t\n135\t\n136\tfn do_fork() -> bool {\n137\tmatch unsafe { libc::fork() } {\n138\t-1 => panic!(\"Fork failed\"),\n139\t0 => true,  // Child process\n140\t_ => false, // Parent process\n141\t}\n142\t}\n143\t\n144\tfn create_pipe(path: &str) {\n145\tlet _ = std::fs::remove_file(path);\n146\tlet res = unsafe { libc::mkfifo(path.as_ptr() as *const i8, 0o777) };\n147\tdo_assert(res == 0);\n148\t}\n149\t\n150\tfn await_ok(out: &mut File, input: &mut File) {\n151\tout.flush().unwrap();\n152\tlet mut ok = [0u8; 1];\n153\tinput.read_exact(&mut ok).unwrap();\n154\tdo_assert(ok[0] != 0);\n155\t}\n156\t\n157\tfn setup(cnf_input: &str) -> (u64, File, File) {\n158\tlet checker_instance_id = 1;\n159\tlet pipe_parsed = format!(\".parsed.{}.pipe\", checker_instance_id);\n160\tlet pipe_directives = format!(\".directives.{}.pipe\", checker_instance_id);\n161\tlet pipe_feedback = format!(\".feedback.{}.pipe\", checker_instance_id);\n162\t\n163\tcreate_pipe(&pipe_parsed);\n164\tcreate_pipe(&pipe_directives);\n165\tcreate_pipe(&pipe_feedback);\n166\t\n167\tif do_fork() {\n168\tlet mut cmd = Command::new(\"build/impcheck_parse\")\n169\t.arg(format!(\"-formula-input={}\", cnf_input))\n170\t.arg(format!(\"-fifo-parsed-formula={}\", pipe_parsed))\n171\t.spawn()\n172\t.expect(\"Failed to start impcheck_parse\");\n173\tcmd.wait().expect(\"Failed to wait on child\");\n174\tstd::process::exit(0);\n175\t}\n176\t\n177\tlet mut in_parsed = File::open(&pipe_parsed).unwrap();\n178\tlet nb_vars = trusted_utils_read_int(&mut in_parsed);\n179\ttrusted_utils_read_int(&mut in_parsed);\n180\t\n181\tlet mut fvec = Vec::with_capacity(1 << 14);\n182\tloop {\n183\tlet mut lit = [0u8; 4];\n184\tif in_parsed.read(&mut lit).unwrap() == 0 {\n185\tbreak;\n186\t}\n187\tfvec.push(i32::from_ne_bytes(lit));\n188\t}\n189\t\n190\tlet f = &fvec[..fvec.len() - (SIG_SIZE_BYTES / std::mem::size_of::<i32>())];\n191\tlet mut fsig: Vec<u8> = vec![];\n192\tfor i in &fvec[fvec.len() - (SIG_SIZE_BYTES / std::mem::size_of::<i32>())..] {\n193\t    fsig.push(*i as u8);\n194\t}\n195\t//let fsig = &fvec[fvec.len() - (SIG_SIZE_BYTES / std::mem::size_of::<i32>())..];\n196\t\n197\tif do_fork() {\n198\tlet mut cmd = Command::new(\"build/impcheck_check\")\n199\t.arg(format!(\"-fifo-directives={}\", pipe_directives))\n200\t.arg(format!(\"-fifo-feedback={}\", pipe_feedback))\n201\t.arg(\"-check-model\")\n202\t.spawn()\n203\t.expect(\"Failed to start impcheck_check\");\n204\tcmd.wait().expect(\"Failed to wait on child\");\n205\tstd::process::exit(0);\n206\t}\n207\t\n208\tlet mut out_directives = OpenOptions::new()\n209\t.write(true)\n210\t.open(&pipe_directives)\n211\t.unwrap();\n212\tlet mut in_feedback = File::open(&pipe_feedback).unwrap();\n213\t\n214\ttrusted_utils_write_char(TRUSTED_CHK_INIT, &mut out_directives);\n215\ttrusted_utils_write_int(nb_vars, &mut out_directives);\n216\ttrusted_utils_write_sig(&fsig, &mut out_directives);\n217\tawait_ok(&mut out_directives, &mut in_feedback);\n218\t\n219\ttrusted_utils_write_char(TRUSTED_CHK_LOAD, &mut out_directives);\n220\ttrusted_utils_write_int(f.len() as i32, &mut out_directives);\n221\ttrusted_utils_write_ints(f, f.len() as u64, &mut out_directives);\n222\t\n223\ttrusted_utils_write_char(TRUSTED_CHK_END_LOAD, &mut out_directives);\n224\tawait_ok(&mut out_directives, &mut in_feedback);\n225\t\n226\t(checker_instance_id, out_directives, in_feedback)\n227\t}\n228\t\n229\tfn confirm(cnf_input: &str, result: i32, sig: &[u8]) -> bool {\n230\tlet sigstr: String = sig.iter().map(|b| format!(\"{:02x}\", b)).collect();\n231\tlet output = Command::new(\"build/impcheck_confirm\")\n232\t.arg(format!(\"-formula-input={}\", cnf_input))\n233\t.arg(format!(\"-result={}\", result))\n234\t.ar