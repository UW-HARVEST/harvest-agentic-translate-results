{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01GAGqnoQCi4BuHJEnSpgN7r","type":"tool_result","content":"1\t/**\n2\t * XOpt - command line parsing library\n3\t *\n4\t * Copyright (c) 2015 JD Ballard.\n5\t *\n6\t * Permission is hereby granted, free of charge, to any person obtaining a copy\n7\t * of this software and associated documentation files (the \"Software\"), to deal\n8\t * in the Software without restriction, including without limitation the rights\n9\t * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n10\t * copies of the Software, and to permit persons to whom the Software is\n11\t * furnished to do so, subject to the following conditions:\n12\t *\n13\t * The above copyright notice and this permission notice shall be included in\n14\t * all copies or substantial portions of the Software.\n15\t *\n16\t * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n17\t * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n18\t * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n19\t * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n20\t * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n21\t * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n22\t * THE SOFTWARE.\n23\t */\n24\t\n25\t#ifndef XOPT_NOSTANDARD\n26\t#\tdefine HAVE_STDARG_H 1\n27\t#\tdefine HAVE_STDLIB_H 1\n28\t#\tdefine HAVE_VASPRINTF_H 1\n29\t#\tdefine HAVE_ASPRINTF_H 1\n30\t#\tifndef _GNU_SOURCE\n31\t#\t\tdefine _GNU_SOURCE\n32\t#\tendif\n33\t#endif\n34\t\n35\t#include <stdlib.h>\n36\t#include <stdbool.h>\n37\t#include <stdarg.h>\n38\t#include <stdio.h>\n39\t#include <string.h>\n40\t\n41\t#include \"./xopt.h\"\n42\t#include \"./snprintf.c\"\n43\t\n44\t#define EXTRAS_INIT 10\n45\t#define ERRBUF_SIZE 1024 * 4\n46\t\n47\tstatic char errbuf[ERRBUF_SIZE];\n48\t\n49\tstruct xoptContext {\n50\t\tconst xoptOption *options;\n51\t\tlong flags;\n52\t\tconst char *name;\n53\t\tbool doubledash;\n54\t};\n55\t\n56\tstatic void _xopt_set_err(const char **err, const char *const fmt, ...);\n57\tstatic bool _xopt_parse_arg(xoptContext *ctx, int argc, const char **argv,\n58\t\t\tint *argi, void *data, const char **err);\n59\tstatic void _xopt_assert_increment(const char ***extras, int extrasCount,\n60\t\t\tsize_t *extrasCapac, const char **err);\n61\tstatic int _xopt_get_size(const char *arg);\n62\tstatic int _xopt_get_arg(const char *arg, size_t len, const xoptOption *options,\n63\t\t\tint size, const xoptOption **option);\n64\tstatic void _xopt_set(void *data, const xoptOption *option, const char *val,\n65\t\t\tbool longArg, const char **err);\n66\tstatic void _xopt_default_callback(const char *value, void *data,\n67\t\t\tconst xoptOption *option, bool longArg, const char **err);\n68\t\n69\txoptContext* xopt_context(const char *name, const xoptOption *options, long flags,\n70\t\t\tconst char **err) {\n71\t\txoptContext* ctx;\n72\t\t*err = 0;\n73\t\n74\t\t/* malloc context and check */\n75\t\tctx = malloc(sizeof(xoptContext));\n76\t\tif (!ctx) {\n77\t\t\tctx = 0;\n78\t\t\t_xopt_set_err(err, \"could not allocate context\");\n79\t\t} else {\n80\t\t\tctx->options = options;\n81\t\t\tctx->flags = flags;\n82\t\t\tctx->name = name;\n83\t\t\tctx->doubledash = false;\n84\t\t}\n85\t\n86\t\treturn ctx;\n87\t}\n88\t\n89\tint xopt_parse(xoptContext *ctx, int argc, const char **argv, void* data,\n90\t\t\tconst char ***inextras, const char **err) {\n91\t\tint argi;\n92\t\tint extrasCount;\n93\t\tsize_t extrasCapac;\n94\t\tconst char **extras;\n95\t\tbool parseResult;\n96\t\n97\t\t*err = 0;\n98\t\targi = 0;\n99\t\textrasCount = 0;\n100\t\textrasCapac = EXTRAS_INIT;\n101\t\textras = malloc(sizeof(*extras) * EXTRAS_INIT);\n102\t\n103\t\t/* check if extras malloc'd okay */\n104\t\tif (!extras) {\n105\t\t\t_xopt_set_err(err, \"could not allocate extras array\");\n106\t\t\tgoto end;\n107\t\t}\n108\t\n109\t\t/* increment argument counter if we aren't\n110\t\t\t instructed to check argv[0] */\n111\t\tif (!(ctx->flags & XOPT_CTX_KEEPFIRST)) {\n112\t\t\t++argi;\n113\t\t}\n114\t\n115\t\t/* iterate over passed command line arguments */\n116\t\tfor (; argi < argc; argi++) {\n117\t\t\t/* parse, breaking if there was a failure\n118\t\t\t\t parseResult is true if extra, false if option */\n119\t\t\tparseResult = _xopt_parse_arg(ctx, argc, argv, &argi, data, err);\n120\t\t\tif (*err) {\n121\t\t\t\tbreak;\n122\t\t\t}\n123\t\n124\t\t\t/* is the argument an extra? */\n125\t\t\tif (parseResult) {\n126\t\t\t\t/* make sure we have enough room, or realloc if we don't -\n127\t\t\t\t\t check that it succeeded */\n128\t\t\t\t_xopt_assert_increment(&extras, extrasCount, &extrasCapac, err);\n129\t\t\t\tif (*err) {\n130\t\t\t\t\tbreak;\n131\t\t\t\t}\n132\t\n133\t\t\t\t/* add extra to list */\n134\t\t\t\textras[extrasCount++] = argv[argi];\n135\t\t\t} else {\n136\t\t\t\t/* make sure we're super-posix'd if specified to be\n137\t\t\t\t\t (check that no extras have been specified when an option is parsed,\n138\t\t\t\t\t enforcing options to be specific before [extra] arguments */\n139\t\t\t\tif ((ctx->flags & XOPT_CTX_POSIXMEHARDER) && extrasCount) {\n140\t\t\t\t\t_xopt_set_err(err, \"options cannot be specified after arguments: %s\",\n141\t\t\t\t\t\t\targv[argi]);\n142\t\t\t\t\tbreak;\n143\t\t\t\t}\n144\t\t\t}\n145\t\t}\n146\t\n147\tend:\n148\t\tif (!*err) {\n149\t\t\t/* append null terminator to extras */\n150\t\t\t_xopt_assert_increment(&extras, extrasCount, &extrasCapac, err);\n151\t\t\tif (!*err) {\n152\t\t\t\textras[extrasCount] = 0;\n153\t\t\t}\n154\t\t}\n155\t\n156\t\tif (*err) {\n157\t\t\tfree(extras);\n158\t\t\t*inextras = 0;\n159\t\t\treturn 0;\n160\t\t}\n161\t\n162\t\t*inextras = extras;\n163\t\treturn extrasCount;\n164\t}\n165\t\n166\tvoid xopt_autohelp(xoptContext *ctx, FILE *stream, const xoptAutohelpOptions *options,\n167\t\t\tconst char **err) {\n168\t\tconst xoptOption *o;\n169\t\tsize_t i, width = 0, twidth;\n170\t\tconst char *nl = \"\";\n171\t\tsize_t spacer = options ? options->spacer : 2;\n172\t\n173\t\t*err = 0;\n174\t\n175\t\tif (options && options->usage) {\n176\t\t\tfprintf(stream, \"%s%s\\n\", nl, options->usage);\n177\t\t\tnl = \"\\n\";\n178\t\t}\n179\t\n180\t\tif (options && options->prefix) {\n181\t\t\tfprintf(stream, \"%s%s\\n\\n\", nl, options->prefix);\n182\t\t\tnl = \"\\n\";\n183\t\t}\n184\t\n185\t\t/* find max width */\n186\t\tfor (i = 0; ctx->options[i].longArg || ctx->options[i].shortArg; i++) {\n187\t\t\to = &ctx->options[i];\n188\t\t\ttwidth = 0;\n189\t\t\tif (o->longArg) {\n190\t\t\t\ttwidth += 2 + strlen(o->longArg);\n191\t\t\t\tif (o->argDescrip) {\n192\t\t\t\t\ttwidth += 1 + strlen(o->argDescrip);\n193\t\t\t\t}\n194\t\t\t}\n195\t\t\tif (ctx->options[i].shortArg) {\n196\t\t\t\ttwidth += 2;\n197\t\t\t}\n198\t\t\tif (ctx->options[i].shortArg && ctx->options[i].longArg) {\n199\t\t\t\ttwidth += 2; /* `, ` */\n200\t\t\t}\n201\t\n202\t\t\twidth = width > twidth ? width : twidth;\n203\t\t}\n204\t\n205\t\t/* print */\n206\t\tfor (i = 0; ctx->options[i].longArg || ctx->options[i].shortArg; i++) {\n207\t\t\to = &ctx->options[i];\n208\t\t\ttwidth = 0;\n209\t\t\tif (o->shortArg) {\n210\t\t\t\tfprintf(stream, \"-%c\", o->shortArg);\n211\t\t\t\ttwidth += 2;\n212\t\t\t}\n213\t\n214\t\t\tif (o->shortArg && o->longArg) {\n215\t\t\t\tfprintf(stream, \", \");\n216\t\t\t\ttwidth += 2;\n217\t\t\t}\n218\t\n219\t\t\tif (o->longArg) {\n220\t\t\t\tfprintf(stream, \"--%s\", o->longArg);\n221\t\t\t\ttwidth += 2 + strlen(o->longArg);\n222\t\t\t\tif (o->argDescrip) {\n223\t\t\t\t\tfprintf(stream, \"=%s\", o->argDescrip);\n224\t\t\t\t\ttwidth += 1 + strlen(o->argDescrip);\n225\t\t\t\t}\n226\t\t\t}\n227\t\n228\t\t\tif (o->descrip) {\n229\t\t\t\tfor (; twidth < (width + spacer); twidth++) {\n230\t\t\t\t\tfprintf(stream, \" \");\n231\t\t\t\t}\n232\t\n233\t\t\t\tfprintf(stream, \"%s\\n\", o->descrip);\n234\t\t\t}\n235\t\t}\n236\t\n237\t\tif (options && options->suffix) {\n238\t\t\tfprintf(stream, \"%s%s\\n\", nl, options->suffix);\n239\t\t}\n240\t}\n241\t\n242\tstatic void _xopt_set_err(const char **err, const char *const fmt, ...) {\n243\t\tva_list list;\n244\t\tva_start(list, fmt);\n245\t\trpl_vsnprintf(&errbuf[0], ERRBUF_SIZE, fmt, list);\n246\t\tva_end(list);\n247\t\t*err = &errbuf[0];\n248\t}\n249\t\n250\tstatic bool _xopt_parse_arg(xoptContext *ctx, int argc, const char **argv,\n251\t\t\tint *argi, void *data, const char **err) {\n252\t\tint size;\n253\t\tsize_t length;\n254\t\tbool isExtra = false;\n255\t\tconst char* arg = argv[*argi];\n256\t\n257\t\t/* are we in doubledash mode? */\n258\t\tif (ctx->doubledash) {\n259\t\t\treturn true;\n260\t\t}\n261\t\n262\t\t/* get argument 'size' (long/short/extra) */\n263\t\tsize = _xopt_get_size(arg);\n264\t\n265\t\t/* adjust to parse from beginning of actual content */\n266\t\targ += size;\n267\t\tlength = strlen(arg);\n268\t\n269\t\tif (size == 1 && length == 0) {\n270\t\t\t/* it's just a singular dash - treat it as an extra arg */\n271\t\t\treturn true;\n272\t\t}\n273\t\n274\t\tif (size == 2 && length == 0) {\n275\t\t\t/* double-dash - everything after this is an extra */\n276\t\t\tctx->doubledash = 1;\n277\t\t\treturn false;\n278\t\t}\n279\t\n280\t\tswitch (size) {\n281\t\t\tconst xoptOption *option;\n282\t\t\tint argRequirement;\n283\t\t\tchar *valStart;\n284\t\tcase 1: /* short */\n285\t\t\tif (length > 1 && ctx->flags & XOPT_CTX_NOCONDENSE) {\n286\t\t\t\t/* invalid argument? */\n287\t\t\t\t_xopt_set_err(err, \"short options cannot be combined: %s\", argv[*argi]);\n288\t\t\t} else if (length > 1 && ctx->flags & XOPT_CTX_SLOPPYSHORTS) {\n289\t\t\t\t/* get argument or error if not found and strict mode enabled. */\n290\t\t\t\targRequirement = _xopt_get_arg(arg, 1, ctx->options, size, &option);\n291\t\t\t\tif (!option) {\n292\t\t\t\t\tif (ctx->flags & XOPT_CTX_STRICT) {\n293\t\t\t\t\t\t_xopt_set_err(err, \"invalid option: -%c\", arg[0]);\n294\t\t\t\t\t}\n295\t\t\t\t\tbreak;\n296\t\t\t\t}\n297\t\n298\t\t\t\t/* did they specify an arg when they shouldn't have? */\n299\t\t\t\tif (!argRequirement) {\n300\t\t\t\t\t_xopt_set_err(err, \"option doesn't take a value: -%c\", arg[0]);\n301\t\t\t\t\tbreak;\n302\t\t\t\t}\n303\t\n304\t\t\t\t/* set argument and check */\n305\t\t\t\t_xopt_set(data, option, arg + 1, false, err);\n306\t\t\t\tif (*err) {\n307\t\t\t\t\tbreak;\n308\t\t\t\t}\n309\t\t\t} else {\n310\t\t\t\t/* parse all */\n311\t\t\t\twhile (length--) {\n312\t\t\t\t\t/* get argument or error if not found and strict mode enabled. */\n313\t\t\t\t\targRequirement = _xopt_get_arg(arg++, 1, ctx->options, size, &option);\n314\t\t\t\t\tif (!option) {\n315\t\t\t\t\t\tif (ctx->flags & XOPT_CTX_STRICT) {\n316\t\t\t\t\t\t\t_xopt_set_err(err, \"invalid option: -%c\", arg[-1]);\n317\t\t\t\t\t\t}\n318\t\t\t\t\t\tbreak;\n319\t\t\t\t\t}\n320\t\n321\t\t\t\t\tswitch (argRequirement) {\n322\t\t\t\t\tcase 0: /* flag; doesn't take an argument */\n323\t\t\t\t\t\t_xopt_set(data, option, 0, false, err);\n324\t\t\t\t\t\tbreak;\n325\t\t\t\t\tcase 1: /* argument is optional */\n326\t\t\t\t\t\t/* is there another argument, and is it a non-option? */\n327\t\t\t\t\t\tif (*argi + 1 < argc && _xopt_get_size(argv[*argi + 1]) == 0) {\n328\t\t\t\t\t\t\t_xopt_set(data, option, argv[++*argi], false, err);\n329\t\t\t\t\t\t} else {\n330\t\t\t\t\t\t\t_xopt_set(data, option, 0, false, err);\n331\t\t\t\t\t\t}\n332\t\t\t\t\t\tbreak;\n333\t\t\t\t\tcase 2: /* requires an argument */\n334\t\t\t\t\t\t/* is it the last in a set of condensed options? */\n335\t\t\t\t\t\tif (length == 0) {\n336\t\t\t\t\t\t\t/* is there another argument? */\n337\t\t\t\t\t\t\tif (*argi + 1 < argc) {\n338\t\t\t\t\t\t\t\t/* is the next argument actually an option?\n339\t\t\t\t\t\t\t\t\t this indicates no value was passed */\n340\t\t\t\t\t\t\t\tif (_xopt_get_size(argv[*argi + 1])) {\n341\t\t\t\t\t\t\t\t\t_xopt_set_err(err, \"missing option value: -%c\",\n342\t\t\t\t\t\t\t\t\t\t\toption->shortArg);\n343\t\t\t\t\t\t\t\t} else {\n344\t\t\t\t\t\t\t\t\t_xopt_set(data, option, argv[++*argi], false, err);\n345\t\t\t\t\t\t\t\t}\n346\t\t\t\t\t\t\t} else {\n347\t\t\t\t\t\t\t\t_xopt_set_err(err, \"missing option value: -%c\",\n348\t\t\t\t\t\t\t\t\t\toption->shortArg);\n349\t\t\t\t\t\t\t}\n350\t\t\t\t\t\t} else {\n351\t\t\t\t\t\t\t_xopt_set_err(err, \"combined short option requiring value is \"\n352\t\t\t\t\t\t\t\t\t\"not last: -%c\", option->shortArg);\n353\t\t\t\t\t\t}\n354\t\t\t\t\t\tbreak;\n355\t\t\t\t\t}\n356\t\t\t\t}\n357\t\t\t}\n358\t\n359\t\t\tbreak;\n360\t\tcase 2: /* long */\n361\t\t\t/* find first equals sign */\n362\t\t\tvalStart = strchr(arg, '=');\n363\t\n364\t\t\t/* is there a value? */\n365\t\t\tif (valStart) {\n366\t\t\t\t/* we also increase valStart here in order to lop off\n367\t\t\t\t\t the equals sign */\n368\t\t\t\tlength = valStart++ - arg;\n369\t\n370\t\t\t\t/* but not really, if it's null */\n371\t\t\t\tif (!*valStart) {\n372\t\t\t\t\tvalStart = 0;\n373\t\t\t\t}\n374\t\t\t}\n375\t\n376\t\t\t/* get the option */\n377\t\t\targRequirement = _xopt_get_arg(arg, length, ctx->options, size, &option);\n378\t\t\tif (!option) {\n379\t\t\t\t_xopt_set_err(err, \"invalid option: --%.*s\", length, arg);\n380\t\t\t} else {\n381\t\t\t\tswitch (argRequirement) {\n382\t\t\t\tcase 0: /* flag; doesn't take an argument */\n383\t\t\t\t\tif (valStart) {\n384\t\t\t\t\t\t_xopt_set_err(err, \"option doesn't take a value: --%s\", arg);\n385\t\t\t\t\t}\n386\t\n387\t\t\t\t\t_xopt_set(data, option, valStart, true, err);\n388\t\t\t\t\tbreak;\n389\t\t\t\tcase 2: /* requires an argument */\n390\t\t\t\t\tif (!valStart) {\n391\t\t\t\t\t\t_xopt_set_err(err, \"missing option value: --%s\", arg);\n392\t\t\t\t\t}\n393\t\t\t\t\tbreak;\n394\t\t\t\t}\n395\t\n396\t\t\t\tif (!*err) {\n397\t\t\t\t\t_xopt_set(data, option, valStart, true, err);\n398\t\t\t\t}\n399\t\t\t}\n400\t\n401\t\t\tbreak;\n402\t\tcase 0: /* extra */\n403\t\t\tisExtra = true;\n404\t\t\tbreak;\n405\t\t}\n406\t\n407\t\treturn isExtra;\n408\t}\n409\t\n410\tstatic void _xopt_assert_increment(const char ***extras, int extrasCount,\n411\t\t\tsize_t *extrasCapac, const char **err) {\n412\t\t/* have we hit the list size limit? */\n413\t\tif ((size_t) extrasCount == *extrasCapac) {\n414\t\t\t/* increase capcity, realloc, and check for success */\n415\t\t\t*extrasCapac += EXTRAS_INIT;\n416\t\t\t*extras = realloc(*extras, sizeof(**extras) * *extrasCapac);\n417\t\t\tif (!*extras) {\n418\t\t\t\t_xopt_set_err(err, \"could not realloc arguments array\");\n419\t\t\t}\n420\t\t}\n421\t}\n422\t\n423\tstatic int _xopt_get_size(const char *arg) {\n424\t\tint size;\n425\t\tfor (size = 0; size < 2; size++) {\n426\t\t\tif (arg[size] != '-') {\n427\t\t\t\tbreak;\n428\t\t\t}\n429\t\t}\n430\t\treturn size;\n431\t}\n432\t\n433\tstatic int _xopt_get_arg(const char *arg, size_t len, const xoptOption *options,\n434\t\t\tint size, const xoptOption **option) {\n435\t\t*option = 0;\n436\t\n437\t\t/* find the argument */\n438\t\tfor (; options[0].longArg || options[0].shortArg; options++) {\n439\t\t\tif (size == 1 && options[0].shortArg == arg[0]) {\n440\t\t\t\t*option = options;\n441\t\t\t\tbreak;\n442\t\t\t} else if (strlen(options[0].longArg) == len &&\n443\t\t\t\t\t!strncmp(options[0].longArg, arg, len)) {\n444\t\t\t\t*option = options;\n445\t\t\t\tbreak;\n446\t\t\t}\n447\t\t}\n448\t\n449\t\t/* determine the optionality of a value */\n450\t\tif (!*option || (*option)->options & XOPT_TYPE_BOOL) {\n451\t\t\treturn 0;\n452\t\t} else if ((*option)->options & XOPT_OPTIONAL) {\n453\t\t\treturn 1;\n454\t\t} else {\n455\t\t\treturn 2;\n456\t\t}\n457\t}\n458\t\n459\tstatic void _xopt_set(void *data, const xoptOption *option, const char *val,\n460\t\t\tbool longArg, const char **err) {\n461\t\t/* determine callback */\n462\t\txoptCallback callback = option->callback ? option->callback : &_xopt_default_callback;\n463\t\n464\t\t/* dispatch callback */\n465\t\tcallback(val, data, option, longArg, err);\n466\t}\n467\t\n468\tstatic void _xopt_default_callback(const char *value, void *data,\n469\t\t\tconst xoptOption *option, bool longArg, const char **err) {\n470\t\tvoid *target;\n471\t\tchar *parsePtr = 0;\n472\t\n473\t\t/* is a value specified? */\n474\t\tif ((!value || !strlen(value)) && !(option->options & XOPT_TYPE_BOOL)) {\n475\t\t\t/* we reach this point when they specified an optional, non-boolean\n476\t\t\t\t option but didn't specify a custom handler (therefore, it's not\n477\t\t\t\t optional).\n478\t\n479\t\t\t\t to fix, just remove the optional flag or specify a callback to handle\n480\t\t\t\t it yourself.\n481\t\t\t\t */\n482\t\t\treturn;\n483\t\t}\n484\t\n485\t\t/* get location */\n486\t\ttarget = ((char*) data) + option->offset;\n487\t\n488\t\t/* switch on the type */\n489\t\tswitch (option->options & 0x3F) {\n490\t\tcase XOPT_TYPE_BOOL:\n491\t\t\t/* booleans are special in that they won't have an argument passed\n492\t\t\t\t into this callback */\n493\t\t\t*((_Bool*) target) = true;\n494\t\t\tbreak;\n495\t\tcase XOPT_TYPE_STRING:\n496\t\t\t/* lifetime here works out fine; argv can usually be assumed static-like\n497\t\t\t\t in nature */\n498\t\t\t*((const char**) target) = value;\n499\t\t\tbreak;\n500\t\tcase XOPT_TYPE_INT:\n501\t\t\t*((int*) target) = (int) strtol(value, &parsePtr, 0);\n502\t\t\tbreak;\n503\t\tcase XOPT_TYPE_LONG:\n504\t\t\t*((long*) target) = strtol(value, &parsePtr, 0);\n505\t\t\tbreak;\n506\t\tcase XOPT_TYPE_FLOAT:\n507\t\t\t*((float*) target) = (float) strtod(value, &parsePtr);\n508\t\t\tbreak;\n509\t\tcase XOPT_TYPE_DOUBLE:\n510\t\t\t*((double*) target) = strtod(value, &parsePtr);\n511\t\t\tbreak;\n512\t\tdefault: /* something wonky, or the implementation specifies two types */\n513\t\t\tfprintf(stderr, \"warning: XOpt argument type invalid: %ld\\n\",\n514\t\t\t\toption->options & 0x2F);\n515\t\t\tbreak;\n516\t\t}\n517\t\n518\t\t/* check that our parsing functions worked */\n519\t\tif (parsePtr && *parsePtr) {\n520\t\t\tif (longArg) {\n521\t\t\t\t_xopt_set_err(err, \"value isn't a valid number: --%s=%s\",\n522\t\t\t\t\t\t(void*) option->longArg, value);\n523\t\t\t} else {\n524\t\t\t\t_xopt_set_err(err, \"value isn't a valid number: -%c %s\",\n525\t\t\t\t\t\toption->shortArg, value);\n526\t\t\t}\n527\t\t}\n528\t}\n529\t\n530\t"}]},"parent_tool_use_id":null,"session_id":"977d67a3-c179-4aa1-b792-6b09d3b6d808","uuid":"e7ba7123-8f3a-4a84-b1fb-5e4ad112bfcf","timestamp":"2026-06-05T21:07:29.229Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-cMUsaU/project/c_src/xopt.c","content":"/**\n * XOpt - command line parsing library\n *\n * Copyright (c) 2015 JD Ballard.\n *\n * Permission is hereby granted, free of charge, to any person obtaining a copy\n * of this software and associated documentation files (the \"Software\"), to deal\n * in the Software without restriction, including without limitation the rights\n * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell\n * copies of the Software, and to permit persons to whom the Software is\n * furnished to do so, subject to the following conditions:\n *\n * The above copyright notice and this permission notice shall be included in\n * all copies or substantial portions of the Software.\n *\n * THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\n * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\n * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\n * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\n * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\n * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN\n * THE SOFTWARE.\n */\n\n#ifndef XOPT_NOSTANDARD\n#\tdefine HAVE_STDARG_H 1\n#\tdefine HAVE_STDLIB_H 1\n#\tdefine HAVE_VASPRINTF_H 1\n#\tdefine HAVE_ASPRINTF_H 1\n#\tifndef _GNU_SOURCE\n#\t\tdefine _GNU_SOURCE\n#\tendif\n#endif\n\n#include <stdlib.h>\n#include <stdbool.h>\n#include <stdarg.h>\n#include <stdio.h>\n#include <string.h>\n\n#include \"./xopt.h\"\n#include \"./snprintf.c\"\n\n#define EXTRAS_INIT 10\n#define ERRBUF_SIZE 1024 * 4\n\nstatic char errbuf[ERRBUF_SIZE];\n\nstruct xoptContext {\n\tconst xoptOption *options;\n\tlong flags;\n\tconst char *name;\n\tbool doubledash;\n};\n\nstatic void _xopt_set_err(const char **err, const char *const fmt, ...);\nstatic bool _xopt_parse_arg(xoptContext *ctx, int argc, const char **argv,\n\t\tint *argi, void *data, const char **err);\nstatic void _xopt_assert_increment(const char ***extras, int extrasCount,\n\t\tsize_t *extrasCapac, const char **err);\nstatic int _xopt_get_size(const char *arg);\nstatic int _xopt_get_arg(const char *arg, size_t len, const xoptOption *options,\n\t\tint size, const xoptOption **option);\nstatic void _xopt_set(void *data, const xoptOption *option, const char *val,\n\t\tbool longArg, const char **err);\nstatic void _xopt_default_callback(const char *value, void *data,\n\t\tconst xoptOption *option, bool longArg, const char **err);\n\nxoptContext* xopt_context(const char *name, const xoptOption *options, long flags,\n\t\tconst char **err) {\n\txoptContext* ctx;\n\t*err = 0;\n\n\t/* malloc context and check */\n\tctx = malloc(sizeof(xoptContext));\n\tif (!ctx) {\n\t\tctx = 0;\n\t\t_xopt_set_err(err, \"could not allocate context\");\n\t} else {\n\t\tctx->options = options;\n\t\tctx->flags = flags;\n\t\tctx->name = name;\n\t\tctx->doubledash = false;\n\t}\n\n\treturn ctx;\n}\n\nint xopt_parse(xoptContext *ctx, int argc, const char **argv, void* data,\n\t\tconst char ***inextras, const char **err) {\n\tint argi;\n\tint extrasCount;\n\tsize_t extrasCapac;\n\tconst char **extras;\n\tbool parseResult;\n\n\t*err = 0;\n\targi = 0;\n\textrasCount = 0;\n\textrasCapac = EXTRAS_INIT;\n\textras = malloc(sizeof(*extras) * EXTRAS_INIT);\n\n\t/* check if extras malloc'd okay */\n\tif (!extras) {\n\t\t_xopt_set_err(err, \"could not allocate extras array\");\n\t\tgoto end;\n\t}\n\n\t/* increment argument counter if we aren't\n\t\t instructed to check argv[0] */\n\tif (!(ctx->flags & XOPT_CTX_KEEPFIRST)) {\n\t\t++argi;\n\t}\n\n\t/* iterate over passed command line arguments */\n\tfor (; argi < argc; argi++) {\n\t\t/* parse, breaking if there was a failure\n\t\t\t parseResult is true if extra, false if option */\n\t\tparseResult = _xopt_parse_arg(ctx, argc, argv, &argi, data, err);\n\t\tif (*err) {\n\t\t\tbreak;\n\t\t}\n\n\t\t/* is the argument an extra? */\n\t\tif (parseResult) {\n\t\t\t/* make sure we have enough room, or realloc if we don't -\n\t\t\t\t check that it succeeded */\n\t\t\t_xopt_assert_increment(&extras, extrasCount, &extrasCapac, err);\n\t\t\tif (*err) {\n\t\t\t\tbreak;\n\t\t\t}\n\n\t\t\t/* add extra to list */\n\t\t\textras[extrasCount++] = argv[argi];\n\t\t} else {\n\t\t\t/* make sure we're super-posix'd if specified to be\n\t\t\t\t (check that no extras have been specified when an option is parsed,\n\t\t\t\t enforcing options to be specific before [extra] arguments */\n\t\t\tif ((ctx->flags & XOPT_CTX_POSIXMEHARDER) && extrasCount) {\n\t\t\t\t_xopt_set_err(err, \"options cannot be specified after arguments: %s\",\n\t\t\t\t\t\targv[argi]);\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n\nend:\n\tif (!*err) {\n\t\t/* append null terminator to extras */\n\t\t_xopt_assert_increment(&extras, extrasCount, &extrasCapac, err);\n\t\tif (!*err) {\n\t\t\textras[extrasCount] = 0;\n\t\t}\n\t}\n\n\tif (*err) {\n\t\tfree(extras);\n\t\t*inextras = 0;\n\t\treturn 0;\n\t}\n\n\t*inextras = extras;\n\treturn extrasCount;\n}\n\nvoid xopt_autohelp(xoptContext *ctx, FILE *stream, const xoptAutohelpOptions *options,\n\t\tconst char **err) {\n\tconst xoptOption *o;\n\tsize_t i, width = 0, twidth;\n\tconst char *nl = \"\";\n\tsize_t spacer = options ? options->spacer : 2;\n\n\t*err = 0;\n\n\tif (options && options->usage) {\n\t\tfprintf(stream, \"%s%s\\n\", nl, options->usage);\n\t\tnl = \"\\n\";\n\t}\n\n\tif (options && options->prefix) {\n\t\tfprintf(stream, \"%s%s\\n\\n\", nl, options->prefix);\n\t\tnl = \"\\n\";\n\t}\n\n\t/* find max width */\n\tfor (i = 0; ctx->options[i].longArg || ctx->options[i].shortArg; i++) {\n\t\to = &ctx->options[i];\n\t\ttwidth = 0;\n\t\tif (o->longArg) {\n\t\t\ttwidth += 2 + strlen(o->longArg);\n\t\t\tif (o->argDescrip) {\n\t\t\t\ttwidth += 1 + strlen(o->argDescrip);\n\t\t\t}\n\t\t}\n\t\tif (ctx->options[i].shortArg) {\n\t\t\ttwidth += 2;\n\t\t}\n\t\tif (ctx->options[i].shortArg && ctx->options[i].longArg) {\n\t\t\ttwidth += 2; /* `, ` */\n\t\t}\n\n\t\twidth = width > twidth ? width : twidth;\n\t}\n\n\t/* print */\n\tfor (i = 0; ctx->options[i].longArg || ctx->options[i].shortArg; i++) {\n\t\to = &ctx->options[i];\n\t\ttwidth = 0;\n\t\tif (o->shortArg) {\n\t\t\tfprintf(stream, \"-%c\", o->shortArg);\n\t\t\ttwidth += 2;\n\t\t}\n\n\t\tif (o->shortArg && o->longArg) {\n\t\t\tfprintf(stream, \", \");\n\t\t\ttwidth += 2;\n\t\t}\n\n\t\tif (o->longArg) {\n\t\t\tfprintf(stream, \"--%s\", o->longArg);\n\t\t\ttwidth += 2 + strlen(o->longArg);\n\t\t\tif (o->argDescrip) {\n\t\t\t\tfprintf(stream, \"=%s\", o->argDescrip);\n\t\t\t\ttwidth += 1 + strlen(o->argDescrip);\n\t\t\t}\n\t\t}\n\n\t\tif (o->descrip) {\n\t\t\tfor (; twidth < (width + spacer); twidth++) {\n\t\t\t\tfprintf(stream, \" \");\n\t\t\t}\n\n\t\t\tfprintf(stream, \"%s\\n\", o->descrip);\n\t\t}\n\t}\n\n\tif (options && options->suffix) {\n\t\tfprintf(stream, \"%s%s\\n\", nl, options->suffix);\n\t}\n}\n\nstatic void _xopt_set_err(const char **err, const char *const fmt, ...) {\n\tva_list list;\n\tva_start(list, fmt);\n\trpl_vsnprintf(&errbuf[0], ERRBUF_SIZE, fmt, list);\n\tva_end(list);\n\t*err = &errbuf[0];\n}\n\nstatic bool _xopt_parse_arg(xoptContext *ctx, int argc, const char **argv,\n\t\tint *argi, void *data, const char **err) {\n\tint size;\n\tsize_t length;\n\tbool isExtra = false;\n\tconst char* arg = argv[*argi];\n\n\t/* are we in doubledash mode? */\n\tif (ctx->doubledash) {\n\t\treturn true;\n\t}\n\n\t/* get argument 'size' (long/short/extra) */\n\tsize = _xopt_get_size(arg);\n\n\t/* adjust to parse from beginning of actual content */\n\targ += size;\n\tlength = strlen(arg);\n\n\tif (size == 1 && length == 0) {\n\t\t/* it's just a singular dash - treat it as an extra arg */\n\t\treturn true;\n\t}\n\n\tif (size == 2 && length == 0) {\n\t\t/* double-dash - everything after this is an extra */\n\t\tctx->doubledash = 1;\n\t\treturn false;\n\t}\n\n\tswitch (size) {\n\t\tconst xoptOption *option;\n\t\tint argRequirement;\n\t\tchar *valStart;\n\tcase 1: /* short */\n\t\tif (length > 1 && ctx->flags & XOPT_CTX_NOCONDENSE) {\n\t\t\t/* invalid argument? */\n\t\t\t_xopt_set_err(err, \"short options cannot be combined: %s\", argv[*argi]);\n\t\t} else if (length > 1 && ctx->flags & XOPT_CTX_SLOPPYSHORTS) {\n\t\t\t/* get argument or error if not found and strict mode enabled. */\n\t\t\targRequirement = _xopt_get_arg(arg, 1, ctx->options, size, &option);\n\t\t\tif (!option) {\n\t\t\t\tif (ctx->flags & XOPT_CTX_STRICT) {\n\t\t\t\t\t_xopt_set_err(err, \"invalid option: -%c\", arg[0]);\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\t}\n\n\t\t\t/* did they specify an arg when they shouldn't have? */\n\t\t\tif (!argRequirement) {\n\t\t\t\t_xopt_set_err(err, \"option doesn't take a value: -%c\", arg[0]);\n\t\t\t\tbreak;\n\t\t\t}\n\n\t\t\t/* set argument and check */\n\t\t\t_xopt_set(data, option, arg + 1, false, err);\n\t\t\tif (*err) {\n\t\t\t\tbreak;\n\t\t\t}\n\t\t} else {\n\t\t\t/* parse all */\n\t\t\twhile (length--) {\n\t\t\t\t/* get argument or error if not found and strict mode enabled. */\n\t\t\t\targRequirement = _xopt_get_arg(arg++, 1, ctx->options, size, &option);\n\t\t\t\tif (!option) {\n\t\t\t\t\tif (ctx->flags & XOPT_CTX_STRICT) {\n\t\t\t\t\t\t_xopt_set_err(err, \"invalid option: -%c\", arg[-1]);\n\t\t\t\t\t}\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\n\t\t\t\tswitch (argRequirement) {\n\t\t\t\tcase 0: /* flag; doesn't take an argument */\n\t\t\t\t\t_xopt_set(data, option, 0, false, err);\n\t\t\t\t\tbreak;\n\t\t\t\tcase 1: /* argument is optional */\n\t\t\t\t\t/* is there another argument, and is it a non-option? */\n\t\t\t\t\tif (*argi + 1 < argc && _xopt_get_size(argv[*argi + 1]) == 0) {\n\t\t\t\t\t\t_xopt_set(data, option, argv[++*argi], false, err);\n\t\t\t\t\t} else {\n\t\t\t\t\t\t_xopt_set(data, option, 0, false, err);\n\t\t\t\t\t}\n\t\t\t\t\tbreak;\n\t\t\t\tcase 2: /* requires an argument */\n\t\t\t\t\t/* is it the last in a set of condensed options? */\n\t\t\t\t\tif (length == 0) {\n\t\t\t\t\t\t/* is there another argument? */\n\t\t\t\t\t\tif (*argi + 1 < argc) {\n\t\t\t\t\t\t\t/* is the next argument actually an option?\n\t\t\t\t\t\t\t\t this indicates no value was passed */\n\t\t\t\t\t\t\tif (_xopt_get_size(argv[*argi + 1])) {\n\t\t\t\t\t\t\t\t_xopt_set_err(err, \"missing option value: -%c\",\n\t\t\t\t\t\t\t\t\t\toption->shortArg);\n\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\t_xopt_set(data, option, argv[++*argi], false, err);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t_xopt_set_err(err, \"missing option value: -%c\",\n\t\t\t\t\t\t\t\t\toption->shortArg);\n\t\t\t\t\t\t}\n\t\t\t\t\t} else {\n\t\t\t\t\t\t_xopt_set_err(err, \"combined short option requiring value is \"\n\t\t\t\t\t\t\t\t\"not last: -%c\", option->shortArg);\n\t\t\t\t\t}\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tbreak;\n\tcase 2: /* long */\n\t\t/* find first equals sign */\n\t\tvalStart = strchr(arg, '=');\n\n\t\t/* is there a value? */\n\t\tif (valStart) {\n\t\t\t/* we also increase valStart here in order to lop off\n\t\t\t\t the equals sign */\n\t\t\tlength = valStart++ - arg;\n\n\t\t\t/* but not really, if it's null */\n\t\t\tif (!*valStart) {\n\t\t\t\tvalStart = 0;\n\t\t\t}\n\t\t}\n\n\t\t/* get the option */\n\t\targRequirement = _xopt_get_arg(arg, length, ctx->options, size, &option);\n\t\tif (!option) {\n\t\t\t_xopt_set_err(err, \"invalid option: --%.*s\", length, arg);\n\t\t} else {\n\t\t\tswitch (argRequirement) {\n\t\t\tcase 0: /* flag; doesn't take an argument */\n\t\t\t\tif (valStart) {\n\t\t\t\t\t_xopt_set_err(err, \"option doesn't take a value: --%s\", arg);\n\t\t\t\t}\n\n\t\t\t\t_xopt_set(data, option, valStart, true, err);\n\t\t\t\tbreak;\n\t\t\tcase 2: /* requires an argument */\n\t\t\t\tif (!valStart) {\n\t\t\t\t\t_xopt_set_err(err, \"missing option value: --%s\", arg);\n\t\t\t\t}\n\t\t\t\tbreak;\n\t\t\t}\n\n\t\t\tif (!*err) {\n\t\t\t\t_xopt_set(data, option, valStart, true, err);\n\t\t\t}\n\t\t}\n\n\t\tbreak;\n\tcase 0: /* extra */\n\t\tisExtra = true;\n\t\tbreak;\n\t}\n\n\treturn isExtra;\n}\n\nstatic void _xopt_assert_increment(const char ***extras, int extrasCount,\n\t\tsize_t *extrasCapac, const char **err) {\n\t/* have we hit the list size limit? */\n\tif ((size_t) extrasCount == *extrasCapac) {\n\t\t/* increase capcity, realloc, and check for success */\n\t\t*extrasCapac += EXTRAS_INIT;\n\t\t*extras = realloc(*extras, sizeof(**extras) * *extrasCapac);\n\t\tif (!*extras) {\n\t\t\t_xopt_set_err(err, \"could not realloc arguments array\");\n\t\t}\n\t}\n}\n\nstatic int _xopt_get_size(const char *arg) {\n\tint size;\n\tfor (size = 0; size < 2; size++) {\n\t\tif (arg[size] != '-') {\n\t\t\tbreak;\n\t\t}\n\t}\n\treturn size;\n}\n\nstatic int _xopt_get_arg(const char *arg, size_t len, const xoptOption *options,\n\t\tint size, const xoptOption **option) {\n\t*option = 0;\n\n\t/* find the argument */\n\tfor (; options[0].longArg || options[0].shortArg; options++) {\n\t\tif (size == 1 && options[0].shortArg == arg[0]) {\n\t\t\t*option = options;\n\t\t\tbreak;\n\t\t} else if (strlen(options[0].longArg) == len &&\n\t\t\t\t!strncmp(options[0].longArg, arg, len)) {\n\t\t\t*option = options;\n\t\t\tbreak;\n\t\t}\n\t}\n\n\t/* determine the optionality of a value */\n\tif (!*option || (*option)->options & XOPT_TYPE_BOOL) {\n\t\treturn 0;\n\t} else if ((*option)->options & XOPT_OPTIONAL) {\n\t\treturn 1;\n\t} else {\n\t\treturn 2;\n\t}\n}\n\nstatic void _xopt_set(void *data, const xoptOption *option, const char *val,\n\t\tbool longArg, const char **err) {\n\t/* determine callback */\n\txoptCallback callback = option->callback ? option->callback : &_xopt_default_callback;\n\n\t/* dispatch callback */\n\tcallback(val, data, option, longArg, err);\n}\n\nstatic void _xopt_default_callback(const char *value, void *data,\n\t\tconst xoptOption *option, bool longArg, const char **err) {\n\tvoid *target;\n\tchar *parsePtr = 0;\n\n\t/* is a value specified? */\n\tif ((!value || !strlen(value)) && !(option->options & XOPT_TYPE_BOOL)) {\n\t\t/* we reach this point when they specified an optional, non-boolean\n\t\t\t option but didn't specify a custom handler (therefore, it's not\n\t\t\t optional).\n\n\t\t\t to fix, just remove the optional flag or specify a callback to handle\n\t\t\t it yourself.\n\t\t\t */\n\t\treturn;\n\t}\n\n\t/* get location */\n\ttarget = ((char*) data) + option->offset;\n\n\t/* switch on the type */\n\tswitch (option->options & 0x3F) {\n\tcase XOPT_TYPE_BOOL:\n\t\t/* booleans are special in that they won't have an argument passed\n\t\t\t into this callback */\n\t\t*((_Bool*) target) = true;\n\t\tbreak;\n\tcase XOPT_TYPE_STRING:\n\t\t/* lifetime here works out fine; argv can usually be assumed static-like\n\t\t\t in nature */\n\t\t*((const char**) target) = value;\n\t\tbreak;\n\tcase XOPT_TYPE_INT:\n\t\t*((int*) target) = (int) strtol(value, &parsePtr, 0);\n\t\tbreak;\n\tcase XOPT_TYPE_LONG:\n\t\t*((long*) target) = strtol(value, &parsePtr, 0);\n\t\tbreak;\n\tcase XOPT_TYPE_FLOAT:\n\t\t*((float*) target) = (float) strtod(value, &parsePtr);\n\t\tbreak;\n\tcase XOPT_TYPE_DOUBLE:\n\t\t*((double*) target) = strtod(value, &parsePtr);\n\t\tbreak;\n\tdefault: /* something wonky, or the implementation specifies two types */\n\t\tfprintf(stderr, \"warning: XOpt argument type invalid: %ld\\n\",\n\t\t\toption->options & 0x2F);\n\t\tbreak;\n\t}\n\n\t/* check that our parsing functions worked */\n\tif (parsePtr && *parsePtr) {\n\t\tif (longArg) {\n\t\t\t_xopt_set_err(err, \"value isn't a valid number: --%s=%s\",\n\t\t\t\t\t(void*) option->longArg, value);\n\t\t} else {\n\t\t\t_xopt_set_err(err, \"value isn't a valid number: -%c %s\",\n\t\t\t\t\toption->shortArg, value);\n\t\t}\n\t}\n}\n\n","numLines":530,"startLine":1,"totalLines":530}}}
