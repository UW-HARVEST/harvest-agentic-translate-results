n    filename: &str,\n    filename_out: &str,\n    flags: i32,\n) -> Option<CompileProcess> {\n    // Try to read the file. If we can't, return None.\n    let data = match fs::read_to_string(filename) {\n        Ok(d) => d,\n        Err(_) => return None,\n    };\n\n    // Open the file as a ClonableFile for fp tracking\n    let fp = ClonableFile::new(filename).ok();\n\n    let ofile = if !filename_out.is_empty() {\n        // Try to create the output file\n        let _ = fs::write(filename_out, \"\");\n        ClonableFile::new(filename_out).ok()\n    } else {\n        None\n    };\n\n    Some(CompileProcess {\n        flags,\n        pos: Pos::default(),\n        cfile: CompileProcessInputFile {\n            fp,\n            abs_path: Some(filename.to_string()),\n            buffer: data.into_bytes(),\n            read_index: 0,\n        },\n        token_vec: None,\n        node_vec: Some(crate::vector::vector_create(std::mem::size_of::<u64>())),\n        node_tree_vec: Some(crate::vector::vector_create(std::mem::size_of::<u64>())),\n        ofile,\n    })\n}\n\n/// Mimics getc() by returning the next character in the process's file buffer.\npub fn compile_process_next_char(lex_process: &mut LexProcess) -> char {\n    let compiler = match lex_process.compiler.as_mut() {\n        Some(c) => c,\n        None => return '\\0',\n    };\n    compiler.pos.col += 1;\n    let buf = &compiler.cfile.buffer;\n    let idx = compiler.cfile.read_index;\n    if idx >= buf.len() {\n        return '\\u{FFFF}'; // EOF\n    }\n    let c = buf[idx] as char;\n    compiler.cfile.read_index += 1;\n    if c == '\\n' {\n        compiler.pos.line += 1;\n        compiler.pos.col = 1;\n    }\n    c\n}\n\n/// Peeks the next character without consuming it, or '\\0' at EOF.\npub fn compile_process_peek_char(lex_process: &mut LexProcess) -> char {\n    let compiler = match lex_process.compiler.as_ref() {\n        Some(c) => c,\n        None => return '\\0',\n    };\n    let buf = &compiler.cfile.buffer;\n    let idx = compiler.cfile.read_index;\n    if idx >= buf.len() {\n        return '\\u{FFFF}';\n    }\n    buf[idx] as char\n}\n\n/// Ungets a character by moving the position back by one.\npub fn compile_process_push_char(lex_process: &mut LexProcess, _c: char) {\n    let compiler = match lex_process.compiler.as_mut() {\n        Some(c) => c,\n        None => return,\n    };\n    if compiler.cfile.read_index > 0 {\n        compiler.cfile.read_index -= 1;\n    }\n}\n","userModified":false}}
