|l| l.str_len)\n                .unwrap_or(0);\n\n            cur_line_required_rows =\n                VirtualScreen::required_screen_rows(line_str_len, screen.width);\n\n            if (cur_line_required_rows + cumul_req_rows) as i64 > (screen.height as i64) - 1 {\n                if cur_line > 0 {\n                    cur_line -= 1;\n                }\n                break;\n            }\n\n            cumul_req_rows += cur_line_required_rows;\n            cur_line += 1;\n        }\n\n        if buffer_cursor_x > cur_line {\n            let mut rows_required: i32 = 0;\n\n            let mut walker = cur_line;\n            while walker <= buffer_cursor_x {\n                let line_str_len = buffer\n                    .lines\n                    .get(walker)\n                    .and_then(|opt| opt.as_ref())\n                    .map(|l| l.str_len)\n                    .unwrap_or(0);\n                rows_required +=\n                    VirtualScreen::required_screen_rows(line_str_len, screen.width);\n                walker += 1;\n            }\n\n            while rows_required > 0 {\n                let line_str_len = buffer\n                    .lines\n                    .get(screen.render_start_line)\n                    .and_then(|opt| opt.as_ref())\n                    .map(|l| l.str_len)\n                    .unwrap_or(0);\n                rows_required -=\n                    VirtualScreen::required_screen_rows(line_str_len, screen.width);\n                screen.render_start_line += 1;\n            }\n        }\n    }\n}\npub fn draw_editor_window(buffer: &TextBuffer, screen: &mut VirtualScreen) {\n    let mut cur_line = screen.render_start_line;\n    let mut lines_written: usize = 0;\n\n    while cur_line <= buffer.last_line_loc && lines_written + 1 < screen.height {\n        let screen_cols = screen.width;\n        let line = match buffer.get_line(cur_line) {\n            Some(l) => l,\n            None => {\n                crate::defs::panic(\"draw editor cant get text of current line in buffer\");\n                return;\n            }\n        };\n\n        if line.len() > screen_cols {\n            let bytes = line.as_bytes();\n            let mut i: usize = 0;\n            loop {\n                let remaining = bytes.len() - i;\n                let len_to_write = if screen_cols < remaining {\n                    screen_cols\n                } else {\n                    remaining\n                };\n\n                let slice = &line[i..i + len_to_write];\n                screen.screen_append(slice, len_to_write);\n                screen.screen_append(\"\\r\\n\", 2);\n                screen.screen_append(\"\\x1b[K\", 3);\n                i += len_to_write;\n                lines_written += 1;\n\n                if lines_written + 2 == screen.height {\n                    break;\n                }\n\n                if i >= bytes.len().saturating_sub(1) {\n                    break;\n                }\n            }\n        } else {\n            let len = line.len();\n            screen.screen_append(&line, len);\n            screen.screen_append(\"\\r\\n\", 2);\n            lines_written += 1;\n        }\n\n        cur_line += 1;\n    }\n\n    while lines_written + 2 < screen.height {\n        screen.screen_append(\"\\r\\n\", 2);\n        lines_written += 1;\n    }\n}\npub fn set_virtual_cursor_position(buffer: &TextBuffer, screen: &mut VirtualScreen) {\n    let mut current_line = screen.render_start_line;\n    let mut virtual_cursor_row: i32 = 1;\n\n    while current_line != buffer.cursor_row {\n        let line_str_len = buffer\n            .lines\n            .get(current_line)\n            .and_then(|opt| opt.as_ref())\n            .map(|l| l.str_len)\n            .unwrap_or(0);\n        let required_rows = VirtualScreen::required_screen_rows(line_str_len, screen.width);\n        virtual_cursor_row += required_rows;\n        current_line += 1;\n    }\n\n    if screen.width > 0 {\n        virtual_cursor_row += (buffer.cursor_col / screen.width) as i32;\n        screen.cursor.x = virtual_cursor_row as usize;\n        screen.cursor.y = (buffer.cursor_col % screen.width) + 1;\n    } else {\n        screen.cursor.x = virtual_cursor_row as usize;\n        screen.cursor.y = buffer.cursor_col + 1;\n    }\n}\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1465,"cache_read_input_tokens":58965,"cache_creation":{"ephemeral_5m_input_tokens":1465,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0bb83036-4037-40a2-905a-2aca87fa710f","uuid":"ad8f3745-8d74-4a81-92ea-632a41f5ca95"}
