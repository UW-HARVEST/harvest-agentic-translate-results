n50\tstatic char *\n51\tread_file(char *fname)\n52\t{\n53\t\tchar buf[BUFSIZ], *file = NULL;\n54\t\tint len = 0, n, fd, parens = 0;\n55\t\tif (!fname) /* read from stdin if no file given */\n56\t\t\tfd = 0;\n57\t\telse if ((fd = open(fname, O_RDONLY)) < 0)\n58\t\t\ttsp_warnf(\"could not find file '%s'\", fname);\n59\t\twhile ((n = read(fd, buf, sizeof(buf))) > 0) {\n60\t\t\tfile = realloc(file, len + n + 1);\n61\t\t\tif (!file) perror(\"; realloc\"), exit(1);\n62\t\t\tmemcpy(file + len, buf, n);\n63\t\t\tlen += n;\n64\t\t\tfile[len] = '\\0';\n65\t\t\tif (fd == 0 && (parens += count_parens(buf, n)) <= 0)\n66\t\t\t\tbreak;\n67\t\t}\n68\t\tif (fd) /* close file if not stdin */\n69\t\t\tclose(fd);\n70\t\tif (n < 0)\n71\t\t\ttsp_warnf(\"could not read file '%s'\", fname);\n72\t\treturn file;\n73\t}\n74\t\n75\t/* write all arguemnts to given file, or stdout/stderr, without newline */\n76\t/* first argument is file name, second is option to append file */\n77\tstatic Val\n78\tprim_write(Tsp st, Rec env, Val args)\n79\t{\n80\t\tFILE *f;\n81\t\tconst char *mode = \"w\";\n82\t\ttsp_arg_min(args, \"write\", 2);\n83\t\n84\t\t/* if second argument is true, append file don't write over */\n85\t\tif (!nilp(cadr(args)))\n86\t\t\tmode = \"a\";\n87\t\t/* first argument can either be the symbol stdout or stderr, or the file as a string */\n88\t\tif (car(args)->t == TSP_SYM)\n89\t\t\tf = !strncmp(car(args)->v.s, \"stdout\", 7) ? stdout : stderr;\n90\t\telse if (car(args)->t != TSP_STR)\n91\t\t\ttsp_warnf(\"write: expected file name as string, received %s\",\n92\t\t\t           tsp_type_str(car(args)->t));\n93\t\telse if (!(f = fopen(car(args)->v.s, mode)))\n94\t\t\ttsp_warnf(\"write: could not load file '%s'\", car(args)->v.s);\n95\t\tif (f == stderr && strncmp(car(args)->v.s, \"stderr\", 7)) /* validate stderr symbol */\n96\t\t\ttsp_warn(\"write: expected file name as string, or symbol stdout/stderr\");\n97\t\n98\t\tfor (args = cddr(args); !nilp(args); args = cdr(args))\n99\t\t\ttisp_print(f, car(args));\n100\t\n101\t\tif (f == stdout || f == stderr) /* clean up */\n102\t\t\tfflush(f);\n103\t\telse\n104\t\t\tfclose(f);\n105\t\treturn st->none;\n106\t}\n107\t\n108\t/* return string of given file or read from stdin */\n109\tstatic Val\n110\tprim_read(Tsp st, Rec env, Val args)\n111\t{\n112\t\tchar *file, *fname = NULL; /* read from stdin by default */\n113\t\ttsp_arg_max(args, \"read\", 1);\n114\t\tif (tsp_lstlen(args) == 1) { /* if file name given as string, read it */\n115\t\t\ttsp_arg_type(car(args), \"read\", TSP_STR);\n116\t\t\tfname = car(args)->v.s;\n117\t\t}\n118\t\tif (!(file = read_file(fname)))\n119\t\t\treturn st->nil;\n120\t\treturn mk_str(st, file);\n121\t}\n122\t\n123\t/* parse string as tisp expression, return 'quit if given no arguments */\n124\tstatic Val\n125\tprim_parse(Tsp st, Rec env, Val args)\n126\t{\n127\t\tVal ret, expr;\n128\t\tchar *file = st->file;\n129\t\tsize_t filec = st->filec;\n130\t\ttsp_arg_num(args, \"parse\", 1);\n131\t\texpr = car(args);\n132\t\tif (nilp(expr))\n133\t\t\treturn mk_sym(st, \"quit\");\n134\t\ttsp_arg_type(expr, \"parse\", TSP_STR);\n135\t\tst->file = expr->v.s;\n136\t\tst->filec = 0;\n137\t\tret = mk_pair(mk_sym(st, \"do\"), st->nil);\n138\t\tfor (Val pos = ret; tsp_fget(st) && (expr = tisp_read_line(st, 0)); pos = cdr(pos))\n139\t\t\tcdr(pos) = mk_pair(expr, st->nil);\n140\t\tst->file = file;\n141\t\tst->filec = filec;\n142\t\tif (cdr(ret)->t == TSP_PAIR && nilp(cddr(ret)))\n143\t\t\treturn cadr(ret); /* if only 1 expression parsed, return just it */\n144\t\treturn ret;\n145\t}\n146\t\n147\t/* loads tisp file or C dynamic library */\n148\tstatic Val\n149\tprim_load(Tsp st, Rec env, Val args)\n150\t{\n151\t\tVal tib;\n152\t\tvoid (*tibenv)(Tsp);\n153\t\tchar name[PATH_MAX];\n154\t\tconst char *paths[] = {\n155\t\t\t\"/usr/local/lib/tisp/pkgs/\", \"/usr/lib/tisp/pkgs/\", \"./\", NULL\n156\t\t};\n157\t\n158\t\ttsp_arg_num(args, \"load\", 1);\n159\t\ttib = car(args);\n160\t\ttsp_arg_type(tib, \"load\", TSP_STR);\n161\t\n162\t\tfor (int i = 0; paths[i]; i++) {\n163\t\t\tstrcpy(name, paths[i]);\n164\t\t\tstrcat(name, tib->v.s);\n165\t\t\tstrcat(name, \".tsp\");\n166\t\t\tif (access(name, R_OK) != -1) {\n167\t\t\t\tchar *file = read_file(name);\n168\t\t\t\tVal body = prim_parse(st, env, mk_pair(mk_sym(st, file), st->nil));\n169\t\t\t\ttisp_eval_body(st, env, body);\n170\t\t\t\treturn st->none;\n171\t\t\t}\n172\t\t}\n173\t\n174\t\t/* If not tisp file, try loading shared object library */\n175\t\tif (!(st->libh = realloc(st->libh, (st->libhc+1)*sizeof(void*))))\n176\t\t\tperror(\"; realloc\"), exit(1);\n177\t\n178\t\tmemset(name, 0, sizeof(name));\n179\t\tstrcpy(name, \"libtib\");\n180\t\tstrcat(name, tib->v.s);\n181\t\tstrcat(name, \".so\");\n182\t\tif (!(st->libh[st->libhc] = dlopen(name, RTLD_LAZY)))\n183\t\t\ttsp_warnf(\"load: could not load '%s':\\n; %s\", tib->v.s, dlerror());\n184\t\tdlerror();\n185\t\n186\t\tmemset(name, 0, sizeof(name));\n187\t\tstrcpy(name, \"tib_env_\");\n188\t\tstrcat(name, tib->v.s);\n189\t\ttibenv = dlsym(st->libh[st->libhc], name);\n190\t\tif (dlerror())\n191\t\t\ttsp_warnf(\"load: could not run '%s':\\n; %s\", tib->v.s, dlerror());\n192\t\t(*tibenv)(st);\n193\t\n194\t\tst->libhc++;\n195\t\treturn st->none;\n196\t}\n197\t\n198\tvoid\n199\ttib_env_io(Tsp st)\n200\t{\n201\t\ttsp_env_prim(write);\n202\t\ttsp_env_prim(read);\n203\t\ttsp_env_prim(parse);\n204\t\ttsp_env_prim(load);\n205\t}\n206\t"}]},"parent_tool_use_id":null,"session_id":"bbbed319-77f1-4a7c-81a0-9633fc0e4d7f","uuid":"d1de2179-ea5f-4b3e-99f4-066b5aa63b24","timestamp":"2026-06-06T02:15:03.844Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-QWvQzg/project/c_src/tib/io.c","content":"/* zlib License\n *\n * Copyright (c) 2017-2025 Ed van Bruggen\n *\n * This software is provided 'as-is', without any express or implied\n * warranty.  In no event will the authors be held liable for any damages\n * arising from the use of this software