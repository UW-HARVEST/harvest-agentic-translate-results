{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FSswYHh8KqdbvZuZt7fM5J","type":"tool_result","content":"1\t//! Author-blinded RSASSA-PSS RSAE signatures.\n2\t//!\n3\t//! This is an implementation of the [RSA Blind Signatures](https://www.rfc-editor.org/rfc/rfc9474.html) (RFC 9474), based on [the Zig implementation](https://github.com/jedisct1/zig-rsa-blind-signatures).\n4\t//!\n5\t//! ```rust\n6\t//! use blind_rsa_signatures::{KeyPair, Sha384, PSS, Randomized, DefaultRng};\n7\t//!\n8\t//! // [SERVER]: Generate a RSA-2048 key pair\n9\t//! let kp = KeyPair::<Sha384, PSS, Randomized>::generate(&mut DefaultRng, 2048)?;\n10\t//! let (pk, sk) = (kp.pk, kp.sk);\n11\t//!\n12\t//! // [CLIENT]: create a random message and blind it for the server whose public key is `pk`.\n13\t//! // The client must store the message and the secret.\n14\t//! let msg = b\"test\";\n15\t//! let blinding_result = pk.blind(&mut DefaultRng, msg)?;\n16\t//!\n17\t//! // [SERVER]: compute a signature for a blind message, to be sent to the client.\n18\t//! // The client secret should not be sent to the server.\n19\t//! let blind_sig = sk.blind_sign(&blinding_result.blind_message)?;\n20\t//!\n21\t//! // [CLIENT]: later, when the client wants to redeem a signed blind message,\n22\t//! // using the blinding secret, it can locally compute the signature of the\n23\t//! // original message.\n24\t//! // The client then owns a new valid (message, signature) pair, and the\n25\t//! // server cannot link it to a previous (blinded message, blind signature) pair.\n26\t//! // Note that the finalization function also verifies that the new signature\n27\t//! // is correct for the server public key.\n28\t//! let sig = pk.finalize(&blind_sig, &blinding_result, msg)?;\n29\t//!\n30\t//! // [SERVER]: a non-blind signature can be verified using the server's public key.\n31\t//! pk.verify(&sig, blinding_result.msg_randomizer, msg)?;\n32\t//! # Ok::<(), blind_rsa_signatures::Error>(())\n33\t//! ```\n34\t\n35\t#[macro_use]\n36\textern crate derive_new;\n37\t\n38\tuse std::convert::{Infallible, TryFrom};\n39\tuse std::fmt::{self, Display};\n40\tuse std::marker::PhantomData;\n41\tuse std::mem;\n42\t\n43\tuse crypto_bigint::{BoxedUint, Gcd};\n44\tuse derive_more::{AsRef, Debug, Deref, From, Into};\n45\t\n46\tuse digest::{typenum::Unsigned, DynDigest, OutputSizeUser};\n47\tuse hmac_sha256::Hash as Sha256Hash;\n48\tuse hmac_sha512::sha384::Hash as Sha384Hash;\n49\tuse hmac_sha512::Hash as Sha512Hash;\n50\tuse rsa::hazmat::rsa_decrypt_and_check;\n51\tuse rsa::pkcs1::{DecodeRsaPrivateKey as _, DecodeRsaPublicKey as _};\n52\tuse rsa::pkcs8::{\n53\t    DecodePrivateKey as _, DecodePublicKey as _, EncodePrivateKey as _, EncodePublicKey as _,\n54\t};\n55\tuse rsa::rand_core::{CryptoRng, TryCryptoRng, TryRng};\n56\tuse rsa::signature::hazmat::PrehashVerifier;\n57\tuse rsa::traits::PublicKeyParts as _;\n58\tuse rsa::{RsaPrivateKey, RsaPublicKey};\n59\t\n60\tmod brsa;\n61\tmod mgf1;\n62\tpub mod pbrsa;\n63\t\n64\tmod private {\n65\t    pub trait Sealed {}\n66\t}\n67\t\n68\tuse brsa::{blind as rsa_blind, unblind as rsa_unblind};\n69\tuse mgf1::mgf1_xor;\n70\t\n71\t#[cfg(feature = \"serde\")]\n72\tuse serde::{Deserialize, Serialize};\n73\t\n74\tpub mod reexports {\n75\t    pub use {crypto_bigint, digest, hmac_sha256, hmac_sha512, rand, rsa};\n76\t}\n77\t\n78\t/// Returns the byte representation of a BoxedUint in big-endian byte order,\n79\t/// left-padding the number with zeroes to the specified length.\n80\tfn to_bytes_be_padded(n: &BoxedUint, len: usize) -> Vec<u8> {\n81\t    let bytes = n.to_be_bytes();\n82\t    if len > bytes.len() {\n83\t        let mut result = vec![0u8; len];\n84\t        result[len - bytes.len()..].copy_from_slice(&bytes);\n85\t        result\n86\t    } else {\n87\t        bytes.to_vec()\n88\t    }\n89\t}\n90\t\n91\t#[derive(Debug, Copy, Clone, Eq, PartialEq)]\n92\tpub enum Error {\n93\t    InternalError,\n94\t    UnsupportedParameters,\n95\t    VerificationFailed,\n96\t    EncodingError,\n97\t    InvalidKey,\n98\t    IncompatibleParameters,\n99\t}\n100\t\n101\timpl std::error::Error for Error {}\n102\t\n103\timpl Display for Error {\n104\t    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n105\t        match self {\n106\t            Error::InternalError => write!(f, \"Internal Error\"),\n107\t            Error::UnsupportedParameters => write!(f, \"Unsupported parameters\"),\n108\t            Error::VerificationFailed => write!(f, \"Verification failed\"),\n109\t            Error::EncodingError => write!(f, \"Encoding error\"),\n110\t            Error::InvalidKey => write!(f, \"Invalid key\"),\n111\t            Error::IncompatibleParameters => write!(f, \"Incompatible parameters\"),\n112\t        }\n113\t    }\n114\t}\n115\t\n116\timpl AsRef<[u8]> for Error {\n117\t    fn as_ref(&self) -> &[u8] {\n118\t        match self {\n119\t            Error::InternalError => b\"Internal Error\",\n120\t            Error::UnsupportedParameters => b\"Unsupported parameters\",\n121\t            Error::VerificationFailed => b\"Verification failed\",\n122\t            Error::EncodingError => b\"Encoding error\",\n123\t            Error::InvalidKey => b\"Invalid key\",\n124\t            Error::IncompatibleParameters => b\"Incompatible parameters\",\n125\t        }\n126\t    }\n127\t}\n128\t\n129\tpub trait HashAlgorithm: Clone + Default {\n130\t    /// Salt length for PSS padding (equals hash output length)\n131\t    const SALT_LEN: usize;\n132\t    /// OID byte for SPKI encoding (1=SHA256, 2=SHA384, 3=SHA512)\n133\t    const OID_BYTE: u8;\n134\t    /// Algorithm name as bytes\n135\t    const NAME: &'static [u8];\n136\t\n137\t    /// Create a new boxed hasher\n138\t    fn new_hasher() -> Box<dyn DynDigest>;\n139\t\n140\t    /// Hash a message with an optional prefix\n141\t    fn hash_message(prefix: Option<&[u8]>, msg: &[u8]) -> Vec<u8> {\n142\t        let mut h = Self::new_hasher();\n143\t        if let Some(p) = prefix {\n144\t            h.update(p);\n145\t        }\n146\t        h.update(msg);\n147\t        h.finalize().to_vec()\n148\t    }\n149\t\n150\t    /// Verify a prehashed signature\n151\t    fn verify_prehash(\n152\t        pk: &RsaPublicKey,\n153\t        salt_len: usize,\n154\t        msg_hash: &[u8],\n155\t        sig: &rsa::pss::Signature,\n156\t    ) -> Result<(), rsa::signature::Error>;\n157\t\n158\t    /// HKDF key derivation for PBRSA\n159\t    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]);\n160\t}\n161\t\n162\t/// SHA-256 hash algorithm\n163\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n164\tpub struct Sha256;\n165\t\n166\timpl HashAlgorithm for Sha256 {\n167\t    const SALT_LEN: usize = <<Sha256Hash as OutputSizeUser>::OutputSize as Unsigned>::USIZE;\n168\t    const OID_BYTE: u8 = 1;\n169\t    const NAME: &'static [u8] = b\"sha256\";\n170\t\n171\t    fn new_hasher() -> Box<dyn DynDigest> {\n172\t        Box::new(Sha256Hash::new())\n173\t    }\n174\t\n175\t    fn verify_prehash(\n176\t        pk: &RsaPublicKey,\n177\t        salt_len: usize,\n178\t        msg_hash: &[u8],\n179\t        sig: &rsa::pss::Signature,\n180\t    ) -> Result<(), rsa::signature::Error> {\n181\t        rsa::pss::VerifyingKey::<Sha256Hash>::new_with_salt_len(pk.clone(), salt_len)\n182\t            .verify_prehash(msg_hash, sig)\n183\t    }\n184\t\n185\t    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]) {\n186\t        let prk = hmac_sha256::HKDF::extract(salt, ikm);\n187\t        hmac_sha256::HKDF::expand(out, prk, info);\n188\t    }\n189\t}\n190\t\n191\t/// SHA-384 hash algorithm\n192\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n193\tpub struct Sha384;\n194\t\n195\timpl HashAlgorithm for Sha384 {\n196\t    const SALT_LEN: usize = <<Sha384Hash as OutputSizeUser>::OutputSize as Unsigned>::USIZE;\n197\t    const OID_BYTE: u8 = 2;\n198\t    const NAME: &'static [u8] = b\"sha384\";\n199\t\n200\t    fn new_hasher() -> Box<dyn DynDigest> {\n201\t        Box::new(Sha384Hash::new())\n202\t    }\n203\t\n204\t    fn verify_prehash(\n205\t        pk: &RsaPublicKey,\n206\t        salt_len: usize,\n207\t        msg_hash: &[u8],\n208\t        sig: &rsa::pss::Signature,\n209\t    ) -> Result<(), rsa::signature::Error> {\n210\t        rsa::pss::VerifyingKey::<Sha384Hash>::new_with_salt_len(pk.clone(), salt_len)\n211\t            .verify_prehash(msg_hash, sig)\n212\t    }\n213\t\n214\t    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]) {\n215\t        let prk = hmac_sha512::sha384::HKDF::extract(salt, ikm);\n216\t        hmac_sha512::sha384::HKDF::expand(out, prk, info);\n217\t    }\n218\t}\n219\t\n220\t/// SHA-512 hash algorithm\n221\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n222\tpub struct Sha512;\n223\t\n224\timpl HashAlgorithm for Sha512 {\n225\t    const SALT_LEN: usize = <<Sha512Hash as OutputSizeUser>::OutputSize as Unsigned>::USIZE;\n226\t    const OID_BYTE: u8 = 3;\n227\t    const NAME: &'static [u8] = b\"sha512\";\n228\t\n229\t    fn new_hasher() -> Box<dyn DynDigest> {\n230\t        Box::new(Sha512Hash::new())\n231\t    }\n232\t\n233\t    fn verify_prehash(\n234\t        pk: &RsaPublicKey,\n235\t        salt_len: usize,\n236\t        msg_hash: &[u8],\n237\t        sig: &rsa::pss::Signature,\n238\t    ) -> Result<(), rsa::signature::Error> {\n239\t        rsa::pss::VerifyingKey::<Sha512Hash>::new_with_salt_len(pk.clone(), salt_len)\n240\t            .verify_prehash(msg_hash, sig)\n241\t    }\n242\t\n243\t    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]) {\n244\t        let prk = hmac_sha512::HKDF::extract(salt, ikm);\n245\t        hmac_sha512::HKDF::expand(out, prk, info);\n246\t    }\n247\t}\n248\t\n249\t/// Trait for PSS salt mode (compile-time parameter)\n250\t/// The only valid implementations are [`PSS`] and [`PSSZero`].\n251\tpub trait SaltMode: Clone + Default + private::Sealed {\n252\t    /// Whether salt is used\n253\t    const USE_SALT: bool;\n254\t\n255\t    /// Get salt length for a given hash algorithm\n256\t    fn salt_len<H: HashAlgorithm>() -> usize {\n257\t        if Self::USE_SALT {\n258\t            H::SALT_LEN\n259\t        } else {\n260\t            0\n261\t        }\n262\t    }\n263\t}\n264\t\n265\t/// PSS mode with salt (salt length = hash output length)\n266\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n267\tpub struct PSS;\n268\t\n269\timpl private::Sealed for PSS {}\n270\t\n271\timpl SaltMode for PSS {\n272\t    const USE_SALT: bool = true;\n273\t}\n274\t\n275\t/// PSS mode without salt (salt length = 0)\n276\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n277\tpub struct PSSZero;\n278\t\n279\timpl private::Sealed for PSSZero {}\n280\t\n281\timpl SaltMode for PSSZero {\n282\t    const USE_SALT: bool = false;\n283\t}\n284\t\n285\t/// Trait for message preparation mode (compile-time parameter)\n286\t/// The only valid implementations are [`Randomized`] and [`Deterministic`].\n287\tpub trait MessagePrepare: Clone + Default + private::Sealed {\n288\t    /// Whether to randomize the message with a 32-byte prefix\n289\t    const RANDOMIZE: bool;\n290\t}\n291\t\n292\t/// Randomized message preparation\n293\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n294\tpub struct Randomized;\n295\t\n296\timpl private::Sealed for Randomized {}\n297\t\n298\timpl MessagePrepare for Randomized {\n299\t    const RANDOMIZE: bool = true;\n300\t}\n301\t\n302\t/// Deterministic message preparation\n303\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n304\tpub struct Deterministic;\n305\t\n306\timpl private::Sealed for Deterministic {}\n307\t\n308\timpl MessagePrepare for Deterministic {\n309\t    const RANDOMIZE: bool = false;\n310\t}\n311\t\n312\t/// Default random number generator\n313\t#[derive(Debug, Default, Clone, Copy, Eq, PartialEq)]\n314\tpub struct DefaultRng;\n315\t\n316\timpl TryRng for DefaultRng {\n317\t    type Error = Infallible;\n318\t\n319\t    fn try_next_u32(&mut self) -> Result<u32, Self::Error> {\n320\t        Ok(rand::random())\n321\t    }\n322\t\n323\t    fn try_next_u64(&mut self) -> Result<u64, Self::Error> {\n324\t        Ok(rand::random())\n325\t    }\n326\t\n327\t    fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), Self::Error> {\n328\t        rand::fill(dest);\n329\t        Ok(())\n330\t    }\n331\t}\n332\t\n333\timpl TryCryptoRng for DefaultRng {}\n334\t\n335\t/// A blinding secret factor\n336\t#[derive(Clone, Debug, AsRef, Deref, From, Into, new)]\n337\tpub struct Secret(pub Vec<u8>);\n338\t\n339\timpl Eq for Secret {}\n340\t\n341\timpl PartialEq for Secret {\n342\t    fn eq(&self, other: &Self) -> bool {\n343\t        ct_codecs::verify(&self.0, &other.0)\n344\t    }\n345\t}\n346\t\n347\t/// A blind message\n348\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n349\t#[derive(Clone, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\n350\tpub struct BlindMessage(pub Vec<u8>);\n351\t\n352\t/// A blind signature\n353\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n354\t#[derive(Clone, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\n355\tpub struct BlindSignature(pub Vec<u8>);\n356\t\n357\t/// A (non-blind) signature\n358\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n359\t#[derive(Clone, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\n360\tpub struct Signature(pub Vec<u8>);\n361\t\n362\t/// A message randomizer (noise added as a prefix to the message)\n363\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n364\t#[derive(Clone, Copy, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\n365\tpub struct MessageRandomizer(pub [u8; 32]);\n366\t\n367\t/// Result of a blinding operation\n368\t#[derive(Clone, Debug)]\n369\tpub struct BlindingResult {\n370\t    pub blind_message: BlindMessage,\n371\t    pub secret: Secret,\n372\t    pub msg_randomizer: Option<MessageRandomizer>,\n373\t}\n374\t\n375\timpl Eq for BlindingResult {}\n376\t\n377\timpl PartialEq for BlindingResult {\n378\t    fn eq(&self, other: &Self) -> bool {\n379\t        self.blind_message == other.blind_message\n380\t            && self.secret == other.secret\n381\t            && self.msg_randomizer == other.msg_randomizer\n382\t    }\n383\t}\n384\t\n385\timpl AsRef<[u8]> for Secret {\n386\t    fn as_ref(&self) -> &[u8] {\n387\t        self.0.as_slice()\n388\t    }\n389\t}\n390\t\n391\timpl AsRef<[u8]> for BlindMessage {\n392\t    fn as_ref(&self) -> &[u8] {\n393\t        self.0.as_slice()\n394\t    }\n395\t}\n396\t\n397\timpl AsRef<[u8]> for BlindSignature {\n398\t    fn as_ref(&self) -> &[u8] {\n399\t        self.0.as_slice()\n400\t    }\n401\t}\n402\t\n403\timpl AsRef<[u8]> for Signature {\n404\t    fn as_ref(&self) -> &[u8] {\n405\t        self.0.as_slice()\n406\t    }\n407\t}\n408\t\n409\timpl AsRef<[u8]> for MessageRandomizer {\n410\t    fn as_ref(&self) -> &[u8] {\n411\t        self.0.as_ref()\n412\t    }\n413\t}\n414\t\n415\timpl AsRef<[u8]> for BlindingResult {\n416\t    fn as_ref(&self) -> &[u8] {\n417\t        self.blind_message.as_ref()\n418\t    }\n419\t}\n420\t\n421\tfn check_rsa_parameters(pk: &RsaPublicKey) -> Result<(), Error> {\n422\t    let modulus_bits = pk.size() * 8;\n423\t    if !(2048..=4096).contains(&modulus_bits) {\n424\t        return Err(Error::UnsupportedParameters);\n425\t    }\n426\t    let e = pk.e();\n427\t    let e3 = BoxedUint::from(3u32);\n428\t    let ef4 = BoxedUint::from(65537u32);\n429\t    if e != &e3 && e != &ef4 {\n430\t        return Err(Error::UnsupportedParameters);\n431\t    }\n432\t    Ok(())\n433\t}\n434\t\n435\t#[allow(clippy::identity_op)]\n436\tconst fn spki_tpl() -> &'static [u8] {\n437\t    const SEQ: u8 = 0x30;\n438\t    const EXT: u8 = 0x80;\n439\t    const CON: u8 = 0xa0;\n440\t    const INT: u8 = 0x02;\n441\t    const BIT: u8 = 0x03;\n442\t    const OBJ: u8 = 0x06;\n443\t    const TPL: &[u8] = &[\n444\t        SEQ,\n445\t        EXT | 2,\n446\t        0,\n447\t        0, // container length - offset 2\n448\t        SEQ,\n449\t        61, // Algorithm sequence\n450\t        OBJ,\n451\t        9,\n452\t        0x2a,\n453\t        0x86,\n454\t        0x48,\n455\t        0x86,\n456\t        0xf7,\n457\t        0x0d,\n458\t        0x01,\n459\t        0x01,\n460\t        0x0a, // Signature algorithm (RSASSA-PSS)\n461\t        SEQ,\n462\t        48, // RSASSA-PSS parameters sequence\n463\t        CON | 0,\n464\t        2 + 2 + 9,\n465\t        SEQ,\n466\t        2 + 9,\n467\t        OBJ,\n468\t        9,\n469\t        0,\n470\t        0,\n471\t        0,\n472\t        0,\n473\t        0,\n474\t        0,\n475\t        0,\n476\t        0,\n477\t        0, // Hash function - offset 21\n478\t        CON | 1,\n479\t        2 + 24,\n480\t        SEQ,\n481\t        24,\n482\t        OBJ,\n483\t        9,\n484\t        0x2a,\n485\t        0x86,\n486\t        0x48,\n487\t        0x86,\n488\t        0xf7,\n489\t        0x0d,\n490\t        0x01,\n491\t        0x01,\n492\t        0x08, // Padding function (MGF1) and parameters\n493\t        SEQ,\n494\t        2 + 9,\n495\t        OBJ,\n496\t        9,\n497\t        0,\n498\t        0,\n499\t        0,\n500\t        0,\n501\t        0,\n502\t        0,\n503\t        0,\n504\t        0,\n505\t        0, // MGF1 hash function - offset 49\n506\t        CON | 2,\n507\t        2 + 1,\n508\t        INT,\n509\t        1,\n510\t        0, // Salt length - offset 66\n511\t        BIT,\n512\t        EXT | 2,\n513\t        0,\n514\t        0, // Public key length - Bit string - offset 69\n515\t        0, // No partial bytes\n516\t    ];\n517\t    TPL\n518\t}\n519\t\n520\tfn emsa_pss_encode(\n521\t    m_hash: &[u8],\n522\t    em_bits: usize,\n523\t    salt: &[u8],\n524\t    hash: &mut dyn DynDigest,\n525\t) -> Result<Vec<u8>, Error> {\n526\t    let h_len = hash.output_size();\n527\t    let s_len = salt.len();\n528\t    let em_len = em_bits.div_ceil(8);\n529\t    if m_hash.len() != h_len {\n530\t        return Err(Error::InternalError);\n531\t    }\n532\t    if em_len < h_len + s_len + 2 {\n533\t        return Err(Error::InternalError);\n534\t    }\n535\t    let mut em = vec![0; em_len];\n536\t    let (db, h) = em.split_at_mut(em_len - h_len - 1);\n537\t    let h = &mut h[..h_len];\n538\t    let prefix = [0u8; 8];\n539\t    hash.update(&prefix);\n540\t    hash.update(m_hash);\n541\t    hash.update(salt);\n542\t    let hashed = hash.finalize_reset();\n543\t    h.copy_from_slice(&hashed);\n544\t    db[em_len - s_len - h_len - 2] = 0x01;\n545\t    db[em_len - s_len - h_len - 1..].copy_from_slice(salt);\n546\t    mgf1_xor(db, hash, h);\n547\t    db[0] &= 0xff >> (8 * em_len - em_bits);\n548\t    em[em_len - 1] = 0xbc;\n549\t    Ok(em)\n550\t}\n551\t\n552\t/// Blind RSA signatures with compile-time parameters.\n553\t///\n554\t/// This mirrors the Zig API where `BlindRsa` returns a type containing\n555\t/// `PublicKey`, `SecretKey`, and `KeyPair` with methods for the protocol.\n556\t///\n557\t/// Type parameters:\n558\t/// - `H`: Hash algorithm ([`Sha256`], [`Sha384`], [`Sha512`])\n559\t/// - `S`: Salt mode ([`PSS`], [`PSSZero`])\n560\t/// - `M`: Message preparation mode ([`Randomized`], [`Deterministic`])\n561\t///\n562\t/// # Example\n563\t///\n564\t/// ```rust\n565\t/// use blind_rsa_signatures::{BlindRsa, Sha384, PSS, Randomized};\n566\t///\n567\t/// type BRsa = BlindRsa<Sha384, PSS, Randomized>;\n568\t/// ```\n569\t#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\n570\tpub struct BlindRsa<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> {\n571\t    _phantom: PhantomData<(H, S, M)>,\n572\t}\n573\t\n574\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> BlindRsa<H, S, M> {\n575\t    /// Get the salt length for this configuration\n576\t    pub const fn salt_len() -> usize {\n577\t        if S::USE_SALT {\n578\t            H::SALT_LEN\n579\t        } else {\n580\t            0\n581\t        }\n582\t    }\n583\t\n584\t    /// Check if this configuration uses randomized message preparation\n585\t    pub const fn is_randomized() -> bool {\n586\t        M::RANDOMIZE\n587\t    }\n588\t}\n589\t\n590\t/// Type alias for PublicKey with the same parameters as BlindRsa\n591\tpub type BlindRsaPublicKey<H, S, M> = PublicKey<H, S, M>;\n592\t\n593\t/// Type alias for SecretKey with the same parameters as BlindRsa\n594\tpub type BlindRsaSecretKey<H, S, M> = SecretKey<H, S, M>;\n595\t\n596\t/// Type alias for KeyPair with the same parameters as BlindRsa\n597\tpub type BlindRsaKeyPair<H, S, M> = KeyPair<H, S, M>;\n598\t\n599\t/// An RSA public key\n600\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n601\t#[derive(Clone, Debug, Eq, PartialEq)]\n602\tpub struct PublicKey<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> {\n603\t    inner: RsaPublicKey,\n604\t    _phantom: PhantomData<(H, S, M)>,\n605\t}\n606\t\n607\t/// Provides access to the raw RSA public key components.\n608\tpub struct PublicKeyComponents<'a> {\n609\t    inner: &'a RsaPublicKey,\n610\t}\n611\t\n612\timpl PublicKeyComponents<'_> {\n613\t    /// Returns the modulus (n) as big-endian bytes.\n614\t    pub fn n(&self) -> Vec<u8> {\n615\t        use rsa::traits::PublicKeyParts;\n616\t        self.inner.n().as_ref().to_be_bytes().into_vec()\n617\t    }\n618\t\n619\t    /// Returns the public exponent (e) as big-endian bytes.\n620\t    pub fn e(&self) -> Vec<u8> {\n621\t        use rsa::traits::PublicKeyParts;\n622\t        self.inner.e().to_be_bytes().into_vec()\n623\t    }\n624\t}\n625\t\n626\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> PublicKey<H, S, M> {\n627\t    pub fn new(inner: RsaPublicKey) -> Self {\n628\t        Self {\n629\t            inner,\n630\t            _phantom: PhantomData,\n631\t        }\n632\t    }\n633\t\n634\t    /// Returns an accessor for the raw RSA key components.\n635\t    pub fn components(&self) -> PublicKeyComponents<'_> {\n636\t        PublicKeyComponents { inner: &self.inner }\n637\t    }\n638\t\n639\t    fn salt_len() -> usize {\n640\t        if S::USE_SALT {\n641\t            H::SALT_LEN\n642\t        } else {\n643\t            0\n644\t        }\n645\t    }\n646\t\n647\t    pub fn to_der(&self) -> Result<Vec<u8>, Error> {\n648\t        self.inner\n649\t            .to_public_key_der()\n650\t            .map_err(|_| Error::EncodingError)\n651\t            .map(|x| x.as_ref().to_vec())\n652\t    }\n653\t\n654\t    pub fn from_der(der: &[u8]) -> Result<Self, Error> {\n655\t        if der.len() > 800 {\n656\t            return Err(Error::EncodingError);\n657\t        }\n658\t        let inner = rsa::RsaPublicKey::from_public_key_der(der)\n659\t            .or_else(|_| rsa::RsaPublicKey::from_pkcs1_der(der))\n660\t            .map_err(|_| Error::EncodingError)?;\n661\t        check_rsa_parameters(&inner)?;\n662\t        Ok(Self::new(inner))\n663\t    }\n664\t\n665\t    pub fn to_pem(&self) -> Result<String, Error> {\n666\t        self.inner\n667\t            .to_public_key_pem(Default::default())\n668\t            .map_err(|_| Error::EncodingError)\n669\t    }\n670\t\n671\t    pub fn from_pem(pem: &str) -> Result<Self, Error> {\n672\t        if pem.len() > 1000 {\n673\t            return Err(Error::EncodingError);\n674\t        }\n675\t        let pem = pem.trim();\n676\t        let inner = rsa::RsaPublicKey::from_public_key_pem(pem)\n677\t            .or_else(|_| rsa::RsaPublicKey::from_pkcs1_pem(pem))\n678\t            .map_err(|_| Error::EncodingError)?;\n679\t        check_rsa_parameters(&inner)?;\n680\t        Ok(Self::new(inner))\n681\t    }\n682\t\n683\t    pub fn to_spki(&self) -> Result<Vec<u8>, Error> {\n684\t        let tpl = spki_tpl();\n685\t        let der = self.to_der()?;\n686\t        if der.len() <= 24 {\n687\t            return Err(Error::EncodingError);\n688\t        }\n689\t        let raw = &der[24..];\n690\t        let container_len = tpl.len() - 4 + raw.len();\n691\t        let out_len = tpl.len() + raw.len();\n692\t        let mut out = Vec::with_capacity(out_len);\n693\t        out.extend_from_slice(tpl);\n694\t        out.extend_from_slice(raw);\n695\t        out[2..4].copy_from_slice(&(container_len as u16).to_be_bytes());\n696\t        out[66] = Self::salt_len() as u8;\n697\t        out[69..71].copy_from_slice(&(1 + raw.len() as u16).to_be_bytes());\n698\t        let mut mgf1_s: [u8; 13] = [48, 11, 6, 9, 96, 134, 72, 1, 101, 3, 4, 2, 0];\n699\t        mgf1_s[12] = H::OID_BYTE;\n700\t        out[21..][..mgf1_s.len()].copy_from_slice(&mgf1_s);\n701\t        out[49..][..mgf1_s.len()].copy_from_slice(&mgf1_s);\n702\t        Ok(out)\n703\t    }\n704\t\n705\t    pub fn from_spki(spki: &[u8]) -> Result<Self, Error> {\n706\t        if spki.len() > 800 {\n707\t            return Err(Error::EncodingError);\n708\t        }\n709\t        let tpl = spki_tpl();\n710\t        if spki.len() <= tpl.len() {\n711\t            return Err(Error::EncodingError);\n712\t        }\n713\t        if spki[6..18] != tpl[6..18] {\n714\t            return Err(Error::EncodingError);\n715\t        }\n716\t        let alg_len = spki[5] as usize;\n717\t        if spki.len() <= alg_len + 10 {\n718\t            return Err(Error::EncodingError);\n719\t        }\n720\t        let raw = &spki[alg_len + 10..];\n721\t        let der_seq: &mut [u8] = &mut [\n722\t            0x30, 0x82, 0x01, 0x22, 0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d,\n723\t            0x01, 0x01, 0x01, 0x05, 0x00, 0x03, 0x82, 0x01, 0x0f,\n724\t        ];\n725\t        der_seq[2..][..2].copy_from_slice(&(raw.len() as u16 + 19).to_be_bytes());\n726\t        der_seq[21..][..2].copy_from_slice(&(raw.len() as u16).to_be_bytes());\n727\t        let mut der = Vec::with_capacity(der_seq.len() + raw.len());\n728\t        der.extend_from_slice(der_seq);\n729\t        der.extend_from_slice(raw);\n730\t        Self::from_der(&der)\n731\t    }\n732\t\n733\t    /// Blind a message to be signed\n734\t    pub fn blind<R: CryptoRng + ?Sized>(\n735\t        &self,\n736\t        rng: &mut R,\n737\t        msg: impl AsRef<[u8]>,\n738\t    ) -> Result<BlindingResult, Error> {\n739\t        let msg = msg.as_ref();\n740\t        let modulus_bytes = self.inner.size();\n741\t        let modulus_bits = self.inner.n().as_ref().bits() as usize;\n742\t        let msg_randomizer = if M::RANDOMIZE {\n743\t            let mut noise = [0u8; 32];\n744\t            rng.fill_bytes(&mut noise[..]);\n745\t            Some(MessageRandomizer(noise))\n746\t        } else {\n747\t            None\n748\t        };\n749\t        let msg_hash = H::hash_message(msg_randomizer.as_ref().map(|r| r.0.as_slice()), msg);\n750\t        let salt_len = Self::salt_len();\n751\t        let mut salt = vec![0u8; salt_len];\n752\t        rng.fill_bytes(&mut salt[..]);\n753\t\n754\t        let padded = emsa_pss_encode(&msg_hash, modulus_bits - 1, &salt, &mut *H::new_hasher())?;\n755\t        let n = self.inner.n();\n756\t        let n_bits = n.bits_precision();\n757\t        let m = BoxedUint::from_be_slice(&padded, n_bits).map_err(|_| Error::InternalError)?;\n758\t        let one = BoxedUint::one_with_precision(n_bits);\n759\t        if m.gcd(n.as_ref()) != one {\n760\t            return Err(Error::UnsupportedParameters);\n761\t        }\n762\t\n763\t        let (blind_msg, secret) = rsa_blind(rng, &self.inner, &m);\n764\t        Ok(BlindingResult {\n765\t            blind_message: BlindMessage(to_bytes_be_padded(&blind_msg, modulus_bytes)),\n766\t            secret: Secret(to_bytes_be_padded(&secret, modulus_bytes)),\n767\t            msg_randomizer,\n768\t        })\n769\t    }\n770\t\n771\t    /// Finalize a blind signature to obtain the actual signature\n772\t    pub fn finalize(\n773\t        &self,\n774\t        blind_sig: &BlindSignature,\n775\t        result: &BlindingResult,\n776\t        msg: impl AsRef<[u8]>,\n777\t    ) -> Result<Signature, Error> {\n778\t        let modulus_bytes = self.inner.size();\n779\t        if blind_sig.len() != modulus_bytes || result.secret.len() != modulus_bytes {\n780\t            return Err(Error::UnsupportedParameters);\n781\t        }\n782\t        let n_bits = self.inner.n().bits_precision();\n783\t        let blind_sig_uint =\n784\t            BoxedUint::from_be_slice(blind_sig, n_bits).map_err(|_| Error::InternalError)?;\n785\t        let secret_uint =\n786\t            BoxedUint::from_be_slice(&result.secret, n_bits).map_err(|_| Error::InternalError)?;\n787\t        let sig = Signature(to_bytes_be_padded(\n788\t            &rsa_unblind(&self.inner, &blind_sig_uint, &secret_uint),\n789\t            modulus_bytes,\n790\t        ));\n791\t        self.verify(&sig, result.msg_randomizer, msg)?;\n792\t        Ok(sig)\n793\t    }\n794\t\n795\t    /// Verify a signature\n796\t    pub fn verify(\n797\t        &self,\n798\t        sig: &Signature,\n799\t        msg_randomizer: Option<MessageRandomizer>,\n800\t        msg: impl AsRef<[u8]>,\n801\t    ) -> Result<(), Error> {\n802\t        let msg = msg.as_ref();\n803\t        let modulus_bytes = self.inner.size();\n804\t        if sig.len() != modulus_bytes {\n805\t            return Err(Error::UnsupportedParameters);\n806\t        }\n807\t        if msg_randomizer.is_some() != M::RANDOMIZE {\n808\t            return Err(Error::VerificationFailed);\n809\t        }\n810\t        let sig_ =\n811\t            rsa::pss::Signature::try_from(sig.as_ref()).map_err(|_| Error::VerificationFailed)?;\n812\t        let salt_len = Self::salt_len();\n813\t        let msg_hash = H::hash_message(msg_randomizer.as_ref().map(|r| r.0.as_slice()), msg);\n814\t        H::verify_prehash(&self.inner, salt_len, &msg_hash, &sig_)\n815\t            .map_err(|_| Error::VerificationFailed)\n816\t    }\n817\t}\n818\t\n819\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> AsRef<RsaPublicKey> for PublicKey<H, S, M> {\n820\t    fn as_ref(&self) -> &RsaPublicKey {\n821\t        &self.inner\n822\t    }\n823\t}\n824\t\n825\t/// An RSA secret key\n826\t#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n827\t#[derive(Clone, Debug)]\n828\tpub struct SecretKey<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> {\n829\t    inner: RsaPrivateKey,\n830\t    _phantom: PhantomData<(H, S, M)>,\n831\t}\n832\t\n833\t/// Provides access to the raw RSA secret key components.\n834\tpub struct SecretKeyComponents<'a> {\n835\t    inner: &'a RsaPrivateKey,\n836\t}\n837\t\n838\timpl SecretKeyComponents<'_> {\n839\t    /// Returns the modulus (n) as big-endian bytes.\n840\t    pub fn n(&self) -> Vec<u8> {\n841\t        use rsa::traits::PublicKeyParts;\n842\t        self.inner.n().as_ref().to_be_bytes().into_vec()\n843\t    }\n844\t\n845\t    /// Returns the public exponent (e) as big-endian bytes.\n846\t    pub fn e(&self) -> Vec<u8> {\n847\t        use rsa::traits::PublicKeyParts;\n848\t        self.inner.e().to_be_bytes().into_vec()\n849\t    }\n850\t\n851\t    /// Returns the private exponent (d) as big-endian bytes.\n852\t    pub fn d(&self) -> Vec<u8> {\n853\t        use rsa::traits::PrivateKeyParts;\n854\t        self.inner.d().to_be_bytes().into_vec()\n855\t    }\n856\t\n857\t    /// Returns the prime factors (p, q, ...) as big-endian bytes.\n858\t    pub fn primes(&self) -> Vec<Vec<u8>> {\n859\t        use rsa::traits::PrivateKeyParts;\n860\t        self.inner\n861\t            .primes()\n862\t            .iter()\n863\t            .map(|p| p.to_be_bytes().into_vec())\n864\t            .collect()\n865\t    }\n866\t}\n867\t\n868\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> SecretKey<H, S, M> {\n869\t    pub fn new(inner: RsaPrivateKey) -> Self {\n870\t        Self {\n871\t            inner,\n872\t            _phantom: PhantomData,\n873\t        }\n874\t    }\n875\t\n876\t    /// Returns an accessor for the raw RSA key components.\n877\t    pub fn components(&self) -> SecretKeyComponents<'_> {\n878\t        SecretKeyComponents { inner: &self.inner }\n879\t    }\n880\t\n881\t    pub fn to_der(&self) -> Result<Vec<u8>, Error> {\n882\t        self.inner\n883\t            .to_pkcs8_der()\n884\t            .map_err(|_| Error::EncodingError)\n885\t            .map(|x| mem::take(x.to_bytes().as_mut()))\n886\t    }\n887\t\n888\t    pub fn from_der(der: &[u8]) -> Result<Self, Error> {\n889\t        let mut inner = rsa::RsaPrivateKey::from_pkcs8_der(der)\n890\t            .or_else(|_| rsa::RsaPrivateKey::from_pkcs1_der(der))\n891\t            .map_err(|_| Error::EncodingError)?;\n892\t        inner.validate().map_err(|_| Error::InvalidKey)?;\n893\t        inner.precompute().map_err(|_| Error::InvalidKey)?;\n894\t        let sk = Self::new(inner);\n895\t        sk.public_key()?;\n896\t        Ok(sk)\n897\t    }\n898\t\n899\t    pub fn to_pem(&self) -> Result<String, Error> {\n900\t        self.inner\n901\t            .to_pkcs8_pem(Default::default())\n902\t            .map_err(|_| Error::EncodingError)\n903\t            .map(|x| x.to_string())\n904\t    }\n905\t\n906\t    pub fn from_pem(pem: &str) -> Result<Self, Error> {\n907\t        let mut inner = rsa::RsaPrivateKey::from_pkcs8_pem(pem)\n908\t            .or_else(|_| rsa::RsaPrivateKey::from_pkcs1_pem(pem))\n909\t            .map_err(|_| Error::EncodingError)?;\n910\t        inner.validate().map_err(|_| Error::InvalidKey)?;\n911\t        inner.precompute().map_err(|_| Error::InvalidKey)?;\n912\t        let sk = Self::new(inner);\n913\t        sk.public_key()?;\n914\t        Ok(sk)\n915\t    }\n916\t\n917\t    /// Recover the public key\n918\t    pub fn public_key(&self) -> Result<PublicKey<H, S, M>, Error> {\n919\t        let inner = RsaPublicKey::from(&self.inner);\n920\t        check_rsa_parameters(&inner)?;\n921\t        Ok(PublicKey::new(inner))\n922\t    }\n923\t\n924\t    /// Sign a blinded message\n925\t    pub fn blind_sign(&self, blind_msg: impl AsRef<[u8]>) -> Result<BlindSignature, Error> {\n926\t        let mut rng = DefaultRng;\n927\t        self.blind_sign_with_rng(&mut rng, blind_msg)\n928\t    }\n929\t\n930\t    /// Sign a blinded message using the provided RNG for RSA blinding\n931\t    pub fn blind_sign_with_rng<R: TryCryptoRng + ?Sized>(\n932\t        &self,\n933\t        rng: &mut R,\n934\t        blind_msg: impl AsRef<[u8]>,\n935\t    ) -> Result<BlindSignature, Error> {\n936\t        let modulus_bytes = self.inner.size();\n937\t        if blind_msg.as_ref().len() != modulus_bytes {\n938\t            return Err(Error::UnsupportedParameters);\n939\t        }\n940\t        let n_bits = self.inner.n().bits_precision();\n941\t        let blind_msg_uint = BoxedUint::from_be_slice(blind_msg.as_ref(), n_bits)\n942\t            .map_err(|_| Error::InternalError)?;\n943\t        if blind_msg_uint >= self.inner.n().as_ref() {\n944\t            return Err(Error::UnsupportedParameters);\n945\t        }\n946\t        let blind_sig = rsa_decrypt_and_check(&self.inner, Some(rng), &blind_msg_uint)\n947\t            .map_err(|_| Error::InternalError)?;\n948\t        Ok(BlindSignature(to_bytes_be_padded(\n949\t            &blind_sig,\n950\t            modulus_bytes,\n951\t        )))\n952\t    }\n953\t}\n954\t\n955\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> AsRef<RsaPrivateKey> for SecretKey<H, S, M> {\n956\t    fn as_ref(&self) -> &RsaPrivateKey {\n957\t        &self.inner\n958\t    }\n959\t}\n960\t\n961\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> Eq for SecretKey<H, S, M> {}\n962\t\n963\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> PartialEq for SecretKey<H, S, M> {\n964\t    fn eq(&self, other: &Self) -> bool {\n965\t        // RsaPrivateKey currently uses BoxedUint internally, which implements\n966\t        // constant-time comparison when the moduli are the same.\n967\t        self.inner == other.inner\n968\t    }\n969\t}\n970\t\n971\t/// An RSA key pair\n972\t#[derive(Clone, Debug, Eq, PartialEq)]\n973\tpub struct KeyPair<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> {\n974\t    pub pk: PublicKey<H, S, M>,\n975\t    pub sk: SecretKey<H, S, M>,\n976\t}\n977\t\n978\timpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> KeyPair<H, S, M> {\n979\t    /// Generate a new key pair\n980\t    pub fn generate<R: CryptoRng + ?Sized>(\n981\t        rng: &mut R,\n982\t        modulus_bits: usize,\n983\t    ) -> Result<Self, Error> {\n984\t        if !(2048..=4096).contains(&modulus_bits) {\n985\t            return Err(Error::UnsupportedParameters);\n986\t        }\n987\t        let mut inner =\n988\t            RsaPrivateKey::new(rng, modulus_bits).map_err(|_| Error::UnsupportedParameters)?;\n989\t        inner.precompute().map_err(|_| Error::InternalError)?;\n990\t        let sk = SecretKey::new(inner);\n991\t        let pk = sk.public_key()?;\n992\t        Ok(Self { pk, sk })\n993\t    }\n994\t}\n995\t\n996\t/// RSABSSA-SHA384-PSS-Randomized (RFC 9474 recommended)\n997\tpub type BlindRsaSha384PSSRandomized = BlindRsa<Sha384, PSS, Randomized>;\n998\t\n999\t/// RSABSSA-SHA384-PSSZERO-Randomized\n1000\tpub type BlindRsaSha384PSSZeroRandomized = BlindRsa<Sha384, PSSZero, Randomized>;\n1001\t\n1002\t/// RSABSSA-SHA384-PSS-Deterministic\n1003\tpub type BlindRsaSha384PSSDeterministic = BlindRsa<Sha384, PSS, Deterministic>;\n1004\t\n1005\t/// RSABSSA-SHA384-PSSZERO-Deterministic\n1006\tpub type BlindRsaSha384PSSZeroDeterministic = BlindRsa<Sha384, PSSZero, Deterministic>;\n1007\t\n1008\t/// Public key for RSABSSA-SHA384-PSS-Randomized (RFC 9474 recommended)\n1009\tpub type PublicKeySha384PSSRandomized = PublicKey<Sha384, PSS, Randomized>;\n1010\t\n1011\t/// Secret key for RSABSSA-SHA384-PSS-Randomized (RFC 9474 recommended)\n1012\tpub type SecretKeySha384PSSRandomized = SecretKey<Sha384, PSS, Randomized>;\n1013\t\n1014\t/// Key pair for RSABSSA-SHA384-PSS-Randomized (RFC 9474 recommended)\n1015\tpub type KeyPairSha384PSSRandomized = KeyPair<Sha384, PSS, Randomized>;\n1016\t\n1017\t/// Public key for RSABSSA-SHA384-PSSZERO-Randomized\n1018\tpub type PublicKeySha384PSSZeroRandomized = PublicKey<Sha384, PSSZero, Randomized>;\n1019\t\n1020\t/// Secret key for RSABSSA-SHA384-PSSZERO-Randomized\n1021\tpub type SecretKeySha384PSSZeroRandomized = SecretKey<Sha384, PSSZero, Randomized>;\n1022\t\n1023\t/// Key pair for RSABSSA-SHA384-PSSZERO-Randomized\n1024\tpub type KeyPairSha384PSSZeroRandomized = KeyPair<Sha384, PSSZero, Randomized>;\n1025\t\n1026\t/// Public key for RSABSSA-SHA384-PSS-Deterministic\n1027\tpub type PublicKeySha384PSSDeterministic = PublicKey<Sha384, PSS, Deterministic>;\n1028\t\n1029\t/// Secret key for RSABSSA-SHA384-PSS-Deterministic\n1030\tpub type SecretKeySha384PSSDeterministic = SecretKey<Sha384, PSS, Deterministic>;\n1031\t\n1032\t/// Key pair for RSABSSA-SHA384-PSS-Deterministic\n1033\tpub type KeyPairSha384PSSDeterministic = KeyPair<Sha384, PSS, Deterministic>;\n1034\t\n1035\t/// Public key for RSABSSA-SHA384-PSSZERO-Deterministic\n1036\tpub type PublicKeySha384PSSZeroDeterministic = PublicKey<Sha384, PSSZero, Deterministic>;\n1037\t\n1038\t/// Secret key for RSABSSA-SHA384-PSSZERO-Deterministic\n1039\tpub type SecretKeySha384PSSZeroDeterministic = SecretKey<Sha384, PSSZero, Deterministic>;\n1040\t\n1041\t/// Key pair for RSABSSA-SHA384-PSSZERO-Deterministic\n1042\tpub type KeyPairSha384PSSZeroDeterministic = KeyPair<Sha384, PSSZero, Deterministic>;\n1043\t"}]},"parent_tool_use_id":null,"session_id":"a890f4cb-3516-4060-a786-36cf91b9ed5d","uuid":"2b90e522-5d73-4bce-bcfc-04826321b96e","timestamp":"2026-06-05T22:02:52.431Z","tool_use_result":{"type":"text","file":{"filePath":"/home/scheschb/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/blind-rsa-signatures-0.17.2/src/lib.rs","content":"//! Author-blinded RSASSA-PSS RSAE signatures.\n//!\n//! This is an implementation of the [RSA Blind Signatures](https://www.rfc-editor.org/rfc/rfc9474.html) (RFC 9474), based on [the Zig implementation](https://github.com/jedisct1/zig-rsa-blind-signatures).\n//!\n//! ```rust\n//! use blind_rsa_signatures::{KeyPair, Sha384, PSS, Randomized, DefaultRng};\n//!\n//! // [SERVER]: Generate a RSA-2048 key pair\n//! let kp = KeyPair::<Sha384, PSS, Randomized>::generate(&mut DefaultRng, 2048)?;\n//! let (pk, sk) = (kp.pk, kp.sk);\n//!\n//! // [CLIENT]: create a random message and blind it for the server whose public key is `pk`.\n//! // The client must store the message and the secret.\n//! let msg = b\"test\";\n//! let blinding_result = pk.blind(&mut DefaultRng, msg)?;\n//!\n//! // [SERVER]: compute a signature for a blind message, to be sent to the client.\n//! // The client secret should not be sent to the server.\n//! let blind_sig = sk.blind_sign(&blinding_result.blind_message)?;\n//!\n//! // [CLIENT]: later, when the client wants to redeem a signed blind message,\n//! // using the blinding secret, it can locally compute the signature of the\n//! // original message.\n//! // The client then owns a new valid (message, signature) pair, and the\n//! // server cannot link it to a previous (blinded message, blind signature) pair.\n//! // Note that the finalization function also verifies that the new signature\n//! // is correct for the server public key.\n//! let sig = pk.finalize(&blind_sig, &blinding_result, msg)?;\n//!\n//! // [SERVER]: a non-blind signature can be verified using the server's public key.\n//! pk.verify(&sig, blinding_result.msg_randomizer, msg)?;\n//! # Ok::<(), blind_rsa_signatures::Error>(())\n//! ```\n\n#[macro_use]\nextern crate derive_new;\n\nuse std::convert::{Infallible, TryFrom};\nuse std::fmt::{self, Display};\nuse std::marker::PhantomData;\nuse std::mem;\n\nuse crypto_bigint::{BoxedUint, Gcd};\nuse derive_more::{AsRef, Debug, Deref, From, Into};\n\nuse digest::{typenum::Unsigned, DynDigest, OutputSizeUser};\nuse hmac_sha256::Hash as Sha256Hash;\nuse hmac_sha512::sha384::Hash as Sha384Hash;\nuse hmac_sha512::Hash as Sha512Hash;\nuse rsa::hazmat::rsa_decrypt_and_check;\nuse rsa::pkcs1::{DecodeRsaPrivateKey as _, DecodeRsaPublicKey as _};\nuse rsa::pkcs8::{\n    DecodePrivateKey as _, DecodePublicKey as _, EncodePrivateKey as _, EncodePublicKey as _,\n};\nuse rsa::rand_core::{CryptoRng, TryCryptoRng, TryRng};\nuse rsa::signature::hazmat::PrehashVerifier;\nuse rsa::traits::PublicKeyParts as _;\nuse rsa::{RsaPrivateKey, RsaPublicKey};\n\nmod brsa;\nmod mgf1;\npub mod pbrsa;\n\nmod private {\n    pub trait Sealed {}\n}\n\nuse brsa::{blind as rsa_blind, unblind as rsa_unblind};\nuse mgf1::mgf1_xor;\n\n#[cfg(feature = \"serde\")]\nuse serde::{Deserialize, Serialize};\n\npub mod reexports {\n    pub use {crypto_bigint, digest, hmac_sha256, hmac_sha512, rand, rsa};\n}\n\n/// Returns the byte representation of a BoxedUint in big-endian byte order,\n/// left-padding the number with zeroes to the specified length.\nfn to_bytes_be_padded(n: &BoxedUint, len: usize) -> Vec<u8> {\n    let bytes = n.to_be_bytes();\n    if len > bytes.len() {\n        let mut result = vec![0u8; len];\n        result[len - bytes.len()..].copy_from_slice(&bytes);\n        result\n    } else {\n        bytes.to_vec()\n    }\n}\n\n#[derive(Debug, Copy, Clone, Eq, PartialEq)]\npub enum Error {\n    InternalError,\n    UnsupportedParameters,\n    VerificationFailed,\n    EncodingError,\n    InvalidKey,\n    IncompatibleParameters,\n}\n\nimpl std::error::Error for Error {}\n\nimpl Display for Error {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        match self {\n            Error::InternalError => write!(f, \"Internal Error\"),\n            Error::UnsupportedParameters => write!(f, \"Unsupported parameters\"),\n            Error::VerificationFailed => write!(f, \"Verification failed\"),\n            Error::EncodingError => write!(f, \"Encoding error\"),\n            Error::InvalidKey => write!(f, \"Invalid key\"),\n            Error::IncompatibleParameters => write!(f, \"Incompatible parameters\"),\n        }\n    }\n}\n\nimpl AsRef<[u8]> for Error {\n    fn as_ref(&self) -> &[u8] {\n        match self {\n            Error::InternalError => b\"Internal Error\",\n            Error::UnsupportedParameters => b\"Unsupported parameters\",\n            Error::VerificationFailed => b\"Verification failed\",\n            Error::EncodingError => b\"Encoding error\",\n            Error::InvalidKey => b\"Invalid key\",\n            Error::IncompatibleParameters => b\"Incompatible parameters\",\n        }\n    }\n}\n\npub trait HashAlgorithm: Clone + Default {\n    /// Salt length for PSS padding (equals hash output length)\n    const SALT_LEN: usize;\n    /// OID byte for SPKI encoding (1=SHA256, 2=SHA384, 3=SHA512)\n    const OID_BYTE: u8;\n    /// Algorithm name as bytes\n    const NAME: &'static [u8];\n\n    /// Create a new boxed hasher\n    fn new_hasher() -> Box<dyn DynDigest>;\n\n    /// Hash a message with an optional prefix\n    fn hash_message(prefix: Option<&[u8]>, msg: &[u8]) -> Vec<u8> {\n        let mut h = Self::new_hasher();\n        if let Some(p) = prefix {\n            h.update(p);\n        }\n        h.update(msg);\n        h.finalize().to_vec()\n    }\n\n    /// Verify a prehashed signature\n    fn verify_prehash(\n        pk: &RsaPublicKey,\n        salt_len: usize,\n        msg_hash: &[u8],\n        sig: &rsa::pss::Signature,\n    ) -> Result<(), rsa::signature::Error>;\n\n    /// HKDF key derivation for PBRSA\n    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]);\n}\n\n/// SHA-256 hash algorithm\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct Sha256;\n\nimpl HashAlgorithm for Sha256 {\n    const SALT_LEN: usize = <<Sha256Hash as OutputSizeUser>::OutputSize as Unsigned>::USIZE;\n    const OID_BYTE: u8 = 1;\n    const NAME: &'static [u8] = b\"sha256\";\n\n    fn new_hasher() -> Box<dyn DynDigest> {\n        Box::new(Sha256Hash::new())\n    }\n\n    fn verify_prehash(\n        pk: &RsaPublicKey,\n        salt_len: usize,\n        msg_hash: &[u8],\n        sig: &rsa::pss::Signature,\n    ) -> Result<(), rsa::signature::Error> {\n        rsa::pss::VerifyingKey::<Sha256Hash>::new_with_salt_len(pk.clone(), salt_len)\n            .verify_prehash(msg_hash, sig)\n    }\n\n    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]) {\n        let prk = hmac_sha256::HKDF::extract(salt, ikm);\n        hmac_sha256::HKDF::expand(out, prk, info);\n    }\n}\n\n/// SHA-384 hash algorithm\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct Sha384;\n\nimpl HashAlgorithm for Sha384 {\n    const SALT_LEN: usize = <<Sha384Hash as OutputSizeUser>::OutputSize as Unsigned>::USIZE;\n    const OID_BYTE: u8 = 2;\n    const NAME: &'static [u8] = b\"sha384\";\n\n    fn new_hasher() -> Box<dyn DynDigest> {\n        Box::new(Sha384Hash::new())\n    }\n\n    fn verify_prehash(\n        pk: &RsaPublicKey,\n        salt_len: usize,\n        msg_hash: &[u8],\n        sig: &rsa::pss::Signature,\n    ) -> Result<(), rsa::signature::Error> {\n        rsa::pss::VerifyingKey::<Sha384Hash>::new_with_salt_len(pk.clone(), salt_len)\n            .verify_prehash(msg_hash, sig)\n    }\n\n    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]) {\n        let prk = hmac_sha512::sha384::HKDF::extract(salt, ikm);\n        hmac_sha512::sha384::HKDF::expand(out, prk, info);\n    }\n}\n\n/// SHA-512 hash algorithm\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct Sha512;\n\nimpl HashAlgorithm for Sha512 {\n    const SALT_LEN: usize = <<Sha512Hash as OutputSizeUser>::OutputSize as Unsigned>::USIZE;\n    const OID_BYTE: u8 = 3;\n    const NAME: &'static [u8] = b\"sha512\";\n\n    fn new_hasher() -> Box<dyn DynDigest> {\n        Box::new(Sha512Hash::new())\n    }\n\n    fn verify_prehash(\n        pk: &RsaPublicKey,\n        salt_len: usize,\n        msg_hash: &[u8],\n        sig: &rsa::pss::Signature,\n    ) -> Result<(), rsa::signature::Error> {\n        rsa::pss::VerifyingKey::<Sha512Hash>::new_with_salt_len(pk.clone(), salt_len)\n            .verify_prehash(msg_hash, sig)\n    }\n\n    fn hkdf_expand(out: &mut [u8], salt: &[u8], ikm: &[u8], info: &[u8]) {\n        let prk = hmac_sha512::HKDF::extract(salt, ikm);\n        hmac_sha512::HKDF::expand(out, prk, info);\n    }\n}\n\n/// Trait for PSS salt mode (compile-time parameter)\n/// The only valid implementations are [`PSS`] and [`PSSZero`].\npub trait SaltMode: Clone + Default + private::Sealed {\n    /// Whether salt is used\n    const USE_SALT: bool;\n\n    /// Get salt length for a given hash algorithm\n    fn salt_len<H: HashAlgorithm>() -> usize {\n        if Self::USE_SALT {\n            H::SALT_LEN\n        } else {\n            0\n        }\n    }\n}\n\n/// PSS mode with salt (salt length = hash output length)\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct PSS;\n\nimpl private::Sealed for PSS {}\n\nimpl SaltMode for PSS {\n    const USE_SALT: bool = true;\n}\n\n/// PSS mode without salt (salt length = 0)\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct PSSZero;\n\nimpl private::Sealed for PSSZero {}\n\nimpl SaltMode for PSSZero {\n    const USE_SALT: bool = false;\n}\n\n/// Trait for message preparation mode (compile-time parameter)\n/// The only valid implementations are [`Randomized`] and [`Deterministic`].\npub trait MessagePrepare: Clone + Default + private::Sealed {\n    /// Whether to randomize the message with a 32-byte prefix\n    const RANDOMIZE: bool;\n}\n\n/// Randomized message preparation\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct Randomized;\n\nimpl private::Sealed for Randomized {}\n\nimpl MessagePrepare for Randomized {\n    const RANDOMIZE: bool = true;\n}\n\n/// Deterministic message preparation\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct Deterministic;\n\nimpl private::Sealed for Deterministic {}\n\nimpl MessagePrepare for Deterministic {\n    const RANDOMIZE: bool = false;\n}\n\n/// Default random number generator\n#[derive(Debug, Default, Clone, Copy, Eq, PartialEq)]\npub struct DefaultRng;\n\nimpl TryRng for DefaultRng {\n    type Error = Infallible;\n\n    fn try_next_u32(&mut self) -> Result<u32, Self::Error> {\n        Ok(rand::random())\n    }\n\n    fn try_next_u64(&mut self) -> Result<u64, Self::Error> {\n        Ok(rand::random())\n    }\n\n    fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), Self::Error> {\n        rand::fill(dest);\n        Ok(())\n    }\n}\n\nimpl TryCryptoRng for DefaultRng {}\n\n/// A blinding secret factor\n#[derive(Clone, Debug, AsRef, Deref, From, Into, new)]\npub struct Secret(pub Vec<u8>);\n\nimpl Eq for Secret {}\n\nimpl PartialEq for Secret {\n    fn eq(&self, other: &Self) -> bool {\n        ct_codecs::verify(&self.0, &other.0)\n    }\n}\n\n/// A blind message\n#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n#[derive(Clone, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\npub struct BlindMessage(pub Vec<u8>);\n\n/// A blind signature\n#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n#[derive(Clone, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\npub struct BlindSignature(pub Vec<u8>);\n\n/// A (non-blind) signature\n#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n#[derive(Clone, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\npub struct Signature(pub Vec<u8>);\n\n/// A message randomizer (noise added as a prefix to the message)\n#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n#[derive(Clone, Copy, Debug, Eq, PartialEq, AsRef, Deref, From, Into, new)]\npub struct MessageRandomizer(pub [u8; 32]);\n\n/// Result of a blinding operation\n#[derive(Clone, Debug)]\npub struct BlindingResult {\n    pub blind_message: BlindMessage,\n    pub secret: Secret,\n    pub msg_randomizer: Option<MessageRandomizer>,\n}\n\nimpl Eq for BlindingResult {}\n\nimpl PartialEq for BlindingResult {\n    fn eq(&self, other: &Self) -> bool {\n        self.blind_message == other.blind_message\n            && self.secret == other.secret\n            && self.msg_randomizer == other.msg_randomizer\n    }\n}\n\nimpl AsRef<[u8]> for Secret {\n    fn as_ref(&self) -> &[u8] {\n        self.0.as_slice()\n    }\n}\n\nimpl AsRef<[u8]> for BlindMessage {\n    fn as_ref(&self) -> &[u8] {\n        self.0.as_slice()\n    }\n}\n\nimpl AsRef<[u8]> for BlindSignature {\n    fn as_ref(&self) -> &[u8] {\n        self.0.as_slice()\n    }\n}\n\nimpl AsRef<[u8]> for Signature {\n    fn as_ref(&self) -> &[u8] {\n        self.0.as_slice()\n    }\n}\n\nimpl AsRef<[u8]> for MessageRandomizer {\n    fn as_ref(&self) -> &[u8] {\n        self.0.as_ref()\n    }\n}\n\nimpl AsRef<[u8]> for BlindingResult {\n    fn as_ref(&self) -> &[u8] {\n        self.blind_message.as_ref()\n    }\n}\n\nfn check_rsa_parameters(pk: &RsaPublicKey) -> Result<(), Error> {\n    let modulus_bits = pk.size() * 8;\n    if !(2048..=4096).contains(&modulus_bits) {\n        return Err(Error::UnsupportedParameters);\n    }\n    let e = pk.e();\n    let e3 = BoxedUint::from(3u32);\n    let ef4 = BoxedUint::from(65537u32);\n    if e != &e3 && e != &ef4 {\n        return Err(Error::UnsupportedParameters);\n    }\n    Ok(())\n}\n\n#[allow(clippy::identity_op)]\nconst fn spki_tpl() -> &'static [u8] {\n    const SEQ: u8 = 0x30;\n    const EXT: u8 = 0x80;\n    const CON: u8 = 0xa0;\n    const INT: u8 = 0x02;\n    const BIT: u8 = 0x03;\n    const OBJ: u8 = 0x06;\n    const TPL: &[u8] = &[\n        SEQ,\n        EXT | 2,\n        0,\n        0, // container length - offset 2\n        SEQ,\n        61, // Algorithm sequence\n        OBJ,\n        9,\n        0x2a,\n        0x86,\n        0x48,\n        0x86,\n        0xf7,\n        0x0d,\n        0x01,\n        0x01,\n        0x0a, // Signature algorithm (RSASSA-PSS)\n        SEQ,\n        48, // RSASSA-PSS parameters sequence\n        CON | 0,\n        2 + 2 + 9,\n        SEQ,\n        2 + 9,\n        OBJ,\n        9,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0, // Hash function - offset 21\n        CON | 1,\n        2 + 24,\n        SEQ,\n        24,\n        OBJ,\n        9,\n        0x2a,\n        0x86,\n        0x48,\n        0x86,\n        0xf7,\n        0x0d,\n        0x01,\n        0x01,\n        0x08, // Padding function (MGF1) and parameters\n        SEQ,\n        2 + 9,\n        OBJ,\n        9,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0,\n        0, // MGF1 hash function - offset 49\n        CON | 2,\n        2 + 1,\n        INT,\n        1,\n        0, // Salt length - offset 66\n        BIT,\n        EXT | 2,\n        0,\n        0, // Public key length - Bit string - offset 69\n        0, // No partial bytes\n    ];\n    TPL\n}\n\nfn emsa_pss_encode(\n    m_hash: &[u8],\n    em_bits: usize,\n    salt: &[u8],\n    hash: &mut dyn DynDigest,\n) -> Result<Vec<u8>, Error> {\n    let h_len = hash.output_size();\n    let s_len = salt.len();\n    let em_len = em_bits.div_ceil(8);\n    if m_hash.len() != h_len {\n        return Err(Error::InternalError);\n    }\n    if em_len < h_len + s_len + 2 {\n        return Err(Error::InternalError);\n    }\n    let mut em = vec![0; em_len];\n    let (db, h) = em.split_at_mut(em_len - h_len - 1);\n    let h = &mut h[..h_len];\n    let prefix = [0u8; 8];\n    hash.update(&prefix);\n    hash.update(m_hash);\n    hash.update(salt);\n    let hashed = hash.finalize_reset();\n    h.copy_from_slice(&hashed);\n    db[em_len - s_len - h_len - 2] = 0x01;\n    db[em_len - s_len - h_len - 1..].copy_from_slice(salt);\n    mgf1_xor(db, hash, h);\n    db[0] &= 0xff >> (8 * em_len - em_bits);\n    em[em_len - 1] = 0xbc;\n    Ok(em)\n}\n\n/// Blind RSA signatures with compile-time parameters.\n///\n/// This mirrors the Zig API where `BlindRsa` returns a type containing\n/// `PublicKey`, `SecretKey`, and `KeyPair` with methods for the protocol.\n///\n/// Type parameters:\n/// - `H`: Hash algorithm ([`Sha256`], [`Sha384`], [`Sha512`])\n/// - `S`: Salt mode ([`PSS`], [`PSSZero`])\n/// - `M`: Message preparation mode ([`Randomized`], [`Deterministic`])\n///\n/// # Example\n///\n/// ```rust\n/// use blind_rsa_signatures::{BlindRsa, Sha384, PSS, Randomized};\n///\n/// type BRsa = BlindRsa<Sha384, PSS, Randomized>;\n/// ```\n#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]\npub struct BlindRsa<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> {\n    _phantom: PhantomData<(H, S, M)>,\n}\n\nimpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> BlindRsa<H, S, M> {\n    /// Get the salt length for this configuration\n    pub const fn salt_len() -> usize {\n        if S::USE_SALT {\n            H::SALT_LEN\n        } else {\n            0\n        }\n    }\n\n    /// Check if this configuration uses randomized message preparation\n    pub const fn is_randomized() -> bool {\n        M::RANDOMIZE\n    }\n}\n\n/// Type alias for PublicKey with the same parameters as BlindRsa\npub type BlindRsaPublicKey<H, S, M> = PublicKey<H, S, M>;\n\n/// Type alias for SecretKey with the same parameters as BlindRsa\npub type BlindRsaSecretKey<H, S, M> = SecretKey<H, S, M>;\n\n/// Type alias for KeyPair with the same parameters as BlindRsa\npub type BlindRsaKeyPair<H, S, M> = KeyPair<H, S, M>;\n\n/// An RSA public key\n#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n#[derive(Clone, Debug, Eq, PartialEq)]\npub struct PublicKey<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> {\n    inner: RsaPublicKey,\n    _phantom: PhantomData<(H, S, M)>,\n}\n\n/// Provides access to the raw RSA public key components.\npub struct PublicKeyComponents<'a> {\n    inner: &'a RsaPublicKey,\n}\n\nimpl PublicKeyComponents<'_> {\n    /// Returns the modulus (n) as big-endian bytes.\n    pub fn n(&self) -> Vec<u8> {\n        use rsa::traits::PublicKeyParts;\n        self.inner.n().as_ref().to_be_bytes().into_vec()\n    }\n\n    /// Returns the public exponent (e) as big-endian bytes.\n    pub fn e(&self) -> Vec<u8> {\n        use rsa::traits::PublicKeyParts;\n        self.inner.e().to_be_bytes().into_vec()\n    }\n}\n\nimpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> PublicKey<H, S, M> {\n    pub fn new(inner: RsaPublicKey) -> Self {\n        Self {\n            inner,\n            _phantom: PhantomData,\n        }\n    }\n\n    /// Returns an accessor for the raw RSA key components.\n    pub fn components(&self) -> PublicKeyComponents<'_> {\n        PublicKeyComponents { inner: &self.inner }\n    }\n\n    fn salt_len() -> usize {\n        if S::USE_SALT {\n            H::SALT_LEN\n        } else {\n            0\n        }\n    }\n\n    pub fn to_der(&self) -> Result<Vec<u8>, Error> {\n        self.inner\n            .to_public_key_der()\n            .map_err(|_| Error::EncodingError)\n            .map(|x| x.as_ref().to_vec())\n    }\n\n    pub fn from_der(der: &[u8]) -> Result<Self, Error> {\n        if der.len() > 800 {\n            return Err(Error::EncodingError);\n        }\n        let inner = rsa::RsaPublicKey::from_public_key_der(der)\n            .or_else(|_| rsa::RsaPublicKey::from_pkcs1_der(der))\n            .map_err(|_| Error::EncodingError)?;\n        check_rsa_parameters(&inner)?;\n        Ok(Self::new(inner))\n    }\n\n    pub fn to_pem(&self) -> Result<String, Error> {\n        self.inner\n            .to_public_key_pem(Default::default())\n            .map_err(|_| Error::EncodingError)\n    }\n\n    pub fn from_pem(pem: &str) -> Result<Self, Error> {\n        if pem.len() > 1000 {\n            return Err(Error::EncodingError);\n        }\n        let pem = pem.trim();\n        let inner = rsa::RsaPublicKey::from_public_key_pem(pem)\n            .or_else(|_| rsa::RsaPublicKey::from_pkcs1_pem(pem))\n            .map_err(|_| Error::EncodingError)?;\n        check_rsa_parameters(&inner)?;\n        Ok(Self::new(inner))\n    }\n\n    pub fn to_spki(&self) -> Result<Vec<u8>, Error> {\n        let tpl = spki_tpl();\n        let der = self.to_der()?;\n        if der.len() <= 24 {\n            return Err(Error::EncodingError);\n        }\n        let raw = &der[24..];\n        let container_len = tpl.len() - 4 + raw.len();\n        let out_len = tpl.len() + raw.len();\n        let mut out = Vec::with_capacity(out_len);\n        out.extend_from_slice(tpl);\n        out.extend_from_slice(raw);\n        out[2..4].copy_from_slice(&(container_len as u16).to_be_bytes());\n        out[66] = Self::salt_len() as u8;\n        out[69..71].copy_from_slice(&(1 + raw.len() as u16).to_be_bytes());\n        let mut mgf1_s: [u8; 13] = [48, 11, 6, 9, 96, 134, 72, 1, 101, 3, 4, 2, 0];\n        mgf1_s[12] = H::OID_BYTE;\n        out[21..][..mgf1_s.len()].copy_from_slice(&mgf1_s);\n        out[49..][..mgf1_s.len()].copy_from_slice(&mgf1_s);\n        Ok(out)\n    }\n\n    pub fn from_spki(spki: &[u8]) -> Result<Self, Error> {\n        if spki.len() > 800 {\n            return Err(Error::EncodingError);\n        }\n        let tpl = spki_tpl();\n        if spki.len() <= tpl.len() {\n            return Err(Error::EncodingError);\n        }\n        if spki[6..18] != tpl[6..18] {\n            return Err(Error::EncodingError);\n        }\n        let alg_len = spki[5] as usize;\n        if spki.len() <= alg_len + 10 {\n            return Err(Error::EncodingError);\n        }\n        let raw = &spki[alg_len + 10..];\n        let der_seq: &mut [u8] = &mut [\n            0x30, 0x82, 0x01, 0x22, 0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d,\n            0x01, 0x01, 0x01, 0x05, 0x00, 0x03, 0x82, 0x01, 0x0f,\n        ];\n        der_seq[2..][..2].copy_from_slice(&(raw.len() as u16 + 19).to_be_bytes());\n        der_seq[21..][..2].copy_from_slice(&(raw.len() as u16).to_be_bytes());\n        let mut der = Vec::with_capacity(der_seq.len() + raw.len());\n        der.extend_from_slice(der_seq);\n        der.extend_from_slice(raw);\n        Self::from_der(&der)\n    }\n\n    /// Blind a message to be signed\n    pub fn blind<R: CryptoRng + ?Sized>(\n        &self,\n        rng: &mut R,\n        msg: impl AsRef<[u8]>,\n    ) -> Result<BlindingResult, Error> {\n        let msg = msg.as_ref();\n        let modulus_bytes = self.inner.size();\n        let modulus_bits = self.inner.n().as_ref().bits() as usize;\n        let msg_randomizer = if M::RANDOMIZE {\n            let mut noise = [0u8; 32];\n            rng.fill_bytes(&mut noise[..]);\n            Some(MessageRandomizer(noise))\n        } else {\n            None\n        };\n        let msg_hash = H::hash_message(msg_randomizer.as_ref().map(|r| r.0.as_slice()), msg);\n        let salt_len = Self::salt_len();\n        let mut salt = vec![0u8; salt_len];\n        rng.fill_bytes(&mut salt[..]);\n\n        let padded = emsa_pss_encode(&msg_hash, modulus_bits - 1, &salt, &mut *H::new_hasher())?;\n        let n = self.inner.n();\n        let n_bits = n.bits_precision();\n        let m = BoxedUint::from_be_slice(&padded, n_bits).map_err(|_| Error::InternalError)?;\n        let one = BoxedUint::one_with_precision(n_bits);\n        if m.gcd(n.as_ref()) != one {\n            return Err(Error::UnsupportedParameters);\n        }\n\n        let (blind_msg, secret) = rsa_blind(rng, &self.inner, &m);\n        Ok(BlindingResult {\n            blind_message: BlindMessage(to_bytes_be_padded(&blind_msg, modulus_bytes)),\n            secret: Secret(to_bytes_be_padded(&secret, modulus_bytes)),\n            msg_randomizer,\n        })\n    }\n\n    /// Finalize a blind signature to obtain the actual signature\n    pub fn finalize(\n        &self,\n        blind_sig: &BlindSignature,\n        result: &BlindingResult,\n        msg: impl AsRef<[u8]>,\n    ) -> Result<Signature, Error> {\n        let modulus_bytes = self.inner.size();\n        if blind_sig.len() != modulus_bytes || result.secret.len() != modulus_bytes {\n            return Err(Error::UnsupportedParameters);\n        }\n        let n_bits = self.inner.n().bits_precision();\n        let blind_sig_uint =\n            BoxedUint::from_be_slice(blind_sig, n_bits).map_err(|_| Error::InternalError)?;\n        let secret_uint =\n            BoxedUint::from_be_slice(&result.secret, n_bits).map_err(|_| Error::InternalError)?;\n        let sig = Signature(to_bytes_be_padded(\n            &rsa_unblind(&self.inner, &blind_sig_uint, &secret_uint),\n            modulus_bytes,\n        ));\n        self.verify(&sig, result.msg_randomizer, msg)?;\n        Ok(sig)\n    }\n\n    /// Verify a signature\n    pub fn verify(\n        &self,\n        sig: &Signature,\n        msg_randomizer: Option<MessageRandomizer>,\n        msg: impl AsRef<[u8]>,\n    ) -> Result<(), Error> {\n        let msg = msg.as_ref();\n        let modulus_bytes = self.inner.size();\n        if sig.len() != modulus_bytes {\n            return Err(Error::UnsupportedParameters);\n        }\n        if msg_randomizer.is_some() != M::RANDOMIZE {\n            return Err(Error::VerificationFailed);\n        }\n        let sig_ =\n            rsa::pss::Signature::try_from(sig.as_ref()).map_err(|_| Error::VerificationFailed)?;\n        let salt_len = Self::salt_len();\n        let msg_hash = H::hash_message(msg_randomizer.as_ref().map(|r| r.0.as_slice()), msg);\n        H::verify_prehash(&self.inner, salt_len, &msg_hash, &sig_)\n            .map_err(|_| Error::VerificationFailed)\n    }\n}\n\nimpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> AsRef<RsaPublicKey> for PublicKey<H, S, M> {\n    fn as_ref(&self) -> &RsaPublicKey {\n        &self.inner\n    }\n}\n\n/// An RSA secret key\n#[cfg_attr(feature = \"serde\", derive(Serialize, Deserialize))]\n#[derive(Clone, Debug)]\npub struct SecretKey<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> {\n    inner: RsaPrivateKey,\n    _phantom: PhantomData<(H, S, M)>,\n}\n\n/// Provides access to the raw RSA secret key components.\npub struct SecretKeyComponents<'a> {\n    inner: &'a RsaPrivateKey,\n}\n\nimpl SecretKeyComponents<'_> {\n    /// Returns the modulus (n) as big-endian bytes.\n    pub fn n(&self) -> Vec<u8> {\n        use rsa::traits::PublicKeyParts;\n        self.inner.n().as_ref().to_be_bytes().into_vec()\n    }\n\n    /// Returns the public exponent (e) as big-endian bytes.\n    pub fn e(&self) -> Vec<u8> {\n        use rsa::traits::PublicKeyParts;\n        self.inner.e().to_be_bytes().into_vec()\n    }\n\n    /// Returns the private exponent (d) as big-endian bytes.\n    pub fn d(&self) -> Vec<u8> {\n        use rsa::traits::PrivateKeyParts;\n        self.inner.d().to_be_bytes().into_vec()\n    }\n\n    /// Returns the prime factors (p, q, ...) as big-endian bytes.\n    pub fn primes(&self) -> Vec<Vec<u8>> {\n        use rsa::traits::PrivateKeyParts;\n        self.inner\n            .primes()\n            .iter()\n            .map(|p| p.to_be_bytes().into_vec())\n            .collect()\n    }\n}\n\nimpl<H: HashAlgorithm, S: SaltMode, M: MessagePrepare> SecretKey<H, S, M> {\n    pub fn new(inner: RsaPrivateKey) -> Self {\n        Self {\n            inner,\n            _phantom: PhantomData,\n        }\n    }\n\n    /// Returns an accessor for the raw RSA key components.\n    pub fn components(&self) -> SecretKeyComponents<'_> {\n        SecretKeyComponents { inner: &self.inner }\n    }\n\n    pub fn to_der(&self) -> Result<Vec<u8>, Error> {\n        self.inner\n            .to_pkcs8_der()\n            .map_err(|_| Error::EncodingError)\n            .map(|x| mem::take(x.to_bytes().as_mut()))\n    }\n\n    pub fn from_der(der: &[u8]) -> Result<Self, Error> {\n        let mut inner = rsa::RsaPrivateKey::from_pkcs8_der(der)\n            .or_else(|_| rsa::RsaPrivateKey::from_pkcs1_der(der))\n            .map_err(|_| Error::EncodingError)?;\n        inner.validate().map_err(|_| Error::InvalidKey)?;\n        inner.precompute().map_err(|_| Error::InvalidKey)?;\n        let sk = Self::new(inner);\n        sk.public_key()?;\n        Ok(sk)\n    }\n\n    pub fn to_pem(&self) -> Result<String, Error> {\n        self.inner\n            .to_pkcs8_pem(Default::default())\n            .map_err(|_| Error::EncodingError)\n     