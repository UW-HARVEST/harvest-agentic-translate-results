6\t    bigint result;\n77\t    if (n < 0) {\n78\t        result.is_negative = true;\n79\t        n = -n;\n80\t    } else {\n81\t        result.is_negative = false;\n82\t    }\n83\t    result.size = 1;\n84\t    int64_t m = n;\n85\t    while (m > 0) {\n86\t        m /= 10;\n87\t        result.size++;\n88\t    }\n89\t    result.digits = malloc(result.size * sizeof(int64_t));\n90\t    m = n;\n91\t    for (size_t i = 0; i < result.size; i++) {\n92\t        result.digits[result.size - i - 1] = m % 10;\n93\t        m /= 10;\n94\t    }\n95\t    bigint_remove_leading_zeros(&result);\n96\t    return result;\n97\t}\n98\t\n99\tint64_t bigint_to_int(bigint n) {\n100\t    int64_t result = 0;\n101\t    for (size_t i = 0; i < n.size; i++) {\n102\t        result *= 10;\n103\t        result += n.digits[i];\n104\t    }\n105\t    if (n.is_negative) {\n106\t        result = -result;\n107\t    }\n108\t    return result;\n109\t}\n110\t\n111\t/* Create a new bigint from an integer \n112\t* @param n The integer to create a bigint from\n113\t* @return A new bigint with the value of n\n114\t*/\n115\tbigint bigint_from_string(const char *n) {\n116\t    bigint result;\n117\t    \n118\t    // Determine if the number is negative\n119\t    if (n[0] == '-') {\n120\t        result.is_negative = true;\n121\t        n++;\n122\t    } else {\n123\t        result.is_negative = false;\n124\t    }\n125\t\n126\t    // Determine the size of the number\n127\t    result.size = strlen(n);\n128\t\n129\t    // Allocate memory for the digits\n130\t    result.digits = malloc(result.size * sizeof(int64_t));\n131\t    \n132\t    // Copy the digits into the bigint\n133\t    for (size_t i = 0; i < result.size; i++) {\n134\t        result.digits[i] = n[i] - '0';\n135\t    }\n136\t    \n137\t    return result;\n138\t}\n139\t\n140\t\n141\tbigint bigint_copy(bigint n) {\n142\t    bigint result;\n143\t    result.is_negative = n.is_negative;\n144\t    result.size = n.size;\n145\t    result.digits = malloc(result.size * sizeof(int64_t));\n146\t    memcpy(result.digits, n.digits, result.size * sizeof(int64_t));\n147\t    return result;\n148\t}\n149\t\n150\t/* Print a bigint\n151\t* @param n The bigint to print\n152\t*/\n153\tvoid bigint_print(bigint n) {\n154\t    if (n.is_negative) {\n155\t        printf(\"-\");\n156\t    }\n157\t    for (size_t i = 0; i < n.size; i++) {\n158\t        assert(n.digits[i] >= 0 && n.digits[i] <= 9);\n159\t        printf(\"%lld\", n.digits[i]);\n160\t    }\n161\t}\n162\t\n163\t\n164\tbool bigint_gt(bigint a, bigint b) {\n165\t    bigint_remove_leading_zeros(&a);\n166\t    bigint_remove_leading_zeros(&b);\n167\t    if (a.size > b.size) {\n168\t        return !a.is_negative;\n169\t    }\n170\t    if (a.size < b.size) {\n171\t        return a.is_negative;\n172\t    }\n173\t    for (size_t i = 0; i < a.size; i++) {\n174\t        if (a.digits[i] > b.digits[i]) {\n175\t            return !a.is_negative;\n176\t        }\n177\t        if (a.digits[i] < b.digits[i]) {\n178\t            return a.is_negative;\n179\t        }\n180\t    }\n181\t    return false;\n182\t}\n183\t\n184\tbool bigint_eq(bigint a, bigint b) {\n185\t    bigint_remove_leading_zeros(&a);\n186\t    bigint_remove_leading_zeros(&b);\n187\t    if (a.size != b.size) {\n188\t        return false;\n189\t    }\n190\t    if (a.is_negative != b.is_negative) {\n191\t        return false;\n192\t    }\n193\t    for (size_t i = 0; i < a.size; i++) {\n194\t        if (a.digits[i] != b.digits[i]) {\n195\t            return false;\n196\t        }\n197\t    }\n198\t    return true;\n199\t}\n200\t\n201\tbool bigint_eqzero(bigint n) {\n202\t    bigint_remove_leading_zeros(&n);\n203\t    if (n.size == 1 && n.digits[0] == 0) {\n204\t        return true;\n205\t    }\n206\t    return false;\n207\t}\n208\t\n209\tbool bigint_ltzero(bigint n) {\n210\t    bigint_remove_leading_zeros(&n);\n211\t    if (n.size == 1 && n.digits[0] == 0) {\n212\t        return false;\n213\t    }\n214\t    return n.is_negative;\n215\t}\n216\tbool bigint_gtzero(bigint n) {\n217\t    bigint_remove_leading_zeros(&n);\n218\t    if (n.size == 1 && n.digits[0] == 0) {\n219\t        return false;\n220\t    }\n221\t    return !n.is_negative;\n222\t}\n223\t\n224\tbool bigint_lezero(bigint n) {\n225\t    bigint_remove_leading_zeros(&n);\n226\t    if (n.size == 1 && n.digits[0] == 0) {\n227\t        return true;\n228\t    }\n229\t    return n.is_negative;\n230\t}\n231\t\n232\tbool bigint_gezero(bigint n) {\n233\t    bigint_remove_leading_zeros(&n);\n234\t    if (n.size == 1 && n.digits[0] == 0) {\n235\t        return true;\n236\t    }\n237\t    return !n.is_negative;\n238\t}\n239\t\n240\tbigint bigint_abs(bigint n) {\n241\t    n.is_negative = false;\n242\t    return n;\n243\t}\n244\t\n245\tbool bigint_ge(bigint a, bigint b) {\n246\t    return bigint_gt(a, b) || bigint_eq(a, b);\n247\t}\n248\t\n249\tbool bigint_lt(bigint a, bigint b) {\n250\t    return !bigint_ge(a, b);\n251\t}\n252\t\n253\tbool bigint_le(bigint a, bigint b) {\n254\t    return !bigint_gt(a, b);\n255\t}\n256\t\n257\t\n258\tbigint bigint_add(bigint a, bigint b);\n259\t\n260\t/* Subtract two bigints\n261\t* @param a The first bigint\n262\t* @param b The second bigint\n263\t* @return The difference of a and b\n264\t*/\n265\tbigint bigint_sub(bigint a, bigint b) {\n266\t    bigint result;\n267\t    if (a.is_negative && b.is_negative) {\n268\t        a.is_negative = false;\n269\t        b.is_negative = false;\n270\t        result = bigint_add(b, a);\n271\t        result.is_negative = true;\n272\t        return result;\n273\t    }\n274\t    \n275\t    if (a.is_negative) {\n276\t        // -a - b = -(a + b)\n277\t        b.is_negative = true;\n278\t        result = bigint_add(a, b);\n279\t        return result;\n280\t    }\n281\t\n282\t    if (b.is_negative) {\n283\t        // a - (-b) = a + b\n284\t        b.is_negative = false;\n285\t        result = bigint_add(a, b);\n286\t        return result;\n287\t    }\n288\t\n289\t    result.size = a.size > b.size ? a.size : b.size;\n290\t    result.digits = malloc(result.size * sizeof(int64_t));\n291\t    \n292\t    bool is_negative = bigint_lt(a, b);\n293\t\n294\t\n295\t    // Subtract the digits\n296\t    int64_t carry = 0;\n297\t    bigint larger = bigint_gt(a, b) ? a : b;\n298\t    bigint smaller = bigint_gt(a, b) ? b : a;\n299\t\n300\t    for (size_t i = 0; i < result.size; i++) {\n301\t        int64_t diff = carry;\n302\t        if (i < larger.size) {\n303\t            diff += larger.digits[larger.size - i - 1];\n304\t        }\n305\t        if (i < smaller.size) {\n306\t            diff -= smaller.digits[smaller.size - i - 1];\n307\t        }\n308\t        if (diff < 0) {\n309\t            diff += 10;\n310\t            carry = -1;\n311\t        } else {\n312\t            carry = 0;\n313\t        }\n314\t        result.digits[result.size - i - 1] = diff;\n315\t    }\n316\t    \n317\t    bigint_remove_leading_zeros(&result);\n318\t\n319\t    result.is_negative = is_negative;\n320\t\n321\t    return result;\n322\t}\n323\t\n324\t/* Add two bigints\n325\t* @param a The first bigint\n326\t* @param b The second bigint\n327\t* @return The sum of a and b\n328\t*/\n329\tbigint bigint_add(bigint a, bigint b) {\n330\t    bigint result;\n331\t    if (a.is_negative && b.is_negative) {\n332\t        result.is_negative = true;\n333\t    } else if (a.is_negative) {\n334\t        a.is_negative = false;\n335\t        result = bigint_sub(b, a);\n336\t        return result;\n337\t    } else if (b.is_negative) {\n338\t        b.is_negative = false;\n339\t        result = bigint_sub(a, b);\n340\t        return result;\n341\t    } else {\n342\t        result.is_negative = false;\n343\t    }\n344\t    result.size = a.size > b.size ? a.size : b.size;\n345\t    result.digits = malloc(result.size * sizeof(int64_t));\n346\t    \n347\t\n348\t    \n349\t    // Add the digits\n350\t    int64_t carry = 0;\n351\t    for (size_t i = 0; i < result.size; i++) {\n352\t        int64_t sum = carry;\n353\t        if (i < a.size) {\n354\t            sum += a.digits[a.size - i - 1];\n355\t        }\n356\t        if (i < b.size) {\n357\t            sum += b.digits[b.size - i - 1];\n358\t        }\n359\t        result.digits[result.size - i - 1] = sum % 10;\n360\t        carry = sum / 10;\n361\t    }\n362\t    \n363\t    // If there is a carry, add another digit\n364\t    if (carry > 0) {\n365\t        result.size++;\n366\t        result.digits = realloc(result.digits, result.size * sizeof(int64_t));\n367\t        for (size_t i = result.size - 1; i > 0; i--) {\n368\t            result.digits[i] = result.digits[i - 1];\n369\t        }\n370\t        result.digits[0] = carry;\n371\t    }\n372\t    bigint_remove_leading_zeros(&result);\n373\t    \n374\t    return result;\n375\t}\n376\t\n377\t\n378\tbigint bigint_inc(bigint *n) {\n379\t    bigint one = bigint_from_string(\"1\"), tmp;\n380\t    tmp = *n;\n381\t    *n = bigint_add(*n, one);\n382\t    bigint_delete(tmp);\n383\t    bigint_delete(one);\n384\t    return *n;\n385\t}\n386\t\n387\tbigint bigint_dec(bigint *n) {\n388\t    bigint one = bigint_from_string(\"1\"), tmp;\n389\t    tmp = *n;\n390\t    *n = bigint_sub(*n, one);\n391\t    bigint_delete(tmp);\n392\t    bigint_delete(one);\n393\t    return *n;\n394\t}\n395\t\n396\tbigint bigint_mul(bigint a, bigint b) {\n397\t    if (bigint_is_64_bit(a) && bigint_is_64_bit(b)) {\n398\t        return bigint_from_int(bigint_to_int(a) * bigint_to_int(b));\n399\t    }\n400\t\n401\t\n402\t    bigint result;\n403\t    result.size = a.size + b.size;\n404\t    result.digits = malloc(result.size * sizeof(int64_t));\n405\t    \n406\t    // Multiply the digits\n407\t    for (size_t i = 0; i < result.size; i++) {\n408\t        result.digits[i] = 0;\n409\t    }\n410\t    for (size_t i = 0; i < a.size; i++) {\n411\t        for (size_t j = 0; j < b.size; j++) {\n412\t            result.digits[result.size - i - j - 1] += a.digits[a.size - i - 1] * b.digits[b.size - j - 1];\n413\t        }\n414\t    }\n415\t\n416\t    // Normalize the result\n417\t    int64_t carry = 0;\n418\t    for (size_t i = 0; i < result.size; i++) {\n419\t        int64_t sum = result.digits[result.size - i - 1] + carry;\n420\t        result.digits[result.size - i - 1] = sum % 10;\n421\t        carry = sum / 10;\n422\t    }\n423\t\n424\t    // If there is a carry, add another digit\n425\t    if (carry > 0) {\n426\t        result.size++;\n427\t        result.digits = realloc(result.digits, result.size * sizeof(int64_t));\n428\t        for (size_t i = result.size - 1; i > 0; i--) {\n429\t            result.digits[i] = result.digits[i - 1];\n430\t        }\n431\t        result.digits[0] = carry;\n432\t    }\n433\t    \n434\t    bigint_remove_leading_zeros(&result);\n435\t    \n436\t    // Check negative\n437\t    result.is_negative = a.is_negative != b.is_negative;\n438\t    \n439\t    return result;\n440\t}\n441\t\n442\t\n443\tbigint bigint_divmod(bigint numerator, bigint denominator, bigint *remainder) {\n444\t    if (bigint_is_64_bit(numerator) && bigint_is_64_bit(denominator)) {\n445\t        int64_t quotient = bigint_to_int(numerator) / bigint_to_int(denominator);\n446\t        int64_t rem = bigint_to_int(numerator) % bigint_to_int(denominator);\n447\t        *remainder = bigint_from_int(rem);\n448\t        return bigint_from_int(quotient);\n449\t    }\n450\t\n451\t    bigint quotient = bigint_from_string(\"0\");\n452\t    \n453\t    bool negative = numerator.is_negative != denominator.is_negative;\n454\t    numerator.is_negative = false;\n455\t    denominator.is_negative = false;\n456\t    \n457\t    bigint tmp1, tmp2;\n458\t    numerator = bigint_copy(numerator);\n459\t\n460\t    // Divide the numerator by the denominator\n461\t    // This is a very slow algorithm\n462\t    // It works by subtracting the denominator from the numerator until the numerator is less than the denominator\n463\t    // The number of times the denominator is subtracted is the quotient\n464\t    // The remainder is the numerator after the last subtraction\n465\t    while (bigint_gtzero(numerator)) {\n466\t        tmp1 = numerator;\n467\t        numerator = bigint_sub(numerator, denominator);\n468\t        bigint_delete(tmp1);\n469\t        if (bigint_ltzero(numerator)) {\n470\t            break;\n471\t        }\n472\t        bigint_inc(&quotient);\n473\t    }\n474\t    if (bigint_ltzero(numerator)) {\n475\t        tmp1 = numerator;\n476\t        numerator = bigint_add(numerator, denominator);\n477\t        bigint_delete(tmp1);\n478\t    }\n479\t\n480\t    // Set the remainder\n481\t    *remainder = numerator;\n482\t\n483\t    bigint_remove_leading_zeros(&quotient);\n484\t\n485\t    if (negative) {\n486\t        quotient.is_negative = true;\n487\t        remainder->is_negative = true;\n488\t    }\n489\t\n490\t    return quotient;\n491\t}\n492\t\n493\tbigint bigint_div(bigint a, bigint b) {\n494\t    if (bigint_is_64_bit(a) && bigint_is_64_bit(b)) {\n495\t        return bigint_from_int(bigint_to_int(a) / bigint_to_int(b));\n496\t    }\n497\t\n498\t    bigint remainder;\n499\t    bigint result = bigint_divmod(a, b, &remainder);\n500\t    bigint_delete(remainder);\n501\t    return result;\n502\t}\n503\t\n504\tbigint bigint_mod(bigint a, bigint b) {\n505\t    if (bigint_is_64_bit(a) && bigint_is_64_bit(b)) {\n506\t        bigint result = bigint_from_int(bigint_to_int(a) % bigint_to_int(b));\n507\t        // printf(\"Computing %lld %% %lld = %lld\\n\", bigint_to_int(a), bigint_to_int(b), bigint_to_int(result));\n508\t        return result;\n509\t    }\n510\t\n511\t    bigint remainder;\n512\t    bigint_delete(bigint_divmod(a, b, &remainder));\n513\t    return remainder;\n514\t}\n515\t\n516\tbigint bigint_pow(bigint a, bigint b) {\n517\t    bigint result, tmp;\n518\t    if (b.is_negative) {\n519\t        result = bigint_from_string(\"0\");\n520\t        return result;\n521\t    }\n522\t    result = bigint_from_string(\"1\");\n523\t    if (bigint_eqzero(b)) {\n524\t        return result;\n525\t    }\n526\t    b = bigint_copy(b);\n527\t    while (!bigint_eqzero(b)) {\n528\t        tmp = result;\n529\t        result = bigint_mul(result, a);\n530\t        bigint_delete(tmp);\n531\t        bigint_dec(&b);\n532\t    }\n533\t    bigint_delete(b);\n534\t    return result;\n535\t}\n536\t\n537\tbool bigint_is_odd(bigint n);\n538\tbool bigint_is_even(bigint n);\n539\t\n540\tbigint bigint_fast_pow(bigint a, bigint b, bigint m) {\n541\t    if (bigint_is_64_bit(a) && bigint_is_64_bit(b) && bigint_is_64_bit(m)) {\n542\t        int64_t result = 1;\n543\t        int64_t base = bigint_to_int(a);\n544\t        int64_t exp = bigint_to_int(b);\n545\t        int64_t mod = bigint_to_int(m);\n546\t        base %= mod;\n547\t        while (exp > 0) {\n548\t            if (exp % 2 == 1) {\n549\t                result = (result * base) % mod;\n550\t            }\n551\t            exp = exp >> 1;\n552\t            base = (base * base) % mod;\n553\t        }\n554\t        return bigint_from_int(result);\n555\t    }\n556\t    \n557\t    bigint result;\n558\t\n559\t    if (b.is_negative) {\n560\t        result = bigint_from_string(\"0\");\n561\t        return result;\n562\t    }\n563\t    if (bigint_eqzero(b)) {\n564\t        result = bigint_from_string(\"1\");\n565\t        return result;\n566\t    }\n567\t\n568\t    bigint tmp1, tmp2;\n569\t    // printf(\"Computing %lld ^ %lld mod %lld\\n\", bigint_to_int(a), bigint_to_int(b), bigint_to_int(m));\n570\t    b = bigint_copy(b);\n571\t    a = bigint_mod(a, m);\n572\t    result = bigint_copy(a);\n573\t    bigint b_save = bigint_copy(b);\n574\t    bigint_dec(&b);\n575\t\n576\t    bigint pow = bigint_from_string(\"1\");\n577\t    while (true) {\n578\t        tmp1 = bigint_from_string(\"2\");\n579\t        tmp2 = bigint_div(b, tmp1);\n580\t        bigint_delete(tmp1);\n581\t        if (!bigint_gtzero(tmp2)) {\n582\t            bigint_delete(tmp2);\n583\t            break;\n584\t        }\n585\t        bigint_delete(tmp2);\n586\t\n587\t        tmp1 = bigint_mul(result, result);\n588\t        tmp2 = result;\n589\t        result = bigint_mod(tmp1, m);\n590\t        bigint_delete(tmp1);\n591\t        bigint_delete(tmp2);\n592\t\n593\t        // Halve b\n594\t        tmp1 = b;\n595\t        tmp2 = bigint_from_string(\"2\");\n596\t        \n597\t        b = bigint_div(b, tmp2);\n598\t        bigint_delete(tmp1);\n599\t        bigint_delete(tmp2);\n600\t        \n601\t        tmp1 = pow;\n602\t        pow = bigint_add(pow, pow);\n603\t        bigint_delete(tmp1);\n604\t    }\n605\t    \n606\t    tmp1 = b_save;\n607\t    b_save = bigint_sub(b_save, pow);\n608\t    bigint_delete(tmp1);\n609\t\n610\t    if (bigint_is_odd(b_save)) {\n611\t        tmp1 = result;\n612\t        tmp2 = bigint_mul(result, a);\n613\t        result = bigint_mod(tmp2, m);\n614\t        bigint_delete(tmp1);\n615\t        bigint_delete(tmp2);\n616\t        bigint_dec(&b_save);\n617\t        bigint_inc(&pow);\n618\t    }\n619\t\n620\t    if (bigint_lt(b_save, bigint_from_int(5))) {\n621\t        while (!bigint_eqzero(b_save)) {\n622\t            tmp1 = result;\n623\t            tmp2 = bigint_mul(result, a);\n624\t            result = bigint_mod(tmp2, m);\n625\t            bigint_delete(tmp1);\n626\t            bigint_delete(tmp2);\n627\t            bigint_dec(&b_save);\n628\t            bigint_inc(&pow);\n629\t        }\n630\t\n631\t        bigint_delete(b_save);\n632\t        bigint_delete(pow);\n633\t\n634\t        return result;\n635\t    }\n636\t\n637\t    // Do the same halving powers for the subpart\n638\t    bigint subpart = bigint_fast_pow(a, b_save, m);\n639\t\n640\t    tmp1 = result;\n641\t    tmp2 = subpart;\n642\t    result = bigint_mul(result, subpart);\n643\t    bigint_delete(tmp1);\n644\t    bigint_delete(tmp2);\n645\t\n646\t    tmp1 = result;\n647\t    result = bigint_mod(result, m);\n648\t    bigint_delete(tmp1);\n649\t\n650\t    bigint_delete(b_save);\n651\t    bigint_delete(pow);\n652\t    \n653\t    return result;\n654\t}\n655\t\n656\tbigint bigint_modinv(bigint a, bigint m) {\n657\t    bigint m0 = bigint_copy(m);\n658\t    bigint y = bigint_from_string(\"0\");\n659\t    bigint x = bigint_from_string(\"1\");\n660\t    bigint q = bigint_from_string(\"0\");\n661\t    bigint t = bigint_from_string(\"0\");\n662\t    bigint temp = bigint_from_string(\"0\");\n663\t    bigint one = bigint_from_string(\"1\");\n664\t    a = bigint_copy(a);\n665\t    m = bigint_copy(m);\n666\t\n667\t    bigint tmp1, tmp2;\n668\t    while (!bigint_eqzero(a)) {\n669\t        tmp1 = q;\n670\t        q = bigint_div(m, a);\n671\t        bigint_delete(tmp1);\n672\t\n673\t        tmp1 = t;\n674\t        tmp2 = bigint_mul(q, a);\n675\t        t = bigint_sub(m, tmp2);\n676\t        bigint_delete(tmp1);\n677\t        bigint_delete(tmp2);\n678\t\n679\t        tmp1 = m, tmp2 = a;\n680\t        m = bigint_copy(a);\n681\t        a = bigint_copy(t);\n682\t        bigint_delete(tmp1);\n683\t        bigint_delete(tmp2);\n684\t\n685\t        tmp1 = t;\n686\t        tmp2 = bigint_mul(q, x);\n687\t        t = bigint_sub(y, tmp2);\n688\t        bigint_delete(tmp1);\n689\t        bigint_delete(tmp2);\n690\t\n691\t        tmp1 = y, tmp2 = x;\n692\t        y = bigint_copy(x);\n693\t        x = bigint_copy(t);\n694\t        bigint_delete(tmp1);\n695\t        bigint_delete(tmp2);\n696\t    }\n697\t    if (bigint_ltzero(m)) {\n698\t        tmp1 = m;\n699\t        m = bigint_add(m, m0);\n700\t        bigint_delete(tmp1);\n701\t    }\n702\t\n703\t    if (bigint_eq(m, one)) {\n704\t        bigint result = bigint_mod(y, m0);\n705\t        if (bigint_ltzero(result)) {\n706\t            tmp1 = result;\n707\t            result = bigint_add(result, m0);\n708\t            bigint_delete(tmp1);\n709\t        }\n710\t        bigint_delete(a);\n711\t        bigint_delete(m);\n712\t        bigint_delete(m0);\n713\t        bigint_delete(y);\n714\t        bigint_delete(x);\n715\t        bigint_delete(q);\n716\t        bigint_delete(t);\n717\t        bigint_delete(temp);\n718\t        bigint_delete(one);\n719\t        return result;\n720\t    }\n721\t    bigint_delete(a);\n722\t    bigint_delete(m);\n723\t    bigint_delete(m0);\n724\t    bigint_delete(y);\n725\t    bigint_delete(x);\n726\t    bigint_delete(q);\n727\t    bigint_delete(t);\n728\t    bigint_delete(temp);\n729\t    bigint_delete(one);\n730\t    return bigint_from_int(0);\n731\t}\n732\t\n733\tbigint bigint_sqrt(bigint n) {\n734\t    bigint one = bigint_from_string(\"1\");\n735\t    bigint two = bigint_from_string(\"2\");\n736\t    bigint low = bigint_from_string(\"0\");\n737\t    bigint high = bigint_copy(n);\n738\t    bigint mid = bigint_from_string(\"0\");\n739\t    while (bigint_lt(low, high)) {\n740\t        bigint tmp1 = bigint_add(low, high);\n741\t        bigint tmp2 = mid;\n742\t        mid = bigint_div(tmp1, two);\n743\t        bigint_delete(tmp1);\n744\t        bigint_delete(tmp2);\n745\t        tmp1 = bigint_mul(mid, mid);\n746\t        if (bigint_lt(tmp1, n)) {\n747\t            tmp2 = low;\n748\t            low = bigint_add(mid, one);\n749\t            bigint_delete(tmp2);\n750\t        } else {\n751\t            tmp2 = high;\n752\t            high = bigint_copy(mid);\n753\t            bigint_delete(tmp2);\n754\t        }\n755\t        bigint_delete(tmp1);\n756\t    }\n757\t\n758\t    bigint_delete(one);\n759\t    bigint_delete(two);\n760\t    bigint_delete(mid);\n761\t    bigint_delete(high);\n762\t\n763\t    return low;\n764\t}\n765\t\n766\tbool bigint_is_even(bigint n) {\n767\t    return n.digits[n.size - 1] % 2 == 0;\n768\t}\n769\t\n770\tbool bigint_is_odd(bigint n) {\n771\t    return n.digits[n.size - 1] % 2 == 1;\n772\t}\n773\t\n774\tbool bigint_is_prime(bigint n) {\n775\t    bigint tmp1, tmp2;\n776\t    // Check if the number is even\n777\t    if (bigint_is_even(n)) {\n778\t        return false;\n779\t    }\n780\t\n781\t    // If the last digit is a 5 or 0, the number is divisible by 5\n782\t    if (n.size > 1 && (n.digits[n.size - 1] == 5 || n.digits[n.size - 1] == 0)) {\n783\t        return false;\n784\t    }\n785\t    // Check if the sum of the digits is divisible by 3\n786\t    bigint sum = bigint_from_string(\"0\");\n787\t    for (size_t i = 0; i < n.size; i++) {\n788\t        tmp1 = bigint_from_int(n.digits[i]);\n789\t        tmp2 = sum;\n790\t        sum = bigint_add(sum, tmp1);\n791\t        bigint_delete(tmp1);\n792\t        bigint_delete(tmp2);\n793\t    }\n794\t\n795\t    tmp1 = bigint_from_string(\"3\");\n796\t    tmp2 = bigint_mod(sum, tmp1);\n797\t    if (bigint_eqzero(tmp2)) {\n798\t        bigint_delete(tmp1);\n799\t        bigint_delete(tmp2);\n800\t        bigint_delete(sum);\n801\t        return false;\n802\t    }\n803\t    bigint_delete(tmp1);\n804\t    bigint_delete(tmp2);\n805\t    bigint_delete(sum);\n806\t\n807\t    bigint sqrt_n = bigint_sqrt(n);\n808\t    \n809\t    for (tmp1 = bigint_from_string(\"2\"); bigint_le(tmp1, sqrt_n); bigint_inc(&tmp1)) {\n810\t        tmp2 = bigint_mod(n, tmp1);\n811\t        if (bigint_eqzero(tmp2)) {\n812\t            bigint_delete(tmp1);\n813\t            bigint_delete(tmp2);\n814\t            bigint_delete(sqrt_n);\n815\t            return false;\n816\t        }\n817\t        bigint_delete(tmp2);\n818\t    }\n819\t    bigint_delete(tmp1);\n820\t    bigint_delete(sqrt_n);\n821\t    return true;\n822\t}\n823\t\n824\t/* Delete a bigint\n825\t* @param n The bigint to delete\n826\t*/\n827\t#include <execinfo.h>\n828\tvoid bigint_delete(bigint n) {\n829\t    free(n.digits);\n830\t    n.digits = NULL;\n831\t    n.is_negative = false;\n832\t    n.size = 0;\n833\t}\n834\t\n835\t#endif"}]},"parent_tool_use_id":null,"session_id":"4a226f7a-200d-41ff-86b3-5d2435014809","uuid":"3193589f-1cd1-4ed6-86d0-c9526df11e66","timestamp":"2026-06-05T21:19:52.989Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-yKoHHZ/project/c_src/src/bigint.h","content":"/*\n * Adam's Big Integer Library\n * Version 1.0\n */\n#ifndef bigint_H\n#define bigint_H\n\n#include <stdint.h>\n#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <assert.h>\n\ntypedef struct {\n    bool is_negative;\n    int64_t *digits;\n    size_t size;\n} bigint;\n\nvoid bigint_delete(bigint n);\n\nbigint bigint_zero() {\n    bigint result;\n    result.is_negative = false;\n    result.size = 1;\n    result.digits = malloc(sizeof(int64_t));\n    result.digits[0] = 0;\n    return result;\n}\n\nvoid bigint_print(bigint n);\n\nbool bigint_is_64_bit(bigint n) {\n    if (n.is_negative) {\n        if (n.size > 10) {\n            return false;\n        }\n        if (n.size < 10) {\n            return true;\n        }\n    } else {\n        if (n.size > 10) {\n            return false;\n        }\n        if (n.size < 10) {\n            return true;\n        }\n    }\n    return false;\n}\n\nvoid bigint_remove_leading_zeros(bigint *n) {\n    size_t leading_zeros = 0;\n    for (size_t i = 0; i < n->size; i++) {\n        if (n->digits[i] == 0) {\n            leading_zeros++;\n        } else {\n            break;\n        }\n    }\n\n    // If there are leading zeros, memmove the digits\n    if (leading_zeros > 0) {\n        if (leading_zeros >= n->size) {\n            n->size = 1;\n            n->digits[0] = 0;\n            return;\n        }\n        n->size -= leading_zeros;\n        memmove(n->digits, n->digits + leading_zeros, n->size * sizeof(int64_t));\n    }\n}\n\nbigint bigint_from_int(int64_t n) {\n    bigint result;\n    if (n < 0) {\n        result.is_negative = true;\n        n = -n;\n    } else {\n        result.is_negative = false;\n    }\n    result.size = 1;\n    int64_t m = n;\n    while (m > 0) {\n        m /= 10;\n        result.size++;\n    }\n    result.digits = malloc(result.size * sizeof(int64_t));\n    m = n;\n    for (size_t i = 0; i < result.size; i++) {\n        result.digits[result.size - i - 1] = m % 10;\n        m /= 10;\n    }\n    bigint_remove_leading_zeros(&result);\n    return result;\n}\n\nint64_t bigint_to_int(bigint n) {\n    int64_t result = 0;\n    for (size_t i = 0; i < n.size; i++) {\n        result *= 10;\n        result += n.digits[i];\n    }\n    if (n.is_negative) {\n        result = -result;\n    }\n    return result;\n}\n\n/* Create a new bigint from an integer \n* @param n The integer to create a bigint from\n* @return A new bigint with the value of n\n*/\nbigint bigint_from_string(const char *n) {\n    bigint result;\n    \n    // Determine if the number is negative\n    if (n[0] == '-') {\n        result.is_negative = true;\n        n++;\n    } else {\n        result.is_negative = false;\n    }\n\n    // Determine the size of the number\n    result.size = strlen(n);\n\n    // Allocate memory for the digits\n    result.digits = malloc(result.size * sizeof(int64_t));\n    \n    // Copy the digits into the bigint\n    for (size_t i = 0; i < result.size; i++) {\n        result.digits[i] = n[i] - '0';\n    }\n    \n    return result;\n}\n\n\nbigint bigint_copy(bigint n) {\n    bigint result;\n    result.is_negative = n.is_negative;\n    result.size = n.size;\n    result.digits = malloc(result.size * sizeof(int64_t));\n    memcpy(result.digits, n.digits, result.size * sizeof(int64_t));\n    return result;\n}\n\n/* Print a bigint\n* @param n The bigint to print\n*/\nvoid bigint_print(bigint n) {\n    if (n.is_negative) {\n        printf(\"-\");\n    }\n    for (size_t i = 0; i < n.size; i++) {\n        assert(n.digits[i] >= 0 && n.digits[i] <= 9);\n        printf(\"%lld\", n.digits[i]);\n    }\n}\n\n\nbool bigint_gt(bigint a, bigint b) {\n    bigint_remove_leading_zeros(&a);\n    bigint_remove_leading_zeros(&b);\n    if (a.size > b.size) {\n        return !a.is_negative;\n    }\n    if (a.size < b.size) {\n        return a.is_negative;\n    }\n    for (size_t i = 0; i < a.size; i++) {\n        if (a.digits[i] > b.digits[i]) {\n            return !a.is_negative;\n        }\n        if (a.digits[i] < b.digits[i]) {\n            return a.is_negative;\n        }\n    }\n    return false;\n}\n\nbool bigint_eq(bigint a, bigint b) {\n    bigint_remove_leading_zeros(&a);\n    bigint_remove_leading_zeros(&b);\n    if (a.size != b.size) {\n        return false;\n    }\n    if (a.is_negative != b.is_negative) {\n        return false;\n    }\n    for (size_t i = 0; i < a.size; i++) {\n        if (a.digits[i] != b.digits[i]) {\n            return false;\n        }\n    }\n    return true;\n}\n\nbool bigint_eqzero(bigint n) {\n    bigint_remove_leading_zeros(&n);\n    if (n.size == 1 && n.digits[0] == 0) {\n        return true;\n    }\n    return false;\n}\n\nbool bigint_ltzero(bigint n) {\n    bigint_remove_leading_zeros(&n);\n    if (n.size == 1 && n.digits[0] == 0) {\n        return false;\n    }\n    return n.is_negative;\n}\nbool bigint_gtzero(bigint n) {\n    bigint_remove_leading_zeros(&n);\n    if (n.size == 1 && n.digits[0] == 0) {\n        return false;\n    }\n    return !n.is_negative;\n}\n\nbool bigint_lezero(bigint n) {\n    bigint_remove_leading_zeros(&n);\n    if (n.size == 1 && n.digits[0] == 0) {\n        return true;\n    }\n    return n.is_negative;\n}\n\nbool bigint_gezero(bigint n) {\n    bigint_remove_leading_zeros(&n);\n    if (n.size == 1 && n.digits[0] == 0) {\n        return true;\n    }\n    return !n.is_negative;\n}\n\nbigint bigint_abs(bigint n) {\n    n.is_negative = false;\n    return n;\n}\n\nbool bigint_ge(bigint a, bigint b) {\n    return bigint_gt(a, b) || bigint_eq(a, b);\n}\n\nbool bigint_lt(bigint a, bigint b) {\n    return !bigint_ge(a, b);\n}\n\nbool bigint_le(bigint a, bigint b) {\n    return !bigint_gt(a, b);\n}\n\n\nbigint bigint_add(bigint a, bigint b);\n\n/* Subtract two bigints\n* @param a The first bigint\n* @param b The second bigint\n* @return The difference of a and b\n*/\nbigint bigint_sub(bigint a, bigint b) {\n    bigint result;\n    if (a.is_negative && b.is_negative) {\n        a.is_negative = false;\n        b.is_negative = false;\n        result = bigint_add(b, a);\n        result.is_negative = true;\n        return result;\n    }\n    \n    if (a.is_negative) {\n        // -a - b = -(a + b)\n        b.is_negative = true;\n        result = bigint_add(a, b);\n        return result;\n    }\n\n    if (b.is_negative) {\n        // a - (-b) = a + b\n        b.is_negative = false;\n        result = bigint_add(a, b);\n        return result;\n    }\n\n    result.size = a.size > b.size ? a.size : b.size;\n    result.digits = malloc(result.size * sizeof(int64_t));\n    \n    bool is_negative = bigint_lt(a, b);\n\n\n    // Subtract the digits\n    int64_t carry = 0;\n    bigint larger = bigint_gt(a, b) ? a : b;\n    bigint smaller = bigint_gt(a, b) ? b : a;\n\n    for (size_t i = 0; i < result.size; i++) {\n        int64_t diff = carry;\n        if (i < larger.size) {\n            diff += larger.digits[larger.size - i - 1];\n        }\n        if (i < smaller.size) {\n            diff -= smaller.digits[smaller.size - i - 1];\n        }\n        if (diff < 0) {\n            diff += 10;\n            carry = -1;\n        } else {\n            carry = 0;\n        }\n        result.digits[result.size - i - 1] = diff;\n    }\n    \n    bigint_remove_leading_zeros(&result);\n\n    result.is_negative = is_negative;\n\n    return result;\n}\n\n/* Add two bigints\n* @param a The first bigint\n* @param b The second bigint\n* @return The sum of a and b\n*/\nbigint bigint_add(bigint a, bigint b) {\n    bigint result;\n    if (a.is_negative && b.is_negative) {\n        result.is_negative = true;\n    } else if (a.is_negative) {\n        a.is_negative = false;\n        result = bigint_sub(b, a);\n        return result;\n    } else if (b.is_negative) {\n        b.is_negative = false;\n        result = bigint_sub(a, b);\n        return result;\n    } else {\n        result.is_negative = false;\n    }\n    result.size = a.size > b.size ? a.size : b.size;\n    result.digits = malloc(result.size * sizeof(int64_t));\n    \n\n    \n    // Add the digits\n    int64_t carry = 0;\n    for (size_t i = 0; i < result.size; i++) {\n        int64_t sum = carry;\n        if (i < a.size) {\n            sum += a.digits[a.size - i - 1];\n        }\n        if (i < b.size) {\n            sum += b.digits[b.size - i - 1];\n        }\n        result.digits[result.size - i - 1] = sum % 10;\n        carry = sum / 10;\n    }\n    \n    // If there is a carry, add another digit\n    if (carry > 0) {\n        result.size++;\n        result.digits = realloc(result.digits, result.size * sizeof(int64_t));\n        for (size_t i = result.size - 1; i > 0; i--) {\n            result.digits[i] = result.digits[i - 1];\n        }\n        result.digits[0] = carry;\n    }\n    bigint_remove_leading_zeros(&result);\n    \n    return result;\n}\n\n\nbigint bigint_inc(bigint *n) {\n    bigint one = bigint_from_string(\"1\"), tmp;\n    tmp = *n;\n    *n = bigint_add(*n, one);\n    bigint_delete(tmp);\n    bigint_delete(one);\n    return *n;\n}\n\nbigint bigint_dec(bigint *n) {\n    bigint one = bigint_from_string(\"1\"), tmp;\n    tmp = *n;\n    *n = bigint_sub(*n, one);\n    bigint_delete(tmp);\n    bigint_delete(one);\n    return *n;\n}\n\nbigint bigint_mul(bigint a, bigint b) {\n    if (bigint_is_64_bit(a) && bigint_is_64_bit(b)) {\n        return bigint_from_int(bigint_to_int(a) * bigint_to_int(b));\n    }\n\n\n    bigint result;\n    result.size = a.size + b.size;\n    result.digits = malloc(result.size * sizeof(int64_t));\n    \n    // Multiply the digits\n    for (size_t i = 0; i < result.size; i++) {\n        result.digits[i] = 0;\n    }\n    for (size_t i = 0; i < a.size; i++) {\n        for (size_t j = 0; j < b.size; j++) {\n            result.digits[result.size - i - j - 1] += a.digits[a.size - i - 1] * b.digits[b.size - j - 1];\n        }\n    }\n\n    // Normalize the result\n    int64_t carry = 0;\n    for (size_t i = 0; i < result.size; i++) {\n        int64_t sum = result.digits[result.size - i - 1] + carry;\n        result.digits[result.size - i - 1] = sum % 10;\n        carry = sum / 10;\n    }\n\n    // If there is a carry, add another digit\n    if (carry > 0) {\n        result.size++;\n        result.digits = realloc(result.digits, result.size * sizeof(int64_t));\n        for (size_t i = result.size - 1; i > 0; i--) {\n            result.digits[i] = result.digits[i - 1];\n        }\n        result.digits[0] = carry;\n    }\n    \n    bigint_remove_leading_zeros(&result);\n    \n    // Check negative\n    result.is_negative = a.is_negative != b.is_negative;\n    \n    return result;\n}\n\n\nbigint bigint_divmod(bigint numerator, bigint denominator, bigint *remainder) {\n    if (bigint_is_64_bit(numerator) && bigint_is_64_bit(denominator)) {\n        int64_t quotient = bigint_to_int(numerator) / bigint_to_int(denominator);\n        int64_t rem = bigint_to_int(numerator) % bigint_to_int(denominator);\n        *remainder = bigint_from_int(rem);\n        return bigint_from_int(quotient);\n    }\n\n    bigint quotient = bigint_from_string(\"0\");\n    \n    bool negative = numerator.is_negative != denominator.is_negative;\n    numerator.is_negative = false;\n    denominator.is_negative = false;\n    \n    bigint tmp1, tmp2;\n    numerator = bigint_copy(numerator);\n\n    // Divide the numerator by the denominator\n    // This is a very slow algorithm\n    // It works by subtracting the denominator from the numerator until the numerator is less than the denominator\n    // The number of times the denominator is subtracted is the quotient\n    // The remainder is the numerator after the last subtraction\n    while (bigint_gtzero(numerator)) {\n        tmp1 = numerator;\n        numerator = bigint_sub(numerator, denominator);\n        bigint_delete(tmp1);\n        if (bigint_ltzero(numerator)) {\n            break;\n        }\n        bigint_inc(&quotient);\n    }\n    if (bigint_ltzero(numerator)) {\n        tmp1 = numerator;\n        numerator = bigint_add(numerator, denominator);\n        bigint_delete(tmp1);\n    }\n\n    // Set the remainder\n    *remainder = numerator;\n\n    bigint_remove_leading_zeros(&quotient);\n\n    if (negative) {\n        quotient.is_negative = true;\n        remainder->is_negative = true;\n    }\n\n    return quotient;\n}\n\nbigint bigint_div(bigint a, bigint b) {\n    if (bigint_is_64_bit(a) && bigint_is_64_bit(b)) {\n        return bigint_from_int(bigint_to_int(a) / bigint_to_int(b));\n    }\n\n    bigint remainder;\n    bigint result = bigint_divmod(a, b, &remainder);\n    bigint_delete(remainder);\n    return result;\n}\n\nbigint bigint_mod(bigint a, bigint b) {\n    if (bigint_is_64_bit(a) && bigint_is_64_bit(b)) {\n        bigint result = bigint_from_int(bigint_to_int(a) % bigint_to_int(b));\n        // printf(\"Computing %lld %% %lld = %lld\\n\", bigint_to_int(a), bigint_to_int(b), bigint_to_int(result));\n        return result;\n    }\n\n    bigint remainder;\n    bigint_delete(bigint_divmod(a, b, &remainder));\n    return remainder;\n}\n\nbigint bigint_pow(bigint a, bigint b) {\n    bigint result, tmp;\n    if (b.is_negative) {\n        result = bigint_from_string(\"0\");\n        return result;\n    }\n    result = bigint_from_string(\"1\");\n    if (bigint_eqzero(b)) {\n        return result;\n    }\n    b = bigint_copy(b);\n    while (!bigint_eqzero(b)) {\n        tmp = result;\n        result = bigint_mul(result, a);\n        bigint_delete(tmp);\n        bigint_dec(&b);\n    }\n    bigint_delete(b);\n    return result;\n}\n\nbool bigint_is_odd(bigint n);\nbool bigint_is_even(bigint n);\n\nbigint bigint_fast_pow(bigint a, bigint b, bigint m) {\n    if (bigint_is_64_bit(a) && bigint_is_64_bit(b) && bigint_is_64_bit(m)) {\n        int64_t result = 1;\n        int64_t base = bigint_to_int(a);\n        int64_t exp = bigint_to_int(b);\n        int64_t mod = bigint_to_int(m);\n        base %= mod;\n        while (exp > 0) {\n            if (exp % 2 == 1) {\n                result = (result * base) % mod;\n            }\n            exp = exp >> 1;\n            base = (base * base) % mod;\n        }\n        return bigint_from_int(result);\n    }\n    \n    bigint result;\n\n    if (b.is_negative) {\n        result = bigint_from_string(\"0\");\n        return result;\n    }\n    if (bigint_eqzero(b)) {\n        result = bigint_from_string(\"1\");\n        return result;\n    }\n\n    bigint tmp1, tmp2;\n    // printf(\"Computing %lld ^ %lld mod %lld\\n\", bigint_to_int(a), bigint_to_int(b), bigint_to_int(m));\n    b = bigint_copy(b);\n    a = bigint_mod(a, m);\n    result = bigint_copy(a);\n    bigint b_save = bigint_copy(b);\n    bigint_dec(&b);\n\n    bigint pow = bigint_from_string(\"1\");\n    while (true) {\n        tmp1 = bigint_from_string(\"2\");\n        tmp2 = bigint_div(b, tmp1);\n        bigint_delete(tmp1);\n        if (!bigint_gtzero(tmp2)) {\n            bigint_delete(tmp2);\n            break;\n        }\n        bigint_delete(tmp2);\n\n        tmp1 = bigint_mul(result, result);\n        tmp2 = result;\n        result = bigint_mod(tmp1, m);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n\n        // Halve b\n        tmp1 = b;\n        tmp2 = bigint_from_string(\"2\");\n        \n        b = bigint_div(b, tmp2);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n        \n        tmp1 = pow;\n        pow = bigint_add(pow, pow);\n        bigint_delete(tmp1);\n    }\n    \n    tmp1 = b_save;\n    b_save = bigint_sub(b_save, pow);\n    bigint_delete(tmp1);\n\n    if (bigint_is_odd(b_save)) {\n        tmp1 = result;\n        tmp2 = bigint_mul(result, a);\n        result = bigint_mod(tmp2, m);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n        bigint_dec(&b_save);\n        bigint_inc(&pow);\n    }\n\n    if (bigint_lt(b_save, bigint_from_int(5))) {\n        while (!bigint_eqzero(b_save)) {\n            tmp1 = result;\n            tmp2 = bigint_mul(result, a);\n            result = bigint_mod(tmp2, m);\n            bigint_delete(tmp1);\n            bigint_delete(tmp2);\n            bigint_dec(&b_save);\n            bigint_inc(&pow);\n        }\n\n        bigint_delete(b_save);\n        bigint_delete(pow);\n\n        return result;\n    }\n\n    // Do the same halving powers for the subpart\n    bigint subpart = bigint_fast_pow(a, b_save, m);\n\n    tmp1 = result;\n    tmp2 = subpart;\n    result = bigint_mul(result, subpart);\n    bigint_delete(tmp1);\n    bigint_delete(tmp2);\n\n    tmp1 = result;\n    result = bigint_mod(result, m);\n    bigint_delete(tmp1);\n\n    bigint_delete(b_save);\n    bigint_delete(pow);\n    \n    return result;\n}\n\nbigint bigint_modinv(bigint a, bigint m) {\n    bigint m0 = bigint_copy(m);\n    bigint y = bigint_from_string(\"0\");\n    bigint x = bigint_from_string(\"1\");\n    bigint q = bigint_from_string(\"0\");\n    bigint t = bigint_from_string(\"0\");\n    bigint temp = bigint_from_string(\"0\");\n    bigint one = bigint_from_string(\"1\");\n    a = bigint_copy(a);\n    m = bigint_copy(m);\n\n    bigint tmp1, tmp2;\n    while (!bigint_eqzero(a)) {\n        tmp1 = q;\n        q = bigint_div(m, a);\n        bigint_delete(tmp1);\n\n        tmp1 = t;\n        tmp2 = bigint_mul(q, a);\n        t = bigint_sub(m, tmp2);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n\n        tmp1 = m, tmp2 = a;\n        m = bigint_copy(a);\n        a = bigint_copy(t);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n\n        tmp1 = t;\n        tmp2 = bigint_mul(q, x);\n        t = bigint_sub(y, tmp2);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n\n        tmp1 = y, tmp2 = x;\n        y = bigint_copy(x);\n        x = bigint_copy(t);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n    }\n    if (bigint_ltzero(m)) {\n        tmp1 = m;\n        m = bigint_add(m, m0);\n        bigint_delete(tmp1);\n    }\n\n    if (bigint_eq(m, one)) {\n        bigint result = bigint_mod(y, m0);\n        if (bigint_ltzero(result)) {\n            tmp1 = result;\n            result = bigint_add(result, m0);\n            bigint_delete(tmp1);\n        }\n        bigint_delete(a);\n        bigint_delete(m);\n        bigint_delete(m0);\n        bigint_delete(y);\n        bigint_delete(x);\n        bigint_delete(q);\n        bigint_delete(t);\n        bigint_delete(temp);\n        bigint_delete(one);\n        return result;\n    }\n    bigint_delete(a);\n    bigint_delete(m);\n    bigint_delete(m0);\n    bigint_delete(y);\n    bigint_delete(x);\n    bigint_delete(q);\n    bigint_delete(t);\n    bigint_delete(temp);\n    bigint_delete(one);\n    return bigint_from_int(0);\n}\n\nbigint bigint_sqrt(bigint n) {\n    bigint one = bigint_from_string(\"1\");\n    bigint two = bigint_from_string(\"2\");\n    bigint low = bigint_from_string(\"0\");\n    bigint high = bigint_copy(n);\n    bigint mid = bigint_from_string(\"0\");\n    while (bigint_lt(low, high)) {\n        bigint tmp1 = bigint_add(low, high);\n        bigint tmp2 = mid;\n        mid = bigint_div(tmp1, two);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n        tmp1 = bigint_mul(mid, mid);\n        if (bigint_lt(tmp1, n)) {\n            tmp2 = low;\n            low = bigint_add(mid, one);\n            bigint_delete(tmp2);\n        } else {\n            tmp2 = high;\n            high = bigint_copy(mid);\n            bigint_delete(tmp2);\n        }\n        bigint_delete(tmp1);\n    }\n\n    bigint_delete(one);\n    bigint_delete(two);\n    bigint_delete(mid);\n    bigint_delete(high);\n\n    return low;\n}\n\nbool bigint_is_even(bigint n) {\n    return n.digits[n.size - 1] % 2 == 0;\n}\n\nbool bigint_is_odd(bigint n) {\n    return n.digits[n.size - 1] % 2 == 1;\n}\n\nbool bigint_is_prime(bigint n) {\n    bigint tmp1, tmp2;\n    // Check if the number is even\n    if (bigint_is_even(n)) {\n        return false;\n    }\n\n    // If the last digit is a 5 or 0, the number is divisible by 5\n    if (n.size > 1 && (n.digits[n.size - 1] == 5 || n.digits[n.size - 1] == 0)) {\n        return false;\n    }\n    // Check if the sum of the digits is divisible by 3\n    bigint sum = bigint_from_string(\"0\");\n    for (size_t i = 0; i < n.size; i++) {\n        tmp1 = bigint_from_int(n.digits[i]);\n        tmp2 = sum;\n        sum = bigint_add(sum, tmp1);\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n    }\n\n    tmp1 = bigint_from_string(\"3\");\n    tmp2 = bigint_mod(sum, tmp1);\n    if (bigint_eqzero(tmp2)) {\n        bigint_delete(tmp1);\n        bigint_delete(tmp2);\n        bigint_delete(sum);\n        return false;\n    }\n    bigint_delete(tmp1);\n    bigint_delete(tmp2);\n    bigint_delete(sum);\n\n    bigint sqrt_n = bigint_sqrt(n);\n    \n    for (tmp1 = bigint_from_string(\"2\"); bigint_le(tmp1, sqrt_n); bigint_inc(&tmp1)) {\n        tmp2 = bigint_mod(n, tmp1);\n        if (bigint_eqzero(tmp2)) {\n            bigint_delete(tmp1);\n            bigint_delete(tmp2);\n            bigint_delete(sqrt_n);\n            return false;\n        }\n        bigint_delete(tmp2);\n    }\n    bigint_delete(tmp1);\n    bigint_delete(sqrt_n);\n    return true;\n}\n\n/* Delete a bigint\n* @param n The bigint to delete\n*/\n#include <execinfo.h>\nvoid bigint_delete(bigint n) {\n    free(n.digits);\n    n.digits = NULL;\n    n.is_negative = false;\n    n.size = 0;\n}\n\n#endif","numLines":835,"startLine":1,"totalLines":835}}}
