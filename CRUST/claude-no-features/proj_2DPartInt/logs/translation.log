ement.\n188\t */\n189\tvoid test_compute_acceleration_one_element() {\n190\t  #define size 1\n191\t  Vector forces[size] = { { 30, 30 } };\n192\t  ParticleProperties particle_properties[size] = { { 3, 0, 0 } };\n193\t  Vector accelerations[size] = { { 0 } };\n194\t\n195\t  compute_acceleration(0, particle_properties, forces, accelerations);\n196\t\n197\t  assert(accelerations[0].x_component, 10.0d, \"test_compute_acceleration_one_element - x_component\");\n198\t  assert(accelerations[0].y_component, 10.0d, \"test_compute_acceleration_one_element - y_component\");\n199\t  #undef size\n200\t}\n201\t\n202\t/**\n203\t * Checks that the compute_acceleration function works for arrays of multiple elements.\n204\t */\n205\tvoid test_compute_acceleration_multiple_elements() {\n206\t  #define size 3\n207\t  Vector forces[size] = { { -12.58, -15.896 }, { 13.945, -200.826 }, { -543.62, -0.62 } };\n208\t  ParticleProperties particle_properties[size] = { { 0.367, 0, 0 }, { 3.967, 0, 0 }, { 0.52, 0, 0 } };\n209\t  Vector accelerations[size] = { { 0 } };\n210\t\n211\t  compute_acceleration(0, particle_properties, forces, accelerations);\n212\t  compute_acceleration(1, particle_properties, forces, accelerations);\n213\t  compute_acceleration(2, particle_properties, forces, accelerations);\n214\t\n215\t  Vector expected[size] = { { -34.2779d, -43.31335149863761d }, { 3.5152508192588856d, -50.6241d }, { -1045.4231d, -1.1923d } };\n216\t  for (size_t i = 0; i < size; ++i) {\n217\t    for_assert(accelerations[i].x_component, expected[i].x_component, \"test_compute_acceleration_multiple_elements - x_component\", i);\n218\t    for_assert(accelerations[i].y_component, expected[i].y_component, \"test_compute_acceleration_multiple_elements - y_component\", i);\n219\t  }\n220\t  #undef size\n221\t}\n222\t\n223\t/**\n224\t * Checks that the compute_velocity function works for arrays of one element.\n225\t */\n226\tvoid test_compute_velocity_one_element() {\n227\t  #define size 1\n228\t  Vector