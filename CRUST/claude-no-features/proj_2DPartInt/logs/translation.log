y, square_length);\n        }\n    }\n}\n\npub fn write_particles_from_grid(\n    x_squares: i32,\n    y_squares: i32,\n    folder: &str,\n    grid: &Vec<&mut Vec<&mut data::Particle>>,\n    step: i32,\n) {\n    let _ = ensure_output_folder(folder);\n    let path = format!(\"{}/grid_step_{}.csv\", folder, step);\n    let mut file = match fs::File::create(&path) {\n        Ok(f) => f,\n        Err(_) => return,\n    };\n    let _ = writeln!(file, \"row,col,idx,x_coordinate,y_coordinate,radius\");\n    let x_squares_us = x_squares.max(0) as usize;\n    let y_squares_us = y_squares.max(0) as usize;\n    for row in 0..y_squares_us {\n        for col in 0..x_squares_us {\n            let idx = row * x_squares_us + col;\n            if idx >= grid.len() {\n                continue;\n            }\n            for p in grid[idx].iter() {\n                let _ = writeln!(\n                    file,\n                    \"{},{},{},{},{},{}\",\n                    row, col, p.idx, p.x_coordinate, p.y_coordinate, p.radius\n                );\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2762,"cache_read_input_tokens":53165,"cache_creation":{"ephemeral_5m_input_tokens":2762,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"9ace3cec-b4b5-45e5-a14b-b0dce43e343d","uuid":"b541f024-5a54-43a6-9886-0a6ecb1f6818"}
