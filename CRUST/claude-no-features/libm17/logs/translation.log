{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SUeBbptyYaqMsMfiGBWEjg","type":"tool_result","content":"1\t//-------------------------------\n2\t// M17 C library - phy/interleave.c\n3\t//\n4\t// Wojciech Kaczmarski, SP5WWP\n5\t// M17 Project, 28 December 2023\n6\t//-------------------------------\n7\t\n8\t#include <m17.h>\n9\t\n10\t//interleaver pattern\n11\tconst uint16_t intrl_seq[SYM_PER_PLD*2]=\n12\t{\n13\t\t0, 137, 90, 227, 180, 317, 270, 39, 360, 129, 82, 219, 172, 309, 262, 31,\n14\t\t352, 121, 74, 211, 164, 301, 254, 23, 344, 113, 66, 203, 156, 293, 246, 15,\n15\t\t336, 105, 58, 195, 148, 285, 238, 7, 328, 97, 50, 187, 140, 277, 230, 367,\n16\t\t320, 89, 42, 179, 132, 269, 222, 359, 312, 81, 34, 171, 124, 261, 214, 351,\n17\t\t304, 73, 26, 163, 116, 253, 206, 343, 296, 65, 18, 155, 108, 245, 198, 335,\n18\t\t288, 57, 10, 147, 100, 237, 190, 327, 280, 49, 2, 139, 92, 229, 182, 319,\n19\t\t272, 41, 362, 131, 84, 221, 174, 311, 264, 33, 354, 123, 76, 213, 166, 303,\n20\t\t256, 25, 346, 115, 68, 205, 158, 295, 248, 17, 338, 107, 60, 197, 150, 287,\n21\t\t240, 9, 330, 99, 52, 189, 142, 279, 232, 1, 322, 91, 44, 181, 134, 271,\n22\t\t224, 361, 314, 83, 36, 173, 126, 263, 216, 353, 306, 75, 28, 165, 118, 255,\n23\t\t208, 345, 298, 67, 20, 157, 110, 247, 200, 337, 290, 59, 12, 149, 102, 239,\n24\t\t192, 329, 282, 51, 4, 141, 94, 231, 184, 321, 274, 43, 364, 133, 86, 223,\n25\t\t176, 313, 266, 35, 356, 125, 78, 215, 168, 305, 258, 27, 348, 117, 70, 207,\n26\t\t160, 297, 250, 19, 340, 109, 62, 199, 152, 289, 242, 11, 332, 101, 54, 191,\n27\t\t144, 281, 234, 3, 324, 93, 46, 183, 136, 273, 226, 363, 316, 85, 38, 175,\n28\t\t128, 265, 218, 355, 308, 77, 30, 167, 120, 257, 210, 347, 300, 69, 22, 159,\n29\t\t112, 249, 202, 339, 292, 61, 14, 151, 104, 241, 194, 331, 284, 53, 6, 143,\n30\t\t96, 233, 186, 323, 276, 45, 366, 135, 88, 225, 178, 315, 268, 37, 358, 127,\n31\t\t80, 217, 170, 307, 260, 29, 350, 119, 72, 209, 162, 299, 252, 21, 342, 111,\n32\t\t64, 201, 154, 291, 244, 13, 334, 103, 56, 193, 146, 283, 236, 5, 326, 95,\n33\t\t48, 185, 138, 275, 228, 365, 318, 87, 40, 177, 130, 267, 220, 357, 310, 79,\n34\t\t32, 169, 122, 259, 212, 349, 302, 71, 24, 161, 114, 251, 204, 341, 294, 63,\n35\t\t16, 153, 106, 243, 196, 333, 286, 55, 8, 145, 98, 235, 188, 325, 278, 47\n36\t};\n37\t\n38\t/**\n39\t * @brief Reorder (interleave) 368 unpacked payload bits.\n40\t * \n41\t * @param outp Reordered, unpacked type-4 bits.\n42\t * @param inp Input unpacked type-2/3 bits.\n43\t */\n44\tvoid reorder_bits(uint8_t outp[SYM_PER_PLD*2], const uint8_t inp[SYM_PER_PLD*2])\n45\t{\n46\t\tfor(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n47\t        outp[i]=inp[intrl_seq[i]];\n48\t}\n49\t\n50\t/**\n51\t * @brief Reorder (interleave) 368 soft bits.\n52\t * \n53\t * @param outp Reordered soft bits.\n54\t * @param inp Input soft bits.\n55\t */\n56\tvoid reorder_soft_bits(uint16_t outp[SYM_PER_PLD*2], const uint16_t inp[SYM_PER_PLD*2])\n57\t{\n58\t\tfor(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n59\t        outp[i]=inp[intrl_seq[i]];\n60\t}\n61\t\n62\t//--------------------------------------------------------------------\n63\t// M17 C library - phy/randomize.c\n64\t//\n65\t// Wojciech Kaczmarski, SP5WWP\n66\t// M17 Project, 29 December 2023\n67\t//--------------------------------------------------------------------\n68\t\n69\t//randomizing pattern\n70\tconst uint8_t rand_seq[46]=\n71\t{\n72\t    0xD6, 0xB5, 0xE2, 0x30, 0x82, 0xFF, 0x84, 0x62, 0xBA, 0x4E, 0x96, 0x90, 0xD8, 0x98, 0xDD, 0x5D, 0x0C, 0xC8, 0x52, 0x43, 0x91, 0x1D, 0xF8,\n73\t    0x6E, 0x68, 0x2F, 0x35, 0xDA, 0x14, 0xEA, 0xCD, 0x76, 0x19, 0x8D, 0xD5, 0x80, 0xD1, 0x33, 0x87, 0x13, 0x57, 0x18, 0x2D, 0x29, 0x78, 0xC3\n74\t};\n75\t\n76\t/**\n77\t * @brief Randomize type-4 unpacked bits.\n78\t * \n79\t * @param inp Input 368 unpacked type-4 bits.\n80\t */\n81\tvoid randomize_bits(uint8_t inp[SYM_PER_PLD*2])\n82\t{\n83\t    for(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n84\t    {\n85\t        if((rand_seq[i/8]>>(7-(i%8)))&1) //flip bit if '1'\n86\t        {\n87\t            if(inp[i])\n88\t                inp[i]=0;\n89\t            else\n90\t                inp[i]=1;\n91\t        }\n92\t    }\n93\t}\n94\t\n95\t/**\n96\t * @brief Randomize type-4 soft bits.\n97\t * \n98\t * @param inp Input 368 soft type-4 bits.\n99\t */\n100\tvoid randomize_soft_bits(uint16_t inp[SYM_PER_PLD*2])\n101\t{\n102\t    for(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n103\t    {\n104\t        if((rand_seq[i/8]>>(7-(i%8)))&1) //flip bit if '1'\n105\t        {\n106\t            inp[i]=soft_bit_NOT(inp[i]);\n107\t        }\n108\t    }\n109\t}\n110\t\n111\t//-------------------------------\n112\t// M17 C library - phy/slice.c\n113\t//\n114\t// Wojciech Kaczmarski, SP5WWP\n115\t// M17 Project, 14 January 2024\n116\t//-------------------------------\n117\t\n118\t/**\n119\t * @brief Slice payload symbols into soft dibits.\n120\t * Input (RRC filtered baseband sampled at symbol centers)\n121\t * should be already normalized to {-3, -1, +1 +3}.\n122\t * @param out Soft valued dibits (type-4).\n123\t * @param inp Array of 184 floats (1 sample per symbol).\n124\t */\n125\tvoid slice_symbols(uint16_t out[2*SYM_PER_PLD], const float inp[SYM_PER_PLD])\n126\t{\n127\t    for(uint8_t i=0; i<SYM_PER_PLD; i++)\n128\t    {\n129\t        //bit 0\n130\t        if(inp[i]>=symbol_list[3])\n131\t        {\n132\t            out[i*2+1]=0xFFFF;\n133\t        }\n134\t        else if(inp[i]>=symbol_list[2])\n135\t        {\n136\t            out[i*2+1]=-(float)0xFFFF/(symbol_list[3]-symbol_list[2])*symbol_list[2]+inp[i]*(float)0xFFFF/(symbol_list[3]-symbol_list[2]);\n137\t        }\n138\t        else if(inp[i]>=symbol_list[1])\n139\t        {\n140\t            out[i*2+1]=0x0000;\n141\t        }\n142\t        else if(inp[i]>=symbol_list[0])\n143\t        {\n144\t            out[i*2+1]=(float)0xFFFF/(symbol_list[1]-symbol_list[0])*symbol_list[1]-inp[i]*(float)0xFFFF/(symbol_list[1]-symbol_list[0]);\n145\t        }\n146\t        else\n147\t        {\n148\t            out[i*2+1]=0xFFFF;\n149\t        }\n150\t\n151\t        //bit 1\n152\t        if(inp[i]>=symbol_list[2])\n153\t        {\n154\t            out[i*2]=0x0000;\n155\t        }\n156\t        else if(inp[i]>=symbol_list[1])\n157\t        {\n158\t            out[i*2]=0x7FFF-inp[i]*(float)0xFFFF/(symbol_list[2]-symbol_list[1]);\n159\t        }\n160\t        else\n161\t        {\n162\t            out[i*2]=0xFFFF;\n163\t        }\n164\t    }\n165\t}\n166\t\n167\t//--------------------------------------------------------------------\n168\t// M17 C library - phy/sync.c\n169\t//\n170\t// Wojciech Kaczmarski, SP5WWP\n171\t// M17 Project, 29 December 2023\n172\t//--------------------------------------------------------------------\n173\t\n174\t//syncwords\n175\tconst uint16_t SYNC_LSF = 0x55F7;\n176\tconst uint16_t SYNC_STR = 0xFF5D;\n177\tconst uint16_t SYNC_PKT = 0x75FF;\n178\tconst uint16_t SYNC_BER = 0xDF55;\n179\tconst uint16_t EOT_MRKR = 0x555D;\n180\t"}]},"parent_tool_use_id":null,"session_id":"fb86ecce-c22e-43b3-ac21-4377914c4b84","uuid":"15f6d483-34e1-49ed-b77b-d060885dadc0","timestamp":"2026-06-06T00:13:37.836Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-luchTz/project/c_src/phy/phy.c","content":"//-------------------------------\n// M17 C library - phy/interleave.c\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 28 December 2023\n//-------------------------------\n\n#include <m17.h>\n\n//interleaver pattern\nconst uint16_t intrl_seq[SYM_PER_PLD*2]=\n{\n\t0, 137, 90, 227, 180, 317, 270, 39, 360, 129, 82, 219, 172, 309, 262, 31,\n\t352, 121, 74, 211, 164, 301, 254, 23, 344, 113, 66, 203, 156, 293, 246, 15,\n\t336, 105, 58, 195, 148, 285, 238, 7, 328, 97, 50, 187, 140, 277, 230, 367,\n\t320, 89, 42, 179, 132, 269, 222, 359, 312, 81, 34, 171, 124, 261, 214, 351,\n\t304, 73, 26, 163, 116, 253, 206, 343, 296, 65, 18, 155, 108, 245, 198, 335,\n\t288, 57, 10, 147, 100, 237, 190, 327, 280, 49, 2, 139, 92, 229, 182, 319,\n\t272, 41, 362, 131, 84, 221, 174, 311, 264, 33, 354, 123, 76, 213, 166, 303,\n\t256, 25, 346, 115, 68, 205, 158, 295, 248, 17, 338, 107, 60, 197, 150, 287,\n\t240, 9, 330, 99, 52, 189, 142, 279, 232, 1, 322, 91, 44, 181, 134, 271,\n\t224, 361, 314, 83, 36, 173, 126, 263, 216, 353, 306, 75, 28, 165, 118, 255,\n\t208, 345, 298, 67, 20, 157, 110, 247, 200, 337, 290, 59, 12, 149, 102, 239,\n\t192, 329, 282, 51, 4, 141, 94, 231, 184, 321, 274, 43, 364, 133, 86, 223,\n\t176, 313, 266, 35, 356, 125, 78, 215, 168, 305, 258, 27, 348, 117, 70, 207,\n\t160, 297, 250, 19, 340, 109, 62, 199, 152, 289, 242, 11, 332, 101, 54, 191,\n\t144, 281, 234, 3, 324, 93, 46, 183, 136, 273, 226, 363, 316, 85, 38, 175,\n\t128, 265, 218, 355, 308, 77, 30, 167, 120, 257, 210, 347, 300, 69, 22, 159,\n\t112, 249, 202, 339, 292, 61, 14, 151, 104, 241, 194, 331, 284, 53, 6, 143,\n\t96, 233, 186, 323, 276, 45, 366, 135, 88, 225, 178, 315, 268, 37, 358, 127,\n\t80, 217, 170, 307, 260, 29, 350, 119, 72, 209, 162, 299, 252, 21, 342, 111,\n\t64, 201, 154, 291, 244, 13, 334, 103, 56, 193, 146, 283, 236, 5, 326, 95,\n\t48, 185, 138, 275, 228, 365, 318, 87, 40, 177, 130, 267, 220, 357, 310, 79,\n\t32, 169, 122, 259, 212, 349, 302, 71, 24, 161, 114, 251, 204, 341, 294, 63,\n\t16, 153, 106, 243, 196, 333, 286, 55, 8, 145, 98, 235, 188, 325, 278, 47\n};\n\n/**\n * @brief Reorder (interleave) 368 unpacked payload bits.\n * \n * @param outp Reordered, unpacked type-4 bits.\n * @param inp Input unpacked type-2/3 bits.\n */\nvoid reorder_bits(uint8_t outp[SYM_PER_PLD*2], const uint8_t inp[SYM_PER_PLD*2])\n{\n\tfor(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n        outp[i]=inp[intrl_seq[i]];\n}\n\n/**\n * @brief Reorder (interleave) 368 soft bits.\n * \n * @param outp Reordered soft bits.\n * @param inp Input soft bits.\n */\nvoid reorder_soft_bits(uint16_t outp[SYM_PER_PLD*2], const uint16_t inp[SYM_PER_PLD*2])\n{\n\tfor(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n        outp[i]=inp[intrl_seq[i]];\n}\n\n//--------------------------------------------------------------------\n// M17 C library - phy/randomize.c\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 29 December 2023\n//--------------------------------------------------------------------\n\n//randomizing pattern\nconst uint8_t rand_seq[46]=\n{\n    0xD6, 0xB5, 0xE2, 0x30, 0x82, 0xFF, 0x84, 0x62, 0xBA, 0x4E, 0x96, 0x90, 0xD8, 0x98, 0xDD, 0x5D, 0x0C, 0xC8, 0x52, 0x43, 0x91, 0x1D, 0xF8,\n    0x6E, 0x68, 0x2F, 0x35, 0xDA, 0x14, 0xEA, 0xCD, 0x76, 0x19, 0x8D, 0xD5, 0x80, 0xD1, 0x33, 0x87, 0x13, 0x57, 0x18, 0x2D, 0x29, 0x78, 0xC3\n};\n\n/**\n * @brief Randomize type-4 unpacked bits.\n * \n * @param inp Input 368 unpacked type-4 bits.\n */\nvoid randomize_bits(uint8_t inp[SYM_PER_PLD*2])\n{\n    for(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n    {\n        if((rand_seq[i/8]>>(7-(i%8)))&1) //flip bit if '1'\n        {\n            if(inp[i])\n                inp[i]=0;\n            else\n                inp[i]=1;\n        }\n    }\n}\n\n/**\n * @brief Randomize type-4 soft bits.\n * \n * @param inp Input 368 soft type-4 bits.\n */\nvoid randomize_soft_bits(uint16_t inp[SYM_PER_PLD*2])\n{\n    for(uint16_t i=0; i<SYM_PER_PLD*2; i++)\n    {\n        if((rand_seq[i/8]>>(7-(i%8)))&1) //flip bit if '1'\n        {\n            inp[i]=soft_bit_NOT(inp[i]);\n        }\n    }\n}\n\n//-------------------------------\n// M17 C library - phy/slice.c\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 14 January 2024\n//-------------------------------\n\n/**\n * @brief Slice payload symbols into soft dibits.\n * Input (RRC filtered baseband sampled at symbol centers)\n * should be already normalized to {-3, -1, +1 +3}.\n * @param out Soft valued dibits (type-4).\n * @param inp Array of 184 floats (1 sample per symbol).\n */\nvoid slice_symbols(uint16_t out[2*SYM_PER_PLD], const float inp[SYM_PER_PLD])\n{\n    for(uint8_t i=0; i<SYM_PER_PLD; i++)\n    {\n        //bit 0\n        if(inp[i]>=symbol_list[3])\n        {\n            out[i*2+1]=0xFFFF;\n        }\n        else if(inp[i]>=symbol_list[2])\n        {\n            out[i*2+1]=-(float)0xFFFF/(symbol_list[3]-symbol_list[2])*symbol_list[2]+inp[i]*(float)0xFFFF/(symbol_list[3]-symbol_list[2]);\n        }\n        else if(inp[i]>=symbol_list[1])\n        {\n            out[i*2+1]=0x0000;\n        }\n        else if(inp[i]>=symbol_list[0])\n        {\n            out[i*2+1]=(float)0xFFFF/(symbol_list[1]-symbol_list[0])*symbol_list[1]-inp[i]*(float)0xFFFF/(symbol_list[1]-symbol_list[0]);\n        }\n        else\n        {\n            out[i*2+1]=0xFFFF;\n        }\n\n        //bit 1\n        if(inp[i]>=symbol_list[2])\n        {\n            out[i*2]=0x0000;\n        }\n        else if(inp[i]>=symbol_list[1])\n        {\n            out[i*2]=0x7FFF-inp[i]*(float)0xFFFF/(symbol_list[2]-symbol_list[1]);\n        }\n        else\n        {\n            out[i*2]=0xFFFF;\n        }\n    }\n}\n\n//--------------------------------------------------------------------\n// M17 C library - phy/sync.c\n//\n// Wojciech Kaczmarski, SP5WWP\n// M17 Project, 29 December 2023\n//--------------------------------------------------------------------\n\n//syncwords\nconst uint16_t SYNC_LSF = 0x55F7;\nconst uint16_t SYNC_STR = 0xFF5D;\nconst uint16_t SYNC_PKT = 0x75FF;\nconst uint16_t SYNC_BER = 0xDF55;\nconst uint16_t EOT_MRKR = 0x555D;\n","numLines":180,"startLine":1,"totalLines":180}}}
