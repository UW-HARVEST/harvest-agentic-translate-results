ata);\n        }\n    }\n\n    // common stuff\n    reorder_bits(&mut rf_bits, &enc_bits);\n    randomize_bits(&mut rf_bits);\n    send_data_into(out, &mut sym_cnt, &rf_bits);\n}\n\n// Helpers that write into a SYM_PER_FRA-sized buffer\nfn send_syncword_into(out: &mut [f32; SYM_PER_FRA], cnt: &mut u32, syncword: u16) {\n    let mut i: u8 = 0;\n    while i < (SYM_PER_SWD * 2) as u8 {\n        let idx = ((syncword >> (14 - i)) & 3) as usize;\n        out[*cnt as usize] = SYMBOL_MAP[idx] as f32;\n        *cnt += 1;\n        i += 2;\n    }\n}\n\nfn send_data_into(out: &mut [f32; SYM_PER_FRA], cnt: &mut u32, input: &[u8]) {\n    for i in 0..SYM_PER_PLD {\n        let idx = (input[2 * i] as usize) * 2 + input[2 * i + 1] as usize;\n        out[*cnt as usize] = SYMBOL_MAP[idx] as f32;\n        *cnt += 1;\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":4026,"cache_read_input_tokens":90061,"cache_creation":{"ephemeral_5m_input_tokens":4026,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fb86ecce-c22e-43b3-ac21-4377914c4b84","uuid":"7c639252-5c9f-4452-b319-b66dd19ba004"}
