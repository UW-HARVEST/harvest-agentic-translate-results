{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_011GR5t43pBCAtqYL7NfQuWG","type":"tool_result","content":"1\tuse libm17::encode::SYMBOL_LIST;\n2\tuse libm17::math::{golay24_encode, golay24_sdecode, soft_bit_xor, DECODE_MATRIX, ENCODE_MATRIX};\n3\t\n4\tuse rand::Rng;\n5\tuse std::time::{SystemTime, UNIX_EPOCH};\n6\tuse std::vec;\n7\t#[test]\n8\tfn soft_logic_xor() {\n9\t    assert_eq!(0x0000, soft_bit_xor(0x0000, 0x0000));\n10\t    assert_eq!(0x7FFE, soft_bit_xor(0x0000, 0x7FFF));\n11\t    assert_eq!(0xFFFE, soft_bit_xor(0x0000, 0xFFFF));\n12\t    assert_eq!(0x7FFE, soft_bit_xor(0x7FFF, 0x0000));\n13\t    assert_eq!(0x7FFE, soft_bit_xor(0x7FFF, 0x7FFF));\n14\t    assert_eq!(0x7FFF, soft_bit_xor(0x7FFF, 0xFFFF));\n15\t    assert_eq!(0xFFFE, soft_bit_xor(0xFFFF, 0x0000));\n16\t    assert_eq!(0x7FFF, soft_bit_xor(0xFFFF, 0x7FFF));\n17\t    assert_eq!(0x0000, soft_bit_xor(0xFFFF, 0xFFFF));\n18\t}\n19\t\n20\tfn symbol_to_soft_dibit(symb_in: f32) -> [u16; 2] {\n21\t    let mut dibit = [0u16; 2];\n22\t\n23\t    // First bit\n24\t    if symb_in >= (SYMBOL_LIST[2] as f32) {\n25\t        dibit[0] = 0x0000;\n26\t    } else if symb_in >= (SYMBOL_LIST[1] as f32) {\n27\t        dibit[0] =\n28\t            (0x7FFF as f32 - (symb_in * 0xFFFF as f32) / (SYMBOL_LIST[2] - SYMBOL_LIST[1]) as f32) as u16;\n29\t    } else {\n30\t        dibit[0] = 0xFFFF;\n31\t    }\n32\t\n33\t    // Second bit\n34\t    if symb_in >= SYMBOL_LIST[3] as f32 {\n35\t        dibit[1] = 0xFFFF;\n36\t    } else if symb_in >= SYMBOL_LIST[2] as f32 {\n37\t        let out = (-0xFFFF as f32) / ((SYMBOL_LIST[3] - SYMBOL_LIST[2]) as f32)\n38\t            * (SYMBOL_LIST[2] as f32)\n39\t            + symb_in * (0xFFFF as f32) / ((SYMBOL_LIST[3] - SYMBOL_LIST[2]) as f32);\n40\t        dibit[1] = out as u16;\n41\t    } else if symb_in >= SYMBOL_LIST[1] as f32 {\n42\t        dibit[1] = 0x0000;\n43\t    } else if symb_in >= SYMBOL_LIST[0] as f32 {\n44\t        dibit[1] = (0xFFFF as f32 / (SYMBOL_LIST[1] - SYMBOL_LIST[0]) as f32\n45\t            * SYMBOL_LIST[1] as f32\n46\t            - symb_in * 0xFFFF as f32 / (SYMBOL_LIST[1] - SYMBOL_LIST[0]) as f32)\n47\t            as u16;\n48\t    } else {\n49\t        dibit[1] = 0xFFFF;\n50\t    }\n51\t\n52\t    dibit\n53\t}\n54\t\n55\tfn apply_errors(vect: &mut [u16; 24], start_pos: u8, end_pos: u8, num_errs: u8, sum_errs: f32) {\n56\t    if end_pos < start_pos {\n57\t        panic!(\"Invalid bit range\");\n58\t    }\n59\t\n60\t    let num_bits = end_pos - start_pos + 1;\n61\t    if num_errs > num_bits || num_bits > 24 || num_errs > 24 || sum_errs > num_errs as f32 {\n62\t        panic!(\"Impossible combination of error value and number of bits\");\n63\t    }\n64\t\n65\t    let val = (0xFFFF as f32 * sum_errs / num_errs as f32).round() as u16;\n66\t    let mut err_loc: u32 = 0;\n67\t    let mut rng = rand::thread_rng();\n68\t\n69\t    for _ in 0..num_errs {\n70\t        let mut bit_pos;\n71\t        loop {\n72\t            bit_pos = start_pos + (rng.gen::<u8>() % num_bits);\n73\t            if err_loc & (1 << bit_pos) == 0 {\n74\t                break;\n75\t            }\n76\t        }\n77\t        vect[bit_pos as usize] ^= val;\n78\t        err_loc |= 1 << bit_pos;\n79\t    }\n80\t}\n81\t#[test]\n82\tfn symbol_to_dibit() {\n83\t    let test_values = [30.0, 4.0, 3.0, 2.0, 1.0, 0.0, -1.0, -2.0, -3.0, -4.0, -30.0];\n84\t    let expected_results = [\n85\t        [0x0000, 0xFFFF],\n86\t        [0x0000, 0xFFFF],\n87\t        [0x0000, 0xFFFF],\n88\t        [0x0000, 0x7FFF],\n89\t        [0x0000, 0x0000],\n90\t        [0x7FFF, 0x0000],\n91\t        [0xFFFE, 0x0000],\n92\t        [0xFFFF, 0x7FFF],\n93\t        [0xFFFF, 0xFFFF],\n94\t        [0xFFFF, 0xFFFF],\n95\t        [0xFFFF, 0xFFFF],\n96\t    ];\n97\t\n98\t    for (i, &val) in test_values.iter().enumerate() {\n99\t        let dibit = symbol_to_soft_dibit(val);\n100\t        assert_eq!(dibit[0], expected_results[i][0]);\n101\t        assert_eq!(dibit[1], expected_results[i][1]);\n102\t    }\n103\t}\n104\t#[test]\n105\tfn golay_encode() {\n106\t    let mut data: u16 = 0x0800;\n107\t    for i in (1..ENCODE_MATRIX.len()).rev() {\n108\t        assert_eq!(\n109\t            ((data as u32) << 12) | ENCODE_MATRIX[i] as u32,\n110\t            golay24_encode(data)\n111\t        );\n112\t        data >>= 1;\n113\t    }\n114\t\n115\t    data = 0x0D78;\n116\t    assert_eq!(0x0D7880F, golay24_encode(data));\n117\t}\n118\t#[test]\n119\tfn test_golay_soft_decode() {\n120\t    let test_params = [\n121\t        (\"flipped_parity_1\", 0, 11, 1, 1.0, true),\n122\t        (\"erased_parity_1\", 0, 11, 1, 0.5, true),\n123\t        (\"flipped_parity_2\", 0, 11, 2, 2.0, true),\n124\t        (\"erased_parity_2\", 0, 11, 2, 1.0, true),\n125\t        (\"flipped_parity_3\", 0, 11, 3, 3.0, true),\n126\t        (\"erased_parity_3\", 0, 11, 3, 1.5, true),\n127\t        (\"erased_parity_3_5\", 0, 11, 7, 3.5, false),\n128\t        (\"erased_parity_5\", 0, 11, 5, 2.5, false),\n129\t        (\"flipped_parity_5\", 0, 11, 5, 5.0, false),\n130\t        (\"flipped_data_1\", 12, 23, 1, 1.0, true),\n131\t        (\"erased_data_1\", 12, 23, 1, 0.5, true),\n132\t        (\"flipped_data_2\", 12, 23, 2, 2.0, true),\n133\t        (\"erased_data_2\", 12, 23, 2, 1.0, true),\n134\t        (\"flipped_data_3\", 12, 23, 3, 3.0, true),\n135\t        (\"erased_data_3\", 12, 23, 3, 1.5, true),\n136\t        (\"erased_data_3_5\", 12, 23, 7, 3.5, true),\n137\t        (\"erased_data_5\", 12, 23, 5, 2.5, true),\n138\t        (\"flipped_data_5\", 12, 23, 5, 5.0, false),\n139\t    ];\n140\t\n141\t    for (name, start_pos, end_pos, num_errs, sum_errs, is_equal) in test_params.iter() {\n142\t        let mut vector: [u16; 24] = [0; 24];\n143\t\n144\t        for i in 0..24 {\n145\t            vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n146\t        }\n147\t\n148\t        for _ in 0..1000 {\n149\t            apply_errors(&mut vector, *start_pos, *end_pos, *num_errs, *sum_errs);\n150\t            let result = golay24_sdecode(&vector);\n151\t            if *is_equal {\n152\t                assert_eq!(0x0D78, result, \"Test case: {}\", name);\n153\t            } else {\n154\t                assert_ne!(0x0D78, result, \"Test case: {}\", name);\n155\t            }\n156\t            for i in 0..24 {\n157\t                vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n158\t            }\n159\t        }\n160\t    }\n161\t}\n162\t#[test]\n163\tfn golay_soft_decode_flipped_parity_4() {\n164\t    let mut vector: [u16; 24] = [0; 24];\n165\t    for i in 0..24 {\n166\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n167\t    }\n168\t\n169\t    vector[6] ^= 0xFFFF;\n170\t    vector[7] ^= 0xFFFF;\n171\t    vector[8] ^= 0xFFFF;\n172\t    vector[11] ^= 0xFFFF;\n173\t\n174\t    assert_ne!(0x0D78, golay24_sdecode(&vector));\n175\t    for i in 0..24 {\n176\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n177\t    }\n178\t\n179\t    vector[6] ^= 0xFFFF;\n180\t    vector[7] ^= 0xFFFF;\n181\t    vector[8] ^= 0xFFFF;\n182\t    vector[9] ^= 0xFFFF;\n183\t    assert_eq!(0x0D78, golay24_sdecode(&vector));\n184\t    for i in 0..24 {\n185\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n186\t    }\n187\t}\n188\t\n189\t//4 errors is exactly half the hamming distance, so due to rounding etc., results may vary\n190\t//therefore we run 2 tests here to prove that\n191\t#[test]\n192\tfn golay_soft_decode_flipped_data_4() {\n193\t    let mut vector: [u16; 24] = [0; 24];\n194\t    for i in 0..24 {\n195\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n196\t    }\n197\t\n198\t    vector[12] ^= 0xFFFF;\n199\t    vector[13] ^= 0xFFFF;\n200\t    vector[16] ^= 0xFFFF;\n201\t    vector[22] ^= 0xFFFF;\n202\t    assert_ne!(0x0D78, golay24_sdecode(&vector));\n203\t    for i in 0..24 {\n204\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n205\t    }\n206\t\n207\t    vector[14] ^= 0xFFFF;\n208\t    vector[16] ^= 0xFFFF;\n209\t    vector[17] ^= 0xFFFF;\n210\t    vector[20] ^= 0xFFFF;\n211\t    assert_eq!(0x0D78, golay24_sdecode(&vector));\n212\t    for i in 0..24 {\n213\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n214\t    }\n215\t}\n216\t#[test]\n217\tfn golay_soft_decode_corrupt_data_4_5() {\n218\t    let mut vector: [u16; 24] = [0; 24];\n219\t    for i in 0..24 {\n220\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n221\t    }\n222\t\n223\t    apply_errors(&mut vector, 12, 23, 12, 4.5);\n224\t    assert_eq!(0x0D78, golay24_sdecode(&vector));\n225\t    for i in 0..24 {\n226\t        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n227\t    }\n228\t}\n229\t\n230\tfn main() {}\n231\t"}]},"parent_tool_use_id":null,"session_id":"fb86ecce-c22e-43b3-ac21-4377914c4b84","uuid":"7d143a9c-4caf-42a4-9409-528bbb022bbe","timestamp":"2026-06-06T00:14:00.150Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-luchTz/project/src/bin/unit_tests.rs","content":"use libm17::encode::SYMBOL_LIST;\nuse libm17::math::{golay24_encode, golay24_sdecode, soft_bit_xor, DECODE_MATRIX, ENCODE_MATRIX};\n\nuse rand::Rng;\nuse std::time::{SystemTime, UNIX_EPOCH};\nuse std::vec;\n#[test]\nfn soft_logic_xor() {\n    assert_eq!(0x0000, soft_bit_xor(0x0000, 0x0000));\n    assert_eq!(0x7FFE, soft_bit_xor(0x0000, 0x7FFF));\n    assert_eq!(0xFFFE, soft_bit_xor(0x0000, 0xFFFF));\n    assert_eq!(0x7FFE, soft_bit_xor(0x7FFF, 0x0000));\n    assert_eq!(0x7FFE, soft_bit_xor(0x7FFF, 0x7FFF));\n    assert_eq!(0x7FFF, soft_bit_xor(0x7FFF, 0xFFFF));\n    assert_eq!(0xFFFE, soft_bit_xor(0xFFFF, 0x0000));\n    assert_eq!(0x7FFF, soft_bit_xor(0xFFFF, 0x7FFF));\n    assert_eq!(0x0000, soft_bit_xor(0xFFFF, 0xFFFF));\n}\n\nfn symbol_to_soft_dibit(symb_in: f32) -> [u16; 2] {\n    let mut dibit = [0u16; 2];\n\n    // First bit\n    if symb_in >= (SYMBOL_LIST[2] as f32) {\n        dibit[0] = 0x0000;\n    } else if symb_in >= (SYMBOL_LIST[1] as f32) {\n        dibit[0] =\n            (0x7FFF as f32 - (symb_in * 0xFFFF as f32) / (SYMBOL_LIST[2] - SYMBOL_LIST[1]) as f32) as u16;\n    } else {\n        dibit[0] = 0xFFFF;\n    }\n\n    // Second bit\n    if symb_in >= SYMBOL_LIST[3] as f32 {\n        dibit[1] = 0xFFFF;\n    } else if symb_in >= SYMBOL_LIST[2] as f32 {\n        let out = (-0xFFFF as f32) / ((SYMBOL_LIST[3] - SYMBOL_LIST[2]) as f32)\n            * (SYMBOL_LIST[2] as f32)\n            + symb_in * (0xFFFF as f32) / ((SYMBOL_LIST[3] - SYMBOL_LIST[2]) as f32);\n        dibit[1] = out as u16;\n    } else if symb_in >= SYMBOL_LIST[1] as f32 {\n        dibit[1] = 0x0000;\n    } else if symb_in >= SYMBOL_LIST[0] as f32 {\n        dibit[1] = (0xFFFF as f32 / (SYMBOL_LIST[1] - SYMBOL_LIST[0]) as f32\n            * SYMBOL_LIST[1] as f32\n            - symb_in * 0xFFFF as f32 / (SYMBOL_LIST[1] - SYMBOL_LIST[0]) as f32)\n            as u16;\n    } else {\n        dibit[1] = 0xFFFF;\n    }\n\n    dibit\n}\n\nfn apply_errors(vect: &mut [u16; 24], start_pos: u8, end_pos: u8, num_errs: u8, sum_errs: f32) {\n    if end_pos < start_pos {\n        panic!(\"Invalid bit range\");\n    }\n\n    let num_bits = end_pos - start_pos + 1;\n    if num_errs > num_bits || num_bits > 24 || num_errs > 24 || sum_errs > num_errs as f32 {\n        panic!(\"Impossible combination of error value and number of bits\");\n    }\n\n    let val = (0xFFFF as f32 * sum_errs / num_errs as f32).round() as u16;\n    let mut err_loc: u32 = 0;\n    let mut rng = rand::thread_rng();\n\n    for _ in 0..num_errs {\n        let mut bit_pos;\n        loop {\n            bit_pos = start_pos + (rng.gen::<u8>() % num_bits);\n            if err_loc & (1 << bit_pos) == 0 {\n                break;\n            }\n        }\n        vect[bit_pos as usize] ^= val;\n        err_loc |= 1 << bit_pos;\n    }\n}\n#[test]\nfn symbol_to_dibit() {\n    let test_values = [30.0, 4.0, 3.0, 2.0, 1.0, 0.0, -1.0, -2.0, -3.0, -4.0, -30.0];\n    let expected_results = [\n        [0x0000, 0xFFFF],\n        [0x0000, 0xFFFF],\n        [0x0000, 0xFFFF],\n        [0x0000, 0x7FFF],\n        [0x0000, 0x0000],\n        [0x7FFF, 0x0000],\n        [0xFFFE, 0x0000],\n        [0xFFFF, 0x7FFF],\n        [0xFFFF, 0xFFFF],\n        [0xFFFF, 0xFFFF],\n        [0xFFFF, 0xFFFF],\n    ];\n\n    for (i, &val) in test_values.iter().enumerate() {\n        let dibit = symbol_to_soft_dibit(val);\n        assert_eq!(dibit[0], expected_results[i][0]);\n        assert_eq!(dibit[1], expected_results[i][1]);\n    }\n}\n#[test]\nfn golay_encode() {\n    let mut data: u16 = 0x0800;\n    for i in (1..ENCODE_MATRIX.len()).rev() {\n        assert_eq!(\n            ((data as u32) << 12) | ENCODE_MATRIX[i] as u32,\n            golay24_encode(data)\n        );\n        data >>= 1;\n    }\n\n    data = 0x0D78;\n    assert_eq!(0x0D7880F, golay24_encode(data));\n}\n#[test]\nfn test_golay_soft_decode() {\n    let test_params = [\n        (\"flipped_parity_1\", 0, 11, 1, 1.0, true),\n        (\"erased_parity_1\", 0, 11, 1, 0.5, true),\n        (\"flipped_parity_2\", 0, 11, 2, 2.0, true),\n        (\"erased_parity_2\", 0, 11, 2, 1.0, true),\n        (\"flipped_parity_3\", 0, 11, 3, 3.0, true),\n        (\"erased_parity_3\", 0, 11, 3, 1.5, true),\n        (\"erased_parity_3_5\", 0, 11, 7, 3.5, false),\n        (\"erased_parity_5\", 0, 11, 5, 2.5, false),\n        (\"flipped_parity_5\", 0, 11, 5, 5.0, false),\n        (\"flipped_data_1\", 12, 23, 1, 1.0, true),\n        (\"erased_data_1\", 12, 23, 1, 0.5, true),\n        (\"flipped_data_2\", 12, 23, 2, 2.0, true),\n        (\"erased_data_2\", 12, 23, 2, 1.0, true),\n        (\"flipped_data_3\", 12, 23, 3, 3.0, true),\n        (\"erased_data_3\", 12, 23, 3, 1.5, true),\n        (\"erased_data_3_5\", 12, 23, 7, 3.5, true),\n        (\"erased_data_5\", 12, 23, 5, 2.5, true),\n        (\"flipped_data_5\", 12, 23, 5, 5.0, false),\n    ];\n\n    for (name, start_pos, end_pos, num_errs, sum_errs, is_equal) in test_params.iter() {\n        let mut vector: [u16; 24] = [0; 24];\n\n        for i in 0..24 {\n            vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n        }\n\n        for _ in 0..1000 {\n            apply_errors(&mut vector, *start_pos, *end_pos, *num_errs, *sum_errs);\n            let result = golay24_sdecode(&vector);\n            if *is_equal {\n                assert_eq!(0x0D78, result, \"Test case: {}\", name);\n            } else {\n                assert_ne!(0x0D78, result, \"Test case: {}\", name);\n            }\n            for i in 0..24 {\n                vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n            }\n        }\n    }\n}\n#[test]\nfn golay_soft_decode_flipped_parity_4() {\n    let mut vector: [u16; 24] = [0; 24];\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n\n    vector[6] ^= 0xFFFF;\n    vector[7] ^= 0xFFFF;\n    vector[8] ^= 0xFFFF;\n    vector[11] ^= 0xFFFF;\n\n    assert_ne!(0x0D78, golay24_sdecode(&vector));\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n\n    vector[6] ^= 0xFFFF;\n    vector[7] ^= 0xFFFF;\n    vector[8] ^= 0xFFFF;\n    vector[9] ^= 0xFFFF;\n    assert_eq!(0x0D78, golay24_sdecode(&vector));\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n}\n\n//4 errors is exactly half the hamming distance, so due to rounding etc., results may vary\n//therefore we run 2 tests here to prove that\n#[test]\nfn golay_soft_decode_flipped_data_4() {\n    let mut vector: [u16; 24] = [0; 24];\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n\n    vector[12] ^= 0xFFFF;\n    vector[13] ^= 0xFFFF;\n    vector[16] ^= 0xFFFF;\n    vector[22] ^= 0xFFFF;\n    assert_ne!(0x0D78, golay24_sdecode(&vector));\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n\n    vector[14] ^= 0xFFFF;\n    vector[16] ^= 0xFFFF;\n    vector[17] ^= 0xFFFF;\n    vector[20] ^= 0xFFFF;\n    assert_eq!(0x0D78, golay24_sdecode(&vector));\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n}\n#[test]\nfn golay_soft_decode_corrupt_data_4_5() {\n    let mut vector: [u16; 24] = [0; 24];\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n\n    apply_errors(&mut vector, 12, 23, 12, 4.5);\n    assert_eq!(0x0D78, golay24_sdecode(&vector));\n    for i in 0..24 {\n        vector[23 - i] = (((0x0D7880F >> i) & 1) * 0xFFFF) as u16;\n    }\n}\n\nfn main() {}\n","numLines":231,"startLine":1,"totalLines":231}}}
