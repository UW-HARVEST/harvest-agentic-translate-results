8; 8] = [3, -3, 3, 3, -3, -3, -3, -3];\n// Symbol levels for modulation\npub const SYMBOL_LEVELS: [f32; 4] = [-3.0, -1.0, 1.0, 3.0];\npub const NUM_STATES: usize = 1 << (5 - 1);\nstatic mut PREV_METRICS: [u32; NUM_STATES] = [0; NUM_STATES];\nstatic mut CURR_METRICS: [u32; NUM_STATES] = [0; NUM_STATES];\n#[allow(dead_code)]\nstatic mut PREV_METRICS_DATA: [u32; NUM_STATES] = [0; NUM_STATES];\n#[allow(dead_code)]\nstatic mut CURR_METRICS_DATA: [u32; NUM_STATES] = [0; NUM_STATES];\nstatic mut VITERBI_HISTORY: [u16; 244] = [0; 244];\n\npub fn viterbi_decode(out: &mut [u8], input: &[u16], len: u16) -> u32 {\n    if len > 244 * 2 {\n        eprintln!(\"Input size exceeds max history\");\n    }\n\n    viterbi_reset();\n\n    let mut pos: usize = 0;\n    let mut i: usize = 0;\n    let len_us = len as usize;\n    while i < len_us {\n        let s0 = input[i];\n        let s1 = input[i + 1];\n        viterbi_decode_bit(s0, s1, pos);\n        pos += 1;\n        i += 2;\n    }\n\n    viterbi_chainback(out, pos, len / 2)\n}\npub fn viterbi_decode_punctured(\n    out: &mut [u8],\n    input: &[u16],\n    punct: &[u8],\n    in_len: u16,\n    p_len: u16,\n) -> u32 {\n    if in_len > 244 * 2 {\n        eprintln!(\"Input size exceeds max history\");\n    }\n\n    let mut umsg = [0u16; 244 * 2];\n    let mut p: usize = 0;\n    let mut u: usize = 0;\n    let mut i: usize = 0;\n    let in_len_us = in_len as usize;\n    let p_len_us = p_len as usize;\n\n    while i < in_len_us {\n        if punct[p] != 0 {\n            umsg[u] = input[i];\n            i += 1;\n        } else {\n            umsg[u] = 0x7FFF;\n        }\n        u += 1;\n        p = (p + 1) % p_len_us;\n    }\n\n    let result = viterbi_decode(out, &umsg, u as u16);\n    let extra = (u as u32 - in_len as u32) * 0x7FFF;\n    result - extra\n}\npub fn viterbi_decode_bit(s0: u16, s1: u16, pos: usize) {\n    const COST_TABLE_0: [u16; 8] = [0, 0, 0, 0, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF];\n    const COST_TABLE_1: [u16; 8] = [0, 0xFFFF, 0xFFFF, 0, 0, 0xFFFF, 0xFFFF, 0];\n\n    unsafe {\n        for i in 0..(NUM_STATES / 2) {\n            let metric: u32 =\n                q_abs_diff(COST_TABLE_0[i], s0) as u32 + q_abs_diff(COST_TABLE_1[i], s1) as u32;\n\n            let m0: u32 = PREV_METRICS[i] + metric;\n            let m1: u32 = PREV_METRICS[i + NUM_STATES / 2] + (0x1FFFE - metric);\n\n            let m2: u32 = PREV_METRICS[i] + (0x1FFFE - metric);\n            let m3: u32 = PREV_METRICS[i + NUM_STATES / 2] + metric;\n\n            let i0 = 2 * i;\n            let i1 = i0 + 1;\n\n            if m0 >= m1 {\n                VITERBI_HISTORY[pos] |= 1 << i0;\n                CURR_METRICS[i0] = m1;\n            } else {\n                VITERBI_HISTORY[pos] &= !(1 << i0);\n                CURR_METRICS[i0] = m0;\n            }\n\n            if m2 >= m3 {\n                VITERBI_HISTORY[pos] |= 1 << i1;\n                CURR_METRICS[i1] = m3;\n            } else {\n                VITERBI_HISTORY[pos] &= !(1 << i1);\n                CURR_METRICS[i1] = m2;\n            }\n        }\n\n        // swap currMetrics and prevMetrics\n        let tmp = CURR_METRICS;\n        CURR_METRICS = PREV_METRICS;\n        PREV_METRICS = tmp;\n    }\n}\nfn viterbi_chainback(out: &mut [u8], mut pos: usize, len: u16) -> u32 {\n    let len_us = len as usize;\n    let mut state: u8 = 0;\n    let mut bit_pos: usize = len_us + 4;\n\n    let out_len = if len_us == 0 { 1 } else { (len_us - 1) / 8 + 1 };\n    for v in out.iter_mut().take(out_len) {\n        *v = 0;\n    }\n\n    unsafe {\n        while pos > 0 {\n            bit_pos -= 1;\n            pos -= 1;\n            let bit = VITERBI_HISTORY[pos] & (1u16 << (state >> 4));\n            state >>= 1;\n            if bit != 0 {\n                state |= 0x80;\n                out[bit_pos / 8] |= 1 << (7 - (bit_pos % 8));\n            }\n        }\n\n        let mut cost = PREV_METRICS[0];\n        for i in 0..NUM_STATES {\n            let m = PREV_METRICS[i];\n            if m < cost {\n                cost = m;\n            }\n        }\n        cost\n    }\n}\nfn viterbi_reset() {\n    unsafe {\n        for v in VITERBI_HISTORY.iter_mut() {\n            *v = 0;\n        }\n        for v in CURR_METRICS.iter_mut() {\n            *v = 0;\n        }\n        for v in PREV_METRICS.iter_mut() {\n            *v = 0;\n        }\n        for v in CURR_METRICS_DATA.iter_mut() {\n            *v = 0;\n        }\n        for v in PREV_METRICS_DATA.iter_mut() {\n            *v = 0;\n        }\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3561,"cache_read_input_tokens":86500,"cache_creation":{"ephemeral_5m_input_tokens":3561,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fb86ecce-c22e-43b3-ac21-4377914c4b84","uuid":"b01c0044-fddb-4690-a20d-09841b1bccca"}
