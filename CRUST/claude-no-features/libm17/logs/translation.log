r\n484\t\n485\t    //clean D78|80F to soft-logic data\n486\t    for(uint8_t i=0; i<24; i++)\n487\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n488\t\n489\t    for(uint16_t j=0; j<1000; j++)\n490\t    {\n491\t        apply_errors(vector, 12, 23, 7, 3.5);\n492\t        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n493\t        for(uint8_t i=0; i<24; i++)\n494\t            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n495\t    }\n496\t}\n497\t\n498\t//4 errors is exactly half the hamming distance, so due to rounding etc., results may vary\n499\t//therefore we run 2 tests here to prove that\n500\tvoid golay_soft_decode_flipped_data_4(void)\n501\t{\n502\t    uint16_t vector[24]; //soft-logic 24-bit vector\n503\t\n504\t    //clean D78|80F to soft-logic data\n505\t    for(uint8_t i=0; i<24; i++)\n506\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n507\t\n508\t    vector[12]^=0xFFFF;\n509\t    vector[13]^=0xFFFF;\n510\t    vector[16]^=0xFFFF;\n511\t    vector[22]^=0xFFFF;\n512\t    TEST_ASSERT_NOT_EQUAL(0x0D78, golay24_sdecode(vector));\n513\t    for(uint8_t i=0; i<24; i++)\n514\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n515\t\n516\t    vector[14]^=0xFFFF;\n517\t    vector[16]^=0xFFFF;\n518\t    vector[17]^=0xFFFF;\n519\t    vector[20]^=0xFFFF;\n520\t    TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n521\t    for(uint8_t i=0; i<24; i++)\n522\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF; \n523\t}\n524\t\n525\tvoid golay_soft_decode_corrupt_data_4_5(void)\n526\t{\n527\t    uint16_t vector[24]; //soft-logic 24-bit vector\n528\t\n529\t    //clean D78|80F to soft-logic data\n530\t    for(uint8_t i=0; i<24; i++)\n531\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n532\t\n533\t    //4.5 errors - should be uncorrectable - WTF?\n534\t    apply_errors(vector, 12, 23, 12, 4.5);\n535\t    TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n536\t    for(uint8_t i=0; i<24; i++)\n537\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;  \n538\t}\n539\t\n540\tvoid golay_soft_decode_erased_data_5(void)\n541\t{\n542\t    uint16_t vector[24]; //soft-logic 24-bit vector\n543\t\n544\t    //clean D78|80F to soft-logic data\n545\t    for(uint8_t i=0; i<24; i++)\n546\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n547\t\n548\t    for(uint16_t j=0; j<1000; j++)\n549\t    {\n550\t        apply_errors(vector, 12, 23, 5, 2.5);\n551\t        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n552\t        for(uint8_t i=0; i<24; i++)\n553\t            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n554\t    }\n555\t}\n556\t\n557\tvoid golay_soft_decode_flipped_data_5(void)\n558\t{\n559\t    uint16_t vector[24]; //soft-logic 24-bit vector\n560\t\n561\t    //clean D78|80F to soft-logic data\n562\t    for(uint8_t i=0; i<24; i++)\n563\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n564\t\n565\t    for(uint16_t j=0; j<1000; j++)\n566\t    {\n567\t        apply_errors(vector, 12, 23, 5, 5.0);\n568\t        TEST_ASSERT_NOT_EQUAL(0x0D78, golay24_sdecode(vector));\n569\t        for(uint8_t i=0; i<24; i++)\n570\t            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n571\t    }\n572\t}\n573\t\n574\tint main(void)\n575\t{\n576\t    srand(time(NULL));\n577\t\n578\t\tUNITY_BEGIN();\n579\t\n580\t    //soft logic arithmetic\n581\t    RUN_TEST(soft_logic_xor);\n582\t\n583\t    //symbol to dibit\n584\t    RUN_TEST(symbol_to_dibit);\n585\t\n586\t    //soft Golay\n587\t    RUN_TEST(golay_encode);\n588\t    RUN_TEST(golay_soft_decode_clean);\n589\t\n590\t    RUN_TEST(golay_soft_decode_erased_parity_1);\n591\t    RUN_TEST(golay_soft_decode_flipped_parity_1);\n592\t    RUN_TEST(golay_soft_decode_erased_parity_2);\n593\t    RUN_TEST(golay_soft_decode_flipped_parity_2);\n594\t    RUN_TEST(golay_soft_decode_erased_parity_3);\n595\t    RUN_TEST(golay_soft_decode_flipped_parity_3);\n596\t    RUN_TEST(golay_soft_decode_erased_parity_3_5);\n597\t    RUN_TEST(golay_soft_decode_flipped_parity_4);\n598\t    RUN_TEST(golay_soft_decode_erased_parity_5);\n599\t    RUN_TEST(golay_soft_decode_flipped_parity_5);\n600\t\n601\t    RUN_TEST(golay_soft_decode_erased_data_1);\n602\t    RUN_TEST(golay_soft_decode_flipped_data_1);\n603\t    RUN_TEST(golay_soft_decode_erased_data_2);\n604\t    RUN_TEST(golay_soft_decode_flipped_data_2);\n605\t    RUN_TEST(golay_soft_decode_erased_data_3);\n606\t    RUN_TEST(golay_soft_decode_flipped_data_3);\n607\t    RUN_TEST(golay_soft_decode_erased_data_3_5);\n608\t    RUN_TEST(golay_soft_decode_flipped_data_4);\n609\t    RUN_TEST(golay_soft_decode_corrupt_data_4_5);\n610\t    RUN_TEST(golay_soft_decode_erased_data_5);\n611\t    RUN_TEST(golay_soft_decode_flipped_data_5);\n612\t\n613\t    return UNITY_END();\n614\t}\n615\t"}]},"parent_tool_use_id":null,"session_id":"fb86ecce-c22e-43b3-ac21-4377914c4b84","uuid":"e7c25f27-96c4-4146-85a5-802881fe9875","timestamp":"2026-06-06T00:14:03.441Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-luchTz/project/c_src/unit_tests/unit_tests.c","content":"#include <stdio.h>\n#include <string.h>\n#include <inttypes.h>\n#include <stdlib.h>\n#include <math.h>\n#include <time.h>\n#include \"unit_tests/unity/src/unity.h\"\n#include <m17.h>\n\n//this is run before every test\nvoid setUp(void)\n{\n\treturn;\n} \n\n//this is run after every test\nvoid tearDown(void)\n{\n\treturn;\n}\n\nvoid soft_logic_xor(void)\n{\n    TEST_ASSERT_EQUAL(0x0000, soft_bit_XOR(0x0000, 0x0000));\n    TEST_ASSERT_EQUAL(0x7FFE, soft_bit_XOR(0x0000, 0x7FFF)); //off by 1 is acceptable\n    TEST_ASSERT_EQUAL(0xFFFE, soft_bit_XOR(0x0000, 0xFFFF)); //off by 1 is acceptable\n\n    TEST_ASSERT_EQUAL(0x7FFE, soft_bit_XOR(0x7FFF, 0x0000)); //off by 1 is acceptable\n    TEST_ASSERT_EQUAL(0x7FFE, soft_bit_XOR(0x7FFF, 0x7FFF));\n    TEST_ASSERT_EQUAL(0x7FFF, soft_bit_XOR(0x7FFF, 0xFFFF));\n\n    TEST_ASSERT_EQUAL(0xFFFE, soft_bit_XOR(0xFFFF, 0x0000)); //off by 1 is acceptable\n    TEST_ASSERT_EQUAL(0x7FFF, soft_bit_XOR(0xFFFF, 0x7FFF));\n    TEST_ASSERT_EQUAL(0x0000, soft_bit_XOR(0xFFFF, 0xFFFF));\n}\n\nvoid symbol_to_soft_dibit(uint16_t dibit[2], float symb_in)\n{\n    //bit 0\n    if(symb_in>=symbol_list[3])\n    {\n        dibit[1]=0xFFFF;\n    }\n    else if(symb_in>=symbol_list[2])\n    {\n        dibit[1]=-(float)0xFFFF/(symbol_list[3]-symbol_list[2])*symbol_list[2]+symb_in*(float)0xFFFF/(symbol_list[3]-symbol_list[2]);\n    }\n    else if(symb_in>=symbol_list[1])\n    {\n        dibit[1]=0x0000;\n    }\n    else if(symb_in>=symbol_list[0])\n    {\n        dibit[1]=(float)0xFFFF/(symbol_list[1]-symbol_list[0])*symbol_list[1]-symb_in*(float)0xFFFF/(symbol_list[1]-symbol_list[0]);\n    }\n    else\n    {\n        dibit[1]=0xFFFF;\n    }\n\n    //bit 1\n    if(symb_in>=symbol_list[2])\n    {\n        dibit[0]=0x0000;\n    }\n    else if(symb_in>=symbol_list[1])\n    {\n        dibit[0]=0x7FFF-symb_in*(float)0xFFFF/(symbol_list[2]-symbol_list[1]);\n    }\n    else\n    {\n        dibit[0]=0xFFFF;\n    }\n}\n\nvoid symbol_to_dibit(void)\n{\n    uint16_t dibit[2];\n\n    symbol_to_soft_dibit(dibit, +30.0);\n    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]); //this is the LSB...\n\n    symbol_to_soft_dibit(dibit, +4.0);\n    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, +3.0);\n    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, +2.0);\n    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n    TEST_ASSERT_EQUAL(0x7FFF, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, +1.0);\n    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n    TEST_ASSERT_EQUAL(0x0000, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, 0.0);\n    TEST_ASSERT_EQUAL(0x7FFF, dibit[0]);\n    TEST_ASSERT_EQUAL(0x0000, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, -1.0);\n    TEST_ASSERT_EQUAL(0xFFFE, dibit[0]); //off by one is acceptable\n    TEST_ASSERT_EQUAL(0x0000, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, -2.0);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n    TEST_ASSERT_EQUAL(0x7FFF, dibit[1]);\n    \n    symbol_to_soft_dibit(dibit, -3.0);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, -4.0);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n\n    symbol_to_soft_dibit(dibit, -30.0);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n}\n\n/**\n * @brief Apply errors to a soft-valued 24-bit logic vector.\n * Errors are spread out evenly among num_errs bits.\n * @param vect Input vector.\n * @param start_pos \n * @param end_pos \n * @param num_errs Number of bits to apply errors to.\n * @param sum_errs Sum of all errors (total).\n */\nvoid apply_errors(uint16_t vect[24], uint8_t start_pos, uint8_t end_pos, uint8_t num_errs, float sum_errs)\n{\n    if(end_pos<start_pos)\n    {\n        printf(\"ERROR: Invalid bit range.\\nExiting.\\n\");\n        exit(1);\n    }\n\n    uint8_t bit_pos;\n    uint8_t num_bits=end_pos-start_pos+1;\n\n    if(num_errs>num_bits || num_bits>24 || num_errs>24 || sum_errs>num_errs) //too many errors or too wide range\n    {\n        printf(\"ERROR: Impossible combination of error value and number of bits.\\nExiting.\\n\");\n        exit(1);\n    }\n\n    uint16_t val=roundf((float)0xFFFF*sum_errs/num_errs);\n    uint32_t err_loc=0;\n\n    for(uint8_t i=0; i<num_errs; i++)\n    {\n        //assure we didnt select the same bit more than once\n        do\n        {\n            bit_pos=start_pos+(rand()%num_bits);\n        }\n        while(err_loc&(1<<bit_pos));\n        \n        vect[bit_pos]^=val; //apply error\n        err_loc|=(1<<bit_pos);\n    }\n}\n\nvoid golay_encode(void)\n{\n    uint16_t data=0x0800;\n\n    //single-bit data\n    for(uint8_t i=sizeof(encode_matrix)/sizeof(uint16_t)-1; i>0; i--)\n    {\n        TEST_ASSERT_EQUAL(((uint32_t)data<<12)|encode_matrix[i], golay24_encode(data));\n        data>>=1;\n    }\n\n    //test data vector\n    data=0x0D78;\n    TEST_ASSERT_EQUAL(0x0D7880FU, golay24_encode(data));\n}\n\n/**\n * @brief Golay soft-decode one known codeword.\n * \n */\nvoid golay_soft_decode_clean(void)\n{\n    uint16_t vector[24];\n\n    //clean D78|80F\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n}\n\nvoid golay_soft_decode_flipped_parity_1(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n    //clean D78|80F to soft-logic data\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    for(uint16_t j=0; j<1000; j++)\n    {\n        apply_errors(vector, 0, 11, 1, 1.0);\n        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n        for(uint8_t i=0; i<24; i++)\n            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n    }\n}\n\nvoid golay_soft_decode_erased_parity_1(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n    //clean D78|80F to soft-logic data\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    for(uint16_t j=0; j<1000; j++)\n    {\n        apply_errors(vector, 0, 11, 1, 0.5);\n        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n        for(uint8_t i=0; i<24; i++)\n            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n    }\n}\n\nvoid golay_soft_decode_flipped_parity_2(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n    //clean D78|80F to soft-logic data\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    for(uint16_t j=0; j<1000; j++)\n    {\n        apply_errors(vector, 0, 11, 2, 2.0);\n        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n        for(uint8_t i=0; i<24; i++)\n            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n    }\n}\n\nvoid golay_soft_decode_erased_parity_2(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n    //clean D78|80F to soft-logic data\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    for(uint16_t j=0; j<1000; j++)\n    {\n        apply_errors(vector, 0, 11, 2, 1.0);\n        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n        for(uint8_t i=0; i<24; i++)\n            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n    }\n}\n\nvoid golay_soft_decode_flipped_parity_3(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n    //clean D78|80F to soft-logic data\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    for(uint16_t j=0; j<1000; j++)\n    {\n        apply_errors(vector, 0, 11, 3, 3.0);\n        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n        for(uint8_t i=0; i<24; i++)\n            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n    }\n}\n\nvoid golay_soft_decode_erased_parity_3(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n    //clean D78|80F to soft-logic data\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    for(uint16_t j=0; j<1000; j++)\n    {\n        apply_errors(vector, 0, 11, 3, 1.5);\n        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n        for(uint8_t i=0; i<24; i++)\n            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n    }\n}\n\nvoid golay_soft_decode_erased_parity_3_5(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n    //clean D78|80F to soft-logic data\n    for(uint8_t i=0; i<24; i++)\n        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n\n    for(uint16_t j=0; j<1000; j++)\n    {\n        apply_errors(vector, 0, 11, 7, 3.5);\n        TEST_ASSERT_NOT_EQUAL(0x0D78, golay24_sdecode(vector));\n        for(uint8_t i=0; i<24; i++)\n            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n    }\n}\n\n//4 errors is exactly half the hamming distance, so due to rounding etc., results may vary\n//therefore we run 2 tests here to prove that\nvoid golay_soft_decode_flipped_parity_4(void)\n{\n    uint16_t vector[24]; //soft-logic 24-bit vector\n\n 