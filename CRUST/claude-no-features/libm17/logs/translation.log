8\t        dibit[1]=0xFFFF;\n59\t    }\n60\t\n61\t    //bit 1\n62\t    if(symb_in>=symbol_list[2])\n63\t    {\n64\t        dibit[0]=0x0000;\n65\t    }\n66\t    else if(symb_in>=symbol_list[1])\n67\t    {\n68\t        dibit[0]=0x7FFF-symb_in*(float)0xFFFF/(symbol_list[2]-symbol_list[1]);\n69\t    }\n70\t    else\n71\t    {\n72\t        dibit[0]=0xFFFF;\n73\t    }\n74\t}\n75\t\n76\tvoid symbol_to_dibit(void)\n77\t{\n78\t    uint16_t dibit[2];\n79\t\n80\t    symbol_to_soft_dibit(dibit, +30.0);\n81\t    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n82\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]); //this is the LSB...\n83\t\n84\t    symbol_to_soft_dibit(dibit, +4.0);\n85\t    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n86\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n87\t\n88\t    symbol_to_soft_dibit(dibit, +3.0);\n89\t    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n90\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n91\t\n92\t    symbol_to_soft_dibit(dibit, +2.0);\n93\t    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n94\t    TEST_ASSERT_EQUAL(0x7FFF, dibit[1]);\n95\t\n96\t    symbol_to_soft_dibit(dibit, +1.0);\n97\t    TEST_ASSERT_EQUAL(0x0000, dibit[0]);\n98\t    TEST_ASSERT_EQUAL(0x0000, dibit[1]);\n99\t\n100\t    symbol_to_soft_dibit(dibit, 0.0);\n101\t    TEST_ASSERT_EQUAL(0x7FFF, dibit[0]);\n102\t    TEST_ASSERT_EQUAL(0x0000, dibit[1]);\n103\t\n104\t    symbol_to_soft_dibit(dibit, -1.0);\n105\t    TEST_ASSERT_EQUAL(0xFFFE, dibit[0]); //off by one is acceptable\n106\t    TEST_ASSERT_EQUAL(0x0000, dibit[1]);\n107\t\n108\t    symbol_to_soft_dibit(dibit, -2.0);\n109\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n110\t    TEST_ASSERT_EQUAL(0x7FFF, dibit[1]);\n111\t    \n112\t    symbol_to_soft_dibit(dibit, -3.0);\n113\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n114\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n115\t\n116\t    symbol_to_soft_dibit(dibit, -4.0);\n117\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n118\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n119\t\n120\t    symbol_to_soft_dibit(dibit, -30.0);\n121\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[0]);\n122\t    TEST_ASSERT_EQUAL(0xFFFF, dibit[1]);\n123\t}\n124\t\n125\t/**\n126\t * @brief Apply errors to a soft-valued 24-bit logic vector.\n127\t * Errors are spread out evenly among num_errs bits.\n128\t * @param vect Input vector.\n129\t * @param start_pos \n130\t * @param end_pos \n131\t * @param num_errs Number of bits to apply errors to.\n132\t * @param sum_errs Sum of all errors (total).\n133\t */\n134\tvoid apply_errors(uint16_t vect[24], uint8_t start_pos, uint8_t end_pos, uint8_t num_errs, float sum_errs)\n135\t{\n136\t    if(end_pos<start_pos)\n137\t    {\n138\t        printf(\"ERROR: Invalid bit range.\\nExiting.\\n\");\n139\t        exit(1);\n140\t    }\n141\t\n142\t    uint8_t bit_pos;\n143\t    uint8_t num_bits=end_pos-start_pos+1;\n144\t\n145\t    if(num_errs>num_bits || num_bits>24 || num_errs>24 || sum_errs>num_errs) //too many errors or too wide range\n146\t    {\n147\t        printf(\"ERROR: Impossible combination of error value and number of bits.\\nExiting.\\n\");\n148\t        exit(1);\n149\t    }\n150\t\n151\t    uint16_t val=roundf((float)0xFFFF*sum_errs/num_errs);\n152\t    uint32_t err_loc=0;\n153\t\n154\t    for(uint8_t i=0; i<num_errs; i++)\n155\t    {\n156\t        //assure we didnt select the same bit more than once\n157\t        do\n158\t        {\n159\t            bit_pos=start_pos+(rand()%num_bits);\n160\t        }\n161\t        while(err_loc&(1<<bit_pos));\n162\t        \n163\t        vect[bit_pos]^=val; //apply error\n164\t        err_loc|=(1<<bit_pos);\n165\t    }\n166\t}\n167\t\n168\tvoid golay_encode(void)\n169\t{\n170\t    uint16_t data=0x0800;\n171\t\n172\t    //single-bit data\n173\t    for(uint8_t i=sizeof(encode_matrix)/sizeof(uint16_t)-1; i>0; i--)\n174\t    {\n175\t        TEST_ASSERT_EQUAL(((uint32_t)data<<12)|encode_matrix[i], golay24_encode(data));\n176\t        data>>=1;\n177\t    }\n178\t\n179\t    //test data vector\n180\t    data=0x0D78;\n181\t    TEST_ASSERT_EQUAL(0x0D7880FU, golay24_encode(data));\n182\t}\n183\t\n184\t/**\n185\t * @brief Golay soft-decode one known codeword.\n186\t * \n187\t */\n188\tvoid golay_soft_decode_clean(void)\n189\t{\n190\t    uint16_t vector[24];\n191\t\n192\t    //clean D78|80F\n193\t    for(uint8_t i=0; i<24; i++)\n194\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n195\t\n196\t    TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n197\t}\n198\t\n199\tvoid golay_soft_decode_flipped_parity_1(void)\n200\t{\n201\t    uint16_t vector[24]; //soft-logic 24-bit vector\n202\t\n203\t    //clean D78|80F to soft-logic data\n204\t    for(uint8_t i=0; i<24; i++)\n205\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n206\t\n207\t    for(uint16_t j=0; j<1000; j++)\n208\t    {\n209\t        apply_errors(vector, 0, 11, 1, 1.0);\n210\t        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n211\t        for(uint8_t i=0; i<24; i++)\n212\t            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n213\t    }\n214\t}\n215\t\n216\tvoid golay_soft_decode_erased_parity_1(void)\n217\t{\n218\t    uint16_t vector[24]; //soft-logic 24-bit vector\n219\t\n220\t    //clean D78|80F to soft-logic data\n221\t    for(uint8_t i=0; i<24; i++)\n222\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n223\t\n224\t    for(uint16_t j=0; j<1000; j++)\n225\t    {\n226\t        apply_errors(vector, 0, 11, 1, 0.5);\n227\t        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n228\t        for(uint8_t i=0; i<24; i++)\n229\t            vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n230\t    }\n231\t}\n232\t\n233\tvoid golay_soft_decode_flipped_parity_2(void)\n234\t{\n235\t    uint16_t vector[24]; //soft-logic 24-bit vector\n236\t\n237\t    //clean D78|80F to soft-logic data\n238\t    for(uint8_t i=0; i<24; i++)\n239\t        vector[23-i]=((0x0D7880F>>i)&1)*0xFFFF;\n240\t\n241\t    for(uint16_t j=0; j<1000; j++)\n242\t    {\n243\t        apply_errors(vector, 0, 11, 2, 2.0);\n244\t        TEST_ASSERT_EQUAL(0x0D78, golay24_sdecode(vector));\n245\t        for(uin