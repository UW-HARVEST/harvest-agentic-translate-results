lly via a single `main()`)."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":500,"cache_read_input_tokens":36265,"cache_creation":{"ephemeral_5m_input_tokens":500,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bf5f1e00-52fb-458d-bf6a-1c7006a658f9","uuid":"8c3bf4b4-9226-4f43-903a-60730530b01f"}
