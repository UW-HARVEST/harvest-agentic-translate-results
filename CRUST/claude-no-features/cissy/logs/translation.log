v = push_start_end(rv, start, end);\n            } else {\n                start = numbuf.parse::<u32>().unwrap_or(0);\n                rv = push_single(rv, start);\n            }\n            numbuf.clear();\n            start = 0;\n            state = 0;\n        }\n    }\n    if numbuf.is_empty() {\n        if state & flag_dash != 0 {\n            rv = push_greater_equal(rv, start);\n        }\n    } else if start > 0 {\n        end = numbuf.parse::<u32>().unwrap_or(0);\n        if end == 0 || start > end {\n            eprintln!(\"error: illegal start/end range {}\", text);\n            std::process::exit(-1i32 as i32);\n        }\n        rv = push_start_end(rv, start, end);\n    } else {\n        start = numbuf.parse::<u32>().unwrap_or(0);\n        rv = push_single(rv, start);\n    }\n    rv\n}\n}\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":970,"cache_read_input_tokens":55435,"cache_creation":{"ephemeral_5m_input_tokens":970,"ephemeral_1h_input_tokens":0},"output_tokens":46,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fdfc5a1a-a21f-466d-af6d-28de71926a72","uuid":"799bd17e-b489-4044-839d-c254228983ff"}
