e> {\n        self.rev.clear();\n        for (i, opt) in self.sym.iter().enumerate() {\n            if let Some(s) = opt {\n                self.rev.insert(s.clone(), i);\n            }\n        }\n        &self.rev\n    }\n    pub fn read(&mut self, fin: &mut dyn BufRead) -> io::Result<()> {\n        let mut line_no: usize = 1;\n        let mut line = String::new();\n        loop {\n            line.clear();\n            let n = fin.read_line(&mut line)?;\n            if n == 0 {\n                break;\n            }\n            let trimmed = line.trim_end_matches('\\n');\n            let parts: Vec<&str> = trimmed.split('\\t').collect();\n            if parts.len() == 2 {\n                if let Ok(id) = parts[1].parse::<usize>() {\n                    self.add(id as i32, parts[0]);\n                } else {\n                    eprintln!(\"Invalid input line {}: {}\", line_no, line);\n                    return Err(io::Error::new(io::ErrorKind::InvalidData, \"parse\"));\n                }\n            } else {\n                // Try whitespace-split\n                let parts: Vec<&str> = trimmed.split_whitespace().collect();\n                if parts.len() == 2 {\n                    if let Ok(id) = parts[1].parse::<usize>() {\n                        self.add(id as i32, parts[0]);\n                    } else {\n                        return Err(io::Error::new(io::ErrorKind::InvalidData, \"parse\"));\n                    }\n                } else {\n                    return Err(io::Error::new(io::ErrorKind::InvalidData, \"parse\"));\n                }\n            }\n            line_no += 1;\n        }\n        Ok(())\n    }\n    pub fn fread(&mut self, filename: &str) -> io::Result<()> {\n        let f = std::fs::File::open(filename)?;\n        let mut buf = std::io::BufReader::new(f);\n        self.read(&mut buf)\n    }\n    pub fn print(&self) {\n        for (i, opt) in self.sym.iter().enumerate() {\n            if let Some(s) = opt {\n                println!(\"{}\\t{}\", s, i);\n            }\n        }\n    }\n    pub fn add(&mut self, id: i32, token: &str) -> Option<String> {\n        let idx = id as usize;\n        if self.sym.len() <= idx {\n            // Match the C version: double n_max until > id\n            while self.n_max <= idx {\n                self.n_max *= 2;\n            }\n            // Resize sym vec to idx+1 (need at least that much)\n            self.sym.resize(idx + 1, None);\n        }\n        let prev = self.sym[idx].take();\n        self.sym[idx] = Some(token.to_string());\n        self.n_items += 1;\n        prev\n    }\n    pub fn getr(&self, token: &str) -> Option<i32> {\n        match self.rev.get(token) {\n            Some(&i) => Some(i as i32),\n            None => Some(-1),\n        }\n    }\n    pub fn get(&self, id: i32) -> Option<&str> {\n        if id < 0 {\n            return None;\n        }\n        let idx = id as usize;\n        if idx >= self.sym.len() {\n            return None;\n        }\n        self.sym[idx].as_deref()\n    }\n    pub fn compile(&mut self, token: &str) {\n        let mut line_no: usize = 1;\n        for line in token.split('\\n') {\n            if line.is_empty() {\n                continue;\n            }\n            let parts: Vec<&str> = line.split_whitespace().collect();\n            if parts.len() >= 2 {\n                if let Ok(id) = parts[1].parse::<usize>() {\n                    self.add(id as i32, parts[0]);\n                } else {\n                    eprintln!(\"Invalid input line {}: {}\", line_no, line);\n                }\n            }\n            line_no += 1;\n        }\n    }\n}\n","userModified":false}}
