{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MiiAcryZD5mWNqDaR5Qtb4","type":"tool_result","content":"1\tuse fslib::fst::{ArcData, Fst, StateData};\n2\tpub fn assert_arc_equal(arc_a: &ArcData, arc_b: &ArcData) {\n3\t    assert_eq!(arc_a.state, arc_b.state);\n4\t    assert_eq!(arc_a.ilabel, arc_b.ilabel);\n5\t    assert_eq!(arc_a.olabel, arc_b.olabel);\n6\t    assert_eq!(arc_a.weight, arc_b.weight);\n7\t}\n8\tpub fn assert_state_equal(state_a: &StateData, state_b: &StateData) {\n9\t    assert_eq!(state_a.weight, state_b.weight);\n10\t    assert_eq!(state_a.final_state, state_b.final_state);\n11\t}\n12\tpub fn assert_fst_equal(a: &Fst, b: &Fst) {\n13\t    assert_eq!(a.start, b.start);\n14\t    assert_eq!(a.sr_type, b.sr_type);\n15\t    assert_eq!(a.n_states, b.n_states);\n16\t    for st in 0..a.states.len().min(b.states.len()) {\n17\t        let state_a = &a.states[st];\n18\t        let state_b = &b.states[st];\n19\t        assert_eq!(state_a.arcs.len(), state_b.arcs.len());\n20\t        assert_state_equal(state_a, state_b);\n21\t        for arc in 0..state_a.arcs.len().min(state_b.arcs.len()) {\n22\t            assert_arc_equal(&state_a.arcs[arc], &state_b.arcs[arc]);\n23\t        }\n24\t    }\n25\t}\n26\t#[test]\n27\tfn test_union(){\n28\t    let mut a = Fst::new();\n29\t    let mut b = Fst::new();\n30\t    let mut c = Fst::new();\n31\t    let str_a: &str = \"0 1 1 1\\n1\";\n32\t    let str_b: &str = \"0 1 2 2\\n1\";\n33\t    let str_c: &str = \"0 1 1 1\\n0 2 3 2 2\\n0 2 0 0\\n1\\n3\";\n34\t    a.compile_str(str_a);\n35\t    b.compile_str(str_b);\n36\t    c.compile_str(str_c);\n37\t    a.union(&b);\n38\t    assert_fst_equal(&a, &c);\n39\t    a.remove();\n40\t    b.remove();\n41\t    c.remove();\n42\t}\n43\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"8188bdfd-835a-4a95-a37e-f838ee03521d","uuid":"dce9d78a-e75c-4935-b2ca-053417f64eac","timestamp":"2026-06-05T23:03:25.571Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-3y7aCD/project/src/bin/test_union.rs","content":"use fslib::fst::{ArcData, Fst, StateData};\npub fn assert_arc_equal(arc_a: &ArcData, arc_b: &ArcData) {\n    assert_eq!(arc_a.state, arc_b.state);\n    assert_eq!(arc_a.ilabel, arc_b.ilabel);\n    assert_eq!(arc_a.olabel, arc_b.olabel);\n    assert_eq!(arc_a.weight, arc_b.weight);\n}\npub fn assert_state_equal(state_a: &StateData, state_b: &StateData) {\n    assert_eq!(state_a.weight, state_b.weight);\n    assert_eq!(state_a.final_state, state_b.final_state);\n}\npub fn assert_fst_equal(a: &Fst, b: &Fst) {\n    assert_eq!(a.start, b.start);\n    assert_eq!(a.sr_type, b.sr_type);\n    assert_eq!(a.n_states, b.n_states);\n    for st in 0..a.states.len().min(b.states.len()) {\n        let state_a = &a.states[st];\n        let state_b = &b.states[st];\n        assert_eq!(state_a.arcs.len(), state_b.arcs.len());\n        assert_state_equal(state_a, state_b);\n        for arc in 0..state_a.arcs.len().min(state_b.arcs.len()) {\n            assert_arc_equal(&state_a.arcs[arc], &state_b.arcs[arc]);\n        }\n    }\n}\n#[test]\nfn test_union(){\n    let mut a = Fst::new();\n    let mut b = Fst::new();\n    let mut c = Fst::new();\n    let str_a: &str = \"0 1 1 1\\n1\";\n    let str_b: &str = \"0 1 2 2\\n1\";\n    let str_c: &str = \"0 1 1 1\\n0 2 3 2 2\\n0 2 0 0\\n1\\n3\";\n    a.compile_str(str_a);\n    b.compile_str(str_b);\n    c.compile_str(str_c);\n    a.union(&b);\n    assert_fst_equal(&a, &c);\n    a.remove();\n    b.remove();\n    c.remove();\n}\nfn main(){}","numLines":43,"startLine":1,"totalLines":43}}}
