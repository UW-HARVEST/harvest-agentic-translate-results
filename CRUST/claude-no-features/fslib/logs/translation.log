{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_jmmwzfinmanifydrbsufsudtq6yftbxzwpnu2667nqvhdia4ezea","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01STdqmers1UTt3D7xBiaUAF","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-3y7aCD/project/src/print.rs","content":"use crate::fst::Fst;\nuse crate::symt::SymTable;\nuse std::io::{self, Write};\n\npub fn fst_print(fst: &Fst, output: &mut dyn Write) -> io::Result<()> {\n    let mut finals: Vec<u32> = Vec::new();\n    for s in 0..fst.n_states {\n        let state = &fst.states[s as usize];\n        for arc in &state.arcs {\n            writeln!(\n                output,\n                \"{}\\t{}\\t{}\\t{}\\t{:.5}\",\n                s, arc.state, arc.ilabel, arc.olabel, arc.weight\n            )?;\n        }\n        if state.final_state {\n            finals.push(s);\n        }\n    }\n    for s in finals {\n        let state = &fst.states[s as usize];\n        writeln!(output, \"{}\\t{}\", s, state.weight)?;\n    }\n    Ok(())\n}\n\npub fn fst_print_sym(\n    fst: &Fst,\n    ist: Option<&SymTable>,\n    ost: Option<&SymTable>,\n    sst: Option<&SymTable>,\n    output: &mut dyn Write,\n) -> io::Result<()> {\n    let mut finals: Vec<u32> = Vec::new();\n\n    let strans = |id: u32| -> String {\n        match sst {\n            Some(t) => t.get(id as i32).map(|s| s.to_string()).unwrap_or_else(|| id.to_string()),\n            None => id.to_string(),\n        }\n    };\n    let itrans = |id: u32| -> String {\n        match ist {\n            Some(t) => t.get(id as i32).map(|s| s.to_string()).unwrap_or_else(|| id.to_string()),\n            None => id.to_string(),\n        }\n    };\n    let otrans = |id: u32| -> String {\n        match ost {\n            Some(t) => t.get(id as i32).map(|s| s.to_string()).unwrap_or_else(|| id.to_string()),\n            None => id.to_string(),\n        }\n    };\n\n    for s in 0..fst.n_states {\n        let state = &fst.states[s as usize];\n        for arc in &state.arcs {\n            writeln!(\n                output,\n                \"{}\\t{}\\t{}\\t{}\\t{:.5}\",\n                strans(s),\n                strans(arc.state),\n                itrans(arc.ilabel),\n                otrans(arc.olabel),\n                arc.weight\n            )?;\n        }\n        if state.final_state {\n            finals.push(s);\n        }\n    }\n    for s in finals {\n        let state = &fst.states[s as usize];\n        writeln!(output, \"{}\\t{}\", strans(s), state.weight)?;\n    }\n    Ok(())\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3019,"cache_read_input_tokens":121927,"cache_creation":{"ephemeral_5m_input_tokens":3019,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8188bdfd-835a-4a95-a37e-f838ee03521d","uuid":"f049cebc-c074-49c5-a158-6c8164217f00"}
