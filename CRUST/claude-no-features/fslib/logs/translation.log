{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KwXRmTevPoPwjodkXrT5tY","type":"tool_result","content":"1\tuse fslib::fst::{Fst, StateData, ArcData};\n2\t\n3\tpub fn assert_arc_equal(arc_a: &ArcData, arc_b: &ArcData) {\n4\t    assert_eq!(arc_a.state, arc_b.state);\n5\t    assert_eq!(arc_a.ilabel, arc_b.ilabel);\n6\t    assert_eq!(arc_a.olabel, arc_b.olabel);\n7\t    assert_eq!(arc_a.weight, arc_b.weight);\n8\t}\n9\tpub fn assert_state_equal(state_a: &StateData, state_b: &StateData) {\n10\t    assert_eq!(state_a.weight, state_b.weight);\n11\t    assert_eq!(state_a.final_state, state_b.final_state);\n12\t}\n13\tpub fn assert_fst_equal(a: &Fst, b: &Fst) {\n14\t    assert_eq!(a.start, b.start);\n15\t    assert_eq!(a.sr_type, b.sr_type);\n16\t    assert_eq!(a.n_states, b.n_states);\n17\t    for st in 0..a.states.len().min(b.states.len()) {\n18\t        let state_a = &a.states[st];\n19\t        let state_b = &b.states[st];\n20\t        assert_eq!(state_a.arcs.len(), state_b.arcs.len());\n21\t        assert_state_equal(state_a, state_b);\n22\t        for arc in 0..state_a.arcs.len().min(state_b.arcs.len()) {\n23\t            assert_arc_equal(&state_a.arcs[arc], &state_b.arcs[arc]);\n24\t        }\n25\t    }\n26\t}\n27\t#[test]\n28\tfn test_fst_compile() {\n29\t    let mut fst = Fst::new();\n30\t    let input = \"0 1 1 1 1.0\\n1 1.0\";\n31\t    fst.compile_str(input);\n32\t    assert_eq!(fst.n_states, 2);\n33\t    let s0 = &fst.states[0];\n34\t    let s1 = &fst.states[1];\n35\t    assert_eq!(s0.final_state, false);\n36\t    assert_eq!(s1.final_state, true);\n37\t    // assert_eq!(s1.weight, 1.0);\n38\t    assert_eq!(s0.arcs.len(), 1);\n39\t    assert_eq!(s0.arcs[0].ilabel, 1);\n40\t    assert_eq!(s0.arcs[0].olabel, 1);\n41\t    assert_eq!(s0.arcs[0].weight, 1.0);\n42\t}\n43\t#[test]\n44\tfn test_test_equal() {\n45\t    let mut fst_a = Fst::new();\n46\t    let mut fst_b = Fst::new();\n47\t    let str_a = \"0 1 1 1\\n1 1.0\";\n48\t    let str_b = \"0 1 1 1\\n1 1.0\";\n49\t    fst_a.compile_str(str_a);\n50\t    fst_b.compile_str(str_b);\n51\t    assert_fst_equal(&fst_a, &fst_b);\n52\t}\n53\tfn main (){}"}]},"parent_tool_use_id":null,"session_id":"8188bdfd-835a-4a95-a37e-f838ee03521d","uuid":"0892b601-c44b-47cb-8892-3dc90f4316e5","timestamp":"2026-06-05T22:59:40.194Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-3y7aCD/project/src/bin/test_compile.rs","content":"use fslib::fst::{Fst, StateData, ArcData};\n\npub fn assert_arc_equal(arc_a: &ArcData, arc_b: &ArcData) {\n    assert_eq!(arc_a.state, arc_b.state);\n    assert_eq!(arc_a.ilabel, arc_b.ilabel);\n    assert_eq!(arc_a.olabel, arc_b.olabel);\n    assert_eq!(arc_a.weight, arc_b.weight);\n}\npub fn assert_state_equal(state_a: &StateData, state_b: &StateData) {\n    assert_eq!(state_a.weight, state_b.weight);\n    assert_eq!(state_a.final_state, state_b.final_state);\n}\npub fn assert_fst_equal(a: &Fst, b: &Fst) {\n    assert_eq!(a.start, b.start);\n    assert_eq!(a.sr_type, b.sr_type);\n    assert_eq!(a.n_states, b.n_states);\n    for st in 0..a.states.len().min(b.states.len()) {\n        let state_a = &a.states[st];\n        let state_b = &b.states[st];\n        assert_eq!(state_a.arcs.len(), state_b.arcs.len());\n        assert_state_equal(state_a, state_b);\n        for arc in 0..state_a.arcs.len().min(state_b.arcs.len()) {\n            assert_arc_equal(&state_a.arcs[arc], &state_b.arcs[arc]);\n        }\n    }\n}\n#[test]\nfn test_fst_compile() {\n    let mut fst = Fst::new();\n    let input = \"0 1 1 1 1.0\\n1 1.0\";\n    fst.compile_str(input);\n    assert_eq!(fst.n_states, 2);\n    let s0 = &fst.states[0];\n    let s1 = &fst.states[1];\n    assert_eq!(s0.final_state, false);\n    assert_eq!(s1.final_state, true);\n    // assert_eq!(s1.weight, 1.0);\n    assert_eq!(s0.arcs.len(), 1);\n    assert_eq!(s0.arcs[0].ilabel, 1);\n    assert_eq!(s0.arcs[0].olabel, 1);\n    assert_eq!(s0.arcs[0].weight, 1.0);\n}\n#[test]\nfn test_test_equal() {\n    let mut fst_a = Fst::new();\n    let mut fst_b = Fst::new();\n    let str_a = \"0 1 1 1\\n1 1.0\";\n    let str_b = \"0 1 1 1\\n1 1.0\";\n    fst_a.compile_str(str_a);\n    fst_b.compile_str(str_b);\n    assert_fst_equal(&fst_a, &fst_b);\n}\nfn main (){}","numLines":53,"startLine":1,"totalLines":53}}}
