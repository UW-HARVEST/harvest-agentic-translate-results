{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EM539CyqZrDLHBmr2A3Trx","type":"tool_result","content":"1\tuse worsp::worsp::ParseState;\n2\tuse worsp::worsp::TokenKind;\n3\tuse worsp::worsp::next;\n4\t\n5\t#[test]\n6\tfn next_single_char_symbol() {\n7\tlet source = \"a\";\n8\tlet mut state = ParseState { token: None, pos: 0 };\n9\tnext(source, &mut state);\n10\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::Symbol);\n11\tassert_eq!(state.token.as_ref().unwrap().str, \"a\");\n12\t}\n13\t\n14\t#[test]\n15\tfn next_multiple_char_symbol() {\n16\tlet source = \"aaaa\";\n17\tlet mut state = ParseState { token: None, pos: 0 };\n18\tnext(source, &mut state);\n19\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::Symbol);\n20\tassert_eq!(state.token.as_ref().unwrap().str, \"aaaa\");\n21\t}\n22\t\n23\t#[test]\n24\tfn next_paren_and_digit() {\n25\tlet source = \"(1)\";\n26\tlet mut state = ParseState { token: None, pos: 0 };\n27\tnext(source, &mut state);\n28\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::LParen);\n29\tnext(source, &mut state);\n30\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::Digit);\n31\tassert_eq!(state.token.as_ref().unwrap().val, 1);\n32\tnext(source, &mut state);\n33\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::RParen);\n34\t}\n35\t\n36\t#[test]\n37\tfn next_if_and_set() {\n38\tlet source = \"(if (set a 1) (set b 2) (set c 3))\";\n39\tlet mut state = ParseState { token: None, pos: 0 };\n40\tnext(source, &mut state);\n41\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::LParen);\n42\tnext(source, &mut state);\n43\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::Symbol);\n44\tassert_eq!(state.token.as_ref().unwrap().str, \"if\");\n45\tnext(source, &mut state);\n46\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::LParen);\n47\tnext(source, &mut state);\n48\tassert_eq!(state.token.as_ref().unwrap().kind, TokenKind::Symbol);\n49\tassert_eq!(