1, env,\n1355\t                             context);\n1356\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1357\t                             context);\n1358\t          definedFunctionSplit(operand1, operand2, evaluated, env, context);\n1359\t        } else if (strcmp(expr->data.symbol->symbol_name, \"list-ref\") == 0) {\n1360\t          // list-ref\n1361\t          struct Object *operand1 = allocate(context, env);\n1362\t          struct Object *operand2 = allocate(context, env);\n1363\t          evaluateExpression(expressions->next->expression, operand1, env,\n1364\t                             context);\n1365\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1366\t                             context);\n1367\t          definedFunctionListRef(operand1, operand2, evaluated);\n1368\t        } else if (strcmp(expr->data.symbol->symbol_name, \"progn\") == 0) {\n1369\t          // progn\n1370\t          struct ExpressionList *exprs = expressions->next;\n1371\t          struct Object *operand = NULL;\n1372\t          while (exprs != NULL) {\n1373\t            operand = allocate(context, env);\n1374\t            evaluateExpression(exprs->expression, operand, env, context);\n1375\t            exprs = exprs->next;\n1376\t          }\n1377\t          if (operand != NULL) {\n1378\t            *evaluated = *operand;\n1379\t          } else {\n1380\t            evaluated->type = OBJ_NIL;\n1381\t          }\n1382\t        } else if (strcmp(expr->data.symbol->symbol_name,\n1383\t                          \"remove-whitespaces\") == 0) {\n1384\t          // remove-whitespaces\n1385\t          struct Object *operand = allocate(context, env);\n1386\t          evaluateExpression(expressions->next->expression, operand, env,\n1387\t                             context);\n1388\t          definedFunctionRemoveWhitespaces(operand, evaluated);\n1389\t        } else if (strcmp(expr->data.symbol->symbol_name, \"pop\") == 0) {\n1390\t          // pop\n1391\t          struct Object *operand = allocate(context, env);\n1392\t          evaluateExpression(expressions->next->expression, operand, env,\n1393\t                             context);\n1394\t          definedFunctionPop(operand, evaluated);\n1395\t        } else if (strcmp(expr->data.symbol->symbol_name, \"push\") == 0) {\n1396\t          // push\n1397\t          struct Object *operand1 = allocate(context, env);\n1398\t          struct Object *operand2 = allocate(context, env);\n1399\t          evaluateExpression(expressions->next->next->expression, operand1, env,\n1400\t                             context);\n1401\t          evaluateExpression(expressions->next->expression, operand2, env,\n1402\t                             context);\n1403\t          definedFunctionPush(operand2, operand1, evaluated, env, context);\n1404\t        } else if (strcmp(expr->data.symbol->symbol_name, \"length\") == 0) {\n1405\t          // length\n1406\t          struct Object *operand = allocate(context, env);\n1407\t          evaluateExpression(expressions->next->expression, operand, env,\n1408\t                             context);\n1409\t          definedFunctionLength(operand, evaluated);\n1410\t        } else if (strcmp(expr->data.symbol->symbol_name, \"is-int-string\") ==\n1411\t                   0) {\n1412\t          // is-int-string\n1413\t          struct Object *operand = allocate(context, env);\n1414\t          evaluateExpression(expressions->next->expression, operand, env,\n1415\t                             context);\n1416\t          definedFunctionIsIntString(operand, evaluated);\n1417\t        } else if (strcmp(expr->data.symbol->symbol_name, \"parse-int\") == 0) {\n1418\t          // parse-int\n1419\t          struct Object *operand = allocate(context, env);\n1420\t          evaluateExpression(expressions->next->expression, operand, env,\n1421\t                             context);\n1422\t          definedFunctionParseInt(operand, evaluated);\n1423\t        } else if (strcmp(expr->data.symbol->symbol_name, \"string-ref\") == 0) {\n1424\t          // string-ref\n1425\t          struct Object *operand1 = allocate(context, env);\n1426\t          struct Object *operand2 = allocate(context, env);\n1427\t          evaluateExpression(expressions->next->expression, operand1, env,\n1428\t                             context);\n1429\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1430\t                              context);\n1431\t          definedFunctionStringRef(operand1, operand2, evaluated);\n1432\t        } else {\n1433\t          // function call\n1434\t          int i = 0;\n1435\t          struct Env *current_env = env;\n1436\t          struct Env *looked_up_env = current_env;\n1437\t          while (looked_up_env->bindings[i].symbol_name != NULL) {\n1438\t            if (strcmp(looked_up_env->bindings[i].symbol_name,\n1439\t                       expr->data.symbol->symbol_name) == 0) {\n1440\t              struct Function *function =\n1441\t                  looked_up_env->bindings[i].value->function_value;\n1442\t              struct Env *new_env = malloc(sizeof(struct Env));\n1443\t              new_env->parent = current_env;\n1444\t              int j = 0;\n1445\t              struct ExpressionList *param_expr = expressions->next;\n1446\t              while (function->param_symbol_names[j] != NULL) {\n1447\t                struct Object *param = allocate(context, env);\n1448\t                evaluateExpression(param_expr->expression, param, current_env,\n1449\t                                   context);\n1450\t                param_expr = param_expr->next;\n1451\t                setObjectToEnv(new_env, function->param_symbol_names[j], param);\n1452\t                j++;\n1453\t              }\n1454\t              evaluateExpression(function->body, evaluated, new_env, context);\n1455\t              return;\n1456\t            }\n1457\t            i++;\n1458\t            // look up the parent env if not found\n1459\t            if (env->bindings[i].symbol_name == NULL) {\n1460\t              looked_up_env = looked_up_env->parent;\n1461\t              i = 0;\n1462\t            }\n1463\t          }\n1464\t          printf(\"Undefined function: %s\\n\", expr->data.symbol->symbol_name);\n1465\t          exit(1);\n1466\t        }\n1467\t      }\n1468\t    } else {\n1469\t      printf(\"S-exp must be started with symbol.\\n\");\n1470\t      exit(1);\n1471\t    }\n1472\t  } else {\n1473\t    evaluated->type = OBJ_NIL;\n1474\t  }\n1475\t}\n1476\t\n1477\tvoid evaluateLiteralExpression(struct ExpressionNode *expression,\n1478\t                               struct Object *evaluated) {\n1479\t  if (expression->data.literal->type == LIT_INTERGER) {\n1480\t    evaluated->type = OBJ_INTEGER;\n1481\t    evaluated->int_value = expression->data.literal->int_value;\n1482\t  } else if (expression->data.literal->type == LIT_STRING) {\n1483\t    evaluated->type = OBJ_STRING;\n1484\t    evaluated->string_value = expression->data.literal->string_value;\n1485\t  } else if (expression->data.literal->type == LIT_BOOLEAN) {\n1486\t    evaluated->type = OBJ_BOOL;\n1487\t    evaluated->bool_value = expression->data.literal->boolean_value;\n1488\t  }\n1489\t}\n1490\t\n1491\tvoid evaluateSymbolExpression(struct ExpressionNode *expression,\n1492\t                              struct Object *evaluated, struct Env *env,\n1493\t                              struct AllocatorContext *context) {\n1494\t  if (strcmp(expression->data.symbol->symbol_name, \"nil\") == 0) {\n1495\t    evaluated->type = OBJ_NIL;\n1496\t  } else {\n1497\t    // get symbol value from env\n1498\t    int i = 0;\n1499\t    while (env->bindings[i].symbol_name != NULL) {\n1500\t      if (strcmp(env->bindings[i].symbol_name,\n1501\t                 expression->data.symbol->symbol_name) == 0) {\n1502\t        *evaluated = *env->bindings[i].value;\n1503\t        env->bindings[i].value = evaluated;\n1504\t        return;\n1505\t      }\n1506\t      i++;\n1507\t    }\n1508\t    if (env->parent != NULL) {\n1509\t      evaluateSymbolExpression(expression, evaluated, env->parent, context);\n1510\t    } else {\n1511\t      printf(\"Undefined symbol: %s\\n\", expression->data.symbol->symbol_name);\n1512\t      exit(1);\n1513\t    }\n1514\t  }\n1515\t}\n1516\t\n1517\tvoid evaluateExpression(struct ExpressionNode *expression,\n1518\t                        struct Object *evaluated, struct Env *env,\n1519\t                        struct AllocatorContext *context) {\n1520\t  pushObjectStack(context->stack, evaluated);\n1521\t  if (expression->type == EXP_LIST) {\n1522\t    evaluateListExpression(expression, evaluated, env, context);\n1523\t  } else if (expression->type == EXP_SYMBOLIC_EXP) {\n1524\t    evaluateSymbolicExpression(expression, evaluated, env, context);\n1525\t  } else if (expression->type == EXP_LITERAL) {\n1526\t    evaluateLiteralExpression(expression, evaluated);\n1527\t  } else if (expression->type == EXP_SYMBOL) {\n1528\t    evaluateSymbolExpression(expression, evaluated, env, context);\n1529\t  }\n1530\t  popObjectStack(context->stack);\n1531\t}\n1532\t\n1533\tvoid evaluateExpressionWithContext(struct ExpressionNode *expression,\n1534\t                                   struct Object *evaluated, struct Env *env) {\n1535\t  struct AllocatorContext *context = initAllocator();\n1536\t  evaluateExpression(expression, evaluated, env, context);\n1537\t}\n1538\t\n1539\tvoid initEnv(struct Env *env) {\n1540\t  env->parent = NULL;\n1541\t  env->bindings[0].symbol_name = NULL;\n1542\t  env->bindings[0].value = NULL;\n1543\t}\n1544\t\n1545\tvoid evaluateProgram(struct ProgramNode *program) {\n1546\t  struct ExpressionList *expressions = program->expressions;\n1547\t\n1548\t  struct Env *env = malloc(sizeof(struct Env));\n1549\t  initEnv(env);\n1550\t\n1551\t  struct AllocatorContext *context = initAllocator();\n1552\t\n1553\t  while (expressions != N