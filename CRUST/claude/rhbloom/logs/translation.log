67\t\n68\tfn test_step(rhbloom: &mut RHBloom, n: i32, p: f64) {\n69\t    let nn = n + 1;\n70\t    for i in 0..nn {\n71\t        if !rhbloom.upgraded() {\n72\t            assert!(!rhbloom.test(hash(i)));\n73\t        }\n74\t        rhbloom.add(hash(i));\n75\t        if !rhbloom.upgraded() {\n76\t            assert!(rhbloom.test(hash(i)));\n77\t        }\n78\t    }\n79\t    assert!(rhbloom.upgraded());\n80\t    let mut hits = 0;\n81\t    for i in 0..nn {\n82\t        if rhbloom.test(hash(i)) {\n83\t            hits += 1;\n84\t        }\n85\t    }\n86\t    assert_eq!(hits, nn);\n87\t    hits = 0;\n88\t    for i in nn..nn * 2 {\n89\t        if rhbloom.test(hash(i)) {\n90\t            hits += 1;\n91\t        }\n92\t    }\n93\t    if (hits as f64 / n as f64 - p).abs() > 0.1 && n > 0 {\n94\t        println!(\n95\t            \"n={} p={} hits={} \\t({})\",\n96\t            n, p, hits, hits as f64 / n as f64\n97\t        );\n98\t        println!(\" ({})\", hits as f64 / n as f64 - p);\n99\t        panic!(\"bad probability\");\n100\t    }\n101\t}\n102\t\n103\t#[test]\n104\tfn test() {\n105\t    for n in (0..100000).step_by(1000) {\n106\t        for p in (1..70).map(|x| x as f64 / 100.0) {\n107\t            let mut rhbloom = RHBloom::new(n as usize, p);\n108\t            test_step(&mut rhbloom, n, p);\n109\t            println!(\"-- clear --\");\n110\t            rhbloom.clear();\n111\t            test_step(&mut rhbloom, n, p);\n112\t        }\n113\t    }\n114\t    println!(\"PASSED\");\n115\t}\n116\t\n117\tfn bench(args: Vec<String>) {\n118\t    let mut n = 1000000;\n119\t    let mut p = 0.01;\n120\t    if args.len() > 2 {\n121\t        n = args[2].parse().unwrap();\n122\t    }\n123\t    if args.len() > 3 {\n124\t        p = args[3].parse().unwrap();\n125\t    }\n126\t    let mut hashes: Vec<u64> = (0..n * 2).map(|i| hash(i as i32)).collect();\n127\t    let mut rhbloom = RHBloom::new(n, p);\n128\t    let mut start;\n129\t    let mut misses = 0;\n130\t    for j in 0..2 {\n131\