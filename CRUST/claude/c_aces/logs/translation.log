andinverse(value: u64) -> Pair {\n    let mut a = randrange(2, value - 1);\n    while !are_coprime(a, value) {\n        a = randrange(2, value - 1);\n    }\n    let result = xgcd(a, value);\n    let second = if result.a > 0 {\n        result.a as u64\n    } else {\n        (result.a + value as i64) as u64\n    };\n    Pair { first: a, second }\n}\npub fn randrange(lower: u64, upper: u64) -> u64 {\n    // C: (rand() % (upper - lower + 1)) + lower\n    let mut rng = rand::rng();\n    let range = upper - lower + 1;\n    let r: u64 = rng.random_range(0..range);\n    r + lower\n}\npub fn normal_rand(mean: f64, stddev: f64) -> f64 {\n    let mut rng = rand::rng();\n    // Box-Muller method, mirroring C semantics.\n    let mut u: f64 = 0.0;\n    while u == 0.0 {\n        u = rng.random::<f64>();\n    }\n    let r = (-2.0 * u.ln()).sqrt();\n    let mut theta: f64 = 0.0;\n    while theta == 0.0 {\n        theta = 2.0 * std::f64::consts::PI * rng.random::<f64>();\n    }\n    let x = r * theta.cos();\n    x * stddev + mean\n}\npub fn max(a: u64, b: u64) -> u64 {\n    if a > b {\n        a\n    } else {\n        b\n    }\n}\npub fn min(a: u64, b: u64) -> u64 {\n    if a < b {\n        a\n    } else {\n        b\n    }\n}\npub fn clamp(min_value: u64, max_value: u64, value: u64) -> u64 {\n    max(min_value, min(max_value, value))\n}\n","structuredPatch":[{"oldStart":21,"oldLines":7,"newStart":21,"newLines":7,"lines":["     }","     x"," }","-pub fn xgcd(mut a: u64, mut b: u64) -> Xgcd {","+pub fn xgcd(a: u64, b: u64) -> Xgcd {","     // Mirror C xgcd: x and y are arguments; the C version uses x and y but the","     // Rust signature names them `a` and `b`. The C code passes them as x and y.","     let mut x = a;"]}],"userModified":false,"replaceAll":false}}
