ed_cards.my_cards[i] {\n                deck.strip_card_from_deck(c.get_card_suit_rank());\n            }\n        }\n        for i in 0..(decided_cards.opponent_card_count as usize) {\n            if let Some(c) = decided_cards.opponent_cards[i] {\n                deck.strip_card_from_deck(c.get_card_suit_rank());\n            }\n        }\n    }\n\n    pub fn complete_hand(my_hand: &mut CardHand, decided_cards: &DecidedCards, deck: &mut CardDeck) {\n        let end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            my_hand.insert_into_hand(&decided_cards.my_cards[i]);\n        }\n        let needed = (RAZZ_CARD_IN_HAND_COUNT as usize) - end;\n        for _ in 0..needed {\n            let dealt = deck.deal_from_deck();\n            my_hand.insert_into_hand(&dealt);\n        }\n    }\n\n    // ---- Razz rank evaluation -------------------------------------------------------\n    use std::cell::Cell;\n    thread_local! {\n        static PREV_RANK: Cell<CardRank> = Cell::new(CardRank::InvalidRank);\n    }\n\n    fn duplicated_rank_remover(_len: u64, pos: u64, c: &Option<Card>) -> ItrAction {\n        let curr = c.as_ref().map(|x| x.get_card_rank()).unwrap_or(CardRank::InvalidRank);\n        if pos == 0 {\n            PREV_RANK.with(|p| p.set(curr));\n            return ItrAction::Continue;\n        }\n        let prev = PREV_RANK.with(|p| p.get());\n        if prev == curr {\n            return ItrAction::RemoveAndContinue;\n        }\n        PREV_RANK.with(|p| p.set(curr));\n        ItrAction::Continue\n    }\n\n    fn length_trimmer(_len: u64, pos: u64, _c: &Option<Card>) -> ItrAction {\n        if pos >= 5 {\n            ItrAction::RemoveAndContinue\n        } else {\n            ItrAction::Continue\n        }\n    }\n\n    fn get_razz_rank(hand: &mut CardHand) -> CardRank {\n        hand.iterate_hand(duplicated_rank_remover);\n        let cards_count = hand.count_cards_in_hand();\n        if cards_count < 5 {\n            return CardRank::InvalidRank;\n        }\n        hand.iterate_hand(length_trimmer);\n        hand.get_max_rank_of_hand()\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":20,"newStart":1,"newLines":106,"lines":["-use crate::card::card::{Card, CardDeck, CardHand, CardRank};","+use crate::card::card::{Card, CardDeck, CardHand, CardRank, sort_card_by_rank, ItrAction};","+"," pub mod razz_simulation {","     use super::*;","+","     pub struct DecidedCards {","         pub my_card_count: u8,","         pub my_cards: [Option<Card>; 3],","         pub opponent_card_count: u8,","         pub opponent_cards: [Option<Card>; 7],","     }","+","     pub type RankListener<T> = fn(&mut T, CardRank);","-    pub fn simulate_razz_game<T>(decided_cards: &DecidedCards, game_count: u64, arg: &mut T, listener: RankListener<T>) -> i32 {","-        unimplemented!()","+","+    const RAZZ_CARD_IN_HAND_COUNT: u8 = 7;","+","+    pub fn simulate_razz_game<T>(","+        decided_cards: &DecidedCards,","+        game_count: u64,","+        arg: &mut T,","+        listener: RankListener<T>,","+    ) -> i32 {","+        let mut my_hand = match CardHand::create_hand(RAZZ_CARD_IN_HAND_COUNT, sort_card_by_rank) {","+            Some(h) => h,","+            None => return 1,","+        };","+","+        for _ in 0..game_count {","+            let mut deck = match CardDeck::create_shuffled_deck() {","+                Some(d) => d,","+                None => return 1,","+            };","+            strip_deck(&mut deck, decided_cards);","+            complete_hand(&mut my_hand, decided_cards, &mut deck);","+","+            let r = get_razz_rank(&mut my_hand);","+            listener(arg, r);","+","+            my_hand.reset_hand();","+        }","+        0","     }","+","     pub fn strip_deck(deck: &mut CardDeck, decided_cards: &DecidedCards) {","-        unimplemented!()","+        for i in 0..(decided_cards.my_card_count as usize) {","+            if let Some(c) = decided_cards.my_cards[i] {","+     