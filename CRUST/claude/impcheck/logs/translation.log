pub fn lrat_check_validate_sat(model: &[i32], size: u64) -> bool {\n    let done = DONE_LOADING.with(|d| *d.borrow());\n    if !done {\n        set_msgstr(\"SAT validation illegal - loading formula was not concluded\".to_string());\n        return false;\n    }\n    let check_model = CHECK_MODEL.with(|c| *c.borrow());\n    if !check_model {\n        set_msgstr(\"SAT validation illegal - not executed to explicitly support this\".to_string());\n        return false;\n    }\n    let nb_loaded = NB_LOADED_CLAUSES.with(|n| *n.borrow());\n    let mut model_local: Vec<i32> = model.to_vec();\n    for id in 1..=nb_loaded {\n        let cls_opt = CLAUSE_TABLE.with(|t| t.borrow().get(&id).cloned());\n        let cls = match cls_opt {\n            None => {\n                set_msgstr(format!(\"SAT validation: original ID {} not found\", id));\n                return false;\n            }\n            Some(c) => c,\n        };\n        let mut satisfied = false;\n        let mut lit_idx = 0;\n        while cls[lit_idx] != 0 {\n            let lit = cls[lit_idx];\n            let var = if lit > 0 { lit } else { -lit };\n            if (var - 1) as u64 >= size {\n                set_msgstr(format!(\n                    \"SAT validation: model does not cover variable {}\",\n                    var\n                ));\n                return false;\n            }\n            let mut model_lit = model_local[(var - 1) as usize];\n            if model_lit != var && model_lit != -var && model_lit != 0 {\n                set_msgstr(format!(\n                    \"SAT validation: unexpected literal {} in assignment of variable {}\",\n                    model_lit, var\n                ));\n                return false;\n            }\n            if model_lit == 0 {\n                model_lit = lit;\n                model_local[(var - 1) as usize] = lit;\n            }\n            if model_lit == lit {\n                satisfied = true;\n                break;\n            }\n        