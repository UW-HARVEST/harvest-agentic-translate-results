  static NB_READ_CLS: RefCell<i32> = RefCell::new(0);\n    static NB_VARS: RefCell<i32> = RefCell::new(-1);\n    static NB_CLS: RefCell<i32> = RefCell::new(-1);\n}\n\nconst PARSE_BUF_CAP: usize = crate::trusted_utils::TRUSTED_CHK_MAX_BUF_SIZE;\n\nimpl TrustedParser {\n    pub fn tp_end(&mut self) {\n        // Free any local resources. (data is in thread-local)\n        DATA.with(|d| d.borrow_mut().clear());\n    }\n\n    pub fn output_literal_buffer(&self) {\n        DATA.with(|d| {\n            let dvec = d.borrow();\n            // Update siphash with bytes of data\n            let mut bytes = Vec::with_capacity(dvec.len() * 4);\n            for &v in dvec.iter() {\n                bytes.extend_from_slice(&v.to_ne_bytes());\n            }\n            crate::siphash::global_siphash_update(&bytes, bytes.len() as u64);\n            // Write data to f_out\n            // (need mutable reference to f_out; we're &self. Use ptr trick.)\n            let f_ptr = &self.f_out as *const File as *mut File;\n            unsafe {\n                trusted_utils::trusted_utils_write_ints(&dvec, dvec.len() as u64, &mut *f_ptr);\n            }\n        });\n        DATA.with(|d| d.borrow_mut().clear());\n    }\n\n    pub fn append_integer(&self) {\n        let header = HEADER.with(|h| *h.borrow());\n        if header {\n            let nb_vars = NB_VARS.with(|n| *n.borrow());\n            let num = NUM.with(|n| *n.borrow());\n            if nb_vars == -1 {\n                NB_VARS.with(|n| *n.borrow_mut() = num);\n                let f_ptr = &self.f_out as *const File as *mut File;\n                unsafe {\n                    trusted_utils::trusted_utils_write_int(num, &mut *f_ptr);\n                }\n            } else {\n                let nb_cls = NB_CLS.with(|n| *n.borrow());\n                if nb_cls == -1 {\n                    NB_CLS.with(|n| *n.borrow_mut() = num);\n                    let f_ptr = &self.f_out as *const File as *mut File;\n                    unsafe {\n                        trusted_utils::trusted_utils_write_int(num, &mut *f_ptr);\n                    }\n                    HEADER.with(|h| *h.borrow_mut() = false);\n                } else {\n                    // abort\n                    std::process::exit(1);\n                }\n            }\n            NUM.with(|n| *n.borrow_mut() = 0);\n            BEGAN_NUM.with(|b| *b.borrow_mut() = false);\n            return;\n        }\n        let sign = SIGN.with(|s| *s.borrow());\n        let num = NUM.with(|n| *n.borrow());\n        let lit = sign * num;\n        if lit == 0 {\n            NB_READ_CLS.with(|n| *n.borrow_mut() += 1);\n        }\n        NUM.with(|n| *n.borrow_mut() = 0);\n        SIGN.with(|s| *s.borrow_mut() = 1);\n        BEGAN_NUM.with(|b| *b.borrow_mut() = false);\n        // Check buffer cap\n        let need_flush = DATA.with(|d| d.borrow().len() >= PARSE_BUF_CAP);\n        if need_flush {\n            self.output_literal_buffer();\n        }\n        DATA.with(|d| d.borrow_mut().push(lit));\n    }\n\n    pub fn tp_init(filename: &str, out: File) -> Self {\n        crate::siphash::global_siphash_init(&SECRET_KEY);\n        let f = File::open(filename).unwrap_or_else(|_| {\n            // Try to mirror C behavior: fopen returning NULL would simply use NULL\n            // and crash later. We just panic.\n            eprintln!(\"c [PARSER] cannot open formula file '{}'\", filename);\n            std::process::exit(1);\n        });\n        DATA.with(|d| {\n            d.borrow_mut().clear();\n            d.borrow_mut().reserve(PARSE_BUF_CAP);\n        });\n        // Reset other state\n        COMMENT.with(|c| *c.borrow_mut() = false);\n        HEADER.with(|h| *h.borrow_mut() = false);\n        INPUT_FINISHED.with(|i| *i.borrow_mut() = false);\n        INPUT_INVALID.with(|i| *i.borrow_mut() = false);\n        BEGAN_NUM.with(|b| *b.borrow_mut() = false);\n        NUM.with(|n| *n.borrow_mut() = 0);\n        SIGN.with(|s| *s.borrow_mut() = 1);\n        NB_READ_CLS.with(|n| *n.borrow_mut() = 0);\n        NB_VARS.with(|n| *n.borrow_mut() = -1);\n        NB_CLS.with(|n| *n.borrow_mut() = -1);\n\n        TrustedParser { f_out: out, f }\n    }\n\n    pub fn tp_parse(&mut self, sig: &mut Option<Vec<u8>>) -> bool {\n        // Read file char by char\n        let mut buf = [0u8; 1];\n        loop {\n            let res = self.f.read(&mut buf);\n            let c: i32 = match res {\n                Ok(0) => -1,\n                Ok(_) => buf[0] as i32,\n                Err(_) => -1,\n            };\n            // process expects char (signed); EOF is -1\n            let stop;\n            if c == -1 {\n                INPUT_FINISHED.with(|i| *i.borrow_mut() = true);\n                stop = true;\n            } else {\n                stop = self.process(c as u8 as char);\n            }\n            if stop {\n                break;\n            }\n        }\n        if BEGAN_NUM.with(|b| *b.borrow()) {\n            self.append_integer();\n        }\n        let nonempty = DATA.with(|d| !d.borrow().is_empty());\n        if nonempty {\n            self.output_literal_buffer();\n        }\n        crate::siphash::global_siphash_pad(2);\n        let s = crate::siphash::global_siphash_digest();\n        // Write sig to f_out\n        trusted_utils::trusted_utils_write_sig(&s, &mut self.f_out);\n        // Flush\n        let _ = self.f_out.flush();\n        *sig = Some(s);\n        let input_finished = INPUT_FINISHED.with(|i| *i.borrow());\n        let input_invalid = INPUT_INVALID.with(|i| *i.borrow());\n        input_finished && !input_invalid\n    }\n\n    pub fn process(&mut self, c: char) -> bool {\n        let comment = COMMENT.with(|cm| *cm.borrow());\n        if comment && c != '\\n' && c != '\\r' {\n            return false;\n        }\n        let uc = c as i8 as i32;\n        match uc {\n            -1 => {\n                // EOF\n                INPUT_FINISHED.with(|i| *i.borrow_mut() = true);\n                return true;\n            }\n            _ => {}\n        }\n        match c {\n            '\\n' | '\\r' => {\n                COMMENT.with(|cm| *cm.borrow_mut() = false);\n                if BEGAN_NUM.with(|b| *b.borrow()) {\n                    self.append_integer();\n                }\n            }\n            'p' => {\n                HEADER.with(|h| *h.borrow_mut() = true);\n            }\n            'c' => {\n                let header = HEADER.with(|h| *h.borrow());\n                if !header {\n                    COMMENT.with(|cm| *cm.borrow_mut() = true);\n                }\n            }\n            ' ' => {\n                if BEGAN_NUM.with(|b| *b.borrow()) {\n                    self.append_integer();\n                }\n            }\n            '-' => {\n                SIGN.with(|s| *s.borrow_mut() = -1);\n                BEGAN_NUM.with(|b| *b.borrow_mut() = true);\n            }\n            d @ '0'..='9' => {\n                NUM.with(|n| {\n                    let mut nb = n.borrow_mut();\n                    *nb = *nb * 10 + ((d as i32) - ('0' as i32));\n                });\n                BEGAN_NUM.with(|b| *b.borrow_mut() = true);\n            }\n            _ => {}\n        }\n        false\n    }\n}\n","userModified":false}}
