n    }\n\n    v3 ^= b;\n\n    for (i = 0; i < cROUNDS; ++i)\n        SIPROUND;\n\n    v0 ^= b;\n\n    if (outlen == 16)\n        v2 ^= 0xee;\n    else\n        v2 ^= 0xff;\n\n    for (i = 0; i < dROUNDS; ++i)\n        SIPROUND;\n\n    b = v0 ^ v1 ^ v2 ^ v3;\n    U64TO8_LE(out, b);\n\n    v1 ^= 0xdd;\n\n    for (i = 0; i < dROUNDS; ++i)\n        SIPROUND;\n\n    b = v0 ^ v1 ^ v2 ^ v3;\n    U64TO8_LE(out + 8, b);\n}\n\nvoid siphash_init(const unsigned char* key_128bit) {\n    kk = key_128bit;\n    out = trusted_utils_malloc(128 / 8);\n    buf = trusted_utils_malloc(8);\n    if (kk) siphash_reset();\n}\nvoid siphash_reset() {\n    v0 = SH_UINT64_C(0x736f6d6570736575);\n    v1 = SH_UINT64_C(0x646f72616e646f6d);\n    v2 = SH_UINT64_C(0x6c7967656e657261);\n    v3 = SH_UINT64_C(0x7465646279746573);\n    k0 = U8TO64_LE(kk);\n    k1 = U8TO64_LE(kk + 8);\n    v3 ^= k1;\n    v2 ^= k0;\n    v1 ^= k1;\n    v0 ^= k0;\n    inlen = 0;\n    buflen = 0;\n    if (outlen == 16)\n        v1 ^= 0xee;\n}\nvoid siphash_update(const unsigned char* data, u64 nb_bytes) {\n    u32 datapos = 0;\n    while (true) {\n        while (buflen < 8u && datapos < nb_bytes) {\n            buf[buflen++] = data[datapos++];\n        }\n        if (buflen < 8u) {\n            break;\n        }\n        process_next_block();\n        buflen = 0;\n    }\n    inlen += nb_bytes;\n}\nvoid siphash_pad(u64 nb_bytes) {\n    const unsigned char c = 0;\n    for (u64 i = 0; i < nb_bytes; i++) siphash_update(&c, 1);\n}\nu8* siphash_digest() {\n    process_final_block();\n    return out;\n}\nvoid siphash_free() {\n    free(buf);\n    free(out);\n}\n\n#undef SH_UINT64_C\n","numLines":178,"startLine":1,"totalLines":178}}}
