        self.v3 ^= m;\n        for _ in 0..C_ROUNDS {\n            sipround(&mut self.v0, &mut self.v1, &mut self.v2, &mut self.v3);\n        }\n        self.v0 ^= m;\n    }\n\n    pub fn process_final_block(&mut self) {\n        let left = (self.inlen & 7) as usize;\n        debug_assert_eq!(left, self.buflen as usize);\n        let mut b: u64 = self.inlen << 56;\n        let ni = &self.buf;\n        if left >= 7 { b |= (ni[6] as u64) << 48; }\n        if left >= 6 { b |= (ni[5] as u64) << 40; }\n        if left >= 5 { b |= (ni[4] as u64) << 32; }\n        if left >= 4 { b |= (ni[3] as u64) << 24; }\n        if left >= 3 { b |= (ni[2] as u64) << 16; }\n        if left >= 2 { b |= (ni[1] as u64) << 8; }\n        if left >= 1 { b |= ni[0] as u64; }\n\n        self.v3 ^= b;\n        for _ in 0..C_ROUNDS {\n            sipround(&mut self.v0, &mut self.v1, &mut self.v2, &mut self.v3);\n        }\n        self.v0 ^= b;\n        if OUTLEN == 16 {\n            self.v2 ^= 0xee;\n        } else {\n            self.v2 ^= 0xff;\n        }\n        for _ in 0..D_ROUNDS {\n            sipround(&mut self.v0, &mut self.v1, &mut self.v2, &mut self.v3);\n        }\n        let mut bb = self.v0 ^ self.v1 ^ self.v2 ^ self.v3;\n        u64to8_le(&mut self.out[..8], bb);\n        self.v1 ^= 0xdd;\n        for _ in 0..D_ROUNDS {\n            sipround(&mut self.v0, &mut self.v1, &mut self.v2, &mut self.v3);\n        }\n        bb = self.v0 ^ self.v1 ^ self.v2 ^ self.v3;\n        u64to8_le(&mut self.out[8..16], bb);\n    }\n\n    pub fn siphash_pad(&mut self, nb_bytes: u64) {\n        let c = [0u8; 1];\n        for _ in 0..nb_bytes {\n            self.siphash_update(&c, 1);\n        }\n    }\n\n    pub fn siphash_digest(&self) -> Vec<u8> {\n        // Copy self mutably to compute final block, since C version mutates state\n        // We want a non-mutating signature here. Let's mimic: we compute the digest\n        // by cloning state and finalizing.\n        let mut s = SipHash {\n            kk: self.kk.clone(),\n            out: self.out.clone(),\n            buf: self.buf.clone(),\n            buflen: self.buflen,\n            inlen: self.inlen,\n            v0: self.v0,\n            v1: self.v1,\n            v2: self.v2,\n            v3: self.v3,\n        };\n        s.process_final_block();\n        s.out\n    }\n\n    pub fn siphash_free(&mut self) {\n        self.kk.clear();\n        self.out.clear();\n        self.buf.clear();\n    }\n}\n","userModified":false}}
