     trusted_utils::trusted_utils_write_char(c, &mut self.output);\n    }\n\n    pub fn tc_run(check_model: bool, lenient: bool) -> i32 {\n        // We need a way to access self in this static function. Use thread-local\n        // singleton pattern - but actually the function signature is static.\n        // We'll use a thread-local TrustedChecker.\n        let start = Instant::now();\n        let mut nb_produced = 0u64;\n        let mut nb_imported = 0u64;\n        let mut nb_deleted = 0u64;\n        let mut reported_error = false;\n\n        TC_INSTANCE.with(|tc_cell| {\n            let mut tc_opt = tc_cell.borrow_mut();\n            let tc = tc_opt.as_mut().expect(\"trusted_checker not initialized\");\n            loop {\n                let c = trusted_utils::trusted_utils_read_char(&mut tc.input) as u8 as char;\n                if c == TRUSTED_CHK_CLS_PRODUCE {\n                    let id = trusted_utils::trusted_utils_read_ul(&mut tc.input);\n                    let nb_lits = trusted_utils::trusted_utils_read_int(&mut tc.input);\n                    let lits = tc.read_literals(nb_lits);\n                    let nb_hints = trusted_utils::trusted_utils_read_int(&mut tc.input);\n                    let hints = tc.read_hints(nb_hints);\n                    let share = trusted_utils::trusted_utils_read_bool(&mut tc.input);\n                    let mut sig_opt: Option<Vec<u8>> = if share {\n                        Some(vec![0u8; SIG_SIZE_BYTES])\n                    } else {\n                        None\n                    };\n                    let res =\n                        top_check::top_check_produce(id, &lits, nb_lits, &hints, nb_hints, &mut sig_opt);\n                    tc.say(res);\n                    if share {\n                        if let Some(s) = &sig_opt {\n                            trusted_utils::trusted_utils_write_sig(s, &mut tc.output);\n                        }\n                    }\n                    let _ = tc.output.flush();\n                    nb_produced += 1;\n                } else if c == TRUSTED_CHK_CLS_IMPORT {\n                    let id = trusted_utils::trusted_utils_read_ul(&mut tc.input);\n                    let nb_lits = trusted_utils::trusted_utils_read_int(&mut tc.input);\n                    let lits = tc.read_literals(nb_lits);\n                    let mut sig = vec![0u8; SIG_SIZE_BYTES];\n                    trusted_utils::trusted_utils_read_sig(&mut sig, &mut tc.input);\n                    let res = top_check::top_check_import(id, &lits, nb_lits, &sig);\n                    tc.say(res);\n                    let _ = tc.output.flush();\n                    nb_imported += 1;\n                } else if c == TRUSTED_CHK_CLS_DELETE {\n                    let nb_hints = trusted_utils::trusted_utils_read_int(&mut tc.input);\n                    let hints = tc.read_hints(nb_hints);\n                    let res = top_check::top_check_delete(&hints, nb_hints);\n                    tc.say(res);\n                    let _ = tc.output.flush();\n                    nb_deleted += nb_hints as u64;\n                } else if c == TRUSTED_CHK_LOAD {\n                    let nb_lits = trusted_utils::trusted_utils_read_int(&mut tc.input);\n                    let lits = tc.read_literals(nb_lits);\n                    for i in 0..nb_lits as usize {\n                        top_check::top_check_load(lits[i]);\n                    }\n                    // No feedback\n                } else if c == TRUSTED_CHK_INIT {\n                    let nb_vars = trusted_utils::trusted_utils_read_int(&mut tc.input);\n                    top_check::top_check_init(nb_vars, check_model, lenient);\n                    let mut formula_sig = vec![0u8; SIG_SIZE_BYTES];\n                    trusted_utils::trusted_utils_read_sig(&mut formula_sig, &mut tc.input);\n                    top_check::top_check_commit_formula_sig(&formula_sig);\n                    tc.say_with_flush(true);\n                } else if c