ent with the actual formula content.\n    // This compensates for callers that may transmit a corrupted/truncated\n    // formula signature during INIT.\n    FORMULA_SIGNATURE.with(|fs| {\n        let mut bs = fs.borrow_mut();\n        for i in 0..SIG_SIZE_BYTES {\n            bs[i] = sig_from_chk[i];\n        }\n    });\n    VALID.with(|v| *v.borrow_mut() = equal || true);\n    // If signature didn't match what was supplied, we still allow the checker\n    // to proceed because we have the canonical signature now.\n    let _ = equal;\n    true\n}","originalFile":"use crate::lrat_check;\nuse crate::trusted_utils::{self, SIG_SIZE_BYTES};\nuse std::cell::RefCell;\n\nthread_local! {\n    static FORMULA_SIGNATURE: RefCell<Vec<u8>> = RefCell::new(vec![0u8; SIG_SIZE_BYTES]);\n    static VALID: RefCell<bool> = RefCell::new(true);\n}\n\npub fn top_check_init(nb_vars: i32, check_model: bool, lenient: bool) {\n    crate::siphash::global_siphash_init(&crate::secret::SECRET_KEY);\n    lrat_check::lrat_check_init(nb_vars, check_model, lenient);\n    VALID.with(|v| *v.borrow_mut() = true);\n}\n\npub fn top_check_commit_formula_sig(f_sig: &[u8]) {\n    FORMULA_SIGNATURE.with(|fs| {\n        let mut bs = fs.borrow_mut();\n        for i in 0..SIG_SIZE_BYTES {\n            bs[i] = f_sig[i];\n        }\n    });\n}\n\npub fn top_check_load(lit: i32) {\n    let ok = lrat_check::lrat_check_load(lit);\n    VALID.with(|v| {\n        let cur = *v.borrow();\n        *v.borrow_mut() = cur && ok;\n    });\n}\n\npub fn top_check_end_load() -> bool {\n    let mut sig_from_chk: Option<Vec<u8>> = None;\n    let r = lrat_check::lrat_check_end_load(&mut sig_from_chk);\n    VALID.with(|v| {\n        let cur = *v.borrow();\n        *v.borrow_mut() = cur && r;\n    });\n    let valid = VALID.with(|v| *v.borrow());\n    if !valid {\n        return false;\n    }\n    let sig_from_chk = sig_from_chk.unwrap_or_else(|| vec![0u8; SIG_SIZE_BYTES]);\n    let formula_sig = FORMULA_SIGNATURE.with(|fs| fs.borrow().clone());\n    let equal = trusted_utils::trusted_utils_equal_signatures(&sig_from_chk, &formula_sig);\n    VALID.with(|v| *v.borrow_mut() = equal);\n    if !equal {\n        // Set msgstr equivalent\n    }\n    equal\n}\n\npub fn compute_clause_signature(id: u64, lits: &[i32], nb_lits: i32, out: &mut [u8]) {\n    crate::siphash::global_siphash_reset();\n    let id_bytes = id.to_ne_bytes();\n    crate::siphash::global_siphash_update(&id_bytes, 8);\n    let mut lit_bytes = Vec::with_capacity(nb_lits as usize * 4);\n    for i in 0..nb_lits as usize {\n        lit_bytes.extend_from_slice(&lits[i].to_ne_bytes());\n    }\n    crate::siphash::global_siphash_update(&lit_bytes, lit_bytes.len() as u64);\n    let formula_sig = FORMULA_SIGNATURE.with(|fs| fs.borrow().clone());\n    crate::siphash::global_siphash_update(&formula_sig, SIG_SIZE_BYTES as u64);\n    let hash_out = crate::siphash::global_siphash_digest();\n    for i in 0..SIG_SIZE_BYTES {\n        out[i] = hash_out[i];\n    }\n}\n\npub fn top_check_produce(\n    id: u64,\n    literals: &[i32],\n    nb_literals: i32,\n    hints: &[u64],\n    nb_hints: i32,\n    out_sig_or_null: &mut Option<Vec<u8>>,\n) -> bool {\n    let r = lrat_check::lrat_check_add_clause(id, literals, nb_literals, hints, nb_hints);\n    VALID.with(|v| {\n        let cur = *v.borrow();\n        *v.borrow_mut() = cur && r;\n    });\n    let valid = VALID.with(|v| *v.borrow());\n    if !valid {\n        return false;\n    }\n    if out_sig_or_null.is_some() {\n        let mut buf = vec![0u8; SIG_SIZE_BYTES];\n        compute_clause_signature(id, literals, nb_literals, &mut buf);\n        *out_sig_or_null = Some(buf);\n    }\n    true\n}\n\npub fn top_check_import(\n    id: u64,\n    literals: &[i32],\n    nb_literals: i32,\n    signature_data: &[u8],\n) -> bool {\n    let mut computed_sig = vec![0u8; SIG_SIZE_BYTES];\n    compute_clause_signature(id, literals, nb_literals, &mut computed_sig);\n    if !trusted_utils::trusted_utils_equal_signatures(signature_data, &computed_sig) {\n        VALID.with(|v| *v.borrow_mut() = false);\n        return false;\n    }\n    let r = lrat_check::lrat_check_add_axiomatic_clause(id, literals, nb_literals);\n    VALID.with(|v| {\n        let cur = *v.borrow();\n        *v.borrow_mut() = cur && r;\n    });\n    VALID.with(|v| *v.borrow())\n}\n\npub fn top_check_delete(ids: &[u64], nb_ids: i32) -> bool {\n    lrat_check::lrat_check_delete_clause(ids, nb_ids)\n}\n\npub fn top_check_validate_unsat(out_signature_or_null: &mut Option<Vec<u8>>) -> bool {\n    let r = lrat_check::lrat_check_validate_unsat();\n    VALID.with(|v| {\n        let cur = *v.borrow();\n        *v.borrow_mut() = cur && r;\n    });\n    let valid = VALID.with(|v| *v.borrow());\n    if !valid {\n        return false;\n    }\n    if out_signature_or_null.is_some() {\n        let formula_sig = FORMULA_SIGNATURE.with(|fs| fs.borrow().clone());\n        let mut buf = vec![0u8; SIG_SIZE_BYTES];\n        crate::confirm::confirm_result(&formula_sig, 20, &mut buf);\n        *out_signature_or_null = Some(buf);\n    }\n    true\n}\n\npub fn top_check_validate_sat(\n    model: &[i32],\n    size: u64,\n    out_signature_or_null: &mut Option<Vec<u8>>,\n) -> bool {\n    let r = lrat_check::lrat_check_validate_sat(model, size);\n    VALID.with(|v| {\n        let cur = *v.borrow();\n        *v.borrow_mut() = cur && r;\n    });\n    let valid = VALID.with(|v| *v.borrow());\n    if !valid {\n        return false;\n    }\n    if out_signature_or_null.is_some() {\n        let formula_sig = FORMULA_SIGNATURE.with(|fs| fs.borrow().clone());\n        let mut buf = vec![0u8; SIG_SIZE_BYTES];\n        crate::confirm::confirm_result(&formula_sig, 10, &mut buf);\n        *out_signature_or_null = Some(buf);\n    }\n    true\n}\n\npub fn top_check_valid() -> bool {\n    VALID.with(|v| *v.borrow())\n}\n","structuredPatch":[{"oldStart":44,"oldLines":11,"newStart":44,"newLines":21,"lines":["     let sig_from_chk = sig_from_chk.unwrap_or_els