ata[j as usize].val, empty_val());\n                self.data[j as usize].key = 0;\n                // also clear i first to avoid leaking - but i has been \"emptied\" already by the caller (drop_val_box)\n                self.data[i as usize].key = key_j;\n                self.data[i as usize].val = val_j;\n                i = j;\n            }\n        }\n    }\n\n    pub fn hash_table_free(&mut self) {\n        // Free all remaining boxes in entries\n        for entry in self.data.iter_mut() {\n            if entry.key != 0 {\n                let val_ref = std::mem::replace(&mut entry.val, empty_val());\n                drop_val_box(val_ref);\n                entry.key = 0;\n            }\n        }\n        // Free the data array itself by reconstructing the Box\n        let ptr = self.data.as_mut_ptr();\n        let len = self.data.len();\n        // Replace self.data with a dummy empty slice so we can reclaim the original\n        let dummy: &'a mut [HashTableEntry<'a, T>] = unsafe {\n            std::slice::from_raw_parts_mut(std::ptr::NonNull::dangling().as_ptr(), 0)\n        };\n        self.data = dummy;\n        unsafe {\n            let _: Box<[HashTableEntry<'a, T>]> = Box::from_raw(std::slice::from_raw_parts_mut(ptr, len));\n        }\n        self.capacity = 0;\n        self.size = 0;\n        self.max_size = 0;\n    }\n}\n","structuredPatch":[{"oldStart":49,"oldLines":9,"newStart":49,"newLines":9,"lines":["     for _ in 0..capacity {","         v.push(HashTableEntry { key: 0, val: empty_val() });","     }","-    let leaked: &'static mut [HashTableEntry<'a, T>] = Box::leak(v.into_boxed_slice());","-    // Coerce 'static to 'a","-    leaked","+    let boxed = v.into_boxed_slice();","+    let ptr = Box::into_raw(boxed);","+    unsafe { &mut *ptr }"," }"," "," fn dealloc_data<'a, T>(data: &'a mut [HashTableEntry<'a, T>]) {"]}],"userModified":false,"replaceAll":false}}
