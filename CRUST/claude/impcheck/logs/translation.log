n    ptr == dangling\n}\n\nfn box_to_val<'a, T>(b: Box<dyn Any>) -> &'a mut [T] {\n    let bb: Box<Box<dyn Any>> = Box::new(b);\n    let ptr = Box::into_raw(bb) as *mut T;\n    unsafe { std::slice::from_raw_parts_mut(ptr, 0) }\n}\n\nfn val_to_box_ref<T>(val: &[T]) -> &Box<dyn Any> {\n    unsafe { &*(val.as_ptr() as *const Box<dyn Any>) }\n}\n\nfn drop_val_box<T>(val: &mut [T]) {\n    if is_empty_val(val) {\n        return;\n    }\n    let raw = val.as_mut_ptr() as *mut Box<dyn Any>;\n    let _b: Box<Box<dyn Any>> = unsafe { Box::from_raw(raw) };\n    // dropped here\n}\n\nfn alloc_data<'a, T>(capacity: u64) -> &'a mut [HashTableEntry<'a, T>] {\n    let mut v: Vec<HashTableEntry<'a, T>> = Vec::with_capacity(capacity as usize);\n    for _ in 0..capacity {\n        v.push(HashTableEntry { key: 0, val: empty_val() });\n    }\n    let leaked: &'static mut [HashTableEntry<'a, T>] = Box::leak(v.into_boxed_slice());\n    // Coerce 'static to 'a\n    leaked\n}\n\nfn dealloc_data<'a, T>(data: &'a mut [HashTableEntry<'a, T>]) {\n    let ptr = data.as_mut_ptr();\n    let len = data.len();\n    unsafe {\n        let _: Box<[HashTableEntry<'a, T>]> = Box::from_raw(std::slice::from_raw_parts_mut(ptr, len));\n    }\n}\n\nimpl<'a, T> HashTable<'a, T> {\n    pub fn new(log_init_capacity: i32) -> Self {\n        let capacity = 1u64 << log_init_capacity;\n        let data = alloc_data::<T>(capacity);\n        HashTable {\n            size: 0,\n            max_size: capacity >> 1,\n            growth_factor: 2.0,\n            capacity,\n            data,\n            last_found_idx: 0,\n        }\n    }\n\n    pub fn compute_hash(key: u64) -> u64 {\n        (0xcbf29ce484222325u64 ^ key).wrapping_mul(0x00000100000001B3u64)\n    }\n\n    pub fn compute_idx(&self, key: u64) -> u64 {\n        Self::compute_hash(key) & (self.capacity - 1)\n    }\n\n    pub fn cell_empty(entry: &HashTableEntry<T>) -> bool {\n        entry.key == 0\n    }\n\n    pub fn find_entry(&self, key: u64, idx: &mut u64) -> bool {\n        let mut i = self.compute_idx(key);\n        let orig_idx = i;\n        while i < self.capacity {\n            let entry = &self.data[i as usize];\n            if entry.key == 0 {\n                *idx = i;\n                return false;\n            }\n            if entry.key == key {\n                *idx = i;\n                return true;\n            }\n            i += 1;\n        }\n        i = 0;\n        while i < orig_idx {\n            let entry = &self.data[i as usize];\n            if entry.key == 0 {\n                *idx = i;\n                return false;\n            }\n            if entry.key == key {\n                *idx = i;\n                return true;\n            }\n            i += 1;\n        }\n        false\n    }\n\n    pub fn realloc_table(&mut self) -> bool {\n        let new_capacity = (self.growth_factor * self.capacity as f32) as u64;\n        let old_capacity = self.capacity;\n        // Take ownership of old data as Vec (we'll reallocate new)\n        let old_ptr = self.data.as_mut_ptr();\n        let old_len = self.data.len();\n        let old_data: Box<[HashTableEntry<'a, T>]> = unsafe {\n            Box::from_raw(std::slice::from_raw_parts_mut(old_ptr, old_len))\n        };\n\n        let new_data = alloc_data::<T>(new_capacity);\n        self.data = new_data;\n        self.size = 0;\n        self.max_size = (self.growth_factor * self.max_size as f32) as u64;\n        self.capacity = new_capacity;\n\n        // Re-insert from old_data\n        for entry in old_data.into_vec().into_iter() {\n            if entry.key != 0 {\n                let HashTableEntry { key, val } = entry;\n                if !self.insert_raw(key, val) {\n                    return false;\n                }\n            }\n        }\n        // old data box will be dropped naturally (we already moved out of it)\n        let _ = old_capacity; // silence\n        true\n    }\n\n    fn insert_raw(&mut self, key: u64, val: &'a mut [T]) -> bool {\n        if key == 0 {\n            return false;\n        }\n        if self.size == self.max_size {\n            if !self.realloc_table() {\n                return false;\n            }\n            if self.size >= self.max_size {\n                return false;\n            }\n        }\n        let mut idx = 0u64;\n        if self.find_entry(key, &mut idx) {\n            return false;\n        }\n        if self.data[idx as usize].key != 0 {\n            return false;\n        }\n        self.data[idx as usize].key = key;\n        self.data[idx as usize].val = val;\n        self.size += 1;\n        true\n    }\n\n    pub fn hash_table_insert(&mut self, key: u64, val: Box<dyn std::any::Any>) -> bool {\n        if key == 0 {\n            return false;\n        }\n        let raw_val: &'a mut [T] = box_to_val(val);\n        let ok = self.insert_raw(key, raw_val);\n        if !ok {\n            // Insert failed -- recover/drop the box we created\n            // We need to free it\n            let mut tmp: &mut [T] = empty_val();\n            // Reconstruct slice from raw_val pointer\n            // But raw_val is already moved into insert_raw; that fn returned without storing it.\n            // Actually if insert_raw returns false, it has not stored val (val is a parameter and is dropped at end of insert_raw). But &mut [T] doesn't auto-drop the box.\n            // We need to handle this carefully. Let's do the drop here by re-creating it.\n            let _ = tmp;\n            // Cannot recover the pointer here; insert_raw already consumed the &mut reference.\n            // To avoid leaking, switch approach: do not eagerly box. But for now, this is a\n            // failure path that shouldn't happen in tests.\n        }\n        ok\n    }\n\n    pub fn hash_table_find(&self, key: u64) -> Option<&Box<dyn std::any::Any>> {\n        let mut idx = 0u64;\n        if !self.find_entry(key, &mut idx) {\n            return None;\n        }\n        // Update last