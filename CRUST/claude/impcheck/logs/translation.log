{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MPkwY1gKXQ65cG29AKvhCx","type":"tool_result","content":"1\t\n2\t#pragma once\n3\t\n4\t// This file specifies the input and output format of the checker process.\n5\t// For all multi-byte objects such as 32- or 64-bit integers, note the\n6\t// system's endianness. For specifics, examine the methods\n7\t// trusted_utils_{read,write}* in trusted_utils.c.\n8\t\n9\t// Initialize and begin the loading stage.\n10\t// IN: #vars (int); 128-bit signature of the formula (from trusted parser)\n11\t// OUT: OK\n12\t#define TRUSTED_CHK_INIT 'B'\n13\t\n14\t// Load a chunk of the original problem formula.\n15\t// IN: int k; sequence of k literals.\n16\t// OUT: (void)\n17\t#define TRUSTED_CHK_LOAD 'L'\n18\t\n19\t// End the loading stage; verify the signature.\n20\t// IN: (void)\n21\t// OUT: OK\n22\t#define TRUSTED_CHK_END_LOAD 'E'\n23\t\n24\t// Add the derivation of a new, local clause.\n25\t// IN: 64-bit ID; int k; sequence of k literals;\n26\t//     int l; sequence of l 64-bit hints;\n27\t//     \"share\" char (0|1) indicating whether to return a signature.\n28\t// OUT: OK; 128-bit signature only if \"share\"\n29\t#define TRUSTED_CHK_CLS_PRODUCE 'a'\n30\t\n31\t// Import a clause from another solver.\n32\t// IN: 64-bit ID; int k; sequence of k literals; 128-bit signature.\n33\t// OUT: OK\n34\t#define TRUSTED_CHK_CLS_IMPORT 'i'\n35\t\n36\t// Delete a sequence of clauses.\n37\t// IN: int k; sequence of k 64-bit IDs.\n38\t// OUT: OK\n39\t#define TRUSTED_CHK_CLS_DELETE 'd'\n40\t\n41\t// Confirm that the formula is proven unsatisfiable.\n42\t// IN: (none)\n43\t// OUT: OK\n44\t#define TRUSTED_CHK_VALIDATE_UNSAT 'V'\n45\t\n46\t// Check the provided model to confirm that the formula is satisfiable.\n47\t// IN: int k, sequence M of k literals where M[x] ∈ ±(x+1) indicates\n48\t//     the assignment to variable x+1.\n49\t// OUT: OK\n50\t#define TRUSTED_CHK_VALIDATE_SAT 'M'\n51\t\n52\t// Terminate.\n53\t// IN: (none)\n54\t// OUT: OK\n55\t#define TRUSTED_CHK_TERMINATE 'T'\n56\t\n57\t// Checker answer that everything is OK\n58\t#define TRUSTED_CHK_RES_ACCEPT 'A'\n59\t// Checker answer that an error occurred\n60\t#define TRUSTED_CHK_RES_ERROR 'E'\n61\t"}]},"parent_tool_use_id":null,"session_id":"edc13dda-8b31-475a-8085-b05c8da1a504","uuid":"f68fa771-4225-4a95-ae4a-61c5134dbe80","timestamp":"2026-05-28T19:29:09.481Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-XM7DFm/project/c_src/src/trusted/checker_interface.h","content":"\n#pragma once\n\n// This file specifies the input and output format of the checker process.\n// For all multi-byte objects such as 32- or 64-bit integers, note the\n// system's endianness. For specifics, examine the methods\n// trusted_utils_{read,write}* in trusted_utils.c.\n\n// Initialize and begin the loading stage.\n// IN: #vars (int); 128-bit signature of the formula (from trusted parser)\n// OUT: OK\n#define TRUSTED_CHK_INIT 'B'\n\n// Load a chunk of the original problem formula.\n// IN: int k; sequence of k literals.\n// OUT: (void)\n#define TRUSTED_CHK_LOAD 'L'\n\n// End the loading stage; verify the signature.\n// IN: (void)\n// OUT: OK\n#define TRUSTED_CHK_END_LOAD 'E'\n\n// Add the derivation of a new, local clause.\n// IN: 64-bit ID; int k; sequence of k literals;\n//     int l; sequence of l 64-bit hints;\n//     \"share\" char (0|1) indicating whether to return a signature.\n// OUT: OK; 128-bit signature only if \"share\"\n#define TRUSTED_CHK_CLS_PRODUCE 'a'\n\n// Import a clause from another solver.\n// IN: 64-bit ID; int k; sequence of k literals; 128-bit signature.\n// OUT: OK\n#define TRUSTED_CHK_CLS_IMPORT 'i'\n\n// Delete a sequence of clauses.\n// IN: int k; sequence of k 64-bit IDs.\n// OUT: OK\n#define TRUSTED_CHK_CLS_DELETE 'd'\n\n// Confirm that the formula is proven unsatisfiable.\n// IN: (none)\n// OUT: OK\n#define TRUSTED_CHK_VALIDATE_UNSAT 'V'\n\n// Check the provided model to confirm that the formula is satisfiable.\n// IN: int k, sequence M of k literals where M[x] ∈ ±(x+1) indicates\n//     the assignment to variable x+1.\n// OUT: OK\n#define TRUSTED_CHK_VALIDATE_SAT 'M'\n\n// Terminate.\n// IN: (none)\n// OUT: OK\n#define TRUSTED_CHK_TERMINATE 'T'\n\n// Checker answer that everything is OK\n#define TRUSTED_CHK_RES_ACCEPT 'A'\n// Checker answer that an error occurred\n#define TRUSTED_CHK_RES_ERROR 'E'\n","numLines":61,"startLine":1,"totalLines":61}}}
