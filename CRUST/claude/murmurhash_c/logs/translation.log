{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QqPrgGiZ2GUkBn9sThD6Ud","type":"tool_result","content":"1\t/**\n2\t * `murmurhash.c' - murmurhash\n3\t *\n4\t * copyright (c) 2014-2025 joseph werle <joseph.werle@gmail.com>\n5\t */\n6\t#include <stdlib.h>\n7\t#include <stdio.h>\n8\t#include <stdint.h>\n9\t#include \"murmurhash.h\"\n10\t\n11\t#if MURMURHASH_WANTS_HTOLE32\n12\t#define MURMURHASH_HAS_HTOLE32 1\n13\t#ifndef htole32\n14\tstatic uint32_t htole32 (uint32_t value) {\n15\t#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n16\t  value = (\n17\t    ((value & 0xFF000000) >> 24) |\n18\t    ((value & 0x00FF0000) >> 8)  |\n19\t    ((value & 0x0000FF00) << 8)  |\n20\t    ((value & 0x000000FF) << 24)\n21\t  );\n22\t#endif\n23\t  return value;\n24\t}\n25\t#endif\n26\t#endif\n27\t\n28\tuint32_t murmurhash (const char *key, uint32_t len, uint32_t seed) {\n29\t  uint32_t c1 = 0xcc9e2d51;\n30\t  uint32_t c2 = 0x1b873593;\n31\t  uint32_t r1 = 15;\n32\t  uint32_t r2 = 13;\n33\t  uint32_t m = 5;\n34\t  uint32_t n = 0xe6546b64;\n35\t  uint32_t h = 0;\n36\t  uint32_t k = 0;\n37\t  uint8_t *d = (uint8_t *) key; // 32 bit extract from `key'\n38\t  const uint32_t *chunks = NULL;\n39\t  const uint8_t *tail = NULL; // tail - last 8 bytes\n40\t  int i = 0;\n41\t  int l = len / 4; // chunk length\n42\t\n43\t  h = seed;\n44\t\n45\t  chunks = (const uint32_t *) (d + l * 4); // body\n46\t  tail = (const uint8_t *) (d + l * 4); // last 8 byte chunk of `key'\n47\t\n48\t  // for each 4 byte chunk of `key'\n49\t  for (i = -l; i != 0; ++i) {\n50\t    // next 4 byte chunk of `key'\n51\t  #if MURMURHASH_HAS_HTOLE32\n52\t    k = htole32(chunks[i]);\n53\t  #else\n54\t    k = chunks[i];\n55\t  #endif\n56\t\n57\t    // encode next 4 byte chunk of `key'\n58\t    k *= c1;\n59\t    k = (k << r1) | (k >> (32 - r1));\n60\t    k *= c2;\n61\t\n62\t    // append to hash\n63\t    h ^= k;\n64\t    h = (h << r2) | (h >> (32 - r2));\n65\t    h = h * m + n;\n66\t  }\n67\t\n68\t  k = 0;\