n}\n\npub fn print_strat(bm: &BM_BufferPool) {\n    match bm.strategy {\n        ReplacementStrategy::RsFifo => print!(\"FIFO\"),\n        ReplacementStrategy::RsLru => print!(\"LRU\"),\n        ReplacementStrategy::RsClock => print!(\"CLOCK\"),\n        ReplacementStrategy::RsLfu => print!(\"LFU\"),\n        ReplacementStrategy::RsLruK => print!(\"LRU-K\"),\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":124,"cache_read_input_tokens":102707,"cache_creation":{"ephemeral_5m_input_tokens":124,"ephemeral_1h_input_tokens":0},"output_tokens":9,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"662da62e-2323-4abc-9c04-58cc153a5e59","uuid":"0b3ea96a-a16a-40d2-a934-a5d5cdab5c6c"}
