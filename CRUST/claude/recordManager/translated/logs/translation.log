!a & b,\n        (ValueUnion::StringV(a), ValueUnion::StringV(b)) => a < b,\n        _ => false,\n    };\n    result.v = ValueUnion::BoolV(b);\n    if b { RC::Ok } else { RC::GeneralError }\n}\n\npub fn bool_not(input: &Value, result: &mut Value) -> RC {\n    if input.dt != DataType::DtBool {\n        return RC::RmBooleanExprArgIsNotBoolean;\n    }\n    result.dt = DataType::DtBool;\n    let b = match &input.v {\n        ValueUnion::BoolV(b) => !b,\n        _ => false,\n    };\n    result.v = ValueUnion::BoolV(b);\n    if b { RC::Ok } else { RC::GeneralError }\n}\n\npub fn bool_and(left: &Value, right: &Value, result: &mut Value) -> RC {\n    if left.dt != DataType::DtBool || right.dt != DataType::DtBool {\n        return RC::RmBooleanExprArgIsNotBoolean;\n    }\n    let b = match (&left.v, &right.v) {\n        (ValueUnion::BoolV(a), ValueUnion::BoolV(b)) => *a && *b,\n        _ => false,\n    };\n    result.dt = DataType::DtBool;\n    result.v = ValueUnion::BoolV(b);\n    if b { RC::Ok } else { RC::GeneralError }\n}\n\npub fn bool_or(left: &Value, right: &Value, result: &mut Value) -> RC {\n    if left.dt != DataType::DtBool || right.dt != DataType::DtBool {\n        return RC::RmBooleanExprArgIsNotBoolean;\n    }\n    let b = match (&left.v, &right.v) {\n        (ValueUnion::BoolV(a), ValueUnion::BoolV(b)) => *a || *b,\n        _ => false,\n    };\n    result.dt = DataType::DtBool;\n    result.v = ValueUnion::BoolV(b);\n    if b { RC::Ok } else { RC::GeneralError }\n}","originalFile":"use crate::{dberror::RC, tables::{Value, ValueUnion, DataType, Record, Schema}};\nuse crate::record_mgr::get_attr;\n\n#[derive(Debug, Clone)]\npub enum ExprType {\n    ExprOp,\n    ExprConst,\n    ExprAttrRef,\n}\n\n#[derive(Debug, Clone)]\npub struct Expr {\n    pub expr_type: ExprType,\n    pub expr: ExprUnion,\n}\n\n#[derive(Debug, Clone)]\npub enum ExprUnion {\n    Cons(Value),\n    AttrRef(i32),\n    Op(Box<Operator>),\n}\n\n#[derive(Debug, Clone)]\npub struct Operator {\n    pub op_type: OpType,\n    pub args: Vec<Expr>,\n}\n\n#[derive(Debug, Clone)]\npub enum OpType {\n    OpBoolAnd,\n    OpBoolOr,\n    OpBoolNot,\n    OpCompEqual,\n    OpCompSmaller,\n}\n\npub fn value_equals(left: &Value, right: &Value, result: &mut Value) -> RC {\n    if left.dt != right.dt {\n        return RC::RmCompareValueOfDifferentDatatype;\n    }\n    result.dt = DataType::DtBool;\n    let b = match (&left.v, &right.v) {\n        (ValueUnion::IntV(a), ValueUnion::IntV(b)) => a == b,\n        (ValueUnion::FloatV(a), ValueUnion::FloatV(b)) => a == b,\n        (ValueUnion::BoolV(a), ValueUnion::BoolV(b)) => a == b,\n        (ValueUnion::StringV(a), ValueUnion::StringV(b)) => a == b,\n        _ => false,\n    };\n    result.v = ValueUnion::BoolV(b);\n    RC::Ok\n}\n\npub fn value_smaller(left: &Value, right: &Value, result: &mut Value) -> RC {\n    if left.dt != right.dt {\n        return RC::RmCompareValueOfDifferentDatatype;\n    }\n    result.dt = DataType::DtBool;\n    let b = match (&left.v, &right.v) {\n        (ValueUnion::IntV(a), ValueUnion::IntV(b)) => a < b,\n        (ValueUnion::FloatV(a), ValueUnion::FloatV(b)) => a < b,\n        (ValueUnion::BoolV(a), ValueUnion::BoolV(b)) => !a & b,\n        (ValueUnion::StringV(a), ValueUnion::StringV(b)) => a < b,\n        _ => false,\n    };\n    result.v = ValueUnion::BoolV(b);\n    RC::Ok\n}\n\npub fn bool_not(input: &Value, result: &mut Value) -> RC {\n    if input.dt != DataType::DtBool {\n        return RC::RmBooleanExprArgIsNotBoolean;\n    }\n    result.dt = DataType::DtBool;\n    let b = match &input.v {\n        ValueUnion::BoolV(b) => !b,\n        _ => false,\n    };\n    result.v = ValueUnion::BoolV(b);\n    RC::Ok\n}\n\npub fn bool_and(left: &Value, right: &Value, result: &mut Value) -> RC {\n    if left.dt != DataType::DtBool || right.dt != DataType::DtBool {\n        return RC::RmBooleanExprArgIsNotBoolean;\n    }\n    let b = match (&left.v, &right.v) {\n        (ValueUnion::BoolV(a), ValueUnion::BoolV(b)) => *a && *b,\n        _ => false,\n    };\n    result.dt = DataType::DtBool;\n    result.v = ValueUnion::BoolV(b);\n    RC::Ok\n}\n\npub fn bool_or(left: &Value, right: &Value, result: &mut Value) -> RC {\n    if left.dt != DataType::DtBool || right.dt != DataType::DtBool {\n        return RC::RmBooleanExprArgIsNotBoolean;\n    }\n    let b = match (&left.v, &right.v) {\n        (ValueUnion::BoolV(a), ValueUnion::BoolV(b)) => *a || *b,\n        _ => false,\n    };\n    result.dt = DataType::DtBool;\n    result.v = ValueUnion::BoolV(b);\n    RC::Ok\n}\n\npub fn eval_expr(record: &Record, schema: &Schema, expr: &Expr, result: &mut Value) -> RC {\n    match &expr.expr {\n        ExprUnion::Op(op) => {\n            let two_args = !matches!(op.op_type, OpType::OpBoolNot);\n            let mut l_in = Value {\n                dt: DataType::DtInt,\n                v: ValueUnion::IntV(-1),\n            };\n            let rc = eval_expr(record, schema, &op.args[0], &mut l_in);\n            if rc != RC::Ok {\n                return rc;\n            }\n            let mut r_in = Value {\n                dt: DataType::DtInt,\n                v: ValueUnion::IntV(-1),\n            };\n            if two_args {\n                let rc = eval_expr(record, schema, &op.args[1], &mut r_in);\n                if rc != RC::Ok {\n                    return rc;\n                }\n            }\n            match op.op_type {\n                OpType::OpBoolNot => bool_not(&l_in, result),\n                OpType::OpBoolAnd => bool_and(&l_in, &r_in, result),\n                OpType::OpBoolOr => bool_or(&l_in, &r_in, result),\n                OpType::OpCompEqual => value_equals(&l_in, &r_in, result),\n                OpType::OpCompSmaller => value_smaller(&l_in, &r_in, result),\n            }\n        }\n        ExprUnion::Cons(v) => {\n            *result = v.clone();\n            RC::Ok\n        }\n        ExprUnion::AttrRef(attr_num) => get_attr(record, schema, *attr_num, result),\n    }\n}\n\npub fn free_expr(_expr: &mut Expr) -> RC {\n    // No-op: Rust handles cleanup automatically via Drop\n    RC::Ok\n}\n\npub fn free_val(_val: &mut Value) {\n    // No-op: Rust handles cleanup automatically via Drop\n}\n","structuredPatch":[{"oldStart":49,"oldLines":7,"newStart":49,"newLines":7,"lines":["         _ => false,","     };","     result.v = ValueUnion::BoolV(b);","-    RC::Ok","+    if b { RC::Ok } else { RC::GeneralError }"," }"," "," pub fn value_smaller(left: &Value, right: &Value, result: &mut Value) -> RC {"]},{"oldStart":65,"oldLines":7,"newStart":65,"newLines":7,"lines":["         _ => false,","     };","     result.v = ValueUnion::BoolV(b);","-    RC::Ok","+    if b { RC::Ok } else { RC::GeneralError }"," }"," "," pub fn bool_not(input: &Value, result: &mut Value) -> RC {"]},{"oldStart":78,"oldLines":7,"newStart":78,"newLines":7,"lines":["         _ => false,","     };","     result.v = ValueUnion::BoolV(b);","-    RC::Ok","+    if b { RC::Ok } else { RC::GeneralError }"," }"," "," pub fn bool_and(left: &Value, right: &Value, result: &mut Value) -> RC {"]},{"oldStart":91,"oldLines":7,"newStart":91,"newLines":7,"lines":["     };","     result.dt = DataType::DtBool;","     result.v = ValueUnion::BoolV(b);","-    RC::Ok","+    if b { RC::Ok } else { RC::GeneralError }"," }"," "," pub fn bool_or(left: &Value, right: &Value, result: &mut Value) -> RC {"]},{"oldStart":104,"oldLines":7,"newStart":104,"newLines":7,"lines":["     };","     result.dt = DataType::DtBool;","     result.v = ValueUnion::BoolV(b);","-    RC::Ok","+    if b { RC::Ok } else { RC::GeneralError }"," }"," "," pub fn eval_expr(record: &Record, schema: &Schema, expr: &Expr, result: &mut Value) -> RC {"]}],"userModified":false,"replaceAll":false}}
