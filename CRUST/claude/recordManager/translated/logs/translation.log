cord, schema, &op.args[0], &mut l_in);\n            if rc != RC::Ok {\n                return rc;\n            }\n            let mut r_in = Value {\n                dt: DataType::DtInt,\n                v: ValueUnion::IntV(-1),\n            };\n            if two_args {\n                let rc = eval_expr(record, schema, &op.args[1], &mut r_in);\n                if rc != RC::Ok {\n                    return rc;\n                }\n            }\n            match op.op_type {\n                OpType::OpBoolNot => bool_not(&l_in, result),\n                OpType::OpBoolAnd => bool_and(&l_in, &r_in, result),\n                OpType::OpBoolOr => bool_or(&l_in, &r_in, result),\n                OpType::OpCompEqual => value_equals(&l_in, &r_in, result),\n                OpType::OpCompSmaller => value_smaller(&l_in, &r_in, result),\n            }\n        }\n        ExprUnion::Cons(v) => {\n            *result = v.clone();\n            RC::Ok\n        }\n        ExprUnion::AttrRef(attr_num) => get_attr(record, schema, *attr_num, result),\n    }\n}\n\npub fn free_expr(_expr: &mut Expr) -> RC {\n    // No-op: Rust handles cleanup automatically via Drop\n    RC::Ok\n}\n\npub fn free_val(_val: &mut Value) {\n    // No-op: Rust handles cleanup automatically via Drop\n}\n","structuredPatch":[{"oldStart":1,"oldLines":55,"newStart":1,"newLines":155,"lines":["-use crate::{dberror::RC, tables::{Value, Record, Schema}};","+use crate::{dberror::RC, tables::{Value, ValueUnion, DataType, Record, Schema}};","+use crate::record_mgr::get_attr;","+"," #[derive(Debug, Clone)]"," pub enum ExprType {","-ExprOp,","-ExprConst,","-ExprAttrRef,","+    ExprOp,","+    ExprConst,","+    ExprAttrRef,"," }","+"," #[derive(Debug, Clone)]"," pub struct Expr {","-pub expr_type: ExprType,","-pub expr: ExprUnion,","+    pub expr_type: ExprType,","+    pub expr: ExprUnion,"," }","+"," #[derive(Debug, Clone)]"," pub enum ExprUnion {","-Cons(Value),","-AttrRef(i32),","-Op(Box<Operator>),","+    Cons(Value),",