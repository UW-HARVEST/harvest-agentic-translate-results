C::Ok);\n31\t    assert_ne!(expr::value_equals(&rm_serializer::string_to_value(\"sHello Worl\"), &rm_serializer::string_to_value(\"sHello Wor\"), &mut result), dberror::RC::Ok);\n32\t    // smaller\n33\t    assert_eq!(expr::value_smaller(&rm_serializer::string_to_value(\"i3\"), &rm_serializer::string_to_value(\"i10\"), &mut result), dberror::RC::Ok);\n34\t    assert_eq!(expr::value_smaller(&rm_serializer::string_to_value(\"f5.0\"), &rm_serializer::string_to_value(\"f6.5\"), &mut result), dberror::RC::Ok);\n35\t    // boolean\n36\t    assert_eq!(expr::bool_and(&rm_serializer::string_to_value(\"bt\"), &rm_serializer::string_to_value(\"bt\"), &mut result), dberror::RC::Ok);\n37\t    assert_ne!(expr::bool_and(&rm_serializer::string_to_value(\"bt\"), &rm_serializer::string_to_value(\"bf\"), &mut result), dberror::RC::Ok);\n38\t\n39\t    assert_eq!(expr::bool_or(&rm_serializer::string_to_value(\"bt\"), &rm_serializer::string_to_value(\"bf\"), &mut result), dberror::RC::Ok);\n40\t    assert_ne!(expr::bool_or(&rm_serializer::string_to_value(\"bf\"), &rm_serializer::string_to_value(\"bf\"), &mut result), dberror::RC::Ok);\n41\t\n42\t    assert_eq!(expr::bool_not(&rm_serializer::string_to_value(\"bf\"), &mut result), dberror::RC::Ok);\n43\t\n44\t}\n45\t\n46\t#[test]\n47\tfn test_expressions() {\n48\t    let mut res = tables::Value {\n49\t        dt: tables::DataType::DtInt, // Placeholder, will be overwritten\n50\t        v: tables::ValueUnion::IntV(0),\n51\t    };\n52\t\n53\t    println!(\"Running test: test complex expressions\");\n54\t\n55\t    // Creating a constant value expression (10)\n56\t    let l = expr::Expr {\n57\t        expr_type: expr::ExprType::ExprConst,\n58\t        expr: expr::ExprUnion::Cons(rm_serializer::string_to_value(\"i10\")),\n59\t    };\n60\t    expr::eval_expr(&tables::Record { id: tables::RID { page: 0, slot: 0 }, data: String::new() }, &tables::Schema {\n61\t        num_attr: 0,\n62\t        attr_names: vec![],\n63\t        data_types: vec![],\n