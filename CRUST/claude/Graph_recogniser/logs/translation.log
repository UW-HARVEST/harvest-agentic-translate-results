ze as f32) > LOAD_FACTOR {\n            let old_arr = std::mem::take(&mut self.arr);\n            self.max_size *= 2;\n            self.arr = (0..self.max_size)\n                .map(|_| OpenEntry { key: None, data: None })\n                .collect();\n            for entry in old_arr.into_iter() {\n                if let Some(k) = entry.key {\n                    let idx = self.query(k);\n                    self.arr[idx] = entry;\n                }\n            }\n        }\n\n        let idx = self.query(key);\n        self.arr[idx] = OpenEntry { key: Some(key), data: Some(data) };\n    }\n    pub fn find(&self, key: &str) -> Option<&'static str> {\n        let idx = self.query(key);\n        self.arr[idx].data\n    }\n    pub fn free_open_hash_table(&mut self) {\n        self.arr.clear();\n        self.cur_size = 0;\n        self.max_size = 0;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2479,"cache_read_input_tokens":34683,"cache_creation":{"ephemeral_5m_input_tokens":2479,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"796fd2c7-b9da-4845-afcb-f2b229b7b9a3","uuid":"c61d8004-a9a3-43b3-b650-b96bfd4b03e3"}
