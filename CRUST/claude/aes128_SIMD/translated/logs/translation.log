\n}\n\n\n__attribute__((always_inline))\ninline void InvShift(uint8_t state[4][Nb]) {\n    for (int i = 1; i < 4; i++) {\n        uint8_t temp[Nb];\n        for (int j = 0; j < Nb; j++) {\n            temp[j] = state[i][(j - i + Nb) % Nb];\n        }\n\t\tmemcpy(state[i], temp, Nb);\t\n    }\n\t_mm_sfence();\n}\n","numLines":35,"startLine":1,"totalLines":35}}}
