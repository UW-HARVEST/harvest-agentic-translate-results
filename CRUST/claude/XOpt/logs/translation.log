\n467\t\n468\tstatic void _xopt_default_callback(const char *value, void *data,\n469\t\t\tconst xoptOption *option, bool longArg, const char **err) {\n470\t\tvoid *target;\n471\t\tchar *parsePtr = 0;\n472\t\n473\t\t/* is a value specified? */\n474\t\tif ((!value || !strlen(value)) && !(option->options & XOPT_TYPE_BOOL)) {\n475\t\t\t/* we reach this point when they specified an optional, non-boolean\n476\t\t\t\t option but didn't specify a custom handler (therefore, it's not\n477\t\t\t\t optional).\n478\t\n479\t\t\t\t to fix, just remove the optional flag or specify a callback to handle\n480\t\t\t\t it yourself.\n481\t\t\t\t */\n482\t\t\treturn;\n483\t\t}\n484\t\n485\t\t/* get location */\n486\t\ttarget = ((char*) data) + option->offset;\n487\t\n488\t\t/* switch on the type */\n489\t\tswitch (option->options & 0x3F) {\n490\t\tcase XOPT_TYPE_BOOL:\n491\t\t\t/* booleans are special in that they won't have an argument passed\n492\t\t\t\t into this callback */\n493\t\t\t*((_Bool*) target) = true;\n494\t\t\tbreak;\n495\t\tcase XOPT_TYPE_STRING:\n496\t\t\t/* lifetime here works out fine; argv can usually be assumed static-like\n497\t\t\t\t in nature */\n498\t\t\t*((const char**) target) = value;\n499\t\t\tbreak;\n500\t\tcase XOPT_TYPE_INT:\n501\t\t\t*((int*) target) = (int) strtol(value, &parsePtr, 0);\n502\t\t\tbreak;\n503\t\tcase XOPT_TYPE_LONG:\n504\t\t\t*((long*) target) = strtol(value, &parsePtr, 0);\n505\t\t\tbreak;\n506\t\tcase XOPT_TYPE_FLOAT:\n507\t\t\t*((float*) target) = (float) strtod(value, &parsePtr);\n508\t\t\tbreak;\n509\t\tcase XOPT_TYPE_DOUBLE:\n510\t\t\t*((double*) target) = strtod(value, &parsePtr);\n511\t\t\tbreak;\n512\t\tdefault: /* something wonky, or the implementation specifies two types */\n513\t\t\tfprintf(stderr, \"warning: XOpt argument type invalid: %ld\\n\",\n514\t\t\t\toption->options & 0x2F);\n515\t\t\tbreak;\n516\t\t}\n517\t\n518\t\t/* check that our parsing functions worked */\n519\t\tif (parsePtr && *parsePtr) {\n520\t\t\tif (longArg) {