n41\t  struct ParseState state = (struct ParseState){NULL, 0};\n42\t  next(source, &state);\n43\t  TEST_ASSERT(state.token->kind == TK_LPAREN);\n44\t  next(source, &state);\n45\t  TEST_ASSERT(state.token->kind == TK_DIGIT);\n46\t  TEST_ASSERT(state.token->val == 1);\n47\t  next(source, &state);\n48\t  TEST_ASSERT(state.token->kind == TK_RPAREN);\n49\t}\n50\t\n51\tvoid next_ifAndSet() {\n52\t  char *source = \"(if (set a 1) (set b 2) (set c 3))\";\n53\t  struct ParseState state = (struct ParseState){NULL, 0};\n54\t  next(source, &state);\n55\t  TEST_ASSERT(state.token->kind == TK_LPAREN);\n56\t  next(source, &state);\n57\t  TEST_ASSERT(state.token->kind == TK_SYMBOL);\n58\t  TEST_ASSERT(strcmp(state.token->str, \"if\") == 0);\n59\t  next(source, &state);\n60\t  TEST_ASSERT(state.token->kind == TK_LPAREN);\n61\t  next(source, &state);\n62\t  TEST_ASSERT(state.token->kind == TK_SYMBOL);\n63\t  TEST_ASSERT(strcmp(state.token->str, \"set\") == 0);\n64\t  next(source, &state);\n65\t  TEST_ASSERT(state.token->kind == TK_SYMBOL);\n66\t  TEST_ASSERT(strcmp(state.token->str, \"a\") == 0);\n67\t  next(source, &state);\n68\t  TEST_ASSERT(state.token->kind == TK_DIGIT);\n69\t  TEST_ASSERT(state.token->val == 1);\n70\t  next(source, &state);\n71\t  TEST_ASSERT(state.token->kind == TK_RPAREN);\n72\t  next(source, &state);\n73\t  TEST_ASSERT(state.token->kind == TK_LPAREN);\n74\t  next(source, &state);\n75\t  TEST_ASSERT(state.token->kind == TK_SYMBOL);\n76\t  TEST_ASSERT(strcmp(state.token->str, \"set\") == 0);\n77\t  next(source, &state);\n78\t  TEST_ASSERT(state.token->kind == TK_SYMBOL);\n79\t  TEST_ASSERT(strcmp(state.token->str, \"b\") == 0);\n80\t  next(source, &state);\n81\t  TEST_ASSERT(state.token->kind == TK_DIGIT);\n82\t  TEST_ASSERT(state.token->val == 2);\n83\t  next(source, &state);\n84\t  TEST_ASSERT(state.token->kind == TK_RPAREN);\n85\t  next(source, &state);\n86\t  TEST_ASSERT(state.token->kind == TK_LPAREN);\n87\t  next(source, &state);\n88\t  TEST_ASSERT(state.