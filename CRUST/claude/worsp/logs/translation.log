ruct SymbolNode));\n214\t  expression->data.symbol->symbol_name = state->token->str;\n215\t  next(source, state);\n216\t}\n217\t\n218\tvoid parseLiteralExpression(char *source, struct ParseState *state,\n219\t                            struct ExpressionNode *expression) {\n220\t  if (match(state, TK_DIGIT)) {\n221\t    expression->type = EXP_LITERAL;\n222\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n223\t    expression->data.literal->type = LIT_INTERGER;\n224\t    expression->data.literal->int_value = state->token->val;\n225\t    next(source, state);\n226\t  } else if (match(state, TK_STRING)) {\n227\t    expression->type = EXP_LITERAL;\n228\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n229\t    expression->data.literal->type = LIT_STRING;\n230\t    expression->data.literal->string_value = state->token->str;\n231\t    next(source, state);\n232\t  } else if (match(state, TK_TRUE)) {\n233\t    expression->type = EXP_LITERAL;\n234\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n235\t    expression->data.literal->type = LIT_BOOLEAN;\n236\t    expression->data.literal->boolean_value = true;\n237\t    next(source, state);\n238\t  } else if (match(state, TK_FALSE)) {\n239\t    expression->type = EXP_LITERAL;\n240\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n241\t    expression->data.literal->type = LIT_BOOLEAN;\n242\t    expression->data.literal->boolean_value = false;\n243\t    next(source, state);\n244\t  } else {\n245\t    printf(\"Unexpected token: %s\\n\", state->token->str);\n246\t    exit(1);\n247\t  }\n248\t}\n249\t\n250\tvoid parseExpression(char *source, struct ParseState *state,\n251\t                     struct ExpressionNode *expression) {\n252\t  if (match(state, TK_LPAREN)) {\n253\t    parseSymbolicExpression(source, state, expression);\n254\t  } else if (match(state, TK_QUOTE)) {\n255\t    parseListExpression(source, state, expression);\n256\t  } else if (match(state, TK_SYMBOL)) {\n257\t    parseSymbolExpression(source, state, expression);\n258\t  } else if (match(state, TK_DIGIT) || match(state, TK_STRING) ||\n259\t             match(state, TK_TRUE) || match(state, TK_FALSE)) {\n260\t    parseLiteralExpression(source, state, expression);\n261\t  } else {\n262\t    printf(\"Unexpected token: %s\\n\", state->token->str);\n263\t    exit(1);\n264\t  }\n265\t}\n266\t\n267\tvoid appendExpressionToProgram(struct ProgramNode *program,\n268\t                               struct ExpressionNode *expression) {\n269\t  struct ExpressionList *expressions = malloc(sizeof(struct ExpressionList));\n270\t  expressions->expression = expression;\n271\t  expressions->next = NULL;\n272\t  if (program->expressions == NULL) {\n273\t    program->expressions = expressions;\n274\t    return;\n275\t  }\n276\t  struct ExpressionList *current = program->expressions;\n277\t  while (current->next != NULL) {\n278\t    current = current->next;\n279\t  }\n280\t  current->next = expressions;\n281\t}\n282\t\n283\tvoid parseProgram(char *source, struct ParseState *state,\n284\t                  struct ParseResult *result) {\n285\t  // Set first token\n286\t  next(source, state);\n287\t  struct ProgramNode *program = malloc(sizeof(struct ProgramNode));\n288\t  program->expressions = NULL;\n289\t\n290\t  result->program = program;\n291\t\n292\t  while (!match(state, TK_EOF)) {\n293\t    struct ExpressionNode *expression = malloc(sizeof(struct ExpressionNode));\n294\t    parseExpression(source, state, expression);\n295\t    appendExpressionToProgram(program, expression);\n296\t  }\n297\t}\n298\t\n299\tvoid parse(char *source, struct ParseState *state, struct ParseResult *result) {\n300\t  parseProgram(source, state, result);\n301\t}\n302\t\n303\t// =================================================\n304\t//   garbage collector\n305\t// =================================================\n306\t\n307\tvoid initializeObjectStack(struct ObjectStack *stack) { stack->top = -1; }\n308\t\n309\tint isFullObjectStack(struct ObjectStack *stack) {\n310\t  return stack->top == OBJECT_NUMBER;\n311\t}\n312\t\n313\tint isEmptyObjectStack(struct ObjectStack *stack) { return stack->top == -1; }\n314\t\n315\tvoid pushObjectStack(struct ObjectStack *stack, struct Object *obj) {\n316\t  if (isFullObjectStack(stack)) {\n317\t    printf(\"Object stack is full.\\n\");\n318\t    exit(1);\n319\t  }\n320\t  stack->top++;\n321\t  stack->objects[stack->top] = obj;\n322\t}\n323\t\n324\tstruct Object *popObjectStack(struct ObjectStack *stack) {\n325\t  if (isEmptyObjectStack(stack)) {\n326\t    printf(\"Object stack is empty.\\n\");\n327\t    exit(1);\n328\t  }\n329\t  struct Object *obj = stack->objects[stack->top];\n330\t  stack->top--;\n331\t  return obj;\n332\t}\n333\t\n334\tstruct AllocatorContext *initAllocator() {\n335\t  struct AllocatorContext *context = malloc(sizeof(struct AllocatorContext));\n336\t\n337\t  context->memory_pool = (struct Object *)malloc(MEMORY_SIZE);\n338\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n339\t    context->free_bitmap[i] = 0;\n340\t  }\n341\t\n342\t  context->gc_less_mode = 0;\n343\t\n344\t  struct ObjectStack *stack = malloc(sizeof(struct ObjectStack));\n345\t  initializeObjectStack(stack);\n346\t  context->stack = stack;\n347\t\n348\t  return context;\n349\t}\n350\t\n351\tvoid freeObject(struct AllocatorContext *context, struct Object *object) {\n352\t  int index = object - context->memory_pool;\n353\t  context->free_bitmap[index] = 0;\n354\t}\n355\t\n356\tvoid sweep(struct AllocatorContext *context) {\n357\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n358\t    if (context->free_bitmap[i] == 1) {\n359\t      struct Object *obj = &context->memory_pool[i];\n360\t      if (obj->marked) {\n361\t        obj->marked = false;\n362\t      } else {\n363\t        freeObject(context, obj);\n364\t      }\n365\t    }\n366\t  }\n367\t}\n368\t\n369\tint isLastConsCell(struct ConsCell *conscell) {\n370\t  return conscell->cdr->type == OBJ_NIL;\n371\t}\n372\t\n373\tvoid mark(struct Object *obj) {\n374\t  if (obj->marked) {\n375\t    return;\n376\t  }\n377\t  obj->marked = true;\n378\t  if (obj->type == OBJ_LIST) {\n379\t    struct Object *current = obj;\n380\t    while (1) {\n381\t      mark(current);\n382\t      // evaluating list object can be nil\n383\t      if (current->list_value == NULL) {\n384\t        break;\n385\t      }\n386\t      mark(current->list_value->car);\n387\t      if (isLastConsCell(current->list_value)) {\n388\t        break;\n389\t      }\n390\t      current = current->list_value->cdr;\n391\t    }\n392\t  }\n393\t}\n394\t\n395\tvoid markAll(struct Env *env, struct AllocatorContext *context) {\n396\t  // mark objects in stack\n397\t  for (int i = 0; i <= context->stack->top; i++) {\n398\t    struct Object *obj = context->stack->objects[i];\n399\t    mark(obj);\n400\t  }\n401\t\n402\t  int i = 0;\n403\t  while (env->bindings[i].symbol_name != NULL) {\n404\t    struct Object *obj = env->bindings[i].value;\n405\t    mark(obj);\n406\t    i++;\n407\t  }\n408\t  if (env->parent != NULL) {\n409\t    markAll(env->parent, context);\n410\t  }\n411\t}\n412\t\n413\tvoid gc(struct AllocatorContext *context, struct Env *env) {\n414\t  markAll(env, context);\n415\t  sweep(context);\n416\t}\n417\t\n418\tstruct Object *allocate(struct AllocatorContext *context, struct Env *env) {\n419\t  size_t object_size = sizeof(struct Object);\n420\t  if (context->gc_less_mode) {\n421\t    return malloc(object_size);\n422\t  }\n423\t\n424\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n425\t    if (context->free_bitmap[i] == 0) {\n426\t      context->free_bitmap[i] = 1; // Mark the block as used\n427\t      return &context->memory_pool[i];\n428\t    }\n429\t  }\n430\t\n431\t  gc(context, env);\n432\t\n433\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n434\t    if (context->free_bitmap[i] == 0) {\n435\t      context->free_bitmap[i] = 1; // Mark the block as used\n436\t      return &context->memory_pool[i];\n437\t    }\n438\t  }\n439\t\n440\t  fprintf(stderr, \"Out of Memory\\n\");\n441\t  exit(1);\n442\t}\n443\t\n444\t// =================================================\n445\t//   defined functions\n446\t// =================================================\n447\t\n448\tbool boolVal(struct Object *obj) {\n449\t  if (obj->type == OBJ_BOOL) {\n450\t    return obj->bool_value;\n451\t  } else if (obj->type == OBJ_NIL) {\n452\t    return false;\n453\t  } else {\n454\t    return true;\n455\t  }\n456\t}\n457\t\n458\tint eq(struct Object *op1, struct Object *op2) {\n459\t  if (op1->type != op2->type) {\n460\t    return 0;\n461\t  } else {\n462\t    if (op1->type == OBJ_INTEGER) {\n463\t      return op1->int_value == op2->int_value;\n464\t    } else if (op1->type == OBJ_STRING) {\n465\t      return strcmp(op1->string_value, op2->string_value) == 0;\n466\t    } else if (op1->type == OBJ_BOOL) {\n467\t      return op1->bool_value == op2->bool_value;\n468\t    } else if (op1->type == OBJ_LIST) {\n469\t      return op1->list_value == op2->list_value;\n470\t    } else if (op1->type == OBJ_NIL) {\n471\t      return 1;\n472\t    }\n473\t  }\n474\t  return 0;\n475\t}\n476\t\n477\tchar *stringifyObject(struct Object *obj) {\n478\t  if (obj->type == OBJ_INTEGER) {\n479\t    if (obj->int_value == 0) {\n480\t      char *str = (char *)malloc(2 * sizeof(char));\n481\t      strncpy(str, \"0\", 2);\n482\t      return str;\n483\t    }\n484\t    int digits = (int)log10(obj->int_value) + 1;\n485\t    char *str = (char *)malloc((digits + 1) * sizeof(char));\n486\t    sprintf(str, \"%d\", obj->int_value);\n487\t    return str;\n488\t  } else if (obj->type == OBJ_STRING) {\n489\t    char *str = (char *)malloc((strlen(obj->string_value) + 1) * sizeof(char));\n490\t    strncpy(str, obj->string_value, strlen(obj->string_value) + 1);\n491\t    return str;\n492\t  } else if (obj->type == OBJ_BOOL) {\n493\t    char *str = (char *)malloc(1 * sizeof(char));\n494\t    if (obj->bool_value) {\n495\t      strncpy(str, \"T\", 2);\n496\t    } else {\n497\t      strncpy(str, \"F\", 2);\n498\t    }\n499\t    return str;\n500\t  } else if (obj->type == OBJ_LIST) {\n501\t    int length = 2; // '(' and ')'\n502\t    char *str = (char *)malloc(length + 1 * sizeof(char));\n503\t    memset(str, 0, length + 1);\n504\t    str[0] = '(';\n505\t    struct ConsCell *current = obj->list_value;\n506\t    while (1) {\n507\t      char *serialized = stringifyObject(current->car);\n508\t      length += strlen(serialized);\n509\t      str = realloc(str, length + 1);\n510\t      strncat(str, serialized, strlen(serialized));\n511\t      if (isLastConsCell(current)) {\n512\t        break;\n513\t      } else {\n514\t        length += 1; // \" \"\n515\t        str = realloc(str, length + 1);\n516\t        strncat(str, \" \", 1);\n517\t      }\n518\t      current = current->cdr->list_value;\n519\t    }\n520\t    str[length - 1] = ')';\n521\t    str[length] = '\\0';\n522\t    return str;\n523\t  } else if (obj->type == OBJ_NIL) {\n524\t    char *str = (char *)malloc(4 * sizeof(char));\n525\t    strncpy(str, \"nil\", 4);\n526\t    return str;\n527\t  } else if (obj->type == OBJ_FUNCTION) {\n528\t    char *str = (char *)malloc(9 * sizeof(char));\n529\t    strncpy(str, \"<function>\", 10);\n530\t    return str;\n531\t  } else {\n532\t    printf(\"Unexpected object type: %d\\n\", obj->type);\n533\t    exit(1);\n534\t  }\n535\t}\n536\t\n537\tvoid definedFunctionAdd(struct Object *op1, struct Object *op2,\n538\t                        struct Object *evaluated) {\n539\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n540\t    evaluated->type = OBJ_INTEGER;\n541\t    evaluated->int_value = op1->int_value + op2->int_value;\n542\t  } else if (op1->type == OBJ_STRING && op2->type == OBJ_STRING) {\n543\t    evaluated->type = OBJ_STRING;\n544\t    evaluated->string_value =\n545\t        malloc((strlen(op1->string_value) + strlen(op2->string_value) + 1) *\n546\t               sizeof(char));\n547\t    strncpy(evaluated->string_value, op1->string_value,\n548\t            strlen(op1->string_value) + 1);\n549\t    strcat(evaluated->string_value, op2->string_value);\n550\t  } else {\n551\t    printf(\"Type error: operands for + must be integers or strings.\\n\");\n552\t    exit(1);\n553\t  }\n554\t}\n555\t\n556\tvoid definedFunctionSub(struct Object *op1, struct Object *op2,\n557\t                        struct Object *evaluated) {\n558\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n559\t    evaluated->type = OBJ_INTEGER;\n560\t    evaluated->int_value = op1->int_value - op2->int_value;\n561\t  } else {\n562\t    printf(\"Type error: operands for - must be integers.\\n\");\n563\t    exit(1);\n564\t  }\n565\t}\n566\t\n567\tvoid definedFunctionMul(struct Object *op1, struct Object *op2,\n568\t                        struct Object *evaluated) {\n569\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n570\t    evaluated->type = OBJ_INTEGER;\n571\t    evaluated->int_value = op1->int_value * op2->int_value;\n572\t  } else {\n573\t    printf(\"Type error: operands for * must be integers.\\n\");\n574\t    exit(1);\n575\t  }\n576\t}\n577\t\n578\tvoid definedFunctionDiv(struct Object *op1, struct Object *op2,\n579\t                        struct Object *evaluated) {\n580\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n581\t    evaluated->type = OBJ_INTEGER;\n582\t    evaluated->int_value = op1->int_value / op2->int_value;\n583\t  } else {\n584\t    printf(\"Type error: operands for / must be integers.\\n\");\n585\t    exit(1);\n586\t  }\n587\t}\n588\t\n589\tvoid definedFunctionMod(struct Object *op1, struct Object *op2,\n590\t                        struct Object *evaluated) {\n591\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n592\t    evaluated->type = OBJ_INTEGER;\n593\t    evaluated->int_value = op1->int_value % op2->int_value;\n594\t  } else {\n595\t    printf(\"Type error: operands for % must be integers.\\n\");\n596\t    exit(1);\n597\t  }\n598\t}\n599\t\n600\tvoid definedFunctionOr(struct Object *op1, struct Object *op2,\n601\t                       struct Object *evaluated) {\n602\t  if (boolVal(op1) || boolVal(op2)) {\n603\t    evaluated->type = OBJ_BOOL;\n604\t    evaluated->bool_value = 1;\n605\t  } else {\n606\t    evaluated->type = OBJ_BOOL;\n607\t    evaluated->bool_value = 0;\n608\t  }\n609\t}\n610\t\n611\tvoid definedFunctionAnd(struct Object *op1, struct Object *op2,\n612\t                        struct Object *evaluated) {\n613\t  if (boolVal(op1) && boolVal(op2)) {\n614\t    evaluated->type = OBJ_BOOL;\n615\t    evaluated->bool_value = 1;\n616\t  } else {\n617\t    evaluated->type = OBJ_BOOL;\n618\t    evaluated->bool_value = 0;\n619\t  }\n620\t}\n621\t\n622\tvoid definedFunctionLt(struct Object *op1, struct Object *op2,\n623\t                       struct Object *evaluated) {\n624\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n625\t    if (op1->int_value < op2->int_value) {\n626\t      evaluated->type = OBJ_BOOL;\n627\t      evaluated->bool_value = 1;\n628\t    } else {\n629\t      evaluated->type = OBJ_BOOL;\n630\t      evaluated->bool_value = 0;\n631\t    }\n632\t  } else {\n633\t    printf(\"Type error: operands for < must be integers.\\n\");\n634\t    exit(1);\n635\t  }\n636\t}\n637\t\n638\tvoid definedFunctionGt(struct Object *op1, struct Object *op2,\n639\t                       struct Object *evaluated) {\n640\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n641\t    if (op1->int_value > op2->int_value) {\n642\t      evaluated->type = OBJ_BOOL;\n643\t      evaluated->bool_value = 1;\n644\t    } else {\n645\t      evaluated->type = OBJ_BOOL;\n646\t      evaluated->bool_value = 0;\n647\t    }\n648\t  } else {\n649\t    printf(\"Type error: operands for < must be integers.\\n\");\n650\t    exit(1);\n651\t  }\n652\t}\n653\t\n654\tvoid definedFunctionEq(struct Object *op1, struct Object *op2,\n655\t                       struct Object *evaluated) {\n656\t  if (eq(op1, op2)) {\n657\t    evaluated->type = OBJ_BOOL;\n658\t    evaluated->bool_value = 1;\n659\t  } else {\n660\t    evaluated->type = OBJ_BOOL;\n661\t    evaluated->bool_value = 0;\n662\t  }\n663\t}\n664\t\n665\tvoid definedFunctionCar(struct Object *op, struct Object *evaluated) {\n666\t  if (op->type != OBJ_LIST) {\n667\t    printf(\"Type error: car operand must be list.\\n\");\n668\t    exit(1);\n669\t  }\n670\t  *evaluated = *(op->list_value->car);\n671\t}\n672\t\n673\tvoid definedFunctionCdr(struct Object *op, struct Object *evaluated) {\n674\t  if (op->type != OBJ_LIST) {\n675\t    printf(\"Type error: cdr operand must be list.\\n\");\n676\t    exit(1);\n677\t  }\n678\t  *evaluated = *op->list_value->cdr;\n679\t}\n680\t\n681\tvoid definedFunctionCons(struct Object *op1, struct Object *op2,\n682\t                         struct Object *evaluated, struct Env *env,\n683\t                         struct AllocatorContext *context) {\n684\t  evaluated->type = OBJ_LIST;\n685\t  evaluated->list_value = malloc(sizeof(struct ConsCell));\n686\t  evaluated->list_value->car = op1;\n687\t\n688\t  if (op2->type == OBJ_LIST) {\n689\t    evaluated->list_value->type = CONSCELL_TYPE_CELL;\n690\t    evaluated->list_value->cdr = op2;\n691\t  } else if (op2->type == OBJ_NIL) {\n692\t    evaluated->list_value->cdr = op2;\n693\t  } else {\n694\t    struct Object *cdr_obj = allocate(context, env);\n695\t    cdr_obj->type = OBJ_LIST;\n696\t    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n697\t    new_conscell->car = op2;\n698\t    new_conscell->type = CONSCELL_TYPE_CELL;\n699\t    new_conscell->cdr = allocate(context, env);\n700\t    new_conscell->cdr->type = OBJ_NIL;\n701\t    cdr_obj->list_value = new_conscell;\n702\t    evaluated->list_value->cdr = cdr_obj;\n703\t  }\n704\t}\n705\t\n706\tvoid definedFunctionNot(struct Object *op, struct Object *evaluated) {\n707\t  if (op->type != OBJ_BOOL) {\n708\t    printf(\"Type error: not operand must be boolean.\\n\");\n709\t    exit(1);\n710\t  }\n711\t  evaluated->type = OBJ_BOOL;\n712\t  if (op->bool_value) {\n713\t    evaluated->bool_value = 0;\n714\t  } else {\n715\t    evaluated->bool_value = 1;\n716\t  }\n717\t}\n718\t\n719\tvoid definedFunctionSplit(struct Object *op1, struct Object *op2,\n720\t                          struct Object *evaluated, struct Env *env,\n721\t                          struct AllocatorContext *context) {\n722\t  if (op1->type != OBJ_STRING) {\n723\t    printf(\"Type error: split first operand must be string.\\n\");\n724\t    exit(1);\n725\t  }\n726\t  if (op2->type != OBJ_STRING) {\n727\t    printf(\"Type error: split second operand must be string.\\n\");\n728\t    exit(1);\n729\t  }\n730\t\n731\t  // when op2 is \"\", return list of characters\n732\t  if (strcmp(op2->string_value, \"\") == 0) {\n733\t    evaluated->type = OBJ_LIST;\n734\t    evaluated->list_value = malloc(sizeof(struct ConsCell));\n735\t    evaluated->list_value->type = CONSCELL_TYPE_CELL;\n736\t    evaluated->list_value->car = allocate(context, env);\n737\t    evaluated->list_value->car->type = OBJ_STRING;\n738\t    evaluated->list_value->car->string_value = malloc(sizeof(char));\n739\t    evaluated->list_value->car->string_value[0] = op1->string_value[0];\n740\t    evaluated->list_value->cdr = allocate(context, env);\n741\t    evaluated->list_value->cdr->type = OBJ_NIL;\n742\t    struct ConsCell *current = evaluated->list_value;\n743\t    for (unsigned long i = 1; i < strlen(op1->string_value); i++) {\n744\t      struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n745\t      new_conscell->type = CONSCELL_TYPE_CELL;\n746\t      new_conscell->car = allocate(context, env);\n747\t      new_conscell->car->type = OBJ_STRING;\n748\t      new_conscell->car->string_value = malloc(sizeof(char));\n749\t      new_conscell->car->string_value[0] = op1->string_value[i];\n750\t      new_conscell->cdr = allocate(context, env);\n751\t      new_conscell->cdr->type = OBJ_NIL;\n752\t      current->cdr = allocate(context, env);\n753\t      current->cdr->type = OBJ_LIST;\n754\t      current->cdr->list_value = new_conscell;\n755\t      current = current->cdr->list_value;\n756\t    }\n757\t    return;\n758\t  }\n759\t\n760\t  // split op1 string by op2 string and return list of strings\n761\t  evaluated->type = OBJ_LIST;\n762\t  evaluated->list_value = malloc(sizeof(struct ConsCell));\n763\t  evaluated->list_value->type = CONSCELL_TYPE_CELL;\n764\t  evaluated->list_value->car = allocate(context, env);\n765\t  evaluated->list_value->car->type = OBJ_STRING;\n766\t  evaluated->list_value->car->string_value =\n767\t      strtok(op1->string_value, op2->string_value);\n768\t  evaluated->list_value->cdr = allocate(context, env);\n769\t  evaluated->list_value->cdr->type = OBJ_NIL;\n770\t  struct ConsCell *current = evaluated->list_value;\n771\t  while (1) {\n772\t    char *token = strtok(NULL, op2->string_value);\n773\t    if (token == NULL) {\n774\t      break;\n775\t    }\n776\t    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n777\t    new_conscell->type = CONSCELL_TYPE_CELL;\n778\t    new_conscell->car = allocate(context, env);\n779\t    new_conscell->car->type = OBJ_STRING;\n780\t    new_conscell->car->string_value = token;\n781\t    new_conscell->cdr = allocate(context, env);\n782\t    new_conscell->cdr->type = OBJ_NIL;\n783\t    current->cdr = allocate(context, env);\n784\t    current->cdr->type = OBJ_LIST;\n785\t    current->cdr->list_value = new_conscell;\n786\t    current = current->cdr->list_value;\n787\t  }\n788\t}\n789\t\n790\tvoid definedFunctionListRef(struct Object *op1, struct Object *op2,\n791\t                            struct Object *evaluated) {\n792\t  if (op1->type != OBJ_LIST) {\n793\t    printf(\"Type error: list-ref first operand must be list.\\n\");\n794\t    exit(1);\n795\t  }\n796\t  if (op2->type != OBJ_INTEGER) {\n797\t    printf(\"Type error: list-ref second operand must be integer.\\n\");\n798\t    exit(1);\n799\t  }\n800\t  int index = op2->int_value;\n801\t  struct ConsCell *current = op1->list_value;\n802\t  for (int i = 0; i < index; i++) {\n803\t    if (current->cdr->type == OBJ_NIL) {\n804\t      printf(\"Index out of range.\\n\");\n805\t      exit(1);\n806\t    }\n807\t    current = current->cdr->list_value;\n808\t  }\n809\t  *evaluated = *current->car;\n810\t}\n811\t\n812\tvoid definedFunctionRemoveWhitespaces(struct Object *op1,\n813\t                                      struct Object *evaluated) {\n814\t  if (op1->type != OBJ_STRING) {\n815\t    printf(\"Type error: remove-whitespaces operand must be string.\\n\");\n816\t    exit(1);\n817\t  }\n818\t  char *str = op1->string_value;\n819\t  char *new_str = malloc(sizeof(char) * (strlen(str) + 1));\n820\t  int i = 0;\n821\t  int j = 0;\n822\t  while (str[i]) {\n823\t    if (!isspace(str[i])) {\n824\t      new_str[j++] = str[i];\n825\t    }\n826\t    i++;\n827\t  }\n828\t  new_str[j] = '\\0';\n829\t  evaluated->type = OBJ_STRING;\n830\t  evaluated->string_value = new_str;\n831\t}\n832\t\n833\tvoid definedFunctionPop(struct Object *op, struct Object *evaluated) {\n834\t  // empty list is evaluted as nil\n835\t  if (op->type == OBJ_NIL) {\n836\t    evaluated->type = OBJ_NIL;\n837\t    return;\n838\t  }\n839\t  if (op->type != OBJ_LIST) {\n840\t    printf(\"Type error: pop operand must be list.\\n\");\n841\t    exit(1);\n842\t  }\n843\t  struct ConsCell *current = op->list_value;\n844\t  struct ConsCell *prev = NULL;\n845\t  while (1) {\n846\t    if (isLastConsCell(current)) {\n847\t      if (prev == NULL) {\n848\t        *evaluated = *current->car;\n849\t      } else {\n850\t        prev->cdr->type = OBJ_NIL;\n851\t        prev->cdr->list_value = NULL;\n852\t        *evaluated = *current->car;\n853\t      }\n854\t      break;\n855\t    }\n856\t    prev = current;\n857\t    current = current->cdr->list_value;\n858\t  }\n859\t}\n860\t\n861\tvoid definedFunctionPush(struct Object *op1, struct Object *op2,\n862\t                         struct Object *evaluated, struct Env *env,\n863\t                         struct AllocatorContext *context) {\n864\t  if (op1->type == OBJ_NIL) {\n865\t    *evaluated = *op2;\n866\t\n867\t    int i = 0;\n868\t    while (env->bindings[i].symbol_name != NULL) {\n869\t      if (env->bindings[i].value == op1) {\n870\t        struct Object *new_list = allocate(context, env);\n871\t        new_list->type = OBJ_LIST;\n872\t        new_list->list_value = malloc(sizeof(struct ConsCell));\n873\t        new_list->list_value->type = CONSCELL_TYPE_CELL;\n874\t        new_list->list_value->car = op2;\n875\t        new_list->list_value->cdr = allocate(context, env);\n876\t        new_list->list_value->cdr->type = OBJ_NIL;\n877\t        env->bindings[i].value = new_list;\n878\t        break;\n879\t      }\n880\t      i++;\n881\t    }\n882\t\n883\t    return;\n884\t  }\n885\t\n886\t  if (op1->type != OBJ_LIST) {\n887\t    printf(\"Type error: push second operand must be list.\\n\");\n888\t    exit(1);\n889\t  }\n890\t\n891\t  struct ConsCell *current = op1->list_value;\n892\t  while (1) {\n893\t    if (isLastConsCell(current)) {\n894\t      struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n895\t      new_conscell->type = CONSCELL_TYPE_CELL;\n896\t      new_conscell->car = op2;\n897\t      new_conscell->cdr = allocate(context, env);\n898\t      new_conscell->cdr->type = OBJ_NIL;\n899\t      current->cdr->type = OBJ_LIST;\n900\t      current->cdr->list_value = new_conscell;\n901\t      break;\n902\t    }\n903\t    current = current->cdr->list_value;\n904\t  }\n905\t\n906\t  *evaluated = *op2;\n907\t}\n908\t\n909\tvoid definedFunctionLength(struct Object *op, struct Object *evaluated) {\n910\t  if (op->type == OBJ_NIL) {\n911\t    evaluated->type = OBJ_INTEGER;\n912\t    evaluated->int_value = 0;\n913\t    return;\n914\t  }\n915\t  if (op->type == OBJ_LIST) {\n916\t    int length = 1;\n917\t    struct ConsCell *current = op->list_value;\n918\t    while (1) {\n919\t      if (isLastConsCell(current)) {\n920\t        break;\n921\t      }\n922\t      length++;\n923\t      current = current->cdr->list_value;\n924\t    }\n925\t    evaluated->type = OBJ_INTEGER;\n926\t    evaluated->int_value = length;\n927\t  } else if (op->type == OBJ_STRING) {\n928\t    evaluated->type = OBJ_INTEGER;\n929\t    evaluated->int_value = strlen(op->string_value);\n930\t  } else {\n931\t    printf(\"Type error: length operand must be list or string.\\n\");\n932\t    exit(1);\n933\t  }\n934\t}\n935\t\n936\tvoid definedFunctionIsIntString(struct Object *op, struct Object *evaluated) {\n937\t  if (op->type == OBJ_STRING) {\n938\t    char *str = op->string_value;\n939\t    int i = 0;\n940\t    while (str[i]) {\n941\t      if (!isdigit(str[i])) {\n942\t        evaluated->type = OBJ_BOOL;\n943\t        evaluated->bool_value = false;\n944\t        return;\n945\t      }\n946\t      i++;\n947\t    }\n948\t    evaluated->type = OBJ_BOOL;\n949\t    evaluated->bool_value = true;\n950\t  } else {\n951\t    evaluated->type = OBJ_BOOL;\n952\t    evaluated->bool_value = false;\n953\t  }\n954\t}\n955\t\n956\tvoid definedFunctionParseInt(struct Object *op, struct Object *evaluated) {\n957\t  if (op->type != OBJ_STRING) {\n958\t    printf(\"Type error: parse-int operand must be string.\\n\");\n959\t    exit(1);\n960\t  }\n961\t  char *str = op->string_value;\n962\t  int i = 0;\n963\t  while (str[i]) {\n964\t    if (!isdigit(str[i])) {\n965\t      printf(\"Type error: parse-int operand must be string of digits.\\n\");\n966\t      exit(1);\n967\t    }\n968\t    i++;\n969\t  }\n970\t  evaluated->type = OBJ_INTEGER;\n971\t  evaluated->int_value = atoi(str);\n972\t}\n973\t\n974\tvoid definedFunctionStringRef(struct Object *op1, struct Object *op2, struct Object *evaluated) {\n975\t  if (op1->type != OBJ_STRING) {\n976\t    printf(\"Type error: string-ref first operand must be string.\\n\");\n977\t    exit(1);\n978\t  }\n979\t  if (op2->type != OBJ_INTEGER) {\n980\t    printf(\"Type error: string-ref second operand must be integer.\\n\");\n981\t    exit(1);\n982\t  }\n983\t  int index = op2->int_value;\n984\t\n985\t  if (index < 0 || index >= (int)strlen(op1->string_value)) {\n986\t    printf(\"Index out of range.\\n\");\n987\t    exit(1);\n988\t  }\n989\t  evaluated->type = OBJ_STRING;\n990\t  evaluated->string_value = malloc(sizeof(char) * 2);\n991\t  evaluated->string_value[0] = op1->string_value[index];\n992\t  evaluated->string_value[1] = '\\0';\n993\t}\n994\t\n995\t// =================================================\n996\t//   evaluator\n997\t// =================================================\n998\t\n999\tvoid evaluateListExpression(struct ExpressionNode *expression,\n1000\t                            struct Object *evaluated, struct Env *env,\n1001\t                            struct AllocatorContext *context) {\n1002\t  struct ExpressionList *expressions = expression->data.list->expressions;\n1003\t\n1004\t  // empty data list is evaluated as nil\n1005\t  if (expressions == NULL) {\n1006\t    evaluated->type = OBJ_NIL;\n1007\t    return;\n1008\t  }\n1009\t\n1010\t  evaluated->type = OBJ_LIST;\n1011\t\n1012\t  struct ConsCell *car_conscell = NULL;\n1013\t  struct ConsCell *prev_conscell = NULL;\n1014\t\n1015\t  while (expressions != NULL) {\n1016\t    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n1017\t    if (car_conscell == NULL) {\n1018\t      car_conscell = new_conscell;\n1019\t    }\n1020\t\n1021\t    struct Object *evaluatedItem = allocate(context, env);\n1022\t    new_conscell->car = evaluatedItem;\n1023\t    evaluateExpression(expressions->expression, evaluatedItem, env, context);\n1024\t\n1025\t    expressions = expressions->next;\n1026\t\n1027\t    if (prev_conscell != NULL) {\n1028\t      struct Object *new_cdr = allocate(context, env);\n1029\t      new_cdr->type = OBJ_LIST;\n1030\t      new_cdr->list_value = new_conscell;\n1031\t      prev_conscell->cdr = new_cdr;\n1032\t      prev_conscell->type = CONSCELL_TYPE_CELL;\n1033\t    }\n1034\t    prev_conscell = new_conscell;\n1035\t\n1036\t    if (expressions == NULL) {\n1037\t      struct Object *nilObj = allocate(context, env);\n1038\t      nilObj->type = OBJ_NIL;\n1039\t      prev_conscell->type = CONSCELL_TYPE_NIL;\n1040\t      prev_conscell->cdr = nilObj;\n1041\t    }\n1042\t  }\n1043\t\n1044\t  evaluated->list_value = car_conscell;\n1045\t}\n1046\t\n1047\tvoid setObjectToEnv(struct Env *env, char *symbolName, struct Object *obj) {\n1048\t  // search binding that has the symbol name\n1049\t  int i = 0;\n1050\t  while (env->bindings[i].symbol_name != NULL) {\n1051\t    if (strcmp(env->bindings[i].symbol_name, symbolName) == 0) {\n1052\t      env->bindings[i].value = obj;\n1053\t      return;\n1054\t    }\n1055\t    i++;\n1056\t  }\n1057\t\n1058\t  // if not found, set to parent env\n1059\t  struct Binding *binding = malloc(sizeof(struct Binding));\n1060\t  binding->symbol_name = symbolName;\n1061\t  binding->value = obj;\n1062\t  i = 0;\n1063\t  while (env->bindings[i].symbol_name != NULL) {\n1064\t    i++;\n1065\t  }\n1066\t  env->bindings[i] = *binding;\n1067\t}\n1068\t\n1069\tvoid evaluateSymbolicExpression(struct ExpressionNode *expression,\n1070\t                                struct Object *evaluated, struct Env *env,\n1071\t                                struct AllocatorContext *context) {\n1072\t  struct ExpressionList *expressions = expression->data.list->expressions;\n1073\t  if (expressions != NULL) {\n1074\t    struct ExpressionNode *expr = expressions->expression;\n1075\t    if (expr != NULL && expr->type == EXP_SYMBOL) {\n1076\t      if (strcmp(expr->data.symbol->symbol_name, \"if\") == 0) {\n1077\t        // if\n1078\t        struct ExpressionNode *cond = expressions->next->expression;\n1079\t        if (cond == NULL) {\n1080\t          printf(\"if must have condition.\\n\");\n1081\t          exit(1);\n1082\t        }\n1083\t        struct ExpressionNode *then = expressions->next->next->expression;\n1084\t        if (then == NULL) {\n1085\t          printf(\"if must have then clause.\\n\");\n1086\t          exit(1);\n1087\t        }\n1088\t        struct Object *condObj = allocate(context, env);\n1089\t        evaluateExpression(cond, condObj, env, context);\n1090\t        if (boolVal(condObj)) {\n1091\t          evaluateExpression(then, evaluated, env, context);\n1092\t        } else {\n1093\t          if (expressions->next->next->next != NULL) {\n1094\t            struct ExpressionNode *els =\n1095\t                expressions->next->next->next->expression;\n1096\t            evaluateExpression(els, evaluated, env, context);\n1097\t          } else {\n1098\t            evaluated->type = OBJ_NIL;\n1099\t          }\n1100\t        }\n1101\t      } else if (strcmp(expr->data.symbol->symbol_name, \"while\") == 0) {\n1102\t        // while\n1103\t        struct ExpressionNode *cond = expressions->next->expression;\n1104\t        if (cond == NULL) {\n1105\t          printf(\"if must have condition.\\n\");\n1106\t          exit(1);\n1107\t        }\n1108\t        struct ExpressionNode *then = expressions->next->next->expression;\n1109\t        if (then == NULL) {\n1110\t          printf(\"if must have then clause.\\n\");\n1111\t          exit(1);\n1112\t        }\n1113\t        while (1) {\n1114\t          struct Object *condObj = allocate(context, env);\n1115\t          evaluateExpression(cond, condObj, env, context);\n1116\t          if (boolVal(condObj)) {\n1117\t            evaluateExpression(then, evaluated, env, context);\n1118\t          } else {\n1119\t            evaluated->type = OBJ_NIL;\n1120\t            break;\n1121\t          }\n1122\t        }\n1123\t      } else if (strcmp(expr->data.symbol->symbol_name, \"=\") == 0) {\n1124\t        // assignment\n1125\t        struct ExpressionNode symbolExpr = *expressions->next->expression;\n1126\t        if (symbolExpr.type != EXP_SYMBOL) {\n1127\t          printf(\"Variable name must be symbol.\\n\");\n1128\t          exit(1);\n1129\t        }\n1130\t        char *symbol_name = symbolExpr.data.symbol->symbol_name;\n1131\t        struct ExpressionNode *expr = expressions->next->next->expression;\n1132\t\n1133\t        if (expr == NULL) {\n1134\t          printf(\"assignment must have expression.\\n\");\n1135\t          exit(1);\n1136\t        }\n1137\t        struct Object *evaluatedExpr = allocate(context, env);\n1138\t        evaluateExpression(expr, evaluatedExpr, env, context);\n1139\t        *evaluated = *evaluatedExpr;\n1140\t\n1141\t        // set value to current env\n1142\t        setObjectToEnv(env, symbol_name, evaluatedExpr);\n1143\t      } else if ((strcmp(expr->data.symbol->symbol_name, \"defun\") == 0)) {\n1144\t        // define function\n1145\t        // (defun fn (n) (+ n 1))\n1146\t        struct ExpressionNode symbolExpr = *expressions->next->expression;\n1147\t        if (symbolExpr.type != EXP_SYMBOL) {\n1148\t          printf(\"Function name must be symbol.\\n\");\n1149\t          exit(1);\n1150\t        }\n1151\t        char *symbol_name = symbolExpr.data.symbol->symbol_name;\n1152\t\n1153\t        struct ExpressionNode *paramsExpr = expressions->next->next->expression;\n1154\t        if (paramsExpr == NULL) {\n1155\t          printf(\"Function must have parameter.\\n\");\n1156\t          exit(1);\n1157\t        }\n1158\t        if (paramsExpr->type != EXP_SYMBOLIC_EXP) {\n1159\t          printf(\"Function parameter must be list.\\n\");\n1160\t          exit(1);\n1161\t        }\n1162\t\n1163\t        struct ExpressionList *params =\n1164\t            paramsExpr->data.symbolic_exp->expressions;\n1165\t        // check all elements are symbol and get symbol names\n1166\t\n1167\t        char **param_symbol_names = malloc(sizeof(char *) * MAX_BINDINGS);\n1168\t\n1169\t        int i = 0;\n1170\t        while (params != NULL) {\n1171\t 