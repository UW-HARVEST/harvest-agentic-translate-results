evaluated;\n1504\t        return;\n1505\t      }\n1506\t      i++;\n1507\t    }\n1508\t    if (env->parent != NULL) {\n1509\t      evaluateSymbolExpression(expression, evaluated, env->parent, context);\n1510\t    } else {\n1511\t      printf(\"Undefined symbol: %s\\n\", expression->data.symbol->symbol_name);\n1512\t      exit(1);\n1513\t    }\n1514\t  }\n1515\t}\n1516\t\n1517\tvoid evaluateExpression(struct ExpressionNode *expression,\n1518\t                        struct Object *evaluated, struct Env *env,\n1519\t                        struct AllocatorContext *context) {\n1520\t  pushObjectStack(context->stack, evaluated);\n1521\t  if (expression->type == EXP_LIST) {\n1522\t    evaluateListExpression(expression, evaluated, env, context);\n1523\t  } else if (expression->type == EXP_SYMBOLIC_EXP) {\n1524\t    evaluateSymbolicExpression(expression, evaluated, env, context);\n1525\t  } else if (expression->type == EXP_LITERAL) {\n1526\t    evaluateLiteralExpression(expression, evaluated);\n1527\t  } else if (expression->type == EXP_SYMBOL) {\n1528\t    evaluateSymbolExpression(expression, evaluated, env, context);\n1529\t  }\n1530\t  popObjectStack(context->stack);\n1531\t}\n1532\t\n1533\tvoid evaluateExpressionWithContext(struct ExpressionNode *expression,\n1534\t                                   struct Object *evaluated, struct Env *env) {\n1535\t  struct AllocatorContext *context = initAllocator();\n1536\t  evaluateExpression(expression, evaluated, env, context);\n1537\t}\n1538\t\n1539\tvoid initEnv(struct Env *env) {\n1540\t  env->parent = NULL;\n1541\t  env->bindings[0].symbol_name = NULL;\n1542\t  env->bindings[0].value = NULL;\n1543\t}\n1544\t\n1545\tvoid evaluateProgram(struct ProgramNode *program) {\n1546\t  struct ExpressionList *expressions = program->expressions;\n1547\t\n1548\t  struct Env *env = malloc(sizeof(struct Env));\n1549\t  initEnv(env);\n1550\t\n1551\t  struct AllocatorContext *context = initAllocator();\n1552\t\n1553\t  while (expressions != N