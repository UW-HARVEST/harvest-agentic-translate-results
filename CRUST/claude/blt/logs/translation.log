ns a tuple (is_new, leaf).\n    pub fn cbt_insert(&mut self, key: &str) -> (bool, CbtLeaf) {\n        let is_new = !self.with_storage(|s| s.contains_key(key));\n        if is_new {\n            self.with_storage_mut(|s| {\n                s.insert(key.to_string(), Box::new(()) as Box<dyn Any>);\n            });\n        }\n        self.refresh_count();\n        (is_new, Self::make_leaf(key))\n    }\n    /// Returns the overhead in bytes used by the tree.\n    pub fn cbt_overhead(&self) -> usize {\n        let entries = self.with_storage(|s| s.len());\n        std::mem::size_of::<Self>() + entries * std::mem::size_of::<CbtLeaf>()\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":809,"cache_read_input_tokens":51120,"cache_creation":{"ephemeral_5m_input_tokens":809,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7469f7fb-0df5-4fdd-8e1c-a19a20ea6c8f","uuid":"12560de9-27c1-4cc8-b76b-0952e3a495f9"}
