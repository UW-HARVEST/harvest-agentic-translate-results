{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X2ZJQFnT4RHikQFxx3vEry","type":"tool_result","content":"1\t// See http://www.imperialviolet.org/binary/critbit.pdf\n2\t//\n3\t// Differences:\n4\t//   - We only have one child pointer. We allocate sibling nodes at the same\n5\t//     time; they lie in adjacent blocks of memory. The child pointer points\n6\t//     to the left child. There is no waste because every node is either\n7\t//     external or has two children.\n8\t//   - We fold strcmp into the crit-bit finder. If there is no crit-bit\n9\t//     then we have a match.\n10\t//   - During lookup, if the key is shorter than the position of the\n11\t//     crit bit in the current node, the path we take is irrelevant.\n12\t//     Ideally, we'd take one of the shortest paths to a leaf (the only\n13\t//     purpose is to get at a string so we can find the true crit bit),\n14\t//     but for simplicity we always follow the left child.\n15\t//     Our code skips a tiny bit of computation by assigning\n16\t//     direction = 0 rather than c = 0 plus some bit twiddling.\n17\t//   - Insertion: while walking down the tree (after we've figured out the crit\n18\t//     bit), we're guaranteed that the byte number of the current node is less\n19\t//     than the key length, so there's no need for special-case code to handle\n20\t//     keys shorter than the crit bit.\n21\t//   - We combine a couple of comparisons. Instead of byte0 < byte1 and then\n22\t//     mask0 < mask1 if they are equal, we simplify to:\n23\t//       (byte0 << 8) + mask0 < (byte1 << 8) + mask1\n24\t//   - Deletion: we can return early if the key length is shorter than\n25\t//     the current node's critical bit, as this implies the key is absent.\n26\t//   - When following child pointers, rather than p->kid + predicate(),\n27\t//     we prefer predicate() ? p->kid + 1 : p->kid, as this is faster on my\n28\t//     system. We can thus relax predicate(): instead of returning 0 or 1,\n29\t//     it's fine if it simply returns 0 or nonzero. This means we can store\n30\t//     the plain bitmask instead of its inversion, and check the bit with\n31\t//     a single AND.\n32\t\n33\t#include <assert.h>\n34\t#include <stdio.h>\n35\t#include <stdint.h>\n36\t#include <stdlib.h>\n37\t#include <string.h>\n38\t#include \"blt.h\"\n39\t\n40\t// Returns the byte where each bit is 1 except for the bit corresponding to\n41\t// the leading bit of x.\n42\tstatic inline uint8_t to_mask(uint8_t x) {\n43\t  // SWAR trick that sets every bit after the leading bit to 1.\n44\t  x |= x >> 1;\n45\t  x |= x >> 2;\n46\t  x |= x >> 4;\n47\t  // Zero all the bits after the leading bit then invert.\n48\t  return x & ~(x >> 1);\n49\t  if (0) {\n50\t    // Alternative that performs better when there are few set bits.\n51\t    // Zero all bits except leading bit with a bit-twiddling trick.\n52\t    while (x&(x-1)) x &= x-1;\n53\t    // Invert.\n54\t    return 255 - x;\n55\t  }\n56\t}\n57\t\n58\t// An internal node. Leaf nodes are described by BLT_IT.\n59\tstruct blt_node_s {\n60\t  unsigned int byte:32;     // Byte # of difference.\n61\t  unsigned int mask:8;      // ~mask = the crit bit within the byte.\n62\t  unsigned int padding:23;\n63\t  // The following bit corresponds to the last bit of the pointer to the key\n64\t  // in the external node, which is always zero due to malloc alignment.\n65\t  unsigned int is_internal:1;\n66\t  struct blt_node_s *kid;\n67\t};\n68\ttypedef struct blt_node_s *blt_node_ptr;\n69\t\n70\tstatic inline blt_node_ptr follow(blt_node_ptr p, char *key) {\n71\t  return key[p->byte] & p->mask ? p->kid + 1 : p->kid;\n72\t}\n73\t\n74\tstruct BLT {\n75\t  struct blt_node_s root[1];\n76\t  int empty;\n77\t};\n78\t\n79\tBLT *blt_new() {\n80\t  BLT *blt = malloc(sizeof(*blt));\n81\t  blt->empty = 1;\n82\t  return blt;\n83\t}\n84\t\n85\tvoid blt_clear(BLT *blt) {\n86\t  void free_node(blt_node_ptr p) {\n87\t    if (!p->is_internal) {\n88\t      free(((BLT_IT *) p)->key);\n89\t      return;\n90\t    }\n91\t    blt_node_ptr q = p->kid;\n92\t    free_node(q);\n93\t    free_node(q + 1);\n94\t    free(q);\n95\t  }\n96\t  if (!blt->empty) free_node(blt->root);\n97\t  free(blt);\n98\t}\n99\t\n100\tsize_t blt_overhead(BLT *blt) {\n101\t  size_t n = sizeof(BLT);\n102\t  if (blt->empty) return n;\n103\t  void add(blt_node_ptr p) {\n104\t    if (p->is_internal) {\n105\t      n += 2 * sizeof(struct blt_node_s);\n106\t      add(p->kid);\n107\t      add(p->kid + 1);\n108\t    }\n109\t  }\n110\t  add(blt->root);\n111\t  return n;\n112\t}\n113\t\n114\tvoid blt_dump(BLT* blt, blt_node_ptr p) {\n115\t  if (blt->empty) return;\n116\t  if (p->is_internal) {\n117\t    blt_dump(blt, p->kid);\n118\t    blt_dump(blt, p->kid + 1);\n119\t    return;\n120\t  }\n121\t  printf(\"  %s\\n\", (char *) ((BLT_IT *) p)->key);\n122\t}\n123\t\n124\tstatic BLT_IT *blt_firstlast(blt_node_ptr p, int dir) {\n125\t  if (!p) return 0;\n126\t  while (p->is_internal) p = ((blt_node_ptr)p->kid) + dir;\n127\t  return (BLT_IT *)p;\n128\t}\n129\t\n130\tBLT_IT *blt_first(BLT *blt) {\n131\t  return blt->empty ? 0 : blt_firstlast(blt->root, 0);\n132\t}\n133\t\n134\tBLT_IT *blt_last (BLT *blt) {\n135\t  return blt->empty ? 0 : blt_firstlast(blt->root, 1);\n136\t}\n137\t\n138\tBLT_IT *blt_next(BLT *blt, BLT_IT *it) {\n139\t  blt_node_ptr p = blt->root, other = 0;\n140\t  while (p->is_internal) {\n141\t    if (!(it->key[p->byte] & p->mask)) {\n142\t      other = p->kid + 1;\n143\t      p = p->kid;\n144\t    } else {\n145\t      p = p->kid + 1;\n146\t    }\n147\t  }\n148\t  assert(!strcmp(((BLT_IT *)p)->key, it->key));\n149\t  return blt_firstlast(other, 0);\n150\t}\n151\t\n152\tBLT_IT *blt_prev(BLT *blt, BLT_IT *it) {\n153\t  blt_node_ptr p = blt->root, other = 0;\n154\t  while (p->is_internal) {\n155\t    if (it->key[p->byte] & p->mask) {\n156\t      other = p->kid;\n157\t      p = p->kid + 1;\n158\t    } else {\n159\t      p = p->kid;\n160\t    }\n161\t  }\n162\t  asse