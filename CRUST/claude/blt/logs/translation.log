ods preserve that invariant.\n        match self.root.as_ref() {\n            BltNode::Leaf(it) => match it.data.as_ref().and_then(|d| d.downcast_ref::<Storage>()) {\n                Some(s) => s,\n                None => Self::empty_storage(),\n            },\n            BltNode::Internal(_) => Self::empty_storage(),\n        }\n    }\n\n    fn empty_storage() -> &'static Storage {\n        use std::sync::OnceLock;\n        static EMPTY: OnceLock<Storage> = OnceLock::new();\n        EMPTY.get_or_init(BTreeMap::new)\n    }\n\n    fn storage_mut(&mut self) -> &mut Storage {\n        self.ensure_leaf_storage();\n        match self.root.as_mut() {\n            BltNode::Leaf(it) => it\n                .data\n                .as_mut()\n                .and_then(|d| d.downcast_mut::<Storage>())\n                .expect(\"storage initialized above\"),\n            // Unreachable: ensure_leaf_storage made root a Leaf.\n            BltNode::Internal(_) => unreachable!(),\n        }\n    }"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":283,"cache_read_input_tokens":58881,"cache_creation":{"ephemeral_5m_input_tokens":283,"ephemeral_1h_input_tokens":0},"output_tokens":51,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7469f7fb-0df5-4fdd-8e1c-a19a20ea6c8f","uuid":"ad5fda6d-715d-44f0-b3c3-6264362fd324"}
