f.len);\n    }\n    let _ = write!(fp, \"]\");\n    let _ = write!(fp, \"fs({}):\", self.fieldsize);\n    let _ = write!(fp, \"i({})\", self.current_idx);\n    let _ = write!(fp, \"]\\n\");\n}\n}\n","numLines":64,"startLine":1,"totalLines":64}}}
