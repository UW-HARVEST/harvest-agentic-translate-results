{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019TZeDpyzadyLpVMyFVTBGy","type":"tool_result","content":"1\t/*\n2\t * Approxidate, taken from git.\n3\t *\n4\t * Copyright (C) Linus Torvalds, 2005\n5\t */\n6\t\n7\t#define _POSIX_C_SOURCE 200809L\n8\t#include \"approxidate.h\"\n9\t\n10\t#include <math.h>\n11\t#include <string.h>\n12\t#include <time.h>\n13\t#include <limits.h>\n14\t#include <stdlib.h>\n15\t\n16\t/**\n17\t * Maintains compatibility with the default struct tm,\n18\t * but adds a field for usec.\n19\t */\n20\tstruct atm {\n21\t\tint tm_sec;\n22\t\tint tm_min;\n23\t\tint tm_hour;\n24\t\tint tm_mday;\n25\t\tint tm_mon;\n26\t\tint tm_year;\n27\t\tint tm_wday;\n28\t\tint tm_yday;\n29\t\tint tm_isdst;\n30\t\tlong tm_usec;\n31\t};\n32\t\n33\t#define GIT_SPACE 0x01\n34\t#define GIT_DIGIT 0x02\n35\t#define GIT_ALPHA 0x04\n36\t#define GIT_GLOB_SPECIAL 0x08\n37\t#define GIT_REGEX_SPECIAL 0x10\n38\t#define GIT_PATHSPEC_MAGIC 0x20\n39\t#define GIT_CNTRL 0x40\n40\t#define GIT_PUNCT 0x80\n41\t#define sane_istest(x,mask) ((sane_ctype[(unsigned char)(x)] & (mask)) != 0)\n42\t#define isdigit(x) sane_istest(x,GIT_DIGIT)\n43\t#define isalpha(x) sane_istest(x,GIT_ALPHA)\n44\t#define isalnum(x) sane_istest(x,GIT_ALPHA | GIT_DIGIT)\n45\t#define toupper(x) sane_case((unsigned char)(x), 0)\n46\t#define ARRAY_SIZE(x) (sizeof(x)/sizeof(x[0]))\n47\t\n48\tenum {\n49\t\tS = GIT_SPACE,\n50\t\tA = GIT_ALPHA,\n51\t\tD = GIT_DIGIT,\n52\t\tG = GIT_GLOB_SPECIAL,\t/* *, ?, [, \\\\ */\n53\t\tR = GIT_REGEX_SPECIAL,\t/* $, (, ), +, ., ^, {, | */\n54\t\tP = GIT_PATHSPEC_MAGIC, /* other non-alnum, except for ] and } */\n55\t\tX = GIT_CNTRL,\n56\t\tU = GIT_PUNCT,\n57\t\tZ = GIT_CNTRL | GIT_SPACE\n58\t};\n59\t\n60\tconst unsigned char sane_ctype[256] = {\n61\t\tX, X, X, X, X, X, X, X, X, Z, Z, X, X, Z, X, X,\t\t/*   0.. 15 */\n62\t\tX, X, X, X, X, X, X, X, X, X, X, X, X, X, X, X,\t\t/*  16.. 31 */\n63\t\tS, P, P, P, R, P, P, P, R, R, G, R, P, P, R, P,\t\t/*  32.. 47 */\n64\t\tD, D, D, D, D, D, D, D, D, D, P, P, P, P, P, G,\t\t/*  48.. 63 */\n65\t\tP, A, A, A, A, A, A, A, A, A, A, A, A, A, A, A,\t\t/*  64.. 79 */\n66\t\tA, A, A, A, A, A, A, A, A, A, A, G, G, U, R, P,\t\t/*  80.. 95 */\n67\t\tP, A, A, A, A, A, A, A, A, A, A, A, A, A, A, A,\t\t/*  96..111 */\n68\t\tA, A, A, A, A, A, A, A, A, A, A, R, R, U, P, X,\t\t/* 112..127 */\n69\t\t/* Nothing in the 128.. range */\n70\t};\n71\t\n72\tstatic inline int sane_case(int x, int high)\n73\t{\n74\t\tif (sane_istest(x, GIT_ALPHA))\n75\t\t\tx = (x & ~0x20) | high;\n76\t\treturn x;\n77\t}\n78\t\n79\t/*\n80\t * This is like mktime, but without normalization of tm_wday and tm_yday.\n81\t */\n82\tstatic time_t tm_to_time_t(const struct atm *tm)\n83\t{\n84\t\tstatic const int mdays[] = {\n85\t\t    0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334\n86\t\t};\n87\t\tint year = tm->tm_year - 70;\n88\t\tint month = tm->tm_mon;\n89\t\tint day = tm->tm_mday;\n90\t\n91\t\tif (year < 0 || year > 129) /* algo only works for 1970-2099 */\n92\t\t\treturn -1;\n93\t\tif (month < 0 || month > 11) /* array bounds */\n94\t\t\treturn -1;\n95\t\tif (month < 2 || (year + 2) % 4)\n96\t\t\tday--;\n97\t\tif (tm->tm_hour < 0 || tm->tm_min < 0 || tm->tm_sec < 0)\n98\t\t\treturn -1;\n99\t\treturn (year * 365 + (year + 1) / 4 + mdays[month] + day) * 24*60*60UL +\n100\t\t\ttm->tm_hour * 60*60 + tm->tm_min * 60 + tm->tm_sec;\n101\t}\n102\t\n103\tstatic const char *month_names[] = {\n104\t\t\"January\", \"February\", \"March\", \"April\", \"May\", \"June\",\n105\t\t\"July\", \"August\", \"September\", \"October\", \"November\", \"December\"\n106\t};\n107\t\n108\tstatic const char *weekday_names[] = {\n109\t\t\"Sundays\", \"Mondays\", \"Tuesdays\", \"Wednesdays\", \"Thursdays\", \"Fridays\", \"Saturdays\"\n110\t};\n111\t\n112\t/*\n113\t * Check these. And note how it doesn't do the summer-time conversion.\n114\t *\n115\t * In my world, it's always summer, and things are probably a bit off\n116\t * in other ways too.\n117\t */\n118\tstatic const struct {\n119\t\tconst char *name;\n120\t\tint offset;\n121\t\tint dst;\n122\t} timezone_names[] = {\n123\t\t{ \"IDLW\", -12, 0, },\t/* International Date Line West */\n124\t\t{ \"NT\",   -11, 0, },\t/* Nome */\n125\t\t{ \"CAT\",  -10, 0, },\t/* Central Alaska */\n126\t\t{ \"HST\",  -10, 0, },\t/* Hawaii Standard */\n127\t\t{ \"HDT\",  -10, 1, },\t/* Hawaii Daylight */\n128\t\t{ \"YST\",   -9, 0, },\t/* Yukon Standard */\n129\t\t{ \"YDT\",   -9, 1, },\t/* Yukon Daylight */\n130\t\t{ \"PST\",   -8, 0, },\t/* Pacific Standard */\n131\t\t{ \"PDT\",   -8, 1, },\t/* Pacific Daylight */\n132\t\t{ \"MST\",   -7, 0, },\t/* Mountain Standard */\n133\t\t{ \"MDT\",   -7, 1, },\t/* Mountain Daylight */\n134\t\t{ \"CST\",   -6, 0, },\t/* Central Standard */\n135\t\t{ \"CDT\",   -6, 1, },\t/* Central Daylight */\n136\t\t{ \"EST\",   -5, 0, },\t/* Eastern Standard */\n137\t\t{ \"EDT\",   -5, 1, },\t/* Eastern Daylight */\n138\t\t{ \"AST\",   -3, 0, },\t/* Atlantic Standard */\n139\t\t{ \"ADT\",   -3, 1, },\t/* Atlantic Daylight */\n140\t\t{ \"WAT\",   -1, 0, },\t/* West Africa */\n141\t\t{ \"GMT\",    0, 0, },\t/* Greenwich Mean */\n142\t\t{ \"UTC\",    0, 0, },\t/* Universal (Coordinated) */\n143\t\t{ \"Z\",      0, 0, },    /* Zulu, alias for UTC */\n144\t\t{ \"WET\",    0, 0, },\t/* Western European */\n145\t\t{ \"BST\",    0, 1, },\t/* British Summer */\n146\t\t{ \"CET\",   +1, 0, },\t/* Central European */\n147\t\t{ \"MET\",   +1, 0, },\t/* Middle European */\n148\t\t{ \"MEWT\",  +1, 0, },\t/* Middle European Winter */\n149\t\t{ \"MEST\",  +1, 1, },\t/* Middle European Summer */\n150\t\t{ \"CEST\",  +1, 1, },\t/* Central European Summer */\n151\t\t{ \"MESZ\",  +1, 1, },\t/* Middle European Summer */\n152\t\t{ \"FWT\",   +1, 0, },\t/* French Winter */\n153\t\t{ \"FST\",   +1, 1, },\t/* French Summer */\n154\t\t{ \"EET\",   +2, 0, },\t/* Eastern Europe, USSR Zone 1 */\n155\t\t{ \"EEST\",  +2, 1, },\t/* Eastern European Daylight */\n156\t\t{ \"WAST\",  +7, 0, },\t/* West Australian Standard */\n157\t\t{ \"WADT\",  +7, 1, },\t/* West Australian Daylight */\n158\t\t{ \"CCT\",   +8, 0, },\t/* China Coast, USSR Zone 7 */\n159\t\t{ \"JST\",   +9, 0, },\t/* Japan Standard, USSR Zone 8 */\n160\t\t{ \"EAST\", +10, 0, },\t/* Eastern Australian Standard */\n161\t\t{ \"EADT\", +10, 1, },\t/* Eastern Australian Daylight */\n162\t\t{ \"GST\",  +10, 0, },\t/* Guam Standard, USSR Zone 9 */\n163\t\t{ \"NZT\",  +12, 0, },\t/* New Zealand */\n164\t\t{ \"NZST\", +12, 0, },\t/* New Zealand Standard */\n165\t\t{ \"NZDT\", +12, 1, },\t/* New Zealand Daylight */\n166\t\t{ \"IDLE\", +12, 0, },\t/* International Date Line East */\n167\t};\n168\t\n169\tstatic int match_string(const char *date, const char *str)\n170\t{\n171\t\tint i = 0;\n172\t\n173\t\tfor (i = 0; *date; date++, str++, i++) {\n174\t\t\tif (*date == *str)\n175\t\t\t\tcontinue;\n176\t\t\tif (toupper(*date) == toupper(*str))\n177\t\t\t\tcontinue;\n178\t\t\tif (!isalnum(*date))\n179\t\t\t\tbreak;\n180\t\t\treturn 0;\n181\t\t}\n182\t\treturn i;\n183\t}\n184\t\n185\tstatic int skip_alpha(const char *date)\n186\t{\n187\t\tint i = 0;\n188\t\tdo {\n189\t\t\ti++;\n190\t\t} while (isalpha(date[i]));\n191\t\treturn i;\n192\t}\n193\t\n194\t/*\n195\t* Parse month, weekday, or timezone name\n196\t*/\n197\tstatic int match_alpha(const char *date, struct atm *tm, int *offset)\n198\t{\n199\t\tint i;\n200\t\n201\t\tfor (i = 0; i < 12; i++) {\n202\t\t\tint match = match_string(date, month_names[i]);\n203\t\t\tif (match >= 3) {\n204\t\t\t\ttm->tm_mon = i;\n205\t\t\t\treturn match;\n206\t\t\t}\n207\t\t}\n208\t\n209\t\tfor (i = 0; i < 7; i++) {\n210\t\t\tint match = match_string(date, weekday_names[i]);\n211\t\t\tif (match >= 3) {\n212\t\t\t\ttm->tm_wday = i;\n213\t\t\t\treturn match;\n214\t\t\t}\n215\t\t}\n216\t\n217\t\tfor (i = 0; i < ARRAY_SIZE(timezone_names); i++) {\n218\t\t\tint match = match_string(date, timezone_names[i].name);\n219\t\t\tif (match >= 3 || match == strlen(timezone_names[i].name)) {\n220\t\t\t\tint off = timezone_names[i].offset;\n221\t\n222\t\t\t\t/* This is bogus, but we like summer */\n223\t\t\t\toff += timezone_names[i].dst;\n224\t\n225\t\t\t\t/* Only use the tz name offset if we don't have anything better */\n226\t\t\t\tif (*offset == -1)\n227\t\t\t\t\t*offset = 60*off;\n228\t\n229\t\t\t\treturn match;\n230\t\t\t}\n231\t\t}\n232\t\n233\t\tif (match_string(date, \"PM\") == 2) {\n234\t\t\ttm->tm_hour = (tm->tm_hour % 12) + 12;\n235\t\t\treturn 2;\n236\t\t}\n237\t\n238\t\tif (match_string(date, \"AM\") == 2) {\n239\t\t\ttm->tm_hour = (tm->tm_hour % 12) + 0;\n240\t\t\treturn 2;\n241\t\t}\n242\t\n243\t\t/* BAD CRAP */\n244\t\treturn skip_alpha(date);\n245\t}\n246\t\n247\tstatic int is_date(int year, int month, int day, struct atm *now_tm, time_t now, struct atm *tm)\n248\t{\n249\t\tif (month > 0 && month < 13 && day > 0 && day < 32) {\n250\t\t\tstruct atm check = *tm;\n251\t\t\tstruct atm *r = (now_tm ? &check : tm);\n252\t\n253\t\t\tr->tm_mon = month - 1;\n254\t\t\tr->tm_mday = day;\n255\t\t\tif (year == -1) {\n256\t\t\t\tif (!now_tm)\n257\t\t\t\t\treturn 1;\n258\t\t\t\tr->tm_year = now_tm->tm_year;\n259\t\t\t}\n260\t\t\telse if (year >= 1970 && year < 2100)\n261\t\t\t\tr->tm_year = year - 1900;\n262\t\t\telse if (year > 70 && year < 100)\n263\t\t\t\tr->tm_year = year;\n264\t\t\telse if (year < 38)\n265\t\t\t\tr->tm_year = year + 100;\n266\t\t\telse\n267\t\t\t\treturn 0;\n268\t\t\tif (!now_tm)\n269\t\t\t\treturn 1;\n270\t\n271\t\t\ttm->tm_mon = r->tm_mon;\n272\t\t\ttm->tm_mday = r->tm_mday;\n273\t\t\tif (year != -1)\n274\t\t\t\ttm->tm_year = r->tm_year;\n275\t\t\treturn 1;\n276\t\t}\n277\t\treturn 0;\n278\t}\n279\t\n280\tstatic int match_multi_number(unsigned long num, char c, const char *date,\n281\t\t\t\t      char *end, struct atm *tm, time_t now)\n282\t{\n283\t\tlong num2, num3, num4;\n284\t\n285\t\tnum2 = strtol(end+1, &end, 10);\n286\t\tnum3 = -1;\n287\t\tnum4 = 0;\n288\t\tif (*end == c && isdigit(end[1])) {\n289\t\t\tnum3 = strtol(end+1, &end, 10);\n290\t\n291\t\t\tif (*end == '.') {\n292\t\t\t\tchar *start = end+1;\n293\t\t\t\tnum4 = strtol(end+1, &end, 10);\n294\t\t\t\tif ((end - start) < 6) {\n295\t\t\t\t\tnum4 *= (long)pow(10, 6 - (end - start));\n296\t\t\t\t}\n297\t\t\t}\n298\t\t}\n299\t\n300\t\n301\t\t/* Time? Date? */\n302\t\tswitch (c) {\n303\t\tcase ':':\n304\t\t\tif (num3 < 0)\n305\t\t\t\tnum3 = 0;\n306\t\t\tif (num < 25 && num2 >= 0 && num2 < 60 && num3 >= 0 && num3 <= 60) {\n307\t\t\t\ttm->tm_hour = num;\n308\t\t\t\ttm->tm_min = num2;\n309\t\t\t\ttm->tm_sec = num3;\n310\t\t\t\ttm->tm_usec = num4;\n311\t\t\t\tbreak;\n312\t\t\t}\n313\t\t\treturn 0;\n314\t\n315\t\tcase '-':\n316\t\tcase '/':\n317\t\tcase '.':\n318\t\t\tif (!now)\n319\t\t\t\tnow = time(NULL);\n320\t\t\tif (num > 70) {\n321\t\t\t\t/* yyyy-mm-dd? */\n322\t\t\t\tif (is_date(num, num2, num3, NULL, now, tm))\n323\t\t\t\t\tbreak;\n324\t\t\t\t/* yyyy-dd-mm? */\n325\t\t\t\tif (is_date(num, num3, num2, NULL, now, tm))\n326\t\t\t\t\tbreak;\n327\t\t\t}\n328\t\t\t/* Our eastern European friends say dd.mm.yy[yy]\n329\t\t\t * is the norm there, so giving precedence to\n330\t\t\t * mm/dd/yy[yy] form only when separator is not '.'\n331\t\t\t */\n332\t\t\tif (c != '.' &&\n333\t\t\t    is_date(num3, num, num2, NULL, now, tm))\n334\t\t\t\tbreak;\n335\t\t\t/* European dd.mm.yy[yy] or funny US dd/mm/yy[yy] */\n336\t\t\tif (is_date(num3, num2, num, NULL, now, tm))\n337\t\t\t\tbreak;\n338\t\t\t/* Funny European mm.dd.yy */\n339\t\t\tif (c == '.' &&\n340\t\t\t    is_date(num3, num, num2, NULL, now, tm))\n341\t\t\t\tbreak;\n342\t\t\treturn 0;\n343\t\t}\n344\t\treturn end - date;\n345\t}\n346\t\n347\t/*\n348\t * Have we filled in any part of the time/date yet?\n349\t * We just do a binary 'and' to see if the sign bit\n350\t * is set in all the values.\n351\t */\n352\tstatic inline int nodate(struct tm *tm)\n353\t{\n354\t\treturn (tm->tm_year &\n355\t\t\ttm->tm_mon &\n356\t\t\ttm->tm_mday &\n357\t\t\ttm->tm_hour &\n358\t\t\ttm->tm_min &\n359\t\t\ttm->tm_sec) < 0;\n360\t}\n361\t\n362\t/*\n363\t * We've seen a digit. Time? Year? Date?\n364\t */\n365\tstatic int match_digit(const char *date, struct atm *tm, int *offset, int *tm_gmt)\n366\t{\n367\t\tint n;\n368\t\tchar *end;\n369\t\tunsigned long num;\n370\t\n371\t\tnum = strtoul(date, &end, 10);\n372\t\n373\t\t/*\n374\t\t * Seconds since 1970? We trigger on that for any numbers with\n375\t\t * more than 8 digits. This is because we don't want to rule out\n376\t\t * numbers like 20070606 as a YYYYMMDD date.\n377\t\t */\n378\t\tif (num >= 100000000 && nodate((struct tm*)tm)) {\n379\t\t\ttime_t time = num;\n380\t\t\tif (gmtime_r(&time, (struct tm*)tm)) {\n381\t\t\t\t*tm_gmt = 1;\n382\t\t\t\treturn end - date;\n383\t\t\t}\n384\t\t}\n385\t\n386\t\t/*\n387\t\t * Check for special formats: num[-.:/]num[same]num[.secfracs]\n388\t\t */\n389\t\tswitch (*end) {\n390\t\tcase ':':\n391\t\tcase '.':\n392\t\tcase '/':\n393\t\tcase '-':\n394\t\t\tif (isdigit(end[1])) {\n395\t\t\t\tint match = match_multi_number(num, *end, date, end, tm, 0);\n396\t\t\t\tif (match)\n397\t\t\t\t\treturn match;\n398\t\t\t}\n399\t\t}\n400\t\n401\t\t/*\n402\t\t * None of the special formats? Try to guess what\n403\t\t * the number meant. We use the number of digits\n404\t\t * to make a more educated guess..\n405\t\t */\n406\t\tn = 0;\n407\t\tdo {\n408\t\t\tn++;\n409\t\t} while (isdigit(date[n]));\n410\t\n411\t\t/* Four-digit year or a timezone? */\n412\t\tif (n == 4) {\n413\t\t\tif (num <= 1400 && *offset == -1) {\n414\t\t\t\tunsigned int minutes = num % 100;\n415\t\t\t\tunsigned int hours = num / 100;\n416\t\t\t\t*offset = hours*60 + minutes;\n417\t\t\t} else if (num > 1900 && num < 2100)\n418\t\t\t\ttm->tm_year = num - 1900;\n419\t\t\treturn n;\n420\t\t}\n421\t\n422\t\t/*\n423\t\t * Ignore lots of numerals. We took care of 4-digit years above.\n424\t\t * Days or months must be one or two digits.\n425\t\t */\n426\t\tif (n > 2)\n427\t\t\treturn n;\n428\t\n429\t\t/*\n430\t\t * NOTE! We will give precedence to day-of-month over month or\n431\t\t * year numbers in the 1-12 range. So 05 is always \"mday 5\",\n432\t\t * unless we already have a mday..\n433\t\t *\n434\t\t * IOW, 01 Apr 05 parses as \"April 1st, 2005\".\n435\t\t */\n436\t\tif (num > 0 && num < 32 && tm->tm_mday < 0) {\n437\t\t\ttm->tm_mday = num;\n438\t\t\treturn n;\n439\t\t}\n440\t\n441\t\t/* Two-digit year? */\n442\t\tif (n == 2 && tm->tm_year < 0) {\n443\t\t\tif (num < 10 && tm->tm_mday >= 0) {\n444\t\t\t\ttm->tm_year = num + 100;\n445\t\t\t\treturn n;\n446\t\t\t}\n447\t\t\tif (num >= 70) {\n448\t\t\t\ttm->tm_year = num;\n449\t\t\t\treturn n;\n450\t\t\t}\n451\t\t}\n452\t\n453\t\tif (num > 0 && num < 13 && tm->tm_mon < 0)\n454\t\t\ttm->tm_mon = num-1;\n455\t\n456\t\treturn n;\n457\t}\n458\t\n459\tstatic int match_tz(const char *date, int *offp)\n460\t{\n461\t\tchar *end;\n462\t\tint hour = strtoul(date + 1, &end, 10);\n463\t\tint n = end - (date + 1);\n464\t\tint min = 0;\n465\t\n466\t\tif (n == 4) {\n467\t\t\t/* hhmm */\n468\t\t\tmin = hour % 100;\n469\t\t\thour = hour / 100;\n470\t\t} else if (n != 2) {\n471\t\t\tmin = 99; /* random crap */\n472\t\t} else if (*end == ':') {\n473\t\t\t/* hh:mm? */\n474\t\t\tmin = strtoul(end + 1, &end, 10);\n475\t\t\tif (end - (date + 1) != 5)\n476\t\t\t\tmin = 99; /* random crap */\n477\t\t} /* otherwise we parsed \"hh\" */\n478\t\n479\t\t/*\n480\t\t * Don't accept any random crap. Even though some places have\n481\t\t * offset larger than 12 hours (e.g. Pacific/Kiritimati is at\n482\t\t * UTC+14), there is something wrong if hour part is much\n483\t\t * larger than that. We might also want to check that the\n484\t\t * minutes are divisible by 15 or something too. (Offset of\n485\t\t * Kathmandu, Nepal is UTC+5:45)\n486\t\t */\n487\t\tif (min < 60 && hour < 24) {\n488\t\t\tint offset = hour * 60 + min;\n489\t\t\tif (*date == '-')\n490\t\t\t\toffset = -offset;\n491\t\t\t*offp = offset;\n492\t\t}\n493\t\treturn end - date;\n494\t}\n495\t\n496\t/*\n497\t * Parse a string like \"0 +0000\" as ancient timestamp near epoch, but\n498\t * only when it appears not as part of any other string.\n499\t */\n500\tstatic int match_object_header_date(const char *date, struct timeval *tv, int *offset)\n501\t{\n502\t\tchar *end;\n503\t\tunsigned long stamp;\n504\t\tint ofs;\n505\t\n506\t\tif (*date < '0' || '9' < *date)\n507\t\t\treturn -1;\n508\t\tstamp = strtoul(date, &end, 10);\n509\t\tif (*end != ' ' || stamp == ULONG_MAX || (end[1] != '+' && end[1] != '-'))\n510\t\t\treturn -1;\n511\t\tdate = end + 2;\n512\t\tofs = strtol(date, &end, 10);\n513\t\tif ((*end != '\\0' && (*end != '\\n')) || end != date + 4)\n514\t\t\treturn -1;\n515\t\tofs = (ofs / 100) * 60 + (ofs % 100);\n516\t\tif (date[-1] == '-')\n517\t\t\tofs = -ofs;\n518\t\ttv->tv_sec = stamp;\n519\t\t*offset = ofs;\n520\t\treturn 0;\n521\t}\n522\t\n523\t/* Gr. strptime is crap for this; it doesn't have a way to require RFC2822\n524\t   (i.e. English) day/month names, and it doesn't work correctly with %z. */\n525\tint parse_date_basic(const char *date, struct timeval *tv, int *offset)\n526\t{\n527\t\tstruct atm tm;\n528\t\tint tm_gmt;\n529\t\tint dummy_offset;\n530\t\n531\t\tif (!offset)\n532\t\t\toffset = &dummy_offset;\n533\t\n534\t\tmemset(&tm, 0, sizeof(tm));\n535\t\ttm.tm_year = -1;\n536\t\ttm.tm_mon = -1;\n537\t\ttm.tm_mday = -1;\n538\t\ttm.tm_isdst = -1;\n539\t\ttm.tm_hour = -1;\n540\t\ttm.tm_min = -1;\n541\t\ttm.tm_sec = -1;\n542\t\ttm.tm_usec = 0;\n543\t\t*offset = -1;\n544\t\ttm_gmt = 0;\n545\t\n546\t\tif (*date == '@' &&\n547\t\t    !match_object_header_date(date + 1, tv, offset))\n548\t\t\treturn 0; /* success */\n549\t\tfor (;;) {\n550\t\t\tint match = 0;\n551\t\t\tunsigned char c = *date;\n552\t\n553\t\t\t/* Stop at end of string or newline */\n554\t\t\tif (!c || c == '\\n')\n555\t\t\t\tbreak;\n556\t\n557\t\t\tif (isalpha(c))\n558\t\t\t\tmatch = match_alpha(date, &tm, offset);\n559\t\t\telse if (isdigit(c))\n560\t\t\t\tmatch = match_digit(date, &tm, offset, &tm_gmt);\n561\t\t\telse if ((c == '-' || c == '+') && isdigit(date[1]))\n562\t\t\t\tmatch = match_tz(date, offset);\n563\t\n564\t\t\tif (!match) {\n565\t\t\t\t/* BAD CRAP */\n566\t\t\t\tmatch = 1;\n567\t\t\t}\n568\t\n569\t\t\tdate += match;\n570\t\t}\n571\t\n572\t\ttv->tv_usec = tm.tm_usec;\n573\t\n574\t\t/* mktime uses local timezone */\n575\t\ttv->tv_sec = tm_to_time_t(&tm);\n576\t\tif (*offset == -1) {\n577\t\t\ttime_t temp_time = mktime((struct tm*)&tm);\n578\t\t\tif (tv->tv_sec > temp_time) {\n579\t\t\t\t*offset = (tv->tv_sec - temp_time) / 60;\n580\t\t\t} else {\n581\t\t\t\t*offset = -(int)((temp_time - tv->tv_sec) / 60);\n582\t\t\t}\n583\t\t}\n584\t\n585\t\tif (*offset == -1)\n586\t\t\t*offset = (((time_t)tv->tv_sec) - mktime((struct tm*)&tm)) / 60;\n587\t\n588\t\tif (tv->tv_sec == -1)\n589\t\t\treturn -1;\n590\t\n591\t\tif (!tm_gmt)\n592\t\t\ttv->tv_sec -= *offset * 60;\n593\t\n594\t\treturn 0; /* success */\n595\t}\n596\t\n597\t/*\n598\t * Relative time update (eg \"2 days ago\").  If we haven't set the time\n599\t * yet, we need to set it from current time.\n600\t */\n601\tstatic unsigned long update_tm(struct atm *tm, struct atm *now, unsigned long sec)\n602\t{\n603\t\ttime_t n;\n604\t\n605\t\tif (tm->tm_mday < 0)\n606\t\t\ttm->tm_mday = now->tm_mday;\n607\t\tif (tm->tm_mon < 0)\n608\t\t\ttm->tm_mon = now->tm_mon;\n609\t\tif (tm->tm_year < 0) {\n610\t\t\ttm->tm_year = now->tm_year;\n611\t\t\tif (tm->tm_mon > now->tm_mon)\n612\t\t\t\ttm->tm_year--;\n613\t\t}\n614\t\n615\t\tn = mktime((struct tm*)tm) - sec;\n616\t\tlocaltime_r(&n, (struct tm*)tm);\n617\t\treturn n;\n618\t}\n619\t\n620\tstatic void date_now(struct atm *tm, struct atm *now, int *num)\n621\t{\n622\t\tupdate_tm(tm, now, 0);\n623\t}\n624\t\n625\tstatic void date_yesterday(struct atm *tm, struct atm *now, int *num)\n626\t{\n627\t\tupdate_tm(tm, now, 24*60*60);\n628\t}\n629\t\n630\tstatic void date_time(struct atm *tm, struct atm *now, int hour)\n631\t{\n632\t\tif (tm->tm_hour < hour)\n633\t\t\tdate_yesterday(tm, now, NULL);\n634\t\ttm->tm_hour = hour;\n635\t\ttm->tm_min = 0;\n636\t\ttm->tm_sec = 0;\n637\t}\n638\t\n639\tstatic void date_midnight(struct atm *tm, struct atm *now, int *num)\n640\t{\n641\t\tdate_time(tm, now, 0);\n642\t}\n643\t\n644\tstatic void date_noon(struct atm *tm, struct atm *now, int *num)\n645\t{\n646\t\tdate_time(tm, now, 12);\n647\t}\n648\t\n649\tstatic void date_tea(struct atm *tm, struct atm *now, int *num)\n650\t{\n651\t\tdate_time(tm, now, 17);\n652\t}\n653\t\n654\tstatic void date_pm(struct atm *tm, struct atm *now, int *num)\n655\t{\n656\t\tint hour, n = *num;\n657\t\t*num = 0;\n658\t\n659\t\thour = tm->tm_hour;\n660\t\tif (n) {\n661\t\t\thour = n;\n662\t\t\ttm->tm_min = 0;\n663\t\t\ttm->tm_sec = 0;\n664\t\t}\n665\t\ttm->tm_hour = (hour % 12) + 12;\n666\t}\n667\t\n668\tstatic void date_am(struct atm *tm, struct atm *now, int *num)\n669\t{\n670\t\tint hour, n = *num;\n671\t\t*num = 0;\n672\t\n673\t\thour = tm->tm_hour;\n674\t\tif (n) {\n675\t\t\thour = n;\n676\t\t\ttm->tm_min = 0;\n677\t\t\ttm->tm_sec = 0;\n678\t\t}\n679\t\ttm->tm_hour = (hour % 12);\n680\t}\n681\t\n682\tstatic void date_never(struct atm *tm, struct atm *now, int *num)\n683\t{\n684\t\ttime_t n = 0;\n685\t\tlocaltime_r(&n, (struct tm*)tm);\n686\t}\n687\t\n688\tstatic const struct special {\n689\t\tconst char *name;\n690\t\tvoid (*fn)(struct atm *, struct atm *, int *);\n691\t} special[] = {\n692\t\t{ \"yesterday\", date_yesterday },\n693\t\t{ \"noon\", date_noon },\n694\t\t{ \"midnight\", date_midnight },\n695\t\t{ \"tea\", date_tea },\n696\t\t{ \"PM\", date_pm },\n697\t\t{ \"AM\", date_am },\n698\t\t{ \"never\", date_never },\n699\t\t{ \"now\", date_now },\n700\t\t{ NULL }\n701\t};\n702\t\n703\tstatic const char *number_name[] = {\n704\t\t\"zero\", \"one\", \"two\", \"three\", \"four\",\n705\t\t\"five\", \"six\", \"seven\", \"eight\", \"nine\", \"ten\",\n706\t};\n707\t\n708\tstatic const struct typelen {\n709\t\tconst char *type;\n710\t\tint length;\n711\t} typelen[] = {\n712\t\t{ \"seconds\", 1 },\n713\t\t{ \"minutes\", 60 },\n714\t\t{ \"hours\", 60*60 },\n715\t\t{ \"days\", 24*60*60 },\n716\t\t{ \"weeks\", 7*24*60*60 },\n717\t\t{ NULL }\n718\t};\n719\t\n720\tstatic const char *approxidate_alpha(const char *date, struct atm *tm, struct atm *now, int *num, int *touched)\n721\t{\n722\t\tconst struct typelen *tl;\n723\t\tconst struct special *s;\n724\t\tconst char *end = date;\n725\t\tint i;\n726\t\n727\t\twhile (isalpha(*++end))\n728\t\t\t;\n729\t\n730\t\tfor (i = 0; i < 12; i++) {\n731\t\t\tint match = match_string(date, month_names[i]);\n732\t\t\tif (match >= 3) {\n733\t\t\t\ttm->tm_mon = i;\n734\t\t\t\t*touched = 1;\n735\t\t\t\treturn end;\n736\t\t\t}\n737\t\t}\n738\t\n739\t\tfor (s = special; s->name; s++) {\n740\t\t\tint len = strlen(s->name);\n741\t\t\tif (match_string(date, s->name) == len) {\n742\t\t\t\ts->fn(tm, now, num);\n743\t\t\t\t*touched = 1;\n744\t\t\t\treturn end;\n745\t\t\t}\n746\t\t}\n747\t\n748\t\tif (!*num) {\n749\t\t\tfor (i = 1; i < 11; i++) {\n750\t\t\t\tint len = strlen(number_name[i]);\n751\t\t\t\tif (match_string(date, number_name[i]) == len) {\n752\t\t\t\t\t*num = i;\n753\t\t\t\t\t*touched = 1;\n754\t\t\t\t\treturn end;\n755\t\t\t\t}\n756\t\t\t}\n757\t\t\tif (match_string(date, \"last\") == 4) {\n758\t\t\t\t*num = 1;\n759\t\t\t\t*touched = 1;\n760\t\t\t}\n761\t\t\treturn end;\n762\t\t}\n763\t\n764\t\ttl = typelen;\n765\t\twhile (tl->type) {\n766\t\t\tint len = strlen(tl->type);\n767\t\t\tif (match_string(date, tl->type) >= len-1) {\n768\t\t\t\tupdate_tm(tm, now, tl->length * *num);\n769\t\t\t\t*num = 0;\n770\t\t\t\t*touched = 1;\n771\t\t\t\treturn end;\n772\t\t\t}\n773\t\t\ttl++;\n774\t\t}\n775\t\n776\t\tfor (i = 0; i < 7; i++) {\n777\t\t\tint match = match_string(date, weekday_names[i]);\n778\t\t\tif (match >= 3) {\n779\t\t\t\tint diff, n = *num -1;\n780\t\t\t\t*num = 0;\n781\t\n782\t\t\t\tdiff = tm->tm_wday - i;\n783\t\t\t\tif (diff <= 0)\n784\t\t\t\t\tn++;\n785\t\t\t\tdiff += 7*n;\n786\t\n787\t\t\t\tupdate_tm(tm, now, diff * 24 * 60 * 60);\n788\t\t\t\t*touched = 1;\n789\t\t\t\treturn end;\n790\t\t\t}\n791\t\t}\n792\t\n793\t\tif (match_string(date, \"months\") >= 5) {\n794\t\t\tint n;\n795\t\t\tupdate_tm(tm, now, 0); /* fill in date fields if needed */\n796\t\t\tn = tm->tm_mon - *num;\n797\t\t\t*num = 0;\n798\t\t\twhile (n < 0) {\n799\t\t\t\tn += 12;\n800\t\t\t\ttm->tm_year--;\n801\t\t\t}\n802\t\t\ttm->tm_mon = n;\n803\t\t\t*touched = 1;\n804\t\t\treturn end;\n805\t\t}\n806\t\n807\t\tif (match_string(date, \"years\") >= 4) {\n808\t\t\tupdate_tm(tm, now, 0); /* fill in date fields if needed */\n809\t\t\ttm->tm_year -= *num;\n810\t\t\t*num = 0;\n811\t\t\t*touched = 1;\n812\t\t\treturn end;\n813\t\t}\n814\t\n815\t\treturn end;\n816\t}\n817\t\n818\tstatic const char *approxidate_digit(const char *date, struct atm *tm, int *num,\n819\t\t\t\t\t     time_t now)\n820\t{\n821\t\tchar *end;\n822\t\tunsigned long number = strtoul(date, &end, 10);\n823\t\n824\t\tswitch (*end) {\n825\t\tcase ':':\n826\t\tcase '.':\n827\t\tcase '/':\n828\t\tcase '-':\n829\t\t\tif (isdigit(end[1])) {\n830\t\t\t\tint match = match_multi_number(number, *end, date, end,\n831\t\t\t\t\t\t\t       tm, now);\n832\t\t\t\tif (match)\n833\t\t\t\t\treturn date + match;\n834\t\t\t}\n835\t\t}\n836\t\n837\t\t/* Accept zero-padding only for small numbers (\"Dec 02\", never \"Dec 0002\") */\n838\t\tif (date[0] != '0' || end - date <= 2)\n839\t\t\t*num = number;\n840\t\treturn end;\n841\t}\n842\t\n843\t/*\n844\t * Do we have a pending number at the end, or when\n845\t * we see a new one? Let's assume it's a month day,\n846\t * as in \"Dec 6, 1992\"\n847\t */\n848\tstatic void pending_number(struct atm *tm, int *num)\n849\t{\n850\t\tint number = *num;\n851\t\n852\t\tif (number) {\n853\t\t\t*num = 0;\n854\t\t\tif (tm->tm_mday < 0 && number < 32)\n855\t\t\t\ttm->tm_mday = number;\n856\t\t\telse if (tm->tm_mon < 0 && number < 13)\n857\t\t\t\ttm->tm_mon = number-1;\n858\t\t\telse if (tm->tm_year < 0) {\n859\t\t\t\tif (number > 1969 && number < 2100)\n860\t\t\t\t\ttm->tm_year = number - 1900;\n861\t\t\t\telse if (number > 69 && number < 100)\n862\t\t\t\t\ttm->tm_year = number;\n863\t\t\t\telse if (number < 38)\n864\t\t\t\t\ttm->tm_year = 100 + number;\n865\t\t\t\t/* We screw up for number = 00 ? */\n866\t\t\t}\n867\t\t}\n868\t}\n869\t\n870\tstatic int approxidate_str(const char *date, struct timeval *tv)\n871\t{\n872\t\tint number = 0;\n873\t\tint touched = 0;\n874\t\tstruct atm tm, now;\n875\t\ttime_t time_sec;\n876\t\n877\t\ttime_sec = tv->tv_sec;\n878\t\tlocaltime_r(&time_sec, (struct tm*)&tm);\n879\t\tnow = tm;\n880\t\n881\t\ttm.tm_year = -1;\n882\t\ttm.tm_mon = -1;\n883\t\ttm.tm_mday = -1;\n884\t\ttm.tm_usec = tv->tv_usec;\n885\t\n886\t\tfor (;;) {\n887\t\t\tunsigned char c = *date;\n888\t\t\tif (!c)\n889\t\t\t\tbreak;\n890\t\t\tdate++;\n891\t\t\tif (isdigit(c)) {\n892\t\t\t\tpending_number(&tm, &number);\n893\t\t\t\tdate = approxidate_digit(date-1, &tm, &number, time_sec);\n894\t\t\t\ttouched = 1;\n895\t\t\t\tcontinue;\n896\t\t\t}\n897\t\t\tif (isalpha(c))\n898\t\t\t\tdate = approxidate_alpha(date-1, &tm, &now, &number, &touched);\n899\t\t}\n900\t\n901\t\tpending_number(&tm, &number);\n902\t\tif (!touched)\n903\t\t\treturn -1;\n904\t\n905\t\ttv->tv_usec = tm.tm_usec;\n906\t\ttv->tv_sec = update_tm(&tm, &now, 0);\n907\t\n908\t\treturn 0;\n909\t}\n910\t\n911\tint approxidate(const char *date, struct timeval *tv)\n912\t{\n913\t\treturn approxidate_relative(date, tv, NULL);\n914\t}\n915\t\n916\tint approxidate_relative(\n917\t\tconst char *date,\n918\t\tstruct timeval *tv,\n919\t\tconst struct timeval *relative_to)\n920\t{\n921\t\tint offset;\n922\t\tif (!parse_date_basic(date, tv, &offset)) {\n923\t\t\treturn 0;\n924\t\t}\n925\t\n926\t\tif (relative_to == NULL) {\n927\t\t\tgettimeofday(tv, NULL);\n928\t\t} else {\n929\t\t\t*tv = *relative_to;\n930\t\t}\n931\t\n932\t\tif (!approxidate_str(date, tv)) {\n933\t\t\treturn 0;\n934\t\t}\n935\t\n936\t\treturn -1;\n937\t}\n938\t"}]},"parent_tool_use_id":null,"session_id":"2278f4d7-5830-46e0-9a2b-46cdd556e072","uuid":"ab6eee27-e804-47ab-aae5-bc5ae6d56584","timestamp":"2026-05-28T18:03:33.236Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-RUAMO1/project/c_src/approxidate.c","content":"/*\n * Approxidate, taken from git.\n *\n * Copyright (C) Linus Torvalds, 2005\n */\n\n#define _POSIX_C_SOURCE 200809L\n#include \"approxidate.h\"\n\n#include <math.h>\n#include <string.h>\n#include <time.h>\n#include <limits.h>\n#include <stdlib.h>\n\n/**\n * Maintains compatibility with the default struct tm,\n * but adds a field for usec.\n */\nstruct atm {\n\tint tm_sec;\n\tint tm_min;\n\tint tm_hour;\n\tint tm_mday;\n\tint tm_mon;\n\tint tm_year;\n\tint tm_wday;\n\tint tm_yday;\n\tint tm_isdst;\n\tlong tm_usec;\n};\n\n#define GIT_SPACE 0x01\n#define GIT_DIGIT 0x02\n#define GIT_ALPHA 0x04\n#define GIT_GLOB_SPECIAL 0x08\n#define GIT_REGEX_SPECIAL 0x10\n#define GIT_PATHSPEC_MAGIC 0x20\n#define GIT_CNTRL 0x40\n#define GIT_PUNCT 0x80\n#define sane_istest(x,mask) ((sane_ctype[(unsigned char)(x)] & (mask)) != 0)\n#define isdigit(x) sane_istest(x,GIT_DIGIT)\n#define isalpha(x) sane_istest(x,GIT_ALPHA)\n#define isalnum(x) sane_istest(x,GIT_ALPHA | GIT_DIGIT)\n#define toupper(x) sane_case((unsigned char)(x), 0)\n#define ARRAY_SIZE(x) (sizeof(x)/sizeof(x[0]))\n\nenum {\n\tS = GIT_SPACE,\n\tA = GIT_ALPHA,\n\tD = GIT_DIGIT,\n\tG = GIT_GLOB_SPECIAL,\t/* *, ?, [, \\\\ */\n\tR = GIT_REGEX_SPECIAL,\t/* $, (, ), +, ., ^, {, | */\n\tP = GIT_PATHSPEC_MAGIC, /* other non-alnum, except for ] and } */\n\tX = GIT_CNTRL,\n\tU = GIT_PUNCT,\n\tZ = GIT_CNTRL | GIT_SPACE\n};\n\nconst unsigned char sane_ctype[256] = {\n\tX, X, X, X, X, X, X, X, X, Z, Z, X, X, Z, X, X,\t\t/*   0.. 15 */\n\tX, X, X, X, X, X, X, X, X, X, X, X, X, X, X, X,\t\t/*  16.. 31 */\n\tS, P, P, P, R, P, P, P, R, R, G, R, P, P, R, P,\t\t/*  32.. 47 */\n\tD, D, D, D, D, D, D, D, D, D, P, P, P, P, P, G,\t\t/*  48.. 63 */\n\tP, A, A, A, A, A, A, A, A, A, A, A, A, A, A, A,\t\t/*  64.. 79 */\n\tA, A, A, A, A, A, A, A, A, A, A, G, G, U, R, P,\t\t/*  80.. 95 */\n\tP, A, A, A, A, A, A, A, A, A, A, A, A, A, A, A,\t\t/*  96..111 */\n\tA, A, A, A, A, A, A, A, A, A, A, R, R, U, P, X,\t\t/* 112..127 */\n\t/* Nothing in the 128.. range */\n};\n\nstatic inline int sane_case(int x, int high)\n{\n\tif (sane_istest(x, GIT_ALPHA))\n\t\tx = (x & ~0x20) | high;\n\treturn x;\n}\n\n/*\n * This is like mktime, but without normalization of tm_wday and tm_yday.\n */\nstatic time_t tm_to_time_t(const struct atm *tm)\n{\n\tstatic const int mdays[] = {\n\t    0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334\n\t};\n\tint year = tm->tm_year - 70;\n\tint month = tm->tm_mon;\n\tint day = tm->tm_mday;\n\n\tif (year < 0 || year > 129) /* algo only works for 1970-2099 */\n\t\treturn -1;\n\tif (month < 0 || month > 11) /* array bounds */\n\t\treturn -1;\n\tif (month < 2 || (year + 2) % 4)\n\t\tday--;\n\tif (tm->tm_hour < 0 || tm->tm_min < 0 || tm->tm_sec < 0)\n\t\treturn -1;\n\treturn (year * 365 + (year + 1) / 4 + mdays[month] + day) * 24*60*60UL +\n\t\ttm->tm_hour * 60*60 + tm->tm_min * 60 + tm->tm_sec;\n}\n\nstatic const char *month_names[] = {\n\t\"January\", \"February\", \"March\", \"April\", \"May\", \"June\",\n\t\"July\", \"August\", \"September\", \"October\", \"November\", \"December\"\n};\n\nstatic const char *weekday_names[] = {\n\t\"Sundays\", \"Mondays\", \"Tuesdays\", \"Wednesdays\", \"Thursdays\", \"Fridays\", \"Saturdays\"\n};\n\n/*\n * Check these. And note how it doesn't do the summer-time conversion.\n *\n * In my world, it's always summer, and things are probably a bit off\n * in other ways too.\n */\nstatic const struct {\n\tconst char *name;\n\tint offset;\n\tint dst;\n} timezone_names[] = {\n\t{ \"IDLW\", -12, 0, },\t/* International Date Line West */\n\t{ \"NT\",   -11, 0, },\t/* Nome */\n\t{ \"CAT\",  -10, 0, },\t/* Central Alaska */\n\t{ \"HST\",  -10, 0, },\t/* Hawaii Standard */\n\t{ \"HDT\",  -10, 1, },\t/* Hawaii Daylight */\n\t{ \"YST\",   -9, 0, },\t/* Yukon Standard */\n\t{ \"YDT\",   -9, 1, },\t/* Yukon Daylight */\n\t{ \"PST\",   -8, 0, },\t/* Pacific Standard */\n\t{ \"PDT\",   -8, 1, },\t/* Pacific Daylight */\n\t{ \"MST\",   -7, 0, },\t/* Mountain Standard */\n\t{ \"MDT\",   -7, 1, },\t/* Mountain Daylight */\n\t{ \"CST\",   -6, 0, },\t/* Central Standard */\n\t{ \"CDT\",   -6, 1, },\t/* Central Daylight */\n\t{ \"EST\",   -5, 0, },\t/* Eastern Standard */\n\t{ \"EDT\",   -5, 1, },\t/* Eastern Daylight */\n\t{ \"AST\",   -3, 0, },\t/* Atlantic Standard */\n\t{ \"ADT\",   -3, 1, },\t/* Atlantic Daylight */\n\t{ \"WAT\",   -1, 0, },\t/* West Africa */\n\t{ \"GMT\",    0, 0, },\t/* Greenwich Mean */\n\t{ \"UTC\",    0, 0, },\t/* Universal (Coordinated) */\n\t{ \"Z\",      0, 0, },    /* Zulu, alias for UTC */\n\t{ \"WET\",    0, 0, },\t/* Western European */\n\t{ \"BST\",    0, 1, },\t/* British Summer */\n\t{ \"CET\",   +1, 0, },\t/* Central European */\n\t{ \"MET\",   +1, 0, },\t/* Middle European */\n\t{ \"MEWT\",  +1, 0, },\t/* Middle European Winter */\n\t{ \"MEST\",  +1, 1, },\t/* Middle European Summer */\n\t{ \"CEST\",  +1, 1, },\t/* Central European Summer */\n\t{ \"MESZ\",  +1, 1, },\t/* Middle European Summer */\n\t{ \"FWT\",   +1, 0, },\t/* French Winter */\n\t{ \"FST\",   +1, 1, },\t/* French Summer */\n\t{ \"EET\",   +2, 0, },\t/* Eastern Europe, USSR Zone 1 */\n\t{ \"EEST\",  +2, 1, },\t/* Eastern European Daylight */\n\t{ \"WAST\",  +7, 0, },\t/* West Australian Standard */\n\t{ \"WADT\",  +7, 1, },\t/* West Australian Daylight */\n\t{ \"CCT\",   +8, 0, },\t/* China Coast, USSR Zone 7 */\n\t{ \"JST\",   +9, 0, },\t/* Japan Standard, USSR Zone 8 */\n\t{ \"EAST\", +10, 0, },\t/* Eastern Australian Standard */\n\t{ \"EADT\", +10, 1, },\t/* Eastern Australian Daylight */\n\t{ \"GST\",  +10, 0, },\t/* Guam Standard, USSR Zone 9 */\n\t{ \"NZT\",  +12, 0, },\t/* New Zealand */\n\t{ \"NZST\", +12, 0, },\t/* New Zealand Standard */\n\t{ \"NZDT\", +12, 1, },\t/* New Zealand Daylight */\n\t{ \"IDLE\", +12, 0, },\t/* International Date Line East */\n};\n\nstatic int match_string(const char *date, const char *str)\n{\n\tint i = 0;\n\n\tfor (i = 0; *date; date++, str++, i++) {\n\t\tif (*date == *str)\n\t\t\tcontinue;\n\t\tif (toupper(*date) == toupper(*str))\n\t\t\tcontinue;\n\t\tif (!isalnum(*date))\n\t\t\tbreak;\n\t\treturn 0;\n\t}\n\treturn i;\n}\n\nstatic int skip_alpha(const char *date)\n{\n\tint i = 0;\n\tdo {\n\t\ti++;\n\t} while (isalpha(date[i]));\n\treturn i;\n}\n\n/*\n* Parse month, weekday, or timezone name\n*/\nstatic int match_alpha(const char *date, struct atm *tm, int *offset)\n{\n\tint i;\n\n\tfor (i = 0; i < 12; i++) {\n\t\tint match = match_string(date, month_names[i]);\n\t\tif (match >= 3) {\n\t\t\ttm->tm_mon = i;\n\t\t\treturn match;\n\t\t}\n\t}\n\n\tfor (i = 0; i < 7; i++) {\n\t\tint match = match_string(date, weekday_names[i]);\n\t\tif (match >= 3) {\n\t\t\ttm->tm_wday = i;\n\t\t\treturn match;\n\t\t}\n\t}\n\n\tfor (i = 0; i < ARRAY_SIZE(timezone_names); i++) {\n\t\tint match = match_string(date, timezone_names[i].name);\n\t\tif (match >= 3 || match == strlen(timezone_names[i].name)) {\n\t\t\tint off = timezone_names[i].offset;\n\n\t\t\t/* This is bogus, but we like summer */\n\t\t\toff += timezone_names[i].dst;\n\n\t\t\t/* Only use the tz name offset if we don't have anything better */\n\t\t\tif (*offset == -1)\n\t\t\t\t*offset = 60*off;\n\n\t\t\treturn match;\n\t\t}\n\t}\n\n\tif (match_string(date, \"PM\") == 2) {\n\t\ttm->tm_hour = (tm->tm_hour % 12) + 12;\n\t\treturn 2;\n\t}\n\n\tif (match_string(date, \"AM\") == 2) {\n\t\ttm->tm_hour = (tm->tm_hour % 12) + 0;\n\t\treturn 2;\n\t}\n\n\t/* BAD CRAP */\n\treturn skip_alpha(date);\n}\n\nstatic int is_date(int year, int month, int day, struct atm *now_tm, time_t now, struct atm *tm)\n{\n\tif (month > 0 && month < 13 && day > 0 && day < 32) {\n\t\tstruct atm check = *tm;\n\t\tstruct atm *r = (now_tm ? &check : tm);\n\n\t\tr->tm_mon = month - 1;\n\t\tr->tm_mday = day;\n\t\tif (year == -1) {\n\t\t\tif (!now_tm)\n\t\t\t\treturn 1;\n\t\t\tr->tm_year = now_tm->tm_year;\n\t\t}\n\t\telse if (year >= 1970 && year < 2100)\n\t\t\tr->tm_year = year - 1900;\n\t\telse if (year > 70 && year < 100)\n\t\t\tr->tm_year = year;\n\t\telse if (year < 38)\n\t\t\tr->tm_year = year + 100;\n\t\telse\n\t\t\treturn 0;\n\t\tif (!now_tm)\n\t\t\treturn 1;\n\n\t\ttm->tm_mon = r->tm_mon;\n\t\ttm->tm_mday = r->tm_mday;\n\t\tif (year != -1)\n\t\t\ttm->tm_year = r->tm_year;\n\t\treturn 1;\n\t}\n\treturn 0;\n}\n\nstatic int match_multi_number(unsigned long num, char c, const char *date,\n\t\t\t      char *end, struct atm *tm, time_t now)\n{\n\tlong num2, num3, num4;\n\n\tnum2 = strtol(end+1, &end, 10);\n\tnum3 = -1;\n\tnum4 = 0;\n\tif (*end == c && isdigit(end[1])) {\n\t\tnum3 = strtol(end+1, &end, 10);\n\n\t\tif (*end == '.') {\n\t\t\tchar *start = end+1;\n\t\t\tnum4 = strtol(end+1, &end, 10);\n\t\t\tif ((end - start) < 6) {\n\t\t\t\tnum4 *= (long)pow(10, 6 - (end - start));\n\t\t\t}\n\t\t}\n\t}\n\n\n\t/* Time? Date? */\n\tswitch (c) {\n\tcase ':':\n\t\tif (num3 < 0)\n\t\t\tnum3 = 0;\n\t\tif (num < 25 && num2 >= 0 && num2 < 60 && num3 >= 0 && num3 <= 60) {\n\t\t\ttm->tm_hour = num;\n\t\t\ttm->tm_min = num2;\n\t\t\ttm->tm_sec = num3;\n\t\t\ttm->tm_usec = num4;\n\t\t\tbreak;\n\t\t}\n\t\treturn 0;\n\n\tcase '-':\n\tcase '/':\n\tcase '.':\n\t\tif (!now)\n\t\t\tnow = time(NULL);\n\t\tif (num > 70) {\n\t\t\t/* yyyy-mm-dd? */\n\t\t\tif (is_date(num, num2, num3, NULL, now, tm))\n\t\t\t\tbreak;\n\t\t\t/* yyyy-dd-mm? */\n\t\t\tif (is_date(num, num3, num2, NULL, now, tm))\n\t\t\t\tbreak;\n\t\t}\n\t\t/* Our eastern European friends say dd.mm.yy[yy]\n\t\t * is the norm there, so giving precedence to\n\t\t * mm/dd/yy[yy] form only when separator is not '.'\n\t\t */\n\t\tif (c != '.' &&\n\t\t    is_date(num3, num, num2, NULL, now, tm))\n\t\t\tbreak;\n\t\t/* European dd.mm.yy[yy] or funny US dd/mm/yy[yy] */\n\t\tif (is_date(num3, num2, num, NULL, now, tm))\n\t\t\tbreak;\n\t\t/* Funny European mm.dd.yy */\n\t\tif (c == '.' &&\n\t\t    is_date(num3, num, num2, NULL, now, tm))\n\t\t\tbreak;\n\t\treturn 0;\n\t}\n\treturn end - date;\n}\n\n/*\n * Have we filled in any part of the time/date yet?\n * We just do a binary 'and' to see if the sign bit\n * is set in all the values.\n */\nstatic inline int nodate(struct tm *tm)\n{\n\treturn (tm->tm_year &\n\t\ttm->tm_mon &\n\t\ttm->tm_mday &\n\t\ttm->tm_hour &\n\t\ttm->tm_min &\n\t\ttm->tm_sec) < 0;\n}\n\n/*\n * We've seen a digit. Time? Year? Date?\n */\nstatic int match_digit(const char *date, struct atm *tm, int *offset, int *tm_gmt)\n{\n\tint n;\n\tchar *end;\n\tunsigned long num;\n\n\tnum = strtoul(date, &end, 10);\n\n\t/*\n\t * Seconds since 1970? We trigger on that for any numbers with\n\t * more than 8 digits. This is because we don't want to rule out\n\t * numbers like 20070606 as a YYYYMMDD date.\n\t */\n\tif (num >= 100000000 && nodate((struct tm*)tm)) {\n\t\ttime_t time = num;\n\t\tif (gmtime_r(&time, (struct tm*)tm)) {\n\t\t\t*tm_gmt = 1;\n\t\t\treturn end - date;\n\t\t}\n\t}\n\n\t/*\n\t * Check for special formats: num[-.:/]num[same]num[.secfracs]\n\t */\n\tswitch (*end) {\n\tcase ':':\n\tcase '.':\n\tcase '/':\n\tcase '-':\n\t\tif (isdigit(end[1])) {\n\t\t\tint match = match_multi_number(num, *end, date, end, tm, 0);\n\t\t\tif (match)\n\t\t\t\treturn match;\n\t\t}\n\t}\n\n\t/*\n\t * None of the special formats? Try to guess what\n\t * the number meant. We use the number of digits\n\t * to make a more educated guess..\n\t */\n\tn = 0;\n\tdo {\n\t\tn++;\n\t} while (isdigit(date[n]));\n\n\t/* Four-digit year or a timezone? */\n\tif (n == 4) {\n\t\tif (num <= 1400 && *offset == -1) {\n\t\t\tunsigned int minutes = num % 100;\n\t\t\tunsigned int hours = num / 100;\n\t\t\t*offset = hours*60 + minutes;\n\t\t} else if (num > 1900 && num < 2100)\n\t\t\ttm->tm_year = num - 1900;\n\t\treturn n;\n\t}\n\n\t/*\n\t * Ignore lots of numerals. We took care of 4-digit years above.\n\t * Days or months must be one or two digits.\n\t */\n\tif (n > 2)\n\t\treturn n;\n\n\t/*\n\t * NOTE! We will give precedence to day-of-month over month or\n\t * year numbers in the 1-12 range. So 05 is always \"mday 5\",\n\t * unless we already have a mday..\n\t *\n\t * IOW, 01 Apr 05 parses as \"April 1st, 2005\".\n\t */\n\tif (num > 0 && num < 32 && tm->tm_mday < 0) {\n\t\ttm->tm_mday = num;\n\t\treturn n;\n\t}\n\n\t/* Two-digit year? */\n\tif (n == 2 && tm->tm_year < 0) {\n\t\tif (num < 10 && tm->tm_mday >= 0) {\n\t\t\ttm->tm_year = num + 100;\n\t\t\treturn n;\n\t\t}\n\t\tif (num >= 70) {\n\t\t\ttm->tm_year = num;\n\t\t\treturn n;\n\t\t}\n\t}\n\n\tif (num > 0 && num < 13 && tm->tm_mon < 0)\n\t\ttm->tm_mon = num-1;\n\n\treturn n;\n}\n\nstatic int match_tz(const char *date, int *offp)\n{\n\tchar *end;\n\tint hour = strtoul(date + 1, &end, 10);\n\tint n = end - (date + 1);\n\tint min = 0;\n\n\tif (n == 4) {\n\t\t/* hhmm */\n\t\tmin = hour % 100;\n\t\thour = hour / 100;\n\t} else if (n != 2) {\n\t\tmin = 99; /* random crap */\n\t} else if (*end == ':') {\n\t\t/* hh:mm? */\n\t\tmin = strtoul(end + 1, &end, 10);\n\t\tif (end - (date + 1) != 5)\n\t\t\tmin = 99; /* random crap */\n\t} /* otherwise we parsed \"hh\" */\n\n\t/*\n\t * Don't accept any random crap. Even though some places have\n\t * offset larger than 12 hours (e.g. Pacific/Kiritimati is at\n\t * UTC+14), there is something wrong if hour part is much\n\t * larger than that. We might also want to check that the\n\t * minutes are divisible by 15 or something too. (Offset of\n\t * Kathmandu, Nepal is UTC+5:45)\n\t */\n\tif (min < 60 && hour < 24) {\n\t\tint offset = hour * 60 + min;\n\t\tif (*date == '-')\n\t\t\toffset = -offset;\n\t\t*offp = offset;\n\t}\n\treturn end - date;\n}\n\n/*\n * Parse a string like \"0 +0000\" as ancient timestamp near epoch, but\n * only when it appears not as part of any other string.\n */\nstatic int match_object_header_date(const char *date, struct timeval *tv, int *offset)\n