r/2013:00:00:02\", \"%d/%b/%Y:%T\", &m) != NULL);\n\t}\n\n\tprintf(\"strptime time: %lf\\n\", monotonic_now() - start);\n}\n\nint main()\n{\n\tif (!approxidate_test()) {\n\t\treturn EXIT_FAILURE;\n\t}\n\n\tapproxidate_benchmark();\n\n\treturn EXIT_SUCCESS;\n}\n","numLines":189,"startLine":1,"totalLines":189}}}
