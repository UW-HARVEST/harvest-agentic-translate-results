T_IN_REDEEM_SCRIPT;\n70\t\trec.key_size = 0;\n71\t\trec.val      = (unsigned char*)redeem_script_b;\n72\t\trec.val_size = ARRAY_SIZE(redeem_script_b);\n73\t\n74\t\tres = psbt_write_input_record(&psbt, &rec);\n75\t\tCHECKRES(res);\n76\t\n77\t\tres = psbt_new_output_record_set(&psbt);\n78\t\tCHECKRES(res);\n79\t\n80\t\tres = psbt_print(&psbt, stdout);\n81\t\tassert(res == PSBT_INVALID_STATE);\n82\t\n83\t\tres = psbt_finalize(&psbt);\n84\t\tCHECKRES(res);\n85\t\n86\t\tres = psbt_print(&psbt, stdout);\n87\t\tCHECKRES(res);\n88\t}\n89\t\n90\tvoid read_test_vector_checker(struct psbt_elem *elem) {\n91\t\tint *step = (int*)elem->user_data;\n92\t\n93\t\tswitch (elem->type) {\n94\t\tcase PSBT_ELEM_RECORD:\n95\t\t\tswitch (*step) {\n96\t\t\tcase 0:\n97\t\t\t\tassert(elem->elem.rec->type == PSBT_GLOBAL_UNSIGNED_TX);\n98\t\t\t\tbreak;\n99\t\t\tcase 1:\n100\t\t\t\tassert(elem->elem.rec->type == PSBT_IN_NON_WITNESS_UTXO);\n101\t\t\t\tbreak;\n102\t\t\t}\n103\t\t\tbreak;\n104\t\tdefault:\n105\t\t\tbreak;\n106\t\t}\n107\t\n108\t\t(*step)++;\n109\t}\n110\t\n111\tvoid read_test_vector() {\n112\t\tstatic unsigned char buf[2048];\n113\t\tstatic unsigned char intbuf[2048];\n114\t\tsize_t psbt_len;\n115\t\tsize_t hexlen = strlen(psbt_hex);\n116\t\tstruct psbt psbt;\n117\t\tenum psbt_result res;\n118\t\tint step = 0;\n119\t\n120\t\tres = psbt_decode(psbt_hex, hexlen, buf, 2048, &psbt_len);\n121\t\tCHECKRES(res);\n122\t\n123\t\tpsbt_init(&psbt, intbuf, 2048);\n124\t\n125\t\tres = psbt_read(buf, psbt_len, &psbt, read_test_vector_checker, &step);\n126\t\tCHECKRES(res);\n127\t\n128\t}\n129\t\n130\tvoid encode_decode_test() {\n131\t\tunsigned char buf[2048];\n132\t\tunsigned char intbuf[2048];\n133\t\tsize_t psbt_len;\n134\t\tsize_t hexlen = strlen(psbt_hex);\n135\t\tstruct psbt psbt;\n136\t\tenum psbt_result res;\n137\t\n138\t\tres = psbt_decode(psbt_hex, hexlen, intbuf, 2048, &psbt_len);\n139\t\tCHECKRES(res);\n140\t\n141\t\tassert(psbt_len == hexlen / 2);\n142\t\n143\t\tpsbt_init(&psbt, intb