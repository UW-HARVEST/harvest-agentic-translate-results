h_cutoff;\n47\t}\n48\t\n49\tstatic bool INLINE rset_is_array(const rset_t *set)\n50\t{\n51\t    unsigned cardinality = *set->buffer;\n52\t    return cardinality <= low_cutoff;\n53\t}\n54\t\n55\tstatic bool INLINE rset_is_inverted_array(const rset_t *set)\n56\t{\n57\t    unsigned cardinality = *set->buffer;\n58\t    return cardinality > high_cutoff;\n59\t}\n60\t\n61\tunsigned rset_cardinality(const rset_t *set)\n62\t{\n63\t    if (rset_is_full(set))\n64\t        return max_cardinality;\n65\t    if (rset_is_empty(set))\n66\t        return 0;\n67\t    return *set->buffer;\n68\t}\n69\t\n70\tbool rset_truncate(rset_t *set)\n71\t{\n72\t    set->buffer[0] = 2;\n73\t    set->buffer[1] = max_item;\n74\t    return true;\n75\t}\n76\t\n77\tbool rset_fill(rset_t *set)\n78\t{\n79\t    set->buffer[0] = 0;\n80\t    return true;\n81\t}\n82\t\n83\trset_t *rset_import(const void *buffer, unsigned length)\n84\t{\n85\t    rset_t *set = malloc(sizeof(rset_t));\n86\t    if (!set)\n87\t        return NULL;\n88\t    unsigned size = length ? length : 1;\n89\t    if (size > max_size)\n90\t        size = max_size;\n91\t    set->buffer = malloc(sizeof(uint16_t) * (1 + size));\n92\t    if (!set->buffer) {\n93\t        free(set);\n94\t        return NULL;\n95\t    }\n96\t    set->size = size;\n97\t    if (buffer && length)\n98\t        memcpy(set->buffer, buffer, length);\n99\t    else\n100\t        rset_truncate(set);\n101\t    return set;\n102\t}\n103\t\n104\trset_t *rset_new()\n105\t{\n106\t    return rset_import(NULL, default_size);\n107\t}\n108\t\n109\tvoid rset_free(rset_t *set)\n110\t{\n111\t    free(set->buffer);\n112\t    free(set);\n113\t}\n114\t\n115\tconst void *rset_export(const rset_t *set)\n116\t{\n117\t    return set->buffer;\n118\t}\n119\t\n120\trset_t *rset_copy(const rset_t *set)\n121\t{\n122\t    return rset_import(rset_export(set), rset_length(set));\n123\t}\n124\t\n125\tstatic unsigned INLINE rset_length_for(unsigned cardinality)\n126\t{\n127\t    if (!cardinality)\n128\t   