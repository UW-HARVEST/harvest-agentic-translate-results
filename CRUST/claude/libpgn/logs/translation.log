94\t#[test]\n95\tfn test_parsing_bunch_of_moves() {\n96\t    let mut moves: PgnMoves;\n97\t\n98\t    moves = PgnMoves::from(\"1.e4 e5\");\n99\t    assert_eq!(moves.values[0].white.notation, \"e4\");\n100\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n101\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n102\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n103\t    assert_eq!(moves.values[0].white.captures, false);\n104\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n105\t    assert_eq!(moves.values[0].black.notation, \"e5\");\n106\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n107\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n108\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n109\t    assert_eq!(moves.values[0].black.captures, false);\n110\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n111\t\n112\t    moves = PgnMoves::from(\"1.e4 $2 e5 $1\");\n113\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n114\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n115\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n116\t    assert_eq!(moves.values[0].white.captures, false);\n117\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::GoodMove);\n118\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n119\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n120\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n121\t    assert_eq!(moves.values[0].black.captures, false);\n122\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Mistake);\n123\t\n124\t    moves = PgnMoves::from(\"69.Be4 69... Rxe5?!\");\n125\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Bishop);\n126\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n127\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n128\t    assert_eq!(moves.values[0].white.captures, false);\n129\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n130\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Rook);\n131\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n132\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n133\t    assert_eq!(moves.values[0].black.captures, true);\n134\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::DubiousMove);\n135\t\n136\t    moves = PgnMoves::from(\"9.e4 { This is a comment :O } e5 10. Nc3 Nc6\");\n137\t    assert_eq!(\n138\t        moves.values[0]\n139\t            .white\n140\t            .comments\n141\t            .as_ref()\n142\t            .unwrap()\n143\t            .values\n144\t            .len(),\n145\t        1\n146\t    );\n147\t    assert_eq!(\n148\t        moves.values[0].white.comments.as_ref().unwrap().values[0].value,\n149\t        \" This is a comment :O \"\n150\t    );\n151\t    assert_eq!(\n152\t        moves.values[0].white.comments.as_ref().unwrap().values[0].position,\n153\t        PgnCommentPosition::AfterMove\n154\t    );\n155\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n156\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n157\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n158\t    assert_eq!(moves.values[0].white.captures, false);\n159\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n160\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n161\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n162\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n163\t    assert_eq!(moves.values[0].black.captures, false);\n164\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n165\t\n166\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n167\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n168\t    assert_eq!(moves.values[1].white.dest.rank, Some(3));\n169\t    assert_eq!(moves.values[1].white.cap