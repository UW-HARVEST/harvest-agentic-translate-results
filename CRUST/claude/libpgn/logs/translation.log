->values[0]->values[0].white.dest.rank == 4);\n230\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.captures == false);\n231\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n232\t\n233\t    suite6_assert(moves->values[1].white.piece == PGN_PIECE_KNIGHT);\n234\t    suite6_assert(moves->values[1].white.dest.file == 'c');\n235\t    suite6_assert(moves->values[1].white.dest.rank == 3);\n236\t    suite6_assert(moves->values[1].white.captures == false);\n237\t    suite6_assert(moves->values[1].white.annotation == PGN_ANNOTATION_UNKNOWN);\n238\t\n239\t    suite6_assert(moves->values[1].black.piece == PGN_PIECE_KNIGHT);\n240\t    suite6_assert(moves->values[1].black.dest.file == 'c');\n241\t    suite6_assert(moves->values[1].black.dest.rank == 6);\n242\t    suite6_assert(moves->values[1].black.captures == false);\n243\t    suite6_assert(moves->values[1].black.annotation == PGN_ANNOTATION_UNKNOWN);\n244\t    pgn_moves_cleanup(moves);\n245\t}\n246\t\n247\tvoid test_parsing_en_passant()\n248\t{\n249\t    pgn_move_t move = pgn_parse_move(\"exd6 e.p.\");\n250\t    suite6_assert(move.piece == PGN_PIECE_PAWN);\n251\t    suite6_assert(move.en_passant);\n252\t    suite6_assert(move.from.file == 'e');\n253\t    suite6_assert(move.dest.file == 'd');\n254\t    suite6_assert(move.dest.rank == 6);\n255\t    suite6_assert(move.captures);\n256\t\n257\t    pgn_moves_t *moves = pgn_parse_moves(\"1. d4 exd3 e.p. 2.  Nc4 Nc6 3. cxb3 e.p. 3... Be4\");\n258\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_PAWN);\n259\t    suite6_assert(moves->values[0].white.dest.file == 'd');\n260\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n261\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"d4\"));\n262\t    suite6_assert(!moves->values[0].white.en_passant);\n263\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_PAWN);\n264\t    suite6_assert(moves->values[0].black.from.file == 'e');\n265\t    suite6_assert(moves->values[0].black.dest.file == 'd');\n266\t    suite6_assert(moves->values[0].black.dest.rank == 3);\n267\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"exd3 e.p.\"));\n268\t    suite6_assert(moves->values[0].black.en_passant);\n269\t\n270\t    suite6_assert(moves->values[1].white.piece == PGN_PIECE_KNIGHT);\n271\t    suite6_assert(moves->values[1].white.dest.file == 'c');\n272\t    suite6_assert(moves->values[1].white.dest.rank == 4);\n273\t    suite6_assert(!strcmp(moves->values[1].white.notation, \"Nc4\"));\n274\t    suite6_assert(!moves->values[1].white.en_passant);\n275\t    suite6_assert(moves->values[1].black.piece == PGN_PIECE_KNIGHT);\n276\t    suite6_assert(moves->values[1].black.dest.file == 'c');\n277\t    suite6_assert(moves->values[1].black.dest.rank == 6);\n278\t    suite6_assert(!strcmp(moves->values[1].black.notation, \"Nc6\"));\n279\t    suite6_assert(!moves->values[1].black.en_passant);\n280\t\n281\t    suite6_assert(moves->values[2].white.piece == PGN_PIECE_PAWN);\n282\t    suite6_assert(moves->values[2].white.from.file == 'c');\n283\t    suite6_assert(moves->values[2].white.dest.file == 'b');\n284\t    suite6_assert(moves->values[2].white.dest.rank == 3);\n285\t    suite6_assert(!strcmp(moves->values[2].white.notation, \"cxb3 e.p.\"));\n286\t    suite6_assert(moves->values[2].white.en_passant);\n287\t    suite6_assert(moves->values[2].black.piece == PGN_PIECE_BISHOP);\n288\t    suite6_assert(moves->values[2].black.dest.file == 'e');\n289\t    suite6_assert(moves->values[2].black.dest.rank == 4);\n290\t    suite6_assert(!strcmp(moves->values[2].black.notation, \"Be4\"));\n291\t    suite6_assert(!moves->values[2].black.en_passant);\n292\t    pgn_moves_cleanup(moves);\n293\t}\n294\t\n295\tvoid test_parsing_moves_with_alternatives()\n296\t{\n297\t    pgn_moves_t *moves = NULL;\n298\t\n299\t    moves = pgn_moves_from_string(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5\");\n300\t    suite6_assert(moves->length == 1);\n301\t    suite6_assert(moves->values[0].white.alternatives->length == 1);\n302\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n303\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n304\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n305\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n306\t    pgn_moves_cleanup(moves);\n307\t\n308\t    moves = pgn_moves_from_string(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) (1. e4 f6? 2. d4 g5?? 3. Qh5#) e5\");\n309\t    suite6_assert(moves->length == 1);\n310\t    suite6_assert(moves->values[0].white.alternatives->length == 2);\n311\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n312\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n313\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n314\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n315\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[0].white.notation, \"e4\"));\n316\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[0].black.notation, \"f6?\"));\n317\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[1].white.notation, \"d4\"));\n318\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[1].black.notation, \"g5??\"));\n319\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[2].white.notation, \"Qh5#\"));\n320\t    pgn_moves_cleanup(moves);\n321\t\n322\t    moves = pgn_moves_from_string(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5 2. Nc6 Nf4\");\n323\t    suite6_assert(moves->length == 2);\n324\t    suite6_assert(moves->values[0].white.alternatives->length == 1);\n325\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n326\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n327\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n328\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n329\t    suite6_assert(!strcmp(moves->values[1].white.notation, \"Nc6\"));\n330\t    suite6_assert(!strcmp(moves->values[1].black.notation, \"Nf4\"));\n331\t    pgn_moves_cleanup(moves);\n332\t}\n333\t\n334\tvoid test_parsing_ambiguate_moves()\n335\t{\n336\t    pgn_moves_t *moves = NULL;\n337\t\n338\t    moves = pgn_moves_from_string(\"1. Rdf8 R1a3\");\n339\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"Rdf8\"));\n340\t    suite6_assert(moves->values[0].white.from.file == 'd');\n341\t    suite6_assert(moves->values[0].white.from.rank == 0);\n342\t    suite6_assert(moves->values[0].white.dest.file == 'f');\n343\t    suite6_assert(moves->values[0].white.dest.rank == 8);\n344\t\n345\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"R1a3\"));\n346\t    suite6_assert(moves->values[0].black.from.file == 0);\n347\t    suite6_assert(moves->values[0].black.from.rank == 1);\n348\t    suite6_assert(moves->values[0].black.dest.file == 'a');\n349\t    suite6_assert(moves->values[0].black.dest.rank == 3);\n350\t    pgn_moves_cleanup(moves);\n351\t\n352\t    moves = pgn_moves_from_string(\"1. Qh4e1\");\n353\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"Qh4e1\"));\n354\t    suite6_assert(moves->values[0].white.from.file == 'h');\n355\t    suite6_assert(moves->values[0].white.from.rank == 4);\n356\t    suite6_assert(