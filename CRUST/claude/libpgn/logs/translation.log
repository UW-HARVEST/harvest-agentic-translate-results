t_eq!(moves.values[1].white.notation, \"Nc6\");\n584\t    assert_eq!(moves.values[1].black.notation, \"Nf4\");\n585\t}\n586\t\n587\t#[test]\n588\tfn test_parsing_ambiguate_moves() {\n589\t    let mut moves: PgnMoves;\n590\t\n591\t    moves = PgnMoves::from(\"1. Rdf8 R1a3\");\n592\t    assert_eq!(moves.values[0].white.notation, \"Rdf8\");\n593\t    assert_eq!(moves.values[0].white.from.file, Some('d'));\n594\t    assert_eq!(moves.values[0].white.from.rank, None);\n595\t    assert_eq!(moves.values[0].white.dest.file, Some('f'));\n596\t    assert_eq!(moves.values[0].white.dest.rank, Some(8));\n597\t\n598\t    assert_eq!(moves.values[0].black.notation, \"R1a3\");\n599\t    assert_eq!(moves.values[0].black.from.file, None);\n600\t    assert_eq!(moves.values[0].black.from.rank, Some(1));\n601\t    assert_eq!(moves.values[0].black.dest.file, Some('a'));\n602\t    assert_eq!(moves.values[0].black.dest.rank, Some(3));\n603\t\n604\t    moves = PgnMoves::from(\"1. Qh4e1\");\n605\t    assert_eq!(moves.values[0].white.notation, \"Qh4e1\");\n606\t    assert_eq!(moves.values[0].white.from.file, Some('h'));\n607\t    assert_eq!(moves.values[0].white.from.rank, Some(4));\n608\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n609\t    assert_eq!(moves.values[0].white.dest.rank, Some(1));\n610\t}\n611\t\n612\t#[test]\n613\tfn test_dump_move() {\n614\t    let mut mv: PgnMove;\n615\t    let mut written: usize;\n616\t\n617\t    mv = PgnMove {\n618\t        annotation: PgnAnnotation::Unknown,\n619\t        piece: PgnPiece::Pawn,\n620\t        dest: PgnCoordinate {\n621\t            file: Some('e'),\n622\t            rank: Some(4),\n623\t        },\n624\t        ..Default::default()\n625\t    };\n626\t    assert_eq!(mv.to_string(), \"e4\");\n627\t\n628\t    mv = PgnMove {\n629\t        annotation: PgnAnnotation::Unknown,\n630\t        piece: PgnPiece::Rook,\n631\t        dest: PgnCoordinate {\n632\t            file: Some('e'),\n633\t            rank: Some(4),\n634\t        },\n635\t        ..Default::default()\n636\t    };\n637\t    assert_eq!(mv.to_string(), \"Re4\");\n638\t\n639\t    mv = PgnMove {\n640\t        annotation: PgnAnnotation::Unknown,\n641\t        piece: PgnPiece::Rook,\n642\t        check: PgnCheck::Mate,\n643\t        dest: PgnCoordinate {\n644\t            file: Some('e'),\n645\t            rank: Some(4),\n646\t        },\n647\t        ..Default::default()\n648\t    };\n649\t    assert_eq!(mv.to_string(), \"Re4#\");\n650\t\n651\t    mv = PgnMove {\n652\t        annotation: PgnAnnotation::Unknown,\n653\t        castles: PGN_CASTLING_KINGSIDE,\n654\t        check: PgnCheck::Mate,\n655\t        ..Default::default()\n656\t    };\n657\t    assert_eq!(mv.to_string(), \"O-O#\");\n658\t\n659\t    mv = PgnMove {\n660\t        annotation: PgnAnnotation::InterestingMove,\n661\t        piece: PgnPiece::Rook,\n662\t        dest: PgnCoordinate {\n663\t            file: Some('a'),\n664\t            rank: Some(3),\n665\t        },\n666\t        ..Default::default()\n667\t    };\n668\t    assert_eq!(mv.to_string(), \"Ra3!?\");\n669\t\n670\t    mv = PgnMove {\n671\t        annotation: PgnAnnotation::InterestingMove,\n672\t        en_passant: true,\n673\t        piece: PgnPiece::Pawn,\n674\t        dest: PgnCoordinate {\n675\t            file: Some('f'),\n676\t            rank: Some(3),\n677\t        },\n678\t        ..Default::default()\n679\t    };\n680\t    assert_eq!(mv.to_string(), \"f3!? e.p.\");\n681\t\n682\t    mv = PgnMove {\n683\t        annotation: PgnAnnotation::from(9),\n684\t        piece: PgnPiece::Pawn,\n685\t        dest: PgnCoordinate {\n686\t            file: Some('f'),\n687\t            rank: Some(3),\n688\t        },\n689\t        ..Default::default()\n690\t    };\n691\t    assert_eq!(mv.to_string(), \"f3 $9\");\n692\t\n693\t    mv = PgnMove {\n694\t        annotation: PgnAnnotation::from(9),\n695\t        en_passant: true,\n696\t        piece: PgnPiece::Pawn,\n697\t        dest: PgnCoordinate {\n698\t            file: Some('f'),\n699\t            rank: Some(3),\n700\t        },\n701\t        ..Default::default()\n702\t    };\n703\t    assert_eq!(mv.notation, \"f3 e.p. $9\");\n704\t\n705\t    mv = PgnMove {\n706\t        annotation: PgnAnnotation::Unknown,\n707\t        piece: PgnPiece::Pawn,\n708\t        captures: true,\n709\t        dest: PgnCoordinate {\n710\t            file: Some('f'),\n711\t            rank: Some(3),\n712\t        },\n713\t        ..Default::default()\n714\t    };\n715\t    assert_eq!(mv.to_string(), \"xf3\");\n716\t\n717\t    mv = PgnMove {\n718\t        annotation: PgnAnnotation::Unknown,\n719\t        piece: PgnPiece::Rook,\n720\t        captures: true,\n721\t        dest: PgnCoordinate {\n722\t            file: Some('f'),\n723\t            rank: Some(3),\n724\t        },\n725\t        ..Default::default()\n726\t    };\n727\t    assert_eq!(mv.to_string(), \"Rxf3\");\n728\t\n729\t    mv = PgnMove {\n730\t        annotation: PgnAnnotation::Unknown,\n731\t        piece: PgnPiece::Pawn,\n732\t        captures: true,\n733\t        dest: PgnCoordinate {\n734\t            file: Some('f'),\n735\t            rank: Some(8),\n736\t        },\n737\t        promoted_to: PgnPiece::Queen,\n738\t        check: PgnCheck::Double,\n739\t        ..Default::default()\n740\t    };\n741\t    assert_eq!(mv.to_string(), \"xf8=Q++\");\n742\t}\n743\t\n744\t#[test]\n745\tfn test_parsing_weird_move() {\n746\t    // NOTE: the original test case has a return statement at the beginning\n747\t    // thus the test is not executed\n748\t    // assert_eq!(PgnMove::from(\"Le1\").notation, \"\");\n749\t    // assert_eq!(PgnMove::from(\"xe100\").notation, \"\");\n750\t}\n751\t\n752\t#[test]\n753\tfn test_parsing_moves_with_weird_spaces() {\n754\t    // NOTE: the original test case has a return statement at the beginning\n755\t    // thus the test is not executed\n756\t\n757\t    /*\n758\t    let mut moves: PgnMoves;\n759\t\n760\t    moves = PgnMoves::from(\"1. Rdf8e.p.\");\n761\t\n762\t    moves = PgnMoves::from(\"1. Rdf8e.p.$0\");\n763\t\n764\t    moves = PgnMoves::from(\"1. Rdf8$0\");\n765\t     */\n766\t}\n767\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"4a15c865-2e54-4418-82c1-30849660539f","uuid":"ddfc90a2-b588-471b-b233-52aa6800419e","timestamp":"2026-05-28T20:10:54.456Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-4VlBMm/project/src/bin/test_moves.rs","content":"use libpgn::annotation::PgnAnnotation;\nuse libpgn::check::PgnCheck;\nuse libpgn::comments::PgnCommentPosition;\nuse libpgn::coordinate::{PgnCoordinate, UNKNOWN};\nuse libpgn::moves::{PgnMove, PgnMoves, PGN_CASTLING_KINGSIDE, PGN_CASTLING_QUEENSIDE};\nuse libpgn::piece::PgnPiece;\n\n#[test]\nfn test_parsing_single_move() {\n    let mut mv: PgnMove;\n\n    mv = PgnMove::from(\"e4??\");\n    assert_eq!(mv.piece, PgnPiece::Pawn);\n    assert_eq!(mv.captures, false);\n    assert_eq!(mv.from.file, None);\n    assert_eq!(mv.from.rank, None);\n    assert_eq!(mv.dest.file, Some('e'));\n    assert_eq!(mv.dest.rank, Some(4));\n    assert_eq!(mv.check, PgnCheck::None);\n    assert_eq!(mv.notation, \"e4??\");\n    assert_eq!(mv.annotation, PgnAnnotation::Blunder);\n\n    mv = PgnMove::from(\"Nb6d5+\");\n    assert_eq!(mv.piece, PgnPiece::Knight);\n    assert_eq!(mv.captures, false);\n    assert_eq!(mv.from.file, Some('b'));\n    assert_eq!(mv.from.rank, Some(6));\n    assert_eq!(mv.dest.file, Some('d'));\n    assert_eq!(mv.dest.rank, Some(5));\n    assert_eq!(mv.check, PgnCheck::Single);\n    assert_eq!(mv.notation, \"Nb6d5+\");\n    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n\n    mv = PgnMove::from(\"Qf1?!\");\n    assert_eq!(mv.piece, PgnPiece::Queen);\n    assert_eq!(mv.captures, false);\n    assert_eq!(mv.from.file, None);\n    assert_eq!(mv.from.rank, None);\n    assert_eq!(mv.dest.file, Some('f'));\n    assert_eq!(mv.dest.rank, Some(1));\n    assert_eq!(mv.check, PgnCheck::None);\n    assert_eq!(mv.notation, \"Qf1?!\");\n    assert_eq!(mv.annotation, PgnAnnotation::DubiousMove);\n\n    mv = PgnMove::from(\"bxa8=Q??\");\n    assert_eq!(mv.piece, PgnPiece::Pawn);\n    assert_eq!(mv.captures, true);\n    assert_eq!(mv.from.file, Some('b'));\n    assert_eq!(mv.from.rank, None);\n    assert_eq!(mv.dest.file, Some('a'));\n    assert_eq!(mv.dest.rank, Some(8));\n    assert_eq!(mv.check, PgnCheck::None);\n    assert_eq!(mv.promoted_to, PgnPiece::Queen);\n    assert_eq!(mv.notation, \"bxa8=Q??\");\n    assert_eq!(mv.annotation, PgnAnnotation::Blunder);\n\n    mv = PgnMove::from(\"Bxg2\");\n    assert_eq!(mv.piece, PgnPiece::Bishop);\n    assert_eq!(mv.captures, true);\n    assert_eq!(mv.from.file, None);\n    assert_eq!(mv.from.rank, None);\n    assert_eq!(mv.dest.file, Some('g'));\n    assert_eq!(mv.dest.rank, Some(2));\n    assert_eq!(mv.check, PgnCheck::None);\n    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n    assert_eq!(mv.notation, \"Bxg2\");\n    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n\n    mv = PgnMove::from(\"exf2+!\");\n    assert_eq!(mv.piece, PgnPiece::Pawn);\n    assert_eq!(mv.captures, true);\n    assert_eq!(mv.from.file, Some('e'));\n    assert_eq!(mv.from.rank, None);\n    assert_eq!(mv.dest.file, Some('f'));\n    assert_eq!(mv.dest.rank, Some(2));\n    assert_eq!(mv.check, PgnCheck::Single);\n    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n    assert_eq!(mv.notation, \"exf2+!\");\n    assert_eq!(mv.annotation, PgnAnnotation::GoodMove);\n\n    mv = PgnMove::from(\"O-O+!!\");\n    assert_eq!(mv.castles, PGN_CASTLING_KINGSIDE);\n    assert_eq!(mv.check, PgnCheck::Single);\n    assert_eq!(mv.notation, \"O-O+!!\");\n    assert_eq!(mv.annotation, PgnAnnotation::BrilliantMove);\n\n    mv = PgnMove::from(\"O-O-O\");\n    assert_eq!(mv.castles, PGN_CASTLING_QUEENSIDE);\n    assert_eq!(mv.check, PgnCheck::None);\n    assert_eq!(mv.notation, \"O-O-O\");\n    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n}\n\n#[test]\nfn test_parsing_bunch_of_moves() {\n    let mut moves: PgnMoves