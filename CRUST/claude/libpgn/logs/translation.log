{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QnSucWtU1tWkWgoj7f5k4y","type":"tool_result","content":"1\t/* libpgn - PGN file parser.\n2\t * Copyright (C) 2024 youkwhd <lolywk@tutanota.com>\n3\t *\n4\t * This program is free software; you can redistribute it and/or modify\n5\t * it under the terms of the GNU General Public License as published by\n6\t * the Free Software Foundation; either version 2 of the License, or\n7\t * (at your option) any later version.\n8\t *\n9\t * This program is distributed in the hope that it will be useful,\n10\t * but WITHOUT ANY WARRANTY; without even the implied warranty of\n11\t * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n12\t * GNU General Public License for more details.\n13\t *\n14\t * You should have received a copy of the GNU General Public License along\n15\t * with this program; if not, write to the Free Software Foundation, Inc.,\n16\t * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n17\t */\n18\t\n19\t#include <assert.h>\n20\t#include <stdio.h>\n21\t#include <string.h>\n22\t#include <ctype.h>\n23\t\n24\t#include \"annotation.h\"\n25\t#include \"utils/cursor.h\"\n26\t\n27\tpgn_annotation_t __pgn_annotation_nag_from_string(char *str, size_t *consumed)\n28\t{\n29\t    pgn_annotation_t annotation = PGN_ANNOTATION_UNKNOWN;\n30\t    size_t cursor = 0;\n31\t\n32\t    /* works for not revisiting whitespaces\n33\t     */\n34\t    if (str[cursor] != '$')\n35\t        return annotation;\n36\t\n37\t    /* NOTE: NAG annotation tends to have $0 followed by another $<num>.\n38\t     * thus why the while loop, take the last.\n39\t     */\n40\t    while (str[cursor] == '$')\n41\t    {\n42\t        assert(isdigit(str[++cursor]));\n43\t\n44\t        /* TODO: don't discard the rest.\n45\t         */\n46\t        char *endptr = NULL;\n47\t        long num = strtol(str + cursor, &endptr, 10);\n48\t\n49\t        annotation = num;\n50\t        cursor += endptr - (str + cursor);\n51\t\n52\t        pgn_cursor_skip_whitespace(str, &cursor);\n53\t    }\n54\t    pgn_cursor_revisit_whitespace(str, &cursor);\n55\t\n56\t    *consumed += cursor;\n57\t    return annotation;\n58\t}\n59\t\n60\tpgn_annotation_t __pgn_annotation_from_string(char *str, size_t *consumed)\n61\t{\n62\t    /* TODO: maybe refactor using strcmp()?\n63\t     */\n64\t    pgn_annotation_t annotation = PGN_ANNOTATION_UNKNOWN;\n65\t\n66\t    if (str[0] == '\\0')\n67\t        return annotation;\n68\t\n69\t    if (str[0] == '!') {\n70\t        (*consumed)++;\n71\t        annotation = PGN_ANNOTATION_GOOD_MOVE;\n72\t    }\n73\t\n74\t    if (str[0] == '?') {\n75\t        (*consumed)++;\n76\t        annotation = PGN_ANNOTATION_MISTAKE;\n77\t    }\n78\t\n79\t    if (str[1] == '\\0')\n80\t        return annotation;\n81\t\n82\t    if (str[0] == '!' && str[1] == '!') {\n83\t        (*consumed)++;\n84\t        annotation = PGN_ANNOTATION_BRILLIANT_MOVE;\n85\t    }\n86\t\n87\t    if (str[0] == '!' && str[1] == '?') {\n88\t        (*consumed)++;\n89\t        annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n90\t    }\n91\t\n92\t    if (str[0] == '?' && str[1] == '!') {\n93\t        (*consumed)++;\n94\t        annotation = PGN_ANNOTATION_DUBIOUS_MOVE;\n95\t    }\n96\t\n97\t    if (str[0] == '?' && str[1] == '?') {\n98\t        (*consumed)++;\n99\t        annotation = PGN_ANNOTATION_BLUNDER;\n100\t    }\n101\t\n102\t    return annotation;\n103\t}\n104\t\n105\tpgn_annotation_t pgn_annotation_from_string(char *str)\n106\t{\n107\t    size_t consumed = 0;\n108\t    return __pgn_annotation_from_string(str, &consumed);\n109\t}\n110\t\n111\tsize_t pgn_annotation_to_string(pgn_annotation_t annotation, char *dest)\n112\t{\n113\t    switch (annotation) {\n114\t    case PGN_ANNOTATION_UNKNOWN: return 0;\n115\t    case PGN_ANNOTATION_NULL: break;\n116\t    case PGN_ANNOTATION_GOOD_MOVE:\n117\t        strcpy(dest, \"!\");\n118\t        return 1;\n119\t    case PGN_ANNOTATION_MISTAKE:\n120\t        strcpy(dest, \"?\");\n121\t        return 1;\n122\t    case PGN_ANNOTATION_BRILLIANT_MOVE:\n123\t        strcpy(dest, \"!!\");\n124\t        return 2;\n125\t    case PGN_ANNOTATION_BLUNDER:\n126\t        strcpy(dest, \"??\");\n127\t        return 2;\n128\t    case PGN_ANNOTATION_INTRESTING_MOVE:\n129\t        strcpy(dest, \"!?\");\n130\t        return 2;\n131\t    case PGN_ANNOTATION_DUBIOUS_MOVE:\n132\t        strcpy(dest, \"?!\");\n133\t        return 2;\n134\t    }\n135\t\n136\t    int bytes = sprintf(dest, \"$%d\", annotation);\n137\t    assert(bytes >= 0);\n138\t\n139\t    return bytes;\n140\t}\n141\t"}]},"parent_tool_use_id":null,"session_id":"4a15c865-2e54-4418-82c1-30849660539f","uuid":"c42fa516-891d-4595-a261-67d33333cde2","timestamp":"2026-05-28T20:09:11.859Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-4VlBMm/project/c_src/annotation.c","content":"/* libpgn - PGN file parser.\n * Copyright (C) 2024 youkwhd <lolywk@tutanota.com>\n *\n * This program is free software; you can redistribute it and/or modify\n * it under the terms of the GNU General Public License as published by\n * the Free Software Foundation; either version 2 of the License, or\n * (at your option) any later version.\n *\n * This program is distributed in the hope that it will be useful,\n * but WITHOUT ANY WARRANTY; without even the implied warranty of\n * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n * GNU General Public License for more details.\n *\n * You should have received a copy of the GNU General Public License along\n * with this program; if not, write to the Free Software Foundation, Inc.,\n * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n */\n\n#include <assert.h>\n#include <stdio.h>\n#include <string.h>\n#include <ctype.h>\n\n#include \"annotation.h\"\n#include \"utils/cursor.h\"\n\npgn_annotation_t __pgn_annotation_nag_from_string(char *str, size_t *consumed)\n{\n    pgn_annotation_t annotation = PGN_ANNOTATION_UNKNOWN;\n    size_t cursor = 0;\n\n    /* works for not revisiting whitespaces\n     */\n    if (str[cursor] != '$')\n        return annotation;\n\n    /* NOTE: NAG annotation tends to have $0 followed by another $<num>.\n     * thus why the while loop, take the last.\n     */\n    while (str[cursor] == '$')\n    {\n        assert(isdigit(str[++cursor]));\n\n        /* TODO: don't discard the rest.\n         */\n        char *endptr = NULL;\n        long num = strtol(str + cursor, &endptr, 10);\n\n        annotation = num;\n        cursor += endptr - (str + cursor);\n\n        pgn_cursor_skip_whitespace(str, &cursor);\n    }\n    pgn_cursor_revisit_whitespace(str, &cursor);\n\n    *consumed += cursor;\n    return annotation;\n}\n\npgn_annotation_t __pgn_annotation_from_string(char *str, size_t *consumed)\n{\n    /* TODO: maybe refactor using strcmp()?\n     */\n    pgn_annotation_t annotation = PGN_ANNOTATION_UNKNOWN;\n\n    if (str[0] == '\\0')\n        return annotation;\n\n    if (str[0] == '!') {\n        (*consumed)++;\n        annotation = PGN_ANNOTATION_GOOD_MOVE;\n    }\n\n    if (str[0] == '?') {\n        (*consumed)++;\n        annotation = PGN_ANNOTATION_MISTAKE;\n    }\n\n    if (str[1] == '\\0')\n        return annotation;\n\n    if (str[0] == '!' && str[1] == '!') {\n        (*consumed)++;\n        annotation = PGN_ANNOTATION_BRILLIANT_MOVE;\n    }\n\n    if (str[0] == '!' && str[1] == '?') {\n        (*consumed)++;\n        annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n    }\n\n    if (str[0] == '?' && str[1] == '!') {\n        (*consumed)++;\n        annotation = PGN_ANNOTATION_DUBIOUS_MOVE;\n    }\n\n    if (str[0] == '?' && str[1] == '?') {\n        (*consumed)++;\n        annotation = PGN_ANNOTATION_BLUNDER;\n    }\n\n    return annotation;\n}\n\npgn_annotation_t pgn_annotation_from_string(char *str)\n{\n    size_t consumed = 0;\n    return __pgn_annotation_from_string(str, &consumed);\n}\n\nsize_t pgn_annotation_to_string(pgn_annotation_t annotation, char *dest)\n{\n    switch (annotation) {\n    case PGN_ANNOTATION_UNKNOWN: return 0;\n    case PGN_ANNOTATION_NULL: break;\n    case PGN_ANNOTATION_GOOD_MOVE:\n        strcpy(dest, \"!\");\n        return 1;\n    case PGN_ANNOTATION_MISTAKE:\n        strcpy(dest, \"?\");\n        return 1;\n    case PGN_ANNOTATION_BRILLIANT_MOVE:\n        strcpy(dest, \"!!\");\n        return 2;\n    case PGN_ANNOTATION_BLUNDER:\n        strcpy(dest, \"??\");\n        return 2;\n    case PGN_ANNOTATION_INTRESTING_MOVE:\n        strcpy(dest, \"!?\");\n        return 2;\n    case PGN_ANNOTATION_DUBIOUS_MOVE:\n        strcpy(dest, \"?!\");\n        return 2;\n    }\n\n    int bytes = sprintf(dest, \"$%d\", annotation);\n    assert(bytes >= 0);\n\n    return bytes;\n}\n","numLines":141,"startLine":1,"totalLines":141}}}
