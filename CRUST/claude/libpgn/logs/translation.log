\n415\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n416\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n417\t    assert_eq!(moves.values[1].white.dest.rank, Some(4));\n418\t    assert_eq!(moves.values[1].white.notation, \"Nc4\");\n419\t    assert!(!moves.values[1].white.en_passant);\n420\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n421\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n422\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n423\t    assert_eq!(moves.values[1].black.notation, \"Nc6\");\n424\t    assert!(!moves.values[1].black.en_passant);\n425\t\n426\t    assert_eq!(moves.values[2].white.piece, PgnPiece::Pawn);\n427\t    assert_eq!(moves.values[2].white.from.file, Some('c'));\n428\t    assert_eq!(moves.values[2].white.dest.file, Some('b'));\n429\t    assert_eq!(moves.values[2].white.dest.rank, Some(3));\n430\t    assert_eq!(moves.values[2].white.notation, \"cxb3 e.p.\");\n431\t    assert!(moves.values[2].white.en_passant);\n432\t    assert_eq!(moves.values[2].black.piece, PgnPiece::Bishop);\n433\t    assert_eq!(moves.values[2].black.dest.file, Some('e'));\n434\t    assert_eq!(moves.values[2].black.dest.rank, Some(4));\n435\t    assert_eq!(moves.values[2].black.notation, \"Be4\");\n436\t    assert!(!moves.values[2].black.en_passant);\n437\t}\n438\t\n439\t#[test]\n440\tfn test_parsing_moves_with_alternatives() {\n441\t    let mut moves: PgnMoves;\n442\t\n443\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5\");\n444\t    assert_eq!(moves.values.len(), 1);\n445\t    assert_eq!(\n446\t        moves.values[0]\n447\t            .white\n448\t            .alternatives\n449\t            .as_ref()\n450\t            .unwrap()\n451\t            .values\n452\t            .len(),\n453\t        1\n454\t    );\n455\t    assert_eq!(\n456\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n457\t            .white\n458\t            .notation,\n459\t    