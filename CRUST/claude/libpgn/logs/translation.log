}\n56\t\n57\t    move.piece = pgn_piece_from_char(str[cursor++]);\n58\t    if (move.piece == PGN_PIECE_UNKNOWN) {\n59\t        move.piece = PGN_PIECE_PAWN;\n60\t        cursor--;\n61\t    }\n62\t\n63\t    /* NOTE: can be refactored using a stack\n64\t     */\n65\t    if (islower(str[cursor]) && str[cursor] != 'x') move.from.file = str[cursor++];\n66\t    if (isdigit(str[cursor])) move.from.rank = str[cursor++] - '0';\n67\t\n68\t    move.captures = str[cursor] == 'x' || str[cursor] == ':';\n69\t    cursor += move.captures;\n70\t\n71\t    if (islower(str[cursor])) {\n72\t        assert(islower(str[cursor]));\n73\t        move.dest.file = str[cursor++];\n74\t        assert(isdigit(str[cursor]));\n75\t        move.dest.rank = str[cursor++] - '0';\n76\t    } else {\n77\t        move.dest = move.from;\n78\t        move.from = (pgn_coordinate_t){0};\n79\t    }\n80\t\n81\t    move.promoted_to = pgn_piece_from_char(str[cursor]);\n82\t    if (move.promoted_to == PGN_PIECE_UNKNOWN) {\n83\t        switch (str[cursor]) {\n84\t        case '(':\n85\t            move.promoted_to = pgn_piece_from_char(str[++cursor]);\n86\t            assert(move.promoted_to != PGN_PIECE_UNKNOWN);\n87\t            assert(str[++cursor] == ')');\n88\t            cursor++;\n89\t            break;\n90\t        case '=':\n91\t        case '/':\n92\t            move.promoted_to = pgn_piece_from_char(str[++cursor]);\n93\t            assert(move.promoted_to != PGN_PIECE_UNKNOWN);\n94\t            cursor++;\n95\t            break;\n96\t        }\n97\t    }\n98\t\n99\t    assert(move.dest.file != 0);\n100\t    assert(move.dest.rank != 0);\n101\t\n102\tcheck:\n103\t    move.check = __pgn_check_from_string(str + cursor, &cursor);\n104\t    move.annotation = __pgn_annotation_from_string(str + cursor, &cursor);\n105\t\n106\t    bool skipped_whitespace_before_ep = pgn_cursor_skip_whitespace(str, &cursor);\n107\t\n108\t    /* could be en passant */\n109\t    if (str[cursor] == 'e' && str[cursor + 1] == '.') {\n110\t        /* TODO: error no spaces in between\n111\t         */\n112\t        assert(skipped_whitespace_before_ep);\n113\t\n114\t        assert(str[cursor] == 'e');\n115\t        assert(str[++cursor] == '.');\n116\t        assert(str[++cursor] == 'p');\n117\t        assert(str[++cursor] == '.');\n118\t        cursor++;\n119\t        move.en_passant = true;\n120\t    }\n121\t\n122\t    bool skipped_whitespace_after_ep = move.en_passant ? pgn_cursor_skip_whitespace(str, &cursor) : skipped_whitespace_before_ep;\n123\t\n124\t    /* Check for NAG annotation.\n125\t     */\n126\t    if (move.annotation == PGN_ANNOTATION_UNKNOWN) {\n127\t        move.annotation = __pgn_annotation_nag_from_string(str + cursor, &cursor);\n128\t\n129\t        /* TODO: error no spaces in between\n130\t         */\n131\t        if (move.annotation != PGN_ANNOTATION_UNKNOWN) {\n132\t            assert(skipped_whitespace_after_ep);\n133\t        }\n134\t    }\n135\t\n136\t    pgn_cursor_revisit_whitespace(str, &cursor);\n137\t\n138\t    size_t notation_len = cursor;\n139\t    strncpy(move.notation, str, notation_len);\n140\t\n141\t    *consumed += cursor;\n142\t    return move;\n143\t}\n144\t\n145\tpgn_move_t pgn_move_from_string(char *str)\n146\t{\n147\t    size_t consumed = 0;\n148\t    return __pgn_move_from_string(str, &consumed);\n149\t}\n150\t\n151\tsize_t pgn_move_to_string(pgn_move_t *move, char *dest)\n152\t{\n153\t    size_t cursor = 0;\n154\t\n155\t    switch (move->castles) {\n156\t    case PGN_CASTLING_NONE: break;\n157\t    case PGN_CASTLING_KINGSIDE:\n158\t        strcpy(dest, \"O-O\");\n159\t        cursor += PGN_CASTLING_KINGSIDE * 2 - 1;\n160\t        goto check;\n161\t    case PGN_CASTLING_QUEENSIDE:\n162\t        strcpy(dest, \"O-O-O\");\n163\t        cursor += PGN_CASTLING_QUEENSIDE * 2 - 1;\n164\t        goto check;\n165\t    }\n166\t\n167\t    assert(move->piece != PGN_PIECE_UNKNOWN);\n168\t    if (move->piece != PGN_PIECE_PAWN) {\n169\t        dest[cursor++] = move->piece;\n170\t    }\n171\t\n172\t    if (move->from.file) dest[cursor++] = move->from.file;\n173\t    if (move->from.rank) dest[cursor++] = '0' + move->from.rank;\n174\t\n175\t    if (move->captures) dest[cursor++] = 'x';\n176\t\n177\t    dest[cursor++] = move->dest.file;\n178\t    dest[cursor++] = '0' + move->dest.rank;\n179\t\n180\t    if (move->promoted_to) {\n181\t        assert(move->piece == PGN_PIECE_PAWN);\n182\t        assert(move->promoted_to != PGN_PIECE_PAWN);\n183\t        dest[cursor++] = '=';\n184\t        dest[cursor++] = move->promoted_to;\n185\t    }\n186\t\n187\tcheck:\n188\t    switch (move->check) {\n189\t        case PGN_CHECK_NONE:\n190\t            break;\n191\t        case PGN_CHECK_MATE:\n192\t            dest[cursor++] = '#';\n193\t            break;\n194\t        case PGN_CHECK_SINGLE:\n195\t            dest[cursor++] = '+';\n196\t            break;\n197\t        case PGN_CHECK_DOUBLE:\n198\t            dest[cursor++] = '+';\n199\t            dest[cursor++] = '+';\n200\t            break;\n201\t    }\n202\t\n203\t    if (move->annotation >= PGN_ANNOTATION_GOOD_MOVE && move->annotation <= PGN_ANNOTATION_DUBIOUS_MOVE) {\n204\t        cursor += pgn_annotation_to_string(move->annotation, dest + cursor);\n205\t    }\n206\t\n207\t    if (move->en_passant) {\n208\t        dest[cursor++] = ' ';\n209\t        strcpy(dest + cursor, \"e.p.\");\n210\t        cursor += 4;\n211\t    }\n212\t\n213\t    if (move->annotation > PGN_ANNOTATION_DUBIOUS_MOVE || move->annotation == PGN_ANNOTATION_NULL) {\n214\t        dest[cursor++] = ' ';\n215\t        cursor += pgn_annotation_to_string(move->annotation, dest + cursor);\n216\t    }\n217\t\n218\t    dest[cursor] = '\\0';\n219\t    return cursor;\n220\t}\n221\t\n222\tpgn_moves_t *__pgn_moves_from_string_recurse(char *str, size_t *consumed, pgn_moves_t *moves, int expect)\n223\t{\n224\t    if (str[0] == ')' || str[0] == '\\0')\n225\t        return moves;\n226\t\n227\t    size_t cursor = 0;\n228\t    __pgn_moves_item_t move = {0};\n229\t\n230\t    /* comments placeholder to wait for knowing which move the comment belongs to.\n231\t     */\n232\t    pgn_comments_t *comments = NULL;\n233\t\n234\t    pgn_cursor_skip_whitespace(str, &cursor);\n235\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BEFORE_MOVE, str + cursor);\n236\t\n237\t    assert(isdigit(str[cursor]));\n238\t    while (isdigit(str[cursor])) cursor++;\n239\t\n240\t    int dots_count = 0;\n241\t    assert(str[cursor] == '.');\n242\t    while (str[cursor] == '.') {\n243\t        cursor++;\n244\t        dots_count++;\n245\t    }\n246\t\n247\t    if (expect == PGN_EXPECT_WHITE) assert(dots_count == 1);\n248\t    if (expect == PGN_EXPECT_BLACK) assert(dots_count == 3);\n249\t\n250\t    pgn_cursor_skip_whitespace(str, &cursor);\n251\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BETWEEN_MOVE, str + cursor);\n252\t\n253\t    if (dots_count == 3) {\n254\t        move.black = __pgn_move_from_string(str + cursor, &cursor);\n255\t\n256\t        pgn_cursor_skip_whitespace(str, &cursor);\n257\t        cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n258\t        cursor += pgn_alternative_moves_poll(&move.black.alternatives, &comments, str + cursor, PGN_EXPECT_BLACK);\n259\t        pgn_cursor_skip_whitespace(str, &cursor);\n260\t        cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n261\t\n262\t        if (comments) {\n263\t            move.black.comments = comments;\n264\t            comments = NULL;\n265\t        }\n266\t\n267\t        pgn_moves_push(moves, move);\n268\t        __pgn_moves_from_string_recurse(str + cursor, &cursor, moves, PGN_EXPECT_WHITE);\n269\t        *consumed += cursor;\n270\t        return moves;\n271\t    }\n272\t\n273\t    move.white = __pgn_move_from_string(str + cursor, &cursor);\n274\t    pgn_cursor_skip_whitespace(str, &cursor);\n275\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_PO