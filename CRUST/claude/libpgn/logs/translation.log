{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01HXF9Lx1UPbptw8s7znFife","type":"tool_result","content":"1\t/* libpgn - PGN file parser.\n2\t * Copyright (C) 2024 youkwhd <lolywk@tutanota.com>\n3\t *\n4\t * This program is free software; you can redistribute it and/or modify\n5\t * it under the terms of the GNU General Public License as published by\n6\t * the Free Software Foundation; either version 2 of the License, or\n7\t * (at your option) any later version.\n8\t *\n9\t * This program is distributed in the hope that it will be useful,\n10\t * but WITHOUT ANY WARRANTY; without even the implied warranty of\n11\t * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n12\t * GNU General Public License for more details.\n13\t *\n14\t * You should have received a copy of the GNU General Public License along\n15\t * with this program; if not, write to the Free Software Foundation, Inc.,\n16\t * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n17\t */\n18\t\n19\t#include <stdlib.h>\n20\t#include <assert.h>\n21\t\n22\t#include \"metadata.h\"\n23\t#include \"utils/cursor.h\"\n24\t\n25\tpgn_metadata_t *__pgn_metadata_from_string(char *str, size_t *consumed)\n26\t{\n27\t    size_t cursor = 0;\n28\t\n29\t    /* Redundant check, but it works to not make unnecessary\n30\t     * memory allocations (key_buf, value_buf)\n31\t     */\n32\t    if (str[cursor] != '[') return NULL;\n33\t\n34\t    pgn_metadata_t *metadata = pgn_metadata_init();\n35\t    pgn_buffer_t *key_buffer = pgn_buffer_init();\n36\t    pgn_buffer_t *value_buffer = pgn_buffer_init();\n37\t\n38\t    for (;;) {\n39\t        if (str[cursor] != '[') break;\n40\t        cursor++;\n41\t\n42\t        while (str[cursor] != ' ') pgn_buffer_append(key_buffer, str[cursor++]);\n43\t        pgn_buffer_append_null_terminator(key_buffer);\n44\t\n45\t        assert(str[++cursor] == '\"');\n46\t        cursor++;\n47\t\n48\t        while (str[cursor] != '\"') pgn_buffer_append(v