;\n264\t    assert_eq!(moves.values[0].black.captures, true);\n265\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::DubiousMove);\n266\t    assert!(moves.values[0].black.alternatives.is_some());\n267\t\n268\t    assert_eq!(\n269\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n270\t            .black\n271\t            .piece,\n272\t        PgnPiece::Pawn\n273\t    );\n274\t    assert_eq!(\n275\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n276\t            .black\n277\t            .dest\n278\t            .file,\n279\t        Some('e')\n280\t    );\n281\t    assert_eq!(\n282\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n283\t            .black\n284\t            .dest\n285\t            .rank,\n286\t        Some(5)\n287\t    );\n288\t    assert_eq!(\n289\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n290\t            .black\n291\t            .captures,\n292\t        false\n293\t    );\n294\t    assert_eq!(\n295\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n296\t            .black\n297\t            .annotation,\n298\t        PgnAnnotation::Unknown\n299\t    );\n300\t\n301\t    assert_eq!(\n302\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n303\t            .white\n304\t            .piece,\n305\t        PgnPiece::Pawn\n306\t    );\n307\t    assert_eq!(\n308\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n309\t            .white\n310\t            .dest\n311\t            .file,\n312\t        Some('e')\n313\t    );\n314\t    assert_eq!(\n315\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n316\t            .white\n317\t            .dest\n318\t            .rank,\n319\t        Some(4)\n320\t    );\n321\t    assert_eq!(\n322\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n323\t            .white\n324\t            .captures,\n325\t        false\n326\t    );\n327\t    assert_eq!(\n328\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n329\t            .white\n330\t            .annotation,\n331\t        PgnAnnotation::Unknown\n332\t    );\n333\t\n334\t    moves = PgnMoves::from(\"1.c4 ( 1.e4  ) c5 2.Nc3 Nc6\");\n335\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n336\t    assert_eq!(moves.values[0].white.dest.file, Some('c'));\n337\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n338\t    assert_eq!(moves.values[0].white.captures, false);\n339\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n340\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n341\t    assert_eq!(moves.values[0].black.dest.file, Some('c'));\n342\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n343\t    assert_eq!(moves.values[0].black.captures, false);\n344\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n345\t\n346\t    assert_eq!(\n347\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n348\t            .white\n349\t            .piece,\n350\t        PgnPiece::Pawn\n351\t    );\n352\t    assert_eq!(\n353\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n354\t            .white\n355\t            .dest\n356\t            .file,\n357\t        Some('e')\n358\t    );\n359\t    assert_eq!(\n360\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n361\t            .white\n362\t            .dest\n363\t            .rank,\n364\t        Some(4)\n365\t    );\n366\t    assert_eq!(\n367\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n368\t            .white\n369\t            .captures,\n370\t        false\n371\t    );\n372\t    assert_eq!(\n373\t        moves.values[0].white.alternatives.as_ref().