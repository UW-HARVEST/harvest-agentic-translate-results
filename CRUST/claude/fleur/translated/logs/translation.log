51\t    if(elements_read == 0){\n52\t        fprintf(stderr, \"[ERROR] reading filter file.\\n\");\n53\t        bf.error = 1;\n54\t        return bf;\n55\t    }\n56\t\n57\t    if (fleur_check_header(&h) != 1){\n58\t        fprintf(stderr, \"[ERROR] Incoherent header.\\n\");\n59\t        bf.error = 1;\n60\t        return bf;\n61\t    }\n62\t\n63\t    bf.M = ceil(h.m / 64.0);\n64\t\n65\t    // Get data size\n66\t    int err = fseek(f, 0, SEEK_END);\n67\t    if(err!=0){\n68\t        fprintf(stderr, \"[ERROR] Cannot seek in binary file.\\n\");\n69\t        bf.error = 1;\n70\t        return bf;\n71\t    }\n72\t    long size = ftell(f);\n73\t    fseek(f, 48, SEEK_SET);\n74\t\n75\t    if (bf.M <= (size - 48)){\n76\t\n77\t        bf.datasize = size - ceil((bf.M*64)/8) - 48;\n78\t        \n79\t        // Load bitarray\n80\t        bf.v = calloc(bf.M, sizeof(uint64_t));\n81\t        elements_read = fread(bf.v, sizeof(uint64_t), bf.M, f);\n82\t        if(elements_read == 0){\n83\t            fprintf(stderr, \"[ERROR] Cannot load bitarray.\\n\");\n84\t            bf.error = 1;\n85\t            return bf;\n86\t        }\n87\t\n88\t        // Load remaining data\n89\t        if (bf.datasize > 0) {\n90\t            // keep one for adding the nullbyte\n91\t            bf.Data = calloc(bf.datasize + 1, sizeof(unsigned char));\n92\t            elements_read = fread(bf.Data, sizeof(char), bf.datasize, f);\n93\t            if(elements_read == 0){\n94\t                fprintf(stderr, \"[ERROR] Cannot load bloom filter metadata.\\n\");\n95\t                bf.error = 1;\n96\t                return bf;\n97\t            }\n98\t            bf.Data[bf.datasize] = '\\0';\n99\t        }\n100\t        if (bf.datasize == 0){\n101\t            bf.Data = calloc(1, sizeof(unsigned char));\n102\t            bf.Data[bf.datasize] = '\\0';\n103\t        }\n104\t    }\n105\t\n106\t    bf.modified = 0;\n107\t    bf.error = 0;\n108\t\n109\t    bf.h = h;\n110\t\n111\t    return bf;\n112\t}\n113\t\n114\t// 