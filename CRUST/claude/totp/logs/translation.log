{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_li7jq6dc4jhte3wxrk4yhebilqljcqni3x2p4au5lvnrjkf7yoca","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01DExa6bPFj8K2FZ5C7zN7KL","name":"Write","input":{"file_path":"/tmp/harvest-crust-WMpZ0E/project/src/totp.rs","content":"// Importing required modules\nuse crate::std;\n// Constants\npub const TOTP_EXPORT: &str = \"__attribute__((visibility(\\\"default\\\")))\";\n\nconst TOTP_OK: i32 = 0;\nconst TOTP_EBOUNDS: i32 = 1;\n\n// Function Declarations\npub fn hotp(key: &[u8; 64], counter: u64) -> i32 {\n    let mut data = [0u8; 8];\n    let mut hash = [0u8; 20];\n\n    unpack64(counter, &mut data);\n    hmac_sha1(key, &data, 8, &mut hash);\n\n    let offset = (hash[19] & 0xF) as usize;\n    let arr: &[u8; 4] = (&hash[offset..offset + 4]).try_into().unwrap();\n    let trunc = pack32(arr) & 0x7FFF_FFFF;\n\n    (trunc % 1_000_000) as i32\n}\n\npub fn sha1(buf: &mut [u8], len: usize, cap: usize, hash: &mut [u8; 20]) -> i32 {\n    const K: [u32; 4] = [0x5A82_7999, 0x6ED9_EBA1, 0x8F1B_BCDC, 0xCA62_C1D6];\n\n    if len > std::SIZE_MAX - 9 - 63 {\n        return TOTP_EBOUNDS;\n    }\n    let new_len = (len + 9 + 63) / 64 * 64;\n    if new_len > cap {\n        return TOTP_EBOUNDS;\n    }\n\n    // memset(buf+len, 0, new_len-len)\n    for i in len..new_len {\n        buf[i] = 0;\n    }\n    buf[len] = 1 << 7;\n\n    // unpack64(len*8, &buf[new_len-8])\n    let len_bits = (len as u64).wrapping_mul(8);\n    {\n        let arr: &mut [u8; 8] = (&mut buf[new_len - 8..new_len]).try_into().unwrap();\n        unpack64(len_bits, arr);\n    }\n\n    let mut h: [u32; 5] = [\n        0x6745_2301,\n        0xEFCD_AB89,\n        0x98BA_DCFE,\n        0x1032_5476,\n        0xC3D2_E1F0,\n    ];\n    let mut w: [u32; 80] = [0; 80];\n\n    let blocks = new_len / 64;\n    for i in 0..blocks {\n        for t in 0..16 {\n            let block: &[u8; 4] = (&buf[i * 64 + t * 4..i * 64 + t * 4 + 4])\n                .try_into()\n                .unwrap();\n            w[t] = pack32(block);\n        }\n        for t in 16..80 {\n            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);\n        }\n\n        let mut a = h[0];\n        let mut b = h[1];\n        let mut c = h[2];\n        let mut d = h[3];\n        let mut e = h[4];\n\n        for t in 0..80 {\n            let f = if t < 20 {\n                (b & c) ^ (!b & d)\n            } else if t < 40 {\n                b ^ c ^ d\n            } else if t < 60 {\n                (b & c) ^ (b & d) ^ (c & d)\n            } else {\n                b ^ c ^ d\n            };\n\n            let temp = rotl(a, 5)\n                .wrapping_add(f)\n                .wrapping_add(e)\n                .wrapping_add(K[t / 20])\n                .wrapping_add(w[t]);\n            e = d;\n            d = c;\n            c = rotl(b, 30);\n            b = a;\n            a = temp;\n        }\n\n        h[0] = h[0].wrapping_add(a);\n        h[1] = h[1].wrapping_add(b);\n        h[2] = h[2].wrapping_add(c);\n        h[3] = h[3].wrapping_add(d);\n        h[4] = h[4].wrapping_add(e);\n    }\n\n    for i in 0..5 {\n        let arr: &mut [u8; 4] = (&mut hash[i * 4..i * 4 + 4]).try_into().unwrap();\n        unpack32(h[i], arr);\n    }\n\n    TOTP_OK\n}\n\npub fn from_base32(s: &str, buf: &mut [u8], cap: usize) -> usize {\n    let bytes = s.as_bytes();\n    let n = std::strlen(s);\n\n    if n % 8 != 0 {\n        return 0;\n    }\n    if cap < (n + 1) / 8 * 5 {\n        return 0;\n    }\n\n    let blocks = n / 8;\n    let mut v = [0u8; 8];\n\n    for i in 0..blocks {\n        for j in 0..8 {\n            let c = bytes[i * 8 + j];\n            v[j] = if c == b'=' {\n                0\n            } else if c >= b'A' && c <= b'Z' {\n                c - b'A'\n            } else if c >= b'a' && c <= b'z' {\n                c - b'a'\n            } else if c >= b'2' && c <= b'7' {\n                c - b'2' + 26\n            } else {\n                return 0;\n            };\n        }\n\n        buf[i * 5] = (v[0] << 3) | (v[1] >> 2);\n        buf[i * 5 + 1] = (v[1] << 6) | (v[2] << 1) | (v[3] >> 4);\n        buf[i * 5 + 2] = (v[3] << 4) | (v[4] >> 1);\n        buf[i * 5 + 3] = (v[4] << 7) | (v[5] << 2) | (v[6] >> 3);\n        buf[i * 5 + 4] = (v[6] << 5) | v[7];\n\n        if bytes[i * 8 + 2] == b'=' {\n            return i * 5 + 1;\n        }\n        if bytes[i * 8 + 4] == b'=' {\n            return i * 5 + 2;\n        }\n        if bytes[i * 8 + 5] == b'=' {\n            return i * 5 + 3;\n        }\n        if bytes[i * 8 + 7] == b'=' {\n            return i * 5 + 4;\n        }\n    }\n\n    blocks * 5\n}\n\npub fn unpack64(x: u64, a: &mut [u8; 8]) {\n    a[0] = (x >> 56) as u8;\n    a[1] = (x >> 48) as u8;\n    a[2] = (x >> 40) as u8;\n    a[3] = (x >> 32) as u8;\n    a[4] = (x >> 24) as u8;\n    a[5] = (x >> 16) as u8;\n    a[6] = (x >> 8) as u8;\n    a[7] = x as u8;\n}\n\npub fn pack32(a: &[u8; 4]) -> u32 {\n    ((a[0] as u32) << 24) | ((a[1] as u32) << 16) | ((a[2] as u32) << 8) | (a[3] as u32)\n}\n\npub fn unpack32(x: u32, a: &mut [u8; 4]) {\n    a[0] = (x >> 24) as u8;\n    a[1] = (x >> 16) as u8;\n    a[2] = (x >> 8) as u8;\n    a[3] = x as u8;\n}\n\npub fn totp(key: &[u8; 64], time: u64) -> i32 {\n    hotp(key, time / 30)\n}\n\npub fn hmac_sha1(key: &[u8; 64], data: &[u8], len: usize, hash: &mut [u8; 20]) -> i32 {\n    if len > 64 {\n        return TOTP_EBOUNDS;\n    }\n\n    let mut buf = [0u8; 196];\n\n    for i in 0..64 {\n        buf[i] = key[i] ^ 0x36;\n    }\n    for i in 0..len {\n        buf[64 + i] = data[i];\n    }\n    sha1(&mut buf, 64 + len, 196, hash);\n\n    for i in 0..64 {\n        buf[i] = key[i] ^ 0x5C;\n    }\n    for i in 0..20 {\n        buf[64 + i] = hash[i];\n    }\n    sha1(&mut buf, 64 + 20, 196, hash);\n\n    TOTP_OK\n}\n\npub fn rotl(x: u32, n: i32) -> u32 {\n    x.rotate_left(n as u32)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_detail