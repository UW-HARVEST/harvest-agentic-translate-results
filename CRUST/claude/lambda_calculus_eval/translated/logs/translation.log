ction_type(char *type);\n\nbool expr_type_equal(Type *t, AstNode *expr);\n\nvoid add_to_env(TypeEnv **env, Type *type);\n\nType *lookup_type(TypeEnv *env, AstNode *expr);\n\n#endif\n","numLines":42,"startLine":1,"totalLines":42}}}
