{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X9qU6iybSvamoykPE8bPxQ","type":"tool_result","content":"1\tuse lambda_calculus_eval::common;\n2\tuse lambda_calculus_eval::config;\n3\tuse lambda_calculus_eval::io;\n4\tuse lambda_calculus_eval::parser; \n5\tuse lambda_calculus_eval::reducer;\n6\tuse lambda_calculus_eval::typechecker;\n7\tuse lambda_calculus_eval::hash_table::HashTable;\n8\tuse lambda_calculus_eval::common::{AstNode, AstNodeType};\n9\tuse std::io::{Read, Seek, Write};\n10\t\n11\t\n12\t#[test]\n13\tfn test_trim() {\n14\tlet mut str_to_trim = String::from(\"  test  \");\n15\tconfig::trim(&mut str_to_trim);\n16\tassert_eq!(str_to_trim, \"test\");\n17\t}\n18\t\n19\t#[test]\n20\tfn test_get_config_type() {\n21\tlet file_opt = config::get_config_type(\"file\");\n22\tlet step_opt = config::get_config_type(\"step_by_step_reduction\");\n23\tlet reduction = config::get_config_type(\"reduction_order\");\n24\tassert_eq!(file_opt, config::option_type_t::FILENAME);\n25\tassert_eq!(step_opt, config::option_type_t::STEP_REDUCTION);\n26\tassert_eq!(reduction, config::option_type_t::REDUCTION_ORDER);\n27\t}\n28\t\n29\t#[test]\n30\tfn test_parse_config() {\n31\tlet line = \"file=expr.lambda\";\n32\tlet mut key = String::new();\n33\tlet mut value = String::new();\n34\tconfig::parse_config(line, &mut key, &mut value);\n35\tassert_eq!(key, \"file\");\n36\tassert_eq!(value, \"expr.lambda\");\n37\t}\n38\t\n39\tconst TEMP_PATH: &str = \"temp/test.txt\";\n40\t\n41\tfn ensure_temp_dir() {\n42\t    std::fs::create_dir_all(\"temp\").ok();\n43\t}\n44\t\n45\t#[test]\n46\tfn test_create_file() {\n47\tensure_temp_dir();\n48\tlet _ = io::create_file(TEMP_PATH).unwrap();\n49\tassert!(std::fs::metadata(TEMP_PATH).is_ok());\n50\tstd::fs::remove_file(TEMP_PATH).unwrap();\n51\t}\n52\t\n53\t#[test]\n54\tfn test_get_file() {\n55\tensure_temp_dir();\n56\tlet mut c = io::create_file(TEMP_PATH).unwrap();\n57\tlet mut d = io::get_file(TEMP_PATH, \"r+\").unwrap();\n58\tlet test_str = \"Hello\";\n59\twrite!(c, \"{}\", test_str).unwrap();\n60\tc.flush().unwrap();\n61\td.seek(std::io::SeekFrom::Start(0)).unwrap();\n62\tlet mut buffer = String::new();\n63\td.read_to_string(&mut buffer).unwrap();\n64\tassert_eq!(buffer, test_str);\n65\tio::delete_file(TEMP_PATH).unwrap();\n66\t}\n67\t\n68\t#[test]\n69\tfn test_file_deletion() {\n70\tensure_temp_dir();\n71\tlet _ = io::create_file(TEMP_PATH).unwrap();\n72\tassert!(std::fs::metadata(TEMP_PATH).is_ok());\n73\tio::delete_file(TEMP_PATH).unwrap();\n74\tassert!(std::fs::metadata(TEMP_PATH).is_err());\n75\t}\n76\t\n77\t#[test]\n78\tfn test_parse_token() {\n79\tassert_eq!(parser::parse_token('('), common::tokens_t::L_PAREN);\n80\tassert_eq!(parser::parse_token(')'), common::tokens_t::R_PAREN);\n81\tassert_eq!(parser::parse_token('@'), common::tokens_t::LAMBDA);\n82\tassert_eq!(parser::parse_token('.'), common::tokens_t::DOT);\n83\tassert_eq!(parser::parse_token('t'), common::tokens_t::VARIABLE);\n84\tassert_eq!(parser::parse_token(' '), common::tokens_t::WHITESPACE);\n85\tassert_eq!(parser::parse_token('\\n'), common::tokens_t::NEWLINE);\n86\tassert_eq!(parser::parse_token('='), common::tokens_t::EQ);\n87\tassert_eq!(parser::parse_token('\"'), common::tokens_t::QUOTE);\n88\tassert_eq!(parser::parse_token(':'), common::tokens_t::COLON);\n89\tassert_eq!(parser::parse_token('$'), common::tokens_t::ERROR);\n90\t}\n91\t\n92\t#[test]\n93\tfn test_is_variable() {\n94\tassert!(parser::is_variable('t'));\n95\tassert!(!parser::is_variable('*'));\n96\t}\n97\t\n98\t#[test]\n99\tfn test_create_variable() {\n100\tlet name = \"test\";\n101\tlet type_ = \"Nat\";\n102\tlet var = parser::create_variable(name, type_);\n103\tif let common::AstNodeUnion::Variable(variable) = var.node {\n104\tassert_eq!(var.type_, AstNodeType::VAR);\n105\tassert_eq!(variable.name, name);\n106\tassert_eq!(variable.type_, type_);\n107\t} else {\n108\tpanic!(\"Expected variable node\");\n109\t}\n110\t}\n111\t\n112\t#[test]\n113\tfn test_create_application() {\n114\tlet app = parser::create_application(&AstNode::default(), &AstNode::default());\n115\tif let common::AstNodeUnion::Application(application) = app.node {\n116\tassert_eq!(app.type_, AstNodeType::APPLICATION);\n117\tassert!(application.function.is_some());\n118\tassert!(application.argument.is_some());\n119\t} else {\n120\tpanic!(\"Expected application node\");\n121\t}\n122\t}\n123\t\n124\t#[test]\n125\tfn test_create_lambda() {\n126\tlet param = \"test\";\n127\tlet type_ = \"nat\";\n128\tlet lambda = parser::create_lambda(param, &AstNode::default(), type_);\n129\tif let common::AstNodeUnion::LambdaExpr(lambda_expr) = lambda.node {\n130\tassert_eq!(lambda.type_, AstNodeType::LAMBDA_EXPR);\n131\tassert_eq!(lambda_expr.parameter, param);\n132\tassert_eq!(lambda_expr.type_, type_);\n133\tassert!(lambda_expr.body.is_some());\n134\t} else {\n135\tpanic!(\"Expected lambda expression node\");\n136\t}\n137\t}\n138\t\n139\t#[test]\n140\tfn test_alpha_convert() {\n141\tlet old = \"x\";\n142\tlet old_two = \"y\";\n143\tlet expected = \"x_1\";\n144\tlet expected_two = \"y_2\";\n145\tlet new = parser::alpha_convert(old);\n146\tlet new_two = parser::alpha_convert(old_two);\n147\tassert_eq!(new, expected);\n148\tassert_eq!(new_two, expected_two);\n149\t}\n150\t\n151\t#[test]\n152\tfn test_is_used() {\n153\tlet mut table = HashTable::new();\n154\tlet key = \"test\";\n155\ttable.insert(key, AstNode::default());\n156\tassert!(parser::is_used(&table, key));\n157\tassert!(!parser::is_used(&table, \"wrong\"));\n158\t}\n159\t\n160\t#[test]\n161\tfn test_is_uppercase() {\n162\tassert!(parser::is_uppercase('A'));\n163\tassert!(!parser::is_uppercase('c'));\n164\t}\n165\t\n166\t#[test]\n167\tfn test_expand_definitions() {\n168\tlet mut table = HashTable::new();\n169\tlet mut variable = parser::create_variable(\"test\", \"\");\n170\tvariable.type_ = AstNodeType::DEFINITION;\n171\tlet definition = parser::create_variable(\"testing\", \"Nat\");\n172\ttable.insert(\"test\", definition);\n173\treducer::expand_definitions(&mut table, &mut variable);\n174\tif let common::AstNodeUnion::Variable(var) = variable.node {\n175\tassert_eq!(variable.type_, AstNodeType::VAR);\n176\tassert_eq!(var.name, \"testing\");\n177\tassert_eq!(var.type_, \"Nat\");\n178\t} else {\n179\tpanic!(\"Expected variable node\");\n180\t}\n181\t}\n182\t\n183\t#[test]\n184\tfn test_replace() {\n185\tlet mut variable = parser::create_variable(\"test\", \"\");\n186\tlet mut lambda_expr = parser::create_lambda(\"test\", &variable, \"Nat\");\n187\tlet new_name = \"replaced\";\n188\treducer::replace(&mut lambda_expr, \"test\", new_name);\n189\tif let common::AstNodeUnion::LambdaExpr(lambda) = lambda_expr.node {\n190\tassert_eq!(lambda.parameter, new_name);\n191\tif let common::AstNodeUnion::Variable(var) = lambda.body.unwrap().node {\n192\tassert_eq!(var.name, new_name);\n193\t} else {\n194\tpanic!(\"Expected variable node\");\n195\t}\n196\t} else {\n197\tpanic!(\"Expected lambda expression node\");\n198\t}\n199\t}\n200\t\n201\t#[test]\n202\tfn test_reduce_ast() {\n203\tlet mut table = HashTable::new();\n204\ttable.insert(\"Nat\", AstNode::default());\n205\tlet lambda_body = parser::create_variable(\"x\", \"\");\n206\tlet y_var = parser::create_variable(\"y\", \"Nat\");\n207\tlet lambda_expr = parser::create_lambda(\"x\", &lambda_body, \"Nat\");\n208\tlet parsed = parser::create_application(&lambda_expr, &y_var);\n209\tlet reduced = reducer::reduce_ast(&mut table, &parsed);\n210\tif let common::AstNodeUnion::Variable(var) = reduced.node {\n211\tassert_eq!(reduced.type_, AstNodeType::VAR);\n212\tassert_eq!(var.name, \"y\");\n213\tassert_eq!(var.type_, \"Nat\");\n214\t} else {\n215\tpanic!(\"Expected variable node\");\n216\t}\n217\t}\n218\t\n219\t#[test]\n220\tfn test_deepcopy() {\n221\tlet lambda_body = parser::create_variable(\"x\", \"\");\n222\tlet lambda_expr = parser::create_lambda(\"x\", &lambda_body, \"Nat\");\n223\tlet deepcopied = reducer::deepcopy(&lambda_expr);\n224\tif let common::AstNodeUnion::LambdaExpr(lambda) = deepcopied.node {\n225\tassert_eq!(deepcopied.type_, AstNodeType::LAMBDA_EXPR);\n226\tassert_eq!(lambda.parameter, \"x\");\n227\tassert_eq!(lambda.type_, \"Nat\");\n228\tif let common::AstNodeUnion::Variable(var) = lambda.body.unwrap().node {\n229\tassert_eq!(var.name, \"x\");\n230\t} else {\n231\tpanic!(\"Expected variable node\");\n232\t}\n233\t} else {\n234\tpanic!(\"Expected lambda expression node\");\n235\t}\n236\t}\n237\t\n238\t#[test]\n239\tfn test_type_equal() {\n240\tlet a = typechecker::create_type(\"Nat\", \"\", &AstNode::default());\n241\tlet b = typechecker::create_type(\"Nat\", \"\", &AstNode::default());\n242\tlet c = typechecker::create_type(\"Bool\", \"\", &AstNode::default());\n243\tassert!(typechecker::type_equal(&a, &b));\n244\tassert!(!typechecker::type_equal(&a, &c));\n245\t}\n246\t\n247\t#[test]\n248\tfn test_get_type_from_expr() {\n249\tlet n = parser::create_variable(\"test\", \"Nat\");\n250\tlet n1 = parser::create_lambda(\"test\", &AstNode::default(), \"Bool\");\n251\tlet n_type = typechecker::get_type_from_expr(&n);\n252\tlet n1_type = typechecker::get_type_from_expr(&n1);\n253\tassert_eq!(n_type, \"Nat\");\n254\tassert_eq!(n1_type, \"Bool\");\n255\t}\n256\t\n257\t#[test]\n258\tfn test_expr_type_equal() {\n259\tlet n = parser::create_variable(\"test\", \"Nat\");\n260\tlet a = typechecker::create_type(\"Nat\", \"\", &n);\n261\tassert!(typechecker::expr_type_equal(&a, &n));\n262\t}\n263\t\n264\t#[test]\n265\tfn test_typecheck() {\n266\tlet lambda_body = parser::create_variable(\"x\", \"\");\n267\tlet y_var = parser::create_variable(\"y\", \"Nat\");\n268\tlet lambda_expr = parser::create_lambda(\"x\", &lambda_body, \"Nat\");\n269\tlet parsed = parser::create_application(&lambda_expr, &y_var);\n270\ttypechecker::typecheck(&parsed, None);\n271\t}\n272\t\n273\tfn main() {\n274\t    \n275\t}\n276\t"}]},"parent_tool_use_id":null,"session_id":"b24bd141-1a3d-4aa9-84eb-a2b5e9540844","u