, lex::test_ttype_one_char\n36\t//       - list::{create_list, ladd_element, lget_element, destroy_list}\n37\t//       - hashmap::{test_hash_init, test_hash_init_and_store, test_hash_set_and_get, test_hash_set_and_double_get}\n38\t//\n39\t// 8) We also replicate the test “setup” and “cleanup” prints, corresponding to testing_module_setup()\n40\t//    and testing_module_cleanup(). In C, these were macros that print a message; in Rust, we'll\n41\t//    define simple helper functions.\n42\t//\n43\t// 9) We place all of these tests into a single Rust file test_main.rs (enclosed here) with the\n44\t//    required “use jccc::filename;” format, strictly converting the logic from C to Rust.\n45\t//\n46\t// 10) The resulting Rust code (below) compiles into an executable that runs the same test\n47\t//     sequence as the original C code.\n48\t//\n49\t// -----------------------------------------------------------------------------\n50\t\n51\tuse jccc::codegen;\n52\tuse jccc::lex::{ttype_many_chars, ttype_one_char, ttype_name, ttype_from_string};\n53\tuse jccc::token::TokenType;\n54\tuse jccc::list;\n55\tuse jccc::hashmap;\n56\t/// Tests initializing the Hashmap.\n57\tpub fn test_hash_init() -> i32 {\n58\tlet h = hashmap::create_hashmap(100);\n59\tassert_eq!(h.size, 0);\n60\tassert_eq!(h.cap, 100);\n61\t0\n62\t}\n63\t    \n64\t/// Tests initializing the Hashmap and storing a value.\n65\tpub fn test_hash_init_and_store() -> i32 {\n66\tlet mut h = hashmap::create_hashmap(100);\n67\tassert_eq!(h.size, 0);\n68\tassert_eq!(h.cap, 100);\n69\tlet name = \"jake\".to_string();\n70\tlet key = \"test\".to_string();\n71\t\n72\tlet ret = hashmap::hm_set(&mut h, &key, Box::new(name.clone()));\n73\tassert_ne!(ret, -1);\n74\t\n75\tlet ind = ((h.hash)(&key) % (h.cap as u32)) as usize;\n76\tlet b = h.buckets[ind].as_ref().unwrap();\n77\tassert_eq!(b.key, key);\n78\tassert_eq!(h.size, 1);\n79\tassert_eq!(h.cap, 100);\n80\t0\n81\t}\n82\t\n83\t/// Tests setting and then getting a value in the Hashmap.\n84\tpub fn test_hash_set_and_get() -> i32 {\n85\tlet mut h = hashmap::create_hashmap(100);\n86\tlet name = \"jake\".to_string();\n87\tlet key = \"test\".to_string();\n88\tlet ret = hashmap::hm_set(&mut h, &key, Box::new(name.clone()));\n89\tassert_ne!(ret, -1);\n90\t\n91\tlet got = hashmap::hm_get(&h, &key).unwrap();\n92\tif let Some(got_string) = got.value.downcast_ref::<String>() {\n93\tassert_eq!(got_string, \"jake\");\n94\t} else {\n95\tpanic!(\"Value was not a String, which is unexpected.\");\n96\t}\n97\t0\n98\t}\n99\t\n100\t/// Tests setting a key-value pair, doubling capacity, and then getting the value.\n101\tpub fn test_hash_set_and_double_get() -> i32 {\n102\tlet mut h = hashmap::create_hashmap(100);\n103\tlet name = \"jake\".to_string();\n104\tlet key = \"test\".to_string();\n105\tlet ret = hashmap::hm_set(&mut h, &key, Box::new(name.clone()));\n106\tassert_ne!(ret, -1);\n107\t\n108\t// Force capacity doubling.\n109\thashmap::double_cap(&mut h);\n110\t\n111\tlet got = hashmap::hm_get(&h, &key).unwrap();\n112\tif let Some(got_string) = got.value.downcast_ref::<String>() {\n113\tassert_eq!(got_string, \"jake\");\n114\t} else {\n115\tpanic!(\"Value was not a String after doubling capacity, which is unexpected.\");\n116\t}\n117\t0\n118\t}\n119\t\n120\t/// Tests for ttype_many_chars.\n121\tpub fn test_ttype_many_chars() -> i32 {\n122\tassert_eq!(ttype_many_chars(\"foo\"), TokenType::TT_IDENTIFIER);\n123\tassert_eq!(ttype_many_chars(\"struct\"), TokenType::TT_STRUCT);\n124\tassert_eq!(ttype_many_chars(\"while\"), TokenType::TT_WHILE);\n125\t0\n126\t}\n127\t\n128\t/// Tests for ttype_one_char.\n129\tpub fn test_ttype_one_char() -> i32 {\n130\tassert_eq!(ttype_one_char('a'), TokenType::TT_IDENTIFIER);\n131\tassert_eq!(ttype_one_char('1'), TokenType::TT_LITERAL);\n132\tassert_eq!(ttype_one_char('+'), TokenType::TT_PLUS);\n133\tassert_eq!(ttype_one_char('-'), TokenType::TT_MINUS);\n134\tassert_eq!(ttype_one_char('>'), TokenType::TT_GREATER);\n135\tassert_eq!(ttype_one_char('~'), TokenType::TT_BNOT);\n136\t0\n137\t}\n138\t\n139\t/// Tests for ttype_name.\n140\tpub fn test_ttype_name() -> i32 {\n141\tassert_eq!(ttype_name(TokenType::TT_LITERAL), \"literal\");\n142\tassert_eq!(ttype_name(TokenType::TT_PLUS), \"+\");\n143\tassert_eq!(ttype_name(TokenType::TT_SIZEOF), \"sizeof\");\n144\tassert_eq!(ttype_name(TokenType::TT_WHILE), \"while\");\n145\t0\n146\t}\n147\t\n148\t/// Tests for ttype_from_string.\n149\tpub fn test_ttype_from_string() -> i32 {\n150\tassert_eq!(ttype_from_string(\"+\"), TokenType::TT_PLUS);\n151\tassert_eq!(ttype_from_string(\"=\"), TokenType::TT_ASSIGN);\n152\tassert_eq!(ttype_from_string(\"1\"), TokenType::TT_LITERAL);\n153\tassert_eq!(ttype_from_string(\"1.2\"), TokenType::TT_LITERAL);\n154\tassert_eq!(ttype_from_string(\"1u\"), TokenType::TT_LITERAL);\n155\tassert_eq!(ttype_from_string(\"1.2f\"), TokenType::TT_LITERAL);\n156\tassert_eq!(ttype_from_string(\"1.f\"), TokenType::TT_LITERAL);\n157\tassert_eq!(ttype_from_string(\"\\\"Planck\\\"\"), TokenType::TT_LITERAL);\n158\tassert_eq!(ttype_from_string(\"'Language'\"), TokenType::TT_LITERAL);\n159\tassert_eq!(ttype_from_string(\"Jaba\"), TokenType::TT_IDENTIFIER);\n160\tassert_eq!(ttype_from_string(\"cat_\"), TokenType::TT_IDENTIFIER);\n161\tassert_eq!(ttype_from_string(\"(\"), TokenType::TT_OPAREN);\n162\tassert_eq!(ttype_from_string(\"}\"), TokenType::TT_CBRACE);\n163\tassert_eq!(ttype_from_string(\";\"), TokenType::TT_SEMI);\n164\t0\n165\t}\n166\t    \n167\t\n168\t// -----------------------------------------------------------------------------\n169\t// Helper print functions (in place of the original \"testing_*\" macros).\n170\tfn testing_setup_internal(func_name: &str) {\n171\tprintln!(\"Running tests from \\\"{}\\\" ...\", func_name);\n172\t}\n173\t\n174\tfn testing_cleanup_internal(func_name: &str) {\n175\tprintln!(\"Concluded tests from \\\"{}\\\"\", func_name);\n176\t}\n177\t\n178\tfn testing_single_test_internal(func_name: &str) {\n179\tprint