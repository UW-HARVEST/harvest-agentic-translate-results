enc[15]);\n64\t\n65\t    TEST(memcmp(outbuf, data8_enc, outsize), 0);\n66\t\n67\t    return result;\n68\t}\n69\t\n70\tbool test_coding_decode() {\n71\t    bool result = true;\n72\t\n73\t    // verify no error\n74\t    uint8_t dummy[15] = {0};\t\t\t// write data here to discard\n75\t    size_t outsize = sizeof(dummy);\n76\t\n77\t    TEST(hecc_decode(data8_enc, sizeof(data8_enc), dummy, &outsize), true);\n78\t\n79\t    return result;\n80\t}\n81\t\n82\tbool test_coding_roundtrip() {\n83\t    bool result = true;\n84\t\n85\t    // tmp storage\n86\t    uint8_t outbuf[16] = {0};\t\t\t// result of encoding\n87\t    size_t outsize = sizeof(outbuf);\t\t// length after encoding\n88\t\n89\t    // encode data\n90\t    TEST(hecc_encode(data8, sizeof(data8), outbuf, &outsize), true);\n91\t\n92\t    TEST(outsize, sizeof(data8) + 1);\n93\t    TEST(outsize, sizeof(data8_enc));\n94\t\n95\t    TEST(memcmp(outbuf, data8_enc, outsize), 0);\n96\t\n97\t    // verify no error\n98\t    uint8_t dummy[15] = {0};\t\t\t// write data here to discard\n99\t\n100\t    TEST(hecc_decode(outbuf, outsize, dummy, &outsize), true);\n101\t    TEST(outsize, sizeof(data8));\n102\t\n103\t    TEST(memcmp(dummy, data8, outsize), 0);\n104\t\n105\t    return result;\n106\t}\n107\t\n108\tbool test_error_single() {\n109\t    bool result = true;\n110\t\n111\t    uint8_t outbuf[16] = {0};\t\t\t// result of encoding\n112\t    size_t outsize = 0u;\t\t\t// length after encoding\n113\t\n114\t    uint8_t dummy[15] = {0};\t\t\t// write data here to discard\n115\t\n116\t    // verify data error\n117\t    for (uint32_t idx = 0; idx < sizeof(data8) * 8; idx++) {\n118\t        memset(dummy, 0, sizeof(dummy));\n119\t        memcpy(outbuf, data8_enc, sizeof(outbuf));\n120\t        outbuf[idx>>3] ^= 1 << (idx % 8);\n121\t        outsize = sizeof(dummy);\n122\t\n123\t        TEST(hecc_decode(outbuf, sizeof(data8) + 1, dummy, &outsize), true);\n124\t\n125\t        TEST(outsize, sizeof(data8));\n126\t        TEST(memcmp(dummy, data8