n!(\"root: {}\", node_to_int32(&root));\n103\t    // Expected root value for these leaves is 4.\n104\t    assert_eq!(node_to_int32(&root), 4);\n105\t    println!(\"test_build_root_directly passed.\");\n106\t}\n107\t\n108\t#[test]\n109\tfn test_rebuild_proof() {\n110\t    let leaves = CbmtLeaves {\n111\t        nodes: vec![\n112\t            int32_to_node(2),\n113\t            int32_to_node(3),\n114\t            int32_to_node(5),\n115\t            int32_to_node(7),\n116\t            int32_to_node(11),\n117\t        ],\n118\t    };\n119\t    let mut tree = CbmtTree {\n120\t        nodes: Vec::new(),\n121\t        length: 0,\n122\t        capacity: 0,\n123\t    };\n124\t    let ret = cbmt_build_merkle_tree(&mut tree, &leaves, node_merge);\n125\t    assert_eq!(ret, 0);\n126\t    let root = cbmt_tree_root(&tree);\n127\t    // Build a proof for leaves with original indices 0 and 3.\n128\t    let leaf_indices = CbmtIndices {\n129\t        values: vec![0, 3],\n130\t        capacity: 0,\n131\t    };\n132\t    let proof = cbmt_tree_build_proof(&tree, &leaf_indices).expect(\"Failed to build proof\");\n133\t    println!(\n134\t        \"proof.indices: {:?}, proof.lemmas: {:?}\",\n135\t        proof.indices.values,\n136\t        proof\n137\t            .lemmas\n138\t            .iter()\n139\t            .map(|n| node_to_int32(n))\n140\t            .collect::<Vec<_>>()\n141\t    );\n142\t    // Expected: proof.indices should be [4, 7] (i.e. leaves offset by 4) and lemmas [11, 2]\n143\t    assert_eq!(proof.indices.values, vec![4, 7]);\n144\t    assert_eq!(proof.lemmas.len(), 2);\n145\t    assert_eq!(node_to_int32(&proof.lemmas[0]), 11);\n146\t    assert_eq!(node_to_int32(&proof.lemmas[1]), 2);\n147\t\n148\t    // Verify the proof against the tree root.\n149\t    let ret = cbmt_proof_verify(&proof, &root, &leaves, node_merge);\n150\t    assert_eq!(ret, 0);\n151\t    println!(\"test_rebuild_proof passed.\");\n152\t}\n153\t\n154\t#[test]\n155\tfn test_build_proof() {\n156\t    // Thi