 (add_bit((a >> 1) & 0b1 != 0, (b >> 1) & 0b1 != 0, carry, &mut carry) as U4) << 1;\n    result |= (add_bit((a >> 2) & 0b1 != 0, (b >> 2) & 0b1 != 0, carry, &mut carry) as U4) << 2;\n    result |= (add_bit((a >> 3) & 0b1 != 0, (b >> 3) & 0b1 != 0, carry, &mut carry) as U4) << 3;\n    result\n}\npub fn sub_u4(a: U4, b: U4) -> U4 {\n    let mut carry = false;\n    let mut result: U4 = 0;\n    result |= (sub_bit((a >> 0) & 0b1 != 0, (b >> 0) & 0b1 != 0, carry, &mut carry) as U4) << 0;\n    result |= (sub_bit((a >> 1) & 0b1 != 0, (b >> 1) & 0b1 != 0, carry, &mut carry) as U4) << 1;\n    result |= (sub_bit((a >> 2) & 0b1 != 0, (b >> 2) & 0b1 != 0, carry, &mut carry) as U4) << 2;\n    result |= (sub_bit((a >> 3) & 0b1 != 0, (b >> 3) & 0b1 != 0, carry, &mut carry) as U4) << 3;\n    result\n}\npub fn check_add() -> bool {\n    for a in 0..=U4_MAX {\n        for b in 0..=U4_MAX {\n            let expected = (a.wrapping_add(b)) & U4_MAX;\n            if add_u4(a, b) != expected {\n                return false;\n            }\n        }\n    }\n    true\n}\npub fn check_sub() -> bool {\n    for a in 0..=U4_MAX {\n        for b in 0..=U4_MAX {\n            let expected = (a.wrapping_sub(b)) & U4_MAX;\n            if sub_u4(a, b) != expected {\n                return false;\n            }\n        }\n    }\n    true\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":196,"cache_read_input_tokens":18525,"cache_creation":{"ephemeral_5m_input_tokens":196,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b501f86a-0c50-4692-a700-87b46e4f2576","uuid":"9b4c0744-f349-4801-a10d-d245dd189190"}
