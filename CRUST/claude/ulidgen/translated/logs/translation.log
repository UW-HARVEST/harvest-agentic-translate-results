\n        if let Some(idx) = B32_ALPHABET\n            .iter()\n            .position(|&c| c as char == ulid[pos])\n        {\n            // idx < 31 because ulid[pos] != 'Z'\n            ulid[pos] = B32_ALPHABET[idx + 1] as char;\n            return;\n        }\n        // else: invalid char in current ULID, fall through to randomize\n    }\n\n    // Generate a fresh 16-byte random buffer and encode each byte as base32\n    let mut rnd = [0u8; 16];\n    rand::thread_rng().fill_bytes(&mut rnd);\n\n    for i in 0..16 {\n        ulid[10 + i] = B32_ALPHABET[(rnd[i] % 32) as usize] as char;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":298,"cache_read_input_tokens":20468,"cache_creation":{"ephemeral_5m_input_tokens":298,"ephemeral_1h_input_tokens":0},"output_tokens":39,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"561f4b47-31ab-4869-a4e7-d6d810576db6","uuid":"c90fa045-4617-42c9-adeb-a6fcba9b4fdc"}
