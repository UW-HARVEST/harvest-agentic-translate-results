{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_eu2arm45g36nrym7mrne4oimwb7mrg76cijfc52fnyv4gjtz2xfq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01AYR8GLMTGfqG2cMzZMbMgS","name":"Write","input":{"file_path":"/tmp/harvest-crust-4xUKOi/project/src/trim.rs","content":"use crate::queue::Queue;\nuse crate::fst::{ArcData, Fst, State, EPS};\nuse crate::bitset::BitSet;\nuse crate::sr::sr_get;\nuse crate::iter::FstIter;\npub fn fst_close(fst: &mut Fst, finals: &mut Queue<State>) {\n    if finals.len() < 2 {\n        return;\n    }\n    let sr = sr_get(fst.sr_type);\n    let final_s = fst.add_state();\n    fst.set_final(final_s, sr.one);\n    while let Some(s) = finals.dequeue() {\n        let weight = {\n            let st = &mut fst.states[s as usize];\n            st.final_state = false;\n            st.weight\n        };\n        fst.add_arc(s, final_s, EPS, EPS, weight);\n    }\n}\npub fn fst_reverse(fst: &mut Fst) {\n    let sr = sr_get(fst.sr_type);\n    // Save the original states (with arcs)\n    let orig_states = fst.states.clone();\n    let start_s = fst.start;\n    // Clear arcs and find the new start (the final state).\n    let mut new_start: Option<State> = None;\n    for (i, state) in fst.states.iter_mut().enumerate() {\n        state.n_arcs = 0;\n        state.arcs.clear();\n        if state.final_state {\n            new_start = Some(i as State);\n            state.final_state = false;\n        }\n    }\n    if let Some(ns) = new_start {\n        fst.start = ns;\n    }\n    // Set start as final\n    fst.set_final(start_s, sr.one);\n    // Now add reversed arcs\n    for (s, ostate) in orig_states.iter().enumerate() {\n        for arc in &ostate.arcs {\n            fst.add_arc(arc.state, s as State, arc.ilabel, arc.olabel, arc.weight);\n        }\n    }\n}\npub fn fst_rm_states(fst: &mut Fst, mask: &BitSet) {\n    let n = fst.n_states as usize;\n    let mut idx: Vec<u32> = vec![0; n];\n    let mut shift: u32 = 0;\n    let mut new_states: Vec<crate::fst::StateData> = Vec::with_capacity(n);\n    for s in 0..n {\n        if mask.get(s) {\n            shift += 1;\n        } else {\n            idx[s] = shift;\n            new_states.push(fst.states[s].clone());\n        }\n    }\n    fst.states = new_states;\n    fst.n_states -= shift;\n    // fix arc destination state ids\n    for state in fst.states.iter_mut() {\n        let mut new_arcs: Vec<ArcData> = Vec::with_capacity(state.arcs.len());\n        for arc in &state.arcs {\n            let new_dst = (arc.state).wrapping_sub(idx[arc.state as usize]);\n            if new_dst >= fst.n_states {\n                continue;\n            }\n            let mut new_arc = *arc;\n            new_arc.state = new_dst;\n            new_arcs.push(new_arc);\n        }\n        state.n_arcs = new_arcs.len() as u32;\n        state.arcs = new_arcs;\n    }\n}\npub fn fst_get_finals(fst: &mut Fst, finals: &mut Queue<State>) {\n    for s in 0..fst.n_states {\n        if fst.states[s as usize].final_state {\n            finals.enqueue(s);\n        }\n    }\n}\npub fn fst_trim(fst: &mut Fst) {\n    let mut finals: Queue<State> = Queue::new();\n    fst_get_finals(fst, &mut finals);\n    if finals.len() == 0 {\n        fst.empty();\n        return;\n    }\n    if finals.len() > 1 {\n        fst_close(fst, &mut finals);\n    }\n    // Forward iteration\n    let forward_marked = {\n        let mut iter = FstIter::new(fst);\n        while iter.next().is_some() {}\n        iter.marked\n    };\n    // Reverse the FST and iterate\n    fst_reverse(fst);\n    let reverse_marked = {\n        let mut iter_rev = FstIter::new(fst);\n        while iter_rev.next().is_some() {}\n        iter_rev.marked\n    };\n    // Reverse it back\n    fst_reverse(fst);\n    // Compute intersection (states reachable both forward and from finals)\n    let mut intersect = forward_marked;\n    intersect.intersect(&reverse_marked);\n    // Toggle: now we want to remove (the inverse of the intersection)\n    let removed = intersect.toggle_all();\n    fst_rm_states(fst, &removed);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1070,"cache_read_input_tokens":128954,"cache_creation":{"ephemeral_5m_input_tokens":1070,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e88f162a-08e0-465a-8324-81480e433fd1","uuid":"769f9585-986a-441d-abc9-2a2a8e7fe3e1"}
