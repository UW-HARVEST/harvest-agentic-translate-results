{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Kpn2T4AmssJV3f91V68F26","type":"tool_result","content":"1\tuse fslib::hash::HashTable;\n2\tfn int_hash(x: &i32) -> usize {\n3\t    *x as usize\n4\t}\n5\t#[test]\n6\tfn test_hash_table() {\n7\t    let mut hash_table = HashTable::new(int_hash, 1003);\n8\t    assert!(hash_table.get(&0).is_none());\n9\t    for i in 0..1500 {\n10\t        hash_table.insert(i, i);\n11\t    }\n12\t    for i in 0..1500 {\n13\t        assert_eq!(hash_table.get(&i), Some(&i));\n14\t    }\n15\t    assert!(hash_table.get(&1500).is_none());\n16\t}\n17\t#[test]\n18\tfn test_hash_resize() {\n19\t    let mut hash_table = HashTable::new(int_hash, 1);\n20\t    for i in 0..4 {\n21\t        hash_table.insert(i, i);\n22\t    }\n23\t    assert!(hash_table.buckets.len() >= 4);\n24\t}\n25\t#[test]\n26\tfn test_load_int() {\n27\t    let mut hash_table = HashTable::new(int_hash, 10000);\n28\t    for i in 0..100000 {\n29\t        hash_table.insert(i, i);\n30\t    }\n31\t    for i in 0..100000 {\n32\t        assert_eq!(hash_table.get(&i), Some(&i));\n33\t    }\n34\t}\n35\t#[test]\n36\tfn test_hash_update() {\n37\t    let mut hash_table = HashTable::new(int_hash, 1);\n38\t    hash_table.insert(0, 0);\n39\t    assert_eq!(hash_table.get(&0), Some(&0));\n40\t    hash_table.insert(0, 1);\n41\t    assert_eq!(hash_table.get(&0), Some(&1));\n42\t}\n43\t#[test]\n44\tfn test_hash_delete() {\n45\t    let mut hash_table = HashTable::new(int_hash, 1);\n46\t    hash_table.insert(0, 0);\n47\t    assert_eq!(hash_table.get(&0), Some(&0));\n48\t    hash_table.remove(&0);\n49\t    assert!(hash_table.get(&0).is_none());\n50\t}\n51\tfn main() {}"}]},"parent_tool_use_id":null,"session_id":"e88f162a-08e0-465a-8324-81480e433fd1","uuid":"46aa3768-d5a7-4297-be4d-4fe889ceb21b","timestamp":"2026-05-29T01:36:32.174Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-4xUKOi/project/src/bin/test_hash.rs","content":"use fslib::hash::HashTable;\nfn int_hash(x: &i32) -> usize {\n    *x as usize\n}\n#[test]\nfn test_hash_table() {\n    let mut hash_table = HashTable::new(int_hash, 1003);\n    assert!(hash_table.get(&0).is_none());\n    for i in 0..1500 {\n        hash_table.insert(i, i);\n    }\n    for i in 0..1500 {\n        assert_eq!(hash_table.get(&i), Some(&i));\n    }\n    assert!(hash_table.get(&1500).is_none());\n}\n#[test]\nfn test_hash_resize() {\n    let mut hash_table = HashTable::new(int_hash, 1);\n    for i in 0..4 {\n        hash_table.insert(i, i);\n    }\n    assert!(hash_table.buckets.len() >= 4);\n}\n#[test]\nfn test_load_int() {\n    let mut hash_table = HashTable::new(int_hash, 10000);\n    for i in 0..100000 {\n        hash_table.insert(i, i);\n    }\n    for i in 0..100000 {\n        assert_eq!(hash_table.get(&i), Some(&i));\n    }\n}\n#[test]\nfn test_hash_update() {\n    let mut hash_table = HashTable::new(int_hash, 1);\n    hash_table.insert(0, 0);\n    assert_eq!(hash_table.get(&0), Some(&0));\n    hash_table.insert(0, 1);\n    assert_eq!(hash_table.get(&0), Some(&1));\n}\n#[test]\nfn test_hash_delete() {\n    let mut hash_table = HashTable::new(int_hash, 1);\n    hash_table.insert(0, 0);\n    assert_eq!(hash_table.get(&0), Some(&0));\n    hash_table.remove(&0);\n    assert!(hash_table.get(&0).is_none());\n}\nfn main() {}","numLines":51,"startLine":1,"totalLines":51}}}
