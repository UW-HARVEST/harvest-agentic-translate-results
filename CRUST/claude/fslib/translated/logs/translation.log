{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01RAh6PK5iefaxqJCXs8afXg","type":"tool_result","content":"1\t#ifndef __HEAP_H__\n2\t#define __HEAP_H__\n3\t\n4\t#define HEAP_INIT_SIZE      0xff\n5\t#define HEAP_RESIZE_FACTOR  2\n6\t\n7\t#include \"hash.h\"\n8\t\n9\t/*\n10\t\n11\tStraightforward implementation of binary heap based on\n12\tCormen at al algorithm. \n13\t\n14\tHeap is\n15\t- array based\n16\t- unlimited\n17\t- pointer container\n18\t\n19\tComparator 'heap_cmp' is a function that can be \n20\t- strict upper for MAX HEAP\n21\t- strict lower for MIN HEAP\n22\t\n23\tExample:\n24\t\n25\tint cmp_lower(const void * a, const void * b) {\n26\t   return *(int*)a < *(int*)b;\n27\t}\n28\t*/\n29\t\n30\ttypedef int (*heap_cmp) (const void * a, const void * b);\n31\ttypedef int (*heap_key_eq) (const void * a, const void * b);\n32\t\n33\tstruct _heap {\n34\t    size_t              n_items;\n35\t    size_t              n_max;\n36\t    size_t              item_size;\n37\t    size_t              limit;\n38\t    heap_cmp            cmp;\n39\t    struct _hash *      ht;\n40\t    char *              items;  // TODO: generalize it!\n41\t};\n42\t\n43\tstruct _heap * heap_create(\n44\t                            heap_cmp cmp, \n45\t                            size_t item_size, \n46\t                            size_t init_size,\n47\t                            size_t limit);\n48\t\n49\tstruct _hash * heap_index(struct _heap * heap, hash_func hsh, cmp_func hcmp);\n50\tvoid heap_remove(struct _heap * heap);\n51\tvoid * heap_pop(struct _heap * heap, void * item);\n52\tvoid heap_heapify(struct _heap * heap, size_t i);\n53\tvoid heap_insert(struct _heap * heap, void * item);\n54\tvoid heap_update(struct _heap * heap, void * item, size_t i);\n55\t\n56\tvoid * heap_find(struct _heap * heap, void * item, size_t * pi);\n57\t\n58\t\n59\t#endif\n60\t"}]},"parent_tool_use_id":null,"session_id":"e88f162a-08e0-465a-8324-81480e433fd1","uuid":"2dd260f3-2abf-49db-ae