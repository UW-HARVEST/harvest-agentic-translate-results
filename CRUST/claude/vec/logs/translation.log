emp;\n    }\n    data.truncate(len - count);\n}\n\npub fn vec_reserve_po2<T>(data: &mut Vec<T>, n: usize) -> i32 {\n    if n == 0 {\n        return 0;\n    }\n    let mut n2: usize = 1;\n    while n2 < n {\n        n2 <<= 1;\n    }\n    vec_reserve(data, n2)\n}\n\npub fn vec_expand<T>(data: &mut Vec<T>) -> i32 {\n    let len = data.len();\n    let cap = data.capacity();\n    if len + 1 > cap {\n        let new_cap = if cap == 0 { 1 } else { cap << 1 };\n        let additional = new_cap - len;\n        data.reserve_exact(additional);\n    }\n    0\n}\n\npub fn vec_reserve<T>(data: &mut Vec<T>, n: usize) -> i32 {\n    if n > data.capacity() {\n        let additional = n - data.len();\n        data.reserve_exact(additional);\n    }\n    0\n}\n\npub fn vec_compact<T>(data: &mut Vec<T>) -> i32 {\n    data.shrink_to_fit();\n    0\n}\n\npub fn vec_swap<T>(data: &mut Vec<T>, idx1: usize, idx2: usize) {\n    if idx1 == idx2 {\n        return;\n    }\n    data.swap(idx1, idx2);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":196,"cache_read_input_tokens":29164,"cache_creation":{"ephemeral_5m_input_tokens":196,"ephemeral_1h_input_tokens":0},"output_tokens":40,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"26c1eae6-c512-4a15-91af-0068e8c5c4df","uuid":"b7c47694-ff70-4cb3-b765-dac7a9c714cf"}
