nd data[src_start..] holds what was in data[start..start+count].\n            // Since we're going to truncate, the back portion is discarded.\n            data.swap(start + i, src_start + i);\n        }\n        let _ = temp;\n    }\n    data.truncate(len - count);\n}\n\npub fn vec_reserve_po2<T>(data: &mut Vec<T>, n: usize) -> i32 {\n    if n == 0 {\n        return 0;\n    }\n    let mut n2: usize = 1;\n    while n2 < n {\n        n2 <<= 1;\n    }\n    vec_reserve(data, n2)\n}\n\npub fn vec_expand<T>(data: &mut Vec<T>) -> i32 {\n    let len = data.len();\n    let cap = data.capacity();\n    if len + 1 > cap {\n        let new_cap = if cap == 0 { 1 } else { cap << 1 };\n        let additional = new_cap - len;\n        data.reserve_exact(additional);\n    }\n    0\n}\n\npub fn vec_reserve<T>(data: &mut Vec<T>, n: usize) -> i32 {\n    if n > data.capacity() {\n        let additional = n - data.len();\n        data.reserve_exact(additional);\n    }\n    0\n}\n\npub fn vec_compact<T>(data: &mut Vec<T>) -> i32 {\n    data.shrink_to_fit();\n    0\n}\n\npub fn vec_swap<T>(data: &mut Vec<T>, idx1: usize, idx2: usize) {\n    if idx1 == idx2 {\n        return;\n    }\n    data.swap(idx1, idx2);\n}\n","structuredPatch":[{"oldStart":29,"oldLines":23,"newStart":29,"newLines":16,"lines":["     if start >= len || count > len {","         return;","     }","-    // Copy the last `count` elements to position `start`, then truncate.","-    // Mimics C's memmove behavior: data[start..start+count] = data[len-count..len]","-    // Note: the regions can overlap if start is near the end.","+    // Mimic C's memmove: copy the last `count` elements to position `start`,","+    // then shrink length by `count`.","     let src_start = len - count;","     if start != src_start {","-        // Use a temporary buffer to handle potential overlap safely.","-        let temp: Vec<usize> = (0..count).collect();","-        // We need to move values; since we cannot copy generic T without Clone,","-  