tor.for_each(pos, |_offset, _length| {\n48\t            count += 1;\n49\t        });\n50\t        assert_eq!(\n51\t            count, expected_substrings[pos],\n52\t            \"Unexpected substring count at pos {}\",\n53\t            pos\n54\t        );\n55\t    }\n56\t}\n57\t\n58\t#[test]\n59\tfn substring_enumerator_aa_bb_cc_test() {\n60\t    pretty_print_sub_test_name(\"substring_enumerator_aa_bb_cc_test\");\n61\t    let data = b\"aa bb cc\";\n62\t    let enumerator = SubstringEnumerator::new(data, 2, 273);\n63\t    for pos in 0..data.len() {\n64\t        enumerator.for_each(pos, |_offset, _length| {\n65\t            panic!(\"Got a substring when none was expected at pos {}\", pos);\n66\t        });\n67\t    }\n68\t}\n69\tpub fn main(){}"}]},"parent_tool_use_id":null,"session_id":"e44a190c-12e0-4ceb-ae38-678018577377","uuid":"c34c0aea-57b2-46c6-b18f-eb88e517dd0a","timestamp":"2026-05-29T03:06:48.946Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-dkpkwC/project/src/bin/substring_enumerator_test.rs","content":"use Megalania::substring_enumerator::SubstringEnumerator;\npub fn pretty_print_test_name(name: &str) {\n    println!(\"=== {} ===\", name);\n}\npub fn pretty_print_sub_test_name(name: &str) {\n    println!(\"> {}\", name);\n}\n#[test]\nfn substring_enumerator_hello_hello_test() {\n    pretty_print_sub_test_name(\"substring_enumerator_hello_hello_test\");\n    let data = b\"hello hello\";\n    let expected_substrings = [0, 0, 0, 0, 0, 0, 4, 3, 2, 1, 0];\n    let enumerator = SubstringEnumerator::new(data, 2, 273);\n    for pos in 0..data.len() {\n        let mut count = 0;\n        enumerator.for_each(pos, |offset, length| {\n            // Ensure that the substring from “offset” of length “length”\n            // matches the substring at pos.\n            for i in 0..length {\n                assert_eq!(\n                    data[offset + i],\n                    data[pos + i],\n                    \"Substring does not match at po