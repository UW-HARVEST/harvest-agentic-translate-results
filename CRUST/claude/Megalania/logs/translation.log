{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01MMjNV18AP5VQTChZkc8z2B","type":"tool_result","content":"1\t#include \"range_encoder.h\"\n2\t#include <stdlib.h>\n3\t#include <unistd.h>\n4\t#include <stdio.h>\n5\t\n6\t//Most of this code is lifted directly from example LZMA encoders. I haven't yet figured out how exactly it works practically, I just know the theory.\n7\t\n8\t#define TOP_MASK 0xFF000000\n9\t\n10\ttypedef struct {\n11\t\tOutputInterface* output;\n12\t\tuint64_t low;\n13\t\tuint32_t range;\n14\t\tuint8_t cache;\n15\t\tuint64_t cache_size;\n16\t} RangeEncoderData;\n17\t\n18\tstatic void range_encoder_shift_low(EncoderInterface* enc)\n19\t{\n20\t\tRangeEncoderData* data = (RangeEncoderData*)enc->private_data;\n21\t\tOutputInterface* output = data->output;\n22\t\n23\t\tuint32_t high_bytes = data->low >> 32;\n24\t\tuint32_t low_bytes = data->low & 0xFFFFFFFF;\n25\t\tif (low_bytes < TOP_MASK || high_bytes != 0) {\n26\t\t\tuint8_t temp = data->cache;\n27\t\t\tdo {\n28\t\t\t\tuint8_t out_byte = temp + (high_bytes & 0xFF);\n29\t\t\t\tif (!(*output->write)(output, &out_byte, 1)) {\n30\t\t\t\t\tfprintf(stderr, \"could not write: %02x\\n\", out_byte);\n31\t\t\t\t}\n32\t\t\t\ttemp = 0xFF;\n33\t\t\t} while (--data->cache_size != 0);\n34\t\t\tdata->cache = (data->low >> 24) & 0xFF;\n35\t\t}\n36\t\tdata->cache_size++;\n37\t\tdata->low = low_bytes << 8;\n38\t}\n39\t\n40\tstatic void range_encoder_flush_data(EncoderInterface* enc)\n41\t{\n42\t\tfor (int i = 0; i < 5; i++) {\n43\t\t\trange_encoder_shift_low(enc);\n44\t\t}\n45\t}\n46\t\n47\tstatic void range_encoder_encode_bit(EncoderInterface* enc, bool bit, Prob prob)\n48\t{\n49\t\tRangeEncoderData* data = (RangeEncoderData*)enc->private_data;\n50\t\t//todo: make this a debug option..?\n51\t\t// fprintf(stderr, \"bit: %d %d %u\\n\", bit, prob, data->range);\n52\t\n53\t\tuint32_t new_bound = (data->range >> NUM_BIT_MODEL_TOTAL_BITS) * prob;\n54\t\tif (bit) {\n55\t\t\tdata->low += new_bound;\n56\t\t\tdata->range -= new_bound;\n57\t\t} else {\n58\t\t\tdata->range = new_bound;\n59\t\t}\n60\t\twhile ((data->range & TOP_MASK) == 0) {\n61\t\t\tdata->range <<= 8;\n62\t\t\trange_encoder_shift_low(enc);\n63\t\t}\n64\t}\n65\t\n66\tstatic void range_encoder_encode_direct_bits(EncoderInterface* enc, unsigned bits, unsigned num_bits)\n67\t{\n68\t\tRangeEncoderData* data = (RangeEncoderData*)enc->private_data;\n69\t\tdo {\n70\t\t\tbool bit = bits & (1 << (num_bits - 1));\n71\t\t\t// fprintf(stderr, \"bit: %d direct %u\\n\", bit, data->range);\n72\t\t\tdata->range >>= 1;\n73\t\t\tif (bit) {\n74\t\t\t\tdata->low += data->range;\n75\t\t\t}\n76\t\t\tif ((data->range & TOP_MASK) == 0) {\n77\t\t\t\tdata->range <<= 8;\n78\t\t\t\trange_encoder_shift_low(enc);\n79\t\t\t}\n80\t\t} while (--num_bits);\n81\t}\n82\t\n83\tvoid range_encoder_new(EncoderInterface* enc, OutputInterface* output)\n84\t{\n85\t\tRangeEncoderData* data = malloc(sizeof(RangeEncoderData));\n86\t\tdata->output = output;\n87\t\tdata->low = 0;\n88\t\tdata->range = 0xFFFFFFFF;\n89\t\tdata->cache = 0;\n90\t\tdata->cache_size = 1;\n91\t\n92\t\tenc->encode_bit = range_encoder_encode_bit;\n93\t\tenc->encode_direct_bits = range_encoder_encode_direct_bits;\n94\t\tenc->private_data = (void*)data;\n95\t}\n96\t\n97\tvoid range_encoder_free(EncoderInterface* enc)\n98\t{\n99\t\trange_encoder_flush_data(enc);\n100\t\tfree(enc->private_data);\n101\t}\n102\t"}]},"parent_tool_use_id":null,"session_id":"e44a190c-12e0-4ceb-ae38-678018577377","uuid":"e0a23a78-95aa-44a9-bd65-57fea060e202","timestamp":"2026-05-29T03:06:36.154Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-dkpkwC/project/c_src/src/range_encoder.c","content":"#include \"range_encoder.h\"\n#include <stdlib.h>\n#include <unistd.h>\n#include <stdio.h>\n\n//Most of this code is lifted directly from example LZMA encoders. I haven't yet figured out how exactly it works practically, I just know the theory.\n\n#define TOP_MASK 0xFF000000\n\ntypedef struct {\n\tOutputInterface* output;\n\tuint64_t low;\n\tuint32_t range;\n\tuint8_t cache;\n\tuint64_t cache_size;\n} RangeEncoderData;\n\nstatic void range_encoder_shift_low(EncoderInterface* enc)\n{\n\tRangeEncoderData* data = (RangeEncoderData*)enc->private_data;\n\tOutputInterface* output = data->output;\n\n\tuint32_t high_bytes = data->low >> 32;\n\tuint32_t low_bytes = data->low & 0xFFFFFFFF;\n\tif (low_bytes < TOP_MASK || high_bytes != 0) {\n\t\tuint8_t temp = data->cache;\n\t\tdo {\n\t\t\tuint8_t out_byte = temp + (high_bytes & 0xFF);\n\t\t\tif (!(*output->write)(output, &out_byte, 1)) {\n\t\t\t\tfprintf(stderr, \"could not write: %02x\\n\", out_byte);\n\t\t\t}\n\t\t\ttemp = 0xFF;\n\t\t} while (--data->cache_size != 0);\n\t\tdata->cache = (data->low >> 24) & 0xFF;\n\t}\n\tdata->cache_size++;\n\tdata->low = low_bytes << 8;\n}\n\nstatic void range_encoder_flush_data(EncoderInterface* enc)\n{\n\tfor (int i = 0; i < 5; i++) {\n\t\trange_encoder_shift_low(enc);\n\t}\n}\n\nstatic void range_encoder_encode_bit(EncoderInterface* enc, bool bit, Prob prob)\n{\n\tRangeEncoderData* data = (RangeEncoderData*)enc->private_data;\n\t//todo: make this a debug option..?\n\t// fprintf(stderr, \"bit: %d %d %u\\n\", bit, prob, data->range);\n\n\tuint32_t new_bound = (data->range >> NUM_BIT_MODEL_TOTAL_BITS) * prob;\n\tif (bit) {\n\t\tdata->low += new_bound;\n\t\tdata->range -= new_bound;\n\t} else {\n\t\tdata->range = new_bound;\n\t}\n\twhile ((data->range & TOP_MASK) == 0) {\n\t\tdata->range <<= 8;\n\t\trange_encoder_shift_low(enc);\n\t}\n}\n\nstatic void range_encoder_encode_direct_bits(EncoderInterface* enc, unsigned bits, unsigned num_bits)\n{\n\tRangeEncoderData* data = (RangeEncoderData*)enc->private_data;\n\tdo {\n\t\tbool bit = bits & (1 << (num_bits - 1));\n\t\t// fprintf(stderr, \"bit: %d direct %u\\n\", bit, data->range);\n\t\tdata->range >>= 1;\n\t\tif (bit) {\n\t\t\tdata->low += data->range;\n\t\t}\n\t\tif ((data->range & TOP_MASK) == 0) {\n\t\t\tdata->range <<= 8;\n\t\t\trange_encoder_shift_low(enc);\n\t\t}\n\t} while (--num_bits);\n}\n\nvoid range_encoder_new(EncoderInterface* enc, OutputInterface* output)\n{\n\tRangeEncoderData* data = malloc(sizeof(RangeEncoderData));\n\tdata->output = output;\n\tdata->low = 0;\n\tdata->range = 0xFFFFFFFF;\n\tdata->cache = 0;\n\tdata->cache_size = 1;\n\n\tenc->encode_bit = range_encoder_encode_bit;\n\tenc->encode_direct_bits = range_encoder_encode_direct_bits;\n\tenc->private_data = (void*)data;\n}\n\nvoid range_encoder_free(EncoderInterface* enc)\n{\n\trange_encoder_flush_data(enc);\n\tfree(enc->private_data);\n}\n","numLines":102,"startLine":1,"totalLines":102}}}
