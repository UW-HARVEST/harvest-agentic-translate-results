int::new(id, data, MVPDataType::ByteArray)\n52\t}\n53\tfn generate_uniform_points(nbpoints: usize, dp_length: usize) -> Vec<MVPDatapoint> {\n54\t    (0..nbpoints).map(|_| generate_point(dp_length)).collect()\n55\t}\n56\tfn generate_cluster(nbpoints: usize, dplength: usize, var: i32, dist: fn(&MVPDatapoint, &MVPDatapoint) -> f32) -> Vec<MVPDatapoint> {\n57\t    let mut points = Vec::with_capacity(nbpoints);\n58\t    points.push(generate_point(dplength));\n59\t    let orig_data = points[0].data.clone();\n60\t    let mut rng = rand::thread_rng();\n61\t    let mut max_distance = 0.0;\n62\t    for _ in 1..nbpoints {\n63\t        let mut new_data = orig_data.clone();\n64\t        for val in &mut new_data {\n65\t            let diff = next_poisson_int(var);\n66\t            let toss: f32 = rng.r#gen();\n67\t            let mut v = if toss > 0.5 { diff } else { -diff };\n68\t            v += *val as i32;\n69\t            *val = cmp::min(255, cmp::max(0, v)) as u8;\n70\t        }\n71\t        let new_point = MVPDatapoint { id: format!(\"point{}\", rng.r#gen::<u64>()), data: new_data, path: vec![], datalen: dplength, data_type: MVPDataType::ByteArray };\n72\t        let d = dist(&points[0], &new_point);\n73\t        if d > max_distance {\n74\t            max_distance = d;\n75\t        }\n76\t        points.push(new_point);\n77\t    }\n78\t    println!(\"Cluster - maximum distance from main point: {}\", max_distance);\n79\t    points\n80\t}\n81\t#[test]\n82\tfn test() {\n83\t    let nbpoints = 100;\n84\t    let radius: f32 = 5.0;\n85\t    let nbcluster1 = nbpoints / 10;\n86\t    let knearest = nbpoints;\n87\t    let dplength = 10;\n88\t    let var = 10;\n89\t    let testfile = \"testfile.mvp\";\n90\t    let distance_func = point_l2_distance;\n91\t    let pointlist = generate_uniform_points(nbpoints, dplength);\n92\t    assert!(pointlist.len() == nbpoints);\n93\t    let cluster1 = generate_cluster(nbcluster1, dplength, var, distance_func);\n94\t    assert!(cluster1.len() == nbcluster1);\n95\t    let cluster_center = cluster1[0].clone();\n96\t    let mut tree = MVPTree::new(MVP_BRANCHFACTOR, MVP_PATHLENGTH, MVP_LEAFCAP, MVPDataType::ByteArray, distance_func);\n97\t    println!(\"Adding {} points to tree.\", nbpoints);\n98\t    let mut error: MVPError = tree.add(pointlist);\n99\t    assert!(error == MVPError::Success);\n100\t    println!(\"Adding {} cluster points to tree.\", nbcluster1);\n101\t    let mut error: MVPError = tree.add(cluster1);\n102\t    assert!(error == MVPError::Success);\n103\t    println!(\"Writing tree to file: {}\", testfile);\n104\t    let mut error: MVPError = tree.write(testfile, 00755);\n105\t    assert!(error == MVPError::Success);\n106\t    let mut tree = mvptree_read(testfile, distance_func).unwrap();\n107\t    let mut savedpoint: Option<MVPDatapoint> = None;\n108\t    for count in 0..(nbpoints / 10) {\n109\t        let pnt = generate_point(dplength);\n110\t        if count == 0 {\n111\t            savedpoint = Some(pnt.clone());\n112\t        }\n113\t        println!(\"Adding point: {} to tree.\", pnt.id);\n114\t        assert!(tree.add(vec![pnt]) == MVPError::Success);\n115\t    }\n116\t    println!(\"Retrieving point: {}\", cluster_center.id);\n117\t    let results = tree.retrieve(&cluster_center, knearest, radius).expect(\"Failed to retrieve points\");\n118\t    for (i, res) in results.iter().enumerate() {\n119\t        println!(\"  FOUND --> ({}) {}\", i, res.id);\n120\t    }\n121\t    if let Some(savedpoint) = savedpoint {\n122\t        println!(\"Retrieving point: {}\", savedpoint.id);\n123\t        let results = tree.retrieve(&savedpoint, knearest, radius).expect(\"Failed to retrieve points\");\n124\t        for (i, res) in results.iter().enumerate() {\n125\t            println!(\"  FOUND --> ({}) {}\", i, res.id);\n126\t        }\n127\t    }\n128\t    println!(\"Done.\");\n129\t}\n130\tpub fn main() {}"}]},"parent_tool_use_id":null,"session_id":"2f95a312-d07f-4614-b971-a17cb85f0ad2","uuid":"bd540c6e-a6c