* token_make_one_line_comment()\n381\t{\n382\t    struct buffer* buffer=buffer_create();\n383\t    char c=0;\n384\t    LEX_GETC_IF(buffer,c,(c!='\\n' && c!=EOF));\n385\t\n386\t    return token_create(&(struct token){.type=TOKEN_TYPE_COMMENT});\n387\t}\n388\t\n389\tstruct token* token_make_multiline_comment()\n390\t{\n391\t    struct buffer* buffer=buffer_create();\n392\t    char c=0;\n393\t    while (1)\n394\t    {\n395\t        LEX_GETC_IF(buffer,c,(c!='*' && c!=EOF));\n396\t        if(c==EOF)\n397\t        {\n398\t            compiler_error(lex_process->compiler,\"You did not close this multiline comment\\n\");\n399\t        }\n400\t        else if(c=='*')\n401\t        {\n402\t            nextc();\n403\t            if(peekc()=='/')\n404\t            {\n405\t                nextc();\n406\t                break; \n407\t            }\n408\t        }\n409\t    }\n410\t    return token_create(&(struct token){.type=TOKEN_TYPE_COMMENT,.sval=buffer_ptr(buffer)});\n411\t}\n412\t\n413\tstruct token* handle_comment()\n414\t{\n415\t    char c = peekc();\n416\t    if(c == '/')\n417\t    {\n418\t        nextc();\n419\t        if(peekc() == '/')\n420\t        {\n421\t            nextc();\n422\t            return token_make_one_line_comment();\n423\t        }\n424\t        else if(peekc() == '*')\n425\t        {\n426\t            nextc();\n427\t            return token_make_multiline_comment();\n428\t        }\n429\t        pushc('/');\n430\t        return token_make_operator_or_string();\n431\t    }\n432\t    return NULL;\n433\t}\n434\tchar lex_get_escaped_char(char c)\n435\t{\n436\t    char co = 0;\n437\t    switch (c)\n438\t    {\n439\t    case 'n':\n440\t        co = '\\n';\n441\t        break;\n442\t    \n443\t    case '\\\\':\n444\t        co = '\\\\';\n445\t        break;\n446\t    \n447\t    case 't':\n448\t        co = '\\t';\n449\t        break;\n450\t    \n451\t    case 'b':\n452\t        co = '\\b';\n453\t        break;\n454\t\n455\t    case '\\'':\n456\t        co =