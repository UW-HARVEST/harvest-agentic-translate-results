al,\n        sval: node.sval.clone(),\n        inum: node.inum,\n        lnum: node.lnum,\n        llnum: node.llnum,\n    };\n    let created = crate::node::node_create(&n);\n    Node {\n        r#type: created.r#type,\n        flags: created.flags,\n        pos: created.pos,\n        binded: NodeBinded::default(),\n        cval: created.cval,\n        sval: created.sval,\n        inum: created.inum,\n        lnum: created.lnum,\n        llnum: created.llnum,\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2423,"cache_read_input_tokens":98369,"cache_creation":{"ephemeral_5m_input_tokens":2423,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"58d07a3e-15c8-449a-9387-f6d443b0fd1b","uuid":"64037d1b-a9d1-4bb1-9fe4-181f8af924b6"}
