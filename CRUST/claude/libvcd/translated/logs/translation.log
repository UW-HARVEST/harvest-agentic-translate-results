g::from_utf8_lossy(&vcd.version);\n52\t    assert_eq!(\n53\t        version_str, \n54\t        \"Icarus Verilog\", \n55\t        \"Expected version to match 'Icarus Verilog', got '{}'\",\n56\t        version_str\n57\t    );\n58\t\n59\t    // 4. Assert timescale fields\n60\t    let unit_str = String::from_utf8_lossy(&vcd.timescale.unit);\n61\t    assert_eq!(\n62\t        unit_str, \n63\t        \"s\",\n64\t        \"Expected timescale unit to be 's', got '{}'\",\n65\t        unit_str\n66\t    );\n67\t    assert_eq!(\n68\t        vcd.timescale.scale, \n69\t        1, \n70\t        \"Expected timescale scale=1, got '{}'\",\n71\t        vcd.timescale.scale\n72\t    );\n73\t\n74\t    // 5. Check that we have some expected signals by name.\n75\t    //    For example, from your VCD, we see \"matched [8:0]\" was declared.\n76\t    //    The library’s `get_signal_by_name` will only work if the parser\n77\t    //    sets signal.name == \"matched [8:0]\". If not sure, print them all first.\n78\t    let matched_signal_name = \"matched [8:0]\";\n79\t    let matched_signal = vcd\n80\t        .get_signal_by_name(matched_signal_name)\n81\t        .unwrap_or_else(|| panic!(\"Expected to find signal '{}'\", matched_signal_name));\n82\t\n83\t    // Confirm size is 9 bits\n84\t    assert_eq!(\n85\t        matched_signal.size, \n86\t        9,\n87\t        \"Expected signal '{}' to have size=9 bits, found '{}'\",\n88\t        matched_signal_name,\n89\t        matched_signal.size\n90\t    );\n91\t\n92\t    // 6. Check a specific timestamp for a known value in the 'matched [8:0]' signal.\n93\t    //    From your raw VCD snippet, at #25 we see `b10010 !` which might be 5 bits.\n94\t    //    Some libraries zero-extend (e.g., \"00010010\"), others store as \"10010\".\n95\t    //    Let's assume it’s literally \"10010\" for this test:\n96\t    let timestamp_25 = 25;\n97\t    let val_25 = matched_signal\n98\t        .get_value_at_timestamp(timestamp_25)\n99\t        .unwrap_or_else(|| {\n100\