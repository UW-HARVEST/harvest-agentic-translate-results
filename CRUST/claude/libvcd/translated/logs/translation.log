mestamp = 0;\n68\t        let mut state = State::BeforeModuleDefinitions;\n69\t\n70\t        let bytes = content.as_bytes();\n71\t        let mut i = 0usize;\n72\t        while i < bytes.len() {\n73\t            let c = bytes[i] as char;\n74\t            if c == '$' {\n75\t                i += 1;\n76\t                if let Some(new_i) = parse_instruction_str(bytes, i, &mut vcd, &mut state) {\n77\t                    i = new_i;\n78\t                    continue;\n79\t                }\n80\t            } else if c == '#' {\n81\t                i += 1;\n82\t                if let Some((new_i, ts)) = parse_timestamp_str(bytes, i) {\n83\t                    current_timestamp = ts;\n84\t                    i = new_i;\n85\t                    continue;\n86\t                }\n87\t            } else if isexpression(c) {\n88\t                if let Some(new_i) =\n89\t                    parse_assignment_str(bytes, i, &mut vcd, current_timestamp)\n90\t                {\n91\t                    i = new_i;\n92\t                    continue;\n93\t                }\n94\t            } else if c.is_whitespace() {\n95\t                i += 1;\n96\t                continue;\n97\t            }\n98\t\n99\t            return Err(std::io::Error::new(\n100\t                std::io::ErrorKind::InvalidData,\n101\t                \"Failed to parse VCD\",\n102\t            ));\n103\t        }\n104\t\n105\t        Ok(vcd)\n106\t    }\n107\t\n108\t    pub fn get_signal_by_name(&self, signal_name: &str) -> Option<&Signal> {\n109\t        let target = signal_name.as_bytes();\n110\t        for signal in &self.signals {\n111\t            if signal.name == target {\n112\t                return Some(signal);\n113\t            }\n114\t        }\n115\t        None\n116\t    }\n117\t}\n118\t\n119\timpl Signal {\n120\t    pub fn get_value_at_timestamp(&self, timestamp: Timestamp) -> Option<&Vec<u8>> {\n121\t        let mut previous_value: Option<&Vec<u8>> = None;\n122\t        for value_change in &self.value_changes {\n123\t            if timestamp < value_change.timestamp {\n124\t                break;\n125\t            }\n126\t            previous_value = Some(&value_change.value);\n127\t        }\n128\t        previous_value\n129\t    }\n130\t}\n131\t\n132\tpub const BUFFER_LENGTH: usize = 512;\n133\t\n134\t#[derive(Debug, Clone, Copy, PartialEq, Eq)]\n135\tenum State {\n136\t    BeforeModuleDefinitions,\n137\t    InsideTopModule,\n138\t    InsideInnerModules,\n139\t}\n140\t\n141\t#[allow(private_interfaces)]\n142\tpub fn parse_instruction(\n143\t    file: &File,\n144\t    vcd: &mut VCD,\n145\t    state: &mut State,\n146\t) -> Result<(), std::io::Error> {\n147\t    let _ = (file, vcd, state);\n148\t    Err(std::io::Error::new(\n149\t        std::io::ErrorKind::Other,\n150\t        \"use parse_instruction_str\",\n151\t    ))\n152\t}\n153\t\n154\tpub fn parse_timestamp(file: &File) -> Result<Timestamp, std::io::Error> {\n155\t    let _ = file;\n156\t    Err(std::io::Error::new(\n157\t        std::io::ErrorKind::Other,\n158\t        \"use parse_timestamp_str\",\n159\t    ))\n160\t}\n161\t\n162\tpub fn parse_assignment(\n163\t    file: &File,\n164\t    vcd: &mut VCD,\n165\t    timestamp: &Timestamp,\n166\t) -> Result<(), std::io::Error> {\n167\t    let _ = (file, vcd, timestamp);\n168\t    Err(std::io::Error::new(\n169\t        std::io::ErrorKind::Other,\n170\t        \"use parse_assignment_str\",\n171\t    ))\n172\t}\n173\t\n174\tpub fn get_signal_index(s: &str) -> Option<usize> {\n175\t    let first = s.as_bytes().first()?;\n176\t    let id = (*first as i32) - (b'!' as i32);\n177\t    if id < 0 || id >= VCD_SIGNAL_COUNT as i32 {\n178\t        return None;\n179\t    }\n180\t    Some(id as usize)\n181\t}\n182\t\n183\t// Helper functions for parsing using a byte slice with a position index.\n184\t\n185\tfn skip_spaces_and_tabs(bytes: &[u8], mut i: usize) -> usize {\n186\t    while i < bytes.len() && (bytes[i] == b' ' || bytes[i] == b'\\t') {\n187\t        i += 1;\n188\t    }\n189\t    i\n190\t}\n191\t\n192\tfn skip_whitespace(bytes: &[u8], mut i: usize) -> usize {\n193\t    while i < bytes.len() && (bytes[i] as char).is_whitespace() {\n194\t        i += 1;\n195\t    }\n196\t    i\n197\t}\n198\t\n199\tfn read_until_dollar(bytes: &[u8], mut i: usize) -> usize {\n200\t    while i < bytes.len() && bytes[i] != b'$' {\n201\t        i += 1;\n202\t    }\n203\t    i\n204\t}\n205\t\n206\tfn read_word(bytes: &[u8], mut i: usize) -> (usize, &[u8]) {\n207\t    // Skip leading whitespace\n208\t    while i < bytes.len() && (bytes[i] as char).is_whitespace() {\n209\t        i += 1;\n210\t    }\n211\t    let start = i;\n212\t    while i < bytes.len() && !(bytes[i] as char).is_whitespace() {\n213\t        i += 1;\n214\t    }\n215\t    (i, &bytes[start..i])\n216\t}\n217\t\n218\tfn parse_instruction_str(\n219\t    bytes: &[u8],\n220\t    i: usize,\n221\t    vcd: &mut VCD,\n222\t    state: &mut State,\n223\t) -> Option<usize> {\n224\t    // Read instruction word.\n225\t    let (mut idx, instruction) = read_word(bytes, i);\n226\t    if instruction.is_empty() {\n227\t        return None;\n228\t    }\n229\t\n230\t    let instr = instruction;\n231\t\n232\t    if instr == b\"end\" || instr == b\"dumpvars\" || instr == b\"dumpall\" {\n233\t        return Some(idx);\n234\t    }\n235\t\n236\t    if instr == b\"scope\" {\n237\t        match *state {\n238\t            State::BeforeModuleDefinitions => *state = State::InsideTopModule,\n239\t            State::InsideTopModule => *state = State::InsideInnerModules,\n240\t            _ => {}\n241\t        }\n242\t        // fscanf(file, \"\\n%*[^$]\") - skip a newline then everything until $\n243\t        // We just skip until $.\n244\t        idx = read_until_dollar(bytes, idx);\n245\t        return Some(idx);\n246\t    }\n247\t\n248\t    if instr == b\"upscope\" || instr == b\"enddefinitions\" || instr == b\"comment\" {\n249\t        idx = read_until_dollar(bytes, idx);\n250\t        return Some(idx);\n251\t    }\n252\t\n253\t    if instr == b\"var\" {\n254\t        if *state == State::InsideInnerModules {\n255\t            // Skip rest of line.\n256\t            while idx < bytes.len() && bytes[idx] != b'\\n' {\n257\t                idx += 1;\n258\t            }\n259\t            if idx < bytes.len() {\n260\t                idx += 1; // consume newline\n261\t            }\n262\t            return Some(idx);\n263\t        }\n264\t\n265\t        // Parse: \" %*s %zu %[^ ] %[^ $]%*[^$]\"\n266\t        // Skip whitespace, skip type word, then size, then signal_id, then name (up to $).\n267\t        // Skip whitespace\n268\t        idx = skip_whitespace(bytes, idx);\n269\t        // Skip type word (e.g. \"wire\", \"reg\")\n270\t        let (after_type, _type_word) = read_word(bytes, idx);\n271\t        idx = after_type;\n272\t        // Skip whitespace\n273\t        idx = skip_whitespace(bytes, idx);\n274\t        // Read size as decimal number\n275\t        let size_start = idx;\n276\t        while idx < bytes.len() && bytes[idx].is_ascii_digit() {\n277\t            idx += 1;\n278\t        }\n279\t        let size_str = std::str::from_utf8(&bytes[size_start..idx]).ok()?;\n280\t        let size: usize = size_str.parse().ok()?;\n281\t\n282\t        // Skip whitespace\n283\t        idx = skip_whitespace(bytes, idx);\n284\t        // Read signal_id (until space)\n285\t        let id_start = idx;\n286\t        while idx < bytes.len() && bytes[idx] != b' ' && bytes[idx] != b'\\t' && bytes[idx] != b'\\n'\n287\t        {\n288\t            idx += 1;\n289\t        }\n290\t        let signal_id = &bytes[id_start..idx];\n291\t\n292\t        // Skip spaces (just spaces and tabs, NOT newlines)\n293\t        idx = skip_spaces_and_tabs(bytes, idx);\n294\t        // Read name (until $); but trim trailing whitespace/newlines.\n295\t        let name_start = idx;\n296\t        while idx < bytes.len() && bytes[idx] != b'$' {\n297\t            idx += 1;\n298\t        }\n299\t        let mut name_end = idx;\n300\t        // Trim trailing whitespace from name\n301\t        while name_end > name_start\n302\t            && (bytes[name_end - 1] == b' '\n303\t                || bytes[name_end - 1] == b'\\t'\n304\t                || bytes[name_end - 1] == b'\\n'\n305\t                || bytes[name_end - 1] == b'\\r')\n306\t        {\n307\t            name_end -= 1;\n308\t        }\n309\t        let name_bytes = &bytes[name_start..name_end];\n310\t\n311\t        // Place into signals list at position equal to signal_id index.\n312\t        let signal_id_str = std::str::from_utf8(signal_id).ok()?;\n313\t        let index = match get_signal_index(signal_id_str) {\n314\t            Some(i) => i,\n315\t            None => {\n316\t                // No valid index; skip\n317\t                return Some(idx);\n318\t            }\n319\t        };\n320\t\n321\t        // Ensure the signals vec is large enough\n322\t        while vcd.signals.len() <= index {\n323\t            vcd.signals.push(Signal {\n324\t                name: Vec::new(),\n325\t                size: 0,\n326\t                value_changes: Vec::new(),\n327\t            });\n328\t        }\n329\t\n330\t        // If this signal is an alias (size != 0), keep existing.\n331\t        if vcd.signals[index].size != 0 {\n332\t            return Some(idx);\n333\t        }\n334\t\n335\t        vcd.signals[index].name = name_bytes.to_vec();\n336\t        vcd.signals[index].size = size;\n337\t\n338\t        return Some(idx);\n339\t    }\n340\t\n341\t    if instr == b\"date\" {\n342\t        // fscanf(file, \"\\n%[^$\\n]\", vcd->date);\n343\t        // Match a newline then read until $ or newline.\n344\t        let mut j = idx;\n345\t        // Skip whitespace (matches \\n in C scanf, also tabs, spaces)\n346\t        while j < bytes.len() && (bytes[j] as char).is_whitespace() {\n347\t            j += 1;\n348\t        }\n349\t        let date_start = j;\n350\t        while j < bytes.len() && bytes[j] != b'$' && bytes[j] != b'\\n' {\n351\t            j += 1;\n352\t        }\n353\t        // Trim trailing whitespace\n354\t        let mut date_end = j;\n355\t        while date_end > date_start\n356\t            && (bytes[date_end - 1] == b' '\n357\t                || bytes[date_end - 1] == b'\\t'\n358\t                || bytes[date_end - 1] == b'\\r')\n359\t        {\n360\t            date_end -= 1;\n361\t        }\n362\t        vcd.date = bytes[date_start..date_end].to_vec();\n363\t        return Some(j);\n364\t    }\n365\t\n366\t    if instr == b\"version\" {\n367\t        let mut j = idx;\n368\t        while j < bytes.len() && (bytes[j] as char).is_whitespace() {\n369\t            j += 1;\n370\t        }\n371\t        let v_start = j;\n372\t        while j < bytes.len() && bytes[j] != b'$' && bytes[j] != b'\\n' {\n373\t            j += 1;\n374\t        }\n375\t        let mut v_end = j;\n376\t        while v_end > v_start\n377\t            && (bytes[v_end - 1] == b' '\n378\t                || bytes[v_end - 1] == b'\\t'\n379\t                || bytes[v_end - 1] == b'\\r')\n380\t        {\n381\t            v_end -= 1;\n382\t        }\n383\t        vcd.version = bytes[v_start..v_end].to_vec();\n384\t        return Some(j);\n385\t    }\n386\t\n387\t    if instr == b\"timescale\" {\n388\t        // fscanf(file, \"\\n\\t%zu%[^$\\n]\", &vcd->timescale.scale, vcd->timescale.unit);\n389\t        let mut j = idx;\n390\t        // Skip leading whitespace\n391\t        while j < bytes.len() && (bytes[j] as char).is_whitespace() {\n392\t            j += 1;\n393\t        }\n394\t        // Read decimal scale\n395\t        let s_start = j;\n396\t        while j < bytes.len() && bytes[j].is_ascii_digit() {\n397\t            j += 1;\n398\t        }\n399\t        if let Ok(s) = std::str::from_utf8(&bytes[s_start..j]) {\n400\t            if let Ok(v) = s.parse::<usize>() {\n401\t                vcd.timescale.scale = v;\n402\t            }\n403\t        }\n404\t        // Read unit until $ or new