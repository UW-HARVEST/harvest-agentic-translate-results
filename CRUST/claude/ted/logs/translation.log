{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01UQVRKZxoTrZc2imj1npUGg","type":"tool_result","content":"1\t//\n2\t// Created by Anfernee Jervis on 7/1/22.\n3\t//\n4\t\n5\t#include <assert.h>\n6\t#include <stdlib.h>\n7\t#include \"stdio.h\"\n8\t#include <string.h>\n9\t#include \"../buffer/gap.h\"\n10\t#include \"../buffer/buffer.h\"\n11\t\n12\t\n13\t// Test Suites\n14\tvoid TestGapBuffer();\n15\tvoid TestTextBuffer();\n16\t\n17\tFILE* test_fp;\n18\t\n19\t/*\n20\t * Contents of tests/runtests.txt\n21\taaaaaaaaaaa\\n\n22\taaaaaaaaaa\\n\n23\taaaaaaaaa\\n\n24\t * */\n25\tchar test_file_path[] = \"tests/runtests.txt\";\n26\t\n27\t\n28\tint main(){\n29\t\n30\t    if ((test_fp = fopen(test_file_path, \"r\")) == NULL){\n31\t        printf(\"Error: Failed to open test file. Please run the test in the project directory.\\n'\"\n32\t               \"tests/runtests.c' must be valid in the working directory\");\n33\t\n34\t        exit(1);\n35\t    }\n36\t\n37\t    TestGapBuffer();\n38\t    TestTextBuffer();\n39\t    printf(\"All tests passed!\\n\");\n40\t}\n41\t\n42\t\n43\tvoid string_comp_assert(char* str1, const char* str2){\n44\t    assert(str1 != NULL);\n45\t    assert(str2 != NULL);\n46\t    assert(strcmp(str1, str2) == 0);\n47\t    free(str1);\n48\t}\n49\t\n50\tvoid TestGapBuffer(){\n51\t    printf(\"\\n\\nTesting GapBuffer\\n\");\n52\t\n53\t    GapBuffer* buffer = CreateGapBuffer(20);\n54\t    assert(buffer != NULL);\n55\t\n56\t    char* string_holder = NULL;\n57\t    char* string_holder2 = NULL;\n58\t    int err;\n59\t\n60\t    const char sample1[] = \"\";\n61\t    const char sample2[] = \"a\";\n62\t    const char sample3[] = \"aaaaaaaaaaa\";  // 11 characters\n63\t    const char sample4[] = \"aaaaaaaaaaaaaaaaaaaaa\";  // 21 characters\n64\t    const char sample5[] = \"aaaaaaaaaaaaaaaaaaaa\";  // 20 characters\n65\t    const char sample6[] = \"aaabbbaaaaaaaaaaaaaaaaa\";\n66\t    const char sample7[] = \"cccaaabbbaaaaaaaaaaaaaaaaa\";\n67\t    const char sample8[] = \"cccaaabbbaaaaaaaaaaaaaaaaaddd\";\n68\t    const char sample9[] = \"cccaaa\";\n69\t    const char sample10[] =\"bbbaaaaaaaaaaaaaaaaaddd\";\n70\t    const char sample11[] = \"cccaaax\";\n71\t    const char sample12[] =\"ybbbaaaaaaaaaaaaaaaaaddd\";\n72\t    const char sample13[] =\"ybbbaaaaaaaaaaaaaaaaadddp\";\n73\t\n74\t\n75\t    printf(\"Test 1, empty string\\n\");\n76\t    string_holder = GapBufferGetString(buffer);\n77\t    string_comp_assert(string_holder, sample1);\n78\t\n79\t\n80\t    printf(\"Test 2 insert char\\n\");\n81\t    err = GapBufferInsertChar(buffer, 'a');\n82\t    assert(err == 0);\n83\t    string_holder = GapBufferGetString(buffer);\n84\t    string_comp_assert(string_holder, sample2);\n85\t\n86\t\n87\t    printf(\"Test 2.1 insert char\\n\");\n88\t    for (int i=0; i<10; i++){\n89\t        err = GapBufferInsertChar(buffer, 'a');\n90\t        assert(err == 0);\n91\t    }\n92\t    string_holder = GapBufferGetString(buffer);\n93\t    string_comp_assert(string_holder, sample3);\n94\t\n95\t\n96\t    printf(\"Test 2.2 insert char (resize) \\n\");\n97\t    for (int i=0; i<10; i++){\n98\t        err = GapBufferInsertChar(buffer, 'a');\n99\t        assert(err == 0);\n100\t    }\n101\t    string_holder = GapBufferGetString(buffer);\n102\t    string_comp_assert(string_holder, sample4);\n103\t\n104\t\n105\t    printf(\"Test 3 Backspace \\n\");\n106\t    GapBufferBackSpace(buffer);\n107\t    string_holder = GapBufferGetString(buffer);\n108\t    string_comp_assert(string_holder, sample5);\n109\t\n110\t\n111\t    printf(\"Test 4 GapBufferMoveGap, TextBufferInsert and Backspace \\n\");\n112\t\n113\t    err = GapBufferMoveGap(buffer, 3);\n114\t    assert(err == 0);\n115\t\n116\t    for (int i=0; i<3; i++) {\n117\t        err = GapBufferInsertChar(buffer, 'b');\n118\t        assert(err == 0);\n119\t    }\n120\t    string_holder = GapBufferGetString(buffer);\n121\t    string_comp_assert(string_holder, sample6);\n122\t\n123\t\n124\t    printf(\