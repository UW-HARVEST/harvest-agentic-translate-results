{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_014G6sQ4TDgkQRkaEscrUEB6","type":"tool_result","content":"1\t//\n2\t// Created by Anfernee Jervis on 7/1/22.\n3\t//\n4\t\n5\t#include \"buffer.h\"\n6\t#include \"gap.h\"\n7\t#include <stdlib.h>\n8\t#include <strings.h>\n9\t\n10\t\n11\tTextBuffer* CreateTextBuffer(int num_lines, int line_size){\n12\t    TextBuffer* textBuffer = malloc(sizeof(TextBuffer));\n13\t\n14\t    if (textBuffer == NULL){\n15\t        return NULL;\n16\t    }\n17\t\n18\t    // Allocate gap buffer array\n19\t    textBuffer->lines = malloc(sizeof(GapBuffer*) * num_lines);\n20\t\n21\t    if (textBuffer->lines == NULL){\n22\t        return NULL;\n23\t    }\n24\t\n25\t    // allocate the first line\n26\t    textBuffer->lines[0] = CreateGapBuffer(line_size);\n27\t\n28\t    if (textBuffer->lines[0] == NULL){\n29\t        return NULL;\n30\t    }\n31\t\n32\t    // NULL the rest of the lines\n33\t    for (int i=1; i<num_lines; i++){\n34\t        textBuffer->lines[i] = NULL;\n35\t    }\n36\t\n37\t    textBuffer->lines_capacity = num_lines;\n38\t    textBuffer->cursorRow = 0;\n39\t    textBuffer->cursorCol = 0;\n40\t    textBuffer->cursorColMoved = 0;\n41\t    textBuffer->last_line_loc = 0;\n42\t\n43\t    return textBuffer;\n44\t}\n45\t\n46\t\n47\tvoid DestroyTextBuffer(TextBuffer* instance){\n48\t\n49\t    // Deallocate each GapBuffer\n50\t    for(int i=0; i<instance->lines_capacity; i++){\n51\t\n52\t        // Break if we're at the last line\n53\t        if (instance->lines[i] == NULL){\n54\t            break;\n55\t        }\n56\t\n57\t        DestroyGapBuffer(instance->lines[i]);\n58\t    }\n59\t\n60\t    // Deallocate the gapbuffer array and the TextBuffer itself\n61\t    free(instance->lines);\n62\t    free(instance);\n63\t}\n64\t\n65\t\n66\tvoid TextBufferMoveCursor(TextBuffer* instance, int row, int col){\n67\t    if (row > instance->last_line_loc){\n68\t        row = instance->last_line_loc;\n69\t    }\n70\t    if (row < 0){\n71\t        row = 0;\n72\t    }\n73\t\n74\t    instance->cursorRow = row;\n75\t\n76\t    if (col > instance->lines[row]->str_len){\n77\t        col = instance->lines[row]->str_len;\n78\t    }\n79\t\n80\t    if (col < 0){\n81\t        col = 0;\n82\t    }\n83\t\n84\t    // We need to indicate that the column moved so the gap can be moved before inserting\n85\t    if (instance->cursorCol != col){\n86\t        instance->cursorColMoved = 1;\n87\t    }\n88\t\n89\t    instance->cursorCol = col;\n90\t}\n91\t\n92\t\n93\tint TextBufferInsert(TextBuffer* instance, char ch){\n94\t\n95\t    int err;\n96\t\n97\t    // If the cursor column changed, we need to move the gap buffer before inserting\n98\t    if (instance->cursorColMoved) {\n99\t        err = GapBufferMoveGap(instance->lines[instance->cursorRow], instance->cursorCol);\n100\t\n101\t        if (err != 0){\n102\t            return err;\n103\t        }\n104\t\n105\t        instance->cursorColMoved = 0;\n106\t    }\n107\t\n108\t    err = GapBufferInsertChar(instance->lines[instance->cursorRow], ch);\n109\t\n110\t    if (err != 0){\n111\t        return err;\n112\t    }\n113\t\n114\t    instance->cursorCol = instance->lines[instance->cursorRow]->gap_loc;\n115\t    return 0;\n116\t}\n117\t\n118\t\n119\tint TextBufferBackspace(TextBuffer* instance){\n120\t    int err;\n121\t\n122\t    // If the cursor column changed, we need to move the gap buffer before deleting\n123\t    if (instance->cursorColMoved) {\n124\t        err = GapBufferMoveGap(instance->lines[instance->cursorRow], instance->cursorCol);\n125\t\n126\t        if (err != 0){\n127\t            return err;\n128\t        }\n129\t\n130\t        instance->cursorColMoved = 0;\n131\t    }\n132\t\n133\t    GapBufferBackSpace(instance->lines[instance->cursorRow]);\n134\t    instance->cursorCol = instance->lines[instance->cursorRow]->gap_loc;\n135\t\n136\t    return 0;\n137\t}\n138\t\n139\t\n140\tint TextBufferNewLine(TextBuffer* instance){\n141\t    // split the current GapBuffer where the gap is.\n142\t    // Create a new GapBuffer and copy the second half of the string to the new GapBuffer\n143\t    // Check if there's space to add a new line. If not, reallocate `lines` and copy the old to the new\n144\t    // Finally, check if there's an allocated line below the current line. If there is, shift the lines array\n145\t    // down one place with memmove.\n146\t\n147\t    int errno;\n148\t\n149\t    // First ensure the gap location reflects the cursor position\n150\t    if (instance->cursorColMoved){\n151\t        errno = GapBufferMoveGap(instance->lines[instance->cursorRow], instance->cursorCol);\n152\t\n153\t        if (errno != 0){\n154\t            return errno;\n155\t        }\n156\t\n157\t        instance->cursorColMoved = 0;\n158\t    }\n159\t\n160\t    // Split the current GapBuffer at the gap location\n161\t    // New gap will have the gap at the start of its string.\n162\t    GapBuffer* newline = GapBufferSplit(instance->lines[instance->cursorRow]);\n163\t\n164\t    if (newline == NULL){\n165\t        return MEM_ERROR;\n166\t    }\n167\t\n168\t    // Check if there's space to add a new line. If not, reallocate `lines` and copy the old to the new\n169\t    if (instance->last_line_loc == instance->lines_capacity - 1){\n170\t        GapBuffer** new_lines = realloc(instance->lines, sizeof(GapBuffer*) * (instance->lines_capacity * 2));\n171\t\n172\t        if (new_lines == NULL){\n173\t            // TODO: Panic here. recovering at the moment is hard\n174\t            return MEM_ERROR;\n175\t        }\n176\t\n177\t        instance->lines = new_lines;\n178\t        instance->lines_capacity *= 2;\n179\t    }\n180\t\n181\t    // Shift the lines array down one place with memmove\n182\t    memmove(instance->lines + instance->cursorRow + 2,\n183\t            instance->lines + instance->cursorRow + 1,\n184\t            sizeof(GapBuffer*) * (instance->last_line_loc - instance->cursorRow));\n185\t\n186\t\n187\t    // Set the new line to the next available slot\n188\t    instance->lines[instance->cursorRow + 1] = newline;\n189\t\n190\t    // Update the last line location\n191\t    instance->last_line_loc++;\n192\t\n193\t    // Update the cursor position\n194\t    instance->cursorRow++;\n195\t    instance->cursorCol = newline->gap_loc;\n196\t\n197\t    return 0;\n198\t}\n199\t\n200\tchar *TextBufferGetLine(TextBuffer *instance, int row) {\n201\t    if (row > instance->last_line_loc){\n202\t        return NULL;\n203\t    }\n204\t    if (row < 0){\n205\t        return NULL;\n206\t    }\n207\t\n208\t    return GapBufferGetString(instance->lines[row]);\n209\t}\n210\t\n211\tTextBuffer* CreateTextBufferFromFile(FILE* fp){\n212\t\n213\t    TextBuffer* new_tbuffer = CreateTextBuffer(DEFAULT_CAPACITY, DEFAULT_GAP_BUF_CAP);\n214\t\n215\t    if (new_tbuffer == NULL) {\n216\t        return NULL;\n217\t    }\n218\t\n219\t    if (fp == NULL){\n220\t        return new_tbuffer;\n221\t    }\n222\t\n223\t    // Delete the first line. Reset the cursor and last line positions\n224\t    DestroyGapBuffer(new_tbuffer->lines[new_tbuffer->last_line_loc]);\n225\t    new_tbuffer->last_line_loc = -1;\n226\t\n227\t    // Read line and create gap buffer from the line, then append it to the text buffer. update last line pos\n228\t    char *line = NULL;\n229\t    size_t len = 0;\n230\t    size_t read;\n231\t    int line_gap_size;\n232\t\n233\t    while ((read = getline(&line, &len, fp)) != -1 ) {\n234\t\n235\t        // We dont want to include the newline character\n236\t        if (line[read-1] == '\\n') {\n237\t            line[read - 1] = '\\0';\n238\t        }\n239\t\n240\t        // reallocate if out of space\n241\t        if (new_tbuffer->last_line_loc == new_tbuffer->lines_capacity-1){\n242\t            new_tbuffer->lines = realloc(\n243\t                    new_tbuffer->lines, sizeof(GapBuffer*) * new_tbuffer->lines_capacity * 2);\n244\t\n245\t            if (new_tbuffer->lines == NULL){\n246\t                DestroyTextBuffer(new_tbuffer);\n247\t                return NULL;\n248\t            }\n249\t\n250\t            new_tbuffer->lines_capacity = new_tbuffer->lines_capacity * 2;\n251\t        }\n252\t\n253\t        // Create a new gap buf with the read line, append it to the tbuffer and update the last line location\n254\t\n255\t        // the gap size will be max(DEFAULT_GAP_BUF_CAP, read * 2)\n256\t        line_gap_size = read * 2 < DEFAULT_GAP_BUF_CAP ? DEFAULT_GAP_BUF_CAP : read * 2;\n257\t\n258\t        new_tbuffer->lines[new_tbuffer->last_line_loc + 1] = CreateGapBufferFromString(line, line_gap_size);\n259\t\n260\t        if (new_tbuffer->lines[new_tbuffer->last_line_loc + 1] == NULL){\n261\t            DestroyTextBuffer(new_tbuffer);\n262\t            return NULL;\n263\t        }\n264\t\n265\t        new_tbuffer->last_line_loc++;\n266\t    }\n267\t\n268\t    free(line);\n269\t    return new_tbuffer;\n270\t}"}]},"parent_tool_use_id":null,"session_id":"7b52baf4-a20c-474f-a39e-72792e2a089c","uuid":"40e49d03-d65c-418f-8899-37acc308bf57","timestamp":"2026-05-28T22:07:47.094Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-275Us7/project/c_src/buffer/buffer.c","content":"//\n// Created by Anfernee Jervis on 7/1/22.\n//\n\n#include \"buffer.h\"\n#include \"gap.h\"\n#include <stdlib.h>\n#include <strings.h>\n\n\nTextBuffer* CreateTextBuffer(int num_lines, int line_size){\n    TextBuffer* textBuffer = malloc(sizeof(TextBuffer));\n\n    if (textBuffer == NULL){\n        return NULL;\n    }\n\n    // Allocate gap buffer array\n    textBuffer->lines = malloc(sizeof(GapBuffer*) * num_lines);\n\n    if (textBuffer->lines == NULL){\n        return NULL;\n    }\n\n    // allocate the first line\n    textBuffer->lines[0] = CreateGapBuffer(line_size);\n\n    if (textBuffer->lines[0] == NULL){\n        return NULL;\n    }\n\n    // NULL the rest of the lines\n    for (int i=1; i<num_lines; i++){\n        textBuffer->lines[i] = NULL;\n    }\n\n    textBuffer->lines_capacity = num_lines;\n    textBuffer->cursorRow = 0;\n    textBuffer->cursorCol = 0;\n    textBuffer->cursorColMoved = 0;\n    textBuffer->last_line_loc = 0;\n\n    return textBuffer;\n}\n\n\nvoid DestroyTextBuffer(TextBuffer* instance){\n\n    // Deallocate each GapBuffer\n    for(int i=0; i<instance->lines_capacity; i++){\n\n        // Break if we're at the last line\n        if (instance->lines[i] == NULL){\n            break;\n        }\n\n        DestroyGapBuffer(instance->lines[i]);\n    }\n\n    // Deallocate the gapbuffer array and the TextBuffer itself\n    free(instance->lines);\n    free(instance);\n}\n\n\nvoid TextBufferMoveCursor(TextBuffer* instance, int row, int col){\n    if (row > instance->last_line_loc){\n        row = instance->last_line_loc;\n    }\n    if (row < 0){\n        row = 0;\n    }\n\n    instance->cursorRow = row;\n\n    if (col > instance->lines[row]->str_len){\n        col = instance->lines[row]->str_len;\n    }\n\n    if (col < 0){\n        col = 0;\n    }\n\n    // We need to indicate that the column moved so the gap can be moved before inserting\n    if (instance->cursorCol != col){\n        instance->cursorColMoved = 1;\n    }\n\n    instance->cursorCol = col;\n}\n\n\nint TextBufferInsert(TextBuffer* instance, char ch){\n\n    int err;\n\n    // If the cursor column changed, we need to move the gap buffer before inserting\n    if (instance->cursorColMoved) {\n        err = GapBufferMoveGap(instance->lines[instance->cursorRow], instance->cursorCol);\n\n        if (err != 0){\n            return err;\n        }\n\n        instance->cursorColMoved = 0;\n    }\n\n    err = GapBufferInsertChar(instance->lines[instance->cursorRow], ch);\n\n    if (err != 0){\n        return err;\n    }\n\n    instance->cursorCol = instance->lines[instance->cursorRow]->gap_loc;\n    return 0;\n}\n\n\nint TextBufferBackspace(TextBuffer* instance){\n    int err;\n\n    // If the cursor column changed, we need to move the gap buffer before deleting\n    if (instance->cursorColMoved) {\n        err = GapBufferMoveGap(instance->lines[instance->cursorRow], instance->cursorCol);\n\n        if (err != 0){\n            return err;\n        }\n\n        instance->cursorColMoved = 0;\n    }\n\n    GapBufferBackSpace(instance->lines[instance->cursorRow]);\n    instance->cursorCol = instance->lines[instance->cursorRow]->gap_loc;\n\n    return 0;\n}\n\n\nint TextBufferNewLine(TextBuffer* instance){\n    // split the current GapBuffer where the gap is.\n    // Create a new GapBuffer and copy the second half of the string to the new GapBuffer\n    // Check if there's space to add a new line. If not, reallocate `lines` and copy the old to the new\n    // Finally, check if there's an allocated line below the current line. If there is, shift the lines array\n    // down one place with memmove.\n\n    int errno;\n\n    // First ensure the gap location reflects the cursor position\n    if (instance->cursorColMoved){\n        errno = GapBufferMoveGap(instance->lines[instance->cursorRow], instance->cursorCol);\n\n        if (errno != 0){\n            return errno;\n        }\n\n        instance->cursorColMoved = 0;\n    }\n\n    // Split the current GapBuffer at the gap location\n    // New gap will have the gap at the start of its string.\n    GapBuffer* newline = GapBufferSplit(instance->lines[instance->cursorRow]);\n\n    if (newline == NULL){\n        return MEM_ERROR;\n    }\n\n    // Check if there's space to add a new line. If not, reallocate `lines` and copy the old to the new\n    if (instance->last_line_loc == instance->lines_capacity - 1){\n        GapBuffer** new_lines = realloc(instance->lines, sizeof(GapBuffer*) * (instance->lines_capacity * 2));\n\n        if (new_lines == NULL){\n            // TODO: Panic here. recovering at the moment is hard\n            return MEM_ERROR;\n        }\n\n        instance->lines = new_lines;\n        instance->lines_capacity *= 2;\n    }\n\n    // Shift the lines array down one place with memmove\n    memmove(instance->lines + instance->cursorRow + 2,\n            instance->lines + instance->cursorRow + 1,\n            sizeof(GapBuffer*) * (instance->last_line_loc - instance->cursorRow));\n\n\n    // Set the new line to the next available slot\n    instance->lines[instance->cursorRow + 1] = newline;\n\n    // Update the last line location\n    instance->last_line_loc++;\n\n    // Update the cursor position\n    instance->cursorRow++;\n    instance->cursorCol = newline->gap_loc;\n\n    return 0;\n}\n\nchar *TextBufferGetLine(TextBuffer *instance, int row) {\n    if (row > instance->last_line_loc){\n        return NULL;\n    }\n    if (row < 0){\n        return NULL;\n    }\n\n    return GapBufferGetString(instance->lines[row]);\n}\n\nTextBuffer* CreateTextBufferFromFile(FILE* fp){\n\n    TextBuffer* new_tbuffer = CreateTextBuffer(DEFAULT_CAPACITY, DEFAULT_GAP_BUF_CAP);\n\n    if (new_tbuffer == NULL) {\n        return NULL;\n    }\n\n    if (fp == NULL){\n        return new_tbuffer;\n    }\n\n    // Delete the first line. Reset the cursor and last line positions\n    DestroyGapBuffer(new_tbuffer->lines[new_tbuffer->last_line_loc]);\n    new_tbuffer->last_line_loc = -1;\n\n    // Read line and create gap buffer from the line, then append it to the text buffer. update last line pos\n    char *line = NULL;\n    size_t len = 0;\n    size_t read;\n    int line_gap_size;\n\n    while ((read = getline(&line, &len, fp)) != -1 ) {\n\n        // We dont want to include the newline character\n        if (line[read-1] == '\\n') {\n            line[read - 1] = '\\0';\n        }\n\n        // reallocate if out of space\n        if (new_tbuffer->last_line_loc == new_tbuffer->lines_capacity-1){\n            new_tbuffer->lines = realloc(\n                    new_tbuffer->lines, sizeof(GapBuffer*) * new_tbuffer->lines_capacity * 2);\n\n            if (new_tbuffer->lines == NULL){\n                DestroyTextBuffer(new_tbuffer);\n                return NULL;\n            }\n\n            new_tbuffer->lines_capacity = new_tbuffer->lines_capacity * 2;\n        }\n\n        // Create a new gap buf with the read line, append it to the tbuffer and update the last line location\n\n        // the gap size will be max(DEFAULT_GAP_BUF_CAP, read * 2)\n        line_gap_size = read * 2 < DEFAULT_GAP_BUF_CAP ? DEFAULT_GAP_BUF_CAP : read * 2;\n\n        new_tbuffer->lines[new_tbuffer->last_line_loc + 1] = CreateGapBufferFromString(line, line_gap_size);\n\n        if (new_tbuffer->lines[new_tbuffer->last_line_loc + 1] == NULL){\n            DestroyTextBuffer(new_tbuffer);\n            return NULL;\n        }\n\n        new_tbuffer->last_line_loc++;\n    }\n\n    free(line);\n    return new_tbuffer;\n}","numLines":270,"startLine":1,"totalLines":270}}}
