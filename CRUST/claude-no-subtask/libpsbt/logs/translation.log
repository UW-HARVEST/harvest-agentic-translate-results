lem = PsbtElem::TxElem {\n                index: 0,\n                txelem: owned,\n            };\n            (fwd.h)(&mut psbt_elem, fwd.ud);\n        }\n    }\n\n    let mut forwarder = Forwarder {\n        h: handler,\n        ud: user_data,\n    };\n    let _ = psbt_btc_tx_parse(val, val.len(), &mut forwarder, Some(tx_handler));\n}","new_string":"fn parse_tx_for_counts(val: &[u8], counts: &mut (i32, i32)) -> PsbtResult {\n    let mut inputs = 0i32;\n    let mut outputs = 0i32;\n\n    let res = crate::tx::parse_tx_with_callback(val, val.len(), |elem| match elem {\n        PsbtTxElem::TxIn(_) => inputs += 1,\n        PsbtTxElem::TxOut(_) => outputs += 1,\n        _ => {}\n    });\n    if res != PsbtResult::Ok {\n        return res;\n    }\n\n    counts.0 = inputs;\n    counts.1 = outputs;\n    PsbtResult::Ok\n}\n\nfn forward_txelems(\n    val: &[u8],\n    handler: PsbtElemHandler,\n    user_data: &mut dyn std::any::Any,\n) {\n    let _ = crate::tx::parse_tx_with_callback(val, val.len(), |elem| {\n        let dummy = PsbtTxElem::Tx(PsbtTx {\n            version: 0,\n            lock_time: 0,\n        });\n        let owned = std::mem::replace(elem, dummy);\n        let mut psbt_elem = PsbtElem::TxElem {\n            index: 0,\n            txelem: owned,\n        };\n        handler(&mut psbt_elem, user_data);\n    });\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2792,"cache_read_input_tokens":81458,"cache_creation":{"ephemeral_5m_input_tokens":2792,"ephemeral_1h_input_tokens":0},"output_tokens":41,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d98e8816-493e-41f9-9ea8-36ac23246e01","uuid":"cf9068fc-ef34-4dbd-9b4a-3d297a160a05"}
