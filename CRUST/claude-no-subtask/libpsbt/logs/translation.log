nstance, &input_record_b);\n85\t    assert_eq!(res, PsbtResult::Ok);\n86\t\n87\t    // Start new output record set.\n88\t    let res = psbt_new_output_record_set(&mut psbt_instance);\n89\t    assert_eq!(res, PsbtResult::Ok);\n90\t\n91\t    // psbt_print should fail before finalization.\n92\t    let mut stdout = std::io::stdout();\n93\t    let res = psbt_print(&psbt_instance, &mut stdout);\n94\t    assert_eq!(res, PsbtResult::InvalidState);\n95\t\n96\t    // Finalize the PSBT.\n97\t    let res = psbt_finalize(&mut psbt_instance);\n98\t    assert_eq!(res, PsbtResult::Ok);\n99\t\n100\t    // Now psbt_print should succeed.\n101\t    let res = psbt_print(&psbt_instance, &mut stdout);\n102\t    assert_eq!(res, PsbtResult::Ok);\n103\t}\n104\t\n105\t/// Transpiled from test.c: simulate reading a PSBT with a callback.\n106\t#[test]\n107\tfn read_test_vector() {\n108\t    let mut buf = vec![0u8; 2048];\n109\t    let mut intbuf = vec![0u8; 2048];\n110\t    let mut psbt_len = 0;\n111\t    let hexlen = PSBT_HEX.len();\n112\t    let mut psbt_instance = Psbt::new(2048);\n113\t\n114\t    let res = psbt_decode(PSBT_HEX, hexlen, &mut buf, 2048, &mut psbt_len);\n115\t    assert_eq!(res, PsbtResult::Ok);\n116\t\n117\t    let res = psbt_init(&mut psbt_instance, &mut intbuf, 2048);\n118\t    assert_eq!(res, PsbtResult::Ok);\n119\t\n120\t    // The callback checks that the first element is a global record and the second is an input record.\n121\t    fn checker(elem: &mut PsbtElem, _ud: &mut dyn std::any::Any) {\n122\t        let mut step = 0;\n123\t        match elem {\n124\t            PsbtElem::Record { record, .. } => {\n125\t                match step {\n126\t                    0 => assert_eq!(record.record_type, 0), // PSBT_GLOBAL_UNSIGNED_TX\n127\t                    1 => assert_eq!(record.record_type, 0), // PSBT_IN_NON_WITNESS_UTXO (simulated as 0)\n128\t                    _ => {}\n129\t                }\n130\t            }\n131\t            _ => {}\n132\t        }\n133\t       