de.size(), 2);\n65\t    cset_node.add(Node { x: 5, y: 8 });\n66\t    assert_eq!(cset_node.size(), 3);\n67\t}\n68\t#[test]\n69\tfn test_cset_remove() {\n70\t    let mut cset_int = cset::Cset::<i32>::new();\n71\t    cset_int.add(45);\n72\t    cset_int.add(34);\n73\t    cset_int.add(10);\n74\t    assert_eq!(cset_int.size(), 3);\n75\t    cset_int.remove(45);\n76\t    assert_eq!(cset_int.size(), 2);\n77\t    cset_int.remove(45);\n78\t    assert_eq!(cset_int.size(), 2);\n79\t    cset_int.remove(34);\n80\t    assert_eq!(cset_int.size(), 1);\n81\t    for value in cset_int.iter() {\n82\t        assert_eq!(value, 10);\n83\t    }\n84\t    cset_int.remove(10);\n85\t    assert_eq!(cset_int.size(), 0);\n86\t}\n87\t#[test]\n88\tfn test_cset_resize() {\n89\t    let mut cset_int = cset::Cset::<i32>::new();\n90\t    for i in 0..1500 {\n91\t    cset_int.add(i);\n92\t    }\n93\t}\n94\t#[test]\n95\tfn test_default_bytes_comparator() {\n96\t    let mut cset_int = cset::Cset::<i32>::new();\n97\t    cset_int.add(45);\n98\t    cset_int.add(46);\n99\t    cset_int.add(67);\n100\t    assert!(cset_int.contains(&45));\n101\t    assert!(!cset_int.contains(&68));\n102\t    assert!(cset_int.contains(&46));\n103\t    cset_int.remove(46);\n104\t    assert!(!cset_int.contains(&46));\n105\t    cset_int.remove(46);\n106\t    assert!(!cset_int.contains(&46));\n107\t    assert_eq!(cset_int.size(), 2);\n108\t    cset_int.remove(45);\n109\t    assert_eq!(cset_int.size(), 1);\n110\t    cset_int.remove(67);\n111\t    assert_eq!(cset_int.size(), 0);\n112\t    cset_int.remove(67);\n113\t    assert_eq!(cset_int.size(), 0);\n114\t    for i in 0..2000 {\n115\t    cset_int.add(i);\n116\t    }\n117\t    assert_eq!(cset_int.size(), 2000);\n118\t}\n119\tfn node_pointer_comparator(selfs: &Node, other: &Node) -> bool {\n120\t    selfs.x == other.x\n121\t}\n122\tfn custom_node_compare(selfs: &Node, other: &Node) -> bool {\n123\t    selfs.x == other.x\n124\t}\n125\t#[test]\n126\tfn test_custom_comparator() {\n127\t    let mut cset_node = cset::Cset::<Node>::new();  \n128\t    cset_node.set_comparator(custom_node_compare);\n129\t    cset_node.add(Node { x: 4, y: 4 });\n130\t    cset_node.add(Node { x: 4, y: 4 });\n131\t    assert_eq!(cset_node.size(), 1);\n132\t    cset_node.add(Node { x: 1, y: 2 });\n133\t    assert_eq!(cset_node.size(), 2);\n134\t    cset_node.remove(Node { x: 1, y: 45 });\n135\t    assert_eq!(cset_node.size(), 1);\n136\t}\n137\t#[test]\n138\tfn test_cset_clear() {\n139\t    let mut cset_int = cset::Cset::<i32>::new();\n140\t    cset_int.add(12);\n141\t    cset_int.add(14);\n142\t    cset_int.add(15);\n143\t    assert_eq!(cset_int.size(), 3);\n144\t    cset_int.clear();\n145\t    assert_eq!(cset_int.size(), 0);\n146\t    cset_int.add(45);\n147\t    assert_eq!(cset_int.size(), 1);\n148\t}\n149\t#[test]\n150\tfn test_cset_intersection() {\n151\t    let mut cset_int_a = cset::Cset::<i32>::new();\n152\t    let mut cset_int_b = cset::Cset::<i32>::new();\n153\t    cset_int_a.add(12);\n154\t    cset_int_a.add(13);\n155\t    cset_int_a.add(14);\n156\t    cset_int_b.add(12);\n157\t    cset_int_b.add(13);\n158\t    cset_int_b.add(16);\n159\t    let mut result = cset::Cset::<i32>::new();\n160\t    result.intersect(&cset_int_a, &cset_int_b);\n161\t    assert_eq!(result.size(), 2);\n162\t    cset_int_b.add(14);\n163\t    result.intersect(&cset_int_a, &cset_int_b);\n164\t    assert_eq!(result.size(), 3);\n165\t}\n166\t#[test]\n167\tfn test_cset_union() {\n168\t    let mut cset_int_a = cset::Cset::<i32>::new();\n169\t    let mut cset_int_b = cset::Cset::<i32>::new();\n170\t    let mut cset_result = cset::Cset::<i32>::new();\n171\t    cset_int_a.add(34);\n172\t    cset_int_a.add(25);\n173\t    cset_int_a.add(12);\n174\t    cset_int_b.add(1);\n175\t    cset_int_b.add(4);\n176\t    cset_int_b.add(34);\n177\t    cset_result.union(&cset_int_a, &cset_int_b);\n178\t    assert_eq!(cset_result.size(), 5);\n179\t    cset_int_b.add(100);\n180\t    cset_result.union(&cset_int_a, &cset_int_b);\n181\t    assert_eq!(cset_result.size(), 6);\n182\t}\n183\t#[test]\n184\tfn test_cset_disjoint() {\n185\t    let mut cset_a = cset::Cset::<char>::new();\n186\t    let mut cset_b = cset::Cset::<char>::new();\n187\t    cset_a.add('a');\n188\t    cset_a.add('b');\n189\t    cset_b.add('c');\n190\t    cset_b.add('d');\n191\t    assert!(cset_a.is_disjoint(&cset_b));\n192\t    cset_b.add('a');\n193\t    assert!(!cset_a.is_disjoint(&cset_b));\n194\t}\n195\t#[test]\n196\tfn test_cset_difference() {\n197\t    let mut cset_a = cset::Cset::<i32>::new();\n198\t    let mut cset_b = cset::Cset::<i32>::new();\n199\t    let mut result = cset::Cset::<i32>::new();\n200\t    result.difference(&cset_a, &cset_b);\n201\t    assert_eq!(result.size(), 0);\n202\t    cset_a.add(45);\n203\t    cset_a.add(46);\n204\t    cset_a.add(58);\n205\t    cset_b.add(12);\n206\t    cset_b.add(11);\n207\t    cset_b.add(45);\n208\t    result.difference(&cset_a, &cset_b);\n209\t    assert_eq!(result.size(), 2);\n210\t    assert!(result.contains(&46));\n211\t    assert!(result.contains(&58));\n212\t    assert!(!result.contains(&45));\n213\t    result.clear();\n214\t    cset_b.add(46);\n215\t    cset_b.add(58);\n216\t    result.difference(&cset_a, &cset_b);\n217\t    assert_eq!(result.size(), 0);\n218\t    result.difference(&cset_b, &cset_a);\n219\t    assert_eq!(result.size(), 2);\n220\t}\n221\tfn main() {}"}]},"parent_tool_use_id":null,"session_id":"a9097314-09f8-467d-8076-a33302b57709","uuid":"66c10f83-87ad-4aca-ac17-224c4df4664c","timestamp":"2026-06-05T23:30:54.938Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-GADOcW/project/src/bin/test.rs","content":"use cset::cset;\n#[test]\nfn test_cset_init() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    assert_eq!(cset_int.size(), 0);\n    assert_eq!(cset_int.capacity(), 2);\n}\n#[test]\nfn test_cset_add() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    cset_int.add(34);\n    assert_eq!(cset_int.size(), 1);\n    cset_int.add(35);\n    assert_eq!(cset_int.size(), 2);\n    cset_int.add(36);\n    cset_int.add(37);\n    cset_int.add(38);\n}\n#[test]\nfn test_cset_contains() {\nlet mut cset_int = cset::Cset::<i32>::new();\ncset_int.add(34);\ncset_int.add(36);\ncset_int.remove(36);\nassert!(!cset_int.contains(&12));\nassert!(cset_int.contains(&34));\ncset_int.add(50);\nassert!(!cset_int.contains(&45));\nassert_eq!(cset_int.size(), 2);\n}\n#[test]\nfn test_cset_iteration() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    for i in 0..3200 {\n    cset_int.add(i);\n    }\n    for value in cset_int.iter() {\n    assert!(cset_int.contains(&value));\n    }\n}\n#[test]\nfn test_cset_unique() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    cset_int.add(45);\n    cset_int.add(46);\n    cset_int.add(57);\n    assert_eq!(cset_int.size(), 3);\n    cset_int.add(45);\n    assert_eq!(cset_int.size(), 3);\n}\n#[derive(PartialEq, Eq, Hash)]\nstruct Node {\n    x: i32,\n    y: i32,\n}\n#[test]\nfn test_cset_struct() {\n    let mut cset_node = cset::Cset::<Node>::new();\n    cset_node.add(Node { x: 4, y: 4 });\n    assert_eq!(cset_node.size(), 1);\n    cset_node.add(Node { x: 5, y: 4 });\n    assert_eq!(cset_node.size(), 2);\n    cset_node.add(Node { x: 5, y: 4 });\n    assert_eq!(cset_node.size(), 2);\n    cset_node.add(Node { x: 5, y: 8 });\n    assert_eq!(cset_node.size(), 3);\n}\n#[test]\nfn test_cset_remove() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    cset_int.add(45);\n    cset_int.add(34);\n    cset_int.add(10);\n    assert_eq!(cset_int.size(), 3);\n    cset_int.remove(45);\n    assert_eq!(cset_int.size(), 2);\n    cset_int.remove(45);\n    assert_eq!(cset_int.size(), 2);\n    cset_int.remove(34);\n    assert_eq!(cset_int.size(), 1);\n    for value in cset_int.iter() {\n        assert_eq!(value, 10);\n    }\n    cset_int.remove(10);\n    assert_eq!(cset_int.size(), 0);\n}\n#[test]\nfn test_cset_resize() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    for i in 0..1500 {\n    cset_int.add(i);\n    }\n}\n#[test]\nfn test_default_bytes_comparator() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    cset_int.add(45);\n    cset_int.add(46);\n    cset_int.add(67);\n    assert!(cset_int.contains(&45));\n    assert!(!cset_int.contains(&68));\n    assert!(cset_int.contains(&46));\n    cset_int.remove(46);\n    assert!(!cset_int.contains(&46));\n    cset_int.remove(46);\n    assert!(!cset_int.contains(&46));\n    assert_eq!(cset_int.size(), 2);\n    cset_int.remove(45);\n    assert_eq!(cset_int.size(), 1);\n    cset_int.remove(67);\n    assert_eq!(cset_int.size(), 0);\n    cset_int.remove(67);\n    assert_eq!(cset_int.size(), 0);\n    for i in 0..2000 {\n    cset_int.add(i);\n    }\n    assert_eq!(cset_int.size(), 2000);\n}\nfn node_pointer_comparator(selfs: &Node, other: &Node) -> bool {\n    selfs.x == other.x\n}\nfn custom_node_compare(selfs: &Node, other: &Node) -> bool {\n    selfs.x == other.x\n}\n#[test]\nfn test_custom_comparator() {\n    let mut cset_node = cset::Cset::<Node>::new();  \n    cset_node.set_comparator(custom_node_compare);\n    cset_node.add(Node { x: 4, y: 4 });\n    cset_node.add(Node { x: 4, y: 4 });\n    assert_eq!(cset_node.size(), 1);\n    cset_node.add(Node { x: 1, y: 2 });\n    assert_eq!(cset_node.size(), 2);\n    cset_node.remove(Node { x: 1, y: 45 });\n    assert_eq!(cset_node.size(), 1);\n}\n#[test]\nfn test_cset_clear() {\n    let mut cset_int = cset::Cset::<i32>::new();\n    cset_int.add(12);\n    cset_int.add(14);\n    cset_int.add(15);\n    assert_eq!(cset_int.size(), 3);\n    cset_int.clear();\n    assert_eq!(cset_int.size(), 0);\n    cset_int.add(45);\n    assert_eq!(cset_int.size(), 1);\n}\n#[test]\nfn test_cset_intersection() {\n    let mut cset_int_a = cset::Cset::<i32>::new();\n    let mut cset_int_b = cset::Cset::<i32>::new();\n    cset_int_a.add(12);\n    cset_int_a.add(13);\n    cset_int_a.add(14);\n    cset_int_b.add(12);\n    cset_int_b.add(13);\n    cset_int_b.add(16);\n    let mut result = cset::Cset::<i32>::new();\n    result.intersect(&cset_int_a, &cset_int_b);\n    assert_eq!(result.size(), 2);\n    cset_int_b.add(14);\n    result.intersect(&cset_int_a, &cset_int_b);\n    assert_eq!(result.size(), 3);\n}\n#[test]\nfn test_cset_union() {\n    let mut cset_int_a = cset::Cset::<i32>::new();\n    let mut cset_int_b = cset::Cset::<i32>::new();\n    let mut cset_result = cset::Cset::<i32>::new();\n    cset_int_a.add(34);\n    cset_int_a.add(25);\n    cset_int_a.add(12);\n    cset_int_b.add(1);\n    cset_int_b.add(4);\n    cset_int_b.add(34);\n    cset_result.union(&cset_int_a, &cset_int_b);\n    assert_eq!(cset_result.size(), 5);\n    cset_int_b.add(100);\n    cset_result.union(&cset_int_a, &cset_int_b);\n    assert_eq!(cset_result.size(), 6);\n}\n#[test]\nfn test_cset_disjoint() {\n    let mut cset_a = cset::Cset::<char>::new();\n    let mut cset_b = cset::Cset::<char>::new();\n    cset_a.add('a');\n    cset_a.add('b');\n    cset_b.add('c');\n    cset_b.add('d');\n    assert!(cset_a.is_disjoint(&cset_b));\n    cset_b.add('a');\n    assert!(!cset_a.is_disjoint(&cset_b));\n}\n#[test]\nfn test_cset_difference() {\n    let mut cset_a = cset::Cset::<i32>::new();\n    let mut cset_b = cset::Cset::<i32>::new();\n    let mut result = cset::Cset::<i32>::new();\n    result.difference(&cset_a, &cset_b);\n    assert_eq!(result.size(), 0);\n    cset_a.add(45);\n    cset_a.add(46);\n    cset_a.add(58);\n    cset_b.add(12);\n    cset_b.add(11);\n    cset_b.add(45);\n    result.difference(&cset_a, &cset_b);\n    assert_eq!(result.size(), 2);\n    assert!(result.contains(&46));\n    assert!(result.contains(&58));\n    assert!(!result.contains(&45));\n    result.clear();\n    cset_b.add(46);\n    cset_b.add(58);\n    result.difference(&cset_a, &cset_b);\n    assert_eq!(result.size(), 0);\n    result.difference(&cset_b, &cset_a);\n    assert_eq!(result.size(), 2);\n}\nfn main() {}","numLines":221,"startLine":1,"totalLines":221}}}
