{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017qJ8GEUtbxteViT359ufcG","type":"tool_result","content":"1\t/*\n2\t\n3\t    MVPTree c library \n4\t    Copyright (C) 2008-2009 by D. Grant Starkweather\n5\t    All rights reserved.\n6\t\n7\t    This program is free software: you can redistribute it and/or modify\n8\t    it under the terms of the GNU General Public License as published by\n9\t    the Free Software Foundation, either version 3 of the License, or\n10\t    (at your option) any later version.\n11\t\n12\t    This program is distributed in the hope that it will be useful,\n13\t    but WITHOUT ANY WARRANTY; without even the implied warranty of\n14\t    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n15\t    GNU General Public License for more details.\n16\t\n17\t    You should have received a copy of the GNU General Public License\n18\t    along with this program.  If not, see <http://www.gnu.org/licenses/>.\n19\t\n20\t    D Grant Starkweather - starkd88@gmail.com\n21\t\n22\t*/\n23\t\n24\t#include <stdlib.h>\n25\t#include <stdio.h>\n26\t#include <stdint.h>\n27\t#include <string.h>\n28\t#include <math.h>\n29\t#include <time.h>\n30\t#include <assert.h>\n31\t#include \"mvptree.h\"\n32\t\n33\t#define MVP_BRANCHFACTOR 2\n34\t#define MVP_PATHLENGTH   5\n35\t#define MVP_LEAFCAP     25\n36\t\n37\tvoid testmvpfree(void *ptr){\n38\t    free(ptr);\n39\t}\n40\t\n41\tstatic unsigned long long nbcalcs = 0;\n42\t\n43\tint next_poisson_int(int lambda){\n44\t/* generate poisson random deviate with average lambda */\n45\t    double L = exp((double)-lambda);\n46\t    double u, p = 1.0;\n47\t    int k = 0;\n48\t    do {\n49\t\tk++;\n50\t\tu = (float)rand()/((float)RAND_MAX-1);\n51\t\tp = p*u;\n52\t    } while (p > L);\n53\t    return k-1;\n54\t}\n55\t\n56\t\n57\tfloat point_l1_distance(MVPDP *pointA, MVPDP *pointB){\n58\t    /* L1 distance */\n59\t    if (!pointA || !pointB) return -1.0f;\n60\t    unsigned int i;\n61\t    unsigned int sum = 0;\n62\t    uint8_t *data1 = (uint8_t*)pointA->data;\n63\t    uint8_t *data2 = (uint8_t*)pointB->data;\n64\t    for (i = 0; i < pointA->datalen; i++){\n65\t\tint d1 = (int)data1[i];\n66\t\tint d2 = (int)data2[i];\n67\t\tint diff = abs(d1 - d2);\n68\t\tsum += diff;\n69\t    }\n70\t    nbcalcs++;\n71\t\n72\t    return (float)sum/(float)pointA->datalen;\n73\t}\n74\tfloat point_l2_distance(MVPDP *pointA, MVPDP *pointB){\n75\t    /* L2 distance */\n76\t    if (!pointA || !pointB) {\n77\t\treturn -1.0f;\n78\t    } else if (pointA->datalen != pointB->datalen){\n79\t\tfprintf(stdout,\" dataA %d, dataB %d\\n\", pointA->datalen, pointB->datalen);\n80\t\treturn -2.0f;\n81\t    }\n82\t    int i;\n83\t    int sum = 0;\n84\t    uint8_t *data1 = (uint8_t*)pointA->data;\n85\t    uint8_t *data2 = (uint8_t*)pointB->data;\n86\t    for (i=0;i<pointA->datalen;i++){\n87\t\tint d1 = (int)data1[i];\n88\t\tint d2 = (int)data2[i];\n89\t\tint diff = d1 - d2;\n90\t\tsum += diff*diff;\n91\t    }\n92\t    nbcalcs++;\n93\t\n94\t    return sqrt((float)sum)/(float)pointA->datalen;\n95\t}\n96\t\n97\tMVPDP* mvpdp_dup(MVPDP *dp){\n98\t    MVPDP *newpnt = dp_alloc(dp->type);\n99\t    if (!newpnt) return NULL;\n100\t    newpnt->datalen = dp->datalen;\n101\t    newpnt->data = malloc(dp->datalen*dp->type);\n102\t    memcpy(newpnt->data, dp->data, dp->datalen*dp->type);\n103\t    newpnt->id = strdup(dp->id);\n104\t    return newpnt;\n105\t}\n106\t\n107\tMVPDP* generate_point(const unsigned int dp_length){\n108\t    /* generate one datapoint with BYTEARRAY type data of length dp_length */\n109\t    static unsigned long long uid = 0;\n110\t    char scratch[32];\n111\t\n112\t    MVPDP *newpnt = dp_alloc(BYTEARRAY);\n113\t    if (newpnt == NULL) return NULL;\n114\t\n115\t    newpnt->datalen = dp_length;\n116\t    newpnt->data = malloc(dp_length*sizeof(uint8_t));\n117\t    if (newpnt->data == NULL) {\n118\t\tfree (newpnt);\n119\t\treturn NULL;\n120\t    }\n121\t    int8_t *row = (int8_t*)newpnt->data;\n122\t\n123\t    int i;\n124\t    for (i=0;i<dp_length;i++){\n125\t\trow[i] = (int8_t)rand();\n126\t    }\n127\t    snprintf(scratch, 32, \"point%llu\", ++uid);\n128\t    newpnt->id = strdup(scratch);\n129\t    if (newpnt->id == NULL){\n130\t\tfree(newpnt);\n131\t\tfree(newpnt->data);\n132\t\treturn NULL;\n133\t    }\n134\t\n135\t    return newpnt;\n136\t}\n137\t\n138\t/* generate random data points for a tree */\n139\tMVPDP** generate_uniform_points(const unsigned int nbpoints, const unsigned int dp_length){\n140\t    /* generate nbpoints uniformly distributed points all of dp_length BYTEARRAY */\n141\t    MVPDP **pointlist = (MVPDP**)malloc(nbpoints*sizeof(MVPDP*));\n142\t    if (pointlist == NULL){\n143\t\treturn NULL;\n144\t    }\n145\t    unsigned int i;\n146\t    for (i=0;i < nbpoints;i++){\n147\t\tpointlist[i] = generate_point(dp_length);\n148\t\tif (!pointlist[i]) return NULL;\n149\t    }\n150\t\n151\t    return pointlist;\n152\t}\n153\t\n154\tMVPDP** generate_cluster(unsigned int nbpoints, unsigned int dplength, int var, CmpFunc dist){\n155\t    /* generate nbpoints cluster with data of type BYTEARRAY and dplength long */\n156\t\n157\t    MVPDP **points = (MVPDP**)malloc(nbpoints*sizeof(MVPDP*));\n158\t    if (!points)return NULL;\n159\t\n160\t    /* generate first point around which all other points shall cluster */\n161\t    points[0] = generate_point(dplength);\n162\t    if (points[0] == NULL){\n163\t\tfree(points);\n164\t\treturn NULL;\n165\t    }\n166\t\n167\t    /* generate the other points */\n168\t    int i, j, val;\n169\t    uint8_t *orig_row = (uint8_t*)points[0]->data;\n170\t    float max_distance = 0.0f, d;\n171\t    for (i=1;i<nbpoints;i++){\n172\t\tpoints[i] = generate_point(dplength);\n173\t\tif (!points[i]){\n174\t\t    free(points);\n175\t\t    return NULL;\n176\t\t}\n177\t\t\n178\t\tuint8_t *new_row  = (uint8_t*)points[i]->data;\n179\t\tfor (j=0;j<dplength;j++){\n180\t\t    int diff = next_poisson_int(var);\n181\t\t    float toss = (float)rand()/(float)RAND_MAX-1;\n182\t\t    val = (toss > 0.5) ? diff : -diff;\n183\t\t    val += (int)orig_row[j];\n184\t\t    if (val > 255) val = 255;\n185\t\t    else if (val < 0) val = 0;\n186\t\t    new_row[j] = (uint8_t)val;\n187\t\t}\n188\t    \n189\t\td = dist(points[0], points[i]);\n190\t\tif (d > max_distance) {\n191\t\t    max_distance = d;\n192\t\t}\n193\t    }\n194\t\n195\t    fprintf(stdout,\"cluster - maximum distance from main point, %f\\n\", max_distance);\n196\t    return points;\n197\t}\n198\t\n199\tint main(int argc, char **argv){\n200\t\n201\t    const unsigned int nbpoints = 100;\n202\t    const float radius = 5.0f;\n203\t    const unsigned int nbcluster1 = nbpoints/10;\n204\t    const unsigned int knearest = nbpoints;\n205\t    const unsigned int dplength = 10;\n206\t    const int var = 10;\n207\t    const char *testfile = \"testfile.mvp\";\n208\t    CmpFunc distance_func = point_l2_distance;\n209\t    srand(98293928);\n210\t\n211\t    /* generate points */\n212\t    MVPDP  **pointlist = generate_uniform_points(nbpoints, dplength);\n213\t    assert(pointlist);\n214\t\n215\t    /* generate cluster */\n216\t    MVPDP **cluster1 = generate_cluster(nbcluster1, dplength, var, distance_func);\n217\t    assert(cluster1);\n218\t\n219\t    /* save center of cluster for later retrieval */\n220\t    MVPDP *cluster_center = mvpdp_dup(cluster1[0]);\n221\t\n222\t    /* create tree */\n223\t    MVPTree *tree = mvptree_alloc(NULL, distance_func, MVP_BRANCHFACTOR, MVP_PATHLENGTH, MVP_LEAFCAP);\n224\t    assert(tree);\n225\t\n226\t    printf(\"Add list of %d points to tree.\\n\", nbpoints);\n227\t    /* add points to tree */\n228\t    MVPError err = mvptree_add(tree, pointlist, nbpoints);\n229\t    assert(err == MVP_SUCCESS);\n230\t\n231\t\n232\t    printf(\"Add cluster of %d points to tree.\\n\", nbcluster1);\n233\t    /* add cluster to tree */\n234\t    err = mvptree_add(tree, cluster1, nbcluster1);\n235\t    assert(err == MVP_SUCCESS);\n236\t \n237\t    /* free the