{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CbaBfvZnGebi8Nwc7vys1X","type":"tool_result","content":"1\t#include <stdio.h>\n2\t#include \"../src/circ_array.h\"\n3\t#include \"../src/carrays.h\"\n4\t\n5\t// seeding random\n6\t#include <sys/time.h> // for seeding random\n7\t#include <unistd.h> // getpid()\n8\t\n9\tsize_t num_tests_run = 0, num_tests_failed = 0;\n10\t\n11\t// Test MACROs\n12\t#define QUOTE_MACRO(str) #str\n13\t#define QUOTE_VALUE(str) QUOTE_MACRO(str)\n14\t\n15\t#define TASSERT2(x,fmt,...) do {                                               \\\n16\t  num_tests_run++;                                                             \\\n17\t  if(!(x)) {                                                                   \\\n18\t    num_tests_failed++;                                                        \\\n19\t    fprintf(stderr, \"[%s:%i] Failed: %s\\n\",__FILE__,__LINE__,QUOTE_VALUE(x));  \\\n20\t    if((fmt) != NULL) fprintf(stderr, fmt, ##__VA_ARGS__);                     \\\n21\t  }                                                                            \\\n22\t} while(0)\n23\t\n24\t#define TASSERT(x) do {                                                        \\\n25\t  num_tests_run++;                                                             \\\n26\t  if(!(x)) {                                                                   \\\n27\t    num_tests_failed++;                                                        \\\n28\t    fprintf(stderr, \"[%s:%i] Failed: %s\\n\",__FILE__,__LINE__,QUOTE_VALUE(x));  \\\n29\t  }                                                                            \\\n30\t} while(0)\n31\t\n32\t#define die(fmt,...) do { \\\n33\t  fprintf(stderr, \"[%s:%i] Error: %s() \"fmt\"\\n\", __FILE__, __LINE__, __func__, ##__VA_ARGS__); \\\n34\t  exit(EXIT_FAILURE); \\\n35\t} while(0)\n36\t\n37\t#define status(fmt,...) do { \\\n38\t  fprintf(stdout, \"[%s:%i] \"fmt\"\\n\", __FILE__, __LINE__, ##__VA_ARGS__); \\\n39\t} while(0)\n40\t\n41\tvoid test_round()\n42\t{\n43\t  status(\"Testing roundup32() / roundup64()\");\n44\t\n45\t  uint64_t i;\n46\t\n47\t  TASSERT(gca_roundup32(0) == 0 && gca_roundup64(0) == 0);\n48\t  TASSERT(gca_roundup32(1) == 1 && gca_roundup64(1) == 1);\n49\t  TASSERT(gca_roundup32(2) == 2 && gca_roundup64(2) == 2);\n50\t  TASSERT(gca_roundup32(3) == 4 && gca_roundup64(3) == 4);\n51\t  TASSERT(gca_roundup32(4) == 4 && gca_roundup64(4) == 4);\n52\t  TASSERT(gca_roundup32(5) == 8 && gca_roundup64(5) == 8);\n53\t  TASSERT(gca_roundup32(6) == 8 && gca_roundup64(6) == 8);\n54\t  TASSERT(gca_roundup32(7) == 8 && gca_roundup64(7) == 8);\n55\t  TASSERT(gca_roundup32(8) == 8 && gca_roundup64(8) == 8);\n56\t  TASSERT(gca_roundup32(100) == 128 && gca_roundup64(100) == 128);\n57\t\n58\t  for(i = 2; i < 32; i++) {\n59\t    TASSERT(gca_roundup32((1U<<i)-1) == (1U<<i));\n60\t    TASSERT(gca_roundup32(1U<<i) == (1U<<i));\n61\t  }\n62\t\n63\t  for(i = 2; i < 64; i++) {\n64\t    TASSERT(gca_roundup64((1UL<<i)-1) == (1UL<<i));\n65\t    TASSERT(gca_roundup64(1UL<<i) == (1UL<<i));\n66\t  }\n67\t}\n68\t\n69\tvoid test_GCD()\n70\t{\n71\t  status(\"Testing calculating GCD...\");\n72\t\n73\t  size_t i;\n74\t  for(i = 0; i < 100; i++) {\n75\t    TASSERT(gca_calc_GCD(i,i) == i);\n76\t    TASSERT(gca_calc_GCD(i,0) == i);\n77\t    TASSERT(gca_calc_GCD(0,i) == i);\n78\t    TASSERT(gca_calc_GCD(i,1) == 1);\n79\t    TASSERT(gca_calc_GCD(1,i) == 1);\n80\t  }\n81\t\n82\t  TASSERT(gca_calc_GCD(2,4) == 2);\n83\t  TASSERT(gca_calc_GCD(4,2) == 2);\n84\t  TASSERT(gca_calc_GCD(6,9) == 3);\n85\t  TASSERT(gca_calc_GCD(9,6) == 3);\n86\t  TASSERT(gca_calc_GCD(0,0) == 0);\n87\t  TASSERT(gca_calc_GCD(10,0) == 10);\n88\t  TASSERT(gca_calc_GCD(0,10) == 10);\n89\t  TASSERT(gca_calc_GCD(2,2) == 2);\n90\t  TASSERT(gca_calc_GCD(1,1) == 1);\n91\t  TASSERT(gca_calc_GCD(1,2) == 1);\n92\t  TASSERT(gca_calc_GCD(1,100) == 1);\n93\t  TASSERT(gca_calc_GCD(2,4) == 2);\n94\t  TASSERT(gca_calc_GCD(7,5) == 1);\n95\t  TASSERT(gca_calc_GCD(18,6) == 6);\n96\t  TASSERT(gca_calc_GCD(3,6) == 3);\n97\t  TASSERT(gca_calc_GCD(100,120) == 20);\n98\t  TASSERT(gca_calc_GCD(100,125) == 25);\n99\t}\n100\t\n101\tvoid _test_cycle(size_t *arr, size_t n)\n102\t{\n103\t  size_t shift, i;\n104\t\n105\t  // initialise\n106\t  for(i = 0; i < n; i++) arr[i] = i;\n107\t\n108\t  // cycle left by 0, n, 2n, ... should all return input\n109\t  gca_cycle_left(arr, n, sizeof(size_t), 0);\n110\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n111\t  gca_cycle_left(arr, n, sizeof(size_t), n);\n112\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n113\t  gca_cycle_left(arr, n, sizeof(size_t), 2*n);\n114\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n115\t  gca_cycle_left(arr, n, sizeof(size_t), 3*n);\n116\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n117\t\n118\t  // cycle right by 0, n, 2n, ... should all return input\n119\t  gca_cycle_right(arr, n, sizeof(size_t), 0);\n120\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n121\t  gca_cycle_right(arr, n, sizeof(size_t), n);\n122\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n123\t  gca_cycle_right(arr, n, sizeof(size_t), 2*n);\n124\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n125\t  gca_cycle_right(arr, n, sizeof(size_t), 3*n);\n126\t  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n127\t\n128\t  for(shift = 0; shift < n; shift++) {\n129\t    for(i = 0; i < n; i++) arr[i] = i;\n130\t    gca_cycle_left(arr, n, sizeof(size_t), shift);\n131\t    for(i = 0; i < n; i++) TASSERT(arr[i] == ((i+shift) % n));\n132\t    // shift back\n133\t    gca_cycle_right(arr, n, sizeof(size_t), shift);\n134\t    for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n135\t  }\n136\t}\n137\t\n138\tvoid test_cycle()\n139\t{\n140\t  status(\"Testing array cycle left/right...\");\n141\t  size_t n, arr[100];\n142\t\n143\t  // Test all array lengths up to 100\n144\t  for(n = 0; n < 100; n++)\n145\t    _test_cycle(arr, n);\n146\t}\n147\t\n148\tvoid test_reverse()\n149\t{\n150\t  status(\"Testing array reverse...\");\n151\t\n152\t  #define N 100\n153\t  size_t i, n, tmp[N];\n154\t  for(n = 0; n <= N; n++) {\n155\t    for(i = 0; i < n; i++) tmp[i] = i;\n156\t    gca_reverse(tmp, n, sizeof(tmp[0]));\n157\t    for(i = 0; i < n && tmp[i] == n-i-1; i++) {}\n158\t    TASSERT(i == n);\n159\t  }\n160\t  #undef N\n161\t}\n162\t\n163\tvoid test_bsearch()\n164\t{\n165\t  status(\"Testing binary search...\");\n166\t\n167\t  #define N 100\n168\t  size_t idx;\n169\t  int i, n, find, arr[N], *foundb, *foundl;\n170\t  for(i = 0; i < N; i++) arr[i] = i;\n171\t\n172\t  find = 20;\n173\t  foundb = gca_bsearch(arr, N, sizeof(arr[0]), gca_search_int, &find);\n174\t  foundl = gca_lsearch(arr, N, sizeof(arr[0]), gca_search_int, &find);\n175\t  idx = foundb-arr;\n176\t\n177\t  TASSERT(foundb == &arr[find]);\n178\t  TASSERT(idx == (size_t)find);\n179\t\n180\t  for(n = 0; n <= N; n++) {\n181\t    for(find = -2; find <= n+2; find++) {\n182\t      foundb = gca_bsearch(arr, n, sizeof(arr[0]), gca_search_int, &find);\n183\t      TASSERT(foundb == (find < 0 || find >= n ? NULL : &arr[find]));\n184\t      foundl = gca_lsearch(arr, n, sizeof(arr[0]), gca_search_int, &find);\n185\t      TASSERT(foundb == foundl);\n186\t    }\n187\t  }\n188\t  #undef N\n189\t}\n190\t\n191\tvoid test_quicksort()\n192\t{\n193\t  status(\"Testing quicksort...\");\n194\t\n195\t  #define N 100\n196\t  size_t i, j, n, arr[N];\n197\t\n198\t  // Try different array lengths\n199\t  for(n = 0; n <= N; n++)\n200\t  {\n201\t    // start with reverse sorted array\n202\t    for(i = 0; i < n; i++) arr[i] = n-1-i;\n203\t    gca_qsort(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n204\t    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n205\t\n206\t    // start with sorted array\n207\t    for(i = 0; i < n; i++) arr[i] = i;\n208\t    gca_qsort(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n209\t    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n210\t\n211\t    // shuffle the array first\n212\t    for(j = 0; j < 100; j++) {\n213\t      gca_shuffle(arr, n, sizeof(arr[0]));\n214\t      gca_qsort(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n215\t      TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n216\t    }\n217\t  }\n218\t\n219\t  #undef N\n220\t}\n221\t\n222\t// check partition around pivot\n223\tbool check_qpart(size_t *arr, size_t n, size_t pidx)\n224\t{\n225\t  size_t i = 0;\n226\t  for(i = 0; i < pidx; i++)\n227\t    if(arr[i] > arr[pidx]) return false;\n228\t  for(i = pidx+1; i < n; i++)\n229\t    if(arr[i] < arr[pidx]) return false;\n230\t  return true;\n231\t}\n232\t\n233\tvoid test_quickpartition()\n234\t{\n235\t  status(\"Testing quickpartition...\");\n236\t\n237\t  #define N 100\n238\t  size_t i, n, arr[N], p;\n239\t  for(i = 0; i < N; i++) arr[i] = i;\n240\t\n241\t  for(n = 0; n <= N; n++) {\n242\t    gca_shuffle(arr, n, sizeof(arr[0]));\n243\t    for(i = 0; i < n; i++) {\n244\t      p = arr[i];\n245\t      gca_swapm(&arr[0], &arr[i], sizeof(arr[0]));\n246\t      gca_qpart(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n247\t      TASSERT(arr[p] == p);\n248\t      TASSERT(check_qpart(arr, n, p));\n249\t    }\n250\t  }\n251\t  #undef N\n252\t}\n253\t\n254\tvoid test_quickselect()\n255\t{\n256\t  status(\"Testing quickselect...\");\n257\t\n258\t  #define N 10\n259\t  size_t i, n, arr[N], pos[N];\n260\t  for(i = 0; i < N; i++) pos[i] = i;\n261\t\n262\t  for(n = 0; n <= N; n++)\n263\t  {\n264\t    // Create shuffled array of positions\n265\t    gca_shuffle(pos, n, sizeof(pos[0]));\n266\t    // check all positions are <n (this is a test of gca_shuffle())\n267\t    for(i = 0; i < n && pos[i] < n; i++) {}\n268\t    TASSERT(i == n);\n269\t\n270\t    // Initialise array to 0..n-1\n271\t    for(i = 0; i < n; i++) arr[i] = i;\n272\t\n273\t    // Check we can select each index without changing the array\n274\t    for(i = 0; i < n; i++) {\n275\t      gca_qselect(arr, n, sizeof(arr[0]), i, gca_cmp2_size, NULL);\n276\t      TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n277\t    }\n278\t\n279\t    // shuffle and check\n280\t    for(i = 0; i < n; i++) {\n281\t      gca_qselect(arr, n, sizeof(arr[0]), pos[i], gca_cmp2_size, NULL);\n282\t      TASSERT(check_qpart(arr, n, pos[i]));\n283\t    }\n284\t    // Should now be sorted after pivoting on each index\n285\t    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n286\t  }\n287\t\n288\t  #undef N\n289\t}\n290\t\n291\tvoid test_heapsort()\n292\t{\n293\t  status(\"Testing heapsort...\");\n294\t\n295\t  #define N 200\n296\t  int i, j, n, arr[N];\n297\t\n298\t  // Try different array lengths\n299\t  for(n = 0; n <= N; n++)\n300\t  {\n301\t    // start with sorted array\n302\t    for(j = 0; j < n; j++) arr[j] = j;\n303\t    gca_heap_make(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n304\t    gca_heap_sort(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n305\t    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL));\n306\t\n307\t    // start with reverse sorted array\n308\t    for(j = 0; j < n; j++) arr[j] = n-1-j;\n309\t    gca_heap_make(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n310\t    gca_heap_sort(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n311\t    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL));\n312\t\n313\t    // start with a shuffled array\n314\t    for(i = 0; i < 10; i++) {\n315\t      gca_shuffle(arr, n, sizeof(arr[0]));\n316\t      gca_heap_make(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n317\t      gca_heap_sort(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n318\t      TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL));\n319\t    }\n320\t  }\n321\t  #undef N\n322\t}\n323\t\n324\t\n325\t#define arrset5(x,a,b,c,d,e) do { x[0]=(a);x[1]=(b);x[2]=(c);x[3]=(d);x[4]=(e); }while(0)\n326\t\n327\tstatic inline void check_median5(size_t *arr, size_t ans)\n328\t{\n329\t  size_t i, tmp;\n330\t  char *ptr = gca_median5(&arr[0], &arr[1], &arr[2], &arr[3], &arr[4],\n331\t                          gca_cmp2_size, NULL);\n332\t  memcpy(&tmp, ptr, sizeof(tmp));\n333\t  TASSERT(tmp == ans);\n334\t  if(tmp != ans) {\n335\t    for(i = 0; i < 5; i++) printf(\" %zu\", arr[i]);\n336\t    printf(\"\\n\");\n337\t  }\n338\t}\n339\t\n340\t\n341\tvoid test_median5()\n342\t{\n343\t  size_t arr[5];\n344\t  size_t i, m = 2, *itr = NULL;\n345\t\n346\t  // 5*4*3*2*1 = 120 perumations\n347\t  for(i = 0; gca_itr_next(&itr, 5, NULL); i++)\n348\t    check_median5(itr, m);\n349\t\n350\t  TASSERT(i == 5*4*3*2*1);\n351\t  free(itr);\n352\t\n353\t  for(i = 0; i < 10; i++) {\n354\t    arrset5(arr, i, i, i, i, i);\n355\t    check_median5(arr, i);\n356\t  }\n357\t\n358\t  arrset5(arr, 10, 0, 10,  0, 10); check_median5(arr, 10);\n359\t  arrset5(arr, 1,  9,  9, 10, 10); check_median5(arr, 9);\n360\t  arrset5(arr, 10, 10, 9,  8,  7); check_median5(arr, 9);\n361\t}\n362\t\n363\t// size_t avgfunc(size_t a, size_t b) {\n364\t//   status(\"a=%zu b=%zu\", a, b);\n365\t//   return (a+b+1.0)/2.0;\n366\t// }\n367\t\n368\tvoid test_median()\n369\t{\n370\t  #define avgfunc(a,b) (((a)+(b)+1.0)/2.0)\n371\t  #define N 10\n372\t  #define NTESTS 4\n373\t  size_t arr[N], i, t, n;\n374\t\n375\t  arr[0] = 1; arr[1] = 5; arr[2] = 4;\n376\t  TASSERT(gca_median2(arr, 0, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 0);\n377\t  TASSERT(gca_median2(arr, 1, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 1);\n378\t  TASSERT(gca_median2(arr, 2, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 3);\n379\t  TASSERT(gca_median2(arr, 3, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 4);\n380\t\n381\t  TASSERT(gca_median_size(arr, 0) == 0);\n382\t  TASSERT(gca_median_size(arr, 1) == 1);\n383\t  TASSERT(gca_median_size(arr, 2) == 3);\n384\t  TASSERT(gca_median_size(arr, 3) == 4);\n385\t\n386\t  // 7, 7, ... 7, 7\n387\t  for(i = 0; i < N; i++) arr[i] = 7;\n388\t  for(n = 1; n <= N; n++)\n389\t    TASSERT(gca_median(arr, n, gca_cmp2_size, NULL, size_t, avgfunc) == 7);\n390\t\n391\t  // 0, 1, ... 8, 9\n392\t  for(i = 0; i < N; i++) arr[i] = i;\n393\t  TASSERT(gca_median2(arr, 0, gca_cmp2_size, NULL, size_t, avgfunc, SIZE_MAX) == SIZE_MAX);\n394\t  TASSERT(gca_median2(arr, 0, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 0);\n395\t  TASSERT(gca_median(arr, 1, gca_cmp2_size, NULL, size_t, avgfunc) == 0);\n396\t  TASSERT(gca_median(arr, 2, gca_cmp2_size, NULL, size_t, avgfunc) == 1);\n397\t  TASSERT(gca_median(arr, 3, gca_cmp2_size, NULL, size_t, avgfunc) == 1);\n398\t  TASSERT(gca_median(arr, 4, gca_cmp2_size, NULL, size_t, avgfunc) == 2);\n399\t\n400\t  for(t = 0; t < NTESTS; t++)\n401\t  {\n402\t    // (4 + 5) / 2 = 9/2 = 4.5 => 5\n403\t    for(i = 0; i < N; i++) arr[i] = i;\n404\t    gca_shuffle(arr, N, sizeof(arr[0]));\n405\t    TASSERT(gca_median(arr, N, gca_cmp2_size, NULL, size_t, avgfunc) == 5);\n406\t\n407\t    // 0, 2, ... 16, 18\n408\t    // (2*4 + 2*5) / 2 = (8+10) / 2 = 18/2 = 9\n409\t    for(i = 0; i < N; i++) arr[i] = 2*i;\n410\t    gca_shuffle(arr, N, sizeof(arr[0]));\n411\t    TASSERT(gca_median(arr, N, gca_cmp2_size, NULL, size_t, avgfunc) == 9);\n412\t\n413\t    // 0, 3, ... 24, 27\n414\t    // (3*4 + 3*5) / 2 = (12+15) / 2 = 27/2 = 13.5 => 14\n415\t    for(i = 0; i < N; i++) arr[i] = 3*i;\n416\t    gca_shuffle(arr, N, sizeof(arr[0]));\n417\t    TASSERT(gca_median(arr, N, gca_cmp2_size, NULL, size_t, avgfunc) == 14);\n418\t  }\n419\t  #undef N\n420\t}\n421\t\n422\t\n423\tvoid check_permutation5(size_t **pp, size_t a, size_t b, size_t c, size_t d, size_t e,\n424\t                        size_t *init)\n425\t{\n426\t  size_t *p = gca_itr_next(pp, 5, init);\n427\t  TASSERT(p != NULL);\n428\t  bool nxtpermut = p[0] == a && p[1] == b && p[2] == c && p[3] == d && p[4] == e;\n429\t  TASSERT2(nxtpermut, \"%zu %zu %zu %zu %zu / %zu %zu %zu %zu %zu\\n\",\n430\t           p[0], p[1], p[2], p[3], p[4], a, b, c, d, e);\n431\t}\n432\t\n433\tvoid test_next_perm_with_dupes()\n434\t{\n435\t  status(\"Testing next permutation with duplicates...\");\n436\t\n437\t  size_t *p = NULL, init[] = {0,1,2,2,2};\n438\t\n439\t  check_permutation5(&p,0,1,2,2,2,init);\n440\t  check_permutation5(&p,0,2,1,2,2,init);\n441\t  check_permutation5(&p,0,2,2,1,2,init);\n442\t  check_permutation5(&p,0,2,2,2,1,init);\n443\t\n444\t  check_permutation5(&p,1,0,2,2,2,init);\n445\t  check_permutation5(&p,1,2,0,2,2,init);\n446\t  check_permutation5(&p,1,2,2,0,2,init);\n447\t  check_permutation5(&p,1,2,2,2,0,init);\n448\t\n449\t  check_permutation5(&p,2,0,1,2,2,init);\n450\t  check_permutation5(&p,2,0,2,1,2,init);\n451\t  check_permutation5(&p,2,0,2,2,1,init);\n452\t  check_permutation5(&p,2,1,0,2,2,init);\n453\t  check_permutation5(&p,2,1,2,0,2,init);\n454\t  check_permutation5(&p,2,1,2,2,0,init);\n455\t\n456\t  check_permutation5(&p,2,2,0,1,2,init);\n457\t  check_permutation5(&p,2,2,0,2,1,init);\n458\t  check_permutation5(&p,2,2,1,0,2,init);\n459\t  check_permutation5(&p,2,2,1,2,0,init);\n460\t\n461\t  check_permutation5(&p,2,2,2,0,1,init);\n462\t  check_permutation5(&p,2,2,2,1,0,init);\n463\t\n464\t  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n465\t  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n466\t  // check we can reset and loop back\n467\t  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n468\t  check_permutation5(&p,0,1,2,2,2,init);\n469\t  check_permutation5(&p,0,2,1,2,2,init);\n470\t\n471\t  // Try iterating over set of 1s\n472\t  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n473\t  init[0] = init[1] = init[2] = init[3] = init[4] = 1;\n474\t  check_permutation5(&p,1,1,1,1,1,init);\n475\t  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n476\t  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n477\t  check_permutation5(&p,1,1,1,1,1,init);\n478\t\n479\t  // Iterate over set of 1,1,1,7\n480\t  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n481\t  init[0] = init[1] = init[2] = init[3] = init[4] = 1;\n482\t  init[4] = 7;\n483\t  check_permutation5(&p,1,1,1,1,7,init);\n484\t  check_permutation5(&p,1,1,1,7,1,init);\n485\t  check_permutation5(&p,1,1,7,1,1,init);\n486\t  check_permutation5(&p,1,7,1,1,1,init);\n487\t  check_permutation5(&p,7,1,1,1,1,init);\n488\t  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n489\t  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n490\t  check_permutation5(&p,1,1,1,1,7,init);\n491\t\n492\t  free(p);\n493\t}\n494\t\n495\tvoid test_next_permutation()\n496\t{\n497\t  status(\"Testing next permutation...\");\n498\t\n499\t  size_t i, n;\n500\t  size_t *p = NULL;\n501\t\n502\t  check_permutation5(&p,0,1,2,3,4,NULL);\n503\t  check_permutation5(&p,0,1,2,4,3,NULL);\n504\t  check_permutation5(&p,0,1,3,2,4,NULL);\n505\t  check_permutation5(&p,0,1,3,4,2,NULL);\n506\t  check_permutation5(&p,0,1,4,2,3,NULL);\n507\t  check_permutation5(&p,0,1,4,3,2,NULL);\n508\t\n509\t  check_permutation5(&p,0,2,1,3,4,NULL);\n510\t  check_permutation5(&p,0,2,1,4,3,NULL);\n511\t  check_permutation5(&p,0,2,3,1,4,NULL);\n512\t  check_permutation5(&p,0,2,3,4,1,NULL);\n513\t  check_permutation5(&p,0,2,4,1,3,NULL);\n514\t  check_permutation5(&p,0,2,4,3,1,NULL);\n515\t\n516\t  check_permutation5(&p,0,3,1,2,4,NULL);\n517\t  check_permutation5(&p,0,3,1,4,2,NULL);\n518\t  check_permutation5(&p,0,3,2,1,4,NULL);\n519\t  check_permutation5(&p,0,3,2,4,1,NULL);\n520\t  check_permutation5(&p,0,3,4,1,2,NULL);\n521\t  check_permutation5(&p,0,3,4,2,1,NULL);\n522\t\n523\t  check_permutation5(&p,0,4,1,2,3,NULL);\n524\t  check_permutation5(&p,0,4,1,3,2,NULL);\n525\t  check_permutation5(&p,0,4,2,1,3,NULL);\n526\t  check_permutation5(&p,0,4,2,3,1,NULL);\n527\t  check_permutation5(&p,0,4,3,1,2,NULL);\n528\t  check_permutation5(&p,0,4,3,2,1,NULL);\n529\t\n530\t  //\n531\t  check_permutation5(&p,1,0,2,3,4,NULL);\n532\t  check_permutation5(&p,1,0,2,4,3,NULL);\n533\t  check_permutation5(&p,1,0,3,2,4,NULL);\n534\t  check_permutation5(&p,1,0,3,4,2,NULL);\n535\t  check_permutation5(&p,1,0,4,2,3,NULL);\n536\t  check_permutation5(&p,1,0,4,3,2,NULL);\n537\t\n538\t  check_permutation5(&p,1,2,0,3,4,NULL);\n539\t  check_permutation5(&p,1,2,0,4,3,NULL);\n540\t  check_permutation5(&p,1,2,3,0,4,NULL);\n541\t  check_permutation5(&p,1,2,3,4,0,NULL);\n542\t  check_permutation5(&p,1,2,4,0,3,NULL);\n543\t  check_permutation5(&p,1,2,4,3,0,NULL);\n544\t\n545\t  check_permutation5(&p,1,3,0,2,4,NULL);\n546\t  check_permutation5(&p,1,3,0,4,2,NULL);\n547\t  check_permutation5(&p,1,3,2,0,4,NULL);\n548\t  check_permutation5(&p,1,3,2,4,0,NULL);\n549\t  check_permutation5(&p,1,3,4,0,2,NULL);\n550\t  check_permutation5(&p,1,3,4,2,0,NULL);\n551\t\n552\t  check_permutation5(&p,1,4,0,2,3,NULL);\n553\t  check_permutation5(&p,1,4,0,3,2,NULL);\n554\t  check_permutation5(&p,1,4,2,0,3,NULL);\n555\t  check_permutation5(&p,1,4,2,3,0,NULL);\n556\t  check_permutation5(&p,1,4,3,0,2,NULL);\n557\t  check_permutation5(&p,1,4,3,2,0,NULL);\n558\t\n559\t  //\n560\t  check_permutation5(&p,2,0,1,3,4,NULL);\n561\t  check_permutation5(&p,2,0,1,4,3,NULL);\n562\t  check_permutation5(&p,2,0,3,1,4,NULL);\n563\t  check_permutation5(&p,2,0,3,4,1,NULL);\n564\t  check_permutation5(&p,2,0,4,1,3,NULL);\n565\t  check_permutation5(&p,2,0,4,3,1,NULL);\n566\t\n567\t  check_permutation5(&p,2,1,0,3,4,NULL);\n568\t  check_permutation5(&p,2,1,0,4,3,NULL);\n569\t  check_permutation5(&p,2,1,3,0,4,NULL);\n570\t  check_permutation5(&p,2,1,3,4,0,NULL);\n571\t  check_permutation5(&p,2,1,4,0,3,NULL);\n572\t  check_permutation5(&p,2,1,4,3,0,NULL);\n573\t\n574\t  check_permutation5(&p,2,3,0,1,4,NULL);\n575\t  check_permutation5(&p,2,3,0,4,1,NULL);\n576\t  check_permutation5(&p,2,3,1,0,4,NULL);\n577\t  check_permutation5(&p,2,3,1,4,0,NULL);\n578\t  check_permutation5(&p,2,3,4,0,1,NULL);\n579\t  check_permutation5(&p,2,3,4,1,0,NULL);\n580\t\n581\t  check_permutation5(&p,2,4,0,1,3,NULL);\n582\t  check_permutation5(&p,2,4,0,3,1,NULL);\n583\t  check_permutation5(&p,2,4,1,0,3,NULL);\n584\t  check_permutation5(&p,2,4,1,3,0,NULL);\n585\t  check_permutation5(&p,2,4,3,0,1,NULL);\n586\t  check_permutation5(&p,2,4,3,1,0,NULL);\n587\t\n588\t  //\n589\t  check_permutation5(&p,3,0,1,2,4,NULL);\n590\t  check_permutation5(&p,3,0,1,4,2,NULL);\n591\t  check_permutation5(&p,3,0,2,1,4,NULL);\n592\t  check_permutation5(&p,3,0,2,4,1,NULL);\n593\t  check_permutation5(&p,3,0,4,1,2,NULL);\n594\t  check_permutation5(&p,3,0,4,2,1,NULL);\n595\t\n596\t  check_permutation5(&p,3,1,0,2,4,NULL);\n597\t  check_permutation5(&p,3,1,0,4,2,NULL);\n598\t  check_permutation5(&p,3,1,2,0,4,NULL);\n599\t  check_permutation5(&p,3,1,2,4,0,NULL);\n600\t  check_permutation5(&p,3,1,4,0,2,NULL);\n601\t  check_permutation5(&p,3,1,4,2,0,NULL);\n602\t\n603\t  check_permutation5(&p,3,2,0,1,4,NULL);\n604\t  check_permutation5(&p,3,2,0,4,1,NULL);\n605\t  check_permutation5(&p,3,2,1,0,4,NULL);\n606\t  check_permutation5(&p,3,2,1,4,0,NULL);\n607\t  check_permutation5(&p,3,2,4,0,1,NULL);\n608\t  check_permutation5(&p,3,2,4,1,0,NULL);\n609\t\n610\t  check_permutation5(&p,3,4,0,1,2,NULL);\n611\t  check_permutation5(&p,3,4,0,2,1,NULL);\n612\t  check_permutation5(&p,3,4,1,0,2,NULL);\n613\t  check_permutation5(&p,3,4,1,2,0,NULL);\n614\t  check_permutation5(&p,3,4,2,0,1,NULL);\n615\t  check_permutation5(&p,3,4,2,1,0,NULL);\n616\t\n617\t  //\n618\t  check_permutation5(&p,4,0,1,2,3,NULL);\n619\t  check_permutation5(&p,4,0,1,3,2,NULL);\n620\t  check_permutation5(&p,4,0,2,1,3,NULL);\n621\t  check_permutation5(&p,4,0,2,3,1,NULL);\n622\t  check_permutation5(&p,4,0,3,1,2,NULL);\n623\t  check_permutation5(&p,4,0,3,2,1,NULL);\n624\t\n625\t  check_permutation5(&p,4,1,0,2,3,NULL);\n626\t  check_permutation5(&p,4,1,0,3,2,NULL);\n627\t  check_permutation5(&p,4,1,2,0,3,NULL);\n628\t  check_permutation5(&p,4,1,2,3,0,NULL);\n629\t  check_permutation5(&p,4,1,3,0,2,NULL);\n630\t  check_permutation5(&p,4,1,3,2,0,NULL);\n631\t\n632\t  check_permutation5(&p,4,2,0,1,3,NULL);\n633\t  check_permutation5(&p,4,2,0,3,1,NULL);\n634\t  check_permutation5(&p,4,2,1,0,3,NULL);\n635\t  check_permutation5(&p,4,2,1,3,0,NULL);\n636\t  check_permutation5(&p,4,2,3,0,1,NULL);\n637\t  check_permutation5(&p,4,2,3,1,0,NULL);\n638\t\n639\t  check_permutation5(&p,4,3,0,1,2,NULL);\n640\t  check_permutation5(&p,4,3,0,2,1,NULL);\n641\t  check_permutation5(&p,4,3,1,0,2,NULL);\n642\t  check_permutation5(&p,4,3,1,2,0,NULL);\n643\t  check_permutation5(&p,4,3,2,0,1,NULL);\n644\t  check_permutation5(&p,4,3,2,1,0,NULL);\n645\t\n646\t  TASSERT(gca_itr_next(&p, 5, NULL) == NULL);\n647\t  TASSERT(gca_itr_next(&p, 5, NULL) == NULL);\n648\t  TASSERT(gca_itr_next(&p, 5, NULL) == NULL);\n649\t\n650\t  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n651\t  check_permutation5(&p,0,1,2,3,4,NULL);\n652\t  check_permutation5(&p,0,1,2,4,3,NULL);\n653\t\n654\t  free(p);\n655\t  p = NULL;\n656\t\n657\t  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n658\t  TASSERT(p[0] == 0 && p[1] == 1);\n659\t  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n660\t  TASSERT(p[0] == 1 && p[1] == 0);\n661\t  TASSERT(gca_itr_next(&p, 2, NULL) == NULL);\n662\t  TASSERT(gca_itr_next(&p, 2, NULL) == NULL);\n663\t\n664\t  p = gca_itr_reset(p, 2);\n665\t  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n666\t  TASSERT(p[0] == 0 && p[1] == 1);\n667\t  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n668\t  TASSERT(p[0] == 1 && p[1] == 0);\n669\t  free(p);\n670\t\n671\t  // Test init various lengths\n672\t  for(n = 0; n < 5; n++)\n673\t  {\n674\t    p = gca_itr_reset(NULL, n);\n675\t    TASSERT(gca_itr_next(&p, n, NULL) == (n ? p : NULL));\n676\t    for(i = 0; i < n; i++) TASSERT(p[i] == i);\n677\t    // reuse\n678\t    p = gca_itr_reset(p, n);\n679\t    TASSERT(gca_itr_next(&p, n, NULL) == (n ? p : NULL));\n680\t    for(i = 0; i < n; i++) TASSERT(p[i] == i);\n681\t    free(p);\n682\t\n683\t    // initialise without gca_itr_reset()\n684\t    p = NULL;\n685\t    TASSERT(gca_itr_next(&p, n, NULL) == (n ? p : NULL));\n686\t    for(i = 0; i < n; i++) TASSERT(p[i] == i);\n687\t    free(p);\n688\t  }\n689\t}\n690\t\n691\t#define strhash_fast_mix(h,x) ((h) * 37 + (x))\n692\t#define rotl32(h,r) ((h)<<(r)|(h)>>(32-(r)))\n693\t\n694\tstatic inline uint32_t get_rand_seed()\n695\t{\n696\t  struct timeval now;\n697\t  gettimeofday(&now, NULL);\n698\t\n699\t  uint32_t h = rand();\n700\t  h = strhash_fast_mix(h, rotl32((uint32_t)now.tv_sec,  h & 31));\n701\t  h = strhash_fast_mix(h, rotl32((uint32_t)now.tv_usec, h & 31));\n702\t  h = strhash_fast_mix(h, (uint32_t)getpid());\n703\t  return h;\n704\t}\n705\t\n706\tint main()\n707\t{\n708\t  uint32_t seed32 = get_rand_seed();\n709\t  srand48(seed32);\n710\t  srand(seed32);\n711\t  status(\"Random seed = %u\", seed32);\n712\t\n713\t  status(\"Running tests...\");\n714\t  test_round();\n715\t  test_GCD();\n716\t  test_cycle();\n717\t  test_reverse();\n718\t  test_bsearch();\n719\t  test_quicksort();\n720\t  test_quickpartition();\n721\t  test_quickselect();\n722\t  test_heapsort();\n723\t  test_median5();\n724\t  test_median();\n725\t  test_next_permutation();\n726\t  test_next_perm_with_dupes();\n727\t  status(\"Passed: %zu / %zu (%s)\", num_tests_run-num_tests_failed, num_tests_run,\n728\t         !num_tests_failed ? \"All\" : (num_tests_failed<num_tests_run ? \"Some\" : \"None\"));\n729\t  status(\"Done.\");\n730\t\n731\t  return num_tests_failed ? -1 : 0;\n732\t}\n733\t"}]},"parent_tool_use_id":null,"session_id":"d74539fc-8dc6-490a-bdc5-a3ba062addc7","uuid":"7872fe57-efe0-49ae-92b2-5923382cd31e","timestamp":"2026-06-06T01:05:27.843Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-ClK1DA/project/c_src/tests/test.c","content":"#include <stdio.h>\n#include \"../src/circ_array.h\"\n#include \"../src/carrays.h\"\n\n// seeding random\n#include <sys/time.h> // for seeding random\n#include <unistd.h> // getpid()\n\nsize_t num_tests_run = 0, num_tests_failed = 0;\n\n// Test MACROs\n#define QUOTE_MACRO(str) #str\n#define QUOTE_VALUE(str) QUOTE_MACRO(str)\n\n#define TASSERT2(x,fmt,...) do {                                               \\\n  num_tests_run++;                                                             \\\n  if(!(x)) {                                                                   \\\n    num_tests_failed++;                                                        \\\n    fprintf(stderr, \"[%s:%i] Failed: %s\\n\",__FILE__,__LINE__,QUOTE_VALUE(x));  \\\n    if((fmt) != NULL) fprintf(stderr, fmt, ##__VA_ARGS__);                     \\\n  }                                                                            \\\n} while(0)\n\n#define TASSERT(x) do {                                                        \\\n  num_tests_run++;                                                             \\\n  if(!(x)) {                                                                   \\\n    num_tests_failed++;                                                        \\\n    fprintf(stderr, \"[%s:%i] Failed: %s\\n\",__FILE__,__LINE__,QUOTE_VALUE(x));  \\\n  }                                                                            \\\n} while(0)\n\n#define die(fmt,...) do { \\\n  fprintf(stderr, \"[%s:%i] Error: %s() \"fmt\"\\n\", __FILE__, __LINE__, __func__, ##__VA_ARGS__); \\\n  exit(EXIT_FAILURE); \\\n} while(0)\n\n#define status(fmt,...) do { \\\n  fprintf(stdout, \"[%s:%i] \"fmt\"\\n\", __FILE__, __LINE__, ##__VA_ARGS__); \\\n} while(0)\n\nvoid test_round()\n{\n  status(\"Testing roundup32() / roundup64()\");\n\n  uint64_t i;\n\n  TASSERT(gca_roundup32(0) == 0 && gca_roundup64(0) == 0);\n  TASSERT(gca_roundup32(1) == 1 && gca_roundup64(1) == 1);\n  TASSERT(gca_roundup32(2) == 2 && gca_roundup64(2) == 2);\n  TASSERT(gca_roundup32(3) == 4 && gca_roundup64(3) == 4);\n  TASSERT(gca_roundup32(4) == 4 && gca_roundup64(4) == 4);\n  TASSERT(gca_roundup32(5) == 8 && gca_roundup64(5) == 8);\n  TASSERT(gca_roundup32(6) == 8 && gca_roundup64(6) == 8);\n  TASSERT(gca_roundup32(7) == 8 && gca_roundup64(7) == 8);\n  TASSERT(gca_roundup32(8) == 8 && gca_roundup64(8) == 8);\n  TASSERT(gca_roundup32(100) == 128 && gca_roundup64(100) == 128);\n\n  for(i = 2; i < 32; i++) {\n    TASSERT(gca_roundup32((1U<<i)-1) == (1U<<i));\n    TASSERT(gca_roundup32(1U<<i) == (1U<<i));\n  }\n\n  for(i = 2; i < 64; i++) {\n    TASSERT(gca_roundup64((1UL<<i)-1) == (1UL<<i));\n    TASSERT(gca_roundup64(1UL<<i) == (1UL<<i));\n  }\n}\n\nvoid test_GCD()\n{\n  status(\"Testing calculating GCD...\");\n\n  size_t i;\n  for(i = 0; i < 100; i++) {\n    TASSERT(gca_calc_GCD(i,i) == i);\n    TASSERT(gca_calc_GCD(i,0) == i);\n    TASSERT(gca_calc_GCD(0,i) == i);\n    TASSERT(gca_calc_GCD(i,1) == 1);\n    TASSERT(gca_calc_GCD(1,i) == 1);\n  }\n\n  TASSERT(gca_calc_GCD(2,4) == 2);\n  TASSERT(gca_calc_GCD(4,2) == 2);\n  TASSERT(gca_calc_GCD(6,9) == 3);\n  TASSERT(gca_calc_GCD(9,6) == 3);\n  TASSERT(gca_calc_GCD(0,0) == 0);\n  TASSERT(gca_calc_GCD(10,0) == 10);\n  TASSERT(gca_calc_GCD(0,10) == 10);\n  TASSERT(gca_calc_GCD(2,2) == 2);\n  TASSERT(gca_calc_GCD(1,1) == 1);\n  TASSERT(gca_calc_GCD(1,2) == 1);\n  TASSERT(gca_calc_GCD(1,100) == 1);\n  TASSERT(gca_calc_GCD(2,4) == 2);\n  TASSERT(gca_calc_GCD(7,5) == 1);\n  TASSERT(gca_calc_GCD(18,6) == 6);\n  TASSERT(gca_calc_GCD(3,6) == 3);\n  TASSERT(gca_calc_GCD(100,120) == 20);\n  TASSERT(gca_calc_GCD(100,125) == 25);\n}\n\nvoid _test_cycle(size_t *arr, size_t n)\n{\n  size_t shift, i;\n\n  // initialise\n  for(i = 0; i < n; i++) arr[i] = i;\n\n  // cycle left by 0, n, 2n, ... should all return input\n  gca_cycle_left(arr, n, sizeof(size_t), 0);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n  gca_cycle_left(arr, n, sizeof(size_t), n);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n  gca_cycle_left(arr, n, sizeof(size_t), 2*n);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n  gca_cycle_left(arr, n, sizeof(size_t), 3*n);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n\n  // cycle right by 0, n, 2n, ... should all return input\n  gca_cycle_right(arr, n, sizeof(size_t), 0);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n  gca_cycle_right(arr, n, sizeof(size_t), n);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n  gca_cycle_right(arr, n, sizeof(size_t), 2*n);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n  gca_cycle_right(arr, n, sizeof(size_t), 3*n);\n  for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n\n  for(shift = 0; shift < n; shift++) {\n    for(i = 0; i < n; i++) arr[i] = i;\n    gca_cycle_left(arr, n, sizeof(size_t), shift);\n    for(i = 0; i < n; i++) TASSERT(arr[i] == ((i+shift) % n));\n    // shift back\n    gca_cycle_right(arr, n, sizeof(size_t), shift);\n    for(i = 0; i < n; i++) TASSERT(arr[i] == i);\n  }\n}\n\nvoid test_cycle()\n{\n  status(\"Testing array cycle left/right...\");\n  size_t n, arr[100];\n\n  // Test all array lengths up to 100\n  for(n = 0; n < 100; n++)\n    _test_cycle(arr, n);\n}\n\nvoid test_reverse()\n{\n  status(\"Testing array reverse...\");\n\n  #define N 100\n  size_t i, n, tmp[N];\n  for(n = 0; n <= N; n++) {\n    for(i = 0; i < n; i++) tmp[i] = i;\n    gca_reverse(tmp, n, sizeof(tmp[0]));\n    for(i = 0; i < n && tmp[i] == n-i-1; i++) {}\n    TASSERT(i == n);\n  }\n  #undef N\n}\n\nvoid test_bsearch()\n{\n  status(\"Testing binary search...\");\n\n  #define N 100\n  size_t idx;\n  int i, n, find, arr[N], *foundb, *foundl;\n  for(i = 0; i < N; i++) arr[i] = i;\n\n  find = 20;\n  foundb = gca_bsearch(arr, N, sizeof(arr[0]), gca_search_int, &find);\n  foundl = gca_lsearch(arr, N, sizeof(arr[0]), gca_search_int, &find);\n  idx = foundb-arr;\n\n  TASSERT(foundb == &arr[find]);\n  TASSERT(idx == (size_t)find);\n\n  for(n = 0; n <= N; n++) {\n    for(find = -2; find <= n+2; find++) {\n      foundb = gca_bsearch(arr, n, sizeof(arr[0]), gca_search_int, &find);\n      TASSERT(foundb == (find < 0 || find >= n ? NULL : &arr[find]));\n      foundl = gca_lsearch(arr, n, sizeof(arr[0]), gca_search_int, &find);\n      TASSERT(foundb == foundl);\n    }\n  }\n  #undef N\n}\n\nvoid test_quicksort()\n{\n  status(\"Testing quicksort...\");\n\n  #define N 100\n  size_t i, j, n, arr[N];\n\n  // Try different array lengths\n  for(n = 0; n <= N; n++)\n  {\n    // start with reverse sorted array\n    for(i = 0; i < n; i++) arr[i] = n-1-i;\n    gca_qsort(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n\n    // start with sorted array\n    for(i = 0; i < n; i++) arr[i] = i;\n    gca_qsort(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n\n    // shuffle the array first\n    for(j = 0; j < 100; j++) {\n      gca_shuffle(arr, n, sizeof(arr[0]));\n      gca_qsort(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n      TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n    }\n  }\n\n  #undef N\n}\n\n// check partition around pivot\nbool check_qpart(size_t *arr, size_t n, size_t pidx)\n{\n  size_t i = 0;\n  for(i = 0; i < pidx; i++)\n    if(arr[i] > arr[pidx]) return false;\n  for(i = pidx+1; i < n; i++)\n    if(arr[i] < arr[pidx]) return false;\n  return true;\n}\n\nvoid test_quickpartition()\n{\n  status(\"Testing quickpartition...\");\n\n  #define N 100\n  size_t i, n, arr[N], p;\n  for(i = 0; i < N; i++) arr[i] = i;\n\n  for(n = 0; n <= N; n++) {\n    gca_shuffle(arr, n, sizeof(arr[0]));\n    for(i = 0; i < n; i++) {\n      p = arr[i];\n      gca_swapm(&arr[0], &arr[i], sizeof(arr[0]));\n      gca_qpart(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL);\n      TASSERT(arr[p] == p);\n      TASSERT(check_qpart(arr, n, p));\n    }\n  }\n  #undef N\n}\n\nvoid test_quickselect()\n{\n  status(\"Testing quickselect...\");\n\n  #define N 10\n  size_t i, n, arr[N], pos[N];\n  for(i = 0; i < N; i++) pos[i] = i;\n\n  for(n = 0; n <= N; n++)\n  {\n    // Create shuffled array of positions\n    gca_shuffle(pos, n, sizeof(pos[0]));\n    // check all positions are <n (this is a test of gca_shuffle())\n    for(i = 0; i < n && pos[i] < n; i++) {}\n    TASSERT(i == n);\n\n    // Initialise array to 0..n-1\n    for(i = 0; i < n; i++) arr[i] = i;\n\n    // Check we can select each index without changing the array\n    for(i = 0; i < n; i++) {\n      gca_qselect(arr, n, sizeof(arr[0]), i, gca_cmp2_size, NULL);\n      TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n    }\n\n    // shuffle and check\n    for(i = 0; i < n; i++) {\n      gca_qselect(arr, n, sizeof(arr[0]), pos[i], gca_cmp2_size, NULL);\n      TASSERT(check_qpart(arr, n, pos[i]));\n    }\n    // Should now be sorted after pivoting on each index\n    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_size, NULL));\n  }\n\n  #undef N\n}\n\nvoid test_heapsort()\n{\n  status(\"Testing heapsort...\");\n\n  #define N 200\n  int i, j, n, arr[N];\n\n  // Try different array lengths\n  for(n = 0; n <= N; n++)\n  {\n    // start with sorted array\n    for(j = 0; j < n; j++) arr[j] = j;\n    gca_heap_make(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n    gca_heap_sort(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL));\n\n    // start with reverse sorted array\n    for(j = 0; j < n; j++) arr[j] = n-1-j;\n    gca_heap_make(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n    gca_heap_sort(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n    TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL));\n\n    // start with a shuffled array\n    for(i = 0; i < 10; i++) {\n      gca_shuffle(arr, n, sizeof(arr[0]));\n      gca_heap_make(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n      gca_heap_sort(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL);\n      TASSERT(gca_is_sorted(arr, n, sizeof(arr[0]), gca_cmp2_int, NULL));\n    }\n  }\n  #undef N\n}\n\n\n#define arrset5(x,a,b,c,d,e) do { x[0]=(a);x[1]=(b);x[2]=(c);x[3]=(d);x[4]=(e); }while(0)\n\nstatic inline void check_median5(size_t *arr, size_t ans)\n{\n  size_t i, tmp;\n  char *ptr = gca_median5(&arr[0], &arr[1], &arr[2], &arr[3], &arr[4],\n                          gca_cmp2_size, NULL);\n  memcpy(&tmp, ptr, sizeof(tmp));\n  TASSERT(tmp == ans);\n  if(tmp != ans) {\n    for(i = 0; i < 5; i++) printf(\" %zu\", arr[i]);\n    printf(\"\\n\");\n  }\n}\n\n\nvoid test_median5()\n{\n  size_t arr[5];\n  size_t i, m = 2, *itr = NULL;\n\n  // 5*4*3*2*1 = 120 perumations\n  for(i = 0; gca_itr_next(&itr, 5, NULL); i++)\n    check_median5(itr, m);\n\n  TASSERT(i == 5*4*3*2*1);\n  free(itr);\n\n  for(i = 0; i < 10; i++) {\n    arrset5(arr, i, i, i, i, i);\n    check_median5(arr, i);\n  }\n\n  arrset5(arr, 10, 0, 10,  0, 10); check_median5(arr, 10);\n  arrset5(arr, 1,  9,  9, 10, 10); check_median5(arr, 9);\n  arrset5(arr, 10, 10, 9,  8,  7); check_median5(arr, 9);\n}\n\n// size_t avgfunc(size_t a, size_t b) {\n//   status(\"a=%zu b=%zu\", a, b);\n//   return (a+b+1.0)/2.0;\n// }\n\nvoid test_median()\n{\n  #define avgfunc(a,b) (((a)+(b)+1.0)/2.0)\n  #define N 10\n  #define NTESTS 4\n  size_t arr[N], i, t, n;\n\n  arr[0] = 1; arr[1] = 5; arr[2] = 4;\n  TASSERT(gca_median2(arr, 0, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 0);\n  TASSERT(gca_median2(arr, 1, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 1);\n  TASSERT(gca_median2(arr, 2, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 3);\n  TASSERT(gca_median2(arr, 3, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 4);\n\n  TASSERT(gca_median_size(arr, 0) == 0);\n  TASSERT(gca_median_size(arr, 1) == 1);\n  TASSERT(gca_median_size(arr, 2) == 3);\n  TASSERT(gca_median_size(arr, 3) == 4);\n\n  // 7, 7, ... 7, 7\n  for(i = 0; i < N; i++) arr[i] = 7;\n  for(n = 1; n <= N; n++)\n    TASSERT(gca_median(arr, n, gca_cmp2_size, NULL, size_t, avgfunc) == 7);\n\n  // 0, 1, ... 8, 9\n  for(i = 0; i < N; i++) arr[i] = i;\n  TASSERT(gca_median2(arr, 0, gca_cmp2_size, NULL, size_t, avgfunc, SIZE_MAX) == SIZE_MAX);\n  TASSERT(gca_median2(arr, 0, gca_cmp2_size, NULL, size_t, avgfunc, 0) == 0);\n  TASSERT(gca_median(arr, 1, gca_cmp2_size, NULL, size_t, avgfunc) == 0);\n  TASSERT(gca_median(arr, 2, gca_cmp2_size, NULL, size_t, avgfunc) == 1);\n  TASSERT(gca_median(arr, 3, gca_cmp2_size, NULL, size_t, avgfunc) == 1);\n  TASSERT(gca_median(arr, 4, gca_cmp2_size, NULL, size_t, avgfunc) == 2);\n\n  for(t = 0; t < NTESTS; t++)\n  {\n    // (4 + 5) / 2 = 9/2 = 4.5 => 5\n    for(i = 0; i < N; i++) arr[i] = i;\n    gca_shuffle(arr, N, sizeof(arr[0]));\n    TASSERT(gca_median(arr, N, gca_cmp2_size, NULL, size_t, avgfunc) == 5);\n\n    // 0, 2, ... 16, 18\n    // (2*4 + 2*5) / 2 = (8+10) / 2 = 18/2 = 9\n    for(i = 0; i < N; i++) arr[i] = 2*i;\n    gca_shuffle(arr, N, sizeof(arr[0]));\n    TASSERT(gca_median(arr, N, gca_cmp2_size, NULL, size_t, avgfunc) == 9);\n\n    // 0, 3, ... 24, 27\n    // (3*4 + 3*5) / 2 = (12+15) / 2 = 27/2 = 13.5 => 14\n    for(i = 0; i < N; i++) arr[i] = 3*i;\n    gca_shuffle(arr, N, sizeof(arr[0]));\n    TASSERT(gca_median(arr, N, gca_cmp2_size, NULL, size_t, avgfunc) == 14);\n  }\n  #undef N\n}\n\n\nvoid check_permutation5(size_t **pp, size_t a, size_t b, size_t c, size_t d, size_t e,\n                        size_t *init)\n{\n  size_t *p = gca_itr_next(pp, 5, init);\n  TASSERT(p != NULL);\n  bool nxtpermut = p[0] == a && p[1] == b && p[2] == c && p[3] == d && p[4] == e;\n  TASSERT2(nxtpermut, \"%zu %zu %zu %zu %zu / %zu %zu %zu %zu %zu\\n\",\n           p[0], p[1], p[2], p[3], p[4], a, b, c, d, e);\n}\n\nvoid test_next_perm_with_dupes()\n{\n  status(\"Testing next permutation with duplicates...\");\n\n  size_t *p = NULL, init[] = {0,1,2,2,2};\n\n  check_permutation5(&p,0,1,2,2,2,init);\n  check_permutation5(&p,0,2,1,2,2,init);\n  check_permutation5(&p,0,2,2,1,2,init);\n  check_permutation5(&p,0,2,2,2,1,init);\n\n  check_permutation5(&p,1,0,2,2,2,init);\n  check_permutation5(&p,1,2,0,2,2,init);\n  check_permutation5(&p,1,2,2,0,2,init);\n  check_permutation5(&p,1,2,2,2,0,init);\n\n  check_permutation5(&p,2,0,1,2,2,init);\n  check_permutation5(&p,2,0,2,1,2,init);\n  check_permutation5(&p,2,0,2,2,1,init);\n  check_permutation5(&p,2,1,0,2,2,init);\n  check_permutation5(&p,2,1,2,0,2,init);\n  check_permutation5(&p,2,1,2,2,0,init);\n\n  check_permutation5(&p,2,2,0,1,2,init);\n  check_permutation5(&p,2,2,0,2,1,init);\n  check_permutation5(&p,2,2,1,0,2,init);\n  check_permutation5(&p,2,2,1,2,0,init);\n\n  check_permutation5(&p,2,2,2,0,1,init);\n  check_permutation5(&p,2,2,2,1,0,init);\n\n  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n  // check we can reset and loop back\n  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n  check_permutation5(&p,0,1,2,2,2,init);\n  check_permutation5(&p,0,2,1,2,2,init);\n\n  // Try iterating over set of 1s\n  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n  init[0] = init[1] = init[2] = init[3] = init[4] = 1;\n  check_permutation5(&p,1,1,1,1,1,init);\n  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n  check_permutation5(&p,1,1,1,1,1,init);\n\n  // Iterate over set of 1,1,1,7\n  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n  init[0] = init[1] = init[2] = init[3] = init[4] = 1;\n  init[4] = 7;\n  check_permutation5(&p,1,1,1,1,7,init);\n  check_permutation5(&p,1,1,1,7,1,init);\n  check_permutation5(&p,1,1,7,1,1,init);\n  check_permutation5(&p,1,7,1,1,1,init);\n  check_permutation5(&p,7,1,1,1,1,init);\n  TASSERT(gca_itr_next(&p, 5, init) == NULL);\n  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n  check_permutation5(&p,1,1,1,1,7,init);\n\n  free(p);\n}\n\nvoid test_next_permutation()\n{\n  status(\"Testing next permutation...\");\n\n  size_t i, n;\n  size_t *p = NULL;\n\n  check_permutation5(&p,0,1,2,3,4,NULL);\n  check_permutation5(&p,0,1,2,4,3,NULL);\n  check_permutation5(&p,0,1,3,2,4,NULL);\n  check_permutation5(&p,0,1,3,4,2,NULL);\n  check_permutation5(&p,0,1,4,2,3,NULL);\n  check_permutation5(&p,0,1,4,3,2,NULL);\n\n  check_permutation5(&p,0,2,1,3,4,NULL);\n  check_permutation5(&p,0,2,1,4,3,NULL);\n  check_permutation5(&p,0,2,3,1,4,NULL);\n  check_permutation5(&p,0,2,3,4,1,NULL);\n  check_permutation5(&p,0,2,4,1,3,NULL);\n  check_permutation5(&p,0,2,4,3,1,NULL);\n\n  check_permutation5(&p,0,3,1,2,4,NULL);\n  check_permutation5(&p,0,3,1,4,2,NULL);\n  check_permutation5(&p,0,3,2,1,4,NULL);\n  check_permutation5(&p,0,3,2,4,1,NULL);\n  check_permutation5(&p,0,3,4,1,2,NULL);\n  check_permutation5(&p,0,3,4,2,1,NULL);\n\n  check_permutation5(&p,0,4,1,2,3,NULL);\n  check_permutation5(&p,0,4,1,3,2,NULL);\n  check_permutation5(&p,0,4,2,1,3,NULL);\n  check_permutation5(&p,0,4,2,3,1,NULL);\n  check_permutation5(&p,0,4,3,1,2,NULL);\n  check_permutation5(&p,0,4,3,2,1,NULL);\n\n  //\n  check_permutation5(&p,1,0,2,3,4,NULL);\n  check_permutation5(&p,1,0,2,4,3,NULL);\n  check_permutation5(&p,1,0,3,2,4,NULL);\n  check_permutation5(&p,1,0,3,4,2,NULL);\n  check_permutation5(&p,1,0,4,2,3,NULL);\n  check_permutation5(&p,1,0,4,3,2,NULL);\n\n  check_permutation5(&p,1,2,0,3,4,NULL);\n  check_permutation5(&p,1,2,0,4,3,NULL);\n  check_permutation5(&p,1,2,3,0,4,NULL);\n  check_permutation5(&p,1,2,3,4,0,NULL);\n  check_permutation5(&p,1,2,4,0,3,NULL);\n  check_permutation5(&p,1,2,4,3,0,NULL);\n\n  check_permutation5(&p,1,3,0,2,4,NULL);\n  check_permutation5(&p,1,3,0,4,2,NULL);\n  check_permutation5(&p,1,3,2,0,4,NULL);\n  check_permutation5(&p,1,3,2,4,0,NULL);\n  check_permutation5(&p,1,3,4,0,2,NULL);\n  check_permutation5(&p,1,3,4,2,0,NULL);\n\n  check_permutation5(&p,1,4,0,2,3,NULL);\n  check_permutation5(&p,1,4,0,3,2,NULL);\n  check_permutation5(&p,1,4,2,0,3,NULL);\n  check_permutation5(&p,1,4,2,3,0,NULL);\n  check_permutation5(&p,1,4,3,0,2,NULL);\n  check_permutation5(&p,1,4,3,2,0,NULL);\n\n  //\n  check_permutation5(&p,2,0,1,3,4,NULL);\n  check_permutation5(&p,2,0,1,4,3,NULL);\n  check_permutation5(&p,2,0,3,1,4,NULL);\n  check_permutation5(&p,2,0,3,4,1,NULL);\n  check_permutation5(&p,2,0,4,1,3,NULL);\n  check_permutation5(&p,2,0,4,3,1,NULL);\n\n  check_permutation5(&p,2,1,0,3,4,NULL);\n  check_permutation5(&p,2,1,0,4,3,NULL);\n  check_permutation5(&p,2,1,3,0,4,NULL);\n  check_permutation5(&p,2,1,3,4,0,NULL);\n  check_permutation5(&p,2,1,4,0,3,NULL);\n  check_permutation5(&p,2,1,4,3,0,NULL);\n\n  check_permutation5(&p,2,3,0,1,4,NULL);\n  check_permutation5(&p,2,3,0,4,1,NULL);\n  check_permutation5(&p,2,3,1,0,4,NULL);\n  check_permutation5(&p,2,3,1,4,0,NULL);\n  check_permutation5(&p,2,3,4,0,1,NULL);\n  check_permutation5(&p,2,3,4,1,0,NULL);\n\n  check_permutation5(&p,2,4,0,1,3,NULL);\n  check_permutation5(&p,2,4,0,3,1,NULL);\n  check_permutation5(&p,2,4,1,0,3,NULL);\n  check_permutation5(&p,2,4,1,3,0,NULL);\n  check_permutation5(&p,2,4,3,0,1,NULL);\n  check_permutation5(&p,2,4,3,1,0,NULL);\n\n  //\n  check_permutation5(&p,3,0,1,2,4,NULL);\n  check_permutation5(&p,3,0,1,4,2,NULL);\n  check_permutation5(&p,3,0,2,1,4,NULL);\n  check_permutation5(&p,3,0,2,4,1,NULL);\n  check_permutation5(&p,3,0,4,1,2,NULL);\n  check_permutation5(&p,3,0,4,2,1,NULL);\n\n  check_permutation5(&p,3,1,0,2,4,NULL);\n  check_permutation5(&p,3,1,0,4,2,NULL);\n  check_permutation5(&p,3,1,2,0,4,NULL);\n  check_permutation5(&p,3,1,2,4,0,NULL);\n  check_permutation5(&p,3,1,4,0,2,NULL);\n  check_permutation5(&p,3,1,4,2,0,NULL);\n\n  check_permutation5(&p,3,2,0,1,4,NULL);\n  check_permutation5(&p,3,2,0,4,1,NULL);\n  check_permutation5(&p,3,2,1,0,4,NULL);\n  check_permutation5(&p,3,2,1,4,0,NULL);\n  check_permutation5(&p,3,2,4,0,1,NULL);\n  check_permutation5(&p,3,2,4,1,0,NULL);\n\n  check_permutation5(&p,3,4,0,1,2,NULL);\n  check_permutation5(&p,3,4,0,2,1,NULL);\n  check_permutation5(&p,3,4,1,0,2,NULL);\n  check_permutation5(&p,3,4,1,2,0,NULL);\n  check_permutation5(&p,3,4,2,0,1,NULL);\n  check_permutation5(&p,3,4,2,1,0,NULL);\n\n  //\n  check_permutation5(&p,4,0,1,2,3,NULL);\n  check_permutation5(&p,4,0,1,3,2,NULL);\n  check_permutation5(&p,4,0,2,1,3,NULL);\n  check_permutation5(&p,4,0,2,3,1,NULL);\n  check_permutation5(&p,4,0,3,1,2,NULL);\n  check_permutation5(&p,4,0,3,2,1,NULL);\n\n  check_permutation5(&p,4,1,0,2,3,NULL);\n  check_permutation5(&p,4,1,0,3,2,NULL);\n  check_permutation5(&p,4,1,2,0,3,NULL);\n  check_permutation5(&p,4,1,2,3,0,NULL);\n  check_permutation5(&p,4,1,3,0,2,NULL);\n  check_permutation5(&p,4,1,3,2,0,NULL);\n\n  check_permutation5(&p,4,2,0,1,3,NULL);\n  check_permutation5(&p,4,2,0,3,1,NULL);\n  check_permutation5(&p,4,2,1,0,3,NULL);\n  check_permutation5(&p,4,2,1,3,0,NULL);\n  check_permutation5(&p,4,2,3,0,1,NULL);\n  check_permutation5(&p,4,2,3,1,0,NULL);\n\n  check_permutation5(&p,4,3,0,1,2,NULL);\n  check_permutation5(&p,4,3,0,2,1,NULL);\n  check_permutation5(&p,4,3,1,0,2,NULL);\n  check_permutation5(&p,4,3,1,2,0,NULL);\n  check_permutation5(&p,4,3,2,0,1,NULL);\n  check_permutation5(&p,4,3,2,1,0,NULL);\n\n  TASSERT(gca_itr_next(&p, 5, NULL) == NULL);\n  TASSERT(gca_itr_next(&p, 5, NULL) == NULL);\n  TASSERT(gca_itr_next(&p, 5, NULL) == NULL);\n\n  TASSERT(gca_itr_reset(p, 5) == p && p != NULL);\n  check_permutation5(&p,0,1,2,3,4,NULL);\n  check_permutation5(&p,0,1,2,4,3,NULL);\n\n  free(p);\n  p = NULL;\n\n  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n  TASSERT(p[0] == 0 && p[1] == 1);\n  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n  TASSERT(p[0] == 1 && p[1] == 0);\n  TASSERT(gca_itr_next(&p, 2, NULL) == NULL);\n  TASSERT(gca_itr_next(&p, 2, NULL) == NULL);\n\n  p = gca_itr_reset(p, 2);\n  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n  TASSERT(p[0] == 0 && p[1] == 1);\n  TASSERT(gca_itr_next(&p, 2, NULL) == p);\n  TASSERT(p[0] == 1 && p[1] == 0);\n  free(p);\n\n  // Test init various lengths\n  for(n = 0; n < 5; n++)\n  {\n    p = gca_itr_reset(NULL, n);\n    TASSERT(gca_itr_next(&p, n, NULL) == (n ? p : NULL));\n    for(i = 0; i < n; i++) TASSERT(p[i] == i);\n    // reuse\n    p = gca_itr_reset(p, n);\n    TASSERT(gca_itr_next(&p, n, NULL) == (n ? p : NULL));\n    for(i = 0; i < n; i++) TASSERT(p[i] == i);\n    free(p);\n\n    // initialise without gca_itr_reset()\n    p = NULL;\n    TASSERT(gca_itr_next(&p, n, NULL) == (n ? p : NULL));\n    for(i = 0; i < n; i++) TASSERT(p[i] == i);\n    free(p);\n  }\n}\n\n#define strhash_fast_mix(h,x) ((h) * 37 + (x))\n#define rotl32(h,r) ((h)<<(r)|(h)>>(32-(r)))\n\nstatic inline uint32_t get_rand_seed()\n{\n  struct timeval now;\n  gettimeofday(&now, NULL);\n\n  uint32_t h = rand();\n  h = strhash_fast_mix(h, rotl32((uint32_t)now.tv_sec,  h & 31));\n  h = strhash_fast_mix(h, rotl32((uint32_t)now.tv_usec, h & 31));\n  h = strhash_fast_mix(h, (uint32_t)getpid());\n  return h;\n}\n\nint main()\n{\n  uint32_t seed32 = get_rand_seed();\n  srand48(seed32);\n  srand(seed32);\n  status(\"Random seed = %u\", seed32);\n\n  status(\"Running tests...\");\n  test_round();\n  test_GCD();\n  test_cycle();\n  test_reverse();\n  test_bsearch();\n  test_quicksort();\n  test_quickpartition();\n  test_quickselect();\n  test_heapsort();\n  test_median5();\n  test_median();\n  test_next_permutation();\n  test_next_perm_with_dupes();\n  status(\"Passed: %zu / %zu (%s)\", num_tests_run-num_tests_failed, num_tests_run,\n         !num_tests_failed ? \"All\" : (num_tests_failed<num_tests_run ? \"Some\" : \"None\"));\n  status(\"Done.\");\n\n  return num_tests_failed ? -1 : 0;\n}\n","numLines":733,"startLine":1,"totalLines":733}}}
