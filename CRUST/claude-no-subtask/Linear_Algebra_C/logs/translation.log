30\t\n131\tvector* getColVector(matrix* m, int j){\n132\t    assert(assertMatrix(m) && j >= 0 && j < m->cols);\n133\t    double* col = (double*) malloc(sizeof(double) * m->rows);\n134\t    for(int i = 0; i < m->rows; i++){\n135\t        col[i] = m->data[i * m->cols + j];\n136\t    }\n137\t    vector* v = newVector(col, m->rows);\n138\t    free(col);\n139\t    return v;\n140\t}\n141\t\n142\tvector* getMainDiagonal(matrix* m){\n143\t    assert(isSquareMatrix(m));\n144\t    double* diag = (double*) malloc(sizeof(double) * m->rows);\n145\t    for(int x = 0; x < m->rows; x++){\n146\t        diag[x] = m->data[x * m->cols + x];\n147\t    }\n148\t    vector* v = newVector(diag, m->rows);\n149\t    free(diag);\n150\t    return v;\n151\t}\n152\t\n153\tvoid setMainDiagonal(matrix* m, vector* v){\n154\t    assert(isSquareMatrix(m) && assertVector(v) && m->rows == m->cols && m->cols == v->cols);\n155\t    for(int x = 0; x < v->cols; x++){\n156\t        m->data[x * m->cols + x] = v->data[x];\n157\t    }\n158\t}\n159\t\n160\tvector* getAntiDiagonal(matrix* m){\n161\t    assert(isSquareMatrix(m));\n162\t    int x = 0;\n163\t    double* diag = (double*) malloc(sizeof(double) * m->rows);\n164\t    for(int i = m->rows-1; i >= 0; i--){\n165\t        for(int j = m->cols-1; j >= 0; j--){\n166\t            if(i + j == m->rows-1){\n167\t                diag[x++] = m->data[i * m->cols + j];\n168\t                if(x == m->rows){\n169\t                    break;\n170\t                }\n171\t            }\n172\t        }\n173\t    }\n174\t    vector* v = newVector(diag, m->rows);\n175\t    free(diag);\n176\t    return v;\n177\t}\n178\t\n179\tvoid setAntiDiagonal(matrix*m, vector* v){\n180\t    assert(isSquareMatrix(m) && assertVector(v) && m->rows == m->cols && m->cols == v->cols);\n181\t    int idx = 0;\n182\t    for(int i = m->rows-1; i >= 0; i--){\n183\t        for(int j = m->cols-1; j >= 0; j--){\n184\t            if(i + j == m->rows-1){\n185\t                m->data[i * m->cols + j] = v->data[idx++];\n186\t                if(idx == m->rows){\n187\t                    break;\n188\t                }\n189\t            }\n190\t        }\n191\t    }\n192\t}\n193\t\n194\tdouble diagonalProduct(matrix*m){\n195\t    vector* diagonal = getMainDiagonal(m);\n196\t    double product = 1.0;\n197\t    for(int i = 0; i < diagonal->cols; i++){\n198\t        product *= diagonal->data[i];\n199\t    }\n200\t    deleteVector(diagonal);\n201\t    return product;\n202\t}\n203\t\n204\tbool isMatrixEqual(matrix* m, matrix* n){\n205\t    assert(assertMatrix(m) && assertMatrix(n));\n206\t    if(m->rows != n->rows || m->cols != n->cols){\n207\t        return false;\n208\t    }\n209\t    for(int i = 0; i < m->rows; i++){\n210\t        for(int j = 0; j < m->cols; j++){\n211\t            if(m->data[i * m->cols + j] != n->data[i * n->cols + j]){\n212\t                return false;\n213\t            }\n214\t        }\n215\t    }\n216\t    return true;\n217\t}\n218\t\n219\tbool hasSameDimensions(matrix* m, matrix* n){\n220\t    assert(assertMatrix(m) && assertMatrix(n));\n221\t    return (m->rows == n->rows) && (m->cols == n->cols);\n222\t}\n223\t\n224\tbool isZeroMatrix(matrix* m){\n225\t    assertMatrix(m);\n226\t    for(int i = 0; i < m->rows; i++){\n227\t        for(int j = 0; j < m->cols; j++){\n228\t            if(m->data[i * m->cols + j] != 0){\n229\t                return false;\n230\t            }\n231\t        }\n232\t    }\n233\t    return true;\n234\t}\n235\t\n236\tbool isIdentityMatrix(matrix* m){\n237\t    if(!isSquareMatrix(m)){\n238\t        return false;\n239\t    }\n240\t    for(int i = 0; i < m->rows; i++){\n241\t        for(int j = 0; j < m->cols; j++){\n242\t            if(i == j && m->data[i * m->cols + j] != 1.0){\n243\t                return false;\n244\t            } else if(i != j && m->data[i * m->cols + j] != 0.0) {\n245\t                return false;\n246\t            }\n247\t        }\n248\t    }\n249\t    return true;\n250\t}\n251\t\n252\tbool isSquareMatrix(matrix* m){\n253\t    assertMatrix(m);\n254\t    return (m->rows == m->cols);\n255\t}\n256\t\n257\tbool isInvertible(matrix* m){\n258\t    return isSquareMatrix(m) && determinant(m) != 0;\n259\t}\n260\t\n261\tbool isDiagonalMatrix(matrix* m){\n262\t    assert(isSquareMatrix(m));\n263\t    for(int i = 0; i < m->rows; i++){\n264\t        for(int j = 0; j < m->cols; j++){\n265\t            if(i != j && m->data[i * m->cols + j] != 0){\n266\t                return false;\n267\t            }\n268\t        }\n269\t    }\n270\t    return true;\n271\t}\n272\t\n273\tbool isTriangularMatrix(matrix* m){\n274\t    assert(isSquareMatrix(m));\n275\t    return exclusiveOr(isUpTriMatrix(m), isLoTriMatrix(m));\n276\t}\n277\t\n278\tbool isUpTriMatrix(matrix* m){\n279\t    assert(isSquareMatrix(m));\n280\t    for(int i = 0; i < m->rows; i++){\n281\t        for(int j = 0; j < i; j++){\n282\t            if(m->data[i * m->cols + j] != 0){\n283\t                return false;\n284\t            }\n285\t        }\n286\t    }\n287\t    return true;\n288\t}\n289\t\n290\tbool isLoTriMatrix(matrix* m){\n291\t    assert(isSquareMatrix(m));\n292\t    for(int i = 0; i < m->rows; i++){\n293\t        for(int j = i+1; j < m->cols; j++){\n294\t            if(m->data[i * m->cols + j] != 0){\n295\t                return false;\n296\t            }\n297\t        }\n298\t    }\n299\t    return true;\n300\t}\n301\t\n302\tbool isMatrixSymmetric(matrix* m){\n303\t    matrix* t = transposeMatrix(m);\n304\t    bool equal = isMatrixEqual(m, t);\n305\t    deleteMatrix(t);\n306\t    return equal;\n307\t}\n308\t\n309\tbool hasZeroRow(matrix* m){\n310\t    assertMatrix(m);\n311\t    bool allZeroes = true;\n312\t    for(int i = 0; i < m->rows; i++){\n313\t        for(int j = 0; j < m->cols; j++){\n314\t            if(m->data[i * m->cols + j] != 0){\n315\t                allZeroes = false;\n316\t            }\n317\t        }\n318\t        if(allZeroes){\n319\t            return true;\n320\t        }\n321\t        allZeroes = true;\n322\t    }\n323\t    return false;\n324\t}\n325\t\n326\tbool hasZeroCol(matrix* m){\n327\t    assertMatrix(m);\n328\t    bool allZeroes = true;\n329\t    for(int j = 0; j < m->rows; j++){\n330\t        for(int i = 0; i < m->cols; i++){\n331\t            if(m->data[i * m->cols + j] != 0){\n332\t                allZeroes = false;\n333\t            }\n334\t        }\n335\t        if(allZeroes){\n336\t            return true;\n337\t        }\n338\t        allZeroes = true;\n339\t    }\n340\t    return false;\n341\t}\n342\t\n343\tdouble determinant(matrix* m){\n344\t    assert(isSquareMatrix(m));\n345\t    switch(m->rows){  // use leibniz and laplace for smaller matrices\n346\t        case 1: return m->data[0];\n347\t        case 2: return (m->data[0] * m->data[3]) - (m->data[1] * m->data[2]);\n348\t        case 3: return (m->data[0]*((m->data[4]*m->data[8])-(m->data[5]*m->data[7]))) -\n349\t                       (m->data[1]*((m->data[3]*m->data[8])-(m->data[5]*m->data[6]))) +\n350\t                       (m->data[2]*((m->data[3]*m->data[7])-(m->data[4]*m->data[6]))) ;\n351\t    }\n352\t    if(isTriangularMatrix(m)){\n353\t        return diagonalProduct(m);\n354\t    }\n355\t    matrix* l = NULL;\n356\t    matrix* u = NULL;\n357\t    matrix* p = NULL;\n358\t    // det(permutation matrix) = (-1)^swaps\n359\t    double det = pow(-1, luDecomposition(m,&l,&u,&p)-1) * determinant(l) * determinant(u);\n360\t    deleteMatrix(p);\n361\t    deleteMatrix(u);\n362\t    deleteMatrix(l);\n363\t    return det;\n364\t}\n365\t\n366\tmatrix* transposeMatrix(matrix* m){\n367\t    assertMatrix(m);\n368\t    matrix* t = zeroMatrix(m->cols, m->rows);\n369\t    for(int i = 0; i < m->rows; i++){\n370\t        for(int j = 0; j < m->cols; j++){\n371\t            t->data[j * t->cols + i] = m->data[i * m->cols + j];\n372\t        }\n373\t    }\n374\t    return t;\n375\t}\n376\t\n377\tdouble traceMatrix(matrix* m){\n378\t    assert(isSquareMatrix(m));\n379\t    double trace = 0;\n380\t    for(int i = 0; i < m->rows; i++){\n381\t        trace += m->data[i * m->cols + i];\n382\t    }\n383\t    return trace;\n384\t}\n385\t\n386\tmatrix* addMatrices(matrix* m, matrix* n){\n387\t    assert(hasSameDimensions(m, n));\n388\t    matrix* sum = nullMatrix(m->rows, m->cols);\n389\t    int idx = 0;\n390\t    for(int i = 0; i < m->rows; i++){\n391\t        for(int j = 0; j < m->cols; j++){\n392\t            sum->data[idx] = m->data[idx] + n->data[idx];\n393\t            idx++;\n394\t        }\n395\t    }\n396\t    return sum;\n397\t}\n398\t\n399\tmatrix* powMatrix(matrix* m, double k){\n400\t    assertMatrix(m);\n401\t    matrix* p = nullMatrix(m->rows, m->cols);\n402\t    for(int i = 0; i < m->rows; i++){\n403\t        for(int j = 0; j < m->cols; j++){\n404\t            p->data[i * m->cols + j] = pow(m->data[i * m->cols + j], k);\n405\t        }\n406\t    }\n407\t    return p;\n408\t}\n409\t\n410\tmatrix* multiplyMatrices(matrix* m, matrix* n){\n411\t    assert(assertMatrix(m) && assertMatrix(n) && m->cols == n->cols && m->rows == n->rows);\n412\t    matrix* prod = nullMatrix(m->rows, m->cols);\n413\t    for(int j = 0; j < m->rows; j++){\n414\t        for(int i = 0; i < m->cols; i++){\n415\t            double val = 0.0;\n416\t            for(int k = 0; k < m->cols; k++){\n417\t                val += ((m->data[i * m->cols + k] * n->data[k * m->cols + j]));\n418\t            }\n419\t            prod->data[i * m->cols + j] = val;\n420\t        }\n421\t    }\n422\t    return prod;\n423\t}\n424\t\n425\tmatrix* scaleMatrix(matrix* m, double s){\n426\t    assertMatrix(m);\n427\t    matrix* scaled = nullMatrix(m->rows, m->cols);\n428\t    for(int i = 0; i < m->rows; i++){\n429\t        for(int j = 0; j < m->cols; j++){\n430\t            scaled->data[i * m->cols + j] = m->data[i * m->cols + j] * s;\n431\t        }\n432\t    }\n433\t    return scaled;\n434\t}\n435\t\n436\tmatrix* subMatrix(matrix* m, int i, int j){\n437\t    assert(assertMatrix(m) && i >= 0 && i < m->rows && j >= 0 && j < m->cols);\n438\t    matrix* sm = nullMatrix(m->rows-1,m->cols-1);\n439\t    int idx = 0;\n440\t    for(int row = 0; row < m->rows; row++){\n441\t        for(int col = 0; col < m->cols; col++){\n442\t            if(row != i && col != j){\n443\t                sm->data[idx++] = m->data[row * m->cols + col];\n444\t            }\n445\t        }\n446\t    }\n447\t    return sm;\n448\t}\n449\t\n450\tdouble elementMinor(matrix* m, int i, int j){\n451\t    matrix* sm = subMatrix(m,i,j);\n452\t    double minor = determinant(sm);\n453\t    deleteMatrix(sm);\n454\t    return minor;\n455\t}\n456\t\n457\tmatrix* matrixMinor(matrix* m){\n458\t    assertMatrix(m);\n459\t    matrix* mm = nullMatrix(m->rows, m->cols);\n460\t    for(int i = 0; i < mm->rows; i++){\n461\t        for(int j = 0; j < mm->cols; j++){\n462\t            mm->data[i * mm->cols + j] = elementMinor(m,i,j);\n463\t        }\n464\t    }\n465\t    return mm;\n466\t}\n467\t\n468\tdouble elementCofactor(matrix* m, int i, int j){\n469\t    return pow(-1, (i+1)+(j+1)) * elementMinor(m, i, j);\n470\t}\n471\t\n472\tmatrix* matrixCofactor(matrix* m){\n473\t    assertMatrix(m);\n474\t    matrix* cfm = nullMatrix(m->rows, m->cols);\n475\t    for(int i = 0; i < cfm->rows; i++){\n476\t        for(int j = 0; j < cfm->cols; j++){\n477\t            cfm->data[i * cfm->cols + j] = elementCofactor(m,i,j);\n478\t        }\n479\t    }\n480\t    return cfm;\n481\t}\n482\t\n483\tmatrix* signMatrix(int rows, int cols){\n484\t    assert(rows > 0 && cols > 0);\n485\t    matrix* sm = nullMatrix(rows, cols);\n486\t    fillMatrix(&sm, 1);\n487\t    for(int i = 0; i < sm->rows; i++){\n488\t        for(int j = 0; j < sm->cols; j++){\n489\t            sm->data[i * sm->cols + j] = (((i * sm->cols + j)+1) % 2) ? 1 : -1;\n490\t        }\n491\t    }\n492\t    return sm;\n493\t}\n494\t\n495\tmatrix* adjugateMatrix(matrix* m){\n496\t    assertMatrix(m);\n497\t    matrix* mm = matrixMinor(m);\n498\t    matrix* sign = signMatrix(m->rows, m->cols);\n499\t    matrix* adj = multiplyMatrices(mm, sign);\n500\t    deleteMatrix(sign);\n501\t    deleteMatrix(mm);\n502\t    return adj;\n503\t}\n504\t\n505\tint luDecomposition(matrix* m, matrix** l, matrix** u, matrix** p){\n506\t    assert(isSquareMatrix(m) && *l == NULL && *u == NULL && *p == NULL);\n507\t    int n = m->cols;\n508\t    int swaps = 0;\n509\t    *l = zeroMatrix(n, n);\n510\t    *u = zeroMatrix(n, n);\n511\t    *p = pivotMatrix(m, &swaps);\n512\t    matrix* m2 = multiplyMatrices(*p,m);\n513\t    for(int j = 0; j < n; j++){\n514\t        (*l)->data[j * n + j] = 1;\n515\t        for(int i = 0; i < j+1; i++){\n516\t            double sumU = 0;\n517\t            for(int k = 0; k < i; k++){\n518\t                sumU += ((*u)->data[k * n + j] * (*l)->data[i * n + k]);\n519\t            }\n520\t            (*u)->data[i * n + j] = m2->data[i * n + j] - sumU;\n521\t        }\n522\t        for(int i = j; i < n; i++){\n523\t            double sumL = 0;\n524\t            for(int k = 0; k < j; k++){\n525\t                sumL += ((*u)->data[k * n + j] * (*l)->data[i * n + k]);\n526\t            }\n527\t            (*l)->data[i * n + j] = (m2->data[i * n + j] - sumL) / (*u)->data[j * n + j];\n528\t        }\n529\t    }\n530\t    deleteMatrix(m2);\n531\t    return swaps;\n532\t}\n533\t\n534\tmatrix* inverseMatrix(matrix* m){\n535\t    assert(isInvertible(m));\n536\t    matrix* adj = adjugateMatrix(m);\n537\t    matrix* inv = scaleMatrix(adj,(1.0/determinant(m)));\n538\t    deleteMatrix(adj);\n539\t    return inv;\n540\t}\n541\t\n542\tmatrix* pivotMatrix(matrix* m, int* swaps){\n543\t    assert(isSquareMatrix(m));\n544\t    int n = m->cols;\n545\t    matrix* pivot = identityMatrix(n);\n546\t    for(int i = 0; i < n; i++){\n547\t        double max = m->data[i * n + i];\n548\t        int row = i;\n549\t        for(int j = i; j < n; j++){\n550\t            if(m->data[j * n + i] > max){\n551\t                max = m->data[j * n + i];\n552\t                row = j;\n553\t            }\n554\t        }\n555\t        if(i != row){\n556\t            vector* v = getRowVector(pivot, i);\n557\t            vector* w = getRowVector(pivot, row);\n558\t            setRowVector(pivot, i, w);\n559\t            setRowVector(pivot, row, v);\n560\t            deleteVector(w);\n561\t            deleteVector(v);\n562\t            swaps++;\n563\t        }\n564\t    }\n565\t    return pivot;\n566\t}\n567\t\n568\tvoid printMatrix(matrix* m, bool includeIndices){\n569\t    assertMatrix(m);\n570\t    for(int i = 0; i < m->rows; i++){\n571\t        for(int j = 0; j < m->cols; j++){\n572\t            if(includeIndices){\n573\t                printf(\"[%d,%d] -> \", i, j);\n574\t            }\n575\t            printf(\"%8.2f \", m->data[i * m->cols + j]);\n576\t        }\n577\t        if(i < m->rows){\n578\t            printf(\"\\n\");\n579\t        }\n580\t    }\n581\t}\n582\t\n583\tmatrix* scaleNSpace(matrix* m, double k){\n584\t    assert(isSquareMatrix(m));\n585\t    matrix* n = zeroMatrix(m->cols,m->cols);\n586\t    vector* v = zeroVector(m->cols);\n587\t    fillVector(&v, k);\n588\t    setMainDiagonal(n, v);\n589\t    matrix* ref = multiplyMatrices(m, n);\n590\t    deleteVector(v);\n591\t    deleteMatrix(n);\n592\t    return ref;\n593\t}\n594\t\n595\tmatrix* reflectAxis2D(matrix* m, int axis){\n596\t    assert(isSquareMatrix(m) && m->cols == 2);\n597\t    matrix* n = zeroMatrix(2,2);\n598\t    setMatrixElement(n,0,0,(axis) ? 1 : -1);\n599\t    setMatrixElement(n,1,1,(axis) ? -1 : 1);\n600\t    matrix* ref = multiplyMatrices(m, n);\n601\t    deleteMatrix(n);\n602\t    return ref;\n603\t}\n604\t\n605\tmatrix* reflectAxis3D(matrix* m, int axis){\n606\t    assert(isSquareMatrix(m) && m->cols == 3 && axis >= 0 && axis <= 2);\n607\t    matrix* n = nullMatrix(3,3);\n608\t    if(axis == 0){\n609\t        double data[9] = {1,0,0,0,1,0,0,0,-1}; // XY\n610\t        setMainDiagonal(m, newVector(data, 3)); \n611\t    } else if(axis == 1){\n612\t        double data[9] = {1,0,0,0,-1,0,0,0,1}; // XZ\n613\t        setMainDiagonal(m, newVector(data, 3)); \n614\t    } else{\n615\t        double data[9] = {-1,0,0,0,1,0,0,0,1}; // YZ\n616\t        setMainDiagonal(m, newVector(data, 3)); \n617\t    }\n618\t    matrix* ref = multiplyMatrices(m, n);\n619\t    deleteMatrix(n);\n620\t    return ref;\n621\t}\n622\t\n623\tmatrix* orthProj2D(matrix* m, int axis){\n624\t    assert(isSquareMatrix(m) && m->cols == 2);\n625\t    matrix* n = zeroMatrix(2,2);\n626\t    setMatrixElement(n,axis,axis,1);\n627\t    matrix* ref = multiplyMatrices(m,n);\n628\t    deleteMatrix(n);\n629\t    return ref;\n630\t}\n631\t\n632\tmatrix* orthProj3D(matrix* m, int axis){\n633\t    assert(isSquareMatrix(m) && m->cols == 3);\n634\t    matrix* n = zeroMatrix(3,3);\n635\t    switch(axis){\n636\t        case 0: // XY plane\n637\t            setMatrixElement(n,0,0,1);\n638\t            setMatrixElement(n,1,1,1); \n639\t            break;\n640\t        case 1: // XZ plane\n641\t            setMatrixElement(n,0,0,1); \n642\t            setMatrixElement(n,2,2,1);\n643\t            break;\n644\t        case 2: // YZ plane\n645\t            setMatrixElement(n,1,1,1);\n646\t            setMatrixElement(n,2,2,1);\n647\t            break;\n648\t    }\n649\t    matrix* ref = multiplyMatrices(m, n);\n650\t    deleteMatrix(n);\n651\t    return ref;\n652\t}\n653\t\n654\tmatrix* shear2D(matrix* m, double k, int axis){\n655\t    assert(isSquareMatrix(m) && m->cols == 2);\n656\t    matrix* n = zeroMatrix(2,2);\n657\t    setMatrixElement(n,0,0,1);\n658\t    setMatrixElement(n,0,1,(axis) ? k : 0);\n659\t    setMatrixElement(n,1,0,(axis) ? 0 : k);\n660\t    setMatrixElement(n,1,1,1);\n661\t    matrix* sheared = multiplyMatrices(m,n);\n662\t    deleteMatrix(n);\n663\t    return sheared;\n664\t}\n665\t\n666\tmatrix* rotate3D(matrix* m, double theta, int axis){\n667\t    assert(isSquareMatrix(m) && m->cols == 3);\n668\t    matrix* n = zeroMatrix(3,3);\n669\t    switch(axis){\n670\t        case 0: // X\n671\t            setMatrixElement(n,0,0,1);\n672\t            setMatrixElement(n,1,0,cos(theta));\n673\t            setMatrixElement(n,1,1,-sin(theta));\n674\t            setMatrixElement(n,2,1,sin(theta));\n675\t            setMatrixElement(n,2,2,cos(theta));\n676\t            break;\n677\t        case 1: // Y\n678\t            setMatrixElement(n,0,0,cos(theta));\n679\t            setMatrixElement(n,1,2,sin(theta));\n680\t            setMatrixElement(n,1,1,1);\n681\t            setMatrixElement(n,2,0,-sin(theta));\n682\t            setMatrixElement(n,2,2,cos(theta));\n683\t            break;\n684\t        case 2: // Z\n685\t            setMatrixElement(n,0,0,cos(theta));\n686\t            setMatrixElement(n,0,1,-sin(theta));\n687\t            setMatrixElement(n,2,0,sin(theta));\n688\t            setMatrixElement(n,2,1,cos(theta));\n689\t            setMatrixElement(n,2,2,1);\n690\t            break;\n691\t    }\n692\t    matrix* ref = multiplyMatrices(m, n);\n693\t    deleteMatrix(n);\n694\t    return ref;\n695\t}"}]},"parent_tool_use_id":null,"session_id":"25ec8ece-d33e-4649-a4d0-70423d5aff72","uuid":"90e2cf4c-802c-472f-9683-01a6aa6c0b07","timestamp":"2026-06-05T20:43:39.887Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-vubWYH/project/c_src/matrix.c","content":"#include \"linear-algebra.h\"\n\n\nbool assertMatrix(matrix* m){\n    assert(m != NULL && m->data != NULL);\n    return true;\n}\n\nmatrix* newMatrix(double* d, int rows, int cols){\n    assert(d != NULL && rows > 0 && cols > 0);\n    matrix* m = nullMatrix(rows, cols);\n    int idx = 0;\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            m->data[i * m->cols + j] = d[idx++];\n        }\n    }\n    return m;\n}\n\nmatrix* nullMatrix(int rows, int cols){\n    assert(rows > 0 && cols > 0);\n    matrix* m = (matrix*) malloc(sizeof(matrix));\n    m->rows = rows;\n    m->cols = cols;\n    m->data = (double*) malloc(rows * cols * sizeof(double));\n    return m;\n}\n\nmatrix* zeroMatrix(int rows, int cols){\n    matrix* m = nullMatrix(rows, cols);\n    fillMatrix(&m, 0);\n    return m;\n}\n\nvoid fillMatrix(matrix** m, double n){\n    assertMatrix(*m);\n    for(int i = 0; i < (*m)->rows; i++){\n        for(int j = 0; j < (*m)->cols; j++){\n            (*m)->data[i * (*m)->cols + j] = n;\n        }\n    }\n}\n\nmatrix* identityMatrix(int n){\n    matrix* m = zeroMatrix(n, n);\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->rows; j++){\n            if(i == j){\n                m->data[i * m->cols + j] = 1;\n            }\n        }\n    }\n    return m;\n}\n\nvoid deleteMatrix(matrix* m){\n    free(m->data);\n    m->data = NULL;\n    free(m);\n    m = NULL;\n}\n\nmatrix* copyMatrix(matrix* m){\n    assertMatrix(m);\n    matrix* c = zeroMatrix(m->rows, m->cols);\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            c->data[i * m->cols + j] = m->data[i * m->cols + j];\n        }\n    }\n    return c;\n}\n\nvector* flattenMatrix(matrix* m){\n    assertMatrix(m);\n    vector* flat = nullVector(m->rows * m->cols);\n    int idx = 0;\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            flat->data[idx++] = m->data[i * m->cols + j];\n        }\n    }\n    return flat;\n}\n\nint matrixSize(matrix* m){\n    assertMatrix(m);\n    return m->rows * m->cols;\n}\n\nint matrixSizeBytes(matrix* m){\n    return sizeof(double) * matrixSize(m);\n}\n\nvoid setMatrixElement(matrix* m, int i, int j, double s){\n    assert(assertMatrix(m) && i >= 0 && j >= 0 && i < m->rows && j < m->cols);\n    m->data[i * m->cols + j] = s;\n}\n\ndouble getMatrixElement(matrix* m, int i, int j){\n    assert(assertMatrix(m) && i >= 0 && j >= 0 && i < m->rows && j < m->cols);\n    return m->data[i * m->cols + j];\n}\n\nvoid setRowVector(matrix* m, int i, vector* v){\n    assert(assertMatrix(m) && assertVector(v) && i >= 0 && i < m->rows);\n    for(int j = 0; j < v->cols; j++){\n        m->data[i * m->cols + j] = v->data[j];\n    }\n}\n\nvector* getRowVector(matrix* m, int i){\n    assert(assertMatrix(m) && i >= 0 && i < m->rows);\n    double* row = (double*) malloc(sizeof(double) * m->cols);\n    for(int j = 0; j < m->cols; j++){\n        row[j] = m->data[i * m->cols + j];\n    }\n    vector* v = newVector(row, m->cols);\n    free(row);\n    return v;\n}\n\nvoid setColVector(matrix* m, int j, vector* v){\n    assert(assertMatrix(m) && assertVector(v) && j >= 0 && j < m->cols);\n    for(int i = 0; i < v->cols; i++){\n        m->data[i * m->cols + j] = v->data[i];\n    }\n}\n\nvector* getColVector(matrix* m, int j){\n    assert(assertMatrix(m) && j >= 0 && j < m->cols);\n    double* col = (double*) malloc(sizeof(double) * m->rows);\n    for(int i = 0; i < m->rows; i++){\n        col[i] = m->data[i * m->cols + j];\n    }\n    vector* v = newVector(col, m->rows);\n    free(col);\n    return v;\n}\n\nvector* getMainDiagonal(matrix* m){\n    assert(isSquareMatrix(m));\n    double* diag = (double*) malloc(sizeof(double) * m->rows);\n    for(int x = 0; x < m->rows; x++){\n        diag[x] = m->data[x * m->cols + x];\n    }\n    vector* v = newVector(diag, m->rows);\n    free(diag);\n    return v;\n}\n\nvoid setMainDiagonal(matrix* m, vector* v){\n    assert(isSquareMatrix(m) && assertVector(v) && m->rows == m->cols && m->cols == v->cols);\n    for(int x = 0; x < v->cols; x++){\n        m->data[x * m->cols + x] = v->data[x];\n    }\n}\n\nvector* getAntiDiagonal(matrix* m){\n    assert(isSquareMatrix(m));\n    int x = 0;\n    double* diag = (double*) malloc(sizeof(double) * m->rows);\n    for(int i = m->rows-1; i >= 0; i--){\n        for(int j = m->cols-1; j >= 0; j--){\n            if(i + j == m->rows-1){\n                diag[x++] = m->data[i * m->cols + j];\n                if(x == m->rows){\n                    break;\n                }\n            }\n        }\n    }\n    vector* v = newVector(diag, m->rows);\n    free(diag);\n    return v;\n}\n\nvoid setAntiDiagonal(matrix*m, vector* v){\n    assert(isSquareMatrix(m) && assertVector(v) && m->rows == m->cols && m->cols == v->cols);\n    int idx = 0;\n    for(int i = m->rows-1; i >= 0; i--){\n        for(int j = m->cols-1; j >= 0; j--){\n            if(i + j == m->rows-1){\n                m->data[i * m->cols + j] = v->data[idx++];\n                if(idx == m->rows){\n                    break;\n                }\n            }\n        }\n    }\n}\n\ndouble diagonalProduct(matrix*m){\n    vector* diagonal = getMainDiagonal(m);\n    double product = 1.0;\n    for(int i = 0; i < diagonal->cols; i++){\n        product *= diagonal->data[i];\n    }\n    deleteVector(diagonal);\n    return product;\n}\n\nbool isMatrixEqual(matrix* m, matrix* n){\n    assert(assertMatrix(m) && assertMatrix(n));\n    if(m->rows != n->rows || m->cols != n->cols){\n        return false;\n    }\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            if(m->data[i * m->cols + j] != n->data[i * n->cols + j]){\n                return false;\n            }\n        }\n    }\n    return true;\n}\n\nbool hasSameDimensions(matrix* m, matrix* n){\n    assert(assertMatrix(m) && assertMatrix(n));\n    return (m->rows == n->rows) && (m->cols == n->cols);\n}\n\nbool isZeroMatrix(matrix* m){\n    assertMatrix(m);\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            if(m->data[i * m->cols + j] != 0){\n                return false;\n            }\n        }\n    }\n    return true;\n}\n\nbool isIdentityMatrix(matrix* m){\n    if(!isSquareMatrix(m)){\n        return false;\n    }\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            if(i == j && m->data[i * m->cols + j] != 1.0){\n                return false;\n            } else if(i != j && m->data[i * m->cols + j] != 0.0) {\n                return false;\n            }\n        }\n    }\n    return true;\n}\n\nbool isSquareMatrix(matrix* m){\n    assertMatrix(m);\n    return (m->rows == m->cols);\n}\n\nbool isInvertible(matrix* m){\n    return isSquareMatrix(m) && determinant(m) != 0;\n}\n\nbool isDiagonalMatrix(matrix* m){\n    assert(isSquareMatrix(m));\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            if(i != j && m->data[i * m->cols + j] != 0){\n                return false;\n            }\n        }\n    }\n    return true;\n}\n\nbool isTriangularMatrix(matrix* m){\n    assert(isSquareMatrix(m));\n    return exclusiveOr(isUpTriMatrix(m), isLoTriMatrix(m));\n}\n\nbool isUpTriMatrix(matrix* m){\n    assert(isSquareMatrix(m));\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < i; j++){\n            if(m->data[i * m->cols + j] != 0){\n                return false;\n            }\n        }\n    }\n    return true;\n}\n\nbool isLoTriMatrix(matrix* m){\n    assert(isSquareMatrix(m));\n    for(int i = 0; i < m->rows; i++){\n        for(int j = i+1; j < m->cols; j++){\n            if(m->data[i * m->cols + j] != 0){\n                return false;\n            }\n        }\n    }\n    return true;\n}\n\nbool isMatrixSymmetric(matrix* m){\n    matrix* t = transposeMatrix(m);\n    bool equal = isMatrixEqual(m, t);\n    deleteMatrix(t);\n    return equal;\n}\n\nbool hasZeroRow(matrix* m){\n    assertMatrix(m);\n    bool allZeroes = true;\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            if(m->data[i * m->cols + j] != 0){\n                allZeroes = false;\n            }\n        }\n        if(allZeroes){\n            return true;\n        }\n        allZeroes = true;\n    }\n    return false;\n}\n\nbool hasZeroCol(matrix* m){\n    assertMatrix(m);\n    bool allZeroes = true;\n    for(int j = 0; j < m->rows; j++){\n        for(int i = 0; i < m->cols; i++){\n            if(m->data[i * m->cols + j] != 0){\n                allZeroes = false;\n            }\n        }\n        if(allZeroes){\n            return true;\n        }\n        allZeroes = true;\n    }\n    return false;\n}\n\ndouble determinant(matrix* m){\n    assert(isSquareMatrix(m));\n    switch(m->rows){  // use leibniz and laplace for smaller matrices\n        case 1: return m->data[0];\n        case 2: return (m->data[0] * m->data[3]) - (m->data[1] * m->data[2]);\n        case 3: return (m->data[0]*((m->data[4]*m->data[8])-(m->data[5]*m->data[7]))) -\n                       (m->data[1]*((m->data[3]*m->data[8])-(m->data[5]*m->data[6]))) +\n                       (m->data[2]*((m->data[3]*m->data[7])-(m->data[4]*m->data[6]))) ;\n    }\n    if(isTriangularMatrix(m)){\n        return diagonalProduct(m);\n    }\n    matrix* l = NULL;\n    matrix* u = NULL;\n    matrix* p = NULL;\n    // det(permutation matrix) = (-1)^swaps\n    double det = pow(-1, luDecomposition(m,&l,&u,&p)-1) * determinant(l) * determinant(u);\n    deleteMatrix(p);\n    deleteMatrix(u);\n    deleteMatrix(l);\n    return det;\n}\n\nmatrix* transposeMatrix(matrix* m){\n    assertMatrix(m);\n    matrix* t = zeroMatrix(m->cols, m->rows);\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            t->data[j * t->cols + i] = m->data[i * m->cols + j];\n        }\n    }\n    return t;\n}\n\ndouble traceMatrix(matrix* m){\n    assert(isSquareMatrix(m));\n    double trace = 0;\n    for(int i = 0; i < m->rows; i++){\n        trace += m->data[i * m->cols + i];\n    }\n    return trace;\n}\n\nmatrix* addMatrices(matrix* m, matrix* n){\n    assert(hasSameDimensions(m, n));\n    matrix* sum = nullMatrix(m->rows, m->cols);\n    int idx = 0;\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            sum->data[idx] = m->data[idx] + n->data[idx];\n            idx++;\n        }\n    }\n    return sum;\n}\n\nmatrix* powMatrix(matrix* m, double k){\n    assertMatrix(m);\n    matrix* p = nullMatrix(m->rows, m->cols);\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            p->data[i * m->cols + j] = pow(m->data[i * m->cols + j], k);\n        }\n    }\n    return p;\n}\n\nmatrix* multiplyMatrices(matrix* m, matrix* n){\n    assert(assertMatrix(m) && assertMatrix(n) && m->cols == n->cols && m->rows == n->rows);\n    matrix* prod = nullMatrix(m->rows, m->cols);\n    for(int j = 0; j < m->rows; j++){\n        for(int i = 0; i < m->cols; i++){\n            double val = 0.0;\n            for(int k = 0; k < m->cols; k++){\n                val += ((m->data[i * m->cols + k] * n->data[k * m->cols + j]));\n            }\n            prod->data[i * m->cols + j] = val;\n        }\n    }\n    return prod;\n}\n\nmatrix* scaleMatrix(matrix* m, double s){\n    assertMatrix(m);\n    matrix* scaled = nullMatrix(m->rows, m->cols);\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            scaled->data[i * m->cols + j] = m->data[i * m->cols + j] * s;\n        }\n    }\n    return scaled;\n}\n\nmatrix* subMatrix(matrix* m, int i, int j){\n    assert(assertMatrix(m) && i >= 0 && i < m->rows && j >= 0 && j < m->cols);\n    matrix* sm = nullMatrix(m->rows-1,m->cols-1);\n    int idx = 0;\n    for(int row = 0; row < m->rows; row++){\n        for(int col = 0; col < m->cols; col++){\n            if(row != i && col != j){\n                sm->data[idx++] = m->data[row * m->cols + col];\n            }\n        }\n    }\n    return sm;\n}\n\ndouble elementMinor(matrix* m, int i, int j){\n    matrix* sm = subMatrix(m,i,j);\n    double minor = determinant(sm);\n    deleteMatrix(sm);\n    return minor;\n}\n\nmatrix* matrixMinor(matrix* m){\n    assertMatrix(m);\n    matrix* mm = nullMatrix(m->rows, m->cols);\n    for(int i = 0; i < mm->rows; i++){\n        for(int j = 0; j < mm->cols; j++){\n            mm->data[i * mm->cols + j] = elementMinor(m,i,j);\n        }\n    }\n    return mm;\n}\n\ndouble elementCofactor(matrix* m, int i, int j){\n    return pow(-1, (i+1)+(j+1)) * elementMinor(m, i, j);\n}\n\nmatrix* matrixCofactor(matrix* m){\n    assertMatrix(m);\n    matrix* cfm = nullMatrix(m->rows, m->cols);\n    for(int i = 0; i < cfm->rows; i++){\n        for(int j = 0; j < cfm->cols; j++){\n            cfm->data[i * cfm->cols + j] = elementCofactor(m,i,j);\n        }\n    }\n    return cfm;\n}\n\nmatrix* signMatrix(int rows, int cols){\n    assert(rows > 0 && cols > 0);\n    matrix* sm = nullMatrix(rows, cols);\n    fillMatrix(&sm, 1);\n    for(int i = 0; i < sm->rows; i++){\n        for(int j = 0; j < sm->cols; j++){\n            sm->data[i * sm->cols + j] = (((i * sm->cols + j)+1) % 2) ? 1 : -1;\n        }\n    }\n    return sm;\n}\n\nmatrix* adjugateMatrix(matrix* m){\n    assertMatrix(m);\n    matrix* mm = matrixMinor(m);\n    matrix* sign = signMatrix(m->rows, m->cols);\n    matrix* adj = multiplyMatrices(mm, sign);\n    deleteMatrix(sign);\n    deleteMatrix(mm);\n    return adj;\n}\n\nint luDecomposition(matrix* m, matrix** l, matrix** u, matrix** p){\n    assert(isSquareMatrix(m) && *l == NULL && *u == NULL && *p == NULL);\n    int n = m->cols;\n    int swaps = 0;\n    *l = zeroMatrix(n, n);\n    *u = zeroMatrix(n, n);\n    *p = pivotMatrix(m, &swaps);\n    matrix* m2 = multiplyMatrices(*p,m);\n    for(int j = 0; j < n; j++){\n        (*l)->data[j * n + j] = 1;\n        for(int i = 0; i < j+1; i++){\n            double sumU = 0;\n            for(int k = 0; k < i; k++){\n                sumU += ((*u)->data[k * n + j] * (*l)->data[i * n + k]);\n            }\n            (*u)->data[i * n + j] = m2->data[i * n + j] - sumU;\n        }\n        for(int i = j; i < n; i++){\n            double sumL = 0;\n            for(int k = 0; k < j; k++){\n                sumL += ((*u)->data[k * n + j] * (*l)->data[i * n + k]);\n            }\n            (*l)->data[i * n + j] = (m2->data[i * n + j] - sumL) / (*u)->data[j * n + j];\n        }\n    }\n    deleteMatrix(m2);\n    return swaps;\n}\n\nmatrix* inverseMatrix(matrix* m){\n    assert(isInvertible(m));\n    matrix* adj = adjugateMatrix(m);\n    matrix* inv = scaleMatrix(adj,(1.0/determinant(m)));\n    deleteMatrix(adj);\n    return inv;\n}\n\nmatrix* pivotMatrix(matrix* m, int* swaps){\n    assert(isSquareMatrix(m));\n    int n = m->cols;\n    matrix* pivot = identityMatrix(n);\n    for(int i = 0; i < n; i++){\n        double max = m->data[i * n + i];\n        int row = i;\n        for(int j = i; j < n; j++){\n            if(m->data[j * n + i] > max){\n                max = m->data[j * n + i];\n                row = j;\n            }\n        }\n        if(i != row){\n            vector* v = getRowVector(pivot, i);\n            vector* w = getRowVector(pivot, row);\n            setRowVector(pivot, i, w);\n            setRowVector(pivot, row, v);\n            deleteVector(w);\n            deleteVector(v);\n            swaps++;\n        }\n    }\n    return pivot;\n}\n\nvoid printMatrix(matrix* m, bool includeIndices){\n    assertMatrix(m);\n    for(int i = 0; i < m->rows; i++){\n        for(int j = 0; j < m->cols; j++){\n            if(includeIndices){\n                printf(\"[%d,%d] -> \", i, j);\n            }\n            printf(\"%8.2f \", m->data[i * m->cols + j]);\n        }\n        if(i < m->rows){\n            printf(\"\\n\");\n        }\n    }\n}\n\nmatrix* scaleNSpace(matrix* m, double k){\n    assert(isSquareMatrix(m));\n    matrix* n = zeroMatrix(m->cols,m->cols);\n    vector* v = zeroVector(m->cols);\n    fillVector(&v, k);\n    setMainDiagonal(n, v);\n    matrix* ref = multiplyMatrices(m, n);\n    deleteVector(v);\n    deleteMatrix(n);\n    return ref;\n}\n\nmatrix* reflectAxis2D(matrix* m, int axis){\n    assert(isSquareMatrix(m) && m->cols == 2);\n    matrix* n = zeroMatrix(2,2);\n    setMatrixElement(n,0,0,(axis) ? 1 : -1);\n    setMatrixElement(n,1,1,(axis) ? -1 : 1);\n    matrix* ref = multiplyMatrices(m, n);\n    deleteMatrix(n);\n    return ref;\n}\n\nmatrix* reflectAxis3D(matrix* m, int axis){\n    assert(isSquareMatrix(m) && m->cols == 3 && axis >= 0 && axis <= 2);\n    matrix* n = nullMatrix(3,3);\n    if(axis == 0){\n        double data[9] = {1,0,0,0,1,0,0,0,-1}; // XY\n        setMainDiagonal(m, newVector(data, 3)); \n    } else if(axis == 1){\n        double data[9] = {1,0,0,0,-1,0,0,0,1}; // XZ\n        setMainDiagonal(m, newVector(data, 3)); \n    } else{\n        double data[9] = {-1,0,0,0,1,0,0,0,1}; // YZ\n        setMainDiagonal(m, newVector(data, 3)); \n    }\n    matrix* ref = multiplyMatrices(m, n);\n    deleteMatrix(n);\n    return ref;\n}\n\nmatrix* orthProj2D(matrix* m, int axis){\n    assert(isSquareMatrix(m) && m->cols == 2);\n    matrix* n = zeroMatrix(2,2);\n    setMatrixElement(n,axis,axis,1);\n    matrix* ref = multiplyMatrices(m,n);\n    deleteMatrix(n);\n    return ref;\n}\n\nmatrix* orthProj3D(matrix* m, int axis){\n    assert(isSquareMatrix(m) && m->cols == 3);\n    matrix* n = zeroMatrix(3,3);\n    switch(axis){\n        case 0: // XY plane\n            setMatrixElement(n,0,0,1);\n            setMatrixElement(n,1,1,1); \n            break;\n        case 1: // XZ plane\n            setMatrixElement(n,0,0,1); \n            setMatrixElement(n,2,2,1);\n            break;\n        case 2: // YZ plane\n            setMatrixElement(n,1,1,1);\n            setMatrixElement(n,2,2,1);\n            break;\n    }\n    matrix* ref = multiplyMatrices(m, n);\n    deleteMatrix(n);\n    return ref;\n}\n\nmatrix* shear2D(matrix* m, double k, int axis){\n    assert(isSquareMatrix(m) && m->cols == 2);\n    matrix* n = zeroMatrix(2,2);\n    setMatrixElement(n,0,0,1);\n    setMatrixElement(n,0,1,(axis) ? k : 0);\n    setMatrixElement(n,1,0,(axis) ? 0 : k);\n    setMatrixElement(n,1,1,1);\n    matrix* sheared = multiplyMatrices(m,n);\n    deleteMatrix(n);\n    return sheared;\n}\n\nmatrix* rotate3D(matrix* m, double theta, int axis){\n    assert(isSquareMatrix(m) && m->cols == 3);\n    matrix* n = zeroMatrix(3,3);\n    switch(axis){\n        case 0: // X\n            setMatrixElement(n,0,0,1);\n            setMatrixElement(n,1,0,cos(theta));\n            setMatrixElement(n,1,1,-sin(theta));\n            setMatrixElement(n,2,1,sin(theta));\n            setMatrixElement(n,2,2,cos(theta));\n            break;\n        case 1: // Y\n            setMatrixElement(n,0,0,cos(theta));\n            setMatrixElement(n,1,2,sin(theta));\n            setMatrixElement(n,1,1,1);\n            setMatrixElement(n,2,0,-sin(theta));\n            setMatrixElement(n,2,2,cos(theta));\n            break;\n        case 2: // Z\n            setMatrixElement(n,0,0,cos(theta));\n            setMatrixElement(n,0,1,-sin(theta));\n            setMatrixElement(n,2,0,sin(theta));\n            setMatrixElement(n,2,1,cos(theta));\n            setMatrixElement(n,2,2,1);\n            break;\n    }\n    matrix* ref = multiplyMatrices(m, n);\n    deleteMatrix(n);\n    return ref;\n}","numLines":695,"startLine":1,"totalLines":695}}}
