{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018XNjio3p9UeMXvtsZhSZ5C","type":"tool_result","content":"1\t//\n2\t// Created by ruibin on 12/12/22.\n3\t//\n4\t#include <malloc.h>\n5\t#include <stdlib.h>\n6\t#include <immintrin.h>\n7\t#include \"matrix.h\"\n8\t\n9\t\n10\t\n11\tint generate_matrix(ARRAY_TYPE*** matrix, int x, int y, bool random){\n12\t    *matrix = malloc(sizeof(ARRAY_TYPE*) * x);\n13\t    if(!random){\n14\t        for (int i = 0; i < x; ++i) {\n15\t            (*matrix)[i] = malloc(sizeof(ARRAY_TYPE) * x);\n16\t            for (int j = 0; j < y; ++j) {\n17\t                (*matrix)[i][j] = (ARRAY_TYPE)(j + i * x);\n18\t            }\n19\t        }\n20\t    }else{\n21\t        for (int i = 0; i < x; ++i) {\n22\t            (*matrix)[i] = malloc(sizeof(ARRAY_TYPE) * y);\n23\t            for (int j = 0; j < y; ++j) {\n24\t                (*matrix)[i][j] = (ARRAY_TYPE)rand();\n25\t            }\n26\t        }\n27\t    }\n28\t    return 0;\n29\t}\n30\t\n31\tint free_matrix(ARRAY_TYPE*** matrix, int x){\n32\t    for (int i = 0; i < x; ++i) {\n33\t        free((*matrix)[i]);\n34\t    }\n35\t    free(*matrix);\n36\t    *matrix = NULL;\n37\t    return 0;\n38\t}\n39\tint multiply(ARRAY_TYPE** m1, ARRAY_TYPE** m2, ARRAY_TYPE** r, int x1, int y1, int x2, int y2, int method){\n40\t    if(y1 - x2){\n41\t        printf(\"The number of columns in the first matrix must be equal to the number of rows in the second matrix. \\n\");\n42\t        return -1;\n43\t    }\n44\t    switch (method) {\n45\t        case 1:\n46\t            algorithm1(m1, m2, r, x1, y1, x2, y2);\n47\t            break;\n48\t        case 2:\n49\t            algorithm2(m1, m2, r, x1);\n50\t            break;\n51\t        case 3:\n52\t            algorithm3(m1, m2, r, x1, y1, x2, y2);\n53\t            break;\n54\t        default:\n55\t            printf(\"Choose the correct method!\\n\");\n56\t            return -1;\n57\t    }\n58\t    return 0;\n59\t}\n60\tint algorithm1(ARRAY_TYPE** m1, ARRAY_TYPE** m2, ARRAY_TYPE** r, int x1, int y1, int x2, int y2){\n61\t    for (int i = 0; i < x1; ++i) {\n62\t        for (int j = 0; j < y2; ++j) {\n63\t            r[i][j] = 0;\n64\t            for (int k = 0; k < y1; ++k) {\n65\t                r[i][j] += m1[i][k] * m2[k][j];\n66\t            }\n67\t        }\n68\t    }\n69\t    return 0;\n70\t}\n71\t\n72\tint algorithm2( ARRAY_TYPE **a,  ARRAY_TYPE **bb, ARRAY_TYPE **c, int size){\n73\t    ARRAY_TYPE** b = malloc(sizeof(ARRAY_TYPE*) * size);\n74\t    for (int i = 0; i < size; ++i) {\n75\t        b[i] = malloc(sizeof(ARRAY_TYPE) * size);\n76\t        for (int j = 0; j < size;) {\n77\t            b[i][j] = bb[j][i];\n78\t            c[i][j] = 0;\n79\t            j++;\n80\t            b[i][j] = bb[j][i];\n81\t            c[i][j] = 0;\n82\t            j++;\n83\t            b[i][j] = bb[j][i];\n84\t            c[i][j] = 0;\n85\t            j++;\n86\t            b[i][j] = bb[j][i];\n87\t            c[i][j] = 0;\n88\t            j++;\n89\t            b[i][j] = bb[j][i];\n90\t            c[i][j] = 0;\n91\t            j++;\n92\t            b[i][j] = bb[j][i];\n93\t            c[i][j] = 0;\n94\t            j++;\n95\t            b[i][j] = bb[j][i];\n96\t            c[i][j] = 0;\n97\t            j++;\n98\t            b[i][j] = bb[j][i];\n99\t            c[i][j] = 0;\n100\t            j++;\n101\t        }\n102\t    }\n103\t\n104\t    for (int i = 0; i < size; ++i) {\n105\t        for (int j = 0; j < size; j+=8) {\n106\t            __m256 m_a =  _mm256_loadu_ps(a[i] + j);\n107\t            for (int k = 0; k < size; k++) {\n108\t                __m256 m_b =  _mm256_loadu_ps(b[k] + j);\n109\t                __m256 m_c = _mm256_mul_ps(m_a, m_b);\n110\t                c[i][k] += m_c[0];\n111\t                c[i][k] += m_c[1];\n112\t                c[i][k] += m_c[2];\n113\t                c[i][k] += m_c[3];\n114\t                c[i][k] += m_c[4];\n115\t                c[i][k] += m_c[5];\n116\t             