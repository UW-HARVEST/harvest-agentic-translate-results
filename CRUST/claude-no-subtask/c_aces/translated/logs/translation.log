 invm, modulus)?,\n            1 => scale_transform(m, invm, modulus)?,\n            2 => linear_mix_transform(m, invm, modulus)?,\n            _ => unreachable!(),\n        }\n    }\n    Ok(())\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":6,"lines":[" use crate::common::{randinverse, randrange};"," use crate::error::{AcesError, Result};","-use rand::Rng;","+"," #[derive(Debug, Clone)]"," pub struct Matrix2D {","     pub dim: usize,"]},{"oldStart":8,"oldLines":19,"newStart":8,"newLines":41,"lines":[" }"," impl Matrix2D {","     pub fn new(dim: usize) -> Self {","-        unimplemented!()","+        Matrix2D {","+            dim,","+            data: vec![0u64; dim * dim],","+        }","     }","     pub fn row(&self, row: usize) -> Option<&[u64]> {","-        unimplemented!()","+        if row >= self.dim {","+            return None;","+        }","+        let start = row * self.dim;","+        Some(&self.data[start..start + self.dim])","     }","     pub fn row_mut(&mut self, row: usize) -> Option<&mut [u64]> {","-        unimplemented!()","+        if row >= self.dim {","+            return None;","+        }","+        let start = row * self.dim;","+        let dim = self.dim;","+        Some(&mut self.data[start..start + dim])","     }","     pub fn get(&self, row: usize, col: usize) -> Option<u64> {","-        unimplemented!()","+        if row >= self.dim || col >= self.dim {","+            return None;","+        }","+        Some(self.data[row * self.dim + col])","     }","     pub fn set(&mut self, row: usize, col: usize, value: u64) -> Result<()> {","-        unimplemented!()","+        if row >= self.dim || col >= self.dim {","+            return Err(AcesError::GenericError(","+                \"matrix index out of range\".to_string(),","+            ));","+        }","+        let dim = self.dim;","+        self.data[row * dim + col] = value;","+        Ok(())","     }"," }"," #[derive(Debug, Clone)]"]},{"oldStart":29,"o