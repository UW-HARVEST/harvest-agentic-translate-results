ge(0, samp);\n54\t      for (size_t j = 0; j < zero; ++j)\n55\t        u->coeffs[i++] = 0;\n56\t      zeroes -= zero;\n57\t    }\n58\t  }\n59\t\n60\t  u->coeffs[param->dim] = 0;\n61\t  u->coeffs[param->dim] = (int64_t)channel->q - (int64_t)coef_sum(u);\n62\t  return 0;\n63\t}\n64\t\n65\tint generate_secret(const Channel *channel, const Parameters *param,\n66\t                    const Polynomial *u, PolyArray *secret, Matrix3D *lambda) {\n67\t  Matrix2D m;\n68\t  Matrix2D invm;\n69\t\n70\t  m.dim = param->dim;\n71\t  invm.dim = param->dim;\n72\t\n73\t  size_t required_mem = m.dim * m.dim;\n74\t  uint64_t mem[2 * required_mem];\n75\t  m.data = mem;\n76\t  invm.data = mem + required_mem;\n77\t\n78\t  fill_random_invertible_pairs(&m, &invm, channel->q, 600);\n79\t\n80\t  secret->size = m.dim;\n81\t  for (size_t i = 0; i < m.dim; ++i) {\n82\t    for (size_t j = 0; j < m.dim; ++j) {\n83\t      secret->polies[i].coeffs[j] = matrix2d_get(&m, j, i);\n84\t    }\n85\t  }\n86\t\n87\t  Matrix2D *arr = &m;\n88\t  Polynomial a_ij_poly;\n89\t\n90\t  Coeff miim[2 * secret->size];\n91\t\n92\t  for (size_t i = 0; i < secret->size; ++i) {\n93\t    for (size_t j = 0; j < secret->size; ++j) {\n94\t      set_polynomial(&a_ij_poly, miim, 2 * secret->size);\n95\t      poly_mul(&secret->polies[i], &secret->polies[j], &a_ij_poly, channel->q);\n96\t      poly_mod(&a_ij_poly, u, channel->q);\n97\t\n98\t      for (size_t row = 0; row < arr->dim; row++) {\n99\t        matrix2d_set(arr, row, j, a_ij_poly.coeffs[arr->dim - row - 1]);\n100\t      }\n101\t    }\n102\t\n103\t    matrix2d_multiply(&invm, arr, matrix3d_get(lambda, i), channel->q);\n104\t  }\n105\t\n106\t  return 0;\n107\t}\n108\t\n109\tint generate_f0(const Channel *channel, const Parameters *param,\n110\t                PolyArray *f0) {\n111\t  (void)param; // TODO: we need to consider N\n112\t  for (size_t i = 0; i < f0->size; ++i) {\n113\t    for (size_t j = 0; j < f0->polies[i].size; j++)\n114\t      f0->polies[i].coeffs[j] = randrange(0, channel->q - 1);\n115\t  }\n116\t\n117\t  return 0;\n118\t}\n119\t\n120\tint generate_f1(const Channel *channel, const Parameters *param,\n121\t                const PolyArray *f0, const PolyArray *x, const Polynomial *u,\n122\t                Polynomial *f1) {\n123\t  Polynomial tmp;\n124\t  Coeff mem[param->dim * 2];\n125\t\n126\t  Polynomial f_pre;\n127\t  Coeff f_pre_mem[param->dim * 2];\n128\t  set_polynomial(&f_pre, f_pre_mem, param->dim * 2);\n129\t\n130\t  set_zero(&f_pre);\n131\t\n132\t  for (size_t i = 0; i < param->dim; ++i) {\n133\t    set_polynomial(&tmp, mem, param->dim * 2);\n134\t    poly_mul(&f0->polies[i], &x->polies[i], &tmp, channel->q);\n135\t    poly_add(&f_pre, &tmp, &f_pre, channel->q);\n136\t  }\n137\t  poly_mod(&f_pre, u, channel->q);\n138\t\n139\t  size_t diff = f1->size - f_pre.size;\n140\t  f1->coeffs += diff;\n141\t  f1->size -= diff;\n142\t  memcpy(f1->coeffs, f_pre.coeffs, f_pre.size * sizeof(Coeff));\n143\t\n144\t  return 0;\n145\t}\n146\t"}]},"parent_tool_use_id":null,"session_id":"0ed494f7-5fa0-4962-8fe1-999f1b5027d0","uuid":"7cae3f00-8a59-4bab-8237-4ff6d076858a","timestamp":"2026-06-06T00:53:28.781Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-3bJx3g/project/c_src/src/Aces-internal.c","content":"#include \"include/Aces-internal.h\"\n#include \"include/Common.h\"\n\n#include <string.h>\n\nint generate_error(uint64_t q, uint64_t message, Polynomial *rm) {\n  for (size_t i = 0; i < rm->size; ++i)\n    rm->coeffs[i] = randrange(0, q);\n\n  Coeff shift =\n      (rm->coeffs[rm->size - 1] + ((Coeff)message - (Coeff)coef_sum(rm))) %\n      (Coeff)q;\n  rm->coeffs[rm->size - 1] = shift > 0 ? shift : shift + (Coeff)q;\n  return 0;\n}\n\nuint64_t generate_vanisher(uint64_t p, uint64_t q, Polynomial *e) {\n  int64_t k = randrange(0, 1) < EPROB ? 0 : 1;\n  for (size_t i = 0; i < e->size; ++i)\n    e->coeffs[i] = randrange(0, q);\n\n  Coeff shift =\n      (e->coeffs[e->size - 1] + (Coeff)p * k - coef_sum(e)) % (Coeff)q;\n  e->coeffs[e->size - 1] = shift > 0 ? shift : shift + (Coeff)q;\n  return k;\n}\n\nuint64_t generate_linear(uint64_t p, uint64_t q, Polynomial *b) {\n  int64_t k = randrange(0, p);\n  for (size_t i = 0; i < b->size; ++i)\n    b->coeffs[i] = randrange(0, q);\n\n  Coeff shift = (b->coeffs[b->size - 1] + k - coef_sum(b)) % (Coeff)q;\n  b->coeffs[b->size - 1] = shift > 0 ? shift : shift + (Coeff)q;\n  return k;\n}\n\nint generate_u(const Channel *channel, const Parameters *param, Polynomial *u) {\n  uint64_t nonzeros = randrange(param->dim / 2, param->dim - 1);\n  uint64_t zeroes = param->dim - nonzeros;\n  u->coeffs[0] = 1;\n\n  for (size_t i = 1; i < param->dim;) {\n    if (nonzeros > 1) {\n      u->coeffs[i++] = randrange(0, channel->q);\n      nonzeros--;\n    } else {\n      break;\n    }\n\n    if (zeroes > 0) {\n      uint64_t samp = clamp(0, zeroes, normal_rand(zeroes / 2, zeroes / 2));\n      uint64_t zero = randrange(0, samp);\n      for (size_t j = 0; j < zero; ++j)\n        u->coeffs[i++] = 0;\n      zeroes -= zero;\n    }\n  }\n\n  u->coeffs[param->dim] = 0;\n  u->coeffs[param->dim] = (int64_t)channel->q - (int64_t)coef_sum(u);\n  return 0;\n}\n\nint generate_secret(const Channel *channel, const Parameters *param,\n                    const Polynomial *u, PolyArray *secret, Matrix3D *lambda) {\n  Matrix2D m;\n  Matrix2D invm;\n\n  m.dim = param->dim;\n  invm.dim = param->dim;\n\n  size_t required_mem = m.dim * m.dim;\n  uint64_t mem[2 * required_mem];\n  m.data = mem;\n  invm.data = mem + required_mem;\n\n  fill_random_invertible_pairs(&m, &invm, channel->q, 600);\n\n  secret->size = m.dim;\n  for (size_t i = 0; i < m.dim; ++i) {\n    for (size_t j = 0; j < m.dim; ++j) {\n      secret->polies[i].coeffs[j] = matrix2d_get(&m, j, i);\n    }\n  }\n\n  Matrix2D *arr = &m;\n  Polynomial a_ij_poly;\n\n  Coeff miim[2 * secret->size];\n\n  for (size_t i = 0; i < secret->size; ++i) {\n    for (size_t j = 0; j < secret->size; ++j) {\n      set_polynomial(&a_ij_poly, miim, 2 * secret->size);\n      poly_mul(&secret->polies[i], &secret->polies[j], &a_ij_poly, channel->q);\n      poly_mod(&a_ij_poly, u, channel->q);\n\n      for (size_t row = 0; row < arr->dim; row++) {\n        matrix2d_set(arr, row, j, a_ij_poly.coeffs[arr->dim - row - 1]);\n      }\n    }\n\n    matrix2d_multiply(&invm, arr, matrix3d_get(lambda, i), channel->q);\n  }\n\n  return 0;\n}\n\nint generate_f0(const Channel *channel, const Parameters *param,\n                PolyArray *f0) {\n  (void)param; // TODO: we need to consider N\n  for (size_t i = 0; i < f0->size; ++i) {\n    for (size_t j = 0; j < f0->polies[i].size; j++)\n      f0->polies[i].coeffs[j] = randrange(0, channel->q - 1);\n  }\n\n  return 0;\n}\n\nint generate_f1(const Channel *channel, const Parameters *param,\n                const PolyArray *f0, const PolyArray *x, const Polynomial *u,\n                Polynomial *f1) {\n  Polynomial tmp;\n  Coeff mem[param->dim * 2];\n\n  Polynomial f_pre;\n  Coeff f_pre_mem[param->dim * 2];\n  set_polynomial(&f_pre, f_pre_mem, param->dim * 2);\n\n  set_zero(&f_pre);\n\n  for (size_t i = 0; i < param->dim; ++i) {\n    set_polynomial(&tmp, mem, param->dim * 2);\n    poly_mul(&f0->polies[i], &x->polies[i], &tmp, channel->q);\n    poly_add(&f_pre, &tmp, &f_pre, channel->q);\n  }\n  poly_mod(&f_pre, u, channel->q);\n\n  size_t diff = f1->size - f_pre.size;\n  f1->coeffs += diff;\n  f1->size -= diff;\n  memcpy(f1->coeffs, f_pre.coeffs, f_pre.size * sizeof(Coeff));\n\n  return 0;\n}\n","numLines":146,"startLine":1,"totalLines":146}}}
