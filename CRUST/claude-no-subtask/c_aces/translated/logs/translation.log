r - lower + 1) + lower (inclusive on both ends)\n    let range = upper - lower + 1;\n    rng.random_range(0..range) + lower\n}\npub fn normal_rand(mean: f64, stddev: f64) -> f64 {\n    const PI: f64 = 3.14159265;\n    let mut rng = rand::rng();\n    let mut u: f64 = 0.0;\n    while u == 0.0 {\n        u = rng.random::<f64>();\n    }\n    let r = (-2.0 * u.ln()).sqrt();\n    let mut theta: f64 = 0.0;\n    while theta == 0.0 {\n        theta = 2.0 * PI * rng.random::<f64>();\n    }\n    let x = r * theta.cos();\n    x * stddev + mean\n}\npub fn max(a: u64, b: u64) -> u64 {\n    if a > b {\n        a\n    } else {\n        b\n    }\n}\npub fn min(a: u64, b: u64) -> u64 {\n    if a < b {\n        a\n    } else {\n        b\n    }\n}\npub fn clamp(min_value: u64, max_value: u64, value: u64) -> u64 {\n    max(min_value, min(max_value, value))\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":247,"cache_read_input_tokens":52727,"cache_creation":{"ephemeral_5m_input_tokens":247,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0ed494f7-5fa0-4962-8fe1-999f1b5027d0","uuid":"04869402-5851-42f7-ae3f-1411b8165bed"}
