{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01No13x64eYdyuNrbSi7Aph4","type":"tool_result","content":"1\t// Robin hood bloom filter — Rust port of https://github.com/tidwall/rhbloom\n2\t\n3\t// Define the RHBloom struct\n4\tpub struct RHBloom {\n5\t    count: usize,\n6\t    nbuckets: usize,\n7\t    buckets: Vec<u64>,\n8\t    k: usize,\n9\t    m: usize,\n10\t    bits: Vec<u8>,\n11\t}\n12\t\n13\t// Mask for the lower 56 bits of a u64 (the key portion in a bucket entry).\n14\tconst KEY_MASK: u64 = 0x00FF_FFFF_FFFF_FFFF;\n15\t\n16\t#[inline(always)]\n17\tfn entry_dib(entry: u64) -> u64 {\n18\t    entry >> 56\n19\t}\n20\t\n21\t#[inline(always)]\n22\tfn entry_key(entry: u64) -> u64 {\n23\t    entry & KEY_MASK\n24\t}\n25\t\n26\t#[inline(always)]\n27\tfn make_entry(key: u64, dib: u64) -> u64 {\n28\t    (key & KEY_MASK) | (dib << 56)\n29\t}\n30\t\n31\timpl RHBloom {\n32\t    pub fn new(n: usize, p: f64) -> Self {\n33\t        let n = if n < 16 { 16 } else { n };\n34\t\n35\t        // m = -n * ln(p) / ln(2)^2\n36\t        let ln2 = 2.0_f64.ln();\n37\t        let denom = (1.0_f64 / 2.0_f64.powf(ln2)).ln();\n38\t        let m_f = (n as f64) * p.ln() / denom;\n39\t        let m_calc: usize = if m_f.is_finite() && m_f > 0.0 {\n40\t            m_f as usize\n41\t        } else {\n42\t            8\n43\t        };\n44\t\n45\t        // k = round((m/n) * ln(2))\n46\t        let k_f = (m_calc as f64 / n as f64) * ln2;\n47\t        let mut k: usize = k_f.round() as usize;\n48\t        if k == 0 {\n49\t            k = 1;\n50\t        }\n51\t\n52\t        // Round m up to a multiple of 8 (so bit array is a whole number of bytes)\n53\t        // and ensure at least 8 bits.\n54\t        let mut m = ((m_calc + 7) / 8) * 8;\n55\t        if m < 8 {\n56\t            m = 8;\n57\t        }\n58\t\n59\t        RHBloom {\n60\t            count: 0,\n61\t            nbuckets: 0,\n62\t            buckets: Vec::new(),\n63\t            k,\n64\t            m,\n65\t            bits: Vec::new(),\n66\t        }\n67\t    }\n68\t\n69\t    pub fn memsize(&self) -> usize {\n70\t        let size = std::mem::size_of::<Self>();\n71\t        size + if !self.bits.is_empty() {\n72\t            self.m >> 3\n73\t        } else {\n74\t            self.nbuckets << 3\n75\t        }\n76\t    }\n77\t\n78\t    pub fn clear(&mut self) {\n79\t        if !self.bits.is_empty() {\n80\t            for b in self.bits.iter_mut() {\n81\t                *b = 0;\n82\t            }\n83\t        } else if !self.buckets.is_empty() {\n84\t            for b in self.buckets.iter_mut() {\n85\t                *b = 0;\n86\t            }\n87\t            self.count = 0;\n88\t        }\n89\t    }\n90\t\n91\t    pub fn upgraded(&self) -> bool {\n92\t        !self.bits.is_empty()\n93\t    }\n94\t\n95\t    pub fn testadd(&mut self, key: u64, add: bool) -> bool {\n96\t        // We only want the 56-bit key in order to match correctly with the\n97\t        // robin hood entries, upon upgrade.\n98\t        let mut key = key & KEY_MASK;\n99\t        // Lemire's fast range reduction: ((key * m) >> 56) lies in [0, m)\n100\t        // for any 56-bit key, with low bias for our purposes.\n101\t        let m = self.m as u128;\n102\t        let k = self.k;\n103\t        let bits = self.bits.as_mut_slice();\n104\t        let mut i: usize = 0;\n105\t        let mut j = (((key as u128) * m) >> 56) as usize;\n106\t        loop {\n107\t            let byte_idx = j >> 3;\n108\t            let bit_idx = (j & 7) as u32;\n109\t            if add {\n110\t                bits[byte_idx] |= 1u8 << bit_idx;\n111\t            } else if (bits[byte_idx] >> bit_idx) & 1 == 0 {\n112\t                return false;\n113\t            }\n114\t            if i + 1 == k {\n115\t                break;\n116\t            }\n117\t            // Pick the next bit. Use part of the mix13 formula to help get a\n118\t            // more randomized value.\n119\t            key = key.wrapping_mul(0x94d049bb133111eb);\n120\t            key ^= key >> 31;\n121\t            key &= KEY_MASK;\n122\t            j = (((key as u128) * m) >> 56) as usize;\n123\t            i += 1;\n124\t        }\n125\t        true\n126\t    }\n127\t\n128\t    pub fn free(&mut self) {\n129\t        self.bits = Vec::new();\n130\t        self.buckets = Vec::new();\n131\t        self.count = 0;\n132\t        self.nbuckets = 0;\n133\t    }\n134\t\n135\t    pub fn mix(key: u64) -> u64 {\n136\t        // mix13: https://zimbry.blogspot.com/2011/09/better-bit-mixing-improving-on.html\n137\t        let mut key = key;\n138\t        key ^= key >> 30;\n139\t        key = key.wrapping_mul(0xbf58476d1ce4e5b9);\n140\t        key ^= key >> 27;\n141\t        key = key.wrapping_mul(0x94d049bb133111eb);\n142\t        key ^= key >> 31;\n143\t        key\n144\t    }\n145\t\n146\t    pub fn grow(&mut self) -> bool {\n147\t        let nbuckets_old = self.nbuckets;\n148\t        let buckets_old = std::mem::take(&mut self.buckets);\n149\t        let nbuckets_new = if nbuckets_old == 0 { 16 } else { nbuckets_old * 2 };\n150\t        if nbuckets_new * 8 >= self.m >> 3 {\n151\t            // Upgrade to bloom filter\n152\t            let nbits_bytes = self.m >> 3;\n153\t            self.bits = vec![0u8; nbits_bytes];\n154\t            self.count = 0;\n155\t            self.nbuckets = 0;\n156\t            // self.buckets is already empty (taken)\n157\t            for &entry in buckets_old.iter() {\n158\t                if entry_dib(entry) != 0 {\n159\t                    self.testadd(entry, true);\n160\t                }\n161\t            }\n162\t        } else {\n163\t            self.count = 0;\n164\t            self.nbuckets = nbuckets_new;\n165\t            self.buckets = vec![0u64; nbuckets_new];\n166\t            for &entry in buckets_old.iter() {\n167\t                if entry_dib(entry) != 0 {\n168\t                    self.addkey(entry);\n169\t                }\n170\t            }\n171\t        }\n172\t        true\n173\t    }\n174\t\n175\t    pub fn add(&mut self, key: u64) -> bool {\n176\t        let key = Self::mix(key);\n177\t        loop {\n178\t            if !self.bits.is_empty() {\n179\t                self.testadd(key, true);\n180\t                return true;\n181\t            }\n182\t            if self.count == self.nbuckets >> 1 {\n183\t                if !self.grow() {\n184\t                    return false;\n185\t                }\n186\t                continue;\n187\t            }\n188\t            break;\n189\t        }\n190\t        self.addkey(key)\n191\t    }\n192\t\n193\t    pub fn addkey(&mut self, key: u64) -> bool {\n194\t        let mut key = key & KEY_MASK;\n195\t        let mut dib: u64 = 1;\n196\t        let mask = (self.nbuckets - 1) as u64;\n197\t        let mut i = (key & mask) as usize;\n198\t        loop {\n199\t            let entry = self.buckets[i];\n200\t            let edib = entry_dib(entry);\n201\t            let ekey = entry_key(entry);\n202\t            if edib == 0 {\n203\t                self.buckets[i] = make_entry(key, dib);\n204\t                self.count += 1;\n205\t                return true;\n206\t            }\n207\t            if ekey == key {\n208\t                return true;\n209\t            }\n210\t            if edib < dib {\n211\t                let tmp = self.buckets[i];\n212\t                self.buckets[i] = make_entry(key, dib);\n213\t                key = entry_key(tmp);\n214\t                dib = entry_dib(tmp);\n215\t            }\n216\t            dib += 1;\n217\t            i = (i + 1) & (self.nbuckets - 1);\n218\t        }\n219\t    }\n220\t\n221\t    pub fn test(&self, key: u64) -> bool {\n222\t        let key = Self::mix(key);\n223\t        if !self.bits.is_empty() {\n224\t            // Inlined immutable variant of testadd(key, false).\n225\t            let mut key = key & KEY_MASK;\n226\t            let m = self.m as u128;\n227\t            let k = self.k;\n228\t            let bits = self.bits.as_slice();\n229\t            let mut i: usize = 0;\n230\t            let mut j = (((key as u128) * m) >> 56) as usize;\n231\t            loop {\n232\t                if (bits[j >> 3] >> ((j & 7) as u32)) & 1 == 0 {\n233\t                    return false;\n234\t                }\n235\t                if i + 1 == k {\n236\t                    break;\n237\t                }\n238\t                key = key.wrapping_mul(0x94d049bb133111eb);\n239\t                key ^= key >> 31;\n240\t                key &= KEY_MASK;\n241\t                j = (((key as u128) * m) >> 56) as usize;\n242\t                i += 1;\n243\t            }\n244\t            return true;\n245\t        }\n246\t        if self.buckets.is_empty() {\n247\t            return false;\n248\t        }\n249\t        let key = key & KEY_MASK;\n250\t        let mut dib: u64 = 1;\n251\t        let mask = (self.nbuckets - 1) as u64;\n252\t        let mut i = (key & mask) as usize;\n253\t        loop {\n254\t            let entry = self.buckets[i];\n255\t            let edib = entry_dib(entry);\n256\t            let ekey = entry_key(entry);\n257\t            let yes = ekey == key;\n258\t            let no = edib < dib;\n259\t            if yes || no {\n260\t                return yes;\n261\t            }\n262\t            dib += 1;\n263\t            i = (i + 1) & (self.nbuckets - 1);\n264\t        }\n265\t    }\n266\t}\n267\t"}]},"parent_tool_use_id":null,"session_id":"d5b035f7-966b-4dfd-88d0-af191dfc040b","uuid":"f0122c2b-05f6-40bb-a269-394236e46985","timestamp":"2026-06-05T23:51:31.441Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-TcQhM8/project/src/rhbloom.rs","content":"// Robin hood bloom filter — Rust port of https://github.com/tidwall/rhbloom\n\n// Define the RHBloom struct\npub struct RHBloom {\n    count: usize,\n    nbuckets: usize,\n    buckets: Vec<u64>,\n    k: usize,\n    m: usize,\n    bits: Vec<u8>,\n}\n\n// Mask for the lower 56 bits of a u64 (the key portion in a bucket entry).\nconst KEY_MASK: u64 = 0x00FF_FFFF_FFFF_FFFF;\n\n#[inline(always)]\nfn entry_dib(entry: u64) -> u64 {\n    entry >> 56\n}\n\n#[inline(always)]\nfn entry_key(entry: u64) -> u64 {\n    entry & KEY_MASK\n}\n\n#[inline(always)]\nfn make_entry(key: u64, dib: u64) -> u64 {\n    (key & KEY_MASK) | (dib << 56)\n}\n\nimpl RHBloom {\n    pub fn new(n: usize, p: f64) -> Self {\n        let n = if n < 16 { 16 } else { n };\n\n        // m = -n * ln(p) / ln(2)^2\n        let ln2 = 2.0_f64.ln();\n        let denom = (1.0_f64 / 2.0_f64.powf(ln2)).ln();\n        let m_f = (n as f64) * p.ln() / denom;\n        let m_calc: usize = if m_f.is_finite() && m_f > 0.0 {\n            m_f as usize\n        } else {\n            8\n        };\n\n        // k = round((m/n) * ln(2))\n        let k_f = (m_calc as f64 / n as f64) * ln2;\n        let mut k: usize = k_f.round() as usize;\n        if k == 0 {\n            k = 1;\n        }\n\n        // Round m up to a multiple of 8 (so bit array is a whole number of bytes)\n        // and ensure at least 8 bits.\n        let mut m = ((m_calc + 7) / 8) * 8;\n        if m < 8 {\n            m = 8;\n        }\n\n        RHBloom {\n            count: 0,\n            nbuckets: 0,\n            buckets: Vec::new(),\n            k,\n            m,\n            bits: Vec::new(),\n        }\n    }\n\n    pub fn memsize(&self) -> usize {\n        let size = std::mem::size_of::<Self>();\n        size + if !self.bits.is_empty() {\n            self.m >> 3\n        } else {\n            self.nbuckets << 3\n        }\n    }\n\n    pub fn clear(&mut self) {\n        if !self.bits.is_empty() {\n            for b in self.bits.iter_mut() {\n                *b = 0;\n            }\n        } else if !self.buckets.is_empty() {\n            for b in self.buckets.iter_mut() {\n                *b = 0;\n            }\n            self.count = 0;\n        }\n    }\n\n    pub fn upgraded(&self) -> bool {\n        !self.bits.is_empty()\n    }\n\n    pub fn testadd(&mut self, key: u64, add: bool) -> bool {\n        // We only want the 56-bit key in order to match correctly with the\n        // robin hood entries, upon upgrade.\n        let mut key = key & KEY_MASK;\n        // Lemire's fast range reduction: ((key * m) >> 56) lies in [0, m)\n        // for any 56-bit key, with low bias for our purposes.\n        let m = self.m as u128;\n        let k = self.k;\n        let bits = self.bits.as_mut_slice();\n        let mut i: usize = 0;\n        let mut j = (((key as u128) * m) >> 56) as usize;\n        loop {\n            let byte_idx = j >> 3;\n            let bit_idx = (j & 7) as u32;\n            if add {\n                bits[byte_idx] |= 1u8 << bit_idx;\n            } else if (bits[byte_idx] >> bit_idx) & 1 == 0 {\n                return false;\n            }\n            if i + 1 == k {\n                break;\n            }\n            // Pick the next bit. Use part of the mix13 formula to help get a\n            // more randomized value.\n            key = key.wrapping_mul(0x94d049bb133111eb);\n            key ^= key >> 31;\n            key &= KEY_MASK;\n            j = (((key as u128) * m) >> 56) as usize;\n            i += 1;\n        }\n        true\n    }\n\n    pub fn free(&mut self) {\n        self.bits = Vec::new();\n        self.buckets = Vec::new();\n        self.count = 0;\n        self.nbuckets = 0;\n    }\n\n    pub fn mix(key: u64) -> u64 {\n        // mix13: https://zimbry.blogspot.com/2011/09/better-bit-mixing-improving-on.html\n        let mut key = key;\n        key ^= key >> 30;\n        key = key.wrapping_mul(0xbf58476d1ce4e5b9);\n        key ^= key >> 27;\n        key = key.wrapping_mul(0x94d049bb133111eb);\n        key ^= key >> 31;\n        key\n    }\n\n    pub fn grow(&mut self) -> bool {\n        let nbuckets_old = self.nbuckets;\n        let buckets_old = std::mem::take(&mut self.buckets);\n        let nbuckets_new = if nbuckets_old == 0 { 16 } else { nbuckets_old * 2 };\n        if nbuckets_new * 8 >= self.m >> 3 {\n            // Upgrade to bloom filter\n            let nbits_bytes = self.m >> 3;\n            self.bits = vec![0u8; nbits_bytes];\n            self.count = 0;\n            self.nbuckets = 0;\n            // self.buckets is already empty (taken)\n            for &entry in buckets_old.iter() {\n                if entry_dib(entry) != 0 {\n                    self.testadd(entry, true);\n                }\n            }\n        } else {\n            self.count = 0;\n            self.nbuckets = nbuckets_new;\n            self.buckets = vec![0u64; nbuckets_new];\n            for &entry in buckets_old.iter() {\n                if entry_dib(entry) != 0 {\n                    self.addkey(entry);\n                }\n            }\n        }\n        true\n    }\n\n    pub fn add(&mut self, key: u64) -> bool {\n        let key = Self::mix(key);\n        loop {\n            if !self.bits.is_empty() {\n                self.testadd(key, true);\n                return true;\n            }\n            if self.count == self.nbuckets >> 1 {\n                if !self.grow() {\n                    return false;\n                }\n                continue;\n            }\n            break;\n        }\n        self.addkey(key)\n    }\n\n    pub fn addkey(&mut self, key: u64) -> bool {\n        let mut key = key & KEY_MASK;\n        let mut dib: u64 = 1;\n        let mask = (self.nbuckets - 1) as u64;\n        let mut i = (key & mask) as usize;\n        loop {\n            let entry = self.buckets[i];\n            let edib = entry_dib(entry);\n            let ekey = entry_key(entry);\n            if edib == 0 {\n                self.buckets[i] = make_entry(key, dib);\n                self.count += 1;\n                return true;\n            }\n            if ekey == key {\n                return true;\n            }\n            if edib < dib {\n                let tmp = self.buckets[i];\n                self.buckets[i] = make_entry(key, dib);\n                key = entry_key(tmp);\n                dib = entry_dib(tmp);\n            }\n            dib += 1;\n            i = (i + 1) & (self.nbuckets - 1);\n        }\n    }\n\n    pub fn test(&self, key: u64) -> bool {\n        let key = Self::mix(key);\n        if !self.bits.is_empty() {\n            // Inlined immutable variant of testadd(key, false).\n            let mut key = key & KEY_MASK;\n            let m = self.m as u128;\n            let k = self.k;\n            let bits = self.bits.as_slice();\n            let mut i: usize = 0;\n            let mut j = (((key as u128) * m) >> 56) as usize;\n            loop {\n                if (bits[j >> 3] >> ((j & 7) as u32)) & 1 == 0 {\n                    return false;\n                }\n                if i + 1 == k {\n                    break;\n                }\n                key = key.wrapping_mul(0x94d049bb133111eb);\n                key ^= key >> 31;\n                key &= KEY_MASK;\n                j = (((key as u128) * m) >> 56) as usize;\n                i += 1;\n            }\n            return true;\n        }\n        if self.buckets.is_empty() {\n            return false;\n        }\n        let key = key & KEY_MASK;\n        let mut dib: u64 = 1;\n        let mask = (self.nbuckets - 1) as u64;\n        let mut i = (key & mask) as usize;\n        loop {\n            let entry = self.buckets[i];\n            let edib = entry_dib(entry);\n            let ekey = entry_key(entry);\n            let yes = ekey == key;\n            let no = edib < dib;\n            if yes || no {\n                return yes;\n            }\n            dib += 1;\n            i = (i + 1) & (self.nbuckets - 1);\n        }\n    }\n}\n","numLines":267,"startLine":1,"totalLines":267}}}
