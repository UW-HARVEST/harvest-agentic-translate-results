pos = 0; pos < 8; pos++)\n68\t    {\n69\t      cube[face][pos] = data[face][pos];\n70\t    }\n71\t  }\n72\t  return cube;\n73\t}\n74\t\n75\tvoid cube_free(cube_t cube)\n76\t{\n77\t  for(color face = RED; face <= WHITE; face++)\n78\t  {\n79\t    free(cube[face]);\n80\t  }\n81\t  free(cube);\n82\t}\n83\t\n84\tunsigned int cube_hash(const cube_t cube)\n85\t{\n86\t  unsigned int hash = 0;\n87\t  for(color face = RED; face <= WHITE; face++)\n88\t  {\n89\t    for(int pos = 0; pos < 4; pos++)\n90\t    {\n91\t      if(cube[face][2 * pos] != face || cube[face][2 * pos + 1] != face)\n92\t      {\n93\t        hash++;\n94\t      }\n95\t      hash = hash << 1;\n96\t    }\n97\t  }\n98\t  return hash;\n99\t}\n100\t\n101\tecube_t ecube_init(cube_t cube)\n102\t{\n103\t  ecube_t ecube = (ecube_t)malloc(sizeof(struct ecube_struct));\n104\t  ecube->cube = cube;\n105\t  ecube->entropy = find_entropy(cube);\n106\t  ecube->hash = cube_hash(cube);\n107\t  return ecube;\n108\t}\n109\t\n110\tcube_t cube_clone(cube_t cube)\n111\t{\n112\t  cube_t new_cube = (cube_t)malloc(sizeof(color *) * 6);\n113\t  for(color face = RED; face <= WHITE; face++)\n114\t  {\n115\t    new_cube[face] = (color *)(malloc(sizeof(color) * 8));\n116\t    for(int pos = 0; pos < 8; pos++)\n117\t    {\n118\t      new_cube[face][pos] = cube[face][pos];\n119\t    }\n120\t  }\n121\t  return new_cube;\n122\t}\n123\t\n124\tcube_t new_cube_rotate_face(const cube_t cube, color face, rotation direction)\n125\t{\n126\t  cube_t new_cube = cube_clone(cube);\n127\t  rotate_face(new_cube, face, direction);\n128\t  return new_cube;\n129\t}\n130\t\n131\tvoid rotate_face(cube_t cube, color face, rotation direction)\n132\t{\n133\t  assert(cube != NULL);\n134\t  /*\n135\t            + - - - +\n136\t            | 2 3 4 |\n137\t            | 1 G 5 |\n138\t            | 0 7 6 |\n139\t    + - - - + - - - + - - - + - - - +\n140\t    | 6 7 0 | 0 1 2 | 4 5 6 | 2 3 4 |      'R' will be rotated either CW/CCW\n141\t    | 5 B 1 | 7 R 3 | 3 W 7 | 1 O 5 |\n142\t    | 4 3 2 | 6 5 4 | 2 1 0 | 0 7 6 |\n143\t    + - - - + - - - + - - - + - - - +\n144\t            | 4 5 6 |\n145\t            | 3 Y 7 |\n146\t            | 2 1 0 |\n147\t            + - - - +\n148\t  */\n149\t  color g = top[face];\n150\t  color w = adjacent_cw(face, g);\n151\t  color y = adjacent_cw(face, w);\n152\t  color b = adjacent_cw(face, y);\n153\t  color temp;\n154\t  if(direction == CW)\n155\t  {\n156\t    // Swap G's (0,7,6) with W's (4,3,2)\n157\t    SWAP_COLOR(cube[g][0], cube[w][4]);\n158\t    SWAP_COLOR(cube[g][7], cube[w][3]);\n159\t    SWAP_COLOR(cube[g][6], cube[w][2]);\n160\t    /*\n161\t    do\n162\t    {\n163\t      color temp = cube[g][6];\n164\t      cube[g][6] = cube[w][2];\n165\t      cube[w][2] = temp;\n166\t    } while(0);\n167\t    */\n168\t    // Swap B's (2,1,0) with G's (0,7,6)\n169\t    SWAP_COLOR(cube[b][2], cube[g][0]);\n170\t    SWAP_COLOR(cube[b][1], cube[g][7]);\n171\t    SWAP_COLOR(cube[b][0], cube[g][6]);\n172\t    \n173\t    // Swap Y's (6,5,4) with B's (2,1,0)\n174\t    SWAP_COLOR(cube[y][6], cube[b][2]);\n175\t    SWAP_COLOR(cube[y][5], cube[b][1]);\n176\t    SWAP_COLOR(cube[y][4], cube[b][0]);\n177\t    \n178\t    // Rotating R's face CW\n179\t    temp = cube[face][0];\n180\t    cube[face][0] = cube[face][6];\n181\t    cube[face][6] = cube[face][4];\n182\t    cube[face][4] = cube[face][2];\n183\t    cube[face][2] = temp;\n184\t    temp = cube[face][1];\n185\t    cube[face][1] = cube[face][7];\n186\t    cube[face][7] = cube[face][5];\n187\t    cube[face][5] = cube[face][3];\n188\t    cube[face][3] = temp;\n189\t  }\n190\t  else// if(dir == CCW)\n191\t  {\n192\t    // Swap G's (0,7,6) with B's (2,1,0)\n193\t    SWAP_COLOR(cube[g][0], cube[b][2]);\n194\t    SWAP_COLOR(cube[g][7], cube[b][1]);\n195\t    SWAP_COLOR(cube[g][6], cube[b][0]);\n196\t    \n197\t    // Swap W's (4,3,2) with G's (0,7,6)\n198\t    SWAP_COLOR(cube[w][4], cube[g][0]);\n199\t    SWAP_COLOR(cube[w][3], cube[g][7]);\n200\t    SWAP_COLOR(cube[w][2], cube[g][6]);\n201\t    \n202\t    // Swap Y's (6,5,4) with W's (4,3,2)\n203\t    SWAP_COLOR(cube[y][6], cube[w][4]);\n204\t    SWAP_COLOR(cube[y][5], cube[w][3]);\n205\t    SWAP_COLOR(cube[y][4], cube[w][2]);\n206\t    \n207\t    // Rotating R's face CCW\n208\t    temp = cube[face][0];\n209\t    cube[face][0] = cube[face][2];\n210\t    cube[face][2] = cube[face][4];\n211\t    cube[face][4] = cube[face][6];\n212\t    cube[face][6] = temp;\n213\t    \n214\t    temp = cube[face][1];\n215\t    cube[face][1] = cube[face][3];\n216\t    cube[face][3] = cube[face][5];\n217\t    cube[face][5] = cube[face][7];\n218\t    cube[face][7] = temp;\n219\t  }\n220\t}\n221\t\n222\tvoid print_cube(const cube_t cube)\n223\t{\n224\t  for(color face = RED; face <= WHITE; face++)\n225\t  {\n226\t    printf(\"%c %c %c\\n%c %c %c\\n%c %c %c\\n\",\n227\t        color_code[cube[face][0]],\n228\t        color_code[cube[face][1]],\n229\t        color_code[cube[face][2]],\n230\t        color_code[cube[face][7]],\n231\t        color_code[face],\n232\t        color_code[cube[face][3]],\n233\t        color_code[cube[face][6]],\n234\t        color_code[cube[face][5]],\n235\t        color_code[cube[face][4]]\n236\t    );\n237\t    printf(\"-----\\n\");\n238\t  }\n239\t}\n240\t\n241\tbool cube_compare_equal(const cube_t cube1, const cube_t cube2)\n242\t{\n243\t  for(color face = RED; face <= WHITE; face++)\n244\t  {\n245\t    for(int pos = 0; pos < 8; pos++)\n246\t    {\n247\t      if(cube1[face][pos] != cube2[face][pos])\n248\t      {\n249\t        return false;\n250\t      }\n251\t    }\n252\t  }\n253\t  return true;\n254\t}\n255\t\n256\tint find_entropy(const cube_t cube)\n257\t{\n258\t  int count = 0;\n259\t  for(color face = RED; face <= WHITE; face++)\n260\t  {\n261\t    for(int pos = 0; pos < 8; pos++)\n262\t    {\n263\t      if(cube[face][pos] != face)\n264\t        count++;\n265\t    } \n266\t  }\n267\t  return count;\n268\t}\n269\t\n270\tvoid test_adj_functions()\n271\t{\n272\t  printf(\"Testing adjacent_cw...\\n\");\n273\t  assert_verbose(adjacent_cw(RED, YELLOW) == BLUE);\n274\t  assert_verbose(adjacent_cw(RED, BLUE) == GREEN);\n275\t  assert_verbose(adjacent_cw(RED, WHITE) == YELLOW);\n276\t  assert_verbose(adjacent_cw(RED, GREEN) == WHITE);\n277\t  assert_verbose(adjacent_cw(GREEN, RED) == BLUE);\n278\t  assert_verbose(adjacent_cw(GREEN, WHITE) == RED);\n279\t  assert_verbose(adjacent_cw(GREEN, ORANGE) == WHITE);\n280\t  assert_verbose(adjacent_cw(GREEN, BLUE) == ORANGE);\n281\t  assert_verbose(adjacent_cw(WHITE, ORANGE) == YELLOW);\n282\t  assert_verbose(adjacent_cw(WHITE, GREEN) == ORANGE);\n283\t  assert_verbose(adjacent_cw(YELLOW, WHITE) == ORANGE);\n284\t  assert_verbose(adjacent_cw(YELLOW, RED) == WHITE);\n285\t  \n286\t  printf(\"Testing adjacent_ccw...\\n\");\n287\t  assert_verbose(adjacent_ccw(RED, BLUE) == YELLOW);\n288\t  assert_verbose(adjacent_ccw(RED, GREEN == BLUE));\n289\t  assert_verbose(adjacent_ccw(RED, YELLOW) == WHITE);\n290\t  assert_verbose(adjacent_ccw(RED, WHITE) == GREEN);\n291\t  assert_verbose(adjacent_ccw(GREEN, BLUE) == RED);\n292\t  assert_verbose(adjacent_ccw(GREEN, RED) == WHITE);\n293\t  assert_verbose(adjacent_ccw(GREEN, WHITE) == ORANGE);\n294\t  assert_verbose(adjacent_ccw(GREEN, ORANGE) == BLUE);\n295\t  assert_verbose(adjacent_ccw(WHITE, YELLOW) == ORANGE);\n296\t  assert_verbose(adjacent_ccw(WHITE, ORANGE) == GREEN);\n297\t  assert_verbose(adjacent_ccw(YELLOW, ORANGE) == WHITE);\n298\t  assert_verbose(adjacent_ccw(YELLOW, WHITE) == RED);\n299\t}\n300\t"}]},"parent_tool_use_id":null,"session_id":"fddae06e-4458-4de3-8d1c-50eb4c6a59f7","uuid":"94c0c61e-12d8-432d-9696-0380a00053bc","timestamp":"2026-06-05T23:26:05.153Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-ShrIpr/project/c_src/rubik_model.c","content":"#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n\n#include \"rubik_model.h\"\n\nstatic color adjacent_left(color rotating_face, color around)\n{\n  color l_around = CYCLE_L(around);\n  if(l_around == REAR(rotating_face) || l_around == rotating_face)\n  {\n    return CYCLE_L(l_around);\n  }\n  return l_around;\n}\n\nstatic color adjacent_right(color rotating_face, color around)\n{\n  color r_around = CYCLE_R(around);\n  if(r_around == REAR(rotating_face) || r_around == rotating_face)\n  {\n    return CYCLE_R(r_around);\n  }\n  return r_around;\n}\n\nstatic color adjacent_cw(color rotating_face, color around)\n{\n  assert(around != REAR(rotating_face));\n  if(IS_ODD(rotating_face))\n  {\n    return adjacent_right(rotating_face, around);\n  }\n  return adjacent_left(rotating_face, around);\n}\n\nstatic color adjacent_ccw(color rotating_face, color around)\n{\n  assert(around != REAR(rotating_face));\n  if(IS_ODD(rotating_face))\n  {\n    return adjacent_left(rotating_face, around);\n  }\n  return adjacent_right(rotating_face, around);\n}\n\ncube_t populate_initial()\n{\n  cube_t cube = (color **)(malloc(sizeof(color *) * 6));\n  for(color face = RED; face <= WHITE; face++)\n  {\n    cube[face] = (color *)(malloc(sizeof(color) * 8));\n    for(int pos = 0; pos < 8; pos++)\n    {\n      cube[face][pos] = face;\n    }\n  }\n  return cube;\n}\n\ncube_t populate_specific(const color data[][8])\n{\n  cube_t cube = (color **)(malloc(sizeof(color *) * 6));\n  for(color face = RED; face <= WHITE; face++)\n  {\n    cube[face] = (color *)(malloc(sizeof(color) * 8));\n    for(int pos = 0; pos < 8; pos++)\n    {\n      cube[face][pos] = data[face][pos];\n    }\n  }\n  return cube;\n}\n\nvoid cube_free(cube_t cube)\n{\n  for(color face = RED; face <= WHITE; face++)\n  {\n    free(cube[face]);\n  }\n  free(cube);\n}\n\nunsigned int cube_hash(const cube_t cube)\n{\n  unsigned int hash = 0;\n  for(color face = RED; face <= WHITE; face++)\n  {\n    for(int pos = 0; pos < 4; pos++)\n    {\n      if(cube[face][2 * pos] != face || cube[face][2 * pos + 1] != face)\n      {\n        hash++;\n      }\n      hash = hash << 1;\n    }\n  }\n  return hash;\n}\n\necube_t ecube_init(cube_t cube)\n{\n  ecube_t ecube = (ecube_t)malloc(sizeof(struct ecube_struct));\n  ecube->cube = cube;\n  ecube->entropy = find_entropy(cube);\n  ecube->hash = cube_hash(cube);\n  return ecube;\n}\n\ncube_t cube_clone(cube_t cube)\n{\n  cube_t new_cube = (cube_t)malloc(sizeof(color *) * 6);\n  for(color face = RED; face <= WHITE; face++)\n  {\n    new_cube[face] = (color *)(malloc(sizeof(color) * 8));\n    for(int pos = 0; pos < 8; pos++)\n    {\n      new_cube[face][pos] = cube[face][pos];\n    }\n  }\n  return new_cube;\n}\n\ncube_t new_cube_rotate_face(const cube_t cube, color face, rotation direction)\n{\n  cube_t new_cube = cube_clone(cube);\n  rotate_face(new_cube, face, direction);\n  return new_cube;\n}\n\nvoid rotate_face(cube_t cube, color face, rotation direction)\n{\n  assert(cube != NULL);\n  /*\n            + - - - +\n            | 2 3 4 |\n            | 1 G 5 |\n            | 0 7 6 |\n    + - - - + - - - + - - - + - - - +\n    | 6 7 0 | 0 1 2 | 4 5 6 | 2 3 4 |      'R' will be rotated either CW/CCW\n    | 5 B 1 | 7 R 3 | 3 W 7 | 1 O 5 |\n    | 4 3 2 | 6 5 4 | 2 1 0 | 0 7 6 |\n    + - - - + - - - + - - - + - - - +\n            | 4 5 6 |\n            | 3 Y 7 |\n            | 2 1 0 |\n            + - - - +\n  */\n  color g = top[face];\n  color w = adjacent_cw(face, g);\n  color y = adjacent_cw(face, w);\n  color b = adjacent_cw(face, y);\n  color temp;\n  if(direction == CW)\n  {\n    // Swap G's (0,7,6) with W's (4,3,2)\n    SWAP_COLOR(cube[g][0], cube[w][4]);\n    SWAP_COLOR(cube[g][7], cube[w][3]);\n    SWAP_COLOR(cube[g][6], cube[w][2]);\n    /*\n    do\n    {\n      color temp = cube[g][6];\n      cube[g][6] = cube[w][2];\n      cube[w][2] = temp;\n    } while(0);\n    */\n    // Swap B's (2,1,0) with G's (0,7,6)\n    SWAP_COLOR(cube[b][2], cube[g][0]);\n    SWAP_COLOR(cube[b][1], cube[g][7]);\n    SWAP_COLOR(cube[b][0], cube[g][6]);\n    \n    // Swap Y's (6,5,4) with B's (2,1,0)\n    SWAP_COLOR(cube[y][6], cube[b][2]);\n    SWAP_COLOR(cube[y][5], cube[b][1]);\n    SWAP_COLOR(cube[y][4], cube[b][0]);\n    \n    // Rotating R's face CW\n    temp = cube[face][0];\n    cube[face][0] = cube[face][6];\n    cube[face][6] = cube[face][4];\n    cube[face][4] = cube[face][2];\n    cube[face][2] = temp;\n    temp = cube[face][1];\n    cube[face][1] = cube[face][7];\n    cube[face][7] = cube[face][5];\n    cube[face][5] = cube[face][3];\n    cube[face][3] = temp;\n  }\n  else// if(dir == CCW)\n  {\n    // Swap G's (0,7,6) with B's (2,1,0)\n    SWAP_COLOR(cube[g][0], cube[b][2]);\n    SWAP_COLOR(cube[g][7], cube[b][1]);\n    SWAP_COLOR(cube[g][6], cube[b][0]);\n    \n    // Swap W's (4,3,2) with G's (0,7,6)\n    SWAP_COLOR(cube[w][4], cube[g][0]);\n    SWAP_COLOR(cube[w][3], cube[g][7]);\n    SWAP_COLOR(cube[w][2], cube[g][6]);\n    \n    // Swap Y's (6,5,4) with W's (4,3,2)\n    SWAP_COLOR(cube[y][6], cube[w][4]);\n    SWAP_COLOR(cube[y][5], cube[w][3]);\n    SWAP_COLOR(cube[y][4], cube[w][2]);\n    \n    // Rotating R's face CCW\n    temp = cube[face][0];\n    cube[face][0] = cube[face][2];\n    cube[face][2] = cube[face][4];\n    cube[face][4] = cube[face][6];\n    cube[face][6] = temp;\n    \n    temp = cube[face][1];\n    cube[face][1] = cube[face][3];\n    cube[face][3] = cube[face][5];\n    cube[face][5] = cube[face][7];\n    cube[face][7] = temp;\n  }\n}\n\nvoid print_cube(const cube_t cube)\n{\n  for(color face = RED; face <= WHITE; face++)\n  {\n    printf(\"%c %c %c\\n%c %c %c\\n%c %c %c\\n\",\n        color_code[cube[face][0]],\n        color_code[cube[face][1]],\n        color_code[cube[face][2]],\n        color_code[cube[face][7]],\n        color_code[face],\n        color_code[cube[face][3]],\n        color_code[cube[face][6]],\n        color_code[cube[face][5]],\n        color_code[cube[face][4]]\n    );\n    printf(\"-----\\n\");\n  }\n}\n\nbool cube_compare_equal(const cube_t cube1, const cube_t cube2)\n{\n  for(color face = RED; face <= WHITE; face++)\n  {\n    for(int pos = 0; pos < 8; pos++)\n    {\n      if(cube1[face][pos] != cube2[face][pos])\n      {\n        return false;\n      }\n    }\n  }\n  return true;\n}\n\nint find_entropy(const cube_t cube)\n{\n  int count = 0;\n  for(color face = RED; face <= WHITE; face++)\n  {\n    for(int pos = 0; pos < 8; pos++)\n    {\n      if(cube[face][pos] != face)\n        count++;\n    } \n  }\n  return count;\n}\n\nvoid test_adj_functions()\n{\n  printf(\"Testing adjacent_cw...\\n\");\n  assert_verbose(adjacent_cw(RED, YELLOW) == BLUE);\n  assert_verbose(adjacent_cw(RED, BLUE) == GREEN);\n  assert_verbose(adjacent_cw(RED, WHITE) == YELLOW);\n  assert_verbose(adjacent_cw(RED, GREEN) == WHITE);\n  assert_verbose(adjacent_cw(GREEN, RED) == BLUE);\n  assert_verbose(adjacent_cw(GREEN, WHITE) == RED);\n  assert_verbose(adjacent_cw(GREEN, ORANGE) == WHITE);\n  assert_verbose(adjacent_cw(GREEN, BLUE) == ORANGE);\n  assert_verbose(adjacent_cw(WHITE, ORANGE) == YELLOW);\n  assert_verbose(adjacent_cw(WHITE, GREEN) == ORANGE);\n  assert_verbose(adjacent_cw(YELLOW, WHITE) == ORANGE);\n  assert_verbose(adjacent_cw(YELLOW, RED) == WHITE);\n  \n  printf(\"Testing adjacent_ccw...\\n\");\n  assert_verbose(adjacent_ccw(RED, BLUE) == YELLOW);\n  assert_verbose(adjacent_ccw(RED, GREEN == BLUE));\n  assert_verbose(adjacent_ccw(RED, YELLOW) == WHITE);\n  assert_verbose(adjacent_ccw(RED, WHITE) == GREEN);\n  assert_verbose(adjacent_ccw(GREEN, BLUE) == RED);\n  assert_verbose(adjacent_ccw(GREEN, RED) == WHITE);\n  assert_verbose(adjacent_ccw(GREEN, WHITE) == ORANGE);\n  assert_verbose(adjacent_ccw(GREEN, ORANGE) == BLUE);\n  assert_verbose(adjacent_ccw(WHITE, YELLOW) == ORANGE);\n  assert_verbose(adjacent_ccw(WHITE, ORANGE) == GREEN);\n  assert_verbose(adjacent_ccw(YELLOW, ORANGE) == WHITE);\n  assert_verbose(adjacent_ccw(YELLOW, WHITE) == RED);\n}\n","numLines":300,"startLine":1,"totalLines":300}}}
