{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_3wzic37ozcgjkphehgggr5tg43klmqwkziaqcqydrhqbejegxooa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_013XjmpXVVqt7CkaZv75TMJW","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-ShrIpr/project/src/heap.rs","content":"/// A custom binary heap that stores elements in a Vec and uses a custom comparator.\npub struct Heap<T> {\n    data: Vec<T>,\n    comparator: Box<dyn Fn(&T, &T) -> bool>,\n}\nimpl<T> Heap<T> {\n    /// Creates a new heap with the given initial capacity and comparator.\n    pub fn new(init_size: usize, comparator: impl Fn(&T, &T) -> bool + 'static) -> Self {\n        Self {\n            data: Vec::with_capacity(init_size),\n            comparator: Box::new(comparator),\n        }\n    }\n    /// Returns true if the heap is empty.\n    pub fn is_empty(&self) -> bool {\n        self.data.is_empty()\n    }\n    /// Returns a reference to the minimum element (if any).\n    pub fn find_min(&self) -> Option<&T> {\n        self.data.first()\n    }\n    /// Inserts an element into the heap.\n    pub fn insert(&mut self, element: T) {\n        self.data.push(element);\n        let mut son = self.data.len() - 1;\n        while son > 0 {\n            let parent = (son - 1) / 2;\n            if (self.comparator)(&self.data[son], &self.data[parent]) {\n                self.data.swap(parent, son);\n                son = parent;\n            } else {\n                break;\n            }\n        }\n    }\n    /// Removes and returns the minimum element, or None if empty.\n    pub fn delete_min(&mut self) -> Option<T> {\n        if self.data.is_empty() {\n            return None;\n        }\n        let last_idx = self.data.len() - 1;\n        self.data.swap(0, last_idx);\n        let min = self.data.pop();\n        let len = self.data.len();\n        if len == 0 {\n            return min;\n        }\n        let mut parent = 0usize;\n        loop {\n            let son1 = 2 * parent + 1;\n            let son2 = 2 * parent + 2;\n            let son = if son1 < len {\n                if son2 < len {\n                    if (self.comparator)(&self.data[son1], &self.data[son2]) {\n                        son1\n                    } else {\n                        son2\n                    }\n                } else {\n                    son1\n                }\n            } else {\n                break;\n            };\n            if (self.comparator)(&self.data[son], &self.data[parent]) {\n                self.data.swap(parent, son);\n            }\n            parent = son;\n        }\n        min\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1055,"cache_read_input_tokens":39515,"cache_creation":{"ephemeral_5m_input_tokens":1055,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fddae06e-4458-4de3-8d1c-50eb4c6a59f7","uuid":"3669422a-3e79-407d-bf89-a2e0767bf8d5"}
