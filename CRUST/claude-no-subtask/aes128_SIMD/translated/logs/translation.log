ded key schedule.\npub fn inv_cipher(in_data: &[u8; 4 * NB], out: &mut [u8; 4 * NB], w: &[u8; 4 * NB * (NR + 1)]) {\n    let mut state = load_state(in_data);\n\n    let rk_final = round_key(w, NR * 4 * NB);\n    add(&mut state, &rk_final);\n\n    for round in (1..NR).rev() {\n        inv_shift(&mut state);\n        inv_sub(&mut state);\n        let rk = round_key(w, round * 4 * NB);\n        add(&mut state, &rk);\n        inv_columns(&mut state);\n    }\n\n    inv_shift(&mut state);\n    inv_sub(&mut state);\n    let rk0 = round_key(w, 0);\n    add(&mut state, &rk0);\n\n    store_state(&state, out);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1855,"cache_read_input_tokens":46895,"cache_creation":{"ephemeral_5m_input_tokens":1855,"ephemeral_1h_input_tokens":0},"output_tokens":45,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"d5effc3d-f760-4234-b169-646da141d61e","uuid":"04c8d7e9-1c53-4722-866e-50f8422aeed4"}
