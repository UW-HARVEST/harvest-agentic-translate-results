i * 64 + t * 4;\n            let arr = [buf[p], buf[p + 1], buf[p + 2], buf[p + 3]];\n            w[t] = pack32(&arr);\n        }\n        for t in 16..80 {\n            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);\n        }\n\n        let mut a = h[0];\n        let mut b = h[1];\n        let mut c = h[2];\n        let mut d = h[3];\n        let mut e = h[4];\n\n        for t in 0..80 {\n            let f = if t < 20 {\n                (b & c) ^ (!b & d)\n            } else if t < 40 {\n                b ^ c ^ d\n            } else if t < 60 {\n                (b & c) ^ (b & d) ^ (c & d)\n            } else {\n                b ^ c ^ d\n            };\n\n            let big_t = rotl(a, 5)\n                .wrapping_add(f)\n                .wrapping_add(e)\n                .wrapping_add(K[t / 20])\n                .wrapping_add(w[t]);\n            e = d;\n            d = c;\n            c = rotl(b, 30);\n            b = a;\n            a = big_t;\n        }\n\n        h[0] = h[0].wrapping_add(a);\n        h[1] = h[1].wrapping_add(b);\n        h[2] = h[2].wrapping_add(c);\n        h[3] = h[3].wrapping_add(d);\n        h[4] = h[4].wrapping_add(e);\n    }\n\n    for i in 0..5 {\n        let mut tmp = [0u8; 4];\n        unpack32(h[i], &mut tmp);\n        hash[i * 4] = tmp[0];\n        hash[i * 4 + 1] = tmp[1];\n        hash[i * 4 + 2] = tmp[2];\n        hash[i * 4 + 3] = tmp[3];\n    }\n\n    TOTP_OK\n}\n\npub fn from_base32(s: &str, buf: &mut [u8], cap: usize) -> usize {\n    let bytes = s.as_bytes();\n    let s_len = std::strlen(s);\n\n    if s_len % 8 != 0 {\n        return 0;\n    }\n    if cap < (s_len + 1) / 8 * 5 {\n        return 0;\n    }\n\n    let mut v = [0u8; 8];\n    let mut i = 0;\n    while i * 8 < s_len {\n        for j in 0..8 {\n            let c = bytes[i * 8 + j] as char;\n            if c == '=' {\n                v[j] = 0;\n            } else if c >= 'A' && c <= 'Z' {\n                v[j] = (c as u8) - b'A';\n            } else if