n    }\n}\n\n/// Frees the sparse dictionary. (No-op besides dropping the box.)\npub fn sparse_dict_free(_dict: Box<SparseDict>) -> i32 {\n    1\n}\n","structuredPatch":[{"oldStart":388,"oldLines":7,"newStart":388,"newLines":6,"lines":["                 if sparse_array_set(arr, probed_val, &serialized, len) == 0 {","                     return 0;","                 }","-                inserted_new = true;","                 break;","             }","             Action::SameKey => {"]}],"userModified":false,"replaceAll":false}}
