                                           set to 0 if command completed\n119\t\t                                             successfully */\n120\t\n121\t/**\n122\t * Parses the command line of a program\n123\t * and returns the number of non-options\n124\t * returned to the `extras' pointer (see\n125\t * below)\n126\t */\n127\tint\n128\txopt_parse(\n129\t\txoptContext             *ctx,             /* previously created XOpt context */\n130\t\tint                     argc,             /* argc, from int main() */\n131\t\tconst char              **argv,           /* argv, from int main() */\n132\t\tvoid                    *data,            /* a custom data object whos type\n133\t\t                                             corresponds to `.offset' values\n134\t\t                                             specified in the options list;\n135\t\t                                             populated with values interpreted\n136\t\t                                             from the command line */\n137\t\tconst char              ***extras,        /* receives a list of extra non-option\n138\t\t                                             arguments (i.e. files, subcommands,\n139\t\t                                             etc.) - length of which is returned\n140\t\t                                             by the function call */\n141\t\tconst char              **err);           /* pointer to a const char* that\n142\t\t                                             receives an err should one occur -\n143\t\t                                             set to 0 if command completed\n144\t\t                                             successfully */\n145\t\n146\t/**\n147\t * Generates and prints a help message\n148\t * and prints it to a FILE stream.\n149\t * If `defaults' is supplied, uses\n150\t * offsets (values) defined by the options\n151\t * list to show default options\n152\t */\n153\tvoid\n154\txopt_autohelp(\n155\t\txoptContext                 *ctx,         /* previously created XOpt context */\n156\t\tFILE                        *stream,      /* a stream to print to - if 0,\n157\t\t                                             defaults to `stderr'. */\n158\t\tconst xoptAutohelpOptions   *options,     /* configuration options to tailor\n159\t\t                                             autohelp output */\n160\t\tconst char                  **err);       /* pointer to a const char* that\n161\t\t                                             receives an err should one occur -\n162\t\t                                             set to 0 if command completed\n163\t\t                                             successfully */\n164\t\n165\t/**\n166\t * Generates a default option parser that's sane for most cases.\n167\t *\n168\t * Assumes there's a `help` property that is boolean-checkable that exists on the\n169\t * config pointer passed to `config_ptr` (i.e. does a lookup of `config_ptr->help`).\n170\t *\n171\t * In the event help is invoked, xopt will `goto xopt_help`. It is up to you to define such\n172\t * a label in order to recover. In this case, extrav will still be allocated and will still need to be\n173\t * freed.\n174\t *\n175\t * To be extra clear, you need to free `extrav_ptr` is if `*err_ptr` is not `NULL`.\n176\t *\n177\t * `name` is the name of the binary you'd like to pass to the context (welcome to use `argv[0]` here),\n178\t * `options` is a reference to the xoptOptions array you've specified,\n179\t * `config_ptr` is a *pointer* to your configuration instance,\n180\t * `argc` and `argv` are the int/const char ** passed into main,\n181\t * `extrac_ptr` and `extrav_ptr` are pointers to an `int`/`const char **`\n182\t *    (so `int*` and `const char ***`, respectively) that receive the parsed extra args\n183\t *    (note that, unless there is an error, `extrav_ptr` is owned by your program and must\n184\t *    be `free()`'d when you're done using it, even if there are zero extra arguments),\n185\t *  and `err_ptr` is a pointer to a `const char *` (so a `const char **`) that receives any error\n186\t *    strings in the event of a problem. These errors are statically allocated so no need to\n187\t *    free them. This variable should be initialized to NULL and checked after calling\n188\t *    `XOPT_SIMPLE_PARSE()`.\n189\t *\n190\t *  `autohelp_file`, `autohelp_usage`, `autohelp_prefix`, `autohelp_suffix` and `autohelp_spacer` are all\n191\t *  parameters to the `xoptAutohelpOptions` struct (with the exception of `autohelp_file`, which must be a\n192\t *  `FILE*` reference (e.g. `stdout` or `stderr`) which receives the rendered autohelp text). Consult the\n193\t *  `xoptAutohelpOptions` struct above for documentation as to valid values for each of these properties.\n194\t */\n195\t#define XOPT_SIMPLE_PARSE(name, options, config_ptr, argc, argv, extrac_ptr, extrav_ptr, err_ptr, autohelp_file, autohelp_usage, autohelp_prefix, autohelp_suffix, autohelp_spacer) do { \\\n196\t\t\txoptContext *_xopt_ctx; \\\n197\t\t\t\\\n198\t\t\t*(err_ptr) = NULL; \\\n199\t\t\t\\\n200\t\t\t_xopt_ctx = xopt_context((name), (options), XOPT_CTX_POSIXMEHARDER | XOPT_CTX_STRICT, (err_ptr)); \\\n201\t\t\tif (*(err_ptr)) break; \\\n202\t\t\t\\\n203\t\t\t*extrac_ptr = xopt_parse(_xopt_ctx, (argc), (argv), (config_ptr), (extrav_ptr), (err_ptr)); \\\n204\t\t\tif (*(err_ptr)) goto __xopt_end_free_ctx; \\\n205\t\t\t\\\n206\t\t\tif ((config_ptr)->help) { \\\n207\t\t\t\txoptAutohelpOptions __xopt_autohelp_opts; \\\n208\t\t\t\t__xopt_autohelp_opts.usage = (autohelp_usage); \\\n209\t\t\t\t__xopt_autohelp_opts.prefix = (autohelp_prefix); \\\n210\t\t\t\t__xopt_autohelp_opts.suffix = (autohelp_suffix); \\\n211\t\t\t\t__xopt_autohelp_opts.spacer = (autohelp_spacer); \\\n212\t\t\t\txopt_autohelp(_xopt_ctx, (autohelp_file), &__xopt_autohelp_opts, (err_ptr)); \\\n213\t\t\t\tif (*(err_ptr)) goto __xopt_end_free_extrav; \\\n214\t\t\t\tgoto xopt_help; \\\n215\t\t\t} \\\n216\t\t\\\n217\t\t__xopt_end_free_ctx: \