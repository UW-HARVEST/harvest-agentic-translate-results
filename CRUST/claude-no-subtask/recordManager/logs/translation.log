ad a block \n137\tRC readBlock(int pageNum, SM_FileHandle *fHandle, SM_PageHandle memPage) {\n138\t    long offset;\n139\t    int FILE_RC;\n140\t    int Action, maxTrial = 1; \n141\t    if (pageNum < 0 || pageNum >= fHandle->totalNumPages) {\n142\t        return RC_READ_NON_EXISTING_PAGE;\n143\t    }\n144\t    offset = (pageNum + 1) * PAGE_SIZE;\n145\t    FILE_RC = fseek(fHandle->mgmtInfo, offset, SEEK_SET);\n146\t    if (FILE_RC != 0) {\n147\t        return RC_SEEK_FAILED;\n148\t    }\n149\t    for (Action = 0; Action < maxTrial; Action++) {\n150\t        FILE_RC = fread(memPage, PAGE_SIZE, 1, fHandle->mgmtInfo);\n151\t        if (FILE_RC == 1) {\n152\t            break;\n153\t        }\n154\t    }\n155\t    if (FILE_RC != 1) {\n156\t        return RC_READ_FAILED;\n157\t    }\n158\t    fHandle->curPagePos = pageNum;\n159\t    return RC_OK;\n160\t}\n161\t\n162\t// Define Read first block \n163\tRC readFirstBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n164\t    int read_code;\n165\t    const int maxTrial = 3; \n166\t    int Action = 0;\n167\t    for (Action = 0; Action < maxTrial; Action++) {\n168\t        read_code = readBlock(0, fHandle, memPage);\n169\t        if (read_code == RC_OK) {\n170\t            break;\n171\t        } else {\n172\t            printf(\"Action %d to read the first block failed. Retrying...\\n\", Action + 1);\n173\t        }\n174\t    }\n175\t    return read_code;\n176\t}\n177\t\n178\t// Define Read Last block\n179\tRC readLastBlock(SM_FileHandle *fHandle, SM_PageHandle memPage) {\n180\t    int read_code;\n181\t    int pageNum;\n182\t    const int maxTrial = 3; \n183\t    int Action = 0;\n184\t    pageNum = fHandle->totalNumPages - 1;\n185\t    if (pageNum < 0) {\n186\t        return RC_READ_NON_EXISTING_PAGE;\n187\t    }\n188\t    for (Action = 0; Action < maxTrial; Action++) {\n189\t        read_code = readBlock(pageNum, fHandle, memPage);\n190\t        if (read_code == RC_OK) {\n191\t            break;\n192\t        } \n193\t    