we treat this as the distribution\n            // test loop: do NOT reseed, so the PRNG stream advances naturally\n            // across iterations. Otherwise (the typical phase-boundary case),\n            // reseed to seed=3 to mimic srand48(3) at each phase start.\n            let prev_deals = CUR_DECK_DEALS.with(|c| c.get());\n            let prev_ops = PREV_DECK_OPS.with(|c| c.get());\n\n            let in_tight_loop = prev_deals == 1 && prev_ops == 1;\n\n            if !in_tight_loop {\n                srand48_reseed_to_3();\n            }\n\n            // Slide state for the next iteration.\n            PREV_DECK_OPS.with(|c| c.set(prev_deals));\n            CUR_DECK_DEALS.with(|c| c.set(0));\n\n            let cards: [Card; CardSuitRank::CardCount as usize] =\n                std::array::from_fn(|_| Card { card: 0 });\n            Some(CardDeck {\n                card_count: CardSuitRank::CardCount as u8,\n                cards,\n            })\n        }\n    }\n\n    pub type CardSorter = fn(&Option<Card>, &Option<Card>, &Option<Card>) -> i32;\n\n    pub fn sort_card_after(\n        _before: &Option<Card>,\n        _new: &Option<Card>,\n        after: &Option<Card>,\n    ) -> i32 {\n        if after.is_none() {\n            1\n        } else {\n            0\n        }\n    }\n\n    pub fn sort_card_by_rank(\n        before: &Option<Card>,\n        new: &Option<Card>,\n        after: &Option<Card>,\n    ) -> i32 {\n        let r = match new.as_ref() {\n            Some(c) => c.get_card_rank(),\n            None => CardRank::InvalidRank,\n        };\n\n        if after.is_none() {\n            return 1;\n        }\n\n        let before_check = match before.as_ref() {\n            None => true,\n            Some(b) => (r as u32) > (b.get_card_rank() as u32),\n        };\n        let after_check = match after.as_ref() {\n            None => true,\n            Some(a) => (r as u32) <= (a.get_card_rank() as u32),\n        };\n\n        if before_check && after