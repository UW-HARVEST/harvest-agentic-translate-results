keeps).  Trim to mimic typical usage.\n    let signal_id_trimmed = trim_ascii(&signal_id_bytes);\n\n    if signal_id_trimmed.len() > 1 {\n        return true;\n    }\n    if signal_id_trimmed.is_empty() {\n        return false;\n    }\n\n    let id_str = std::str::from_utf8(signal_id_trimmed).unwrap_or(\"\");\n    let index = match get_signal_index(id_str) {\n        Some(i) => i,\n        None => return true,\n    };\n    if index >= vcd.signals.len() {\n        return true;\n    }\n\n    let mut value_arr = [0u8; VCD_SIGNAL_SIZE];\n    let value_trimmed = trim_ascii(&value_bytes);\n    copy_into_fixed(&mut value_arr, value_trimmed);\n\n    vcd.signals[index].value_changes.push(ValueChange {\n        timestamp,\n        value: value_arr,\n    });\n\n    true\n}\n\nfn trim_ascii(bytes: &[u8]) -> &[u8] {\n    let mut start = 0;\n    let mut end = bytes.len();\n    while start < end && (bytes[start] as char).is_ascii_whitespace() {\n        start += 1;\n    }\n    while end > start && (bytes[end - 1] as char).is_ascii_whitespace() {\n        end -= 1;\n    }\n    &bytes[start..end]\n}\n","structuredPatch":[{"oldStart":15,"oldLines":27,"newStart":15,"newLines":27,"lines":[" pub const VCD_VERSION_SIZE: usize = 64;"," pub const VCD_DATE_SIZE: usize = 64;"," pub type Timestamp = u32;","-#[derive(Debug, Clone, Copy)]","+#[derive(Debug, Clone)]"," pub struct ValueChange {","     pub timestamp: Timestamp,","-    pub value: [u8; VCD_SIGNAL_SIZE], // Fixed-size array instead of C char array","+    pub value: Vec<u8>,"," }"," #[derive(Debug)]"," pub struct Signal {","-    pub name: [u8; VCD_NAME_SIZE],","+    pub name: Vec<u8>,","     pub size: usize,","     pub value_changes: Vec<ValueChange>,"," }"," #[derive(Debug)]"," pub struct Timescale {","-    pub unit: [u8; VCD_TIME_UNIT_SIZE], // Fixed-size array replacing C char array","+    pub unit: Vec<u8>,","     pub scale: usize,"," }"," #[derive(Debug)]"," pub struct VCD {","     pub signals: Vec<Signal>,","-    pub date: [u8; 