        if *state == State::InsideInnerModules {\n            // fscanf(file, \" %*[^\\n]\\n\");\n            cursor.skip_whitespace();\n            // skip up to and including '\\n'\n            let _ = cursor.read_until_any(b\"\\n\");\n            cursor.skip_if(b'\\n');\n            return true;\n        }\n\n        // fscanf(file, \" %*s %zu %[^ ] %[^ $]%*[^$]\", &signal->size, signal_id, signal->name);\n        // skip leading whitespace, then a \"%*s\" word (the type, e.g. \"wire\").\n        let _ = read_token_bytes(cursor); // type word\n        // Then read the size as a usize.\n        let size: usize = match cursor.read_uint() {\n            Some(s) => s,\n            None => return true,\n        };\n        // %[^ ] : read until a space (skipping leading whitespace).\n        cursor.skip_whitespace();\n        let id_bytes = cursor.read_until_any(b\" \");\n        // %[^ $] : skip the space, then read until either a space or '$'.\n        // The leading separator (a single space) is consumed by the format\n        // matcher.\n        cursor.skip_if(b' ');\n        let name_bytes = cursor.read_until_any(b\" $\");\n        // %*[^$] : consume everything up to the next '$'.\n        let _ = cursor.read_until_any(b\"$\");\n\n        let trimmed = trim_ascii(&name_bytes);\n        let signal = Signal {\n            name: trimmed.to_vec(),\n            size,\n            value_changes: Vec::new(),\n        };\n        let _ = id_bytes;\n        vcd.signals.push(signal);\n        return true;\n    }\n\n    if instruction == \"date\" {\n        // fscanf(file, \"\\n%[^$\\n]\", vcd->date);\n        cursor.skip_if(b'\\n');\n        let date_bytes = cursor.read_until_any(b\"$\\n\");\n        vcd.date = trim_ascii(&date_bytes).to_vec();\n        return true;\n    }\n\n    if instruction == \"version\" {\n        cursor.skip_if(b'\\n');\n        let version_bytes = cursor.read_until_any(b\"$\\n\");\n        vcd.version = trim_ascii(&version_bytes).to_vec();\n     