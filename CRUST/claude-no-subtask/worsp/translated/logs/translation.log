<s_expression>\n123\t//                        | <list>\n124\t//                        | <symbol>\n125\t//                        | <literal>\n126\t//     <s_expression>     ::= \"(\" <expression>* \")\"\n127\t//     <list>             ::= \"'(\" <expression>* \")\"\n128\t//     <symbol>           ::= <symbol_name>\n129\t//     <literal>          ::=\n130\t//                         | <interger_literal>\n131\t//                         | <string_literal>\n132\t//                         | <boolean_literal>\n133\t//     <interger_literal> ::= '1' | '2' | '3' | ...\n134\t//     <string_literal>   ::= '\"' <letter>* '\"'\n135\t//     <letter>           ::= 'a' | 'b' | 'c' | ...\n136\t//     <boolean_literal>  ::= 'true' | 'false'\n137\t// =================================================\n138\t\n139\tvoid appendExpressionToListExpression(struct ListNode *listNode,\n140\t                                      struct ExpressionNode *expression) {\n141\t  struct ExpressionList *expressions = malloc(sizeof(struct ExpressionList));\n142\t  expressions->expression = expression;\n143\t  expressions->next = NULL;\n144\t  if (listNode->expressions == NULL) {\n145\t    listNode->expressions = expressions;\n146\t    return;\n147\t  }\n148\t  struct ExpressionList *current = listNode->expressions;\n149\t  while (current->next != NULL) {\n150\t    current = current->next;\n151\t  }\n152\t  current->next = expressions;\n153\t}\n154\t\n155\tvoid appendExpressionToSymbolicExpression(\n156\t    struct SymbolicExpNode *symbolicExpNode,\n157\t    struct ExpressionNode *expression) {\n158\t  struct ExpressionList *expressions = malloc(sizeof(struct ExpressionList));\n159\t  expressions->expression = expression;\n160\t  expressions->next = NULL;\n161\t  if (symbolicExpNode->expressions == NULL) {\n162\t    symbolicExpNode->expressions = expressions;\n163\t    return;\n164\t  }\n165\t  struct ExpressionList *current = symbolicExpNode->expressions;\n166\t  while (current->next != NULL) {\n167\t    current = current->next;\n168\t  }\n169\t  current->next = expressions;\n170\t}\n171\t\n172\tvoid parseExpression(char *source, struct ParseState *state,\n173\t                     struct ExpressionNode *expression);\n174\t\n175\tvoid parseSymbolicExpression(char *source, struct ParseState *state,\n176\t                             struct ExpressionNode *expression) {\n177\t  struct SymbolicExpNode *symbolicExp = malloc(sizeof(struct SymbolicExpNode));\n178\t\n179\t  expression->type = EXP_SYMBOLIC_EXP;\n180\t  expression->data.symbolic_exp = symbolicExp;\n181\t  expression->data.symbolic_exp->expressions = NULL;\n182\t  next(source, state); // eat '('\n183\t  while (!match(state, TK_RPAREN)) {\n184\t    struct ExpressionNode *expressionItem =\n185\t        malloc(sizeof(struct ExpressionNode));\n186\t    parseExpression(source, state, expressionItem);\n187\t    appendExpressionToSymbolicExpression(symbolicExp, expressionItem);\n188\t  }\n189\t  next(source, state); // eat ')'\n190\t}\n191\t\n192\tvoid parseListExpression(char *source, struct ParseState *state,\n193\t                         struct ExpressionNode *expression) {\n194\t  struct ListNode *list = malloc(sizeof(struct ListNode));\n195\t\n196\t  expression->type = EXP_LIST;\n197\t  expression->data.list = list;\n198\t  expression->data.list->expressions = NULL;\n199\t  next(source, state); // eat quote\n200\t  next(source, state); // eat '('\n201\t  while (!match(state, TK_RPAREN)) {\n202\t    struct ExpressionNode *expressionItem =\n203\t        malloc(sizeof(struct ExpressionNode));\n204\t    parseExpression(source, state, expressionItem);\n205\t    appendExpressionToListExpression(list, expressionItem);\n206\t  }\n207\t  next(source, state); // eat ')'\n208\t}\n209\t\n210\tvoid parseSymbolExpression(char *source, struct ParseState *state,\n211\t                           struct ExpressionNode *expression) {\n212\t  expression->type = EXP_SYMBOL;\n213\t  expression->data.symbol = malloc(sizeof(struct SymbolNode));\n214\t  expression->data.symbol->symbol_name = state->token->str;\n215\t  next(source, state);\n216\t}\n217\t\n218\tvoid parseLiteralExpression(char *source, struct ParseState *state,\n219\t                            struct ExpressionNode *expression) {\n220\t  if (match(state, TK_DIGIT)) {\n221\t    expression->type = EXP_LITERAL;\n222\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n223\t    expression->data.literal->type = LIT_INTERGER;\n224\t    expression->data.literal->int_value = state->token->val;\n225\t    next(source, state);\n226\t  } else if (match(state, TK_STRING)) {\n227\t    expression->type = EXP_LITERAL;\n228\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n229\t    expression->data.literal->type = LIT_STRING;\n230\t    expression->data.literal->string_value = state->token->str;\n231\t    next(source, state);\n232\t  } else if (match(state, TK_TRUE)) {\n233\t    expression->type = EXP_LITERAL;\n234\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n235\t    expression->data.literal->type = LIT_BOOLEAN;\n236\t    expression->data.literal->boolean_value = true;\n237\t    next(source, state);\n238\t  } else if (match(state, TK_FALSE)) {\n239\t    expression->type = EXP_LITERAL;\n240\t    expression->data.literal = malloc(sizeof(struct LiteralNode));\n241\t    expression->data.literal->type = LIT_BOOLEAN;\n242\t    expression->data.literal->boolean_value = false;\n243\t    next(source, state);\n244\t  } else {\n245\t    printf(\"Unexpected token: %s\\n\", state->token->str);\n246\t    exit(1);\n247\t  }\n248\t}\n249\t\n250\tvoid parseExpression(char *source, struct ParseState *state,\n251\t                     struct ExpressionNode *expression) {\n252\t  if (match(state, TK_LPAREN)) {\n253\t    parseSymbolicExpression(source, state, expression);\n254\t  } else if (match(state, TK_QUOTE)) {\n255\t    parseListExpression(source, state, expression);\n256\t  } else if (match(state, TK_SYMBOL)) {\n257\t    parseSymbolExpression(source, state, expression);\n258\t  } else if (match(state, TK_DIGIT) || match(state, TK_STRING) ||\n259\t             match(state, TK_TRUE) || match(state, TK_FALSE)) {\n260\t    parseLiteralExpression(source, state, expression);\n261\t  } else {\n262\t    printf(\"Unexpected token: %s\\n\", state->token->str);\n263\t    exit(1);\n264\t  }\n265\t}\n266\t\n267\tvoid appendExpressionToProgram(struct ProgramNode *program,\n268\t                               struct ExpressionNode *expression) {\n269\t  struct ExpressionList *expressions = malloc(sizeof(struct ExpressionList));\n270\t  expressions->expression = expression;\n271\t  expressions->next = NULL;\n272\t  if (program->expressions == NULL) {\n273\t    program->expressions = expressions;\n274\t    return;\n275\t  }\n276\t  struct ExpressionList *current = program->expressions;\n277\t  while (current->next != NULL) {\n278\t    current = current->next;\n279\t  }\n280\t  current->next = expressions;\n281\t}\n282\t\n283\tvoid parseProgram(char *source, struct ParseState *state,\n284\t                  struct ParseResult *result) {\n285\t  // Set first token\n286\t  next(source, state);\n287\t  struct ProgramNode *program = malloc(sizeof(struct ProgramNode));\n288\t  program->expressions = NULL;\n289\t\n290\t  result->program = program;\n291\t\n292\t  while (!match(state, TK_EOF)) {\n293\t    struct ExpressionNode *expression = malloc(sizeof(struct ExpressionNode));\n294\t    parseExpression(source, state, expression);\n295\t    appendExpressionToProgram(program, expression);\n296\t  }\n297\t}\n298\t\n299\tvoid parse(char *source, struct ParseState *state, struct ParseResult *result) {\n300\t  parseProgram(source, state, result);\n301\t}\n302\t\n303\t// =================================================\n304\t//   garbage collector\n305\t// =================================================\n306\t\n307\tvoid initializeObjectStack(struct ObjectStack *stack) { stack->top = -1; }\n308\t\n309\tint isFullObjectStack(struct ObjectStack *stack) {\n310\t  return stack->top == OBJECT_NUMBER;\n311\t}\n312\t\n313\tint isEmptyObjectStack(struct ObjectStack *stack) { return stack->top == -1; }\n314\t\n315\tvoid pushObjectStack(struct ObjectStack *stack, struct Object *obj) {\n316\t  if (isFullObjectStack(stack)) {\n317\t    printf(\"Object stack is full.\\n\");\n318\t    exit(1);\n319\t  }\n320\t  stack->top++;\n321\t  stack->objects[stack->top] = obj;\n322\t}\n323\t\n324\tstruct Object *popObjectStack(struct ObjectStack *stack) {\n325\t  if (isEmptyObjectStack(stack)) {\n326\t    printf(\"Object stack is empty.\\n\");\n327\t    exit(1);\n328\t  }\n329\t  struct Object *obj = stack->objects[stack->top];\n330\t  stack->top--;\n331\t  return obj;\n332\t}\n333\t\n334\tstruct AllocatorContext *initAllocator() {\n335\t  struct AllocatorContext *context = malloc(sizeof(struct AllocatorContext));\n336\t\n337\t  context->memory_pool = (struct Object *)malloc(MEMORY_SIZE);\n338\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n339\t    context->free_bitmap[i] = 0;\n340\t  }\n341\t\n342\t  context->gc_less_mode = 0;\n343\t\n344\t  struct ObjectStack *stack = malloc(sizeof(struct ObjectStack));\n345\t  initializeObjectStack(stack);\n346\t  context->stack = stack;\n347\t\n348\t  return context;\n349\t}\n350\t\n351\tvoid freeObject(struct AllocatorContext *context, struct Object *object) {\n352\t  int index = object - context->memory_pool;\n353\t  context->free_bitmap[index] = 0;\n354\t}\n355\t\n356\tvoid sweep(struct AllocatorContext *context) {\n357\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n358\t    if (context->free_bitmap[i] == 1) {\n359\t      struct Object *obj = &context->memory_pool[i];\n360\t      if (obj->marked) {\n361\t        obj->marked = false;\n362\t      } else {\n363\t        freeObject(context, obj);\n364\t      }\n365\t    }\n366\t  }\n367\t}\n368\t\n369\tint isLastConsCell(struct ConsCell *conscell) {\n370\t  return conscell->cdr->type == OBJ_NIL;\n371\t}\n372\t\n373\tvoid mark(struct Object *obj) {\n374\t  if (obj->marked) {\n375\t    return;\n376\t  }\n377\t  obj->marked = true;\n378\t  if (obj->type == OBJ_LIST) {\n379\t    struct Object *current = obj;\n380\t    while (1) {\n381\t      mark(current);\n382\t      // evaluating list object can be nil\n383\t      if (current->list_value == NULL) {\n384\t        break;\n385\t      }\n386\t      mark(current->list_value->car);\n387\t      if (isLastConsCell(current->list_value)) {\n388\t        break;\n389\t      }\n390\t      current = current->list_value->cdr;\n391\t    }\n392\t  }\n393\t}\n394\t\n395\tvoid markAll(struct Env *env, struct AllocatorContext *context) {\n396\t  // mark objects in stack\n397\t  for (int i = 0; i <= context->stack->top; i++) {\n398\t    struct Object *obj = context->stack->objects[i];\n399\t    mark(obj);\n400\t  }\n401\t\n402\t  int i = 0;\n403\t  while (env->bindings[i].symbol_name != NULL) {\n404\t    struct Object *obj = env->bindings[i].value;\n405\t    mark(obj);\n406\t    i++;\n407\t  }\n408\t  if (env->parent != NULL) {\n409\t    markAll(env->parent, context);\n410\t  }\n411\t}\n412\t\n413\tvoid gc(struct AllocatorContext *context, struct Env *env) {\n414\t  markAll(env, context);\n415\t  sweep(context);\n416\t}\n417\t\n418\tstruct Object *allocate(struct AllocatorContext *context, struct Env *env) {\n419\t  size_t object_size = sizeof(struct Object);\n420\t  if (context->gc_less_mode) {\n421\t    return malloc(object_size);\n422\t  }\n423\t\n424\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n425\t    if (context->free_bitmap[i] == 0) {\n426\t      context->free_bitmap[i] = 1; // Mark the block as used\n427\t      return &context->memory_pool[i];\n428\t    }\n429\t  }\n430\t\n431\t  gc(context, env);\n432\t\n433\t  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n434\t    if (context->free_bitmap[i] == 0) {\n435\t      context->free_bitmap[i] = 1; // Mark the block as used\n436\t      return &context->memory_pool[i];\n437\t    }\n438\t  }\n439\t\n440\t  fprintf(stderr, \"Out of Memory\\n\");\n441\t  exit(1);\n442\t}\n443\t\n444\t// =================================================\n445\t//   defined functions\n446\t// =================================================\n447\t\n448\tbool boolVal(struct Object *obj) {\n449\t  if (obj->type == OBJ_BOOL) {\n450\t    return obj->bool_value;\n451\t  } else if (obj->type == OBJ_NIL) {\n452\t    return false;\n453\t  } else {\n454\t    return true;\n455\t  }\n456\t}\n457\t\n458\tint eq(struct Object *op1, struct Object *op2) {\n459\t  if (op1->type != op2->type) {\n460\t    return 0;\n461\t  } else {\n462\t    if (op1->type == OBJ_INTEGER) {\n463\t      return op1->int_value == op2->int_value;\n464\t    } else if (op1->type == OBJ_STRING) {\n465\t      return strcmp(op1->string_value, op2->string_value) == 0;\n466\t    } else if (op1->type == OBJ_BOOL) {\n467\t      return op1->bool_value == op2->bool_value;\n468\t    } else if (op1->type == OBJ_LIST) {\n469\t      return op1->list_value == op2->list_value;\n470\t    } else if (op1->type == OBJ_NIL) {\n471\t      return 1;\n472\t    }\n473\t  }\n474\t  return 0;\n475\t}\n476\t\n477\tchar *stringifyObject(struct Object *obj) {\n478\t  if (obj->type == OBJ_INTEGER) {\n479\t    if (obj->int_value == 0) {\n480\t      char *str = (char *)malloc(2 * sizeof(char));\n481\t      strncpy(str, \"0\", 2);\n482\t      return str;\n483\t    }\n484\t    int digits = (int)log10(obj->int_value) + 1;\n485\t    char *str = (char *)malloc((digits + 1) * sizeof(char));\n486\t    sprintf(str, \"%d\", obj->int_value);\n487\t    return str;\n488\t  } else if (obj->type == OBJ_STRING) {\n489\t    char *str = (char *)malloc((strlen(obj->string_value) + 1) * sizeof(char));\n490\t    strncpy(str, obj->string_value, strlen(obj->string_value) + 1);\n491\t    return str;\n492\t  } else if (obj->type == OBJ_BOOL) {\n493\t    char *str = (char *)malloc(1 * sizeof(char));\n494\t    if (obj->bool_value) {\n495\t      strncpy(str, \"T\", 2);\n496\t    } else {\n497\t      strncpy(str, \"F\", 2);\n498\t    }\n499\t    return str;\n500\t  } else if (obj->type == OBJ_LIST) {\n501\t    int length = 2; // '(' and ')'\n502\t    char *str = (char *)malloc(length + 1 * sizeof(char));\n503\t    memset(str, 0, length + 1);\n504\t    str[0] = '(';\n505\t    struct ConsCell *current = obj->list_value;\n506\t    while (1) {\n507\t      char *serialized = stringifyObject(current->car);\n508\t      length += strlen(serialized);\n509\t      str = realloc(str, length + 1);\n510\t      strncat(str, serialized, strlen(serialized));\n511\t      if (isLastConsCell(current)) {\n512\t        break;\n513\t      } else {\n514\t        length += 1; // \" \"\n515\t        str = realloc(str, length + 1);\n516\t        strncat(str, \" \", 1);\n517\t      }\n518\t      current = current->cdr->list_value;\n519\t    }\n520\t    str[length - 1] = ')';\n521\t    str[length] = '\\0';\n522\t    return str;\n523\t  } else if (obj->type == OBJ_NIL) {\n524\t    char *str = (char *)malloc(4 * sizeof(char));\n525\t    strncpy(str, \"nil\", 4);\n526\t    return str;\n527\t  } else if (obj->type == OBJ_FUNCTION) {\n528\t    char *str = (char *)malloc(9 * sizeof(char));\n529\t    strncpy(str, \"<function>\", 10);\n530\t    return str;\n531\t  } else {\n532\t    printf(\"Unexpected object type: %d\\n\", obj->type);\n533\t    exit(1);\n534\t  }\n535\t}\n536\t\n537\tvoid definedFunctionAdd(struct Object *op1, struct Object *op2,\n538\t                        struct Object *evaluated) {\n539\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n540\t    evaluated->type = OBJ_INTEGER;\n541\t    evaluated->int_value = op1->int_value + op2->int_value;\n542\t  } else if (op1->type == OBJ_STRING && op2->type == OBJ_STRING) {\n543\t    evaluated->type = OBJ_STRING;\n544\t    evaluated->string_value =\n545\t        malloc((strlen(op1->string_value) + strlen(op2->string_value) + 1) *\n546\t               sizeof(char));\n547\t    strncpy(evaluated->string_value, op1->string_value,\n548\t            strlen(op1->string_value) + 1);\n549\t    strcat(evaluated->string_value, op2->string_value);\n550\t  } else {\n551\t    printf(\"Type error: operands for + must be integers or strings.\\n\");\n552\t    exit(1);\n553\t  }\n554\t}\n555\t\n556\tvoid definedFunctionSub(struct Object *op1, struct Object *op2,\n557\t                        struct Object *evaluated) {\n558\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n559\t    evaluated->type = OBJ_INTEGER;\n560\t    evaluated->int_value = op1->int_value - op2->int_value;\n561\t  } else {\n562\t    printf(\"Type error: operands for - must be integers.\\n\");\n563\t    exit(1);\n564\t  }\n565\t}\n566\t\n567\tvoid definedFunctionMul(struct Object *op1, struct Object *op2,\n568\t                        struct Object *evaluated) {\n569\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n570\t    evaluated->type = OBJ_INTEGER;\n571\t    evaluated->int_value = op1->int_value * op2->int_value;\n572\t  } else {\n573\t    printf(\"Type error: operands for * must be integers.\\n\");\n574\t    exit(1);\n575\t  }\n576\t}\n577\t\n578\tvoid definedFunctionDiv(struct Object *op1, struct Object *op2,\n579\t                        struct Object *evaluated) {\n580\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n581\t    evaluated->type = OBJ_INTEGER;\n582\t    evaluated->int_value = op1->int_value / op2->int_value;\n583\t  } else {\n584\t    printf(\"Type error: operands for / must be integers.\\n\");\n585\t    exit(1);\n586\t  }\n587\t}\n588\t\n589\tvoid definedFunctionMod(struct Object *op1, struct Object *op2,\n590\t                        struct Object *evaluated) {\n591\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n592\t    evaluated->type = OBJ_INTEGER;\n593\t    evaluated->int_value = op1->int_value % op2->int_value;\n594\t  } else {\n595\t    printf(\"Type error: operands for % must be integers.\\n\");\n596\t    exit(1);\n597\t  }\n598\t}\n599\t\n600\tvoid definedFunctionOr(struct Object *op1, struct Object *op2,\n601\t                       struct Object *evaluated) {\n602\t  if (boolVal(op1) || boolVal(op2)) {\n603\t    evaluated->type = OBJ_BOOL;\n604\t    evaluated->bool_value = 1;\n605\t  } else {\n606\t    evaluated->type = OBJ_BOOL;\n607\t    evaluated->bool_value = 0;\n608\t  }\n609\t}\n610\t\n611\tvoid definedFunctionAnd(struct Object *op1, struct Object *op2,\n612\t                        struct Object *evaluated) {\n613\t  if (boolVal(op1) && boolVal(op2)) {\n614\t    evaluated->type = OBJ_BOOL;\n615\t    evaluated->bool_value = 1;\n616\t  } else {\n617\t    evaluated->type = OBJ_BOOL;\n618\t    evaluated->bool_value = 0;\n619\t  }\n620\t}\n621\t\n622\tvoid definedFunctionLt(struct Object *op1, struct Object *op2,\n623\t                       struct Object *evaluated) {\n624\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n625\t    if (op1->int_value < op2->int_value) {\n626\t      evaluated->type = OBJ_BOOL;\n627\t      evaluated->bool_value = 1;\n628\t    } else {\n629\t      evaluated->type = OBJ_BOOL;\n630\t      evaluated->bool_value = 0;\n631\t    }\n632\t  } else {\n633\t    printf(\"Type error: operands for < must be integers.\\n\");\n634\t    exit(1);\n635\t  }\n636\t}\n637\t\n638\tvoid definedFunctionGt(struct Object *op1, struct Object *op2,\n639\t                       struct Object *evaluated) {\n640\t  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n641\t    if (op1->int_value > op2->int_value) {\n642\t      evaluated->type = OBJ_BOOL;\n643\t      evaluated->bool_value = 1;\n644\t    } else {\n645\t      evaluated->type = OBJ_BOOL;\n646\t      evaluated->bool_value = 0;\n647\t    }\n648\t  } else {\n649\t    printf(\"Type error: operands for < must be integers.\\n\");\n650\t    exit(1);\n651\t  }\n652\t}\n653\t\n654\tvoid definedFunctionEq(struct Object *op1, struct Object *op2,\n655\t                       struct Object *evaluated) {\n656\t  if (eq(op1, op2)) {\n657\t    evaluated->type = OBJ_BOOL;\n658\t    evaluated->bool_value = 1;\n659\t  } else {\n660\t    evaluated->type = OBJ_BOOL;\n661\t    evaluated->bool_value = 0;\n662\t  }\n663\t}\n664\t\n665\tvoid definedFunctionCar(struct Object *op, struct Object *evaluated) {\n666\t  if (op->type != OBJ_LIST) {\n667\t    printf(\"Type error: car operand must be list.\\n\");\n668\t    exit(1);\n669\t  }\n670\t  *evaluated = *(op->list_value->car);\n671\t}\n672\t\n673\tvoid definedFunctionCdr(struct Object *op, struct Object *evaluated) {\n674\t  if (op->type != OBJ_LIST) {\n675\t    printf(\"Type error: cdr operand must be list.\\n\");\n676\t    exit(1);\n677\t  }\n678\t  *evaluated = *op->list_value->cdr;\n679\t}\n680\t\n681\tvoid definedFunctionCons(struct Object *op1, struct Object *op2,\n682\t                         struct Object *evaluated, struct Env *env,\n683\t                         struct AllocatorContext *context) {\n684\t  evaluated->type = OBJ_LIST;\n685\t  evaluated->list_value = malloc(sizeof(struct ConsCell));\n686\t  evaluated->list_value->car = op1;\n687\t\n688\t  if (op2->type == OBJ_LIST) {\n689\t    evaluated->list_value->type = CONSCELL_TYPE_CELL;\n690\t    evaluated->list_value->cdr = op2;\n691\t  } else if (op2->type == OBJ_NIL) {\n692\t    evaluated->list_value->cdr = op2;\n693\t  } else {\n694\t    struct Object *cdr_obj = allocate(context, env);\n695\t    cdr_obj->type = OBJ_LIST;\n696\t    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n697\t    new_conscell->car = op2;\n698\t    new_conscell->type = CONSCELL_TYPE_CELL;\n699\t    new_conscell->cdr = allocate(context, env);\n700\t    new_conscell->cdr->type = OBJ_NIL;\n701\t    cdr_obj->list_value = new_conscell;\n702\t    evaluated->list_value->cdr = cdr_obj;\n703\t  }\n704\t}\n705\t\n706\tvoid definedFunctionNot(struct Object *op, struct Object *evaluated) {\n707\t  if (op->type != OBJ_BOOL) {\n708\t    printf(\"Type error: not operand must be boolean.\\n\");\n709\t    exit(1);\n710\t  }\n711\t  evaluated->type = OBJ_BOOL;\n712\t  if (op->bool_value) {\n713\t    evaluated->bool_value = 0;\n714\t  } else {\n715\t    evaluated->bool_value = 1;\n716\t  }\n717\t}\n718\t\n719\tvoid definedFunctionSplit(struct Object *op1, struct Object *op2,\n720\t                          struct Object *evaluated, struct Env *env,\n721\t                          struct AllocatorContext *context) {\n722\t  if (op1->type != OBJ_STRING) {\n723\t    printf(\"Type error: split first operand must be string.\\n\");\n724\t    exit(1);\n725\t  }\n726\t  if (op2->type != OBJ_STRING) {\n727\t    printf(\"Type error: split second operand must be string.\\n\");\n728\t    exit(1);\n729\t  }\n730\t\n731\t  // when op2 is \"\", return list of characters\n732\t  if (strcmp(op2->string_value, \"\") == 0) {\n733\t    evaluated->type = OBJ_LIST;\n734\t    evaluated->list_value = malloc(sizeof(struct ConsCell));\n735\t    evaluated->list_value->type = CONSCELL_TYPE_CELL;\n736\t    evaluated->list_value->car = allocate(context, env);\n737\t    evaluated->list_value->car->type = OBJ_STRING;\n738\t    evaluated->list_value->car->string_value = malloc(sizeof(char));\n739\t    evaluated->list_value->car->string_value[0] = op1->string_value[0];\n740\t    evaluated->list_value->cdr = allocate(context, env);\n741\t    evaluated->list_value->cdr->type = OBJ_NIL;\n742\t    struct ConsCell *current = evaluated->list_value;\n743\t    for (unsigned long i = 1; i < strlen(op1->string_value); i++) {\n744\t      struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n745\t      new_conscell->type = CONSCELL_TYPE_CELL;\n746\t      new_conscell->car = allocate(context, env);\n747\t      new_conscell->car->type = OBJ_STRING;\n748\t      new_conscell->car->string_value = malloc(sizeof(char));\n749\t      new_conscell->car->string_value[0] = op1->string_value[i];\n750\t      new_conscell->cdr = allocate(context, env);\n751\t      new_conscell->cdr->type = OBJ_NIL;\n752\t      current->cdr = allocate(context, env);\n753\t      current->cdr->type = OBJ_LIST;\n754\t      current->cdr->list_value = new_conscell;\n755\t      current = current->cdr->list_value;\n756\t    }\n757\t    return;\n758\t  }\n759\t\n760\t  // split op1 string by op2 string and return list of strings\n761\t  evaluated->type = OBJ_LIST;\n762\t  evaluated->list_value = malloc(sizeof(struct ConsCell));\n763\t  evaluated->list_value->type = CONSCELL_TYPE_CELL;\n764\t  evaluated->list_value->car = allocate(context, env);\n765\t  evaluated->list_value->car->type = OBJ_STRING;\n766\t  evaluated->list_value->car->string_value =\n767\t      strtok(op1->string_value, op2->string_value);\n768\t  evaluated->list_value->cdr = allocate(context, env);\n769\t  evaluated->list_value->cdr->type = OBJ_NIL;\n770\t  struct ConsCell *current = evaluated->list_value;\n771\t  while (1) {\n772\t    char *token = strtok(NULL, op2->string_value);\n773\t    if (token == NULL) {\n774\t      break;\n775\t    }\n776\t    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n777\t    new_conscell->type = CONSCELL_TYPE_CELL;\n778\t    new_conscell->car = allocate(context, env);\n779\t    new_conscell->car->type = OBJ_STRING;\n780\t    new_conscell->car->string_value = token;\n781\t    new_conscell->cdr = allocate(context, env);\n782\t    new_conscell->cdr->type = OBJ_NIL;\n783\t    current->cdr = allocate(context, env);\n784\t    current->cdr->type = OBJ_LIST;\n785\t    current->cdr->list_value = new_conscell;\n786\t    current = current->cdr->list_value;\n787\t  }\n788\t}\n789\t\n790\tvoid definedFunctionListRef(struct Object *op1, struct Object *op2,\n791\t                            struct Object *evaluated) {\n792\t  if (op1->type != OBJ_LIST) {\n793\t    printf(\"Type error: list-ref first operand must be list.\\n\");\n794\t    exit(1);\n795\t  }\n796\t  if (op2->type != OBJ_INTEGER) {\n797\t    printf(\"Type error: list-ref second operand must be integer.\\n\");\n798\t    exit(1);\n799\t  }\n800\t  int index = op2->int_value;\n801\t  struct ConsCell *current = op1->list_value;\n802\t  for (int i = 0; i < index; i++) {\n803\t    if (current->cdr->type == OBJ_NIL) {\n804\t      printf(\"Index out of range.\\n\");\n805\t      exit(1);\n806\t    }\n807\t    current = current->cdr->list_value;\n808\t  }\n809\t  *evaluated = *current->car;\n810\t}\n811\t\n812\tvoid definedFunctionRemoveWhitespaces(struct Object *op1,\n813\t                                      struct Object *evaluated) {\n814\t  if (op1->type != OBJ_STRING) {\n815\t    printf(\"Type error: remove-whitespaces operand must be string.\\n\");\n816\t    exit(1);\n817\t  }\n818\t  char *str = op1->string_value;\n819\t  char *new_str = malloc(sizeof(char) * (strlen(str) + 1));\n820\t  int i = 0;\n821\t  int j = 0;\n822\t  while (str[i]) {\n823\t    if (!isspace(str[i])) {\n824\t      new_str[j++] = str[i];\n825\t    }\n826\t    i++;\n827\t  }\n828\t  new_str[j] = '\\0';\n829\t  evaluated->type = OBJ_STRING;\n830\t  evaluated->string_value = new_str;\n831\t}\n832\t\n833\tvoid definedFunctionPop(struct Object *op, struct Object *evaluated) {\n834\t  // empty list is evaluted as nil\n835\t  if (op->type == OBJ_NIL) {\n836\t    evaluated->type = OBJ_NIL;\n837\t    return;\n838\t  }\n839\t  if (op->type != OBJ_LIST) {\n840\t    printf(\"Type error: pop operand must be list.\\n\");\n841\t    exit(1);\n842\t  }\n843\t  struct ConsCell *current = op->list_value;\n844\t  struct ConsCell *prev = NULL;\n845\t  while (1) {\n846\t    if (isLastConsCell(current)) {\n847\t      if (prev == NULL) {\n848\t        *evaluated = *current->car;\n849\t      } else {\n850\t        prev->cdr->type = OBJ_NIL;\n851\t        prev->cdr->list_value = NULL;\n852\t        *evaluated = *current->car;\n853\t      }\n854\t      break;\n855\t    }\n856\t    prev = current;\n857\t    current = current->cdr->list_value;\n858\t  }\n859\t}\n860\t\n861\tvoid definedFunctionPush(struct Object *op1, struct Object *op2,\n862\t                         struct Object *evaluated, struct Env *env,\n863\t                         struct AllocatorContext *context) {\n864\t  if (op1->type == OBJ_NIL) {\n865\t    *evaluated = *op2;\n866\t\n867\t    int i = 0;\n868\t    while (env->bindings[i].symbol_name != NULL) {\n869\t      if (env->bindings[i].value == op1) {\n870\t        struct Object *new_list = allocate(context, env);\n871\t        new_list->type = OBJ_LIST;\n872\t        new_list->list_value = malloc(sizeof(struct ConsCell));\n873\t        new_list->list_value->type = CONSCELL_TYPE_CELL;\n874\t        new_list->list_value->car = op2;\n875\t        new_list->list_value->cdr = allocate(context, env);\n876\t        new_list->list_value->cdr->type = OBJ_NIL;\n877\t        env->bindings[i].value = new_list;\n878\t        break;\n879\t      }\n880\t      i++;\n881\t    }\n882\t\n883\t    return;\n884\t  }\n885\t\n886\t  if (op1->type != OBJ_LIST) {\n887\t    printf(\"Type error: push second operand must be list.\\n\");\n888\t    exit(1);\n889\t  }\n890\t\n891\t  struct ConsCell *current = op1->list_value;\n892\t  while (1) {\n893\t    if (isLastConsCell(current)) {\n894\t      struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n895\t      new_conscell->type = CONSCELL_TYPE_CELL;\n896\t      new_conscell->car = op2;\n897\t      new_conscell->cdr = allocate(context, env);\n898\t      new_conscell->cdr->type = OBJ_NIL;\n899\t      current->cdr->type = OBJ_LIST;\n900\t      current->cdr->list_value = new_conscell;\n901\t      break;\n902\t    }\n903\t    current = current->cdr->list_value;\n904\t  }\n905\t\n906\t  *evaluated = *op2;\n907\t}\n908\t\n909\tvoid definedFunctionLength(struct Object *op, struct Object *evaluated) {\n910\t  if (op->type == OBJ_NIL) {\n911\t    evaluated->type = OBJ_INTEGER;\n912\t    evaluated->int_value = 0;\n913\t    return;\n914\t  }\n915\t  if (op->type == OBJ_LIST) {\n916\t    int length = 1;\n917\t    struct ConsCell *current = op->list_value;\n918\t    while (1) {\n919\t      if (isLastConsCell(current)) {\n920\t        break;\n921\t      }\n922\t      length++;\n923\t      current = current->cdr->list_value;\n924\t    }\n925\t    evaluated->type = OBJ_INTEGER;\n926\t    evaluated->int_value = length;\n927\t  } else if (op->type == OBJ_STRING) {\n928\t    evaluated->type = OBJ_INTEGER;\n929\t    evaluated->int_value = strlen(op->string_value);\n930\t  } else {\n931\t    printf(\"Type error: length operand must be list or string.\\n\");\n932\t    exit(1);\n933\t  }\n934\t}\n935\t\n936\tvoid definedFunctionIsIntString(struct Object *op, struct Object *evaluated) {\n937\t  if (op->type == OBJ_STRING) {\n938\t    char *str = op->string_value;\n939\t    int i = 0;\n940\t    while (str[i]) {\n941\t      if (!isdigit(str[i])) {\n942\t        evaluated->type = OBJ_BOOL;\n943\t        evaluated->bool_value = false;\n944\t        return;\n945\t      }\n946\t      i++;\n947\t    }\n948\t    evaluated->type = OBJ_BOOL;\n949\t    evaluated->bool_value = true;\n950\t  } else {\n951\t    evaluated->type = OBJ_BOOL;\n952\t    evaluated->bool_value = false;\n953\t  }\n954\t}\n955\t\n956\tvoid definedFunctionParseInt(struct Object *op, struct Object *evaluated) {\n957\t  if (op->type != OBJ_STRING) {\n958\t    printf(\"Type error: parse-int operand must be string.\\n\");\n959\t    exit(1);\n960\t  }\n961\t  char *str = op->string_value;\n962\t  int i = 0;\n963\t  while (str[i]) {\n964\t    if (!isdigit(str[i])) {\n965\t      printf(\"Type error: parse-int operand must be string of digits.\\n\");\n966\t      exit(1);\n967\t    }\n968\t    i++;\n969\t  }\n970\t  evaluated->type = OBJ_INTEGER;\n971\t  evaluated->int_value = atoi(str);\n972\t}\n973\t\n974\tvoid definedFunctionStringRef(struct Object *op1, struct Object *op2, struct Object *evaluated) {\n975\t  if (op1->type != OBJ_STRING) {\n976\t    printf(\"Type error: string-ref first operand must be string.\\n\");\n977\t    exit(1);\n978\t  }\n979\t  if (op2->type != OBJ_INTEGER) {\n980\t    printf(\"Type error: string-ref second operand must be integer.\\n\");\n981\t    exit(1);\n982\t  }\n983\t  int index = op2->int_value;\n984\t\n985\t  if (index < 0 || index >= (int)strlen(op1->string_value)) {\n986\t    printf(\"Index out of range.\\n\");\n987\t    exit(1);\n988\t  }\n989\t  evaluated->type = OBJ_STRING;\n990\t  evaluated->string_value = malloc(sizeof(char) * 2);\n991\t  evaluated->string_value[0] = op1->string_value[index];\n992\t  evaluated->string_value[1] = '\\0';\n993\t}\n994\t\n995\t// =================================================\n996\t//   evaluator\n997\t// =================================================\n998\t\n999\tvoid evaluateListExpression(struct ExpressionNode *expression,\n1000\t                            struct Object *evaluated, struct Env *env,\n1001\t                            struct AllocatorContext *context) {\n1002\t  struct ExpressionList *expressions = expression->data.list->expressions;\n1003\t\n1004\t  // empty data list is evaluated as nil\n1005\t  if (expressions == NULL) {\n1006\t    evaluated->type = OBJ_NIL;\n1007\t    return;\n1008\t  }\n1009\t\n1010\t  evaluated->type = OBJ_LIST;\n1011\t\n1012\t  struct ConsCell *car_conscell = NULL;\n1013\t  struct ConsCell *prev_conscell = NULL;\n1014\t\n1015\t  while (expressions != NULL) {\n1016\t    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n1017\t    if (car_conscell == NULL) {\n1018\t      car_conscell = new_conscell;\n1019\t    }\n1020\t\n1021\t    struct Object *evaluatedItem = allocate(context, env);\n1022\t    new_conscell->car = evaluatedItem;\n1023\t    evaluateExpression(expressions->expression, evaluatedItem, env, context);\n1024\t\n1025\t    expressions = expressions->next;\n1026\t\n1027\t    if (prev_conscell != NULL) {\n1028\t      struct Object *new_cdr = allocate(context, env);\n1029\t      new_cdr->type = OBJ_LIST;\n1030\t      new_cdr->list_value = new_conscell;\n1031\t      prev_conscell->cdr = new_cdr;\n1032\t      prev_conscell->type = CONSCELL_TYPE_CELL;\n1033\t    }\n1034\t    prev_conscell = new_conscell;\n1035\t\n1036\t    if (expressions == NULL) {\n1037\t      struct Object *nilObj = allocate(context, env);\n1038\t      nilObj->type = OBJ_NIL;\n1039\t      prev_conscell->type = CONSCELL_TYPE_NIL;\n1040\t      prev_conscell->cdr = nilObj;\n1041\t    }\n1042\t  }\n1043\t\n1044\t  evaluated->list_value = car_conscell;\n1045\t}\n1046\t\n1047\tvoid setObjectToEnv(struct Env *env, char *symbolName, struct Object *obj) {\n1048\t  // search binding that has the symbol name\n1049\t  int i = 0;\n1050\t  while (env->bindings[i].symbol_name != NULL) {\n1051\t    if (strcmp(env->bindings[i].symbol_name, symbolName) == 0) {\n1052\t      env->bindings[i].value = obj;\n1053\t      return;\n1054\t    }\n1055\t    i++;\n1056\t  }\n1057\t\n1058\t  // if not found, set to parent env\n1059\t  struct Binding *binding = malloc(sizeof(struct Binding));\n1060\t  binding->symbol_name = symbolName;\n1061\t  binding->value = obj;\n1062\t  i = 0;\n1063\t  while (env->bindings[i].symbol_name != NULL) {\n1064\t    i++;\n1065\t  }\n1066\t  env->bindings[i] = *binding;\n1067\t}\n1068\t\n1069\tvoid evaluateSymbolicExpression(struct ExpressionNode *expression,\n1070\t                                struct Object *evaluated, struct Env *env,\n1071\t                                struct AllocatorContext *context) {\n1072\t  struct ExpressionList *expressions = expression->data.list->expressions;\n1073\t  if (expressions != NULL) {\n1074\t    struct ExpressionNode *expr = expressions->expression;\n1075\t    if (expr != NULL && expr->type == EXP_SYMBOL) {\n1076\t      if (strcmp(expr->data.symbol->symbol_name, \"if\") == 0) {\n1077\t        // if\n1078\t        struct ExpressionNode *cond = expressions->next->expression;\n1079\t        if (cond == NULL) {\n1080\t          printf(\"if must have condition.\\n\");\n1081\t          exit(1);\n1082\t        }\n1083\t        struct ExpressionNode *then = expressions->next->next->expression;\n1084\t        if (then == NULL) {\n1085\t          printf(\"if must have then clause.\\n\");\n1086\t          exit(1);\n1087\t        }\n1088\t        struct Object *condObj = allocate(context, env);\n1089\t        evaluateExpression(cond, condObj, env, context);\n1090\t        if (boolVal(condObj)) {\n1091\t          evaluateExpression(then, evaluated, env, context);\n1092\t        } else {\n1093\t          if (expressions->next->next->next != NULL) {\n1094\t            struct ExpressionNode *els =\n1095\t                expressions->next->next->next->expression;\n1096\t            evaluateExpression(els, evaluated, env, context);\n1097\t          } else {\n1098\t            evaluated->type = OBJ_NIL;\n1099\t          }\n1100\t        }\n1101\t      } else if (strcmp(expr->data.symbol->symbol_name, \"while\") == 0) {\n1102\t        // while\n1103\t        struct ExpressionNode *cond = expressions->next->expression;\n1104\t        if (cond == NULL) {\n1105\t          printf(\"if must have condition.\\n\");\n1106\t          exit(1);\n1107\t        }\n1108\t        struct ExpressionNode *then = expressions->next->next->expression;\n1109\t        if (then == NULL) {\n1110\t          printf(\"if must have then clause.\\n\");\n1111\t          exit(1);\n1112\t        }\n1113\t        while (1) {\n1114\t          struct Object *condObj = allocate(context, env);\n1115\t          evaluateExpression(cond, condObj, env, context);\n1116\t          if (boolVal(condObj)) {\n1117\t            evaluateExpression(then, evaluated, env, context);\n1118\t          } else {\n1119\t            evaluated->type = OBJ_NIL;\n1120\t            break;\n1121\t          }\n1122\t        }\n1123\t      } else if (strcmp(expr->data.symbol->symbol_name, \"=\") == 0) {\n1124\t        // assignment\n1125\t        struct ExpressionNode symbolExpr = *expressions->next->expression;\n1126\t        if (symbolExpr.type != EXP_SYMBOL) {\n1127\t          printf(\"Variable name must be symbol.\\n\");\n1128\t          exit(1);\n1129\t        }\n1130\t        char *symbol_name = symbolExpr.data.symbol->symbol_name;\n1131\t        struct ExpressionNode *expr = expressions->next->next->expression;\n1132\t\n1133\t        if (expr == NULL) {\n1134\t          printf(\"assignment must have expression.\\n\");\n1135\t          exit(1);\n1136\t        }\n1137\t        struct Object *evaluatedExpr = allocate(context, env);\n1138\t        evaluateExpression(expr, evaluatedExpr, env, context);\n1139\t        *evaluated = *evaluatedExpr;\n1140\t\n1141\t        // set value to current env\n1142\t        setObjectToEnv(env, symbol_name, evaluatedExpr);\n1143\t      } else if ((strcmp(expr->data.symbol->symbol_name, \"defun\") == 0)) {\n1144\t        // define function\n1145\t        // (defun fn (n) (+ n 1))\n1146\t        struct ExpressionNode symbolExpr = *expressions->next->expression;\n1147\t        if (symbolExpr.type != EXP_SYMBOL) {\n1148\t          printf(\"Function name must be symbol.\\n\");\n1149\t          exit(1);\n1150\t        }\n1151\t        char *symbol_name = symbolExpr.data.symbol->symbol_name;\n1152\t\n1153\t        struct ExpressionNode *paramsExpr = expressions->next->next->expression;\n1154\t        if (paramsExpr == NULL) {\n1155\t          printf(\"Function must have parameter.\\n\");\n1156\t          exit(1);\n1157\t        }\n1158\t        if (paramsExpr->type != EXP_SYMBOLIC_EXP) {\n1159\t          printf(\"Function parameter must be list.\\n\");\n1160\t          exit(1);\n1161\t        }\n1162\t\n1163\t        struct ExpressionList *params =\n1164\t            paramsExpr->data.symbolic_exp->expressions;\n1165\t        // check all elements are symbol and get symbol names\n1166\t\n1167\t        char **param_symbol_names = malloc(sizeof(char *) * MAX_BINDINGS);\n1168\t\n1169\t        int i = 0;\n1170\t        while (params != NULL) {\n1171\t          if (params->expression->type != EXP_SYMBOL) {\n1172\t            printf(\"Function parameter must be symbol.\\n\");\n1173\t            exit(1);\n1174\t          }\n1175\t          param_symbol_names[i] = params->expression->data.symbol->symbol_name;\n1176\t          i++;\n1177\t          params = params->next;\n1178\t        }\n1179\t\n1180\t        struct ExpressionNode *bodyExpr =\n1181\t            expressions->next->next->next->expression;\n1182\t        if (bodyExpr == NULL) {\n1183\t          printf(\"Function must have body.\\n\");\n1184\t          exit(1);\n1185\t        }\n1186\t\n1187\t        struct Function *function = malloc(sizeof(struct Function));\n1188\t        function->param_symbol_names = param_symbol_names;\n1189\t        function->body = bodyExpr;\n1190\t\n1191\t        evaluated->type = OBJ_FUNCTION;\n1192\t        evaluated->function_value = function;\n1193\t\n1194\t        setObjectToEnv(env, symbol_name, evaluated);\n1195\t      } else {\n1196\t        // function call\n1197\t        if (strcmp(expr->data.symbol->symbol_name, \"+\") == 0) {\n1198\t          // +\n1199\t          struct Object *operand1 = allocate(context, env);\n1200\t          struct Object *operand2 = allocate(context, env);\n1201\t          evaluateExpression(expressions->next->expression, operand1, env,\n1202\t                             context);\n1203\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1204\t                             context);\n1205\t          definedFunctionAdd(operand1, operand2, evaluated);\n1206\t        } else if (strcmp(expr->data.symbol->symbol_name, \"-\") == 0) {\n1207\t          // -\n1208\t          struct Object *operand1 = allocate(context, env);\n1209\t          struct Object *operand2 = allocate(context, env);\n1210\t          evaluateExpression(expressions->next->expression, operand1, env,\n1211\t                             context);\n1212\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1213\t                             context);\n1214\t          definedFunctionSub(operand1, operand2, evaluated);\n1215\t        } else if (strcmp(expr->data.symbol->symbol_name, \"*\") == 0) {\n1216\t          // *\n1217\t          struct Object *operand1 = allocate(context, env);\n1218\t          struct Object *operand2 = allocate(context, env);\n1219\t          evaluateExpression(expressions->next->expression, operand1, env,\n1220\t                             context);\n1221\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1222\t                             context);\n1223\t          definedFunctionMul(operand1, operand2, evaluated);\n1224\t        } else if (strcmp(expr->data.symbol->symbol_name, \"/\") == 0) {\n1225\t          // /\n1226\t          struct Object *operand1 = allocate(context, env);\n1227\t          struct Object *operand2 = allocate(context, env);\n1228\t          evaluateExpression(expressions->next->expression, operand1, env,\n1229\t                             context);\n1230\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1231\t                             context);\n1232\t          definedFunctionDiv(operand1, operand2, evaluated);\n1233\t        } else if (strcmp(expr->data.symbol->symbol_name, \"%\") == 0) {\n1234\t          // %\n1235\t          struct Object *operand1 = allocate(context, env);\n1236\t          struct Object *operand2 = allocate(context, env);\n1237\t          evaluateExpression(expressions->next->expression, operand1, env,\n1238\t                             context);\n1239\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1240\t                             context);\n1241\t          definedFunctionMod(operand1, operand2, evaluated);\n1242\t        } else if (strcmp(expr->data.symbol->symbol_name, \"||\") == 0) {\n1243\t          // ||\n1244\t          struct ExpressionList *exprs = expressions->next;\n1245\t          struct Object *operand = NULL;\n1246\t          while (exprs != NULL) {\n1247\t            operand = allocate(context, env);\n1248\t            evaluateExpression(exprs->expression, operand, env, context);\n1249\t            if (boolVal(operand)) {\n1250\t              evaluated->type = OBJ_BOOL;\n1251\t              evaluated->bool_value = 1;\n1252\t              return;\n1253\t            }\n1254\t            exprs = exprs->next;\n1255\t          }\n1256\t          evaluated->type = OBJ_BOOL;\n1257\t          evaluated->bool_value = 0;\n1258\t        } else if (strcmp(expr->data.symbol->symbol_name, \"&&\") == 0) {\n1259\t          // &&\n1260\t          struct ExpressionList *exprs = expressions->next;\n1261\t          struct Object *operand = NULL;\n1262\t          while (exprs != NULL) {\n1263\t            operand = allocate(context, env);\n1264\t            evaluateExpression(exprs->expression, operand, env, context);\n1265\t            if (!boolVal(operand)) {\n1266\t              evaluated->type = OBJ_BOOL;\n1267\t              evaluated->bool_value = 0;\n1268\t              return;\n1269\t            }\n1270\t            exprs = exprs->next;\n1271\t          }\n1272\t          evaluated->type = OBJ_BOOL;\n1273\t          evaluated->bool_value = 1;\n1274\t        } else if (strcmp(expr->data.symbol->symbol_name, \"<\") == 0) {\n1275\t          // <\n1276\t          struct Object *operand1 = allocate(context, env);\n1277\t          struct Object *operand2 = allocate(context, env);\n1278\t          evaluateExpression(expressions->next->expression, operand1, env,\n1279\t                             context);\n1280\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1281\t                             context);\n1282\t          definedFunctionLt(operand1, operand2, evaluated);\n1283\t        } else if (strcmp(expr->data.symbol->symbol_name, \">\") == 0) {\n1284\t          // >\n1285\t          struct Object *operand1 = allocate(context, env);\n1286\t          struct Object *operand2 = allocate(context, env);\n1287\t          evaluateExpression(expressions->next->expression, operand1, env,\n1288\t                             context);\n1289\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1290\t                             context);\n1291\t          definedFunctionGt(operand1, operand2, evaluated);\n1292\t        } else if (strcmp(expr->data.symbol->symbol_name, \"eq\") == 0) {\n1293\t          // eq\n1294\t          struct Object *operand1 = allocate(context, env);\n1295\t          struct Object *operand2 = allocate(context, env);\n1296\t          evaluateExpression(expressions->next->expression, operand1, env,\n1297\t                             context);\n1298\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1299\t                             context);\n1300\t          definedFunctionEq(operand1, operand2, evaluated);\n1301\t        } else if (strcmp(expr->data.symbol->symbol_name, \"not\") == 0) {\n1302\t          // not\n1303\t          struct Object *operand = allocate(context, env);\n1304\t          evaluateExpression(expressions->next->expression, operand, env,\n1305\t                             context);\n1306\t          definedFunctionNot(operand, evaluated);\n1307\t        } else if (strcmp(expr->data.symbol->symbol_name, \"print\") == 0) {\n1308\t          // print\n1309\t          struct Object *operand = allocate(context, env);\n1310\t          evaluateExpression(expressions->next->expression, operand, env,\n1311\t                             context);\n1312\t          char *str = stringifyObject(operand);\n1313\t          printf(\"%s\\n\", str);\n1314\t          free(str);\n1315\t          evaluated->type = OBJ_NIL;\n1316\t        } else if (strcmp(expr->data.symbol->symbol_name, \"car\") == 0) {\n1317\t          // car\n1318\t          struct Object *operand = allocate(context, env);\n1319\t          evaluateExpression(expressions->next->expression, operand, env,\n1320\t                             context);\n1321\t          definedFunctionCar(operand, evaluated);\n1322\t        } else if (strcmp(expr->data.symbol->symbol_name, \"cdr\") == 0) {\n1323\t          // cdr\n1324\t          struct Object *operand = allocate(context, env);\n1325\t          evaluateExpression(expressions->next->expression, operand, env,\n1326\t                             context);\n1327\t          definedFunctionCdr(operand, evaluated);\n1328\t        } else if (strcmp(expr->data.symbol->symbol_name, \"cons\") == 0) {\n1329\t          // cons\n1330\t          struct Object *operand1 = allocate(context, env);\n1331\t          struct Object *operand2 = allocate(context, env);\n1332\t          evaluateExpression(expressions->next->expression, operand1, env,\n1333\t                             context);\n1334\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1335\t                             context);\n1336\t          definedFunctionCons(operand1, operand2, evaluated, env, context);\n1337\t        } else if (strcmp(expr->data.symbol->symbol_name, \"readline\") == 0) {\n1338\t          // readline\n1339\t          char *line = NULL;\n1340\t          size_t len = 0;\n1341\t          ssize_t read;\n1342\t          if ((read = getline(&line, &len, stdin)) != -1) {\n1343\t            evaluated->type = OBJ_STRING;\n1344\t            // trim newline\n1345\t            line[read - 1] = '\\0';\n1346\t            evaluated->string_value = line;\n1347\t          } else {\n1348\t            evaluated->type = OBJ_NIL;\n1349\t          }\n1350\t        } else if (strcmp(expr->data.symbol->symbol_name, \"split\") == 0) {\n1351\t          // split\n1352\t          struct Object *operand1 = allocate(context, env);\n1353\t          struct Object *operand2 = allocate(context, env);\n1354\t          evaluateExpression(expressions->next->expression, operand1, env,\n1355\t                             context);\n1356\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1357\t                             context);\n1358\t          definedFunctionSplit(operand1, operand2, evaluated, env, context);\n1359\t        } else if (strcmp(expr->data.symbol->symbol_name, \"list-ref\") == 0) {\n1360\t          // list-ref\n1361\t          struct Object *operand1 = allocate(context, env);\n1362\t          struct Object *operand2 = allocate(context, env);\n1363\t          evaluateExpression(expressions->next->expression, operand1, env,\n1364\t                             context);\n1365\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1366\t                             context);\n1367\t          definedFunctionListRef(operand1, operand2, evaluated);\n1368\t        } else if (strcmp(expr->data.symbol->symbol_name, \"progn\") == 0) {\n1369\t          // progn\n1370\t          struct ExpressionList *exprs = expressions->next;\n1371\t          struct Object *operand = NULL;\n1372\t          while (exprs != NULL) {\n1373\t            operand = allocate(context, env);\n1374\t            evaluateExpression(exprs->expression, operand, env, context);\n1375\t            exprs = exprs->next;\n1376\t          }\n1377\t          if (operand != NULL) {\n1378\t            *evaluated = *operand;\n1379\t          } else {\n1380\t            evaluated->type = OBJ_NIL;\n1381\t          }\n1382\t        } else if (strcmp(expr->data.symbol->symbol_name,\n1383\t                          \"remove-whitespaces\") == 0) {\n1384\t          // remove-whitespaces\n1385\t          struct Object *operand = allocate(context, env);\n1386\t          evaluateExpression(expressions->next->expression, operand, env,\n1387\t                             context);\n1388\t          definedFunctionRemoveWhitespaces(operand, evaluated);\n1389\t        } else if (strcmp(expr->data.symbol->symbol_name, \"pop\") == 0) {\n1390\t          // pop\n1391\t          struct Object *operand = allocate(context, env);\n1392\t          evaluateExpression(expressions->next->expression, operand, env,\n1393\t                             context);\n1394\t          definedFunctionPop(operand, evaluated);\n1395\t        } else if (strcmp(expr->data.symbol->symbol_name, \"push\") == 0) {\n1396\t          // push\n1397\t          struct Object *operand1 = allocate(context, env);\n1398\t          struct Object *operand2 = allocate(context, env);\n1399\t          evaluateExpression(expressions->next->next->expression, operand1, env,\n1400\t                             context);\n1401\t          evaluateExpression(expressions->next->expression, operand2, env,\n1402\t                             context);\n1403\t          definedFunctionPush(operand2, operand1, evaluated, env, context);\n1404\t        } else if (strcmp(expr->data.symbol->symbol_name, \"length\") == 0) {\n1405\t          // length\n1406\t          struct Object *operand = allocate(context, env);\n1407\t          evaluateExpression(expressions->next->expression, operand, env,\n1408\t                             context);\n1409\t          definedFunctionLength(operand, evaluated);\n1410\t        } else if (strcmp(expr->data.symbol->symbol_name, \"is-int-string\") ==\n1411\t                   0) {\n1412\t          // is-int-string\n1413\t          struct Object *operand = allocate(context, env);\n1414\t          evaluateExpression(expressions->next->expression, operand, env,\n1415\t                             context);\n1416\t          definedFunctionIsIntString(operand, evaluated);\n1417\t        } else if (strcmp(expr->data.symbol->symbol_name, \"parse-int\") == 0) {\n1418\t          // parse-int\n1419\t          struct Object *operand = allocate(context, env);\n1420\t          evaluateExpression(expressions->next->expression, operand, env,\n1421\t                             context);\n1422\t          definedFunctionParseInt(operand, evaluated);\n1423\t        } else if (strcmp(expr->data.symbol->symbol_name, \"string-ref\") == 0) {\n1424\t          // string-ref\n1425\t          struct Object *operand1 = allocate(context, env);\n1426\t          struct Object *operand2 = allocate(context, env);\n1427\t          evaluateExpression(expressions->next->expression, operand1, env,\n1428\t                             context);\n1429\t          evaluateExpression(expressions->next->next->expression, operand2, env,\n1430\t                              context);\n1431\t          definedFunctionStringRef(operand1, operand2, evaluated);\n1432\t        } else {\n1433\t          // function call\n1434\t          int i = 0;\n1435\t          struct Env *current_env = env;\n1436\t          struct Env *looked_up_env = current_env;\n1437\t          while (looked_up_env->bindings[i].symbol_name != NULL) {\n1438\t            if (strcmp(looked_up_env->bindings[i].symbol_name,\n1439\t                       expr->data.symbol->symbol_name) == 0) {\n1440\t              struct Function *function =\n1441\t                  looked_up_env->bindings[i].value->function_value;\n1442\t              struct Env *new_env = malloc(sizeof(struct Env));\n1443\t              new_env->parent = current_env;\n1444\t              int j = 0;\n1445\t              struct ExpressionList *param_expr = expressions->next;\n1446\t              while (function->param_symbol_names[j] != NULL) {\n1447\t                struct Object *param = allocate(context, env);\n1448\t                evaluateExpression(param_expr->expression, param, current_env,\n1449\t                                   context);\n1450\t                param_expr = param_expr->next;\n1451\t                setObjectToEnv(new_env, function->param_symbol_names[j], param);\n1452\t                j++;\n1453\t              }\n1454\t              evaluateExpression(function->body, evaluated, new_env, context);\n1455\t              return;\n1456\t            }\n1457\t            i++;\n1458\t            // look up the parent env if not found\n1459\t            if (env->bindings[i].symbol_name == NULL) {\n1460\t              looked_up_env = looked_up_env->parent;\n1461\t              i = 0;\n1462\t            }\n1463\t          }\n1464\t          printf(\"Undefined function: %s\\n\", expr->data.symbol->symbol_name);\n1465\t          exit(1);\n1466\t        }\n1467\t      }\n1468\t    } else {\n1469\t      printf(\"S-exp must be started with symbol.\\n\");\n1470\t      exit(1);\n1471\t    }\n1472\t  } else {\n1473\t    evaluated->type = OBJ_NIL;\n1474\t  }\n1475\t}\n1476\t\n1477\tvoid evaluateLiteralExpression(struct ExpressionNode *expression,\n1478\t                               struct Object *evaluated) {\n1479\t  if (expression->data.literal->type == LIT_INTERGER) {\n1480\t    evaluated->type = OBJ_INTEGER;\n1481\t    evaluated->int_value = expression->data.literal->int_value;\n1482\t  } else if (expression->data.literal->type == LIT_STRING) {\n1483\t    evaluated->type = OBJ_STRING;\n1484\t    evaluated->string_value = expression->data.literal->string_value;\n1485\t  } else if (expression->data.literal->type == LIT_BOOLEAN) {\n1486\t    evaluated->type = OBJ_BOOL;\n1487\t    evaluated->bool_value = expression->data.literal->boolean_value;\n1488\t  }\n1489\t}\n1490\t\n1491\tvoid evaluateSymbolExpression(struct ExpressionNode *expression,\n1492\t                              struct Object *evaluated, struct Env *env,\n1493\t                              struct AllocatorContext *context) {\n1494\t  if (strcmp(expression->data.symbol->symbol_name, \"nil\") == 0) {\n1495\t    evaluated->type = OBJ_NIL;\n1496\t  } else {\n1497\t    // get symbol value from env\n1498\t    int i = 0;\n1499\t    while (env->bindings[i].symbol_name != NULL) {\n1500\t      if (strcmp(env->bindings[i].symbol_name,\n1501\t                 expression->data.symbol->symbol_name) == 0) {\n1502\t        *evaluated = *env->bindings[i].value;\n1503\t        env->bindings[i].value = evaluated;\n1504\t        return;\n1505\t      }\n1506\t      i++;\n1507\t    }\n1508\t    if (env->parent != NULL) {\n1509\t      evaluateSymbolExpression(expression, evaluated, env->parent, context);\n1510\t    } else {\n1511\t      printf(\"Undefined symbol: %s\\n\", expression->data.symbol->symbol_name);\n1512\t      exit(1);\n1513\t    }\n1514\t  }\n1515\t}\n1516\t\n1517\tvoid evaluateExpression(struct ExpressionNode *expression,\n1518\t                        struct Object *evaluated, struct Env *env,\n1519\t                        struct AllocatorContext *context) {\n1520\t  pushObjectStack(context->stack, evaluated);\n1521\t  if (expression->type == EXP_LIST) {\n1522\t    evaluateListExpression(expression, evaluated, env, context);\n1523\t  } else if (expression->type == EXP_SYMBOLIC_EXP) {\n1524\t    evaluateSymbolicExpression(expression, evaluated, env, context);\n1525\t  } else if (expression->type == EXP_LITERAL) {\n1526\t    evaluateLiteralExpression(expression, evaluated);\n1527\t  } else if (expression->type == EXP_SYMBOL) {\n1528\t    evaluateSymbolExpression(expression, evaluated, env, context);\n1529\t  }\n1530\t  popObjectStack(context->stack);\n1531\t}\n1532\t\n1533\tvoid evaluateExpressionWithContext(struct ExpressionNode *expression,\n1534\t                                   struct Object *evaluated, struct Env *env) {\n1535\t  struct AllocatorContext *context = initAllocator();\n1536\t  evaluateExpression(expression, evaluated, env, context);\n1537\t}\n1538\t\n1539\tvoid initEnv(struct Env *env) {\n1540\t  env->parent = NULL;\n1541\t  env->bindings[0].symbol_name = NULL;\n1542\t  env->bindings[0].value = NULL;\n1543\t}\n1544\t\n1545\tvoid evaluateProgram(struct ProgramNode *program) {\n1546\t  struct ExpressionList *expressions = program->expressions;\n1547\t\n1548\t  struct Env *env = malloc(sizeof(struct Env));\n1549\t  initEnv(env);\n1550\t\n1551\t  struct AllocatorContext *context = initAllocator();\n1552\t\n1553\t  while (expressions != NULL) {\n1554\t    struct Object *evaluated = allocate(context, env);\n1555\t    evaluateExpression(expressions->expression, evaluated, env, context);\n1556\t    expressions = expressions->next;\n1557\t  }\n1558\t}\n1559\t\n1560\tvoid evaluate(struct ParseResult *result) { evaluateProgram(result->program); }\n1561\t"}]},"parent_tool_use_id":null,"session_id":"848ae56e-9ab4-430e-93c1-1f3b9637ad4e","uuid":"716f79da-b481-4492-861e-9e9fa36fc575","timestamp":"2026-06-06T02:24:19.816Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-lYGPG0/project/c_src/src/worsp.c","content":"#include \"worsp.h\"\n#include <ctype.h>\n#include <math.h>\n#include <stdbool.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n// =================================================\n//   tokenizer\n// =================================================\n\nint isop(int ch) {\n  return ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '%' ||\n         ch == '|' || ch == '&' || ch == '=' || ch == '<' || ch == '>';\n}\n\nint match(struct ParseState *state, TokenKind kind) {\n  return state->token->kind == kind ? 1 : 0;\n}\n\nvoid next(char *source, struct ParseState *state) {\n  // Skip whitespaces\n  while (isspace(source[state->pos]) || source[state->pos] == '\\n') {\n    state->pos++;\n  }\n\n  struct Token *current = state->token;\n  struct Token *new = malloc(sizeof(struct Token));\n\n  if (source[state->pos] == '(') {\n    new->kind = TK_LPAREN;\n    new->str = \"(\";\n    state->pos++;\n  } else if (source[state->pos] == ')') {\n    new->kind = TK_RPAREN;\n    new->str = \")\";\n    state->pos++;\n  } else if (source[state->pos] == '\\'') {\n    new->kind = TK_QUOTE;\n    new->str = \"'\";\n    state->pos++;\n  } else if (source[state->pos] == '\\0') {\n    new->kind = TK_EOF;\n    new->str = \"\\0\";\n  } else if (isalpha(source[state->pos]) || isop(source[state->pos])) {\n    // tokenize symbol\n    int start = state->pos;\n    while (isalnum(source[state->pos]) || isop(source[state->pos])) {\n      state->pos++;\n    }\n    int length = state->pos - start;\n\n    char *str = malloc(length + 1);\n    strncpy(str, &source[start], length);\n    str[length] = '\\0';\n\n    if (strcmp(str, \"true\") == 0) {\n      new->kind = TK_TRUE;\n      free(str);\n    } else if (strcmp(str, \"false\") == 0) {\n      new->kind = TK_FALSE;\n      free(str);\n    } else {\n      new->kind = TK_SYMBOL;\n      new->str = str;\n    }\n  } else if (isdigit(source[state->pos])) {\n    // tokenize digit\n    int start = state->pos;\n    while (isdigit(source[state->pos])) {\n      state->pos++;\n    }\n    int length = state->pos - start;\n\n    char *str = malloc(length + 1);\n    strncpy(str, &source[start], length);\n    str[length] = '\\0';\n    int val = atoi(str);\n    free(str);\n\n    new->kind = TK_DIGIT;\n    new->val = val;\n  } else if (source[state->pos] == '\"') {\n    // tokenize string\n    state->pos++; // skip '\"'\n    int start = state->pos;\n    while (source[state->pos] != '\"' && source[state->pos] != '\\0') {\n      state->pos++;\n    }\n    int length = state->pos - start;\n    new->kind = TK_STRING;\n    new->str = malloc(length + 1);\n    strncpy(new->str, &source[start], length);\n    new->str[length] = '\\0';\n    if (source[state->pos] == '\"') {\n      state->pos++; // Skip quote\n    }\n  } else if (source[state->pos] == ';') {\n    // tokenize comment\n    while (source[state->pos] != '\\n' && source[state->pos] != '\\0') {\n      state->pos++;\n    }\n    next(source, state);\n    return;\n  } else {\n    printf(\"Unexpected token: %c\\n\", source[state->pos]);\n    exit(1);\n  }\n\n  if (current == NULL) {\n    state->token = new;\n    return;\n  }\n  state->token = current->next = new;\n}\n\n// =================================================\n//   parser\n//     <program>          ::= <expression>*\n//     <expression>       ::=\n//                        | <s_expression>\n//                        | <list>\n//                        | <symbol>\n//                        | <literal>\n//     <s_expression>     ::= \"(\" <expression>* \")\"\n//     <list>             ::= \"'(\" <expression>* \")\"\n//     <symbol>           ::= <symbol_name>\n//     <literal>          ::=\n//                         | <interger_literal>\n//                         | <string_literal>\n//                         | <boolean_literal>\n//     <interger_literal> ::= '1' | '2' | '3' | ...\n//     <string_literal>   ::= '\"' <letter>* '\"'\n//     <letter>           ::= 'a' | 'b' | 'c' | ...\n//     <boolean_literal>  ::= 'true' | 'false'\n// =================================================\n\nvoid appendExpressionToListExpression(struct ListNode *listNode,\n                                      struct ExpressionNode *expression) {\n  struct ExpressionList *expressions = malloc(sizeof(struct ExpressionList));\n  expressions->expression = expression;\n  expressions->next = NULL;\n  if (listNode->expressions == NULL) {\n    listNode->expressions = expressions;\n    return;\n  }\n  struct ExpressionList *current = listNode->expressions;\n  while (current->next != NULL) {\n    current = current->next;\n  }\n  current->next = expressions;\n}\n\nvoid appendExpressionToSymbolicExpression(\n    struct SymbolicExpNode *symbolicExpNode,\n    struct ExpressionNode *expression) {\n  struct ExpressionList *expressions = malloc(sizeof(struct ExpressionList));\n  expressions->expression = expression;\n  expressions->next = NULL;\n  if (symbolicExpNode->expressions == NULL) {\n    symbolicExpNode->expressions = expressions;\n    return;\n  }\n  struct ExpressionList *current = symbolicExpNode->expressions;\n  while (current->next != NULL) {\n    current = current->next;\n  }\n  current->next = expressions;\n}\n\nvoid parseExpression(char *source, struct ParseState *state,\n                     struct ExpressionNode *expression);\n\nvoid parseSymbolicExpression(char *source, struct ParseState *state,\n                             struct ExpressionNode *expression) {\n  struct SymbolicExpNode *symbolicExp = malloc(sizeof(struct SymbolicExpNode));\n\n  expression->type = EXP_SYMBOLIC_EXP;\n  expression->data.symbolic_exp = symbolicExp;\n  expression->data.symbolic_exp->expressions = NULL;\n  next(source, state); // eat '('\n  while (!match(state, TK_RPAREN)) {\n    struct ExpressionNode *expressionItem =\n        malloc(sizeof(struct ExpressionNode));\n    parseExpression(source, state, expressionItem);\n    appendExpressionToSymbolicExpression(symbolicExp, expressionItem);\n  }\n  next(source, state); // eat ')'\n}\n\nvoid parseListExpression(char *source, struct ParseState *state,\n                         struct ExpressionNode *expression) {\n  struct ListNode *list = malloc(sizeof(struct ListNode));\n\n  expression->type = EXP_LIST;\n  expression->data.list = list;\n  expression->data.list->expressions = NULL;\n  next(source, state); // eat quote\n  next(source, state); // eat '('\n  while (!match(state, TK_RPAREN)) {\n    struct ExpressionNode *expressionItem =\n        malloc(sizeof(struct ExpressionNode));\n    parseExpression(source, state, expressionItem);\n    appendExpressionToListExpression(list, expressionItem);\n  }\n  next(source, state); // eat ')'\n}\n\nvoid parseSymbolExpression(char *source, struct ParseState *state,\n                           struct ExpressionNode *expression) {\n  expression->type = EXP_SYMBOL;\n  expression->data.symbol = malloc(sizeof(struct SymbolNode));\n  expression->data.symbol->symbol_name = state->token->str;\n  next(source, state);\n}\n\nvoid parseLiteralExpression(char *source, struct ParseState *state,\n                            struct ExpressionNode *expression) {\n  if (match(state, TK_DIGIT)) {\n    expression->type = EXP_LITERAL;\n    expression->data.literal = malloc(sizeof(struct LiteralNode));\n    expression->data.literal->type = LIT_INTERGER;\n    expression->data.literal->int_value = state->token->val;\n    next(source, state);\n  } else if (match(state, TK_STRING)) {\n    expression->type = EXP_LITERAL;\n    expression->data.literal = malloc(sizeof(struct LiteralNode));\n    expression->data.literal->type = LIT_STRING;\n    expression->data.literal->string_value = state->token->str;\n    next(source, state);\n  } else if (match(state, TK_TRUE)) {\n    expression->type = EXP_LITERAL;\n    expression->data.literal = malloc(sizeof(struct LiteralNode));\n    expression->data.literal->type = LIT_BOOLEAN;\n    expression->data.literal->boolean_value = true;\n    next(source, state);\n  } else if (match(state, TK_FALSE)) {\n    expression->type = EXP_LITERAL;\n    expression->data.literal = malloc(sizeof(struct LiteralNode));\n    expression->data.literal->type = LIT_BOOLEAN;\n    expression->data.literal->boolean_value = false;\n    next(source, state);\n  } else {\n    printf(\"Unexpected token: %s\\n\", state->token->str);\n    exit(1);\n  }\n}\n\nvoid parseExpression(char *source, struct ParseState *state,\n                     struct ExpressionNode *expression) {\n  if (match(state, TK_LPAREN)) {\n    parseSymbolicExpression(source, state, expression);\n  } else if (match(state, TK_QUOTE)) {\n    parseListExpression(source, state, expression);\n  } else if (match(state, TK_SYMBOL)) {\n    parseSymbolExpression(source, state, expression);\n  } else if (match(state, TK_DIGIT) || match(state, TK_STRING) ||\n             match(state, TK_TRUE) || match(state, TK_FALSE)) {\n    parseLiteralExpression(source, state, expression);\n  } else {\n    printf(\"Unexpected token: %s\\n\", state->token->str);\n    exit(1);\n  }\n}\n\nvoid appendExpressionToProgram(struct ProgramNode *program,\n                               struct ExpressionNode *expression) {\n  struct ExpressionList *expressions = malloc(sizeof(struct ExpressionList));\n  expressions->expression = expression;\n  expressions->next = NULL;\n  if (program->expressions == NULL) {\n    program->expressions = expressions;\n    return;\n  }\n  struct ExpressionList *current = program->expressions;\n  while (current->next != NULL) {\n    current = current->next;\n  }\n  current->next = expressions;\n}\n\nvoid parseProgram(char *source, struct ParseState *state,\n                  struct ParseResult *result) {\n  // Set first token\n  next(source, state);\n  struct ProgramNode *program = malloc(sizeof(struct ProgramNode));\n  program->expressions = NULL;\n\n  result->program = program;\n\n  while (!match(state, TK_EOF)) {\n    struct ExpressionNode *expression = malloc(sizeof(struct ExpressionNode));\n    parseExpression(source, state, expression);\n    appendExpressionToProgram(program, expression);\n  }\n}\n\nvoid parse(char *source, struct ParseState *state, struct ParseResult *result) {\n  parseProgram(source, state, result);\n}\n\n// =================================================\n//   garbage collector\n// =================================================\n\nvoid initializeObjectStack(struct ObjectStack *stack) { stack->top = -1; }\n\nint isFullObjectStack(struct ObjectStack *stack) {\n  return stack->top == OBJECT_NUMBER;\n}\n\nint isEmptyObjectStack(struct ObjectStack *stack) { return stack->top == -1; }\n\nvoid pushObjectStack(struct ObjectStack *stack, struct Object *obj) {\n  if (isFullObjectStack(stack)) {\n    printf(\"Object stack is full.\\n\");\n    exit(1);\n  }\n  stack->top++;\n  stack->objects[stack->top] = obj;\n}\n\nstruct Object *popObjectStack(struct ObjectStack *stack) {\n  if (isEmptyObjectStack(stack)) {\n    printf(\"Object stack is empty.\\n\");\n    exit(1);\n  }\n  struct Object *obj = stack->objects[stack->top];\n  stack->top--;\n  return obj;\n}\n\nstruct AllocatorContext *initAllocator() {\n  struct AllocatorContext *context = malloc(sizeof(struct AllocatorContext));\n\n  context->memory_pool = (struct Object *)malloc(MEMORY_SIZE);\n  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n    context->free_bitmap[i] = 0;\n  }\n\n  context->gc_less_mode = 0;\n\n  struct ObjectStack *stack = malloc(sizeof(struct ObjectStack));\n  initializeObjectStack(stack);\n  context->stack = stack;\n\n  return context;\n}\n\nvoid freeObject(struct AllocatorContext *context, struct Object *object) {\n  int index = object - context->memory_pool;\n  context->free_bitmap[index] = 0;\n}\n\nvoid sweep(struct AllocatorContext *context) {\n  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n    if (context->free_bitmap[i] == 1) {\n      struct Object *obj = &context->memory_pool[i];\n      if (obj->marked) {\n        obj->marked = false;\n      } else {\n        freeObject(context, obj);\n      }\n    }\n  }\n}\n\nint isLastConsCell(struct ConsCell *conscell) {\n  return conscell->cdr->type == OBJ_NIL;\n}\n\nvoid mark(struct Object *obj) {\n  if (obj->marked) {\n    return;\n  }\n  obj->marked = true;\n  if (obj->type == OBJ_LIST) {\n    struct Object *current = obj;\n    while (1) {\n      mark(current);\n      // evaluating list object can be nil\n      if (current->list_value == NULL) {\n        break;\n      }\n      mark(current->list_value->car);\n      if (isLastConsCell(current->list_value)) {\n        break;\n      }\n      current = current->list_value->cdr;\n    }\n  }\n}\n\nvoid markAll(struct Env *env, struct AllocatorContext *context) {\n  // mark objects in stack\n  for (int i = 0; i <= context->stack->top; i++) {\n    struct Object *obj = context->stack->objects[i];\n    mark(obj);\n  }\n\n  int i = 0;\n  while (env->bindings[i].symbol_name != NULL) {\n    struct Object *obj = env->bindings[i].value;\n    mark(obj);\n    i++;\n  }\n  if (env->parent != NULL) {\n    markAll(env->parent, context);\n  }\n}\n\nvoid gc(struct AllocatorContext *context, struct Env *env) {\n  markAll(env, context);\n  sweep(context);\n}\n\nstruct Object *allocate(struct AllocatorContext *context, struct Env *env) {\n  size_t object_size = sizeof(struct Object);\n  if (context->gc_less_mode) {\n    return malloc(object_size);\n  }\n\n  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n    if (context->free_bitmap[i] == 0) {\n      context->free_bitmap[i] = 1; // Mark the block as used\n      return &context->memory_pool[i];\n    }\n  }\n\n  gc(context, env);\n\n  for (unsigned long i = 0; i < FREE_BITMAP_SIZE; ++i) {\n    if (context->free_bitmap[i] == 0) {\n      context->free_bitmap[i] = 1; // Mark the block as used\n      return &context->memory_pool[i];\n    }\n  }\n\n  fprintf(stderr, \"Out of Memory\\n\");\n  exit(1);\n}\n\n// =================================================\n//   defined functions\n// =================================================\n\nbool boolVal(struct Object *obj) {\n  if (obj->type == OBJ_BOOL) {\n    return obj->bool_value;\n  } else if (obj->type == OBJ_NIL) {\n    return false;\n  } else {\n    return true;\n  }\n}\n\nint eq(struct Object *op1, struct Object *op2) {\n  if (op1->type != op2->type) {\n    return 0;\n  } else {\n    if (op1->type == OBJ_INTEGER) {\n      return op1->int_value == op2->int_value;\n    } else if (op1->type == OBJ_STRING) {\n      return strcmp(op1->string_value, op2->string_value) == 0;\n    } else if (op1->type == OBJ_BOOL) {\n      return op1->bool_value == op2->bool_value;\n    } else if (op1->type == OBJ_LIST) {\n      return op1->list_value == op2->list_value;\n    } else if (op1->type == OBJ_NIL) {\n      return 1;\n    }\n  }\n  return 0;\n}\n\nchar *stringifyObject(struct Object *obj) {\n  if (obj->type == OBJ_INTEGER) {\n    if (obj->int_value == 0) {\n      char *str = (char *)malloc(2 * sizeof(char));\n      strncpy(str, \"0\", 2);\n      return str;\n    }\n    int digits = (int)log10(obj->int_value) + 1;\n    char *str = (char *)malloc((digits + 1) * sizeof(char));\n    sprintf(str, \"%d\", obj->int_value);\n    return str;\n  } else if (obj->type == OBJ_STRING) {\n    char *str = (char *)malloc((strlen(obj->string_value) + 1) * sizeof(char));\n    strncpy(str, obj->string_value, strlen(obj->string_value) + 1);\n    return str;\n  } else if (obj->type == OBJ_BOOL) {\n    char *str = (char *)malloc(1 * sizeof(char));\n    if (obj->bool_value) {\n      strncpy(str, \"T\", 2);\n    } else {\n      strncpy(str, \"F\", 2);\n    }\n    return str;\n  } else if (obj->type == OBJ_LIST) {\n    int length = 2; // '(' and ')'\n    char *str = (char *)malloc(length + 1 * sizeof(char));\n    memset(str, 0, length + 1);\n    str[0] = '(';\n    struct ConsCell *current = obj->list_value;\n    while (1) {\n      char *serialized = stringifyObject(current->car);\n      length += strlen(serialized);\n      str = realloc(str, length + 1);\n      strncat(str, serialized, strlen(serialized));\n      if (isLastConsCell(current)) {\n        break;\n      } else {\n        length += 1; // \" \"\n        str = realloc(str, length + 1);\n        strncat(str, \" \", 1);\n      }\n      current = current->cdr->list_value;\n    }\n    str[length - 1] = ')';\n    str[length] = '\\0';\n    return str;\n  } else if (obj->type == OBJ_NIL) {\n    char *str = (char *)malloc(4 * sizeof(char));\n    strncpy(str, \"nil\", 4);\n    return str;\n  } else if (obj->type == OBJ_FUNCTION) {\n    char *str = (char *)malloc(9 * sizeof(char));\n    strncpy(str, \"<function>\", 10);\n    return str;\n  } else {\n    printf(\"Unexpected object type: %d\\n\", obj->type);\n    exit(1);\n  }\n}\n\nvoid definedFunctionAdd(struct Object *op1, struct Object *op2,\n                        struct Object *evaluated) {\n  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = op1->int_value + op2->int_value;\n  } else if (op1->type == OBJ_STRING && op2->type == OBJ_STRING) {\n    evaluated->type = OBJ_STRING;\n    evaluated->string_value =\n        malloc((strlen(op1->string_value) + strlen(op2->string_value) + 1) *\n               sizeof(char));\n    strncpy(evaluated->string_value, op1->string_value,\n            strlen(op1->string_value) + 1);\n    strcat(evaluated->string_value, op2->string_value);\n  } else {\n    printf(\"Type error: operands for + must be integers or strings.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionSub(struct Object *op1, struct Object *op2,\n                        struct Object *evaluated) {\n  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = op1->int_value - op2->int_value;\n  } else {\n    printf(\"Type error: operands for - must be integers.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionMul(struct Object *op1, struct Object *op2,\n                        struct Object *evaluated) {\n  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = op1->int_value * op2->int_value;\n  } else {\n    printf(\"Type error: operands for * must be integers.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionDiv(struct Object *op1, struct Object *op2,\n                        struct Object *evaluated) {\n  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = op1->int_value / op2->int_value;\n  } else {\n    printf(\"Type error: operands for / must be integers.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionMod(struct Object *op1, struct Object *op2,\n                        struct Object *evaluated) {\n  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = op1->int_value % op2->int_value;\n  } else {\n    printf(\"Type error: operands for % must be integers.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionOr(struct Object *op1, struct Object *op2,\n                       struct Object *evaluated) {\n  if (boolVal(op1) || boolVal(op2)) {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = 1;\n  } else {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = 0;\n  }\n}\n\nvoid definedFunctionAnd(struct Object *op1, struct Object *op2,\n                        struct Object *evaluated) {\n  if (boolVal(op1) && boolVal(op2)) {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = 1;\n  } else {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = 0;\n  }\n}\n\nvoid definedFunctionLt(struct Object *op1, struct Object *op2,\n                       struct Object *evaluated) {\n  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n    if (op1->int_value < op2->int_value) {\n      evaluated->type = OBJ_BOOL;\n      evaluated->bool_value = 1;\n    } else {\n      evaluated->type = OBJ_BOOL;\n      evaluated->bool_value = 0;\n    }\n  } else {\n    printf(\"Type error: operands for < must be integers.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionGt(struct Object *op1, struct Object *op2,\n                       struct Object *evaluated) {\n  if (op1->type == OBJ_INTEGER && op2->type == OBJ_INTEGER) {\n    if (op1->int_value > op2->int_value) {\n      evaluated->type = OBJ_BOOL;\n      evaluated->bool_value = 1;\n    } else {\n      evaluated->type = OBJ_BOOL;\n      evaluated->bool_value = 0;\n    }\n  } else {\n    printf(\"Type error: operands for < must be integers.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionEq(struct Object *op1, struct Object *op2,\n                       struct Object *evaluated) {\n  if (eq(op1, op2)) {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = 1;\n  } else {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = 0;\n  }\n}\n\nvoid definedFunctionCar(struct Object *op, struct Object *evaluated) {\n  if (op->type != OBJ_LIST) {\n    printf(\"Type error: car operand must be list.\\n\");\n    exit(1);\n  }\n  *evaluated = *(op->list_value->car);\n}\n\nvoid definedFunctionCdr(struct Object *op, struct Object *evaluated) {\n  if (op->type != OBJ_LIST) {\n    printf(\"Type error: cdr operand must be list.\\n\");\n    exit(1);\n  }\n  *evaluated = *op->list_value->cdr;\n}\n\nvoid definedFunctionCons(struct Object *op1, struct Object *op2,\n                         struct Object *evaluated, struct Env *env,\n                         struct AllocatorContext *context) {\n  evaluated->type = OBJ_LIST;\n  evaluated->list_value = malloc(sizeof(struct ConsCell));\n  evaluated->list_value->car = op1;\n\n  if (op2->type == OBJ_LIST) {\n    evaluated->list_value->type = CONSCELL_TYPE_CELL;\n    evaluated->list_value->cdr = op2;\n  } else if (op2->type == OBJ_NIL) {\n    evaluated->list_value->cdr = op2;\n  } else {\n    struct Object *cdr_obj = allocate(context, env);\n    cdr_obj->type = OBJ_LIST;\n    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n    new_conscell->car = op2;\n    new_conscell->type = CONSCELL_TYPE_CELL;\n    new_conscell->cdr = allocate(context, env);\n    new_conscell->cdr->type = OBJ_NIL;\n    cdr_obj->list_value = new_conscell;\n    evaluated->list_value->cdr = cdr_obj;\n  }\n}\n\nvoid definedFunctionNot(struct Object *op, struct Object *evaluated) {\n  if (op->type != OBJ_BOOL) {\n    printf(\"Type error: not operand must be boolean.\\n\");\n    exit(1);\n  }\n  evaluated->type = OBJ_BOOL;\n  if (op->bool_value) {\n    evaluated->bool_value = 0;\n  } else {\n    evaluated->bool_value = 1;\n  }\n}\n\nvoid definedFunctionSplit(struct Object *op1, struct Object *op2,\n                          struct Object *evaluated, struct Env *env,\n                          struct AllocatorContext *context) {\n  if (op1->type != OBJ_STRING) {\n    printf(\"Type error: split first operand must be string.\\n\");\n    exit(1);\n  }\n  if (op2->type != OBJ_STRING) {\n    printf(\"Type error: split second operand must be string.\\n\");\n    exit(1);\n  }\n\n  // when op2 is \"\", return list of characters\n  if (strcmp(op2->string_value, \"\") == 0) {\n    evaluated->type = OBJ_LIST;\n    evaluated->list_value = malloc(sizeof(struct ConsCell));\n    evaluated->list_value->type = CONSCELL_TYPE_CELL;\n    evaluated->list_value->car = allocate(context, env);\n    evaluated->list_value->car->type = OBJ_STRING;\n    evaluated->list_value->car->string_value = malloc(sizeof(char));\n    evaluated->list_value->car->string_value[0] = op1->string_value[0];\n    evaluated->list_value->cdr = allocate(context, env);\n    evaluated->list_value->cdr->type = OBJ_NIL;\n    struct ConsCell *current = evaluated->list_value;\n    for (unsigned long i = 1; i < strlen(op1->string_value); i++) {\n      struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n      new_conscell->type = CONSCELL_TYPE_CELL;\n      new_conscell->car = allocate(context, env);\n      new_conscell->car->type = OBJ_STRING;\n      new_conscell->car->string_value = malloc(sizeof(char));\n      new_conscell->car->string_value[0] = op1->string_value[i];\n      new_conscell->cdr = allocate(context, env);\n      new_conscell->cdr->type = OBJ_NIL;\n      current->cdr = allocate(context, env);\n      current->cdr->type = OBJ_LIST;\n      current->cdr->list_value = new_conscell;\n      current = current->cdr->list_value;\n    }\n    return;\n  }\n\n  // split op1 string by op2 string and return list of strings\n  evaluated->type = OBJ_LIST;\n  evaluated->list_value = malloc(sizeof(struct ConsCell));\n  evaluated->list_value->type = CONSCELL_TYPE_CELL;\n  evaluated->list_value->car = allocate(context, env);\n  evaluated->list_value->car->type = OBJ_STRING;\n  evaluated->list_value->car->string_value =\n      strtok(op1->string_value, op2->string_value);\n  evaluated->list_value->cdr = allocate(context, env);\n  evaluated->list_value->cdr->type = OBJ_NIL;\n  struct ConsCell *current = evaluated->list_value;\n  while (1) {\n    char *token = strtok(NULL, op2->string_value);\n    if (token == NULL) {\n      break;\n    }\n    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n    new_conscell->type = CONSCELL_TYPE_CELL;\n    new_conscell->car = allocate(context, env);\n    new_conscell->car->type = OBJ_STRING;\n    new_conscell->car->string_value = token;\n    new_conscell->cdr = allocate(context, env);\n    new_conscell->cdr->type = OBJ_NIL;\n    current->cdr = allocate(context, env);\n    current->cdr->type = OBJ_LIST;\n    current->cdr->list_value = new_conscell;\n    current = current->cdr->list_value;\n  }\n}\n\nvoid definedFunctionListRef(struct Object *op1, struct Object *op2,\n                            struct Object *evaluated) {\n  if (op1->type != OBJ_LIST) {\n    printf(\"Type error: list-ref first operand must be list.\\n\");\n    exit(1);\n  }\n  if (op2->type != OBJ_INTEGER) {\n    printf(\"Type error: list-ref second operand must be integer.\\n\");\n    exit(1);\n  }\n  int index = op2->int_value;\n  struct ConsCell *current = op1->list_value;\n  for (int i = 0; i < index; i++) {\n    if (current->cdr->type == OBJ_NIL) {\n      printf(\"Index out of range.\\n\");\n      exit(1);\n    }\n    current = current->cdr->list_value;\n  }\n  *evaluated = *current->car;\n}\n\nvoid definedFunctionRemoveWhitespaces(struct Object *op1,\n                                      struct Object *evaluated) {\n  if (op1->type != OBJ_STRING) {\n    printf(\"Type error: remove-whitespaces operand must be string.\\n\");\n    exit(1);\n  }\n  char *str = op1->string_value;\n  char *new_str = malloc(sizeof(char) * (strlen(str) + 1));\n  int i = 0;\n  int j = 0;\n  while (str[i]) {\n    if (!isspace(str[i])) {\n      new_str[j++] = str[i];\n    }\n    i++;\n  }\n  new_str[j] = '\\0';\n  evaluated->type = OBJ_STRING;\n  evaluated->string_value = new_str;\n}\n\nvoid definedFunctionPop(struct Object *op, struct Object *evaluated) {\n  // empty list is evaluted as nil\n  if (op->type == OBJ_NIL) {\n    evaluated->type = OBJ_NIL;\n    return;\n  }\n  if (op->type != OBJ_LIST) {\n    printf(\"Type error: pop operand must be list.\\n\");\n    exit(1);\n  }\n  struct ConsCell *current = op->list_value;\n  struct ConsCell *prev = NULL;\n  while (1) {\n    if (isLastConsCell(current)) {\n      if (prev == NULL) {\n        *evaluated = *current->car;\n      } else {\n        prev->cdr->type = OBJ_NIL;\n        prev->cdr->list_value = NULL;\n        *evaluated = *current->car;\n      }\n      break;\n    }\n    prev = current;\n    current = current->cdr->list_value;\n  }\n}\n\nvoid definedFunctionPush(struct Object *op1, struct Object *op2,\n                         struct Object *evaluated, struct Env *env,\n                         struct AllocatorContext *context) {\n  if (op1->type == OBJ_NIL) {\n    *evaluated = *op2;\n\n    int i = 0;\n    while (env->bindings[i].symbol_name != NULL) {\n      if (env->bindings[i].value == op1) {\n        struct Object *new_list = allocate(context, env);\n        new_list->type = OBJ_LIST;\n        new_list->list_value = malloc(sizeof(struct ConsCell));\n        new_list->list_value->type = CONSCELL_TYPE_CELL;\n        new_list->list_value->car = op2;\n        new_list->list_value->cdr = allocate(context, env);\n        new_list->list_value->cdr->type = OBJ_NIL;\n        env->bindings[i].value = new_list;\n        break;\n      }\n      i++;\n    }\n\n    return;\n  }\n\n  if (op1->type != OBJ_LIST) {\n    printf(\"Type error: push second operand must be list.\\n\");\n    exit(1);\n  }\n\n  struct ConsCell *current = op1->list_value;\n  while (1) {\n    if (isLastConsCell(current)) {\n      struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n      new_conscell->type = CONSCELL_TYPE_CELL;\n      new_conscell->car = op2;\n      new_conscell->cdr = allocate(context, env);\n      new_conscell->cdr->type = OBJ_NIL;\n      current->cdr->type = OBJ_LIST;\n      current->cdr->list_value = new_conscell;\n      break;\n    }\n    current = current->cdr->list_value;\n  }\n\n  *evaluated = *op2;\n}\n\nvoid definedFunctionLength(struct Object *op, struct Object *evaluated) {\n  if (op->type == OBJ_NIL) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = 0;\n    return;\n  }\n  if (op->type == OBJ_LIST) {\n    int length = 1;\n    struct ConsCell *current = op->list_value;\n    while (1) {\n      if (isLastConsCell(current)) {\n        break;\n      }\n      length++;\n      current = current->cdr->list_value;\n    }\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = length;\n  } else if (op->type == OBJ_STRING) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = strlen(op->string_value);\n  } else {\n    printf(\"Type error: length operand must be list or string.\\n\");\n    exit(1);\n  }\n}\n\nvoid definedFunctionIsIntString(struct Object *op, struct Object *evaluated) {\n  if (op->type == OBJ_STRING) {\n    char *str = op->string_value;\n    int i = 0;\n    while (str[i]) {\n      if (!isdigit(str[i])) {\n        evaluated->type = OBJ_BOOL;\n        evaluated->bool_value = false;\n        return;\n      }\n      i++;\n    }\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = true;\n  } else {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = false;\n  }\n}\n\nvoid definedFunctionParseInt(struct Object *op, struct Object *evaluated) {\n  if (op->type != OBJ_STRING) {\n    printf(\"Type error: parse-int operand must be string.\\n\");\n    exit(1);\n  }\n  char *str = op->string_value;\n  int i = 0;\n  while (str[i]) {\n    if (!isdigit(str[i])) {\n      printf(\"Type error: parse-int operand must be string of digits.\\n\");\n      exit(1);\n    }\n    i++;\n  }\n  evaluated->type = OBJ_INTEGER;\n  evaluated->int_value = atoi(str);\n}\n\nvoid definedFunctionStringRef(struct Object *op1, struct Object *op2, struct Object *evaluated) {\n  if (op1->type != OBJ_STRING) {\n    printf(\"Type error: string-ref first operand must be string.\\n\");\n    exit(1);\n  }\n  if (op2->type != OBJ_INTEGER) {\n    printf(\"Type error: string-ref second operand must be integer.\\n\");\n    exit(1);\n  }\n  int index = op2->int_value;\n\n  if (index < 0 || index >= (int)strlen(op1->string_value)) {\n    printf(\"Index out of range.\\n\");\n    exit(1);\n  }\n  evaluated->type = OBJ_STRING;\n  evaluated->string_value = malloc(sizeof(char) * 2);\n  evaluated->string_value[0] = op1->string_value[index];\n  evaluated->string_value[1] = '\\0';\n}\n\n// =================================================\n//   evaluator\n// =================================================\n\nvoid evaluateListExpression(struct ExpressionNode *expression,\n                            struct Object *evaluated, struct Env *env,\n                            struct AllocatorContext *context) {\n  struct ExpressionList *expressions = expression->data.list->expressions;\n\n  // empty data list is evaluated as nil\n  if (expressions == NULL) {\n    evaluated->type = OBJ_NIL;\n    return;\n  }\n\n  evaluated->type = OBJ_LIST;\n\n  struct ConsCell *car_conscell = NULL;\n  struct ConsCell *prev_conscell = NULL;\n\n  while (expressions != NULL) {\n    struct ConsCell *new_conscell = malloc(sizeof(struct ConsCell));\n    if (car_conscell == NULL) {\n      car_conscell = new_conscell;\n    }\n\n    struct Object *evaluatedItem = allocate(context, env);\n    new_conscell->car = evaluatedItem;\n    evaluateExpression(expressions->expression, evaluatedItem, env, context);\n\n    expressions = expressions->next;\n\n    if (prev_conscell != NULL) {\n      struct Object *new_cdr = allocate(context, env);\n      new_cdr->type = OBJ_LIST;\n      new_cdr->list_value = new_conscell;\n      prev_conscell->cdr = new_cdr;\n      prev_conscell->type = CONSCELL_TYPE_CELL;\n    }\n    prev_conscell = new_conscell;\n\n    if (expressions == NULL) {\n      struct Object *nilObj = allocate(context, env);\n      nilObj->type = OBJ_NIL;\n      prev_conscell->type = CONSCELL_TYPE_NIL;\n      prev_conscell->cdr = nilObj;\n    }\n  }\n\n  evaluated->list_value = car_conscell;\n}\n\nvoid setObjectToEnv(struct Env *env, char *symbolName, struct Object *obj) {\n  // search binding that has the symbol name\n  int i = 0;\n  while (env->bindings[i].symbol_name != NULL) {\n    if (strcmp(env->bindings[i].symbol_name, symbolName) == 0) {\n      env->bindings[i].value = obj;\n      return;\n    }\n    i++;\n  }\n\n  // if not found, set to parent env\n  struct Binding *binding = malloc(sizeof(struct Binding));\n  binding->symbol_name = symbolName;\n  binding->value = obj;\n  i = 0;\n  while (env->bindings[i].symbol_name != NULL) {\n    i++;\n  }\n  env->bindings[i] = *binding;\n}\n\nvoid evaluateSymbolicExpression(struct ExpressionNode *expression,\n                                struct Object *evaluated, struct Env *env,\n                                struct AllocatorContext *context) {\n  struct ExpressionList *expressions = expression->data.list->expressions;\n  if (expressions != NULL) {\n    struct ExpressionNode *expr = expressions->expression;\n    if (expr != NULL && expr->type == EXP_SYMBOL) {\n      if (strcmp(expr->data.symbol->symbol_name, \"if\") == 0) {\n        // if\n        struct ExpressionNode *cond = expressions->next->expression;\n        if (cond == NULL) {\n          printf(\"if must have condition.\\n\");\n          exit(1);\n        }\n        struct ExpressionNode *then = expressions->next->next->expression;\n        if (then == NULL) {\n          printf(\"if must have then clause.\\n\");\n          exit(1);\n        }\n        struct Object *condObj = allocate(context, env);\n        evaluateExpression(cond, condObj, env, context);\n        if (boolVal(condObj)) {\n          evaluateExpression(then, evaluated, env, context);\n        } else {\n          if (expressions->next->next->next != NULL) {\n            struct ExpressionNode *els =\n                expressions->next->next->next->expression;\n            evaluateExpression(els, evaluated, env, context);\n          } else {\n            evaluated->type = OBJ_NIL;\n          }\n        }\n      } else if (strcmp(expr->data.symbol->symbol_name, \"while\") == 0) {\n        // while\n        struct ExpressionNode *cond = expressions->next->expression;\n        if (cond == NULL) {\n          printf(\"if must have condition.\\n\");\n          exit(1);\n        }\n        struct ExpressionNode *then = expressions->next->next->expression;\n        if (then == NULL) {\n          printf(\"if must have then clause.\\n\");\n          exit(1);\n        }\n        while (1) {\n          struct Object *condObj = allocate(context, env);\n          evaluateExpression(cond, condObj, env, context);\n          if (boolVal(condObj)) {\n            evaluateExpression(then, evaluated, env, context);\n          } else {\n            evaluated->type = OBJ_NIL;\n            break;\n          }\n        }\n      } else if (strcmp(expr->data.symbol->symbol_name, \"=\") == 0) {\n        // assignment\n        struct ExpressionNode symbolExpr = *expressions->next->expression;\n        if (symbolExpr.type != EXP_SYMBOL) {\n          printf(\"Variable name must be symbol.\\n\");\n          exit(1);\n        }\n        char *symbol_name = symbolExpr.data.symbol->symbol_name;\n        struct ExpressionNode *expr = expressions->next->next->expression;\n\n        if (expr == NULL) {\n          printf(\"assignment must have expression.\\n\");\n          exit(1);\n        }\n        struct Object *evaluatedExpr = allocate(context, env);\n        evaluateExpression(expr, evaluatedExpr, env, context);\n        *evaluated = *evaluatedExpr;\n\n        // set value to current env\n        setObjectToEnv(env, symbol_name, evaluatedExpr);\n      } else if ((strcmp(expr->data.symbol->symbol_name, \"defun\") == 0)) {\n        // define function\n        // (defun fn (n) (+ n 1))\n        struct ExpressionNode symbolExpr = *expressions->next->expression;\n        if (symbolExpr.type != EXP_SYMBOL) {\n          printf(\"Function name must be symbol.\\n\");\n          exit(1);\n        }\n        char *symbol_name = symbolExpr.data.symbol->symbol_name;\n\n        struct ExpressionNode *paramsExpr = expressions->next->next->expression;\n        if (paramsExpr == NULL) {\n          printf(\"Function must have parameter.\\n\");\n          exit(1);\n        }\n        if (paramsExpr->type != EXP_SYMBOLIC_EXP) {\n          printf(\"Function parameter must be list.\\n\");\n          exit(1);\n        }\n\n        struct ExpressionList *params =\n            paramsExpr->data.symbolic_exp->expressions;\n        // check all elements are symbol and get symbol names\n\n        char **param_symbol_names = malloc(sizeof(char *) * MAX_BINDINGS);\n\n        int i = 0;\n        while (params != NULL) {\n          if (params->expression->type != EXP_SYMBOL) {\n            printf(\"Function parameter must be symbol.\\n\");\n            exit(1);\n          }\n          param_symbol_names[i] = params->expression->data.symbol->symbol_name;\n          i++;\n          params = params->next;\n        }\n\n        struct ExpressionNode *bodyExpr =\n            expressions->next->next->next->expression;\n        if (bodyExpr == NULL) {\n          printf(\"Function must have body.\\n\");\n          exit(1);\n        }\n\n        struct Function *function = malloc(sizeof(struct Function));\n        function->param_symbol_names = param_symbol_names;\n        function->body = bodyExpr;\n\n        evaluated->type = OBJ_FUNCTION;\n        evaluated->function_value = function;\n\n        setObjectToEnv(env, symbol_name, evaluated);\n      } else {\n        // function call\n        if (strcmp(expr->data.symbol->symbol_name, \"+\") == 0) {\n          // +\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionAdd(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"-\") == 0) {\n          // -\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionSub(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"*\") == 0) {\n          // *\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionMul(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"/\") == 0) {\n          // /\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionDiv(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"%\") == 0) {\n          // %\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionMod(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"||\") == 0) {\n          // ||\n          struct ExpressionList *exprs = expressions->next;\n          struct Object *operand = NULL;\n          while (exprs != NULL) {\n            operand = allocate(context, env);\n            evaluateExpression(exprs->expression, operand, env, context);\n            if (boolVal(operand)) {\n              evaluated->type = OBJ_BOOL;\n              evaluated->bool_value = 1;\n              return;\n            }\n            exprs = exprs->next;\n          }\n          evaluated->type = OBJ_BOOL;\n          evaluated->bool_value = 0;\n        } else if (strcmp(expr->data.symbol->symbol_name, \"&&\") == 0) {\n          // &&\n          struct ExpressionList *exprs = expressions->next;\n          struct Object *operand = NULL;\n          while (exprs != NULL) {\n            operand = allocate(context, env);\n            evaluateExpression(exprs->expression, operand, env, context);\n            if (!boolVal(operand)) {\n              evaluated->type = OBJ_BOOL;\n              evaluated->bool_value = 0;\n              return;\n            }\n            exprs = exprs->next;\n          }\n          evaluated->type = OBJ_BOOL;\n          evaluated->bool_value = 1;\n        } else if (strcmp(expr->data.symbol->symbol_name, \"<\") == 0) {\n          // <\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionLt(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \">\") == 0) {\n          // >\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionGt(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"eq\") == 0) {\n          // eq\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionEq(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"not\") == 0) {\n          // not\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionNot(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"print\") == 0) {\n          // print\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          char *str = stringifyObject(operand);\n          printf(\"%s\\n\", str);\n          free(str);\n          evaluated->type = OBJ_NIL;\n        } else if (strcmp(expr->data.symbol->symbol_name, \"car\") == 0) {\n          // car\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionCar(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"cdr\") == 0) {\n          // cdr\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionCdr(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"cons\") == 0) {\n          // cons\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionCons(operand1, operand2, evaluated, env, context);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"readline\") == 0) {\n          // readline\n          char *line = NULL;\n          size_t len = 0;\n          ssize_t read;\n          if ((read = getline(&line, &len, stdin)) != -1) {\n            evaluated->type = OBJ_STRING;\n            // trim newline\n            line[read - 1] = '\\0';\n            evaluated->string_value = line;\n          } else {\n            evaluated->type = OBJ_NIL;\n          }\n        } else if (strcmp(expr->data.symbol->symbol_name, \"split\") == 0) {\n          // split\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionSplit(operand1, operand2, evaluated, env, context);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"list-ref\") == 0) {\n          // list-ref\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                             context);\n          definedFunctionListRef(operand1, operand2, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"progn\") == 0) {\n          // progn\n          struct ExpressionList *exprs = expressions->next;\n          struct Object *operand = NULL;\n          while (exprs != NULL) {\n            operand = allocate(context, env);\n            evaluateExpression(exprs->expression, operand, env, context);\n            exprs = exprs->next;\n          }\n          if (operand != NULL) {\n            *evaluated = *operand;\n          } else {\n            evaluated->type = OBJ_NIL;\n          }\n        } else if (strcmp(expr->data.symbol->symbol_name,\n                          \"remove-whitespaces\") == 0) {\n          // remove-whitespaces\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionRemoveWhitespaces(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"pop\") == 0) {\n          // pop\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionPop(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"push\") == 0) {\n          // push\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->expression, operand2, env,\n                             context);\n          definedFunctionPush(operand2, operand1, evaluated, env, context);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"length\") == 0) {\n          // length\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionLength(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"is-int-string\") ==\n                   0) {\n          // is-int-string\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionIsIntString(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"parse-int\") == 0) {\n          // parse-int\n          struct Object *operand = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand, env,\n                             context);\n          definedFunctionParseInt(operand, evaluated);\n        } else if (strcmp(expr->data.symbol->symbol_name, \"string-ref\") == 0) {\n          // string-ref\n          struct Object *operand1 = allocate(context, env);\n          struct Object *operand2 = allocate(context, env);\n          evaluateExpression(expressions->next->expression, operand1, env,\n                             context);\n          evaluateExpression(expressions->next->next->expression, operand2, env,\n                              context);\n          definedFunctionStringRef(operand1, operand2, evaluated);\n        } else {\n          // function call\n          int i = 0;\n          struct Env *current_env = env;\n          struct Env *looked_up_env = current_env;\n          while (looked_up_env->bindings[i].symbol_name != NULL) {\n            if (strcmp(looked_up_env->bindings[i].symbol_name,\n                       expr->data.symbol->symbol_name) == 0) {\n              struct Function *function =\n                  looked_up_env->bindings[i].value->function_value;\n              struct Env *new_env = malloc(sizeof(struct Env));\n              new_env->parent = current_env;\n              int j = 0;\n              struct ExpressionList *param_expr = expressions->next;\n              while (function->param_symbol_names[j] != NULL) {\n                struct Object *param = allocate(context, env);\n                evaluateExpression(param_expr->expression, param, current_env,\n                                   context);\n                param_expr = param_expr->next;\n                setObjectToEnv(new_env, function->param_symbol_names[j], param);\n                j++;\n              }\n              evaluateExpression(function->body, evaluated, new_env, context);\n              return;\n            }\n            i++;\n            // look up the parent env if not found\n            if (env->bindings[i].symbol_name == NULL) {\n              looked_up_env = looked_up_env->parent;\n              i = 0;\n            }\n          }\n          printf(\"Undefined function: %s\\n\", expr->data.symbol->symbol_name);\n          exit(1);\n        }\n      }\n    } else {\n      printf(\"S-exp must be started with symbol.\\n\");\n      exit(1);\n    }\n  } else {\n    evaluated->type = OBJ_NIL;\n  }\n}\n\nvoid evaluateLiteralExpression(struct ExpressionNode *expression,\n                               struct Object *evaluated) {\n  if (expression->data.literal->type == LIT_INTERGER) {\n    evaluated->type = OBJ_INTEGER;\n    evaluated->int_value = expression->data.literal->int_value;\n  } else if (expression->data.literal->type == LIT_STRING) {\n    evaluated->type = OBJ_STRING;\n    evaluated->string_value = expression->data.literal->string_value;\n  } else if (expression->data.literal->type == LIT_BOOLEAN) {\n    evaluated->type = OBJ_BOOL;\n    evaluated->bool_value = expression->data.literal->boolean_value;\n  }\n}\n\nvoid evaluateSymbolExpression(struct ExpressionNode *expression,\n                              struct Object *evaluated, struct Env *env,\n                              struct AllocatorContext *context) {\n  if (strcmp(expression->data.symbol->symbol_name, \"nil\") == 0) {\n    evaluated->type = OBJ_NIL;\n  } else {\n    // get symbol value from env\n    int i = 0;\n    while (env->bindings[i].symbol_name != NULL) {\n      if (strcmp(env->bindings[i].symbol_name,\n                 expression->data.symbol->symbol_name) == 0) {\n        *evaluated = *env->bindings[i].value;\n        env->bindings[i].value = evaluated;\n        return;\n      }\n      i++;\n    }\n    if (env->parent != NULL) {\n      evaluateSymbolExpression(expression, evaluated, env->parent, context);\n    } else {\n      printf(\"Undefined symbol: %s\\n\", expression->data.symbol->symbol_name);\n      exit(1);\n    }\n  }\n}\n\nvoid evaluateExpression(struct ExpressionNode *expression,\n                        struct Object *evaluated, struct Env *env,\n                        struct AllocatorContext *context) {\n  pushObjectStack(context->stack, evaluated);\n  if (expression->type == EXP_LIST) {\n    evaluateListExpression(expression, evaluated, env, context);\n  } else if (expression->type == EXP_SYMBOLIC_EXP) {\n    evaluateSymbolicExpression(expression, evaluated, env, context);\n  } else if (expression->type == EXP_LITERAL) {\n    evaluateLiteralExpression(expression, evaluated);\n  } else if (expression->type == EXP_SYMBOL) {\n    evaluateSymbolExpression(expression, evaluated, env, context);\n  }\n  popObjectStack(context->stack);\n}\n\nvoid evaluateExpressionWithContext(struct ExpressionNode *expression,\n                                   struct Object *evaluated, struct Env *env) {\n  struct AllocatorContext *context = initAllocator();\n  evaluateExpression(expression, evaluated, env, context);\n}\n\nvoid initEnv(struct Env *env) {\n  env->parent = NULL;\n  env->bindings[0].symbol_name = NULL;\n  env->bindings[0].value = NULL;\n}\n\nvoid evaluateProgram(struct ProgramNode *program) {\n  struct ExpressionList *expressions = program->expressions;\n\n  struct Env *env = malloc(sizeof(struct Env));\n  initEnv(env);\n\n  struct AllocatorContext *context = initAllocator();\n\n  while (expressions != NULL) {\n    struct Object *evaluated = allocate(context, env);\n    evaluateExpression(expressions->expression, evaluated, env, context);\n    expressions = expressions->next;\n  }\n}\n\nvoid evaluate(struct ParseResult *result) { evaluateProgram(result->program); }\n","numLines":1561,"startLine":1,"totalLines":1561}}}
