t\tif (*s == '%')\n46\t\t\t{\n47\t\t\t\tif (format(&args, *++s, &len) == -1)\n48\t\t\t\t\treturn (va_end(args), -1);\n49\t\t\t}\n50\t\t\telse if (writechar(*s, &len) == -1)\n51\t\t\t\treturn (va_end(args), -1);\n52\t\t\ts++;\n53\t\t}\n54\t\treturn (va_end(args), len);\n55\t}\n56\tint\twriteint(int n, int *len)\n57\t{\n58\t\tchar\tarr[10];\n59\t\tint\t\ti;\n60\t\n61\t\ti = 0;\n62\t\tif (!n)\n63\t\t\treturn (writechar('0', len));\n64\t\tif (n == -2147483648)\n65\t\t\treturn (writestring(\"-2147483648\", len));\n66\t\tif (n < 0)\n67\t\t{\n68\t\t\tif (writechar('-', len) == -1)\n69\t\t\t\treturn (-1);\n70\t\t\tn = -n;\n71\t\t}\n72\t\twhile (n)\n73\t\t{\n74\t\t\tarr[i++] = DECIMAL[n % 10];\n75\t\t\tn /= 10;\n76\t\t}\n77\t\twhile (i--)\n78\t\t\tif (writechar(arr[i], len) == -1)\n79\t\t\t\treturn (-1);\n80\t\treturn (1);\n81\t}\n82\t\n83\tint\twriteuint(unsigned long n, int *len)\n84\t{\n85\t\tint\t\tarr[16];\n86\t\tint\t\ti;\n87\t\n88\t\ti = 0;\n89\t\tif (!n)\n90\t\t\treturn (writechar('0', len));\n91\t\twhile (n)\n92\t\t{\n93\t\t\tarr[i++] = DECIMAL[n % 10];\n94\t\t\tn /= 10;\n95\t\t}\n96\t\twhile (i--)\n97\t\t\tif (writechar(arr[i], len) == -1)\n98\t\t\t\treturn (-1);\n99\t\treturn (1);\n100\t}\n101\t\n102\tint\twritehex(unsigned long n, char c, int *len)\n103\t{\n104\t\tchar\tarr[16];\n105\t\tint\t\ti;\n106\t\tchar\t*hex;\n107\t\n108\t\ti = 0;\n109\t\tif (!n)\n110\t\t\tarr[i++] = '0';\n111\t\tif (c == 'x')\n112\t\t\thex = HEXALOW;\n113\t\telse\n114\t\t\thex = HEXAUP;\n115\t\twhile (n)\n116\t\t{\n117\t\t\tarr[i++] = hex[n % 16];\n118\t\t\tn /= 16;\n119\t\t}\n120\t\twhile (i--)\n121\t\t\tif (writechar(arr[i], len) == -1)\n122\t\t\t\treturn (-1);\n123\t\treturn (1);\n124\t}\n125\t\n126\tint\twritepoint(void *ptr, int *len)\n127\t{\n128\t\tchar\t\t\t\tarr[32];\n129\t\tint\t\t\t\t\ti;\n130\t\tunsigned long long\tnb;\n131\t\n132\t\tif (LOCATION == 2 && !ptr)\n133\t\t\treturn (writestring(\"(nil)\", len));\n134\t\ti = 0;\n135\t\tnb = (unsigned long long)ptr;\n136\t\tif (write