ft(plhs: &mut ExprNode, constant_folding: i32){\n    unimplemented!();\n}\npub fn mapper_expr_new_from_string(s: &str, \n                                input_is_float: i32,\n                                output_is_float: i32,\n                                vector_size: i32)-> MapperExpr{\n    unimplemented!();\n}\npub fn mapper_expr_evaluate<'a>(mapper: &mut MapperExpr, \n                         input: &'a MapperSignalValue) -> MapperSignalValue{\n    unimplemented!();\n}","structuredPatch":[{"oldStart":38,"oldLines":13,"newStart":38,"newLines":13,"lines":["     };"," }"," fn minf(x: f32, y: f32) -> f32 {","-    unimplemented!();","+    if y < x { y } else { x }"," }"," fn maxf(x: f32, y: f32) -> f32 {","-    unimplemented!();","+    if y > x { y } else { x }"," }"," fn pif() -> f32 {","-    unimplemented!();","+    PI"," }"," #[repr(i32)]"," #[derive(Debug, Clone, Copy, PartialEq, Eq)]"]}],"userModified":false,"replaceAll":false}}
