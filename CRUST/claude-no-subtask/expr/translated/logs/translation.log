,\n                output_history: vec![MapperSignalValue::I32(0)],\n            };\n        }\n        // Final coercion\n        let last_is_float = nodes.last().map(|n| n.is_float).unwrap_or(0);\n        if last_is_float != 0 && output_is_float == 0 {\n            nodes.push(RawNode {\n                tok: RawToken::ToInt32,\n                is_float: 0,\n                history_index: 0,\n                vector_index: 0,\n            });\n        } else if last_is_float == 0 && output_is_float != 0 {\n            nodes.push(RawNode {\n                tok: RawToken::ToFloat,\n                is_float: 1,\n                history_index: 0,\n                vector_index: 0,\n            });\n        }\n\n        // Vector size > 1 check: error if any vector_index > 0 on a Var\n        if vector_size > 1 {\n            for n in &nodes {\n                if let RawToken::Var(_) = n.tok {\n                    if n.vector_index > 0 {\n                        return MapperExpr {\n                            node: ExprNode::new(),\n                            vector_size: 1,\n                            history_size: 1,\n                            history_pos: -1,\n                            input_history: vec![MapperSignalValue::I32(0)],\n                            output_history: vec![MapperSignalValue::I32(0)],\n                        };\n                    }\n                }\n            }\n        }\n\n        let history_size = ((-oldest_samps).ceil() as i32) + 1;\n        let history_size = if history_size < 1 { 1 } else { history_size };\n\n        let chain = build_chain_from_raw_v2(nodes);\n        let input_history_len = (vector_size * history_size) as usize;\n        let output_history_len = history_size as usize;\n\n        return MapperExpr {\n            node: chain,\n            vector_size,\n            history_size,\n            history_pos: -1,\n            input_history: vec![MapperSignalValue::I32(0); input_history_len],\n            output_history: vec![MapperSignalValue::I32(0); output_history_len],\n        };\n    }\n\n    // Failure - return a default expression\n    if let Some(msg) = error_message {\n        println!(\"{}\", msg);\n    }\n    MapperExpr {\n        node: ExprNode::new(),\n        vector_size: 1,\n        history_size: 1,\n        history_pos: -1,\n        input_history: vec![MapperSignalValue::I32(0)],\n        output_history: vec![MapperSignalValue::I32(0)],\n    }\n}\n\nenum StackItem {\n    State(StateE),\n    Node(Vec<RawNode>),\n}\n\nfn append_op_to_top_node(stack: &mut Vec<StackItem>, op: char) {\n    if let Some(StackItem::Node(nodes)) = stack.last_mut() {\n        let last_is_float = nodes.last().map(|n| n.is_float).unwrap_or(0);\n        nodes.push(RawNode {\n            tok: RawToken::Op(op),\n            is_float: last_is_float,\n            history_index: 0,\n            vector_index: 0,\n        });\n    }\n}\n\npub fn mapper_expr_evaluate<'a>(\n    mapper: &mut MapperExpr,\n    input: &'a MapperSignalValue,\n) -> MapperSignalValue {\n    evaluate_internal(mapper, Some(input))\n}\n","structuredPatch":[{"oldStart":627,"oldLines":31,"newStart":627,"newLines":10,"lines":["     FUNCTION_TABLE.get(FUNC_NAMES[idx as usize])"," }"," ","-fn build_chain_from_raw(raw: Vec<RawNode>) -> ExprNode {","+fn build_chain_from_raw(mut raw: Vec<RawNode>) -> ExprNode {","     if raw.is_empty() {","         return ExprNode::new();","     }","-    let mut iter = raw.into_iter().rev();","-    let mut tail: Option<Arc<ExprNode>> = None;","-    let mut head_node: Option<ExprNode> = None;","-    let mut nodes: Vec<RawNode> = Vec::new();","-    // Re-collect to avoid double iteration. Actually let's reverse build differently.","-    // Restart approach.","-    let _ = iter.next();","-    drop(iter);","-","-    // Re-do: just iterate from end to start, building Arc chain","-    // (We've consumed one item from iter, so let's start over with a fresh approach)","-    head_node = None;","-    let _ =