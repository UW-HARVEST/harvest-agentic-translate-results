*opt)--;\n            // error\n            fprintf(stderr, \"unknown option: `%s'\\n\", opt);\n            usage();\n            return 1;\n        }\n      }\n    }\n  } while (0);\n\n  if (NULL == seed) {\n    seed = \"0\";\n  }\n\n  if (1 == isatty(0)) { return 1; }\n  else if (ferror(stdin)) { return 1; }\n  else {\n    buf = read_stdin();\n    if (NULL == buf) { return 1; }\n    else if (0 == strlen(buf)) { buf = \"\"; }\n    h = hash(buf);\n    printf(\"%\" PRIu32 \"\\n\", h);\n    do {\n      key = read_stdin();\n      if (NULL == key) { break; }\n      else if (0 == strlen(buf)) { buf = \"\"; }\n      h = hash(buf);\n      printf(\"%d\" PRIu32 \"\\n\", h);\n    } while (NULL != key);\n  }\n\n  return 0;\n}\n","numLines":134,"startLine":1,"totalLines":134}}}
