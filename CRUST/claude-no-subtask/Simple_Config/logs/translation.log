{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01BXKHwY6FgAnast8Y1U17Pt","type":"tool_result","content":"1\t#include <assert.h>\n2\t#include <stdio.h>\n3\t#include <string.h>\n4\t\n5\t#include \"../config.h\"\n6\t#include \"test_print.h\"\n7\t\n8\tTestResult\n9\trun_test(const char *expected, void *arg, bool is_error)\n10\t{\n11\t    char buffer[256];\n12\t    FILE *stream = fmemopen(buffer, sizeof(buffer), \"w\");\n13\t    if (stream == NULL)\n14\t        return ABORT;\n15\t\n16\t    if (!is_error)\n17\t        cfg_fprint(stream, (Cfg *) arg);\n18\t    else\n19\t        cfg_fprint_error(stream, (CfgError *) arg);\n20\t\n21\t    fclose(stream);\n22\t\n23\t    ASSERT(0 == strncmp(expected, buffer, strlen(expected)));\n24\t    return OK;\n25\t}\n26\t\n27\tTestResult\n28\trun_print_test()\n29\t{\n30\t    CfgError err;\n31\t    CfgEntry entries[TEST_CAPACITY];\n32\t    Cfg cfg = {.entries = entries, .capacity = TEST_CAPACITY};\n33\t\n34\t    static const char expected[] = \"font: \\\"JetBrainsMono Nerd Font\\\"\\n\"\n35\t                                   \"font.size: 14\\n\"\n36\t                                   \"zoom: 1.500000\\n\"\n37\t                                   \"line_numbers: true\\n\"\n38\t                                   \"ruler: false\\n\"\n39\t                                   \"bg.color: rgba(255, 255, 255, 255)\";\n40\t\n41\t    static const char src[] = \"font: \\\"JetBrainsMono Nerd Font\\\"\\n\"\n42\t                              \"font.size: 14\\n\"\n43\t                              \"zoom: 1.5\\n\"\n44\t                              \"line_numbers: true\\n\"\n45\t                              \"ruler: false\\n\"\n46\t                              \"bg.color: rgba(255, 255, 255, 1)\";\n47\t\n48\t    int res = cfg_parse(src, strlen(src), &cfg, &err);\n49\t    if (res != 0)\n50\t        return ABORT;\n51\t\n52\t    return run_test(expected, &cfg, false);\n53\t}\n54\t\n55\tTestResult\n56\trun_error_test_1()\n57\t