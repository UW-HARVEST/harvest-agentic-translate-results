_entries =\n184\t            (CfgEntry[]){\n185\t                {.key = \"key\", .type = CFG_TYPE_FLOAT, .val.floating = 1.0},\n186\t            },\n187\t        .expected_count = 1,\n188\t    },\n189\t    {\n190\t        .type = TC_ERR,\n191\t        .line = __LINE__,\n192\t        .src = \"!\",\n193\t        .capacity = TEST_CAPACITY,\n194\t        .expected_error = \"missing key\",\n195\t    },\n196\t    {\n197\t        .type = TC_ERR,\n198\t        .line = __LINE__,\n199\t        // The key must be longer than CFG_MAX_KEY\n200\t        .src = \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\n201\t        .capacity = TEST_CAPACITY,\n202\t        .expected_error = \"key too long\",\n203\t    },\n204\t    {\n205\t        .type = TC_ERR,\n206\t        .line = __LINE__,\n207\t        .src = \"key\",\n208\t        .capacity = TEST_CAPACITY,\n209\t        .expected_error = \"':' expected\",\n210\t    },\n211\t    {\n212\t        .type = TC_ERR,\n213\t        .line = __LINE__,\n214\t        .src = \"key!\",\n215\t        .capacity = TEST_CAPACITY,\n216\t        .expected_error = \"':' expected\",\n217\t    },\n218\t    {\n219\t        .type = TC_ERR,\n220\t        .line = __LINE__,\n221\t        .src = \"key  :\",\n222\t        .capacity = TEST_CAPACITY,\n223\t        .expected_error = \"missing value\",\n224\t    },\n225\t    {\n226\t        .type = TC_ERR,\n227\t        .line = __LINE__,\n228\t        .src = \"key:\",\n229\t        .capacity = TEST_CAPACITY,\n230\t        .expected_error = \"missing value\",\n231\t    },\n232\t    {\n233\t        .type = TC_ERR,\n234\t        .line = __LINE__,\n235\t        .src = \"key:  \",\n236\t        .capacity = TEST_CAPACITY,\n237\t        .expected_error = \"missing value\",\n238\t    },\n239\t    {\n240\t        .type = TC_ERR,\n241\t        .line = __LINE__,\n242\t        .src = \"key:\\n\",\n243\t        .capacity = TEST_CAPACITY,\n244\t        .expected_error = \"missing value\",\n245\t    },\n246\t    {\n247\t        .type = TC_ER