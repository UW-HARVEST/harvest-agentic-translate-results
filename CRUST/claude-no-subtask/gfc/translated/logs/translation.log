{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012jX9dqzjMWDnQHCKQ1npPY","type":"tool_result","content":"1\t#include <gfc/gfc.h>\n2\t#include <math.h>\n3\t#include <stdlib.h>\n4\t\n5\t// The speck code is a cut down version of https://github.com/madmo/speck,\n6\t// licensed under the ISC license.\n7\t#define SPECK_TYPE uint32_t\n8\t#define SPECK_ROUNDS 27\n9\t#define SPECK_KEY_LEN 4\n10\t\n11\t#define ROR(x, r) ((x >> r) | (x << ((sizeof(SPECK_TYPE) * 8) - r)))\n12\t#define ROL(x, r) ((x << r) | (x >> ((sizeof(SPECK_TYPE) * 8) - r)))\n13\t#define R(x, y, k) (x = ROR(x, 8), x += y, x ^= k, y = ROL(y, 3), y ^= x)\n14\t\n15\tvoid speck_expand(SPECK_TYPE const K[SPECK_KEY_LEN],\n16\t                  SPECK_TYPE S[SPECK_ROUNDS]) {\n17\t  SPECK_TYPE i, b = K[0];\n18\t  SPECK_TYPE a[SPECK_KEY_LEN - 1];\n19\t\n20\t  for (i = 0; i < (SPECK_KEY_LEN - 1); i++) {\n21\t    a[i] = K[i + 1];\n22\t  }\n23\t  S[0] = b;\n24\t  for (i = 0; i < SPECK_ROUNDS - 1; i++) {\n25\t    R(a[i % (SPECK_KEY_LEN - 1)], b, i);\n26\t    S[i + 1] = b;\n27\t  }\n28\t}\n29\t\n30\tvoid speck_encrypt(SPECK_TYPE const pt[2], SPECK_TYPE ct[2],\n31\t                   SPECK_TYPE const K[SPECK_ROUNDS]) {\n32\t  SPECK_TYPE i;\n33\t  ct[0] = pt[0];\n34\t  ct[1] = pt[1];\n35\t\n36\t  for (i = 0; i < SPECK_ROUNDS; i++) {\n37\t    R(ct[1], ct[0], K[i]);\n38\t  }\n39\t}\n40\t\n41\t// Function Fe and fe are from the Figure 3 of\n42\t// https://www.cs.ucdavis.edu/~rogaway/papers/subset.pdf\n43\t// For the random function F we use speck\n44\t// with a block size of 64 bits and a key size of 128 bits.\n45\t\n46\t// This is the random function F_j(R) in the paper.\n47\tuint64_t F(const GFC *gfc, const uint64_t j, const uint64_t R) {\n48\t  uint64_t enc;\n49\t  const uint32_t *key = gfc->speck_exp + (j - 1) * SPECK_ROUNDS;\n50\t  speck_encrypt((const uint32_t *)&R, (uint32_t *)&enc, key);\n51\t  return enc;\n52\t}\n53\t\n54\t// This is the function fe[r,a,b]_K(m) in the paper.\n55\tuint64_t fe(const GFC *gfc, const uint64_t m) {\n56\t  uint64_t L, R, tmp;\n57\t\n58\t  L = m % gfc->a;\n59\t  R = m / gfc->a;\n60\t\n61\t  for (uint64_t j = 1; j <= gfc->r; j++) {\n62\t    // j & 1 is true if j is odd\n63\t    if (j & 1) {\n64\t      tmp = (L + F(gfc, j, R)) % gfc->a;\n65\t    } else {\n66\t      tmp = (L + F(gfc, j, R)) % gfc->b;\n67\t    }\n68\t    L = R;\n69\t    R = tmp;\n70\t  }\n71\t\n72\t  if (gfc->r & 1) {\n73\t    return gfc->a * L + R;\n74\t  } else {\n75\t    return gfc->a * R + L;\n76\t  }\n77\t}\n78\t\n79\t// This is the function fe^-1[r,a,b]_K(m) in the paper.\n80\tuint64_t fe_inv(const GFC *gfc, const uint64_t m) {\n81\t  uint64_t L, R, tmp;\n82\t\n83\t  if (gfc->r & 1) {\n84\t    R = m % gfc->a;\n85\t    L = m / gfc->a;\n86\t  } else {\n87\t    L = m % gfc->a;\n88\t    R = m / gfc->a;\n89\t  }\n90\t\n91\t  for (uint64_t j = gfc->r; j >= 1; j--) {\n92\t    if (j & 1) {\n93\t      // We apply the same trick as the following impl. to prevent underflows:\n94\t      // https://github.com/urbit/urbit-ob/blob/master/src/internal/ob.js#L152-L157\n95\t      tmp = (R + gfc->a - (F(gfc, j, L) % gfc->a)) % gfc->a;\n96\t      // tmp = (R - tmp) % gfc->a;\n97\t    } else {\n98\t      tmp = (R + gfc->b - (F(gfc, j, L) % gfc->b)) % gfc->b;\n99\t      // tmp = (R - tmp) % gfc->b;\n100\t    }\n101\t    R = L;\n102\t    L = tmp;\n103\t  }\n104\t\n105\t  return gfc->a * R + L;\n106\t}\n107\t\n108\tGFC *gfc_init(uint64_t range, uint64_t rounds, uint64_t seed) {\n109\t  GFC *gfc = calloc(1, sizeof(GFC));\n110\t  if (gfc == NULL) {\n111\t    return NULL;\n112\t  }\n113\t  gfc->M = range;\n114\t  gfc->r = rounds;\n115\t  // Compute the constants a and b such that ab >= range,\n116\t  // according to the method of Section 6.\n117\t  const double tmp = ceil(sqrt((double)range));\n118\t  gfc->a = (uint64_t)tmp;\n119\t  gfc->b = (uint64_t)tmp;\n120\t  // Precompute the speck round keys\n121\t  gfc->speck_exp = calloc(gfc->r * SPECK_ROUNDS, sizeof(uint32_t));\n122\t  