an array of doubles (a point) of the polygon.\n61\t   *\n62\t   * Use `satc_polygon_set_offset` to change this. Or, if you need to do it\n63\t   * manually, call `_satc_polygon_recalc` afterward.\n64\t   */\n65\t  double *offset;\n66\t  /**\n67\t   * The number of calculated points for the polygon. This will match the\n68\t   * number of points.\n69\t   *\n70\t   * This should not be modified manually.\n71\t   */\n72\t  size_t num_calc_points;\n73\t  /**\n74\t   * An array of arrays of doubles (array of points) representing the\n75\t   * calculated points of the polygon. This will match the number of points.\n76\t   *\n77\t   * This should not be modified manually.\n78\t   */\n79\t  double **calc_points;\n80\t  /**\n81\t   * The number of calculated edges for the polygon. This will match the\n82\t   * number of points.\n83\t   *\n84\t   * This should not be modified manually.\n85\t   */\n86\t  size_t num_edges;\n87\t  /**\n88\t   * An array of arrays of doubles (array of points) representing the\n89\t   * calculated edges of the polygon. This will match the number of points.\n90\t   *\n91\t   * This should not be modified manually.\n92\t   */\n93\t  double **edges;\n94\t  /**\n95\t   * The number of calculated normals for the polygon. This will match the\n96\t   * number of points.\n97\t   *\n98\t   * This should not be modified manually.\n99\t   */\n100\t  size_t num_normals;\n101\t  /**\n102\t   * An array of arrays of doubles (array of points) representing the\n103\t   * calculated normals of the polygon. This will match the number of points.\n104\t   *\n105\t   * This should not be modified manually.\n106\t   */\n107\t  double **normals;\n108\t};\n109\t\n110\t/** A box shape, with a position, width, and height. */\n111\tstruct satc_box {\n112\t  /** The shape type of the struct. */\n113\t  int type;\n114\t  /** The position of the box. */\n115\t  double *pos;\n116\t  /** The width of the box. */\n117\t  double w;\n118\t  /** The height of the box. */\n119\t  dou