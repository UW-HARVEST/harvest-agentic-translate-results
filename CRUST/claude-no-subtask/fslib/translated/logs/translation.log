ht;\n                self.add_arc(src, dst, il, ol, w);\n            }\n        }\n\n        // Add the epsilon arc from a's start to b's start.\n        self.add_arc(old_start_a, other.start + offset, EPS, EPS, sr.one);\n        Fst::new()\n    }"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1113,"cache_read_input_tokens":170606,"cache_creation":{"ephemeral_5m_input_tokens":1113,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f1eb16a6-ea52-4f5a-896f-455e5e61b933","uuid":"3bc93d81-7e6e-4d20-8115-83864152eb1b"}
