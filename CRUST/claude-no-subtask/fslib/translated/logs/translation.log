tvoid hash_remove(struct _hash * hash) {\n61\t    for (size_t i = 0; i < hash->size; ++i) {\n62\t        empty_chain(hash->buckets[i].head); \n63\t    }\n64\t    free(hash->buckets);\n65\t    free(hash);\n66\t}\n67\t\n68\tvoid empty_chain(struct _bitem * bitem) {\n69\t    struct _bitem * t_bitem = NULL;\n70\t    while(bitem != NULL) {\n71\t        t_bitem = bitem;\n72\t        bitem = bitem->next;\n73\t        if (t_bitem->value) {\n74\t            free(t_bitem->key);\n75\t            free(t_bitem->value);\n76\t        }\n77\t        free(t_bitem);\n78\t    }\n79\t}\n80\t\n81\tvoid hash_add(  struct _hash * hash, \n82\t                void * key, \n83\t                void * value) \n84\t{\n85\t    size_t bnum = hash->hash_f(key) % hash->size;\n86\t    struct _bucket * bucket = &hash->buckets[bnum];\n87\t\n88\t    // check if we allready have that key and update it\n89\t    for (\n90\t                struct _bitem * bi = bucket->head; \n91\t                bi != NULL; \n92\t                bi = bi->next\n93\t    ) {\n94\t        if ( hash->cmp_f(key, bi->key) ) {\n95\t            memcpy(bi->key, key, hash->key_size);\n96\t            memcpy(bi->value, value, hash->item_size);\n97\t            return;\n98\t        }\n99\t    }\n100\t\n101\t    // otherwise\n102\t\n103\t    struct _bitem * bitem = malloc(sizeof(struct _bitem));\n104\t\n105\t    bitem->key = key;\n106\t    bitem->value = value;\n107\t    bitem->next = NULL;         // sentinel\n108\t\n109\t    bitem->key = malloc(hash->key_size);\n110\t    memcpy(bitem->key, key, hash->key_size);\n111\t\n112\t    bitem->value = malloc(hash->item_size);\n113\t    memcpy(bitem->value, value, hash->item_size);\n114\t\n115\t    if ( bucket->tail == NULL ) {\n116\t        bucket->tail = bucket->head = bitem;\n117\t    } else {\n118\t        bucket->tail->next = bitem;\n119\t        bucket->tail = bitem;\n120\t    }\n121\t\n122\t    // warning: could be a recusion while resizing\n123\t    ++hash->n_items;\n124\t    if ( ( ((