{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_013RmyoozZHSCmtBwxyQt7fg","type":"tool_result","content":"1\tuse fslib::fst::Fst;\n2\t#[test]\n3\tfn test_fst_read_write() {\n4\t    let filename = \"tests/test_io.t\";\n5\t    let mut fst = Fst::new();\n6\t    let state_a = fst.add_state();\n7\t    let state_b = fst.add_state();\n8\t    for i in 0..10 {\n9\t        fst.add_arc(state_a, state_b, i, i, i as f32);\n10\t    }\n11\t    fst.set_final(state_b, 1.0);\n12\t    fst.fwrite(filename).unwrap();\n13\t    fst.remove();\n14\t    let mut fst = Fst::new();\n15\t    fst.fread(filename).unwrap();\n16\t    let state = &fst.states[0];\n17\t    let mut count = 0;\n18\t    assert_eq!(fst.n_states, 2);\n19\t    assert_eq!(fst.states[0].final_state, false);\n20\t    assert_eq!(fst.states[1].final_state, true);\n21\t    assert_eq!(fst.states[1].weight, 1.0);\n22\t    for arc in &state.arcs {\n23\t        assert_eq!(arc.state, state_b);\n24\t        assert_eq!(arc.ilabel, count);\n25\t        assert_eq!(arc.olabel, count);\n26\t        assert_eq!(arc.weight, count as f32);\n27\t        count += 1;\n28\t    }\n29\t    assert_eq!(count, 10);\n30\t    fst.remove();\n31\t}\n32\t#[test]\n33\tfn test_fst_stress() {\n34\t    let mut fst = Fst::new();\n35\t    let sa = fst.add_state();\n36\t    let sb = fst.add_state();\n37\t    let arcs_size = 1000000;\n38\t    for i in 0..arcs_size {\n39\t        fst.add_arc(sa, sb, i, i, i as f32);\n40\t    }\n41\t    let state = &fst.states[sa as usize];\n42\t    let mut count = 0;\n43\t    assert_eq!(fst.n_states, 2);\n44\t    for arc in &state.arcs {\n45\t        assert_eq!(arc.state, sb);\n46\t        assert_eq!(arc.ilabel, count);\n47\t        assert_eq!(arc.olabel, count);\n48\t        assert_eq!(arc.weight, count as f32);\n49\t        count += 1;\n50\t    }\n51\t    assert_eq!(count, arcs_size);\n52\t    fst.remove();\n53\t}\n54\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"f1eb16a6-ea52-4f5a-896f-455e5