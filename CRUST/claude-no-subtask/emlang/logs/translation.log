        } else {","+                        self.print = false;","+                        let int_val = match &em_data.value {","+                            DataValue::Int(i) => *i,","+                            _ => 0,","+                        };","+                        let to_stdout = int_val == DATA_STDOUT as i64;","+                        let mut output = String::new();","+                        for i in self.print_from..self.stack.size {","+                            if i > self.print_from {","+                                output.push(' ');","+                            }","+                            output.push_str(&format!(\"{}\", self.stack.buf[i]));","+                        }","+                        output.push('\\n');","+                        if to_stdout {","+                            print!(\"{}\", output);","+                            std::io::stdout().flush().ok();","+                        } else {","+                            eprint!(\"{}\", output);","+                            std::io::stderr().flush().ok();","+                        }","+                        let pf = self.print_from;","+                        self.stack.shrink_to(pf);","+                    }","+                }","+                EmType::IfBegin => {","+                    let cond = match self.stack.pop() {","+                        Some(d) => d,","+                        None => return RuntimeResult { ex: 0, em: Err(RuntimeError::StackUnderflow) },","+                    };","+                    if cond.dtype != DataType::Int {","+                        return RuntimeResult { ex: 0, em: Err(RuntimeError::IncorrectType) };","+                    }","+                    let cv = match cond.value { DataValue::Int(i) => i, _ => 0 };","+                    if cv == 0 {","+                        self.ip = em_ref;","+                    }","+                }","+                EmType::IfEnd => {}","+                EmType::LoopBegin => {",