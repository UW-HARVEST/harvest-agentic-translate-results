                       dict_free_key( dict, key );\n574\t                        return true;\n575\t                    }\n576\t                    break;\n577\t                }\n578\t                case DICT_STR:\n579\t                {\n580\t                    if ( strcmp( curr->key, key ) == 0 )\n581\t                    {\n582\t                        dict_free_key( dict, key );\n583\t                        return true;\n584\t                    }\n585\t                    break;\n586\t                }\n587\t                default:\n588\t                {\n589\t                    fprintf( stderr, \"[ERRO]: illegal type.\\n\" );\n590\t                    exit(1);\n591\t                }\n592\t            }\n593\t        }\n594\t    }\n595\t\n596\t    // doesn't already appear in the list\n597\t    dict_free_key( dict, key );\n598\t    return false;\n599\t}\n600\t\n601\t\n602\tsize_t dict_len( const dict_t* restrict dict )\n603\t{\n604\t    size_t size = 0;\n605\t    for ( size_t i = 0; i < dict->mod; i++ )\n606\t    {\n607\t        size += dict->list[i].size;\n608\t    }\n609\t    return size;\n610\t}\n611\t\n612\t\n613\tconst void* dict_key( const dict_t* restrict dict, size_t* restrict size )\n614\t{\n615\t    *size = dict_len( dict );\n616\t\n617\t    if ( *size == 0 )\n618\t    {\n619\t        return NULL;\n620\t    }\n621\t\n622\t    char* arr = dict->alloc.malloc( dict->key.size * (*size) );\n623\t\n624\t    size_t index = 0;\n625\t    for ( size_t i = 0; i < dict->mod; i++ )\n626\t    {\n627\t        for ( dict_elem_t* curr = dict->list[i].head; curr != NULL; curr = curr->next )\n628\t        {\n629\t            memcpy( arr + ( dict->key.size * index ), curr->key, dict->key.size );\n630\t            if ( index++ == *size ) return arr;\n631\t        }\n632\t    }\n633\t\n634\t    return arr;\n635\t}\n636\t\n637\t\n638\tvoid* dict_serialize( const dict_t* restrict dict, size_t* restrict bytes )\n639\t{\n640\t    size_t space;\n641\t    if ( bytes == N