a_expr);\n224\tif let common::AstNodeUnion::LambdaExpr(lambda) = deepcopied.node {\n225\tassert_eq!(deepcopied.type_, AstNodeType::LAMBDA_EXPR);\n226\tassert_eq!(lambda.parameter, \"x\");\n227\tassert_eq!(lambda.type_, \"Nat\");\n228\tif let common::AstNodeUnion::Variable(var) = lambda.body.unwrap().node {\n229\tassert_eq!(var.name, \"x\");\n230\t} else {\n231\tpanic!(\"Expected variable node\");\n232\t}\n233\t} else {\n234\tpanic!(\"Expected lambda expression node\");\n235\t}\n236\t}\n237\t\n238\t#[test]\n239\tfn test_type_equal() {\n240\tlet a = typechecker::create_type(\"Nat\", \"\", &AstNode::default());\n241\tlet b = typechecker::create_type(\"Nat\", \"\", &AstNode::default());\n242\tlet c = typechecker::create_type(\"Bool\", \"\", &AstNode::default());\n243\tassert!(typechecker::type_equal(&a, &b));\n244\tassert!(!typechecker::type_equal(&a, &c));\n245\t}\n246\t\n247\t#[test]\n248\tfn test_get_type_from_expr() {\n249\tlet n = parser::create_variable(\"test\", \"Nat\");\n250\tlet n1 = parser::create_lambda(\"test\", &AstNode::default(), \"Bool\");\n251\tlet n_type = typechecker::get_type_from_expr(&n);\n252\tlet n1_type = typechecker::get_type_from_expr(&n1);\n253\tassert_eq!(n_type, \"Nat\");\n254\tassert_eq!(n1_type, \"Bool\");\n255\t}\n256\t\n257\t#[test]\n258\tfn test_expr_type_equal() {\n259\tlet n = parser::create_variable(\"test\", \"Nat\");\n260\tlet a = typechecker::create_type(\"Nat\", \"\", &n);\n261\tassert!(typechecker::expr_type_equal(&a, &n));\n262\t}\n263\t\n264\t#[test]\n265\tfn test_typecheck() {\n266\tlet lambda_body = parser::create_variable(\"x\", \"\");\n267\tlet y_var = parser::create_variable(\"y\", \"Nat\");\n268\tlet lambda_expr = parser::create_lambda(\"x\", &lambda_body, \"Nat\");\n269\tlet parsed = parser::create_application(&lambda_expr, &y_var);\n270\ttypechecker::typecheck(&parsed, None);\n271\t}\n272\t\n273\tfn main() {\n274\t    \n275\t}\n276\t"}]},"parent_tool_use_id":null,"session_id":"d2576a2c-784a-4a3a-a4c2-8c9f8eab1714","u