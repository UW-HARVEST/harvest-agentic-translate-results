{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KF2DY6GhcsypZNGi4oEuWX","type":"tool_result","content":"1\tuse lambda_calculus_eval::common;\n2\tuse lambda_calculus_eval::config;\n3\tuse lambda_calculus_eval::io;\n4\tuse lambda_calculus_eval::parser; \n5\tuse lambda_calculus_eval::reducer;\n6\tuse lambda_calculus_eval::typechecker;\n7\tuse lambda_calculus_eval::hash_table::HashTable;\n8\tuse lambda_calculus_eval::common::{AstNode, AstNodeType};\n9\tuse std::io::{Read, Seek, Write};\n10\t\n11\t\n12\t#[test]\n13\tfn test_trim() {\n14\tlet mut str_to_trim = String::from(\"  test  \");\n15\tconfig::trim(&mut str_to_trim);\n16\tassert_eq!(str_to_trim, \"test\");\n17\t}\n18\t\n19\t#[test]\n20\tfn test_get_config_type() {\n21\tlet file_opt = config::get_config_type(\"file\");\n22\tlet step_opt = config::get_config_type(\"step_by_step_reduction\");\n23\tlet reduction = config::get_config_type(\"reduction_order\");\n24\tassert_eq!(file_opt, config::option_type_t::FILENAME);\n25\tassert_eq!(step_opt, config::option_type_t::STEP_REDUCTION);\n26\tassert_eq!(reduction, config::option_type_t::REDUCTION_ORDER);\n27\t}\n28\t\n29\t#[test]\n30\tfn test_parse_config() {\n31\tlet line = \"file=expr.lambda\";\n32\tlet mut key = String::new();\n33\tlet mut value = String::new();\n34\tconfig::parse_config(line, &mut key, &mut value);\n35\tassert_eq!(key, \"file\");\n36\tassert_eq!(value, \"expr.lambda\");\n37\t}\n38\t\n39\tconst TEMP_PATH: &str = \"temp/test.txt\";\n40\t\n41\tfn ensure_temp_dir() {\n42\t    std::fs::create_dir_all(\"temp\").ok();\n43\t}\n44\t\n45\t#[test]\n46\tfn test_create_file() {\n47\tensure_temp_dir();\n48\tlet _ = io::create_file(TEMP_PATH).unwrap();\n49\tassert!(std::fs::metadata(TEMP_PATH).is_ok());\n50\tstd::fs::remove_file(TEMP_PATH).unwrap();\n51\t}\n52\t\n53\t#[test]\n54\tfn test_get_file() {\n55\tensure_temp_dir();\n56\tlet mut c = io::create_file(TEMP_PATH).unwrap();\n57\tlet mut d = io::get_file(TEMP_PATH, \"r+\").unwrap();\n58\tlet test_str = \"Hello\";\n59\twrite!(c, \"{}\", test_str).unwrap();\n60\tc.flush().unwrap();\n61\td.seek(std::io::SeekFrom::Start(0)).unwrap();\n62\tlet mut buffer = String::new();\n63\td.read_to_string(&mut buffer).unwrap();\n64\tassert_eq!(buffer, test_str);\n65\tio::delete_file(TEMP_PATH).unwrap();\n66\t}\n67\t\n68\t#[test]\n69\tfn test_file_deletion() {\n70\tensure_temp_dir();\n71\tlet _ = io::create_file(TEMP_PATH).unwrap();\n72\tassert!(std::fs::metadata(TEMP_PATH).is_ok());\n73\tio::delete_file(TEMP_PATH).unwrap();\n74\tassert!(std::fs::metadata(TEMP_PATH).is_err());\n75\t}\n76\t\n77\t#[test]\n78\tfn test_parse_token() {\n79\tassert_eq!(parser::parse_token('('), common::tokens_t::L_PAREN);\n80\tassert_eq!(parser::parse_token(')'), common::tokens_t::R_PAREN);\n81\tassert_eq!(parser::parse_token('@'), common::tokens_t::LAMBDA);\n82\tassert_eq!(parser::parse_token('.'), common::tokens_t::DOT);\n83\tassert_eq!(parser::parse_token('t'), common::tokens_t::VARIABLE);\n84\tassert_eq!(parser::parse_token(' '), common::tokens_t::WHITESPACE);\n85\tassert_eq!(parser::parse_token('\\n'), common::tokens_t::NEWLINE);\n86\tassert_eq!(parser::parse_token('='), common::tokens_t::EQ);\n87\tassert_eq!(parser::parse_token('\"'), common::tokens_t::QUOTE);\n88\tassert_eq!(parser::parse_token(':'), common::tokens_t::COLON);\n89\tassert_eq!(parser::parse_token('$'), common::tokens_t::ERROR);\n90\t}\n91\t\n92\t#[test]\n93\tfn test_is_variable() {\n94\tassert!(parser::is_variable('t'));\n95\tassert!(!parser::is_variable('*'));\n96\t}\n97\t\n98\t#[test]\n99\tfn test_create_variable() {\n100\tlet name = \"test\";\n101\tlet type_ = \"Nat\";\n102\tlet var = parser::create_variable(name, type_);\n103\tif let common::AstNodeUnion::Variable(variable) = var.node {\n104\tassert_eq!(var.type_, AstNodeType::VAR);\n105\tassert_eq!(variable.name, name);\n106\tassert_eq!(variable.type_, type_);\n107\t} else {\n108\tpanic!(\"Expected variable node\");\n109\t}\n110\t}\n111\t\n112\t#[test]\n113\tfn test_create_application() {\n114\tlet app = parser::create_application(&AstNode::default(), &AstNode::default());\n115\tif let common::AstNodeUnion::Application(application) = app.node {\n116\tassert_eq!(app.type_, AstNodeType::APPLICATION);\n117\tassert!(application.function.is_some());\n118\tassert!(application.argument.is_some());\n119\t} else {\n120\tpanic!(\"Expected application node\");\n121\t}\n122\t}\n123\t\n124\t#[test]\n125\tfn test_create_lambda() {\n126\tlet param = \"test\";\n127\tlet type_ = \"nat\";\n128\tlet lambda = parser::create_lambda(param, &AstNode::default(), type_);\n129\tif let common::AstNodeUnion::LambdaExpr(lambda_expr) = lambda.node {\n130\tassert_eq!(lambda.type_, AstNodeType::LAMBDA_EXPR);\n131\tassert_eq!(lambda_expr.parameter, param);\n132\tassert_eq!(lambda_expr.type_, type_);\n133\tassert!(lambda_expr.body.is_some());\n134\t} else {\n135\tpanic!(\"Expected lambda expression node\");\n136\t}\n137\t}\n138\t\n139\t#[test]\n140\tfn test_alpha_convert() {\n141\tlet old = \"x\";\n142\tlet old_two = \"y\";\n143\tlet expected = \"x_1\";\n144\tlet expected_two = \"y_2\";\n145\tlet new = parser::alpha_convert(old);\n146\tlet new_two = parser::alpha_convert(old_two);\n147\tassert_eq!(new, expected);\n148\tassert_eq!(new_two, expected_two);\n149\t}\n150\t\n151\t#[test]\n152\tfn test_is_used() {\n153\tlet mut table = HashTable::new();\n154\tlet key = \"test\";\n155\ttable.insert(key, AstNode::default());\n156\tassert!(parser::is_used(&table, key));\n157\tassert!(!parser::is_used(&table, \"wrong\"));\n158\t}\n159\t\n160\t#[test]\n161\tfn test_is_uppercase() {\n162\tassert!(parser::is_uppercase('A'));\n163\tassert!(!parser::is_uppercase('c'));\n164\t}\n165\t\n166\t#[test]\n167\tfn test_expand_definitions() {\n168\tlet mut table = HashTable::new();\n169\tlet mut variable = parser::create_variable(\"test\", \"\");\n170\tvariable.type_ = AstNodeType::DEFINITION;\n171\tlet definition = parser::create_variable(\"testing\", \"Nat\");\n172\ttable.inse