{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NEWnt4qTt53GRE67gZZJZz","type":"tool_result","content":"1\t#include \"hash_table.h\"\n2\t#include <stdio.h>\n3\t#include <stdlib.h>\n4\t#include <string.h>\n5\t\n6\tunsigned int hash(const char *key) {\n7\t  unsigned long hash = 5381;\n8\t  int c;\n9\t  while ((c = *key++))\n10\t    hash = ((hash << 5) + hash) + c;\n11\t  return hash % HASH_TABLE_SIZE;\n12\t}\n13\t\n14\tvoid insert(HashTable *hashTable, const char *key, struct AstNode *value) {\n15\t  unsigned int index = hash(key);\n16\t  HashNode *newNode = (HashNode *)malloc(sizeof(HashNode));\n17\t  newNode->key = strdup(key);\n18\t  newNode->value = value;\n19\t  newNode->next = NULL;\n20\t\n21\t  if (hashTable->table[index] == NULL) {\n22\t    hashTable->table[index] = newNode;\n23\t  } else {\n24\t    HashNode *current = hashTable->table[index];\n25\t    while (current->next != NULL)\n26\t      current = current->next;\n27\t    current->next = newNode;\n28\t  }\n29\t}\n30\t\n31\tbool table_exists(HashTable *hashTable, const char *key) {\n32\t  unsigned int index = hash(key);\n33\t  HashNode *node = hashTable->table[index];\n34\t  return node != NULL;\n35\t}\n36\t\n37\tAstNode *search(HashTable *hashTable, const char *key) {\n38\t  if (key == NULL) {\n39\t    return NULL;\n40\t  }\n41\t\n42\t  unsigned int index = hash(key);\n43\t  HashNode *current = hashTable->table[index];\n44\t\n45\t  while (current != NULL) {\n46\t    if (strcmp(current->key, key) == 0) {\n47\t      return current->value;\n48\t    }\n49\t    current = current->next;\n50\t  }\n51\t\n52\t  return NULL;\n53\t}\n54\t\n55\tvoid delete_c(HashTable *hashTable, const char *key) {\n56\t  unsigned int index = hash(key);\n57\t  HashNode *current = hashTable->table[index];\n58\t  HashNode *prev = NULL;\n59\t\n60\t  while (current != NULL) {\n61\t    if (strcmp(current->key, key) == 0) {\n62\t      if (prev == NULL)\n63\t        hashTable->table[index] = current->next;\n64\t      else\n65\t        prev->next = current->next;\n66\t      free(current->key);\n67\t      free(current);\n68\t      return;\n69\t    }\n70\t    prev = current;\n71\t    current = current->next;\n72\t  }\n73\t}\n74\t\n75\tHashTable *createHashTable() {\n76\t  HashTable *hashTable = (HashTable *)malloc(sizeof(HashTable));\n77\t  memset(hashTable->table, 0, sizeof(hashTable->table));\n78\t  return hashTable;\n79\t}\n80\t\n81\tvoid destroyHashTable(HashTable *hashTable) {\n82\t  for (int i = 0; i < HASH_TABLE_SIZE; i++) {\n83\t    HashNode *current = hashTable->table[i];\n84\t    while (current != NULL) {\n85\t      HashNode *temp = current;\n86\t      current = current->next;\n87\t      if (temp->value != NULL) {\n88\t        free(temp->value);\n89\t      }\n90\t      free(temp->key);\n91\t      free(temp);\n92\t    }\n93\t  }\n94\t  free(hashTable);\n95\t}\n96\t"}]},"parent_tool_use_id":null,"session_id":"d2576a2c-784a-4a3a-a4c2-8c9f8eab1714","uuid":"a49f8ec3-f227-4256-b39b-249038b37613","timestamp":"2026-06-06T01:38:37.720Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-CudCv4/project/c_src/hash-table/hash_table.c","content":"#include \"hash_table.h\"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nunsigned int hash(const char *key) {\n  unsigned long hash = 5381;\n  int c;\n  while ((c = *key++))\n    hash = ((hash << 5) + hash) + c;\n  return hash % HASH_TABLE_SIZE;\n}\n\nvoid insert(HashTable *hashTable, const char *key, struct AstNode *value) {\n  unsigned int index = hash(key);\n  HashNode *newNode = (HashNode *)malloc(sizeof(HashNode));\n  newNode->key = strdup(key);\n  newNode->value = value;\n  newNode->next = NULL;\n\n  if (hashTable->table[index] == NULL) {\n    hashTable->table[index] = newNode;\n  } else {\n    HashNode *current = hashTable->table[index];\n    while (current->next != NULL)\n      current = current->next;\n    current->next = newNode;\n  }\n}\n\nbool table_exists(HashTable *hashTable, const char *key) {\n  unsigned int index = hash(key);\n  HashNode *node = hashTable->table[index];\n  return node != NULL;\n}\n\nAstNode *search(HashTable *hashTable, const char *key) {\n  if (key == NULL) {\n    return NULL;\n  }\n\n  unsigned int index = hash(key);\n  HashNode *current = hashTable->table[index];\n\n  while (current != NULL) {\n    if (strcmp(current->key, key) == 0) {\n      return current->value;\n    }\n    current = current->next;\n  }\n\n  return NULL;\n}\n\nvoid delete_c(HashTable *hashTable, const char *key) {\n  unsigned int index = hash(key);\n  HashNode *current = hashTable->table[index];\n  HashNode *prev = NULL;\n\n  while (current != NULL) {\n    if (strcmp(current->key, key) == 0) {\n      if (prev == NULL)\n        hashTable->table[index] = current->next;\n      else\n        prev->next = current->next;\n      free(current->key);\n      free(current);\n      return;\n    }\n    prev = current;\n    current = current->next;\n  }\n}\n\nHashTable *createHashTable() {\n  HashTable *hashTable = (HashTable *)malloc(sizeof(HashTable));\n  memset(hashTable->table, 0, sizeof(hashTable->table));\n  return hashTable;\n}\n\nvoid destroyHashTable(HashTable *hashTable) {\n  for (int i = 0; i < HASH_TABLE_SIZE; i++) {\n    HashNode *current = hashTable->table[i];\n    while (current != NULL) {\n      HashNode *temp = current;\n      current = current->next;\n      if (temp->value != NULL) {\n        free(temp->value);\n      }\n      free(temp->key);\n      free(temp);\n    }\n  }\n  free(hashTable);\n}\n","numLines":96,"startLine":1,"totalLines":96}}}
