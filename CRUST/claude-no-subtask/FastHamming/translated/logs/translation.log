48\t}\n49\t\n50\t#[test]\n51\tfn test_error_single() {\n52\t    let mut data8_enc: [u8; 16] = [\n53\t        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4, 0x46, 0xd9,\n54\t    ];\n55\t    let original = &data8_enc[..15];\n56\t    \n57\t    for i in 0..(15 * 8) {\n58\t        let mut corrupted = data8_enc.clone();\n59\t        corrupted[i / 8] ^= 1 << (i % 8);\n60\t        let decoded = hecc_decode(&corrupted).expect(\"Decoding should still succeed\");\n61\t        assert_eq!(decoded, original);\n62\t    }\n63\t}\n64\t\n65\t#[test]\n66\tfn test_error_double() {\n67\t    let mut data8_enc: [u8; 16] = [\n68\t        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4, 0x46, 0xd9,\n69\t    ];\n70\t    data8_enc[0] ^= 3;\n71\t    assert!(hecc_decode(&data8_enc).is_none(), \"Decoding should fail for double-bit errors\");\n72\t}\n73\t\n74\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"8fcef550-b308-4a7e-8af4-d250021234e2","uuid":"d42492ed-8230-40f5-b147-9991500b2c74","timestamp":"2026-06-05T20:43:45.565Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-mtyJbY/project/src/bin/test_coding.rs","content":"use FastHamming::fast_hamming::{hecc_encode, hecc_decode};\n\n#[test]\nfn test_selftest() {\n    let data8: [u8; 15] = [\n        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4, 0x46,\n    ];\n    let data8_enc: [u8; 16] = [\n        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4, 0x46, 0xd9,\n    ];\n    assert_eq!(data8.len(), data8_enc.len() - 1);\n    assert_eq!(&data8, &data8_enc[..15]);\n}\n\n#[test]\nfn test_coding_encode() {\n    let data8: [u8; 15] = [\n        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4, 0x46,\n    ];\n    let data8_enc: [u8; 16] = [\n        0x0b, 0x28, 0x48, 0x69, 0x5e, 0xc8, 0xeb, 0x87, 0x7f, 0x28, 0xdf, 0x52, 0x03, 0xb4