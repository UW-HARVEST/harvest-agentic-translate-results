{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_tb2ftiaxoz2la7ezwduue6wsz6yqxs3zrqkfcbkmuynxzw7dr2zq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_016We8hF52bcLQUSrH1zmYRA","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-cUGuah/project/src/openhash.rs","content":"use std::collections::HashMap;\nuse std::sync::{Arc, RwLock};\nuse crate::log::{LogType, Logger};\nuse crate::check;\nuse crate::hash::{hash, rehash, compare_keys};\nconst LOAD_FACTOR: f32 = 0.6;\n#[cfg(debug_assertions)]\nconst EPS: f32 = 1e-3;\npub struct OpenEntry {\n    key: Option<&'static str>,\n    data: Option<&'static str>,\n}\npub struct OpenHashTable {\n    cur_size: usize,\n    max_size: usize,\n    arr: Vec<OpenEntry>,\n}\n\nfn allocate_arr(size: usize) -> Vec<OpenEntry> {\n    let mut v = Vec::with_capacity(size);\n    for _ in 0..size {\n        v.push(OpenEntry { key: None, data: None });\n    }\n    v\n}\n\nimpl OpenHashTable {\n    pub fn new(initial_size: usize) -> Arc<RwLock<Self>> {\n        assert!(initial_size != 0);\n        Arc::new(RwLock::new(OpenHashTable {\n            cur_size: 0,\n            max_size: initial_size,\n            arr: allocate_arr(initial_size),\n        }))\n    }\n    fn query(&self, key: &str) -> usize {\n        let mut h = hash(key);\n        loop {\n            let idx = (h as usize) % self.max_size;\n            let entry = &self.arr[idx];\n            match entry.key {\n                None => return idx,\n                Some(k) => {\n                    if compare_keys(k, unsafe { std::mem::transmute::<&str, &'static str>(key) }) == std::cmp::Ordering::Equal {\n                        return idx;\n                    }\n                }\n            }\n            h = rehash(h);\n        }\n    }\n    pub fn insert(&mut self, key: &'static str, data: &'static str) {\n        self.cur_size += 1;\n        if (self.cur_size as f32) / (self.max_size as f32) > LOAD_FACTOR {\n            let new_max = self.max_size * 2;\n            let old_arr = std::mem::replace(&mut self.arr, allocate_arr(new_max));\n            self.max_size = new_max;\n            for entry in old_arr.into_iter() {\n                if let (Some(k), Some(d)) = (entry.key, entry.data) {\n                    let idx = self.query(k);\n                    self.arr[idx].key = Some(k);\n                    self.arr[idx].data = Some(d);\n                }\n            }\n        }\n        let idx = self.query(key);\n        assert!(self.arr[idx].key.is_none());\n        self.arr[idx].key = Some(key);\n        self.arr[idx].data = Some(data);\n    }\n    pub fn find(&self, key: &str) -> Option<&'static str> {\n        let idx = self.query(key);\n        self.arr[idx].data\n    }\n    pub fn free_open_hash_table(&mut self) {\n        self.arr.clear();\n        self.cur_size = 0;\n        self.max_size = 0;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2528,"cache_read_input_tokens":32362,"cache_creation":{"ephemeral_5m_input_tokens":2528,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"08b75925-d870-4488-b1db-f600f370bc9a","uuid":"b3ab0b00-d47f-4401-bb7b-1150ad36191b"}
