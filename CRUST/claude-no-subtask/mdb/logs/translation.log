\t\n64\tbool check_seq(char *buffer, char value, size_t len) {\n65\t  for (size_t i = 0; i < len; i++) {\n66\t    if (buffer[i] != value) {\n67\t      return false;\n68\t    }\n69\t  }\n70\t  return true;\n71\t}\n72\t\n73\tvoid test1() {\n74\t  VK_TEST_SECTION_BEGIN(\"simple index write\");\n75\t\n76\t  mdb_int_t testdb = open_test_db(get_options_no_hash_buckets());\n77\t  mdb_ptr_t idxptr_arr[32];\n78\t  static char keys[32][TESTDB_KEY_SIZE_MAX];\n79\t  mdb_ptr_t valptr_arr[32];\n80\t  mdb_size_t valsize_arr[32];\n81\t\n82\t  for (size_t i = 0; i < 32; i++) {\n83\t    generate_seq_key(keys[i], i);\n84\t    valptr_arr[i] = rand();\n85\t    valsize_arr[i] = rand();\n86\t    mdb_status_t index_alloc_status = mdb_index_alloc(&testdb, idxptr_arr + i);\n87\t    mdb_status_t index_write_status = mdb_write_index(&testdb, idxptr_arr[i],\n88\t                                                      keys[i], valptr_arr[i],\n89\t                                                      valsize_arr[i]);\n90\t    VK_ASSERT_EQUALS(MDB_OK, index_alloc_status.code);\n91\t    VK_ASSERT_EQUALS(MDB_OK, index_write_status.code);\n92\t  }\n93\t\n94\t  for (size_t i = 0; i < 32; i++) {\n95\t    mdb_index_t *test_index =\n96\t        alloca(sizeof(mdb_index_t) + TESTDB_KEY_SIZE_MAX + 1);\n97\t    mdb_status_t index_read_status = mdb_read_index(&testdb, idxptr_arr[i],\n98\t                                                    test_index);\n99\t    VK_ASSERT_EQUALS(MDB_OK, index_read_status.code);\n100\t\n101\t    VK_ASSERT_EQUALS_S(keys[i], test_index->key);\n102\t    VK_ASSERT_EQUALS(valptr_arr[i], test_index->value_ptr);\n103\t    VK_ASSERT_EQUALS(valsize_arr[i], test_index->value_size);\n104\t  }\n105\t\n106\t  VK_TEST_SECTION_END(\"simple index write\");\n107\t}\n108\t\n109\tvoid test2() {\n110\t  VK_TEST_SECTION_BEGIN(\"simple data write\");\n111\t\n112\t  mdb_int_t testdb = open_test_db(get_options_no_hash_buckets());\n113\t\n114\t  mdb_ptr_t valptr_arr[32];\n115\t  mdb_size_t valsize_arr[32]