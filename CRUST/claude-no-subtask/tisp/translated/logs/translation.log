{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01JPDDYDhhxRoJ84Dno8CMpt","type":"tool_result","content":"1\t/* zlib License\n2\t *\n3\t * Copyright (c) 2017-2025 Ed van Bruggen\n4\t *\n5\t * This software is provided 'as-is', without any express or implied\n6\t * warranty.  In no event will the authors be held liable for any damages\n7\t * arising from the use of this software.\n8\t *\n9\t * Permission is granted to anyone to use this software for any purpose,\n10\t * including commercial applications, and to alter it and redistribute it\n11\t * freely, subject to the following restrictions:\n12\t *\n13\t * 1. The origin of this software must not be misrepresented; you must not\n14\t *    claim that you wrote the original software. If you use this software\n15\t *    in a product, an acknowledgment in the product documentation would be\n16\t *    appreciated but is not required.\n17\t * 2. Altered source versions must be plainly marked as such, and must not be\n18\t *    misrepresented as being the original software.\n19\t * 3. This notice may not be removed or altered from any source distribution.\n20\t */\n21\t#include <ctype.h>\n22\t#include <stdarg.h>\n23\t#include <stdint.h>\n24\t#include <stdio.h>\n25\t#include <stdlib.h>\n26\t#include <string.h>\n27\t\n28\t#include \"tisp.h\"\n29\t\n30\t#define car(P)  ((P)->v.p.car)\n31\t#define cdr(P)  ((P)->v.p.cdr)\n32\t#define caar(P) car(car(P))\n33\t#define cadr(P) car(cdr(P))\n34\t#define cdar(P) cdr(car(P))\n35\t#define cddr(P) cdr(cdr(P))\n36\t#define nilp(V) ((V)->t == TSP_NIL)\n37\t#define num(N) ((N)->v.n.num)\n38\t#define den(N) ((N)->v.n.den)\n39\t\n40\t#define BETWEEN(X, A, B)  ((A) <= (X) && (X) <= (B))\n41\t#define LEN(X)            (sizeof(X) / sizeof((X)[0]))\n42\t\n43\t/* functions */\n44\tstatic void rec_add(Rec rec, char *key, Val val);\n45\tstatic Val eval_proc(Tsp st, Rec env, Val f, Val args);\n46\t\n47\t/* utility functions */\n48\t\n49\t/* return named string for each type */\n50\t/* TODO loop through each type bit to print */\n51\tchar *\n52\ttsp_type_str(TspType t)\n53\t{\n54\t\tswitch (t) {\n55\t\tcase TSP_NONE:  return \"Void\";\n56\t\tcase TSP_NIL:   return \"Nil\";\n57\t\tcase TSP_INT:   return \"Int\";\n58\t\tcase TSP_DEC:   return \"Dec\";\n59\t\tcase TSP_RATIO: return \"Ratio\";\n60\t\tcase TSP_STR:   return \"Str\";\n61\t\tcase TSP_SYM:   return \"Sym\";\n62\t\tcase TSP_PRIM:  return \"Prim\";\n63\t\tcase TSP_FORM:  return \"Form\";\n64\t\tcase TSP_FUNC:  return \"Func\";\n65\t\tcase TSP_MACRO: return \"Macro\";\n66\t\tcase TSP_PAIR:  return \"Pair\";\n67\t\tcase TSP_REC:   return \"Rec\";\n68\t\tdefault:\n69\t\t\tif (t == TSP_EXPR)\n70\t\t\t\treturn \"Expr\";\n71\t\t\tif (t == TSP_RATIONAL)\n72\t\t\t\treturn \"Rational\";\n73\t\t\tif (t & TSP_NUM)\n74\t\t\t\treturn \"Num\";\n75\t\t\treturn \"Invalid\";\n76\t\t}\n77\t}\n78\t\n79\t/* check if character can be a part of a symbol */\n80\tstatic int\n81\tis_sym(char c)\n82\t{\n83\t\t/* TODO expand for all UTF: if c > 255 */\n84\t\treturn BETWEEN(c, 'a', 'z') || BETWEEN(c, 'A', 'Z') ||\n85\t\t       BETWEEN(c, '0', '9') || strchr(TSP_SYM_CHARS, c);\n86\t}\n87\t\n88\t/* check if character can be a part of an operator */\n89\tstatic int\n90\tis_op(char c)\n91\t{\n92\t\treturn strchr(TSP_OP_CHARS, c) != NULL;\n93\t}\n94\t\n95\t/* check if character is start of a number */\n96\t/* TODO only if -/+ is not followed by a delim */\n97\t/* TODO use XOR '0' < 10 */\n98\tstatic int\n99\tisnum(char *str)\n100\t{\n101\t\treturn isdigit(*str) || (*str == '.' &&  isdigit(str[1])) ||\n102\t\t       ((*str == '-' || *str == '+') && (isdigit(str[1]) || str[1] == '.'));\n103\t}\n104\t\n105\t/* skip over comments and white space */\n106\t/* TODO support mac/windows line endings */\n107\tstatic void\n108\tskip_ws(Tsp st, int skipnl)\n109\t{\n110\t\tconst char *s = skipnl ? \" \\t\\n\\r\" : \" \\t\";\n111\t\twhile (tsp_fget(st) && (strchr(s, tsp_fget(st)) || tsp_fget(st) == ';')) {\n112\t\t\tst->filec += strspn(st->file+st->filec, s); /* skip white space */\n113\t\t\tfor (; tsp_fget(st) == ';'; tsp_finc(st)) /* skip comments until newline */\n114\t\t\t\tst->filec += strcspn(st->file+st->filec, \"\\n\") - !skipnl;\n115\t\t}\n116\t}\n117\t\n118\t/* get length of list, if improper list return negative length */\n119\tint\n120\ttsp_lstlen(Val v)\n121\t{\n122\t\tint len = 0;\n123\t\tfor (; v->t == TSP_PAIR; v = cdr(v))\n124\t\t\tlen++;\n125\t\treturn nilp(v) ? len : -(len + 1);\n126\t}\n127\t\n128\t/* check if two values are equal */\n129\tstatic int\n130\tvals_eq(Val a, Val b)\n131\t{\n132\t\tif (a->t & TSP_NUM && b->t & TSP_NUM) { /* NUMBERs */\n133\t\t\tif (num(a) != num(b) || den(a) != den(b))\n134\t\t\t\treturn 0;\n135\t\t\treturn 1;\n136\t\t}\n137\t\tif (a->t != b->t)\n138\t\t\treturn 0;\n139\t\tif (a->t == TSP_PAIR) /* PAIR */\n140\t\t\treturn vals_eq(car(a), car(b)) && vals_eq(cdr(a), cdr(b));\n141\t\t/* TODO function var names should not matter in comparison */\n142\t\tif (a->t & (TSP_FUNC | TSP_MACRO)) /* FUNCTION, MACRO */\n143\t\t\treturn vals_eq(a->v.f.args, b->v.f.args) &&\n144\t\t\t       vals_eq(a->v.f.body, b->v.f.body);\n145\t\tif (a != b) /* PRIMITIVE, STRING, SYMBOL, NIL, VOID */\n146\t\t\treturn 0;\n147\t\treturn 1;\n148\t}\n149\t\n150\t/* reduce fraction by modifying supplied numerator and denominator */\n151\tstatic void\n152\tfrac_reduce(int *num, int *den)\n153\t{\n154\t\tint a = abs(*num), b = abs(*den), c = a % b;\n155\t\twhile (c > 0) {\n156\t\t\ta = b;\n157\t\t\tb = c;\n158\t\t\tc = a % b;\n159\t\t}\n160\t\t*num = *num / b;\n161\t\t*den = *den / b;\n162\t}\n163\t\n164\t/* records */\n165\t\n166\t/* return hashed number based on key */\n167\tstatic uint32_t\n168\thash(char *key)\n169\t{\n170\t\tuint32_t h = 0;\n171\t\tchar c;\n172\t\twhile (h < UINT32_MAX && (c = *key++))\n173\t\t\th = h * 33 + c;\n174\t\treturn h;\n175\t}\n176\t\n177\t/* create new empty rec with given capacity */\n178\tstatic Rec\n179\trec_new(size_t cap, Rec next)\n180\t{\n181\t\tRec rec;\n182\t\tif (!(rec = malloc(sizeof(struct Rec))))\n183\t\t\tperror(\"; malloc\"), exit(1);\n184\t\trec->size = 0;\n185\t\trec->cap = cap;\n186\t\tif (!(rec->items = calloc(cap, sizeof(struct Entry))))\n187\t\t\tperror(\"; calloc\"), exit(1);\n188\t\trec->next = next;\n189\t\treturn rec;\n190\t}\n191\t\n192\t/* get entry in one record for the key */\n193\tstatic Entry\n194\tentry_get(Rec rec, char *key)\n195\t{\n196\t\tint i = hash(key) % rec->cap;\n197\t\tchar *s;\n198\t\t/* look for key starting at hash until empty entry is found */\n199\t\twhile ((s = rec->items[i].key)) {\n200\t\t\tif (!strcmp(s, key))\n201\t\t\t\tbreak;\n202\t\t\tif (++i == rec->cap) /* loop back around if end is reached */\n203\t\t\t\ti = 0;\n204\t\t}\n205\t\treturn &rec->items[i]; /* returns entry if found or empty one to be filled */\n206\t}\n207\t\n208\t/* get value of given key in each record */\n209\tstatic Val\n210\trec_get(Rec rec, char *key)\n211\t{\n212\t\tEntry e;\n213\t\tfor (; rec; rec = rec->next) {\n214\t\t\te = entry_get(rec, key);\n215\t\t\tif (e->key)\n216\t\t\t\treturn e->val;\n217\t\t}\n218\t\treturn NULL;\n219\t}\n220\t\n221\t/* enlarge the record to ensure algorithm's efficiency */\n222\tstatic void\n223\trec_grow(Rec rec)\n224\t{\n225\t\tint i, ocap = rec->cap;\n226\t\tEntry oitems = rec->items;\n227\t\trec->cap *= TSP_REC_FACTOR;\n228\t\tif (!(rec->items = calloc(rec->cap, sizeof(struct Entry))))\n229\t\t\tperror(\"; calloc\"), exit(1);\n230\t\tfor (i = 0; i < ocap; i++) /* repopulate new record with old values */\n231\t\t\tif (oitems[i].key)\n232\t\t\t\trec_add(rec, oitems[i].key, oitems[i].val);\n233\t\tfree(oitems);\n234\t}\n235\t\n236\t/* create new key and value pair to the record */\n237\tstatic void\n238\trec_add(Rec rec, char *key, Val val)\n239\t{\n240\t\tEntry e = entry_get(rec, key);\n241\t\te->val = val;\n242\t\tif (!e->key) {\n243\t\t\te->key = key;\n244\t\t\t/* grow record if it is more than half full */\n245\t\t\tif (++rec->size > rec->cap / TSP_REC_FACTOR)\n246\t\t\t\trec_grow(rec);\n247\t\t}\n248\t}\n249\t\n250\t/* add each vals[i] to rec with key args[i] */\n251\tstatic Rec\n252\trec_extend(Rec rec, Val args, Val vals)\n253\t{\n254\t\tVal arg, val;\n255\t\tint argnum = TSP_REC_FACTOR * tsp_lstlen(args);\n256\t\t/* HACK need extra +1 for when argnum = 0 */\n257\t\tRec ret = rec_new(argnum > 0 ? argnum : -argnum + 1, rec);\n258\t\tfor (; !nilp(args); args = cdr(args), vals = cdr(vals)) {\n259\t\t\tif (args->t == TSP_PAIR) {\n260\t\t\t\targ = car(args);\n261\t\t\t\tval = car(vals);\n262\t\t\t} else {\n263\t\t\t\targ = args;\n264\t\t\t\tval = vals;\n265\t\t\t}\n266\t\t\tif (arg->t != TSP_SYM)\n267\t\t\t\ttsp_warnf(\"expected symbol for argument of function definition, recieved '%s'\",\n268\t\t\t\t          tsp_type_str(arg->t));\n269\t\t\trec_add(ret, arg->v.s, val);\n270\t\t\tif (args->t != TSP_PAIR)\n271\t\t\t\tbreak;\n272\t\t}\n273\t\treturn ret;\n274\t}\n275\t\n276\t/* make types */\n277\t\n278\tVal\n279\tmk_val(TspType t)\n280\t{\n281\t\tVal ret;\n282\t\tif (!(ret = malloc(sizeof(struct Val))))\n283\t\t\tperror(\"; malloc\"), exit(1);\n284\t\tret->t = t;\n285\t\treturn ret;\n286\t}\n287\t\n288\tVal\n289\tmk_int(int i)\n290\t{\n291\t\tVal ret = mk_val(TSP_INT);\n292\t\tnum(ret) = i;\n293\t\tden(ret) = 1;\n294\t\treturn ret;\n295\t}\n296\t\n297\tVal\n298\tmk_dec(double d)\n299\t{\n300\t\tVal ret = mk_val(TSP_DEC);\n301\t\tnum(ret) = d;\n302\t\tden(ret) = 1;\n303\t\treturn ret;\n304\t}\n305\t\n306\tVal\n307\tmk_rat(int num, int den)\n308\t{\n309\t\tVal ret;\n310\t\tif (den == 0)\n311\t\t\ttsp_warn(\"division by zero\");\n312\t\tfrac_reduce(&num, &den);\n313\t\tif (den < 0) { /* simplify so only numerator is negative */\n314\t\t\tden = abs(den);\n315\t\t\tnum = -num;\n316\t\t}\n317\t\tif (den == 1) /* simplify into integer if denominator is 1 */\n318\t\t\treturn mk_int(num);\n319\t\tret = mk_val(TSP_RATIO);\n320\t\tnum(ret) = num;\n321\t\tden(ret) = den;\n322\t\treturn ret;\n323\t}\n324\t\n325\t/* TODO combine mk_str and mk_sym, replace st with intern hash */\n326\tVal\n327\tmk_str(Tsp st, char *s)\n328\t{\n329\t\tVal ret;\n330\t\tif ((ret = rec_get(st->strs, s)))\n331\t\t\treturn ret;\n332\t\tret = mk_val(TSP_STR);\n333\t\tret->v.s = s;\n334\t\trec_add(st->strs, s, ret);\n335\t\treturn ret;\n336\t}\n337\t\n338\tVal\n339\tmk_sym(Tsp st, char *s)\n340\t{\n341\t\tVal ret;\n342\t\tif ((ret = rec_get(st->syms, s)))\n343\t\t\treturn ret;\n344\t\tret = mk_val(TSP_SYM);\n345\t\tret->v.s = s;\n346\t\trec_add(st->syms, s, ret);\n347\t\treturn ret;\n348\t}\n349\t\n350\tVal\n351\tmk_prim(TspType t, Prim pr, char *name)\n352\t{\n353\t\tVal ret = mk_val(t);\n354\t\tret->v.pr.name = name;\n355\t\tret->v.pr.pr = pr;\n356\t\treturn ret;\n357\t}\n358\t\n359\tVal\n360\tmk_func(TspType t, char *name, Val args, Val body, Rec env)\n361\t{\n362\t\tVal ret = mk_val(t);\n363\t\tret->v.f.name = name;\n364\t\tret->v.f.args = args;\n365\t\tret->v.f.body = body;\n366\t\tret->v.f.env  = env;\n367\t\treturn ret;\n368\t}\n369\t\n370\tVal\n371\tmk_rec(Tsp st, Rec env, Val assoc)\n372\t{\n373\t\tint cap;\n374\t\tVal v, ret = mk_val(TSP_REC);\n375\t\tif (!assoc)\n376\t\t\treturn ret->v.r = env, ret;\n377\t\tcap = TSP_REC_FACTOR * tsp_lstlen(assoc);\n378\t\tret->v.r = rec_new(cap > 0 ? cap : -cap + 1, NULL);\n379\t\tRec r = rec_new(4, env);\n380\t\trec_add(r, \"this\", ret);\n381\t\tfor (Val cur = assoc; cur->t == TSP_PAIR; cur = cdr(cur))\n382\t\t\tif (car(cur)->t == TSP_PAIR && caar(cur)->t & (TSP_SYM|TSP_STR)) {\n383\t\t\t\tif (!(v = tisp_eval(st, r, cdar(cur)->v.p.car)))\n384\t\t\t\t\treturn NULL;\n385\t\t\t\trec_add(ret->v.r, caar(cur)->v.s, v);\n386\t\t\t} else if (car(cur)->t == TSP_SYM) {\n387\t\t\t\tif (!(v = tisp_eval(st, r, car(cur))))\n388\t\t\t\t\treturn NULL;\n389\t\t\t\trec_add(ret->v.r, car(cur)->v.s, v);\n390\t\t\t} else tsp_warn(\"Rec: missing key symbol or string\");\n391\t\treturn ret;\n392\t}\n393\t\n394\tVal\n395\tmk_pair(Val a, Val b)\n396\t{\n397\t\tVal ret = mk_val(TSP_PAIR);\n398\t\tcar(ret) = a;\n399\t\tcdr(ret) = b;\n400\t\treturn ret;\n401\t}\n402\t\n403\tVal\n404\tmk_list(Tsp st, int n, ...)\n405\t{\n406\t\tVal lst;\n407\t\tva_list argp;\n408\t\tva_start(argp, n);\n409\t\tlst = mk_pair(va_arg(argp, Val), st->nil);\n410\t\tfor (Val cur = lst; n > 1; n--, cur = cdr(cur))\n411\t\t\tcdr(cur) = mk_pair(va_arg(argp, Val), st->nil);\n412\t\tva_end(argp);\n413\t\treturn lst;\n414\t}\n415\t\n416\t/* read */\n417\t\n418\t/* read first character of number to determine sign */\n419\tstatic int\n420\tread_sign(Tsp st)\n421\t{\n422\t\tswitch (tsp_fget(st)) {\n423\t\tcase '-': tsp_finc(st); return -1;\n424\t\tcase '+': tsp_finc(st); return 1;\n425\t\tdefault: return 1;\n426\t\t}\n427\t}\n428\t\n429\t/* return read integer */\n430\tstatic int\n431\tread_int(Tsp st)\n432\t{\n433\t\tint ret = 0;\n434\t\t/* TODO skip commas */\n435\t\tfor (; tsp_fget(st) && isdigit(tsp_fget(st)); tsp_finc(st))\n436\t\t\tret = ret * 10 + tsp_fget(st) - '0';\n437\t\treturn ret;\n438\t}\n439\t\n440\t/* return read scientific notation */\n441\tstatic Val\n442\tread_sci(Tsp st, double val, int isint)\n443\t{\n444\t\tif (tolower(tsp_fget(st)) != 'e')\n445\t\t\tgoto finish;\n446\t\n447\t\ttsp_finc(st);\n448\t\tdouble sign = read_sign(st) == 1 ? 10.0 : 0.1;\n449\t\tfor (int expo = read_int(st); expo--; val *= sign) ;\n450\t\n451\tfinish:\n452\t\tif (isint)\n453\t\t\treturn mk_int(val);\n454\t\treturn mk_dec(val);\n455\t}\n456\t\n457\t/* return read number */\n458\tstatic Val\n459\tread_num(Tsp st)\n460\t{\n461\t\tint sign = read_sign(st);\n462\t\tint num = read_int(st);\n463\t\tsize_t oldc;\n464\t\tswitch (tsp_fget(st)) {\n465\t\tcase '/':\n466\t\t\tif (!isnum(st->file + ++st->filec))\n467\t\t\t\ttsp_warn(\"incorrect ratio format, no denominator found\");\n468\t\t\treturn mk_rat(sign * num, read_sign(st) * read_int(st));\n469\t\tcase '.':\n470\t\t\ttsp_finc(st);\n471\t\t\toldc = st->filec;\n472\t\t\tdouble d = (double) read_int(st);\n473\t\t\tint size = st->filec - oldc;\n474\t\t\twhile (size--)\n475\t\t\t\td /= 10.0;\n476\t\t\treturn read_sci(st, sign * (num+d), 0);\n477\t\tdefault:\n478\t\t\treturn read_sci(st, sign * num, 1);\n479\t\t}\n480\t}\n481\t\n482\t/* return character for escape */\n483\tstatic char\n484\tesc_char(char c)\n485\t{\n486\t\tswitch (c) {\n487\t\tcase 'n': return '\\n';\n488\t\tcase 'r': return '\\r';\n489\t\tcase 't': return '\\t';\n490\t\tcase '\\n': return ' ';\n491\t\tcase '\\\\':\n492\t\tcase '\"':\n493\t\tdefault:  return c;\n494\t\t}\n495\t}\n496\t\n497\t/* replace all encoded escape characters in string with their actual character */\n498\tstatic char *\n499\tesc_str(char *s, int len, int do_esc)\n500\t{\n501\t\tchar *pos, *ret;\n502\t\tif (!(ret = malloc((len+1) * sizeof(char))))\n503\t\t\tperror(\"; malloc\"), exit(1);\n504\t\tfor (pos = ret; pos-ret < len; pos++, s++)\n505\t\t\t*pos = (*s == '\\\\' && do_esc) ? esc_char(*(++s)) : *s;\n506\t\t*pos = '\\0';\n507\t\treturn ret;\n508\t}\n509\t\n510\t/* return read string or symbol, depending on mk_fn */\n511\tstatic Val\n512\tread_str(Tsp st, Val (*mk_fn)(Tsp, char*))\n513\t{\n514\t\tint len = 0;\n515\t\tchar *s = st->file + ++st->filec; /* skip starting open quote */\n516\t\tchar endchar = mk_fn == &mk_str ? '\"' : '~';\n517\t\tfor (; tsp_fget(st) != endchar; tsp_finc(st), len++) /* get length of new escaped string */\n518\t\t\tif (!tsp_fget(st))\n519\t\t\t\ttsp_warnf(\"reached end before closing %c\", endchar);\n520\t\t\telse if (tsp_fget(st) == '\\\\' && tsp_fgetat(st, -1) != '\\\\')\n521\t\t\t\ttsp_finc(st); /* skip over break condition since it is escaped */\n522\t\ttsp_finc(st); /* skip last closing quote */\n523\t\treturn mk_fn(st, esc_str(s, len, mk_fn == &mk_str)); /* only escape strings */\n524\t}\n525\t\n526\t/* return read symbol */\n527\tstatic Val\n528\tread_sym(Tsp st, int (*is_char)(char))\n529\t{\n530\t\tint len = 0;\n531\t\tchar *s = st->file + st->filec;\n532\t\tfor (; tsp_fget(st) && is_char(tsp_fget(st)); tsp_finc(st))\n533\t\t\tlen++; /* get length of new symbol */\n534\t\treturn mk_sym(st, esc_str(s, len, 0));\n535\t}\n536\t\n537\t/* return read list, pair, or improper list */\n538\tVal\n539\tread_pair(Tsp st, char endchar)\n540\t{\n541\t\tVal v, ret = mk_pair(NULL, st->nil);\n542\t\tint skipnl = endchar != '\\n';\n543\t\tskip_ws(st, skipnl);\n544\t\tfor (Val pos = ret; tsp_fget(st) && tsp_fget(st) != endchar; pos = cdr(pos)) {\n545\t\t\tif (!(v = tisp_read(st)))\n546\t\t\t\treturn NULL;\n547\t\t\t/* pair cdr, end with non-nil (improper list) */\n548\t\t\tif (v->t == TSP_SYM && !strncmp(v->v.s, \".\", 2)) {\n549\t\t\t\tskip_ws(st, skipnl);\n550\t\t\t\tif (!(v = tisp_read(st)))\n551\t\t\t\t\treturn NULL;\n552\t\t\t\tcdr(pos) = v;\n553\t\t\t\tbreak;\n554\t\t\t}\n555\t\t\tcdr(pos) = mk_pair(v, st->nil);\n556\t\t\tskip_ws(st, skipnl);\n557\t\t}\n558\t\tskip_ws(st, skipnl);\n559\t\tif (skipnl && tsp_fget(st) != endchar)\n560\t\t\ttsp_warnf(\"did not find closing '%c'\", endchar);\n561\t\ttsp_finc(st);\n562\t\treturn cdr(ret);\n563\t}\n564\t\n565\t/* reads given string returning its tisp value */\n566\tVal\n567\ttisp_read_sexpr(Tsp st)\n568\t{\n569\t\t/* TODO merge w/ infix */\n570\t\t/* TODO mk const global */\n571\t\tstatic char *prefix[] = {\n572\t\t\t\"'\",  \"quote\",\n573\t\t\t\"`\",  \"quasiquote\",\n574\t\t\t\",@\", \"unquote-splice\", /* always check before , */\n575\t\t\t\",\",  \"unquote\",\n576\t\t\t\"@\",  \"Func\",\n577\t\t\t\"f\\\"\",  \"strformat\",\n578\t\t\t/* \"?\",  \"try?\", */\n579\t\t\t/* \"$\",  \"system!\", */\n580\t\t\t/* \"-\",  \"negative\", */\n581\t\t\t/* \"!\",  \"not?\", */\n582\t\t};\n583\t\tskip_ws(st, 1);\n584\t\tif (strlen(st->file+st->filec) == 0) /* empty list */\n585\t\t\treturn st->none;\n586\t\tif (isnum(st->file+st->filec)) /* number */\n587\t\t\treturn read_num(st);\n588\t\tif (tsp_fget(st) == '\"') /* string */\n589\t\t\treturn read_str(st, mk_str);\n590\t\tif (tsp_fget(st) == '~') /* explicit symbol */\n591\t\t\treturn read_str(st, mk_sym);\n592\t\tfor (int i = 0; i < LEN(prefix); i += 2) { /* character prefix */\n593\t\t\tif (!strncmp(st->file+st->filec, prefix[i], strlen(prefix[i]))) {\n594\t\t\t\tVal v;\n595\t\t\t\ttsp_fincn(st, strlen(prefix[i]) - (prefix[i][1] == '\"'));\n596\t\t\t\tif (!(v = tisp_read(st))) return NULL;\n597\t\t\t\treturn mk_list(st, 2, mk_sym(st, prefix[i+1]), v);\n598\t\t\t}\n599\t\t}\n600\t\tif (is_op(tsp_fget(st))) /* operators */\n601\t\t\treturn read_sym(st, &is_op);\n602\t\tif (is_sym(tsp_fget(st))) /* symbols */\n603\t\t\treturn read_sym(st, &is_sym);\n604\t\tif (tsp_fget(st) == '(') /* list */\n605\t\t\treturn tsp_finc(st), read_pair(st, ')');\n606\t\tif (tsp_fget(st) == '[') /* list */\n607\t\t\treturn tsp_finc(st), mk_pair(mk_sym(st, \"list\"), read_pair(st, ']'));\n608\t\tif (tsp_fget(st) == '{') { /* record */\n609\t\t\tVal v; tsp_finc(st);\n610\t\t\tif (!(v = read_pair(st, '}'))) return NULL;\n611\t\t\treturn mk_pair(mk_sym(st, \"Rec\"), v);\n612\t\t}\n613\t\ttsp_warnf(\"could not read given input '%c' (%d)\",\n614\t\t          st->file[st->filec], (int)st->file[st->filec]);\n615\t}\n616\t\n617\t/* read single value, made up of s-expression and optional syntax sugar */\n618\tVal\n619\ttisp_read(Tsp st)\n620\t{\n621\t\tVal v;\n622\t\tif (!(v = tisp_read_sexpr(st)))\n623\t\t\treturn NULL;\n624\t\t/* HACK find more general way to do this */\n625\t\twhile (tsp_fget(st) == '(' || tsp_fget(st) == ':' || tsp_fget(st) == '>' ||\n626\t\t       tsp_fget(st) == '{')\n627\t\t\tv = tisp_read_sugar(st, v);\n628\t\treturn v;\n629\t}\n630\t\n631\t/* read extra syntax sugar on top of s-expressions */\n632\tVal\n633\ttisp_read_sugar(Tsp st, Val v)\n634\t{\n635\t\tVal lst, w;\n636\t\tif (tsp_fget(st) == '(') { /* func(x y) => (func x y) */\n637\t\t\t/* FIXME @it(3) */\n638\t\t\ttsp_finc(st);\n639\t\t\tif (!(lst = read_pair(st, ')'))) return NULL;\n640\t\t\treturn mk_pair(v, lst);\n641\t\t} else if (tsp_fget(st) == '{') { /* rec{ key: value } => (recmerge rec { key: value }) */\n642\t\t\ttsp_finc(st);\n643\t\t\tif (!(lst = read_pair(st, '}'))) return NULL;\n644\t\t\treturn mk_list(st, 3, mk_sym(st, \"recmerge\"), v,\n645\t\t\t                      mk_pair(mk_sym(st, \"Rec\"), lst));\n646\t\t} else if (tsp_fget(st) == ':') {\n647\t\t\ttsp_finc(st);\n648\t\t\tswitch (tsp_fget(st)) {\n649\t\t\tcase '(': /* proc:(lst) => (map proc lst) */\n650\t\t\t\ttsp_finc(st);\n651\t\t\t\tif (!(w = read_pair(st, ')'))) return NULL;\n652\t\t\t\treturn mk_pair(mk_sym(st, \"map\"), mk_pair(v, w));\n653\t\t\tcase ':': /* var::prop => (var 'prop) */\n654\t\t\t\ttsp_finc(st);\n655\t\t\t\tif (!(w = read_sym(st, &is_sym))) return NULL;\n656\t\t\t\treturn mk_list(st, 2, v, mk_list(st, 2, mk_sym(st, \"quote\"), w));\n657\t\t\tdefault: /* key: val => (key val) */\n658\t\t\t\tskip_ws(st, 1);\n659\t\t\t\tif (!(w = tisp_read(st))) return NULL;\n660\t\t\t\treturn mk_list(st, 2, v, w);\n661\t\t\t}\n662\t\t} else if (tsp_fget(st) == '>' && tsp_fgetat(st, 1) == '>') {\n663\t\t\ttsp_finc(st), tsp_finc(st);\n664\t\t\tif (!(w = tisp_read(st)) || w->t != TSP_PAIR)\n665\t\t\t\ttsp_warn(\"invalid UFCS\");\n666\t\t\treturn mk_pair(car(w), mk_pair(v, cdr(w)));\n667\t\t}\n668\t\t/* return mk_pair(v, tisp_read(st)); */\n669\t\treturn v;\n670\t}\n671\t\n672\tVal\n673\ttisp_read_line(Tsp st, int level)\n674\t{\n675\t\tVal pos, ret;\n676\t\tif (!(ret = read_pair(st, '\\n'))) /* read line */\n677\t\t\treturn NULL;\n678\t\tif (ret->t != TSP_PAIR) /* force to be pair */\n679\t\t\tret = mk_pair(ret, st->nil);\n680\t\tfor (pos = ret; cdr(pos)->t == TSP_PAIR; pos = cdr(pos)) ; /* get last pair */\n681\t\tfor (; tsp_fget(st); pos = cdr(pos)) { /* read indented lines as sub expressions */\n682\t\t\tint newlevel = strspn(st->file+st->filec, \"\\t \");\n683\t\t\tif (newlevel <= level)\n684\t\t\t\tbreak;\n685\t\t\tst->filec += newlevel;\n686\t\t\tcdr(pos) = mk_pair(tisp_read_line(st, newlevel), cdr(pos));\n687\t\t}\n688\t\treturn nilp(cdr(ret)) ? car(ret) : ret; /* if only 1 element in list, return just it */\n689\t}\n690\t\n691\t/* eval */\n692\t\n693\t/* evaluate each element of list */\n694\t/* TODO arg for tisp_eval or expand_macro */\n695\tVal\n696\ttisp_eval_list(Tsp st, Rec env, Val v)\n697\t{\n698\t\tVal ret = mk_pair(NULL, st->nil), ev;\n699\t\tfor (Val cur = ret; !nilp(v); v = cdr(v), cur = cdr(cur)) {\n700\t\t\tif (v->t != TSP_PAIR) { /* last element in improper list */\n701\t\t\t\tif (!(ev = tisp_eval(st, env, v)))\n702\t\t\t\t\treturn NULL;\n703\t\t\t\tcdr(cur) = ev;\n704\t\t\t\treturn cdr(ret);\n705\t\t\t}\n706\t\t\tif (!(ev = tisp_eval(st, env, car(v))))\n707\t\t\t\treturn NULL;\n708\t\t\tcdr(cur) = mk_pair(ev, st->nil);\n709\t\t}\n710\t\treturn cdr(ret);\n711\t}\n712\t\n713\t/* evaluate all elements of list returning last */\n714\tVal\n715\ttisp_eval_body(Tsp st, Rec env, Val v)\n716\t{\n717\t\tVal ret = st->none;\n718\t\tfor (; v->t == TSP_PAIR; v = cdr(v))\n719\t\t\tif (nilp(cdr(v)) && car(v)->t == TSP_PAIR) { /* func call is last, do tail call */\n720\t\t\t\tVal f, args;\n721\t\t\t\tif (!(f = tisp_eval(st, env, caar(v))))\n722\t\t\t\t\treturn NULL;\n723\t\t\t\tif (f->t != TSP_FUNC)\n724\t\t\t\t\treturn eval_proc(st, env, f, cdar(v));\n725\t\t\t\ttsp_arg_num(cdar(v), f->v.f.name ? f->v.f.name : \"anon\",\n726\t\t\t\t            tsp_lstlen(f->v.f.args));\n727\t\t\t\tif (!(args = tisp_eval_list(st, env, cdar(v))))\n728\t\t\t\t\treturn NULL;\n729\t\t\t\tif (!(env = rec_extend(f->v.f.env, f->v.f.args, args)))\n730\t\t\t\t\treturn NULL;\n731\t\t\t\tv = mk_pair(NULL, f->v.f.body); /* continue loop from body of func call */\n732\t\t\t} else if (!(ret = tisp_eval(st, env, car(v))))\n733\t\t\t\treturn NULL;\n734\t\treturn ret;\n735\t}\n736\t\n737\tstatic void\n738\tprepend_bt(Tsp st, Rec env, Val f)\n739\t{\n740\t\tif (!f->v.f.name) /* no need to record anonymous functions */\n741\t\t\treturn;\n742\t\tfor (; env->next; env = env->next) ; /* bt var located at base env */\n743\t\tEntry e = entry_get(env, \"bt\");\n744\t\tif (e->val->t == TSP_PAIR && car(e->val)->t == TSP_SYM &&\n745\t\t    !strncmp(f->v.f.name, car(e->val)->v.s, strlen(car(e->val)->v.s)))\n746\t\t\treturn; /* don't record same function on recursion */\n747\t\te->val = mk_pair(mk_sym(st, f->v.f.name), e->val);\n748\t}\n749\t\n750\t/* evaluate procedure f with arguments */\n751\tstatic Val\n752\teval_proc(Tsp st, Rec env, Val f, Val args)\n753\t{\n754\t\tVal ret;\n755\t\tRec fenv;\n756\t\t/* evaluate function and primitive arguments before being passed */\n757\t\tswitch (f->t) {\n758\t\tcase TSP_PRIM:\n759\t\t\tif (!(args = tisp_eval_list(st, env, args)))\n760\t\t\t\treturn NULL;\n761\t\t\t/* FALLTHROUGH */\n762\t\tcase TSP_FORM:\n763\t\t\treturn (*f->v.pr.pr)(st, env, args);\n764\t\tcase TSP_FUNC:\n765\t\t\tif (!(args = tisp_eval_list(st, env, args)))\n766\t\t\t\treturn NULL;\n767\t\t\t/* FALLTHROUGH */\n768\t\tcase TSP_MACRO:\n769\t\t\ttsp_arg_num(args, f->v.f.name ? f->v.f.name : \"anon\", tsp_lstlen(f->v.f.args));\n770\t\t\tif (!(fenv = rec_extend(f->v.f.env, f->v.f.args, args)))\n771\t\t\t\treturn NULL;\n772\t\t\tif (!(ret = tisp_eval_body(st, fenv, f->v.f.body)))\n773\t\t\t\treturn prepend_bt(st, env, f), NULL;\n774\t\t\tif (f->t == TSP_MACRO) /* TODO remove w/ expand_macro */\n775\t\t\t\tret = tisp_eval(st, env, ret);\n776\t\t\treturn ret;\n777\t\tcase TSP_REC:\n778\t\t\tif (!(args = tisp_eval_list(st, env, args)))\n779\t\t\t\treturn NULL;\n780\t\t\ttsp_arg_num(args, \"record\", 1);\n781\t\t\ttsp_arg_type(car(args), \"record\", TSP_SYM);\n782\t\t\tif (!(ret = rec_get(f->v.r, car(args)->v.s)) &&\n783\t\t\t    !(ret = rec_get(f->v.r, \"else\")))\n784\t\t\t\ttsp_warnf(\"could not find element '%s' in record\", car(args)->v.s);\n785\t\t\treturn ret;\n786\t\tdefault:\n787\t\t\ttsp_warnf(\"attempt to evaluate non procedural type %s\", tsp_type_str(f->t));\n788\t\t}\n789\t}\n790\t\n791\t/* evaluate given value */\n792\tVal\n793\ttisp_eval(Tsp st, Rec env, Val v)\n794\t{\n795\t\tVal f;\n796\t\tswitch (v->t) {\n797\t\tcase TSP_SYM:\n798\t\t\tif (!(f = rec_get(env, v->v.s)))\n799\t\t\t\ttsp_warnf(\"could not find symbol '%s'\", v->v.s);\n800\t\t\treturn f;\n801\t\tcase TSP_PAIR:\n802\t\t\tif (!(f = tisp_eval(st, env, car(v))))\n803\t\t\t\treturn NULL;\n804\t\t\treturn eval_proc(st, env, f, cdr(v));\n805\t\tdefault:\n806\t\t\treturn v;\n807\t\t}\n808\t}\n809\t\n810\t/* print */\n811\t\n812\t/* main print function */\n813\t/* TODO return Str, unify w/ val_string */\n814\tvoid\n815\ttisp_print(FILE *f, Val v)\n816\t{\n817\t\tswitch (v->t) {\n818\t\tcase TSP_NONE:\n819\t\t\tfputs(\"Void\", f);\n820\t\t\tbreak;\n821\t\tcase TSP_NIL:\n822\t\t\tfputs(\"Nil\", f);\n823\t\t\tbreak;\n824\t\tcase TSP_INT:\n825\t\t\tfprintf(f, \"%d\", (int) num(v));\n826\t\t\tbreak;\n827\t\tcase TSP_DEC:\n828\t\t\t/* TODO fix 1.e-5 print as int 1e-05 */\n829\t\t\tfprintf(f, \"%.15g\", num(v));\n830\t\t\tif (num(v) == (int)num(v))\n831\t\t\t\tfprintf(f, \".0\");\n832\t\t\tbreak;\n833\t\tcase TSP_RATIO:\n834\t\t\tfprintf(f, \"%d/%d\", (int)num(v), (int)den(v));\n835\t\t\tbreak;\n836\t\tcase TSP_STR:\n837\t\tcase TSP_SYM:\n838\t\t\tfputs(v->v.s, f); /* TODO fflush? */\n839\t\t\tbreak;\n840\t\tcase TSP_FUNC:\n841\t\tcase TSP_MACRO:\n842\t\t\t/* TODO replace with printing function name with type annotaction */\n843\t\t\tfprintf(f, \"#<%s%s%s>\", /* if proc name is not null print it */\n844\t\t\t            v->t == TSP_FUNC ? \"function\" : \"macro\",\n845\t\t\t            v->v.f.name ? \":\" : \"\", /* TODO dont work for anon funcs */\n846\t\t\t            v->v.f.name ? v->v.f.name : \"\");\n847\t\t\tbreak;\n848\t\tcase TSP_PRIM:\n849\t\t\tfprintf(f, \"#<primitive:%s>\", v->v.pr.name);\n850\t\t\tbreak;\n851\t\tcase TSP_FORM:\n852\t\t\tfprintf(f, \"#<form:%s>\", v->v.pr.name);\n853\t\t\tbreak;\n854\t\tcase TSP_REC:\n855\t\t\tputc('{', f);\n856\t\t\tfor (Rec r = v->v.r; r; r = r->next)\n857\t\t\t\tfor (int i = 0, c = 0; c < r->size; i++)\n858\t\t\t\t\tif (r->items[i].key) {\n859\t\t\t\t\t\tc++;\n860\t\t\t\t\t\tfprintf(f, \" %s: \", r->items[i].key);\n861\t\t\t\t\t\ttisp_print(f, r->items[i].val);\n862\t\t\t\t\t} else if (c == TSP_REC_MAX_PRINT) {\n863\t\t\t\t\t\tfputs(\" ...\", f);\n864\t\t\t\t\t\tbreak;\n865\t\t\t\t\t}\n866\t\t\tfputs(\" }\", f);\n867\t\t\tbreak;\n868\t\tcase TSP_PAIR:\n869\t\t\tputc('(', f);\n870\t\t\ttisp_print(f, car(v));\n871\t\t\tfor (v = cdr(v); !nilp(v); v = cdr(v)) {\n872\t\t\t\tif (v->t == TSP_PAIR) {\n873\t\t\t\t\tputc(' ', f);\n874\t\t\t\t\ttisp_print(f, car(v));\n875\t\t\t\t} else {\n876\t\t\t\t\tfputs(\" . \", f);\n877\t\t\t\t\ttisp_print(f, v);\n878\t\t\t\t\tbreak;\n879\t\t\t\t}\n880\t\t\t}\n881\t\t\tputc(')', f);\n882\t\t\tbreak;\n883\t\tdefault:\n884\t\t\tfprintf(stderr, \"; tisp: could not print value type %s\\n\", tsp_type_str(v->t));\n885\t\t}\n886\t\t/* fflush(f); */\n887\t}\n888\t\n889\t/* environment */\n890\t\n891\t/* add new variable of name key and value v to the given environment */\n892\tvoid\n893\ttisp_env_add(Tsp st, char *key, Val v)\n894\t{\n895\t\trec_add(st->env, key, v);\n896\t}\n897\t\n898\t/* initialise tisp's state and global environment */\n899\tTsp\n900\ttisp_env_init(size_t cap)\n901\t{\n902\t\tTsp st;\n903\t\tif (!(st = malloc(sizeof(struct Tsp))))\n904\t\t\tperror(\"; malloc\"), exit(1);\n905\t\n906\t\tst->file = NULL;\n907\t\tst->filec = 0;\n908\t\n909\t\t/* TODO intern (memorize) all types, including stateless func calls */\n910\t\tst->strs = rec_new(cap, NULL);\n911\t\tst->syms = rec_new(cap, NULL);\n912\t\n913\t\t/* TODO make globals */\n914\t\tst->nil = mk_val(TSP_NIL);\n915\t\tst->none = mk_val(TSP_NONE);\n916\t\tst->t = mk_val(TSP_SYM);\n917\t\tst->t->v.s = \"True\";\n918\t\n919\t\tst->env = rec_new(cap, NULL);\n920\t\ttisp_env_add(st, \"True\", st->t);\n921\t\ttisp_env_add(st, \"Nil\", st->nil);\n922\t\ttisp_env_add(st, \"Void\", st->none);\n923\t\ttisp_env_add(st, \"bt\", st->nil);\n924\t\ttisp_env_add(st, \"version\", mk_str(st, \"0.1\"));\n925\t\n926\t\tst->libh = NULL;\n927\t\tst->libhc = 0;\n928\t\n929\t\treturn st;\n930\t}\n931\t\n932\tvoid\n933\ttisp_env_lib(Tsp st, char* lib)\n934\t{\n935\t\tVal v;\n936\t\tchar *file = st->file;\n937\t\tsize_t filec = st->filec;\n938\t\tst->file = lib;\n939\t\tst->filec = 0;\n940\t\tskip_ws(st, 1);\n941\t\tif ((v = tisp_read(st)))\n942\t\t\ttisp_eval_body(st, st->env, v);\n943\t\tst->file = file;\n944\t\tst->filec = filec;\n945\t}\n946\t\n947\t\n948\t#include \"tib/core.c\"\n949\t#include \"tib/string.c\"\n950\t#include \"tib/math.c\"\n951\t#include \"tib/io.c\"\n952\t#include \"tib/os.c\"\n953\t"}]},"parent_tool_use_id":null,"session_id":"bb69e98f-9561-427b-bfd0-eb7d58cb6609","uuid":"8f558f3d-935b-4fff-9ca9-aa70d0237cec","timestamp":"2026-06-05T21:23:12.024Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-8i8Ex2/project/c_src/tisp.c","content":"/* zlib License\n *\n * Copyright (c) 2017-2025 Ed van Bruggen\n *\n * This software is provided 'as-is', without any express or implied\n * warranty.  In no event will the authors be held liable for any damages\n * arising from the use of this software.\n *\n * Permission is granted to anyone to use this software for any purpose,\n * including commercial applications, and to alter it and redistribute it\n * freely, subject to the following restrictions:\n *\n * 1. The origin of this software must not be misrepresented; you must not\n *    claim that you wrote the original software. If you use this software\n *    in a product, an acknowledgment in the product documentation would be\n *    appreciated but is not required.\n * 2. Altered source versions must be plainly marked as such, and must not be\n *    misrepresented as being the original software.\n * 3. This notice may not be removed or altered from any source distribution.\n */\n#include <ctype.h>\n#include <stdarg.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"tisp.h\"\n\n#define car(P)  ((P)->v.p.car)\n#define cdr(P)  ((P)->v.p.cdr)\n#define caar(P) car(car(P))\n#define cadr(P) car(cdr(P))\n#define cdar(P) cdr(car(P))\n#define cddr(P) cdr(cdr(P))\n#define nilp(V) ((V)->t == TSP_NIL)\n#define num(N) ((N)->v.n.num)\n#define den(N) ((N)->v.n.den)\n\n#define BETWEEN(X, A, B)  ((A) <= (X) && (X) <= (B))\n#define LEN(X)            (sizeof(X) / sizeof((X)[0]))\n\n/* functions */\nstatic void rec_add(Rec rec, char *key, Val val);\nstatic Val eval_proc(Tsp st, Rec env, Val f, Val args);\n\n/* utility functions */\n\n/* return named string for each type */\n/* TODO loop through each type bit to print */\nchar *\ntsp_type_str(TspType t)\n{\n\tswitch (t) {\n\tcase TSP_NONE:  return \"Void\";\n\tcase TSP_NIL:   return \"Nil\";\n\tcase TSP_INT:   return \"Int\";\n\tcase TSP_DEC:   return \"Dec\";\n\tcase TSP_RATIO: return \"Ratio\";\n\tcase TSP_STR:   return \"Str\";\n\tcase TSP_SYM:   return \"Sym\";\n\tcase TSP_PRIM:  return \"Prim\";\n\tcase TSP_FORM:  return \"Form\";\n\tcase TSP_FUNC:  return \"Func\";\n\tcase TSP_MACRO: return \"Macro\";\n\tcase TSP_PAIR:  return \"Pair\";\n\tcase TSP_REC:   return \"Rec\";\n\tdefault:\n\t\tif (t == TSP_EXPR)\n\t\t\treturn \"Expr\";\n\t\tif (t == TSP_RATIONAL)\n\t\t\treturn \"Rational\";\n\t\tif (t & TSP_NUM)\n\t\t\treturn \"Num\";\n\t\treturn \"Invalid\";\n\t}\n}\n\n/* check if character can be a part of a symbol */\nstatic int\nis_sym(char c)\n{\n\t/* TODO expand for all UTF: if c > 255 */\n\treturn BETWEEN(c, 'a', 'z') || BETWEEN(c, 'A', 'Z') ||\n\t       BETWEEN(c, '0', '9') || strchr(TSP_SYM_CHARS, c);\n}\n\n/* check if character can be a part of an operator */\nstatic int\nis_op(char c)\n{\n\treturn strchr(TSP_OP_CHARS, c) != NULL;\n}\n\n/* check if character is start of a number */\n/* TODO only if -/+ is not followed by a delim */\n/* TODO use XOR '0' < 10 */\nstatic int\nisnum(char *str)\n{\n\treturn isdigit(*str) || (*str == '.' &&  isdigit(str[1])) ||\n\t       ((*str == '-' || *str == '+') && (isdigit(str[1]) || str[1] == '.'));\n}\n\n/* skip over comments and white space */\n/* TODO support mac/windows line endings */\nstatic void\nskip_ws(Tsp st, int skipnl)\n{\n\tconst char *s = skipnl ? \" \\t\\n\\r\" : \" \\t\";\n\twhile (tsp_fget(st) && (strchr(s, tsp_fget(st)) || tsp_fget(st) == ';')) {\n\t\tst->filec += strspn(st->file+st->filec, s); /* skip white space */\n\t\tfor (; tsp_fget(st) == ';'; tsp_finc(st)) /* skip comments until newline */\n\t\t\tst->filec += strcspn(st->file+st->filec, \"\\n\") - !skipnl;\n\t}\n}\n\n/* get length of list, if improper list return negative length */\nint\ntsp_lstlen(Val v)\n{\n\tint len = 0;\n\tfor (; v->t == TSP_PAIR; v = cdr(v))\n\t\tlen++;\n\treturn nilp(v) ? len : -(len + 1);\n}\n\n/* check if two values are equal */\nstatic int\nvals_eq(Val a, Val b)\n{\n\tif (a->t & TSP_NUM && b->t & TSP_NUM) { /* NUMBERs */\n\t\tif (num(a) != num(b) || den(a) != den(b))\n\t\t\treturn 0;\n\t\treturn 1;\n\t}\n\tif (a->t != b->t)\n\t\treturn 0;\n\tif (a->t == TSP_PAIR) /* PAIR */\n\t\treturn vals_eq(car(a), car(b)) && vals_eq(cdr(a), cdr(b));\n\t/* TODO function var names should not matter in comparison */\n\tif (a->t & (TSP_FUNC | TSP_MACRO)) /* FUNCTION, MACRO */\n\t\treturn vals_eq(a->v.f.args, b->v.f.args) &&\n\t\t       vals_eq(a->v.f.body, b->v.f.body);\n\tif (a != b) /* PRIMITIVE, STRING, SYMBOL, NIL, VOID */\n\t\treturn 0;\n\treturn 1;\n}\n\n/* reduce fraction by modifying supplied numerator and denominator */\nstatic void\nfrac_reduce(int *num, int *den)\n{\n\tint a = abs(*num), b = abs(*den), c = a % b;\n\twhile (c > 0) {\n\t\ta = b;\n\t\tb = c;\n\t\tc = a % b;\n\t}\n\t*num = *num / b;\n\t*den = *den / b;\n}\n\n/* records */\n\n/* return hashed number based on key */\nstatic uint32_t\nhash(char *key)\n{\n\tuint32_t h = 0;\n\tchar c;\n\twhile (h < UINT32_MAX && (c = *key++))\n\t\th = h * 33 + c;\n\treturn h;\n}\n\n/* create new empty rec with given capacity */\nstatic Rec\nrec_new(size_t cap, Rec next)\n{\n\tRec rec;\n\tif (!(rec = malloc(sizeof(struct Rec))))\n\t\tperror(\"; malloc\"), exit(1);\n\trec->size = 0;\n\trec->cap = cap;\n\tif (!(rec->items = calloc(cap, sizeof(struct Entry))))\n\t\tperror(\"; calloc\"), exit(1);\n\trec->next = next;\n\treturn rec;\n}\n\n/* get entry in one record for the key */\nstatic Entry\nentry_get(Rec rec, char *key)\n{\n\tint i = hash(key) % rec->cap;\n\tchar *s;\n\t/* look for key starting at hash until empty entry is found */\n\twhile ((s = rec->items[i].key)) {\n\t\tif (!strcmp(s, key))\n\t\t\tbreak;\n\t\tif (++i == rec->cap) /* loop back around if end is reached */\n\t\t\ti = 0;\n\t}\n\treturn &rec->items[i]; /* returns entry if found or empty one to be filled */\n}\n\n/* get value of given key in each record */\nstatic Val\nrec_get(Rec rec, char *key)\n{\n\tEntry e;\n\tfor (; rec; rec = rec->next) {\n\t\te = entry_get(rec, key);\n\t\tif (e->key)\n\t\t\treturn e->val;\n\t}\n\treturn NULL;\n}\n\n/* enlarge the record to ensure algorithm's efficiency */\nstatic void\nrec_grow(Rec rec)\n{\n\tint i, ocap = rec->cap;\n\tEntry oitems = rec->items;\n\trec->cap *= TSP_REC_FACTOR;\n\tif (!(rec->items = calloc(rec->cap, sizeof(struct Entry))))\n\t\tperror(\"; calloc\"), exit(1);\n\tfor (i = 0; i < ocap; i++) /* repopulate new record with old values */\n\t\tif (oitems[i].key)\n\t\t\trec_add(rec, oitems[i].key, oitems[i].val);\n\tfree(oitems);\n}\n\n/* create new key and value pair to the record */\nstatic void\nrec_add(Rec rec, char *key, Val val)\n{\n\tEntry e = entry_get(rec, key);\n\te->val = val;\n\tif (!e->key) {\n\t\te->key = key;\n\t\t/* grow record if it is more than half full */\n\t\tif (++rec->size > rec->cap / TSP_REC_FACTOR)\n\t\t\trec_grow(rec);\n\t}\n}\n\n/* add each vals[i] to rec with key args[i] */\nstatic Rec\nrec_extend(Rec rec, Val args, Val vals)\n{\n\tVal arg, val;\n\tint argnum = TSP_REC_FACTOR * tsp_lstlen(args);\n\t/* HACK need extra +1 for when argnum = 0 */\n\tRec ret = rec_new(argnum > 0 ? argnum : -argnum + 1, rec);\n\tfor (; !nilp(args); args = cdr(args), vals = cdr(vals)) {\n\t\tif (args->t == TSP_PAIR) {\n\t\t\targ = car(args);\n\t\t\tval = car(vals);\n\t\t} else {\n\t\t\targ = args;\n\t\t\tval = vals;\n\t\t}\n\t\tif (arg->t != TSP_SYM)\n\t\t\ttsp_warnf(\"expected symbol for argument of function definition, recieved '%s'\",\n\t\t\t          tsp_type_str(arg->t));\n\t\trec_add(ret, arg->v.s, val);\n\t\tif (args->t != TSP_PAIR)\n\t\t\tbreak;\n\t}\n\treturn ret;\n}\n\n/* make types */\n\nVal\nmk_val(TspType t)\n{\n\tVal ret;\n\tif (!(ret = malloc(sizeof(struct Val))))\n\t\tperror(\"; malloc\"), exit(1);\n\tret->t = t;\n\treturn ret;\n}\n\nVal\nmk_int(int i)\n{\n\tVal ret = mk_val(TSP_INT);\n\tnum(ret) = i;\n\tden(ret) = 1;\n\treturn ret;\n}\n\nVal\nmk_dec(double d)\n{\n\tVal ret = mk_val(TSP_DEC);\n\tnum(ret) = d;\n\tden(ret) = 1;\n\treturn ret;\n}\n\nVal\nmk_rat(int num, int den)\n{\n\tVal ret;\n\tif (den == 0)\n\t\ttsp_warn(\"division by zero\");\n\tfrac_reduce(&num, &den);\n\tif (den < 0) { /* simplify so only numerator is negative */\n\t\tden = abs(den);\n\t\tnum = -num;\n\t}\n\tif (den == 1) /* simplify into integer if denominator is 1 */\n\t\treturn mk_int(num);\n\tret = mk_val(TSP_RATIO);\n\tnum(ret) = num;\n\tden(ret) = den;\n\treturn ret;\n}\n\n/* TODO combine mk_str and mk_sym, replace st with intern hash */\nVal\nmk_str(Tsp st, char *s)\n{\n\tVal ret;\n\tif ((ret = rec_get(st->strs, s)))\n\t\treturn ret;\n\tret = mk_val(TSP_STR);\n\tret->v.s = s;\n\trec_add(st->strs, s, ret);\n\treturn ret;\n}\n\nVal\nmk_sym(Tsp st, char *s)\n{\n\tVal ret;\n\tif ((ret = rec_get(st->syms, s)))\n\t\treturn ret;\n\tret = mk_val(TSP_SYM);\n\tret->v.s = s;\n\trec_add(st->syms, s, ret);\n\treturn ret;\n}\n\nVal\nmk_prim(TspType t, Prim pr, char *name)\n{\n\tVal ret = mk_val(t);\n\tret->v.pr.name = name;\n\tret->v.pr.pr = pr;\n\treturn ret;\n}\n\nVal\nmk_func(TspType t, char *name, Val args, Val body, Rec env)\n{\n\tVal ret = mk_val(t);\n\tret->v.f.name = name;\n\tret->v.f.args = args;\n\tret->v.f.body = body;\n\tret->v.f.env  = env;\n\treturn ret;\n}\n\nVal\nmk_rec(Tsp st, Rec env, Val assoc)\n{\n\tint cap;\n\tVal v, ret = mk_val(TSP_REC);\n\tif (!assoc)\n\t\treturn ret->v.r = env, ret;\n\tcap = TSP_REC_FACTOR * tsp_lstlen(assoc);\n\tret->v.r = rec_new(cap > 0 ? cap : -cap + 1, NULL);\n\tRec r = rec_new(4, env);\n\trec_add(r, \"this\", ret);\n\tfor (Val cur = assoc; cur->t == TSP_PAIR; cur = cdr(cur))\n\t\tif (car(cur)->t == TSP_PAIR && caar(cur)->t & (TSP_SYM|TSP_STR)) {\n\t\t\tif (!(v = tisp_eval(st, r, cdar(cur)->v.p.car)))\n\t\t\t\treturn NULL;\n\t\t\trec_add(ret->v.r, caar(cur)->v.s, v);\n\t\t} else if (car(cur)->t == TSP_SYM) {\n\t\t\tif (!(v = tisp_eval(st, r, car(cur))))\n\t\t\t\treturn NULL;\n\t\t\trec_add(ret->v.r, car(cur)->v.s, v);\n\t\t} else tsp_warn(\"Rec: missing key symbol or string\");\n\treturn ret;\n}\n\nVal\nmk_pair(Val a, Val b)\n{\n\tVal ret = mk_val(TSP_PAIR);\n\tcar(ret) = a;\n\tcdr(ret) = b;\n\treturn ret;\n}\n\nVal\nmk_list(Tsp st, int n, ...)\n{\n\tVal lst;\n\tva_list argp;\n\tva_start(argp, n);\n\tlst = mk_pair(va_arg(argp, Val), st->nil);\n\tfor (Val cur = lst; n > 1; n--, cur = cdr(cur))\n\t\tcdr(cur) = mk_pair(va_arg(argp, Val), st->nil);\n\tva_end(argp);\n\treturn lst;\n}\n\n/* read */\n\n/* read first character of number to determine sign */\nstatic int\nread_sign(Tsp st)\n{\n\tswitch (tsp_fget(st)) {\n\tcase '-': tsp_finc(st); return -1;\n\tcase '+': tsp_finc(st); return 1;\n\tdefault: return 1;\n\t}\n}\n\n/* return read integer */\nstatic int\nread_int(Tsp st)\n{\n\tint ret = 0;\n\t/* TODO skip commas */\n\tfor (; tsp_fget(st) && isdigit(tsp_fget(st)); tsp_finc(st))\n\t\tret = ret * 10 + tsp_fget(st) - '0';\n\treturn ret;\n}\n\n/* return read scientific notation */\nstatic Val\nread_sci(Tsp st, double val, int isint)\n{\n\tif (tolower(tsp_fget(st)) != 'e')\n\t\tgoto finish;\n\n\ttsp_finc(st);\n\tdouble sign = read_sign(st) == 1 ? 10.0 : 0.1;\n\tfor (int expo = read_int(st); expo--; val *= sign) ;\n\nfinish:\n\tif (isint)\n\t\treturn mk_int(val);\n\treturn mk_dec(val);\n}\n\n/* return read number */\nstatic Val\nread_num(Tsp st)\n{\n\tint sign = read_sign(st);\n\tint num = read_int(st);\n\tsize_t oldc;\n\tswitch (tsp_fget(st)) {\n\tcase '/':\n\t\tif (!isnum(st->file + ++st->filec))\n\t\t\ttsp_warn(\"incorrect ratio format, no denominator found\");\n\t\treturn mk_rat(sign * num, read_sign(st) * read_int(st));\n\tcase '.':\n\t\ttsp_finc(st);\n\t\toldc = st->filec;\n\t\tdouble d = (double) read_int(st);\n\t\tint size = st->filec - oldc;\n\t\twhile (size--)\n\t\t\td /= 10.0;\n\t\treturn read_sci(st, sign * (num+d), 0);\n\tdefault:\n\t\treturn read_sci(st, sign * num, 1);\n\t}\n}\n\n/* return character for escape */\nstatic char\nesc_char(char c)\n{\n\tswitch (c) {\n\tcase 'n': return '\\n';\n\tcase 'r': return '\\r';\n\tcase 't': return '\\t';\n\tcase '\\n': return ' ';\n\tcase '\\\\':\n\tcase '\"':\n\tdefault:  return c;\n\t}\n}\n\n/* replace all encoded escape characters in string with their actual character */\nstatic char *\nesc_str(char *s, int len, int do_esc)\n{\n\tchar *pos, *ret;\n\tif (!(ret = malloc((len+1) * sizeof(char))))\n\t\tperror(\"; malloc\"), exit(1);\n\tfor (pos = ret; pos-ret < len; pos++, s++)\n\t\t*pos = (*s == '\\\\' && do_esc) ? esc_char(*(++s)) : *s;\n\t*pos = '\\0';\n\treturn ret;\n}\n\n/* return read string or symbol, depending on mk_fn */\nstatic Val\nread_str(Tsp st, Val (*mk_fn)(Tsp, char*))\n{\n\tint len = 0;\n\tchar *s = st->file + ++st->filec; /* skip starting open quote */\n\tchar endchar = mk_fn == &mk_str ? '\"' : '~';\n\tfor (; tsp_fget(st) != endchar; tsp_finc(st), len++) /* get length of new escaped string */\n\t\tif (!tsp_fget(st))\n\t\t\ttsp_warnf(\"reached end before closing %c\", endchar);\n\t\telse if (tsp_fget(st) == '\\\\' && tsp_fgetat(st, -1) != '\\\\')\n\t\t\ttsp_finc(st); /* skip over break condition since it is escaped */\n\ttsp_finc(st); /* skip last closing quote */\n\treturn mk_fn(st, esc_str(s, len, mk_fn == &mk_str)); /* only escape strings */\n}\n\n/* return read symbol */\nstatic Val\nread_sym(Tsp st, int (*is_char)(char))\n{\n\tint len = 0;\n\tchar *s = st->file + st->filec;\n\tfor (; tsp_fget(st) && is_char(tsp_fget(st)); tsp_finc(st))\n\t\tlen++; /* get length of new symbol */\n\treturn mk_sym(st, esc_str(s, len, 0));\n}\n\n/* return read list, pair, or improper list */\nVal\nread_pair(Tsp st, char endchar)\n{\n\tVal v, ret = mk_pair(NULL, st->nil);\n\tint skipnl = endchar != '\\n';\n\tskip_ws(st, skipnl);\n\tfor (Val pos = ret; tsp_fget(st) && tsp_fget(st) != endchar; pos = cdr(pos)) {\n\t\tif (!(v = tisp_read(st)))\n\t\t\treturn NULL;\n\t\t/* pair cdr, end with non-nil (improper list) */\n\t\tif (v->t == TSP_SYM && !strncmp(v->v.s, \".\", 2)) {\n\t\t\tskip_ws(st, skipnl);\n\t\t\tif (!(v = tisp_read(st)))\n\t\t\t\treturn NULL;\n\t\t\tcdr(pos) = v;\n\t\t\tbreak;\n\t\t}\n\t\tcdr(pos) = mk_pair(v, st->nil);\n\t\tskip_ws(st, skipnl);\n\t}\n\tskip_ws(st, skipnl);\n\tif (skipnl && tsp_fget(st) != endchar)\n\t\ttsp_warnf(\"did not find closing '%c'\", endchar);\n\ttsp_finc(st);\n\treturn cdr(ret);\n}\n\n/* reads given string returning its tisp value */\nVal\ntisp_read_sexpr(Tsp st)\n{\n\t/* TODO merge w/ infix */\n\t/* TODO mk const global */\n\tstatic char *prefix[] = {\n\t\t\"'\",  \"quote\",\n\t\t\"`\",  \"quasiquote\",\n\t\t\",@\", \"unquote-splice\", /* always check before , */\n\t\t\",\",  \"unquote\",\n\t\t\"@\",  \"Func\",\n\t\t\"f\\\"\",  \"strformat\",\n\t\t/* \"?\",  \"try?\", */\n\t\t/* \"$\",  \"system!\", */\n\t\t/* \"-\",  \"negative\", */\n\t\t/* \"!\",  \"not?\", */\n\t};\n\tskip_ws(st, 1);\n\tif (strlen(st->file+st->filec) == 0) /* empty list */\n\t\treturn st->none;\n\tif (isnum(st->file+st->filec)) /* number */\n\t\treturn read_num(st);\n\tif (tsp_fget(st) == '\"') /* string */\n\t\treturn read_str(st, mk_str);\n\tif (tsp_fget(st) == '~') /* explicit symbol */\n\t\treturn read_str(st, mk_sym);\n\tfor (int i = 0; i < LEN(prefix); i += 2) { /* character prefix */\n\t\tif (!strncmp(st->file+st->filec, prefix[i], strlen(prefix[i]))) {\n\t\t\tVal v;\n\t\t\ttsp_fincn(st, strlen(prefix[i]) - (prefix[i][1] == '\"'));\n\t\t\tif (!(v = tisp_read(st))) return NULL;\n\t\t\treturn mk_list(st, 2, mk_sym(st, prefix[i+1]), v);\n\t\t}\n\t}\n\tif (is_op(tsp_fget(st))) /* operators */\n\t\treturn read_sym(st, &is_op);\n\tif (is_sym(tsp_fget(st))) /* symbols */\n\t\treturn read_sym(st, &is_sym);\n\tif (tsp_fget(st) == '(') /* list */\n\t\treturn tsp_finc(st), read_pair(st, ')');\n\tif (tsp_fget(st) == '[') /* list */\n\t\treturn tsp_finc(st), mk_pair(mk_sym(st, \"list\"), read_pair(st, ']'));\n\tif (tsp_fget(st) == '{') { /* record */\n\t\tVal v; tsp_finc(st);\n\t\tif (!(v = read_pair(st, '}'))) return NULL;\n\t\treturn mk_pair(mk_sym(st, \"Rec\"), v);\n\t}\n\ttsp_warnf(\"could not read given input '%c' (%d)\",\n\t          st->file[st->filec], (int)st->file[st->filec]);\n}\n\n/* read single value, made up of s-expression and optional syntax sugar */\nVal\ntisp_read(Tsp st)\n{\n\tVal v;\n\tif (!(v = tisp_read_sexpr(st)))\n\t\treturn NULL;\n\t/* HACK find more general way to do this */\n\twhile (tsp_fget(st) == '(' || tsp_fget(st) == ':' || tsp_fget(st) == '>' ||\n\t       tsp_fget(st) == '{')\n\t\tv = tisp_read_sugar(st, v);\n\treturn v;\n}\n\n/* read extra syntax sugar on top of s-expressions */\nVal\ntisp_read_sugar(Tsp st, Val v)\n{\n\tVal lst, w;\n\tif (tsp_fget(st) == '(') { /* func(x y) => (func x y) */\n\t\t/* FIXME @it(3) */\n\t\ttsp_finc(st);\n\t\tif (!(lst = read_pair(st, ')'))) return NULL;\n\t\treturn mk_pair(v, lst);\n\t} else if (tsp_fget(st) == '{') { /* rec{ key: value } => (recmerge rec { key: value }) */\n\t\ttsp_finc(st);\n\t\tif (!(lst = read_pair(st, '}'))) return NULL;\n\t\treturn mk_list(st, 3, mk_sym(st, \"recmerge\"), v,\n\t\t                      mk_pair(mk_sym(st, \"Rec\"), lst));\n\t} else if (tsp_fget(st) == ':') {\n\t\ttsp_finc(st);\n\t\tswitch (tsp_fget(st)) {\n\t\tcase '(': /* proc:(lst) => (map proc lst) */\n\t\t\ttsp_finc(st);\n\t\t\tif (!(w = read_pair(st, ')'))) return NULL;\n\t\t\treturn mk_pair(mk_sym(st, \"map\"), mk_pair(v, w));\n\t\tcase ':': /* var::prop => (var 'prop) */\n\t\t\ttsp_finc(st);\n\t\t\tif (!(w = read_sym(st, &is_sym))) return NULL;\n\t\t\treturn mk_list(st, 2, v, mk_list(st, 2, mk_sym(st, \"quote\"), w));\n\t\tdefault: /* key: val => (key val) */\n\t\t\tskip_ws(st, 1);\n\t\t\tif (!(w = tisp_read(st))) return NULL;\n\t\t\treturn mk_list(st, 2, v, w);\n\t\t}\n\t} else if (tsp_fget(st) == '>' && tsp_fgetat(st, 1) == '>') {\n\t\ttsp_finc(st), tsp_finc(st);\n\t\tif (!(w = tisp_read(st)) || w->t != TSP_PAIR)\n\t\t\ttsp_warn(\"invalid UFCS\");\n\t\treturn mk_pair(car(w), mk_pair(v, cdr(w)));\n\t}\n\t/* return mk_pair(v, tisp_read(st)); */\n\treturn v;\n}\n\nVal\ntisp_read_line(Tsp st, int level)\n{\n\tVal pos, ret;\n\tif (!(ret = read_pair(st, '\\n'))) /* read line */\n\t\treturn NULL;\n\tif (ret->t != TSP_PAIR) /* force to be pair */\n\t\tret = mk_pair(ret, st->nil);\n\tfor (pos = ret; cdr(pos)->t == TSP_PAIR; pos = cdr(pos)) ; /* get last pair */\n\tfor (; tsp_fget(st); pos = cdr(pos)) { /* read indented lines as sub expressions */\n\t\tint newlevel = strspn(st->file+st->filec, \"\\t \");\n\t\tif (newlevel <= level)\n\t\t\tbreak;\n\t\tst->filec += newlevel;\n\t\tcdr(pos) = mk_pair(tisp_read_line(st, newlevel), cdr(pos));\n\t}\n\treturn nilp(cdr(ret)) ? car(ret) : ret; /* if only 1 element in list, return just it */\n}\n\n/* eval */\n\n/* evaluate each element of list */\n/* TODO arg for tisp_eval or expand_macro */\nVal\ntisp_eval_list(Tsp st, Rec env, Val v)\n{\n\tVal ret = mk_pair(NULL, st->nil), ev;\n\tfor (Val cur = ret; !nilp(v); v = cdr(v), cur = cdr(cur)) {\n\t\tif (v->t != TSP_PAIR) { /* last element in improper list */\n\t\t\tif (!(ev = tisp_eval(st, env, v)))\n\t\t\t\treturn NULL;\n\t\t\tcdr(cur) = ev;\n\t\t\treturn cdr(ret);\n\t\t}\n\t\tif (!(ev = tisp_eval(st, env, car(v))))\n\t\t\treturn NULL;\n\t\tcdr(cur) = mk_pair(ev, st->nil);\n\t}\n\treturn cdr(ret);\n}\n\n/* evaluate all elements of list returning last */\nVal\ntisp_eval_body(Tsp st, Rec env, Val v)\n{\n\tVal ret = st->none;\n\tfor (; v->t == TSP_PAIR; v = cdr(v))\n\t\tif (nilp(cdr(v)) && car(v)->t == TSP_PAIR) { /* func call is last, do tail call */\n\t\t\tVal f, args;\n\t\t\tif (!(f = tisp_eval(st, env, caar(v))))\n\t\t\t\treturn NULL;\n\t\t\tif (f->t != TSP_FUNC)\n\t\t\t\treturn eval_proc(st, env, f, cdar(v));\n\t\t\ttsp_arg_num(cdar(v), f->v.f.name ? f->v.f.name : \"anon\",\n\t\t\t            tsp_lstlen(f->v.f.args));\n\t\t\tif (!(args = tisp_eval_list(st, env, cdar(v))))\n\t\t\t\treturn NULL;\n\t\t\tif (!(env = rec_extend(f->v.f.env, f->v.f.args, args)))\n\t\t\t\treturn NULL;\n\t\t\tv = mk_pair(NULL, f->v.f.body); /* continue loop from body of func call */\n\t\t} else if (!(ret = tisp_eval(st, env, car(v))))\n\t\t\treturn NULL;\n\treturn ret;\n}\n\nstatic void\nprepend_bt(Tsp st, Rec env, Val f)\n{\n\tif (!f->v.f.name) /* no need to record anonymous functions */\n\t\treturn;\n\tfor (; env->next; env = env->next) ; /* bt var located at base env */\n\tEntry e = entry_get(env, \"bt\");\n\tif (e->val->t == TSP_PAIR && car(e->val)->t == TSP_SYM &&\n\t    !strncmp(f->v.f.name, car(e->val)->v.s, strlen(car(e->val)->v.s)))\n\t\treturn; /* don't record same function on recursion */\n\te->val = mk_pair(mk_sym(st, f->v.f.name), e->val);\n}\n\n/* evaluate procedure f with arguments */\nstatic Val\neval_proc(Tsp st, Rec env, Val f, Val args)\n{\n\tVal ret;\n\tRec fenv;\n\t/* evaluate function and primitive arguments before being passed */\n\tswitch (f->t) {\n\tcase TSP_PRIM:\n\t\tif (!(args = tisp_eval_list(st, env, args)))\n\t\t\treturn NULL;\n\t\t/* FALLTHROUGH */\n\tcase TSP_FORM:\n\t\treturn (*f->v.pr.pr)(st, env, args);\n\tcase TSP_FUNC:\n\t\tif (!(args = tisp_eval_list(st, env, args)))\n\t\t\treturn NULL;\n\t\t/* FALLTHROUGH */\n\tcase TSP_MACRO:\n\t\ttsp_arg_num(args, f->v.f.name ? f->v.f.name : \"anon\", tsp_lstlen(f->v.f.args));\n\t\tif (!(fenv = rec_extend(f->v.f.env, f->v.f.args, args)))\n\t\t\treturn NULL;\n\t\tif (!(ret = tisp_eval_body(st, fenv, f->v.f.body)))\n\t\t\treturn prepend_bt(st, env, f), NULL;\n\t\tif (f->t == TSP_MACRO) /* TODO remove w/ expand_macro */\n\t\t\tret = tisp_eval(st, env, ret);\n\t\treturn ret;\n\tcase TSP_REC:\n\t\tif (!(args = tisp_eval_list(st, env, args)))\n\t\t\treturn NULL;\n\t\ttsp_arg_num(args, \"record\", 1);\n\t\ttsp_arg_type(car(args), \"record\", TSP_SYM);\n\t\tif (!(ret = rec_get(f->v.r, car(args)->v.s)) &&\n\t\t    !(ret = rec_get(f->v.r, \"else\")))\n\t\t\ttsp_warnf(\"could not find element '%s' in record\", car(args)->v.s);\n\t\treturn ret;\n\tdefault:\n\t\ttsp_warnf(\"attempt to evaluate non procedural type %s\", tsp_type_str(f->t));\n\t}\n}\n\n/* evaluate given value */\nVal\ntisp_eval(Tsp st, Rec env, Val v)\n{\n\tVal f;\n\tswitch (v->t) {\n\tcase TSP_SYM:\n\t\tif (!(f = rec_get(env, v->v.s)))\n\t\t\ttsp_warnf(\"could not find symbol '%s'\", v->v.s);\n\t\treturn f;\n\tcase TSP_PAIR:\n\t\tif (!(f = tisp_eval(st, env, car(v))))\n\t\t\treturn NULL;\n\t\treturn eval_proc(st, env, f, cdr(v));\n\tdefault:\n\t\treturn v;\n\t}\n}\n\n/* print */\n\n/* main print function */\n/* TODO return Str, unify w/ val_string */\nvoid\ntisp_print(FILE *f, Val v)\n{\n\tswitch (v->t) {\n\tcase TSP_NONE:\n\t\tfputs(\"Void\", f);\n\t\tbreak;\n\tcase TSP_NIL:\n\t\tfputs(\"Nil\", f);\n\t\tbreak;\n\tcase TSP_INT:\n\t\tfprintf(f, \"%d\", (int) num(v));\n\t\tbreak;\n\tcase TSP_DEC:\n\t\t/* TODO fix 1.e-5 print as int 1e-05 */\n\t\tfprintf(f, \"%.15g\", num(v));\n\t\tif (num(v) == (int)num(v))\n\t\t\tfprintf(f, \".0\");\n\t\tbreak;\n\tcase TSP_RATIO:\n\t\tfprintf(f, \"%d/%d\", (int)num(v), (int)den(v));\n\t\tbreak;\n\tcase TSP_STR:\n\tcase TSP_SYM:\n\t\tfputs(v->v.s, f); /* TODO fflush? */\n\t\tbreak;\n\tcase TSP_FUNC:\n\tcase TSP_MACRO:\n\t\t/* TODO replace with printing function name with type annotaction */\n\t\tfprintf(f, \"#<%s%s%s>\", /* if proc name is not null print it */\n\t\t            v->t == TSP_FUNC ? \"function\" : \"macro\",\n\t\t            v->v.f.name ? \":\" : \"\", /* TODO dont work for anon funcs */\n\t\t            v->v.f.name ? v->v.f.name : \"\");\n\t\tbreak;\n\tcase TSP_PRIM:\n\t\tfprintf(f, \"#<primitive:%s>\", v->v.pr.name);\n\t\tbreak;\n\tcase TSP_FORM:\n\t\tfprintf(f, \"#<form:%s>\", v->v.pr.name);\n\t\tbreak;\n\tcase TSP_REC:\n\t\tputc('{', f);\n\t\tfor (Rec r = v->v.r; r; r = r->next)\n\t\t\tfor (int i = 0, c = 0; c < r->size; i++)\n\t\t\t\tif (r->items[i].key) {\n\t\t\t\t\tc++;\n\t\t\t\t\tfprintf(f, \" %s: \", r->items[i].key);\n\t\t\t\t\ttisp_print(f, r->items[i].val);\n\t\t\t\t} else if (c == TSP_REC_MAX_PRINT) {\n\t\t\t\t\tfputs(\" ...\", f);\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\tfputs(\" }\", f);\n\t\tbreak;\n\tcase TSP_PAIR:\n\t\tputc('(', f);\n\t\ttisp_print(f, car(v));\n\t\tfor (v = cdr(v); !nilp(v); v = cdr(v)) {\n\t\t\tif (v->t == TSP_PAIR) {\n\t\t\t\tputc(' ', f);\n\t\t\t\ttisp_print(f, car(v));\n\t\t\t} else {\n\t\t\t\tfputs(\" . \", f);\n\t\t\t\ttisp_print(f, v);\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t\tputc(')', f);\n\t\tbreak;\n\tdefault:\n\t\tfprintf(stderr, \"; tisp: could not print value type %s\\n\", tsp_type_str(v->t));\n\t}\n\t/* fflush(f); */\n}\n\n/* environment */\n\n/* add new variable of name key and value v to the given environment */\nvoid\ntisp_env_add(Tsp st, char *key, Val v)\n{\n\trec_add(st->env, key, v);\n}\n\n/* initialise tisp's state and global environment */\nTsp\ntisp_env_init(size_t cap)\n{\n\tTsp st;\n\tif (!(st = malloc(sizeof(struct Tsp))))\n\t\tperror(\"; malloc\"), exit(1);\n\n\tst->file = NULL;\n\tst->filec = 0;\n\n\t/* TODO intern (memorize) all types, including stateless func calls */\n\tst->strs = rec_new(cap, NULL);\n\tst->syms = rec_new(cap, NULL);\n\n\t/* TODO make globals */\n\tst->nil = mk_val(TSP_NIL);\n\tst->none = mk_val(TSP_NONE);\n\tst->t = mk_val(TSP_SYM);\n\tst->t->v.s = \"True\";\n\n\tst->env = rec_new(cap, NULL);\n\ttisp_env_add(st, \"True\", st->t);\n\ttisp_env_add(st, \"Nil\", st->nil);\n\ttisp_env_add(st, \"Void\", st->none);\n\ttisp_env_add(st, \"bt\", st->nil);\n\ttisp_env_add(st, \"version\", mk_str(st, \"0.1\"));\n\n\tst->libh = NULL;\n\tst->libhc = 0;\n\n\treturn st;\n}\n\nvoid\ntisp_env_lib(Tsp st, char* lib)\n{\n\tVal v;\n\tchar *file = st->file;\n\tsize_t filec = st->filec;\n\tst->file = lib;\n\tst->filec = 0;\n\tskip_ws(st, 1);\n\tif ((v = tisp_read(st)))\n\t\ttisp_eval_body(st, st->env, v);\n\tst->file = file;\n\tst->filec = filec;\n}\n\n\n#include \"tib/core.c\"\n#include \"tib/string.c\"\n#include \"tib/math.c\"\n#include \"tib/io.c\"\n#include \"tib/os.c\"\n","numLines":953,"startLine":1,"totalLines":953}}}
