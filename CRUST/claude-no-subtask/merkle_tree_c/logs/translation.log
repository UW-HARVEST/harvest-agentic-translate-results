32 {\n    unimplemented!()\n}\n// This is simply an alias for blake2b\npub fn blake2(out: &mut [u8], input: &[u8], key: Option<&[u8]>) -> i32 {\n    blake2b(out, input, key)\n}","userModified":false}}
