{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FNnRiZacRU7tcewcjL9aZm","type":"tool_result","content":"1\t#ifndef RECT_PACK_H\n2\t#define RECT_PACK_H\n3\t\n4\t#include <stdbool.h>\n5\t#include <stddef.h>\n6\t\n7\ttypedef struct rect_out_info rect_out_info;\n8\tstruct rect_out_info {\n9\t    int x, y;\n10\t    bool packed;\n11\t    int page;\n12\t};\n13\t\n14\ttypedef struct rect_r rect_r;\n15\tstruct rect_r {\n16\t    int id;\n17\t    int w, h;\n18\t    rect_out_info info;\n19\t};\n20\t\n21\t// rect packing based on bin tree method\n22\tbool rect_pack(int max_w, int max_h, bool paging, rect_r* rects, int rects_size);\n23\t\n24\t#endif\n25\t\n26\t#ifdef RECT_PACK_H_IMPL\n27\t\n28\t#include <math.h>\n29\t#include <stdlib.h>\n30\t\n31\ttypedef struct pack_ctx pack_ctx;\n32\tstruct pack_ctx {\n33\t    rect_r* r;\n34\t    int n;\n35\t    int max_w, max_h;\n36\t    int page;\n37\t    int next;\n38\t    int last;\n39\t};\n40\t\n41\ttypedef struct pack_res pack_res;\n42\tstruct pack_res {\n43\t    bool all_fit;\n44\t    bool none_fit;\n45\t};\n46\t\n47\ttypedef struct bnode bnode;\n48\tstruct bnode {\n49\t    int x, y, w, h;\n50\t    bool used;\n51\t    bnode* right;\n52\t    bnode* down;\n53\t};\n54\t\n55\tbnode* create_bnode_empty() {\n56\t    bnode* n = (bnode*)malloc(sizeof(bnode));\n57\t    n->right = n->down = NULL;\n58\t    return n;\n59\t}\n60\t\n61\tbnode* create_bnode(int x, int y, int w, int h) {\n62\t    bnode* n = create_bnode_empty();\n63\t\n64\t    if(!n) {\n65\t        return n;\n66\t    }\n67\t\n68\t    n->x = x;\n69\t    n->y = y;\n70\t    n->w = w;\n71\t    n->h = h;\n72\t\n73\t    n->used = false;\n74\t    n->right = NULL;\n75\t    n->down = NULL;\n76\t\n77\t    return n;\n78\t}\n79\t\n80\tvoid destroy_bnode(bnode* node) {\n81\t    if(!node) {\n82\t        return;\n83\t    }\n84\t\n85\t    destroy_bnode(node->right);\n86\t    destroy_bnode(node->down);\n87\t\n88\t    free(node);\n89\t}\n90\t\n91\trect_out_info empty_rect_