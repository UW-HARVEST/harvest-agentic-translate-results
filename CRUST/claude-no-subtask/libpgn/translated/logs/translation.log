 += str[cursor] == '{';\n54\t        right_brace_count += str[cursor] == '}';\n55\t\n56\t        if (right_brace_count == left_brace_count) {\n57\t            break;\n58\t        }\n59\t\n60\t        pgn_buffer_append(comment.value, str[cursor]);\n61\t        cursor++;\n62\t    }\n63\t\n64\t    assert(str[cursor++] == '}');\n65\t    pgn_buffer_append_null_terminator(comment.value);\n66\t\n67\t    *consumed += cursor;\n68\t    return comment;\n69\t}\n70\t\n71\tvoid pgn_comment_cleanup(pgn_comment_t *comment)\n72\t{\n73\t    pgn_buffer_cleanup(comment->value);\n74\t}\n75\t\n76\tpgn_comments_t *pgn_comments_init(void)\n77\t{\n78\t    pgn_comments_t *comments = malloc(sizeof *comments);\n79\t    comments->values = malloc((sizeof *comments->values) * PGN_COMMENTS_INITIAL_SIZE);\n80\t    comments->size = PGN_COMMENTS_INITIAL_SIZE;\n81\t    comments->length = 0;\n82\t    return comments;\n83\t}\n84\t\n85\tvoid pgn_comments_push(pgn_comments_t *comments, pgn_comment_t comment)\n86\t{\n87\t    if (comments->length >= comments->size) {\n88\t        comments->size += PGN_COMMENTS_GROW_SIZE;\n89\t        comments->values = realloc(comments->values, (sizeof *comments->values) * comments->size);\n90\t    }\n91\t\n92\t    comments->values[comments->length++] = comment;\n93\t}\n94\t\n95\tsize_t pgn_comments_poll(pgn_comments_t **comments, pgn_comment_position_t pos, char *str)\n96\t{\n97\t    size_t cursor = 0;\n98\t\n99\t    if (str[cursor] == '{') {\n100\t        if (!*comments) *comments = pgn_comments_init();\n101\t\n102\t        while (str[cursor] == '{') {\n103\t            pgn_comment_t comment = __pgn_comment_from_string(str + cursor, &cursor);\n104\t            comment.position = pos;\n105\t\n106\t            pgn_comments_push(*comments, comment);\n107\t            pgn_cursor_skip_whitespace(str, &cursor);\n108\t        }\n109\t\n110\t        assert(str[cursor] != '{');\n111\t        assert(str[cursor] != '}');\n112\t        pgn_cursor_skip_whitespace(str, &cursor);\n113\t    }\n114\t    \n115\t    return cursor;\n116\t}\n117\t\n118\tint pgn_comments_get_first_after_alternative_index(pgn_comments_t *comments)\n119\t{\n120\t    for (int i = 0; i < (int)comments->length; i++) {\n121\t        if (comments->values[i].position == PGN_COMMENT_POSITION_AFTER_ALTERNATIVE) {\n122\t            return i;\n123\t        }\n124\t    }\n125\t\n126\t    return -1;\n127\t}\n128\t\n129\tvoid pgn_comments_cleanup(pgn_comments_t *comments)\n130\t{\n131\t    for (size_t i = 0; i < comments->length; i++) {\n132\t        pgn_comment_cleanup(&comments->values[i]);\n133\t    }\n134\t\n135\t    free(comments->values);\n136\t    free(comments);\n137\t}\n138\t"}]},"parent_tool_use_id":null,"session_id":"bcebe6bd-c963-40ed-be88-2e37ac4063d1","uuid":"232df455-00a7-4fbe-8077-171111324249","timestamp":"2026-06-05T22:43:55.814Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-la4Zzu/project/c_src/comments.c","content":"/* libpgn - PGN file parser.\n * Copyright (C) 2024 youkwhd <lolywk@tutanota.com>\n *\n * This program is free software; you can redistribute it and/or modify\n * it under the terms of the GNU General Public License as published by\n * the Free Software Foundation; either version 2 of the License, or\n * (at your option) any later version.\n *\n * This program is distributed in the hope that it will be useful,\n * but WITHOUT ANY WARRANTY; without even the implied warranty of\n * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n * GNU General Public License for more details.\n *\n * You should have received a copy of the GNU General Public License along\n * with this program; if not, write to the Free Software Foundation, Inc.,\n * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n */\n\n#include <stdlib.h>\n#include <assert.h>\n\n#include \"comments.h\"\n#include \"utils/cursor.h\"\n#include \"utils/buffer.h\"\n\nvoid pgn_comment_init(pgn_comment_t *comment)\n{\n    comment->value = pgn_buffer_init();\n    comment->position = PGN_COMMENT_POSITION_UNKNOWN;\n}\n\nchar *pgn_comment_value(pgn_comment_t *comment)\n{\n    return comment->value->buf;\n}\n\npgn_comment_t __pgn_comment_from_string(char *str, size_t *consumed)\n{\n    size_t cursor = 0;\n    pgn_comment_t comment;\n    pgn_comment_init(&comment);\n\n    assert(str[cursor++] == '{');\n\n    unsigned int left_brace_count = 1, right_brace_count = 0; \n    while (true) {\n        /* TODO: how to error idk???\n         * maybe return corrupted err file idk wtf\n         */\n        if (str[cursor] == '\\0')\n            abort();\n\n        left_brace_count += str[cursor] == '{';\n        right_brace_count += str[cursor] == '}';\n\n        if (right_brace_count == left_brace_count) {\n            break;\n        }\n\n        pgn_buffer_append(comment.value, str[cursor]);\n        cursor++;\n    }\n\n    assert(str[cursor++] == '}');\n    pgn_buffer_append_null_terminator(comment.value);\n\n    *consumed += cursor;\n    return comment;\n}\n\nvoid pgn_comment_cleanup(pgn_comment_t *comment)\n{\n    pgn_buffer_cleanup(comment->value);\n}\n\npgn_comments_t *pgn_comments_init(void)\n{\n    pgn_comments_t *comments = malloc(sizeof *comments);\n    comments->values = malloc((sizeof *comments->values) * PGN_COMMENTS_INITIAL_SIZE);\n    comments->size = PGN_COMMENTS_INITIAL_SIZE;\n    comments->length = 0;\n    return comments;\n}\n\nvoid pgn_comments_push(pgn_comments_t *comments, pgn_comment_t comment)\n{\n    if (comments->length >= comments->size) {\n        comments->size += PGN_COMMENTS_GROW_SIZE;\n        comments->values = realloc(comments->values, (sizeof *comments->values) * comments->size);\n    }\n\n    comments->values[comments->length++] = comment;\n}\n\nsize_t pgn_comments_poll(pgn_comments_t **comments, pgn_comment_position_t pos, char *str)\n{\n    size_t cursor = 0;\n\n    if (str[cursor] == '{') {\n        if (!*comments) *comments = pgn_comments_init();\n\n        while (str[cursor] == '{') {\n            pgn_comment_t comment = __pgn_comment_from_string(str + cursor, &cursor);\n            comment.position = pos;\n\n            pgn_comments_push(*comments, comment);\n            pgn_cursor_skip_whitespace(str, &cursor);\n        }\n\n        assert(str[cursor] != '{');\n        assert(str[cursor] != '}');\n        pgn_cursor_skip_whitespace(str, &cursor);\n    }\n    \n    return cursor;\n}\n\nint pgn_comments_get_first_after_alternative_index(pgn_comments_t *comments)\n{\n    for (int i = 0; i < (int)comments->length; i++) {\n        if (comments->values[i].position == PGN_COMMENT_POSITION_AFTER_ALTERNATIVE) {\n            return i;\n        }\n    }\n\n    return -1;\n}\n\nvoid pgn_comments_cleanup(pgn_comments_t *comments)\n{\n    for (size_t i = 0; i < comments->length; i++) {\n        pgn_comment_cleanup(&comments->values[i]);\n    }\n\n    free(comments->values);\n    free(comments);\n}\n","numLines":138,"startLine":1,"totalLines":138}}}
