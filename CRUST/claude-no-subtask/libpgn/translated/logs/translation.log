635\t        ..Default::default()\n636\t    };\n637\t    assert_eq!(mv.to_string(), \"Re4\");\n638\t\n639\t    mv = PgnMove {\n640\t        annotation: PgnAnnotation::Unknown,\n641\t        piece: PgnPiece::Rook,\n642\t        check: PgnCheck::Mate,\n643\t        dest: PgnCoordinate {\n644\t            file: Some('e'),\n645\t            rank: Some(4),\n646\t        },\n647\t        ..Default::default()\n648\t    };\n649\t    assert_eq!(mv.to_string(), \"Re4#\");\n650\t\n651\t    mv = PgnMove {\n652\t        annotation: PgnAnnotation::Unknown,\n653\t        castles: PGN_CASTLING_KINGSIDE,\n654\t        check: PgnCheck::Mate,\n655\t        ..Default::default()\n656\t    };\n657\t    assert_eq!(mv.to_string(), \"O-O#\");\n658\t\n659\t    mv = PgnMove {\n660\t        annotation: PgnAnnotation::InterestingMove,\n661\t        piece: PgnPiece::Rook,\n662\t        dest: PgnCoordinate {\n663\t            file: Some('a'),\n664\t            rank: Some(3),\n665\t        },\n666\t        ..Default::default()\n667\t    };\n668\t    assert_eq!(mv.to_string(), \"Ra3!?\");\n669\t\n670\t    mv = PgnMove {\n671\t        annotation: PgnAnnotation::InterestingMove,\n672\t        en_passant: true,\n673\t        piece: PgnPiece::Pawn,\n674\t        dest: PgnCoordinate {\n675\t            file: Some('f'),\n676\t            rank: Some(3),\n677\t        },\n678\t        ..Default::default()\n679\t    };\n680\t    assert_eq!(mv.to_string(), \"f3!? e.p.\");\n681\t\n682\t    mv = PgnMove {\n683\t        annotation: PgnAnnotation::from(9),\n684\t        piece: PgnPiece::Pawn,\n685\t        dest: PgnCoordinate {\n686\t            file: Some('f'),\n687\t            rank: Some(3),\n688\t        },\n689\t        ..Default::default()\n690\t    };\n691\t    assert_eq!(mv.to_string(), \"f3 $9\");\n692\t\n693\t    mv = PgnMove {\n694\t        annotation: PgnAnnotation::from(9),\n695\t        en_passant: true,\n696\t        piece: PgnPiece::Pawn,\n697\t        dest: PgnCoordinate {\n698\t            file