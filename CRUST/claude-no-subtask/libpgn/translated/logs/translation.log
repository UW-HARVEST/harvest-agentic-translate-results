;\n264\t    assert_eq!(moves.values[0].black.captures, true);\n265\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::DubiousMove);\n266\t    assert!(moves.values[0].black.alternatives.is_some());\n267\t\n268\t    assert_eq!(\n269\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n270\t            .black\n271\t            .piece,\n272\t        PgnPiece::Pawn\n273\t    );\n274\t    assert_eq!(\n275\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n276\t            .black\n277\t            .dest\n278\t            .file,\n279\t        Some('e')\n280\t    );\n281\t    assert_eq!(\n282\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n283\t            .black\n284\t            .dest\n285\t            .rank,\n286\t        Some(5)\n287\t    );\n288\t    assert_eq!(\n289\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n290\t            .black\n291\t            .captures,\n292\t        false\n293\t    );\n294\t    assert_eq!(\n295\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n296\t            .black\n297\t            .annotation,\n298\t        PgnAnnotation::Unknown\n299\t    );\n300\t\n301\t    assert_eq!(\n302\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n303\t            .white\n304\t            .piece,\n305\t        PgnPiece::Pawn\n306\t    );\n307\t    assert_eq!(\n308\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n309\t            .white\n310\t            .dest\n311\t            .file,\n312\t        Some('e')\n313\t    );\n314\t    assert_eq!(\n315\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n316\t            .white\n317\t            .dest\n318\t            .rank,\n319\t        Some(4)\n320\t    );\n321\t    assert_eq!(\n322\t        moves.values[0].black.alternatives.as_ref().unwr