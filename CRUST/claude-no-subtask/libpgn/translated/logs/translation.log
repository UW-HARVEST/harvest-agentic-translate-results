   PgnCommentPosition::AfterMove\n246\t    );\n247\t    assert_eq!(\n248\t        moves.values[0].white.comments.as_ref().unwrap().values[1].value,\n249\t        \"from\"\n250\t    );\n251\t    assert_eq!(\n252\t        moves.values[0].white.comments.as_ref().unwrap().values[2].position,\n253\t        PgnCommentPosition::AfterMove\n254\t    );\n255\t    assert_eq!(\n256\t        moves.values[0].white.comments.as_ref().unwrap().values[2].value,\n257\t        \"libpgn\"\n258\t    );\n259\t\n260\t    moves = PgnMoves::from(\"1.e4 {dump} e5 { spaces does not get trimmed } { trim it with pgn_comment_trim() } {this makes the pgn file original -> } \");\n261\t    assert!(moves.values[0].white.comments.is_some());\n262\t    assert_eq!(\n263\t        moves.values[0]\n264\t            .white\n265\t            .comments\n266\t            .as_ref()\n267\t            .unwrap()\n268\t            .values\n269\t            .len(),\n270\t        1\n271\t    );\n272\t    assert_eq!(\n273\t        moves.values[0].white.comments.as_ref().unwrap().values[0].position,\n274\t        PgnCommentPosition::AfterMove\n275\t    );\n276\t    assert_eq!(\n277\t        moves.values[0].white.comments.as_ref().unwrap().values[0].value,\n278\t        \"dump\"\n279\t    );\n280\t    assert_eq!(\n281\t        moves.values[0]\n282\t            .black\n283\t            .comments\n284\t            .as_ref()\n285\t            .unwrap()\n286\t            .values\n287\t            .len(),\n288\t        3\n289\t    );\n290\t    assert_eq!(\n291\t        moves.values[0].black.comments.as_ref().unwrap().values[0].position,\n292\t        PgnCommentPosition::AfterMove\n293\t    );\n294\t    assert_eq!(\n295\t        moves.values[0].black.comments.as_ref().unwrap().values[0].value,\n296\t        \" spaces does not get trimmed \"\n297\t    );\n298\t    assert_eq!(\n299\t        moves.values[0].black.comments.as_ref().unwrap().values[1].position,\n300\t        PgnCommentPosition::AfterMove\n301\t    );\n302\t    ass