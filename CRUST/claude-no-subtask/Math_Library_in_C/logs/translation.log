ound(x: f64) -> f64 {\n    if x >= 0.0 {\n        castom_floor(x + 0.5)\n    } else {\n        castom_ceil(x - 0.5)\n    }\n}\n\nfn scale_pow2(k: i32) -> f64 {\n    // Construct 2^k as an f64. For k in [-1022, 1023] we can do it directly.\n    if k > 1023 {\n        // Split into two factors to avoid overflow in single bit construction.\n        let half = k / 2;\n        let rest = k - half;\n        scale_pow2(half) * scale_pow2(rest)\n    } else if k < -1022 {\n        let half = k / 2;\n        let rest = k - half;\n        scale_pow2(half) * scale_pow2(rest)\n    } else {\n        let bits: u64 = ((k + 1023) as u64) << 52;\n        f64::from_bits(bits)\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":999,"cache_read_input_tokens":44970,"cache_creation":{"ephemeral_5m_input_tokens":999,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"fe25e410-9d4f-4277-b969-cd449eeebe04","uuid":"058981d4-d75f-49d6-8457-3888fce855a5"}
