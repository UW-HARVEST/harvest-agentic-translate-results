* i + 1;\n        for j in 1..=limit {\n            fa *= j as f64;\n            pw *= x;\n        }\n        let sign = if i % 2 != 0 { -1.0 } else { 1.0 };\n        sum += (sign / fa) * pw;\n    }\n    sum\n}\n\npub fn castom_cos(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut t_s: f64 = 0.0;\n    let mut last: f64 = 1.0;\n    let mut k: i32 = 1;\n    while castom_fabs(last) > EPS_10 {\n        t_s += last;\n        last *= -x * x / ((2.0 * k as f64 - 1.0) * (2.0 * k as f64));\n        k += 1;\n        if k > 1_000_000 {\n            break;\n        }\n    }\n    t_s\n}\n\npub fn castom_fabs(x: f64) -> f64 {\n    if x > 0.0 { x } else { -x }\n}\n","structuredPatch":[{"oldStart":78,"oldLines":70,"newStart":78,"newLines":14,"lines":[" }"," "," pub fn castom_exp(x: f64) -> f64 {","-    // Edge cases","-    if x.is_nan() {","-        return f64::NAN;","-    }","-    if x == f64::INFINITY {","-        return f64::INFINITY;","-    }","-    if x == f64::NEG_INFINITY {","-        return 0.0;","-    }","-    // Argument reduction: exp(x) = 2^k * exp(r), where r in [-ln2/2, ln2/2].","-    // The C reference uses `long double` Taylor; we use f64 with reduction","-    // so the accumulated rounding error is small enough to match","-    // the tolerance EPS_6 against Rust's std `f64::exp`.","-    const LN2_HI: f64 = 6.93147180369123816490e-01;","-    const LN2_LO: f64 = 1.90821492927058770002e-10;","-    const INV_LN2: f64 = 1.44269504088896338700e+00;","-","-    let k = castom_round(x * INV_LN2);","-    let hi = x - k * LN2_HI;","-    let lo = k * LN2_LO;","-    let r = hi - lo;","-","-    // Taylor series for exp(r), r small","-    let mut sum: f64 = 1.0;","-    let mut cur: f64 = 1.0;","-    let mut n: u32 = 1;","-    while castom_fabs(cur) > 1e-18 && n < 50 {","-        cur *= r / (n as f64);","-        sum += cur;","-        n += 1;","-    }","-","-    // Multiply by 2^k. Use direct f64 bit construction when k is in range","-    // for reliable 