 = x;\n68\t    x->parent = y;\n69\t}\n70\t\n71\tvoid free_node(rbtree *t, node_t *x) {\n72\t  // 후위 순회 방식으로 RB Tree 내의 노드 메모리 반환\n73\t  if (x->left != t->nil) \n74\t    free_node(t, x->left);\n75\t  if (x->right != t->nil)\n76\t    free_node(t, x->right);\n77\t  free(x);\n78\t  x = NULL;\n79\t}\n80\t\n81\tvoid delete_rbtree(rbtree *t) {\n82\t  // TODO: reclaim the tree nodes's memory\n83\t  if (t->root != t->nil)\n84\t    free_node(t, t->root);\n85\t  free(t->nil);\n86\t  free(t);\n87\t}\n88\t\n89\tvoid rbtree_insert_fixup(rbtree *t, node_t *z) {\n90\t  node_t *y;\n91\t  \n92\t  while (z->parent->color == RBTREE_RED) {\n93\t    // z의 부모가 조부모의 왼쪽 서브 트리일 경우\n94\t    if (z->parent == z->parent->parent->left) {\n95\t      y = z->parent->parent->right;\n96\t      \n97\t      // CASE 1 : 노드 z의 삼촌 y가 적색인 경우\n98\t      if (y->color == RBTREE_RED) {\n99\t        z->parent->color = RBTREE_BLACK;\n100\t        y->color = RBTREE_BLACK;\n101\t        z->parent->parent->color = RBTREE_RED;\n102\t        z = z->parent->parent;\n103\t      }\n104\t      // CASE 2 : z의 삼촌 y가 흑색이며의 z가 오른쪽 자식인 경우\n105\t      else {\n106\t        if (z == z->parent->right) {\n107\t          z = z->parent;\n108\t          left_rotation(t, z);\n109\t        }\n110\t        // CASE 3 : z의 삼촌 y가 흑색이며의 z가 오른쪽 자식인 경우\n111\t        z->parent->color = RBTREE_BLACK;\n112\t        z->parent->parent->color = RBTREE_RED;\n113\t        right_rotation(t, z->parent->parent);\n114\t      }\n115\t    }\n116\t    // z의 부모가 조부모의 왼쪽 서브 트리일 경우\n117\t    else {\n118\t      y = z->parent->parent->left;\n119\t\n120\t      // CASE 4 : 노드 z의 삼촌 y가 적색인 경우\n121\t      if (y->color == RBTREE_RED) {\n122\t        z->parent->color = RBTREE_BLACK;\n123\t        y->color = RBTREE_BLACK;\n124\t        z->parent->parent->color = RBTREE_RED;\n125\t        z = z->parent->parent;\n126\t      }\n127\t      // CASE 5 : z의 삼촌 y가 흑색이며의 z가 오른쪽 자식인 경우\n128\t      else {\n129\t        if (z == z->parent->left) {\n130\t          z = z->parent;\n131\t          right_rotation(t, z);\n132\t        }\n133\t        // CASE 6 : z의 삼촌 y가 흑색이며의 z가 오른쪽 자식인 경우\n134\t        z->parent->color = RBTREE_BLACK;\n135\t        z->parent->parent->color = RBTREE_RED;\n136\t        left_rotation(t, z->parent->parent);\n137\t      }\n138\t    }\n139\t  }\n140\t  t->root->color = RBTREE_BLACK;\n141\t}\n142\t\n143\tnode_t *rbtree_insert(rbtree *t, const key_t key) {\n144\t  // TODO: implement insert\n145\t  node_t *y = t->nil;\n146\t  node_t *x = t->root;\n147\t  node_t *z = (node_t *)calloc(1, sizeof(node_t));\n148\t  \n149\t  z->key = key;\n150\t\n151\t  while (x != t->nil) {\n152\t    y = x;\n153\t    if (z->key < x->key)\n154\t      x = x->left;\n155\t    else\n156\t      x = x->right; \n157\t  }\n158\t\n159\t  z->parent = y;\n160\t  \n161\t  if (y == t->nil) {\n162\t    t->root = z;\n163\t  }\n164\t  else if (z->key < y->key) {\n165\t    y->left = z;\n166\t  }\n167\t  else {\n168\t    y->right = z;\n169\t  }\n170\t\n171\t  z->left = t->nil;\n172\t  z->right = t->nil;\n173\t  z->color = RBTREE_RED;\n174\t\n175\t  rbtree_insert_fixup(t, z);\n176\t\n177\t  return z;\n178\t}\n179\t\n180\tnode_t *rbtree_find(const rbtree *t, const key_t key) {\n181\t  // TODO: implement find\n182\t  node_t * current = t->root;\n183\t\n184\t  while (current != t->nil) {\n185\t    if (current->key == key)\n186\t      return current;\n187\t\n188\t    if (current->key < key) \n189\t      current = current->right;\n190\t    else\n191\t      current = current->left;\n192\t  }\n193\t\n194\t  return NULL;\n195\t}\n196\t\n197\tnode_t *rbtree_min(const rbtree *t) {\n198\t  // TODO: implement find\n199\t  if (t->root == t->nil) {\n200\t    return NULL;\n201\t  }\n202\t  node_t * curr = t->root;\n203\t\n204\t  while (curr->left != t->nil) {\n205\t    curr = curr->left;\n206\t  }\n207\t  return curr;\n208\t}\n209\t\n210\tnode_t *rbtree_max(const rbtree *t) {\n211\t  // TODO: implement find\n212\t  if (t->root == t->nil) {\n213\t    return NULL;\n214\t  }\n215\