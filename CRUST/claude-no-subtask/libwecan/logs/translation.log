t different magnitudes"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":576,"cache_read_input_tokens":73285,"cache_creation":{"ephemeral_5m_input_tokens":576,"ephemeral_1h_input_tokens":0},"output_tokens":23,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"688f5801-aa71-487e-9283-322720b01de6","uuid":"5a6755af-cc01-4f21-83c8-a9baf7d9128b"}
