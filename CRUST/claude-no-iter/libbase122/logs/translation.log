{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_012kwpVbKM8MGKwNJ55T34DU","type":"tool_result","content":"1\tuse libbase122::base122::{BitReader, BitWriter, decode, encode};\n2\tfn bitstring_to_bytes(bitstring: &str) -> Vec<u8> {\n3\t    let clean_bitstring = bitstring.replace(\" \", \"\");\n4\t    let chunks: Vec<&str> = clean_bitstring.as_bytes()\n5\t        .chunks(8)\n6\t        .map(|chunk| std::str::from_utf8(chunk).unwrap())\n7\t        .collect();\n8\t    \n9\t    chunks.iter()\n10\t        .map(|&chunk| {\n11\t            let mut byte = 0u8;\n12\t            for (i, bit) in chunk.chars().enumerate() {\n13\t                if bit == '1' {\n14\t                    byte |= 1 << (7 - i);\n15\t                }\n16\t            }\n17\t            byte\n18\t        })\n19\t        .collect()\n20\t}\n21\t\n22\tfn hexstring_to_bytes(hexstring: &str) -> Vec<u8> {\n23\t    let clean_hexstring = hexstring.replace(\" \", \"\");\n24\t    let mut bytes = Vec::new();\n25\t    \n26\t    for i in 0..clean_hexstring.len() / 2 {\n27\t        let byte_str = &clean_hexstring[i*2..i*2+2];\n28\t        let byte = u8::from_str_radix(byte_str, 16).unwrap();\n29\t        bytes.push(byte);\n30\t    }\n31\t    \n32\t    bytes\n33\t}\n34\t\n35\t#[test]\n36\tfn test_bit_reader() {\n37\t    // One byte test\n38\t    {\n39\t        let input = bitstring_to_bytes(\"11111111\");\n40\t        let mut reader = BitReader::new(&input);\n41\t        \n42\t        let (bits_read, value) = reader.read(7);\n43\t        assert_eq!(bits_read, 7, \"Expected to read 7 bits\");\n44\t        assert_eq!(value, 0x7F, \"Expected value to be 0x7F\");\n45\t        \n46\t        let (bits_read, value) = reader.read(7);\n47\t        assert_eq!(bits_read, 1, \"Expected to read 1 bit\");\n48\t        assert_eq!(value, 0x01, \"Expected value to be 0x01\");\n49\t        \n50\t        let (bits_read, value) = reader.read(7);\n51\t        assert_eq!(bits_read, 0, \"Expected to read 0 bits\");\n52\t        assert_eq!(value, 0x00, \"Expected value to be 0x00\");\n53\t    }\n54\t    \n55\t    // Two byte test\n56\t    {\n57\t        let input = bitstring_to_bytes(\"10101010 11111111\");\n58\t        let mut reader = BitReader::new(&input);\n59\t        \n60\t        let (bits_read, value) = reader.read(7);\n61\t        assert_eq!(bits_read, 7, \"Expected to read 7 bits\");\n62\t        assert_eq!(value, 0x55, \"Expected value to be 0x55\");\n63\t        \n64\t        let (bits_read, value) = reader.read(7);\n65\t        assert_eq!(bits_read, 7, \"Expected to read 7 bits\");\n66\t        assert_eq!(value, 0x3F, \"Expected value to be 0x3F\");\n67\t        \n68\t        let (bits_read, value) = reader.read(7);\n69\t        assert_eq!(bits_read, 2, \"Expected to read 2 bits\");\n70\t        assert_eq!(value, 0x03, \"Expected value to be 0x03\");\n71\t    }\n72\t}\n73\t\n74\t#[test]\n75\tfn test_bit_writer() {\n76\t    // One byte test\n77\t    {\n78\t        let mut output = [0u8; 1];\n79\t        {\n80\t            let mut writer = BitWriter::new(Some(&mut output), 1);\n81\t            let result = writer.write(1, 0x0F);\n82\t            assert!(result.is_ok(), \"Expected write to succeed\");\n83\t            let result = writer.write(1, 0x0F);\n84\t            assert!(result.is_ok(), \"Expected write to succeed\");\n85\t            let result = writer.write(5, 0x0F);\n86\t            assert!(result.is_ok(), \"Expected write to succeed\");\n87\t            let result = writer.write(5, 0x0F);\n88\t            assert!(result.is_err(), \"Expected write to fail due to insufficient space\");\n89\t        }\n90\t        assert_eq!(output[0], 0xDE, \"Expected output to be 0xDE\");\n91\t    }\n92\t    \n93\t    // Two byte test\n94\t    {\n95\t        let mut output = [0u8; 2];\n96\t        {\n97\t            let mut writer = BitWriter::new(Some(&mut output), 2);\n98\t            let result = writer.write(1, 0xFF);\n99\t            assert!(result.is_ok(), \"Expected write to succeed\");\n100\t            let result = writer.write(8, 0x0F);\n101\t            assert!(result.is_ok(), \"Expected write to succeed\");\n102\t            let result = writer.write(1, 0x00);\n103\t            assert!(result.is_ok(), \"Expected write to succeed\");\n104\t            let result = writer.write(1, 0xFF);\n105\t            assert!(result.is_ok(), \"Expected write to succeed\");\n106\t            let result = writer.write(5, 0xFF);\n107\t            assert!(result.is_ok(), \"Expected write to succeed\");\n108\t            let result = writer.write(5, 0xFF);\n109\t            assert!(result.is_err(), \"Expected write to fail due to insufficient space\");\n110\t        }\n111\t        assert_eq!(output, [0x87, 0xBF], \"Expected output to be [0x87, 0xBF]\");\n112\t    }\n113\t}\n114\t\n115\t#[test]\n116\tfn test_decode_error_cases() {\n117\t    // Test cases from the C implementation\n118\t    let test_cases = [\n119\t        (\"01111111 01111111 01111111\", \"Last byte has extra data\"),\n120\t        (\"11011110 11111111\", \"Second byte of two byte sequence malformed\"),\n121\t        (\"11111111\", \"First byte of two byte sequence malformed\"),\n122\t        (\"11011110\", \"Two byte sequence is missing second byte\"),\n123\t        (\"11011110 10111111 01111111\", \"Got unexpected extra data after shortened two byte sequence\"),\n124\t        (\"11011010 10111111\", \"Got unrecognized illegal index\"),\n125\t        (\"01111111\", \"Decoded data is not a byte multiple\"),\n126\t        (\"01111111 01111111\", \"Encoded data is malformed. Last byte has extra data.\"),\n127\t        (\"01111111 11011111 10100000\", \"Encoded data is malformed. Last byte has extra data.\"),\n128\t        (\"11011110 10000000\", \"Decoded data is not a byte multiple\"),\n129\t    ];\n130\t    \n131\t    for (encoded, expected_error) in test_cases.iter() {\n132\t        let input = bitstring_to_bytes(encoded);\n133\t        let result = decode(&input);\n134\t        assert!(result.is_err(), \"Expected decode to fail for input: {}\", encoded);\n135\t        let error = result.unwrap_err();\n136\t        assert!(error.message.contains(expected_error), \n137\t            \"Expected error message to contain '{}', got: '{}'\", \n138\t            expected_error, error.message);\n139\t    }\n140\t}\n141\t\n142\t#[test]\n143\tfn test_decode_success_cases() {\n144\t    let test_cases = [\n145\t        (\"01111111 11011110 10000000\", \"11111110\"),\n146\t        (\"00000000 11011110 10000000\", \"00000000\"),\n147\t        (\"00000000 11000010 10000000\", \"00000000 00000000\"),\n148\t        (\"11001111 10000001 01100000\", \"01000101 00000111\"),\n149\t    ];\n150\t    \n151\t    for (encoded, expected) in test_cases.iter() {\n152\t        let input = bitstring_to_bytes(encoded);\n153\t        let result = decode(&input);\n154\t        assert!(result.is_ok(), \"Expected decode to succeed for input: {}\", encoded);\n155\t        let decoded = result.unwrap();\n156\t        let expected_bytes = bitstring_to_bytes(expected);\n157\t        assert_eq!(decoded, expected_bytes, \n158\t            \"Decoded output does not match expected for input: {}\", encoded);\n159\t    }\n160\t}\n161\t\n162\t#[test]\n163\tfn test_encode_all_ones() {\n164\t    // Test encoding and decoding of sequences of all 1s of varying lengths\n165\t    for i in 0..=65 {\n166\t        let input: Vec<u8> = vec![0xFF; i];\n167\t        \n168\t        // Encode\n169\t        let encoded = encode(&input).expect(\"Failed to encode\");\n170\t        \n171\t        // Decode\n172\t        let decoded = decode(&encoded).expect(\"Failed to decode\");\n173\t        \n174\t        assert_eq!(decoded.len(), i, \"Decoded length mismatch\");\n175\t        assert_eq!(decoded, input, \"Decoded content mismatch\");\n176\t    }\n177\t}\n178\t\n179\t#[test]\n180\tfn test_roundtrip() {\n181\t    let tests = [\n182\t        (\"one byte\", \"11111111\", \"01111111 01000000\"),\n183\t        (\"several bytes\", \"10101010 10101010 10101010 10101010\", \n184\t            \"01010101 00101010 01010101 00101010 01010000\"),\n185\t        (\"illegal one byte\", \"00000000 11111111\", \"11000010 10111111 01100000\"),\n186\t        (\"illegal last two bits\", \"11111111 11111100\", \"01111111 01111111 11011110 10000000\"),\n187\t        (\"fuzz crash 1\", \"00010101\", \"11000111 10000000\"),\n188\t    ];\n189\t    \n190\t    for (description, data, encoded_expected) in tests.iter() {\n191\t        let input = bitstring_to_bytes(data);\n192\t        let expected_encoded = bitstring_to_bytes(encoded_expected);\n193\t        \n194\t        // Test encoding\n195\t        let encoded = encode(&input).expect(\"Failed to encode\");\n196\t        assert_eq!(encoded, expected_encoded, \n197\t            \"Encoded output does not match expected for test: {}\", description);\n198\t        \n199\t        // Test decoding\n200\t        let decoded = decode(&encoded).expect(\"Failed to decode\");\n201\t        assert_eq!(decoded, input, \n202\t            \"Decoded output does not match input for test: {}\", description);\n203\t    }\n204\t}\n205\t\n206\t#[test]\n207\t#[ignore] // Ignore this test if you don't have the example files\n208\tfn test_encode_file() {\n209\t    use std::fs::read;\n210\t    \n211\t    let data = read(\"../data/example.jpg\").expect(\"Failed to read example.jpg\");\n212\t    let expected = read(\"../data/example.b122\").expect(\"Failed to read example.b122\");\n213\t    \n214\t    // Test encoding\n215\t    let encoded = encode(&data).expect(\"Failed to encode\");\n216\t    assert_eq!(encoded, expected, \"Encoded file does not match expected\");\n217\t    \n218\t    // Test decoding\n219\t    let decoded = decode(&encoded).expect(\"Failed to decode\");\n220\t    assert_eq!(decoded, data, \"Decoded file does not match original\");\n221\t}\n222\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"8bcafca6-df8a-4214-b459-379c5c7b268e","uuid":"734f86ad-8fd5-478a-99bf-cee6219dfcf3","timestamp":"2026-06-03T03:29:19.246Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-Avbtgn/project/src/bin/tests.rs","content":"use libbase122::base122::{BitReader, BitWriter, decode, encode};\nfn bitstring_to_bytes(bitstring: &str) -> Vec<u8> {\n    let clean_bitstring = bitstring.replace(\" \", \"\");\n    let chunks: Vec<&str> = clean_bitstring.as_bytes()\n        .chunks(8)\n        .map(|chunk| std::str::from_utf8(chunk).unwrap())\n        .collect();\n    \n    chunks.iter()\n        .map(|&chunk| {\n            let mut byte = 0u8;\n            for (i, bit) in chunk.chars().enumerate() {\n                if bit == '1' {\n                    byte |= 1 << (7 - i);\n                }\n            }\n            byte\n        })\n        .collect()\n}\n\nfn hexstring_to_bytes(hexstring: &str) -> Vec<u8> {\n    let clean_hexstring = hexstring.replace(\" \", \"\");\n    let mut bytes = Vec::new();\n    \n    for i in 0..clean_hexstring.len() / 2 {\n        let byte_str = &clean_hexstring[i*2..i*2+2];\n        let byte = u8::from_str_radix(byte_str, 16).unwrap();\n        bytes.push(byte);\n    }\n    \n    bytes\n}\n\n#[test]\nfn test_bit_reader() {\n    // One byte test\n    {\n        let input = bitstring_to_bytes(\"11111111\");\n        let mut reader = BitReader::new(&input);\n        \n        let (bits_read, value) = reader.read(7);\n        assert_eq!(bits_read, 7, \"Expected to read 7 bits\");\n        assert_eq!(value, 0x7F, \"Expected value to be 0x7F\");\n        \n        let (bits_read, value) = reader.read(7);\n        assert_eq!(bits_read, 1, \"Expected to read 1 bit\");\n        assert_eq!(value, 0x01, \"Expected value to be 0x01\");\n        \n        let (bits_read, value) = reader.read(7);\n        assert_eq!(bits_read, 0, \"Expected to read 0 bits\");\n        assert_eq!(value, 0x00, \"Expected value to be 0x00\");\n    }\n    \n    // Two byte test\n    {\n        let input = bitstring_to_bytes(\"10101010 11111111\");\n        let mut reader = BitReader::new(&input);\n        \n        let (bits_read, value) = reader.read(7);\n        assert_eq!(bits_read, 7, \"Expected to read 7 bits\");\n        assert_eq!(value, 0x55, \"Expected value to be 0x55\");\n        \n        let (bits_read, value) = reader.read(7);\n        assert_eq!(bits_read, 7, \"Expected to read 7 bits\");\n        assert_eq!(value, 0x3F, \"Expected value to be 0x3F\");\n        \n        let (bits_read, value) = reader.read(7);\n        assert_eq!(bits_read, 2, \"Expected to read 2 bits\");\n        assert_eq!(value, 0x03, \"Expected value to be 0x03\");\n    }\n}\n\n#[test]\nfn test_bit_writer() {\n    // One byte test\n    {\n        let mut output = [0u8; 1];\n        {\n            let mut writer = BitWriter::new(Some(&mut output), 1);\n            let result = writer.write(1, 0x0F);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(1, 0x0F);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(5, 0x0F);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(5, 0x0F);\n            assert!(result.is_err(), \"Expected write to fail due to insufficient space\");\n        }\n        assert_eq!(output[0], 0xDE, \"Expected output to be 0xDE\");\n    }\n    \n    // Two byte test\n    {\n        let mut output = [0u8; 2];\n        {\n            let mut writer = BitWriter::new(Some(&mut output), 2);\n            let result = writer.write(1, 0xFF);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(8, 0x0F);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(1, 0x00);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(1, 0xFF);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(5, 0xFF);\n            assert!(result.is_ok(), \"Expected write to succeed\");\n            let result = writer.write(5, 0xFF);\n            assert!(result.is_err(), \"Expected write to fail due to insufficient space\");\n        }\n        assert_eq!(output, [0x87, 0xBF], \"Expected output to be [0x87, 0xBF]\");\n    }\n}\n\n#[test]\nfn test_decode_error_cases() {\n    // Test cases from the C implementation\n    let test_cases = [\n        (\"01111111 01111111 01111111\", \"Last byte has extra data\"),\n        (\"11011110 11111111\", \"Second byte of two byte sequence malformed\"),\n        (\"11111111\", \"First byte of two byte sequence malformed\"),\n        (\"11011110\", \"Two byte sequence is missing second byte\"),\n        (\"11011110 10111111 01111111\", \"Got unexpected extra data after shortened two byte sequence\"),\n        (\"11011010 10111111\", \"Got unrecognized illegal index\"),\n        (\"01111111\", \"Decoded data is not a byte multiple\"),\n        (\"01111111 01111111\", \"Encoded data is malformed. Last byte has extra data.\"),\n        (\"01111111 11011111 10100000\", \"Encoded data is malformed. Last byte has extra data.\"),\n        (\"11011110 10000000\", \"Decoded data is not a byte multiple\"),\n    ];\n    \n    for (encoded, expected_error) in test_cases.iter() {\n        let input = bitstring_to_bytes(encoded);\n        let result = decode(&input);\n        assert!(result.is_err(), \"Expected decode to fail for input: {}\", encoded);\n        let error = result.unwrap_err();\n        assert!(error.message.contains(expected_error), \n            \"Expected error message to contain '{}', got: '{}'\", \n            expected_error, error.message);\n    }\n}\n\n#[test]\nfn test_decode_success_cases() {\n    let test_cases = [\n        (\"01111111 11011110 10000000\", \"11111110\"),\n        (\"00000000 11011110 10000000\", \"00000000\"),\n        (\"00000000 11000010 10000000\", \"00000000 00000000\"),\n        (\"11001111 10000001 01100000\", \"01000101 00000111\"),\n    ];\n    \n    for (encoded, expected) in test_cases.iter() {\n        let input = bitstring_to_bytes(encoded);\n        let result = decode(&input);\n        assert!(result.is_ok(), \"Expected decode to succeed for input: {}\", encoded);\n        let decoded = result.unwrap();\n        let expected_bytes = bitstring_to_bytes(expected);\n        assert_eq!(decoded, expected_bytes, \n            \"Decoded output does not match expected for input: {}\", encoded);\n    }\n}\n\n#[test]\nfn test_encode_all_ones() {\n    // Test encoding and decoding of sequences of all 1s of varying lengths\n    for i in 0..=65 {\n        let input: Vec<u8> = vec![0xFF; i];\n        \n        // Encode\n        let encoded = encode(&input).expect(\"Failed to encode\");\n        \n        // Decode\n        let decoded = decode(&encoded).expect(\"Failed to decode\");\n        \n        assert_eq!(decoded.len(), i, \"Decoded length mismatch\");\n        assert_eq!(decoded, input, \"Decoded content mismatch\");\n    }\n}\n\n#[test]\nfn test_roundtrip() {\n    let tests = [\n        (\"one byte\", \"11111111\", \"01111111 01000000\"),\n        (\"several bytes\", \"10101010 10101010 10101010 10101010\", \n            \"01010101 00101010 01010101 00101010 01010000\"),\n        (\"illegal one byte\", \"00000000 11111111\", \"11000010 10111111 01100000\"),\n        (\"illegal last two bits\", \"11111111 11111100\", \"01111111 01111111 11011110 10000000\"),\n        (\"fuzz crash 1\", \"00010101\", \"11000111 10000000\"),\n    ];\n    \n    for (description, data, encoded_expected) in tests.iter() {\n        let input = bitstring_to_bytes(data);\n        let expected_encoded = bitstring_to_bytes(encoded_expected);\n        \n        // Test encoding\n        let encoded = encode(&input).expect(\"Failed to encode\");\n        assert_eq!(encoded, expected_encoded, \n            \"Encoded output does not match expected for test: {}\", description);\n        \n        // Test decoding\n        let decoded = decode(&encoded).expect(\"Failed to decode\");\n        assert_eq!(decoded, input, \n            \"Decoded output does not match input for test: {}\", description);\n    }\n}\n\n#[test]\n#[ignore] // Ignore this test if you don't have the example files\nfn test_encode_file() {\n    use std::fs::read;\n    \n    let data = read(\"../data/example.jpg\").expect(\"Failed to read example.jpg\");\n    let expected = read(\"../data/example.b122\").expect(\"Failed to read example.b122\");\n    \n    // Test encoding\n    let encoded = encode(&data).expect(\"Failed to encode\");\n    assert_eq!(encoded, expected, \"Encoded file does not match expected\");\n    \n    // Test decoding\n    let decoded = decode(&encoded).expect(\"Failed to decode\");\n    assert_eq!(decoded, data, \"Decoded file does not match original\");\n}\nfn main(){}","numLines":222,"startLine":1,"totalLines":222}}}
