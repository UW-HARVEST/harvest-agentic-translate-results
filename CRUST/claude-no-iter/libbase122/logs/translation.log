e122Error)` - If there was an error during encoding\npub fn encode(input: &[u8]) -> Result<Vec<u8>, Base122Error> {\n    // First pass: determine required size.\n    let mut needed: usize = 0;\n    encode_internal(input, None, &mut needed)?;\n\n    // Allocate buffer and perform actual encoding.\n    let mut output = vec![0u8; needed];\n    let mut written: usize = 0;\n    encode_internal(input, Some(&mut output[..]), &mut written)?;\n    debug_assert_eq!(written, needed);\n    Ok(output)\n}\n/// Internal function to perform the encoding\nfn encode_internal(\n    input: &[u8],\n    mut output: Option<&mut [u8]>,\n    out_written: &mut usize,\n) -> Result<(), Base122Error> {\n    let count_only = output.is_none();\n    let out_len = output.as_deref().map(|o| o.len()).unwrap_or(0);\n    let mut out_index: usize = 0;\n    *out_written = 0;\n\n    let mut reader = BitReader::new(input);\n\n    fn output_byte(\n        output: &mut Option<&mut [u8]>,\n        out_index: &mut usize,\n        out_len: usize,\n        out_written: &mut usize,\n        count_only: bool,\n        b: u8,\n    ) -> Result<(), Base122Error> {\n        if count_only {\n            *out_written += 1;\n        } else {\n            let out = output\n                .as_deref_mut()\n                .expect(\"output must be Some when count_only is false\");\n            if *out_index == out_len {\n                return Err(Base122Error::new(\n                    \"output does not have sufficient size\",\n                ));\n            }\n            out[*out_index] = b;\n            *out_written += 1;\n            *out_index += 1;\n        }\n        Ok(())\n    }\n\n    loop {\n        let (nbits, mut bits) = reader.read(7);\n        if nbits == 0 {\n            break;\n        }\n\n        if nbits < 7 {\n            // Align the first bit to start at position 6.\n            bits <<= 7 - nbits;\n        }\n\n        if is_illegal(bits) {\n            let illegal_index = get_illegal_index(bits);