next_nbits > 0 && next_nbits < 7 {\n                next_bits <<= 7 - next_nbits;\n            }\n\n            if next_nbits == 0 {\n                // Shortened two-byte sequence with the original (illegal) bits.\n                b1 |= 0x7 << 2; // 11100\n                next_bits = bits;\n            } else {\n                b1 |= illegal_index << 2;\n            }\n\n            // Push the first bit onto the first byte.\n            let first_bit = (next_bits >> 6) & 1;\n            b1 |= first_bit;\n            b2 |= next_bits & 0x3F; // 00111111\n\n            output_byte(\n                &mut output,\n                &mut out_index,\n                out_len,\n                out_written,\n                count_only,\n                b1,\n            )?;\n            output_byte(\n                &mut output,\n                &mut out_index,\n                out_len,\n                out_written,\n                count_only,\n                b2,\n            )?;\n        } else {\n            output_byte(\n                &mut output,\n                &mut out_index,\n                out_len,\n                out_written,\n                count_only,\n                bits,\n            )?;\n        }\n    }\n\n    Ok(())\n}\n/// Write the last 7 bits of byteVal for decoding.\n/// Returns an error if byteVal has 1 bits exceeding the last byte boundary.\nfn write_last_7(\n    writer: &mut BitWriter,\n    byte_val: u8,\n    error: &mut Base122Error,\n) -> Result<(), Base122Error> {\n    // Write up to the nearest byte boundary.\n    let nbits = 8 - (writer.cur_bit % 8);\n    if nbits == 8 {\n        let e = Base122Error::new(\"Decoded data is not a byte multiple\");\n        *error = e.clone();\n        return Err(e);\n    }\n    // Error if any bits after the last input bits are 1.\n    // mask = ~(0xFF << (7 - nbits)) truncated to u8.\n    let shift = 7 - nbits;\n    let mask: u8 = !(0xFFu8.wrapping_shl(shift as u32));\n    if byte_val & mask > 0 {\n        let e = Base122Error::new(\"Encoded data is malformed. Last byte has extra data.\");\n        *error = e.clone();\n        return Err(e);\n    }\n    // Shift bits to write.\n    let shifted = byte_val >> (7 - nbits);\n    if let Err(_) = writer.write(nbits as u8, shifted) {\n        let e = Base122Error::new(\"Output does not have sufficient size\");\n        *error = e.clone();\n        return Err(e);\n    }\n    Ok(())\n}\n/// Decode Base122 encoded data to binary\n///\n/// # Arguments\n///\n/// * `input` - The Base122 encoded data\n///\n/// # Returns\n///\n/// * `Ok(Vec<u8>)` - The decoded binary data\n/// * `Err(Base122Error)` - If there was an error during decoding\npub fn decode(input: &[u8]) -> Result<Vec<u8>, Base122Error> {\n    // First pass: count required bytes via a count-only writer.\n    let mut needed: usize = 0;\n    {\n        let mut writer = BitWriter::new(None, 0);\n        decode_internal(input, &mut writer, &mut needed)?;\n    }\n\n    // Second pass: write into an allocated buffer.\n    let mut output = vec![0u8; needed];\n    let mut written: usize = 0;\n    {\n        let mut writer = BitWriter::new(Some(&mut output[..]), needed);\n        decode_internal(input, &mut writer, &mut written)?;\n    }\n    debug_assert_eq!(written, needed);\n    Ok(output)\n}\n/// Internal function to perform the decoding\nfn decode_internal(\n    input: &[u8],\n    writer: &mut BitWriter,\n    out_written: &mut usize,\n) -> Result<(), Base122Error> {\n    let in_len = input.len();\n    let mut cur_byte: usize = 0;\n\n    while cur_byte < in_len {\n        let cur_byte_val = input[cur_byte];\n\n        if cur_byte_val >> 7 == 0 {\n            // One byte sequence.\n            let is_last = cur_byte + 1 == in_len;\n            if is_last {\n                let mut error = Base122Error::new(\"\");\n                write_last_7(writer, cur_byte_val, &mut error)?;\n            } else {\n                if writer.write(7, cur_byte_val).is_err() {\n                