f) {\n        self.exp.zeroize();\n        self.coeff.zeroize();\n        self.r.zeroize();\n    }\n}\n\nimpl Drop for CrtValue {\n    fn drop(&mut self) {\n        self.zeroize();\n    }\n}\n","numLines":66,"startLine":1,"totalLines":66}}}
