he previous word [a,b,c,d] gives [b,c,d,a].\n            // We use the standard AES key expansion semantics here, since the input\n            // key length is 16 bytes and we expand for AES-128.\n            let original = temp;\n            let mut rotated = [\n                original[1],\n                original[2],\n                original[3],\n                original[0],\n            ];\n            // SubWord\n            for byte in rotated.iter_mut() {\n                *byte = SBOX[*byte as usize];\n            }\n            // Rcon\n            rotated[0] ^= RCON[i / NK];\n            temp = rotated;\n        } else if NK > 6 && (i % NK == 4) {\n            // SubWord only (used in AES-256)\n            for byte in temp.iter_mut() {\n                *byte = SBOX[*byte as usize];\n            }\n        }\n\n        // w[i] = w[i - Nk] XOR temp\n        let cur_off = 4 * i;\n        let prev_nk_off = 4 * (i - NK);\n        for j in 0..4 {\n            w[cur_off + j] = w[prev_nk_off + j] ^ temp[j];\n        }\n\n        i += 1;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1251,"cache_read_input_tokens":39645,"cache_creation":{"ephemeral_5m_input_tokens":1251,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"640e7b92-30e2-4649-bfb9-40490261efa2","uuid":"cce31356-f114-4c38-97d3-ce60afa56c9f"}
