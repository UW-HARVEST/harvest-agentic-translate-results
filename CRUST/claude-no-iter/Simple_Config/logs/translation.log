8\t    while (!is_at_end(s) && (isspace(peek(s)) || peek(s) == '#')) {\n99\t        skip_whitespace(s);\n100\t        skip_comment(s);\n101\t    }\n102\t}\n103\t\n104\tstatic void\n105\tcopy_slice_into(Scanner *s, int src_off, int src_len, char *dst, int max)\n106\t{\n107\t    assert(src_len < max);\n108\t    memcpy(dst, s->src + src_off, src_len);\n109\t    dst[src_len] = '\\0';\n110\t}\n111\t\n112\tstatic bool\n113\tmatch_literal(Scanner *s, int offset, const char *literal, int len)\n114\t{\n115\t    if (offset + len > s->len)\n116\t        return false;\n117\t    return !strncmp(s->src + offset, literal, len);\n118\t}\n119\t\n120\tstatic bool\n121\tconsume_literal(Scanner *s, int offset, const char *literal, int len)\n122\t{\n123\t    if (match_literal(s, offset, literal, len)) {\n124\t        advance2(s, len);\n125\t        return true;\n126\t    }\n127\t    return false;\n128\t}\n129\t\n130\tstatic bool\n131\tis_key(char ch)\n132\t{\n133\t    return isalpha(ch) || ch == '.' || ch == '_';\n134\t}\n135\t\n136\tstatic bool\n137\tis_string(char ch)\n138\t{\n139\t    return isalnum(ch) || isblank(ch) || (ispunct(ch) && ch != '\"');\n140\t}\n141\t\n142\tstatic void\n143\tinit_error(CfgError *err)\n144\t{\n145\t    err->off = -1;\n146\t    err->col = -1;\n147\t    err->row = -1;\n148\t    err->msg[0] = '\\0';\n149\t}\n150\t\n151\tstatic int\n152\terror(Scanner *s, CfgError *err, const char *fmt, ...)\n153\t{\n154\t    const char prefix[] = \"\";\n155\t    const int prefix_len = sizeof(prefix) - 1;\n156\t\n157\t    err->off = cur(s);\n158\t    err->row = 1;\n159\t    err->col = 1;\n160\t    for (int i = 0; i < cur(s); i++) {\n161\t        err->col++;\n162\t        if (s->src[i] == '\\n') {\n163\t            err->row++;\n164\t            err->col = 1;\n165\t        }\n166\t    }\n167\t\n168\t    va_list vargs;\n169\t    va_start(vargs, fmt);\n170\t    snprintf(err->msg, CFG_MAX_ERR, prefix);\n171\t    vsnprintf(err->msg + prefix_len, CFG_MAX_ERR - prefix_len, fmt, vargs);\n172\t    va_end(vargs);\n173\t    return -1;\n174\t}\n175\t\n176\tvoid\n177\tcfg_fprint_error(FILE *stream, CfgError *err)\n178\t{\n179\t    if (err->row == -1 && err->col == -1)\n180\t        fprintf(stream, \"Error: %s\\n\", err->msg);\n181\t    else\n182\t        fprintf(stream, \"Error at %d:%d :: %s\\n\", err->row, err->col, err->msg);\n183\t}\n184\t\n185\tstatic int\n186\tparse_string(Scanner *s, CfgEntry *entry, CfgError *err)\n187\t{\n188\t    // Consume opening '\"'\n189\t    advance(s);\n190\t\n191\t    // Consume string\n192\t    int val_offset = cur(s);\n193\t    while (!is_at_end(s) && is_string(peek(s)))\n194\t        advance(s);\n195\t\n196\t    if (is_at_end(s) || peek(s) != '\"')\n197\t        return error(s, err, \"closing '\\\"' expected\");\n198\t\n199\t    int val_len = cur(s) - val_offset;\n200\t    if (val_len > CFG_MAX_VAL)\n201\t        return error(s, err, \"value too long\");\n202\t\n203\t    // Consume closing '\"'\n204\t    advance(s);\n205\t\n206\t    copy_slice_into(s, val_offset, val_len, entry->val.string,\n207\t                    sizeof(entry->val.string));\n208\t    entry->type = CFG_TYPE_STRING;\n209\t    return 0;\n210\t}\n211\t\n212\tstatic int\n213\tconsume_int(Scanner *s, int *number, CfgError *err)\n214\t{\n215\t    int sign = 1;\n216\t    int num = 0;\n217\t\n218\t    if (!is_at_end(s) && peek(s) == '-' && isdigit(peek_next(s))) {\n219\t        // Consume '-'\n220\t        advance(s);\n221\t        sign = -1;\n222\t    }\n223\t\n224\t    if (!is_at_end(s) && !isdigit(peek(s)))\n225\t        return error(s, err, \"number expected\");\n226\t\n227\t    while (!is_at_end(s) && isdigit(peek(s))) {\n228\t        int digit = advance(s) - '0';\n229\t        if (num > (INT_MAX - digit) / 10)\n230\t            return error(s, err, \"number too large\");\n231\t\n232\t        num = num * 10 + digit;\n233\t    }\n234\t\n235\t    *number = sign * num;\n236\t    return 0;\n237\t}\n238\t\n239\tstatic int\n240\tconsume_float(Scanner *s, float *number, CfgError *err)\n241\t{\n242\t    int sign = 1;\n243\t    int int_part = 0;\n244\t    int fract_part = 0;\n245\t\n246\t    if (!is_at_end(s) && peek(s) == '-' && isdigit(peek_next(s))) {\n247\t        // Consume '-'\n248\t        advance(s);\n249\t        sign = -1;\n250\t    }\n251\t\n252\t    if (!is_at_end(s) && !isdigit(peek(s)))\n253\t        return error(s, err, \"number expected\");\n254\t\n255\t    while (!is_at_end(s) && isdigit(peek(s))) {\n256\t        int digit = advance(s) - '0';\n257\t        if (int_part > (INT_MAX - digit) / 10)\n258\t            return error(s, err, \"number too large\");\n259\t        int_part = int_part * 10 + digit;\n260\t    }\n261\t\n262\t    if (!is_at_end(s) && peek(s) != '.')\n263\t        return error(s, err, \"float expected\");\n264\t\n265\t    // Consume '.'\n266\t    advance(s);\n267\t\n268\t    int div = 1;\n269\t    while (!is_at_end(s) && isdigit(peek(s))) {\n270\t        int digit = advance(s) - '0';\n271\t        if (fract_part > (INT_MAX - digit) / 10)\n272\t            return error(s, err, \"number too large\");\n273\t\n274\t        fract_part = fract_part * 10 + digit;\n275\t        if (div > INT_MAX / 10)\n276\t            return error(s, err, \"number too large\");\n277\t\n278\t        div *= 10;\n279\t    }\n280\t\n281\t    float floating = int_part + ((float) fract_part / div);\n282\t    *number = sign * floating;\n283\t    return 0;\n284\t}\n285\t\n286\tstatic bool\n287\tmatch_float(Scanner *s)\n288\t{\n289\t    int restore = cur(s);\n290\t    bool is_float = false;\n291\t\n292\t    if (!is_at_end(s) && peek(s) == '-' && isdigit(peek_next(s)))\n293\t        advance(s);  // Consume '-'\n294\t\n295\t    while (!is_at_end(s) && isdigit(peek(s)))\n296\t        advance(s);\n297\t\n298\t    if (!is_at_end(s) && peek(s) == '.')\n299\t        is_float = true;\n300\t\n301\t    set_cur(s, restore);\n302\t    return is_float;\n303\t}\n304\t\n305\tstatic int\n306\tparse_number(Scanner *s, CfgEntry *entry, CfgError *err)\n307\t{\n308\t    if (match_float(s)) {\n309\t        float number;\n310\t        if (consume_float(s, &number, err) != 0)\n311\t            return -1;\n312\t\n313\t        entry->val.floating = number;\n314\t        entry->type = CFG_TYPE_FLOAT;\n315\t    } else {\n316\t        int number;\n317\t        if (consume_int(s, &number, err) != 0)\n318\t            return -1;\n319\t\n320\t        entry->val.integer = number;\n321\t        entry->type = CFG_TYPE_INT;\n322\t    }\n323\t    return 0;\n324\t}\n325\t\n326\tstatic int\n327\tparse_rgba(Scanner *s, CfgEntry *entry, CfgError *err)\n328\t{\n329\t    if (!consume_literal(s, cur(s), \"rgba\", 4))\n330\t        return error(s, err, \"invalid literal\");\n331\t\n332\t    // Skip blank space between 'a' and '('\n333\t    skip_blank(s);\n334\t\n335\t    if (is_at_end(s) || peek(s) != '(')\n336\t        return error(s, err, \"'(' expected\");\n337\t\n338\t    // Consume '('\n339\t    advance(s);\n340\t\n341\t    uint8_t rgb[3];\n342\t    for (int i = 0; i < 3; i++) {\n343\t        // Skip blank space preceding the number\n344\t        skip_blank(s);\n345\t\n346\t        if (match_float(s))\n347\t            return error(s, err,\n348\t                         \"red, blue and green must be \"\n349\t                         \"integers in range [0, 255]\");\n350\t\n351\t        int number;\n352\t        if (consume_int(s, &number, err) != 0)\n353\t            return -1;\n354\t\n355\t        if (number < 0 || number > 255)\n356\t            return error(s, err,\n357\t                         \"red, blue and green must be \"\n358\t                         \"integers in range [0, 255]\");\n359\t\n360\t        rgb[i] = (uint8_t) number;\n361\t\n362\t        // Skip blank space following the number\n363\t        skip_blank(s);\n364\t\n365\t        if (is_at_end(s) || peek(s) != ',')\n366\t            return error(s, err, \"',' expected\");\n367\t\n368\t        // Consume ','\n369\t        advance(s);\n370\t    }\n371\t\n372\t    // Skip blank space preceding the number\n373\t    skip_blank(s);\n374\t\n375\t    uint8_t alpha;\n376\t    if (match_float(s)) {\n377\t        float number;\n378\t        if (consume_float(s, &number, err) != 0)\n379\t            return -1;\n380\t\n381\t        if (number < 0 || number > 1)\n382\t            return error(s, err, \"alpha must be in range [0, 1]\");\n383\t\n384\t        alpha = number * 255;\n385\t    } else {\n386\t        int number;\n387\t        if (consume_int(s, &number, err) != 0)\n388\t            return -1;\n389\t\n390\t        if (number < 0 || number > 1)\n391\t            return error(s, err, \"alpha must be in range [0, 1]\");\n392\t\n393\t        alpha = number * 255;\n394\t    }\n395\t\n396\t    // Skip blank space following the number\n397\t    skip_blank(s);\n398\t\n399\t    if (is_at_end(s) || peek(s) != ')')\n400\t        return error(s, err, \"')' expected\");\n401\t\n402\t    // Consume ')'\n403\t    advance(s);\n404\t\n405\t    entry->val.color = (CfgColor){\n406\t        .r = rgb[0],\n407\t        .g = rgb[1],\n408\t        .b = rgb[2],\n409\t        .a = alpha,\n410\t    };\n411\t    entry->type = CFG_TYPE_COLOR;\n412\t    return 0;\n413\t}\n414\t\n415\tstatic int\n416\tparse_true(Scanner *s, CfgEntry *entry, CfgError *err)\n417\t{\n418\t    if (!consume_literal(s, cur(s), \"true\", 4))\n419\t        return error(s, err, \"invalid literal\");\n420\t\n421\t    entry->val.boolean = true;\n422\t    entry->type = CFG_TYPE_BOOL;\n423\t    return 0;\n424\t}\n425\t\n426\tstatic int\n427\tparse_false(Scanner *s, CfgEntry *entry, CfgError *err)\n428\t{\n429\t    if (!consume_literal(s, cur(s), \"false\", 5))\n430\t        return error(s, err, \"invalid literal\");\n431\t\n432\t    entry->val.boolean = false;\n433\t    entry->type = CFG_TYPE_BOOL;\n434\t    return 0;\n435\t}\n436\t\n437\tstatic int\n438\tparse_literal(Scanner *s, CfgEntry *entry, CfgError *err)\n439\t{\n440\t    switch (peek(s)) {\n441\t    case 't':\n442\t        return parse_true(s, entry, err);\n443\t    case 'f':\n444\t        return parse_false(s, entry, err);\n445\t    case 'r':\n446\t        return parse_rgba(s, entry, err);\n447\t    default:\n448\t        return error(s, err, \"invalid literal\");\n449\t    }\n450\t}\n451\t\n452\tstatic int\n453\tparse_value(Scanner *s, CfgEntry *entry, CfgError *err)\n454\t{\n455\t    // Skip blank space between ':' and the value\n456\t    skip_blank(s);\n457\t\n458\t    if (is_at_end(s) || peek(s) == '\\n')\n459\t        return error(s, err, \"missing value\");\n460\t\n461\t    // Consume value\n462\t    char c = peek(s);\n463\t\n464\t    if (c == '\"')\n465\t        return parse_string(s, entry, err);\n466\t    else if (isalpha(c))\n467\t        return parse_literal(s, entry, err);\n468\t    else if (isdigit(c) || (c == '-' && isdigit(peek_next(s))))\n469\t        return parse_number(s, entry, err);\n470\t    else\n471\t        return error(s, err, \"invalid value\");\n472\t}\n473\t\n474\tstatic int\n475\tparse_key(Scanner *s, CfgEntry *entry, CfgError *err)\n476\t{\n477\t    if (is_at_end(s) || !is_key(peek(s)))\n478\t        return error(s, err, \"missing key\");\n479\t\n480\t    // Consume key\n481\t    int key_offset = cur(s);\n482\t    do\n483\t        advance(s);\n484\t    while (!is_at_end(s) && is_key(peek(s)));\n485\t    int key_len = cur(s) - key_offset;\n486\t\n487\t    if (key_len > CFG_MAX_KEY)\n488\t        return error(s, err, \"key too long\");\n489\t\n490\t    copy_slice_into(s, key_offset, key_len, entry->key, sizeof(entry->key));\n491\t    return 0;\n492\t}\n493\t\n494\tstatic int\n495\tconsume_colon(Scanner *s, CfgError *err)\n496\t{\n497\t    // Skip blank space between the key and ':'\n498\t    skip_blank(s);\n499\t\n500\t    if (is_at_end(s) || peek(s) != ':')\n501\t        return error(s, err, \"':' expected\");\n502\t\n503\t    // Consume ':'\n504\t    advance(s);\n505\t    return 0;\n506\t}\n507\t\n508\tstatic int\n509\tparse_entry(Scanner *s, CfgEntry *entry, CfgError *err)\n510\t{\n511\t    if (parse_key(s, entry, err) != 0)\n512\t        return -1;\n513\t\n514\t    if (consume_colon(s, err) != 0)\n515\t        return -1;\n516\t\n517\t    if (parse_value(s, entry, err) != 0)\n518\t        return -1;\n519\t\n520\t    // Skip trailing blank space after the value\n521\t    skip_blank(s);\n522\t\n523\t    if (!is_at_end(s) && peek(s) == '#')\n524\t        skip_comment(s);\n525\t\n526\t    if (!is_at_end(s) && peek(s) != '\\n')\n527\t        return error(s, err, \"unexpected character '%c'\", peek(s));\n528\t\n529\t    // Consume '\\n'\n530\t    if (!is_at_end(s))\n531\t        advance(s);\n532\t\n533\t    return 0;\n534\t}\n535\t\n536\tint\n537\tcfg_parse(const char *src, int src_len, Cfg *cfg, CfgError *err)\n538\t{\n539\t    Scanner s;\n540\t    init_scanner(&s, src, src_len);\n541\t    init_error(err);\n542\t\n543\t    cfg->count = 0;\n544\t    skip_whitespace_and_comments(&s);\n545\t\n546\t    while (!is_at_end(&s) && cfg->count < cfg->capacity) {\n547\t        CfgEntry *entry = &cfg->entries[cfg->count];\n548\t\n549\t        if (parse_entry(&s, entry, err) != 0)\n550\t            return -1;\n551\t\n552\t        cfg->count++;\n553\t        skip_whitespace_and_comments(&s);\n554\t    }\n555\t\n556\t    return 0;\n557\t}\n558\t\n559\tstatic char *\n560\tread_file(const char *filename, int *count, char *err)\n561\t{\n562\t    FILE *file = fopen(filename, \"rb\");\n563\t    if (!file) {\n564\t        snprintf(err, CFG_MAX_ERR, \"failed to open file\");\n565\t        return NULL;\n566\t    }\n567\t\n568\t    fseek(file, 0, SEEK_END);\n569\t    size_t file_size = (size_t) ftell(file);\n570\t    rewind(file);\n571\t\n572\t    char *src = malloc(file_size + 1);\n573\t    if (src == NULL) {\n574\t        snprintf(err, CFG_MAX_ERR, \"memory allocation failed\");\n575\t        return NULL;\n576\t    }\n577\t\n578\t    size_t bytes_read = fread(src, sizeof(char), file_size, file);\n579\t    fclose(file);\n580\t\n581\t    if (bytes_read != file_size) {\n582\t        free(src);\n583\t        snprintf(err, CFG_MAX_ERR, \"failed to read file\");\n584\t        return NULL;\n585\t    }\n586\t\n587\t    *count = file_size;\n588\t    return src;\n589\t}\n590\t\n591\tint\n592\tcfg_parse_file(const char *filename, Cfg *cfg, CfgError *err)\n593\t{\n594\t    init_error(err);\n595\t\n596\t    size_t len = strlen(filename);\n597\t    if (len < 5) {\n598\t        snprintf(err->msg, CFG_MAX_ERR, \"invalid filename\");\n599\t        return -1;\n600\t    }\n601\t\n602\t    const char *ext = filename + (len - (sizeof(CFG_FILE_EXT) - 1));\n603\t    if (strcmp(ext, CFG_FILE_EXT) != 0) {\n604\t        snprintf(err->msg, CFG_MAX_ERR, \"invalid file extension\");\n605\t        return -1;\n606\t    }\n607\t\n608\t    int src_len;\n609\t    char *src = read_file(filename, &src_len, err->msg);\n610\t    if (src == NULL)\n611\t        return -1;\n612\t\n613\t    int res = cfg_parse(src, src_len, cfg, err);\n614\t\n615\t    free(src);\n616\t    return res;\n617\t}\n618\t\n619\tstatic void *\n620\tget_val(Cfg *cfg, const char *key, void *fallback, CfgValType type)\n621\t{\n622\t    for (int i = cfg->count - 1; i >= 0; i--) {\n623\t        if (cfg->entries[i].type == type && !strcmp(key, cfg->entries[i].key))\n624\t            return &(cfg->entries[i].val);\n625\t    }\n626\t    return fallback;\n627\t}\n628\t\n629\tchar *\n630\tcfg_get_string(Cfg *cfg, const char *key, char *fallback)\n631\t{\n632\t    return (char *) get_val(cfg, key, fallback, CFG_TYPE_STRING);\n633\t}\n634\t\n635\tbool\n636\tcfg_get_bool(Cfg *cfg, const char *key, bool fallback)\n637\t{\n638\t    return *(bool *) get_val(cfg, key, &fallback, CFG_TYPE_BOOL);\n639\t}\n640\t\n641\tint\n642\tcfg_get_int(Cfg *cfg, const char *key, int fallback)\n643\t{\n644\t    return *(int *) get_val(cfg, key, &fallback, CFG_TYPE_INT);\n645\t}\n646\t\n647\tint\n648\tcfg_get_int_min(Cfg *cfg, const char *key, int fallback, int min)\n649\t{\n650\t    int value = cfg_get_int(cfg, key, fallback);\n651\t    if (value < min)\n652\t        value = fallback;\n653\t    return value;\n654\t}\n655\t\n656\tint\n657\tcfg_get_int_max(Cfg *cfg, const char *key, int fallback, int max)\n658\t{\n659\t    int value = cfg_get_int(cfg, key, fallback);\n660\t    if (value > max)\n661\t        value = fallback;\n662\t    return value;\n663\t}\n664\t\n665\tint\n666\tcfg_get_int_range(Cfg *cfg, const char *key, int fallback, int min, int max)\n667\t{\n668\t    int value = cfg_get_int(cfg, key, fallback);\n669\t    if (value < min || value > max)\n670\t        value = fallback;\n671\t    return value;\n672\t}\n673\t\n674\tfloat\n675\tcfg_get_float(Cfg *cfg, const char *key, float fallback)\n676\t{\n677\t    return *(float *) get_val(cfg, key, &fallback, CFG_TYPE_FLOAT);\n678\t}\n679\t\n680\tfloat\n681\tcfg_get_float_min(Cfg *cfg, const char *key, float fallback, float min)\n682\t{\n683\t    float value = cfg_get_float(cfg, key, fallback);\n684\t    if (value < min)\n685\t        value = fallback;\n686\t    return value;\n687\t}\n688\t\n689\tfloat\n690\tcfg_get_float_max(Cfg *cfg, const char *key, float fallback, float max)\n691\t{\n692\t    float value = cfg_get_float(cfg, key, fallback);\n693\t    if (value > max)\n694\t        value = fallback;\n695\t    return value;\n696\t}\n697\t\n698\tfloat\n699\tcfg_get_float_range(Cfg *cfg,\n700\t                    const char *key,\n701\t                    float fallback,\n702\t                    float min,\n703\t                    float max)\n704\t{\n705\t    float value = cfg_get_float(cfg, key, fallback);\n706\t    if (value < min || value > max)\n707\t        value = fallback;\n708\t    return value;\n709\t}\n710\t\n711\tCfgColor\n712\tcfg_get_color(Cfg *cfg, const char *key, CfgColor fallback)\n713\t{\n714\t    return *(CfgColor *) get_val(cfg, key, &fallback, CFG_TYPE_COLOR);\n715\t}\n716\t\n717\tvoid\n718\tcfg_fprint(FILE *stream, Cfg *cfg)\n719\t{\n720\t    for (int i = 0; i < cfg->count; i++) {\n721\t        fprintf(stream, \"%s: \", cfg->entries[i].key);\n722\t\n723\t        switch (cfg->entries[i].type) {\n724\t        case CFG_TYPE_STRING:\n725\t            fprintf(stream, \"\\\"%s\\\"\\n\", cfg->entries[i].val.string);\n726\t            break;\n727\t        case CFG_TYPE_BOOL:\n728\t            fprintf(stream, \"%s\\n\",\n729\t                    cfg->entries[i].val.boolean ? \"true\" : \"false\");\n730\t            break;\n731\t        case CFG_TYPE_INT:\n732\t            fprintf(stream, \"%d\\n\", cfg->entries[i].val.integer);\n733\t            break;\n734\t        case CFG_TYPE_FLOAT:\n735\t            fprintf(stream, \"%f\\n\", cfg->entries[i].val.floating);\n736\t            break;\n737\t        case CFG_TYPE_COLOR:;\n738\t            CfgColor c = cfg->entries[i].val.color;\n739\t            fprintf(stream, \"rgba(%d, %d, %d, %d)\\n\", c.r, c.g, c.b, c.a);\n740\t            break;\n741\t        }\n742\t    }\n743\t}\n744\t"}]},"parent_tool_use_id":null,"session_id":"85a6941a-175b-4720-9f85-a7e7d4025478","uuid":"ece000f3-d241-4a74-b26c-b3500c71fac9","timestamp":"2026-06-03T00:29:57.730Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-Nm2H9V/project/c_src/config.c","content":"#include <assert.h>\n#include <ctype.h>\n#include <limits.h>\n#include <stdarg.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\n#include \"config.h\"\n\ntypedef struct {\n    const char *src;\n    int len;\n    int cur;\n} Scanner;\n\nstatic void\ninit_scanner(Scanner *s, const char *src, int src_len)\n{\n    s->src = src;\n    s->len = src_len;\n    s->cur = 0;\n}\n\nstatic bool\nis_at_end(Scanner *s)\n{\n    return s->cur >= s->len;\n}\n\nstatic int\ncur(Scanner *s)\n{\n    return s->cur;\n}\n\nstatic void\nset_cur(Scanner *s, int n)\n{\n    s->cur = n;\n}\n\nstatic char\npeek(Scanner *s)\n{\n    return s->src[s->cur];\n}\n\nstatic char\npeek_next(Scanner *s)\n{\n    if (s->cur >= s->len - 1)\n        return '\\0';\n    return s->src[s->cur + 1];\n}\n\nstatic char\nadvance(Scanner *s)\n{\n    return s->src[s->cur++];\n}\n\nstatic char\nadvance2(Scanner *s, int n)\n{\n    for (int i = 0; i < n - 1; i++)\n        s->cur++;\n    return s->src[s->cur++];\n}\n\nstatic void\nskip_whitespace(Scanner *s)\n{\n    while (!is_at_end(s) && isspace(peek(s)))\n        advance(s);\n}\n\nstatic void\nskip_blank(Scanner *s)\n{\n    while (!is_at_end(s) && isspace(peek(s)) && peek(s) != '\\n')\n        advance(s);\n}\n\nstatic void\nskip_comment(Scanner *s)\n{\n    while (!is_at_end(s) && peek(s) == '#') {\n        do\n            advance(s);\n        while (!is_at_end(s) && peek(s) != '\\n');\n    }\n}\n\nvoid\nskip_whitespace_and_comments(Scanner *s)\n{\n    while (!is_at_end(s) && (isspace(peek(s)) || peek(s) == '#')) {\n        skip_whitespace(s);\n        skip_comment(s);\n    }\n}\n\nstatic void\ncopy_slice_into(Scanner *s, int src_off, int src_len, char *dst, int max)\n{\n    assert(src_len < max);\n    memcpy(dst, s->src + src_off, src_len);\n    dst[src_len] = '\\0';\n}\n\nstatic bool\nmatch_literal(Scanner *s, int offset, const char *literal, int len)\n{\n    if (offset + len > s->len)\n        return false;\n    return !strncmp(s->src + offset, literal, len);\n}\n\nstatic bool\nconsume_literal(Scanner *s, int offset, const char *literal, int len)\n{\n    if (match_literal(s, offset, literal, len)) {\n        advance2(s, len);\n        return true;\n    }\n    return false;\n}\n\nstatic bool\nis_key(char ch)\n{\n    return isalpha(ch) || ch == '.' || ch == '_';\n}\n\nstatic bool\nis_string(char ch)\n{\n    return isalnum(ch) || isblank(ch) || (ispunct(ch) && ch != '\"');\n}\n\nstatic void\ninit_error(CfgError *err)\n{\n    err->off = -1;\n    err->col = -1;\n    err->row = -1;\n    err->msg[0] = '\\0';\n}\n\nstatic int\nerror(Scanner *s, CfgError *err, const char *fmt, ...)\n{\n    const char prefix[] = \"\";\n    const int prefix_len = sizeof(prefix) - 1;\n\n    err->off = cur(s);\n    err->row = 1;\n    err->col = 1;\n    for (int i = 0; i < cur(s); i++) {\n        err->col++;\n        if (s->src[i] == '\\n') {\n            err->row++;\n            err->col = 1;\n        }\n    }\n\n    va_list vargs;\n    va_start(vargs, fmt);\n    snprintf(err->msg, CFG_MAX_ERR, prefix);\n    vsnprintf(err->msg + prefix_len, CFG_MAX_ERR - prefix_len, fmt, vargs);\n    va_end(vargs);\n    return -1;\n}\n\nvoid\ncfg_fprint_error(FILE *stream, CfgError *err)\n{\n    if (err->row == -1 && err->col == -1)\n        fprintf(stream, \"Error: %s\\n\", err->msg);\n    else\n        fprintf(stream, \"Error at %d:%d :: %s\\n\", err->row, err->col, err->msg);\n}\n\nstatic int\nparse_string(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    // Consume opening '\"'\n    advance(s);\n\n    // Consume string\n    int val_offset = cur(s);\n    while (!is_at_end(s) && is_string(peek(s)))\n        advance(s);\n\n    if (is_at_end(s) || peek(s) != '\"')\n        return error(s, err, \"closing '\\\"' expected\");\n\n    int val_len = cur(s) - val_offset;\n    if (val_len > CFG_MAX_VAL)\n        return error(s, err, \"value too long\");\n\n    // Consume closing '\"'\n    advance(s);\n\n    copy_slice_into(s, val_offset, val_len, entry->val.string,\n                    sizeof(entry->val.string));\n    entry->type = CFG_TYPE_STRING;\n    return 0;\n}\n\nstatic int\nconsume_int(Scanner *s, int *number, CfgError *err)\n{\n    int sign = 1;\n    int num = 0;\n\n    if (!is_at_end(s) && peek(s) == '-' && isdigit(peek_next(s))) {\n        // Consume '-'\n        advance(s);\n        sign = -1;\n    }\n\n    if (!is_at_end(s) && !isdigit(peek(s)))\n        return error(s, err, \"number expected\");\n\n    while (!is_at_end(s) && isdigit(peek(s))) {\n        int digit = advance(s) - '0';\n        if (num > (INT_MAX - digit) / 10)\n            return error(s, err, \"number too large\");\n\n        num = num * 10 + digit;\n    }\n\n    *number = sign * num;\n    return 0;\n}\n\nstatic int\nconsume_float(Scanner *s, float *number, CfgError *err)\n{\n    int sign = 1;\n    int int_part = 0;\n    int fract_part = 0;\n\n    if (!is_at_end(s) && peek(s) == '-' && isdigit(peek_next(s))) {\n        // Consume '-'\n        advance(s);\n        sign = -1;\n    }\n\n    if (!is_at_end(s) && !isdigit(peek(s)))\n        return error(s, err, \"number expected\");\n\n    while (!is_at_end(s) && isdigit(peek(s))) {\n        int digit = advance(s) - '0';\n        if (int_part > (INT_MAX - digit) / 10)\n            return error(s, err, \"number too large\");\n        int_part = int_part * 10 + digit;\n    }\n\n    if (!is_at_end(s) && peek(s) != '.')\n        return error(s, err, \"float expected\");\n\n    // Consume '.'\n    advance(s);\n\n    int div = 1;\n    while (!is_at_end(s) && isdigit(peek(s))) {\n        int digit = advance(s) - '0';\n        if (fract_part > (INT_MAX - digit) / 10)\n            return error(s, err, \"number too large\");\n\n        fract_part = fract_part * 10 + digit;\n        if (div > INT_MAX / 10)\n            return error(s, err, \"number too large\");\n\n        div *= 10;\n    }\n\n    float floating = int_part + ((float) fract_part / div);\n    *number = sign * floating;\n    return 0;\n}\n\nstatic bool\nmatch_float(Scanner *s)\n{\n    int restore = cur(s);\n    bool is_float = false;\n\n    if (!is_at_end(s) && peek(s) == '-' && isdigit(peek_next(s)))\n        advance(s);  // Consume '-'\n\n    while (!is_at_end(s) && isdigit(peek(s)))\n        advance(s);\n\n    if (!is_at_end(s) && peek(s) == '.')\n        is_float = true;\n\n    set_cur(s, restore);\n    return is_float;\n}\n\nstatic int\nparse_number(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    if (match_float(s)) {\n        float number;\n        if (consume_float(s, &number, err) != 0)\n            return -1;\n\n        entry->val.floating = number;\n        entry->type = CFG_TYPE_FLOAT;\n    } else {\n        int number;\n        if (consume_int(s, &number, err) != 0)\n            return -1;\n\n        entry->val.integer = number;\n        entry->type = CFG_TYPE_INT;\n    }\n    return 0;\n}\n\nstatic int\nparse_rgba(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    if (!consume_literal(s, cur(s), \"rgba\", 4))\n        return error(s, err, \"invalid literal\");\n\n    // Skip blank space between 'a' and '('\n    skip_blank(s);\n\n    if (is_at_end(s) || peek(s) != '(')\n        return error(s, err, \"'(' expected\");\n\n    // Consume '('\n    advance(s);\n\n    uint8_t rgb[3];\n    for (int i = 0; i < 3; i++) {\n        // Skip blank space preceding the number\n        skip_blank(s);\n\n        if (match_float(s))\n            return error(s, err,\n                         \"red, blue and green must be \"\n                         \"integers in range [0, 255]\");\n\n        int number;\n        if (consume_int(s, &number, err) != 0)\n            return -1;\n\n        if (number < 0 || number > 255)\n            return error(s, err,\n                         \"red, blue and green must be \"\n                         \"integers in range [0, 255]\");\n\n        rgb[i] = (uint8_t) number;\n\n        // Skip blank space following the number\n        skip_blank(s);\n\n        if (is_at_end(s) || peek(s) != ',')\n            return error(s, err, \"',' expected\");\n\n        // Consume ','\n        advance(s);\n    }\n\n    // Skip blank space preceding the number\n    skip_blank(s);\n\n    uint8_t alpha;\n    if (match_float(s)) {\n        float number;\n        if (consume_float(s, &number, err) != 0)\n            return -1;\n\n        if (number < 0 || number > 1)\n            return error(s, err, \"alpha must be in range [0, 1]\");\n\n        alpha = number * 255;\n    } else {\n        int number;\n        if (consume_int(s, &number, err) != 0)\n            return -1;\n\n        if (number < 0 || number > 1)\n            return error(s, err, \"alpha must be in range [0, 1]\");\n\n        alpha = number * 255;\n    }\n\n    // Skip blank space following the number\n    skip_blank(s);\n\n    if (is_at_end(s) || peek(s) != ')')\n        return error(s, err, \"')' expected\");\n\n    // Consume ')'\n    advance(s);\n\n    entry->val.color = (CfgColor){\n        .r = rgb[0],\n        .g = rgb[1],\n        .b = rgb[2],\n        .a = alpha,\n    };\n    entry->type = CFG_TYPE_COLOR;\n    return 0;\n}\n\nstatic int\nparse_true(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    if (!consume_literal(s, cur(s), \"true\", 4))\n        return error(s, err, \"invalid literal\");\n\n    entry->val.boolean = true;\n    entry->type = CFG_TYPE_BOOL;\n    return 0;\n}\n\nstatic int\nparse_false(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    if (!consume_literal(s, cur(s), \"false\", 5))\n        return error(s, err, \"invalid literal\");\n\n    entry->val.boolean = false;\n    entry->type = CFG_TYPE_BOOL;\n    return 0;\n}\n\nstatic int\nparse_literal(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    switch (peek(s)) {\n    case 't':\n        return parse_true(s, entry, err);\n    case 'f':\n        return parse_false(s, entry, err);\n    case 'r':\n        return parse_rgba(s, entry, err);\n    default:\n        return error(s, err, \"invalid literal\");\n    }\n}\n\nstatic int\nparse_value(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    // Skip blank space between ':' and the value\n    skip_blank(s);\n\n    if (is_at_end(s) || peek(s) == '\\n')\n        return error(s, err, \"missing value\");\n\n    // Consume value\n    char c = peek(s);\n\n    if (c == '\"')\n        return parse_string(s, entry, err);\n    else if (isalpha(c))\n        return parse_literal(s, entry, err);\n    else if (isdigit(c) || (c == '-' && isdigit(peek_next(s))))\n        return parse_number(s, entry, err);\n    else\n        return error(s, err, \"invalid value\");\n}\n\nstatic int\nparse_key(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    if (is_at_end(s) || !is_key(peek(s)))\n        return error(s, err, \"missing key\");\n\n    // Consume key\n    int key_offset = cur(s);\n    do\n        advance(s);\n    while (!is_at_end(s) && is_key(peek(s)));\n    int key_len = cur(s) - key_offset;\n\n    if (key_len > CFG_MAX_KEY)\n        return error(s, err, \"key too long\");\n\n    copy_slice_into(s, key_offset, key_len, entry->key, sizeof(entry->key));\n    return 0;\n}\n\nstatic int\nconsume_colon(Scanner *s, CfgError *err)\n{\n    // Skip blank space between the key and ':'\n    skip_blank(s);\n\n    if (is_at_end(s) || peek(s) != ':')\n        return error(s, err, \"':' expected\");\n\n    // Consume ':'\n    advance(s);\n    return 0;\n}\n\nstatic int\nparse_entry(Scanner *s, CfgEntry *entry, CfgError *err)\n{\n    if (parse_key(s, entry, err) != 0)\n        return -1;\n\n    if (consume_colon(s, err) != 0)\n        return -1;\n\n    if (parse_value(s, entry, err) != 0)\n        return -1;\n\n    // Skip trailing blank space after the value\n    skip_blank(s);\n\n    if (!is_at_end(s) && peek(s) == '#')\n        skip_comment(s);\n\n    if (!is_at_end(s) && peek(s) != '\\n')\n        return error(s, err, \"unexpected character '%c'\", peek(s));\n\n    // Consume '\\n'\n    if (!is_at_end(s))\n        advance(s);\n\n    return 0;\n}\n\nint\ncfg_parse(const char *src, int src_len, Cfg *cfg, CfgError *err)\n{\n    Scanner s;\n    init_scanner(&s, src, src_len);\n    init_error(err);\n\n    cfg->count = 0;\n    skip_whitespace_and_comments(&s);\n\n    while (!is_at_end(&s) && cfg->count < cfg->capacity) {\n        CfgEntry *entry = &cfg->entries[cfg->count];\n\n        if (parse_entry(&s, entry, err) != 0)\n            return -1;\n\n        cfg->count++;\n        skip_whitespace_and_comments(&s);\n    }\n\n    return 0;\n}\n\nstatic char *\nread_file(const char *filename, int *count, char *err)\n{\n    FILE *file = fopen(filename, \"rb\");\n    if (!file) {\n        snprintf(err, CFG_MAX_ERR, \"failed to open file\");\n        return NULL;\n    }\n\n    fseek(file, 0, SEEK_END);\n    size_t file_size = (size_t) ftell(file);\n    rewind(file);\n\n    char *src = malloc(file_size + 1);\n    if (src == NULL) {\n        snprintf(err, CFG_MAX_ERR, \"memory allocation failed\");\n        return NULL;\n    }\n\n    size_t bytes_read = fread(src, sizeof(char), file_size, file);\n    fclose(file);\n\n    if (bytes_read != file_size) {\n        free(src);\n        snprintf(err, CFG_MAX_ERR, \"failed to read file\");\n        return NULL;\n    }\n\n    *count = file_size;\n    return src;\n}\n\nint\ncfg_parse_file(const char *filename, Cfg *cfg, CfgError *err)\n{\n    init_error(err);\n\n    size_t len = strlen(filename);\n    if (len < 5) {\n        snprintf(err->msg, CFG_MAX_ERR, \"invalid filename\");\n        return -1;\n    }\n\n    const char *ext = filename + (len - (sizeof(CFG_FILE_EXT) - 1));\n    if (strcmp(ext, CFG_FILE_EXT) != 0) {\n        snprintf(err->msg, CFG_MAX_ERR, \"invalid file extension\");\n        return -1;\n    }\n\n    int src_len;\n    char *src = read_file(filename, &src_len, err->msg);\n    if (src == NULL)\n        return -1;\n\n    int res = cfg_parse(src, src_len, cfg, err);\n\n    free(src);\n    return res;\n}\n\nstatic void *\nget_val(Cfg *cfg, const char *key, void *fallback, CfgValType type)\n{\n    for (int i = cfg->count - 1; i >= 0; i--) {\n        if (cfg->entries[i].type == type && !strcmp(key, cfg->entries[i].key))\n            return &(cfg->entries[i].val);\n    }\n    return fallback;\n}\n\nchar *\ncfg_get_string(Cfg *cfg, const char *key, char *fallback)\n{\n    return (char *) get_val(cfg, key, fallback, CFG_TYPE_STRING);\n}\n\nbool\ncfg_get_bool(Cfg *cfg, const char *key, bool fallback)\n{\n    return *(bool *) get_val(cfg, key, &fallback, CFG_TYPE_BOOL);\n}\n\nint\ncfg_get_int(Cfg *cfg, const char *key, int fallback)\n{\n    return *(int *) get_val(cfg, key, &fallback, CFG_TYPE_INT);\n}\n\nint\ncfg_get_int_min(Cfg *cfg, const char *key, int fallback, int min)\n{\n    int value = cfg_get_int(cfg, key, fallback);\n    if (value < min)\n        value = fallback;\n    return value;\n}\n\nint\ncfg_get_int_max(Cfg *cfg, const char *key, int fallback, int max)\n{\n    int value = cfg_get_int(cfg, key, fallback);\n    if (value > max)\n        value = fallback;\n    return value;\n}\n\nint\ncfg_get_int_range(Cfg *cfg, const char *key, int fallback, int min, int max)\n{\n    int value = cfg_get_int(cfg, key, fallback);\n    if (value < min || value > max)\n        value = fallback;\n    return value;\n}\n\nfloat\ncfg_get_float(Cfg *cfg, const char *key, float fallback)\n{\n    return *(float *) get_val(cfg, key, &fallback, CFG_TYPE_FLOAT);\n}\n\nfloat\ncfg_get_float_min(Cfg *cfg, const char *key, float fallback, float min)\n{\n    float value = cfg_get_float(cfg, key, fallback);\n    if (value < min)\n        value = fallback;\n    return value;\n}\n\nfloat\ncfg_get_float_max(Cfg *cfg, const char *key, float fallback, float max)\n{\n    float value = cfg_get_float(cfg, key, fallback);\n    if (value > max)\n        value = fallback;\n    return value;\n}\n\nfloat\ncfg_get_float_range(Cfg *cfg,\n                    const char *key,\n                    float fallback,\n                    float min,\n                    float max)\n{\n    float value = cfg_get_float(cfg, key, fallback);\n    if (value < min || value > max)\n        value = fallback;\n    return value;\n}\n\nCfgColor\ncfg_get_color(Cfg *cfg, const char *key, CfgColor fallback)\n{\n    return *(CfgColor *) get_val(cfg, key, &fallback, CFG_TYPE_COLOR);\n}\n\nvoid\ncfg_fprint(FILE *stream, Cfg *cfg)\n{\n    for (int i = 0; i < cfg->count; i++) {\n        fprintf(stream, \"%s: \", cfg->entries[i].key);\n\n        switch (cfg->entries[i].type) {\n        case CFG_TYPE_STRING:\n            fprintf(stream, \"\\\"%s\\\"\\n\", cfg->entries[i].val.string);\n            break;\n        case CFG_TYPE_BOOL:\n            fprintf(stream, \"%s\\n\",\n                    cfg->entries[i].val.boolean ? \"true\" : \"false\");\n            break;\n        case CFG_TYPE_INT:\n            fprintf(stream, \"%d\\n\", cfg->entries[i].val.integer);\n            break;\n        case CFG_TYPE_FLOAT:\n            fprintf(stream, \"%f\\n\", cfg->entries[i].val.floating);\n            break;\n        case CFG_TYPE_COLOR:;\n            CfgColor c = cfg->entries[i].val.color;\n            fprintf(stream, \"rgba(%d, %d, %d, %d)\\n\", c.r, c.g, c.b, c.a);\n            break;\n        }\n    }\n}\n","numLines":744,"startLine":1,"totalLines":744}}}
