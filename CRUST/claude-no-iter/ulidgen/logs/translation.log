(ulid);\n            return;\n        }\n\n        if let Some(idx) = b32_index(ulid[10 + i as usize]) {\n            // The C code does *(s+1), which is safe because the largest valid\n            // index is 31 ('Z') — but in that case we already replaced 'Z'\n            // with '0' in the loop above, so idx < 31 here.\n            ulid[10 + i as usize] = B32_ALPHABET[idx + 1] as char;\n            return;\n        }\n        // Otherwise (invalid char encountered), fall through and randomize.\n    }\n\n    // Generate 16 random bytes and map each to a Base32 char.\n    let mut rnd = [0u8; 16];\n    getentropy(&mut rnd);\n\n    for i in 0..16 {\n        ulid[10 + i] = B32_ALPHABET[(rnd[i] % 32) as usize] as char;\n    }\n}\n\nfn getentropy(buf: &mut [u8]) {\n    use rand::RngCore;\n    rand::thread_rng().fill_bytes(buf);\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":348,"cache_read_input_tokens":21547,"cache_creation":{"ephemeral_5m_input_tokens":348,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ffde18ee-1808-40b4-b1fa-4e2565b7e12b","uuid":"778248e9-075a-41df-b7f0-eb37677d76ce"}
