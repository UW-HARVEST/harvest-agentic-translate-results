{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01NwhHRqwvjwfboibZsiyGA5","type":"tool_result","content":"1\tuse std::fs::File;\n2\tuse std::io::{Write, Read};\n3\tuse std::sync::Arc;\n4\tuse rand::{Rng, SeedableRng};\n5\tuse rand::rngs::StdRng;\n6\tuse std::f32;\n7\tuse std::cmp;\n8\tuse mvptree::mvptree::{MVPTree, MVPDatapoint, MVPDataType, MVPError};\n9\tuse mvptree::mvptree::mvptree_read;\n10\tconst MVP_BRANCHFACTOR: usize = 2;\n11\tconst MVP_PATHLENGTH: usize = 5;\n12\tconst MVP_LEAFCAP: usize = 25;\n13\tstatic mut NBCALCS: u64 = 0;\n14\tfn next_poisson_int(lambda: i32) -> i32 {\n15\t    let mut rng = rand::thread_rng();\n16\t    let mut l = (-lambda as f64).exp();\n17\t    let mut p = 1.0;\n18\t    let mut k = 0;\n19\t    while p > l {\n20\t        k += 1;\n21\t        p *= rng.r#gen::<f64>();\n22\t    }\n23\t    k - 1\n24\t}\n25\tfn point_l1_distance(point_a: &MVPDatapoint, point_b: &MVPDatapoint) -> f32 {\n26\t    if point_a.data.len() != point_b.data.len() {\n27\t        return -1.0;\n28\t    }\n29\t    let sum: u32 = point_a.data.iter()\n30\t        .zip(&point_b.data)\n31\t        .map(|(a, b)| (*a as i32 - *b as i32).abs() as u32)\n32\t        .sum();\n33\t    unsafe { NBCALCS += 1; }\n34\t    sum as f32 / point_a.data.len() as f32\n35\t}\n36\tfn point_l2_distance(point_a: &MVPDatapoint, point_b: &MVPDatapoint) -> f32 {\n37\t    if point_a.data.len() != point_b.data.len() {\n38\t        return -1.0;\n39\t    }\n40\t    let sum: i32 = point_a.data.iter()\n41\t        .zip(&point_b.data)\n42\t        .map(|(a, b)| (*a as i32 - *b as i32).pow(2))\n43\t        .sum();\n44\t    unsafe { NBCALCS += 1; }\n45\t    (sum as f32).sqrt() / point_a.data.len() as f32\n46\t}\n47\tfn generate_point(dp_length: usize) -> MVPDatapoint {\n48\t    let mut rng = StdRng::seed_from_u64(98293928);\n49\t    let id = format!(\"point{}\", rng.r#gen::<u64>());\n50\t    let data: Vec<u8> = (0..dp_length).map(|_| rng.r#gen()).collect();\n51\t    MVPDatapoint::new(id, data, MVPDataType::ByteArray)\n52\t}\n53\tfn generate_uniform_points(nbpoints: usize, dp_length: usize) -> Vec<MVPDatapoint> {\n54\t    (0..nbpoints).map(|_| generate_point(dp_length)).collect()\n55\t}\n56\tfn generate_cluster(nbpoints: usize, dplength: usize, var: i32, dist: fn(&MVPDatapoint, &MVPDatapoint) -> f32) -> Vec<MVPDatapoint> {\n57\t    let mut points = Vec::with_capacity(nbpoints);\n58\t    points.push(generate_point(dplength));\n59\t    let orig_data = points[0].data.clone();\n60\t    let mut rng = rand::thread_rng();\n61\t    let mut max_distance = 0.0;\n62\t    for _ in 1..nbpoints {\n63\t        let mut new_data = orig_data.clone();\n64\t        for val in &mut new_data {\n65\t            let diff = next_poisson_int(var);\n66\t            let toss: f32 = rng.r#gen();\n67\t            let mut v = if toss > 0.5 { diff } else { -diff };\n68\t            v += *val as i32;\n69\t            *val = cmp::min(255, cmp::max(0, v)) as u8;\n70\t        }\n71\t        let new_point = MVPDatapoint { id: format!(\"point{}\", rng.r#gen::<u64>()), data: new_data, path: vec![], datalen: dplength, data_type: MVPDataType::ByteArray };\n72\t        let d = dist(&points[0], &new_point);\n73\t        if d > max_distance {\n74\t            max_distance = d;\n75\t        }\n76\t        points.push(new_point);\n77\t    }\n78\t    println!(\"Cluster - maximum distance from main point: {}\", max_distance);\n79\t    points\n80\t}\n81\t#[test]\n82\tfn test() {\n83\t    let nbpoints = 100;\n84\t    let radius: f32 = 5.0;\n85\t    let nbcluster1 = nbpoints / 10;\n86\t    let knearest = nbpoints;\n87\t    let dplength = 10;\n88\t    let var = 10;\n89\t    let testfile = \"testfile.mvp\";\n90\t    let distance_func = point_l2_distance;\n91\t    let pointlist = generate_uniform_points(nbpoints, dplength);\n92\t    assert!(pointlist.len() == nbpoints);\n93\t    let cluster1 = generate_cluster(nbcluster1, dplength, var, distance_func);\n94\t    assert!(cluster1.len() == nbcluster1);\n95\t    let cluster_center = cluster1[0].clone();\n96\t    let mut tree = MVPTree::new(MVP_BRANCHFACTOR, MVP_PATHLENGTH, MVP_LEAFCAP, MVPDataType::ByteArray, distance_func);\n97\t    println!(\"Adding {} points to tree.\", nbpoints);\n98\t    let mut error: MVPError = tree.add(pointlist);\n99\t    assert!(error == MVPError::Success);\n100\t    println!(\"Adding {} cluster points to tree.\", nbcluster1);\n101\t    let mut error: MVPError = tree.add(cluster1);\n102\t    assert!(error == MVPError::Success);\n103\t    println!(\"Writing tree to file: {}\", testfile);\n104\t    let mut error: MVPError = tree.write(testfile, 00755);\n105\t    assert!(error == MVPError::Success);\n106\t    let mut tree = mvptree_read(testfile, distance_func).unwrap();\n107\t    let mut savedpoint: Option<MVPDatapoint> = None;\n108\t    for count in 0..(nbpoints / 10) {\n109\t        let pnt = generate_point(dplength);\n110\t        if count == 0 {\n111\t            savedpoint = Some(pnt.clone());\n112\t        }\n113\t        println!(\"Adding point: {} to tree.\", pnt.id);\n114\t        assert!(tree.add(vec![pnt]) == MVPError::Success);\n115\t    }\n116\t    println!(\"Retrieving point: {}\", cluster_center.id);\n117\t    let results = tree.retrieve(&cluster_center, knearest, radius).expect(\"Failed to retrieve points\");\n118\t    for (i, res) in results.iter().enumerate() {\n119\t        println!(\"  FOUND --> ({}) {}\", i, res.id);\n120\t    }\n121\t    if let Some(savedpoint) = savedpoint {\n122\t        println!(\"Retrieving point: {}\", savedpoint.id);\n123\t        let results = tree.retrieve(&savedpoint, knearest, radius).expect(\"Failed to retrieve points\");\n124\t        for (i, res) in results.iter().enumerate() {\n125\t            println!(\"  FOUND --> ({}) {}\", i, res.id);\n126\t        }\n127\t    }\n128\t    println!(\"Done.\");\n129\t}\n130\tpub fn main() {}"}]},"parent_tool_use_id":null,"session_id":"8f730729-7533-4b90-bd29-cb751183a717","uuid":"0343bb76-2284-4373-a40f-5dc2acc46796","timestamp":"2026-06-03T05:12:56.581Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-y84gDz/project/src/bin/testmvp.rs","content":"use std::fs::File;\nuse std::io::{Write, Read};\nuse std::sync::Arc;\nuse rand::{Rng, SeedableRng};\nuse rand::rngs::StdRng;\nuse std::f32;\nuse std::cmp;\nuse mvptree::mvptree::{MVPTree, MVPDatapoint, MVPDataType, MVPError};\nuse mvptree::mvptree::mvptree_read;\nconst MVP_BRANCHFACTOR: usize = 2;\nconst MVP_PATHLENGTH: usize = 5;\nconst MVP_LEAFCAP: usize = 25;\nstatic mut NBCALCS: u64 = 0;\nfn next_poisson_int(lambda: i32) -> i32 {\n    let mut rng = rand::thread_rng();\n    let mut l = (-lambda as f64).exp();\n    let mut p = 1.0;\n    let mut k = 0;\n    while p > l {\n        k += 1;\n        p *= rng.r#gen::<f64>();\n    }\n    k - 1\n}\nfn point_l1_distance(point_a: &MVPDatapoint, point_b: &MVPDatapoint) -> f32 {\n    if point_a.data.len() != point_b.data.len() {\n        return -1.0;\n    }\n    let sum: u32 = point_a.data.iter()\n        .zip(&point_b.data)\n        .map(|(a, b)| (*a as i32 - *b as i32).abs() as u32)\n        .sum();\n    unsafe { NBCALCS += 1; }\n    sum as f32 / point_a.data.len() as f32\n}\nfn point_l2_distance(point_a: &MVPDatapoint, point_b: &MVPDatapoint) -> f32 {\n    if point_a.data.len() != point_b.data.len() {\n        return -1.0;\n    }\n    let sum: i32 = point_a.data.iter()\n        .zip(&point_b.data)\n        .map(|(a, b)| (*a as i32 - *b as i32).pow(2))\n        .sum();\n    unsafe { NBCALCS += 1; }\n    (sum as f32).sqrt() / point_a.data.len() as f32\n}\nfn generate_point(dp_length: usize) -> MVPDatapoint {\n    let mut rng = StdRng::seed_from_u64(98293928);\n    let id = format!(\"point{}\", rng.r#gen::<u64>());\n    let data: Vec<u8> = (0..dp_length).map(|_| rng.r#gen()).collect();\n    MVPDatapoint::new(id, data, MVPDataType::ByteArray)\n}\nfn generate_uniform_points(nbpoints: usize, dp_length: usize) -> Vec<MVPDatapoint> {\n    (0..nbpoints).map(|_| generate_point(dp_length)).collect()\n}\nfn generate_cluster(nbpoints: usize, dplength: usize, var: i32, dist: fn(&MVPDatapoint, &MVPDatapoint) -> f32) -> Vec<MVPDatapoint> {\n    let mut points = Vec::with_capacity(nbpoints);\n    points.push(generate_point(dplength));\n    let orig_data = points[0].data.clone();\n    let mut rng = rand::thread_rng();\n    let mut max_distance = 0.0;\n    for _ in 1..nbpoints {\n        let mut new_data = orig_data.clone();\n        for val in &mut new_data {\n            let diff = next_poisson_int(var);\n            let toss: f32 = rng.r#gen();\n            let mut v = if toss > 0.5 { diff } else { -diff };\n            v += *val as i32;\n            *val = cmp::min(255, cmp::max(0, v)) as u8;\n        }\n        let new_point = MVPDatapoint { id: format!(\"point{}\", rng.r#gen::<u64>()), data: new_data, path: vec![], datalen: dplength, data_type: MVPDataType::ByteArray };\n        let d = dist(&points[0], &new_point);\n        if d > max_distance {\n            max_distance = d;\n        }\n        points.push(new_point);\n    }\n    println!(\"Cluster - maximum distance from main point: {}\", max_distance);\n    points\n}\n#[test]\nfn test() {\n    let nbpoints = 100;\n    let radius: f32 = 5.0;\n    let nbcluster1 = nbpoints / 10;\n    let knearest = nbpoints;\n    let dplength = 10;\n    let var = 10;\n    let testfile = \"testfile.mvp\";\n    let distance_func = point_l2_distance;\n    let pointlist = generate_uniform_points(nbpoints, dplength);\n    assert!(pointlist.len() == nbpoints);\n    let cluster1 = generate_cluster(nbcluster1, dplength, var, distance_func);\n    assert!(cluster1.len() == nbcluster1);\n    let cluster_center = cluster1[0].clone();\n    let mut tree = MVPTree::new(MVP_BRANCHFACTOR, MVP_PATHLENGTH, MVP_LEAFCAP, MVPDataType::ByteArray, distance_func);\n    println!(\"Adding {} points to tree.\", nbpoints);\n    let mut error: MVPError = tree.add(pointlist);\n    assert!(error == MVPError::Success);\n    println!(\"Adding {} cluster points to tree.\", nbcluster1);\n    let mut error: MVPError = tree.add(cluster1);\n    assert!(error == MVPError::Success);\n    println!(\"Writing tree to file: {}\", testfile);\n    let mut error: MVPError = tree.write(testfile, 00755);\n    assert!(error == MVPError::Success);\n    let mut tree = mvptree_read(testfile, distance_func).unwrap();\n    let mut savedpoint: Option<MVPDatapoint> = None;\n    for count in 0..(nbpoints / 10) {\n        let pnt = generate_point(dplength);\n        if count == 0 {\n            savedpoint = Some(pnt.clone());\n        }\n        println!(\"Adding point: {} to tree.\", pnt.id);\n        assert!(tree.add(vec![pnt]) == MVPError::Success);\n    }\n    println!(\"Retrieving point: {}\", cluster_center.id);\n    let results = tree.retrieve(&cluster_center, knearest, radius).expect(\"Failed to retrieve points\");\n    for (i, res) in results.iter().enumerate() {\n        println!(\"  FOUND --> ({}) {}\", i, res.id);\n    }\n    if let Some(savedpoint) = savedpoint {\n        println!(\"Retrieving point: {}\", savedpoint.id);\n        let results = tree.retrieve(&savedpoint, knearest, radius).expect(\"Failed to retrieve points\");\n        for (i, res) in results.iter().enumerate() {\n            println!(\"  FOUND --> ({}) {}\", i, res.id);\n        }\n    }\n    println!(\"Done.\");\n}\npub fn main() {}","numLines":130,"startLine":1,"totalLines":130}}}
