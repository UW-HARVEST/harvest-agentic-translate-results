 // but we still rebuild the full sequence whenever `value < m` so that","+    // the resulting buffer matches the byte-for-byte output of","+    // `for_compress_*(in_data[..=length])`.","     let bnew = if value >= m {","         required_bits(value - m)","     } else {","-        0","+        u32::MAX","     };","     if m > value || bnew > b {","         let mut tmp = vec![0u32; (length + 1) as usize];"]}],"originalFile":"pub const METADATA: i32 = 5;\n\n// ---------------- Generic helpers ----------------\n\npub(crate) fn pack_block(base: u32, input: &[u32], output: &mut [u8], k: usize, bits: u32) -> u32 {\n    if bits == 0 || k == 0 {\n        return 0;\n    }\n    let total_bits = (k as u32) * bits;\n    let total_bytes = ((total_bits + 7) / 8) as usize;\n\n    let num_chunks = ((total_bits + 31) / 32) as usize;\n    let mut chunks = vec![0u32; num_chunks];\n\n    for i in 0..k {\n        let raw = input[i].wrapping_sub(base);\n        let v = if bits == 32 {\n            raw\n        } else {\n            raw & ((1u32 << bits) - 1)\n        };\n        let bit_pos = (i as u32) * bits;\n        let chunk_idx = (bit_pos / 32) as usize;\n        let bit_in_chunk = bit_pos % 32;\n        if bit_in_chunk + bits <= 32 {\n            // bits == 32 implies bit_in_chunk == 0 here\n            if bits == 32 {\n                chunks[chunk_idx] |= v;\n            } else {\n                chunks[chunk_idx] |= v << bit_in_chunk;\n            }\n        } else {\n            let low_bits = 32 - bit_in_chunk;\n            chunks[chunk_idx] |= v << bit_in_chunk;\n            chunks[chunk_idx + 1] |= v >> low_bits;\n        }\n    }\n\n    for c in 0..num_chunks {\n        let start = c * 4;\n        let bytes = chunks[c].to_le_bytes();\n        for j in 0..4 {\n            if start + j < total_bytes {\n                output[start + j] = bytes[j];\n            }\n        }\n    }\n\n    total_bytes as u32\n}\n\npub(crate) fn unpack_block(base: u32, input: &[u8], output: &mut [u32], k: usize, bits: u32) -> u32 {\n    if bits == 0 {\n        for i in 0..k {\n            output[i] = base;\n        }\n        return 0;\n    }\n    if k == 0 {\n        return 0;\n    }\n\n    let total_bits = (k as u32) * bits;\n    let total_bytes = ((total_bits + 7) / 8) as usize;\n\n    let num_chunks = ((total_bytes + 3) / 4) as usize;\n    let mut chunks = vec![0u32; num_chunks];\n    for c in 0..num_chunks {\n        let start = c * 4;\n        let mut bytes = [0u8; 4];\n        for j in 0..4 {\n            if start + j < total_bytes && start + j < input.len() {\n                bytes[j] = input[start + j];\n            }\n        }\n        chunks[c] = u32::from_le_bytes(bytes);\n    }\n\n    for i in 0..k {\n        let bit_pos = (i as u32) * bits;\n        let chunk_idx = (bit_pos / 32) as usize;\n        let bit_in_chunk = bit_pos % 32;\n        let v: u32;\n        if bits == 32 {\n            v = chunks[chunk_idx];\n        } else if bit_in_chunk + bits <= 32 {\n            v = (chunks[chunk_idx] >> bit_in_chunk) & ((1u32 << bits) - 1);\n        } else {\n            let low_bits = 32 - bit_in_chunk;\n            let high_bits = bits - low_bits;\n            let low = chunks[chunk_idx] >> bit_in_chunk;\n            let high = chunks[chunk_idx + 1] & ((1u32 << high_bits) - 1);\n            v = (high << low_bits) | low;\n        }\n        output[i] = base.wrapping_add(v);\n    }\n    total_bytes as u32\n}\n\npub(crate) fn linsearch_block(\n    base: u32,\n    input: &[u8],\n    k: usize,\n    bits: u32,\n    value: u32,\n    found: &mut i32,\n) -> u32 {\n    if bits == 0 {\n        if value == base && k > 0 {\n            *found = 0;\n        }\n        return 0;\n    }\n    if k == 0 {\n        return 0;\n    }\n\n    let total_bits = (k as u32) * bits;\n    let total_bytes = ((total_bits + 7) / 8) as usize;\n\n    let v_target = value.wrapping_sub(base);\n\n    let num_chunks = ((total_bytes + 3) / 4) as usize;\n    let mut chunks = vec![0u32;