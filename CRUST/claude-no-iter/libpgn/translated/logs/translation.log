;\n264\t    assert_eq!(moves.values[0].black.captures, true);\n265\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::DubiousMove);\n266\t    assert!(moves.values[0].black.alternatives.is_some());\n267\t\n268\t    assert_eq!(\n269\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n270\t            .black\n271\t            .piece,\n272\t        PgnPiece::Pawn\n273\t    );\n274\t    assert_eq!(\n275\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n276\t            .black\n277\t            .dest\n278\t            .file,\n279\t        Some('e')\n280\t    );\n281\t    assert_eq!(\n282\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n283\t            .black\n284\t            .dest\n285\t            .rank,\n286\t        Some(5)\n287\t    );\n288\t    assert_eq!(\n289\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n290\t            .black\n291\t            .captures,\n292\t        false\n293\t    );\n294\t    assert_eq!(\n295\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n296\t            .black\n297\t            .annotation,\n298\t        PgnAnnotation::Unknown\n299\t    );\n300\t\n301\t    assert_eq!(\n302\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n303\t            .white\n304\t            .piece,\n305\t        PgnPiece::Pawn\n306\t    );\n307\t    assert_eq!(\n308\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n309\t            .white\n310\t            .dest\n311\t            .file,\n312\t        Some('e')\n313\t    );\n314\t    assert_eq!(\n315\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n316\t            .white\n317\t            .dest\n318\t            .rank,\n319\t        Some(4)\n320\t    );\n321\t    assert_eq!(\n322\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n323\t            .white\n324\t            .captures,\n325\t        false\n326\t    );\n327\t    assert_eq!(\n328\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n329\t            .white\n330\t            .annotation,\n331\t        PgnAnnotation::Unknown\n332\t    );\n333\t\n334\t    moves = PgnMoves::from(\"1.c4 ( 1.e4  ) c5 2.Nc3 Nc6\");\n335\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n336\t    assert_eq!(moves.values[0].white.dest.file, Some('c'));\n337\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n338\t    assert_eq!(moves.values[0].white.captures, false);\n339\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n340\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n341\t    assert_eq!(moves.values[0].black.dest.file, Some('c'));\n342\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n343\t    assert_eq!(moves.values[0].black.captures, false);\n344\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n345\t\n346\t    assert_eq!(\n347\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n348\t            .white\n349\t            .piece,\n350\t        PgnPiece::Pawn\n351\t    );\n352\t    assert_eq!(\n353\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n354\t            .white\n355\t            .dest\n356\t            .file,\n357\t        Some('e')\n358\t    );\n359\t    assert_eq!(\n360\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n361\t            .white\n362\t            .dest\n363\t            .rank,\n364\t        Some(4)\n365\t    );\n366\t    assert_eq!(\n367\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n368\t            .white\n369\t            .captures,\n370\t        false\n371\t    );\n372\t    assert_eq!(\n373\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n374\t            .white\n375\t            .annotation,\n376\t        PgnAnnotation::Unknown\n377\t    );\n378\t\n379\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n380\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n381\t    assert_eq!(moves.values[1].white.dest.rank, Some(3));\n382\t    assert_eq!(moves.values[1].white.captures, false);\n383\t    assert_eq!(moves.values[1].white.annotation, PgnAnnotation::Unknown);\n384\t\n385\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n386\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n387\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n388\t    assert_eq!(moves.values[1].black.captures, false);\n389\t    assert_eq!(moves.values[1].black.annotation, PgnAnnotation::Unknown);\n390\t}\n391\t\n392\t#[test]\n393\tfn test_parsing_en_passant() {\n394\t    let mv = PgnMove::from(\"exd6 e.p.\");\n395\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n396\t    assert!(mv.en_passant);\n397\t    assert_eq!(mv.from.file, Some('e'));\n398\t    assert_eq!(mv.dest.file, Some('d'));\n399\t    assert_eq!(mv.dest.rank, Some(6));\n400\t    assert!(mv.captures);\n401\t\n402\t    let moves = PgnMoves::from(\"1. d4 exd3 e.p. 2. Nc4 Nc6 3. cxb3 e.p. 3... Be4\");\n403\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n404\t    assert_eq!(moves.values[0].white.dest.file, Some('d'));\n405\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n406\t    assert_eq!(moves.values[0].white.notation, \"d4\");\n407\t    assert!(!moves.values[0].white.en_passant);\n408\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n409\t    assert_eq!(moves.values[0].black.from.file, Some('e'));\n410\t    assert_eq!(moves.values[0].black.dest.file, Some('d'));\n411\t    assert_eq!(moves.values[0].black.dest.rank, Some(3));\n412\t    assert_eq!(moves.values[0].black.notation, \"exd3 e.p.\");\n413\t    assert!(moves.values[0].black.en_passant);\n414\t\n415\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n416\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n417\t    assert_eq!(moves.values[1].white.dest.rank, Some(4));\n418\t    assert_eq!(moves.values[1].white.notation, \"Nc4\");\n419\t    assert!(!moves.values[1].white.en_passant);\n420\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n421\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n422\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n423\t    assert_eq!(moves.values[1].black.notation, \"Nc6\");\n424\t    assert!(!moves.values[1].black.en_passant);\n425\t\n426\t    assert_eq!(moves.values[2].white.piece, PgnPiece::Pawn);\n427\t    assert_eq!(moves.values[2].white.from.file, Some('c'));\n428\t    assert_eq!(moves.values[2].white.dest.file, Some('b'));\n429\t    assert_eq!(moves.values[2].white.dest.rank, Some(3));\n430\t    assert_eq!(moves.values[2].white.notation, \"cxb3 e.p.\");\n431\t    assert!(moves.values[2].white.en_passant);\n432\t    assert_eq!(moves.values[2].black.piece, PgnPiece::Bishop);\n433\t    assert_eq!(moves.values[2].black.dest.file, Some('e'));\n434\t    assert_eq!(moves.values[2].black.dest.rank, Some(4));\n435\t    assert_eq!(moves.values[2].black.notation, \"Be4\");\n436\t    assert!(!moves.values[2].black.en_passant);\n437\t}\n438\t\n439\t#[test]\n440\tfn test_parsing_moves_with_alternatives() {\n441\t    let mut moves: PgnMoves;\n442\t\n443\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5\");\n444\t    assert_eq!(moves.values.len(), 1);\n445\t    assert_eq!(\n446\t        moves.values[0]\n447\t            .white\n448\t            .alternatives\n449\t            .as_ref()\n450\t            .unwrap()\n451\t            .values\n452\t            .len(),\n453\t        1\n454\t    );\n455\t    assert_eq!(\n456\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n457\t            .white\n458\t            .notation,\n459\t        \"f4?\"\n460\t    );\n461\t    assert_eq!(\n462\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n463\t            .black\n464\t            .notation,\n465\t        \"e5!\"\n466\t    );\n467\t    assert_eq!(\n468\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n469\t            .white\n470\t            .notation,\n471\t        \"g4??\"\n472\t    );\n473\t    assert_eq!(\n474\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n475\t            .black\n476\t            .notation,\n477\t        \"Qh4#\"\n478\t    );\n479\t\n480\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) (1. e4 f6? 2. d4 g5?? 3. Qh5#) e5\");\n481\t    assert_eq!(moves.values.len(), 1);\n482\t    assert_eq!(\n483\t        moves.values[0]\n484\t            .white\n485\t            .alternatives\n486\t            .as_ref()\n487\t            .unwrap()\n488\t            .values\n489\t            .len(),\n490\t        2\n491\t    );\n492\t    assert_eq!(\n493\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n494\t            .white\n495\t            .notation,\n496\t        \"f4?\"\n497\t    );\n498\t    assert_eq!(\n499\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n500\t            .black\n501\t            .notation,\n502\t        \"e5!\"\n503\t    );\n504\t    assert_eq!(\n505\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n506\t            .white\n507\t            .notation,\n508\t        \"g4??\"\n509\t    );\n510\t    assert_eq!(\n511\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n512\t            .black\n513\t            .notation,\n514\t        \"Qh4#\"\n515\t    );\n516\t    assert_eq!(\n517\t        moves.values[0].white.alternatives.as_ref().unwrap().values[1].values[0]\n518\t            .white\n519\t            .notation,\n520\t        \"e4\