t        PgnAlternativeMoves::new()\n440\t    }\n441\t}\n442\t\n443\t/// Polls comments into an `Option<PgnComments>` placeholder, allocating it on\n444\t/// first use. Returns the number of bytes consumed.\n445\tfn poll_into_option_placeholder(\n446\t    placeholder: &mut Option<PgnComments>,\n447\t    pos: PgnCommentPosition,\n448\t    s: &str,\n449\t) -> usize {\n450\t    let bytes = s.as_bytes();\n451\t    if bytes.is_empty() || bytes[0] != b'{' {\n452\t        return 0;\n453\t    }\n454\t    if placeholder.is_none() {\n455\t        *placeholder = Some(PgnComments::new());\n456\t    }\n457\t    placeholder.as_mut().unwrap().poll(pos, s)\n458\t}\n459\t\n460\t/// Returns true if the string starts with a parseable PGN score (i.e. game\n461\t/// terminator). We must not consume — we only need to check if a score starts\n462\t/// here, mirroring `pgn_score_from_string` returning a non-Unknown value.\n463\tfn score_starts_here(s: &str) -> bool {\n464\t    let mut consumed = 0usize;\n465\t    let score = PgnScore::from_string_with_consumption(s, &mut consumed);\n466\t    score != PgnScore::Unknown\n467\t}\n468\t\n469\tfn parse_moves_recurse(\n470\t    s: &str,\n471\t    consumed: &mut usize,\n472\t    moves: &mut PgnMoves,\n473\t    expect: i32,\n474\t) {\n475\t    let bytes = s.as_bytes();\n476\t\n477\t    if bytes.is_empty() || bytes[0] == b')' || bytes[0] == b'\\0' {\n478\t        return;\n479\t    }\n480\t\n481\t    let mut cursor: usize = 0;\n482\t    let mut item = PgnMovesItem::default();\n483\t\n484\t    let mut comments: Option<PgnComments> = None;\n485\t\n486\t    pgn_cursor_skip_whitespace(s, &mut cursor);\n487\t    cursor += poll_into_option_placeholder(\n488\t        &mut comments,\n489\t        PgnCommentPosition::BeforeMove,\n490\t        &s[cursor..],\n491\t    );\n492\t\n493\t    assert!(cursor < bytes.len() && (bytes[cursor] as char).is_ascii_digit());\n494\t    while cursor < bytes.len() && (bytes[cursor] as char).is_ascii_digit() {\n495\t        cur