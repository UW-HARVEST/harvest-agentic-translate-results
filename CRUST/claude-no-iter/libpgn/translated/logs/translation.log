 PgnPiece::Knight => 'N',\n253\t                    PgnPiece::Bishop => 'B',\n254\t                    PgnPiece::Queen => 'Q',\n255\t                    PgnPiece::King => 'K',\n256\t                    PgnPiece::Unknown => '\\0',\n257\t                };\n258\t                out.push(c);\n259\t            }\n260\t\n261\t            if let Some(file) = self.from.file {\n262\t                out.push(file);\n263\t            }\n264\t            if let Some(rank) = self.from.rank {\n265\t                out.push((b'0' + rank as u8) as char);\n266\t            }\n267\t\n268\t            if self.captures {\n269\t                out.push('x');\n270\t            }\n271\t\n272\t            if let Some(file) = self.dest.file {\n273\t                out.push(file);\n274\t            }\n275\t            if let Some(rank) = self.dest.rank {\n276\t                out.push((b'0' + rank as u8) as char);\n277\t            }\n278\t\n279\t            if self.promoted_to != PgnPiece::Unknown {\n280\t                assert!(self.piece == PgnPiece::Pawn);\n281\t                assert!(self.promoted_to != PgnPiece::Pawn);\n282\t                out.push('=');\n283\t                let c = match self.promoted_to {\n284\t                    PgnPiece::Pawn => 'P',\n285\t                    PgnPiece::Rook => 'R',\n286\t                    PgnPiece::Knight => 'N',\n287\t                    PgnPiece::Bishop => 'B',\n288\t                    PgnPiece::Queen => 'Q',\n289\t                    PgnPiece::King => 'K',\n290\t                    PgnPiece::Unknown => '\\0',\n291\t                };\n292\t                out.push(c);\n293\t            }\n294\t        }\n295\t\n296\t        // check\n297\t        match self.check {\n298\t            PgnCheck::None => {}\n299\t            PgnCheck::Mate => out.push('#'),\n300\t            PgnCheck::Single => out.push('+'),\n301\t            PgnCheck::Double => {\n302\t                out.push('+');\n303\t                out.push('+');\n304\t            }\