e.left.as_ref() {\n        print_ast(left, level + 1);\n    }\n    if let Some(right) = node.right.as_ref() {\n        print_ast(right, level + 1);\n    }\n}\n\n/// Replicates: char* get_opcode_name(OpCode opcode);\npub fn get_opcode_name(opcode: vm::OpCode) -> String {\n    match opcode {\n        vm::OpCode::LOAD_CONST => \"LOAD_CONST\".to_string(),\n        vm::OpCode::LOAD_NAME => \"LOAD_NAME\".to_string(),\n        vm::OpCode::STORE_NAME => \"STORE_NAME\".to_string(),\n        vm::OpCode::BINARY_ADD => \"BINARY_ADD\".to_string(),\n        vm::OpCode::BINARY_SUB => \"BINARY_SUB\".to_string(),\n        vm::OpCode::STK_DIS => \"STK_DIS\".to_string(),\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1410,"cache_read_input_tokens":50059,"cache_creation":{"ephemeral_5m_input_tokens":1410,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"74a5da78-9991-4683-a9e1-e1d8e48b4a07","uuid":"6fe24579-4090-48ee-bf01-02deba4b3fb8"}
