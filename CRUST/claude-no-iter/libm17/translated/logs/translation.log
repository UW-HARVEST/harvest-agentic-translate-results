52\t\n53\t    size_t pos = 0;\n54\t    for(size_t i = 0; i < len; i += 2)\n55\t    {\n56\t        uint16_t s0 = in[i];\n57\t        uint16_t s1 = in[i + 1];\n58\t\n59\t        viterbi_decode_bit(s0, s1, pos);\n60\t        pos++;\n61\t    }\n62\t\n63\t    return viterbi_chainback(out, pos, len/2);\n64\t}\n65\t\n66\t/**\n67\t * @brief Decode punctured convolutionally encoded data.\n68\t *\n69\t * @param out Destination array where decoded data is written.\n70\t * @param in Input data.\n71\t * @param punct Puncturing matrix.\n72\t * @param in_len Input data length.\n73\t * @param p_len Puncturing matrix length (entries).\n74\t * @return Number of bit errors corrected.\n75\t */\n76\tuint32_t viterbi_decode_punctured(uint8_t* out, const uint16_t* in, const uint8_t* punct, const uint16_t in_len, const uint16_t p_len)\n77\t{\n78\t    if(in_len > 244*2)\n79\t\t\tfprintf(stderr, \"Input size exceeds max history\\n\");\n80\t\n81\t\tuint16_t umsg[244*2];           //unpunctured message\n82\t\tuint8_t p=0;\t\t            //puncturer matrix entry\n83\t\tuint16_t u=0;\t\t            //bits count - unpunctured message\n84\t    uint16_t i=0;                   //bits read from the input message\n85\t\n86\t\twhile(i<in_len)\n87\t\t{\n88\t\t\tif(punct[p])\n89\t\t\t{\n90\t\t\t\tumsg[u]=in[i];\n91\t\t\t\ti++;\n92\t\t\t}\n93\t\t\telse\n94\t\t\t{\n95\t\t\t\tumsg[u]=0x7FFF;\n96\t\t\t}\n97\t\n98\t\t\tu++;\n99\t\t\tp++;\n100\t\t\tp%=p_len;\n101\t\t}\n102\t\n103\t    return viterbi_decode(out, umsg, u) - (u-in_len)*0x7FFF;\n104\t}\n105\t\n106\t/**\n107\t * @brief Decode one bit and update trellis.\n108\t *\n109\t * @param s0 Cost of the first symbol.\n110\t * @param s1 Cost of the second symbol.\n111\t * @param pos Bit position in history.\n112\t */\n113\tvoid viterbi_decode_bit(uint16_t s0, uint16_t s1, const size_t pos)\n114\t{\n115\t    static const uint16_t COST_TABLE_0[] = {0, 0, 0, 0, 0xFFFF, 0xFFFF, 0xFFFF, 0xFFFF};\n116\t    static const uint16_t COST_TABLE_1[] = {0, 0xFFFF, 0xFFFF, 0, 0, 0xFFFF, 0xFFFF, 0};\n117\t\n118\t    for(uint8_t i = 0; i < NUM_STATES/2; i++)\n119\t    {\n120\t        uint32_t metric = q_abs_diff(COST_TABLE_0[i], s0)\n121\t                        + q_abs_diff(COST_TABLE_1[i], s1);\n122\t\n123\t\n124\t        uint32_t m0 = prevMetrics[i] + metric;\n125\t        uint32_t m1 = prevMetrics[i + NUM_STATES/2] + (0x1FFFE - metric);\n126\t\n127\t        uint32_t m2 = prevMetrics[i] + (0x1FFFE - metric);\n128\t        uint32_t m3 = prevMetrics[i + NUM_STATES/2] + metric;\n129\t\n130\t        uint8_t i0 = 2 * i;\n131\t        uint8_t i1 = i0 + 1;\n132\t\n133\t        if(m0 >= m1)\n134\t        {\n135\t            viterbi_history[pos]|=(1<<i0);\n136\t            currMetrics[i0] = m1;\n137\t        }\n138\t        else\n139\t        {\n140\t            viterbi_history[pos]&=~(1<<i0);\n141\t            currMetrics[i0] = m0;\n142\t        }\n143\t\n144\t        if(m2 >= m3)\n145\t        {\n146\t            viterbi_history[pos]|=(1<<i1);\n147\t            currMetrics[i1] = m3;\n148\t        }\n149\t        else\n150\t        {\n151\t            viterbi_history[pos]&=~(1<<i1);\n152\t            currMetrics[i1] = m2;\n153\t        }\n154\t    }\n155\t\n156\t    //swap\n157\t    uint32_t tmp[NUM_STATES];\n158\t    for(uint8_t i=0; i<NUM_STATES; i++)\n159\t    {\n160\t    \ttmp[i]=currMetrics[i];\n161\t\t}\n162\t\tfor(uint8_t i=0; i<NUM_STATES; i++)\n163\t    {\n164\t    \tcurrMetrics[i]=prevMetrics[i];\n165\t    \tprevMetrics[i]=tmp[i];\n166\t\t}\n167\t}\n168\t\n169\t/**\n170\t * @brief History chainback to obtain final byte array.\n171\t *\n172\t * @param out Destination byte array for decoded data.\n173\t * @param pos Starting position for the chainback.\n174\t * @param len Length of the output in bits.\n175\t * @return Minimum Viterbi cost at the end of the decode sequence.\n176\t */\n177\tuint32_t viterbi_chainback(uint8_t* out, size_t pos, uint16_t len)\n178\t{\n179\t    uint8_t state = 0;\n180\t    size_t bitPos = len+4;\n181\t\n182