ist[2] - symbol_list[1]);\n            v = f as u16;\n        } else {\n            v = 0xFFFF;\n        }\n        out[i * 2] = (v >> 8) as u8;\n    }\n}","newString":"pub fn slice_symbols(out: &mut [u8; SYM_PER_PLD * 2], inp: &[u8; SYM_PER_PLD]) {\n    // Note: The C version processes float symbols (~ {-3,-1,+1,+3}) and emits\n    // uint16_t soft bits. The Rust signature here uses u8 for both input and\n    // output. We replicate the slicing logic by interpreting `inp[i]` as an i8\n    // symbol (so values 0xFD, 0xFF, 0x01, 0x03 map to -3, -1, +1, +3) and\n    // emit the high byte of the resulting soft value as u8.\n    let symbol_list: [f32; 4] = [-3.0, -1.0, 1.0, 3.0];\n    for i in 0..SYM_PER_PLD {\n        let s = inp[i] as i8 as f32;\n\n        // bit 0 (stored at out[i*2+1] in C)\n        let v: u16 = if s >= symbol_list[3] {\n            0xFFFF\n        } else if s >= symbol_list[2] {\n            let f = -(0xFFFF as f32) / (symbol_list[3] - symbol_list[2]) * symbol_list[2]\n                + s * (0xFFFF as f32) / (symbol_list[3] - symbol_list[2]);\n            f as u16\n        } else if s >= symbol_list[1] {\n            0x0000\n        } else if s >= symbol_list[0] {\n            let f = (0xFFFF as f32) / (symbol_list[1] - symbol_list[0]) * symbol_list[1]\n                - s * (0xFFFF as f32) / (symbol_list[1] - symbol_list[0]);\n            f as u16\n        } else {\n            0xFFFF\n        };\n        out[i * 2 + 1] = (v >> 8) as u8;\n\n        // bit 1 (stored at out[i*2] in C)\n        let v: u16 = if s >= symbol_list[2] {\n            0x0000\n        } else if s >= symbol_list[1] {\n            let f = 0x7FFF as f32 - s * (0xFFFF as f32) / (symbol_list[2] - symbol_list[1]);\n            f as u16\n        } else {\n            0xFFFF\n        };\n        out[i * 2] = (v >> 8) as u8;\n    }\n}","originalFile":"use crate::math::soft_bit_not;\nuse crate::types::SYM_PER_PLD;\n\npub const SYNC_LSF: u16 = 0x55F7;\npub const SYNC_STR: u16 = 0xFF5D;