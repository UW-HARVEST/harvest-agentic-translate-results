n108\t{\n109\t\tVal a, b;\n110\t\tint len = tsp_lstlen(args);\n111\t\tif (len != 2 && len != 1)\n112\t\t\ttsp_warnf(\"-: expected 1 or 2 arguments, recieved %d\", len);\n113\t\ta = car(args);\n114\t\ttsp_arg_type(a, \"-\", TSP_NUM);\n115\t\tif (len == 1) {\n116\t\t\tb = a;\n117\t\t\ta = mk_int(0);\n118\t\t} else {\n119\t\t\tb = cadr(args);\n120\t\t\ttsp_arg_type(b, \"-\", TSP_NUM);\n121\t\t}\n122\t\tif (a->t & TSP_DEC || b->t & TSP_DEC)\n123\t\t\treturn mk_dec((num(a)/den(a)) - (num(b)/den(b)));\n124\t\treturn (mk_num(a->t, b->t, 0))\n125\t\t\t(num(a) * den(b) - den(a) * num(b),\n126\t\t\t den(a) * den(b));\n127\t}\n128\t\n129\tstatic Val\n130\tprim_mul(Tsp st, Rec vars, Val args)\n131\t{\n132\t\tVal a, b;\n133\t\ttsp_arg_num(args, \"*\", 2);\n134\t\ta = car(args), b = cadr(args);\n135\t\ttsp_arg_type(a, \"*\", TSP_NUM);\n136\t\ttsp_arg_type(b, \"*\", TSP_NUM);\n137\t\tif (a->t & TSP_DEC || b->t & TSP_DEC)\n138\t\t\treturn mk_dec((num(a)/den(a)) * (num(b)/den(b)));\n139\t\treturn (mk_num(a->t, b->t, 0))(num(a) * num(b), den(a) * den(b));\n140\t\n141\t}\n142\t\n143\tstatic Val\n144\tprim_div(Tsp st, Rec vars, Val args)\n145\t{\n146\t\tVal a, b;\n147\t\tint len = tsp_lstlen(args);\n148\t\tif (len != 2 && len != 1)\n149\t\t\ttsp_warnf(\"/: expected 1 or 2 arguments, recieved %d\", len);\n150\t\ta = car(args);\n151\t\ttsp_arg_type(a, \"/\", TSP_NUM);\n152\t\tif (len == 1) {\n153\t\t\tb = a;\n154\t\t\ta = mk_int(1);\n155\t\t} else {\n156\t\t\tb = cadr(args);\n157\t\t\ttsp_arg_type(b, \"/\", TSP_NUM);\n158\t\t}\n159\t\tif (a->t & TSP_DEC || b->t & TSP_DEC)\n160\t\t\treturn mk_dec((num(a)/den(a)) / (num(b)/den(b)));\n161\t\treturn (mk_num(a->t, b->t, 1))(num(a) * den(b), den(a) * num(b));\n162\t}\n163\t\n164\tstatic Val\n165\tprim_mod(Tsp st, Rec vars, Val args)\n166\t{\n167\t\tVal a, b;\n168\t\ttsp_arg_num(args, \"mod\", 2);\n169\t\ta = car(args), b = cadr(args);\n170\t\ttsp_arg_type(a, \"mod\", TSP_INT);\n171\t\ttsp_arg_type(b, \"mod\", TSP_INT);\n172\t\tif (num(b) == 0)\n173\t\t\ttsp_warn(\"division by zero\");\n174\t\treturn mk_int((int)num(a) % abs((int)num(b)));\n175\t}\n176\t\n177\t/* TODO if given function as 2nd arg run it on first arg */\n178\tstatic Val\n179\tprim_pow(Tsp st, Rec vars, Val args)\n180\t{\n181\t\tVal b, p;\n182\t\tdouble bnum, bden;\n183\t\ttsp_arg_num(args, \"pow\", 2);\n184\t\tb = car(args), p = cadr(args);\n185\t\ttsp_arg_type(b, \"pow\", TSP_EXPR);\n186\t\ttsp_arg_type(p, \"pow\", TSP_EXPR);\n187\t\tbnum = pow(num(b), num(p)/den(p));\n188\t\tbden = pow(den(b), num(p)/den(p));\n189\t\tif ((bnum == (int)bnum && bden == (int)bden) ||\n190\t\t     b->t & TSP_DEC || p->t & TSP_DEC)\n191\t\t\treturn mk_num(b->t, p->t, 0)(bnum, bden);\n192\t\treturn mk_list(st, 3, mk_sym(st, \"^\"), b, p);\n193\t}\n194\t\n195\t#define PRIM_COMPARE(NAME, OP)                          \\\n196\tstatic Val                                              \\\n197\tprim_##NAME(Tsp st, Rec vars, Val args)                 \\\n198\t{                                                       \\\n199\t\tif (tsp_lstlen(args) != 2)                      \\\n200\t\t\treturn st->t;                           \\\n201\t\ttsp_arg_type(car(args), #OP, TSP_NUM);          \\\n202\t\ttsp_arg_type(car(cdr(args)), #OP, TSP_NUM);     \\\n203\t\treturn ((num(car(args))*den(car(cdr(args)))) OP \\\n204\t\t\t(num(car(cdr(args)))*den(car(args)))) ? \\\n205\t\t\tst->t : st->nil;                        \\\n206\t}\n207\t\n208\tPRIM_COMPARE(lt,  <)\n209\tPRIM_COMPARE(gt,  >)\n210\tPRIM_COMPARE(lte, <=)\n211\tPRIM_COMPARE(gte, >=)\n212\t\n213\t#define PRIM_TRIG(NAME)                                      \\\n214\tstatic Val                                                   \\\n215\tprim_##NAME(Tsp st, Rec vars, Val args)                      \\\n216\t{                                                            \\\n217\t\ttsp_arg_num(args, #NAME, 1);                         \\\n218\t\ttsp_arg_type(car(args), #NAME, TSP_EXPR);            \\\n219\t\tif (car(args)->t & TSP_DEC)                          \\\n220\t\t\treturn mk_dec(NAME(num(car(args))));         \\\n221\t\treturn mk_list(st, 2, mk_sym(st, #NAME), car(args)); \\\n222\t}\n223\t\n224\tPRIM_TRIG(sin)\n225\tPRIM_TRIG(cos)\n226\tPRIM_TRIG(tan)\n227\tPRIM_TRIG(sinh)\n228\tPRIM_TRIG(cosh)\n229\tPRIM_TRIG(tanh)\n230\tPRIM_TRIG(asin)\n231\tPRIM_TRIG(acos)\n232\tPRIM_TRIG(atan)\n233\tPRIM_TRIG(asinh)\n234\tPRIM_TRIG(acosh)\n235\tPRIM_TRIG(atanh)\n236\tPRIM_TRIG(exp)\n237\tPRIM_TRIG(log)\n238\t\n239\tstatic Val\n240\tprim_numerator(Tsp st, Rec env, Val args)\n241\t{\n242\t\ttsp_arg_num(args, \"numerator\", 1);\n243\t\ttsp_arg_type(car(args), \"numerator\", TSP_INT | TSP_RATIO);\n244\t\treturn mk_int(car(args)->v.n.num);\n245\t}\n246\t\n247\tstatic Val\n248\tprim_denominator(Tsp st, Rec env, Val args)\n249\t{\n250\t\ttsp_arg_num(args, \"denominator\", 1);\n251\t\ttsp_arg_type(car(args), \"denominator\", TSP_INT | TSP_RATIO);\n252\t\treturn mk_int(car(args)->v.n.den);\n253\t}\n254\t\n255\tvoid\n256\ttib_env_math(Tsp st)\n257\t{\n258\t\ttsp_env_prim(Int);\n259\t\ttsp_env_prim(Dec);\n260\t\ttsp_env_prim(floor);\n261\t\ttsp_env_prim(ceil);\n262\t\ttsp_env_prim(round);\n263\t\ttsp_env_prim(numerator);\n264\t\ttsp_env_prim(denominator);\n265\t\n266\t\ttsp_env_name_prim(+, add);\n267\t\ttsp_env_name_prim(-, sub);\n268\t\ttsp_env_name_prim(*, mul);\n269\t\ttsp_env_name_prim(/, div);\n270\t\ttsp_env_prim(mod);\n271\t\ttsp_env_name_prim(^, pow);\n272\t\n273\t\ttsp_env_name_prim(<,  lt);\n274\t\ttsp_env_name_prim(>,  gt);\n275\t\ttsp_env_name_prim(<=, lte);\n276\t\ttsp_env_name_prim(>=, gte);\n277\t\n278\t\ttsp_env_prim(sin);\n279\t\ttsp_env_prim(cos);\n280\t\ttsp_env_prim(tan);\n281\t\ttsp_env_prim(sinh);\n282\t\ttsp_env_prim(cosh);\n283\t\ttsp_env_prim(tanh);\n284\t\ttsp_env_name_prim(arcsin,  asin);\n285\t\ttsp_env_name_prim(arccos,  acos);\n286\t\ttsp_env_name_prim(arctan,  atan);\n287\t\ttsp_env_name_prim(arcsinh, asinh);\n288\t\ttsp_env_name_prim(arccosh, acosh);\n289\t\ttsp_env_name_prim(arc