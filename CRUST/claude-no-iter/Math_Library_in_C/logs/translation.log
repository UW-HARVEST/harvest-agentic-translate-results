0;\n    }\n    if k >= -1022 {\n        let bits: u64 = ((k + 1023) as u64) << 52;\n        f64::from_bits(bits)\n    } else {\n        // Subnormal range: 2^k for k < -1022.\n        let shift = (-1022 - k) as u32;\n        if shift > 52 {\n            return 0.0;\n        }\n        let bits: u64 = 1u64 << (52 - shift);\n        f64::from_bits(bits)\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":900,"cache_read_input_tokens":43672,"cache_creation":{"ephemeral_5m_input_tokens":900,"ephemeral_1h_input_tokens":0},"output_tokens":41,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"731c8aad-e55f-489a-bd44-c2b1d8760b68","uuid":"6a58476a-3613-4c16-8484-44d2e1ece296"}
