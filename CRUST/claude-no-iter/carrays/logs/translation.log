{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01YXHJSKHc6dt3pgkK1S5ESu","type":"tool_result","content":"1\t#define _XOPEN_SOURCE /* drand48() */\n2\t#include <stdlib.h> // drand48()\n3\t#include <string.h>\n4\t#include <assert.h>\n5\t#include \"carrays.h\"\n6\t\n7\t//\n8\t// Generic C Arrays\n9\t//\n10\t// All functions have the gca_ prefix\n11\t//\n12\t// 2015-10-24 Isaac Turner (turner.isaac@gmail.com)\n13\t//\n14\t\n15\t//\n16\t// TODO:\n17\t// 1. quickselect using median of medians\n18\t//\n19\t\n20\t// Get Greatest Common Divisor using binary GCD algorithm\n21\t// http://en.wikipedia.org/wiki/Binary_GCD_algorithm\n22\tuint32_t gca_calc_GCD(uint32_t a, uint32_t b)\n23\t{\n24\t  uint32_t shift;\n25\t\n26\t  if(a == 0) return b;\n27\t  if(b == 0) return a;\n28\t\n29\t  // Find power of two divisor\n30\t  for(shift = 0; ((a | b) & 1) == 0; shift++) { a >>= 1; b >>= 1; }\n31\t\n32\t  // Remove remaining factors of two from a - they are not common\n33\t  while((a & 1) == 0) a >>= 1;\n34\t\n35\t  do\n36\t  {\n37\t    // Remove remaining factors of two from b - they are not common\n38\t    while((b & 1) == 0) b >>= 1;\n39\t\n40\t    if(a > b) { SWAP(a,b); }\n41\t    b = b - a;\n42\t  }\n43\t  while(b != 0);\n44\t\n45\t  return a << shift;\n46\t}\n47\t\n48\t// cyclic-shift an array by `shift` elements\n49\t// cycle left shifts towards zero\n50\tvoid gca_cycle_left(void *_ptr, size_t n, size_t es, size_t shift)\n51\t{\n52\t  char *ptr = (char*)_ptr;\n53\t  if(n <= 1 || !shift) return; // cannot mod by zero\n54\t  shift = shift % n; // shift cannot be greater than n\n55\t\n56\t  // Using GCD\n57\t  size_t i, j, k, gcd = gca_calc_GCD(n, shift);\n58\t  char tmp[es];\n59\t\n60\t  // i is initial starting position\n61\t  // Copy from k -> j, stop if k == i, since arr[i] already overwritten\n62\t  for(i = 0; i < gcd; i++) {\n63\t    memcpy(tmp, ptr+es*i, es); // tmp = arr[i]\n64\t    for(j = i; 1; j = k) {\n65\t      k = j+shift;\n66\t      if(k >= n) k -= n;\n67\t      if(k == i) break;\n68\t      memcpy(ptr+es*j, ptr+es*k, es); // arr[j] = arr[k];\n69\t    }\n70\t    memcpy(ptr+es*j, tmp, es); // arr[j] = tmp;\n71\t  }\n72\t}\n73\t\n74\t// cycle right shifts away from zero\n75\tvoid gca_cycle_right(void *_ptr, size_t n, size_t es, size_t shift)\n76\t{\n77\t  if(!n || !shift) return; // cannot mod by zero\n78\t  shift = shift % n; // shift cannot be greater than n\n79\t  // cycle right by `s` is equivalent to cycle left by `n - s`\n80\t  gca_cycle_left(_ptr, n, es, n - shift);\n81\t}\n82\t\n83\tvoid gca_reverse(void *_ptr, size_t n, size_t es)\n84\t{\n85\t  if(n <= 1 || !es) return;\n86\t  char *a = (char*)_ptr, *b = a + es*(n-1);\n87\t  for(; a < b; a += es, b -= es) gca_swapm(a, b, es);\n88\t}\n89\t\n90\t// Shuffle entire array\n91\t// Fisher-Yates shuffle. Initiate srand48() before calling.\n92\tvoid gca_shuffle(void *base, size_t n, size_t es)\n93\t{\n94\t  gca_sample(base, n, es, n);\n95\t}\n96\t\n97\t// Sample m elements by moving them to the front of the array\n98\t// Fisher-Yates shuffle. Initiate srand48() before calling.\n99\tvoid gca_sample(void *base, size_t n, size_t es, size_t m)\n100\t{\n101\t  char *b = (char*)base;\n102\t  size_t i, j;\n103\t  for(i = 0; i < m; i++) {\n104\t    j = i + (n-i)*drand48(); // i + rand where: 0 <= rand < n-i\n105\t    gca_swapm(b+es*i, b+es*j, es);\n106\t  }\n107\t}\n108\t\n109\t\n110\t// Merge two sorted arrays to create a merged sorted array\n111\tvoid gca_merge(void *_dst, size_t ndst, size_t nsrc, size_t es,\n112\t               int (*compar)(const void *_a, const void *_b, void *_arg),\n113\t               void *arg)\n114\t{\n115\t  char *dst = (char*)_dst, *src = dst+es*ndst, *end = dst+es*(ndst+nsrc);\n116\t  if(!nsrc || !ndst) {}\n117\t  else if(compar(src-es, src, arg) <= 0) {}\n118\t  else if(compar(dst, end-es, arg) >= 0) {\n119\t    gca_cycle_left(dst, ndst, es, ndst);\n120\t  }\n121\t  else if(ndst+nsrc < 6) {\n122\t    // insertion sort merge of dst and src\n123\t    gca_imerge(dst, ndst, nsrc, es, compar, arg);\n124\t  }\n125\t  else {\n126\t    gca_qsort(dst, ndst+nsrc, es, compar, arg);\n127\t  }\n128\t}\n129\t\n130\t// binary search\n131\t// searchf is a function that compares a given value with the value we are\n132\t// searching for. It returns <0 if _val is < target, >0 if _val is > target,\n133\t// 0 otherwise.\n134\tvoid* gca_bsearch(void *_ptr, size_t n, size_t es,\n135\t                  int (*searchf)(const void *_val, void *_arg),\n136\t                  void *arg)\n137\t{\n138\t  if(n == 0) return NULL;\n139\t\n140\t  char *ptr = (char*)_ptr, *mptr;\n141\t  size_t l = 0, r = n-1, mid;\n142\t  int cmp;\n143\t\n144\t  while(1)\n145\t  {\n146\t    // find mid without overflow\n147\t    mid = l + (r - l)/2;\n148\t    mptr = ptr+es*mid;\n149\t    cmp = searchf(mptr, arg);\n150\t    if(cmp == 0) return mptr;\n151\t    else if(cmp > 0) {\n152\t      if(!mid) return NULL;\n153\t      r = mid-1;\n154\t    }\n155\t    else if(cmp < 0) {\n156\t      if(mid+1 == n) return NULL;\n157\t      l = mid+1;\n158\t    }\n159\t  }\n160\t\n161\t  return NULL;\n162\t}\n163\t\n164\t// Linear search\n165\tvoid* gca_lsearch(void *base, size_t n, size_t es,\n166\t                  int (*searchf)(const void *_val, void *_arg),\n167\t                  void *arg)\n168\t{\n169\t  char *b = (char*)base, *end = b+es*n;\n170\t  for(; b < end; b++)\n171\t    if(searchf(b,arg) == 0)\n172\t      return b;\n173\t  return NULL;\n174\t}\n175\t\n176\t//\n177\t// Quick sort\n178\t//\n179\t\n180\t// Quicksort Partition\n181\t// Pivot is in first index\n182\t// returns index of pivot after partitioning\n183\tsize_t gca_qpart(void *base, size_t nel, size_t es,\n184\t                 int (*compar)(const void *_a, const void *_b, void *_arg),\n185\t                 void *arg)\n186\t{\n187\t  if(nel <= 1) return 0;\n188\t  char pivot[es], *b = (char*)base, *pl = b, *pr = b+es*(nel-1);\n189\t  memcpy(pivot, b, es);\n190\t  // hole at pl\n191\t\n192\t  while(pl < pr) {\n193\t    for(; pl < pr; pr -= es) {\n194\t      if(compar(pr, pivot, arg) < 0) {\n195\t        memcpy(pl, pr, es);\n196\t        pl += es; /* hole now at pr */\n197\t        break;\n198\t      }\n199\t    }\n200\t    for(; pl < pr; pl += es) {\n201\t      if(compar(pl, pivot, arg) > 0) {\n202\t        memcpy(pr, pl, es);\n203\t        pr -= es; /* hole now at pl */\n204\t        break;\n205\t      }\n206\t    }\n207\t  }\n208\t  // now pl == pr\n209\t  memcpy(pl, pivot, es);\n210\t  return (pl-b)/es;\n211\t}\n212\t\n213\t// Note: quicksort is not stable, equivalent values may be swapped\n214\tvoid gca_qsort(void *base, size_t nel, size_t es,\n215\t               int (*compar)(const void *_a, const void *_b, void *_arg),\n216\t               void *arg)\n217\t{\n218\t  char *b = (char*)base;\n219\t\n220\t  if(nel < 6) {\n221\t    /* Insertion sort for small inputs */\n222\t    gca_isortr(base, 0, nel, es, compar, arg);\n223\t  }\n224\t  else\n225\t  {\n226\t    /* Use median of first, middle and last items as pivot */\n227\t    char *pivot = gca_median3(b, b+es*(nel/2), b+es*(nel-1), compar, arg);\n228\t\n229\t    // swap pivot into first element and partition\n230\t    gca_swapm(b, pivot, es);\n231\t    size_t pidx = gca_qpart(b, nel, es, compar, arg);\n232\t\n233\t    gca_qsort(b, pidx, es, compar, arg);\n234\t    gca_qsort(b+es*(pidx+1), nel-(pidx+1), es, compar, arg);\n235\t  }\n236\t}\n237\t\n238\t//\n239\t// Quickselect\n240\t//\n241\t\n242\t// Get the k-th smallest element from unsorted array, using quickselect\n243\tvoid* gca_qselect(void *base, size_t nel, size_t es, size_t kidx,\n244\t                  int (*compar)(const void *_a, const void *_b, void *_arg),\n245\t                  void *arg)\n246\t{\n247\t  char *b = (char*)base;\n248\t  size_t pidx, l = 0, r = nel-1;\n249\t\n250\t  assert(kidx < nel);\n251\t  if(nel <= 1) return b;\n252\t\n253\t  while(1)\n254\t  {\n255\t    /* Use median of first, middle and last items as pivot */\n256\t    char *pivot = gca_median3(b+es*l, b+es*(l+(r-l+1)/2), b+es*r, compar, arg);\n257\t\n258\t    // swap pivot into first element and partition\n259\t    gca_swapm(b+es*l, pivot, es);\n260\t    pidx = l + gca_qpart(b+es*l, r-l+1, es, compar, arg);\n261\t\n262\t    if(pidx > kidx) r = pidx-1;\n263\t    else if(pidx < kidx) l = pidx+1;\n264\t    else break;\n265\t  }\n266\t\n267\t  return b+es*kidx;\n268\t}\n269\t\n270\t// Get k-th element from unsorted array, using quickselect and median of medians\n271\t// void gca_qselect_mmed(void *base, size_t nel, size_t es, size_t kidx,\n272\t//                       int (*compar)(const void *_a, const void *_b, void *_arg),\n273\t//                       void *arg)\n274\t// {\n275\t\n276\t// }\n277\t\n278\t//\n279\t// Heapsort\n280\t//\n281\t\n282\t// New element at index nel-1, to be pushed up the heap\n283\tvoid gca_heap_pushup(void *heap, size_t nel, size_t es,\n284\t                       int (*compar)(const void *_a, const void *_b, void *_arg),\n285\t                       void *arg)\n286\t{\n287\t  size_t chi, pi; // child idx, parent idx\n288\t  char tmp[es], *b = (char*)heap;\n289\t  memcpy(tmp, b+es*(nel-1), es);\n290\t  for(chi = nel-1; chi > 0; chi = pi) {\n291\t    pi = gca_heap_parent(chi);\n292\t    if(compar(b+es*pi, tmp, arg) >= 0) break;\n293\t    memcpy(b+es*chi, b+es*pi, es);\n294\t  }\n295\t  memcpy(b+es*chi, tmp, es);\n296\t}\n297\t\n298\t// New element at index 0, to be pushed down the heap\n299\tvoid gca_heap_pushdwn(void *heap, size_t nel, size_t es,\n300\t                      int (*compar)(const void *_a, const void *_b, void *_arg),\n301\t                      void *arg)\n302\t{\n303\t  char tmp[es], *b = (char*)heap, *last = b+es*(nel-1), *p, *ch;\n304\t  memcpy(tmp, last, es);\n305\t  for(p = b, ch = b+es; ch < last; p = ch, ch = b + 2*(ch-b) + es) {\n306\t    ch = (ch+es < last && compar(ch,ch+es,arg) < 0 ? ch+es : ch); // biggest child\n307\t    if(compar(tmp, ch, arg) >= 0) break;\n308\t    memcpy(p, ch, es);\n309\t  }\n310\t  memcpy(p, tmp, es);\n311\t}\n312\t\n313\tvoid gca_heap_make(void *heap, size_t nel, size_t es,\n314\t                   int (*compar)(const void *_a, const void *_b, void *_arg),\n315\t                   void *arg)\n316\t{\n317\t  size_t n;\n318\t  // add elements one-at-a-time to the end\n319\t  for(n = 2; n <= nel; n++)\n320\t    gca_heap_pushup(heap, n, es, compar, arg);\n321\t}\n322\t\n323\t// ar[idx]: child1 => arr[2*idx+1], child2 => arr[2*idx+2]\n324\tvoid gca_heap_sort(void *heap, size_t nel, size_t es,\n325\t                   int (*compar)(const void *_a, const void *_b, void *_arg),\n326\t                   void *arg)\n327\t{\n328\t  if(nel <= 1) return;\n329\t  char *b = (char*)heap, *end;\n330\t  size_t n;\n331\t  // take elements off the top one at a time, by swapping first and end\n332\t  for(n = nel-1, end = b+es*n; n > 1; n--, end -= es)\n333\t  {\n334\t    gca_swapm(b, end, es);\n335\t    gca_heap_pushdwn(heap, n, es, compar, arg);\n336\t  }\n337\t  gca_swapm(b, b+es, es);\n338\t}\n339\t\n340\t//\n341\t// Median\n342\t//\n343\t\n344\t// Get pointer to median of three elements\n345\tvoid* gca_median3(void *p0, void *p1, void *p2,\n346\t                  int (*compar)(const void *_a, const void *_b, void *_arg),\n347\t                  void *arg)\n348\t{\n349\t  if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n350\t  if(compar(p1, p2, arg) > 0) {\n351\t    SWAP(p1, p2);\n352\t    if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n353\t  }\n354\t  return p1;\n355\t}\n356\t\n357\t// Get pointer to median of five elements\n358\tvoid* gca_median5(void *p0, void *p1, void *p2, void *p3, void *p4,\n359\t                  int (*compar)(const void *_a, const void *_b, void *_arg),\n360\t                  void *arg)\n361\t{\n362\t  // make p0<p1\n363\t  if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n364\t  // make p2<p3\n365\t  if(compar(p2, p3, arg) > 0) SWAP(p2, p3);\n366\t\n367\t  // get rid of min(min(p0,p1),min(p2,p3)),\n368\t  // overwrite with p4\n369\t  // make p0<p1, p2<p3 again\n370\t  if(compar(p0, p2, arg) < 0) {\n371\t    p0 = p4;\n372\t    if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n373\t  } else {\n374\t    p2 = p4;\n375\t    if(compar(p2, p3, arg) > 0) SWAP(p2, p3);\n376\t  }\n377\t\n378\t  if(compar(p0, p2, arg) < 0) {\n379\t    return (compar(p1, p2, arg) < 0 ? p1 : p2);\n380\t  } else {\n381\t    return (compar(p3, p0, arg) < 0 ? p3 : p0);\n382\t  }\n383\t}\n384\t\n385\t\n386\t//\n387\t// Permutation\n388\t//\n389\t\n390\tsize_t* gca_itr_reset(size_t *p, size_t n)\n391\t{\n392\t  if(!p) p = malloc(n * sizeof(size_t));\n393\t  if(p && n) p[0] = SIZE_MAX;\n394\t  return p;\n395\t}\n396\t\n397\tsize_t* gca_itr_next(size_t **pp, size_t n, size_t *init)\n398\t{\n399\t  size_t i, j, *p = *pp;\n400\t\n401\t  if(!n) return NULL;\n402\t  if(!*pp) {\n403\t    p = *pp = malloc(n * sizeof(size_t));\n404\t    p[0] = SIZE_MAX;\n405\t  }\n406\t  if(p[0] == SIZE_MAX) {\n407\t    if(init) memcpy(p, init, n * sizeof(size_t));\n408\t    else for(i = 0; i < n; i++) p[i] = i;\n409\t    return p;\n410\t  }\n411\t\n412\t  // find i such that p[i-1] < p[i]\n413\t  i = n-1;\n414\t  while(i > 0 && p[i-1] >= p[i]) i--;\n415\t  if(!i) return NULL; // end; hit max e.g 4,3,2,1\n416\t  // find last j following i-1 where that p[i-1] < p[j]\n417\t  for(j = i; j+1 < n && p[i-1] < p[j+1]; j++) {}\n418\t\n419\t  // printf(\" i:%zu j:%zu\\n\", i-1, j);\n420\t  SWAP(p[i-1], p[j]);\n421\t  gca_reverse(p+i, n-i, sizeof(p[0]));\n422\t\n423\t  return p;\n424\t}\n425\t"}]},"parent_tool_use_id":null,"session_id":"38e0dcbe-fa42-43b9-9f4f-54005a634076","uuid":"a01cf505-eccc-4bbf-976f-47b81d7a0149","timestamp":"2026-06-03T01:27:57.707Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-SDZYB1/project/c_src/src/carrays.c","content":"#define _XOPEN_SOURCE /* drand48() */\n#include <stdlib.h> // drand48()\n#include <string.h>\n#include <assert.h>\n#include \"carrays.h\"\n\n//\n// Generic C Arrays\n//\n// All functions have the gca_ prefix\n//\n// 2015-10-24 Isaac Turner (turner.isaac@gmail.com)\n//\n\n//\n// TODO:\n// 1. quickselect using median of medians\n//\n\n// Get Greatest Common Divisor using binary GCD algorithm\n// http://en.wikipedia.org/wiki/Binary_GCD_algorithm\nuint32_t gca_calc_GCD(uint32_t a, uint32_t b)\n{\n  uint32_t shift;\n\n  if(a == 0) return b;\n  if(b == 0) return a;\n\n  // Find power of two divisor\n  for(shift = 0; ((a | b) & 1) == 0; shift++) { a >>= 1; b >>= 1; }\n\n  // Remove remaining factors of two from a - they are not common\n  while((a & 1) == 0) a >>= 1;\n\n  do\n  {\n    // Remove remaining factors of two from b - they are not common\n    while((b & 1) == 0) b >>= 1;\n\n    if(a > b) { SWAP(a,b); }\n    b = b - a;\n  }\n  while(b != 0);\n\n  return a << shift;\n}\n\n// cyclic-shift an array by `shift` elements\n// cycle left shifts towards zero\nvoid gca_cycle_left(void *_ptr, size_t n, size_t es, size_t shift)\n{\n  char *ptr = (char*)_ptr;\n  if(n <= 1 || !shift) return; // cannot mod by zero\n  shift = shift % n; // shift cannot be greater than n\n\n  // Using GCD\n  size_t i, j, k, gcd = gca_calc_GCD(n, shift);\n  char tmp[es];\n\n  // i is initial starting position\n  // Copy from k -> j, stop if k == i, since arr[i] already overwritten\n  for(i = 0; i < gcd; i++) {\n    memcpy(tmp, ptr+es*i, es); // tmp = arr[i]\n    for(j = i; 1; j = k) {\n      k = j+shift;\n      if(k >= n) k -= n;\n      if(k == i) break;\n      memcpy(ptr+es*j, ptr+es*k, es); // arr[j] = arr[k];\n    }\n    memcpy(ptr+es*j, tmp, es); // arr[j] = tmp;\n  }\n}\n\n// cycle right shifts away from zero\nvoid gca_cycle_right(void *_ptr, size_t n, size_t es, size_t shift)\n{\n  if(!n || !shift) return; // cannot mod by zero\n  shift = shift % n; // shift cannot be greater than n\n  // cycle right by `s` is equivalent to cycle left by `n - s`\n  gca_cycle_left(_ptr, n, es, n - shift);\n}\n\nvoid gca_reverse(void *_ptr, size_t n, size_t es)\n{\n  if(n <= 1 || !es) return;\n  char *a = (char*)_ptr, *b = a + es*(n-1);\n  for(; a < b; a += es, b -= es) gca_swapm(a, b, es);\n}\n\n// Shuffle entire array\n// Fisher-Yates shuffle. Initiate srand48() before calling.\nvoid gca_shuffle(void *base, size_t n, size_t es)\n{\n  gca_sample(base, n, es, n);\n}\n\n// Sample m elements by moving them to the front of the array\n// Fisher-Yates shuffle. Initiate srand48() before calling.\nvoid gca_sample(void *base, size_t n, size_t es, size_t m)\n{\n  char *b = (char*)base;\n  size_t i, j;\n  for(i = 0; i < m; i++) {\n    j = i + (n-i)*drand48(); // i + rand where: 0 <= rand < n-i\n    gca_swapm(b+es*i, b+es*j, es);\n  }\n}\n\n\n// Merge two sorted arrays to create a merged sorted array\nvoid gca_merge(void *_dst, size_t ndst, size_t nsrc, size_t es,\n               int (*compar)(const void *_a, const void *_b, void *_arg),\n               void *arg)\n{\n  char *dst = (char*)_dst, *src = dst+es*ndst, *end = dst+es*(ndst+nsrc);\n  if(!nsrc || !ndst) {}\n  else if(compar(src-es, src, arg) <= 0) {}\n  else if(compar(dst, end-es, arg) >= 0) {\n    gca_cycle_left(dst, ndst, es, ndst);\n  }\n  else if(ndst+nsrc < 6) {\n    // insertion sort merge of dst and src\n    gca_imerge(dst, ndst, nsrc, es, compar, arg);\n  }\n  else {\n    gca_qsort(dst, ndst+nsrc, es, compar, arg);\n  }\n}\n\n// binary search\n// searchf is a function that compares a given value with the value we are\n// searching for. It returns <0 if _val is < target, >0 if _val is > target,\n// 0 otherwise.\nvoid* gca_bsearch(void *_ptr, size_t n, size_t es,\n                  int (*searchf)(const void *_val, void *_arg),\n                  void *arg)\n{\n  if(n == 0) return NULL;\n\n  char *ptr = (char*)_ptr, *mptr;\n  size_t l = 0, r = n-1, mid;\n  int cmp;\n\n  while(1)\n  {\n    // find mid without overflow\n    mid = l + (r - l)/2;\n    mptr = ptr+es*mid;\n    cmp = searchf(mptr, arg);\n    if(cmp == 0) return mptr;\n    else if(cmp > 0) {\n      if(!mid) return NULL;\n      r = mid-1;\n    }\n    else if(cmp < 0) {\n      if(mid+1 == n) return NULL;\n      l = mid+1;\n    }\n  }\n\n  return NULL;\n}\n\n// Linear search\nvoid* gca_lsearch(void *base, size_t n, size_t es,\n                  int (*searchf)(const void *_val, void *_arg),\n                  void *arg)\n{\n  char *b = (char*)base, *end = b+es*n;\n  for(; b < end; b++)\n    if(searchf(b,arg) == 0)\n      return b;\n  return NULL;\n}\n\n//\n// Quick sort\n//\n\n// Quicksort Partition\n// Pivot is in first index\n// returns index of pivot after partitioning\nsize_t gca_qpart(void *base, size_t nel, size_t es,\n                 int (*compar)(const void *_a, const void *_b, void *_arg),\n                 void *arg)\n{\n  if(nel <= 1) return 0;\n  char pivot[es], *b = (char*)base, *pl = b, *pr = b+es*(nel-1);\n  memcpy(pivot, b, es);\n  // hole at pl\n\n  while(pl < pr) {\n    for(; pl < pr; pr -= es) {\n      if(compar(pr, pivot, arg) < 0) {\n        memcpy(pl, pr, es);\n        pl += es; /* hole now at pr */\n        break;\n      }\n    }\n    for(; pl < pr; pl += es) {\n      if(compar(pl, pivot, arg) > 0) {\n        memcpy(pr, pl, es);\n        pr -= es; /* hole now at pl */\n        break;\n      }\n    }\n  }\n  // now pl == pr\n  memcpy(pl, pivot, es);\n  return (pl-b)/es;\n}\n\n// Note: quicksort is not stable, equivalent values may be swapped\nvoid gca_qsort(void *base, size_t nel, size_t es,\n               int (*compar)(const void *_a, const void *_b, void *_arg),\n               void *arg)\n{\n  char *b = (char*)base;\n\n  if(nel < 6) {\n    /* Insertion sort for small inputs */\n    gca_isortr(base, 0, nel, es, compar, arg);\n  }\n  else\n  {\n    /* Use median of first, middle and last items as pivot */\n    char *pivot = gca_median3(b, b+es*(nel/2), b+es*(nel-1), compar, arg);\n\n    // swap pivot into first element and partition\n    gca_swapm(b, pivot, es);\n    size_t pidx = gca_qpart(b, nel, es, compar, arg);\n\n    gca_qsort(b, pidx, es, compar, arg);\n    gca_qsort(b+es*(pidx+1), nel-(pidx+1), es, compar, arg);\n  }\n}\n\n//\n// Quickselect\n//\n\n// Get the k-th smallest element from unsorted array, using quickselect\nvoid* gca_qselect(void *base, size_t nel, size_t es, size_t kidx,\n                  int (*compar)(const void *_a, const void *_b, void *_arg),\n                  void *arg)\n{\n  char *b = (char*)base;\n  size_t pidx, l = 0, r = nel-1;\n\n  assert(kidx < nel);\n  if(nel <= 1) return b;\n\n  while(1)\n  {\n    /* Use median of first, middle and last items as pivot */\n    char *pivot = gca_median3(b+es*l, b+es*(l+(r-l+1)/2), b+es*r, compar, arg);\n\n    // swap pivot into first element and partition\n    gca_swapm(b+es*l, pivot, es);\n    pidx = l + gca_qpart(b+es*l, r-l+1, es, compar, arg);\n\n    if(pidx > kidx) r = pidx-1;\n    else if(pidx < kidx) l = pidx+1;\n    else break;\n  }\n\n  return b+es*kidx;\n}\n\n// Get k-th element from unsorted array, using quickselect and median of medians\n// void gca_qselect_mmed(void *base, size_t nel, size_t es, size_t kidx,\n//                       int (*compar)(const void *_a, const void *_b, void *_arg),\n//                       void *arg)\n// {\n\n// }\n\n//\n// Heapsort\n//\n\n// New element at index nel-1, to be pushed up the heap\nvoid gca_heap_pushup(void *heap, size_t nel, size_t es,\n                       int (*compar)(const void *_a, const void *_b, void *_arg),\n                       void *arg)\n{\n  size_t chi, pi; // child idx, parent idx\n  char tmp[es], *b = (char*)heap;\n  memcpy(tmp, b+es*(nel-1), es);\n  for(chi = nel-1; chi > 0; chi = pi) {\n    pi = gca_heap_parent(chi);\n    if(compar(b+es*pi, tmp, arg) >= 0) break;\n    memcpy(b+es*chi, b+es*pi, es);\n  }\n  memcpy(b+es*chi, tmp, es);\n}\n\n// New element at index 0, to be pushed down the heap\nvoid gca_heap_pushdwn(void *heap, size_t nel, size_t es,\n                      int (*compar)(const void *_a, const void *_b, void *_arg),\n                      void *arg)\n{\n  char tmp[es], *b = (char*)heap, *last = b+es*(nel-1), *p, *ch;\n  memcpy(tmp, last, es);\n  for(p = b, ch = b+es; ch < last; p = ch, ch = b + 2*(ch-b) + es) {\n    ch = (ch+es < last && compar(ch,ch+es,arg) < 0 ? ch+es : ch); // biggest child\n    if(compar(tmp, ch, arg) >= 0) break;\n    memcpy(p, ch, es);\n  }\n  memcpy(p, tmp, es);\n}\n\nvoid gca_heap_make(void *heap, size_t nel, size_t es,\n                   int (*compar)(const void *_a, const void *_b, void *_arg),\n                   void *arg)\n{\n  size_t n;\n  // add elements one-at-a-time to the end\n  for(n = 2; n <= nel; n++)\n    gca_heap_pushup(heap, n, es, compar, arg);\n}\n\n// ar[idx]: child1 => arr[2*idx+1], child2 => arr[2*idx+2]\nvoid gca_heap_sort(void *heap, size_t nel, size_t es,\n                   int (*compar)(const void *_a, const void *_b, void *_arg),\n                   void *arg)\n{\n  if(nel <= 1) return;\n  char *b = (char*)heap, *end;\n  size_t n;\n  // take elements off the top one at a time, by swapping first and end\n  for(n = nel-1, end = b+es*n; n > 1; n--, end -= es)\n  {\n    gca_swapm(b, end, es);\n    gca_heap_pushdwn(heap, n, es, compar, arg);\n  }\n  gca_swapm(b, b+es, es);\n}\n\n//\n// Median\n//\n\n// Get pointer to median of three elements\nvoid* gca_median3(void *p0, void *p1, void *p2,\n                  int (*compar)(const void *_a, const void *_b, void *_arg),\n                  void *arg)\n{\n  if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n  if(compar(p1, p2, arg) > 0) {\n    SWAP(p1, p2);\n    if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n  }\n  return p1;\n}\n\n// Get pointer to median of five elements\nvoid* gca_median5(void *p0, void *p1, void *p2, void *p3, void *p4,\n                  int (*compar)(const void *_a, const void *_b, void *_arg),\n                  void *arg)\n{\n  // make p0<p1\n  if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n  // make p2<p3\n  if(compar(p2, p3, arg) > 0) SWAP(p2, p3);\n\n  // get rid of min(min(p0,p1),min(p2,p3)),\n  // overwrite with p4\n  // make p0<p1, p2<p3 again\n  if(compar(p0, p2, arg) < 0) {\n    p0 = p4;\n    if(compar(p0, p1, arg) > 0) SWAP(p0, p1);\n  } else {\n    p2 = p4;\n    if(compar(p2, p3, arg) > 0) SWAP(p2, p3);\n  }\n\n  if(compar(p0, p2, arg) < 0) {\n    return (compar(p1, p2, arg) < 0 ? p1 : p2);\n  } else {\n    return (compar(p3, p0, arg) < 0 ? p3 : p0);\n  }\n}\n\n\n//\n// Permutation\n//\n\nsize_t* gca_itr_reset(size_t *p, size_t n)\n{\n  if(!p) p = malloc(n * sizeof(size_t));\n  if(p && n) p[0] = SIZE_MAX;\n  return p;\n}\n\nsize_t* gca_itr_next(size_t **pp, size_t n, size_t *init)\n{\n  size_t i, j, *p = *pp;\n\n  if(!n) return NULL;\n  if(!*pp) {\n    p = *pp = malloc(n * sizeof(size_t));\n    p[0] = SIZE_MAX;\n  }\n  if(p[0] == SIZE_MAX) {\n    if(init) memcpy(p, init, n * sizeof(size_t));\n    else for(i = 0; i < n; i++) p[i] = i;\n    return p;\n  }\n\n  // find i such that p[i-1] < p[i]\n  i = n-1;\n  while(i > 0 && p[i-1] >= p[i]) i--;\n  if(!i) return NULL; // end; hit max e.g 4,3,2,1\n  // find last j following i-1 where that p[i-1] < p[j]\n  for(j = i; j+1 < n && p[i-1] < p[j+1]; j++) {}\n\n  // printf(\" i:%zu j:%zu\\n\", i-1, j);\n  SWAP(p[i-1], p[j]);\n  gca_reverse(p+i, n-i, sizeof(p[0]));\n\n  return p;\n}\n","numLines":425,"startLine":1,"totalLines":425}}}
