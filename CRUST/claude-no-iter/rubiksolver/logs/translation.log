pos = 0; pos < 8; pos++)\n68\t    {\n69\t      cube[face][pos] = data[face][pos];\n70\t    }\n71\t  }\n72\t  return cube;\n73\t}\n74\t\n75\tvoid cube_free(cube_t cube)\n76\t{\n77\t  for(color face = RED; face <= WHITE; face++)\n78\t  {\n79\t    free(cube[face]);\n80\t  }\n81\t  free(cube);\n82\t}\n83\t\n84\tunsigned int cube_hash(const cube_t cube)\n85\t{\n86\t  unsigned int hash = 0;\n87\t  for(color face = RED; face <= WHITE; face++)\n88\t  {\n89\t    for(int pos = 0; pos < 4; pos++)\n90\t    {\n91\t      if(cube[face][2 * pos] != face || cube[face][2 * pos + 1] != face)\n92\t      {\n93\t        hash++;\n94\t      }\n95\t      hash = hash << 1;\n96\t    }\n97\t  }\n98\t  return hash;\n99\t}\n100\t\n101\tecube_t ecube_init(cube_t cube)\n102\t{\n103\t  ecube_t ecube = (ecube_t)malloc(sizeof(struct ecube_struct));\n104\t  ecube->cube = cube;\n105\t  ecube->entropy = find_entropy(cube);\n106\t  ecube->hash = cube_hash(cube);\n107\t  return ecube;\n108\t}\n109\t\n110\tcube_t cube_clone(cube_t cube)\n111\t{\n112\t  cube_t new_cube = (cube_t)malloc(sizeof(color *) * 6);\n113\t  for(color face = RED; face <= WHITE; face++)\n114\t  {\n115\t    new_cube[face] = (color *)(malloc(sizeof(color) * 8));\n116\t    for(int pos = 0; pos < 8; pos++)\n117\t    {\n118\t      new_cube[face][pos] = cube[face][pos];\n119\t    }\n120\t  }\n121\t  return new_cube;\n122\t}\n123\t\n124\tcube_t new_cube_rotate_face(const cube_t cube, color face, rotation direction)\n125\t{\n126\t  cube_t new_cube = cube_clone(cube);\n127\t  rotate_face(new_cube, face, direction);\n128\t  return new_cube;\n129\t}\n130\t\n131\tvoid rotate_face(cube_t cube, color face, rotation direction)\n132\t{\n133\t  assert(cube != NULL);\n134\t  /*\n135\t            + - - - +\n136\t            | 2 3 4 |\n137\t            | 1 G 5 |\n138\t            | 0 7 6 |\n139\t    + - - - + - - - + - - - + - - - +\n140\t    | 6 7 0 | 0 1 2 | 4 5 6 | 2 3 4 |      'R' will be rotated either CW/CCW\n141\t    | 5 B 1 | 7 R 3 | 3 W 7 | 1 O 5 |\n142\t    | 4 3 2 | 6 5 4 | 2 1 0 | 0 7 6 |\n143\t    + - - - + - - - + - - - + - - - +\n144\t            | 4 5 6 |\n145\t            | 3 Y 7 |\n146\t            | 2 1 0 |\n147\t            + - - - +\n148\t  */\n149\t  color g = top[face];\n150\t  color w = adjacent_cw(face, g);\n151\t  color y = adjacent_cw(face, w);\n152\t  color b = adjacent_cw(face, y);\n153\t  color temp;\n154\t  if(direction == CW)\n155\t  {\n156\t    // Swap G's (0,7,6) with W's (4,3,2)\n157\t    SWAP_COLOR(cube[g][0], cube[w][4]);\n158\t    SWAP_COLOR(cube[g][7], cube[w][3]);\n159\t    SWAP_COLOR(cube[g][6], cube[w][2]);\n160\t    /*\n161\t    do\n162\t    {\n163\t      color temp = cube[g][6];\n164\t      cube[g][6] = cube[w][2];\n165\t      cube[w][2] = temp;\n166\t    } while(0);\n167\t    */\n168\t    // Swap B's (2,1,0) with G's (0,7,6)\n169\t    SWAP_COLOR(cube[b][2], cube[g][0]);\n170\t    SWAP_COLOR(cube[b][1], cube[g][7]);\n171\t    SWAP_COLOR(cube[b][0], cube[g][6]);\n172\t    \n173\t    // Swap Y's (6,5,4) with B's (2,1,0)\n174\t    SWAP_COLOR(cube[y][6], cube[b][2]);\n175\t    SWAP_COLOR(cube[y][5], cube[b][1]);\n176\t    SWAP_COLOR(cube[y][4], cube[b][0]);\n177\t    \n178\t    // Rotating R's face CW\n179\t    temp = cube[face][0];\n180\t    cube[face][0] = cube[face][6];\n181\t    cube[face][6] = cube[face][4];\n182\t    cube[face][4] = cube[face][2];\n183\t    cube[face][2] = temp;\n184\t    temp = cube[face][1];\n185\t    cube[face][1] = cube[face][7];\n186\t    cube[face][7] = cube[face][5];\n187\t    cube[face][5] = cube[face][3];\n188\t    cube[face][3] = temp;\n189\t  }\n190\t  else// if(dir == CCW)\n191\t  {\n192\t    // Swap G's (0,7,6) with B's (2,1,0)\n193\t    SWAP_COLOR(cube[g][0], cube[b][2]);\n194\t    SWAP_COLOR(cube[g][7], cube[b][1]);\n195\t    SWAP_COLOR(cube[g][6], cube[b][0]);\n196\t    \n197\t    // Swap W's (4,3,2) with G's (0,7,6)\n198\t    SWAP_COLOR(cube[w][4], cube[g][0]);\n199\t    SWAP_COLOR(cube[w][3], cube[g][7]);\n200\t    SWAP_COLOR(cube[w][2