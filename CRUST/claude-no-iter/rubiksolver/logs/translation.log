{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_2wu4hcqwb4ktkaqrdcdla54izpnihcve4at6ysy2tioijl5e7nia","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01Xwdn36pPpKERgvrzQiiecN","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-2uwtjG/project/src/hash.rs","content":"/// A simple hash table using a vector of buckets.\n/// The table uses a provided hash function (which returns a u32)\n/// and a caller‑supplied equality function for comparing elements.\npub struct Hash<T> {\n    buckets: Vec<Vec<T>>,\n    hash_function: Box<dyn Fn(&T) -> u32>,\n    max_key: u32,\n}\nimpl<T> Hash<T> {\n    /// Create a new hash table with `max_key` buckets.\n    /// The `hash_function` is used to compute a hash for each element.\n    pub fn new(max_key: u32, hash_function: impl Fn(&T) -> u32 + 'static) -> Self {\n        let mut buckets = Vec::with_capacity((max_key as usize) + 1);\n        for _ in 0..=max_key {\n            buckets.push(Vec::new());\n        }\n        Hash {\n            buckets,\n            hash_function: Box::new(hash_function),\n            max_key,\n        }\n    }\n    /// Inserts an element if no equal element exists (using the provided compare_equal).\n    /// Returns true if the element was inserted.\n    pub fn insert(&mut self, element: T, compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n        let ix = (self.hash_function)(&element);\n        assert!(ix <= self.max_key);\n        let bucket = &mut self.buckets[ix as usize];\n        for existing in bucket.iter() {\n            if compare_equal(existing, &element) {\n                // Match the C semantics: C's hash_insert always appends and returns true,\n                // but for safe Rust we still append on hash collision (C allows duplicates).\n                // To stay faithful to the C version (which simply appends), we still push.\n                bucket.push(element);\n                return true;\n            }\n        }\n        bucket.push(element);\n        true\n    }\n    /// Returns true if an element equal (per compare_equal) to `element` exists.\n    pub fn element_exists(&self, element: &T, compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n        let ix = (self.hash_function)(element);\n        assert!(ix <= self.max_key);\n        let bucket = &self.buckets[ix as usize];\n        for existing in bucket.iter() {\n            if compare_equal(existing, element) {\n                return true;\n            }\n        }\n        false\n    }\n    /// Deletes an element (using compare_equal) from the hash table.\n    /// Returns true if the element was found and removed.\n    pub fn delete(&mut self, element: &T, compare_equal: impl Fn(&T, &T) -> bool) -> bool {\n        let ix = (self.hash_function)(element);\n        assert!(ix <= self.max_key);\n        let bucket = &mut self.buckets[ix as usize];\n        for i in 0..bucket.len() {\n            if compare_equal(&bucket[i], element) {\n                bucket.remove(i);\n                return true;\n            }\n        }\n        false\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":864,"cache_read_input_tokens":35516,"cache_creation":{"ephemeral_5m_input_tokens":864,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f49736e2-c03b-4ddf-a9cc-79b6ba9d69a3","uuid":"68adc827-6162-4ff0-aba0-b1f188ad5fa9"}
