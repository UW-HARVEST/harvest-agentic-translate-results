1 1.0\\n1 2 3 3 1.0\\n2\";\n46\t    let mut fst = Fst::new();\n47\t    let mut path = Fst::new();\n48\t    let mut expected_path = Fst::new();\n49\t    fst.compile_str(fst_str);\n50\t    expected_path.compile_str(fst_str_path);\n51\t    fst.shortest(&mut path);\n52\t    expected_path.print();\n53\t    path.print();\n54\t    assert_fst_equal(&expected_path, &path);\n55\t    fst.remove();\n56\t    path.remove();\n57\t    expected_path.remove();\n58\t}\n59\t#[test]\n60\tfn test_shortest_cyclic() {\n61\t    let fst_str = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n1 0 3 3 1.0\\n2\";\n62\t    let fst_str_path = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n2\";\n63\t    let mut fst = Fst::new();\n64\t    let mut path = Fst::new();\n65\t    let mut expected_path = Fst::new();\n66\t    fst.compile_str(fst_str);\n67\t    expected_path.compile_str(fst_str_path);\n68\t    fst.shortest(&mut path);\n69\t    assert_fst_equal(&expected_path, &path);\n70\t    fst.remove();\n71\t    path.remove();\n72\t    expected_path.remove();\n73\t}\n74\t#[test]\n75\tfn test_shortest_reflexive() {\n76\t    let fst_str = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n1 1 3 3 1.0\\n2\";\n77\t    let fst_str_path = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n2\";\n78\t    let mut fst = Fst::new();\n79\t    let mut path = Fst::new();\n80\t    let mut expected_path = Fst::new();\n81\t    fst.compile_str(fst_str);\n82\t    expected_path.compile_str(fst_str_path);\n83\t    fst.shortest(&mut path);\n84\t    assert_fst_equal(&expected_path, &path);\n85\t    fst.remove();\n86\t    path.remove();\n87\t    expected_path.remove();\n88\t}\n89\tfn main() {\n90\t}"}]},"parent_tool_use_id":null,"session_id":"0896b30b-5c97-4a15-9bac-65df92dceef8","uuid":"82f4b926-45ad-4f65-8792-fe3cf2f441cb","timestamp":"2026-06-03T02:24:56.089Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-gINT0F/project/src/bin/test_shortest.rs","content":"use fslib::fst::{Fst, StateData, ArcData};\n\npub fn assert_arc_equal(arc_a: &ArcData, arc_b: &ArcData) {\n    assert_eq!(arc_a.state, arc_b.state);\n    assert_eq!(arc_a.ilabel, arc_b.ilabel);\n    assert_eq!(arc_a.olabel, arc_b.olabel);\n    assert_eq!(arc_a.weight, arc_b.weight);\n}\npub fn assert_state_equal(state_a: &StateData, state_b: &StateData) {\n    assert_eq!(state_a.weight, state_b.weight);\n    assert_eq!(state_a.final_state, state_b.final_state);\n}\npub fn assert_fst_equal(a: &Fst, b: &Fst) {\n    assert_eq!(a.start, b.start);\n    assert_eq!(a.sr_type, b.sr_type);\n    assert_eq!(a.n_states, b.n_states);\n    for st in 0..a.states.len().min(b.states.len()) {\n        let state_a = &a.states[st];\n        let state_b = &b.states[st];\n        assert_eq!(state_a.arcs.len(), state_b.arcs.len());\n        assert_state_equal(state_a, state_b);\n        for arc in 0..state_a.arcs.len().min(state_b.arcs.len()) {\n            assert_arc_equal(&state_a.arcs[arc], &state_b.arcs[arc]);\n        }\n    }\n}\n#[test]\nfn test_shortest() {\n    let fst_str = \"0 1 1 1 1.0\\n0 1 2 2 2.0\\n1 2 3 3 1.0\\n1 2 4 4 2.0\\n2\";\n    let fst_str_path = \"0 1 1 1 1.0\\n1 2 3 3 1.0\\n2\";\n    let mut fst = Fst::new();\n    let mut path = Fst::new();\n    let mut expected_path = Fst::new();\n    fst.compile_str(fst_str);\n    expected_path.compile_str(fst_str_path);\n    fst.shortest(&mut path);\n    assert_fst_equal(&expected_path, &path);\n    fst.remove();\n    path.remove();\n    expected_path.remove();\n}\n#[test]\nfn test_shortest_three() {\n    let fst_str = \"0 1 1 1 1.0\\n0 2 2 2 2.0\\n1 3 3 3 1.0\\n2 3 4 4 2.0\\n0 3 5 5 4.0\\n3\";\n    let fst_str_path = \"0 1 1 1 1.0\\n1 2 3 3 1.0\\n2\";\n    let mut fst = Fst::new();\n    let mut path = Fst::new();\n    let mut expected_path = Fst::new();\n    fst.compile_str(fst_str);\n    expected_path.compile_str(fst_str_path);\n    fst.shortest(&mut path);\n    expected_path.print();\n    path.print();\n    assert_fst_equal(&expected_path, &path);\n    fst.remove();\n    path.remove();\n    expected_path.remove();\n}\n#[test]\nfn test_shortest_cyclic() {\n    let fst_str = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n1 0 3 3 1.0\\n2\";\n    let fst_str_path = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n2\";\n    let mut fst = Fst::new();\n    let mut path = Fst::new();\n    let mut expected_path = Fst::new();\n    fst.compile_str(fst_str);\n    expected_path.compile_str(fst_str_path);\n    fst.shortest(&mut path);\n    assert_fst_equal(&expected_path, &path);\n    fst.remove();\n    path.remove();\n    expected_path.remove();\n}\n#[test]\nfn test_shortest_reflexive() {\n    let fst_str = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n1 1 3 3 1.0\\n2\";\n    let fst_str_path = \"0 1 1 1 1.0\\n1 2 2 2 1.0\\n2\";\n    let mut fst = Fst::new();\n    let mut path = Fst::new();\n    let mut expected_path = Fst::new();\n    fst.compile_str(fst_str);\n    expected_path.compile_str(fst_str_path);\n    fst.shortest(&mut path);\n    assert_fst_equal(&expected_path, &path);\n    fst.remove();\n    path.remove();\n    expected_path.remove();\n}\nfn main() {\n}","numLines":90,"startLine":1,"totalLines":90}}}
