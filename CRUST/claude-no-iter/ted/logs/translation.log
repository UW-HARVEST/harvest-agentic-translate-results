{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01J9qUVwAeMuWwFQvyNtVm9a","type":"tool_result","content":"1\tuse crate::gap::{GapBuffer, MEM_ERROR};\n2\tuse std::io::{BufRead, BufReader};\n3\t\n4\tpub const DEFAULT_GAP_BUF_CAP: usize = 100;\n5\tpub const DEFAULT_CAPACITY: usize = 100;\n6\t\n7\tpub struct TextBuffer {\n8\t    pub lines: Vec<Option<GapBuffer>>,\n9\t    pub lines_capacity: usize,\n10\t    pub cursor_row: usize,\n11\t    pub cursor_col: usize,\n12\t    pub cursor_col_moved: bool,\n13\t    pub last_line_loc: usize,\n14\t}\n15\t\n16\timpl TextBuffer {\n17\t    pub fn create(lines: usize, line_size: usize) -> Option<Self> {\n18\t        if lines == 0 {\n19\t            return None;\n20\t        }\n21\t\n22\t        let mut lines_vec: Vec<Option<GapBuffer>> = Vec::with_capacity(lines);\n23\t        // First line is initialized\n24\t        lines_vec.push(Some(GapBuffer::create(line_size)));\n25\t        // The rest are None\n26\t        for _ in 1..lines {\n27\t            lines_vec.push(None);\n28\t        }\n29\t\n30\t        Some(TextBuffer {\n31\t            lines: lines_vec,\n32\t            lines_capacity: lines,\n33\t            cursor_row: 0,\n34\t            cursor_col: 0,\n35\t            cursor_col_moved: false,\n36\t            last_line_loc: 0,\n37\t        })\n38\t    }\n39\t\n40\t    pub fn destroy(self) {\n41\t        // Rust handles deallocation automatically when self is dropped\n42\t        drop(self);\n43\t    }\n44\t\n45\t    pub fn move_cursor(&mut self, row: usize, col: usize) {\n46\t        let row = if row > self.last_line_loc {\n47\t            self.last_line_loc\n48\t        } else {\n49\t            row\n50\t        };\n51\t\n52\t        self.cursor_row = row;\n53\t\n54\t        let line_str_len = self.lines[row]\n55\t            .as_ref()\n56\t            .map(|g| g.str_len)\n57\t            .unwrap_or(0);\n58\t\n59\t        let col = if col > line_str_len {\n60\t            line_str_len\n61\t        } else {\n62\t            col\n63\t        };\n64\t\n65\t        if self.cursor_col != col {\n66\t            self.cursor_col_moved = true;\n67\t        }\n68\t\n69\t        self.cursor_col = col;\n70\t    }\n71\t\n72\t    pub fn insert(&mut self, ch: char) -> i32 {\n73\t        // If the cursor column changed, we need to move the gap buffer before inserting.\n74\t        if self.cursor_col_moved {\n75\t            let line = match self.lines[self.cursor_row].as_mut() {\n76\t                Some(l) => l,\n77\t                None => return MEM_ERROR,\n78\t            };\n79\t            let err = line.move_gap(self.cursor_col);\n80\t            if err != 0 {\n81\t                return err;\n82\t            }\n83\t            self.cursor_col_moved = false;\n84\t        }\n85\t\n86\t        let line = match self.lines[self.cursor_row].as_mut() {\n87\t            Some(l) => l,\n88\t            None => return MEM_ERROR,\n89\t        };\n90\t        let err = line.insert_char(ch);\n91\t        if err != 0 {\n92\t            return err;\n93\t        }\n94\t\n95\t        self.cursor_col = line.gap_loc;\n96\t        0\n97\t    }\n98\t\n99\t    pub fn backspace(&mut self) -> i32 {\n100\t        if self.cursor_col_moved {\n101\t            let line = match self.lines[self.cursor_row].as_mut() {\n102\t                Some(l) => l,\n103\t                None => return MEM_ERROR,\n104\t            };\n105\t            let err = line.move_gap(self.cursor_col);\n106\t            if err != 0 {\n107\t                return err;\n108\t            }\n109\t            self.cursor_col_moved = false;\n110\t        }\n111\t\n112\t        let line = match self.lines[self.cursor_row].as_mut() {\n113\t            Some(l) => l,\n114\t            None => return MEM_ERROR,\n115\t        };\n116\t        line.backspace();\n117\t        self.cursor_col = line.gap_loc;\n118\t\n119\t        0\n120\t    }\n121\t\n122\t    pub fn new_line(&mut self) -> i32 {\n123\t        // Move the gap to curren