fore the new location.\n            let mid_len = location - self.gap_loc;\n            for i in 0..mid_len {\n                new_buffer[self.gap_loc + i] =\n                    self.buffer[self.gap_loc + self.gap_len + i];\n            }\n\n            // Copy the remaining string after the gap.\n            let suffix_len = self.str_len - location;\n            for i in 0..suffix_len {\n                new_buffer[location + self.gap_len + i] =\n                    self.buffer[self.gap_loc + self.gap_len + mid_len + i];\n            }\n        }\n\n        self.buffer = new_buffer;\n        self.gap_loc = location;\n        0\n    }\n\n    pub fn get_string(&self) -> String {\n        let mut s = String::with_capacity(self.str_len);\n\n        // Before gap\n        for i in 0..self.gap_loc {\n            s.push(self.buffer[i]);\n        }\n\n        // After gap\n        let suffix_len = self.str_len - self.gap_loc;\n        for i in 0..suffix_len {\n            s.push(self.buffer[self.gap_loc + self.gap_len + i]);\n        }\n\n        s\n    }\n\n    pub fn split(&self) -> Self {\n        // Note: in C, this method mutates self (instance->str_len = instance->gap_loc).\n        // The Rust signature uses &self, but the test calls split on a mutable buffer\n        // and then continues to use the original.\n        // Since signature can't change, we use an unsafe trick — but since we want\n        // pure safe Rust, we'll work around it by using interior mutability via\n        // the fact that the signature here takes &self. We need to mutate fields.\n        //\n        // Actually: looking more carefully, the original buffer's str_len is supposed\n        // to be reduced to gap_loc after split. The test then inserts 'x' on the\n        // original buffer and expects \"cccaaax\".\n        //\n        // We can't safely mutate self with &self. We'll have to use `unsafe` here\n        // or use a Cell. Since the rules say no unsafe unless absolutely necessary,