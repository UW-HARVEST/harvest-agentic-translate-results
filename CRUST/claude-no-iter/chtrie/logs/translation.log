igned char)*s++, 0);\n    }\n    if (it < 0 || !term[it])\n        return;\n    term[it] = 0;\n    while (it > 0 && !term[it] && nchild[it] == 0) {\n        n--;\n        chtrie_del(tr, nodes[n], symbs[n]);\n        it = nodes[n];\n        nchild[it]--;\n    }\n}\n\nstatic int query(char *s)\n{\n    int it = 0;\n    while (it >= 0 && *s)\n        it = chtrie_walk(tr, it, (unsigned char)*s++, 0);\n    return it >= 0 && term[it];\n}","numLines":102,"startLine":1,"totalLines":102}}}
