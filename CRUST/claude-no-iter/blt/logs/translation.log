{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01C6F7EUDEp4BGbPGMcW2TWM","type":"tool_result","content":"1\t// = Crit-bit trees =\n2\t//\n3\t// Usage:\n4\t//\n5\t//   // Create a new tree.\n6\t//   BLT* blt = blt_new();\n7\t//\n8\t//   // Insert a couple of keys.\n9\t//   blt_put(blt, \"hello\", pointer1);\n10\t//   blt_put(blt, \"world\", pointer2);\n11\t//\n12\t//   // Check they have the values we expect.\n13\t//   if (blt_get(blt, \"hello\")->data != pointer1 ||\n14\t//       blt_get(blt, \"hello\")->data != pointer2) exit(1);\n15\t//\n16\t//   // Delete the tree.\n17\t//   blt_clear(blt);\n18\t\n19\tstruct BLT;\n20\ttypedef struct BLT BLT;\n21\tstruct BLT_IT {\n22\t  char *key;\n23\t  void *data;\n24\t};\n25\ttypedef struct BLT_IT BLT_IT;\n26\t\n27\t// Creates a new tree.\n28\tBLT *blt_new();\n29\t\n30\t// Destroys a tree.\n31\tvoid blt_clear(BLT *blt);\n32\t\n33\t// Retrieves the leaf node at a given key.\n34\t// Returns NULL if there is no such key.\n35\tBLT_IT *blt_get(BLT *blt, char *key);\n36\t\n37\t// Creates or retrieves the leaf node at a given key.\n38\tBLT_IT *blt_set(BLT *blt, char *key);\n39\t\n40\t// Creates or retrieves the leaf node at a given key.\n41\t// If is_new is not NULL, sets *is_new to 1 if a new node was created,\n42\t// and 0 otherwise.\n43\tBLT_IT *blt_setp(BLT *blt, char *key, int *is_new);\n44\t\n45\t// Inserts a given key and data pair.\n46\t// Returns the leaf node containing them.\n47\tBLT_IT *blt_put(BLT *blt, char *key, void *data);\n48\t\n49\t// Inserts a given key and data pair if key is absent.\n50\t// Returns 0 on success. Returns 1 if key is already present.\n51\tint blt_put_if_absent(BLT *blt, char *key, void *data);\n52\t\n53\t// Deletes a given key from the tree.\n54\t// Returns 1 if a key was deleted, and 0 otherwise.\n55\tint blt_delete(BLT *blt, char *key);\n56\t\n57\t// Iterates through all leaf nodes with a given prefix in order and runs the\n58\t// given callback on each one.\n59\t// If the callback returns 1, continues iteration, otherwise halts and returns\n60\t// the value returned by the callback.\n61\tint blt_allprefixed(BLT *blt, char *key, int (*fun)(BLT_IT *));\n62\t\n63\t// Iterates through all leaf nodes in order and runs the given callback.\n64\tstatic inline void blt_forall(BLT *blt, void (*fun)(BLT_IT *)) {\n65\t  int f(BLT_IT *it) { return fun(it), 1; }\n66\t  blt_allprefixed(blt, \"\", f);\n67\t}\n68\t\n69\t// Returns the leaf node with the smallest key.\n70\tBLT_IT *blt_first(BLT *blt);\n71\t\n72\t// Returns the leaf node with the largest key.\n73\tBLT_IT *blt_last (BLT *blt);\n74\t\n75\t// Returns the leaf node with the next largest key.\n76\tBLT_IT *blt_next(BLT *blt, BLT_IT *it);\n77\t\n78\t// Returns the leaf node with the next smallest key.\n79\tBLT_IT *blt_prev(BLT *blt, BLT_IT *it);\n80\t\n81\t// If the given key is present, returns its leaf node.\n82\t// Otherwise returns the leaf node with the next largest key if it exists,\n83\t// and NULL otherwise.\n84\tBLT_IT *blt_ceil (BLT *blt, char *key);\n85\t\n86\t// If the given key is present, returns its leaf node.\n87\t// Otherwise returns the leaf node with the next smallest key if it exists,\n88\t// and NULL otherwise.\n89\tBLT_IT *blt_floor(BLT *blt, char *key);\n90\t\n91\t// Returns the number of bytes used by the tree, excluding memory taken by\n92\t// the bytes of the keys.\n93\tsize_t blt_overhead(BLT *blt);\n94\t\n95\t// Returns 1 if tree is empty, 0 otherwise.\n96\tint blt_empty(BLT *blt);\n97\t\n98\t// Returns number of keys.\n99\tint blt_size(BLT *blt);\n100\t"}]},"parent_tool_use_id":null,"session_id":"e1b96121-1784-4802-bf4d-c02aef2c3049","uuid":"54d6fece-ca64-4dc4-9d52-bae25f5dc829","timestamp":"2026-06-03T00:54:42.910Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-dHPLVa/project/c_src/src/blt.h","content":"// = Crit-bit trees =\n//\n// Usage:\n//\n//   // Create a new tree.\n//   BLT* blt = blt_new();\n//\n//   // Insert a couple of keys.\n//   blt_put(blt, \"hello\", pointer1);\n//   blt_put(blt, \"world\", pointer2);\n//\n//   // Check they have the values we expect.\n//   if (blt_get(blt, \"hello\")->data != pointer1 ||\n//       blt_get(blt, \"hello\")->data != pointer2) exit(1);\n//\n//   // Delete the tree.\n//   blt_clear(blt);\n\nstruct BLT;\ntypedef struct BLT BLT;\nstruct BLT_IT {\n  char *key;\n  void *data;\n};\ntypedef struct BLT_IT BLT_IT;\n\n// Creates a new tree.\nBLT *blt_new();\n\n// Destroys a tree.\nvoid blt_clear(BLT *blt);\n\n// Retrieves the leaf node at a given key.\n// Returns NULL if there is no such key.\nBLT_IT *blt_get(BLT *blt, char *key);\n\n// Creates or retrieves the leaf node at a given key.\nBLT_IT *blt_set(BLT *blt, char *key);\n\n// Creates or retrieves the leaf node at a given key.\n// If is_new is not NULL, sets *is_new to 1 if a new node was created,\n// and 0 otherwise.\nBLT_IT *blt_setp(BLT *blt, char *key, int *is_new);\n\n// Inserts a given key and data pair.\n// Returns the leaf node containing them.\nBLT_IT *blt_put(BLT *blt, char *key, void *data);\n\n// Inserts a given key and data pair if key is absent.\n// Returns 0 on success. Returns 1 if key is already present.\nint blt_put_if_absent(BLT *blt, char *key, void *data);\n\n// Deletes a given key from the tree.\n// Returns 1 if a key was deleted, and 0 otherwise.\nint blt_delete(BLT *blt, char *key);\n\n// Iterates through all leaf nodes with a given prefix in order and runs the\n// given callback on each one.\n// If the callback returns 1, continues iteration, otherwise halts and returns\n// the value returned by the callback.\nint blt_allprefixed(BLT *blt, char *key, int (*fun)(BLT_IT *));\n\n// Iterates through all leaf nodes in order and runs the given callback.\nstatic inline void blt_forall(BLT *blt, void (*fun)(BLT_IT *)) {\n  int f(BLT_IT *it) { return fun(it), 1; }\n  blt_allprefixed(blt, \"\", f);\n}\n\n// Returns the leaf node with the smallest key.\nBLT_IT *blt_first(BLT *blt);\n\n// Returns the leaf node with the largest key.\nBLT_IT *blt_last (BLT *blt);\n\n// Returns the leaf node with the next largest key.\nBLT_IT *blt_next(BLT *blt, BLT_IT *it);\n\n// Returns the leaf node with the next smallest key.\nBLT_IT *blt_prev(BLT *blt, BLT_IT *it);\n\n// If the given key is present, returns its leaf node.\n// Otherwise returns the leaf node with the next largest key if it exists,\n// and NULL otherwise.\nBLT_IT *blt_ceil (BLT *blt, char *key);\n\n// If the given key is present, returns its leaf node.\n// Otherwise returns the leaf node with the next smallest key if it exists,\n// and NULL otherwise.\nBLT_IT *blt_floor(BLT *blt, char *key);\n\n// Returns the number of bytes used by the tree, excluding memory taken by\n// the bytes of the keys.\nsize_t blt_overhead(BLT *blt);\n\n// Returns 1 if tree is empty, 0 otherwise.\nint blt_empty(BLT *blt);\n\n// Returns number of keys.\nint blt_size(BLT *blt);\n","numLines":100,"startLine":1,"totalLines":100}}}
