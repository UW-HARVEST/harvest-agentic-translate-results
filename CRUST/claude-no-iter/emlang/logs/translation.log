: usize,\n    pub r#ref: usize,\n    pub ran: bool,\n}\nimpl fmt::Display for Em {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        write!(f, \"<{}\", self.em_type)?;\n        match self.em_type {\n            EmType::Push => {\n                write!(f, \" {}\", self.data)?;\n            }\n            EmType::PrintEnd => {\n                let val = match &self.data.value {\n                    data::DataValue::Int(v) => *v as i32,\n                    _ => 0,\n                };\n                let s = if val == DATA_STDOUT { \"stdout\" } else { \"stderr\" };\n                write!(f, \" {}\", s)?;\n            }\n            EmType::PrintBegin | EmType::IfBegin => {\n                write!(f, \" ref: {}\", self.r#ref)?;\n            }\n            _ => {}\n        }\n        write!(f, \" {}:{}:{}>\\n\", self.path, self.row, self.col)\n    }\n}\nimpl Em {\n    pub fn new(typ: EmType) -> Self {\n        Em {\n            data: data::Data::new(data::DataType::Int),\n            em_type: typ,\n            path: String::new(),\n            row: 0,\n            col: 0,\n            r#ref: 0,\n            ran: false,\n        }\n    }\n    pub fn new_with_data(typ: EmType, data: data::Data) -> Self {\n        Em {\n            data,\n            em_type: typ,\n            path: String::new(),\n            row: 0,\n            col: 0,\n            r#ref: 0,\n            ran: false,\n        }\n    }\n}\n#[derive(Debug, Clone)]\npub struct Program {\n    pub ems: Vec<Em>,\n    pub cap: usize,\n    pub size: usize,\n}\nimpl Program {\n    pub fn new(cap: usize) -> Self {\n        assert!(cap > 0);\n        Program {\n            ems: Vec::with_capacity(cap),\n            cap,\n            size: 0,\n        }\n    }\n    pub fn push(&mut self, em: Em) {\n        if self.size >= self.cap {\n            self.cap *= 2;\n            self.ems.reserve(self.cap - self.ems.capacity());\n        }\n        self.ems.push(em);\n        self.size += 1;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2117,"cache_read_input_tokens":43018,"cache_creation":{"ephemeral_5m_input_tokens":2117,"ephemeral_1h_input_tokens":0},"output_tokens":29,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bda00bf9-5d24-4133-a199-4e15d6cb178b","uuid":"a6080514-2ed3-4146-85ca-c56fc3404b18"}
