 }\n        let data = self.buf[self.size - off - 1].clone();\n        self.push(data);\n        0\n    }\n\n    pub(crate) fn swap(&mut self, off: usize) -> i32 {\n        if off + 1 > self.size {\n            return -1;\n        }\n        let last = self.size - 1;\n        let other = self.size - off - 1;\n        self.buf.swap(other, last);\n        0\n    }\n\n    pub(crate) fn shrink_to(&mut self, size: usize) {\n        if size == self.size {\n            return;\n        }\n        assert!(size < self.size);\n        for i in size..self.size {\n            if let data::DataValue::Str(ref s) = self.buf[i].value {\n                let s = s.clone();\n                self.add_popped(s);\n            }\n        }\n        self.buf.truncate(size);\n        self.size = size;\n    }\n\n    pub(crate) fn clear(&mut self) {\n        self.shrink_to(0);\n        self.gc();\n    }\n\n    pub(crate) fn gc(&mut self) {\n        // Since we use Rust strings (owned), simply clear popped tracking\n        self.popped.clear();\n        self.popped_size = 0;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2858,"cache_read_input_tokens":45135,"cache_creation":{"ephemeral_5m_input_tokens":2858,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bda00bf9-5d24-4133-a199-4e15d6cb178b","uuid":"9022db73-092e-4746-ad57-49a48a57aa4e"}
