 \", equal: %d \\n\", mlen, actual1, actual2, are_equal);\n104\t            free(m);\n105\t            assert(!are_equal); // strictly speaking this would not be a bug, but if it happens, it is very likely to be a bug!\n106\t        }\n107\t    }\n108\t\n109\t    free(k);\n110\t    printf(\"Test passed! \\n\");\n111\t}\n112\t\n113\t\n114\tstatic void clhashtest() {\n115\t    const int N = 1024;\n116\t    char * array  = (char*)malloc(N);\n117\t    char *  rs = (char*)malloc(RANDOM_BYTES_NEEDED_FOR_CLHASH);\n118\t    for(int k = 0; k<N; ++k) {\n119\t        array[k] = 0;\n120\t    }\n121\t    for(int k = 0; k < RANDOM_BYTES_NEEDED_FOR_CLHASH ; ++k) {\n122\t        rs[k] = (char) (1-k);\n123\t    }\n124\t\n125\t    printf(\"[clhashtest] checking that flipping a bit changes hash value with clhash \\n\");\n126\t    for(int bit = 0; bit < 64; ++bit ) {\n127\t        for(int length = (bit+8)/8; length <= (int)sizeof(uint64_t); ++length) {\n128\t            uint64_t x = 0;\n129\t            uint64_t orig = clhash(rs, (const char *)&x, length);\n130\t            x ^= ((uint64_t)1) << bit;\n131\t            uint64_t flip = clhash(rs, (const char *)&x, length);\n132\t            assert(flip != orig);\n133\t            x ^= ((uint64_t)1) << bit;\n134\t            uint64_t back = clhash(rs, (const char *)&x, length);\n135\t            assert(back == orig);\n136\t        }\n137\t    }\n138\t\n139\t    free(array);\n140\t    free(rs);\n141\t    printf(\"Test passed! \\n\");\n142\t}\n143\t\n144\tvoid demo() {\n145\t    // generate random key\n146\t    void * random =  get_random_key_for_clhash(UINT64_C(0x23a23cf5033c3c81),UINT64_C(0xb3816f6a2c68e530));\n147\t    uint64_t hashvalue1 = clhash(random,\"my dog\",6);\n148\t    uint64_t hashvalue2 = clhash(random,\"my cat\",6);\n149\t    uint64_t hashvalue3 = clhash(random,\"my dog\",6);\n150\t    assert(hashvalue1 == hashvalue3);\n151\t    assert(hashvalue1 != hashvalue2);// very likely to be true\n152\t\n153\t    free(random);\n154\t}