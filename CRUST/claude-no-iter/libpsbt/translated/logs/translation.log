,"+    }","+","+    psbt.state = PsbtState::Init;","+    psbt.write_pos = 0;","+    psbt.data_capacity = src_size;","+    let end = src_size;","+","+    let mut counter = PsbtTxCounter {","+        inputs: 0,","+        outputs: 0,","+    };","+    let mut kvs: i32 = 0;","+","+    while psbt.state != PsbtState::Finalized && psbt.write_pos <= end {","+        match psbt.state {","+            PsbtState::Init => {","+                let res = psbt_read_header(psbt, src_size);","+                if res != PsbtResult::Ok {","+                    return res;","+                }","+            }","+            PsbtState::Global | PsbtState::Inputs | PsbtState::Outputs => {","+                if psbt.write_pos >= src_size {","+                    return PsbtResult::ReadError;","+                }","+                if psbt.data[psbt.write_pos] == 0 {","+                    match psbt.state {","+                        PsbtState::Global => {","+                            psbt.state = PsbtState::InputsNew;","+                        }","+                        PsbtState::Inputs => {","+                            kvs += 1;","+                            if kvs >= counter.inputs {","+                                psbt.state = PsbtState::OutputsNew;","+                                kvs = 0;","+                            } else {","+                                psbt.state = PsbtState::InputsNew;","+                            }","+                        }","+                        PsbtState::Outputs => {","+                            kvs += 1;","+                            if kvs >= counter.outputs {","+                                psbt.state = PsbtState::Finalized;","+                            } else {","+                                psbt.state = PsbtState::OutputsNew;","+                            }","+                        }","+                        _ => unreachable!(),","+                    }","+                } else {","+                    let rec = match psbt_read_record(psbt, src_size) {","+                        Ok(r) => r,","+                        Err(e) => return e,","+                    };","+","+                    let is_global_unsigned_tx = psbt.state == PsbtState::Global","+                        && rec.record_type == PsbtGlobalType::UnsignedTx as u8;","+","+                    if is_global_unsigned_tx {","+                        // Parse the inner Bitcoin transaction so we can count","+                        // inputs and outputs.","+                        struct Forward<'a> {","+                            counter: &'a mut PsbtTxCounter,","+                            handler: Option<PsbtElemHandler>,","+                            user_data: *mut dyn std::any::Any,","+                        }","+","+                        // We can't call a closure as `PsbtTxElemHandler` (which","+                        // is a `fn`), so manually drive the parser. Instead of","+                        // using the handler through the parser, do counting +","+                        // forwarding via a thread-local counter.","+                        thread_local! {","+                            static COUNTER_CTX: std::cell::RefCell<Option<CounterCtx>> =","+                                std::cell::RefCell::new(None);","+                        }","+","+                        struct CounterCtx {","+                            inputs: i32,","+                            outputs: i32,","+                            handler: Option<PsbtElemHandler>,","+                            user_data_ptr: *mut (),","+                        }","+                        // Suppress dead-code warning.","+                        let _ = Forward {","+                            counter: &mut counter,","+                            handler: elem_handler,","+                            user_data: user_data,","+                        };","+","+                        let val = rec.val.clone();","+                