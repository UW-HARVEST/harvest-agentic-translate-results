eason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":518,"cache_read_input_tokens":95790,"cache_creation":{"ephemeral_5m_input_tokens":518,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6388ac7b-7c6f-4bec-a3ae-44c7867b1300","uuid":"beacc388-0ea0-4876-a587-780516cbd6e0"}
