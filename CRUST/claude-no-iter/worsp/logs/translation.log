  let v = eval_expr(","+                get_expr_list_at(exprs_opt, 1).expect(\"print requires arg\"),","+                env,","+                context,","+            );","+            println!(\"{}\", stringify_object(&v));","+            nil_object()","+        }","+        \"car\" => {","+            let v = eval_expr(","+                get_expr_list_at(exprs_opt, 1).expect(\"car requires arg\"),","+                env,","+                context,","+            );","+            if !matches!(v.type_, ObjectType::List) {","+                panic!(\"Type error: car operand must be list.\");","+            }","+            if let ObjectValue::ListValue(Some(cell)) = v.value {","+                if let Some(car) = cell.car {","+                    return *car;","+                }","+            }","+            nil_object()","+        }","+        \"cdr\" => {","+            let v = eval_expr(","+                get_expr_list_at(exprs_opt, 1).expect(\"cdr requires arg\"),","+                env,","+                context,","+            );","+            if !matches!(v.type_, ObjectType::List) {","+                panic!(\"Type error: cdr operand must be list.\");","+            }","+            if let ObjectValue::ListValue(Some(cell)) = v.value {","+                if let Some(cdr) = cell.cdr {","+                    return *cdr;","+                }","+            }","+            nil_object()","+        }","+        \"cons\" => {","+            let op1 = eval_expr(","+                get_expr_list_at(exprs_opt, 1).expect(\"cons arg1\"),","+                env,","+                context,","+            );","+            let op2 = eval_expr(","+                get_expr_list_at(exprs_opt, 2).expect(\"cons arg2\"),","+                env,","+                context,","+            );","+            cons_op(op1, op2)","+        }","+        \"split\" => {","+            let op1 = eval_expr(","+                get_expr_list_at(exprs_opt, 1).expect(\"split arg1\