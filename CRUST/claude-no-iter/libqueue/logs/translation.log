pub fn front(&self) -> Option<&T> {\n        self.head.as_ref().map(|node| &node.value)\n    }\n    /// Returns a reference to the value at the back of the queue.\n    pub fn back(&self) -> Option<&T> {\n        let mut current = self.head.as_deref()?;\n        while let Some(next) = current.next.as_deref() {\n            current = next;\n        }\n        Some(&current.value)\n    }\n    /// Frees all nodes in the queue.\n    pub fn free(&mut self) {\n        // Iteratively drop all nodes to avoid potential stack overflow\n        // from recursive Drop on long lists.\n        let mut current = self.head.take();\n        while let Some(mut node) = current {\n            current = node.next.take();\n        }\n        self.tail = None;\n        self.size = 0;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":788,"cache_read_input_tokens":18035,"cache_creation":{"ephemeral_5m_input_tokens":788,"ephemeral_1h_input_tokens":0},"output_tokens":42,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"84c099e5-507b-4eb9-ba67-4c09ebe4620c","uuid":"cc3c0967-f9b3-4621-b537-7e7c3c805d48"}
