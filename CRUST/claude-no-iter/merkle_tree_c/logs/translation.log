xof_length: 0,","+        node_depth: 0,","+        inner_length: 0,","+        reserved: [0u8; 14],","+        salt: [0u8; BLAKE2B_SALTBYTES],","+        personal: [0u8; BLAKE2B_PERSONALBYTES],","+    };","+    for i in 0..BLAKE2B_PERSONALBYTES {","+        p.personal[i] = DEFAULT_PERSONAL[i];","+    }","+    blake2b_init_param(state, &p)"," }","+"," pub fn blake2b_init_key(state: &mut Blake2bState, outlen: usize, key: &[u8]) -> i32 {","-    unimplemented!()","+    if outlen == 0 || outlen > BLAKE2B_OUTBYTES {","+        return -1;","+    }","+    if key.is_empty() || key.len() > BLAKE2B_KEYBYTES {","+        return -1;","+    }","+    let p = Blake2bParam {","+        digest_length: outlen as u8,","+        key_length: key.len() as u8,","+        fanout: 1,","+        depth: 1,","+        leaf_length: 0,","+        node_offset: 0,","+        xof_length: 0,","+        node_depth: 0,","+        inner_length: 0,","+        reserved: [0u8; 14],","+        salt: [0u8; BLAKE2B_SALTBYTES],","+        personal: [0u8; BLAKE2B_PERSONALBYTES],","+    };","+    if blake2b_init_param(state, &p) < 0 {","+        return -1;","+    }","+    let mut block = [0u8; BLAKE2B_BLOCKBYTES];","+    block[..key.len()].copy_from_slice(key);","+    blake2b_update(state, &block);","+    // zero out (best-effort)","+    for b in block.iter_mut() {","+        *b = 0;","+    }","+    0"," }","+"," pub fn blake2b_init_param(state: &mut Blake2bState, param: &Blake2bParam) -> i32 {","-    unimplemented!()","+    blake2b_init0(state);","+    let p_bytes = blake2b_param_bytes(param);","+    for i in 0..8 {","+        state.h[i] ^= load64(&p_bytes[i * 8..i * 8 + 8]);","+    }","+    state.outlen = param.digest_length as usize;","+    0"," }","+"," pub fn blake2b_update(state: &mut Blake2bState, input: &[u8]) -> i32 {","-    unimplemented!()","+    let mut inlen = input.len();","+    if inlen == 0 {","+        return 0;","+    }","+    let mut offset = 0usize;","+    let left = state.buflen;","+    let