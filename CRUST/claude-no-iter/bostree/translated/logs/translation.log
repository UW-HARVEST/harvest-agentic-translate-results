 is a left child.\n    let mut current = node.clone();\n    loop {\n        let parent_opt = parent_of(&current);\n        match parent_opt {\n            None => return None,\n            Some(parent) => {\n                let is_left = parent\n                    .borrow()\n                    .left_child_node\n                    .as_ref()\n                    .map_or(false, |c| Rc::ptr_eq(c, &current));\n                if is_left {\n                    current = parent;\n                } else {\n                    return Some(parent);\n                }\n            }\n        }\n    }\n}\n/// Return the rank (in-order index) of the given node.\npub fn bostree_rank(node: &Rc<RefCell<BOSNode>>) -> u32 {\n    let mut counter = node.borrow().left_child_count;\n    let mut current = node.clone();\n    loop {\n        let parent_opt = parent_of(&current);\n        match parent_opt {\n            None => break,\n            Some(parent) => {\n                let is_right = parent\n                    .borrow()\n                    .right_child_node\n                    .as_ref()\n                    .map_or(false, |c| Rc::ptr_eq(c, &current));\n                if is_right {\n                    counter += 1 + parent.borrow().left_child_count;\n                }\n                current = parent;\n            }\n        }\n    }\n    counter\n}\n","structuredPatch":[{"oldStart":40,"oldLines":25,"newStart":40,"newLines":503,"lines":[" /// Type alias for a free function which will be called on nodes"," /// that are removed."," pub type BOSTreeFreeFunction = fn(&Rc<RefCell<BOSNode>>);","+","+// ---------- Helper functions ----------","+","+fn imax(a: u32, b: u32) -> u32 {","+    if a > b {","+        a","+    } else {","+        b","+    }","+}","+","+fn opt_depth(opt: &Option<Rc<RefCell<BOSNode>>>) -> u32 {","+    opt.as_ref().map_or(0, |n| n.borrow().depth + 1)","+}","+","+fn node_balance(node: &Rc<RefCell<BOSNode>>) -> i32 {","+    let n = node.borrow();","+    let 