 u32 - offset as u32 - 1;\n            callback(state, LZMAPacket::match_packet(dist, length as u32));\n            for i in 0..4 {\n                if dist == state.dists[i] {\n                    callback(state, LZMAPacket::long_rep_packet(i as u32, length as u32));\n                }\n            }\n        });\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":479,"cache_read_input_tokens":96953,"cache_creation":{"ephemeral_5m_input_tokens":479,"ephemeral_1h_input_tokens":0},"output_tokens":42,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"205ecade-39cf-4d13-b69e-9a520860867d","uuid":"b344cbb6-9bc8-4f6f-b030-8b429ee0c382"}
