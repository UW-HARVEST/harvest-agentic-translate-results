{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01WBeDqqqSzete9H8WchjZum","type":"tool_result","content":"1\t#include \"max_heap_test.h\"\n2\t#include \"../src/max_heap.h\"\n3\t#include \"test_util.h\"\n4\t#include <stdio.h>\n5\t#include <stdlib.h>\n6\t\n7\tstatic int plain_comparator(void* comparator_data, unsigned a, unsigned b)\n8\t{\n9\t\t(void) comparator_data;\n10\t\treturn a - b;\n11\t}\n12\t\n13\tvoid swap(unsigned *a, unsigned *b)\n14\t{\n15\t\tunsigned temp = *a;\n16\t\t*a = *b;\n17\t\t*b = temp;\n18\t}\n19\t\n20\tstatic void initialize_random_data(unsigned* data, size_t data_size, unsigned seed)\n21\t{\n22\t\tsrand(seed);\n23\t\tfor (size_t i = 0; i < data_size; i++) {\n24\t\t\tdata[i] = i;\n25\t\t}\n26\t\n27\t\tfor (size_t i = 0; i < data_size; i++) {\n28\t\t\tsize_t j = rand() % (i + 1);\n29\t\t\tswap(&data[i], &data[j]);\n30\t\t}\n31\t}\n32\t\n33\tstatic void print_data(unsigned* data, size_t data_size)\n34\t{\n35\t\tfor (size_t i = 0; i < data_size; i++) {\n36\t\t\tprintf(\"%d \", data[i]);\n37\t\t}\n38\t}\n39\t\n40\t//use the max heap to sort a list of 10 elements in descending order\n41\tstatic void max_heap_sort_test()\n42\t{\n43\t\tPRETTY_PRINT_SUB_TEST_NAME();\n44\t\n45\t\tsize_t heap_size = 10;\n46\t\tMaxHeap* heap = max_heap_new(heap_size, plain_comparator, NULL);\n47\t\tTEST_ASSERT(heap != NULL, \"Could not allocate heap!\");\n48\t\n49\t\tunsigned data[heap_size];\n50\t\tinitialize_random_data(data, heap_size, 666);\n51\t\n52\t\tprintf(\"sorting data with heap: \");\n53\t\tprint_data(data, heap_size);\n54\t\tprintf(\"\\n\");\n55\t\n56\t\tfor (size_t i = 0; i < heap_size; i++) {\n57\t\t\tTEST_ASSERT(max_heap_insert(heap, data[i]), \"Could not insert into heap!\");\n58\t\t}\n59\t\n60\t\tTEST_ASSERT_EQ(max_heap_count(heap), heap_size, \"Heap wrong size! expected: %ld, got %ld\");\n61\t\n62\t\tprintf(\"sorted data: \");\n63\t\tfor (size_t i = 0; i < heap_size; i++) {\n64\t\t\tunsigned value = 0;\n65\t\t\tunsigned expected_value = heap_size - i - 1;\n66\t\t\tTEST_ASSERT(max_heap_maximum(heap, &value), \"Could not get heap maximum!\");\n67\t\t\tTEST_ASSERT_EQ(value, expected_value, \"Maximum value in heap unexpected! expected: %d, got %d\");\n68\t\t\tTEST_ASSERT(max_heap_remove_maximum(heap), \"Could not pop heap!\");\n69\t\t\tprintf(\"%d \", value);\n70\t\t}\n71\t\tprintf(\"\\n\");\n72\t\n73\t\tTEST_ASSERT_EQ(max_heap_count(heap), (size_t)0, \"Heap wrong size! expected: %ld, got %ld\");\n74\t\n75\t\tmax_heap_free(heap);\n76\t}\n77\t\n78\ttypedef struct {\n79\t\tunsigned* data;\n80\t\tsize_t data_size;\n81\t\tsize_t data_count;\n82\t} BackingStoreData;\n83\t\n84\tstatic int backing_store_comparator(void* comparator_data, unsigned a, unsigned b)\n85\t{\n86\t\tBackingStoreData* backing_store = (BackingStoreData*) comparator_data;\n87\t\tTEST_ASSERT(a < backing_store->data_size, \"Heap tried to compare a value outside the backing store!\");\n88\t\tTEST_ASSERT(b < backing_store->data_size, \"Heap tried to compare a value outside the backing store!\");\n89\t\treturn backing_store->data[a] - backing_store->data[b];\n90\t}\n91\t\n92\t//use the max heap to store the smallest 10 values of a 100 value array\n93\tstatic void max_heap_top_k_test()\n94\t{\n95\t\tPRETTY_PRINT_SUB_TEST_NAME();\n96\t\n97\t\tsize_t heap_size = 10;\n98\t\tBackingStoreData backing_store;\n99\t\tbacking_store.data = malloc(heap_size * sizeof(unsigned));\n100\t\tTEST_ASSERT(backing_store.data != NULL, \"Could not allocate backing_store->data!\");\n101\t\tbacking_store.data_size = heap_size;\n102\t\tbacking_store.data_count = 0;\n103\t\n104\t\tMaxHeap* heap = max_heap_new(heap_size, backing_store_comparator, &backing_store);\n105\t\tTEST_ASSERT(heap != NULL, \"Could not allocate heap!\");\n106\t\n107\t\tsize_t data_size = 100;\n108\t\tunsigned data[data_size];\n109\t\tinitialize_random_data(data, data_size, 666);\n110\t\tprintf(\"collecting top %ld data in: \", heap_size);\n111\t\tprint_data(data, data_size);\n112\t\tprintf(\"\\n\");\n113\t\n114\t\tfor (size_t i = 0; i < data_size; i++) {\n115\t\t\t//if there is still space, just insert\n116\t\t\tif (backing_store.data_count < backing_store.data_size) {\n117\t\t\t\tsize_t pos = backing_store.data_count++;\n118\t\t\t\tbacking_store.data[pos] = data[i];\n119\t\t\t\tmax_heap_insert(heap, pos);\n120\t\t\t\tcontinue;\n121\t\t\t}\n122\t\t\t//otherwise, we must compare with the maximum and replace if needed\n123\t\t\tunsigned maximum;\n124\t\t\tTEST_ASSERT(max_heap_maximum(heap, &maximum), \"Could not get heap maximum!\");\n125\t\t\tif (data[i] < backing_store.data[maximum]) {\n126\t\t\t\tbacking_store.data[maximum] = data[i];\n127\t\t\t\tmax_heap_update_maximum(heap);\n128\t\t\t}\n129\t\t}\n130\t\n131\t\tprintf(\"top %ld data: \", heap_size);\n132\t\tfor (size_t i = 0; i < heap_size; i++) {\n133\t\t\tunsigned value = 0;\n134\t\t\tunsigned expected_value = heap_size - i - 1;\n135\t\t\tTEST_ASSERT(max_heap_maximum(heap, &value), \"Could not get heap maximum!\");\n136\t\t\tTEST_ASSERT(value < backing_store.data_size, \"Maximum value exceeds backing_store data size!\");\n137\t\t\tTEST_ASSERT_EQ(backing_store.data[value], expected_value, \"Maximum value in heap unexpected! expected: %d, got %d\");\n138\t\t\tTEST_ASSERT(max_heap_remove_maximum(heap), \"Could not pop heap!\");\n139\t\t\tprintf(\"%d \", backing_store.data[value]);\n140\t\t}\n141\t\tprintf(\"\\n\");\n142\t\n143\t\tfree(backing_store.data);\n144\t\tmax_heap_free(heap);\n145\t}\n146\t\n147\tvoid max_heap_test()\n148\t{\n149\t\tPRETTY_PRINT_TEST_NAME();\n150\t\n151\t\tmax_heap_sort_test();\n152\t\tmax_heap_top_k_test();\n153\t}\n154\t"}]},"parent_tool_use_id":null,"session_id":"205ecade-39cf-4d13-b69e-9a520860867d","uuid":"d5f1a1b0-7530-476f-a856-528c8e485102","timestamp":"2026-06-03T00:22:08.140Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-xhDVEL/project/c_src/tests/max_heap_test.c","content":"#include \"max_heap_test.h\"\n#include \".