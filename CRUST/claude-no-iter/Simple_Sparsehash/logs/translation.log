{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Tmib66pxqQta6xsdhYzb84","type":"tool_result","content":"1\tuse Simple_Sparsehash::simple_sparsehash;\n2\tuse std::convert::TryInto;\n3\t\n4\t// --- Helper function ---\n5\t/// Converts an i32 into a byte slice.\n6\tfn i32_to_bytes(n: i32) -> [u8; std::mem::size_of::<i32>()] {\n7\t    n.to_ne_bytes()\n8\t}\n9\t\n10\t// --- Tests corresponding to test.c ---\n11\t\n12\t#[test]\n13\tfn test_empty_array_does_not_blow_up() {\n14\t    let arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u64>(), 32)\n15\t        .expect(\"sparse_array_init failed to create an array\");\n16\t    // Expect that getting index 0 returns None.\n17\t    assert!(simple_sparsehash::sparse_array_get(&arr, 0, None).is_none());\n18\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n19\t}\n20\t\n21\t#[test]\n22\tfn test_cannot_set_outside_bounds() {\n23\t    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u64>(), 32)\n24\t        .expect(\"sparse_array_init failed\");\n25\t    let test_num: u64 = 666;\n26\t    let test_bytes = test_num.to_ne_bytes();\n27\t    // Expect failure (0) when setting index 35 (out of bounds).\n28\t    assert_eq!(\n29\t        simple_sparsehash::sparse_array_set(&mut arr, 35, &test_bytes, std::mem::size_of::<u64>()),\n30\t        0,\n31\t        \"Expected setting outside bounds to return 0\"\n32\t    );\n33\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n34\t}\n35\t\n36\t#[test]\n37\tfn test_cannot_get_outside_bounds() {\n38\t    let arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u64>(), 32)\n39\t        .expect(\"sparse_array_init failed\");\n40\t    assert!(\n41\t        simple_sparsehash::sparse_array_get(&arr, 35, None).is_none(),\n42\t        \"Expected getting outside bounds to return None\"\n43\t    );\n44\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n45\t}\n46\t\n47\t#[test]\n48\tfn test_cannot_set_bigger_elements() {\n49\t    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u8>(), 100)\n50\t        .expect(\"sparse_array_init failed\");\n51\t    let test_num: u64 = 666;\n52\t    let test_bytes = test_num.to_ne_bytes();\n53\t    // Expect failure (0) when the value size is larger than element size.\n54\t    assert_eq!(\n55\t        simple_sparsehash::sparse_array_set(&mut arr, 0, &test_bytes, std::mem::size_of::<u64>()),\n56\t        0,\n57\t        \"Expected setting element with bigger size to return 0\"\n58\t    );\n59\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n60\t}\n61\t\n62\t#[test]\n63\tfn test_array_set_backwards() {\n64\t    let array_size = 120;\n65\t    let mut arr =\n66\t        simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), array_size as u32)\n67\t            .expect(\"sparse_array_init failed\");\n68\t\n69\t    // Set values in reverse order.\n70\t    for i in (0..array_size).rev() {\n71\t        let i_val = i as i32;\n72\t        let bytes = i32_to_bytes(i_val);\n73\t        assert!(\n74\t            simple_sparsehash::sparse_array_set(\n75\t                &mut arr,\n76\t                i as u32,\n77\t                &bytes,\n78\t                std::mem::size_of::<i32>()\n79\t            ) != 0,\n80\t            \"Failed to set index {}\",\n81\t            i\n82\t        );\n83\t        let mut size: usize = 0;\n84\t        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n85\t            .expect(\"Expected value\");\n86\t        assert_eq!(returned.len(), std::mem::size_of::<i32>());\n87\t        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n88\t        assert_eq!(retrieved, i_val);\n89\t        assert_eq!(size, std::mem::size_of::<i32>());\n90\t    }\n91\t\n92\t    // Retrieve values in reverse order.\n93\t    for i in (0..array_size).rev() {\n94\t        let mut size: usize = 0;\n95\t        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n96\t            .expect(\"Expected value\");\n97\t        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n98\t        assert_eq!(retrieved, i as i32);\n99\t        assert_eq!(size, std::mem::size_of::<i32>());\n100\t    }\n101\t\n102\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n103\t}\n104\t\n105\t#[test]\n106\tfn test_array_set() {\n107\t    let array_size = 130;\n108\t    let mut arr =\n109\t        simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), array_size as u32)\n110\t            .expect(\"sparse_array_init failed\");\n111\t\n112\t    for i in 0..array_size {\n113\t        let i_val = i as i32;\n114\t        let bytes = i32_to_bytes(i_val);\n115\t        assert!(\n116\t            simple_sparsehash::sparse_array_set(\n117\t                &mut arr,\n118\t                i as u32,\n119\t                &bytes,\n120\t                std::mem::size_of::<i32>()\n121\t            ) != 0,\n122\t            \"Failed to set index {}\",\n123\t            i\n124\t        );\n125\t        let mut size: usize = 0;\n126\t        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n127\t            .expect(\"Expected value\");\n128\t        assert_eq!(returned.len(), std::mem::size_of::<i32>());\n129\t        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n130\t        assert_eq!(retrieved, i_val);\n131\t        assert_eq!(size, std::mem::size_of::<i32>());\n132\t    }\n133\t\n134\t    for i in 0..array_size {\n135\t        let mut size: usize = 0;\n136\t        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n137\t            .expect(\"Expected value\");\n138\t        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n139\t        assert_eq!(retrieved, i as i32);\n140\t        assert_eq!(size, std::mem::size_of::<i32>());\n141\t    }\n142\t\n143\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n144\t}\n145\t\n146\t#[test]\n147\tfn test_array_set_high_num() {\n148\t    let test_num: i32 = 65_555_555;\n149\t    let index = simple_sparsehash::GROUP_SIZE - 1;\n150\t    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), 140)\n151\t        .expect(\"sparse_array_init failed\");\n152\t\n153\t    let bytes = i32_to_bytes(test_num);\n154\t    assert!(\n155\t        simple_sparsehash::sparse_array_set(\n156\t            &mut arr,\n157\t            index as u32,\n158\t            &bytes,\n159\t            std::mem::size_of::<i32>()\n160\t        ) != 0,\n161\t        \"Failed to set at high index\"\n162\t    );\n163\t    let mut size: usize = 0;\n164\t    let returned = simple_sparsehash::sparse_array_get(&arr, index as u32, Some(&mut size))\n165\t        .expect(\"Expected value\");\n166\t    let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n167\t    assert_eq!(retrieved, test_num);\n168\t    assert_eq!(size, std::mem::size_of::<i32>());\n169\t\n170\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n171\t}\n172\t\n173\t#[test]\n174\tfn test_array_set_overwrites_old_values() {\n175\t    let test_num: i32 = 666;\n176\t    let test_num2: i32 = 1024;\n177\t    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), 150)\n178\t        .expect(\"sparse_array_init failed\");\n179\t\n180\t    let bytes1 = i32_to_bytes(test_num);\n181\t    let bytes2 = i32_to_bytes(test_num2);\n182\t    assert!(\n183\t        simple_sparsehash::sparse_array_set(&mut arr, 0, &bytes1, std::mem::size_of::<i32>()) != 0,\n184\t        \"Failed to set first value\"\n185\t    );\n186\t    assert!(\n187\t        simple_sparsehash::sparse_array_set(&mut arr, 0, &bytes2, std::mem::size_of::<i32>()) != 0,\n188\t        \"Failed to overwrite value\"\n189\t    );\n190\t\n191\t    let returned = simple_sparsehash::sparse_array_get(&arr, 0, None).expect(\"Expected value\");\n192\t    let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n193\t    assert_eq!(retrieved, test_num2);\n194\t\n195\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n196\t}\n197\t\n198\t#[test]\n199\tfn test_array_get() {\n200\t    let test_num: i32 = 666;\n201\t    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), 200)\n202\t        .expect(\"sparse_array_init failed\");\n203\t    let bytes = i32_to_bytes(test_num);\n204\t    assert!(\n205\t        simple_sparsehash::sparse_array_set(&mut arr, 0, &bytes, std::mem::size_of::<i32>()) != 0,\n206\t        \"Failed to set value\"\n207\t    );\n208\t\n209\t    let mut size: usize = 0;\n210\t    let returned =\n211\t        simple_sparsehash::sparse_array_get(&arr, 0, Some(&mut size)).expect(\"Expected value\");\n212\t    let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n213\t    assert_eq!(retrieved, test_num);\n214\t    assert_eq!(size, std::mem::size_of::<i32>());\n215\t\n216\t    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n217\t}\n218\t\n219\t#[test]\n220\tfn test_dict_set() {\n221\t    let mut dict = simple_sparsehash::sparse_dict_init().expect(\"sparse_dict_init failed\");\n222\t    assert!(\n223\t        simple_sparsehash::sparse_dict_set(\n224\t            &mut dict,\n225\t            \"key\",\n226\t            \"key\".len(),\n227\t            \"value\".as_bytes(),\n228\t            \"value\".len()\n229\t        ) != 0,\n230\t        \"Failed to set dictionary entry\"\n231\t    );\n232\t    assert!(simple_sparsehash::sparse_dict_free(dict) != 0);\n233\t}\n234\t\n235\t#[test]\n236\tfn test_dict_get() {\n237\t    let mut dict = simple_sparsehash::sparse_dict_init().expect(\"sparse_dict_init failed\");\n238\t    assert!(\n239\t        simple_sparsehash::sparse_dict_set(\n240\t            &mut dict,\n241\t            \"key\",\n242\t            \"key\".len(),\n243\t            \"value\".as_bytes(),\n244\t            \"value\".len()\n245\t        ) != 0,\n246\t        \"Failed to set dictionary entry\"\n247\t    );\n248\t\n249\t    let mut outsize: usize = 0;\n250\t    let value = simple_sparsehash::sparse_dict_get(&dict, \"key\", \"key\".len(), Some(&mut outsize))\n251\t        .expect(\"Expected value\");\n252\t    assert_eq!(outsize, \"value\".len());\n253\t    assert_eq!(value, \"value\".as_bytes());\n254\t    assert!(simple_sparsehash::sparse_dict_free(dict) != 0);\n255\t}\n256\t\n257\t#[test]\n258\tfn test_dict_lots_of_set() {\n259\t    let mut dict = simple_sparsehash::sparse_dict_init().expect(\"sparse_dict_init failed\");\n260\t    let iterations = 1_000_000;\n261\t    for i in 0..iterations {\n262\t        let key = format!(\"crazy hash{}\", i);\n263\t        let val = format!(\"value{}\", i);\n264\t        assert!(\n265\t            simple_sparsehash::sparse_dict_set(\n266\t                &mut dict,\n267\t                &key,\n268\t                key.len(),\n269\t                val.as_bytes(),\n270\t                val.len()\n271\t            ) != 0,\n272\t            \"Failed to set dict entry at iteration {}\",\n273\t            i\n274\t        );\n275\t        // Check that the bucket count matches the expected number.\n276\t        assert_eq!(\n277\t            dict.bucket_count,\n278\t            i as usize + 1,\n279\t            \"Bucket count mismatch at iteration {}\",\n280\t            i\n281\t        );\n282\t        let mut outsize = 0;\n283\t        let retrieved =\n284\t            simple_sparsehash::sparse_dict_get(&dict, &key, key.len(), Some(&mut outsize))\n285\t                .expect(\"Expected value\");\n286\t        assert_eq!(outsize, val.len());\n287\t        assert_eq!(retrieved, val.as_bytes());\n288\t    }\n289\t\n290\t    for i in (0..iterations).rev() {\n291\t        let key = format!(\"crazy hash{}\", i);\n292\t        let val = format!(\"value{}\", i);\n293\t        let mut outsize = 0;\n294\t        let retrieved =\n295\t            simple_sparsehash::sparse_dict_get(&dict, &key, key.len(), Some(&mut outsize))\n296\t                .expect(\"Expected value\");\n297\t        assert_eq!(outsize, val.len());\n298\t        assert_eq!(retrieved, val.as_bytes());\n299\t    }\n300\t\n301\t    assert!(simple_sparsehash::sparse_dict_free(dict) != 0);\n302\t}\n303\tfn main(){}\n304\t"}]},"parent_tool_use_id":null,"session_id":"3fbf45ad-89c2-41a2-b6e5-c250756927bf","uuid":"ac86cfee-8ac7-48a5-8916-da36e0ecb0ca","timestamp":"2026-06-03T00:33:33.732Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-ccQGsH/project/src/bin/test.rs","content":"use Simple_Sparsehash::simple_sparsehash;\nuse std::convert::TryInto;\n\n// --- Helper function ---\n/// Converts an i32 into a byte slice.\nfn i32_to_bytes(n: i32) -> [u8; std::mem::size_of::<i32>()] {\n    n.to_ne_bytes()\n}\n\n// --- Tests corresponding to test.c ---\n\n#[test]\nfn test_empty_array_does_not_blow_up() {\n    let arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u64>(), 32)\n        .expect(\"sparse_array_init failed to create an array\");\n    // Expect that getting index 0 returns None.\n    assert!(simple_sparsehash::sparse_array_get(&arr, 0, None).is_none());\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_cannot_set_outside_bounds() {\n    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u64>(), 32)\n        .expect(\"sparse_array_init failed\");\n    let test_num: u64 = 666;\n    let test_bytes = test_num.to_ne_bytes();\n    // Expect failure (0) when setting index 35 (out of bounds).\n    assert_eq!(\n        simple_sparsehash::sparse_array_set(&mut arr, 35, &test_bytes, std::mem::size_of::<u64>()),\n        0,\n        \"Expected setting outside bounds to return 0\"\n    );\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_cannot_get_outside_bounds() {\n    let arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u64>(), 32)\n        .expect(\"sparse_array_init failed\");\n    assert!(\n        simple_sparsehash::sparse_array_get(&arr, 35, None).is_none(),\n        \"Expected getting outside bounds to return None\"\n    );\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_cannot_set_bigger_elements() {\n    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<u8>(), 100)\n        .expect(\"sparse_array_init failed\");\n    let test_num: u64 = 666;\n    let test_bytes = test_num.to_ne_bytes();\n    // Expect failure (0) when the value size is larger than element size.\n    assert_eq!(\n        simple_sparsehash::sparse_array_set(&mut arr, 0, &test_bytes, std::mem::size_of::<u64>()),\n        0,\n        \"Expected setting element with bigger size to return 0\"\n    );\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_array_set_backwards() {\n    let array_size = 120;\n    let mut arr =\n        simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), array_size as u32)\n            .expect(\"sparse_array_init failed\");\n\n    // Set values in reverse order.\n    for i in (0..array_size).rev() {\n        let i_val = i as i32;\n        let bytes = i32_to_bytes(i_val);\n        assert!(\n            simple_sparsehash::sparse_array_set(\n                &mut arr,\n                i as u32,\n                &bytes,\n                std::mem::size_of::<i32>()\n            ) != 0,\n            \"Failed to set index {}\",\n            i\n        );\n        let mut size: usize = 0;\n        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n            .expect(\"Expected value\");\n        assert_eq!(returned.len(), std::mem::size_of::<i32>());\n        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n        assert_eq!(retrieved, i_val);\n        assert_eq!(size, std::mem::size_of::<i32>());\n    }\n\n    // Retrieve values in reverse order.\n    for i in (0..array_size).rev() {\n        let mut size: usize = 0;\n        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n            .expect(\"Expected value\");\n        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n        assert_eq!(retrieved, i as i32);\n        assert_eq!(size, std::mem::size_of::<i32>());\n    }\n\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_array_set() {\n    let array_size = 130;\n    let mut arr =\n        simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), array_size as u32)\n            .expect(\"sparse_array_init failed\");\n\n    for i in 0..array_size {\n        let i_val = i as i32;\n        let bytes = i32_to_bytes(i_val);\n        assert!(\n            simple_sparsehash::sparse_array_set(\n                &mut arr,\n                i as u32,\n                &bytes,\n                std::mem::size_of::<i32>()\n            ) != 0,\n            \"Failed to set index {}\",\n            i\n        );\n        let mut size: usize = 0;\n        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n            .expect(\"Expected value\");\n        assert_eq!(returned.len(), std::mem::size_of::<i32>());\n        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n        assert_eq!(retrieved, i_val);\n        assert_eq!(size, std::mem::size_of::<i32>());\n    }\n\n    for i in 0..array_size {\n        let mut size: usize = 0;\n        let returned = simple_sparsehash::sparse_array_get(&arr, i as u32, Some(&mut size))\n            .expect(\"Expected value\");\n        let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n        assert_eq!(retrieved, i as i32);\n        assert_eq!(size, std::mem::size_of::<i32>());\n    }\n\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_array_set_high_num() {\n    let test_num: i32 = 65_555_555;\n    let index = simple_sparsehash::GROUP_SIZE - 1;\n    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), 140)\n        .expect(\"sparse_array_init failed\");\n\n    let bytes = i32_to_bytes(test_num);\n    assert!(\n        simple_sparsehash::sparse_array_set(\n            &mut arr,\n            index as u32,\n            &bytes,\n            std::mem::size_of::<i32>()\n        ) != 0,\n        \"Failed to set at high index\"\n    );\n    let mut size: usize = 0;\n    let returned = simple_sparsehash::sparse_array_get(&arr, index as u32, Some(&mut size))\n        .expect(\"Expected value\");\n    let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n    assert_eq!(retrieved, test_num);\n    assert_eq!(size, std::mem::size_of::<i32>());\n\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_array_set_overwrites_old_values() {\n    let test_num: i32 = 666;\n    let test_num2: i32 = 1024;\n    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), 150)\n        .expect(\"sparse_array_init failed\");\n\n    let bytes1 = i32_to_bytes(test_num);\n    let bytes2 = i32_to_bytes(test_num2);\n    assert!(\n        simple_sparsehash::sparse_array_set(&mut arr, 0, &bytes1, std::mem::size_of::<i32>()) != 0,\n        \"Failed to set first value\"\n    );\n    assert!(\n        simple_sparsehash::sparse_array_set(&mut arr, 0, &bytes2, std::mem::size_of::<i32>()) != 0,\n        \"Failed to overwrite value\"\n    );\n\n    let returned = simple_sparsehash::sparse_array_get(&arr, 0, None).expect(\"Expected value\");\n    let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n    assert_eq!(retrieved, test_num2);\n\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_array_get() {\n    let test_num: i32 = 666;\n    let mut arr = simple_sparsehash::sparse_array_init(std::mem::size_of::<i32>(), 200)\n        .expect(\"sparse_array_init failed\");\n    let bytes = i32_to_bytes(test_num);\n    assert!(\n        simple_sparsehash::sparse_array_set(&mut arr, 0, &bytes, std::mem::size_of::<i32>()) != 0,\n        \"Failed to set value\"\n    );\n\n    let mut size: usize = 0;\n    let returned =\n        simple_sparsehash::sparse_array_get(&arr, 0, Some(&mut size)).expect(\"Expected value\");\n    let retrieved = i32::from_ne_bytes(returned.try_into().unwrap());\n    assert_eq!(retrieved, test_num);\n    assert_eq!(size, std::mem::size_of::<i32>());\n\n    assert!(simple_sparsehash::sparse_array_free(arr) != 0);\n}\n\n#[test]\nfn test_dict_set() {\n    let mut dict = simple_sparsehash::sparse_dict_init().expect(\"sparse_dict_init failed\");\n    assert!(\n        simple_sparsehash::sparse_dict_set(\n            &mut dict,\n            \"key\",\n            \"key\".len(),\n            \"value\".as_bytes(),\n            \"value\".len()\n        ) != 0,\n        \"Failed to set dictionary entry\"\n    );\n    assert!(simple_sparsehash::sparse_dict_free(dict) != 0);\n}\n\n#[test]\nfn test_dict_get() {\n    let mut dict = simple_sparsehash::sparse_dict_init().expect(\"sparse_dict_init failed\");\n    assert!(\n        simple_sparsehash::sparse_dict_set(\n            &mut dict,\n            \"key\",\n            \"key\".len(),\n            \"value\".as_bytes(),\n            \"value\".len()\n        ) != 0,\n        \"Failed to set dictionary entry\"\n    );\n\n    let mut outsize: usize = 0;\n    let value = simple_sparsehash::sparse_dict_get(&dict, \"key\", \"key\".len(), Some(&mut outsize))\n        .expect(\"Expected value\");\n    assert_eq!(outsize, \"value\".len());\n    assert_eq!(value, \"value\".as_bytes());\n    assert!(simple_sparsehash::sparse_dict_free(dict) != 0);\n}\n\n#[test]\nfn test_dict_lots_of_set() {\n    let mut dict = simple_sparsehash::sparse_dict_init().expect(\"sparse_dict_init failed\");\n    let iterations = 1_000_000;\n    for i in 0..iterations {\n        let key = format!(\"crazy hash{}\", i);\n        let val = format!(\"value{}\", i);\n        assert!(\n            simple_sparsehash::sparse_dict_set(\n                &mut dict,\n                &key,\n                key.len(),\n                val.as_bytes(),\n                val.len()\n            ) != 0,\n            \"Failed to set dict entry at iteration {}\",\n            i\n        );\n        // Check that the bucket count matches the expected number.\n        assert_eq!(\n            dict.bucket_count,\n            i as usize + 1,\n            \"Bucket count mismatch at iteration {}\",\n            i\n        );\n        let mut outsize = 0;\n        let retrieved =\n            simple_sparsehash::sparse_dict_get(&dict, &key, key.len(), Some(&mut outsize))\n                .expect(\"Expected value\");\n        assert_eq!(outsize, val.len());\n        assert_eq!(retrieved, val.as_bytes());\n    }\n\n    for i in (0..iterations).rev() {\n        let key = format!(\"crazy hash{}\", i);\n        let val = format!(\"value{}\", i);\n        let mut outsize = 0;\n        let retrieved =\n            simple_sparsehash::sparse_dict_get(&dict, &key, key.len(), Some(&mut outsize))\n                .expect(\"Expected value\");\n        assert_eq!(outsize, val.len());\n        assert_eq!(retrieved, val.as_bytes());\n    }\n\n    assert!(simple_sparsehash::sparse_dict_free(dict) != 0);\n}\nfn main(){}\n","numLines":304,"startLine":1,"totalLines":304}}}
