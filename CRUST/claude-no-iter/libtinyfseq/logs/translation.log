`&mut &[u8]`\n        // whose inner lifetime is unrelated to `bd` in the function signature.\n        // The caller is responsible for not using the resulting slice past\n        // `bd`'s lifetime.\n        *ep = unsafe { std::slice::from_raw_parts(rest.as_ptr(), rest.len()) };\n    }\n\n    TFError::TF_OK\n}\npub fn tf_header_read(\n    bd: &[u8],\n    header: &mut TFHeader,\n    ep: Option<&mut &[u8]>,\n) -> TFError {\n    // header structure is a fixed 32 byte size according to schema\n    // https://github.com/Cryptkeeper/fseq-file-format#header\n    const HEADER_SIZE: usize = 32;\n\n    if bd.len() < HEADER_SIZE {\n        return TFError::TF_EINVALID_BUFFER_SIZE;\n    }\n\n    if bd[0] != b'P' || bd[1] != b'S' || bd[2] != b'E' || bd[3] != b'Q' {\n        return TFError::TF_EINVALID_MAGIC;\n    }\n\n    header.channel_data_offset = u16::from_le_bytes([bd[4], bd[5]]);\n    header.minor_version = bd[6];\n    header.major_version = bd[7];\n    header.variable_data_offset = u16::from_le_bytes([bd[8], bd[9]]);\n    header.channel_count = u32::from_le_bytes([bd[10], bd[11], bd[12], bd[13]]);\n    header.frame_count = u32::from_le_bytes([bd[14], bd[15], bd[16], bd[17]]);\n    header.frame_step_time_millis = bd[18];\n\n    // upper 4 bits contain additional compression block count data that is ignored by tinyfseq\n    // mask to lower 4 bits to filter only the compression type field\n    let compression_type = bd[20] & 0xF;\n\n    header.compression_type = match compression_type {\n        0 => TFCompressionType::TF_COMPRESSION_NONE,\n        1 => TFCompressionType::TF_COMPRESSION_ZSTD,\n        2 => TFCompressionType::TF_COMPRESSION_ZLIB,\n        _ => return TFError::TF_EINVALID_COMPRESSION_TYPE,\n    };\n\n    header.compression_block_count = bd[21];\n    header.channel_range_count = bd[22];\n\n    header.sequence_uid = u64::from_le_bytes([\n        bd[24], bd[25], bd[26], bd[27], bd[28], bd[29], bd[30], bd[31],\n    ]);\n\n    if let Some(ep) = ep {\n        let rest = &bd[HEADER_SIZE..];\n        // SAFETY: see note in tf_var_header_read above.\n        *ep = unsafe { std::slice::from_raw_parts(rest.as_ptr(), rest.len()) };\n    }\n\n    TFError::TF_OK\n}\npub fn tf_compression_block_read(\n    bd: &[u8],\n    block: &mut TFCompressionBlock,\n    ep: Option<&mut &[u8]>,\n) -> TFError {\n    const COMPRESSION_BLOCK_SIZE: usize = 8;\n\n    if bd.len() < COMPRESSION_BLOCK_SIZE {\n        return TFError::TF_EINVALID_BUFFER_SIZE;\n    }\n\n    block.first_frame_id = u32::from_le_bytes([bd[0], bd[1], bd[2], bd[3]]);\n    block.size = u32::from_le_bytes([bd[4], bd[5], bd[6], bd[7]]);\n\n    if let Some(ep) = ep {\n        let rest = &bd[COMPRESSION_BLOCK_SIZE..];\n        // SAFETY: see note in tf_var_header_read above.\n        *ep = unsafe { std::slice::from_raw_parts(rest.as_ptr(), rest.len()) };\n    }\n\n    TFError::TF_OK\n}\npub fn tf_channel_range_read(\n    bd: &[u8],\n    channel_range: &mut TFChannelRange,\n    ep: Option<&mut &[u8]>,\n) -> TFError {\n    const CHANNEL_RANGE_SIZE: usize = 6;\n\n    if bd.len() < CHANNEL_RANGE_SIZE {\n        return TFError::TF_EINVALID_BUFFER_SIZE;\n    }\n\n    channel_range.first_channel_number =\n        (bd[0] as u32) | ((bd[1] as u32) << 8) | ((bd[2] as u32) << 16);\n    channel_range.channel_count =\n        (bd[3] as u32) | ((bd[4] as u32) << 8) | ((bd[5] as u32) << 16);\n\n    if let Some(ep) = ep {\n        *ep = &bd[CHANNEL_RANGE_SIZE..];\n    }\n\n    TFError::TF_OK\n}\n","structuredPatch":[{"oldStart":194,"oldLines":7,"newStart":194,"newLines":9,"lines":["         (bd[3] as u32) | ((bd[4] as u32) << 8) | ((bd[5] as u32) << 16);"," ","     if let Some(ep) = ep {","-        *ep = &bd[CHANNEL_RANGE_SIZE..];","+        let rest = &bd[CHANNEL_RANGE_SIZE..];","+        // SAFETY: see note in tf_var_header_read above.","+        *ep = unsafe { std::slice::from_raw_parts(rest.as_ptr(), rest.len()) };","     }"," ","     TFError::TF_OK"]}],"userModified":false,"replaceAll":false}}
