{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01KaszDoRFS51bPPLvK4VsQ3","type":"tool_result","content":"1\tuse csyncmers::closed_syncmers::{compute_closed_syncmers, MinimizerResult};\n2\tuse csyncmers::closed_syncmers_naive::compute_closed_syncmers_naive;\n3\tuse rand::Rng;\n4\t\n5\tfn generate_sequence(len: usize) -> String {\n6\t    let bases = ['A', 'C', 'G', 'T'];\n7\t    let mut rng = rand::thread_rng();\n8\t    (0..len).map(|_| bases[rng.gen_range(0..4)]).collect()\n9\t}\n10\t\n11\t#[test]\n12\tfn test() {\n13\t    let num_tests = 10;\n14\t    let sequence_length = 1050;\n15\t\n16\t    for test in 1..=num_tests {\n17\t        let sequence = generate_sequence(sequence_length);\n18\t        let a = rand::thread_rng().gen_range(11..=999);\n19\t        let b_min = 7;\n20\t        let b_max = if a - 1 < 63 { a - 1 } else { 63 };\n21\t        let b = if b_max < b_min { b_min } else { rand::thread_rng().gen_range(b_min..=b_max) };\n22\t\n23\t        println!(\"Test {}: Sequence Length={}, K={}, S={}\", test, sequence_length, a, b);\n24\t\n25\t        let mut results = Vec::new();\n26\t        let mut num_results = 0;\n27\t        compute_closed_syncmers(&sequence, sequence.len() as i32, a, b, &mut results, &mut num_results);\n28\t\n29\t        println!(\"Closed Syncmers:\");\n30\t        println!(\"{:<20} {:<20}\", \"Position\", \"Minimizer Hash\");\n31\t        for result in &results {\n32\t            println!(\"{:<20} {:<20}\", result.kmer_position, result.minimizer_hash);\n33\t        }\n34\t\n35\t        let mut naive_results = Vec::new();\n36\t        let mut num_naive_results = 0;\n37\t        compute_closed_syncmers_naive(&sequence, sequence.len(), a, b, &mut naive_results, &mut num_naive_results);\n38\t\n39\t        println!(\"\\nClosed Syncmers (Naive):\");\n40\t        println!(\"{:<20} {:<20}\", \"Position\", \"Minimizer Hash\");\n41\t        for result in &naive_results {\n42\t            println!(\"{:<20} {:<20}\", result.kmer_position, result.minimizer_hash);\n43\t        }\n44\t\n45\t        assert_eq!(num_results, num_naive_results, \"Mismatch in number of closed syncmers: {} (original) vs {} (naive)\", num_results, num_naive_results);\n46\t\n47\t        for (i, (result, naive_result)) in results.iter().zip(naive_results.iter()).enumerate() {\n48\t            assert_eq!(result.kmer_position, naive_result.kmer_position, \"Mismatch at index {}: Position\", i);\n49\t            assert_eq!(result.minimizer_hash, naive_result.minimizer_hash, \"Mismatch at index {}: Hash\", i);\n50\t        }\n51\t\n52\t        println!(\"Test {} passed. All closed syncmers match between original and naive method.\\n\", test);\n53\t    }\n54\t\n55\t    println!(\"All tests passed.\");\n56\t}\n57\t\n58\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"7b303b65-24e4-4195-ac18-8ae7f519fd4b","uuid":"96c8596f-e4d8-4c74-95be-0f71bcebd2aa","timestamp":"2026-06-03T02:01:54.269Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-xvHTi3/project/src/bin/test.rs","content":"use csyncmers::closed_syncmers::{compute_closed_syncmers, MinimizerResult};\nuse csyncmers::closed_syncmers_naive::compute_closed_syncmers_naive;\nuse rand::Rng;\n\nfn generate_sequence(len: usize) -> String {\n    let bases = ['A', 'C', 'G', 'T'];\n    let mut rng = rand::thread_rng();\n    (0..len).map(|_| bases[rng.gen_range(0..4)]).collect()\n}\n\n#[test]\nfn test() {\n    let num_tests = 10;\n    let sequence_length = 1050;\n\n    for test in 1..=num_tests {\n        let sequence = generate_sequence(sequence_length);\n        let a = rand::thread_rng().gen_range(11..=999);\n        let b_min = 7;\n        let b_max = if a - 1 < 63 { a - 1 } else { 63 };\n        let b = if b_max < b_min { b_min } else { rand::thread_rng().gen_range(b_min..=b_max) };\n\n        println!(\"Test {}: Sequence Length={}, K={}, S={}\", test, sequence_length, a, b);\n\n        let mut results = Vec::new();\n        let mut num_results = 0;\n        compute_closed_syncmers(&sequence, sequence.len() as i32, a, b, &mut results, &mut num_results);\n\n        println!(\"Closed Syncmers:\");\n        println!(\"{:<20} {:<20}\", \"Position\", \"Minimizer Hash\");\n        for result in &results {\n            println!(\"{:<20} {:<20}\", result.kmer_position, result.minimizer_hash);\n        }\n\n        let mut naive_results = Vec::new();\n        let mut num_naive_results = 0;\n        compute_closed_syncmers_naive(&sequence, sequence.len(), a, b, &mut naive_results, &mut num_naive_results);\n\n        println!(\"\\nClosed Syncmers (Naive):\");\n        println!(\"{:<20} {:<20}\", \"Position\", \"Minimizer Hash\");\n        for result in &naive_results {\n            println!(\"{:<20} {:<20}\", result.kmer_position, result.minimizer_hash);\n        }\n\n        assert_eq!(num_results, num_naive_results, \"Mismatch in number of closed syncmers: {} (original) vs {} (naive)\", num_results, num_naive_results);\n\n        for (i, (result, naive_result)) in results.iter().zip(naive_results.iter()).enumerate() {\n            assert_eq!(result.kmer_position, naive_result.kmer_position, \"Mismatch at index {}: Position\", i);\n            assert_eq!(result.minimizer_hash, naive_result.minimizer_hash, \"Mismatch at index {}: Hash\", i);\n        }\n\n        println!(\"Test {} passed. All closed syncmers match between original and naive method.\\n\", test);\n    }\n\n    println!(\"All tests passed.\");\n}\n\nfn main(){}","numLines":58,"startLine":1,"totalLines":58}}}
