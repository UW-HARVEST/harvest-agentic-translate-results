v_length - 2,678);\n66\t    assert_eq!(v[999], 678);\n67\t    assert_eq!(vec::vec_insert(&mut v, 10,123), 0);\n68\t    v_length = v.len();\n69\t    vec::vec_insert(&mut v, v_length, 789);\n70\t    assert_eq!(v[v.len() - 1], 789);\n71\t}\n72\t\n73\t#[test]\n74\tfn test_vec_sort() {\n75\t    let mut v = vec![3, -1, 0];\n76\t    v.sort();\n77\t    assert_eq!(v[0], -1);\n78\t    assert_eq!(v[1], 0);\n79\t    assert_eq!(v[2], 3);\n80\t}\n81\t\n82\t#[test]\n83\tfn test_vec_swap() {\n84\t    let mut v = vec!['a', 'b', 'c'];\n85\t    vec::vec_swap(&mut v, 0, 2);\n86\t    assert_eq!(v[0], 'c');\n87\t    assert_eq!(v[2], 'a');\n88\t    vec::vec_swap(&mut v, 0, 1);\n89\t    assert_eq!(v[0], 'b');\n90\t    assert_eq!(v[1], 'c');\n91\t    vec::vec_swap(&mut v, 1, 2);\n92\t    assert_eq!(v[1], 'a');\n93\t    assert_eq!(v[2], 'c');\n94\t    vec::vec_swap(&mut v, 1, 1);\n95\t    assert_eq!(v[1], 'a');\n96\t}\n97\t\n98\t#[test]\n99\tfn test_vec_truncate() {\n100\t    let mut v = vec![0; 1000];\n101\t    v.truncate(10000);\n102\t    assert_eq!(v.len(), 1000);\n103\t    v.truncate(900);\n104\t    assert_eq!(v.len(), 900);\n105\t}\n106\t\n107\t#[test]\n108\tfn test_vec_clear() {\n109\t    let mut v = vec![1, 2];\n110\t    v.clear();\n111\t    assert_eq!(v.len(), 0);\n112\t}\n113\t\n114\t#[test]\n115\tfn test_vec_first() {\n116\t    let mut v = vec![0xf00d, 0];\n117\t    assert_eq!(v.first(), Some(&0xf00d));\n118\t}\n119\t\n120\t#[test]\n121\tfn test_vec_last() {\n122\t    let mut v = vec![0, 0xf00d];\n123\t    assert_eq!(v.last(), Some(&0xf00d));\n124\t}\n125\t\n126\t#[test]\n127\tfn test_vec_reserve() {\n128\t    let mut v: Vec<i32> = Vec::with_capacity(100);\n129\t    assert_eq!(v.capacity(), 100);\n130\t    v.reserve(50);\n131\t    assert_eq!(v.capacity(), 100);\n132\t    let mut v: Vec<i32> = Vec::with_capacity(100);\n133\t    v.push(123);\n134\t    v.push(456);\n135\t    vec::vec_reserve(&mut v, 200);\n136\t    assert_eq!(v.capacity(), 200);\n137\t    assert_eq!(vec::vec_reserve(&