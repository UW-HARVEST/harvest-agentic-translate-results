t\n207\t#[test]\n208\tfn test_vec_foreach() {\n209\t    let v = vec![19, 31, 47];\n210\t    let mut count = 0;\n211\t    let mut acc = 1;\n212\t    for (i, &x) in v.iter().enumerate() {\n213\t        acc *= x + count;\n214\t        count += 1;\n215\t    }\n216\t    assert_eq!(acc, (19 + 0) * (31 + 1) * (47 + 2));\n217\t}\n218\t\n219\t#[test]\n220\tfn test_vec_foreach_rev() {\n221\t    let v = vec![19, 31, 47];\n222\t    let mut count = 0;\n223\t    let mut acc = 1;\n224\t    for (i, &x) in v.iter().rev().enumerate() {\n225\t        acc *= x + count;\n226\t        count += 1;\n227\t    }\n228\t    assert_eq!(acc, (19 + 2) * (31 + 1) * (47 + 0));\n229\t}\n230\t\n231\t#[test]\n232\tfn test_vec_foreach_ptr() {\n233\t    let v = vec![19, 31, 47];\n234\t    let mut count = 0;\n235\t    let mut acc = 1;\n236\t    for (i, x) in v.iter().enumerate() {\n237\t        acc *= x + count;\n238\t        count += 1;\n239\t    }\n240\t    assert_eq!(acc, (19 + 0) * (31 + 1) * (47 + 2));\n241\t}\n242\t\n243\t#[test]\n244\tfn test_vec_foreach_ptr_rev() {\n245\t    let v = vec![19, 31, 47];\n246\t    let mut count = 0;\n247\t    let mut acc = 1;\n248\t    for (i, x) in v.iter().rev().enumerate() {\n249\t        acc *= x + count;\n250\t        count += 1;\n251\t    }\n252\t    assert_eq!(acc, (19 + 2) * (31 + 1) * (47 + 0));\n253\t}\n254\t\n255\tfn main() {}"}]},"parent_tool_use_id":null,"session_id":"9f6fe1cd-8e6e-432b-b8eb-5066cdc15cac","uuid":"3ce4a945-3ccb-4185-a0b6-267fc987a938","timestamp":"2026-06-03T06:59:07.353Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-HVmTxz/project/src/bin/test_vec.rs","content":"use vec::vec;\n\n#[test]\nfn test_vec_push() {\n    let mut v = Vec::new();\n    for i in 0..1000 {\n        v.push(i * 2);\n    }\n    assert_eq!(v[1], 2);\n    assert_eq!(v[999], 999 * 2);\n    assert_eq!(v.push(10), ());\n}\n\n#[test]\nfn test_vec_pop() {\n    let mut v = Vec::new();\n    v.push(123);\n    v.push(456);\n    v.push(789);\n    assert_eq!(v.pop(), Some(789));\n    assert_eq!(v.pop(), Some(456));\n    assert_eq!(v.pop(), Some(123));\n}\n\n#[test]\nfn test_vec_splice() {\n    let mut v: Vec<i32> = (0..1000).collect();\n    vec::vec_splice(&mut v, 0, 10);\n    assert_eq!(v[0], 10);\n    vec::vec_splice(&mut v, 10, 10);\n    assert_eq!(v[10], 30);\n    let v_length = v.len();\n    vec::vec_splice(&mut v, v_length - 50, 50);\n    let v_length = v.len();\n    assert_eq!(v[v_length - 1], 949);\n}\n\n#[test]\nfn test_vec_swapsplice() {\n    let mut v: Vec<i32> = (0..10).collect();\n    vec::vec_swapsplice(&mut v, 0, 3);\n    assert_eq!(v[0], 7);\n    assert_eq!(v[1], 8);\n    assert_eq!(v[2], 9);\n    let v_length = v.len();\n    vec::vec_swapsplice(&mut v, v_length - 1, 1);\n    let v_length = v.len();\n    assert_eq!(v[v_length - 1], 5);\n}\n\n#[test]\nfn test_vec_insert() {\n    let mut v: Vec<i32> = Vec::new();\n    for i in 0..1000 {\n        vec::vec_insert(&mut v, 0,i);\n    }\n    let mut v_length = v.len();\n    // print first 5 elements of the vector v\n    assert_eq!(v[0], 999);\n    assert_eq!(v[v_length - 1], 0);\n    vec::vec_insert(&mut v, 10, 123);\n    assert_eq!(v[10], 123);\n    assert_eq!(v.len(), 1001);\n    v_length = v.len();\n    vec::vec_insert(&mut v, v_length - 2,678);\n    assert_eq!(v[999], 678);\n    assert_eq!(vec::vec_insert(&mut v, 10,123), 0);\n    v_length = v.len();\n    vec::vec_insert(&mut v, v_length, 789);\n    assert_eq!(v[v.len() - 1], 789);\n}\n\n#[test]\nfn test_vec_sort() {\n    let mut v = vec![3, -1, 0];\n    v.sort();\n    assert_eq!(v[0], -1);\n    assert_eq!(v[1], 0);\n    assert_eq!(v[2], 3);\n}\n\n#[test]\nfn test_vec_swap() {\n    let mut v = vec!['a', 'b', 'c'];\n    vec::vec_swap(&mut v, 0, 2);\n    assert_eq!(v[0], 'c');\n    assert_eq!(v[2], 'a');\n    vec::vec_swap(&mut v, 0, 1);\n    assert_eq!(v[0], 'b');\n    assert_eq!(v[1], 'c');\n    vec::vec_swap(&mut v, 1, 2);\n    assert_eq!(v[1], 'a');\n    assert_eq!(v[2], 'c');\n    vec::vec_swap(&mut v, 1, 1);\n    assert_eq!(v[1], 'a');\n}\n\n#[test]\nfn test_vec_truncate() {\n    let mut v = vec![0; 1000];\n    v.truncate(10000);\n    assert_eq!(v.len(), 1000);\n    v.truncate(900);\n    assert_eq!(v.len(), 900);\n}\n\n#[test]\nfn test_vec_clear() {\n    let mut v = vec![1, 2];\n    v.clear();\n    assert_eq!(v.len(), 0);\n}\n\n#[test]\nfn test_vec_first() {\n    let mut v = vec![0xf00d, 0];\n    assert_eq!(v.first(), Some(&0xf00d));\n}\n\n#[test]\nfn test_vec_last() {\n    let mut v = vec![0, 0xf00d];\n    assert_eq!(v.last(), Some(&0xf00d));\n}\n\n#[test]\nfn test_vec_reserve() {\n    let mut v: Vec<i32> = Vec::with_capacity(100);\n    assert_eq!(v.capacity(), 100);\n    v.reserve(50);\n    assert_eq!(v.capacity(), 100);\n    let mut v: Vec<i32> = Vec::with_capacity(100);\n    v.push(123);\n    v.push(456);\n    vec::vec_reserve(&mut v, 200);\n    assert_eq!(v.capacity(), 200);\n    assert_eq!(vec::vec_reserve(&mut v, 300), 0);\n}\n\n#[test]\nfn test_vec_compact() {\n    let mut v = vec![0; 1000];\n    v.truncate(3);\n    vec::vec_compact(&mut v);\n    assert_eq!(v.len(), v.capacity());\n    assert_eq!(vec::vec_compact(&mut v), 0);\n}\n\n#[test]\nfn test_vec_pusharr() {\n    let a = [5, 6, 7, 8, 9];\n    let mut v = vec![1, 2];\n    v.extend_from_slice(&a);\n    assert_eq!(v[0], 1);\n    assert_eq!(v[2], 5);\n    assert_eq!(v[6], 9);\n    let mut v = Vec::new();\n    v.extend_from_slice(&a);\n    assert_eq!(v[0], 5);\n}\n\n#[test]\nfn test_vec_extend() {\n    let mut v = vec![12, 34];\n    let v2 = vec![56, 78];\n    v.extend(v2);\n    assert_eq!(v[0], 12);\n    assert_eq!(v[1], 34);\n    assert_eq!(v[2], 56);\n    assert_eq!(v[3], 78);\n    assert_eq!(v.len(), 4);\n}\n\n#[test]\nfn test_vec_find() {\n    let v: Vec<char> = ('a'..='z').collect();\n    assert_eq!(v.iter().position(|&x| x == 'a'), Some(0));\n    assert_eq!(v.iter().position(|&x| x == 'z'), Some(25));\n    assert_eq!(v.iter().position(|&x| x == 'd'), Some(3));\n    assert_eq!(v.iter().position(|&x| x == '_'), None);\n}\n\n#[test]\nfn test_vec_remove() {\n    let mut v: Vec<char> = ('a'..='z').collect();\n    v.retain(|&x| x != '_');\n    assert_eq!(v.len(), 26);\n    v.retain(|&x| x != 'c');\n    assert_eq!(v[0], 'a');\n    assert_eq!(v[1], 'b');\n    assert_eq!(v[2], 'd');\n    assert_eq!(v[3], 'e');\n    assert_eq!(v.len(), 25);\n}\n\n#[test]\nfn test_vec_reverse() {\n    let mut v = vec!['a', 'b', 'c', 'd'];\n    v.reverse();\n    assert_eq!(v.len(), 4);\n    assert_eq!(v[0], 'd');\n    assert_eq!(v[1], 'c');\n    assert_eq!(v[2], 'b');\n    assert_eq!(v[3], 'a');\n}\n\n#[test]\nfn test_vec_foreach() {\n    let v = vec![19, 31, 47];\n    let mut count = 0;\n    let mut acc = 1;\n    for (i, &x) in v.iter().enumerate() {\n        acc *= x + count;\n        count += 1;\n    }\n    assert_eq!(acc, (19 + 0) * (31 + 1) * (47 + 2));\n}\n\n#[test]\nfn test_vec_foreach_rev() {\n    let v = vec![19, 31, 47];\n    let mut count = 0;\n    let mut acc = 1;\n    for (i, &x) in v.iter().rev().enumerate() {\n        acc *= x + count;\n        count += 1;\n    }\n    assert_eq!(acc, (19 + 2) * (31 + 1) * (47 + 0));\n}\n\n#[test]\nfn test_vec_foreach_ptr() {\n    let v = vec![19, 31, 47];\n    let mut count = 0;\n    let mut acc = 1;\n    for (i, x) in v.iter().enumerate() {\n        acc *= x + count;\n        count += 1;\n    }\n    assert_eq!(acc, (19 + 0) * (31 + 1) * (47 + 2));\n}\n\n#[test]\nfn test_vec_foreach_ptr_rev() {\n    let v = vec![19, 31, 47];\n    let mut count = 0;\n    let mut acc = 1;\n    for (i, x) in v.iter().rev().enumerate() {\n        acc *= x + count;\n        count += 1;\n    }\n    assert_eq!(acc, (19 + 2) * (31 + 1) * (47 + 0));\n}\n\nfn main() {}","numLines":255,"startLine":1,"totalLines":255}}}
