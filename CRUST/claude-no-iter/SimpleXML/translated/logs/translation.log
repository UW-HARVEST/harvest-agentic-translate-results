52\t    assert_eq!(*v.get_element_at(2).unwrap(), &a);\n53\t    assert_eq!(*v.get_element_at(3).unwrap(), &a);\n54\t    assert_eq!(*v.get_element_at(4).unwrap(), &b);\n55\t\n56\t    // Test re-allocate\n57\t    for _ in 0..100 {\n58\t        v.push_back(&a);\n59\t    }\n60\t    assert_eq!(v.size(), 105);\n61\t    assert_eq!(*v.get_element_at(0).unwrap(), &c);\n62\t    assert_eq!(*v.get_element_at(1).unwrap(), &b);\n63\t    assert_eq!(*v.get_element_at(2).unwrap(), &a);\n64\t    assert_eq!(*v.get_element_at(3).unwrap(), &a);\n65\t    assert_eq!(*v.get_element_at(4).unwrap(), &b);\n66\t    for i in 5..105 {\n67\t        assert_eq!(*v.get_element_at(i).unwrap(), &a);\n68\t    }\n69\t\n70\t    // Test top\n71\t    assert_eq!(*v.top_back().unwrap(), &a);\n72\t    assert_eq!(*v.top_front().unwrap(), &c);\n73\t    assert_eq!(v.size(), 105);\n74\t\n75\t    println!(\"PASSED Test vector1\");\n76\t}\n77\t\n78\tconst SIZE: usize = 100000;\n79\t#[test]\n80\tfn test_vector2() {\n81\t    let mut v = Vector::new(8);\n82\t    \n83\t    // Initialize elements\n84\t    for i in 0..SIZE {\n85\t        let tag_name = format!(\"tag {}\", i);\n86\t        let value = format!(\"value {}\", i);\n87\t        let element = XMLElement::new(tag_name, value);\n88\t        v.push_back(element);\n89\t    }\n90\t\n91\t    // Assert elements\n92\t    for i in 0..v.size() {\n93\t        let expected_tag = format!(\"tag {}\", i);\n94\t        let expected_value = format!(\"value {}\", i);\n95\t        \n96\t        let element = v.get_element_at(i);\n97\t        let element_ref = element.unwrap();\n98\t\n99\t        assert_eq!(element_ref.tag_name, expected_tag);\n100\t        assert_eq!(element_ref.value, expected_value);\n101\t    }\n102\t\n103\t    println!(\"PASSED Test vector2\");\n104\t}\n105\t#[test]\n106\tfn test_xml() {\n107\t    let s = r#\"<programmer>\n108\t    <name>Kien Nguyen Trung</name>\n109\t    <languages>\n110\t    <language>C</language>\n111\t    <language>C++</language>\n112\t    <language>Python</language>\n113\t    <language>Ruby</language>\n114\t    <language>Objective C</language>\n115\t    <language>Java</language>\n116\t    <language>Javascript</language>\n117\t    <language>Lua</language>\n118\t    <language>C#</language>\n119\t    <language>PHP</language>\n120\t    </languages>\n121\t    </programmer>\"#;\n122\t\n123\t    let elem = parse_xml_from_text(s).unwrap();\n124\t    let elem_ref = elem;\n125\t    \n126\t    assert_eq!(elem_ref.tag_name, \"programmer\");\n127\t    assert_eq!(elem_ref.children.size, 2);\n128\t\n129\t    let child1 = elem_ref.children.get_element_at(0).unwrap();\n130\t    assert_eq!(child1.tag_name, \"name\");\n131\t    assert_eq!(child1.children.size, 0);\n132\t    assert_eq!(child1.value, \"Kien Nguyen Trung\");\n133\t\n134\t    let child2 = elem_ref.children.get_element_at(1).unwrap();\n135\t    assert_eq!(child2.tag_name, \"languages\");\n136\t    assert_eq!(child2.children.size, 10);\n137\t    \n138\t    let list_languages = [\n139\t        \"C\", \"C++\", \"Python\", \"Ruby\", \"Objective C\", \n140\t        \"Java\", \"Javascript\", \"Lua\", \"C#\", \"PHP\"\n141\t    ];\n142\t\n143\t    for i in 0..10 {\n144\t        let child = child2.children.get_element_at(i).unwrap();\n145\t        assert_eq!(child.value, list_languages[i]);\n146\t        assert_eq!(child.tag_name, \"language\");\n147\t    }\n148\t\n149\t    println!(\"PASSED Test parser xml\");\n150\t}\n151\t\n152\t\n153\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"11bf19c0-947f-4b85-8b60-0801dd60bd0b","uuid":"fe571c54-bf8c-42a5-9749-903bc3b2d1e9","timestamp":"2026-06-03T00:30:09.197Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-YDdNSj/project/src/bin/tests.rs","content":"\nuse std::rc::Rc;\nuse std::cell::RefCell;\n\n\nuse SimpleXML::simple_vector::Vector;\nuse SimpleXML::simple_xml::{XMLElement, parse_xml_from_text};\n#[test]\nfn test_vector() {\n    let a = 10;\n    let b = 20;\n    let c = 30;\n\n    // Test allocate\n    let mut v: Vector<&i32> = Vector::new(8);\n    assert_eq!(v.size(), 0, \"create size FAILED\");\n    assert!(v.data.capacity() >= 8, \"create capacity FAILED\");\n\n    // Test push back\n    v.push_back(&a);\n    v.push_back(&b);\n    assert_eq!(v.size(), 2, \"insert element FAILED\");\n    assert_eq!(*v.get_element_at(0).unwrap(), &a, \"insert element FAILED\");\n    assert_eq!(*v.get_element_at(1).unwrap(), &b, \"insert element FAILED\");\n\n    // Test push front\n    v.push_front(&a);\n    v.push_front(&b);\n    v.push_front(&c);\n    assert_eq!(v.size(), 5);\n    assert_eq!(*v.get_element_at(0).unwrap(), &c);\n    assert_eq!(*v.get_element_at(1).unwrap(), &b);\n    assert_eq!(*v.get_element_at(2).unwrap(), &a);\n    assert_eq!(*v.get_element_at(3).unwrap(), &a);\n    assert_eq!(*v.get_element_at(4).unwrap(), &b);\n\n    // Test insert\n    v.insert_at_index(&c, 2);\n    assert_eq!(v.size(), 6);\n    assert_eq!(*v.get_element_at(0).unwrap(), &c);\n    assert_eq!(*v.get_element_at(1).unwrap(), &b);\n    assert_eq!(*v.get_element_at(2).unwrap(), &c);\n    assert_eq!(*v.get_element_at(3).unwrap(), &a);\n    assert_eq!(*v.get_element_at(4).unwrap(), &a);\n    assert_eq!(*v.get_element_at(5).unwrap(), &b);\n\n    // Test remove\n    v.remove_at_index(2);\n    assert_eq!(v.size(), 5);\n    assert_eq!(*v.get_element_at(0).unwrap(), &c);\n    assert_eq!(*v.get_element_at(1).unwrap(), &b);\n    assert_eq!(*v.get_element_at(2).unwrap(), &a);\n    assert_eq!(*v.get_element_at(3).unwrap(), &a);\n    assert_eq!(*v.get_element_at(4).unwrap(), &b);\n\n    // Test re-allocate\n    for _ in 0..100 {\n        v.push_back(&a);\n    }\n    assert_eq!(v.size(), 105);\n    assert_eq!(*v.get_element_at(0).unwrap(), &c);\n    assert_eq!(*v.get_element_at(1).unwrap(), &b);\n    assert_eq!(*v.get_element_at(2).unwrap(), &a);\n    assert_eq!(*v.get_element_at(3).unwrap(), &a);\n    assert_eq!(*v.get_element_at(4).unwrap(), &b);\n    for i in 5..105 {\n        assert_eq!(*v.get_element_at(i).unwrap(), &a);\n    }\n\n    // Test top\n    assert_eq!(*v.top_back().unwrap(), &a);\n    assert_eq!(*v.top_front().unwrap(), &c);\n    assert_eq!(v.size(), 105);\n\n    println!(\"PASSED Test vector1\");\n}\n\nconst SIZE: usize = 100000;\n#[test]\nfn test_vector2() {\n    let mut v = Vector::new(8);\n    \n    // Initialize elements\n    for i in 0..SIZE {\n        let tag_name = format!(\"tag {}\", i);\n        let value = format!(\"value {}\", i);\n        let element = XMLElement::new(tag_name, value);\n        v.push_back(element);\n    }\n\n    // Assert elements\n    for i in 0..v.size() {\n        let expected_tag = format!(\"tag {}\", i);\n        let expected_value = format!(\"value {}\", i);\n        \n        let element = v.get_element_at(i);\n        let element_ref = element.unwrap();\n\n        assert_eq!(element_ref.tag_name, expected_tag);\n        assert_eq!(element_ref.value, expected_value);\n    }\n\n    println!(\"PASSED Test vector2\");\n}\n#[test]\nfn test_xml() {\n    let s = r#\"<programmer>\n    <name>Kien Nguyen Trung</name>\n    <languages>\n    <language>C</language>\n    <language>C++</language>\n    <language>Python</language>\n    <language>Ruby</language>\n    <language>Objective C</language>\n    <language>Java</language>\n    <language>Javascript</language>\n    <language>Lua</language>\n    <language>C#</language>\n    <language>PHP</language>\n    </languages>\n    </programmer>\"#;\n\n    let elem = parse_xml_from_text(s).unwrap();\n    let elem_ref = elem;\n    \n    assert_eq!(elem_ref.tag_name, \"programmer\");\n    assert_eq!(elem_ref.children.size, 2);\n\n    let child1 = elem_ref.children.get_element_at(0).unwrap();\n    assert_eq!(child1.tag_name, \"name\");\n    assert_eq!(child1.children.size, 0);\n    assert_eq!(child1.value, \"Kien Nguyen Trung\");\n\n    let child2 = elem_ref.children.get_element_at(1).unwrap();\n    assert_eq!(child2.tag_name, \"languages\");\n    assert_eq!(child2.children.size, 10);\n    \n    let list_languages = [\n        \"C\", \"C++\", \"Python\", \"Ruby\", \"Objective C\", \n        \"Java\", \"Javascript\", \"Lua\", \"C#\", \"PHP\"\n    ];\n\n    for i in 0..10 {\n        let child = child2.children.get_element_at(i).unwrap();\n        assert_eq!(child.value, list_languages[i]);\n        assert_eq!(child.tag_name, \"language\");\n    }\n\n    println!(\"PASSED Test parser xml\");\n}\n\n\nfn main(){}","numLines":153,"startLine":1,"totalLines":153}}}
