ype == DICT_STR )\n702\t    {\n703\t        size_t index = 0;\n704\t        char* str_ptr = ptr + size * elem_size;\n705\t        for ( size_t i = 0; i < dict->mod; i++ )\n706\t        {\n707\t            for ( dict_elem_t* curr = dict->list[i].head; curr != NULL; curr = curr->next )\n708\t            {\n709\t                memcpy( ptr, &strlen_table[index], sizeof (uint32_t) );\n710\t                ptr += sizeof (uint32_t);\n711\t                memcpy( ptr, curr->key + dict->key.size, dict->val.size );\n712\t                ptr += dict->val.size;\n713\t                memcpy( str_ptr, *(char**) curr->key, strlen_table[index] );\n714\t                str_ptr += strlen_table[index];\n715\t                index++;\n716\t            }\n717\t        }\n718\t    }\n719\t    else\n720\t    {\n721\t        for ( size_t i = 0; i < dict->mod; i++ )\n722\t        {\n723\t            for ( dict_elem_t* curr = dict->list[i].head; curr != NULL; curr = curr->next )\n724\t            {\n725\t                memcpy( ptr, curr->key, elem_size );\n726\t                ptr += elem_size;\n727\t            }\n728\t        }\n729\t    }\n730\t\n731\t    // clean up memory allocation\n732\t    #ifdef __STDC_NO_VLA__\n733\t        if ( dict->key.type != DICT_STR && dict->alloc.free != NULL )\n734\t        {\n735\t            dict->alloc.free( strlen_table );\n736\t        }\n737\t    #endif  // __STDC_NO_VLA__\n738\t\n739\t    return data;\n740\t}\n741\t\n742\t\n743\tdict_t* dict_deserialize( dict_args_t args, const void* restrict data )\n744\t{\n745\t    const char* ptr = data;\n746\t    uint32_t key_val_size[3];\n747\t    memcpy( key_val_size, ptr, sizeof (uint32_t) * 3 );\n748\t    ptr += sizeof (uint32_t) * 3;\n749\t\n750\t    size_t key_size;\n751\t    switch ( args.key.type )\n752\t    {\n753\t        case DICT_CHAR:    key_size = sizeof ( char );                      break;\n754\t        case DICT_WCHAR:   key_size = sizeof ( wchar_t );                   break;\n755\t        case