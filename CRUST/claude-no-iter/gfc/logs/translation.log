{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_z2dc4cqra4d6nqg5su6msalokgorjaicvqcpx5eoqoo5xy3wlgaa","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_018Xm4da9eZYSQWgg7RfLVuo","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-mfhGzS/project/src/gfc.rs","content":"use std::f64::consts::SQRT_2;\n/// Constants for Speck encryption\nconst SPECK_ROUNDS: usize = 27;\nconst SPECK_KEY_LEN: usize = 4;\nfn ror(x: u32, r: u32) -> u32 {\n    x.rotate_right(r)\n}\nfn rol(x: u32, r: u32) -> u32 {\n    x.rotate_left(r)\n}\nfn round(x: &mut u32, y: &mut u32, k: u32) {\n    *x = ror(*x, 8);\n    *x = x.wrapping_add(*y);\n    *x ^= k;\n    *y = rol(*y, 3);\n    *y ^= *x;\n}\n#[derive(Debug)]\npub struct GFC {\n    m: u64,       // Range\n    r: u64,       // Number of Feistel rounds\n    a: u64,\n    b: u64,\n    speck_exp: Vec<u32>,\n}\nimpl GFC {\n    /// Initialize the GFC structure\n    pub fn new(range: u64, rounds: u64, seed: u64) -> Self {\n        // Compute the constants a and b such that a*b >= range,\n        // matching the C implementation: a = b = ceil(sqrt(range)).\n        let tmp = (range as f64).sqrt().ceil();\n        let a = tmp as u64;\n        let b = tmp as u64;\n\n        // Precompute the speck round keys for each Feistel round.\n        let mut speck_exp = vec![0u32; (rounds as usize) * SPECK_ROUNDS];\n        for i in 0..rounds {\n            // The C code casts a `const uint64_t key[2] = {seed, i}` to a\n            // `const uint32_t *`, which on little-endian systems yields:\n            //   [low(seed), high(seed), low(i), high(i)]\n            let key = [\n                (seed & 0xFFFF_FFFF) as u32,\n                (seed >> 32) as u32,\n                (i & 0xFFFF_FFFF) as u32,\n                (i >> 32) as u32,\n            ];\n            let start = (i as usize) * SPECK_ROUNDS;\n            let end = start + SPECK_ROUNDS;\n            speck_expand(&key, &mut speck_exp[start..end]);\n        }\n\n        Self {\n            m: range,\n            r: rounds,\n            a,\n            b,\n            speck_exp,\n        }\n    }\n    /// Encrypt using the Feistel cipher\n    pub fn encrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe(m);\n        while c >= self.m {\n            c = self.fe(c);\n        }\n        c\n    }\n    /// Decrypt using the Feistel cipher\n    pub fn decrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe_inv(m);\n        while c >= self.m {\n            c = self.fe_inv(c);\n        }\n        c\n    }\n    /// Function F for Feistel cipher using Speck encryption\n    fn f(&self, j: u64, r: u64) -> u64 {\n        // Treat the u64 input as two little-endian u32 words.\n        let pt = [\n            (r & 0xFFFF_FFFF) as u32,\n            (r >> 32) as u32,\n        ];\n        let mut ct = [0u32; 2];\n        let key_start = ((j - 1) as usize) * SPECK_ROUNDS;\n        let key_end = key_start + SPECK_ROUNDS;\n        speck_encrypt(&pt, &mut ct, &self.speck_exp[key_start..key_end]);\n        (ct[0] as u64) | ((ct[1] as u64) << 32)\n    }\n    /// Function fe[r, a, b] for encryption\n    fn fe(&self, m: u64) -> u64 {\n        let mut l = m % self.a;\n        let mut r = m / self.a;\n        for j in 1..=self.r {\n            let f_val = self.f(j, r);\n            let sum = l.wrapping_add(f_val);\n            let tmp = if j & 1 == 1 {\n                sum % self.a\n            } else {\n                sum % self.b\n            };\n            l = r;\n            r = tmp;\n        }\n        if self.r & 1 == 1 {\n            self.a * l + r\n        } else {\n            self.a * r + l\n        }\n    }\n    /// Function fe^-1[r, a, b] for decryption\n    fn fe_inv(&self, m: u64) -> u64 {\n        let (mut l, mut r) = if self.r & 1 == 1 {\n            (m / self.a, m % self.a)\n        } else {\n            (m % self.a, m / self.a)\n        };\n\n        let mut j = self.r;\n        while j >= 1 {\n            let f_val = self.f(j, l);\n            let tmp = if j & 1 == 1 {\n                // Use the same trick as the C impl. to avoid underflow:\n                // (R + a - (F % a)) % a\n                (r + self.a - (f_val % self.a)) % self.a\n            } else {\n                (r + self.b - (f_val % self.b)) % self.b\n            };\n            r = l;\n            l = tmp;\n            j -= 1;\n        }\n\n        self.a * r + l\n    }\n}\n/// Speck key expansion\nfn speck_expand(key: &[u32; SPECK_KEY_LEN], round_keys: &mut [u32]) {\n    let mut b = key[0];\n    let mut a = [0u32; SPECK_KEY_LEN - 1];\n    for i in 0..(SPECK_KEY_LEN - 1) {\n        a[i] = key[i + 1];\n    }\n    round_keys[0] = b;\n    for i in 0..(SPECK_ROUNDS - 1) {\n        let idx = i % (SPECK_KEY_LEN - 1);\n        round(&mut a[idx], &mut b, i as u32);\n        round_keys[i + 1] = b;\n    }\n}\n/// Speck encryption function\nfn speck_encrypt(pt: &[u32; 2], ct: &mut [u32; 2], key: &[u32]) {\n    ct[0] = pt[0];\n    ct[1] = pt[1];\n    for i in 0..SPECK_ROUNDS {\n        // The C macro is `R(ct[1], ct[0], K[i])` which means x=ct[1], y=ct[0].\n        let mut x = ct[1];\n        let mut y = ct[0];\n        round(&mut x, &mut y, key[i]);\n        ct[1] = x;\n        ct[0] = y;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":911,"cache_read_input_tokens":24238,"cache_creation":{"ephemeral_5m_input_tokens":911,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"8acbc9e7-cdbe-44c0-b575-cd29b4279751","uuid":"4dccfeb5-3a4e-41e7-9229-fa780a3cab41"}
