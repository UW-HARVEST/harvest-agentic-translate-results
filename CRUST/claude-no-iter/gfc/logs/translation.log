{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01C7Q15yrcCrsQVYJux6nXF7","type":"tool_result","content":"1\t#include <gfc/gfc.h>\n2\t#include <math.h>\n3\t#include <stdlib.h>\n4\t\n5\t// The speck code is a cut down version of https://github.com/madmo/speck,\n6\t// licensed under the ISC license.\n7\t#define SPECK_TYPE uint32_t\n8\t#define SPECK_ROUNDS 27\n9\t#define SPECK_KEY_LEN 4\n10\t\n11\t#define ROR(x, r) ((x >> r) | (x << ((sizeof(SPECK_TYPE) * 8) - r)))\n12\t#define ROL(x, r) ((x << r) | (x >> ((sizeof(SPECK_TYPE) * 8) - r)))\n13\t#define R(x, y, k) (x = ROR(x, 8), x += y, x ^= k, y = ROL(y, 3), y ^= x)\n14\t\n15\tvoid speck_expand(SPECK_TYPE const K[SPECK_KEY_LEN],\n16\t                  SPECK_TYPE S[SPECK_ROUNDS]) {\n17\t  SPECK_TYPE i, b = K[0];\n18\t  SPECK_TYPE a[SPECK_KEY_LEN - 1];\n19\t\n20\t  for (i = 0; i < (SPECK_KEY_LEN - 1); i++) {\n21\t    a[i] = K[i + 1];\n22\t  }\n23\t  S[0] = b;\n24\t  for (i = 0; i < SPECK_ROUNDS - 1; i++) {\n25\t    R(a[i % (SPECK_KEY_LEN - 1)], b, i);\n26\t    S[i + 1] = b;\n27\t  }\n28\t}\n29\t\n30\tvoid speck_encrypt(SPECK_TYPE const pt[2], SPECK_TYPE ct[2],\n31\t                   SPECK_TYPE const K[SPECK_ROUNDS]) {\n32\t  SPECK_TYPE i;\n33\t  ct[0] = pt[0];\n34\t  ct[1] = pt[1];\n35\t\n36\t  for (i = 0; i < SPECK_ROUNDS; i++) {\n37\t    R(ct[1], ct[0], K[i]);\n38\t  }\n39\t}\n40\t\n41\t// Function Fe and fe are from the Figure 3 of\n42\t// https://www.cs.ucdavis.edu/~rogaway/papers/subset.pdf\n43\t// For the random function F we use speck\n44\t// with a block size of 64 bits and a key size of 128 bits.\n45\t\n46\t// This is the random function F_j(R) in the paper.\n47\tuint64_t F(const GFC *gfc, const uint64_t j, const uint64_t R) {\n48\t  uint64_t enc;\n49\t  const uint32_t *key = gfc->speck_exp + (j - 1) * SPECK_ROUNDS;\n50\t  speck_encrypt((const uint32_t *)&R, (uint32_t *)&enc, key);\n51\t  return enc;\n52\t}\n53\t\n54\t// This is the function fe[r,a,b]_K(m) in the paper.\n55\tuint64_t fe(const GFC *gfc, const uint64_t m) {\n56\t  uint64_t L, R, tmp;\n57\t\n58\t  L = m % gfc->a;\n59\t  R = m / gfc->a;\n60\t\n61\t  for (uint64_t j = 1; j <= gfc->r; j++) {\n62\t    // j & 1 is true if j is odd\n63\t    if (j & 1) {\n64\t      tmp = (L + F(gfc, j, R)) % gfc->a;\n65\t    } else {\n66\t      tmp = (L + F(gfc, j, R)) % gfc->b;\n67\t    }\n68\t    L = R;\n69\t    R = tmp;\n70\t  }\n71\t\n72\t  if (gfc->r & 1) {\n73\t    return gfc->a * L + R;\n74\t  } else {\n75\t    return gfc->a * R + L;\n76\t  }\n77\t}\n78\t\n79\t// This is the function fe^-1[r,a,b]_K(m) in the paper.\n80\tuint64_t fe_inv(const GFC *gfc, const uint64_t m) {\n81\t  uint64_t L, R, tmp;\n82\t\n83\t  if (gfc->r & 1) {\n84\t    R = m % gfc->a;\n85\t    L = m / gfc->a;\n86\t  } else {\n87\t    L = m % gfc->a;\n88\t    R = m / gfc->a;\n89\t  }\n90\t\n91\t  for (uint64_t j = gfc->r; j >= 1; j--) {\n92\t    if (j & 1) {\n93\t      // We apply the same trick as the following impl. to prevent underflows:\n94\t      // https://github.com/urbit/urbit-ob/blob/master/src/internal/ob.js#L152-L157\n95\t      tmp = (R + gfc->a - (F(gfc, j, L) % gfc->a)) % gfc->a;\n96\t      // tmp = (R - tmp) % gfc->a;\n97\t    } else {\n98\t      tmp = (R + gfc->b - (F(gfc, j, L) % gfc->b)) % gfc->b;\n99\t      // tmp = (R - tmp) % gfc->b;\n100\t    }\n101\t    R = L;\n102\t    L = tmp;\n103\t  }\n104\t\n105\t  return gfc->a * R + L;\n106\t}\n107\t\n108\tGFC *gfc_init(uint64_t range, uint64_t rounds, uint64_t seed) {\n109\t  GFC *gfc = calloc(1, sizeof(GFC));\n110\t  if (gfc == NULL) {\n111\t    return NULL;\n112\t  }\n113\t  gfc->M = range;\n114\t  gfc->r = rounds;\n115\t  // Compute the constants a and b such that ab >= range,\n116\t  // according to the method of Section 6.\n117\t  const double tmp = ceil(sqrt((double)range));\n118\t  gfc->a = (uint64_t)tmp;\n119\t  gfc->b = (uint64_t)tmp;\n120\t  // Precompute the speck round keys\n121\t  gfc->speck_exp = calloc(gfc->r * SPECK_ROUNDS, sizeof(uint32_t));\n122\t  for (uint64_t i = 0; i < gfc->r; i++) {\n123\t    const uint64_t key[2] = {seed, i};\n124\t    speck_expand((const uint32_t *)key, gfc->speck_exp + i * SPECK_ROUNDS);\n125\t  }\n126\t  return gfc;\n127\t}\n128\t\n129\tvoid gfc_destroy(GFC *gfc) {\n130\t  free(gfc->speck_exp);\n131\t  free(gfc);\n132\t}\n133\t\n134\t// This is the function Fe^-1[r,a,b]_K(m) in the paper.\n135\tuint64_t gfc_decrypt(const GFC *gfc, const uint64_t m) {\n136\t  uint64_t c = fe_inv(gfc, m);\n137\t  while (c >= gfc->M) {\n138\t    c = fe_inv(gfc, c);\n139\t  }\n140\t  return c;\n141\t}\n142\t\n143\t// This is the function Fe[r,a,b]_K(m) in the paper.\n144\tuint64_t gfc_encrypt(const GFC *gfc, const uint64_t m) {\n145\t  uint64_t c = fe(gfc, m);\n146\t  while (c >= gfc->M) {\n147\t    c = fe(gfc, c);\n148\t  }\n149\t  return c;\n150\t}\n151\t"}]},"parent_tool_use_id":null,"session_id":"8acbc9e7-cdbe-44c0-b575-cd29b4279751","uuid":"d2e2f699-d99b-420a-acf3-150b9ab229d7","timestamp":"2026-06-03T02:23:59.153Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-mfhGzS/project/c_src/src/gfc.c","content":"#include <gfc/gfc.h>\n#include <math.h>\n#include <stdlib.h>\n\n// The speck code is a cut down version of https://github.com/madmo/speck,\n// licensed under the ISC license.\n#define SPECK_TYPE uint32_t\n#define SPECK_ROUNDS 27\n#define SPECK_KEY_LEN 4\n\n#define ROR(x, r) ((x >> r) | (x << ((sizeof(SPECK_TYPE) * 8) - r)))\n#define ROL(x, r) ((x << r) | (x >> ((sizeof(SPECK_TYPE) * 8) - r)))\n#define R(x, y, k) (x = ROR(x, 8), x += y, x ^= k, y = ROL(y, 3), y ^= x)\n\nvoid speck_expand(SPECK_TYPE const K[SPECK_KEY_LEN],\n                  SPECK_TYPE S[SPECK_ROUNDS]) {\n  SPECK_TYPE i, b = K[0];\n  SPECK_TYPE a[SPECK_KEY_LEN - 1];\n\n  for (i = 0; i < (SPECK_KEY_LEN - 1); i++) {\n    a[i] = K[i + 1];\n  }\n  S[0] = b;\n  for (i = 0; i < SPECK_ROUNDS - 1; i++) {\n    R(a[i % (SPECK_KEY_LEN - 1)], b, i);\n    S[i + 1] = b;\n  }\n}\n\nvoid speck_encrypt(SPECK_TYPE const pt[2], SPECK_TYPE ct[2],\n                   SPECK_TYPE const K[SPECK_ROUNDS]) {\n  SPECK_TYPE i;\n  ct[0] = pt[0];\n  ct[1] = pt[1];\n\n  for (i = 0; i < SPECK_ROUNDS; i++) {\n    R(ct[1], ct[0], K[i]);\n  }\n}\n\n// Function Fe and fe are from the Figure 3 of\n// https://www.cs.ucdavis.edu/~rogaway/papers/subset.pdf\n// For the random function F we use speck\n// with a block size of 64 bits and a key size of 128 bits.\n\n// This is the random function F_j(R) in the paper.\nuint64_t F(const GFC *gfc, const uint64_t j, const uint64_t R) {\n  uint64_t enc;\n  const uint32_t *key = gfc->speck_exp + (j - 1) * SPECK_ROUNDS;\n  speck_encrypt((const uint32_t *)&R, (uint32_t *)&enc, key);\n  return enc;\n}\n\n// This is the function fe[r,a,b]_K(m) in the paper.\nuint64_t fe(const GFC *gfc, const uint64_t m) {\n  uint64_t L, R, tmp;\n\n  L = m % gfc->a;\n  R = m / gfc->a;\n\n  for (uint64_t j = 1; j <= gfc->r; j++) {\n    // j & 1 is true if j is odd\n    if (j & 1) {\n      tmp = (L + F(gfc, j, R)) % gfc->a;\n    } else {\n      tmp = (L + F(gfc, j, R)) % gfc->b;\n    }\n    L = R;\n    R = tmp;\n  }\n\n  if (gfc->r & 1) {\n    return gfc->a * L + R;\n  } else {\n    return gfc->a * R + L;\n  }\n}\n\n// This is the function fe^-1[r,a,b]_K(m) in the paper.\nuint64_t fe_inv(const GFC *gfc, const uint64_t m) {\n  uint64_t L, R, tmp;\n\n  if (gfc->r & 1) {\n    R = m % gfc->a;\n    L = m / gfc->a;\n  } else {\n    L = m % gfc->a;\n    R = m / gfc->a;\n  }\n\n  for (uint64_t j = gfc->r; j >= 1; j--) {\n    if (j & 1) {\n      // We apply the same trick as the following impl. to prevent underflows:\n      // https://github.com/urbit/urbit-ob/blob/master/src/internal/ob.js#L152-L157\n      tmp = (R + gfc->a - (F(gfc, j, L) % gfc->a)) % gfc->a;\n      // tmp = (R - tmp) % gfc->a;\n    } else {\n      tmp = (R + gfc->b - (F(gfc, j, L) % gfc->b)) % gfc->b;\n      // tmp = (R - tmp) % gfc->b;\n    }\n    R = L;\n    L = tmp;\n  }\n\n  return gfc->a * R + L;\n}\n\nGFC *gfc_init(uint64_t range, uint64_t rounds, uint64_t seed) {\n  GFC *gfc = calloc(1, sizeof(GFC));\n  if (gfc == NULL) {\n    return NULL;\n  }\n  gfc->M = range;\n  gfc->r = rounds;\n  // Compute the constants a and b such that ab >= range,\n  // according to the method of Section 6.\n  const double tmp = ceil(sqrt((double)range));\n  gfc->a = (uint64_t)tmp;\n  gfc->b = (uint64_t)tmp;\n  // Precompute the speck round keys\n  gfc->speck_exp = calloc(gfc->r * SPECK_ROUNDS, sizeof(uint32_t));\n  for (uint64_t i = 0; i < gfc->r; i++) {\n    const uint64_t key[2] = {seed, i};\n    speck_expand((const uint32_t *)key, gfc->speck_exp + i * SPECK_ROUNDS);\n  }\n  return gfc;\n}\n\nvoid gfc_destroy(GFC *gfc) {\n  free(gfc->speck_exp);\n  free(gfc);\n}\n\n// This is the function Fe^-1[r,a,b]_K(m) in the paper.\nuint64_t gfc_decrypt(const GFC *gfc, const uint64_t m) {\n  uint64_t c = fe_inv(gfc, m);\n  while (c >= gfc->M) {\n    c = fe_inv(gfc, c);\n  }\n  return c;\n}\n\n// This is the function Fe[r,a,b]_K(m) in the paper.\nuint64_t gfc_encrypt(const GFC *gfc, const uint64_t m) {\n  uint64_t c = fe(gfc, m);\n  while (c >= gfc->M) {\n    c = fe(gfc, c);\n  }\n  return c;\n}\n","numLines":151,"startLine":1,"totalLines":151}}}
