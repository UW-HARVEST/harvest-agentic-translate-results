8\t\treturn rvDelim;\n259\t      }\n260\t      if (c=='\\r') {\n261\t\treturn rvStateEOL;\n262\t      }\n263\t      if (c=='\\n') {\n264\t\treturn rvStateEOL;\n265\t      }\n266\t      //if (buf[*end]=='\\n' && *end == buflen-1) {\n267\t      //\treturn rvStateEOL;\n268\t      //}\n269\t      //if (buf[*end]=='\\r' && *end == buflen-1) {\n270\t      //\treturn rvStateEOL;\n271\t      //}\n272\t      if (c=='\\0' && *end == buflen-1) {\n273\t\treturn rvStateEOL;\n274\t      }      \n275\t    }\n276\t  }\n277\t  return rvStateEOL;\n278\t}\n279\tint main(int argc, char** argv) {\n280\t  //init\n281\t  gpInput=stdin;\n282\t  gpOutput=stdout;\n283\t  gpDelimIn = ',';\n284\t  gpDelimOut = ',';\n285\t  gpQuoteIn = '\"';\n286\t  gpQuoteOut = '\"';\n287\t  gpEndLine = NULL;\n288\t  gpVerbose = 0;\n289\t\n290\t  \n291\t  int arginc = 1;\n292\t  while(arginc < argc) {\n293\t    debug(5, \"argc=(%d) arginc=(%d)  argv[arginc]=(%s)\\n\", argc, arginc, argv[arginc]);\n294\t    if (strcmp(argv[arginc], \"-i\")==0) {\n295\t      if (argc <= arginc+1) {\n296\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n297\t\treturn -1;\n298\t      }\n299\t      arginc++;\n300\t      debug(5, \"arg %s\\n\", argv[arginc]);\n301\t      gpInput = fopen(argv[arginc], \"r\");\n302\t      if (gpInput == NULL) {\n303\t\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n304\t\treturn -1;\n305\t      }\n306\t      arginc++;\n307\t    }\n308\t    else if (strcmp(argv[arginc], \"-o\")==0) {\n309\t      if (argc <= arginc+1) {\n310\t\tfprintf(stderr, \"error: missing argument for '%s'\\n\", argv[arginc]);\n311\t\treturn -1;\n312\t      }\n313\t      arginc++;\n314\t      debug(5, \"arg %s\\n\", argv[arginc]);\n315\t      gpOutput = fopen(argv[arginc], \"r\");\n316\t      if (gpOutput == NULL) {\n317\t\tfprintf(stderr, \"error: unable to open (%s) for gpInput\\n\", argv[arginc]);\n318\t\treturn -1;\n319\t      }\n320\t      arginc++;\n321\t    }\n322\t  