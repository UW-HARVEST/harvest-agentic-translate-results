,"     rv"," }"]}],"originalFile":"pub mod range {\nuse std::fmt::Write;\n\n#[derive(Debug, Clone, PartialEq)]\npub enum RangeType {\nEmpty,\nSingle,\nStartEnd,\nGreaterEqual,\n}\n#[derive(Debug, Clone)]\npub struct RangeElement {\npub start: u32,\npub end: u32,\npub rangetype: RangeType,\npub next: Option<Box<RangeElement>>,\n}\n\n// Helper: check if range A is \"contained in\" range B\nfn range_contained(a: &RangeElement, b: &RangeElement) -> bool {\n    match (&a.rangetype, &b.rangetype) {\n        (RangeType::Empty, _) => true,\n        (RangeType::Single, RangeType::Single) => a.start == b.start,\n        (RangeType::Single, RangeType::StartEnd) => b.start <= a.start && a.start <= b.end,\n        (RangeType::Single, RangeType::GreaterEqual) => a.start >= b.start,\n        (RangeType::StartEnd, RangeType::Single) => a.start == a.end && a.start == b.start,\n        (RangeType::StartEnd, RangeType::StartEnd) => b.start <= a.start && a.end <= b.end,\n        (RangeType::StartEnd, RangeType::GreaterEqual) => a.start >= b.start,\n        (RangeType::GreaterEqual, RangeType::GreaterEqual) => a.start >= b.start,\n        (RangeType::GreaterEqual, _) => false,\n        (_, RangeType::Empty) => false,\n    }\n}\n\nfn element_str(e: &RangeElement) -> String {\n    match e.rangetype {\n        RangeType::Single => format!(\"[{}]\", e.start),\n        RangeType::GreaterEqual => format!(\"[{}-]\", e.start),\n        RangeType::StartEnd => format!(\"[{}-{}]\", e.start, e.end),\n        RangeType::Empty => \"[]\".to_string(),\n    }\n}\n\nimpl RangeElement {\npub fn new() -> Self {\n    RangeElement {\n        start: u32::MAX,\n        end: u32::MAX,\n        rangetype: RangeType::Empty,\n        next: None,\n    }\n}\npub fn add_single(num: u32, start_of_list: Option<Box<RangeElement>>) -> Option<Box<RangeElement>> {\n    assert!(num > 0);\n    let mut new_elem = Box::new(RangeElement::new());\n    new_elem.start = num;\n    new_elem.rangetype = RangeType::Single;\n    match start_of_list {\n        None => Some(new_elem),\n        Some(mut head) => {\n            {\n                let mut ptr: &mut RangeElement = &mut *head;\n                while ptr.next.is_some() {\n                    ptr = ptr.next.as_mut().unwrap();\n                }\n                ptr.next = Some(new_elem);\n            }\n            Some(head)\n        }\n    }\n}\npub fn add_start_end(start: u32, end: u32, start_of_list: Option<Box<RangeElement>>) -> Option<Box<RangeElement>> {\n    assert!(start > 0);\n    assert!(end >= start);\n    let mut new_elem = Box::new(RangeElement::new());\n    new_elem.start = start;\n    if start == end {\n        new_elem.rangetype = RangeType::Single;\n    } else {\n        new_elem.rangetype = RangeType::StartEnd;\n        new_elem.end = end;\n    }\n    match start_of_list {\n        None => Some(new_elem),\n        Some(mut head) => {\n            {\n                let mut ptr: &mut RangeElement = &mut *head;\n                while ptr.next.is_some() {\n                    ptr = ptr.next.as_mut().unwrap();\n                }\n                ptr.next = Some(new_elem);\n            }\n            Some(head)\n        }\n    }\n}\npub fn add_greater_equal(num: u32, start_of_list: Option<Box<RangeElement>>) -> Option<Box<RangeElement>> {\n    let mut new_elem = Box::new(RangeElement::new());\n    new_elem.start = num;\n    new_elem.rangetype = RangeType::GreaterEqual;\n    match start_of_list {\n        None => Some(new_elem),\n        Some(mut head) => {\n            {\n                let mut ptr: &mut RangeElement = &mut *head;\n                while ptr.next.is_some() {\n                    ptr = ptr.next.as_mut().unwrap();\n                }\n                ptr.next = Some(new_elem);\n            }\n            Some(head)\n        }\n    }\n}\npub fn contains_num(num: u32, start_of_list: &Option<Box<RangeElement>>) -> bool {\n    let mut cur = start_of_list;\n    loop {\n        match cur {\n            None => return