29\t  debug(50,\"outputLine:start\\n\");\n130\t  if (cline == NULL) return;\n131\t  if (gpOutColumns == NULL) { // print all\n132\t    debug(50,\"outputLine:printall\\n\");\n133\t    int fieldcnt = csvline_getFieldCnt(cline);\n134\t    int i;\n135\t    for (i=0; i<fieldcnt; i++) {\n136\t      char* str = csvline_getField(cline,i);\n137\t      formatOutput(&str);\n138\t      fprintf(gpOutput, \"%s\", str);\n139\t      if ( (i+1) != fieldcnt) {\n140\t\tfprintf(gpOutput, \"%c\", gpDelimOut);\n141\t      }\n142\t    }    \n143\t  }\n144\t  else {\n145\t    debug(50,\"outputLine:printranges\\n\");\n146\t    struct rangeElement* list = gpOutColumns;\n147\t    int colCnt = csvline_getFieldCnt(cline);\n148\t    do {\n149\t      switch (list->rangetype) {\n150\t      case EMPTY:\n151\t\tbreak;\n152\t      case SINGLE:\n153\t\tdebug(50,\"outputLine:single(%d)\\n\", list->start);\n154\t\tchar* str = csvline_getField(cline,list->start - 1);\n155\t\tformatOutput(&str);\n156\t\tif (strlen(str) == 0) {\n157\t\t  //don't print (null)\n158\t\t}\n159\t\telse {\n160\t\t  fprintf(gpOutput, \"%s\",str);\n161\t\t}\n162\t\tif (list->next != NULL) {\n163\t\t  fprintf (gpOutput, \"%c\", gpDelimOut);\n164\t\t}\n165\t\tbreak;\n166\t      case STARTEND:\n167\t\tdebug(50,\"outputLine:startend (%d - %d)\\n\", list->start, list->end);\n168\t\t{\n169\t\t  int i=0;\n170\t\t  char* str = NULL;\n171\t\t  for (i=list->start - 1; (i+1) < list->end; i++) {\n172\t\t    str = csvline_getField(cline,i);\n173\t\t    formatOutput(&str);\n174\t\t    if (strlen(str) == 0) {\n175\t\t      fprintf(gpOutput, \"%c\", gpDelimOut);\n176\t\t    }\n177\t\t    else {\n178\t\t      fprintf(gpOutput, \"%s%c\", str, gpDelimOut);\n179\t\t    }\n180\t\t  }\n181\t\t  int last = list->end - 1;\n182\t\t  if (last >= colCnt) {\n183\t\t    break;\n184\t\t  }\n185\t\t  str = csvline_getField(cline, last);\n186\t\t  formatOutput(&str);\n187\t\t  if (strlen(str) == 0) {\n188\t\t  }\n189\t\t  else {\n190\t\t    fprintf(gpOutput, \"%