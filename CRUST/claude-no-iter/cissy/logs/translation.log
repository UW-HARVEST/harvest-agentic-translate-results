t, rv);\n                }\n            } else if start > 0 {\n                end = numbuf.parse::<u32>().unwrap_or(0);\n                if end == 0 || start > end {\n                    eprintln!(\"error: illegal start/end ranges\");\n                    std::process::exit(-1);\n                }\n                rv = raw_start_end(start, end, rv);\n            } else {\n                start = numbuf.parse::<u32>().unwrap_or(0);\n                rv = raw_single(start, rv);\n            }\n            numbuf.clear();\n            start = 0;\n            state = 0;\n        }\n    }\n    // finish up\n    if numbuf.is_empty() {\n        if (state & flag_dash) != 0 {\n            rv = raw_greater_equal(start, rv);\n        }\n    } else if start > 0 {\n        end = numbuf.parse::<u32>().unwrap_or(0);\n        if end == 0 || start > end {\n            eprintln!(\"error: illegal start/end range {}\", text);\n            std::process::exit(-1);\n        }\n        rv = raw_start_end(start, end, rv);\n    } else {\n        start = numbuf.parse::<u32>().unwrap_or(0);\n        rv = raw_single(start, rv);\n    }\n    rv\n}\n}\n}\n","structuredPatch":[{"oldStart":16,"oldLines":22,"newStart":16,"newLines":66,"lines":[" pub next: Option<Box<RangeElement>>,"," }"," ","-// Helper: check if range A is \"contained in\" range B","-fn range_contained(a: &RangeElement, b: &RangeElement) -> bool {","-    match (&a.rangetype, &b.rangetype) {","-        (RangeType::Empty, _) => true,","-        (RangeType::Single, RangeType::Single) => a.start == b.start,","-        (RangeType::Single, RangeType::StartEnd) => b.start <= a.start && a.start <= b.end,","-        (RangeType::Single, RangeType::GreaterEqual) => a.start >= b.start,","-        (RangeType::StartEnd, RangeType::Single) => a.start == a.end && a.start == b.start,","-        (RangeType::StartEnd, RangeType::StartEnd) => b.start <= a.start && a.end <= b.end,","-        (RangeType::StartEnd, RangeType::GreaterEqual) => a.start >= b