eates a new node from a template node, pushing it onto node_vector and returning the clone.\npub fn node_create(template: &Node) -> Node {\n    let cloned = template.clone();\n    node_push(&cloned);\n    cloned\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2506,"cache_read_input_tokens":86789,"cache_creation":{"ephemeral_5m_input_tokens":2506,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"f2878435-49d2-4601-8ff3-791e3f6acc7d","uuid":"add5cf2e-3cba-423a-8d03-b9cb2651ed26"}
