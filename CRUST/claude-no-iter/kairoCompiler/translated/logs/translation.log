 '\\'';\n457\t        break;\n458\t    }\n459\t    return co;\n460\t}\n461\t\n462\tvoid lexer_pop_token()\n463\t{\n464\t    vector_pop(lex_process->token_vec);\n465\t}\n466\t\n467\tbool is_hex_char(char c)\n468\t{\n469\t     c = tolower(c);\n470\t    return (c>='0' && c<='9') || (c>='a' && c<='f');\n471\t}\n472\t\n473\tconst char* read_hex_number_str()\n474\t{\n475\t    struct buffer* buffer = buffer_create();\n476\t    char c = peekc(); \n477\t    LEX_GETC_IF(buffer,c,is_hex_char(c));\n478\t    buffer_write(buffer,0x00);\n479\t    return buffer_ptr(buffer);\n480\t}\n481\t\n482\tstruct token* token_make_special_number_hexadecimal()\n483\t{\n484\t    //skip the x\n485\t    nextc();\n486\t    unsigned long number = 0;\n487\t    const char* number_str = read_hex_number_str();\n488\t    number = strtol(number_str,0,16);\n489\t    return token_make_number_for_value(number);\n490\t}\n491\t\n492\tvoid lexer_validate_binary_string(const char* str)\n493\t{\n494\t    size_t len = strlen(str);\n495\t    for(int i=0;i<len;i++)\n496\t    {\n497\t        if(str[i]!='0' && str[i]!='1')\n498\t        {\n499\t            compiler_error(lex_process->compiler,\"Invalid Binary number\\n\");\n500\t        }\n501\t    }\n502\t}\n503\tstruct token* token_make_special_number_binary()\n504\t{\n505\t    //skip the b\n506\t    nextc();\n507\t    unsigned long number = 0;\n508\t    const char* number_str = read_number_str();\n509\t    lexer_validate_binary_string(number_str);\n510\t    number = strtol(number_str,0,2);\n511\t\n512\t    return token_make_number_for_value(number);\n513\t}\n514\tstruct token* token_make_special_number()\n515\t{\n516\t     struct token* token =NULL;\n517\t     struct token* last_token = lexer_last_token(); \n518\t    if(!last_token || !(last_token->type=TOKEN_TYPE_NUMBER && last_token->llnum == 0))\n519\t    {\n520\t        return token_make_identifier_or_keyword();\n521\t    }\n522\t     lexer_pop_token();\n523\t     char c = peekc();\n524\t     if(c == 'x')\n525\t     {\n526\t        token = token_make_special_number_hexadecimal();\n527\t     }\n528\t     else if(c == 'b')\n529\t     {\n530\t        token = token_make_special_number_binary();\n531\t     }\n532\t\n533\t     return token;\n534\t}\n535\tstruct token* token_make_quote()\n536\t{\n537\t     assert_next_char('\\'');\n538\t    char c = nextc();\n539\t    if(c=='\\\\')\n540\t    {\n541\t        c = nextc();\n542\t        c = lex_get_escaped_char(c);\n543\t    }\n544\t\n545\t    if(nextc()!='\\'')\n546\t    {\n547\t        compiler_error(lex_process->compiler,\"You opened a quote ' but did not close it\\n\");\n548\t    }\n549\t\n550\t    return token_create(&(struct token){.type=TOKEN_TYPE_NUMBER,.cval=c});\n551\t}\n552\t\n553\tstruct token *read_next_token()\n554\t{\n555\t    struct token *token = NULL;\n556\t    char c = peekc();\n557\t    // printf(\"Read character: '%c'\\n\", c);\n558\t\n559\t    token = handle_comment();\n560\t    if(token)\n561\t    {\n562\t        return token;\n563\t    }\n564\t    switch (c)\n565\t    {\n566\t    NUMERIC_CASE:\n567\t        token = token_make_number();\n568\t        break;\n569\t\n570\t    OPERATOR_CASE_EXCLUDING_DIVISION:\n571\t        token = token_make_operator_or_string();\n572\t        break;\n573\t\n574\t    SYMBOL_CASE:\n575\t        token = token_make_symbol();\n576\t        break;\n577\t\n578\t    case 'b':\n579\t        token = token_make_special_number();\n580\t        break;\n581\t\n582\t    case 'x':\n583\t        token = token_make_special_number();\n584\t        break;\n585\t\n586\t    case '\\'':\n587\t        token = token_make_quote();\n588\t        break;\n589\t    \n590\t    case '\"':\n591\t        token = token_make_string('\"', '\"');\n592\t        break;\n593\t    \n594\t    case ' ':\n595\t    case '\\t':\n596\t        token = handle_whitespace();\n597\t        break;\n598\t\n599\t    case '\\n':\n600\t        token = token_make_newline();\n601\t        break;\n602\t    case '$':\n603\t        // we have finished  lexical analysis on the file\n604\t        break;\n605\t\n606\t    default:\n607\t        token = read_special_token();\n608\t        if (!token)\n609\t            compiler_error(lex_process->compiler, \"Unexpected token\\n\");\n610\t    }\n611\t\n612\t    return token;\n613\t}\n614\tint lex(struct lex_process *process)\n615\t{\n616\t    process->current_expression_count = 0;\n617\t    process->parentheses_buffer = NULL;\n618\t    lex_process = process;\n619\t    process->pos.filename = process->compiler->cfile.abs_path;\n620\t\n621\t    struct token *token = read_next_token();\n622\t    while (token)\n623\t    {\n624\t        vector_push(process->token_vec, token);\n625\t        token = read_next_token();\n626\t    }\n627\t    return LEXICAL_ANALYSIS_ALL_OK;\n628\t}\n629\t\n630\tchar lexer_string_buffer_next_char(struct lex_process* process)\n631\t{\n632\t    struct buffer* buf = lex_process_private(process);\n633\t    return buffer_read(buf);\n634\t}\n635\t\n636\tchar lexer_string_buffer_peek_char(struct lex_process* process)\n637\t{\n638\t    struct buffer* buf = lex_process_private(process);\n639\t    return buffer_peek(buf);\n640\t}\n641\t\n642\tvoid lexer_string_buffer_push_char(struct lex_process* process,char c)\n643\t{\n644\t    struct buffer* buf = lex_process_private(process);\n645\t    buffer_write(buf,c);\n646\t}\n647\t\n648\tstruct lex_process_functions lexer_string_buffer_functions = {\n649\t    .next_char = lexer_string_buffer_next_char,\n650\t    .peek_char = lexer_string_buffer_peek_char,\n651\t    .push_char = lexer_string_buffer_push_char\n652\t};\n653\t// build token for input string\n654\tstruct lex_process* tokens_build_for_string(struct compile_process* compiler,const char* str)\n655\t{\n656\t    struct buffer* buffer = buffer_create();\n657\t    buffer_printf(buffer,str);\n658\t    struct lex_process* lex_process = lex_process_create(compiler,&lexer_string_buffer_functions,buffer);\n659\t    if(!lex_process)\n660\t    {\n661\t        return NULL;\n662\t    }\n663\t    if(lex(lex_process)!=LEXICAL_ANALYSIS_ALL_OK)\n664\t    {\n665\t        return NULL;\n666\t    }\n667\t\n668\t    return lex_process;\n669\t}"}]},"parent_tool_use_id":null,"session_id":"f2878435-49d2-4601-8ff3-791e3f6acc7d","uuid":"bb99b14e-024f-4013-97b7-6d70af18b5d8","timestamp":"2026-06-03T03:08:28.820Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-hYYtFR/project/c_src/lexer.c","content":"#include \"compiler.h\"\n#include \"helpers/vector.h\"\n#include \"helpers/buffer.h\"\n#include <string.h>\n#include <assert.h>\n#include <ctype.h>\n\n#define LEX_GETC_IF(buffer, c, exp)     \\\n    for (c = peekc(); exp; c = peekc()) \\\n    {                                   \\\n        buffer_write(buffer, c);        \\\n        nextc();                        \\\n    }\nbool lex_is_in_expression();\nstruct token *read_next_token();\nstatic struct lex_process *lex_process;\nstatic struct token tmp_token;\n\nstatic char peekc()\n{\n    return lex_process->function->peek_char(lex_process);\n}\n\nstatic char nextc()\n{\n    char c = lex_process->function->next_char(lex_process);\n    if(lex_is_in_expression())\n    {\n        buffer_write(lex_process->parentheses_buffer,c);\n    }\n\n    lex_process->pos.col += 1;\n    if (c == '\\n')\n    {\n        lex_process->pos.line += 1;\n        lex_process->pos.col = 1;\n    }\n\n    return c;\n}\nstatic void pushc(char c)\n{\n    lex_process->function->push_char(lex_process, c);\n}\n\nstatic char assert_next_char(char c)\n{\n     char next_c = nextc();\n     assert(c == next_c);\n     return next_c;\n}\nstatic struct pos lex_file_position()\n{\n    return lex_process->pos;\n}\n\nstruct token *token_create(struct token *_token)\n{\n    memcpy(&tmp_token, _token, sizeof(struct token));\n    tmp_token.pos = lex_file_position();\n    if(lex_is_in_expression())\n    {\n        tmp_token.between_brackets = buffer_ptr(lex_process->parentheses_buffer);\n    }\n    return &tmp_token;\n}\n\nstatic struct token *lexer_last_token()\n{\n    return vector_back_or_null(lex_process->token_vec);\n}\n\nstatic struct token *handle_whitespace()\n{\n    struct token *last_token = lexer_last_token();\n    if (last_token)\n    {\n        last_token->whitespace = true;\n    }\n    nextc();\n    return read_next_token();\n}\n\nconst char *read_number_str()\n{\n    const char *num = NULL;\n    struct buffer *buffer = buffer_create();\n    char c = peekc();\n\n    LEX_GETC_IF(buffer, c, (c >= '0' && c <= '9'))\n\n    buffer_write(buffer, 0x00);\n    return buffer_ptr(buffer);\n}\n\nunsigned long long read_number()\n{\n    const char *s = read_number_str();\n    return atoll(s);\n}\n\n int lexer_number_type(char c)\n {\n    int res = NUMBER_TYPE_NORMAL;\n    if(c == 'L')\n        res = NUMBER_TYPE_LONG;\n    else if (c == 'f')\n        res = NUMBER_TYPE_FLOAT;\n    return res;\n }\nstruct token *token_make_number_for_value(unsigned long number)\n{\n    int number_type = lexer_number_type(peekc());\n    if(number_type != NUMBER_TYPE_NORMAL)\n    {\n        nextc();\n    }\n    return token_create(&(struct token){.type = TOKEN_TYPE_NUMBER, .llnum = number,.num.type=number_type});\n}\n\nstruct token *token_make_number()\n{\n    return token_make_number_for_value(read_number());\n}\n\nstruct token *token_make_string(char start_delim, char end_delim)\n{\n    struct buffer *buf = buffer_create();\n    assert(nextc() == start_delim);\n    char c = nextc();\n    for (; c != end_delim && c != EOF; c = nextc())\n    {\n        if (c == '\\\\')\n        {\n            continue;\n        }\n        buffer_write(buf, c);\n    }\n    buffer_write(buf, 0x00);\n    return token_create(&(struct token){.type = TOKEN_TYPE_STRING, .sval = buffer_ptr(buf)});\n}\n\nstatic bool op_treated_as_one(char op)\n{\n    return op == '(' || op == '[' || op == ',' || op == '.' || op == '*' || op == '?';\n}\n\nstatic bool is_single_operator(char op)\n{\n    return op == '+' || op == '-' || op == '/' || op == '*' || op == '=' ||\n           op == '>' || op == '<' || op == '|' || op == '&' || op == '^' ||\n           op == '%' || op == '~' || op == '!' || op == '(' || op == '[' ||\n           op == ',' || op == '.' || op == '?';\n}\n\nbool op_valid(char *op)\n{\n    return S_EQ(op, \"+\") ||\n           S_EQ(op, \"-\") ||\n           S_EQ(op, \"*\") ||\n           S_EQ(op, \"/\") ||\n           S_EQ(op, \"!\") ||\n           S_EQ(op, \"^\") ||\n           S_EQ(op, \"+=\") ||\n           S_EQ(op, \"-=\") ||\n           S_EQ(op, \"*=\") ||\n           S_EQ(op, \"/=\") ||\n           S_EQ(op, \">>\") ||\n           S_EQ(op, \"<<\") ||\n           S_EQ(op, \">=\") ||\n           S_EQ(op, \"<=\") ||\n           S_EQ(op, \">\") ||\n           S_EQ(op, \"<\") ||\n           S_EQ(op, \"||\") ||\n           S_EQ(op, \"&&\") ||\n           S_EQ(op, \"|\") ||\n           S_EQ(op, \"&\") ||\n           S_EQ(op, \"++\") ||\n           S_EQ(op, \"--\") ||\n           S_EQ(op, \"= \") ||\n           S_EQ(op, \"!=\") ||\n           S_EQ(op, \"==\") ||\n           S_EQ(op, \"->\") ||\n           S_EQ(op, \"(\") ||\n           S_EQ(op, \"[\") ||\n           S_EQ(op, \",\") ||\n           S_EQ(op, \".\") ||\n           S_EQ(op, \"...\") ||\n           S_EQ(op, \"~\") ||\n           S_EQ(op, \"?\") ||\n           S_EQ(op, \"%\");\n}\n\nvoid read_op_flush_back_keep_first(struct buffer *buffer)\n{\n    //+*\n    const char *data = buffer_ptr(buffer);\n    int len = buffer->len;\n    for (int i = len - 1; i >= 1; i--)\n    {\n        if (data[i] == 0x00)\n        {\n            continue;\n        }\n\n        pushc(data[i]); // * is pushed back and only + remains\n    }\n}\nconst char *read_op()\n{\n    bool single_operator = true; // eg : ++\n    char op = nextc();           // +\n    struct buffer *buffer = buffer_create();\n    buffer_write(buffer, op); //=+\n\n    if (!op_treated_as_one(op))\n    {\n        op = peekc(); // 2nd +\n        if (is_single_operator(op))\n        {\n            buffer_write(buffer, op); // =++\n            nextc();                  // after 2nd +\n            single_operator = false;\n        }\n    }\n    buffer_write(buffer, 0x00);\n    char *ptr = buffer_ptr(buffer);\n\n    // check if its valid like ++ and its not like +-\n    if (!single_operator)\n    {\n        if (!op_valid(ptr))\n        {\n            read_op_flush_back_keep_first(buffer);\n            ptr[1] = 0x00;\n        }\n    }\n    else if (!op_valid)\n    {\n        compiler_error(lex_process->compiler, \"The operator %s is not valid\\n\", ptr);\n    }\n}\n\nstatic void lex_new_expression()\n{\n    lex_process->current_expression_count++;\n    if (lex_process->current_expression_count == 1)\n    {\n        lex_process->parentheses_buffer = buffer_create();\n    }\n}\n\nstatic void lex_finish_expression()\n{\n    lex_process->current_expression_count--;\n    if (lex_process->current_expression_count < 0)\n    {\n        compiler_error(lex_process->compiler, \"You closed an expression that you never opened\\n\");\n    }\n}\n\nbool lex_is_in_expression()\n{\n    return lex_process->current_expression_count > 0;\n}\n\nbool is_keyword(const char *str)\n{\n    return S_EQ(str, \"auto\") ||\n           S_EQ(str, \"break\") ||\n           S_EQ(str, \"case\") ||\n           S_EQ(str, \"char\") ||\n           S_EQ(str, \"const\") ||\n           S_EQ(str, \"continue\") ||\n           S_EQ(str, \"default\") ||\n           S_EQ(str, \"do\") ||\n           S_EQ(str, \"double\") ||\n           S_EQ(str, \"else\") ||\n           S_EQ(str, \"enum\") ||\n           S_EQ(str, \"extern\") ||\n           S_EQ(str, \"float\") ||\n           S_EQ(str, \"for\") ||\n           S_EQ(str, \"goto\") ||\n           S_EQ(str, \"if\") ||\n           S_EQ(str, \"inline\") ||\n           S_EQ(str, \"int\") ||\n           S_EQ(str, \"long\") ||\n           S_EQ(str, \"register\") ||\n           S_EQ(str, \"restrict\") ||\n           S_EQ(str, \"retur