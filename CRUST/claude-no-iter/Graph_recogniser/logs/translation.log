iendliness."}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":445,"cache_read_input_tokens":49437,"cache_creation":{"ephemeral_5m_input_tokens":445,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"1e239fa4-3bff-4a29-8332-512ce10cc680","uuid":"77c8a23a-9688-493c-8398-71320243a69f"}
