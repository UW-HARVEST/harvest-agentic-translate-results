rip_deck(deck: &mut CardDeck, decided_cards: &DecidedCards) {\n        let end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            if let Some(c) = &decided_cards.my_cards[i] {\n                deck.strip_card_from_deck(c.get_card_suit_rank());\n            }\n        }\n        let end = decided_cards.opponent_card_count as usize;\n        for i in 0..end {\n            if let Some(c) = &decided_cards.opponent_cards[i] {\n                deck.strip_card_from_deck(c.get_card_suit_rank());\n            }\n        }\n    }\n\n    pub fn complete_hand(\n        my_hand: &mut CardHand,\n        decided_cards: &DecidedCards,\n        deck: &mut CardDeck,\n    ) {\n        let end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            // Clone the predetermined card by reading its rank/suit and recreating it.\n            let csr = decided_cards.my_cards[i]\n                .as_ref()\n                .map(|c| c.get_card_suit_rank());\n            let card_to_insert = csr.and_then(Card::create_card);\n            my_hand.insert_into_hand(&card_to_insert);\n        }\n        let total = RAZZ_CARD_IN_HAND_COUNT as usize;\n        let to_deal = total.saturating_sub(end);\n        for _ in 0..to_deal {\n            let dealt = deck.deal_from_deck();\n            my_hand.insert_into_hand(&dealt);\n        }\n    }\n\n    // ---------------- private helpers ----------------\n\n    use std::cell::Cell;\n    thread_local! {\n        static PREV_RANK: Cell<CardRank> = Cell::new(CardRank::InvalidRank);\n    }\n\n    fn duplicated_rank_remover(_len: u64, pos: u64, c: &Option<Card>) -> ItrAction {\n        let curr_rank = match c {\n            Some(card) => card.get_card_rank(),\n            None => return ItrAction::Continue,\n        };\n        if pos == 0 {\n            PREV_RANK.with(|r| r.set(curr_rank));\n            return ItrAction::Continue;\n        }\n        let prev = PREV_RANK.with(|r| r.get());\n        if prev == curr_rank {\n            return ItrAction::RemoveAndContinue;\n        }\n        PREV_RANK.with(|r| r.set(curr_rank));\n        ItrAction::Continue\n    }\n\n    fn length_trimmer(_len: u64, pos: u64, _c: &Option<Card>) -> ItrAction {\n        if pos >= 5 {\n            ItrAction::RemoveAndContinue\n        } else {\n            ItrAction::Continue\n        }\n    }\n\n    fn get_razz_rank(hand: &mut CardHand) -> CardRank {\n        // Reset PREV_RANK before iterating\n        PREV_RANK.with(|r| r.set(CardRank::InvalidRank));\n        hand.iterate_hand(duplicated_rank_remover);\n\n        let cards_count = hand.count_cards_in_hand();\n        if cards_count < 5 {\n            return CardRank::InvalidRank;\n        }\n\n        hand.iterate_hand(length_trimmer);\n        hand.get_max_rank_of_hand()\n    }\n}\n","structuredPatch":[{"oldStart":1,"oldLines":20,"newStart":1,"newLines":131,"lines":["-use crate::card::card::{Card, CardDeck, CardHand, CardRank};","+use crate::card::card::{","+    sort_card_by_rank, Card, CardDeck, CardHand, CardRank, ItrAction,","+};","+"," pub mod razz_simulation {","     use super::*;","+","     pub struct DecidedCards {","         pub my_card_count: u8,","         pub my_cards: [Option<Card>; 3],","         pub opponent_card_count: u8,","         pub opponent_cards: [Option<Card>; 7],","     }","+","     pub type RankListener<T> = fn(&mut T, CardRank);","-    pub fn simulate_razz_game<T>(decided_cards: &DecidedCards, game_count: u64, arg: &mut T, listener: RankListener<T>) -> i32 {","-        unimplemented!()","+","+    /// The number of cards each person is dealt in one round of Razz game.","+    const RAZZ_CARD_IN_HAND_COUNT: u8 = 7;","+","+    pub fn simulate_razz_game<T>(","+        decided_cards: &DecidedCards,","+        game_count: u64,","+        arg: &mut T,","+        listener: RankListener<T>,","+    ) -> i32 {","+        let mut my_hand = match CardHand::create_hand(RAZZ_CARD_IN_HAND_COUNT, sort_card_by_rank)","+        {","