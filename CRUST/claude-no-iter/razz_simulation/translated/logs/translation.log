assert (HEART_K < CLUB_K);\n101\t  assert (ACE < R3);\n102\t\n103\t  /* Card */\n104\t  c = create_card (SPADE_ACE);\n105\t  assert (c != NULL);\n106\t  assert (get_card_suit_rank (c) == SPADE_ACE);\n107\t  assert (get_card_rank (c) == ACE);\n108\t  assert (get_card_suit (c) == SPADE);\n109\t  destroy_card (&c);\n110\t  assert (c == NULL);\n111\t\n112\t  assert (c == NULL);\n113\t  destroy_card (&c);\n114\t  assert (c == NULL);\n115\t\n116\t  c = create_card (CARD_COUNT);\n117\t  assert (c == NULL);\n118\t\n119\t  c = create_card (CLUB_8);\n120\t  assert (c != NULL);\n121\t  assert (get_card_suit_rank (c) == CLUB_8);\n122\t  assert (get_card_rank (c) == R8);\n123\t  assert (get_card_suit (c) == CLUB);\n124\t  destroy_card (&c);\n125\t  assert (c == NULL);\n126\t\n127\t  c = strtocard (\"S8\");\n128\t  assert (c != NULL);\n129\t  assert (get_card_suit_rank (c) == SPADE_8);\n130\t  assert (get_card_rank (c) == R8);\n131\t  assert (get_card_suit (c) == SPADE);\n132\t  destroy_card (&c);\n133\t  assert (c == NULL);\n134\t\n135\t  c = strtocard (\"dk\");\n136\t  assert (c != NULL);\n137\t  assert (get_card_suit_rank (c) == DIAMOND_K);\n138\t  assert (get_card_rank (c) == K);\n139\t  assert (get_card_suit (c) == DIAMOND);\n140\t  destroy_card (&c);\n141\t  assert (c == NULL);\n142\t\n143\t  c = strtocard (\"Ca\");\n144\t  assert (c != NULL);\n145\t  assert (get_card_suit_rank (c) == CLUB_ACE);\n146\t  assert (get_card_rank (c) == ACE);\n147\t  assert (get_card_suit (c) == CLUB);\n148\t  destroy_card (&c);\n149\t  assert (c == NULL);\n150\t\n151\t  c = strtocard (\"hJ\");\n152\t  assert (c != NULL);\n153\t  assert (get_card_suit_rank (c) == HEART_J);\n154\t  assert (get_card_rank (c) == J);\n155\t  assert (get_card_suit (c) == HEART);\n156\t  destroy_card (&c);\n157\t  assert (c == NULL);\n158\t\n159\t  c = strtocard (\"SQ\");\n160\t  assert (c != NULL);\n161\t  assert (get_card_suit_rank (c) == SPADE_Q);\n162\t  assert (get_card_rank (c) == Q);\n163\t  assert (get_card_suit (c) == SPADE);\n164\t  destroy_card (&c);\n165\t  assert (c == NULL);\n166\t\n167\t  c = strtocard (\"SS\");\n168\t  assert (c == NULL);\n169\t  c = strtocard (\"S0\");\n170\t  assert (c == NULL);\n171\t  c = strtocard (\"S1\");\n172\t  assert (c == NULL);\n173\t  c = strtocard (\"a2\");\n174\t  assert (c == NULL);\n175\t\n176\t  /* Rank */\n177\t  assert (strtorank (\"ace\") == ACE);\n178\t  assert (strtorank (\"8\") == R8);\n179\t  assert (strtorank (\"K\") == K);\n180\t  assert (strtorank (\"10\") == R10);\n181\t  assert (strtorank (\"1\") == INVALID_RANK);\n182\t\n183\t  /* Card to string */\n184\t  assert (strcmp (cardtostr (SPADE_8), \"S8\") == 0);\n185\t  assert (strcmp (cardtostr (CLUB_10), \"C10\") == 0);\n186\t  assert (strcmp (cardtostr (SPADE_ACE), \"SA\") == 0);\n187\t  assert (strcmp (cardtostr (CLUB_K), \"CK\") == 0);\n188\t  assert (cardtostr (CARD_COUNT) == NULL);\n189\t\n190\t  /* Rank to string */\n191\t  assert (strcmp (ranktostr (R8), \"8\") == 0);\n192\t  assert (strcmp (ranktostr (R10), \"10\") == 0);\n193\t  assert (strcmp (ranktostr (ACE), \"A\") == 0);\n194\t  assert (strcmp (ranktostr (K), \"K\") == 0);\n195\t  assert (ranktostr (INVALID_RANK) == NULL);\n196\t\n197\t  /* Deck */\n198\t  srand48 (3);\n199\t  d = create_shuffled_deck ();\n200\t  assert (d != NULL);\n201\t  assert (is_card_in_deck (HEART_K, d));\n202\t  strip_card_from_deck (HEART_K, d);\n203\t  assert (!is_card_in_deck (HEART_K, d));\n204\t  strip_card_from_deck (HEART_9, d);\n205\t  assert (!is_card_in_deck (HEART_9, d));\n206\t  for (i = 1; i <= 50; i++)\n207\t    {\n208\t      c = deal_from_deck (d);\n209\t      assert (c != NULL);\n210\t      assert (!is_card_in_deck (get_card_suit_rank (c), d));\n211\t    }\n212\t  c = deal_from_deck (d);\n213\t  assert (c == NULL);\n214\t  destroy_deck (&d);\n215\t  assert (d == NULL);\n216\t\n217\t  /* Hand */\n218\t  srand48 (3);\n219\t  d = create_shuffled_deck ();\n220\t  assert (d != NULL);\n221\t  h = create_hand (7, sort_card_by_rank);\n222\t  assert (h != NULL);\n223\t  assert (count_cards_in_hand (h) == 0);\n224\t  assert (get_max_of_hand (h) == 7);\n225\t  assert (get_max_rank_of_hand (h) == INVALID_RANK);\n226\t\n227\t  insert_into_hand (h, deal_from_deck (d)); /* 1 */\n228\t  assert (count_cards_in_hand (h) == 1);\n229\t  assert (get_max_of_hand (h) == 7);\n230\t  assert (get_max_rank_of_hand (h) == R9);\n231\t  insert_into_hand (h, deal_from_deck (d)); /* 2 */\n232\t  assert (count_cards_in_hand (h) == 2);\n233\t  assert (get_max_of_hand (h) == 7);\n234\t  assert (get_max_rank_of_hand (h) == R9);\n235\t  insert_into_hand (h, deal_from_deck (d)); /* 3 */\n236\t  assert (count_cards_in_hand (h) == 3);\n237\t  assert (get_max_of_hand (h) == 7);\n238\t  assert (get_max_rank_of_hand (h) == R10);\n239\t  insert_into_hand (h, deal_from_deck (d)); /* 4 */\n240\t  assert (count_cards_in_hand (h) == 4);\n241\t  assert (get_max_of_hand (h) == 7);\n242\t  assert (get_max_rank_of_hand (h) == R10);\n243\t  insert_into_hand (h, deal_from_deck (d)); /* 5 */\n244\t  assert (count_cards_in_hand (h) == 5);\n245\t  assert (get_max_of_hand (h) == 7);\n246\t  assert (get_max_rank_of_hand (h) == R10);\n247\t  insert_into_hand (h, deal_from_deck (d)); /* 6 */\n248\t  assert (count_cards_in_hand (h) == 6);\n249\t  assert (get_max_of_hand (h) == 7);\n250\t  assert (get_max_rank_of_hand (h) == Q);\n251\t  insert_into_hand (h, deal_from_deck (d)); /* 7 */\n252\t  assert (count_cards_in_hand (h) == 7);\n253\t  assert (get_max_of_hand (h) == 7);\n254\t  assert (get_max_rank_of_hand (h) == Q);\n255\t  insert_into_hand (h, deal_from_deck (d)); /* 8 */\n256\t  assert (count_cards_in_hand (h) == 7);\n257\t  assert (get_max_of_hand (h) == 7);\n258\t  assert (get_max_rank_of_hand (h) == Q);\n259\t  iterate_hand (h, test_sort_card_by_rank_1);\n260\t\n261\t  remove_from_hand (h, DIAMOND_6);\n262\t  assert (count_cards_in_hand (h) == 6);\n263\t  assert (get_max_of_hand (h) == 7);\n264\t  assert (get_max_rank_of_hand (h) == Q);\n265\t  iterate_hand (h, test_sort_card_by_rank_2);\n266\t\n267\t  remove_from_hand (h, HEART_Q);\n268\t  assert (count_cards_in_hand (h) == 5);\n269\t  assert (get_max_of_hand (h) == 7);\n270\t  assert (get_max_rank_of_hand (h) == R10);\n271\t  iterate_hand (h, test_sort_card_by_rank_3);\n272\t\n273\t  reset_hand (h);\n274\t  assert (count_cards_in_hand (h) == 0);\n275\t  assert (get_max_of_hand (h) == 7);\n276\t  assert (get_max_rank_of_hand (h) == INVALID_RANK);\n277\t  remove_from_hand (h, HEART_Q);\n278\t  iterate_hand (h, test_empty_hand);\n279\t  \n280\t  destroy_hand (&h);\n281\t  assert (h == NULL);\n282\t  destroy_deck (&d);\n283\t  assert (d == NULL);\n284\t\n285\t  /* Hand with 1 card */\n286\t  srand48 (3);\n287\t  d = create_shuffled_deck ();\n288\t  assert (d != NULL);\n289\t  h = create_hand (1, sort_card_by_rank);\n290\t  assert (h != NULL);\n291\t\n292\t  insert_into_hand (h, deal_from_deck (d));\n293\t  assert (count_cards_in_hand (h) == 1);\n294\t  assert (get_max_of_hand (h) == 1);\n295\t  assert (get_max_rank_of_hand (h) == R9);\n296\t  remove_from_hand (h, HEART_Q);\n297\t  remove_from_hand (h, HEART_Q);\n298\t\n299\t  destroy_hand (&h);\n300\t  assert (h == NULL);\n301\t  destroy_deck (&d);\n302\t  assert (d == NULL);\n303\t\n304\t  /* Head removal */\n305\t  srand48 (3);\n306\t  d = create_shuffled_deck ();\n307\t  assert (d != NULL);\n308\t  h = create_hand (3, sort_card_by_rank);\n309\t  assert (h != NULL);\n310\t\n311\t  insert_into_hand (h, deal_from_deck (d));\n312\t  assert (get_max_rank_of_hand (h) == R9);\n313\t  insert_into_hand (h, deal_from_deck (d));\n314\t  assert (get_max_rank_of_hand (h) == R9);\n315\t  insert_into_hand (h, deal_from_deck (d));\n316\t  assert (get_max_rank_of_hand (h) == R10);\n317\t  remove_from_hand (h, SPADE_ACE);\n318\t  assert (get_max_rank_of_hand (h) == R10);\n319\t  iterate_hand (h, test_sort_card_by_rank_4);\n320\t  assert (count_cards_in_hand (h) == 2);\n321\t\n322\t  destroy_hand (&h);\n323\t  assert (h == NULL);\n324\t  destroy_deck (&d);\n325\t  assert (d == NULL);\n326\t\n327\t  /* Uniform distribution */\n328\t  unsigned long card_count[CARD_COUNT] = {0};\n329\t  unsigned long expected_card_count[] = {\n330\t    1001, 1012, 1032, 911, 1000, 987, 1026, 978, 971, 964, 942, 968, 1033,\n331\t    962, 1011, 939, 975, 1052, 1028, 1002, 992, 1054, 1004, 1045, 993, 984,\n332\t    1023, 960, 993, 1058, 998, 971, 1018, 1025, 1042, 1045, 983, 1018, 999,\n333\t    995, 1024, 999, 968, 1024, 986, 1015, 1036, 1015, 966, 973, 982, 1018,\n334\t  };\n335\t  srand48 (3);\n336\t  end = CARD_COUNT * 1000;\n337\t  for (i = 0; i < end; i++)\n338\t    {\n339\t      d = create_shuffled_deck ();\n340\t      assert (d != NULL);\n341\t      c = deal_from_deck (d);\n342\t      assert (c != NULL);\n343\t      card_count[get_card_suit_rank (c)]++;\n344\t      destroy_deck (&d);\n345\t      assert (d == NULL); \n346\t    }\n347\t  for (i = 0; i < CARD_COUNT; i++)\n348\t    {\n349\t      assert (card_count[i] == expected_card_count[i]);\n350\t    }\n351\t\n352\t  exit (EXIT_SUCCESS);\n353\t}\n354\t"}]},"parent_tool_use_id":null,"session_id":"cbaec3e1-2cab-4046-ba73-5f03818c4975","uuid":"765717d6-6191-4768-84b2-d6379df38b03","timestamp":"2026-06-03T05:20:29.669Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-vYfIVs/project/c_src/card_test.c","content":"/*****************************************************************************\n * Copyright (C) 2010 Tadeus Prastowo (eus@member.fsf.org)                   *\n *                                                                           *\n * This program is free software: you can redistribute it and/or modify      *\n * it under the terms of the GNU General Public License as published by      *\n * the Free Software Foundation, either version 3 of the License, or         *\n * (at your option) any later version.                                       *\n *                                                                           *\n * This program is distributed in the hope that it will be useful,           *\n * but WITHOUT ANY WARRANTY; without even the implied warranty of            *\n * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the             *\n * GNU General Public License for more details.                              *\n *                                                                           *\n * You should have received a copy of the GNU General Public License         *\n * along with this program.  If not, see <http://www.gnu.org/licenses/>.     *\n *****************************************************************************/\n\n#include <assert.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include \"card.h\"\n\nstatic enum card_suit_rank seed3_dealing_order[] = {\n  HEART_9, SPADE_ACE, HEART_10, CLUB_2, DIAMOND_6, HEART_Q, DIAMOND_2, DIAMOND_9,\n  HEART_7, CLUB_10, CLUB_4, DIAMOND_5, CLUB_K, SPADE_2, HEART_K, HEART_4,\n  DIAMOND_10, CLUB_Q, SPADE_5, SPADE_K, HEART_6, DIAMOND_J, SPADE_9, CLUB_ACE,\n  CLUB_5, DIAMOND_8, CLUB_9, HEART_2, SPADE_J, CLUB_7, DIAMOND_4, DIAMOND_K,\n  DIAMOND_Q, SPADE_8, SPADE_6, SPADE_7, SPADE_Q, HEART_8, HEART_J, DIAMOND_3,\n  DIAMOND_7, SPADE_3, HEART_3, CLUB_J, CLUB_6, HEART_ACE, CLUB_3, DIAMOND_ACE,\n  HEART_5, SPADE_4, SPADE_10, CLUB_8,\n};\n\nstatic enum itr_action\ntest_sort_card_by_rank_1 (unsigned long len, unsigned long pos, const card *c)\n{\n  static const enum card_suit_rank test_data[] = {\n    SPADE_ACE, DIAMOND_2, CLUB_2, DIAMOND_6, HEART_9, HEART_10, HEART_Q,\n  };\n\n  assert (get_card_suit_rank (c) == test_data[pos]);\n\n  return CONTINUE;\n}\n\nstatic enum itr_action\ntest_sort_card_by_rank_2 (unsigned long len, unsigned long pos, const card *c)\n{\n  static const enum card_suit_rank test_data[] = {\n    SPADE_ACE, DIAMOND_2, CLUB_2, HEART_9, HEART_10, HEART_Q,\n  };\n\n  assert (get_card_suit_rank (c) == test_data[pos]);\n\n  return CONTINUE;\n}\n\nstatic enum itr_action\ntest_sort_card_by_rank_3 (unsigned long len, unsigned long pos, const card *c)\n{\n  static const enum card_suit_rank test_data[] = {\n    SPADE_ACE, DIAMOND_2, CLUB_2, HEART_9, HEART_10\n  };\n\n  assert (get_card_suit_rank (c) == test_data[pos]);\n\n  return CONTINUE;\n}\n\nstatic enum itr_action\ntest_sort_card_by_rank_4 (unsigned long len, unsigned long pos, const card *c)\n{\n  static const enum card_suit_rank test_data[] = {\n    HEART_9, HEART_10\n  };\n\n  assert (get_card_suit_rank (c) == test_data[pos]);\n\n  return CONTINUE;\n}\n\nstatic enum itr_action\ntest_empty_hand (unsigned long len, unsigned long pos, const card *c)\n{\n  assert (0);\n\n  return CONTINUE;\n}\n\nint\nmain (int argc, char **argv, char **envp)\n{\n  int i;\n  int end;\n  const card *c;\n  card_deck *d;\n  card_hand *h;\n\n  /* Enum position */\n  assert (SPADE_ACE < SPADE_K);\n  assert (HEART_K < CLUB_K);\n  assert (ACE < R3);\n\n  /* Card */\n  c = create_card (SPADE_ACE);\n  assert (c != NULL);\n  assert (get_card_suit_rank (c) == SPADE_ACE);\n  assert (get_card_rank (c) == ACE);\n  assert (get_card_suit (c) == SPADE);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  assert (c == NULL);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  c = create_card (CARD_COUNT);\n  assert (c == NULL);\n\n  c = create_card (CLUB_8);\n  assert (c != NULL);\n  assert (get_card_suit_rank (c) == CLUB_8);\n  assert (get_card_rank (c) == R8);\n  assert (get_card_suit (c) == CLUB);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  c = strtocard (\"S8\");\n  assert (c != NULL);\n  assert (get_card_suit_rank (c) == SPADE_8);\n  assert (get_card_rank (c) == R8);\n  assert (get_card_suit (c) == SPADE);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  c = strtocard (\"dk\");\n  assert (c != NULL);\n  assert (get_card_suit_rank (c) == DIAMOND_K);\n  assert (get_card_rank (c) == K);\n  assert (get_card_suit (c) == DIAMOND);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  c = strtocard (\"Ca\");\n  assert (c != NULL);\n  assert (get_card_suit_rank (c) == CLUB_ACE);\n  assert (get_card_rank (c) == ACE);\n  assert (get_card_suit (c) == CLUB);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  c = strtocard (\"hJ\");\n  assert (c != NULL);\n  assert (get_card_suit_rank (c) == HEART_J);\n  assert (get_card_rank (c) == J);\n  assert (get_card_suit (c) == HEART);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  c = strtocard (\"SQ\");\n  assert (c != NULL);\n  assert (get_card_suit_rank (c) == SPADE_Q);\n  assert (get_card_rank (c) == Q);\n  assert (get_card_suit (c) == SPADE);\n  destroy_card (&c);\n  assert (c == NULL);\n\n  c = strtocard (\"SS\");\n  assert (c == NULL);\n  c = strtocard (\"S0\");\n  assert (c == NULL);\n  c = strtocard (\"S1\");\n  assert (c == NULL);\n  c = strtocard (\"a2\");\n  assert (c == NULL);\n\n  /* Rank */\n  assert (strtorank (\"ace\") == ACE);\n  assert (strtorank (\"8\") == R8);\n  assert (strtorank (\"K\") == K);\n  assert (strtorank (\"10\") == R10);\n  assert (strtorank (\"1\") == INVALID_RANK);\n\n  /* Card to string */\n  assert (strcmp (cardtostr (SPADE_8), \"S8\") == 0);\n  assert (strcmp (cardtostr (CLUB_10), \"C10\") == 0);\n  assert (strcmp (cardtostr (SPADE_ACE), \"SA\") == 0);\n  assert (strcmp (cardtostr (CLUB_K), \"CK\") == 0);\n  assert (cardtostr (CARD_COUNT) == NULL);\n\n  /* Rank to string */\n  assert (strcmp (ranktostr (R8), \"8\") == 0);\n  assert (strcmp (ranktostr (R10), \"10\") == 0);\n  assert (strcmp (ranktostr (ACE), \"A\") == 0);\n  assert (strcmp (ranktostr (K), \"K\") == 0);\n  assert (ranktostr (INVALID_RANK) == NULL);\n\n  /* Deck */\n  srand48 (3);\n  d = create_shuffled_deck ();\n  assert (d != NULL);\n  assert (is_card_in_deck (HEART_K, d));\n  strip_card_from_deck (HEART_K, d);\n  assert (!is_card_in_deck (HEART_K, d));\n  strip_card_from_deck (HEART_9, d);\n  assert (!is_card_in_deck (HEART_9, d));\n  for (i = 1; i <= 50; i++)\n    {\n      c = deal_from_deck (d);\n      assert (c != NULL);\n      assert