4\t            }\n55\t        }\n56\t        let end = decided_cards.opponent_card_count as usize;\n57\t        for i in 0..end {\n58\t            if let Some(c) = &decided_cards.opponent_cards[i] {\n59\t                deck.strip_card_from_deck(c.get_card_suit_rank());\n60\t            }\n61\t        }\n62\t    }\n63\t\n64\t    pub fn complete_hand(\n65\t        my_hand: &mut CardHand,\n66\t        decided_cards: &DecidedCards,\n67\t        deck: &mut CardDeck,\n68\t    ) {\n69\t        let end = decided_cards.my_card_count as usize;\n70\t        for i in 0..end {\n71\t            // Clone the predetermined card by reading its rank/suit and recreating it.\n72\t            let csr = decided_cards.my_cards[i]\n73\t                .as_ref()\n74\t                .map(|c| c.get_card_suit_rank());\n75\t            let card_to_insert = csr.and_then(Card::create_card);\n76\t            my_hand.insert_into_hand(&card_to_insert);\n77\t        }\n78\t        let total = RAZZ_CARD_IN_HAND_COUNT as usize;\n79\t        let to_deal = total.saturating_sub(end);\n80\t        for _ in 0..to_deal {\n81\t            let dealt = deck.deal_from_deck();\n82\t            my_hand.insert_into_hand(&dealt);\n83\t        }\n84\t    }\n85\t\n86\t    // ---------------- private helpers ----------------\n87\t\n88\t    use std::cell::Cell;\n89\t    thread_local! {\n90\t        static PREV_RANK: Cell<CardRank> = Cell::new(CardRank::InvalidRank);\n91\t    }\n92\t\n93\t    fn duplicated_rank_remover(_len: u64, pos: u64, c: &Option<Card>) -> ItrAction {\n94\t        let curr_rank = match c {\n95\t            Some(card) => card.get_card_rank(),\n96\t            None => return ItrAction::Continue,\n97\t        };\n98\t        if pos == 0 {\n99\t            PREV_RANK.with(|r| r.set(curr_rank));\n100\t            return ItrAction::Continue;\n101\t        }\n102\t        let prev = PREV_RANK.with(|r| r.get());\n103\t        if prev == curr_rank {\n104\t            return ItrAction::RemoveAndContinue;\n105