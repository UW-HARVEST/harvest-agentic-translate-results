{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_yplhy6mzuhffcesp2rxds3zrm47enbov7fcvljj4nvgf2igvqf2q","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01GnvV3xxaYzTvtrTUsixsSy","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-vYfIVs/project/src/razz_simulation.rs","content":"use crate::card::card::{\n    sort_card_by_rank, Card, CardDeck, CardHand, CardRank, ItrAction,\n};\n\npub mod razz_simulation {\n    use super::*;\n\n    pub struct DecidedCards {\n        pub my_card_count: u8,\n        pub my_cards: [Option<Card>; 3],\n        pub opponent_card_count: u8,\n        pub opponent_cards: [Option<Card>; 7],\n    }\n\n    pub type RankListener<T> = fn(&mut T, CardRank);\n\n    /// The number of cards each person is dealt in one round of Razz game.\n    const RAZZ_CARD_IN_HAND_COUNT: u8 = 7;\n\n    pub fn simulate_razz_game<T>(\n        decided_cards: &DecidedCards,\n        game_count: u64,\n        arg: &mut T,\n        listener: RankListener<T>,\n    ) -> i32 {\n        let mut my_hand = match CardHand::create_hand(RAZZ_CARD_IN_HAND_COUNT, sort_card_by_rank)\n        {\n            Some(h) => h,\n            None => {\n                return 1;\n            }\n        };\n\n        for _ in 0..game_count {\n            let mut deck = match CardDeck::create_shuffled_deck() {\n                Some(d) => d,\n                None => return 1,\n            };\n            strip_deck(&mut deck, decided_cards);\n            complete_hand(&mut my_hand, decided_cards, &mut deck);\n            let r = get_razz_rank(&mut my_hand);\n            listener(arg, r);\n            my_hand.reset_hand();\n        }\n\n        0\n    }\n\n    pub fn strip_deck(deck: &mut CardDeck, decided_cards: &DecidedCards) {\n        let end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            if let Some(c) = &decided_cards.my_cards[i] {\n                deck.strip_card_from_deck(c.get_card_suit_rank());\n            }\n        }\n        let end = decided_cards.opponent_card_count as usize;\n        for i in 0..end {\n            if let Some(c) = &decided_cards.opponent_cards[i] {\n                deck.strip_card_from_deck(c.get_card_suit_rank());\n            }\n        }\n    }\n\n    pub fn complete_hand(\n        my_hand: &mut CardHand,\n        decided_cards: &DecidedCards,\n        deck: &mut CardDeck,\n    ) {\n        let end = decided_cards.my_card_count as usize;\n        for i in 0..end {\n            // Clone the predetermined card by reading its rank/suit and recreating it.\n            let csr = decided_cards.my_cards[i]\n                .as_ref()\n                .map(|c| c.get_card_suit_rank());\n            let card_to_insert = csr.and_then(Card::create_card);\n            my_hand.insert_into_hand(&card_to_insert);\n        }\n        let total = RAZZ_CARD_IN_HAND_COUNT as usize;\n        let to_deal = total.saturating_sub(end);\n        for _ in 0..to_deal {\n            let dealt = deck.deal_from_deck();\n            my_hand.insert_into_hand(&dealt);\n        }\n    }\n\n    // ---------------- private helpers ----------------\n\n    use std::cell::Cell;\n    thread_local! {\n        static PREV_RANK: Cell<CardRank> = Cell::new(CardRank::InvalidRank);\n    }\n\n    fn duplicated_rank_remover(_len: u64, pos: u64, c: &Option<Card>) -> ItrAction {\n        let curr_rank = match c {\n            Some(card) => card.get_card_rank(),\n            None => return ItrAction::Continue,\n        };\n        if pos == 0 {\n            PREV_RANK.with(|r| r.set(curr_rank));\n            return ItrAction::Continue;\n        }\n        let prev = PREV_RANK.with(|r| r.get());\n        if prev == curr_rank {\n            return ItrAction::RemoveAndContinue;\n        }\n        PREV_RANK.with(|r| r.set(curr_rank));\n        ItrAction::Continue\n    }\n\n    fn length_trimmer(_len: u64, pos: u64, _c: &Option<Card>) -> ItrAction {\n        if pos >= 5 {\n            ItrAction::RemoveAndContinue\n        } else {\n            ItrAction::Continue\n        }\n    }\n\n    fn get_razz_rank(hand: &mut CardHand) -> CardRank {\n        // Reset PREV_RANK before iterating\n        PREV_RANK.with(|r| r.set(CardRank::InvalidRank));\n        hand.iterate_hand(duplicated_rank_remover);\n\n        let cards_count = hand.count_cards_in_hand();\n        if cards_count < 5 {\n            return CardRank::InvalidRank;\n        }\n\n        hand.iterate_hand(length_trimmer);\n        hand.get_max_rank_of_hand()\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":761,"cache_read_input_tokens":78206,"cache_creation":{"ephemeral_5m_input_tokens":761,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"cbaec3e1-2cab-4046-ba73-5f03818c4975","uuid":"409594cf-d597-40fc-ab9b-3d6d7be8520d"}
