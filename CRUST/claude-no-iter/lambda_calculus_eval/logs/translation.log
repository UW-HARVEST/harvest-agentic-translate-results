{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018v66pKfmfnRhr8QhXUpXxR","type":"tool_result","content":"1\t#include \"reducer.h\"\n2\t#include \"common.h\"\n3\t#include \"../hash-table/hash_table.h\"\n4\t#include <stdarg.h>\n5\t#include \"config.h\"\n6\t\n7\tstatic reduction_order_t reduction_order = APPLICATIVE;\n8\t\n9\tvoid set_reduction_order(reduction_order_t t) {\n10\t  reduction_order = t;\n11\t}\n12\t\n13\tvoid print_reduction_order(reduction_order_t t) {\n14\t  switch (t) {\n15\t    case APPLICATIVE:\n16\t      printf(\"Applicative\");\n17\t      break;\n18\t    case NORMAL:\n19\t      printf(\"Normal\");\n20\t      break;\n21\t  }\n22\t  printf(\"\\n\");\n23\t}\n24\t\n25\tAstNode *reduce(HashTable *table, AstNode *n) {\n26\t  print_verbose(\"Order of reduction is: \");\n27\t  print_reduction_order(reduction_order);\n28\t  print_verbose(\"-------------------------------------------\\n\");\n29\t  expand_definitions(table, n);\n30\t  print_verbose(\"Expanded expression:\\n\");\n31\t  print_ast_verbose(n);\n32\t  AstNode *reduced = reduce_ast(table, n);\n33\t  print_verbose(\"Final reduced expression:\\n\");\n34\t  print_ast_verbose(reduced);\n35\t  print_verbose(\"-------------------------------------------\\n\");\n36\t  return reduced;\n37\t}\n38\t\n39\tvoid expand_definitions(HashTable *table, AstNode *n) {\n40\t  if (n->type == LAMBDA_EXPR) {\n41\t    expand_definitions(table, n->node.lambda_expr->body);\n42\t  } else if (n->type == APPLICATION) {\n43\t    expand_definitions(table, n->node.application->function);\n44\t    expand_definitions(table, n->node.application->argument);\n45\t  } else if (n->type == DEFINITION) {\n46\t    char *def_name = n->node.variable->name;\n47\t    AstNode *expanded_def = search(table, def_name);\n48\t    HANDLE_NULL(expanded_def);\n49\t    print_verbose(\"Expanding definition of: %s . Term expanded to:\\n\", def_name);\n50\t    print_ast_verbose(expanded_def);\n51\t\n52\t    n->type = expanded