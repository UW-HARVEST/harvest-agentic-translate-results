py(var->buf + var->size, string, strlen(string));\t\t\\\n60\t\t\t\tvar->size += strlen(string);\t\t\t\t\t\\\n61\t\t\t} while(0)\n62\t\n63\t#define APPEND(var, ...)\t\t\t\\\n64\t\t\tdo {\t\t\t\t\t\t\\\n65\t\t\t\tchar *tmp = malloc(10000);\t\t\t\\\n66\t\t\t\tsprintf(tmp, __VA_ARGS__);\t\t\t\\\n67\t\t\t\tAPPEND_STRING(var,tmp);\t\t\t\\\n68\t\t\t\tfree(tmp);\t\t\t\t\t\\\n69\t\t\t} while(0)\n70\t\n71\t// prototypes\n72\tstatic RC attrOffset (Schema *schema, int attrNum, int *result);\n73\t\n74\t// implementations\n75\tchar *\n76\tserializeTableInfo(RM_TableData *rel)\n77\t{\n78\t\tVarString *result;\n79\t\tMAKE_VARSTRING(result);\n80\t\n81\t\tAPPEND(result, \"TABLE <%s> with <%i> tuples:\\n\", rel->name, getNumTuples(rel));\n82\t\tAPPEND_STRING(result, serializeSchema(rel->schema));\n83\t\n84\t\tRETURN_STRING(result);\n85\t}\n86\t\n87\t\n88\tchar * \n89\tserializeTableContent(RM_TableData *rel)\n90\t{\n91\t\tint i;\n92\t\tVarString *result;\n93\t\tRM_ScanHandle *sc = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n94\t\tRecord *r = (Record *) malloc(sizeof(Record));\n95\t\tMAKE_VARSTRING(result);\n96\t\n97\t\tfor(i = 0; i < rel->schema->numAttr; i++)\n98\t\t\tAPPEND(result, \"%s%s\", (i != 0) ? \", \" : \"\", rel->schema->attrNames[i]);\n99\t\n100\t\tstartScan(rel, sc, NULL);\n101\t\n102\t\twhile(next(sc, r) != RC_RM_NO_MORE_TUPLES)\n103\t\t{\n104\t\t\tAPPEND_STRING(result,serializeRecord(r, rel->schema));\n105\t\t\tAPPEND_STRING(result,\"\\n\");\n106\t\t}\n107\t\tcloseScan(sc);\n108\t\n109\t\tRETURN_STRING(result);\n110\t}\n111\t\n112\t\n113\t\n114\tchar * \n115\tserializeSchema(Schema *schema)\n116\t{\n117\t\tint i;\n118\t\tVarString *result;\n119\t\tMAKE_VARSTRING(result);\n120\t\n121\t\tAPPEND(result, \"Schema with <%i> attributes (\", schema->numAttr);\n122\t\n123\t\tfor(i = 0; i < schema->numAttr; i++)\n124\t\t{\n125\t\t\tAPPEND(result,\"%s%s: \", (i != 0) ? \", \": \"\", schema->attrNames[i]);\n126\t\t\tswitch (schema->dataTypes[i])\n127\t\t\t{\n128\t\t\tcase DT