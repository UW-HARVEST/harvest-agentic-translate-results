ght, result);\t\t\t\t\\\n45\t\t\t\tbool b = result->v.boolV;\t\t\t\t\\\n46\t\t\t\tfree(result);\t\t\t\t\t\\\n47\t\t\t\tASSERT_TRUE(b,message);\t\t\t\t\\\n48\t\t\t} while (0)\n49\t\n50\t// test methods\n51\tstatic void testRecords (void);\n52\tstatic void testCreateTableAndInsert (void);\n53\tstatic void testUpdateTable (void);\n54\tstatic void testScans (void);\n55\tstatic void testScansTwo (void);\n56\tstatic void testInsertManyRecords(void);\n57\tstatic void testMultipleScans(void);\n58\t\n59\t// struct for test records\n60\ttypedef struct TestRecord {\n61\t\tint a;\n62\t\tchar *b;\n63\t\tint c;\n64\t} TestRecord;\n65\t\n66\t// helper methods\n67\tRecord *testRecord(Schema *schema, int a, char *b, int c);\n68\tSchema *testSchema (void);\n69\tRecord *fromTestRecord (Schema *schema, TestRecord in);\n70\t\n71\t// test name\n72\tchar *testName;\n73\t\n74\t// main method\n75\tint \n76\tmain (void) \n77\t{\n78\t\ttestName = \"\";\n79\t\n80\t\ttestInsertManyRecords();\n81\t\ttestRecords();\n82\t\ttestCreateTableAndInsert();\n83\t\ttestUpdateTable();\n84\t\ttestScans();\n85\t\ttestScansTwo();\n86\t\ttestMultipleScans();\n87\t  \tprintf(\"\\033[1;32mSuccessfully All Tests Completed!\\033[0m\\n\");\n88\t\n89\t\treturn 0;\n90\t}\n91\t\n92\t// ************************************************************ \n93\tvoid\n94\ttestRecords (void)\n95\t{\n96\t\tTestRecord expected[] = {\n97\t\t\t\t{1, \"aaaa\", 3},\n98\t\t};\n99\t\tSchema *schema;\n100\t\tRecord *r;\n101\t\tValue *value;\n102\t\ttestName = \"test creating records and manipulating attributes\";\n103\t\n104\t\t// check attributes of created record\n105\t\tschema = testSchema();\n106\t\tr = fromTestRecord(schema, expected[0]);\n107\t\n108\t\tgetAttr(r, schema, 0, &value);\n109\t\tOP_TRUE(stringToValue(\"i1\"), value, valueEquals, \"first attr\");\n110\t\tfreeVal(value);\n111\t\n112\t\tgetAttr(r, schema, 1, &value);\n113\t\tOP_TRUE(stringToValue(\"saaaa\"), value, valueEquals, \"second attr\");\n114\t\tfreeVal(value);\n115\t\n116\t\tgetAttr(r, schema, 2, &value);\n117\t\tOP_TRUE(stringToValue(\"i3\"), value, valueEquals, \"third attr\");\n118\t\tfreeVal(value);\n119\t\n120\t\t//modify attrs\n121\t\tsetAttr(r, schema, 2, stringToValue(\"i4\"));\n122\t\tgetAttr(r, schema, 2, &value);\n123\t\tOP_TRUE(stringToValue(\"i4\"), value, valueEquals, \"third attr after setting\");\n124\t\tfreeVal(value);\n125\t\n126\t\tfreeRecord(r);\n127\t    freeSchema(schema);   // added Summer 2021\n128\t\tTEST_DONE();\n129\t}\n130\t\n131\t// ************************************************************ \n132\tvoid\n133\ttestCreateTableAndInsert (void)\n134\t{\n135\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n136\t\tTestRecord inserts[] = {\n137\t\t\t\t{1, \"aaaa\", 3},\n138\t\t\t\t{2, \"bbbb\", 2},\n139\t\t\t\t{3, \"cccc\", 1},\n140\t\t\t\t{4, \"dddd\", 3},\n141\t\t\t\t{5, \"eeee\", 5},\n142\t\t\t\t{6, \"ffff\", 1},\n143\t\t\t\t{7, \"gggg\", 3},\n144\t\t\t\t{8, \"hhhh\", 3},\n145\t\t\t\t{9, \"iiii\", 2}\n146\t\t};\n147\t\tint numInserts = 9, i;\n148\t\tRecord *r;\n149\t\tRID *rids;\n150\t\tSchema *schema;\n151\t\ttestName = \"test creating a new table and inserting tuples\";\n152\t\tschema = testSchema();\n153\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n154\t\n155\t\tTEST_CHECK(initRecordManager(NULL));\n156\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n157\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n158\t\n159\t\t// insert rows into table\n160\t\tfor(i = 0; i < numInserts; i++)\n161\t    {\n162\t\t\tr = fromTestRecord(schema, inserts[i]);\n163\t\t\tTEST_CHECK(insertRecord(table,r));\n164\t\t\trids[i] = r->id;\n165\t        freeRecord(r);    // added Fall 2021\n166\t    }\n167\t\n168\t\tTEST_CHECK(closeTable(table));\n169\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n170\t\n171\t\t// randomly retrieve records from the table and compare to inserted ones\n172\t\tfor(i = 0; i < 1000; i++)\n173\t\t{   TEST_CHECK(createRecord(&r, schema));  // added Fall 2021\n174\t\t\tint pos = rand() % numInserts;\n175\t\t\tRID rid = rids[pos];\n176\t\t\tTEST_CHECK(getRecord(table, rid, r));\n177\t\t\tASSERT_EQUALS_RECORDS(fromTestRecord(schema, inserts[pos]), r, schema, \"compare records\");\n178\t        freeRecord (r);  // Added: Summer 2021\n179\t\t}\n180\t\n181\t\tTEST_CHECK(closeTable(table));\n182\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n183\t\tTEST_CHECK(shutdownRecordManager());\n184\t\n185\t\tfree(rids);\n186\t\tfree(table);\n187\t    freeSchema(schema);   // Added: Summer 2021\n188\t\tTEST_DONE();\n189\t}\n190\t\n191\tvoid\n192\ttestMultipleScans(void)\n193\t{\n194\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n195\t\tTestRecord inserts[] = {\n196\t\t\t\t{1, \"aaaa\", 3},\n197\t\t\t\t{2, \"bbbb\", 2},\n198\t\t\t\t{3, \"cccc\", 1},\n199\t\t\t\t{4, \"dddd\", 3},\n200\t\t\t\t{5, \"eeee\", 5},\n201\t\t\t\t{6, \"ffff\", 1},\n202\t\t\t\t{7, \"gggg\", 3},\n203\t\t\t\t{8, \"hhhh\", 3},\n204\t\t\t\t{9, \"iiii\", 2},\n205\t\t\t\t{10, \"jjjj\", 5},\n206\t\t};\n207\t\tint numInserts = 10, i, scanOne=0, scanTwo=0;\n208\t\tRecord *r;\n209\t\tRID *rids;\n210\t\tSchema *schema;\n211\t\ttestName = \"test running muliple scans \";\n212\t\tschema = testSchema();\n213\t\trids = (RID *) malloc(sizeof(RID) * numInserts);\n214\t\tRM_ScanHandle *sc1 = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n215\t\tRM_ScanHandle *sc2 = (RM_ScanHandle *) malloc(sizeof(RM_ScanHandle));\n216\t\tExpr *se1, *left, *right;\n217\t\tint rc,rc2;\n218\t\n219\t\tTEST_CHECK(initRecordManager(NULL));\n220\t\tTEST_CHECK(createTable(\"test_table_r\",schema));\n221\t\tTEST_CHECK(openTable(table, \"test_table_r\"));\n222\t\n223\t\t// insert rows into table\n224\t\tfor(i = 0; i < numInserts; i++)\n225\t\t{\n226\t\t\tr = fromTestRecord(schema, inserts[i]);\n227\t\t\tTEST_CHECK(insertRecord(table,r));\n228\t\t\trids[i] = r->id;\n229\t        freeRecord(r);  // Added: Summer 2021\n230\t\t}\n231\t\n232\t\t// Mix 2 scans with c=3 as condition\n233\t\tMAKE_CONS(left, stringToValue(\"i3\"));\n234\t\tMAKE_ATTRREF(right, 2);\n235\t\tMAKE_BINOP_EXPR(se1, left, right, OP_COMP_EQUAL);\n236\t\tcreateRecord(&r, schema);\n237\t\tTEST_CHECK(startScan(table, sc1, se1));\n238\t\tTEST_CHECK(startScan(table, sc2, se1));\n239\t\tif ((rc2 = next(sc2, r)) == RC_OK)\n240\t\t\tscanTwo++;\n241\t\ti = 0;\n242\t\twhile((rc = next(sc1, r)) == RC_OK)\n243\t\t{\n244\t\t\tscanOne++;\n245\t\t\ti++;\n246\t\t\tif (i % 3 == 0)\n247\t\t\t\tif ((rc2 = next(sc2, r)) == RC_OK)\n248\t\t\t\t\tscanTwo++;\n249\t\t}\n250\t\twhile((rc2 = next(sc2, r)) == RC_OK)\n251\t\t\tscanTwo++;\n252\t\n253\t\tASSERT_TRUE(scanOne == scanTwo, \"scans returned same number of tuples\");\n254\t\tif (rc != RC_RM_NO_MORE_TUPLES)\n255\t\t\tTEST_CHECK(rc);\n256\t\tTEST_CHECK(closeScan(sc1));\n257\t\tTEST_CHECK(closeScan(sc2));\n258\t\n259\t\tTEST_CHECK(closeTable(table));\n260\t\tTEST_CHECK(deleteTable(\"test_table_r\"));\n261\t\tTEST_CHECK(shutdownRecordManager());\n262\t\n263\t\tfree(rids);\n264\t\tfree(table);\n265\t// ****** Added Summer 2021\n266\t    freeRecord(r);\n267\t    free(sc1);\n268\t    free(sc2);\n269\t    freeExpr(se1);\n270\t    freeSchema(schema);\n271\t// *******\n272\t\tTEST_DONE();\n273\t}\n274\t\n275\tvoid \n276\ttestUpdateTable (void)\n277\t{\n278\t\tRM_TableData *table = (RM_TableData *) malloc(sizeof(RM_TableData));\n279\t\tTestRecord inserts[] = {\n280\t\t\t\t{1, \"aaaa\", 3},\n281\t\t\t\t{2, \"bbbb\", 2},\n282\t\t\t\t{3, \"cccc\", 1},\n283\t\t\t\t{4, \"dddd\", 3},\n284\t\t\t\t{5, \"eeee\", 5},\n285\t\t\t\t{6, \"ffff\", 1},\n286\t\t\t\t{7, \"gggg\", 3},\n287\t\t\t\t{8, \"hhhh\", 3},\n288\t\t\t\t{9, \"iiii\", 2},\n289\t\t\t\t{10, \"jjjj\", 5},\n290\t\t};\n291\t\tTestRecord updates[] = {\n292\t\t\t\t{1, \"iiii\", 6},\n293\t\t\t\t{2, \"iiii\", 6},\n294\t\t\t\t{3, \"iiii\", 6}\n295\t\t};\n296\t\tint deletes[] = {\n297\t\t\t\t9,\n298\t\t\t\t6,\n299\t\t\t\t7,\n300\t\t\t\t8,\n301\t\t\t\t5\n302\t\t};\n303\t\tTestRecord finalR[] = {\n304\t\t\t\t{