ey\".to_string(),\n63\t                    val: 10.into(),\n64\t                }],\n65\t                count: 1,\n66\t                capacity: TEST_CAPACITY,\n67\t            }),\n68\t        ),\n69\t        (\n70\t            \"key: -1\",\n71\t            Ok(Cfg {\n72\t                entries: vec![CfgEntry {\n73\t                    key: \"key\".to_string(),\n74\t                    val: (-1).into(),\n75\t                }],\n76\t                count: 1,\n77\t                capacity: TEST_CAPACITY,\n78\t            }),\n79\t        ),\n80\t        (\n81\t            \"key: true\",\n82\t            Ok(Cfg {\n83\t                entries: vec![CfgEntry {\n84\t                    key: \"key\".to_string(),\n85\t                    val: true.into(),\n86\t                }],\n87\t                count: 1,\n88\t                capacity: TEST_CAPACITY,\n89\t            }),\n90\t        ),\n91\t        (\n92\t            \"key: false\",\n93\t            Ok(Cfg {\n94\t                entries: vec![CfgEntry {\n95\t                    key: \"key\".to_string(),\n96\t                    val: false.into(),\n97\t                }],\n98\t                count: 1,\n99\t                capacity: TEST_CAPACITY,\n100\t            }),\n101\t        ),\n102\t        (\n103\t            \"key: rgba(255, 255, 255, 0.5)\",\n104\t            Ok(Cfg {\n105\t                entries: vec![CfgEntry {\n106\t                    key: \"key\".to_string(),\n107\t                    val: CfgVal::Color(CfgColor {\n108\t                        r: 255,\n109\t                        g: 255,\n110\t                        b: 255,\n111\t                        a: 128,\n112\t                    }),\n113\t                }],\n114\t                count: 1,\n115\t                capacity: TEST_CAPACITY,\n116\t            }),\n117\t        ),\n118\t        (\n119\t            \"key: 0.5\",\n120\t            Ok(Cfg {\n121\t                entries: vec![CfgEntry {\n122\t                    key: \"key\".to_str