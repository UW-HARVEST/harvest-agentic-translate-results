 '\\'';\n457\t        break;\n458\t    }\n459\t    return co;\n460\t}\n461\t\n462\tvoid lexer_pop_token()\n463\t{\n464\t    vector_pop(lex_process->token_vec);\n465\t}\n466\t\n467\tbool is_hex_char(char c)\n468\t{\n469\t     c = tolower(c);\n470\t    return (c>='0' && c<='9') || (c>='a' && c<='f');\n471\t}\n472\t\n473\tconst char* read_hex_number_str()\n474\t{\n475\t    struct buffer* buffer = buffer_create();\n476\t    char c = peekc(); \n477\t    LEX_GETC_IF(buffer,c,is_hex_char(c));\n478\t    buffer_write(buffer,0x00);\n479\t    return buffer_ptr(buffer);\n480\t}\n481\t\n482\tstruct token* token_make_special_number_hexadecimal()\n483\t{\n484\t    //skip the x\n485\t    nextc();\n486\t    unsigned long number = 0;\n487\t    const char* number_str = read_hex_number_str();\n488\t    number = strtol(number_str,0,16);\n489\t    return token_make_number_for_value(number);\n490\t}\n491\t\n492\tvoid lexer_validate_binary_string(const char* str)\n493\t{\n494\t    size_t len = strlen(str);\n495\t    for(int i=0;i<len;i++)\n496\t    {\n497\t        if(str[i]!='0' && str[i]!='1')\n498\t        {\n499\t            compiler_error(lex_process->compiler,\"Invalid Binary number\\n\");\n500\t        }\n501\t    }\n502\t}\n503\tstruct token* token_make_special_number_binary()\n504\t{\n505\t    //skip the b\n506\t    nextc();\n507\t    unsigned long number = 0;\n508\t    const char* number_str = read_number_str();\n509\t    lexer_validate_binary_string(number_str);\n510\t    number = strtol(number_str,0,2);\n511\t\n512\t    return token_make_number_for_value(number);\n513\t}\n514\tstruct token* token_make_special_number()\n515\t{\n516\t     struct token* token =NULL;\n517\t     struct token* last_token = lexer_last_token(); \n518\t    if(!last_token || !(last_token->type=TOKEN_TYPE_NUMBER && last_token->llnum == 0))\n519\t    {\n520\t        return token_make_identifier_or_keyword();\n521\t    }\n522\t     lexer_pop_token();\n523\t     char c = peekc();\n524\t     if(c == 'x')\n525\