\n53\t * force arg is used to force number to one type:\n54\t *   0 -> no force, 1 -> force ratio/int, 2 -> force decimal */\n55\tstatic Val\n56\t(*mk_num(TspType a, TspType b, int force))(double, double)\n57\t{\n58\t\tif (force == 1)\n59\t\t\treturn &create_rat;\n60\t\tif (force == 2)\n61\t\t\treturn &create_dec;\n62\t\tif (a & TSP_DEC || b & TSP_DEC)\n63\t\t\treturn &create_dec;\n64\t\tif (a & TSP_RATIO || b & TSP_RATIO)\n65\t\t\treturn &create_rat;\n66\t\treturn &create_int;\n67\t}\n68\t\n69\t#define PRIM_ROUND(NAME, FORCE)                                      \\\n70\tstatic Val                                                           \\\n71\tprim_##NAME(Tsp st, Rec vars, Val args)                              \\\n72\t{                                                                    \\\n73\t\tVal n;                                                       \\\n74\t\ttsp_arg_num(args, #NAME, 1);                                 \\\n75\t\tn = car(args);                                               \\\n76\t\ttsp_arg_type(n, #NAME, TSP_NUM);                             \\\n77\t\treturn (mk_num(n->t, n->t, FORCE))(NAME(num(n)/den(n)), 1.); \\\n78\t}\n79\t\n80\t/* define int and dec as identity functions to use them in the same macro */\n81\t#define Int(X) (X)\n82\t#define Dec(X) (X)\n83\tPRIM_ROUND(Int,   1)\n84\tPRIM_ROUND(Dec,   2)\n85\t#undef Int\n86\t#undef Dec\n87\tPRIM_ROUND(round, 0)\n88\tPRIM_ROUND(floor, 0)\n89\tPRIM_ROUND(ceil,  0)\n90\t\n91\tstatic Val\n92\tprim_add(Tsp st, Rec vars, Val args)\n93\t{\n94\t\tVal a, b;\n95\t\ttsp_arg_num(args, \"+\", 2);\n96\t\ta = car(args), b = cadr(args);\n97\t\ttsp_arg_type(a, \"+\", TSP_NUM);\n98\t\ttsp_arg_type(b, \"+\", TSP_NUM);\n99\t\tif (a->t & TSP_DEC || b->t & TSP_DEC)\n100\t\t\treturn mk_dec((num(a)/den(a)) + (num(b)/den(b)));\n101\t\treturn (mk_num(a->t, b->t, 0))\n102\t\t\t(num(a) * den(b) + den(a) * num(b),\n103\t\t\t den(a) * den(b));\n104\t}\n105\t\n106\tstatic Val\n107\tprim_sub(Tsp st, Rec vars, Val args)\