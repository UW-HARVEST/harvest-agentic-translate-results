\n108\t\n109\t\t/* increment argument counter if we aren't\n110\t\t\t instructed to check argv[0] */\n111\t\tif (!(ctx->flags & XOPT_CTX_KEEPFIRST)) {\n112\t\t\t++argi;\n113\t\t}\n114\t\n115\t\t/* iterate over passed command line arguments */\n116\t\tfor (; argi < argc; argi++) {\n117\t\t\t/* parse, breaking if there was a failure\n118\t\t\t\t parseResult is true if extra, false if option */\n119\t\t\tparseResult = _xopt_parse_arg(ctx, argc, argv, &argi, data, err);\n120\t\t\tif (*err) {\n121\t\t\t\tbreak;\n122\t\t\t}\n123\t\n124\t\t\t/* is the argument an extra? */\n125\t\t\tif (parseResult) {\n126\t\t\t\t/* make sure we have enough room, or realloc if we don't -\n127\t\t\t\t\t check that it succeeded */\n128\t\t\t\t_xopt_assert_increment(&extras, extrasCount, &extrasCapac, err);\n129\t\t\t\tif (*err) {\n130\t\t\t\t\tbreak;\n131\t\t\t\t}\n132\t\n133\t\t\t\t/* add extra to list */\n134\t\t\t\textras[extrasCount++] = argv[argi];\n135\t\t\t} else {\n136\t\t\t\t/* make sure we're super-posix'd if specified to be\n137\t\t\t\t\t (check that no extras have been specified when an option is parsed,\n138\t\t\t\t\t enforcing options to be specific before [extra] arguments */\n139\t\t\t\tif ((ctx->flags & XOPT_CTX_POSIXMEHARDER) && extrasCount) {\n140\t\t\t\t\t_xopt_set_err(err, \"options cannot be specified after arguments: %s\",\n141\t\t\t\t\t\t\targv[argi]);\n142\t\t\t\t\tbreak;\n143\t\t\t\t}\n144\t\t\t}\n145\t\t}\n146\t\n147\tend:\n148\t\tif (!*err) {\n149\t\t\t/* append null terminator to extras */\n150\t\t\t_xopt_assert_increment(&extras, extrasCount, &extrasCapac, err);\n151\t\t\tif (!*err) {\n152\t\t\t\textras[extrasCount] = 0;\n153\t\t\t}\n154\t\t}\n155\t\n156\t\tif (*err) {\n157\t\t\tfree(extras);\n158\t\t\t*inextras = 0;\n159\t\t\treturn 0;\n160\t\t}\n161\t\n162\t\t*inextras = extras;\n163\t\treturn extrasCount;\n164\t}\n165\t\n166\tvoid xopt_autohelp(xoptContext *ctx, FILE *stream, const xoptAutohelpOptions *options,\n167\t\t\tconst char **err) {\n168\t\tconst xopt