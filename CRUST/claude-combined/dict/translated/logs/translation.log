efault:\n405\t                {\n406\t                    fprintf( stderr, \"[ERRO]: illegal type.\\n\" );\n407\t                    exit(1);\n408\t                }\n409\t            }\n410\t        }\n411\t    }\n412\t\n413\t    // doesn't already appear in the list\n414\t    dict_elem_t* elem = dict->alloc.malloc( sizeof (dict_elem_t) + dict->key.size + dict->val.size );\n415\t    ASSERT_MEM( elem );\n416\t    *elem = (dict_elem_t)\n417\t    {\n418\t        .code   = code,\n419\t        .prev   = dict->list[ index ].tail,\n420\t    };\n421\t    memcpy( elem->key, key, dict->key.size );\n422\t    memset( elem->key + dict->key.size, 0, dict->val.size );\n423\t    if ( dict->list[ index ].size == 0 )\n424\t    {\n425\t        dict->list[ index ].head = dict->list[ index ].tail = elem;\n426\t    }\n427\t    else\n428\t    {\n429\t        dict->list[ index ].tail->next = elem;\n430\t        dict->list[ index ].tail = elem;\n431\t    }\n432\t    if ( dict->list[ index ].size++ > dict->mod )\n433\t    {\n434\t        if ( dict_reshape( dict, 1 ) == false )\n435\t        {\n436\t            return NULL;\n437\t        }\n438\t    }\n439\t    return elem->key + dict->key.size;\n440\t}\n441\t\n442\t\n443\tbool dict_remove( dict_t* restrict dict, ... )\n444\t{\n445\t    va_list ap;\n446\t    va_start( ap, dict );\n447\t\n448\t    // get the key\n449\t    void* key = dict_get_key( dict, ap );\n450\t\n451\t    va_end(ap);\n452\t\n453\t    // get hash code\n454\t    uint64_t code = dict_get_hash( dict, key );\n455\t\n456\t    // get into the linked list\n457\t    size_t index = code % dict->mod;\n458\t    for ( dict_elem_t* curr = dict->list[ index ].head; curr != NULL; curr = curr->next )\n459\t    {\n460\t        if ( curr->code != code ) continue;\n461\t        if ( dict->key.cmpr != NULL )\n462\t        {\n463\t            if ( dict->key.cmpr( curr->key, key ) == 0 )\n464\t            {\n465\t                // redirect node\n466\t                dict_free_key( dict, key );