{\n163\t                    code = ( code * HASH_BASE + ( *(char**) key )[i] ) % HASH_MOD;\n164\t                }\n165\t                break;\n166\t            case DICT_STRUCT:\n167\t                length = dict->key.size;\n168\t                for ( size_t i = 0; i < length; i++ )\n169\t                {\n170\t                    code = ( code * HASH_BASE + ( (char*) key )[i] ) % HASH_MOD;\n171\t                }\n172\t                break;\n173\t            default:\n174\t            {\n175\t                fprintf( stderr, \"[ERRO]: illegal type.\\n\" );\n176\t                exit(1);\n177\t            }\n178\t        }\n179\t    }\n180\t    return code;\n181\t}\n182\t\n183\t\n184\tstatic inline void dict_free_key( const dict_t* restrict dict, void* restrict key )\n185\t{\n186\t    if ( dict->key.copy != NULL && dict->key.free != NULL )\n187\t    {\n188\t        dict->key.free( key );\n189\t    }\n190\t    else if ( dict->key.type == DICT_STR )\n191\t    {\n192\t        dict->alloc.free( *(char**) key );\n193\t    }\n194\t}\n195\t\n196\t\n197\tstatic inline void dict_free_val( const dict_t* restrict dict, void* restrict val )\n198\t{\n199\t    if ( dict->val.free != NULL )\n200\t    {\n201\t        dict->val.free( val );\n202\t    }\n203\t}\n204\t\n205\t\n206\tstatic inline void dict_free_node( const dict_t* restrict dict, dict_elem_t* restrict node )\n207\t{\n208\t    if ( dict->alloc.free != NULL )\n209\t    {\n210\t        dict->alloc.free( node );\n211\t    }\n212\t}\n213\t\n214\t\n215\tstatic inline void dict_delete_node( dict_list_t* restrict list, dict_elem_t* restrict curr )\n216\t{\n217\t    if ( curr == list->head )\n218\t    {\n219\t        list->head = curr->next;\n220\t    }\n221\t    if ( curr == list->tail )\n222\t    {\n223\t        list->tail = curr->prev;\n224\t    }\n225\t    if ( curr->prev != NULL )\n226\t    {\n227\t        curr->prev->next = curr->next;\n228\t    }\n229\t    if ( curr->next != NULL )\n230\t    {\n231\t        curr->next->prev = curr->prev;\n232\t    }\n233\t    list->size--;\n234\t}\n235\t\n236\t\n237\tdict_t* dict_create( dict_args_t args )\n238\t{\n239\t    size_t key_size;\n240\t    switch ( args.key.type )\n241\t    {\n242\t        case DICT_CHAR:    key_size = sizeof ( char );                      break;\n243\t        case DICT_WCHAR:   key_size = sizeof ( wchar_t );                   break;\n244\t        case DICT_I32:     key_size = sizeof ( int32_t );                   break;\n245\t        case DICT_U32:     key_size = sizeof ( uint32_t );                  break;\n246\t        case DICT_F32:     key_size = sizeof ( float );                     break;\n247\t        case DICT_I64:     key_size = sizeof ( int64_t );                   break;\n248\t        case DICT_U64:     key_size = sizeof ( uint64_t );                  break;\n249\t        case DICT_F64:     key_size = sizeof ( double );                    break;\n250\t        case DICT_PTR:     key_size = sizeof ( void* );                     break;\n251\t        case DICT_STR:     key_size = sizeof ( char* );                     break;\n252\t        case DICT_STRUCT:  \n253\t        {\n254\t            key_size = ( args.key.size + ( sizeof (uintptr_t) - 1 ) ) & ~( sizeof (uintptr_t) - 1 );\n255\t            break;\n256\t        }\n257\t        default:           fprintf( stderr, \"[ERRO]: illegal type.\\n\" );    exit(1);\n258\t    }\n259\t\n260\t    size_t val_size = ( args.val.size + ( sizeof (uintptr_t) - 1 ) ) & ~( sizeof (uintptr_t) - 1 );\n261\t\n262\t    dict_t* dict = NULL;\n263\t    if ( args.alloc.malloc != NULL )\n264\t    {\n265\t        dict = args.alloc.malloc( sizeof (dict_t) );\n266\t        ASSERT_MEM( dict );\n267\t        dict->alloc = args.alloc;\n268\t    }\n269\t    else\n270\t    {\n271\t        dict = malloc( sizeof (dict_t) );\n272\t        ASSERT_MEM( dict );\n273\t        dict->alloc = (dict_alloc_t)\n274\t        {\n275\t            .malloc = malloc,\n276\t            .free   = free,\n277\t   