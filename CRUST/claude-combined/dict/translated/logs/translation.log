dict, curr->key );\n512\t                        dict_free_val( dict, curr->key + dict->key.size );\n513\t                        dict_free_node( dict, curr );\n514\t                        return true;\n515\t                    }\n516\t                    break;\n517\t                }\n518\t                default:\n519\t                {\n520\t                    fprintf( stderr, \"[ERRO]: illegal type.\\n\" );\n521\t                    exit(1);\n522\t                }\n523\t            }\n524\t        }\n525\t    }\n526\t\n527\t    // doesn't already appear in the list\n528\t    dict_free_key( dict, key );\n529\t    return false;\n530\t}\n531\t\n532\t\n533\tbool dict_has( const dict_t* restrict dict, ... )\n534\t{\n535\t    va_list ap;\n536\t    va_start( ap, dict );\n537\t\n538\t    void* key = dict_get_key( dict, ap );\n539\t\n540\t    va_end(ap);\n541\t\n542\t    uint64_t code = dict_get_hash( dict, key );\n543\t\n544\t    // get into the linked list\n545\t    size_t index = code % dict->mod;\n546\t    for ( dict_elem_t* curr = dict->list[ index ].head; curr != NULL; curr = curr->next )\n547\t    {\n548\t        if ( curr->code != code ) continue;\n549\t        if ( dict->key.cmpr != NULL )\n550\t        {\n551\t            if ( dict->key.cmpr( curr->key, key ) == 0 )\n552\t            {\n553\t                return true;\n554\t            }\n555\t        }\n556\t        else\n557\t        {\n558\t            switch ( dict->key.type )\n559\t            {\n560\t                case DICT_CHAR:\n561\t                case DICT_WCHAR:\n562\t                case DICT_I32:\n563\t                case DICT_U32:\n564\t                case DICT_F32:\n565\t                case DICT_I64:\n566\t                case DICT_U64:\n567\t                case DICT_F64:\n568\t                case DICT_PTR:\n569\t                case DICT_STRUCT:\n570\t                {\n571\t                    if ( memcmp( curr->key, key, dict->key.size ) == 0 )\n572\t                    {\n573\t 