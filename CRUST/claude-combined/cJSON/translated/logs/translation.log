ion\": \"zip\",\n\t\t\"Latitude\":  37.371991,\n\t\t\"Longitude\": -122.02602,\n\t\t\"Address\":   \"\",\n\t\t\"City\":      \"SUNNYVALE\",\n\t\t\"State\":     \"CA\",\n\t\t\"Zip\":       \"94085\",\n\t\t\"Country\":   \"US\"\n\t}\n]\"#;\n\n    // Process each JSON text block\n    doit(text1);\n    doit(text2);\n    doit(text3);\n    doit(text4);\n    doit(text5);\n\n    // The C code commented these out:\n    // dofile(\"../../tests/test1\");\n    // dofile(\"../../tests/test2\");\n    // dofile(\"../../tests/test3\");\n    // dofile(\"../../tests/test4\");\n    // dofile(\"../../tests/test5\");\n\n    // Build and print objects concisely:\n    create_objects();\n}\n","numLines":276,"startLine":1,"totalLines":276}}}
