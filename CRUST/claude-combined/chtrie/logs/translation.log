 it < 0 {\n56\t            return false;\n57\t        }\n58\t    }\n59\t    *term.get(&it).unwrap_or(&false)\n60\t}\n61\t\n62\t#[test]\n63\tfn test_chtrie() {\n64\t    let mut tr = Chtrie::new(N, M).expect(\"Failed to initialize Chtrie\");\n65\t    let mut term = HashMap::new();\n66\t    let mut nchild = HashMap::new();\n67\t\n68\t    for &word in DICT1.iter() {\n69\t        add(&mut tr, &mut term, &mut nchild, word);\n70\t    }\n71\t    for &word in DICT2.iter() {\n72\t        add(&mut tr, &mut term, &mut nchild, word);\n73\t    }\n74\t    for &word in STOP.iter() {\n75\t        del(&mut tr, &mut term, &mut nchild, word);\n76\t    }\n77\t    for &word in DICT3.iter() {\n78\t        add(&mut tr, &mut term, &mut nchild, word);\n79\t    }\n80\t\n81\t    let test_cases = [\n82\t        (\"hello\", false), (\"the\", false), (\"his\", true), (\"he\", true),\n83\t        (\"his\", true), (\"go\", false), (\"he\", true), (\"a\", false),\n84\t        (\"an\", false), (\"this\", true), (\"that\", true), (\"hey\", false),\n85\t        (\"she\", true), (\"hers\", true),\n86\t    ];\n87\t\n88\t    for &(test_case, expected) in test_cases.iter() {\n89\t        let result = query(&mut tr, &term, test_case);\n90\t        assert_eq!(result, expected, \"Query: {}, Result: {}, Expected: {}\", test_case, result, expected);\n91\t    }\n92\t\n93\t    tr.free();\n94\t    println!(\"All tests passed!\");\n95\t}\n96\tfn main() {\n97\t    //\n98\t}"}]},"parent_tool_use_id":null,"session_id":"b89a933e-d2c5-4b51-b921-8082cf5247c1","uuid":"70dc2885-de46-43af-ad36-0e6c0526a585","timestamp":"2026-05-30T07:14:12.471Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-rH9wYP/project/src/bin/test.rs","content":"use std::collections::HashMap;\nuse chtrie::chtrie::Chtrie;\n\nconst N: usize = 65536;\nconst M: usize = 256;\n\nstatic DICT1: [&str; 4] = [\"\", \"the\", \"a\", \"an\"];\nstatic DICT2: [&str; 4] = [\"he\", \"she\", \"his\", \"hers\"];\nstatic DICT3: [&str; 2] = [\"this\", \"that\"];\nstatic STOP: [&str; 3] = [\"the\", \"an\", \"a\"];\n\nfn add(tr: &mut Chtrie, term: &mut HashMap<i32, bool>, nchild: &mut HashMap<i32, i32>, s: &str) {\n    let mut it = 0;\n    for c in s.chars() {\n        if tr.walk(it, c as i32, 0) == -1 {\n            *nchild.entry(it).or_insert(0) += 1;\n        }\n        it = tr.walk(it, c as i32, 1);\n        if it == -1 {\n            panic!(\"walk failed\");\n        }\n    }\n    term.insert(it, true);\n}\n\nfn del(tr: &mut Chtrie, term: &mut HashMap<i32, bool>, nchild: &mut HashMap<i32, i32>, s: &str) {\n    let mut nodes = Vec::new();\n    let mut symbs = Vec::new();\n    let mut it = 0;\n    for c in s.chars() {\n        nodes.push(it);\n        symbs.push(c as i32);\n        it = tr.walk(it, c as i32, 0);\n        if it < 0 {\n            return;\n        }\n    }\n    if !term.get(&it).unwrap_or(&false) {\n        return;\n    }\n    term.insert(it, false);\n    while it > 0 && !term.get(&it).unwrap_or(&false) && *nchild.get(&it).unwrap_or(&0) == 0 {\n        let n = nodes.pop().unwrap();\n        let sym = symbs.pop().unwrap();\n        tr.del(n, sym);\n        it = n;\n        *nchild.entry(it).or_insert(0) -= 1;\n    }\n}\n\nfn query(tr: &mut Chtrie, term: &HashMap<i32, bool>, s: &str) -> bool {\n    let mut it = 0;\n    for c in s.chars() {\n        it = tr.walk(it, c as i32, 0);\n        if it < 0 {\n            return false;\n        }\n    }\n    *term.get(&it).unwrap_or(&false)\n}\n\n#[test]\nfn test_chtrie() {\n    let mut tr = Chtrie::new(N, M).expect(\"Failed to initialize Chtrie\");\n    let mut term = HashMap::new();\n    let mut nchild = HashMap::new();\n\n    for &word in DICT1.iter() {\n        add(&mut tr, &mut term, &mut nchild, word);\n    }\n    for &word in DICT2.iter() {\n        add(&mut tr, &mut term, &mut nchild, word);\n    }\n    for &word in STOP.iter() {\n        del(&mut tr, &mut term, &mut nchild, word);\n    }\n    for &word in DICT3.iter() {\n        add(&mut tr, &mut