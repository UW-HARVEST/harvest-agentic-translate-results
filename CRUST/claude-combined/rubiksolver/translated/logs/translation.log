*)element;\n70\t\tparent = (son - 1) / 2;\n71\t\twhile(parent >= 0 && heap->is_smaller(heap->head[son], heap->head[parent]))\n72\t\t{\n73\t\t\tSWAP_ARRAY_ELEMENTS(heap->head, parent, son);\n74\t\t\tson = parent;\n75\t\t\tparent = (son - 1) / 2;\n76\t\t}\n77\t\theap->last += 1;\n78\t\tPDEBUG(\"An element is inserted in heap at position %d. Heap size is %d\\n\", son, heap->last + 1);\n79\t\treturn true;\n80\t}\n81\t\n82\tvoid *heap_delete_min(heap_t heap)\n83\t{\n84\t\tassert(heap->head != NULL);\n85\t\tvoid *min = NULL;\n86\t\tint parent = 0, son1, son2, son;\n87\t\tmin = heap->head[parent];\n88\t\theap->head[parent] = heap->head[heap->last];\n89\t\theap->head[heap->last] = NULL;\n90\t\theap->last -= 1;\n91\t\tdo\n92\t\t{\n93\t\t\tson1 = 2 * parent + 1;\n94\t\t\tson2 = 2 * parent + 2;\n95\t\t\tif(son1 <= heap->last)\n96\t\t\t\tif(son2 <= heap->last)\n97\t\t\t\t\tson = (heap->is_smaller(heap->head[son1],heap->head[son2])?son1:son2);\n98\t\t\t\telse\n99\t\t\t\t\tson = son1;\n100\t\t\telse\n101\t\t\t\tbreak;\n102\t\t\tif(heap->is_smaller(heap->head[son],heap->head[parent]))\n103\t\t\t{\n104\t\t\t\tSWAP_ARRAY_ELEMENTS(heap->head, parent, son);\n105\t\t\t}\n106\t\t\tparent = son;\n107\t\t}while(1);\n108\t\tPDEBUG(\"An element is removed from heap. Heap size is %d\\n\", heap->last + 1);\n109\t\treturn min;\n110\t}\n111\t\n112\tbool heap_is_empty(const heap_t heap)\n113\t{\n114\t\tassert(heap != NULL);\n115\t\treturn (heap->last == -1);\n116\t}\n117\t\n118\tvoid *heap_find_min(const heap_t heap)\n119\t{\n120\t\tassert(heap->head != NULL);\n121\t\treturn heap->head[0];\n122\t}\n123\t"}]},"parent_tool_use_id":null,"session_id":"e3da1f81-d916-44ed-9cc3-c1b2a284735f","uuid":"1c1824f1-4c3e-4552-89fa-1c7a1c914ecd","timestamp":"2026-05-30T10:29:00.242Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-sppOD4/project/c_src/heap/heap.c","content":"/* Array implementation of binary heap\n * Author: J Kishore Kumar\n */\n\n#include <stdio.h>\n#include <stdlib.h>