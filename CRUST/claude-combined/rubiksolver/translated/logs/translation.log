{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_pjtagib3jofrc4xouepw32n24u42ouibmdhgjh7hu65ozwkdbroq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01DhTDPzFpD3q2d8jtmWfzj4","name":"Write","input":{"file_path":"/tmp/harvest-crust-sppOD4/project/src/heap.rs","content":"/// A custom binary heap that stores elements in a Vec and uses a custom comparator.\npub struct Heap<T> {\n    data: Vec<T>,\n    comparator: Box<dyn Fn(&T, &T) -> bool>,\n}\nimpl<T> Heap<T> {\n    /// Creates a new heap with the given initial capacity and comparator.\n    pub fn new(init_size: usize, comparator: impl Fn(&T, &T) -> bool + 'static) -> Self {\n        Self {\n            data: Vec::with_capacity(init_size),\n            comparator: Box::new(comparator),\n        }\n    }\n    /// Returns true if the heap is empty.\n    pub fn is_empty(&self) -> bool {\n        self.data.is_empty()\n    }\n    /// Returns a reference to the minimum element (if any).\n    pub fn find_min(&self) -> Option<&T> {\n        self.data.first()\n    }\n    /// Inserts an element into the heap.\n    pub fn insert(&mut self, element: T) {\n        self.data.push(element);\n        let mut son = self.data.len() - 1;\n        while son > 0 {\n            let parent = (son - 1) / 2;\n            if (self.comparator)(&self.data[son], &self.data[parent]) {\n                self.data.swap(parent, son);\n                son = parent;\n            } else {\n                break;\n            }\n        }\n    }\n    /// Removes and returns the minimum element, or None if empty.\n    pub fn delete_min(&mut self) -> Option<T> {\n        if self.data.is_empty() {\n            return None;\n        }\n        let last_idx = self.data.len() - 1;\n        self.data.swap(0, last_idx);\n        let min = self.data.pop();\n        let len = self.data.len();\n        if len == 0 {\n            return min;\n        }\n        let mut parent = 0;\n        loop {\n            let son1 = 2 * parent + 1;\n            let son2 = 2 * parent + 2;\n            let son;\n            if son1 < len {\n                if son2 < len {\n                    son = if (self.comparator)(&self.data[son1], &self.data[son2]) {\n                        son1\n                    } else {\n                        son2\n                    };\n                } else {\n                    son = son1;\n                }\n            } else {\n                break;\n            }\n            if (self.comparator)(&self.data[son], &self.data[parent]) {\n                self.data.swap(parent, son);\n            }\n            parent = son;\n        }\n        min\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":236,"cache_read_input_tokens":37067,"cache_creation":{"ephemeral_5m_input_tokens":236,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"e3da1f81-d916-44ed-9cc3-c1b2a284735f","uuid":"7e0f717b-906b-416d-ab2d-3371f89c8733"}
