{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016EYUc8pAutp25xR94u6C5Y","type":"tool_result","content":"1\tuse LTRE::ltre::*;\n2\tuse std::fmt::Write;\n3\t\n4\t#[derive(Debug)]\n5\tstruct Test {\n6\t    regex: &'static str,\n7\t    input: &'static str,\n8\t    matches: bool,\n9\t    errors: bool,\n10\t    partial: bool,\n11\t    ignorecase: bool,\n12\t    complement: bool,\n13\t    quick: bool,\n14\t}\n15\t\n16\t/// The main test function, akin to the `void test(struct test args)` in C.\n17\t/// It:\n18\t///  1. Parses `args.regex` into an NFA (reports parse error if mismatch).\n19\t///  2. If parse success: apply partial/ignorecase/complement if requested.\n20\t///  3. Compiles to DFA -> (serialize -> deserialize) -> uncompile -> compile\n21\t///  4. If !quick, does (dfa -> decompile -> parse -> compile) again\n22\t///  5. Checks `ltre_matches` and `ltre_matches_lazy` vs. `args.matches`\n23\tfn run_test(args: &Test) {\n24\t    // 1) Parse\n25\t    let parse_result = ltre_parse(args.regex);\n26\t    let parse_had_error = parse_result.is_err();\n27\t\n28\t    // The original code checks: if (!!error != args.errors) => \"test failed\"\n29\t    // Here, parse_had_error is `true` if parse_result was Err(...).\n30\t    if parse_had_error != args.errors {\n31\t        println!(\"test failed: /{}/ parse\", args.regex);\n32\t    }\n33\t    // If parse error was expected or parse error actually happened, do not continue\n34\t    // any further test logic if we indeed had an error:\n35\t    if parse_had_error {\n36\t        return;\n37\t    }\n38\t\n39\t    // 2) If parse success, we have an NFA\n40\t    let mut nfa = parse_result.unwrap();\n41\t    if args.partial {\n42\t        let _ = ltre_partial(&mut nfa);\n43\t    }\n44\t    if args.ignorecase {\n45\t        let _ = ltre_ignorecase(&mut nfa);\n46\t    }\n47\t    if args.complement {\n48\t        ltre_complement(&mut nfa);\n49\t    }\n50\t\n51\t    // 3) NFA -> DFA\n52\t    let mut dfa = ltre_compile(nfa.clone());\n53\t\n54\t    // 3a) Round-trip: (DFA -> serialize -> deserialize -> NFA -> compile again)\n55\t    let buf = dfa_serialize(&dfa);\n56\t    let (mut dfa2, _) = dfa_deserialize(&buf).expect(\"dfa_deserialize failed on trusted buffer?\");\n57\t    let mut nfa2 = ltre_uncompile(&dfa2);\n58\t    let mut dfa3 = ltre_compile(nfa2.clone());\n59\t\n60\t    // 4) If not quick, do the \"DFA -> RE -> parse -> DFA\"\n61\t    if !args.quick {\n62\t        let re_string = ltre_decompile(&dfa3);\n63\t        // parse it\n64\t        if let Ok(nfa_reparse) = ltre_parse(&re_string) {\n65\t            // compile\n66\t            dfa3 = ltre_compile(nfa_reparse);\n67\t        }\n68\t    }\n69\t\n70\t    // 5) Now check `ltre_matches` and `ltre_matches_lazy`\n71\t    let matched1 = ltre_matches(&dfa3, args.input.as_bytes());\n72\t\n73\t    // For lazy matching, we store the partial DFA in an Option<Dfa>, starting None.\n74\t    let mut lazy_dfa: Option<Dfa> = None;\n75\t    let matched2 = ltre_matches_lazy(&mut lazy_dfa, &nfa2, args.input.as_bytes());\n76\t\n77\t    if matched1 != args.matches || matched2 != args.matches {\n78\t        println!(\"test failed: /{}/ against '{}'\", args.regex, args.input);\n79\t    }\n80\t}\n81\t\n82\t/// A convenience macro to shorten calls to `run_test(...)`.\n83\tmacro_rules! test {\n84\t    // If the caller specifies all fields in struct-literal style:\n85\t    ($args:expr) => {\n86\t        run_test(&$args);\n87\t    };\n88\t    // Or a partial syntax of the form: test(\"regex\", \"input\", matches) ...\n89\t    // We can parse a few common cases. For example:\n90\t    ($re:expr, $inp:expr, $mat:expr) => {\n91\t        run_test(&Test {\n92\t            regex: $re,\n93\t            input: $inp,\n94\t            matches: $mat,\n95\t            errors: false,\n96\t            partial: false,\n97\t            ignorecase: false,\n98\t            complement: false,\n99\t            quick: false,\n100\t        });\n101\t    };\n102\t    // If we want quick also (4th param):\n103\t    ($re:expr, $inp:expr, $mat:expr, .quick = $q:expr) => {\n104\t        run_test(&Test {\n105\t            regex: $re,\n106\t            input: $inp,\n107\t            matches: $mat,\n108\t            errors: false,\n109\t            partial: false,\n110\t            ignorecase: false,\n111\t            complement: false,\n112\t            quick: $q,\n113\t        });\n114\t    }; // If we want an advanced named-struct call: test(\"foo\", .partial = true) etc.\n115\t       // you can just do test!(Test{ regex: \"...\", input: \"...\", ... }) if needed.\n116\t}\n117\t\n118\t#[test]\n119\tpub fn test() {\n120\t    // The big battery of tests:\n121\t    // catastrophic backtracking\n122\t    test!(\"(a*)*c\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", false);\n123\t    test!(\"(x+x+)+y\", \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\", false);\n124\t\n125\t    // determinization state blowout\n126\t    test!(\"[01]*1[01]{8}\", \"11011100011100\", true, .quick = true);\n127\t    test!(\"[01]*1[01]{8}\", \"01010010010010\", false, .quick = true);\n128\t\n129\t    // powerset construction state blowout\n130\t    test!(\".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", \"\", false);\n131\t    test!(\".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", \"123\", true);\n132\t\n133\t    // potential edge cases\n134\t    test!(\"abba\", \"abba\", true);\n135\t    test!(\"[ab]+\", \"abba\", true);\n136\t    test!(\"[ab]+\", \"abc\", false);\n137\t    test!(\".*\", \"abba\", true);\n138\t    test!(\"(a|b+){3}\", \"abbba\", true);\n139\t    test!(\"(a|b+){3}\", \"abbab\", false);\n140\t    test!(\"\\\\x61\\\\+\", \"a+\", true);\n141\t    test!(\"\", \"\", true);\n142\t    test!(\"[]\", \"\", false);\n143\t    test!(\"[]*\", \"\", true);\n144\t    test!(\"[]+\", \"\", false);\n145\t    test!(\"[]?\", \"\", true);\n146\t    test!(\"()\", \"\", true);\n147\t    test!(\"()*\", \"\", true);\n148\t    test!(\"()+\", \"\", true);\n149\t    test!(\"()?\", \"\", true);\n150\t    test!(\" \", \" \", true);\n151\t    test!(\"\", \"\\n\", false);\n152\t    test!(\"\\\\n\", \"\\n\", true);\n153\t    test!(\".\", \"\\n\", false);\n154\t    test!(\"\\\\\\\\n\", \"\\n\", false);\n155\t    test!(\"(|n)(\\\\n)\", \"\\n\", true);\n156\t    test!(\"\\\\r?\\\\n\", \"\\n\", true);\n157\t    test!(\"\\\\r?\\\\n\", \"\\r\\n\", true);\n158\t    test!(\"(a*)*\", \"a\", true);\n159\t    test!(\"(a+)+\", \"aa\", true);\n160\t    test!(\"(a?)?\", \"\", true);\n161\t    test!(\"a+\", \"aa\", true);\n162\t    test!(\"a?\", \"aa\", false);\n163\t    test!(\"(a+)?\", \"aa\", true);\n164\t    test!(\"(ba+)?\", \"baa\", true);\n165\t    test!(\"(ab+)?\", \"b\", false);\n166\t    test!(\"(a+b)?\", \"a\", false);\n167\t    test!(\"(a+a+)+\", \"a\", false);\n168\t    test!(\"a+\", \"\", false);\n169\t    test!(\"(a+|)+\", \"aa\", true);\n170\t    test!(\"(a+|)+\", \"\", true);\n171\t    test!(\"(a|b)?\", \"a\", true);\n172\t    test!(\"(a|b)?\", \"b\", true);\n173\t    test!(\"x*|\", \"xx\", true);\n174\t    test!(\"x*|\", \"\", true);\n175\t    test!(\"x+|\", \"xx\", true);\n176\t    test!(\"x+|\", \"\", true);\n177\t    test!(\"x?|\", \"x\", true);\n178\t    test!(\"x?|\", \"\", true);\n179\t    test!(\"x*y*\", \"yx\", false);\n180\t    test!(\"x+y+\", \"yx\", false);\n181\t    test!(\"x?y?\", \"yx\", false);\n182\t    test!(\"x+y*\", \"xyx\", false);\n183\t    test!(\"x*y+\", \"yxy\", false);\n184\t    test!(\"x*|y*\", \"xy\", false);\n185\t    test!(\"x+|y+\", \"xy\", false);\n186\t    test!(\"x?|y?\", \"xy\", false);\n187\t    test!(\"x+|y*\", \"xy\", false);\n188\t    test!(\"x*|y+\", \"xy\", false);\n189\t    test!(\"a{1,2}\", \"\", false);\n190\t    test!(\"a{1,2}\", \"a\", true);\n191\t    test!(\"a{1,2}\", \"aa\", true);\n192\t    test!(\"a{1,2}\", \"aaa\", false);\n193\t    test!(\"a{0,}\", \"\", true);\n194\t    test!(\"a{0,}\", \"a\", true);\n195\t    test!(\"a{0,}\", \"aa\", true);\n196\t    test!(\"a{0,}\", \"aaa\", true);\n197\t    test!(\"a{1,}\", \"\", false);\n198\t    test!(\"a{1,}\", \"a\", true);\n199\t    test!(\"a{1,}\", \"aa\", true);\n200\t    test!(\"a{1,}\", \"aaa\", true);\n201\t    test!(\"a{3,}\", \"aa\", false);\n202\t    test!(\"a{3,}\", \"aaa\", true);\n203\t    test!(\"a{3,}\", \"aaaa\", true);\n204\t    test!(\"a{3,}\", \"aaaaa\", true);\n205\t    test!(\"a{0,2}\", \"\", true);\n206\t    test!(\"a{0,2}\", \"a\", true);\n207\t    test!(\"a{0,2}\", \"aa\", true);\n208\t    test!(\"a{0,2}\", \"aaa\", false);\n209\t    test!(\"a{2}\", \"a\", false);\n210\t    test!(\"a{2}\", \"aa\", true);\n211\t    test!(\"a{2}\", \"aaa\", false);\n212\t    test!(\"a{0}\", \"\", true);\n213\t    test!(\"a{0}\", \"a\", false);\n214\t\n215\t    // partial, ignorecase, complement\n216\t    run_test(&Test {\n217\t        regex: \"\",\n218\t        input: \"\",\n219\t        matches: true,\n220\t        errors: false,\n221\t        partial: true,\n222\t        ignorecase: false,\n223\t        complement: false,\n224\t        quick: false,\n225\t    });\n226\t    run_test(&Test {\n227\t        regex: \"\",\n228\t        input: \"abc\",\n229\t        matches: true,\n230\t        errors: false,\n231\t        partial: true,\n232\t        ignorecase: false,\n233\t        complement: false,\n234\t        quick: false,\n235\t    });\n236\t    run_test(&Test {\n237\t        regex: \"b\",\n238\t        input: \"abc\",\n239\t        matches: true,\n240\t        errors: false,\n241\t        partial: true,\n242\t        ignorecase: false,\n243\t        complement: false,\n244\t        quick: false,\n245\t    });\n246\t    run_test(&Test {\n247\t        regex: \"ba\",\n248\t        input: \"abc\",\n249\t        matches: false,\n250\t        errors: false,\n251\t        partial: true,\n252\t        ignorecase: false,\n253\t        complement: false,\n254\t        quick: false,\n255\t    });\n256\t    run_test(&Test {\n257\t        regex: \"abc\",\n258\t        input: \"abc\",\n259\t        matches: true,\n260\t        errors: false,\n261\t        partial: true,\n262\t        ignorecase: false,\n263\t        complement: false,\n264\t        quick: false,\n265\t    });\n266\t    run_test(&Test {\n267\t        regex: \"[]\",\n268\t        input: \"\",\n269\t        matches: false,\n270\t        errors: false,\n271\t        partial: true,\n272\t        ignorecase: false,\n273\t        complement: false,\n274\t        quick: false,\n275\t    });\n276\t    run_test(&Test {\n277\t        regex: \"\",\n278\t        input: \"\",\n279\t        matches: true,\n280\t        errors: false,\n281\t        partial: false,\n282\t        ignorecase: true,\n283\t        complement: false,\n284\t        quick: false,\n285\t    });\n286\t    test!(\"abCdEF\", \"aBCdEf\", true, .quick = false /* ignorecase below */);\n287\t    {\n288\t        let mut t = Test {\n289\t            regex: \"abCdEF\",\n290\t            input: \"aBCdEf\",\n291\t            matches: true,\n292\t            errors: false,\n293\t            partial: false,\n294\t            ignorecase: true,\n295\t            complement: false,\n296\t            quick: false,\n297\t        };\n298\t        run_test(&t);\n299\t    }\n300\t    {\n301\t        let mut t = Test {\n302\t            regex: \"ab\",\n303\t            input: \"abc\",\n304\t            matches: false,\n305\t            errors: false,\n306\t            partial: false,\n307\t            ignorecase: true,\n308\t            complement: false,\n309\t            quick: false,\n310\t        };\n311\t        run_test(&t);\n312\t    }\n313\t    {\n314\t        let mut t = Test {\n315\t            regex: \"a\",\n316\t            input: \"\",\n317\t            matches: true,\n318\t            errors: false,\n319\t            partial: false,\n320\t            ignorecase: false,\n321\t            complement: true,\n322\t            quick: false,\n323\t        };\n324\t        run_test(&t);\n325\t    }\n326\t    {\n327\t        let mut t = Test {\n328\t            regex: \"a\",\n329\t            input: \"aa\",\n330\t            matches: true,\n331\t            errors: false,\n332\t            partial: false,\n333\t            ignorecase: false,\n334\t            complement: true,\n335\t            quick: false,\n336\t        };\n337\t        run_test(&t);\n338\t    }\n339\t    {\n340\t        let mut t = Test {\n341\t            regex: \"a\",\n342\t            input: \"a\",\n343\t            matches: false,\n344\t            errors: false,\n345\t            partial: false,\n346\t            ignorecase: false,\n347\t            complement: true,\n348\t            quick: false,\n349\t        };\n350\t        run_test(&t);\n351\t    }\n352\t    {\n353\t        let mut t = Test {\n354\t            regex: \"ab*\",\n355\t            input: \"ac\",\n356\t            matches: true,\n357\t            errors: false,\n358\t            partial: false,\n359\t            ignorecase: false,\n360\t            complement: true,\n361\t            quick: false,\n362\t        };\n363\t        run_test(&t);\n364\t    }\n365\t    {\n366\t        let mut t = Test {\n367\t            regex: \"ab*\",\n368\t            input: \"abb\",\n369\t            matches: false,\n370\t            errors: false,\n371\t            partial: false,\n372\t            ignorecase: false,\n373\t            complement: true,\n374\t            quick: false,\n375\t        };\n376\t        run_test(&t);\n377\t    }\n378\t\n379\t    // decompilation edge cases\n380\t    test!(\"^aa*\", \"ba\", true);\n381\t    test!(\"a-zz*\", \"abc\", false);\n382\t    test!(\"\\\\x0a(0a)*\", \"\\x0a\", true);\n383\t    test!(\"\\\\x0aa*\", \"\\x0a\\x0a\", false);\n384\t\n385\t    // parse errors\n386\t    run_test(&Test {\n387\t        regex: \"abc]\",\n388\t        input: \"\",\n389\t        matches: false,\n390\t        errors: true,\n391\t        partial: false,\n392\t        ignorecase: false,\n393\t        complement: false,\n394\t        quick: false,\n395\t    });\n396\t    run_test(&Test {\n397\t        regex: \"[abc\",\n398\t        input: \"\",\n399\t        matches: false,\n400\t        errors: true,\n401\t        partial: false,\n402\t        ignorecase: false,\n403\t        complement: false,\n404\t        quick: false,\n405\t    });\n406\t    run_test(&Test {\n407\t        regex: \"abc)\",\n408\t        input: \"\",\n409\t        matches: false,\n410\t        errors: true,\n411\t        partial: false,\n412\t        ignorecase: false,\n413\t        complement: false,\n414\t        quick: false,\n415\t    });\n416\t    run_test(&Test {\n417\t        regex: \"(abc\",\n418\t        input: \"\",\n419\t        matches: false,\n420\t        errors: true,\n421\t        partial: false,\n422\t        ignorecase: false,\n423\t        complement: false,\n424\t        quick: false,\n425\t    });\n426\t    run_test(&Test {\n427\t        regex: \"+a\",\n428\t        input: \"\",\n429\t        matches: false,\n430\t        errors: true,\n431\t        partial: false,\n432\t        ignorecase: false,\n433\t        complement: false,\n434\t        quick: false,\n435\t    });\n436\t    run_test(&Test {\n437\t        regex: \"a|*\",\n438\t        input: \"\",\n439\t        matches: false,\n440\t        errors: true,\n441\t        partial: false,\n442\t        ignorecase: false,\n443\t        complement: false,\n444\t        quick: false,\n445\t    });\n446\t    run_test(&Test {\n447\t        regex: \"\\\\x0\",\n448\t        input: \"\",\n449\t        matches: false,\n450\t        errors: true,\n451\t        partial: false,\n452\t        ignorecase: false,\n453\t        complement: false,\n454\t        quick: false,\n455\t    });\n456\t    run_test(&Test {\n457\t        regex: \"\\\\zzz\",\n458\t        input: \"\",\n459\t        matches: false,\n460\t        errors: true,\n461\t        partial: false,\n462\t        ignorecase: false,\n463\t        complement: false,\n464\t        quick: false,\n465\t    });\n466\t    run_test(&Test {\n467\t        regex: \"[a\\\\x]\",\n468\t        input: \"\",\n469\t        matches: false,\n470\t        errors: true,\n471\t        partial: false,\n472\t        ignorecase: false,\n473\t        complement: false,\n474\t        quick: false,\n475\t    });\n476\t    run_test(&Test {\n477\t        regex: \"\\u{0008}\",\n478\t        input: \"\",\n479\t        matches: false,\n480\t        errors: true,\n481\t        partial: false,\n482\t        ignorecase: false,\n483\t        complement: false,\n484\t        quick: false,\n485\t    }); // \\b in code\n486\t    run_test(&Test {\n487\t        regex: \"\\t\",\n488\t        input: \"\",\n489\t        matches: false,\n490\t        errors: true,\n491\t        partial: false,\n492\t        ignorecase: false,\n493\t        complement: false,\n494\t        quick: false,\n495\t    });\n496\t    run_test(&Test {\n497\t        regex: \"^^a\",\n498\t        input: \"\",\n499\t        matches: false,\n500\t        errors: true,\n501\t        partial: false,\n502\t        ignorecase: false,\n503\t        complement: false,\n504\t        quick: false,\n505\t    });\n506\t    run_test(&Test {\n507\t        regex: \"a**\",\n508\t        input: \"\",\n509\t        matches: false,\n510\t        errors: true,\n511\t        partial: false,\n512\t        ignorecase: false,\n513\t        complement: false,\n514\t        quick: false,\n515\t    });\n516\t    run_test(&Test {\n517\t        regex: \"a*+\",\n518\t        input: \"\",\n519\t        matches: false,\n520\t        errors: true,\n521\t        partial: false,\n522\t        ignorecase: false,\n523\t        complement: false,\n524\t        quick: false,\n525\t    });\n526\t    run_test(&Test {\n527\t        regex: \"a*?\",\n528\t        input: \"\",\n529\t        matches: false,\n530\t        errors: true,\n531\t        partial: false,\n532\t        ignorecase: false,\n533\t        complement: false,\n534\t        quick: false,\n535\t    });\n536\t    run_test(&Test {\n537\t        regex: \"a+*\",\n538\t        input: \"\",\n539\t        matches: false,\n540\t        errors: true,\n541\t        partial: false,\n542\t        ignorecase: false,\n543\t        complement: false,\n544\t        quick: false,\n545\t    });\n546\t    run_test(&Test {\n547\t        regex: \"a++\",\n548\t        input: \"\",\n549\t        matches: false,\n550\t        errors: true,\n551\t        partial: false,\n552\t        ignorecase: false,\n553\t        complement: false,\n554\t        quick: false,\n555\t    });\n556\t    run_test(&Test {\n557\t        regex: \"a+?\",\n558\t        input: \"\",\n559\t        matches: false,\n560\t        errors: true,\n561\t        partial: false,\n562\t        ignorecase: false,\n563\t        complement: false,\n564\t        quick: false,\n565\t    });\n566\t    run_test(&Test {\n567\t        regex: \"a?*\",\n568\t        input: \"\",\n569\t        matches: false,\n570\t        errors: true,\n571\t        partial: false,\n572\t        ignorecase: false,\n573\t        complement: false,\n574\t        quick: false,\n575\t    });\n576\t    run_test(&Test {\n577\t        regex: \"a?+\",\n578\t        input: \"\",\n579\t        matches: false,\n580\t        errors: true,\n581\t        partial: false,\n582\t        ignorecase: false,\n583\t        complement: false,\n584\t        quick: false,\n585\t    });\n586\t    run_test(&Test {\n587\t        regex: \"a??\",\n588\t        input: \"\",\n589\t        matches: false,\n590\t        errors: true,\n591\t        partial: false,\n592\t        ignorecase: false,\n593\t        complement: false,\n594\t        quick: false,\n595\t    });\n596\t\n597\t    // We'll define a big constant for NAT_OVF\n598\t    const NAT_OVF: &str = \"9999999999999999999999999999999999999999\";\n599\t    // run_test(&Test {\n600\t    //     regex: &format!(\"a{{{}}}\", NAT_OVF),\n601\t    //     input: \"\",\n602\t    //     matches: false,\n603\t    //     errors: true,\n604\t    //     partial: false,\n605\t    //     ignorecase: false,\n606\t    //     complement: false,\n607\t    //     quick: false,\n608\t    // });\n609\t    // run_test(&Test {\n610\t    //     regex: &format!(\"a{{{},}}\", NAT_OVF),\n611\t    //     input: \"\",\n612\t    //     matches: false,\n613\t    //     errors: true,\n614\t    //     partial: false,\n615\t    //     ignorecase: false,\n616\t    //     complement: false,\n617\t    //     quick: false,\n618\t    // });\n619\t    // run_test(&Test {\n620\t    //     regex: &format!(\"a{{,{} }}\", NAT_OVF),\n621\t    //     input: \"\",\n622\t    //     matches: false,\n623\t    //     errors: true,\n624\t    //     partial: false,\n625\t    //     ignorecase: false,\n626\t    //     complement: false,\n627\t    //     quick: false,\n628\t    // });\n629\t    // run_test(&Test {\n630\t    //     regex: &format!(\"a{{{},{}}}\", NAT_OVF, NAT_OVF),\n631\t    //     input: \"\",\n632\t    //     matches: false,\n633\t    //     errors: true,\n634\t    //     partial: false,\n635\t    //     ignorecase: false,\n636\t    //     complement: false,\n637\t    //     quick: false,\n638\t    // });\n639\t\n640\t    // nonstandard features\n641\t    test!(\"^a\", \"z\", true);\n642\t    test!(\"^a\", \"a\", false);\n643\t    test!(\"^\\\\n\", \"\\r\", true);\n644\t    test!(\"^\\\\n\", \"\\n\", false);\n645\t    test!(\"^.\", \"\\n\", true);\n646\t    test!(\"^.\", \"a\", false);\n647\t    test!(\"\\\\d+\", \"0123456789\", true);\n648\t    test!(\"\\\\s+\", r\" \\f\\n\\r\\t\\v\", true);\n649\t    test!(\"\\\\w+\", \"azAZ09_\", true);\n650\t    test!(\"^a-z*\", \"1A!2$B\", true);\n651\t    test!(\"^a-z*\", \"1aA\", false);\n652\t    test!(\"a-z*\", \"abc\", true);\n653\t    test!(\"^[\\\\d^\\\\w]+\", \"abcABC\", true);\n654\t    test!(\"^[\\\\d^\\\\w]+\", \"abc123\", false);\n655\t    test!(\"^[\\\\d\\\\W]+\", \"abcABC\", true);\n656\t    test!(\"^[\\\\d^\\\\W]+\", \"abc123\", false);\n657\t    test!(\"[[abc]]+\", \"abc\", true);\n658\t    test!(\"[a[bc]]+\", \"abc\", true);\n659\t    test!(\"[a[b]c]+\", \"abc\", true);\n660\t    test!(\"[a][b][c]\", \"abc\", true);\n661\t    test!(\"^[^a^b]\", \"a\", false);\n662\t    test!(\"^[^a^b]\", \"b\", false);\n663\t    test!(\"^[^a^b]\", \"\", false);\n664\t    test!(\"<ab>\", \"a\", false);\n665\t    test!(\"<ab>\", \"b\", false);\n666\t    test!(\"<ab>\", \"\", false);\n667\t    test!(\"\\\\^\", \"^\", true);\n668\t    test!(\"^\\\\^\", \"^\", false);\n669\t    test!(\"^[^\\\\^]\", \"^\", true);\n670\t    test!(\"^[ ^[a b c]]+\", \"abc\", true);\n671\t    test!(\"^[ ^[a b c]]+\", \"a c\", false);\n672\t    test!(\"<[a b c]^ >+\", \"abc\", true);\n673\t    test!(\"<[a b c]^ >+\", \"a c\", false);\n674\t    test!(\"^[^0-74]+\", \"0123567\", true);\n675\t    test!(\"^[^0-74]+\", \"89\", false);\n676\t    test!(\"^[^0-74]+\", \"4\", false);\n677\t    test!(\"<0-7^4>+\", \"0123567\", true);\n678\t    test!(\"<0-7^4>+\", \"89\", false);\n679\t    test!(\"<0-7^4>+\", \"4\", false);\n680\t    test!(\"[]\", \" \", false);\n681\t    test!(\"^[]\", \" \", true);\n682\t    test!(\"<>\", \" \", true);\n683\t    test!(\"^<>\", \" \", false);\n684\t    test!(\"9-0*\", \"abc\", true);\n685\t    test!(\"9-0*\", \"18\", false);\n686\t    test!(\"9-0*\", \"09\", true);\n687\t    test!(\"9-0*\", \"/:\", true);\n688\t    test!(\"b-a*\", \"ab\", true);\n689\t    test!(\"a-b*\", \"ab\", true);\n690\t    test!(\"a-a*\", \"ab\", false);\n691\t    test!(\"a-a*\", \"aa\", true);\n692\t    test!(\"a{,2}\", \"\", true);\n693\t    test!(\"a{,2}\", \"a\", true);\n694\t    test!(\"a{,2}\", \"aa\", true);\n695\t    test!(\"a{,2}\", \"aaa\", false);\n696\t    test!(\"a{}\", \"\", true);\n697\t    test!(\"a{}\", \"a\", false);\n698\t    test!(\"a{,}\", \"\", true);\n699\t    test!(\"a{,}\", \"a\", true);\n700\t    test!(\"~0*\", \"\", false);\n701\t    test!(\"~0*\", \"0\", false);\n702\t    test!(\"~0*\", \"00\", false);\n703\t    test!(\"~0*\", \"001\", true);\n704\t    test!(\"ab&cd\", \"\", false);\n705\t    test!(\"ab&cd\", \"ab\", false);\n706\t    test!(\"ab&cd\", \"cd\", false);\n707\t    test!(\"\\\\w+&~\\\\d+\", \"\", false);\n708\t    test!(\"\\\\w+&~\\\\d+\", \"abc\", true);\n709\t    test!(\"\\\\w+&~\\\\d+\", \"abc123\", true);\n710\t    test!(\"\\\\w+&~\\\\d+\", \"1a2b3c\", true);\n711\t    test!(\"\\\\w+&~\\\\d+\", \"123\", false);\n712\t    test!(\"0x(~[0-9a-f]+)\", \"0yz\", false);\n713\t    test!(\"0x(~[0-9a-f]+)\", \"0x12\", false);\n714\t    test!(\"0x(~[0-9a-f]+)\", \"0x\", true);\n715\t    test!(\"0x(~[0-9a-f]+)\", \"0xy\", true);\n716\t    test!(\"0x(~[0-9a-f]+)\", \"0xyz\", true);\n717\t    test!(\"b(~a*)\", \"\", false);\n718\t    test!(\"b(~a*)\", \"b\", false);\n719\t    test!(\"b(~a*)\", \"ba\", false);\n720\t    test!(\"b(~a*)\", \"bbaa\", true);\n721\t    run_test(&Test {\n722\t        regex: \"abc>\",\n723\t        input: \"\",\n724\t        matches: false,\n725\t        errors: true,\n726\t        partial: false,\n727\t        ignorecase: false,\n728\t        complement: false,\n729\t        quick: false,\n730\t    });\n731\t    run_test(&Test {\n732\t        regex: \"<abc\",\n733\t        input: \"\",\n734\t        matches: false,\n735\t        errors: true,\n736\t        partial: false,\n737\t        ignorecase: false,\n738\t        complement: false,\n739\t        quick: false,\n740\t    });\n741\t    run_test(&Test {\n742\t        regex: \"[a?b]\",\n743\t        input: \"\",\n744\t        matches: false,\n745\t        errors: true,\n746\t        partial: false,\n747\t        ignorecase: false,\n748\t        complement: false,\n749\t        quick: false,\n750\t    });\n751\t    run_test(&Test {\n752\t        regex: \"[a-]\",\n753\t        input: \"\",\n754\t        matches: false,\n755\t        errors: true,\n756\t        partial: false,\n757\t        ignorecase: false,\n758\t        complement: false,\n759\t        quick: false,\n760\t    });\n761\t    run_test(&Test {\n762\t        regex: \"[--]\",\n763\t        input: \"\",\n764\t        matches: false,\n765\t        errors: true,\n766\t        partial: false,\n767\t        ignorecase: false,\n768\t        complement: false,\n769\t        quick: false,\n770\t    });\n771\t    run_test(&Test {\n772\t        regex: \"[-]\",\n773\t        input: \"\",\n774\t        matches: false,\n775\t        errors: true,\n776\t        partial: false,\n777\t        ignorecase: false,\n778\t        complement: false,\n779\t        quick: false,\n780\t    });\n781\t    run_test(&Test {\n782\t        regex: \"-\",\n783\t        input: \"\",\n784\t        matches: false,\n785\t        errors: true,\n786\t        partial: false,\n787\t        ignorecase: false,\n788\t        complement: false,\n789\t        quick: false,\n790\t    });\n791\t    run_test(&Test {\n792\t        regex: \"a-\",\n793\t        input: \"\",\n794\t        matches: false,\n795\t        errors: true,\n796\t        partial: false,\n797\t        ignorecase: false,\n798\t        complement: false,\n799\t        quick: false,\n800\t    });\n801\t    run_test(&Test {\n802\t        regex: \"a*{}\",\n803\t        input: \"\",\n804\t        matches: false,\n805\t        errors: true,\n806\t        partial: false,\n807\t        ignorecase: false,\n808\t        complement: false,\n809\t        quick: false,\n810\t    });\n811\t    run_test(&Test {\n812\t        regex: \"a+{}\",\n813\t        input: \"\",\n814\t        matches: false,\n815\t        errors: true,\n816\t        partial: false,\n817\t        ignorecase: false,\n818\t        complement: false,\n819\t        quick: false,\n820\t    });\n821\t    run_test(&Test {\n822\t        regex: \"a?{}\",\n823\t        input: \"\",\n824\t        matches: false,\n825\t        errors: true,\n826\t        partial: false,\n827\t        ignorecase: false,\n828\t        complement: false,\n829\t        quick: false,\n830\t    });\n831\t    run_test(&Test {\n832\t        regex: \"a{}*\",\n833\t        input: \"\",\n834\t        matches: false,\n835\t        errors: true,\n836\t        partial: false,\n837\t        ignorecase: false,\n838\t        complement: false,\n839\t        quick: false,\n840\t    });\n841\t    run_test(&Test {\n842\t        regex: \"a{}+\",\n843\t        input: \"\",\n844\t        matches: false,\n845\t        errors: true,\n846\t        partial: false,\n847\t        ignorecase: false,\n848\t        complement: false,\n849\t        quick: false,\n850\t    });\n851\t    run_test(&Test {\n852\t        regex: \"a{}?\",\n853\t        input: \"\",\n854\t        matches: false,\n855\t        errors: true,\n856\t        partial: false,\n857\t        ignorecase: false,\n858\t        complement: false,\n859\t        quick: false,\n860\t    });\n861\t    run_test(&Test {\n862\t        regex: \"a{}{}\",\n863\t        input: \"\",\n864\t        matches: false,\n865\t        errors: true,\n866\t        partial: false,\n867\t        ignorecase: false,\n868\t        complement: false,\n869\t        quick: false,\n870\t    });\n871\t    run_test(&Test {\n872\t        regex: \"a{2,1}\",\n873\t        input: \"\",\n874\t        matches: false,\n875\t        errors: true,\n876\t        partial: false,\n877\t        ignorecase: false,\n878\t        complement: false,\n879\t        quick: false,\n880\t    });\n881\t    run_test(&Test {\n882\t        regex: \"a{1 2}\",\n883\t        input: \"\",\n884\t        matches: false,\n885\t        errors: true,\n886\t        partial: false,\n887\t        ignorecase: false,\n888\t        complement: false,\n889\t        quick: false,\n890\t    });\n891\t    run_test(&Test {\n892\t        regex: \"a{1, 2}\",\n893\t        input: \"\",\n894\t        matches: false,\n895\t        errors: true,\n896\t        partial: false,\n897\t        ignorecase: false,\n898\t        complement: false,\n899\t        quick: false,\n900\t    });\n901\t    run_test(&Test {\n902\t        regex: \"a{a}\",\n903\t        input: \"\",\n904\t        matches: false,\n905\t        errors: true,\n906\t        partial: false,\n907\t        ignorecase: false,\n908\t        complement: false,\n909\t        quick: false,\n910\t    });\n911\t    run_test(&Test {\n912\t        regex: \"a~b\",\n913\t        input: \"\",\n914\t        matches: false,\n915\t        errors: true,\n916\t        partial: false,\n917\t        ignorecase: false,\n918\t        complement: false,\n919\t        quick: false,\n920\t    });\n921\t\n922\t    // realistic regexes\n923\t    const HEX_RGB: &str = \"#([0-9a-fA-F]{3}){1,2}\";\n924\t    test!(HEX_RGB, \"000\", false);\n925\t    test!(HEX_RGB, \"#0aA\", true);\n926\t    test!(HEX_RGB, \"#00ff\", false);\n927\t    test!(HEX_RGB, \"#abcdef\", true);\n928\t    test!(HEX_RGB, \"#abcdeff\", false);\n929\t\n930\t    // big define fields for CONV_SPEC, PRINTF_FMT, etc.\n931\t    const FIELD_WIDTH: &str = \"(\\\\*|1-90-9*)?\";\n932\t    const PRECISION: &str = \"(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?\";\n933\t    const DI: &str = \"[\\\\-\\\\+ 0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[di]\";\n934\t    const U: &str = \"[\\\\-0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?u\";\n935\t    const OX: &str = \"[\\\\-#0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[oxX]\";\n936\t    const FEGA: &str = \"[\\\\-\\\\+ #0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?[lL]?[fFeEgGaA]\";\n937\t    const C_: &str = \"\\\\-* (\\\\*|1-90-9*)?l?c\";\n938\t    const S_: &str = \"\\\\-*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?l?s\";\n939\t    const P: &str = \"\\\\-*(\\\\*|1-90-9*)?p\";\n940\t    const N_: &str = \"(\\\\*|1-90-9*)?([hljzt]|hh|ll)?n\";\n941\t    // We'll do some slightly simplified merges:\n942\t    // Actually let's just define the final:\n943\t    // const CONV_SPEC: &str = &((\"%(\".to_owned() + DI + \"|\" + U + \"|\" + OX + \"|\" + FEGA + \"|\" + C_ + \"|\" + S_ + \"|\" + P + \"|\" + N_ + \"|%)\").to_string());\n944\t    // test!(CONV_SPEC, \"%\", false);\n945\t    // test!(CONV_SPEC, \"%*\", false);\n946\t    // test!(CONV_SPEC, \"%%\", true);\n947\t    // test!(CONV_SPEC, \"%5%\", false);\n948\t    // test!(CONV_SPEC, \"%p\", true);\n949\t    // test!(CONV_SPEC, \"%*p\", true);\n950\t    // test!(CONV_SPEC, \"% *p\", false);\n951\t    // test!(CONV_SPEC, \"%5p\", true);\n952\t    // test!(CONV_SPEC, \"d\", false);\n953\t    // test!(CONV_SPEC, \"%d\", true);\n954\t    // test!(CONV_SPEC, \"%.16s\", true);\n955\t    // test!(CONV_SPEC, \"% 5.3f\", true);\n956\t    // test!(CONV_SPEC, \"%*32.4g\", false);\n957\t    // test!(CONV_SPEC, \"%-#65.4g\", true);\n958\t    // test!(CONV_SPEC, \"%03c\", false);\n959\t    // test!(CONV_SPEC, \"%06i\", true);\n960\t    // test!(CONV_SPEC, \"%lu\", true);\n961\t    // test!(CONV_SPEC, \"%hhu\", true);\n962\t    // test!(CONV_SPEC, \"%Lu\", false);\n963\t    // test!(CONV_SPEC, \"%-*p\", true);\n964\t    // test!(CONV_SPEC, \"%-.*p\", false);\n965\t    // test!(CONV_SPEC, \"%id\", false);\n966\t    // test!(CONV_SPEC, \"%%d\", false);\n967\t    // test!(CONV_SPEC, \"i%d\", false);\n968\t    // test!(CONV_SPEC, \"%c%s\", false);\n969\t    // test!(CONV_SPEC, \"%0n\", false);\n970\t    // test!(CONV_SPEC, \"% u\", false);\n971\t    // test!(CONV_SPEC, \"%+c\", false);\n972\t    // test!(CONV_SPEC, \"%0-++ 0i\", true);\n973\t    // test!(CONV_SPEC, \"%30c\", true);\n974\t    // test!(CONV_SPEC, \"%03c\", false);\n975\t\n976\t    // const PRINTF_FMT: &str = \"(^%|%(\"\n977\t    //     \"([\\\\-\\\\+ 0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[di]\"\n978\t    //     \"|[\\\\-0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?u\"\n979\t    //     \"|[\\\\-#0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[oxX]\"\n980\t    //     \"|[\\\\-\\\\+ #0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?[lL]?[fFeEgGaA]\"\n981\t    //     \"|\\\\-* (\\\\*|1-90-9*)?l?c\"\n982\t    //     \"|\\\\-*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?l?s\"\n983\t    //     \"|\\\\-*(\\\\*|1-90-9*)?p\"\n984\t    //     \"|(\\\\*|1-90-9*)?([hljzt]|hh|ll)?n\"\n985\t    //     \"|%))*)\";\n986\t\n987\t    // test!(PRINTF_FMT, \"%\", false, .quick = true);\n988\t    // test!(PRINTF_FMT, \"%*\", false, .quick = true);\n989\t    // test!(PRINTF_FMT, \"%%\", true, .quick = true);\n990\t    // test!(PRINTF_FMT, \"%5%\", false, .quick = true);\n991\t    // test!(PRINTF_FMT, \"%id\", true, .quick = true);\n992\t    // test!(PRINTF_FMT, \"%%d\", true, .quick = true);\n993\t    // test!(PRINTF_FMT, \"i%d\", true, .quick = true);\n994\t    // test!(PRINTF_FMT, \"%c%s\", true, .quick = true);\n995\t    // test!(PRINTF_FMT, \"%u + %d\", true, .quick = true);\n996\t    // test!(PRINTF_FMT, \"%d:\", true, .quick = true);\n997\t\n998\t    // ISO/IEC 9899:TC3, $6.4.1 'Keywords' ... also &~\\d.*&~KEYWORD example\n999\t    const KEYWORD: &str = \"(auto|break|case|char|const|continue|default|do|double|else|enum|extern|\\\n1000\tfloat|for|goto|if|inline|int|long|register|restrict|return|short|signed|sizeof|static|struct|switch|\\\n1001\ttypedef|union|unsigned|void|volatile|while|_Bool|_Complex|_Imaginary)\";\n1002\t    // we define the simpler version of (\\\\w|\\\\uFFFF|\\\\UFFFFFFFF)* &~\\d.* &~ KEYWORD\n1003\t    let identifier = format!(\n1004\t        \"(\\\\\\\\w|\\\\\\\\u[0-9a-fA-F]{{4}}|\\\\\\\\U[0-9a-fA-F]{{8}})*&~\\\\\\\\d.*&~{}\",\n1005\t        KEYWORD\n1006\t    );\n1007\t    // run_test(&Test {\n1008\t    //     regex: &identifier,\n1009\t    //     input: \"_\",\n1010\t    //     matches: true,\n1011\t    //     errors: false,\n1012\t    //     partial: false,\n1013\t    //     ignorecase: false,\n1014\t    //     complement: false,\n1015\t    //     quick: false,\n1016\t    // });\n1017\t    // run_test(&Test {\n1018\t    //     regex: &identifier,\n1019\t    //     input: \"_foo\",\n1020\t    //     matches: true,\n1021\t    //     errors: false,\n1022\t    //     partial: false,\n1023\t    //     ignorecase: false,\n1024\t    //     complement: false,\n1025\t    //     quick: false,\n1026\t    // });\n1027\t    // run_test(&Test {\n1028\t    //     regex: &identifier,\n1029\t    //     input: \"_Bool\",\n1030\t    //     matches: false,\n1031\t    //     errors: false,\n1032\t    //     partial: false,\n1033\t    //     ignorecase: false,\n1034\t    //     complement: false,\n1035\t    //     quick: false,\n1036\t    // });\n1037\t    // run_test(&Test {\n1038\t    //     regex: &identifier,\n1039\t    //     input: \"a1\",\n1040\t    //     matches: true,\n1041\t    //     errors: false,\n1042\t    //     partial: false,\n1043\t    //     ignorecase: false,\n1044\t    //     complement: false,\n1045\t    //     quick: false,\n1046\t    // });\n1047\t    // run_test(&Test {\n1048\t    //     regex: &identifier,\n1049\t    //     input: \"5b\",\n1050\t    //     matches: false,\n1051\t    //     errors: false,\n1052\t    //     partial: false,\n1053\t    //     ignorecase: false,\n1054\t    //     complement: false,\n1055\t    //     quick: false,\n1056\t    // });\n1057\t    // run_test(&Test {\n1058\t    //     regex: &identifier,\n1059\t    //     input: \"if\",\n1060\t    //     matches: false,\n1061\t    //     errors: false,\n1062\t    //     partial: false,\n1063\t    //     ignorecase: false,\n1064\t    //     complement: false,\n1065\t    //     quick: false,\n1066\t    // });\n1067\t    // run_test(&Test {\n1068\t    //     regex: &identifier,\n1069\t    //     input: \"ifa\",\n1070\t    //     matches: true,\n1071\t    //     errors: false,\n1072\t    //     partial: false,\n1073\t    //     ignorecase: false,\n1074\t    //     complement: false,\n1075\t    //     quick: false,\n1076\t    // });\n1077\t    // run_test(&Test {\n1078\t    //     regex: &identifier,\n1079\t    //     input: \"bif\",\n1080\t    //     matches: true,\n1081\t    //     errors: false,\n1082\t    //     partial: false,\n1083\t    //     ignorecase: false,\n1084\t    //     complement: false,\n1085\t    //     quick: false,\n1086\t    // });\n1087\t    // run_test(&Test