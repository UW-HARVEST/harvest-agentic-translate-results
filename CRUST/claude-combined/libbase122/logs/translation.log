5\t    size_t ret = bitreader_read(&reader, 7, &got);\n66\t    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n67\t    size_t expect_len;\n68\t    byte *expect = bitstring_to_bytes(\"01111111\", &expect_len);\n69\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n70\t    free(expect);\n71\t\n72\t    ret = bitreader_read(&reader, 7, &got);\n73\t    ASSERT(ret == 1, \"expected ret to be 1, got: %zu\", ret);\n74\t    expect = bitstring_to_bytes(\"00000001\", &expect_len);\n75\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n76\t    free(expect);\n77\t\n78\t    ret = bitreader_read(&reader, 7, &got);\n79\t    ASSERT(ret == 0, \"expected ret to be 0, got: %zu\", ret);\n80\t    expect = bitstring_to_bytes(\"00000000\", &expect_len);\n81\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n82\t    free(expect);\n83\t\n84\t    free(in);\n85\t  }\n86\t\n87\t  /* Two byte. */\n88\t  {\n89\t    size_t in_len;\n90\t    byte *in = bitstring_to_bytes(\"10101010 11111111\", &in_len);\n91\t    bitreader_t reader = {.in = in, .len = in_len};\n92\t    byte got;\n93\t    size_t ret = bitreader_read(&reader, 7, &got);\n94\t    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n95\t    size_t expect_len;\n96\t    byte *expect = bitstring_to_bytes(\"01010101\", &expect_len);\n97\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n98\t    free(expect);\n99\t\n100\t    ret = bitreader_read(&reader, 7, &got);\n101\t    ASSERT(ret == 7, \"expected ret to be 7, got: %zu\", ret);\n102\t    expect = bitstring_to_bytes(\"00111111\", &expect_len);\n103\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n104\t    free(expect);\n105\t\n106\t    ret = bitreader_read(&reader, 7, &got);\n107\t    ASSERT(ret == 2, \"expected ret to be 2, got: %zu\", ret);\n108\t    expect = bitstring_to_bytes(\"00000011\", &expect_len);\n109\t    ASSERT_BYTES_EQUAL(&got, 1, expect, expect_len, bitstring);\n110\t    free(expect);\n111\t\n112\t    free(in);\n113\t  }\n114\t}\n115\t\n116\tstatic void test_bitwriter_write(void) {\n117\t  /* One byte. */\n118\t  {\n119\t    size_t in_len;\n120\t    byte got[1] = {0};\n121\t    byte *in = bitstring_to_bytes(\"00001111\", &in_len);\n122\t    bitwriter_t writer = {.out = got, .len = sizeof(got)};\n123\t\n124\t    int ret = bitwriter_write(&writer, 1, *in);\n125\t    ASSERT(ret != -1, \"expected no error\");\n126\t    size_t expect_len;\n127\t    byte *expect = bitstring_to_bytes(\"10000000\", &expect_len);\n128\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n129\t    free(expect);\n130\t\n131\t    ret = bitwriter_write(&writer, 1, *in);\n132\t    ASSERT(ret != -1, \"expected no error\");\n133\t    expect = bitstring_to_bytes(\"11000000\", &expect_len);\n134\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n135\t    free(expect);\n136\t\n137\t    ret = bitwriter_write(&writer, 5, *in);\n138\t    ASSERT(ret != -1, \"expected no error\");\n139\t    expect = bitstring_to_bytes(\"11011110\", &expect_len);\n140\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n141\t    free(expect);\n142\t\n143\t    ret = bitwriter_write(&writer, 5, *in);\n144\t    ASSERT(ret == -1, \"expected exceeded capacity error, but got no error\");\n145\t\n146\t    free(in);\n147\t  }\n148\t\n149\t  /* Two byte. */\n150\t  {\n151\t    byte got[2] = {0};\n152\t    bitwriter_t writer = {.out = got, .len = sizeof(got)};\n153\t\n154\t    int ret = bitwriter_write(&writer, 1, 0xFF);\n155\t    ASSERT(ret != -1, \"expected no error\");\n156\t    size_t expect_len;\n157\t    byte *expect = bitstring_to_bytes(\"10000000 00000000\", &expect_len);\n158\t    ASSERT_BYTES_EQUAL(got, sizeof(got), expect, expect_len, bitstring);\n159\t    free(expect);\n160\t\n161\t    ret = bitwriter_write(&writer, 8, 0x0F);\n162\t    ASSERT(ret != -1, \"expected no error\");\n163\t    expect = bitstring_to_bytes(\"10000111 10000000