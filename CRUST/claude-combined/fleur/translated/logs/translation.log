initialize creates a an empty Bloom filter with the given capacity (n)\n222\t// and FP probability (p).\n223\tstruct BloomFilter fleur_initialize(uint64_t n, double p, char *buf){\n224\t    BloomFilter bf;\n225\t\n226\t    uint64_t m = fabs(ceil((double)(n) * log(p) / pow(log(2.0), 2.0)));\n227\t    uint64_t k = ceil(log(2) * m / n );\n228\t\n229\t\tbf.Data = (unsigned char*)buf; \n230\t\n231\t    bf.M = ceil(m / 64.0);\n232\t\n233\t    bf.v = calloc(bf.M, sizeof(uint64_t));\n234\t\n235\t    header h = {1, n, p, k, m, 0};\n236\t\n237\t    bf.h = h;\n238\t\n239\t    bf.modified = 0;\n240\t    return bf;\n241\t}\n242\t\n243\t// fleur_print_header prints a BloomFilter's header\n244\tvoid fleur_print_header(header * h){\n245\t    printf(\"Header details:\\n version: %lu\\n n: %lu \\n p: %f\\n k: %lu \\n m: %lu \\n N: %lu \\n\",\n246\t        h->version,\n247\t        h->n,\n248\t        h->p,\n249\t        h->k,\n250\t        h->m,\n251\t        h->N);\n252\t}\n253\t\n254\t// fleur_check_printer check a BloomFilter's header for inconsistencies\n255\tint fleur_check_header(header * h){\n256\t    if (h->version != 1){\n257\t        fprintf(stderr, \"[ERROR] Current filter version not supported.\\n\");\n258\t        return 0;\n259\t    }\n260\t    // 0111111111111111111111111111111111111111111111111111111111111111b\n261\t    uint64_t maxint = 9223372036854775807;\n262\t    if (h->k >= maxint){\n263\t        fprintf(stderr, \"[ERROR] value of k (number of hash functions) is too high.\\n\");\n264\t        return 0;\n265\t    }\n266\t    if (h->p <= __DBL_EPSILON__){\n267\t        fprintf(stderr, \"[ERROR] p is too small.\\n\");\n268\t        return 0;\n269\t    }\n270\t    if (h->p > 1){\n271\t        fprintf(stderr, \"[ERROR] p is more than one.\\n\");\n272\t        return 0;\n273\t    }\n274\t    if (h->N > h->n){\n275\t        fprintf(stderr, \"[ERROR] incoherent filter.\\n\");\n276\t        return 0;\n277\t    }\n278\t    uint64_t tmp_m = fabs(ceil((double)(h->n) * log(h