{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LA9UxZhQdHVqDkLwyX21g4","type":"tool_result","content":"1\t#include \"parser.h\"\n2\t#include \"common.h\"\n3\t#include \"../hash-table/hash_table.h\"\n4\t#include \"io.h\"\n5\t#include \"reducer.h\"\n6\t#include <string.h>\n7\t#include <math.h>\n8\t\n9\tstatic int n = 1;\n10\t\n11\ttokens_t parse_token(char token) {\n12\t  if (token == '(') {\n13\t    return L_PAREN;\n14\t  } else if (token == ')') {\n15\t    return R_PAREN;\n16\t  } else if (token == '@') {\n17\t    return LAMBDA;\n18\t  } else if (token == '.') {\n19\t    return DOT;\n20\t  } else if (is_variable(token)) {\n21\t    return VARIABLE;\n22\t  } else if (token == ' ') {\n23\t    return WHITESPACE;\n24\t  } else if (token == '\\n') {\n25\t    return NEWLINE;\n26\t  } else if (token == '=') {\n27\t    return EQ;\n28\t  } else if (token == '\"') {\n29\t    return QUOTE;\n30\t  } else if (token == ':') {\n31\t    return COLON;\n32\t  }\n33\t  return ERROR;\n34\t}\n35\t\n36\tvoid p_print_token(tokens_t token) {\n37\t  switch (token) {\n38\t  case L_PAREN:\n39\t    printf(\"( \");\n40\t    return;\n41\t\n42\t  case R_PAREN:\n43\t    printf(\") \");\n44\t    return;\n45\t\n46\t  case LAMBDA:\n47\t    printf(\"@ \");\n48\t    return;\n49\t\n50\t  case DOT:\n51\t    printf(\". \");\n52\t    return;\n53\t\n54\t  case VARIABLE:\n55\t    printf(\"VARIABLE \");\n56\t    return;\n57\t\n58\t  case WHITESPACE:\n59\t    printf(\"WHITESPACE \");\n60\t    return;\n61\t\n62\t  case NEWLINE:\n63\t    printf(\"NEWLINE \");\n64\t    return;\n65\t\n66\t  case EQ:\n67\t    printf(\"= \");\n68\t    return;\n69\t\n70\t  default:\n71\t    printf(\"ERROR \");\n72\t    return;\n73\t  }\n74\t}\n75\t\n76\tvoid p_print_astNode_type(AstNode *n) {\n77\t  switch (n->type) {\n78\t  case 0:\n79\t    printf(\"AstNode Type: LAMBDA_EXPR\\n\");\n80\t    break;\n81\t\n82\t  case 1:\n83\t    printf(\"AstNode Type: APPLICATION\\n\");\n84\t    break;\n85\t\n86\t  case 2:\n87\t    printf(\"AstNode Type: VAR\\n\");\n88\t    break;\n89\t\n90\t  case DEFINITION:\n91\t    printf(\"AstNode Type: DEFINITION\\n\");\n92\t    break;\n93\t  }\n94\t}\n95\t\n96\tvoid print_ast(AstNode *node) {\n97\t  if (node == NULL) {\n98\t    return;\n99\t  }\n100\t\n101\t  switch (node->type) {\n102\t  case LAMBDA_EXPR:\n103\t    printf(\"(LAMBDA %s : %s\", node->node.lambda_expr->parameter, node->node.lambda_expr->type);\n104\t    print_ast(node->node.lambda_expr->body);\n105\t    printf(\") \");\n106\t    break;\n107\t\n108\t  case APPLICATION:\n109\t    printf(\"(APP \");\n110\t    print_ast(node->node.application->function);\n111\t    print_ast(node->node.application->argument);\n112\t    printf(\") \");\n113\t    break;\n114\t\n115\t  case VAR:\n116\t    printf(\"(VAR %s \", node->node.variable->name);\n117\t    if (node->node.variable->type != NULL) {\n118\t      printf(\": %s\", node->node.variable->type);\n119\t    }\n120\t    printf(\")\");\n121\t    break;\n122\t\n123\t  case DEFINITION:\n124\t    printf(\"(DEFINITION %s) \", node->node.variable->name);\n125\t    break;\n126\t\n127\t  default:\n128\t    printf(\"(UNKNOWN) \");\n129\t  }\n130\t}\n131\t\n132\tbool is_variable(char token) {\n133\t  int cmp = (int)token;\n134\t  if (cmp == '_') return true;\n135\t  if ((cmp >= 97 && cmp <= 122) || (cmp >= 65 && cmp <= 90)) {\n136\t    return true;\n137\t  }\n138\t  return false;\n139\t}\n140\t\n141\tchar peek(FILE *in) {\n142\t  char c = fgetc(in);\n143\t  ungetc(c, in);\n144\t  return c;\n145\t}\n146\t\n147\tvoid peek_print(FILE *in, int n) {\n148\t    char buffer[n + 1];\n149\t    int i;\n150\t\n151\t    for (i = 0; i < n; i++) {\n152\t        int c = fgetc(in);\n153\t        if (c == EOF) {\n154\t            break;\n155\t        }\n156\t        buffer[i] = (char)c;\n157\t    }\n158\t    buffer[i] = '\\0';\n159\t\n160\t    printf(\"%s\", buffer);\n161\t\n162\t    for (i--; i >= 0; i--) {\n163\t        ungetc(buffer[i], in);\n164\t    }\n165\t}\n166\t\n167\tvoid consume(tokens_t t, FILE *in, char *expected) {\n168\t  char c = next(in);\n169\t  tokens_t p = parse_token(c);\n170\t  if (p != t) {\n171\t    expect(expected, c);\n172\t  }\n173\t}\n174\t\n175\tAstNode *create_variable(char *name, char *type) {\n176\t  AstNode *var = (AstNode *)malloc(sizeof(AstNode));\n177\t  HANDLE_NULL(var);\n178\t  var->type = VAR;\n179\t  var->node.variable = (Variable *)malloc(sizeof(Variable));\n180\t  var->node.variable->name = name;\n181\t  var->node.variable->type = type;\n182\t  return var;\n183\t}\n184\t\n185\tAstNode *create_application(AstNode *function, AstNode *argument) {\n186\t  AstNode *app = (AstNode *)malloc(sizeof(AstNode));\n187\t  HANDLE_NULL(app);\n188\t  app->type = APPLICATION;\n189\t  app->node.application = (Application *)malloc(sizeof(Application));\n190\t  app->node.application->function = function;\n191\t  app->node.application->argument = argument;\n192\t  return app;\n193\t}\n194\t\n195\tAstNode *create_lambda(char *variable, AstNode *body, char *type) {\n196\t  AstNode *lambda = (AstNode *)malloc(sizeof(AstNode));\n197\t  HANDLE_NULL(lambda);\n198\t  lambda->type = LAMBDA_EXPR;\n199\t  lambda->node.lambda_expr =\n200\t      (LambdaExpression *)malloc(sizeof(LambdaExpression));\n201\t  lambda->node.lambda_expr->parameter = variable;\n202\t  lambda->node.lambda_expr->body = body;\n203\t  lambda->node.lambda_expr->type = type;\n204\t  return lambda;\n205\t}\n206\t\n207\t// Alpha conversion -> if we have two lambda expressions with same variable\n208\t// name, change one of them to create a new variable: (@x.xx)(@x.x) ->\n209\t// (@x.xx)(@y.y) or -> (@x.xx)(@x'.x')\n210\t// Beta reduction: substitution -> we have to look for scope (@x.xy)z => zy\n211\t// Eta Conversion / reduction -> Converts between @x.(f x) and f whenever x does\n212\t// not appear free in f which means @x.(f x) = f if f does not make use of x\n213\t// @x.(@y.yy)x) is equivalent to (@y.yy) because f does not make use of x.\n214\t\n215\t// Just convert var to var_n\n216\tchar *alpha_convert(char *old) {\n217\t  int digits = (int)log10(abs(n)) + 1;\n218\t\n219\t  char *new = malloc(strlen(old) + digits + 2);\n220\t  HANDLE_NULL(new);\n221\t  char num_str[digits + 1];\n222\t\n223\t  strcpy(new, old);\n224\t\n225\t  sprintf(num_str, \"_%d\", n);\n226\t  strcat(new, num_str);\n227\t\n228\t  n++;\n229\t\n230\t  return new;\n231\t}\n232\t\n233\tbool is_used(HashTable *table, char *variable) {\n234\t  return table_exists(table, variable);\n235\t}\n236\t\n237\t\n238\tvoid parse_space_chars(FILE *in) {\n239\t  char c = peek(in);\n240\t  while (c == ' ' || c == '\\n' || c == '\\t') {\n241\t    next(in);\n242\t    c = peek(in);\n243\t  }\n244\t}\n245\t\n246\tAstNode *parse_lambda(HashTable *table, FILE *in) {\n247\t  char parameter;\n248\t  tokens_t param;\n249\t\n250\t  if (parse_token(peek(in)) != VARIABLE) {\n251\t    expect(\"A variable\", parameter);\n252\t  }\n253\t\n254\t  char *var = parse_variable(in);\n255\t  char *new_var = NULL;\n256\t  if (is_used(table, var)) {\n257\t    if (search(table, var) != NULL) {\n258\t      const char * error_msg = format(\"A definition with name %s already exists. Cannot use same name for lambda abstraction.\\n\", var);\n259\t      error(error_msg, __FILE__, __LINE__, __func__);\n260\t    }\n261\t    new_var = alpha_convert(var);\n262\t    insert(table, new_var, NULL);\n263\t  } else {\n264\t    insert(table, var, NULL);\n265\t  }\n266\t\n267\t  parse_space_chars(in);\n268\t\n269\t  consume(COLON, in, \":\");\n270\t\n271\t  parse_space_chars(in);\n272\t\n273\t  if (parse_token(peek(in)) != VARIABLE) {\n274\t    error(\"Lambda abstractions should be typed.\", __FILE__, __LINE__, __func__);\n275\t  }\n276\t  char *type = parse_type(table, in);\n277\t\n278\t  consume(DOT, in, \".\");\n279\t\n280\t  AstNode *body = parse_expression(table, in);\n281\t\n282\t  if (new_var != NULL) {\n283\t    replace(body, var, new_var);\n284\t    print_verbose(\"Alpha converted %s to %s\\n\", var, new_var);\n285\t    return create_lambda(new_var, body, type);\n286\t  }\n287\t  return create_lambda(var, body, type);\n288\t}\n289\t\n290\tAstNode *parse_expression(HashTable *table, FILE *in) {\n291\t  while (parse_token(peek(in)) == WHITESPACE || parse_token(peek(in)) == NEWLINE) {\n292\t    next(in);\n293\t  }\n294\t  tokens_t scanned = parse_token(peek(in));\n295\t\n296\t  if (scanned == ERROR) {\n297\t    printf(\"Error: %c is  a valid token\\n\", peek(in));\n298\t    exit(1);\n299\t  }\n300\t\n301\t  if (scanned == LAMBDA) {\n302\t    next(in);\n303\t    return parse_lambda(table, in);\n304\t  }\n305\t\n306\t  else if (scanned == L_PAREN) {\n307\t    // advance();\n308\t    next(in);\n309\t    AstNode *expr = parse_expression(table, in);\n310\t\n311\t    print_ast(expr);\n312\t    tokens_t next_token = parse_token(peek(in));\n313\t\n314\t    // if it is a whitespace, it is a function application\n315\t    if (next_token == WHITESPACE) {\n316\t      AstNode *expr_2 = parse_expression(table, in);\n317\t      AstNode *application = (AstNode *)malloc(sizeof(AstNode));\n318\t      application->type = APPLICATION;\n319\t      application->node.application =\n320\t          (Application *)malloc(sizeof(Application));\n321\t      application->node.application->function = expr;\n322\t      application->node.application->argument = expr_2;\n323\t\n324\t      consume(R_PAREN, in, \")\");\n325\t\n326\t      return application;\n327\t    }\n328\t    consume(R_PAREN, in, \")\");\n329\t    return expr;\n330\t  }\n331\t\n332\t  else if (scanned == VARIABLE) {\n333\t    char *var_name = parse_variable(in);\n334\t\n335\t    if (strcmp(var_name, \"def\") == 0) {\n336\t      parse_definition(table, in);\n337\t      if (peek(in) != EOF) {\n338\t        return parse_expression(table, in);\n339\t      }\n340\t      return NULL;\n341\t    } else if (strcmp(var_name, \"import\") == 0) {\n342\t      parse_import(table, in);\n343\t      if (peek(in) != EOF) {\n344\t        return parse_expression(table, in);\n345\t      }\n346\t    } else if (strcmp(var_name, \"type\") == 0) {\n347\t      parse_type_definition(table, in);\n348\t      if (peek(in) != EOF) {\n349\t        return parse_expression(table, in);\n350\t      }\n351\t    }\n352\t\n353\t    // parse variable type\n354\t    char *type = NULL;\n355\t\n356\t    parse_space_chars(in);\n357\t    // if a variable is in our table, it means its used as a bound in lambda abstraction\n358\t    // therefore should not be typed (because the lambda already type it)\n359\t    // so if it does not exist, it is a constant and should be typed\n360\t    if (!table_exists(table, var_name)) {\n361\t      if (parse_token(peek(in)) != COLON) {\n362\t        const char *error_msg = format(\"Constant Variable %s is not typed. Please provide a type.\\n\", var_name);\n363\t        error(error_msg, __FILE__, __LINE__, __func__);\n364\t      }\n365\t      consume(COLON, in, \":\");\n366\t      parse_space_chars(in);\n367\t      type = parse_type(table, in);\n368\t    }\n369\t\n370\t    AstNode *variable = create_variable(var_name, type);\n371\t    if (search(table, var_name) != NULL) {\n372\t      variable->type = DEFINITION;\n373\t    }\n374\t    return variable;\n375\t  }\n376\t  return NULL;\n377\t}\n378\t\n379\tvoid parse_import(HashTable *table, FILE *in) {\n380\t    // in this step we already parsed the string \"import\"\n381\t    char next_token;\n382\t    tokens_t n;\n383\t\n384\t    consume(WHITESPACE, in, \"a whitespace\");\n385\t\n386\t    consume(QUOTE, in, \"\\\"\");\n387\t\n388\t    char *file_path = malloc(100 * sizeof(char));\n389\t    HANDLE_NULL(file_path);\n390\t\n391\t    next_token = next(in);\n392\t    n = parse_token(next_token);\n393\t\n394\t    file_path[0] = '\\0';\n395\t    int current_length = 0;\n396\t\n397\t    while (n != QUOTE) {\n398\t      // parse the file path\n399\t      if (current_length < 100 - 1) {\n400\t        file_path[current_length] = next_token;\n401\t        current_length++;\n402\t        file_path[current_length] = '\\0';\n403\t      } else {\n404\t        const char *error_msg = \"File path is too long. Please make sure it is less than 100 characters.\";\n405\t        error(error_msg, __FILE__, __LINE__, __func__);\n406\t      }\n407\t\n408\t      next_token = next(in);\n409\t      n = parse_token(next_token);\n410\t    }\n411\t\n412\t    if (n != QUOTE) {\n413\t      expect(\"a closing quote\", next_token);\n414\t    }\n415\t\n416\t    FILE *imported_file = get_file(file_path, \"r\");\n417\t    HANDLE_NULL(imported_file);\n418\t\n419\t    char imported_tkn;\n420\t    while ((imported_tkn = peek(imported_file)) != EOF) {\n421\t      tokens_t scanned = parse_token(imported_tkn);\n422\t      parse_space_chars(imported_file);\n423\t      if (scanned == VARIABLE) {\n424\t        char *var_name = parse_variable(imported_file);\n425\t        if (strcmp(var_name, \"def\") == 0) {\n426\t          parse_definition(table, imported_file);\n427\t        } else if (strcmp(var_name, \"type\") == 0) {\n428\t          parse_type_definition(table, imported_file);\n429\t        } else {\n430\t          const char *error_msg = format(\"Expected a definition in the imported file, but got %s\\n\", var_name);\n431\t          error(error_msg, __FILE__, __LINE__, __func__);\n432\t        }\n433\t      }\n434\t    }\n435\t    return;\n436\t}\n437\t\n438\tvoid parse_definition(HashTable *table, FILE *in) {\n439\t  // at this moment the \"def\" string was already parsed\n440\t  char next_token;\n441\t  tokens_t n;\n442\t\n443\t  consume(WHITESPACE, in, \"a whitespace\");\n444\t\n445\t  if (parse_token(peek(in)) != VARIABLE) {\n446\t    expect(\"a variable\", next_token);\n447\t  }\n448\t\n449\t  char *def_name = parse_variable(in);\n450\t\n451\t  consume(WHITESPACE, in, \"a whitespace\");\n452\t\n453\t  consume(EQ, in, \"=\");\n454\t\n455\t  consume(WHITESPACE, in, \"a whitespace\");\n456\t\n457\t  AstNode *definition = parse_expression(table, in);\n458\t  insert(table, def_name, definition);\n459\t}\n460\t\n461\tbool is_uppercase(char c) {\n462\t  return c >= 'A' && c <= 'Z';\n463\t}\n464\t\n465\tvoid parse_type_definition(HashTable *types_table, FILE *in) {\n466\t  // at this point we already parsed the word \"type\"\n467\t  char next_token = next(in);\n468\t  tokens_t n = parse_token(next_token);\n469\t  if (n != WHITESPACE) {\n470\t    expect(\" \", next_token);\n471\t  }\n472\t\n473\t  next_token = peek(in);\n474\t  n = parse_token(next_token);\n475\t  if (n != VARIABLE) {\n476\t    expect(\"a type definition\", next_token);\n477\t  }\n478\t\n479\t  if (!is_uppercase(next_token)) {\n480\t    error(\"Type names must start with an uppercase letter\", __FILE__, __LINE__, __func__);\n481\t  }\n482\t\n483\t  char *type_name = parse_variable(in);\n484\t  if (table_exists(types_table, type_name)) {\n485\t    const char *error_msg = format(\"Type %s was already defined.\\n\", type_name);\n486\t    error(error_msg, __FILE__, __LINE__, __func__);\n487\t  }\n488\t  insert(types_table, type_name, NULL);\n489\t}\n490\t\n491\tchar *parse_type(HashTable *types_table, FILE *in) {\n492\t  // here we already parsed the : symbol and the whitespace after\n493\t  char *type_name = malloc(256 * sizeof(char));\n494\t  int index = 0;\n495\t  char token = next(in);\n496\t\n497\t  if (!is_uppercase(token)) {\n498\t    error(\"Types should start with an uppercase letter.\", __FILE__, __LINE__, __func__);\n499\t  }\n500\t\n501\t  type_name[index] = token;\n502\t  index++;\n503\t\n504\t  while (is_variable(peek(in))) {\n505\t    type_name[index] = next(in);\n506\t    index++;\n507\t  }\n508\t\n509\t  if (!table_exists(types_table, type_name)) {\n510\t    const char *error_msg = format(\"Type %s was not defined.\\n\", type_name);\n511\t    error(error_msg, __FILE__, __LINE__, __func__);\n512\t  }\n513\t  return type_name;\n514\t}\n515\t\n516\tchar *parse_variable(FILE *in) {\n517\t  char *variable_name = malloc(256 * sizeof(char));\n518\t  int index = 0;\n519\t\n520\t  while (is_variable(peek(in))) {\n521\t    variable_name[index] = next(in);\n522\t    index++;\n523\t  }\n524\t  return variable_name;\n525\t}\n526\t\n527\tvoid expect(char *expected, char received) {\n528\t  printf(\"Syntax Error: Expected %s , received %c \\n\", expected, received);\n529\t  exit(EXIT_FAILURE);\n530\t}\n531\t\n532\tvoid free_ast(AstNode *node) {\n533\t  if (node == NULL) {\n534\t    return;\n535\t  }\n536\t\n537\t  switch (node->type) {\n538\t  case LAMBDA_EXPR:\n539\t    if (node->node.lambda_expr != NULL) {\n540\t      free(node->node.lambda_expr->parameter);\n541\t      free_ast(node->node.lambda_expr->body);\n542\t      free(node->node.lambda_expr);\n543\t    }\n544\t    break;\n545\t\n546\t  case APPLICATION:\n547\t    if (node->node.application != NULL) {\n548\t      free_ast(node->node.application->function);\n549\t      free_ast(node->node.application->argument);\n550\t      free(node->node.application);\n551\t    }\n552\t    break;\n553\t\n554\t  case VAR:\n555\t    if (node->node.variable != NULL) {\n556\t      free(node->node.variable->name);\n557\t      free(node->node.variable);\n558\t    }\n559\t    break;\n560\t\n561\t  default:\n562\t    break;\n563\t  }\n564\t\n565\t  free(node);\n566\t}\n567\t\n568\t// Expression ::= LambdaExpression | Application | Variable\n569\t// LambdaExpression ::= \"@\" Identifier \".\" Expression\n570\t// Application ::= \"(\" Expression Expression \")\"\n571\t// Variable ::= Identifier\n572\t"}]},"parent_tool_use_id":null,"session_id":"9e554a24-cb5b-432c-83d8-da42b0c57322","uuid":"420893b8-8eac-459d-8350-066fb42883ef","timestamp":"2026-05-30T10:03:31.912Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-pc4TXG/project/c_src/src/parser.c","content":"#include \"parser.h\"\n#include \"common.h\"\n#include \"../hash-table/hash_table.h\"\n#include \"io.h\"\n#include \"reducer.h\"\n#include <string.h>\n#include <math.h>\n\nstatic int n = 1;\n\ntokens_t parse_token(char token) {\n  if (token == '(') {\n    return L_PAREN;\n  } else if (token == ')') {\n    return R_PAREN;\n  } else if (token == '@') {\n    return LAMBDA;\n  } else if (token == '.') {\n    return DOT;\n  } else if (is_variable(token)) {\n    return VARIABLE;\n  } else if (token == ' ') {\n    return WHITESPACE;\n  } else if (token == '\\n') {\n    return NEWLINE;\n  } else if (token == '=') {\n    return EQ;\n  } else if (token == '\"') {\n    return QUOTE;\n  } else if (token == ':') {\n    return COLON;\n  }\n  return ERROR;\n}\n\nvoid p_print_token(tokens_t token) {\n  switch (token) {\n  case L_PAREN:\n    printf(\"( \");\n    return;\n\n  case R_PAREN:\n    printf(\") \");\n    return;\n\n  case LAMBDA:\n    printf(\"@ \");\n    return;\n\n  case DOT:\n    printf(\". \");\n    return;\n\n  case VARIABLE:\n    printf(\"VARIABLE \");\n    return;\n\n  case WHITESPACE:\n    printf(\"WHITESPACE \");\n    return;\n\n  case NEWLINE:\n    printf(\"NEWLINE \");\n    return;\n\n  case EQ:\n    printf(\"= \");\n    return;\n\n  default:\n    printf(\"ERROR \");\n    return;\n  }\n}\n\nvoid p_print_astNode_type(AstNode *n) {\n  switch (n->type) {\n  case 0:\n    printf(\"AstNode Type: LAMBDA_EXPR\\n\");\n    break;\n\n  case 1:\n    printf(\"AstNode Type: APPLICATION\\n\");\n    break;\n\n  case 2:\n    printf(\"AstNode Type: VAR\\n\");\n    break;\n\n  case DEFINITION:\n    printf(\"AstNode Type: DEFINITION\\n\");\n    break;\n  }\n}\n\nvoid print_ast(AstNode *node) {\n  if (node == NULL) {\n    return;\n  }\n\n  switch (node->type) {\n  case LAMBDA_EXPR:\n    printf(\"(LAMBDA %s : %s\", node->node.lambda_expr->parameter, node->node.lambda_expr->type);\n    print_ast(node->node.lambda_expr->body);\n    printf(\") \");\n    break;\n\n  case APPLICATION:\n    printf(\"(APP \");\n    print_ast(node->node.application->function);\n    print_ast(node->node.application->argument);\n    printf(\") \");\n    break;\n\n  case VAR:\n    printf(\"(VAR %s \", node->node.variable->name);\n    if (node->node.variable->type != NULL) {\n      printf(\": %s\", node->node.variable->type);\n    }\n    printf(\")\");\n    break;\n\n  case DEFINITION:\n    printf(\"(DEFINITION %s) \", node->node.variable->name);\n    break;\n\n  default:\n    printf(\"(UNKNOWN) \");\n  }\n}\n\nbool is_variable(char token) {\n  int cmp = (int)token;\n  if (cmp == '_') return true;\n  if ((cmp >= 97 && cmp <= 122) || (cmp >= 65 && cmp <= 90)) {\n    return true;\n  }\n  return false;\n}\n\nchar peek(FILE *in) {\n  char c = fgetc(in);\n  ungetc(c, in);\n  return c;\n}\n\nvoid peek_print(FILE *in, int n) {\n    char buffer[n + 1];\n    int i;\n\n    for (i = 0; i < n; i++) {\n        int c = fgetc(in);\n        if (c == EOF) {\n            break;\n        }\n        buffer[i] = (char)c;\n    }\n    buffer[i] = '\\0';\n\n    printf(\"%s\", buffer);\n\n    for (i--; i >= 0; i--) {\n        ungetc(buffer[i], in);\n    }\n}\n\nvoid consume(tokens_t t, FILE *in, char *expected) {\n  char c = next(in);\n  tokens_t p = parse_token(c);\n  if (p != t) {\n    expect(expected, c);\n  }\n}\n\nAstNode *create_variable(char *name, char *type) {\n  AstNode *var = (AstNode *)malloc(sizeof(AstNode));\n  HANDLE_NULL(var);\n  var->type = VAR;\n  var->node.variable = (Variable *)malloc(sizeof(Variable));\n  var->node.variable->name = name;\n  var->node.variable->type = type;\n  return var;\n}\n\nAstNode *create_application(AstNode *function, AstNode *argument) {\n  AstNode *app = (AstNode *)malloc(sizeof(AstNode));\n  HANDLE_NULL(app);\n  app->type = APPLICATION;\n  app->node.application = (Application *)malloc(sizeof(Application));\n  app->node.application->function = function;\n  app->node.application->argument = argument;\n  return app;\n}\n\nAstNode *create_lambda(char *variable, AstNode *body, char *type) {\n  AstNode *lambda = (AstNode *)malloc(sizeof(AstNode));\n  HANDLE_NULL(lambda);\n  lambda->type = LAMBDA_EXPR;\n  lambda->node.lambda_expr =\n      (LambdaExpression *)malloc(sizeof(LambdaExpression));\n  lambda->node.lambda_expr->parameter = variable;\n  lambda->node.lambda_expr->body = body;\n  lambda->node.lambda_expr->type = type;\n  return lambda;\n}\n\n// Alpha conversion -> if we have two lambda expressions with same variable\n// name, change one of them to create a new variable: (@x.xx)(@x.x) ->\n// (@x.xx)(@y.y) or -> (@x.xx)(@x'.x')\n// Beta reduction: substitution -> we have to look for scope (@x.xy)z => zy\n// Eta Conversion / reduction -> Converts between @x.(f x) and f whenever x does\n// not appear free in f which means @x.(f x) = f if f does not make use of x\n// @x.(@y.yy)x) is equivalent to (@y.yy) because f does not make use of x.\n\n// Just convert var to var_n\nchar *alpha_convert(char *old) {\n  int digits = (int)log10(abs(n)) + 1;\n\n  char *new = malloc(strlen(old) + digits + 2);\n  HANDLE_NULL(new);\n  char num_str[digits + 1];\n\n  strcpy(new, old);\n\n  sprintf(num_str, \"_%d\", n);\n  strcat(new, num_str);\n\n  n++;\n\n  return new;\n}\n\nbool is_used(HashTable *table, char *variable) {\n  return table_exists(table, variable);\n}\n\n\nvoid parse_space_chars(FILE *in) {\n  char c = peek(in);\n  while (c == ' ' || c == '\\n' || c == '\\t') {\n    next(in);\n    c = peek(in);\n  }\n}\n\nAstNode *parse_lambda(HashTable *table, FILE *in) {\n  char parameter;\n  tokens_t param;\n\n  if (parse_token(peek(in)) != VARIABLE) {\n    expect(\"A variable\", parameter);\n  }\n\n  char *var = parse_variable(in);\n  char *new_var = NULL;\n  if (is_used(table, var)) {\n    if (search(table, var) != NULL) {\n      const char * error_msg = format(\"A definition with name %s already exists. Cannot use same name for lambda abstraction.\\n\", var);\n      error(error_msg, __FILE__, __LINE__, __func__);\n    }\n    new_var = alpha_convert(var);\n    insert(table, new_var, NULL);\n  } else {\n    insert(table, var, NULL);\n  }\n\n  parse_space_chars(in);\n\n  consume(COLON, in, \":\");\n\n  parse_space_chars(in);\n\n  if (parse_token(peek(in)) != VARIABLE) {\n    error(\"Lambda abstractions should be typed.\", __FILE__, __LINE__, __func__);\n  }\n  char *type = parse_type(table, in);\n\n  consume(DOT, in, \".\");\n\n  AstNode *body = parse_expression(table, in);\n\n  if (new_var != NULL) {\n    replace(body, var, new_var);\n    print_verbose(\"Alpha converted %s to %s\\n\", var, new_var);\n    return create_lambda(new_var, body, type);\n  }\n  return create_lambda(var, body, type);\n}\n\nAstNode *parse_expression(HashTable *table, FILE *in) {\n  while (parse_token(peek(in)) == WHITESPACE || parse_token(peek(in)) == NEWLINE) {\n    next(in);\n  }\n  tokens_t scanned = parse_token(peek(in));\n\n  if (scanned == ERROR) {\n    printf(\"Error: %c is  a valid token\\n\", peek(in));\n    exit(1);\n  }\n\n  if (scanned == LAMBDA) {\n    next(in);\n    return parse_lambda(table, in);\n  }\n\n  else if (scanned == L_PAREN) {\n    // advance();\n    next(in);\n    AstNode *expr = parse_expression(table, in);\n\n    print_ast(expr);\n    tokens_t next_token = parse_token(peek(in));\n\n    // if it is a whitespace, it is a function application\n    if (next_token == WHITESPACE) {\n      AstNode *expr_2 = parse_expression(table, in);\n      AstNode *application = (AstNode *)malloc(sizeof(AstNode));\n      application->type = APPLICATION;\n      application->node.application =\n          (Application *)malloc(sizeof(Application));\n      application->node.application->function = expr;\n      application->node.application->argument = expr_2;\n\n      consume(R_PAREN, in, \")\");\n\n      return application;\n    }\n    consume(R_PAREN, in, \")\");\n    return expr;\n  }\n\n  else if (scanned == VARIABLE) {\n    char *var_name = parse_variable(in);\n\n    if (strcmp(var_name, \"def\") == 0) {\n      parse_definition(table, in);\n      if (peek(in) != EOF) {\n        return parse_expression(table, in);\n      }\n      return NULL;\n    } else if (strcmp(var_name, \"import\") == 0) {\n      parse_import(table, in);\n      if (peek(in) != EOF) {\n        return parse_expression(table, in);\n      }\n    } else if (strcmp(var_name, \"type\") == 0) {\n      parse_type_definition(table, in);\n      if (peek(in) != EOF) {\n        return parse_expression(table, in);\n      }\n    }\n\n    // parse variable type\n    char *type = NULL;\n\n    parse_space_chars(in);\n    // if a variable is in our table, it means its used as a bound in lambda abstraction\n    // therefore should not be typed (because the lambda already type it)\n    // so if it does not exist, it is a constant and should be typed\n    if (!table_exists(table, var_name)) {\n      if (parse_token(peek(in)) != COLON) {\n        const char *error_msg = format(\"Constant Variable %s is not typed. Please provide a type.\\n\", var_name);\n        error(error_msg, __FILE__, __LINE__, __func__);\n      }\n      consume(COLON, in, \":\");\n      parse_space_chars(in);\n      type = parse_type(table, in);\n    }\n\n    AstNode *variable = create_variable(var_name, type);\n    if (search(table, var_name) != NULL) {\n      variable->type = DEFINITION;\n    }\n    return variable;\n  }\n  return NULL;\n}\n\nvoid parse_import(HashTable *table, FILE *in) {\n    // in this step we already parsed the string \"import\"\n    char next_token;\n    tokens_t n;\n\n    consume(WHITESPACE, in, \"a whitespace\");\n\n    consume(QUOTE, in, \"\\\"\");\n\n    char *file_path = malloc(100 * sizeof(char));\n    HANDLE_NULL(file_path);\n\n    next_token = next(in);\n    n = parse_token(next_token);\n\n    file_path[0] = '\\0';\n    int current_length = 0;\n\n    while (n != QUOTE) {\n      // parse the file path\n      if (current_length < 100 - 1) {\n        file_path[current_length] = next_token;\n        current_length++;\n        file_path[current_length] = '\\0';\n      } else {\n        const char *error_msg = \"File path is too long. Please make sure it is less than 100 characters.\";\n        error(error_msg, __FILE__, __LINE__, __func__);\n      }\n\n      next_token = next(in);\n      n = parse_token(next_token);\n    }\n\n    if (n != QUOTE) {\n      expect(\"a closing quote\", next_token);\n    }\n\n    FILE *imported_file = get_file(file_path, \"r\");\n    HANDLE_NULL(imported_file);\n\n    char imported_tkn;\n    while ((imported_tkn = peek(imported_file)) != EOF) {\n      tokens_t scanned = parse_token(imported_tkn);\n      parse_space_chars(imported_file);\n      if (scanned == VARIABLE) {\n        char *var_name = parse_variable(imported_file);\n        if (strcmp(var_name, \"def\") == 0) {\n          parse_definition(table, imported_file);\n        } else if (strcmp(var_name, \"type\") == 0) {\n          parse_type_definition(table, imported_file);\n        } else {\n          const char *error_msg = format(\"Expected a definition in the imported file, but got %s\\n\", var_name);\n          error(error_msg, __FILE__, __LINE__, __func__);\n        }\n      }\n    }\n    return;\n}\n\nvoid parse_definition(HashTable *table, FILE *in) {\n  // at this moment the \"def\" string was already parsed\n  char next_token;\n  tokens_t n;\n\n  consume(WHITESPACE, in, \"a whitespace\");\n\n  if (parse_token(peek(in)) != VARIABLE) {\n    expect(\"a variable\", next_token);\n  }\n\n  char *def_name = parse_variable(in);\n\n  consume(WHITESPACE, in, \"a whitespace\");\n\n  consume(EQ, in, \"=\");\n\n  consume(WHITESPACE, in, \"a whitespace\");\n\n  AstNode *definition = parse_expression(table, in);\n  insert(table, def_name, definition);\n}\n\nbool is_uppercase(char c) {\n  return c >= 'A' && c <= 'Z';\n}\n\nvoid parse_type_definition(HashTable *types_table, FILE *in) {\n  // at this point we already parsed the word \"type\"\n  char next_token = next(in);\n  tokens_t n = parse_token(next_token);\n  if (n != WHITESPACE) {\n    expect(\" \", next_token);\n  }\n\n  next_token = peek(in);\n  n = parse_token(next_token);\n  if (n != VARIABLE) {\n    expect(\"a type definition\", next_token);\n  }\n\n  if (!is_uppercase(next_token)) {\n    error(\"Type names must start with an uppercase letter\", __FILE__, __LINE__, __func__);\n  }\n\n  char *type_name = parse_variable(in);\n  if (table_exists(types_table, type_name)) {\n    const char *error_msg = format(\"Type %s was already defined.\\n\", type_name);\n    error(error_msg, __FILE__, __LINE__, __func__);\n  }\n  insert(types_table, type_name, NULL);\n}\n\nchar *parse_type(HashTable *types_table, FILE *in) {\n  // here we already parsed the : symbol and the whitespace after\n  char *type_name = malloc(256 * sizeof(char));\n  int index = 0;\n  char token = next(in);\n\n  if (!is_uppercase(token)) {\n    error(\"Types should start with an uppercase letter.\", __FILE__, __LINE__, __func__);\n  }\n\n  type_name[index] = token;\n  index++;\n\n  while (is_variable(peek(in))) {\n    type_name[index] = next(in);\n    index++;\n  }\n\n  if (!table_exists(types_table, type_name)) {\n    const char *error_msg = format(\"Type %s was not defined.\\n\", type_name);\n    error(error_msg, __FILE__, __LINE__, __func__);\n  }\n  return type_name;\n}\n\nchar *parse_variable(FILE *in) {\n  char *variable_name = malloc(256 * sizeof(char));\n  int index = 0;\n\n  while (is_variable(peek(in))) {\n    variable_name[index] = next(in);\n    index++;\n  }\n  return variable_name;\n}\n\nvoid expect(char *expected, char received) {\n  printf(\"Syntax Error: Expected %s , received %c \\n\", expected, received);\n  exit(EXIT_FAILURE);\n}\n\nvoid free_ast(AstNode *node) {\n  if (node == NULL) {\n    return;\n  }\n\n  switch (node->type) {\n  case LAMBDA_EXPR:\n    if (node->node.lambda_expr != NULL) {\n      free(node->node.lambda_expr->parameter);\n      free_ast(node->node.lambda_expr->body);\n      free(node->node.lambda_expr);\n    }\n    break;\n\n  case APPLICATION:\n    if (node->node.application != NULL) {\n      free_ast(node->node.application->function);\n      free_ast(node->node.application->argument);\n      free(node->node.application);\n    }\n    break;\n\n  case VAR:\n    if (node->node.variable != NULL) {\n      free(node->node.variable->name);\n      free(node->node.variable);\n    }\n    break;\n\n  default:\n    break;\n  }\n\n  free(node);\n}\n\n// Expression ::= LambdaExpression | Application | Variable\n// LambdaExpression ::= \"@\" Identifier \".\" Expression\n// Application ::= \"(\" Expression Expression \")\"\n// Variable ::= Identifier\n","numLines":572,"startLine":1,"totalLines":572}}}
