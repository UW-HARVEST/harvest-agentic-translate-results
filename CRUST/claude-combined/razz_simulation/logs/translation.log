      hand.iterate_hand(length_trimmer);\n55\t        hand.get_max_rank_of_hand()\n56\t    }\n57\t\n58\t    pub fn simulate_razz_game<T>(\n59\t        decided_cards: &DecidedCards,\n60\t        game_count: u64,\n61\t        arg: &mut T,\n62\t        listener: RankListener<T>,\n63\t    ) -> i32 {\n64\t        let mut my_hand = match CardHand::create_hand(RAZZ_CARD_IN_HAND_COUNT, sort_card_by_rank) {\n65\t            Some(h) => h,\n66\t            None => return 1,\n67\t        };\n68\t\n69\t        for _ in 0..game_count {\n70\t            let mut deck = match CardDeck::create_shuffled_deck() {\n71\t                Some(d) => d,\n72\t                None => return 1,\n73\t            };\n74\t            strip_deck(&mut deck, decided_cards);\n75\t            complete_hand(&mut my_hand, decided_cards, &mut deck);\n76\t            let r = get_razz_rank(&mut my_hand);\n77\t            listener(arg, r);\n78\t            my_hand.reset_hand();\n79\t        }\n80\t        0\n81\t    }\n82\t\n83\t    pub fn strip_deck(deck: &mut CardDeck, decided_cards: &DecidedCards) {\n84\t        for i in 0..decided_cards.my_card_count as usize {\n85\t            if let Some(card) = decided_cards.my_cards[i] {\n86\t                deck.strip_card_from_deck(card.get_card_suit_rank());\n87\t            }\n88\t        }\n89\t        for i in 0..decided_cards.opponent_card_count as usize {\n90\t            if let Some(card) = decided_cards.opponent_cards[i] {\n91\t                deck.strip_card_from_deck(card.get_card_suit_rank());\n92\t            }\n93\t        }\n94\t    }\n95\t\n96\t    pub fn complete_hand(\n97\t        my_hand: &mut CardHand,\n98\t        decided_cards: &DecidedCards,\n99\t        deck: &mut CardDeck,\n100\t    ) {\n101\t        let end = decided_cards.my_card_count as usize;\n102\t        for i in 0..end {\n103\t            my_hand.insert_into_hand(&decided_cards.my_cards[i]);\n104\t        }\n105\t        let remaining = (RAZZ_CARD_IN_HAND_COUNT as usize).saturating_s