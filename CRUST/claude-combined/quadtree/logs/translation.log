      self.root = None;\n            self.length = 0;\n        }\n        pub fn quadtree_search(&self, x: f64, y: f64) -> &mut Option<Box<QuadtreePoint>> {\n            // Signature constrains us to `&self` returning `&mut`, so we use\n            // raw-pointer based interior mutation.\n            let this = self as *const Self as *mut Self;\n            unsafe {\n                let tree = &mut *this;\n                let root = tree.root.as_deref_mut().expect(\"quadtree has no root\");\n                let r = do_search(root as *mut _, x, y);\n                if !r.is_null() {\n                    return &mut *r;\n                }\n                // Not found: return a reference to the root's `point` field\n                // (which may be None or Some, but is not the matching point).\n                &mut root.point\n            }\n        }\n        pub fn quadtree_insert(&self, x: f64, y: f64, key: Option<T>) -> bool {\n            // Signature constrains us to `&self`, but insertion mutates.\n            let this = self as *const Self as *mut Self;\n            unsafe {\n                let tree = &mut *this;\n                let Some(root) = tree.root.as_deref_mut() else {\n                    return false;\n                };\n                if !node_contains_internal(root, x, y) {\n                    return false;\n                }\n                let status = do_insert(root, x, y, key);\n                if status == 1 {\n                    tree.length += 1;\n                }\n                status != 0\n            }\n        }\n        pub fn quadtree_walk(\n            &self,\n            descent: fn(&mut Option<Box<QuadtreeNode<T>>>),\n            ascent: fn(&mut Option<Box<QuadtreeNode<T>>>),\n        ) {\n            let this = self as *const Self as *mut Self;\n            unsafe {\n                let tree = &mut *this;\n                do_walk(&mut tree.root, descent, ascent);\n            }\n        }\n    }\n}\n// Helper function\npub