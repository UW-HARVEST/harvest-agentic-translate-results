id test_surrogate_rejection() {\n58\t  utf8_validity validity;\n59\t\n60\t  validity = validate_utf8(\"\\xED\\xA0\\x80\");\n61\t  assert(validity.valid == false);\n62\t  assert(validity.valid_upto == 0);\n63\t\n64\t  validity = validate_utf8(\"\\xED\\xAC\\x80\");\n65\t  assert(validity.valid == false);\n66\t  assert(validity.valid_upto == 0);\n67\t\n68\t  validity = validate_utf8(\"\\xED\\xA0\\x8C\");\n69\t  assert(validity.valid == false);\n70\t  assert(validity.valid_upto == 0);\n71\t\n72\t  validity = validate_utf8(\"\\xED\\xBF\\xBF\");\n73\t  assert(validity.valid == false);\n74\t  assert(validity.valid_upto == 0);\n75\t}\n76\t\n77\tvoid test_validate_utf8_err() {\n78\t  utf8_validity validity = validate_utf8(\"Hello Здравствуйте\\xC0\\xC0 こんにちは 🚩😁\");\n79\t  assert(validity.valid == false);\n80\t  assert(validity.valid_upto == 5 + 1 + 12 * 2);\n81\t}\n82\t\n83\tvoid assert_overlong_encodings(utf8_char actual, utf8_char overlong) {\n84\t  assert(unicode_code_point(actual) == unicode_code_point(overlong));\n85\t\n86\t  utf8_validity validity;\n87\t\n88\t  validity = validate_utf8(actual.str);\n89\t  assert(validity.valid == true);\n90\t  assert(validity.valid_upto == actual.byte_len);\n91\t\n92\t  validity = validate_utf8(overlong.str);\n93\t  assert(validity.valid == false);\n94\t  assert(validity.valid_upto == 0);\n95\t}\n96\t\n97\tvoid test_validate_utf8_overlong_encoding_err() {\n98\t  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xC1\\x88\", .byte_len = 2 });\n99\t  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xE0\\x81\\x88\", .byte_len = 3 });\n100\t  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xF0\\x80\\x81\\x88\", .byte_len = 4 });\n101\t\n102\t  assert_overlong_encodings((utf8_char) { .str = \"д\", .byte_len = 2 }, (utf8_char) { .str = \"\\xE0\\x90\\xB4\", .byte_len = 3 });\n103\t  assert_overlong_encodings((utf8_char) { .str = \"д\", .byte_len = 2 }, (utf8_char) { .str = \"\\xF0\\x80\\x90\\xB4\", .byte_len = 4 });\n104\t\n105\t  assert_overlong_encodings((utf8_char) { .str = \"こ\", .byte_len = 3 }, (utf8_char) { .str = \"\\xF0\\x83\\x81\\x93\", .byte_len = 4 });\n106\t\n107\t  // boundary characters\n108\t  assert_overlong_encodings((utf8_char) { .str = \"\\x7F\", .byte_len = 1 }, (utf8_char) { .str = \"\\xC1\\xBF\", .byte_len = 2 }); // last 1b, last 1b overlong\n109\t  assert_overlong_encodings((utf8_char) { .str = \"\\xDF\\xBF\", .byte_len = 2 }, (utf8_char) { .str = \"\\xE0\\x9F\\xBF\", .byte_len = 3 }); // last 2b, last 2b overlong\n110\t  assert_overlong_encodings((utf8_char) { .str = \"\\xEF\\xBF\\xBF\", .byte_len = 3 }, (utf8_char) { .str = \"\\xF0\\x8F\\xBF\\xBF\", .byte_len = 4 }); // last 3b, last 3b overlong\n111\t}\n112\t\n113\tvoid test_make_utf8_string_ok() {\n114\t  const char* str = \"Hello Здравствуйте こんにちは 🚩😁\";\n115\t  utf8_string ustr = make_utf8_string(str);\n116\t  assert(ustr.byte_len == 5 + 1 + 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n117\t  assert(strcmp(ustr.str, str) == 0);\n118\t}\n119\t\n120\tvoid test_make_utf8_string_err() {\n121\t  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте\\xC0\\xC0 こんにちは 🚩😁\");\n122\t  assert(ustr.str == NULL);\n123\t  assert(ustr.byte_len == 0);\n124\t}\n125\t\n126\tvoid test_make_utf8_string_lossy_ok() {\n127\t    const char* str = \"Hello Здравствуйте こんにちは 🚩😁\";\n128\t    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n129\t    assert(owned_ustr.byte_len == 5 + 1 + 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n130\t    assert(strcmp(owned_ustr.str, str) == 0);\n131\t    free_owned_utf8_string(&owned_ustr);\n132\t}\n133\t\n134\tvoid test_make_utf8_string_lossy_invalid_sequence() {\n135\t    const char* str = \"\\xC0He\\xC0llo Здр\\xC0авствуйте\\xC0\\xC0 こんに\\xC0\\xC0\\xC0\\xC0ちは 🚩\\xC0😁\\xC0\";\n136\t    const char* expected = \"�He�llo Здр�авствуйте�� こんに����ちは 🚩�😁�\";\n137\t\n138\t    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n139\t\n140\t    assert(owned_ustr.byte_len == strlen(expected));\n141\t    assert(strcmp(owned_ustr.str, expected) == 0);\n142\t    free_owned_utf8_string(&owned_ustr);\n143\t}\n144\t\n145\tvoid test_make_utf8_string_lossy_completely_invalid() {\n146\t    const char* str = \"\\xC0\\xC0\\xC0\\xC0\";\n147\t    const char* expected = \"����\";\n148\t\n149\t    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n150\t\n151\t    assert(owned_ustr.byte_len == strlen(expected));\n152\t    assert(strcmp(owned_ustr.str, expected) == 0);\n153\t    free_owned_utf8_string(&owned_ustr);\n154\t}\n155\t\n156\tvoid test_make_utf8_string_slice_ok() {\n157\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n158\t  utf8_string slice = slice_utf8_string(str, 6, 24);\n159\t  assert(slice.byte_len == 12 * 2);\n160\t  assert(strncmp(slice.str, \"Здравствуйте\", slice.byte_len) == 0);\n161\t}\n162\t\n163\tvoid test_make_utf8_string_slice_start_out_of_bounds_ok() {\n164\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n165\t  utf8_string slice = slice_utf8_string(str, 1000, 1);\n166\t  assert(slice.byte_len == 0);\n167\t  assert(strcmp(slice.str, \"\") == 0);\n168\t}\n169\t\n170\tvoid test_make_utf8_string_slice_end_out_of_bounds_ok() {\n171\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n172\t  utf8_string slice = slice_utf8_string(str, 6, 1000);\n173\t  assert(slice.byte_len == 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n174\t  assert(strncmp(slice.str, \"Здравствуйте こんにちは 🚩😁\", slice.byte_len) == 0);\n175\t}\n176\t\n177\tvoid test_make_utf8_string_slice_start_non_boundary_err() {\n178\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n179\t  utf8_string slice = slice_utf8_string(str, 7, 3);\n180\t  assert(slice.str == NULL);\n181\t  assert(slice.byte_len == 0);\n182\t}\n183\t\n184\tvoid test_make_utf8_string_slice_end_non_boundary_err() {\n185\t  utf8_