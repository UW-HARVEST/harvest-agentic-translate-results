rt(!strcmp(((BLT_IT *)p)->key, it->key));\n163\t  return blt_firstlast(other, 1);\n164\t}\n165\t\n166\t// Walk down the tree as if the key is there.\n167\tstatic inline BLT_IT *confident_get(BLT *blt, char *key) {\n168\t  if (blt->empty) return 0;\n169\t  blt_node_ptr p = blt->root;\n170\t  int keylen = strlen(key);\n171\t  while (p->is_internal) {\n172\t    // When p->byte >= keylen, key is absent, but we must return something.\n173\t    // Either kid works; we pick 0 each time.\n174\t    p = p->byte < keylen && (key[p->byte] & p->mask) ? p->kid + 1 : p->kid;\n175\t  }\n176\t  return (void *)p;\n177\t}\n178\t\n179\tBLT_IT *blt_ceilfloor(BLT *blt, char *key, int way) {\n180\t  BLT_IT *p = confident_get(blt, key);\n181\t  if (!p) return 0;\n182\t  // Compare keys.\n183\t  for(char *c = key, *pc = p->key;; c++, pc++) {\n184\t    // XOR the current bytes being compared.\n185\t    uint8_t x = *c ^ *pc;\n186\t    if (x) {\n187\t      int byte = c - key;\n188\t      x = to_mask(x);\n189\t      // Walk down the tree until we hit an external node or a node\n190\t      // whose crit bit is higher.\n191\t      blt_node_ptr p = blt->root, other = 0;\n192\t      while (p->is_internal) {\n193\t        if ((byte << 8) + p->mask < (p->byte << 8) + x) break;\n194\t        int dir = !!(p->mask & key[p->byte]);\n195\t        blt_node_ptr q = p->kid;\n196\t        if (dir == way) other = q + 1 - way;\n197\t        p = q + dir;\n198\t      }\n199\t      int ndir = !!(x & key[byte]);\n200\t      if (ndir == way) other = p;\n201\t      return blt_firstlast(other, way);\n202\t    }\n203\t    if (!*c) return (BLT_IT *)p;\n204\t  }\n205\t}\n206\t\n207\tBLT_IT *blt_ceil (BLT *blt, char *key) { return blt_ceilfloor(blt, key, 0); }\n208\tBLT_IT *blt_floor(BLT *blt, char *key) { return blt_ceilfloor(blt, key, 1); }\n209\t\n210\tBLT_IT *blt_setp(BLT *blt, char *key, int *is_new) {\n211\t  BLT_IT *p = confident_get(blt, key);\n212\t  if (!p) {  // Empty tree case.\n213\t    blt->empty = 0;\n214\t