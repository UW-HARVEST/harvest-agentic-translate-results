uration_since(started);\n        *b = Some(now);\n        elapsed\n    });\n    println!(\n        \"{}: {}.{:09}s\",\n        msg,\n        elapsed.as_secs(),\n        elapsed.subsec_nanos()\n    );\n}\n\n/// Reads keys and calls the provided callback with a slice of keys and an integer.\n/// The callback receives a slice of string slices (`&[&str]`) and an `i32`.\npub fn bm_read_keys<F>(mut cb: F)\nwhere\n    F: FnMut(&[&str], i32),\n{\n    let stdin = io::stdin();\n    let mut lines: Vec<String> = Vec::new();\n    let locked = stdin.lock();\n    for line in locked.lines() {\n        match line {\n            Ok(s) => lines.push(s),\n            Err(_) => break,\n        }\n    }\n\n    // Randomize order of array (skip first element to mirror C: i goes from m-1 down to 2).\n    use rand::seq::SliceRandom;\n    use rand::Rng;\n    let m = lines.len();\n    if m > 2 {\n        let mut rng = rand::rng();\n        // Mirror the C code: for i in (2..m).rev(), swap with random index in [0, i).\n        for i in (2..m).rev() {\n            let j = rng.random_range(0..i);\n            lines.swap(i, j);\n        }\n        let _ = SliceRandom::shuffle::<rand::rngs::ThreadRng>; // suppress unused import warning if any\n    }\n\n    let refs: Vec<&str> = lines.iter().map(|s| s.as_str()).collect();\n    cb(&refs, m as i32);\n}\n","structuredPatch":[{"oldStart":47,"oldLines":18,"newStart":47,"newLines":15,"lines":["         }","     }"," ","-    // Randomize order of array (skip first element to mirror C: i goes from m-1 down to 2).","-    use rand::seq::SliceRandom;","+    // Randomize order of array (mirror C: for i in (2..m).rev(), swap with random index in [0, i)).","     use rand::Rng;","     let m = lines.len();","     if m > 2 {","         let mut rng = rand::rng();","-        // Mirror the C code: for i in (2..m).rev(), swap with random index in [0, i).","         for i in (2..m).rev() {","             let j = rng.random_range(0..i);","             lines.swap(i, j);",