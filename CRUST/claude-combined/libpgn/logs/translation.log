n170\t    }\n171\t\n172\t    if (move->from.file) dest[cursor++] = move->from.file;\n173\t    if (move->from.rank) dest[cursor++] = '0' + move->from.rank;\n174\t\n175\t    if (move->captures) dest[cursor++] = 'x';\n176\t\n177\t    dest[cursor++] = move->dest.file;\n178\t    dest[cursor++] = '0' + move->dest.rank;\n179\t\n180\t    if (move->promoted_to) {\n181\t        assert(move->piece == PGN_PIECE_PAWN);\n182\t        assert(move->promoted_to != PGN_PIECE_PAWN);\n183\t        dest[cursor++] = '=';\n184\t        dest[cursor++] = move->promoted_to;\n185\t    }\n186\t\n187\tcheck:\n188\t    switch (move->check) {\n189\t        case PGN_CHECK_NONE:\n190\t            break;\n191\t        case PGN_CHECK_MATE:\n192\t            dest[cursor++] = '#';\n193\t            break;\n194\t        case PGN_CHECK_SINGLE:\n195\t            dest[cursor++] = '+';\n196\t            break;\n197\t        case PGN_CHECK_DOUBLE:\n198\t            dest[cursor++] = '+';\n199\t            dest[cursor++] = '+';\n200\t            break;\n201\t    }\n202\t\n203\t    if (move->annotation >= PGN_ANNOTATION_GOOD_MOVE && move->annotation <= PGN_ANNOTATION_DUBIOUS_MOVE) {\n204\t        cursor += pgn_annotation_to_string(move->annotation, dest + cursor);\n205\t    }\n206\t\n207\t    if (move->en_passant) {\n208\t        dest[cursor++] = ' ';\n209\t        strcpy(dest + cursor, \"e.p.\");\n210\t        cursor += 4;\n211\t    }\n212\t\n213\t    if (move->annotation > PGN_ANNOTATION_DUBIOUS_MOVE || move->annotation == PGN_ANNOTATION_NULL) {\n214\t        dest[cursor++] = ' ';\n215\t        cursor += pgn_annotation_to_string(move->annotation, dest + cursor);\n216\t    }\n217\t\n218\t    dest[cursor] = '\\0';\n219\t    return cursor;\n220\t}\n221\t\n222\tpgn_moves_t *__pgn_moves_from_string_recurse(char *str, size_t *consumed, pgn_moves_t *moves, int expect)\n223\t{\n224\t    if (str[0] == ')' || str[0] == '\\0')\n225\t        return moves;\n226\t\n227\t    size_t cursor = 0;\n228\t    __pgn_moves_item_t move = {0};\n229\t\n230\t    /* comments placeholder to wait for knowing which move the comment belongs to.\n231\t     */\n232\t    pgn_comments_t *comments = NULL;\n233\t\n234\t    pgn_cursor_skip_whitespace(str, &cursor);\n235\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BEFORE_MOVE, str + cursor);\n236\t\n237\t    assert(isdigit(str[cursor]));\n238\t    while (isdigit(str[cursor])) cursor++;\n239\t\n240\t    int dots_count = 0;\n241\t    assert(str[cursor] == '.');\n242\t    while (str[cursor] == '.') {\n243\t        cursor++;\n244\t        dots_count++;\n245\t    }\n246\t\n247\t    if (expect == PGN_EXPECT_WHITE) assert(dots_count == 1);\n248\t    if (expect == PGN_EXPECT_BLACK) assert(dots_count == 3);\n249\t\n250\t    pgn_cursor_skip_whitespace(str, &cursor);\n251\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BETWEEN_MOVE, str + cursor);\n252\t\n253\t    if (dots_count == 3) {\n254\t        move.black = __pgn_move_from_string(str + cursor, &cursor);\n255\t\n256\t        pgn_cursor_skip_whitespace(str, &cursor);\n257\t        cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n258\t        cursor += pgn_alternative_moves_poll(&move.black.alternatives, &comments, str + cursor, PGN_EXPECT_BLACK);\n259\t        pgn_cursor_skip_whitespace(str, &cursor);\n260\t        cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n261\t\n262\t        if (comments) {\n263\t            move.black.comments = comments;\n264\t            comments = NULL;\n265\t        }\n266\t\n267\t        pgn_moves_push(moves, move);\n268\t        __pgn_moves_from_string_recurse(str + cursor, &cursor, moves, PGN_EXPECT_WHITE);\n269\t        *consumed += cursor;\n270\t        return moves;\n271\t    }\n272\t\n273\t    move.white = __pgn_move_from_string(str + cursor, &cursor);\n274\t    pgn_cursor_skip_whitespace(str, &cursor);\n275\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_PO