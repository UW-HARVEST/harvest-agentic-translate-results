{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01P7Hs2Y1SrdySXDrxnfpuzQ","type":"tool_result","content":"1\tuse libpgn::comments::PgnCommentPosition;\n2\tuse libpgn::moves::PgnMoves;\n3\t\n4\t#[test]\n5\tfn test_parsing_moves_with_comments_nested() {\n6\t    let moves = PgnMoves::from(\"1.e4 { a comment {inside a comment} ? } e5\");\n7\t    assert!(moves.values[0].white.comments.is_some());\n8\t    assert_eq!(\n9\t        moves.values[0]\n10\t            .white\n11\t            .comments\n12\t            .as_ref()\n13\t            .unwrap()\n14\t            .values\n15\t            .len(),\n16\t        1\n17\t    );\n18\t    assert_eq!(\n19\t        moves.values[0].white.comments.as_ref().unwrap().values[0].position,\n20\t        PgnCommentPosition::AfterMove\n21\t    );\n22\t    assert_eq!(\n23\t        moves.values[0].white.comments.as_ref().unwrap().values[0].value,\n24\t        \" a comment {inside a comment} ? \"\n25\t    );\n26\t}\n27\t\n28\t#[test]\n29\tfn test_parsing_comments_on_position_before() {\n30\t    let mut moves = PgnMoves::from(\"{ hello} 1.e4 e5\");\n31\t    assert!(moves.values[0].white.comments.is_some());\n32\t    assert_eq!(\n33\t        moves.values[0]\n34\t            .white\n35\t            .comments\n36\t            .as_ref()\n37\t            .unwrap()\n38\t            .values\n39\t            .len(),\n40\t        1\n41\t    );\n42\t    assert_eq!(\n43\t        moves.values[0].white.comments.as_ref().unwrap().values[0].position,\n44\t        PgnCommentPosition::BeforeMove\n45\t    );\n46\t    assert_eq!(\n47\t        moves.values[0].white.comments.as_ref().unwrap().values[0].value,\n48\t        \" hello\"\n49\t    );\n50\t\n51\t    moves = PgnMoves::from(\"{ hello} {libpgn} 1.e4 e5\");\n52\t    assert!(moves.values[0].white.comments.is_some());\n53\t    assert_eq!(\n54\t        moves.values[0]\n55\t            .white\n56\t            .comments\n57\t            .as_ref()\n58\t            .unwrap()\n59\t      