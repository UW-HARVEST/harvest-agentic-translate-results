ck.comments = comments;\n323\t        comments = NULL;\n324\t    }\n325\t\n326\t    pgn_moves_push(moves, move);\n327\t\n328\t    if (pgn_score_from_string(str + cursor)) {\n329\t        *consumed += cursor;\n330\t        return moves;\n331\t    }\n332\t\n333\t    __pgn_moves_from_string_recurse(str + cursor, &cursor, moves, PGN_EXPECT_WHITE);\n334\t    *consumed += cursor;\n335\t    return moves;\n336\t}\n337\t\n338\tpgn_moves_t *__pgn_moves_from_string(char *str, size_t *consumed)\n339\t{\n340\t    return __pgn_moves_from_string_recurse(str, consumed, pgn_moves_init(), PGN_EXPECT_WHITE);\n341\t}\n342\t\n343\tpgn_moves_t *pgn_moves_from_string(char *str)\n344\t{\n345\t    size_t consumed = 0;\n346\t    return __pgn_moves_from_string(str, &consumed);\n347\t}\n348\t\n349\tpgn_alternative_moves_t *pgn_alternative_moves_init(void)\n350\t{\n351\t    pgn_alternative_moves_t *alt = malloc(sizeof *alt);\n352\t    alt->values = malloc(sizeof *alt->values * PGN_ALTERNATIVE_MOVES_INITIAL_SIZE);\n353\t    alt->size = PGN_ALTERNATIVE_MOVES_INITIAL_SIZE;\n354\t    alt->length = 0;\n355\t    return alt;\n356\t}\n357\t\n358\tsize_t pgn_alternative_moves_poll(pgn_alternative_moves_t **alt, pgn_comments_t **placeholder, char *str, int expect)\n359\t{\n360\t    size_t cursor = 0;\n361\t\n362\t    while (str[cursor] == '(') {\n363\t        cursor++;\n364\t\n365\t        if (!*alt)\n366\t            *alt = pgn_alternative_moves_init();\n367\t\n368\t        pgn_cursor_skip_whitespace(str, &cursor);\n369\t        pgn_alternative_moves_push(*alt, __pgn_moves_from_string_recurse(str + cursor, &cursor, pgn_moves_init(), expect));\n370\t        pgn_cursor_skip_whitespace(str, &cursor);\n371\t        assert(str[cursor++] == ')');\n372\t\n373\t        pgn_cursor_skip_whitespace(str, &cursor);\n374\t        cursor += pgn_comments_poll(placeholder, PGN_COMMENT_POSITION_AFTER_ALTERNATIVE, str + cursor);\n375\t    }\n376\t\n377\t    return cursor;\n378\t}\n379\t\n380\tvoid pgn_alternative_moves_push(pgn_alternative_moves_t *alt, pgn_moves_t *moves)\n381\t{\n382\t    if (alt->length >= alt->size) {\n383\t        alt->size += PGN_ALTERNATIVE_MOVES_GROW_SIZE;\n384\t        alt->values = realloc(alt->values,  (sizeof *alt->values) * alt->size);\n385\t    }\n386\t\n387\t    alt->values[alt->length++] = moves;\n388\t}\n389\t\n390\tvoid pgn_alternative_moves_cleanup(pgn_alternative_moves_t *alt)\n391\t{\n392\t    for (size_t i = 0; i < alt->length; i++) {\n393\t        pgn_moves_cleanup(alt->values[i]);\n394\t    }\n395\t\n396\t    free(alt->values);\n397\t    free(alt);\n398\t}\n399\t\n400\tpgn_moves_t *pgn_moves_init(void)\n401\t{\n402\t    pgn_moves_t *moves = malloc(sizeof *moves);\n403\t    moves->values = malloc(sizeof *moves->values * PGN_MOVES_INITIAL_SIZE);\n404\t    moves->size = PGN_MOVES_INITIAL_SIZE;\n405\t    moves->length = 0;\n406\t    return moves;\n407\t}\n408\t\n409\tvoid pgn_moves_push(pgn_moves_t *moves, __pgn_moves_item_t __moves)\n410\t{\n411\t    if (moves->length >= moves->size) {\n412\t        moves->size += PGN_MOVES_GROW_SIZE;\n413\t        moves->values = realloc(moves->values,  (sizeof *moves->values) * moves->size);\n414\t    }\n415\t\n416\t    moves->values[moves->length++] = __moves;\n417\t}\n418\t\n419\tvoid pgn_moves_cleanup(pgn_moves_t *moves)\n420\t{\n421\t    for (size_t i = 0; i < moves->length; i++) {\n422\t        if (moves->values[i].white.comments) {\n423\t            pgn_comments_cleanup(moves->values[i].white.comments);\n424\t        }\n425\t\n426\t        if (moves->values[i].black.comments) {\n427\t            pgn_comments_cleanup(moves->values[i].black.comments);\n428\t        }\n429\t\n430\t        if (moves->values[i].white.alternatives) {\n431\t            pgn_alternative_moves_cleanup(moves->values[i].white.alternatives);\n432\t        }\n433\t\n434\t        if (moves->values[i].black.alternatives) {\n435\t            pgn_alternative_moves_cleanup(moves->values[i].black.alternatives);\n436\t        }\n437\t    }\n