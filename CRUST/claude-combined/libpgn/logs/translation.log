{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Bx8VCtKn4DtyFF6mh7XJ4s","type":"tool_result","content":"1\tuse libpgn::annotation::PgnAnnotation;\n2\tuse libpgn::check::PgnCheck;\n3\tuse libpgn::comments::PgnCommentPosition;\n4\tuse libpgn::coordinate::{PgnCoordinate, UNKNOWN};\n5\tuse libpgn::moves::{PgnMove, PgnMoves, PGN_CASTLING_KINGSIDE, PGN_CASTLING_QUEENSIDE};\n6\tuse libpgn::piece::PgnPiece;\n7\t\n8\t#[test]\n9\tfn test_parsing_single_move() {\n10\t    let mut mv: PgnMove;\n11\t\n12\t    mv = PgnMove::from(\"e4??\");\n13\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n14\t    assert_eq!(mv.captures, false);\n15\t    assert_eq!(mv.from.file, None);\n16\t    assert_eq!(mv.from.rank, None);\n17\t    assert_eq!(mv.dest.file, Some('e'));\n18\t    assert_eq!(mv.dest.rank, Some(4));\n19\t    assert_eq!(mv.check, PgnCheck::None);\n20\t    assert_eq!(mv.notation, \"e4??\");\n21\t    assert_eq!(mv.annotation, PgnAnnotation::Blunder);\n22\t\n23\t    mv = PgnMove::from(\"Nb6d5+\");\n24\t    assert_eq!(mv.piece, PgnPiece::Knight);\n25\t    assert_eq!(mv.captures, false);\n26\t    assert_eq!(mv.from.file, Some('b'));\n27\t    assert_eq!(mv.from.rank, Some(6));\n28\t    assert_eq!(mv.dest.file, Some('d'));\n29\t    assert_eq!(mv.dest.rank, Some(5));\n30\t    assert_eq!(mv.check, PgnCheck::Single);\n31\t    assert_eq!(mv.notation, \"Nb6d5+\");\n32\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n33\t\n34\t    mv = PgnMove::from(\"Qf1?!\");\n35\t    assert_eq!(mv.piece, PgnPiece::Queen);\n36\t    assert_eq!(mv.captures, false);\n37\t    assert_eq!(mv.from.file, None);\n38\t    assert_eq!(mv.from.rank, None);\n39\t    assert_eq!(mv.dest.file, Some('f'));\n40\t    assert_eq!(mv.dest.rank, Some(1));\n41\t    assert_eq!(mv.check, PgnCheck::None);\n42\t    assert_eq!(mv.notation, \"Qf1?!\");\n43\t    assert_eq!(mv.annotation, PgnAnnotation::DubiousMove);\n44\t\n45\t    mv = PgnMove::from(\"bxa8=Q??\");\n46\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n47\t    assert_eq!(mv.captures, true);\n48\t    assert_eq!(mv.from.file, Some('b'));\n49\t    assert_eq!(mv.from.rank, None);\n50\t    assert_eq!(mv.dest.file, Some('a'));\n51\t    assert_eq!(mv.dest.rank, Some(8));\n52\t    assert_eq!(mv.check, PgnCheck::None);\n53\t    assert_eq!(mv.promoted_to, PgnPiece::Queen);\n54\t    assert_eq!(mv.notation, \"bxa8=Q??\");\n55\t    assert_eq!(mv.annotation, PgnAnnotation::Blunder);\n56\t\n57\t    mv = PgnMove::from(\"Bxg2\");\n58\t    assert_eq!(mv.piece, PgnPiece::Bishop);\n59\t    assert_eq!(mv.captures, true);\n60\t    assert_eq!(mv.from.file, None);\n61\t    assert_eq!(mv.from.rank, None);\n62\t    assert_eq!(mv.dest.file, Some('g'));\n63\t    assert_eq!(mv.dest.rank, Some(2));\n64\t    assert_eq!(mv.check, PgnCheck::None);\n65\t    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n66\t    assert_eq!(mv.notation, \"Bxg2\");\n67\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n68\t\n69\t    mv = PgnMove::from(\"exf2+!\");\n70\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n71\t    assert_eq!(mv.captures, true);\n72\t    assert_eq!(mv.from.file, Some('e'));\n73\t    assert_eq!(mv.from.rank, None);\n74\t    assert_eq!(mv.dest.file, Some('f'));\n75\t    assert_eq!(mv.dest.rank, Some(2));\n76\t    assert_eq!(mv.check, PgnCheck::Single);\n77\t    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n78\t    assert_eq!(mv.notation, \"exf2+!\");\n79\t    assert_eq!(mv.annotation, PgnAnnotation::GoodMove);\n80\t\n81\t    mv = PgnMove::from(\"O-O+!!\");\n82\t    assert_eq!(mv.castles, PGN_CASTLING_KINGSIDE);\n83\t    assert_eq!(mv.check, PgnCheck::Single);\n84\t    assert_eq!(mv.notation, \"O-O+!!\");\n85\t    assert_eq!(mv.annotation, PgnAnnotation::BrilliantMove);\n86\t\n87\t    mv = PgnMove::from(\"O-O-O\");\n88\t    assert_eq!(mv.castles, PGN_CASTLING_QUEENSIDE);\n89\t    assert_eq!(mv.check, PgnCheck::None);\n90\t    assert_eq!(mv.notation, \"O-O-O\");\n91\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n92\t}\n93\t\n94\t#[test]\n95\tfn test_parsing_bunch_of_moves() {\n96\t    let mut moves: PgnMoves;\n97\t\n98\t    moves = PgnMoves::from(\"1.e4 e5\");\n99\t    assert_eq!(moves.values[0].white.notation, \"e4\");\n100\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n101\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n102\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n103\t    assert_eq!(moves.values[0].white.captures, false);\n104\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n105\t    assert_eq!(moves.values[0].black.notation, \"e5\");\n106\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n107\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n108\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n109\t    assert_eq!(moves.values[0].black.captures, false);\n110\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n111\t\n112\t    moves = PgnMoves::from(\"1.e4 $2 e5 $1\");\n113\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n114\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n115\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n116\t    assert_eq!(moves.values[0].white.captures, false);\n117\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::GoodMove);\n118\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n119\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n120\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n121\t    assert_eq!(moves.values[0].black.captures, false);\n122\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Mistake);\n123\t\n124\t    moves = PgnMoves::from(\"69.Be4 69... Rxe5?!\");\n125\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Bishop);\n126\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n127\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n128\t    assert_eq!(moves.values[0].white.captures, false);\n129\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n130\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Rook);\n131\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n132\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n133\t    assert_eq!(moves.values[0].black.captures, true);\n134\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::DubiousMove);\n135\t\n136\t    moves = PgnMoves::from(\"9.e4 { This is a comment :O } e5 10. Nc3 Nc6\");\n137\t    assert_eq!(\n138\t        moves.values[0]\n139\t            .white\n140\t            .comments\n141\t            .as_ref()\n142\t            .unwrap()\n143\t            .values\n144\t            .len(),\n145\t        1\n146\t    );\n147\t    assert_eq!(\n148\t        moves.values[0].white.comments.as_ref().unwrap().values[0].value,\n149\t        \" This is a comment :O \"\n150\t    );\n151\t    assert_eq!(\n152\t        moves.values[0].white.comments.as_ref().unwrap().values[0].position,\n153\t        PgnCommentPosition::AfterMove\n154\t    );\n155\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n156\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n157\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n158\t    assert_eq!(moves.values[0].white.captures, false);\n159\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n160\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n161\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n162\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n163\t    assert_eq!(moves.values[0].black.captures, false);\n164\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n165\t\n166\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n167\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n168\t    assert_eq!(moves.values[1].white.dest.rank, Some(3));\n169\t    assert_eq!(moves.values[1].white.captures, false);\n170\t    assert_eq!(moves.values[1].white.annotation, PgnAnnotation::Unknown);\n171\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n172\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n173\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n174\t    assert_eq!(moves.values[1].black.captures, false);\n175\t    assert_eq!(moves.values[1].black.annotation, PgnAnnotation::Unknown);\n176\t\n177\t    moves = PgnMoves::from(\"69.Be4 ( 69. Be2 69... e4 ) 69... Rxe5?!\");\n178\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Bishop);\n179\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n180\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n181\t    assert_eq!(moves.values[0].white.captures, false);\n182\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n183\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Rook);\n184\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n185\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n186\t    assert_eq!(moves.values[0].black.captures, true);\n187\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::DubiousMove);\n188\t    assert!(moves.values[0].white.alternatives.is_some());\n189\t\n190\t    assert_eq!(\n191\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n192\t            .white\n193\t            .piece,\n194\t        PgnPiece::Bishop\n195\t    );\n196\t    assert_eq!(\n197\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n198\t            .white\n199\t            .dest\n200\t            .file,\n201\t        Some('e')\n202\t    );\n203\t    assert_eq!(\n204\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n205\t            .white\n206\t            .dest\n207\t            .rank,\n208\t        Some(2)\n209\t    );\n210\t    assert_eq!(\n211\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n212\t            .white\n213\t            .captures,\n214\t        false\n215\t    );\n216\t    assert_eq!(\n217\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n218\t            .white\n219\t            .annotation,\n220\t        PgnAnnotation::Unknown\n221\t    );\n222\t    assert_eq!(\n223\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n224\t            .black\n225\t            .piece,\n226\t        PgnPiece::Pawn\n227\t    );\n228\t    assert_eq!(\n229\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n230\t            .black\n231\t            .dest\n232\t            .file,\n233\t        Some('e')\n234\t    );\n235\t    assert_eq!(\n236\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n237\t            .black\n238\t            .dest\n239\t            .rank,\n240\t        Some(4)\n241\t    );\n242\t    assert_eq!(\n243\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n244\t            .black\n245\t            .captures,\n246\t        false\n247\t    );\n248\t    assert_eq!(\n249\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n250\t            .black\n251\t            .annotation,\n252\t        PgnAnnotation::Unknown\n253\t    );\n254\t\n255\t    moves = PgnMoves::from(\"69.Be4 69... Rxe5?! ( 69... e5 70. e4 )\");\n256\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Bishop);\n257\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n258\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n259\t    assert_eq!(moves.values[0].white.captures, false);\n260\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n261\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Rook);\n262\t    assert_eq!(moves.values[0].black.dest.file, Some('e'));\n263\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n264\t    assert_eq!(moves.values[0].black.captures, true);\n265\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::DubiousMove);\n266\t    assert!(moves.values[0].black.alternatives.is_some());\n267\t\n268\t    assert_eq!(\n269\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n270\t            .black\n271\t            .piece,\n272\t        PgnPiece::Pawn\n273\t    );\n274\t    assert_eq!(\n275\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n276\t            .black\n277\t            .dest\n278\t            .file,\n279\t        Some('e')\n280\t    );\n281\t    assert_eq!(\n282\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n283\t            .black\n284\t            .dest\n285\t            .rank,\n286\t        Some(5)\n287\t    );\n288\t    assert_eq!(\n289\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n290\t            .black\n291\t            .captures,\n292\t        false\n293\t    );\n294\t    assert_eq!(\n295\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[0]\n296\t            .black\n297\t            .annotation,\n298\t        PgnAnnotation::Unknown\n299\t    );\n300\t\n301\t    assert_eq!(\n302\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n303\t            .white\n304\t            .piece,\n305\t        PgnPiece::Pawn\n306\t    );\n307\t    assert_eq!(\n308\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n309\t            .white\n310\t            .dest\n311\t            .file,\n312\t        Some('e')\n313\t    );\n314\t    assert_eq!(\n315\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n316\t            .white\n317\t            .dest\n318\t            .rank,\n319\t        Some(4)\n320\t    );\n321\t    assert_eq!(\n322\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n323\t            .white\n324\t            .captures,\n325\t        false\n326\t    );\n327\t    assert_eq!(\n328\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n329\t            .white\n330\t            .annotation,\n331\t        PgnAnnotation::Unknown\n332\t    );\n333\t\n334\t    moves = PgnMoves::from(\"1.c4 ( 1.e4  ) c5 2.Nc3 Nc6\");\n335\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n336\t    assert_eq!(moves.values[0].white.dest.file, Some('c'));\n337\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n338\t    assert_eq!(moves.values[0].white.captures, false);\n339\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n340\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n341\t    assert_eq!(moves.values[0].black.dest.file, Some('c'));\n342\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n343\t    assert_eq!(moves.values[0].black.captures, false);\n344\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n345\t\n346\t    assert_eq!(\n347\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n348\t            .white\n349\t            .piece,\n350\t        PgnPiece::Pawn\n351\t    );\n352\t    assert_eq!(\n353\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n354\t            .white\n355\t            .dest\n356\t            .file,\n357\t        Some('e')\n358\t    );\n359\t    assert_eq!(\n360\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n361\t            .white\n362\t            .dest\n363\t            .rank,\n364\t        Some(4)\n365\t    );\n366\t    assert_eq!(\n367\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n368\t            .white\n369\t            .captures,\n370\t        false\n371\t    );\n372\t    assert_eq!(\n373\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n374\t            .white\n375\t            .annotation,\n376\t        PgnAnnotation::Unknown\n377\t    );\n378\t\n379\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n380\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n381\t    assert_eq!(moves.values[1].white.dest.rank, Some(3));\n382\t    assert_eq!(moves.values[1].white.captures, false);\n383\t    assert_eq!(moves.values[1].white.annotation, PgnAnnotation::Unknown);\n384\t\n385\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n386\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n387\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n388\t    assert_eq!(moves.values[1].black.captures, false);\n389\t    assert_eq!(moves.values[1].black.annotation, PgnAnnotation::Unknown);\n390\t}\n391\t\n392\t#[test]\n393\tfn test_parsing_en_passant() {\n394\t    let mv = PgnMove::from(\"exd6 e.p.\");\n395\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n396\t    assert!(mv.en_passant);\n397\t    assert_eq!(mv.from.file, Some('e'));\n398\t    assert_eq!(mv.dest.file, Some('d'));\n399\t    assert_eq!(mv.dest.rank, Some(6));\n400\t    assert!(mv.captures);\n401\t\n402\t    let moves = PgnMoves::from(\"1. d4 exd3 e.p. 2. Nc4 Nc6 3. cxb3 e.p. 3... Be4\");\n403\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n404\t    assert_eq!(moves.values[0].white.dest.file, Some('d'));\n405\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n406\t    assert_eq!(moves.values[0].white.notation, \"d4\");\n407\t    assert!(!moves.values[0].white.en_passant);\n408\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n409\t    assert_eq!(moves.values[0].black.from.file, Some('e'));\n410\t    assert_eq!(moves.values[0].black.dest.file, Some('d'));\n411\t    assert_eq!(moves.values[0].black.dest.rank, Some(3));\n412\t    assert_eq!(moves.values[0].black.notation, \"exd3 e.p.\");\n413\t    assert!(moves.values[0].black.en_passant);\n414\t\n415\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n416\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n417\t    assert_eq!(moves.values[1].white.dest.rank, Some(4));\n418\t    assert_eq!(moves.values[1].white.notation, \"Nc4\");\n419\t    assert!(!moves.values[1].white.en_passant);\n420\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n421\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n422\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n423\t    assert_eq!(moves.values[1].black.notation, \"Nc6\");\n424\t    assert!(!moves.values[1].black.en_passant);\n425\t\n426\t    assert_eq!(moves.values[2].white.piece, PgnPiece::Pawn);\n427\t    assert_eq!(moves.values[2].white.from.file, Some('c'));\n428\t    assert_eq!(moves.values[2].white.dest.file, Some('b'));\n429\t    assert_eq!(moves.values[2].white.dest.rank, Some(3));\n430\t    assert_eq!(moves.values[2].white.notation, \"cxb3 e.p.\");\n431\t    assert!(moves.values[2].white.en_passant);\n432\t    assert_eq!(moves.values[2].black.piece, PgnPiece::Bishop);\n433\t    assert_eq!(moves.values[2].black.dest.file, Some('e'));\n434\t    assert_eq!(moves.values[2].black.dest.rank, Some(4));\n435\t    assert_eq!(moves.values[2].black.notation, \"Be4\");\n436\t    assert!(!moves.values[2].black.en_passant);\n437\t}\n438\t\n439\t#[test]\n440\tfn test_parsing_moves_with_alternatives() {\n441\t    let mut moves: PgnMoves;\n442\t\n443\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5\");\n444\t    assert_eq!(moves.values.len(), 1);\n445\t    assert_eq!(\n446\t        moves.values[0]\n447\t            .white\n448\t            .alternatives\n449\t            .as_ref()\n450\t            .unwrap()\n451\t            .values\n452\t            .len(),\n453\t        1\n454\t    );\n455\t    assert_eq!(\n456\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n457\t            .white\n458\t            .notation,\n459\t    