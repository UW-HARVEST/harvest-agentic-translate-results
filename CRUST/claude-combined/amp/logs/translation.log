{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TK55xQLx4oPrsKJS1pBigz","type":"tool_result","content":"1\t\n2\t//\n3\t// amp.c\n4\t//\n5\t// Copyright (c) 2014 TJ Holowaychuk <tj@vision-media.ca>\n6\t//\n7\t\n8\t#include <string.h>\n9\t#include <stdlib.h>\n10\t#include <stdint.h>\n11\t#include \"amp.h\"\n12\t\n13\t/*\n14\t * Read u32be.\n15\t */\n16\t\n17\tstatic uint32_t\n18\tread_u32_be(char *buf) {\n19\t  uint32_t n = 0;\n20\t  n |= buf[0] << 24;\n21\t  n |= buf[1] << 16;\n22\t  n |= buf[2] << 8;\n23\t  n |= buf[3];\n24\t  return n;\n25\t}\n26\t\n27\t/*\n28\t * Write u32be.\n29\t */\n30\t\n31\tstatic void\n32\twrite_u32_be(char *buf, uint32_t n) {\n33\t  buf[0] = n >> 24 & 0xff;\n34\t  buf[1] = n >> 16 & 0xff;\n35\t  buf[2] = n >> 8 & 0xff;\n36\t  buf[3] = n & 0xff;\n37\t}\n38\t\n39\t/*\n40\t * Decode the `msg` header in `buf`.\n41\t */\n42\t\n43\tvoid\n44\tamp_decode(amp_t *msg, char *buf) {\n45\t  msg->version = buf[0] >> 4;\n46\t  msg->argc = buf[0] & 0xf;\n47\t  msg->buf = buf + 1;\n48\t}\n49\t\n50\t/*\n51\t * Decode `msg` argument, returning a buffer\n52\t * that must be freed by the user and progressing\n53\t * the msg->buf cursor.\n54\t */\n55\t\n56\tchar *\n57\tamp_decode_arg(amp_t *msg) {\n58\t  uint32_t len = read_u32_be(msg->buf);\n59\t  msg->buf += 4;\n60\t\n61\t  char *buf = malloc(len);\n62\t  if (!buf) return NULL;\n63\t\n64\t  memcpy(buf, msg->buf, len);\n65\t  msg->buf += len;\n66\t  return buf;\n67\t}\n68\t\n69\t/*\n70\t * Encode the AMP message argv.\n71\t *\n72\t *         0        1 2 3 4     <length>    ...\n73\t *   +------------+----------+------------+\n74\t *   | <ver/argc> | <length> | <data>     | additional arguments\n75\t *   +------------+----------+------------+\n76\t *\n77\t */\n78\t\n79\tchar *\n80\tamp_encode(char **argv, int argc) {\n81\t  size_t len = 1;\n82\t  size_t lens[argc];\n83\t\n84\t  // length\n85\t  for (int i = 0; i < argc; ++i) {\n86\t    len += 4;\n87\t    lens[i] = strlen(argv[i]);\n88\t    len += lens[i];\n89\t  }\n90\t\n91\t  // alloc\n92\t  char *buf = malloc(len);\n93\t  char *ret = buf;\n94\t  if (!buf) return NULL;\n95\t\n96\t  // ver/argc\n97\t  *buf++ = AMP_VERSION << 4 | argc;\n98\t\n99\t  // encode\n100\t  for (int i = 0; i < argc; ++i) {\n101\t    size_t len = lens[i];\n102\t\n103\t    write_u32_be(buf, len);\n104\t    buf += 4;\n105\t\n106\t    memcpy(buf, argv[i], len);\n107\t    buf += len;\n108\t  }\n109\t\n110\t  return ret;\n111\t}"}]},"parent_tool_use_id":null,"session_id":"36d75b9b-0a0e-4026-97c8-5a00543f9daa","uuid":"d0ffa3cc-3c18-4e48-a3e3-15802c1ab6e8","timestamp":"2026-05-30T06:45:13.076Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-jFTDsk/project/c_src/src/amp.c","content":"\n//\n// amp.c\n//\n// Copyright (c) 2014 TJ Holowaychuk <tj@vision-media.ca>\n//\n\n#include <string.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include \"amp.h\"\n\n/*\n * Read u32be.\n */\n\nstatic uint32_t\nread_u32_be(char *buf) {\n  uint32_t n = 0;\n  n |= buf[0] << 24;\n  n |= buf[1] << 16;\n  n |= buf[2] << 8;\n  n |= buf[3];\n  return n;\n}\n\n/*\n * Write u32be.\n */\n\nstatic void\nwrite_u32_be(char *buf, uint32_t n) {\n  buf[0] = n >> 24 & 0xff;\n  buf[1] = n >> 16 & 0xff;\n  buf[2] = n >> 8 & 0xff;\n  buf[3] = n & 0xff;\n}\n\n/*\n * Decode the `msg` header in `buf`.\n */\n\nvoid\namp_decode(amp_t *msg, char *buf) {\n  msg->version = buf[0] >> 4;\n  msg->argc = buf[0] & 0xf;\n  msg->buf = buf + 1;\n}\n\n/*\n * Decode `msg` argument, returning a buffer\n * that must be freed by the user and progressing\n * the msg->buf cursor.\n */\n\nchar *\namp_decode_arg(amp_t *msg) {\n  uint32_t len = read_u32_be(msg->buf);\n  msg->buf += 4;\n\n  char *buf = malloc(len);\n  if (!buf) return NULL;\n\n  memcpy(buf, msg->buf, len);\n  msg->buf += len;\n  return buf;\n}\n\n/*\n * Encode the AMP message argv.\n *\n *         0        1 2 3 4     <length>    ...\n *   +------------+----------+------------+\n *   | <ver/argc> | <length> | <data>     | additional arguments\n *   +------------+----------+------------+\n *\n */\n\nchar *\namp_encode(char **argv, int argc) {\n  size_t len = 1;\n  size_t lens[argc];\n\n  // length\n  for (int i = 0; i < argc; ++i) {\n    len += 4;\n    lens[i] = strlen(argv[i]);\n    len += lens[i];\n  }\n\n  // alloc\n  char *buf = malloc(len);\n  char *ret = buf;\n  if (!buf) return NULL;\n\n  // ver/argc\n  *buf++ = AMP_VERSION << 4 | argc;\n\n  // encode\n  for (int i = 0; i < argc; ++i) {\n    size_t len = lens[i];\n\n    write_u32_be(buf, len);\n    buf += 4;\n\n    memcpy(buf, argv[i], len);\n    buf += len;\n  }\n\n  return ret;\n}","numLines":111,"startLine":1,"totalLines":111}}}
