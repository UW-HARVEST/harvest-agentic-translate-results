," }","+","+const EOF_VAL: i32 = -1;","+"," /// Gets the next character from the lexer."," pub fn lexer_getchar(l: &mut Lexer) -> i32 {","-unimplemented!()","+    l.position += 1;","+    l.last_column = l.column;","+    let mut buf = [0u8; 1];","+    let read = match l.fp.as_mut() {","+        Some(fp) => fp.read(&mut buf).unwrap_or(0),","+        None => 0,","+    };","+    if read == 0 {","+        l.buffer[0] = 0;","+        return EOF_VAL;","+    }","+    l.buffer[0] = buf[0];","+    if buf[0] == b'\\n' {","+        l.line += 1;","+        l.column = 0;","+    } else {","+        l.column += 1;","+    }","+    buf[0] as i32"," }","+"," /// Retrieves the next token from the lexer."," pub fn real_lex(l: &mut Lexer, t: &mut Token) -> i32 {","-unimplemented!()","+    if l.unlexed_count > 0 {","+        l.unlexed_count -= 1;","+        let idx = l.unlexed_count as usize;","+        // Move the token by swapping with a default","+        let mut taken = Token {","+            token_type: TokenType::TT_NO_TOKEN,","+            contents: String::new(),","+            length: 0,","+            source_file: String::new(),","+            line: 0,","+            column: 0,","+        };","+        std::mem::swap(&mut taken, &mut l.unlexed[idx]);","+        *t = taken;","+        return 0;","+    }","+","+    skip_to_token(l);","+    let init = lexer_getchar(l);","+","+    t.contents.clear();","+    t.source_file = l.current_file.clone();","+","+    if init == EOF_VAL {","+        t.contents = \"[end of file]\".to_string();","+        t.length = t.contents.len();","+        t.token_type = TokenType::TT_EOF;","+        t.line = l.line;","+        t.column = l.column;","+        return 0;","+    }","+","+    let init_c = init as u8 as char;","+","+    if init_c == ' ' || init_c == '\\t' {","+        eprintln!(\"Error: jccc: internal error: did not skip whitespace correctly\");","+        return -1;","+    }","+","+    if init_c == '\\n' {","+        t.contents = \"[newline]\".to_string();","+        t.length = t.contents.len();","+        t.token_type = TokenType::TT_NEWLINE;","+        t.line = l.line;","+        t.column = l.column;","+        return 0;","+    }","+","+    let mut buf = String::new();","+    buf.push(init_c);","+","+    if in_string(init_c, \"(){}[];~#,.:?~\") != 0 {","+        t.length = buf.len();","+        t.token_type = ttype_one_char(init_c);","+        t.line = l.line;","+        t.column = l.column;","+        t.contents = buf;","+        return 0;","+    }","+","+    if is_valid_numeric_or_id_char(init_c) != 0 {","+        let starting_line = l.line;","+        let starting_col = l.column;","+        loop {","+            let c = lexer_getchar(l);","+            if c == EOF_VAL {","+                break;","+            }","+            let cc = c as u8 as char;","+            if is_valid_numeric_or_id_char(cc) == 0 {","+                break;","+            }","+            if buf.len() >= TOKEN_LENGTH - 1 {","+                eprintln!(\"Error: jccc: identifier too long, over {} characters\", TOKEN_LENGTH);","+                return -1;","+            }","+            buf.push(cc);","+        }","+        lexer_ungetchar(l);","+        t.token_type = ttype_many_chars(&buf);","+        t.length = buf.len();","+        t.line = starting_line;","+        t.column = starting_col;","+        t.contents = buf;","+        return 0;","+    }","+","+    if starts_operator(init_c) != 0 {","+        // Lex characters from the buffer until the resulting string is no","+        // longer a valid operator sequence.","+        while valid_operator_sequence(&buf) != 0 {","+            let c = lexer_getchar(l);","+            if c == EOF_VAL {","+                break;","+            }","+            buf.push(c as u8 as char);","+        }","+        lexer_ungetchar(l);","+        // Drop the last character that broke the sequence.","+        if !buf.is_empty() {","+            buf.pop();","+        }","+        t.token_type