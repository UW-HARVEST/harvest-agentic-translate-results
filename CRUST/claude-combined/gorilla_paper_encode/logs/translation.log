t\n104\tint write_flush(bitwriter_t* w, bool bit)\n105\t{\n106\t    while (w->bit_count != 8) {\n107\t        if (write_bit(w, bit) != 0)\n108\t            return -1;\n109\t    }\n110\t    return 0;\n111\t}\n112\tint float_encoder_init(float_encoder_t* s)\n113\t{\n114\t    assert(s);\n115\t    memset(s, 0, sizeof(*s));\n116\t\n117\t    bitwriter_init(&s->w);\n118\t    s->first = true;\n119\t    s->leading = ~0;\n120\t    write_byte(&s->w, 0x10);\n121\t    return 0;\n122\t}\n123\t\n124\tint bitslen(u64 x) \n125\t{\n126\t    int n = 0;\n127\t    if (x >= ((u64)1<<32)) {\n128\t        x >>= 32;\n129\t        n = 32;\n130\t    }\n131\t    if (x >= 1<<16) {\n132\t        x >>= 16;\n133\t        n += 16;\n134\t    }\n135\t    if (x >= 1<<8) {\n136\t        x >>= 8;\n137\t        n += 8;\n138\t    }\n139\t    return n + len8_tab[x];   \n140\t}\n141\t\n142\tint leading_zero64(u64 u)\n143\t{\n144\t    return 64 - bitslen(u);\n145\t}\n146\t\n147\t\n148\tint trailing_zero64(u64 u)\n149\t{\n150\t    if (u == 0)\n151\t        return 64;\n152\t\n153\t    return de_bruijn64_tab[(u&-u)*de_bruijn64 >> (64 - 6)];\n154\t}\n155\t\n156\tint float_encode_write(float_encoder_t* s, f64 v)\n157\t{\n158\t    u64* vp = (u64*)&v;\n159\t    if (s->first) {\n160\t        s->val = *vp;\n161\t        s->first = false;\n162\t        write_bits(&s->w, *vp, 64);\n163\t        return 0;\n164\t    }\n165\t\n166\t    u64 vdelta = *vp ^ s->val;\n167\t\n168\t    if (vdelta == 0) {\n169\t        write_bit(&s->w, 0);\n170\t    }\n171\t    else {\n172\t        write_bit(&s->w, 1);\n173\t    }\n174\t\n175\t    u64 leading = leading_zero64(vdelta);\n176\t    u64 trailing = trailing_zero64(vdelta);\n177\t\n178\t    leading &= 0x1F;\n179\t    if (leading >= 32)\n180\t        leading = 31;\n181\t\n182\t    if (s->leading != ~0 && leading > s->leading &&\n183\t        trailing >= s->trailing) {\n184\t        write_bit(&s->w, 0);\n185\t        write_bits(&s->w, vdelta >> s->trailing, \n186\t        64 - s->leading - s->trailing);\n187\t    }\n188\t    else {\n189\t        s->leading = leading;\n190\t        s->trailing = trailing;\n191\t        write_bit(&s->w, 1);\n192\t        write_bits(&s->w, leading, 5);\n193\t\n194\t        u64 sigbits = 64 -leading - trailing;\n195\t        write_bits(&s->w, sigbits, 6);\n196\t        write_bits(&s->w, vdelta >> trailing, sigbits);\n197\t    }\n198\t\n199\t    s->val = *vp;\n200\t    return 0;\n201\t}\n202\t\n203\t\n204\tint float_encode_flush(float_encoder_t* s, u8* dst, u32* length)\n205\t{\n206\t    f64* na = (f64*)&Nan;\n207\t    \n208\t    if (!s->finished) {\n209\t        s->finished = true;\n210\t        float_encode_write(s, *na);\n211\t        write_flush(&s->w, 0);\n212\t    }\n213\t\n214\t    *length = s->w.pos + 1;\n215\t    memcpy(dst, s->w.cache, s->w.pos + 1);\n216\t    return *length;\n217\t}\n218\t\n219\tint float_cache_print(float_encoder_t* s)\n220\t{\n221\t    int i = 0;\n222\t    u8 *a = s->w.cache;\n223\t    \n224\t    for (i = 0; i < s->w.pos + 1; i++) {\n225\t        printf(\"%02x \", a[i]);\n226\t        if ((i+1) % 16 == 0)\n227\t                printf(\"\\n\");\n228\t        else if ((i + 1) % 8 == 0)\n229\t                printf(\"  \");\n230\t    }\n231\t    printf(\"\\n\");\n232\t}\n233\t\n234\tint bit_readbuf(bitreader_t* br)\n235\t{\n236\t    u32 i = 0;\n237\t    u32 byte_n = 8 - (br->n / 8);\n238\t\n239\t    if (br->len && byte_n > br->len) {\n240\t        byte_n = br->len;\n241\t    }\n242\t\n243\t    if (byte_n == 8) {\n244\t        br->v = (u64)(br->data[7]) | (u64)(br->data[6])<<8 |\n245\t                (u64)(br->data[5])<<16 | (u64)(br->data[4])<<24 |\n246\t                (u64)(br->data[3])<<32 | (u64)(br->data[2])<<40 |\n247\t                (u64)(br->data[1])<<48 | (u64)(br->data[0])<<56;\n248\t        br->n = 64;\n249\t        br->data = br->data + 8;\n250\t        br->len = br->len - 8;\n251\t        return 0;\n252\t    }\n253\t\n254\t    for (i = 0; i < byte_n; i++) {\n255\t        br->n += 8;\n256\t        br->v |= (u64)(br->data[i]) << (64 - br->n);\n257\t    }\n258\t\n259\t    br->data = br->data + byte_n;\n260\t    br->len = br->len - byte_n;\n261\t    return 0;\n262\t}\n263\t\n264\tint bitread_reset(bitreader_t* br, u8* data, u32 len) \n265\t{\n266\t    br->data = data;\n267\t    br->len = len;\n268\t    br->n = 0;\n269\t    br->v = 0;\n270\t    bit_readbuf(br);\n271\t    return 0;\n272\t}\n273\t\n274\tu64 read_bits(bitreader_t* br, u32 nbits)\n275\t{\n276\t    u64 v = 0, n = 0;\n277\t    if (br->n == 0) {\n278\t        return ~0;\n279\t    }\n280\t\n281\t    if (nbits <= br->n) {\n282\t        if (nbits == 64) {\n283\t            v = br->v;\n284\t            br->n = 0;\n285\t            br->v = 0;\n286\t            bit_readbuf(br);\n287\t            return v;\n288\t        }\n289\t\n290\t        v = br->v >> (64 - nbits);\n291\t        br->v = br->v << nbits;\n292\t        br->n = br->n - nbits;\n293\t        if (br->n == 0) {\n294\t            bit_readbuf(br);\n295\t        }\n296\t        return v;\n297\t    }\n298\t\n299\t    //read all available bits in current buffer.\n300\t    v = br->v;\n301\t    n = br->n;\n302\t\n303\t    br->v = 0;\n304\t    br->n = 0;\n305\t    bit_readbuf(br);\n306\t\n307\t    // Append new buffer to previous buffer and shift to remove unnecessary bits.\n308\t    v |= (br->v >> n);\n309\t    v >>= 64 - nbits;\n310\t\n311\t    // Remove used bits from new buffer.\n312\t    u32 buf_n = nbits - n;\n313\t    if (buf_n > br->n) {\n314\t        buf_n = br->n;\n315\t    }\n316\t    br->v <<= buf_n;\n317\t    br->n -= buf_n;\n318\t\n319\t    if (br->n == 0) {\n320\t        bit_readbuf(br);\n321\t    }\n322\t\n323\t    return v;\n324\t}\n325\t\n326\tu64  read_bit(bitreader_t* br)\n327\t{\n328\t    return read_bits(br, 1);\n329\t}\n330\t\n331\tbool can_read_bitfast(bitreader_t* br)\n332\t{\n333\t    if (br->n > 1)\n334\t        return true;\n335\t    else\n336\t        return false;\n337\t}\n338\t\n339\tbool read_bitfast(bitreader_t* br)\n340\t{\n341\t    bool v = ((br->v & ((u64)1<<63)) != 0);\n342\t    br->v <<= 1;\n343\t    br->n -= 1;\n344\t    return v;\n345\t}\n346\t\n347\t// Next returns true if there are remaining values to read.\n348\tbool read_next(float_decoder_t* s)\n349\t{\n350\t    u64 v = 0;\n351\t    u64 bits, mbits, vbits;\n352\t    if (s->finished || s->err) {\n353\t        return false;\n354\t    }\n355\t\n356\t    if (s->first) {\n357\t        s->first = false;\n358\t        // mark as finished if there were no values.\n359\t        if (s->val == Nan) { // IsNaN\n360\t            s->finished = true;\n361\t            return false;\n362\t        }\n363\t        return true;\n364\t    }\n365\t\n366\t    // read compressed value\n367\t    bool abit;\n368\t    if (can_read_bitfast(&s->br)) {\n369\t        abit = read_bitfast(&s->br);\n370\t    } else if (v = read_bit(&s->br) == ~0) {\n371\t        s->err = 1;\n372\t        return false;\n373\t    } else {\n374\t        abit = v;\n375\t    }\n376\t\n377\t    if (abit) {\n378\t        bool bit;\n379\t        if (can_read_bitfast(&s->br)) {\n380\t            bit = read_bitfast(&s->br);\n381\t        } else if (v = read_bit(&s->br) == ~0) {\n382\t            s->err = 1;\n383\t            return false;\n384\t        } else {\n385\t            bit = v;\n386\t        }\n387\t\n388\t        if (!bit) {\n389\t            // reuse leading/trailing zero bits\n390\t            // it.leading, it.trailing = it.leading, it.trailing\n391\t            ;\n392\t        } else {\n393\t            bits = read_bits(&s->br, 5);\n394\t            if (bits == ~0) {\n395\t                s->err = 1;\n396\t                return false;\n397\t            }\n398\t            s->leading = bits;\n399\t\n400\t            bits = read_bits(&s->br, 6);\n401\t            if (bits == ~0) {\n402\t                s->err = 1;\n403\t                return false;\n404\t            }\n405\t            mbits = bits;\n406\t            // 0 significant bits here means