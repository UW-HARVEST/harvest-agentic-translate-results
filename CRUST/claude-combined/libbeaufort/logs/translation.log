{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019JkmVnXPYhPXcaocuoujRg","type":"tool_result","content":"1\tuse libbeaufort::decrypt::beaufort_decrypt;\n2\tuse libbeaufort::encrypt::beaufort_encrypt;\n3\tuse libbeaufort::tableau::beaufort_tableau;\n4\tuse libbeaufort::*;\n5\t\n6\t#[test]\n7\tfn test_encrypt() {\n8\t    let monkey_s = b\"kinkajous are awesome\";\n9\t    let monkey_key = b\"monkey\";\n10\t    let monkey = beaufort_encrypt(monkey_s, monkey_key, &[]);\n11\t    assert_eq!(monkey, b\"26004Fyuv AnK Cs9sqC8\");\n12\t\n13\t    let goodman_s = b\"the \\nbig \\nlebowski\";\n14\t    let goodman_key = b\"goodman\";\n15\t    let goodman = beaufort_encrypt(goodman_s, goodman_key, &[]);\n16\t    assert_eq!(goodman, b\"n7A \\n24u \\n22D0huq5\");\n17\t\n18\t    let groove_s = b\"d4nc3 t0 th3 mus!c :D\";\n19\t    let groove_key = b\"groove\";\n20\t    let groove = beaufort_encrypt(groove_s, groove_key, &[]);\n21\t    assert_eq!(groove, b\"3n1Cs lg y7l 9ko!F :b\");\n22\t}\n23\t\n24\t#[test]\n25\tfn test_decrypt() {\n26\t    let monkey_s = b\"kinkajous are awesome\";\n27\t    let monkey_key = b\"monkey\";\n28\t    let monkey = beaufort_encrypt(monkey_s, monkey_key, &[]);\n29\t    let decrypted = beaufort_decrypt(&monkey, monkey_key, &[]);\n30\t    assert_eq!(decrypted, monkey_s);\n31\t\n32\t    let goodman_s = b\"the \\nbig \\nlebowski\";\n33\t    let goodman_key = b\"goodman\";\n34\t    let goodman = beaufort_encrypt(goodman_s, goodman_key, &[]);\n35\t    let decrypted = beaufort_decrypt(&goodman, goodman_key, &[]);\n36\t    assert_eq!(decrypted, goodman_s);\n37\t\n38\t    let groove_s = b\"d4nc3 t0 th3 mus!c :D\";\n39\t    let groove_key = b\"groove\";\n40\t    let groove = beaufort_encrypt(groove_s, groove_key, &[]);\n41\t    let decrypted = beaufort_decrypt(&groove, groove_key, &[]);\n42\t    assert_eq!(decrypted, groove_s);\n43\t}\n44\t\n45\t#[test]\n46\tfn test_tableau() {\n47\t    let mat = beaufort_tableau(std::str::from_utf8(BEAUFORT_ALPHA).unwrap());\n48\t    assert!(!mat.is_empty());\n49\t\n50\t    let mat_small = beaufort_tableau(\"abc\");\n51\t    assert_eq!(mat_small.len(), 3);\n52\t    assert_eq!(mat_small[0], b\"acb\");\n53\t    assert_eq!(mat_small[1], b\"bac\");\n54\t    assert_eq!(mat_small[2], b\"cba\");\n55\t}\n56\t\n57\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"7a672158-1cb2-4426-b6ab-c4d7995f4b28","uuid":"a079054c-1dba-4eaa-befb-337a7cbeecd2","timestamp":"2026-05-30T08:15:38.142Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-t3OIqG/project/src/bin/test_all.rs","content":"use libbeaufort::decrypt::beaufort_decrypt;\nuse libbeaufort::encrypt::beaufort_encrypt;\nuse libbeaufort::tableau::beaufort_tableau;\nuse libbeaufort::*;\n\n#[test]\nfn test_encrypt() {\n    let monkey_s = b\"kinkajous are awesome\";\n    let monkey_key = b\"monkey\";\n    let monkey = beaufort_encrypt(monkey_s, monkey_key, &[]);\n    assert_eq!(monkey, b\"26004Fyuv AnK Cs9sqC8\");\n\n    let goodman_s = b\"the \\nbig \\nlebowski\";\n    let goodman_key = b\"goodman\";\n    let goodman = beaufort_encrypt(goodman_s, goodman_key, &[]);\n    assert_eq!(goodman, b\"n7A \\n24u \\n22D0huq5\");\n\n    let groove_s = b\"d4nc3 t0 th3 mus!c :D\";\n    let groove_key = b\"groove\";\n    let groove = beaufort_encrypt(groove_s, groove_key, &[]);\n    assert_eq!(groove, b\"3n1Cs lg y7l 9ko!F :b\");\n}\n\n#[test]\nfn test_decrypt() {\n    let monkey_s = b\"kinkajous are awesome\";\n    let monkey_key = b\"monkey\";\n    let monkey = beaufort_encrypt(monkey_s, monkey_key, &[]);\n    let decrypted = beaufort_decrypt(&monkey, monkey_key, &[]);\n    assert_eq!(decrypted, monkey_s);\n\n    let goodman_s = b\"the \\nbig \\nlebowski\";\n    let goodman_key = b\"goodman\";\n    let goodman = beaufort_encrypt(goodman_s, goodman_key, &[]);\n    let decrypted = beaufort_decrypt(&goodman, goodman_key, &[]);\n    assert_eq!(decrypted, goodman_s);\n\n    let groove_s = b\"d4nc3 t0 th3 mus!c :D\";\n    let groove_key = b\"groove\";\n    let groove = beaufort_encrypt(groove_s, groove_key, &[]);\n    let decrypted = beaufort_decrypt(&groove, groove_key, &[]);\n    assert_eq!(decrypted, groove_s);\n}\n\n#[test]\nfn test_tableau() {\n    let mat = beaufort_tableau(std::str::from_utf8(BEAUFORT_ALPHA).unwrap());\n    assert!(!mat.is_empty());\n\n    let mat_small = beaufort_tableau(\"abc\");\n    assert_eq!(mat_small.len(), 3);\n    assert_eq!(mat_small[0], b\"acb\");\n    assert_eq!(mat_small[1], b\"bac\");\n    assert_eq!(mat_small[2], b\"cba\");\n}\n\nfn main(){}","numLines":57,"startLine":1,"totalLines":57}}}
