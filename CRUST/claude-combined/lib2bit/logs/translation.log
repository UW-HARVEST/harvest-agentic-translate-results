f (mask & 8) != 0 && i >= len {\n                    mask -= 8;\n                }\n            }\n\n            let mut foo = bytes[j] as u32;\n            j += 1;\n            // Offset 3\n            if mask & 1 != 0 {\n                tmp[(foo & 3) as usize] += 1;\n            }\n            foo >>= 2;\n            mask >>= 1;\n            // Offset 2\n            if mask & 1 != 0 {\n                tmp[(foo & 3) as usize] += 1;\n            }\n            foo >>= 2;\n            mask >>= 1;\n            // Offset 1\n            if mask & 1 != 0 {\n                tmp[(foo & 3) as usize] += 1;\n            }\n            foo >>= 2;\n            mask >>= 1;\n            // Offset 0\n            if mask & 1 != 0 {\n                tmp[(foo & 3) as usize] += 1;\n            }\n            i += 4;\n            mask = 15;\n        }\n\n        let _ = len; // silence warning\n        let _ = nbytes;\n\n        // Output: in ACTG order\n        if fraction != 0 {\n            // Return 4 f64 values, but signature is Vec<u8>.\n            // We pack the f64 values as their byte representation.\n            let mut out: Vec<u8> = Vec::with_capacity(32);\n            let vals = [\n                tmp[2] as f64 / seq_len as f64,\n                tmp[1] as f64 / seq_len as f64,\n                tmp[0] as f64 / seq_len as f64,\n                tmp[3] as f64 / seq_len as f64,\n            ];\n            for v in vals.iter() {\n                out.extend_from_slice(&v.to_le_bytes());\n            }\n            out\n        } else {\n            let mut out: Vec<u8> = Vec::with_capacity(16);\n            let vals = [tmp[2], tmp[1], tmp[0], tmp[3]];\n            for v in vals.iter() {\n                out.extend_from_slice(&v.to_le_bytes());\n            }\n            out\n        }\n    }\n\n    pub fn twoBitIndexRead(&mut self, storeMasked: i32) {\n        let n_chroms = self.hdr.n_chroms as usize;\n        self.idx.size = vec![0u32; n_chroms];\n        self.idx.n_block_co