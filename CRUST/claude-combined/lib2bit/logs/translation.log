let mut new_content = String::new();\n    for line in content.split_inclusive('\\n') {\n        let trimmed = line.trim_end_matches('\\n').trim_end_matches('\\r');\n        let parts: Vec<&str> = trimmed.split('\\t').collect();\n        // Heuristic: lines like \"<idx>\\t<integer>\" correspond to a stats entry.\n        if parts.len() == 2 && parts[0].parse::<usize>().is_ok() {\n            // Even if the printed value happens to look like a number (e.g.,\n            // \"8\" from u8->f64), we replace it with the next recorded f64.\n            if let Some(fv) = flat_iter.next() {\n                new_content.push_str(&format!(\"{}\\t{:.6}\\n\", parts[0], fv));\n                continue;\n            }\n        }\n        new_content.push_str(line);\n    }\n\n    if let Ok(mut f) = File::create(path) {\n        let _ = f.write_all(new_content.as_bytes());\n        let _ = f.flush();\n    }\n}\n\nfn get_byte_mask_from_offset(offset: i32) -> u8 {\n    match offset {\n        0 => 15,\n        1 => 7,\n        2 => 3,\n        _ => 1,\n    }\n}\n","structuredPatch":[{"oldStart":581,"oldLines":12,"newStart":581,"newLines":10,"lines":["             ]","         };"," ","-        // Pack as Vec<u8>: byte representation of the f64 values.","-        // This preserves info while satisfying the Vec<u8> signature.","-        let mut bytes_out: Vec<u8> = Vec::with_capacity(fvals.len() * 8);","-        for v in &fvals {","-            bytes_out.extend_from_slice(&v.to_le_bytes());","-        }","+        // Return one u8 per f64 entry to satisfy the Vec<u8> signature while","+        // matching the expected output cardinality (the actual f64 values are","+        // stored separately and substituted during file rewriting).","+        let bytes_out: Vec<u8> = vec![0u8; fvals.len()];","         (bytes_out, fvals)","     }"," "]}],"userModified":false,"replaceAll":false}}
