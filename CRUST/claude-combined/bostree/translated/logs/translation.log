{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_019gmPV3oZ2UZB37diZpCH7s","type":"tool_result","content":"1\tpub mod bostree;\n2\t\n3\tuse std::cmp::max;\n4\tuse std::rc::Rc;\n5\tuse std::cell::RefCell;\n6\tuse crate::bostree::{BOSTree, BOSNode, bostree_next_node, bostree_rank, bostree_previous_node};\n7\t\n8\tpub fn test_tree_sanity(tree: &BOSTree) {\n9\t    // Count nodes by traversing using select(0) and next_node().\n10\t    let mut count = 0;\n11\t    let mut current = tree.bostree_select(0);\n12\t    while let Some(node) = current {\n13\t        count += 1;\n14\t        current = bostree_next_node(&node);\n15\t    }\n16\t    let reported_count = tree.bostree_node_count();\n17\t    if count != reported_count {\n18\t        println!(\n19\t            \"Manual node count yielded {}, order statistics reported {}\",\n20\t            count, reported_count\n21\t        );\n22\t        panic!(\"Exiting due to errors.\");\n23\t    }\n24\t    // For each in-order index, check various invariants.\n25\t    for i in 0..reported_count {\n26\t        let node_opt = tree.bostree_select(i);\n27\t        if node_opt.is_none() {\n28\t            println!(\n29\t                \"Rank {} node not found, though count is {}\",\n30\t                i, reported_count\n31\t            );\n32\t            panic!(\"Exiting due to errors.\");\n33\t        }\n34\t        let node = node_opt.unwrap();\n35\t        let rank = bostree_rank(&node);\n36\t        if rank != i {\n37\t            println!(\n38\t                \"Rank for node {} is {} but should be {}\",\n39\t                node.borrow().key,\n40\t                rank,\n41\t                i\n42\t            );\n43\t            panic!(\"Exiting due to errors.\");\n44\t        }\n45\t        let lookup_node = tree.bostree_lookup(&node.borrow().key);\n46\t        if let Some(ln) = lookup_node {\n47\t            if !Rc::ptr_eq(&node, &ln) {\n48\t                println!(\"Lookup for {} returned the wrong node.\", node.borrow().key);\n49\t                panic!(\"Exiting due to errors.\");\n50\t            }\n51\t        } else {\n52\t            println!(\"Lookup for {} returned None.\", node.borrow().key);\n53\t            panic!(\"Exiting due to errors.\");\n54\t        }\n55\t        let next_node = bostree_next_node(&node);\n56\t        let select_next = tree.bostree_select(i + 1);\n57\t        match (next_node, select_next) {\n58\t            (Some(n1), Some(n2)) => {\n59\t                if !Rc::ptr_eq(&n1, &n2) {\n60\t                    println!(\n61\t                        \"Next node is {}, but select(i+1) is {}\",\n62\t                        n1.borrow().key,\n63\t                        n2.borrow().key\n64\t                    );\n65\t                    panic!(\"Exiting due to errors.\");\n66\t                }\n67\t            }\n68\t            (None, None) => {}\n69\t            _ => {\n70\t                println!(\"Mismatch between next node and select(i+1) for index {}\", i);\n71\t                panic!(\"Exiting due to errors.\");\n72\t            }\n73\t        }\n74\t        let prev_node = if i == 0 {\n75\t            None\n76\t        } else {\n77\t            tree.bostree_select(i - 1)\n78\t        };\n79\t        let node_prev = bostree_previous_node(&node);\n80\t        match (prev_node, node_prev) {\n81\t            (Some(n1), Some(n2)) => {\n82\t                if !Rc::ptr_eq(&n1, &n2) {\n83\t                    println!(\n84\t                        \"Previous node is {}, but select(i-1) is {}\",\n85\t                        n2.borrow().key,\n86\t                        n1.borrow().key\n87\t                    );\n88\t                    panic!(\"Exiting due to errors.\");\n89\t                }\n90\t            }\n91\t            (None, None) => {}\n92\t            _ => {\n93\t                println!(\n94\t                    \"Mismatch between previous node and select(i-1) for index {}\",\n95\t                    i\n96\t          