ey {\n                return Some(&item.value);\n            }\n        }\n        None\n    }\n    pub fn remove(&mut self, key: &K) {\n        let idx = (self.hash_f)(key) % self.buckets.len();\n        let bucket = &mut self.buckets[idx];\n        let mut new_list = LinkedList::new();\n        let mut removed = false;\n        while let Some(item) = bucket.items.pop_front() {\n            if &item.key == key && !removed {\n                removed = true;\n                continue;\n            }\n            new_list.push_back(item);\n        }\n        bucket.items = new_list;\n        if removed {\n            self.n_items -= 1;\n        }\n    }\n    pub fn resize(&mut self) {\n        let new_size = self.buckets.len() * 2;\n        let mut new_buckets: Vec<Bucket<K, V>> = Vec::with_capacity(new_size);\n        for _ in 0..new_size {\n            new_buckets.push(Bucket { items: LinkedList::new() });\n        }\n        let old_buckets = std::mem::replace(&mut self.buckets, new_buckets);\n        for bucket in old_buckets.into_iter() {\n            for item in bucket.items.into_iter() {\n                let idx = (self.hash_f)(&item.key) % self.buckets.len();\n                self.buckets[idx].items.push_back(item);\n            }\n        }\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1737,"cache_read_input_tokens":91059,"cache_creation":{"ephemeral_5m_input_tokens":1737,"ephemeral_1h_input_tokens":0},"output_tokens":22,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6786dbf3-a143-4fbd-bec2-a2c7975e4f05","uuid":"a512ae27-9053-462f-af30-824dc3e3a121"}
