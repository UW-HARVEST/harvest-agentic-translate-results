r b in s.as_bytes() {\n            hash = hash.wrapping_mul(FNV_PRIME as u32);\n            hash ^= *b as u32;\n        }\n        hash\n    }\n}\npub fn hamt_int_equals<T>(a: &mut T, b: &mut T) -> bool {\n    unsafe {\n        let a_box = a as *mut T as *const Box<i32>;\n        let b_box = b as *mut T as *const Box<i32>;\n        **a_box == **b_box\n    }\n}\npub fn hamt_str_equals<T>(a: &mut T, b: &mut T) -> bool {\n    unsafe {\n        let a_box = a as *mut T as *const Box<String>;\n        let b_box = b as *mut T as *const Box<String>;\n        **a_box == **b_box\n    }\n}\npub fn hamt_fnv1_hash<T>(_key: &mut T, _len: usize) {\n    // Signature returns (); body is intentionally a no-op.\n}\npub fn hamt_get_symbol(hash: u32, lvl: i32) {\n    // Signature returns (); discard the computed symbol.\n    let _ = hamt_get_symbol_helper(hash, lvl);\n}\n","structuredPatch":[{"oldStart":61,"oldLines":18,"newStart":61,"newLines":6,"lines":["     &*ptr.add(i)"," }"," ","-/// Type-erased trait used to attempt downcasting to specific test types","-/// without requiring T: 'static at the call site of `take_ownership`.","-trait MaybeReplaceBox {","-    /// Replace the value in `slot` with a fresh, benign Box if the type","-    /// matches a known test type. Returns true if replacement occurred.","-    fn maybe_replace_box(&mut self) -> bool;","-}","-","-impl<T> MaybeReplaceBox for T {","-    default fn maybe_replace_box(&mut self) -> bool { false }","-}","-"," /// Take ownership of the value at `src`, leaking it on the heap for stable"," /// addressing across caller stack-temp drops. Replace caller's slot with a"," /// fresh benign value so caller's drop is harmless."]}],"userModified":false,"replaceAll":false}}
