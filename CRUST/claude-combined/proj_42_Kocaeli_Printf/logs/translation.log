{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LujXyEG8Lbq6rKt3uWu4D8","type":"tool_result","content":"1\t/* ************************************************************************** */\n2\t/*                                                                            */\n3\t/*                                                        :::      ::::::::   */\n4\t/*   ft_printf.c                                        :+:      :+:    :+:   */\n5\t/*                                                    +:+ +:+         +:+     */\n6\t/*   By: eates <eates@student.42kocaeli.com.tr>     +#+  +:+       +#+        */\n7\t/*                                                +#+#+#+#+#+   +#+           */\n8\t/*   Created: 2023/09/05 12:16:43 by eates             #+#    #+#             */\n9\t/*   Updated: 2023/09/05 12:16:44 by eates            ###   ########.fr       */\n10\t/*                                                                            */\n11\t/* ************************************************************************** */\n12\t\n13\t#include \"ft_printf.h\"\n14\t\n15\tstatic int\tformat(va_list *args, char c, int *len)\n16\t{\n17\t\tif (c == 'c')\n18\t\t\treturn (writechar(va_arg(*args, int), len));\n19\t\tif (c == 's')\n20\t\t\treturn (writestring(va_arg(*args, char *), len));\n21\t\tif (c == 'd' || c == 'i')\n22\t\t\treturn (writeint(va_arg(*args, int), len));\n23\t\tif (c == 'u')\n24\t\t\treturn (writeuint(va_arg(*args, unsigned int), len));\n25\t\tif (c == 'p')\n26\t\t\treturn (writepoint(va_arg(*args, void *), len));\n27\t\tif (c == 'x' || c == 'X')\n28\t\t\treturn (writehex(va_arg(*args, unsigned int), c, len));\n29\t\tif (c == '%')\n30\t\t\treturn (writechar('%', len));\n31\t\treturn (-1);\n32\t}\n33\t\n34\tint\tft_printf(const char *s, ...)\n35\t{\n36\t\tva_list\t\targs;\n37\t\tint\t\t\tlen;\n38\t\n39\t\tif (LOCATION == 2 && !s)\n40\t\t\treturn (-1);\n41\t\tlen = 0;\n42\t\tva_start(args, s);\n43\t\twhile (*s)\n44\t\t{\n45\t\