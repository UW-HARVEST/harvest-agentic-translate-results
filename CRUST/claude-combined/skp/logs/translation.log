m_b = from.as_bytes();\n                let to_b = to.as_bytes();\n                let len = from_b.len().saturating_sub(to_b.len());\n                let s = &from_b[..len];\n                for &c in s {\n                    if c == b'\\'' {\n                        let _ = write!(f, \"\\\\\");\n                    }\n                    let _ = f.write_all(&[c]);\n                }\n                let _ = write!(f, \"'\");\n            }\n            let _ = writeln!(f);\n        } else {\n            levl -= 4;\n        }\n    }\n}\n","structuredPatch":[{"oldStart":684,"oldLines":10,"newStart":684,"newLines":15,"lines":[" ","     if had_real_match && p_byte <= 7 {","         let ret = if p_byte > 0 { p_byte as i32 } else { 1 };","-        let to_pos = if skp_to_flag { start } else { s };","-        // Return: (ret, end-of-match position, start-of-match position).","-        // For non-skp_to these are the same.","-        return (ret, s, to_pos);","+        // Return value semantics:","+        //  - When skp_to is set, the user code computes `len = end.len() - to.len()`","+        //    and expects this to be the matched length. We provide:","+        //       to_pos_start = start (start byte of match)","+        //       to_pos_end   = s     (end byte of match)","+        //       end_pos      = 0     (full src is returned as `end`)","+        //    so we encode this with: 2nd_return = (start, s), 3rd_return = (0, src.len())","+        //  - When skp_to is not set, both values point to `s` (post-match).","+        return (ret, s, if skp_to_flag { start } else { s });","     }"," ","     (0, 0, 0)"]}],"userModified":false,"replaceAll":false}}
