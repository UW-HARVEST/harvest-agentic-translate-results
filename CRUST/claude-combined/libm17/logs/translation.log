.047453533621088f,\n406\t// \t 0.039168634270669f,  0.179164496628150f,\n407\t// \t 0.336694345124862f,  0.461088271869920f,\n408\t// \t 0.508340710642860f,  0.461088271869920f,\n409\t// \t 0.336694345124862f,  0.179164496628150f,\n410\t// \t 0.039168634270669f, -0.047453533621088f,\n411\t// \t-0.072094910038768f, -0.051615756197679f,\n412\t// \t-0.015182045838927f,  0.011949415510291f,\n413\t// \t 0.018981413448435f,  0.010204314627992f,\n414\t// \t-0.002410076268276f, -0.008697733303330f,\n415\t// \t-0.005994389201970f,  0.001355815246317f,\n416\t// \t 0.006823188093192f,  0.006734308458208f,\n417\t// \t 0.002187793653660f, -0.002744505321971f,\n418\t// \t-0.004519384154389f\n419\t// };\n420\t\n421\t\n422\t//--------------------------------------------------------------------\n423\t// M17 C library - math/math.c\n424\t//\n425\t// This file contains:\n426\t// - absolute difference value\n427\t// - Euclidean norm (L2) calculation for n-dimensional vectors (float)\n428\t// - soft-valued arrays to integer conversion (and vice-versa)\n429\t// - fixed-valued multiplication and division\n430\t//\n431\t// Wojciech Kaczmarski, SP5WWP\n432\t// M17 Project, 29 December 2023\n433\t//--------------------------------------------------------------------\n434\t// #include <math.h>\n435\t// #include <m17.h>\n436\t\n437\t/**\n438\t * @brief Utility function returning the absolute value of a difference between\n439\t * two fixed-point values.\n440\t *\n441\t * @param v1 First value.\n442\t * @param v2 Second value.\n443\t * @return abs(v1-v2) value.\n444\t */\n445\tuint16_t q_abs_diff(const uint16_t v1, const uint16_t v2)\n446\t{\n447\t    if(v2 > v1) return v2 - v1;\n448\t    return v1 - v2;\n449\t}\n450\t\n451\t/**\n452\t * @brief Calculate L2 norm between two n-dimensional vectors of floats.\n453\t *\n454\t * @param in1 Vector 1.\n455\t * @param in2 Vector 2.\n456\t * @param n Vectors' size.\n457\t * @return float L2 norm.\n458\t */\n459\tfloat eucl_norm(const float* in1, const int8_t* in2, const uint8_t n)\n460\t{\n461\t    float tmp = 0.0f;\n462\t\n463\t    for(uint8_t i=0; i<n; i++)\n464\t    {\n465\t        tmp += (in1[i]-(float)in2[i])*(in1[i]-(float)in2[i]);\n466\t    }\n467\t\n468\t    return sqrtf(tmp);\n469\t}\n470\t\n471\t/**\n472\t * @brief Convert an unsigned int into an array of soft, fixed-point values.\n473\t * Maximum length is 16. LSB is at index 0.\n474\t * @param out Pointer to an array of uint16_t.\n475\t * @param in Input value.\n476\t * @param len Input's bit length.\n477\t */\n478\tvoid int_to_soft(uint16_t* out, const uint16_t in, const uint8_t len)\n479\t{\n480\t\tfor(uint8_t i=0; i<len; i++)\n481\t\t{\n482\t\t\t(in>>i)&1 ? (out[i]=0xFFFF) : (out[i]=0);\n483\t\t}\n484\t}\n485\t\n486\t/**\n487\t * @brief Convert an array of soft, fixed-point\n488\t * Maximum length is 16. LSB is at index 0.\n489\t * @param in Pointer to an array of uint16_t.\n490\t * @param len Input's length.\n491\t * @return uint16_t Return value.\n492\t */\n493\tuint16_t soft_to_int(const uint16_t* in, const uint8_t len)\n494\t{\n495\t\tuint16_t tmp=0;\n496\t\n497\t\tfor(uint8_t i=0; i<len; i++)\n498\t\t{\n499\t\t\tif(in[i]>0x7FFFU)\n500\t\t\t\ttmp|=(1<<i);\n501\t\t}\n502\t\n503\t\treturn tmp;\n504\t}\n505\t\n506\t/**\n507\t * @brief 1st quadrant fixed point addition with saturation.\n508\t *\n509\t * @param a Addend 1.\n510\t * @param b Addend 2.\n511\t * @return uint16_t Sum = a+b.\n512\t */\n513\tuint16_t add16(const uint16_t a, const uint16_t b)\n514\t{\n515\t\tuint32_t r=(uint32_t)a+b;\n516\t\t\n517\t\treturn r<=0xFFFFU ? r : 0xFFFFU;\n518\t}\n519\t\n520\t/**\n521\t * @brief 1st quadrant fixed point subtraction with saturation.\n522\t *\n523\t * @param a Minuend.\n524\t * @param b Subtrahent.\n525\t * @return uint16_t Difference = a-b.\n526\t */\n527\tuint16_t sub16(const uint16_t a, const uint16_t b)\n528\t{\t\n529\t\tif(a>=b)\n530\t\t\treturn a-b;\n531\t\telse\n532\t\t\treturn 0x0000U;\n533\t}\n534\t\n535\t/**\n536\t * @brief 1st quadrant fixed point division with saturation.\n537\t *\n538\t * @param a Dividend.\n539\t * @param b Divisor.\n540\t * @return uint16_t Quotient = a/b.\n541\t */\n542\tuint16_t div16(const uint16_t a, const uint16_t b)\n543\t{\n544\t\tuint32_t aa=(uint32_t)a<<16;\n545\t\tuint32_t r=aa/b;\n546\t\n547\t\treturn r<=0xFFFFU ? r : 0xFFFFU;\n548\t}\n549\t\n550\t/**\n551\t * @brief 1st quadrant fixed point multiplication.\n552\t *\n553\t * @param a Multiplicand.\n554\t * @param b Multiplier.\n555\t * @return uint16_t Product = a*b.\n556\t */\n557\tuint16_t mul16(const uint16_t a, const uint16_t b)\n558\t{\n559\t\treturn (uint16_t)(((uint32_t)a*b)>>16);\n560\t}\n561\t\n562\t/**\n563\t * @brief Bilinear interpolation (soft-valued expansion) for XOR.\n564\t * This approach retains XOR(0.5, 0.5)=0.5\n565\t * https://math.stackexchange.com/questions/3505934/evaluation-of-not-and-xor-in-fuzzy-logic-rules\n566\t * @param a Input A.\n567\t * @param b Input B.\n568\t * @return uint16_t Output = A xor B.\n569\t */\n570\tuint16_t soft_bit_XOR(const uint16_t a, const uint16_t b)\n571\t{\n572\t\t//a(1-b)+b(1-a)\n573\t\t//return mul16(div16(0xFFFF-b, 0xFFFF), div16(a, 0xFFFF)) + mul16(div16(b, 0xFFFF), div16(0xFFFF-a, 0xFFFF));\n574\t\treturn add16(mul16(a, sub16(0xFFFF, b)), mul16(b, sub16(0xFFFF, a)));\n575\t}\n576\t\n577\t/**\n578\t * @brief Soft logic NOT.\n579\t * \n580\t * @param a Input A.\n581\t * @return uint16_t Output = not A.\n582\t */\n583\tuint16_t soft_bit_NOT(const uint16_t a)\n584\t{\n585\t\treturn 0xFFFFU-a;\n586\t}\n587\t\n588\t/**\n589\t * @brief XOR for vectors of soft-valued logic.\n590\t * Max length is 255.\n591\t * @param out Output vector = A xor B.\n592\t * @param a Input vector A.\n593\t * @param b Input vector B.\n594\t * @param len Vectors' size.\n595\t */\n596\tvoid soft_XOR(uint16_t* out, const uint16_t* a, const uint16_t* b, const uint8_t len)\n597\t{\n598\t\tfor(uint8_t i=0; i<len; i++)\n599\t\t\tout[i]=soft_bit_XOR(a[i], b[i]);\n600\t}\n601\t"}]},"parent_tool_u