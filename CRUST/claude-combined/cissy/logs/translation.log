{\n63\t\t\t\tfprintf(stderr, \"csv_setCsvfield: malloc error\\n\");\n64\t\t\t\texit(-1);\n65\t\t\t}\n66\t\t}\n67\t\tstrncpy(pField->data, &buf[offset], buflen);\n68\t\tpField->data[buflen] = '\\0';\n69\t}\n70\t\n71\t/**\n72\t*  Append to the Field. Add nul termination.\n73\t*\n74\t* @param pField field to set\n75\t* @param buf input\n76\t* @param offset offset\n77\t* @param buflen length\n78\t*/\n79\tvoid csvfield_append(struct csvfield* pField, const char* buf, int offset, int buflen) {\n80\t  int origflen = ( pField->data ? strlen(pField->data) : 0);\n81\t  if ( (origflen + buflen + 1) > pField->len ) {\n82\t    char* tmp = pField->data;\n83\t    pField->len = pField->len + buflen + STR_MEM_PAD;\n84\t    pField->data = malloc(pField->len);\n85\t    if (pField->data == NULL) {\n86\t      fprintf(stderr, \"csv_setCsvfield: malloc error\\n\");\n87\t      exit(-1);\n88\t    }\n89\t    if (tmp != NULL) {\n90\t      strncpy(pField->data, tmp, strlen(tmp)+1);\n91\t      free(tmp);\n92\t    }\n93\t  }\n94\t  strncpy(&pField->data[origflen], &buf[offset], buflen);\n95\t  pField->data[origflen + buflen] = '\\0';\n96\t}\n97\t\n98\t/**\n99\t* create an empty field\n100\t* \n101\t* @return new created field\n102\t*/\n103\tstruct csvfield* csvfield_create() {\n104\t\tstruct csvfield* pField = malloc(sizeof(struct csvfield));\n105\t    if (pField == NULL) {\n106\t      fprintf(stderr, \"csvfield_create: malloc error\\n\");\n107\t      exit(-1);\n108\t    }\t\n109\t\tpField->len = STR_MEM_PAD;\n110\t    pField->data = malloc(pField->len);\n111\t    if (pField->data == NULL) {\n112\t      fprintf(stderr, \"csvfield_create: malloc error\\n\");\n113\t      exit(-1);\n114\t    }\n115\t\treturn pField;\n116\t}\n117\t\n118\t/**\n119\t*  Reset for re-use.\n120\t*\n121\t* @param pField field to reset\n122\t*\n123\t*/\n124\tvoid csvfield_reset(struct csvfield* pField) {\n125\t\tpField->data = '\\0';\n126\t}\n127\t"}]},"parent_tool_use_id":null,"session_id":"9b2977d0-44ac-4861-ac79-6e69bf6