{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VqU4cCUsMXftsWLjucXzii","type":"tool_result","content":"1\t/*\n2\t   Copyright 2015 Steven Lass\n3\t\n4\t   Licensed under the Apache License, Version 2.0 (the \"License\");\n5\t   you may not use this file except in compliance with the License.\n6\t   You may obtain a copy of the License at\n7\t\n8\t       http://www.apache.org/licenses/LICENSE-2.0\n9\t\n10\t   Unless required by applicable law or agreed to in writing, software\n11\t   distributed under the License is distributed on an \"AS IS\" BASIS,\n12\t   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n13\t   See the License for the specific language governing permissions and\n14\t   limitations under the License.\n15\t*/\n16\t\n17\t#include <stdlib.h>\n18\t#include <stdio.h>\n19\t#include <string.h>\n20\t#include <stdbool.h>\n21\t\n22\t#include \"csvline.h\"\n23\t#include \"csvfield.h\"\n24\t\n25\tsize_t csvline_getFieldCnt(struct csvline* cline) {\n26\t  return cline->currentIdx;\n27\t}\n28\t\n29\tchar* csvline_getField(struct csvline* cline, size_t idx) {\n30\t  if (idx >= cline->currentIdx) {\n31\t    return \"\";\n32\t  }\n33\t  return cline->field[idx]->data;\n34\t}\n35\t\n36\t// try to be efficient\n37\tvoid csvline_reset(struct csvline* ptr) {\n38\t  int i;\n39\t  for (i=0; i<ptr->fieldsize; i++) {\n40\t    if (ptr->field[i] != NULL) {\n41\t      csvfield_reset(ptr->field[i]);\n42\t    }\n43\t  }\n44\t  ptr->currentIdx = 0;\n45\t  ptr->eolStr = \"\\n\";\n46\t}\n47\t\n48\tstruct csvline* csvline_create() {\n49\t  struct csvline* ptr = malloc(sizeof(struct csvline));\n50\t  if (ptr == NULL) {\n51\t    fprintf(stderr, \"error: malloc\\n\");\n52\t    exit(-1);\n53\t  }\n54\t  ptr->field = NULL;\n55\t  ptr->fieldsize = 0;\n56\t  ptr->currentIdx = 0;\n57\t  ptr->eolStr = \"\\n\";\n58\t  return ptr;\n59\t}\n60\t\n61\tvoid csvline_printToFile(struct csvline* ptr, FILE* fp) {\n62\t  fprintf(fp, \"[[\");\n63\t  int i;\n64\t  for (i=0; i<ptr->fieldsize; i++) {\n65\t    fprintf(stderr, \"[%s:%d]\", ptr->field[i]->data, (int) ptr->field[i]->len);\n66\t  }\n67\t  fprintf(fp, \"]\");\n68\t  fprintf(fp, \"fs(%d):\", (int) ptr->fieldsize);\n69\t  fprintf(fp, \"i(%d)\", (int) ptr->currentIdx);\n70\t  fprintf(fp, \"]\\n\");\n71\t}\n72\t\n73\t// copy field\n74\t// do not include \\0 in fieldlen\n75\tvoid csvline_addField(struct csvline* cline, const char* txtfield, int fieldstartidx, int fieldlen) {\n76\t  if (cline->fieldsize <= cline->currentIdx) {\n77\t    //realloc a block for effieciency\n78\t    struct csvfield** tmp = cline->field;\n79\t    cline->field = malloc( (cline->fieldsize + 10)*sizeof(struct csvfield*));\n80\t    if (cline->field == NULL) {\n81\t      fprintf(stderr, \"error: malloc\\n\");\n82\t      exit(-1);\n83\t    }\n84\t    if (tmp != NULL) {\n85\t      memcpy(cline->field, tmp, cline->fieldsize*sizeof(struct csvfield *));\n86\t      free(tmp);\n87\t    }\n88\t    cline->fieldsize += 10;\n89\t    int i;\n90\t    for (i=cline->fieldsize-10; i<cline->fieldsize; i++) {\n91\t      cline->field[i]=csvfield_create();\n92\t    }\n93\t  }\n94\t  csvfield_set(cline->field[cline->currentIdx], txtfield, fieldstartidx, fieldlen);\n95\t  cline->currentIdx++;\n96\t}\n97\t\n98\t// append to the last field in the line\n99\tvoid csvline_appendField(struct csvline* cline, const char* txtfield, int fieldstartidx, int fieldlen) {\n100\t  csvfield_append(cline->field[cline->currentIdx - 1], txtfield, fieldstartidx, fieldlen);\n101\t}\n102\t"}]},"parent_tool_use_id":null,"session_id":"9b2977d0-44ac-4861-ac79-6e69bf680962","uuid":"b1a92261-2d38-44ae-9d5d-711588536ff0","timestamp":"2026-05-30T09:38:22.961Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-KCkabe/project/c_src/src/csvline.c","content":"/*\n   Copyright 2015 Steven Lass\n\n   Licensed under the Apache License, Version 2.0 (the \"License\");\n   you may not use this file except in compliance with the License.\n   You may obtain a copy of the License at\n\n       http://www.apache.org/licenses/LICENSE-2.0\n\n   Unless required by applicable law or agreed to in writing, software\n   distributed under the License is distributed on an \"AS IS\" BASIS,\n   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n   See the License for the specific language governing permissions and\n   limitations under the License.\n*/\n\n#include <stdlib.h>\n#include <stdio.h>\n#include <string.h>\n#include <stdbool.h>\n\n#include \"csvline.h\"\n#include \"csvfield.h\"\n\nsize_t csvline_getFieldCnt(struct csvline* cline) {\n  return cline->currentIdx;\n}\n\nchar* csvline_getField(struct csvline* cline, size_t idx) {\n  if (idx >= cline->currentIdx) {\n    return \"\";\n  }\n  return cline->field[idx]->data;\n}\n\n// try to be efficient\nvoid csvline_reset(struct csvline* ptr) {\n  int i;\n  for (i=0; i<ptr->fieldsize; i++) {\n    if (ptr->field[i] != NULL) {\n      csvfield_reset(ptr->field[i]);\n    }\n  }\n  ptr->currentIdx = 0;\n  ptr->eolStr = \"\\n\";\n}\n\nstruct csvline* csvline_create() {\n  struct csvline* ptr = malloc(sizeof(struct csvline));\n  if (ptr == NULL) {\n    fprintf(stderr, \"error: malloc\\n\");\n    exit(-1);\n  }\n  ptr->field = NULL;\n  ptr->fieldsize = 0;\n  ptr->currentIdx = 0;\n  ptr->eolStr = \"\\n\";\n  return ptr;\n}\n\nvoid csvline_printToFile(struct csvline* ptr, FILE* fp) {\n  fprintf(fp, \"[[\");\n  int i;\n  for (i=0; i<ptr->fieldsize; i++) {\n    fprintf(stderr, \"[%s:%d]\", ptr->field[i]->data, (int) ptr->field[i]->len);\n  }\n  fprintf(fp, \"]\");\n  fprintf(fp, \"fs(%d):\", (int) ptr->fieldsize);\n  fprintf(fp, \"i(%d)\", (int) ptr->currentIdx);\n  fprintf(fp, \"]\\n\");\n}\n\n// copy field\n// do not include \\0 in fieldlen\nvoid csvline_addField(struct csvline* cline, const char* txtfield, int fieldstartidx, int fieldlen) {\n  if (cline->fieldsize <= cline->currentIdx) {\n    //realloc a block for effieciency\n    struct csvfield** tmp = cline->field;\n    cline->field = malloc( (cline->fieldsize + 10)*sizeof(struct csvfield*));\n    if (cline->field == NULL) {\n      fprintf(stderr, \"error: malloc\\n\");\n      exit(-1);\n    }\n    if (tmp != NULL) {\n      memcpy(cline->field, tmp, cline->fieldsize*sizeof(struct csvfield *));\n      free(tmp);\n    }\n    cline->fieldsize += 10;\n    int i;\n    for (i=cline->fieldsize-10; i<cline->fieldsize; i++) {\n      cline->field[i]=csvfield_create();\n    }\n  }\n  csvfield_set(cline->field[cline->currentIdx], txtfield, fieldstartidx, fieldlen);\n  cline->currentIdx++;\n}\n\n// append to the last field in the line\nvoid csvline_appendField(struct csvline* cline, const char* txtfield, int fieldstartidx, int fieldlen) {\n  csvfield_append(cline->field[cline->currentIdx - 1], txtfield, fieldstartidx, fieldlen);\n}\n","numLines":102,"startLine":1,"totalLines":102}}}
