{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Qahkc19uHsbGuWbmjac67L","type":"tool_result","content":"1\t#include \"lzma_packet_encoder.h\"\n2\t#include \"probability_model.h\"\n3\t#include <assert.h>\n4\t\n5\ttypedef struct {\n6\t\tbool match;\n7\t\tbool rep;\n8\t\tbool b3;\n9\t\tbool b4;\n10\t\tbool b5;\n11\t} LZMAPacketHeader;\n12\t\n13\tstatic void lzma_encode_packet_header(LZMAState* lzma_state, EncoderInterface* enc, LZMAPacketHeader* head)\n14\t{\n15\t\tContextStateProbabilityModel* ctx_probs = &lzma_state->probs.ctx_state;\n16\t\n17\t\tunsigned ctx_pos_bits = 0; //todo: position context bits currently unsupported\n18\t\tunsigned ctx_state = lzma_state->ctx_state;\n19\t\tunsigned ctx_pos_state = (ctx_state << NUM_POS_BITS_MAX) + ctx_pos_bits;\n20\t\n21\t\tencode_bit(head->match, &ctx_probs->is_match[ctx_pos_state], enc);\n22\t\tif (!head->match) {\n23\t\t\treturn;\n24\t\t}\n25\t\n26\t\tencode_bit(head->rep, &ctx_probs->is_rep[ctx_state], enc);\n27\t\tif (!head->rep) {\n28\t\t\treturn;\n29\t\t}\n30\t\n31\t\tencode_bit(head->b3, &ctx_probs->is_rep_g0[ctx_state], enc);\n32\t\tif (head->b3) {\n33\t\t\tencode_bit(head->b4, &ctx_probs->is_rep_g1[ctx_state], enc);\n34\t\t\tif (head->b4) {\n35\t\t\t\tencode_bit(head->b5, &ctx_probs->is_rep_g2[ctx_state], enc);\n36\t\t\t}\n37\t\t} else {\n38\t\t\tencode_bit(head->b4, &ctx_probs->is_rep0_long[ctx_pos_state], enc);\n39\t\t}\n40\t}\n41\t\n42\tstatic void lzma_encode_length(LengthProbabilityModel* probs, EncoderInterface* enc, unsigned len)\n43\t{\n44\t\tunsigned ctx_pos_bits = 0; //todo: position context bits currently unsupported\n45\t\tassert(len >= 2);\n46\t\tlen -= 2;\n47\t\n48\t\tif (len < LOW_CODER_SYMBOLS) {\n49\t\t\tencode_bit(0, &probs->choice_1, enc);\n50\t\t\tencode_bit_tree(len, probs->low_coder[ctx_pos_bits], LOW_CODER_BITS, enc);\n51\t\t} else {\n52\t\t\tlen -= LOW_CODER_SYMBOLS;\n53\t\t\tencode_bit(1, &probs->choice_1, enc);\n54\t\t\tif (len < MID_CODER_SYMBOLS) {\n55\t\t\t\tencode_bit(0, &probs->choice_2, enc);\n56\t\t\t\tencode_bit_tree(len, probs->mid_coder[ctx_pos_bits], MID_CODER_BITS, enc);\n57\t\t\t} else {\n58\t\t\t\tlen -= MID_CODER_SYMBOLS;\n59\t\t\t\tencode_bit(1, &probs->choice_2, enc);\n60\t\t\t\tencode_bit_tree(len, probs->high_coder, HIGH_CODER_BITS, enc);\n61\t\t\t}\n62\t\t}\n63\t}\n64\t\n65\t//https://stackoverflow.com/a/42030874\n66\tstatic inline unsigned get_msb32(register unsigned val)\n67\t{\n68\t  return 32 - __builtin_clz(val);\n69\t}\n70\t\n71\tstatic void lzma_encode_distance(LZMAState* lzma_state, EncoderInterface* enc, unsigned dist, unsigned len)\n72\t{\n73\t\tunsigned len_ctx = len - 2;\n74\t\tif (len_ctx >= NUM_LEN_TO_POS_STATES) {\n75\t\t\tlen_ctx = NUM_LEN_TO_POS_STATES - 1;\n76\t\t}\n77\t\n78\t\tDistanceProbabilityModel* probs = &lzma_state->probs.dist;\n79\t\tif (dist < 4) {\n80\t\t\tencode_bit_tree(dist, probs->pos_slot_coder[len_ctx], POS_SLOT_BITS, enc);\n81\t\t\treturn;\n82\t\t}\n83\t\n84\t\tunsigned num_low_bits = get_msb32(dist) - 2;\n85\t\tunsigned low_bits = dist & ((1 << num_low_bits) - 1);\n86\t\tunsigned high_bits = dist >> num_low_bits;\n87\t\tunsigned pos_slot = num_low_bits*2 + high_bits;\n88\t\tencode_bit_tree(pos_slot, probs->pos_slot_coder[len_ctx], POS_SLOT_BITS, enc);\n89\t\n90\t\tif (pos_slot < END_POS_MODEL_INDEX) {\n91\t\t\t//todo: decypher this shit, is pos_coder overlapped or...???\n92\t\t\tunsigned pos_coder_ctx = (high_bits << num_low_bits) - pos_slot;\n93\t\t\tencode_bit_tree_reverse(low_bits, probs->pos_coder + pos_coder_ctx, num_low_bits, enc);\n94\t\t\treturn;\n95\t\t}\n96\t\n97\t\tunsigned num_direct_bits = num_low_bits - ALIGN_BITS;\n98\t\tnum_low_bits = ALIGN_BITS;\n99\t\tunsigned direct_bits = low_bits >> ALIGN_BITS;\n100\t\tlow_bits = low_bits & ((1 << num_low_bits) - 1);\n101\t\n102\t\tencode_direct_bits(direct_bits, num_direct_bits, enc);\n103\t\tencode_bit_tree_reverse(low_bits, probs->align_coder, num_low_bits, enc);\n104\t}\n105\t\n106\tstatic void lzma_encode