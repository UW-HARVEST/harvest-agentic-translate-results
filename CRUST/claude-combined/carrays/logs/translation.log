onst type_t *)aa;                                        \\\n58\t  const type_t b = *(const type_t *)bb;                                        \\\n59\t  return cmp(a, b);                                                            \\\n60\t}                                                                              \\\n61\tstatic inline int fname2(const void *aa, const void *bb, void *p)              \\\n62\t  __attribute__((unused));                                                     \\\n63\tstatic inline int fname2(const void *aa, const void *bb, void *p) {            \\\n64\t  (void)p;                                                                     \\\n65\t  const type_t a = *(const type_t *)aa;                                        \\\n66\t  const type_t b = *(const type_t *)bb;                                        \\\n67\t  return cmp(a, b);                                                            \\\n68\t}\n69\tcmpfunc(gca_cmp_char,    gca_cmp2_char,    char,        gca_cmp);\n70\tcmpfunc(gca_cmp_int,     gca_cmp2_int,     int,         gca_cmp);\n71\tcmpfunc(gca_cmp_long,    gca_cmp2_long,    long,        gca_cmp);\n72\tcmpfunc(gca_cmp_float,   gca_cmp2_float,   float,       gca_cmp);\n73\tcmpfunc(gca_cmp_double,  gca_cmp2_double,  double,      gca_cmp);\n74\tcmpfunc(gca_cmp_int8,    gca_cmp2_int8,    int8_t,      gca_cmp);\n75\tcmpfunc(gca_cmp_int16,   gca_cmp2_int16,   int16_t,     gca_cmp);\n76\tcmpfunc(gca_cmp_int32,   gca_cmp2_int32,   int32_t,     gca_cmp);\n77\tcmpfunc(gca_cmp_int64,   gca_cmp2_int64,   int64_t,     gca_cmp);\n78\tcmpfunc(gca_cmp_uint8,   gca_cmp2_uint8,   uint8_t,     gca_cmp);\n79\tcmpfunc(gca_cmp_uint16,  gca_cmp2_uint16,  uint16_t,    gca_cmp);\n80\tcmpfunc(gca_cmp_uint32,  gca_cmp2_uint32,  uint32_t,    gca_cmp);\n81\tcmpfunc(gca_cmp_uint64,  gca_cmp2_uint64,  uint64_t,    gca_cmp);\n82\tcmpfunc(gca_cmp_size,    gca_cmp2_size,    size_t,      gca_cmp);\n83\tcmpfunc(gca_cmp_ptr,     gca_cmp2_ptr,     void *const, gca_cmp)