{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0124Fr4kHWXseNbZB2XxF8ep","type":"tool_result","content":"1\tuse merkle_tree_c::merkle_tree::*;\n2\t\n3\t/// Converts an i32 value into a CbmtNode (storing the value in little-endian form).\n4\tfn int32_to_node(value: i32) -> CbmtNode {\n5\t    let mut node = CbmtNode {\n6\t        bytes: [0; CBMT_NODE_SIZE],\n7\t    };\n8\t    // Here CBMT_NODE_SIZE is 4 (node_i32 mode)\n9\t    node.bytes\n10\t        .copy_from_slice(&value.to_le_bytes()[..CBMT_NODE_SIZE]);\n11\t    node\n12\t}\n13\t\n14\t/// Extracts an i32 value from a CbmtNode.\n15\tfn node_to_int32(node: &CbmtNode) -> i32 {\n16\t    i32::from_le_bytes(node.bytes)\n17\t}\n18\t\n19\t/// Concrete implementation of the merge function for node_i32 mode.\n20\t/// Computes: merge(left, right) = (right - left) as an i32 stored in a node.\n21\tfn node_merge(_merge_ctx: Option<&mut ()>, left: &CbmtNode, right: &CbmtNode) -> CbmtNode {\n22\t    let left_value = node_to_int32(left);\n23\t    let right_value = node_to_int32(right);\n24\t    let value = right_value.wrapping_sub(left_value);\n25\t    int32_to_node(value)\n26\t}\n27\t\n28\t#[test]\n29\tfn test_build_empty() {\n30\t    let leaves = CbmtLeaves { nodes: vec![] };\n31\t    let mut tree = CbmtTree {\n32\t        nodes: Vec::new(),\n33\t        length: 0,\n34\t        capacity: 0,\n35\t    };\n36\t    let ret = cbmt_build_merkle_tree(&mut tree, &leaves, node_merge);\n37\t    assert_eq!(ret, 0);\n38\t    assert_eq!(node_to_int32(&cbmt_tree_root(&tree)), 0);\n39\t    println!(\"test_build_empty passed.\");\n40\t}\n41\t\n42\t#[test]\n43\tfn test_build_five() {\n44\t    let leaves = CbmtLeaves {\n45\t        nodes: vec![\n46\t            int32_to_node(2),\n47\t            int32_to_node(3),\n48\t            int32_to_node(5),\n49\t            int32_to_node(7),\n50\t            int32_to_node(11),\n51\t        ],\n52\t    };\n53\t    let mut tree = CbmtTree {\n54\t        nodes: Vec::new(),\n55\t        length: 0,\n56\t        capacity: 0,\n57\t    };\n58\t    let ret = cbmt_build_merkle_tree(&mut tree, &leaves, node_merge);\n59\t    assert_eq!(ret, 0);\n60\t    for (i, node) in tree.nodes.iter().enumerate() {\n61\t        println!(\"tree.nodes[{}]: {}\", i, node_to_int32(node));\n62\t    }\n63\t    // Expected values computed from the C algorithm:\n64\t    // tree.nodes[0] = 4, tree.nodes[1] = -2, tree.nodes[2] = 2, tree.nodes[3] = 4,\n65\t    // leaves: tree.nodes[4]=2, [5]=3, [6]=5, [7]=7, [8]=11.\n66\t    assert_eq!(node_to_int32(&tree.nodes[0]), 4);\n67\t    assert_eq!(node_to_int32(&tree.nodes[1]), -2);\n68\t    assert_eq!(node_to_int32(&tree.nodes[2]), 2);\n69\t    assert_eq!(node_to_int32(&tree.nodes[3]), 4);\n70\t    assert_eq!(node_to_int32(&tree.nodes[4]), 2);\n71\t    assert_eq!(node_to_int32(&tree.nodes[5]), 3);\n72\t    assert_eq!(node_to_int32(&tree.nodes[6]), 5);\n73\t    assert_eq!(node_to_int32(&tree.nodes[7]), 7);\n74\t    assert_eq!(node_to_int32(&tree.nodes[8]), 11);\n75\t    println!(\"test_build_five passed.\");\n76\t}\n77\t\n78\t#[test]\n79\tfn test_build_root_directly_2leaves() {\n80\t    let leaves = CbmtLeaves {\n81\t        nodes: vec![int32_to_node(2), int32_to_node(3)],\n82\t    };\n83\t    let root = cbmt_build_merkle_root(&leaves, node_merge).expect(\"Failed to build root\");\n84\t    println!(\"root: {}\", node_to_int32(&root));\n85\t    // For two leaves, merge(2,3) = 3 - 2 = 1.\n86\t    assert_eq!(node_to_int32(&root), 1);\n87\t    println!(\"test_build_root_directly_2leaves passed.\");\n88\t}\n89\t\n90\t#[test]\n91\tfn test_build_root_directly() {\n92\t    let leaves = CbmtLeaves {\n93\t        nodes: vec![\n94\t            int32_to_node(2),\n95\t            int32_to_node(3),\n96\t            int32_to_node(5),\n97\t            int32_to_node(7),\n98\t            int32_to_node(11),\n99\t        ],\n100\t    };\n101\t    let root = cbmt_build_merkle_root(&leaves, node_merge).expect(\"Failed to build root\");\n102\t    printl