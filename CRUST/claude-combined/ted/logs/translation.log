{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01VjxmDALFhXGdUSsjPK9qX9","type":"tool_result","content":"1\t//\n2\t// Created by Anfernee Jervis on 6/29/22.\n3\t//\n4\t\n5\t#include <stdlib.h>\n6\t#include <string.h>\n7\t\n8\t#include \"gap.h\"\n9\t\n10\t\n11\t/*\n12\t * TODO: Consider rewriting this using realloc and memmove.\n13\t * helper function for copying the contents of a GapBuffer.buffer to a new buffer, with/without\n14\t * resizing the gap. This method is useful when moving the 'cursor' or when resizing a filled buffer.\n15\t * instance: GapBuffer instance\n16\t * new_capacity: The new size of the buffer. If <= original capacity, the same capacity will be used.\n17\t *\n18\t * return 0 on success or MEM_ERROR\n19\t * */\n20\tint resizeBuffer(GapBuffer* instance, int new_capacity){\n21\t\n22\t    int buffer_size = instance->str_len + instance->gap_len;\n23\t\n24\t    if (new_capacity < buffer_size){\n25\t        new_capacity = buffer_size;\n26\t    }\n27\t\n28\t    // If we increase the capacity, all the new space should go to the gap.\n29\t    int gap_size = instance->gap_len + (new_capacity - buffer_size);\n30\t\n31\t    // First malloc new buffer\n32\t    char* new_buffer = malloc(sizeof(char) * new_capacity);\n33\t\n34\t    if (new_buffer == NULL){\n35\t        return MEM_ERROR;\n36\t    }\n37\t\n38\t    // first, copy up to the start of the gap\n39\t    memcpy(new_buffer, instance->buffer, sizeof(char) * (instance->gap_loc));\n40\t\n41\t    // Copy the rest of the buffer, starting from the suffix of the gap\n42\t    memcpy(\n43\t            (new_buffer + instance->gap_loc + gap_size),                // [a, a, a, a, _, _, _, starts here>a, a, a, a]\n44\t            (instance->buffer + instance->gap_loc + instance->gap_len), // [a, a, a, a, _, starts here>a, a, a, a]\n45\t            instance->str_len - instance->gap_loc);  //  now we copy the remaining str_len - gap_loc characters\n46\t\n47\t    free(instance->buffer);\n48\t    instance->buffer = new_buffer;\n49\t    instance->gap_len = gap_size;\n50\t\n51\t    return 0;\n52\t}\n53\t\n54\t\n55\tGapBuffer* CreateGapBuffer(int capacity){\n56\t\n57\t    GapBuffer* gap_buffer = malloc(sizeof(GapBuffer));\n58\t\n59\t    if (gap_buffer == NULL){\n60\t        return NULL;\n61\t    }\n62\t\n63\t    gap_buffer->buffer = malloc(sizeof(char) * capacity);\n64\t\n65\t    if (gap_buffer->buffer == NULL){\n66\t        free(gap_buffer);\n67\t        return NULL;\n68\t    }\n69\t\n70\t    gap_buffer->gap_loc = 0;\n71\t    gap_buffer->gap_len = capacity;\n72\t    gap_buffer->str_len = 0;\n73\t\n74\t    return gap_buffer;\n75\t}\n76\t\n77\t\n78\tvoid DestroyGapBuffer(GapBuffer * instance){\n79\t    free(instance->buffer);\n80\t    free(instance);\n81\t}\n82\t\n83\t\n84\tint GapBufferInsertChar(GapBuffer* instance, char ch){\n85\t\n86\t    int errno;\n87\t\n88\t    // If the gap is about to close, resize it.\n89\t    if (instance->gap_len <= 1){\n90\t        int current_cap = instance->gap_len + instance->str_len;\n91\t        if ((errno = resizeBuffer(instance, current_cap * 2)) != 0){\n92\t            return errno;\n93\t        }\n94\t    }\n95\t\n96\t    instance->buffer[instance->gap_loc] = ch;\n97\t    instance->str_len++;\n98\t    instance->gap_loc++;\n99\t    instance->gap_len--;\n100\t\n101\t    return 0;\n102\t}\n103\t\n104\t\n105\tvoid GapBufferBackSpace(GapBuffer* instance){\n106\t\n107\t    if (instance->gap_loc > 0){\n108\t        instance->gap_loc--;\n109\t        instance->gap_len++;\n110\t        instance->str_len--;\n111\t    }\n112\t}\n113\t\n114\t\n115\tint GapBufferMoveGap(GapBuffer* instance, int location){\n116\t    if (location > instance->str_len){\n117\t        location = instance->str_len;\n118\t    }\n119\t\n120\t    if (location < 0){\n121\t        location = 0;\n122\t    }\n123\t\n124\t    int capacity = instance->gap_len + instance->str_len;\n125\t    char* new_buffer = malloc(sizeof(char) * capacity);\n126\t\n127\t    if (new_buffer == NULL){\n128\t        return MEM_ERROR;\n129\t    }\n130\t\n131\t    if (location < instance->gap_loc){\n132\t\n133\t        // here the new location is before the current gap location\n134\t        // copy up to location\n135\t        memcpy(new_buffer, instance->buffer, sizeof(char) * (location));\n136\t\n137\t        // then copy what remains up to instance.gap_loc, to the position after the gap in the new buffer\n138\t        memcpy(new_buffer + location + instance->gap_len,\n139\t               instance->buffer + location,\n140\t               sizeof(char) * (instance->gap_loc-location));\n141\t\n142\t        // copy the rest of the string\n143\t        memcpy((new_buffer + location + instance->gap_len + (instance->gap_loc-location)),\n144\t                (instance->buffer + instance->gap_loc + instance->gap_len),\n145\t               sizeof(char) * instance->str_len - instance->gap_loc);  //  now we copy the remaining str_len - gap_loc characters\n146\t    } else {\n147\t\n148\t        // here the new location is further after the current gap location\n149\t        // copy upto original gap\n150\t        memcpy(new_buffer, instance->buffer, sizeof(char) * (instance->gap_loc));\n151\t\n152\t        // copy what's left before the new location\n153\t        memcpy(new_buffer+instance->gap_loc,\n154\t               instance->buffer + instance->gap_loc + instance->gap_len,\n155\t               sizeof(char) * (location - instance->gap_loc));\n156\t\n157\t        // now copy the remaining string after the gap\n158\t        memcpy(new_buffer + location + instance->gap_len,\n159\t               instance->buffer + instance->gap_loc + instance->gap_len + (location - instance->gap_loc),\n160\t               sizeof(char) * instance->str_len - location);\n161\t    }\n162\t\n163\t    free(instance->buffer);\n164\t    instance->buffer = new_buffer;\n165\t    instance->gap_loc = location;\n166\t    return 0;\n167\t}\n168\t\n169\tchar* GapBufferGetString(GapBuffer* instance){\n170\t    char* buffer = malloc(1 + (sizeof(char) * instance->str_len));\n171\t\n172\t    if (buffer == NULL){\n173\t        return NULL;\n174\t    }\n175\t\n176\t    // Copy before gap\n177\t    memcpy(buffer, instance->buffer, instance->gap_loc);\n178\t\n179\t    // Copy after gap\n180\t    memcpy(buffer + instance->gap_loc,\n181\t           instance->buffer + instance->gap_loc + instance->gap_len,\n182\t           instance->str_len - instance->gap_loc);\n183\t\n184\t    buffer[instance->str_len] = '\\0';\n185\t\n186\t    return buffer;\n187\t}\n188\t\n189\t\n190\t\n191\t#pragma clang diagnostic push\n192\t#pragma ide diagnostic ignored \"DanglingPointer\"  // Ignore because CreateGapBuffer never returns a deallocated pointer.\n193\tGapBuffer* GapBufferSplit(GapBuffer *instance) {\n194\t    // split the current GapBuffer where the gap is.\n195\t    // Create a new GapBuffer and copy the second half of the string to the new GapBuffer\n196\t\n197\t    int capacity = instance->gap_len + instance->str_len;\n198\t    int second_half_of_str_len = instance->str_len - instance->gap_loc;\n199\t\n200\t    GapBuffer* new_gap_buffer = CreateGapBuffer(capacity);\n201\t\n202\t    if (new_gap_buffer == NULL){\n203\t        return NULL;\n204\t    }\n205\t\n206\t    // copy the second half of the string to the new GapBuffer\n207\t    // The string is copied to the location at the end of the gap in the new GapBuffer\n208\t    // |           gap             |second half of string\n209\t    memcpy(new_gap_buffer->buffer + (capacity - second_half_of_str_len),\n210\t           instance->buffer + instance->gap_loc + instance->gap_len,\n211\t           second_half_of_str_len);\n212\t\n213\t    // set str_len, gap_loc and gap_len of the new GapBuffer\n214\t    new_gap_buffer->str_len = second_half_of_str_len;\n215\t    new_gap_buffer->gap_loc = 0;\n216\t    new_gap_buffer->gap_len = capacity - second_half_of_str_len;\n217\t\n218\t\n219\t    // set str_len, gap_len of the old GapBuffer\n220\t    instance->str_len = instance->gap_loc;\n221\t    instance->gap_len = capacity - instance->str_len;\n222\t\n223\t    return new_gap_buffer;\n224\t\n225\t}\n226\t#pragma clang diagnostic pop\n227\t\n228\t\n229\t#pragma clang diagnostic push\n230\t#pragma ide diagnostic ignored \"DanglingPointer\" // Ignore because CreateGapBuffer never returns a deallocated pointer.\n231\tGapBuffer* CreateGapBufferFromString(char* str, int gap_len){\n232\t\n233\t    int s_len = strlen(str);\n234\t    int capacity = s_len + gap_len;\n235\t    GapBuffer* new_buffer;\n236\t\n237\t    if (str == NULL || s_len == 0){\n238\t        return CreateGapBuffer(gap_len);\n239\t\n240\t    } else {\n241\t        new_buffer = CreateGapBuffer(capacity);\n242\t\n243\t        if (new_buffer == NULL){\n244\t            return NULL;\n245\t        }\n246\t\n247\t        // Copy the string to the buffer\n248\t        memcpy(new_buffer->buffer, str, s_len);\n249\t\n250\t        // update gap values\n251\t        new_buffer->str_len = s_len;\n252\t        new_buffer->gap_loc = s_len;\n253\t        new_buffer->gap_len = gap_len;\n254\t\n255\t        return new_buffer;\n256\t    }\n257\t}\n258\t\n259\t#pragma clang diagnostic pop\n260\t\n261\t\n262\tchar GapBufferCharAt(GapBuffer *instance, int i) {\n263\t\n264\t    if ( instance == NULL ||\n265\t         instance->str_len == 0 ||\n266\t         i < 0 || i >= instance->str_len){\n267\t        return '\\0';\n268\t    }\n269\t\n270\t    if (i < instance->gap_loc){\n271\t        return instance->buffer[i];\n272\t    }\n273\t    else {\n274\t        return instance->buffer[i + instance->gap_len];\n275\t    }\n276\t}"}]},"parent_tool_use_id":null,"session_id":"d0fe60e8-4e81-4201-a547-2c1ac9be1d17","uuid":"10c78591-629e-4713-a1a7-a35ff5b38aa0","timestamp":"2026-05-30T09:14:25.116Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-hw4KWy/project/c_src/buffer/gap.c","content":"//\n// Created by Anfernee Jervis on 6/29/22.\n//\n\n#include <stdlib.h>\n#include <string.h>\n\n#include \"gap.h\"\n\n\n/*\n * TODO: Consider rewriting this using realloc and memmove.\n * helper function for copying the contents of a GapBuffer.buffer to a new buffer, with/without\n * resizing the gap. This method is useful when moving the 'cursor' or when resizing a filled buffer.\n * instance: GapBuffer instance\n * new_capacity: The new size of the buffer. If <= original capacity, the same capacity will be used.\n *\n * return 0 on success or MEM_ERROR\n * */\nint resizeBuffer(GapBuffer* instance, int new_capacity){\n\n    int buffer_size = instance->str_len + instance->gap_len;\n\n    if (new_capacity < buffer_size){\n        new_capacity = buffer_size;\n    }\n\n    // If we increase the capacity, all the new space should go to the gap.\n    int gap_size = instance->gap_len + (new_capacity - buffer_size);\n\n    // First malloc new buffer\n    char* new_buffer = malloc(sizeof(char) * new_capacity);\n\n    if (new_buffer == NULL){\n        return MEM_ERROR;\n    }\n\n    // first, copy up to the start of the gap\n    memcpy(new_buffer, instance->buffer, sizeof(char) * (instance->gap_loc));\n\n    // Copy the rest of the buffer, starting from the suffix of the gap\n    memcpy(\n            (new_buffer + instance->gap_loc + gap_size),                // [a, a, a, a, _, _, _, starts here>a, a, a, a]\n            (instance->buffer + instance->gap_loc + instance->gap_len), // [a, a, a, a, _, starts here>a, a, a, a]\n            instance->str_len - instance->gap_loc);  //  now we copy the remaining str_len - gap_loc characters\n\n    free(instance->buffer);\n    instance->buffer = new_buffer;\n    instance->gap_len = gap_size;\n\n    return 0;\n}\n\n\nGapBuffer* CreateGapBuffer(int capacity){\n\n    GapBuffer* gap_buffer = malloc(sizeof(GapBuffer));\n\n    if (gap_buffer == NULL){\n        return NULL;\n    }\n\n    gap_buffer->buffer = malloc(sizeof(char) * capacity);\n\n    if (gap_buffer->buffer == NULL){\n        free(gap_buffer);\n        return NULL;\n    }\n\n    gap_buffer->gap_loc = 0;\n    gap_buffer->gap_len = capacity;\n    gap_buffer->str_len = 0;\n\n    return gap_buffer;\n}\n\n\nvoid DestroyGapBuffer(GapBuffer * instance){\n    free(instance->buffer);\n    free(instance);\n}\n\n\nint GapBufferInsertChar(GapBuffer* instance, char ch){\n\n    int errno;\n\n    // If the gap is about to close, resize it.\n    if (instance->gap_len <= 1){\n        int current_cap = instance->gap_len + instance->str_len;\n        if ((errno = resizeBuffer(instance, current_cap * 2)) != 0){\n            return errno;\n        }\n    }\n\n    instance->buffer[instance->gap_loc] = ch;\n    instance->str_len++;\n    instance->gap_loc++;\n    instance->gap_len--;\n\n    return 0;\n}\n\n\nvoid GapBufferBackSpace(GapBuffer* instance){\n\n    if (instance->gap_loc > 0){\n        instance->gap_loc--;\n        instance->gap_len++;\n        instance->str_len--;\n    }\n}\n\n\nint GapBufferMoveGap(GapBuffer* instance, int location){\n    if (location > instance->str_len){\n        location = instance->str_len;\n    }\n\n    if (location < 0){\n        location = 0;\n    }\n\n    int capacity = instance->gap_len + instance->str_len;\n    char* new_buffer = malloc(sizeof(char) * capacity);\n\n    if (new_buffer == NULL){\n        return MEM_ERROR;\n    }\n\n    if (location < instance->gap_loc){\n\n        // here the new location is before the current gap location\n        // copy up to location\n        memcpy(new_buffer, instance->buffer, sizeof(char) * (location));\n\n        // then copy what remains up to instance.gap_loc, to the position after the gap in the new buffer\n        memcpy(new_buffer + location + instance->gap_len,\n               instance->buffer + location,\n               sizeof(char) * (instance->gap_loc-location));\n\n        // copy the rest of the string\n        memcpy((new_buffer + location + instance->gap_len + (instance->gap_loc-location)),\n                (instance->buffer + instance->gap_loc + instance->gap_len),\n               sizeof(char) * instance->str_len - instance->gap_loc);  //  now we copy the remaining str_len - gap_loc characters\n    } else {\n\n        // here the new location is further after the current gap location\n        // copy upto original gap\n        memcpy(new_buffer, instance->buffer, sizeof(char) * (instance->gap_loc));\n\n        // copy what's left before the new location\n        memcpy(new_buffer+instance->gap_loc,\n               instance->buffer + instance->gap_loc + instance->gap_len,\n               sizeof(char) * (location - instance->gap_loc));\n\n        // now copy the remaining string after the gap\n        memcpy(new_buffer + location + instance->gap_len,\n               instance->buffer + instance->gap_loc + instance->gap_len + (location - instance->gap_loc),\n               sizeof(char) * instance->str_len - location);\n    }\n\n    free(instance->buffer);\n    instance->buffer = new_buffer;\n    instance->gap_loc = location;\n    return 0;\n}\n\nchar* GapBufferGetString(GapBuffer* instance){\n    char* buffer = malloc(1 + (sizeof(char) * instance->str_len));\n\n    if (buffer == NULL){\n        return NULL;\n    }\n\n    // Copy before gap\n    memcpy(buffer, instance->buffer, instance->gap_loc);\n\n    // Copy after gap\n    memcpy(buffer + instance->gap_loc,\n           instance->buffer + instance->gap_loc + instance->gap_len,\n           instance->str_len - instance->gap_loc);\n\n    buffer[instance->str_len] = '\\0';\n\n    return buffer;\n}\n\n\n\n#pragma clang diagnostic push\n#pragma ide diagnostic ignored \"DanglingPointer\"  // Ignore because CreateGapBuffer never returns a deallocated pointer.\nGapBuffer* GapBufferSplit(GapBuffer *instance) {\n    // split the current GapBuffer where the gap is.\n    // Create a new GapBuffer and copy the second half of the string to the new GapBuffer\n\n    int capacity = instance->gap_len + instance->str_len;\n    int second_half_of_str_len = instance->str_len - instance->gap_loc;\n\n    GapBuffer* new_gap_buffer = CreateGapBuffer(capacity);\n\n    if (new_gap_buffer == NULL){\n        return NULL;\n    }\n\n    // copy the second half of the string to the new GapBuffer\n    // The string is copied to the location at the end of the gap in the new GapBuffer\n    // |           gap             |second half of string\n    memcpy(new_gap_buffer->buffer + (capacity - second_half_of_str_len),\n           instance->buffer + instance->gap_loc + instance->gap_len,\n           second_half_of_str_len);\n\n    // set str_len, gap_loc and gap_len of the new GapBuffer\n    new_gap_buffer->str_len = second_half_of_str_len;\n    new_gap_buffer->gap_loc = 0;\n    new_gap_buffer->gap_len = capacity - second_half_of_str_len;\n\n\n    // set str_len, gap_len of the old GapBuffer\n    instance->str_len = instance->gap_loc;\n    instance->gap_len = capacity - instance->str_len;\n\n    return new_gap_buffer;\n\n}\n#pragma clang diagnostic pop\n\n\n#pragma clang diagnostic push\n#pragma ide diagnostic ignored \"DanglingPointer\" // Ignore because CreateGapBuffer never returns a deallocated pointer.\nGapBuffer* CreateGapBufferFromString(char* str, int gap_len){\n\n    int s_len = strlen(str);\n    int capacity = s_len + gap_len;\n    GapBuffer* new_buffer;\n\n    if (str == NULL || s_len == 0){\n        return CreateGapBuffer(gap_len);\n\n    } else {\n        new_buffer = CreateGapBuffer(capacity);\n\n        if (new_buffer == NULL){\n            return NULL;\n        }\n\n        // Copy the string to the buffer\n        memcpy(new_buffer->buffer, str, s_len);\n\n        // update gap values\n        new_buffer->str_len = s_len;\n        new_buffer->gap_loc = s_len;\n        new_buffer->gap_len = gap_len;\n\n        return new_buffer;\n    }\n}\n\n#pragma clang diagnostic pop\n\n\nchar GapBufferCharAt(GapBuffer *instance, int i) {\n\n    if ( instance == NULL ||\n         instance->str_len == 0 ||\n         i < 0 || i >= instance->str_len){\n        return '\\0';\n    }\n\n    if (i < instance->gap_loc){\n        return instance->buffer[i];\n    }\n    else {\n        return instance->buffer[i + instance->gap_len];\n    }\n}","numLines":276,"startLine":1,"totalLines":276}}}
