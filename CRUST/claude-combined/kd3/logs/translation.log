{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017qKk3NNahSn2f1vRUfYCzW","type":"tool_result","content":"1\t/*!\n2\t * \\file kdtree.c\n3\t *\n4\t * \\code\n5\t *      Author: Shawn Chin\n6\t *      Date  : July 2012\n7\t *      Copyright (c) 2012 STFC Rutherford Appleton Laboratory\n8\t * \\endcode\n9\t *\n10\t * \\brief Implementation of a balanced 3D k-d tree to speed up selection\n11\t * of neighbouring points that are within a specific distance.\n12\t *\n13\t * This was not designed as a generic k-d tree solution. The APIs\n14\t * and functionality was written based on the requirements of an\n15\t * existing application.\n16\t *  - Data points are defined in the application as separate double arrays\n17\t *      of equal size (double *x, *y, *z)\n18\t *  - The tree is rebuild frequently as the points move at the end of\n19\t *      each iteration.\n20\t *  - Searches are performed multiple times per iteration to locate points\n21\t *      within a specific radius from the target\n22\t *\n23\t * Since the tree is to be rebuilt and search repeatedly, we reuse memory\n24\t * where possible and avoid multiple allocations by provisioning memory\n25\t * for tree nodes from a contiguous block of memory.\n26\t *\n27\t */\n28\t#include <assert.h> /* assert() */\n29\t#include <float.h>  /* DBL_MAX */\n30\t#include <string.h> /* memcpy() */\n31\t#include \"kdtree.h\"\n32\t\n33\t/* dimensions hard coded to 3. Declare constants for convenience */\n34\tenum DIMENSIONS { DIM_X = 0, DIM_Y, DIM_Z, NDIMS };\n35\t\n36\t/* Routines used for sorting points along different axes\n37\t *\n38\t * We've tried more complicate cmp routines which proceed\n39\t * to compare the other axes in the event that two points\n40\t * have the same value, however tests show that a basic\n41\t * compare results in better overall performance.\n42\t *\n43\t */\n44\t#define CMP(v1,v2) ((v1 > v2) ? 1 : ((v1 < v2) ? -1 : 0))\n45\t\n46\tstatic int cmp_x(const void *a1, const void *a2) {\n47\t  const struct data_point *A1 = (const struct data_point*)a1;\n48\t  const struct data_point *A2 = (const struct data_point*)a2;\n49\t  return CMP(A1->x, A2->x);\n50\t}\n51\t\n52\tstatic int cmp_y(const void *a1, const void *a2) {\n53\t  const struct data_point *A1 = (const struct data_point*)a1;\n54\t  const struct data_point *A2 = (const struct data_point*)a2;\n55\t  return CMP(A1->y, A2->y);\n56\t}\n57\t\n58\tstatic int cmp_z(const void *a1, const void *a2) {\n59\t  const struct data_point *A1 = (const struct data_point*)a1;\n60\t  const struct data_point *A2 = (const struct data_point*)a2;\n61\t  return CMP(A1->z, A2->z);\n62\t}\n63\t\n64\t/* for sorting iterators */\n65\tstatic int cmp_size_t(const void *a1, const void *a2) {\n66\t  const size_t *A1 = (const size_t*)a1;\n67\t  const size_t *A2 = (const size_t*)a2;\n68\t  return CMP(*A1, *A2);\n69\t}\n70\t\n71\t/* datatype for cmp function pointer */\n72\ttypedef int(*cmp_func)(const void *, const void *);\n73\t\n74\t/* static array of cmp functions indexed by dim */\n75\tconst cmp_func func_select[] = { cmp_x, cmp_y, cmp_z };\n76\t\n77\t/* declaration of internal functions */\n78\tinline static struct tree_node* _next_node(kdtree *tree);\n79\tinline static struct tree_node* _get_leaf_node(kdtree *tree, size_t offset);\n80\tinline static struct tree_node* _get_branch_node(kdtree *tree, double split);\n81\tstatic struct tree_node* _build_kdtree(size_t idx_from, size_t idx_to,\n82\t                                       size_t depth, kdtree *tree);\n83\tinline static kdtree_iterator* _iterator_new(void);\n84\tinline static void _iterator_reset(kdtree_iterator *iter);\n85\tinline static void _iterator_push(kdtree_iterator *iter, size_t value);\n86\tinline static void _explore_branch(kdtree *tree,\n87\t                                   struct tree_node *node,\n88\t                                   size_t depth,\n89\t                                   const struct space *search_space,\n90\t                                   const struct space *domain,\n91\t                                   kdtree_iterator *iter);\n92\tstatic void _search_kdtree(kdtree *tree,\n93\t                           struct tree_node *root,\n94\t                           size_t depth,\n95\t                           const struct space *search_space,\n96\t                           const struct space *domain,\n97\t                           kdtree_iterator *iter);\n98\tinline static int _point_in_search_space(const struct data_point *point,\n99\t                                         const struct space *search_space);\n100\tinline static int _completely_enclosed(const struct space *search_space,\n101\t                                       const struct space *domain);\n102\tinline static int _search_area_intersects(const struct space *search_space,\n103\t                                          const struct space *domain);\n104\t#ifndef _DEBUG_MODE\n105\tinline static int _is_leaf_node(const struct tree_node *node);\n106\t#else\n107\t#define _is_leaf_node(node) (node->left == NULL)\n108\t#endif\n109\t\n110\t/* ---------------- Implementation of public APIs --------------------------- */\n111\t\n112\t/* Build a 3D k-d tree based on the points stored in x, y, z arrays (with count\n113\t * specifying the number of points).\n114\t *\n115\t * To optimise for cases where the data points may move and we need to rebuild\n116\t * the tree for said points, we take in a reference to the kdtree object pointer\n117\t * instead of simply returning the address of a new object.\n118\t *\n119\t * This allows the user to specify a NULL pointer when creating an new tree object,\n120\t * or reuse the memory of the previously created object when rebuilding the tree\n121\t * during the next iteration.\n122\t *\n123\t *   kdtree *tree = NULL;\n124\t *   for (...) {\n125\t *       kdtree_build(x, y, z, count, &tree);\n126\t *   }\n127\t *   kdtree_delete(&tree);\n128\t *\n129\t * Note that tree object can only be reused if the count is equal. Mismatching\n130\t * counts will cause the previous object to be deleted and a new one built in\n131\t * its place.\n132\t *\n133\t * To reduce the amount of checks, we do not handle cases where count < 0.\n134\t * Do ensure that we're dealing with at lease two points\n135\t *\n136\t */\n137\tvoid kdtree_build(double *x, double *y, double *z, size_t count, kdtree **tree_ptr) {\n138\t  size_t i;\n139\t  kdtree *tree = *tree_ptr;\n140\t  \n141\t  /* sanity check */\n142\t  assert(count > 1);\n143\t\n144\t  /* Reallocate object if ptr == NULL or if count does not match */\n145\t  if (!tree || tree->count != count) {\n146\t    if (tree) kdtree_delete(&tree); /* delete prev obj */\n147\t    \n148\t    /* allocate new object and update user's reference */\n149\t    tree = malloc(sizeof(kdtree));\n150\t    assert(tree != NULL);\n151\t    *tree_ptr = tree;\n152\t    \n153\t    /* initialise values and memory */\n154\t    tree->count = count;\n155\t    tree->max_nodes = ((count - 1) * 2) + 1;\n156\t    tree->points = malloc(sizeof(struct data_point) * count);\n157\t    tree->node_data = malloc(sizeof(struct tree_node) * tree->max_nodes);\n158\t    assert(tree->points != NULL);\n159\t    assert(tree->node_data != NULL);\n160\t  }\n161\t\n162\t  /* reset control values */\n163\t  tree->next_node = 0;\n164\t\n165\t  /* cache coordinates of each point and map to the idx of the point */\n166\t  for (i = 0; i < count; i++) {\n167\t    tree->points[i].idx = i;\n168\t    tree->points[i].x = x[i];\n169\t    tree->points[i].y = y[i];\n170\t    tree->points[i].z = z[i];\n171\t  }\n172\t\n173\t  /* build tree and store ptr to root node */\n174\t  tree->root = _build_kdtree(0, count - 1, 0, tree);\n175\t\n176\t}\n177\t\n178\t/* search tree for points that fall within the 3d cube defined by\n179\t * x, y, z, apothem where apothem is the distance from the point\n180\t * to each side of the cube.\n181\t */\n182\tvoid kdtree_search(kdtree *tree, kdtree_iterator **iter_ptr,\n183\t                   double x, double y, double z, double apothem) {\n184\t  assert(apothem >= 0.0);\n185\t  kdtree_search_space(tree, iter_ptr, \n186\t                      x - apothem, x + apothem,\n187\t                      y - apothem, y + apothem,\n188\t                      z - apothem, z + apothem);\n189\t}\n190\t\n191\t/* search tree for points that fall within the 3d box defined by\n192\t * x_min, x_max, y_min, y_max, z_min, z_max.\n193\t */\n194\tvoid kdtree_search_space(kdtree *tree, kdtree_iterator **iter_ptr,\n195\t                         double x_min, double x_max,\n196\t                         double y_min, double y_max,\n197\t                         double z_min, double z_max) {\n198\t  kdtree_iterator *iter = *iter_ptr;\n199\t  struct space search_space;\n200\t  struct space domain;\n201\t\n202\t  /* sanity checks */\n203\t  assert(tree != NULL);\n204\t  \n205\t  /* The tree should have at least one point */\n206\t  assert(tree->root != NULL);\n207\t  assert(!_is_leaf_node(tree->root));\n208\t\n209\t  /* Either create a new iterator or reset an exisiting one */\n210\t  if (iter != NULL) _iterator_reset(iter);\n211\t  else {\n212\t    iter = _iterator_new();\n213\t    *iter_ptr = iter; /* write back new ptr to obj */\n214\t  }\n215\t\n216\t  /* define the search space */\n217\t  search_space.dim[DIM_X].min = x_min;\n218\t  search_space.dim[DIM_X].max = x_max;\n219\t  search_space.dim[DIM_Y].min = y_min;\n220\t  search_space.dim[DIM_Y].max = y_max;\n221\t  search_space.dim[DIM_Z].min = z_min;\n222\t  search_space.dim[DIM_Z].max = z_max;\n223\t\n224\t  /* set initial domain to infinite space */\n225\t  domain.dim[DIM_X].min = -DBL_MAX;\n226\t  domain.dim[DIM_X].max =  DBL_MAX;\n227\t  domain.dim[DIM_Y].min = -DBL_MAX;\n228\t  domain.dim[DIM_Y].max =  DBL_MAX;\n229\t  domain.dim[DIM_Z].min = -DBL_MAX;\n230\t  domain.dim[DIM_Z].max =  DBL_MAX;\n231\t\n232\t  /* search tree */\n233\t  _search_kdtree(tree, tree->root, 0, &search_space, &domain, iter);\n234\t}\n235\t\n236\t/* Deallocates a tree object referenced by tree_ptr and sets the ptr to NULL */\n237\tvoid kdtree_delete(kdtree **tree_ptr) {\n238\t  kdtree *tree = *tree_ptr;\n239\t  if (tree == NULL) return;\n240\t  \n241\t  free(tree->points);\n242\t  free(tree->node_data);\n243\t  free(tree);\n244\t  *tree_ptr = NULL;\n245\t}\n246\t\n247\t/* returns the next entry in the iteration, or KDTREE_END if the\n248\t * end is reached */\n249\tsize_t kdtree_iterator_get_next(kdtree_iterator *iter) {\n250\t  if (iter->current == iter->size) return KDTREE_END;\n251\t  return iter->data[iter->current++];\n252\t}\n253\t\n254\t/* rewind the iterator */\n255\tvoid kdtree_iterator_rewind(kdtree_iterator *iter) {\n256\t  assert(iter != NULL);\n257\t  iter->current = 0;\n258\t}\n259\t\n260\t/* deallocate memory associated with an iterator */\n261\tvoid kdtree_iterator_delete(kdtree_iterator **iter_ptr) {\n262\t  kdtree_iterator *iter = *iter_ptr;\n263\t  if (iter == NULL) return;\n264\t  \n265\t  free(iter->data);\n266\t  free(iter);\n267\t  *iter_ptr = NULL;\n268\t}\n269\t\n270\t/* sort entries within the iterator */\n271\tvoid kdtree_iterator_sort(kdtree_iterator *iter) {\n272\t  qsort(iter->data, iter->size, sizeof(size_t), cmp_size_t);\n273\t}\n274\t\n275\t/* --------------- INTERNAL ROUTINES ------------------------------- */\n276\t\n277\t\n278\t/* get pointer to the next available node within the node data cache */\n279\tinline static struct tree_node* _next_node(kdtree *tree) {\n280\t  assert(tree->next_node < tree->max_nodes);\n281\t  return &tree->node_data[tree->next_node++];\n282\t}\n283\t\n284\t/* return a branch node */\n285\tinline static struct tree_node* _get_branch_node(kdtree *tree, double split) {\n286\t  struct tree_node *node = _next_node(tree);\n287\t  node->split = split;\n288\t  return node;\n289\t}\n290\t\n291\t/* return a leaf node. Holds the index of the actual data point */\n292\tinline static struct tree_node* _get_leaf_node(kdtree *tree, size_t offset) {\n293\t  struct tree_node *node = _next_node(tree);\n294\t  node->left = NULL;\n295\t  node->right = NULL;\n296\t  node->idx = offset;\n297\t  return node;\n298\t}\n299\t\n300\t#ifndef _DEBUG_MODE\n301\t/* determine if a node is a leaf node */\n302\tinline static int _is_leaf_node(const struct tree_node *node) {\n303\t  return ((node->left == NULL) && (node->right == NULL));\n304\t}\n305\t#endif\n306\t\n307\t/* returns true if point is within search space */\n308\tinline static int _point_in_search_space(const struct data_point *point,\n309\t                                         const struct space *search_space) {\n310\t  return ((point->x <= search_space->dim[DIM_X].max) &&\n311\t          (point->x >= search_space->dim[DIM_X].min) &&\n312\t\n313\t          (point->y <= search_space->dim[DIM_Y].max) &&\n314\t          (point->y >= search_space->dim[DIM_Y].min) &&\n315\t          \n316\t          (point->z <= search_space->dim[DIM_Z].max) &&\n317\t          (point->z >= search_space->dim[DIM_Z].min));\n318\t}\n319\t\n320\t/* returns true if domain is completely enclosed within search space */\n321\tinline static int _completely_enclosed(const struct space *search_space,\n322\t                                       const struct space *domain) {\n323\t  return ((domain->dim[DIM_X].min <= search_space->dim[DIM_X].max) &&\n324\t          (domain->dim[DIM_X].min >= search_space->dim[DIM_X].min) &&\n325\t          (domain->dim[DIM_X].max <= search_space->dim[DIM_X].max) &&\n326\t          (domain->dim[DIM_X].max >= search_space->dim[DIM_X].min) &&\n327\t          \n328\t          (domain->dim[DIM_Y].min <= search_space->dim[DIM_Y].max) &&\n329\t          (domain->dim[DIM_Y].min >= search_space->dim[DIM_Y].min) &&\n330\t          (domain->dim[DIM_Y].max <= search_space->dim[DIM_Y].max) &&\n331\t          (domain->dim[DIM_Y].max >= search_space->dim[DIM_Y].min) &&\n332\t          \n333\t          (domain->dim[DIM_Z].min <= search_space->dim[DIM_Z].max) &&\n334\t          (domain->dim[DIM_Z].min >= search_space->dim[DIM_Z].min) &&\n335\t          (domain->dim[DIM_Z].max <= search_space->dim[DIM_Z].max) &&\n336\t          (domain->dim[DIM_Z].max >= search_space->dim[DIM_Z].min));\n337\t}\n338\t\n339\t\n340\t/* returns true if search space and domain\n341\t *\n342\t * It is easier to determine if two cubes are completely separate, so\n343\t * we do just that and negate the return value.\n344\t */\n345\tinline static int _search_area_intersects(const struct space *search_space,\n346\t                                          const struct space *domain) {\n347\t  return !((search_space->dim[DIM_X].min > domain->dim[DIM_X].max) ||\n348\t           (search_space->dim[DIM_X].max < domain->dim[DIM_X].min) ||\n349\t          \n350\t           (search_space->dim[DIM_Y].min > domain->dim[DIM_Y].max) ||\n351\t           (search_space->dim[DIM_Y].max < domain->dim[DIM_Y].min) ||\n352\t          \n353\t           (search_space->dim[DIM_Z].min > domain->dim[DIM_Z].max) ||\n354\t           (search_space->dim[DIM_Z].max < domain->dim[DIM_Z].min));\n355\t}\n356\t\n357\t/* add all leaf nodes under a branch to the iterator */\n358\tstatic void _report_all_leaves(const kdtree *tree,\n359\t                               const struct tree_node *node,\n360\t                               kdtree_iterator *iter) {\n361\t  if (_is_leaf_node(node)) {\n362\t    _iterator_push(iter, tree->points[node->idx].idx);\n363\t  } else {\n364\t    _report_all_leaves(tree, node->left, iter);\n365\t    _report_all_leaves(tree, node->right, iter);\n366\t  }\n367\t}\n368\t\n369\t/* convenience function to explore a sub-domain */\n370\tinline static void _explore_branch(kdtree *tree,\n371\t                                   struct tree_node *node,\n372\t                                   size_t depth,\n373\t                                   const struct space *search_space,\n374\t                                   const struct space *domain,\n375\t                                   kdtree_iterator *iter) {\n376\t  if (_is_leaf_node(node)) {\n377\t    if (_point_in_search_space(tree->points + node->idx, search_space)) {\n378\t    _iterator_push(iter, tree->points[node->idx].idx);\n379\t    }\n380\t  } else if (_search_area_intersects(search_space, domain)) {\n381\t    if (_completely_enclosed(search_space, domain)) {\n382\t      _report_all_leaves(tree, node, iter);\n383\t    } else {\n384\t      _search_kdtree(tree, node, depth + 1, search_space, domain, iter);\n385\t    }\n386\t  }\n387\t}\n388\t\n389\t/* Recursively search the tree for points within a search space.\n390\t * Results are appended to the iterator object.\n391\t */\n392\tstatic void _search_kdtree(kdtree *tree,\n393\t                           struct tree_node *root,\n394\t                           size_t depth,\n395\t                           const struct space *search_space,\n396\t                           const struct space *domain,\n397\t                           kdtree_iterator *iter) {\n398\t  const size_t axis = depth % NDIMS;\n399\t  struct space new_domain;\n400\t  \n401\t  /* initialise boundaries for new domain */\n402\t  memcpy(&new_domain, domain, sizeof(struct space));\n403\t  \n404\t  /* explore left branch */\n405\t  new_domain.dim[axis].max = root->split;\n406\t  _explore_branch(tree, root->left, depth, search_space, &new_domain, iter);\n407\t  \n408\t  /* explore right branch */\n409\t  new_domain.dim[axis].max = domain->dim[axis].max; /* reset */\n410\t  new_domain.dim[axis].min = root->split;\n411\t  _explore_branch(tree, root->right, depth, search_space, &new_domain, iter);\n412\t}\n413\t\n414\t/* internal routine to recursively build the kdtree */\n415\tstatic struct tree_node* _build_kdtree(size_t idx_from, size_t idx_to,\n416\t                                       size_t depth, kdtree *tree) {\n417\t  double split;\n418\t  struct tree_node *node;\n419\t  struct data_point *point;\n420\t  const size_t count = idx_to - idx_from + 1;\n421\t  const size_t mid   = idx_from + ((idx_to - idx_from) / 2);\n422\t  const size_t axis  = depth % NDIMS;\n423\t\n424\t  /* if there is only one point, return a leaf node */\n425\t  if (count == 1) return _get_leaf_node(tree, idx_from);\n426\t  \n427\t  /* sort the points within this group to determine the median point\n428\t   * - This can be a potential performance bottleneck. There are methods\n429\t   *   to determine median in linear time, but that can get rather\n430\t   *   complicated. Will consider if this proves to be an issue.\n431\t  */\n432\t  qsort((void*)(tree->points + idx_from), count,\n433\t         sizeof(struct data_point), func_select[axis]);\n434\t  \n435\t  /* determine point where axis will be split */\n436\t  point = &tree->points[mid];\n437\t  split = (axis == 0) ? point->x : ((axis == 1) ? point->y : point->z);\n438\t  \n439\t  /* recursively build a tree for the left and right planes */\n440\t  node = _get_branch_node(tree, split);\n441\t  node->left  = _build_kdtree(idx_from, mid, depth + 1, tree);\n442\t  node->right = _build_kdtree(mid + 1, idx_to, depth + 1, tree);\n443\t  \n444\t  return node;\n445\t}\n446\t\n447\t/* allocate and initialise a new iterator object */\n448\tinline static kdtree_iterator* _iterator_new(void) {\n449\t  kdtree_iterator *iter = malloc(sizeof(kdtree_iterator));\n450\t  assert(iter != NULL);\n451\t  \n452\t  iter->current = 0;\n453\t  iter->size = 0;\n454\t  iter->capacity = KDTREE_ITERATOR_INITIAL_SIZE;\n455\t  iter->data = malloc(sizeof(size_t) * iter->capacity);\n456\t  assert(iter->data != NULL);\n457\t  \n458\t  return iter;\n459\t}\n460\t\n461\t/* resets and iterator so its memory can be reused */\n462\tinline static void _iterator_reset(kdtree_iterator *iter) {\n463\t  assert(iter != NULL);\n464\t  iter->size = 0;\n465\t  iter->current = 0;\n466\t}\n467\t\n468\t/* add a new value into the iterator. Resize memory if full */\n469\tinline static void _iterator_push(kdtree_iterator *iter, size_t value) {\n470\t  if (iter->size == iter->capacity) { /* full. need to grow capacity */\n471\t    assert(KDTREE_ITERATOR_GROWTH_RATIO > 1.0);\n472\t    iter->capacity *= KDTREE_ITERATOR_GROWTH_RATIO;\n473\t    iter->data = realloc(iter->data, sizeof(size_t) * iter->capacity);\n474\t  }\n475\t  iter->data[iter->size++] = value;\n476\t}\n477\t"}]},"parent_tool_use_id":null,"session_id":"069b0949-ce03-4e71-ab4f-4a1e4fa10ebf","uuid":"62b171cf-9449-4874-a959-2bcd6a18dd25","timestamp":"2026-05-30T07:59:25.829Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-iTBQTy/project/c_src/kd3/kdtree.c","content":"/*!\n * \\file kdtree.c\n *\n * \\code\n *      Author: Shawn Chin\n *      Date  : July 2012\n *      Copyright (c) 2012 STFC Rutherford Appleton Laboratory\n * \\endcode\n *\n * \\brief Implementation of a balanced 3D k-d tree to speed up selection\n * of neighbouring points that are within a specific distance.\n *\n * This was not designed as a generic k-d tree solution. The APIs\n * and functionality was written based on the requirements of an\n * existing application.\n *  - Data points are defined in the application as separate double arrays\n *      of equal size (double *x, *y, *z)\n *  - The tree is rebuild frequently as the points move at the end of\n *      each iteration.\n *  - Searches are performed multiple times per iteration to locate points\n *      within a specific radius from the target\n *\n * Since the tree is to be rebuilt and search repeatedly, we reuse memory\n * where possible and avoid multiple allocations by provisioning memory\n * for tree nodes from a contiguous block of memory.\n *\n */\n#include <assert.h> /* assert() */\n#include <float.h>  /* DBL_MAX */\n#include <string.h> /* memcpy() */\n#include \"kdtree.h\"\n\n/* dimensions hard coded to 3. Declare constants for convenience */\nenum DIMENSIONS { DIM_X = 0, DIM_Y, DIM_Z, NDIMS };\n\n/* Routines used for sorting points along different axes\n *\n * We've tried more complicate cmp routines which proceed\n * to compare the other axes in the event that two points\n * have the same value, however tests show that a basic\n * compare results in better overall performance.\n *\n */\n#define CMP(v1,v2) ((v1 > v2) ? 1 : ((v1 < v2) ? -1 : 0))\n\nstatic int cmp_x(const void *a1, const void *a2) {\n  const struct data_point *A1 = (const struct data_point*)a1;\n  const struct data_point *A2 = (const struct data_point*)a2;\n  return CMP(A1->x, A2->x);\n}\n\nstatic int cmp_y(const void *a1, const void *a2) {\n  const struct data_point *A1 = (const struct data_point*)a1;\n  const struct data_point *A2 = (const struct data_point*)a2;\n  return CMP(A1->y, A2->y);\n}\n\nstatic int cmp_z(const void *a1, const void *a2) {\n  const struct data_point *A1 = (const struct data_point*)a1;\n  const struct data_point *A2 = (const struct data_point*)a2;\n  return CMP(A1->z, A2->z);\n}\n\n/* for sorting iterators */\nstatic int cmp_size_t(const void *a1, const void *a2) {\n  const size_t *A1 = (const size_t*)a1;\n  const size_t *A2 = (const size_t*)a2;\n  return CMP(*A1, *A2);\n}\n\n/* datatype for cmp function pointer */\ntypedef int(*cmp_func)(const void *, const void *);\n\n/* static array of cmp functions indexed by dim */\nconst cmp_func func_select[] = { cmp_x, cmp_y, cmp_z };\n\n/* declaration of internal functions */\ninline static struct tree_node* _next_node(kdtree *tree);\ninline static struct tree_node* _get_leaf_node(kdtree *tree, size_t offset);\ninline static struct tree_node* _get_branch_node(kdtree *tree, double split);\nstatic struct tree_node* _build_kdtree(size_t idx_from, size_t idx_to,\n                                       size_t depth, kdtree *tree);\ninline static kdtree_iterator* _iterator_new(void);\ninline static void _iterator_reset(kdtree_iterator *iter);\ninline static void _iterator_push(kdtree_iterator *iter, size_t value);\ninline static void _explore_branch(kdtree *tree,\n                                   struct tree_node *node,\n                                   size_t depth,\n                                   const struct space *search_space,\n                                   const struct space *domain,\n                                   kdtree_iterator *iter);\nstatic void _search_kdtree(kdtree *tree,\n                           struct tree_node *root,\n                           size_t depth,\n                           const struct space *search_space,\n                           const struct space *domain,\n                           kdtree_iterator *iter);\ninline static int _point_in_search_space(const struct data_point *point,\n                                         const struct space *search_space);\ninline static int _completely_enclosed(const struct space *search_space,\n                                       const struct space *domain);\ninline static int _search_area_intersects(const struct space *search_space,\n                                          const struct space *domain);\n#ifndef _DEBUG_MODE\ninline static int _is_leaf_node(const struct tree_node *node);\n#else\n#define _is_leaf_node(node) (node->left == NULL)\n#endif\n\n/* ---------------- Implementation of public APIs --------------------------- */\n\n/* Build a 3D k-d tree based on the points stored in x, y, z arrays (with count\n * specifying the number of points).\n *\n * To optimise for cases where the data points may move and we need to rebuild\n * the tree for said points, we take in a reference to the kdtree object pointer\n * instead of simply returning the address of a new object.\n *\n * This allows the user to specify a NULL pointer when creating an new tree object,\n * or reuse the memory of the previously created object when rebuilding the tree\n * during the next iteration.\n *\n *   kdtree *tree = NULL;\n *   for (...) {\n *       kdtree_build(x, y, z, count, &tree);\n *   }\n *   kdtree_delete(&tree);\n *\n * Note that tree object can only be reused if the count is equal. Mismatching\n * counts will cause the previous object to be deleted and a new one built in\n * its place.\n *\n * To reduce the amount of checks, we do not handle cases where count < 0.\n * Do ensure that we're dealing with at lease two points\n *\n */\nvoid kdtree_build(double *x, double *y, double *z, size_t count, kdtree **tree_ptr) {\n  size_t i;\n  kdtree *tree = *tree_ptr;\n  \n  /* sanity check */\n  assert(count > 1);\n\n  /* Reallocate object if ptr == NULL or if count does not match */\n  if (!tree || tree->count != count) {\n    if (tree) kdtree_delete(&tree); /* delete prev obj */\n    \n    /* allocate new object and update user's reference */\n    tree = malloc(sizeof(kdtree));\n    assert(tree != NULL);\n    *tree_ptr = tree;\n    \n    /* initialise values and memory */\n    tree->count = count;\n    tree->max_nodes = ((count - 1) * 2) + 1;\n    tree->points = malloc(sizeof(struct data_point) * count);\n    tree->node_data = malloc(sizeof(struct tree_node) * tree->max_nodes);\n    assert(tree->points != NULL);\n    assert(tree->node_data != NULL);\n  }\n\n  /* reset control values */\n  tree->next_node = 0;\n\n  /* cache coordinates of each point and map to the idx of the point */\n  for (i = 0; i < count; i++) {\n    tree->points[i].idx = i;\n    tree->points[i].x = x[i];\n    tree->points[i].y = y[i];\n    tree->points[i].z = z[i];\n  }\n\n  /* build tree and store ptr to root node */\n  tree->root = _build_kdtree(0, count - 1, 0, tree);\n\n}\n\n/* search tree for points that fall within the 3d cube defined by\n * x, y, z, apothem where apothem is the distance from the point\n * to each side of the cube.\n */\nvoid kdtree_search(kdtree *tree, kdtree_iterator **iter_ptr,\n                   double x, double y, double z, double apothem) {\n  assert(apothem >= 0.0);\n  kdtree_search_space(tree, iter_ptr, \n                      x - apothem, x + apothem,\n                      y - apothem, y + apothem,\n                      z - apothem, z + apothem);\n}\n\n/* search tree for points that fall within the 3d box defined by\n * x_min, x_max, y_min, y_max, z_min, z_max.\n */\nvoid kdtree_search_space(kdtree *tree, kdtree_iterator **iter_ptr,\n                         double x_min, double x_max,\n                         double y_min, double y_max,\n                         double z_min, double z_max) {\n  kdtree_iterator *iter = *iter_ptr;\n  struct space search_space;\n  struct space domain;\n\n  /* sanity checks */\n  assert(tree != NULL);\n  \n  /* The tree should have at least one point */\n  assert(tree->root != NULL);\n  assert(!_is_leaf_node(tree->root));\n\n  /* Either create a new iterator or reset an exisiting one */\n  if (iter != NULL) _iterator_reset(iter);\n  else {\n    iter = _iterator_new();\n    *iter_ptr = iter; /* write back new ptr to obj */\n  }\n\n  /* define the search space */\n  search_space.dim[DIM_X].min = x_min;\n  search_space.dim[DIM_X].max = x_max;\n  search_space.dim[DIM_Y].min = y_min;\n  search_space.dim[DIM_Y].max = y_max;\n  search_space.dim[DIM_Z].min = z_min;\n  search_space.dim[DIM_Z].max = z_max;\n\n  /* set initial domain to infinite space */\n  domain.dim[DIM_X].min = -DBL_MAX;\n  domain.dim[DIM_X].max =  DBL_MAX;\n  domain.dim[DIM_Y].min = -DBL_MAX;\n  domain.dim[DIM_Y].max =  DBL_MAX;\n  domain.dim[DIM_Z].min = -DBL_MAX;\n  domain.dim[DIM_Z].max =  DBL_MAX;\n\n  /* search tree */\n  _search_kdtree(tree, tree->root, 0, &search_space, &domain, iter);\n}\n\n/* Deallocates a tree object referenced by tree_ptr and sets the ptr to NULL */\nvoid kdtree_delete(kdtree **tree_ptr) {\n  kdtree *tree = *tree_ptr;\n  if (tree == NULL) return;\n  \n  free(tree->points);\n  free(tree->node_data);\n  free(tree);\n  *tree_ptr = NULL;\n}\n\n/* returns the next entry in the iteration, or KDTREE_END if the\n * end is reached */\nsize_t kdtree_iterator_get_next(kdtree_iterator *iter) {\n  if (iter->current == iter->size) return KDTREE_END;\n  return iter->data[iter->current++];\n}\n\n/* rewind the iterator */\nvoid kdtree_iterator_rewind(kdtree_iterator *iter) {\n  assert(iter != NULL);\n  iter->current = 0;\n}\n\n/* deallocate memory associated with an iterator */\nvoid kdtree_iterator_delete(kdtree_iterator **iter_ptr) {\n  kdtree_iterator *iter = *iter_ptr;\n  if (iter == NULL) return;\n  \n  free(iter->data);\n  free(iter);\n  *iter_ptr = NULL;\n}\n\n/* sort entries within the iterator */\nvoid kdtree_iterator_sort(kdtree_iterator *iter) {\n  qsort(iter->data, iter->size, sizeof(size_t), cmp_size_t);\n}\n\n/* --------------- INTERNAL ROUTINES ------------------------------- */\n\n\n/* get pointer to the next available node within the node data cache */\ninline static struct tree_node* _next_node(kdtree *tree) {\n  assert(tree->next_node < tree->max_nodes);\n  return &tree->node_data[tree->next_node++];\n}\n\n/* return a branch node */\ninline static struct tree_node* _get_branch_node(kdtree *tree, double split) {\n  struct tree_node *node = _next_node(tree);\n  node->split = split;\n  return node;\n}\n\n/* return a leaf node. Holds the index of the actual data point */\ninline static struct tree_node* _get_leaf_node(kdtree *tree, size_t offset) {\n  struct tree_node *node = _next_node(tree);\n  node->left = NULL;\n  node->right = NULL;\n  node->idx = offset;\n  return node;\n}\n\n#ifndef _DEBUG_MODE\n/* determine if a node is a leaf node */\ninline static int _is_leaf_node(const struct tree_node *node) {\n  return ((node->left == NULL) && (node->right == NULL));\n}\n#endif\n\n/* returns true if point is within search space */\ninline static int _point_in_search_space(const struct data_point *point,\n                                         const struct space *search_space) {\n  return ((point->x <= search_space->dim[DIM_X].max) &&\n          (point->x >= search_space->dim[DIM_X].min) &&\n\n          (point->y <= search_space->dim[DIM_Y].max) &&\n          (point->y >= search_space->dim[DIM_Y].min) &&\n          \n          (point->z <= search_space->dim[DIM_Z].max) &&\n          (point->z >= search_space->dim[DIM_Z].min));\n}\n\n/* returns true if domain is completely enclosed within search space */\ninline static int _completely_enclosed(const struct space *search_space,\n                                       const struct space *domain) {\n  return ((domain->dim[DIM_X].min <= search_space->dim[DIM_X].max) &&\n          (domain->dim[DIM_X].min >= search_space->dim[DIM_X].min) &&\n          (domain->dim[DIM_X].max <= search_space->dim[DIM_X].max) &&\n          (domain->dim[DIM_X].max >= search_space->dim[DIM_X].min) &&\n          \n          (domain->dim[DIM_Y].min <= search_space->dim[DIM_Y].max) &&\n          (domain->dim[DIM_Y].min >= search_space->dim[DIM_Y].min) &&\n          (domain->dim[DIM_Y].max <= search_space->dim[DIM_Y].max) &&\n          (domain->dim[DIM_Y].max >= search_space->dim[DIM_Y].min) &&\n          \n          (domain->dim[DIM_Z].min <= search_space->dim[DIM_Z].max) &&\n          (domain->dim[DIM_Z].min >= search_space->dim[DIM_Z].min) &&\n          (domain->dim[DIM_Z].max <= search_space->dim[DIM_Z].max) &&\n          (domain->dim[DIM_Z].max >= search_space->dim[DIM_Z].min));\n}\n\n\n/* returns true if search space and domain\n *\n * It is easier to determine if two cubes are completely separate, so\n * we do just that and negate the return value.\n */\ninline static int _search_area_intersects(const struct space *search_space,\n                                          const struct space *domain) {\n  return !((search_space->dim[DIM_X].min > domain->dim[DIM_X].max) ||\n           (search_space->dim[DIM_X].max < domain->dim[DIM_X].min) ||\n          \n           (search_space->dim[DIM_Y].min > domain->dim[DIM_Y].max) ||\n           (search_space->dim[DIM_Y].max < domain->dim[DIM_Y].min) ||\n          \n           (search_space->dim[DIM_Z].min > domain->dim[DIM_Z].max) ||\n           (search_space->dim[DIM_Z].max < domain->dim[DIM_Z].min));\n}\n\n/* add all leaf nodes under a branch to the iterator */\nstatic void _report_all_leaves(const kdtree *tree,\n                               const struct tree_node *node,\n                               kdtree_iterator *iter) {\n  if (_is_leaf_node(node)) {\n    _iterator_push(iter, tree->points[node->idx].idx);\n  } else {\n    _report_all_leaves(tree, node->left, iter);\n    _report_all_leaves(tree, node->right, iter);\n  }\n}\n\n/* convenience function to explore a sub-domain */\ninline static void _explore_branch(kdtree *tree,\n                                   struct tree_node *node,\n                                   size_t depth,\n                                   const struct space *search_space,\n                                   const struct space *domain,\n                                   kdtree_iterator *iter) {\n  if (_is_leaf_node(node)) {\n    if (_point_in_search_space(tree->points + node->idx, search_space)) {\n    _iterator_push(iter, tree->points[node->idx].idx);\n    }\n  } else if (_search_area_intersects(search_space, domain)) {\n    if (_completely_enclosed(search_space, domain)) {\n      _report_all_leaves(tree, node, iter);\n    } else {\n      _search_kdtree(tree, node, depth + 1, search_space, domain, iter);\n    }\n  }\n}\n\n/* Recursively search the tree for points within a search space.\n * Results are appended to the iterator object.\n */\nstatic void _search_kdtree(kdtree *tree,\n                           struct tree_node *root,\n                           size_t depth,\n                           const struct space *search_space,\n                           const struct space *domain,\n                           kdtree_iterator *iter) {\n  const size_t axis = depth % NDIMS;\n  struct space new_domain;\n  \n  /* initialise boundaries for new domain */\n  memcpy(&new_domain, domain, sizeof(struct space));\n  \n  /* explore left branch */\n  new_domain.dim[axis].max = root->split;\n  _explore_branch(tree, root->left, depth, search_space, &new_domain, iter);\n  \n  /* explore right branch */\n  new_domain.dim[axis].max = domain->dim[axis].max; /* reset */\n  new_domain.dim[axis].min = root->split;\n  _explore_branch(tree, root->right, depth, search_space, &new_domain, iter);\n}\n\n/* internal routine to recursively build the kdtree */\nstatic struct tree_node* _build_kdtree(size_t idx_from, size_t idx_to,\n                                       size_t depth, kdtree *tree) {\n  double split;\n  struct tree_node *node;\n  struct data_point *point;\n  const size_t count = idx_to - idx_from + 1;\n  const size_t mid   = idx_from + ((idx_to - idx_from) / 2);\n  const size_t axis  = depth % NDIMS;\n\n  /* if there is only one point, return a leaf node */\n  if (count == 1) return _get_leaf_node(tree, idx_from);\n  \n  /* sort the points within this group to determine the median point\n   * - This can be a potential performance bottleneck. There are methods\n   *   to determine median in linear time, but that can get rather\n   *   complicated. Will consider if this proves to be an issue.\n  */\n  qsort((void*)(tree->points + idx_from), count,\n         sizeof(struct data_point), func_select[axis]);\n  \n  /* determine point where axis will be split */\n  point = &tree->points[mid];\n  split = (axis == 0) ? point->x : ((axis == 1) ? point->y : point->z);\n  \n  /* recursively build a tree for the left and right planes */\n  node = _get_branch_node(tree, split);\n  node->left  = _build_kdtree(idx_from, mid, depth + 1, tree);\n  node->right = _build_kdtree(mid + 1, idx_to, depth + 1, tree);\n  \n  return node;\n}\n\n/* allocate and initialise a new iterator object */\ninline static kdtree_iterator* _iterator_new(void) {\n  kdtree_iterator *iter = malloc(sizeof(kdtree_iterator));\n  assert(iter != NULL);\n  \n  iter->current = 0;\n  iter->size = 0;\n  iter->capacity = KDTREE_ITERATOR_INITIAL_SIZE;\n  iter->data = malloc(sizeof(size_t) * iter->capacity);\n  assert(iter->data != NULL);\n  \n  return iter;\n}\n\n/* resets and iterator so its memory can be reused */\ninline static void _iterator_reset(kdtree_iterator *iter) {\n  assert(iter != NULL);\n  iter->size = 0;\n  iter->current = 0;\n}\n\n/* add a new value into the iterator. Resize memory if full */\ninline static void _iterator_push(kdtree_iterator *iter, size_t value) {\n  if (iter->size == iter->capacity) { /* full. need to grow capacity */\n    assert(KDTREE_ITERATOR_GROWTH_RATIO > 1.0);\n    iter->capacity *= KDTREE_ITERATOR_GROWTH_RATIO;\n    iter->data = realloc(iter->data, sizeof(size_t) * iter->capacity);\n  }\n  iter->data[iter->size++] = value;\n}\n","numLines":477,"startLine":1,"totalLines":477}}}
