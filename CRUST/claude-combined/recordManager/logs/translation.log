eof(int));\n57\t\n58\t    int arraySize = numPages * sizeof(int);\n59\t    bool boolArraySize = numPages * sizeof(bool);\n60\t    bp->fix_count = (int *)calloc(numPages, sizeof(int));\n61\t    bp->updatedStrategy = strategy;\n62\t\n63\t   \n64\t\n65\t    for (i = 0; i < numPages; i++) {\n66\t        bp->bitdirty[i] = FALSE;\n67\t    }\n68\t\n69\t    for (i = 0; i < numPages; i++) {\n70\t      bp->fix_count[i] = 0;\n71\t    }\n72\t\n73\t    for (i = 0; i < numPages; i++) {\n74\t        bp->pagenum[i] = NO_PAGE;\n75\t    }\n76\t\n77\t    for (i = 0; i < numPages; i++) {\n78\t        bp->updatedOrder[i] = NO_PAGE;\n79\t    }\n80\t\n81\t    if (bm != NULL) {\n82\t        if (pageFileName != NULL) {\n83\t            bm->pageFile = strdup(pageFileName); \n84\t        } else {\n85\t            bm->pageFile = NULL;\n86\t        }\n87\t        bm->numPages = numPages;\n88\t        bm->strategy = strategy;\n89\t        bm->mgmtData = bp;\n90\t        if (bp != NULL) {\n91\t        } \n92\t        } \n93\t        return RC_OK;\n94\t    }\n95\t\n96\t// Define shutdown the buffer pool\n97\tRC shutdownBufferPool(BM_BufferPool *const bm) {\n98\t    Bufferpool *bpl = bm->mgmtData;\n99\t    \n100\t    for (int i = 0; i < bpl->totalPages; i++) {\n101\t        if (bpl->fix_count[i] != 0) {\n102\t            return RC_BUFFERPOOL_IN_USE;\n103\t        }\n104\t    }\n105\t    RC rc = writeDirtyPages(bm);\n106\t    if (rc != RC_OK) {\n107\t        return rc; \n108\t    }\n109\t \n110\t    if (closePageFile(&bpl->fhl) != RC_OK) {\n111\t        return RC_CLOSE_FAILED;\n112\t    }\n113\t    \n114\t    freeBufferPoolMemory(bm);\n115\t    return RC_OK;\n116\t}\n117\t\n118\t    // Helper function\n119\t    static RC writeDirtyPages(BM_BufferPool *const bm) {\n120\t        Bufferpool *bpl = bm->mgmtData;\n121\t        for (int j = 0; j < bpl->totalPages; j++) {\n122\t            if (bpl->bitdirty[j]) {\n123\t                int record_pointer = j * PAGE_SIZE;\n124\t                // Ensure capacity before writing\n125\t                RC rc = ensureCapacity(bpl->pagenum[j] + 1, &bpl->fhl);\n126\t                if (rc != RC_OK) {\n127\t                    return rc;\n128\t                }\n129\t                // Write block\n130\t                rc = writeBlock(bpl->pagenum[j], &bpl->fhl, (bpl->pagedata + record_pointer));\n131\t                if (rc != RC_OK) {\n132\t                    return RC_WRITE_FAILED;\n133\t                }\n134\t                bpl->numWrite++;\n135\t            }\n136\t        }\n137\t        return RC_OK;\n138\t    }\n139\t\n140\t    // Helper function\n141\t    static RC freeBufferPoolMemory(BM_BufferPool *const bm)\n142\t                \n143\t            {\n144\t        if (bm != NULL) {\n145\t            Bufferpool *bpl = bm->mgmtData;\n146\t            if (bpl != NULL) {\n147\t                if (bpl->updatedOrder != NULL) {\n148\t                    free(bpl->updatedOrder);\n149\t                    bpl->updatedOrder = NULL; \n150\t                }\n151\t                if (bpl->pagenum != NULL) {\n152\t                    free(bpl->pagenum);\n153\t                    bpl->pagenum = NULL; \n154\t                }\n155\t                if (bpl->bitdirty != NULL) {\n156\t                    free(bpl->bitdirty);\n157\t                    bpl->bitdirty = NULL; \n158\t                }\n159\t                if (bpl->fix_count != NULL) {\n160\t                    free(bpl->fix_count);\n161\t                    bpl->fix_count = NULL;\n162\t                }\n163\t                if (bpl->pagedata != NULL) {\n164\t                    free(bpl->pagedata);\n165\t                    bpl->pagedata = NULL; \n166\t                }\n167\t                free(bpl);\n168\t                bm->mgmtData = NULL;\n169\t            } else {\n170\t            }\n171\t            return RC_OK;\n172\t        } else {\n173\t            return RC_ERROR; \n174\t        }\n175\t\n176\t        return RC_OK;\n177\t}\n178\t    // Define flush the bufferpool\n179\t    RC forceFlushPool(BM_BufferPool *const bm) {\n180\t        Bufferpool *bpl;\n181\t        int rcode = RC_OK;\n182\t        bpl = bm->mgmtData;\n183\t\n184\t        for (int i = 0; bpl != NULL && i < bpl->totalPages; i++) {\n185\t                if (bpl->fix_count[i] == 0 && bpl->bitdirty[i] == TRUE) {\n186\t                FILE *file = fopen(bpl->fhl.fileName, \"r+\");\n187\t                fseek(file, 0, SEEK_END);\n188\t                long fileSize = ftell(file);\n189\t                long requiredSize = (bpl->pagenum[i] + 1) * PAGE_SIZE;\n190\t                if (fileSize < requiredSize) {\n191\t                    fseek(file, requiredSize - 1, SEEK_SET);\n192\t                    fputc('\\0', file);\n193\t                }\n194\t                fclose(file);\n195\t                file = fopen(bpl->fhl.fileName, \"r+\");\n196\t                if (file == NULL) {\n197\t                    rcode = RC_WRITE_FAILED;\n198\t                    break;\n199\t                }\n200\t                int record_pointer = i * PAGE_SIZE;\n201\t                fseek(file, bpl->pagenum[i] * PAGE_SIZE, SEEK_SET);\n202\t                if (fwrite(bpl->pagedata + record_pointer, sizeof(char), PAGE_SIZE, file) != PAGE_SIZE) {\n203\t                    rcode = RC_WRITE_FAILED;\n204\t                    fclose(file);\n205\t                    break; \n206\t                }\n207\t                if (file != NULL) {\n208\t                    fclose(file);\n209\t                    file = NULL; \n210\t                }\n211\t                if (bpl != NULL) {\n212\t                    if (i >= 0) {\n213\t                       if (bpl != NULL) {\n214\t                        *(bpl->bitdirty + i) = FALSE;\n215\t                        (*bpl).numWrite++;\n216\t                    }\n217\t\n218\t                    } \n219\t                } \n220\t            }\n221\t        }\n222\t        return rcode; \n223\t    }\n224\t\n225\t    // Define  pin a page \n226\tRC pinPage (BM_BufferPool *const bm, BM_PageHandle *const page, \n227\t            const PageNumber pageNum)\n228\t    {\n229\t        Bufferpool *buffer_pool;\n230\t        bool void_page=FALSE;\n231\t        bool foundedPage=FALSE;\n232\t        bool UpdatedStra_found=FALSE;\n233\t        int read_code;\n234\t        int record_pointer;\n235\t        int memory_address;\n236\t        int swap_location;\n237\t        \n238\t        SM_PageHandle page_handle;\n239\t        buffer_pool=bm->mgmtData;\n240\t        buffer_pool = bm->mgmtData;\n241\t        \n242\t        void_page = (buffer_pool->free_space == buffer_pool->totalPages) ? TRUE : void_page;\n243\t       if (!void_page) {\n244\t        int totalPages = buffer_pool->totalPages - buffer_pool->free_space;\n245\t        for (int i = 0; i < totalPages; i++) {\n246\t\n247\t            if (buffer_pool->pagenum[i] == pageNum) {\n248\t                page->pageNum = pageNum;\n249\t                int memory_address = i;\n250\t                buffer_pool->fix_count[memory_address]++;\n251\t                page->data = &buffer_pool->pagedata[memory_address * PAGE_SIZE];\n252\t                foundedPage = TRUE;\n253\t                if (buffer_pool->updatedStrategy == RS_LRU) {\n254\t                        int lastPosition = buffer_pool->totalPages - buffer_pool->free_space - 1; \n255\t                        swap_location = -1; \n256\t                        for (int j = 0; j <= lastPosition; j++) \n257\t                            if (buffer_pool->updatedOrder[j] != pageNum) {\n258\t                                if (j == buffer_pool->totalPages - 1) {\n259\t                                    swap_location = -1;\n260\t                                }\n261\t                             } else {\n262\t                                swap_location = j;\n263\t                                break;\n264\t                            }\n265\t                            if (swap_location != -1) {\n266\t                                memmove(&buffer_pool->updatedOrder[swap_location], &buffer_pool->updatedOrder[swap_location + 1], (lastPosition - swap_location) * sizeof(buffer_pool->updatedOrder[0]));\n267\t                                buffer_pool->updatedOrder[lastPosition] = pageNum;\n268\t                            }\n269\t                    }\n270\t                                else {\n271\t                                    int unutilized = 0;\n272\t                                    do {\n273\t                                    } while (++unutilized < 1);\n274\t                            }\n275\t                return RC_OK;\n276\t            }\n277\t            }\n278\t        } \n279\t\n280\t        if ((void_page == TRUE && buffer_pool != NULL && (1 == 1)) || \n281\t        ((foundedPage != TRUE && foundedPage == FALSE) && buffer_pool->free_space > 0 && \n282\t        buffer_pool->free_space <= buffer_pool->totalPages && buffer_pool->free_space == buffer_pool->free_space && \n283\t        (buffer_pool->free_space != -1 && buffer_pool->totalPages != -1) && \n284\t        (buffer_pool->free_space >= 0 && buffer_pool->totalPages >= buffer_pool->free_space) && \n285\t        ((buffer_pool->free_space + 1) > 1) && ((buffer_pool->totalPages - buffer_pool->free_space) >= 0)))\n286\t            {\n287\t        page_handle = (SM_PageHandle)calloc(1, PAGE_SIZE);\n288\t        if (page_handle != NULL) {\n289\t\n290\t            read_code = readBlock(pageNum, &buffer_pool->fhl, page_handle);\n291\t            if (read_code >= 0) {\n292\t                size_t total_used_pages = buffer_pool->totalPages - buffer_pool->free_space;\n293\t                memory_address = total_used_pages;\n294\t                if (memory_address >= 0 && memory_address <= buffer_pool->totalPages) {\n295\t                    size_t base_address = 0; \n296\t                    record_pointer = (memory_address * PAGE_SIZE) + base_address;\n297\t\n298\t                } \n299\t            } \n300\t        }\n301\t                memcpy(buffer_pool->pagedata + record_pointer, page_handle, PAGE_SIZE);\n302\t                buffer_pool->free_space--;\n303\t                buffer_pool->updatedOrder[memory_address] = pageNum;\n304\t                buffer_pool->pagenum[memory_address] = pageNum;\n305\t                buffer_pool->numRead++;\n306\t                buffer_pool->fix_count[memory_address]++;\n307\t                buffer_pool->bitdirty[memory_address] = FALSE;\n308\t                page->pageNum = pageNum;\n309\t                page->data = &(buffer_pool->pagedata[record_pointer]);\n310\t                free(page_handle);\n311\t\n312\t                return RC_OK;\n313\t            }\n314\t       \n315\t            bool isPageNotFound = !foundedPage;\n316\t            bool isBufferPoolValid = buffer_pool != NULL;\n317\t            bool isBufferPoolFull = buffer_pool->free_space == 0;\n318\t\n319\t            if (isPageNotFound && isBufferPoolValid && isBufferPoolFull)\n320\t            {\n321\t            UpdatedStra_found = FALSE;\n322\t            page_handle = (SM_PageHandle) malloc(PAGE_SIZE);\n323\t            if (page_handle != NULL) {\n324\t                memset(page_handle, 0, PAGE_SIZE);\n325\t            }\n326\t            read_code = readBlock(pageNum, &buffer_pool->fhl, page_handle);\n327\t\n328\t\n329\t            if (buffer_pool->updatedStrategy == RS_FIFO || buffer_pool->updatedStrategy == RS_LRU) {\n330\t                int i = 0, j = 0;\n331\t                do {\n332\t                    int swap_page = buffer_pool->updatedOrder[j];\n333\t                    i = 0; \n334\t                    do {\n335\t                        if (buffer_pool->pagenum[i] == swap_page && buffer_pool->fix_count[i] == 0) {\n336\t                            memory_address = i;\n337\t                            record_pointer = i * PAGE_SIZE;\n338\t                            if (buffer_pool->bitdirty[i]) {\n339\t                                read_code = ensureCapacity(buffer_pool->pagenum[i] + 1, &buffer_pool->fhl);\n340\t                                read_code = writeBlock(buffer_pool->pagenum[i], &buffer_pool->fhl, buffer_pool->pagedata + record_pointer);\n341\t                                buffer_pool->numWrite++;\n342\t                            }\n343\t                            swap_location = j;\n344\t                            UpdatedStra_found = TRUE;\n345\t                            break; \n346\t                        }\n347\t                        i++;\n348\t                    } while (i < buffer_pool->totalPages && !UpdatedStra_found);\n349\t                    j++;\n350\t                    if (UpdatedStra_found) break; \n351\t                } while (j < buffer_pool->totalPages);\n352\t            }\n353\t        }\n354\t\n355\t\n356\t         if (UpdatedStra_found == FALSE) {\n357\t            free(page_handle);\n358\t            return RC_BUFFERPOOL_FULL;\n359\t        } else {\n360\t            record_pointer = memory_address * PAGE_SIZE;\n361\t            int i = 0;\n362\t            if (i < PAGE_SIZE) {\n363\t                do {\n364\t                    buffer_pool->pagedata[i + record_pointer] = page_handle[i];\n365\t                    i++;\n366\t                } while (i < PAGE_SIZE);\n367\t            }\n368\t        }\n369\t            \n370\t        // Main logic\n371\t        if (buffer_pool->updatedStrategy == RS_LRU || buffer_pool->updatedStrategy == RS_FIFO) {\n372\t            ShiftUpdatedOrder(swap_location, buffer_pool->totalPages - 1, buffer_pool, pageNum);\n373\t        } \n374\t        UpdateBufferPoolStats(buffer_pool, memory_address, pageNum);\n375\t        page->pageNum = pageNum;\n376\t        page->data = buffer_pool->pagedata + record_pointer;\n377\t        free(page_handle); \n378\t        return RC_OK; \n379\t}\n380\t\n381\tstatic void ShiftUpdatedOrder(int start, int end, Bufferpool *bp, int newPageNum) {\n382\t    for (int i = start; i < end; i++) {\n383\t        bp->updatedOrder[i] = bp->updatedOrder[i + 1];\n384\t    }\n385\t    bp->updatedOrder[end] = newPageNum;\n386\t}\n387\t\n388\tstatic void UpdateBufferPoolStats(Bufferpool *bp, int memoryAddress, int pageNum) {\n389\t    bp->pagenum[memoryAddress] = pageNum;\n390\t    bp->numRead += 1;\n391\t    bp->fix_count[memoryAddress] += 1;\n392\t    bp->bitdirty[memoryAddress] = FALSE;\n393\t}\n394\t \n395\t// Define unpin a page \n396\tRC unpinPage(BM_BufferPool *const bm, BM_PageHandle *const page) {\n397\t    Bufferpool *bufferPool = bm->mgmtData;\n398\t    int SearchResultIndex = -1;\n399\t    for (int i = 0; i < bufferPool->totalPages; i++) {\n400\t        if (bufferPool->pagenum[i] == page->pageNum) {\n401\t            SearchResultIndex = i;\n402\t            break; \n403\t        }\n404\t    }\n405\t    if (SearchResultIndex != -1) {\n406\t        if (bufferPool->fix_count[SearchResultIndex] > 0) {\n407\t            bufferPool->fix_count[SearchResultIndex]--;\n408\t        } \n409\t    } \n410\t    return RC_OK;\n411\t}\n412\t\n413\t// Define mark a page dirty \n414\tRC markDirty(BM_BufferPool *const bm, BM_PageHandle *const page) {\n415\t    Bufferpool *bpl;\n416\t    int markedCount = 0; \n417\t    bpl = bm->mgmtData;\n418\t    for (int i = 0; i < bpl->totalPages; i++) {\n419\t        if (bpl->pagenum[i] == page->pageNum) {\n420\t            if (bpl->bitdirty[i] != TRUE) {\n421\t                bpl->bitdirty[i] = TRUE; \n422\t                markedCount++; \n423\t            }\n424\t            break; \n425\t        }\n426\t    }\n427\t    return RC_OK;\n428\t}\n429\t\n430\t// Define force a page\n431\tRC forcePage(BM_BufferPool *const bm, BM_PageHandle *const page) {\n432\t    Bufferpool *bpl;\n433\t    bpl = bm->mgmtData;\n434\t    for(int i = 0; i < bpl->totalPages; i++) {\n435\t        if(bpl->pagenum[i] == page->pageNum) {\n436\t            int record_pointer = i * PAGE_SIZE;\n437\t            printf(\"Simulated writing of page %d to disk at position %d.\\n\", page->pageNum, record_pointer);\n438\t            bpl->bitdirty[i] = FALSE;\n439\t            bpl->numWrite++;\n440\t            pageFound = TRUE;\n441\t            break;\n442\t        }\n443\t    }\n444\t    if (pageFound) {\n445\t        return RC_OK;\n446\t    } else {\n447\t        printf(\"Page %d not found in buffer pool.\\n\", page->pageNum);\n448\t        return RC_WRITE_FAILED;\n449\t    }\n450\t}\n451\t\n452\t// Define fixed counts of the pages \n453\tint *getFixCounts (BM_BufferPool *const bm) {\n454\t    if (bm == NULL) {\n455\t        printf(\"Buffer pool pointer is null.\\n\");\n456\t        return NULL; \n457\t    }\n458\t    Bufferpool *bpl;\n459\t    bpl = bm->mgmtData;\n460\t    if (bpl == NULL) {\n461\t        printf(\"Management data is null.\\n\");\n462\t        return NULL;\n463\t    }\n464\t    if (bpl->free_space == bpl->totalPages) {\n465\t        static int noFixes = 0; \n466\t        printf(\"All pages are available. No fixes are present.\\n\");\n467\t        return &noFixes;\n468\t    } else {\n469\t        printf(\"Returning fix counts for pages in use.\\n\");\n470\t        return bpl->fix_count;\n471\t    }\n472\t}\n473\t\n474\t// Define the number of pages that have been read \n475\tint getNumReadIO (BM_BufferPool *const bm)\n476\t{\n477\t    if (bm == NULL) {\n478\t        return 0;\n479\t    }\n480\t    Bufferpool *bpl;\n481\t    bpl = bm->mgmtData;\n482\t    if (bpl == NULL) {\n483\t        return 0;\n484\t    }\n485\t    int readCount = bpl->numRead;\n486\t    return readCount;\n487\t}\n488\t\n489\t// Define the number of pages written \n490\tint getNumWriteIO(BM_BufferPool *const bm) {\n491\t    if (bm == NULL) {\n492\t        return 0;\n493\t    } else {\n494\t        Bufferpool *bpl;\n495\t        bpl = bm->mgmtData;\n496\t        if (bpl == NULL) {\n497\t            return 0;\n498\t        } else {\n499\t            int writeCount = bpl->numWrite;\n500\t            return writeCount;\n501\t        }\n502\t    }\n503\t}\n504\t\n505\t// Define the page numbers as an array \n506\tPageNumber *getFrameContents(BM_BufferPool *const bm)\n507\t{\n508\t    Bufferpool *bpl;\n509\t    bpl = bm->mgmtData;\n510\t    bool isFull = (bpl->free_space == bpl->totalPages);\n511\t    PageNumber *result = NULL;\n512\t    if (isFull)\n513\t    {\n514\t        result = 0;\n515\t    }\n516\t    else\n517\t    {\n518\t        result = bpl->pagenum;\n519\t    }\n520\t    if (result != NULL)\n521\t    {\n522\t        return result;\n523\t    }\n524\t    else\n525\t    {\n526\t        return 0; \n527\t    }\n528\t}\n529\t\n530\t// Define array of dirty page \n531\tbool *getDirtyFlags(BM_BufferPool *const bm)\n532\t{\n533\t    if (bm == NULL) {\n534\t        return NULL;\n535\t    }\n536\t    Bufferpool *bpl;\n537\t    bpl = bm->mgmtData;\n538\t    if (bpl == NULL) {\n539\t        return NULL;\n540\t    }\n541\t    bool *dirtyFlags = bpl->bitdirty;\n542\t    if (dirtyFlags == NULL) {\n543\t        return NULL;\n544\t    }\n545\t    return dirtyFlags;\n546\t}\n547\t        \n548\t"}]},"parent_tool_use_id":null,"session_id":"e338dc35-9cfc-4f3d-b9e6-fe1c2d15cce0","uuid":"ca3fbfa4-a77f-4b22-b4f2-ac24ab0d1cfd","timestamp":"2026-05-30T10:20:35.476Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-RcE2Ag/project/c_src/buffer_mgr.c","content":"#include <string.h>\n#include <stdlib.h>\n#include <stdio.h>\n\n#include \"buffer_mgr.h\"\n#include \"storage_mgr.h\"\n#include \"dberror.h\"\n\n// Define Bufferpool\ntypedef struct Bufferpool\n{\n     int numRead;\n     int numWrite;\n     int totalPages;\n     int updatedStrategy;\n     int free_space;\n     int *updatedOrder;\n     bool *bitdirty;\n     int *fix_count;\n     int *accessTime;\n     int *pagenum;\n     char *pagedata;\n     SM_FileHandle fhl;\n}Bufferpool;\n\nbool pageFound = FALSE;\n\n//  Helper Functions\nstatic RC writeDirtyPages(BM_BufferPool *const bm);\nstatic RC freeBufferPoolMemory(BM_BufferPool *const bm);\nstatic void ShiftUpdatedOrder(int start, int end, Bufferpool *bp, int newPageNum);\nstatic void UpdateBufferPoolStats(Bufferpool *bp, int memoryAddress, int pageNum);\n\n// Define initBufferPool\nRC initBufferPool(BM_BufferPool *const bm, const char *const pageFileName, const int numPages, ReplacementStrategy strategy, void *stratData) {\n    SM_FileHandle fh;\n    Bufferpool *bp;\n    int rcode, i;\n\n    rcode = openPageFile((char *)pageFileName, &fh);\n    if (rcode != RC_OK) {\n        return rcode; \n    }\n    bp = (Bufferpool *)calloc(1, sizeof(Bufferpool));\n    if (!bp) {\n        return RC_MEMORY_ALLOCATION_FAIL; \n    }\n    bp->totalPages = numPages;\n    bp->pagedata = (char *)calloc(numPages * PAGE_SIZE, sizeof(char));\n    bp->numRead = 0;\n    bp->numWrite = 0;\n    bp->updatedOrder = (int *)calloc(numPages, sizeof(int));\n    bp->bitdirty = (bool *)calloc(numPages, sizeof(bool));\n    bp->free_space = numPages;\n    bp->fhl = fh;\n    bp->pagenum = (int *)calloc(numPages, sizeof(int));\n\n    int arraySize = numPages * sizeof(int);\n    bool boolArraySize = numPages * sizeof(bool);\n    bp->fix_count = (int *)calloc(numPages, sizeof(int));\n    bp->updatedStrategy = strategy;\n\n   \n\n    for (i = 0; i < numPages; i++) {\n        bp->bitdirty[i] = FALSE;\n    }\n\n    for (i = 0; i < numPages; i++) {\n      bp->fix_count[i] = 0;\n    }\n\n    for (i = 0; i < numPages; i++) {\n        bp->pagenum[i] = NO_PAGE;\n    }\n\n    for (i = 0; i < numPages; i++) {\n        bp->updatedOrder[i] = NO_PAGE;\n    }\n\n    if (bm != NULL) {\n        if (pageFileName != NULL) {\n            bm->pageFile = strdup(pageFileName); \n        } else {\n            bm->pageFile = NULL;\n        }\n        bm->numPages = numPages;\n        bm->strategy = strategy;\n        bm->mgmtData = bp;\n        if (bp != NULL) {\n        } \n        } \n        return RC_OK;\n    }\n\n// Define shutdown the buffer pool\nRC shutdownBufferPool(BM_BufferPool *const bm) {\n    Bufferpool *bpl = bm->mgmtData;\n    \n    for (int i = 0; i < bpl->totalPages; i++) {\n        if (bpl->fix_count[i] != 0) {\n            return RC_BUFFERPOOL_IN_USE;\n        }\n    }\n    RC rc = writeDirtyPages(bm);\n    if (rc != RC_OK) {\n        return rc; \n    }\n \n    if (closePageFile(&bpl->fhl) != RC_OK) {\n        return RC_CLOSE_FAILED;\n    }\n    \n    freeBufferPoolMemory(bm);\n    return RC_OK;\n}\n\n    // Helper function\n    static RC writeDirtyPages(BM_BufferPool *const bm) {\n        Bufferpool *bpl = bm->mgmtData;\n        for (int j = 0; j < bpl->totalPages; j++) {\n            if (bpl->bitdirty[j]) {\n                int record_pointer = j * PAGE_SIZE;\n                // Ensure capacity before writing\n                RC rc = ensureCapacity(bpl->pagenum[j] + 1, &bpl->fhl);\n                if (rc != RC_OK) {\n                    return rc;\n                }\n                // Write block\n                rc = writeBlock(bpl->pagenum[j], &bpl->fhl, (bpl->pagedata + record_pointer));\n                if (rc != RC_OK) {\n                    return RC_WRITE_FAILED;\n                }\n                bpl->numWrite++;\n            }\n        }\n        return RC_OK;\n    }\n\n    // Helper function\n    static RC freeBufferPoolMemory(BM_BufferPool *const bm)\n                \n            {\n        if (bm != NULL) {\n            Bufferpool *bpl = bm->mgmtData;\n            if (bpl != NULL) {\n                if (bpl->updatedOrder != NULL) {\n                    free(bpl->updatedOrder);\n                    bpl->updatedOrder = NULL; \n                }\n                if (bpl->pagenum != NULL) {\n                    free(bpl->pagenum);\n                    bpl->pagenum = NULL; \n                }\n                if (bpl->bitdirty != NULL) {\n                    free(bpl->bitdirty);\n                    bpl->bitdirty = NULL; \n                }\n                if (bpl->fix_count != NULL) {\n                    free(bpl->fix_count);\n                    bpl->fix_count = NU