     let two_pow_k = f64::from_bits(((k + 1023) as u64) << 52);\n        sum * two_pow_k\n    } else if k > 1023 {\n        // Split into multiple multiplications\n        let half = k / 2;\n        let other = k - half;\n        let p1 = f64::from_bits(((half + 1023) as u64) << 52);\n        let p2 = f64::from_bits(((other + 1023) as u64) << 52);\n        sum * p1 * p2\n    } else {\n        // Very negative: split\n        let half = k / 2;\n        let other = k - half;\n        if half >= -1022 && other >= -1022 {\n            let p1 = f64::from_bits(((half + 1023) as u64) << 52);\n            let p2 = f64::from_bits(((other + 1023) as u64) << 52);\n            sum * p1 * p2\n        } else {\n            0.0\n        }\n    }\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1000,"cache_read_input_tokens":42937,"cache_creation":{"ephemeral_5m_input_tokens":1000,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"22de9e01-2cc6-4586-86de-a2188fff27f7","uuid":"e1b215c7-6218-4b77-86e3-18de173a4f5e"}
