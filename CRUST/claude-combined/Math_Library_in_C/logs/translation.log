5e-1;\n    const C2: f64 = 1.42860682030941723212e-6;\n\n    let n_f = if x >= 0.0 {\n        castom_floor(LOG2_E * x + 0.5)\n    } else {\n        castom_floor(LOG2_E * x + 0.5)\n    };\n    let n = n_f as i32;\n\n    let r = (x - n_f * C1) - n_f * C2;\n    let xx = r * r;\n\n    // P polynomial: P(xx) = P0*xx^2 + P1*xx + P2\n    let p0 = 1.26177193074810590878e-4;\n    let p1 = 3.02994407707441961300e-2;\n    let p2 = 9.99999999999999999910e-1;\n    let px_poly = (p0 * xx + p1) * xx + p2;\n    let px = r * px_poly;\n\n    // Q polynomial: Q(xx) = Q0*xx^3 + Q1*xx^2 + Q2*xx + Q3\n    let q0 = 3.00198505138664455042e-6;\n    let q1 = 2.52448340349684104192e-3;\n    let q2 = 2.27265548208155028766e-1;\n    let q3 = 2.0;\n    let qx = ((q0 * xx + q1) * xx + q2) * xx + q3;\n\n    let res = 1.0 + 2.0 * (px / (qx - px));\n\n    ldexp_fast(res, n)\n}","originalFile":"// Constants\npub const S21_NAN: f64 = f64::NAN;\npub const EPS_6: f64 = 1e-06;\npub const S21_M_E: f64 = 2.71828182845904523536028747135266250;\npub const S21_INFINITY: f64 = f64::INFINITY;\npub const EPS_10: f64 = 1e-10;\npub const S21_M_PI: f64 = 3.14159265358979323846264338327950288;\n\n// Function Declarations\npub fn castom_floor(x: f64) -> f64 {\n    if x.is_nan() || x >= i64::MAX as f64 || x <= i64::MIN as f64 {\n        return x;\n    }\n    let truncation = (x as i64) as f64;\n    truncation - (if truncation > x { 1.0 } else { 0.0 })\n}\n\npub fn castom_tan(x: f64) -> f64 {\n    if x == 0.0 {\n        0.0\n    } else if S21_M_PI / 6.0 == x {\n        1.0 / castom_sqrt(3.0)\n    } else if S21_M_PI / 4.0 == x {\n        1.0\n    } else if S21_M_PI / 3.0 == x {\n        castom_sqrt(3.0)\n    } else if S21_M_PI / 2.0 == x {\n        S21_INFINITY\n    } else if S21_M_PI == x {\n        0.0\n    } else if 3.0 * S21_M_PI / 2.0 == x {\n        S21_INFINITY\n    } else if 2.0 * S21_M_PI == x {\n        0.0\n    } else {\n        castom_sin(x) / castom_cos(x)\n    }\n}\n\npub fn castom_atan(x: f64) -> f64 {\n    castom_asin(x / castom_sqrt(1.0 + x * x))\n}\n\npub fn castom_ceil(x: f64) -> f64 {\n    if x.is_nan() || x >= i64::MAX as f64 || x <= i64::MIN as f64 {\n        return x;\n    }\n    let truncation = (x as i64) as f64;\n    truncation + (if truncation < x { 1.0 } else { 0.0 })\n}\n\npub fn castom_sqrt(x: f64) -> f64 {\n    if x.is_nan() || x < 0.0 {\n        return f64::NAN;\n    }\n    if x == 0.0 {\n        return 0.0;\n    }\n    let mut sqrt = x / 2.0;\n    let mut temp = 0.0;\n    while sqrt != temp {\n        temp = sqrt;\n        sqrt = (x / temp + temp) / 2.0;\n    }\n    sqrt\n}\n\npub fn castom_trunc(x: f64) -> f64 {\n    if x > 0.0 {\n        castom_floor(x)\n    } else {\n        castom_ceil(x)\n    }\n}\n\npub fn castom_exp(x: f64) -> f64 {\n    if x.is_nan() {\n        return x;\n    }\n    if x == f64::INFINITY {\n        return f64::INFINITY;\n    }\n    if x == f64::NEG_INFINITY {\n        return 0.0;\n    }\n    if x == 0.0 {\n        return 1.0;\n    }\n    if x > 709.782712893384 {\n        return f64::INFINITY;\n    }\n    if x < -745.1332191019412 {\n        return 0.0;\n    }\n\n    // Range reduction: x = k * ln(2) + r, |r| <= ln(2)/2\n    // Then exp(x) = 2^k * exp(r). With small r, Taylor converges quickly.\n    const LN2_HI: f64 = 6.93147180369123816490e-01;\n    const LN2_LO: f64 = 1.90821492927058770002e-10;\n    const LOG2_E: f64 = 1.4426950408889634073599246810018921;\n\n    let k = if x >= 0.0 {\n        (x * LOG2_E + 0.5) as i32\n    } else {\n        (x * LOG2_E - 0.5) as i32\n    };\n    // Use Cody-Waite splitting of ln(2) for higher precision in r\n    let r = (x - (k as f64) * LN2_HI) - (k as f64) * LN2_LO;\n\n    // Taylor series for exp(r), |r| <= ln(2)/2 ≈ 0.347\n    let mut sum: f64 = 1.0;\n    let mut term: f64 = 1.0;\n    for j in 1..40 {\n        term *= r / (j as f64);\n        sum += term;\n        if castom_fabs(term) < 1e-20 * castom_fabs(sum) {\n            break;\n        }\n    }\n\n    // Multiply by 2^k via direct bit manipulation\n    if k >= -1022 && k <= 1023 {\n        let two_pow_k = f64::from_bits(((k + 1023) as u64) << 52);\n        sum * two_pow_k\n    } else if k > 1023 {\n        // Split into multiple multiplications\n        let half = k / 2;\n        let other = k - half;\n        let p1 = f64::from_bits(((half + 1023) as u64) << 52);\n        let p2 = f64::from_bits(((other + 1023) as u64) << 52);\n        sum * p1 * p2\n    } else {\n        // Very negative: split\n        let half = k / 2;\n        let other = k - half;\n        if half >= -1022 && other >= -1022 {\n            let p1 = f64::from_bits(((half + 1023) as u64) << 52);\n            let p2 = f64::from_bits(((other + 1023) as u64) << 52);\n            sum * p1 * p2\n        } else {\n            0.0\n        }\n    }\n}\n\npub fn castom_factorial(n: u64) -> u64 {\n    let mut result: u64 = 1;\n    for i in 2..=n {\n        result = result.wrapping_mul(i);\n    }\n    result\n}\n\npub fn castom_asin(x: f64) -> f64 {\n    let mut term: f64 = x;\n    let mut sum: f64 = f64::NAN;\n    if -1.0 < x && x < 1.0 {\n        sum = term;\n        let xx = x * x;\n        let mut k: i32 = 1;\n        while castom_fabs(term) > EPS_10 {\n            term *= xx * (k as f64) / (k as f64 + 1.0);\n            sum += term / (k as f64 + 2.0);\n            k += 2;\n        }\n    } else if x == 1.0 {\n        sum = S21_M_PI / 2.0;\n    } else if x == -1.0 {\n        sum = -S21_M_PI / 2.0;\n    }\n    sum\n}\n\npub fn castom_fmod(x: f64, y: f64) -> f64 {\n    x - castom_trunc(x / y) * y\n}\n\npub fn castom_acos(x: f64) -> f64 {\n    S21_M_PI / 2.0 - castom_asin(x)\n}\n\npub fn castom_pow(base: f64, exp: f64) -> f64 {\n    if base == 0.0 && exp != 0.0 {\n        0.0\n    } else if exp < 0.0 {\n        castom_pow(1.0 / base, -exp)\n    } else if base < 0.0 && exp != (exp as i64) as f64 {\n        f64::NAN\n    } else if exp == 0.0 {\n        1.0\n    } else {\n        let mut flag: f64 = 1.0;\n        let mut b = base;\n        if b < 0.0 && (exp as i64) % 2 != 0 {\n            flag = -1.0;\n        }\n        if b < 0.0 {\n            b = -b;\n        }\n        let div = exp as i64;\n        let mut integer_part: f64 = 1.0;\n        for _ in 0..div {\n            integer_part *= b;\n        }\n        integer_part * castom_exp((exp - div as f64) * castom_log(b)) * flag\n    }\n}\n\npub fn castom_abs(x: i32) -> i32 {\n    if x > 0 {\n        x\n    } else {\n        x.wrapping_neg()\n    }\n}\n\npub fn castom_log(x: f64) -> f64 {\n    let mut a: u32 = 0;\n    let mut b: f64;\n    if x > 0.0 {\n        let mut c = if x < 1.0 { 1.0 / x } else { x };\n        loop {\n            c /= S21_M_E;\n            if c > 1.0 {\n                a += 1;\n            } else {\n                break;\n            }\n        }\n        c = 1.0 / (c * S21_M_E - 1.0);\n        c = c + c + 1.0;\n        let f = c * c;\n        b = 0.0;\n        let mut d: f64 = 1.0;\n        c /= 2.0;\n        loop {\n            let e = b;\n            b += 1.0 / (d * c);\n            if b - e == 0.0 {\n                break;\n            }\n            d += 2.0;\n            c *= f;\n        }\n    } else if x == 0.0 {\n        b = f64::INFINITY;\n    } else {\n        b = f64::NAN;\n    }\n    if x < 1.0 {\n        -(a as f64 + b)\n    } else {\n        a as f64 + b\n    }\n}\n\npub fn castom_sin(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut sum: f64 = 0.0;\n    for i in 0..=20 {\n        let mut fa: f64 = 1.0;\n        let mut pw: f64 = 1.0;\n        for j in 1..=(2 * i + 1) {\n            fa *= j as f64;\n            pw *= x;\n        }\n        let sign = if i % 2 != 0 { -1.0 } else { 1.0 };\n        sum += (sign / fa) * pw;\n    }\n    sum\n}\n\npub fn castom_cos(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut t_s: f64 = 0.0;\n    let mut last: f64 = 1.0;\n    let mut k: i32 = 1;\n    while castom_fabs(last) > EPS_10 {\n        t_s += last;\n        l