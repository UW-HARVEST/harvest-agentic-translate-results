 generate_u(channel: &Channel, param: &Parameters, u: &mut Polynomial) -> Result<()> {\n    unimplemented!()\n}\n/// Generate the secret key for the arithmetic channel.\npub fn generate_secret(\n    channel: &Channel,\n    param: &Parameters,\n    u: &Polynomial,\n    secret: &mut PolyArray,\n    lambda: &mut Matrix3D,\n) -> Result<()> {\n    unimplemented!()\n}\n/// Generate the polynomial array `f0` for the public key.\npub fn generate_f0(channel: &Channel, param: &Parameters, f0: &mut PolyArray) -> Result<()> {\n    unimplemented!()\n}\n/// Generate the polynomial `f1` for the public key.\npub fn generate_f1(\n    channel: &Channel,\n    param: &Parameters,\n    f0: &PolyArray,\n    x: &PolyArray,\n    u: &Polynomial,\n    f1: &mut Polynomial,\n) -> Result<()> {\n    unimplemented!()\n}","userModified":false}}
