/ Use deque to find minimal s-mers in O(N)\n    for i in 0..num_s_mers {\n        while back > front && s_mer_hashes[deque[back - 1]] > s_mer_hashes[i] {\n            back -= 1;\n        }\n        deque[back] = i;\n        back += 1;\n        if i >= window_size && deque[front] + window_size <= i {\n            front += 1;\n        }\n\n        // Check for closed syncmer condition\n        if i + 1 >= window_size {\n            let min_pos = deque[front];\n            let kmer_pos = i + 1 - window_size;\n            if min_pos == kmer_pos || min_pos == kmer_pos + k - s {\n                add_minimizer(results, num_results, s_mer_hashes[min_pos], kmer_pos, min_pos);\n            }\n        }\n    }\n\n    // Suppress unused warning\n    let _ = HashMap::<u8, u8>::new;\n}\npub fn base_to_bits(base: char) -> u8 {\n    match base {\n        'A' | 'a' => 0,\n        'C' | 'c' => 1,\n        'G' | 'g' => 2,\n        'T' | 't' => 3,\n        _ => 0, // Treat unknown as 'A'\n    }\n}\npub fn complement_base(base: u8) -> u8 {\n    3 - base\n}\npub fn add_minimizer(results: &mut Vec<MinimizerResult>, size: &mut i32, minimizer_hash: u128, kmer_position: usize, smer_position: usize) {\n    results.push(MinimizerResult {\n        minimizer_hash,\n        kmer_position,\n        smer_position,\n    });\n    *size += 1;\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1190,"cache_read_input_tokens":19121,"cache_creation":{"ephemeral_5m_input_tokens":1190,"ephemeral_1h_input_tokens":0},"output_tokens":37,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a2f424fb-0301-4751-904c-e443a0f34328","uuid":"864ffb7d-1b91-4a49-a1a0-43324d6c34da"}
