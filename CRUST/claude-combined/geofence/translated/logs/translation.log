{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_26mfclglbw5iyyim32hov5truwz7vzkg2gls3eqlhgfzayj73z3a","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01X5qmzba6iEBcoMTBjpDXLN","name":"Write","input":{"file_path":"/tmp/harvest-crust-VBpfVL/project/src/geofence.rs","content":"use std::f64::consts::PI;\n#[derive(Debug, Clone, Copy)]\npub struct Point {\n    pub x: f64,\n    pub y: f64,\n}\nconst EARTH_RADIUS: f64 = 6_378_137.0;\nfn deg2rad(deg: f64) -> f64 {\n    deg / (180.0 / PI)\n}\nfn lat2y_m(lat: f64) -> f64 {\n    (deg2rad(lat) / 2.0 + PI / 4.0).tan().ln() * EARTH_RADIUS\n}\nfn lon2x_m(lon: f64) -> f64 {\n    deg2rad(lon) * EARTH_RADIUS\n}\nfn is_point_in_polygon(p: &Point, vertices: &[Point]) -> bool {\n    let number_of_vertices = vertices.len();\n    if number_of_vertices < 3 {\n        return false;\n    }\n\n    let x = p.x;\n    let y = p.y;\n    let mut number_of_intersections: i32 = 0;\n\n    for i in 0..number_of_vertices {\n        let x1 = vertices[i].x;\n        let y1 = vertices[i].y;\n        let x2 = vertices[(i + 1) % number_of_vertices].x;\n        let y2 = vertices[(i + 1) % number_of_vertices].y;\n\n        if (y1 > y && y2 > y) || (y1 < y && y2 < y) {\n            // No intersection\n            continue;\n        } else {\n            // intersection of line segment from vertices and line segment from given point\n            let s = x1 + (x2 - x1) * ((y - y1) / (y2 - y1));\n\n            if s <= x {\n                number_of_intersections += 1;\n                if x == x1 && y == y1 {\n                    // if the point is at the vertex, then we need to reduce one count\n                    number_of_intersections -= 1;\n                } else if s == x1 && y == y1 {\n                    // if the intersection is at a vertex, then we need to reduce one count\n                    number_of_intersections -= 1;\n                }\n            }\n        }\n    }\n\n    number_of_intersections % 2 == 1\n}\npub fn is_position_in_geofence(p: &Point, vertices: &[Point]) -> bool {\n    let xy: Vec<Point> = vertices\n        .iter()\n        .map(|v| Point {\n            x: lon2x_m(v.x),\n            y: lat2y_m(v.y),\n        })\n        .collect();\n\n    let p_m = Point {\n        x: lon2x_m(p.x),\n        y: lat2y_m(p.y),\n    };\n\n    is_point_in_polygon(&p_m, &xy)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2572,"cache_read_input_tokens":20869,"cache_creation":{"ephemeral_5m_input_tokens":2572,"ephemeral_1h_input_tokens":0},"output_tokens":38,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"0884535b-3a58-43ed-9843-4271752a3c11","uuid":"26401d39-8252-4acd-997b-d5180de6fa94"}
