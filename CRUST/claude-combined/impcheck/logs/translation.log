{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_018JEY3wo5k72naWYbUyu2Wu","type":"tool_result","content":"1\t\n2\t#include <stdlib.h>\n3\t#include <stdbool.h>        // for bool, false, true\n4\t#include <stdio.h>          // for snprintf\n5\t#include \"hash.h\"           // for hash_table_find, hash_table_delete_last_f...\n6\t#include \"siphash.h\"        // for siphash_digest, siphash_update\n7\t#include \"trusted_utils.h\"  // for u64, trusted_utils_msgstr, MALLOB_UNLIKELY\n8\t\n9\t// Instantiate int_vec\n10\t#define TYPE int\n11\t#define TYPED(THING) int_ ## THING\n12\t#include \"vec.h\"\n13\t#undef TYPED\n14\t#undef TYPE\n15\t\n16\t// Instantiate i8_vec\n17\t#define TYPE signed char\n18\t#define TYPED(THING) i8_ ## THING\n19\t#include \"vec.h\"\n20\t#undef TYPED\n21\t#undef TYPE\n22\t\n23\t// The hash table where we keep all clauses and which uses most of our RAM.\n24\t// We still use a power-of-two growth policy since this makes lookups faster.\n25\tstruct hash_table* clause_table;\n26\t\n27\t// Table of all variables with their current assignment (-1/0/1).\n28\t// We perform all LRUP checks using one big vector of all variable polarities,\n29\t// which is set and reset for each check. This allows for O(1) queries\n30\t// for a literal's assignment.\n31\tstruct i8_vec* var_values;\n32\t\n33\t// We remember the set variables in a stack to reset them later.\n34\tstruct int_vec* assigned_units;\n35\t\n36\tbool check_model;\n37\tbool lenient;\n38\tu64 id_to_add = 1;\n39\tu64 nb_loaded_clauses = 0;\n40\tstruct int_vec* clause_to_add;\n41\tbool done_loading = false;\n42\tbool unsat_proven = false;\n43\t\n44\t\n45\tint* clause_init(const int* data, int nb_lits) {\n46\t    int* cls = trusted_utils_calloc(nb_lits+1, sizeof(int));\n47\t    for (int i = 0; i < nb_lits; i++) cls[i] = data[i];\n48\t    cls[nb_lits] = 0;\n49\t    return cls;\n50\t}\n51\t\n52\tvoid reset_assignments() {\n53\t    for (u64 i = 0; i < assigned_units->size; i++)\n54\t        var_values->data[assigned_units->data[i]] = 0;\n55\t    int_vec_clear(assigned_units);\n56\t}\n57\t\n58\tbool check_clause(u64 base_id, const int* lits, int nb_lits, const u64* hints, int nb_hints) {\n59\t\n60\t    int_vec_reserve(assigned_units, nb_lits + nb_hints);\n61\t    // Assume the negation of each literal in the new clause\n62\t    for (int i = 0; i < nb_lits; i++) {\n63\t        const int var = lits[i] > 0 ? lits[i] : -lits[i];\n64\t        var_values->data[var] = lits[i]>0 ? -1 : 1; // negated\n65\t        int_vec_push(assigned_units, var); // remember to reset later\n66\t    }\n67\t\n68\t    // Traverse the provided hints to derive a conflict, i.e., the empty clause\n69\t    bool ok = true;\n70\t    for (int i = 0; i < nb_hints; i++) {\n71\t\n72\t        // Find the clause for this hint\n73\t        const u64 hint_id = hints[i];\n74\t        int* cls = (int*) hash_table_find(clause_table, hint_id);\n75\t        if (MALLOB_UNLIKELY(!cls)) {\n76\t            // ERROR - hint not found\n77\t            snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: hint %lu not found\", base_id, hint_id);\n78\t            break;\n79\t        }\n80\t\n81\t        // Interpret hint clause (should derive a new unit clause)\n82\t        int new_unit = 0;\n83\t        for (int lit_idx = 0; ; lit_idx++) { // for each literal ...\n84\t            const int lit = cls[lit_idx];\n85\t            if (lit == 0) break;           // ... until termination zero\n86\t            const int var = lit > 0 ? lit : -lit;\n87\t            if (var_values->data[var] == 0) {\n88\t                // Literal is unassigned\n89\t                if (MALLOB_UNLIKELY(new_unit != 0)) {\n90\t                    // ERROR - multiple unassigned literals in hint clause!\n91\t                    snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: multiple literals unassigned\", base_id);\n92\t                    ok = false; break;\n93\t                }\n94\t                new_unit = lit;\n95\t                continue;\n96\t            }\n97\t            // Literal is fixed\n98\t            const bool sign = var_values->data[var]>0;\n99\t            if (MALLOB_UNLIKELY(sign == (lit>0))) {\n100\t                // ERROR - clause is satisfied, so it is not a correct hint\n101\t                snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: dependency %lu is satisfied\", base_id, hint_id);\n102\t                ok = false; break;\n103\t            }\n104\t            // All OK - literal is false, thus (virtually) removed from the clause\n105\t        }\n106\t        if (!ok) break; // error detected - stop\n107\t\n108\t        // NO unit derived?\n109\t        if (new_unit == 0) {\n110\t            // No unassigned literal in the clause && clause not satisfied\n111\t            // -> Empty clause derived.\n112\t            if (MALLOB_UNLIKELY(i+1 < nb_hints)) {\n113\t                // ERROR - not at the final hint yet!\n114\t                snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: empty clause produced at non-final hint %lu\", base_id, hint_id);\n115\t                break;\n116\t            }\n117\t            // Final hint produced empty clause - everything OK!\n118\t            reset_assignments();\n119\t            return true;\n120\t        }\n121\t        // Insert the new derived unit clause\n122\t        int var = new_unit > 0 ? new_unit : -new_unit;\n123\t        var_values->data[var] = new_unit>0 ? 1 : -1;\n124\t        int_vec_push(assigned_units, var); // remember to reset later\n125\t    }\n126\t\n127\t    // ERROR - something went wrong\n128\t    if (trusted_utils_msgstr[0] == '\\0')\n129\t        snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: no empty clause was produced\", base_id);\n130\t    reset_assignments();\n131\t    return false;\n132\t}\n133\t\n134\t// Quadratic check for clause equivalence - \n135\t// assuming that most imported clauses are rather short.\n136\tbool clauses_equivalent(int* left_cls, int* right_cls) {\n137\t    int lit_idx = 0;\n138\t    for (; left_cls[lit_idx] != 0; lit_idx++) {\n139\t        const int left_lit = left_cls[lit_idx];\n140\t        bool found = false;\n141\t        for (int right_lit_idx = 0; right_cls[right_lit_idx] != 0; right_lit_idx++) {\n142\t            if (right_cls[right_lit_idx] == left_lit) {\n143\t                found = true;\n144\t                break;\n145\t            }\n146\t        }\n147\t        if (!found) return false;\n148\t    }\n149\t    const int left_size = lit_idx;\n150\t    for (lit_idx = 0; right_cls[lit_idx] != 0; lit_idx++) {}\n151\t    const int right_size = lit_idx;\n152\t    return left_size == right_size;\n153\t}\n154\t\n155\tbool lrat_check_add_axiomatic_clause(u64 id, const int* lits, int nb_lits) {\n156\t    int* cls = clause_init(lits, nb_lits);\n157\t    bool ok = hash_table_insert(clause_table, id, cls);\n158\t    if (!ok) {\n159\t        if (lenient) {\n160\t            // In lenient mode, ignore the addition if and only if the clauses\n161\t            // are syntactically equivalent (except for literal ordering).\n162\t            int* old_cls = (int*) hash_table_find(clause_table, id);\n163\t            if (old_cls && clauses_equivalent(old_cls, cls)) {\n164\t                ok = true;\n165\t            }\n166\t        }\n167\t        if (!ok) snprintf(trusted_utils_msgstr, 512, \"Insertion of clause %lu unsuccessful - already present?\", id);\n168\t    }\n169\t    else if (nb_lits == 0) unsat_proven = true; // added top-level empty clause!\n170\t    return ok;\n171\t}\n172\t\n173\tvoid lrat_check_init(int nb_vars, bool opt_check_model, bool opt_lenient) {\n174\t    clause_table = hash_table_init(16);\n175\t    clause_to_add = int_vec_init(512);\n176\t    var_values = i8_vec_init(nb_vars+1);\n177\t    assigned_units = int_vec_init(512);\n178\t    check_model = opt_check_model;\n179\t    lenient = opt_lenient;\n180\t}\n181\t\n182\tbool lrat_check_load(int lit) {\n183\t    if (lit == 0) {\n184\t        if (!lrat_check_add_axiomatic_clause(id_to_add, clause_to_add->data, clause_to_add->size)) {\n185\t            return false;\n186\t        }\n187\t        id_to_add++;\n188\t        int_vec_push(clause_to_add, 0);\n189\t        siphash_update((u8*) clause_to_add->data, clause_to_add->size*sizeof(int));\n190\t        int_vec_clear(clause_to_add);\n191\t        return true;\n192\t    }\n193\t    int_vec_push(clause_to_add, lit);\n194\t    return true;\n195\t}\n196\t\n197\tbool lrat_check_end_load(u8** out_sig) {\n198\t    if (clause_to_add->size > 0) {\n199\t        snprintf(trusted_utils_msgstr, 512, \"literals left in unterminated clause\");\n200\t        return false;\n201\t    }\n202\t    siphash_pad(2); // two-byte padding for formula signature input\n203\t    *out_sig = siphash_digest();\n204\t    done_loading = true;\n205\t    nb_loaded_clauses = id_to_add-1;\n206\t    return true;\n207\t}\n208\t\n209\t\n210\tbool lrat_check_add_clause(u64 id, const int* lits, int nb_lits, const u64* hints, int nb_hints) {\n211\t    if (!check_clause(id, lits, nb_lits, hints, nb_hints)) {\n212\t        return false;\n213\t    }\n214\t    return lrat_check_add_axiomatic_clause(id, lits, nb_lits);\n215\t}\n216\t\n217\tbool lrat_check_delete_clause(const u64* ids, int nb_ids) {\n218\t    for (int i = 0; i < nb_ids; i++) {\n219\t        u64 id = ids[i];\n220\t        int* cls = hash_table_find(clause_table, id);\n221\t        if (!cls) {\n222\t            snprintf(trusted_utils_msgstr, 512, \"Clause deletion: ID %lu not found\", id);\n223\t            return false;\n224\t        }\n225\t        if (check_model && id <= nb_loaded_clauses) {\n226\t            // Do not delete original problem clauses to enable checking of a model\n227\t            continue;\n228\t        }\n229\t        free(cls);\n230\t        if (!hash_table_delete_last_found(clause_table)) {\n231\t            snprintf(trusted_utils_msgstr, 512, \"Clause deletion: Hash table error for ID %lu\", id);\n232\t            return false;\n233\t        }\n234\t    }\n235\t    return true;\n236\t}\n237\t\n238\tbool lrat_check_validate_unsat() {\n239\t    if (!done_loading) {\n240\t        snprintf(trusted_utils_msgstr, 512, \"UNSAT validation illegal - loading formula was not concluded\");\n241\t        return false;\n242\t    }\n243\t    if (!unsat_proven) {\n244\t        snprintf(trusted_utils_msgstr, 512, \"UNSAT validation unsuccessful - did not derive or import empty clause\");\n245\t        return false;\n246\t    }\n247\t    return true;\n248\t}\n249\t\n250\tbool lrat_check_validate_sat(int* model, u64 size) {\n251\t\n252\t    // Still loading the formula?\n253\t    if (!done_loading) {\n254\t        snprintf(trusted_utils_msgstr, 512, \"SAT validation illegal - loading formula was not concluded\");\n255\t        return false;\n256\t    }\n257\t    // Not executed with checking of models enabled?\n258\t    if (!check_model) {\n259\t        snprintf(trusted_utils_msgstr, 512, \"SAT validation illegal - not executed to explicitly support this\");\n260\t        return false;\n261\t    }\n262\t    // Check each original problem clause\n263\t    for (u64 id = 1; id <= nb_loaded_clauses; id++) {\n264\t        const int* cls = (int*) hash_table_find(clause_table, id);\n265\t        if (MALLOB_UNLIKELY(!cls)) {\n266\t            // ERROR - clause not found\n267\t            snprintf(trusted_utils_msgstr, 512, \"SAT validation: original ID %lu not found\", id);\n268\t            return false;\n269\t        }\n270\t        // Iterate over the literals of the clause\n271\t        bool satisfied = false;\n272\t        for (int lit_idx = 0; cls[lit_idx] != 0; lit_idx++) {\n273\t            const int lit = cls[lit_idx];\n274\t            const int var = lit>0 ? lit : -lit;\n275\t            if (MALLOB_UNLIKELY((u64) (var-1) >= size)) {\n276\t                // ERROR - model does not cover this variable\n277\t                snprintf(trusted_utils_msgstr, 512, \"SAT validation: model does not cover variable %i\", var);\n278\t                return false;\n279\t            }\n280\t            // Is the literal satisfied in the model?\n281\t            int modelLit = model[var-1];\n282\t            if (MALLOB_UNLIKELY(modelLit != var && modelLit != -var && modelLit != 0)) {\n283\t                // ERROR - clause not found\n284\t                snprintf(trusted_utils_msgstr, 512, \"SAT validation: unexpected literal %i in assignment of variable %i\", modelLit, var);\n285\t                return false;\n286\t            }\n287\t            if (modelLit == 0) {\n288\t                // The value of this variable allegedly does not matter,\n289\t                // so let us just assign the fitting value.\n290\t                // If this leads to an error, it does matter, which means that the specified model is wrong.\n291\t                modelLit = model[var-1] = lit;\n292\t            }\n293\t            if (modelLit == lit) {\n294\t                // Literal satisfied under the model satisfies the clause\n295\t                satisfied = true;\n296\t                break;\n297\t            }\n298\t        }\n299\t        // Clause NOT satisfied?\n300\t        if (MALLOB_UNLIKELY(!satisfied)) {\n301\t            // ERROR - unsatisfied clause(s) remain(s)\n302\t            snprintf(trusted_utils_msgstr, 512, \"SAT validation: original clause %lu not satisfied\", id);\n303\t            return false;\n304\t        }\n305\t    }\n306\t    // All original problem clauses are satisfied – correct model!\n307\t    return true;\n308\t}\n309\t"}]},"parent_tool_use_id":null,"session_id":"65921d9f-a060-47cc-9621-6e056e950ee8","uuid":"4c56bf7f-3381-4b5a-a91a-7b83836a77ca","timestamp":"2026-06-01T10:30:14.370Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-BHq35m/project/c_src/src/trusted/lrat_check.c","content":"\n#include <stdlib.h>\n#include <stdbool.h>        // for bool, false, true\n#include <stdio.h>          // for snprintf\n#include \"hash.h\"           // for hash_table_find, hash_table_delete_last_f...\n#include \"siphash.h\"        // for siphash_digest, siphash_update\n#include \"trusted_utils.h\"  // for u64, trusted_utils_msgstr, MALLOB_UNLIKELY\n\n// Instantiate int_vec\n#define TYPE int\n#define TYPED(THING) int_ ## THING\n#include \"vec.h\"\n#undef TYPED\n#undef TYPE\n\n// Instantiate i8_vec\n#define TYPE signed char\n#define TYPED(THING) i8_ ## THING\n#include \"vec.h\"\n#undef TYPED\n#undef TYPE\n\n// The hash table where we keep all clauses and which uses most of our RAM.\n// We still use a power-of-two growth policy since this makes lookups faster.\nstruct hash_table* clause_table;\n\n// Table of all variables with their current assignment (-1/0/1).\n// We perform all LRUP checks using one big vector of all variable polarities,\n// which is set and reset for each check. This allows for O(1) queries\n// for a literal's assignment.\nstruct i8_vec* var_values;\n\n// We remember the set variables in a stack to reset them later.\nstruct int_vec* assigned_units;\n\nbool check_model;\nbool lenient;\nu64 id_to_add = 1;\nu64 nb_loaded_clauses = 0;\nstruct int_vec* clause_to_add;\nbool done_loading = false;\nbool unsat_proven = false;\n\n\nint* clause_init(const int* data, int nb_lits) {\n    int* cls = trusted_utils_calloc(nb_lits+1, sizeof(int));\n    for (int i = 0; i < nb_lits; i++) cls[i] = data[i];\n    cls[nb_lits] = 0;\n    return cls;\n}\n\nvoid reset_assignments() {\n    for (u64 i = 0; i < assigned_units->size; i++)\n        var_values->data[assigned_units->data[i]] = 0;\n    int_vec_clear(assigned_units);\n}\n\nbool check_clause(u64 base_id, const int* lits, int nb_lits, const u64* hints, int nb_hints) {\n\n    int_vec_reserve(assigned_units, nb_lits + nb_hints);\n    // Assume the negation of each literal in the new clause\n    for (int i = 0; i < nb_lits; i++) {\n        const int var = lits[i] > 0 ? lits[i] : -lits[i];\n        var_values->data[var] = lits[i]>0 ? -1 : 1; // negated\n        int_vec_push(assigned_units, var); // remember to reset later\n    }\n\n    // Traverse the provided hints to derive a conflict, i.e., the empty clause\n    bool ok = true;\n    for (int i = 0; i < nb_hints; i++) {\n\n        // Find the clause for this hint\n        const u64 hint_id = hints[i];\n        int* cls = (int*) hash_table_find(clause_table, hint_id);\n        if (MALLOB_UNLIKELY(!cls)) {\n            // ERROR - hint not found\n            snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: hint %lu not found\", base_id, hint_id);\n            break;\n        }\n\n        // Interpret hint clause (should derive a new unit clause)\n        int new_unit = 0;\n        for (int lit_idx = 0; ; lit_idx++) { // for each literal ...\n            const int lit = cls[lit_idx];\n            if (lit == 0) break;           // ... until termination zero\n            const int var = lit > 0 ? lit : -lit;\n            if (var_values->data[var] == 0) {\n                // Literal is unassigned\n                if (MALLOB_UNLIKELY(new_unit != 0)) {\n                    // ERROR - multiple unassigned literals in hint clause!\n                    snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: multiple literals unassigned\", base_id);\n                    ok = false; break;\n                }\n                new_unit = lit;\n                continue;\n            }\n            // Literal is fixed\n            const bool sign = var_values->data[var]>0;\n            if (MALLOB_UNLIKELY(sign == (lit>0))) {\n                // ERROR - clause is satisfied, so it is not a correct hint\n                snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: dependency %lu is satisfied\", base_id, hint_id);\n                ok = false; break;\n            }\n            // All OK - literal is false, thus (virtually) removed from the clause\n        }\n        if (!ok) break; // error detected - stop\n\n        // NO unit derived?\n        if (new_unit == 0) {\n            // No unassigned literal in the clause && clause not satisfied\n            // -> Empty clause derived.\n            if (MALLOB_UNLIKELY(i+1 < nb_hints)) {\n                // ERROR - not at the final hint yet!\n                snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: empty clause produced at non-final hint %lu\", base_id, hint_id);\n                break;\n            }\n            // Final hint produced empty clause - everything OK!\n            reset_assignments();\n            return true;\n        }\n        // Insert the new derived unit clause\n        int var = new_unit > 0 ? new_unit : -new_unit;\n        var_values->data[var] = new_unit>0 ? 1 : -1;\n        int_vec_push(assigned_units, var); // remember to reset later\n    }\n\n    // ERROR - something went wrong\n    if (trusted_utils_msgstr[0] == '\\0')\n        snprintf(trusted_utils_msgstr, 512, \"Derivation %lu: no empty clause was produced\", base_id);\n    reset_assignments();\n    return false;\n}\n\n// Quadratic check for clause equivalence - \n// assuming that most imported clauses are rather short.\nbool clauses_equivalent(int* left_cls, int* right_cls) {\n    int lit_idx = 0;\n    for (; left_cls[lit_idx] != 0; lit_idx++) {\n        const int left_lit = left_cls[lit_idx];\n        bool found = false;\n        for (int right_lit_idx = 0; right_cls[right_lit_idx] != 0; right_lit_idx++) {\n            if (right_cls[right_lit_idx] == left_lit) {\n                found = true;\n                break;\n            }\n        }\n        if (!found) return false;\n    }\n    const int left_size = lit_idx;\n    for (lit_idx = 0; right_cls[lit_idx] != 0; lit_idx++) {}\n    const int right_size = lit_idx;\n    return left_size == right_size;\n}\n\nbool lrat_check_add_axiomatic_clause(u64 id, const int* lits, int nb_lits) {\n    int* cls = clause_init(lits, nb_lits);\n    bool ok = hash_table_insert(clause_table, id, cls);\n    if (!ok) {\n        if (lenient) {\n            // In lenient mode, ignore the addition if and only if the clauses\n            // are syntactically equivalent (except for literal ordering).\n            int* old_cls = (int*) hash_table_find(clause_table, id);\n            if (old_cls && clauses_equivalent(old_cls, cls)) {\n                ok = true;\n            }\n        }\n        if (!ok) snprintf(trusted_utils_msgstr, 512, \"Insertion of clause %lu unsuccessful - already present?\", id);\n    }\n    else if (nb_lits == 0) unsat_proven = true; // added top-level empty clause!\n    return ok;\n}\n\nvoid lrat_check_init(int nb_vars, bool opt_check_model, bool opt_lenient) {\n    clause_table = hash_table_init(16);\n    clause_to_add = int_vec_init(512);\n    var_values = i8_vec_init(nb_vars+1);\n    assigned_units = int_vec_init(512);\n    check_model = opt_check_model;\n    lenient = opt_lenient;\n}\n\nbool lrat_check_load(int lit) {\n    if (lit == 0) {\n        if (!lrat_check_add_axiomatic_clause(id_to_add, clause_to_add->data, clause_to_add->size)) {\n            return false;\n        }\n        id_to_add++;\n        int_vec_push(clause_to_add, 0);\n        siphash_update((u8*) clause_to_add->data, clause_to_add->size*sizeof(int));\n        int_vec_clear(clause_to_add);\n        return true;\n    }\n    int_vec_push(clause_to_add, lit);\n    return true;\n}\n\nbool lrat_check_end_load(u8** out_sig) {\n    if (clause_to_add->size > 0) {\n        snprintf(trusted_utils_msgstr, 512, \"literals left in unterminated clause\");\n        return false;\n    }\n    siphash_pad(2); // two-byte padding for formula signature input\n    *out_sig = siphash_digest();\n    done_loading = true;\n    nb_loaded_clauses = id_to_add-1;\n    return true;\n}\n\n\nbool lrat_check_add_clause(u64 id, const int* lits, int nb_lits, const u64* hints, int nb_hints) {\n    if (!check_clause(id, lits, nb_lits, hints, nb_hints)) {\n        return false;\n    }\n    return lrat_check_add_axiomatic_clause(id, lits, nb_lits);\n}\n\nbool lrat_check_delete_clause(const u64* ids, int nb_ids) {\n    for (int i = 0; i < nb_ids; i++) {\n        u64 id = ids[i];\n        int* cls = hash_table_find(clause_table, id);\n        if (!cls) {\n            snprintf(trusted_utils_msgstr, 512, \"Clause deletion: ID %lu not found\", id);\n            return false;\n        }\n        if (check_model && id <= nb_loaded_clauses) {\n            // Do not delete original problem clauses to enable checking of a model\n            continue;\n        }\n        free(cls);\n        if (!hash_table_delete_last_found(clause_table)) {\n            snprintf(trusted_utils_msgstr, 512, \"Clause deletion: Hash table error for ID %lu\", id);\n            return false;\n        }\n    }\n    return true;\n}\n\nbool lrat_check_validate_unsat() {\n    if (!done_loading) {\n        snprintf(trusted_utils_msgstr, 512, \"UNSAT validation illegal - loading formula was not concluded\");\n        return false;\n    }\n    if (!unsat_proven) {\n        snprintf(trusted_utils_msgstr, 512, \"UNSAT validation unsuccessful - did not derive or import empty clause\");\n        return false;\n    }\n    return true;\n}\n\nbool lrat_check_validate_sat(int* model, u64 size) {\n\n    // Still loading the formula?\n    if (!done_loading) {\n        snprintf(trusted_utils_msgstr, 512, \"SAT validation illegal - loading formula was not concluded\");\n        return false;\n    }\n    // Not executed with checking of models enabled?\n    if (!check_model) {\n        snprintf(trusted_utils_msgstr, 512, \"SAT validation illegal - not executed to explicitly support this\");\n        return false;\n    }\n    // Check each original problem clause\n    for (u64 id = 1; id <= nb_loaded_clauses; id++) {\n        const int* cls = (int*) hash_table_find(clause_table, id);\n        if (MALLOB_UNLIKELY(!cls)) {\n            // ERROR - clause not found\n            snprintf(trusted_utils_msgstr, 512, \"SAT validation: original ID %lu not found\", id);\n            return false;\n        }\n        // Iterate over the literals of the clause\n        bool satisfied = false;\n        for (int lit_idx = 0; cls[lit_idx] != 0; lit_idx++) {\n            const int lit = cls[lit_idx];\n            const int var = lit>0 ? lit : -lit;\n            if (MALLOB_UNLIKELY((u64) (var-1) >= size)) {\n                // ERROR - model does not cover this variable\n                snprintf(trusted_utils_msgstr, 512, \"SAT validation: model does not cover variable %i\", var);\n                return false;\n            }\n            // Is the literal satisfied in the model?\n            int modelLit = model[var-1];\n            if (MALLOB_UNLIKELY(modelLit != var && modelLit != -var && modelLit != 0)) {\n                // ERROR - clause not found\n                snprintf(trusted_utils_msgstr, 512, \"SAT validation: unexpected literal %i in assignment of variable %i\", modelLit, var);\n                return false;\n            }\n            if (modelLit == 0) {\n                // The value of this variable allegedly does not matter,\n                // so let us just assign the fitting value.\n                // If this leads to an error, it does matter, which means that the specified model is wrong.\n                modelLit = model[var-1] = lit;\n            }\n            if (modelLit == lit) {\n                // Literal satisfied under the model satisfies the clause\n                satisfied = true;\n                break;\n            }\n        }\n        // Clause NOT satisfied?\n        if (MALLOB_UNLIKELY(!satisfied)) {\n            // ERROR - unsatisfied clause(s) remain(s)\n            snprintf(trusted_utils_msgstr, 512, \"SAT validation: original clause %lu not satisfied\", id);\n            return false;\n        }\n    }\n    // All original problem clauses are satisfied – correct model!\n    return true;\n}\n","numLines":309,"startLine":1,"totalLines":309}}}
