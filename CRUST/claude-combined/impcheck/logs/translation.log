ity >> 1,\n            growth_factor: 2.0,\n            capacity,\n            data: data_anon,\n            last_found_idx: 0,\n        }\n    }\n\n    fn id(&self) -> usize {\n        self.data.as_ptr() as usize\n    }\n\n    pub fn realloc_table(&mut self) -> bool {\n        let old_id = self.id();\n        let new_capacity = (self.growth_factor * self.capacity as f32) as u64;\n        let old_capacity = self.capacity;\n\n        // Collect old keys (in any order) before mutating\n        let mut old_keys: Vec<u64> = Vec::with_capacity(self.size as usize);\n        for i in 0..old_capacity as usize {\n            if self.data[i].key != 0 {\n                old_keys.push(self.data[i].key);\n            }\n        }\n\n        // Take ownership of old slice for later drop\n        let old_data_ptr: *mut [HashTableEntry<T>] = self.data as *mut [HashTableEntry<T>];\n\n        // Pull out the old key->ptr map (we'll re-key it under new_id)\n        let old_map: HashMap<u64, *mut Box<dyn Any>> = STORAGE.with(|s| {\n            s.borrow_mut().remove(&old_id).unwrap_or_default()\n        });\n\n        // Allocate new data\n        let mut entries: Vec<HashTableEntry<'static, T>> = Vec::with_capacity(new_capacity as usize);\n        for _ in 0..new_capacity {\n            entries.push(HashTableEntry {\n                key: 0,\n                val: empty_slice::<'static, T>(),\n            });\n        }\n        let leaked: &'static mut [HashTableEntry<'static, T>] =\n            Box::leak(entries.into_boxed_slice());\n        let new_id = leaked.as_ptr() as usize;\n\n        // Drop the old slice's heap memory\n        unsafe {\n            let _ = Box::from_raw(old_data_ptr);\n        }\n\n        // Replace data\n        let data_anon: &mut [HashTableEntry<T>] = unsafe { std::mem::transmute(leaked) };\n        self.data = data_anon;\n\n        self.size = 0;\n        self.max_size = (self.growth_factor * self.max_size as f32) as u64;\n        self.capacity = new_capacity;\n\n        // Set up new storage entry\n        STORAGE.with(|s| {\n            s.borrow_mut().insert(new_id, HashMap::new());\n        });\n\n        // Re-insert keys (the val ptrs get migrated to the new map)\n        for key in old_keys {\n            if let Some(&val_ptr) = old_map.get(&key) {\n                // Find empty slot for key, set key and update map\n                let mut idx = 0u64;\n                if self.find_entry(key, &mut idx) {\n                    // collision shouldn't happen\n                    return false;\n                }\n                self.data[idx as usize].key = key;\n                STORAGE.with(|s| {\n                    s.borrow_mut().get_mut(&new_id).unwrap().insert(key, val_ptr);\n                });\n                self.size += 1;\n            }\n        }\n\n        true\n    }\n\n    pub fn hash_table_find(&self, key: u64) -> Option<&Box<dyn std::any::Any>> {\n        let mut idx = 0u64;\n        if !self.find_entry(key, &mut idx) {\n            return None;\n        }\n        // Update last_found_idx via interior unsafe mutation (matching C semantics).\n        unsafe {\n            let s = self as *const Self as *mut Self;\n            (*s).last_found_idx = idx;\n        }\n        // Look up the value pointer in storage\n        let id = self.id();\n        let raw_ptr: *mut Box<dyn std::any::Any> = STORAGE.with(|s| {\n            s.borrow()\n                .get(&id)\n                .and_then(|m| m.get(&key))\n                .copied()\n                .unwrap_or(std::ptr::null_mut())\n        });\n        if raw_ptr.is_null() {\n            None\n        } else {\n            Some(unsafe { &*raw_ptr })\n        }\n    }\n\n    pub fn hash_table_delete(&mut self, key: u64) -> bool {\n        let mut idx = 0u64;\n        if !self.find_entry(key, &mut idx) {\n            return false;\n        }\n        if !self.handle_gap(idx) {\n            return false;\n        }\n        // Remove from storage and drop