sh_table_init(7);\n60\t    do_assert(ht->size == 0);\n61\t\n62\t    bool ok;\n63\t    int obj;\n64\t\n65\t    u64 nb_elems = (1<<20)+3;\n66\t    for (u64 i = 1; i <= nb_elems; i++) {\n67\t        do_assert(!hash_table_find(ht, i));\n68\t        ok = hash_table_insert(ht, i, (&obj)+i);\n69\t        do_assert(ok);\n70\t        void* val = hash_table_find(ht, i);\n71\t        do_assert(val != 0);\n72\t        do_assert(val == (&obj)+i);\n73\t    }\n74\t    do_assert(ht->size == nb_elems);\n75\t\n76\t    for (u64 i = 1; i <= nb_elems; i++) {\n77\t        do_assert(ht->size == nb_elems - i + 1);\n78\t        void* val = hash_table_find(ht, i);\n79\t        do_assert(val != 0);\n80\t        do_assert(val == (&obj)+i);\n81\t        bool ok = hash_table_delete_last_found(ht);\n82\t        do_assert(ok);\n83\t        do_assert(!hash_table_find(ht, i));\n84\t    }\n85\t    do_assert(ht->size == 0);\n86\t\n87\t    hash_table_free(ht);\n88\t\n89\t    printf(\"[TEST] ---  end  test_big() ---\\n\\n\");\n90\t}\n91\t\n92\tvoid test_alternate() {\n93\t    printf(\"[TEST] --- begin test_alternate() ---\\n\");\n94\t\n95\t    struct hash_table* ht = hash_table_init(7);\n96\t    do_assert(ht->size == 0);\n97\t\n98\t    bool ok;\n99\t    int obj;\n100\t\n101\t    // In block sizes of b=256, insert b elements and then delete b/2 of them\n102\t    // (those with an even key).\n103\t    const int block_size = 256;\n104\t    const int nb_iterations = 9999;\n105\t    int counter = 1;\n106\t    for (int outer = 0; outer < nb_iterations; outer++) {\n107\t        for (int i = 0; i < block_size; i++) {\n108\t            do_assert(!hash_table_find(ht, counter));\n109\t            ok = hash_table_insert(ht, counter, (&obj)+counter);\n110\t            do_assert(ok);\n111\t            void* val = hash_table_find(ht, counter);\n112\t            do_assert(val != 0);\n113\t            do_assert(val == (&obj)+counter);\n114\t            counter++;\n115\t        }\n116\t        for (int delcounter = counter - block_size; delcounter < counter; delcounter+=2) {\n117\t            void* val = hash_table_find(ht, delcounter);\n118\t            do_assert(val != 0);\n119\t            do_assert(val == (&obj)+delcounter);\n120\t            ok = hash_table_delete_last_found(ht);\n121\t            do_assert(ok);\n122\t            do_assert(!hash_table_find(ht, delcounter));\n123\t        }\n124\t    }\n125\t\n126\t    // Check that all even keys are deleted and all odd keys are present.\n127\t    printf(\"size=%lu counter=%i\\n\", ht->size, counter);\n128\t    for (int i = 1; i <= counter; i++) {\n129\t        if (i % 2 == 1) {\n130\t            // deleted\n131\t            do_assert(!hash_table_find(ht, i));\n132\t        } else {\n133\t            // present\n134\t            void* val = hash_table_find(ht, i);\n135\t            do_assert(val != 0);\n136\t            do_assert(val == (&obj)+i);\n137\t        }\n138\t    }\n139\t    do_assert((int)ht->size == counter/2);\n140\t\n141\t    printf(\"[TEST] ---  end  test_alternate() ---\\n\\n\");\n142\t}\n143\t\n144\tint main() {\n145\t    test_small();\n146\t    test_big();\n147\t    test_alternate();\n148\t}\n149\t"}]},"parent_tool_use_id":null,"session_id":"025155cd-f2e6-4bbc-9dad-dd419fd6e024","uuid":"f7372a6a-f985-462b-88fa-d07cee30f26a","timestamp":"2026-05-30T09:51:53.329Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-LkSWo2/project/c_src/test/test_hash.c","content":"\n#include \"test.h\"\n#include \"../src/trusted/hash.h\"\n\nvoid test_small() {\n    printf(\"[TEST] --- begin test_small() ---\\n\");\n\n    struct hash_table* ht = hash_table_init(7);\n    do_assert(ht->size == 0);\n    do_assert(ht->capacity == 1<<7);\n\n    bool ok;\n    int arr[128];\n    u64 cap = ht->capacity;\n    for (u64 i = 1; i <= 63; i++) {\n        ok = hash_table_insert(ht, i, arr+i);\n        do_assert(ok);\n        do_assert(ht->size == i);\n        do_assert(ht->capacity == cap);\n        do_assert(hash_table_find(ht, i) == arr+i);\n    }\n    do_assert(ht->size == 63);\n    do_assert(ht->capacity == 128);\n\n    for (u64 i = 1; i <= 63; i++) {\n        do_assert(hash_table_find(ht, i) == arr+i);\n    }\n\n    ok = hash_table_insert(ht, 64, arr+64);\n    do_assert(ok);\n    do_assert(ht->size == 64);\n    do_assert(ht->capacity == 128);\n\n    ok = hash_table_insert(ht, 65, arr+65);\n    do_assert(ok);\n    do_assert(ht->size == 65);\n    do_assert(ht->capacity == 256);\n\n    for (u64 i = 1; i <= 65; i++) {\n        if (i == 40) continue;\n        do_assert(hash_table_find(ht, i) == arr+i);\n        do_assert(hash_table_delete(ht, i));\n        do_assert(hash_table_find(ht, i) == 0);\n    }\n    do_assert(ht->size == 1);\n    do_assert(hash_table_find(ht, 40) == arr+40);\n    do_assert(hash_table_delete_last_found(ht));\n    do_assert(ht->size == 0);\n    do_assert(hash_table_find(ht, 40) == 0);\n\n    hash_table_free(ht);\n\n    printf(\"[TEST] ---  end  test_small() ---\\n\\n\");\n}\n\nvoid test_big() {\n    printf(\"[TEST] --- begin test_big() ---\\n\");\n\n    struct hash_table* ht = hash_table_init(7);\n    do_assert(ht->size == 0);\n\n    bool ok;\n    int obj;\n\n    u64 nb_elems = (1<<20)+3;\n    for (u64 i = 1; i <= nb_elems; i++) {\n        do_assert(!hash_table_find(ht, i));\n        ok = hash_table_insert(ht, i, (&obj)+i);\n        do_assert(ok);\n        void* val = hash_table_find(ht, i);\n        do_assert(val != 0);\n        do_assert(val == (&obj)+i);\n    }\n    do_assert(ht->size == nb_elems);\n\n    for (u64 i = 1; i <= nb_elems; i++) {\n        do_assert(ht->size == nb_elems - i + 1);\n        void* val = hash_table_find(ht, i);\n        do_assert(val != 0);\n        do_assert(val == (&obj)+i);\n        bool ok = hash_table_delete_last_found(ht);\n        do_assert(ok);\n        do_assert(!hash_table_find(ht, i));\n    }\n    do_assert(ht->size == 0);\n\n    hash_table_free(ht);\n\n    printf(\"[TEST] ---  end  test_big() ---\\n\\n\");\n}\n\nvoid test_alternate() {\n    printf(\"[TEST] --- begin test_alternate() ---\\n\");\n\n    struct hash_table* ht = hash_table_init(7);\n    do_assert(ht->size == 0);\n\n    bool ok;\n    int obj;\n\n    // In block sizes of b=256, insert b elements and then delete b/2 of them\n    // (those with an even key).\n    const int block_size = 256;\n    const int nb_iterations = 9999;\n    int counter = 1;\n    for (int outer = 0; outer < nb_iterations; outer++) {\n        for (int i = 0; i < block_size; i++) {\n            do_assert(!hash_table_find(ht, counter));\n            ok = hash_table_insert(ht, counter, (&obj)+counter);\n            do_assert(ok);\n            void* val = hash_table_find(ht, counter);\n            do_assert(val != 0);\n            do_assert(val == (&obj)+counter);\n            counter++;\n        }\n        for (int delcounter = counter - block_size; delcounter < counter; delcounter+=2) {\n            void* val = hash_table_find(ht, delcounter);\n            do_assert(val != 0);\n            do_assert(val == (&obj)+delcounter);\n            ok = hash_table_delete_last_found(ht);\n            do_assert(ok);\n            do_assert(!hash_table_find(ht, delcounter));\n        }\n    }\n\n    // Check that all even keys are deleted and all odd keys are present.\n    printf(\"size=%lu counter=%i\\n\", ht->size, counter);\n    for (int i = 1; i <= counter; i++) {\n        if (i % 2 == 1) {\n            // deleted\n            do_assert(!hash_table_find(ht, i));\n        } else {\n            // present\n            void* val = hash_table_find(ht, i);\n            do_assert(val != 0);\n            do_assert(val == (&obj)+i);\n        }\n    }\n    do_assert((int)ht->size == counter/2);\n\n    printf(\"[TEST] ---  end  test_alternate() ---\\n\\n\");\n}\n\nint main() {\n    test_small();\n    test_big();\n    test_alternate();\n}\n","numLines":149,"startLine":1,"totalLines":149}}}
