sh_table_free();\n62\tprintln!(\"[TEST] ---  end  test_small() ---\\n\");\n63\t}\n64\t\n65\t#[test]\n66\tfn test_big() {\n67\tprintln!(\"[TEST] --- begin test_big() ---\");\n68\tlet mut ht = hash::HashTable::<i32>::new(7);\n69\tdo_assert(ht.size == 0);\n70\tlet obj = 0;\n71\tlet nb_elems = (1 << 20) + 3;\n72\tfor i in 1..=nb_elems {\n73\tdo_assert(ht.hash_table_find(i).is_none());\n74\tlet ok = ht.hash_table_insert(i, Box::new(obj + i as i32));\n75\tdo_assert(ok);\n76\tlet val = ht.hash_table_find(i);\n77\tdo_assert(val.is_some());\n78\t}\n79\tdo_assert(ht.size == nb_elems);\n80\tfor i in 1..=nb_elems {\n81\tdo_assert(ht.size == nb_elems - i + 1);\n82\tlet val = ht.hash_table_find(i);\n83\tdo_assert(val.is_some());\n84\tlet ok = ht.hash_table_delete_last_found();\n85\tdo_assert(ok);\n86\tdo_assert(ht.hash_table_find(i).is_none());\n87\t}\n88\tdo_assert(ht.size == 0);\n89\tht.hash_table_free();\n90\tprintln!(\"[TEST] ---  end  test_big() ---\\n\");\n91\t}\n92\t\n93\t#[test]\n94\tfn test_alternate() {\n95\tprintln!(\"[TEST] --- begin test_alternate() ---\");\n96\tlet mut ht = hash::HashTable::<u64>::new(7);\n97\tdo_assert(ht.size == 0);\n98\tlet obj = 0;\n99\t\n100\tconst BLOCK_SIZE: u64 = 256;\n101\tconst NB_ITERATIONS: i32 = 9999;\n102\tlet mut counter = 1;\n103\tfor _ in 0..NB_ITERATIONS {\n104\tfor _ in 0..BLOCK_SIZE {\n105\tdo_assert(ht.hash_table_find(counter).is_none());\n106\tlet ok = ht.hash_table_insert(counter, Box::new(obj + counter));\n107\tdo_assert(ok);\n108\tlet val = ht.hash_table_find(counter);\n109\tdo_assert(val.is_some());\n110\tcounter += 1;\n111\t}\n112\tfor delcounter in (counter - BLOCK_SIZE..counter).step_by(2) {\n113\tlet val = ht.hash_table_find(delcounter);\n114\tdo_assert(val.is_some());\n115\tlet ok = ht.hash_table_delete_last_found();\n116\tdo_assert(ok);\n117\tdo_assert(ht.hash_table_find(delcounter).is_none());\n118\t}\n119\t}\n120\t\n121\tprintln!(\"size={} counter={}\", ht.size, counter);\n122\tfor i in 1..=counter {\n123\tif i % 2 