for the new emptied cell,\n101\t            // in the same way, until it terminates by reaching a cell that was already empty.\n102\t            i = j;\n103\t        }\n104\t    }\n105\t}\n106\t\n107\t\n108\t\n109\tstruct hash_table* hash_table_init(int log_init_capacity) {\n110\t    struct hash_table* ht = trusted_utils_malloc(sizeof(struct hash_table));\n111\t    ht->capacity = 1<<log_init_capacity;\n112\t    ht->size = 0;\n113\t    ht->max_size = (u64) (ht->capacity >> 1);\n114\t    ht->growth_factor = 2;\n115\t    ht->data = (struct hash_table_entry*) trusted_utils_calloc(ht->capacity, sizeof(struct hash_table_entry));\n116\t    return ht;\n117\t}\n118\t\n119\tvoid* hash_table_find(struct hash_table* ht, u64 key) {\n120\t    u64 idx;\n121\t    if (!find_entry(ht, key, &idx)) return 0;\n122\t    ht->last_found_idx = idx;\n123\t    assert(ht->data[idx].key == key);\n124\t    assert(ht->data[idx].val);\n125\t    return ht->data[idx].val;\n126\t}\n127\t\n128\tbool hash_table_insert(struct hash_table* ht, u64 key, void* val) {\n129\t    if (key == 0) return false; // key 0 is reserved!\n130\t\n131\t    if (ht->size == ht->max_size) {\n132\t        if (!realloc_table(ht)) return false; // no memory left\n133\t        if (ht->size >= ht->max_size)\n134\t            return false; // sth went very wrong during realloc\n135\t    }\n136\t\n137\t    u64 idx;\n138\t    if (find_entry(ht, key, &idx))\n139\t        return false; // found an element with this key!\n140\t    if (!cell_empty(&ht->data[idx]))\n141\t        return false; // table completely full - shouldn't happen!\n142\t    // idx now points to the empty position\n143\t\n144\t    struct hash_table_entry* entry = &ht->data[idx];\n145\t    entry->key = key;\n146\t    entry->val = val;\n147\t    ht->size++;\n148\t    return true;\n149\t}\n150\t\n151\tbool hash_table_delete(struct hash_table* ht, u64 key) {\n152\t    u64 idx;\n153\t    if (!find_entry(ht, key, &idx)) return false;\n154\t    if (!handle_gap(ht, idx)) r