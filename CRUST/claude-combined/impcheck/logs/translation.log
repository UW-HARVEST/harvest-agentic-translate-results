\n\npub fn trusted_utils_try_match_arg<'a>(arg: &'a str, opt: &str, out: &mut Option<&'a str>) {\n    if begins_with(arg, opt) {\n        *out = Some(&arg[opt.len()..]);\n    }\n}\n\npub fn trusted_utils_try_match_flag(arg: &str, opt: &str, out: &mut bool) {\n    if begins_with(arg, opt) {\n        *out = true;\n    }\n}\n\npub fn trusted_utils_copy_bytes(to: &mut [u8], from: &[u8], nb_bytes: u64) {\n    for i in 0..nb_bytes as usize {\n        to[i] = from[i];\n    }\n}\n\npub fn trusted_utils_equal_signatures(left: &[u8], right: &[u8]) -> bool {\n    for i in 0..SIG_SIZE_BYTES {\n        if left[i] != right[i] {\n            return false;\n        }\n    }\n    true\n}\n\npub fn trusted_utils_calloc<T: Default + Clone>(nb_objs: u64, _size_per_obj: u64) -> Vec<T> {\n    vec![T::default(); nb_objs as usize]\n}\n\npub fn trusted_utils_realloc<T: Default + Clone>(from: &mut [T], new_size: u64) -> Vec<T> {\n    let mut v: Vec<T> = Vec::with_capacity(new_size as usize);\n    let copy_len = std::cmp::min(from.len(), new_size as usize);\n    for i in 0..copy_len {\n        v.push(from[i].clone());\n    }\n    while v.len() < new_size as usize {\n        v.push(T::default());\n    }\n    v\n}\n\npub fn trusted_utils_read_bool(file: &mut File) -> bool {\n    let mut buf = [0u8; 1];\n    if file.read_exact(&mut buf).is_err() {\n        trusted_utils_exit_eof();\n    }\n    buf[0] != 0\n}\n\npub fn trusted_utils_read_char(file: &mut File) -> i32 {\n    let mut buf = [0u8; 1];\n    if file.read_exact(&mut buf).is_err() {\n        trusted_utils_exit_eof();\n    }\n    buf[0] as i32\n}\n\npub fn trusted_utils_read_objs(data: &mut [u8], _size: usize, _nb_objs: usize, file: &mut File) {\n    if file.read_exact(data).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_read_int(file: &mut File) -> i32 {\n    let mut buf = [0u8; 4];\n    if file.read_exact(&mut buf).is_err() {\n        trusted_utils_exit_eof();\n    }\n    i32::from_ne_bytes(buf)\n}\n\npub fn trusted_utils_read_ints(data: &mut [i32], nb_ints: u64, file: &mut File) {\n    let n = nb_ints as usize;\n    let mut bytes = vec![0u8; n * 4];\n    if file.read_exact(&mut bytes).is_err() {\n        trusted_utils_exit_eof();\n    }\n    for i in 0..n {\n        let arr: [u8; 4] = [bytes[4 * i], bytes[4 * i + 1], bytes[4 * i + 2], bytes[4 * i + 3]];\n        data[i] = i32::from_ne_bytes(arr);\n    }\n}\n\npub fn trusted_utils_read_ul(file: &mut File) -> u64 {\n    let mut buf = [0u8; 8];\n    if file.read_exact(&mut buf).is_err() {\n        trusted_utils_exit_eof();\n    }\n    u64::from_ne_bytes(buf)\n}\n\npub fn trusted_utils_read_uls(data: &mut [u64], nb_uls: u64, file: &mut File) {\n    let n = nb_uls as usize;\n    let mut bytes = vec![0u8; n * 8];\n    if file.read_exact(&mut bytes).is_err() {\n        trusted_utils_exit_eof();\n    }\n    for i in 0..n {\n        let mut arr = [0u8; 8];\n        arr.copy_from_slice(&bytes[8 * i..8 * (i + 1)]);\n        data[i] = u64::from_ne_bytes(arr);\n    }\n}\n\npub fn trusted_utils_read_sig(out_sig: &mut [u8], file: &mut File) {\n    // 4 ints = 16 bytes\n    if file.read_exact(&mut out_sig[..SIG_SIZE_BYTES]).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_write_bool(b: bool, file: &mut File) {\n    let v: u8 = if b { 1 } else { 0 };\n    if file.write_all(&[v]).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_write_char(c: char, file: &mut File) {\n    let v: u8 = c as u8;\n    if file.write_all(&[v]).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_write_int(i: i32, file: &mut File) {\n    if file.write_all(&i.to_ne_bytes()).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_write_ints(data: &[i32], nb_ints: u64, file: &mut File) {\n    let n = nb_ints as usize;\n    let mut bytes = Vec::with_capacity(n * 4);\n    for i in 0..n {\n        bytes.extend_from_slice(&data[i].to_ne_bytes());\n    }\n    if file.write_all(&bytes).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_write_ul(u: u64, file: &mut File) {\n    if file.write_all(&u.to_ne_bytes()).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_write_uls(data: &[u64], nb_uls: u64, file: &mut File) {\n    let n = nb_uls as usize;\n    let mut bytes = Vec::with_capacity(n * 8);\n    for i in 0..n {\n        bytes.extend_from_slice(&data[i].to_ne_bytes());\n    }\n    if file.write_all(&bytes).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_write_sig(sig: &[u8], file: &mut File) {\n    // 4 ints = 16 bytes\n    if file.write_all(&sig[..SIG_SIZE_BYTES]).is_err() {\n        trusted_utils_exit_eof();\n    }\n}\n\npub fn trusted_utils_sig_to_str(sig: &[u8], out: &mut String) {\n    out.clear();\n    for charpos in 0..SIG_SIZE_BYTES {\n        let val1 = (sig[charpos] >> 4) & 0x0f;\n        let val2 = sig[charpos] & 0x0f;\n        let c1 = if val1 >= 10 {\n            (b'a' + val1 - 10) as char\n        } else {\n            (b'0' + val1) as char\n        };\n        let c2 = if val2 >= 10 {\n            (b'a' + val2 - 10) as char\n        } else {\n            (b'0' + val2) as char\n        };\n        out.push(c1);\n        out.push(c2);\n    }\n}\n\npub fn trusted_utils_str_to_sig(s: &str, out: &mut [u8]) -> bool {\n    let bytes = s.as_bytes();\n    for bytepos in 0..SIG_SIZE_BYTES {\n        if bytes.len() < bytepos * 2 + 2 {\n            return false;\n        }\n        let hex1 = bytes[bytepos * 2] as char;\n        let hex2 = bytes[bytepos * 2 + 1] as char;\n        let n1 = if hex1 >= '0' && hex1 <= '9' {\n            hex1 as i32 - '0' as i32\n        } else {\n            10 + hex1 as i32 - 'a' as i32\n        };\n        let n2 = if hex2 >= '0' && hex2 <= '9' {\n            hex2 as i32 - '0' as i32\n        } else {\n            10 + hex2 as i32 - 'a' as i32\n        };\n        let byte = 16 * n1 + n2;\n        if !(0..256).contains(&byte) {\n            return false;\n        }\n        out[bytepos] = byte as u8;\n    }\n    true\n}\n","structuredPatch":[{"oldStart":194,"oldLines":9,"newStart":194,"newLines":16,"lines":[" "," pub fn trusted_utils_write_sig(sig: &[u8], file: &mut File) {","     // 4 ints = 16 bytes","-    if file.write_all(&sig[..SIG_SIZE_BYTES]).is_err() {","+    let n = std::cmp::min(sig.len(), SIG_SIZE_BYTES);","+    if file.write_all(&sig[..n]).is_err() {","         trusted_utils_exit_eof();","     }","+    if n < SIG_SIZE_BYTES {","+        let pad = vec![0u8; SIG_SIZE_BYTES - n];","+        if file.write_all(&pad).is_err() {","+            trusted_utils_exit_eof();","+        }","+    }"," }"," "," pub fn trusted_utils_sig_to_str(sig: &[u8], out: &mut String) {"]}],"userModified":false,"replaceAll":false}}
