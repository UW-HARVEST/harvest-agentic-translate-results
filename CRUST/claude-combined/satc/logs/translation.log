2\t  satc_response_t *response = satc_response_create();\n1263\t\n1264\t  bool result = satc_test_polygon_polygon(test_point, polygon, response);\n1265\t  if (result) result = response->a_in_b;\n1266\t\n1267\t  satc_response_destroy(response);\n1268\t  satc_polygon_destroy(test_point);\n1269\t\n1270\t  return result;\n1271\t}\n1272\t\n1273\t/**\n1274\t * Returns true if a circle overlaps with another circle.\n1275\t *\n1276\t * @param a a circle.\n1277\t * @param b another circle.\n1278\t * @param response a response representing the collision.\n1279\t * @return true if the circles overlap, false otherwise.\n1280\t */\n1281\tbool satc_test_circle_circle (satc_circle_t *a, satc_circle_t *b, satc_response_t *response) {\n1282\t  satc_point_alloca(difference_v);\n1283\t  satc_point_copy(difference_v, b->pos);\n1284\t  satc_point_sub(difference_v, a->pos);\n1285\t  double total_radius = a->r + b->r;\n1286\t  double total_radius_sq = total_radius * total_radius;\n1287\t  double distance_sq = satc_point_len2(difference_v);\n1288\t  if (distance_sq > total_radius_sq) return false;\n1289\t  if (response != NULL) {\n1290\t    double distance = sqrt(distance_sq);\n1291\t    response->a = a;\n1292\t    response->b = b;\n1293\t    response->overlap = total_radius - distance;\n1294\t    satc_point_normalize(difference_v);\n1295\t    satc_point_copy(response->overlap_n, difference_v);\n1296\t    satc_point_scale_x(difference_v, response->overlap);\n1297\t    satc_point_copy(response->overlap_v, difference_v);\n1298\t    response->a_in_b = (a->r <= b->r) && (distance <= b->r - a->r);\n1299\t    response->b_in_a = (b->r <= a->r) && (distance <= a->r - b->r);\n1300\t  }\n1301\t\n1302\t  return true;\n1303\t}\n1304\t\n1305\t/**\n1306\t * Checks to see if one polygon and one circle are overlapping.\n1307\t *\n1308\t * @param polygon a polygon.\n1309\t * @param circle a circle.\n1310\t * @param response the response object to set with collision data.\n1311\t */\n1312\tbool satc_test_polygon_circle (satc_polygon_t *polygon, satc_circle_t *circle, satc_response_t *response) {\n1313\t  satc_point_alloca(circle_pos);\n1314\t  satc_point_copy(circle_pos, circle->pos);\n1315\t  satc_point_sub(circle_pos, polygon->pos);\n1316\t  double radius = circle->r;\n1317\t  double radius2 = radius * radius;\n1318\t  double **points = polygon->calc_points;\n1319\t  size_t len = polygon->num_calc_points;\n1320\t  satc_point_alloca(edge);\n1321\t  satc_point_alloca(point);\n1322\t\n1323\t  size_t i = 0;\n1324\t  for (; i < len; i++) {\n1325\t    size_t next = (i == len - 1) ? 0 : i + 1;\n1326\t    size_t prev = (i == 0) ? len - 1 : i - 1;\n1327\t    double overlap = 0.0;\n1328\t    double *overlap_n = NULL;\n1329\t\n1330\t    satc_point_copy(edge, polygon->edges[i]);\n1331\t    satc_point_copy(point, circle_pos);\n1332\t    satc_point_sub(point, points[i]);\n1333\t\n1334\t    if (response != NULL && satc_point_len2(point) > radius2) {\n1335\t      response->a_in_b = false;\n1336\t    }\n1337\t\n1338\t    int region = satc_voronoi_region(edge, point);\n1339\t    if (region == SATC_LEFT_VORONOI_REGION) {\n1340\t      satc_point_copy(edge, polygon->edges[prev]);\n1341\t      satc_point_alloca(point2);\n1342\t      satc_point_copy(point2, circle_pos);\n1343\t      satc_point_sub(point2, points[prev]);\n1344\t      region = satc_voronoi_region(edge, point2);\n1345\t      if (region == SATC_RIGHT_VORONOI_REGION) {\n1346\t        double dist = satc_point_len(point);\n1347\t        if (dist > radius) {\n1348\t          return false;\n1349\t        } else if (response != NULL) {\n1350\t          response->b_in_a = false;\n1351\t          satc_point_normalize(point);\n1352\t          overlap_n = point;\n1353\t          overlap = radius - dist;\n1354\t        }\n1355\t      }\n1356\t    } else if (region == SATC_RIGHT_VORONOI_REGION) {\n1357\t      satc_point_copy(edge, polygon->edges[next]);\n1358\t      satc_point_copy(point, circle_pos);\n1359\t      satc_point_sub(point, points[next]);\n1360\t      region = satc_voronoi_region(edge, point);\n1361\t      if (region == SATC_LEFT_VORONOI_REGION) {\n1362\t        double dist = satc_point_len(point);\n1363\t        if (dist > radius) {\n1364\t          return false;\n1365\t        } else if (response != NULL) {\n1366\t          response->b_in_a = false;\n1367\t          satc_point_normalize(point);\n1368\t          overlap_n = point;\n1369\t          overlap = radius - dist;\n1370\t        }\n1371\t      }\n1372\t    } else {\n1373\t      satc_point_alloca(normal);\n1374\t      satc_point_perp(edge);\n1375\t      satc_point_normalize(edge);\n1376\t      satc_point_copy(normal, edge);\n1377\t      double dist = satc_point_dot(point, normal);\n1378\t      double dist_abs = fabs(dist);\n1379\t      if (dist > 0.0 && dist_abs > radius) {\n1380\t        return false;\n1381\t      } else {\n1382\t        overlap_n = normal;\n1383\t        overlap = radius - dist;\n1384\t        if (dist >= 0.0 || overlap < 2.0 * radius) {\n1385\t          response->b_in_a = false;\n1386\t        }\n1387\t      }\n1388\t    }\n1389\t\n1390\t    if (overlap_n != NULL && response != NULL && fabs(overlap) < fabs(response->overlap)) {\n1391\t      response->overlap = overlap;\n1392\t      satc_point_copy(response->overlap_n, overlap_n);\n1393\t    }\n1394\t  }\n1395\t\n1396\t  if (response != NULL) {\n1397\t    response->a = polygon;\n1398\t    response->b = circle;\n1399\t    satc_point_copy(response->overlap_v, response->overlap_n);\n1400\t    satc_point_scale_x(response->overlap_v, response->overlap);\n1401\t  }\n1402\t\n1403\t  return true;\n1404\t}\n1405\t\n1406\t/**\n1407\t * Checks to see if one circle and one polygon are overlapping.\n1408\t *\n1409\t * This is ever so slightly more expensive than `satc_test_polygon_circle`,\n1410\t * since the response data needs to be flipped after checking collision.\n1411\t *\n1412\t * @param circle a circle.\n1413\t * @param polygon a polygon.\n1414\t * @param response the response object to set with collision data.\n1415\t */\n1416\tbool satc_test_circle_polygon (satc_circle_t *circle, satc_polygon_t *polygon, satc_response_t *response) {\n1417\t  bool result = satc_test_polygon_circle(polygon, circle, response);\n1418\t  if (result && response != NULL) {\n1419\t    void *a = response->a;\n1420\t    bool a_in_b = response->a_in_b;\n1421\t    satc_point_reverse(response->overlap_n);\n1422\t    satc_point_reverse(response->overlap_v);\n1423\t    response->a = response->b;\n1424\t    response->b = a;\n1425\t    response->a_in_b = response->b_in_a;\n1426\t    response->b_in_a = a_in_b;\n1427\t  }\n1428\t\n1429\t  return result;\n1430\t}\n1431\t\n1432\t/**\n1433\t * Checks to see if one polygon and another are overlapping.\n1434\t *\n1435\t * @param a a polygon.\n1436\t * @param b another polygon.\n1437\t * @param response the response object to set with collision data.\n1438\t */\n1439\tbool satc_test_polygon_polygon (satc_polygon_t *a, satc_polygon_t *b, satc_response_t *response) {\n1440\t  double **a_points = a->points;\n1441\t  size_t a_len = a->num_points;\n1442\t  double **b_points = b->points;\n1443\t  size_t b_len = b->num_points;\n1444\t\n1445\t  size_t i = 0;\n1446\t  for (; i < a_len; i++) {\n1447\t    if (satc_is_separating_axis(a->pos, b->pos, a_len, a_points, b_len, b_points, a->normals[i], response)) {\n1448\t      return false;\n1449\t    }\n1450\t  }\n1451\t\n1452\t  i = 0;\n1453\t  for (; i < b_len; i++) {\n1454\t    if (satc_is_separating_axis(a->pos, b->pos, a_len, a_points, b_len, b_points, b->normals[i], response)) {\n1455\t      return false;\n1456\t    }\n1457\t  }\n1458\t\n1459\t  if (response != NULL) {\n1460\t    response->a = a;\n1461\t    response->b = b;\n1462\t    satc_point_copy(response->overlap_v, response->overlap_n);\n1463\t    satc_point_scale_x(response->overlap_v, response->overlap);\n1464\t  }\n1465\t\n1466\t  return true;\n1467\t}\n1468\t\n1469\t#endif\n1470\t"}]},"parent_tool_use_id":null,"se