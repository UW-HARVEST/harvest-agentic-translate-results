{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_016A8xUmrV87kKu5sgxaM1dr","type":"tool_result","content":"1\t/**\n2\t * `murmurhash.c' - murmurhash\n3\t *\n4\t * copyright (c) 2014-2025 joseph werle <joseph.werle@gmail.com>\n5\t */\n6\t#include <stdlib.h>\n7\t#include <stdio.h>\n8\t#include <stdint.h>\n9\t#include \"murmurhash.h\"\n10\t\n11\t#if MURMURHASH_WANTS_HTOLE32\n12\t#define MURMURHASH_HAS_HTOLE32 1\n13\t#ifndef htole32\n14\tstatic uint32_t htole32 (uint32_t value) {\n15\t#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n16\t  value = (\n17\t    ((value & 0xFF000000) >> 24) |\n18\t    ((value & 0x00FF0000) >> 8)  |\n19\t    ((value & 0x0000FF00) << 8)  |\n20\t    ((value & 0x000000FF) << 24)\n21\t  );\n22\t#endif\n23\t  return value;\n24\t}\n25\t#endif\n26\t#endif\n27\t\n28\tuint32_t murmurhash (const char *key, uint32_t len, uint32_t seed) {\n29\t  uint32_t c1 = 0xcc9e2d51;\n30\t  uint32_t c2 = 0x1b873593;\n31\t  uint32_t r1 = 15;\n32\t  uint32_t r2 = 13;\n33\t  uint32_t m = 5;\n34\t  uint32_t n = 0xe6546b64;\n35\t  uint32_t h = 0;\n36\t  uint32_t k = 0;\n37\t  uint8_t *d = (uint8_t *) key; // 32 bit extract from `key'\n38\t  const uint32_t *chunks = NULL;\n39\t  const uint8_t *tail = NULL; // tail - last 8 bytes\n40\t  int i = 0;\n41\t  int l = len / 4; // chunk length\n42\t\n43\t  h = seed;\n44\t\n45\t  chunks = (const uint32_t *) (d + l * 4); // body\n46\t  tail = (const uint8_t *) (d + l * 4); // last 8 byte chunk of `key'\n47\t\n48\t  // for each 4 byte chunk of `key'\n49\t  for (i = -l; i != 0; ++i) {\n50\t    // next 4 byte chunk of `key'\n51\t  #if MURMURHASH_HAS_HTOLE32\n52\t    k = htole32(chunks[i]);\n53\t  #else\n54\t    k = chunks[i];\n55\t  #endif\n56\t\n57\t    // encode next 4 byte chunk of `key'\n58\t    k *= c1;\n59\t    k = (k << r1) | (k >> (32 - r1));\n60\t    k *= c2;\n61\t\n62\t    // append to hash\n63\t    h ^= k;\n64\t    h = (h << r2) | (h >> (32 - r2));\n65\t    h = h * m + n;\n66\t  }\n67\t\n68\t  k = 0;\n69\t\n70\t  // remainder\n71\t  switch (len & 3) { // `len % 4'\n72\t    case 3: k ^= (tail[2] << 16);\n73\t    case 2: k ^= (tail[1] << 8);\n74\t\n75\t    case 1:\n76\t      k ^= tail[0];\n77\t      k *= c1;\n78\t      k = (k << r1) | (k >> (32 - r1));\n79\t      k *= c2;\n80\t      h ^= k;\n81\t  }\n82\t\n83\t  h ^= len;\n84\t\n85\t  h ^= (h >> 16);\n86\t  h *= 0x85ebca6b;\n87\t  h ^= (h >> 13);\n88\t  h *= 0xc2b2ae35;\n89\t  h ^= (h >> 16);\n90\t\n91\t  return h;\n92\t}\n93\t"}]},"parent_tool_use_id":null,"session_id":"c89886be-f43b-44e4-b25b-c5d118e0562a","uuid":"7934510d-0f35-4eb5-91a7-c69a333dda43","timestamp":"2026-05-30T10:13:47.446Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/harvest-crust-GA1tua/project/c_src/murmurhash.c","content":"/**\n * `murmurhash.c' - murmurhash\n *\n * copyright (c) 2014-2025 joseph werle <joseph.werle@gmail.com>\n */\n#include <stdlib.h>\n#include <stdio.h>\n#include <stdint.h>\n#include \"murmurhash.h\"\n\n#if MURMURHASH_WANTS_HTOLE32\n#define MURMURHASH_HAS_HTOLE32 1\n#ifndef htole32\nstatic uint32_t htole32 (uint32_t value) {\n#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__\n  value = (\n    ((value & 0xFF000000) >> 24) |\n    ((value & 0x00FF0000) >> 8)  |\n    ((value & 0x0000FF00) << 8)  |\n    ((value & 0x000000FF) << 24)\n  );\n#endif\n  return value;\n}\n#endif\n#endif\n\nuint32_t murmurhash (const char *key, uint32_t len, uint32_t seed) {\n  uint32_t c1 = 0xcc9e2d51;\n  uint32_t c2 = 0x1b873593;\n  uint32_t r1 = 15;\n  uint32_t r2 = 13;\n  uint32_t m = 5;\n  uint32_t n = 0xe6546b64;\n  uint32_t h = 0;\n  uint32_t k = 0;\n  uint8_t *d = (uint8_t *) key; // 32 bit extract from `key'\n  const uint32_t *chunks = NULL;\n  const uint8_t *tail = NULL; // tail - last 8 bytes\n  int i = 0;\n  int l = len / 4; // chunk length\n\n  h = seed;\n\n  chunks = (const uint32_t *) (d + l * 4); // body\n  tail = (const uint8_t *) (d + l * 4); // last 8 byte chunk of `key'\n\n  // for each 4 byte chunk of `key'\n  for (i = -l; i != 0; ++i) {\n    // next 4 byte chunk of `key'\n  #if MURMURHASH_HAS_HTOLE32\n    k = htole32(chunks[i]);\n  #else\n    k = chunks[i];\n  #endif\n\n    // encode next 4 byte chunk of `key'\n    k *= c1;\n    k = (k << r1) | (k >> (32 - r1));\n    k *= c2;\n\n    // append to hash\n    h ^= k;\n    h = (h << r2) | (h >> (32 - r2));\n    h = h * m + n;\n  }\n\n  k = 0;\n\n  // remainder\n  switch (len & 3) { // `len % 4'\n    case 3: k ^= (tail[2] << 16);\n    case 2: k ^= (tail[1] << 8);\n\n    case 1:\n      k ^= tail[0];\n      k *= c1;\n      k = (k << r1) | (k >> (32 - r1));\n      k *= c2;\n      h ^= k;\n  }\n\n  h ^= len;\n\n  h ^= (h >> 16);\n  h *= 0x85ebca6b;\n  h ^= (h >> 13);\n  h *= 0xc2b2ae35;\n  h ^= (h >> 16);\n\n  return h;\n}\n","numLines":93,"startLine":1,"totalLines":93}}}
