4]\n    //     -> w[8..24] = key[0..16]\n    //   Store 4 (offset 12): w[12..28] = key[0..16]\n    //     -> w[0..4] = key[0..4]\n    //     -> w[4..8] = key[0..4]\n    //     -> w[8..12] = key[0..4]\n    //     -> w[12..28] = key[0..16]\n    // So after init: w[0..4]=key[0..4], w[4..8]=key[0..4], w[8..12]=key[0..4],\n    //                w[12..28]=key[0..16] (= key followed by overflow).\n    //\n    // Now, the standard AES key expansion only relies on w[0..16] = key.\n    // The expansion loop reads w[4*(i-1)..4*(i-1)+16] (16 bytes, but only\n    // uses the first 4) and w[4*(i-Nk)..4*(i-Nk)+16] (using only first 4).\n    //\n    // Then the loop overwrites w[4*i..4*i+16] which writes 16 bytes but the\n    // intent is just w[4*i..4*i+4]. The fact that the stores overlap means\n    // each iteration's store overwrites previously written bytes.\n    //\n    // Let's simulate the byte-level behavior exactly.\n\n    // Initial fill of w[0..28] from the four overlapping stores:\n    // Effectively w[0..4] = key[0..4]\n    //             w[4..8] = key[0..4]\n    //             w[8..12] = key[0..4]\n    //             w[12..28] = key[0..16]\n    // But more carefully: only key[0..16] is loaded as `temp`.\n    // We need to write w[0..16] from store 1 with key[0..16] first.\n    // Since we'll be overwriting these with the proper expansion later,\n    // we need to faithfully simulate the byte ordering.\n\n    // To match the C exactly, perform the four stores in order\n    let mut temp_buf = [0u8; 16];\n    temp_buf.copy_from_slice(&key[..]);\n    // Store at offset 0\n    w[0..16].copy_from_slice(&temp_buf);\n    // Store at offset 4\n    w[4..20].copy_from_slice(&temp_buf);\n    // Store at offset 8\n    w[8..24].copy_from_slice(&temp_buf);\n    // Store at offset 12\n    w[12..28].copy_from_slice(&temp_buf);\n\n    let mut i: usize = NK;\n    while i < NB * (NR + 1) {\n        // Read 16-byte temp from w[4*(i-1) .. 4*(i-1)+16]\n        let base = 4 * (i - 1);\n        let mut temp = [0u8; 16];\n        for k in 0..16 {\n            // Be safe: in case base+k goes beyond w length, but the C does the\n            // same and will be in range because of the initial pre-fill of w[0..28].\n            if base + k < w.len() {\n                temp[k] = w[base + k];\n            }\n        }\n\n        if i % NK == 0 {\n            // _mm_shuffle_epi32(temp, _MM_SHUFFLE(3, 0, 1, 2)):\n            // Rearranges 4 32-bit lanes. Original lanes [L0, L1, L2, L3] -> [L2, L1, L0, L3]\n            // because _MM_SHUFFLE(3, 0, 1, 2) means dest[0]=src[2], dest[1]=src[1],\n            // dest[2]=src[0], dest[3]=src[3].\n            let mut shuffled = [0u8; 16];\n            // lane 0 (bytes 0..4) = src lane 2 (bytes 8..12)\n            shuffled[0..4].copy_from_slice(&temp[8..12]);\n            // lane 1 (bytes 4..8) = src lane 1 (bytes 4..8)\n            shuffled[4..8].copy_from_slice(&temp[4..8]);\n            // lane 2 (bytes 8..12) = src lane 0 (bytes 0..4)\n            shuffled[8..12].copy_from_slice(&temp[0..4]);\n            // lane 3 (bytes 12..16) = src lane 3 (bytes 12..16)\n            shuffled[12..16].copy_from_slice(&temp[12..16]);\n\n            // Apply sbox to first 4 bytes\n            for j in 0..4 {\n                shuffled[j] = SBOX[shuffled[j] as usize];\n            }\n            // XOR Rcon[i / NK] into byte 0\n            shuffled[0] ^= RCON[i / NK];\n            temp = shuffled;\n        }\n        // Note: For NK=4, the second branch (Nk > 6) is never taken, so we skip it.\n\n        // XOR with w_i_Nk = w[4*(i-Nk) .. 4*(i-Nk)+16]\n        let xor_base = 4 * (i - NK);\n        let mut w_i_nk = [0u8; 16];\n        for k in 0..16 {\n            if xor_base + k < w.len() {\n                w_i_nk[k] = w[xor_base + k];\n            }\n        }\n        for k in 0..16 {\n            temp[k] ^= w_i_nk[k];\n        }\n\n        // Store back at w[4*i .. 4*i + 16] (16-byte store, may go past array end)\n        let store_ba