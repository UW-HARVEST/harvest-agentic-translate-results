nion::Variable(ref v) = node.node {\n                append_to_buffer(buffer, \"(\");\n                append_to_buffer(buffer, &v.name);\n                if !v.type_.is_empty() {\n                    append_to_buffer(buffer, \" : \");\n                    append_to_buffer(buffer, &v.type_);\n                }\n                append_to_buffer(buffer, \") \");\n            }\n        }\n        AstNodeType::DEFINITION => {\n            if let AstNodeUnion::Variable(ref v) = node.node {\n                append_to_buffer(buffer, \"(\");\n                append_to_buffer(buffer, &v.name);\n                append_to_buffer(buffer, \") \");\n            }\n        }\n    }\n}\n\npub fn ast_to_string(node: &AstNode) -> String {\n    let mut buffer = String::new();\n    append_ast_to_buffer(&mut buffer, node);\n    buffer\n}\n","structuredPatch":[{"oldStart":1,"oldLines":6,"newStart":1,"newLines":8,"lines":[" use std::fmt;","-#[derive(Debug, PartialEq, Eq)]","-pub enum tokens_t{","+use std::sync::atomic::{AtomicBool, Ordering};","+","+#[derive(Debug, PartialEq, Eq, Clone)]","+pub enum tokens_t {","     L_PAREN,","     R_PAREN,","     LAMBDA,"]},{"oldStart":12,"oldLines":67,"newStart":14,"newLines":145,"lines":["     EQ,","     QUOTE,","     COLON,","-} ","-#[derive(Debug, PartialEq, Eq)]","+}","+","+#[derive(Debug, PartialEq, Eq, Clone)]"," pub enum AstNodeType {","-LAMBDA_EXPR,","-APPLICATION,","-VAR,","-DEFINITION,","+    LAMBDA_EXPR,","+    APPLICATION,","+    VAR,","+    DEFINITION,"," }","-#[derive(Debug)]","+","+#[derive(Debug, Clone)]"," pub struct LambdaExpression {","-pub parameter: String,","-pub type_: String,","-pub body: Option<Box<AstNode>>,","+    pub parameter: String,","+    pub type_: String,","+    pub body: Option<Box<AstNode>>,"," }","-#[derive(Debug)]","+","+#[derive(Debug, Clone)]"," pub struct Application {","-pub function: Option<Box<AstNode>>,","-pub argument: Option<Box<AstNode>>,","+    pub function: Option<Box<AstNode>>,","+    pub argument: Op