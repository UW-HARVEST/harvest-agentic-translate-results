!()","+    let next_token = cio::next(in_).unwrap_or('\\u{FFFF}');","+    let n = parse_token(next_token);","+    if n != common::tokens_t::WHITESPACE {","+        expect(\" \", next_token);","+    }","+","+    let next_token = peek(in_);","+    let n = parse_token(next_token);","+    if n != common::tokens_t::VARIABLE {","+        expect(\"a type definition\", next_token);","+    }","+","+    if !is_uppercase(next_token) {","+        eprintln!(\"Type names must start with an uppercase letter\");","+        std::process::exit(1);","+    }","+","+    let type_name = parse_variable(in_);","+    if types_table.table_exists(&type_name) {","+        eprintln!(\"Type {} was already defined.\", type_name);","+        std::process::exit(1);","+    }","+    types_table.insert(&type_name, AstNode::default());"," }","+"," pub fn parse_type(types_table: &mut hash_table::HashTable, in_: &mut File) -> String {","-unimplemented!()","+    let token = cio::next(in_).unwrap_or('\\u{FFFF}');","+    if !is_uppercase(token) {","+        eprintln!(\"Types should start with an uppercase letter.\");","+        std::process::exit(1);","+    }","+    let mut type_name = String::new();","+    type_name.push(token);","+","+    while is_variable(peek(in_)) {","+        type_name.push(cio::next(in_).unwrap_or('\\u{FFFF}'));","+    }","+","+    if !types_table.table_exists(&type_name) {","+        eprintln!(\"Type {} was not defined.\", type_name);","+        std::process::exit(1);","+    }","+    type_name"," }","+"," pub fn parse_variable(in_: &mut File) -> String {","-unimplemented!()","+    let mut variable_name = String::new();","+    while is_variable(peek(in_)) {","+        variable_name.push(cio::next(in_).unwrap_or('\\u{FFFF}'));","+    }","+    variable_name"," }","+"," pub fn expect(expected: &str, received: char) {","-unimplemented!()","+    println!(\"Syntax Error: Expected {} , received {} \", expected, received);","+    std::process::exit(1);"," }","-pub fn free_ast(node: &mut comm