   }","+","+    while p < 0 {","+        *len = outchar(s, *len, n, ' ');","+        p += 1;","+    }","+}","+","+// Internal width-aware integer formatter.","+fn fmtint_internal(","+    s: &mut String,","+    len: &mut usize,","+    n: usize,","+    value: i128,","+    base: u32,","+    width: usize,","+    precision: i32,","+    flags: i32,","+) {","+    let unsigned = flags & PRINT_F_UNSIGNED != 0;","+    let mut sign: char = '\\0';","+    let uvalue: u128 = if unsigned {","+        value as u128","+    } else if value < 0 {","+        sign = '-';","+        (-value) as u128","+    } else {","+        if flags & PRINT_F_PLUS != 0 {","+            sign = '+';","+        } else if flags & PRINT_F_SPACE != 0 {","+            sign = ' ';","+        }","+        value as u128","+    };","+","+    let mut digits = String::new();","+    convert_internal(uvalue, &mut digits, base as usize, (flags & PRINT_F_UP) != 0);","+    // `digits` is in reverse-of-output order? `convert_internal` mirrors the","+    // C `convert` function which produces digits least-significant-first.","+    // We'll reverse here for printing.","+    let pos = digits.chars().count() as i32;","+","+    let mut hexprefix: char = '\\0';","+    if flags & PRINT_F_NUM != 0 && uvalue != 0 {","+        match base {","+            8 => {","+                // Increase precision so the leading digit is 0.","+                // Handled below in zpad calc.","+            }","+            16 => {","+                hexprefix = if flags & PRINT_F_UP != 0 { 'X' } else { 'x' };","+            }","+            _ => {}","+        }","+    }","+","+    let mut effective_precision = precision;","+    if base == 8 && flags & PRINT_F_NUM != 0 && uvalue != 0 {","+        if effective_precision <= pos {","+            effective_precision = pos + 1;","+        }","+    }","+","+    let noprecision = precision < 0;","+    let mut zpadlen = if effective_precision >= 0 {","+        effective_precision - pos","+    } else {","