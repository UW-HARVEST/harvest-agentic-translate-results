\n57\t        for i in 0..SLAB_SIZE {\n58\t            let undo = PacketSlabUndo {\n59\t                position: i,\n60\t                old_packet: packets[i],\n61\t            };\n62\t            packets[i] = lzma_packet::LZMAPacket::short_rep_packet();\n63\t            undo_stack.insert(undo);\n64\t        }\n65\t    }\n66\t    // Do not apply undos.\n67\t    for packet in slab.packets().iter() {\n68\t        assert_eq!(\n69\t            packet.packet_type,\n70\t            LZMAPacketType::ShortRep,\n71\t            \"Packet edit was not applied!\"\n72\t        );\n73\t    }\n74\t    // (Memory will be dropped automatically.)\n75\t}\n76\tpub fn main(){}"}]},"parent_tool_use_id":null,"session_id":"bc62d35f-ac13-4729-acd7-de81393232ed","uuid":"67b0cb1e-1558-48c8-aa39-83a48fb94473","timestamp":"2026-06-01T19:27:11.501Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-Lw8L5w/project/src/bin/packet_slab_undo_stack_test.rs","content":"use Megalania::lzma_packet;\nuse Megalania::lzma_packet::LZMAPacketType;\nuse Megalania::{\n    packet_slab::PacketSlab,\n    packet_slab_undo_stack::{PacketSlabUndo, PacketSlabUndoStack},\n};\npub fn pretty_print_test_name(name: &str) {\n    println!(\"=== {} ===\", name);\n}\npub fn pretty_print_sub_test_name(name: &str) {\n    println!(\"> {}\", name);\n}\nconst SLAB_SIZE: usize = 1024;\n\n#[test]\nfn packet_slab_undo_stack_test_apply() {\n    pretty_print_sub_test_name(\"packet_slab_undo_stack_test_apply\");\n    let mut slab = PacketSlab::new(SLAB_SIZE);\n    let mut undo_stack = PacketSlabUndoStack::new();\n\n    {\n        let packets = slab.packets();\n        for i in 0..SLAB_SIZE {\n            let undo = PacketSlabUndo {\n                position: i,\n                old_packet: packets[i],\n            };\n            // change the packet to short rep.\n            packets[i] = lzma_packet::LZMAPacket::short_rep_packet();\n            undo_stack.insert(undo);\n        }\n    }\n    // Apply undos.\n    undo_stack.apply(&mut slab);\n    for packet in slab.packets().iter() {\n        assert_eq!(\n            packet.packet_type,\n            LZMAPacketType::Literal,\n            \"Packet edit was not undone!\"\n        );\n    }\n    assert_eq!(\n        undo_stack.count(),\n        0,\n        \"Undo stack count nonzero after apply\"\n    );\n}\n\n#[test]\nfn packet_slab_undo_stack_test_free() {\n    pretty_print_sub_test_name(\"packet_slab_undo_stack_test_free\");\n    let mut slab = PacketSlab::new(SLAB_SIZE);\n    let mut undo_stack = PacketSlabUndoStack::new();\n\n    {\n        let packets = slab.packets();\n        for i in 0..SLAB_SIZE {\n            let undo = PacketSlabUndo {\n                position: i,\n                old_packet: packets[i],\n            };\n            packets[i] = lzma_packet::LZMAPacket::short_rep_packet();\n            undo_stack.insert(undo);\n        }\n    }\n    // Do not apply undos.\n    for packet in slab.packets().iter() {\n        assert_eq!(\n            packet.packet_type,\n            LZMAPacketType::ShortRep,\n            \"Packet edit was not applied!\"\n        );\n    }\n    // (Memory will be dropped automatically.)\n}\npub fn main(){}","numLines":76,"startLine":1,"totalLines":76}}}
