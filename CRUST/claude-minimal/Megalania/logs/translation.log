{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EfQKsoCo2JAix8E5G3YAvm","type":"tool_result","content":"1\t#include \"top_k_packet_finder.h\"\n2\t#include \"perplexity_encoder.h\"\n3\t#include \"lzma_packet_encoder.h\"\n4\t#include \"max_heap.h\"\n5\t#include <stdlib.h>\n6\t#include <assert.h>\n7\t\n8\ttypedef struct {\n9\t\tLZMAPacket packet;\n10\t\tfloat cost;\n11\t} TopKEntry;\n12\t\n13\tstruct TopKPacketFinder_struct {\n14\t\tsize_t size;\n15\t\tTopKEntry* entries;\n16\t\tLZMAPacket* next_packets;\n17\t\tMaxHeap* heap;\n18\t\tconst PacketEnumerator* packet_enumerator;\n19\t};\n20\t\n21\tstatic int sign(float x)\n22\t{\n23\t\tif (x < 0.f) return -1;\n24\t\tif (x > 0.f) return 1;\n25\t\treturn 0;\n26\t}\n27\t\n28\tstatic int top_k_entry_comparator(void* user_data, unsigned a, unsigned b)\n29\t{\n30\t\tTopKPacketFinder* finder = (TopKPacketFinder*) user_data;\n31\t\tassert(a < finder->size);\n32\t\tassert(b < finder->size);\n33\t\tTopKEntry* entry_a = &finder->entries[a];\n34\t\tTopKEntry* entry_b = &finder->entries[b];\n35\t\treturn sign(entry_a->cost - entry_b->cost);\n36\t}\n37\t\n38\tTopKPacketFinder* top_k_packet_finder_new(size_t size, const PacketEnumerator* packet_enumerator)\n39\t{\n40\t\tTopKPacketFinder* finder = malloc(sizeof(TopKPacketFinder));\n41\t\tif (finder == NULL) {\n42\t\t\treturn NULL;\n43\t\t}\n44\t\tfinder->size = size;\n45\t\tfinder->packet_enumerator = packet_enumerator;\n46\t\tfinder->entries = malloc(sizeof(TopKEntry) * size);\n47\t\tif (finder->entries == NULL) {\n48\t\t\tfree(finder);\n49\t\t\treturn NULL;\n50\t\t}\n51\t\tfinder->heap = max_heap_new(size, top_k_entry_comparator, finder);\n52\t\tif (finder->heap == NULL) {\n53\t\t\tfree(finder->entries);\n54\t\t\tfree(finder);\n55\t\t\treturn NULL;\n56\t\t}\n57\t\treturn finder;\n58\t}\n59\t\n60\tvoid top_k_packet_finder_free(TopKPacketFinder* finder)\n61\t{\n62\t\tmax_heap_free(finder->heap);\n63\t\tfree(finder->entries);\n64\t\tfree(finder);\n65\t}\n66\t\n67\tsize_t top_k_packet_finder_count(const TopKPacketFinder* finder)\n68\t{\n69\t\treturn max_heap_count(finder->heap);\n70\t}\n71\t\n72\tstatic void top_k_entry_finder_insert(TopKPacketFinder* finder, TopKEntry entry)\n73\t{\n74\t\tsize_t count = top_k_packet_finder_count(finder);\n75\t\n76\t\t//if there is room, just insert\n77\t\tif (count < finder->size) {\n78\t\t\tsize_t pos = count++;\n79\t\t\tfinder->entries[pos] = entry;\n80\t\t\tmax_heap_insert(finder->heap, pos);\n81\t\t\treturn;\n82\t\t}\n83\t\n84\t\t//otherwise, we must compare with the maximum and replace if needed\n85\t\tunsigned maximum = 0;\n86\t\tbool had_max = max_heap_maximum(finder->heap, &maximum);\n87\t\tassert(had_max);\n88\t\tassert(maximum < finder->size);\n89\t\tif (entry.cost <= finder->entries[maximum].cost) {\n90\t\t\tfinder->entries[maximum] = entry;\n91\t\t\tmax_heap_update_maximum(finder->heap);\n92\t\t}\n93\t}\n94\t\n95\tstatic void top_k_packet_finder_callback(void* user_data, const LZMAState* state, LZMAPacket packet)\n96\t{\n97\t\tTopKPacketFinder* finder = (TopKPacketFinder*) user_data;\n98\t\n99\t\tif (lzma_packet_cmp(&packet, &finder->next_packets[state->position])) {\n100\t\t\treturn;\n101\t\t}\n102\t\n103\t\tLZMAState new_state = *state;\n104\t\tEncoderInterface enc;\n105\t\tuint64_t perplexity = 0;\n106\t\tsize_t start_position = new_state.position;\n107\t\tperplexity_encoder_new(&enc, &perplexity);\n108\t\tlzma_encode_packet(&new_state, &enc, packet);\n109\t\t// size_t count = 0;\n110\t\t// while (new_state.position < new_state.data_size && count < 2) {\n111\t\t// \tlzma_encode_packet(&new_state, &enc, finder->next_packets[new_state.position]);\n112\t\t// \tcount++;\n113\t\t// }\n114\t\n115\t\tsize_t length = new_state.position - start_position;\n116\t\tTopKEntry entry = { .packet = packet, .cost = perplexity / length };\n117\t\ttop_k_entry_finder_insert(finder, entry);\n118\t}\n119\t\n120\tvoid top_k_packet_finder_find(TopKPacketFinder* finder, const LZMAState* lzma_sta