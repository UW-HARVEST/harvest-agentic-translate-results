 callback(state, LZMAPacket::match_packet(dist, length as u32));\n            for i in 0..4u32 {\n                if dist == dists[i as usize] {\n                    callback(state, LZMAPacket::long_rep_packet(i, length as u32));\n                }\n            }\n        });\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":891,"cache_read_input_tokens":95810,"cache_creation":{"ephemeral_5m_input_tokens":891,"ephemeral_1h_input_tokens":0},"output_tokens":32,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bc62d35f-ac13-4729-acd7-de81393232ed","uuid":"c4996219-e509-44c1-a581-2ab2acd79dd5"}
