c/$PID/maps, the fields of each line are:\n198\t     *   - address range:\n199\t     *   - permission\n200\t     *   - offset    : The offset of the file being mmapped. If it's not file\n201\t     *                 mapping, this column must take value 0.\n202\t     *   - dev       :\n203\t     *   - inode     : inode of file being mmapped or empty otherwise\n204\t     *   - pathname  : path of the file being mmaped or empty otherwise\n205\t     *\n206\t     * e.g\n207\t     * ...\n208\t     * 00618000-00619000 rw-p 00018000 08:02 13505427    /usr/lib/thunderbird/thunderbird\n209\t     * 7f2b4b200000-7f2b4b300000 rw-p 00000000 00:00 0\n210\t     * 7f2b4b400000-7f2b4ca00000 rw-p 00000000 00:00 0\n211\t     * ...\n212\t     *\n213\t     *  We only care about the address-ranges.\n214\t     */\n215\t    ASSERT(buffer[buf_len-1] == '\\n');\n216\t    while (ofst < buf_len) {\n217\t        uintptr_t start_addr, end_addr;\n218\t\n219\t        /* step 1: get the lower-bound of the address range */\n220\t        int advance = parse_addr(ljmm.buffer + ofst, &start_addr);\n221\t        if (advance && (buffer[ofst + advance] == '-')) {\n222\t            ofst += advance + 1;\n223\t        } else {\n224\t            /* the buffer is not large enough to accommodate /proc/$PID/map */\n225\t            break;\n226\t        }\n227\t\n228\t        /* step 2: get the upper bound of the address range */\n229\t        advance = parse_addr(buffer + ofst , &end_addr);\n230\t        if (advance && buffer[ofst + advance] == ' ') {\n231\t            ofst += advance + 1;\n232\t            ASSERT(ofst < buf_len);\n233\t            /* skip the rest of the line. */\n234\t            while (buffer[ofst++] != '\\n') {}\n235\t        } else {\n236\t            /* we can move on with incomplete up-bound address */\n237\t            end_addr = upbound >= start_addr ? upbound : start_addr;\n238\t        }\n239\t\n240\t        end_addr = page_align_addr(end_addr);\n241\t\n242\t        /* step 3: get the unallocated hole between the previous and current\n243\t         *  mmapped blocks, and see if the hole is the best-fit.\n244\t         */\n245\t        uintptr_t hole_start = prev_blk.start + prev_blk.size;\n246\t        uintptr_t hole_size = start_addr - hole_start;\n247\t\n248\t        if (hole_size >= length &&\n249\t            (hole_start >= lowbound && (hole_start + length) <= upbound) &&\n250\t            hole_size < best_fit.size) {\n251\t            best_fit.start = hole_start;\n252\t            best_fit.size = hole_size;\n253\t\n254\t            if (best_fit.size == length) {\n255\t                break;\n256\t            }\n257\t        }\n258\t\n259\t        /* step 4: determine if we need to examine the next line */\n260\t        if (unlikely(start_addr >= ADDR_1G)) {\n261\t            /* We let OS to take care the [1G, 2G] space */\n262\t            if (!ljmm.OS_take_care_1G_2G || start_addr >= upbound) {\n263\t                break;\n264\t            }\n265\t        }\n266\t\n267\t        if (unlikely(end_addr >= upbound)) {\n268\t            /* HINT: the lines are in the ascending order of the address-range.\n269\t             */\n270\t            break;\n271\t        }\n272\t\n273\t        prev_blk.start = start_addr;\n274\t        prev_blk.size = end_addr - start_addr;\n275\t    }\n276\t\n277\t    return (best_fit.size != (uintptr_t)-1) ? best_fit.start : 0;\n278\t}\n279\t\n280\t\n281\t/* All the calls to mmap64() will be replaced by the calls to this function,\n282\t * which will be done by the linker fed with \"--wrap=mmap64\" flag.\n283\t */\n284\tvoid *\n285\tWRAP_MMAP(void *addr, size_t length, int prot, int flags, int fd,\n286\t    off_t offset) {\n287\t\n288\t    if (!(flags & MAP_32BIT) || addr || !ljmm.init_succ) {\n289\t        return REAL_MMAP(addr, length, prot, flags, fd, offset);\n290\t    }\n291\t\n292\t    if (ljmm.OS_take_care_1G_2G) {\n293\t        void *blk = REAL_MMAP(NULL, length, prot, flags, fd, offset);\n294\t        if (blk