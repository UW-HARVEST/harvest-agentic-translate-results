6\t    bigint result;\n77\t    if (n < 0) {\n78\t        result.is_negative = true;\n79\t        n = -n;\n80\t    } else {\n81\t        result.is_negative = false;\n82\t    }\n83\t    result.size = 1;\n84\t    int64_t m = n;\n85\t    while (m > 0) {\n86\t        m /= 10;\n87\t        result.size++;\n88\t    }\n89\t    result.digits = malloc(result.size * sizeof(int64_t));\n90\t    m = n;\n91\t    for (size_t i = 0; i < result.size; i++) {\n92\t        result.digits[result.size - i - 1] = m % 10;\n93\t        m /= 10;\n94\t    }\n95\t    bigint_remove_leading_zeros(&result);\n96\t    return result;\n97\t}\n98\t\n99\tint64_t bigint_to_int(bigint n) {\n100\t    int64_t result = 0;\n101\t    for (size_t i = 0; i < n.size; i++) {\n102\t        result *= 10;\n103\t        result += n.digits[i];\n104\t    }\n105\t    if (n.is_negative) {\n106\t        result = -result;\n107\t    }\n108\t    return result;\n109\t}\n110\t\n111\t/* Create a new bigint from an integer \n112\t* @param n The integer to create a bigint from\n113\t* @return A new bigint with the value of n\n114\t*/\n115\tbigint bigint_from_string(const char *n) {\n116\t    bigint result;\n117\t    \n118\t    // Determine if the number is negative\n119\t    if (n[0] == '-') {\n120\t        result.is_negative = true;\n121\t        n++;\n122\t    } else {\n123\t        result.is_negative = false;\n124\t    }\n125\t\n126\t    // Determine the size of the number\n127\t    result.size = strlen(n);\n128\t\n129\t    // Allocate memory for the digits\n130\t    result.digits = malloc(result.size * sizeof(int64_t));\n131\t    \n132\t    // Copy the digits into the bigint\n133\t    for (size_t i = 0; i < result.size; i++) {\n134\t        result.digits[i] = n[i] - '0';\n135\t    }\n136\t    \n137\t    return result;\n138\t}\n139\t\n140\t\n141\tbigint bigint_copy(bigint n) {\n142\t    bigint result;\n143\t    result.is_negative = n.is_negative;\n144\t    result.size = n.size;\n145\t    result.digits = malloc(result.size * sizeof(int64_t));\n146\t    memcpy(result.digits, n.digits, result.size * sizeof(int64_t));\n147\t    return result;\n148\t}\n149\t\n150\t/* Print a bigint\n151\t* @param n The bigint to print\n152\t*/\n153\tvoid bigint_print(bigint n) {\n154\t    if (n.is_negative) {\n155\t        printf(\"-\");\n156\t    }\n157\t    for (size_t i = 0; i < n.size; i++) {\n158\t        assert(n.digits[i] >= 0 && n.digits[i] <= 9);\n159\t        printf(\"%lld\", n.digits[i]);\n160\t    }\n161\t}\n162\t\n163\t\n164\tbool bigint_gt(bigint a, bigint b) {\n165\t    bigint_remove_leading_zeros(&a);\n166\t    bigint_remove_leading_zeros(&b);\n167\t    if (a.size > b.size) {\n168\t        return !a.is_negative;\n169\t    }\n170\t    if (a.size < b.size) {\n171\t        return a.is_negative;\n172\t    }\n173\t    for (size_t i = 0; i < a.size; i++) {\n174\t        if (a.digits[i] > b.digits[i]) {\n175\t            return !a.is_negative;\n176\t        }\n177\t        if (a.digits[i] < b.digits[i]) {\n178\t            return a.is_negative;\n179\t        }\n180\t    }\n181\t    return false;\n182\t}\n183\t\n184\tbool bigint_eq(bigint a, bigint b) {\n185\t    bigint_remove_leading_zeros(&a);\n186\t    bigint_remove_leading_zeros(&b);\n187\t    if (a.size != b.size) {\n188\t        return false;\n189\t    }\n190\t    if (a.is_negative != b.is_negative) {\n191\t        return false;\n192\t    }\n193\t    for (size_t i = 0; i < a.size; i++) {\n194\t        if (a.digits[i] != b.digits[i]) {\n195\t            return false;\n196\t        }\n197\t    }\n198\t    return true;\n199\t}\n200\t\n201\tbool bigint_eqzero(bigint n) {\n202\t    bigint_remove_leading_zeros(&n);\n203\t    if (n.size == 1 && n.digits[0] == 0) {\n204\t        return true;\n205\t    }\n206\t    return false;\n207\t}\n208\t\n209\tbool bigint_ltzero(bigint n) {\n210\t    bigint_remove_leading_zeros(&n);\n211\t    if (n.size == 1 && n.digits[0] == 0) {\n212\t        return false;\n213\t    }\n214\t    return n.is_negative;\n215\t}\n216\tboo