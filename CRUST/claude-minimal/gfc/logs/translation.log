{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_inihs4oztt4plo7h24owhixsnznye52dmsvrpeppzdedm7epv4rq","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_017uMRJsT2UN8k6wQ5xcKCPh","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-44Tusn/project/src/gfc.rs","content":"use std::f64::consts::SQRT_2;\n/// Constants for Speck encryption\nconst SPECK_ROUNDS: usize = 27;\nconst SPECK_KEY_LEN: usize = 4;\nfn ror(x: u32, r: u32) -> u32 {\n    (x >> r) | (x << (32 - r))\n}\nfn rol(x: u32, r: u32) -> u32 {\n    (x << r) | (x >> (32 - r))\n}\nfn round(x: &mut u32, y: &mut u32, k: u32) {\n    *x = ror(*x, 8);\n    *x = x.wrapping_add(*y);\n    *x ^= k;\n    *y = rol(*y, 3);\n    *y ^= *x;\n}\n#[derive(Debug)]\npub struct GFC {\n    m: u64,       // Range\n    r: u64,       // Number of Feistel rounds\n    a: u64,\n    b: u64,\n    speck_exp: Vec<u32>,\n}\nimpl GFC {\n    /// Initialize the GFC structure\n    pub fn new(range: u64, rounds: u64, seed: u64) -> Self {\n        // Compute the constants a and b such that ab >= range,\n        // according to the method of Section 6.\n        let tmp = (range as f64).sqrt().ceil() as u64;\n        let a = tmp;\n        let b = tmp;\n        // Precompute the speck round keys\n        let mut speck_exp = vec![0u32; (rounds as usize) * SPECK_ROUNDS];\n        for i in 0..rounds {\n            // The C code lays out `const uint64_t key[2] = {seed, i};` and\n            // reinterprets it as `const uint32_t[4]` (little-endian).\n            let key: [u32; SPECK_KEY_LEN] = [\n                seed as u32,\n                (seed >> 32) as u32,\n                i as u32,\n                (i >> 32) as u32,\n            ];\n            let start = (i as usize) * SPECK_ROUNDS;\n            let end = start + SPECK_ROUNDS;\n            speck_expand(&key, &mut speck_exp[start..end]);\n        }\n        GFC {\n            m: range,\n            r: rounds,\n            a,\n            b,\n            speck_exp,\n        }\n    }\n    /// Encrypt using the Feistel cipher\n    pub fn encrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe(m);\n        while c >= self.m {\n            c = self.fe(c);\n        }\n        c\n    }\n    /// Decrypt using the Feistel cipher\n    pub fn decrypt(&self, m: u64) -> u64 {\n        let mut c = self.fe_inv(m);\n        while c >= self.m {\n            c = self.fe_inv(c);\n        }\n        c\n    }\n    /// Function F for Feistel cipher using Speck encryption\n    fn f(&self, j: u64, r: u64) -> u64 {\n        let key_start = ((j - 1) as usize) * SPECK_ROUNDS;\n        let key = &self.speck_exp[key_start..key_start + SPECK_ROUNDS];\n        // Reinterpret R (u64) as [u32; 2] (little-endian),\n        // matching the C cast `(const uint32_t *)&R`.\n        let pt: [u32; 2] = [r as u32, (r >> 32) as u32];\n        let mut ct = [0u32; 2];\n        speck_encrypt(&pt, &mut ct, key);\n        (ct[0] as u64) | ((ct[1] as u64) << 32)\n    }\n    /// Function fe[r, a, b] for encryption\n    fn fe(&self, m: u64) -> u64 {\n        let mut l = m % self.a;\n        let mut r = m / self.a;\n        for j in 1..=self.r {\n            // j & 1 is true if j is odd\n            let tmp = if j & 1 == 1 {\n                l.wrapping_add(self.f(j, r)) % self.a\n            } else {\n                l.wrapping_add(self.f(j, r)) % self.b\n            };\n            l = r;\n            r = tmp;\n        }\n        if self.r & 1 == 1 {\n            self.a.wrapping_mul(l).wrapping_add(r)\n        } else {\n            self.a.wrapping_mul(r).wrapping_add(l)\n        }\n    }\n    /// Function fe^-1[r, a, b] for decryption\n    fn fe_inv(&self, m: u64) -> u64 {\n        let mut l;\n        let mut r;\n        if self.r & 1 == 1 {\n            r = m % self.a;\n            l = m / self.a;\n        } else {\n            l = m % self.a;\n            r = m / self.a;\n        }\n        let mut j = self.r;\n        while j >= 1 {\n            let tmp = if j & 1 == 1 {\n                // Apply the underflow-prevention trick from the C version.\n                (r + self.a - (self.f(j, l) % self.a)) % self.a\n            } else {\n                (r + self.b - (self.f(j, l) % self.b)) % self.b\n            };\n            r = l;\n            l = tmp;\n            j -= 1;\n        }\n        self.a.wrapping_mul(r).wrapping_add(l)\n    }\n}\n/// Speck key expansion\nfn speck_expand(key: &[u32; SPECK_KEY_LEN], round_keys: &mut [u32]) {\n    let mut b = key[0];\n    let mut a = [0u32; SPECK_KEY_LEN - 1];\n    for i in 0..(SPECK_KEY_LEN - 1) {\n        a[i] = key[i + 1];\n    }\n    round_keys[0] = b;\n    for i in 0..(SPECK_ROUNDS - 1) {\n        let idx = i % (SPECK_KEY_LEN - 1);\n        let mut x = a[idx];\n        round(&mut x, &mut b, i as u32);\n        a[idx] = x;\n        round_keys[i + 1] = b;\n    }\n}\n/// Speck encryption function\nfn speck_encrypt(pt: &[u32; 2], ct: &mut [u32; 2], key: &[u32]) {\n    ct[0] = pt[0];\n    ct[1] = pt[1];\n    for i in 0..SPECK_ROUNDS {\n        // C macro: R(ct[1], ct[0], K[i])\n        let mut x = ct[1];\n        let mut y = ct[0];\n        round(&mut x, &mut y, key[i]);\n        ct[1] = x;\n        ct[0] = y;\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":726,"cache_read_input_tokens":18894,"cache_creation":{"ephemeral_5m_input_tokens":726,"ephemeral_1h_input_tokens":0},"output_tokens":35,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"7a84780d-34bb-4fad-919c-4b7e50e1fe98","uuid":"9ba4e0d8-1b19-470f-a3e3-814a756c1086"}
