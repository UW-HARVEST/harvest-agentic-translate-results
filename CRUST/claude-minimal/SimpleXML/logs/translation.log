_at(v, 3) == &a);\n54\t  assert(vector_get_element_at(v, 4) == &b);\n55\t\n56\t  // test re-allocate\n57\t  for (i = 0; i < 100; ++i) {\n58\t    vector_push_back(v, &a);\n59\t  }\n60\t  assert(vector_size(v) == 105);\n61\t  assert(vector_get_element_at(v, 0) == &c);\n62\t  assert(vector_get_element_at(v, 1) == &b);\n63\t  assert(vector_get_element_at(v, 2) == &a);\n64\t  assert(vector_get_element_at(v, 3) == &a);\n65\t  assert(vector_get_element_at(v, 4) == &b);\n66\t  for (i = 5; i < 105; ++i) {\n67\t    assert(vector_get_element_at(v, i) == &a);\n68\t  }\n69\t\n70\t  // test top\n71\t  assert(vector_top_back(v) == &a);\n72\t  assert(vector_top_front(v) == &c);\n73\t  assert(vector_size(v) == 105);\n74\t\n75\t  vector_release(v);\n76\t\n77\t  printf(\"PASSED Test vector1\\n\");\n78\t}\n79\t\n80\t#define SIZE 100000\n81\tvoid test_vector2() {\n82\t  int i;\n83\t  Vector *v;\n84\t\n85\t  v = vector_create(v);\n86\t  // init element\n87\t  for (i = 0; i < SIZE; ++i) {\n88\t    XMLElement *e;\n89\t    char *tag_name, *value;\n90\t    tag_name = malloc(30 * sizeof(char));\n91\t    value = malloc(30 * sizeof(char));\n92\t    sprintf(tag_name, \"tag %d\", i);\n93\t    sprintf(value, \"value %d\", i);\n94\t    e = XMLElement_create(e, tag_name, value);\n95\t    vector_push_back(v, e);\n96\t  }\n97\t\n98\t  // assert element\n99\t  for (i = 0; i < vector_size(v); ++i) {\n100\t    XMLElement *e;\n101\t    char *tag_name, *value;\n102\t    tag_name = malloc(30 * sizeof(char));\n103\t    value = malloc(30 * sizeof(char));\n104\t    sprintf(tag_name, \"tag %d\", i);\n105\t    sprintf(value, \"value %d\", i);\n106\t\n107\t    e = (XMLElement *) vector_get_element_at(v, i);\n108\t    assert(strcmp(e->tag_name, tag_name) == 0);\n109\t    assert(strcmp(e->value, value) == 0);\n110\t    free(tag_name);\n111\t    free(value);\n112\t  }\n113\t\n114\t  // release\n115\t  for (i = 0; i < vector_size(v); ++i) {\n116\t    XMLElement *e;\n117\t    e = vector_get_element_at(v, i);\n118\t   