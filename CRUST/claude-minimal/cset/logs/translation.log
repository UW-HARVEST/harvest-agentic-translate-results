de.size(), 2);\n65\t    cset_node.add(Node { x: 5, y: 8 });\n66\t    assert_eq!(cset_node.size(), 3);\n67\t}\n68\t#[test]\n69\tfn test_cset_remove() {\n70\t    let mut cset_int = cset::Cset::<i32>::new();\n71\t    cset_int.add(45);\n72\t    cset_int.add(34);\n73\t    cset_int.add(10);\n74\t    assert_eq!(cset_int.size(), 3);\n75\t    cset_int.remove(45);\n76\t    assert_eq!(cset_int.size(), 2);\n77\t    cset_int.remove(45);\n78\t    assert_eq!(cset_int.size(), 2);\n79\t    cset_int.remove(34);\n80\t    assert_eq!(cset_int.size(), 1);\n81\t    for value in cset_int.iter() {\n82\t        assert_eq!(value, 10);\n83\t    }\n84\t    cset_int.remove(10);\n85\t    assert_eq!(cset_int.size(), 0);\n86\t}\n87\t#[test]\n88\tfn test_cset_resize() {\n89\t    let mut cset_int = cset::Cset::<i32>::new();\n90\t    for i in 0..1500 {\n91\t    cset_int.add(i);\n92\t    }\n93\t}\n94\t#[test]\n95\tfn test_default_bytes_comparator() {\n96\t    let mut cset_int = cset::Cset::<i32>::new();\n97\t    cset_int.add(45);\n98\t    cset_int.add(46);\n99\t    cset_int.add(67);\n100\t    assert!(cset_int.contains(&45));\n101\t    assert!(!cset_int.contains(&68));\n102\t    assert!(cset_int.contains(&46));\n103\t    cset_int.remove(46);\n104\t    assert!(!cset_int.contains(&46));\n105\t    cset_int.remove(46);\n106\t    assert!(!cset_int.contains(&46));\n107\t    assert_eq!(cset_int.size(), 2);\n108\t    cset_int.remove(45);\n109\t    assert_eq!(cset_int.size(), 1);\n110\t    cset_int.remove(67);\n111\t    assert_eq!(cset_int.size(), 0);\n112\t    cset_int.remove(67);\n113\t    assert_eq!(cset_int.size(), 0);\n114\t    for i in 0..2000 {\n115\t    cset_int.add(i);\n116\t    }\n117\t    assert_eq!(cset_int.size(), 2000);\n118\t}\n119\tfn node_pointer_comparator(selfs: &Node, other: &Node) -> bool {\n120\t    selfs.x == other.x\n121\t}\n122\tfn custom_node_compare(selfs: &Node, other: &Node) -> bool {\n123\t    selfs.x == other.x\n124\t}\n125\t#[test]\n126\tfn test_custom_comparator() {\n127\t    let