{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01QzXByH3ojCeVaVhzNeLotd","type":"tool_result","content":"1\t/* zlib License\n2\t *\n3\t * Copyright (c) 2017-2025 Ed van Bruggen\n4\t *\n5\t * This software is provided 'as-is', without any express or implied\n6\t * warranty.  In no event will the authors be held liable for any damages\n7\t * arising from the use of this software.\n8\t *\n9\t * Permission is granted to anyone to use this software for any purpose,\n10\t * including commercial applications, and to alter it and redistribute it\n11\t * freely, subject to the following restrictions:\n12\t *\n13\t * 1. The origin of this software must not be misrepresented; you must not\n14\t *    claim that you wrote the original software. If you use this software\n15\t *    in a product, an acknowledgment in the product documentation would be\n16\t *    appreciated but is not required.\n17\t * 2. Altered source versions must be plainly marked as such, and must not be\n18\t *    misrepresented as being the original software.\n19\t * 3. This notice may not be removed or altered from any source distribution.\n20\t */\n21\t\n22\t/* return first element of list */\n23\tstatic Val\n24\tprim_car(Tsp st, Rec env, Val args)\n25\t{\n26\t\ttsp_arg_num(args, \"car\", 1);\n27\t\ttsp_arg_type(car(args), \"car\", TSP_PAIR);\n28\t\treturn caar(args);\n29\t}\n30\t\n31\t/* return elements of a list after the first */\n32\tstatic Val\n33\tprim_cdr(Tsp st, Rec env, Val args)\n34\t{\n35\t\ttsp_arg_num(args, \"cdr\", 1);\n36\t\ttsp_arg_type(car(args), \"cdr\", TSP_PAIR);\n37\t\treturn cdar(args);\n38\t}\n39\t\n40\t/* return new pair */\n41\tstatic Val\n42\tprim_cons(Tsp st, Rec env, Val args)\n43\t{\n44\t\ttsp_arg_num(args, \"cons\", 2);\n45\t\treturn mk_pair(car(args), cadr(args));\n46\t}\n47\t\n48\t/* do not evaluate argument */\n49\tstatic Val\n50\tform_quote(Tsp st, Rec env, Val args)\n51\t{\n52\t\ttsp_arg_num(args, \"quote\", 1);\n53\t\treturn car(args);\n54\t}\n55\t\n56\t/* evaluate argument given */\n57\tstatic Val\n58\tprim_eval(Tsp st, Rec env, Val args)\n59\t{\n60\t\tVal v;\n61\t\ttsp_arg_num(args, \"eval\", 1);\n62\t\treturn (v = tisp_eval(st, st->env, car(args))) ? v : st->none;\n63\t}\n64\t\n65\t/* test equality of all values given */\n66\tstatic Val\n67\tprim_eq(Tsp st, Rec env, Val args)\n68\t{\n69\t\tif (nilp(args))\n70\t\t\treturn st->t;\n71\t\tfor (; !nilp(cdr(args)); args = cdr(args))\n72\t\t\tif (!vals_eq(car(args), cadr(args)))\n73\t\t\t\treturn st->nil;\n74\t\t/* return nilp(car(args)) ? st->t : car(args); */\n75\t\treturn st->t;\n76\t}\n77\t\n78\t/* evaluates and returns first expression with a true conditional */\n79\tstatic Val\n80\tform_cond(Tsp st, Rec env, Val args)\n81\t{\n82\t\tVal v, cond;\n83\t\tfor (v = args; !nilp(v); v = cdr(v))\n84\t\t\tif (!(cond = tisp_eval(st, env, caar(v))))\n85\t\t\t\treturn NULL;\n86\t\t\telse if (!nilp(cond)) /* TODO incorporate else directly into cond */\n87\t\t\t\treturn tisp_eval_body(st, env, cdar(v));\n88\t\treturn st->none;\n89\t}\n90\t\n91\t/* return type of tisp value */\n92\tstatic Val\n93\tprim_typeof(Tsp st, Rec env, Val args)\n94\t{\n95\t\ttsp_arg_num(args, \"typeof\", 1);\n96\t\treturn mk_str(st, tsp_type_str(car(args)->t));\n97\t}\n98\t\n99\t/* return record of properties for given procedure */\n100\tstatic Val\n101\tprim_procprops(Tsp st, Rec env, Val args)\n102\t{\n103\t\ttsp_arg_num(args, \"procprops\", 1);\n104\t\tVal proc = car(args);\n105\t\tRec ret = rec_new(6, NULL);\n106\t\tswitch (proc->t) {\n107\t\tcase TSP_FORM:\n108\t\tcase TSP_PRIM:\n109\t\t\trec_add(ret, \"name\", mk_sym(st, proc->v.pr.name));\n110\t\t\tbreak;\n111\t\tcase TSP_FUNC:\n112\t\tcase TSP_MACRO:\n113\t\t\trec_add(ret, \"name\", mk_sym(st, proc->v.f.name ? proc->v.f.name : \"anon\"));\n114\t\t\trec_add(ret, \"args\", proc->v.f.args);\n115\t\t\trec_add(ret, \"body\", proc->v.f.body);\n116\t\t\t/* rec_add(ret, \"env\", proc->v.f.env); */\n117\t\t\tbreak;\n118\t\tdefault:\n119\t\t\ttsp_warnf(\"procprops: expected Proc, received '%s'\", tsp_type_str(proc->t));\n120\t\t}\n121\t\treturn mk_rec(st, ret, NULL);\n122\t}\n123\t\n124\t/* creates new tisp function */\n125\tstatic Val\n126\tform_Func(Tsp st, Rec env, Val args)\n127\t{\n128\t\tVal params, body;\n129\t\ttsp_arg_min(args, \"Func\", 1);\n130\t\tif (nilp(cdr(args))) { /* if only 1 argument is given, auto fill func parameters */\n131\t\t\tparams = mk_pair(mk_sym(st, \"it\"), st->nil);\n132\t\t\tbody = args;\n133\t\t} else {\n134\t\t\tparams = car(args);\n135\t\t\tbody = cdr(args);\n136\t\t}\n137\t\treturn mk_func(TSP_FUNC, NULL, params, body, env);\n138\t}\n139\t\n140\t/* creates new tisp defined macro */\n141\tstatic Val\n142\tform_Macro(Tsp st, Rec env, Val args)\n143\t{\n144\t\ttsp_arg_min(args, \"Macro\", 1);\n145\t\tVal ret = form_Func(st, env, args);\n146\t\tret->t = TSP_MACRO;\n147\t\treturn ret;\n148\t}\n149\t\n150\t/* display message and return error */\n151\tstatic Val\n152\tprim_error(Tsp st, Rec env, Val args)\n153\t{\n154\t\t/* TODO have error auto print function name that was pre-defined */\n155\t\ttsp_arg_min(args, \"error\", 2);\n156\t\ttsp_arg_type(car(args), \"error\", TSP_SYM);\n157\t\t/* TODO specify error raised by error func */\n158\t\tfprintf(stderr, \"; tisp: error: %s: \", car(args)->v.s);\n159\t\tfor (args = cdr(args); !nilp(args); args = cdr(args))\n160\t\t\ttisp_print(stderr, car(args));\n161\t\tfputc('\\n', stderr);\n162\t\treturn NULL;\n163\t}\n164\t\n165\t/** Records **/\n166\t\n167\t/* merge second record into first record, without mutation */\n168\tstatic Val\n169\tprim_recmerge(Tsp st, Rec env, Val args)\n170\t{\n171\t\tVal ret = mk_val(TSP_REC);\n172\t\ttsp_arg_num(args, \"recmerge\", 2);\n173\t\ttsp_arg_type(car(args), \"recmerge\", TSP_REC);\n174\t\ttsp_arg_type(cadr(args), \"recmerge\", TSP_REC);\n175\t\tret->v.r = rec_new(cadr(args)->v.r->size*TSP_REC_FACTOR, car(args)->v.r);\n176\t\tfor (Rec r = cadr(args)->v.r; r; r = r->next)\n177\t\t\tfor (int i = 0, c = 0; c < r->size; i++)\n178\t\t\t\tif (r->items[i].key)\n179\t\t\t\t\tc++, rec_add(ret->v.r, r->items[i].key, r->items[i].val);\n180\t\treturn ret;\n181\t}\n182\t\n183\t/* retrieve list of every entry in given record */\n184\tstatic Val\n185\tprim_records(Tsp st, Rec env, Val args)\n186\t{\n187\t\tVal ret = st->nil;\n188\t\ttsp_arg_num(args, \"records\", 1);\n189\t\ttsp_arg_type(car(args), \"records\", TSP_REC);\n190\t\tfor (Rec r = car(args)->v.r; r; r = r->next)\n191\t\t\tfor (int i = 0, c = 0; c < r->size; i++)\n192\t\t\t\tif (r->items[i].key) {\n193\t\t\t\t\tVal entry = mk_pair(mk_sym(st, r->items[i].key),\n194\t\t\t\t\t                               r->items[i].val);\n195\t\t\t\t\tret = mk_pair(entry, ret);\n196\t\t\t\t\tc++;\n197\t\t\t\t}\n198\t\treturn ret;\n199\t}\n200\t\n201\t/* creates new variable of given name and value\n202\t * if pair is given as name of variable, creates function with the car as the\n203\t * function name and the cdr the function arguments */\n204\t/* TODO if var not func error if more than 2 args */\n205\tstatic Val\n206\tform_def(Tsp st, Rec env, Val args)\n207\t{\n208\t\tVal sym, val;\n209\t\ttsp_arg_min(args, \"def\", 1);\n210\t\tif (car(args)->t == TSP_PAIR) { /* create function if given argument list */\n211\t\t\tsym = caar(args); /* first element of argument list is function name */\n212\t\t\tif (sym->t != TSP_SYM)\n213\t\t\t\ttsp_warnf(\"def: expected symbol for function name, received '%s'\",\n214\t\t\t\t          tsp_type_str(sym->t));\n215\t\t\tval = mk_func(TSP_FUNC, sym->v.s, cdar(args), cdr(args), env);\n216\t\t} else if (car(args)->t == TSP_SYM) { /* create variable */\n217\t\t\tsym = car(args); /* if only symbol given, make it self evaluating */\n218\t\t\tval = nilp(cdr(args)) ? sym : tisp_eval(st, env, cadr(args));\n219\t\t} else tsp_warn(\"def: incorrect format, no variable name found\");\n220\t\tif (!val)\n221\t\t\treturn NULL;\n222\t\t/* set procedure name if it was previously anonymous */\n223\t\tif (val->t & (TSP_FUNC|TSP_MACRO) && !val->v.f.name)\n224\t\t\tval->v.f.name = sym->v.s; /* TODO some bug here */\n225\t\trec_add(env, sym->v.s, val);\n226\t\treturn st->none;\n227\t}\n228\t\n229\t/* TODO fix crashing if try to undefine builtin */\n230\tstatic Val\n231\tform_undefine(Tsp st, Rec env, Val args)\n232\t{\n233\t\ttsp_arg_min(args, \"undefine!\", 1);\n234\t\ttsp_arg_type(car(args), \"undefine!\", TSP_SYM);\n235\t\tfor (Rec r = env; r; r = r->next) {\n236\t\t\tEntry e = entry_get(r, car(args)->v.s);\n237\t\t\tif (e->key) {\n238\t\t\t\te->key = NULL;\n239\t\t\t\t/* TODO tsp_free(e->val); */\n240\t\t\t\treturn st->none;\n241\t\t\t}\n242\t\t}\n243\t\ttsp_warnf(\"undefine!: could not find symbol %s to undefine\", car(args)->v.s);\n244\t}\n245\t\n246\tstatic Val\n247\tform_definedp(Tsp st, Rec env, Val args)\n248\t{\n249\t\tEntry e = NULL;\n250\t\ttsp_arg_min(args, \"defined?\", 1);\n251\t\ttsp_arg_type(car(args), \"defined?\", TSP_SYM);\n252\t\tfor (Rec r = env; r; r = r->next) {\n253\t\t\te = entry_get(r, car(args)->v.s);\n254\t\t\tif (e->key)\n255\t\t\t\tbreak;\n256\t\t}\n257\t\treturn (e && e->key) ? st->t : st->nil;\n258\t}\n259\t\n260\t\n261\tvoid\n262\ttib_env_core(Tsp st)\n263\t{\n264\t\ttsp_env_prim(car);\n265\t\ttsp_env_prim(cdr);\n266\t\ttsp_env_prim(cons);\n267\t\ttsp_env_form(quote);\n268\t\ttsp_env_prim(eval);\n269\t\ttsp_env_name_prim(=, eq);\n270\t\ttsp_env_form(cond);\n271\t\ttisp_env_add(st, \"do\", mk_prim(TSP_FORM, tisp_eval_body, \"do\"));\n272\t\n273\t\ttsp_env_prim(typeof);\n274\t\ttsp_env_prim(procprops);\n275\t\ttsp_env_form(Func);\n276\t\ttsp_env_form(Macro);\n277\t\ttsp_env_prim(error);\n278\t\n279\t\ttisp_env_add(st, \"Rec\", mk_prim(TSP_FORM, mk_rec, \"Rec\"));\n280\t\ttsp_env_prim(recmerge);\n281\t\ttsp_env_prim(records);\n282\t\ttsp_env_form(def);\n283\t\ttsp_env_name_form(undefine!, undefine);\n284\t\ttsp_env_name_form(defined?, definedp);\n285\t}\n286\t"}]},"parent_tool_use_id":"toolu_bdrk_019dgVXSjAX33BkwXnqJjgDL","session_id":"f9c81f88-f