ected at least %d argument%s, received %d\",    \\\n41\t\t\t           NAME, NARGS, NARGS > 1 ? \"s\" : \"\", tsp_lstlen(ARGS)); \\\n42\t} while(0)\n43\t#define tsp_arg_max(ARGS, NAME, NARGS) do {                                          \\\n44\t\tif (tsp_lstlen(ARGS) > NARGS)                                                \\\n45\t\t\ttsp_warnf(\"%s: expected at no more than %d argument%s, received %d\", \\\n46\t\t\t           NAME, NARGS, NARGS > 1 ? \"s\" : \"\", tsp_lstlen(ARGS));     \\\n47\t} while(0)\n48\t#define tsp_arg_num(ARGS, NAME, NARGS) do {                                      \\\n49\t\tif (NARGS > -1 && tsp_lstlen(ARGS) != NARGS)                             \\\n50\t\t\ttsp_warnf(\"%s: expected %d argument%s, received %d\",             \\\n51\t\t\t           NAME, NARGS, NARGS > 1 ? \"s\" : \"\", tsp_lstlen(ARGS)); \\\n52\t} while(0)\n53\t#define tsp_arg_type(ARG, NAME, TYPE) do {                                     \\\n54\t\tif (!(ARG->t & (TYPE)))                                                \\\n55\t\t\ttsp_warnf(NAME \": expected %s, received %s\",                   \\\n56\t\t\t                tsp_type_str(TYPE), tsp_type_str(ARG->t));     \\\n57\t} while(0)\n58\t\n59\t#define tsp_env_name_prim(NAME, FN) tisp_env_add(st, #NAME, mk_prim(TSP_PRIM, prim_##FN, #NAME))\n60\t#define tsp_env_prim(NAME)          tsp_env_name_prim(NAME, NAME)\n61\t#define tsp_env_name_form(NAME, FN) tisp_env_add(st, #NAME, mk_prim(TSP_FORM, form_##FN, #NAME))\n62\t#define tsp_env_form(NAME)          tsp_env_name_form(NAME, NAME)\n63\t\n64\t#define tsp_fgetat(ST, O) ST->file[ST->filec+O]\n65\t#define tsp_fget(ST) tsp_fgetat(ST,0)\n66\t#define tsp_finc(ST) ST->filec++\n67\t#define tsp_fincn(ST, N) ST->filec += N\n68\t\n69\tstruct Val;\n70\ttypedef struct Val *Val;\n71\ttypedef struct Tsp *Tsp;\n72\t\n73\ttypedef struct Entry *Entry;\n74\t\n75\ttypedef struct Rec {\n76\t\tint size, cap;\n77\t\tstruct Entry {\n78\t\t\tchar *key;\n79\t\t\tVal val;\n80\t\t} *items;\n81\t\tstruct Rec *next;\n82\t} *Rec;\n83\t\n84\t/* possible tisp object types */\n85\ttypedef enum {\n86\t\tTSP_NONE  = 1 << 0,  /* void */\n87\t\tTSP_NIL   = 1 << 1,  /* nil: false, empty list */\n88\t\tTSP_INT   = 1 << 2,  /* integer: whole number */\n89\t\tTSP_DEC   = 1 << 3,  /* decimal: floating point number */\n90\t\tTSP_RATIO = 1 << 4,  /* ratio: numerator/denominator */\n91\t\tTSP_STR   = 1 << 5,  /* string: immutable characters */\n92\t\tTSP_SYM   = 1 << 6,  /* symbol: variable names */\n93\t\tTSP_PRIM  = 1 << 7,  /* primitive: built-in function */\n94\t\tTSP_FORM  = 1 << 8,  /* special form: built-in macro */\n95\t\tTSP_FUNC  = 1 << 9,  /* function: procedure written is tisp */\n96\t\tTSP_MACRO = 1 << 10, /* macro: function without evaluated arguments */\n97\t\tTSP_PAIR  = 1 << 11, /* pair: building block for lists */\n98\t\tTSP_REC   = 1 << 12, /* record: hash table */\n99\t} TspType;\n100\t#define TSP_RATIONAL (TSP_INT | TSP_RATIO)\n101\t#define TSP_NUM      (TSP_RATIONAL | TSP_DEC)\n102\t/* TODO rename to expr type to math ? */\n103\t#define TSP_EXPR     (TSP_NUM | TSP_SYM | TSP_PAIR)\n104\t\n105\t/* bultin function written in C, not tisp */\n106\ttypedef Val (*Prim)(Tsp, Rec, Val);\n107\t\n108\t/* tisp object */\n109\tstruct Val {\n110\t\tTspType t; /* NONE, NIL */\n111\t\tunion {\n112\t\t\tchar *s;                                           /* STRING, SYMBOL */\n113\t\t\tstruct { double num, den; } n;                     /* NUMBER */\n114\t\t\tstruct { char *name; Prim pr; } pr;                /* PRIMITIVE, FORM */\n115\t\t\tstruct { char *name; Val args, body; Rec env; } f; /* FUNCTION, MACRO */\n116\t\t\tstruct { Val car, cdr; } p;                        /* PAIR */\n117\t\t\tRec r;                                             /* REC */\n118\t\t} v;\n119\t};\n120\t\n121\t/* tisp state and global environment */\n122\tstruct Tsp {\n123\t\tchar *file;\n124\t\tsize_t filec;\n125\t\tVal none, nil, t;\n126\t\tRec env, strs, syms;\n127\t\tvoid **libh;\n128\t\tsize_t libhc;\n129\t};\n130\t\n131\tchar *tsp_type_str(TspType t);\n132\tint tsp_lstlen(Val v);\n133\t\n134\tVal mk_int(int i);\n135\tVal mk_dec(double d);\n136\tVal mk_rat(int num, int den);\n137\tVal mk_str(Tsp st, char *s);\n138\tVal mk_sym(Tsp st, char *s);\n139\tVal mk_prim(TspType t, Prim prim, char *name);\n140\tVal mk_func(TspType t, char *name, Val args, Val body, Rec env);\n141\tVal mk_rec(Tsp st, Rec env, Val assoc);\n142\tVal mk_pair(Val a, Val b);\n143\tVal mk_list(Tsp st, int n, ...);\n144\t\n145\tVal read_pair(Tsp st, char endchar);\n146\tVal tisp_read_sexpr(Tsp st);\n147\tVal tisp_read(Tsp st);\n148\tVal tisp_read_sugar(Tsp st, Val v);\n149\tVal tisp_read_line(Tsp st, int level);\n150\tVal tisp_eval_list(Tsp st, Rec env, Val v);\n151\tVal tisp_eval_body(Tsp st, Rec env, Val v);\n152\tVal tisp_eval(Tsp st, Rec env, Val v);\n153\tvoid tisp_print(FILE *f, Val v);\n154\t\n155\tvoid tisp_env_add(Tsp st, char *key, Val v);\n156\tTsp  tisp_env_init(size_t cap);\n157\tvoid tisp_env_lib(Tsp st, char* lib);\n158\t\n159\tvoid tib_env_core(Tsp);\n160\tvoid tib_env_string(Tsp);\n161\tvoid tib_env_math(Tsp);\n162\tvoid tib_env_io(Tsp);\n163\tvoid tib_env_os(Tsp);\n164\t"}]},"parent_tool_use_id":"toolu_bdrk_019dgVXSjAX33BkwXnqJjgDL","session_id":"f9c81f88-f3d3-4945-8da6-500e35a26aa1","uuid":"351d0c03-cf70-4083-ab39-5fc73dd17223","timestamp":"2026-06-02T00:36:16.738Z","subagent_type":"general-purpose","task_description":"Port C tisp interpreter to Rust"}
