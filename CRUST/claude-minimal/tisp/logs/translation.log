n50\tstatic char *\n51\tread_file(char *fname)\n52\t{\n53\t\tchar buf[BUFSIZ], *file = NULL;\n54\t\tint len = 0, n, fd, parens = 0;\n55\t\tif (!fname) /* read from stdin if no file given */\n56\t\t\tfd = 0;\n57\t\telse if ((fd = open(fname, O_RDONLY)) < 0)\n58\t\t\ttsp_warnf(\"could not find file '%s'\", fname);\n59\t\twhile ((n = read(fd, buf, sizeof(buf))) > 0) {\n60\t\t\tfile = realloc(file, len + n + 1);\n61\t\t\tif (!file) perror(\"; realloc\"), exit(1);\n62\t\t\tmemcpy(file + len, buf, n);\n63\t\t\tlen += n;\n64\t\t\tfile[len] = '\\0';\n65\t\t\tif (fd == 0 && (parens += count_parens(buf, n)) <= 0)\n66\t\t\t\tbreak;\n67\t\t}\n68\t\tif (fd) /* close file if not stdin */\n69\t\t\tclose(fd);\n70\t\tif (n < 0)\n71\t\t\ttsp_warnf(\"could not read file '%s'\", fname);\n72\t\treturn file;\n73\t}\n74\t\n75\t/* write all arguemnts to given file, or stdout/stderr, without newline */\n76\t/* first argument is file name, second is option to append file */\n77\tstatic Val\n78\tprim_write(Tsp st, Rec env, Val args)\n79\t{\n80\t\tFILE *f;\n81\t\tconst char *mode = \"w\";\n82\t\ttsp_arg_min(args, \"write\", 2);\n83\t\n84\t\t/* if second argument is true, append file don't write over */\n85\t\tif (!nilp(cadr(args)))\n86\t\t\tmode = \"a\";\n87\t\t/* first argument can either be the symbol stdout or stderr, or the file as a string */\n88\t\tif (car(args)->t == TSP_SYM)\n89\t\t\tf = !strncmp(car(args)->v.s, \"stdout\", 7) ? stdout : stderr;\n90\t\telse if (car(args)->t != TSP_STR)\n91\t\t\ttsp_warnf(\"write: expected file name as string, received %s\",\n92\t\t\t           tsp_type_str(car(args)->t));\n93\t\telse if (!(f = fopen(car(args)->v.s, mode)))\n94\t\t\ttsp_warnf(\"write: could not load file '%s'\", car(args)->v.s);\n95\t\tif (f == stderr && strncmp(car(args)->v.s, \"stderr\", 7)) /* validate stderr symbol */\n96\t\t\ttsp_warn(\"write: expected file name as string, or symbol stdout/stderr\");\n97\t\n98\t\tfor (args = cddr(args); !nilp(args); args = cdr(args))\n99\t\t\ttisp_