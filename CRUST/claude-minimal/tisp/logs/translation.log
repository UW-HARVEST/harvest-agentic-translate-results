, env, car(args))))\n\t\treturn NULL;\n\tt = clock() - t;\n\treturn mk_dec(((double)t)/CLOCKS_PER_SEC*100);\n}\n\nvoid\ntib_env_os(Tsp st)\n{\n\ttsp_env_name_prim(cd!, cd);\n\ttsp_env_prim(pwd);\n\ttsp_env_name_prim(exit!, exit);\n\ttsp_env_prim(now);\n\ttsp_env_form(time);\n}\n","numLines":95,"startLine":1,"totalLines":95}}}
