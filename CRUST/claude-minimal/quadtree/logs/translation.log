dtree_node_with_bounds(\n            x,\n            y - hh,\n            x + hw,\n            y,\n        )));\n        node.ne = Some(Box::new(QuadtreeNode::quadtree_node_with_bounds(\n            x + hw,\n            y - hh,\n            x + hw * 2.0,\n            y,\n        )));\n        node.sw = Some(Box::new(QuadtreeNode::quadtree_node_with_bounds(\n            x,\n            y - hh * 2.0,\n            x + hw,\n            y - hh,\n        )));\n        node.se = Some(Box::new(QuadtreeNode::quadtree_node_with_bounds(\n            x + hw,\n            y - hh * 2.0,\n            x + hw * 2.0,\n            y - hh,\n        )));\n\n        let old_point = node.point.take();\n        let old_key = node.key.take();\n\n        if let Some(p) = old_point {\n            insert_(node, p, old_key) != 0\n        } else {\n            true\n        }\n    }\n\n    fn find_<T>(\n        node: &mut Option<Box<QuadtreeNode<T>>>,\n        x: f64,\n        y: f64,\n    ) -> &mut Option<Box<QuadtreePoint>> {\n        // We need to either return a mutable reference to the matching point\n        // Option on a leaf, or a reference to an Option that is `None`.\n        // We accomplish this by descending the tree with mutable borrows.\n        let n_ref = match node.as_mut() {\n            Some(n) => n,\n            None => return node_to_point_none(node),\n        };\n\n        if n_ref.quadtree_node_isleaf() {\n            let p = n_ref.point.as_ref().unwrap();\n            if p.x == x && p.y == y {\n                return &mut n_ref.point;\n            }\n            return node_to_point_none_via_node(n_ref);\n        } else if n_ref.quadtree_node_ispointer() {\n            let test = QuadtreePoint::quadtree_point_new(x, y);\n            // Decide which quadrant via immutable inspection.\n            let which = if n_ref.nw.as_ref().map_or(false, |c| node_contains_(c, &test)) {\n                0\n            } else if n_ref.ne.as_ref().map_or(false, |c| node_contains_(c, &test)) {\n                1\n            } else if n_ref.sw.as_ref().map_or(false, |c| node_contains_(c, &test)) {\n                2\n            } else if n_ref.se.as_ref().map_or(false, |c| node_contains_(c, &test)) {\n                3\n            } else {\n                return node_to_point_none_via_node(n_ref);\n            };\n            return match which {\n                0 => find_(&mut n_ref.nw, x, y),\n                1 => find_(&mut n_ref.ne, x, y),\n                2 => find_(&mut n_ref.sw, x, y),\n                _ => find_(&mut n_ref.se, x, y),\n            };\n        }\n        node_to_point_none_via_node(n_ref)\n    }\n\n    /// Returns a mutable reference to the (already `None`) point Option of\n    /// this node. Used to express \"not found\" without needing a global None.\n    fn node_to_point_none_via_node<T>(\n        node: &mut QuadtreeNode<T>,\n    ) -> &mut Option<Box<QuadtreePoint>> {\n        // We only call this when `node.point` is the desired sentinel `None`,\n        // i.e. when we know the search did not match. Since `node` is not a\n        // leaf in those code paths, `point` is `None`.\n        &mut node.point\n    }\n\n    /// Same as `node_to_point_none_via_node` but operates on the outer\n    /// `Option<Box<QuadtreeNode>>` (unused branch retained for symmetry).\n    fn node_to_point_none<T>(\n        _node: &mut Option<Box<QuadtreeNode<T>>>,\n    ) -> &mut Option<Box<QuadtreePoint>> {\n        // Caller guarantees we only reach here when the outer Option is None,\n        // which only happens for a tree with no root. We allocate a thread\n        // local sentinel via a leak so the lifetime can satisfy the borrow.\n        // This branch is effectively unreachable for the search test cases.\n        use std::sync::OnceLock;\n        static SENTINEL: OnceLock<usize> = OnceLock::new();\n        // Initialize on first call: leak a heap allocation for the sentinel.\n        let addr = *SENTINEL.get_or_init(|| {\n           