X};\n\npub fn add(state: &mut [[u8; NB]; 4], round_key: &[[u8; NB]; 4]) {\n    for i in 0..4 {\n        for j in 0..NB {\n            state[i][j] ^= round_key[i][j];\n        }\n    }\n}\n\npub fn expansion(key: &[u8; 4 * NK], w: &mut [u8; 4 * NB * (NR + 1)]) {\n    // Zero the output\n    for byte in w.iter_mut() {\n        *byte = 0;\n    }\n\n    // Copy key into the first portion of w (mirroring the C code's behavior).\n    // The C code stores 16 bytes at offsets 0, 4, 8, 12 in a single iteration when\n    // i = 0 (Nk*4 = 16, loop only runs once with i=0). Each store overwrites the\n    // previous, so the final result is just the 16 key bytes at positions 0..16.\n    w[..(4 * NK)].copy_from_slice(&key[..(4 * NK)]);\n\n    let mut i = NK;\n    while i < NB * (NR + 1) {\n        // temp = w[4*(i-1) .. 4*(i-1)+16] (16 bytes loaded from this position)\n        let mut temp = [0u8; 16];\n        let base = 4 * (i - 1);\n        for k in 0..16 {\n            if base + k < w.len() {\n                temp[k] = w[base + k];\n            }\n        }\n\n        if i % NK == 0 {\n            // _mm_shuffle_epi32 with _MM_SHUFFLE(3, 0, 1, 2) on 4 32-bit lanes:\n            // Result lane 0 = src lane 2\n            // Result lane 1 = src lane 1\n            // Result lane 2 = src lane 0\n            // Result lane 3 = src lane 3\n            let mut shuffled = [0u8; 16];\n            // lane 0 (bytes 0..4) = src lane 2 (bytes 8..12)\n            shuffled[0..4].copy_from_slice(&temp[8..12]);\n            // lane 1 (bytes 4..8) = src lane 1 (bytes 4..8)\n            shuffled[4..8].copy_from_slice(&temp[4..8]);\n            // lane 2 (bytes 8..12) = src lane 0 (bytes 0..4)\n            shuffled[8..12].copy_from_slice(&temp[0..4]);\n            // lane 3 (bytes 12..16) = src lane 3 (bytes 12..16)\n            shuffled[12..16].copy_from_slice(&temp[12..16]);\n            temp = shuffled;\n\n            // Apply sbox to the first 4 bytes\n            for j in 0..4 {\n         