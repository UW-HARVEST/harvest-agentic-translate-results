   }\n57\t    else if (ast -> type == TOKEN_DIS) {\n58\t        compile_expression(ast -> left, instructions, instr_count);\n59\t        emit(instructions, instr_count, STK_DIS, ast -> value);\n60\t    }\n61\t\n62\t    return instructions;\n63\t}\n64\t\n65\tInstruction *\n66\tcompile_asts(ASTNode** asts, int* total_instr_count)\n67\t{\n68\t    /*\n69\t     * This function will compile a group of AST to bytecode.\n70\t     * */\n71\t    *total_instr_count = 0;\n72\t    Instruction ** instr_of_all = (Instruction **) malloc(sizeof(Instruction)\n73\t                                                          * MAX_INSTR_IN_STATEMENT * MAX_STATEMENT);\n74\t    int * instr_count_of_all = (int *) malloc(sizeof(int) * MAX_STATEMENT);\n75\t\n76\t    for (int i=0; asts[i] != NULL; i++) {\n77\t        instr_of_all[i] = compile_statement(asts[i], &instr_count_of_all[i]);\n78\t    }\n79\t\n80\t    for (int i=0; asts[i] != NULL; i++) {\n81\t        *total_instr_count += instr_count_of_all[i];\n82\t    }\n83\t\n84\t    // concat all instructions\n85\t    Instruction * all_instr = (Instruction *) malloc(sizeof(Instruction) * *total_instr_count);\n86\t    memcpy(all_instr, instr_of_all[0], sizeof(Instruction) * instr_count_of_all[0]);\n87\t    int copied_count = instr_count_of_all[0];\n88\t    for (int i=1; asts[i] != NULL ; i++) {\n89\t        memcpy(&all_instr[copied_count], instr_of_all[i],\n90\t               sizeof(Instruction) * instr_count_of_all[i]);\n91\t        copied_count += instr_count_of_all[i];\n92\t    }\n93\t\n94\t    return all_instr;\n95\t}\n96\t\n97\tInstruction *\n98\tcompile(const char* source, int* instr_count)\n99\t{\n100\t    Token* tokens = tokenize(source);\n101\t    ASTNode** ast_nodes = parse(tokens);\n102\t    Instruction * instructions =  compile_asts(ast_nodes, instr_count);\n103\t\n104\t    return  instructions;\n105\t}"}]},"parent_tool_use_id":null,"session_id":"c0f90f2c-b3db-4481-a5c4-34e037f51c01","uuid":"f16a1f9f-5c45-4731-b03d-26fc5f958f2b","times