{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01FMRXUXdRbdqGwBWRbkmreq","type":"tool_result","content":"1\t#ifndef CARRAYS_H_\n2\t#define CARRAYS_H_\n3\t\n4\t//\n5\t// Generic C Arrays\n6\t//\n7\t// All functions have the gca_ prefix\n8\t//\n9\t// 2015-10-24 Isaac Turner (turner.isaac@gmail.com)\n10\t//\n11\t\n12\t#include <stdlib.h>\n13\t#include <inttypes.h>\n14\t#include <stdbool.h>\n15\t\n16\t\n17\tstatic inline uint32_t gca_roundup32(uint32_t x) {\n18\t  return (--x, x|=x>>1, x|=x>>2, x|=x>>4, x|=x>>8, x|=x>>16, ++x);\n19\t}\n20\t\n21\tstatic inline uint64_t gca_roundup64(uint64_t x) {\n22\t  return (--x, x|=x>>1, x|=x>>2, x|=x>>4, x|=x>>8, x|=x>>16, x|=x>>32, ++x);\n23\t}\n24\t\n25\t#ifndef SWAP\n26\t  #define SWAP(x,y) do { __typeof(x) _tmp = (x); (x) = (y); (y) = _tmp; } while(0)\n27\t#endif\n28\t\n29\t// Resize an array only if needed\n30\t// If resized new number of elements is power of two\n31\t// New elements are initialised to zero\n32\tstatic inline void* gca_capacity(void *ptr, size_t *size, size_t es,\n33\t                                 size_t new_size)\n34\t{\n35\t  if(new_size > *size) {\n36\t    new_size = gca_roundup64(new_size);\n37\t    if((ptr = realloc(ptr, new_size * es)) == NULL) return NULL;\n38\t    memset((char*)ptr+es*(*size), 0, es*(new_size - *size));\n39\t    *size = new_size;\n40\t  }\n41\t  return ptr;\n42\t}\n43\t\n44\t#define gca_resize(b, n, new_n) \\\n45\t  do { (b) = gca_capacity(b, &(n), sizeof((b)[0]), (new_n)); } while(0)\n46\t\n47\t// comparison returns:\n48\t//   negative iff a < b\n49\t//          0 iff a == b\n50\t//   positive iff a > b\n51\t\n52\t#define gca_cmp(a,b) (((a) > (b)) - ((b) > (a)))\n53\t\n54\t#define cmpfunc(fname,fname2,type_t,cmp)                                       \\\n55\tstatic inline int fname(const void *aa, const void *bb) __attribute__((unused));\\\n56\tstatic inline int fname(const void *aa, const void *bb) {                      \\\n57\t  const type_t a = *(const type_t *)aa;                                        \\\n58\t  const type_t b = *(const type_t *)bb;                                        \\\n59\t  return cmp(a, b);                                                            \\\n60\t}                                                                              \\\n61\tstatic inline int fname2(const void *aa, const void *bb, void *p)              \\\n62\t  __attribute__((unused));                                                     \\\n63\tstatic inline int fname2(const void *aa, const void *bb, void *p) {            \\\n64\t  (void)p;                                                                     \\\n65\t  const type_t a = *(const type_t *)aa;                                        \\\n66\t  const type_t b = *(const type_t *)bb;                                        \\\n67\t  return cmp(a, b);                                                            \\\n68\t}\n69\tcmpfunc(gca_cmp_char,    gca_cmp2_char,    char,        gca_cmp);\n70\tcmpfunc(gca_cmp_int,     gca_cmp2_int,     int,         gca_cmp);\n71\tcmpfunc(gca_cmp_long,    gca_cmp2_long,    long,        gca_cmp);\n72\tcmpfunc(gca_cmp_float,   gca_cmp2_float,   float,       gca_cmp);\n73\tcmpfunc(gca_cmp_double,  gca_cmp2_double,  double,      gca_cmp);\n74\tcmpfunc(gca_cmp_int8,    gca_cmp2_int8,    int8_t,      gca_cmp);\n75\tcmpfunc(gca_cmp_int16,   gca_cmp2_int16,   int16_t,     gca_cmp);\n76\tcmpfunc(gca_cmp_int32,   gca_cmp2_int32,   int32_t,     gca_cmp);\n77\tcmpfunc(gca_cmp_int64,   gca_cmp2_int64,   int64_t,     gca_cmp);\n78\tcmpfunc(gca_cmp_uint8,   gca_cmp2_uint8,   uint8_t,     gca_cmp);\n79\tcmpfunc(gca_cmp_uint16,  gca_cmp2_uint16,  uint16_t,    gca_cmp);\n80\tcmpfunc(gca_cmp_uint32,  gca_cmp2_uint32,  uint32_t,    gca_cmp);\n81\tcmpfunc(gca_cmp_uint64,  gca_cmp2_uint64,  uint64_t,    gca_cmp);\n82\tcmpfunc(gca_cmp_size,    gca_cmp2_size,    size_t,      gca_cmp);\n83\tcmpfunc(gca_cmp_ptr,     gca_cmp2_ptr,     void *const, gca_cmp);\n84\tcmpfunc(gca_cmp_charptr, gca_cmp2_charptr, char *const, strcmp);\n85\t#undef cmpfunc\n86\t\n87\t\n88\t#define searchfunc(fname,type_t,cmp)                                           \\\n89\tstatic inline int fname(const void *aa, void *bb) __attribute__((unused));     \\\n90\tstatic inline int fname(const void *aa, void *bb) {                            \\\n91\t  const type_t a = *(const type_t *)aa;                                        \\\n92\t  const type_t b = *(type_t *)bb;                                              \\\n93\t  return cmp(a, b);                                                            \\\n94\t}\n95\tsearchfunc(gca_search_char,    char,        gca_cmp);\n96\tsearchfunc(gca_search_int,     int,         gca_cmp);\n97\tsearchfunc(gca_search_long,    long,        gca_cmp);\n98\tsearchfunc(gca_search_float,   float,       gca_cmp);\n99\tsearchfunc(gca_search_double,  double,      gca_cmp);\n100\tsearchfunc(gca_search_int8,    int8_t,      gca_cmp);\n101\tsearchfunc(gca_search_int16,   int16_t,     gca_cmp);\n102\tsearchfunc(gca_search_int32,   int32_t,     gca_cmp);\n103\tsearchfunc(gca_search_int64,   int64_t,     gca_cmp);\n104\tsearchfunc(gca_search_uint8,   uint8_t,     gca_cmp);\n105\tsearchfunc(gca_search_uint16,  uint16_t,    gca_cmp);\n106\tsearchfunc(gca_search_uint32,  uint32_t,    gca_cmp);\n107\tsearchfunc(gca_search_uint64,  uint64_t,    gca_cmp);\n108\tsearchfunc(gca_search_size,    size_t,      gca_cmp);\n109\tsearchfunc(gca_search_ptr,     void *const, gca_cmp);\n110\tsearchfunc(gca_search_charptr, char *const, strcmp);\n111\t#undef searchfunc\n112\t\n113\t// Get Greatest Common Divisor using binary GCD algorithm\n114\t// http://en.wikipedia.org/wiki/Binary_GCD_algorithm\n115\tuint32_t gca_calc_GCD(uint32_t a, uint32_t b);\n116\t\n117\tstatic inline void gca_swapm(void *aa, void *bb, size_t es)\n118\t{\n119\t  char *end, *a = (char*)aa, *b = (char*)bb, tmp;\n120\t  for(end = a + es; a < end; a++, b++) { tmp = *a; *a = *b; *b = tmp; }\n121\t}\n122\t\n123\t// cyclic-shift an array by `shift` elements\n124\t// cycle left shifts towards zero\n125\tvoid gca_cycle_left(void *_ptr, size_t n, size_t es, size_t shift);\n126\t// cycle right shifts away from zero\n127\tvoid gca_cycle_right(void *_ptr, size_t n, size_t es, size_t shift);\n128\t\n129\t// Reverse order of elements in an array\n130\tvoid gca_reverse(void *_ptr, size_t n, size_t es);\n131\t\n132\t// Shuffle entire array\n133\t// Fisher-Yates shuffle. Initiate srand() before calling.\n134\tvoid gca_shuffle(void *_ptr, size_t n, size_t es);\n135\t\n136\t// Sample m elements by moving them to the front of the array\n137\t// Fisher-Yates shuffle. Initiate srand() before calling.\n138\tvoid gca_sample(void *base, size_t n, size_t es, size_t m);\n139\t\n140\t//\n141\t// Permutations\n142\t//\n143\t\n144\t/*\n145\t * Permutation example:\n146\t *\n147\t\n148\t  size_t n = 5;\n149\t  int *d = ...;\n150\t  size_t *p = NULL;\n151\t\n152\t  while(gca_itr_next(&p, n))\n153\t    printf(\"%i %i %i %i %i\", d[p[0]], d[p[1]], d[p[2]], d[p[3]], d[p[4]]);\n154\t\n155\t  // Reset and loop over all permutations again\n156\t  p = gca_itr_reset(p, n);\n157\t  while(gca_itr_next(&p, n, NULL))\n158\t    printf(\"%i %i %i %i %i\", d[p[0]], d[p[1]], d[p[2]], d[p[3]], d[p[4]]);\n159\t\n160\t  // release iterator memory\n161\t  free(p);\n162\t\n163\t*/\n164\t\n165\tsize_t* gca_itr_reset(size_t *p, size_t n);\n166\tsize_t* gca_itr_next(size_t **pp, size_t n, size_t *init);\n167\t\n168\t//\n169\t// binary search\n170\t//\n171\t\n172\t// searchf is a function that compares a given value with the value we are\n173\t// searching for. It returns <0 if _val is < target, >0 if _val is > target,\n174\t// 0 otherwise.\n175\tvoid* gca_bsearch(void *_ptr, size_t n, size_t es,\n176\t                  int (*searchf)(const void *_val, void *_arg),\n177\t                  void *arg);\n178\t\n179\t// Linear search\n180\tvoid* gca_lsearch(void *_ptr, size_t n, size_t es,\n181\t                  int (*searchf)(const void *_val, void *_arg),\n182\t                  void *arg);\n183\t\n184\t//\n185\t// Quick sort\n186\t//\n187\t\n188\t// Quicksort Partition \n189\t// Pivot is in first index\n190\t// returns index of pivot after partitioning\n191\tsize_t gca_qpart(void *base, size_t nel, size_t es,\n192\t                 int (*compar)(const void *_a, const void *_b, void *_arg),\n193\t                 void *arg);\n194\t\n195\t// Note: quicksort is not stable, equivalent values may be swapped\n196\tvoid gca_qsort(void *base, size_t nel, size_t es,\n197\t               int (*compar)(const void *_a, const void *_b, void *_arg),\n198\t               void *arg);\n199\t\n200\t// Get the k-th smallest element from unsorted array, using quickselect\n201\tvoid* gca_qselect(void *base, size_t nel, size_t es, size_t kidx,\n202\t                  int (*compar)(const void *_a, const void *_b, void *_arg),\n203\t                  void *arg);\n204\t\n205\t/*\n206\t Get median of array of size_t:\n207\t\n208\t    #define avgfunc(a,b) ((a)+(b)+1.0)/2.0)\n209\t    size_t arr[], n = 10;\n210\t    size_t median = gca_median(arr, n, gca_cmp2_size, NULL, size_t, avgfunc)\n211\t*/\n212\t\n213\t// Undefined if nel == 0\n214\t#define gca_median(base,nel,compar,arg,type,avgfunc) \\\n215\t  (gca_qselect(base,nel,sizeof(type),(nel)/2,compar,arg), \\\n216\t   ((nel)&1 ? *((type*)(base) + (nel)/2) \\\n217\t            : (type)avgfunc(*(type*)gca_max((base),(nel)/2,sizeof(type),compar,arg), \\\n218\t                            *((type*)(base) + (nel)/2))))\n219\t\n220\t// Returns (type)(zero) if nel == 0\n221\t#define gca_median2(base,nel,compar,arg,type,avgfunc,zero) \\\n222\t        (nel ? gca_median(base,nel,compar,arg,type,avgfunc) : (type)(zero))\n223\t\n224\t// Mean function for integers of any size\n225\t// Can overflow, would be better to use: a/2 + b/2 + ((a|b)&1), but if macro\n226\t// uses parameters multiple times, they will be re-calculated\n227\t#define gca_ab_mean_int(a,b) (((a)+(b)+1)/2)\n228\t#define gca_ab_mean_real(a,b) ((a)/2+(b)/2)\n229\t\n230\t#define gca_median_uint32(base,nel) gca_median2(base,nel,gca_cmp2_uint32,NULL,uint32_t,gca_ab_mean_int,0)\n231\t#define gca_median_uint64(base,nel) gca_median2(base,nel,gca_cmp2_uint64,NULL,uint64_t,gca_ab_mean_int,0)\n232\t#define gca_median_int(base,nel)    gca_median2(base,nel,gca_cmp2_int,   NULL,int,     gca_ab_mean_int,0)\n233\t#define gca_median_long(base,nel)   gca_median2(base,nel,gca_cmp2_long,  NULL,long,    gca_ab_mean_int,0)\n234\t#define gca_median_size(base,nel)   gca_median2(base,nel,gca_cmp2_size,  NULL,size_t,  gca_ab_mean_int,0)\n235\t#define gca_median_float(base,nel)  gca_median2(base,nel,gca_cmp2_float, NULL,float,   gca_ab_mean_real,0.0)\n236\t#define gca_median_double(base,nel) gca_median2(base,nel,gca_cmp2_double,NULL,double,  gca_ab_mean_real,0.0)\n237\t\n238\t//\n239\t// Heapsort\n240\t//\n241\t\n242\t#define gca_heap_parent(idx) (((idx)-1)/2)\n243\t#define gca_heap_child1(idx) (2*(idx)+1)\n244\t#define gca_heap_child2(idx) (2*(idx)+2)\n245\t\n246\t// New element at index nel-1, to be pushed up the heap\n247\tvoid gca_heap_pushup(void *heap, size_t nel, size_t es,\n248\t                     int (*compar)(const void *_a, const void *_b, void *_arg),\n249\t                     void *arg);\n250\t\n251\t// New element at index 0, to be pushed down the heap\n252\tvoid gca_heap_pushdwn(void *heap, size_t nel, size_t es,\n253\t                      int (*compar)(const void *_a, const void *_b, void *_arg),\n254\t                      void *arg);\n255\t\n256\tvoid gca_heap_make(void *base, size_t nel, size_t es,\n257\t                   int (*compar)(const void *_a, const void *_b, void *_arg),\n258\t                   void *arg);\n259\t\n260\tvoid gca_heap_sort(void *heap, size_t nel, size_t es,\n261\t                   int (*compar)(const void *_a, const void *_b, void *_arg),\n262\t                   void *arg);\n263\t\n264\t//\n265\t// To heapsort an array:\n266\t//   gca_heap_make(...)\n267\t//   gca_heap_sort(...)\n268\t//\n269\t\n270\t//\n271\t// Median\n272\t//\n273\t\n274\t// Get pointer to median of three elements, using three comparisons\n275\tvoid* gca_median3(void *p0, void *p1, void *p2,\n276\t                  int (*compar)(const void *_a, const void *_b, void *_arg),\n277\t                  void *arg);\n278\t\n279\t// Get pointer to median of five elements, using six comparisons\n280\tvoid* gca_median5(void *p0, void *p1, void *p2, void *p3, void *p4,\n281\t                  int (*compar)(const void *_a, const void *_b, void *_arg),\n282\t                  void *arg);\n283\t\n284\t//\n285\t// Insertion sort and merging\n286\t//\n287\t\n288\t/**\n289\t * Insertion sort, sorted elements first, then unsorted\n290\t * @param ptr points to sorted array\n291\t * @param n is number of sorted elements\n292\t * @param m is number of unsorted elements AFTER ptr+n sorted to merge in\n293\t * @param el is element size\n294\t * @param compar is comparison function\n295\t * @param arg is pointer to pass to comparison function\n296\t */\n297\tstatic inline void gca_isortr(void *_ptr, size_t n, size_t m, size_t el,\n298\t                              int (*compar)(const void *_a, const void *_b,\n299\t                                            void *_arg),\n300\t                              void *arg)\n301\t{\n302\t  char *b = (char*)_ptr, *pi, *pj, *end = b+el*(n+m);\n303\t  for(pi = b+el*n; pi < end; pi += el)\n304\t    for(pj = pi; pj > b && compar(pj-el,pj,arg) > 0; pj -= el)\n305\t      gca_swapm(pj-el, pj, el);\n306\t}\n307\t\n308\t/**\n309\t * Insertion sort unsorted elements first, then sorted\n310\t * @param ptr points to sorted array\n311\t * @param n is number of sorted elements\n312\t * @param m is number of unsorted elements BEFORE ptr\n313\t * @param el is element size\n314\t * @param compar is comparison function\n315\t * @param arg is pointer to pass to comparison function\n316\t */\n317\tstatic inline void gca_isortf(void *_ptr, size_t n, size_t m, size_t el,\n318\t                              int (*compar)(const void *_a, const void *_b,\n319\t                                            void *_arg),\n320\t                              void *arg)\n321\t{\n322\t  char *b = (char*)_ptr, *pi, *pj, *start = b-el*m, *end = b+el*n;\n323\t  for(pi = b; pi > start; pi -= el)\n324\t    for(pj = pi; pj < end && compar(pj-el, pj, arg) > 0; pj += el)\n325\t      gca_swapm(pj-el, pj, el);\n326\t}\n327\t\n328\t/**\n329\t * Insertion sort merging between two adjacent sorted arrays\n330\t * @param ptr points to array\n331\t * @param n is number of sorted elements\n332\t * @param m is number of sorted elements\n333\t * @param el is element size\n334\t * @param compar is comparison function\n335\t * @param arg is pointer to pass to comparison function\n336\t */\n337\tstatic inline void gca_imerge(void *_ptr, size_t n, size_t m, size_t el,\n338\t                              int (*compar)(const void *_a, const void *_b,\n339\t                                            void *_arg),\n340\t                              void *arg)\n341\t{\n342\t  char *b = (char*)_ptr, *pi, *pj, *end = b+el*(n+m);\n343\t  for(pi = b+el*n; pi < end; pi += el) {\n344\t    for(pj = pi; pj > b && compar(pj-el,pj,arg) > 0; pj -= el)\n345\t      gca_swapm(pj-el, pj, el);\n346\t    if(pj == pi) break;\n347\t  }\n348\t}\n349\t\n350\t// Merge two sorted arrays to create a merged sorted array\n351\tvoid gca_merge(void *_dst, size_t ndst, size_t nsrc, size_t es,\n352\t               int (*compar)(const void *_a, const void *_b, void *_arg),\n353\t               void *arg);\n354\t\n355\t//\n356\t// Check if an array is sorted\n357\t//\n358\tstatic inline bool gca_is_sorted(void *base, size_t nel, size_t es,\n359\t                                 int (*compar)(const void *_a, const void *_b,\n360\t                                               void *_arg),\n361\t                                 void *arg)\n362\t{\n363\t  char *b = (char*)base, *end = b+es*nel, *ptr;\n364\t  for(ptr = b; ptr+es < end; ptr += es)\n365\t    if(compar(ptr, ptr+es, arg) > 0)\n366\t      return false;\n367\t  return true;\n368\t}\n369\t\n370\tstatic inline bool gca_is_rsorted(void *base, size_t nel, size_t es,\n371\t                                  int (*compar)(const void *_a, const void *_b,\n372\t                                                void *_arg),\n373\t                                  void *arg)\n374\t{\n375\t  char *b = (char*)base, *end = b+es*nel, *ptr;\n376\t  for(ptr = b; ptr+es < end; ptr += es)\n377\t    if(compar(ptr, ptr+es, arg) < 0)\n378\t      return false;\n379\t  return true;\n380\t}\n381\t\n382\t// Get pointer to max entry using comparison function\n383\tstatic inline void* gca_max(void *base, size_t nel, size_t es,\n384\t                            int (*compar)(const void *_a, const void *_b,\n385\t                                          void *_arg),\n386\t                            void *arg)\n387\t{\n388\t  char *b = (char*)base, *end = b+es*nel, *ptr, *max = base;\n389\t  for(ptr = b+es; ptr < end; ptr += es)\n390\t    if(compar(max, ptr, arg) < 0)\n391\t      max = ptr;\n392\t  return max;\n393\t}\n394\t\n395\t// Get pointer to min entry using comparison function\n396\tstatic inline void* gca_min(void *base, size_t nel, size_t es,\n397\t                            int (*compar)(const void *_a, const void *_b,\n398\t                                          void *_arg),\n399\t                            void *arg)\n400\t{\n401\t  char *b = (char*)base, *end = b+es*nel, *ptr, *min = base;\n402\t  for(ptr = b+es; ptr < end; ptr += es)\n403\t    if(compar(min, ptr, arg) > 0)\n404\t      min = ptr;\n405\t  return min;\n406\t}\n407\t\n408\t#endif /* CARRAYS_H_ */\n409\t"}]},"parent_tool_use_id":null,"session_id":"fbd2c864-c82e-4b8f-af8a-b60f30f86fa4","uuid":"f2897ae3-882a-4fba-9d29-f536a72a4c3e","timestamp":"2026-06-01T20:34:42.867Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-sUPSI5/project/c_src/src/carrays.h","content":"#ifndef CARRAYS_H_\n#define CARRAYS_H_\n\n//\n// Generic C Arrays\n//\n// All functions have the gca_ prefix\n//\n// 2015-10-24 Isaac Turner (turner.isaac@gmail.com)\n//\n\n#include <stdlib.h>\n#include <inttypes.h>\n#include <stdbool.h>\n\n\nstatic inline uint32_t gca_roundup32(uint32_t x) {\n  return (--x, x|=x>>1, x|=x>>2, x|=x>>4, x|=x>>8, x|=x>>16, ++x);\n}\n\nstatic inline uint64_t gca_roundup64(uint64_t x) {\n  return (--x, x|=x>>1, x|=x>>2, x|=x>>4, x|=x>>8, x|=x>>16, x|=x>>32, ++x);\n}\n\n#ifndef SWAP\n  #define SWAP(x,y) do { __typeof(x) _tmp = (x); (x) = (y); (y) = _tmp; } while(0)\n#endif\n\n// Resize an array only if needed\n// If resized new number of elements is power of two\n// New elements are initialised to zero\nstatic inline void* gca_capacity(void *ptr, size_t *size, size_t es,\n                                 size_t new_size)\n{\n  if(new_size > *size) {\n    new_size = gca_roundup64(new_size);\n    if((ptr = realloc(ptr, new_size * es)) == NULL) return NULL;\n    memset((char*)ptr+es*(*size), 0, es*(new_size - *size));\n    *size = new_size;\n  }\n  return ptr;\n}\n\n#define gca_resize(b, n, new_n) \\\n  do { (b) = gca_capacity(b, &(n), sizeof((b)[0]), (new_n)); } while(0)\n\n// comparison returns:\n//   negative iff a < b\n//          0 iff a == b\n//   positive iff a > b\n\n#define gca_cmp(a,b) (((a) > (b)) - ((b) > (a)))\n\n#define cmpfunc(fname,fname2,type_t,cmp)                                       \\\nstatic inline int fname(const void *aa, const void *bb) __attribute__((unused));\\\nstatic inline int fname(const void *aa, const void *bb) {                      \\\n  const type_t a = *(const type_t *)aa;                                        \\\n  const type_t b = *(const type_t *)bb;                                        \\\n  return cmp(a, b);                                                            \\\n}                                                                              \\\nstatic inline int fname2(const void *aa, const void *bb, void *p)              \\\n  __attribute__((unused));                                                     \\\nstatic inline int fname2(const void *aa, const void *bb, void *p) {            \\\n  (void)p;                                                                     \\\n  const type_t a = *(const type_t *)aa;                                        \\\n  const type_t b = *(const type_t *)bb;                                        \\\n  return cmp(a, b);                                                            \\\n}\ncmpfunc(gca_cmp_char,    gca_cmp2_char,    char,        gca_cmp);\ncmpfunc(gca_cmp_int,     gca_cmp2_int,     int,         gca_cmp);\ncmpfunc(gca_cmp_long,    gca_cmp2_long,    long,        gca_cmp);\ncmpfunc(gca_cmp_float,   gca_cmp2_float,   float,       gca_cmp);\ncmpfunc(gca_cmp_double,  gca_cmp2_double,  double,      gca_cmp);\ncmpfunc(gca_cmp_int8,    gca_cmp2_int8,    int8_t,      gca_cmp);\ncmpfunc(gca_cmp_int16,   gca_cmp2_int16,   int16_t,     gca_cmp);\ncmpfunc(gca_cmp_int32,   gca_cmp2_int32,   int32_t,     gca_cmp);\ncmpfunc(gca_cmp_int64,   gca_cmp2_int64,   int64_t,     gca_cmp);\ncmpfunc(gca_cmp_uint8,   gca_cmp2_uint8,   uint8_t,     gca_cmp);\ncmpfunc(gca_cmp_uint16,  gca_cmp2_uint16,  uint16_t,    gca_cmp);\ncmpfunc(gca_cmp_uint32,  gca_cmp2_uint32,  uint32_t,    gca_cmp);\ncmpfunc(gca_cmp_uint64,  gca_cmp2_uint64,  uint64_t,    gca_cmp);\ncmpfunc(gca_cmp_size,    gca_cmp2_size,    size_t,      gca_cmp);\ncmpfunc(gca_cmp_ptr,     gca_cmp2_ptr,     void *const, gca_cmp);\ncmpfunc(gca_cmp_charptr, gca_cmp2_charptr, char *const, strcmp);\n#undef cmpfunc\n\n\n#define searchfunc(fname,type_t,cmp)                                           \\\nstatic inline int fname(const void *aa, void *bb) __attribute__((unused));     \\\nstatic inline int fname(const void *aa, void *bb) {                            \\\n  const type_t a = *(const type_t *)aa;                                        \\\n  const type_t b = *(type_t *)bb;                                              \\\n  return cmp(a, b);                                                            \\\n}\nsearchfunc(gca_search_char,    char,        gca_cmp);\nsearchfunc(gca_search_int,     int,         gca_cmp);\nsearchfunc(gca_search_long,    long,        gca_cmp);\nsearchfunc(gca_search_float,   float,       gca_cmp);\nsearchfunc(gca_search_double,  double,      gca_cmp);\nsearchfunc(gca_search_int8,    int8_t,      gca_cmp);\nsearchfunc(gca_search_int16,   int16_t,     gca_cmp);\nsearchfunc(gca_search_int32,   int32_t,     gca_cmp);\nsearchfunc(gca_search_int64,   int64_t,     gca_cmp);\nsearchfunc(gca_search_uint8,   uint8_t,     gca_cmp);\nsearchfunc(gca_search_uint16,  uint16_t,    gca_cmp);\nsearchfunc(gca_search_uint32,  uint32_t,    gca_cmp);\nsearchfunc(gca_search_uint64,  uint64_t,    gca_cmp);\nsearchfunc(gca_search_size,    size_t,      gca_cmp);\nsearchfunc(gca_search_ptr,     void *const, gca_cmp);\nsearchfunc(gca_search_charptr, char *const, strcmp);\n#undef searchfunc\n\n// Get Greatest Common Divisor using binary GCD algorithm\n// http://en.wikipedia.org/wiki/Binary_GCD_algorithm\nuint32_t gca_calc_GCD(uint32_t a, uint32_t b);\n\nstatic inline void gca_swapm(void *aa, void *bb, size_t es)\n{\n  char *end, *a = (char*)aa, *b = (char*)bb, tmp;\n  for(end = a + es; a < end; a++, b++) { tmp = *a; *a = *b; *b = tmp; }\n}\n\n// cyclic-shift an array by `shift` elements\n// cycle left shifts towards zero\nvoid gca_cycle_left(void *_ptr, size_t n, size_t es, size_t shift);\n// cycle right shifts away from zero\nvoid gca_cycle_right(void *_ptr, size_t n, size_t es, size_t shift);\n\n// Reverse order of elements in an array\nvoid gca_reverse(void *_ptr, size_t n, size_t es);\n\n// Shuffle entire array\n// Fisher-Yates shuffle. Initiate srand() before calling.\nvoid gca_shuffle(void *_ptr, size_t n, size_t es);\n\n// Sample m