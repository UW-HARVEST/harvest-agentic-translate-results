54\tconst KEY_OFFSET: u8 = 0x63;\n55\tlet mut k = vec![0u64; RANDOM_BYTES_NEEDED_FOR_CLHASH];\n56\tfor j2 in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {\n57\tk[j2] = (j2 + KEY_OFFSET as usize) as u64 & 0xFF;\n58\t}\n59\tlet k = (k[0], k[1]);\n60\tfor i in 1..NUM_TRIALS {\n61\tfor j in 1..=std::mem::size_of::<u64>() {\n62\tlet mlen = i * CLNH_NUM_BYTES_PER_BLOCK + j;\n63\tlet mut m = vec![0u8; mlen];\n64\tfor j2 in 0..mlen {\n65\tm[j2] = (j2 & 0xFF) as u8;\n66\t}\n67\tlet k = [k.0, k.1];\n68\tlet actual1 = clhash(bytemuck::bytes_of(&k), &m);\n69\tm[mlen - 1] = (m[mlen - 1] + 1) & 0xFF;\n70\tlet actual2 = clhash(bytemuck::bytes_of(&k), &m);\n71\tlet are_equal = actual1 == actual2;\n72\tif are_equal {\n73\tprintln!(\"Testing {} bytes, H1: {:X}, H2: {:X}, equal: {}\", mlen, actual1, actual2, are_equal);\n74\t}\n75\tassert!(!are_equal);\n76\t}\n77\t}\n78\tprintln!(\"Test passed!\");\n79\t}\n80\t\n81\t#[test]\n82\tfn clhash_test() {\n83\tconst N: usize = 1024;\n84\tlet mut array = vec![0u8; N];\n85\tlet mut rs = vec![0u64; RANDOM_BYTES_NEEDED_FOR_CLHASH];\n86\tfor k in 0..RANDOM_BYTES_NEEDED_FOR_CLHASH {\n87\trs[k] = (1 - k) as u64;\n88\t}\n89\t// convert the vec into a tuple of (&[u8], &[u8])\n90\tlet rs = [rs[0], rs[1]];\n91\tlet rs_bytes: &[u8] = bytemuck::bytes_of(&rs);\n92\tprintln!(\"[clhashtest] checking that flipping a bit changes hash value with clhash\");\n93\tfor bit in 0..64 {\n94\tfor length in ((bit + 8) / 8)..=std::mem::size_of::<u64>() {\n95\tlet mut x: u64 = 0;\n96\tlet orig = clhash(rs_bytes, &x.to_le_bytes()[..length]);\n97\tx ^= 1 << bit;\n98\tlet flip = clhash(rs_bytes, &x.to_le_bytes()[..length]);\n99\tassert_ne!(flip, orig);\n100\tx ^= 1 << bit;\n101\tlet back = clhash(rs_bytes, &x.to_le_bytes()[..length]);\n102\tassert_eq!(back, orig);\n103\t}\n104\t}\n105\tprintln!(\"Test passed!\");\n106\t}\n107\t#[test]\n108\tfn demo() {\n109\tlet random = get_random_key_for_clhash(0x23a23cf5033c3c81, 0xb3816f6a2c68e530);\n110\tlet hashvalue1 = clhash(&random, b\"my dog