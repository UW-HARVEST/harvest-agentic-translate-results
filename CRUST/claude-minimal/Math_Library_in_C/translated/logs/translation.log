as i64) as f64 {\n        -S21_NAN\n    } else if exp == 0.0 {\n        1.0\n    } else {\n        let mut flag: f64 = 1.0;\n        let mut b = base;\n        if b < 0.0 && (exp as i64) % 2 != 0 {\n            flag = -1.0;\n        }\n        if b < 0.0 {\n            b = -b;\n        }\n        let div: i64 = exp as i64;\n        // Compute b^div via binary exponentiation. The C version uses a\n        // simple linear loop; this is mathematically identical but\n        // accumulates far less round-off in 64-bit f64, matching the\n        // precision the C version enjoys with 80-bit long double.\n        let mut integer_part: f64 = 1.0;\n        let mut acc = b;\n        let mut e = div;\n        while e > 0 {\n            if e & 1 == 1 {\n                integer_part *= acc;\n            }\n            acc *= acc;\n            e >>= 1;\n        }\n        integer_part * castom_exp((exp - div as f64) * castom_log(b)) * flag\n    }\n}\n\npub fn castom_abs(x: i32) -> i32 {\n    if x > 0 {\n        x\n    } else {\n        -x\n    }\n}\n\npub fn castom_log(x: f64) -> f64 {\n    let mut a: u32 = 0;\n    let mut b: f64 = 0.0;\n    if x > 0.0 {\n        let mut c: f64 = if x < 1.0 { 1.0 / x } else { x };\n        loop {\n            c /= S21_M_E;\n            if !(c > 1.0) {\n                break;\n            }\n            a += 1;\n        }\n        c = 1.0 / (c * S21_M_E - 1.0);\n        c = c + c + 1.0;\n        let f = c * c;\n        b = 0.0;\n        let mut d: u32 = 1;\n        c /= 2.0;\n        loop {\n            let e = b;\n            b += 1.0 / (d as f64 * c);\n            if b - e == 0.0 {\n                break;\n            }\n            d += 2;\n            c *= f;\n        }\n    } else {\n        // (x == 0) / 0.0: if x == 0 -> 1/0 = +inf; otherwise 0/0 = NaN\n        b = if x == 0.0 { 1.0 / 0.0 } else { 0.0 / 0.0 };\n    }\n    if x < 1.0 {\n        -((a as f64) + b)\n    } else {\n        (a as f64) + b\n    }\n}\n\npub fn castom_sin(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut sum: f64 = 0.0;\n    for i in 0..=20i32 {\n        let mut fa: f64 = 1.0;\n        let mut p: f64 = 1.0;\n        let mut j: i32 = 1;\n        while j <= 2 * i + 1 {\n            fa *= j as f64;\n            p *= x;\n            j += 1;\n        }\n        sum += (if i % 2 != 0 { -1.0 } else { 1.0 } / fa) * p;\n    }\n    sum\n}\n\npub fn castom_cos(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut t_s: f64 = 0.0;\n    let mut last: f64 = 1.0;\n    let mut k: i32 = 1;\n    while castom_fabs(last) > EPS_10 {\n        t_s += last;\n        last *= -x * x / (2.0 * k as f64 - 1.0) / (2.0 * k as f64);\n        k += 1;\n    }\n    t_s\n}\n\npub fn castom_fabs(x: f64) -> f64 {\n    if x > 0.0 {\n        x\n    } else {\n        -x\n    }\n}\n","structuredPatch":[{"oldStart":77,"oldLines":9,"newStart":77,"newLines":15,"lines":["     // series builds partial sums of magnitude ~1e34, which destroys all","     // low-order precision. Range reduction keeps the Taylor argument","     // small and recovers near-bit-perfect precision.","+    // Cody-Waite split of ln(2): LN2_HI has a short mantissa so that","+    // k * LN2_HI is computed exactly for the k values that arise here,","+    // and LN2_LO supplies the remaining bits. This gives near-bit-perfect","+    // r and recovers the precision the C version got from long double.","+    const LN2_HI: f64 = 6.93147180369123816490e-01;","+    const LN2_LO: f64 = 1.90821492927058770002e-10;","     const LN2: f64 = 0.6931471805599453;","     let k = (x / LN2).round() as i32;","-    let r = x - (k as f64) * LN2;","+    let r = (x - (k as f64) * LN2_HI) - (k as f64) * LN2_LO;"," ","     let mut sum: f64 = 1.0;","     let mut cur: f64 = 1.0;"]}],"userModified":false,"replaceAll":false}}
