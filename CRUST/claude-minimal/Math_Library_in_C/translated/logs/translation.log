 x / (2.0 * k as f64 - 1.0) / (2.0 * k as f64);\n        k += 1;\n    }\n    t_s\n}\n\npub fn castom_fabs(x: f64) -> f64 {\n    if x > 0.0 {\n        x\n    } else {\n        -x\n    }\n}\n","structuredPatch":[{"oldStart":70,"oldLines":32,"newStart":70,"newLines":15,"lines":[" }"," "," pub fn castom_exp(x: f64) -> f64 {","-    // Range reduction via repeated halving: exp(x) = exp(x / 2^k)^(2^k).","-    // This compensates for precision loss when translating the C","-    // implementation (which used 80-bit long double) into 64-bit f64, by","-    // keeping the Taylor series argument very small so the series converges","-    // with minimal accumulated round-off.","-    let mut k: i32 = 0;","-    let mut x_red = x;","-    while castom_fabs(x_red) > 1.0 / 1024.0 {","-        x_red /= 2.0;","-        k += 1;","-    }","-    // Use full f64 epsilon so the series accumulates near-bit-perfect precision","-    // rather than stopping at EPS_10 (which loses ~6 digits of precision).","     let mut sum: f64 = 1.0;","     let mut cur: f64 = 1.0;","     let mut n: u32 = 1;","-    while castom_fabs(cur) > 1e-20 {","-        cur *= x_red / n as f64;","+    while castom_fabs(cur) > EPS_10 {","+        cur *= x / n as f64;","         sum += cur;","         n += 1;","     }","-    let mut result = sum;","-    for _ in 0..k {","-        result *= result;","-    }","-    result","+    sum"," }"," "," pub fn castom_factorial(n: u64) -> u64 {"]}],"userModified":false,"replaceAll":false}}
