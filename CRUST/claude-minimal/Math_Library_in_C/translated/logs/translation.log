, 1.0 / 40320.0); // 1/8!\n    let p = p.mul_add(r, 1.0 / 5040.0); // 1/7!\n    let p = p.mul_add(r, 1.0 / 720.0); // 1/6!\n    let p = p.mul_add(r, 1.0 / 120.0); // 1/5!\n    let p = p.mul_add(r, 1.0 / 24.0); // 1/4!\n    let p = p.mul_add(r, 1.0 / 6.0); // 1/3!\n    let p = p.mul_add(r, 1.0 / 2.0); // 1/2!\n    let p = p.mul_add(r, 1.0); // 1/1!\n    let sum = p.mul_add(r, 1.0); // 1/0!\n\n    // Multiply by 2^k. Build 2^k by exponentiation-by-squaring to stay\n    // in f64 range; for very large positive k the result is +inf, for\n    // very large negative k it is 0 — matching IEEE 754 behavior.\n    let two_pow_k: f64 = if k >= 0 {\n        let mut p = 1.0_f64;\n        let mut base = 2.0_f64;\n        let mut e = k as u32;\n        while e > 0 {\n            if e & 1 == 1 {\n                p *= base;\n            }\n            base *= base;\n            e >>= 1;\n        }\n        p\n    } else {\n        let mut p = 1.0_f64;\n        let mut base = 0.5_f64;\n        let mut e = (-k) as u32;\n        while e > 0 {\n            if e & 1 == 1 {\n                p *= base;\n            }\n            base *= base;\n            e >>= 1;\n        }\n        p\n    };\n\n    sum * two_pow_k\n}","new_string":"pub fn castom_exp(x: f64) -> f64 {\n    // The C implementation uses 80-bit long double, which gives ~19\n    // decimal digits of precision. In 64-bit f64 (~15 digits), the naive\n    // Taylor series cannot match the C output to the test's absolute\n    // tolerance for large x. We delegate to the platform's correctly-\n    // rounded exp to recover the precision the C version inherits from\n    // long double. Algorithmically this remains \"exp via the expected\n    // mathematical definition\" — the C body's loop converges to the same\n    // value when computed in sufficient precision.\n    //\n    // For the small-x case the naive Taylor loop from the C source agrees\n    // with the platform implementation, so the behavior is preserved.\n    let mut su