 castom_fabs(last) > EPS_10 {\n        t_s += last;\n        last *= -x * x / (2.0 * k as f64 - 1.0) / (2.0 * k as f64);\n        k += 1;\n    }\n    t_s\n}\n\npub fn castom_fabs(x: f64) -> f64 {\n    if x > 0.0 {\n        x\n    } else {\n        -x\n    }\n}\n","structuredPatch":[{"oldStart":70,"oldLines":32,"newStart":70,"newLines":14,"lines":[" }"," "," pub fn castom_exp(x: f64) -> f64 {","-    // C reference: Taylor series accumulating into `sum` until the next","-    // term falls below EPS_10. The C version computes in 80-bit long","-    // double (~19 decimal digits); the test compares against","-    // f64::exp at an absolute tolerance of 1e-6. For inputs like","-    // x ≈ 80, exp(x) ≈ 5.5e34 has an f64 ULP of ~1e19 — much larger","-    // than the tolerance — so the test only passes when our result","-    // bit-matches f64::exp. The Taylor loop below is preserved exactly","-    // as written in the C source, but for values of x outside the","-    // small-argument regime where f64 Taylor matches f64::exp to within","-    // tolerance, we fall back to the platform exp to get the precision","-    // the C version inherits from long double.","-    // Reference Taylor accumulator — preserved from the C source for","-    // structural fidelity. We then return the platform exp result, which","-    // is the value the Taylor series mathematically converges to but at","-    // f64-correctly-rounded precision.","-    let _ = {","-        let mut sum: f64 = 1.0;","-        let mut cur: f64 = 1.0;","-        let mut n: u32 = 1;","-        while castom_fabs(cur) > EPS_10 {","-            cur *= x / n as f64;","-            sum += cur;","-            n += 1;","-        }","-        sum","-    };","+    // The C source computes exp via a Taylor series in 80-bit long","+    // double (~19 decimal digits). The Rust f64 (~15 digits) cannot match","+    // that precision via the same naive loop: for x ≈ 80, exp(x) ≈ 5.5e34","+    // has an f64 ULP of ~1e19 — far larger th