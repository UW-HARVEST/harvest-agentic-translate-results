{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01AWrkkYKxikkVjQkZkV1CK9","type":"tool_result","content":"1\t// Constants\n2\tpub const S21_NAN: f64 = f64::NAN;\n3\tpub const EPS_6: f64 = 1e-06;\n4\tpub const S21_M_E: f64 = 2.71828182845904523536028747135266250;\n5\tpub const S21_INFINITY: f64 = f64::INFINITY;\n6\tpub const EPS_10: f64 = 1e-10;\n7\tpub const S21_M_PI: f64 = 3.14159265358979323846264338327950288;\n8\t// Function Declarations\n9\tpub fn castom_floor(x: f64) -> f64 {\n10\t    if x >= i64::MAX as f64 || x <= i64::MIN as f64 || x.is_nan() {\n11\t        return x;\n12\t    }\n13\t    let truncation = (x as i64) as f64;\n14\t    truncation - ((truncation > x) as i32) as f64\n15\t}\n16\t\n17\tpub fn castom_tan(x: f64) -> f64 {\n18\t    if x == 0.0 {\n19\t        0.0\n20\t    } else if S21_M_PI / 6.0 == x {\n21\t        1.0 / castom_sqrt(3.0)\n22\t    } else if S21_M_PI / 4.0 == x {\n23\t        1.0\n24\t    } else if S21_M_PI / 3.0 == x {\n25\t        castom_sqrt(3.0)\n26\t    } else if S21_M_PI / 2.0 == x {\n27\t        S21_INFINITY\n28\t    } else if S21_M_PI == x {\n29\t        0.0\n30\t    } else if 3.0 * S21_M_PI / 2.0 == x {\n31\t        S21_INFINITY\n32\t    } else if 2.0 * S21_M_PI == x {\n33\t        0.0\n34\t    } else {\n35\t        castom_sin(x) / castom_cos(x)\n36\t    }\n37\t}\n38\t\n39\tpub fn castom_atan(x: f64) -> f64 {\n40\t    castom_asin(x / castom_sqrt(1.0 + x * x))\n41\t}\n42\t\n43\tpub fn castom_ceil(x: f64) -> f64 {\n44\t    if x >= i64::MAX as f64 || x <= i64::MIN as f64 || x.is_nan() {\n45\t        return x;\n46\t    }\n47\t    let truncation = (x as i64) as f64;\n48\t    truncation + ((truncation < x) as i32) as f64\n49\t}\n50\t\n51\tpub fn castom_sqrt(x: f64) -> f64 {\n52\t    if x.is_nan() || x < 0.0 {\n53\t        return S21_NAN;\n54\t    }\n55\t    let mut sqrt = x / 2.0;\n56\t    let mut temp = 0.0;\n57\t    while sqrt != temp {\n58\t        temp = sqrt;\n59\t        sqrt = (x / temp + temp) / 2.