nd-off.\n    let mut k: i32 = 0;\n    let mut x_red = x;\n    while castom_fabs(x_red) > 1.0 / 1024.0 {\n        x_red /= 2.0;\n        k += 1;\n    }\n    // Use full f64 epsilon so the series accumulates near-bit-perfect precision\n    // rather than stopping at EPS_10 (which loses ~6 digits of precision).\n    let mut sum: f64 = 1.0;\n    let mut cur: f64 = 1.0;\n    let mut n: u32 = 1;\n    while castom_fabs(cur) > 1e-20 {\n        cur *= x_red / n as f64;\n        sum += cur;\n        n += 1;\n    }\n    let mut result = sum;\n    for _ in 0..k {\n        result *= result;\n    }\n    result\n}\n\npub fn castom_factorial(n: u64) -> u64 {\n    let mut result: u64 = 1;\n    let mut i: u64 = 1;\n    while i <= n {\n        result *= i;\n        i += 1;\n    }\n    result\n}\n\npub fn castom_asin(x: f64) -> f64 {\n    let mut term: f64 = x;\n    let mut sum: f64 = S21_NAN;\n    let mut x_local = x;\n    if -1.0 < x_local && x_local < 1.0 {\n        sum = term;\n        x_local *= x_local;\n        let mut k: i32 = 1;\n        while castom_fabs(term) > EPS_10 {\n            term *= x_local * (k as f64) / ((k + 1) as f64);\n            sum += term / ((k + 2) as f64);\n            k += 2;\n        }\n    } else if x_local == 1.0 {\n        sum = S21_M_PI / 2.0;\n    } else if x_local == -1.0 {\n        sum = -S21_M_PI / 2.0;\n    }\n    sum\n}\n\npub fn castom_fmod(x: f64, y: f64) -> f64 {\n    x - castom_trunc(x / y) * y\n}\n\npub fn castom_acos(x: f64) -> f64 {\n    S21_M_PI / 2.0 - castom_asin(x)\n}\n\npub fn castom_pow(base: f64, exp: f64) -> f64 {\n    if base == 0.0 && exp != 0.0 {\n        0.0\n    } else if exp < 0.0 {\n        castom_pow(1.0 / base, -exp)\n    } else if base < 0.0 && exp != (exp as i64) as f64 {\n        -S21_NAN\n    } else if exp == 0.0 {\n        1.0\n    } else {\n        let mut flag: f64 = 1.0;\n        let mut b = base;\n        if b < 0.0 && (exp as i64) % 2 != 0 {\n            flag = -1.0;\n        }\n        if b < 0.0 {\n          