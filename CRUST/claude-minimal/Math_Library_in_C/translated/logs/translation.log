prox_eq(75_f64.powf(16.0), castom_math::castom_pow(75.0, 16.0), castom_math::EPS_6);\n39\t    assert_approx_eq(35.1_f64.powf(7.0), castom_math::castom_pow(35.1, 7.0), castom_math::EPS_6);\n40\t    assert_approx_eq(5.1_f64.powf(4.51), castom_math::castom_pow(5.1, 4.51), castom_math::EPS_6);\n41\t    assert_approx_eq(5.1_f64.powf(1.51), castom_math::castom_pow(5.1, 1.51), castom_math::EPS_6);\n42\t    assert_approx_eq(5.1_f64.powf(0.511), castom_math::castom_pow(5.1, 0.511), castom_math::EPS_6);\n43\t    assert_approx_eq(0_f64.powf(0.511), castom_math::castom_pow(0.0, 0.511), castom_math::EPS_6);\n44\t    assert_approx_eq(1.5_f64.powf(-100.0), castom_math::castom_pow(1.5, -100.0), castom_math::EPS_6);\n45\t    assert_approx_eq((-1.5_f64).powf(8.0), castom_math::castom_pow(-1.5, 8.0), castom_math::EPS_6);\n46\t    assert_approx_eq((-100.0_f64).powf(2.0), castom_math::castom_pow(-100.0, 2.0), castom_math::EPS_6);\n47\t    assert_approx_eq(0_f64.powf(0.0), castom_math::castom_pow(0.0, 0.0), castom_math::EPS_6);\n48\t    assert_approx_eq(2.3_f64.powf(300.0), castom_math::castom_pow(2.3, 300.0), castom_math::EPS_6);\n49\t}\n50\t\n51\t#[test]\n52\tfn castom_test_log() {\n53\t    for i in (-1000..0).map(|x| x as f64 * 0.01) {\n54\t        assert!(castom_math::castom_log(i).is_nan());\n55\t    }\n56\t    for i in (1..=10000).map(|x| x as f64 * 0.1) {\n57\t        assert_approx_eq(i.ln(), castom_math::castom_log(i), castom_math::EPS_6);\n58\t    }\n59\t    assert_approx_eq(1_f64.ln(), castom_math::castom_log(1.0), castom_math::EPS_6);\n60\t    assert_approx_eq(8_f64.ln(), castom_math::castom_log(8.0), castom_math::EPS_6);\n61\t    assert_approx_eq(0.1_f64.ln(), castom_math::castom_log(0.1), castom_math::EPS_6);\n62\t    assert_approx_eq(500_f64.ln(), castom_math::castom_log(500.0), castom_math::EPS_6);\n63\t    assert_approx_eq(1_000_000_f64.ln(), castom_math::castom_log(1_000_000.0), castom_math::EPS_6);\n64\t    assert_approx_eq(0.0000001_f64.ln(), castom_math::castom_log(0.0000001), castom_math::EPS_6);\n65\t    assert_approx_eq(1.5_f64.ln(), castom_math::castom_log(1.5), castom_math::EPS_6);\n66\t    assert_approx_eq(2_f64.ln(), castom_math::castom_log(2.0), castom_math::EPS_6);\n67\t}\n68\t\n69\t#[test]\n70\tfn castom_test_exp() {\n71\t    for j in (-200..=800).map(|x| x as f64 * 0.1) {\n72\t        assert_approx_eq(j.exp(), castom_math::castom_exp(j), castom_math::EPS_6);\n73\t    }\n74\t    assert_approx_eq(5_f64.exp(), castom_math::castom_exp(5.0), castom_math::EPS_6);\n75\t    assert_approx_eq(19_f64.exp(), castom_math::castom_exp(19.0), castom_math::EPS_6);\n76\t    assert_approx_eq((-5_f64).exp(), castom_math::castom_exp(-5.0), castom_math::EPS_6);\n77\t    assert_approx_eq((-15_f64).exp(), castom_math::castom_exp(-15.0), castom_math::EPS_6);\n78\t    assert_approx_eq(0.0000001_f64.exp(), castom_math::castom_exp(0.0000001), castom_math::EPS_6);\n79\t    assert_approx_eq(0_f64.exp(), castom_math::castom_exp(0.0), castom_math::EPS_6);\n80\t    assert_approx_eq((-20_f64).exp(), castom_math::castom_exp(-20.0), castom_math::EPS_6);\n81\t    assert_approx_eq(50_f64.exp(), castom_math::castom_exp(50.0), castom_math::EPS_6);\n82\t    assert_approx_eq(1_f64.exp(), castom_math::castom_exp(1.0), castom_math::EPS_6);\n83\t}\n84\t\n85\t#[test]\n86\tfn castom_test_sqrt() {\n87\t    for j in (1..=2401).map(|x| x as f64 * 0.05) {\n88\t        assert_approx_eq(j.sqrt(), castom_math::castom_sqrt(j), castom_math::EPS_6);\n89\t    }\n90\t    assert_approx_eq(1_f64.sqrt(), castom_math::castom_sqrt(1.0), castom_math::EPS_6);\n91\t    assert_approx_eq(8_f64.sqrt(), castom_math::castom_sqrt(8.0), castom_math::EPS_6);\n92\t    assert_approx_eq(0.1_f64.sqrt(), castom_math::castom_sqrt(0.1), castom_math::EPS_6);\n93\t    assert_approx_eq(500_f64.sqrt(), castom_math::castom_sqrt(500.0), castom_math::EPS_6);\n94\t    assert_approx_eq(1_000_000_f64.sqrt(), castom_math::castom_sqrt(1_000_000.0), castom_math::EPS_6);\n95\t    assert_approx_eq(0.0000001_f64.sqrt(), castom_math::castom_sqrt(0.0000001), castom_math::EPS_6);\n96\t    assert_approx_eq(1.5_f64.sqrt(), castom_math::castom_sqrt(1.5), castom_math::EPS_6);\n97\t    assert_approx_eq(2_f64.sqrt(), castom_math::castom_sqrt(2.0), castom_math::EPS_6);\n98\t    assert!(castom_math::castom_sqrt(-2.0).is_nan());\n99\t}\n100\t\n101\t#[test]\n102\tfn castom_test_ceil() {\n103\t    assert_eq!(1.000001_f64.ceil(), castom_math::castom_ceil(1.000001));\n104\t    assert_eq!(8.44_f64.ceil(), castom_math::castom_ceil(8.44));\n105\t    assert_eq!(0.1_f64.ceil(), castom_math::castom_ceil(0.1));\n106\t    assert_eq!(500.55_f64.ceil(), castom_math::castom_ceil(500.55));\n107\t    assert_eq!(1_000_000.0_f64.ceil(), castom_math::castom_ceil(1_000_000.0));\n108\t    assert_eq!(0.0000001_f64.ceil(), castom_math::castom_ceil(0.0000001));\n109\t    assert_eq!(1.5_f64.ceil(), castom_math::castom_ceil(1.5));\n110\t    assert_eq!(0.0_f64.ceil(), castom_math::castom_ceil(0.0));\n111\t}\n112\t\n113\t#[test]\n114\tfn castom_test_floor() {\n115\t    assert_eq!(1.000001_f64.floor(), castom_math::castom_floor(1.000001));\n116\t    assert_eq!(8.44_f64.floor(), castom_math::castom_floor(8.44));\n117\t    assert_eq!(0.1_f64.floor(), castom_math::castom_floor(0.1));\n118\t    assert_eq!(500.55_f64.floor(), castom_math::castom_floor(500.55));\n119\t    assert_eq!(1_000_000.0_f64.floor(), castom_math::castom_floor(1_000_000.0));\n120\t    assert_eq!(0.0000001_f64.floor(), castom_math::castom_floor(0.0000001));\n121\t    assert_eq!(1.5_f64.floor(), castom_math::castom_floor(1.5));\n122\t    assert_eq!(0.0_f64.floor(), castom_math::castom_floor(0.0));\n123\t    assert_eq!((-1.000001_f64).floor(), castom_math::castom_floor(-1.000001));\n124\t    assert_eq!((-8.44_f64).floor(), castom_math::castom_floor(-8.44));\n125\t    assert_eq!((-0.1_f64).floor(), castom_math::castom_floor(-0.1));\n126\t    assert_eq!((-500.55_f64).floor(), castom_math::castom_floor(-500.55));\n127\t    assert_eq!((-1_000_000.0_f64).floor(), castom_math::castom_floor(-1_000_000.0));\n128\t    assert_eq!((-0.0000001_f64).floor(), castom_math::castom_floor(-0.0000001));\n129\t    assert_eq!((-1.5_f64).floor(), castom_math::castom_floor(-1.5));\n130\t    assert_eq!((-0.0_f64).floor(), castom_math::castom_floor(-0.0));\n131\t}\n132\t\n133\t#[test]\n134\tfn castom_test_trunc() {\n135\t    assert_eq!(1.000001_f64.trunc(), castom_math::castom_trunc(1.000001));\n136\t    assert_eq!(8.44_f64.trunc(), castom_math::castom_trunc(8.44));\n137\t    assert_eq!(0.1_f64.trunc(), castom_math::castom_trunc(0.1));\n138\t    assert_eq!(500.55_f64.trunc(), castom_math::castom_trunc(500.55));\n139\t    assert_eq!(1_000_000.0_f64.trunc(), castom_math::castom_trunc(1_000_000.0));\n140\t    assert_eq!(0.0000001_f64.trunc(), castom_math::castom_trunc(0.0000001));\n141\t    assert_eq!(1.5_f64.trunc(), castom_math::castom_trunc(1.5));\n142\t    assert_eq!(0.0_f64.trunc(), castom_math::castom_trunc(0.0));\n143\t    assert_eq!((-1.000001_f64).trunc(), castom_math::castom_trunc(-1.000001));\n144\t    assert_eq!((-8.44_f64).trunc(), castom_math::castom_trunc(-8.44));\n145\t    assert_eq!((-0.1_f64).trunc(), castom_math::castom_trunc(-0.1));\n146\t    assert_eq!((-500.55_f64).trunc(), castom_math::castom_trunc(-500.55));\n147\t    assert_eq!((-1_000_000.0_f64).trunc(), castom_math::castom_trunc(-1_000_000.0));\n148\t    assert_eq!((-0.0000001_f64).trunc(), castom_math::castom_trunc(-0.0000001));\n149\t    assert_eq!((-1.5_f64).trunc(), castom_math::castom_trunc(-1.5));\n150\t    assert_eq!((-0.0_f64).trunc(), castom_math::castom_trunc(-0.0));\n151\t}\n152\t\n153\t#[test]\n154\tfn castom_test_fmod() {\n155\t    assert_approx_eq(10.5_f64 % -3.0, castom_math::castom_fmod(10.5, -3.0), castom_math::EPS_6);\n156\t    assert_approx_eq(-8.1_f64 % 4.0, castom_math::castom_fmod(-8.1, 4.0), castom_math::EPS_6);\n157\t    assert_approx_eq(-0.0_f64 % 4.4, castom_math::castom_fmod(-0.0, 4.4), castom_math::EPS_6);\n158\t    assert_approx_eq(0.0_f64 % 1.4, castom_math::castom_fmod(0.0, 1.4), castom_math::EPS_6);\n159\t    assert_approx_eq(10.1_f64 % 0.051, castom_math::castom_fmod(10.1, 0.051), castom_math::EPS_6);\n160\t    assert_approx_eq(100_000.1_f64 % -0.1, castom_math::castom_fmod(100_000.1, -0.1), castom_math::EPS_6);\n161\t    assert_approx_eq(100.1_f64 % 0.1, castom_math::castom_fmod(100.1, 0.1), castom_math::EPS_6);\n162\t    assert_approx_eq(0.00005001_f64 % 0.0000001, castom_math::castom_fmod(0.00005001, 0.0000001), castom_math::EPS_6);\n163\t    assert_approx_eq(1.5_f64 % 100.0, castom_math::castom_fmod(1.5, 100.0), castom_math::EPS_6);\n164\t    assert_approx_eq(0.0_f64 % 1.0, castom_math::castom_fmod(0.0, 1.0), castom_math::EPS_6);\n165\t}\n166\t\n167\t#[test]\n168\tfn castom_test_asin() {\n169\t    for j in (-99..=99).map(|x| x as f64 * 0.01) {\n170\t        assert_approx_eq(j.asin(), castom_math::castom_asin(j), castom_math::EPS_6);\n171\t    }\n172\t    assert_approx_eq((castom_math::S21_M_PI / 4.0).asin(), castom_math::castom_asin(castom_math::S21_M_PI / 4.0), castom_math::EPS_6);\n173\t    assert_approx_eq((-0.99_f64).asin(), castom_math::castom_asin(-0.99), castom_math::EPS_6);\n174\t    assert_approx_eq(0.3_f64.asin(), castom_math::castom_asin(0.3), castom_math::EPS_6);\n175\t    assert_approx_eq(0.45_f64.asin(), castom_math::castom_asin(0.45), castom_math::EPS_6);\n176\t    assert_approx_eq(0.0_f64.asin(), castom_math::castom_asin(0.0), castom_math::EPS_6);\n177\t    assert_approx_eq((-0.18_f64).asin(), castom_math::castom_asin(-0.18), castom_math::EPS_6);\n178\t    assert_approx_eq(0.360_f64.asin(), castom_math::castom_asin(0.360), castom_math::EPS_6);\n179\t    assert_approx_eq(0.255_f64.asin(), castom_math::castom_asin(0.255), castom_math::EPS_6);\n180\t    assert_approx_eq((-0.50_f64).asin(), castom_math::castom_asin(-0.50), castom_math::EPS_6);\n181\t    assert_approx_eq(0.000001_f64.asin(), castom_math::castom_asin(0.000001), castom_math::EPS_6);\n182\t    assert_approx_eq(1.0_f64.asin(), castom_math::castom_asin(1.0), castom_math::EPS_6);\n183\t    assert_approx_eq((-1.0_f64).asin(), castom_math::castom_asin(-1.0), castom_math::EPS_6);\n184\t}\n185\t\n186\t#[test]\n187\tfn castom_test_cos() {\n188\t    for j in (-7210..=7210).map(|x| x as f64 * 0.1) {\n189\t        assert_approx_eq(j.cos(), castom_math::castom_cos(j), castom_math::EPS_6);\n190\t    }\n191\t    assert_approx_eq(30.0_f64.cos(), castom_math::castom_cos(30.0), castom_math::EPS_6);\n192\t    assert_approx_eq(45.0_f64.cos(), castom_math::castom_cos(45.0), castom_math::EPS_6);\n193\t    assert_approx_eq(0.0_f64.cos(), castom_math::castom_cos(0.0), castom_math::EPS_6);\n194\t    assert_approx_eq(180.0_f64.cos(), castom_math::castom_cos(180.0), castom_math::EPS_6);\n195\t    assert_approx_eq(360.0_f64.cos(), castom_math::castom_cos(360.0), castom_math::EPS_6);\n196\t    assert_approx_eq(25.5_f64.cos(), castom_math::castom_cos(25.5), castom_math::EPS_6);\n197\t    assert_approx_eq((-5.0_f64).cos(), castom_math::castom_cos(-5.0), castom_math::EPS_6);\n198\t    assert_approx_eq(500.21_f64.cos(), castom_math::castom_cos(500.21), castom_math::EPS_6);\n199\t    assert_approx_eq(0.000001_f64.cos(), castom_math::castom_cos(0.000001), castom_math::EPS_6);\n200\t    assert_approx_eq(0.0001_f64.cos(), castom_math::castom_cos(0.0001), castom_math::EPS_6);\n201\t}\n202\t\n203\t#[test]\n204\tfn castom_test_acos() {\n205\t    for j in (-99..=99).map(|x| x as f64 * 0.01) {\n206\t        assert_approx_eq(j.acos(), castom_math::castom_acos(j), castom_math::EPS_6);\n207\t    }\n208\t    assert_approx_eq((castom_math::S21_M_PI / 4.0).acos(), castom_math::castom_acos(castom_math::S21_M_PI / 4.0), castom_math::EPS_6);\n209\t    assert_approx_eq((-0.99_f64).acos(), castom_math::castom_acos(-0.99), castom_math::EPS_6);\n210\t    assert_approx_eq(0.3_f64.acos(), castom_math::castom_acos(0.3), castom_math::EPS_6);\n211\t    assert_approx_eq(0.45_f64.acos(), castom_math::castom_acos(0.45), castom_math::EP