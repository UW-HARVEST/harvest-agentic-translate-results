 = p.mul_add(r, 1.0 / 6.0); // 1/3!\n    let p = p.mul_add(r, 1.0 / 2.0); // 1/2!\n    let p = p.mul_add(r, 1.0); // 1/1!\n    let sum = p.mul_add(r, 1.0); // 1/0!","originalFile":"// Constants\npub const S21_NAN: f64 = f64::NAN;\npub const EPS_6: f64 = 1e-06;\npub const S21_M_E: f64 = 2.71828182845904523536028747135266250;\npub const S21_INFINITY: f64 = f64::INFINITY;\npub const EPS_10: f64 = 1e-10;\npub const S21_M_PI: f64 = 3.14159265358979323846264338327950288;\n// Function Declarations\npub fn castom_floor(x: f64) -> f64 {\n    if x >= i64::MAX as f64 || x <= i64::MIN as f64 || x.is_nan() {\n        return x;\n    }\n    let truncation = (x as i64) as f64;\n    truncation - ((truncation > x) as i32) as f64\n}\n\npub fn castom_tan(x: f64) -> f64 {\n    if x == 0.0 {\n        0.0\n    } else if S21_M_PI / 6.0 == x {\n        1.0 / castom_sqrt(3.0)\n    } else if S21_M_PI / 4.0 == x {\n        1.0\n    } else if S21_M_PI / 3.0 == x {\n        castom_sqrt(3.0)\n    } else if S21_M_PI / 2.0 == x {\n        S21_INFINITY\n    } else if S21_M_PI == x {\n        0.0\n    } else if 3.0 * S21_M_PI / 2.0 == x {\n        S21_INFINITY\n    } else if 2.0 * S21_M_PI == x {\n        0.0\n    } else {\n        castom_sin(x) / castom_cos(x)\n    }\n}\n\npub fn castom_atan(x: f64) -> f64 {\n    castom_asin(x / castom_sqrt(1.0 + x * x))\n}\n\npub fn castom_ceil(x: f64) -> f64 {\n    if x >= i64::MAX as f64 || x <= i64::MIN as f64 || x.is_nan() {\n        return x;\n    }\n    let truncation = (x as i64) as f64;\n    truncation + ((truncation < x) as i32) as f64\n}\n\npub fn castom_sqrt(x: f64) -> f64 {\n    if x.is_nan() || x < 0.0 {\n        return S21_NAN;\n    }\n    let mut sqrt = x / 2.0;\n    let mut temp = 0.0;\n    while sqrt != temp {\n        temp = sqrt;\n        sqrt = (x / temp + temp) / 2.0;\n    }\n    sqrt\n}\n\npub fn castom_trunc(x: f64) -> f64 {\n    if x > 0.0 {\n        castom_floor(x)\n    } else {\n        castom_ceil(x)\n    }\n}\n\npub fn castom_exp(x: f64) -> f64 {\n    // Range reduction: exp(x) = 2^k * exp(r), where r = x - k*ln(2)\n    // and |r| <= ln(2)/2. The C implementation uses 80-bit long double,\n    // so its Taylor series tolerates a wide range of x without losing\n    // precision. In 64-bit f64, computing exp(80) via the raw Taylor\n    // series builds partial sums of magnitude ~1e34, which destroys all\n    // low-order precision. Range reduction keeps the Taylor argument\n    // small and recovers near-bit-perfect precision.\n    // Cody-Waite split of ln(2): LN2_HI has a short mantissa so that\n    // k * LN2_HI is computed exactly for the k values that arise here,\n    // and LN2_LO supplies the remaining bits. This gives near-bit-perfect\n    // r and recovers the precision the C version got from long double.\n    const LN2_HI: f64 = 6.93147180369123816490e-01;\n    const LN2_LO: f64 = 1.90821492927058770002e-10;\n    const LN2: f64 = 0.6931471805599453;\n    let k = (x / LN2).round() as i32;\n    let r = (x - (k as f64) * LN2_HI) - (k as f64) * LN2_LO;\n\n    // Sum the Taylor series with Kahan compensated summation. This keeps\n    // accumulated round-off below 1 ULP, which is needed because the C\n    // version uses 80-bit long double — accuracy we must emulate in 64-bit\n    // f64 to satisfy the absolute-tolerance tests for very large exp(x).\n    let mut sum: f64 = 1.0;\n    let mut comp: f64 = 0.0;\n    let mut cur: f64 = 1.0;\n    let mut n: u32 = 1;\n    while castom_fabs(cur) > 1e-18 {\n        cur *= r / n as f64;\n        let y = cur - comp;\n        let t = sum + y;\n        comp = (t - sum) - y;\n        sum = t;\n        n += 1;\n    }\n\n    // Multiply by 2^k. Build 2^k by exponentiation-by-squaring to stay\n    // in f64 range; for very large positive k the result is +inf, for\n    // very large negative k it is 0 — matching IEEE 754 behavior.\n    let two_pow_k: f64 = if k >= 0 {\n        let mut p = 1.0_f64;\n        let mut base = 2.0_f64;\n        let mut e = k as u32;\n        while e > 0 {\n            if e & 1 == 1 {\n                p *= base;\n            }\n            base *= base;\n            e >>= 1;\n        }\n        p\n    } else {\n        let mut p = 1.0_f64;\n        let mut base = 0.5_f64;\n        let mut e = (-k) as u32;\n        while e > 0 {\n            if e & 1 == 1 {\n                p *= base;\n            }\n            base *= base;\n            e >>= 1;\n        }\n        p\n    };\n\n    sum * two_pow_k\n}\n\npub fn castom_factorial(n: u64) -> u64 {\n    let mut result: u64 = 1;\n    let mut i: u64 = 1;\n    while i <= n {\n        result *= i;\n        i += 1;\n    }\n    result\n}\n\npub fn castom_asin(x: f64) -> f64 {\n    let mut term: f64 = x;\n    let mut sum: f64 = S21_NAN;\n    let mut x_local = x;\n    if -1.0 < x_local && x_local < 1.0 {\n        sum = term;\n        x_local *= x_local;\n        let mut k: i32 = 1;\n        while castom_fabs(term) > EPS_10 {\n            term *= x_local * (k as f64) / ((k + 1) as f64);\n            sum += term / ((k + 2) as f64);\n            k += 2;\n        }\n    } else if x_local == 1.0 {\n        sum = S21_M_PI / 2.0;\n    } else if x_local == -1.0 {\n        sum = -S21_M_PI / 2.0;\n    }\n    sum\n}\n\npub fn castom_fmod(x: f64, y: f64) -> f64 {\n    x - castom_trunc(x / y) * y\n}\n\npub fn castom_acos(x: f64) -> f64 {\n    S21_M_PI / 2.0 - castom_asin(x)\n}\n\npub fn castom_pow(base: f64, exp: f64) -> f64 {\n    if base == 0.0 && exp != 0.0 {\n        0.0\n    } else if exp < 0.0 {\n        castom_pow(1.0 / base, -exp)\n    } else if base < 0.0 && exp != (exp as i64) as f64 {\n        -S21_NAN\n    } else if exp == 0.0 {\n        1.0\n    } else {\n        let mut flag: f64 = 1.0;\n        let mut b = base;\n        if b < 0.0 && (exp as i64) % 2 != 0 {\n            flag = -1.0;\n        }\n        if b < 0.0 {\n            b = -b;\n        }\n        let div: i64 = exp as i64;\n        // Compute b^div via binary exponentiation. The C version uses a\n        // simple linear loop; this is mathematically identical but\n        // accumulates far less round-off in 64-bit f64, matching the\n        // precision the C version enjoys with 80-bit long double.\n        let mut integer_part: f64 = 1.0;\n        let mut acc = b;\n        let mut e = div;\n        while e > 0 {\n            if e & 1 == 1 {\n                integer_part *= acc;\n            }\n            acc *= acc;\n            e >>= 1;\n        }\n        integer_part * castom_exp((exp - div as f64) * castom_log(b)) * flag\n    }\n}\n\npub fn castom_abs(x: i32) -> i32 {\n    if x > 0 {\n        x\n    } else {\n        -x\n    }\n}\n\npub fn castom_log(x: f64) -> f64 {\n    let mut a: u32 = 0;\n    let mut b: f64 = 0.0;\n    if x > 0.0 {\n        let mut c: f64 = if x < 1.0 { 1.0 / x } else { x };\n        loop {\n            c /= S21_M_E;\n            if !(c > 1.0) {\n                break;\n            }\n            a += 1;\n        }\n        c = 1.0 / (c * S21_M_E - 1.0);\n        c = c + c + 1.0;\n        let f = c * c;\n        b = 0.0;\n        let mut d: u32 = 1;\n        c /= 2.0;\n        loop {\n            let e = b;\n            b += 1.0 / (d as f64 * c);\n            if b - e == 0.0 {\n                break;\n            }\n            d += 2;\n            c *= f;\n        }\n    } else {\n        // (x == 0) / 0.0: if x == 0 -> 1/0 = +inf; otherwise 0/0 = NaN\n        b = if x == 0.0 { 1.0 / 0.0 } else { 0.0 / 0.0 };\n    }\n    if x < 1.0 {\n        -((a as f64) + b)\n    } else {\n        (a as f64) + b\n    }\n}\n\npub fn castom_sin(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut sum: f64 = 0.0;\n    for i in 0..=20i32 {\n        let mut fa: f64 = 1.0;\n        let mut p: f64 = 1.0;\n        let mut j: i32 = 1;\n        while j <= 2 * i + 1 {\n            fa *= j as f64;\n            p *= x;\n            j += 1;\n        }\n        sum += (if i % 2 != 0 { -1.0 } else { 1.0 } / fa) * p;\n    }\n    sum\n}\n\npub fn castom_cos(x: f64) -> f64 {\n    let x = castom_fmod(x, 2.0 * S21_M_PI);\n    let mut t_s: f64 = 0.0;\n    let mut last: f64 = 1.0;\n    let mut k: i32 = 1;\n    while castom_fabs(last) > EPS_10 {\n        t_s += last;\n        last *= -x * x / (2.0 * k as f64 - 1.0) / (2.0 * k as f64);\n        k += 1;\n    }\n    t_s\n}\n\npub fn castom_fabs(x: f64) -> f64 {\n    if x > 0.0 {\n        x\n    } else {\n        -x\n    }\n}\n","structuredPatch":[{"oldStart":87,"oldLines":22,"newStart":87,"newLines":24,"lines":["     let k = (x / LN2).round() as i32;","     let r = (x - (k as f64) * LN2_HI) - (k as f64) * LN2_LO;"," ","-    // Sum the Taylor series with Kahan compensated summation. This keeps","-    // accumulated round-off below 1 ULP, which is needed because the C","-    // version uses 80-bit long double — accuracy we must emulate in 64-bit","-    // f64 to satisfy the absolute-tolerance tests for very large exp(x).","-    let mut sum: f64 = 1.0;","-    let mut comp: f64 = 0.0;","-    let mut cur: f64 = 1.0;","-    let mut n: u32 = 1;","-    while castom_fabs(cur) > 1e-18 {","-        cur *= r / n as f64;","-        let y = cur - comp;","-        let t = sum + y;","-        comp = (t - sum) - y;","-        sum = t;","-        n += 1;","-    }","+    // Evaluate the Taylor polynomial of exp(r) via Horner's scheme with","+    // fused multiply-add. With |r| <= ln(2)/2, 13 terms are well below","+    // f64 ULP. Using FMA gives near-correctly-rounded evaluation, which","+    // is needed to emulate (in 64-bit f64) the precision the C version","+    // gets from 80-bit long double.","+    let p = 1.0_f64 / 479001600.0; // 1/12!","+    let p = p.mul_add(r, 1.0 / 39916800.0); // 1/11!","+    let p = p.mul_add(r, 1.0 / 3628800.0); // 1/10!","+    let p = p.mul_add(r, 1.0 / 362880.0); // 1/9!","+    let p = p.mul_add(r, 1.0 / 40320.0); // 1/8!","+    let p = p.mul_add(r, 1.0 / 5040.0); // 1/7!","+    let p = p.mul_add(r, 1.0 / 720.0); // 1/6!","+    let p = p.mul_ad