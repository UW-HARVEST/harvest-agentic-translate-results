≈ 5.5e34) to exceed\n    // the test's 1e-6 absolute tolerance. To preserve the C semantics\n    // (Taylor series-based exponential) at f64 precision, we apply\n    // standard range reduction exp(x) = 2^k * exp(r) and evaluate the\n    // reduced series exactly as the C code does.\n    let mut sum: f64 = 1.0;\n    let mut cur: f64 = 1.0;\n    let mut n: u32 = 1;\n\n    // Range reduction: choose k so |r| <= ln(2)/2.\n    const LN2_HI: f64 = 6.93147180369123816490e-01;\n    const LN2_LO: f64 = 1.90821492927058770002e-10;\n    const LN2: f64 = 0.6931471805599453;\n    let k = (x / LN2).round() as i32;\n    let r = (x - (k as f64) * LN2_HI) - (k as f64) * LN2_LO;\n\n    // Same Taylor loop as the C source, applied to the reduced argument r.\n    while castom_fabs(cur) > EPS_10 {\n        cur *= r / n as f64;\n        sum += cur;\n        n += 1;\n    }\n\n    // Multiply by 2^k via exponentiation by squaring (an exact f64\n    // operation when 2^k is in range).\n    let two_pow_k: f64 = if k >= 0 {\n        let mut p = 1.0_f64;\n        let mut base = 2.0_f64;\n        let mut e = k as u32;\n        while e > 0 {\n            if e & 1 == 1 {\n                p *= base;\n            }\n            base *= base;\n            e >>= 1;\n        }\n        p\n    } else {\n        let mut p = 1.0_f64;\n        let mut base = 0.5_f64;\n        let mut e = (-k) as u32;\n        while e > 0 {\n            if e & 1 == 1 {\n                p *= base;\n            }\n            base *= base;\n            e >>= 1;\n        }\n        p\n    };\n    sum * two_pow_k\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2128,"cache_read_input_tokens":55730,"cache_creation":{"ephemeral_5m_input_tokens":2128,"ephemeral_1h_input_tokens":0},"output_tokens":38,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"a97f20be-1f45-46af-afd8-c1721cf1a59f","uuid":"1fb959a3-3b78-421f-