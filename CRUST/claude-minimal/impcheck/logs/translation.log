{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017SPUQJoM7Bsv7e4emTmXqh","type":"tool_result","content":"1\t\n2\t#pragma once\n3\t\n4\t#include <stdbool.h>        // for bool\n5\t#include \"trusted_utils.h\"\n6\t\n7\t// A hash table mapping from u64 keys to void* values.\n8\t// The key zero is a magic number representing an empty entry.\n9\t// The capacity is provided logarithmically such that the\n10\t// table's capacity is always a power of two.\n11\t// Growing is done in powers of two, if the load factor exceeds 0.5.\n12\t// No shrinking is done. Assuming roughly monotonic growth,\n13\t// the table's load factor is always between 0.25 and 0.5.\n14\t// Collisions are handled via linear probing, which in this mode\n15\t// appears to perform reasonably well.\n16\t\n17\tstruct hash_table_entry {\n18\t    u64 key;\n19\t    void* val;\n20\t};\n21\t\n22\tstruct hash_table {\n23\t    u64 size;\n24\t    u64 max_size;\n25\t    float growth_factor;\n26\t    u64 capacity;\n27\t    struct hash_table_entry* data;\n28\t    u64 last_found_idx;\n29\t};\n30\t\n31\tstruct hash_table* hash_table_init(int log_init_capacity);\n32\tvoid* hash_table_find(struct hash_table* ht, u64 key);\n33\tbool hash_table_insert(struct hash_table* ht, u64 key, void* data);\n34\tbool hash_table_delete(struct hash_table* ht, u64 key);\n35\tbool hash_table_delete_last_found(struct hash_table* ht);\n36\tvoid hash_table_free(struct hash_table* ht);\n37\t"}]},"parent_tool_use_id":null,"session_id":"fef4c174-8860-4f42-a961-c0cbb59dcb99","uuid":"3b3927d6-3735-4355-8206-7263d0d02643","timestamp":"2026-06-01T21:27:12.379Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-eXPQsI/project/c_src/src/trusted/hash.h","content":"\n#pragma once\n\n#include <stdbool.h>        // for bool\n#include \"trusted_utils.h\"\n\n// A hash table mapping from u64 keys to void* values.\n// The key zero is a magic number representing an empty entry.\n// The capacity is provided logarithmically such that the\n// table's capacity is always a power of two.\n// Growing is done in powers of two, if the load factor exceeds 0.5.\n// No shrinking is done. Assuming roughly monotonic growth,\n// the table's load factor is always between 0.25 and 0.5.\n// Collisions are handled via linear probing, which in this mode\n// appears to perform reasonably well.\n\nstruct hash_table_entry {\n    u64 key;\n    void* val;\n};\n\nstruct hash_table {\n    u64 size;\n    u64 max_size;\n    float growth_factor;\n    u64 capacity;\n    struct hash_table_entry* data;\n    u64 last_found_idx;\n};\n\nstruct hash_table* hash_table_init(int log_init_capacity);\nvoid* hash_table_find(struct hash_table* ht, u64 key);\nbool hash_table_insert(struct hash_table* ht, u64 key, void* data);\nbool hash_table_delete(struct hash_table* ht, u64 key);\nbool hash_table_delete_last_found(struct hash_table* ht);\nvoid hash_table_free(struct hash_table* ht);\n","numLines":37,"startLine":1,"totalLines":37}}}
