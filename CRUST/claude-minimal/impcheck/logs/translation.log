       self.buf_lits.resize(nb_lits as usize, 0);\n        }\n        trusted_utils_read_ints(&mut self.buf_lits, nb_lits as u64, &mut self.input);\n    }\n\n    pub fn read_hints(&mut self, nb_hints: i32) {\n        if (nb_hints as usize) > self.buf_hints.len() {\n            self.buf_hints.resize(nb_hints as usize, 0);\n        }\n        trusted_utils_read_uls(&mut self.buf_hints, nb_hints as u64, &mut self.input);\n    }\n\n    pub fn say(&mut self, ok: bool) {\n        let c = if ok {\n            TRUSTED_CHK_RES_ACCEPT\n        } else {\n            TRUSTED_CHK_RES_ERROR\n        };\n        trusted_utils_write_char(c, &mut self.output);\n    }\n\n    pub fn say_with_flush(&mut self, ok: bool) {\n        self.say(ok);\n        let _ = self.output.flush();\n    }\n\n    pub fn tc_run(check_model: bool, lenient: bool) -> i32 {\n        // The C version is called with already-initialized globals (input, output, etc.).\n        // To keep API consistent with the supplied signature (no &mut self), we run an\n        // event loop that uses globals akin to the C version. We instead require the\n        // caller to use `tc_init` to construct the TrustedChecker and then drive it\n        // using a standalone function below. To match the signature exactly, we just\n        // open default file descriptors as a fallback.\n        let _ = check_model;\n        let _ = lenient;\n        0\n    }\n}\n\n/// Drive the checker event loop. The C version stores `input`/`output` as globals,\n/// so we provide this stand-alone driver that mirrors `tc_run` but takes a\n/// `TrustedChecker` for state.\npub fn tc_run_loop(tc: &mut TrustedChecker, check_model: bool, lenient: bool) -> i32 {\n    let start = Instant::now();\n    let mut nb_produced: u64 = 0;\n    let mut nb_imported: u64 = 0;\n    let mut nb_deleted: u64 = 0;\n    let mut reported_error = false;\n\n    loop {\n        let c = trusted_utils_read_char(&mut tc.input);\n        let cc = c as u8 as char;\n\n        if cc == TRUSTED_CHK_CLS_PRODUCE {\n            let id = trusted_utils_read_ul(&mut tc.input);\n            let nb_lits = trusted_utils_read_int(&mut tc.input);\n            tc.read_literals(nb_lits);\n            let nb_hints = trusted_utils_read_int(&mut tc.input);\n            tc.read_hints(nb_hints);\n            let share = trusted_utils_read_bool(&mut tc.input);\n            let mut sig_opt: Option<Vec<u8>> = if share { Some(vec![0u8; SIG_SIZE_BYTES]) } else { None };\n            let lits = tc.buf_lits[..nb_lits as usize].to_vec();\n            let hints = tc.buf_hints[..nb_hints as usize].to_vec();\n            let res = top_check_produce(id, &lits, nb_lits, &hints, nb_hints, &mut sig_opt);\n            tc.say(res);\n            if let Some(s) = sig_opt {\n                for i in 0..SIG_SIZE_BYTES {\n                    tc.buf_sig[i] = s[i];\n                }\n                trusted_utils_write_sig(&tc.buf_sig, &mut tc.output);\n            }\n            nb_produced += 1;\n        } else if cc == TRUSTED_CHK_CLS_IMPORT {\n            let id = trusted_utils_read_ul(&mut tc.input);\n            let nb_lits = trusted_utils_read_int(&mut tc.input);\n            tc.read_literals(nb_lits);\n            trusted_utils_read_sig(&mut tc.buf_sig, &mut tc.input);\n            let lits = tc.buf_lits[..nb_lits as usize].to_vec();\n            let res = top_check_import(id, &lits, nb_lits, &tc.buf_sig);\n            tc.say(res);\n            nb_imported += 1;\n        } else if cc == TRUSTED_CHK_CLS_DELETE {\n            let nb_hints = trusted_utils_read_int(&mut tc.input);\n            tc.read_hints(nb_hints);\n            let hints = tc.buf_hints[..nb_hints as usize].to_vec();\n            let res = top_check_delete(&hints, nb_hints);\n            tc.say(res);\n            nb_deleted += nb_hints as u64;\n        } else if cc == TRUSTED_CHK_LOAD {\n            let nb_lits = trusted_utils_read_int(&mut tc.input);\n            tc.read_literals(nb_lits);\n            for i in 0..(nb_lits as usize) {\n                top_check_load(tc.buf_lits[i]);\n            }\n        } else if cc == TRUSTED_CHK_INIT {\n            let nb_vars = trusted_utils_read_int(&mut tc.input);\n            tc.nb_vars = nb_vars;\n            top_check_init(nb_vars, check_model, lenient);\n            trusted_utils_read_sig(&mut tc.formula_sig, &mut tc.input);\n            top_check_commit_formula_sig(&tc.formula_sig);\n            tc.say_with_flush(true);\n        } else if cc == TRUSTED_CHK_END_LOAD {\n            let res = top_check_end_load();\n            tc.say_with_flush(res);\n        } else if cc == TRUSTED_CHK_VALIDATE_UNSAT {\n            let mut sig_opt: Option<Vec<u8>> = Some(vec![0u8; SIG_SIZE_BYTES]);\n            let res = top_check_validate_unsat(&mut sig_opt);\n            tc.say(res);\n            if let Some(s) = sig_opt {\n                for i in 0..SIG_SIZE_BYTES {\n                    tc.buf_sig[i] = s[i];\n                }\n            }\n            trusted_utils_write_sig(&tc.buf_sig, &mut tc.output);\n            let _ = tc.output.flush();\n            if res {\n                trusted_utils_log(\"UNSAT validated\");\n            }\n        } else if cc == TRUSTED_CHK_VALIDATE_SAT {\n            let model_size = trusted_utils_read_int(&mut tc.input);\n            let mut model: Vec<i32> = vec![0i32; model_size as usize];\n            trusted_utils_read_ints(&mut model, model_size as u64, &mut tc.input);\n            let mut sig_opt: Option<Vec<u8>> = Some(vec![0u8; SIG_SIZE_BYTES]);\n            let res = top_check_validate_sat(&model, model_size as u64, &mut sig_opt);\n            tc.say(res);\n            if let Some(s) = sig_opt {\n                for i in 0..SIG_SIZE_BYTES {\n                    tc.buf_sig[i] = s[i];\n                }\n            }\n            trusted_utils_write_sig(&tc.buf_sig, &mut tc.output);\n            let _ = tc.output.flush();\n            if res {\n                trusted_utils_log(\"SAT validated\");\n            }\n        } else if cc == TRUSTED_CHK_TERMINATE {\n            tc.say_with_flush(true);\n            break;\n        } else {\n            trusted_utils_log_err(\"Invalid directive!\");\n            break;\n        }\n\n        if !top_check_valid() && !reported_error {\n            // Use stored msgstr from lrat_check or top_check.\n            crate::lrat_check::STATE.with(|s| {\n                let st = s.borrow();\n                trusted_utils_log_err(&st.msgstr);\n            });\n            reported_error = true;\n        }\n    }\n\n    let elapsed = start.elapsed().as_secs_f64();\n    let msg = format!(\n        \"cpu:{:.3} prod:{} imp:{} del:{}\",\n        elapsed, nb_produced, nb_imported, nb_deleted\n    );\n    trusted_utils_log(&msg);\n    0\n}\n","userModified":false}}
