{"type":"assistant","message":{"model":"claude-opus-4-7","id":"msg_bdrk_g3l6easp4g24vft5ca7p7lvufkfxm5aaifqjdciqaqdwnin4dfka","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_bdrk_01255nc91LxPJqaonTGzBeep","name":"Write","input":{"file_path":"/tmp/claude-31062124/harvest-crust-n8UAGO/project/src/totp.rs","content":"// Importing required modules\nuse crate::std;\n// Constants\npub const TOTP_EXPORT: &str = \"__attribute__((visibility(\\\"default\\\")))\";\n\n// TOTP error codes\nconst TOTP_OK: i32 = 0;\nconst TOTP_EBOUNDS: i32 = 1;\n\n// Function Declarations\npub fn hotp(key: &[u8; 64], counter: u64) -> i32 {\n    let mut data = [0u8; 8];\n    let mut hash = [0u8; 20];\n\n    unpack64(counter, &mut data);\n    hmac_sha1(key, &data, 8, &mut hash);\n\n    let offset = (hash[19] & 0xF) as usize;\n    let arr: [u8; 4] = [\n        hash[offset],\n        hash[offset + 1],\n        hash[offset + 2],\n        hash[offset + 3],\n    ];\n    let trunc = pack32(&arr) & 0x7FFFFFFF;\n\n    (trunc % 1000000) as i32\n}\n\npub fn sha1(buf: &mut [u8], len: usize, cap: usize, hash: &mut [u8; 20]) -> i32 {\n    // 4.2.1, use k[t/20]\n    const K: [u32; 4] = [0x5A827999, 0x6ED9EBA1, 0x8F1BBCDC, 0xCA62C1D6];\n\n    // 5.1.1 (padding)\n    // add 1 byte for stop bit, 8 for length, pad to 64 bytes\n    if len > std::SIZE_MAX - 9 - 63 {\n        return TOTP_EBOUNDS;\n    }\n    let new_len = (len + 9 + 63) / 64 * 64; // ceil len+9 to 64 multiple\n    if new_len > cap {\n        return TOTP_EBOUNDS;\n    }\n\n    // memset(buf+len, 0, new_len-len);\n    for i in len..new_len {\n        buf[i] = 0;\n    }\n    buf[len] = 1 << 7;\n\n    // unpack64(len*8, &buf[new_len-8]);\n    let bits = (len as u64).wrapping_mul(8);\n    buf[new_len - 8] = (bits >> 56) as u8;\n    buf[new_len - 7] = (bits >> 48) as u8;\n    buf[new_len - 6] = (bits >> 40) as u8;\n    buf[new_len - 5] = (bits >> 32) as u8;\n    buf[new_len - 4] = (bits >> 24) as u8;\n    buf[new_len - 3] = (bits >> 16) as u8;\n    buf[new_len - 2] = (bits >> 8) as u8;\n    buf[new_len - 1] = bits as u8;\n\n    // 5.3.1\n    let mut h: [u32; 5] = [\n        0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0,\n    ];\n    let mut w = [0u32; 80];\n\n    // 6.1.2\n    for i in 0..(new_len / 64) {\n        for t in 0..16 {\n            let base = i * 64 + t * 4;\n            let arr = [buf[base], buf[base + 1], buf[base + 2], buf[base + 3]];\n            w[t] = pack32(&arr);\n        }\n        for t in 16..80 {\n            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1);\n        }\n\n        let mut a = h[0];\n        let mut b = h[1];\n        let mut c = h[2];\n        let mut d = h[3];\n        let mut e = h[4];\n\n        for t in 0..80 {\n            // 4.1.1 (f function)\n            let f = if t < 20 {\n                (b & c) ^ (!b & d)\n            } else if t < 40 {\n                b ^ c ^ d\n            } else if t < 60 {\n                (b & c) ^ (b & d) ^ (c & d)\n            } else {\n                b ^ c ^ d\n            };\n\n            let temp = rotl(a, 5)\n                .wrapping_add(f)\n                .wrapping_add(e)\n                .wrapping_add(K[t / 20])\n                .wrapping_add(w[t]);\n            e = d;\n            d = c;\n            c = rotl(b, 30);\n            b = a;\n            a = temp;\n        }\n\n        h[0] = h[0].wrapping_add(a);\n        h[1] = h[1].wrapping_add(b);\n        h[2] = h[2].wrapping_add(c);\n        h[3] = h[3].wrapping_add(d);\n        h[4] = h[4].wrapping_add(e);\n    }\n\n    for i in 0..5 {\n        let mut tmp = [0u8; 4];\n        unpack32(h[i], &mut tmp);\n        hash[i * 4] = tmp[0];\n        hash[i * 4 + 1] = tmp[1];\n        hash[i * 4 + 2] = tmp[2];\n        hash[i * 4 + 3] = tmp[3];\n    }\n\n    TOTP_OK\n}\n\npub fn from_base32(s: &str, buf: &mut [u8], cap: usize) -> usize {\n    let s_len = std::strlen(s);\n    if s_len % 8 != 0 {\n        return 0;\n    }\n    if cap < (s_len + 1) / 8 * 5 {\n        return 0;\n    }\n\n    let bytes = s.as_bytes();\n    let mut v = [0u8; 8];\n    let mut i = 0;\n    while i * 8 < s_len {\n        for j in 0..8 {\n            let c = bytes[i * 8 + j];\n            if c == b'=' {\n                v[j] = 0;\n            } else if c >= b'A' && c <= b'Z' {\n                v[j] = c - b'A';\n            } else if c >= b'a' && c <= b'z' {\n                v[j] = c - b'a';\n            } else if c >= b'2' && c <= b'7' {\n                v[j] = c - b'2' + 26;\n            } else {\n                return 0;\n            }\n        }\n\n        buf[i * 5] = (v[0] << 3) | (v[1] >> 2);\n        buf[i * 5 + 1] = (v[1] << 6) | (v[2] << 1) | (v[3] >> 4);\n        buf[i * 5 + 2] = (v[3] << 4) | (v[4] >> 1);\n        buf[i * 5 + 3] = (v[4] << 7) | (v[5] << 2) | (v[6] >> 3);\n        buf[i * 5 + 4] = (v[6] << 5) | v[7];\n\n        if bytes[i * 8 + 2] == b'=' {\n            return i * 5 + 1;\n        }\n        if bytes[i * 8 + 4] == b'=' {\n            return i * 5 + 2;\n        }\n        if bytes[i * 8 + 5] == b'=' {\n            return i * 5 + 3;\n        }\n        if bytes[i * 8 + 7] == b'=' {\n            return i * 5 + 4;\n        }\n\n        i += 1;\n    }\n\n    i * 5\n}\n\n// convert u64 to 8 bytes, big-endian\npub fn unpack64(x: u64, a: &mut [u8; 8]) {\n    let upper = (x >> 32) as u32;\n    let lower = x as u32;\n    let mut tmp = [0u8; 4];\n    unpack32(upper, &mut tmp);\n    a[0] = tmp[0];\n    a[1] = tmp[1];\n    a[2] = tmp[2];\n    a[3] = tmp[3];\n    unpack32(lower, &mut tmp);\n    a[4] = tmp[0];\n    a[5] = tmp[1];\n    a[6] = tmp[2];\n    a[7] = tmp[3];\n}\n\n// convert 4 bytes to u32, big-endian\npub fn pack32(a: &[u8; 4]) -> u32 {\n    ((a[0] as u32) << 24) | ((a[1] as u32) << 16) | ((a[2] as u32) << 8) | (a[3] as u32)\n}\n\n// convert u32 to 4 bytes, big-endian\npub fn unpack32(x: u32, a: &mut [u8; 4]) {\n    a[0] = (x >> 24) as u8;\n    a[1] = (x >> 16) as u8;\n    a[2] = (x >> 8) as u8;\n    a[3] = x as u8;\n}\n\npub fn totp(key: &[u8; 64], time: u64) -> i32 {\n    hotp(key, time / 30)\n}\n\npub fn hmac_sha1(key: &[u8; 64], data: &[u8], len: usize, hash: &mut [u8; 20]) -> i32 {\n    if len > 64 {\n        return TOTP_EBOUNDS;\n    }\n\n    let mut buf = [0u8; 196];\n\n    for i in 0..64 {\n        buf[i] = key[i] ^ 0x36;\n    }\n    for i in 0..len {\n        buf[64 + i] = data[i];\n    }\n    sha1(&mut buf, 64 + len, 196, hash);\n\n    for i in 0..64 {\n        buf[i] = key[i] ^ 0x5C;\n    }\n    for i in 0..20 {\n        buf[64 + i] = hash[i];\n    }\n    sha1(&mut buf, 64 + 20, 196, hash);\n\n    TOTP_OK\n}\n\n// FIPS 180-3 2.2.2\npub fn rotl(x: u32, n: i32) -> u32 {\n    x.rotate_left(n as u32)\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":470,"cache_read_input_tokens":24315,"cache_creation":{"ephemeral_5m_input_tokens":470,"ephemeral_1h_input_tokens":0},"output_tokens":40,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"ce5296f7-912b-4616-926f-823e40406933","uuid":"5864147a-b972-4bee-b133-c596d39238ad"}
