    let (p_chr, p_n) = skp_next_bytes(p, flg & 2);\n        let (s_chr, s_n) = skp_next_bytes(s, flg & 2);\n\n        if chr_cmp(s_chr, p_chr, flg & 1) {\n            mlen += s_n as i32;\n            len -= p_n as i32;\n            p = &p[p_n..];\n            s = &s[s_n..];\n        } else {\n            // search for an alternative '\\xE'\n            // Mirror C: while (len>0 && *p++ != '\\xE') len--;\n            // -> advance p, only decrement len when char != \\xE.\n            loop {\n                if len <= 0 {\n                    break;\n                }\n                let ch = if !p.is_empty() { p[0] } else { 0 };\n                p = if !p.is_empty() { &p[1..] } else { p };\n                if ch == 0x0E {\n                    break;\n                }\n                len -= 1;\n            }\n            // Mirror C: if (len-- <= 0) return 0;\n            if len <= 0 {\n                return 0;\n            }\n            len -= 1;\n            s = start;\n            mlen = 0;\n        }\n    }\n    mlen\n}"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":814,"cache_read_input_tokens":105120,"cache_creation":{"ephemeral_5m_input_tokens":814,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"b5a657a1-bd77-489c-9dd1-faa9734bdf01","uuid":"35060dc4-93ee-430c-8cbc-a6afc93dd111"}
