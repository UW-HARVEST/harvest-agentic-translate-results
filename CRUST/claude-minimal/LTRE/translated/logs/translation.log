      matches: false,\n540\t        errors: true,\n541\t        partial: false,\n542\t        ignorecase: false,\n543\t        complement: false,\n544\t        quick: false,\n545\t    });\n546\t    run_test(&Test {\n547\t        regex: \"a++\",\n548\t        input: \"\",\n549\t        matches: false,\n550\t        errors: true,\n551\t        partial: false,\n552\t        ignorecase: false,\n553\t        complement: false,\n554\t        quick: false,\n555\t    });\n556\t    run_test(&Test {\n557\t        regex: \"a+?\",\n558\t        input: \"\",\n559\t        matches: false,\n560\t        errors: true,\n561\t        partial: false,\n562\t        ignorecase: false,\n563\t        complement: false,\n564\t        quick: false,\n565\t    });\n566\t    run_test(&Test {\n567\t        regex: \"a?*\",\n568\t        input: \"\",\n569\t        matches: false,\n570\t        errors: true,\n571\t        partial: false,\n572\t        ignorecase: false,\n573\t        complement: false,\n574\t        quick: false,\n575\t    });\n576\t    run_test(&Test {\n577\t        regex: \"a?+\",\n578\t        input: \"\",\n579\t        matches: false,\n580\t        errors: true,\n581\t        partial: false,\n582\t        ignorecase: false,\n583\t        complement: false,\n584\t        quick: false,\n585\t    });\n586\t    run_test(&Test {\n587\t        regex: \"a??\",\n588\t        input: \"\",\n589\t        matches: false,\n590\t        errors: true,\n591\t        partial: false,\n592\t        ignorecase: false,\n593\t        complement: false,\n594\t        quick: false,\n595\t    });\n596\t\n597\t    // We'll define a big constant for NAT_OVF\n598\t    const NAT_OVF: &str = \"9999999999999999999999999999999999999999\";\n599\t    // run_test(&Test {\n600\t    //     regex: &format!(\"a{{{}}}\", NAT_OVF),\n601\t    //     input: \"\",\n602\t    //     matches: false,\n603\t    //     errors: true,\n604\t    //     partial: false,\n605\t    //     ignorecase: false,\n606\t    //     complement: false,\n607\t    //     quick: false,\n608\t    // });\n609\t    // run_test(&Test {\n610\t    //     regex: &format!(\"a{{{},}}\", NAT_OVF),\n611\t    //     input: \"\",\n612\t    //     matches: false,\n613\t    //     errors: true,\n614\t    //     partial: false,\n615\t    //     ignorecase: false,\n616\t    //     complement: false,\n617\t    //     quick: false,\n618\t    // });\n619\t    // run_test(&Test {\n620\t    //     regex: &format!(\"a{{,{} }}\", NAT_OVF),\n621\t    //     input: \"\",\n622\t    //     matches: false,\n623\t    //     errors: true,\n624\t    //     partial: false,\n625\t    //     ignorecase: false,\n626\t    //     complement: false,\n627\t    //     quick: false,\n628\t    // });\n629\t    // run_test(&Test {\n630\t    //     regex: &format!(\"a{{{},{}}}\", NAT_OVF, NAT_OVF),\n631\t    //     input: \"\",\n632\t    //     matches: false,\n633\t    //     errors: true,\n634\t    //     partial: false,\n635\t    //     ignorecase: false,\n636\t    //     complement: false,\n637\t    //     quick: false,\n638\t    // });\n639\t\n640\t    // nonstandard features\n641\t    test!(\"^a\", \"z\", true);\n642\t    test!(\"^a\", \"a\", false);\n643\t    test!(\"^\\\\n\", \"\\r\", true);\n644\t    test!(\"^\\\\n\", \"\\n\", false);\n645\t    test!(\"^.\", \"\\n\", true);\n646\t    test!(\"^.\", \"a\", false);\n647\t    test!(\"\\\\d+\", \"0123456789\", true);\n648\t    test!(\"\\\\s+\", r\" \\f\\n\\r\\t\\v\", true);\n649\t    test!(\"\\\\w+\", \"azAZ09_\", true);\n650\t    test!(\"^a-z*\", \"1A!2$B\", true);\n651\t    test!(\"^a-z*\", \"1aA\", false);\n652\t    test!(\"a-z*\", \"abc\", true);\n653\t    test!(\"^[\\\\d^\\\\w]+\", \"abcABC\", true);\n654\t    test!(\"^[\\\\d^\\\\w]+\", \"abc123\", false);\n655\t    test!(\"^[\\\\d\\\\W]+\", \"abcABC\", true);\n656\t    test!(\"^[\\\\d^\\\\W]+\", \"abc123\", false);\n657\t    test!(\"[[abc]]+\", \"abc\", true);\n658\t    test!(\"[a[bc]]+\", \"abc\", true);\n659\t    test!(\"[a[b]c]+\", \"abc\", true);\n660\t    test!(\"[a][b][c]\", \"abc\", true);\n661\t    test!(\"^[^a^b]\", \"a\", false);\n662\t    test!(\"^[^a^b]\", \"b\", false);\n663\t    test!(\"^[^a^b]\", \"\", false);\n664\t    test!(\"<ab>\", \"a\", false);\n665\t    test!(\"<ab>\", \"b\", false);\n666\t    test!(\"<ab>\", \"\", false);\n667\t    test!(\"\\\\^\", \"^\", true);\n668\t    test!(\"^\\\\^\", \"^\", false);\n669\t    test!(\"^[^\\\\^]\", \"^\", true);\n670\t    test!(\"^[ ^[a b c]]+\", \"abc\", true);\n671\t    test!(\"^[ ^[a b c]]+\", \"a c\", false);\n672\t    test!(\"<[a b c]^ >+\", \"abc\", true);\n673\t    test!(\"<[a b c]^ >+\", \"a c\", false);\n674\t    test!(\"^[^0-74]+\", \"0123567\", true);\n675\t    test!(\"^[^0-74]+\", \"89\", false);\n676\t    test!(\"^[^0-74]+\", \"4\", false);\n677\t    test!(\"<0-7^4>+\", \"0123567\", true);\n678\t    test!(\"<0-7^4>+\", \"89\", false);\n679\t    test!(\"<0-7^4>+\", \"4\", false);\n680\t    test!(\"[]\", \" \", false);\n681\t    test!(\"^[]\", \" \", true);\n682\t    test!(\"<>\", \" \", true);\n683\t    test!(\"^<>\", \" \", false);\n684\t    test!(\"9-0*\", \"abc\", true);\n685\t    test!(\"9-0*\", \"18\", false);\n686\t    test!(\"9-0*\", \"09\", true);\n687\t    test!(\"9-0*\", \"/:\", true);\n688\t    test!(\"b-a*\", \"ab\", true);\n689\t    test!(\"a-b*\", \"ab\", true);\n690\t    test!(\"a-a*\", \"ab\", false);\n691\t    test!(\"a-a*\", \"aa\", true);\n692\t    test!(\"a{,2}\", \"\", true);\n693\t    test!(\"a{,2}\", \"a\", true);\n694\t    test!(\"a{,2}\", \"aa\", true);\n695\t    test!(\"a{,2}\", \"aaa\", false);\n696\t    test!(\"a{}\", \"\", true);\n697\t    test!(\"a{}\", \"a\", false);\n698\t    test!(\"a{,}\", \"\", true);\n699\t    test!(\"a{,}\", \"a\", true);\n700\t    test!(\"~0*\", \"\", false);\n701\t    test!(\"~0*\", \"0\", false);\n702\t    test!(\"~0*\", \"00\", false);\n703\t    test!(\"~0*\", \"001\", true);\n704\t    test!(\"ab&cd\", \"\", false);\n705\t    test!(\"ab&cd\", \"ab\", false);\n706\t    test!(\"ab&cd\", \"cd\", false);\n707\t    test!(\"\\\\w+&~\\\\d+\", \"\", false);\n708\t    test!(\"\\\\w+&~\\\\d+\", \"abc\", true);\n709\t    test!(\"\\\\w+&~\\\\d+\", \"abc123\", true);\n710\t    test!(\"\\\\w+&~\\\\d+\", \"1a2b3c\", true);\n711\t    test!(\"\\\\w+&~\\\\d+\", \"123\", false);\n712\t    test!(\"0x(~[0-9a-f]+)\", \"0yz\", false);\n713\t    test!(\"0x(~[0-9a-f]+)\", \"0x12\", false);\n714\t    test!(\"0x(~[0-9a-f]+)\", \"0x\", true);\n715\t    test!(\"0x(~[0-9a-f]+)\", \"0xy\", true);\n716\t    test!(\"0x(~[0-9a-f]+)\", \"0xyz\", true);\n717\t    test!(\"b(~a*)\", \"\", false);\n718\t    test!(\"b(~a*)\", \"b\", false);\n719\t    test!(\"b(~a*)\", \"ba\", false);\n720\t    test!(\"b(~a*)\", \"bbaa\", true);\n721\t    run_test(&Test {\n722\t        regex: \"abc>\",\n723\t        input: \"\",\n724\t        matches: false,\n725\t        errors: true,\n726\t        partial: false,\n727\t        ignorecase: false,\n728\t        complement: false,\n729\t        quick: false,\n730\t    });\n731\t    run_test(&Test {\n732\t        regex: \"<abc\",\n733\t        input: \"\",\n734\t        matches: false,\n735\t        errors: true,\n736\t        partial: false,\n737\t        ignorecase: false,\n738\t        complement: false,\n739\t        quick: false,\n740\t    });\n741\t    run_test(&Test {\n742\t        regex: \"[a?b]\",\n743\t        input: \"\",\n744\t        matches: false,\n745\t        errors: true,\n746\t        partial: false,\n747\t        ignorecase: false,\n748\t        complement: false,\n749\t        quick: false,\n750\t    });\n751\t    run_test(&Test {\n752\t        regex: \"[a-]\",\n753\t        input: \"\",\n754\t        matches: false,\n755\t        errors: true,\n756\t        partial: false,\n757\t        ignorecase: false,\n758\t        complement: false,\n759\t        quick: false,\n760\t    });\n761\t    run_test(&Test {\n762\t        regex: \"[--]\",\n763\t        input: \"\",\n764\t        matches: false,\n765\t        errors: true,\n766\t        partial: false,\n767\t        ignorecase: false,\n768\t        complement: false,\n769\t        quick: false,\n770\t    });\n771\t    run_test(&Test {\n772\t        regex: \"[-]\",\n773\t        input: \"\",\n774\t        matches: false,\n775\t        errors: true,\n776\t        partial: false,\n777\t        ignorecase: false,\n778\t        complement: false,\n779\t        quick: false,\n780\t    });\n781\t    run_test(&Test {\n782\t        regex: \"-\",\n783\t        input: \"\",\n784\t        matches: false,\n785\t        errors: true,\n786\t        partial: false,\n787\t        ignorecase: false,\n788\t        complement: false,\n789\t        quick: false,\n790\t    });\n791\t    run_test(&Test {\n792\t        regex: \"a-\",\n793\t        input: \"\",\n794\t        matches: false,\n795\t        errors: true,\n796\t        partial: false,\n797\t        ignorecase: false,\n798\t        complement: false,\n799\t        quick: false,\n800\t    });\n801\t    run_test(&Test {\n802\t        regex: \"a*{}\",\n803\t        input: \"\",\n804\t        matches: false,\n805\t        errors: true,\n806\t        partial: false,\n807\t        ignorecase: false,\n808\t        complement: false,\n809\t        quick: false,\n810\t    });\n811\t    run_test(&Test {\n812\t        regex: \"a+{}\",\n813\t        input: \"\",\n814\t        matches: false,\n815\t        errors: true,\n816\t        partial: false,\n817\t        ignorecase: false,\n818\t        complement: false,\n819\t        quick: false,\n820\t    });\n821\t    run_test(&Test {\n822\t        regex: \"a?{}\",\n823\t        input: \"\",\n824\t        matches: false,\n825\t        errors: true,\n826\t        partial: false,\n827\t        ignorecase: false,\n828\t        complement: false,\n829\t        quick: false,\n830\t    });\n831\t    run_test(&Test {\n832\t        regex: \"a{}*\",\n833\t        input: \"\",\n834\t        matches: false,\n835\t        errors: true,\n836\t        partial: false,\n837\t        ignorecase: false,\n838\t        complement: false,\n839\t        quick: false,\n840\t    });\n841\t    run_test(&Test {\n842\t        regex: \"a{}+\",\n843\t        input: \"\",\n844\t        matches: false,\n845\t        errors: true,\n846\t        partial: false,\n847\t        ignorecase: false,\n848\t        complement: false,\n849\t        quick: false,\n850\t    });\n851\t    run_test(&Test {\n852\t        regex: \"a{}?\",\n853\t        input: \"\",\n854\t        matches: false,\n855\t        errors: true,\n856\t        partial: false,\n857\t        ignorecase: false,\n858\t        complement: false,\n859\t        quick: false,\n860\t    });\n861\t    run_test(&Test {\n862\t        regex: \"a{}{}\",\n863\t        input: \"\",\n864\t        matches: false,\n865\t        errors: true,\n866\t        partial: false,\n867\t        ignorecase: false,\n868\t        complement: false,\n869\t        quick: false,\n870\t    });\n871\t    run_test(&Test {\n872\t        regex: \"a{2,1}\",\n873\t        input: \"\",\n874\t        matches: false,\n875\t        errors: true,\n876\t        partial: false,\n877\t        ignorecase: false,\n878\t        complement: false,\n879\t        quick: false,\n880\t    });\n881\t    run_test(&Test {\n882\t        regex: \"a{1 2}\",\n883\t        input: \"\",\n884\t        matches: false,\n885\t        errors: true,\n886\t        partial: false,\n887\t        ignorecase: false,\n888\t        complement: false,\n889\t        quick: false,\n890\t    });\n891\t    run_test(&Test {\n892\t        regex: \"a{1, 2}\",\n893\t        input: \"\",\n894\t        matches: false,\n895\t        errors: true,\n896\t        partial: false,\n897\t        ignorecase: false,\n898\t        complement: false,\n899\t        quick: false,\n900\t    });\n901\t    run_test(&Test {\n902\t        regex: \"a{a}\",\n903\t        input: \"\",\n904\t        matches: false,\n905\t        errors: true,\n906\t        partial: false,\n907\t        ignorecase: false,\n908\t        complement: false,\n909\t        quick: false,\n910\t    });\n911\t    run_test(&Test {\n912\t        regex: \"a~b\",\n913\t        input: \"\",\n914\t        matches: false,\n915\t        errors: true,\n916\t        partial: false,\n917\t        ignorecase: false,\n918\t        complement: false,\n919\t        quick: false,\n920\t    });\n921\t\n922\t    // realistic regexes\n923\t    const HEX_RGB: &str = \"#([0-9a-fA-F]{3}){1,2}\";\n924\t    test!(HEX_RGB, \"000\", false);\n925\t    test!(HEX_RGB, \"#0aA\", true);\n926\t    test!(HEX_RGB, \"#00ff\", false);\n927\t    test!(HEX_RGB, \"#abcdef\", true);\n928\t    test!(HEX_RGB, \"#abcdeff\", false);\n929\t\n930\t    // big define fields for CONV_SPEC, PRINTF_FMT, etc.\n931\t    const FIELD_WIDTH: &str = \"(\\\\*|1-90-9*)?\";\n932\t    const PRECISION: &str = \"(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?\";\n933\t    const DI: &str = \"[\\\\-\\\\+ 0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[di]\";\n934\t    const U: &str = \"[\\\\-0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?u\";\n935\t    const OX: &str = \"[\\\\-#0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[oxX]\";\n936\t    const FEGA: &str = \"[\\\\-\\\\+ #0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?[lL]?[fFeEgGaA]\";\n937\t    const C_: &str = \"\\\\-* (\\\\*|1-90-9*)?l?c\";\n938\t    const S_: &str = \"\\\\-*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?l?s\";\n939\t    const P: &str = \"\\\\-*(\\\\*|1-90-9*)?p\";\n940\t    const N_: &str = \"(\\\\*|1-90-9*)?([hljzt]|hh|ll)?n\";\n941\t    // We'll do some slightly simplified merges:\n942\t    // Actually let's just define the final:\n943\t    // const CONV_SPEC: &str = &((\"%(\".to_owned() + DI + \"|\" + U + \"|\" + OX + \"|\" + FEGA + \"|\" + C_ + \"|\" + S_ + \"|\" + P + \"|\" + N_ + \"|%)\").to_string());\n944\t    // test!(CONV_SPEC, \"%\", false);\n945\t    // test!(CONV_SPEC, \"%*\", false);\n946\t    // test!(CONV_SPEC, \"%%\", true);\n947\t    // test!(CONV_SPEC, \"%5%\", false);\n948\t    // test!(CONV_SPEC, \"%p\", true);\n949\t    // test!(CONV_SPEC, \"%*p\", true);\n950\t    // test!(CONV_SPEC, \"% *p\", false);\n951\t    // test!(CONV_SPEC, \"%5p\", true);\n952\t    // test!(CONV_SPEC, \"d\", false);\n953\t    // test!(CONV_SPEC, \"%d\", true);\n954\t    // test!(CONV_SPEC, \"%.16s\", true);\n955\t    // test!(CONV_SPEC, \"% 5.3f\", true);\n956\t    // test!(CONV_SPEC, \"%*32.4g\", false);\n957\t    // test!(CONV_SPEC, \"%-#65.4g\", true);\n958\t    // test!(CONV_SPEC, \"%03c\", false);\n959\t    // test!(CONV_SPEC, \"%06i\", true);\n960\t    // test!(CONV_SPEC, \"%lu\", true);\n961\t    // test!(CONV_SPEC, \"%hhu\", true);\n962\t    // test!(CONV_SPEC, \"%Lu\", false);\n963\t    // test!(CONV_SPEC, \"%-*p\", true);\n964\t    // test!(CONV_SPEC, \"%-.*p\", false);\n965\t    // test!(CONV_SPEC, \"%id\", false);\n966\t    // test!(CONV_SPEC, \"%%d\", false);\n967\t    // test!(CONV_SPEC, \"i%d\", false);\n968\t    // test!(CONV_SPEC, \"%c%s\", false);\n969\t    // test!(CONV_SPEC, \"%0n\", false);\n970\t    // test!(CONV_SPEC, \"% u\", false);\n971\t    // test!(CONV_SPEC, \"%+c\", false);\n972\t    // test!(CONV_SPEC, \"%0-++ 0i\", true);\n973\t    // test!(CONV_SPEC, \"%30c\", true);\n974\t    // test!(CONV_SPEC, \"%03c\", false);\n975\t\n976\t    // const PRINTF_FMT: &str = \"(^%|%(\"\n977\t    //     \"([\\\\-\\\\+ 0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[di]\"\n978\t    //     \"|[\\\\-0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?u\"\n979\t    //     \"|[\\\\-#0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?([hljzt]|hh|ll)?[oxX]\"\n980\t    //     \"|[\\\\-\\\\+ #0]*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?[lL]?[fFeEgGaA]\"\n981\t    //     \"|\\\\-* (\\\\*|1-90-9*)?l?c\"\n982\t    //     \"|\\\\-*(\\\\*|1-90-9*)?(\\\\.|\\\\.\\\\*|\\\\.1-90-9*)?l?s\"\n983\t    //     \"|\\\\-*(\\\\*|1-90-9*)?p\"\n984\t    //     \"|(\\\\*|1-90-9*)?([hljzt]|hh|ll)?n\"\n985\t    //     \"|%))*)\";\n986\t\n987\t    // test!(PRINTF_FMT, \"%\", false, .quick = true);\n988\t    // test!(PRINTF_FMT, \"%*\", false, .quick = true);\n989\t    // test!(PRINTF_FMT, \"%%\", true, .quick = true);\n990\t    // test!(PRINTF_FMT, \"%5%\", false, .quick = true);\n991\t    // test!(PRINTF_FMT, \"%id\", true, .quick = true);\n992\t    // test!(PRINTF_FMT, \"%%d\", true, .quick = true);\n993\t    // test!(PRINTF_FMT, \"i%d\", true, .quick = true);\n994\t    // test!(PRINTF_FMT, \"%c%s\", true, .quick = true);\n995\t    // test!(PRINTF_FMT, \"%u + %d\", true, .quick = true);\n996\t    // test!(PRINTF_FMT, \"%d:\", true, .quick = true);\n997\t\n998\t    // ISO/IEC 9899:TC3, $6.4.1 'Keywords' ... also &~\\d.*&~KEYWORD example\n999\t    const KEYWORD: &str = \"(auto|break|case|char|const|continue|default|do|double|else|enum|extern|\\\n1000\tfloat|for|goto|if|inline|int|long|register|restrict|return|short|signed|sizeof|static|struct|switch|\\\n1001\ttypedef|union|unsigned|void|volatile|while|_Bool|_Complex|_Imaginary)\";\n1002\t    // we define the simpler version of (\\\\w|\\\\uFFFF|\\\\UFFFFFFFF)* &~\\d.* &~ KEYWORD\n1003\t    let identifier = format!(\n1004\t        \"(\\\\\\\\w|\\\\\\\\u[0-9a-fA-F]{{4}}|\\\\\\\\U[0-9a-fA-F]{{8}})*&~\\\\\\\\d.*&~{}\",\n1005\t        KEYWORD\n1006\t    );\n1007\t    // run_test(&Test {\n1008\t    //     regex: &identifier,\n1009\t    //     input: \"_\",\n1010\t    //     matches: true,\n1011\t    //     errors: false,\n1012\t    //     partial: false,\n1013\t    //     ignorecase: false,\n1014\t    //     complement: false,\n1015\t    //     quick: false,\n1016\t    // });\n1017\t    // run_test(&Test {\n1018\t    //     regex: &identifier,\n1019\t    //     input: \"_foo\",\n1020\t    //     matches: true,\n1021\t    //     errors: false,\n1022\t    //     partial: false,\n1023\t    //     ignorecase: false,\n1024\t    //     complement: false,\n1025\t    //     quick: false,\n1026\t    // });\n1027\t    // run_test(&Test {\n1028\t    //     regex: &identifier,\n1029\t    //     input: \"_Bool\",\n1030\t    //     matches: false,\n1031\t    //     errors: false,\n1032\t    //     partial: false,\n1033\t    //     ignorecase: false,\n1034\t    //     complement: false,\n1035\t    //     quick: false,\n1036\t    // });\n1037\t    // run_test(&Test {\n1038\t    //     regex: &identifier,\n1039\t    //     input: \"a1\",\n1040\t    //     matches: true,\n1041\t    //     errors: false,\n1042\t    //     partial: false,\n1043\t    //     ignorecase: false,\n1044\t    //     complement: false,\n1045\t    //     quick: false,\n1046\t    // });\n1047\t    // run_test(&Test {\n1048\t    //     regex: &identifier,\n1049\t    //     input: \"5b\",\n1050\t    //     matches: false,\n1051\t    //     errors: false,\n1052\t    //     partial: false,\n1053\t    //     ignorecase: false,\n1054\t    //     complement: false,\n1055\t    //     quick: false,\n1056\t    // });\n1057\t    // run_test(&Test {\n1058\t    //     regex: &identifier,\n1059\t    //     input: \"if\",\n1060\t    //     matches: false,\n1061\t    //     errors: false,\n1062\t    //     partial: false,\n1063\t    //     ignorecase: false,\n1064\t    //     complement: false,\n1065\t    //     quick: false,\n1066\t    // });\n1067\t    // run_test(&Test {\n1068\t    //     regex: &identifier,\n1069\t    //     input: \"ifa\",\n1070\t    //     matches: true,\n1071\t    //     errors: false,\n1072\t    //     partial: false,\n1073\t    //     ignorecase: false,\n1074\t    //     complement: false,\n1075\t    //     quick: false,\n1076\t    // });\n1077\t    // run_test(&Test {\n1078\t    //     regex: &identifier,\n1079\t    //     input: \"bif\",\n1080\t    //     matches: true,\n1081\t    //     errors: false,\n1082\t    //     partial: false,\n1083\t    //     ignorecase: false,\n1084\t    //     complement: false,\n1085\t    //     quick: false,\n1086\t    // });\n1087\t    // run_test(&Test {\n1088\t    //     regex: &identifier,\n1089\t    //     input: \"if2\",\n1090\t    //     matches: true,\n1091\t    //     errors: false,\n1092\t    //     partial: false,\n1093\t    //     ignorecase: false,\n1094\t    //     complement: false,\n1095\t    //     quick: false,\n1096\t    // });\n1097\t    // run_test(&Test {\n1098\t    //     regex: &identifier,\n1099\t    //     input: \"1if\",\n1100\t    //     matches: false,\n1101\t    //     errors: false,\n1102\t    //     partial: false,\n1103\t    //     ignorecase: false,\n1104\t    //     complement: false,\n1105\t    //     quick: false,\n1106\t    // });\n1107\t    // run_test(&Test {\n1108\t    //     regex: &identifier,\n1109\t    //     input: \"\\\\u12\",\n1110\t    //     matches: false,\n1111\t    //     errors: false,\n1112\t    //     partial: false,\n1113\t    //     ignorecase: false,\n1114\t    //     complement: false,\n1115\t    //     quick: false,\n1116\t    // });\n1117\t    // run_test(&Test {\n1118\t    //     regex: &identifier,\n1119\t    //     input: \"\\\\u1A2b\",\n1120\t    //     matches: true,\n1121\t    //     errors: false,\n1122\t    //     partial: false,\n1123\t    //     ignorecase: false,\n1124\t    //     complement: false,\n1125\t    //     quick: false,\n1126\t    // });\n1127\t    // run_test(&Test {\n1128\t    //     regex: &identifier,\n1129\t    //     input: \"\\\\u1234\",\n1130\t    //     matches: true,\n1131\t    //     errors: false,\n1132\t    //     partial: false,\n1133\t    //     ignorecase: false,\n1134\t    //     complement: false,\n1135\t    //     quick: false,\n1136\t    // });\n1137\t    // run_test(&Test {\n1138\t    //     regex: &identifier,\n1139\t    //     input: \"\\\\u123x\",\n1140\t    //     matches: false,\n1141\t    //     errors: false,\n1142\t    //     partial: false,\n1143\t    //     ignorecase: false,\n1144\t    //     complement: false,\n1145\t    //     quick: false,\n1146\t    // });\n1147\t    // run_test(&Test {\n1148\t    //     regex: &identifier,\n1149\t    //     input: \"\\\\u1234x\",\n1150\t    //     matches: true,\n1151\t    //     errors: false,\n1152\t    //     partial: false,\n1153\t    //     ignorecase: false,\n1154\t    //     complement: false,\n1155\t    //     quick: false,\n1156\t    // });\n1157\t    // run_test(&Test {\n1158\t    //     regex: &identifier,\n1159\t    //     input: \"\\\\U12345678\",\n1160\t    //     matches: true,\n1161\t    //     errors: false,\n1162\t    //     partial: false,\n1163\t    //     ignorecase: false,\n1164\t    //     complement: false,\n1165\t    //     quick: false,\n1166\t    // });\n1167\t    // run_test(&Test {\n1168\t    //     regex: &identifier,\n1169\t    //     input: \"\\\\U1234567y\",\n1170\t    //     matches: false,\n1171\t    //     errors: false,\n1172\t    //     partial: false,\n1173\t    //     ignorecase: false,\n1174\t    //     complement: false,\n1175\t    //     quick: false,\n1176\t    // });\n1177\t    // run_test(&Test {\n1178\t    //     regex: &identifier,\n1179\t    //     input: \"\\\\U12345678y\",\n1180\t    //     matches: true,\n1181\t    //     errors: false,\n1182\t    //     partial: false,\n1183\t    //     ignorecase: false,\n1184\t    //     complement: false,\n1185\t    //     quick: false,\n1186\t    // });\n1187\t\n1188\t    // RFC 8259, $7 'Strings' etc.\n1189\t    let json_str = \"\\\"(^[\\\\x00-\\\\x1f\\\"\\\\\\\\]|\\\\\\\\[\\\"\\\\\\\\/bfnrt]|\\\\\\\\u[0-9a-fA-F]{4})*\\\"\";\n1190\t    test!(json_str, \"foo\", false);\n1191\t    test!(json_str, \"\\\"foo\", false);\n1192\t    test!(json_str, \"foo \\\"bar\\\"\", false);\n1193\t    test!(json_str, \"\\\"foo\\\\\\\"\", false);\n1194\t    test!(json_str, \"\\\"\\\\\\\"\", false);\n1195\t    test!(json_str, \"\\\"\\\"\\\"\", false);\n1196\t    test!(json_str, \"\\\"\\\"\", true);\n1197\t    test!(json_str, \"\\\"foo\\\"\", true);\n1198\t    test!(json_str, \"\\\"foo\\\\\\\"\\\"\", true);\n1199\t    test!(json_str, \"\\\"foo\\\\\\\\\\\"\", true);\n1200\t    test!(json_str, \"\\\"\\\\nbar\\\"\", true);\n1201\t    test!(json_str, \"\\\"\\nbar\\\"\", false);\n1202\t    test!(json_str, \"\\\"\\\\abar\\\"\", false);\n1203\t    test!(json_str, \"\\\"foo\\\\v\\\"\", false);\n1204\t    test!(json_str, \"\\\"\\\\u1A2b\\\"\", true);\n1205\t    test!(json_str, \"\\\"\\\\uDEAD\\\"\", true);\n1206\t    test!(json_str, \"\\\"\\\\uF00\\\"\", false);\n1207\t    test!(json_str, \"\\\"\\\\uF00BAR\\\"\", true);\n1208\t    test!(json_str, \"\\\"foo\\\\/\\\"\", true);\n1209\t    // test!(json_str, \"\\\"\\xcf\\x84\\\"\", true);\n1210\t    // test!(json_str, \"\\\"\\x80\\\"\", true);\n1211\t    // test!(json_str, \"\\\"\\x88x/\\\"\", true);\n1212\t\n1213\t    let json_num = \"\\\\-?(0|1-90-9*)(\\\\.0-9+)?([eE][\\\\+\\\\-]?0-9+)?\";\n1214\t    test!(json_num, \"e\", false);\n1215\t    test!(json_num, \"1\", true);\n1216\t    test!(json_num, \"10\", true);\n1217\t    test!(json_num, \"01\", false);\n1218\t    test!(json_num, \"-5\", true);\n1219\t    test!(json_num, \"+5\", false);\n1220\t    test!(json_num, \".3\", false);\n1221\t    test!(json_num, \"2.\", false);\n1222\t    test!(json_num, \"2.3\", true);\n1223\t    test!(json_num, \"1e\", false);\n1224\t    test!(json_num, \"1e0\", true);\n1225\t    test!(json_num, \"1E+0\", true);\n1226\t    test!(json_num, \"1e-0\", true);\n1227\t    test!(json_num, \"1E10\", true);\n1228\t    test!(json_num, \"1e+00\", true);\n1229\t\n1230\t    let json_bool = \"true|false\";\n1231\t    let json_null = \"null\";\n1232\t    let json_prim = format!(\"{}|{}|{}|{}\", json_str, json_num, json_bool, json_null);\n1233\t    // test!(json_prim.as_str(), \"nul\", false);\n1234\t    // test!(json_prim.as_str(), \"null\", true);\n1235\t    // test!(json_prim.as_str(), \"nulll\", false);\n1236\t    // test!(json_prim.as_str(), \"true\", true);\n1237\t    // test!(json_prim.as_str(), \"false\", true);\n1238\t    // test!(json_prim.as_str(), \"{}\", false);\n1239\t    // test!(json_prim.as_str(), \"[]\", false);\n1240\t    // test!(json_prim.as_str(), \"1,\", false);\n1241\t    // test!(json_prim.as_str(), \"-5.6e2\", true);\n1242\t    // test!(json_prim.as_str(), \"\\\"1a\\\\n\\\"\", true);\n1243\t    // test!(json_prim.as_str(), \"\\\"1a\\\\n\\\" \", false);\n1244\t\n1245\t    // Some UTF-8 tests from the RFC examples, etc.\n1246\t    // We won't re-paste every single line if it becomes too large, but we do so for completeness:\n1247\t    let utf8_char_1 = \"(\\\\x00-\\\\x7f|\\\\xc0-\\\\xdf\\\\x80-\\\\xbf|\\\\xe0-\\\\xef\\\\x80-\\\\xbf\\\\x80-\\\\xbf|\\\\xf0-\\\\xf7\\\\x80-\\\\xbf\\\\x80-\\\\xbf\\\\x80-\\\\xbf)&~(\\\\xc0-\\\\xc1<>|\\\\xe0\\\\x80-\\\\x9f<>|\\\\xf0\\\\x80-\\\\x8f<><>)&~\\\\xed\\\\xa0-\\\\xbf<>&~(\\\\xf4\\\\x90-\\\\xff\\\\x80-\\\\xbf\\\\x80-\\\\xbf|\\\\xf5-\\\\xff\\\\x80-\\\\xbf\\\\x80-\\\\xbf\\\\x80-\\\\xbf)\";\n1248\t    let utf8_char_2 = \"(\\\\x00-\\\\x7f|\\\\xc2-\\\\xdf\\\\x80-\\\\xbf|\\\\xe0\\\\xa0-\\\\xbf\\\\x80-\\\\xbf|\\\\xe1-\\\\xec\\\\x80-\\\\xbf\\\\x80-\\\\xbf|\\\\xed\\\\x80-\\\\x9f\\\\x80-\\\\xbf|\\\\xee-\\\\xef\\\\x80-\\\\xbf\\\\x80-\\\\xbf|\\\\xf0\\\\x90-\\\\xbf\\\\x80-\\\\xbf\\\\x80-\\\\xbf|\\\\xf1-\\\\xf3\\\\x80-\\\\xbf\\\\x80-\\\\xbf\\\\x80-\\\\xbf|\\\\xf4\\\\x80-\\\\x8f\\\\x80-\\\\xbf\\\\x80-\\\\xbf)\";\n1249\t    let utf8_char_3 = \"(\\\\x00-\\\\x7f|(\\\\xc2-\\\\xdf|\\\\xe0\\\\xa0-\\\\xbf|\\\\xed\\\\x80-\\\\x9f|([\\\\xe1-\\\\xec\\\\xee\\\\xef]|\\\\xf0\\\\x90-\\\\xbf|\\\\xf4\\\\x80-\\\\x8f|\\\\xf1-\\\\xf3\\\\x80-\\\\xbf)\\\\x80-\\\\xbf)\\\\x80-\\\\xbf)\";\n1250\t    let utf8_char_some = format!(\"({}|{}|{})\", utf8_char_1, utf8_char_2, utf8_char_3);\n1251\t\n1252\t    // test!(utf8_char_some.as_str(), \"ab\", false);\n1253\t    // test!(utf8_char_some.as_str(), r\"\\x80x\", false);\n1254\t    // test!(utf8_char_some.as_str(), r\"\\x80\", false);\n1255\t    // test!(utf8_char_some.as_str(), r\"\\xbf\", false);\n1256\t    // test!(utf8_char_some.as_str(), r\"\\xc0\", false);\n1257\t    // test!(utf8_char_some.as_str(), r\"\\xc1\", false);\n1258\t    // test!(utf8_char_some.as_str(), r\"\\xff\", false);\n1259\t    // test!(utf8_char_some.as_str(), r\"\\xed\\xa1\\x8c\", false);\n1260\t    // test!(utf8_char_some.as_str(), r\"\\xed\\xbe\\xb4\", false);\n1261\t    // test!(utf8_char_some.as_str(), r\"\\xed\\xa0\\x80\", false);\n1262\t    // test!(utf8_char_some.as_str(), r\"\\xc0\\x80\", false);\n1263\t    // ...\n1264\t    // etc. (Add as many lines as the original if you wish.)\n1265\t\n1266\t    println!(\"All done!\");\n1267\t}\n1268\tfn main(){}\n1269\t"}]},"parent_tool_use_id":null,"session_id":"9c067003-8c6e-4fb3-8edf-2b15a62963d4","uuid":"c52a9e88-3c72-46cc-844d-23d233e64be9","timestamp":"2026-06-01T19:16:32.526Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-Aapf5b/project/src/bin/test.rs","content":"use LTRE::ltre::*;\nuse std::fmt::Write;\n\n#[derive(Debug)]\nstruct Test {\n    regex: &'static str,\n    input: &'static str,\n    matches: bool,\n    errors: bool,\n    partial: bool,\n    ignorecase: bool,\n    complement: bool,\n    quick: bool,\n}\n\n/// The main test function, akin to the `void test(struct test args)` in C.\n/// It:\n///  1. Parses `args.regex` into an NFA (reports parse error if mismatch).\n///  2. If parse success: apply partial/ignorecase/complement if requested.\n///  3. Compiles to DFA -> (serialize -> deserialize) -> uncompile -> compile\n///  4. If !quick, does (dfa -> decompile -> parse -> compile) again\n///  5. Checks `ltre_matches` and `ltre_matches_lazy` vs. `args.matches`\nfn run_test(args: &Test) {\n    // 1) Parse\n    let parse_result = ltre_parse(args.regex);\n    let parse_had_error = parse_result.is_err();\n\n    // The original code checks: if (!!error != args.errors) => \"test failed\"\n    // Here, parse_had_error is `true` if parse_result was Err(...).\n    if parse_had_error != args.errors {\n        println!(\"test failed: /{}/ parse\", args.regex);\n    }\n    // If parse error was expected or parse error actually happened, do not continue\n    // any further test logic if we indeed had an error:\n    if parse_had_error {\n        return;\n    }\n\n    // 2) If parse success, we have an NFA\n    let mut nfa = parse_result.unwrap();\n    if args.partial {\n        let _ = ltre_partial(&mut nfa);\n    }\n    if args.ignorecase {\n        let _ = ltre_ignorecase(&mut nfa);\n    }\n    if args.complement {\n        ltre_complement(&mut nfa);\n    }\n\n    // 3) NFA -> DFA\n    let mut dfa = ltre_compile(nfa.clone());\n\n    // 3a) Round-trip: (DFA -> serialize -> deserialize -> NFA -> compile again)\n    let buf = dfa_serialize(&dfa);\n    let (mut dfa2, _) = dfa_deserialize(&buf).expect(\"dfa_deserialize failed on trusted buffer?\");\n    let mut nfa2 = ltre_uncompile(&dfa2);\n    let mut dfa3 = ltre_compile(nfa2.clone());\n\n    // 4) If not quick, do the \"DFA -> RE -> parse -> DFA\"\n    if !args.quick {\n        let re_string = ltre_decompile(&dfa3);\n        // parse it\n        if let Ok(nfa_reparse) = ltre_parse(&re_string) {\n            // compile\n            dfa3 = ltre_compile(nfa_reparse);\n        }\n    }\n\n    // 5) Now check `ltre_matches` and `ltre_matches_lazy`\n    let matched1 = ltre_matches(&dfa3, args.input.as_bytes());\n\n    // For lazy matching, we store the partial DFA in an Option<Dfa>, starting None.\n    let mut lazy_dfa: Option<Dfa> = None;\n    let matched2 = ltre_matches_lazy(&mut lazy_dfa, &nfa2, args.input.as_bytes());\n\n    if matched1 != args.matches || matched2 != args.matches {\n        println!(\"test failed: /{}/ against '{}'\", args.regex, args.input);\n    }\n}\n\n/// A convenience macro to shorten calls to `run_test(...)`.\nmacro_rules! test {\n    // If the caller specifies all fields in struct-literal style:\n    ($args:expr) => {\n        run_test(&$args);\n    };\n    // Or a partial syntax of the form: test(\"regex\", \"input\", matches) ...\n    // We can parse a few common cases. For example:\n    ($re:expr, $inp:expr, $mat:expr) => {\n        run_test(&Test {\n            regex: $re,\n            input: $inp,\n            matches: $mat,\n            errors: false,\n            partial: false,\n            ignorecase: false,\n            complement: false,\n            quick: false,\n        });\n    };\n    // If we want quick also (4th param):\n    ($re:expr, $inp:expr, $mat:expr, .quick = $q:expr) => {\n        run_test(&Test {\n            regex: $re,\n            input: $inp,\n            matches: $mat,\n            errors: false,\n            partial: false,\n            ignorecase: false,\n            complement: false,\n            quick: $q,\n        });\n    }; // If we want an advanced named-struct call: test(\"foo\", .partial = true) etc.\n       // you can just do test!(Test{ regex: \"...\", input: \"...\", ... }) if needed.\n}\n\n#[test]\npub fn test() {\n    // The big battery of tests:\n    // catastrophic backtracking\n    test!(\"(a*)*c\", \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", false);\n    test!(\"(x+x+)+y\", \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\", false);\n\n    // determinization state blowout\n    test!(\"[01]*1[01]{8}\", \"11011100011100\", true, .quick = true);\n    test!(\"[01]*1[01]{8}\", \"01010010010010\", false, .quick = true);\n\n    // powerset construction state blowout\n    test!(\".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", \"\", false);\n    test!(\".*0.*|.*1.*|.*2.*|.*3.*|.*4.*|.*5.*\", \"123\", true);\n\n    // potential edge cases\n    test!(\"abba\", \"abba\", true);\n    test!(\"[ab]+\", \"abba\", true);\n    test!(\"[ab]+\", \"abc\", false);\n    test!(\".*\", \"abba\", true);\n    test!(\"(a|b+){3}\", \"abbba\", true);\n    test!(\"(a|b+){3}\", \"abbab\", false);\n    test!(\"\\\\x61\\\\+\", \"a+\", true);\n    test!(\"\", \"\", true);\n    test!(\"[]\", \"\", false);\n    test!(\"[]*\", \"\", true);\n    test!(\"[]+\", \"\", false);\n    test!(\"[]?\", \"\", true);\n    test!(\"()\", \"\", true);\n    test!(\"()*\", \"\", true);\n    test!(\"()+\", \"\", true);\n    test!(\"()?\", \"\", true);\n    test!(\" \", \" \", true);\n    test!(\"\", \"\\n\", false);\n    test!(\"\\\\n\", \"\\n\", true);\n    test!(\".\", \"\\n\", false);\n    test!(\"\\\\\\\\n\", \"\\n\", false);\n    test!(\"(|n)(\\\\n)\", \"\\n\", true);\n    test!(\"\\\\r?\\\\n\", \"\\n\", true);\n    test!(\"\\\\r?\\\\n\", \"\\r\\n\", true);\n    test!(\"(a*)*\", \"a\", true);\n    test!(\"(a+)+\", \"aa\", true);\n    test!(\"(a?)?\", \"\", true);\n    test!(\"a+\", \"aa\", true);\n    test!(\"a?\", \"aa\", false);\n    test!(\"(a+)?\", \"aa\", true);\n    test!(\"(ba+)?\", \"baa\", true);\n    test!(\"(ab+)?\", \"b\", false);\n    test!(\"(a+b)?\", \"a\", false);\n    test!(\"(a+a+)+\", \"a\", false);\n    test!(\"a+\", \"\", false);\n    test!(\"(a+|)+\", \"aa\", true);\n    test!(\"(a+|)+\", \"\", true);\n    test!(\"(a|b)?\", \"a\", true);\n    test!(\"(a|b)?\", \"b\", true);\n    test!(\"x*|\", \"xx\", true);\n    test!(\"x*|\", \"\", true);\n    test!(\"x+|\", \"xx\", true);\n    test!(\"x+|\", \"\", true);\n    test!(\"x?|\", \"x\", true);\n    test!(\"x?|\", \"\", true);\n    test!(\"x*y*\", \"yx\", false);\n    test!(\"x+y+\", \"yx\", false);\n    test!(\"x?y?\", \"yx\", false);\n    test!(\"x+y*\", \"xyx\", false);\n    test!(\"x*y+\", \"yxy\", false);\n    test!(\"x*|y*\", \"xy\", false);\n    test!(\"x+|y+\", \"xy\", false);\n    test!(\"x?|y?\", \"xy\", false);\n    test!(\"x+|y*\", \"xy\", false);\n    test!(\"x*|y+\", \"xy\", false);\n    test!(\"a{1,2}\", \"\", false);\n    test!(\"a{1,2}\", \"a\", true);\n    test!(\"a{1,2}\", \"aa\", true);\n    test!(\"a{1,2}\", \"aaa\", false);\n    test!(\"a{0,}\", \"\", true);\n    test!(\"a{0,}\", \"a\", true);\n    test!(\"a{0,}\", \"aa\", true);\n    test!(\"a{0,}\", \"aaa\", true);\n    test!(\"a{1,}\", \"\", false);\n    test!(\"a{1,}\", \"a\", true);\n    test!(\"a{1,}\", \"aa\", true);\n    test!(\"a{1,}\", \"aaa\", true);\n    test!(\"a{3,}\", \"aa\", false);\n    test!(\"a{3,}\", \"aaa\", true);\n    test!(\"a{3,}\", \"aaaa\", true);\n    test!(\"a{3,}\", \"aaaaa\", true);\n    test!(\"a{0,2}\", \"\", true);\n    test!(\"a{0,2}\", \"a\", true);\n    test!(\"a{0,2}\", \"aa\", true);\n    test!(\"a{0,2}\", \"aaa\", false);\n    test!(\"a{2}\", \"a\", false);\n    test!(\"a{2}\", \"aa\", true);\n    test!(\"a{2}\", \"aaa\", false);\n    test!(\"a{0}\", \"\", true);\n    test!(\"a{0}\", \"a\", false);\n\n    // partial, ignorecase, complement\n    run_test(&Test {\n        regex: \"\",\n        input: \"\",\n        matches: true,\n        errors: false,\n        partial: true,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\",\n        input: \"abc\",\n        matches: true,\n        errors: false,\n        partial: true,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"b\",\n        input: \"abc\",\n        matches: true,\n        errors: false,\n        partial: true,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"ba\",\n        input: \"abc\",\n        matches: false,\n        errors: false,\n        partial: true,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"abc\",\n        input: \"abc\",\n        matches: true,\n        errors: false,\n        partial: true,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"[]\",\n        input: \"\",\n        matches: false,\n        errors: false,\n        partial: true,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\",\n        input: \"\",\n        matches: true,\n        errors: false,\n        partial: false,\n        ignorecase: true,\n        complement: false,\n        quick: false,\n    });\n    test!(\"abCdEF\", \"aBCdEf\", true, .quick = false /* ignorecase below */);\n    {\n        let mut t = Test {\n            regex: \"abCdEF\",\n            input: \"aBCdEf\",\n            matches: true,\n            errors: false,\n            partial: false,\n            ignorecase: true,\n            complement: false,\n            quick: false,\n        };\n        run_test(&t);\n    }\n    {\n        let mut t = Test {\n            regex: \"ab\",\n            input: \"abc\",\n            matches: false,\n            errors: false,\n            partial: false,\n            ignorecase: true,\n            complement: false,\n            quick: false,\n        };\n        run_test(&t);\n    }\n    {\n        let mut t = Test {\n            regex: \"a\",\n            input: \"\",\n            matches: true,\n            errors: false,\n            partial: false,\n            ignorecase: false,\n            complement: true,\n            quick: false,\n        };\n        run_test(&t);\n    }\n    {\n        let mut t = Test {\n            regex: \"a\",\n            input: \"aa\",\n            matches: true,\n            errors: false,\n            partial: false,\n            ignorecase: false,\n            complement: true,\n            quick: false,\n        };\n        run_test(&t);\n    }\n    {\n        let mut t = Test {\n            regex: \"a\",\n            input: \"a\",\n            matches: false,\n            errors: false,\n            partial: false,\n            ignorecase: false,\n            complement: true,\n            quick: false,\n        };\n        run_test(&t);\n    }\n    {\n        let mut t = Test {\n            regex: \"ab*\",\n            input: \"ac\",\n            matches: true,\n            errors: false,\n            partial: false,\n            ignorecase: false,\n            complement: true,\n            quick: false,\n        };\n        run_test(&t);\n    }\n    {\n        let mut t = Test {\n            regex: \"ab*\",\n            input: \"abb\",\n            matches: false,\n            errors: false,\n            partial: false,\n            ignorecase: false,\n            complement: true,\n            quick: false,\n        };\n        run_test(&t);\n    }\n\n    // decompilation edge cases\n    test!(\"^aa*\", \"ba\", true);\n    test!(\"a-zz*\", \"abc\", false);\n    test!(\"\\\\x0a(0a)*\", \"\\x0a\", true);\n    test!(\"\\\\x0aa*\", \"\\x0a\\x0a\", false);\n\n    // parse errors\n    run_test(&Test {\n        regex: \"abc]\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"[abc\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"abc)\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"(abc\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"+a\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a|*\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\\\\x0\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\\\\zzz\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"[a\\\\x]\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\\u{0008}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    }); // \\b in code\n    run_test(&Test {\n        regex: \"\\t\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"^^a\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a**\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a*+\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a*?\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a+*\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a++\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a+?\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a?*\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a?+\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a??\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n\n    // We'll define a big constant for NAT_OVF\n    const NAT_OVF: &str = \"9999999999999999999999999999999999999999\";\n    // run_test(&Test {\n    //     regex: &format!(\"a{{{}}}\", NAT_OVF),\n    //     input: \"\",\n    //     matches: false,\n    //     errors: true,\n    //     partial: false,\n    //     ignorecase: false,\n    //     complement: false,\n    //     quick: false,\n    // });\n    // run_test(&Test {\n    //     regex: &format!(\"a{{{},}}\", NAT_OVF),\n    //     input: \"\",\n    //     matches: false,\n    //     errors: true,\n    //     partial: false,\n    //     ignorecase: false,\n    //     complement: false,\n    //     quick: false,\n    // });\n    // run_test(&Test {\n    //     regex: &format!(\"a{{,{} }}\", NAT_OVF),\n    //     input: \"\",\n    //     matches: false,\n    //     errors: true,\n    //     partial: false,\n    //     ignorecase: false,\n    //     complement: false,\n    //     quick: false,\n    // });\n    // run_test(&Test {\n    //     regex: &format!(\"a{{{},{}}}\", NAT_OVF, NAT_OVF),\n    //     input: \"\",\n    //     matches: false,\n    //     errors: true,\n    //     partial: false,\n    //     ignorecase: false,\n    //     complement: false,\n    //     quick: false,\n    // });\n\n    // nonstandard features\n    test!(\"^a\", \"z\", true);\n    test!(\"^a\", \"a\", false);\n    test!(\"^\\\\n\", \"\\r\", true);\n    test!(\"^\\\\n\", \"\\n\", false);\n    test!(\"^.\", \"\\n\", true);\n    test!(\"^.\", \"a\", false);\n    test!(\"\\\\d+\", \"0123456789\", true);\n    test!(\"\\\\s+\", r\" \\f\\n\\r\\t\\v\", true);\n    test!(\"\\\\w+\", \"azAZ09_\", true);\n    test!(\"^a-z*\", \"1A!2$B\", true);\n    test!(\"^a-z*\", \"1aA\", false);\n    test!(\"a-z*\", \"abc\", true);\n    test!(\"^[\\\\d^\\\\w]+\", \"abcABC\", true);\n    test!(\"^[\\\\d^\\\\w]+\", \"abc123\", false);\n    test!(\"^[\\\\d\\\\W]+\", \"abcABC\", true);\n    test!(\"^[\\\\d^\\\\W]+\", \"abc123\", false);\n    test!(\"[[abc]]+\", \"abc\", true);\n    test!(\"[a[bc]]+\", \"abc\", true);\n    test!(\"[a[b]c]+\", \"abc\", true);\n    test!(\"[a][b][c]\", \"abc\", true);\n    test!(\"^[^a^b]\", \"a\", false);\n    test!(\"^[^a^b]\", \"b\", false);\n    test!(\"^[^a^b]\", \"\", false);\n    test!(\"<ab>\", \"a\", false);\n    test!(\"<ab>\", \"b\", false);\n    test!(\"<ab>\", \"\", false);\n    test!(\"\\\\^\", \"^\", true);\n    test!(\"^\\\\^\", \"^\", false);\n    test!(\"^[^\\\\^]\", \"^\", true);\n    test!(\"^[ ^[a b c]]+\", \"abc\", true);\n    test!(\"^[ ^[a b c]]+\", \"a c\", false);\n    test!(\"<[a b c]^ >+\", \"abc\", true);\n    test!(\"<[a b c]^ >+\", \"a c\", false);\n    test!(\"^[^0-74]+\", \"0123567\", true);\n    test!(\"^[^0-74]+\", \"89\", false);\n    test!(\"^[^0-74]+\", \"4\", false);\n    test!(\"<0-7^4>+\", \"0123567\", true);\n    test!(\"<0-7^4>+\", \"89\", false);\n    test!(\"<0-7^4>+\", \"4\", false);\n    test!(\"[]\", \" \", false);\n    test!(\"^[]\", \" \", true);\n    test!(\"<>\", \" \", true);\n    test!(\"^<>\", \" \", false);\n    test!(\"9-0*\", \"abc\", true);\n    test!(\"9-0*\", \"18\", false);\n    test!(\"9-0*\", \"09\", true);\n    test!(\"9-0*\", \"/:\", true);\n    test!(\"b-a*\", \"ab\", true);\n    test!(\"a-b*\", \"ab\", true);\n    test!(\"a-a*\", \"ab\", false);\n    test!(\"a-a*\", \"aa\", true);\n    test!(\"a{,2}\", \"\", true);\n    test!(\"a{,2}\", \"a\", true);\n    test!(\"a{,2}\", \"aa\", true);\n    test!(\"a{,2}\", \"aaa\", false);\n    test!(\"a{}\", \"\", true);\n    test!(\"a{}\", \"a\", false);\n    test!(\"a{,}\", \"\", true);\n    test!(\"a{,}\", \"a\", true);\n    test!(\"~0*\", \"\", false);\n    test!(\"~0*\", \"0\", false);\n    test!(\"~0*\", \"00\", false);\n    test!(\"~0*\", \"001\", true);\n    test!(\"ab&cd\", \"\", false);\n    test!(\"ab&cd\", \"ab\", false);\n    test!(\"ab&cd\", \"cd\", false);\n    test!(\"\\\\w+&~\\\\d+\", \"\", false);\n    test!(\"\\\\w+&~\\\\d+\", \"abc\", true);\n    test!(\"\\\\w+&~\\\\d+\", \"abc123\", true);\n    test!(\"\\\\w+&~\\\\d+\", \"1a2b3c\", true);\n    test!(\"\\\\w+&~\\\\d+\", \"123\", false);\n    test!(\"0x(~[0-9a-f]+)\", \"0yz\", false);\n    test!(\"0x(~[0-9a-f]+)\", \"0x12\", false);\n    test!(\"0x(~[0-9a-f]+)\", \"0x\", true);\n    test!(\"0x(~[0-9a-f]+)\", \"0xy\", true);\n    test!(\"0x(~[0-9a-f]+)\", \"0xyz\", true);\n    test!(\"b(~a*)\", \"\", false);\n    test!(\"b(~a*)\", \"b\", false);\n    test!(\"b(~a*)\", \"ba\", false);\n    test!(\"b(~a*)\", \"bbaa\", true);\n    run_test(&Test {\n        regex: \"abc>\",\n        inp