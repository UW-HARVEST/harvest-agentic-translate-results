{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0153f9BXKekwK24padX1BFYg","type":"tool_result","content":"1\t#ifndef CLOSED_SYNCMERS_H\n2\t#define CLOSED_SYNCMERS_H\n3\t\n4\t#include <stdio.h>\n5\t#include <stdlib.h>\n6\t#include <stdint.h>\n7\t#include <string.h>\n8\t#include <inttypes.h>\n9\t\n10\t#ifdef __cplusplus\n11\textern \"C\" {\n12\t#endif\n13\t\n14\t/*** Function Declarations ***/\n15\t\n16\t// Struct to hold minimizer and its position\n17\ttypedef struct {\n18\t    __uint128_t minimizer_hash;\n19\t    size_t kmer_position;\n20\t    size_t smer_position;\n21\t} MinimizerResult;\n22\t\n23\t// Main function to compute closed syncmers\n24\tvoid compute_closed_syncmers(const char *sequence_input, int len, int K, int S, MinimizerResult *result, int *num_results);\n25\t\n26\t/*** Implementation ***/\n27\t\n28\t// Convert nucleotide base to 2-bit representation\n29\tstatic inline uint8_t base_to_bits(char base) {\n30\t    switch(base) {\n31\t        case 'A': case 'a': return 0;\n32\t        case 'C': case 'c': return 1;\n33\t        case 'G': case 'g': return 2;\n34\t        case 'T': case 't': return 3;\n35\t        default: return 0; // Treat unknown as 'A'\n36\t    }\n37\t}\n38\t\n39\t// Get complement base in 2-bit encoding\n40\tstatic inline uint8_t complement_base(uint8_t base) {\n41\t    return 3 - base; // Complement: A<->T, C<->G\n42\t}\n43\t\n44\t// Dynamically resize array for minimizers\n45\tstatic void add_minimizer(MinimizerResult *results, int *size, __uint128_t minimizer_hash, size_t kmer_position, size_t smer_position) {\n46\t    results[*size].minimizer_hash = minimizer_hash;\n47\t    results[*size].kmer_position = kmer_position;\n48\t    results[*size].smer_position = smer_position;\n49\t    (*size)++;\n50\t}\n51\t\n52\tvoid compute_closed_syncmers(const char *sequence_input, int len, int K, int S, MinimizerResult *results, int *num_results) {\n53\t    *num_results = 0;\n54\t    if(len < K) {\n55\t        fprintf(stderr, \"Sequence length is less than K\\n\");\n56\t        return;\n57\t    }\n58\t\n59\t    size_t num_s_mers = len - S + 1;\n60\t    __uint128_t *s_mer_hashes = (__uint128_t *)malloc(num_s_mers * sizeof(__uint128_t));\n61\t\n62\t    // Precompute all s-mer hashes\n63\t    __uint128_t mask = (((__uint128_t)1) << (2 * S)) - 1;\n64\t    __uint128_t hash_fwd = 0, hash_rev = 0;\n65\t    __uint128_t rc_shift = 2 * (S - 1);\n66\t\n67\t    for(size_t i = 0; i < len; i++) {\n68\t        uint8_t base = base_to_bits(sequence_input[i]);\n69\t        hash_fwd = ((hash_fwd << 2) | base) & mask;\n70\t        uint8_t comp_base = complement_base(base);\n71\t        hash_rev = ((hash_rev >> 2) | ((__uint128_t)comp_base << rc_shift)) & mask;\n72\t        if(i >= S - 1) {\n73\t            size_t s_mer_pos = i - S + 1;\n74\t            __uint128_t canonical_hash = (hash_fwd < hash_rev) ? hash_fwd : hash_rev;\n75\t            s_mer_hashes[s_mer_pos] = canonical_hash;\n76\t        }\n77\t    }\n78\t\n79\t    // Initialize deque\n80\t    size_t window_size = K - S + 1;\n81\t    size_t *deque = (size_t *)malloc(num_s_mers * sizeof(size_t));\n82\t    size_t front = 0, back = 0;\n83\t\n84\t    // Use deque to find minimal s-mers in O(N)\n85\t    for(size_t i = 0; i < num_s_mers; i++) {\n86\t        while(back > front  && s_mer_hashes[deque[back-1]] > s_mer_hashes[i]) {\n87\t            back--;\n88\t        }\n89\t        deque[back++] = i;\n90\t\t if(i >= window_size && deque[front] <= i - window_size) {\n91\t            front++;\n92\t\t}\n93\t\n94\t        // Check for closed syncmer condition\n95\t        if(i >= window_size - 1) {\n96\t            size_t min_pos = deque[front];\n97\t            size_t kmer_pos = i - window_size + 1;\n98\t            if(min_pos == kmer_pos || min_pos == kmer_pos + K - S) {\n99\t            \t//printf(\"%.*s\\n\", K, &sequence_input[i]);\n100\t                add_minimizer(results, num_results, s_mer_hashes[min_pos], kmer_pos, min_pos);\n101\t          