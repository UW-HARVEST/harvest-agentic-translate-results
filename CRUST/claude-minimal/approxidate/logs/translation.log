ystemTime::now().duration_since(std::time::UNIX_EPOCH) {\n            tv.tv_sec = d.as_secs() as i64;\n            tv.tv_usec = d.subsec_micros() as i64;\n        }\n    } else {\n        *tv = *relative_to;\n    }\n\n    if approxidate_str(date, tv) == 0 {\n        return 0;\n    }\n\n    -1\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":35020,"cache_read_input_tokens":9300,"cache_creation":{"ephemeral_5m_input_tokens":35020,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"69cf8aef-a768-4d9f-86d6-2912fb562409","uuid":"ac16c8fa-20c0-4a09-84e6-fa9aa950a438"}
