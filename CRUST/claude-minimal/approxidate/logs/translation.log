 so fall back to: if `relative_to.tv_sec == 0 &&\n    // tv_usec == 0`, use current time, else use the supplied value.\n    if relative_to.tv_sec == 0 && relative_to.tv_usec == 0 {\n        // gettimeofday equivalent\n        if let Ok(d) = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {\n            tv.tv_sec = d.as_secs() as i64;\n            tv.tv_usec = d.subsec_micros() as i64;\n        }\n    } else {\n        *tv = *relative_to;\n    }\n\n    if approxidate_str(date, tv) == 0 {\n        return 0;\n    }\n\n    -1\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":6,"lines":["-pub struct Atm{","+use chrono::{Datelike, Local, NaiveDate, TimeZone, Timelike, Utc};","+","+pub struct Atm {","     pub tm_sec: i32,","     pub tm_min: i32,","     pub tm_hour: i32,"]},{"oldStart":8,"oldLines":147,"newStart":10,"newLines":803,"lines":["     pub tm_wday: i32,","     pub tm_yday: i32,","     pub tm_isdst: i32,","-    pub tm_usec: i64","+    pub tm_usec: i64,"," }","+"," #[derive(Debug, Clone, Copy)]"," pub struct TimeVal {","-    pub tv_sec: i64,   // Equivalent to time_t","-    pub tv_usec: i64,  // Equivalent to suseconds_t","+    pub tv_sec: i64,  // Equivalent to time_t","+    pub tv_usec: i64, // Equivalent to suseconds_t"," }","+"," pub type TimeT = i64;","+","+#[allow(dead_code)]"," const GIT_SPACE: u8 = 0x01;","+#[allow(dead_code)]"," const GIT_DIGIT: u8 = 0x02;","+#[allow(dead_code)]"," const GIT_ALPHA: u8 = 0x04;","+#[allow(dead_code)]"," const GIT_GLOB_SPECIAL: u8 = 0x08;","+#[allow(dead_code)]"," const GIT_REGEX_SPECIAL: u8 = 0x10;","+#[allow(dead_code)]"," const GIT_PATHSPEC_MAGIC: u8 = 0x20;","+#[allow(dead_code)]"," const GIT_CNTRL: u8 = 0x40;","+#[allow(dead_code)]"," const GIT_PUNCT: u8 = 0x80;","+","+// ----- Internal helpers (not part of the documented API) -----","+","+fn empty_tm() -> Atm {","+    Atm {","+        tm_sec: 0,","+        tm_min: 0,","+        tm_hour: 0,","+        tm_mday: 0,","+        tm_