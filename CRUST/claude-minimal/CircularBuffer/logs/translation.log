{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01ARJkY8W6hXhe7knmEfbqWx","type":"tool_result","content":"1\t//\n2\t//  CircularBuffer.c\n3\t//\n4\t//  Created by 罗亮富(Roen zxllf23@163.com) on 14-1-14.\n5\t//  Copyright (c) 2014年 All rights reserved.\n6\t//\n7\t\n8\t\n9\t#include \"circular_buffer.h\"\n10\t#include <string.h>\n11\t\n12\tstruct s_circularBuffer{\n13\t    \n14\t    size_t size; //capacity bytes size\n15\t    size_t dataSize; //occupied data size\n16\t    size_t tailOffset; //head offset, the oldest byte position offset\n17\t    size_t headOffset; //tail offset, the lastest byte position offset\n18\t    void *buffer;\n19\t\n20\t};\n21\t\n22\textern CircularBuffer CircularBufferCreate(size_t size)\n23\t{\n24\t    size_t totalSize = sizeof(struct s_circularBuffer) + size;\n25\t    void *p = malloc(totalSize);\n26\t    CircularBuffer buffer = (CircularBuffer)p;\n27\t    buffer->buffer = p + sizeof(struct s_circularBuffer);\n28\t    buffer->size = size;\n29\t    CircularBufferReset(buffer);\n30\t    return buffer;\n31\t}\n32\t\n33\tvoid CircularBufferFree(CircularBuffer cBuf)\n34\t{\n35\t    CircularBufferReset(cBuf);\n36\t    cBuf->size = 0;\n37\t    cBuf->dataSize = 0;\n38\t    cBuf->buffer = NULL;\n39\t    free(cBuf);\n40\t}\n41\t\n42\tvoid CircularBufferReset(CircularBuffer cBuf)\n43\t{\n44\t    cBuf->headOffset = -1;\n45\t    cBuf->tailOffset = -1;\n46\t    cBuf->dataSize = 0;\n47\t}\n48\t\n49\tsize_t CircularBufferGetCapacity(CircularBuffer cBuf) {\n50\t    \n51\t    return cBuf->size;\n52\t}\n53\t\n54\tsize_t CircularBufferGetSize(CircularBuffer cBuf)\n55\t{\n56\t    return cBuf->size;\n57\t}\n58\t\n59\tsize_t CircularBufferGetDataSize(CircularBuffer cBuf)\n60\t{\n61\t    return cBuf->dataSize;\n62\t}\n63\t\n64\tvoid CircularBufferPush(CircularBuffer cBuf,void *src, size_t length)\n65\t{\n66\t    if(length == 0)\n67\t        return;\n68\t\n69\t    size_t writableLen = length;\n70\t    void *pSrc = src;\n71\t    \n72\t    if(writableLen > cBuf->size)//in case of size overflow\n73\t    {\n74\t        size_t overFlowLen = writableLen - cBuf->size;\n75\t        writableLen = cBuf->size;\n76\t        pSrc = src + overFlowLen;\n77\t    }\n78\t    \n79\t    \n80\t    bool resetHead = false;\n81\t    //in case the circle buffer won't be full after adding the data\n82\t    if(cBuf->tailOffset+writableLen < cBuf->size)\n83\t    {\n84\t        memcpy(&cBuf->buffer[cBuf->tailOffset + 1], pSrc, writableLen);\n85\t        \n86\t        if((cBuf->tailOffset < cBuf->headOffset) && (cBuf->tailOffset+writableLen >= cBuf->headOffset) )\n87\t            resetHead = true;\n88\t        \n89\t        cBuf->tailOffset += writableLen;\n90\t    }\n91\t    else//in case the circle buffer will be overflow after adding the data\n92\t    {\n93\t        size_t remainSize = cBuf->size - cBuf->tailOffset - 1; //the remain size\n94\t        memcpy(&cBuf->buffer[cBuf->tailOffset+1], pSrc, remainSize);\n95\t        \n96\t        size_t coverSize = writableLen - remainSize; //size of data to be covered from the beginning\n97\t        memcpy(cBuf->buffer, pSrc+remainSize, coverSize);\n98\t        \n99\t        if(cBuf->tailOffset < cBuf->headOffset)\n100\t            resetHead = true;\n101\t        else\n102\t        {\n103\t            if(coverSize>cBuf->headOffset)\n104\t                resetHead = true;\n105\t        }\n106\t        \n107\t        cBuf->tailOffset = coverSize - 1;\n108\t    }\n109\t    \n110\t    if(cBuf->headOffset == -1)\n111\t        cBuf->headOffset = 0;\n112\t    \n113\t    if(resetHead)\n114\t    {\n115\t        if(cBuf->tailOffset+1 < cBuf->size)\n116\t            cBuf->headOffset = cBuf->tailOffset + 1;\n117\t        else\n118\t            cBuf->headOffset = 0;\n119\t        \n120\t        cBuf->dataSize = cBuf->size;\n121\t    }\n122\t    else\n123\t    {\n124\t        if(cBuf->tailOffset >= cBuf->headOffset)\n125\t            cBuf->dataSize = cBuf->tailOffset - cBuf->headOffset + 1;\n126\t        else\n127\t            cBuf->dataSize = cBuf->size - (cBuf->headOffset - cBuf->tailOffset - 1);\n128\t    }\n129\t}\n130\t\n131\tsize_t inter_circularBuffer_read(CircularBuffer cBuf, size_t length, void *dataOut, bool resetHead)\n132\t{\n133\t    if(cBuf->dataSize == 0 || length == 0)\n134\t        return 0;\n135\t    \n136\t    size_t rdLen = length;\n137\t    \n138\t    if(cBuf->dataSize < rdLen)\n139\t        rdLen = cBuf->dataSize;\n140\t    \n141\t    \n142\t    if(cBuf->headOffset <= cBuf->tailOffset)\n143\t    {\n144\t        if(dataOut)\n145\t            memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n146\t        \n147\t        if(resetHead)\n148\t        {\n149\t            cBuf->headOffset += rdLen;\n150\t            if(cBuf->headOffset > cBuf->tailOffset)\n151\t            {\n152\t                cBuf->headOffset = -1;\n153\t                cBuf->tailOffset = -1;\n154\t            }\n155\t        }\n156\t    }\n157\t    else\n158\t    {\n159\t        if(cBuf->headOffset+rdLen <= cBuf->size)\n160\t        {\n161\t            if(dataOut)\n162\t                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n163\t            \n164\t            if(resetHead)\n165\t            {\n166\t                cBuf->headOffset += rdLen;\n167\t                if(cBuf->headOffset == cBuf->size)\n168\t                    cBuf->headOffset = 0;\n169\t            }\n170\t        }\n171\t        else\n172\t        {\n173\t            size_t frg1Len = cBuf->size - cBuf->headOffset;\n174\t            if(dataOut)\n175\t                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], frg1Len);\n176\t            \n177\t            size_t frg2len = rdLen - frg1Len;\n178\t            if(dataOut)\n179\t                memcpy(dataOut+frg1Len, cBuf->buffer, frg2len);\n180\t            \n181\t            if(resetHead)\n182\t            {\n183\t                cBuf->headOffset = frg2len;\n184\t                if(cBuf->headOffset > cBuf->tailOffset)\n185\t                {\n186\t                    cBuf->headOffset = -1;\n187\t                    cBuf->tailOffset = -1;\n188\t                }\n189\t            }\n190\t        }\n191\t    }\n192\t    \n193\t    if(resetHead)\n194\t        cBuf->dataSize -= rdLen;\n195\t    \n196\t    return rdLen;\n197\t}\n198\t\n199\t\n200\tsize_t CircularBufferPop(CircularBuffer cBuf, size_t length, void *dataOut)\n201\t{\n202\t    return inter_circularBuffer_read(cBuf,length,dataOut,true);\n203\t}\n204\t\n205\tsize_t CircularBufferRead(CircularBuffer cBuf, size_t length, void *dataOut)\n206\t{\n207\t    return inter_circularBuffer_read(cBuf,length,dataOut,false);\n208\t}\n209\t\n210\t\n211\t//print circular buffer's content into str,\n212\tvoid CircularBufferPrint(CircularBuffer cBuf, bool hex)\n213\t{\n214\t    char *b = cBuf->buffer;\n215\t    size_t cSize = CircularBufferGetSize(cBuf);\n216\t    char *str = malloc(2*cSize+1);\n217\t    \n218\t    char c;\n219\t    \n220\t    for(size_t i=0; i<cSize; i++)\n221\t    {\n222\t        if(CircularBufferGetDataSize(cBuf) == 0)\n223\t        {\n224\t            c = '_';\n225\t        }\n226\t        else if (cBuf->tailOffset < cBuf->headOffset)\n227\t        {\n228\t            if(i>cBuf->tailOffset && i<cBuf->headOffset)\n229\t                c = '_';\n230\t            else\n231\t              c = b[i];\n232\t        }\n233\t        else\n234\t        {\n235\t            if(i>cBuf->tailOffset || i<cBuf->headOffset)\n236\t                c = '_';\n237\t            else\n238\t                c = b[i];\n239\t        }\n240\t        if(hex)\n241\t            sprintf(str+i*2, \"%02X|\",c);\n242\t        else\n243\t            sprintf(str+i*2, \"%c|\",c);\n244\t    }\n245\t    \n246\t    printf(\"CircularBuffer: %s <size %zu dataSize:%zu>\\n\",str,CircularBufferGetSize(cBuf),CircularBufferGetDataSize(cBuf));\n247\t    \n248\t    free(str);\n249\t}\n250\t"}]},"parent_tool_use_id":null,"session_id":"6e47457d-e807-46ec-97ba-397ab6bbd5c6","uuid":"2e68c520-c07c-44dc-a815-37b3839dff68","timestamp":"2026-06-01T19:16:25.790Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-E7rqLP/project/c_src/src/circular_buffer.c","content":"//\n//  CircularBuffer.c\n//\n//  Created by 罗亮富(Roen zxllf23@163.com) on 14-1-14.\n//  Copyright (c) 2014年 All rights reserved.\n//\n\n\n#include \"circular_buffer.h\"\n#include <string.h>\n\nstruct s_circularBuffer{\n    \n    size_t size; //capacity bytes size\n    size_t dataSize; //occupied data size\n    size_t tailOffset; //head offset, the oldest byte position offset\n    size_t headOffset; //tail offset, the lastest byte position offset\n    void *buffer;\n\n};\n\nextern CircularBuffer CircularBufferCreate(size_t size)\n{\n    size_t totalSize = sizeof(struct s_circularBuffer) + size;\n    void *p = malloc(totalSize);\n    CircularBuffer buffer = (CircularBuffer)p;\n    buffer->buffer = p + sizeof(struct s_circularBuffer);\n    buffer->size = size;\n    CircularBufferReset(buffer);\n    return buffer;\n}\n\nvoid CircularBufferFree(CircularBuffer cBuf)\n{\n    CircularBufferReset(cBuf);\n    cBuf->size = 0;\n    cBuf->dataSize = 0;\n    cBuf->buffer = NULL;\n    free(cBuf);\n}\n\nvoid CircularBufferReset(CircularBuffer cBuf)\n{\n    cBuf->headOffset = -1;\n    cBuf->tailOffset = -1;\n    cBuf->dataSize = 0;\n}\n\nsize_t CircularBufferGetCapacity(CircularBuffer cBuf) {\n    \n    return cBuf->size;\n}\n\nsize_t CircularBufferGetSize(CircularBuffer cBuf)\n{\n    return cBuf->size;\n}\n\nsize_t CircularBufferGetDataSize(CircularBuffer cBuf)\n{\n    return cBuf->dataSize;\n}\n\nvoid CircularBufferPush(CircularBuffer cBuf,void *src, size_t length)\n{\n    if(length == 0)\n        return;\n\n    size_t writableLen = length;\n    void *pSrc = src;\n    \n    if(writableLen > cBuf->size)//in case of size overflow\n    {\n        size_t overFlowLen = writableLen - cBuf->size;\n        writableLen = cBuf->size;\n        pSrc = src + overFlowLen;\n    }\n    \n    \n    bool resetHead = false;\n    //in case the circle buffer won't be full after adding the data\n    if(cBuf->tailOffset+writableLen < cBuf->size)\n    {\n        memcpy(&cBuf->buffer[cBuf->tailOffset + 1], pSrc, writableLen);\n        \n        if((cBuf->tailOffset < cBuf->headOffset) && (cBuf->tailOffset+writableLen >= cBuf->headOffset) )\n            resetHead = true;\n        \n        cBuf->tailOffset += writableLen;\n    }\n    else//in case the circle buffer will be overflow after adding the data\n    {\n        size_t remainSize = cBuf->size - cBuf->tailOffset - 1; //the remain size\n        memcpy(&cBuf->buffer[cBuf->tailOffset+1], pSrc, remainSize);\n        \n        size_t coverSize = writableLen - remainSize; //size of data to be covered from the beginning\n        memcpy(cBuf->buffer, pSrc+remainSize, coverSize);\n        \n        if(cBuf->tailOffset < cBuf->headOffset)\n            resetHead = true;\n        else\n        {\n            if(coverSize>cBuf->headOffset)\n                resetHead = true;\n        }\n        \n        cBuf->tailOffset = coverSize - 1;\n    }\n    \n    if(cBuf->headOffset == -1)\n        cBuf->headOffset = 0;\n    \n    if(resetHead)\n    {\n        if(cBuf->tailOffset+1 < cBuf->size)\n            cBuf->headOffset = cBuf->tailOffset + 1;\n        else\n            cBuf->headOffset = 0;\n        \n        cBuf->dataSize = cBuf->size;\n    }\n    else\n    {\n        if(cBuf->tailOffset >= cBuf->headOffset)\n            cBuf->dataSize = cBuf->tailOffset - cBuf->headOffset + 1;\n        else\n            cBuf->dataSize = cBuf->size - (cBuf->headOffset - cBuf->tailOffset - 1);\n    }\n}\n\nsize_t inter_circularBuffer_read(CircularBuffer cBuf, size_t length, void *dataOut, bool resetHead)\n{\n    if(cBuf->dataSize == 0 || length == 0)\n        return 0;\n    \n    size_t rdLen = length;\n    \n    if(cBuf->dataSize < rdLen)\n        rdLen = cBuf->dataSize;\n    \n    \n    if(cBuf->headOffset <= cBuf->tailOffset)\n    {\n        if(dataOut)\n            memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n        \n        if(resetHead)\n        {\n            cBuf->headOffset += rdLen;\n            if(cBuf->headOffset > cBuf->tailOffset)\n            {\n                cBuf->headOffset = -1;\n                cBuf->tailOffset = -1;\n            }\n        }\n    }\n    else\n    {\n        if(cBuf->headOffset+rdLen <= cBuf->size)\n        {\n            if(dataOut)\n                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], rdLen);\n            \n            if(resetHead)\n            {\n                cBuf->headOffset += rdLen;\n                if(cBuf->headOffset == cBuf->size)\n                    cBuf->headOffset = 0;\n            }\n        }\n        else\n        {\n            size_t frg1Len = cBuf->size - cBuf->headOffset;\n            if(dataOut)\n                memcpy(dataOut, &cBuf->buffer[cBuf->headOffset], frg1Len);\n            \n            size_t frg2len = rdLen - frg1Len;\n            if(dataOut)\n                memcpy(dataOut+frg1Len, cBuf->buffer, frg2len);\n            \n            if(resetHead)\n            {\n                cBuf->headOffset = frg2len;\n                if(cBuf->headOffset > cBuf->tailOffset)\n                {\n                    cBuf->headOffset = -1;\n                    cBuf->tailOffset = -1;\n                }\n            }\n        }\n    }\n    \n    if(resetHead)\n        cBuf->dataSize -= rdLen;\n    \n    return rdLen;\n}\n\n\nsize_t CircularBufferPop(CircularBuffer cBuf, size_t length, void *dataOut)\n{\n    return inter_circularBuffer_read(cBuf,length,dataOut,true);\n}\n\nsize_t CircularBufferRead(CircularBuffer cBuf, size_t length, void *dataOut)\n{\n    return inter_circularBuffer_read(cBuf,length,dataOut,false);\n}\n\n\n//print circular buffer's content into str,\nvoid CircularBufferPrint(CircularBuffer cBuf, bool hex)\n{\n    char *b = cBuf->buffer;\n    size_t cSize = CircularBufferGetSize(cBuf);\n    char *str = malloc(2*cSize+1);\n    \n    char c;\n    \n    for(size_t i=0; i<cSize; i++)\n    {\n        if(CircularBufferGetDataSize(cBuf) == 0)\n        {\n            c = '_';\n        }\n        else if (cBuf->tailOffset < cBuf->headOffset)\n        {\n            if(i>cBuf->tailOffset && i<cBuf->headOffset)\n                c = '_';\n            else\n              c = b[i];\n        }\n        else\n        {\n            if(i>cBuf->tailOffset || i<cBuf->headOffset)\n                c = '_';\n            else\n                c = b[i];\n        }\n        if(hex)\n            sprintf(str+i*2, \"%02X|\",c);\n        else\n            sprintf(str+i*2, \"%c|\",c);\n    }\n    \n    printf(\"CircularBuffer: %s <size %zu dataSize:%zu>\\n\",str,CircularBufferGetSize(cBuf),CircularBufferGetDataSize(cBuf));\n    \n    free(str);\n}\n","numLines":250,"startLine":1,"totalLines":250}}}
