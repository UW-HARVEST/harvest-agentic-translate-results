{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_017GCLYBpfrLdUiRmXnu6Tyc","type":"tool_result","content":"1\tuse fslib::symt::SymTable;\n2\t#[test]\n3\tfn test_create() {\n4\t    let st: SymTable = SymTable::new();\n5\t    assert!(st.sym.len() == 0);\n6\t    for i in 0..st.n_max{\n7\t        assert!(st.get(i as i32) == None);\n8\t    }\n9\t}\n10\t#[test]\n11\tfn test_add(){\n12\t    let mut st: SymTable = SymTable::new();\n13\t    st.add(1, \"Mary\");\n14\t    st.add(2, \"had\");\n15\t    st.add(3, \"a\");\n16\t    st.add(4, \"little\");\n17\t    st.add(5, \"lamb\");\n18\t    st.print();\n19\t    assert!(st.get(1) == Some(\"Mary\"));\n20\t    assert!(st.get(2) == Some(\"had\"));\n21\t    assert!(st.get(3) == Some(\"a\"));\n22\t    assert!(st.get(4) == Some(\"little\"));\n23\t    assert!(st.get(5) == Some(\"lamb\"));\n24\t    assert!(st.n_items == 5);\n25\t    assert!(st.n_max >= 5);\n26\t    st.remove();\n27\t}\n28\t#[test]\n29\tfn test_add_sparse(){\n30\t    let mut token: &str = \"token\";\n31\t    let mut st: SymTable = SymTable::new();\n32\t    st.add(100, token);\n33\t    assert!(st.sym.get(0) == None);\n34\t    assert!(st.get(100) == Some(\"token\"));\n35\t}\n36\t#[test]\n37\tfn test_reverse(){\n38\t    let mut st: SymTable = SymTable::new();\n39\t    let k0 = \"000\";\n40\t    let k1 = \"111\";\n41\t    st.add(0, k0);\n42\t    st.add(1, k1);\n43\t    st.print();\n44\t    let rev: &std::collections::HashMap<String, usize> = st.reverse();\n45\t    assert!(rev.get(k0) != None);\n46\t    assert!(rev.get(k1) != None);\n47\t    assert!(rev.get(k0) == Some(&0));\n48\t    assert!(rev.get(k1) == Some(&1));\n49\t    st.remove();\n50\t}\n51\t#[test]\n52\tfn test_getr(){\n53\t    let mut st: SymTable = SymTable::new();\n54\t    let k0 = \"000\";\n55\t    let k1 = \"111\";\n56\t    let k2 = \"222\";\n57\t    st.add(0, k0);\n58\t    st.add(1, k1);\n59\t    st.print();\n60\t    st.reverse();\n61\t    assert!(st.getr(k0).unwrap() == 0);\n62\t    assert!(st.getr(k1).unwrap() == 1);\n63\t    assert!(st.getr(k2).unwrap() == -1);\n64\t    st.remove();\n65\t}\n66\t// #[test]\n67\t// fn test_read(){\n68\t//     let mut st: SymTable = SymTable::new();\n69\t//     st.read(\"tests/test_symt.txt\");\n70\t//     assert!(st.n_items == 2);\n71\t//     asssert!(st.get(1)==Some(\"one\"));\n72\t//     assert!(st.get(2)==Some(\"two\"));\n73\t//     st.remove();\n74\t// }\n75\tfn main(){}"}]},"parent_tool_use_id":null,"session_id":"11a01b4b-dce8-4957-895b-5ddab04eb2bb","uuid":"057fdefb-4c6d-4a22-88a4-7c6d17b43b4c","timestamp":"2026-06-01T21:14:39.755Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-AMa87y/project/src/bin/test_symt.rs","content":"use fslib::symt::SymTable;\n#[test]\nfn test_create() {\n    let st: SymTable = SymTable::new();\n    assert!(st.sym.len() == 0);\n    for i in 0..st.n_max{\n        assert!(st.get(i as i32) == None);\n    }\n}\n#[test]\nfn test_add(){\n    let mut st: SymTable = SymTable::new();\n    st.add(1, \"Mary\");\n    st.add(2, \"had\");\n    st.add(3, \"a\");\n    st.add(4, \"little\");\n    st.add(5, \"lamb\");\n    st.print();\n    assert!(st.get(1) == Some(\"Mary\"));\n    assert!(st.get(2) == Some(\"had\"));\n    assert!(st.get(3) == Some(\"a\"));\n    assert!(st.get(4) == Some(\"little\"));\n    assert!(st.get(5) == Some(\"lamb\"));\n    assert!(st.n_items == 5);\n    assert!(st.n_max >= 5);\n    st.remove();\n}\n#[test]\nfn test_add_sparse(){\n    let mut token: &str = \"token\";\n    let mut st: SymTable = SymTable::new();\n    st.add(100, token);\n    assert!(st.sym.get(0) == None);\n    assert!(st.get(100) == Some(\"token\"));\n}\n#[test]\nfn test_reverse(){\n    let mut st: SymTable = SymTable::new();\n    let k0 = \"000\";\n    let k1 = \"111\";\n    st.add(0, k0);\n    st.add(1, k1);\n    st.print();\n    let rev: &std::collections::HashMap<String, usize> = st.reverse();\n    assert!(rev.get(k0) != None);\n    assert!(rev.get(k1) != None);\n    assert!(rev.get(k0) == Some(&0));\n    assert!(rev.get(k1) == Some(&1));\n    st.remove();\n}\n#[test]\nfn test_getr(){\n    let mut st: SymTable = SymTable::new();\n    let k0 = \"000\";\n    let k1 = \"111\";\n    let k2 = \"222\";\n    st.add(0, k0);\n    st.add(1, k1);\n    st.print();\n    st.reverse();\n    assert!(st.getr(k0).unwrap() == 0);\n    assert!(st.getr(k1).unwrap() == 1);\n    assert!(st.getr(k2).unwrap() == -1);\n    st.remove();\n}\n// #[test]\n// fn test_read(){\n//     let mut st: SymTable = SymTable::new();\n//     st.read(\"tests/test_symt.txt\");\n//     assert!(st.n_items == 2);\n//     asssert!(st.get(1)==Some(\"one\"));\n//     assert!(st.get(2)==Some(\"two\"));\n//     st.remove();\n// }\nfn main(){}","numLines":75,"startLine":1,"totalLines":75}}}
