{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01SrvaCqcd7moE5K1JmV5RsT","type":"tool_result","content":"1\tuse fslib::heap::Heap;\n2\tuse std::cmp::Ordering;\n3\tfn cmp_lower(a: &i32, b: &i32) -> Ordering {\n4\t    a.cmp(b)\n5\t}\n6\t#[test]\n7\tfn test_heap_create() {\n8\t    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n9\t    assert_eq!(h.n_items, 0);\n10\t    assert_eq!(h.n_max, 10);\n11\t    h.remove();\n12\t}\n13\t#[test]\n14\tfn test_heap_pop() {\n15\t    let a = [1, 0, 4, 3, 2];\n16\t    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n17\t    for &val in &a {\n18\t        h.insert(val);\n19\t    }\n20\t    assert_eq!(h.pop(), Some(0));\n21\t    assert_eq!(h.pop(), Some(1));\n22\t    assert_eq!(h.pop(), Some(2));\n23\t    assert_eq!(h.pop(), Some(3));\n24\t    assert_eq!(h.pop(), Some(4));\n25\t    assert_eq!(h.pop(), None);\n26\t    h.remove();\n27\t}\n28\t#[test]\n29\tfn test_heap_equal() {\n30\t    let a = [1, 1, 1, 0, 0];\n31\t    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n32\t    for &val in &a {\n33\t        h.insert(val);\n34\t    }\n35\t    assert_eq!(h.pop(), Some(0));\n36\t    assert_eq!(h.pop(), Some(0));\n37\t    assert_eq!(h.pop(), Some(1));\n38\t    assert_eq!(h.pop(), Some(1));\n39\t    assert_eq!(h.pop(), Some(1));\n40\t    assert_eq!(h.pop(), None);\n41\t    h.remove();\n42\t}\n43\t#[test]\n44\tfn test_heap_update() {\n45\t    let mut a = [3, 2, 1];\n46\t    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n47\t    h.insert(a[0]);\n48\t    h.insert(a[1]);\n49\t    h.update(a[2], 1);\n50\t    assert_eq!(h.pop(), Some(1));\n51\t    assert_eq!(h.pop(), Some(2));\n52\t    h.remove();\n53\t}\n54\t#[test]\n55\tfn test_heap_find() {\n56\t    let a = [3, 2, 1];\n57\t    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n58\t    h.insert(a[0]);\n59\t    h.insert(a[1]);\n60\t    h.insert(a[2]);\n61\t    assert_eq!(h.find(&1), Some(0));\n62\t    h.remove();\n63\t}\n64\t#[test]\n65\tfn test_heap_resize() {\n66\t    let a = [0, 1, 3];\n67\t    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 1, 0);\n68\t    h.insert(a[0]);\n69\t    assert_eq!(h.n_items, 1);\n70\t    assert_eq!(h.n_max, 1);\n71\t    h.insert(a[1]);\n72\t    assert_eq!(h.n_items, 2);\n73\t    assert_eq!(h.n_max, 2);\n74\t    h.insert(a[2]);\n75\t    assert_eq!(h.n_items, 3);\n76\t    assert_eq!(h.n_max, 4);\n77\t    h.remove();\n78\t}\n79\t#[test]\n80\tfn test_heap_limit() {\n81\t    let a = [1, 0, 4, 3, 2];\n82\t    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 0, 3);\n83\t    for &val in &a {\n84\t        h.insert(val);\n85\t    }\n86\t    assert_eq!(h.pop(), Some(0));\n87\t    assert_eq!(h.pop(), Some(1));\n88\t    assert_eq!(h.pop(), Some(2));\n89\t    assert_eq!(h.pop(), None);\n90\t    h.remove();\n91\t}\n92\tfn main() {\n93\t}"}]},"parent_tool_use_id":null,"session_id":"11a01b4b-dce8-4957-895b-5ddab04eb2bb","uuid":"b166582f-ae40-4d34-bfcd-35c224db06af","timestamp":"2026-06-01T21:12:20.677Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-AMa87y/project/src/bin/test_heap.rs","content":"use fslib::heap::Heap;\nuse std::cmp::Ordering;\nfn cmp_lower(a: &i32, b: &i32) -> Ordering {\n    a.cmp(b)\n}\n#[test]\nfn test_heap_create() {\n    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n    assert_eq!(h.n_items, 0);\n    assert_eq!(h.n_max, 10);\n    h.remove();\n}\n#[test]\nfn test_heap_pop() {\n    let a = [1, 0, 4, 3, 2];\n    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n    for &val in &a {\n        h.insert(val);\n    }\n    assert_eq!(h.pop(), Some(0));\n    assert_eq!(h.pop(), Some(1));\n    assert_eq!(h.pop(), Some(2));\n    assert_eq!(h.pop(), Some(3));\n    assert_eq!(h.pop(), Some(4));\n    assert_eq!(h.pop(), None);\n    h.remove();\n}\n#[test]\nfn test_heap_equal() {\n    let a = [1, 1, 1, 0, 0];\n    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n    for &val in &a {\n        h.insert(val);\n    }\n    assert_eq!(h.pop(), Some(0));\n    assert_eq!(h.pop(), Some(0));\n    assert_eq!(h.pop(), Some(1));\n    assert_eq!(h.pop(), Some(1));\n    assert_eq!(h.pop(), Some(1));\n    assert_eq!(h.pop(), None);\n    h.remove();\n}\n#[test]\nfn test_heap_update() {\n    let mut a = [3, 2, 1];\n    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n    h.insert(a[0]);\n    h.insert(a[1]);\n    h.update(a[2], 1);\n    assert_eq!(h.pop(), Some(1));\n    assert_eq!(h.pop(), Some(2));\n    h.remove();\n}\n#[test]\nfn test_heap_find() {\n    let a = [3, 2, 1];\n    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 10, 0);\n    h.insert(a[0]);\n    h.insert(a[1]);\n    h.insert(a[2]);\n    assert_eq!(h.find(&1), Some(0));\n    h.remove();\n}\n#[test]\nfn test_heap_resize() {\n    let a = [0, 1, 3];\n    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 1, 0);\n    h.insert(a[0]);\n    assert_eq!(h.n_items, 1);\n    assert_eq!(h.n_max, 1);\n    h.insert(a[1]);\n    assert_eq!(h.n_items, 2);\n    assert_eq!(h.n_max, 2);\n    h.insert(a[2]);\n    assert_eq!(h.n_items, 3);\n    assert_eq!(h.n_max, 4);\n    h.remove();\n}\n#[test]\nfn test_heap_limit() {\n    let a = [1, 0, 4, 3, 2];\n    let mut h = Heap::new(cmp_lower, std::mem::size_of::<i32>(), 0, 3);\n    for &val in &a {\n        h.insert(val);\n    }\n    assert_eq!(h.pop(), Some(0));\n    assert_eq!(h.pop(), Some(1));\n    assert_eq!(h.pop(), Some(2));\n    assert_eq!(h.pop(), None);\n    h.remove();\n}\nfn main() {\n}","numLines":93,"startLine":1,"totalLines":93}}}
