{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Bn4hiL64MMe1tJDwx4Nsgr","type":"tool_result","content":"1\tuse libpgn::annotation::PgnAnnotation;\n2\tuse libpgn::check::PgnCheck;\n3\tuse libpgn::comments::PgnCommentPosition;\n4\tuse libpgn::coordinate::{PgnCoordinate, UNKNOWN};\n5\tuse libpgn::moves::{PgnMove, PgnMoves, PGN_CASTLING_KINGSIDE, PGN_CASTLING_QUEENSIDE};\n6\tuse libpgn::piece::PgnPiece;\n7\t\n8\t#[test]\n9\tfn test_parsing_single_move() {\n10\t    let mut mv: PgnMove;\n11\t\n12\t    mv = PgnMove::from(\"e4??\");\n13\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n14\t    assert_eq!(mv.captures, false);\n15\t    assert_eq!(mv.from.file, None);\n16\t    assert_eq!(mv.from.rank, None);\n17\t    assert_eq!(mv.dest.file, Some('e'));\n18\t    assert_eq!(mv.dest.rank, Some(4));\n19\t    assert_eq!(mv.check, PgnCheck::None);\n20\t    assert_eq!(mv.notation, \"e4??\");\n21\t    assert_eq!(mv.annotation, PgnAnnotation::Blunder);\n22\t\n23\t    mv = PgnMove::from(\"Nb6d5+\");\n24\t    assert_eq!(mv.piece, PgnPiece::Knight);\n25\t    assert_eq!(mv.captures, false);\n26\t    assert_eq!(mv.from.file, Some('b'));\n27\t    assert_eq!(mv.from.rank, Some(6));\n28\t    assert_eq!(mv.dest.file, Some('d'));\n29\t    assert_eq!(mv.dest.rank, Some(5));\n30\t    assert_eq!(mv.check, PgnCheck::Single);\n31\t    assert_eq!(mv.notation, \"Nb6d5+\");\n32\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n33\t\n34\t    mv = PgnMove::from(\"Qf1?!\");\n35\t    assert_eq!(mv.piece, PgnPiece::Queen);\n36\t    assert_eq!(mv.captures, false);\n37\t    assert_eq!(mv.from.file, None);\n38\t    assert_eq!(mv.from.rank, None);\n39\t    assert_eq!(mv.dest.file, Some('f'));\n40\t    assert_eq!(mv.dest.rank, Some(1));\n41\t    assert_eq!(mv.check, PgnCheck::None);\n42\t    assert_eq!(mv.notation, \"Qf1?!\");\n43\t    assert_eq!(mv.annotation, PgnAnnotation::DubiousMove);\n44\t\n45\t    mv = PgnMove::from(\"bxa8=Q??\");\n46\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n47\t    assert_eq!(mv.captures, true);\n48\t    assert_eq!(mv.from.file, Some('b'));\n49\t    assert_eq!(mv.from.rank, None);\n50\t    assert_eq!(mv.dest.file, Some('a'));\n51\t    assert_eq!(mv.dest.rank, Some(8));\n52\t    assert_eq!(mv.check, PgnCheck::None);\n53\t    assert_eq!(mv.promoted_to, PgnPiece::Queen);\n54\t    assert_eq!(mv.notation, \"bxa8=Q??\");\n55\t    assert_eq!(mv.annotation, PgnAnnotation::Blunder);\n56\t\n57\t    mv = PgnMove::from(\"Bxg2\");\n58\t    assert_eq!(mv.piece, PgnPiece::Bishop);\n59\t    assert_eq!(mv.captures, true);\n60\t    assert_eq!(mv.from.file, None);\n61\t    assert_eq!(mv.from.rank, None);\n62\t    assert_eq!(mv.dest.file, Some('g'));\n63\t    assert_eq!(mv.dest.rank, Some(2));\n64\t    assert_eq!(mv.check, PgnCheck::None);\n65\t    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n66\t    assert_eq!(mv.notation, \"Bxg2\");\n67\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n68\t\n69\t    mv = PgnMove::from(\"exf2+!\");\n70\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n71\t    assert_eq!(mv.captures, true);\n72\t    assert_eq!(mv.from.file, Some('e'));\n73\t    assert_eq!(mv.from.rank, None);\n74\t    assert_eq!(mv.dest.file, Some('f'));\n75\t    assert_eq!(mv.dest.rank, Some(2));\n76\t    assert_eq!(mv.check, PgnCheck::Single);\n77\t    assert_eq!(mv.promoted_to, PgnPiece::Unknown);\n78\t    assert_eq!(mv.notation, \"exf2+!\");\n79\t    assert_eq!(mv.annotation, PgnAnnotation::GoodMove);\n80\t\n81\t    mv = PgnMove::from(\"O-O+!!\");\n82\t    assert_eq!(mv.castles, PGN_CASTLING_KINGSIDE);\n83\t    assert_eq!(mv.check, PgnCheck::Single);\n84\t    assert_eq!(mv.notation, \"O-O+!!\");\n85\t    assert_eq!(mv.annotation, PgnAnnotation::BrilliantMove);\n86\t\n87\t    mv = PgnMove::from(\"O-O-O\");\n88\t    assert_eq!(mv.castles, PGN_CASTLING_QUEENSIDE);\n89\t    assert_eq!(mv.check, PgnCheck::None);\n90\t    assert_eq!(mv.notation, \"O-O-O\");\n91\t    assert_eq!(mv.annotation, PgnAnnotation::Unknown);\n92\t}\n93\t\n