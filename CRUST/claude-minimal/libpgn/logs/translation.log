{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01X7bdJh6dScdUHqbfjiu63P","type":"tool_result","content":"1\t/* libpgn - PGN file parser.\n2\t * Copyright (C) 2024 youkwhd <lolywk@tutanota.com>\n3\t *\n4\t * This program is free software; you can redistribute it and/or modify\n5\t * it under the terms of the GNU General Public License as published by\n6\t * the Free Software Foundation; either version 2 of the License, or\n7\t * (at your option) any later version.\n8\t *\n9\t * This program is distributed in the hope that it will be useful,\n10\t * but WITHOUT ANY WARRANTY; without even the implied warranty of\n11\t * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n12\t * GNU General Public License for more details.\n13\t *\n14\t * You should have received a copy of the GNU General Public License along\n15\t * with this program; if not, write to the Free Software Foundation, Inc.,\n16\t * 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.\n17\t */\n18\t\n19\t#include <ctype.h>\n20\t#include <assert.h>\n21\t#include <stdio.h>\n22\t#include <string.h>\n23\t#include <stdlib.h>\n24\t\n25\t#include \"moves.h\"\n26\t#include \"annotation.h\"\n27\t#include \"check.h\"\n28\t#include \"comments.h\"\n29\t#include \"piece.h\"\n30\t#include \"score.h\"\n31\t\n32\t#include \"utils/cursor.h\"\n33\t\n34\t#define PGN_EXPECT_WHITE 0\n35\t#define PGN_EXPECT_BLACK 1\n36\t\n37\tpgn_move_t __pgn_move_from_string(char *str, size_t *consumed)\n38\t{\n39\t    pgn_move_t move = {0};\n40\t    size_t cursor = 0;\n41\t    \n42\t    if (str[cursor] == 'O') {\n43\t        assert(str[++cursor] == '-');\n44\t        assert(str[++cursor] == 'O');\n45\t        move.castles = PGN_CASTLING_KINGSIDE;\n46\t        cursor++;\n47\t\n48\t        if (str[cursor] == '-') {\n49\t            assert(str[++cursor] == 'O');\n50\t            move.castles = PGN_CASTLING_QUEENSIDE;\n51\t            cursor++;\n52\t        }\n53\t\n54\t        goto check;\n55\t    }\n56\t\n57\t    move.piece = pgn_piece_from_char(str[cursor++]);\n58\t    if (move.piece == PGN_PIECE_UNKNOWN) {\n59\t        move.piece = PGN_PIECE_PAWN;\n60\t        cursor--;\n61\t    }\n62\t\n63\t    /* NOTE: can be refactored using a stack\n64\t     */\n65\t    if (islower(str[cursor]) && str[cursor] != 'x') move.from.file = str[cursor++];\n66\t    if (isdigit(str[cursor])) move.from.rank = str[cursor++] - '0';\n67\t\n68\t    move.captures = str[cursor] == 'x' || str[cursor] == ':';\n69\t    cursor += move.captures;\n70\t\n71\t    if (islower(str[cursor])) {\n72\t        assert(islower(str[cursor]));\n73\t        move.dest.file = str[cursor++];\n74\t        assert(isdigit(str[cursor]));\n75\t        move.dest.rank = str[cursor++] - '0';\n76\t    } else {\n77\t        move.dest = move.from;\n78\t        move.from = (pgn_coordinate_t){0};\n79\t    }\n80\t\n81\t    move.promoted_to = pgn_piece_from_char(str[cursor]);\n82\t    if (move.promoted_to == PGN_PIECE_UNKNOWN) {\n83\t        switch (str[cursor]) {\n84\t        case '(':\n85\t            move.promoted_to = pgn_piece_from_char(str[++cursor]);\n86\t            assert(move.promoted_to != PGN_PIECE_UNKNOWN);\n87\t            assert(str[++cursor] == ')');\n88\t            cursor++;\n89\t            break;\n90\t        case '=':\n91\t        case '/':\n92\t            move.promoted_to = pgn_piece_from_char(str[++cursor]);\n93\t            assert(move.promoted_to != PGN_PIECE_UNKNOWN);\n94\t            cursor++;\n95\t            break;\n96\t        }\n97\t    }\n98\t\n99\t    assert(move.dest.file != 0);\n100\t    assert(move.dest.rank != 0);\n101\t\n102\tcheck:\n103\t    move.check = __pgn_check_from_string(str + cursor, &cursor);\n104\t    move.annotation = __pgn_annotation_from_string(str + cursor, &cursor);\n105\t\n106\t    bool skipped_whitespace_before_ep = pgn_cursor_skip_whitespace(str, &cursor);\n107\t\n108\t    /* could be en passant */\n109\t    if (str[cursor] == 'e' && str[cursor + 1] == '.') {\n110\t        /* TODO: error no spaces in between\n111\t         */\n112\t        assert(skipped_whitespace_before_ep);\n113\t\n114\t        assert(str[cursor] == 'e');\n115\t        assert(str[++cursor] == '.');\n116\t        assert(str[++cursor] == 'p');\n117\t        assert(str[++cursor] == '.');\n118\t        cursor++;\n119\t        move.en_passant = true;\n120\t    }\n121\t\n122\t    bool skipped_whitespace_after_ep = move.en_passant ? pgn_cursor_skip_whitespace(str, &cursor) : skipped_whitespace_before_ep;\n123\t\n124\t    /* Check for NAG annotation.\n125\t     */\n126\t    if (move.annotation == PGN_ANNOTATION_UNKNOWN) {\n127\t        move.annotation = __pgn_annotation_nag_from_string(str + cursor, &cursor);\n128\t\n129\t        /* TODO: error no spaces in between\n130\t         */\n131\t        if (move.annotation != PGN_ANNOTATION_UNKNOWN) {\n132\t            assert(skipped_whitespace_after_ep);\n133\t        }\n134\t    }\n135\t\n136\t    pgn_cursor_revisit_whitespace(str, &cursor);\n137\t\n138\t    size_t notation_len = cursor;\n139\t    strncpy(move.notation, str, notation_len);\n140\t\n141\t    *consumed += cursor;\n142\t    return move;\n143\t}\n144\t\n145\tpgn_move_t pgn_move_from_string(char *str)\n146\t{\n147\t    size_t consumed = 0;\n148\t    return __pgn_move_from_string(str, &consumed);\n149\t}\n150\t\n151\tsize_t pgn_move_to_string(pgn_move_t *move, char *dest)\n152\t{\n153\t    size_t cursor = 0;\n154\t\n155\t    switch (move->castles) {\n156\t    case PGN_CASTLING_NONE: break;\n157\t    case PGN_CASTLING_KINGSIDE:\n158\t        strcpy(dest, \"O-O\");\n159\t        cursor += PGN_CASTLING_KINGSIDE * 2 - 1;\n160\t        goto check;\n161\t    case PGN_CASTLING_QUEENSIDE:\n162\t        strcpy(dest, \"O-O-O\");\n163\t        cursor += PGN_CASTLING_QUEENSIDE * 2 - 1;\n164\t        goto check;\n165\t    }\n166\t\n167\t    assert(move->piece != PGN_PIECE_UNKNOWN);\n168\t    if (move->piece != PGN_PIECE_PAWN) {\n169\t        dest[cursor++] = move->piece;\n170\t    }\n171\t\n172\t    if (move->from.file) dest[cursor++] = move->from.file;\n173\t    if (move->from.rank) dest[cursor++] = '0' + move->from.rank;\n174\t\n175\t    if (move->captures) dest[cursor++] = 'x';\n176\t\n177\t    dest[cursor++] = move->dest.file;\n178\t    dest[cursor++] = '0' + move->dest.rank;\n179\t\n180\t    if (move->promoted_to) {\n181\t        assert(move->piece == PGN_PIECE_PAWN);\n182\t        assert(move->promoted_to != PGN_PIECE_PAWN);\n183\t        dest[cursor++] = '=';\n184\t        dest[cursor++] = move->promoted_to;\n185\t    }\n186\t\n187\tcheck:\n188\t    switch (move->check) {\n189\t        case PGN_CHECK_NONE:\n190\t            break;\n191\t        case PGN_CHECK_MATE:\n192\t            dest[cursor++] = '#';\n193\t            break;\n194\t        case PGN_CHECK_SINGLE:\n195\t            dest[cursor++] = '+';\n196\t            break;\n197\t        case PGN_CHECK_DOUBLE:\n198\t            dest[cursor++] = '+';\n199\t            dest[cursor++] = '+';\n200\t            break;\n201\t    }\n202\t\n203\t    if (move->annotation >= PGN_ANNOTATION_GOOD_MOVE && move->annotation <= PGN_ANNOTATION_DUBIOUS_MOVE) {\n204\t        cursor += pgn_annotation_to_string(move->annotation, dest + cursor);\n205\t    }\n206\t\n207\t    if (move->en_passant) {\n208\t        dest[cursor++] = ' ';\n209\t        strcpy(dest + cursor, \"e.p.\");\n210\t        cursor += 4;\n211\t    }\n212\t\n213\t    if (move->annotation > PGN_ANNOTATION_DUBIOUS_MOVE || move->annotation == PGN_ANNOTATION_NULL) {\n214\t        dest[cursor++] = ' ';\n215\t        cursor += pgn_annotation_to_string(move->annotation, dest + cursor);\n216\t    }\n217\t\n218\t    dest[cursor] = '\\0';\n219\t    return cursor;\n220\t}\n221\t\n222\tpgn_moves_t *__pgn_moves_from_string_recurse(char *str, size_t *consumed, pgn_moves_t *moves, int expect)\n223\t{\n224\t    if (str[0] == ')' || str[0] == '\\0')\n225\t        return moves;\n226\t\n227\t    size_t cursor = 0;\n228\t    __pgn_moves_item_t move = {0};\n229\t\n230\t    /* comments placeholder to wait for knowing which move the comment belongs to.\n231\t     */\n232\t    pgn_comments_t *comments = NULL;\n233\t\n234\t    pgn_cursor_skip_whitespace(str, &cursor);\n235\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BEFORE_MOVE, str + cursor);\n236\t\n237\t    assert(isdigit(str[cursor]));\n238\t    while (isdigit(str[cursor])) cursor++;\n239\t\n240\t    int dots_count = 0;\n241\t    assert(str[cursor] == '.');\n242\t    while (str[cursor] == '.') {\n243\t        cursor++;\n244\t        dots_count++;\n245\t    }\n246\t\n247\t    if (expect == PGN_EXPECT_WHITE) assert(dots_count == 1);\n248\t    if (expect == PGN_EXPECT_BLACK) assert(dots_count == 3);\n249\t\n250\t    pgn_cursor_skip_whitespace(str, &cursor);\n251\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BETWEEN_MOVE, str + cursor);\n252\t\n253\t    if (dots_count == 3) {\n254\t        move.black = __pgn_move_from_string(str + cursor, &cursor);\n255\t\n256\t        pgn_cursor_skip_whitespace(str, &cursor);\n257\t        cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n258\t        cursor += pgn_alternative_moves_poll(&move.black.alternatives, &comments, str + cursor, PGN_EXPECT_BLACK);\n259\t        pgn_cursor_skip_whitespace(str, &cursor);\n260\t        cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n261\t\n262\t        if (comments) {\n263\t            move.black.comments = comments;\n264\t            comments = NULL;\n265\t        }\n266\t\n267\t        pgn_moves_push(moves, move);\n268\t        __pgn_moves_from_string_recurse(str + cursor, &cursor, moves, PGN_EXPECT_WHITE);\n269\t        *consumed += cursor;\n270\t        return moves;\n271\t    }\n272\t\n273\t    move.white = __pgn_move_from_string(str + cursor, &cursor);\n274\t    pgn_cursor_skip_whitespace(str, &cursor);\n275\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n276\t    cursor += pgn_alternative_moves_poll(&move.white.alternatives, &comments, str + cursor, PGN_EXPECT_WHITE);\n277\t    pgn_cursor_skip_whitespace(str, &cursor);\n278\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n279\t\n280\t    if (comments) {\n281\t        move.white.comments = comments;\n282\t        comments = NULL;\n283\t    }\n284\t\n285\t    if (pgn_score_from_string(str + cursor)) {\n286\t        pgn_moves_push(moves, move);\n287\t        *consumed += cursor;\n288\t        return moves;\n289\t    }\n290\t\n291\t    /* We're at the end of pgn, no black move present.\n292\t     *\n293\t     * TODO: investigate (might be a corrupt file?)\n294\t     */\n295\t    if (str[cursor] == ')' || str[cursor] == '\\0') {\n296\t        pgn_moves_push(moves, move);\n297\t        *consumed += cursor;\n298\t        return moves;\n299\t    }\n300\t\n301\t    pgn_cursor_skip_whitespace(str, &cursor);\n302\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BEFORE_MOVE, str + cursor);\n303\t\n304\t    if (isdigit(str[cursor])) {\n305\t        while (isdigit(str[cursor])) cursor++;\n306\t\n307\t        for (int i = 0; i < 3; i++)\n308\t            assert(str[cursor++] == '.');\n309\t    }\n310\t\n311\t    pgn_cursor_skip_whitespace(str, &cursor);\n312\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_BETWEEN_MOVE, str + cursor);\n313\t\n314\t    move.black = __pgn_move_from_string(str + cursor, &cursor);\n315\t    pgn_cursor_skip_whitespace(str, &cursor);\n316\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n317\t    cursor += pgn_alternative_moves_poll(&move.black.alternatives, &comments, str + cursor, PGN_EXPECT_BLACK);\n318\t    pgn_cursor_skip_whitespace(str, &cursor);\n319\t    cursor += pgn_comments_poll(&comments, PGN_COMMENT_POSITION_AFTER_MOVE, str + cursor);\n320\t\n321\t    if (comments) {\n322\t        move.black.comments = comments;\n323\t        comments = NULL;\n324\t    }\n325\t\n326\t    pgn_moves_push(moves, move);\n327\t\n328\t    if (pgn_score_from_string(str + cursor)) {\n329\t        *consumed += cursor;\n330\t        return moves;\n331\t    }\n332\t\n333\t    __pgn_moves_from_string_recurse(str + cursor, &cursor, moves, PGN_EXPECT_WHITE);\n334\t    *consumed += cursor;\n335\t    return moves;\n336\t}\n337\t\n338\tpgn_moves_t *__pgn_moves_from_string(char *str, size_t *consumed)\n339\t{\n340\t    return __pgn_moves_from_string_recurse(str, consumed, pgn_moves_init(), PGN_EXPECT_WHITE);\n341\t}\n342\t\n343\tpgn_moves_t *pgn_moves_from_string(char *str)\n344\t{\n345\t    size_t consumed = 0;\n346\t    return __pgn_moves_from_string(str, &consumed);\n347\t}\n348\t\n349\tpgn_alternative_moves_t *pgn_alternative_moves_init(void)\n350\t{\n351\t    pgn_alternative_moves_t *alt = malloc(sizeof *alt);\n352\t    alt->values = malloc(sizeof *alt->values * PGN_ALTERNATIVE_MOVES_INITIAL_SIZE);\n353\t    alt->size = PGN_ALTERNATIVE_MOVES_INITIAL_SIZE;\n354\t    alt->length = 0;\n355\t    return alt;\n356\t}\n357\t\n358\tsize_t pgn_alternative_moves_poll(pgn_alternative_moves_t **alt, pgn_comments_t **placeholder, char *str, int expect)\n359\t{\n360\t    size_t cursor = 0;\n361\t\n362\t    while (str[cursor] == '(') {\n363\t        cursor++;\n364\t\n365\t        if (!*alt)\n366\t            *alt = pgn_alternative_moves_init();\n367\t\n368\t        pgn_cursor_skip_whitespace(str, &cursor);\n369\t        pgn_alternative_moves_push(*alt, __pgn_moves_from_string_recurse(str + cursor, &cursor, pgn_moves_init(), expect));\n370\t        pgn_cursor_skip_whitespace(str, &cursor);\n371\t        assert(str[cursor++] == ')');\n372\t\n373\t        pgn_cursor_skip_whitespace(str, &cursor);\n374\t        cursor += pgn_comments_poll(placeholder, PGN_COMMENT_POSITION_AFTER_ALTERNATIVE, str + cursor);\n375\t    }\n376\t\n377\t    return cursor;\n378\t}\n379\t\n380\tvoid pgn_alternative_moves_push(pgn_alternative_moves_t *alt, pgn_moves_t *moves)\n381\t{\n382\t    if (alt->length >= alt->size) {\n383\t        alt->size += PGN_ALTERNATIVE_MOVES_GROW_SIZE;\n384\t        alt->values = realloc(alt->values,  (sizeof *alt->values) * alt->size);\n385\t    }\n386\t\n387\t    alt->values[alt->length++] = moves;\n388\t}\n389\t\n390\tvoid pgn_alternative_moves_cleanup(pgn_alternative_moves_t *alt)\n391\t{\n392\t    for (size_t i = 0; i < alt->length; i++) {\n393\t        pgn_moves_cleanup(alt->values[i]);\n394\t    }\n395\t\n396\t    free(alt->values);\n397\t    free(alt);\n398\t}\n399\t\n400\tpgn_moves_t *pgn_moves_init(void)\n401\t{\n402\t    pgn_moves_t *moves = malloc(sizeof *moves);\n403\t    moves->values = malloc(sizeof *moves->values * PGN_MOVES_INITIAL_SIZE);\n404\t    moves->size = PGN_MOVES_INITIAL_SIZE;\n405\t    moves->length = 0;\n406\t    return moves;\n407\t}\n408\t\n409\tvoid pgn_moves_push(pgn_moves_t *moves, __pgn_moves_item_t __moves)\n410\t{\n411\t    if (moves->length >= moves->size) {\n412\t        moves->size += PGN_MOVES_GROW_SIZE;\n413\t        moves->values = realloc(moves->values,  (sizeof *moves->values) * moves->size);\n414\t    }\n415\t\n416\t    moves->values[moves->length++] = __moves;\n417\t}\n418\t\n419\tvoid pgn_moves_cleanup(pgn_moves_t *moves)\n420\t{\n421\t    for (size_t i = 0; i < moves->length; i++) {\n422\t        if (moves->values[i].white.comments) {\n423\t            pgn_comments_cleanup(moves->values[i].white.comments);\n424\t        }\n425\t\n426\t        if (moves->values[i].black.comments) {\n427\t            pgn_comments_cleanup(moves->values[i].black.comments);\n428\t        }\n429\t\n430\t        if (moves->values[i].white.alternatives) {\n431\t            pgn_alternative_moves_cleanup(moves->values[i].white.alternatives);\n432\t        }\n433\t\n434\t        if (moves->values[i].black.alternatives) {\n435\t            pgn_alternative_moves_cleanup(moves->values[i].black.alternatives);\n436\t        }\n437\t    }\n