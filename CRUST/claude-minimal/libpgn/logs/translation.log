{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01PhUQzVUjnEwb31AzTvcD3V","type":"tool_result","content":"1\t#include \"extra/suite6.h\"\n2\t\n3\t#include <pgn.h>\n4\t#include <string.h>\n5\t\n6\tvoid test_parsing_single_move()\n7\t{\n8\t    pgn_move_t move = {0};\n9\t\n10\t    move = pgn_parse_move(\"e4??\");\n11\t    suite6_assert(move.piece == PGN_PIECE_PAWN);\n12\t    suite6_assert(move.captures == false);\n13\t    suite6_assert(move.from.file == PGN_COORDINATE_UNKNOWN);\n14\t    suite6_assert(move.from.rank == PGN_COORDINATE_UNKNOWN);\n15\t    suite6_assert(move.dest.file == 'e');\n16\t    suite6_assert(move.dest.rank == 4);\n17\t    suite6_assert(move.check == PGN_CHECK_NONE);\n18\t    suite6_assert(!strcmp(move.notation, \"e4??\"));\n19\t    suite6_assert(move.annotation == PGN_ANNOTATION_BLUNDER);\n20\t\n21\t    move = pgn_parse_move(\"Nb6d5+\");\n22\t    suite6_assert(move.piece == PGN_PIECE_KNIGHT);\n23\t    suite6_assert(move.captures == false);\n24\t    suite6_assert(move.from.file == 'b');\n25\t    suite6_assert(move.from.rank == 6);\n26\t    suite6_assert(move.dest.file == 'd');\n27\t    suite6_assert(move.dest.rank == 5);\n28\t    suite6_assert(move.check == PGN_CHECK_SINGLE);\n29\t    suite6_assert(!strcmp(move.notation, \"Nb6d5+\"));\n30\t    suite6_assert(move.annotation == PGN_ANNOTATION_UNKNOWN);\n31\t\n32\t    move = pgn_parse_move(\"Qf1?!\");\n33\t    suite6_assert(move.piece == PGN_PIECE_QUEEN);\n34\t    suite6_assert(move.captures == false);\n35\t    suite6_assert(move.from.file == PGN_COORDINATE_UNKNOWN);\n36\t    suite6_assert(move.from.rank == PGN_COORDINATE_UNKNOWN);\n37\t    suite6_assert(move.dest.file == 'f');\n38\t    suite6_assert(move.dest.rank == 1);\n39\t    suite6_assert(move.check == PGN_CHECK_NONE);\n40\t    suite6_assert(!strcmp(move.notation, \"Qf1?!\"));\n41\t    suite6_assert(move.annotation == PGN_ANNOTATION_DUBIOUS_MOVE);\n42\t\n43\t    move = pgn_parse_move(\"bxa8=Q??\");\n44\t    suite6_assert(move.piece == PGN_PIECE_PAWN);\n45\t    suite6_assert(move.captures == true);\n46\t    suite6_assert(move.from.file == 'b');\n47\t    suite6_assert(move.from.rank == PGN_COORDINATE_UNKNOWN);\n48\t    suite6_assert(move.dest.file == 'a');\n49\t    suite6_assert(move.dest.rank == 8);\n50\t    suite6_assert(move.check == PGN_CHECK_NONE);\n51\t    suite6_assert(move.promoted_to == PGN_PIECE_QUEEN);\n52\t    suite6_assert(!strcmp(move.notation, \"bxa8=Q??\"));\n53\t    suite6_assert(move.annotation == PGN_ANNOTATION_BLUNDER);\n54\t\n55\t    move = pgn_parse_move(\"Bxg2\");\n56\t    suite6_assert(move.piece == PGN_PIECE_BISHOP);\n57\t    suite6_assert(move.captures == true);\n58\t    suite6_assert(move.from.file == PGN_COORDINATE_UNKNOWN);\n59\t    suite6_assert(move.from.rank == PGN_COORDINATE_UNKNOWN);\n60\t    suite6_assert(move.dest.file == 'g');\n61\t    suite6_assert(move.dest.rank == 2);\n62\t    suite6_assert(move.check == PGN_CHECK_NONE);\n63\t    suite6_assert(move.promoted_to == PGN_PIECE_UNKNOWN);\n64\t    suite6_assert(!strcmp(move.notation, \"Bxg2\"));\n65\t    suite6_assert(move.annotation == PGN_ANNOTATION_UNKNOWN);\n66\t\n67\t    move = pgn_parse_move(\"exf2+!\");\n68\t    suite6_assert(move.piece == PGN_PIECE_PAWN);\n69\t    suite6_assert(move.captures == true);\n70\t    suite6_assert(move.from.file == 'e');\n71\t    suite6_assert(move.from.rank == PGN_COORDINATE_UNKNOWN);\n72\t    suite6_assert(move.dest.file == 'f');\n73\t    suite6_assert(move.dest.rank == 2);\n74\t    suite6_assert(move.check == PGN_CHECK_SINGLE);\n75\t    suite6_assert(move.promoted_to == PGN_PIECE_UNKNOWN);\n76\t    suite6_assert(!strcmp(move.notation, \"exf2+!\"));\n77\t    suite6_assert(move.annotation == PGN_ANNOTATION_GOOD_MOVE);\n78\t\n79\t    move = pgn_parse_move(\"O-O+!!\");\n80\t    suite6_assert(move.castles == PGN_CASTLING_KINGSIDE);\n81\t    suite6_assert(move.check == PGN_CHECK_SINGLE);\n82\t    suite6_assert(!strcmp(move.notation, \"O-O+!!\"));\n83\t    suite6_assert(move.annotation == PGN_ANNOTATION_BRILLIANT_MOVE);\n84\t\n85\t    move = pgn_parse_move(\"O-O-O\");\n86\t    suite6_assert(move.castles == PGN_CASTLING_QUEENSIDE);\n87\t    suite6_assert(move.check == PGN_CHECK_NONE);\n88\t    suite6_assert(!strcmp(move.notation, \"O-O-O\"));\n89\t    suite6_assert(move.annotation == PGN_ANNOTATION_UNKNOWN);\n90\t}\n91\t\n92\tvoid test_parsing_bunch_of_moves()\n93\t{\n94\t    pgn_moves_t *moves = NULL;\n95\t\n96\t    moves = pgn_parse_moves(\"1.e4 e5\");\n97\t    suite6_assert(strcmp(moves->values[0].white.notation, \"e4\") == 0);\n98\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_PAWN);\n99\t    suite6_assert(moves->values[0].white.dest.file == 'e');\n100\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n101\t    suite6_assert(moves->values[0].white.captures == false);\n102\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n103\t    suite6_assert(strcmp(moves->values[0].black.notation, \"e5\") == 0);\n104\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_PAWN);\n105\t    suite6_assert(moves->values[0].black.dest.file == 'e');\n106\t    suite6_assert(moves->values[0].black.dest.rank == 5);\n107\t    suite6_assert(moves->values[0].black.captures == false);\n108\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_UNKNOWN);\n109\t    pgn_moves_cleanup(moves);\n110\t\n111\t    moves = pgn_parse_moves(\"1.e4 $2 e5 $1\");\n112\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_PAWN);\n113\t    suite6_assert(moves->values[0].white.dest.file == 'e');\n114\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n115\t    suite6_assert(moves->values[0].white.captures == false);\n116\t    suite6_assert(moves->values[0].white.annotation == 2);\n117\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_PAWN);\n118\t    suite6_assert(moves->values[0].black.dest.file == 'e');\n119\t    suite6_assert(moves->values[0].black.dest.rank == 5);\n120\t    suite6_assert(moves->values[0].black.captures == false);\n121\t    suite6_assert(moves->values[0].black.annotation == 1);\n122\t    pgn_moves_cleanup(moves);\n123\t\n124\t    moves = pgn_parse_moves(\"69.Be4 69... Rxe5?!\");\n125\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_BISHOP);\n126\t    suite6_assert(moves->values[0].white.dest.file == 'e');\n127\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n128\t    suite6_assert(moves->values[0].white.captures == false);\n129\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n130\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_ROOK);\n131\t    suite6_assert(moves->values[0].black.dest.file == 'e');\n132\t    suite6_assert(moves->values[0].black.dest.rank == 5);\n133\t    suite6_assert(moves->values[0].black.captures == true);\n134\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_DUBIOUS_MOVE);\n135\t    pgn_moves_cleanup(moves);\n136\t\n137\t    moves = pgn_parse_moves(\"9.e4 { This is a comment :O } e5 10. Nc3 Nc6\");\n138\t    suite6_assert(moves->values[0].white.comments->length == 1);\n139\t    suite6_assert(!strcmp(moves->values[0].white.comments->values[0].value->buf, \" This is a comment :O \"));\n140\t    suite6_assert(moves->values[0].white.comments->values[0].position == PGN_COMMENT_POSITION_AFTER_MOVE);\n141\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_PAWN);\n142\t    suite6_assert(moves->values[0].white.dest.file == 'e');\n143\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n144\t    suite6_assert(moves->values[0].white.captures == false);\n145\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n146\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_PAWN);\n147\t    suite6_assert(moves->values[0].black.dest.file == 'e');\n148\t    suite6_assert(moves->values[0].black.dest.rank == 5);\n149\t    suite6_assert(moves->values[0].black.captures == false);\n150\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_UNKNOWN);\n151\t\n152\t    suite6_assert(moves->values[1].white.piece == PGN_PIECE_KNIGHT);\n153\t    suite6_assert(moves->values[1].white.dest.file == 'c');\n154\t    suite6_assert(moves->values[1].white.dest.rank == 3);\n155\t    suite6_assert(moves->values[1].white.captures == false);\n156\t    suite6_assert(moves->values[1].white.annotation == PGN_ANNOTATION_UNKNOWN);\n157\t    suite6_assert(moves->values[1].black.piece == PGN_PIECE_KNIGHT);\n158\t    suite6_assert(moves->values[1].black.dest.file == 'c');\n159\t    suite6_assert(moves->values[1].black.dest.rank == 6);\n160\t    suite6_assert(moves->values[1].black.captures == false);\n161\t    suite6_assert(moves->values[1].black.annotation == PGN_ANNOTATION_UNKNOWN);\n162\t    pgn_moves_cleanup(moves);\n163\t\n164\t    moves = pgn_parse_moves(\"69.Be4 ( 69. Be2 69... e4 ) 69... Rxe5?!\");\n165\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_BISHOP);\n166\t    suite6_assert(moves->values[0].white.dest.file == 'e');\n167\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n168\t    suite6_assert(moves->values[0].white.captures == false);\n169\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n170\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_ROOK);\n171\t    suite6_assert(moves->values[0].black.dest.file == 'e');\n172\t    suite6_assert(moves->values[0].black.dest.rank == 5);\n173\t    suite6_assert(moves->values[0].black.captures == true);\n174\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_DUBIOUS_MOVE);\n175\t    suite6_assert(moves->values[0].white.alternatives);\n176\t\n177\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.piece == PGN_PIECE_BISHOP);\n178\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.dest.file == 'e');\n179\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.dest.rank == 2);\n180\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.captures == false);\n181\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n182\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].black.piece == PGN_PIECE_PAWN);\n183\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].black.dest.file == 'e');\n184\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].black.dest.rank == 4);\n185\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].black.captures == false);\n186\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].black.annotation == PGN_ANNOTATION_UNKNOWN);\n187\t    pgn_moves_cleanup(moves);\n188\t\n189\t    moves = pgn_parse_moves(\"69.Be4 69... Rxe5?! ( 69... e5 70. e4 )\");\n190\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_BISHOP);\n191\t    suite6_assert(moves->values[0].white.dest.file == 'e');\n192\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n193\t    suite6_assert(moves->values[0].white.captures == false);\n194\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n195\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_ROOK);\n196\t    suite6_assert(moves->values[0].black.dest.file == 'e');\n197\t    suite6_assert(moves->values[0].black.dest.rank == 5);\n198\t    suite6_assert(moves->values[0].black.captures == true);\n199\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_DUBIOUS_MOVE);\n200\t    suite6_assert(moves->values[0].black.alternatives);\n201\t\n202\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.piece == PGN_PIECE_PAWN);\n203\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.dest.file == 'e');\n204\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.dest.rank == 5);\n205\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.captures == false);\n206\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[0].black.annotation == PGN_ANNOTATION_UNKNOWN);\n207\t\n208\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[1].white.piece == PGN_PIECE_PAWN);\n209\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[1].white.dest.file == 'e');\n210\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[1].white.dest.rank == 4);\n211\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[1].white.captures == false);\n212\t    suite6_assert(moves->values[0].black.alternatives->values[0]->values[1].white.annotation == PGN_ANNOTATION_UNKNOWN);\n213\t    pgn_moves_cleanup(moves);\n214\t\n215\t    moves = pgn_parse_moves(\"1.c4 ( 1.e4  ) c5 2.Nc3 Nc6\");\n216\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_PAWN);\n217\t    suite6_assert(moves->values[0].white.dest.file == 'c');\n218\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n219\t    suite6_assert(moves->values[0].white.captures == false);\n220\t    suite6_assert(moves->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n221\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_PAWN);\n222\t    suite6_assert(moves->values[0].black.dest.file == 'c');\n223\t    suite6_assert(moves->values[0].black.dest.rank == 5);\n224\t    suite6_assert(moves->values[0].black.captures == false);\n225\t    suite6_assert(moves->values[0].black.annotation == PGN_ANNOTATION_UNKNOWN);\n226\t\n227\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.piece == PGN_PIECE_PAWN);\n228\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.dest.file == 'e');\n229\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.dest.rank == 4);\n230\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.captures == false);\n231\t    suite6_assert(moves->values[0].white.alternatives->values[0]->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n232\t\n233\t    suite6_assert(moves->values[1].white.piece == PGN_PIECE_KNIGHT);\n234\t    suite6_assert(moves->values[1].white.dest.file == 'c');\n235\t    suite6_assert(moves->values[1].white.dest.rank == 3);\n236\t    suite6_assert(moves->values[1].white.captures == false);\n237\t    suite6_assert(moves->values[1].white.annotation == PGN_ANNOTATION_UNKNOWN);\n238\t\n239\t    suite6_assert(moves->values[1].black.piece == PGN_PIECE_KNIGHT);\n240\t    suite6_assert(moves->values[1].black.dest.file == 'c');\n241\t    suite6_assert(moves->values[1].black.dest.rank == 6);\n242\t    suite6_assert(moves->values[1].black.captures == false);\n243\t    suite6_assert(moves->values[1].black.annotation == PGN_ANNOTATION_UNKNOWN);\n244\t    pgn_moves_cleanup(moves);\n245\t}\n246\t\n247\tvoid test_parsing_en_passant()\n248\t{\n249\t    pgn_move_t move = pgn_parse_move(\"exd6 e.p.\");\n250\t    suite6_assert(move.piece == PGN_PIECE_PAWN);\n251\t    suite6_assert(move.en_passant);\n252\t    suite6_assert(move.from.file == 'e');\n253\t    suite6_assert(move.dest.file == 'd');\n254\t    suite6_assert(move.dest.rank == 6);\n255\t    suite6_assert(move.captures);\n256\t\n257\t    pgn_moves_t *moves = pgn_parse_moves(\"1. d4 exd3 e.p. 2.  Nc4 Nc6 3. cxb3 e.p. 3... Be4\");\n258\t    suite6_assert(moves->values[0].white.piece == PGN_PIECE_PAWN);\n259\t    suite6_assert(moves->values[0].white.dest.file == 'd');\n260\t    suite6_assert(moves->values[0].white.dest.rank == 4);\n261\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"d4\"));\n262\t    suite6_assert(!moves->values[0].white.en_passant);\n263\t    suite6_assert(moves->values[0].black.piece == PGN_PIECE_PAWN);\n264\t    suite6_assert(moves->values[0].black.from.file == 'e');\n265\t    suite6_assert(moves->values[0].black.dest.file == 'd');\n266\t    suite6_assert(moves->values[0].black.dest.rank == 3);\n267\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"exd3 e.p.\"));\n268\t    suite6_assert(moves->values[0].black.en_passant);\n269\t\n270\t    suite6_assert(moves->values[1].white.piece == PGN_PIECE_KNIGHT);\n271\t    suite6_assert(moves->values[1].white.dest.file == 'c');\n272\t    suite6_assert(moves->values[1].white.dest.rank == 4);\n273\t    suite6_assert(!strcmp(moves->values[1].white.notation, \"Nc4\"));\n274\t    suite6_assert(!moves->values[1].white.en_passant);\n275\t    suite6_assert(moves->values[1].black.piece == PGN_PIECE_KNIGHT);\n276\t    suite6_assert(moves->values[1].black.dest.file == 'c');\n277\t    suite6_assert(moves->values[1].black.dest.rank == 6);\n278\t    suite6_assert(!strcmp(moves->values[1].black.notation, \"Nc6\"));\n279\t    suite6_assert(!moves->values[1].black.en_passant);\n280\t\n281\t    suite6_assert(moves->values[2].white.piece == PGN_PIECE_PAWN);\n282\t    suite6_assert(moves->values[2].white.from.file == 'c');\n283\t    suite6_assert(moves->values[2].white.dest.file == 'b');\n284\t    suite6_assert(moves->values[2].white.dest.rank == 3);\n285\t    suite6_assert(!strcmp(moves->values[2].white.notation, \"cxb3 e.p.\"));\n286\t    suite6_assert(moves->values[2].white.en_passant);\n287\t    suite6_assert(moves->values[2].black.piece == PGN_PIECE_BISHOP);\n288\t    suite6_assert(moves->values[2].black.dest.file == 'e');\n289\t    suite6_assert(moves->values[2].black.dest.rank == 4);\n290\t    suite6_assert(!strcmp(moves->values[2].black.notation, \"Be4\"));\n291\t    suite6_assert(!moves->values[2].black.en_passant);\n292\t    pgn_moves_cleanup(moves);\n293\t}\n294\t\n295\tvoid test_parsing_moves_with_alternatives()\n296\t{\n297\t    pgn_moves_t *moves = NULL;\n298\t\n299\t    moves = pgn_moves_from_string(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5\");\n300\t    suite6_assert(moves->length == 1);\n301\t    suite6_assert(moves->values[0].white.alternatives->length == 1);\n302\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n303\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n304\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n305\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n306\t    pgn_moves_cleanup(moves);\n307\t\n308\t    moves = pgn_moves_from_string(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) (1. e4 f6? 2. d4 g5?? 3. Qh5#) e5\");\n309\t    suite6_assert(moves->length == 1);\n310\t    suite6_assert(moves->values[0].white.alternatives->length == 2);\n311\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n312\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n313\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n314\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n315\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[0].white.notation, \"e4\"));\n316\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[0].black.notation, \"f6?\"));\n317\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[1].white.notation, \"d4\"));\n318\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[1].black.notation, \"g5??\"));\n319\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[1]->values[2].white.notation, \"Qh5#\"));\n320\t    pgn_moves_cleanup(moves);\n321\t\n322\t    moves = pgn_moves_from_string(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5 2. Nc6 Nf4\");\n323\t    suite6_assert(moves->length == 2);\n324\t    suite6_assert(moves->values[0].white.alternatives->length == 1);\n325\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].white.notation, \"f4?\"));\n326\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[0].black.notation, \"e5!\"));\n327\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].white.notation, \"g4??\"));\n328\t    suite6_assert(!strcmp(moves->values[0].white.alternatives->values[0]->values[1].black.notation, \"Qh4#\"));\n329\t    suite6_assert(!strcmp(moves->values[1].white.notation, \"Nc6\"));\n330\t    suite6_assert(!strcmp(moves->values[1].black.notation, \"Nf4\"));\n331\t    pgn_moves_cleanup(moves);\n332\t}\n333\t\n334\tvoid test_parsing_ambiguate_moves()\n335\t{\n336\t    pgn_moves_t *moves = NULL;\n337\t\n338\t    moves = pgn_moves_from_string(\"1. Rdf8 R1a3\");\n339\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"Rdf8\"));\n340\t    suite6_assert(moves->values[0].white.from.file == 'd');\n341\t    suite6_assert(moves->values[0].white.from.rank == 0);\n342\t    suite6_assert(moves->values[0].white.dest.file == 'f');\n343\t    suite6_assert(moves->values[0].white.dest.rank == 8);\n344\t\n345\t    suite6_assert(!strcmp(moves->values[0].black.notation, \"R1a3\"));\n346\t    suite6_assert(moves->values[0].black.from.file == 0);\n347\t    suite6_assert(moves->values[0].black.from.rank == 1);\n348\t    suite6_assert(moves->values[0].black.dest.file == 'a');\n349\t    suite6_assert(moves->values[0].black.dest.rank == 3);\n350\t    pgn_moves_cleanup(moves);\n351\t\n352\t    moves = pgn_moves_from_string(\"1. Qh4e1\");\n353\t    suite6_assert(!strcmp(moves->values[0].white.notation, \"Qh4e1\"));\n354\t    suite6_assert(moves->values[0].white.from.file == 'h');\n355\t    suite6_assert(moves->values[0].white.from.rank == 4);\n356\t    suite6_assert(moves->values[0].white.dest.file == 'e');\n357\t    suite6_assert(moves->values[0].white.dest.rank == 1);\n358\t    pgn_moves_cleanup(moves);\n359\t}\n360\t\n361\tvoid test_dump_move()\n362\t{\n363\t    pgn_move_t move = {0};\n364\t    size_t written = 0;\n365\t\n366\t    move = (pgn_move_t){0};\n367\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n368\t    move.piece = PGN_PIECE_PAWN;\n369\t    move.dest.file = 'e';\n370\t    move.dest.rank = 4;\n371\t    written = pgn_move_to_string(&move, move.notation);\n372\t    suite6_assert(strlen(move.notation) == written);\n373\t    suite6_assert(!strcmp(move.notation, \"e4\"));\n374\t\n375\t    move = (pgn_move_t){0};\n376\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n377\t    move.piece = PGN_PIECE_ROOK;\n378\t    move.dest.file = 'e';\n379\t    move.dest.rank = 4;\n380\t    written = pgn_move_to_string(&move, move.notation);\n381\t    suite6_assert(strlen(move.notation) == written);\n382\t    suite6_assert(!strcmp(move.notation, \"Re4\"));\n383\t\n384\t    move = (pgn_move_t){0};\n385\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n386\t    move.piece = PGN_PIECE_ROOK;\n387\t    move.check = PGN_CHECK_MATE;\n388\t    move.dest.file = 'e';\n389\t    move.dest.rank = 4;\n390\t    written = pgn_move_to_string(&move, move.notation);\n391\t    suite6_assert(strlen(move.notation) == written);\n392\t    suite6_assert(!strcmp(move.notation, \"Re4#\"));\n393\t\n394\t    move = (pgn_move_t){0};\n395\t    move.annotation = PGN_ANNOTATION_UNKNOWN;\n396\t    move.castles = PGN_CASTLING_KINGSIDE;\n397\t    move.check = PGN_CHECK_MATE;\n398\t    written = pgn_move_to_string(&move, move.notation);\n399\t    suite6_assert(strlen(move.notation) == written);\n400\t    suite6_assert(!strcmp(move.notation, \"O-O#\"));\n401\t\n402\t    move = (pgn_move_t){0};\n403\t    move.annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n404\t    move.piece = PGN_PIECE_ROOK;\n405\t    move.dest.file = 'a';\n406\t    move.dest.rank = 3;\n407\t    written = pgn_