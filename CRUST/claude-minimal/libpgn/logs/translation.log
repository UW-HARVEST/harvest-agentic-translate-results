ap().values[0].values[1]\n323\t            .white\n324\t            .captures,\n325\t        false\n326\t    );\n327\t    assert_eq!(\n328\t        moves.values[0].black.alternatives.as_ref().unwrap().values[0].values[1]\n329\t            .white\n330\t            .annotation,\n331\t        PgnAnnotation::Unknown\n332\t    );\n333\t\n334\t    moves = PgnMoves::from(\"1.c4 ( 1.e4  ) c5 2.Nc3 Nc6\");\n335\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n336\t    assert_eq!(moves.values[0].white.dest.file, Some('c'));\n337\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n338\t    assert_eq!(moves.values[0].white.captures, false);\n339\t    assert_eq!(moves.values[0].white.annotation, PgnAnnotation::Unknown);\n340\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n341\t    assert_eq!(moves.values[0].black.dest.file, Some('c'));\n342\t    assert_eq!(moves.values[0].black.dest.rank, Some(5));\n343\t    assert_eq!(moves.values[0].black.captures, false);\n344\t    assert_eq!(moves.values[0].black.annotation, PgnAnnotation::Unknown);\n345\t\n346\t    assert_eq!(\n347\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n348\t            .white\n349\t            .piece,\n350\t        PgnPiece::Pawn\n351\t    );\n352\t    assert_eq!(\n353\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n354\t            .white\n355\t            .dest\n356\t            .file,\n357\t        Some('e')\n358\t    );\n359\t    assert_eq!(\n360\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n361\t            .white\n362\t            .dest\n363\t            .rank,\n364\t        Some(4)\n365\t    );\n366\t    assert_eq!(\n367\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n368\t            .white\n369\t            .captures,\n370\t        false\n371\t    );\n372\t    assert_eq!(\n373\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n374\t            .white\n375\t            .annotation,\n376\t        PgnAnnotation::Unknown\n377\t    );\n378\t\n379\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n380\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n381\t    assert_eq!(moves.values[1].white.dest.rank, Some(3));\n382\t    assert_eq!(moves.values[1].white.captures, false);\n383\t    assert_eq!(moves.values[1].white.annotation, PgnAnnotation::Unknown);\n384\t\n385\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n386\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n387\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n388\t    assert_eq!(moves.values[1].black.captures, false);\n389\t    assert_eq!(moves.values[1].black.annotation, PgnAnnotation::Unknown);\n390\t}\n391\t\n392\t#[test]\n393\tfn test_parsing_en_passant() {\n394\t    let mv = PgnMove::from(\"exd6 e.p.\");\n395\t    assert_eq!(mv.piece, PgnPiece::Pawn);\n396\t    assert!(mv.en_passant);\n397\t    assert_eq!(mv.from.file, Some('e'));\n398\t    assert_eq!(mv.dest.file, Some('d'));\n399\t    assert_eq!(mv.dest.rank, Some(6));\n400\t    assert!(mv.captures);\n401\t\n402\t    let moves = PgnMoves::from(\"1. d4 exd3 e.p. 2. Nc4 Nc6 3. cxb3 e.p. 3... Be4\");\n403\t    assert_eq!(moves.values[0].white.piece, PgnPiece::Pawn);\n404\t    assert_eq!(moves.values[0].white.dest.file, Some('d'));\n405\t    assert_eq!(moves.values[0].white.dest.rank, Some(4));\n406\t    assert_eq!(moves.values[0].white.notation, \"d4\");\n407\t    assert!(!moves.values[0].white.en_passant);\n408\t    assert_eq!(moves.values[0].black.piece, PgnPiece::Pawn);\n409\t    assert_eq!(moves.values[0].black.from.file, Some('e'));\n410\t    assert_eq!(moves.values[0].black.dest.file, Some('d'));\n411\t    assert_eq!(moves.values[0].black.dest.rank, Some(3));\n412\t    assert_eq!(moves.values[0].black.notation, \"exd3 e.p.\");\n413\t    assert!(moves.values[0].black.en_passant);\n414\t\n415\t    assert_eq!(moves.values[1].white.piece, PgnPiece::Knight);\n416\t    assert_eq!(moves.values[1].white.dest.file, Some('c'));\n417\t    assert_eq!(moves.values[1].white.dest.rank, Some(4));\n418\t    assert_eq!(moves.values[1].white.notation, \"Nc4\");\n419\t    assert!(!moves.values[1].white.en_passant);\n420\t    assert_eq!(moves.values[1].black.piece, PgnPiece::Knight);\n421\t    assert_eq!(moves.values[1].black.dest.file, Some('c'));\n422\t    assert_eq!(moves.values[1].black.dest.rank, Some(6));\n423\t    assert_eq!(moves.values[1].black.notation, \"Nc6\");\n424\t    assert!(!moves.values[1].black.en_passant);\n425\t\n426\t    assert_eq!(moves.values[2].white.piece, PgnPiece::Pawn);\n427\t    assert_eq!(moves.values[2].white.from.file, Some('c'));\n428\t    assert_eq!(moves.values[2].white.dest.file, Some('b'));\n429\t    assert_eq!(moves.values[2].white.dest.rank, Some(3));\n430\t    assert_eq!(moves.values[2].white.notation, \"cxb3 e.p.\");\n431\t    assert!(moves.values[2].white.en_passant);\n432\t    assert_eq!(moves.values[2].black.piece, PgnPiece::Bishop);\n433\t    assert_eq!(moves.values[2].black.dest.file, Some('e'));\n434\t    assert_eq!(moves.values[2].black.dest.rank, Some(4));\n435\t    assert_eq!(moves.values[2].black.notation, \"Be4\");\n436\t    assert!(!moves.values[2].black.en_passant);\n437\t}\n438\t\n439\t#[test]\n440\tfn test_parsing_moves_with_alternatives() {\n441\t    let mut moves: PgnMoves;\n442\t\n443\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5\");\n444\t    assert_eq!(moves.values.len(), 1);\n445\t    assert_eq!(\n446\t        moves.values[0]\n447\t            .white\n448\t            .alternatives\n449\t            .as_ref()\n450\t            .unwrap()\n451\t            .values\n452\t            .len(),\n453\t        1\n454\t    );\n455\t    assert_eq!(\n456\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n457\t            .white\n458\t            .notation,\n459\t        \"f4?\"\n460\t    );\n461\t    assert_eq!(\n462\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n463\t            .black\n464\t            .notation,\n465\t        \"e5!\"\n466\t    );\n467\t    assert_eq!(\n468\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n469\t            .white\n470\t            .notation,\n471\t        \"g4??\"\n472\t    );\n473\t    assert_eq!(\n474\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n475\t            .black\n476\t            .notation,\n477\t        \"Qh4#\"\n478\t    );\n479\t\n480\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) (1. e4 f6? 2. d4 g5?? 3. Qh5#) e5\");\n481\t    assert_eq!(moves.values.len(), 1);\n482\t    assert_eq!(\n483\t        moves.values[0]\n484\t            .white\n485\t            .alternatives\n486\t            .as_ref()\n487\t            .unwrap()\n488\t            .values\n489\t            .len(),\n490\t        2\n491\t    );\n492\t    assert_eq!(\n493\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n494\t            .white\n495\t            .notation,\n496\t        \"f4?\"\n497\t    );\n498\t    assert_eq!(\n499\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n500\t            .black\n501\t            .notation,\n502\t        \"e5!\"\n503\t    );\n504\t    assert_eq!(\n505\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n506\t            .white\n507\t            .notation,\n508\t        \"g4??\"\n509\t    );\n510\t    assert_eq!(\n511\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n512\t            .black\n513\t            .notation,\n514\t        \"Qh4#\"\n515\t    );\n516\t    assert_eq!(\n517\t        moves.values[0].white.alternatives.as_ref().unwrap().values[1].values[0]\n518\t            .white\n519\t            .notation,\n520\t        \"e4\"\n521\t    );\n522\t    assert_eq!(\n523\t        moves.values[0].white.alternatives.as_ref().unwrap().values[1].values[0]\n524\t            .black\n525\t            .notation,\n526\t        \"f6?\"\n527\t    );\n528\t    assert_eq!(\n529\t        moves.values[0].white.alternatives.as_ref().unwrap().values[1].values[1]\n530\t            .white\n531\t            .notation,\n532\t        \"d4\"\n533\t    );\n534\t    assert_eq!(\n535\t        moves.values[0].white.alternatives.as_ref().unwrap().values[1].values[1]\n536\t            .black\n537\t            .notation,\n538\t        \"g5??\"\n539\t    );\n540\t    assert_eq!(\n541\t        moves.values[0].white.alternatives.as_ref().unwrap().values[1].values[2]\n542\t            .white\n543\t            .notation,\n544\t        \"Qh5#\"\n545\t    );\n546\t\n547\t    moves = PgnMoves::from(\"1. e4 (1. f4? e5! 2. g4?? Qh4#) e5 2. Nc6 Nf4\");\n548\t    assert_eq!(moves.values.len(), 2);\n549\t    assert_eq!(\n550\t        moves.values[0]\n551\t            .white\n552\t            .alternatives\n553\t            .as_ref()\n554\t            .unwrap()\n555\t            .values\n556\t            .len(),\n557\t        1\n558\t    );\n559\t    assert_eq!(\n560\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n561\t            .white\n562\t            .notation,\n563\t        \"f4?\"\n564\t    );\n565\t    assert_eq!(\n566\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[0]\n567\t            .black\n568\t            .notation,\n569\t        \"e5!\"\n570\t    );\n571\t    assert_eq!(\n572\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n573\t            .white\n574\t            .notation,\n575\t        \"g4??\"\n576\t    );\n577\t    assert_eq!(\n578\t        moves.values[0].white.alternatives.as_ref().unwrap().values[0].values[1]\n579\t            .black\n580\t            .notation,\n581\t        \"Qh4#\"\n582\t    );\n583\t    assert_eq!(moves.values[1].white.notation, \"Nc6\");\n584\t    assert_eq!(moves.values[1].black.notation, \"Nf4\");\n585\t}\n586\t\n587\t#[test]\n588\tfn test_parsing_ambiguate_moves() {\n589\t    let mut moves: PgnMoves;\n590\t\n591\t    moves = PgnMoves::from(\"1. Rdf8 R1a3\");\n592\t    assert_eq!(moves.values[0].white.notation, \"Rdf8\");\n593\t    assert_eq!(moves.values[0].white.from.file, Some('d'));\n594\t    assert_eq!(moves.values[0].white.from.rank, None);\n595\t    assert_eq!(moves.values[0].white.dest.file, Some('f'));\n596\t    assert_eq!(moves.values[0].white.dest.rank, Some(8));\n597\t\n598\t    assert_eq!(moves.values[0].black.notation, \"R1a3\");\n599\t    assert_eq!(moves.values[0].black.from.file, None);\n600\t    assert_eq!(moves.values[0].black.from.rank, Some(1));\n601\t    assert_eq!(moves.values[0].black.dest.file, Some('a'));\n602\t    assert_eq!(moves.values[0].black.dest.rank, Some(3));\n603\t\n604\t    moves = PgnMoves::from(\"1. Qh4e1\");\n605\t    assert_eq!(moves.values[0].white.notation, \"Qh4e1\");\n606\t    assert_eq!(moves.values[0].white.from.file, Some('h'));\n607\t    assert_eq!(moves.values[0].white.from.rank, Some(4));\n608\t    assert_eq!(moves.values[0].white.dest.file, Some('e'));\n609\t    assert_eq!(moves.values[0].white.dest.rank, Some(1));\n610\t}\n611\t\n612\t#[test]\n613\tfn test_dump_move() {\n614\t    let mut mv: PgnMove;\n615\t    let mut written: usize;\n616\t\n617\t    mv = PgnMove {\n618\t        annotation: PgnAnnotation::Unknown,\n619\t        piece: PgnPiece::Pawn,\n620\t        dest: PgnCoordinate {\n621\t            file: Some('e'),\n622\t            rank: Some(4),\n623\t        },\n624\t        ..Default::default()\n625\t    };\n626\t    assert_eq!(mv.to_string(), \"e4\");\n627\t\n628\t    mv = PgnMove {\n629\t        annotation: PgnAnnotation::Unknown,\n630\t        piece: PgnPiece::Rook,\n631\t        dest: PgnCoordinate {\n632\t            file: Some('e'),\n633\t            rank: Some(4),\n634\t        },\n635\t        ..Default::default()\n636\t    };\n637\t    assert_eq!(mv.to_string(), \"Re4\");\n638\t\n639\t    mv = PgnMove {\n640\t        annotation: PgnAnnotation::Unknown,\n641\t        piece: PgnPiece::Rook,\n642\t        check: PgnCheck::Mate,\n643\t        dest: PgnCoordinate {\n644\t            file: Some('e'),\n645\t            rank: Some(4),\n646\t        },\n647\t        ..Default::default()\n648\t    };\n649\t    assert_eq!(mv.to_string(), \"Re4#\");\n650\t\n651\t    mv = PgnMove {\n652\t        annotation: PgnAnnotation::Unknown,\n653\t        castles: PGN_CASTLING_KINGSIDE,\n654\t        check: PgnCheck::Mate,\n655\t        ..Default::default()\n656\t    };\n657\t    assert_eq!(mv.to_string(), \"O-O#\");\n658\t\n659\t    mv = PgnMove {\n660\t        annotation: PgnAnnotation::InterestingMove,\n661\t        piece: PgnPiece::Rook,\n662\t        dest: PgnCoordinate {\n663\t            file: Some('a'),\n664\t            rank: Some(3),\n665\t        },\n666\t        ..Default::default()\n667\t    };\n668\t    assert_eq!(mv.to_string(), \"Ra3!?\");\n669\t\n670\t    mv = PgnMove {\n671\t        annotation: PgnAnnotation::InterestingMove,\n672\t        en_passant: true,\n673\t        piece: PgnPiece::Pawn,\n674\t        dest: PgnCoordinate {\n675\t            file: Some('f'),\n676\t            rank: Some(3),\n677\t        },\n678\t        ..Default::default()\n679\t    };\n680\t    assert_eq!(mv.to_string(), \"f3!? e.p.\");\n681\t\n682\t    mv = PgnMove {\n683\t        annotation: PgnAnnotation::from(9),\n684\t        piece: PgnPiece::Pawn,\n685\t        dest: PgnCoordinate {\n686\t            file: Some('f'),\n687\t            rank: Some(3),\n688\t        },\n689\t        ..Default::default()\n690\t    };\n691\t    assert_eq!(mv.to_string(), \"f3 $9\");\n692\t\n693\t    mv = PgnMove {\n694\t        annotation: PgnAnnotation::from(9),\n695\t        en_passant: true,\n696\t        piece: PgnPiece::Pawn,\n697\t        dest: PgnCoordinate {\n698\t            file: Some('f'),\n699\t            rank: Some(3),\n700\t        },\n701\t        ..Default::default()\n702\t    };\n703\t    assert_eq!(mv.notation, \"f3 e.p. $9\");\n704\t\n705\t    mv = PgnMove {\n706\t        annotation: PgnAnnotation::Unknown,\n707\t        piece: PgnPiece::Pawn,\n708\t        captures: true,\n709\t        dest: PgnCoordinate {\n710\t            file: Some('f'),\n711\t            rank: Some(3),\n712\t        },\n713\t        ..Default::default()\n714\t    };\n715\t    assert_eq!(mv.to_string(), \"xf3\");\n716\t\n717\t    mv = PgnMove {\n718\t        annotation: PgnAnnotation::Unknown,\n719\t        piece: PgnPiece::Rook,\n720\t        captures: true,\n721\t        dest: PgnCoordinate {\n722\t            file: Some('f'),\n723\t            rank: Some(3),\n724\t        },\n725\t        ..Default::default()\n726\t    };\n727\t    assert_eq!(mv.to_string(), \"Rxf3\");\n728\t\n729\t    mv = PgnMove {\n730\t        annotation: PgnAnnotation::Unknown,\n731\t        piece: PgnPiece::Pawn,\n732\t        captures: true,\n733\t        dest: PgnCoordinate {\n734\t            file: Some('f'),\n735\t            rank: Some(8),\n736\t        },\n737\t        promoted_to: PgnPiece::Queen,\n738\t        check: PgnCheck::Double,\n739\t        ..Default::default()\n740\t    };\n741\t    assert_eq!(mv.to_string(), \"xf8=Q++\");\n742\t}\n743\t\n744\t#[test]\n745\tfn test_parsing_weird_move() {\n746\t    // NOTE: the original test case has a return statement at the beginning\n747\t    // thus the test is not executed\n748\t    // assert_eq!(PgnMove::from(\"Le1\").notation, \"\");\n749\t    // assert_eq!(PgnMove::from(\"xe100\").notation, \"\");\n750\t}\n751\t\n752\t#[test]\n753\tfn test_parsing_moves_with_weird_spaces() {\n754\t    // NOTE: the original test case has a return statement at the beginning\n755\t    // thus the test is not executed\n756\t\n757\t    /*\n758\t    let mut moves: PgnMoves;\n759\t\n760\t    moves = PgnMoves::from(\"1. Rdf8e.p.\");\n761\t\n762\t    