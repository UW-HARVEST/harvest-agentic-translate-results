{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01TCyVgYGhFJSSXXuoYtyAjD","type":"tool_result","content":"1\tuse c_aces::common::randrange;\n2\tuse c_aces::polynomial::{PolyArray, Polynomial};\n3\t\n4\tfn set_zero_and_check(poly: &Polynomial) {\n5\t    let mut p = poly.clone();\n6\t    p.set_zero();\n7\t    for &coeff in &p.coeffs {\n8\t        assert_eq!(coeff, 0);\n9\t    }\n10\t}\n11\t\n12\t#[test]\n13\tfn set_zero_test() {\n14\t    let static_poly = Polynomial::new(vec![0; 10]);\n15\t    assert_eq!(static_poly.coeffs.len(), 10);\n16\t    set_zero_and_check(&static_poly);\n17\t\n18\t    let dynamic_poly = Polynomial::new(vec![0; 10]);\n19\t    assert_eq!(dynamic_poly.coeffs.len(), 10);\n20\t    set_zero_and_check(&dynamic_poly);\n21\t}\n22\t\n23\t#[test]\n24\tfn poly_degree_test() {\n25\t    // Create a polynomial with 10 coefficients, all initially zero.\n26\t    let mut poly = Polynomial::new(vec![0; 10]);\n27\t    poly.set_zero();\n28\t    assert_eq!(poly.degree(), 0);\n29\t\n30\t    // Simulate the C test:\n31\t    // 1. Only the last coefficient is nonzero.\n32\t    poly.coeffs[9] = randrange(0, u32::MAX as u64) as i64;\n33\t    // In the C test, the degree was still expected to be 0 because the\n34\t    // evaluation at ω was defined in a special way. Here we mimic the test’s\n35\t    // behavior by “ignoring” the nonzero at the very end.\n36\t    assert_eq!(poly.degree(), 0);\n37\t\n38\t    // 2. Now set the next-to-last coefficient nonzero.\n39\t    poly.coeffs[8] = randrange(0, u32::MAX as u64) as i64;\n40\t    // The C test expected degree() to now be 1.\n41\t    assert_eq!(poly.degree(), 1);\n42\t\n43\t    // 3. Finally, set the first coefficient nonzero.\n44\t    poly.coeffs[0] = 1;\n45\t    // The expected degree becomes 9.\n46\t    assert_eq!(poly.degree(), 9);\n47\t}\n48\t\n49\t#[test]\n50\tfn poly_add_test() {\n51\t    // poly_add_test_1\n52\t    let poly1 = Polynomial::new(vec![1, 2, 3, 4, 5, 6, 7, 8, 9, 0]);\n53\t  