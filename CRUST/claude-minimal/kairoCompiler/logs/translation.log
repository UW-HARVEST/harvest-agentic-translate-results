The C code: #warning \"we should set the binded owner and binded function here\"\n    // So this is a placeholder; we leave binded with default None values.\n    node_push(&node);\n    node\n}\n","structuredPatch":[{"oldStart":65,"oldLines":6,"newStart":65,"newLines":23,"lines":["     (v, r)"," }"," ","+/// Push the index of the top of node_vector onto node_vector_root.","+pub fn node_root_push_top() {","+    let mut nv = NODE_VECTOR.lock().unwrap();","+    let bytes = match nv.as_mut() {","+        Some(vec) => match crate::vector::vector_back_or_null(vec) {","+            Some(slot) => slot.to_vec(),","+            None => return,","+        },","+        None => return,","+    };","+    drop(nv);","+    let mut nvr = NODE_VECTOR_ROOT.lock().unwrap();","+    if let Some(rvec) = nvr.as_mut() {","+        crate::vector::vector_push(rvec, &bytes);","+    }","+}","+"," /// Pushes a node onto node_vector."," pub fn node_push(node: &Node) {","     let mut nodes = NODES.lock().unwrap();"]}],"userModified":false,"replaceAll":false}}
