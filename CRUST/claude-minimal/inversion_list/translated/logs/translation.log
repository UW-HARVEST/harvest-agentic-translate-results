lement(\n        &[1, 2, 3, 5, 7, 8, 9, 2, 19, 0],\n        20,\n        11,\n        &[(4, 5), (6, 7), (10, 19)],\n    );\n\n    println!(\"test_complement passed.\");\n}\nfn main() {} // This is the entry point for the binary\n","numLines":56,"startLine":1,"totalLines":56}}}
