5 |\n142\t    | 4 3 2 | 6 5 4 | 2 1 0 | 0 7 6 |\n143\t    + - - - + - - - + - - - + - - - +\n144\t            | 4 5 6 |\n145\t            | 3 Y 7 |\n146\t            | 2 1 0 |\n147\t            + - - - +\n148\t  */\n149\t  color g = top[face];\n150\t  color w = adjacent_cw(face, g);\n151\t  color y = adjacent_cw(face, w);\n152\t  color b = adjacent_cw(face, y);\n153\t  color temp;\n154\t  if(direction == CW)\n155\t  {\n156\t    // Swap G's (0,7,6) with W's (4,3,2)\n157\t    SWAP_COLOR(cube[g][0], cube[w][4]);\n158\t    SWAP_COLOR(cube[g][7], cube[w][3]);\n159\t    SWAP_COLOR(cube[g][6], cube[w][2]);\n160\t    /*\n161\t    do\n162\t    {\n163\t      color temp = cube[g][6];\n164\t      cube[g][6] = cube[w][2];\n165\t      cube[w][2] = temp;\n166\t    } while(0);\n167\t    */\n168\t    // Swap B's (2,1,0) with G's (0,7,6)\n169\t    SWAP_COLOR(cube[b][2], cube[g][0]);\n170\t    SWAP_COLOR(cube[b][1], cube[g][7]);\n171\t    SWAP_COLOR(cube[b][0], cube[g][6]);\n172\t    \n173\t    // Swap Y's (6,5,4) with B's (2,1,0)\n174\t    SWAP_COLOR(cube[y][6], cube[b][2]);\n175\t    SWAP_COLOR(cube[y][5], cube[b][1]);\n176\t    SWAP_COLOR(cube[y][4], cube[b][0]);\n177\t    \n178\t    // Rotating R's face CW\n179\t    temp = cube[face][0];\n180\t    cube[face][0] = cube[face][6];\n181\t    cube[face][6] = cube[face][4];\n182\t    cube[face][4] = cube[face][2];\n183\t    cube[face][2] = temp;\n184\t    temp = cube[face][1];\n185\t    cube[face][1] = cube[face][7];\n186\t    cube[face][7] = cube[face][5];\n187\t    cube[face][5] = cube[face][3];\n188\t    cube[face][3] = temp;\n189\t  }\n190\t  else// if(dir == CCW)\n191\t  {\n192\t    // Swap G's (0,7,6) with B's (2,1,0)\n193\t    SWAP_COLOR(cube[g][0], cube[b][2]);\n194\t    SWAP_COLOR(cube[g][7], cube[b][1]);\n195\t    SWAP_COLOR(cube[g][6], cube[b][0]);\n196\t    \n197\t    // Swap W's (4,3,2) with G's (0,7,6)\n198\t    SWAP_COLOR(cube[w][4], cube[g][0]);\n199\t    SWAP_COLOR(cube[w][3], cube[g][7]);\n200\t    SWAP_COLOR(cube[w][2