    assert_eq!(owned_ustr.byte_len, expected.len());\n179\t    assert_eq!(owned_ustr.str, expected);\n180\t    free_owned_utf8_string(&mut owned_ustr.clone());\n181\t}\n182\t\n183\t#[test]\n184\tfn test_make_utf8_string_slice_ok() {\n185\t    let s = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\".as_bytes());\n186\t    let slice = slice_utf8_string(s, 6, 24);\n187\t    assert_eq!(slice.byte_len, 12 * 2);\n188\t    assert_eq!(&slice.str[..slice.byte_len], \"Здравствуйте\");\n189\t}\n190\t\n191\t#[test]\n192\tfn test_make_utf8_string_slice_start_out_of_bounds_ok() {\n193\t    let s = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\".as_bytes());\n194\t    let slice = slice_utf8_string(s, 1000, 1);\n195\t    assert_eq!(slice.byte_len, 0);\n196\t    assert_eq!(slice.str, \"\");\n197\t}\n198\t\n199\t#[test]\n200\tfn test_make_utf8_string_slice_end_out_of_bounds_ok() {\n201\t    let s = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\".as_bytes());\n202\t    let slice = slice_utf8_string(s, 6, 1000);\n203\t    assert_eq!(slice.byte_len, 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n204\t    assert_eq!(&slice.str[..slice.byte_len], \"Здравствуйте こんにちは 🚩😁\");\n205\t}\n206\t\n207\t#[test]\n208\tfn test_make_utf8_string_slice_start_non_boundary_err() {\n209\t    let s = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\".as_bytes());\n210\t    let slice = slice_utf8_string(s, 7, 3);\n211\t    assert_eq!(slice.str, \"\");\n212\t    assert_eq!(slice.byte_len, 0);\n213\t}\n214\t\n215\t#[test]\n216\tfn test_make_utf8_string_slice_end_non_boundary_err() {\n217\t    let s = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\".as_bytes());\n218\t    let slice = slice_utf8_string(s, 6, 3);\n219\t    assert_eq!(slice.str, \"\");\n220\t    assert_eq!(slice.byte_len, 0);\n221\t}\n222\t\n223\t#[test]\n224\tfn test_utf8_char_iter() {\n225\t    let s = make_utf8_string(\"Hдこ😁\".as_bytes());\n226\t    let mut iter = make_utf8_char_iter(s);\n227\t    let mut ch = next_utf8_char(&mut iter);\n228\t    assert_eq