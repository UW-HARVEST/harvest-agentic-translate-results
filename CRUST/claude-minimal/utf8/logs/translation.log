id test_surrogate_rejection() {\n58\t  utf8_validity validity;\n59\t\n60\t  validity = validate_utf8(\"\\xED\\xA0\\x80\");\n61\t  assert(validity.valid == false);\n62\t  assert(validity.valid_upto == 0);\n63\t\n64\t  validity = validate_utf8(\"\\xED\\xAC\\x80\");\n65\t  assert(validity.valid == false);\n66\t  assert(validity.valid_upto == 0);\n67\t\n68\t  validity = validate_utf8(\"\\xED\\xA0\\x8C\");\n69\t  assert(validity.valid == false);\n70\t  assert(validity.valid_upto == 0);\n71\t\n72\t  validity = validate_utf8(\"\\xED\\xBF\\xBF\");\n73\t  assert(validity.valid == false);\n74\t  assert(validity.valid_upto == 0);\n75\t}\n76\t\n77\tvoid test_validate_utf8_err() {\n78\t  utf8_validity validity = validate_utf8(\"Hello Здравствуйте\\xC0\\xC0 こんにちは 🚩😁\");\n79\t  assert(validity.valid == false);\n80\t  assert(validity.valid_upto == 5 + 1 + 12 * 2);\n81\t}\n82\t\n83\tvoid assert_overlong_encodings(utf8_char actual, utf8_char overlong) {\n84\t  assert(unicode_code_point(actual) == unicode_code_point(overlong));\n85\t\n86\t  utf8_validity validity;\n87\t\n88\t  validity = validate_utf8(actual.str);\n89\t  assert(validity.valid == true);\n90\t  assert(validity.valid_upto == actual.byte_len);\n91\t\n92\t  validity = validate_utf8(overlong.str);\n93\t  assert(validity.valid == false);\n94\t  assert(validity.valid_upto == 0);\n95\t}\n96\t\n97\tvoid test_validate_utf8_overlong_encoding_err() {\n98\t  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xC1\\x88\", .byte_len = 2 });\n99\t  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xE0\\x81\\x88\", .byte_len = 3 });\n100\t  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xF0\\x80\\x81\\x88\", .byte_len = 4 });\n101\t\n102\t  assert_overlong_encodings((utf8_char) { .str = \"д\", .byte_len = 2 }, (utf8_char) { .str = \"\\xE0\\x90\\xB4\", .byte_len = 3 });\n103\t  assert_overlong_encodings((utf8_char) { .str = \"д\", .byte_len = 2 }, (utf8_char) { .str = \"\\xF0\\x80\\x90\\xB4\", .byte_len = 4 });\n104\t\n105\t  assert_overlong_encodings((utf8_char) { .str = \"こ\", .byte_len = 3 }, (utf8_char) { .str = \"\\xF0\\x83\\x81\\x93\", .byte_len = 4 });\n106\t\n107\t  // boundary characters\n108\t  assert_overlong_encodings((utf8_char) { .str = \"\\x7F\", .byte_len = 1 }, (utf8_char) { .str = \"\\xC1\\xBF\", .byte_len = 2 }); // last 1b, last 1b overlong\n109\t  assert_overlong_encodings((utf8_char) { .str = \"\\xDF\\xBF\", .byte_len = 2 }, (utf8_char) { .str = \"\\xE0\\x9F\\xBF\", .byte_len = 3 }); // last 2b, last 2b overlong\n110\t  assert_overlong_encodings((utf8_char) { .str = \"\\xEF\\xBF\\xBF\", .byte_len = 3 }, (utf8_char) { .str = \"\\xF0\\x8F\\xBF\\xBF\", .byte_len = 4 }); // last 3b, last 3b overlong\n111\t}\n112\t\n113\tvoid test_make_utf8_string_ok() {\n114\t  const char* str = \"Hello Здравствуйте こんにちは 🚩😁\";\n115\t  utf8_string ustr = make_utf8_string(str);\n116\t  assert(ustr.byte_len == 5 + 1 + 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n117\t  assert(strcmp(ustr.str, str) == 0);\n118\t}\n119\t\n120\tvoid test_make_utf8_string_err() {\n121\t  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте\\xC0\\xC0 こんにちは 🚩😁\");\n122\t  assert(ustr.str == NULL);\n123\t  assert(ustr.byte_len == 0);\n124\t}\n125\t\n126\tvoid test_make_utf8_string_lossy_ok() {\n127\t    const char* str = \"Hello Здравствуйте こんにちは 🚩😁\";\n128\t    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n129\t    assert(owned_ustr.byte_len == 5 + 1 + 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n130\t    assert(strcmp(owned_ustr.str, str) == 0);\n131\t    free_owned_utf8_string(&owned_ustr);\n132\t}\n133\t\n134\tvoid test_make_utf8_string_lossy_invalid_sequence() {\n135\t    const char* str = \"\\xC0He\\xC0llo Здр\\xC0авствуйте\\xC0\\xC0 こんに\\xC0\\xC0\\xC0\\xC0ちは 🚩\\xC0😁\\xC0\";\n136\t    const char* expected = \"�He�llo Здр�авствуйте�� こんに����ちは 🚩�😁�\";\n137\t\n138\t    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n139\t\n140\t    assert(owned_ustr.byte_len == strlen(expected));\n141\t    assert(strcmp(owned_ustr.str, expected) == 0);\n142\t    free_owned_utf8_string(&owned_ustr);\n143\t}\n144\t\n145\tvoid test_make_utf8_string_lossy_completely_invalid() {\n146\t    const char* str = \"\\xC0\\xC0\\xC0\\xC0\";\n147\t    const char* expected = \"����\";\n148\t\n149\t    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n150\t\n151\t    assert(owned_ustr.byte_len == strlen(expected));\n152\t    assert(strcmp(owned_ustr.str, expected) == 0);\n153\t    free_owned_utf8_string(&owned_ustr);\n154\t}\n155\t\n156\tvoid test_make_utf8_string_slice_ok() {\n157\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n158\t  utf8_string slice = slice_utf8_string(str, 6, 24);\n159\t  assert(slice.byte_len == 12 * 2);\n160\t  assert(strncmp(slice.str, \"Здравствуйте\", slice.byte_len) == 0);\n161\t}\n162\t\n163\tvoid test_make_utf8_string_slice_start_out_of_bounds_ok() {\n164\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n165\t  utf8_string slice = slice_utf8_string(str, 1000, 1);\n166\t  assert(slice.byte_len == 0);\n167\t  assert(strcmp(slice.str, \"\") == 0);\n168\t}\n169\t\n170\tvoid test_make_utf8_string_slice_end_out_of_bounds_ok() {\n171\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n172\t  utf8_string slice = slice_utf8_string(str, 6, 1000);\n173\t  assert(slice.byte_len == 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n174\t  assert(strncmp(slice.str, \"Здравствуйте こんにちは 🚩😁\", slice.byte_len) == 0);\n175\t}\n176\t\n177\tvoid test_make_utf8_string_slice_start_non_boundary_err() {\n178\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n179\t  utf8_string slice = slice_utf8_string(str, 7, 3);\n180\t  assert(slice.str == NULL);\n181\t  assert(slice.byte_len == 0);\n182\t}\n183\t\n184\tvoid test_make_utf8_string_slice_end_non_boundary_err() {\n185\t  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n186\t  utf8_string slice = slice_utf8_string(str, 6, 3);\n187\t  assert(slice.str == NULL);\n188\t  assert(slice.byte_len == 0);\n189\t}\n190\t\n191\tvoid test_utf8_char_iter() {\n192\t  utf8_string str = make_utf8_string(\"Hдこ😁\");\n193\t  utf8_char_iter iter = make_utf8_char_iter(str);\n194\t\n195\t  utf8_char ch;\n196\t\n197\t  ch = next_utf8_char(&iter);\n198\t  assert(ch.byte_len == 1);\n199\t  assert(strncmp(ch.str, \"H\", ch.byte_len) == 0);\n200\t\n201\t  ch = next_utf8_char(&iter);\n202\t  assert(ch.byte_len == 2);\n203\t  assert(strncmp(ch.str, \"д\", ch.byte_len) == 0);\n204\t\n205\t  ch = next_utf8_char(&iter);\n206\t  assert(ch.byte_len == 3);\n207\t  assert(strncmp(ch.str, \"こ\", ch.byte_len) == 0);\n208\t\n209\t  ch = next_utf8_char(&iter);\n210\t  assert(ch.byte_len == 4);\n211\t  assert(strncmp(ch.str, \"😁\", ch.byte_len) == 0);\n212\t\n213\t  // iterator keeps returning { .str = '\\0', .byte_len = 0 } when exhausted\n214\t  ch = next_utf8_char(&iter);\n215\t  assert(ch.byte_len == 0);\n216\t  assert(strcmp(ch.str, \"\") == 0);\n217\t\n218\t  ch = next_utf8_char(&iter);\n219\t  assert(ch.byte_len == 0);\n220\t  assert(strcmp(ch.str, \"\") == 0);\n221\t}\n222\t\n223\tvoid test_utf8_char_count_zero() {\n224\t  utf8_string ustr = make_utf8_string(\"\");\n225\t  size_t count = utf8_char_count(ustr);\n226\t  assert(count == 0);\n227\t}\n228\t\n229\tvoid test_utf8_char_count() {\n230\t  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n231\t  size_t count = utf8_char_count(ustr);\n232\t  assert(count == 5 + 1 + 12 + 1 + 5 + 1 + 2);\n233\t}\n234\t\n235\tvoid test_is_utf8_char_boundary() {\n236\t  const char* str = \"Hдこ😁\";\n237\t  assert(is_utf8_char_boundary(str)); //    H\n238\t\n239\t  assert(is_utf8_char_boundary(++str)); //  д\n240\t  assert(!is_utf8_char_boundary(++str));\n241\t\n242\t  assert(is_utf8_char_boundary(++str)); //  こ\n243\t  assert(!is_utf8_char_boundary(++str));\n244\t  assert(!is_utf8_char_boundary(++str));\n245\t\n246\t  assert(is_utf8_char_boundary(++str)); //  😁\n247\t  assert(!is_utf8_char_boundary(++str));\n248\t  assert(!is_utf8_char_boundary(++str));\n249\t  assert(!is_utf8_char_boundary(++str));\n250\t\n251\t  assert(strcmp(++str, \"\") == 0);\n252\t}\n253\t\n254\tvoid test_nth_utf8_char_valid_index_ok() {\n255\t  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n256\t  utf8_char ch = nth_utf8_char(ustr, 20);\n257\t  assert(ch.byte_len == 3);\n258\t  assert(strncmp(ch.str, \"ん\", ch.byte_len) == 0);\n259\t}\n260\t\n261\tvoid test_nth_utf8_char_first_index_ok() {\n262\t  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n263\t  utf8_char ch = nth_utf8_char(ustr, 0);\n264\t  assert(ch.byte_len == 1);\n265\t  assert(*ch.str == 'H');\n266\t}\n267\t\n268\tvoid test_nth_utf8_char_last_index_ok() {\n269\t  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n270\t  utf8_char ch = nth_utf8_char(ustr, 26);\n271\t  assert(ch.byte_len == 4);\n272\t  assert(strncmp(ch.str, \"😁\", ch.byte_len) == 0);\n273\t}\n274\t\n275\tvoid test_nth_utf8_char_invalid_index_err() {\n276\t  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n277\t  utf8_char ch = nth_utf8_char(ustr, 100);\n278\t  assert(ch.str == NULL);\n279\t  assert(ch.byte_len == 0);\n280\t}\n281\t\n282\tvoid test_nth_utf8_char_empty_string_err() {\n283\t  utf8_string ustr = make_utf8_string(\"\");\n284\t  utf8_char ch = nth_utf8_char(ustr, 0);\n285\t  assert(ch.str == NULL);\n286\t  assert(ch.byte_len == 0);\n287\t}\n288\t\n289\tvoid test_unicode_code_point() {\n290\t  utf8_string ustr = make_utf8_string(\"Hдこ😁\");\n291\t  utf8_char_iter iter = make_utf8_char_iter(ustr);\n292\t\n293\t  assert(unicode_code_point(next_utf8_char(&iter)) == 72); // H\n294\t  assert(unicode_code_point(next_utf8_char(&iter)) == 1076); // д\n295\t  assert(unicode_code_point(next_utf8_char(&iter)) == 12371); // こ\n296\t  assert(unicode_code_point(next_utf8_char(&iter)) == 128513); // 😁\n297\t}\n298\t\n299\tint ntests = 0;\n300\t#define TEST(test_fn) test_fn(); ntests++; printf(\"%s\\n\", #test_fn);\n301\t\n302\tint main() {\n303\t  TEST(test_validate_utf8_ok);\n304\t  TEST(test_validate_utf8_boundary_ok);\n305\t  TEST(test_surrogate_rejection);\n306\t  TEST(test_validate_utf8_err);\n307\t  TEST(test_validate_utf8_overlong_encoding_err);\n308\t  TEST(test_make_utf8_string_ok);\n309\t  TEST(test_make_utf8_string_err);\n310\t  TEST(test_make_utf8_string_lossy_ok);\n311\t  TEST(test_make_utf8_string_lossy_invalid_sequence);\n312\t  TEST(test_make_utf8_string_lossy_completely_invalid);\n313\t  TEST(test_make_utf8_string_slice_ok);\n314\t  TEST(test_make_utf8_string_slice_start_out_of_bounds_ok);\n315\t  TEST(test_make_utf8_string_slice_end_out_of_bounds_ok);\n316\t  TEST(test_make_utf8_string_slice_start_non_boundary_err);\n317\t  TEST(test_make_utf8_string_slice_end_non_boundary_err);\n318\t  TEST(test_utf8_char_iter);\n319\t  TEST(test_utf8_char_count_zero);\n320\t  TEST(test_utf8_char_count);\n321\t  TEST(test_is_utf8_char_boundary);\n322\t  TEST(test_nth_utf8_char_valid_index_ok);\n323\t  TEST(test_nth_utf8_char_first_index_ok);\n324\t  TEST(test_nth_utf8_char_last_index_ok);\n325\t  TEST(test_nth_utf8_char_invalid_index_err);\n326\t  TEST(test_nth_utf8_char_empty_string_err);\n327\t  TEST(test_unicode_code_point);\n328\t\n329\t  printf(\"\\n** %d tests passed **\\n\", ntests);\n330\t  return 0;\n331\t}\n332\t"}]},"parent_tool_use_id":null,"session_id":"bc31466f-12dc-42ce-8cba-6333660d95c7","uuid":"d54e7f18-d04c-4297-bdd6-67e841489811","timestamp":"2026-06-02T00:32:41.296Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-uSzset/project/c_src/tests/test.c","content":"#include \"../src/utf8.h\"\n\n#include <assert.h>\n#include <stdio.h>\n#include <string.h>\n\n// english characters are 1 byte each\n// russian  2 bytes each\n// japanese 3 bytes each\n// 🚩 and 😁 is 4 bytes each\n\nvoid test_validate_utf8_ok() {\n  utf8_validity validity = validate_utf8(\"Hello Здравствуйте こんにちは 🚩😁\");\n  assert(validity.valid == true);\n  assert(validity.valid_upto == 5 + 1 + 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n}\n\nvoid test_validate_utf8_boundary_ok() {\n  utf8_validity validity;\n\n  // last 1b -> 0(1111111)\n  validity = validate_utf8(\"\\x7F\");\n  assert(validity.valid);\n  assert(validity.valid_upto == 1);\n\n  // first 2b -> 110(00010) 10(000000)\n  validity = validate_utf8(\"\\xC2\\x80\");\n  assert(validity.valid);\n  assert(validity.valid_upto == 2);\n\n  // last 2b -> 110(11111) 10(111111)\n  validity = validate_utf8(\"\\xDF\\xBF\");\n  assert(validity.valid);\n  assert(validity.valid_upto == 2);\n\n  // first 3b -> 1110(0000) 10(100000) 10(000000)\n  validity = validate_utf8(\"\\xE0\\xA0\\x80\");\n  assert(validity.valid);\n  assert(validity.valid_upto == 3);\n\n  // last 3b -> 1110(1111) 10(111111) 10(111111)\n  validity = validate_utf8(\"\\xEF\\xBF\\xBF\");\n  assert(validity.valid);\n  assert(validity.valid_upto == 3);\n\n  // first 4b -> 11110(000) 10(010000) 10(000000) 10(000000)\n  validity = validate_utf8(\"\\xF0\\x90\\x80\\x80\");\n  assert(validity.valid);\n  assert(validity.valid_upto == 4);\n\n  // last 4b -> 11110(111) 10(111111) 10(111111) 10(111111)\n  validity = validate_utf8(\"\\xF7\\xBF\\xBF\\xBF\");\n  assert(validity.valid);\n  assert(validity.valid_upto == 4);\n}\n\nvoid test_surrogate_rejection() {\n  utf8_validity validity;\n\n  validity = validate_utf8(\"\\xED\\xA0\\x80\");\n  assert(validity.valid == false);\n  assert(validity.valid_upto == 0);\n\n  validity = validate_utf8(\"\\xED\\xAC\\x80\");\n  assert(validity.valid == false);\n  assert(validity.valid_upto == 0);\n\n  validity = validate_utf8(\"\\xED\\xA0\\x8C\");\n  assert(validity.valid == false);\n  assert(validity.valid_upto == 0);\n\n  validity = validate_utf8(\"\\xED\\xBF\\xBF\");\n  assert(validity.valid == false);\n  assert(validity.valid_upto == 0);\n}\n\nvoid test_validate_utf8_err() {\n  utf8_validity validity = validate_utf8(\"Hello Здравствуйте\\xC0\\xC0 こんにちは 🚩😁\");\n  assert(validity.valid == false);\n  assert(validity.valid_upto == 5 + 1 + 12 * 2);\n}\n\nvoid assert_overlong_encodings(utf8_char actual, utf8_char overlong) {\n  assert(unicode_code_point(actual) == unicode_code_point(overlong));\n\n  utf8_validity validity;\n\n  validity = validate_utf8(actual.str);\n  assert(validity.valid == true);\n  assert(validity.valid_upto == actual.byte_len);\n\n  validity = validate_utf8(overlong.str);\n  assert(validity.valid == false);\n  assert(validity.valid_upto == 0);\n}\n\nvoid test_validate_utf8_overlong_encoding_err() {\n  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xC1\\x88\", .byte_len = 2 });\n  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xE0\\x81\\x88\", .byte_len = 3 });\n  assert_overlong_encodings((utf8_char) { .str = \"H\", .byte_len = 1 }, (utf8_char) { .str = \"\\xF0\\x80\\x81\\x88\", .byte_len = 4 });\n\n  assert_overlong_encodings((utf8_char) { .str = \"д\", .byte_len = 2 }, (utf8_char) { .str = \"\\xE0\\x90\\xB4\", .byte_len = 3 });\n  assert_overlong_encodings((utf8_char) { .str = \"д\", .byte_len = 2 }, (utf8_char) { .str = \"\\xF0\\x80\\x90\\xB4\", .byte_len = 4 });\n\n  assert_overlong_encodings((utf8_char) { .str = \"こ\", .byte_len = 3 }, (utf8_char) { .str = \"\\xF0\\x83\\x81\\x93\", .byte_len = 4 });\n\n  // boundary characters\n  assert_overlong_encodings((utf8_char) { .str = \"\\x7F\", .byte_len = 1 }, (utf8_char) { .str = \"\\xC1\\xBF\", .byte_len = 2 }); // last 1b, last 1b overlong\n  assert_overlong_encodings((utf8_char) { .str = \"\\xDF\\xBF\", .byte_len = 2 }, (utf8_char) { .str = \"\\xE0\\x9F\\xBF\", .byte_len = 3 }); // last 2b, last 2b overlong\n  assert_overlong_encodings((utf8_char) { .str = \"\\xEF\\xBF\\xBF\", .byte_len = 3 }, (utf8_char) { .str = \"\\xF0\\x8F\\xBF\\xBF\", .byte_len = 4 }); // last 3b, last 3b overlong\n}\n\nvoid test_make_utf8_string_ok() {\n  const char* str = \"Hello Здравствуйте こんにちは 🚩😁\";\n  utf8_string ustr = make_utf8_string(str);\n  assert(ustr.byte_len == 5 + 1 + 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n  assert(strcmp(ustr.str, str) == 0);\n}\n\nvoid test_make_utf8_string_err() {\n  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте\\xC0\\xC0 こんにちは 🚩😁\");\n  assert(ustr.str == NULL);\n  assert(ustr.byte_len == 0);\n}\n\nvoid test_make_utf8_string_lossy_ok() {\n    const char* str = \"Hello Здравствуйте こんにちは 🚩😁\";\n    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n    assert(owned_ustr.byte_len == 5 + 1 + 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n    assert(strcmp(owned_ustr.str, str) == 0);\n    free_owned_utf8_string(&owned_ustr);\n}\n\nvoid test_make_utf8_string_lossy_invalid_sequence() {\n    const char* str = \"\\xC0He\\xC0llo Здр\\xC0авствуйте\\xC0\\xC0 こんに\\xC0\\xC0\\xC0\\xC0ちは 🚩\\xC0😁\\xC0\";\n    const char* expected = \"�He�llo Здр�авствуйте�� こんに����ちは 🚩�😁�\";\n\n    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n\n    assert(owned_ustr.byte_len == strlen(expected));\n    assert(strcmp(owned_ustr.str, expected) == 0);\n    free_owned_utf8_string(&owned_ustr);\n}\n\nvoid test_make_utf8_string_lossy_completely_invalid() {\n    const char* str = \"\\xC0\\xC0\\xC0\\xC0\";\n    const char* expected = \"����\";\n\n    owned_utf8_string owned_ustr = make_utf8_string_lossy(str);\n\n    assert(owned_ustr.byte_len == strlen(expected));\n    assert(strcmp(owned_ustr.str, expected) == 0);\n    free_owned_utf8_string(&owned_ustr);\n}\n\nvoid test_make_utf8_string_slice_ok() {\n  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_string slice = slice_utf8_string(str, 6, 24);\n  assert(slice.byte_len == 12 * 2);\n  assert(strncmp(slice.str, \"Здравствуйте\", slice.byte_len) == 0);\n}\n\nvoid test_make_utf8_string_slice_start_out_of_bounds_ok() {\n  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_string slice = slice_utf8_string(str, 1000, 1);\n  assert(slice.byte_len == 0);\n  assert(strcmp(slice.str, \"\") == 0);\n}\n\nvoid test_make_utf8_string_slice_end_out_of_bounds_ok() {\n  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_string slice = slice_utf8_string(str, 6, 1000);\n  assert(slice.byte_len == 12 * 2 + 1 + 5 * 3 + 1 + 2 * 4);\n  assert(strncmp(slice.str, \"Здравствуйте こんにちは 🚩😁\", slice.byte_len) == 0);\n}\n\nvoid test_make_utf8_string_slice_start_non_boundary_err() {\n  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_string slice = slice_utf8_string(str, 7, 3);\n  assert(slice.str == NULL);\n  assert(slice.byte_len == 0);\n}\n\nvoid test_make_utf8_string_slice_end_non_boundary_err() {\n  utf8_string str = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_string slice = slice_utf8_string(str, 6, 3);\n  assert(slice.str == NULL);\n  assert(slice.byte_len == 0);\n}\n\nvoid test_utf8_char_iter() {\n  utf8_string str = make_utf8_string(\"Hдこ😁\");\n  utf8_char_iter iter = make_utf8_char_iter(str);\n\n  utf8_char ch;\n\n  ch = next_utf8_char(&iter);\n  assert(ch.byte_len == 1);\n  assert(strncmp(ch.str, \"H\", ch.byte_len) == 0);\n\n  ch = next_utf8_char(&iter);\n  assert(ch.byte_len == 2);\n  assert(strncmp(ch.str, \"д\", ch.byte_len) == 0);\n\n  ch = next_utf8_char(&iter);\n  assert(ch.byte_len == 3);\n  assert(strncmp(ch.str, \"こ\", ch.byte_len) == 0);\n\n  ch = next_utf8_char(&iter);\n  assert(ch.byte_len == 4);\n  assert(strncmp(ch.str, \"😁\", ch.byte_len) == 0);\n\n  // iterator keeps returning { .str = '\\0', .byte_len = 0 } when exhausted\n  ch = next_utf8_char(&iter);\n  assert(ch.byte_len == 0);\n  assert(strcmp(ch.str, \"\") == 0);\n\n  ch = next_utf8_char(&iter);\n  assert(ch.byte_len == 0);\n  assert(strcmp(ch.str, \"\") == 0);\n}\n\nvoid test_utf8_char_count_zero() {\n  utf8_string ustr = make_utf8_string(\"\");\n  size_t count = utf8_char_count(ustr);\n  assert(count == 0);\n}\n\nvoid test_utf8_char_count() {\n  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  size_t count = utf8_char_count(ustr);\n  assert(count == 5 + 1 + 12 + 1 + 5 + 1 + 2);\n}\n\nvoid test_is_utf8_char_boundary() {\n  const char* str = \"Hдこ😁\";\n  assert(is_utf8_char_boundary(str)); //    H\n\n  assert(is_utf8_char_boundary(++str)); //  д\n  assert(!is_utf8_char_boundary(++str));\n\n  assert(is_utf8_char_boundary(++str)); //  こ\n  assert(!is_utf8_char_boundary(++str));\n  assert(!is_utf8_char_boundary(++str));\n\n  assert(is_utf8_char_boundary(++str)); //  😁\n  assert(!is_utf8_char_boundary(++str));\n  assert(!is_utf8_char_boundary(++str));\n  assert(!is_utf8_char_boundary(++str));\n\n  assert(strcmp(++str, \"\") == 0);\n}\n\nvoid test_nth_utf8_char_valid_index_ok() {\n  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_char ch = nth_utf8_char(ustr, 20);\n  assert(ch.byte_len == 3);\n  assert(strncmp(ch.str, \"ん\", ch.byte_len) == 0);\n}\n\nvoid test_nth_utf8_char_first_index_ok() {\n  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_char ch = nth_utf8_char(ustr, 0);\n  assert(ch.byte_len == 1);\n  assert(*ch.str == 'H');\n}\n\nvoid test_nth_utf8_char_last_index_ok() {\n  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_char ch = nth_utf8_char(ustr, 26);\n  assert(ch.byte_len == 4);\n  assert(strncmp(ch.str, \"😁\", ch.byte_len) == 0);\n}\n\nvoid test_nth_utf8_char_invalid_index_err() {\n  utf8_string ustr = make_utf8_string(\"Hello Здравствуйте こんにちは 🚩😁\");\n  utf8_char ch = nth_utf8_char(ustr, 100);\n  assert(ch.str == NULL);\n  assert(ch.byte_len == 0);\n}\n\nvoid test_nth_utf8_char_empty_string_err() {\n  utf8_string ustr = make_utf8_string(\"\");\n  utf8_char ch = nth_utf8_char(ustr, 0);\n  assert(ch.str == NULL);\n  assert(ch.byte_len == 0);\n}\n\nvoid test_unicode_code_point() {\n  utf8_string ustr = make_utf8_string(\"Hдこ😁\");\n  utf8_char_iter iter = make_utf8_char_iter(ustr);\n\n  assert(unicode_code_point(next_utf8_char(&iter)) == 72); // H\n  assert(unicode_code_point(next_utf8_char(&iter)) == 1076); // д\n  assert(unicode_code_point(next_utf8_char(&iter)) == 12371); // こ\n  assert(unicode_code_point(next_utf8_char(&iter)) == 128513); // 😁\n}\n\nint ntests = 0;\n#define TEST(test_fn) test_fn(); ntests++; printf(\"%s\\n\", #test_fn);\n\nint main() {\n  TEST(test_validate_utf8_ok);\n  TEST(test_validate_utf8_boundary_ok);\n  TEST(test_surrogate_rejection);\n  TEST(test_validate_utf8_err);\n  TEST(test_validate_utf8_overlong_encoding_err);\n  TEST(test_make_utf8_string_ok);\n  TEST(test_make_utf8_string_err);\n  TEST(test_make_utf8_string_lossy_ok);\n  TEST(test_make_utf8_string_lossy_invalid_sequence);\n  TEST(test_make_utf8_string_lossy_completely_invalid);\n  TEST(test_make_utf8_string_slice_ok);\n  TEST(test_make_utf8_string_slice_start_out_of_bounds_ok);\n  TEST(test_make_utf8_string_slice_end_out_of_bounds_ok);\n  TEST(test_make_utf8_string_slice_start_non_boundary_err);\n  TEST(test_make_utf8_string_slice_end_non_boundary_err);\n  TEST(test_utf8_char_iter);\n  TEST(test_utf8_char_count_zero);\n  TEST(test_utf8_char_count);\n  TEST(test_is_utf8_char_boundary);\n  TEST(test_nth_utf8_char_valid_index_ok);\n  TEST(test_nth_utf8_char_first_index_ok);\n  TEST(test_nth_utf8_char_last_index_ok);\n  TEST(test_nth_utf8_char_invalid_index_err);\n  TEST(test_nth_utf8_char_empty_string_err);\n  TEST(test_unicode_code_point);\n\n  printf(\"\\n** %d tests passed **\\n\", ntests);\n  return 0;\n}\n","numLines":332,"startLine":1,"totalLines":332}}}
