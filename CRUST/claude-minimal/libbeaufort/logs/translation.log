alpha = BEAUFORT_ALPHA;\n  }\n\n  mat = beaufort_tableau(alpha);\n\n  if (NULL == key) {\n    fprintf(stderr, \"error: Expecting cipher key\\n\");\n    usage();\n    return 1;\n  }\n\n#define OP(name) {                               \\\n  buf = read_stdin();                            \\\n  if (NULL == buf) { return 1; }                 \\\n  out = beaufort_ ## name(buf, key, mat);        \\\n  printf(\"%s\\n\", out);                           \\\n  do {                                           \\\n    buf = read_stdin();                          \\\n    if (NULL == buf) { break; }                  \\\n    out = beaufort_ ## name(buf, key, mat);      \\\n    printf(\"%s\\n\", out);                         \\\n  } while (NULL != buf);                         \\\n}\n\nswitch (op) {\n  case ENCRYPT_OP:\n    if (1 == isatty(0)) { return 1; }\n    else if (ferror(stdin)) { return 1; }\n    else { OP(encrypt); }\n    return 0;\n\n  case DECRYPT_OP:\n    if (1 == isatty(0)) { return 1; }\n    else if (ferror(stdin)) { return 1; }\n    else { OP(decrypt); }\n    return 0;\n\n  case NO_OP:\n  default:\n    return usage(), 1;\n}\n\n#undef OP\nreturn 0;\n}\n","numLines":178,"startLine":1,"totalLines":178}}}
