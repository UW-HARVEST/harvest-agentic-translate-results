happens automatically when size >\n// capacity)\nvoid double_cap(struct Hashmap *h);\n\nint test_hash_init();\nint test_hash_init_and_store();\nint test_hash_set_and_get();\nint test_hash_set_and_double_get();\n","numLines":33,"startLine":1,"totalLines":33}}}
