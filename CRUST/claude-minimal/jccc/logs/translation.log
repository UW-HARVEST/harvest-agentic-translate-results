, lex::test_ttype_one_char\n36\t//       - list::{create_list, ladd_element, lget_element, destroy_list}\n37\t//       - hashmap::{test_hash_init, test_hash_init_and_store, test_hash_set_and_get, test_hash_set_and_double_get}\n38\t//\n39\t// 8) We also replicate the test “setup” and “cleanup” prints, corresponding to testing_module_setup()\n40\t//    and testing_module_cleanup(). In C, these were macros that print a message; in Rust, we'll\n41\t//    define simple helper functions.\n42\t//\n43\t// 9) We place all of these tests into a single Rust file test_main.rs (enclosed here) with the\n44\t//    required “use jccc::filename;” format, strictly converting the logic from C to Rust.\n45\t//\n46\t// 10) The resulting Rust code (below) compiles into an executable that runs the same test\n47\t//     sequence as the original C code.\n48\t//\n49\t// -----------------------------------------------------------------------------\n50\t\n51\tuse jccc::codegen;\n52\tuse jccc::lex::{ttype_many_chars, ttype_one_char, ttype_name, ttype_from_string};\n53\tuse jccc::token::TokenType;\n54\tuse jccc::list;\n55\tuse jccc::hashmap;\n56\t/// Tests initializing the Hashmap.\n57\tpub fn test_hash_init() -> i32 {\n58\tlet h = hashmap::create_hashmap(100);\n59\tassert_eq!(h.size, 0);\n60\tassert_eq!(h.cap, 100);\n61\t0\n62\t}\n63\t    \n64\t/// Tests initializing the Hashmap and storing a value.\n65\tpub fn test_hash_init_and_store() -> i32 {\n66\tlet mut h = hashmap::create_hashmap(100);\n67\tassert_eq!(h.size, 0);\n68\tassert_eq!(h.cap, 100);\n69\tlet name = \"jake\".to_string();\n70\tlet key = \"test\".to_string();\n71\t\n72\tlet ret = hashmap::hm_set(&mut h, &key, Box::new(name.clone()));\n73\tassert_ne!(ret, -1);\n74\t\n75\tlet ind = ((h.hash)(&key) % (h.cap as u32)) as usize;\n76\tlet b = h.buckets[ind].as_ref().unwrap();\n77\tassert_eq!(b.key, key);\n78\tassert_eq!(h.size, 1);\n79\tassert_eq!(h.cap, 100);\n80\t0\n81\t}\n82\t\n83\t/// Tests setting and then getting a value in the Hashmap.\n84\tpub fn test_hash_set_and_get() -> i32 {\n85\tlet mut h = hashmap::create_hashmap(100);\n86\tlet name = \"jake\".to_string();\n87\tlet key = \"test\".to_string();\n88\tlet ret = hashmap::hm_set(&mut h, &key, Box::new(name.clone()));\n89\tassert_ne!(ret, -1);\n90\t\n91\tlet got = hashmap::hm_get(&h, &key).unwrap();\n92\tif let Some(got_string) = got.value.downcast_ref::<String>() {\n93\tassert_eq!(got_string, \"jake\");\n94\t} else {\n95\tpanic!(\"Value was not a String, which is unexpected.\");\n96\t}\n97\t0\n98\t}\n99\t\n100\t/// Tests setting a key-value pair, doubling capacity, and then getting the value.\n101\tpub fn test_hash_set_and_double_get() -> i32 {\n102\tlet mut h = hashmap::create_hashmap(100);\n103\tlet name = \"jake\".to_string();\n104\tlet key = \"test\".to_string();\n105\tlet ret = hashmap::hm_set(&mut h, &key, Box::new(name.clone()));\n106\tassert_ne!(ret, -1);\n107\t\n108\t// Force capacity doubling.\n109\thashmap::double_cap(&mut h);\n110\t\n111\tlet got = hashmap::hm_get(&h, &key).unwrap();\n112\tif let Some(got_string) = got.value.downcast_ref::<String>() {\n113\tassert_eq!(got_string, \"jake\");\n114\t} else {\n115\tpanic!(\"Value was not a String after doubling capacity, which is unexpected.\");\n116\t}\n117\t0\n118\t}\n119\t\n120\t/// Tests for ttype_many_chars.\n121\tpub fn test_ttype_many_chars() -> i32 {\n122\tassert_eq!(ttype_many_chars(\"foo\"), TokenType::TT_IDENTIFIER);\n123\tassert_eq!(ttype_many_chars(\"struct\"), TokenType::TT_STRUCT);\n124\tassert_eq!(ttype_many_chars(\"while\"), TokenType::TT_WHILE);\n125\t0\n126\t}\n127\t\n128\t/// Tests for ttype_one_char.\n129\tpub fn test_ttype_one_char() -> i32 {\n130\tassert_eq!(ttype_one_char('a'), TokenType::TT_IDENTIFIER);\n131\tassert_eq!(ttype_one_char('1'), TokenType::TT_LITERAL);\n132\tassert_eq!(ttype_one_char('+'), TokenType::TT_PLUS);\n133\tassert_eq!(ttype_one_char('-'), TokenType::TT_MINUS);\n134\tassert_eq!(ttype_one_char('>'), TokenType::TT_GREATER);\n135\tassert_eq!(ttype_one_char('~'), TokenType::TT_BNOT);\n136\t0\n137\t}\n138\t\n139\t/// Tests for ttype_name.\n140\tpub fn test_ttype_name() -> i32 {\n141\tassert_eq!(ttype_name(TokenType::TT_LITERAL), \"literal\");\n142\tassert_eq!(ttype_name(TokenType::TT_PLUS), \"+\");\n143\tassert_eq!(ttype_name(TokenType::TT_SIZEOF), \"sizeof\");\n144\tassert_eq!(ttype_name(TokenType::TT_WHILE), \"while\");\n145\t0\n146\t}\n147\t\n148\t/// Tests for ttype_from_string.\n149\tpub fn test_ttype_from_string() -> i32 {\n150\tassert_eq!(ttype_from_string(\"+\"), TokenType::TT_PLUS);\n151\tassert_eq!(ttype_from_string(\"=\"), TokenType::TT_ASSIGN);\n152\tassert_eq!(ttype_from_string(\"1\"), TokenType::TT_LITERAL);\n153\tassert_eq!(ttype_from_string(\"1.2\"), TokenType::TT_LITERAL);\n154\tassert_eq!(ttype_from_string(\"1u\"), TokenType::TT_LITERAL);\n155\tassert_eq!(ttype_from_string(\"1.2f\"), TokenType::TT_LITERAL);\n156\tassert_eq!(ttype_from_string(\"1.f\"), TokenType::TT_LITERAL);\n157\tassert_eq!(ttype_from_string(\"\\\"Planck\\\"\"), TokenType::TT_LITERAL);\n158\tassert_eq!(ttype_from_string(\"'Language'\"), TokenType::TT_LITERAL);\n159\tassert_eq!(ttype_from_string(\"Jaba\"), TokenType::TT_IDENTIFIER);\n160\tassert_eq!(ttype_from_string(\"cat_\"), TokenType::TT_IDENTIFIER);\n161\tassert_eq!(ttype_from_string(\"(\"), TokenType::TT_OPAREN);\n162\tassert_eq!(ttype_from_string(\"}\"), TokenType::TT_CBRACE);\n163\tassert_eq!(ttype_from_string(\";\"), TokenType::TT_SEMI);\n164\t0\n165\t}\n166\t    \n167\t\n168\t// -----------------------------------------------------------------------------\n169\t// Helper print functions (in place of the original \"testing_*\" macros).\n170\tfn testing_setup_internal(func_name: &str) {\n171\tprintln!(\"Running tests from \\\"{}\\\" ...\", func_name);\n172\t}\n173\t\n174\tfn testing_cleanup_internal(func_name: &str) {\n175\tprintln!(\"Concluded tests from \\\"{}\\\"\", func_name);\n176\t}\n177\t\n178\tfn testing_single_test_internal(func_name: &str) {\n179\tprintln!(\"Running \\\"{}\\\"\", func_name);\n180\t}\n181\t\n182\t// -----------------------------------------------------------------------------\n183\t// test_x86: corresponds to the C test_x86()\n184\tpub fn test_x86() {\n185\ttesting_setup_internal(\"test_x86\");\n186\t// Calls to codegen tests\n187\tcodegen::test_init_int_literal();\n188\tcodegen::test_op_on_rax_with_rdi();\n189\ttesting_cleanup_internal(\"test_x86\");\n190\t\n191\t}\n192\t\n193\t// -----------------------------------------------------------------------------\n194\t// test_lexer: corresponds to the C test_lexer()\n195\t#[test]\n196\tpub fn test_lexer()  {\n197\ttesting_setup_internal(\"test_lexer\");\n198\t// Calls to lex tests\n199\ttest_ttype_name();\n200\ttest_ttype_from_string();\n201\ttest_ttype_many_chars();\n202\ttest_ttype_one_char();\n203\ttesting_cleanup_internal(\"test_lexer\");\n204\t}\n205\t\n206\t// -----------------------------------------------------------------------------\n207\t// basic_100_test: sub-test called by test_list\n208\t#[test]\n209\tfn basic_100_test() {\n210\ttesting_single_test_internal(\"basic_100_test\");\n211\tlet bs = 10;\n212\tlet ts = 100;\n213\tlet mut l = list::create_list(bs);\n214\t\n215\t// Add elements 0..ts\n216\tfor i in 0..ts {\n217\tlist::ladd_element(&mut l, Box::new(i));\n218\t}\n219\t\n220\t// Check that retrieving each element yields the inserted value\n221\tfor i in 0..ts {\n222\tlet retrieved = list::lget_element(&mut l, i);\n223\tmatch retrieved {\n224\tSome(r) => {\n225\t// Downcast from &mut Box<dyn Any> to i32\n226\tif let Some(val) = r.downcast_ref::<i32>() {\n227\tassert_eq!(*val, i, \"Expected {}, got {}\", i, *val);\n228\t} else {\n229\tpanic!(\"Type mismatch in list element.\");\n230\t}\n231\t}\n232\tNone => panic!(\"Expected element at index {}, found None\", i),\n233\t}\n234\t}\n235\t\n236\t// Destroy the list\n237\tlist::destroy_list(&mut l);\n238\t}\n239\t\n240\t// -----------------------------------------------------------------------------\n241\t// test_list: corresponds to the C test_list()\n242\t#[test]\n243\tpub fn test_list() {\n244\ttesting_setup_internal(\"test_list\");\n245\tbasic_100_test();\n246\ttesting_cleanup_internal(\"test_list\");\n247\t}\n248\t\n249\t// -----------------------------------------------------------------------------\n250\t// test_util: corresponds to the C test_util()\n251\t#[test]\n252\tpub fn test_util() {\n253\ttesting_setup_internal(\"test_util\");\n254\t// Calls to hashmap tests\n255\ttest_hash_init();\n256\ttest_hash_init_and_store();\n257\ttest_hash_set_and_get();\n258\ttest_hash_set_and_double_get();\n259\ttesting_cleanup_internal(\"test_util\");\n260\t}\n261\t\n262\t// -----------------------------------------------------------------------------\n263\t// Main function: corresponds to the C main that invokes the four tests\n264\tfn main() {\n265\t// test_lexer();\n266\t// test_x86();\n267\t// test_list();\n268\t// test_util();\n269\t}\n270\t"}]},"parent_tool_use_id":null,"session_id":"e4609df1-ca18-4581-bd1d-94dc89e00c8f","uuid":"38743824-9bb9-4d6c-a598-afc54a219f51","timestamp":"2026-06-01T21:32:01.235Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-rBv4nD/project/src/bin/test_main.rs","content":"// -----------------------------------------------------------------------------\n// Step-by-step Reasoning:\n//\n// 1) We look at the original C test files (test_x86.c, test_lexer.c, test_list.c, test_util.c, and main.c).\n//    Each defines test functions that call specific module functions and then return 0.\n//\n// 2) We see that test_x86() calls:\n//       testing_module_setup();\n//       test_init_int_literal();      // from codegen.rs\n//       test_op_on_rax_with_rdi();   // from codegen.rs\n//       testing_module_cleanup();\n//\n// 3) We see that test_lexer() calls:\n//       testing_module_setup();\n//       test_ttype_name();           // from lex.rs\n//       test_ttype_from_string();    // from lex.rs\n// 