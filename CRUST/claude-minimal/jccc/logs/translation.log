) {\n78\t            double_cap(h);\n79\t        }\n80\t\n81\t        h->size++;\n82\t\n83\t        h->buckets[a] = malloc(sizeof(struct BucketNode *));\n84\t        h->buckets[a]->key = key;\n85\t        h->buckets[a]->value = value;\n86\t        h->buckets[a]->next = NULL;\n87\t\n88\t        return 0;\n89\t    } else {\n90\t        // Handle linear probing\n91\t        return -1;\n92\t    }\n93\t}\n94\t\n95\tvoid double_cap(struct Hashmap *h) {\n96\t    struct BucketNode **new_buckets =\n97\t        calloc(h->cap * 2, sizeof(struct BucketNode *));\n98\t\n99\t    for (int i = 0; i < h->cap; i++) {\n100\t\n101\t        if (h->buckets[i] != NULL) {\n102\t            struct BucketNode *b = h->buckets[i];\n103\t            unsigned a = h->hash(b->key) % h->cap;\n104\t            new_buckets[a] = b;\n105\t        }\n106\t    }\n107\t\n108\t    h->buckets = new_buckets;\n109\t\n110\t    h->cap = h->cap * 2;\n111\t}\n112\t\n113\tint test_hash_init() {\n114\t    testing_func_setup();\n115\t    struct Hashmap *h = create_hashmap(100);\n116\t\n117\t    tassert(h->size == 0);\n118\t    tassert(h->cap == 100);\n119\t}\n120\t\n121\tint test_hash_init_and_store() {\n122\t    testing_func_setup();\n123\t    struct Hashmap *h = create_hashmap(100);\n124\t\n125\t    tassert(h->size == 0);\n126\t    tassert(h->cap == 100);\n127\t\n128\t    char name[5] = \"jake\";\n129\t\n130\t    char key[5] = \"test\";\n131\t    int ret = hm_set(h, key, name);\n132\t    tassert(ret != -1);\n133\t\n134\t    uint64_t ind = h->hash(key) % h->cap;\n135\t    struct BucketNode *b = h->buckets[ind];\n136\t    tassert(strcmp(b->key, key) == 0);\n137\t\n138\t    tassert(h->size == 1);\n139\t    tassert(h->cap == 100);\n140\t}\n141\t\n142\tint test_hash_set_and_get() {\n143\t    testing_func_setup();\n144\t    struct Hashmap *h = create_hashmap(100);\n145\t\n146\t    char name[100] = \"jake\";\n147\t    char key[10] = \"test\";\n148\t\n149\t    int ret = hm_set(h, key, name);\n150\t    tassert(ret != -1);\n