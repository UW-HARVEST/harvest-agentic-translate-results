     scale: 0,\n        },\n    }\n}\n\nfn write_into_fixed(dst: &mut [u8], src: &[u8]) {\n    // Zero out then copy as much as fits, leaving the rest as nulls (C-style).\n    for b in dst.iter_mut() {\n        *b = 0;\n    }\n    let n = src.len().min(dst.len());\n    dst[..n].copy_from_slice(&src[..n]);\n}\n\nfn fixed_to_str(buf: &[u8]) -> &[u8] {\n    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());\n    &buf[..end]\n}\n\nfn read_byte(file: &File) -> io::Result<Option<u8>> {\n    let mut buf = [0u8; 1];\n    let mut f: &File = file;\n    let n = f.read(&mut buf)?;\n    if n == 0 {\n        Ok(None)\n    } else {\n        Ok(Some(buf[0]))\n    }\n}\n\nfn unread_byte(file: &File) -> io::Result<()> {\n    let mut f: &File = file;\n    f.seek(SeekFrom::Current(-1))?;\n    Ok(())\n}\n\n/// Skip leading whitespace and read characters until the next whitespace.\n/// Returns an empty string at EOF.\nfn read_token(file: &File) -> io::Result<String> {\n    let mut tok = String::new();\n    // Skip leading whitespace.\n    loop {\n        match read_byte(file)? {\n            Some(b) if (b as char).is_ascii_whitespace() => continue,\n            Some(b) => {\n                tok.push(b as char);\n                break;\n            }\n            None => return Ok(tok),\n        }\n    }\n    // Read non-whitespace.\n    loop {\n        match read_byte(file)? {\n            Some(b) if (b as char).is_ascii_whitespace() => break,\n            Some(b) => tok.push(b as char),\n            None => break,\n        }\n    }\n    Ok(tok)\n}\n\n/// Skip any leading whitespace then read characters until '$' (without\n/// consuming the '$'). Trims trailing whitespace.\nfn read_until_dollar(file: &File) -> io::Result<String> {\n    let mut s = String::new();\n    // Skip leading whitespace.\n    let mut started = false;\n    loop {\n        match read_byte(file)? {\n            Some(b) => {\n                if b == b'$' {\n                    // Put it back so the caller's main loop can dispatch on it.\n                    unread_byte(file)?;\n                    break;\n                }\n                if !started && (b as char).is_ascii_whitespace() {\n                    continue;\n                }\n                started = true;\n                s.push(b as char);\n            }\n            None => break,\n        }\n    }\n    // Trim trailing whitespace.\n    while let Some(c) = s.chars().last() {\n        if c.is_ascii_whitespace() {\n            s.pop();\n        } else {\n            break;\n        }\n    }\n    Ok(s)\n}\n\n/// Read characters until end of line or '$' (without consuming the '$' or '\\n').\nfn read_until_dollar_or_newline(file: &File) -> io::Result<String> {\n    let mut s = String::new();\n    let mut started = false;\n    loop {\n        match read_byte(file)? {\n            Some(b) => {\n                if b == b'$' {\n                    unread_byte(file)?;\n                    break;\n                }\n                if b == b'\\n' {\n                    unread_byte(file)?;\n                    break;\n                }\n                if !started && (b as char).is_ascii_whitespace() {\n                    continue;\n                }\n                started = true;\n                s.push(b as char);\n            }\n            None => break,\n        }\n    }\n    while let Some(c) = s.chars().last() {\n        if c.is_ascii_whitespace() {\n            s.pop();\n        } else {\n            break;\n        }\n    }\n    Ok(s)\n}\n\n/// Read until end of line, returns the line content without the trailing newline.\nfn read_until_newline(file: &File) -> io::Result<String> {\n    let mut s = String::new();\n    loop {\n        match read_byte(file)? {\n            Some(b'\\n') => {\n                unread_byte(file)?;\n                break;\n            }\n            Some(b) => s.push(b as char),\n            None => break,\n        }\n    }\n    Ok(s)\n}\n\nimpl VCD {\n    pub fn read_from_path(path: &str) -> Result<Self, std::io::Error> {\n        let file = File::open(path)?;\n        let mut vcd = new_vcd();\n        let mut current_timestamp: Timestamp = 0;\n        let mut state = State::BeforeModuleDefinitions;\n\n        loop {\n            let byte = match read_byte(&file)? {\n                Some(b) => b,\n                None => break,\n            };\n\n            if byte == b'$' {\n                parse_instruction(&file, &mut vcd, &mut state)?;\n                continue;\n            } else if byte == b'#' {\n                current_timestamp = parse_timestamp(&file)?;\n                continue;\n            } else if isexpression(byte as char) {\n                unread_byte(&file)?;\n                parse_assignment(&file, &mut vcd, &current_timestamp)?;\n                continue;\n            } else if (byte as char).is_ascii_whitespace() {\n                continue;\n            }\n\n            return Err(io::Error::new(\n                io::ErrorKind::InvalidData,\n                format!(\"Unexpected character: {:?}\", byte as char),\n            ));\n        }\n\n        Ok(vcd)\n    }\n\n    pub fn get_signal_by_name(&self, signal_name: &str) -> Option<&Signal> {\n        let target = signal_name.as_bytes();\n        self.signals\n            .iter()\n            .find(|s| fixed_to_str(&s.name) == target)\n    }\n}\n\nimpl Signal {\n    pub fn get_value_at_timestamp(&self, timestamp: Timestamp) -> Option<&[u8]> {\n        let mut previous: Option<&[u8]> = None;\n        for change in &self.value_changes {\n            if timestamp < change.timestamp {\n                break;\n            }\n            previous = Some(fixed_to_str(&change.value));\n        }\n        previous\n    }\n}\npub const BUFFER_LENGTH: usize = 512;\n#[derive(Debug, Clone, Copy, PartialEq, Eq)]\nenum State {\n    BeforeModuleDefinitions,\n    InsideTopModule,\n    InsideInnerModules,\n}\npub fn parse_instruction(\n    file: &File,\n    vcd: &mut VCD,\n    state: &mut State,\n) -> Result<(), std::io::Error> {\n    let instruction = read_token(file)?;\n    if instruction.is_empty() {\n        return Err(io::Error::new(\n            io::ErrorKind::UnexpectedEof,\n            \"Expected instruction word\",\n        ));\n    }\n\n    match instruction.as_str() {\n        \"end\" | \"dumpvars\" | \"dumpall\" => Ok(()),\n\n        \"scope\" => {\n            *state = match *state {\n                State::BeforeModuleDefinitions => State::InsideTopModule,\n                State::InsideTopModule => State::InsideInnerModules,\n                other => other,\n            };\n            // Skip everything up to (but not including) the next '$'.\n            let _ = read_until_dollar(file)?;\n            Ok(())\n        }\n\n        \"upscope\" | \"enddefinitions\" | \"comment\" => {\n            let _ = read_until_dollar(file)?;\n            Ok(())\n        }\n\n        \"var\" => {\n            if *state == State::InsideInnerModules {\n                // Inner modules: ignore the var declaration; consume the rest of\n                // the line up to (but not including) the trailing '$end'.\n                let _ = read_until_dollar(file)?;\n                return Ok(());\n            }\n\n            // Parse: <type> <size> <id> <name...>\n            let _type_word = read_token(file)?;\n            let size_word = read_token(file)?;\n            let id_word = read_token(file)?;\n            let name_str = read_until_dollar(file)?;\n\n            let size: usize = size_word.parse().map_err(|_| {\n                io::Error::new(\n                    io::ErrorKind::InvalidData,\n                    format!(\"Invalid signal size: {:?}\", size_word),\n                )\n            })?;\n\n            let index = match get_signal_index(&id_word) {\n                Some(i) => i,\n                None => {\n                    // Could not resolve a valid index; ignore.\n                    return Ok(());\n                }\n            };\n\n            // Grow the signals vector to be able to address `index` directly,\n            // mirroring the C array indexing semantics.\n            while vcd.signals.len() <= index {\n                vcd.signals.push(Signal {\n                    name: [0; VCD_NAME_SIZE],\n                    size: 0,\n                    value_changes: Vec::new(),\n                });\n            }\n\n            // If the slot is already occupied (size != 0), this is an alias and\n            // we leave the existing definition alone (matches the C behavior).\n            if vcd.signals[index].size == 0 {\n                vcd.signals[index].size = size;\n                write_into_fixed(&mut vcd.signals[index].name, name_str.as_bytes());\n            }\n\n            Ok(())\n        }\n\n        \"date\" => {\n            let value = read_until_dollar_or_newline(file)?;\n            write_into_fixed(&mut vcd.date, value.as_bytes());\n            Ok(())\n        }\n\n        \"version\" => {\n            let value = read_until_dollar_or_newline(file)?;\n            write_into_fixed(&mut vcd.version, value.as_bytes());\n            Ok(())\n        }\n\n        \"timescale\" => {\n            // Read the scale (an unsigned integer) followed by the unit.\n            // Skip any leading whitespace.\n            let mut scale_str = String::new();\n            // Skip whitespace until we see a digit.\n            loop {\n                match read_byte(file)? {\n                    Some(b) if (b as char).is_ascii_whitespace() => continue,\n                    Some(b) if (b as char).is_ascii_digit() => {\n                        scale_str.push(b as char);\n                        break;\n                    }\n                    Some(b) => {\n                        // Not a digit, put it back and bail out with empty scale.\n                        unread_byte(file)?;\n                        break;\n                    }\n                    None => break,\n                }\n            }\n            // Continue reading digits.\n            loop {\n                match read_byte(file)? {\n                    Some(b) if (b as char).is_ascii_digit() => scale_str.push(b as char),\n                    Some(_) => {\n                        unread_byte(file)?;\n                        break;\n                    }\n                    None => break,\n                }\n            }\n            if !scale_str.is_empty() {\n                vcd.timescale.scale = scale_str.parse().unwrap_or(0);\n            }\n            // Now read the unit until '$' or newline.\n            let unit = read_until_dollar_or_newline(file)?;\n            write_into_fixed(&mut vcd.timescale.unit, unit.as_bytes());\n            Ok(())\n        }\n\n        _ => Err(io::Error::new(\n            io::ErrorKind::InvalidData,\n            format!(\"Unknown instruction: {:?}\", instruction),\n        )),\n    }\n}\npub fn parse_timestamp(file: &File) -> Result<Timestamp, std::io::Error> {\n    // Skip leading whitespace, then read consecutive digits.\n    let mut s = String::new();\n    loop {\n        match read_byte(file)? {\n            Some(b) if (b as char).is_ascii_whitespace() => continue,\n            Some(b) if (b as char).is_ascii_digit() => {\n                s.push(b as char);\n                break;\n            }\n            Some(_) => {\n                unread_byte(file)?;\n                break;\n            }\n            None => break,\n        }\n    }\n    loop {\n        match read_byte(file)? {\n            Some(b) if (b as char).is_ascii_digit() => s.push(b as char),\n            Some(_) => {\n                unread_byte(file)?;\n                break;\n            }\n            None => break,\n        }\n    }\n    if s.is_empty() {\n        return Err(io::Error::new(\n            io::ErrorKind::InvalidData,\n            \"Failed to parse timestamp\",\n        ));\n    }\n    s.parse::<Timestamp>().map_err(|_| {\n        io::Error::new(\n            io::ErrorKind::InvalidData,\n            format!(\"Invalid timestamp: {:?}\", s),\n        )\n    })\n}\npub fn parse_assignment(\n    file: &File,\n    vcd: &mut VCD,\n    timestamp: &Timestamp,\n) -> Result<(), std::io::Error> {\n    // Read the rest of the current line.\n    let line = read_until_newline(file)?;\n    if line.is_empty() {\n        return Ok(());\n    }\n\n    let first = line.as_bytes()[0] as char;\n    let is_vector = !matches!(first, '0' | '1' | 'x' | 'X' | 'z' | 'Z');\n\n    let (value_str, signal_id): (&str, &str) = if is_vector {\n        // value followed by space, then signal id.\n        match line.find(' ') {\n            Some(i) => (&line[..i], line[i + 1..].trim_end()),\n            None => return Ok(()),\n        }\n    } else {\n        // First char is value, the rest is signal id.\n        (&line[..1], line[1..].trim_end())\n    };\n\n    // For now, ignore longer signal ids (matches C behavior).\n    if signal_id.len() != 1 {\n        return Ok(());\n    }\n\n    let index = match get_signal_index(signal_id) {\n        Some(i) => i,\n        None => return Ok(()),\n    };\n    if index >= vcd.signals.len() {\n        return Ok(());\n    }\n\n    // Strip the leading 'b' for vector values so consumers receive the bit\n    // string itself (e.g. \"10010\" instead of \"b10010\").\n    let stored_value = if is_vector && value_str.starts_with('b') {\n        &value_str[1..]\n    } else {\n        value_str\n    };\n\n    let mut value_buf = [0u8; VCD_SIGNAL_SIZE];\n    write_into_fixed(&mut value_buf, stored_value.as_bytes());\n\n    vcd.signals[index].value_changes.push(ValueChange {\n        timestamp: *timestamp,\n        value: value_buf,\n    });\n\n    Ok(())\n}\npub fn get_signal_index(s: &str) -> Option<usize> {\n    let bytes = s.as_bytes();\n    if bytes.is_empty() {\n        return None;\n    }\n    let id = bytes[0] as i32 - b'!' as i32;\n    if id < 0 || id >= VCD_SIGNAL_COUNT as i32 {\n        return None;\n    }\n    Some(id as usize)\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":6,"lines":[" use std::fs::File;","+use std::io::{self, Read, Seek, SeekFrom};","+"," pub fn isexpression(c: char) -> bool {","     match c {","         '-' | '0'..='9' | 'z' | 'Z' | 'x' | 'X' | 'b' | 'U' => true,"]},{"oldStart":36,"oldLines":17,"newStart":38,"newLines":214,"lines":["     pub version: [u8; VCD_VERSION_SIZE],","     pub timescale: Timescale,"," }","+","+fn new_vcd() -> VCD {","+    VCD {","+        signals: Vec::new(),","+        date: [0; VCD_DATE_SIZE],","+        version: [0; VCD_VERSION_SIZE],","+        timescale: Timescale {","+            unit: [0; VCD_TIME_UNIT_SIZE],","+            scale: 0,","+        },","+    }","+}","+","+fn write_into_fixed(dst: &mut [u8], src: &[u8]) {","+    // Zero out then copy as much as fits, leaving the rest as nulls (C-style).","+    for b in dst.iter_mut() {","+        *b = 0;","+    }","+    let n = src.len().min(dst.len());","+    dst[..n].copy_from_slice(&src[..n]);","+}","+","+fn fixed_to_str(buf: &[u8]) -> &[u8] {","+    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());","+    &buf[..end]","+}","+","+fn read_byte(file: &File) -> io::Result<Option<u8>> {","+    let mut buf = [0u8; 1];","+    let mut f: &File = file;","+    let n = f.read(&mut buf)?;","+    if n == 0 {","+        Ok(None)","+    } else {","+        Ok(Some(buf[0]))","+    }","+}","+","+fn unread_byte(file: &File) -> io::Result<()> {","+    let mut f: &File = file;","+    f.seek(SeekFrom::Current(-1))?;","+    Ok(())","+}","+","+/// Skip leading whitespace and read characters until the next whitespace.","+/// Returns an empty string at EOF.","+fn read_token(file: &File) -> io::Result<String> {","+    let mut tok = String::new();","+    // Skip leading whitespace.","+    loop {","+        match read_byte(file)? {","+            Some(b) if (b as char).is_ascii_whitespace() => continue,","+            Some(b) => {","+        