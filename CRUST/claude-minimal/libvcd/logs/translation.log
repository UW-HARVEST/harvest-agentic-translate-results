lacing C char array\n    pub scale: usize,\n}\n#[derive(Debug)]\npub struct VCD {\n    pub signals: Vec<Signal>,\n    pub date: [u8; VCD_DATE_SIZE],\n    pub version: [u8; VCD_VERSION_SIZE],\n    pub timescale: Timescale,\n}\n\nfn new_vcd() -> VCD {\n    VCD {\n        signals: Vec::new(),\n        date: [0; VCD_DATE_SIZE],\n        version: [0; VCD_VERSION_SIZE],\n        timescale: Timescale {\n            unit: [0; VCD_TIME_UNIT_SIZE],\n            scale: 0,\n        },\n    }\n}\n\nfn write_into_fixed(dst: &mut [u8], src: &[u8]) {\n    // Zero out then copy as much as fits, leaving the rest as nulls (C-style).\n    for b in dst.iter_mut() {\n        *b = 0;\n    }\n    let n = src.len().min(dst.len());\n    dst[..n].copy_from_slice(&src[..n]);\n}\n\nfn fixed_to_str(buf: &[u8]) -> &[u8] {\n    let end = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());\n    &buf[..end]\n}\n\nfn read_byte(file: &File) -> io::Result<Option<u8>> {\n    let mut buf = [0u8; 1];\n    let mut f: &File = file;\n    let n = f.read(&mut buf)?;\n    if n == 0 {\n        Ok(None)\n    } else {\n        Ok(Some(buf[0]))\n    }\n}\n\nfn unread_byte(file: &File) -> io::Result<()> {\n    let mut f: &File = file;\n    f.seek(SeekFrom::Current(-1))?;\n    Ok(())\n}\n\n/// Skip leading whitespace and read characters until the next whitespace.\n/// Returns an empty string at EOF.\nfn read_token(file: &File) -> io::Result<String> {\n    let mut tok = String::new();\n    // Skip leading whitespace.\n    loop {\n        match read_byte(file)? {\n            Some(b) if (b as char).is_ascii_whitespace() => continue,\n            Some(b) => {\n                tok.push(b as char);\n                break;\n            }\n            None => return Ok(tok),\n        }\n    }\n    // Read non-whitespace.\n    loop {\n        match read_byte(file)? {\n            Some(b) if (b as char).is_ascii_whitespace() => break,\n            Some(b) => tok.push(b as char),\n            None => break,\n        }\n    }\n    Ok(tok)\n}\n\n/// Skip any leading whitespace then read characters until '$' (without\n/// consuming the '$'). Trims trailing whitespace.\nfn read_until_dollar(file: &File) -> io::Result<String> {\n    let mut s = String::new();\n    // Skip leading whitespace.\n    let mut started = false;\n    loop {\n        match read_byte(file)? {\n            Some(b) => {\n                if b == b'$' {\n                    // Put it back so the caller's main loop can dispatch on it.\n                    unread_byte(file)?;\n                    break;\n                }\n                if !started && (b as char).is_ascii_whitespace() {\n                    continue;\n                }\n                started = true;\n                s.push(b as char);\n            }\n            None => break,\n        }\n    }\n    // Trim trailing whitespace.\n    while let Some(c) = s.chars().last() {\n        if c.is_ascii_whitespace() {\n            s.pop();\n        } else {\n            break;\n        }\n    }\n    Ok(s)\n}\n\n/// Read characters until end of line or '$' (without consuming the '$' or '\\n').\nfn read_until_dollar_or_newline(file: &File) -> io::Result<String> {\n    let mut s = String::new();\n    let mut started = false;\n    loop {\n        match read_byte(file)? {\n            Some(b) => {\n                if b == b'$' {\n                    unread_byte(file)?;\n                    break;\n                }\n                if b == b'\\n' {\n                    unread_byte(file)?;\n                    break;\n                }\n                if !started && (b as char).is_ascii_whitespace() {\n                    continue;\n                }\n                started = true;\n                s.push(b as char);\n            }\n            None => break,\n        }\n    }\n    while let Some(c) = s.chars().last() {\n        if c.is_ascii_whitespace() {\n            s.pop();\n        } else {\n            break;\n        }\n    }\n    Ok(s)\n}\n\n/// Read until