reference to the value at the front of the queue.\n    pub fn front(&self) -> Option<&T> {\n        self.head.as_ref().map(|node| &node.value)\n    }\n    /// Returns a reference to the value at the back of the queue.\n    pub fn back(&self) -> Option<&T> {\n        // SAFETY: tail is non-null when the queue is not empty, and points\n        // to a node still owned by the chain rooted at `head`.\n        self.tail.map(|tail| unsafe { &(*tail).value })\n    }\n    /// Frees all nodes in the queue.\n    pub fn free(&mut self) {\n        while self.pop().is_some() {}\n    }\n}\n"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":328,"cache_read_input_tokens":19502,"cache_creation":{"ephemeral_5m_input_tokens":328,"ephemeral_1h_input_tokens":0},"output_tokens":33,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"502d3032-d329-4c96-a847-a3f6454a17eb","uuid":"cc662b3f-858c-4707-ac4c-36a2e8e3d08b"}
