{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01Xq3QBf1a8jTxH5grnhhHyf","type":"tool_result","content":"1\t/**\n2\t * @file queue.h\n3\t * @brief Entry header file to the library.\n4\t *\n5\t * @author Saurav Pal (resyfer)\n6\t * @bug No known bugs\n7\t */\n8\t\n9\t#ifndef __LIBQUEUE_H\n10\t#define __LIBQUEUE_H\n11\t\n12\t/* libc */\n13\t#include <stdbool.h>\n14\t#include <sys/types.h>\n15\t\n16\t/**\n17\t * @mainpage\n18\t * A queue data structure to which elements of any data type can be pushed\n19\t * and popped from in a first in first out basis.\n20\t */\n21\t\n22\t/**\n23\t * @brief Nodes in the queue.\n24\t *\n25\t * The building blocks of queue\n26\t */\n27\ttypedef struct queue_node_t {\n28\t\tvoid* value; /*!< Value stored in the node */\n29\t\tstruct queue_node_t* next; /*!< Next node in the linked list */\n30\t} queue_node_t;\n31\t\n32\t/**\n33\t * @brief Queue instance\n34\t *\n35\t * Implemented as a singly linked list, such that elements get pushed behind\n36\t * the tail, while elements get popped from head.\n37\t */\n38\ttypedef struct {\n39\t\tu_int32_t size; /*!< Size of the queue */\n40\t\tqueue_node_t* head; /*!< First node in the linked list */\n41\t\tqueue_node_t* tail; /*!< Last node in the linked list */\n42\t} queue_t;\n43\t\n44\t/**\n45\t * @brief Initialize a queue\n46\t *\n47\t * @param queue A queue instance to initialize\n48\t */\n49\tvoid queue_new(queue_t *queue);\n50\t\n51\t/* CRUD */\n52\t\n53\t/**\n54\t * @brief Push elements to the back of the queue.\n55\t *\n56\t * @param queue Queue instance\n57\t * @param value Value to push\n58\t */\n59\tvoid queue_push(queue_t *queue, void *value);\n60\t\n61\t/**\n62\t * @brief Pop elements from the front of the queue.\n63\t *\n64\t * @param queue Queue instance\n65\t * @return void* Value of the element popped.\n66\t */\n67\tvoid* queue_pop(queue_t *queue);\n68\t\n69\t/**\n70\t * @brief Peek the front element of the queue.\n71\t *\n72\t * @param queue Queue Instance\n73\t * @return void* Front element\n74\t */\n75\tvoid* queue_front(queue_t *queue);\n76\t\n77\t/**\n78\t * @brief Peek the last element of the queue.\n79\t *\n80\t * @param queue Queue instance.\n81\t * @return void* Last element\n82\t */\n83\tvoid* queue_back(queue_t *queue);\n84\t\n85\t/**\n86\t * @brief Check if queue is empty\n87\t *\n88\t * @param queue\n89\t * @return true If queue is empty\n90\t * @return false If queue is not empty\n91\t */\n92\tbool queue_empty(queue_t *queue);\n93\t\n94\t/**\n95\t * @brief Free the queue's elements.\n96\t *\n97\t * @warning This does not free the queue data structure itself\n98\t * \t\t\tbut the elemental blocks it uses. Also it does not\n99\t * \t\t\tfree the elements added to the queue.\n100\t *\n101\t * @param queue Queue instance\n102\t */\n103\tvoid queue_free(queue_t *queue);\n104\t\n105\t#endif"}]},"parent_tool_use_id":null,"session_id":"502d3032-d329-4c96-a847-a3f6454a17eb","uuid":"6f819ef0-13ac-4a7b-a748-31588fc422f3","timestamp":"2026-06-01T22:43:39.321Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-29ZB0J/project/c_src/include/queue.h","content":"/**\n * @file queue.h\n * @brief Entry header file to the library.\n *\n * @author Saurav Pal (resyfer)\n * @bug No known bugs\n */\n\n#ifndef __LIBQUEUE_H\n#define __LIBQUEUE_H\n\n/* libc */\n#include <stdbool.h>\n#include <sys/types.h>\n\n/**\n * @mainpage\n * A queue data structure to which elements of any data type can be pushed\n * and popped from in a first in first out basis.\n */\n\n/**\n * @brief Nodes in the queue.\n *\n * The building blocks of queue\n */\ntypedef struct queue_node_t {\n\tvoid* value; /*!< Value stored in the node */\n\tstruct queue_node_t* next; /*!< Next node in the linked list */\n} queue_node_t;\n\n/**\n * @brief Queue instance\n *\n * Implemented as a singly linked list, such that elements get pushed behind\n * the tail, while elements get popped from head.\n */\ntypedef struct {\n\tu_int32_t size; /*!< Size of the queue */\n\tqueue_node_t* head; /*!< First node in the linked list */\n\tqueue_node_t* tail; /*!< Last node in the linked list */\n} queue_t;\n\n/**\n * @brief Initialize a queue\n *\n * @param queue A queue instance to initialize\n */\nvoid queue_new(queue_t *queue);\n\n/* CRUD */\n\n/**\n * @brief Push elements to the back of the queue.\n *\n * @param queue Queue instance\n * @param value Value to push\n */\nvoid queue_push(queue_t *queue, void *value);\n\n/**\n * @brief Pop elements from the front of the queue.\n *\n * @param queue Queue instance\n * @return void* Value of the element popped.\n */\nvoid* queue_pop(queue_t *queue);\n\n/**\n * @brief Peek the front element of the queue.\n *\n * @param queue Queue Instance\n * @return void* Front element\n */\nvoid* queue_front(queue_t *queue);\n\n/**\n * @brief Peek the last element of the queue.\n *\n * @param queue Queue instance.\n * @return void* Last element\n */\nvoid* queue_back(queue_t *queue);\n\n/**\n * @brief Check if queue is empty\n *\n * @param queue\n * @return true If queue is empty\n * @return false If queue is not empty\n */\nbool queue_empty(queue_t *queue);\n\n/**\n * @brief Free the queue's elements.\n *\n * @warning This does not free the queue data structure itself\n * \t\t\tbut the elemental blocks it uses. Also it does not\n * \t\t\tfree the elements added to the queue.\n *\n * @param queue Queue instance\n */\nvoid queue_free(queue_t *queue);\n\n#endif","numLines":105,"startLine":1,"totalLines":105}}}
