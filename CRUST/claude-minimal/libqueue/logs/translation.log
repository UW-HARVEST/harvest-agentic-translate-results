{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_0184zYVwoKhBXNWbXuFVDiQ9","type":"tool_result","content":"1\tuse libqueue::queue;\n2\t\n3\t#[test]\n4\tfn crud_test() {\n5\t    println!(\"\\n!!--CRUD Test--!!\");\n6\t    let mut q = queue::Queue::new();\n7\t    println!(\"✅ Queue initialization\");\n8\t    assert!(q.is_empty());\n9\t    println!(\"✅ Queue Empty\");\n10\t\n11\t    let a: Box<dyn std::any::Any> = Box::new(10);\n12\t    let b: Box<dyn std::any::Any> = Box::new(15);\n13\t\n14\t    // Push `a` into the queue\n15\t    q.push(a);\n16\t    assert_eq!(q.size, 1);\n17\t    assert_eq!(\n18\t        q.front().unwrap().downcast_ref::<i32>(),\n19\t        q.back().unwrap().downcast_ref::<i32>()\n20\t    );\n21\t    println!(\"✅ Queue Push\");\n22\t\n23\t    // Push `b` into the queue\n24\t    q.push(b);\n25\t    assert_eq!(q.size, 2);\n26\t    assert_eq!(\n27\t        *q.front().unwrap().downcast_ref::<i32>().unwrap(),\n28\t        10\n29\t    );\n30\t    println!(\"✅ Queue Front\");\n31\t    assert_eq!(\n32\t        *q.back().unwrap().downcast_ref::<i32>().unwrap(),\n33\t        15\n34\t    );\n35\t    println!(\"✅ Queue Back\");\n36\t\n37\t    // Pop the front of the queue\n38\t    let popped_value = q.pop().unwrap();\n39\t    assert_eq!(\n40\t        *popped_value.downcast_ref::<i32>().unwrap(),\n41\t        10\n42\t    );\n43\t    assert_eq!(q.size, 1);\n44\t    println!(\"✅ Queue Pop\");\n45\t\n46\t    // Free the queue\n47\t    q.free();\n48\t    println!(\"✅ Queue Free\");\n49\t}\n50\t\n51\tfn main() {\n52\t    \n53\t}\n54\t"}]},"parent_tool_use_id":null,"session_id":"502d3032-d329-4c96-a847-a3f6454a17eb","uuid":"6a5990ed-c868-4466-918e-4d52339a6b51","timestamp":"2026-06-01T22:43:47.361Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-29ZB0J/project/src/bin/test.rs","content":"use libqueue::queue;\n\n#[test]\nfn crud_test() {\n    println!(\"\\n!!--CRUD Test--!!\");\n    let mut q = queue::Queue::new();\n    println!(\"✅ Queue initialization\");\n    assert!(q.is_empty());\n    println!(\"✅ Queue Empty\");\n\n    let a: Box<dyn std::any::Any> = Box::new(10);\n    let b: Box<dyn std::any::Any> = Box::new(15);\n\n    // Push `a` into the queue\n    q.push(a);\n    assert_eq!(q.size, 1);\n    assert_eq!(\n        q.front().unwrap().downcast_ref::<i32>(),\n        q.back().unwrap().downcast_ref::<i32>()\n    );\n    println!(\"✅ Queue Push\");\n\n    // Push `b` into the queue\n    q.push(b);\n    assert_eq!(q.size, 2);\n    assert_eq!(\n        *q.front().unwrap().downcast_ref::<i32>().unwrap(),\n        10\n    );\n    println!(\"✅ Queue Front\");\n    assert_eq!(\n        *q.back().unwrap().downcast_ref::<i32>().unwrap(),\n        15\n    );\n    println!(\"✅ Queue Back\");\n\n    // Pop the front of the queue\n    let popped_value = q.pop().unwrap();\n    assert_eq!(\n        *popped_value.downcast_ref::<i32>().unwrap(),\n        10\n    );\n    assert_eq!(q.size, 1);\n    println!(\"✅ Queue Pop\");\n\n    // Free the queue\n    q.free();\n    println!(\"✅ Queue Free\");\n}\n\nfn main() {\n    \n}\n","numLines":54,"startLine":1,"totalLines":54}}}
