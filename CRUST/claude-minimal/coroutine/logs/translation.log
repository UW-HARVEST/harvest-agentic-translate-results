{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01LWYuzBcavA9zHKRGXnwdeT","type":"tool_result","content":"1\tuse libc;\n2\t#[cfg(not(target_env = \"musl\"))]\n3\tuse crate::Result;\n4\t#[cfg(not(target_env = \"musl\"))]\n5\tuse crate::errno::Errno;\n6\t#[cfg(not(target_env = \"musl\"))]\n7\tuse std::mem;\n8\tuse crate::sys::signal::SigSet;\n9\t\n10\t#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]\n11\tpub struct UContext {\n12\t    context: libc::ucontext_t,\n13\t}\n14\t\n15\timpl UContext {\n16\t    #[cfg(not(target_env = \"musl\"))]\n17\t    pub fn get() -> Result<UContext> {\n18\t        let mut context = mem::MaybeUninit::<libc::ucontext_t>::uninit();\n19\t        let res = unsafe { libc::getcontext(context.as_mut_ptr()) };\n20\t        Errno::result(res).map(|_| unsafe {\n21\t            UContext { context: context.assume_init()}\n22\t        })\n23\t    }\n24\t\n25\t    #[cfg(not(target_env = \"musl\"))]\n26\t    pub fn set(&self) -> Result<()> {\n27\t        let res = unsafe {\n28\t            libc::setcontext(&self.context as *const libc::ucontext_t)\n29\t        };\n30\t        Errno::result(res).map(drop)\n31\t    }\n32\t\n33\t    pub fn sigmask_mut(&mut self) -> &mut SigSet {\n34\t        unsafe {\n35\t            &mut *(&mut self.context.uc_sigmask as *mut libc::sigset_t as *mut SigSet)\n36\t        }\n37\t    }\n38\t\n39\t    pub fn sigmask(&self) -> &SigSet {\n40\t        unsafe {\n41\t            &*(&self.context.uc_sigmask as *const libc::sigset_t as *const SigSet)\n42\t        }\n43\t    }\n44\t}\n45\t"}]},"parent_tool_use_id":null,"session_id":"85b5aa22-3954-47fc-9e91-6fefe03bdc85","uuid":"1279602d-329e-4809-8ecf-ff21ac22f038","timestamp":"2026-06-01T20:42:33.012Z","tool_use_result":{"type":"text","file":{"filePath":"/home/scheschb/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/nix-0.20.0/src/ucontext.rs","content":"use libc;\n#[cfg(not(target_env = \"musl\"))]\nuse crate::Result;\n#[cfg(not(target_env = \"musl\"))]\nuse crate::errno::Errno;\n#[cfg(not(target_env = \"musl\"))]\nuse std::mem;\nuse crate::sys::signal::SigSet;\n\n#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]\npub struct UContext {\n    context: libc::ucontext_t,\n}\n\nimpl UContext {\n    #[cfg(not(target_env = \"musl\"))]\n    pub fn get() -> Result<UContext> {\n        let mut context = mem::MaybeUninit::<libc::ucontext_t>::uninit();\n        let res = unsafe { libc::getcontext(context.as_mut_ptr()) };\n        Errno::result(res).map(|_| unsafe {\n            UContext { context: context.assume_init()}\n        })\n    }\n\n    #[cfg(not(target_env = \"musl\"))]\n    pub fn set(&self) -> Result<()> {\n        let res = unsafe {\n            libc::setcontext(&self.context as *const libc::ucontext_t)\n        };\n        Errno::result(res).map(drop)\n    }\n\n    pub fn sigmask_mut(&mut self) -> &mut SigSet {\n        unsafe {\n            &mut *(&mut self.context.uc_sigmask as *mut libc::sigset_t as *mut SigSet)\n        }\n    }\n\n    pub fn sigmask(&self) -> &SigSet {\n        unsafe {\n            &*(&self.context.uc_sigmask as *const libc::sigset_t as *const SigSet)\n        }\n    }\n}\n","numLines":45,"startLine":1,"totalLines":45}}}
