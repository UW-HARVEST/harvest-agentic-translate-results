{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01EVq3md4rPWGxmX6EAoH1KJ","type":"tool_result","content":"1\t/*****************************************************************************\n2\t * Copyright (C) 2010 Tadeus Prastowo (eus@member.fsf.org)                   *\n3\t *                                                                           *\n4\t * This program is free software: you can redistribute it and/or modify      *\n5\t * it under the terms of the GNU General Public License as published by      *\n6\t * the Free Software Foundation, either version 3 of the License, or         *\n7\t * (at your option) any later version.                                       *\n8\t *                                                                           *\n9\t * This program is distributed in the hope that it will be useful,           *\n10\t * but WITHOUT ANY WARRANTY; without even the implied warranty of            *\n11\t * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the             *\n12\t * GNU General Public License for more details.                              *\n13\t *                                                                           *\n14\t * You should have received a copy of the GNU General Public License         *\n15\t * along with this program.  If not, see <http://www.gnu.org/licenses/>.     *\n16\t *************************************************************************//**\n17\t * @file card.h\n18\t * @brief Objects and functions dealing with the 52 cards.\n19\t * @author Tadeus Prastowo <eus@member.fsf.org>\n20\t ****************************************************************************/\n21\t\n22\t#include <stdint.h>\n23\t\n24\t#ifndef CARD_H\n25\t#define CARD_H\n26\t\n27\t#ifdef __cplusplus\n28\textern \"C\" {\n29\t#endif\n30\t\n31\t/**\n32\t * The 52 cards. It is guaranteed that the place of the existing enum values\n33\t * will never change.\n34\t */\n35\tenum card_suit_rank\n36\t  {\n37\t    SPADE_ACE, SPADE_2, SPADE_3, SPADE_4, SPADE_5, SPADE_6, SPADE_7, SPADE_8,\n38\t    SPADE_9, SPADE_10, SPADE_J, SPADE_Q, SPADE_K,\n39\t\n40\t    HEART_ACE, HEART_2, HEART_3, HEART_4, HEART_5, HEART_6, HEART_7, HEART_8,\n41\t    HEART_9, HEART_10, HEART_J, HEART_Q, HEART_K,\n42\t\n43\t    DIAMOND_ACE, DIAMOND_2, DIAMOND_3, DIAMOND_4, DIAMOND_5, DIAMOND_6,\n44\t    DIAMOND_7, DIAMOND_8, DIAMOND_9, DIAMOND_10, DIAMOND_J, DIAMOND_Q, DIAMOND_K,\n45\t\n46\t    CLUB_ACE, CLUB_2, CLUB_3, CLUB_4, CLUB_5, CLUB_6, CLUB_7, CLUB_8, CLUB_9,\n47\t    CLUB_10, CLUB_J, CLUB_Q, CLUB_K,\n48\t\n49\t    CARD_COUNT,\n50\t\n51\t    INVALID_CARD,\n52\t  };\n53\t\n54\t/**\n55\t * The rank of a card. It is guaranteed that the place of the existing enum\n56\t * values will never change.\n57\t */\n58\tenum card_rank\n59\t  {\n60\t    ACE, R2, R3, R4, R5, R6, R7, R8, R9, R10, J, Q, K,\n61\t\n62\t    RANK_COUNT,\n63\t\n64\t    INVALID_RANK,\n65\t  };\n66\t\n67\t/**\n68\t * The suit of a card. It is guaranteed that the place of the existing enum\n69\t * values will never change.\n70\t */\n71\tenum card_suit\n72\t  {\n73\t    SPADE, HEART, DIAMOND, CLUB,\n74\t\n75\t    SUIT_COUNT,\n76\t\n77\t    INVALID_SUIT,\n78\t  };\n79\t\n80\t/** A card having a particular suit and rank. */\n81\ttypedef struct card_impl card;\n82\t\n83\t/** A hand of cards. */\n84\ttypedef struct card_hand_impl card_hand;\n85\t\n86\t/** A deck of cards. */\n87\ttypedef struct card_deck_impl card_deck;\n88\t\n89\t/**\n90\t * Returns the suit and rank of the card.\n91\t *\n92\t * @param [in] c the card to be determined.\n93\t *\n94\t * @return the suit and the rank of this card.\n95\t */\n96\tenum card_suit_rank\n97\tget_card_suit_rank (const card *c);\n98\t\n99\t/**\n100\t * Returns the rank of this card.\n101\t *\n102\t * @param [in] c the card to be determined.\n103\t *\n104\t * @return the rank of this card.\n105\t */\n106\tenum card_rank\n107\tget_card_rank (const card *c);\n108\t\n109\t/**\n110\t * Returns the suit of this card.\n111\t *\n112\t * @param [in] c the card to be determined.\n113\t *\n114\t * @return the suit of this card.\n115\t */\n116\tenum card_suit\n117\tget_card_suit (const card *c);\n118\t\n119\t/**\n120\t * Creates a card having the desired suit and rank.\n121\t * The returned card has to be freed with destroy_card().\n122\t *\n123\t * @param [in] csr the desired suit and rank.\n124\t *\n125\t * @return an immutable card or NULL if the card cannot be created due to\n126\t *         invalid csr or insufficient memory.\n127\t */\n128\tconst card *\n129\tcreate_card (enum card_suit_rank csr);\n130\t\n131\t/**\n132\t * Creates a card whose suit and rank are specified in the string.\n133\t * The returned card has to be freed with destroy_card().\n134\t *\n135\t * @param [in] str the string representation of a suit and rank.\n136\t *\n137\t * @return an immutable card if the string representation is valid\n138\t *         or NULL if it is invalid or the card cannot be created.\n139\t */\n140\tconst card *\n141\tstrtocard (const char *str);\n142\t\n143\t/**\n144\t * Returns the string representation of a card.\n145\t *\n146\t * @param [in] c the card.\n147\t *\n148\t * @return an immutable string if the card is valid or NULL if it is invalid.\n149\t */\n150\tconst char *\n151\tcardtostr (enum card_suit_rank c);\n152\t\n153\t/**\n154\t * Returns the string representation of a rank.\n155\t *\n156\t * @param [in] r the rank.\n157\t *\n158\t * @return an immutable string if the rank is valid or NULL if it is invalid.\n159\t */\n160\tconst char *\n161\tranktostr (enum card_rank r);\n162\t\n163\t/**\n164\t * Reclaims the memory space that was allocated for the card as well as\n165\t * setting the pointer to NULL as a safe guard. The card to be freed\n166\t * must be a card obtained from strtocard() or create_card(). Passing\n167\t * a pointer pointing to NULL is safe but not a NULL pointer.\n168\t *\n169\t * @param [in] c_ptr the pointer pointing to a card to be freed.\n170\t */\n171\tvoid\n172\tdestroy_card (const card **c_ptr);\n173\t\n174\t/**\n175\t * Returns the rank specified in the string.\n176\t *\n177\t * @param [in] str the string representation of a rank.\n178\t *\n179\t * @return the rank or ::INVALID_RANK if the string is invalid.\n180\t */\n181\tenum card_rank\n182\tstrtorank (const char *str);\n183\t\n184\t/**\n185\t * Determines where a card should be inserted in a collection of cards.\n186\t * Several predefined card sorters are:\n187\t * sort_card_after() and\n188\t * sort_card_by_rank().\n189\t *\n190\t * @param [in] before the card before this candidate insertion place (this is\n191\t *                    NULL for the place before the first element).\n192\t * @param [in] new the card to be inserted.\n193\t * @param [in] afer the card after this candidate insertion place (this is\n194\t *                  NULL for the place after the last element).\n195\t *\n196\t * @return zero if the new card should not be inserted in this candidate place\n197\t *         or non-zero if the card should be inserted in this candidate place.\n198\t */\n199\ttypedef int (*card_sorter) (const card *before, const card *new,\n200\t\t\t\t    const card *after);\n201\t\n202\t/**\n203\t * Inserts a new card after the last inserted card (to be used with\n204\t * create_hand()).\n205\t */\n206\tint\n207\tsort_card_after (const card *before, const card *new, const card *after);\n208\t\n209\t/**\n210\t * Inserts a new card after a card with a lower rank but before a card with\n211\t * a higher or equal rank (to be used with create_hand()).\n212\t */\n213\tint\n214\tsort_card_by_rank (const card *before, const card *new, const card *after);\n215\t\n216\t/**\n217\t * Creates an empty hand to hold cards. The returned card hand has to be freed\n218\t * with destroy_hand().\n219\t * \n220\t * @param [in] max the maximum number of cards that the hand can contain.\n221\t * @param [in] sorter the callback function to determine the place where a card\n222\t *                    should be inserted in a hand. If this is NULL,\n223\t *                    sort_card_after() is used as the default.\n224\t *\n225\t * @return an empty card hand or NULL if an empty card hand cannot be created.\n226\t */\n227\tcard_hand *\n228\tcreate_hand (unsigned char max, card_sorter sorter);\n229\t\n230\t/**\n231\t * Resets hand empties a hand without freeing the cards removed from the hand.\n232\t * This should not burden you unless you have ever inserted a card that\n233\t * you have ever created directly using create_card() or strtocard(). In that\n234\t * case, you have to free the card yourself using destroy_card().\n235\t *\n236\t * @param [in] h the hand to reset.\n237\t */\n238\tvoid\n239\treset_hand (card_hand *h);\n240\t\n241\t/**\n242\t * Inserts a card into a card hand. The card will not be inserted into the hand\n243\t * if the hand is full already. You should check whether or not you can still\n244\t * insert a card into a hand first. The inserted card must not be freed before\n245\t * its reference is removed from the hand because further operation on the hand\n246\t * may segfault.\n247\t *\n248\t * @param [out] h the hand into which the card will be inserted.\n249\t * @param [in] c the card to be inserted into the hand.\n250\t */\n251\tvoid\n252\tinsert_into_hand (card_hand *h, const card *c);\n253\t\n254\t/**\n255\t * Counts the number of cards currently in hand.\n256\t *\n257\t * @param [in] h the hand whose number of cards is to be determined.\n258\t *\n259\t * @return the number of cards in hand.\n260\t */\n261\tunsigned long\n262\tcount_cards_in_hand (const card_hand *h);\n263\t\n264\t/**\n265\t * Returns the number maximum number of cards that the hand can contain.\n266\t *\n267\t * @param [in] h the hand whose maximum number of cards is to be determined.\n268\t *\n269\t * @return the maximum number of cards of the hand.\n270\t */\n271\tunsigned long\n272\tget_max_of_hand (const card_hand *h);\n273\t\n274\t/**\n275\t * Determines the maximum rank in the hand. If the hand is empty, the result is\n276\t * ::INVALID_RANK. You should always check first whether or not the hand is\n277\t * empty.\n278\t *\n279\t * @param [in] h the card hand to be checked.\n280\t *\n281\t * @return the maximum rank in the hand.\n282\t */\n283\tenum card_rank\n284\tget_max_rank_of_hand (const card_hand *h);\n285\t\n286\t/** What the iterator should do. */\n287\tenum itr_action\n288\t  {\n289\t    CONTINUE, /**< Continue iterating. */\n290\t    BREAK, /**< Stop iterating. */\n291\t    REMOVE_AND_CONTINUE, /**<\n292\t\t\t\t  * Remove the card under the iterator from the hand\n293\t\t\t\t  * and continue iterating with the next card. The\n294\t\t\t\t  * pos and len values supplied to the callback function\n295\t\t\t\t  * in the following iteration will stay constant as in\n296\t\t\t\t  * this current iteration reflecting the removal.\n297\t\t\t\t  */\n298\t    REMOVE_AND_BREAK, /**<\n299\t\t\t       * Remove the card under the iterator from the hand\n300\t\t\t       * and stop iterating.\n301\t\t\t       */\n302\t  };\n303\t\n304\t/**\n305\t * The callback function used to iterate the cards in a hand.\n306\t * Since iterating a data structure with more than one iterators at once\n307\t * where not all iterators is reader clearly is an equivalent of doing\n308\t * multi-threading, it is not allowed by designing the iterator to be very\n309\t * strict. It is a total mess when you iterate a data structure with\n310\t * Iterator1 and use Iterator2 within Iterator1 to remove the iterated\n311\t * element under Iterator1's nose.\n312\t *\n313\t * @param [in] len the total number of cards in this hand.\n314\t * @param [in] pos the 0-based position of the current card in the hand.\n315\t * @param [in] c the current card under the iterator's view.\n316\t *\n317\t * @return the action that the iterator should do next.\n318\t */\n319\ttypedef enum itr_action (*card_iterator) (unsigned long len,\n320\t\t\t\t\t\t  unsigned long pos,\n321\t\t\t\t\t\t  const card *c);\n322\t\n323\t/**\n324\t * Iterates a hand invoking the callback function for each iterated card in the\n325\t * hand.\n326\t *\n327\t * @param [in] h the hand to be iterated.\n328\t * @param [in] itr_fn the callback function that will be invoked in each\n329\t *                    iteration.\n330\t */\n331\tvoid\n332\titerate_hand (card_hand *h, card_iterator itr_fn);\n333\t\n334\t/**\n335\t * Removes all cards having the same suit and rank from a card hand.\n336\t *\n337\t * @param [in] h the hand from which a card is to be removed.\n338\t * @param [in] c the card to be removed.\n339\t */\n340\tvoid\n341\tremove_from_hand (card_hand *h, enum card_suit_rank c);\n342\t\n343\t/**\n344\t * Reclaims the memory space that was allocated for the card hand as well as\n345\t * setting the pointer to NULL as a safe guard. Passing a pointer to NULL is\n346\t * safe but not a NULL pointer. This destructor does not free the cards that\n347\t * have ever been inserted. So, if you have ever inserted a card not dealt\n348\t * from the deck, you have to remember to free the card. All cards dealt from\n349\t * a deck will be freed when the deck is destroyed.\n350\t *\n351\t * @param [in] h_ptr the pointer pointing to the card hand to be freed.\n352\t */\n353\tvoid\n354\tdestroy_hand (card_hand **h_ptr);\n355\t\n356\t/**\n357\t * Checks whether or not a particular card has not been dealt from the deck.\n358\t *\n359\t * @param [in] c the card to be looked for in the deck.\n360\t * @param [in] d the card deck to be checked.\n361\t *\n362\t * @return 0 if the card has been dealt or non-zero if the card has been dealt.\n363\t */\n364\tint\n365\tis_card_in_deck (enum card_suit_rank c, const card_deck *d);\n366\t\n367\t/**\n368\t * Deals a card from the deck. You do not need to free the dealt card because\n369\t * all dealt cards will be freed upon destructing the deck with destroy_deck().\n370\t * This also means that you cannot maintain a reference to a dealt card after\n371\t * destroy_deck() is called on the deck from which the card is dealt.\n372\t *\n373\t * @param [in] d the deck from which the next card is to be dealt.\n374\t *\n375\t * @return the dealt card or NULL if the deck is empty.\n376\t */\n377\tconst card *\n378\tdeal_from_deck (card_deck *d);\n379\t\n380\t/**\n381\t * Removes the specified card from the deck. This is different from\n382\t * deal_from_deck() in a way that this removes an arbitrary card from the deck\n383\t * preventing the card to be dealt while deal_from_deck() always removes the\n384\t * top most card from the deck.\n385\t *\n386\t * @param [in] c the card to be removed.\n387\t * @param [in] d the deck from which the card is to be removed.\n388\t */\n389\tvoid\n390\tstrip_card_from_deck (enum card_suit_rank c, card_deck *d);\n391\t\n392\t/**\n393\t * Creates a deck of shuffled cards. The returned card deck has to be freed\n394\t * with destroy_deck().\n395\t *\n396\t * @return NULL if the deck cannot be created or a deck of shuffled cards.\n397\t */\n398\tcard_deck *\n399\tcreate_shuffled_deck (void);\n400\t\n401\t/**\n402\t * Reclaims the memory space that was allocated for the card deck as well as\n403\t * setting the pointer to NULL as a safe guard. Passing a pointer to NULL is\n404\t * safe but not a NULL pointer.\n405\t * <strong>WARNING:</strong> all pointers to a card that has ever been dealt\n406\t * from the deck will be invalid.\n407\t *\n408\t * @param [in] d_ptr the pointer pointing to the card deck to be freed.\n409\t */\n410\tvoid\n411\tdestroy_deck (card_deck **d_ptr);\n412\t\n413\t#ifdef __cplusplus\n414\t}\n415\t#endif\n416\t\n417\t#endif /* CARD_H */\n418\t"}]},"parent_tool_use_id":null,"session_id":"2196daa1-2ca2-4db2-aef8-d08cd17e88c3","uuid":"3899b43c-a287-4779-bdef-cf3b8869bb57","timestamp":"2026-06-01T23:32:37.281Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/claude-31062124/harvest-crust-aIjceW/project/c_src/card.h","content":"/*****************************************************************************\n * Copyright (C) 2010 Tadeus Prastowo (eus@member.fsf.org)                   *\n *                                                                           *\n * This program is free software: you can redistribute it and/or modify      *\n * it under the terms of the GNU General Public License as published by      *\n * the Free Software Foundation, either version 3 of the License, or         *\n * (at your option) any later version.                                       *\n *                                                                           *\n * This program is distributed in the hope that it will be useful,           *\n * but WITHOUT ANY WARRANTY; without even the implied warranty of            *\n * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the             *\n * GNU General Public License for more details.                              *\n *                                                                           *\n * You should have received a copy of the GNU General Public License         *\n * along with this program.  If not, see <http://www.gnu.org/licenses/>.     *\n *************************************************************************//**\n * @file card.h\n * @brief Objects and functions dealing with the 52 cards.\n * @author Tadeus Prastowo <eus@member.fsf.org>\n ****************************************************************************/\n\n#include <stdint.h>\n\n#ifndef CARD_H\n#define CARD_H\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n/**\n * The 52 cards. It is guaranteed that the place of the existing enum values\n * will never change.\n */\nenum card_suit_rank\n  {\n    SPADE_ACE, SPADE_2, SPADE_3, SPADE_4, SPADE_5, SPADE_6, SPADE_7, SPADE_8,\n    SPADE_9, SPADE_10, SPADE_J, SPADE_Q, SPADE_K,\n\n    HEART_ACE, HEART_2, HEART_3, HEART_4, HEART_5, HEART_6, HEART_7, HEART_8,\n    HEART_9, HEART_10, HEART_J, HEART_Q, HEART_K,\n\n    DIAMOND_ACE, DIAMOND_2, DIAMOND_3, DIAMOND_4, DIAMOND_5, DIAMOND_6,\n    DIAMOND_7, DIAMOND_8, DIAMOND_9, DIAMOND_10, DIAMOND_J, DIAMOND_Q, DIAMOND_K,\n\n    CLUB_ACE, CLUB_2, CLUB_3, CLUB_4, CLUB_5, CLUB_6, CLUB_7, CLUB_8, CLUB_9,\n    CLUB_10, CLUB_J, CLUB_Q, CLUB_K,\n\n    CARD_COUNT,\n\n    INVALID_CARD,\n  };\n\n/**\n * The rank of a card. It is guaranteed that the place of the existing enum\n * values will never change.\n */\nenum card_rank\n  {\n    ACE, R2, R3, R4, R5, R6, R7, R8, R9, R10, J, Q, K,\n\n    RANK_COUNT,\n\n    INVALID_RANK,\n  };\n\n/**\n * The suit of a card. It is guaranteed that the place of the existing enum\n * values will never change.\n */\nenum card_suit\n  {\n    SPADE, HEART, DIAMOND, CLUB,\n\n    SUIT_COUNT,\n\n    INVALID_SUIT,\n  };\n\n/** A card having a particular suit and rank. */\ntypedef struct card_impl card;\n\n/** A hand of cards. */\ntypedef struct card_hand_impl card_hand;\n\n/** A deck of cards. */\ntypedef struct card_deck_impl card_deck;\n\n/**\n * Returns the suit and rank of the card.\n *\n * @param [in] c the card to be determined.\n *\n * @return the suit and the rank of this card.\n */\nenum card_suit_rank\nget_card_suit_rank (const card *c);\n\n/**\n * Returns the rank of this card.\n *\n * @param [in] c the card to be determined.\n *\n * @return the rank of this card.\n */\nenum card_rank\nget_card_rank (const card *c);\n\n/**\n * Returns the suit of this card.\n *\n * @param [in] c the card to be determined.\n *\n * @return the suit of this card.\n */\nenum card_suit\nget_card_suit (const card *c);\n\n/**\n * Creates a card having the desired suit and rank.\n * The returned card has to be freed with destroy_card().\n *\n * @param [in] csr the desired suit and rank.\n *\n * @return an immutable card or NULL if the card cannot be created due to\n *         invalid csr or insufficient memory.\n */\nconst card *\ncreate_card (enum card_suit_rank csr);\n\n/**\n * Creates a card whose suit and rank are specified in the string.\n * The returned card has to be freed with destroy_card().\n *\n * @param [in] str the string representation of a suit and rank.\n *\n * @return an immutable card if the string representation is valid\n *         or NULL if it is invalid or the card cannot be created.\n */\nconst card *\nstrtocard (const char *str);\n\n/**\n * Returns the string representation of a card.\n *\n * @param [in] c the card.\n *\n * @return an immutable string if the card is valid or NULL if it is invalid.\n */\nconst char *\ncardtostr (enum card_suit_rank c);\n\n/**\n * Returns the string representation of a rank.\n *\n * @param [in] r the rank.\n *\n * @return an immutable string if the rank is valid or NULL if it is invalid.\n */\nconst char *\nranktostr (enum card_rank r);\n\n/**\n * Reclaims the memory space that was allocated for the card as well as\n * setting the pointer to NULL as a safe guard. The card to be freed\n * must be a card obtained from strtocard() or create_card(). Passing\n * a pointer pointing to NULL is safe but not a NULL pointer.\n *\n * @param [in] c_ptr the pointer pointing to a card to be freed.\n */\nvoid\ndestroy_card (const card **c_ptr);\n\n/**\n * Returns the rank specified in the string.\n *\n * @param [in] str the string representation of a rank.\n *\n * @return the rank or ::INVALID_RANK if the string is invalid.\n */\nenum card_rank\nstrtorank (const char *str);\n\n/**\n * Determines where a card should be inserted in a collection of cards.\n * Several predefined card sorters are:\n * sort_card_after() and\n * sort_card_by_rank().\n *\n * @param [in] before the card before this candidate insertion place (this is\n *                    NULL for the place before the first element).\n * @param [in] new the card to be inserted.\n * @param [in] afer the card after this candidate insertion place (this is\n *                  NULL for the place after the last element).\n *\n * @return zero if the new card should not be inserted in this candidate place\n *         or non-zero if the card should be inserted in this candidate place.\n */\ntypedef int (*card_sorter) (const card *before, const card *new,\n\t\t\t    const card *after);\n\n/**\n * Inserts a new card after the last inserted card (to be used with\n * create_hand()).\n */\nint\nsort_card_after (const card *before, const card *new, const card *after);\n\n/**\n * Inserts a new card after a card with a lower rank but before a card with\n * a higher or equal rank (to be used with create_hand()).\n */\nint\nsort_card_by_rank (const card *before, const card *new, const card *after);\n\n/**\n * Creates an empty hand to hold cards. The returned card hand has to be freed\n * with destroy_hand().\n * \n * @param [in] max the maximum number of cards that the hand can contain.\n * @param [in] sorter the callback function to determine the place where a card\n *                    should be inserted in a hand. If this is NULL,\n *                    sort_card_after() is used as the default.\n *\n * @return an empty card hand or NULL if an empty card hand cannot be created.\n */\ncard_hand *\ncreate_hand (unsigned char max, card_sorter sorter);\n\n/**\n * Resets hand empties a hand without freeing the cards removed from the hand.\n * This should not burden you unless you have ever inserted a card that\n * you have ever created directly using create_card() or strtocard(). In that\n * case, you have to free the card yourself using destroy_card().\n *\n * @param [in] h the hand to reset.\n */\nvoid\nreset_hand (card_hand *h);\n\n/**\n * Inserts a card into a card hand. The card will not be inserted into the hand\n * if the hand is full already. You should check whether or not you can still\n * insert a card into a hand first. The inserted card must not be freed before\n * its reference is removed from the hand because further operation on the hand\n * may segfault.\n *\n * @param [out] h the hand into which the card will be inserted.\n * @param [in] c the card to be inserted into the hand.\n */\nvoid\ninsert_into_hand (card_hand *h, const card *c);\n\n/**\n * Counts the number of cards currently in hand.\n *\n * @param [in] h the hand whose number of cards is to be determined.\n *\n * @return the number of cards in hand.\n */\nunsigned long\ncount_cards_in_hand (const card_hand *h);\n\n/**\n * Returns the number maximum number of cards that the hand can contain.\n *\n * @param [in] h the hand whose maximum number of cards is to be determined.\n *\n * @return the maximum number of cards of the hand.\n */\nunsigned long\nget_max_of_hand (const card_hand *h);\n\n/**\n * Determines the maximum rank in the hand. If the hand is empty, the result is\n * ::INVALID_RANK. You should always check first whether or not the hand is\n * empty.\n *\n * @param [in] h the card hand to be checked.\n *\n * @return the maximum rank in the hand.\n */\nenum card_rank\nget_max_rank_of_hand (const card_hand *h);\n\n/** What the iterator should do. */\nenum itr_action\n  {\n    CONTINUE, /**< Continue iterating. */\n    BREAK, /**< Stop iterating. */\n    REMOVE_AND_CONTINUE, /**<\n\t\t\t  * Remove the card under the iterator from the hand\n\t\t\t  * and continue iterating with the next card. The\n\t\t\t  * pos and len values supplied to the callback function\n\t\t\t  * in the following iteration will stay constant as in\n\t\t\t  * this current iteration reflecting the removal.\n\t\t\t  */\n    REMOVE_AND_BREAK, /**<\n\t\t       * Remove the card under the iterator from the hand\n\t\t       * and stop iterating.\n\t\t       */\n  };\n\n/**\n * The callback function used to iterate the cards in a hand.\n * Since iterating a data structure with more than one iterators at once\n * where not all iterators is reader clearly is an equivalent of doing\n * multi-threading, it is not allowed by designing the iterator to be very\n * strict. It is a total mess when you iterate a data structure with\n * Iterator1 and use Iterator2 within Iterator1 to remove the iterated\n * element under Iterator1's nose.\n *\n * @param [in] len the total number of cards in this hand.\n * @param [in] pos the 0-based position of the current card in the hand.\n * @param [in] c the current card under the iterator's view.\n *\n * @return the action that the iterator should do next.\n */\ntypedef enum itr_action (*card_iterator) (unsigned long len,\n\t\t\t\t\t  unsigned long pos,\n\t\t\t\t\t  const card *c);\n\n/**\n * Iterates a hand invoking the callback function for each iterated card in the\n * hand.\n *\n * @param [in] h the hand to be iterated.\n * @param [in] itr_fn the callback function that will be invoked in each\n *                    iteration.\n */\nvoid\niterate_hand (card_hand *h, card_iterator itr_fn);\n\n/**\n * Removes all cards having the same suit and rank from a card hand.\n *\n * @param [in] h the hand from which a card is to be removed.\n * @param [in] c the card to be removed.\n */\nvoid\nremove_from_hand (card_hand *h, enum card_suit_rank c);\n\n/**\n * Reclaims the memory space that was allocated for the card hand as well as\n * setting the pointer to NULL as a safe guard. Passing a pointer to NULL is\n * safe but not a NULL pointer. This destructor does not free the cards that\n * have ever been inserted. So, if you have ever inserted a card not dealt\n * from the deck, you have to remember to free the card. All cards dealt from\n * a deck will be freed when the deck is destroyed.\n *\n * @param [in] h_ptr the pointer pointing to the card hand to be freed.\n */\nvoid\ndestroy_hand (card_hand **h_ptr);\n\n/**\n * Checks whether or not a particular card has not been dealt from the deck.\n *\n * @param [in] c the card to be looked for in the deck.\n * @param [in] d the card deck to be checked.\n *\n * @return 0 if the card has been dealt or non-zero if the card has been dealt.\n */\nint\nis_card_in_deck (enum card_suit_rank c, const card_deck *d);\n\n/**\n * Deals a card from the deck. You do not need to free the dealt card because\n * all dealt cards will be freed upon destructing the deck with destroy_deck().\n * This also means that you cannot maintain a reference to a dealt card after\n * destroy_deck() is called on the deck from which the card is dealt.\n *\n * @param [in] d the deck from which the next card is to be dealt.\n *\n * @return the dealt card or NULL if the deck is empty.\n */\nconst card *\ndeal_from_deck (card_deck *d);\n\n/**\n * Removes the specified card from the deck. This is different from\n * deal_from_deck() in a way that this removes an arbitrary card from the deck\n * preventing the card to be dealt while deal_from_deck() always removes the\n * top most card from the deck.\n *\n * @param [in] c the card to be removed.\n * @param [in] d the deck from which the card is to be removed.\n */\nvoid\nstrip_card_from_deck (enum card_suit_rank c, card_deck *d);\n\n/**\n * Creates a deck of shuffled cards. The returned card deck has to be freed\n * with destroy_deck().\n *\n * @return NULL if the deck cannot be created or a deck of shuffled cards.\n */\ncard_deck *\ncreate_shuffled_deck (void);\n\n/**\n * Reclaims the memory space that was allocated for the card deck as well as\n * setting the pointer to NULL as a safe guard. Passing a pointer to NULL is\n * safe but not a NULL pointer.\n * <strong>WARNING:</strong> all pointers to a card that has ever been dealt\n * from the deck will be invalid.\n *\n * @param [in] d_ptr the pointer pointing to the card deck to be freed.\n */\nvoid\ndestroy_deck (card_deck **d_ptr);\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif /* CARD_H */\n","numLines":418,"startLine":1,"totalLines":418}}}
