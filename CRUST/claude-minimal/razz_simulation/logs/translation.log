itRank::InvalidCard {\n                self.cards[idx] = Card::write_card(c);\n                self.card_count -= 1;\n            }\n        }\n\n        pub fn create_shuffled_deck() -> Option<CardDeck> {\n            Some(CardDeck {\n                card_count: CardSuitRank::CardCount as u8,\n                cards: [Card { card: 0 }; CardSuitRank::CardCount as usize],\n            })\n        }\n    }\n\n    pub type CardSorter = fn(&Option<Card>, &Option<Card>, &Option<Card>) -> i32;\n\n    pub fn sort_card_after(\n        _before: &Option<Card>,\n        _new: &Option<Card>,\n        after: &Option<Card>,\n    ) -> i32 {\n        if after.is_none() {\n            return 1;\n        }\n        0\n    }\n\n    pub fn sort_card_by_rank(\n        before: &Option<Card>,\n        new: &Option<Card>,\n        after: &Option<Card>,\n    ) -> i32 {\n        let r = match new {\n            Some(c) => c.get_card_rank(),\n            None => return 0,\n        };\n        if after.is_none() {\n            return 1;\n        }\n        let after_rank = after.as_ref().unwrap().get_card_rank();\n        let before_ok = match before {\n            None => true,\n            Some(b) => r > b.get_card_rank(),\n        };\n        if before_ok && r <= after_rank {\n            return 1;\n        }\n        0\n    }\n\n    #[derive(Debug, Clone, Copy)]\n    pub enum ItrAction {\n        Continue,\n        Break,\n        RemoveAndContinue,\n        RemoveAndBreak,\n    }\n\n    pub type CardIterator = fn(u64, u64, &Option<Card>) -> ItrAction;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":4,"newStart":1,"newLines":6,"lines":[" pub mod card {","+    use std::sync::Mutex;","+","     pub const CLUB_BITS: u32 = 4 << 5;","     pub const ACE_BITS: u32 = 1;","     pub const J_BITS: u32 = 11;"]},{"oldStart":19,"oldLines":6,"newStart":21,"newLines":25,"lines":["     pub const INVALID_CARD_BITS: u32 = 0;","     pub const DIAMOND_BITS: u32 = 3 << 5;","     pub const R2_BITS: u32 = 2;","+"