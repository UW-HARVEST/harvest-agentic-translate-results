_t *, size_t *, const char[]);\n110\t\n111\t#endif\n112\t/* Join given strings array with separator chars into one string. */\n113\tstring_t *string_join_arr(const STRING_T_ARRAY, size_t, const char []);\n114\t\n115\tstring_t *new_string(size_t size) {\n116\t    string_t *str = malloc(sizeof(string_t));\n117\t    str->size = size;\n118\t    str->bytes = calloc(size, sizeof(char));\n119\t    return str;\n120\t}\n121\t\n122\tstring_t *new_string_from_bytes(const char *bytes) {\n123\t    string_t *str = new_string(strlen(bytes));\n124\t    strcpy(str->bytes, bytes);\n125\t    return str;\n126\t}\n127\t\n128\tvoid string_free(string_t *str) {\n129\t    free(str->bytes);\n130\t    free(str);\n131\t}\n132\t\n133\tsize_t string_len(const string_t *str) {\n134\t    return str->size;\n135\t}\n136\t\n137\tchar *string_bytes(const string_t *str) {\n138\t    char *buf = calloc(sizeof(char), str->size);\n139\t    strcpy(buf, str->bytes);\n140\t    return buf;\n141\t}\n142\t\n143\tbool_t string_eq(const string_t *left, const string_t *right) {\n144\t    if (left->size != right->size || strcmp(left->bytes, right->bytes) != 0) {\n145\t        return false;\n146\t    }\n147\t    return true;\n148\t}\n149\t\n150\tstring_t *string_copy(const string_t *str) {\n151\t    string_t *copied_str = new_string(str->size);\n152\t    strcpy(copied_str->bytes, str->bytes);\n153\t    return copied_str;\n154\t}\n155\t\n156\tstring_t *string_concat(const string_t *first, const string_t *second) {\n157\t    string_t *new_str = new_string(first->size + second->size);\n158\t    strcpy(new_str->bytes, strcat(first->bytes, second->bytes));\n159\t    return new_str;\n160\t}\n161\t\n162\tint string_t_is_space_char(char byte) {\n163\t    for (size_t idx = 0; idx < strlen(STRING_T_SPACE_CHARS); ++idx) {\n164\t        if (STRING_T_SPACE_CHARS[idx] == byte) {\n165\t            return 1;\n166\t        }\n167\t    }\n168\t    return 0;\n169\t}\n170\t\n171\tstring_t *string_substr(const string_t *str, size_t pos,