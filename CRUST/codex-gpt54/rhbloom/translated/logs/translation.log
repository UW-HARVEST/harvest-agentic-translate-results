{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport math\n\ndef params(n,p,mode):\n    n=max(n,16)\n    m=int(n*math.log(p)/math.log(1/math.pow(2, math.log(2))))\n    k=round((m/n)*math.log(2))\n    if mode=='up':\n        m0=2\n        while m0<m:\n            m0*=2\n    elif mode=='nearest':\n        lower=2\n        while lower*2 < m:\n            lower*=2\n        upper=lower*2\n        m0= lower if abs(m-lower)<=abs(upper-m) else upper\n    k0=round((m/m0)*k)\n    k0=max(k0,1)\n    return m0,k0\n\ndef fp(n,p,mode):\n    m0,k0=params(n,p,mode)\n    nn=n+1\n    return (1-math.exp(-k0*nn/m0))**k0,m0,k0\n\nfor mode in ['up','nearest']:\n    worst=(0,None)\n    print('mode',mode)\n    for p in [x/100 for x in range(1,70)]:\n        e,m0,k0=fp(1000,p,mode)\n        d=abs(e-p)\n        if d>worst[0]: worst=(d,(p,e,m0,k0))\n    print('worst',worst)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
