{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport math, struct\n\ndef murmurhash2_i32(x, seed=0):\n    key = struct.pack('<i', x)\n    m = 0x5bd1e995\n    r = 24\n    h = seed \"'^ len(key)\n    data = key\n    while len(data) >= 4:\n        k = int.from_bytes(data[:4], '\"'little')\n        k = (k * m) & 0xffffffff\n        k \"'^= (k >> r)\n        k = (k * m) & 0xffffffff\n        h = (h * m) & 0xffffffff\n        h ''^= k\n        data = data[4:]\n    if len(data) == 3: h ''^= data[2] << 16\n    if len(data) >= 2: h ''^= data[1] << 8\n    if len(data) >= 1:\n        h ''^= data[0]\n        h = (h * m) & 0xffffffff\n    h ''^= h >> 13\n    h = (h * m) & 0xffffffff\n    h ''^= h >> 15\n    return h\n\ndef mix(key):\n    key ''^= key >> 30\n    key = (key * 0xbf58476d1ce4e5b9) & ((1<<64)-1)\n    key ''^= key >> 27\n    key = (key * 0x94d049bb133111eb) & ((1<<64)-1)\n    key ''^= key >> 31\n    return key\n\ndef next_pow2(m):\n    m0=2\n    while m0<m: m0*=2\n    return m0\n\ndef choose_k(n,p,m0):\n    best=None\n    for k in range(1,16):\n        e=(1-math.exp(-k*(n+1)/m0))**k\n        d=abs(e-p)\n        if best is None or d<best[0]: best=(d,k,e)\n    return best[1]\n\ndef hits(n,p,variant):\n    n=max(n,16)\n    m=int(n*math.log(p)/math.log(1/math.pow(2, math.log(2))))\n    m0=next_pow2(m)\n    k=choose_k(n,p,m0)\n    bits=[0]*((m0+7)//8)\n    def settest(val,add):\n        key=val & ((1<<56)-1)\n        j= key & (m0-1) if variant=='\"'c' else mix(key) & (m0-1)\n        for i in range(k):\n            idx=j>>3; bit=1<<(j&7)\n            if add:\n                bits[idx] |= bit\n            elif not (bits[idx] & bit):\n                return False\n            if i==k-1: break\n            key = (key * 0x94d049bb133111eb) & ((1<<64)-1)\n            key \"'^= key >> 31\n            j = (key & (m0-1)) if variant=='\"'c' else (mix(key) & (m0-1))\n        return True\n    nn=n+1\n    for i in range(nn): settest(mix(murmurhash2_i32(i)), True)\n    h=0\n    for i in range(nn, nn*2):\n        if settest(mix(murmurhash2_i32(i)), False): h+=1\n    return h,k,m0\nfor variant in ['c','remix']:\n    worst=(0,None)\n    for pp in range(1,70):\n        p=pp/100\n        h,k,m0=hits(1000,p,variant)\n        d=abs(h/1000-p)\n        if d>worst[0]: worst=(d,(p,h,k,m0))\n    print(variant,worst)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
