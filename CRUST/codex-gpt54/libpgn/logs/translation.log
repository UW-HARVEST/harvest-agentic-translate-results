].white.from.file == 'h');\n    suite6_assert(moves->values[0].white.from.rank == 4);\n    suite6_assert(moves->values[0].white.dest.file == 'e');\n    suite6_assert(moves->values[0].white.dest.rank == 1);\n    pgn_moves_cleanup(moves);\n}\n\nvoid test_dump_move()\n{\n    pgn_move_t move = {0};\n    size_t written = 0;\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_UNKNOWN;\n    move.piece = PGN_PIECE_PAWN;\n    move.dest.file = 'e';\n    move.dest.rank = 4;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"e4\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_UNKNOWN;\n    move.piece = PGN_PIECE_ROOK;\n    move.dest.file = 'e';\n    move.dest.rank = 4;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"Re4\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_UNKNOWN;\n    move.piece = PGN_PIECE_ROOK;\n    move.check = PGN_CHECK_MATE;\n    move.dest.file = 'e';\n    move.dest.rank = 4;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"Re4#\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_UNKNOWN;\n    move.castles = PGN_CASTLING_KINGSIDE;\n    move.check = PGN_CHECK_MATE;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"O-O#\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n    move.piece = PGN_PIECE_ROOK;\n    move.dest.file = 'a';\n    move.dest.rank = 3;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"Ra3!?\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_INTRESTING_MOVE;\n    move.en_passant = true;\n    move.piece = PGN_PIECE_PAWN;\n    move.dest.file = 'f';\n    move.dest.rank = 3;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"f3!? e.p.\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = 9;\n    move.piece = PGN_PIECE_PAWN;\n    move.dest.file = 'f';\n    move.dest.rank = 3;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"f3 $9\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = 9;\n    move.en_passant = true;\n    move.piece = PGN_PIECE_PAWN;\n    move.dest.file = 'f';\n    move.dest.rank = 3;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"f3 e.p. $9\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_UNKNOWN;\n    move.piece = PGN_PIECE_PAWN;\n    move.captures = true;\n    move.dest.file = 'f';\n    move.dest.rank = 3;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"xf3\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_UNKNOWN;\n    move.piece = PGN_PIECE_ROOK;\n    move.captures = true;\n    move.dest.file = 'f';\n    move.dest.rank = 3;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"Rxf3\"));\n\n    move = (pgn_move_t){0};\n    move.annotation = PGN_ANNOTATION_UNKNOWN;\n    move.piece = PGN_PIECE_PAWN;\n    move.captures = true;\n    move.dest.file = 'f';\n    move.dest.rank = 8;\n    move.promoted_to = PGN_PIECE_QUEEN;\n    move.check = PGN_CHECK_DOUBLE;\n    written = pgn_move_to_string(&move, move.notation);\n    suite6_assert(strlen(move.notation) == written);\n    suite6_assert(!strcmp(move.notation, \"xf8=Q++\"));\n}\n\nvoid test_parsing_weird_move()\n{\n    return;\n\n    suite6_assert(*(pgn_move_from_string(\"Le1\").notation) == '\\0');\n    suite6_assert(*(pgn_move_from_string(\"xe100\").notation) == '\\0');\n}\n\nvoid test_parsing_moves_with_weird_spaces()\n{\n    return;\n\n    pgn_moves_t *moves = NULL;\n\n    moves = pgn_moves_from_string(\"1. Rdf8e.p.\");\n    pgn_moves_cleanup(moves);\n\n    moves = pgn_moves_from_string(\"1. Rdf8e.p.$0\");\n    pgn_moves_cleanup(moves);\n\n    moves = pgn_moves_from_string(\"1. Rdf8$0\");\n    pgn_moves_cleanup(moves);\n}\n\nint main(void)\n{\n    test_parsing_single_move();\n    test_parsing_bunch_of_moves();\n    test_parsing_en_passant();\n    test_parsing_moves_with_alternatives();\n    test_parsing_ambiguate_moves();\n    test_dump_move();\n    test_parsing_weird_move(); // DOES NOT GET CALLED, WOULD abort()\n    test_parsing_moves_with_weird_spaces(); // DOES NOT GET CALLED, WOULD abort()\n    return 0;\n}\n\n/* --- */\n#include \"extra/suite6.h\"\n\n#include <pgn.h>\n#include <string.h>\n\nvoid test_parsing_pgn()\n{\n    pgn_t *pgn = pgn_init();\n    pgn_parse(pgn,\n        \"[Event \\\"Ch City (open)\\\"]\\n\"\n        \"[Site \\\"Frankfurt (Germany)\\\"]\\n\"\n        \"\\n\"\n        \"1.e4 e5\\n\"\n        \"2.Nc3 Nc6\\n\"\n        \"3. g3 0-1\");\n\n    suite6_assert(strcmp(pgn_metadata_get(pgn->metadata, \"Event\"), \"Ch City (open)\") == 0);\n    suite6_assert(strcmp(pgn_metadata_get(pgn->metadata, \"Site\"), \"Frankfurt (Germany)\") == 0);\n\n    suite6_assert(strcmp(pgn->moves->values[0].white.notation, \"e4\") == 0);\n    suite6_assert(pgn->moves->values[0].white.piece == PGN_PIECE_PAWN);\n    suite6_assert(pgn->moves->values[0].white.dest.file == 'e');\n    suite6_assert(pgn->moves->values[0].white.dest.rank == 4);\n    suite6_assert(pgn->moves->values[0].white.captures == false);\n    suite6_assert(pgn->moves->values[0].white.annotation == PGN_ANNOTATION_UNKNOWN);\n    suite6_assert(strcmp(pgn->moves->values[0].black.notation, \"e5\") == 0);\n    suite6_assert(pgn->moves->values[0].black.piece == PGN_PIECE_PAWN);\n    suite6_assert(pgn->moves->values[0].black.dest.file == 'e');\n    suite6_assert(pgn->moves->values[0].black.dest.rank == 5);\n    suite6_assert(pgn->moves->values[0].black.captures == false);\n    suite6_assert(pgn->moves->values[0].black.annotation == PGN_ANNOTATION_UNKNOWN);\n\n    suite6_assert(strcmp(pgn->moves->values[1].white.notation, \"Nc3\") == 0);\n    suite6_assert(pgn->moves->values[1].white.piece == PGN_PIECE_KNIGHT);\n    suite6_assert(pgn->moves->values[1].white.dest.file == 'c');\n    suite6_assert(pgn->moves->values[1].white.dest.rank == 3);\n    suite6_assert(pgn->moves->values[1].white.captures == false);\n    suite6_assert(pgn->moves->values[1].white.annotation == PGN_ANNOTATION_UNKNOWN);\n    suite6_assert(strcmp(pgn->moves->values[1].black.notation, \"Nc6\") == 0);\n    suite6_assert(pgn->moves->values[1].black.piece == PGN_PIECE_KNIGHT);\n    suite6_assert(pgn->moves->values[1].black.dest.file == 'c');\n    suite6_assert(pgn->moves->values[1].black.dest.rank == 6);\n    suite6_assert(pgn->moves->values[1].black.captures == false);\n    suite6_assert(pgn->moves->values[1].black.annotation == PGN_ANNOTATION_UNKNOWN);\n\n    suite6_assert(pgn->score == PGN_SCORE_BLACK_WON);\n\n    pgn_cleanup(pgn);\n}\n\nint main(void)\n{\n    test_parsing_pgn();\n    return 0;\n}\n","exit_code":0,"status":"completed"}}
