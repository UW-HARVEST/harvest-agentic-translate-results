{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,220p' c_src/file2str.c\"","aggregated_output":"\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n\nchar *file2strl(const char *path, unsigned int *file_len_out)\n{\n    FILE *file;\n    int e;\n\n    file = fopen(path, \"rb\");\n    if (!file)\n    {\n        fprintf(stderr, \"Unable to open file %s\\n\", path);\n        return NULL;\n    }\n\n    e = fseek(file, 0, SEEK_END);\n    if (-1 == e)\n    {\n        fprintf(stderr, \"Unable to seek file %s\\n\", path);\n        fclose(file);\n        return NULL;\n    }\n\n    long file_len = ftell(file);\n    if (-1 == file_len)\n    {\n        fprintf(stderr, \"Unable to ftell() file %s\\n\", path);\n        fclose(file);\n        return NULL;\n    }\n\n    e = fseek(file, 0, SEEK_SET);\n    if (-1 == e)\n    {\n        fprintf(stderr, \"Unable to seek file %s\\n\", path);\n        fclose(file);\n        return NULL;\n    }\n\n    char *contents = malloc(file_len + 1);\n    if (!contents)\n    {\n        fprintf(stderr, \"Memory error!\\n\");\n        fclose(file);\n        return NULL;\n    }\n\n    unsigned long bytes_read = fread(contents, file_len, 1, file);\n    if (bytes_read == 0 && ferror(file))\n    {\n        fprintf(stderr, \"Read error\");\n        free(contents);\n        fclose(file);\n        return NULL;\n    }\n    fclose(file);\n\n    contents[file_len] = '\\0';\n\n    if (file_len_out)\n        *file_len_out = file_len + 1;\n\n    return contents;\n}\n\nchar *file2str(const char *path)\n{\n    return file2strl(path, NULL);\n}\n","exit_code":0,"status":"completed"}}
