ors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"+a\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"a|*\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\\\\x0\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\\\\zzz\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"[a\\\\x]\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"\\u{0008}\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    }); // \\b in code\n    run_test(&Test {\n        regex: \"\\t\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n    run_test(&Test {\n        regex: \"^^a\",\n        input: \"\",\n        matches: false,\n        errors: true,\n        partial: false,\n        ignorecase: false,\n        complement: false,\n        quick: false,\n    });\n   