{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' c_src/bin/main.c\"","aggregated_output":"/* main.c - Copyright (c) 2019, Sijmen J. Mulder (see LICENSE.md) */\n\n#include <stdio.h>\n#include <stdlib.h>\n\n#ifdef __OpenBSD__\n# include <unistd.h>\n#endif\n\n#include \"../src/leftpad.h\"\n\nint\nmain(int argc, char **argv)\n{\n\tlong min_len;\n\tconst char *padding = \" \";\n\tchar *end;\n\tchar *buf;\n\tsize_t buf_len;\n\n#ifdef __OpenBSD__\n\tif (pledge(\"stdio\", NULL) == -1) {\n\t\tfputs(\"leftpad: pledge() failed\\n\", stderr);\n\t\treturn 0;\n\t}\n#endif\n\n\tif (argc == 4)\n\t\tpadding = argv[3];\n\telse if (argc != 3) {\n\t\tfputs(\"usage: leftpad string length [padding]\\n\", stderr);\n\t\treturn 1;\n\t}\n\n\tmin_len = strtol(argv[2], &end, 10);\n\tif (!argv[2][0] || end[0] || min_len < 0) {\n\t\tfputs(\"leftpad: invalid length\", stderr);\n\t\treturn 1;\n\t}\n\n\tbuf_len = leftpad(argv[1], padding, min_len, NULL, 0);\n\tif (!(buf = malloc(buf_len))) {\n\t\tfputs(\"leftpad: out of memory\", stderr);\n\t\treturn 1;\n\t}\n\n\tleftpad(argv[1], padding, min_len, buf, buf_len+1);\n\tputs(buf);\n\treturn 0;\n}\n","exit_code":0,"status":"completed"}}
