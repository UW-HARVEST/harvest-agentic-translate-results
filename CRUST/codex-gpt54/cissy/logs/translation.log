;\r\n      numbufi = 0;\r\n    }\r\n    else if (text[i] == ',') {\r\n      if (numbufi == 0) {\r\n\tif (flag_dash) {\r\n\t  rv = rangeAddGreaterEqual(start, rv);\r\n\t}\r\n      }\r\n      else if (start > 0) {\r\n\tend = atoi(numbuf);\r\n\tif (end <= 0 || start > end) {\r\n\t  fprintf(stderr, \"error: illegal start/end ranges\\n\");\r\n\t  exit(-1);\r\n\t}\r\n\trv = rangeAddStartEnd(start, end, rv);\r\n      }\r\n      else {\r\n\tstart = atoi(numbuf);\r\n\trv = rangeAddSingle(start, rv);\r\n      }\r\n      memset(numbuf, 0, sizeof(numbuf));\r\n      numbufi = 0;\r\n      start = 0;\r\n      end = 0;\r\n      state = 0;\r\n    }\r\n  }\r\n  // finish up\r\n  if (numbufi == 0) {\r\n    if (flag_dash) {\r\n      rv = rangeAddGreaterEqual(start, rv);\r\n    }\r\n  }\r\n  else if (start > 0) {\r\n    end = atoi(numbuf);\r\n    if (end <= 0 || start > end) {\r\n      fprintf(stderr, \"error: illegal start/end range %s\\n\", text);\r\n      exit(-1);\r\n    }\r\n    rv = rangeAddStartEnd(start, end, rv);\r\n  }\r\n  else {\r\n    start = atoi(numbuf);\r\n    rv = rangeAddSingle(start, rv);\r\n  }\r\n  return rv;\r\n}\r\n","exit_code":0,"status":"completed"}}
