{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' src/bin/common_test.rs\"","aggregated_output":"use c_aces::common::{gcd, xgcd, Xgcd};\n\n#[test]\nfn gcd_test() {\n    assert_eq!(gcd(1, 1), 1);\n    assert_eq!(gcd(2, 1), 1);\n    assert_eq!(gcd(1, 2), 1);\n    assert_eq!(gcd(2, 2), 2);\n    assert_eq!(gcd(6, 15), 3);\n    assert_eq!(gcd(15, 6), 3);\n    assert_eq!(gcd(7, 15), 1);\n    assert_eq!(gcd(15, 7), 1);\n    assert_eq!(gcd(7, 15), 1);\n    assert_eq!(gcd(11112, 44445), 3);\n}\n\n#[test]\nfn xgcd_test() {\n    let result: Xgcd = xgcd(7, 7);\n    assert_eq!(result.gcd, 7);\n    assert_eq!(result.a, 0);\n    assert_eq!(result.b, 1);\n\n    let result = xgcd(2, 2);\n    assert_eq!(result.gcd, 2);\n    assert_eq!(result.a, 0);\n    assert_eq!(result.b, 1);\n\n    let result = xgcd(1, 1);\n    assert_eq!(result.gcd, 1);\n    assert_eq!(result.a, 0);\n    assert_eq!(result.b, 1);\n\n    let result = xgcd(1, 2);\n    assert_eq!(result.gcd, 1);\n    assert_eq!(result.a, 1);\n    assert_eq!(result.b, 0);\n\n    let result = xgcd(5, 6);\n    assert_eq!(result.gcd, 1);\n    assert_eq!(result.a, -1);\n    assert_eq!(result.b, 1);\n\n    let result = xgcd(19, 13);\n    assert_eq!(result.gcd, 1);\n    assert_eq!(result.a, -2);\n    assert_eq!(result.b, 3);\n}\nfn main(){}","exit_code":0,"status":"completed"}}
