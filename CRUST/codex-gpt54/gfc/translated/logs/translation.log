{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/gfc.rs | sed -n '1,220p'\"","aggregated_output":"     1\t/// Constants for Speck encryption\n     2\tconst SPECK_ROUNDS: usize = 27;\n     3\tconst SPECK_KEY_LEN: usize = 4;\n     4\tfn ror(x: u32, r: u32) -> u32 {\n     5\t    x.rotate_right(r)\n     6\t}\n     7\tfn rol(x: u32, r: u32) -> u32 {\n     8\t    x.rotate_left(r)\n     9\t}\n    10\tfn round(x: &mut u32, y: &mut u32, k: u32) {\n    11\t    *x = ror(*x, 8);\n    12\t    *x = x.wrapping_add(*y);\n    13\t    *x ^= k;\n    14\t    *y = rol(*y, 3);\n    15\t    *y ^= *x;\n    16\t}\n    17\t#[derive(Debug)]\n    18\tpub struct GFC {\n    19\t    m: u64,       // Range\n    20\t    r: u64,       // Number of Feistel rounds\n    21\t    a: u64,\n    22\t    b: u64,\n    23\t    speck_exp: Vec<u32>,\n    24\t}\n    25\timpl GFC {\n    26\t    /// Initialize the GFC structure\n    27\t    pub fn new(range: u64, rounds: u64, seed: u64) -> Self {\n    28\t        let tmp = (range as f64).sqrt().ceil() as u64;\n    29\t        let mut speck_exp = vec![0u32; rounds as usize * SPECK_ROUNDS];\n    30\t\n    31\t        for i in 0..rounds as usize {\n    32\t            let seed_bytes = seed.to_le_bytes();\n    33\t            let i_bytes = (i as u64).to_le_bytes();\n    34\t            let key = [\n    35\t                u32::from_le_bytes(seed_bytes[0..4].try_into().unwrap()),\n    36\t                u32::from_le_bytes(seed_bytes[4..8].try_into().unwrap()),\n    37\t                u32::from_le_bytes(i_bytes[0..4].try_into().unwrap()),\n    38\t                u32::from_le_bytes(i_bytes[4..8].try_into().unwrap()),\n    39\t            ];\n    40\t            speck_expand(&key, &mut speck_exp[i * SPECK_ROUNDS..(i + 1) * SPECK_ROUNDS]);\n    41\t        }\n    42\t\n    43\t        Self {\n    44\t            m: range,\n    45\t            r: rounds,\n    46\t            a: tmp,\n    47\t            b: tmp,\n    48\t            speck_exp,\n    49\t        }\n    50\t    }\n    51\t    /// Encrypt using the Feistel cipher\n    52\t    pub fn encrypt(&self, m: u64) -> u64 {\n    53\t        let mut c = self.fe(m);\n    54\t        while c >= self.m {\n    55\t            c = self.fe(c);\n    56\t        }\n    57\t        c\n    58\t    }\n    59\t    /// Decrypt using the Feistel cipher\n    60\t    pub fn decrypt(&self, m: u64) -> u64 {\n    61\t        let mut c = self.fe_inv(m);\n    62\t        while c >= self.m {\n    63\t            c = self.fe_inv(c);\n    64\t        }\n    65\t        c\n    66\t    }\n    67\t    /// Function F for Feistel cipher using Speck encryption\n    68\t    fn f(&self, j: u64, r: u64) -> u64 {\n    69\t        let key_start = (j as usize - 1) * SPECK_ROUNDS;\n    70\t        let key = &self.speck_exp[key_start..key_start + SPECK_ROUNDS];\n    71\t        let rb = r.to_le_bytes();\n    72\t        let pt = [\n    73\t            u32::from_le_bytes(rb[0..4].try_into().unwrap()),\n    74\t            u32::from_le_bytes(rb[4..8].try_into().unwrap()),\n    75\t        ];\n    76\t        let mut ct = [0u32; 2];\n    77\t        speck_encrypt(&pt, &mut ct, key);\n    78\t\n    79\t        let mut enc = [0u8; 8];\n    80\t        enc[0..4].copy_from_slice(&ct[0].to_le_bytes());\n    81\t        enc[4..8].copy_from_slice(&ct[1].to_le_bytes());\n    82\t        u64::from_le_bytes(enc)\n    83\t    }\n    84\t    /// Function fe[r, a, b] for encryption\n    85\t    fn fe(&self, m: u64) -> u64 {\n    86\t        let mut l = m % self.a;\n    87\t        let mut r = m / self.a;\n    88\t\n    89\t        for j in 1..=self.r {\n    90\t            let tmp = if j & 1 == 1 {\n    91\t                (l + self.f(j, r)) % self.a\n    92\t            } else {\n    93\t                (l + self.f(j, r)) % self.b\n    94\t            };\n    95\t            l = r;\n    96\t            r = tmp;\n    97\t        }\n    98\t\n    99\t        if self.r & 1 == 1 {\n   100\t            self.a * l + r\n   101\t        } else {\n   102\t            self.a * r + l\n   103\t        }\n   104\t    }\n   105\t    /// Function fe^-1[r, a, b] for decryption\n   106\t    fn fe_inv(&self, m: u64) -> u64 {\n   107\t        let (mut l, mut r) = if self.r & 1 == 1 {\n   108\t            (m / self.a, m % self.a)\n   109\t        } else {\n   110\t            (m % self.a, m / self.a)\n   111\t        };\n   112\t\n   113\t        for j in (1..=self.r).rev() {\n   114\t            let tmp = if j & 1 == 1 {\n   115\t                (r + self.a - (self.f(j, l) % self.a)) % self.a\n   116\t            } else {\n   117\t                (r + self.b - (self.f(j, l) % self.b)) % self.b\n   118\t            };\n   119\t            r = l;\n   120\t            l = tmp;\n   121\t        }\n   122\t\n   123\t        self.a * r + l\n   124\t    }\n   125\t}\n   126\t/// Speck key expansion\n   127\tfn speck_expand(key: &[u32; SPECK_KEY_LEN], round_keys: &mut [u32]) {\n   128\t    let mut b = key[0];\n   129\t    let mut a = [0u32; SPECK_KEY_LEN - 1];\n   130\t    a.copy_from_slice(&key[1..]);\n   131\t\n   132\t    round_keys[0] = b;\n   133\t    for i in 0..(SPECK_ROUNDS - 1) {\n   134\t        round(&mut a[i % (SPECK_KEY_LEN - 1)], &mut b, i as u32);\n   135\t        round_keys[i + 1] = b;\n   136\t    }\n   137\t}\n   138\t/// Speck encryption function\n   139\tfn speck_encrypt(pt: &[u32; 2], ct: &mut [u32; 2], key: &[u32]) {\n   140\t    ct[0] = pt[0];\n   141\t    ct[1] = pt[1];\n   142\t\n   143\t    for &round_key in key.iter().take(SPECK_ROUNDS) {\n   144\t        let (left, right) = ct.split_at_mut(1);\n   145\t        round(&mut right[0], &mut left[0], round_key);\n   146\t    }\n   147\t}\n","exit_code":0,"status":"completed"}}
