 \" \", (i % 64) ? \"\" : \"\\n\");\n\n\treturn message;\n}\n\nvoid\nprintStrat (BM_BufferPool *const bm)\n{\n\tswitch (bm->strategy)\n\t{\n\tcase RS_FIFO:\n\t\tprintf(\"FIFO\");\n\t\tbreak;\n\tcase RS_LRU:\n\t\tprintf(\"LRU\");\n\t\tbreak;\n\tcase RS_CLOCK:\n\t\tprintf(\"CLOCK\");\n\t\tbreak;\n\tcase RS_LFU:\n\t\tprintf(\"LFU\");\n\t\tbreak;\n\tcase RS_LRU_K:\n\t\tprintf(\"LRU-K\");\n\t\tbreak;\n\tdefault:\n\t\tprintf(\"%i\", bm->strategy);\n\t\tbreak;\n\t}\n}\n","exit_code":0,"status":"completed"}}
