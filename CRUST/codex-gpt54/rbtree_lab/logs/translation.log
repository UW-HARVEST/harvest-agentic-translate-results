{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc 'tmp=$(mktemp --suffix .rs)\ncat > \"$tmp\" <<'\"'RS'\nuse rbtree::rbtree::{Color, NodeRef, RBTree};\n\nfn color_of(node: &Option<NodeRef>) -> Color {\n    node.as_ref().map(|n| n.borrow().color.clone()).unwrap_or(Color::Black)\n}\n\nfn check_bst(node: &Option<NodeRef>, min: Option<i32>, max: Option<i32>) {\n    if let Some(n) = node {\n        let nb = n.borrow();\n        if let Some(lo) = min { assert\"'!(nb.key >= lo, \"key {} < min {}\", nb.key, lo); }\n        if let Some(hi) = max { assert!(nb.key <= hi, \"key {} > max {}\", nb.key, hi); }\n        let left = nb.left.clone();\n        let right = nb.right.clone();\n        let key = nb.key;\n        drop(nb);\n        check_bst(&left, min, Some(key));\n        check_bst(&right, Some(key), max);\n    }\n}\n\nfn black_height(node: &Option<NodeRef>) -> usize {\n    match node {\n        None => 1,\n        Some(n) => {\n            let nb = n.borrow();\n            if nb.color == Color::Red {\n                assert!(color_of(&nb.left) == Color::Black);\n                assert!(color_of(&nb.right) == Color::Black);\n            }\n            let left = nb.left.clone();\n            let right = nb.right.clone();\n            let add = if nb.color == Color::Black { 1 } else { 0 };\n            drop(nb);\n            let lh = black_height(&left);\n            let rh = black_height(&right);\n            assert_eq!(lh, rh);\n            lh + add\n        }\n    }\n}\n\nfn check_tree(t: &RBTree) {\n    if let Some(root) = &t.root {\n        assert_eq!(root.borrow().color, Color::Black);\n    }\n    check_bst(&t.root, None, None);\n    black_height(&t.root);\n}\n\nfn main() {\n    let mut t = RBTree::new();\n    let mut vals = Vec::new();\n    let mut x: u64 = 17;\n    for _ in 0..5000 {\n        x = x.wrapping_mul(6364136223846793005).wrapping_add(1);\n        let v = ((x >> 16) % 200) as i32;\n        t.rbtree_insert(v);\n        vals.push(v);\n    }\n    check_tree(&t);\n    let mut sorted = vals.clone();\n    sorted.sort();\n    assert_eq!(t.to_array(sorted.len()), sorted);\n    assert_eq!(t.rbtree_min().unwrap().borrow().key, *sorted.first().unwrap());\n    assert_eq!(t.rbtree_max().unwrap().borrow().key, *sorted.last().unwrap());\n\n    for v in vals {\n        let node = t.rbtree_find(v).expect(\"missing inserted value\");\n        assert_eq!(node.borrow().key, v);\n        t.erase(node);\n        check_tree(&t);\n    }\n    assert!(t.root.is_none());\n}\nRS\nrustc \"$tmp\" --edition=2024 -L dependency=target/debug/deps --extern rbtree=target/debug/librbtree.rlib -o /tmp/rbtree_stress && /tmp/rbtree_stress'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
