{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' c_src/README.md && sed -n '1,220p' c_src/generate_table.py && sed -n '1,220p' c_src/Makefile && sed -n '1,220p' c_src/tests/test_util.h && sed -n '1,220p' c_src/tests/max_heap_test.h && sed -n '1,220p' c_src/tests/packet_slab_undo_stack_test.h && sed -n '1,220p' c_src/tests/substring_enumerator_test.h\"","aggregated_output":"# MEGALANIA\n\n## Sometimes, you just need a big lizard\n\nMegalania is an LZMA compressor that uses simulated annealing to find an optimal sequence of LZMA packets to maximize the compression ratio. It's very slow, but if given time it might compress better than xzutils can.\n\nThis is still a work in progress.\n#!/usr/bin/env python3\nimport math\n\nif __name__ == \"__main__\":\n\tprint(\"#include <stddef.h>\")\n\tprint(\"//this file is autogenerated by generate_table.py\\n\")\n\tprint(\"static const uint64_t LOG2_LOOKUP[2048] = { 0,\")\n\tfor i in range(1, 2048):\n\t\tprint(\"%d,\" % -int(math.log2(i/2048.) * 2048))\n\tprint(\"};\")\nHEADERS := $(wildcard src/*.h)\nSOURCES := $(wildcard src/*.c)\nPROJECT := megalania\n\nTEST_HEADERS := $(wildcard src/*.h) $(wildcard tests/*.h)\nTEST_SOURCES := $(filter-out src/main.c, $(wildcard src/*.c)) $(wildcard tests/*.c)\nTEST_PROJECT := $(PROJECT)_tests\n\nall : $(PROJECT) $(TEST_PROJECT)\n\n$(PROJECT) : $(HEADERS) $(SOURCES) Makefile\n\tgcc -o $(PROJECT) $(SOURCES) -lm -g -Wall -Werror -Wextra -O3 -flto\n\n$(TEST_PROJECT) : $(TEST_HEADERS) $(TEST_SOURCES) Makefile\n\tgcc -o $(TEST_PROJECT) $(TEST_SOURCES) -lm -g -Wall -Werror -Wextra -O0 -flto\n#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n\n#define PRETTY_PRINT_TEST_NAME() \\\n{ \\\n\tprintf(\"=== %s ===\\n\", __FUNCTION__); \\\n}\n\n#define PRETTY_PRINT_SUB_TEST_NAME() \\\n{ \\\n\tprintf(\"> %s\\n\", __FUNCTION__); \\\n}\n\n#define TEST_ASSERT(test, msg) \\\n{ \\\n\tif(!(test)) { \\\n\t\tfprintf(stderr, \"ERROR: \"); \\\n\t\tfprintf(stderr, msg); \\\n\t\tfprintf(stderr, \"\\n\"); \\\n\t\tassert(0); \\\n\t} \\\n}\n\n#define TEST_ASSERT_EQ(got, expect, msg) \\\n{ \\\n\ttypeof(got) __GOT_STOR = got; \\\n\ttypeof(expect) __EXPECT_STOR = expect; \\\n\tif(__GOT_STOR != __EXPECT_STOR) { \\\n\t\tfprintf(stderr, \"ERROR: \"); \\\n\t\tfprintf(stderr, msg, __EXPECT_STOR, __GOT_STOR); \\\n\t\tfprintf(stderr, \"\\n\"); \\\n\t\tassert(0); \\\n\t} \\\n}\n#pragma once\n\nvoid max_heap_test();\n#pragma once\n\nvoid packet_slab_undo_stack_test();\n#pragma once\n\nvoid substring_enumerator_test();\n","exit_code":0,"status":"completed"}}
