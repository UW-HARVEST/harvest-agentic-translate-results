{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' c_src/tests/cbt_bm.c\"","aggregated_output":"// Benchmark CBT. For example:\n//\n//   $ cbt_bm < /usr/share/dict/words\n\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include \"bm.h\"\n#include \"cbt.h\"\n\n#define REP(i,n) for(int i=0;i<n;i++)\n\nvoid f(char **key, int m) {\n  cbt_t cbt = cbt_new();\n\n  int count = 0;\n  bm_init();\n  REP(i, m) cbt_put_at(cbt, (void *) (intptr_t) i, key[i]);\n  bm_report(\"CBT insert\");\n  REP(i, m) if (i != (intptr_t) cbt_get_at(cbt, key[i])) {\n    fprintf(stderr, \"BUG!\\n\");\n    exit(1);\n  }\n  bm_report(\"CBT get\");\n  for (cbt_it it = cbt_first(cbt); it; it = cbt_next(it)) count++;\n  if (count != m) {\n    fprintf(stderr, \"BUG!\\n\");\n    exit(1);\n  }\n  bm_report(\"CBT iterate\");\n  printf(\"CBT overhead: %lu bytes\\n\", cbt_overhead(cbt));\n  bm_init();\n  REP(i, m) cbt_remove(cbt, key[i]);\n  bm_report(\"CBT delete\");\n}\n\n// int main() {\n//   bm_read_keys(f);\n//   return 0;\n// }\n","exit_code":0,"status":"completed"}}
