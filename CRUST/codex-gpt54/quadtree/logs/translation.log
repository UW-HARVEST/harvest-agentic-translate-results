{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,260p' c_src/benchmark.c\"","aggregated_output":"#include <stdio.h>\n#include <time.h>\n#include \"src/quadtree.h\"\n\nstatic void\nbench(void (*bm)(void), char *label){\n  printf(\" %18s\", label);\n  fflush(stdout);\n  bm();\n}\n\nstatic int nodes = 10000;\nstatic clock_t startTime;\n\nstatic void\nstart(void) {\n  startTime = clock();\n}\n\nstatic void\nstop(void) {\n  float duration = (float) (clock() - startTime) / CLOCKS_PER_SEC;\n  printf(\": \\e[32m%.4f\\e[0ms\\n\", duration);\n}\n\nstatic void\nmark_insert(void){\n  int fail = 0;\n  int success = 0;\n  int replace = 0;\n  int n = nodes;\n  int val = 10;\n  quadtree_t *tree = quadtree_new(0, 0, 1000, 1000);\n  double x;\n  double y;\n  start();\n  while(n--){\n    x = (double) (rand() % 1000);\n    y = (double) (rand() % 1000);\n    int status = quadtree_insert(tree, x, y, &val);\n    switch(status){\n      case 0: ++fail; break;\n      case 1: ++success; break;\n      case 2: ++replace; break;\n    }\n  }\n  stop();\n  printf(\"  %18s %i\\n\", \"length:\", tree->length);\n  printf(\"  %18s %d\\n\", \"insert success:\", success);\n  printf(\"  %18s %d\\n\", \"insert replace:\", replace);\n  printf(\"  %18s %d\\n\", \"insert fail:\", fail);\n  quadtree_free(tree);\n}\n\nint\nmain(int argc, const char *argv[]){\n  srand(time(NULL));\n  bench(mark_insert, \"insertion\");\n  return 0;\n}\n","exit_code":0,"status":"completed"}}
