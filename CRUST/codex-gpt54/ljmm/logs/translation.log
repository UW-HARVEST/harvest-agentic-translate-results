{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/ljmm.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse std::fs::File;\n     2\tuse std::io::Read;\n     3\tuse std::sync::{LazyLock, Mutex, MutexGuard};\n     4\t\n     5\tconst BUFFER_SZ: usize = 8192;\n     6\tconst DUMMY_BLK_SZ: usize = 12;\n     7\tconst ADDR_1G: usize = 0x4000_0000;\n     8\tconst ADDR_2G: usize = 0x8000_0000;\n     9\t\n    10\t#[derive(Debug, Clone)]\n    11\tstruct LjmmState {\n    12\t    page_size: usize,\n    13\t    page_mask: usize,\n    14\t    addr_upbound: usize,\n    15\t    addr_lowbound: usize,\n    16\t    dummy_blk: Vec<u8>,\n    17\t    map_file: String,\n    18\t    buffer: Vec<u8>,\n    19\t    buf_len: usize,\n    20\t    os_take_care_1g_2g: bool,\n    21\t    init_succ: bool,\n    22\t}\n    23\t\n    24\timpl LjmmState {\n    25\t    fn new() -> Self {\n    26\t        let page_size = 4096;\n    27\t        let addr_lowbound = heap_probe_addr();\n    28\t\n    29\t        Self {\n    30\t            page_size,\n    31\t            page_mask: page_size.saturating_sub(1),\n    32\t            addr_upbound: ADDR_2G,\n    33\t            addr_lowbound,\n    34\t            dummy_blk: vec![0; DUMMY_BLK_SZ],\n    35\t            map_file: \"/proc/self/maps\".to_string(),\n    36\t            buffer: vec![0; BUFFER_SZ],\n    37\t            buf_len: 0,\n    38\t            os_take_care_1g_2g: true,\n    39\t            init_succ: true,\n    40\t        }\n    41\t    }\n    42\t}\n    43\t\n    44\tstatic LJMM: LazyLock<Mutex<LjmmState>> = LazyLock::new(|| Mutex::new(LjmmState::new()));\n    45\t\n    46\tfn lock_state() -> MutexGuard<'static, LjmmState> {\n    47\t    match LJMM.lock() {\n    48\t        Ok(guard) => guard,\n    49\t        Err(poisoned) => poisoned.into_inner(),\n    50\t    }\n    51\t}\n    52\t\n    53\tfn heap_probe_addr() -> usize {\n    54\t    let probe = Box::new(0_u8);\n    55\t    (&*probe) as *const u8 as usize\n    56\t}\n    57\t\n    58\tfn page_align_addr(addr: usize, page_size: usize, page_mask: usize) -> usize {\n    59\t    (addr + page_size.saturating_sub(1)) & !page_mask\n    60\t}\n    61\t\n    62\tfn parse_addr(addr_str: &[u8]) -> (usize, usize) {\n    63\t    let mut addr = 0usize;\n    64\t    let mut consumed = 0usize;\n    65\t\n    66\t    for &byte in addr_str {\n    67\t        let digit = match byte {\n    68\t            b'0'..=b'9' => (byte - b'0') as usize,\n    69\t            b'a'..=b'f' => 10 + (byte - b'a') as usize,\n    70\t            b'A'..=b'F' => 10 + (byte - b'A') as usize,\n    71\t            _ => break,\n    72\t        };\n    73\t\n    74\t        addr = addr.saturating_mul(16).saturating_add(digit);\n    75\t        consumed += 1;\n    76\t    }\n    77\t\n    78\t    (addr, consumed)\n    79\t}\n    80\t\n    81\tfn read_maps_to_buffer(state: &mut LjmmState) -> std::io::Result<usize> {\n    82\t    let mut file = File::open(&state.map_file)?;\n    83\t    let mut len = file.read(&mut state.buffer[..BUFFER_SZ - 1])?;\n    84\t\n    85\t    if len > 0 && state.buffer[len - 1] != b'\\n' {\n    86\t        state.buffer[len] = b'\\n';\n    87\t        len += 1;\n    88\t    }\n    89\t\n    90\t    state.buf_len = len;\n    91\t    Ok(len)\n    92\t}\n    93\t\n    94\tfn find_best_fit(state: &mut LjmmState, length: usize) -> Option<usize> {\n    95\t    if read_maps_to_buffer(state).is_err() {\n    96\t        return None;\n    97\t    }\n    98\t\n    99\t    if state.buf_len == 0 {\n   100\t        return None;\n   101\t    }\n   102\t\n   103\t    let length = page_align_addr(length, state.page_size, state.page_mask);\n   104\t    let buffer = &state.buffer[..state.buf_len];\n   105\t    let lowbound = state.addr_lowbound;\n   106\t    let upbound = state.addr_upbound;\n   107\t\n   108\t    let mut best_fit_start = upbound;\n   109\t    let mut best_fit_size = usize::MAX;\n   110\t    let mut prev_blk_start = 0usize;\n   111\t    let mut prev_blk_size = 0usize;\n   112\t    let mut ofst = 0usize;\n   113\t\n   114\t    while ofst < buffer.len() {\n   115\t        let (start_addr, advance) = parse_addr(&buffer[ofst..]);\n   116\t        if advance == 0 || ofst + advance >= buffer.len() || buffer[ofst + advance] != b'-' {\n   117\t            break;\n   118\t        }\n   119\t        ofst += advance + 1;\n   120\t\n   121\t        let (mut end_addr, advance) = parse_addr(&buffer[ofst..]);\n   122\t        if advance > 0 && ofst + advance < buffer.len() && buffer[ofst + advance] == b' ' {\n   123\t            ofst += advance + 1;\n   124\t            while ofst < buffer.len() && buffer[ofst] != b'\\n' {\n   125\t                ofst += 1;\n   126\t            }\n   127\t            if ofst < buffer.len() {\n   128\t                ofst += 1;\n   129\t            }\n   130\t        } else {\n   131\t            end_addr = if upbound >= start_addr {\n   132\t                upbound\n   133\t            } else {\n   134\t                start_addr\n   135\t            };\n   136\t        }\n   137\t\n   138\t        end_addr = page_align_addr(end_addr, state.page_size, state.page_mask);\n   139\t\n   140\t        let hole_start = prev_blk_start.saturating_add(prev_blk_size);\n   141\t        let hole_size = start_addr.saturating_sub(hole_start);\n   142\t        let fits_upbound = hole_start\n   143\t            .checked_add(length)\n   144\t            .is_some_and(|end| end <= upbound);\n   145\t\n   146\t        if hole_size >= length\n   147\t            && hole_start >= lowbound\n   148\t            && fits_upbound\n   149\t            && hole_size < best_fit_size\n   150\t        {\n   151\t            best_fit_start = hole_start;\n   152\t            best_fit_size = hole_size;\n   153\t\n   154\t            if best_fit_size == length {\n   155\t                break;\n   156\t            }\n   157\t        }\n   158\t\n   159\t        if start_addr >= ADDR_1G && (!state.os_take_care_1g_2g || start_addr >= upbound) {\n   160\t            break;\n   161\t        }\n   162\t\n   163\t        if end_addr >= upbound {\n   164\t            break;\n   165\t        }\n   166\t\n   167\t        prev_blk_start = start_addr;\n   168\t        prev_blk_size = end_addr.saturating_sub(start_addr);\n   169\t    }\n   170\t\n   171\t    (best_fit_size != usize::MAX).then_some(best_fit_start)\n   172\t}\n   173\t\n   174\t/// Initializes the ljmm system.\n   175\t///\n   176\t/// # Returns\n   177\t/// An integer status code.\n   178\tpub fn ljmm_init() -> i32 {\n   179\t    let mut state = lock_state();\n   180\t    *state = LjmmState::new();\n   181\t    let _ = state.dummy_blk.len();\n   182\t\n   183\t    // Mirror the C implementation closely enough to validate setup and buffer parsing.\n   184\t    let _ = find_best_fit(&mut state, 1);\n   185\t\n   186\t    i32::from(state.init_succ)\n   187\t}\n   188\t/// Instructs the OS to take care of the [1G..2G] space.\n   189\t///\n   190\t/// # Parameters\n   191\t/// - `turn_on`: If non-zero, the OS should manage the space.\n   192\tpub fn ljmm_let_os_take_care_1g_2g(turn_on: i32) {\n   193\t    let mut state = lock_state();\n   194\t    state.os_take_care_1g_2g = turn_on != 0;\n   195\t}\n   196\t/// Sets test parameters for the ljmm system.\n   197\t///\n   198\t/// # Parameters\n   199\t/// - `map_file`: The mapping file name.\n   200\t/// - `sbrk0`: An address representing the current program break (as a safe usize).\n   201\t/// - `page_size`: The system's page size.\n   202\tpub fn ljmm_test_set_test_param(map_file: &str, sbrk0: usize, page_size: i32) {\n   203\t    let mut state = lock_state();\n   204\t    state.map_file = map_file.to_string();\n   205\t    state.addr_lowbound = sbrk0;\n   206\t\n   207\t    if let Ok(page_size) = usize::try_from(page_size) {\n   208\t        debug_assert!(page_size != 0 && page_size.is_power_of_two());\n   209\t        if page_size != 0 && page_size.is_power_of_two() {\n   210\t            state.page_size = page_size;\n   211\t            state.page_mask = page_size - 1;\n   212\t        }\n   213\t    }\n   214\t}\n   215\t\n   216\t#[cfg(test)]\n   217\tmod tests {\n   218\t    use super::{find_best_fit, LjmmState};\n   219\t\n   220\t    fn state_for(path: &str, lowbound: usize, os_take_care_1g_2g: bool) -> LjmmState {\n   221\t        let mut state = LjmmState::new();\n   222\t        state.map_file = path.to_string();\n   223\t        state.addr_lowbound = lowbound;\n   224\t        state.os_take_care_1g_2g = os_take_care_1g_2g;\n   225\t        state.page_size = 4096;\n   226\t        state.page_mask = 4095;\n   227\t        state\n   228\t    }\n   229\t\n   230\t    #[test]\n   231\t    fn best_fit_matches_fixture_001_case_1() {\n   232\t        let mut state = state_for(\"src/bin/test_input/input_001_001.txt\", 0, false);\n   233\t        assert_eq!(find_best_fit(&mut state, 32 * 1024 - 1), Some(0x418000));\n   234\t    }\n   235\t\n   236\t    #[test]\n   237\t    fn best_fit_matches_fixture_001_case_2() {\n   238\t        let mut state = state_for(\"src/bin/test_input/input_001_001.txt\", 0x619000, false);\n   239\t        assert_eq!(find_best_fit(&mut state, 32 * 1024 - 100), Some(0x619000));\n   240\t    }\n   241\t\n   242\t    #[test]\n   243\t    fn best_fit_matches_fixture_002_case_4() {\n   244\t        let mut state = state_for(\"src/bin/test_input/input_001_002.txt\", 0x619000, false);\n   245\t        assert_eq!(find_best_fit(&mut state, 32 * 1024 - 10), Some(0x619000));\n   246\t    }\n   247\t\n   248\t    #[test]\n   249\t    fn best_fit_handles_incomplete_last_range() {\n   250\t        let mut state = state_for(\"src/bin/test_input/input_001_003.txt\", 0x619000, false);\n   251\t        assert_eq!(find_best_fit(&mut state, 32 * 1024 - 10), None);\n   252\t    }\n   253\t\n   254\t    #[test]\n   255\t    fn best_fit_matches_fixture_004_case_6() {\n   256\t        let mut state = state