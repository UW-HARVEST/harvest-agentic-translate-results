{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,220p' c_src/src/tableau.c\"","aggregated_output":"\n/**\n * `tableau.c' - libbeaufort\n *\n * copyright (c) 2014 joseph werle <joseph.werle@gmail.com>\n */\n\n#include <stdlib.h>\n#include <stdio.h>\n#include <beaufort.h>\n\nstatic size_t\nssize (const char *str) {\n  size_t size = 0;\n  while ('\\0' != str[size]) size++;\n  return size;\n}\n\nchar **\nbeaufort_tableau (const char *alpha) {\n  size_t size = ssize(alpha);\n  char **mat = NULL;\n  int x = 0;\n  int y = 0;\n  int j = 0;\n\n  mat = (char **) calloc(size + 1, sizeof(char *));\n\n  if (NULL == mat) { return NULL; }\n\n  for (;y < size; ++y) {\n    mat[y] = (char *) calloc(size, sizeof(char));\n\n    if (NULL == mat[y]) { return NULL; }\n\n    for (x = 0, j = size; x < size; ++x, --j) {\n      mat[y][x] = alpha[(j + y) % size];\n    }\n\n    mat[y][x] = '\\0';\n  }\n\n  mat[y] = NULL;\n\n  return mat;\n}\n","exit_code":0,"status":"completed"}}
