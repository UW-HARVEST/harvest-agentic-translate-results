{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/amp.rs | sed -n '1,220p'\"","aggregated_output":"     1\tuse std::collections::HashMap;\n     2\tuse std::sync::{Mutex, OnceLock};\n     3\t\n     4\t/// Protocol version.\n     5\tpub const AMP_VERSION: i16 = 1;\n     6\t/// Message struct.\n     7\tpub struct Amp {\n     8\t    /// Protocol version.\n     9\t    pub version: i16,\n    10\t    /// Number of arguments.\n    11\t    pub argc: i16,\n    12\t    /// Encoded buffer.\n    13\t    pub buf: String,\n    14\t}\n    15\timpl Amp {\n    16\t    /// Decodes the given buffer into this message.\n    17\t    ///\n    18\t    /// # Arguments\n    19\t    ///\n    20\t    /// * `buf` - A string slice containing the encoded message.\n    21\t    pub fn decode(&mut self, buf: &str) {\n    22\t        let bytes = buf.as_bytes();\n    23\t        self.version = i16::from(bytes[0] >> 4);\n    24\t        self.argc = i16::from(bytes[0] & 0x0f);\n    25\t        self.buf = buf[1..].to_string();\n    26\t        cursor_map()\n    27\t            .lock()\n    28\t            .expect(\"amp cursor map poisoned\")\n    29\t            .insert(self as *const Self as usize, 0);\n    30\t    }\n    31\t    /// Decodes and returns the next argument from the message.\n    32\t    ///\n    33\t    /// # Returns\n    34\t    ///\n    35\t    /// A string slice representing the next decoded argument.\n    36\t    pub fn decode_arg(&mut self) -> &str {\n    37\t        let key = self as *const Self as usize;\n    38\t        let mut cursors = cursor_map().lock().expect(\"amp cursor map poisoned\");\n    39\t        let cursor = cursors.entry(key).or_insert(0);\n    40\t        let len = read_u32_be(&self.buf.as_bytes()[*cursor..*cursor + 4]) as usize;\n    41\t        let start = *cursor + 4;\n    42\t        let end = start + len;\n    43\t        *cursor = end;\n    44\t        &self.buf[start..end]\n    45\t    }\n    46\t}\n    47\t\n    48\timpl Drop for Amp {\n    49\t    fn drop(&mut self) {\n    50\t        if let Ok(mut cursors) = cursor_map().lock() {\n    51\t            cursors.remove(&(self as *const Self as usize));\n    52\t        }\n    53\t    }\n    54\t}\n    55\t\n    56\t/// Encodes the given arguments into a message buffer.\n    57\t///\n    58\t/// # Arguments\n    59\t///\n    60\t/// * `argv` - A slice of string slices representing the arguments.\n    61\t///\n    62\t/// # Returns\n    63\t///\n    64\t/// A `String` containing the encoded message.\n    65\tpub fn amp_encode(argv: &[&str]) -> String {\n    66\t    let mut buf = Vec::with_capacity(1 + argv.iter().map(|arg| 4 + arg.len()).sum::<usize>());\n    67\t    buf.push(((AMP_VERSION as u8) << 4) | (argv.len() as u8 & 0x0f));\n    68\t\n    69\t    for arg in argv {\n    70\t        let len = arg.len() as u32;\n    71\t        buf.extend_from_slice(&len.to_be_bytes());\n    72\t        buf.extend_from_slice(arg.as_bytes());\n    73\t    }\n    74\t\n    75\t    // AMP is a byte protocol; the length prefix is not guaranteed to be UTF-8.\n    76\t    unsafe { String::from_utf8_unchecked(buf) }\n    77\t}\n    78\t\n    79\tfn cursor_map() -> &'static Mutex<HashMap<usize, usize>> {\n    80\t    static CURSORS: OnceLock<Mutex<HashMap<usize, usize>>> = OnceLock::new();\n    81\t    CURSORS.get_or_init(|| Mutex::new(HashMap::new()))\n    82\t}\n    83\t\n    84\tfn read_u32_be(buf: &[u8]) -> u32 {\n    85\t    u32::from_be_bytes([buf[0], buf[1], buf[2], buf[3]])\n    86\t}\n","exit_code":0,"status":"completed"}}
