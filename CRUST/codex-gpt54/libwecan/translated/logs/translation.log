{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -c \"nl -ba src/libwecan.rs | sed -n '1,220p'\"","aggregated_output":"     1\tpub const FALSE: u8 = 0;\n     2\tpub const TRUE: u8 = 1;\n     3\tpub const UNSIGNED: u8 = 2;\n     4\tpub const SIGNED: u8 = 3;\n     5\tpub const INTEL: u8 = 4;\n     6\tpub const MOTOROLA: u8 = 5;\n     7\t\n     8\tfn mask_for_len(len: u8) -> u64 {\n     9\t    if len >= 64 {\n    10\t        u64::MAX\n    11\t    } else if len == 0 {\n    12\t        0\n    13\t    } else {\n    14\t        (1u64 << len) - 1\n    15\t    }\n    16\t}\n    17\t\n    18\tfn compute_indexes(startbit: u16, len: u8, endianness: u8) -> (u16, u16, u16) {\n    19\t    if len == 0 {\n    20\t        let byte_idx = startbit / 8;\n    21\t        return (startbit % 8, byte_idx, byte_idx);\n    22\t    }\n    23\t\n    24\t    if endianness == MOTOROLA {\n    25\t        let msb = startbit;\n    26\t        let mut current_bit_nr = startbit;\n    27\t\n    28\t        for _ in 0..usize::from(len.saturating_sub(1)) {\n    29\t            if current_bit_nr % 8 == 0 {\n    30\t                current_bit_nr = current_bit_nr.saturating_add(15);\n    31\t            } else {\n    32\t                current_bit_nr -= 1;\n    33\t            }\n    34\t        }\n    35\t\n    36\t        let lsb = current_bit_nr;\n    37\t        (lsb % 8, lsb / 8, msb / 8)\n    38\t    } else {\n    39\t        let lsb = startbit;\n    40\t        let msb = lsb.saturating_add(u16::from(len.saturating_sub(1)));\n    41\t        (lsb % 8, lsb / 8, msb / 8)\n    42\t    }\n    43\t}\n    44\t\n    45\tfn frame_to_local(frame: &[u8], byte_idx_lsb: u16, byte_idx_msb: u16, endianness: u8) -> u64 {\n    46\t    let mut bytes = [0u8; 8];\n    47\t    bytes[0] = frame[usize::from(byte_idx_lsb)];\n    48\t\n    49\t    if endianness == MOTOROLA {\n    50\t        for (dest_idx, src_idx) in (byte_idx_msb..byte_idx_lsb).rev().enumerate() {\n    51\t            bytes[dest_idx + 1] = frame[usize::from(src_idx)];\n    52\t        }\n    53\t    } else {\n    54\t        for (dest_idx, src_idx) in ((byte_idx_lsb + 1)..=byte_idx_msb).enumerate() {\n    55\t            bytes[dest_idx + 1] = frame[usize::from(src_idx)];\n    56\t        }\n    57\t    }\n    58\t\n    59\t    u64::from_le_bytes(bytes)\n    60\t}\n    61\t/// Extract a signal value from a CAN frame.\n    62\t///\n    63\t/// * `frame`      – byte slice of the frame data.\n    64\t/// * `startbit`   – signal start bit.\n    65\t/// * `len`        – signal length (in bits).\n    66\t/// * `signedness` – either UNSIGNED or SIGNED.\n    67\t/// * `endianness` – either INTEL (little-endian) or MOTOROLA (big-endian).\n    68\t///\n    69\t/// Returns a u64 value (if the signal is signed, it is already sign‐extended).\n    70\tpub fn extract(frame: &[u8], startbit: u16, len: u8, signedness: u8, endianness: u8) -> u64 {\n    71\t    let (offset_lsb, byte_idx_lsb, byte_idx_msb) = compute_indexes(startbit, len, endianness);\n    72\t    let mut target = frame_to_local(frame, byte_idx_lsb, byte_idx_msb, endianness);\n    73\t\n    74\t    target >>= offset_lsb;\n    75\t\n    76\t    let mask = mask_for_len(len);\n    77\t    target &= mask;\n    78\t\n    79\t    if signedness == SIGNED && len > 0 {\n    80\t        let sign_bit = if len >= 64 {\n    81\t            1u64 << 63\n    82\t        } else {\n    83\t            1u64 << (len - 1)\n    84\t        };\n    85\t\n    86\t        if target & sign_bit != 0 {\n    87\t            target |= !mask;\n    88\t        }\n    89\t    }\n    90\t\n    91\t    target\n    92\t}\n    93\t/// Insert a signal value into a CAN frame.\n    94\t///\n    95\t/// * `frame`     – mutable byte slice.\n    96\t/// * `startbit`  – signal start bit.\n    97\t/// * `len`       – signal length in bits.\n    98\t/// * `can_value` – signal value (as raw bits).\n    99\t/// * `endianness`– INTEL or MOTOROLA.\n   100\tpub fn insert(frame: &mut [u8], startbit: u16, len: u8, can_value: u64, endianness: u8) {\n   101\t    let (offset_lsb, byte_idx_lsb, byte_idx_msb) = compute_indexes(startbit, len, endianness);\n   102\t    let mut target = frame_to_local(frame, byte_idx_lsb, byte_idx_msb, endianness);\n   103\t\n   104\t    let mask = mask_for_len(len);\n   105\t    let shifted_mask = mask.checked_shl(u32::from(offset_lsb)).unwrap_or(0);\n   106\t    let erase_mask = !shifted_mask;\n   107\t\n   108\t    target = (target & erase_mask) | can_value.wrapping_shl(u32::from(offset_lsb));\n   109\t\n   110\t    let bytes = target.to_le_bytes();\n   111\t    if endianness == MOTOROLA {\n   112\t        for (src_idx, dst_idx) in (byte_idx_msb..=byte_idx_lsb).rev().enumerate() {\n   113\t            frame[usize::from(dst_idx)] = bytes[src_idx];\n   114\t        }\n   115\t    } else {\n   116\t        for (src_idx, dst_idx) in (byte_idx_lsb..=byte_idx_msb).enumerate() {\n   117\t            frame[usize::from(dst_idx)] = bytes[src_idx];\n   118\t        }\n   119\t    }\n   120\t}\n   121\t/// Encode an unsigned 64‑bit physical value into the CAN frame.\n   122\tpub fn encode_uint64_t(\n   123\t    frame: &mut [u8],\n   124\t    phy_value: u64,\n   125\t    startbit: u16,\n   126\t    len: u8,\n   127\t    endianness: u8,\n   128\t    factor: f64,\n   129\t    offset: f64,\n   130\t) {\n   131\t    let can_value = ((phy_value as f64 - offset) / factor) as u64;\n   132\t    insert(frame, startbit, len, can_value, endianness);\n   133\t}\n   134\t/// Encode a signed 64‑bit physical value into the CAN frame.\n   135\tpub fn encode_int64_t(\n   136\t    frame: &mut [u8],\n   137\t    phy_value: i64,\n   138\t    startbit: u16,\n   139\t    len: u8,\n   140\t    endianness: u8,\n   141\t    factor: f64,\n   142\t    offset: f64,\n   143\t) {\n   144\t    let can_value = ((phy_value as f64 - offset) / factor) as i64 as u64;\n   145\t    insert(frame, startbit, len, can_value, endianness);\n   146\t}\n   147\t/// 