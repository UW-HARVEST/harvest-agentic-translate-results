_PI / (N));              \\\n  (result).imag = -sin(2 * M_PI / (N));             \\\n} while (0)\n\n\n\nvoid fft(const fft_complex_t *restrict x, fft_complex_t *restrict X, size_t logsize);\nvoid fft_inplace(fft_complex_t *x, size_t logsize);\n\n#endif\n","exit_code":0,"status":"completed"}}
