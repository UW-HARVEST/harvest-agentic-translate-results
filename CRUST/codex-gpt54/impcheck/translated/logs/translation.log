{"type":"item.started","item":{"id":"item_112","type":"command_execution","command":"/bin/zsh -lc \"cat > /tmp/manual_sat.rs <<'EOF'\nuse impcheck::checker_interface::*;\nuse impcheck::trusted_utils::*;\nuse std::fs::{File, OpenOptions};\nuse std::io::{Read, Write};\nuse std::process::Command;\n\nfn create_pipe(path: &str) {\n    let _ = std::fs::remove_file(path);\n    let status = Command::new(\\\"mkfifo\\\").arg(path).status().unwrap();\n    assert\"'!(status.success());\n}\n\nfn await_ok(out: &mut File, input: &mut File) {\n    out.flush().unwrap();\n    let mut ok = [0u8; 1];\n    input.read_exact(&mut ok).unwrap();\n    eprintln!(\"resp={} {:?}\", ok[0] as char, ok);\n}\n\nfn main() {\n    let pipe_parsed = \"/tmp/manual.parsed.pipe\";\n    let pipe_directives = \"/tmp/manual.directives.pipe\";\n    let pipe_feedback = \"/tmp/manual.feedback.pipe\";\n    create_pipe(pipe_parsed);\n    create_pipe(pipe_directives);\n    create_pipe(pipe_feedback);\n\n    let mut parse_child = Command::new(\"./build/impcheck_parse\")\n        .arg(\"-formula-input=cnf/trivial-sat.cnf\")\n        .arg(format!(\"-fifo-parsed-formula={}\", pipe_parsed))\n        .spawn().unwrap();\n\n    let mut in_parsed = File::open(pipe_parsed).unwrap();\n    let nb_vars = trusted_utils_read_int(&mut in_parsed);\n    let nb_cls = trusted_utils_read_int(&mut in_parsed);\n    eprintln!(\"nb_vars={} nb_cls={}\", nb_vars, nb_cls);\n    let mut fvec = Vec::new();\n    loop {\n        let mut lit = [0u8; 4];\n        match in_parsed.read_exact(&mut lit) {\n            Ok(()) => fvec.push(i32::from_ne_bytes(lit)),\n            Err(_) => break,\n        }\n    }\n    parse_child.wait().unwrap();\n    eprintln!(\"fvec={:?}\", fvec);\n    let f = &fvec[..fvec.len() - (SIG_SIZE_BYTES / std::mem::size_of::<i32>())];\n    let mut fsig = vec![];\n    for i in &fvec[fvec.len() - 4..] { fsig.push(*i as u8); }\n    eprintln!(\"formula_sig={:02x?}\", fsig);\n\n    let mut check_child = Command::new(\"./build/impcheck_check\")\n        .arg(format!(\"-fifo-directives={}\", pipe_directives))\n        .arg(format!(\"-fifo-feedback={}\", pipe_feedback))\n        .arg(\"-check-model\")\n        .spawn().unwrap();\n\n    let mut out_directives = OpenOptions::new().write(true).open(pipe_directives).unwrap();\n    let mut in_feedback = File::open(pipe_feedback).unwrap();\n\n    trusted_utils_write_char(TRUSTED_CHK_INIT, &mut out_directives);\n    trusted_utils_write_int(nb_vars, &mut out_directives);\n    trusted_utils_write_sig(&fsig, &mut out_directives);\n    await_ok(&mut out_directives, &mut in_feedback);\n\n    trusted_utils_write_char(TRUSTED_CHK_LOAD, &mut out_directives);\n    trusted_utils_write_int(f.len() as i32, &mut out_directives);\n    trusted_utils_write_ints(f, f.len() as u64, &mut out_directives);\n\n    trusted_utils_write_char(TRUSTED_CHK_END_LOAD, &mut out_directives);\n    await_ok(&mut out_directives, &mut in_feedback);\n\n    trusted_utils_write_char(TRUSTED_CHK_VALIDATE_SAT, &mut out_directives);\n    trusted_utils_write_int(2, &mut out_directives);\n    trusted_utils_write_ints(&[1, -2], 2, &mut out_directives);\n    await_ok(&mut out_directives, &mut in_feedback);\n    let mut sig = [0u8; SIG_SIZE_BYTES];\n    trusted_utils_read_sig(&mut sig, &mut in_feedback);\n    eprintln!(\"sat_sig={:02x?}\", sig);\n\n    trusted_utils_write_char(TRUSTED_CHK_TERMINATE, &mut out_directives);\n    await_ok(&mut out_directives, &mut in_feedback);\n    drop(out_directives);\n    drop(in_feedback);\n    check_child.wait().unwrap();\n}\nEOF\nrustc --edition=2021 /tmp/manual_sat.rs -L dependency=target/debug/deps --extern impcheck=target/debug/libimpcheck.rlib -o /tmp/manual_sat\n/tmp/manual_sat'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
