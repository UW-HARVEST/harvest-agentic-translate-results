8\t    let mut deque = vec![0_usize; num_s_mers];\n    49\t    let mut front = 0_usize;\n    50\t    let mut back = 0_usize;\n    51\t\n    52\t    for i in 0..num_s_mers {\n    53\t        while back > front && s_mer_hashes[deque[back - 1]] > s_mer_hashes[i] {\n    54\t            back -= 1;\n    55\t        }\n    56\t        deque[back] = i;\n    57\t        back += 1;\n    58\t\n    59\t        if i >= window_size && deque[front] <= i - window_size {\n    60\t            front += 1;\n    61\t        }\n    62\t\n    63\t        if i >= window_size - 1 {\n    64\t            let min_pos = deque[front];\n    65\t            let kmer_pos = i - window_size + 1;\n    66\t            if min_pos == kmer_pos || min_pos == kmer_pos + k - s {\n    67\t                add_minimizer(results, num_results, s_mer_hashes[min_pos], kmer_pos, min_pos);\n    68\t            }\n    69\t        }\n    70\t    }\n    71\t}\n    72\tpub fn base_to_bits(base: char) -> u8 {\n    73\t    match base {\n    74\t        'A' | 'a' => 0,\n    75\t        'C' | 'c' => 1,\n    76\t        'G' | 'g' => 2,\n    77\t        'T' | 't' => 3,\n    78\t        _ => 0,\n    79\t    }\n    80\t}\n    81\tpub fn complement_base(base: u8) -> u8 {\n    82\t    3 - base\n    83\t}\n    84\tpub fn add_minimizer(results: &mut Vec<MinimizerResult>, size: &mut i32, minimizer_hash: u128, kmer_position: usize, smer_position: usize) {\n    85\t    results.push(MinimizerResult {\n    86\t        minimizer_hash,\n    87\t        kmer_position,\n    88\t        smer_position,\n    89\t    });\n    90\t    *size += 1;\n    91\t}\n    92\t\n    93\tfn mask_for_bases(s: usize) -> u128 {\n    94\t    let bit_width = 2 * s;\n    95\t    if bit_width >= u128::BITS as usize {\n    96\t        u128::MAX\n    97\t    } else {\n    98\t        (1_u128 << bit_width) - 1\n    99\t    }\n   100\t}\n","exit_code":0,"status":"completed"}}
