{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -c \"nl -ba src/parser.rs | sed -n '1,240p'\"","aggregated_output":"     1\tuse crate::{throw, slothvm};\n     2\tuse crate::slothvm::SlothProgram;\n     3\tpub fn parse(filename: &str) -> Option<SlothProgram> {\n     4\t    let bytes = match std::fs::read(filename) {\n     5\t        Ok(bytes) => bytes,\n     6\t        Err(_) => {\n     7\t            eprint!(\"[ERROR] File could not be opened.\");\n     8\t            std::process::exit(1);\n     9\t        }\n    10\t    };\n    11\t\n    12\t    let mut byte_code = Vec::new();\n    13\t    for line in bytes.split(|byte| *byte == b'\\n') {\n    14\t        if line.is_empty() {\n    15\t            continue;\n    16\t        }\n    17\t\n    18\t        let mut count = 0usize;\n    19\t        let len = line.len();\n    20\t        let mut current_code = 0u8;\n    21\t        let mut had_token = false;\n    22\t\n    23\t        while count < len {\n    24\t            let c = line[count];\n    25\t            if c == 0 || c == 0xFF || c == b'#' {\n    26\t                break;\n    27\t            }\n    28\t\n    29\t            if line[count..].starts_with(b\"slothy\") {\n    30\t                byte_code.push(0x01);\n    31\t                count += 6;\n    32\t                had_token = true;\n    33\t            } else if line[count..].starts_with(b\"sloth\") {\n    34\t                current_code = current_code.wrapping_add(1);\n    35\t                count += 5;\n    36\t                had_token = true;\n    37\t            } else if line[count..].starts_with(b\"and\") {\n    38\t                byte_code.push(current_code);\n    39\t                current_code = 0;\n    40\t                count += 3;\n    41\t                had_token = true;\n    42\t            } else if line[count..].starts_with(b\"nap\") {\n    43\t                byte_code.push(0x00);\n    44\t                count += 3;\n    45\t                had_token = true;\n    46\t            } else {\n    47\t                count += 1;\n    48\t            }\n    49\t        }\n    50\t\n    51\t        if had_token {\n    52\t            byte_code.push(current_code);\n    53\t        }\n    54\t    }\n    55\t\n    56\t    Some(SlothProgram { codes: byte_code, pc: 0 })\n    57\t}\n    58\tpub fn free_program(_program: Option<SlothProgram>) {\n    59\t    drop(_program);\n    60\t}\n    61\tpub fn readline(file: &std::fs::File) -> Option<String> {\n    62\t    use std::io::Read;\n    63\t\n    64\t    let mut handle = file;\n    65\t    let mut line = Vec::new();\n    66\t    let mut byte = [0u8; 1];\n    67\t\n    68\t    loop {\n    69\t        match handle.read(&mut byte) {\n    70\t            Ok(0) => {\n    71\t                line.push(0xFF);\n    72\t                break;\n    73\t            }\n    74\t            Ok(_) => {\n    75\t                if byte[0] == b'\\n' {\n    76\t                    break;\n    77\t                }\n    78\t                line.push(byte[0]);\n    79\t            }\n    80\t            Err(_) => return None,\n    81\t        }\n    82\t    }\n    83\t\n    84\t    Some(line.into_iter().map(char::from).collect())\n    85\t}\n    86\tpub fn prog_len(file: &std::fs::File) -> usize {\n    87\t    use std::io::{Read, Seek, SeekFrom};\n    88\t\n    89\t    let mut handle = file;\n    90\t    let mut count = 0usize;\n    91\t    let mut buf = [0u8; 4096];\n    92\t\n    93\t    loop {\n    94\t        match handle.read(&mut buf) {\n    95\t            Ok(0) => break,\n    96\t            Ok(read) => {\n    97\t                count += buf[..read].iter().filter(|byte| **byte == b'\\n').count();\n    98\t            }\n    99\t            Err(_) => return 0,\n   100\t        }\n   101\t    }\n   102\t\n   103\t    let _ = handle.seek(SeekFrom::Start(0));\n   104\t    count * 3\n   105\t}\n","exit_code":0,"status":"completed"}}
