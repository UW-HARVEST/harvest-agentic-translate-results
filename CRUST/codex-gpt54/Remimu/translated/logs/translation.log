e ensuring proper constraints.\n    48\t    pub fn push_to_vec(&mut self, tokens: &mut Vec<RegexToken>, max_len: usize) -> Result<(), i32> {\n    49\t        if tokens.is_empty()\n    50\t            || tokens[tokens.len() - 1].kind != self.kind\n    51\t            || (self.kind != REMIMU_KIND_BOUND && self.kind != REMIMU_KIND_NBOUND)\n    52\t        {\n    53\t            if self.mode & REMIMU_MODE_INVERTED != 0 {\n    54\t                self.invert_mask();\n    55\t            }\n    56\t            if tokens.len() >= max_len {\n    57\t                return Err(-2);\n    58\t            }\n    59\t            tokens.push(*self);\n    60\t            *self = RegexToken::default();\n    61\t        }\n    62\t        Ok(())\n    63\t    }\n    64\t}\n    65\timpl Default for RegexToken {\n    66\t    fn default() -> Self {\n    67\t        Self::new(REMIMU_KIND_NORMAL, 0)\n    68\t    }\n    69\t}\n    70\tpub struct RegexMatcherState {\n    71\t    pub k: u32,\n    72\t    pub group_state: u32,\n    73\t    pub prev: u32,\n    74\t    pub i: u64,\n    75\t    pub range_min: u64,\n    76\t    pub range_max: u64,\n    77\t}\n    78\timpl RegexMatcherState {\n    79\t    pub fn new(k: u32, i: u64) -> Self {\n    80\t        Self {\n    81\t            k,\n    82\t            group_state: 0,\n    83\t            prev: 0,\n    84\t            i,\n    85\t            range_min: 0,\n    86\t            range_max: 0,\n    87\t        }\n    88\t    }\n    89\t}\n    90\tconst AUX_STATS_SIZE: usize = 1024;\n    91\tconst STACK_SIZE_MAX: usize = 1024;\n    92\tconst DUMMY_PREV: u32 = 0xFAC7;\n    93\t\n    94\tfn pattern_byte(bytes: &[u8], idx: usize) -> u8 {\n    95\t    bytes.get(idx).copied().unwrap_or(0)\n    96\t}\n    97\t\n    98\tfn text_byte(bytes: &[u8], idx: u64) -> u8 {\n    99\t    bytes.get(idx as usize).copied().unwrap_or(0)\n   100\t}\n   101\t\n   102\tfn is_word(byte: u8) -> bool {\n   103\t    byte.is_ascii_digit() || byte.is_ascii_uppercase() || byte == b'_' || byte.is_ascii_lowercase()\n   104\t}\n   105\t\n   106\tfn parse_hex_quirky(bytes: &[u8], idx: usize) -> Result<u8, i32> {\n   107\t    if pattern_byte(bytes, idx + 1) == 0 || pattern_byte(bytes, idx + 2) == 0 {\n   108\t        return Err(-1);\n   109\t    }\n   110\t\n   111\t    // The original C code reads the same nibble twice. Preserve that behavior.\n   112\t    let mut n0 = pattern_byte(bytes, idx + 1);\n   113\t    let mut n1 = pattern_byte(bytes, idx + 1);\n   114\t    if !(n0.is_ascii_hexdigit() && n1.is_ascii_hexdigit()) {\n   115\t        return Err(-1);\n   116\t    }\n   117\t    if n0 > b'F' {\n   118\t        n0 -= 0x20;\n   119\t    }\n   120\t    if n1 > b'F' {\n   121\t        n1 -= 0x20;\n   122\t    }\n   123\t    if n0 >= b'A' {\n   124\t        n0 -= b'A' - 10;\n   125\t    }\n   126\t    if n1 >= b'A' {\n   127\t        n1 -= b'A' - 10;\n   128\t    }\n   129\t    n0 -= b'0';\n   130\t    n1 -= b'0';\n   131\t    Ok((n1 << 4) | n0)\n   132\t}\n   133\t\n   134\tfn apply_shorthand_mask(token: &mut RegexToken, c: u8) {\n   135\t    let is_upper = c.is_ascii_uppercase();\n   136\t    let c = c.to_ascii_lowercase();\n   137\t    let mut m = [0u16; 16];\n   138\t\n   139\t    if c == b'd' || c == b'w' {\n   140\t        m[3] |= 0x03FF;\n   141\t    }\n   142\t    if c == b's' {\n   143\t        m[0] |= 0x3E00;\n   144\t        m[2] |= 1;\n   145\t    }\n   146\t    if c == b'w' {\n   147\t        m[4] |= 0xFFFE;\n   148\t        m[5] |= 0x87FF;\n   149\t        m[6] |= 0xFFFE;\n   150\t        m[7] |= 0x07FF;\n   151\t    }\n   152\t\n   153\t    for (dst, src) in token.mask.iter_mut().zip(m) {\n   154\t        *dst |= if is_upper { !src } else { src };\n   155\t    }\n   156\t}\n   157\t\n   158\tstruct MatchCtx {\n   159\t    q_group_accepts_zero: [u8; AUX_STATS_SIZE],\n   160\t    q_group_state: [u32; AUX_STATS_SIZE],\n   161\t    q_group_stack: [u32; AUX_STATS_SIZE],\n   162\t    rewind_stack: Vec<RegexMatcherState>,\n   163\t    stack_n: usize,\n   164\t    i: u64,\n   165\t    range_min: u64,\n   166\t    range_max: u64,\n   167\t    just_rewinded: bool,\n   168\t}\n   169\t\n   170\timpl MatchCtx {\n   171\t    fn new(start_i: usize) -> Self {\n   172\t        Self {\n   173\t            q_group_accepts_zero: [0; AUX_STATS_SIZE],\n   174\t            q_group_state: [0; AUX_STATS_SIZE],\n   175\t            q_group_stack: [0; AUX_STATS_SIZE],\n   176\t            rewind_stack: Vec::with_capacity(STACK_SIZE_MAX),\n   177\t            stack_n: 0,\n   178\t            i: start_i as u64,\n   179\t            range_min: 0,\n   180\t            range_max: 0,\n   181\t            just_rewinded: false,\n   182\t        }\n   183\t    }\n   184\t\n   185\t    fn save_raw(&mut self, tokens: &[RegexToken], k: usize, is_dummy: bool) -> Result<(), i32> {\n   186\t        if self.stack_n >= STACK_SIZE_MAX {\n   187\t            return Err(-2);\n   188\t        }\n   189\t\n   190\t        let mut s = RegexMatcherState::new(k as u32, self.i);\n   191\t        s.range_min = self.range_min;\n   192\t        s.range_max = self.range_max;\n   193\t        if is_dummy {\n   194\t            s.prev = DUMMY_PREV;\n   195\t        } else if tokens[k].kind == REMIMU_KIND_CLOSE {\n   196\t            let group = tokens[k].mask[0] as usize;\n   197\t            s.group_state = self.q_group_state[group];\n   198\t            s.prev = self.q_group_stack[group];\n   199\t            self.q_group_stack[group] = self.stack_n as u32;\n   200\t        }\n   201\t\n   202\t        if self.stack_n == self.rewind_stack.len() {\n   203\t            self.rewind_stack.push(s);\n   204\t        } else {\n   205\t            self.rewind_stack[self.stack_n] = s;\n   206\t        }\n   207\t        self.stack_n += 1;\n   208\t        Ok(())\n   209\t    }\n   210\t\n   211\t    fn save(&mut self, tokens: &[RegexToken], k: usize) -> Result<(), i32> {\n   212\t        self.save_raw(tokens, k, false)\n   213\t    }\n   214\t\n   215\t