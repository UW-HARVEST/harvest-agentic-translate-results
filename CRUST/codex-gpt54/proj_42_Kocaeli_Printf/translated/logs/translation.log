{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -c \"nl -ba src/ft_printf.rs | sed -n '1,260p'\"","aggregated_output":"     1\tuse std::any::Any;\n     2\tuse std::cell::RefCell;\n     3\tuse std::io::{self, Write};\n     4\t// Constants\n     5\tpub const HEXALOW: &str = \"0123456789abcdef\";\n     6\tpub const DECIMAL: &str = \"0123456789\";\n     7\tpub const HEXAUP: &str = \"0123456789ABCDEF\";\n     8\tpub const LOCATION: i32 = 2;\n     9\t\n    10\tthread_local! {\n    11\t    static FORMAT_STATE: RefCell<(usize, usize, usize)> = const { RefCell::new((0, 0, 0)) };\n    12\t}\n    13\t\n    14\tfn write_bytes(bytes: &[u8], len: &mut i32) -> i32 {\n    15\t    let stdout = io::stdout();\n    16\t    let mut handle = stdout.lock();\n    17\t    for &byte in bytes {\n    18\t        *len += 1;\n    19\t        if handle.write_all(&[byte]).is_err() {\n    20\t            return -1;\n    21\t        }\n    22\t    }\n    23\t    1\n    24\t}\n    25\t\n    26\tfn next_arg<'a>(args: &'a [Box<dyn Any>]) -> Option<&'a Box<dyn Any>> {\n    27\t    let key = (args.as_ptr() as usize, args.len());\n    28\t    FORMAT_STATE.with(|state| {\n    29\t        let mut state = state.borrow_mut();\n    30\t        if state.0 != key.0 || state.1 != key.1 {\n    31\t            *state = (key.0, key.1, 0);\n    32\t        }\n    33\t\n    34\t        let index = state.2;\n    35\t        let arg = args.get(index);\n    36\t        if arg.is_some() {\n    37\t            state.2 += 1;\n    38\t        }\n    39\t        arg\n    40\t    })\n    41\t}\n    42\t\n    43\tfn as_char(arg: &Box<dyn Any>) -> Option<char> {\n    44\t    arg.downcast_ref::<char>().copied().or_else(|| {\n    45\t        arg.downcast_ref::<u8>().map(|c| char::from(*c)).or_else(|| {\n    46\t            arg.downcast_ref::<i8>()\n    47\t                .and_then(|c| u8::try_from(*c).ok())\n    48\t                .map(char::from)\n    49\t        })\n    50\t    })