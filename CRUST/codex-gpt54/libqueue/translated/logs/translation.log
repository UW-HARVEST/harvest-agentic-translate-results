{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,220p' src/queue.rs\"","aggregated_output":"struct QueueNode<T> {\n    value: T,\n    next: Option<Box<QueueNode<T>>>,\n}\npub struct Queue<T> {\n    pub head: Option<Box<QueueNode<T>>>,\n    pub tail: Option<*mut QueueNode<T>>, // Tail for efficient appending\n    pub size: usize,\n}\nimpl<T> Queue<T> {\n    /// Creates a new, empty queue.\n    pub fn new() -> Self {\n        Queue {\n            head: None,\n            tail: None,\n            size: 0,\n        }\n    }\n    /// Checks if the queue is empty.\n    pub fn is_empty(&self) -> bool {\n        self.size == 0\n    }\n    /// Adds a value to the back of the queue.\n    pub fn push(&mut self, value: T) {\n        let new_node = Box::new(QueueNode { value, next: None });\n\n        match self.head.as_mut() {\n            None => {\n                self.head = Some(new_node);\n                if let Some(head) = self.head.as_mut() {\n                    self.tail = Some(head.as_mut() as *mut QueueNode<T>);\n                }\n            }\n            Some(mut current) => {\n                while current.next.is_some() {\n                    current = current.next.as_mut().expect(\"next checked as some\");\n                }\n                current.next = Some(new_node);\n                if let Some(last) = current.next.as_mut() {\n                    self.tail = Some(last.as_mut() as *mut QueueNode<T>);\n                }\n            }\n        }\n\n        self.size += 1;\n    }\n    /// Removes and returns the value at the front of the queue.\n    pub fn pop(&mut self) -> Option<T> {\n        let mut head = self.head.take()?;\n        self.head = head.next.take();\n        self.size -= 1;\n\n        if self.size == 0 {\n            self.tail = None;\n        } else if let Some(current) = self.head.as_mut() {\n            let mut last = current;\n            while last.next.is_some() {\n                last = last.next.as_mut().expect(\"next checked as some\");\n            }\n            self.tail = Some(last.as_mut() as *mut QueueNode<T>);\n        }\n\n        Some(head.value)\n    }\n    /// Returns a reference to the value at the front of the queue.\n    pub fn front(&self) -> Option<&T> {\n        self.head.as_ref().map(|node| &node.value)\n    }\n    /// Returns a reference to the value at the back of the queue.\n    pub fn back(&self) -> Option<&T> {\n        let mut current = self.head.as_deref()?;\n        while let Some(next) = current.next.as_deref() {\n            current = next;\n        }\n        Some(&current.value)\n    }\n    /// Frees all nodes in the queue.\n    pub fn free(&mut self) {\n        self.head = None;\n        self.tail = None;\n        self.size = 0;\n    }\n}\n","exit_code":0,"status":"completed"}}
