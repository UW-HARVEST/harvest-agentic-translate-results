{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -c \"sed -n '1,220p' c_src/src/queue.c\"","aggregated_output":"#include <stdlib.h>\n#include <stdio.h>\n\n#include <include/queue.h>\n\nvoid\nqueue_new(queue_t *queue)\n{\n\tqueue->head = NULL;\n\tqueue->tail = NULL;\n\tqueue->size = 0;\n}\n\nbool\nqueue_empty(queue_t *queue)\n{\n\treturn queue->size == 0;\n}\n\nvoid\nqueue_push(queue_t *queue, void *value)\n{\n\tqueue_node_t *new_node = malloc(sizeof(queue_node_t));\n\tnew_node->value = value;\n\tnew_node->next = NULL;\n\n\tif(queue_empty(queue)) {\n\t\tqueue->tail = new_node;\n\t\tqueue->head = new_node;\n\t} else {\n\t\tqueue->tail->next = new_node;\n\t\tqueue->tail = new_node;\n\t}\n\n\tqueue->size++;\n}\n\nvoid *\nqueue_pop(queue_t *queue)\n{\n\tif(!queue || queue_empty(queue)) {\n\t\treturn NULL;\n\t}\n\n\tqueue_node_t *elem = queue->head;\n\tqueue->head = queue->head->next;\n\tvoid *value = elem->value;\n\n\tif(queue->size == 1) {\n\t\tqueue->tail = NULL;\n\t}\n\n\tqueue->size--;\n\n\tfree(elem);\n\n\treturn value;\n}\n\nvoid *\nqueue_front(queue_t *queue)\n{\n\tif(!queue) {\n\t\treturn NULL;\n\t}\n\n\tif(queue_empty(queue)) {\n\t\treturn NULL;\n\t}\n\n\treturn queue->head->value;\n}\n\nvoid *\nqueue_back(queue_t *queue)\n{\n\tif(!queue) {\n\t\treturn NULL;\n\t}\n\n\tif(queue_empty(queue)) {\n\t\treturn NULL;\n\t}\n\n\treturn queue->tail->value;\n}\n\nvoid\nqueue_free(queue_t *queue)\n{\n\tqueue_node_t *temp = queue->head;\n\tqueue_node_t *temp2;\n\twhile(temp) {\n\t\ttemp2 = temp;\n\t\ttemp = temp->next;\n\t\tfree(temp2);\n\t}\n}","exit_code":0,"status":"completed"}}
