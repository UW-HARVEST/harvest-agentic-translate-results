    non_n = [c for c in seq if c != 'N']
    counts = Counter(c.upper() for c in seq if c != 'N')
    print(f"  Base counts: A={counts.get('A',0)}, C={counts.get('C',0)}, T={counts.get('T',0)}, G={counts.get('G',0)}")
    print(f"  Total non-N: {len(non_n)}, Total: {size}")
    print(f"  Fractions: A={counts.get('A',0)/size}, C={counts.get('C',0)/size}, T={counts.get('T',0)/size}, G={counts.get('G',0)/size}")
