        v = struct.unpack_from('<I', bytes(data), off)[0]
        n_block_sizes.append(v)
        off += 4
    print(f"  nBlockSizes: {n_block_sizes}")
    
    mask_block_count = struct.unpack_from('<I', bytes(data), off)[0]
    off += 4
    print(f"  maskBlockCount: {mask_block_count}")
    
    mask_block_starts = []
    for j in range(mask_block_count):
        v = struct.unpack_from('<I', bytes(data), off)[0]
        mask_block_starts.append(v)
        off += 4
    print(f"  maskBlockStarts: {mask_block_starts}")
    
    mask_block_sizes = []
    for j in range(mask_block_count):
        v = struct.unpack_from('<I', bytes(data), off)[0]
        mask_block_sizes.append(v)
        off += 4
    print(f"  maskBlockSizes: {mask_block_sizes}")
    
    reserved = struct.unpack_from('<I', bytes(data), off)[0]
    off += 4
    print(f"  reserved: {reserved}")
    print(f"  data offset: 0x{off:x}")
    
    # Decode sequence
    seq_bytes = data[off:off + (size+3)//4]
    bases = "TCAG"
    seq = []
    for b in seq_bytes:
        for shift in [6, 4, 2, 0]:
            seq.append(bases[(b >> shift) & 3])
    seq = seq[:size]
    
    # Apply N mask
    for j in range(n_block_count):
        s = n_block_starts[j]
        for k in range(n_block_sizes[j]):
            if s+k < len(seq):
                seq[s+k] = 'N'
    
    # Apply soft mask
    for j in range(mask_block_count):
        s = mask_block_starts[j]
        for k in range(mask_block_sizes[j]):
            if s+k < len(seq) and seq[s+k] != 'N':
