    name_len = data[offset]
    offset += 1
    name = bytes(data[offset:offset+name_len]).decode()
    offset += name_len
    chrom_offset = struct.unpack_from('<I', bytes(data), offset)[0]
    offset += 4
    chroms.append(name)
    chrom_offsets.append(chrom_offset)
