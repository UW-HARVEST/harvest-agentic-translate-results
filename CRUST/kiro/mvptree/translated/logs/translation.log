use mvptree::mvptree::{MVPTree, MVPDatapoint, MVPDataType, MVPError, error_to_string};
use rand::{Rng, SeedableRng};
use rand::rngs::StdRng;

fn point_l2_distance(point_a: &MVPDatapoint, point_b: &MVPDatapoint) -> f32 {
    if point_a.data.len() != point_b.data.len() { return -1.0; }
    let sum: i32 = point_a.data.iter().zip(&point_b.data)
        .map(|(a, b)| (*a as i32 - *b as i32).pow(2)).sum();
    (sum as f32).sqrt() / point_a.data.len() as f32
}

fn generate_point(dp_length: usize) -> MVPDatapoint {
    let mut rng = StdRng::seed_from_u64(98293928);
    let id = format!("point{}", rng.gen::<u64>());
    let data: Vec<u8> = (0..dp_length).map(|_| rng.gen()).collect();
    MVPDatapoint::new(id, data, MVPDataType::ByteArray)
}

fn main() {
    let nbpoints = 100;
    let pointlist: Vec<MVPDatapoint> = (0..nbpoints).map(|_| generate_point(10)).collect();
    
    // Check if all points are identical
    let d = point_l2_distance(&pointlist[0], &pointlist[1]);
    eprintln!("Distance between first two points: {}", d);
    
    let mut tree = MVPTree::new(2, 5, 25, MVPDataType::ByteArray, point_l2_distance);
    let error = tree.add(pointlist);
    eprintln!("Add result: {:?}", error);
}
EOF
