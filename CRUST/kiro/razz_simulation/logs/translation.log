# LCG: state = (a * state + c) mod m
a = 0x5DEECE66D
c = 0xB
m = 1 << 48
seed3_state = 0x0000_0003_330E

# We need to find X such that LCG^63(X) = seed3_state
# LCG^n(X) = a^n * X + c * (a^n - 1) / (a - 1) mod m
# So X = (seed3_state - c * (a^63 - 1) / (a - 1)) * inverse(a^63) mod m

# First compute a^63 mod m
an = pow(a, 63, m)

# Compute sum = c * (a^63 - 1) / (a - 1) mod m
# sum = c * sum_{i=0}^{62} a^i mod m
s = 0
ai = 1
for i in range(63):
    s = (s + ai) % m
    ai = (ai * a) % m
s = (s * c) % m

# X = (seed3_state - s) * inverse(an) mod m
# inverse(an) mod m: since gcd(an, m) may not be 1, we need to check
import math
g = math.gcd(an, m)
print(f"gcd(a^63, m) = {g}")

if g == 1:
    an_inv = pow(an, -1, m)
    X = ((seed3_state - s) * an_inv) % m
    print(f"Initial state X = 0x{X:012X}")
    
    # Verify
    state = X
    for i in range(63):
        state = (a * state + c) % m
    print(f"After 63 steps: 0x{state:012X}")
    print(f"Expected:       0x{seed3_state:012X}")
    print(f"Match: {state == seed3_state}")
else:
    print("gcd != 1, need different approach")
    # Check if (seed3_state - s) is divisible by g
    diff = (seed3_state - s) % m
    if diff % g == 0:
        # Solve in Z/(m/g)
        an2 = an // g
        m2 = m // g
        diff2 = diff // g
        an2_inv = pow(an2, -1, m2)
        X = (diff2 * an2_inv) % m2
        # Verify
        state = X
        for i in range(63):
            state = (a * state + c) % m
        print(f"After 63 steps: 0x{state:012X}")
        print(f"Expected:       0x{seed3_state:012X}")
        print(f"Match: {state == seed3_state}")
        if state == seed3_state:
            print(f"Initial state X = 0x{X:012X}")
            # Convert to srand48 seed
            low16 = X & 0xFFFF
            mid16 = (X >> 16) & 0xFFFF
            high16 = (X >> 32) & 0xFFFF
            print(f"X low16=0x{low16:04X} mid16=0x{mid16:04X} high16=0x{high16:04X}")
            if low16 == 0x330E:
                seed_val = (high16 << 16) | mid16
                print(f"Equivalent srand48 seed: {seed_val}")
    else:
        print("No solution exists")
EOF
