            printf("%d: %s (idx=%d)\n", i, cardtostr(get_card_suit_rank(c)), get_card_suit_rank(c));
        }
    }
    destroy_deck(&d);
    
    // Now check state for next section
    printf("\nAfter dealing all 52, next lrand48 values:\n");
    for (int i = 0; i < 3; i++) {
        long v = lrand48();
        printf("lrand48() = %ld, mod 52 = %ld\n", v, v % 52);
    }
    
    return 0;
}
