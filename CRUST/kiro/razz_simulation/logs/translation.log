# Find seed X such that:
# 1. Call 51 gives % 52 = 21 (Heart9 for hand section first card)
# 2. Calls 64-52063 match the expected distribution

# The expected distribution is lrand48() % 52 for calls 1-52000 from seed 3
# So we need state at call 63 = seed 3 state = 0x0000_0003_330E

# LCG parameters
a = 0x5DEECE66D
c_val = 0xB
m = 1 << 48

# Compute state after N steps from initial state X
# state_N = a^N * X + c * (a^N - 1) / (a - 1) mod m

# We need state_63 = 0x0000_0003_330E
# state_63 = a^63 * X + S_63 mod m
# where S_63 = c * sum_{i=0}^{62} a^i mod m

target = 0x0000_0003_330E

an = pow(a, 63, m)
s = 0
ai = 1
for i in range(63):
    s = (s + ai) % m
    ai = (ai * a) % m
s = (s * c_val) % m

# X = (target - s) * inverse(an) mod m
import math
g = math.gcd(an, m)
assert g == 1
an_inv = pow(an, -1, m)
X = ((target - s) * an_inv) % m

# Verify
state = X
for i in range(63):
    state = (a * state + c_val) % m
assert state == target, f"State after 63 steps: {state:#014x}, expected: {target:#014x}"

# Now check what call 51 gives
state = X
for i in range(51):
    state = (a * state + c_val) % m
val51 = state >> 17
print(f"Call 51: lrand48() = {val51}, % 52 = {val51 % 52}")

# Check call 1 (first deal in deck section)
state = X
state = (a * state + c_val) % m
val1 = state >> 17
print(f"Call 1: lrand48() = {val1}, % 52 = {val1 % 52}")

# Check what srand48 seed would give state X
# X = (seed << 16) | 0x330E
# seed = (X >> 16) if (X & 0xFFFF) == 0x330E
low16 = X & 0xFFFF
print(f"X = 0x{X:012X}, low16 = 0x{low16:04X}")
if low16 == 0x330E:
    seed_val = X >> 16
    print(f"Equivalent srand48 seed: {seed_val}")
else:
    print("X is not a valid srand48 state (low16 != 0x330E)")
    print(f"Need to use seed48 with: [{X & 0xFFFF:#06x}, {(X >> 16) & 0xFFFF:#06x}, {(X >> 32) & 0xFFFF:#06x}]")

# Also check: what are the first few cards dealt from this seed?
state = X
cards = []
for i in range(10):
    state = (a * state + c_val) % m
    val = state >> 17
    cards.append(val % 52)
print(f"First 10 card indices: {cards}")

# Card names for reference
names = [
    "SA","S2","S3","S4","S5","S6","S7","S8","S9","S10","SJ","SQ","SK",
    "HA","H2","H3","H4","H5","H6","H7","H8","H9","H10","HJ","HQ","HK",
    "DA","D2","D3","D4","D5","D6","D7","D8","D9","D10","DJ","DQ","DK",
    "CA","C2","C3","C4","C5","C6","C7","C8","C9","C10","CJ","CQ","CK",
]
print(f"First 10 cards: {[names[i] for i in cards]}")
EOF
