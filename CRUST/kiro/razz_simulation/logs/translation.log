        card_count[get_card_suit_rank(c)]++;
        destroy_deck(&d);
    }
    for (int i = 0; i < 52; i++) {
        printf("%lu, ", card_count[i]);
        if ((i+1) % 13 == 0) printf("\n");
    }
    
    return 0;
}
