// Print
pub fn tisp_print(f: &mut std::fs::File, v: &Val) {
    let s = val_to_string(v);
    let _ = f.write_all(s.as_bytes());
}

pub fn val_to_string(v: &Val) -> String {
    match v.t {
        TspType::TspNone => "Void".to_string(),
        TspType::TspNil => "Nil".to_string(),
        TspType::TspInt => format!("{}", num(v) as i32),
        TspType::TspDec => {
            let n = num(v);
            let s = format!("{:.15g}", n);
            if n == (n as i32) as f64 && !s.contains('e') && !s.contains('E') {
                format!("{}.0", s)
            } else {
                s
            }
        }
        TspType::TspRatio => format!("{}/{}", num(v) as i32, den(v) as i32),
        TspType::TspStr | TspType::TspSym => sym_str(v).to_string(),
        TspType::TspFunc | TspType::TspMacro => {
            if let ValUnion::F { ref name, .. } = v.v {
                let tname = if v.t == TspType::TspFunc { "function" } else { "macro" };
                if name.is_empty() {
                    format!("#<{}>", tname)
                } else {
                    format!("#<{}:{}>", tname, name)
                }
            } else { String::new() }
        }
        TspType::TspPrim => {
            if let ValUnion::Pr { ref name, .. } = v.v { format!("#<primitive:{}>", name) }
            else { String::new() }
        }
        TspType::TspForm => {
            if let ValUnion::Pr { ref name, .. } = v.v { format!("#<form:{}>", name) }
            else { String::new() }
        }
        TspType::TspRec => {
            let mut s = "{".to_string();
            if let ValUnion::R(ref r) = v.v {
                let mut rec = Some(r);
                while let Some(cur) = rec {
                    let mut c = 0;
                    for i in 0..cur.items.len() {
                        if !cur.items[i].key.is_empty() {
                            c += 1;
                            s.push_str(&format!(" {}: ", cur.items[i].key));
                            s.push_str(&val_to_string(&cur.items[i].val));
                        }
                        if c >= TSP_REC_MAX_PRINT { s.push_str(" ..."); break; }
                    }
                    rec = cur.next.as_deref();
                }
            }
            s.push_str(" }");
            s
        }
        TspType::TspPair => {
            let mut s = "(".to_string();
            s.push_str(&val_to_string(car(v)));
            let mut cur = cdr(v);
            while !nilp(cur) {
                if cur.t == TspType::TspPair {
                    s.push(' ');
                    s.push_str(&val_to_string(car(cur)));
                    cur = cdr(cur);
                } else {
                    s.push_str(" . ");
                    s.push_str(&val_to_string(cur));
                    break;
                }
            }
            s.push(')');
            s
        }
    }
}

pub fn tisp_print_to_stderr(v: &Val) {
    eprint!("{}", val_to_string(v));
}

// Environment
pub fn tisp_env_add(st: &mut Tsp, key: &str, v: Val) {
    rec_add(&mut st.env, key, v);
}

pub fn tisp_env_init(cap: usize) -> Tsp {
    let nil = mk_nil();
    let none = mk_none();
    let t_val = Val { t: TspType::TspSym, v: ValUnion::S("True".to_string()) };
    let mut st = Tsp {
        file: String::new(),
        filec: 0,
        none: clone_val(&none),
        nil: clone_val(&nil),
        t: clone_val(&t_val),
        env: rec_new(cap, None),
        strs: rec_new(cap, None),
        syms: rec_new(cap, None),
        libh: Vec::new(),
        libhc: 0,
    };
    tisp_env_add(&mut st, "True", clone_val(&t_val));
    tisp_env_add(&mut st, "Nil", clone_val(&nil));
    tisp_env_add(&mut st, "Void", clone_val(&none));
    tisp_env_add(&mut st, "bt", mk_nil());
    let ver = mk_str(&mut st, "0.1");
    tisp_env_add(&mut st, "version", ver);
    st
}

pub fn tisp_env_lib(st: &mut Tsp, lib: &str) {
    let old_file = std::mem::replace(&mut st.file, lib.to_string());
    let old_filec = std::mem::replace(&mut st.filec, 0);
    skip_ws(st, 1);
    if let Some(v) = tisp_read(st) {
        let _ = tisp_eval_body(st, &mut st.env, v);
    }
    st.file = old_file;
    st.filec = old_filec;
}

// Re-export tib_env functions
pub fn tib_env_core(st: &mut Tsp) { crate::core::tib_env_core(st); }
pub fn tib_env_math(st: &mut Tsp) { crate::math::tib_env_math(st); }
pub fn tib_env_string(st: &mut Tsp) { crate::string::tib_env_string(st); }
pub fn tib_env_io(st: &mut Tsp) { crate::io::tib_env_io(st); }
pub fn tib_env_os(st: &mut Tsp) { crate::os::tib_env_os(st); }

// Public helpers used by other modules
pub fn tsp_arg_num_check_pub(args: &Val, name: &str, nargs: i32) -> Option<()> { tsp_arg_num_check(args, name, nargs) }
pub fn tsp_arg_min_check_pub(args: &Val, name: &str, nargs: i32) -> Option<()> { tsp_arg_min_check(args, name, nargs) }
pub fn tsp_arg_type_check_pub(arg: &Val, name: &str, type_mask: u32) -> Option<()> { tsp_arg_type_check(arg, name, type_mask) }
pub fn tisp_eval_with_env_pub(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> { tisp_eval_with_env(st, env, v) }
pub fn tisp_eval_list_pub(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> { tisp_eval_list(st, env, v) }
pub fn tisp_eval_body_pub(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> { tisp_eval_body(st, env, v) }
pub fn eval_proc_pub(st: &mut Tsp, env: &mut Rec, f: Val, args: Val) -> Option<Val> { eval_proc(st, env, f, args) }
pub fn clone_val_pub(v: &Val) -> Val { clone_val(v) }
pub fn clone_rec_pub(r: &Rec) -> Rec { clone_rec(r) }
pub fn car_pub(v: &Val) -> &Val { car(v) }
pub fn cdr_pub(v: &Val) -> &Val { cdr(v) }
pub fn num_pub(v: &Val) -> f64 { num(v) }
pub fn den_pub(v: &Val) -> f64 { den(v) }
pub fn sym_str_pub(v: &Val) -> &str { sym_str(v) }
pub fn nilp_pub(v: &Val) -> bool { nilp(v) }
pub fn is_type_pub(v: &Val, mask: u32) -> bool { is_type(v, mask) }
pub fn mk_nil_pub() -> Val { mk_nil() }
pub fn mk_none_pub() -> Val { mk_none() }
pub fn val_to_string_pub(v: &Val) -> String { val_to_string(v) }
pub fn tsp_type_str_mask_pub(t: u32) -> &'static str { tsp_type_str_mask(t) }

// Error sentinel
pub fn mk_error() -> Val {
    Val { t: TspType::TspNil, v: ValUnion::S("__ERROR__".to_string()) }
}
pub fn is_error(v: &Val) -> bool {
    v.t == TspType::TspNil && matches!(&v.v, ValUnion::S(s) if s == "__ERROR__")
}
