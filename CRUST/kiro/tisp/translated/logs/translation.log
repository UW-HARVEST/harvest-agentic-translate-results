pub fn read_pair(st: &mut Tsp, endchar: char) -> Option<Val> {
    let skipnl = endchar != '\n';
    skip_ws(st, if skipnl { 1 } else { 0 });
    let mut items: Vec<Val> = Vec::new();
    let mut improper_cdr: Option<Val> = None;
    while let Some(c) = fget(st) {
        if c == endchar { break; }
        if c == '\0' { break; }
        let v = tisp_read(st)?;
        // Check for dot (improper list)
        if v.t == TspType::TspSym {
            if let ValUnion::S(ref s) = v.v {
                if s == "." {
                    skip_ws(st, if skipnl { 1 } else { 0 });
                    improper_cdr = Some(tisp_read(st)?);
                    break;
                }
            }
        }
        items.push(v);
        skip_ws(st, if skipnl { 1 } else { 0 });
    }
    skip_ws(st, if skipnl { 1 } else { 0 });
    if skipnl {
        if fget(st) != Some(endchar) {
            eprintln!("; tisp: error: did not find closing '{}'", endchar);
            return None;
        }
    }
    st.filec += 1; // skip endchar
    // Build the list from items
    let tail = improper_cdr.unwrap_or_else(mk_nil);
    let mut result = tail;
    for v in items.into_iter().rev() {
        result = mk_pair(v, result);
    }
    Some(result)
}

pub fn tisp_read_sexpr(st: &mut Tsp) -> Option<Val> {
    let prefixes: &[(&str, &str)] = &[
        ("'", "quote"),
        ("`", "quasiquote"),
        (",@", "unquote-splice"),
        (",", "unquote"),
        ("@", "Func"),
        ("f\"", "strformat"),
    ];
    skip_ws(st, 1);
    if st.filec >= st.file.len() { return Some(mk_none()); }
    let remaining = &st.file[st.filec..];
    if remaining.is_empty() { return Some(mk_none()); }
    if isnum(remaining) { return Some(read_num(st)); }
    if fget(st) == Some('"') {
        return read_str(st, mk_str_wrapper);
    }
    if fget(st) == Some('~') {
        return read_str(st, mk_sym_wrapper);
    }
    // Check prefixes
    for &(prefix, name) in prefixes {
        if remaining.starts_with(prefix) {
            let skip = prefix.len() - if prefix.len() > 1 && prefix.as_bytes()[1] == b'"' { 1 } else { 0 };
            st.filec += skip;
            let v = tisp_read(st)?;
            let sym = mk_sym(st, name);
            return Some(mk_list(st, 2, vec![sym, v]));
        }
    }
    if let Some(c) = fget(st) {
        if is_op(c) { return read_sym(st, is_op); }
        if is_sym(c) { return read_sym(st, is_sym); }
        if c == '(' {
            st.filec += 1;
            return read_pair(st, ')');
        }
        if c == '[' {
            st.filec += 1;
            let lst = read_pair(st, ']')?;
            let sym = mk_sym(st, "list");
            return Some(mk_pair(sym, lst));
        }
        if c == '{' {
            st.filec += 1;
            let v = read_pair(st, '}')?;
            let sym = mk_sym(st, "Rec");
            return Some(mk_pair(sym, v));
        }
        eprintln!("; tisp: error: could not read given input '{}' ({})", c, c as u32);
        return None;
    }
    Some(mk_none())
}

// Wrapper functions for read_str that match fn(&mut Tsp, &str) -> Val
fn mk_str_wrapper(st: &mut Tsp, s: &str) -> Val { mk_str(st, s) }
fn mk_sym_wrapper(st: &mut Tsp, s: &str) -> Val { mk_sym(st, s) }

pub fn tisp_read(st: &mut Tsp) -> Option<Val> {
    let v = tisp_read_sexpr(st)?;
    let mut result = v;
    loop {
        match fget(st) {
            Some('(') | Some(':') | Some('{') => {
                result = tisp_read_sugar(st, result)?;
            }
            Some('>') if fgetat(st, 1) == Some('>') => {
                result = tisp_read_sugar(st, result)?;
            }
            _ => break,
        }
    }
    Some(result)
}

pub fn tisp_read_sugar(st: &mut Tsp, v: Val) -> Option<Val> {
    match fget(st) {
        Some('(') => {
            st.filec += 1;
            let lst = read_pair(st, ')')?;
            Some(mk_pair(v, lst))
        }
        Some('{') => {
            st.filec += 1;
            let lst = read_pair(st, '}')?;
            let sym = mk_sym(st, "recmerge");
            let rec_sym = mk_sym(st, "Rec");
            let rec_pair = mk_pair(rec_sym, lst);
            Some(mk_list(st, 3, vec![sym, v, rec_pair]))
        }
        Some(':') => {
            st.filec += 1;
            match fget(st) {
                Some('(') => {
                    st.filec += 1;
                    let w = read_pair(st, ')')?;
                    let sym = mk_sym(st, "map");
                    Some(mk_pair(sym, mk_pair(v, w)))
                }
                Some(':') => {
                    st.filec += 1;
                    let w = read_sym(st, is_sym)?;
                    let quote_sym = mk_sym(st, "quote");
                    let quoted = mk_list(st, 2, vec![quote_sym, w]);
                    Some(mk_list(st, 2, vec![v, quoted]))
                }
                _ => {
                    skip_ws(st, 1);
                    let w = tisp_read(st)?;
                    Some(mk_list(st, 2, vec![v, w]))
                }
            }
        }
        Some('>') if fgetat(st, 1) == Some('>') => {
            st.filec += 2;
            let w = tisp_read(st)?;
            if w.t != TspType::TspPair {
                eprintln!("; tisp: error: invalid UFCS");
                return None;
            }
            let w_car = clone_val(car(&w));
            let w_cdr = clone_val(cdr(&w));
            Some(mk_pair(w_car, mk_pair(v, w_cdr)))
        }
        _ => Some(v),
    }
}

pub fn tisp_read_line(st: &mut Tsp, level: i32) -> Option<Val> {
    let mut ret = read_pair(st, '\n')?;
    if ret.t != TspType::TspPair {
        ret = mk_pair(ret, mk_nil());
    }
    // Get last pair
    fn last_pair_len(v: &Val) -> usize {
        let mut count = 0;
        let mut cur = v;
        while cur.t == TspType::TspPair && cdr(cur).t == TspType::TspPair {
            count += 1;
            cur = cdr(cur);
        }
        count
    }
    // Read indented lines as sub expressions
    loop {
        if fget(st).is_none() { break; }
        // Count leading whitespace
        let mut newlevel = 0i32;
        while let Some(c) = fget(st) {
            if c == '\t' || c == ' ' { newlevel += 1; st.filec += 1; } else { break; }
        }
        if newlevel <= level {
            st.filec -= newlevel as usize; // put back
            break;
        }
        let sub = tisp_read_line(st, newlevel)?;
        // Append sub to the end of ret
        ret = append_to_list(ret, sub);
    }
    // If only 1 element, return just it
    if ret.t == TspType::TspPair && nilp(cdr(&ret)) {
        let c = car(&ret);
        return Some(clone_val(c));
    }
    Some(ret)
}

fn append_to_list(mut lst: Val, item: Val) -> Val {
    // Insert item before the last cdr (which should be nil)
    // We need to find the last pair and insert before its cdr
    fn get_last_pair_and_insert(v: &mut Val, item: Val) {
        if v.t == TspType::TspPair {
            if let ValUnion::P { cdr, .. } = &v.v {
                if cdr.t == TspType::TspPair {
                    if let ValUnion::P { cdr: ref mut c, .. } = v.v {
                        get_last_pair_and_insert(c.as_mut(), item);
                        return;
                    }
                }
            }
            // This is the last pair - insert item between this and cdr
            if let ValUnion::P { ref mut cdr, .. } = v.v {
                let old_cdr = std::mem::replace(cdr.as_mut(), mk_nil());
                *cdr = Box::new(mk_pair(item, old_cdr));
            }
        }
    }
    get_last_pair_and_insert(&mut lst, item);
    lst
}
