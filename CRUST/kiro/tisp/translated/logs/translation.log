// Fix mk_list - creates a proper list from a vec of vals
pub fn mk_list(st: &mut Tsp, _n: i32, args: Vec<Val>) -> Val {
    let mut iter = args.into_iter();
    let first = iter.next().unwrap();
    let mut lst = mk_pair(first, mk_nil());
    // We need to get a mutable ref to the cdr chain
    let mut cur = &mut lst;
    for arg in iter {
        let new_pair = mk_pair(arg, mk_nil());
        if let ValUnion::P { cdr, .. } = &mut cur.v {
            *cdr = Box::new(new_pair);
            cur = cdr.as_mut();
        }
    }
    lst
}

pub fn mk_rec(st: &mut Tsp, env: Rec, assoc: Val) -> Val {
    let mut ret = mk_val(TspType::TspRec);
    if assoc.t == TspType::TspNil && matches!(assoc.v, ValUnion::N { .. }) {
        // No assoc - just wrap the env
        ret.v = ValUnion::R(env);
        return ret;
    }
    let cap = TSP_REC_FACTOR * tsp_lstlen(&assoc).unsigned_abs() as usize;
    let cap = if cap > 0 { cap } else { 1 };
    let mut r = rec_new(cap, None);
    let mut env_rec = rec_new(4, Some(Box::new(env)));
    ret.v = ValUnion::R(rec_new(cap, None));
    rec_add(&mut env_rec, "this", clone_val(&ret));
    let mut cur = &assoc;
    while cur.t == TspType::TspPair {
        let item = car(cur);
        if item.t == TspType::TspPair {
            let k = car(item);
            if is_type(k, TspType::TspSym as u32 | TspType::TspStr as u32) {
                let key = sym_str(k).to_string();
                let val_expr = car(cdr(item));
                if let Some(v) = tisp_eval_with_env(st, &mut env_rec, clone_val(val_expr)) {
                    if let ValUnion::R(ref mut rec) = ret.v {
                        rec_add(rec, &key, v);
                    }
                } else {
                    return mk_nil(); // error
                }
            }
        } else if item.t == TspType::TspSym {
            let key = sym_str(item).to_string();
            if let Some(v) = tisp_eval_with_env(st, &mut env_rec, clone_val(item)) {
                if let ValUnion::R(ref mut rec) = ret.v {
                    rec_add(rec, &key, v);
                }
            } else {
                return mk_nil();
            }
        } else {
            eprintln!("; tisp: error: Rec: missing key symbol or string");
            return mk_nil();
        }
        cur = cdr(cur);
    }
    ret
}

// Reader functions
pub fn skip_ws(st: &mut Tsp, skipnl: i32) {
    let skip_chars: &str = if skipnl != 0 { " \t\n\r" } else { " \t" };
    loop {
        if st.filec >= st.file.len() { break; }
        let c = st.file.as_bytes()[st.filec] as char;
        if skip_chars.contains(c) {
            // skip whitespace
            while st.filec < st.file.len() && skip_chars.contains(st.file.as_bytes()[st.filec] as char) {
                st.filec += 1;
            }
        } else if c == ';' {
            // skip comment until newline
            while st.filec < st.file.len() && st.file.as_bytes()[st.filec] as char == ';' {
                while st.filec < st.file.len() && st.file.as_bytes()[st.filec] as char != '\n' {
                    st.filec += 1;
                }
                if skipnl == 0 { break; }
                if st.filec < st.file.len() { st.filec += 1; } // skip the newline
                // skip more whitespace
                while st.filec < st.file.len() && skip_chars.contains(st.file.as_bytes()[st.filec] as char) {
                    st.filec += 1;
                }
            }
        } else {
            break;
        }
    }
}

fn fget(st: &Tsp) -> Option<char> {
    st.file.as_bytes().get(st.filec).map(|&b| b as char)
}

fn fgetat(st: &Tsp, offset: isize) -> Option<char> {
    let idx = st.filec as isize + offset;
    if idx < 0 { return None; }
    st.file.as_bytes().get(idx as usize).map(|&b| b as char)
}

pub fn read_sign(st: &mut Tsp) -> i32 {
    match fget(st) {
        Some('-') => { st.filec += 1; -1 }
        Some('+') => { st.filec += 1; 1 }
        _ => 1,
    }
}

pub fn read_int(st: &mut Tsp) -> i32 {
    let mut ret = 0i32;
    while let Some(c) = fget(st) {
        if !c.is_ascii_digit() { break; }
        ret = ret * 10 + (c as i32 - '0' as i32);
        st.filec += 1;
    }
    ret
}

pub fn read_sci(st: &mut Tsp, val: f64, isint: i32) -> Option<Val> {
    let mut v = val;
    if let Some(c) = fget(st) {
        if c == 'e' || c == 'E' {
            st.filec += 1;
            let sign_val = if read_sign(st) == 1 { 10.0 } else { 0.1 };
            let expo = read_int(st);
            for _ in 0..expo { v *= sign_val; }
        }
    }
    if isint != 0 { Some(mk_int(v as i32)) } else { mk_dec(v) }
}

pub fn read_num(st: &mut Tsp) -> Val {
    let sign = read_sign(st);
    let n = read_int(st);
    match fget(st) {
        Some('/') => {
            st.filec += 1;
            if !isnum(&st.file[st.filec..]) {
                eprintln!("; tisp: error: incorrect ratio format, no denominator found");
                return mk_nil();
            }
            let ds = read_sign(st);
            let d = read_int(st);
            mk_rat(sign * n, ds * d).unwrap_or_else(mk_nil)
        }
        Some('.') => {
            st.filec += 1;
            let oldc = st.filec;
            let frac = read_int(st);
            let size = st.filec - oldc;
            let mut d = frac as f64;
            for _ in 0..size { d /= 10.0; }
            read_sci(st, sign as f64 * (n as f64 + d), 0).unwrap_or_else(mk_nil)
        }
        _ => read_sci(st, sign as f64 * n as f64, 1).unwrap_or_else(mk_nil),
    }
}

pub fn esc_char(c: char) -> char {
    match c {
        'n' => '\n',
        'r' => '\r',
        't' => '\t',
        '\n' => ' ',
        _ => c,
    }
}

pub fn esc_str(s: &str, len: i32, do_esc: i32) -> String {
    let bytes = s.as_bytes();
    let mut ret = String::new();
    let mut i = 0usize;
    let mut count = 0;
    while count < len as usize && i < bytes.len() {
        if bytes[i] == b'\\' && do_esc != 0 {
            i += 1;
            if i < bytes.len() {
                ret.push(esc_char(bytes[i] as char));
            }
        } else {
            ret.push(bytes[i] as char);
        }
        i += 1;
        count += 1;
    }
    ret
}

pub fn read_str(st: &mut Tsp, mk_fn: fn(&mut Tsp, &str) -> Val) -> Option<Val> {
    let is_str = {
        // Check if this is mk_str by checking the endchar
        fget(st) == Some('"')
    };
    let endchar = if is_str { '"' } else { '~' };
    st.filec += 1; // skip opening quote
    let start = st.filec;
    let mut len = 0i32;
    loop {
        match fget(st) {
            None => {
                eprintln!("; tisp: error: reached end before closing {}", endchar);
                return None;
            }
            Some(c) if c == endchar => break,
            Some('\\') => {
                if fgetat(st, -1) != Some('\\') {
                    st.filec += 1; // skip escaped char
                }
                st.filec += 1;
                len += 1;
            }
            _ => { st.filec += 1; len += 1; }
        }
    }
    st.filec += 1; // skip closing quote
    let s = &st.file[start..start + (st.filec - start - 1)];
    // Recalculate: we need the raw string from start to the closing quote
    let raw = &st.file[start..st.filec - 1];
    let escaped = esc_str(raw, len, if is_str { 1 } else { 0 });
    Some(mk_fn(st, &escaped))
}

pub fn read_sym(st: &mut Tsp, is_char: fn(char) -> bool) -> Option<Val> {
    let start = st.filec;
    while let Some(c) = fget(st) {
        if !is_char(c) { break; }
        st.filec += 1;
    }
    let s = esc_str(&st.file[start..st.filec], (st.filec - start) as i32, 0);
    Some(mk_sym(st, &s))
}
