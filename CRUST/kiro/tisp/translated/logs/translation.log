// Eval functions
pub fn tsp_lstlen(v: &Val) -> i32 {
    let mut len = 0i32;
    let mut cur = v;
    while cur.t == TspType::TspPair {
        len += 1;
        cur = cdr(cur);
    }
    if nilp(cur) { len } else { -(len + 1) }
}

fn tsp_warnf(msg: &str) -> Option<Val> {
    eprintln!("; tisp: error: {}", msg);
    None
}

fn tsp_arg_num_check(args: &Val, name: &str, nargs: i32) -> Option<()> {
    if nargs > -1 && tsp_lstlen(args) != nargs {
        eprintln!("; tisp: error: {}: expected {} argument{}, received {}",
            name, nargs, if nargs > 1 { "s" } else { "" }, tsp_lstlen(args));
        return None;
    }
    Some(())
}

fn tsp_arg_min_check(args: &Val, name: &str, nargs: i32) -> Option<()> {
    if tsp_lstlen(args) < nargs {
        eprintln!("; tisp: error: {}: expected at least {} argument{}, received {}",
            name, nargs, if nargs > 1 { "s" } else { "" }, tsp_lstlen(args));
        return None;
    }
    Some(())
}

fn tsp_arg_type_check(arg: &Val, name: &str, type_mask: u32) -> Option<()> {
    if (arg.t as u32 & type_mask) == 0 {
        let expected = match type_mask {
            m if m == TspType::TspPair as u32 => "Pair",
            m if m == TspType::TspSym as u32 => "Sym",
            m if m == TspType::TspStr as u32 => "Str",
            m if m == TspType::TspInt as u32 => "Int",
            m if m == TSP_NUM => "Num",
            m if m == TSP_EXPR => "Expr",
            m if m == TSP_RATIONAL => "Rational",
            m if m == (TspType::TspStr as u32 | TspType::TspSym as u32) => "Str",
            m if m == (TspType::TspInt as u32 | TspType::TspRatio as u32) => "Rational",
            m if m == TspType::TspRec as u32 => "Rec",
            _ => tsp_type_str_mask(type_mask),
        };
        eprintln!("; tisp: error: {}: expected {}, received {}", name, expected, tsp_type_str(arg.t));
        return None;
    }
    Some(())
}

pub fn tisp_eval_list(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> {
    let mut items: Vec<Val> = Vec::new();
    let mut cur = v;
    while !nilp(&cur) {
        if cur.t != TspType::TspPair {
            // Last element in improper list
            let ev = tisp_eval_with_env(st, env, cur)?;
            // Build list from items with ev as final cdr
            let mut result = ev;
            for item in items.into_iter().rev() {
                result = mk_pair(item, result);
            }
            return Some(result);
        }
        let c = clone_val(car(&cur));
        let ev = tisp_eval_with_env(st, env, c)?;
        items.push(ev);
        cur = clone_val(cdr(&cur));
    }
    let mut result = mk_nil();
    for item in items.into_iter().rev() {
        result = mk_pair(item, result);
    }
    Some(result)
}

pub fn tisp_eval_body(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> {
    let mut ret = mk_none();
    let mut cur = v;
    let mut env_owned: Option<Rec> = None;
    loop {
        if cur.t != TspType::TspPair { break; }
        let is_last = nilp(cdr(&cur));
        let cur_car = clone_val(car(&cur));
        if is_last && cur_car.t == TspType::TspPair {
            // Potential tail call
            let f_expr = clone_val(car(&cur_car));
            let f_args = clone_val(cdr(&cur_car));
            let env_ref = env_owned.as_mut().map_or(&mut *env, |e| e);
            let f = tisp_eval_with_env(st, env_ref, f_expr)?;
            if f.t != TspType::TspFunc {
                let r = eval_proc(st, env_ref, f, f_args)?;
                return Some(r);
            }
            // Tail call optimization for functions
            if let ValUnion::F { ref name, ref args, ref body, ref env as fenv } = f.v {
                let fname = if name.is_empty() { "anon" } else { name.as_str() };
                let fargs = clone_val(args);
                let fbody = clone_val(body);
                let fenv = clone_rec(fenv);
                tsp_arg_num_check(&f_args, fname, tsp_lstlen(&fargs))?;
                let env_ref2 = env_owned.as_mut().map_or(&mut *env, |e| e);
                let evaled_args = tisp_eval_list(st, env_ref2, f_args)?;
                let new_env = rec_extend(fenv, fargs, evaled_args);
                env_owned = Some(new_env);
                cur = mk_pair(mk_nil(), fbody); // continue loop from body
                continue;
            }
        } else {
            let env_ref = env_owned.as_mut().map_or(&mut *env, |e| e);
            ret = tisp_eval_with_env(st, env_ref, cur_car)?;
        }
        cur = clone_val(cdr(&cur));
    }
    Some(ret)
}

pub fn prepend_bt(st: &mut Tsp, env: &mut Rec, f: Val) {
    if let ValUnion::F { ref name, .. } = f.v {
        if name.is_empty() { return; }
        // Find base env
        let mut r = &mut *env;
        while r.next.is_some() {
            r = r.next.as_mut().unwrap();
        }
        if let Some(e) = entry_get(r, "bt") {
            let bt = &e.val;
            if bt.t == TspType::TspPair && car(bt).t == TspType::TspSym {
                if let ValUnion::S(ref s) = car(bt).v {
                    if name.starts_with(s.as_str()) { return; }
                }
            }
        }
        let sym = mk_sym(st, name);
        if let Some(old_bt) = rec_get(r, "bt") {
            let new_bt = mk_pair(sym, old_bt);
            rec_add(r, "bt", new_bt);
        }
    }
}

pub fn eval_proc(st: &mut Tsp, env: &mut Rec, f: Val, args: Val) -> Option<Val> {
    match f.t {
        TspType::TspPrim => {
            let evaled = tisp_eval_list(st, env, args)?;
            if let ValUnion::Pr { pr, .. } = &f.v {
                let pr = *pr;
                let result = pr(st, env, evaled);
                if result.t == TspType::TspNil && matches!(result.v, ValUnion::S(ref s) if s == "__ERROR__") {
                    return None;
                }
                Some(result)
            } else { None }
        }
        TspType::TspForm => {
            if let ValUnion::Pr { pr, .. } = &f.v {
                let pr = *pr;
                let result = pr(st, env, args);
                if result.t == TspType::TspNil && matches!(result.v, ValUnion::S(ref s) if s == "__ERROR__") {
                    return None;
                }
                Some(result)
            } else { None }
        }
        TspType::TspFunc => {
            let evaled = tisp_eval_list(st, env, args)?;
            if let ValUnion::F { ref name, ref args as fargs, ref body, ref env as fenv } = f.v {
                let fname = if name.is_empty() { "anon" } else { name.as_str() };
                let fargs_c = clone_val(fargs);
                let fbody_c = clone_val(body);
                let fenv_c = clone_rec(fenv);
                tsp_arg_num_check(&evaled, fname, tsp_lstlen(&fargs_c))?;
                let mut new_env = rec_extend(fenv_c, fargs_c, evaled);
                let result = tisp_eval_body(st, &mut new_env, fbody_c);
                if result.is_none() {
                    prepend_bt(st, env, clone_val(&f));
                }
                result
            } else { None }
        }
        TspType::TspMacro => {
            if let ValUnion::F { ref name, ref args as fargs, ref body, ref env as fenv } = f.v {
                let fname = if name.is_empty() { "anon" } else { name.as_str() };
                let fargs_c = clone_val(fargs);
                let fbody_c = clone_val(body);
                let fenv_c = clone_rec(fenv);
                tsp_arg_num_check(&args, fname, tsp_lstlen(&fargs_c))?;
                let mut new_env = rec_extend(fenv_c, fargs_c, args);
                let result = tisp_eval_body(st, &mut new_env, fbody_c);
                if result.is_none() {
                    prepend_bt(st, env, clone_val(&f));
                    return None;
                }
                // Macro: eval the result
                tisp_eval_with_env(st, env, result.unwrap())
            } else { None }
        }
        TspType::TspRec => {
            let evaled = tisp_eval_list(st, env, args)?;
            tsp_arg_num_check(&evaled, "record", 1)?;
            let key_val = car(&evaled);
            tsp_arg_type_check(key_val, "record", TspType::TspSym as u32)?;
            let key = sym_str(key_val);
            if let ValUnion::R(ref r) = f.v {
                if let Some(v) = rec_get(r, key) { return Some(v); }
                if let Some(v) = rec_get(r, "else") { return Some(v); }
            }
            eprintln!("; tisp: error: could not find element '{}' in record", key);
            None
        }
        _ => {
            eprintln!("; tisp: error: attempt to evaluate non procedural type {}", tsp_type_str(f.t));
            None
        }
    }
}

// tisp_eval uses st.env implicitly
pub fn tisp_eval(st: &mut Tsp, v: Val) -> Option<Val> {
    match v.t {
        TspType::TspSym => {
            let s = sym_str(&v).to_string();
            if let Some(f) = rec_get(&st.env, &s) {
                Some(f)
            } else {
                eprintln!("; tisp: error: could not find symbol '{}'", s);
                None
            }
        }
        TspType::TspPair => {
            let car_v = clone_val(car(&v));
            let cdr_v = clone_val(cdr(&v));
            let f = tisp_eval(st, car_v)?;
            eval_proc(st, &mut st.env, f, cdr_v)
        }
        _ => Some(v),
    }
}

// Internal eval that takes an explicit env
fn tisp_eval_with_env(st: &mut Tsp, env: &mut Rec, v: Val) -> Option<Val> {
    match v.t {
        TspType::TspSym => {
            let s = sym_str(&v).to_string();
            if let Some(f) = rec_get(env, &s) {
                Some(f)
            } else {
                eprintln!("; tisp: error: could not find symbol '{}'", s);
                None
            }
        }
        TspType::TspPair => {
            let car_v = clone_val(car(&v));
            let cdr_v = clone_val(cdr(&v));
            let f = tisp_eval_with_env(st, env, car_v)?;
            eval_proc(st, env, f, cdr_v)
        }
        _ => Some(v),
    }
}
