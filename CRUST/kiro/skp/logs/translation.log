/// match_pat: matches one pattern element against src.
/// Returns (match_result, src_end, pat_end).
pub fn match_pat<'a>(pat: &'a str, src: &'a str, flg: &mut i32) -> (i32, &'a str, &'a str) {
    let pb = bytes(pat);
    if pb.is_empty() {
        return (MATCHED_FAIL, src, pat);
    }

    let mut p = pat;
    let mut match_min: u32 = 1;
    let mut match_max: u32 = 1;
    let mut match_not: u32 = 0;

    // Parse quantifiers
    if bytes(p)[0] == b'*' { match_min = 0; match_max = u32::MAX; p = &p[1..]; }
    else if bytes(p)[0] == b'+' { match_max = u32::MAX; p = &p[1..]; }
    else if bytes(p)[0] == b'?' { match_min = 0; p = &p[1..]; }

    if !p.is_empty() && bytes(p)[0] == b'!' { match_not = 1; p = &p[1..]; }

    if p.is_empty() {
        return (MATCHED_FAIL, src, pat);
    }

    let iso = *flg & 2;
    let mut s_end = src;
    let mut s_tmp = src;
    let (mut s_chr, next_tmp) = skp_next(s_end, iso);
    s_tmp = next_tmp;

    let pat_char = bytes(p)[0];
    p = &p[1..];

    let mut ret = MATCHED_FAIL;
    let mut intnumber = false;

    // Macro W equivalent: repeatedly match while condition holds
    macro_rules! do_w {
        ($test:expr) => {{
            let mut match_cnt: u32 = 0;
            while match_cnt < match_max && s_chr != 0 && (($test) != (match_not != 0)) {
                match_cnt += 1;
                s_end = s_tmp;
                let r = skp_next(s_end, iso);
                s_chr = r.0; s_tmp = r.1;
            }
            ret = if match_cnt >= match_min { MATCHED } else { MATCHED_FAIL };
        }};
    }

    // get_next_s_chr equivalent (reads single byte)
    macro_rules! get_next {
        () => {{
            s_end = s_tmp;
            if !s_end.is_empty() {
                s_chr = bytes(s_end)[0] as u32;
                s_tmp = &s_end[1..];
            } else {
                s_chr = 0;
                s_tmp = s_end;
            }
        }};
    }

    match pat_char {
        b'.' => {
            if match_not != 0 { ret = if s_chr == 0 { MATCHED } else { MATCHED_FAIL }; }
            else { do_w!(s_chr != 0); }
        }
        b'$' => {
            if s_chr == 0 { ret = MATCHED; }
            else { /* fall through to 'n' */ do_w!(is_break(s_chr)); }
        }
        b'n' => { do_w!(is_break(s_chr)); }
        b'd' => { do_w!(is_digit(s_chr)); }
        b'x' => { do_w!(is_xdigit(s_chr)); }
        b'a' => { do_w!(is_alpha(s_chr)); }
        b'u' => { do_w!(is_upper(s_chr)); }
        b'l' => { do_w!(is_lower(s_chr)); }
        b's' => { do_w!(is_space(s_chr)); }
        b'w' => { do_w!(is_blank(s_chr)); }
        b'c' => { do_w!(is_ctrl(s_chr)); }
        b'i' => { do_w!(is_idchr(s_chr)); }
        b'@' => { do_w!(is_alnum(s_chr)); }

        b'&' => {
            ret = if match_not != 0 { MATCHED_GOALNOT } else { MATCHED_GOAL };
        }

        b'[' => {
            do_w!(is_oneof(s_chr, p, iso));
            // Skip past the set definition
            if !p.is_empty() && bytes(p)[0] == b']' { p = &p[1..]; }
            while !p.is_empty() && bytes(p)[0] != b']' { p = &p[1..]; }
            if !p.is_empty() { p = &p[1..]; }
        }

        b'"' | b'\'' | b'`' => {
            let quote = pat_char;
            let pb = bytes(p);
            let mut l = 0;
            while l < pb.len() && pb[l] != quote { l += 1; }
            if l > 0 {
                let ml = is_string(s_end, &p[..l], l as i32, *flg);
                if ml > 0 {
                    if match_not == 0 {
                        s_end = &s_end[ml as usize..];
                        ret = MATCHED;
                    }
                } else if match_min == 0 || match_not != 0 {
                    ret = MATCHED;
                }
            } else if match_min == 0 || match_not != 0 {
                ret = MATCHED;
            }
            p = if l < bytes(p).len() { &p[l+1..] } else { &p[l..] };
        }

        b'C' => {
            *flg = (*flg & !1) | match_not as i32;
            ret = MATCHED;
        }

        b'U' => {
            *flg = (*flg & !2) | (match_not as i32 * 2);
            ret = MATCHED;
        }

        b'S' => {
            while is_space(s_chr) { get_next!(); }
            ret = MATCHED;
        }

        b'W' => {
            while is_blank(s_chr) { get_next!(); }
            ret = MATCHED;
        }

        b'N' => {
            while s_chr != 0 && !is_break(s_chr) { get_next!(); }
            if s_chr != 0 { get_next!(); }
            ret = MATCHED;
        }

        b'I' => {
            if is_alpha(s_chr) || s_chr == b'_' as u32 {
                loop {
                    get_next!();
                    if !(is_alnum(s_chr) || s_chr == b'_' as u32) { break; }
                }
                ret = MATCHED;
            }
        }

        b'(' => {
            if !p.is_empty() && bytes(p)[0] == b')' && s_chr == b'(' as u32 {
                p = &p[1..];
                // fall through to B
            } else {
                // Not matched
                p = &p[..0]; // rewind - actually we need to not consume
                // The C code does `break` which skips to end
                // ret stays MATCHED_FAIL, p_end = p (after '(')
                // Actually in C: `if (*pat != ')' || s_chr != '(') break;`
                // then falls through to B. If break, ret=0.
                // We handle the B case below only if we didn't break.
                return (MATCHED_FAIL, src, &pat[1..]); // pat already advanced past '('
            }
            // B case (balanced parens)
            let open = s_chr;
            let close = get_close(open);
            if close != 0 {
                let mut count: i32 = 1;
                while s_chr != 0 && count > 0 {
                    get_next!();
                    if s_chr == open { count += 1; }
                    if s_chr == close { count -= 1; }
                }
                if count == 0 {
                    get_next!();
                    ret = MATCHED;
                }
            }
        }

        b'B' => {
            let open = s_chr;
            let close = get_close(open);
            if close != 0 {
                let mut count: i32 = 1;
                while s_chr != 0 && count > 0 {
                    get_next!();
                    if s_chr == open { count += 1; }
                    if s_chr == close { count -= 1; }
                }
                if count == 0 {
                    get_next!();
                    ret = MATCHED;
                }
            }
        }

        b'Q' => {
            let qclose = get_qclose(s_chr);
            if qclose != 0 {
                loop {
                    get_next!();
                    if s_chr == qclose { break; }
                    if s_chr == b'\\' as u32 { get_next!(); }
                    if s_chr == 0 { break; }
                }
                if s_chr != 0 {
                    get_next!();
                    ret = MATCHED;
                }
            }
        }

        b'X' => {
            let sb = bytes(s_end);
            if s_chr == b'0' as u32
                && sb.len() > 1 && (sb[1] == b'x' || sb[1] == b'X')
                && sb.len() > 2 && is_xdigit(sb[2] as u32)
            {
                get_next!(); get_next!(); get_next!();
                ret = MATCHED;
            }
            while is_xdigit(s_chr) {
                ret = MATCHED;
                get_next!();
            }
        }

        b'D' => {
            intnumber = true;
            // sign
            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {
                loop {
                    get_next!();
                    if !is_space(s_chr) { break; }
                }
            }
            while is_digit(s_chr) { ret = MATCHED; get_next!(); }
            // intnumber=true, so we break here (no float part)
        }

        b'F' => {
            // sign
            if s_chr == b'+' as u32 || s_chr == b'-' as u32 {
                loop {
                    get_next!();
                    if !is_space(s_chr) { break; }
                }
            }
            while is_digit(s_chr) { ret = MATCHED; get_next!(); }
            // decimal part
            if s_chr == b'.' as u32 { get_next!(); }
            while is_digit(s_chr) { ret = MATCHED; get_next!(); }
            // exponent
            if ret == MATCHED && (s_chr == b'E' as u32 || s_chr == b'e' as u32) {
                get_next!();
                if s_chr == b'+' as u32 || s_chr == b'-' as u32 { get_next!(); }
                while is_digit(s_chr) { get_next!(); }
                if s_chr == b'.' as u32 { get_next!(); }
                while is_digit(s_chr) { get_next!(); }
            }
        }

        _ => {
            ret = MATCHED_FAIL;
            p = &pat[..]; // rewind: pat-- in C means we didn't consume
            // Actually in C: `default: ret = MATCHED_FAIL; pat--; break;`
            // pat was incremented past the switch char, so pat-- puts it back.
            // We already did p = &p[1..] equivalent by slicing past pat_char.
            // We need to undo that. pat_char = bytes(original_p)[0], p = &original_p[1..].
            // So we need p = original_p. But we lost it. Let's reconstruct:
            // p currently points past pat_char. We need to go back 1 byte.
            // Since pat = &original[1..] and p = &pat[1..] = &original[2..], no...
            // Actually: at top, p starts as pat. We read pat_char = p[0], then p = &p[1..].
            // So to undo, we need p to be the value before we did p = &p[1..].
            // We can recover it since pat_char was 1 byte:
            // p is currently &(original_p)[1..], we need &(original_p)[0..].
            // We can't go backwards in a slice. Let's use the fact that
            // the caller's pat pointer should not advance.
            // Return pat as p_end (not advanced).
            // Actually, let me re-examine. The function signature returns pat_end.
            // In the C code, p_end = pat at the end. Since we set p = &p[1..] for the
            // switch char, and then default does pat--, p_end should be the position
            // before the switch char was consumed.
            // We need to return the original position of p before consuming pat_char.
            // Let me handle this by returning early.
            // The quantifiers were already consumed. In C, the quantifiers are consumed
            // from pat before the switch. Then switch(*pat++) reads and advances.
            // default: pat--; undoes that advance.
            // So p_end = position after quantifiers but before the unrecognized char.
            // We need to go back 1 byte from current p.
            // Since we can't go backwards in &str, let's compute the offset.
            let consumed = pat.len() - p.len(); // bytes consumed for quantifiers + 1 (pat_char)
            let p_end_offset = consumed - 1; // undo the pat_char consumption
            // p_end is pat advanced by p_end_offset bytes
            return (MATCHED_FAIL, src, &pat[p_end_offset..]);
        }
    }

    let _ = intnumber; // suppress warning

    if ret != MATCHED_FAIL {
        (ret, s_end, p)
    } else {
        (MATCHED_FAIL, src, p)
    }
}
