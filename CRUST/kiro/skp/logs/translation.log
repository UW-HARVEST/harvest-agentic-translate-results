pub fn is_oneof(ch: u32, set: &str, iso: i32) -> bool {
    if ch == 0 { return false; }
    let mut s = set;
    let (mut p_ch, mut next) = skp_next(s, iso);
    // If first char is ']', match it literally
    if p_ch == b']' as u32 {
        if ch == b']' as u32 { return true; }
        let r = skp_next(next, iso);
        p_ch = r.0; s = r.1;
    } else {
        s = next;
    }
    while p_ch != b']' as u32 {
        if p_ch == ch { return true; }
        let q_ch = p_ch;
        let r = skp_next(s, iso);
        p_ch = r.0; s = r.1;
        if p_ch == b'-' as u32 && !s.is_empty() && bytes(s)[0] != b']' {
            let r2 = skp_next(s, iso);
            p_ch = r2.0; s = r2.1;
            if q_ch < ch && ch <= p_ch { return true; }
            let r3 = skp_next(s, iso);
            p_ch = r3.0; s = r3.1;
        }
    }
    false
}

pub fn is_string(s: &str, p: &str, len: i32, flg: i32) -> i32 {
    let start = s;
    let mut s = s;
    let mut p = p;
    let mut remaining_len = len;
    let mut mlen: i32 = 0;
    let iso = flg & 2;
    let fold = flg & 1;

    while remaining_len > 0 {
        if !p.is_empty() && bytes(p)[0] == 0x0E { return mlen; }

        let (p_chr, p_end) = skp_next(p, iso);
        let (s_chr, s_end) = skp_next(s, iso);

        if chr_cmp(s_chr, p_chr, fold) {
            let s_adv = s.len() - s_end.len();
            let p_adv = p.len() - p_end.len();
            mlen += s_adv as i32;
            remaining_len -= p_adv as i32;
            p = p_end;
            s = s_end;
        } else {
            // Search for alternative (0x0E separator)
            while remaining_len > 0 && !p.is_empty() && bytes(p)[0] != 0x0E {
                p = &p[1..];
                remaining_len -= 1;
            }
            if remaining_len <= 0 { return 0; }
            // Skip the 0x0E
            p = &p[1..];
            remaining_len -= 1;
            s = start;
            mlen = 0;
        }
    }
    mlen
}

pub fn get_close(open: u32) -> u32 {
    match open {
        0x28 => 0x29, // ( -> )
        0x5B => 0x5D, // [ -> ]
        0x7B => 0x7D, // { -> }
        0x3C => 0x3E, // < -> >
        _ => 0,
    }
}

pub fn get_qclose(open: u32) -> u32 {
    match open {
        0x27 | 0x22 | 0x60 => open, // ' " `
        _ => 0,
    }
}

pub const MATCHED_FAIL: i32 = 0;
pub const MATCHED: i32 = 1;
pub const MATCHED_GOAL: i32 = 2;
pub const MATCHED_GOALNOT: i32 = 3;
