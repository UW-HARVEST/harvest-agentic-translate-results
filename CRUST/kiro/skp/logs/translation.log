/// The core scanning function.
/// Returns (match_code, to, end) where to and end are substrings of src.
pub fn skp_<'a>(src: &'a str, pat: &'a str) -> (i32, &'a str, &'a str) {
    if pat.is_empty() || src.is_empty() {
        // Actually C checks: if (!pat || !src) return 0
        // But src="" is valid (just won't match much). Let's match C exactly:
        // if pat is empty or src ptr is null -> return 0. In Rust, &str can't be null.
        // For empty pat, return 0.
    }
    let pat_bytes = bytes(pat);
    let src_bytes = bytes(src);

    if pat_bytes.is_empty() {
        return (0, src, src);
    }

    let mut skp_to = false;
    let mut pat_start = pat;

    if pat_bytes[0] == b'>' {
        skp_to = true;
        pat_start = &pat[1..];
    }

    let mut start = src;
    let mut p = pat_start;
    let mut s = start;
    let mut flg: i32 = 0;
    let mut matched: i32 = 0;
    let mut goal: Option<&'a str> = None;
    let mut goalnot: Option<&'a str> = None;

    // Skip leading spaces in pattern
    while !p.is_empty() && is_space(bytes(p)[0] as u32) { p = &p[1..]; }

    while !p.is_empty() && bytes(p)[0] > 0x07 {
        let (m, s_end, p_end) = match_pat(p, s, &mut flg);
        matched = m;
        if matched != 0 {
            s = s_end;
            p = p_end;
            if matched == MATCHED_GOAL && goalnot.is_none() {
                goal = Some(s);
            } else if matched == MATCHED_GOALNOT {
                goalnot = Some(s);
            }
        } else {
            // Skip to end of current pattern alternative (bytes <= 0x07)
            while !p.is_empty() && bytes(p)[0] > 0x07 { p = &p[1..]; }
            // Check if there's another alternative
            if !p.is_empty() && bytes(p)[0] > 0x00 {
                // Check p[1] > 0
                if p.len() > 1 && bytes(p)[1] > 0x00 {
                    s = start;
                    p = &p[1..];
                } else if skp_to {
                    goal = None;
                    goalnot = None;
                    p = pat_start;
                    // Advance start by 1 byte
                    if start.is_empty() { break; }
                    start = &start[1..];
                    s = start;
                    if s.is_empty() { break; }
                } else {
                    break;
                }
            } else if skp_to {
                goal = None;
                goalnot = None;
                p = pat_start;
                if start.is_empty() { break; }
                start = &start[1..];
                s = start;
                if s.is_empty() { break; }
            } else {
                break;
            }
        }
        // Skip spaces in pattern
        while !p.is_empty() && is_space(bytes(p)[0] as u32) { p = &p[1..]; }
    }

    if matched == 0 && goalnot.is_some() {
        goal = goalnot;
        matched = MATCHED;
        p = "";
    }

    if let Some(g) = goal {
        s = g;
    }

    if matched != 0 && (p.is_empty() || bytes(p)[0] <= 0x07) {
        let ret = if !p.is_empty() && bytes(p)[0] > 0 { bytes(p)[0] as i32 } else { 1 };
        let to = if skp_to { start } else { s };
        let end = s;
        return (ret, to, end);
    }

    (0, src, src)
}

pub fn skp_4(src: &str, pat: &str, to: Option<&mut &str>, end: Option<&mut &str>) -> i32 {
    let (ret, t, e) = skp_(src, pat);
    if let Some(to_ref) = to { *to_ref = t; }
    if let Some(end_ref) = end { *end_ref = e; }
    ret
}

pub fn skp_3(src: &str, pat: &str, end: Option<&mut &str>) -> i32 {
    skp_4(src, pat, end, None)
}

pub fn skp_2(src: &str, pat: &str) -> i32 {
    skp_4(src, pat, None, None)
}
