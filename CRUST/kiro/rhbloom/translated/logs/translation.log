import math

# Binary search for optimal k0
def find_best_k0(n, m0, p):
    best_k0 = 1
    best_diff = float('inf')
    for k0 in range(1, 100):
        fp = (1 - math.exp(-k0 * n / m0)) ** k0
        diff = abs(fp - p)
        if diff < best_diff:
            best_diff = diff
            best_k0 = k0
        elif fp > p:  # fp increases then decreases, so once we pass p and start getting worse, stop
            break
    return best_k0

failures = 0
for n_input in range(0, 100001, 1000):
    n = max(n_input, 16)
    for pi in range(1, 70):
        p = pi / 100.0
        m_exact = n * math.log(p) / math.log(1.0 / pow(2, math.log(2)))
        m = int(m_exact)
        m0 = 2
        while m0 < m:
            m0 *= 2
        k0 = find_best_k0(n, m0, p)
        
        if k0 > 0 and m0 > 0 and n_input > 0:
            fp_rate = (1 - math.exp(-k0 * n / m0)) ** k0
            if abs(fp_rate - p) > 0.1:
                failures += 1
                
print(f'Search k0 failures: {failures}')
