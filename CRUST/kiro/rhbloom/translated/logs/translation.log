use rhbloom::rhbloom::RHBloom;

fn murmurhash2(key: &[u8], seed: u32) -> u32 {
    let m = 0x5bd1e995u32;
    let r = 24;
    let mut h = seed ^ key.len() as u32;
    let mut data = key;
    while data.len() >= 4 {
        let mut k = u32::from_le_bytes(data[0..4].try_into().unwrap());
        k = k.wrapping_mul(m);
        k ^= k >> r;
        k = k.wrapping_mul(m);
        h = h.wrapping_mul(m);
        h ^= k;
        data = &data[4..];
    }
    match data.len() {
        3 => h ^= (data[2] as u32) << 16,
        2 => h ^= (data[1] as u32) << 8,
        1 => {
            h ^= data[0] as u32;
            h = h.wrapping_mul(m);
        }
        _ => {}
    }
    h ^= h >> 13;
    h = h.wrapping_mul(m);
    h ^= h >> 15;
    h
}

fn hash(x: i32) -> u64 {
    murmurhash2(&x.to_le_bytes(), 0) as u64
}

fn main() {
    // Test small case
    let n = 0;
    let p = 0.01;
    let mut rhbloom = RHBloom::new(n as usize, p);
    let nn = n + 1;
    for i in 0..nn {
        if !rhbloom.upgraded() {
            assert!(!rhbloom.test(hash(i)), "test should be false for key {} before add", i);
        }
        rhbloom.add(hash(i));
        if !rhbloom.upgraded() {
            assert!(rhbloom.test(hash(i)), "test should be true for key {} after add", i);
        }
    }
    println!("upgraded: {}", rhbloom.upgraded());
    println!("Small test passed!");
    
    // Test n=1000
    let n = 1000;
    let p = 0.01;
    let mut rhbloom = RHBloom::new(n as usize, p);
    let nn = n + 1;
    for i in 0..nn {
        rhbloom.add(hash(i));
    }
    println!("n=1000 upgraded: {}", rhbloom.upgraded());
    assert!(rhbloom.upgraded());
    let mut hits = 0;
    for i in 0..nn {
        if rhbloom.test(hash(i)) {
            hits += 1;
        }
    }
    assert_eq!(hits, nn);
    println!("n=1000 all items found, hits={}", hits);
    
    // Check false positive rate
    hits = 0;
    for i in nn..nn*2 {
        if rhbloom.test(hash(i)) {
            hits += 1;
        }
    }
    println!("n=1000 false positives: {} ({:.4})", hits, hits as f64 / n as f64);
    println!("All quick tests passed!");
}
