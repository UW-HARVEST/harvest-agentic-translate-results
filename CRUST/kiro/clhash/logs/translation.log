clhash.o: ./src/clhash.c $(HEADERS)
	$(CC) $(CFLAGS) -c ./src/clhash.c -Iinclude

clean:
	rm -f $(OBJECTS) unit_1 cppunit benchmark example cppexample
	rm -rf *.gcno *.gcda *.gcov
