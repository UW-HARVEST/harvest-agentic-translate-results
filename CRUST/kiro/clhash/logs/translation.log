CXXFLAGS = -fPIC -std=c++11 -O3 -msse4.2 -mpclmul -march=native -funroll-loops -Wstrict-overflow -Wstrict-aliasing -Wall -Wextra -pedantic -Wshadow  -fprofile-arcs -ftest-coverage
endif # debug

HEADERS=src/include/clhash.h

