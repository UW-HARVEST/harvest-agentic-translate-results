fn bn_to_padded(bn: &BigUint, len: usize) -> Vec<u8> {
    let bytes = bn.to_bytes_be();
    if bytes.len() >= len {
        bytes[bytes.len() - len..].to_vec()
    } else {
        let mut padded = vec![0u8; len - bytes.len()];
        padded.extend_from_slice(&bytes);
        padded
    }
}

