#include <stdio.h>
#include <string.h>
typedef unsigned int u32;
typedef unsigned char u8;

static u32 bswap32(u32 v) {
    return (v << 0x18 & 0xff000000ul) | (v << 0x08 & 0x00ff0000ul) |
           (v >> 0x08 & 0x0000ff00ul) | (v >> 0x18 & 0x000000fful);
}

int main() {
    // What bytes should "caff" header be?
    u32 raw;
    memcpy(&raw, "caff", 4);
    printf("raw 'caff' = 0x%08x\n", raw);
    printf("bswap32('caff') = 0x%08x\n", bswap32(raw));
    
    u32 fourcc_ffac = (u32)(u8)'f' | ((u32)(u8)'f' << 8) | ((u32)(u8)'a' << 16) | ((u32)(u8)'c' << 24);
    printf("fourcc('f','f','a','c') = 0x%08x\n", fourcc_ffac);
    
    // desc chunk
    memcpy(&raw, "desc", 4);
    printf("\nraw 'desc' = 0x%08x\n", raw);
    printf("bswap32('desc') = 0x%08x\n", bswap32(raw));
    u32 fourcc_csed = (u32)(u8)'c' | ((u32)(u8)'s' << 8) | ((u32)(u8)'e' << 16) | ((u32)(u8)'d' << 24);
    printf("fourcc('c','s','e','d') = 0x%08x\n", fourcc_csed);
    
    // pakt chunk
    memcpy(&raw, "pakt", 4);
    printf("\nraw 'pakt' = 0x%08x\n", raw);
    printf("bswap32('pakt') = 0x%08x\n", bswap32(raw));
    u32 fourcc_tkap = (u32)(u8)'t' | ((u32)(u8)'k' << 8) | ((u32)(u8)'a' << 16) | ((u32)(u8)'p' << 24);
    printf("fourcc('t','k','a','p') = 0x%08x\n", fourcc_tkap);
    
    // data chunk
    memcpy(&raw, "data", 4);
    printf("\nraw 'data' = 0x%08x\n", raw);
    printf("bswap32('data') = 0x%08x\n", bswap32(raw));
    u32 fourcc_atad = (u32)(u8)'a' | ((u32)(u8)'t' << 8) | ((u32)(u8)'a' << 16) | ((u32)(u8)'d' << 24);
    printf("fourcc('a','t','a','d') = 0x%08x\n", fourcc_atad);
    
    // ima4
    memcpy(&raw, "ima4", 4);
    printf("\nraw 'ima4' = 0x%08x\n", raw);
    printf("bswap32('ima4') = 0x%08x\n", bswap32(raw));
    u32 fourcc_4ami = (u32)(u8)'4' | ((u32)(u8)'a' << 8) | ((u32)(u8)'m' << 16) | ((u32)(u8)'i' << 24);
    printf("fourcc('4','a','m','i') = 0x%08x\n", fourcc_4ami);
    
    return 0;
}
