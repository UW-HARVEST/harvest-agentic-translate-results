import re

with open('c_src/src/lib.c') as f:
    content = f.read()

# Extract arrays
def extract_array(name, size, content):
    m = re.search(name + r'\[' + str(size) + r'\]\s*=\s*\{([^}]+)\}', content)
    vals = [v.strip() for v in m.group(1).split(',') if v.strip()]
    return vals

mantissa = extract_array('m__mantissa', 2048, content)
offset = extract_array('m__offset', 64, content)
exponent = extract_array('m__exponent', 64, content)

def format_array(vals, per_line=6):
    lines = []
    for i in range(0, len(vals), per_line):
        chunk = vals[i:i+per_line]
        lines.append('    ' + ', '.join(chunk) + ',')
    return '\n'.join(lines)

rust = '''static M_MANTISSA: [u32; 2048] = [
''' + format_array(mantissa) + '''
];

static M_OFFSET: [u16; 64] = [
''' + format_array(offset, 8) + '''
];

static M_EXPONENT: [u32; 64] = [
''' + format_array(exponent) + '''
];

#[unsafe(no_mangle)]
pub extern \"C\" fn half2float(h: u16) -> f32 {
    let n = (h >> 10) as usize;
    let idx = ((h & 0x3ff) + M_OFFSET[n]) as usize;
    let num = M_MANTISSA[idx].wrapping_add(M_EXPONENT[n]);
    f32::from_bits(num)
}
'''

with open('src/lib.rs', 'w') as f:
    f.write(rust)

print('Generated src/lib.rs')
"
