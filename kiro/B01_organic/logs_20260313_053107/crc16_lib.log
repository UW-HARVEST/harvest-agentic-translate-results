import re

with open('lib.h') as f:
    content = f.read()

# Find the big table initializer
start = content.index('= {')
end = content.index('};', start) + 2
block = content[start+2:end-2].strip()

# Split into 8 sub-tables by matching { ... }
tables = re.findall(r'\{([^}]+)\}', block)

for i, t in enumerate(tables):
    vals = [v.strip() for v in t.split(',') if v.strip()]
    lines = []
    lines.append('[')
    for j in range(0, len(vals), 8):
        chunk = vals[j:j+8]
        lines.append('    ' + ', '.join(chunk) + ',')
    lines.append(']')
    outpath = '../../src/table{}.rs'.format(i)
    with open(outpath, 'w') as out:
        out.write('\n'.join(lines) + '\n')
    print(f'Wrote table{i}.rs with {len(vals)} entries')
"
