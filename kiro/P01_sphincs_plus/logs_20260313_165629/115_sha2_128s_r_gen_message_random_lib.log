use crate::params::*;
use crate::utils::{u32_to_bytes, ull_to_bytes};

fn load_bigendian_32(x: &[u8]) -> u32 {
    (x[3] as u32) | ((x[2] as u32) << 8) | ((x[1] as u32) << 16) | ((x[0] as u32) << 24)
}

fn store_bigendian_32(x: &mut [u8], u: u32) {
    x[3] = u as u8;
    x[2] = (u >> 8) as u8;
    x[1] = (u >> 16) as u8;
    x[0] = (u >> 24) as u8;
}

fn load_bigendian_64(x: &[u8]) -> u64 {
    (x[7] as u64)
        | ((x[6] as u64) << 8)
        | ((x[5] as u64) << 16)
        | ((x[4] as u64) << 24)
        | ((x[3] as u64) << 32)
        | ((x[2] as u64) << 40)
        | ((x[1] as u64) << 48)
        | ((x[0] as u64) << 56)
}

fn store_bigendian_64(x: &mut [u8], u: u64) {
    x[7] = u as u8;
    x[6] = (u >> 8) as u8;
    x[5] = (u >> 16) as u8;
    x[4] = (u >> 24) as u8;
    x[3] = (u >> 32) as u8;
    x[2] = (u >> 40) as u8;
    x[1] = (u >> 48) as u8;
    x[0] = (u >> 56) as u8;
}

