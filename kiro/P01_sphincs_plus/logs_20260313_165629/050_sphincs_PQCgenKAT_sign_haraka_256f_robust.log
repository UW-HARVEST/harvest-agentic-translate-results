fn haraka_s_absorb(s: &mut [u8; 64], m: &[u8], p: u8, ctx: &SpxCtx) {
    let r = HARAKAS_RATE;
    let mut offset = 0usize;
    let mut remaining = m.len();
    while remaining >= r {
        for i in 0..r { s[i] ^= m[offset + i]; }
        let mut tmp = [0u8; 64];
        haraka512_perm(&mut tmp, s, ctx);
        s.copy_from_slice(&tmp);
        remaining -= r;
        offset += r;
    }
    let mut t = vec![0u8; r];
    for i in 0..remaining { t[i] = m[offset + i]; }
    t[remaining] = p;
    t[r - 1] |= 128;
    for i in 0..r { s[i] ^= t[i]; }
}

fn haraka_s_squeezeblocks(h: &mut [u8], nblocks: usize, s: &mut [u8; 64], ctx: &SpxCtx) {
    let mut offset = 0;
    for _ in 0..nblocks {
        let mut tmp = [0u8; 64];
        haraka512_perm(&mut tmp, s, ctx);
        s.copy_from_slice(&tmp);
        h[offset..offset + HARAKAS_RATE].copy_from_slice(&s[..HARAKAS_RATE]);
        offset += HARAKAS_RATE;
    }
}

pub fn haraka_s(out: &mut [u8], inp: &[u8], ctx: &SpxCtx) {
    let outlen = out.len();
    let mut s = [0u8; 64];
    haraka_s_absorb(&mut s, inp, 0x1F, ctx);

    let full_blocks = outlen / 32;
    haraka_s_squeezeblocks(&mut out[..full_blocks * 32], full_blocks, &mut s, ctx);

    if outlen % 32 != 0 {
        let mut d = [0u8; 32];
        haraka_s_squeezeblocks(&mut d, 1, &mut s, ctx);
        let start = full_blocks * 32;
        for i in 0..(outlen % 32) {
            out[start + i] = d[i];
        }
    }
}

pub fn haraka_s_inc_init(s_inc: &mut [u8; 65]) {
    for i in 0..64 { s_inc[i] = 0; }
    s_inc[64] = 0;
}

pub fn haraka_s_inc_absorb(s_inc: &mut [u8; 65], m: &[u8], ctx: &SpxCtx) {
    let mut moff = 0usize;
    let mut mlen = m.len();

    while mlen + (s_inc[64] as usize) >= HARAKAS_RATE {
        let avail = HARAKAS_RATE - s_inc[64] as usize;
        for i in 0..avail {
            s_inc[s_inc[64] as usize + i] ^= m[moff + i];
        }
        mlen -= avail;
        moff += avail;
        s_inc[64] = 0;

        let mut tmp = [0u8; 64];
        let mut s64 = [0u8; 64];
        s64.copy_from_slice(&s_inc[..64]);
        haraka512_perm(&mut tmp, &s64, ctx);
        s_inc[..64].copy_from_slice(&tmp);
    }

    for i in 0..mlen {
        s_inc[s_inc[64] as usize + i] ^= m[moff + i];
    }
    s_inc[64] = s_inc[64].wrapping_add(mlen as u8);
}

pub fn haraka_s_inc_finalize(s_inc: &mut [u8; 65]) {
    s_inc[s_inc[64] as usize] ^= 0x1F;
    s_inc[HARAKAS_RATE - 1] ^= 128;
    s_inc[64] = 0;
}

pub fn haraka_s_inc_squeeze(out: &mut [u8], s_inc: &mut [u8; 65], ctx: &SpxCtx) {
    let mut outlen = out.len();
    let mut out_off = 0usize;

    // First consume leftover bytes
    let mut i = 0usize;
    while i < outlen && i < s_inc[64] as usize {
        out[out_off] = s_inc[HARAKAS_RATE - s_inc[64] as usize + i];
        out_off += 1;
        i += 1;
    }
    outlen -= i;
    s_inc[64] = s_inc[64].wrapping_sub(i as u8);

    while outlen > 0 {
        let mut tmp = [0u8; 64];
        let mut s64 = [0u8; 64];
        s64.copy_from_slice(&s_inc[..64]);
        haraka512_perm(&mut tmp, &s64, ctx);
        s_inc[..64].copy_from_slice(&tmp);

        let mut j = 0usize;
        while j < outlen && j < HARAKAS_RATE {
            out[out_off] = s_inc[j];
            out_off += 1;
            j += 1;
        }
        outlen -= j;
        s_inc[64] = (HARAKAS_RATE - j) as u8;
    }
}
