use std::io::{Read, Write};
use std::os::unix::io::FromRawFd;

fn main() {
    // Test: can we capture Rust println! via dup2?
    let _ = std::io::stdout().flush();
    
    let mut pipe_fds = [0i32; 2];
    unsafe { assert_eq!(libc::pipe(pipe_fds.as_mut_ptr()), 0) };
    let (read_fd, write_fd) = (pipe_fds[0], pipe_fds[1]);
    
    unsafe { libc::fcntl(write_fd, libc::F_SETPIPE_SZ, 1024 * 1024) };
    
    let saved = unsafe { libc::dup(1) };
    unsafe { libc::dup2(write_fd, 1) };
    unsafe { libc::close(write_fd) };
    
    println!("Hello from Rust println!");
    print!("And print!");
    
    let _ = std::io::stdout().flush();
    unsafe { libc::fflush(std::ptr::null_mut()) };
    
    unsafe { libc::dup2(saved, 1) };
    unsafe { libc::close(saved) };
    
    let mut buf = String::new();
    let mut reader = unsafe { std::fs::File::from_raw_fd(read_fd) };
    reader.read_to_string(&mut buf).unwrap();
    
    eprintln!("Captured: {:?}", buf);
}
